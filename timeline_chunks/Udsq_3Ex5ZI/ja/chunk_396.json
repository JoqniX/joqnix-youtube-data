[{"type": "subtitle", "time": 23763.15, "timestamp": "06:36:03", "text": "当たり前のことに注意しましょう。私はただ"}, {"type": "subtitle", "time": 23771.19, "timestamp": "06:36:11", "text": "それを追加した。だから、もし"}, {"type": "subtitle", "time": 23779.03, "timestamp": "06:36:19", "text": "[音楽]"}, {"type": "subtitle", "time": 23782.548, "timestamp": "06:36:22", "text": "何？機能しません。それは動作します。わかった、"}, {"type": "subtitle", "time": 23785.91, "timestamp": "06:36:25", "text": "良い。良い。あれを調整する必要がある。"}, {"type": "subtitle", "time": 23794.628, "timestamp": "06:36:34", "text": "男の子。この厄介なやつを調整する必要がある。"}, {"type": "subtitle", "time": 23801.59, "timestamp": "06:36:41", "text": "だって私は色々言うから。"}, {"type": "subtitle", "time": 23803.51, "timestamp": "06:36:43", "text": "どんどん何か言い続けてください。気にしないでください。"}, {"type": "subtitle", "time": 23805.18, "timestamp": "06:36:45", "text": "気にしないでください。気にしないで"}, {"type": "subtitle", "time": 23817.91, "timestamp": "06:36:57", "text": "それ。ああ、神様。戻ってくる。戻ってくる。来る"}]
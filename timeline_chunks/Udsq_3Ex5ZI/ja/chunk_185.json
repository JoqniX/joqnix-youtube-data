[{"type": "subtitle", "time": 11102.91, "timestamp": "03:05:02", "text": "死ぬ。死なないでください。やめてください"}, {"type": "subtitle", "time": 11111.87, "timestamp": "03:05:11", "text": "いや。ああ、神様。神、"}, {"type": "subtitle", "time": 11113.91, "timestamp": "03:05:13", "text": "神。お願い、お願い、お願い、お願い、"}, {"type": "subtitle", "time": 11115.269, "timestamp": "03:05:15", "text": "お願い、お願い、お願い。なぜ私は"}, {"type": "subtitle", "time": 11117.269, "timestamp": "03:05:17", "text": "攻撃？なぜ私は攻撃したのか？なぜ私は"}, {"type": "subtitle", "time": 11118.87, "timestamp": "03:05:18", "text": "攻撃？お願い、お願い、お願い、お願い、"}, {"type": "subtitle", "time": 11120.63, "timestamp": "03:05:20", "text": "お願い、お願い。男に、男に"}, {"type": "subtitle", "time": 11123.75, "timestamp": "03:05:23", "text": "男の筋肉、男の筋肉、男の筋肉"}, {"type": "subtitle", "time": 11131.389, "timestamp": "03:05:31", "text": "家に帰る。できない時もあるし、できない時もある"}, {"type": "subtitle", "time": 11135.19, "timestamp": "03:05:35", "text": "私が誰を言っているのか信じてください"}, {"type": "subtitle", "time": 11137.99, "timestamp": "03:05:37", "text": "これらすべてを述べた。"}, {"type": "subtitle", "time": 11140.87, "timestamp": "03:05:40", "text": "えっと、信じられない"}]
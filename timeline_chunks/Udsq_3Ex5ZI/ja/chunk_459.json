[{"type": "subtitle", "time": 27542.59, "timestamp": "07:39:02", "text": "自分。例えば、私が"}, {"type": "subtitle", "time": 27545.628, "timestamp": "07:39:05", "text": "クエスト、それは"}, {"type": "subtitle", "time": 27548.35, "timestamp": "07:39:08", "text": "示す"}, {"type": "subtitle", "time": 27551.75, "timestamp": "07:39:11", "text": "えっと、クエストとか何かを始めてください。行く"}, {"type": "subtitle", "time": 27553.91, "timestamp": "07:39:13", "text": "クエスト。ええ、それは表示されませんね。"}, {"type": "subtitle", "time": 27556.29, "timestamp": "07:39:16", "text": "なし"}, {"type": "subtitle", "time": 27558.83, "timestamp": "07:39:18", "text": "[音楽]"}, {"type": "subtitle", "time": 27561.59, "timestamp": "07:39:21", "text": "そこには。まあ、とにかく、この配信では、"}, {"type": "subtitle", "time": 27564.628, "timestamp": "07:39:24", "text": "私たちは車のテストを行います。いいえ、"}, {"type": "subtitle", "time": 27567.11, "timestamp": "07:39:27", "text": "私たちはこれをやります。これは"}, {"type": "subtitle", "time": 27571.11, "timestamp": "07:39:31", "text": "神里綾人のクエストライン。私たちは"}, {"type": "subtitle", "time": 27572.91, "timestamp": "07:39:32", "text": "行う"}, {"type": "subtitle", "time": 27576.43, "timestamp": "07:39:36", "text": "それ。試してみます"}, {"type": "subtitle", "time": 27585.43, "timestamp": "07:39:45", "text": "最高だよ、だって私はすべてのストーリーを持っているから"}, {"type": "subtitle", "time": 27590.19, "timestamp": "07:39:50", "text": "クエストは未開拓のまま並んでいた。"}, {"type": "subtitle", "time": 27592.11, "timestamp": "07:39:52", "text": "つまりどちらか"}, {"type": "subtitle", "time": 27595.59, "timestamp": "07:39:55", "text": "誰かがモッドを完成させる方法"}]
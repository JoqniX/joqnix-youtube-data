[{"type": "subtitle", "time": 16381.269, "timestamp": "04:33:01", "text": "私がそうでないなら、何の意味があるの？"}, {"type": "subtitle", "time": 16384.31, "timestamp": "04:33:04", "text": "価値があるか、そうでないか"}, {"type": "subtitle", "time": 16387.51, "timestamp": "04:33:07", "text": "えっと、もっとなんて言うんだっけ？何が"}, {"type": "subtitle", "time": 16389.31, "timestamp": "04:33:09", "text": "私が良くない時"}, {"type": "subtitle", "time": 16392.709, "timestamp": "04:33:12", "text": "十分とか、そういうこと？むしろ彼は"}, {"type": "subtitle", "time": 16395.349, "timestamp": "04:33:15", "text": "一度もやったことがない。以前はそうしていたのですが"}, {"type": "subtitle", "time": 16397.349, "timestamp": "04:33:17", "text": "停止しました。それは無理やりだったように感じた"}, {"type": "subtitle", "time": 16400.31, "timestamp": "04:33:20", "text": "昇進か何かだろう。"}, {"type": "subtitle", "time": 16403.429, "timestamp": "04:33:23", "text": "昇進か何かだったんだ。私は強制している"}, {"type": "subtitle", "time": 16405.99, "timestamp": "04:33:25", "text": "人々か何か。その時、私は気分が悪くなった。"}, {"type": "subtitle", "time": 16409.709, "timestamp": "04:33:29", "text": "そしてある日、私は泣いた。そして私はこう思った。"}, {"type": "subtitle", "time": 16413.349, "timestamp": "04:33:33", "text": "\"わかった。\"うん。私はそれをしません。"}, {"type": "subtitle", "time": 16414.99, "timestamp": "04:33:34", "text": "私は忘れるだけです"}, {"type": "subtitle", "time": 16418.59, "timestamp": "04:33:38", "text": "それ。わからない。私は"}, {"type": "subtitle", "time": 16421.75, "timestamp": "04:33:41", "text": "バカ。父からメッセージが来た。私は行く必要があります"}, {"type": "chat", "time": 16432.727, "timestamp": "04:33:52", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "i mean when you do yt for a long time, you will realize it just about acting too"}]
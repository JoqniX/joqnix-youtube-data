[{"type": "subtitle", "time": 14520.469, "timestamp": "04:02:00", "text": "参加していただきありがとうございます"}, {"type": "subtitle", "time": 14523.67, "timestamp": "04:02:03", "text": "これ。これは私が人々が"}, {"type": "subtitle", "time": 14529.429, "timestamp": "04:02:09", "text": "参加する。うん。うん。したい"}, {"type": "subtitle", "time": 14532.189, "timestamp": "04:02:12", "text": "N のストリームに行きたい"}, {"type": "subtitle", "time": 14535.269, "timestamp": "04:02:15", "text": "韓国。私たちは皆、韓国に行きたいと思っています。"}, {"type": "subtitle", "time": 14537.99, "timestamp": "04:02:17", "text": "韓国。私はそこに行きたい。"}, {"type": "subtitle", "time": 14542.389, "timestamp": "04:02:22", "text": "ストリーミングしたい"}, {"type": "subtitle", "time": 14545.83, "timestamp": "04:02:25", "text": "あるいは、決してない。私には友達が何人かいます"}, {"type": "subtitle", "time": 14548.79, "timestamp": "04:02:28", "text": "あるいは、決してない。彼らが私をどう見ているかわかりません"}, {"type": "subtitle", "time": 14556.63, "timestamp": "04:02:36", "text": "でも、一体どういうこと？彼女はポップイエローを手に入れた"}, {"type": "subtitle", "time": 14562.429, "timestamp": "04:02:42", "text": "バッジ。それは人気の配信ですね。人気のある。"}, {"type": "subtitle", "time": 14566.91, "timestamp": "04:02:46", "text": "何？どうやって？どうやって？ 3ポイント。"}, {"type": "subtitle", "time": 14570.79, "timestamp": "04:02:50", "text": "どうやって？待って、それらはすごく大きいの？ああ、なんてことだ。"}, {"type": "subtitle", "time": 14572.55, "timestamp": "04:02:52", "text": "ああ、本当に大きいですね。はい、私は"}, {"type": "subtitle", "time": 14575.75, "timestamp": "04:02:55", "text": "ごめん。それらはとても大きい。わかった、絶対にない"}, {"type": "subtitle", "time": 14578.99, "timestamp": "04:02:58", "text": "心。ああ、それらは大きい、大きい"}]
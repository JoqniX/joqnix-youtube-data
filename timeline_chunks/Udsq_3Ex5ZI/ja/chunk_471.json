[{"type": "subtitle", "time": 28261.868, "timestamp": "07:51:01", "text": "[音楽]"}, {"type": "subtitle", "time": 28284.15, "timestamp": "07:51:24", "text": "なぜ彼はあれで神のように見えるのか"}, {"type": "subtitle", "time": 28287.51, "timestamp": "07:51:27", "text": "日光とあの光の眩しさ？知っている"}, {"type": "subtitle", "time": 28288.35, "timestamp": "07:51:28", "text": "の"}, {"type": "subtitle", "time": 28308.19, "timestamp": "07:51:48", "text": "彼は"}, {"type": "subtitle", "time": 28311.1, "timestamp": "07:51:51", "text": "神。天が開く"}]
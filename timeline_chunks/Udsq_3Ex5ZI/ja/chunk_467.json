[{"type": "subtitle", "time": 28044.83, "timestamp": "07:47:24", "text": "親切"}, {"type": "subtitle", "time": 28060.388, "timestamp": "07:47:40", "text": "なぜこんなことを考えたんだろう"}, {"type": "subtitle", "time": 28064.35, "timestamp": "07:47:44", "text": "私が心の中で言ったのは"}, {"type": "subtitle", "time": 28067.07, "timestamp": "07:47:47", "text": "言うか"}, {"type": "subtitle", "time": 28070.708, "timestamp": "07:47:50", "text": "何か。ヒンディー語で「もう一度」とは何ですか？私"}, {"type": "subtitle", "time": 28073.75, "timestamp": "07:47:53", "text": "忘れた。待って、これってヒンディー語？私は思う"}, {"type": "subtitle", "time": 28075.15, "timestamp": "07:47:55", "text": "それ"}]
[{"type": "subtitle", "time": 15781.269, "timestamp": "04:23:01", "text": "今、とても重要です。そしてできるだけ多く手に入れる"}, {"type": "subtitle", "time": 15782.95, "timestamp": "04:23:02", "text": "できるだけお金を使ってください。"}, {"type": "subtitle", "time": 15785.59, "timestamp": "04:23:05", "text": "数字は減り始めるだろう。私"}, {"type": "subtitle", "time": 15787.429, "timestamp": "04:23:07", "text": "悲観的な投稿をするつもりはないが、"}, {"type": "subtitle", "time": 15789.229, "timestamp": "04:23:09", "text": "クリエイターたちは危険にさらされている。そしてそれは"}, {"type": "subtitle", "time": 15792.389, "timestamp": "04:23:12", "text": "おそらくこの動画のタイトルでしょう。しかし"}, {"type": "subtitle", "time": 15794.309, "timestamp": "04:23:14", "text": "このビデオをぜひ共有してください"}, {"type": "subtitle", "time": 15797.349, "timestamp": "04:23:17", "text": "お気に入りのクリエイター、または彼らが怒った場合"}, {"type": "subtitle", "time": 15799.03, "timestamp": "04:23:19", "text": "彼らは私の顔を見ただけで、"}, {"type": "subtitle", "time": 15800.63, "timestamp": "04:23:20", "text": "インターネットで悪いことをした"}, {"type": "subtitle", "time": 15802.469, "timestamp": "04:23:22", "text": "それは事実ではなかった。ええと、彼らに伝えるだけでいいですよ"}, {"type": "subtitle", "time": 15804.71, "timestamp": "04:23:24", "text": "要するに、私が言ったことです。えっと、DMだけ"}, {"type": "subtitle", "time": 15808.07, "timestamp": "04:23:28", "text": "彼らにはそうだけど、私のDMは開いています"}, {"type": "subtitle", "time": 15810.63, "timestamp": "04:23:30", "text": "助けが必要な人、そしてどんな"}, {"type": "subtitle", "time": 15813.03, "timestamp": "04:23:33", "text": "平均5万以上のフォロワーを獲得したクリエイター"}, {"type": "subtitle", "time": 15815.189, "timestamp": "04:23:35", "text": "YouTubeで1000回以上再生"}, {"type": "subtitle", "time": 15817.03, "timestamp": "04:23:37", "text": "Twitchの視聴者の皆様は、お気軽にご連絡ください。"}, {"type": "subtitle", "time": 15818.71, "timestamp": "04:23:38", "text": "私にとって。広告主と連絡を取れるように手配できます"}, {"type": "subtitle", "time": 15821.83, "timestamp": "04:23:41", "text": "代理店は非常に簡単にマネージャーと契約できます。私のDM"}, {"type": "subtitle", "time": 15823.189, "timestamp": "04:23:43", "text": "Twitter は常に開いていて、私はチェックしています"}, {"type": "subtitle", "time": 15824.63, "timestamp": "04:23:44", "text": "毎日彼らと会っています。それではまた次回お会いしましょう"}, {"type": "subtitle", "time": 15826.149, "timestamp": "04:23:46", "text": "時間。ご視聴ありがとうございました。そしてすべての"}, {"type": "subtitle", "time": 15827.83, "timestamp": "04:23:47", "text": "いつもの視聴者の皆さん、なぜ"}, {"type": "subtitle", "time": 15829.269, "timestamp": "04:23:49", "text": "あれを見てる？あなたたちは作らない"}, {"type": "subtitle", "time": 15830.95, "timestamp": "04:23:50", "text": "動画。もしかしたらそうなるかもしれませんね。お勧めします"}, {"type": "subtitle", "time": 15832.87, "timestamp": "04:23:52", "text": "みんな今すぐストリーミングを始めよう、なぜなら"}, {"type": "subtitle", "time": 15834.389, "timestamp": "04:23:54", "text": "多くの人が"}, {"type": "subtitle", "time": 15836.229, "timestamp": "04:23:56", "text": "退職しました。また近いうちに会いましょう。いいね、コメント、"}]
[{"type": "subtitle", "time": 15662.469, "timestamp": "04:21:02", "text": "最近起こった出来事で、"}, {"type": "subtitle", "time": 15665.75, "timestamp": "04:21:05", "text": "ウィル・ネフやキャロリンのようなクリエイター"}, {"type": "subtitle", "time": 15668.79, "timestamp": "04:21:08", "text": "視聴していませんでした。しかし、同社は"}, {"type": "subtitle", "time": 15672.07, "timestamp": "04:21:12", "text": "それらを見ていたのですが、それが"}, {"type": "subtitle", "time": 15674.389, "timestamp": "04:21:14", "text": "クリエイターは、"}, {"type": "subtitle", "time": 15677.67, "timestamp": "04:21:17", "text": "理由。しかし、それは多くの肛門が"}, {"type": "subtitle", "time": 15679.59, "timestamp": "04:21:19", "text": "スポンサーは得ている。そして、そこで"}, {"type": "subtitle", "time": 15681.67, "timestamp": "04:21:21", "text": "多くのスポンサーが賢くなってきている"}, {"type": "subtitle", "time": 15683.91, "timestamp": "04:21:23", "text": "なぜなら、ボットを見れば"}, {"type": "subtitle", "time": 15686.07, "timestamp": "04:21:26", "text": "これらのクリエイターは、より多くの人が視聴するだろう"}, {"type": "subtitle", "time": 15688.469, "timestamp": "04:21:28", "text": "彼らのストリーム。しかし、多くの"}, {"type": "subtitle", "time": 15691.11, "timestamp": "04:21:31", "text": "過去のストリーマーは、まあ、"}, {"type": "subtitle", "time": 15692.71, "timestamp": "04:21:32", "text": "今はひどい目に遭っている"}, {"type": "subtitle", "time": 15694.95, "timestamp": "04:21:34", "text": "みんな彼らをビューボット業者と呼んでいる。"}, {"type": "subtitle", "time": 15696.79, "timestamp": "04:21:36", "text": "おお。そして最悪なのはこれら"}, {"type": "subtitle", "time": 15698.87, "timestamp": "04:21:38", "text": "企業はあなたの許可すら求めません"}, {"type": "subtitle", "time": 15701.03, "timestamp": "04:21:41", "text": "あなたにビューボットする必要はありません"}, {"type": "subtitle", "time": 15703.67, "timestamp": "04:21:43", "text": "あなたに伝えるために。おお。本当に本当に"}, {"type": "subtitle", "time": 15707.67, "timestamp": "04:21:47", "text": "本当にひどい。私はスポーンしたことがなかったので"}, {"type": "subtitle", "time": 15711.59, "timestamp": "04:21:51", "text": "十分な知識がない"}, {"type": "subtitle", "time": 15713.59, "timestamp": "04:21:53", "text": "統合。"}, {"type": "subtitle", "time": 15717.429, "timestamp": "04:21:57", "text": "将来、ストリームは"}, {"type": "subtitle", "time": 15719.229, "timestamp": "04:21:59", "text": "減額された給与で支給される予定です"}]
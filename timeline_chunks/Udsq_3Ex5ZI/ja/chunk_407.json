[{"type": "subtitle", "time": 24421.23, "timestamp": "06:47:01", "text": "ええ、家族と出かけました"}, {"type": "subtitle", "time": 24424.948, "timestamp": "06:47:04", "text": "昨日。行ったよ、行ったよ"}, {"type": "subtitle", "time": 24427.83, "timestamp": "06:47:07", "text": "ショッピングモールで、そう、私たちは男をさまよわせた。いつ"}, {"type": "subtitle", "time": 24430.39, "timestamp": "06:47:10", "text": "歩いていると、"}, {"type": "subtitle", "time": 24433.468, "timestamp": "06:47:13", "text": "多く。とても疲れる"}, {"type": "subtitle", "time": 24436.43, "timestamp": "06:47:16", "text": "簡単に。内向的な人なので、"}, {"type": "subtitle", "time": 24438.83, "timestamp": "06:47:18", "text": "まあ、普通。しかし"}, {"type": "subtitle", "time": 24444.468, "timestamp": "06:47:24", "text": "それでも、それでも私は家に帰った。私はほとんど"}, {"type": "subtitle", "time": 24447.51, "timestamp": "06:47:27", "text": "つまり、私は夕食をなんとか食べることができたということだ"}, {"type": "subtitle", "time": 24451.35, "timestamp": "06:47:31", "text": "そして少しの間眠った。"}, {"type": "subtitle", "time": 24453.51, "timestamp": "06:47:33", "text": "それから彼らは目を覚ました、私を起こして"}, {"type": "subtitle", "time": 24456.468, "timestamp": "06:47:36", "text": "何か役に立つもの。私は自分の"}, {"type": "subtitle", "time": 24459.23, "timestamp": "06:47:39", "text": "祖母と"}, {"type": "subtitle", "time": 24463.19, "timestamp": "06:47:43", "text": "もの。それから目が覚めて、それから、えっと、"}, {"type": "subtitle", "time": 24465.67, "timestamp": "06:47:45", "text": "その時、いとこに遊ばせてあげたんだ"}, {"type": "subtitle", "time": 24469.19, "timestamp": "06:47:49", "text": "少しの間、パソコンを使う。ええ、寝ました"}]
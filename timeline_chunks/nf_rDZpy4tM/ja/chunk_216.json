[{"type": "subtitle", "time": 12968.79, "timestamp": "03:36:08", "text": "待って。まあ、これは私に話させるようなことだ"}, {"type": "subtitle", "time": 12971.11, "timestamp": "03:36:11", "text": "心からの会話について。よかった"}, {"type": "subtitle", "time": 12976.87, "timestamp": "03:36:16", "text": "心臓。それはピーという音です。何か"}, {"type": "subtitle", "time": 12978.87, "timestamp": "03:36:18", "text": "あなたの人生に良いことが起こると私は言いました"}, {"type": "subtitle", "time": 12981.469, "timestamp": "03:36:21", "text": "捧げる"}, {"type": "subtitle", "time": 12984.15, "timestamp": "03:36:24", "text": "話す。私はあなたをいじめる人です"}, {"type": "subtitle", "time": 12986.59, "timestamp": "03:36:26", "text": "終わり。感謝"}, {"type": "subtitle", "time": 12991.67, "timestamp": "03:36:31", "text": "君は男だ。うん。こんにちは。いらっしゃいませ。いらっしゃいませ。"}, {"type": "subtitle", "time": 12993.07, "timestamp": "03:36:33", "text": "調子はどうですか？"}, {"type": "subtitle", "time": 13003.349, "timestamp": "03:36:43", "text": "今日？ M. お元気ですか？どうやって見つけたの？"}, {"type": "subtitle", "time": 13016.91, "timestamp": "03:36:56", "text": "もの"}]
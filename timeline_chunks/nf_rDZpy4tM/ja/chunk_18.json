[{"type": "subtitle", "time": 1082.87, "timestamp": "00:18:02", "text": "場所。待って、胸を吸ってもいい？"}, {"type": "subtitle", "time": 1084.63, "timestamp": "00:18:04", "text": "あなたに向かって？待って、待って、待って。したい"}, {"type": "subtitle", "time": 1087.71, "timestamp": "00:18:07", "text": "それを試してみますよね？どうすれば入手できますか"}, {"type": "subtitle", "time": 1091.789, "timestamp": "00:18:11", "text": "上？まだテストしていません。"}, {"type": "subtitle", "time": 1097.43, "timestamp": "00:18:17", "text": "推測。シャットダウンすることは可能ですか？"}, {"type": "subtitle", "time": 1099.27, "timestamp": "00:18:19", "text": "最悪？何か素敵な話を聞きたいですか？彼らは"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "これを倒した。大きな磁石。彼らは"}, {"type": "subtitle", "time": 1103.75, "timestamp": "00:18:23", "text": "全てを飲み干した。のように"}, {"type": "subtitle", "time": 1106.31, "timestamp": "00:18:26", "text": "磁石。だから、全部吸い込んだんだ。あなた"}, {"type": "subtitle", "time": 1108.31, "timestamp": "00:18:28", "text": "港湾地帯のスカベンジャーを知っている。"}, {"type": "subtitle", "time": 1110.549, "timestamp": "00:18:30", "text": "彼らは本当に独創的だ。待って、待って、"}, {"type": "subtitle", "time": 1112.07, "timestamp": "00:18:32", "text": "待って、待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 1114.07, "timestamp": "00:18:34", "text": "待って、待って、待って。いい考えが浮かんだ。私は手に入れた"}, {"type": "subtitle", "time": 1118.11, "timestamp": "00:18:38", "text": "一つのアイデア。私はその任務の一つを携えて行きます。"}, {"type": "subtitle", "time": 1121.669, "timestamp": "00:18:41", "text": "ファックル。こっちに持ってきて。私は手に入れることができます"}, {"type": "subtitle", "time": 1124.47, "timestamp": "00:18:44", "text": "飛び上がるための後押し。ええ、それは"}, {"type": "subtitle", "time": 1127.75, "timestamp": "00:18:47", "text": "素晴らしいアイデアだね、ジョー。良い。君は頭がいいね。"}, {"type": "subtitle", "time": 1130.909, "timestamp": "00:18:50", "text": "うん。待って、私はそれを見つけなければならない、"}, {"type": "subtitle", "time": 1134.95, "timestamp": "00:18:54", "text": "右？吸い続けてください。"}, {"type": "subtitle", "time": 1137.909, "timestamp": "00:18:57", "text": "はい。はい。はい。あなたを愛しています"}]
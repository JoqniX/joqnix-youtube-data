[{"type": "subtitle", "time": 15482.07, "timestamp": "04:18:02", "text": "2番。ああ、ブラウザを作らなきゃ。"}, {"type": "subtitle", "time": 15485.11, "timestamp": "04:18:05", "text": "あらら。何かが起こっている。私は嫌いです"}, {"type": "subtitle", "time": 15489.59, "timestamp": "04:18:09", "text": "これ。そこには何もありませんでした。私にハッタリをさせてください"}, {"type": "subtitle", "time": 15491.67, "timestamp": "04:18:11", "text": "2番。"}, {"type": "subtitle", "time": 15500.469, "timestamp": "04:18:20", "text": "アプリは勇敢にならなければならない"}, {"type": "subtitle", "time": 15502.71, "timestamp": "04:18:22", "text": "えっと、デフォルトブラウザです。ARブラウザではできないので。"}, {"type": "subtitle", "time": 15505.87, "timestamp": "04:18:25", "text": "ローンチのように"}, {"type": "subtitle", "time": 15518.59, "timestamp": "04:18:38", "text": "[音楽]"}, {"type": "subtitle", "time": 15528.95, "timestamp": "04:18:48", "text": "入れてください。わかりました、入れてください。ああ。おお。おお、"}, {"type": "subtitle", "time": 15530.55, "timestamp": "04:18:50", "text": "私たちは参加しています。私たちは参加しています。私たちは参加しています。私たちは"}, {"type": "subtitle", "time": 15533.67, "timestamp": "04:18:53", "text": "入った。入った。入った。みんな、みんな、"}, {"type": "subtitle", "time": 15534.91, "timestamp": "04:18:54", "text": "女性と"}, {"type": "subtitle", "time": 15538.07, "timestamp": "04:18:58", "text": "紳士諸君。入りました。えっと、ちょっと切り替えさせてください。"}]
[{"type": "subtitle", "time": 3123.27, "timestamp": "00:52:03", "text": "これ？ああ、今はエレベーターになっているんですね。わかった。"}, {"type": "subtitle", "time": 3125.829, "timestamp": "00:52:05", "text": "あなたは栄光を求めているのですか？それから参加する"}, {"type": "subtitle", "time": 3129.03, "timestamp": "00:52:09", "text": "G3カルテル。私の名前はダグラス、G3です"}, {"type": "subtitle", "time": 3131.589, "timestamp": "00:52:11", "text": "訓練および拷問の責任者。 2番"}, {"type": "subtitle", "time": 3133.27, "timestamp": "00:52:13", "text": "この広告には少しだけ費用がかかります。これはまさに"}, {"type": "subtitle", "time": 3135.03, "timestamp": "00:52:15", "text": "トレーニング。"}, {"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "ああ、ちくしょう。そこには"}, {"type": "subtitle", "time": 3139.109, "timestamp": "00:52:19", "text": "ダグラスはまさにそこにいる。それでわかる"}, {"type": "subtitle", "time": 3141.75, "timestamp": "00:52:21", "text": "私たちは正しい場所にいる。"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "やあ、またダグラスだ。これは"}, {"type": "subtitle", "time": 3151.43, "timestamp": "00:52:31", "text": "拷問。えーと、最後のは"}, {"type": "subtitle", "time": 3153.19, "timestamp": "00:52:33", "text": "G3に加わるが、これは"}, {"type": "subtitle", "time": 3156.309, "timestamp": "00:52:36", "text": "私は拷問するのが大好きなんです。そんなことは存在しない。"}, {"type": "subtitle", "time": 3157.91, "timestamp": "00:52:37", "text": "それは、"}, {"type": "subtitle", "time": 3160.309, "timestamp": "00:52:40", "text": "私の仕事は、人を拷問することでもある。敵"}, {"type": "subtitle", "time": 3162.63, "timestamp": "00:52:42", "text": "G3の、見知らぬ人たちが"}, {"type": "subtitle", "time": 3164.95, "timestamp": "00:52:44", "text": "面白くして。誰でもいい。の一部です"}, {"type": "subtitle", "time": 3167.27, "timestamp": "00:52:47", "text": "暴力反対の母親条約。だから、いいえ"}, {"type": "subtitle", "time": 3169.109, "timestamp": "00:52:49", "text": "ここでは暴力が許されている。気をつけて。"}, {"type": "subtitle", "time": 3172.39, "timestamp": "00:52:52", "text": "暴力に反対する母親たち。まあ、それは"}, {"type": "subtitle", "time": 3174.15, "timestamp": "00:52:54", "text": "我々に有利な結果となる。私たちは"}, {"type": "subtitle", "time": 3175.67, "timestamp": "00:52:55", "text": "この件に関して何か問題が起こることを心配する必要はありません"}, {"type": "subtitle", "time": 3177.99, "timestamp": "00:52:57", "text": "エリア。"}]
[{"type": "subtitle", "time": 11823.11, "timestamp": "03:17:03", "text": "しかし、ある意味では、そうではない。なぜなら、"}, {"type": "subtitle", "time": 11825.07, "timestamp": "03:17:05", "text": "私はインディーズです、"}, {"type": "subtitle", "time": 11827.98, "timestamp": "03:17:07", "text": "右？私はインディーズですよね？"}, {"type": "subtitle", "time": 11829.71, "timestamp": "03:17:09", "text": "[音楽]"}, {"type": "subtitle", "time": 11833.79, "timestamp": "03:17:13", "text": "だから私は、たとえ私の創造主がいてもそうする"}, {"type": "subtitle", "time": 11837.99, "timestamp": "03:17:17", "text": "ライセンスですが、それでもあなたを救うことはできません"}, {"type": "subtitle", "time": 11839.309, "timestamp": "03:17:19", "text": "長期的に"}, {"type": "subtitle", "time": 11841.15, "timestamp": "03:17:21", "text": "右"}, {"type": "subtitle", "time": 11843.99, "timestamp": "03:17:23", "text": "つまり、それはあなたが"}, {"type": "subtitle", "time": 11846.07, "timestamp": "03:17:26", "text": "誰かまたは何人かが著作権を所有するビデオ"}, {"type": "subtitle", "time": 11848.429, "timestamp": "03:17:28", "text": "会社、だって"}, {"type": "subtitle", "time": 11851.83, "timestamp": "03:17:31", "text": "ええ、それがどうなっているのかはわかりません"}, {"type": "subtitle", "time": 11854.51, "timestamp": "03:17:34", "text": "どのように展開するか"}, {"type": "subtitle", "time": 11857.63, "timestamp": "03:17:37", "text": "外で私は考える"}, {"type": "subtitle", "time": 11860.11, "timestamp": "03:17:40", "text": "だから"}, {"type": "subtitle", "time": 11863.11, "timestamp": "03:17:43", "text": "人々は企業のサイトにアクセスします。"}, {"type": "subtitle", "time": 11865.75, "timestamp": "03:17:45", "text": "だから保護とかそういうのには、"}, {"type": "subtitle", "time": 11868.55, "timestamp": "03:17:48", "text": "企業側だけじゃなくて、つまり"}, {"type": "subtitle", "time": 11871.429, "timestamp": "03:17:51", "text": "あなたが音楽アーティストなら、"}, {"type": "subtitle", "time": 11874.19, "timestamp": "03:17:54", "text": "才能ある人材を探している"}, {"type": "subtitle", "time": 11877.67, "timestamp": "03:17:57", "text": "代理店 忘れた えーと、それで私は知っていた、私はいくつか"}]
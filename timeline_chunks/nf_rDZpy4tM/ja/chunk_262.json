[{"type": "subtitle", "time": 15721.429, "timestamp": "04:22:01", "text": "トラウマ呼吸。私に私の"}, {"type": "subtitle", "time": 15724.92, "timestamp": "04:22:04", "text": "電話。これは本当に痛い。"}, {"type": "subtitle", "time": 15733.349, "timestamp": "04:22:13", "text": "あなたは目を覚ましました。こんにちは。そうねぇ。誰が"}, {"type": "subtitle", "time": 15735.99, "timestamp": "04:22:15", "text": "これ？この二人の人物は誰ですか？または"}, {"type": "subtitle", "time": 15738.79, "timestamp": "04:22:18", "text": "最後の手段を試さなければならない。"}, {"type": "subtitle", "time": 15742.11, "timestamp": "04:22:22", "text": "若手パトロール隊員のための緊急時対応スキル。"}, {"type": "subtitle", "time": 15745.51, "timestamp": "04:22:25", "text": "心肺蘇生法。心肺蘇生法。"}, {"type": "subtitle", "time": 15748.71, "timestamp": "04:22:28", "text": "[音楽]"}, {"type": "subtitle", "time": 15752.309, "timestamp": "04:22:32", "text": "生きている人間に対しては、決してやったことがない。"}, {"type": "subtitle", "time": 15755.429, "timestamp": "04:22:35", "text": "ジェシア、ごめんね。ごめん。あなたは今目を覚ました"}, {"type": "subtitle", "time": 15758.429, "timestamp": "04:22:38", "text": "そして私はここで"}, {"type": "subtitle", "time": 15762.389, "timestamp": "04:22:42", "text": "嵐。ピーピー。"}, {"type": "subtitle", "time": 15768.07, "timestamp": "04:22:48", "text": "大丈夫ですか？何てことだ。快適。"}, {"type": "subtitle", "time": 15770.63, "timestamp": "04:22:50", "text": "何か違和感を感じますか？ ああ、行きましょう。あなた"}, {"type": "subtitle", "time": 15773.429, "timestamp": "04:22:53", "text": "は。私のことはチシャと呼んでください。チシャ。"}, {"type": "subtitle", "time": 15776.63, "timestamp": "04:22:56", "text": "彼はヤンだ。ヤン。こんにちは、ヤンヤン。こんにちは、"}]
[{"type": "subtitle", "time": 10980.15, "timestamp": "03:03:00", "text": "何かがあって、私が戻ってきて"}, {"type": "subtitle", "time": 10982.19, "timestamp": "03:03:02", "text": "前方に"}, {"type": "subtitle", "time": 10995.99, "timestamp": "03:03:15", "text": "えっと、私、何て言ってたっけ？"}, {"type": "subtitle", "time": 10999.429, "timestamp": "03:03:19", "text": "ああ、ある意味では、もう君を困らせるのはやめるよ。"}, {"type": "subtitle", "time": 11001.67, "timestamp": "03:03:21", "text": "とにかく、私たちは"}, {"type": "subtitle", "time": 11005.59, "timestamp": "03:03:25", "text": "ビデオは、私がやることすべてで忙しくなるから"}, {"type": "subtitle", "time": 11008.469, "timestamp": "03:03:28", "text": "時々DCを見たり、アニメを見たりします。"}, {"type": "subtitle", "time": 11010.19, "timestamp": "03:03:30", "text": "私"}, {"type": "subtitle", "time": 11011.87, "timestamp": "03:03:31", "text": "あまりにも"}, {"type": "subtitle", "time": 11014.19, "timestamp": "03:03:34", "text": "共感できる。ええ、私も見逃さなければなりません"}, {"type": "subtitle", "time": 11016.63, "timestamp": "03:03:36", "text": "人々はYouTubeに夢中になる"}, {"type": "subtitle", "time": 11018.389, "timestamp": "03:03:38", "text": "彼らは自分たちのことに集中するだろう"}, {"type": "subtitle", "time": 11027.67, "timestamp": "03:03:47", "text": "でも、時間があれば"}, {"type": "subtitle", "time": 11030.87, "timestamp": "03:03:50", "text": "来て、あなたの配信とかを見てください"}, {"type": "subtitle", "time": 11036.349, "timestamp": "03:03:56", "text": "[音楽]"}]
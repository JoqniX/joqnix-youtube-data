[{"type": "subtitle", "time": 7440.229, "timestamp": "02:04:00", "text": "実際に持つことができる"}, {"type": "subtitle", "time": 7443.47, "timestamp": "02:04:03", "text": "会社との会話と"}, {"type": "subtitle", "time": 7446.149, "timestamp": "02:04:06", "text": "まるで、ああ、まるで、わかるように、"}, {"type": "subtitle", "time": 7448.31, "timestamp": "02:04:08", "text": "そこから抜け出して、前に進んで"}, {"type": "subtitle", "time": 7451.99, "timestamp": "02:04:11", "text": "卒業を目指すなら、卒業への道を切り開く"}, {"type": "subtitle", "time": 7453.589, "timestamp": "02:04:13", "text": "トウモロコシ畑を卒業するようなもの、"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "そんな感じ。うん。うん。もしあなたが"}, {"type": "subtitle", "time": 7459.07, "timestamp": "02:04:19", "text": "気に入らない、それだけだ"}, {"type": "subtitle", "time": 7463.629, "timestamp": "02:04:23", "text": "有効期限が切れた時"}, {"type": "subtitle", "time": 7466.629, "timestamp": "02:04:26", "text": "会社があなたに尋ねるでしょう"}, {"type": "subtitle", "time": 7470.149, "timestamp": "02:04:30", "text": "私たちと引き続き、またはもっと多くのことをご希望ですか？"}, {"type": "subtitle", "time": 7471.629, "timestamp": "02:04:31", "text": "次のような"}, {"type": "subtitle", "time": 7473.39, "timestamp": "02:04:33", "text": "それ。"}, {"type": "subtitle", "time": 7475.669, "timestamp": "02:04:35", "text": "ええ、彼らは文字通りインドを持っています"}, {"type": "subtitle", "time": 7477.27, "timestamp": "02:04:37", "text": "契約期間について"}, {"type": "subtitle", "time": 7479.03, "timestamp": "02:04:39", "text": "彼らがどれだけのことをしなければならないか一緒に考えましょう"}, {"type": "subtitle", "time": 7481.109, "timestamp": "02:04:41", "text": "たとえあなたが彼らを放っておいても、定期的にストリーミングしてください"}, {"type": "subtitle", "time": 7483.03, "timestamp": "02:04:43", "text": "いくつかの合意が得られるだろう。うん。"}, {"type": "subtitle", "time": 7484.31, "timestamp": "02:04:44", "text": "うん。うん。いくつか"}, {"type": "subtitle", "time": 7487.669, "timestamp": "02:04:47", "text": "特に特に"}, {"type": "subtitle", "time": 7489.75, "timestamp": "02:04:49", "text": "私が見たように、そうすべきではない"}, {"type": "subtitle", "time": 7492.87, "timestamp": "02:04:52", "text": "他の機関でも同様のことが起こる"}, {"type": "subtitle", "time": 7495.51, "timestamp": "02:04:55", "text": "卒業とかそういうのとか"}, {"type": "subtitle", "time": 7498.07, "timestamp": "02:04:58", "text": "あなたがこの機関の一員であれば、使用しないでください"}]
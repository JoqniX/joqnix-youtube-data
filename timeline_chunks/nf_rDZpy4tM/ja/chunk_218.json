[{"type": "subtitle", "time": 13080.55, "timestamp": "03:38:00", "text": "善行、誰かを助けること、家事をすること、または"}, {"type": "subtitle", "time": 13083.429, "timestamp": "03:38:03", "text": "何でも。誰かと話す"}, {"type": "subtitle", "time": 13086.67, "timestamp": "03:38:06", "text": "孤独かどうか、うまくいっているかどうか、すべて"}, {"type": "subtitle", "time": 13090.349, "timestamp": "03:38:10", "text": "もの。できる限りそこにいるようにする"}, {"type": "subtitle", "time": 13093.51, "timestamp": "03:38:13", "text": "誰かと他の人、うん。毎日"}, {"type": "subtitle", "time": 13097.67, "timestamp": "03:38:17", "text": "善行。うん。主にそれです。はぁ。"}, {"type": "subtitle", "time": 13099.389, "timestamp": "03:38:19", "text": "それ"}, {"type": "subtitle", "time": 13102.309, "timestamp": "03:38:22", "text": "VCで来る方法"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "セッションのことだよ、ジョー。ええ、それが理由です"}, {"type": "subtitle", "time": 13108.07, "timestamp": "03:38:28", "text": "先ほど言っていたのは、えっと。ええ、私は"}, {"type": "subtitle", "time": 13111.71, "timestamp": "03:38:31", "text": "たまり場を作るようなことをする"}, {"type": "subtitle", "time": 13119.99, "timestamp": "03:38:39", "text": "週末、毎週週末、でも私は"}, {"type": "subtitle", "time": 13124.269, "timestamp": "03:38:44", "text": "フンガイをやっているんですよね？だから、心配なんです"}, {"type": "subtitle", "time": 13127.95, "timestamp": "03:38:47", "text": "もし私が心配しているなら"}, {"type": "subtitle", "time": 13131.63, "timestamp": "03:38:51", "text": "ああ、心配だ"}, {"type": "subtitle", "time": 13134.71, "timestamp": "03:38:54", "text": "少なくとも1時間、2時間あれば十分です。"}, {"type": "subtitle", "time": 13136.71, "timestamp": "03:38:56", "text": "少なくとも少しは一緒に過ごせるから、それから行くよ"}, {"type": "subtitle", "time": 13139.83, "timestamp": "03:38:59", "text": "配信に戻ります。そうならないことを願います"}]
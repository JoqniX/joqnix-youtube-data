[{"type": "subtitle", "time": 6092.83, "timestamp": "01:41:32", "text": "ああ、胸"}, {"type": "subtitle", "time": 6096.87, "timestamp": "01:41:36", "text": "ドア。その力。え、何？ヒット"}, {"type": "subtitle", "time": 6098.35, "timestamp": "01:41:38", "text": "左"}, {"type": "subtitle", "time": 6100.82, "timestamp": "01:41:40", "text": "側。左を叩く"}, {"type": "subtitle", "time": 6110.79, "timestamp": "01:41:50", "text": "側。いいえ、うまくいきませんでした。私は必要としている"}, {"type": "subtitle", "time": 6114.34, "timestamp": "01:41:54", "text": "それをオフにする。"}, {"type": "subtitle", "time": 6116.31, "timestamp": "01:41:56", "text": "[音楽]"}]
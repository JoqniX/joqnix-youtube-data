[{"type": "subtitle", "time": 16440.949, "timestamp": "04:34:00", "text": "彼が良いものを手に入れる前に世話をされた"}, {"type": "subtitle", "time": 16442.45, "timestamp": "04:34:02", "text": "見て。"}, {"type": "subtitle", "time": 16445.67, "timestamp": "04:34:05", "text": "[音楽]"}, {"type": "subtitle", "time": 16448.869, "timestamp": "04:34:08", "text": "自分の排泄物を見るのは自分の役目だ。そういえば、"}, {"type": "subtitle", "time": 16451.269, "timestamp": "04:34:11", "text": "もうすぐだ。宝箱がある。"}, {"type": "subtitle", "time": 16453.59, "timestamp": "04:34:13", "text": "Baと会うと言った。彼女は"}, {"type": "subtitle", "time": 16455.91, "timestamp": "04:34:15", "text": "共振器。すべての植物を集めてください。なぜ"}, {"type": "subtitle", "time": 16457.51, "timestamp": "04:34:17", "text": "ない？私は彼女の共鳴に対処できる"}, {"type": "subtitle", "time": 16459.75, "timestamp": "04:34:19", "text": "能力と私たちは一緒にあなたを見つけました"}, {"type": "subtitle", "time": 16461.91, "timestamp": "04:34:21", "text": "峡谷の底。バイラは"}, {"type": "subtitle", "time": 16464.47, "timestamp": "04:34:24", "text": "応急処置のご案内です。あなたは"}, {"type": "subtitle", "time": 16468.39, "timestamp": "04:34:28", "text": "溺死したが、気道は確保されていた。見る、"}, {"type": "subtitle", "time": 16471.51, "timestamp": "04:34:31", "text": "あそこに共鳴ビーコンがあります。"}, {"type": "subtitle", "time": 16473.349, "timestamp": "04:34:33", "text": "ビーコンを見かけたら、必ず"}, {"type": "subtitle", "time": 16475.67, "timestamp": "04:34:35", "text": "登録して有効化してください。通常は"}, {"type": "subtitle", "time": 16477.83, "timestamp": "04:34:37", "text": "ああ、ここに宝箱があるよ。"}, {"type": "subtitle", "time": 16480.23, "timestamp": "04:34:40", "text": "ビーコン。それはあなたを危険から守ってくれるでしょう"}, {"type": "subtitle", "time": 16482.709, "timestamp": "04:34:42", "text": "時々。ローバー、あなたの"}, {"type": "subtitle", "time": 16484.67, "timestamp": "04:34:44", "text": "端末"}, {"type": "subtitle", "time": 16488.15, "timestamp": "04:34:48", "text": "一瞬？終わり。その設計とシステム"}, {"type": "subtitle", "time": 16490.789, "timestamp": "04:34:50", "text": "バージョンは私たちのものとは異なりますが、"}, {"type": "subtitle", "time": 16492.789, "timestamp": "04:34:52", "text": "端末にはまだデータが残っています"}]
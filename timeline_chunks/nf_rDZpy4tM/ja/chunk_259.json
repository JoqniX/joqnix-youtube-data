[{"type": "subtitle", "time": 15540.83, "timestamp": "04:19:00", "text": "デフォルトブラウザを再びArcに戻します。"}, {"type": "subtitle", "time": 15543.91, "timestamp": "04:19:03", "text": "ええと、参加しました。参加しました。参加しました。ああ"}, {"type": "subtitle", "time": 15545.95, "timestamp": "04:19:05", "text": "我が神よ。さあ行こう。見た目は"}, {"type": "subtitle", "time": 15554.99, "timestamp": "04:19:14", "text": "ブラウザ。これをデフォルトにするにはどうすればいいですか？"}, {"type": "subtitle", "time": 15557.149, "timestamp": "04:19:17", "text": "ブラウザ？どのように"}, {"type": "subtitle", "time": 15559.71, "timestamp": "04:19:19", "text": "わからない"}, {"type": "subtitle", "time": 15562.95, "timestamp": "04:19:22", "text": "もう。わかった。えっと、アニメが近い。近い"}, {"type": "subtitle", "time": 15565.11, "timestamp": "04:19:25", "text": "それ。こんにちは。女性を選びます"}, {"type": "subtitle", "time": 15568.79, "timestamp": "04:19:28", "text": "キャラクター。わかった。私はEpicを使っています。こんにちは。"}, {"type": "subtitle", "time": 15572.349, "timestamp": "04:19:32", "text": "さあ行こう。次はスポーツマンだ。ああ、"}, {"type": "subtitle", "time": 15594.269, "timestamp": "04:19:54", "text": "それ。さあ行こう。さあ行こう。さあ"}, {"type": "subtitle", "time": 15597.83, "timestamp": "04:19:57", "text": "行く。誇大宣伝。誇大宣伝。誇大宣伝。誇大宣伝。誇大宣伝。誇大宣伝。"}]
[{"type": "subtitle", "time": 5640.31, "timestamp": "01:34:00", "text": "ビュー。まるで土星か何かみたいだ。"}, {"type": "subtitle", "time": 5641.39, "timestamp": "01:34:01", "text": "その"}, {"type": "subtitle", "time": 5649.189, "timestamp": "01:34:09", "text": "おお。かっこいいと思わない？ああ、なんてことだ、"}, {"type": "subtitle", "time": 5657.27, "timestamp": "01:34:17", "text": "あなたです。また君か。見て嬉しい"}, {"type": "subtitle", "time": 5659.91, "timestamp": "01:34:19", "text": "あなた？私はとても幸せです。私は"}, {"type": "subtitle", "time": 5664.07, "timestamp": "01:34:24", "text": "私は宇宙的だが、私が"}, {"type": "subtitle", "time": 5666.709, "timestamp": "01:34:26", "text": "失った。その通り。大好きな小さな子。博士"}, {"type": "subtitle", "time": 5669.03, "timestamp": "01:34:29", "text": "J. それはブラックホールだ。それは黒だ"}, {"type": "subtitle", "time": 5671.27, "timestamp": "01:34:31", "text": "穴。時間がなくなってきた。神様、私は"}, {"type": "subtitle", "time": 5673.75, "timestamp": "01:34:33", "text": "子供たちのことが心配で、少し"}, {"type": "subtitle", "time": 5675.43, "timestamp": "01:34:35", "text": "妻のことも少し話したけど、ほとんどは子供たちの話だった。"}, {"type": "subtitle", "time": 5677.27, "timestamp": "01:34:37", "text": "ああ、パズルだ。またパズルか。パズル"}, {"type": "subtitle", "time": 5678.87, "timestamp": "01:34:38", "text": "時間。ちょっと挑戦してみましょう。"}, {"type": "subtitle", "time": 5681.03, "timestamp": "01:34:41", "text": "どうですか？ああ、かわいそうな私の子供たち。願っています"}, {"type": "subtitle", "time": 5683.83, "timestamp": "01:34:43", "text": "Dは彼らを殺さない。手探りで進むことができる"}, {"type": "subtitle", "time": 5686.229, "timestamp": "01:34:46", "text": "私を呼んでいる。あなたは解決するでしょう"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "これもそうだ。ありがとう。"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "やりましょう。"}, {"type": "subtitle", "time": 5695.11, "timestamp": "01:34:55", "text": "ああ、大変だ。この茂みは痛い。"}, {"type": "subtitle", "time": 5697.27, "timestamp": "01:34:57", "text": "スウーピーとFrはあなたのことが本当に好きになると思います。"}, {"type": "subtitle", "time": 5699.51, "timestamp": "01:34:59", "text": "あまりにも。ああ、彼らはいい子たちだよ。待ちきれない"}]
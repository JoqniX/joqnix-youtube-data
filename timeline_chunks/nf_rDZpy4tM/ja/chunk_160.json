[{"type": "subtitle", "time": 9601.27, "timestamp": "02:40:01", "text": "完全に絞り込むことができず"}, {"type": "subtitle", "time": 9604.07, "timestamp": "02:40:04", "text": "人口統計のセット。おばあちゃん、警官、"}, {"type": "subtitle", "time": 9606.79, "timestamp": "02:40:06", "text": "映画スター、政治家、みんな"}, {"type": "subtitle", "time": 9609.99, "timestamp": "02:40:09", "text": "私の美味しいエイリアンの精液が好きです。私は"}, {"type": "subtitle", "time": 9611.59, "timestamp": "02:40:11", "text": "あらゆるタイプの変人がここにやってくる"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "「あなたの600ガロンが好きです」"}, {"type": "subtitle", "time": 9615.67, "timestamp": "02:40:15", "text": "「最高品質のエイリアンガム」"}, {"type": "subtitle", "time": 9617.75, "timestamp": "02:40:17", "text": "そして私は言う、「どちらでも構わない"}, {"type": "subtitle", "time": 9619.429, "timestamp": "02:40:19", "text": "宇宙人はどこから来たの？」そして彼らは"}, {"type": "subtitle", "time": 9622.389, "timestamp": "02:40:22", "text": "「いいえ、違います。本当にそうではありません。ただ"}, {"type": "subtitle", "time": 9625.67, "timestamp": "02:40:25", "text": "宇宙人が来てほしい。これ以上の詳細は不明です"}, {"type": "subtitle", "time": 9628.469, "timestamp": "02:40:28", "text": "必要だ。それで、一体何になるんだろう？"}, {"type": "subtitle", "time": 9637.67, "timestamp": "02:40:37", "text": "ホセ、本当にたくさんの人が集まってるね"}, {"type": "subtitle", "time": 9639.91, "timestamp": "02:40:39", "text": "宇宙人のガムを買いたいのか？私"}, {"type": "subtitle", "time": 9642.469, "timestamp": "02:40:42", "text": "クライアントに尋ねないことを方針とします"}, {"type": "subtitle", "time": 9643.91, "timestamp": "02:40:43", "text": "なぜ彼らは何ガロンもの"}, {"type": "subtitle", "time": 9645.75, "timestamp": "02:40:45", "text": "彼らが私から購入する外国人収入。私は思う"}, {"type": "subtitle", "time": 9647.27, "timestamp": "02:40:47", "text": "私が質問する内容が少ないほど"}, {"type": "subtitle", "time": 9648.79, "timestamp": "02:40:48", "text": "人々はこのエイリアンと何をしているのか"}, {"type": "subtitle", "time": 9654.07, "timestamp": "02:40:54", "text": "来てくれたら、なお良い。では、あなたは反対ですか？"}, {"type": "subtitle", "time": 9657.11, "timestamp": "02:40:57", "text": "本物の宇宙人の精液？何が問題なの？"}]
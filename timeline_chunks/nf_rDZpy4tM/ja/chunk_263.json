[{"type": "subtitle", "time": 15790.55, "timestamp": "04:23:10", "text": "私たちは最高の気分です。それは"}, {"type": "subtitle", "time": 15793.67, "timestamp": "04:23:13", "text": "ジェン・ジョー。"}, {"type": "subtitle", "time": 15796.55, "timestamp": "04:23:16", "text": "あなたの服装は地元の人らしくないですね。あなたは"}, {"type": "subtitle", "time": 15799.67, "timestamp": "04:23:19", "text": "放浪の旅人？旅好きですか？"}, {"type": "subtitle", "time": 15803.51, "timestamp": "04:23:23", "text": "誰かが家に帰ってきたのか？"}, {"type": "subtitle", "time": 15806.56, "timestamp": "04:23:26", "text": "ええと、覚えていません。"}, {"type": "subtitle", "time": 15809.99, "timestamp": "04:23:29", "text": "[音楽]"}, {"type": "subtitle", "time": 15813.59, "timestamp": "04:23:33", "text": "だから、なぜ自分がここにいるのか分からない、"}, {"type": "subtitle", "time": 15818.51, "timestamp": "04:23:38", "text": "出身地、あるいはあなたが何者か。"}, {"type": "subtitle", "time": 15821.67, "timestamp": "04:23:41", "text": "うん。だから、"}, {"type": "subtitle", "time": 15826.229, "timestamp": "04:23:46", "text": "目覚めたときに、これらの後遺症が現れます。"}, {"type": "subtitle", "time": 15829.18, "timestamp": "04:23:49", "text": "ふむ。"}, {"type": "subtitle", "time": 15831.349, "timestamp": "04:23:51", "text": "[音楽]"}, {"type": "subtitle", "time": 15834.07, "timestamp": "04:23:54", "text": "風が警告をもたらした。の"}, {"type": "subtitle", "time": 15836.79, "timestamp": "04:23:56", "text": "アトリック海が収束している。新しい"}, {"type": "subtitle", "time": 15838.63, "timestamp": "04:23:58", "text": "酸性土壌が形成されつつある。とは"}]
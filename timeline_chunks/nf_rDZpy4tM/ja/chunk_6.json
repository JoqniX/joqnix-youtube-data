[{"type": "subtitle", "time": 360.749, "timestamp": "00:06:00", "text": "えっと、なんて呼ぶんだっけ？"}, {"type": "subtitle", "time": 362.87, "timestamp": "00:06:02", "text": "えっと、それって何て呼ぶんですか？あなたは何者ですか"}, {"type": "subtitle", "time": 363.87, "timestamp": "00:06:03", "text": "行く"}, {"type": "subtitle", "time": 368.35, "timestamp": "00:06:08", "text": "ハイライフの前回の放送へ。ちょっと待ってください"}, {"type": "subtitle", "time": 371.23, "timestamp": "00:06:11", "text": "見る。今、お見せしましょう。 1つ"}, {"type": "subtitle", "time": 375.23, "timestamp": "00:06:15", "text": "秒よし。前回のハイオン"}, {"type": "subtitle", "time": 378.55, "timestamp": "00:06:18", "text": "人生で、私たちはたくさんのことを経験しました。どんなもの"}, {"type": "subtitle", "time": 386.71, "timestamp": "00:06:26", "text": "聞く？えっと、どんなものかって？私たちは"}, {"type": "subtitle", "time": 394.11, "timestamp": "00:06:34", "text": "二。うん。ええ、最初の2つはやりました"}, {"type": "subtitle", "time": 396.79, "timestamp": "00:06:36", "text": "報奨金。真実。真実。私たちは最初の"}, {"type": "subtitle", "time": 403.95, "timestamp": "00:06:43", "text": "ゲーム。"}, {"type": "subtitle", "time": 406.11, "timestamp": "00:06:46", "text": "えっと、ちょっと待って。何が"}, {"type": "subtitle", "time": 407.629, "timestamp": "00:06:47", "text": "これ？"}, {"type": "subtitle", "time": 410.39, "timestamp": "00:06:50", "text": "待って。ああ、ゲームのブザー音だ。"}, {"type": "subtitle", "time": 412.43, "timestamp": "00:06:52", "text": "わかった。わかった。わかった。私はこう思った。"}, {"type": "subtitle", "time": 415.51, "timestamp": "00:06:55", "text": "待って、このブーンブーンブーンって何？"}, {"type": "subtitle", "time": 417.46, "timestamp": "00:06:57", "text": "ブーンという音がする？"}]
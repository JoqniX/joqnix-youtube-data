[{"type": "subtitle", "time": 3421.43, "timestamp": "00:57:01", "text": "チャットでお互いにハグしたり、"}, {"type": "subtitle", "time": 3425.309, "timestamp": "00:57:05", "text": "何か？私は他の人のためにそれをしました"}, {"type": "subtitle", "time": 3428.069, "timestamp": "00:57:08", "text": "友人たちはそれぞれ自分のチャンネルを持っている。私は手伝いました"}, {"type": "subtitle", "time": 3430.95, "timestamp": "00:57:10", "text": "外。ああ、私たちがダグラスでないことを願います"}, {"type": "subtitle", "time": 3433.19, "timestamp": "00:57:13", "text": "束。あの男はめちゃくちゃ怖い"}, {"type": "subtitle", "time": 3435.67, "timestamp": "00:57:15", "text": "自分。彼はゲイリーを生きたまま演じようとしていた"}, {"type": "subtitle", "time": 3437.19, "timestamp": "00:57:17", "text": "昨夜のパーティー。彼はそうすべきだった"}, {"type": "subtitle", "time": 3438.95, "timestamp": "00:57:18", "text": "正直に。そうですね、私もそうするべきです"}, {"type": "subtitle", "time": 3442.23, "timestamp": "00:57:22", "text": "そうですよね？昨夜のチャットみたいに。私"}, {"type": "subtitle", "time": 3444.15, "timestamp": "00:57:24", "text": "ニプルが現れたなんて信じられない。たとえ"}, {"type": "subtitle", "time": 3446.95, "timestamp": "00:57:26", "text": "視覚的なものではありません。ニプルはすごくかっこいい。平"}, {"type": "subtitle", "time": 3449.43, "timestamp": "00:57:29", "text": "視覚的にそうでなくても、少なくとも"}, {"type": "subtitle", "time": 3451.71, "timestamp": "00:57:31", "text": "いいよね？ニプルはそれほど暑くない"}, {"type": "subtitle", "time": 3454.87, "timestamp": "00:57:34", "text": "そういう意味で。私を信じて。それに彼はカリスマ性がある。"}, {"type": "subtitle", "time": 3457.87, "timestamp": "00:57:37", "text": "パットを抱きしめる。うん。うん。うん。"}, {"type": "subtitle", "time": 3461.91, "timestamp": "00:57:41", "text": "早くヤリたいと聞いてください。"}, {"type": "subtitle", "time": 3463.829, "timestamp": "00:57:43", "text": "私は普段はプロパガンダに賛成なのですが、"}, {"type": "subtitle", "time": 3466.95, "timestamp": "00:57:46", "text": "G3は大嫌いだ。私は彼らが大嫌いだ。まだ"}, {"type": "subtitle", "time": 3471.27, "timestamp": "00:57:51", "text": "また会おう、ちびっ子。ああ、私は小さな"}, {"type": "subtitle", "time": 3473.03, "timestamp": "00:57:53", "text": "まるで、これらの人たちを突破しなければならないかのように"}, {"type": "subtitle", "time": 3475.99, "timestamp": "00:57:55", "text": "まるでオレオを1袋全部食べ尽くすみたいだ。おお"}, {"type": "subtitle", "time": 3477.99, "timestamp": "00:57:57", "text": "ええ、私も自分で何人か殺しました"}]
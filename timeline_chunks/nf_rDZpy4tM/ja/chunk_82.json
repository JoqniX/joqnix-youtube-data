[{"type": "subtitle", "time": 4922.79, "timestamp": "01:22:02", "text": "明日かその頃にデビューするらしい。だから何"}, {"type": "subtitle", "time": 4925.35, "timestamp": "01:22:05", "text": "彼らは何をしなければならないのか、何が"}, {"type": "subtitle", "time": 4933.35, "timestamp": "01:22:13", "text": "えっと、なんて呼ぶんだっけ？彼らが持っているもの"}, {"type": "subtitle", "time": 4934.99, "timestamp": "01:22:14", "text": "やるべきことはデビューの準備と"}, {"type": "subtitle", "time": 4937.91, "timestamp": "01:22:17", "text": "すべて。覚えておいてください、ほとんどの"}, {"type": "subtitle", "time": 4940.35, "timestamp": "01:22:20", "text": "ほとんどのユーチューバーは、もし"}, {"type": "subtitle", "time": 4943.35, "timestamp": "01:22:23", "text": "何らかの方法で事前準備をたくさんして"}, {"type": "subtitle", "time": 4945.51, "timestamp": "01:22:25", "text": "デビューすると、たくさんの"}, {"type": "subtitle", "time": 4947.27, "timestamp": "01:22:27", "text": "あなたのデビューを見に来る人たち。はい、"}, {"type": "subtitle", "time": 4949.99, "timestamp": "01:22:29", "text": "もちろん、そこにもたくさんいるでしょう"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "100以上200以上になるでしょう"}, {"type": "subtitle", "time": 4955.11, "timestamp": "01:22:35", "text": "あなたのデビューに来る人々。しかし、"}, {"type": "subtitle", "time": 4957.03, "timestamp": "01:22:37", "text": "あなたはそこで変わった配信をしています"}, {"type": "subtitle", "time": 4961.55, "timestamp": "01:22:41", "text": "その数より少ない"}, {"type": "subtitle", "time": 4963.99, "timestamp": "01:22:43", "text": "その数字より少し小さい。もちろん、"}, {"type": "subtitle", "time": 4965.91, "timestamp": "01:22:45", "text": "それはその人にとって負担が大きすぎるように思えるだろう"}, {"type": "subtitle", "time": 4968.47, "timestamp": "01:22:48", "text": "えっと、彼らは仲間外れにされたような気分になるでしょう"}, {"type": "subtitle", "time": 4970.629, "timestamp": "01:22:50", "text": "あるいは、ああ私は"}, {"type": "subtitle", "time": 4973.83, "timestamp": "01:22:53", "text": "あまりやっていないし、あまりやっていないし"}, {"type": "subtitle", "time": 4976.11, "timestamp": "01:22:56", "text": "そこか何か。でも覚えておいて"}, {"type": "subtitle", "time": 4979.91, "timestamp": "01:22:59", "text": "これは、それは、いくつかの主要なもののためのものです"}]
[{"type": "subtitle", "time": 8956.429, "timestamp": "02:29:16", "text": "ドア。"}, {"type": "subtitle", "time": 8968.83, "timestamp": "02:29:28", "text": "よお、"}, {"type": "subtitle", "time": 8973.389, "timestamp": "02:29:33", "text": "何？ただ持ち上がるだけです。いいえ、"}, {"type": "subtitle", "time": 8976.389, "timestamp": "02:29:36", "text": "切り取られた。それは私を上へと引き上げ、私は"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "引っかかって落ちた。何てことだ。私の"}, {"type": "subtitle", "time": 8987.63, "timestamp": "02:29:47", "text": "君は歩いて、僕は話して撃つ。"}]
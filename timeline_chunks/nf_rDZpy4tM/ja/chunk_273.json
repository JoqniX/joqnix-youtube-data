[{"type": "subtitle", "time": 16381.11, "timestamp": "04:33:01", "text": "やってくる。"}, {"type": "subtitle", "time": 16383.15, "timestamp": "04:33:03", "text": "やったー、私は"}, {"type": "subtitle", "time": 16387.349, "timestamp": "04:33:07", "text": "殺された。共鳴器は共鳴を得ることができる"}, {"type": "subtitle", "time": 16389.75, "timestamp": "04:33:09", "text": "ダメージを与えたり実行したりする際のエネルギー"}, {"type": "subtitle", "time": 16392.869, "timestamp": "04:33:12", "text": "戦闘中の回避行動。コンサートのエネルギー"}, {"type": "subtitle", "time": 16394.869, "timestamp": "04:33:14", "text": "が満杯の場合、他の共鳴器アイコンは"}, {"type": "subtitle", "time": 16397.269, "timestamp": "04:33:17", "text": "輝きを増す。はい、わかりました。つまり、"}, {"type": "subtitle", "time": 16399.51, "timestamp": "04:33:19", "text": "香港の第三のシステムみたいなもの。"}, {"type": "subtitle", "time": 16400.429, "timestamp": "04:33:20", "text": "手に入れた"}, {"type": "subtitle", "time": 16403.75, "timestamp": "04:33:23", "text": "それ。つまり、あなたのエネルギーは引き起こすのに十分だ"}, {"type": "subtitle", "time": 16405.75, "timestamp": "04:33:25", "text": "既存の共鳴器アウトロスキルと"}, {"type": "subtitle", "time": 16408.15, "timestamp": "04:33:28", "text": "消費エネルギーをすべて消費してトリガーする"}, {"type": "subtitle", "time": 16410.47, "timestamp": "04:33:30", "text": "着信共鳴器の導入スキル。"}, {"type": "subtitle", "time": 16412.709, "timestamp": "04:33:32", "text": "各共鳴器には独自のアウトロがあり、"}, {"type": "subtitle", "time": 16414.349, "timestamp": "04:33:34", "text": "入門スキル。"}, {"type": "subtitle", "time": 16421.269, "timestamp": "04:33:41", "text": "いい声優だけどラグい。待って、Twitchは"}, {"type": "subtitle", "time": 16423.349, "timestamp": "04:33:43", "text": "サーバーが過負荷状態になっているか、非常に動作が遅いのでしょうか？"}, {"type": "subtitle", "time": 16426.15, "timestamp": "04:33:46", "text": "全員の配信。君が戦ったんだ"}, {"type": "subtitle", "time": 16428.709, "timestamp": "04:33:48", "text": "良い。待って、Twitchすら入手してないよ"}, {"type": "subtitle", "time": 16431.189, "timestamp": "04:33:51", "text": "ストリームがカクカクしています。ヤンは駆け寄ってきた"}, {"type": "subtitle", "time": 16432.83, "timestamp": "04:33:52", "text": "あなたを守るために"}, {"type": "subtitle", "time": 16436.31, "timestamp": "04:33:56", "text": "とにかく、陰陽は"}, {"type": "subtitle", "time": 16439.189, "timestamp": "04:33:59", "text": "あなた、そしてバン、テッサのディスコードは"}]
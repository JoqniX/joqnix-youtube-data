[{"type": "subtitle", "time": 2225.349, "timestamp": "00:37:05", "text": "この人たちは一体誰ですか？"}, {"type": "subtitle", "time": 2228.39, "timestamp": "00:37:08", "text": "君はここにいるべき人間じゃない。さっさと出て行け。"}, {"type": "subtitle", "time": 2230.31, "timestamp": "00:37:10", "text": "家に帰る必要はないが、"}, {"type": "subtitle", "time": 2233.45, "timestamp": "00:37:13", "text": "ここにいてください。"}, {"type": "subtitle", "time": 2242.31, "timestamp": "00:37:22", "text": "おい、彼の顔はまるでゲームの物理法則みたいだ。私の"}, {"type": "subtitle", "time": 2252.43, "timestamp": "00:37:32", "text": "自分のことをやれ。私は何も怖くない。"}, {"type": "subtitle", "time": 2268.47, "timestamp": "00:37:48", "text": "うん。また何かあったの？"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "だから、もしそれが"}]
[{"type": "subtitle", "time": 1982.07, "timestamp": "00:33:02", "text": "さもなければ殺される。ウインク。ああ、わかりました。私"}, {"type": "subtitle", "time": 1983.43, "timestamp": "00:33:03", "text": "ここで何が起こっているのか見てください。あなたは私たちを求めている"}, {"type": "subtitle", "time": 1985.509, "timestamp": "00:33:05", "text": "彼らを殺すため？うわぁ。私はそんなことは言っていません。私"}, {"type": "subtitle", "time": 1987.75, "timestamp": "00:33:07", "text": "ただウインクして「オーケー」と言っただけ。うん、"}, {"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "私が言いたかったのはそういうことです。だから、彼を殺しに行って"}, {"type": "subtitle", "time": 1992.389, "timestamp": "00:33:12", "text": "通してあげましょう。いいえ、私は私は"}, {"type": "subtitle", "time": 1995.669, "timestamp": "00:33:15", "text": "タコベルをやるべきだと思う"}, {"type": "subtitle", "time": 2006.87, "timestamp": "00:33:26", "text": "ベル？よし、これを詳しく調べてみよう"}, {"type": "subtitle", "time": 2009.75, "timestamp": "00:33:29", "text": "場所。何かあると思う"}, {"type": "subtitle", "time": 2023.99, "timestamp": "00:33:43", "text": "ああ、どうもありがとうございます。よし、これでいい。"}, {"type": "subtitle", "time": 2026.31, "timestamp": "00:33:46", "text": "なぜ私を使ってくれなかったのですか？私は"}, {"type": "subtitle", "time": 2029.029, "timestamp": "00:33:49", "text": "ごめん。"}, {"type": "subtitle", "time": 2030.87, "timestamp": "00:33:50", "text": "家に帰る必要はないが、"}, {"type": "subtitle", "time": 2033.11, "timestamp": "00:33:53", "text": "ここにいてください。私が不満を言うたびに"}, {"type": "subtitle", "time": 2036.07, "timestamp": "00:33:56", "text": "G3 町議会はいつも私に"}, {"type": "subtitle", "time": 2038.87, "timestamp": "00:33:58", "text": "同じことだ。ごめんね、ケント。ない"}]
[{"type": "subtitle", "time": 16620.07, "timestamp": "04:37:00", "text": "タセットフィールド。"}, {"type": "subtitle", "time": 16622.269, "timestamp": "04:37:02", "text": "何かが"}, {"type": "subtitle", "time": 16626.26, "timestamp": "04:37:06", "text": "そこには。おお"}, {"type": "subtitle", "time": 16631.269, "timestamp": "04:37:11", "text": "[音楽]"}, {"type": "subtitle", "time": 16633.67, "timestamp": "04:37:13", "text": "私たちは遠すぎる。おそらく彼はできない"}, {"type": "subtitle", "time": 16637.269, "timestamp": "04:37:17", "text": "聞こえない、聞こえない。わかった。酸性を形成"}, {"type": "subtitle", "time": 16639.83, "timestamp": "04:37:19", "text": "この期間中の休眠期のフィールド"}, {"type": "subtitle", "time": 16643.67, "timestamp": "04:37:23", "text": "時間。比較的安全です。わかった。"}, {"type": "subtitle", "time": 16645.83, "timestamp": "04:37:25", "text": "この期間中、疑問符期間"}, {"type": "subtitle", "time": 16647.99, "timestamp": "04:37:27", "text": "酸性フィールドの"}, {"type": "subtitle", "time": 16650.949, "timestamp": "04:37:30", "text": "形成時間。形成時間。わかった。"}, {"type": "subtitle", "time": 16654.15, "timestamp": "04:37:34", "text": "形成期間とは休眠期間のことである。"}, {"type": "subtitle", "time": 16656.709, "timestamp": "04:37:36", "text": "しかし、休眠期間が長くなると、"}, {"type": "subtitle", "time": 16658.789, "timestamp": "04:37:38", "text": "内部で生まれた酸っぱい不協和音は"}, {"type": "subtitle", "time": 16662.15, "timestamp": "04:37:42", "text": "通常はより強い。通常はより強い。おお、"}, {"type": "subtitle", "time": 16664.629, "timestamp": "04:37:44", "text": "酸性場が早く形成されるほど、"}, {"type": "subtitle", "time": 16667.349, "timestamp": "04:37:47", "text": "休眠期間が長くなるほど。ああ、私は"}, {"type": "subtitle", "time": 16679.91, "timestamp": "04:37:59", "text": "グライダーは無理だろうけど、きっと大丈夫だろう。"}]
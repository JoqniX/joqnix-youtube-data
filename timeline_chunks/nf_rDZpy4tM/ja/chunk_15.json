[{"type": "subtitle", "time": 900.67, "timestamp": "00:15:00", "text": "それを我々の有利に利用できるかもしれない。"}, {"type": "subtitle", "time": 910.389, "timestamp": "00:15:10", "text": "わかった。だから、待つべきではない。誰"}, {"type": "subtitle", "time": 946.31, "timestamp": "00:15:46", "text": "の上。わかった。わかった。"}, {"type": "subtitle", "time": 949.71, "timestamp": "00:15:49", "text": "つまり、徒歩で行ける場所は2ヶ所あるということです。"}, {"type": "subtitle", "time": 954.15, "timestamp": "00:15:54", "text": "場所。そして、これは一体何ですか？"}, {"type": "subtitle", "time": 955.59, "timestamp": "00:15:55", "text": "次の波に備えよ、バウンティ"}]
[{"type": "subtitle", "time": 2281.91, "timestamp": "00:38:01", "text": "赤いもののようなものを持っている"}, {"type": "subtitle", "time": 2284.31, "timestamp": "00:38:04", "text": "炎のようなものの台座。つまり"}, {"type": "subtitle", "time": 2289.51, "timestamp": "00:38:09", "text": "私が利用できるプラットフォーム。わかった。"}, {"type": "subtitle", "time": 2301.51, "timestamp": "00:38:21", "text": "停止。自分が思うようにできたらいいのに。私"}, {"type": "subtitle", "time": 2308.69, "timestamp": "00:38:28", "text": "知る。ずっと駐車して"}, {"type": "subtitle", "time": 2309.95, "timestamp": "00:38:29", "text": "[音楽]"}, {"type": "subtitle", "time": 2312.99, "timestamp": "00:38:32", "text": "を通して。私"}, {"type": "subtitle", "time": 2315.67, "timestamp": "00:38:35", "text": "考える。うん。こんにちは。静かに。元気ですか"}, {"type": "subtitle", "time": 2329.95, "timestamp": "00:38:49", "text": "動き続けろ。"}, {"type": "subtitle", "time": 2333.03, "timestamp": "00:38:53", "text": "観光客です。さあ、急げ。あなた"}]
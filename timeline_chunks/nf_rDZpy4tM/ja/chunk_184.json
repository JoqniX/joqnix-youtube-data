[{"type": "subtitle", "time": 11040.15, "timestamp": "03:04:00", "text": "マヤのように。これもまた私をああ神にさせる、"}, {"type": "subtitle", "time": 11042.71, "timestamp": "03:04:02", "text": "この音楽は私を熱くさせるだろう"}, {"type": "subtitle", "time": 11044.83, "timestamp": "03:04:04", "text": "ホットドッグ。ああ、"}, {"type": "subtitle", "time": 11048.269, "timestamp": "03:04:08", "text": "神。そうそう。では"}, {"type": "subtitle", "time": 11052.59, "timestamp": "03:04:12", "text": "ある意味、私はこれにワクワクしています"}, {"type": "subtitle", "time": 11057.67, "timestamp": "03:04:17", "text": "エリア。いろいろなことにワクワクしています"}, {"type": "subtitle", "time": 11059.15, "timestamp": "03:04:19", "text": "えーと"}, {"type": "subtitle", "time": 11062.99, "timestamp": "03:04:22", "text": "私の周りのものが好きです。あれはスタースケープだ"}, {"type": "subtitle", "time": 11065.75, "timestamp": "03:04:25", "text": "仮想現実と個々のクリエイター"}, {"type": "subtitle", "time": 11068.51, "timestamp": "03:04:28", "text": "インディーズも同様"}, {"type": "subtitle", "time": 11071.67, "timestamp": "03:04:31", "text": "自分。それらはすべてそれらはすべて"}, {"type": "subtitle", "time": 11074.389, "timestamp": "03:04:34", "text": "彼らは最善を尽くしている。"}, {"type": "subtitle", "time": 11082.55, "timestamp": "03:04:42", "text": "もの。うん。だから、新しいものに投資する"}, {"type": "subtitle", "time": 11085.67, "timestamp": "03:04:45", "text": "いろいろなことをして、もっとコンテンツを作って、"}, {"type": "subtitle", "time": 11087.36, "timestamp": "03:04:47", "text": "新しいものやその他いろいろ、"}, {"type": "subtitle", "time": 11089.63, "timestamp": "03:04:49", "text": "[音楽]"}, {"type": "subtitle", "time": 11092.51, "timestamp": "03:04:52", "text": "右？"}, {"type": "subtitle", "time": 11096.07, "timestamp": "03:04:56", "text": "そう、そんな感じ。そして、それは私に"}, {"type": "subtitle", "time": 11098.19, "timestamp": "03:04:58", "text": "私の棚を見てください、"}]
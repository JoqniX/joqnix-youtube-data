[{"type": "subtitle", "time": 13564.11, "timestamp": "03:46:04", "text": "皆さんもご存知かもしれませんが"}, {"type": "subtitle", "time": 13566.59, "timestamp": "03:46:06", "text": "私が手伝っている"}, {"type": "subtitle", "time": 13570.309, "timestamp": "03:46:10", "text": "スタースケープを手伝ったり、親切な人を支援したり"}, {"type": "subtitle", "time": 13572.349, "timestamp": "03:46:12", "text": "以前は手伝っていました"}, {"type": "subtitle", "time": 13575.429, "timestamp": "03:46:15", "text": "仮想現実主義は、私は"}, {"type": "subtitle", "time": 13578.309, "timestamp": "03:46:18", "text": "まあ、手伝うのはちょっとやめちゃったけど"}, {"type": "subtitle", "time": 13580.309, "timestamp": "03:46:20", "text": "ポッドキャストとかそういうのを使った仮想化"}, {"type": "subtitle", "time": 13581.07, "timestamp": "03:46:21", "text": "しかし"}, {"type": "subtitle", "time": 13584.07, "timestamp": "03:46:24", "text": "それでも私たちはまだ、ほら、私はまだ"}, {"type": "subtitle", "time": 13586.469, "timestamp": "03:46:26", "text": "まあ、一部はそうでしょうね。私はしません"}, {"type": "subtitle", "time": 13590.229, "timestamp": "03:46:30", "text": "分かるよね、ほら、"}, {"type": "subtitle", "time": 13594.67, "timestamp": "03:46:34", "text": "ええ、私は全員を助けたいと思っています"}, {"type": "subtitle", "time": 13598.469, "timestamp": "03:46:38", "text": "彼ら。まあ、いいんじゃない？うん、私は"}, {"type": "subtitle", "time": 13600.389, "timestamp": "03:46:40", "text": "うん。うん。つまり、それを取らないで"}, {"type": "subtitle", "time": 13603.429, "timestamp": "03:46:43", "text": "異なる方法で。でも、私は使わない"}, {"type": "subtitle", "time": 13605.83, "timestamp": "03:46:45", "text": "サスカチュワン州私の心はサスカチュワン州のように。私の脳"}, {"type": "subtitle", "time": 13608.03, "timestamp": "03:46:48", "text": "多くの細胞が死滅した。おお、"}, {"type": "subtitle", "time": 13612.309, "timestamp": "03:46:52", "text": "いいえ。もっともっと。心配しないで。"}, {"type": "subtitle", "time": 13615.75, "timestamp": "03:46:55", "text": "私の問題は、なぜ私が"}, {"type": "subtitle", "time": 13618.469, "timestamp": "03:46:58", "text": "困っている人を見ると"}]
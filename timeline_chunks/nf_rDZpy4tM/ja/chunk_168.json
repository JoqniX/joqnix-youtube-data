[{"type": "subtitle", "time": 10081.429, "timestamp": "02:48:01", "text": "ルール。おお、あれを見て。ちくしょう。"}, {"type": "subtitle", "time": 10083.83, "timestamp": "02:48:03", "text": "何がおかしいの？つまり、それは"}, {"type": "subtitle", "time": 10086.389, "timestamp": "02:48:06", "text": "まるで信頼を裏切られたような気分だ。あなたの妻"}, {"type": "subtitle", "time": 10088.389, "timestamp": "02:48:08", "text": "あなたを裏切る。親友が裏切る"}, {"type": "subtitle", "time": 10090.23, "timestamp": "02:48:10", "text": "別の"}, {"type": "subtitle", "time": 10097.03, "timestamp": "02:48:17", "text": "おっと。なんだって？うーん、たぶん"}, {"type": "subtitle", "time": 10103.309, "timestamp": "02:48:23", "text": "くそ。あなたはまるで"}, {"type": "subtitle", "time": 10106.71, "timestamp": "02:48:26", "text": "TonyHawk.com ジェットクラックプロ。ああ、トニー"}, {"type": "subtitle", "time": 10109.19, "timestamp": "02:48:29", "text": "ホークのスケートボード。ああ、すごい。彼と彼ら"}, {"type": "subtitle", "time": 10116.75, "timestamp": "02:48:36", "text": "[音楽]"}, {"type": "subtitle", "time": 10119.349, "timestamp": "02:48:39", "text": "ニース。ええと、ジャンは"}, {"type": "subtitle", "time": 10121.269, "timestamp": "02:48:41", "text": "右。それは役に立つだろう。"}, {"type": "subtitle", "time": 10123.75, "timestamp": "02:48:43", "text": "それに、楽しいよ。飛行しながら"}, {"type": "subtitle", "time": 10126.71, "timestamp": "02:48:46", "text": "戦闘。それはとてもクールな機能です"}, {"type": "subtitle", "time": 10128.63, "timestamp": "02:48:48", "text": "ここにあります。私たちは多くの時間を費やし、"}, {"type": "subtitle", "time": 10130.55, "timestamp": "02:48:50", "text": "それに努力を注ぎ込む。戻って"}, {"type": "subtitle", "time": 10131.75, "timestamp": "02:48:51", "text": "機械を見て新しいものがないか確認する"}, {"type": "subtitle", "time": 10134.71, "timestamp": "02:48:54", "text": "報奨金。"}, {"type": "subtitle", "time": 10136.63, "timestamp": "02:48:56", "text": "さあ行こう。"}, {"type": "subtitle", "time": 10138.07, "timestamp": "02:48:58", "text": "家に帰るとすぐに、私が確認したところ"}, {"type": "subtitle", "time": 10139.59, "timestamp": "02:48:59", "text": "彼は小屋にいたが、そこで姿を消した。私は"}]
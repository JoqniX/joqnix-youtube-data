[{"type": "subtitle", "time": 4321.35, "timestamp": "01:12:01", "text": "わかった。さあ、これを終わらせよう"}, {"type": "subtitle", "time": 4324.47, "timestamp": "01:12:04", "text": "お願いします。"}, {"type": "subtitle", "time": 4327.91, "timestamp": "01:12:07", "text": "ああ、くそ。見てみて。ああ、私は死んだ。"}, {"type": "subtitle", "time": 4333.63, "timestamp": "01:12:13", "text": "私はそうは思わない"}, {"type": "subtitle", "time": 4339.03, "timestamp": "01:12:19", "text": "私はあなたのものを持っていません。もうめちゃくちゃにするのはやめてください。"}, {"type": "subtitle", "time": 4340.87, "timestamp": "01:12:20", "text": "まあ、どうやら難しいみたいですね"}, {"type": "subtitle", "time": 4343.59, "timestamp": "01:12:23", "text": "見た目よりもずっと。どうぞ、お進みください。"}, {"type": "subtitle", "time": 4350.47, "timestamp": "01:12:30", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 4361.35, "timestamp": "01:12:41", "text": "本当に、あのジャンプをしっかり決めろ。"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "ちくしょう。それは少し、私たちが"}, {"type": "subtitle", "time": 4364.63, "timestamp": "01:12:44", "text": "やったぞ。それは少し大変だった"}, {"type": "subtitle", "time": 4366.63, "timestamp": "01:12:46", "text": "だが、クソ野郎どもめ。つまり、あなたはそれを突破したのですね"}, {"type": "subtitle", "time": 4369.51, "timestamp": "01:12:49", "text": "最初の訓練演習。大したことじゃない。"}, {"type": "subtitle", "time": 4371.83, "timestamp": "01:12:51", "text": "あれは簡単だった。私たちは嘘をついてそう言った"}, {"type": "subtitle", "time": 4374.07, "timestamp": "01:12:54", "text": "君を怖がらせるのは難しかった。ああ、楽しい"}, {"type": "subtitle", "time": 4376.47, "timestamp": "01:12:56", "text": "あなたを怖がらせて、あなたの最初の"}, {"type": "subtitle", "time": 4378.149, "timestamp": "01:12:58", "text": "動画はまるで地面で止まるような感じだった"}, {"type": "subtitle", "time": 4379.669, "timestamp": "01:12:59", "text": "あなたのことを考えています。"}]
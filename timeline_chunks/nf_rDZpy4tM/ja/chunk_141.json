[{"type": "subtitle", "time": 8461.59, "timestamp": "02:21:01", "text": "宝箱。私は、"}, {"type": "subtitle", "time": 8462.75, "timestamp": "02:21:02", "text": "少し"}, {"type": "subtitle", "time": 8466.23, "timestamp": "02:21:06", "text": "どこかに宝箱があるはずだ。ついに。私は何をしたの？"}, {"type": "subtitle", "time": 8475.27, "timestamp": "02:21:15", "text": "うわぁ。釣りの迷惑な存在として、"}, {"type": "subtitle", "time": 8476.87, "timestamp": "02:21:16", "text": "筋肉を痛めないようにね、賞金稼ぎさん。"}, {"type": "subtitle", "time": 8489.23, "timestamp": "02:21:29", "text": "それは正しい。君には男が必要だ、"}, {"type": "subtitle", "time": 8493.429, "timestamp": "02:21:33", "text": "今。今も彼の顔は現れない"}, {"type": "subtitle", "time": 8496.389, "timestamp": "02:21:36", "text": "戻る。"}]
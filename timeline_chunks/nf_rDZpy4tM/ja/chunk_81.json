[{"type": "subtitle", "time": 4861.75, "timestamp": "01:21:01", "text": "数えています。ええ、そうですね。だから何"}, {"type": "subtitle", "time": 4864.87, "timestamp": "01:21:04", "text": "私がやったの？ええと、私はゼロから始めました。"}, {"type": "subtitle", "time": 4868.31, "timestamp": "01:21:08", "text": "ストリーミングを始めた頃は、私は普通の人間でした"}, {"type": "subtitle", "time": 4870.189, "timestamp": "01:21:10", "text": "ストリーマーですよね？その時は"}, {"type": "subtitle", "time": 4875.11, "timestamp": "01:21:15", "text": "難しかったけど、いくつかあった"}, {"type": "subtitle", "time": 4878.07, "timestamp": "01:21:18", "text": "人々は入ってきて私を見るんですよね？しかし"}, {"type": "subtitle", "time": 4881.669, "timestamp": "01:21:21", "text": "YouTubeを始めた頃は、"}, {"type": "subtitle", "time": 4884.229, "timestamp": "01:21:24", "text": "もう少し人が来て、"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "私を見ているとか、そういうこと。"}, {"type": "subtitle", "time": 4889.55, "timestamp": "01:21:29", "text": "そして彼らは常連になり、徐々に"}, {"type": "subtitle", "time": 4892.07, "timestamp": "01:21:32", "text": "ゆっくりとたくさんの人が入ってきた"}, {"type": "subtitle", "time": 4893.83, "timestamp": "01:21:33", "text": "それほどまでに過酷で、それほどまでに夢のような"}, {"type": "subtitle", "time": 4895.75, "timestamp": "01:21:35", "text": "そうやってアディティは皆がやって来た"}, {"type": "subtitle", "time": 4897.99, "timestamp": "01:21:37", "text": "交換する権利、君たちは私のところへ来てください"}, {"type": "subtitle", "time": 4900.47, "timestamp": "01:21:40", "text": "私の配信のほとんどはそんな感じだけど"}, {"type": "subtitle", "time": 4903.03, "timestamp": "01:21:43", "text": "また、毎日来なくても、"}, {"type": "subtitle", "time": 4904.55, "timestamp": "01:21:44", "text": "あなたがまだその一部であるもの"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "コミュニティは正しい、なぜならあなたは私を見て、"}, {"type": "subtitle", "time": 4909.11, "timestamp": "01:21:49", "text": "あなたは私を見に来て応援してくれた"}, {"type": "subtitle", "time": 4911.709, "timestamp": "01:21:51", "text": "私にとってある時点で"}, {"type": "subtitle", "time": 4916.629, "timestamp": "01:21:56", "text": "私の旅の時間もまさにそうでした"}, {"type": "subtitle", "time": 4919.99, "timestamp": "01:21:59", "text": "まさにその通り。新しいBTuberが"}]
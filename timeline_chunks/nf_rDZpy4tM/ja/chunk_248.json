[{"type": "subtitle", "time": 14881.15, "timestamp": "04:08:01", "text": "リリースされました。何？遅刻していないといいのですが。私は"}, {"type": "subtitle", "time": 14884.55, "timestamp": "04:08:04", "text": "なぜ？うん。皆さん、お元気ですか？"}, {"type": "subtitle", "time": 14888.71, "timestamp": "04:08:08", "text": "すごく興奮してる。ああ、ドロップ。ああ。来て。"}, {"type": "subtitle", "time": 14891.469, "timestamp": "04:08:11", "text": "さあ、さあ。私は"}, {"type": "subtitle", "time": 14895.07, "timestamp": "04:08:15", "text": "ツイート？私は疑わしい"}, {"type": "subtitle", "time": 14896.91, "timestamp": "04:08:16", "text": "ツイートした。"}, {"type": "subtitle", "time": 14898.83, "timestamp": "04:08:18", "text": "おお"}, {"type": "subtitle", "time": 14902.229, "timestamp": "04:08:22", "text": "いやー、めちゃくちゃ興奮してるよ。では、"}, {"type": "subtitle", "time": 14904.15, "timestamp": "04:08:24", "text": "さあ、みんなでゲームをプレイしよう。私たちは"}, {"type": "subtitle", "time": 14905.67, "timestamp": "04:08:25", "text": "ゲームをプレイする。私たちは行くつもりです 私たちは"}, {"type": "subtitle", "time": 14914.15, "timestamp": "04:08:34", "text": "パーティー。私たちは行くつもりです 私たちは行くつもりです"}, {"type": "subtitle", "time": 14917.83, "timestamp": "04:08:37", "text": "私たちは楽しむつもりです。わかった。"}, {"type": "subtitle", "time": 14921.55, "timestamp": "04:08:41", "text": "私は興奮しています。私は興奮しています。私は"}, {"type": "subtitle", "time": 14924.71, "timestamp": "04:08:44", "text": "興奮した。待って。えっと、ツイートさせてください。"}]
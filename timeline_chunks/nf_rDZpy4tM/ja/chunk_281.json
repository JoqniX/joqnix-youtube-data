[{"type": "subtitle", "time": 16863.43, "timestamp": "04:41:03", "text": "これは一種の戦闘だ。これ大好き。"}, {"type": "subtitle", "time": 16866.66, "timestamp": "04:41:06", "text": "ちょっと待って、挨拶したいんだけど。以上。"}, {"type": "subtitle", "time": 16866.86, "timestamp": "04:41:06", "text": "[音楽]"}, {"type": "subtitle", "time": 16869.43, "timestamp": "04:41:09", "text": "[拍手]"}, {"type": "subtitle", "time": 16870.948, "timestamp": "04:41:10", "text": "VIP配信の皆さん、こんにちは。ようこそ"}, {"type": "subtitle", "time": 16884.788, "timestamp": "04:41:24", "text": "右？そして、ここにもあの奇妙なディスコがある。"}, {"type": "subtitle", "time": 16888.31, "timestamp": "04:41:28", "text": "ゾンビ退出。"}, {"type": "subtitle", "time": 16890.788, "timestamp": "04:41:30", "text": "気をつけて。"}]
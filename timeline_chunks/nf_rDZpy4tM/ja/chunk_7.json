[{"type": "subtitle", "time": 423.189, "timestamp": "00:07:03", "text": "私はよく忘れてしまう。両方ともリセットする必要があります"}, {"type": "subtitle", "time": 425.23, "timestamp": "00:07:05", "text": "私の声"}, {"type": "subtitle", "time": 431.11, "timestamp": "00:07:11", "text": "ああ、音声をリセットする必要がある"}, {"type": "subtitle", "time": 436.589, "timestamp": "00:07:16", "text": "わかった。おお、"}, {"type": "subtitle", "time": 446.67, "timestamp": "00:07:26", "text": "それ。あらら。ああ、神様。私"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "忘れた。おそらくこれをルーティングする必要がある"}, {"type": "subtitle", "time": 451.99, "timestamp": "00:07:31", "text": "背景音楽は必要ない"}, {"type": "subtitle", "time": 464.51, "timestamp": "00:07:44", "text": "時間"}, {"type": "subtitle", "time": 467.189, "timestamp": "00:07:47", "text": "ほら、私は聞かないよ"}, {"type": "subtitle", "time": 470.67, "timestamp": "00:07:50", "text": "でも、皆さんはそれを聞くことになるでしょう"}, {"type": "subtitle", "time": 475.71, "timestamp": "00:07:55", "text": "はい、はい、こんにちは、お元気ですか"}, {"type": "subtitle", "time": 477.629, "timestamp": "00:07:57", "text": "今日はミス"}]
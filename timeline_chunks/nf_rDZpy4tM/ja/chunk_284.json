[{"type": "subtitle", "time": 17041.99, "timestamp": "04:44:01", "text": "大丈夫ですか？怪我はしましたか？"}, {"type": "subtitle", "time": 17045.99, "timestamp": "04:44:05", "text": "首を横に振る。元気です。"}, {"type": "subtitle", "time": 17048.948, "timestamp": "04:44:08", "text": "よかった。私たちはあの忌々しいものを見ることができた"}, {"type": "subtitle", "time": 17051.47, "timestamp": "04:44:11", "text": "障壁があったが、指一本触れることもできなかった"}, {"type": "subtitle", "time": 17054.55, "timestamp": "04:44:14", "text": "それ。私も大丈夫です。"}, {"type": "subtitle", "time": 17057.11, "timestamp": "04:44:17", "text": "こんなに恐ろしい沈黙は見たことがない"}, {"type": "subtitle", "time": 17059.51, "timestamp": "04:44:19", "text": "以前にも不和があった。暗黙の破棄。ローバーは"}, {"type": "subtitle", "time": 17062.07, "timestamp": "04:44:22", "text": "それを完全に打ち負かすことができる。彼らは勝った"}, {"type": "subtitle", "time": 17068.39, "timestamp": "04:44:28", "text": "私は特に何もしていません。すべて"}, {"type": "subtitle", "time": 17071.35, "timestamp": "04:44:31", "text": "ありがとう、ローバー。彼女はなぜそんなに"}, {"type": "subtitle", "time": 17075.628, "timestamp": "04:44:35", "text": "かわいい？この場所はそれほど有名ではない"}, {"type": "subtitle", "time": 17090.67, "timestamp": "04:44:50", "text": "ああ、これは"}, {"type": "subtitle", "time": 17095.15, "timestamp": "04:44:55", "text": "エコー。うわあ、エリート層の反響だ"}, {"type": "subtitle", "time": 17098.948, "timestamp": "04:44:58", "text": "クラス。今日は誰かが幸運だったようだ。エリート"}]
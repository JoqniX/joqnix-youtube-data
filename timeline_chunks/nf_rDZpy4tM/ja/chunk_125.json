[{"type": "subtitle", "time": 7500.47, "timestamp": "02:05:00", "text": "会社があなたに提供する資産"}, {"type": "subtitle", "time": 7503.589, "timestamp": "02:05:03", "text": "えーと、あのユーチューバーは"}, {"type": "subtitle", "time": 7506.31, "timestamp": "02:05:06", "text": "それを使って、人々がどのように"}, {"type": "subtitle", "time": 7508.55, "timestamp": "02:05:08", "text": "それぞれ独自のものを持っている、例えばあなたが"}, {"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "企業のユーチューバーは独自の"}, {"type": "subtitle", "time": 7512.79, "timestamp": "02:05:12", "text": "アンダーグラウンドのようなインディーズ系YouTuber"}, {"type": "subtitle", "time": 7517.35, "timestamp": "02:05:17", "text": "隠された秘密の人格のように"}, {"type": "subtitle", "time": 7519.39, "timestamp": "02:05:19", "text": "あなた以外誰も知らない"}, {"type": "subtitle", "time": 7522.229, "timestamp": "02:05:22", "text": "そういう風に知っていれば、手に入れることができるけれど"}, {"type": "subtitle", "time": 7524.79, "timestamp": "02:05:24", "text": "決して使用してはいけないことを思い出してください"}, {"type": "subtitle", "time": 7528.79, "timestamp": "02:05:28", "text": "会社の資産か何か、大丈夫だから"}, {"type": "subtitle", "time": 7531.43, "timestamp": "02:05:31", "text": "会社があなたが"}, {"type": "subtitle", "time": 7534.87, "timestamp": "02:05:34", "text": "トラブルで、それに反対です"}, {"type": "subtitle", "time": 7540.709, "timestamp": "02:05:40", "text": "えっと、それは会社の規則に違反していて"}, {"type": "subtitle", "time": 7543.99, "timestamp": "02:05:43", "text": "うん、みたいな感じ。だから、あなたに思い出してもらいたい"}, {"type": "subtitle", "time": 7545.99, "timestamp": "02:05:45", "text": "そうした事態を目撃したかもしれないが、博士は"}, {"type": "subtitle", "time": 7548.79, "timestamp": "02:05:48", "text": "ジュピー、君はまだ生きているのか。"}, {"type": "subtitle", "time": 7552.47, "timestamp": "02:05:52", "text": "ああ、私の親友たち。これで終わりだ。ダグラス"}, {"type": "subtitle", "time": 7554.629, "timestamp": "02:05:54", "text": "このドアのすぐ向こうです。手伝っていただけますか？"}, {"type": "subtitle", "time": 7557.51, "timestamp": "02:05:57", "text": "最後にもう一度だけ出かけさせてくれないか？うん、そうしよう"}]
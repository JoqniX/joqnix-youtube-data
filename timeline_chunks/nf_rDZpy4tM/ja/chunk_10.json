[{"type": "subtitle", "time": 603.47, "timestamp": "00:10:03", "text": "右。私の古い銃はAR48です。おお、"}, {"type": "subtitle", "time": 609.949, "timestamp": "00:10:09", "text": "[音楽]"}, {"type": "subtitle", "time": 612.79, "timestamp": "00:10:12", "text": "はぁ？気をつけろよ、坊や。私"}, {"type": "subtitle", "time": 614.87, "timestamp": "00:10:14", "text": "君にこんな素敵なものを全部あげたわけじゃないよ。ああ、彼は"}, {"type": "subtitle", "time": 616.71, "timestamp": "00:10:16", "text": "何かドラマでも見てるのかな。できた"}, {"type": "subtitle", "time": 618.71, "timestamp": "00:10:18", "text": "あなたのマイクロロケットについて教えてください。"}, {"type": "subtitle", "time": 621.829, "timestamp": "00:10:21", "text": "これは何ですか？少々お待ちください。"}, {"type": "subtitle", "time": 624.23, "timestamp": "00:10:24", "text": "ああ、彼は集中治療室にいる。そこはスペースがある"}, {"type": "subtitle", "time": 627.55, "timestamp": "00:10:27", "text": "廊下を進んだ先の203号室です。ありがとう。それは"}, {"type": "subtitle", "time": 631.269, "timestamp": "00:10:31", "text": "彼は何を見ているのか？"}, {"type": "subtitle", "time": 633.31, "timestamp": "00:10:33", "text": "これは古い映画ですか、それとも"}, {"type": "subtitle", "time": 635.55, "timestamp": "00:10:35", "text": "何か？あなたは何者ですか"}, {"type": "subtitle", "time": 638.99, "timestamp": "00:10:38", "text": "見ている？待って、君は何者？"}, {"type": "subtitle", "time": 641.91, "timestamp": "00:10:41", "text": "見ている？君の妹を見たい。"}, {"type": "subtitle", "time": 643.59, "timestamp": "00:10:43", "text": "私はブリムを探検しに行くつもりです"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "君は賞金稼ぎをしているんだね。ねえ、"}, {"type": "subtitle", "time": 648.63, "timestamp": "00:10:48", "text": "外では気をつけてね。人間は貴重な存在です"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "商品。商品。君を捕まえるよ。私"}, {"type": "subtitle", "time": 654.15, "timestamp": "00:10:54", "text": "自分で自分の面倒を見られるわ、ジーン。"}, {"type": "subtitle", "time": 657.9, "timestamp": "00:10:57", "text": "この座り込み。"}, {"type": "subtitle", "time": 659.91, "timestamp": "00:10:59", "text": "[音楽]"}]
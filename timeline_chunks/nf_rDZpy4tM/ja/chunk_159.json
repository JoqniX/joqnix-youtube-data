[{"type": "subtitle", "time": 9551.51, "timestamp": "02:39:11", "text": "ああ、神様。ディーゼル。はい、"}, {"type": "subtitle", "time": 9554.469, "timestamp": "02:39:14", "text": "男。ケニーの顔に何が起こったのか"}, {"type": "subtitle", "time": 9556.63, "timestamp": "02:39:16", "text": "あんなに長い時間？ああ、あなたは私を追い出したいのね"}, {"type": "subtitle", "time": 9559.349, "timestamp": "02:39:19", "text": "もう一度言いますか？"}, {"type": "subtitle", "time": 9563.429, "timestamp": "02:39:23", "text": "彼の顔に一体何があったんだ？"}, {"type": "subtitle", "time": 9566.55, "timestamp": "02:39:26", "text": "ケニーの顔を元に戻してほしい。"}, {"type": "subtitle", "time": 9568.79, "timestamp": "02:39:28", "text": "おい、こっちだ。おしゃべりな未亡人"}, {"type": "subtitle", "time": 9571.51, "timestamp": "02:39:31", "text": "銃。現状はこうだ。私の名前はスタンで"}, {"type": "subtitle", "time": 9573.83, "timestamp": "02:39:33", "text": "私はエイリアンの精液を小瓶に入れて売っています。知っている"}, {"type": "subtitle", "time": 9575.19, "timestamp": "02:39:35", "text": "それはおそらくあなたが望んでいたことではない"}, {"type": "subtitle", "time": 9577.03, "timestamp": "02:39:37", "text": "あなたがこちらへ歩いてきた時に聞こえました。あなた"}, {"type": "subtitle", "time": 9582.55, "timestamp": "02:39:42", "text": "私たち、いい感じに見えますか？私は怒っていません。私はただ"}, {"type": "subtitle", "time": 9584.55, "timestamp": "02:39:44", "text": "好奇心旺盛。私たちは本当にあなたの"}, {"type": "subtitle", "time": 9587.99, "timestamp": "02:39:47", "text": "典型的な顧客は？もちろん。見てください、私は"}, {"type": "subtitle", "time": 9590.389, "timestamp": "02:39:50", "text": "全く見当もつかない。私はショックを受けています"}, {"type": "subtitle", "time": 9593.03, "timestamp": "02:39:53", "text": "誰かが文字通り買うたびにコア"}, {"type": "subtitle", "time": 9595.349, "timestamp": "02:39:55", "text": "私から大量のエイリアンがやってくる。しかし"}, {"type": "subtitle", "time": 9597.59, "timestamp": "02:39:57", "text": "彼らはいつもそうしている。ない"}, {"type": "subtitle", "time": 9599.349, "timestamp": "02:39:59", "text": "それには筋道や理屈がない。私は"}]
[{"type": "subtitle", "time": 9203.83, "timestamp": "02:33:23", "text": "またね。うん。うん。これは良いことだ。ああ、"}, {"type": "subtitle", "time": 9205.71, "timestamp": "02:33:25", "text": "神。私はそういう 私はそういう"}, {"type": "subtitle", "time": 9207.55, "timestamp": "02:33:27", "text": "天才。"}, {"type": "subtitle", "time": 9222.51, "timestamp": "02:33:42", "text": "おい、"}, {"type": "subtitle", "time": 9226.389, "timestamp": "02:33:46", "text": "子供。素晴らしい仕事ぶりです。でも、"}, {"type": "subtitle", "time": 9228.55, "timestamp": "02:33:48", "text": "ぜひ見ておくべきものです。見てみてください"}, {"type": "subtitle", "time": 9231.99, "timestamp": "02:33:51", "text": "懸賞金を受け取った後。"}, {"type": "subtitle", "time": 9234.79, "timestamp": "02:33:54", "text": "よし。良い。こっちへ来い。"}, {"type": "subtitle", "time": 9237.03, "timestamp": "02:33:57", "text": "どうしたの？なぜこれを見ているのですか？"}, {"type": "subtitle", "time": 9239.91, "timestamp": "02:33:59", "text": "シーン？こんにちは、ブリムシティの市民の皆さん。それは"}]
[{"type": "subtitle", "time": 12900.53, "timestamp": "03:35:00", "text": "難しい。トムはサボっている。"}, {"type": "subtitle", "time": 12903.469, "timestamp": "03:35:03", "text": "[音楽]"}, {"type": "subtitle", "time": 12906.87, "timestamp": "03:35:06", "text": "うーん、ある意味ではね。うーん、わからない。うん、"}, {"type": "subtitle", "time": 12909.229, "timestamp": "03:35:09", "text": "ある意味、それは辛いと思いませんか？"}, {"type": "subtitle", "time": 12914.07, "timestamp": "03:35:14", "text": "ずっと"}, {"type": "subtitle", "time": 12917.07, "timestamp": "03:35:17", "text": "有望で有望で、決して"}, {"type": "subtitle", "time": 12918.99, "timestamp": "03:35:18", "text": "一度もない"}, {"type": "subtitle", "time": 12927.269, "timestamp": "03:35:27", "text": "絶対に、なんて言うんだっけ？うん。"}, {"type": "subtitle", "time": 12929.63, "timestamp": "03:35:29", "text": "約束して約束する私は決して"}, {"type": "subtitle", "time": 12933.91, "timestamp": "03:35:33", "text": "やってみて。私は自分が"}, {"type": "subtitle", "time": 12936.19, "timestamp": "03:35:36", "text": "同じことをしている。私は思う"}, {"type": "subtitle", "time": 12938.269, "timestamp": "03:35:38", "text": "午前、"}, {"type": "subtitle", "time": 12941.51, "timestamp": "03:35:41", "text": "でも、そうならないように最善を尽くします。私"}, {"type": "subtitle", "time": 12950.429, "timestamp": "03:35:50", "text": "知る。"}]
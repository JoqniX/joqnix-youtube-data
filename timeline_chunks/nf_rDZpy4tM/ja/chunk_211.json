[{"type": "subtitle", "time": 12661.75, "timestamp": "03:31:01", "text": "すべて。そしてお金を稼ぐ"}, {"type": "subtitle", "time": 12663.99, "timestamp": "03:31:03", "text": "ストリーミング配信なんて、夢のようだ。いいえ、決して"}, {"type": "subtitle", "time": 12667.59, "timestamp": "03:31:07", "text": "これで十分だろう。"}, {"type": "subtitle", "time": 12670.15, "timestamp": "03:31:10", "text": "私のような大物ユーチューバーを見ても"}, {"type": "subtitle", "time": 12672.469, "timestamp": "03:31:12", "text": "そして誰もがたくさんのお金を稼いでいます"}, {"type": "subtitle", "time": 12674.63, "timestamp": "03:31:14", "text": "サブやその他すべて、それらは"}, {"type": "subtitle", "time": 12676.95, "timestamp": "03:31:16", "text": "税金やその他諸々を支払うのに十分な額"}, {"type": "subtitle", "time": 12679.79, "timestamp": "03:31:19", "text": "あるいは、そんな風に生きることさえ"}, {"type": "subtitle", "time": 12682.11, "timestamp": "03:31:22", "text": "きちんと。ええ、そうではありません"}, {"type": "subtitle", "time": 12685.429, "timestamp": "03:31:25", "text": "十分。それは運任せのことだ"}, {"type": "subtitle", "time": 12688.11, "timestamp": "03:31:28", "text": "競争相手が残っていて、"}, {"type": "subtitle", "time": 12690.71, "timestamp": "03:31:30", "text": "右。最善を尽くして努力しなければならない"}, {"type": "subtitle", "time": 12692.1, "timestamp": "03:31:32", "text": "最も困難なこと。"}, {"type": "subtitle", "time": 12697.11, "timestamp": "03:31:37", "text": "[音楽]"}, {"type": "subtitle", "time": 12698.87, "timestamp": "03:31:38", "text": "企業のようなものが"}, {"type": "subtitle", "time": 12701.269, "timestamp": "03:31:41", "text": "普通の仕事のように仕事がなく、"}, {"type": "subtitle", "time": 12703.269, "timestamp": "03:31:43", "text": "状態。うん。うん。企業"}, {"type": "subtitle", "time": 12705.11, "timestamp": "03:31:45", "text": "協力的とは、あなたが"}, {"type": "subtitle", "time": 12707.03, "timestamp": "03:31:47", "text": "仕事として働くこと。あなたは会社の下で"}, {"type": "subtitle", "time": 12709.19, "timestamp": "03:31:49", "text": "あなたは仕事などをしています"}, {"type": "subtitle", "time": 12711.95, "timestamp": "03:31:51", "text": "ごく普通の人間。どうやって"}, {"type": "subtitle", "time": 12715.19, "timestamp": "03:31:55", "text": "彼らは会社に入って仕事をし、"}, {"type": "subtitle", "time": 12717.99, "timestamp": "03:31:57", "text": "面接を受けて、"}, {"type": "subtitle", "time": 12719.59, "timestamp": "03:31:59", "text": "会社。彼らは最善を尽くさなければならない。"}]
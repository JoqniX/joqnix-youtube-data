[{"type": "subtitle", "time": 12000.349, "timestamp": "03:20:00", "text": "この旅を通して私は"}, {"type": "subtitle", "time": 12002.51, "timestamp": "03:20:02", "text": "私の"}, {"type": "subtitle", "time": 12005.429, "timestamp": "03:20:05", "text": "最高だね、うん、それが問題なんだ。それは"}, {"type": "subtitle", "time": 12008.75, "timestamp": "03:20:08", "text": "もの。何てことだ。理由がわからない、"}, {"type": "subtitle", "time": 12011.469, "timestamp": "03:20:11", "text": "でも来て"}, {"type": "subtitle", "time": 12014.15, "timestamp": "03:20:14", "text": "もし彼らがそう言ったら、私はこう言うだろう。"}, {"type": "subtitle", "time": 12017.19, "timestamp": "03:20:17", "text": "「どんな薬をやってるんだ？よくもそんなことを"}, {"type": "subtitle", "time": 12024.75, "timestamp": "03:20:24", "text": "人間？そしてあなたは"}, {"type": "subtitle", "time": 12030.11, "timestamp": "03:20:30", "text": "わかったよ。そう、こういうケースでは"}, {"type": "subtitle", "time": 12032.71, "timestamp": "03:20:32", "text": "何かが起こるには、何が必要かを知る必要があります"}, {"type": "subtitle", "time": 12036.469, "timestamp": "03:20:36", "text": "やるべきことは、あなた自身が知っていることだ"}, {"type": "subtitle", "time": 12038.67, "timestamp": "03:20:38", "text": "あなたがすべきことは、"}, {"type": "subtitle", "time": 12041.269, "timestamp": "03:20:41", "text": "右？うん。だからあなたは自分のことを続けて"}, {"type": "subtitle", "time": 12043.15, "timestamp": "03:20:43", "text": "最高。"}, {"type": "subtitle", "time": 12045.87, "timestamp": "03:20:45", "text": "待って、私はこう言えたはずだ"}, {"type": "subtitle", "time": 12048.87, "timestamp": "03:20:48", "text": "正しく理解しているよね？そういう時もあるだろう"}, {"type": "subtitle", "time": 12051.349, "timestamp": "03:20:51", "text": "あなたの科学とモデルと"}, {"type": "subtitle", "time": 12052.51, "timestamp": "03:20:52", "text": "物は"}, {"type": "subtitle", "time": 12055.91, "timestamp": "03:20:55", "text": "似ているけれど、最善を尽くし続ける"}, {"type": "subtitle", "time": 12057.309, "timestamp": "03:20:57", "text": "外"}]
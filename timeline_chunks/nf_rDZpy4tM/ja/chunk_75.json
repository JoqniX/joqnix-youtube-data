[{"type": "subtitle", "time": 4501.63, "timestamp": "01:15:01", "text": "フレット、"}, {"type": "subtitle", "time": 4504.149, "timestamp": "01:15:04", "text": "でも、よくわからない。私はしません"}, {"type": "subtitle", "time": 4507.03, "timestamp": "01:15:07", "text": "知る。わからない。"}, {"type": "subtitle", "time": 4516.87, "timestamp": "01:15:16", "text": "彼にやめさせろ。わかった。ねえ、それは"}, {"type": "subtitle", "time": 4520.63, "timestamp": "01:15:20", "text": "ひどい。何てことだ。みんな、ちょっと話させてくれ。"}, {"type": "subtitle", "time": 4521.95, "timestamp": "01:15:21", "text": "だから"}, {"type": "subtitle", "time": 4525.189, "timestamp": "01:15:25", "text": "例えば、サスカメが"}, {"type": "subtitle", "time": 4527.59, "timestamp": "01:15:27", "text": "Gen One、Zuchi、"}, {"type": "subtitle", "time": 4530.709, "timestamp": "01:15:30", "text": "セレスティアもそこにいたし、彼らは本当に一生懸命働いた"}, {"type": "subtitle", "time": 4533.189, "timestamp": "01:15:33", "text": "彼らのコンテンツや物、そして"}, {"type": "subtitle", "time": 4535.189, "timestamp": "01:15:35", "text": "観客と全員が集まったんですよね？"}, {"type": "subtitle", "time": 4539.07, "timestamp": "01:15:39", "text": "ゆっくり、ゆっくり、ゆっくり、ですよね？"}, {"type": "subtitle", "time": 4542.39, "timestamp": "01:15:42", "text": "それから、アティマスとフル"}, {"type": "subtitle", "time": 4545.91, "timestamp": "01:15:45", "text": "ジェネレーションゼロの他の3人"}, {"type": "subtitle", "time": 4548.35, "timestamp": "01:15:48", "text": "あるいは禅の人が来た"}, {"type": "subtitle", "time": 4551.99, "timestamp": "01:15:51", "text": "中に入って、ゆっくりと彼らは自分たちの種類を"}, {"type": "subtitle", "time": 4553.83, "timestamp": "01:15:53", "text": "そして彼らはゆっくりと確立していった"}, {"type": "subtitle", "time": 4556.87, "timestamp": "01:15:56", "text": "コミュニティの権利、そしてこれが"}]
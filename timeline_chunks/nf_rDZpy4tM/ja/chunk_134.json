[{"type": "subtitle", "time": 8043.109, "timestamp": "02:14:03", "text": "一緒に。ああ、彼は何も知らないんだ。うん、"}, {"type": "subtitle", "time": 8052.149, "timestamp": "02:14:12", "text": "これが私たちが求めていた甘いものなのです。はい、わかりました"}, {"type": "subtitle", "time": 8068.95, "timestamp": "02:14:28", "text": "連射？何てことだ。このバカどもめ。"}, {"type": "subtitle", "time": 8071.03, "timestamp": "02:14:31", "text": "ねえ、僕の本当のハットトリックを知りたい？"}, {"type": "subtitle", "time": 8073.03, "timestamp": "02:14:33", "text": "私のクリスタルは袋の中にくっついて、"}, {"type": "subtitle", "time": 8075.03, "timestamp": "02:14:35", "text": "強く叩くと爆発する。戦い"}, {"type": "subtitle", "time": 8086.229, "timestamp": "02:14:46", "text": "ああ、あいつのケツを刺してやれ。敵が私を待っています"}, {"type": "subtitle", "time": 8090.149, "timestamp": "02:14:50", "text": "彼らを殴った後。でも、使ってみて。"}, {"type": "subtitle", "time": 8096.87, "timestamp": "02:14:56", "text": "彼らはもうすでにそれを済ませた。私はただ"}]
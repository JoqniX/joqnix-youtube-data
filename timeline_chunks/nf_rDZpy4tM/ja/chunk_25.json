[{"type": "subtitle", "time": 1515.51, "timestamp": "00:25:15", "text": "ジップライン。えっと、じゃあ次に進みますね。"}, {"type": "subtitle", "time": 1518.19, "timestamp": "00:25:18", "text": "どうでも。離れる"}, {"type": "subtitle", "time": 1520.47, "timestamp": "00:25:20", "text": "それ。大きな古い支柱付き"}, {"type": "subtitle", "time": 1521.75, "timestamp": "00:25:21", "text": "家の底から聞こえてくる"}, {"type": "subtitle", "time": 1523.43, "timestamp": "00:25:23", "text": "丘の斜面の方へ行くんだよ。"}, {"type": "subtitle", "time": 1525.59, "timestamp": "00:25:25", "text": "ちょっと待って。歩くことができます"}, {"type": "subtitle", "time": 1527.35, "timestamp": "00:25:27", "text": "どこへでも、あなたの好きな場所で。これはクソッタレのMacだ"}, {"type": "subtitle", "time": 1529.549, "timestamp": "00:25:29", "text": "兄弟の建設現場。"}, {"type": "subtitle", "time": 1532.549, "timestamp": "00:25:32", "text": "ここ。ウォウォウォ。冷静になる。私たちは大丈夫。"}, {"type": "subtitle", "time": 1534.23, "timestamp": "00:25:34", "text": "わかった。では、あなたはこれをどう処理したいですか？"}, {"type": "subtitle", "time": 1536.63, "timestamp": "00:25:36", "text": "このようなタフな男は、他の者だけを尊重する。"}, {"type": "subtitle", "time": 1538.71, "timestamp": "00:25:38", "text": "タフガイたち。だから、私を恥ずかしい目に遭わせないで。あなた"}, {"type": "subtitle", "time": 1540.07, "timestamp": "00:25:40", "text": "マックに歩いて行けると思う"}, {"type": "subtitle", "time": 1541.669, "timestamp": "00:25:41", "text": "そしてチーズブラザーの建設現場"}, {"type": "subtitle", "time": 1543.269, "timestamp": "00:25:43", "text": "まるで自分がイエス・キリストであるかのように"}, {"type": "subtitle", "time": 1545.35, "timestamp": "00:25:45", "text": "キリストを所有し、自分のもののように歩き回る"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "その場所？底なしの"}, {"type": "subtitle", "time": 1548.31, "timestamp": "00:25:48", "text": "こっちの穴だ、この野郎。あなたは"}, {"type": "subtitle", "time": 1549.669, "timestamp": "00:25:49", "text": "落下しても生き残れる"}, {"type": "subtitle", "time": 1550.95, "timestamp": "00:25:50", "text": "底なしの穴まで"}, {"type": "subtitle", "time": 1553.11, "timestamp": "00:25:53", "text": "底？私はそうは思わない。私たちは仕事を手に入れました"}, {"type": "subtitle", "time": 1555.11, "timestamp": "00:25:55", "text": "する。わかったよ、バカ。さあ、行こうぜ"}, {"type": "subtitle", "time": 1557.51, "timestamp": "00:25:57", "text": "出て行け、この野郎。ねえ、"}, {"type": "subtitle", "time": 1559.43, "timestamp": "00:25:59", "text": "くたばれ。このクソ野郎。中に入ると"}]
[{"type": "subtitle", "time": 4441.11, "timestamp": "01:14:01", "text": "私の名前はジュピー博士です。ダグラスは私の"}, {"type": "subtitle", "time": 4442.79, "timestamp": "01:14:02", "text": "家族全員で、こっそり忍び込もうとしている"}, {"type": "subtitle", "time": 4445.189, "timestamp": "01:14:05", "text": "そして彼らを救う。これらを最後まで読み通すことができない"}, {"type": "subtitle", "time": 4447.51, "timestamp": "01:14:07", "text": "隣の部屋に配管がある。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 4450.07, "timestamp": "01:14:10", "text": "パニック状態。おいおい、ちょっと待てよ。聞く、"}, {"type": "subtitle", "time": 4452.149, "timestamp": "01:14:12", "text": "ちっちゃな子。私たちは探しています"}, {"type": "subtitle", "time": 4454.39, "timestamp": "01:14:14", "text": "ダグラスもだ。ほら、もしかしたら私たちは"}, {"type": "subtitle", "time": 4456.63, "timestamp": "01:14:16", "text": "お互いに助け合う。神様、私はとても心配しています"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "吐きそうだ。本当に助けてくれるの？"}, {"type": "subtitle", "time": 4471.669, "timestamp": "01:14:31", "text": "このパイプを繋いでくれないと"}, {"type": "subtitle", "time": 4474.47, "timestamp": "01:14:34", "text": "私は乗り越えて家族を救うことができる。"}, {"type": "subtitle", "time": 4476.63, "timestamp": "01:14:36", "text": "おい。さあ、聞いてくれ、ちびっ子？私"}, {"type": "subtitle", "time": 4478.47, "timestamp": "01:14:38", "text": "パズルが大好きです。私は"}, {"type": "subtitle", "time": 4480.149, "timestamp": "01:14:40", "text": "彼ら。ちょっと、ああ、"}, {"type": "subtitle", "time": 4491.51, "timestamp": "01:14:51", "text": "あなたの言い分も聞かせてもらえますか？おお、"}, {"type": "subtitle", "time": 4495.75, "timestamp": "01:14:55", "text": "やったね。ドアを開けましたね。えっと、"}, {"type": "subtitle", "time": 4498.63, "timestamp": "01:14:58", "text": "「ああ、神様」だといいんだけど。"}, {"type": "subtitle", "time": 4499.95, "timestamp": "01:14:59", "text": "しないで"}]
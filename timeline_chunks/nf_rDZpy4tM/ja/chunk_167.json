[{"type": "subtitle", "time": 10020.87, "timestamp": "02:47:00", "text": "正直に言うと、何を期待していたのかは分かっています。"}, {"type": "subtitle", "time": 10023.75, "timestamp": "02:47:03", "text": "ここだ。"}, {"type": "subtitle", "time": 10025.59, "timestamp": "02:47:05", "text": "やあ、おやすみ、相棒。私はただ行くだけです"}, {"type": "subtitle", "time": 10027.19, "timestamp": "02:47:07", "text": "ここに座って、君が倒れるのを見守る"}, {"type": "subtitle", "time": 10029.269, "timestamp": "02:47:09", "text": "眠っている。あなたに出会えて本当に嬉しいです。あなた"}, {"type": "subtitle", "time": 10031.11, "timestamp": "02:47:11", "text": "わかってる、私は、私たちは"}, {"type": "subtitle", "time": 10032.95, "timestamp": "02:47:12", "text": "ここには何か素晴らしいものがある。どれだけクールだろう"}, {"type": "subtitle", "time": 10035.429, "timestamp": "02:47:15", "text": "もし私たちが実際にG3を阻止したらどうなるだろうか？"}, {"type": "subtitle", "time": 10038.23, "timestamp": "02:47:18", "text": "ごめん。ごめん。私はただ興奮しているだけです。"}, {"type": "subtitle", "time": 10040.309, "timestamp": "02:47:20", "text": "もう黙ります。寝よう"}, {"type": "subtitle", "time": 10041.59, "timestamp": "02:47:21", "text": "もうすぐだ。ほら、私たちは"}, {"type": "subtitle", "time": 10043.51, "timestamp": "02:47:23", "text": "宇宙空間をジェットパックで駆け巡る。ごめん。"}, {"type": "subtitle", "time": 10045.03, "timestamp": "02:47:25", "text": "私は声が大きすぎます。あなたは恐らく"}, {"type": "subtitle", "time": 10047.44, "timestamp": "02:47:27", "text": "あなたを眠らせようとしています。"}, {"type": "subtitle", "time": 10050.23, "timestamp": "02:47:30", "text": "[音楽]"}, {"type": "subtitle", "time": 10057.23, "timestamp": "02:47:37", "text": "日。ああ、彼らは時間が好きです"}, {"type": "subtitle", "time": 10065.87, "timestamp": "02:47:45", "text": "待って。何が"}, {"type": "subtitle", "time": 10069.309, "timestamp": "02:47:49", "text": "これ？私たちは夢の中にいるのか、それとも"}, {"type": "subtitle", "time": 10071.51, "timestamp": "02:47:51", "text": "何か？よし、相棒。さあ"}, {"type": "subtitle", "time": 10073.59, "timestamp": "02:47:53", "text": "このジェットパックを試乗してみてください。できますか？"}, {"type": "subtitle", "time": 10076.15, "timestamp": "02:47:56", "text": "そのギャップを越えられるか？"}, {"type": "subtitle", "time": 10077.87, "timestamp": "02:47:57", "text": "なんてこった。これ"}]
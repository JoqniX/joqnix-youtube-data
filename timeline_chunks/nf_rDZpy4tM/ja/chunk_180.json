[{"type": "subtitle", "time": 10803.429, "timestamp": "03:00:03", "text": "による。それは本当に本当に大きな意味があります。"}, {"type": "subtitle", "time": 10807.19, "timestamp": "03:00:07", "text": "ご意見をいただき、ありがとうございます。"}, {"type": "subtitle", "time": 10811.51, "timestamp": "03:00:11", "text": "また、いいねをあげてください。"}, {"type": "subtitle", "time": 10814.55, "timestamp": "03:00:14", "text": "私にはできない詳細を"}, {"type": "subtitle", "time": 10818.389, "timestamp": "03:00:18", "text": "声に出して言うと、"}, {"type": "subtitle", "time": 10822.83, "timestamp": "03:00:22", "text": "アダンが質問してくれた"}, {"type": "subtitle", "time": 10826.23, "timestamp": "03:00:26", "text": "君は声に出して言わないといけないんだ、わからない"}, {"type": "subtitle", "time": 10829.59, "timestamp": "03:00:29", "text": "えっと、もっといいのが必要なんだけど、うん、これはその一つだよ"}, {"type": "subtitle", "time": 10832.79, "timestamp": "03:00:32", "text": "私が気づいた欠点については、"}, {"type": "subtitle", "time": 10834.95, "timestamp": "03:00:34", "text": "うん。うん。声に出して"}, {"type": "subtitle", "time": 10837.389, "timestamp": "03:00:37", "text": "誰かに何かを説明する"}, {"type": "subtitle", "time": 10840.19, "timestamp": "03:00:40", "text": "それ以外。"}, {"type": "subtitle", "time": 10842.51, "timestamp": "03:00:42", "text": "うん。やらなきゃ"}, {"type": "subtitle", "time": 10848.31, "timestamp": "03:00:48", "text": "言った。"}, {"type": "subtitle", "time": 10853.389, "timestamp": "03:00:53", "text": "共感できる。しかし"}, {"type": "subtitle", "time": 10856.99, "timestamp": "03:00:56", "text": "うん、ベストを尽くそう"}]
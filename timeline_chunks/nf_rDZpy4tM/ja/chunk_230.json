[{"type": "subtitle", "time": 13802.67, "timestamp": "03:50:02", "text": "知っている人は、"}, {"type": "subtitle", "time": 13806.309, "timestamp": "03:50:06", "text": "知る。中にはこれを破壊しようとする者もいる"}, {"type": "subtitle", "time": 13811.75, "timestamp": "03:50:11", "text": "コミュニティ。午後3時以降と書いてあります。私は必要としている"}, {"type": "subtitle", "time": 13813.59, "timestamp": "03:50:13", "text": "新しいものをスケジュールする。私は作る必要がある"}, {"type": "subtitle", "time": 13816.469, "timestamp": "03:50:16", "text": "新しい方。それが明日の主な"}, {"type": "subtitle", "time": 13818.309, "timestamp": "03:50:18", "text": "スケジュール。明日の公式発表です"}, {"type": "subtitle", "time": 13821.75, "timestamp": "03:50:21", "text": "ストリーム。実際は午後3時です。 1つ。私はそうしない"}, {"type": "subtitle", "time": 13825.269, "timestamp": "03:50:25", "text": "配信中。うん。香港"}, {"type": "subtitle", "time": 13827.189, "timestamp": "03:50:27", "text": "今日のカイの配信は良さそうだ。"}, {"type": "subtitle", "time": 13830.07, "timestamp": "03:50:30", "text": "設定する必要がある。はい。はい。しないで"}, {"type": "subtitle", "time": 13832.469, "timestamp": "03:50:32", "text": "心配。配信後に公開されます。"}, {"type": "subtitle", "time": 13835.229, "timestamp": "03:50:35", "text": "うん。うん。では、戻ってきました。あった"}, {"type": "subtitle", "time": 13838.389, "timestamp": "03:50:38", "text": "幸せを破壊しようとした者もいた"}, {"type": "subtitle", "time": 13846.469, "timestamp": "03:50:46", "text": "今。後になって"}, {"type": "subtitle", "time": 13848.03, "timestamp": "03:50:48", "text": "理解する"}, {"type": "subtitle", "time": 13855.59, "timestamp": "03:50:55", "text": "違いは何？"}, {"type": "subtitle", "time": 13858.95, "timestamp": "03:50:58", "text": "3つの2つの用語の区別"}]
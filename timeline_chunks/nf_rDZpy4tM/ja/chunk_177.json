[{"type": "subtitle", "time": 10621.429, "timestamp": "02:57:01", "text": "楽しんでいただければ幸いです。さあ、本当にそうしてくれたらいいな。"}, {"type": "subtitle", "time": 10623.07, "timestamp": "02:57:03", "text": "楽しむ"}, {"type": "subtitle", "time": 10627.11, "timestamp": "02:57:07", "text": "今日。だから、やって来た人たちは、ああ、"}, {"type": "subtitle", "time": 10633.429, "timestamp": "02:57:13", "text": "音楽がまた私をそうさせている。ああ、"}, {"type": "subtitle", "time": 10636.23, "timestamp": "02:57:16", "text": "ああ、またやられちゃったよ。欲しい"}, {"type": "subtitle", "time": 10638.79, "timestamp": "02:57:18", "text": "私が聞くたびに"}, {"type": "subtitle", "time": 10642.83, "timestamp": "02:57:22", "text": "アイゼンが作ったこのBGM"}, {"type": "subtitle", "time": 10645.75, "timestamp": "02:57:25", "text": "心から話したくなる"}, {"type": "subtitle", "time": 10647.71, "timestamp": "02:57:27", "text": "あるいは、そんな感じ。私はしません"}, {"type": "subtitle", "time": 10656.03, "timestamp": "02:57:36", "text": "これ。私はこれにとても弱い"}, {"type": "subtitle", "time": 10658.87, "timestamp": "02:57:38", "text": "歌。この楽曲。私は"}, {"type": "subtitle", "time": 10667.23, "timestamp": "02:57:47", "text": "[音楽]"}, {"type": "subtitle", "time": 10669.75, "timestamp": "02:57:49", "text": "また、"}, {"type": "subtitle", "time": 10672.99, "timestamp": "02:57:52", "text": "今日ここで気づいたこと"}, {"type": "subtitle", "time": 10676.23, "timestamp": "02:57:56", "text": "朝。話すべきかどうかわからない"}]
[{"type": "subtitle", "time": 10503.269, "timestamp": "02:55:03", "text": "人間が食べられる。でも、彼は本当に"}, {"type": "subtitle", "time": 10505.59, "timestamp": "02:55:05", "text": "甘い。私のことは心配しないでください。あなたはできる"}, {"type": "subtitle", "time": 10509.03, "timestamp": "02:55:09", "text": "宇宙マフィアを殺すことに集中するか、"}, {"type": "subtitle", "time": 10510.87, "timestamp": "02:55:10", "text": "何でも。"}, {"type": "subtitle", "time": 10512.87, "timestamp": "02:55:12", "text": "こんにちは。私たちはどうでしょうか？何かありますか？"}, {"type": "subtitle", "time": 10515.55, "timestamp": "02:55:15", "text": "ダイアログ？"}, {"type": "subtitle", "time": 10519.07, "timestamp": "02:55:19", "text": "この映画は観ない。見てください"}, {"type": "subtitle", "time": 10527.56, "timestamp": "02:55:27", "text": "N. これは何の映画ですか？私は"}, {"type": "subtitle", "time": 10536.64, "timestamp": "02:55:36", "text": "好奇心旺盛。なぜ私を見ているのですか？"}, {"type": "subtitle", "time": 10544.11, "timestamp": "02:55:44", "text": "[音楽]"}, {"type": "subtitle", "time": 10546.62, "timestamp": "02:55:46", "text": "バソース。"}, {"type": "subtitle", "time": 10555.349, "timestamp": "02:55:55", "text": "では、ここで締めくくりたいと思います。"}, {"type": "subtitle", "time": 10558.07, "timestamp": "02:55:58", "text": "ああ、私たちは立ち上がる。私は"}]
[{"type": "subtitle", "time": 12781.309, "timestamp": "03:33:01", "text": "本日はお越しいただきありがとうございます。本当に感謝しています。"}, {"type": "subtitle", "time": 12784.03, "timestamp": "03:33:04", "text": "そしてレミーがやって来た"}, {"type": "subtitle", "time": 12788.71, "timestamp": "03:33:08", "text": "本日はお越しいただきありがとうございます。本当に感謝しています。"}, {"type": "subtitle", "time": 12790.85, "timestamp": "03:33:10", "text": "そして、ここに誰がいるか見てください。の"}, {"type": "subtitle", "time": 12792.75, "timestamp": "03:33:12", "text": "[音楽]"}, {"type": "subtitle", "time": 12797.51, "timestamp": "03:33:17", "text": "立ち寄ってくれたお礼にパンを。本当に感謝しています。"}, {"type": "subtitle", "time": 12799.75, "timestamp": "03:33:19", "text": "良い一日をお過ごしになられたことを願っています。はぁ？ええ、私たちは"}, {"type": "subtitle", "time": 12801.91, "timestamp": "03:33:21", "text": "いろいろなことを話していたんだ、ほら、今まで"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "昨日からずっと"}, {"type": "subtitle", "time": 12807.79, "timestamp": "03:33:27", "text": "これを使っている"}, {"type": "subtitle", "time": 12809.87, "timestamp": "03:33:29", "text": "あなたが聴いている音楽"}, {"type": "subtitle", "time": 12815.15, "timestamp": "03:33:35", "text": "聴覚。ああ、ああ、衝撃が来た"}, {"type": "subtitle", "time": 12817.91, "timestamp": "03:33:37", "text": "深い。私はそうあるべきではない"}, {"type": "subtitle", "time": 12819.349, "timestamp": "03:33:39", "text": "今、このことを考えている。私はこれをします"}, {"type": "subtitle", "time": 12820.95, "timestamp": "03:33:40", "text": "インタフェース。だから、私は何もすべきではない"}, {"type": "subtitle", "time": 12823.79, "timestamp": "03:33:43", "text": "今、注目してください。"}, {"type": "subtitle", "time": 12828.309, "timestamp": "03:33:48", "text": "だから、私が言ったように、観察してください"}, {"type": "subtitle", "time": 12830.389, "timestamp": "03:33:50", "text": "アイゼンがこれを作ったとは知らなかった。"}, {"type": "subtitle", "time": 12833.349, "timestamp": "03:33:53", "text": "ああ、これはアイゼンハンが作ったんだ。それはとても"}, {"type": "subtitle", "time": 12836.75, "timestamp": "03:33:56", "text": "美しい曲で、聴くのを止められない"}]
[{"type": "subtitle", "time": 842.71, "timestamp": "00:14:02", "text": "脳みそはめちゃくちゃになって、彼らから引き上げられた。の"}, {"type": "subtitle", "time": 844.11, "timestamp": "00:14:04", "text": "のみ"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "彼の脳が考えられる唯一の思考"}, {"type": "subtitle", "time": 851.03, "timestamp": "00:14:11", "text": "この時点でまだ生成されているのは"}, {"type": "subtitle", "time": 855.35, "timestamp": "00:14:15", "text": "漠然と人種差別的、または"}, {"type": "subtitle", "time": 875.75, "timestamp": "00:14:35", "text": "[音楽]"}, {"type": "subtitle", "time": 877.07, "timestamp": "00:14:37", "text": "おお、"}, {"type": "subtitle", "time": 888.75, "timestamp": "00:14:48", "text": "ベイビー。ああ、大変だ。彼らは撃っている"}, {"type": "subtitle", "time": 892.31, "timestamp": "00:14:52", "text": "自分。それは何ですか？"}, {"type": "subtitle", "time": 894.59, "timestamp": "00:14:54", "text": "彼を見て"}, {"type": "subtitle", "time": 897.99, "timestamp": "00:14:57", "text": "フライング。うわぁ。うわぁ。ちょっと待ってください。"}]
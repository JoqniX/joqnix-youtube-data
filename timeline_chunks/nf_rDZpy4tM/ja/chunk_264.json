[{"type": "subtitle", "time": 15842.229, "timestamp": "04:24:02", "text": "酸性のフィールド？また、これは私の初見プレイです"}, {"type": "subtitle", "time": 15844.07, "timestamp": "04:24:04", "text": "を通して。ちなみに、私は一度も見たことがありませんでした"}, {"type": "subtitle", "time": 15844.99, "timestamp": "04:24:04", "text": "どれでも"}, {"type": "subtitle", "time": 15847.75, "timestamp": "04:24:07", "text": "動画。そうそう、言い忘れてたんだけど"}, {"type": "subtitle", "time": 15850.54, "timestamp": "04:24:10", "text": "それ。まもなくここは危険になります。"}, {"type": "subtitle", "time": 15857.349, "timestamp": "04:24:17", "text": "私はそれを知っていた。私たちのひょうたんは使用できません"}, {"type": "subtitle", "time": 15859.51, "timestamp": "04:24:19", "text": "エーテル海の G影響によるものです。"}, {"type": "subtitle", "time": 15861.59, "timestamp": "04:24:21", "text": "メッセージの送受信ができません"}, {"type": "subtitle", "time": 15863.83, "timestamp": "04:24:23", "text": "今すぐ助けてください。急いだ方がいいよ。何が"}, {"type": "subtitle", "time": 15866.87, "timestamp": "04:24:26", "text": "神？集結地点の発見。それは何ですか"}, {"type": "subtitle", "time": 15869.189, "timestamp": "04:24:29", "text": "システム？本当に思い出せないのでしょうね"}, {"type": "subtitle", "time": 15872.229, "timestamp": "04:24:32", "text": "もの。でも、心配しないでください。神様、もしあなたが"}, {"type": "subtitle", "time": 15874.79, "timestamp": "04:24:34", "text": "何か質問があれば、移動しながら話しましょう。"}, {"type": "subtitle", "time": 15876.95, "timestamp": "04:24:36", "text": "私とインが、すべてを詳しくお伝えします。"}, {"type": "subtitle", "time": 15878.95, "timestamp": "04:24:38", "text": "最初からあらゆる細部に至るまで。"}, {"type": "subtitle", "time": 15882.309, "timestamp": "04:24:42", "text": "こんにちは。わかった。ローバー。あの、お電話してもいいですか？"}, {"type": "subtitle", "time": 15884.71, "timestamp": "04:24:44", "text": "今は、思い出す前に"}, {"type": "subtitle", "time": 15889.469, "timestamp": "04:24:49", "text": "本名？ああ、自分の名前は知っている。"}, {"type": "subtitle", "time": 15891.91, "timestamp": "04:24:51", "text": "待って、そうだと思う。あ、待って。彼らは"}, {"type": "subtitle", "time": 15894.229, "timestamp": "04:24:54", "text": "私のことはロアと呼ぶことにします。私たちはここに留まるべきではない"}, {"type": "subtitle", "time": 15897.91, "timestamp": "04:24:57", "text": "ここ。でも、私の名前はチャックンです。私は"}]
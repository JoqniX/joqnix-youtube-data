[{"type": "subtitle", "time": 17101.43, "timestamp": "04:45:01", "text": "クラス。申し訳ありません。少し"}, {"type": "subtitle", "time": 17105.51, "timestamp": "04:45:05", "text": "夢中になった。残響や反響は"}, {"type": "subtitle", "time": 17108.788, "timestamp": "04:45:08", "text": "聞き覚えがありますか？残響。エコー。おお、"}, {"type": "subtitle", "time": 17110.788, "timestamp": "04:45:10", "text": "音楽関係のことです。"}, {"type": "subtitle", "time": 17112.55, "timestamp": "04:45:12", "text": "私たちの世界のすべては"}, {"type": "subtitle", "time": 17114.948, "timestamp": "04:45:14", "text": "頻度。すべての音は"}, {"type": "subtitle", "time": 17118.788, "timestamp": "04:45:18", "text": "残響。ああ、あのこだまは"}, {"type": "subtitle", "time": 17120.948, "timestamp": "04:45:20", "text": "酸っぱいものの余韻が残る"}, {"type": "subtitle", "time": 17123.868, "timestamp": "04:45:23", "text": "不和。ちょっと電源を入れさせてください"}, {"type": "subtitle", "time": 17128.66, "timestamp": "04:45:28", "text": "当社のパングー端末に設置されたファンバンク。"}, {"type": "subtitle", "time": 17131.83, "timestamp": "04:45:31", "text": "[音楽]"}, {"type": "subtitle", "time": 17133.99, "timestamp": "04:45:33", "text": "まるで土砂降りの雨が降っているようだ"}, {"type": "subtitle", "time": 17136.47, "timestamp": "04:45:36", "text": "私の場所で起こっていること。わからない"}, {"type": "subtitle", "time": 17138.39, "timestamp": "04:45:38", "text": "聞こえるかどうかは別として。私の騒音抑制"}, {"type": "subtitle", "time": 17141.27, "timestamp": "04:45:41", "text": "聞かないのはもったいないくらい素晴らしいかもしれない。しかし"}, {"type": "subtitle", "time": 17144.23, "timestamp": "04:45:44", "text": "うん、文字が重くて重い"}, {"type": "subtitle", "time": 17146.47, "timestamp": "04:45:46", "text": "激しい大雨が降っています"}, {"type": "subtitle", "time": 17150.868, "timestamp": "04:45:50", "text": "今は洪水で街が浸水している。ああ、パニックによって"}, {"type": "subtitle", "time": 17152.788, "timestamp": "04:45:52", "text": "彼女が言うには、ひょうたん型のターミナルのこと"}, {"type": "subtitle", "time": 17155.51, "timestamp": "04:45:55", "text": "すべての共振器が開発したデバイス"}, {"type": "subtitle", "time": 17157.67, "timestamp": "04:45:57", "text": "広東省の研究者たち。でもほら、"}, {"type": "subtitle", "time": 17159.99, "timestamp": "04:45:59", "text": "いつもこういったものを見つけられるとは限らない。"}]
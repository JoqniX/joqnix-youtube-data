[{"type": "subtitle", "time": 8352.79, "timestamp": "02:19:12", "text": "[音楽]"}, {"type": "subtitle", "time": 8356.469, "timestamp": "02:19:16", "text": "ああ、臆病者は隠れたいのか？良い、"}, {"type": "subtitle", "time": 8360.23, "timestamp": "02:19:20", "text": "Empressは料金を請求しません"}, {"type": "subtitle", "time": 8363.75, "timestamp": "02:19:23", "text": "あのキャンディのお尻。やったぜ。彼は持っていなかった"}, {"type": "subtitle", "time": 8367.349, "timestamp": "02:19:27", "text": "何が彼を襲ったのか、想像もつかなかった。ああ、今度は"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "横切って、か。ねえ、何を見たいの？"}, {"type": "subtitle", "time": 8372.309, "timestamp": "02:19:32", "text": "他に今回はバブルができることはありますか？ああ、何"}, {"type": "subtitle", "time": 8375.83, "timestamp": "02:19:35", "text": "他に何ができるだろうか？ああ、私は"}, {"type": "subtitle", "time": 8378.95, "timestamp": "02:19:38", "text": "車両を停止させる。素晴らしい。完璧。"}, {"type": "subtitle", "time": 8381.27, "timestamp": "02:19:41", "text": "さあ急いで渡って、ああ、こうやって"}, {"type": "subtitle", "time": 8385.589, "timestamp": "02:19:45", "text": "あなたがやる。そして、私はいいですね。"}, {"type": "subtitle", "time": 8388.07, "timestamp": "02:19:48", "text": "見てください、私の時間バブルはそれしかできません"}, {"type": "subtitle", "time": 8389.83, "timestamp": "02:19:49", "text": "多くの。拾わなければならない"}, {"type": "subtitle", "time": 8392.87, "timestamp": "02:19:52", "text": "残りの余裕分。"}, {"type": "subtitle", "time": 8394.63, "timestamp": "02:19:54", "text": "急いで、クロスバック。タイムバブル"}, {"type": "subtitle", "time": 8396.79, "timestamp": "02:19:56", "text": "永遠には続かないんだよ。"}, {"type": "subtitle", "time": 8399.83, "timestamp": "02:19:59", "text": "信じられないでしょう？なんてスリリングなんだ。あなた"}]
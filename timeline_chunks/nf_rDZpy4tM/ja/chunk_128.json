[{"type": "subtitle", "time": 7680.8, "timestamp": "02:08:00", "text": "ああ、ピンパナじゃないよ"}, {"type": "subtitle", "time": 7681.87, "timestamp": "02:08:01", "text": "[音楽]"}, {"type": "subtitle", "time": 7685.709, "timestamp": "02:08:05", "text": "ずっと昔に遡る。うん。そうすれば入れる"}, {"type": "subtitle", "time": 7688.47, "timestamp": "02:08:08", "text": "トラブル。だから、そういう意味では"}, {"type": "subtitle", "time": 7691.03, "timestamp": "02:08:11", "text": "合併症とか、いろいろあったよ。しかし、"}, {"type": "subtitle", "time": 7693.03, "timestamp": "02:08:13", "text": "あなたは自分の"}, {"type": "subtitle", "time": 7695.43, "timestamp": "02:08:15", "text": "お前は警官だろ。だから常に確認する"}, {"type": "subtitle", "time": 7697.27, "timestamp": "02:08:17", "text": "ルールに従うこと。どれも同じように"}, {"type": "subtitle", "time": 7700.229, "timestamp": "02:08:20", "text": "Discordサーバーや参加するストリームなど"}, {"type": "subtitle", "time": 7702.069, "timestamp": "02:08:22", "text": "ルールをよく読んで、"}, {"type": "subtitle", "time": 7703.51, "timestamp": "02:08:23", "text": "川の規制と"}, {"type": "subtitle", "time": 7705.39, "timestamp": "02:08:25", "text": "ストリーマーと"}, {"type": "subtitle", "time": 7708.709, "timestamp": "02:08:28", "text": "そういう類のことです。まさにその通り。同じ"}, {"type": "subtitle", "time": 7711.189, "timestamp": "02:08:31", "text": "チューブで、まるであなたが著作権者であるかのように"}, {"type": "subtitle", "time": 7713.83, "timestamp": "02:08:33", "text": "ルールとかに従わなきゃいけない"}, {"type": "subtitle", "time": 7715.99, "timestamp": "02:08:35", "text": "それが何であれ、それに応じて"}, {"type": "subtitle", "time": 7717.27, "timestamp": "02:08:37", "text": "契約書に記載されており、"}, {"type": "subtitle", "time": 7719.91, "timestamp": "02:08:39", "text": "そういうことばかり。もしあなたがそうでないなら"}, {"type": "subtitle", "time": 7723.51, "timestamp": "02:08:43", "text": "満足できない場合は、"}, {"type": "subtitle", "time": 7726.27, "timestamp": "02:08:46", "text": "もう二度とやらない。うん。去って"}]
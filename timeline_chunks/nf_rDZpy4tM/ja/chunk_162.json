[{"type": "subtitle", "time": 9723.03, "timestamp": "02:42:03", "text": "回復時間。おお。あなたは本当に必死ですね"}, {"type": "subtitle", "time": 9725.11, "timestamp": "02:42:05", "text": "もっとエイリアンが来るってこと？見て、私は"}, {"type": "subtitle", "time": 9727.429, "timestamp": "02:42:07", "text": "言ったでしょ。え、じゃあ彼は全部やってるの？"}, {"type": "subtitle", "time": 9729.349, "timestamp": "02:42:09", "text": "彼自身と突然？君は私の最後の"}, {"type": "subtitle", "time": 9731.349, "timestamp": "02:42:11", "text": "異星人の雫がやってきて、私はただ"}, {"type": "subtitle", "time": 9734.23, "timestamp": "02:42:14", "text": "まだ他に何かありますか。それほど異質ではない"}, {"type": "subtitle", "time": 9737.429, "timestamp": "02:42:17", "text": "射精弁のシステムが機能する。わかった、"}, {"type": "subtitle", "time": 9739.349, "timestamp": "02:42:19", "text": "今、私はあなたを助けたいのですが、"}, {"type": "subtitle", "time": 9741.429, "timestamp": "02:42:21", "text": "できません。"}, {"type": "subtitle", "time": 9743.11, "timestamp": "02:42:23", "text": "わかった。"}, {"type": "subtitle", "time": 9752.23, "timestamp": "02:42:32", "text": "おい、キープさん、ジェットパックは戻ってきましたか？"}, {"type": "subtitle", "time": 9755.19, "timestamp": "02:42:35", "text": "そこには？ジェットパック？もちろんできます"}, {"type": "subtitle", "time": 9767.59, "timestamp": "02:42:47", "text": "ああ、ジェットパックか。素晴らしい選択です。本当に"}, {"type": "subtitle", "time": 9769.83, "timestamp": "02:42:49", "text": "素晴らしい選択です。それをロックしましょう"}, {"type": "subtitle", "time": 9772.55, "timestamp": "02:42:52", "text": "購入。いいですね。私たちには"}, {"type": "subtitle", "time": 9775.429, "timestamp": "02:42:55", "text": "ジェットパックに？そう急ぐな。戻らなければならない"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "あれを注文して。準備しておきます"}, {"type": "subtitle", "time": 9779.75, "timestamp": "02:42:59", "text": "数日中にあなたにお届けします。約束します。"}]
[{"type": "subtitle", "time": 9976.469, "timestamp": "02:46:16", "text": "殺意は"}, {"type": "subtitle", "time": 9980.91, "timestamp": "02:46:20", "text": "悪者たち。わかった。わかった。"}, {"type": "subtitle", "time": 9986.63, "timestamp": "02:46:26", "text": "まだこれ見てるの？ええ、でも"}, {"type": "subtitle", "time": 9989.19, "timestamp": "02:46:29", "text": "入荷待ちです。素晴らしい。完璧"}, {"type": "subtitle", "time": 9991.19, "timestamp": "02:46:31", "text": "休息のための言い訳。私たちはまだ待っています"}, {"type": "subtitle", "time": 9993.67, "timestamp": "02:46:33", "text": "Clugの情報によると。とにかく、"}, {"type": "subtitle", "time": 9995.59, "timestamp": "02:46:35", "text": "寝て、そのストレスを少し解消しよう"}, {"type": "subtitle", "time": 9997.59, "timestamp": "02:46:37", "text": "興奮？ジーンの言う通りだ。以上です"}, {"type": "subtitle", "time": 10006.51, "timestamp": "02:46:46", "text": "[音楽]"}, {"type": "subtitle", "time": 10011.469, "timestamp": "02:46:51", "text": "リスク。それで、ジェシーはどこにいるの？ジェシー"}, {"type": "subtitle", "time": 10014.95, "timestamp": "02:46:54", "text": "妹よ。"}, {"type": "subtitle", "time": 10017.11, "timestamp": "02:46:57", "text": "これがあなたの寝室なんですね？その"}, {"type": "subtitle", "time": 10018.71, "timestamp": "02:46:58", "text": "大丈夫。つまり、私はそうは思わない、私はそうは思わない"}]
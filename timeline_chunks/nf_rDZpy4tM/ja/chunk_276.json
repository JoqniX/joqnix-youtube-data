[{"type": "subtitle", "time": 16561.83, "timestamp": "04:36:01", "text": "都市であり、要塞でもある。それは非常に重要である"}, {"type": "subtitle", "time": 16564.47, "timestamp": "04:36:04", "text": "安全のために"}, {"type": "subtitle", "time": 16567.269, "timestamp": "04:36:07", "text": "はぁ？私たちはバイと会うことに同意しました"}, {"type": "subtitle", "time": 16570.429, "timestamp": "04:36:10", "text": "ここ。彼女はどこにいるの？"}, {"type": "subtitle", "time": 16572.409, "timestamp": "04:36:12", "text": "バイ。ああ、誰"}, {"type": "subtitle", "time": 16573.869, "timestamp": "04:36:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16576.269, "timestamp": "04:36:16", "text": "バイ？ビシって誰？"}, {"type": "subtitle", "time": 16579.349, "timestamp": "04:36:19", "text": "キャラクターの名前を知らないので、"}, {"type": "subtitle", "time": 16588.269, "timestamp": "04:36:28", "text": "ここは無神論的海の中心地である。"}, {"type": "subtitle", "time": 16592.99, "timestamp": "04:36:32", "text": "大西洋酸性油田。酸性場。何が"}, {"type": "subtitle", "time": 16595.75, "timestamp": "04:36:35", "text": "ハプニング？ああ、星とは何ですか。"}, {"type": "subtitle", "time": 16599.269, "timestamp": "04:36:39", "text": "それはスターだ。エコースター。ここにはなかった"}, {"type": "subtitle", "time": 16601.51, "timestamp": "04:36:41", "text": "私たちがここに着いたばかりの頃、私は"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "酸性のフィールドの気配を感じる"}, {"type": "subtitle", "time": 16605.67, "timestamp": "04:36:45", "text": "面前。"}, {"type": "subtitle", "time": 16608.47, "timestamp": "04:36:48", "text": "つまり、私たちが目を離した隙に現れたということだ。"}, {"type": "subtitle", "time": 16611.99, "timestamp": "04:36:51", "text": "まばたきしたら目が飛び出しそうだ。ああ、もしかしたら"}, {"type": "subtitle", "time": 16614.349, "timestamp": "04:36:54", "text": "エーテルの海は、私たちがどこにいるかを教えてくれる。"}, {"type": "subtitle", "time": 16617.67, "timestamp": "04:36:57", "text": "私たちに従う倫理の中心"}]
[{"type": "subtitle", "time": 13447.51, "timestamp": "03:44:07", "text": "質問もして、チャットしてくれてありがとう"}, {"type": "subtitle", "time": 13454.59, "timestamp": "03:44:14", "text": "ミンガサ、あなたが"}, {"type": "subtitle", "time": 13457.95, "timestamp": "03:44:17", "text": "英語は理解できますが、"}, {"type": "subtitle", "time": 13460.63, "timestamp": "03:44:20", "text": "えっと、もしよろしければ、翻訳ツールを使ってもいいですよ。"}, {"type": "subtitle", "time": 13462.55, "timestamp": "03:44:22", "text": "中国語で入力できるかどうかわかりません"}, {"type": "subtitle", "time": 13467.83, "timestamp": "03:44:27", "text": "あなたは中国出身ですが"}, {"type": "subtitle", "time": 13468.99, "timestamp": "03:44:28", "text": "する"}, {"type": "subtitle", "time": 13472.389, "timestamp": "03:44:32", "text": "自分の言語で書いてください。"}, {"type": "subtitle", "time": 13474.63, "timestamp": "03:44:34", "text": "だから私はそれを読んで翻訳して"}, {"type": "subtitle", "time": 13478.55, "timestamp": "03:44:38", "text": "今すぐあなたと連絡を取ります。こんにちは、でもありがとう"}, {"type": "subtitle", "time": 13480.71, "timestamp": "03:44:40", "text": "来てくれてありがとう。本当に本当に本当に"}, {"type": "subtitle", "time": 13486.87, "timestamp": "03:44:46", "text": "あなた。彼らはニック・フューリーのように彼を見つけた"}, {"type": "subtitle", "time": 13488.429, "timestamp": "03:44:48", "text": "記録する"}, {"type": "subtitle", "time": 13491.269, "timestamp": "03:44:51", "text": "アベンジャーズ。 Starscapeはどのようにして見つけましたか？"}, {"type": "subtitle", "time": 13493.75, "timestamp": "03:44:53", "text": "グループ？えっと、これはもう言ったと思うんだけど"}, {"type": "subtitle", "time": 13496.389, "timestamp": "03:44:56", "text": "2、3回くらいですよね？私は見つけた"}, {"type": "subtitle", "time": 13498.95, "timestamp": "03:44:58", "text": "星空"}, {"type": "subtitle", "time": 13499.87, "timestamp": "03:44:59", "text": "えーと"}]
[{"type": "subtitle", "time": 4982.55, "timestamp": "01:23:02", "text": "問題は、タイムゾーンという概念が存在するということだ。難しい"}, {"type": "subtitle", "time": 4984.91, "timestamp": "01:23:04", "text": "それを理解するため、そして"}, {"type": "subtitle", "time": 4987.99, "timestamp": "01:23:07", "text": "一部の人々が"}, {"type": "subtitle", "time": 4991.669, "timestamp": "01:23:11", "text": "できる人は必ず来る"}, {"type": "subtitle", "time": 4993.79, "timestamp": "01:23:13", "text": "しかし、覚えておいてください"}, {"type": "subtitle", "time": 4997.43, "timestamp": "01:23:17", "text": "あまり気にしないで"}, {"type": "subtitle", "time": 5000.07, "timestamp": "01:23:20", "text": "数字の話だけど、そう、例えば"}, {"type": "subtitle", "time": 5001.75, "timestamp": "01:23:21", "text": "彼らがデビューしたYouTuberとすべて"}, {"type": "subtitle", "time": 5003.59, "timestamp": "01:23:23", "text": "彼らは通常の配信を行っています"}, {"type": "subtitle", "time": 5007.27, "timestamp": "01:23:27", "text": "いつものように視聴者が訪れています"}, {"type": "subtitle", "time": 5010.07, "timestamp": "01:23:30", "text": "いつもの視聴者が来て見ています"}, {"type": "subtitle", "time": 5011.83, "timestamp": "01:23:31", "text": "彼らと彼らを支えるすべて"}, {"type": "subtitle", "time": 5014.229, "timestamp": "01:23:34", "text": "ゆっくりとゆっくりと彼らはコンテンツを作成します"}, {"type": "subtitle", "time": 5017.43, "timestamp": "01:23:37", "text": "他のプラットフォームでは、"}, {"type": "subtitle", "time": 5019.189, "timestamp": "01:23:39", "text": "彼らの作品はそこにあるので"}, {"type": "subtitle", "time": 5021.27, "timestamp": "01:23:41", "text": "誰もがその存在を知ることができる"}, {"type": "subtitle", "time": 5023.27, "timestamp": "01:23:43", "text": "そしてゆっくりと作る"}, {"type": "subtitle", "time": 5025.11, "timestamp": "01:23:45", "text": "あなたのコミュニティはゆっくりとゆっくりと"}, {"type": "subtitle", "time": 5027.83, "timestamp": "01:23:47", "text": "人々が来て、人々があなたをサポートする"}, {"type": "subtitle", "time": 5030.149, "timestamp": "01:23:50", "text": "あなたの旅は、"}, {"type": "subtitle", "time": 5033.11, "timestamp": "01:23:53", "text": "そういうユーチューバーだから、"}, {"type": "subtitle", "time": 5035.83, "timestamp": "01:23:55", "text": "あちらはと呼ばれ、"}, {
[{"type": "subtitle", "time": 9901.429, "timestamp": "02:45:01", "text": "いや、いや、いや。たとえ私がそれを取り除いたとしても、彼は"}, {"type": "subtitle", "time": 9904.2, "timestamp": "02:45:04", "text": "それでもなお、顔のない存在となる。見る"}, {"type": "subtitle", "time": 9926.55, "timestamp": "02:45:26", "text": "そよ風の。そよ風が心地いい。"}, {"type": "subtitle", "time": 9928.15, "timestamp": "02:45:28", "text": "パワースライドほど素晴らしいものはない"}, {"type": "subtitle", "time": 9936.55, "timestamp": "02:45:36", "text": "全く新しい才能。はい、その通りです。"}, {"type": "subtitle", "time": 9938.55, "timestamp": "02:45:38", "text": "それはあなたが"}, {"type": "subtitle", "time": 9940.389, "timestamp": "02:45:40", "text": "ずっと耳にしていた話だ。彼らは"}, {"type": "subtitle", "time": 9943.03, "timestamp": "02:45:43", "text": "G3を1体ずつ倒し、そして今"}, {"type": "subtitle", "time": 9945.349, "timestamp": "02:45:45", "text": "彼らは働く準備ができている。どうしたの？"}, {"type": "subtitle", "time": 9946.95, "timestamp": "02:45:46", "text": "意地悪な上司を殺せ。あなたはタフだ"}, {"type": "subtitle", "time": 9949.11, "timestamp": "02:45:49", "text": "山賊。"}, {"type": "subtitle", "time": 9950.83, "timestamp": "02:45:50", "text": "さあ、こちらへどうぞ"}, {"type": "subtitle", "time": 9953.59, "timestamp": "02:45:53", "text": "ジーンズ専門店。それは奇妙な家です"}, {"type": "subtitle", "time": 9955.51, "timestamp": "02:45:55", "text": "リムシティプラザの真ん中、すぐ近く"}, {"type": "subtitle", "time": 9957.83, "timestamp": "02:45:57", "text": "ボルドー。もし変な女の子があなたに怒鳴りつけてきたら、"}, {"type": "subtitle", "time": 9959.83, "timestamp": "02:45:59", "text": "彼女の横をそのまま通り過ぎればいい。彼女はそうではない"}]
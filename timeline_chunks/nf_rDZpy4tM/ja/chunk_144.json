[{"type": "subtitle", "time": 8644.389, "timestamp": "02:24:04", "text": "よし、これを終わらせよう。さあ行こう"}, {"type": "subtitle", "time": 8655.55, "timestamp": "02:24:15", "text": "ええ、私たちはここまで来たんです、"}, {"type": "subtitle", "time": 8658.63, "timestamp": "02:24:18", "text": "右？私たちは本当に最後までやり遂げたのだろうか"}, {"type": "subtitle", "time": 8671.99, "timestamp": "02:24:31", "text": "おい、卵舐め野郎。あなたを"}, {"type": "subtitle", "time": 8674.52, "timestamp": "02:24:34", "text": "霧卵。"}, {"type": "subtitle", "time": 8687.27, "timestamp": "02:24:47", "text": "[音楽]"}, {"type": "subtitle", "time": 8689.59, "timestamp": "02:24:49", "text": "よし、もう一度ダグラスだ。この広告は"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "拷問。ではない"}, {"type": "subtitle", "time": 8694.55, "timestamp": "02:24:54", "text": "私たちは最後までやり遂げる。いいえ、彼女はそうしません"}, {"type": "subtitle", "time": 8696.79, "timestamp": "02:24:56", "text": "私たちに何でもさせてください。それはまるで"}, {"type": "subtitle", "time": 8699.389, "timestamp": "02:24:59", "text": "リマインダー。ああ、"}]
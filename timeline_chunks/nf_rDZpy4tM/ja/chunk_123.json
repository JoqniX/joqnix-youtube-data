[{"type": "subtitle", "time": 7381.51, "timestamp": "02:03:01", "text": "そこにありますが、ええ、彼らは持っています"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "えーっと、えーっと、えーっと、えーっと、何ですか"}, {"type": "subtitle", "time": 7389.03, "timestamp": "02:03:09", "text": "MBRフットボールの人たちと同じように呼んでください"}, {"type": "subtitle", "time": 7392.07, "timestamp": "02:03:12", "text": "契約を結んでいる選手は何人いるか"}, {"type": "subtitle", "time": 7395.229, "timestamp": "02:03:15", "text": "彼らはそのクラブで何年もプレーできる、または"}, {"type": "subtitle", "time": 7398.629, "timestamp": "02:03:18", "text": "サッカークラブ、バルセロナとか"}, {"type": "subtitle", "time": 7401.589, "timestamp": "02:03:21", "text": "彼らにはコントラがいるようなものだ"}, {"type": "subtitle", "time": 7403.51, "timestamp": "02:03:23", "text": "有効期限などの制限"}, {"type": "subtitle", "time": 7405.51, "timestamp": "02:03:25", "text": "FIFAのゲームとかをプレイするのと同じようにね"}, {"type": "subtitle", "time": 7407.669, "timestamp": "02:03:27", "text": "契約があることが分かるでしょう"}, {"type": "subtitle", "time": 7410.07, "timestamp": "02:03:30", "text": "有効期限とか、"}, {"type": "subtitle", "time": 7413.75, "timestamp": "02:03:33", "text": "右？それと全く同じようなものです。だから"}, {"type": "subtitle", "time": 7415.75, "timestamp": "02:03:35", "text": "ほとんどの機関では、1年または"}, {"type": "subtitle", "time": 7419.669, "timestamp": "02:03:39", "text": "二。うん。だから作り続けることができる"}, {"type": "subtitle", "time": 7421.589, "timestamp": "02:03:41", "text": "コンテンツやその他すべては、"}, {"type": "subtitle", "time": 7424.87, "timestamp": "02:03:44", "text": "年に1～2時間程度、才能を発揮する。する"}, {"type": "subtitle", "time": 7427.27, "timestamp": "02:03:47", "text": "あなたはそれにおいて最善を尽くします。もしあなたがそうでないなら"}, {"type": "subtitle", "time": 7429.27, "timestamp": "02:03:49", "text": "快適だと感じたり、そうでないと"}, {"type": "subtitle", "time": 7432.149, "timestamp": "02:03:52", "text": "先に進みたい"}, {"type": "subtitle", "time": 7433.31, "timestamp": "02:03:53", "text": "スピード違反"}, {"type": "subtitle", "time": 7437.47, "timestamp": "02:03:57", "text": "旅では、実際に"}]
[{"type": "subtitle", "time": 7622.31, "timestamp": "02:07:02", "text": "ああ、私は自分のことを考えないようにしている"}, {"type": "subtitle", "time": 7624.47, "timestamp": "02:07:04", "text": "妻の体が1人で真っ二つに引き裂かれる"}, {"type": "subtitle", "time": 7626.95, "timestamp": "02:07:06", "text": "ダグラスの拷問器具の、そしてそれは"}, {"type": "subtitle", "time": 7628.95, "timestamp": "02:07:08", "text": "私の環境では動作しません。それも違う。うん、メモ"}, {"type": "subtitle", "time": 7632.27, "timestamp": "02:07:12", "text": "それ。つまり、フィアナは"}, {"type": "subtitle", "time": 7635.43, "timestamp": "02:07:15", "text": "ストリームで行われたもの"}, {"type": "subtitle", "time": 7638.31, "timestamp": "02:07:18", "text": "フィアナが"}, {"type": "subtitle", "time": 7641.75, "timestamp": "02:07:21", "text": "私が殺すつもりならそれについて言及する"}, {"type": "subtitle", "time": 7644.31, "timestamp": "02:07:24", "text": "私自身も参加して、あなたも参加するかもしれません"}, {"type": "subtitle", "time": 7647.03, "timestamp": "02:07:27", "text": "誰か知っているかどうかわからない"}, {"type": "subtitle", "time": 7647.87, "timestamp": "02:07:27", "text": "えーと"}, {"type": "subtitle", "time": 7650.55, "timestamp": "02:07:30", "text": "正しい音楽から来たサキサン。彼女"}, {"type": "subtitle", "time": 7653.069, "timestamp": "02:07:33", "text": "実際、いや、そうすべきじゃない。いや、そうすべきだ。"}, {"type": "subtitle", "time": 7655.35, "timestamp": "02:07:35", "text": "ない。うん。うん。うん。そんな感じのことです。"}, {"type": "subtitle", "time": 7657.03, "timestamp": "02:07:37", "text": "会社の資産を不正に使用してはいけません。"}, {"type": "subtitle", "time": 7661.43, "timestamp": "02:07:41", "text": "フィアナのように。はい。ナンジ・フィアナ"}, {"type": "subtitle", "time": 7664.149, "timestamp": "02:07:44", "text": "魚が行く。うん。うん。だからあなたは"}, {"type": "subtitle", "time": 7665.99, "timestamp": "02:07:45", "text": "会社の資産を次のように使用しないでください"}, {"type": "subtitle", "time": 7668.149, "timestamp": "02:07:48", "text": "もしあなたの会社があなたに"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "カラオケのアカペラみたいに、あるいは"}, {"type": "subtitle", "time": 7672.47, "timestamp": "02:07:52", "text": "カラオケ配信用のインストゥルメンタル音楽"}, {"type": "subtitle", "time": 7675.35, "timestamp": "02:07:55", "text": "などなど。また、覚えておいてほしいことがあります。"}]
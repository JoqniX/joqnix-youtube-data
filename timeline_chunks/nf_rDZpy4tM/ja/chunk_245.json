[{"type": "subtitle", "time": 14701.75, "timestamp": "04:05:01", "text": "ストリーム。うん、また配信するよ"}, {"type": "subtitle", "time": 14706.309, "timestamp": "04:05:06", "text": "ホンカイなら8時か9時頃。"}, {"type": "subtitle", "time": 14717.269, "timestamp": "04:05:17", "text": "次の試合も楽勝で決めよう。皆さんが"}, {"type": "subtitle", "time": 14719.87, "timestamp": "04:05:19", "text": "良い一日を。残りの時間を楽しんでください"}, {"type": "subtitle", "time": 14722.269, "timestamp": "04:05:22", "text": "夜。ファイナル"}, {"type": "subtitle", "time": 14758.08, "timestamp": "04:05:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 7929.83, "timestamp": "02:12:09", "text": "先ほども言いました。何もなかったと言ったのに"}, {"type": "subtitle", "time": 7932.39, "timestamp": "02:12:12", "text": "俺たちをからかってる。何もなかったことがわかる"}, {"type": "subtitle", "time": 7959.58, "timestamp": "02:12:39", "text": "彼。"}, {"type": "subtitle", "time": 7961.87, "timestamp": "02:12:41", "text": "[音楽]"}, {"type": "subtitle", "time": 7965.189, "timestamp": "02:12:45", "text": "やったぜ。まさにそれだ。"}, {"type": "subtitle", "time": 7967.99, "timestamp": "02:12:47", "text": "ああ、気持ちよかった。彼はとても"}, {"type": "subtitle", "time": 7970.149, "timestamp": "02:12:50", "text": "切り分けやすい良質な肉質。実際は"}, {"type": "subtitle", "time": 7973.35, "timestamp": "02:12:53", "text": "実際、とても良かった。ああ、私たちは何を手に入れたの？"}]
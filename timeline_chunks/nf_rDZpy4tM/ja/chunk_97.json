[{"type": "subtitle", "time": 5831.43, "timestamp": "01:37:11", "text": "それ。つまり、このリポジトリは科学的に"}, {"type": "subtitle", "time": 5834.39, "timestamp": "01:37:14", "text": "正確な。おお、素晴らしい。すばらしい。あなたはそうしました"}, {"type": "subtitle", "time": 5836.95, "timestamp": "01:37:16", "text": "またそれだ。ダグラスのオフィスはそれほど遠くない"}, {"type": "subtitle", "time": 5839.109, "timestamp": "01:37:19", "text": "ここから。私は先に進みます。見てみましょう"}, {"type": "subtitle", "time": 5841.669, "timestamp": "01:37:21", "text": "そこのあなた。やあ、頑張れよ、ちびっ子。"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "うん、私はあの人が本当に好きだよ。では"}, {"type": "subtitle", "time": 5846.31, "timestamp": "01:37:26", "text": "完璧な世界、ダグラスが"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "彼を射殺するだけではない。"}, {"type": "subtitle", "time": 5854.709, "timestamp": "01:37:34", "text": "これは緊急のお知らせです。これ"}, {"type": "subtitle", "time": 5856.47, "timestamp": "01:37:36", "text": "セクターは一時的に指定されています"}, {"type": "subtitle", "time": 5877.35, "timestamp": "01:37:57", "text": "かなり大きな"}, {"type": "subtitle", "time": 5879.43, "timestamp": "01:37:59", "text": "印象。"}]
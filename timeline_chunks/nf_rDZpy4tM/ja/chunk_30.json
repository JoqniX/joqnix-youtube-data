[{"type": "subtitle", "time": 1803.029, "timestamp": "00:30:03", "text": "ああ、それは別の問題だ。私たちは"}, {"type": "subtitle", "time": 1805.71, "timestamp": "00:30:05", "text": "別の銃を手に入れるか、"}, {"type": "subtitle", "time": 1810.07, "timestamp": "00:30:10", "text": "何か。その宝箱は手に入らない。屋根。"}, {"type": "subtitle", "time": 1812.23, "timestamp": "00:30:12", "text": "オールドタウンは、もう脱出路を過ぎたところだ。私"}, {"type": "subtitle", "time": 1814.63, "timestamp": "00:30:14", "text": "ここはかなり危険だと聞きました。それで、"}, {"type": "subtitle", "time": 1816.87, "timestamp": "00:30:16", "text": "ご存知のとおり、おそらくあなたは"}, {"type": "subtitle", "time": 1820.19, "timestamp": "00:30:20", "text": "撃たれる。まるで無法地帯のカウボーイの土地みたいだ。"}, {"type": "subtitle", "time": 1824.11, "timestamp": "00:30:24", "text": "こんにちは、オールドタウンへようこそ。古い"}, {"type": "subtitle", "time": 1828.23, "timestamp": "00:30:28", "text": "町。どんな御用でしょうか？"}, {"type": "subtitle", "time": 1830.789, "timestamp": "00:30:30", "text": "ここは一体何ですか？ fmiと言うかもしれないが、"}, {"type": "subtitle", "time": 1832.63, "timestamp": "00:30:32", "text": "参考までに、ここはどんな場所ですか？"}, {"type": "subtitle", "time": 1834.549, "timestamp": "00:30:34", "text": "それで、一体どういうことなの？ええと、私はただ"}, {"type": "subtitle", "time": 1837.51, "timestamp": "00:30:37", "text": "そこはオールドタウンって言うって言ったでしょ。昔は"}, {"type": "subtitle", "time": 1839.99, "timestamp": "00:30:39", "text": "入植者たちが最初にこの小惑星に着陸し、"}, {"type": "subtitle", "time": 1841.83, "timestamp": "00:30:41", "text": "私たちは小さな交易拠点を無料で作りました"}, {"type": "subtitle", "time": 1844.07, "timestamp": "00:30:44", "text": "銀河法から誰でも"}, {"type": "subtitle", "time": 1847.83, "timestamp": "00:30:47", "text": "来て、好きなようにする。最近では、"}, {"type": "subtitle", "time": 1850.149, "timestamp": "00:30:50", "text": "ドラッグタウンがすべての注目を独り占めした。しかし"}, {"type": "subtitle", "time": 1852.95, "timestamp": "00:30:52", "text": "数年間、オールドタウンは"}, {"type": "subtitle", "time": 1856.23, "timestamp": "00:30:56", "text": "決して軽視できるものではない。ああ、わかった。私"}, {"type": "subtitle", "time": 1858.63, "timestamp": "00:30:58", "text": "わかった。旧市街は旧市街であり、"}]
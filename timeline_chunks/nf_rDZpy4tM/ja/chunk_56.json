[{"type": "subtitle", "time": 3371.43, "timestamp": "00:56:11", "text": "フローティング。そしてこれはスクーターで、"}, {"type": "subtitle", "time": 3379.43, "timestamp": "00:56:19", "text": "私も他の人たちと同じようにG3が嫌いです。もちろん。"}, {"type": "subtitle", "time": 3381.829, "timestamp": "00:56:21", "text": "でも、G3がなかったら、誰が"}, {"type": "subtitle", "time": 3385.349, "timestamp": "00:56:25", "text": "地獄が私の測深棒を買ってくれるだろうか？"}, {"type": "subtitle", "time": 3386.349, "timestamp": "00:56:26", "text": "チャリング"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "ロッド？私のもう一つのセンサーは？音が出ない"}, {"type": "subtitle", "time": 3392.47, "timestamp": "00:56:32", "text": "ロッド？ああ、もちろんです。私が立ち去る間に"}, {"type": "subtitle", "time": 3395.37, "timestamp": "00:56:35", "text": "音について話す。"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "ああ、もちろんです。私が話している間は立ち去ってください"}, {"type": "subtitle", "time": 3412.309, "timestamp": "00:56:52", "text": "うん、ハグ。そうそう。私は考えていた"}, {"type": "subtitle", "time": 3415.43, "timestamp": "00:56:55", "text": "えっと、いいねを作ろうかなって考えてた"}, {"type": "subtitle", "time": 3417.91, "timestamp": "00:56:57", "text": "ナイトボードコマンドで抱きしめることができます"}]
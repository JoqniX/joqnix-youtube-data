[{"type": "subtitle", "time": 4200.87, "timestamp": "01:10:00", "text": "エナ。私はエナのことをよく知っている、なぜなら彼女を見ているからだ"}, {"type": "subtitle", "time": 4204.229, "timestamp": "01:10:04", "text": "たくさん。では、エナを例にとってみましょう。エナは一部です"}, {"type": "subtitle", "time": 4206.47, "timestamp": "01:10:06", "text": "彼女の英語について。似たようなものがたくさんあります"}, {"type": "subtitle", "time": 4208.55, "timestamp": "01:10:08", "text": "彼女には彼女自身のコミュニティがある。それは"}, {"type": "subtitle", "time": 4209.63, "timestamp": "01:10:09", "text": "の"}, {"type": "subtitle", "time": 4212.91, "timestamp": "01:10:12", "text": "タコダチ、タコスのことですよね？のように"}, {"type": "subtitle", "time": 4215.55, "timestamp": "01:10:15", "text": "それ。彼らは同じ"}, {"type": "subtitle", "time": 4218.87, "timestamp": "01:10:18", "text": "ファン活動ですよね？そんな感じ。ご存知の通り、私は"}, {"type": "subtitle", "time": 4220.63, "timestamp": "01:10:20", "text": "言葉遣いが下手だけど、"}, {"type": "subtitle", "time": 4226.709, "timestamp": "01:10:26", "text": "行く。自分だけのコミュニティを作るにはどうすればいいですか？"}, {"type": "subtitle", "time": 4229.03, "timestamp": "01:10:29", "text": "ちょうど"}, {"type": "subtitle", "time": 4232.07, "timestamp": "01:10:32", "text": "えっと、ファミリアもここにいるんですよね？どうやって"}, {"type": "subtitle", "time": 4236.59, "timestamp": "01:10:36", "text": "私は自分自身のコミュニティを作ったのだろうか？私は続けた"}, {"type": "subtitle", "time": 4239.51, "timestamp": "01:10:39", "text": "ストリーミングで交流して、"}, {"type": "subtitle", "time": 4242.709, "timestamp": "01:10:42", "text": "入ってきた人全員が飛び乗った"}, {"type": "subtitle", "time": 4243.95, "timestamp": "01:10:43", "text": "の"}, {"type": "subtitle", "time": 4248.03, "timestamp": "01:10:48", "text": "ゆっくりと流れていく"}, {"type": "subtitle", "time": 4250.95, "timestamp": "01:10:50", "text": "わからなかった、わからない、私は苦手です"}, {"type": "subtitle", "time": 4253.47, "timestamp": "01:10:53", "text": "これ。ああ、"}, {"type": "subtitle", "time": 4256.709, "timestamp": "01:10:56", "text": "神。待って、君が理解してくれるといいんだけど。私は自分が"}]
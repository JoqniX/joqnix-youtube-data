[{"type": "subtitle", "time": 3961.349, "timestamp": "01:06:01", "text": "この辺りでは。こっそり入りたい"}, {"type": "subtitle", "time": 3963.27, "timestamp": "01:06:03", "text": "G3施設のことですか？うん、手に入れなきゃ"}, {"type": "subtitle", "time": 3964.71, "timestamp": "01:06:04", "text": "ベタベタした液体に覆われている。そういうものなんです"}, {"type": "subtitle", "time": 3966.789, "timestamp": "01:06:06", "text": "行く。私の商品は高品質です。ええ、そうですね。あなた"}, {"type": "subtitle", "time": 3969.029, "timestamp": "01:06:09", "text": "ドロドロしたものが欲しいんでしょ？"}, {"type": "subtitle", "time": 3970.63, "timestamp": "01:06:10", "text": "よお、行こう。それは初めてではないだろう"}, {"type": "subtitle", "time": 3972.789, "timestamp": "01:06:12", "text": "粘液まみれになった時。さあ、やろう。"}, {"type": "subtitle", "time": 3975.029, "timestamp": "01:06:15", "text": "完璧。あそこの路地に入ってください。ただ"}, {"type": "subtitle", "time": 3977.829, "timestamp": "01:06:17", "text": "まあ、魔法が起こるのを待つしかないかな。えっと"}, {"type": "subtitle", "time": 3979.43, "timestamp": "01:06:19", "text": "心配しないで。最初のグープは"}, {"type": "subtitle", "time": 3981.43, "timestamp": "01:06:21", "text": "自分。友達みんなに教えてあげて。"}, {"type": "subtitle", "time": 3985.109, "timestamp": "01:06:25", "text": "私はグープの人間です。私はグープ関連の仕事をしています。わかった。"}, {"type": "subtitle", "time": 3987.99, "timestamp": "01:06:27", "text": "大丈夫だよ。私は"}, {"type": "subtitle", "time": 3989.99, "timestamp": "01:06:29", "text": "ここに流れ込む。でも、私はあまり乗り気ではない"}, {"type": "subtitle", "time": 3992.63, "timestamp": "01:06:32", "text": "それ。"}, {"type": "subtitle", "time": 3996.15, "timestamp": "01:06:36", "text": "ああ、なんてことだ。でもそれはひどい。ねえ、見て"}, {"type": "subtitle", "time": 3998.069, "timestamp": "01:06:38", "text": "あなたに向かって。君はベタベタしているね。私は"}, {"type": "subtitle", "time": 4000.95, "timestamp": "01:06:40", "text": "正直に言ってください。何てことだ。それはひどい。"}, {"type": "subtitle", "time": 4003.75, "timestamp": "01:06:43", "text": "何てことだ。入って、出て。留まらないで"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "そこに長くいすぎた。ぐずぐずするな。"}, {"type": "subtitle", "time": 4017.15, "timestamp": "01:06:57", "text": "神。"}]
[{"type": "subtitle", "time": 15061.87, "timestamp": "04:11:01", "text": "待って、待って。それは"}, {"type": "subtitle", "time": 15064.63, "timestamp": "04:11:04", "text": "不可能。待って、待って、待って、待って、"}, {"type": "subtitle", "time": 15072.91, "timestamp": "04:11:12", "text": "待って。サーバーは"}, {"type": "subtitle", "time": 15075.67, "timestamp": "04:11:15", "text": "ライブ。非常に多くの人がツイートしたので"}, {"type": "subtitle", "time": 15081.389, "timestamp": "04:11:21", "text": "サーバーは稼働していましたよね？そしてどのように"}, {"type": "subtitle", "time": 15087.349, "timestamp": "04:11:27", "text": "はあ、いや、君は嘘をついていない"}, {"type": "subtitle", "time": 15089.55, "timestamp": "04:11:29", "text": "発表するから、私が伝えるから"}, {"type": "subtitle", "time": 15097.51, "timestamp": "04:11:37", "text": "ストリーム。ああ、ロア、私の友人、"}, {"type": "subtitle", "time": 15100.229, "timestamp": "04:11:40", "text": "私だけでなく、彼や他の人たちもプレイしています。"}, {"type": "subtitle", "time": 15102.75, "timestamp": "04:11:42", "text": "見て、彼らはそれをプレイしている"}, {"type": "subtitle", "time": 15105.429, "timestamp": "04:11:45", "text": "すでに。見て、彼らはそれをプレイしている"}, {"type": "subtitle", "time": 15107.389, "timestamp": "04:11:47", "text": "すでに。"}, {"type": "subtitle", "time": 15111.11, "timestamp": "04:11:51", "text": "どうやって？どうやって？"}, {"type": "subtitle", "time": 15114.55, "timestamp": "04:11:54", "text": "何？どうやって？うわぁ。落ち着けよ。落ち着けよ、兄弟。"}, {"type": "subtitle", "time": 15116.95, "timestamp": "04:11:56", "text": "私は辞めます。辞めて独立するよ。私"}]
[{"type": "subtitle", "time": 15181.83, "timestamp": "04:13:01", "text": "できる。あなたはアジア市場を扱っていない。ええ、やります"}, {"type": "subtitle", "time": 15184.87, "timestamp": "04:13:04", "text": "両方。両方ともやります。両方ともやります。病気"}, {"type": "subtitle", "time": 15187.87, "timestamp": "04:13:07", "text": "両方ともやってください。両方ともやります。"}, {"type": "subtitle", "time": 15197.309, "timestamp": "04:13:17", "text": "しかしこれは"}, {"type": "subtitle", "time": 15204.51, "timestamp": "04:13:24", "text": "行くよ、私は"}, {"type": "subtitle", "time": 15210.11, "timestamp": "04:13:30", "text": "で詰まってる、えーと、"}, {"type": "subtitle", "time": 15214.87, "timestamp": "04:13:34", "text": "学ぶ。ああ、私はプレイできません。と書いてあります"}, {"type": "subtitle", "time": 15223.229, "timestamp": "04:13:43", "text": "元気ですか？"}, {"type": "subtitle", "time": 15229.67, "timestamp": "04:13:49", "text": "1分たりともダメだ。心配しないで。したい"}, {"type": "subtitle", "time": 15232.71, "timestamp": "04:13:52", "text": "これを確認してください。しかし、あなたの端末にはまだ"}, {"type": "subtitle", "time": 15235.349, "timestamp": "04:13:55", "text": "データ。プレイできません。 「いいえ」と書いてあります"}, {"type": "subtitle", "time": 15238.149, "timestamp": "04:13:58", "text": "発売されました。あ、こんにちは。いらっしゃいませ。いらっしゃいませ。"}]
[{"type": "subtitle", "time": 4146.63, "timestamp": "01:09:06", "text": "私は他のグループを殺して、"}, {"type": "subtitle", "time": 4148.789, "timestamp": "01:09:08", "text": "自分自身のコミュニティを築きましょう。"}, {"type": "subtitle", "time": 4151.43, "timestamp": "01:09:11", "text": "それはつまり、我々の勝利ということか？"}, {"type": "subtitle", "time": 4153.829, "timestamp": "01:09:13", "text": "つまり、"}, {"type": "subtitle", "time": 4156.55, "timestamp": "01:09:16", "text": "ええ、もちろんです。例えば、あなたが"}, {"type": "subtitle", "time": 4159.47, "timestamp": "01:09:19", "text": "企業側の視点から、"}, {"type": "subtitle", "time": 4161.99, "timestamp": "01:09:21", "text": "企業、企業グループ、または"}, {"type": "subtitle", "time": 4165.189, "timestamp": "01:09:25", "text": "何か。弱者どもめ。簡単。"}, {"type": "subtitle", "time": 4169.349, "timestamp": "01:09:29", "text": "本当に簡単だ。次のようにする必要があるでしょう"}, {"type": "subtitle", "time": 4172.07, "timestamp": "01:09:32", "text": "あなたのファン層、またはあなたのファン層の人々は"}, {"type": "subtitle", "time": 4174.07, "timestamp": "01:09:34", "text": "あなたを見るよう歓迎します、彼らはあなたの"}, {"type": "subtitle", "time": 4176.95, "timestamp": "01:09:36", "text": "コミュニティの権利は、たとえあなたが"}, {"type": "subtitle", "time": 4179.87, "timestamp": "01:09:39", "text": "あなた自身のパートの一部"}, {"type": "subtitle", "time": 4183.43, "timestamp": "01:09:43", "text": "例えば、hol life hol としましょう"}, {"type": "subtitle", "time": 4185.11, "timestamp": "01:09:45", "text": "人生は大きなものだ、"}, {"type": "subtitle", "time": 4187.91, "timestamp": "01:09:47", "text": "人生におけるさまざまなコミュニティ"}, {"type": "subtitle", "time": 4191.59, "timestamp": "01:09:51", "text": "例えば、ガグラ、私は彼女を忘れてしまった、"}, {"type": "subtitle", "time": 4194.31, "timestamp": "01:09:54", "text": "彼女のファンネームがまた出てきたけど、そう、シャキーズか"}, {"type": "subtitle", "time": 4196.87, "timestamp": "01:09:56", "text": "何か違う、いや、いや、いや、いや。さあ"}, {"type": "subtitle", "time": 4197.55, "timestamp": "01:09:57", "text": "取る"}]
[{"type": "subtitle", "time": 12422.309, "timestamp": "03:27:02", "text": "それを世に出す"}, {"type": "subtitle", "time": 12425.95, "timestamp": "03:27:05", "text": "何が間違っているのか考えてみてください"}, {"type": "subtitle", "time": 12428.309, "timestamp": "03:27:08", "text": "もの。うん。なぜこれができないのか、そして"}, {"type": "subtitle", "time": 12429.75, "timestamp": "03:27:09", "text": "それらすべて？うん。彼らは"}, {"type": "subtitle", "time": 12432.15, "timestamp": "03:27:12", "text": "彼らと話し合い、適切な相互理解を得る"}, {"type": "subtitle", "time": 12433.79, "timestamp": "03:27:13", "text": "コミュニケーションと"}, {"type": "subtitle", "time": 12435.99, "timestamp": "03:27:15", "text": "理解すればツイートしてくれる"}, {"type": "subtitle", "time": 12438.07, "timestamp": "03:27:18", "text": "そして、あなたが気づいて、"}, {"type": "subtitle", "time": 12441.429, "timestamp": "03:27:21", "text": "卒業とか色々あるよ。その"}, {"type": "subtitle", "time": 12443.83, "timestamp": "03:27:23", "text": "あなたの決定に基づきます。まるで"}, {"type": "subtitle", "time": 12445.63, "timestamp": "03:27:25", "text": "あなたを削除できません"}, {"type": "subtitle", "time": 12449.59, "timestamp": "03:27:29", "text": "待って、まだ覚えていないならこれを覚えておいてください"}, {"type": "subtitle", "time": 12453.15, "timestamp": "03:27:33", "text": "特定の規則を破った"}, {"type": "subtitle", "time": 12455.429, "timestamp": "03:27:35", "text": "代理店、そしてあなたはよくやっていて、"}, {"type": "subtitle", "time": 12457.55, "timestamp": "03:27:37", "text": "しかし、あなたがしなければならないことのために"}, {"type": "subtitle", "time": 12460.11, "timestamp": "03:27:40", "text": "去れば、それが最後です"}, {"type": "subtitle", "time": 12463.51, "timestamp": "03:27:43", "text": "決定したら、彼らは書くでしょう"}, {"type": "subtitle", "time": 12465.59, "timestamp": "03:27:45", "text": "そうすれば彼らはそれを受け入れるだろうし、"}, {"type": "subtitle", "time": 12467.91, "timestamp": "03:27:47", "text": "あなたが去っていくのを見るのは悲しいでしょうが"}, {"type": "subtitle", "time": 12469.75, "timestamp": "03:27:49", "text": "それでも彼らはあなたの決断を尊重するでしょう"}, {"type": "subtitle", "time": 12472.55, "timestamp": "03:27:52", "text": "ええ、ホール11でそれを見ました"}, {"type": "subtitle", "time": 12473.95, "timestamp": "03:27:53", "text": "サンジはかなり"}, {"type": "subtitle", "time": 12477.11, "timestamp": "03:27:57", "text": "多く。はい。"}]
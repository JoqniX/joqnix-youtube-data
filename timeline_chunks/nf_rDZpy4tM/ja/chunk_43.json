[{"type": "subtitle", "time": 2582.109, "timestamp": "00:43:02", "text": "おお。私は"}, {"type": "subtitle", "time": 2584.589, "timestamp": "00:43:04", "text": "まさにその通り"}, {"type": "subtitle", "time": 2593.109, "timestamp": "00:43:13", "text": "彼に何が起こったのか分からない"}, {"type": "subtitle", "time": 2607.51, "timestamp": "00:43:27", "text": "チェックポイントや"}, {"type": "subtitle", "time": 2609.71, "timestamp": "00:43:29", "text": "それは何かになるだろう"}, {"type": "subtitle", "time": 2621.55, "timestamp": "00:43:41", "text": "知る。マスターバウンティ。"}, {"type": "subtitle", "time": 2633.349, "timestamp": "00:43:53", "text": "彼ら。敵の攻撃を受けないように。それは"}, {"type": "subtitle", "time": 2635.55, "timestamp": "00:43:55", "text": "本当に大変です、"}, {"type": "subtitle", "time": 2637.05, "timestamp": "00:43:57", "text": "あまりにも。"}]
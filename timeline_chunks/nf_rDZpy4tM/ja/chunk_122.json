[{"type": "subtitle", "time": 7323.43, "timestamp": "02:02:03", "text": "バイバイ。気にしないでください。私はただやっているだけです"}, {"type": "subtitle", "time": 7325.709, "timestamp": "02:02:05", "text": "小さくて左で"}, {"type": "subtitle", "time": 7334.47, "timestamp": "02:02:14", "text": "うん。それで、えっと、私は返答しました"}, {"type": "subtitle", "time": 7336.43, "timestamp": "02:02:16", "text": "中断されて私は"}, {"type": "subtitle", "time": 7339.55, "timestamp": "02:02:19", "text": "アディティに返信していた。"}, {"type": "subtitle", "time": 7342.229, "timestamp": "02:02:22", "text": "右？グループでいる場合、"}, {"type": "subtitle", "time": 7343.43, "timestamp": "02:02:23", "text": "Vチームを組むことについて"}, {"type": "subtitle", "time": 7345.189, "timestamp": "02:02:25", "text": "タイマーが作動したら、グループから退出してもいいですか？"}, {"type": "subtitle", "time": 7347.589, "timestamp": "02:02:27", "text": "うん。どうですか？"}, {"type": "subtitle", "time": 7350.31, "timestamp": "02:02:30", "text": "彼女に思い出させて"}, {"type": "subtitle", "time": 7353.589, "timestamp": "02:02:33", "text": "念のため、もしあなたがコルなら"}, {"type": "subtitle", "time": 7355.189, "timestamp": "02:02:35", "text": "協力するユーチューバー、もしあなたが"}, {"type": "subtitle", "time": 7357.669, "timestamp": "02:02:37", "text": "代理店、会社、またはグループに、"}, {"type": "subtitle", "time": 7360.149, "timestamp": "02:02:40", "text": "書き込まなければならないことを思い出してください。"}, {"type": "subtitle", "time": 7362.95, "timestamp": "02:02:42", "text": "相互合意書に署名する必要があります。"}, {"type": "subtitle", "time": 7363.629, "timestamp": "02:02:43", "text": "のように"}, {"type": "subtitle", "time": 7367.91, "timestamp": "02:02:47", "text": "彼らがあなたに与える契約"}, {"type": "subtitle", "time": 7370.189, "timestamp": "02:02:50", "text": "現実世界で埋める必要がある"}, {"type": "subtitle", "time": 7372.83, "timestamp": "02:02:52", "text": "情報、なぜならそれは法的"}, {"type": "subtitle", "time": 7375.39, "timestamp": "02:02:55", "text": "契約と彼らは"}, {"type": "subtitle", "time": 7377.51, "timestamp": "02:02:57", "text": "アディがまだいるかどうかわかりません"}]
[{"type": "subtitle", "time": 13203.11, "timestamp": "03:40:03", "text": "ミア、待って。どうやって私を見つけたのですか？あなたは"}, {"type": "subtitle", "time": 13205.55, "timestamp": "03:40:05", "text": "信じる？から？"}, {"type": "subtitle", "time": 13209.87, "timestamp": "03:40:09", "text": "あ、待って。中国語ではどう言いますか？"}, {"type": "subtitle", "time": 13224.86, "timestamp": "03:40:24", "text": "ええと、中国語です。"}, {"type": "subtitle", "time": 13232.07, "timestamp": "03:40:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13247.15, "timestamp": "03:40:47", "text": "ビリー。どのように"}, {"type": "subtitle", "time": 13256.19, "timestamp": "03:40:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 6361.27, "timestamp": "01:46:01", "text": "[音楽]"}, {"type": "subtitle", "time": 6363.669, "timestamp": "01:46:03", "text": "あなたを追跡しています。"}, {"type": "subtitle", "time": 6366.07, "timestamp": "01:46:06", "text": "何かベタベタするものありますか？どうすればいいのかわからない"}, {"type": "subtitle", "time": 6392.87, "timestamp": "01:46:32", "text": "G3に加入した報いだ。"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "あなたが知っている。私はそうは思わない、そうは思わない"}, {"type": "subtitle", "time": 6396.79, "timestamp": "01:46:36", "text": "知る。それはグループであり、あなたはそれをやりたいのです"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "パートナーとして参加して、本当に"}, {"type": "subtitle", "time": 6401.43, "timestamp": "01:46:41", "text": "グループを脱退しますか？グループってこと？"}, {"type": "subtitle", "time": 6404.39, "timestamp": "01:46:44", "text": "企業的なことですよね？覚えておいてください"}, {"type": "subtitle", "time": 6407.27, "timestamp": "01:46:47", "text": "自由に会社を離れることはできない"}, {"type": "subtitle", "time": 6409.59, "timestamp": "01:46:49", "text": "企業だから、まさにそういうグループ"}, {"type": "subtitle", "time": 6412.47, "timestamp": "01:46:52", "text": "契約書に署名する必要があるということです。"}, {"type": "subtitle", "time": 6415.83, "timestamp": "01:46:55", "text": "あなたと"}]
[{"type": "subtitle", "time": 14944.95, "timestamp": "04:09:04", "text": "それ。久しぶりですね。私はそうしました"}, {"type": "subtitle", "time": 14947.51, "timestamp": "04:09:07", "text": "長い朝の小川みたいに"}, {"type": "subtitle", "time": 14950.15, "timestamp": "04:09:10", "text": "今はこんな感じです。ええ、そうですね。私は彼の"}, {"type": "subtitle", "time": 14953.269, "timestamp": "04:09:13", "text": "昔は今頃この時間帯にストリーミング配信してたよね。"}, {"type": "subtitle", "time": 14955.91, "timestamp": "04:09:15", "text": "ええ、では、ライブ配信を始めましょう。私はそうするべきだ"}, {"type": "subtitle", "time": 14957.429, "timestamp": "04:09:17", "text": "え、ライブ配信ってどういう意味？私は"}, {"type": "subtitle", "time": 14965.03, "timestamp": "04:09:25", "text": "ライブ。わかった。わかった。わかった。待って。うーん、うーん。"}, {"type": "subtitle", "time": 14967.71, "timestamp": "04:09:27", "text": "私の"}, {"type": "subtitle", "time": 14972.349, "timestamp": "04:09:32", "text": "もの？ええと、今ライブ配信中です。"}, {"type": "subtitle", "time": 14976.07, "timestamp": "04:09:36", "text": "はい、どうぞ。不具合が発生しました。おい、"}, {"type": "subtitle", "time": 14978.71, "timestamp": "04:09:38", "text": "では、ゲームに切り替えましょう。そうですね、"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "今日は楽しもう、そして私は遊ぶつもりだ"}, {"type": "subtitle", "time": 14985.189, "timestamp": "04:09:45", "text": "SEAサーバー上。はい、そして私たちは"}, {"type": "subtitle", "time": 14989.03, "timestamp": "04:09:49", "text": "SCAが私にとってより効果的かどうかを確認しています。"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "それぞれのサーバーは、私にとってより良いか、そうでないかのどちらかです。それで、"}, {"type": "subtitle", "time": 14992.309, "timestamp": "04:09:52", "text": "両方でプレイするつもりです。わかりました、"}, {"type": "subtitle", "time": 14994.91, "timestamp": "04:09:54", "text": "今日。しかし、まずは"}, {"type": "subtitle", "time": 14999.349, "timestamp": "04:09:59", "text": "SCA。音声と"}]
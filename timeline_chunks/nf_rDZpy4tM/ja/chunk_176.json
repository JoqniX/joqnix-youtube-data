[{"type": "subtitle", "time": 10560.79, "timestamp": "02:56:00", "text": "姿勢がひどく悪い。ああ、やめて"}, {"type": "subtitle", "time": 10563.11, "timestamp": "02:56:03", "text": "心配。別の配信もあります"}, {"type": "subtitle", "time": 10564.95, "timestamp": "02:56:04", "text": "香港。心配しないで、私がやります"}, {"type": "subtitle", "time": 10567.83, "timestamp": "02:56:07", "text": "それもまた然り。ええ、始めます"}, {"type": "subtitle", "time": 10571.309, "timestamp": "02:56:11", "text": "次の配信は9時08分に開始されます。"}, {"type": "subtitle", "time": 10574.23, "timestamp": "02:56:14", "text": "よし、9時8分頃かな。ええ、私は"}, {"type": "subtitle", "time": 10579.23, "timestamp": "02:56:19", "text": "私が終わらせるいくつかのことを私たちにやってもらいます。"}, {"type": "subtitle", "time": 10583.349, "timestamp": "02:56:23", "text": "だから、これは人生最高潮で、そしてこれは"}, {"type": "subtitle", "time": 10587.11, "timestamp": "02:56:27", "text": "ストリームは2番目のt秒でした"}, {"type": "subtitle", "time": 10589.95, "timestamp": "02:56:29", "text": "このパートの2番目のパート"}, {"type": "subtitle", "time": 10592.87, "timestamp": "02:56:32", "text": "ゲーム。そうですね、皆さんにお会いできるのを楽しみにしています。"}, {"type": "subtitle", "time": 10596.389, "timestamp": "02:56:36", "text": "次のハイはライブ配信で。ほとんど"}, {"type": "subtitle", "time": 10600.95, "timestamp": "02:56:40", "text": "おそらく来週には掲載すると思います"}, {"type": "subtitle", "time": 10603.269, "timestamp": "02:56:43", "text": "香港出身の人も何人かいます。ええ、その他"}, {"type": "subtitle", "time": 10610.269, "timestamp": "02:56:50", "text": "そう、"}, {"type": "subtitle", "time": 10615.03, "timestamp": "02:56:55", "text": "私がこれをやります。こんにちは。だから来た人はみんな"}, {"type": "subtitle", "time": 10618.55, "timestamp": "02:56:58", "text": "来てくれて本当にありがとう。"}]
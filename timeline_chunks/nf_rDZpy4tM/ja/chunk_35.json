[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "うん。初期の"}, {"type": "subtitle", "time": 2103.19, "timestamp": "00:35:03", "text": "何？私はただ奇妙で神秘的な"}, {"type": "subtitle", "time": 2104.63, "timestamp": "00:35:04", "text": "おそらくまだあるだろうという感覚"}, {"type": "subtitle", "time": 2106.71, "timestamp": "00:35:06", "text": "G3がどこかでトラブルを起こしてるってことだよね。"}, {"type": "subtitle", "time": 2109.03, "timestamp": "00:35:09", "text": "街のあちこちで。私たちは 私たちは 私たちは 私たちは"}, {"type": "subtitle", "time": 2112.55, "timestamp": "00:35:12", "text": "おそらく、それに対処するしかないでしょう。これは"}, {"type": "subtitle", "time": 2129.75, "timestamp": "00:35:29", "text": "[音楽]"}, {"type": "subtitle", "time": 2151.19, "timestamp": "00:35:51", "text": "えっと、できません。ああ、私たちの活躍ぶりを見てください。"}, {"type": "subtitle", "time": 2156.15, "timestamp": "00:35:56", "text": "バン。つまり、スライド機能は"}, {"type": "subtitle", "time": 2159.589, "timestamp": "00:35:59", "text": "地上であって、空中ではない。エアワンは撃たれた"}]
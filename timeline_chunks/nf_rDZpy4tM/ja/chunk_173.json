[{"type": "subtitle", "time": 10381.19, "timestamp": "02:53:01", "text": "あなたは彼をあちこちで見かけたでしょう。次の日に実行してください"}, {"type": "subtitle", "time": 10382.79, "timestamp": "02:53:02", "text": "ストリーム。写真を見た。あなたはそうしなかった"}, {"type": "subtitle", "time": 10385.51, "timestamp": "02:53:05", "text": "一つ見せてくれ。うん、まとめようか。"}, {"type": "subtitle", "time": 10387.99, "timestamp": "02:53:07", "text": "私は推測する。 Sにとって十分なものとは？良い"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "私にとってはそれで十分です。うん。はい、ラッピングできます"}, {"type": "subtitle", "time": 10392.309, "timestamp": "02:53:12", "text": "上"}, {"type": "subtitle", "time": 10395.429, "timestamp": "02:53:15", "text": "だって、もう6時でしょ？"}, {"type": "subtitle", "time": 10398.15, "timestamp": "02:53:18", "text": "3時間かかる予定です。"}, {"type": "subtitle", "time": 10400.71, "timestamp": "02:53:20", "text": "でも心配しないで、宝物を用意しておくよ。"}, {"type": "subtitle", "time": 10403.03, "timestamp": "02:53:23", "text": "高画質のライブ配信をいくつか実施します。"}, {"type": "subtitle", "time": 10405.59, "timestamp": "02:53:25", "text": "心配しないで。それで、どんなもの"}, {"type": "subtitle", "time": 10407.11, "timestamp": "02:53:27", "text": "ここで何をしたの？例えば、何でも"}, {"type": "subtitle", "time": 10409.11, "timestamp": "02:53:29", "text": "きもい？教えてくれなきゃダメだよ。のように、"}, {"type": "subtitle", "time": 10410.389, "timestamp": "02:53:30", "text": "マジで、頼むよ。私たちは親友です"}, {"type": "subtitle", "time": 10412.07, "timestamp": "02:53:32", "text": "今。"}, {"type": "subtitle", "time": 10416.309, "timestamp": "02:53:36", "text": "おお。以上です。私は電話しました"}, {"type": "subtitle", "time": 10418.71, "timestamp": "02:53:38", "text": "全員集合。スコットは作らなかった"}, {"type": "subtitle", "time": 10420.71, "timestamp": "02:53:40", "text": "町に全く入らないか、単に"}, {"type": "subtitle", "time": 10423.11, "timestamp": "02:53:43", "text": "消えてしまった なぜ彼らは映画を保管するのか"}, {"type": "subtitle", "time": 10425.59, "timestamp": "02:53:45", "text": "ゲーム内でもこんな感じ？それは反則ではないか？"}, {"type": "subtitle", "time": 10427.83, "timestamp": "02:53:47", "text": "OSか何か？著作権はほぼ"}, {"type": "subtitle", "time": 10430.95, "timestamp": "02:53:50", "text": "1時間前。奇妙だ。そして私は"}, {"type": "subtitle", "time": 10432.55, "timestamp": "02:53:52", "text": "G、なんであなたは、なんであなたは"}, {"type": "subtitle", "time": 10434.23, "timestamp": "02:53:54", "text": "これらを見ているのですか？私には理解できない"}, {"type": "subtitle", "time": 10438.469, "timestamp": "02:53:58", "text": "これらすべて。おお。ええと、とても"}]
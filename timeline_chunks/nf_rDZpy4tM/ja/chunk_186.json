[{"type": "subtitle", "time": 11160.83, "timestamp": "03:06:00", "text": "私の"}, {"type": "subtitle", "time": 11163.309, "timestamp": "03:06:03", "text": "最適な"}, {"type": "subtitle", "time": 11165.99, "timestamp": "03:06:05", "text": "たとえそれが私を"}, {"type": "subtitle", "time": 11169.19, "timestamp": "03:06:09", "text": "伝統的、いや伝統的だけど"}, {"type": "subtitle", "time": 11171.309, "timestamp": "03:06:11", "text": "それでも少なくとも"}, {"type": "subtitle", "time": 11175.469, "timestamp": "03:06:15", "text": "ジョック 私は違う 私は違う"}, {"type": "subtitle", "time": 11179.59, "timestamp": "03:06:19", "text": "わからない、というか、"}, {"type": "subtitle", "time": 11182.23, "timestamp": "03:06:22", "text": "これをどう言うか"}, {"type": "subtitle", "time": 11184.07, "timestamp": "03:06:24", "text": "えっと、いつか配信するつもりです"}, {"type": "subtitle", "time": 11186.87, "timestamp": "03:06:26", "text": "自分の写真をいつか自分の場所に飾る"}, {"type": "subtitle", "time": 11187.83, "timestamp": "03:06:27", "text": "1つ"}, {"type": "subtitle", "time": 11191.07, "timestamp": "03:06:31", "text": "うん。うん。あなたも。私は"}, {"type": "subtitle", "time": 11194.87, "timestamp": "03:06:34", "text": "静かに。教会を見に来たら、私は一人ぼっちで"}, {"type": "subtitle", "time": 11198.11, "timestamp": "03:06:38", "text": "それから配信して楽しんで笑おう"}, {"type": "subtitle", "time": 11202.269, "timestamp": "03:06:42", "text": "そういったものすべてに関して。良いことはすべて"}, {"type": "subtitle", "time": 11205.51, "timestamp": "03:06:45", "text": "もの。ああ、私のことを考えているのね。考え"}, {"type": "subtitle", "time": 11214.99, "timestamp": "03:06:54", "text": "神。なぜ私は泣いているのだろう？くそ。待って。"}, {"type": "subtitle", "time": 11217.429, "timestamp": "03:06:57", "text": "ええ、みんながそう思っているのは良いことですね"}]
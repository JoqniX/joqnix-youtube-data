[{"type": "subtitle", "time": 303.469, "timestamp": "00:05:03", "text": "昨日、私たちはストリーミング配信したと思います"}, {"type": "subtitle", "time": 305.909, "timestamp": "00:05:05", "text": "ストリーミング配信はいつまで行うのでしょうか？私"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "忘れた。それで昨日、私たちはハイ"}, {"type": "subtitle", "time": 312.07, "timestamp": "00:05:12", "text": "ライブ配信で配信を終了しました"}, {"type": "subtitle", "time": 315.59, "timestamp": "00:05:15", "text": "7 私はそう信じています。それから私は始めたと思う"}, {"type": "subtitle", "time": 318.629, "timestamp": "00:05:18", "text": "別のストリームは9時に。"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "8時30分に配信予定だったけど、配信したよ"}, {"type": "subtitle", "time": 325.27, "timestamp": "00:05:25", "text": "9時30分か9時。うん。うん。うん。だから私たちは"}, {"type": "subtitle", "time": 327.31, "timestamp": "00:05:27", "text": "香港は"}, {"type": "subtitle", "time": 330.43, "timestamp": "00:05:30", "text": "昨日、私たちは終了しました"}, {"type": "subtitle", "time": 333.83, "timestamp": "00:05:33", "text": "第15章へ。私たちは第16章で終わりました。"}, {"type": "subtitle", "time": 335.99, "timestamp": "00:05:35", "text": "だからこの配信はホンライブの後の配信です"}, {"type": "subtitle", "time": 340.23, "timestamp": "00:05:40", "text": "今日は配信します、私たちは"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "ホン・カイも配信している。だから、やめて、やめて"}, {"type": "subtitle", "time": 345.31, "timestamp": "00:05:45", "text": "心配する"}]
[{"type": "subtitle", "time": 15120.349, "timestamp": "04:12:00", "text": "私は希望を失いました"}, {"type": "subtitle", "time": 15132.55, "timestamp": "04:12:12", "text": "それ。みんながプレイしている。私はこう思う、"}, {"type": "subtitle", "time": 15135.189, "timestamp": "04:12:15", "text": "ちょっと待って。"}, {"type": "subtitle", "time": 15137.189, "timestamp": "04:12:17", "text": "敏感なピューピュー。これを忘れてた"}, {"type": "subtitle", "time": 15140.55, "timestamp": "04:12:20", "text": "このゲームには、つまり戦闘がありません。"}, {"type": "subtitle", "time": 15142.349, "timestamp": "04:12:22", "text": "楽しんでください、"}, {"type": "subtitle", "time": 15145.75, "timestamp": "04:12:25", "text": "知る。でも、ほら、ロザンがやってること"}, {"type": "subtitle", "time": 15148.51, "timestamp": "04:12:28", "text": "最初のボス戦、チュートリアルボス"}, {"type": "subtitle", "time": 15151.51, "timestamp": "04:12:31", "text": "戦い方が違う。いいえ、彼らは選んでいます"}, {"type": "subtitle", "time": 15154.51, "timestamp": "04:12:34", "text": "それらはすべて"}, {"type": "subtitle", "time": 15159.11, "timestamp": "04:12:39", "text": "海。えっと、待たなきゃいけなかったの？"}, {"type": "subtitle", "time": 15164.71, "timestamp": "04:12:44", "text": "待たないといけないの？"}, {"type": "subtitle", "time": 15166.75, "timestamp": "04:12:46", "text": "私は好きにならなければならなかった"}, {"type": "subtitle", "time": 15170.91, "timestamp": "04:12:50", "text": "待って？入場できません。"}, {"type": "subtitle", "time": 15175.63, "timestamp": "04:12:55", "text": "何？待って。ああ、あなたのところから確認してみた"}, {"type": "subtitle", "time": 15178.83, "timestamp": "04:12:58", "text": "そしてもしあなたがもしあなたがもしあなたが"}]
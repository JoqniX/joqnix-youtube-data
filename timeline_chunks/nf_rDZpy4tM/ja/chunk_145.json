[{"type": "subtitle", "time": 8708.349, "timestamp": "02:25:08", "text": "場所？どうやって私はここに来たのか"}, {"type": "subtitle", "time": 8711.469, "timestamp": "02:25:11", "text": "ここ？ Google にアクセスする必要がありますか"}, {"type": "subtitle", "time": 8726.95, "timestamp": "02:25:26", "text": "何てことだ。私はずっと前の場所まで戻りました。"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "宇宙遊泳者。ああ、このスライド大好き。"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "君を強くしてやる。だった"}, {"type": "subtitle", "time": 8734.07, "timestamp": "02:25:34", "text": "あなたを"}, {"type": "subtitle", "time": 8736.389, "timestamp": "02:25:36", "text": "何てことだ。本当に素晴らしい。私たちは行く"}, {"type": "subtitle", "time": 8738.55, "timestamp": "02:25:38", "text": "銃を作るために"}, {"type": "subtitle", "time": 8742.87, "timestamp": "02:25:42", "text": "あなたの腕。撃て。"}, {"type": "subtitle", "time": 8746.15, "timestamp": "02:25:46", "text": "何てことだ。私はずっと戻ってきました。"}]
[{"type": "subtitle", "time": 16320.55, "timestamp": "04:32:00", "text": "ワ。ダメージを与えている。敵を倒すか"}, {"type": "subtitle", "time": 16322.83, "timestamp": "04:32:02", "text": "回避行動を実行すると共鳴が生じる"}, {"type": "subtitle", "time": 16325.99, "timestamp": "04:32:05", "text": "エネルギー。共鳴エネルギーが満タンになると、"}, {"type": "subtitle", "time": 16328.149, "timestamp": "04:32:08", "text": "強力な共鳴解放"}, {"type": "subtitle", "time": 16330.75, "timestamp": "04:32:10", "text": "利用可能になります。"}, {"type": "subtitle", "time": 16333.83, "timestamp": "04:32:13", "text": "うわぁ。気をつけて。"}, {"type": "subtitle", "time": 16337.189, "timestamp": "04:32:17", "text": "私は今すぐボスと戦いたい。私は避けた"}, {"type": "subtitle", "time": 16345.229, "timestamp": "04:32:25", "text": "プレス"}, {"type": "subtitle", "time": 16354.03, "timestamp": "04:32:34", "text": "おお、いいね。スピード違反"}, {"type": "subtitle", "time": 16362.149, "timestamp": "04:32:42", "text": "見逃してしまいました。"}, {"type": "subtitle", "time": 16364.83, "timestamp": "04:32:44", "text": "私のセンサー"}, {"type": "subtitle", "time": 16368.55, "timestamp": "04:32:48", "text": "弱さこそが汝の刃となる。"}, {"type": "subtitle", "time": 16371.03, "timestamp": "04:32:51", "text": "これはすごくクールだ。"}, {"type": "subtitle", "time": 16372.75, "timestamp": "04:32:52", "text": "スウィフトと"}]
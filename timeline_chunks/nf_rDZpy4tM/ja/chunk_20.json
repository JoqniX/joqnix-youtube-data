[{"type": "subtitle", "time": 1203.909, "timestamp": "00:20:03", "text": "ちょっと聞いてください。この場所は"}, {"type": "subtitle", "time": 1206.549, "timestamp": "00:20:06", "text": "まさに地獄のような場所だ。でもね、知ってる？"}, {"type": "subtitle", "time": 1209.31, "timestamp": "00:20:09", "text": "街に着いたら、ああ"}, {"type": "subtitle", "time": 1212.07, "timestamp": "00:20:12", "text": "まったく、相変わらず地獄のような場所だ。でも地獄はたくさん"}, {"type": "subtitle", "time": 1213.909, "timestamp": "00:20:13", "text": "周りに人がいる方がもっと楽しい。取る"}, {"type": "subtitle", "time": 1216.23, "timestamp": "00:20:16", "text": "それは私からのものです。きっと気に入るよ。"}, {"type": "subtitle", "time": 1219.669, "timestamp": "00:20:19", "text": "みんなよくそう言うよね。私を信じてください。"}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "怖い？"}, {"type": "subtitle", "time": 1239.99, "timestamp": "00:20:39", "text": "離れる。君にはここにいてほしい。"}, {"type": "subtitle", "time": 1254.07, "timestamp": "00:20:54", "text": "はい、わかりました。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 1257.029, "timestamp": "00:20:57", "text": "もうすぐだ。"}, {"type": "subtitle", "time": 1259.27, "timestamp": "00:20:59", "text": "息子よ、私は君をとても誇りに思っている。君は君は"}]
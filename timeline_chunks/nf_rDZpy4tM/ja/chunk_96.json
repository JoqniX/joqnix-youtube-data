[{"type": "subtitle", "time": 5767.51, "timestamp": "01:36:07", "text": "パズル。彼は少し化粧をしている"}, {"type": "subtitle", "time": 5769.189, "timestamp": "01:36:09", "text": "彼自身。これは少し難しい"}, {"type": "subtitle", "time": 5774.44, "timestamp": "01:36:14", "text": "おお、"}, {"type": "subtitle", "time": 5783.75, "timestamp": "01:36:23", "text": "どうすればあなたにお礼ができるでしょうか？チップを渡すべきでしょうか？"}, {"type": "subtitle", "time": 5785.43, "timestamp": "01:36:25", "text": "あなた？手伝ってくれたらいくらチップを渡せばいいですか？"}, {"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "パズルを解く？ 15％、20％？すべて実行"}, {"type": "subtitle", "time": 5789.99, "timestamp": "01:36:29", "text": "レベルソルバーはヒントを取り出し、"}, {"type": "subtitle", "time": 5791.27, "timestamp": "01:36:31", "text": "君たちは後に別れた"}, {"type": "subtitle", "time": 5792.79, "timestamp": "01:36:32", "text": "夜？それともそれは何らかの"}, {"type": "subtitle", "time": 5794.79, "timestamp": "01:36:34", "text": "パズル解決者組合？少し手伝いました"}]
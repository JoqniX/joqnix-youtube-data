[{"type": "subtitle", "time": 9660.15, "timestamp": "02:41:00", "text": "あなた？気持ち悪いのは分かってるけど、落ち着いて。"}, {"type": "subtitle", "time": 9662.389, "timestamp": "02:41:02", "text": "私の名前はスタンです。そして私は恐ろしい"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "あらゆる種類のエイリアンがやってきて"}, {"type": "subtitle", "time": 9666.23, "timestamp": "02:41:06", "text": "私たちはそれを受け入れるしかない"}, {"type": "subtitle", "time": 9669.83, "timestamp": "02:41:09", "text": "その知識を一つにまとめる。今はできない"}, {"type": "subtitle", "time": 9671.67, "timestamp": "02:41:11", "text": "私たちはこれをやっていると信じていますが、"}, {"type": "subtitle", "time": 9675.19, "timestamp": "02:41:15", "text": "何人か来る。わあ、君を見てごらん。あなたは欲しい"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "エイリアンの精液？あなたが"}, {"type": "subtitle", "time": 9679.19, "timestamp": "02:41:19", "text": "興味がある。ほら、君は僕を捕まえた"}, {"type": "subtitle", "time": 9681.51, "timestamp": "02:41:21", "text": "良い一日。プロモーションを1回だけ行います"}, {"type": "subtitle", "time": 9684.23, "timestamp": "02:41:24", "text": "無料のエイリアンの精液。いくつか取って"}, {"type": "subtitle", "time": 9686.07, "timestamp": "02:41:26", "text": "家。気に入ったら、ぜひ来てください。"}, {"type": "subtitle", "time": 9690.75, "timestamp": "02:41:30", "text": "戻ってさらにいくつか手に入れよう。ただ教えて"}, {"type": "subtitle", "time": 9694.15, "timestamp": "02:41:34", "text": "彼らは最高のエイリアンがやってくる"}, {"type": "subtitle", "time": 9696.23, "timestamp": "02:41:36", "text": "私が今まで見た中で。よし、彼女を見つけたぞ"}, {"type": "subtitle", "time": 9704.389, "timestamp": "02:41:44", "text": "私たちは麻薬を隠しているのでしょうか？わかった。ああ、見て"}, {"type": "subtitle", "time": 9707.03, "timestamp": "02:41:47", "text": "エイリアンカムをもっと見るには、あなたは？ええと、私は"}, {"type": "subtitle", "time": 9709.27, "timestamp": "02:41:49", "text": "ごめん。エイリアンが切れたばかりです。"}, {"type": "subtitle", "time": 9711.67, "timestamp": "02:41:51", "text": "今。売り切れが早々に発生することもあります。私は手に入れた"}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "在庫を補充しに行くのですが、それは"}, {"type": "subtitle", "time": 9715.67, "timestamp": "02:41:55", "text": "とても簡単だ。私を信じて。でも少しだけ"}, {"type": "subtitle", "time": 9717.51, "timestamp": "02:41:57", "text": "少しだけ、そして私はもっとたくさん持っています。私"}, {"type": "subtitle", "time": 9719.83, "timestamp": "02:41:59", "text": "約束。ただ、私はただ少しだけ"}]
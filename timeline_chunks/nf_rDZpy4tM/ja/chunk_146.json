[{"type": "subtitle", "time": 8764.51, "timestamp": "02:26:04", "text": "おお"}, {"type": "subtitle", "time": 8768.469, "timestamp": "02:26:08", "text": "男の子。私は一体どこから来たのだろう？わかった。"}, {"type": "subtitle", "time": 8770.309, "timestamp": "02:26:10", "text": "この区域は、マザーズ・アゲインスト・ザ・マザーズの一部です。"}, {"type": "subtitle", "time": 8772.469, "timestamp": "02:26:12", "text": "暴力条約。だから、暴力はなし"}, {"type": "subtitle", "time": 8775.27, "timestamp": "02:26:15", "text": "許可された。"}, {"type": "subtitle", "time": 8777.59, "timestamp": "02:26:17", "text": "[音楽]"}, {"type": "subtitle", "time": 8787.389, "timestamp": "02:26:27", "text": "だった？どこに"}, {"type": "subtitle", "time": 8804.71, "timestamp": "02:26:44", "text": "いいえ。クリッピング。ああ、私は切り取っている"}, {"type": "subtitle", "time": 8806.83, "timestamp": "02:26:46", "text": "再び"}]
[{"type": "subtitle", "time": 13148.429, "timestamp": "03:39:08", "text": "でも結局私が欲しいのは"}, {"type": "subtitle", "time": 13151.55, "timestamp": "03:39:11", "text": "家族に知らせるために"}, {"type": "subtitle", "time": 13153.79, "timestamp": "03:39:13", "text": "知る"}, {"type": "subtitle", "time": 13156.269, "timestamp": "03:39:16", "text": "私は"}, {"type": "subtitle", "time": 13160.429, "timestamp": "03:39:20", "text": "ここでも一緒に過ごしたりもします。"}, {"type": "subtitle", "time": 13165.309, "timestamp": "03:39:25", "text": "私たちは一緒に最善を尽くします"}, {"type": "subtitle", "time": 13166.99, "timestamp": "03:39:26", "text": "家族。"}, {"type": "subtitle", "time": 13177.469, "timestamp": "03:39:37", "text": "こんにちは、いいね"}, {"type": "subtitle", "time": 13180.19, "timestamp": "03:39:40", "text": "それ"}, {"type": "subtitle", "time": 13183.79, "timestamp": "03:39:43", "text": "また。待って、あなたの"}, {"type": "subtitle", "time": 13187.35, "timestamp": "03:39:47", "text": "名前？あなたの名前を発音したい"}, {"type": "subtitle", "time": 13193.87, "timestamp": "03:39:53", "text": "[音楽]"}, {"type": "subtitle", "time": 13199.309, "timestamp": "03:39:59", "text": "はぁ？"}]
[{"type": "subtitle", "time": 2402.39, "timestamp": "00:40:02", "text": "彼を見て。彼の顔は壊れているか、"}, {"type": "subtitle", "time": 2404.67, "timestamp": "00:40:04", "text": "何か。"}, {"type": "subtitle", "time": 2408.23, "timestamp": "00:40:08", "text": "おお。ケニー・チャンに何が起こったか見てみろ。"}, {"type": "subtitle", "time": 2411.75, "timestamp": "00:40:11", "text": "何てことだ。彼の顔。彼の顔は消えてしまった。"}, {"type": "subtitle", "time": 2413.829, "timestamp": "00:40:13", "text": "紛失しています。ゲームは恩返しをする"}, {"type": "subtitle", "time": 2420.31, "timestamp": "00:40:20", "text": "やあ、君。あなたはこの辺りの出身ではない"}, {"type": "subtitle", "time": 2422.55, "timestamp": "00:40:22", "text": "あなたはここにいますか？それは、"}, {"type": "subtitle", "time": 2425.43, "timestamp": "00:40:25", "text": "ありきたりな話だけどね。"}, {"type": "subtitle", "time": 2426.75, "timestamp": "00:40:26", "text": "いいえ、"}, {"type": "subtitle", "time": 2441.67, "timestamp": "00:40:41", "text": "知る。興味深い配信タイトルですね。ええ、私は"}, {"type": "subtitle", "time": 2444.63, "timestamp": "00:40:44", "text": "殺したくないけど、そうしないといけない"}, {"type": "subtitle", "time": 2447.109, "timestamp": "00:40:47", "text": "待って。"}, {"type": "subtitle", "time": 2448.91, "timestamp": "00:40:48", "text": "私の名前はイェーです。"}, {"type": "subtitle", "time": 2452.23, "timestamp": "00:40:52", "text": "こんにちは。元気ですか？だって一度私は"}, {"type": "subtitle", "time": 2453.99, "timestamp": "00:40:53", "text": "ひどく酔っ払って、大きな"}, {"type": "subtitle", "time": 2456.63, "timestamp": "00:40:56", "text": "ケーキ。彼らはとても面白いと思ったので"}, {"type": "subtitle", "time": 2457.95, "timestamp": "00:40:57", "text": "電話をかけ始めた"}]
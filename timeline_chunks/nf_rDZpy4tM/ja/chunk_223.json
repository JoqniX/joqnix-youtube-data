[{"type": "subtitle", "time": 13382.269, "timestamp": "03:43:02", "text": "神。うん。私にとってもそれは"}, {"type": "subtitle", "time": 13390.07, "timestamp": "03:43:10", "text": "ある意味、私はそれが始まってほしかったと思う"}, {"type": "subtitle", "time": 13391.309, "timestamp": "03:43:11", "text": "外"}, {"type": "subtitle", "time": 13395.189, "timestamp": "03:43:15", "text": "家族に自分がやりたいことを見せる"}, {"type": "subtitle", "time": 13398.95, "timestamp": "03:43:18", "text": "そして私が誇りに思っていること、あるいは私が好きなこと"}, {"type": "subtitle", "time": 13401.51, "timestamp": "03:43:21", "text": "私が好きなのは、何、何、ええ、私が"}, {"type": "subtitle", "time": 13405.79, "timestamp": "03:43:25", "text": "自分の持ち物で何かをするのが大好きだ。"}, {"type": "subtitle", "time": 13409.63, "timestamp": "03:43:29", "text": "うん。しかし、それでも十分ではない"}, {"type": "subtitle", "time": 13413.189, "timestamp": "03:43:33", "text": "知る。うん。それでは不十分だ。"}, {"type": "subtitle", "time": 13415.07, "timestamp": "03:43:35", "text": "維持しなければならない"}, {"type": "subtitle", "time": 13418.309, "timestamp": "03:43:38", "text": "人々が最善を尽くせるように"}, {"type": "subtitle", "time": 13421.03, "timestamp": "03:43:41", "text": "あなたを認め、また認めます"}, {"type": "chat", "time": 13423.013, "timestamp": "03:43:43", "author": "@ArekuVT", "avatar": "https://yt4.ggpht.com/pqSduyGeea3diiqImLaqfTDN6g8f9g3gvrMGmIFqiGTP6ktehIf_rNzOg3vog72mKxfC-qSiBWQ=s64-c-k-c0x00ffffff-no-rj", "message": "everyone eep well now "}, {"type": "subtitle", "time": 13427.63, "timestamp": "03:43:47", "text": "あなたの実存主義的な事柄。そんな風に番組をやってみて。"}, {"type": "chat", "time": 13430.397, "timestamp": "03:43:50", "author": "@ArekuVT", "avatar": "https://yt4.ggpht.com/pqSduyGeea3diiqImLaqfTDN6g8f9g3gvrMGmIFqiGTP6ktehIf_rNzOg3vog72mKxfC-qSiBWQ=s64-c-k-c0x00ffffff-no-rj", "message": "and thanks again for raiding with me ww"}, {"type": "subtitle", "time": 13430.55, "timestamp": "03:43:50", "text": "ん。それに関するメッセージを読んでください。あなたは手に入れるでしょう"}, {"type": "subtitle", "time": 13432.67, "timestamp": "03:43:52", "text": "うん。うん。読みましたよ。読んだ"}, {"type": "subtitle", "time": 13435.429, "timestamp": "03:43:55", "text": "それ。ウォルター・ホワイトだが、いじめっ子だ。私は"}, {"type": "subtitle", "time": 13436.67, "timestamp": "03:43:56", "text": "一人"}, {"type": "subtitle", "time": 13439.03, "timestamp": "03:43:59", "text": "いじめっ子たち。もう一つ質問があります。こんにちは。行く"}]
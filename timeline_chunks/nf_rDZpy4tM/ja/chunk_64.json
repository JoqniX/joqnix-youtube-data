[{"type": "subtitle", "time": 3864.349, "timestamp": "01:04:24", "text": "もう？よし、こうやろう。"}, {"type": "subtitle", "time": 3868.829, "timestamp": "01:04:28", "text": "クレイジー・ダグ、クリエーション責任者。はい、"}, {"type": "subtitle", "time": 3871.67, "timestamp": "01:04:31", "text": "その通り。うん。うん。ホル英語、ホル"}, {"type": "subtitle", "time": 3875.71, "timestamp": "01:04:35", "text": "JPです、皆さん。彼らは皆、たくさんのことをしました"}, {"type": "subtitle", "time": 3881.5, "timestamp": "01:04:41", "text": "たとえ"}, {"type": "subtitle", "time": 3883.15, "timestamp": "01:04:43", "text": "[音楽]"}, {"type": "subtitle", "time": 3886.829, "timestamp": "01:04:46", "text": "良い。なぜこう書いてあるの？"}, {"type": "subtitle", "time": 3889.349, "timestamp": "01:04:49", "text": "集める？ああ、もう1つある。"}]
[{"type": "subtitle", "time": 4021.109, "timestamp": "01:07:01", "text": "T3、グループで参加する必要があるのでしょうか？"}, {"type": "subtitle", "time": 4023.349, "timestamp": "01:07:03", "text": "始めるには、または自分で始めることができますか？"}, {"type": "subtitle", "time": 4025.43, "timestamp": "01:07:05", "text": "それはあなた次第です。欲しいですか"}, {"type": "subtitle", "time": 4027.19, "timestamp": "01:07:07", "text": "企業人になりたいですか、それとも"}, {"type": "subtitle", "time": 4028.87, "timestamp": "01:07:08", "text": "独立した？"}, {"type": "subtitle", "time": 4031.029, "timestamp": "01:07:11", "text": "G3カルテルは"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "責任者。結局はあなた次第です。負傷"}, {"type": "subtitle", "time": 4034.71, "timestamp": "01:07:14", "text": "この敷地内では、以下の費用が発生する可能性があります。あなたは"}, {"type": "subtitle", "time": 4037.109, "timestamp": "01:07:17", "text": "どんなことでももっと自由になりたい"}, {"type": "subtitle", "time": 4039.349, "timestamp": "01:07:19", "text": "あなたがやる"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "それとも、あなたはすでに"}, {"type": "subtitle", "time": 4044.47, "timestamp": "01:07:24", "text": "私が誰なのか知っていてください。あなたはなりたいですか、あなたは"}, {"type": "subtitle", "time": 4047.51, "timestamp": "01:07:27", "text": "大きく始めたいけれど、"}, {"type": "subtitle", "time": 4051.19, "timestamp": "01:07:31", "text": "既存のコミュニティは少しぼやけている"}, {"type": "subtitle", "time": 4053.19, "timestamp": "01:07:33", "text": "歩いて通り抜ける？何が"}, {"type": "subtitle", "time": 4054.39, "timestamp": "01:07:34", "text": "違い？"}, {"type": "subtitle", "time": 4056.15, "timestamp": "01:07:36", "text": "それとも、最初から始めたいですか？"}, {"type": "subtitle", "time": 4057.91, "timestamp": "01:07:37", "text": "自分のコミュニティを作って構築する"}, {"type": "subtitle", "time": 4060.87, "timestamp": "01:07:40", "text": "ゆっくりと、自分の力で立ち上がる"}, {"type": "subtitle", "time": 4062.789, "timestamp": "01:07:42", "text": "仕事に基づいた正確なシミュレーション"}, {"type": "subtitle", "time": 4064.39, "timestamp": "01:07:44", "text": "それはどんなタイプのものにも見え、どんな機能も果たします"}, {"type": "subtitle", "time": 4066.47, "timestamp": "01:07:46", "text": "あなたが望むコンテンツは誰も"}, {"type": "subtitle", "time": 4068.23, "timestamp": "01:07:48", "text": "あなたを判断したり、誰も言わないだろう"}, {"type": "subtitle", "time": 4070.39, "timestamp": "01:07:50", "text": "あれこれしないでほしいことがたくさんあります"}, {"type": "subtitle", "time": 4074.51, "timestamp": "01:07:54", "text": "自由、それが独立"}, {"type": "subtitle", "time": 4077.829, "timestamp": "01:07:57", "text": "ガリオンを持っているように見えるのがわかりますか？"}, {"type": "subtitle", "time": 4079.43, "timestamp": "01:07:59", "text": "彼女を救出するべきでしょう。"}]
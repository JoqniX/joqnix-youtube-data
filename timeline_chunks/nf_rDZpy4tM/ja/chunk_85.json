[{"type": "subtitle", "time": 5102.709, "timestamp": "01:25:02", "text": "コミュニティ、インターネット、えーっと、"}, {"type": "subtitle", "time": 5104.95, "timestamp": "01:25:04", "text": "YouTuberやInstagramerのような人たち。あなたはできる"}, {"type": "subtitle", "time": 5107.91, "timestamp": "01:25:07", "text": "同じことがアッラーの周りで起こるのを見てください"}, {"type": "subtitle", "time": 5117.39, "timestamp": "01:25:17", "text": "うん、"}, {"type": "subtitle", "time": 5120.47, "timestamp": "01:25:20", "text": "私たちがそちらに向かっているということです。願っています"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "期待していた。"}, {"type": "subtitle", "time": 5126.51, "timestamp": "01:25:26", "text": "このセグメント全体を"}, {"type": "subtitle", "time": 5129.51, "timestamp": "01:25:29", "text": "ポッドキャスト。わかった。これは何ですか？"}, {"type": "subtitle", "time": 5132.07, "timestamp": "01:25:32", "text": "皆さんおめでとうございます"}, {"type": "subtitle", "time": 5134.39, "timestamp": "01:25:34", "text": "ここまでトレーニングを積んできたんですね。それは"}, {"type": "subtitle", "time": 5136.87, "timestamp": "01:25:36", "text": "さあ、いよいよ最終テストの時間だ。血まみれの"}, {"type": "subtitle", "time": 5138.79, "timestamp": "01:25:38", "text": "運動部員同士の会話は自由です。え、何？"}, {"type": "subtitle", "time": 5141.91, "timestamp": "01:25:41", "text": "スタンディングはG3に加わることになる。ルールなし、"}, {"type": "subtitle", "time": 5144.95, "timestamp": "01:25:44", "text": "ただ殺すだけ。頑張れよ、クソ野郎。ウナギ。神"}, {"type": "subtitle", "time": 5147.189, "timestamp": "01:25:47", "text": "くそ。もう一つクソなこと"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "これ。なんてこった。全員殺してしまえ。私"}, {"type": "subtitle", "time": 5151.83, "timestamp": "01:25:51", "text": "つまり、ほら、私は昔は"}, {"type": "subtitle", "time": 5154.87, "timestamp": "01:25:54", "text": "ポッドキャストですよね？つまり、以前は"}, {"type": "subtitle", "time": 5158.229, "timestamp": "01:25:58", "text": "ポッドキャストの仮想化の一部"}, {"type": "subtitle", "time": 5159.629, "timestamp": "01:25:59", "text": "昔の"}]
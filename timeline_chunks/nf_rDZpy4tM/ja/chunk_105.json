[{"type": "subtitle", "time": 6304.229, "timestamp": "01:45:04", "text": "出てくる。出てくる。グローショット。私は持っています"}, {"type": "subtitle", "time": 6306.87, "timestamp": "01:45:06", "text": "銃。これはグローブをつけた状態の写真です。ケニーは"}, {"type": "subtitle", "time": 6322.75, "timestamp": "01:45:22", "text": "物事を遅くする泡のようなものを表示してください。"}, {"type": "subtitle", "time": 6325.75, "timestamp": "01:45:25", "text": "これは違う。"}, {"type": "subtitle", "time": 6350.709, "timestamp": "01:45:50", "text": "私を殺すつもりですか？うん。"}, {"type": "subtitle", "time": 6359.38, "timestamp": "01:45:59", "text": "ぎゅっとする。ああ、スクイージーは持っていません。"}]
[{"type": "subtitle", "time": 12125.67, "timestamp": "03:22:05", "text": "もの。ええ、私も最善を尽くします"}, {"type": "subtitle", "time": 12127.229, "timestamp": "03:22:07", "text": "続ける"}, {"type": "subtitle", "time": 12131.15, "timestamp": "03:22:11", "text": "最高。ええ、ツイートしましたよ。私はそれを置いた"}, {"type": "subtitle", "time": 12133.75, "timestamp": "03:22:13", "text": "どこにでも。不和。いいえ、私はやっていません"}, {"type": "subtitle", "time": 12135.87, "timestamp": "03:22:15", "text": "今回の通話について。"}, {"type": "subtitle", "time": 12139.63, "timestamp": "03:22:19", "text": "でも、似たようなものの中でも"}, {"type": "subtitle", "time": 12142.87, "timestamp": "03:22:22", "text": "外見、あなたが知ることができるように"}, {"type": "subtitle", "time": 12145.71, "timestamp": "03:22:25", "text": "内なる私"}, {"type": "subtitle", "time": 12148.71, "timestamp": "03:22:28", "text": "彼ら。あなたがそうしないことを願います"}, {"type": "subtitle", "time": 12152.12, "timestamp": "03:22:32", "text": "私を別人と間違える。うん。"}, {"type": "subtitle", "time": 12155.229, "timestamp": "03:22:35", "text": "[音楽]"}, {"type": "subtitle", "time": 12159.349, "timestamp": "03:22:39", "text": "では、なぜ私はそれをツイートしたのでしょうか？なぜ私は"}, {"type": "subtitle", "time": 12162.71, "timestamp": "03:22:42", "text": "それに対処する？わかりました、聞いてください。"}, {"type": "subtitle", "time": 12165.429, "timestamp": "03:22:45", "text": "私たち。それは単に"}, {"type": "subtitle", "time": 12167.429, "timestamp": "03:22:47", "text": "ホロテンペストのやつだけど、"}, {"type": "subtitle", "time": 12170.349, "timestamp": "03:22:50", "text": "何でも"}, {"type": "subtitle", "time": 12174.309, "timestamp": "03:22:54", "text": "それ以外のものは、実際には他の何物でもあり得る。"}, {"type": "subtitle", "time": 12177.15, "timestamp": "03:22:57", "text": "何？重要なのは私が"}]
[{"type": "subtitle", "time": 1920.47, "timestamp": "00:32:00", "text": "G3に加入したのは、我々にとって最高のアイデアだった。"}, {"type": "subtitle", "time": 1923.029, "timestamp": "00:32:03", "text": "今までになかった。これほど生きている実感を感じたことはない。おお"}, {"type": "subtitle", "time": 1924.78, "timestamp": "00:32:04", "text": "私の"}, {"type": "subtitle", "time": 1927.23, "timestamp": "00:32:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1931.029, "timestamp": "00:32:11", "text": "神。これは何に使われているのですか？あなたはただ歩いただけです"}, {"type": "subtitle", "time": 1933.269, "timestamp": "00:32:13", "text": "そして、私はあなたを撃たなければならない。あなたは今言った"}, {"type": "subtitle", "time": 1937.35, "timestamp": "00:32:17", "text": "あなたはD G3に加入したんですよね？"}, {"type": "subtitle", "time": 1940.549, "timestamp": "00:32:20", "text": "自分を殺してしまってごめんなさい。"}, {"type": "subtitle", "time": 1943.549, "timestamp": "00:32:23", "text": "はい。はい。もちろん。欲しい"}, {"type": "subtitle", "time": 1945.149, "timestamp": "00:32:25", "text": "あなた"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "昔のカウボーイはこうやってたのか"}, {"type": "subtitle", "time": 1969.029, "timestamp": "00:32:49", "text": "二人が話していて、ハイテク機器も？"}, {"type": "subtitle", "time": 1970.71, "timestamp": "00:32:50", "text": "ドラッグタウンの過去はここにある。私はただ立っている"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "周りの人にそう伝えてください。どうしたの"}, {"type": "subtitle", "time": 1973.909, "timestamp": "00:32:53", "text": "ほら、犬？こんにちは。誰も入れることはできない"}, {"type": "subtitle", "time": 1975.269, "timestamp": "00:32:55", "text": "今すぐ。新兵が多すぎる"}, {"type": "subtitle", "time": 1976.63, "timestamp": "00:32:56", "text": "町で騒ぎを起こしている。中に入る"}, {"type": "subtitle", "time": 1977.99, "timestamp": "00:32:57", "text": "そうなると厄介なことになる。だから、私は行く"}, {"type": "subtitle", "time": 1979.509, "timestamp": "00:32:59", "text": "彼らが止まるまで門を閉めておく"}]
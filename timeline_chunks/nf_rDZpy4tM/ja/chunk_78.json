[{"type": "subtitle", "time": 4681.11, "timestamp": "01:18:01", "text": "精神病質者の"}, {"type": "subtitle", "time": 4683.51, "timestamp": "01:18:03", "text": "コミュニティやファントムと言ってもいいが"}, {"type": "subtitle", "time": 4685.669, "timestamp": "01:18:05", "text": "精神病患者をサポートするためにそこにいる"}, {"type": "subtitle", "time": 4687.99, "timestamp": "01:18:07", "text": "徐々に既存の人々も"}, {"type": "subtitle", "time": 4689.59, "timestamp": "01:18:09", "text": "腕時計"}, {"type": "subtitle", "time": 4692.79, "timestamp": "01:18:12", "text": "えっと、私たちを第1世代と第2世代のように見ている人は"}, {"type": "subtitle", "time": 4694.87, "timestamp": "01:18:14", "text": "彼らも来て彼らを支援するだろう"}, {"type": "subtitle", "time": 4697.189, "timestamp": "01:18:17", "text": "そう、そうやってあなたは来た"}, {"type": "subtitle", "time": 4699.35, "timestamp": "01:18:19", "text": "毎日視聴している忠実な視聴者のような"}, {"type": "subtitle", "time": 4701.47, "timestamp": "01:18:21", "text": "ウォッチャーがやって来る"}, {"type": "subtitle", "time": 4705.27, "timestamp": "01:18:25", "text": "そう、だからあなたが新しい才能か"}, {"type": "subtitle", "time": 4708.07, "timestamp": "01:18:28", "text": "何か新しい世代が"}, {"type": "subtitle", "time": 4709.75, "timestamp": "01:18:29", "text": "設立"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "えーと、コミュニティ。より難しくなるだろう"}, {"type": "subtitle", "time": 4713.709, "timestamp": "01:18:33", "text": "初め、"}, {"type": "subtitle", "time": 4716.95, "timestamp": "01:18:36", "text": "でも時間が経てば慣れるし、"}, {"type": "subtitle", "time": 4718.189, "timestamp": "01:18:38", "text": "もの。うん。"}, {"type": "subtitle", "time": 4722.91, "timestamp": "01:18:42", "text": "うん。それで、今度はインディーズのインディーズが登場します"}, {"type": "subtitle", "time": 4726.91, "timestamp": "01:18:46", "text": "例えば、YouTube。えっと、私を連れて行って、"}, {"type": "subtitle", "time": 4729.149, "timestamp": "01:18:49", "text": "右？服用すべきでしょうか"}, {"type": "subtitle", "time": 4733.35, "timestamp": "01:18:53", "text": "自分自身？いいえ。えっと、わかりません。私はそうは思わない"}, {"type": "subtitle", "time": 4734.87, "timestamp": "01:18:54", "text": "誰かを連れて行くべきかどうかわからない"}, {"type": "subtitle", "time": 4736.35, "timestamp": "01:18:56", "text": "だから怖いんです。"}, {"type": "subtitle", "time": 4739.79, "timestamp": "01:18:59", "text": "えっと、誰に"}]
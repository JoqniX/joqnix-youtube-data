[{"type": "subtitle", "time": 16261.389, "timestamp": "04:31:01", "text": "あなたは私たちの"}, {"type": "subtitle", "time": 16263.75, "timestamp": "04:31:03", "text": "番人。私たちの"}, {"type": "subtitle", "time": 16266.07, "timestamp": "04:31:06", "text": "自らの目で見守る番人。ほとんど"}, {"type": "subtitle", "time": 16267.83, "timestamp": "04:31:07", "text": "人々は"}, {"type": "subtitle", "time": 16269.75, "timestamp": "04:31:09", "text": "任命式。予定"}, {"type": "subtitle", "time": 16272.469, "timestamp": "04:31:12", "text": "式。あなたの説明によると、あなたは"}, {"type": "subtitle", "time": 16275.269, "timestamp": "04:31:15", "text": "かなり近いですね。センチネルの"}, {"type": "subtitle", "time": 16277.55, "timestamp": "04:31:17", "text": "指定された共振器は、"}, {"type": "subtitle", "time": 16280.63, "timestamp": "04:31:20", "text": "近接性。今のところ、その人は"}, {"type": "subtitle", "time": 16283.59, "timestamp": "04:31:23", "text": "ジェン・ジョエルの治安判事。誰が"}, {"type": "subtitle", "time": 16286.229, "timestamp": "04:31:26", "text": "デノの治安判事？"}, {"type": "subtitle", "time": 16291.03, "timestamp": "04:31:31", "text": "うわぁ。ちくしょう。それはきっとエリート層に違いない。"}, {"type": "subtitle", "time": 16293.91, "timestamp": "04:31:33", "text": "ああ、何が起こっているの？"}, {"type": "subtitle", "time": 16296.07, "timestamp": "04:31:36", "text": "ジェシアは危険な状況にあるかもしれない。ロボット、"}, {"type": "subtitle", "time": 16299.79, "timestamp": "04:31:39", "text": "お願いします。お願いします。さあ、行こう。戦い"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "戦闘時間。さあ行こう。"}, {"type": "subtitle", "time": 16315.309, "timestamp": "04:31:55", "text": "共鳴の瞬間。共振。ああ、"}, {"type": "subtitle", "time": 16317.07, "timestamp": "04:31:57", "text": "神。"}]
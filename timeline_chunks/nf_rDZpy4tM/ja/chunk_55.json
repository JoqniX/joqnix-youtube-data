[{"type": "subtitle", "time": 3311.79, "timestamp": "00:55:11", "text": "戻る。私は、"}, {"type": "subtitle", "time": 3314.47, "timestamp": "00:55:14", "text": "ひっくり返すと、コーナーにまっすぐ傾いてしまう"}, {"type": "subtitle", "time": 3318.63, "timestamp": "00:55:18", "text": "だって、私には全身像がないでしょ？それ"}, {"type": "subtitle", "time": 3331.43, "timestamp": "00:55:31", "text": "知る。うん、傾斜テルを連打する"}, {"type": "subtitle", "time": 3335.71, "timestamp": "00:55:35", "text": "コーナーがあります"}, {"type": "subtitle", "time": 3338.23, "timestamp": "00:55:38", "text": "フェッチ。どうしたの？まるで行き詰まっているみたい"}, {"type": "subtitle", "time": 3340.549, "timestamp": "00:55:40", "text": "読み込み中です。あれは何だったんだ？おお。あなた"}, {"type": "subtitle", "time": 3342.47, "timestamp": "00:55:42", "text": "G3がこの場所を運営しているのは本当にわかる。"}, {"type": "subtitle", "time": 3345.349, "timestamp": "00:55:45", "text": "はぁ？とにかく、参加できるのが楽しみです"}, {"type": "subtitle", "time": 3347.109, "timestamp": "00:55:47", "text": "G3だけど、妻がいなくなるのは寂しいな"}, {"type": "subtitle", "time": 3348.87, "timestamp": "00:55:48", "text": "そして6人の子供。そうそう。私は自分のものを持っていた"}, {"type": "subtitle", "time": 3350.15, "timestamp": "00:55:50", "text": "出発前に殺されたので、"}, {"type": "subtitle", "time": 3352.309, "timestamp": "00:55:52", "text": "悪い。わあ、それはとても賢いですね。そうします。"}, {"type": "subtitle", "time": 3353.67, "timestamp": "00:55:53", "text": "あまりにも。妻と子供を殺すつもりだ"}]
[{"type": "subtitle", "time": 4382.11, "timestamp": "01:13:02", "text": "どうやってやるつもり？"}, {"type": "subtitle", "time": 4385.11, "timestamp": "01:13:05", "text": "人々があなたのことを知ると、あなたは"}, {"type": "subtitle", "time": 4387.11, "timestamp": "01:13:07", "text": "家族向けの視聴者層を徐々に築き上げていきましょう。"}, {"type": "subtitle", "time": 4389.11, "timestamp": "01:13:09", "text": "ええ、まさにその通りです。"}, {"type": "subtitle", "time": 4391.149, "timestamp": "01:13:11", "text": "避けてくれてありがとう。"}, {"type": "subtitle", "time": 4406.31, "timestamp": "01:13:26", "text": "私の神のもとへ来てくれてありがとう。よし、"}, {"type": "subtitle", "time": 4408.07, "timestamp": "01:13:28", "text": "採用活動なんてくだらないことは全部やめろ"}, {"type": "subtitle", "time": 4417.8, "timestamp": "01:13:37", "text": "ああ、"}, {"type": "subtitle", "time": 4429.189, "timestamp": "01:13:49", "text": "神。ああ、くそ。わかった。ああ、これで終わりだ"}, {"type": "subtitle", "time": 4431.43, "timestamp": "01:13:51", "text": "あの偽物のドロドロしたもの。それはそうではなかったと思う"}, {"type": "subtitle", "time": 4435.03, "timestamp": "01:13:55", "text": "非常に長く続く。"}, {"type": "subtitle", "time": 4438.31, "timestamp": "01:13:58", "text": "何てことだ。こんにちは。あなたがいてくれて本当に良かった。"}]
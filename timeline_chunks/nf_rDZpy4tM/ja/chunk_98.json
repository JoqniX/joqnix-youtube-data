[{"type": "subtitle", "time": 5881.27, "timestamp": "01:38:01", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 5884.07, "timestamp": "01:38:04", "text": "[音楽]"}, {"type": "subtitle", "time": 5890.229, "timestamp": "01:38:10", "text": "何か止められることがあるはずだ"}, {"type": "subtitle", "time": 5893.189, "timestamp": "01:38:13", "text": "これ。"}, {"type": "subtitle", "time": 5894.95, "timestamp": "01:38:14", "text": "おい、あいつはクソ野郎だ"}, {"type": "subtitle", "time": 5897.91, "timestamp": "01:38:17", "text": "訓練演習の一環として。触らないで"}, {"type": "subtitle", "time": 5900.229, "timestamp": "01:38:20", "text": "あなた。"}, {"type": "subtitle", "time": 5909.189, "timestamp": "01:38:29", "text": "撃ち出す準備はできていると言っているだけです"}, {"type": "subtitle", "time": 5910.84, "timestamp": "01:38:30", "text": "ディスク。"}, {"type": "subtitle", "time": 5935.27, "timestamp": "01:38:55", "text": "さて、彼はどこへ行ったのだろうか？ああ、なんてことだ、彼は"}]
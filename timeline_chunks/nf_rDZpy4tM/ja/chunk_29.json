[{"type": "subtitle", "time": 1746.11, "timestamp": "00:29:06", "text": "外。はい。私には何もできない"}, {"type": "subtitle", "time": 1748.71, "timestamp": "00:29:08", "text": "する。あ、待って、待って、待って、待って。ドクター、あなたは"}, {"type": "subtitle", "time": 1750.75, "timestamp": "00:29:10", "text": "忘れた"}, {"type": "subtitle", "time": 1753.51, "timestamp": "00:29:13", "text": "何か。プラットフォームを作成できます"}, {"type": "subtitle", "time": 1756.7, "timestamp": "00:29:16", "text": "銃。指輪"}, {"type": "subtitle", "time": 1758.269, "timestamp": "00:29:18", "text": "[音楽]"}, {"type": "subtitle", "time": 1766.04, "timestamp": "00:29:26", "text": "それ。忘れていた"}, {"type": "subtitle", "time": 1773.97, "timestamp": "00:29:33", "text": "それ。はい、プラットフォームを作成できます"}, {"type": "subtitle", "time": 1776.59, "timestamp": "00:29:36", "text": "[音楽]"}, {"type": "subtitle", "time": 1780.43, "timestamp": "00:29:40", "text": "ガス。ああ、うまくいかなかった。わかった。私"}]
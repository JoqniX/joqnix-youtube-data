[{"type": "subtitle", "time": 1680.83, "timestamp": "00:28:00", "text": "何てことだ。それ"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "男。彼は「なんてこった」という感じだった。しないようにする"}, {"type": "subtitle", "time": 1686.31, "timestamp": "00:28:06", "text": "滑って底なしの穴に落ちて、"}, {"type": "subtitle", "time": 1693.35, "timestamp": "00:28:13", "text": "私にはこの件についてお手伝いできません。"}, {"type": "subtitle", "time": 1701.19, "timestamp": "00:28:21", "text": "よし、私たちはここにいる。やったぞ。"}, {"type": "subtitle", "time": 1721.47, "timestamp": "00:28:41", "text": "ここ？よし、これらの宝箱を手に入れよう"}, {"type": "subtitle", "time": 1732.95, "timestamp": "00:28:52", "text": "まだ解読していない何かがあるに違いない"}, {"type": "subtitle", "time": 1734.83, "timestamp": "00:28:54", "text": "または"}, {"type": "subtitle", "time": 1737.43, "timestamp": "00:28:57", "text": "何か。でも待って、試してみたいし"}]
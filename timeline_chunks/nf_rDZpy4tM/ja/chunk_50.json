[{"type": "subtitle", "time": 3000.309, "timestamp": "00:50:00", "text": "何回言ったか分からない"}, {"type": "subtitle", "time": 3004.15, "timestamp": "00:50:04", "text": "新兵。我慢する。"}, {"type": "subtitle", "time": 3006.87, "timestamp": "00:50:06", "text": "あなたは私たちに彼らを殺せと言った。ジャガイモ。私は"}, {"type": "subtitle", "time": 3009.51, "timestamp": "00:50:09", "text": "ただの愚かな門番だ。待って、君は"}, {"type": "subtitle", "time": 3012.79, "timestamp": "00:50:12", "text": "「ああ、そうだね」って投稿する。今投稿しました"}, {"type": "subtitle", "time": 3014.39, "timestamp": "00:50:14", "text": "はい、はい、はい。私は「待って、君は」と思った。"}, {"type": "subtitle", "time": 3017.67, "timestamp": "00:50:17", "text": "最後に投稿されました。待って、いつ投稿したの？"}, {"type": "subtitle", "time": 3020.23, "timestamp": "00:50:20", "text": "以前？待って、あなたは以前に投稿しましたが、"}, {"type": "subtitle", "time": 3021.309, "timestamp": "00:50:21", "text": "どうしたの"}, {"type": "subtitle", "time": 3024.39, "timestamp": "00:50:24", "text": "では、どのように変化したのでしょうか？聞こうと思ってたんだけど"}, {"type": "subtitle", "time": 3032.71, "timestamp": "00:50:32", "text": "ドラッグタウンで楽しんでね。なれ"}, {"type": "subtitle", "time": 3034.95, "timestamp": "00:50:34", "text": "注意深い。そこにはG3の連中がたくさんいて"}, {"type": "subtitle", "time": 3038.71, "timestamp": "00:50:38", "text": "彼らは少しばかり発砲癖がある。消え失せろ。"}, {"type": "subtitle", "time": 3041.51, "timestamp": "00:50:41", "text": "おお、ドラッグタウンに行くの？その"}, {"type": "subtitle", "time": 3044.549, "timestamp": "00:50:44", "text": "オールドタウンよりずっとクール。オールドタウンは"}, {"type": "subtitle", "time": 3046.069, "timestamp": "00:50:46", "text": "退屈なゴミ捨て場。あなたに言っておきたいのは"}, {"type": "subtitle", "time": 3049.27, "timestamp": "00:50:49", "text": "多くの。私はオールドタウンが大嫌いだ。私はただ立っている"}, {"type": "subtitle", "time": 3050.87, "timestamp": "00:50:50", "text": "この辺りでは、人々にどれだけ"}, {"type": "subtitle", "time": 3052.87, "timestamp": "00:50:52", "text": "オールドタウンは最悪だ。それが私の仕事です。それは"}, {"type": "subtitle", "time": 3054.79, "timestamp": "00:50:54", "text": "それが私のクールさ。それが私が"}, {"type": "subtitle", "time": 3057.91, "timestamp": "00:50:57", "text": "興奮するよ。なぜ持っていないのですか"}]
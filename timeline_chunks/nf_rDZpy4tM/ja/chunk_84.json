[{"type": "subtitle", "time": 5043.03, "timestamp": "01:24:03", "text": "コミュニティの権利 そしてその部分が"}, {"type": "subtitle", "time": 5046.39, "timestamp": "01:24:06", "text": "コミュニティを維持すること、そして"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "ええ、コミュニティを維持するために"}, {"type": "subtitle", "time": 5051.51, "timestamp": "01:24:11", "text": "それは、永続的な効果があります。"}, {"type": "subtitle", "time": 5054.31, "timestamp": "01:24:14", "text": "まるで永遠に続くみたいだから"}, {"type": "subtitle", "time": 5056.31, "timestamp": "01:24:16", "text": "次のようなコミュニティがあります"}, {"type": "subtitle", "time": 5058.31, "timestamp": "01:24:18", "text": "別れる、別れる意味"}, {"type": "subtitle", "time": 5061.75, "timestamp": "01:24:21", "text": "それらは、えっと、何のように切り離すことができますか？"}, {"type": "subtitle", "time": 5063.51, "timestamp": "01:24:23", "text": "それって何？例が何なのかわかりません"}, {"type": "subtitle", "time": 5066.31, "timestamp": "01:24:26", "text": "例えば、あなたが何かをしたとしましょう。"}, {"type": "subtitle", "time": 5068.47, "timestamp": "01:24:28", "text": "雲を追いかけるようなもの、あるいは"}, {"type": "subtitle", "time": 5069.99, "timestamp": "01:24:29", "text": "ドラマにハマって"}, {"type": "subtitle", "time": 5072.79, "timestamp": "01:24:32", "text": "すべて、そしてあなたのコミュニティはもっと好きです"}, {"type": "subtitle", "time": 5074.229, "timestamp": "01:24:34", "text": "あなたのコミュニティの半分はあなたを嫌っています、または"}, {"type": "subtitle", "time": 5076.709, "timestamp": "01:24:36", "text": "何か正しいことがあれば、あなたのコミュニティは"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "片方があなたを憎むようになる"}, {"type": "subtitle", "time": 5082.59, "timestamp": "01:24:42", "text": "片側は知っているが"}, {"type": "subtitle", "time": 5086.629, "timestamp": "01:24:46", "text": "彼らはあなたが間違ったことをしたと知っている"}, {"type": "subtitle", "time": 5089.669, "timestamp": "01:24:49", "text": "しかし彼らは依然として人間として"}, {"type": "subtitle", "time": 5092.229, "timestamp": "01:24:52", "text": "彼らはあなたをサポートし、"}, {"type": "subtitle", "time": 5093.83, "timestamp": "01:24:53", "text": "変更したり、"}, {"type": "subtitle", "time": 5096.149, "timestamp": "01:24:56", "text": "そうですよね？ 2つの異なる部分。あなたはできる"}, {"type": "subtitle", "time": 5099.39, "timestamp": "01:24:59", "text": "インターネットのほとんどでこれを見てください"}]
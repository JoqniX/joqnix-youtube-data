[{"type": "subtitle", "time": 2340.71, "timestamp": "00:39:00", "text": "[音楽]"}, {"type": "subtitle", "time": 2342.15, "timestamp": "00:39:02", "text": "私にはそんな体力はない"}, {"type": "subtitle", "time": 2345.1, "timestamp": "00:39:05", "text": "くそっ。"}, {"type": "subtitle", "time": 2347.589, "timestamp": "00:39:07", "text": "[音楽]"}, {"type": "subtitle", "time": 2349.43, "timestamp": "00:39:09", "text": "このゲームでまた誰を殺せばいいの？"}, {"type": "subtitle", "time": 2350.67, "timestamp": "00:39:10", "text": "場所、"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "この街を彩ろう。どんな色でも"}, {"type": "subtitle", "time": 2368.39, "timestamp": "00:39:28", "text": "ああ、無限にすることもできるよ。聖なる"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "クソッ。"}, {"type": "subtitle", "time": 2388.63, "timestamp": "00:39:48", "text": "戻ってくる。ああ、私は死んだ。わかった。"}, {"type": "subtitle", "time": 2390.069, "timestamp": "00:39:50", "text": "よし。物事はそう見える。調子はどうですか？"}, {"type": "subtitle", "time": 2392.95, "timestamp": "00:39:52", "text": "君か、ジョック？元気です。私たちのおかげで、"}, {"type": "subtitle", "time": 2396.39, "timestamp": "00:39:56", "text": "あなたが知っている。そして、なぜケニーが"}, {"type": "subtitle", "time": 2399.829, "timestamp": "00:39:59", "text": "顔が消えた。ケニーに何があったの？"}]
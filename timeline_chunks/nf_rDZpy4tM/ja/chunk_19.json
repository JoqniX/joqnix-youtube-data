[{"type": "subtitle", "time": 1174.71, "timestamp": "00:19:34", "text": "待って、どこに行けばいいの？はい、以上です"}, {"type": "subtitle", "time": 1177.07, "timestamp": "00:19:37", "text": "そこには。来る"}, {"type": "subtitle", "time": 1179.51, "timestamp": "00:19:39", "text": "ここ。私の右クリック。ああ、なんてことだ、私の"}, {"type": "subtitle", "time": 1195.59, "timestamp": "00:19:55", "text": "いいえ。それが来たとき、あなたは"}]
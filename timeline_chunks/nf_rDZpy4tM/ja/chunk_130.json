[{"type": "subtitle", "time": 7800.87, "timestamp": "02:10:00", "text": "私たちの顔。やるだけ。あいつを撃ち殺せ。"}, {"type": "subtitle", "time": 7803.189, "timestamp": "02:10:03", "text": "いや、やめておいた方がいい。パズルを解くだけで、"}, {"type": "subtitle", "time": 7805.669, "timestamp": "02:10:05", "text": "お願い、私のために。みんなと同じように、ねえ、私は"}, {"type": "subtitle", "time": 7808.39, "timestamp": "02:10:08", "text": "ジュピー博士を撃たない。私たちは、私たちは、博士が大好きです。"}, {"type": "subtitle", "time": 7810.709, "timestamp": "02:10:10", "text": "ジュピー。ありがとう。ありがとう。あなたは何を"}, {"type": "subtitle", "time": 7812.55, "timestamp": "02:10:12", "text": "みんなはそう言ってる？彼を撃つべきか、それとも"}, {"type": "subtitle", "time": 7814.87, "timestamp": "02:10:14", "text": "ない？"}, {"type": "subtitle", "time": 7818.709, "timestamp": "02:10:18", "text": "彼は姓を変えたと言った"}, {"type": "subtitle", "time": 7821.91, "timestamp": "02:10:21", "text": "たくさん、兄弟姉妹はたくさん名前を挙げる。いや、いや。彼の"}, {"type": "subtitle", "time": 7823.31, "timestamp": "02:10:23", "text": "息子の名前"}, {"type": "subtitle", "time": 7826.87, "timestamp": "02:10:26", "text": "多く。ええ、つまり、子供ってたくさんの名前をつけるよね。三つ"}, {"type": "subtitle", "time": 7828.109, "timestamp": "02:10:28", "text": "その倍"}, {"type": "subtitle", "time": 7831.51, "timestamp": "02:10:31", "text": "Gはそれを見ていた。私は、"}, {"type": "subtitle", "time": 7833.51, "timestamp": "02:10:33", "text": "彼を撃つんだ、だろ？"}, {"type": "subtitle", "time": 7836.55, "timestamp": "02:10:36", "text": "一体何なんだ。お前らバカどもめ。どうやって"}, {"type": "subtitle", "time": 7840.31, "timestamp": "02:10:40", "text": "お前はクソ野郎だ。彼だった。何てことだ。はい、"}, {"type": "subtitle", "time": 7842.069, "timestamp": "02:10:42", "text": "知ったかぶり。俺たちはこの問題を解決した、"}, {"type": "subtitle", "time": 7844.629, "timestamp": "02:10:44", "text": "あまりにも。私たちは賢い。良いチームだ。よし、これ"}, {"type": "subtitle", "time": 7847.03, "timestamp": "02:10:47", "text": "死体がその部屋に何か持ち込まれた。さあ"}, {"type": "subtitle", "time": 7849.27, "timestamp": "02:10:49", "text": "それに従ってください。ああ、大変だ。彼だった。ああ、"}, {"type": "subtitle", "time": 7852.55, "timestamp": "02:10:52", "text": "神。それはダグラス本人だった。何てことだ、"}, {"type": "subtitle", "time": 7855.43, "timestamp": "02:10:55", "text": "あのガキめ。えっと、待って、私たちは彼を殺したの？"}, {"type": "subtitle", "time": 7858.149, "timestamp": "02:10:58", "text": "右？さらに長く？あなたたちは"}]
[{"type": "subtitle", "time": 9480.469, "timestamp": "02:38:00", "text": "あなたが望むでしょう。"}, {"type": "subtitle", "time": 9482.51, "timestamp": "02:38:02", "text": "それは長いですか"}, {"type": "subtitle", "time": 9486.55, "timestamp": "02:38:06", "text": "乗る？退屈じゃないの？"}, {"type": "subtitle", "time": 9488.389, "timestamp": "02:38:08", "text": "あなた自身もその人間保護区を訪れることができます。"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "ところで、私たちは正確には知りません"}, {"type": "subtitle", "time": 9491.67, "timestamp": "02:38:11", "text": "人間を快適にしますが、"}, {"type": "subtitle", "time": 9509.11, "timestamp": "02:38:29", "text": "ああ、うまくいったんだね？待って、なぜ私はできないの？"}, {"type": "subtitle", "time": 9510.95, "timestamp": "02:38:30", "text": "動きを止める？"}, {"type": "subtitle", "time": 9514.07, "timestamp": "02:38:34", "text": "彼らが見つけるまでG3。ええ、それだけではありません。"}, {"type": "subtitle", "time": 9516.389, "timestamp": "02:38:36", "text": "彼は私たちに人類を救う方法を与えてくれた。神"}, {"type": "subtitle", "time": 9519.59, "timestamp": "02:38:39", "text": "くそ、君はそれを理解したんだね。これほど便利なものはない"}, {"type": "subtitle", "time": 9521.11, "timestamp": "02:38:41", "text": "私が賞金首だった時にこんなことが起こったことがあるだろうか"}, {"type": "subtitle", "time": 9524.469, "timestamp": "02:38:44", "text": "狩猟。ねえ、そういえば、"}, {"type": "subtitle", "time": 9525.99, "timestamp": "02:38:45", "text": "帰る前にジェットパックを手に入れろ"}, {"type": "subtitle", "time": 9527.67, "timestamp": "02:38:47", "text": "現場へ。本当に行くの？"}, {"type": "subtitle", "time": 9529.67, "timestamp": "02:38:49", "text": "それが必要になる。質屋へ向かってください"}, {"type": "subtitle", "time": 9531.51, "timestamp": "02:38:51", "text": "お店に行って、在庫があるかどうか確認してみてください。"}, {"type": "subtitle", "time": 9533.11, "timestamp": "02:38:53", "text": "ああ、そうそう、連絡してみるといいかも"}, {"type": "subtitle", "time": 9535.19, "timestamp": "02:38:55", "text": "ボルトシェフの屋台も出店しています。彼女は少し"}, {"type": "subtitle", "time": 9537.429, "timestamp": "02:38:57", "text": "怪しいけど、あの戦争ディスクは"}]
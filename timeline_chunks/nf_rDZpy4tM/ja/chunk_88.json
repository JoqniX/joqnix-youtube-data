[{"type": "subtitle", "time": 5281.03, "timestamp": "01:28:01", "text": "いいね、いいね、うん、うん"}, {"type": "subtitle", "time": 5284.47, "timestamp": "01:28:04", "text": "うんうんうん、作ったよ、それから私は"}, {"type": "subtitle", "time": 5288.51, "timestamp": "01:28:08", "text": "しばらくの間、友人がモデレーターを務める"}, {"type": "subtitle", "time": 5292.229, "timestamp": "01:28:12", "text": "そして彼らは去ったので私は対処しなければならなかった"}, {"type": "subtitle", "time": 5294.91, "timestamp": "01:28:14", "text": "その他すべて"}, {"type": "subtitle", "time": 5297.03, "timestamp": "01:28:17", "text": "旧バージョンではなかったと思う"}, {"type": "subtitle", "time": 5298.99, "timestamp": "01:28:18", "text": "いい結果。"}, {"type": "subtitle", "time": 5332.189, "timestamp": "01:28:52", "text": "ああ、この男は電気ショック装置を持っている。何が"}, {"type": "subtitle", "time": 5335.26, "timestamp": "01:28:55", "text": "この刃？"}, {"type": "subtitle", "time": 5339.43, "timestamp": "01:28:59", "text": "[音楽]"}]
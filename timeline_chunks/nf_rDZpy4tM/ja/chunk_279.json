[{"type": "subtitle", "time": 16741.709, "timestamp": "04:39:01", "text": "はぁ？私"}, {"type": "subtitle", "time": 16743.46, "timestamp": "04:39:03", "text": "何が"}, {"type": "subtitle", "time": 16752.189, "timestamp": "04:39:12", "text": "[音楽]"}, {"type": "subtitle", "time": 16755.67, "timestamp": "04:39:15", "text": "ハプニング。おっしゃる通りです。そうみたいです。"}, {"type": "subtitle", "time": 16758.869, "timestamp": "04:39:18", "text": "ええ、彼女はとてもエネルギッシュで"}, {"type": "subtitle", "time": 16761.91, "timestamp": "04:39:21", "text": "超大規模なチーム。彼女はなぜこんなにかわいいのか"}, {"type": "subtitle", "time": 16763.429, "timestamp": "04:39:23", "text": "自分？"}, {"type": "subtitle", "time": 16764.949, "timestamp": "04:39:24", "text": "私は彼女をずっと見守ってきた"}, {"type": "subtitle", "time": 16767.51, "timestamp": "04:39:27", "text": "流れを通しての状態。"}, {"type": "subtitle", "time": 16780.19, "timestamp": "04:39:40", "text": "バハはあなたの"}, {"type": "subtitle", "time": 16782.55, "timestamp": "04:39:42", "text": "状態。彼女は私たちがそうすべきではないと考えているに違いない"}, {"type": "subtitle", "time": 16784.948, "timestamp": "04:39:44", "text": "そんなに自由に動き回れるようにする"}, {"type": "subtitle", "time": 16788.27, "timestamp": "04:39:48", "text": "彼は意識を取り戻したばかりだから。"}, {"type": "subtitle", "time": 16790.27, "timestamp": "04:39:50", "text": "ああ、"}, {"type": "subtitle", "time": 16794.75, "timestamp": "04:39:54", "text": "わかった。なぜ彼女は5点に見えるのか"}, {"type": "subtitle", "time": 16797.75, "timestamp": "04:39:57", "text": "星？私は大丈夫です。"}]
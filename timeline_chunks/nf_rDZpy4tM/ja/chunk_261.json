[{"type": "subtitle", "time": 15660.349, "timestamp": "04:21:00", "text": "なぜ？皆さんは"}, {"type": "subtitle", "time": 15664.229, "timestamp": "04:21:04", "text": "自分。待って、何が起こっているのか"}, {"type": "subtitle", "time": 15666.83, "timestamp": "04:21:06", "text": "彼女？彼女は"}, {"type": "subtitle", "time": 15675.469, "timestamp": "04:21:15", "text": "なぜ？なぜ手放すのか？なぜ最後なのか"}, {"type": "subtitle", "time": 15686.87, "timestamp": "04:21:26", "text": "いや、波だよ。"}, {"type": "subtitle", "time": 15689.91, "timestamp": "04:21:29", "text": "何てことだ。ああ、これをありがとう"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "もの。ああ、ありがとうございます。ありがとう。感謝"}, {"type": "subtitle", "time": 15692.95, "timestamp": "04:21:32", "text": "あなた。ありがとう。ありがとう。私はただ"}, {"type": "subtitle", "time": 15713.149, "timestamp": "04:21:53", "text": "おお。それは"}]
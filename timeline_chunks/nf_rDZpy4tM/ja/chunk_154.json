[{"type": "subtitle", "time": 9242.309, "timestamp": "02:34:02", "text": "クラグ・ナグマン、ブリム市判事。として"}, {"type": "subtitle", "time": 9244.389, "timestamp": "02:34:04", "text": "皆さんもご存知の通り、私は一生懸命に"}, {"type": "subtitle", "time": 9246.389, "timestamp": "02:34:06", "text": "犯罪と麻薬を私たちの"}, {"type": "subtitle", "time": 9248.79, "timestamp": "02:34:08", "text": "通り。最初に認めますが、"}, {"type": "subtitle", "time": 9250.469, "timestamp": "02:34:10", "text": "戦いにおいてあまり進展が見られない"}, {"type": "subtitle", "time": 9252.63, "timestamp": "02:34:12", "text": "G3カルテルに対抗して。よし、それでは"}, {"type": "subtitle", "time": 9254.55, "timestamp": "02:34:14", "text": "次の部分に注目してください。すべては"}, {"type": "subtitle", "time": 9256.87, "timestamp": "02:34:16", "text": "変化。大胆な懸賞金について知りました"}, {"type": "subtitle", "time": 9259.429, "timestamp": "02:34:19", "text": "勇敢にもこのG3を撃ってきたハンター"}, {"type": "subtitle", "time": 9261.51, "timestamp": "02:34:21", "text": "問題を自分たちの手に委ねる。聞こえますか"}, {"type": "subtitle", "time": 9263.83, "timestamp": "02:34:23", "text": "それ？彼はあなたのことを言っているんですよ。彼らは"}, {"type": "subtitle", "time": 9265.75, "timestamp": "02:34:25", "text": "すでにカルテルの2人を始末した"}, {"type": "subtitle", "time": 9268.07, "timestamp": "02:34:28", "text": "最も権力のある将校たち。うん、君は"}, {"type": "subtitle", "time": 9271.429, "timestamp": "02:34:31", "text": "ラッキー。私はあまり自慢はしません。"}, {"type": "subtitle", "time": 9273.83, "timestamp": "02:34:33", "text": "でも、でも、そうすると"}, {"type": "subtitle", "time": 9275.67, "timestamp": "02:34:35", "text": "聴いている方は、ぜひご参加ください"}, {"type": "subtitle", "time": 9277.59, "timestamp": "02:34:37", "text": "ブリムの善良な人々と共に"}, {"type": "subtitle", "time": 9279.59, "timestamp": "02:34:39", "text": "市。あなたが来てくれることを願っています"}, {"type": "subtitle", "time": 9281.75, "timestamp": "02:34:41", "text": "前進して私と直接会いましょう"}, {"type": "subtitle", "time": 9283.51, "timestamp": "02:34:43", "text": "市役所にある私のオフィス。なんてこった。"}, {"type": "subtitle", "time": 9285.59, "timestamp": "02:34:45", "text": "彼に会いに行くべきでしょうか？私はすでに彼に伝えた"}, {"type": "subtitle", "time": 9289.19, "timestamp": "02:34:49", "text": "あなたが行く。何？いや、始めないで。私を信じて、"}, {"type": "subtitle", "time": 9291.67, "timestamp": "02:34:51", "text": "彼は本物だ。この男はG3に反対している"}, {"type": "subtitle", "time": 9293.429, "timestamp": "02:34:53", "text": "あなたたちが生まれる前から"}, {"type": "subtitle", "time": 9295.51, "timestamp": "02:34:55", "text": "おむつ。正直、私にはわからない"}, {"type": "subtitle", "time": 9298.15, "timestamp": "02:34:58", "text": "ガトリン犬はオムツも履く。通り抜ける"}]
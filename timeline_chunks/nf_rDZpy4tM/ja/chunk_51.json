[{"type": "subtitle", "time": 3061.109, "timestamp": "00:51:01", "text": "他に何かすることありますか？"}, {"type": "subtitle", "time": 3063.43, "timestamp": "00:51:03", "text": "G3に加入する予定ですか？あなたは"}, {"type": "subtitle", "time": 3065.67, "timestamp": "00:51:05", "text": "厳しい。きっと彼らは誰かを欲しがるだろう"}, {"type": "subtitle", "time": 3067.51, "timestamp": "00:51:07", "text": "あなたのような。"}, {"type": "subtitle", "time": 3089.03, "timestamp": "00:51:29", "text": "ジャンプできるとは思えない。"}, {"type": "subtitle", "time": 3091.829, "timestamp": "00:51:31", "text": "G3はドラッグタウンを本当に魅力的にしてくれた。あなた"}, {"type": "subtitle", "time": 3093.67, "timestamp": "00:51:33", "text": "あそこでは欲しいものは何でも手に入る。"}, {"type": "subtitle", "time": 3097.19, "timestamp": "00:51:37", "text": "薬物、もちろん。セックス。はい。これらは"}, {"type": "subtitle", "time": 3098.95, "timestamp": "00:51:38", "text": "思いつくのは2つだけだった。おお、"}, {"type": "subtitle", "time": 3101.589, "timestamp": "00:51:41", "text": "待って。ノートパソコン。ノートパソコンを入手できます。私"}, {"type": "subtitle", "time": 3105.43, "timestamp": "00:51:45", "text": "ベット。薬物。ノートパソコン。そこはドラッグタウンだ、"}, {"type": "subtitle", "time": 3119.549, "timestamp": "00:51:59", "text": "彼女は、ああ、それは"}]
[{"type": "subtitle", "time": 8401.59, "timestamp": "02:20:01", "text": "知ってるよ、そのタイムバブルは"}, {"type": "subtitle", "time": 8404.95, "timestamp": "02:20:04", "text": "G3も同様です。そしてバブルをロードしてみてください"}, {"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "結晶。私たちは良いチームになるだろう。"}, {"type": "subtitle", "time": 8414.23, "timestamp": "02:20:14", "text": "感じるよ。すべてを聞いてください"}, {"type": "subtitle", "time": 8416.389, "timestamp": "02:20:16", "text": "そう言うんだ。"}, {"type": "subtitle", "time": 8420.75, "timestamp": "02:20:20", "text": "ゴミ袋だよ、ベイビー。 N 屁"}, {"type": "subtitle", "time": 8423.349, "timestamp": "02:20:23", "text": "自由にオナラをする男。特に何も"}, {"type": "subtitle", "time": 8425.51, "timestamp": "02:20:25", "text": "特別。それほど面白くもない。うん、"}, {"type": "subtitle", "time": 8427.75, "timestamp": "02:20:27", "text": "彼は実際、いつもおならをする"}, {"type": "subtitle", "time": 8430.71, "timestamp": "02:20:30", "text": "常に。彼はそれをする 彼はそれをする"}, {"type": "subtitle", "time": 8432.79, "timestamp": "02:20:32", "text": "目的もまた。彼は彼を押し出す"}, {"type": "subtitle", "time": 8435.75, "timestamp": "02:20:35", "text": "彼がやらなくていいとき、やらなければならない。"}, {"type": "subtitle", "time": 8438.15, "timestamp": "02:20:38", "text": "彼は病気だ。彼は頭がおかしい。"}, {"type": "subtitle", "time": 8445.91, "timestamp": "02:20:45", "text": "こんにちは。"}, {"type": "subtitle", "time": 8448.63, "timestamp": "02:20:48", "text": "殺そうとするのはやめろ。さて、次はどうなるのでしょうか？"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "懸賞金はどこかに届けなければならない。行って"}, {"type": "subtitle", "time": 8453.27, "timestamp": "02:20:53", "text": "それ。これで終わりにしましょう。また、その前に"}, {"type": "subtitle", "time": 8454.71, "timestamp": "02:20:54", "text": "懸賞金を渡す必要がある"}, {"type": "subtitle", "time": 8458.67, "timestamp": "02:20:58", "text": "確かに全部手に入れたよ"}]
[{"type": "subtitle", "time": 8827.15, "timestamp": "02:27:07", "text": "旅行？そこにいる"}, {"type": "subtitle", "time": 8829.71, "timestamp": "02:27:09", "text": "行く。"}, {"type": "subtitle", "time": 8845.91, "timestamp": "02:27:25", "text": "ああ、このスライド大好き。"}, {"type": "subtitle", "time": 8854.87, "timestamp": "02:27:34", "text": "また？うん。うん。うん。私は手に入れる必要がある"}, {"type": "subtitle", "time": 8861.59, "timestamp": "02:27:41", "text": "右？紹介するまでもない人もいる。"}]
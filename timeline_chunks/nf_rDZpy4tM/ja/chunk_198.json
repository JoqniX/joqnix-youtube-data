[{"type": "subtitle", "time": 11880.99, "timestamp": "03:18:00", "text": "最も人気のあるタレントを擁するエージェンシー"}, {"type": "subtitle", "time": 11885.07, "timestamp": "03:18:05", "text": "名前は忘れたけど"}, {"type": "subtitle", "time": 11892.03, "timestamp": "03:18:12", "text": "ああ、でも"}, {"type": "subtitle", "time": 11895.469, "timestamp": "03:18:15", "text": "うん、それいいよね。"}, {"type": "subtitle", "time": 11902.19, "timestamp": "03:18:22", "text": "自分たちの"}, {"type": "subtitle", "time": 11905.349, "timestamp": "03:18:25", "text": "うん、そうだね。 United Talent.comそれから"}, {"type": "subtitle", "time": 11907.83, "timestamp": "03:18:27", "text": "ユナイテッド・タレントはその一つです。その"}, {"type": "subtitle", "time": 11910.11, "timestamp": "03:18:30", "text": "才能のように"}, {"type": "subtitle", "time": 11912.349, "timestamp": "03:18:32", "text": "探しています。うん。うん。"}, {"type": "subtitle", "time": 11915.429, "timestamp": "03:18:35", "text": "うん。一種の代理店みたいな感じ。いいえ、"}, {"type": "subtitle", "time": 11919.389, "timestamp": "03:18:39", "text": "まるで専属マネージャーをつけてくれるようなものだ"}, {"type": "subtitle", "time": 11923.83, "timestamp": "03:18:43", "text": "自分の目的のためのものなど、そういう類のもの"}, {"type": "subtitle", "time": 11926.59, "timestamp": "03:18:46", "text": "そう、UTA、それがUTAだ"}, {"type": "subtitle", "time": 11929.59, "timestamp": "03:18:49", "text": "そうです。だから、最も音楽的な"}, {"type": "subtitle", "time": 11932.469, "timestamp": "03:18:52", "text": "アーティストは人々が到達できるようにそれを持っている"}, {"type": "subtitle", "time": 11933.91, "timestamp": "03:18:53", "text": "アウトとコラボレーションブランドは"}, {"type": "subtitle", "time": 11936.71, "timestamp": "03:18:56", "text": "協力して"}, {"type": "subtitle", "time": 11939.07, "timestamp": "03:18:59", "text": "代理店に連絡を取る"}]
[{"type": "subtitle", "time": 16982.39, "timestamp": "04:43:02", "text": "わかった。ああ、そんな感じ。円ですよね？"}, {"type": "subtitle", "time": 16992.43, "timestamp": "04:43:12", "text": "それ。ああ、これはゲームだ"}, {"type": "subtitle", "time": 17003.03, "timestamp": "04:43:23", "text": "このゲームは何なんだ？"}, {"type": "subtitle", "time": 17018.59, "timestamp": "04:43:38", "text": "私はショットを打っているような感じなので"}, {"type": "subtitle", "time": 17022.55, "timestamp": "04:43:42", "text": "良い。ショットがすごくよく決まる。"}, {"type": "subtitle", "time": 17028.43, "timestamp": "04:43:48", "text": "彼は死んだ"}, {"type": "subtitle", "time": 17030.03, "timestamp": "04:43:50", "text": "それから。"}, {"type": "subtitle", "time": 17032.15, "timestamp": "04:43:52", "text": "ニース。私は待たなければならない"}]
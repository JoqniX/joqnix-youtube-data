[{"type": "subtitle", "time": 15241.11, "timestamp": "04:14:01", "text": "元気かい？調子はどう？私は私は"}, {"type": "subtitle", "time": 15243.83, "timestamp": "04:14:03", "text": "まあ、VIPみたいな感じかな"}, {"type": "subtitle", "time": 15246.55, "timestamp": "04:14:06", "text": "ここ。 VIPの方。乳母。みんな、見て。"}, {"type": "subtitle", "time": 15250.55, "timestamp": "04:14:10", "text": "緑色のピングが出ています。何てことだ。ああは"}, {"type": "subtitle", "time": 15253.83, "timestamp": "04:14:13", "text": "インドの人々に緑色のピングを与える。何？"}, {"type": "subtitle", "time": 15257.03, "timestamp": "04:14:17", "text": "78. あれが見えますか？あれ、分かりますか？分かりますか"}, {"type": "subtitle", "time": 15258.87, "timestamp": "04:14:18", "text": "それ？緑色のピング音。先ほども言いました。分かりますか"}, {"type": "subtitle", "time": 15263.189, "timestamp": "04:14:23", "text": "それ？緑色のピングです。そして、"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "私たちはアジアに行く。うん。必要ない"}, {"type": "subtitle", "time": 15267.75, "timestamp": "04:14:27", "text": "アジアへ行く。"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "SCAを選びましょう。"}, {"type": "subtitle", "time": 15273.11, "timestamp": "04:14:33", "text": "何てことだ。高速鉄道は1本あります。あなたはまだ"}, {"type": "subtitle", "time": 15280.71, "timestamp": "04:14:40", "text": "はい、私も緑色を持っています。知っている、"}, {"type": "subtitle", "time": 15282.87, "timestamp": "04:14:42", "text": "右？"}, {"type": "subtitle", "time": 15285.03, "timestamp": "04:14:45", "text": "セロたちは忙しいからかもしれない。"}, {"type": "subtitle", "time": 15288.389, "timestamp": "04:14:48", "text": "sは忙しいか何かでしょう。だから私は"}, {"type": "subtitle", "time": 15292.51, "timestamp": "04:14:52", "text": "ウサギを殺さなかった。彼はただ彼が手に入れた"}, {"type": "subtitle", "time": 15297.349, "timestamp": "04:14:57", "text": "犠牲になった。大丈夫。私が試してみます。"}, {"type": "subtitle", "time": 15299.67, "timestamp": "04:14:59", "text": "アカウントを変更したか何かした。"}]
[{"type": "subtitle", "time": 16800.15, "timestamp": "04:40:00", "text": "ここは話をする場所ではない。さあ"}, {"type": "subtitle", "time": 16818.75, "timestamp": "04:40:18", "text": "タイプ。おお"}, {"type": "subtitle", "time": 16822.03, "timestamp": "04:40:22", "text": "いいえ、奇妙なことは"}, {"type": "subtitle", "time": 16833.59, "timestamp": "04:40:33", "text": "うわ、うわ、うわ、うわ、うわ、うわ。所有"}, {"type": "subtitle", "time": 16841.59, "timestamp": "04:40:41", "text": "すばらしい。ねえ、どれくらいかかるの？待って、私は行く"}, {"type": "subtitle", "time": 16848.03, "timestamp": "04:40:48", "text": "ハロニア。ああ、"}, {"type": "subtitle", "time": 16851.83, "timestamp": "04:40:51", "text": "神。すみません。"}]
[{"type": "subtitle", "time": 13502.349, "timestamp": "03:45:02", "text": "彼らが"}, {"type": "subtitle", "time": 13505.91, "timestamp": "03:45:05", "text": "始めた、なんて言うんだっけ？彼らが"}, {"type": "subtitle", "time": 13507.63, "timestamp": "03:45:07", "text": "ズチ"}, {"type": "subtitle", "time": 13510.63, "timestamp": "03:45:10", "text": "そして私のフィードにセレスティアが現れて"}, {"type": "subtitle", "time": 13512.71, "timestamp": "03:45:12", "text": "私のTwitterにStarscapeが表示された"}, {"type": "subtitle", "time": 13513.95, "timestamp": "03:45:13", "text": "餌を与えて"}, {"type": "subtitle", "time": 13517.51, "timestamp": "03:45:17", "text": "私たち全員が楽しみにしていたもの"}, {"type": "subtitle", "time": 13520.309, "timestamp": "03:45:20", "text": "インド人企業系ユーチューバーがいる"}, {"type": "subtitle", "time": 13522.03, "timestamp": "03:45:22", "text": "YouTuber"}, {"type": "subtitle", "time": 13525.51, "timestamp": "03:45:25", "text": "そのような代理店。私は発見しました"}, {"type": "subtitle", "time": 13528.349, "timestamp": "03:45:28", "text": "タスクグループ。"}, {"type": "subtitle", "time": 13531.189, "timestamp": "03:45:31", "text": "ええ、つまり、あるかもしれないし、あるかもしれない"}, {"type": "subtitle", "time": 13533.83, "timestamp": "03:45:33", "text": "インドには他にもグループが存在する。あなた"}, {"type": "subtitle", "time": 13536.309, "timestamp": "03:45:36", "text": "深く掘り下げて好きにならないと分からない"}, {"type": "subtitle", "time": 13540.55, "timestamp": "03:45:40", "text": "検索するか、ランダムに表示される場合は、"}, {"type": "subtitle", "time": 13542.11, "timestamp": "03:45:42", "text": "右？"}, {"type": "subtitle", "time": 13544.55, "timestamp": "03:45:44", "text": "[音楽]"}, {"type": "subtitle", "time": 13546.66, "timestamp": "03:45:46", "text": "どうしたの？"}, {"type": "subtitle", "time": 13549.59, "timestamp": "03:45:49", "text": "[音楽]"}, {"type": "subtitle", "time": 13552.11, "timestamp": "03:45:52", "text": "何？何ですか"}, {"type": "subtitle", "time": 13559.95, "timestamp": "03:45:59", "text": "ええと、ある意味では、"}]
[{"type": "subtitle", "time": 1389.669, "timestamp": "00:23:09", "text": "ここは険しい道のりだよ、相棒。"}, {"type": "subtitle", "time": 1397.07, "timestamp": "00:23:17", "text": "シェード。私は"}, {"type": "subtitle", "time": 1415.4, "timestamp": "00:23:35", "text": "時間。もう一つの時間の宝箱。"}, {"type": "subtitle", "time": 1425.63, "timestamp": "00:23:45", "text": "この胸部にはかなりのものがある"}, {"type": "subtitle", "time": 1438.63, "timestamp": "00:23:58", "text": "旧市街はこの橋を渡ったすぐ先です。あなた"}]
[{"type": "subtitle", "time": 11941.75, "timestamp": "03:19:01", "text": "マネージャーがあなたに連絡します"}, {"type": "subtitle", "time": 11944.63, "timestamp": "03:19:04", "text": "ああ、なんて言うんだっけ、"}, {"type": "subtitle", "time": 11955.15, "timestamp": "03:19:15", "text": "[音楽]"}, {"type": "subtitle", "time": 11957.469, "timestamp": "03:19:17", "text": "えっと、彼らは"}, {"type": "subtitle", "time": 11959.19, "timestamp": "03:19:19", "text": "どうやって電話するの？"}, {"type": "subtitle", "time": 11961.389, "timestamp": "03:19:21", "text": "[音楽]"}, {"type": "subtitle", "time": 11964.67, "timestamp": "03:19:24", "text": "それ？うん。うん。そういうこと、"}, {"type": "subtitle", "time": 11967.349, "timestamp": "03:19:27", "text": "右？これから何が起こるのか"}, {"type": "subtitle", "time": 11970.469, "timestamp": "03:19:30", "text": "ジョー？わからない。でも、私はできるといいなと思っています"}, {"type": "subtitle", "time": 11973.469, "timestamp": "03:19:33", "text": "一年を通して考えていく。私"}, {"type": "subtitle", "time": 11977.67, "timestamp": "03:19:37", "text": "そう思う、そう思う、そう思う"}, {"type": "subtitle", "time": 11980.79, "timestamp": "03:19:40", "text": "ジョックとアディッシュも保護できます"}, {"type": "subtitle", "time": 11982.67, "timestamp": "03:19:42", "text": "アレックス。うん。それで"}, {"type": "subtitle", "time": 11985.67, "timestamp": "03:19:45", "text": "彼らは決して傷ついたり好きになったりすることはない"}, {"type": "subtitle", "time": 11986.59, "timestamp": "03:19:46", "text": "あなた"}, {"type": "subtitle", "time": 11990.229, "timestamp": "03:19:50", "text": "トラブルに巻き込まれたり、何か問題を起こしたりしないように。うん。"}, {"type": "subtitle", "time": 11992.63, "timestamp": "03:19:52", "text": "私はそういうことは知りません。うん。"}, {"type": "subtitle", "time": 11994.79, "timestamp": "03:19:54", "text": "でも、とにかく、さっきも言ったように、えーと"}, {"type": "subtitle", "time": 11997.91, "timestamp": "03:19:57", "text": "私の支援を認めてくれたということですよね？願っています"}]
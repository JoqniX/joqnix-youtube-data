[{"type": "subtitle", "time": 1026.23, "timestamp": "00:17:06", "text": "わかった。でも、私はそれらを自分のために使うことができます"}, {"type": "subtitle", "time": 1029.35, "timestamp": "00:17:09", "text": "アドバンテージ。吸うように、"}, {"type": "subtitle", "time": 1032.429, "timestamp": "00:17:12", "text": "それらを私のもとへ持ってきて、叩きのめしてください"}, {"type": "subtitle", "time": 1035.669, "timestamp": "00:17:15", "text": "あなたか何か。あなたに会えるのが待ちきれない"}, {"type": "subtitle", "time": 1037.669, "timestamp": "00:17:17", "text": "ドラァグタウンを見に行く。私は"}, {"type": "subtitle", "time": 1039.829, "timestamp": "00:17:19", "text": "数回試したところ、G3はチップスをくれました。"}, {"type": "subtitle", "time": 1041.99, "timestamp": "00:17:21", "text": "だから、実際には何もできなかった。それで、"}, {"type": "subtitle", "time": 1044.23, "timestamp": "00:17:24", "text": "楽しいのかどうか、正直よくわからない。"}, {"type": "subtitle", "time": 1045.35, "timestamp": "00:17:25", "text": "私の言っていること、分かりますよね？できないよ"}, {"type": "subtitle", "time": 1047.829, "timestamp": "00:17:27", "text": "私はドラッグタウンの評論家にはなれなかった。"}, {"type": "subtitle", "time": 1050.95, "timestamp": "00:17:30", "text": "本当に覚えていないし、知らない。"}, {"type": "subtitle", "time": 1053.43, "timestamp": "00:17:33", "text": "本当はドレッドタウンの話なんです。わからない。私"}, {"type": "subtitle", "time": 1061.95, "timestamp": "00:17:41", "text": "[音楽]"}, {"type": "subtitle", "time": 1064.87, "timestamp": "00:17:44", "text": "さようなら。もう教会はないのですか？"}, {"type": "subtitle", "time": 1072.12, "timestamp": "00:17:52", "text": "何？いいえ。これは非常に悪い大きな"}]
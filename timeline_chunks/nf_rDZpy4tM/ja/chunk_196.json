[{"type": "subtitle", "time": 11762.309, "timestamp": "03:16:02", "text": "そう、いいわね。でもとにかく私は"}, {"type": "subtitle", "time": 11765.07, "timestamp": "03:16:05", "text": "わかってるけど、うん、これ"}, {"type": "subtitle", "time": 11767.309, "timestamp": "03:16:07", "text": "旅を願う"}, {"type": "subtitle", "time": 11774.469, "timestamp": "03:16:14", "text": "誰にもそんなことを言ってほしくない"}, {"type": "subtitle", "time": 11776.79, "timestamp": "03:16:16", "text": "私の配信に来た人は、まるで新人みたい"}, {"type": "subtitle", "time": 11778.469, "timestamp": "03:16:18", "text": "そして、ああ、誰にも"}, {"type": "subtitle", "time": 11781.269, "timestamp": "03:16:21", "text": "私の配信に来て、私は「おお、スポーツマン」って感じ"}, {"type": "subtitle", "time": 11784.87, "timestamp": "03:16:24", "text": "Gavisのモデルをコピーしたの？"}, {"type": "subtitle", "time": 11786.71, "timestamp": "03:16:26", "text": "そんな感じ？私はそれを望んでいません。ええ、私は"}, {"type": "subtitle", "time": 11788.03, "timestamp": "03:16:28", "text": "怖い"}, {"type": "subtitle", "time": 11792.91, "timestamp": "03:16:32", "text": "それ。しかし、十分な"}, {"type": "subtitle", "time": 11796.19, "timestamp": "03:16:36", "text": "証拠？十分ありますか"}, {"type": "subtitle", "time": 11801.389, "timestamp": "03:16:41", "text": "自分の権利を主張するための証拠は？私はしません"}, {"type": "subtitle", "time": 11804.15, "timestamp": "03:16:44", "text": "知る。つまり、ジョー、あなたは"}, {"type": "subtitle", "time": 11806.79, "timestamp": "03:16:46", "text": "約12年間ストリーマーとして活動しています。"}, {"type": "subtitle", "time": 11808.07, "timestamp": "03:16:48", "text": "何か。両方にコンテンツがあります"}, {"type": "subtitle", "time": 11810.55, "timestamp": "03:16:50", "text": "TwitchとYouTube。"}, {"type": "subtitle", "time": 11812.63, "timestamp": "03:16:52", "text": "たくさんの配信をしました"}, {"type": "subtitle", "time": 11815.51, "timestamp": "03:16:55", "text": "それは証拠とみなせるでしょう？"}, {"type": "subtitle", "time": 11818.51, "timestamp": "03:16:58", "text": "うん。ある意味では、そうですね。"}]
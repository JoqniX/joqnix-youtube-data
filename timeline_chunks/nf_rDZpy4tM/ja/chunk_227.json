[{"type": "subtitle", "time": 13620.269, "timestamp": "03:47:00", "text": "ヘルプ。私には無理です"}, {"type": "subtitle", "time": 13624.429, "timestamp": "03:47:04", "text": "自分を気遣うように、または"}, {"type": "subtitle", "time": 13626.469, "timestamp": "03:47:06", "text": "それは何と呼ぶのでしょうか？何か情報はある？"}, {"type": "subtitle", "time": 13629.189, "timestamp": "03:47:09", "text": "自分を大切にする利己的なタイプの人"}, {"type": "subtitle", "time": 13632.11, "timestamp": "03:47:12", "text": "あれとか、"}, {"type": "subtitle", "time": 13635.51, "timestamp": "03:47:15", "text": "その助けを求める要求や嘆願を無視してください。"}, {"type": "subtitle", "time": 13637.67, "timestamp": "03:47:17", "text": "うん。わからない。私は、私は"}, {"type": "subtitle", "time": 13641.189, "timestamp": "03:47:21", "text": "それを実行するのは難しい。しかし、ある意味では"}, {"type": "subtitle", "time": 13644.71, "timestamp": "03:47:24", "text": "誰かが何かを必要としているなら、私はただ彼らを助けるだけです。"}, {"type": "subtitle", "time": 13652.229, "timestamp": "03:47:32", "text": "助けるというのは、これを手伝ってくださいという意味です。"}, {"type": "subtitle", "time": 13654.59, "timestamp": "03:47:34", "text": "それかこれを設定して"}, {"type": "subtitle", "time": 13656.83, "timestamp": "03:47:36", "text": "まるで"}, {"type": "subtitle", "time": 13659.389, "timestamp": "03:47:39", "text": "それ"}, {"type": "subtitle", "time": 13662.189, "timestamp": "03:47:42", "text": "サーシャと私"}, {"type": "subtitle", "time": 13665.03, "timestamp": "03:47:45", "text": "希望は、私の"}, {"type": "subtitle", "time": 13668.79, "timestamp": "03:47:48", "text": "プレート 私は信じていますし、まだできることを願っています"}, {"type": "subtitle", "time": 13676.389, "timestamp": "03:47:56", "text": "人々、そして最近は私は"}, {"type": "subtitle", "time": 13678.59, "timestamp": "03:47:58", "text": "無視してきた"}]
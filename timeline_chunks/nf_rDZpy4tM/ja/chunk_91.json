[{"type": "subtitle", "time": 5462.629, "timestamp": "01:31:02", "text": "何か。えっと、何か違反してないといいんだけど"}, {"type": "subtitle", "time": 5464.79, "timestamp": "01:31:04", "text": "配信者がこのことに言及している。つまり、それは"}, {"type": "subtitle", "time": 5466.79, "timestamp": "01:31:06", "text": "スタースケープについて言及したから、そうだよね？"}, {"type": "subtitle", "time": 5469.35, "timestamp": "01:31:09", "text": "バーチャルなものとか、そういうのもね。だから、大丈夫です。"}, {"type": "subtitle", "time": 5470.87, "timestamp": "01:31:10", "text": "大丈夫です。大丈夫。心配しないで。しないで"}, {"type": "subtitle", "time": 5472.59, "timestamp": "01:31:12", "text": "心配。心配しないで。"}, {"type": "subtitle", "time": 5476.07, "timestamp": "01:31:16", "text": "でも、そうですね、結構たくさん見てきました。"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "他の配信者について言及する人"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "私は彼らの名前は挙げません。覚えて"}, {"type": "subtitle", "time": 5482.11, "timestamp": "01:31:22", "text": "それらの"}, {"type": "subtitle", "time": 5485.189, "timestamp": "01:31:25", "text": "それらは配信ルールに違反しています。"}, {"type": "subtitle", "time": 5488.229, "timestamp": "01:31:28", "text": "つまり、なぜそれが"}, {"type": "subtitle", "time": 5490.87, "timestamp": "01:31:30", "text": "他のことを言及してはいけない理由のルール"}, {"type": "subtitle", "time": 5493.87, "timestamp": "01:31:33", "text": "ストリーマー、それは説明できない"}, {"type": "subtitle", "time": 5496.149, "timestamp": "01:31:36", "text": "一部と、ビデオもあると思います"}, {"type": "subtitle", "time": 5498.629, "timestamp": "01:31:38", "text": "正しく作られました。私はいくつかのビデオを見ました"}, {"type": "subtitle", "time": 5500.55, "timestamp": "01:31:40", "text": "人々が実際に健康でいてくれて嬉しいです"}, {"type": "subtitle", "time": 5502.47, "timestamp": "01:31:42", "text": "しかし、チューブに乗っている人たちは"}, {"type": "subtitle", "time": 5505.51, "timestamp": "01:31:45", "text": "実際にそれについてのビデオを作っている理由"}, {"type": "subtitle", "time": 5507.99, "timestamp": "01:31:47", "text": "他のことについて言及するのは良くない"}, {"type": "subtitle", "time": 5509.59, "timestamp": "01:31:49", "text": "配信者が話さない場合"}, {"type": "subtitle", "time": 5513.03, "timestamp": "01:31:53", "text": "それについて、トップとこのチャットのように"}, {"type": "subtitle", "time": 5517.03, "timestamp": "01:31:57", "text": "脱線していると思うし、私は"}, {"type": "subtitle", "time": 5519.669, "timestamp": "01:31:59", "text": "チームにはさまざまなストリーマーがいます"}]
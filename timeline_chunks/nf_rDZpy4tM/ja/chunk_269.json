[{"type": "subtitle", "time": 16141.51, "timestamp": "04:29:01", "text": "[音楽]"}, {"type": "subtitle", "time": 16151.67, "timestamp": "04:29:11", "text": "行く。彼女はちょっと可愛い。ああ、それは"}, {"type": "subtitle", "time": 16155.149, "timestamp": "04:29:15", "text": "大きなドラゴンの頭。"}, {"type": "subtitle", "time": 16157.269, "timestamp": "04:29:17", "text": "おお。ああ、あなたは"}, {"type": "subtitle", "time": 16159.59, "timestamp": "04:29:19", "text": "回想シーン。"}, {"type": "subtitle", "time": 16171.349, "timestamp": "04:29:31", "text": "これ？どうしたの？あなたは怪我をしましたか？"}, {"type": "subtitle", "time": 16174.51, "timestamp": "04:29:34", "text": "戦い？"}, {"type": "subtitle", "time": 16179.67, "timestamp": "04:29:39", "text": "ねえ、私、何か思い出した気がするの。"}, {"type": "subtitle", "time": 16184.229, "timestamp": "04:29:44", "text": "あなたは記憶の中で、私たちの番人の姿を見たのでしょう。"}, {"type": "subtitle", "time": 16186.55, "timestamp": "04:29:46", "text": "センチネル？"}, {"type": "subtitle", "time": 16190.309, "timestamp": "04:29:50", "text": "はい。私たちがこの像を建てたのは、"}, {"type": "subtitle", "time": 16193.91, "timestamp": "04:29:53", "text": "Jen Joe の Oracle Engine Sentinel。"}, {"type": "subtitle", "time": 16197.67, "timestamp": "04:29:57", "text": "ああ、Oracle Engine。香港の6都市"}]
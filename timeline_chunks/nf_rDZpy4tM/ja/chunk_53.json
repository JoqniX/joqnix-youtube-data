[{"type": "subtitle", "time": 3180.79, "timestamp": "00:53:00", "text": "ああ、よろめく。よし。それはただ"}, {"type": "subtitle", "time": 3182.95, "timestamp": "00:53:02", "text": "私は。仕方がないんです。さあ、"}, {"type": "subtitle", "time": 3185.589, "timestamp": "00:53:05", "text": "ビジネスを続けましょう。うん。"}, {"type": "subtitle", "time": 3187.51, "timestamp": "00:53:07", "text": "わかった。これは彼が"}, {"type": "subtitle", "time": 3189.99, "timestamp": "00:53:09", "text": "よし、これを買おう。"}, {"type": "subtitle", "time": 3192.87, "timestamp": "00:53:12", "text": "私の時間を無駄にした。"}, {"type": "subtitle", "time": 3195.349, "timestamp": "00:53:15", "text": "素晴らしい。ほかに何か？"}, {"type": "subtitle", "time": 3197.91, "timestamp": "00:53:17", "text": "ほかに何か？もっと何か欲しいの？ない"}, {"type": "subtitle", "time": 3205.51, "timestamp": "00:53:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3209.109, "timestamp": "00:53:29", "text": "だから今、彼が新しいスタッガーのアイテムを持っているなら"}, {"type": "subtitle", "time": 3217.75, "timestamp": "00:53:37", "text": "ああ、大変だ。大きな横向きのエレベーター"}, {"type": "subtitle", "time": 3219.19, "timestamp": "00:53:39", "text": "オリジナル。彼らがこれを持っていたのを知ってるよ"}, {"type": "subtitle", "time": 3221.549, "timestamp": "00:53:41", "text": "アキラでは、"}, {"type": "subtitle", "time": 3224.23, "timestamp": "00:53:44", "text": "エヴァンゲリアンは宇宙に存在する。あなたが知っている"}, {"type": "subtitle", "time": 3225.91, "timestamp": "00:53:45", "text": "それはもうアニメの話ですね。宇宙人"}, {"type": "subtitle", "time": 3226.829, "timestamp": "00:53:46", "text": "愛"}, {"type": "subtitle", "time": 3229.51, "timestamp": "00:53:49", "text": "アニメ。好きにならないのはタブーとされている"}, {"type": "subtitle", "time": 3232.309, "timestamp": "00:53:52", "text": "宇宙を舞台にしたアニメ。私たちもあの番組が好きなんです。"}, {"type": "subtitle", "time": 3233.91, "timestamp": "00:53:53", "text": "20年くらいのあのカートゥーン番組知ってる？"}, {"type": "subtitle", "time": 3235.91, "timestamp": "00:53:55", "text": "数年前はアニメに似ていたが、"}, {"type": "subtitle", "time": 3237.349, "timestamp": "00:53:57", "text": "みんな額が大きかった"}, {"type": "subtitle", "time": 3239.03, "timestamp": "00:53:59", "text": "理由。ええ、気に入りましたよ。あのね"}]
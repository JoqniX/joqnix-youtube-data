[{"type": "subtitle", "time": 3487.589, "timestamp": "00:58:07", "text": "私たちの仕事は、私たちの臓器を蝕んでいる。だから、私が"}, {"type": "subtitle", "time": 3489.109, "timestamp": "00:58:09", "text": "兄がダグラスに言った"}, {"type": "subtitle", "time": 3491.43, "timestamp": "00:58:11", "text": "彼は拷問に非常に興味がある。性的な意味で？"}, {"type": "subtitle", "time": 3493.109, "timestamp": "00:58:13", "text": "それは重要ですか？はい。私にとってそれは"}, {"type": "subtitle", "time": 3494.47, "timestamp": "00:58:14", "text": "性的なものである。なぜ私にそんなことを言うのですか？"}, {"type": "subtitle", "time": 3496.87, "timestamp": "00:58:16", "text": "あなたとはほとんど面識がありません。"}, {"type": "subtitle", "time": 3507.19, "timestamp": "00:58:27", "text": "神。君のことは分かってるよ。私はたくさんの"}, {"type": "subtitle", "time": 3509.31, "timestamp": "00:58:29", "text": "この場所から宝箱を取り出した。"}, {"type": "subtitle", "time": 3511.829, "timestamp": "00:58:31", "text": "[音楽]"}, {"type": "subtitle", "time": 3513.99, "timestamp": "00:58:33", "text": "私はトーマス・マイケル・フィリップス上院議員です。"}, {"type": "subtitle", "time": 3517.589, "timestamp": "00:58:37", "text": "私は暴力反対の母親たちの会を支持します。"}, {"type": "subtitle", "time": 3519.51, "timestamp": "00:58:39", "text": "この区域は、マザーズ・アゲインスト・ザ・マザーズの一部です。"}, {"type": "subtitle", "time": 3521.91, "timestamp": "00:58:41", "text": "暴力条約。つまり、暴力は一切許されないということだ。"}, {"type": "subtitle", "time": 3527.75, "timestamp": "00:58:47", "text": "では、Mothers Against Violenceはどのようにして"}, {"type": "subtitle", "time": 3530.39, "timestamp": "00:58:50", "text": "起こるのか？ええと、私たち全員、あなたは"}, {"type": "subtitle", "time": 3532.47, "timestamp": "00:58:52", "text": "何をしているの？"}, {"type": "subtitle", "time": 3534.47, "timestamp": "00:58:54", "text": "何を調べているのですか？そしてそれを決めた"}, {"type": "subtitle", "time": 3536.39, "timestamp": "00:58:56", "text": "小さなセクターがいくつかあると楽しいだろう"}, {"type": "subtitle", "time": 3538.39, "timestamp": "00:58:58", "text": "みんながお互いを殺し合わない場所"}]
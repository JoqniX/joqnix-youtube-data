[{"type": "subtitle", "time": 10141.75, "timestamp": "02:49:01", "text": "片付けるように言っている。この場所は"}, {"type": "subtitle", "time": 10144.07, "timestamp": "02:49:04", "text": "混乱。片付けてから"}, {"type": "subtitle", "time": 10147.349, "timestamp": "02:49:07", "text": "ツイードが届きました。ああ、大事なデートがあるんだ"}, {"type": "subtitle", "time": 10149.83, "timestamp": "02:49:09", "text": "君の哀れなフリンボルグのおもちゃの男の子。どこ"}, {"type": "subtitle", "time": 10152.07, "timestamp": "02:49:12", "text": "トゥエ、ジーン？まるで一度も行ったことがないかのように"}, {"type": "subtitle", "time": 10153.99, "timestamp": "02:49:13", "text": "デートの時。おい、始めないでくれ、"}, {"type": "subtitle", "time": 10156.309, "timestamp": "02:49:16", "text": "妹。私は日付についてよく知っています。私"}, {"type": "subtitle", "time": 10158.15, "timestamp": "02:49:18", "text": "お前の脳が処理できる以上のエイリアンとヤった"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "理解する。そして私もそうしたくない"}, {"type": "subtitle", "time": 10161.91, "timestamp": "02:49:21", "text": "彼氏に触れて。聞くのにうんざり"}, {"type": "subtitle", "time": 10163.91, "timestamp": "02:49:23", "text": "うん、すごくクールだね。彼らは作る"}, {"type": "subtitle", "time": 10166.309, "timestamp": "02:49:26", "text": "引用が多すぎる。私の彼氏はとても"}, {"type": "subtitle", "time": 10168.87, "timestamp": "02:49:28", "text": "めちゃくちゃセクシーだよね？"}, {"type": "subtitle", "time": 10170.29, "timestamp": "02:49:30", "text": "何？"}, {"type": "subtitle", "time": 10173.67, "timestamp": "02:49:33", "text": "[音楽]"}, {"type": "subtitle", "time": 10176.23, "timestamp": "02:49:36", "text": "待って、あなたはまだ彼に会ったこともないじゃない。なぜ"}, {"type": "subtitle", "time": 10178.95, "timestamp": "02:49:38", "text": "あなたは彼を気持ち悪いと言っているのですか？知ってるでしょ、私は"}, {"type": "subtitle", "time": 10181.349, "timestamp": "02:49:41", "text": "あなたがここにいる間に、ここで人生が繰り広げられている"}, {"type": "subtitle", "time": 10184.389, "timestamp": "02:49:44", "text": "好きなことをして楽しんでいる"}, {"type": "subtitle", "time": 10186.55, "timestamp": "02:49:46", "text": "する。いいえ、あなたの言う通りです。彼女のボーイフレンドの"}, {"type": "subtitle", "time": 10188.87, "timestamp": "02:49:48", "text": "醜い。自分の後片付けは自分でやりなさい。"}, {"type": "subtitle", "time": 10191.349, "timestamp": "02:49:51", "text": "イエス。よし。見てください、もし私が"}, {"type": "subtitle", "time": 10193.83, "timestamp": "02:49:53", "text": "きつい言い方だ。彼は台無しにしている"}, {"type": "subtitle", "time": 10196.15, "timestamp": "02:49:56", "text": "グループダイナミクス。私たちは良いものを手に入れた"}, {"type": "subtitle", "time": 10198.79, "timestamp": "02:49:58", "text": "ここへ行く。私たちは楽しいシットコムの掛け合いをする"}]
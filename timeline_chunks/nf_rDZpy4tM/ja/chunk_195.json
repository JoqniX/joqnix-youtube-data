[{"type": "subtitle", "time": 11700.07, "timestamp": "03:15:00", "text": "道化師って何？私は何が起こるかわからない"}, {"type": "subtitle", "time": 11702.51, "timestamp": "03:15:02", "text": "道化師は"}, {"type": "subtitle", "time": 11705.11, "timestamp": "03:15:05", "text": "私の窓まで。待って、私は"}, {"type": "subtitle", "time": 11706.91, "timestamp": "03:15:06", "text": "何か"}, {"type": "subtitle", "time": 11709.99, "timestamp": "03:15:09", "text": "プロのジョッカーか、"}, {"type": "subtitle", "time": 11712.309, "timestamp": "03:15:12", "text": "医療裁判所でキャップを複製する愚か者"}, {"type": "subtitle", "time": 11715.11, "timestamp": "03:15:15", "text": "鈴が付いていて、模造品を運んでいる"}, {"type": "subtitle", "time": 11717.55, "timestamp": "03:15:17", "text": "笏。ああ、"}, {"type": "subtitle", "time": 11720.24, "timestamp": "03:15:20", "text": "胸。それは面白い。"}, {"type": "subtitle", "time": 11723.83, "timestamp": "03:15:23", "text": "[音楽]"}, {"type": "subtitle", "time": 11730.309, "timestamp": "03:15:30", "text": "うん、ある意味で私は考え始めた"}, {"type": "subtitle", "time": 11733.19, "timestamp": "03:15:33", "text": "それについて違う考え方を始めたように"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "それを受け入れなさい。しかし、もしそれが"}, {"type": "subtitle", "time": 11740.11, "timestamp": "03:15:40", "text": "欲しいですよね？もし私が自力で脱出できるなら"}, {"type": "subtitle", "time": 11743.19, "timestamp": "03:15:43", "text": "そこにいて、誰とでもコラボレーションできる"}, {"type": "subtitle", "time": 11745.15, "timestamp": "03:15:45", "text": "いつか、"}, {"type": "subtitle", "time": 11748.71, "timestamp": "03:15:48", "text": "右？コラボしたり、いいねしたりするのはいいことだろう"}, {"type": "subtitle", "time": 11752.229, "timestamp": "03:15:52", "text": "話すけど、とにかく、うん。について話す"}, {"type": "subtitle", "time": 11754.429, "timestamp": "03:15:54", "text": "しかしギャブはしかし"}]
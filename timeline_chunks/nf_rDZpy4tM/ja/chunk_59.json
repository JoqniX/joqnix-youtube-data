[{"type": "subtitle", "time": 3541.27, "timestamp": "00:59:01", "text": "時間。そうそう。"}, {"type": "subtitle", "time": 3545.51, "timestamp": "00:59:05", "text": "えっと、新しい聖なる"}, {"type": "subtitle", "time": 3548.87, "timestamp": "00:59:08", "text": "えっと、ホロスターズジャイアントが発売されるんですよね？"}, {"type": "subtitle", "time": 3574.71, "timestamp": "00:59:34", "text": "ああ、ゲイリーは生身で演じなければならない"}, {"type": "subtitle", "time": 3576.549, "timestamp": "00:59:36", "text": "確かに。まあ、そういう時もあるんだよ"}, {"type": "subtitle", "time": 3579.19, "timestamp": "00:59:39", "text": "そして場所。もしかしたら私たちは楽しい"}, {"type": "subtitle", "time": 3587.95, "timestamp": "00:59:47", "text": "夢想しないで"}]
[{"type": "subtitle", "time": 10740.349, "timestamp": "02:59:00", "text": "でも、えっと"}, {"type": "subtitle", "time": 10743.75, "timestamp": "02:59:03", "text": "土曜日はマインクラフトの後だと思うけど"}, {"type": "subtitle", "time": 10746.19, "timestamp": "02:59:06", "text": "少なくとも1時間スタジオで"}, {"type": "subtitle", "time": 10748.71, "timestamp": "02:59:08", "text": "ゲーム、ただゲームをプレイしたり、ぶらぶらしたりする"}, {"type": "subtitle", "time": 10751.19, "timestamp": "02:59:11", "text": "ウィッシュ号か何かで。私は"}, {"type": "subtitle", "time": 10753.15, "timestamp": "02:59:13", "text": "レイプした後"}, {"type": "subtitle", "time": 10756.23, "timestamp": "02:59:16", "text": "1時間2時間経過の時点で私は行く"}, {"type": "subtitle", "time": 10758.469, "timestamp": "02:59:18", "text": "ストリームに戻る、少なくとも"}, {"type": "subtitle", "time": 10762.19, "timestamp": "02:59:22", "text": "可能であれば1時間か2時間"}, {"type": "subtitle", "time": 10772.51, "timestamp": "02:59:32", "text": "知ってますよ、来てくれた皆さんに感謝します"}, {"type": "subtitle", "time": 10782.55, "timestamp": "02:59:42", "text": "本当に、本当に、とても大きな意味があります。"}, {"type": "subtitle", "time": 10784.349, "timestamp": "02:59:44", "text": "今日は楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 10791.349, "timestamp": "02:59:51", "text": "今日。来てくれてありがとう"}, {"type": "subtitle", "time": 10795.67, "timestamp": "02:59:55", "text": "この配信の冒頭で。はい。"}, {"type": "subtitle", "time": 10799.59, "timestamp": "02:59:59", "text": "それからハッシュ・ジャマがハッシュの来訪のためにやってきた"}]
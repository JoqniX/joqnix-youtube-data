[{"type": "subtitle", "time": 3601.67, "timestamp": "01:00:01", "text": "楽しんできてくださいね。さあ行こう。うん。"}, {"type": "subtitle", "time": 3603.51, "timestamp": "01:00:03", "text": "そのように捉える。ここは"}, {"type": "subtitle", "time": 3606.23, "timestamp": "01:00:06", "text": "素晴らしい？都市全体が"}, {"type": "subtitle", "time": 3608.549, "timestamp": "01:00:08", "text": "小惑星。本当は"}, {"type": "subtitle", "time": 3610.71, "timestamp": "01:00:10", "text": "この辺りは犯罪が多い。ヨギ、君は遊ぶ"}, {"type": "subtitle", "time": 3612.95, "timestamp": "01:00:12", "text": "遊☆戯☆王。"}, {"type": "subtitle", "time": 3615.67, "timestamp": "01:00:15", "text": "あっちへ行きなさい、我が子よ。私は"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "マザーズという名の素敵な小さな組織"}, {"type": "subtitle", "time": 3620.39, "timestamp": "01:00:20", "text": "暴力のため、あなたは今入ろうとしています"}, {"type": "subtitle", "time": 3622.87, "timestamp": "01:00:22", "text": "我々の管轄下にある分野。それは"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "右。暴力反対の母親の会、"}, {"type": "subtitle", "time": 3627.91, "timestamp": "01:00:27", "text": "そして私たち、母親たちは"}, {"type": "subtitle", "time": 3630.23, "timestamp": "01:00:30", "text": "暴力。私たちは少し違うんです。私たちは"}, {"type": "subtitle", "time": 3632.47, "timestamp": "01:00:32", "text": "暴力が大好きで、もっと欲しい"}, {"type": "subtitle", "time": 3635.51, "timestamp": "01:00:35", "text": "どこにでも。おお。"}, {"type": "subtitle", "time": 3637.27, "timestamp": "01:00:37", "text": "カウボーイが狩る少年がさらに増える"}, {"type": "subtitle", "time": 3641.03, "timestamp": "01:00:41", "text": "良いパートナー。だから私たちはただ休むことができた。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "ええ、そうです。私はウィッグオタクです。"}, {"type": "subtitle", "time": 3653.43, "timestamp": "01:00:53", "text": "G3には何か問題があるようです"}]
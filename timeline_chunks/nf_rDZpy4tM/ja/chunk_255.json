[{"type": "subtitle", "time": 15301.91, "timestamp": "04:15:01", "text": "わかった。最終的に私は考えた"}, {"type": "subtitle", "time": 15303.75, "timestamp": "04:15:03", "text": "みんなに頼まれたからアジアに行くよ。いいえ、"}, {"type": "subtitle", "time": 15307.429, "timestamp": "04:15:07", "text": "アジアは避けた方がいい。 CAを選びましょう。"}, {"type": "subtitle", "time": 15310.229, "timestamp": "04:15:10", "text": "CAクリアパッチに来てください。私はすべきでしょうか"}, {"type": "subtitle", "time": 15313.269, "timestamp": "04:15:13", "text": "再ダウンロードしますか？わかった。わかった。あなたは思う"}, {"type": "subtitle", "time": 15319.189, "timestamp": "04:15:19", "text": "なんてこった。"}, {"type": "subtitle", "time": 15322.55, "timestamp": "04:15:22", "text": "兄はただ遊びたかっただけだった。はい。いいえ。"}, {"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "目が覚めた。目が覚めた。つまり、私は演奏できる"}, {"type": "subtitle", "time": 15329.83, "timestamp": "04:15:29", "text": "Cバージョンをプレイしてみることもできますが、"}, {"type": "subtitle", "time": 15332.149, "timestamp": "04:15:32", "text": "問題は、私は看板用の電話を持っていないということです"}, {"type": "subtitle", "time": 15334.55, "timestamp": "04:15:34", "text": "番号。いや。だから私はこう思うんだ、"}, {"type": "subtitle", "time": 15338.149, "timestamp": "04:15:38", "text": "全てが痛みを帯びてくる。"}, {"type": "subtitle", "time": 15340.469, "timestamp": "04:15:40", "text": "そうそう。こんにちは。ようこそ、アレックス。良い"}, {"type": "subtitle", "time": 15342.389, "timestamp": "04:15:42", "text": "朝。"}, {"type": "subtitle", "time": 15344.149, "timestamp": "04:15:44", "text": "ゲームをダウンロードしましたか、"}, {"type": "subtitle", "time": 15346.229, "timestamp": "04:15:46", "text": "私を飲んでくれよ？"}, {"type": "subtitle", "time": 15350.03, "timestamp": "04:15:50", "text": "あれは何でしょう？は"}]
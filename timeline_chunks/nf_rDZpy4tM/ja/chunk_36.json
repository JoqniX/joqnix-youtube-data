[{"type": "subtitle", "time": 2161.43, "timestamp": "00:36:01", "text": "これ。よし、アップグレードする必要がある"}, {"type": "subtitle", "time": 2164.55, "timestamp": "00:36:04", "text": "それでは。うわぁ。うわぁ。どうもありがとう"}, {"type": "subtitle", "time": 2167.19, "timestamp": "00:36:07", "text": "私を助けてくれてありがとう。何てことだ。ありがとう。えっと、"}, {"type": "subtitle", "time": 2169.43, "timestamp": "00:36:09", "text": "でもね、知ってる？私はちょっと私はちょっと"}, {"type": "subtitle", "time": 2171.19, "timestamp": "00:36:11", "text": "彼と寝ると思っていた。では今"}, {"type": "subtitle", "time": 2173.43, "timestamp": "00:36:13", "text": "わかりません。ちょっと考えてくる"}, {"type": "subtitle", "time": 2176.63, "timestamp": "00:36:16", "text": "それについて。また後で。待って、どうやって"}, {"type": "subtitle", "time": 2179.88, "timestamp": "00:36:19", "text": "私は立ち上がる？"}, {"type": "subtitle", "time": 2193.829, "timestamp": "00:36:33", "text": "待って、待って。何に何が起こったのか"}, {"type": "subtitle", "time": 2197.47, "timestamp": "00:36:37", "text": "ケニーに何が起こったのか？え、何？何が"}, {"type": "subtitle", "time": 2201.39, "timestamp": "00:36:41", "text": "これ？いや、彼の、待って、これはバグですか？"}, {"type": "subtitle", "time": 2204.43, "timestamp": "00:36:44", "text": "いや、彼の顔だ。"}, {"type": "subtitle", "time": 2211.349, "timestamp": "00:36:51", "text": "待って、これはノー、ノー、ノー、ノー、ノーです。何"}, {"type": "subtitle", "time": 2212.87, "timestamp": "00:36:52", "text": "あなたにも起こりましたか？何てことだ。何"}, {"type": "subtitle", "time": 2214.96, "timestamp": "00:36:54", "text": "あなたの顔に何が起こったのですか？"}, {"type": "subtitle", "time": 2216.15, "timestamp": "00:36:56", "text": "[音楽]"}]
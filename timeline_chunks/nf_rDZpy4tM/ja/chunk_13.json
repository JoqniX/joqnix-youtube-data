[{"type": "subtitle", "time": 781.35, "timestamp": "00:13:01", "text": "くそ。この墜落した船は、"}, {"type": "subtitle", "time": 789.91, "timestamp": "00:13:09", "text": "ch があるはずだと言おうとしていた"}, {"type": "subtitle", "time": 792.47, "timestamp": "00:13:12", "text": "この辺りには宝箱があるはずだし、"}, {"type": "subtitle", "time": 794.79, "timestamp": "00:13:14", "text": "すぐに見つかりました。おお。ええ、G3ですね。"}, {"type": "subtitle", "time": 796.87, "timestamp": "00:13:16", "text": "ここで公式に物事を運営しないでください、"}, {"type": "subtitle", "time": 799.35, "timestamp": "00:13:19", "text": "しかし、非公式には。ああ、そう思う"}, {"type": "subtitle", "time": 800.71, "timestamp": "00:13:20", "text": "遠くに見えるのがオールドタウンです。あなた"}, {"type": "subtitle", "time": 802.069, "timestamp": "00:13:22", "text": "知ってるよ、あれは最初の和解だったんだ"}, {"type": "subtitle", "time": 804.79, "timestamp": "00:13:24", "text": "ここ。 PreG3。私たちはそこを通り抜けて"}, {"type": "subtitle", "time": 816.389, "timestamp": "00:13:36", "text": "私はどうしているだろうか 私はどうするつもりだろうか"}, {"type": "subtitle", "time": 818.15, "timestamp": "00:13:38", "text": "あの胸？ああ、こんな大惨事は"}, {"type": "subtitle", "time": 819.829, "timestamp": "00:13:39", "text": "ポートテレインではごく普通のことです。あなたが知っている、"}, {"type": "subtitle", "time": 821.59, "timestamp": "00:13:41", "text": "この小惑星は昔から無法地帯だった"}, {"type": "subtitle", "time": 823.67, "timestamp": "00:13:43", "text": "着陸したが、G3セットアップショットが撮れたので、"}, {"type": "subtitle", "time": 825.829, "timestamp": "00:13:45", "text": "さらに悪いことに。"}, {"type": "subtitle", "time": 833.99, "timestamp": "00:13:53", "text": "それ。ゴミ袋5枚目。オンライン"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "オリバー。オリバーは自分のすべての時間を過ごすのが大好きです"}, {"type": "subtitle", "time": 838.47, "timestamp": "00:13:58", "text": "ウェブサイトで時間を過ごして、"}]
[{"type": "subtitle", "time": 3927.069, "timestamp": "01:05:27", "text": "私は脳を"}, {"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "集中して、最後のは"}, {"type": "subtitle", "time": 3932.549, "timestamp": "01:05:32", "text": "参加するが、これは私がどのように"}, {"type": "subtitle", "time": 3935.23, "timestamp": "01:05:35", "text": "拷問するのが好き。そうではありません"}, {"type": "subtitle", "time": 3942.069, "timestamp": "01:05:42", "text": "私たちはきっと解決策を見つけられると思います"}, {"type": "subtitle", "time": 3945.27, "timestamp": "01:05:45", "text": "入ってこい。誰であろうと拷問してやる。"}, {"type": "subtitle", "time": 3947.75, "timestamp": "01:05:47", "text": "では、質問があります。はい。あなたの"}, {"type": "subtitle", "time": 3949.51, "timestamp": "01:05:49", "text": "両手を上げてください。手を上げて"}, {"type": "subtitle", "time": 3952.39, "timestamp": "01:05:52", "text": "パワースライドを滑り降りる。おい。おい、"}, {"type": "subtitle", "time": 3954.069, "timestamp": "01:05:54", "text": "これを見てみて。粘液が"}, {"type": "subtitle", "time": 3955.51, "timestamp": "01:05:55", "text": "ここ。きっと気に入るよ。あなたはできる"}, {"type": "subtitle", "time": 3957.109, "timestamp": "01:05:57", "text": "それを使って忍び込んでください。さあ。おい。おい"}, {"type": "subtitle", "time": 3959.51, "timestamp": "01:05:59", "text": "そこには。来てくれてありがとう。男"}]
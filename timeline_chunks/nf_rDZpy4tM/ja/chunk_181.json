[{"type": "subtitle", "time": 10862.11, "timestamp": "03:01:02", "text": "今。それから、えっと、何が"}, {"type": "subtitle", "time": 10865.15, "timestamp": "03:01:05", "text": "それ？来た"}, {"type": "subtitle", "time": 10869.63, "timestamp": "03:01:09", "text": "今頃は。本当に本当に意味があります"}, {"type": "subtitle", "time": 10872.07, "timestamp": "03:01:12", "text": "多く。あなたが持っているのを見るのは良いことです"}, {"type": "subtitle", "time": 10873.79, "timestamp": "03:01:13", "text": "たくさんの質問"}, {"type": "subtitle", "time": 10875.79, "timestamp": "03:01:15", "text": "私と"}, {"type": "subtitle", "time": 10879.269, "timestamp": "03:01:19", "text": "いろいろなものがあって、少なくとも"}, {"type": "subtitle", "time": 10880.79, "timestamp": "03:01:20", "text": "これらの質問にお答えし、"}, {"type": "subtitle", "time": 10889.429, "timestamp": "03:01:29", "text": "そして将来は"}, {"type": "subtitle", "time": 10893.269, "timestamp": "03:01:33", "text": "インスピレーションを受ける他の多くの人々"}, {"type": "subtitle", "time": 10895.87, "timestamp": "03:01:35", "text": "償いと"}, {"type": "subtitle", "time": 10899.59, "timestamp": "03:01:39", "text": "すべて。ああ、あなたは決してああ神様、これは"}, {"type": "subtitle", "time": 10902.469, "timestamp": "03:01:42", "text": "この音楽は私を"}, {"type": "subtitle", "time": 10904.429, "timestamp": "03:01:44", "text": "悲しいけれど。でも、そうだね、君は"}, {"type": "subtitle", "time": 10908.59, "timestamp": "03:01:48", "text": "考えてみれば、"}, {"type": "subtitle", "time": 10911.71, "timestamp": "03:01:51", "text": "はい、少しだけお休みします。私はしません"}, {"type": "subtitle", "time": 10916.55, "timestamp": "03:01:56", "text": "知る。ええ、とても嬉しいです。"}, {"type": "subtitle", "time": 10917.63, "timestamp": "03:01:57", "text": "あなたはやっている"}]
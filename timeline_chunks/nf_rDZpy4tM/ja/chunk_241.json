[{"type": "subtitle", "time": 14461.389, "timestamp": "04:01:01", "text": "明日はもっと長い"}, {"type": "subtitle", "time": 14463.75, "timestamp": "04:01:03", "text": "配信は12時間かかるかもしれないので、"}, {"type": "subtitle", "time": 14466.63, "timestamp": "04:01:06", "text": "それについては準備済みです。バンボン。だから、"}, {"type": "subtitle", "time": 14468.91, "timestamp": "04:01:08", "text": "午後3時"}, {"type": "subtitle", "time": 14472.15, "timestamp": "04:01:12", "text": "おそらく午前1時か2時頃まで。"}, {"type": "subtitle", "time": 14475.75, "timestamp": "04:01:15", "text": "午前中は長めの配信になりそうです"}, {"type": "subtitle", "time": 14479.269, "timestamp": "04:01:19", "text": "また会う日まで。わかった。右。それだけです。"}, {"type": "subtitle", "time": 14480.91, "timestamp": "04:01:20", "text": "私は"}, {"type": "subtitle", "time": 14484.55, "timestamp": "04:01:24", "text": "それ。こんにちは。ええ、そうですね。私はそうあるべきだと信じている"}, {"type": "subtitle", "time": 14486.229, "timestamp": "04:01:26", "text": "そろそろ締めくくりですよね？私はあまりしたくない"}, {"type": "subtitle", "time": 14493.15, "timestamp": "04:01:33", "text": "[音楽]"}, {"type": "subtitle", "time": 14511.389, "timestamp": "04:01:51", "text": "香港の件が"}, {"type": "subtitle", "time": 14514.389, "timestamp": "04:01:54", "text": "今週中に完了するだろう"}, {"type": "subtitle", "time": 14515.63, "timestamp": "04:01:55", "text": "3週目"}, {"type": "subtitle", "time": 14519.03, "timestamp": "04:01:59", "text": "1月15日です。それは"}]
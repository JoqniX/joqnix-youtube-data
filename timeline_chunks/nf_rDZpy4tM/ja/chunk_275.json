[{"type": "subtitle", "time": 16501.551, "timestamp": "04:35:01", "text": "ターミナル。ああ、これがテレポートですか"}, {"type": "subtitle", "time": 16507.769, "timestamp": "04:35:07", "text": "わかった。いいね、いいね、いいね、いいね、"}, {"type": "subtitle", "time": 16521.551, "timestamp": "04:35:21", "text": "ニース。もうすぐ美しい場所に着きます"}, {"type": "subtitle", "time": 16524.31, "timestamp": "04:35:24", "text": "入り口。下り坂はあるだろうが、"}, {"type": "subtitle", "time": 16526.75, "timestamp": "04:35:26", "text": "もしあなたが私のアラームが"}, {"type": "subtitle", "time": 16529.83, "timestamp": "04:35:29", "text": "鳴った。午前7時アラーム。一度外に出ると"}, {"type": "subtitle", "time": 16532.15, "timestamp": "04:35:32", "text": "渓谷へは、歩いてすぐです。"}, {"type": "subtitle", "time": 16541.189, "timestamp": "04:35:41", "text": "新城は最も安全な場所です。さあ行こう。"}, {"type": "subtitle", "time": 16543.59, "timestamp": "04:35:43", "text": "共鳴の接点はカバレッジを提供する。"}, {"type": "subtitle", "time": 16546.07, "timestamp": "04:35:46", "text": "これが原神の最新アップデートです。手に入れた"}, {"type": "subtitle", "time": 16548.31, "timestamp": "04:35:48", "text": "保護バリアとして強力です。うん。"}, {"type": "subtitle", "time": 16551.83, "timestamp": "04:35:51", "text": "原神2.0。"}, {"type": "subtitle", "time": 16554.31, "timestamp": "04:35:54", "text": "うん。"}, {"type": "subtitle", "time": 16556.709, "timestamp": "04:35:56", "text": "ジンジョは砂漠の高地と砂漠の高地の間に位置している。"}, {"type": "subtitle", "time": 16559.189, "timestamp": "04:35:59", "text": "そして、ノーラルの荒地。それは"}]
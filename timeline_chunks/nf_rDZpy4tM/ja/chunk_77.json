[{"type": "subtitle", "time": 4621.35, "timestamp": "01:17:01", "text": "彼ら自身のファンダムと彼ら自身の好きなもの"}, {"type": "subtitle", "time": 4622.95, "timestamp": "01:17:02", "text": "コミュニティ、ですよね？たとえ彼らが"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "星空観察者の大家族の下で、"}, {"type": "subtitle", "time": 4629.669, "timestamp": "01:17:09", "text": "スタースケープファミリーは、"}, {"type": "subtitle", "time": 4631.189, "timestamp": "01:17:11", "text": "異なる部屋のように、"}, {"type": "subtitle", "time": 4633.03, "timestamp": "01:17:13", "text": "こう言ってみよう"}, {"type": "subtitle", "time": 4636.63, "timestamp": "01:17:16", "text": "そうですよね？うん。それで、それで、ご存知のように"}, {"type": "subtitle", "time": 4640.149, "timestamp": "01:17:20", "text": "Starscape IRLの1月が来るんですよね？"}, {"type": "subtitle", "time": 4643.11, "timestamp": "01:17:23", "text": "サイコノートがデビューするのは"}, {"type": "subtitle", "time": 4647.27, "timestamp": "01:17:27", "text": "土曜日、または6月7日、7日"}, {"type": "subtitle", "time": 4650.59, "timestamp": "01:17:30", "text": "1月ですよね？では、何が起こるのでしょうか？"}, {"type": "subtitle", "time": 4653.27, "timestamp": "01:17:33", "text": "Psychosoan は参加します"}, {"type": "subtitle", "time": 4656.709, "timestamp": "01:17:36", "text": "彼女が築いたコミュニティで、"}, {"type": "subtitle", "time": 4659.99, "timestamp": "01:17:39", "text": "彼女は最善を尽くさなければならないし、"}, {"type": "subtitle", "time": 4662.07, "timestamp": "01:17:42", "text": "みんなを感心させたいとかそういうこと"}, {"type": "subtitle", "time": 4664.39, "timestamp": "01:17:44", "text": "そういうことが最善を尽くしている"}, {"type": "subtitle", "time": 4666.39, "timestamp": "01:17:46", "text": "コンテンツを作成したり、歯磨きをしたりするような意味です"}, {"type": "subtitle", "time": 4668.39, "timestamp": "01:17:48", "text": "そして第一印象のように"}, {"type": "subtitle", "time": 4669.91, "timestamp": "01:17:49", "text": "デビュー作と"}, {"type": "subtitle", "time": 4672.149, "timestamp": "01:17:52", "text": "その後、数回の配信を経て、すべてが終わりました。"}, {"type": "subtitle", "time": 4675.11, "timestamp": "01:17:55", "text": "そして、そこには、"}, {"type": "subtitle", "time": 4678.229, "timestamp": "01:17:58", "text": "サイコパスを発見するだろうし、"}]
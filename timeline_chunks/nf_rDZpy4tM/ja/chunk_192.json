[{"type": "subtitle", "time": 11520.95, "timestamp": "03:12:00", "text": "もの。うん。うん。うん。ロゴさえも。"}, {"type": "subtitle", "time": 11523.51, "timestamp": "03:12:03", "text": "私が始めた頃は"}, {"type": "subtitle", "time": 11526.63, "timestamp": "03:12:06", "text": "Jocknさん、その問題は既に経験済みです。種の"}, {"type": "subtitle", "time": 11528.389, "timestamp": "03:12:08", "text": "似たようなものがあると嫌だ"}, {"type": "subtitle", "time": 11530.79, "timestamp": "03:12:10", "text": "あるいは、同じ名前の人や"}, {"type": "subtitle", "time": 11533.19, "timestamp": "03:12:13", "text": "何か。だから私はほとんどの"}, {"type": "subtitle", "time": 11536.23, "timestamp": "03:12:16", "text": "私のすべてのキャラクターの中で、"}, {"type": "subtitle", "time": 11538.87, "timestamp": "03:12:18", "text": "共有または類似の名前を持つ"}, {"type": "subtitle", "time": 11542.79, "timestamp": "03:12:22", "text": "誰でも。デザイン面でもその他どんな面でも、"}, {"type": "subtitle", "time": 11545.429, "timestamp": "03:12:25", "text": "ロゴに関しては、何でも構いません。うん。そうに違いない"}, {"type": "subtitle", "time": 11547.23, "timestamp": "03:12:27", "text": "個性的。しなければならない"}, {"type": "subtitle", "time": 11550.469, "timestamp": "03:12:30", "text": "自分自身に正直で、本当に"}, {"type": "subtitle", "time": 11553.07, "timestamp": "03:12:33", "text": "個性的。うん。"}, {"type": "subtitle", "time": 11555.75, "timestamp": "03:12:35", "text": "でも、私にはわからない。これを見たとき、私は"}, {"type": "subtitle", "time": 11558.309, "timestamp": "03:12:38", "text": "「おお、すごい。これはより良い"}, {"type": "subtitle", "time": 11560.79, "timestamp": "03:12:40", "text": "一種の別のジョークのバージョン、または"}, {"type": "subtitle", "time": 11563.389, "timestamp": "03:12:43", "text": "「何か」と私は思った。"}, {"type": "subtitle", "time": 11565.75, "timestamp": "03:12:45", "text": "心臓。うん。だから私はこう思う"}, {"type": "subtitle", "time": 11567.469, "timestamp": "03:12:47", "text": "開始します"}, {"type": "subtitle", "time": 11570.03, "timestamp": "03:12:50", "text": "泣いている。泣き始める"}, {"type": "subtitle", "time": 11575.19, "timestamp": "03:12:55", "text": "とてもたくさん出かけました。しかし、ある意味では当然のことながら"}, {"type": "subtitle", "time": 11577.429, "timestamp": "03:12:57", "text": "いや、コピーできるわけじゃないよ"}]
[{"type": "subtitle", "time": 11402.15, "timestamp": "03:10:02", "text": "そういうのが好きなのは、"}, {"type": "subtitle", "time": 11404.07, "timestamp": "03:10:04", "text": "Twitterでアクティブに活動している、または"}, {"type": "subtitle", "time": 11406.15, "timestamp": "03:10:06", "text": "Twitterを見ていると、たくさんの"}, {"type": "subtitle", "time": 11410.23, "timestamp": "03:10:10", "text": "物事のすべてドラマすべての"}, {"type": "subtitle", "time": 11412.91, "timestamp": "03:10:12", "text": "Vtubeでのドラマ"}, {"type": "subtitle", "time": 11416.03, "timestamp": "03:10:16", "text": "文化。それは私に思い出させた"}, {"type": "subtitle", "time": 11419.269, "timestamp": "03:10:19", "text": "えーと、VTuberだった人が"}, {"type": "subtitle", "time": 11422.75, "timestamp": "03:10:22", "text": "同じような"}, {"type": "subtitle", "time": 11426.23, "timestamp": "03:10:26", "text": "人気YouTuberとしてデザインする。私はしません"}, {"type": "subtitle", "time": 11429.269, "timestamp": "03:10:29", "text": "名前は言いませんが。うん。だから私は"}, {"type": "subtitle", "time": 11430.51, "timestamp": "03:10:30", "text": "「ああ」"}, {"type": "subtitle", "time": 11432.99, "timestamp": "03:10:32", "text": "いいえ。おお"}, {"type": "subtitle", "time": 11436.79, "timestamp": "03:10:36", "text": "いいえ。 「もしも​​？」いや、いや、いや。あの時"}, {"type": "subtitle", "time": 11439.269, "timestamp": "03:10:39", "text": "それを見たとき、私はただそれを"}, {"type": "subtitle", "time": 11442.55, "timestamp": "03:10:42", "text": "心は、考えのように、あるいは、もしも"}, {"type": "subtitle", "time": 11444.67, "timestamp": "03:10:44", "text": "1つ"}, {"type": "subtitle", "time": 11449.03, "timestamp": "03:10:49", "text": "ある日、もし私があなたに"}, {"type": "subtitle", "time": 11451.07, "timestamp": "03:10:51", "text": "彼らの"}, {"type": "subtitle", "time": 11454.55, "timestamp": "03:10:54", "text": "ポジションはジョックのために立ち上がらなければならない"}, {"type": "subtitle", "time": 11456.389, "timestamp": "03:10:56", "text": "もちろん、ジョックのためなら何でもするよ"}, {"type": "subtitle", "time": 11459.11, "timestamp": "03:10:59", "text": "どんなことがあってもジョックを擁護するだろう"}]
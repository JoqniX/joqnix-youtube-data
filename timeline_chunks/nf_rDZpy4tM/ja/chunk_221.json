[{"type": "subtitle", "time": 13265.19, "timestamp": "03:41:05", "text": "ああ、それから私たちはブラックユーモアをショックで打ち消した"}, {"type": "subtitle", "time": 13268.429, "timestamp": "03:41:08", "text": "一緒に。え、何？ブラックユーモアとは何か"}, {"type": "chat", "time": 13274.794, "timestamp": "03:41:14", "author": "@adrianspiritflame", "avatar": "https://yt4.ggpht.com/eaPxeLg6RZ3xDUjR-MtIoERS88UVLefuyFlCSftVUSaisdxANdt8HVouIGg2eSadWXpWoxIB5HA=s64-c-k-c0x00ffffff-no-rj", "message": "#ArekuRaid 😎☝"}, {"type": "subtitle", "time": 13275.99, "timestamp": "03:41:15", "text": "ジョーク。次に私のジョークを理解してくれるのは"}, {"type": "subtitle", "time": 13277.91, "timestamp": "03:41:17", "text": "痛い。"}, {"type": "chat", "time": 13278.817, "timestamp": "03:41:18", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "☕Areku Raid⚔"}, {"type": "subtitle", "time": 13278.83, "timestamp": "03:41:18", "text": "行く"}, {"type": "subtitle", "time": 13283.83, "timestamp": "03:41:23", "text": "自分。私はダンスを披露します"}, {"type": "subtitle", "time": 13288.349, "timestamp": "03:41:28", "text": "えーと、ジョークとかそういうやつ。では、私は自分の"}, {"type": "subtitle", "time": 13290.67, "timestamp": "03:41:30", "text": "最高。私は自分の"}, {"type": "subtitle", "time": 13294.67, "timestamp": "03:41:34", "text": "最高。一生懸命頑張ります。うん。私"}, {"type": "subtitle", "time": 13297.309, "timestamp": "03:41:37", "text": "つまり私は"}, {"type": "subtitle", "time": 13300.269, "timestamp": "03:41:40", "text": "覚えておく"}, {"type": "subtitle", "time": 13303.75, "timestamp": "03:41:43", "text": "「そうします」と言うのは簡単です"}, {"type": "subtitle", "time": 13305.83, "timestamp": "03:41:45", "text": "あれこれ。まるでただ取るように"}, {"type": "subtitle", "time": 13307.67, "timestamp": "03:41:47", "text": "私の例です。"}, {"type": "chat", "time": 13308.923, "timestamp": "03:41:48", "author": "@h2octavia", "avatar": "https://yt4.ggpht.com/l_ORxG1mx20SZwaAsQF5gtN3dhAcNNseZP8RF3VdIr_FU96d0Z6ZgVjIa5746433Cp5t_QOAXg=s64-c-k-c0x00ffffff-no-rj", "message": "#ArekuRaid"}, {"type": "subtitle", "time": 13309.51, "timestamp": "03:41:49", "text": "私は、右派がこれをやると言い続けている。"}, {"type": "subtitle", "time": 13313.67, "timestamp": "03:41:53", "text": "とかそういうのもあるけど、実際は"}, {"type": "subtitle", "time": 13318.91, "timestamp": "03:41:58", "text": "重要なのは、努力して示すことだ"}]
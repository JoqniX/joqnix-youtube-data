[{"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "うん、システムを作る必要があるから"}, {"type": "subtitle", "time": 7272.95, "timestamp": "02:01:12", "text": "私がマイクをミュートするたびに、いや、いや。"}, {"type": "subtitle", "time": 7275.27, "timestamp": "02:01:15", "text": "BB の電源を入れるとき、または"}, {"type": "subtitle", "time": 7278.07, "timestamp": "02:01:18", "text": "この方法でマイクをオンにしてミュートします"}, {"type": "subtitle", "time": 7279.99, "timestamp": "02:01:19", "text": "ちょっとしたことですが、チャットに表示されます"}, {"type": "subtitle", "time": 7282.75, "timestamp": "02:01:22", "text": "少しの間ミュートされているか、"}, {"type": "subtitle", "time": 7287.03, "timestamp": "02:01:27", "text": "そういう感じの何か、うん、そういう感じ"}, {"type": "subtitle", "time": 7289.91, "timestamp": "02:01:29", "text": "タイムスタンプを取得するにはどうすればいいですか？"}, {"type": "subtitle", "time": 7292.39, "timestamp": "02:01:32", "text": "私は自分のビデオをどれくらい長く撮影しましたか？"}, {"type": "subtitle", "time": 7293.81, "timestamp": "02:01:33", "text": "もの。"}, {"type": "subtitle", "time": 7296.629, "timestamp": "02:01:36", "text": "[音楽]"}, {"type": "subtitle", "time": 7298.229, "timestamp": "02:01:38", "text": "美しさを堪能させてくれてありがとう"}, {"type": "subtitle", "time": 7299.75, "timestamp": "02:01:39", "text": "寝ている。"}, {"type": "subtitle", "time": 7301.75, "timestamp": "02:01:41", "text": "私たちはちょっと贅沢な気分で過ごしています"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "知的な組み合わせとナイフの組み合わせ。待って、"}, {"type": "subtitle", "time": 7306.43, "timestamp": "02:01:46", "text": "何？何？ナイフ？"}]
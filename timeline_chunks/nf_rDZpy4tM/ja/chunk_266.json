[{"type": "subtitle", "time": 15961.03, "timestamp": "04:26:01", "text": "これ？あらら。実際に処理しています"}, {"type": "subtitle", "time": 15964.149, "timestamp": "04:26:04", "text": "実際、かなりうまくいったよ。おお。私は演奏できます"}, {"type": "subtitle", "time": 15966.309, "timestamp": "04:26:06", "text": "最高設定で。うん、消そう"}, {"type": "subtitle", "time": 15968.83, "timestamp": "04:26:08", "text": "ちなみに、動きは勢いを増す。それは"}, {"type": "subtitle", "time": 15972.95, "timestamp": "04:26:12", "text": "それ。水平方向の図。えっと、私のテキストボックスは"}, {"type": "subtitle", "time": 15976.75, "timestamp": "04:26:16", "text": "英語。ああ、言語を変更できますか？"}, {"type": "subtitle", "time": 15981.189, "timestamp": "04:26:21", "text": "中国人？待って、ダウンロードしないといけない。"}, {"type": "subtitle", "time": 15987.63, "timestamp": "04:26:27", "text": "ダウンロードする必要がある"}, {"type": "subtitle", "time": 15989.95, "timestamp": "04:26:29", "text": "332.24メガピクセル。"}, {"type": "subtitle", "time": 15999.149, "timestamp": "04:26:39", "text": "ああ、ドナルドのために今すぐ置いておけますよ。"}, {"type": "subtitle", "time": 16005.389, "timestamp": "04:26:45", "text": "おお。"}, {"type": "subtitle", "time": 16010.429, "timestamp": "04:26:50", "text": "ダウンロード。いいえ、メニューは保管しておかなければなりません"}, {"type": "subtitle", "time": 16012.79, "timestamp": "04:26:52", "text": "開ける。でも大丈夫。再生します"}]
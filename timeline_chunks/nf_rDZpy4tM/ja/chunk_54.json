[{"type": "subtitle", "time": 3240.39, "timestamp": "00:54:00", "text": "他にこんなエレベーターがあっただろうか？私は思う"}, {"type": "subtitle", "time": 3243.19, "timestamp": "00:54:03", "text": "ファイナルファンタジー7。トリガーだと思う。"}, {"type": "subtitle", "time": 3245.43, "timestamp": "00:54:05", "text": "バイオハザード2。覚えてる？"}, {"type": "subtitle", "time": 3246.63, "timestamp": "00:54:06", "text": "ゲーム？あなたはおそらく彼らのことを知らないでしょう。私たちは"}, {"type": "subtitle", "time": 3248.069, "timestamp": "00:54:08", "text": "それらは宇宙空間にしか存在しない。彼らは"}, {"type": "subtitle", "time": 3252.47, "timestamp": "00:54:12", "text": "宇宙ゲームに匹敵するものは全くない。"}, {"type": "subtitle", "time": 3253.87, "timestamp": "00:54:13", "text": "ああ、"}, {"type": "subtitle", "time": 3256.51, "timestamp": "00:54:16", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 3270.03, "timestamp": "00:54:30", "text": "くそ。よし、これはこれはとても"}, {"type": "subtitle", "time": 3277.39, "timestamp": "00:54:37", "text": "とても寒い。ああ、"}, {"type": "subtitle", "time": 3281.549, "timestamp": "00:54:41", "text": "神。くそ。よし、VDは"}, {"type": "subtitle", "time": 3284.069, "timestamp": "00:54:44", "text": "働く。うまくいくでしょう。今やったところです"}, {"type": "subtitle", "time": 3286.109, "timestamp": "00:54:46", "text": "のために"}, {"type": "subtitle", "time": 3288.97, "timestamp": "00:54:48", "text": "あなた。こんにちは"}]
[{"type": "subtitle", "time": 62.389, "timestamp": "00:01:02", "text": "そして、あなたは必ず出席しなければなりません。そうは言っても、"}, {"type": "subtitle", "time": 64.03, "timestamp": "00:01:04", "text": "私は行く"}, {"type": "subtitle", "time": 66.35, "timestamp": "00:01:06", "text": "寝る。良い"}, {"type": "subtitle", "time": 71.09, "timestamp": "00:01:11", "text": "夜。こんにちは。バイバイ。楽しんでください"}, {"type": "subtitle", "time": 80.19, "timestamp": "00:01:20", "text": "[音楽]"}, {"type": "subtitle", "time": 84.82, "timestamp": "00:01:24", "text": "V. 私にやらせてください。"}, {"type": "subtitle", "time": 92.67, "timestamp": "00:01:32", "text": "こんにちは。良い"}, {"type": "subtitle", "time": 95.85, "timestamp": "00:01:35", "text": "夜。楽しむ。"}]
[{"type": "subtitle", "time": 10322.07, "timestamp": "02:52:02", "text": "憂鬱だ。はぁ。"}, {"type": "subtitle", "time": 10327.03, "timestamp": "02:52:07", "text": "ジーン、片付けて。はい、長々とすみません"}, {"type": "subtitle", "time": 10330.07, "timestamp": "02:52:10", "text": "君はそういうのが好きなんだね。とにかく、素敵な小さな"}, {"type": "subtitle", "time": 10332.07, "timestamp": "02:52:12", "text": "Clugとの取り決めは功を奏している。"}, {"type": "subtitle", "time": 10334.55, "timestamp": "02:52:14", "text": "彼らは新たな懸賞金2件に関する情報を送ってきた。"}, {"type": "subtitle", "time": 10336.63, "timestamp": "02:52:16", "text": "では、もしあなたが手に入れたいならどうぞ"}, {"type": "subtitle", "time": 10350.87, "timestamp": "02:52:30", "text": "あなたの右側に2つあります。"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "えっと、Mを見ましたか？いや、違うよ。"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "不明なセクター部分。"}, {"type": "subtitle", "time": 10360.23, "timestamp": "02:52:40", "text": "私たちが家に帰るとすぐに彼は逃げ出した。おお、"}, {"type": "subtitle", "time": 10363.03, "timestamp": "02:52:43", "text": "とてもたくさん。 1 2 3。私は一度も"}, {"type": "subtitle", "time": 10365.19, "timestamp": "02:52:45", "text": "彼がこんなに動揺しているのを見たのは初めてだ。残念ながら彼は"}, {"type": "subtitle", "time": 10367.269, "timestamp": "02:52:47", "text": "何か行動を起こすつもりだ。 2000件集まりました。"}, {"type": "subtitle", "time": 10369.07, "timestamp": "02:52:49", "text": "この男はまだ戻ってきていない"}, {"type": "subtitle", "time": 10372.469, "timestamp": "02:52:52", "text": "どちらか。私は20,000も持っています。私"}, {"type": "subtitle", "time": 10374.71, "timestamp": "02:52:54", "text": "学校のベッドに戻った"}, {"type": "subtitle", "time": 10376.63, "timestamp": "02:52:56", "text": "ただ家に帰るのを待っているだけです。待って、"}, {"type": "subtitle", "time": 10379.19, "timestamp": "02:52:59", "text": "ここで配信を終了しましょうか、それとも"}]
[{"type": "subtitle", "time": 16682.31, "timestamp": "04:38:02", "text": "それでは、行きます。それに、私はただ"}, {"type": "subtitle", "time": 16684.869, "timestamp": "04:38:04", "text": "戦い。降りていかなければならない。ください"}, {"type": "subtitle", "time": 16687.67, "timestamp": "04:38:07", "text": "戦闘中のベスト。"}, {"type": "subtitle", "time": 16689.91, "timestamp": "04:38:09", "text": "私は戦いたい。さあ、"}, {"type": "subtitle", "time": 16693.349, "timestamp": "04:38:13", "text": "グライダーモジュール。ああ、グライダー。手伝わせてください"}, {"type": "subtitle", "time": 16697.029, "timestamp": "04:38:17", "text": "あなたがそれを有効化します。"}, {"type": "subtitle", "time": 16698.709, "timestamp": "04:38:18", "text": "おお、それはなかなかいいですね。あなたは"}, {"type": "subtitle", "time": 16700.429, "timestamp": "04:38:20", "text": "グライダー。それで、"}, {"type": "subtitle", "time": 16702.629, "timestamp": "04:38:22", "text": "待って。ところで、私は収集しました"}, {"type": "subtitle", "time": 16705.029, "timestamp": "04:38:25", "text": "このエリアのすべて？何もない"}, {"type": "subtitle", "time": 16705.869, "timestamp": "04:38:25", "text": "それ以外、"}, {"type": "subtitle", "time": 16710.59, "timestamp": "04:38:30", "text": "右？グッチですよね？わかった。"}, {"type": "subtitle", "time": 16714.109, "timestamp": "04:38:34", "text": "こんにちは。私は動けません"}, {"type": "subtitle", "time": 16716.189, "timestamp": "04:38:36", "text": "カメラ。"}, {"type": "subtitle", "time": 16719.67, "timestamp": "04:38:39", "text": "ああ、カットシーンだ。マウスを"}, {"type": "subtitle", "time": 16729.99, "timestamp": "04:38:49", "text": "私たちは、休眠状態にある暗黙の領域にいるんですよね？"}, {"type": "subtitle", "time": 16737.949, "timestamp": "04:38:57", "text": "あなた自身ですか？あなたが知っている、"}, {"type": "subtitle", "time": 16739.709, "timestamp": "04:38:59", "text": "私たちは"}]
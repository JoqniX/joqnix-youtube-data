[{"type": "subtitle", "time": 10200.23, "timestamp": "02:50:00", "text": "少しずつかじりながら行ったり来たり"}, {"type": "subtitle", "time": 10202.07, "timestamp": "02:50:02", "text": "さあ行くぞ、エイリアンの悪者を爆破する"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "顔。それは素晴らしい。おい、お前は運がいいな"}, {"type": "subtitle", "time": 10206.87, "timestamp": "02:50:06", "text": "あなたも私たちと一緒にここに住むことができますよ。私"}, {"type": "subtitle", "time": 10209.59, "timestamp": "02:50:09", "text": "お前らのくだらない人間関係なんてどうでもいい。私は"}, {"type": "subtitle", "time": 10211.429, "timestamp": "02:50:11", "text": "ただ、あなたは彼のことをほとんど知らないと言っているだけです。"}, {"type": "subtitle", "time": 10212.87, "timestamp": "02:50:12", "text": "本当に惹かれているの？"}, {"type": "subtitle", "time": 10214.87, "timestamp": "02:50:14", "text": "彼？ほとんどの宇宙人は同族としかセックスしない"}, {"type": "subtitle", "time": 10217.349, "timestamp": "02:50:17", "text": "種。さて、あなたは？あなたはただ"}, {"type": "subtitle", "time": 10219.59, "timestamp": "02:50:19", "text": "基本的に寝たことがあると言った"}, {"type": "subtitle", "time": 10221.75, "timestamp": "02:50:21", "text": "銀河系全体のすべて。うん、"}, {"type": "subtitle", "time": 10223.67, "timestamp": "02:50:23", "text": "でも私は落ちぶれた堕落者だ。あなたは"}, {"type": "subtitle", "time": 10225.19, "timestamp": "02:50:25", "text": "君にはこれから長い人生が待っている。それは"}, {"type": "subtitle", "time": 10227.91, "timestamp": "02:50:27", "text": "甘いというよりは、見下したような言い方だ。"}, {"type": "subtitle", "time": 10231.349, "timestamp": "02:50:31", "text": "何？いいえ。ほら、私たちはこれだけの時間を費やしてきたのに"}, {"type": "subtitle", "time": 10233.75, "timestamp": "02:50:33", "text": "同棲期間。私はあなたのことを気にかけています"}, {"type": "subtitle", "time": 10236.07, "timestamp": "02:50:36", "text": "さて、レスリー。まったくもう。私の名前は"}, {"type": "subtitle", "time": 10238.389, "timestamp": "02:50:38", "text": "リジー。さあ、彼女に私が気にかけていると言って"}, {"type": "subtitle", "time": 10244.309, "timestamp": "02:50:44", "text": "えっと、"}, {"type": "subtitle", "time": 10247.349, "timestamp": "02:50:47", "text": "すみません。いいえ、"}, {"type": "subtitle", "time": 10249.99, "timestamp": "02:50:49", "text": "しかし、私はこの失敗を許すつもりはない"}, {"type": "subtitle", "time": 10253.429, "timestamp": "02:50:53", "text": "堕落した学校が、人生の決断について私に教えてくれた。"}, {"type": "subtitle", "time": 10255.269, "timestamp": "02:50:55", "text": "私がダメ人間で堕落者であるという事実は"}, {"type": "subtitle", "time": 10256.87, "timestamp": "02:50:56", "text": "だからこそ、私に教えてもらいたいのです"}, {"type": "subtitle", "time": 10259.19, "timestamp": "02:50:59", "text": "人生における決断について。私は、"}]
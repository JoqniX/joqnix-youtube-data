[{"type": "subtitle", "time": 4560.229, "timestamp": "01:16:00", "text": "サーバーはちょうど"}, {"type": "subtitle", "time": 4564.39, "timestamp": "01:16:04", "text": "第2世代が発売されたとき、モーとアクラ"}, {"type": "subtitle", "time": 4566.79, "timestamp": "01:16:06", "text": "他の全員が出てきて、参加している"}, {"type": "subtitle", "time": 4568.95, "timestamp": "01:16:08", "text": "確立されたコミュニティの権利"}, {"type": "subtitle", "time": 4574.07, "timestamp": "01:16:14", "text": "第一世代は正しく作られました。そこで彼らがやったことは"}, {"type": "subtitle", "time": 4577.51, "timestamp": "01:16:17", "text": "モーと他の皆も一生懸命働いた"}, {"type": "subtitle", "time": 4579.99, "timestamp": "01:16:19", "text": "それで、彼らは自分たちのことをやって、"}, {"type": "subtitle", "time": 4581.79, "timestamp": "01:16:21", "text": "みんな一生懸命働いたから"}, {"type": "subtitle", "time": 4584.95, "timestamp": "01:16:24", "text": "あなたが企業系YouTuberなら、これはまさにそれだ"}, {"type": "subtitle", "time": 4587.91, "timestamp": "01:16:27", "text": "あなたは、ああ、私は参加していると感じるでしょう"}, {"type": "subtitle", "time": 4590.95, "timestamp": "01:16:30", "text": "確立されたコミュニティなので、"}, {"type": "subtitle", "time": 4592.709, "timestamp": "01:16:32", "text": "人々は私に多くのことを期待していて、"}, {"type": "subtitle", "time": 4595.75, "timestamp": "01:16:35", "text": "すべて正しいですが、あなたが"}, {"type": "subtitle", "time": 4598.31, "timestamp": "01:16:38", "text": "周囲に溶け込むか、溶け込まないか"}, {"type": "subtitle", "time": 4601.669, "timestamp": "01:16:41", "text": "そのコミュニティに溶け込むように"}, {"type": "subtitle", "time": 4604.229, "timestamp": "01:16:44", "text": "全員で集まるグループ。ゆっくりゆっくり"}, {"type": "subtitle", "time": 4606.55, "timestamp": "01:16:46", "text": "あなたは自分の"}, {"type": "subtitle", "time": 4609.11, "timestamp": "01:16:49", "text": "コミュニティまたはファンダム。右？まるで"}, {"type": "subtitle", "time": 4610.87, "timestamp": "01:16:50", "text": "それ。"}, {"type": "subtitle", "time": 4612.63, "timestamp": "01:16:52", "text": "ええと、Starscapeでは次のように見ることができます"}, {"type": "subtitle", "time": 4616.149, "timestamp": "01:16:56", "text": "良い。それぞれの才能は"}]
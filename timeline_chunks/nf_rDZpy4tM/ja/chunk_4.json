[{"type": "subtitle", "time": 241.47, "timestamp": "00:04:01", "text": "いいえ、そうではないようです"}, {"type": "subtitle", "time": 244.869, "timestamp": "00:04:04", "text": "いいえ。まあ、皆さんが元気でいることを願っています。"}, {"type": "subtitle", "time": 246.39, "timestamp": "00:04:06", "text": "良い。またやります。言っておきます"}, {"type": "subtitle", "time": 247.71, "timestamp": "00:04:07", "text": "また。何てことだ。"}, {"type": "subtitle", "time": 256.069, "timestamp": "00:04:16", "text": "皆さん、お元気ですか？うん。こんにちは。"}, {"type": "subtitle", "time": 262.629, "timestamp": "00:04:22", "text": "良い。さて、皆さんにとって今日はどんな一日でしたか？"}, {"type": "subtitle", "time": 265.99, "timestamp": "00:04:25", "text": "私にとっては、良い一日でした。私は"}, {"type": "subtitle", "time": 271.95, "timestamp": "00:04:31", "text": "目が覚めた。目が覚めて、いろいろした。私はそうしました"}, {"type": "subtitle", "time": 275.51, "timestamp": "00:04:35", "text": "いろいろと調べて少し歩いてから"}, {"type": "subtitle", "time": 277.83, "timestamp": "00:04:37", "text": "ここにいる。すると私は「ああ、いや、私は"}, {"type": "subtitle", "time": 280.95, "timestamp": "00:04:40", "text": "「ストリームがあります」と言われたので、「ああ、"}, {"type": "subtitle", "time": 295.15, "timestamp": "00:04:55", "text": "[音楽]"}, {"type": "subtitle", "time": 299.629, "timestamp": "00:04:59", "text": "まず、もっともっと。えっと、"}]
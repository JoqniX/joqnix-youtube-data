[{"type": "subtitle", "time": 15005.75, "timestamp": "04:10:05", "text": "えっと、待って。聞こえますか？よし、みんな"}, {"type": "subtitle", "time": 15007.67, "timestamp": "04:10:07", "text": "聞こえますか？いいね、いいね、いいね、いいね、いいね。"}, {"type": "subtitle", "time": 15018.11, "timestamp": "04:10:18", "text": "はぁ？どうして一部の人々は"}, {"type": "subtitle", "time": 15020.91, "timestamp": "04:10:20", "text": "遊ぶ？何？"}, {"type": "subtitle", "time": 15042.429, "timestamp": "04:10:42", "text": "ああ。"}, {"type": "subtitle", "time": 15047.79, "timestamp": "04:10:47", "text": "他の人はどうやってプレイできるのですか？"}]
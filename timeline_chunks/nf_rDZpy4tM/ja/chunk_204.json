[{"type": "subtitle", "time": 12241.79, "timestamp": "03:24:01", "text": "について話す"}, {"type": "subtitle", "time": 12244.15, "timestamp": "03:24:04", "text": "それ。うん。うん。私たちは話していました"}, {"type": "subtitle", "time": 12245.75, "timestamp": "03:24:05", "text": "もう一度言っていただけますか？うん。私は"}, {"type": "subtitle", "time": 12246.99, "timestamp": "03:24:06", "text": "について話す"}, {"type": "subtitle", "time": 12249.51, "timestamp": "03:24:09", "text": "あなたの書き方ですね。あなたは作っています"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "えっと、あなたがこれを書いた方法は"}, {"type": "subtitle", "time": 12254.15, "timestamp": "03:24:14", "text": "えーと、スカイリム。あなたは私たちに"}, {"type": "subtitle", "time": 12256.389, "timestamp": "03:24:16", "text": "反対。待って、どういう意味ですか"}, {"type": "subtitle", "time": 12258.71, "timestamp": "03:24:18", "text": "それ？待って、それはどういう意味ですか？"}, {"type": "subtitle", "time": 12261.11, "timestamp": "03:24:21", "text": "詳しく説明してくれ、アッシュ。待って、私は"}, {"type": "subtitle", "time": 12273.429, "timestamp": "03:24:33", "text": "待って、彼らのデビューを見て、"}, {"type": "subtitle", "time": 12275.63, "timestamp": "03:24:35", "text": "似たような声なら、私は幸せです"}, {"type": "subtitle", "time": 12285.87, "timestamp": "03:24:45", "text": "ああ"}, {"type": "subtitle", "time": 12289.349, "timestamp": "03:24:49", "text": "わかった。それで、前回あなたが"}, {"type": "subtitle", "time": 12291.75, "timestamp": "03:24:51", "text": "あなたが去るとき、この質問をしてください"}, {"type": "subtitle", "time": 12294.79, "timestamp": "03:24:54", "text": "あなたがグループにいる場合は、はい。できますか"}, {"type": "subtitle", "time": 12296.87, "timestamp": "03:24:56", "text": "グループを抜けてください。"}, {"type": "subtitle", "time": 12298.309, "timestamp": "03:24:58", "text": "あなたがグループの中にいる場合"}]
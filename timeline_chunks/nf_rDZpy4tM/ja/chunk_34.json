[{"type": "subtitle", "time": 2040.87, "timestamp": "00:34:00", "text": "この小惑星に関する法則。私たちは作ることができません"}, {"type": "subtitle", "time": 2043.19, "timestamp": "00:34:03", "text": "ルールは一切ありません。ここに住んでいるなら、"}, {"type": "subtitle", "time": 2046.549, "timestamp": "00:34:06", "text": "法律がなくても構わない。最後に、彼は"}, {"type": "subtitle", "time": 2048.55, "timestamp": "00:34:08", "text": "言った。"}, {"type": "subtitle", "time": 2057.03, "timestamp": "00:34:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2061.829, "timestamp": "00:34:21", "text": "やばい、またG3がトラブルを起こしてる。"}, {"type": "subtitle", "time": 2065.03, "timestamp": "00:34:25", "text": "ゴミ出しの時間だ。ああ、私は手に入れた"}, {"type": "subtitle", "time": 2066.71, "timestamp": "00:34:26", "text": "自信過剰だ。わからない。私は違います"}, {"type": "subtitle", "time": 2068.869, "timestamp": "00:34:28", "text": "確かにそうですね。ごめんなさい。私たちを見てください。"}, {"type": "subtitle", "time": 2071.52, "timestamp": "00:34:31", "text": "これはまだ始まりに過ぎない。生き延びろ。"}, {"type": "subtitle", "time": 2079.03, "timestamp": "00:34:39", "text": "[音楽]"}]
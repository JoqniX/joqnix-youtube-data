[{"type": "subtitle", "time": 1861.43, "timestamp": "00:31:01", "text": "ドラッグタウンは新しい街だ。旧市街には"}, {"type": "subtitle", "time": 1863.83, "timestamp": "00:31:03", "text": "心臓。実際の目的を果たすために使用されました"}, {"type": "subtitle", "time": 1866.63, "timestamp": "00:31:06", "text": "人々。ドラッグタウンはただの穴"}, {"type": "subtitle", "time": 1870.789, "timestamp": "00:31:10", "text": "放蕩と麻薬。コンサンG3"}, {"type": "subtitle", "time": 1876.71, "timestamp": "00:31:16", "text": "ドレーはどこ？入口はどこですか"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "ドレイクタウン？ああ、それは簡単だよ。行くだけ"}, {"type": "subtitle", "time": 1881.35, "timestamp": "00:31:21", "text": "この門をくぐって旧市街へ行き、"}, {"type": "subtitle", "time": 1883.59, "timestamp": "00:31:23", "text": "そして、メインストリートをまっすぐ下っていく。"}, {"type": "subtitle", "time": 1885.59, "timestamp": "00:31:25", "text": "ドレイクタウンは見逃せません"}, {"type": "subtitle", "time": 1888.31, "timestamp": "00:31:28", "text": "入り口。本当にひどい景観を損なうものだ。"}, {"type": "subtitle", "time": 1890.389, "timestamp": "00:31:30", "text": "あれをなくしてほしい。私は開けます"}, {"type": "subtitle", "time": 1892.71, "timestamp": "00:31:32", "text": "あなたのためのゲートです。"}, {"type": "subtitle", "time": 1894.63, "timestamp": "00:31:34", "text": "おい、グランディ。啓示を受ける。ダジャレ"}, {"type": "subtitle", "time": 1897.669, "timestamp": "00:31:37", "text": "意図した。大丈夫だよ、ブランディ。そして"}, {"type": "subtitle", "time": 1901.11, "timestamp": "00:31:41", "text": "もちろん、私の仕事全体に反する発言だ。"}, {"type": "subtitle", "time": 1903.99, "timestamp": "00:31:43", "text": "それが私がここにいる理由です。喜んでやります"}, {"type": "subtitle", "time": 1906.31, "timestamp": "00:31:46", "text": "穏やかで若いゴミのような"}, {"type": "subtitle", "time": 1910.95, "timestamp": "00:31:50", "text": "あなた。何か見逃した場所はありますか？"}, {"type": "subtitle", "time": 1913.509, "timestamp": "00:31:53", "text": "楽しかったね、末っ子。やったー！"}, {"type": "subtitle", "time": 1915.909, "timestamp": "00:31:55", "text": "昨夜のパーティーはすごかったね。あなたは"}, {"type": "subtitle", "time": 1918.23, "timestamp": "00:31:58", "text": "ダグラスがどれだけ酔っ払ったか見てみろよ？もちろんさ。"}]
[{"type": "subtitle", "time": 7560.669, "timestamp": "02:06:00", "text": "これ。ああ、万歳。プリミー、"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "なぜそんなに彼らを殺したいのですか？私は"}, {"type": "subtitle", "time": 7590.31, "timestamp": "02:06:30", "text": "あなたはこういうのが本当に得意ですね。一部の人々"}, {"type": "subtitle", "time": 7591.95, "timestamp": "02:06:31", "text": "ビジネスとかそういうのを卒業するけど、"}, {"type": "subtitle", "time": 7596.149, "timestamp": "02:06:36", "text": "その物の背後にあるすべて。うん、それ"}, {"type": "subtitle", "time": 7598.31, "timestamp": "02:06:38", "text": "それはNaについても同様です。いくつかの"}, {"type": "subtitle", "time": 7600.43, "timestamp": "02:06:40", "text": "人々はそうするだろう。"}, {"type": "subtitle", "time": 7604.149, "timestamp": "02:06:44", "text": "はい。その通り。"}, {"type": "subtitle", "time": 7607.229, "timestamp": "02:06:47", "text": "ああ、これは"}, {"type": "subtitle", "time": 7618.51, "timestamp": "02:06:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 14041.91, "timestamp": "03:54:01", "text": "私の配信を見て、来て、"}, {"type": "subtitle", "time": 14043.67, "timestamp": "03:54:03", "text": "コメントする際は、必ず以下のことを行ってください。"}, {"type": "subtitle", "time": 14046.79, "timestamp": "03:54:06", "text": "そしてそれは、彼らのほとんどがそうしないからである"}, {"type": "subtitle", "time": 14048.95, "timestamp": "03:54:08", "text": "チューブが何なのかとか、そういうことは知ってるよね？"}, {"type": "subtitle", "time": 14051.63, "timestamp": "03:54:11", "text": "あまり人気がない"}, {"type": "subtitle", "time": 14055.11, "timestamp": "03:54:15", "text": "ここはアニメと全く同じですよね"}, {"type": "subtitle", "time": 14056.63, "timestamp": "03:54:16", "text": "知らない人もいる"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "そうですね、だからもしあなたが知っているなら"}, {"type": "subtitle", "time": 14066.91, "timestamp": "03:54:26", "text": "あなたはまるで"}, {"type": "subtitle", "time": 14071.03, "timestamp": "03:54:31", "text": "昔はすべての"}, {"type": "subtitle", "time": 14073.11, "timestamp": "03:54:33", "text": "Instagram の投稿、または他のソーシャル"}, {"type": "subtitle", "time": 14074.87, "timestamp": "03:54:34", "text": "物、あなたは私が以前は"}, {"type": "subtitle", "time": 14076.59, "timestamp": "03:54:36", "text": "好き"}, {"type": "subtitle", "time": 14079.79, "timestamp": "03:54:39", "text": "千。ええ、約1000人です。"}, {"type": "subtitle", "time": 14082.91, "timestamp": "03:54:42", "text": "Instagramのフォロワーは、"}, {"type": "subtitle", "time": 14085.83, "timestamp": "03:54:45", "text": "それ。うん、ペッドしたよ。今は800か"}, {"type": "subtitle", "time": 14088.229, "timestamp": "03:54:48", "text": "900。わからない。"}, {"type": "subtitle", "time": 14095.71, "timestamp": "03:54:55", "text": "私を知っている人たちの理事会と"}, {"type": "subtitle", "time": 14098.55, "timestamp": "03:54:58", "text": "すべては、当時私が知らなかったからです。"}]
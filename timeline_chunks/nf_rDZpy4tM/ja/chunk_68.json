[{"type": "subtitle", "time": 4081.43, "timestamp": "01:08:01", "text": "このG3フェイスは、"}, {"type": "subtitle", "time": 4101.269, "timestamp": "01:08:21", "text": "私はチームメイトを殺した。後で、お母さん。"}, {"type": "subtitle", "time": 4107.789, "timestamp": "01:08:27", "text": "[拍手]"}, {"type": "subtitle", "time": 4110.87, "timestamp": "01:08:30", "text": "手榴弾の。手榴弾、手榴弾。来る"}, {"type": "subtitle", "time": 4121.43, "timestamp": "01:08:41", "text": "あなたは私に向かって発砲している。"}]
[{"type": "subtitle", "time": 12840.63, "timestamp": "03:34:00", "text": "それ。それは私に心を開いて"}, {"type": "subtitle", "time": 12843.469, "timestamp": "03:34:03", "text": "感情を吐き出して"}, {"type": "subtitle", "time": 12846.67, "timestamp": "03:34:06", "text": "もの。涙が出てくる。ああ、"}, {"type": "subtitle", "time": 12849.91, "timestamp": "03:34:09", "text": "神。しかし、私たちは"}, {"type": "subtitle", "time": 12853.269, "timestamp": "03:34:13", "text": "音楽はかけてるよね？長い間"}, {"type": "subtitle", "time": 12854.83, "timestamp": "03:34:14", "text": "なぜなら"}, {"type": "subtitle", "time": 12863.389, "timestamp": "03:34:23", "text": "なんてこった。とにかく、私は"}, {"type": "subtitle", "time": 12866.67, "timestamp": "03:34:26", "text": "私の"}, {"type": "subtitle", "time": 12869.429, "timestamp": "03:34:29", "text": "最高。えっと、できるかどうかわかりません"}, {"type": "subtitle", "time": 12871.469, "timestamp": "03:34:31", "text": "最高"}, {"type": "subtitle", "time": 12874.75, "timestamp": "03:34:34", "text": "皆さんに適切な"}, {"type": "subtitle", "time": 12878.11, "timestamp": "03:34:38", "text": "オリジナルサウンドトラック。できれば"}, {"type": "subtitle", "time": 12880.03, "timestamp": "03:34:40", "text": "いつか。"}, {"type": "subtitle", "time": 12883.99, "timestamp": "03:34:43", "text": "しかし今のところは、このアカウントを使用します。"}, {"type": "subtitle", "time": 12887.11, "timestamp": "03:34:47", "text": "いつか良い日が来るまで、私は自分の"}, {"type": "subtitle", "time": 12895.98, "timestamp": "03:34:55", "text": "もの。でも私は最善を尽くしますし、"}, {"type": "subtitle", "time": 12898.11, "timestamp": "03:34:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 13681.11, "timestamp": "03:48:01", "text": "そこには。シャワーがたくさんあるみたい"}, {"type": "subtitle", "time": 13684.429, "timestamp": "03:48:04", "text": "そして私が作りたい料理"}, {"type": "subtitle", "time": 13688.03, "timestamp": "03:48:08", "text": "整理整頓が好きで、"}, {"type": "subtitle", "time": 13692.07, "timestamp": "03:48:12", "text": "すべて。私は自分のサーバーを"}, {"type": "subtitle", "time": 13694.03, "timestamp": "03:48:14", "text": "新しいものをテストするためのテスト場"}, {"type": "subtitle", "time": 13696.269, "timestamp": "03:48:16", "text": "[音楽]"}, {"type": "subtitle", "time": 13699.63, "timestamp": "03:48:19", "text": "いろいろあって、やっと長い間"}, {"type": "subtitle", "time": 13704.469, "timestamp": "03:48:24", "text": "私は何年も前から自分のシャベルを修理している。"}, {"type": "subtitle", "time": 13707.75, "timestamp": "03:48:27", "text": "ストリーミングみたいなのは残念だね、明らか"}, {"type": "subtitle", "time": 13709.91, "timestamp": "03:48:29", "text": "もの。助けが必要な方は、"}, {"type": "subtitle", "time": 13712.57, "timestamp": "03:48:32", "text": "技術的なことに関しては、私はただ手伝っているだけです。"}, {"type": "subtitle", "time": 13714.389, "timestamp": "03:48:34", "text": "[音楽]"}, {"type": "subtitle", "time": 13717.429, "timestamp": "03:48:37", "text": "そして時々、本当にそう思うようになる"}, {"type": "subtitle", "time": 13720.63, "timestamp": "03:48:40", "text": "ストリーミング配信中でもマルチタスクを心がけています"}, {"type": "subtitle", "time": 13722.71, "timestamp": "03:48:42", "text": "彼ら自身もそういう類のものだ"}, {"type": "subtitle", "time": 13725.309, "timestamp": "03:48:45", "text": "Discord のステータスが見当たらないのですが、"}, {"type": "subtitle", "time": 13727.87, "timestamp": "03:48:47", "text": "紫色は私が"}, {"type": "subtitle", "time": 13730.229, "timestamp": "03:48:50", "text": "ストリーミング配信はするが、それでも彼らには言わない"}, {"type": "subtitle", "time": 13733.189, "timestamp": "03:48:53", "text": "私がストリーミング配信しているのですが、私が手伝い始めます"}, {"type": "subtitle", "time": 13736.229, "timestamp": "03:48:56", "text": "彼ら。しばらくして気づいたのですが"}, {"type": "subtitle", "time": 13738.59, "timestamp": "03:48:58", "text": "私がやっている間"}]
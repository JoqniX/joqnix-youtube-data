[{"type": "subtitle", "time": 5581.95, "timestamp": "01:33:01", "text": "右？彼らは自分たちのコスプレをしている"}, {"type": "subtitle", "time": 5583.91, "timestamp": "01:33:03", "text": "キャラクター。彼らには法律があり、"}, {"type": "subtitle", "time": 5585.83, "timestamp": "01:33:05", "text": "すべて。かっこいいと思わない？どこに"}, {"type": "subtitle", "time": 5588.07, "timestamp": "01:33:08", "text": "これ、見た？どこかで見たことありますか？"}, {"type": "subtitle", "time": 5591.51, "timestamp": "01:33:11", "text": "それ以外？ええと、西部劇でも"}, {"type": "subtitle", "time": 5595.35, "timestamp": "01:33:15", "text": "そして、他の他の場所"}, {"type": "subtitle", "time": 5597.51, "timestamp": "01:33:17", "text": "日本国内でも、あるいは世界中どこでも。ご覧になりましたか？"}, {"type": "subtitle", "time": 5600.95, "timestamp": "01:33:20", "text": "コスプレ配信はどこでもできます"}, {"type": "subtitle", "time": 5603.35, "timestamp": "01:33:23", "text": "V2 と全く同じようなものです"}, {"type": "subtitle", "time": 5605.55, "timestamp": "01:33:25", "text": "兄弟だが"}, {"type": "subtitle", "time": 5607.87, "timestamp": "01:33:27", "text": "うん、君は"}, {"type": "subtitle", "time": 5611.43, "timestamp": "01:33:31", "text": "君は、そう、君は、自分のキャラクターのコスプレをする"}, {"type": "subtitle", "time": 5612.43, "timestamp": "01:33:32", "text": "そして"}, {"type": "subtitle", "time": 5616.07, "timestamp": "01:33:36", "text": "もの。そう、それはまるで大きな脳のようで、"}, {"type": "subtitle", "time": 5618.43, "timestamp": "01:33:38", "text": "右？とても大きい"}, {"type": "subtitle", "time": 5630.47, "timestamp": "01:33:50", "text": "ええ、めったにありません。まあ、そうですね。この男は何者だ？"}, {"type": "subtitle", "time": 5631.91, "timestamp": "01:33:51", "text": "何をしているの？この男はそこで何をしているんだ？"}, {"type": "subtitle", "time": 5633.75, "timestamp": "01:33:53", "text": "やめて。今回は殺さないよ。"}, {"type": "subtitle", "time": 5635.149, "timestamp": "01:33:55", "text": "彼はただ見ているだけだ"}, {"type": "subtitle", "time": 5637.87, "timestamp": "01:33:57", "text": "ああ、なんてことだ"}]
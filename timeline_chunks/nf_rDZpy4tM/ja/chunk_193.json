[{"type": "subtitle", "time": 11581.67, "timestamp": "03:13:01", "text": "ストライク、もしくは中空レンズへ"}, {"type": "subtitle", "time": 11583.51, "timestamp": "03:13:03", "text": "中空の星と、変更してください"}, {"type": "subtitle", "time": 11585.15, "timestamp": "03:13:05", "text": "モデルか何か。"}, {"type": "subtitle", "time": 11588.99, "timestamp": "03:13:08", "text": "いいえ、できません。この瞬間、私は"}, {"type": "subtitle", "time": 11592.91, "timestamp": "03:13:12", "text": "できません。また、"}, {"type": "subtitle", "time": 11596.03, "timestamp": "03:13:16", "text": "Vubingでは、私は次の事実を受け入れなければならない"}, {"type": "subtitle", "time": 11599.71, "timestamp": "03:13:19", "text": "ええ、もし自分自身のことなら、"}, {"type": "subtitle", "time": 11602.95, "timestamp": "03:13:22", "text": "右？それは都市伝説か何かだと思う。"}, {"type": "subtitle", "time": 11605.03, "timestamp": "03:13:25", "text": "それが本当かどうかはわかりませんが、"}, {"type": "subtitle", "time": 11605.95, "timestamp": "03:13:25", "text": "なれ"}, {"type": "subtitle", "time": 11609.83, "timestamp": "03:13:29", "text": "外にいる7人が7人好き"}, {"type": "subtitle", "time": 11612.55, "timestamp": "03:13:32", "text": "現実のあなたの見た目と同じです。できる"}, {"type": "subtitle", "time": 11615.51, "timestamp": "03:13:35", "text": "他にも7人が世界中に散らばっている"}, {"type": "subtitle", "time": 11617.91, "timestamp": "03:13:37", "text": "あなたとそっくりな世界、または"}, {"type": "subtitle", "time": 11618.91, "timestamp": "03:13:38", "text": "何か、"}, {"type": "subtitle", "time": 11622.389, "timestamp": "03:13:42", "text": "右？まさにその通り。同じことが"}, {"type": "subtitle", "time": 11625.15, "timestamp": "03:13:45", "text": "vtubeingについて次のように述べた"}, {"type": "subtitle", "time": 11628.87, "timestamp": "03:13:48", "text": "良い。それは事実を受け入れる、そう、"}, {"type": "subtitle", "time": 11630.79, "timestamp": "03:13:50", "text": "vtubeingに関しては、誰でも作成できます"}, {"type": "subtitle", "time": 11633.429, "timestamp": "03:13:53", "text": "彼ら自身の夢の中の登場人物たち。"}, {"type": "subtitle", "time": 11635.51, "timestamp": "03:13:55", "text": "彼らはそれを修正できる。彼らは変わることができる"}, {"type": "subtitle", "time": 11638.15, "timestamp": "03:13:58", "text": "彼らの持ち物。彼らは何にでも従うことができる"}]
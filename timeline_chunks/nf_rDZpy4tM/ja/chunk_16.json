[{"type": "subtitle", "time": 962.71, "timestamp": "00:16:02", "text": "ああ、そうだね。はい、もちろん。お前を埋葬してやる。"}, {"type": "subtitle", "time": 964.47, "timestamp": "00:16:04", "text": "はい、私は何よりもあなたを愛しています"}, {"type": "subtitle", "time": 979.949, "timestamp": "00:16:19", "text": "ああ、大変だ。待って、"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "ガス。砂漠に行ったことはありますか？"}, {"type": "subtitle", "time": 985.509, "timestamp": "00:16:25", "text": "最悪だ。ガスはショットガン射撃が得意だ。"}, {"type": "subtitle", "time": 987.67, "timestamp": "00:16:27", "text": "ブラックフライデーセール。あなたは遅れて到着し、"}, {"type": "subtitle", "time": 989.269, "timestamp": "00:16:29", "text": "良いものばかり。あなたの"}, {"type": "subtitle", "time": 991.509, "timestamp": "00:16:31", "text": "サイズ。左側を掴む。クソは"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "床と、すべての人々が争っている"}, {"type": "subtitle", "time": 995.43, "timestamp": "00:16:35", "text": "もの。それが砂漠というものだ。いいえ"}, {"type": "subtitle", "time": 997.749, "timestamp": "00:16:37", "text": "ここはいいものばかりだ。"}, {"type": "subtitle", "time": 999.79, "timestamp": "00:16:39", "text": "ああ、私の"}, {"type": "subtitle", "time": 1011.749, "timestamp": "00:16:51", "text": "彼ら？ああ、彼らはあなたを上に押し上げる。"}]
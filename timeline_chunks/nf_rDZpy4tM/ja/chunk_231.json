[{"type": "subtitle", "time": 13861.79, "timestamp": "03:51:01", "text": "良い友達と有害な"}, {"type": "subtitle", "time": 13864.79, "timestamp": "03:51:04", "text": "友達。うん。うん。そうやって私は"}, {"type": "subtitle", "time": 13866.51, "timestamp": "03:51:06", "text": "手放さなければならなかった"}, {"type": "subtitle", "time": 13869.309, "timestamp": "03:51:09", "text": "いくつかの"}, {"type": "subtitle", "time": 13873.59, "timestamp": "03:51:13", "text": "フランス語。ブロックもやらなければならなかった"}, {"type": "subtitle", "time": 13880.91, "timestamp": "03:51:20", "text": "もの。いつも仲直りして"}, {"type": "subtitle", "time": 13885.03, "timestamp": "03:51:25", "text": "物、メイクアップ、そして私はいつも"}, {"type": "subtitle", "time": 13887.269, "timestamp": "03:51:27", "text": "化粧をしていた人。わからない"}, {"type": "subtitle", "time": 13889.91, "timestamp": "03:51:29", "text": "彼らが気にするかどうかは別として、まあ、そうだね。うん。もの"}, {"type": "subtitle", "time": 13891.309, "timestamp": "03:51:31", "text": "そんな感じ。"}, {"type": "subtitle", "time": 13894.389, "timestamp": "03:51:34", "text": "えっと、ブラシブラシ。うん。ああ、なんてことだ、"}, {"type": "subtitle", "time": 13896.71, "timestamp": "03:51:36", "text": "この音楽は私を心を開放させてくれる。おお"}, {"type": "subtitle", "time": 13899.07, "timestamp": "03:51:39", "text": "我が神よ。何てことだ。これ"}, {"type": "subtitle", "time": 13902.95, "timestamp": "03:51:42", "text": "音楽 なぜOSTは私にとってこんなに聞こえるのか"}, {"type": "subtitle", "time": 13905.71, "timestamp": "03:51:45", "text": "ああ、黙れ"}, {"type": "subtitle", "time": 13908.309, "timestamp": "03:51:48", "text": "餌。もし私が"}, {"type": "subtitle", "time": 13915.59, "timestamp": "03:51:55", "text": "音楽。それはトランプゲームだ。うん。"}, {"type": "subtitle", "time": 13917.67, "timestamp": "03:51:57", "text": "記憶の想起。回想"}, {"type": "subtitle", "time": 13919.55, "timestamp": "03:51:59", "text": "の"}]
[{"type": "subtitle", "time": 16031.149, "timestamp": "04:27:11", "text": "盛り上がっている。ああ、"}, {"type": "subtitle", "time": 16034.11, "timestamp": "04:27:14", "text": "ああ、戦闘システムを見てください。おお、"}, {"type": "subtitle", "time": 16042.389, "timestamp": "04:27:22", "text": "いいね。電話の電源を入れようとしたが"}, {"type": "subtitle", "time": 16052.71, "timestamp": "04:27:32", "text": "主はすべてを見ておられる。すべては良いことのように見えるかもしれないし、"}, {"type": "subtitle", "time": 16055.269, "timestamp": "04:27:35", "text": "今はここは静かだけど、いつ何が起こるかわからない"}, {"type": "subtitle", "time": 16057.75, "timestamp": "04:27:37", "text": "酸っぱい不和が突然現れるかもしれない"}, {"type": "subtitle", "time": 16077.349, "timestamp": "04:27:57", "text": "ああ、これは楽しい。ああ、これは楽しい。"}, {"type": "subtitle", "time": 16079.269, "timestamp": "04:27:59", "text": "ノートパソコンで入手した方が良いでしょう。えっと、ただ"}]
[{"type": "subtitle", "time": 12721.99, "timestamp": "03:32:01", "text": "彼らはあらゆることにおいて結果を示さなければならない。または"}, {"type": "subtitle", "time": 12725.03, "timestamp": "03:32:05", "text": "さもないと解雇されるか、"}, {"type": "subtitle", "time": 12728.15, "timestamp": "03:32:08", "text": "言い訳や延長、そして言い訳ではないもの"}, {"type": "subtitle", "time": 12730.389, "timestamp": "03:32:10", "text": "締め切りとかそういうの知ってるでしょ？"}, {"type": "subtitle", "time": 12732.429, "timestamp": "03:32:12", "text": "それらすべてを提供するために、"}, {"type": "subtitle", "time": 12734.95, "timestamp": "03:32:14", "text": "それ。でも、自分でやるなら"}, {"type": "subtitle", "time": 12738.229, "timestamp": "03:32:18", "text": "ある種の自由があるが、"}, {"type": "subtitle", "time": 12739.95, "timestamp": "03:32:19", "text": "もしあなたがそれだけの金額を持っているなら"}, {"type": "subtitle", "time": 12743.349, "timestamp": "03:32:23", "text": "自由とは、怠けることもあるけれど"}, {"type": "subtitle", "time": 12744.51, "timestamp": "03:32:24", "text": "もしあなたが"}, {"type": "subtitle", "time": 12747.67, "timestamp": "03:32:27", "text": "情熱を持っていれば、"}, {"type": "subtitle", "time": 12749.59, "timestamp": "03:32:29", "text": "手を抜く。あなたは最善を尽くし続けるでしょう"}, {"type": "subtitle", "time": 12750.349, "timestamp": "03:32:30", "text": "のように"}, {"type": "subtitle", "time": 12752.79, "timestamp": "03:32:32", "text": "そうですよね？それは、"}, {"type": "subtitle", "time": 12755.95, "timestamp": "03:32:35", "text": "それ。与えることを真剣に受け止めないでください"}, {"type": "subtitle", "time": 12760.15, "timestamp": "03:32:40", "text": "もの。つまり、あなたがそうしたいなら、そうしてもいいということです。"}, {"type": "subtitle", "time": 12767.51, "timestamp": "03:32:47", "text": "シャ。では、えーと、続きを"}, {"type": "subtitle", "time": 12770.15, "timestamp": "03:32:50", "text": "その頃にやって来た人々。ヴァイガタ"}, {"type": "subtitle", "time": 12772.389, "timestamp": "03:32:52", "text": "通りかかるよ。今日は楽しんでいただけたでしょうか。希望"}, {"type": "subtitle", "time": 12774.99, "timestamp": "03:32:54", "text": "あなたにとって楽しかった"}, {"type": "subtitle", "time": 12778.03, "timestamp": "03:32:58", "text": "来るよ。そしてマヤサンもやって来た"}]
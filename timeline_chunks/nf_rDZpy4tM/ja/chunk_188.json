[{"type": "subtitle", "time": 11282.429, "timestamp": "03:08:02", "text": "もしかしたらそうかもしれないけど、わからない。だから"}, {"type": "subtitle", "time": 11285.95, "timestamp": "03:08:05", "text": "朝、DMが届きました"}, {"type": "subtitle", "time": 11289.55, "timestamp": "03:08:09", "text": "ジョック、君はホルにいるよ。"}, {"type": "subtitle", "time": 11292.67, "timestamp": "03:08:12", "text": "何？ジョック、君は参加するよ"}, {"type": "subtitle", "time": 11297.19, "timestamp": "03:08:17", "text": "ホル、君はホルにいるの？ バブ、何？私はこう思った。"}, {"type": "subtitle", "time": 11300.469, "timestamp": "03:08:20", "text": "「え？何？」それからホログラムを見た"}, {"type": "subtitle", "time": 11302.469, "timestamp": "03:08:22", "text": "星"}, {"type": "subtitle", "time": 11305.39, "timestamp": "03:08:25", "text": "えっと、ホログラムの星みたいなやつと、"}, {"type": "subtitle", "time": 11307.63, "timestamp": "03:08:27", "text": "[音楽]"}, {"type": "subtitle", "time": 11311.19, "timestamp": "03:08:31", "text": "見た、私はある意味で"}, {"type": "subtitle", "time": 11314.32, "timestamp": "03:08:34", "text": "私は幸せですが、ある意味では"}, {"type": "subtitle", "time": 11315.95, "timestamp": "03:08:35", "text": "[音楽]"}, {"type": "subtitle", "time": 11318.19, "timestamp": "03:08:38", "text": "私はそう思わない"}, {"type": "subtitle", "time": 11321.71, "timestamp": "03:08:41", "text": "ある意味、涙が止まらなくなった"}, {"type": "subtitle", "time": 11325.83, "timestamp": "03:08:45", "text": "推測。わからない。私はとても"}, {"type": "subtitle", "time": 11327.79, "timestamp": "03:08:47", "text": "非常に敏感な"}, {"type": "subtitle", "time": 11334.67, "timestamp": "03:08:54", "text": "泣き虫は"}, {"type": "subtitle", "time": 11336.95, "timestamp": "03:08:56", "text": "ホロスターズを知らないなら"}]
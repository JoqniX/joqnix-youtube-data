[{"type": "subtitle", "time": 4742.27, "timestamp": "01:19:02", "text": "取るか好きになるか"}, {"type": "subtitle", "time": 4745.91, "timestamp": "01:19:05", "text": "ええと、別の企業"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "例えば、仮想現実が挙げられますね。だから"}, {"type": "subtitle", "time": 4753.51, "timestamp": "01:19:13", "text": "仮想的I仮想主義彼らは"}, {"type": "subtitle", "time": 4755.51, "timestamp": "01:19:15", "text": "ゼロから始める。それを覚えておいてください"}, {"type": "subtitle", "time": 4757.75, "timestamp": "01:19:17", "text": "彼らはゼロから始めることになる"}, {"type": "subtitle", "time": 4761.189, "timestamp": "01:19:21", "text": "パラドス・ゲンが出てくる。彼らは"}, {"type": "subtitle", "time": 4764.55, "timestamp": "01:19:24", "text": "スタースケープのように最善を尽くす"}, {"type": "subtitle", "time": 4767.189, "timestamp": "01:19:27", "text": "した。しかし、彼らは配信を行った。彼らは"}, {"type": "subtitle", "time": 4769.83, "timestamp": "01:19:29", "text": "たくさんの配信をして、視聴者と交流しました"}, {"type": "subtitle", "time": 4772.229, "timestamp": "01:19:32", "text": "ゆっくりとやってきた人々と共に"}, {"type": "subtitle", "time": 4774.79, "timestamp": "01:19:34", "text": "他の誰もが知るようになった"}, {"type": "subtitle", "time": 4776.63, "timestamp": "01:19:36", "text": "まさに星空そのもの。仮想主義"}, {"type": "subtitle", "time": 4778.95, "timestamp": "01:19:38", "text": "同じことをするだろう"}, {"type": "subtitle", "time": 4781.43, "timestamp": "01:19:41", "text": "例えば、第一世​​代の"}, {"type": "subtitle", "time": 4784.63, "timestamp": "01:19:44", "text": "仮想現実の1年くらい、あるいは"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "6、7か月後、次の"}, {"type": "subtitle", "time": 4788.79, "timestamp": "01:19:48", "text": "gen が来ると、彼らは同じことをしなければならない"}, {"type": "subtitle", "time": 4790.79, "timestamp": "01:19:50", "text": "タスクケープとして、彼らも働かなければならない"}, {"type": "subtitle", "time": 4793.27, "timestamp": "01:19:53", "text": "彼らが参加する最も困難なこと"}, {"type": "subtitle", "time": 4795.189, "timestamp": "01:19:55", "text": "多くの期待が寄せられ、"}, {"type": "subtitle", "time": 4796.95, "timestamp": "01:19:56", "text": "いろいろあるけど、それでも彼らは自分たちのことをするだろう"}]
[{"type": "subtitle", "time": 14641.51, "timestamp": "04:04:01", "text": "けれど。それがうまくいくといいですね。なぜしないのか"}, {"type": "subtitle", "time": 14644.55, "timestamp": "04:04:04", "text": "あなたはアイゼンのような音楽を作っているのですか？私"}, {"type": "subtitle", "time": 14649.91, "timestamp": "04:04:09", "text": "最高。さて、そろそろ配信を終了します。"}, {"type": "subtitle", "time": 14652.11, "timestamp": "04:04:12", "text": "ありがとうございます"}, {"type": "subtitle", "time": 14664.87, "timestamp": "04:04:24", "text": "本日はありがとうございました。ありがとうございます"}, {"type": "subtitle", "time": 14667.189, "timestamp": "04:04:27", "text": "私の話を聞いてください。私の話を聞いて"}, {"type": "subtitle", "time": 14670.15, "timestamp": "04:04:30", "text": "終わりというのは本当に大きな意味を持つ。すべてのロッカー"}, {"type": "subtitle", "time": 14671.83, "timestamp": "04:04:31", "text": "来てくれた皆さん、注目してくれてありがとう"}, {"type": "subtitle", "time": 14674.229, "timestamp": "04:04:34", "text": "小川。ありがとう"}, {"type": "subtitle", "time": 14676.79, "timestamp": "04:04:36", "text": "私たちと交流したり、いろいろとしてくれた。本当に"}, {"type": "subtitle", "time": 14678.189, "timestamp": "04:04:38", "text": "意味する"}, {"type": "subtitle", "time": 14681.79, "timestamp": "04:04:41", "text": "多く。そしてミンギアも"}, {"type": "subtitle", "time": 14684.71, "timestamp": "04:04:44", "text": "ミンギア、来てくれてありがとう、そして"}, {"type": "subtitle", "time": 14687.189, "timestamp": "04:04:47", "text": "ロンシアへようこそ。"}, {"type": "subtitle", "time": 14691.03, "timestamp": "04:04:51", "text": "お越しいただきありがとうございます。あなたがそうできることを願っています"}, {"type": "subtitle", "time": 14692.55, "timestamp": "04:04:52", "text": "将来ぜひお越しください"}, {"type": "subtitle", "time": 14695.309, "timestamp": "04:04:55", "text": "ストリームとトーク"}, {"type": "subtitle", "time": 14699.03, "timestamp": "04:04:59", "text": "もっと。ありがとう。こんにちは。私たちは"}]
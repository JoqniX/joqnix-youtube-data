[{"type": "subtitle", "time": 14820.95, "timestamp": "04:07:00", "text": "[拍手]"}, {"type": "subtitle", "time": 14842.269, "timestamp": "04:07:22", "text": "こんにちは"}, {"type": "subtitle", "time": 14846.07, "timestamp": "04:07:26", "text": "みんな。 W1。皆さん、おはようございます。ああ、"}, {"type": "subtitle", "time": 14849.269, "timestamp": "04:07:29", "text": "神。皆さん、今日の調子はいかがですか？ああ、"}, {"type": "subtitle", "time": 14851.229, "timestamp": "04:07:31", "text": "神。お元気ですか？"}, {"type": "subtitle", "time": 14852.75, "timestamp": "04:07:32", "text": "みんな？"}, {"type": "subtitle", "time": 14857.269, "timestamp": "04:07:37", "text": "こんにちは。遅刻していないといいのですが。何てことだ。"}, {"type": "subtitle", "time": 14859.59, "timestamp": "04:07:39", "text": "サーバーがリリースされました。私は"}, {"type": "subtitle", "time": 14862.79, "timestamp": "04:07:42", "text": "CNを見ていたんだけど"}, {"type": "subtitle", "time": 14865.349, "timestamp": "04:07:45", "text": "配信ストリームがあり、"}, {"type": "subtitle", "time": 14868.15, "timestamp": "04:07:48", "text": "遊ぶ。私は「ああ」と思った。その時私は私だった"}, {"type": "subtitle", "time": 14870.269, "timestamp": "04:07:50", "text": "ロコに乗り込んだ"}, {"type": "subtitle", "time": 14873.95, "timestamp": "04:07:53", "text": "ストリーム。私の親友"}, {"type": "subtitle", "time": 14877.269, "timestamp": "04:07:57", "text": "Rocoとグローバルサーバーも"}]
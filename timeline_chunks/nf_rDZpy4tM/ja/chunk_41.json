[{"type": "subtitle", "time": 2461.27, "timestamp": "00:41:01", "text": "自分。私の本名です。私の両親でさえ"}, {"type": "subtitle", "time": 2469.109, "timestamp": "00:41:09", "text": "あなたはどうですか？なんでしょう？新しい"}, {"type": "subtitle", "time": 2471.349, "timestamp": "00:41:11", "text": "旧市街へ？あなたはただ"}, {"type": "subtitle", "time": 2473.91, "timestamp": "00:41:13", "text": "見知らぬ人に近づいて話しかける？"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "だって、そうするのは全然問題ないから。"}, {"type": "subtitle", "time": 2478.829, "timestamp": "00:41:18", "text": "君は私を怖がらせそうになったよ"}, {"type": "subtitle", "time": 2481.91, "timestamp": "00:41:21", "text": "そこには。あなたはどうですか？種は本当に"}, {"type": "subtitle", "time": 2484.95, "timestamp": "00:41:24", "text": "アルコール耐性。それで、私はちょうど買ったので"}, {"type": "subtitle", "time": 2487.03, "timestamp": "00:41:27", "text": "アルコールをさらに摂取して"}, {"type": "subtitle", "time": 2489.19, "timestamp": "00:41:29", "text": "ほんのわずかな瞬間。良い１日を。持っている"}, {"type": "subtitle", "time": 2492.71, "timestamp": "00:41:32", "text": "数分後になります。こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 2496.39, "timestamp": "00:41:36", "text": "これからあなたの一日が始まる。"}, {"type": "subtitle", "time": 2499.15, "timestamp": "00:41:39", "text": "元気です。私はちょっとえーと"}, {"type": "subtitle", "time": 2501.589, "timestamp": "00:41:41", "text": "バカげてる。わからない。私は"}, {"type": "subtitle", "time": 2503.109, "timestamp": "00:41:43", "text": "まあまあ良い。"}, {"type": "subtitle", "time": 2506.71, "timestamp": "00:41:46", "text": "ねえ、ファットフィンガーフローティーズ私の名前と"}, {"type": "subtitle", "time": 2510.39, "timestamp": "00:41:50", "text": "トラングルファンクは俺の得意分野だ。そうそう。いいえ、私は"}, {"type": "subtitle", "time": 2511.43, "timestamp": "00:41:51", "text": "俺たちは何が何だか分からない"}, {"type": "subtitle", "time": 2514.15, "timestamp": "00:41:54", "text": "トラングル・ファンクは。ああ、あなたは混乱しているようですね。"}, {"type": "subtitle", "time": 2516.39, "timestamp": "00:41:56", "text": "でも、私の甘い言葉を聞きたいんでしょ"}]
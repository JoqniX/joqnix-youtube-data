[{"type": "subtitle", "time": 14342.07, "timestamp": "03:59:02", "text": "でも、ある意味ではただのストリームで"}, {"type": "subtitle", "time": 14349.95, "timestamp": "03:59:09", "text": "起こる。うん、できるよ"}, {"type": "subtitle", "time": 14360.48, "timestamp": "03:59:20", "text": "うん。私なら実際にできます。"}, {"type": "subtitle", "time": 14365.269, "timestamp": "03:59:25", "text": "[音楽]"}, {"type": "subtitle", "time": 14369.229, "timestamp": "03:59:29", "text": "おお、これはクールなアニメーションですね"}, {"type": "subtitle", "time": 14372.189, "timestamp": "03:59:32", "text": "あれ。リツイートするよ。これはとても"}, {"type": "subtitle", "time": 14375.91, "timestamp": "03:59:35", "text": "良い。チャットでリツイートを目にするかもしれません。"}, {"type": "subtitle", "time": 14377.15, "timestamp": "03:59:37", "text": "気にしないで、"}, {"type": "subtitle", "time": 14380.75, "timestamp": "03:59:40", "text": "でも、かっこいいものですね。"}, {"type": "subtitle", "time": 14383.83, "timestamp": "03:59:43", "text": "えーっと、えーっと、私、何してたんだっけ？"}, {"type": "subtitle", "time": 14385.429, "timestamp": "03:59:45", "text": "人々に感謝する。うん、終わったよ"}, {"type": "subtitle", "time": 14388.309, "timestamp": "03:59:48", "text": "皆さんに感謝するべきですよね？魂がやってきた"}, {"type": "subtitle", "time": 14389.75, "timestamp": "03:59:49", "text": "最近。うん。うん。それだけです"}, {"type": "subtitle", "time": 14399.07, "timestamp": "03:59:59", "text": "[音楽]"}]
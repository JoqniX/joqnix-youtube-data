[{"type": "subtitle", "time": 7755.43, "timestamp": "02:09:15", "text": "はい、どうぞ。ええ、わかっています。行けよ、相棒。私は"}, {"type": "subtitle", "time": 7758.709, "timestamp": "02:09:18", "text": "苦手です。はい、あなたはもう半分まで来ています。"}, {"type": "subtitle", "time": 7760.95, "timestamp": "02:09:20", "text": "続けて。君ならできるよ。ああ、できない"}, {"type": "subtitle", "time": 7763.189, "timestamp": "02:09:23", "text": "私の小さな薄っぺらで小道具の"}, {"type": "subtitle", "time": 7764.709, "timestamp": "02:09:24", "text": "垂れ下がった。"}, {"type": "subtitle", "time": 7767.43, "timestamp": "02:09:27", "text": "名前を変更しましたね。わかった。わかった。見る、"}, {"type": "subtitle", "time": 7769.189, "timestamp": "02:09:29", "text": "それでおしまい。私はここに座って"}, {"type": "subtitle", "time": 7770.95, "timestamp": "02:09:30", "text": "もう偽る必要はない。またミスをしたね。"}, {"type": "subtitle", "time": 7773.03, "timestamp": "02:09:33", "text": "あなたは子供の名前をしょっちゅう変えている。"}, {"type": "subtitle", "time": 7774.95, "timestamp": "02:09:34", "text": "わかった。彼は変わりつつある。何が起こっていますか？"}, {"type": "subtitle", "time": 7776.709, "timestamp": "02:09:36", "text": "一体何が起こっているのか？最近何が流行ってる？"}, {"type": "subtitle", "time": 7779.189, "timestamp": "02:09:39", "text": "調子はどう？何？何が"}, {"type": "subtitle", "time": 7780.95, "timestamp": "02:09:40", "text": "あなた、何の話をしているんですか？あなたは"}, {"type": "subtitle", "time": 7783.669, "timestamp": "02:09:43", "text": "俺たちをからかってるの？くそっ、ああ、君は"}, {"type": "subtitle", "time": 7786.149, "timestamp": "02:09:46", "text": "間違っている。私は絶対にそんなことはしません。見て"}, {"type": "subtitle", "time": 7788.069, "timestamp": "02:09:48", "text": "私は今、とても傷つきやすい状態です。あなたは何を"}, {"type": "subtitle", "time": 7790.31, "timestamp": "02:09:50", "text": "嘘をつくという意味ですか？私は自分自身をそうさせるだろうか"}, {"type": "subtitle", "time": 7792.87, "timestamp": "02:09:52", "text": "脆弱？あいつを撃ち殺せ。私を信じて。"}, {"type": "subtitle", "time": 7796.069, "timestamp": "02:09:56", "text": "ちょっと待って。ああ、私はそうは思わない"}, {"type": "subtitle", "time": 7798.149, "timestamp": "02:09:58", "text": "知る。彼は嘘をついている。彼は嘘をついている"}]
[{"type": "subtitle", "time": 15613.71, "timestamp": "04:20:13", "text": "自分？オーディオ"}, {"type": "subtitle", "time": 15622.59, "timestamp": "04:20:22", "text": "いいえ。これは誰ですか？"}, {"type": "subtitle", "time": 15624.83, "timestamp": "04:20:24", "text": "レディ？あなたは何者ですか"}, {"type": "subtitle", "time": 15627.75, "timestamp": "04:20:27", "text": "何をしているの？私たちに力を与えてくれますか？"}, {"type": "subtitle", "time": 15629.67, "timestamp": "04:20:29", "text": "生き残る？"}, {"type": "subtitle", "time": 15642.83, "timestamp": "04:20:42", "text": "[音楽]"}, {"type": "subtitle", "time": 15645.63, "timestamp": "04:20:45", "text": "D. 共鳴する。"}, {"type": "subtitle", "time": 15649.87, "timestamp": "04:20:49", "text": "Dは微笑む。幸せそうな笑顔。"}, {"type": "subtitle", "time": 15653.55, "timestamp": "04:20:53", "text": "D. そして彼女はあなたに許します"}, {"type": "subtitle", "time": 15657.309, "timestamp": "04:20:57", "text": "ブラックホールに突入する。"}]
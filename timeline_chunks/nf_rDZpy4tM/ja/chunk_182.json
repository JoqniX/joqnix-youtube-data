[{"type": "subtitle", "time": 10920.63, "timestamp": "03:02:00", "text": "何か。あなたは喜んでいて、"}, {"type": "subtitle", "time": 10921.79, "timestamp": "03:02:01", "text": "インスパイヤされた"}, {"type": "subtitle", "time": 10923.469, "timestamp": "03:02:03", "text": "について。"}, {"type": "subtitle", "time": 10927.349, "timestamp": "03:02:07", "text": "うん。うん。そしてもちろん私は"}, {"type": "subtitle", "time": 10931.55, "timestamp": "03:02:11", "text": "あなたの旅をサポートするために"}, {"type": "subtitle", "time": 10933.63, "timestamp": "03:02:13", "text": "先に。良い、"}, {"type": "subtitle", "time": 10936.71, "timestamp": "03:02:16", "text": "だから、私はあなたが恋しくなると思う、"}, {"type": "subtitle", "time": 10938.11, "timestamp": "03:02:18", "text": "いくつかはそうではない"}, {"type": "subtitle", "time": 10940.59, "timestamp": "03:02:20", "text": "知る。"}, {"type": "subtitle", "time": 10943.75, "timestamp": "03:02:23", "text": "そう、小売業も"}, {"type": "subtitle", "time": 10946.269, "timestamp": "03:02:26", "text": "人気があり人気"}, {"type": "subtitle", "time": 10950.91, "timestamp": "03:02:30", "text": "今では多くの人が、"}, {"type": "subtitle", "time": 10953.349, "timestamp": "03:02:33", "text": "だって、顔を見せなくてもいいんだから"}, {"type": "subtitle", "time": 10955.59, "timestamp": "03:02:35", "text": "そして全て。より簡単に"}, {"type": "subtitle", "time": 10958.23, "timestamp": "03:02:38", "text": "もしあなたが持っているなら、もしあなたが適合するなら"}, {"type": "subtitle", "time": 10959.71, "timestamp": "03:02:39", "text": "基準としては"}, {"type": "subtitle", "time": 10962.51, "timestamp": "03:02:42", "text": "それ"}, {"type": "subtitle", "time": 10966.429, "timestamp": "03:02:46", "text": "あれ。待ってくれる？"}, {"type": "subtitle", "time": 10969.19, "timestamp": "03:02:49", "text": "私は、あのポジションを知ってるよ、って感じだった。"}, {"type": "subtitle", "time": 10971.349, "timestamp": "03:02:51", "text": "両手を置く場所"}, {"type": "subtitle", "time": 10974.79, "timestamp": "03:02:54", "text": "足とかそんな感じ"}, {"type": "subtitle", "time": 10977.67, "timestamp": "03:02:57", "text": "女の子が椅子に座るように、"}]
[{"type": "subtitle", "time": 1560.83, "timestamp": "00:26:00", "text": "ほら、お前は俺を怒らせている"}, {"type": "subtitle", "time": 1562.87, "timestamp": "00:26:02", "text": "激怒した。ほら、私たちは"}, {"type": "subtitle", "time": 1565.19, "timestamp": "00:26:05", "text": "めちゃくちゃ怒ってる。私たちは、私たちは、私たちは、私たちは、"}, {"type": "subtitle", "time": 1566.95, "timestamp": "00:26:06", "text": "こちらです。私たちはこんなの好きじゃない。私たちは"}, {"type": "subtitle", "time": 1568.31, "timestamp": "00:26:08", "text": "誰かが入ってくるのが好きじゃないし"}, {"type": "subtitle", "time": 1570.31, "timestamp": "00:26:10", "text": "私たちの庭を踏みつけ、"}, {"type": "subtitle", "time": 1572.07, "timestamp": "00:26:12", "text": "いわば、比喩的に言えば。これは私たちの"}, {"type": "subtitle", "time": 1573.669, "timestamp": "00:26:13", "text": "クソみたいな庭。そしてあなたはずっと歩いています"}, {"type": "subtitle", "time": 1575.35, "timestamp": "00:26:15", "text": "クソ植物の上で、私たちはただ"}, {"type": "subtitle", "time": 1577.51, "timestamp": "00:26:17", "text": "私たちが今植えた種。ご存知の通り、私たちは"}, {"type": "subtitle", "time": 1579.31, "timestamp": "00:26:19", "text": "こちらは忙しいです。このクソ野郎"}, {"type": "subtitle", "time": 1582.71, "timestamp": "00:26:22", "text": "くそっ。このクソ野郎。おい、"}, {"type": "subtitle", "time": 1584.87, "timestamp": "00:26:24", "text": "おいおい。簡単、簡単、簡単。ああ、できない"}, {"type": "subtitle", "time": 1586.95, "timestamp": "00:26:26", "text": "私たちがここに持っているものを信じてください。おい、何だって"}, {"type": "subtitle", "time": 1588.95, "timestamp": "00:26:28", "text": "冷蔵庫？"}, {"type": "subtitle", "time": 1592.31, "timestamp": "00:26:32", "text": "元気かい？ヘイ、ヘイ、ヘイ、ヘイ。"}, {"type": "subtitle", "time": 1594.789, "timestamp": "00:26:34", "text": "何がそんなに大したことなんだよ、兄弟？ねえ、何？"}, {"type": "subtitle", "time": 1598.63, "timestamp": "00:26:38", "text": "それがそんなに大したことなの？おいおいおいおい。おお、"}, {"type": "subtitle", "time": 1600.07, "timestamp": "00:26:40", "text": "信じられない。何？うわあ、うわあ、"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "うわぁ。私たちは何をしているのでしょうか？くそっ。タフガイ"}, {"type": "subtitle", "time": 1604.71, "timestamp": "00:26:44", "text": "最高だ。わかった。時には"}, {"type": "subtitle", "time": 1608.23, "timestamp": "00:26:48", "text": "引き下がる。ああ、1匹殺したよ。おお、"}, {"type": "subtitle", "time": 1609.909, "timestamp": "00:26:49", "text": "それはまずい。やらなきゃいけないことがある"}, {"type": "subtitle", "time": 1613.11, "timestamp": "00:26:53", "text": "やるべきこと。何がそんなに大したことなんだよ、兄弟？"}, {"type": "subtitle", "time": 1616.39, "timestamp": "00:26:56", "text": "ああ、なんてこった、あの男は本当にバカだった。ニース"}, {"type": "subtitle", "time": 1617.56, "timestamp": "00:26:57", "text": "ジャンプする。"}]
[{"type": "subtitle", "time": 1620.269, "timestamp": "00:27:00", "text": "[音楽]"}, {"type": "subtitle", "time": 1632.75, "timestamp": "00:27:12", "text": "ちょうど"}, {"type": "subtitle", "time": 1643.75, "timestamp": "00:27:23", "text": "銃。よし、彼らは戻って"}, {"type": "subtitle", "time": 1645.98, "timestamp": "00:27:25", "text": "仕事。わかった。"}, {"type": "subtitle", "time": 1661.909, "timestamp": "00:27:41", "text": "おお、あの大物プラットフォームを見て"}, {"type": "subtitle", "time": 1663.83, "timestamp": "00:27:43", "text": "まるでタフガイのように、あちこちをうろついている。"}, {"type": "subtitle", "time": 1665.87, "timestamp": "00:27:45", "text": "おい、"}, {"type": "subtitle", "time": 1670.54, "timestamp": "00:27:50", "text": "言葉を止める。何てことだ。おい。"}, {"type": "subtitle", "time": 1672.47, "timestamp": "00:27:52", "text": "[音楽]"}, {"type": "subtitle", "time": 1674.63, "timestamp": "00:27:54", "text": "あなたは何をしましたか？"}, {"type": "subtitle", "time": 1675.99, "timestamp": "00:27:55", "text": "私たちはこれを単に"}, {"type": "subtitle", "time": 1679.43, "timestamp": "00:27:59", "text": "楽しいけど、そうなんです。楽しいよ。そうです。"}]
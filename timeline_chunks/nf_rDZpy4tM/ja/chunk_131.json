[{"type": "subtitle", "time": 7861.03, "timestamp": "02:11:01", "text": "クビスを殺したのは君だろ？私はできません"}, {"type": "subtitle", "time": 7864.629, "timestamp": "02:11:04", "text": "お前らバカどもは俺の正体を見抜いたんだろうな。ああ、"}, {"type": "subtitle", "time": 7871.35, "timestamp": "02:11:11", "text": "混沌モードに突入します。"}, {"type": "subtitle", "time": 7879.189, "timestamp": "02:11:19", "text": "もしかしたら、あなたは彼の靴と戦っているのかもしれませんね。"}, {"type": "subtitle", "time": 7887.669, "timestamp": "02:11:27", "text": "だから何？あなたの仕事はトレーニングと"}, {"type": "subtitle", "time": 7903.229, "timestamp": "02:11:43", "text": "少し？彼らです"}, {"type": "subtitle", "time": 7907.03, "timestamp": "02:11:47", "text": "相変わらずバカだな。今、私は"}]
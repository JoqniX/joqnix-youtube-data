[{"type": "subtitle", "time": 8296.95, "timestamp": "02:18:16", "text": "働く。できない"}, {"type": "subtitle", "time": 8312.709, "timestamp": "02:18:32", "text": "それを使って私の小さな"}, {"type": "subtitle", "time": 8314.709, "timestamp": "02:18:34", "text": "結晶。だから、普通に爆発させよう"}, {"type": "subtitle", "time": 8316.389, "timestamp": "02:18:36", "text": "ショットを飲んで、最後に私の"}, {"type": "subtitle", "time": 8319.549, "timestamp": "02:18:39", "text": "超結晶。わかったか、このバカ。"}]
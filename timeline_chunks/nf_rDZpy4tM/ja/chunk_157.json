[{"type": "subtitle", "time": 9421.19, "timestamp": "02:37:01", "text": "人間という種は、厳密に言えば薬物である。私"}, {"type": "subtitle", "time": 9423.03, "timestamp": "02:37:03", "text": "危険な知覚薬は"}, {"type": "subtitle", "time": 9424.63, "timestamp": "02:37:04", "text": "私の市民の手とあなたはできない"}, {"type": "subtitle", "time": 9426.15, "timestamp": "02:37:06", "text": "あなたの仲間が捕らえられて"}, {"type": "subtitle", "time": 9428.15, "timestamp": "02:37:08", "text": "消費された。これは私たちの両方の問題を解決します"}, {"type": "subtitle", "time": 9430.309, "timestamp": "02:37:10", "text": "問題。つまり、あなたは続けるつもりなのですね"}, {"type": "subtitle", "time": 9433.55, "timestamp": "02:37:13", "text": "G3を取り出すのか？もちろんです。"}, {"type": "subtitle", "time": 9437.19, "timestamp": "02:37:17", "text": "それでは、心から感謝申し上げます。あなたたち人間は"}, {"type": "subtitle", "time": 9439.51, "timestamp": "02:37:19", "text": "そしてガトロンズ、あなたたち二人はとても高潔です"}, {"type": "subtitle", "time": 9442.23, "timestamp": "02:37:22", "text": "種。これは私にとってとても大きな意味があります。私は"}, {"type": "subtitle", "time": 9444.15, "timestamp": "02:37:24", "text": "自分の力を使うことを人生の使命とした"}, {"type": "subtitle", "time": 9446.07, "timestamp": "02:37:26", "text": "困っている人を助けるために、しかし私でさえ"}, {"type": "subtitle", "time": 9448.15, "timestamp": "02:37:28", "text": "私の限界。私には誰かがいてくれて嬉しい"}, {"type": "subtitle", "time": 9450.309, "timestamp": "02:37:30", "text": "あなたに頼りたい。の証として"}, {"type": "subtitle", "time": 9452.389, "timestamp": "02:37:32", "text": "ありがとう、私のチームは"}, {"type": "subtitle", "time": 9454.95, "timestamp": "02:37:34", "text": "G3で見つけた情報を直接あなたの"}, {"type": "subtitle", "time": 9456.87, "timestamp": "02:37:36", "text": "担当者はゼルテイアン氏です。私たちはすでに"}, {"type": "subtitle", "time": 9459.11, "timestamp": "02:37:39", "text": "彼には私たちが持っていたもの全てを送った。残りは"}, {"type": "subtitle", "time": 9461.59, "timestamp": "02:37:41", "text": "あなたの手の中に。本当にありがとうございます、ミスター。"}, {"type": "subtitle", "time": 9463.67, "timestamp": "02:37:43", "text": "ナグマン。以上です。感じる"}, {"type": "subtitle", "time": 9465.27, "timestamp": "02:37:45", "text": "お好きなだけ滞在していただいて構いません。の"}, {"type": "subtitle", "time": 9468.07, "timestamp": "02:37:48", "text": "景色は息を呑むほど素晴らしい。"}, {"type": "subtitle", "time": 9470.55, "timestamp": "02:37:50", "text": "ええ、景色は息を呑むほど素晴らしいです。あなたも"}, {"type": "subtitle", "time": 9477.59, "timestamp": "02:37:57", "text": "おお。ええと、どうぞごゆっくりお過ごしください。"}]
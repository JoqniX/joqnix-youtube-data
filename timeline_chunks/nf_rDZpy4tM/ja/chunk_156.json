[{"type": "subtitle", "time": 9361.27, "timestamp": "02:36:01", "text": "時間を使って、種の麻薬取引を抑制します。私"}, {"type": "subtitle", "time": 9363.11, "timestamp": "02:36:03", "text": "できることには限りがあり、"}, {"type": "subtitle", "time": 9365.19, "timestamp": "02:36:05", "text": "法律の範囲内。つまり、私は"}, {"type": "subtitle", "time": 9367.03, "timestamp": "02:36:07", "text": "ゲイリーのことで手一杯だ"}, {"type": "subtitle", "time": 9368.95, "timestamp": "02:36:08", "text": "毒殺者。彼は毒を盛っているだけではなく"}, {"type": "subtitle", "time": 9370.95, "timestamp": "02:36:10", "text": "給水。彼は毒殺へと手を染めた"}, {"type": "subtitle", "time": 9373.429, "timestamp": "02:36:13", "text": "今ではもっと奇妙なもの、例えば街灯など。私たちは"}, {"type": "subtitle", "time": 9374.87, "timestamp": "02:36:14", "text": "それがどういう仕組みなのかもわからないし、"}, {"type": "subtitle", "time": 9376.79, "timestamp": "02:36:16", "text": "それは実際問題です。大丈夫かもしれない"}, {"type": "subtitle", "time": 9378.55, "timestamp": "02:36:18", "text": "街灯に毒を盛る。私は少し"}, {"type": "subtitle", "time": 9380.71, "timestamp": "02:36:20", "text": "圧倒された。もっと集中できたらいいのに"}, {"type": "subtitle", "time": 9384.309, "timestamp": "02:36:24", "text": "G3でのプレイ時間。でもあなたは"}, {"type": "subtitle", "time": 9386.79, "timestamp": "02:36:26", "text": "2人のトップG3将校がそれよりも短い時間で"}, {"type": "subtitle", "time": 9388.95, "timestamp": "02:36:28", "text": "単一の報告書を作成するのに時間がかかります。それで、"}, {"type": "subtitle", "time": 9391.349, "timestamp": "02:36:31", "text": "あなたが私をどう助けられるか、お分かりいただけたでしょうか。そこには"}, {"type": "subtitle", "time": 9393.75, "timestamp": "02:36:33", "text": "これも私があなたを助けられる方法の一つです。はい、私たちは"}, {"type": "subtitle", "time": 9396.15, "timestamp": "02:36:36", "text": "私たちは耳を傾けています。私の机の上にあるこのツール"}, {"type": "subtitle", "time": 9397.91, "timestamp": "02:36:37", "text": "ここでは仲間の救助に役立てられます"}, {"type": "subtitle", "time": 9399.91, "timestamp": "02:36:39", "text": "人間。それを使ってテレポートさせることができます"}, {"type": "subtitle", "time": 9402.07, "timestamp": "02:36:42", "text": "私のチームが手配した安全な避難所へ"}, {"type": "subtitle", "time": 9404.309, "timestamp": "02:36:44", "text": "G3が処理されるまでそこに留まるように"}, {"type": "subtitle", "time": 9406.71, "timestamp": "02:36:46", "text": "と。"}, {"type": "subtitle", "time": 9409.67, "timestamp": "02:36:49", "text": "ああ、リー"}, {"type": "subtitle", "time": 9416.389, "timestamp": "02:36:56", "text": "おお。それは本当に役に立ちます。"}, {"type": "subtitle", "time": 9418.469, "timestamp": "02:36:58", "text": "あなたはそれを私たちに与えているだけです。ええと、"}]
[{"type": "subtitle", "time": 9301.99, "timestamp": "02:35:01", "text": "そこには。クルーグがあなたを待っています。"}, {"type": "subtitle", "time": 9305.429, "timestamp": "02:35:05", "text": "おそらくそこを通るでしょう。おい、"}, {"type": "subtitle", "time": 9307.67, "timestamp": "02:35:07", "text": "一体どこへ行くつもりだ？話しかけて"}, {"type": "subtitle", "time": 9311.27, "timestamp": "02:35:11", "text": "ああ、イエス。行かなきゃいけないんだ、ああ、なんてことだ。"}, {"type": "subtitle", "time": 9316.16, "timestamp": "02:35:16", "text": "来て。私は物を買いたかったんです。"}, {"type": "subtitle", "time": 9322.23, "timestamp": "02:35:22", "text": "バウンティさん、来てくれて本当にありがとう"}, {"type": "subtitle", "time": 9324.79, "timestamp": "02:35:24", "text": "ハンター。問題ない。それは、それは、それは、それは"}, {"type": "subtitle", "time": 9327.11, "timestamp": "02:35:27", "text": "はじめまして。見てください、"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "追跡。あなたの助けが必要です。あなたは"}, {"type": "subtitle", "time": 9331.83, "timestamp": "02:35:31", "text": "人間ですよね？私の部下たちが調査した。"}, {"type": "subtitle", "time": 9334.15, "timestamp": "02:35:34", "text": "ごめん。あなたはG3の攻撃を生き延びました"}, {"type": "subtitle", "time": 9336.07, "timestamp": "02:35:36", "text": "あなたの故郷は地球ですよね？ええと、私たちは"}, {"type": "subtitle", "time": 9338.63, "timestamp": "02:35:38", "text": "私たちはガタリアンですが、ええ、もちろん。"}, {"type": "subtitle", "time": 9340.55, "timestamp": "02:35:40", "text": "ごめん。私はあなたの苦境をよく知っています"}, {"type": "subtitle", "time": 9342.469, "timestamp": "02:35:42", "text": "良い。起きたことは本当に悲劇だ"}, {"type": "subtitle", "time": 9344.71, "timestamp": "02:35:44", "text": "ガトラスにて。あなたが"}, {"type": "subtitle", "time": 9346.79, "timestamp": "02:35:46", "text": "そして人間も力を合わせるだろう。しかし"}, {"type": "subtitle", "time": 9349.03, "timestamp": "02:35:49", "text": "もしかしたら、もう一人味方を迎える余地があるかもしれません"}, {"type": "subtitle", "time": 9350.87, "timestamp": "02:35:50", "text": "同じように。でも、あなたは有名人です"}, {"type": "subtitle", "time": 9352.71, "timestamp": "02:35:52", "text": "政治家、そして私たちはそこにいる、"}, {"type": "subtitle", "time": 9354.389, "timestamp": "02:35:54", "text": "人を殺すこと、知ってる？いや、"}, {"type": "subtitle", "time": 9356.63, "timestamp": "02:35:56", "text": "それって見た目が悪い？だからこそ私は"}, {"type": "subtitle", "time": 9358.55, "timestamp": "02:35:58", "text": "あなたの助けが必要です。私はとても"}]
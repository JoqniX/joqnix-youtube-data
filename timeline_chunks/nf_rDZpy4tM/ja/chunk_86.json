[{"type": "subtitle", "time": 5162.709, "timestamp": "01:26:02", "text": "仮想主義。まあまあかな。うん。"}, {"type": "subtitle", "time": 5164.79, "timestamp": "01:26:04", "text": "よくやった。新兵、おめでとう。今、"}, {"type": "subtitle", "time": 5170.47, "timestamp": "01:26:10", "text": "おい、まあ、ハングを撃つなよ。それは"}, {"type": "subtitle", "time": 5173.83, "timestamp": "01:26:13", "text": "おそらく誰かのペットだろう。"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "マヤもその一員として、"}, {"type": "subtitle", "time": 5182.31, "timestamp": "01:26:22", "text": "ホストと共同ホストは私にたくさんの"}, {"type": "subtitle", "time": 5184.95, "timestamp": "01:26:24", "text": "経験の。"}, {"type": "subtitle", "time": 5193.189, "timestamp": "01:26:33", "text": "ええ、それは私に多くの経験を与えてくれました。"}, {"type": "subtitle", "time": 5196.629, "timestamp": "01:26:36", "text": "話し方と自分の意見の伝え方"}, {"type": "subtitle", "time": 5199.11, "timestamp": "01:26:39", "text": "視点"}, {"type": "subtitle", "time": 5202.79, "timestamp": "01:26:42", "text": "そういう類のすべて。"}, {"type": "subtitle", "time": 5204.95, "timestamp": "01:26:44", "text": "ああ、くそ。これは本当に感謝しなければならない"}, {"type": "subtitle", "time": 5213.27, "timestamp": "01:26:53", "text": "おい、君はDiscordを作ったんだろ。他の誰か"}, {"type": "subtitle", "time": 5217.43, "timestamp": "01:26:57", "text": "作成されました。 Discordアカウントを作成しました。"}]
[{"type": "subtitle", "time": 11641.59, "timestamp": "03:14:01", "text": "彼らの想像力は、右？そして"}, {"type": "subtitle", "time": 11643.269, "timestamp": "03:14:03", "text": "もちろん、もちろん、"}, {"type": "subtitle", "time": 11650.389, "timestamp": "03:14:10", "text": "もの。人々は時々同じ"}, {"type": "subtitle", "time": 11652.55, "timestamp": "03:14:12", "text": "デザインを考慮したアイデアだが、"}, {"type": "subtitle", "time": 11655.389, "timestamp": "03:14:15", "text": "コピーにはそう書いてある。その通り。"}, {"type": "subtitle", "time": 11658.87, "timestamp": "03:14:18", "text": "うん。恥。それは同じことです"}, {"type": "subtitle", "time": 11660.75, "timestamp": "03:14:20", "text": "デザインとして"}, {"type": "subtitle", "time": 11664.309, "timestamp": "03:14:24", "text": "良い。デザインやロゴなども"}, {"type": "subtitle", "time": 11666.55, "timestamp": "03:14:26", "text": "もの。色に関しては、"}, {"type": "subtitle", "time": 11668.389, "timestamp": "03:14:28", "text": "traの商標か何か、あるいは何か。"}, {"type": "subtitle", "time": 11670.79, "timestamp": "03:14:30", "text": "わからない。"}, {"type": "subtitle", "time": 11673.11, "timestamp": "03:14:33", "text": "カラーパレットがあることを忘れていました"}, {"type": "subtitle", "time": 11674.95, "timestamp": "03:14:34", "text": "著作権や商標のように、"}, {"type": "subtitle", "time": 11675.68, "timestamp": "03:14:35", "text": "何か"}, {"type": "subtitle", "time": 11678.269, "timestamp": "03:14:38", "text": "[音楽]"}, {"type": "subtitle", "time": 11681.19, "timestamp": "03:14:41", "text": "ハーレイ・クインは、彼が"}, {"type": "subtitle", "time": 11683.51, "timestamp": "03:14:43", "text": "彼女の真似をした。ええ、ほとんどの人がこう言っています"}, {"type": "subtitle", "time": 11687.75, "timestamp": "03:14:47", "text": "それは、ガビスがプーラの息子か何か"}, {"type": "subtitle", "time": 11691.269, "timestamp": "03:14:51", "text": "娘。ああ、息子とか何とか。うん、"}, {"type": "subtitle", "time": 11694.95, "timestamp": "03:14:54", "text": "子供とか、そんな感じのもの。"}, {"type": "subtitle", "time": 11697.229, "timestamp": "03:14:57", "text": "しかしそれは、"}]
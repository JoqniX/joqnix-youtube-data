[{"type": "subtitle", "time": 5521.59, "timestamp": "01:32:01", "text": "それらのうちいくつかは、ええ"}, {"type": "subtitle", "time": 5523.669, "timestamp": "01:32:03", "text": "ええ、ええ"}, {"type": "subtitle", "time": 5525.75, "timestamp": "01:32:05", "text": "私はあまり知らないが、"}, {"type": "subtitle", "time": 5528.39, "timestamp": "01:32:08", "text": "私が見たものを言うことができます"}, {"type": "subtitle", "time": 5530.35, "timestamp": "01:32:10", "text": "デビューのように、"}, {"type": "subtitle", "time": 5532.79, "timestamp": "01:32:12", "text": "スタースケープが目指しているすべて"}, {"type": "subtitle", "time": 5534.83, "timestamp": "01:32:14", "text": "彼らがすることは"}, {"type": "subtitle", "time": 5538.75, "timestamp": "01:32:18", "text": "合併しようとしている"}, {"type": "subtitle", "time": 5542.189, "timestamp": "01:32:22", "text": "チューブとコスプレの両方"}, {"type": "subtitle", "time": 5547.59, "timestamp": "01:32:27", "text": "何かの下で一つのものに流れ込む"}, {"type": "subtitle", "time": 5549.83, "timestamp": "01:32:29", "text": "スタースケープと呼ばれ、それらは"}, {"type": "subtitle", "time": 5552.709, "timestamp": "01:32:32", "text": "それを促進して"}, {"type": "subtitle", "time": 5556.07, "timestamp": "01:32:36", "text": "えーと、これを宣伝して、これが"}, {"type": "subtitle", "time": 5559.27, "timestamp": "01:32:39", "text": "方法、またはこれが方法のようなものです"}, {"type": "subtitle", "time": 5561.47, "timestamp": "01:32:41", "text": "これがインドのやり方です"}, {"type": "subtitle", "time": 5565.79, "timestamp": "01:32:45", "text": "チューブとその"}, {"type": "subtitle", "time": 5575.75, "timestamp": "01:32:55", "text": "ジェンには独自の法律がある"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "すべてそうですよね？彼らはプレイする"}, {"type": "subtitle", "time": 5579.47, "timestamp": "01:32:59", "text": "キャラクター、なぜなら彼らはまたコスプレイヤーだから、"}]
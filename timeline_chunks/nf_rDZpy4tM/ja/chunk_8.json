[{"type": "subtitle", "time": 482.909, "timestamp": "00:08:02", "text": "あなたが元気で過ごしていることを願っています。調子はどうですか？"}, {"type": "subtitle", "time": 488.95, "timestamp": "00:08:08", "text": "あなた？さて、前回はどこまで話しましたっけ？私たちは"}, {"type": "subtitle", "time": 490.43, "timestamp": "00:08:10", "text": "たくさん買いました"}, {"type": "subtitle", "time": 493.43, "timestamp": "00:08:13", "text": "アップグレードすると申し上げましたが、"}, {"type": "subtitle", "time": 495.749, "timestamp": "00:08:15", "text": "100％達成する"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "えっと、このゲーム。だから、たくさん買うつもりです"}, {"type": "subtitle", "time": 500.71, "timestamp": "00:08:20", "text": "今日はいろいろなものがありました。私たちはたくさん探検します"}, {"type": "subtitle", "time": 509.029, "timestamp": "00:08:29", "text": "ええ、元気ですよ。あなたはどうですか？"}, {"type": "subtitle", "time": 511.949, "timestamp": "00:08:31", "text": "ああ、私もやってるよ"}, {"type": "subtitle", "time": 516.389, "timestamp": "00:08:36", "text": "良い。私も元気です。"}, {"type": "subtitle", "time": 519.31, "timestamp": "00:08:39", "text": "誰が来たか見てごらん。"}, {"type": "subtitle", "time": 524.389, "timestamp": "00:08:44", "text": "ああ、それでガスタマを手に入れたし、"}, {"type": "subtitle", "time": 527.91, "timestamp": "00:08:47", "text": "ケビン。待って、彼の名前はケビンだよね？"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "ケニー。わかったよ、ケニー。私のミスです。ケビンじゃない。"}, {"type": "subtitle", "time": 532.19, "timestamp": "00:08:52", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 537.829, "timestamp": "00:08:57", "text": "ケニー。よし、ケニーとガスは確保できた。おお、"}]
[{"type": "subtitle", "time": 17162.07, "timestamp": "04:46:02", "text": "また、ひょうたんには限界があります"}, {"type": "subtitle", "time": 17164.868, "timestamp": "04:46:04", "text": "吸収できる。吸収は"}, {"type": "subtitle", "time": 17167.19, "timestamp": "04:46:07", "text": "データバンクのレベルが等しい場合"}, {"type": "subtitle", "time": 17169.83, "timestamp": "04:46:09", "text": "または、テスト用Discordのレベルよりも高い。"}, {"type": "subtitle", "time": 17171.67, "timestamp": "04:46:11", "text": "端末はその後、"}, {"type": "subtitle", "time": 17174.67, "timestamp": "04:46:14", "text": "反響音をエコーに変えて使用する"}, {"type": "subtitle", "time": 17177.51, "timestamp": "04:46:17", "text": "戦い。私の端末が警告を発しました"}, {"type": "subtitle", "time": 17179.67, "timestamp": "04:46:19", "text": "酸性の不和を検知したとき"}, {"type": "subtitle", "time": 17181.99, "timestamp": "04:46:21", "text": "以前。少なくとも"}, {"type": "subtitle", "time": 17185.03, "timestamp": "04:46:25", "text": "オーバーロード級。あと、1秒。心"}, {"type": "subtitle", "time": 17189.19, "timestamp": "04:46:29", "text": "データバンクのレベルを確認しています。"}, {"type": "subtitle", "time": 17191.19, "timestamp": "04:46:31", "text": "私の信者ストリームは"}, {"type": "subtitle", "time": 17205.03, "timestamp": "04:46:45", "text": "エラー。フレンドリーリマインダー、あなたのライブ"}]
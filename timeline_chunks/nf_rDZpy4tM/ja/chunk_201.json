[{"type": "subtitle", "time": 12060.63, "timestamp": "03:21:00", "text": "ケースを取ることもできます"}, {"type": "subtitle", "time": 12064.07, "timestamp": "03:21:04", "text": "AIアートについて、ほとんどの人のアートは"}, {"type": "subtitle", "time": 12066.309, "timestamp": "03:21:06", "text": "ご存知のように、ごちゃ混ぜにされています"}, {"type": "subtitle", "time": 12069.19, "timestamp": "03:21:09", "text": "自動的に生成され、それは"}, {"type": "subtitle", "time": 12071.429, "timestamp": "03:21:11", "text": "それぞれのスタイル、彼らが一緒に仕事をしたアーティストたち"}, {"type": "subtitle", "time": 12074.15, "timestamp": "03:21:14", "text": "オンと物、独自のオリジナル"}, {"type": "subtitle", "time": 12075.99, "timestamp": "03:21:15", "text": "絵画のスタイル スタイル すべてが"}, {"type": "subtitle", "time": 12080.11, "timestamp": "03:21:20", "text": "自動化されたAI関連のものに統合されました"}, {"type": "subtitle", "time": 12084.63, "timestamp": "03:21:24", "text": "今はある意味では辛いけど、"}, {"type": "subtitle", "time": 12089.03, "timestamp": "03:21:29", "text": "AIが"}, {"type": "subtitle", "time": 12092.19, "timestamp": "03:21:32", "text": "それは、たとえ"}, {"type": "subtitle", "time": 12095.67, "timestamp": "03:21:35", "text": "顧客を失うことになる"}, {"type": "subtitle", "time": 12097.79, "timestamp": "03:21:37", "text": "アートをするが"}, {"type": "subtitle", "time": 12100.63, "timestamp": "03:21:40", "text": "それでもあなたは自分自身に忠実であり、"}, {"type": "subtitle", "time": 12103.75, "timestamp": "03:21:43", "text": "それでも、あなたがやりたいことを続けてください"}, {"type": "subtitle", "time": 12105.51, "timestamp": "03:21:45", "text": "あなたが情熱を持って取り組んできたこと"}, {"type": "subtitle", "time": 12108.71, "timestamp": "03:21:48", "text": "何年も何年も、まさにそんな感じで。だから"}, {"type": "subtitle", "time": 12114.429, "timestamp": "03:21:54", "text": "ブラシ。まるで"}]
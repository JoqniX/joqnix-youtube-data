[{"type": "subtitle", "time": 10261.03, "timestamp": "02:51:01", "text": "誰にとってもやってはいけないことだ。あなたたちは両方とも"}, {"type": "subtitle", "time": 10262.79, "timestamp": "02:51:02", "text": "クソ野郎ども。ええ、まあ、"}, {"type": "subtitle", "time": 10264.55, "timestamp": "02:51:04", "text": "このツイート男を妊娠させろ。その後"}, {"type": "subtitle", "time": 10266.309, "timestamp": "02:51:06", "text": "私はここにいて、「ほら、言った通りでしょ」と言ってやるつもりだ。"}, {"type": "subtitle", "time": 10267.349, "timestamp": "02:51:07", "text": "では、誰が対処しなければならないのでしょうか"}, {"type": "subtitle", "time": 10269.19, "timestamp": "02:51:09", "text": "ミュータントの子供たちが走り回っている"}, {"type": "subtitle", "time": 10271.269, "timestamp": "02:51:11", "text": "家？自分。ああ、別にどうでもいいことだけど、"}, {"type": "subtitle", "time": 10273.11, "timestamp": "02:51:13", "text": "でも、妊娠するのは私の方なんです。"}, {"type": "subtitle", "time": 10275.75, "timestamp": "02:51:15", "text": "それは彼の種族のやり方ではない。彼らは"}, {"type": "subtitle", "time": 10279.349, "timestamp": "02:51:19", "text": "妊娠はとても簡単だ。もううんざりだ"}, {"type": "subtitle", "time": 10281.99, "timestamp": "02:51:21", "text": "くそっ。いいかい、私はただトゥイッグに"}, {"type": "subtitle", "time": 10285.03, "timestamp": "02:51:25", "text": "私がだらしないと思ってるでしょ？実に単純な話だ。"}, {"type": "subtitle", "time": 10287.59, "timestamp": "02:51:27", "text": "そして、私はあなたに彼と付き合ってほしくないんです。"}, {"type": "subtitle", "time": 10289.269, "timestamp": "02:51:29", "text": "私の甥っ子を紹介してあげようか。"}, {"type": "subtitle", "time": 10292.15, "timestamp": "02:51:32", "text": "グリンブルディック？彼は安定した仕事に就いている。そして"}, {"type": "subtitle", "time": 10294.469, "timestamp": "02:51:34", "text": "はい、聞かれる前に言っておきますが、彼は両方とも持っています"}, {"type": "subtitle", "time": 10297.03, "timestamp": "02:51:37", "text": "脚。それは家族に伝わる病気とは違う"}, {"type": "subtitle", "time": 10299.59, "timestamp": "02:51:39", "text": "あるいは何でも。消え失せろ。大人になって"}, {"type": "subtitle", "time": 10302.389, "timestamp": "02:51:42", "text": "私とトゥイッグに慣れてください。来て。教えて"}, {"type": "subtitle", "time": 10311.11, "timestamp": "02:51:51", "text": "ええ、それは本当です。ありがとう。ない"}, {"type": "subtitle", "time": 10313.429, "timestamp": "02:51:53", "text": "あなたの承認が必要だったのです。ああ、わかったよ。"}, {"type": "subtitle", "time": 10315.19, "timestamp": "02:51:55", "text": "うん。落ち込んでいる人たちとチームを組んで戦う"}, {"type": "subtitle", "time": 10317.03, "timestamp": "02:51:57", "text": "下半身麻痺。あなたが"}, {"type": "subtitle", "time": 10319.03, "timestamp": "02:51:59", "text": "押し下げられた。つまり、私はあなたが"}]
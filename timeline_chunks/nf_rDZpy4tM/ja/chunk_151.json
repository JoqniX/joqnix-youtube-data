[{"type": "subtitle", "time": 9061.03, "timestamp": "02:31:01", "text": "あなたは以前プロのランナーでしたか？"}, {"type": "subtitle", "time": 9063.83, "timestamp": "02:31:03", "text": "地球上か何かで？待って、私はアレックスを知っていた"}, {"type": "subtitle", "time": 9065.59, "timestamp": "02:31:05", "text": "アレックスが理解してくれるでしょう。それでは続けましょう。"}, {"type": "subtitle", "time": 9066.67, "timestamp": "02:31:06", "text": "の"}, {"type": "subtitle", "time": 9070.23, "timestamp": "02:31:10", "text": "ミッション。何てことだ、"}, {"type": "subtitle", "time": 9097.87, "timestamp": "02:31:37", "text": "[音楽]"}, {"type": "subtitle", "time": 9099.68, "timestamp": "02:31:39", "text": "それ。"}, {"type": "subtitle", "time": 9110.98, "timestamp": "02:31:50", "text": "おお"}, {"type": "subtitle", "time": 9118.11, "timestamp": "02:31:58", "text": "私の。は"}]
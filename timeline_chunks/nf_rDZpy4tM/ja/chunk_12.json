[{"type": "subtitle", "time": 723.99, "timestamp": "00:12:03", "text": "わかった。おそらく未知の領域だろう。おお、"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "私の口の中に。ヘルメットを被ったクソ野郎"}, {"type": "subtitle", "time": 737.269, "timestamp": "00:12:17", "text": "クソ野郎。あなたはできない"}, {"type": "subtitle", "time": 738.949, "timestamp": "00:12:18", "text": "これに関連する。なぜ私には"}, {"type": "subtitle", "time": 741.389, "timestamp": "00:12:21", "text": "ヘルメット？ヘルメットをくれるんだね。おお"}, {"type": "subtitle", "time": 744.389, "timestamp": "00:12:24", "text": "くそっ。彼らの走りを見てごらん。彼らは壊れたものを食べる。"}, {"type": "subtitle", "time": 746.949, "timestamp": "00:12:26", "text": "待って、あの看板は何？砂虫。おお"}, {"type": "subtitle", "time": 749.19, "timestamp": "00:12:29", "text": "くそっ。それは正しい。私たちはそうしなければならない"}, {"type": "subtitle", "time": 751.19, "timestamp": "00:12:31", "text": "本当に注意して。"}]
[{"type": "subtitle", "time": 15370.75, "timestamp": "04:16:10", "text": "ああ、昨日俺の荷物が埋まってしまった"}, {"type": "subtitle", "time": 15374.07, "timestamp": "04:16:14", "text": "上。悲しいです。"}, {"type": "subtitle", "time": 15378.03, "timestamp": "04:16:18", "text": "えっと、昨日はこれらのものすべてが今"}, {"type": "subtitle", "time": 15384.75, "timestamp": "04:16:24", "text": "起きて、ああ、ただ"}, {"type": "subtitle", "time": 15392.469, "timestamp": "04:16:32", "text": "来て。"}, {"type": "subtitle", "time": 15401.59, "timestamp": "04:16:41", "text": "私を入れてください。"}, {"type": "subtitle", "time": 15403.71, "timestamp": "04:16:43", "text": "私にさせて"}, {"type": "subtitle", "time": 15406.229, "timestamp": "04:16:46", "text": "うん。ねえ、知ってる？アレクサ、ブラウズして"}, {"type": "subtitle", "time": 15409.189, "timestamp": "04:16:49", "text": "ツイッター。"}, {"type": "subtitle", "time": 15412.59, "timestamp": "04:16:52", "text": "ある程度は当てはまるが、私には当てはまらない。"}, {"type": "subtitle", "time": 15416.79, "timestamp": "04:16:56", "text": "えーとレールの最新情​​報"}]
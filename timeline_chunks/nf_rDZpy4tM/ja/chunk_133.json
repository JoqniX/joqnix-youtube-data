[{"type": "subtitle", "time": 7980.47, "timestamp": "02:13:00", "text": "種。わかったよ、バカ野郎。さあ行こう。"}, {"type": "subtitle", "time": 7983.189, "timestamp": "02:13:03", "text": "何？いいえ。こんにちは。はじめまして。または"}, {"type": "subtitle", "time": 7985.51, "timestamp": "02:13:05", "text": "助けてくれてありがとう。なぜ？あなたのような"}, {"type": "subtitle", "time": 7987.43, "timestamp": "02:13:07", "text": "死ななかったのは何らかの恩恵があったからだ"}, {"type": "subtitle", "time": 7990.55, "timestamp": "02:13:10", "text": "私にとって？こんにちは、私はスウェーデン人です。どうもありがとうございます。"}, {"type": "subtitle", "time": 7993.51, "timestamp": "02:13:13", "text": "私を助けてくれてありがとう。どうだ、このバカ野郎？"}, {"type": "subtitle", "time": 7995.51, "timestamp": "02:13:15", "text": "さあ、行こう。私のタイムバブルを使って"}, {"type": "subtitle", "time": 7998.149, "timestamp": "02:13:18", "text": "世界最大の扇風機を通して脱出する。"}, {"type": "subtitle", "time": 8000.55, "timestamp": "02:13:20", "text": "なかなかいいでしょ？あなたは見つけるでしょう"}, {"type": "subtitle", "time": 8003.35, "timestamp": "02:13:23", "text": "俺が最高のガトリンだってことをすぐに証明してやる。"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "最も賢く、最も便利で、最も見栄えが良い。いいえ。"}, {"type": "subtitle", "time": 8008.229, "timestamp": "02:13:28", "text": "いや。冗談でしょ。来て。私はかなり"}, {"type": "subtitle", "time": 8011.109, "timestamp": "02:13:31", "text": "ダグラス。それは衣服のようだ。どこで"}, {"type": "subtitle", "time": 8013.27, "timestamp": "02:13:33", "text": "お前は一体何者だ？あなたが作ったと聞きました"}, {"type": "subtitle", "time": 8015.03, "timestamp": "02:13:35", "text": "あのパーティーでのあなたは完全に愚か者だった"}, {"type": "subtitle", "time": 8020.229, "timestamp": "02:13:40", "text": "昨晩。良くないぞ、ダグラス。良くない。"}, {"type": "subtitle", "time": 8021.75, "timestamp": "02:13:41", "text": "君には君の力が必要だ"}, {"type": "subtitle", "time": 8023.43, "timestamp": "02:13:43", "text": "これらを手に入れた今、ゲーム"}, {"type": "subtitle", "time": 8026.229, "timestamp": "02:13:46", "text": "人間。私たちは地球上に薄く広がっている、"}, {"type": "subtitle", "time": 8029.75, "timestamp": "02:13:49", "text": "そして、私はすぐにでももっと多くの兵士を必要としている。"}, {"type": "subtitle", "time": 8031.43, "timestamp": "02:13:51", "text": "これからどんどんヒートアップしていく"}, {"type": "subtitle", "time": 8034.95, "timestamp": "02:13:54", "text": "需要の高まりに伴い、銀河全体で拡大している。大きい"}, {"type": "subtitle", "time": 8037.31, "timestamp": "02:13:57", "text": "事態は進行しているよ、ダグラス。得る"}, {"type": "subtitle", "time": 8039.83, "timestamp": "02:13:59", "text": "興奮して、自分のクソみたいなものを手に入れろ"}]
[{"type": "subtitle", "time": 16202.149, "timestamp": "04:30:02", "text": "各都市にはそれぞれ独自の番人が配置されている。"}, {"type": "subtitle", "time": 16205.91, "timestamp": "04:30:05", "text": "何てことだ。ありがとう。"}, {"type": "subtitle", "time": 16210.91, "timestamp": "04:30:10", "text": "何てことだ。何てことだ。ありがとうございます"}, {"type": "subtitle", "time": 16214.87, "timestamp": "04:30:14", "text": "贈られた購読。何てことだ。ああ、"}, {"type": "subtitle", "time": 16217.189, "timestamp": "04:30:17", "text": "神。バカ、そんなことしなくてもよかったのに、ありがとう"}, {"type": "subtitle", "time": 16219.469, "timestamp": "04:30:19", "text": "あなた。ああ、"}, {"type": "subtitle", "time": 16222.91, "timestamp": "04:30:22", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 16227.11, "timestamp": "04:30:27", "text": "何？何？本当にありがとうございました。"}, {"type": "subtitle", "time": 16229.87, "timestamp": "04:30:29", "text": "繁栄する。抽選と"}, {"type": "subtitle", "time": 16233.149, "timestamp": "04:30:33", "text": "カワイは現在"}, {"type": "subtitle", "time": 16235.03, "timestamp": "04:30:35", "text": "共存している理由 ああ、どういう意味ですか？"}, {"type": "subtitle", "time": 16236.63, "timestamp": "04:30:36", "text": "イベントのためにやったんです。待って、"}, {"type": "subtitle", "time": 16239.349, "timestamp": "04:30:39", "text": "イベント？ストリーミング配信イベント。そうそう、"}, {"type": "subtitle", "time": 16241.07, "timestamp": "04:30:41", "text": "それは確かに存在する。私"}, {"type": "subtitle", "time": 16243.99, "timestamp": "04:30:43", "text": "中心を忘れた。何てことだ。ありがとう。"}, {"type": "subtitle", "time": 16249.79, "timestamp": "04:30:49", "text": "の一部"}, {"type": "subtitle", "time": 16252.87, "timestamp": "04:30:52", "text": "もちろん他の地域でもそうですが、"}, {"type": "subtitle", "time": 16255.99, "timestamp": "04:30:55", "text": "より少ない"}, {"type": "subtitle", "time": 16259.189, "timestamp": "04:30:59", "text": "大金持ち。"}]
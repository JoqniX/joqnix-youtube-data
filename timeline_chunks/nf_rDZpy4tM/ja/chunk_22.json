[{"type": "subtitle", "time": 1321.47, "timestamp": "00:22:01", "text": "そうでしょう"}, {"type": "subtitle", "time": 1332.63, "timestamp": "00:22:12", "text": "敢えて。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。あなたはそうしません。"}, {"type": "subtitle", "time": 1342.99, "timestamp": "00:22:22", "text": "1"}, {"type": "subtitle", "time": 1345.95, "timestamp": "00:22:25", "text": "直面した私は何人かからこの言葉を聞いた"}, {"type": "subtitle", "time": 1351.07, "timestamp": "00:22:31", "text": "映画。それが何を意味するのかはわかりませんが"}, {"type": "subtitle", "time": 1353.43, "timestamp": "00:22:33", "text": "はい、世界中の何でも。いや、そうじゃない"}, {"type": "subtitle", "time": 1354.59, "timestamp": "00:22:34", "text": "自分"}, {"type": "subtitle", "time": 1364.83, "timestamp": "00:22:44", "text": "何てことだ。"}, {"type": "subtitle", "time": 1368.23, "timestamp": "00:22:48", "text": "ついに。ついに。何てことだ。ついに手に入れた"}, {"type": "subtitle", "time": 1370.19, "timestamp": "00:22:50", "text": "の"}, {"type": "subtitle", "time": 1374.83, "timestamp": "00:22:54", "text": "胸。何てことだ。それは私に"}]
[{"type": "subtitle", "time": 1203.909, "timestamp": "00:20:03", "text": "Let me tell you something. This place is"}, {"type": "subtitle", "time": 1206.549, "timestamp": "00:20:06", "text": "a complete hell hole. But you know what?"}, {"type": "subtitle", "time": 1209.31, "timestamp": "00:20:09", "text": "Once we get to the city, oh"}, {"type": "subtitle", "time": 1212.07, "timestamp": "00:20:12", "text": "boy, still a hell hole. But hell's a lot"}, {"type": "subtitle", "time": 1213.909, "timestamp": "00:20:13", "text": "more fun when other people around. Take"}, {"type": "subtitle", "time": 1216.23, "timestamp": "00:20:16", "text": "it from me. You're going to love it."}, {"type": "subtitle", "time": 1219.669, "timestamp": "00:20:19", "text": "People always say that. Take it from me."}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "I afraid?"}, {"type": "subtitle", "time": 1239.99, "timestamp": "00:20:39", "text": "leave. I need you to stay."}, {"type": "subtitle", "time": 1254.07, "timestamp": "00:20:54", "text": "Okay, got it. Got it. Got it. Got it."}, {"type": "subtitle", "time": 1257.029, "timestamp": "00:20:57", "text": "Almost there."}, {"type": "subtitle", "time": 1259.27, "timestamp": "00:20:59", "text": "I am so proud of you, son. You You look"}]
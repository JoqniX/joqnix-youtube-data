[{"type": "subtitle", "time": 26522.15, "timestamp": "07:22:02", "text": "Things are always like this in the rear."}, {"type": "subtitle", "time": 26524.548, "timestamp": "07:22:04", "text": "The frontline soldiers focus solely on"}, {"type": "subtitle", "time": 26527.39, "timestamp": "07:22:07", "text": "battle, following orders, and striking"}, {"type": "subtitle", "time": 26530.548, "timestamp": "07:22:10", "text": "enemies. But in the rear, personnel must"}, {"type": "subtitle", "time": 26535.31, "timestamp": "07:22:15", "text": "juggle numerous tasks, supplies, medical"}, {"type": "subtitle", "time": 26538.03, "timestamp": "07:22:18", "text": "care, personnel management, and"}, {"type": "subtitle", "time": 26540.628, "timestamp": "07:22:20", "text": "logistics. They must carefully manage"}, {"type": "subtitle", "time": 26544.15, "timestamp": "07:22:24", "text": "these matters to support fighters. So"}, {"type": "subtitle", "time": 26548.15, "timestamp": "07:22:28", "text": "this is what a real war looks like."}, {"type": "subtitle", "time": 26550.468, "timestamp": "07:22:30", "text": "I had no idea it could get this bad."}, {"type": "subtitle", "time": 26552.23, "timestamp": "07:22:32", "text": "Most people would never have the chance"}, {"type": "subtitle", "time": 26554.948, "timestamp": "07:22:34", "text": "to witness any of this. It's natural for"}, {"type": "subtitle", "time": 26558.628, "timestamp": "07:22:38", "text": "you not to forget. Uh you woke up in the"}, {"type": "subtitle", "time": 26561.27, "timestamp": "07:22:41", "text": "morning and you sleep off again to"}, {"type": "subtitle", "time": 26563.19, "timestamp": "07:22:43", "text": "ensure peace. Then you properly wake up"}, {"type": "subtitle", "time": 26567.35, "timestamp": "07:22:47", "text": "at 71. That's a sacrifice made so others"}, {"type": "subtitle", "time": 26570.708, "timestamp": "07:22:50", "text": "don't have to live in fear."}, {"type": "subtitle", "time": 26572.868, "timestamp": "07:22:52", "text": "Yeah. Short hair. You see, I got a"}, {"type": "subtitle", "time": 26577.23, "timestamp": "07:22:57", "text": "redhead lady Dio from the pools fourstar"}]
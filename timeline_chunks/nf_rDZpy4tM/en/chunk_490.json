[{"type": "subtitle", "time": 29405.51, "timestamp": "08:10:05", "text": "[Music]"}, {"type": "subtitle", "time": 29407.468, "timestamp": "08:10:07", "text": "But out of all the"}, {"type": "subtitle", "time": 29410.07, "timestamp": "08:10:10", "text": "onlookers, I'm the only one who came"}, {"type": "subtitle", "time": 29413.31, "timestamp": "08:10:13", "text": "forward to meet you with absolute"}, {"type": "subtitle", "time": 29416.23, "timestamp": "08:10:16", "text": "honesty. Before you knew anything about"}, {"type": "subtitle", "time": 29419.03, "timestamp": "08:10:19", "text": "this world, you were already the center"}, {"type": "subtitle", "time": 29425.35, "timestamp": "08:10:25", "text": "You are the unknown variable we've been"}, {"type": "subtitle", "time": 29427.27, "timestamp": "08:10:27", "text": "waiting."}, {"type": "subtitle", "time": 29429.91, "timestamp": "08:10:29", "text": "Forces have been fighting for possession"}, {"type": "subtitle", "time": 29432.948, "timestamp": "08:10:32", "text": "over you. From the moment you opened"}, {"type": "subtitle", "time": 29435.35, "timestamp": "08:10:35", "text": "your eyes, everyone you've met,"}, {"type": "subtitle", "time": 29437.75, "timestamp": "08:10:37", "text": "including that girl you care so much"}, {"type": "subtitle", "time": 29441.43, "timestamp": "08:10:41", "text": "about. They all knew how valuable you"}, {"type": "subtitle", "time": 29446.788, "timestamp": "08:10:46", "text": "are. Huh? The world is a cruel place."}, {"type": "subtitle", "time": 29449.75, "timestamp": "08:10:49", "text": "You are a living, breathing person, but"}, {"type": "subtitle", "time": 29452.03, "timestamp": "08:10:52", "text": "you're just a pawn to"}, {"type": "subtitle", "time": 29456.15, "timestamp": "08:10:56", "text": "many. That's why I'm here, because I see"}, {"type": "subtitle", "time": 29459.19, "timestamp": "08:10:59", "text": "you as a dear friend, and I want to tell"}]
[{"type": "subtitle", "time": 30181.35, "timestamp": "08:23:01", "text": "Rover, do you think someone would give"}, {"type": "subtitle", "time": 30184.548, "timestamp": "08:23:04", "text": "you what you want without"}, {"type": "subtitle", "time": 30191.83, "timestamp": "08:23:11", "text": "[Music]"}, {"type": "subtitle", "time": 30195.27, "timestamp": "08:23:15", "text": "I once believed that too. Thought as"}, {"type": "subtitle", "time": 30198.07, "timestamp": "08:23:18", "text": "long as I paid a high enough price, I"}, {"type": "subtitle", "time": 30200.388, "timestamp": "08:23:20", "text": "could get my desired outcome. I just"}, {"type": "subtitle", "time": 30202.468, "timestamp": "08:23:22", "text": "woke up. Quality is scarce. Hope you"}, {"type": "subtitle", "time": 30203.388, "timestamp": "08:23:23", "text": "have a good"}, {"type": "subtitle", "time": 30206.31, "timestamp": "08:23:26", "text": "morning. Ate dinner. I ate breakfast and"}, {"type": "subtitle", "time": 30208.948, "timestamp": "08:23:28", "text": "stuff and etc. Place good luck. Good"}, {"type": "subtitle", "time": 30210.628, "timestamp": "08:23:30", "text": "luck."}, {"type": "subtitle", "time": 30213.51, "timestamp": "08:23:33", "text": "To receive equal retribution, one must"}, {"type": "subtitle", "time": 30218.388, "timestamp": "08:23:38", "text": "give more and more and more. When every"}, {"type": "subtitle", "time": 30221.11, "timestamp": "08:23:41", "text": "wish comes with a hefty price, people"}, {"type": "subtitle", "time": 30223.99, "timestamp": "08:23:43", "text": "weigh their options carefully."}, {"type": "subtitle", "time": 30228.19, "timestamp": "08:23:48", "text": "When they can make someone else bear the"}, {"type": "subtitle", "time": 30231.75, "timestamp": "08:23:51", "text": "price, they all rush to make more"}, {"type": "subtitle", "time": 30235.51, "timestamp": "08:23:55", "text": "wishes. They don't consider they too may"}, {"type": "subtitle", "time": 30239.43, "timestamp": "08:23:59", "text": "one day pay for another selfish desire."}]
[{"type": "subtitle", "time": 29282.31, "timestamp": "08:08:02", "text": "it's H."}, {"type": "subtitle", "time": 29284.99, "timestamp": "08:08:04", "text": "Guess you won't need my self"}, {"type": "subtitle", "time": 29299.18, "timestamp": "08:08:19", "text": "Who is this?"}, {"type": "subtitle", "time": 29314.31, "timestamp": "08:08:34", "text": "[Music]"}, {"type": "subtitle", "time": 29317.27, "timestamp": "08:08:37", "text": "If you need to hear it from me, then"}, {"type": "subtitle", "time": 29321.67, "timestamp": "08:08:41", "text": "yes, I am Scar. Who are you again? Cruel"}, {"type": "subtitle", "time": 29323.74, "timestamp": "08:08:43", "text": "and twisted maniac."}, {"type": "subtitle", "time": 29327.19, "timestamp": "08:08:47", "text": "[Music]"}, {"type": "subtitle", "time": 29329.59, "timestamp": "08:08:49", "text": "Where's Yang Yan? We deserve a meeting"}, {"type": "subtitle", "time": 29333.788, "timestamp": "08:08:53", "text": "free of such disturbances. Don't you"}, {"type": "subtitle", "time": 29337.03, "timestamp": "08:08:57", "text": "agree? The girl, she's going to sway"}, {"type": "subtitle", "time": 29339.35, "timestamp": "08:08:59", "text": "your judgment."}]
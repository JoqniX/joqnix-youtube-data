[{"type": "subtitle", "time": 19995.83, "timestamp": "05:33:15", "text": "For some reason, you can tell Sona"}, {"type": "subtitle", "time": 19997.47, "timestamp": "05:33:17", "text": "doesn't want to continue"}, {"type": "subtitle", "time": 20008.948, "timestamp": "05:33:28", "text": "may I have your terminal for a moment?"}, {"type": "subtitle", "time": 20011.59, "timestamp": "05:33:31", "text": "Uh, my terminal. Oh, exchanging it."}, {"type": "subtitle", "time": 20014.548, "timestamp": "05:33:34", "text": "Okay. is an oversight on my end. I will"}, {"type": "subtitle", "time": 20017.19, "timestamp": "05:33:37", "text": "now import my contact information and"}, {"type": "subtitle", "time": 20019.83, "timestamp": "05:33:39", "text": "that of all public services like patrol"}, {"type": "subtitle", "time": 20022.31, "timestamp": "05:33:42", "text": "stations into your terminal. I will be"}, {"type": "subtitle", "time": 20024.47, "timestamp": "05:33:44", "text": "here on standby, ready to assist"}, {"type": "subtitle", "time": 20028.07, "timestamp": "05:33:48", "text": "whenever you need me. Aw, I need your"}, {"type": "subtitle", "time": 20030.19, "timestamp": "05:33:50", "text": "terminal for regional access"}, {"type": "subtitle", "time": 20032.708, "timestamp": "05:33:52", "text": "authorization. I will also configure the"}, {"type": "subtitle", "time": 20034.788, "timestamp": "05:33:54", "text": "latest utility module for you. Madame"}, {"type": "subtitle", "time": 20037.11, "timestamp": "05:33:57", "text": "Magistrate thought you might need it."}, {"type": "subtitle", "time": 20038.18, "timestamp": "05:33:58", "text": "Okay."}]
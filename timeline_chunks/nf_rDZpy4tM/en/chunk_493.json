[{"type": "subtitle", "time": 29582.388, "timestamp": "08:13:02", "text": "Um, I see you don't really trust those"}, {"type": "subtitle", "time": 29589.91, "timestamp": "08:13:09", "text": "Ah, so they were right about you. You"}, {"type": "subtitle", "time": 29592.27, "timestamp": "08:13:12", "text": "are indeed quite exceptional."}, {"type": "subtitle", "time": 29595.27, "timestamp": "08:13:15", "text": "[Music]"}, {"type": "subtitle", "time": 29598.628, "timestamp": "08:13:18", "text": "I like it. Your keen observation,"}, {"type": "subtitle", "time": 29601.67, "timestamp": "08:13:21", "text": "precise judgment, and accurate"}, {"type": "subtitle", "time": 29604.03, "timestamp": "08:13:24", "text": "understanding of human"}, {"type": "subtitle", "time": 29606.788, "timestamp": "08:13:26", "text": "nature. Let me give you a couple more"}, {"type": "subtitle", "time": 29612.868, "timestamp": "08:13:32", "text": "Huh? The truth is far more complicated"}, {"type": "subtitle", "time": 29615.31, "timestamp": "08:13:35", "text": "than you"}, {"type": "subtitle", "time": 29620.19, "timestamp": "08:13:40", "text": "think. First, who are the players in our"}, {"type": "subtitle", "time": 29623.75, "timestamp": "08:13:43", "text": "tale? An innocent girl, a revered"}, {"type": "subtitle", "time": 29627.868, "timestamp": "08:13:47", "text": "leader, and a flock of simple"}, {"type": "subtitle", "time": 29631.51, "timestamp": "08:13:51", "text": "villagers. Next, what makes up our main"}, {"type": "subtitle", "time": 29633.27, "timestamp": "08:13:53", "text": "plot?"}, {"type": "subtitle", "time": 29636.868, "timestamp": "08:13:56", "text": "false devotion, fleeting kindness,"}, {"type": "subtitle", "time": 29639.99, "timestamp": "08:13:59", "text": "collective deceit, senseless killings,"}]
[{"type": "subtitle", "time": 31682.07, "timestamp": "08:48:02", "text": "that place without any wind to speak of."}, {"type": "subtitle", "time": 31684.23, "timestamp": "08:48:04", "text": "But I She's the icon of the game"}, {"type": "subtitle", "time": 31688.91, "timestamp": "08:48:08", "text": "actually. And desperate cries for help."}, {"type": "subtitle", "time": 31693.19, "timestamp": "08:48:13", "text": "I could not the villagers were a mix of"}, {"type": "subtitle", "time": 31695.788, "timestamp": "08:48:15", "text": "emotions,"}, {"type": "subtitle", "time": 31699.03, "timestamp": "08:48:19", "text": "resentment, and despair."}, {"type": "subtitle", "time": 31701.35, "timestamp": "08:48:21", "text": "And as I wrote,"}, {"type": "subtitle", "time": 31703.75, "timestamp": "08:48:23", "text": "I could feel the intense sorrow and"}, {"type": "subtitle", "time": 31706.07, "timestamp": "08:48:26", "text": "longing of its owner. What was the"}, {"type": "subtitle", "time": 31708.11, "timestamp": "08:48:28", "text": "diary's owner longing"}, {"type": "subtitle", "time": 31711.468, "timestamp": "08:48:31", "text": "for? Was it the peaceful life she once"}, {"type": "subtitle", "time": 31715.75, "timestamp": "08:48:35", "text": "had? Or did she miss her only family?"}, {"type": "subtitle", "time": 31718.388, "timestamp": "08:48:38", "text": "The person who pushed her towards such a"}, {"type": "subtitle", "time": 31721.99, "timestamp": "08:48:41", "text": "tragic end? My apologies. I got lost in"}, {"type": "subtitle", "time": 31729.11, "timestamp": "08:48:49", "text": "I wish I could say such tragedies won't"}, {"type": "subtitle", "time": 31730.83, "timestamp": "08:48:50", "text": "happen"}, {"type": "subtitle", "time": 31734.15, "timestamp": "08:48:54", "text": "again. But I still lack the confidence"}, {"type": "subtitle", "time": 31737.11, "timestamp": "08:48:57", "text": "to make that claim."}, {"type": "subtitle", "time": 31739.19, "timestamp": "08:48:59", "text": "It was tragedies like this that made me"}]
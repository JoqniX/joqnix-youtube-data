[{"type": "subtitle", "time": 30542.628, "timestamp": "08:29:02", "text": "grant any wish it desired. In exchange,"}, {"type": "subtitle", "time": 30545.91, "timestamp": "08:29:05", "text": "he wanted one of its companions as a"}, {"type": "subtitle", "time": 30547.43, "timestamp": "08:29:07", "text": "sacrifice."}, {"type": "subtitle", "time": 30554.468, "timestamp": "08:29:14", "text": "The black lamb refused and it was"}, {"type": "subtitle", "time": 30556.99, "timestamp": "08:29:16", "text": "shunned by its flock,"}, {"type": "subtitle", "time": 30560.82, "timestamp": "08:29:20", "text": "left shelter or sustenance."}, {"type": "subtitle", "time": 30562.628, "timestamp": "08:29:22", "text": "[Music]"}, {"type": "subtitle", "time": 30566.468, "timestamp": "08:29:26", "text": "After the black lamb's exile, more lambs"}, {"type": "subtitle", "time": 30569.35, "timestamp": "08:29:29", "text": "continued to vanish. Lambs too. Ram yum"}, {"type": "subtitle", "time": 30573.27, "timestamp": "08:29:33", "text": "yum. Oh my god. Black lab for breaking"}, {"type": "subtitle", "time": 30574.59, "timestamp": "08:29:34", "text": "the"}, {"type": "subtitle", "time": 30577.91, "timestamp": "08:29:37", "text": "rules and withheld his wish granting"}, {"type": "subtitle", "time": 30590.308, "timestamp": "08:29:50", "text": "punishment. From the very beginning, the"}, {"type": "subtitle", "time": 30593.35, "timestamp": "08:29:53", "text": "lambs knew the risk of making wishes."}, {"type": "subtitle", "time": 30596.23, "timestamp": "08:29:56", "text": "They too could become sacrifices for"}, {"type": "subtitle", "time": 30598.788, "timestamp": "08:29:58", "text": "those of others."}]
[{"type": "subtitle", "time": 28502.708, "timestamp": "07:55:02", "text": "Frequencies of human turning the last"}, {"type": "subtitle", "time": 28505.03, "timestamp": "07:55:05", "text": "bits of a human's consciousness into"}, {"type": "subtitle", "time": 28507.31, "timestamp": "07:55:07", "text": "such monotonous"}, {"type": "subtitle", "time": 28510.31, "timestamp": "07:55:10", "text": "mumbles. Are these words the last cries"}, {"type": "subtitle", "time": 28511.788, "timestamp": "07:55:11", "text": "of someone"}, {"type": "subtitle", "time": 28514.948, "timestamp": "07:55:14", "text": "innocent? Who is behind this twisted"}, {"type": "subtitle", "time": 28519.42, "timestamp": "07:55:19", "text": "plot? Twisted plot. You say"}, {"type": "subtitle", "time": 28527.51, "timestamp": "07:55:27", "text": "I'm sorry. Are you talking to it? No,"}, {"type": "subtitle", "time": 28529.59, "timestamp": "07:55:29", "text": "that's beyond my ability. Send some"}, {"type": "subtitle", "time": 28531.59, "timestamp": "07:55:31", "text": "complex feelings for me. Mixture of deep"}, {"type": "subtitle", "time": 28533.67, "timestamp": "07:55:33", "text": "sadness and eager anticipation. Mixture"}, {"type": "subtitle", "time": 28538.468, "timestamp": "07:55:38", "text": "of deep sadness and eager anticipation."}, {"type": "subtitle", "time": 28540.948, "timestamp": "07:55:40", "text": "I think I know what it seems to be for"}, {"type": "subtitle", "time": 28544.628, "timestamp": "07:55:44", "text": "help, but it's not asking us to help it."}, {"type": "subtitle", "time": 28546.948, "timestamp": "07:55:46", "text": "I can sense the pained cries of this"}, {"type": "subtitle", "time": 28549.468, "timestamp": "07:55:49", "text": "tacid discord."}, {"type": "subtitle", "time": 28552.868, "timestamp": "07:55:52", "text": "No, the cries of this whole village. The"}, {"type": "subtitle", "time": 28555.59, "timestamp": "07:55:55", "text": "village is crying, waiting to be"}, {"type": "subtitle", "time": 28557.91, "timestamp": "07:55:57", "text": "rescued."}]
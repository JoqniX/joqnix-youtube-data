[{"type": "subtitle", "time": 17041.99, "timestamp": "04:44:01", "text": "Are you all right? Are you hurt?"}, {"type": "subtitle", "time": 17045.99, "timestamp": "04:44:05", "text": "Shakes your head. I'm fine."}, {"type": "subtitle", "time": 17048.948, "timestamp": "04:44:08", "text": "Thank goodness. We could see that darn"}, {"type": "subtitle", "time": 17051.47, "timestamp": "04:44:11", "text": "barrier, but couldn't lay a finger on"}, {"type": "subtitle", "time": 17054.55, "timestamp": "04:44:14", "text": "it. I'm fine, too."}, {"type": "subtitle", "time": 17057.11, "timestamp": "04:44:17", "text": "I've never seen such a formidable tacet"}, {"type": "subtitle", "time": 17059.51, "timestamp": "04:44:19", "text": "discord before. Tacit discard. Rover was"}, {"type": "subtitle", "time": 17062.07, "timestamp": "04:44:22", "text": "able to completely defeat it. They beat"}, {"type": "subtitle", "time": 17068.39, "timestamp": "04:44:28", "text": "I didn't really do much. It was all"}, {"type": "subtitle", "time": 17071.35, "timestamp": "04:44:31", "text": "thanks to you, Rover. Why is she so"}, {"type": "subtitle", "time": 17075.628, "timestamp": "04:44:35", "text": "cute? This place isn't known to be so"}, {"type": "subtitle", "time": 17090.67, "timestamp": "04:44:50", "text": "Oh, this is an"}, {"type": "subtitle", "time": 17095.15, "timestamp": "04:44:55", "text": "echo. Wow, an echo of the elite"}, {"type": "subtitle", "time": 17098.948, "timestamp": "04:44:58", "text": "class. Someone got lucky today. Elite"}]
[{"type": "subtitle", "time": 31449.53, "timestamp": "08:44:09", "text": "Look, the water is going down."}, {"type": "subtitle", "time": 31469.43, "timestamp": "08:44:29", "text": "believe I can't believe it. There is"}, {"type": "subtitle", "time": 31473.15, "timestamp": "08:44:33", "text": "such a big opening down here."}, {"type": "subtitle", "time": 31476.23, "timestamp": "08:44:36", "text": "God, this place should have been soaked"}, {"type": "subtitle", "time": 31480.708, "timestamp": "08:44:40", "text": "in water, but everything is dry here."}, {"type": "subtitle", "time": 31482.948, "timestamp": "08:44:42", "text": "Even the vegetation is thriving. Okay,"}, {"type": "subtitle", "time": 31486.23, "timestamp": "08:44:46", "text": "boss. Bye."}, {"type": "subtitle", "time": 31487.308, "timestamp": "08:44:47", "text": "That"}, {"type": "subtitle", "time": 31489.628, "timestamp": "08:44:49", "text": "tree. It's"}, {"type": "subtitle", "time": 31492.948, "timestamp": "08:44:52", "text": "stunning. It's enchanting. Eerily"}, {"type": "subtitle", "time": 31494.83, "timestamp": "08:44:54", "text": "enchanting."}, {"type": "subtitle", "time": 31499.03, "timestamp": "08:44:59", "text": "Please save us."}]
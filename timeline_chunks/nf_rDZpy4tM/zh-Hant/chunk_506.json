[{"type": "subtitle", "time": 30367.75, "timestamp": "08:26:07", "text": "殺死他，因為他看起來有點不一樣。是的。你還好嗎？  我看到了異象。不，我很擔心。你只是站在那裡，凝視著遠方。我跟你說話的時候，你沒有回應。"}, {"type": "subtitle", "time": 30370.868, "timestamp": "08:26:10", "text": "你看到了什麼"}, {"type": "subtitle", "time": 30373.27, "timestamp": "08:26:13", "text": "？感覺就像"}, {"type": "subtitle", "time": 30375.51, "timestamp": "08:26:15", "text": "我透過一種心照不宣的不和諧的視角來看世界。  敵方戰士"}, {"type": "subtitle", "time": 30399.11, "timestamp": "08:26:39", "text": "擁有廷龍之力。廷隆是午夜遊俠的標誌。它也是午夜遊俠首領田將軍的象徵。前線離這裡不遠。蒂安將軍一定在那裡並肩作戰。這似乎"}]
[{"type": "subtitle", "time": 1203.909, "timestamp": "00:20:03", "text": "其中一項任務。  福克爾。"}, {"type": "subtitle", "time": 1213.909, "timestamp": "00:20:13", "text": "把它舉過來。我可以藉助外力跳起來。是啊，這真是個絕妙的主意，喬。好的。"}, {"type": "subtitle", "time": 1216.23, "timestamp": "00:20:16", "text": "你真是個聰明"}, {"type": "subtitle", "time": 1219.669, "timestamp": "00:20:19", "text": "人。  是的。等等，我需要找到其中一個，對吧"}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "？"}, {"type": "subtitle", "time": 1239.99, "timestamp": "00:20:39", "text": "繼續吸吮它們。  是的。是的。是的。"}, {"type": "subtitle", "time": 1259.27, "timestamp": "00:20:59", "text": "我愛你勝過世上的一切。過來。什麼？  你真是個橘子人。  等待。快到了。"}]
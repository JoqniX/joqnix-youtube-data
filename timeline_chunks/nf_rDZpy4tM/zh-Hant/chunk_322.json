[{"type": "subtitle", "time": 19348.31, "timestamp": "05:22:28", "text": "是什麼意思？他以前是個非常強大的人。就像他們把整個宇宙握在手中一樣，因為"}, {"type": "subtitle", "time": 19349.83, "timestamp": "05:22:29", "text": "沒有……而且我可能覺得為了安全起見，為了不被比利·"}, {"type": "subtitle", "time": 19362.03, "timestamp": "05:22:42", "text": "比利封禁，我應該下載那個迴聲的中文語音來重建，因為你永遠不知道現在會發生什麼，所以我們先改一下語音，"}, {"type": "subtitle", "time": 19365.99, "timestamp": "05:22:45", "text": "好吧，"}, {"type": "subtitle", "time": 19371.43, "timestamp": "05:22:51", "text": "我希望這樣做沒"}]
[{"type": "subtitle", "time": 21982.51, "timestamp": "06:06:22", "text": "這篇很長。而我們談論的竟然是金喬。過去一千年來，我們經歷了不少動盪不安的歲月。而且我們每次都一起成功了。"}, {"type": "subtitle", "time": 22002.11, "timestamp": "06:06:42", "text": "每年都有TD疫情爆發。"}, {"type": "subtitle", "time": 22017.03, "timestamp": "06:06:57", "text": "但是我們總可以信賴基彥將軍、地方官夫人和我們的哨兵，他們"}]
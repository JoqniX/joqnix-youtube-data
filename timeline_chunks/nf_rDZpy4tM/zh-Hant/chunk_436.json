[{"type": "subtitle", "time": 26179.27, "timestamp": "07:16:19", "text": "你雖然不看，但我也在Twitch上看到你。早安.他也回來玩這個遊戲了。是的。"}, {"type": "subtitle", "time": 26185.27, "timestamp": "07:16:25", "text": "我是楊楊，午夜遊俠的先鋒騎兵。"}, {"type": "subtitle", "time": 26192.11, "timestamp": "07:16:32", "text": "讓我把壞人介紹給你要找的人。  你見過他嗎？我見過他一次。他不僅似乎決心加入我們，而且"}, {"type": "subtitle", "time": 26195.07, "timestamp": "07:16:35", "text": "似乎從去年起就決心"}, {"type": "subtitle", "time": 26197.83, "timestamp": "07:16:37", "text": "加入我們。"}]
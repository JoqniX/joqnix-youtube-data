[{"type": "subtitle", "time": 9061.03, "timestamp": "02:31:01", "text": "帽子戲法嗎"}, {"type": "subtitle", "time": 9063.83, "timestamp": "02:31:03", "text": "？  我的"}, {"type": "subtitle", "time": 9065.59, "timestamp": "02:31:05", "text": "水晶會黏在袋子裡，如果你用力敲打它們，它們就會爆炸。用刀反擊。你明白我的意思。盡情"}, {"type": "subtitle", "time": 9097.87, "timestamp": "02:31:37", "text": "水晶真酷"}, {"type": "subtitle", "time": 9099.68, "timestamp": "02:31:39", "text": "。所以，這就是擁有雙腿的感覺。  嗯"}]
[{"type": "subtitle", "time": 31327.19, "timestamp": "08:42:07", "text": "監督者，他們是擁有詭異能力和未知意圖的領導者。它們構成更大的威脅。沒有人知道他們的真實意圖。  有些成員宣稱要"}, {"type": "subtitle", "time": 31330.23, "timestamp": "08:42:10", "text": "毀滅世界，而有些成員則聲稱"}, {"type": "subtitle", "time": 31361.19, "timestamp": "08:42:41", "text": "他們追求永恆的力量。而且還有一位特別瘋狂的監工。"}, {"type": "subtitle", "time": 31363.308, "timestamp": "08:42:43", "text": "即使以"}]
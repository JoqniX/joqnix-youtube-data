[{"type": "subtitle", "time": 21194.708, "timestamp": "05:53:14", "text": "存放著實物，但兒子的城堡裡存放著過去的記錄時，簡單來說，我的觀察是，在"}, {"type": "subtitle", "time": 21205.11, "timestamp": "05:53:25", "text": "這些城堡裡，"}, {"type": "subtitle", "time": 21210.07, "timestamp": "05:53:30", "text": "人們可以找到過去輝煌文明的大多數文物，以及拉默的配件，還有人類在拉默時期經歷的深刻情感，它們代表著被無情的歷史浪潮沖刷掉的"}, {"type": "subtitle", "time": 21211.83, "timestamp": "05:53:31", "text": "舊時代的最後遺跡。我有"}, {"type": "subtitle", "time": 21214.708, "timestamp": "05:53:34", "text": "一個自私的請求。能把這個給我嗎？"}, {"type": "subtitle", "time": 21217.35, "timestamp": "05:53:37", "text": "為什麼對於那些竊取其中資訊的人來說，這些資訊還沒有經濟價值呢？所以沒有人的資產被高度隱瞞。"}, {"type": "subtitle", "time": 21232.07, "timestamp": "05:53:52", "text": "我可以陪你玩，然後用巧克力或其他東西付你報酬。這對你來說真是一筆划算的"}]
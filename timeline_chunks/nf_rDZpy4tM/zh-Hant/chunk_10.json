[{"type": "subtitle", "time": 612.79, "timestamp": "00:10:12", "text": "你"}, {"type": "subtitle", "time": 616.71, "timestamp": "00:10:16", "text": "能冷靜下來嗎"}, {"type": "subtitle", "time": 618.71, "timestamp": "00:10:18", "text": "？他們不必死。  你在"}, {"type": "subtitle", "time": 621.829, "timestamp": "00:10:21", "text": "哪裡？你是不是在我家下面用手機之類的東西拍照？所有官員。官。好的。我以前的是AR48。"}, {"type": "subtitle", "time": 624.23, "timestamp": "00:10:24", "text": "哦，糟糕。不錯，[音樂] 對吧？小子，你最好小心一點。"}, {"type": "subtitle", "time": 648.63, "timestamp": "00:10:48", "text": "這些東西可不是我送的。哦，他在看電視劇什麼的。請問您能告訴"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "我您的微型火箭的情況嗎？  這是什麼？稍等片刻。  哦，他在重症監護室。"}]
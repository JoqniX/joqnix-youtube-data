[{"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "好嗎？嘿，嘿，嘿，嘿。  兄弟，"}, {"type": "subtitle", "time": 1693.35, "timestamp": "00:28:13", "text": "不敢相信。"}, {"type": "subtitle", "time": 1721.47, "timestamp": "00:28:41", "text": "？等等，等等，等等。我們在做什麼？拉屎。硬漢大殺四方。我得到它。有時候"}, {"type": "subtitle", "time": 1732.95, "timestamp": "00:28:52", "text": "你必須做出讓步"}, {"type": "subtitle", "time": 1737.43, "timestamp": "00:28:57", "text": "。是的，我殺了一隻"}]
[{"type": "subtitle", "time": 21490.628, "timestamp": "05:58:10", "text": "嗯，是的。既然如此，不如先去見見法官？他可能覺得這樣可以。跟你"}, {"type": "subtitle", "time": 21499.19, "timestamp": "05:58:19", "text": "一起去。  我和Shy會等你。  這是正確的。我們哪裡也不去。  如果"}, {"type": "subtitle", "time": 21505.67, "timestamp": "05:58:25", "text": "發生任何情況，請隨時與我們聯繫。等等，不對。我們聽不到你的聲音。此外"}, {"type": "subtitle", "time": 21518.03, "timestamp": "05:58:38", "text": "他們還有一條規定，禁止在市政廳內大聲喧嘩。  希望這能幫到你。"}, {"type": "subtitle", "time": 21524.628, "timestamp": "05:58:44", "text": "哦，我們"}, {"type": "subtitle", "time": 21539.83, "timestamp": "05:58:59", "text": "走吧。  過場動畫時間。所有人，做好衝擊準備。  哇，真漂亮。我以為那是包含。  好的，我們需要繼續深入"}]
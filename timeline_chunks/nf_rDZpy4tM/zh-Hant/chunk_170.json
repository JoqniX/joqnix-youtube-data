[{"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "所以，你的答案是什麼？你想買啊"}, {"type": "subtitle", "time": 10214.87, "timestamp": "02:50:14", "text": "？我的政策是不問我的客戶為什麼想要從我這裡購買那麼多的外國收入。我認為，關於人們如何處理這些外星"}, {"type": "subtitle", "time": 10217.349, "timestamp": "02:50:17", "text": "生物的問題，我問得越少越好。所以，你的答案是否定的？  真的有"}, {"type": "subtitle", "time": 10221.75, "timestamp": "02:50:21", "text": "外星人[ __ ]嗎？你這人怎麼回事？我知道這很噁心，"}, {"type": "subtitle", "time": 10223.67, "timestamp": "02:50:23", "text": "但冷靜點。  我叫史丹，我說各種各樣的外星人數量"}, {"type": "subtitle", "time": 10227.91, "timestamp": "02:50:27", "text": "多得可怕，"}, {"type": "subtitle", "time": 10231.349, "timestamp": "02:50:31", "text": "我們只能"}, {"type": "subtitle", "time": 10233.75, "timestamp": "02:50:33", "text": "一起接受這個事實。"}, {"type": "subtitle", "time": 10236.07, "timestamp": "02:50:36", "text": "現在"}, {"type": "subtitle", "time": 10249.99, "timestamp": "02:50:49", "text": "我簡直不敢相信我們正在做這件事，但還是讓一些人來吧。哇，看看你。你想嚐嚐外星人的[ __ ]嗎？很高興你感興趣"}]
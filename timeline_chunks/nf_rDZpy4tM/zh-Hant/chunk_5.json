[{"type": "subtitle", "time": 303.469, "timestamp": "00:05:03", "text": "昨天我們直播到…"}, {"type": "subtitle", "time": 305.909, "timestamp": "00:05:05", "text": "我們下次直播多久？我"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "忘了。所以昨天我們進行了"}, {"type": "subtitle", "time": 312.07, "timestamp": "00:05:12", "text": "直播，"}, {"type": "subtitle", "time": 315.59, "timestamp": "00:05:15", "text": "我記得我大概7點就結束了直播。然後我想我"}, {"type": "subtitle", "time": 318.629, "timestamp": "00:05:18", "text": "9點又開始了另一場直播。我本來應該"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "8點半開始直播，但我"}, {"type": "subtitle", "time": 325.27, "timestamp": "00:05:25", "text": "9點半或9點才開始。是的。是的。是的。昨天我們直播了"}, {"type": "subtitle", "time": 327.31, "timestamp": "00:05:27", "text": "香港篇，"}, {"type": "subtitle", "time": 330.43, "timestamp": "00:05:30", "text": "播到了"}, {"type": "subtitle", "time": 333.83, "timestamp": "00:05:33", "text": "第15章。今天直播到第16章。"}, {"type": "subtitle", "time": 335.99, "timestamp": "00:05:35", "text": "所以，在洪凱直播之後，"}, {"type": "subtitle", "time": 340.23, "timestamp": "00:05:40", "text": "我們今天也會直播"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "洪凱的節目。所以別"}, {"type": "subtitle", "time": 345.31, "timestamp": "00:05:45", "text": "擔心"}]
[{"type": "subtitle", "time": 19146.47, "timestamp": "05:19:06", "text": "一起來看看吧？甜美的嬰兒房。  但"}, {"type": "subtitle", "time": 19156.708, "timestamp": "05:19:16", "text": "我想要他。  我剛才提到的那個…我們需要把這裡發生的異常現象報告給市政廳。  我們離開吧。讓我們自己做。"}, {"type": "subtitle", "time": 19179.31, "timestamp": "05:19:39", "text": "[音樂] 好的。"}, {"type": "subtitle", "time": 19198.948, "timestamp": "05:19:58", "text": "那是什麼力量？"}]
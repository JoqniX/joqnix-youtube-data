[{"type": "subtitle", "time": 32608.51, "timestamp": "09:03:28", "text": "知道你有多"}, {"type": "subtitle", "time": 32620.308, "timestamp": "09:03:40", "text": "世界是殘酷的。  你是個活生生的人，但在許多人眼裡，你只是一枚"}, {"type": "subtitle", "time": 32623.59, "timestamp": "09:03:43", "text": "棋子。這就是我來這裡的原因，因為我把你視為摯友，我想告訴你真相。對於你即將面臨的一切，我深感抱歉。真相有時令人痛苦"}]
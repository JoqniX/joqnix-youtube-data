[{"type": "subtitle", "time": 5831.43, "timestamp": "01:37:11", "text": "這傢伙有電擊裝置"}, {"type": "subtitle", "time": 5834.39, "timestamp": "01:37:14", "text": "。這是什麼刀刃？  [音樂] 她"}, {"type": "subtitle", "time": 5839.109, "timestamp": "01:37:19", "text": "看到了這把沒有臉的"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "槍。好，我們開始吧。  好的。哦，這個人還活著。幸好你拿到了。好的"}, {"type": "subtitle", "time": 5856.47, "timestamp": "01:37:36", "text": "大塊頭是誰？"}, {"type": "subtitle", "time": 5877.35, "timestamp": "01:37:57", "text": "你剛剛獲得了權力。  幹得好，夥計。這是最後"}]
[{"type": "subtitle", "time": 20221.51, "timestamp": "05:37:01", "text": "天哪，敵人真多。  其中"}, {"type": "subtitle", "time": 20229.27, "timestamp": "05:37:09", "text": "一種聲音。我察覺到了你的弱點。  [音樂] 哦，如果你多次擊敗敵人，你實際上可以獲得"}, {"type": "subtitle", "time": 20234.15, "timestamp": "05:37:14", "text": "他們的迴聲共鳴時刻。  一是聲音。為什麼它們有免疫力？  讓我成為你的"}, {"type": "subtitle", "time": 20247.91, "timestamp": "05:37:27", "text": "利刃。哦，"}, {"type": "subtitle", "time": 20254.07, "timestamp": "05:37:34", "text": "你需要不同的元素之類的東西。哦，讓"}, {"type": "subtitle", "time": 20257.19, "timestamp": "05:37:37", "text": "狂風"}, {"type": "subtitle", "time": 20277.51, "timestamp": "05:37:57", "text": "。  毫不猶豫。  時刻已至。  我聽到好多"}, {"type": "subtitle", "time": 20279.43, "timestamp": "05:37:59", "text": "迴音。  讓我成為你的利刃。  我從中受益匪淺。"}]
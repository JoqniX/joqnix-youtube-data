[{"type": "subtitle", "time": 18794.868, "timestamp": "05:13:14", "text": "哦，那些刺耳不和諧音揮之不去的迴響。讓我打開盤古終端上的風扇組。"}, {"type": "subtitle", "time": 18825.11, "timestamp": "05:13:45", "text": "我這裡正在下"}, {"type": "subtitle", "time": 18827.27, "timestamp": "05:13:47", "text": "瓢潑大雨。我不知道你能不能聽到。我的降噪效果可能太好了，所以才會聽不到。但是，現在弗拉德的街道上正"}, {"type": "subtitle", "time": 18828.34, "timestamp": "05:13:48", "text": "下著傾盆大雨，就像是那種"}]
[{"type": "subtitle", "time": 25235.27, "timestamp": "07:00:35", "text": "前往諾福爾荒原，需要什麼樣的迴聲沼澤"}, {"type": "subtitle", "time": 25237.708, "timestamp": "07:00:37", "text": "通行證"}, {"type": "subtitle", "time": 25240.15, "timestamp": "07:00:40", "text": "？這位女士是誰？現在這是禁區。"}, {"type": "subtitle", "time": 25247.03, "timestamp": "07:00:47", "text": "哈莫斯。嗯，這位小姑娘，你是做什麼的？這是我上第三班了，你還在。"}]
[{"type": "subtitle", "time": 19886.39, "timestamp": "05:31:26", "text": "Oh, she's smiling now. Make your"}, {"type": "subtitle", "time": 19889.43, "timestamp": "05:31:29", "text": "acquaintance. I apologize for the delay."}, {"type": "subtitle", "time": 19891.91, "timestamp": "05:31:31", "text": "My name is Sanis, the bodyguard of"}, {"type": "subtitle", "time": 19895.23, "timestamp": "05:31:35", "text": "Madame Magistrate."}, {"type": "subtitle", "time": 19897.91, "timestamp": "05:31:37", "text": "Oh, royal for now. Hello. inform you"}, {"type": "subtitle", "time": 19899.708, "timestamp": "05:31:39", "text": "that Madame Magistrate is currently"}, {"type": "subtitle", "time": 19902.628, "timestamp": "05:31:42", "text": "away. Prior to her departure, she"}, {"type": "subtitle", "time": 19904.788, "timestamp": "05:31:44", "text": "instructed me to bring you these tokens"}, {"type": "subtitle", "time": 19907.67, "timestamp": "05:31:47", "text": "and a welcome gift."}, {"type": "subtitle", "time": 19911.03, "timestamp": "05:31:51", "text": "Ah, Madame Magistrate advise you to"}, {"type": "subtitle", "time": 19913.19, "timestamp": "05:31:53", "text": "explore what these tokens represent"}, {"type": "subtitle", "time": 19915.83, "timestamp": "05:31:55", "text": "during her absence. This may help you"}, {"type": "subtitle", "time": 19918.11, "timestamp": "05:31:58", "text": "acquire the information you desire"}]
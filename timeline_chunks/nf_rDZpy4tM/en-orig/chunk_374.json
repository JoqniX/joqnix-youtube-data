[{"type": "subtitle", "time": 22445.27, "timestamp": "06:14:05", "text": "H"}, {"type": "subtitle", "time": 22447.51, "timestamp": "06:14:07", "text": "I thought it was just a ring. And"}, {"type": "subtitle", "time": 22450.708, "timestamp": "06:14:10", "text": "resonance cords in your dreams are real."}, {"type": "subtitle", "time": 22452.788, "timestamp": "06:14:12", "text": "Possibly leading to the gorgees of"}, {"type": "subtitle", "time": 22456.15, "timestamp": "06:14:16", "text": "spirits and morph baronss. Perhaps it"}, {"type": "subtitle", "time": 22458.948, "timestamp": "06:14:18", "text": "was more than just a dream. More than"}, {"type": "subtitle", "time": 22461.35, "timestamp": "06:14:21", "text": "just a dream. That girl might be the key"}, {"type": "subtitle", "time": 22464.788, "timestamp": "06:14:24", "text": "to recovering your memories. Could be."}, {"type": "subtitle", "time": 22467.43, "timestamp": "06:14:27", "text": "information aside, it seems to me your"}, {"type": "subtitle", "time": 22470.39, "timestamp": "06:14:30", "text": "dream points toward the noral baronss."}, {"type": "subtitle", "time": 22472.628, "timestamp": "06:14:32", "text": "It's a site of the Throdian War and the"}, {"type": "subtitle", "time": 22475.75, "timestamp": "06:14:35", "text": "source of all TD outbreaks."}, {"type": "subtitle", "time": 22478.47, "timestamp": "06:14:38", "text": "Homo's frontline base is stationed there"}, {"type": "subtitle", "time": 22480.548, "timestamp": "06:14:40", "text": "as well. It's a no-go for me if you're"}, {"type": "subtitle", "time": 22483.27, "timestamp": "06:14:43", "text": "leaving the city. My shift's coming up."}, {"type": "subtitle", "time": 22485.35, "timestamp": "06:14:45", "text": "Protect Rover well and shoot me a"}, {"type": "subtitle", "time": 22487.0, "timestamp": "06:14:47", "text": "message if you need anything. All right,"}, {"type": "subtitle", "time": 22494.64, "timestamp": "06:14:54", "text": "Yingyang. Yang is safe with me."}, {"type": "subtitle", "time": 22495.788, "timestamp": "06:14:55", "text": "[Music]"}]
[{"type": "subtitle", "time": 30662.51, "timestamp": "08:31:02", "text": "Men"}, {"type": "subtitle", "time": 30666.868, "timestamp": "08:31:06", "text": "ro the shepherd's pursuit sparking"}, {"type": "subtitle", "time": 30675.43, "timestamp": "08:31:15", "text": "They could no longer ignore the blood"}, {"type": "subtitle", "time": 30679.27, "timestamp": "08:31:19", "text": "and ashes of past sacrifices. Littering"}, {"type": "subtitle", "time": 30688.23, "timestamp": "08:31:28", "text": "That's your evil being."}, {"type": "subtitle", "time": 30692.15, "timestamp": "08:31:32", "text": "How do you like my story, Rover?"}, {"type": "subtitle", "time": 30695.59, "timestamp": "08:31:35", "text": "But my mod keeps on making. Suppose you"}, {"type": "subtitle", "time": 30698.788, "timestamp": "08:31:38", "text": "already have it figured out."}, {"type": "subtitle", "time": 30701.388, "timestamp": "08:31:41", "text": "The black lamb who rebelled against the"}, {"type": "subtitle", "time": 30704.308, "timestamp": "08:31:44", "text": "rules. The white lambs who succumbed to"}, {"type": "subtitle", "time": 30707.23, "timestamp": "08:31:47", "text": "their greed. The innocent maiden"}, {"type": "subtitle", "time": 30710.15, "timestamp": "08:31:50", "text": "sacrificed. And the villagers who turned"}, {"type": "subtitle", "time": 30713.19, "timestamp": "08:31:53", "text": "on each other in a ruthless frenzy. They"}, {"type": "subtitle", "time": 30719.19, "timestamp": "08:31:59", "text": "coming. All the shepherd had to do was"}]
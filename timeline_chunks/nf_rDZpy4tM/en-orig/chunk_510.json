[{"type": "subtitle", "time": 30608.548, "timestamp": "08:30:08", "text": "Meanwhile, some lambs reasoned that"}, {"type": "subtitle", "time": 30610.468, "timestamp": "08:30:10", "text": "since they had already risked being"}, {"type": "subtitle", "time": 30613.59, "timestamp": "08:30:13", "text": "sacrificed for someone else's wish, it"}, {"type": "subtitle", "time": 30616.468, "timestamp": "08:30:16", "text": "was then only fair to pass on that risk"}, {"type": "subtitle", "time": 30619.23, "timestamp": "08:30:19", "text": "for a chance at fulfilling their own"}, {"type": "subtitle", "time": 30622.468, "timestamp": "08:30:22", "text": "desires. And so they continued to play"}, {"type": "subtitle", "time": 30625.59, "timestamp": "08:30:25", "text": "the game."}, {"type": "subtitle", "time": 30628.548, "timestamp": "08:30:28", "text": "They all knew the consequences, chose to"}, {"type": "subtitle", "time": 30635.67, "timestamp": "08:30:35", "text": "fearful yet greedy. Fearful yet greedy."}, {"type": "subtitle", "time": 30638.59, "timestamp": "08:30:38", "text": "Followed the shepherd's orders and made"}, {"type": "subtitle", "time": 30642.388, "timestamp": "08:30:42", "text": "wishes again and again. They could have"}, {"type": "subtitle", "time": 30647.15, "timestamp": "08:30:47", "text": "lamb. Oh my god. Hush. Black lamb spoke"}, {"type": "subtitle", "time": 30651.51, "timestamp": "08:30:51", "text": "up, shattering the flock's facade. their"}]
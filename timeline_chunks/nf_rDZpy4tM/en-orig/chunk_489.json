[{"type": "subtitle", "time": 29344.388, "timestamp": "08:09:04", "text": "Go back to me. Oi. Aw. So, you really"}, {"type": "subtitle", "time": 29347.75, "timestamp": "08:09:07", "text": "care about her? Don't worry. I don't"}, {"type": "subtitle", "time": 29350.388, "timestamp": "08:09:10", "text": "plan to make you hate me just yet. She"}, {"type": "subtitle", "time": 29353.35, "timestamp": "08:09:13", "text": "is safe now."}, {"type": "subtitle", "time": 29355.83, "timestamp": "08:09:15", "text": "Well, let's just enjoy our time together"}, {"type": "subtitle", "time": 29358.31, "timestamp": "08:09:18", "text": "for the moment. Forget about that. You"}, {"type": "subtitle", "time": 29361.99, "timestamp": "08:09:21", "text": "got him. Yeah, I did. You finished this"}, {"type": "subtitle", "time": 29368.548, "timestamp": "08:09:28", "text": "to begin with. I heard you've lost your"}, {"type": "subtitle", "time": 29370.548, "timestamp": "08:09:30", "text": "memories."}, {"type": "subtitle", "time": 29376.59, "timestamp": "08:09:36", "text": "So, it's"}, {"type": "subtitle", "time": 29379.67, "timestamp": "08:09:39", "text": "true. That makes sense given how fragile"}, {"type": "subtitle", "time": 29381.67, "timestamp": "08:09:41", "text": "you were when you woke up or I would"}, {"type": "subtitle", "time": 29383.11, "timestamp": "08:09:43", "text": "have questioned the authenticity of"}, {"type": "subtitle", "time": 29385.47, "timestamp": "08:09:45", "text": "those rumors."}, {"type": "subtitle", "time": 29387.75, "timestamp": "08:09:47", "text": "[Music]"}, {"type": "subtitle", "time": 29390.07, "timestamp": "08:09:50", "text": "You followed me."}, {"type": "subtitle", "time": 29395.19, "timestamp": "08:09:55", "text": "So, you noticed. Oh, I am flattered."}, {"type": "subtitle", "time": 29398.468, "timestamp": "08:09:58", "text": "stalker on edge. By now, you should have"}]
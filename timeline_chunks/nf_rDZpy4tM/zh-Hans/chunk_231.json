[{"type": "subtitle", "time": 13861.79, "timestamp": "03:51:01", "text": "好朋友和有毒的朋友"}, {"type": "subtitle", "time": 13864.79, "timestamp": "03:51:04", "text": "朋友们。是的。是的。所以那样我算是……"}, {"type": "subtitle", "time": 13866.51, "timestamp": "03:51:06", "text": "不得不放手"}, {"type": "subtitle", "time": 13869.309, "timestamp": "03:51:09", "text": "一些"}, {"type": "subtitle", "time": 13873.59, "timestamp": "03:51:13", "text": "法语。我甚至还得做阻挡工作。"}, {"type": "subtitle", "time": 13880.91, "timestamp": "03:51:20", "text": "东西。即使我们总是和好如初，"}, {"type": "subtitle", "time": 13885.03, "timestamp": "03:51:25", "text": "东西、化妆品，而我总是那个……"}, {"type": "subtitle", "time": 13887.269, "timestamp": "03:51:27", "text": "曾经化妆的人。不知道是否"}, {"type": "subtitle", "time": 13889.91, "timestamp": "03:51:29", "text": "他们不在乎也好，但确实如此。是的。东西"}, {"type": "subtitle", "time": 13891.309, "timestamp": "03:51:31", "text": "就是这样。"}, {"type": "subtitle", "time": 13894.389, "timestamp": "03:51:34", "text": "嗯，刷子刷子。是的。我的天哪，"}, {"type": "subtitle", "time": 13896.71, "timestamp": "03:51:36", "text": "这音乐让我彻底敞开了心扉。哦"}, {"type": "subtitle", "time": 13899.07, "timestamp": "03:51:39", "text": "我的上帝。我的天啊。这"}, {"type": "subtitle", "time": 13902.95, "timestamp": "03:51:42", "text": "音乐 为什么我觉得OST听起来这么……"}, {"type": "subtitle", "time": 13905.71, "timestamp": "03:51:45", "text": "哦，闭嘴。"}, {"type": "subtitle", "time": 13908.309, "timestamp": "03:51:48", "text": "饵。如果我要走了，那就怪音乐吧。"}, {"type": "subtitle", "time": 13915.59, "timestamp": "03:51:55", "text": "音乐。它正在玩牌。是的。"}, {"type": "subtitle", "time": 13917.67, "timestamp": "03:51:57", "text": "回忆往事。回忆"}, {"type": "subtitle", "time": 13919.55, "timestamp": "03:51:59", "text": "的"}]
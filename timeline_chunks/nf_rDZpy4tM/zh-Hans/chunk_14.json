[{"type": "subtitle", "time": 842.71, "timestamp": "00:14:02", "text": "脑子全乱了，都是从他们那儿捞出来的。这"}, {"type": "subtitle", "time": 844.11, "timestamp": "00:14:04", "text": "仅有的"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "他脑子里唯一能想到的念头，就是他脑海中唯一能想到的念头。"}, {"type": "subtitle", "time": 851.03, "timestamp": "00:14:11", "text": "此时仍然产生的要么"}, {"type": "subtitle", "time": 855.35, "timestamp": "00:14:15", "text": "隐约带有种族主义色彩或关于"}, {"type": "subtitle", "time": 875.75, "timestamp": "00:14:35", "text": "[音乐]"}, {"type": "subtitle", "time": 877.07, "timestamp": "00:14:37", "text": "哦，"}, {"type": "subtitle", "time": 888.75, "timestamp": "00:14:48", "text": "宝贝。我的天哪。他们正在向……射击"}, {"type": "subtitle", "time": 892.31, "timestamp": "00:14:52", "text": "我。那是什么？"}, {"type": "subtitle", "time": 894.59, "timestamp": "00:14:54", "text": "看看他"}, {"type": "subtitle", "time": 897.99, "timestamp": "00:14:57", "text": "飞行。哇。哇。我需要坚持住。"}]
[{"type": "subtitle", "time": 7861.03, "timestamp": "02:11:01", "text": "你杀了库比斯，对吧？我不能"}, {"type": "subtitle", "time": 7864.629, "timestamp": "02:11:04", "text": "你们这些笨蛋居然看穿了我的心思。哦，我的"}, {"type": "subtitle", "time": 7871.35, "timestamp": "02:11:11", "text": "进入混乱模式。"}, {"type": "subtitle", "time": 7879.189, "timestamp": "02:11:19", "text": "也许你是在跟他的鞋子较劲。"}, {"type": "subtitle", "time": 7887.669, "timestamp": "02:11:27", "text": "所以呢？你的工作既是培训，也是"}, {"type": "subtitle", "time": 7903.229, "timestamp": "02:11:43", "text": "少量？他们是"}, {"type": "subtitle", "time": 7907.03, "timestamp": "02:11:47", "text": "还是那么蠢。现在，在我身边，我是"}]
[{"type": "subtitle", "time": 423.189, "timestamp": "00:07:03", "text": "我总是忘记。我需要重置两者。"}, {"type": "subtitle", "time": 425.23, "timestamp": "00:07:05", "text": "我的声音"}, {"type": "subtitle", "time": 431.11, "timestamp": "00:07:11", "text": "啊，我需要重置我的所有语音。"}, {"type": "subtitle", "time": 436.589, "timestamp": "00:07:16", "text": "好的。哦，"}, {"type": "subtitle", "time": 446.67, "timestamp": "00:07:26", "text": "那。糟糕。我的天哪。我"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "忘了。我应该把这个路由转接出去。"}, {"type": "subtitle", "time": 451.99, "timestamp": "00:07:31", "text": "背景音乐对了，所以我不需要"}, {"type": "subtitle", "time": 464.51, "timestamp": "00:07:44", "text": "时间"}, {"type": "subtitle", "time": 467.189, "timestamp": "00:07:47", "text": "就是这样，我不会听的。"}, {"type": "subtitle", "time": 470.67, "timestamp": "00:07:50", "text": "但你们都会听到的。"}, {"type": "subtitle", "time": 475.71, "timestamp": "00:07:55", "text": "是的，你好，你好吗？你好吗？"}, {"type": "subtitle", "time": 477.629, "timestamp": "00:07:57", "text": "今天小姐"}]
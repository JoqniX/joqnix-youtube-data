[{"type": "subtitle", "time": 10803.429, "timestamp": "03:00:03", "text": "经过。这对我意义重大。"}, {"type": "subtitle", "time": 10807.19, "timestamp": "03:00:07", "text": "感谢您也发表了您的看法。"}, {"type": "subtitle", "time": 10811.51, "timestamp": "03:00:11", "text": "也请接受你的点赞。"}, {"type": "subtitle", "time": 10814.55, "timestamp": "03:00:14", "text": "我无法详细阐述这一点。"}, {"type": "subtitle", "time": 10818.389, "timestamp": "03:00:18", "text": "正确地用声音说“呃”，关于"}, {"type": "subtitle", "time": 10822.83, "timestamp": "03:00:22", "text": "阿丹提出的问题，谢谢"}, {"type": "subtitle", "time": 10826.23, "timestamp": "03:00:26", "text": "兄弟，我需要用声音表达，我不知道"}, {"type": "subtitle", "time": 10829.59, "timestamp": "03:00:29", "text": "为什么我需要一个更好的，嗯，就是这个。"}, {"type": "subtitle", "time": 10832.79, "timestamp": "03:00:32", "text": "我注意到的一些缺陷，我需要改进。"}, {"type": "subtitle", "time": 10834.95, "timestamp": "03:00:34", "text": "是的。是的。能够发声"}, {"type": "subtitle", "time": 10837.389, "timestamp": "03:00:37", "text": "给某人解释一下事情"}, {"type": "subtitle", "time": 10840.19, "timestamp": "03:00:40", "text": "别的。"}, {"type": "subtitle", "time": 10842.51, "timestamp": "03:00:42", "text": "是的。我得去做我的事"}, {"type": "subtitle", "time": 10848.31, "timestamp": "03:00:48", "text": "说。"}, {"type": "subtitle", "time": 10853.389, "timestamp": "03:00:53", "text": "感同身受。但"}, {"type": "subtitle", "time": 10856.99, "timestamp": "03:00:56", "text": "是的，让我们尽力而为。"}]
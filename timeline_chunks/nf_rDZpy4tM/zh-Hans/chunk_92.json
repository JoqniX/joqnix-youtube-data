[{"type": "subtitle", "time": 5521.59, "timestamp": "01:32:01", "text": "他们中的一些人是，我，是的。"}, {"type": "subtitle", "time": 5523.669, "timestamp": "01:32:03", "text": "是啊是啊"}, {"type": "subtitle", "time": 5525.75, "timestamp": "01:32:05", "text": "我了解不多，但根据我所知道的……"}, {"type": "subtitle", "time": 5528.39, "timestamp": "01:32:08", "text": "我可以说说我所看到的，没错"}, {"type": "subtitle", "time": 5530.35, "timestamp": "01:32:10", "text": "现在就像首秀一样"}, {"type": "subtitle", "time": 5532.79, "timestamp": "01:32:12", "text": "星空所要展现的一切"}, {"type": "subtitle", "time": 5534.83, "timestamp": "01:32:14", "text": "他们是"}, {"type": "subtitle", "time": 5538.75, "timestamp": "01:32:18", "text": "他们正试图合并"}, {"type": "subtitle", "time": 5542.189, "timestamp": "01:32:22", "text": "管状物和角色扮演"}, {"type": "subtitle", "time": 5547.59, "timestamp": "01:32:27", "text": "汇入某物之下的某物"}, {"type": "subtitle", "time": 5549.83, "timestamp": "01:32:29", "text": "被称为星空景观，它们是"}, {"type": "subtitle", "time": 5552.709, "timestamp": "01:32:32", "text": "推广它，以便"}, {"type": "subtitle", "time": 5556.07, "timestamp": "01:32:36", "text": "呃，宣传它，这样就是这样……"}, {"type": "subtitle", "time": 5559.27, "timestamp": "01:32:39", "text": "方式，或者说这是方式，就像这样"}, {"type": "subtitle", "time": 5561.47, "timestamp": "01:32:41", "text": "这就是印度的方式"}, {"type": "subtitle", "time": 5565.79, "timestamp": "01:32:45", "text": "将会了解管道及其"}, {"type": "subtitle", "time": 5575.75, "timestamp": "01:32:55", "text": "就像我一样，珍有她自己的法则"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "一切都对吧？他们扮演"}, {"type": "subtitle", "time": 5579.47, "timestamp": "01:32:59", "text": "因为他们又是角色扮演者，"}]
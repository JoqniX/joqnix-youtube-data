[{"type": "subtitle", "time": 10200.23, "timestamp": "02:50:00", "text": "边吃边来回移动"}, {"type": "subtitle", "time": 10202.07, "timestamp": "02:50:02", "text": "来了，他把外星坏蛋们轰飞了。"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "脸。这很棒。兄弟，你运气真好。"}, {"type": "subtitle", "time": 10206.87, "timestamp": "02:50:06", "text": "你甚至可以和我们一起住在这里。我"}, {"type": "subtitle", "time": 10209.59, "timestamp": "02:50:09", "text": "我才不在乎你那套狗屁逻辑。我是"}, {"type": "subtitle", "time": 10211.429, "timestamp": "02:50:11", "text": "我只是说你根本不了解这个人。"}, {"type": "subtitle", "time": 10212.87, "timestamp": "02:50:12", "text": "你确定你真的对他有感觉吗？"}, {"type": "subtitle", "time": 10214.87, "timestamp": "02:50:14", "text": "他？大多数外星人只和同类交配。"}, {"type": "subtitle", "time": 10217.349, "timestamp": "02:50:17", "text": "物种。那你呢？你只是"}, {"type": "subtitle", "time": 10219.59, "timestamp": "02:50:19", "text": "你说你基本上和……睡过"}, {"type": "subtitle", "time": 10221.75, "timestamp": "02:50:21", "text": "整个银河系的一切。是的，"}, {"type": "subtitle", "time": 10223.67, "timestamp": "02:50:23", "text": "但我已经是个过气的堕落之人了。你已经"}, {"type": "subtitle", "time": 10225.19, "timestamp": "02:50:25", "text": "你的人生才刚刚开始。那是"}, {"type": "subtitle", "time": 10227.91, "timestamp": "02:50:27", "text": "与其说是甜蜜，不如说是居高临下。"}, {"type": "subtitle", "time": 10231.349, "timestamp": "02:50:31", "text": "什么？不。听着，我们已经花了所有这些时间"}, {"type": "subtitle", "time": 10233.75, "timestamp": "02:50:33", "text": "共同生活的时间。我关心你"}, {"type": "subtitle", "time": 10236.07, "timestamp": "02:50:36", "text": "现在是莱斯利。真是见鬼了。我的名字是"}, {"type": "subtitle", "time": 10238.389, "timestamp": "02:50:38", "text": "莉齐。来吧，告诉她我很关心她。"}, {"type": "subtitle", "time": 10244.309, "timestamp": "02:50:44", "text": "呃，"}, {"type": "subtitle", "time": 10247.349, "timestamp": "02:50:47", "text": "打扰一下。不，"}, {"type": "subtitle", "time": 10249.99, "timestamp": "02:50:49", "text": "但我绝不会就此罢休。"}, {"type": "subtitle", "time": 10253.429, "timestamp": "02:50:53", "text": "堕落的家伙给我上了一堂人生抉择课。"}, {"type": "subtitle", "time": 10255.269, "timestamp": "02:50:55", "text": "我是一个一无是处的堕落之人，这本身就是一个事实。"}, {"type": "subtitle", "time": 10256.87, "timestamp": "02:50:56", "text": "你为什么应该让我来教你？"}, {"type": "subtitle", "time": 10259.19, "timestamp": "02:50:59", "text": "关于人生抉择。我比任何人都清楚这一点"}]
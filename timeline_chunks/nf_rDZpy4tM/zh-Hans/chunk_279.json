[{"type": "subtitle", "time": 16741.709, "timestamp": "04:39:01", "text": "嗯？我"}, {"type": "subtitle", "time": 16743.46, "timestamp": "04:39:03", "text": "知道什么是"}, {"type": "subtitle", "time": 16752.189, "timestamp": "04:39:12", "text": "[音乐]"}, {"type": "subtitle", "time": 16755.67, "timestamp": "04:39:15", "text": "正在发生。你们都很好。它似乎。"}, {"type": "subtitle", "time": 16758.869, "timestamp": "04:39:18", "text": "是的，她精力充沛，而且"}, {"type": "subtitle", "time": 16761.91, "timestamp": "04:39:21", "text": "超级大团队。她为什么这么可爱"}, {"type": "subtitle", "time": 16763.429, "timestamp": "04:39:23", "text": "我？"}, {"type": "subtitle", "time": 16764.949, "timestamp": "04:39:24", "text": "我一直在关注她。"}, {"type": "subtitle", "time": 16767.51, "timestamp": "04:39:27", "text": "通过溪流的条件。"}, {"type": "subtitle", "time": 16780.19, "timestamp": "04:39:40", "text": "Baja 只关心你"}, {"type": "subtitle", "time": 16782.55, "timestamp": "04:39:42", "text": "健康）状况。她肯定认为我们不应该"}, {"type": "subtitle", "time": 16784.948, "timestamp": "04:39:44", "text": "允许你如此自由地活动"}, {"type": "subtitle", "time": 16788.27, "timestamp": "04:39:48", "text": "因为他刚刚恢复意识。"}, {"type": "subtitle", "time": 16790.27, "timestamp": "04:39:50", "text": "啊，"}, {"type": "subtitle", "time": 16794.75, "timestamp": "04:39:54", "text": "好的。她为什么看起来像个五岁小孩？"}, {"type": "subtitle", "time": 16797.75, "timestamp": "04:39:57", "text": "星星？我没事。"}]
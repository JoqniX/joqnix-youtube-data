[{"type": "subtitle", "time": 15721.429, "timestamp": "04:22:01", "text": "创伤性呼吸。让我上我的"}, {"type": "subtitle", "time": 15724.92, "timestamp": "04:22:04", "text": "电话。这太痛苦了。"}, {"type": "subtitle", "time": 15733.349, "timestamp": "04:22:13", "text": "你醒了。你好。让我看看。谁是"}, {"type": "subtitle", "time": 15735.99, "timestamp": "04:22:15", "text": "这？这两个人是谁？或者"}, {"type": "subtitle", "time": 15738.79, "timestamp": "04:22:18", "text": "我得使出最后一招了。"}, {"type": "subtitle", "time": 15742.11, "timestamp": "04:22:22", "text": "初级巡逻员的应急技能。"}, {"type": "subtitle", "time": 15745.51, "timestamp": "04:22:25", "text": "心肺复苏术。心肺复苏术。"}, {"type": "subtitle", "time": 15748.71, "timestamp": "04:22:28", "text": "[音乐]"}, {"type": "subtitle", "time": 15752.309, "timestamp": "04:22:32", "text": "从未在任何活人身上这样做过。"}, {"type": "subtitle", "time": 15755.429, "timestamp": "04:22:35", "text": "杰西娅，对不起。对不起。你刚醒"}, {"type": "subtitle", "time": 15758.429, "timestamp": "04:22:38", "text": "而我现在正在和一个……聊天"}, {"type": "subtitle", "time": 15762.389, "timestamp": "04:22:42", "text": "风暴。哔哔。"}, {"type": "subtitle", "time": 15768.07, "timestamp": "04:22:48", "text": "你还好吗？我的天啊。舒适。"}, {"type": "subtitle", "time": 15770.63, "timestamp": "04:22:50", "text": "你感觉不舒服吗？哦，我们走吧。你"}, {"type": "subtitle", "time": 15773.429, "timestamp": "04:22:53", "text": "是。你可以叫我奇莎。赤煞。"}, {"type": "subtitle", "time": 15776.63, "timestamp": "04:22:56", "text": "他是杨。杨。你好，阳阳。你好，"}]
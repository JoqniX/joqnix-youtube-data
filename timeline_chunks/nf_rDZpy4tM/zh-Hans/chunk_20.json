[{"type": "subtitle", "time": 1203.909, "timestamp": "00:20:03", "text": "我跟你说件事。这个地方是"}, {"type": "subtitle", "time": 1206.549, "timestamp": "00:20:06", "text": "简直是人间地狱。但你知道吗？"}, {"type": "subtitle", "time": 1209.31, "timestamp": "00:20:09", "text": "一旦我们到达城市，哦"}, {"type": "subtitle", "time": 1212.07, "timestamp": "00:20:12", "text": "天哪，这里还是人间地狱。但地狱也很多。"}, {"type": "subtitle", "time": 1213.909, "timestamp": "00:20:13", "text": "有其他人在身边更有趣。拿"}, {"type": "subtitle", "time": 1216.23, "timestamp": "00:20:16", "text": "这是我给你的。你一定会喜欢的。"}, {"type": "subtitle", "time": 1219.669, "timestamp": "00:20:19", "text": "人们总是这么说。相信我。"}, {"type": "subtitle", "time": 1224.95, "timestamp": "00:20:24", "text": "我害怕吗？"}, {"type": "subtitle", "time": 1239.99, "timestamp": "00:20:39", "text": "离开。我需要你留下来。"}, {"type": "subtitle", "time": 1254.07, "timestamp": "00:20:54", "text": "好的，明白了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 1257.029, "timestamp": "00:20:57", "text": "快到了。"}, {"type": "subtitle", "time": 1259.27, "timestamp": "00:20:59", "text": "儿子，我真为你感到骄傲。你看起来"}]
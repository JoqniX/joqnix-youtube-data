[{"type": "subtitle", "time": 16800.15, "timestamp": "04:40:00", "text": "这里不是说话的地方。我们开始吧"}, {"type": "subtitle", "time": 16818.75, "timestamp": "04:40:18", "text": "类型。哦"}, {"type": "subtitle", "time": 16822.03, "timestamp": "04:40:22", "text": "不，奇怪的事情是"}, {"type": "subtitle", "time": 16833.59, "timestamp": "04:40:33", "text": "哇，哇，哇，哇，哇，哇。抓住"}, {"type": "subtitle", "time": 16841.59, "timestamp": "04:40:41", "text": "惊人的。嘿，多久了？等等，我要走了"}, {"type": "subtitle", "time": 16848.03, "timestamp": "04:40:48", "text": "哈洛尼亚。哦，我的"}, {"type": "subtitle", "time": 16851.83, "timestamp": "04:40:51", "text": "上帝。打扰一下。"}]
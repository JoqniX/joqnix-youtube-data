[{"type": "subtitle", "time": 13382.269, "timestamp": "03:43:02", "text": "上帝。是的。即使对我来说，这也不是……"}, {"type": "subtitle", "time": 13390.07, "timestamp": "03:43:10", "text": "某种程度上，我希望它开始。"}, {"type": "subtitle", "time": 13391.309, "timestamp": "03:43:11", "text": "出去"}, {"type": "subtitle", "time": 13395.189, "timestamp": "03:43:15", "text": "向家人展示我想做什么"}, {"type": "subtitle", "time": 13398.95, "timestamp": "03:43:18", "text": "以及我引以为豪的，或者我喜欢的是什么"}, {"type": "subtitle", "time": 13401.51, "timestamp": "03:43:21", "text": "我喜欢的是什么，是的，我"}, {"type": "subtitle", "time": 13405.79, "timestamp": "03:43:25", "text": "我喜欢摆弄我的东西。"}, {"type": "subtitle", "time": 13409.63, "timestamp": "03:43:29", "text": "是的。但这还不够。"}, {"type": "subtitle", "time": 13413.189, "timestamp": "03:43:33", "text": "知道。是的。这还不够。"}, {"type": "subtitle", "time": 13415.07, "timestamp": "03:43:35", "text": "你必须保留"}, {"type": "subtitle", "time": 13418.309, "timestamp": "03:43:38", "text": "尽你所能，这样人们才能"}, {"type": "subtitle", "time": 13421.03, "timestamp": "03:43:41", "text": "承认并承认"}, {"type": "chat", "time": 13423.013, "timestamp": "03:43:43", "author": "@ArekuVT", "avatar": "https://yt4.ggpht.com/pqSduyGeea3diiqImLaqfTDN6g8f9g3gvrMGmIFqiGTP6ktehIf_rNzOg3vog72mKxfC-qSiBWQ=s64-c-k-c0x00ffffff-no-rj", "message": "everyone eep well now "}, {"type": "subtitle", "time": 13427.63, "timestamp": "03:43:47", "text": "你那些关于存在主义的思考。像这样表演。"}, {"type": "chat", "time": 13430.397, "timestamp": "03:43:50", "author": "@ArekuVT", "avatar": "https://yt4.ggpht.com/pqSduyGeea3diiqImLaqfTDN6g8f9g3gvrMGmIFqiGTP6ktehIf_rNzOg3vog72mKxfC-qSiBWQ=s64-c-k-c0x00ffffff-no-rj", "message": "and thanks again for raiding with me ww"}, {"type": "subtitle", "time": 13430.55, "timestamp": "03:43:50", "text": "毫米。阅读相关消息。你会得到"}, {"type": "subtitle", "time": 13432.67, "timestamp": "03:43:52", "text": "是的。是的。我读过了。我确实读过"}, {"type": "subtitle", "time": 13435.429, "timestamp": "03:43:55", "text": "它。沃尔特·怀特，但却是个恶霸。我是"}, {"type": "subtitle", "time": 13436.67, "timestamp": "03:43:56", "text": "一个人"}, {"type": "subtitle", "time": 13439.03, "timestamp": "03:43:59", "text": "欺凌者。最后一个问题。你好。去"}]
[{"type": "subtitle", "time": 3601.67, "timestamp": "01:00:01", "text": "玩得开心！我们走吧。是的。"}, {"type": "subtitle", "time": 3603.51, "timestamp": "01:00:03", "text": "从这个角度来看。这不是地方吗？"}, {"type": "subtitle", "time": 3606.23, "timestamp": "01:00:06", "text": "伟大的？整座城市悬在……之下"}, {"type": "subtitle", "time": 3608.549, "timestamp": "01:00:08", "text": "小行星。你真的可以侥幸逃脱惩罚"}, {"type": "subtitle", "time": 3610.71, "timestamp": "01:00:10", "text": "这里犯罪率很高。瑜伽大师，你来玩"}, {"type": "subtitle", "time": 3612.95, "timestamp": "01:00:12", "text": "游戏王。"}, {"type": "subtitle", "time": 3615.67, "timestamp": "01:00:15", "text": "孩子，过去那边去。我来自一个"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "一个名为“母亲们”的可爱小组织"}, {"type": "subtitle", "time": 3620.39, "timestamp": "01:00:20", "text": "你即将进入暴力世界"}, {"type": "subtitle", "time": 3622.87, "timestamp": "01:00:22", "text": "这是我们管辖范围内的一个行业。那是"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "正确的。有“母亲反对暴力”组织，"}, {"type": "subtitle", "time": 3627.91, "timestamp": "01:00:27", "text": "然后还有我们，母亲们"}, {"type": "subtitle", "time": 3630.23, "timestamp": "01:00:30", "text": "暴力。我们有点不一样。我们"}, {"type": "subtitle", "time": 3632.47, "timestamp": "01:00:32", "text": "我们热爱暴力，而且我们想要更多。"}, {"type": "subtitle", "time": 3635.51, "timestamp": "01:00:35", "text": "到处。哇。"}, {"type": "subtitle", "time": 3637.27, "timestamp": "01:00:37", "text": "更多男孩等着牛仔去追捕"}, {"type": "subtitle", "time": 3641.03, "timestamp": "01:00:41", "text": "好伙伴。所以我们可以休息一下。"}, {"type": "subtitle", "time": 3644.71, "timestamp": "01:00:44", "text": "是的，我有。我是个织发迷。"}, {"type": "subtitle", "time": 3653.43, "timestamp": "01:00:53", "text": "看来G3遇到了一些问题。"}]
[{"type": "subtitle", "time": 12480.07, "timestamp": "03:28:00", "text": "我们也见过一些意外"}, {"type": "subtitle", "time": 12482.67, "timestamp": "03:28:02", "text": "或者故意或意外地打破了"}, {"type": "subtitle", "time": 12486.99, "timestamp": "03:28:06", "text": "规则，你知道它们会被移除。"}, {"type": "subtitle", "time": 12489.67, "timestamp": "03:28:09", "text": "对了，别忘了企业 YouTube 频道"}, {"type": "subtitle", "time": 12493.309, "timestamp": "03:28:13", "text": "等于你不会拥有那么多"}, {"type": "subtitle", "time": 12496.07, "timestamp": "03:28:16", "text": "自由意味着你可以自由地做出决定。"}, {"type": "subtitle", "time": 12499.03, "timestamp": "03:28:19", "text": "任何内容"}, {"type": "subtitle", "time": 12501.349, "timestamp": "03:28:21", "text": "呃，任何你想要的颜色，但你有"}, {"type": "subtitle", "time": 12504.63, "timestamp": "03:28:24", "text": "向上级询问这样做是否可以。"}, {"type": "subtitle", "time": 12507.349, "timestamp": "03:28:27", "text": "他们说，那样你就不能了。"}, {"type": "subtitle", "time": 12510.87, "timestamp": "03:28:30", "text": "照那样做。有些情况就是这样。"}, {"type": "subtitle", "time": 12512.79, "timestamp": "03:28:32", "text": "你因为某些原因必须离开。所以"}, {"type": "subtitle", "time": 12515.269, "timestamp": "03:28:35", "text": "他们会放你走的，对吧？他们会"}, {"type": "subtitle", "time": 12517.75, "timestamp": "03:28:37", "text": "让你读，但有些呃呃"}, {"type": "subtitle", "time": 12520.389, "timestamp": "03:28:40", "text": "协议意味着我没有提及此事。"}, {"type": "subtitle", "time": 12522.03, "timestamp": "03:28:42", "text": "当我谈到这件事时"}, {"type": "subtitle", "time": 12525.75, "timestamp": "03:28:45", "text": "更早。如果一家公司给你他们的"}, {"type": "subtitle", "time": 12530.469, "timestamp": "03:28:50", "text": "素材，包括叠加层、模型、音乐等。"}, {"type": "subtitle", "time": 12532.95, "timestamp": "03:28:52", "text": "呃，卡拉OK伴奏之类的，也就是纯音乐。"}, {"type": "subtitle", "time": 12534.87, "timestamp": "03:28:54", "text": "唱歌方面，如果你是一名歌手，他们"}, {"type": "subtitle", "time": 12537.11, "timestamp": "03:28:57", "text": "给你卡拉OK伴奏带，对吧？喜欢"}, {"type": "subtitle", "time": 12538.95, "timestamp": "03:28:58", "text": "流行歌曲的器乐版或"}]
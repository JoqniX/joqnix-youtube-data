[{"type": "subtitle", "time": 15241.11, "timestamp": "04:14:01", "text": "你好吗？你玩得怎么样？我 我"}, {"type": "subtitle", "time": 15243.83, "timestamp": "04:14:03", "text": "有点像，你知道的，像那种VIP人物"}, {"type": "subtitle", "time": 15246.55, "timestamp": "04:14:06", "text": "这里。 VIP人物。保姆。伙计们，看！"}, {"type": "subtitle", "time": 15250.55, "timestamp": "04:14:10", "text": "我们收到绿色信号。我的天啊。哦是"}, {"type": "subtitle", "time": 15253.83, "timestamp": "04:14:13", "text": "给印度人民带来绿色环保。什么？"}, {"type": "subtitle", "time": 15257.03, "timestamp": "04:14:17", "text": "78. 你看到了吗？你看到了吗？你看"}, {"type": "subtitle", "time": 15258.87, "timestamp": "04:14:18", "text": "那？绿色提示音。我告诉你了。你看"}, {"type": "subtitle", "time": 15263.189, "timestamp": "04:14:23", "text": "那？它是绿色的提示音。还有像"}, {"type": "subtitle", "time": 15265.59, "timestamp": "04:14:25", "text": "我们要去亚洲。是的。你不需要"}, {"type": "subtitle", "time": 15267.75, "timestamp": "04:14:27", "text": "去亚洲。"}, {"type": "subtitle", "time": 15269.99, "timestamp": "04:14:29", "text": "选择SCA。"}, {"type": "subtitle", "time": 15273.11, "timestamp": "04:14:33", "text": "我的天啊。你有一辆车。你还没有"}, {"type": "subtitle", "time": 15280.71, "timestamp": "04:14:40", "text": "好的，我也有绿色的。我知道，"}, {"type": "subtitle", "time": 15282.87, "timestamp": "04:14:42", "text": "正确的？"}, {"type": "subtitle", "time": 15285.03, "timestamp": "04:14:45", "text": "可能是因为像Seros这样的公司很忙。"}, {"type": "subtitle", "time": 15288.389, "timestamp": "04:14:48", "text": "所以他们可能很忙之类的。这就是我的原因"}, {"type": "subtitle", "time": 15292.51, "timestamp": "04:14:52", "text": "没有杀死兔子。他刚刚……"}, {"type": "subtitle", "time": 15297.349, "timestamp": "04:14:57", "text": "被牺牲了。没关系。我会尽力。"}, {"type": "subtitle", "time": 15299.67, "timestamp": "04:14:59", "text": "我换了账号之类的。"}]
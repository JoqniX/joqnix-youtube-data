[{"type": "subtitle", "time": 4081.43, "timestamp": "01:08:01", "text": "你的G3脸部在这上面会成为一块碎片"}, {"type": "subtitle", "time": 4101.269, "timestamp": "01:08:21", "text": "我杀了我们的队友。后来，母亲。"}, {"type": "subtitle", "time": 4107.789, "timestamp": "01:08:27", "text": "[掌声]"}, {"type": "subtitle", "time": 4110.87, "timestamp": "01:08:30", "text": "手榴弹。手榴弹，手榴弹。来了"}, {"type": "subtitle", "time": 4121.43, "timestamp": "01:08:41", "text": "你在向我开枪。"}]
[{"type": "subtitle", "time": 1861.43, "timestamp": "00:31:01", "text": "德拉格镇是一座新兴城镇。老城区有"}, {"type": "subtitle", "time": 1863.83, "timestamp": "00:31:03", "text": "心。曾用于服务于实际目的"}, {"type": "subtitle", "time": 1866.63, "timestamp": "00:31:06", "text": "人民。 Drag Town 简直就是一个坑"}, {"type": "subtitle", "time": 1870.789, "timestamp": "00:31:10", "text": "放荡不羁和毒品。 Consan G3"}, {"type": "subtitle", "time": 1876.71, "timestamp": "00:31:16", "text": "德雷在哪儿？入口在哪里？"}, {"type": "subtitle", "time": 1879.75, "timestamp": "00:31:19", "text": "德雷克镇？哦，那很简单。你只需走"}, {"type": "subtitle", "time": 1881.35, "timestamp": "00:31:21", "text": "穿过这道门，就进入老城区了。"}, {"type": "subtitle", "time": 1883.59, "timestamp": "00:31:23", "text": "然后沿着主干道径直飞去。"}, {"type": "subtitle", "time": 1885.59, "timestamp": "00:31:25", "text": "你绝对不会错过德雷克镇。"}, {"type": "subtitle", "time": 1888.31, "timestamp": "00:31:28", "text": "入口。真是丑得要命。"}, {"type": "subtitle", "time": 1890.389, "timestamp": "00:31:30", "text": "希望他们能把它除掉。我将打开"}, {"type": "subtitle", "time": 1892.71, "timestamp": "00:31:32", "text": "为你准备的大门。"}, {"type": "subtitle", "time": 1894.63, "timestamp": "00:31:34", "text": "嘿，格伦迪。接受治疗。双关语"}, {"type": "subtitle", "time": 1897.669, "timestamp": "00:31:37", "text": "故意的。没关系，布兰迪。和"}, {"type": "subtitle", "time": 1901.11, "timestamp": "00:31:41", "text": "当然，这直接与我的整个工作背道而驰。"}, {"type": "subtitle", "time": 1903.99, "timestamp": "00:31:43", "text": "这就是我来这里的原因。我很乐意这样做。"}, {"type": "subtitle", "time": 1906.31, "timestamp": "00:31:46", "text": "对于一些平静而年轻的垃圾来说，比如"}, {"type": "subtitle", "time": 1910.95, "timestamp": "00:31:50", "text": "你。你漏掉了什么地方吗？"}, {"type": "subtitle", "time": 1913.509, "timestamp": "00:31:53", "text": "最小的那个在里面玩得很开心。哇哦！"}, {"type": "subtitle", "time": 1915.909, "timestamp": "00:31:55", "text": "昨晚的派对太疯狂了。你……"}, {"type": "subtitle", "time": 1918.23, "timestamp": "00:31:58", "text": "你看看道格拉斯喝得有多醉？当然。"}]
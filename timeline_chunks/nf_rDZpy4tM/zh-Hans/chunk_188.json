[{"type": "subtitle", "time": 11282.429, "timestamp": "03:08:02", "text": "有可能，但我也不确定。所以在"}, {"type": "subtitle", "time": 11285.95, "timestamp": "03:08:05", "text": "早上好，我收到了一条私信。"}, {"type": "subtitle", "time": 11289.55, "timestamp": "03:08:09", "text": "乔克说你在霍尔。"}, {"type": "subtitle", "time": 11292.67, "timestamp": "03:08:12", "text": "什么？乔克，你入选了"}, {"type": "subtitle", "time": 11297.19, "timestamp": "03:08:17", "text": "霍尔，你在霍尔宝贝什么？我当时就想，"}, {"type": "subtitle", "time": 11300.469, "timestamp": "03:08:20", "text": "“啊？什么？”然后我看了全息影像。"}, {"type": "subtitle", "time": 11302.469, "timestamp": "03:08:22", "text": "明星"}, {"type": "subtitle", "time": 11305.39, "timestamp": "03:08:25", "text": "嗯，全息星星之类的东西，还有我"}, {"type": "subtitle", "time": 11307.63, "timestamp": "03:08:27", "text": "[音乐]"}, {"type": "subtitle", "time": 11311.19, "timestamp": "03:08:31", "text": "我看到我看到了某种东西，某种程度上，我"}, {"type": "subtitle", "time": 11314.32, "timestamp": "03:08:34", "text": "我很高兴，但某种程度上我也……"}, {"type": "subtitle", "time": 11315.95, "timestamp": "03:08:35", "text": "[音乐]"}, {"type": "subtitle", "time": 11318.19, "timestamp": "03:08:38", "text": "就像我不这样"}, {"type": "subtitle", "time": 11321.71, "timestamp": "03:08:41", "text": "我知道，我崩溃了，泪流满面。"}, {"type": "subtitle", "time": 11325.83, "timestamp": "03:08:45", "text": "猜测。我不知道。我真是个……"}, {"type": "subtitle", "time": 11327.79, "timestamp": "03:08:47", "text": "如此敏感"}, {"type": "subtitle", "time": 11334.67, "timestamp": "03:08:54", "text": "爱哭鬼是"}, {"type": "subtitle", "time": 11336.95, "timestamp": "03:08:56", "text": "如果你不知道全息星战，那就点个赞吧。"}]
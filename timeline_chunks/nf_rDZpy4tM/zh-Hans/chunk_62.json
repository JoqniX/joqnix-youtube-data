[{"type": "subtitle", "time": 3738.95, "timestamp": "01:02:18", "text": "未来。 Jo 小物件。可以重新做"}, {"type": "subtitle", "time": 3741.829, "timestamp": "01:02:21", "text": "我们之中。可以改写成《Among Us》。"}, {"type": "subtitle", "time": 3748.71, "timestamp": "01:02:28", "text": "我们如何思考？我们是如何变成现在这样的？"}, {"type": "subtitle", "time": 3753.03, "timestamp": "01:02:33", "text": "这么受欢迎？我的意思是，这是因为……呃……"}, {"type": "subtitle", "time": 3756.589, "timestamp": "01:02:36", "text": "就像BTB当时已经很受欢迎一样"}, {"type": "subtitle", "time": 3761.63, "timestamp": "01:02:41", "text": "多年来，日本变得越来越受欢迎"}, {"type": "subtitle", "time": 3766.27, "timestamp": "01:02:46", "text": "呃，因为就像神圣的，"}, {"type": "subtitle", "time": 3768.87, "timestamp": "01:02:48", "text": "甚至在神圣之前的一切"}, {"type": "subtitle", "time": 3773.15, "timestamp": "01:02:53", "text": "有很多独立创作者"}]
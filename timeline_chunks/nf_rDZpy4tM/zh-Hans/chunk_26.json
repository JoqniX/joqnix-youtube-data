[{"type": "subtitle", "time": 1560.83, "timestamp": "00:26:00", "text": "你惹我生气了"}, {"type": "subtitle", "time": 1562.87, "timestamp": "00:26:02", "text": "气得要死。你知道，我们正在获得"}, {"type": "subtitle", "time": 1565.19, "timestamp": "00:26:05", "text": "气死了。我们我们我们我们被热了"}, {"type": "subtitle", "time": 1566.95, "timestamp": "00:26:06", "text": "这边。我们不喜欢这种破事。我们"}, {"type": "subtitle", "time": 1568.31, "timestamp": "00:26:08", "text": "不喜欢有人走进来"}, {"type": "subtitle", "time": 1570.31, "timestamp": "00:26:10", "text": "践踏我们他妈的花园，"}, {"type": "subtitle", "time": 1572.07, "timestamp": "00:26:12", "text": "打个比方，这是个比喻。这是我们的"}, {"type": "subtitle", "time": 1573.669, "timestamp": "00:26:13", "text": "该死的花园。你走遍了所有地方"}, {"type": "subtitle", "time": 1575.35, "timestamp": "00:26:15", "text": "我们都厌倦了那些该死的植物"}, {"type": "subtitle", "time": 1577.51, "timestamp": "00:26:17", "text": "我们刚刚种下的种子。你知道，我们是"}, {"type": "subtitle", "time": 1579.31, "timestamp": "00:26:19", "text": "这边很忙。你这个混蛋"}, {"type": "subtitle", "time": 1582.71, "timestamp": "00:26:22", "text": "拉屎。你这个混蛋。嘿，"}, {"type": "subtitle", "time": 1584.87, "timestamp": "00:26:24", "text": "嘿，嘿。简单，简单，简单。哦，我不能"}, {"type": "subtitle", "time": 1586.95, "timestamp": "00:26:26", "text": "相信我们所拥有的一切。嘿，这是什么？"}, {"type": "subtitle", "time": 1588.95, "timestamp": "00:26:28", "text": "冰箱？"}, {"type": "subtitle", "time": 1592.31, "timestamp": "00:26:32", "text": "你好吗？嘿，嘿，嘿，嘿。"}, {"type": "subtitle", "time": 1594.789, "timestamp": "00:26:34", "text": "兄弟，你到底有什么大不了的？嘿，什么？"}, {"type": "subtitle", "time": 1598.63, "timestamp": "00:26:38", "text": "你这么在意吗？你，哇，哇，哇。哦，"}, {"type": "subtitle", "time": 1600.07, "timestamp": "00:26:40", "text": "我简直不敢相信。什么？哇，哇，"}, {"type": "subtitle", "time": 1602.789, "timestamp": "00:26:42", "text": "哇。我们在做什么？拉屎。硬汉"}, {"type": "subtitle", "time": 1604.71, "timestamp": "00:26:44", "text": "杀死它。我得到它。有时候你会"}, {"type": "subtitle", "time": 1608.23, "timestamp": "00:26:48", "text": "退缩。是的，我杀了一只。哦，"}, {"type": "subtitle", "time": 1609.909, "timestamp": "00:26:49", "text": "那很糟糕。你只能做你力所能及的事。"}, {"type": "subtitle", "time": 1613.11, "timestamp": "00:26:53", "text": "待办事项。兄弟，你到底有什么大不了的？"}, {"type": "subtitle", "time": 1616.39, "timestamp": "00:26:56", "text": "我的天哪，那家伙真是个白痴。好的"}, {"type": "subtitle", "time": 1617.56, "timestamp": "00:26:57", "text": "跳跃。"}]
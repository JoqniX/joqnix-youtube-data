[{"type": "subtitle", "time": 1620.269, "timestamp": "00:27:00", "text": "[音乐]"}, {"type": "subtitle", "time": 1632.75, "timestamp": "00:27:12", "text": "仅仅是"}, {"type": "subtitle", "time": 1643.75, "timestamp": "00:27:23", "text": "枪。好的，他们又要回去了。"}, {"type": "subtitle", "time": 1645.98, "timestamp": "00:27:25", "text": "工作。好的。"}, {"type": "subtitle", "time": 1661.909, "timestamp": "00:27:41", "text": "哦，看那个大炮台！"}, {"type": "subtitle", "time": 1663.83, "timestamp": "00:27:43", "text": "像个硬汉一样到处乱窜。"}, {"type": "subtitle", "time": 1665.87, "timestamp": "00:27:45", "text": "嘿，"}, {"type": "subtitle", "time": 1670.54, "timestamp": "00:27:50", "text": "停止使用粗俗语言。我的天啊。喂。"}, {"type": "subtitle", "time": 1672.47, "timestamp": "00:27:52", "text": "[音乐]"}, {"type": "subtitle", "time": 1674.63, "timestamp": "00:27:54", "text": "你做了什么？"}, {"type": "subtitle", "time": 1675.99, "timestamp": "00:27:55", "text": "我知道我们这样做不仅仅是为了……"}, {"type": "subtitle", "time": 1679.43, "timestamp": "00:27:59", "text": "有趣，但确实如此。很有趣。这是。"}]
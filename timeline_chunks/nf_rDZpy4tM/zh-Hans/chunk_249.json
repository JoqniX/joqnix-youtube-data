[{"type": "subtitle", "time": 14944.95, "timestamp": "04:09:04", "text": "那。好久不见了。我做了"}, {"type": "subtitle", "time": 14947.51, "timestamp": "04:09:07", "text": "像长长的……像清晨的溪流"}, {"type": "subtitle", "time": 14950.15, "timestamp": "04:09:10", "text": "就像现在这样。是的。我错过了他"}, {"type": "subtitle", "time": 14953.269, "timestamp": "04:09:13", "text": "想当年这个时间还在直播。"}, {"type": "subtitle", "time": 14955.91, "timestamp": "04:09:15", "text": "好，我们开始直播吧。我应该"}, {"type": "subtitle", "time": 14957.429, "timestamp": "04:09:17", "text": "等等，你说的“直播”是什么意思？我是"}, {"type": "subtitle", "time": 14965.03, "timestamp": "04:09:25", "text": "居住。好的。好的。好的。等待。嗯……嗯……嗯。"}, {"type": "subtitle", "time": 14967.71, "timestamp": "04:09:27", "text": "我的"}, {"type": "subtitle", "time": 14972.349, "timestamp": "04:09:32", "text": "东西？呃，我们现在正在直播。"}, {"type": "subtitle", "time": 14976.07, "timestamp": "04:09:36", "text": "好了，就是这样。我出故障了。嘿，"}, {"type": "subtitle", "time": 14978.71, "timestamp": "04:09:38", "text": "我们还是切换到游戏吧。是的，"}, {"type": "subtitle", "time": 14981.11, "timestamp": "04:09:41", "text": "让我们好好享受今天吧，我将要玩游戏。"}, {"type": "subtitle", "time": 14985.189, "timestamp": "04:09:45", "text": "在东南亚服务器上。好的，我们会是"}, {"type": "subtitle", "time": 14989.03, "timestamp": "04:09:49", "text": "检查 SCA 是否更适合我"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "每个服务器对我来说都有好有坏。所以，"}, {"type": "subtitle", "time": 14992.309, "timestamp": "04:09:52", "text": "我两个平台都会玩。好的，对于"}, {"type": "subtitle", "time": 14994.91, "timestamp": "04:09:54", "text": "今天。但现在，我们先从……开始"}, {"type": "subtitle", "time": 14999.349, "timestamp": "04:09:59", "text": "SCA。请务必告诉我音频和"}]
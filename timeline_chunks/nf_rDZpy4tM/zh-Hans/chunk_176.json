[{"type": "subtitle", "time": 10560.79, "timestamp": "02:56:00", "text": "驼背太严重了。我的天哪，别这样"}, {"type": "subtitle", "time": 10563.11, "timestamp": "02:56:03", "text": "担心。我们将推出另一条直播流。"}, {"type": "subtitle", "time": 10564.95, "timestamp": "02:56:04", "text": "香港。别担心，我会做的"}, {"type": "subtitle", "time": 10567.83, "timestamp": "02:56:07", "text": "也一样。是的，我将开始"}, {"type": "subtitle", "time": 10571.309, "timestamp": "02:56:11", "text": "下一轮直播将于9:08开始。"}, {"type": "subtitle", "time": 10574.23, "timestamp": "02:56:14", "text": "好的，大概是9点08分左右。是的，我需要"}, {"type": "subtitle", "time": 10579.23, "timestamp": "02:56:19", "text": "我们去做一些事情，等我做完就好了。"}, {"type": "subtitle", "time": 10583.349, "timestamp": "02:56:23", "text": "所以，当时他情绪高涨，而且……"}, {"type": "subtitle", "time": 10587.11, "timestamp": "02:56:27", "text": "这条流是第二个 t 秒"}, {"type": "subtitle", "time": 10589.95, "timestamp": "02:56:29", "text": "这部分是第二部分"}, {"type": "subtitle", "time": 10592.87, "timestamp": "02:56:32", "text": "游戏。所以，是的，期待和你们见面！"}, {"type": "subtitle", "time": 10596.389, "timestamp": "02:56:36", "text": "在直播的下一个高潮中。最多"}, {"type": "subtitle", "time": 10600.95, "timestamp": "02:56:40", "text": "我可能下周会把它放上去。"}, {"type": "subtitle", "time": 10603.269, "timestamp": "02:56:43", "text": "还有一些香港人。是的，还有其他的"}, {"type": "subtitle", "time": 10610.269, "timestamp": "02:56:50", "text": "所以，是的，就这么办吧。"}, {"type": "subtitle", "time": 10615.03, "timestamp": "02:56:55", "text": "让我来做这件事。你好。所以所有来的人"}, {"type": "subtitle", "time": 10618.55, "timestamp": "02:56:58", "text": "再见，非常感谢您光临。"}]
[{"type": "subtitle", "time": 4681.11, "timestamp": "01:18:01", "text": "在精神病患者中"}, {"type": "subtitle", "time": 4683.51, "timestamp": "01:18:03", "text": "你可以说是社区或幽灵，但"}, {"type": "subtitle", "time": 4685.669, "timestamp": "01:18:05", "text": "当时在那里支持精神病患者"}, {"type": "subtitle", "time": 4687.99, "timestamp": "01:18:07", "text": "慢慢地，那些既得利益者也开始效仿了。"}, {"type": "subtitle", "time": 4689.59, "timestamp": "01:18:09", "text": "手表"}, {"type": "subtitle", "time": 4692.79, "timestamp": "01:18:12", "text": "嗯，谁会看我们，比如第一世代和第二世代？"}, {"type": "subtitle", "time": 4694.87, "timestamp": "01:18:14", "text": "他们也会前来支持他们。"}, {"type": "subtitle", "time": 4697.189, "timestamp": "01:18:17", "text": "就这样，你来了"}, {"type": "subtitle", "time": 4699.35, "timestamp": "01:18:19", "text": "呃，比如每日关注者和忠实粉丝。"}, {"type": "subtitle", "time": 4701.47, "timestamp": "01:18:21", "text": "观察者们纷纷涌入"}, {"type": "subtitle", "time": 4705.27, "timestamp": "01:18:25", "text": "是的，所以如果你是一位新秀或者"}, {"type": "subtitle", "time": 4708.07, "timestamp": "01:18:28", "text": "对于即将进入新时代的新一代来说，这或许有些意义。"}, {"type": "subtitle", "time": 4709.75, "timestamp": "01:18:29", "text": "已确立的"}, {"type": "subtitle", "time": 4712.229, "timestamp": "01:18:32", "text": "呃，社区。这会更难"}, {"type": "subtitle", "time": 4713.709, "timestamp": "01:18:33", "text": "第一的，"}, {"type": "subtitle", "time": 4716.95, "timestamp": "01:18:36", "text": "但随着时间的推移，你会习惯的。"}, {"type": "subtitle", "time": 4718.189, "timestamp": "01:18:38", "text": "东西。是的。"}, {"type": "subtitle", "time": 4722.91, "timestamp": "01:18:42", "text": "是的。所以，现在轮到独立音乐人了。"}, {"type": "subtitle", "time": 4726.91, "timestamp": "01:18:46", "text": "例如 YouTube。呃，就像带我走一样，"}, {"type": "subtitle", "time": 4729.149, "timestamp": "01:18:49", "text": "正确的？我应该服用"}, {"type": "subtitle", "time": 4733.35, "timestamp": "01:18:53", "text": "我？不，呃，我不知道。我不"}, {"type": "subtitle", "time": 4734.87, "timestamp": "01:18:54", "text": "不知道我是否应该带一个这样的人"}, {"type": "subtitle", "time": 4736.35, "timestamp": "01:18:56", "text": "所以我很害怕。"}, {"type": "subtitle", "time": 4739.79, "timestamp": "01:18:59", "text": "呃，我应该找谁？"}]
[{"type": "subtitle", "time": 16501.551, "timestamp": "04:35:01", "text": "终端。哦，这是传送门吗？"}, {"type": "subtitle", "time": 16507.769, "timestamp": "04:35:07", "text": "好的。好，好，好，好"}, {"type": "subtitle", "time": 16521.551, "timestamp": "04:35:21", "text": "好的。我们快要到达美丽的"}, {"type": "subtitle", "time": 16524.31, "timestamp": "04:35:24", "text": "入口。会有一段下降期，但是"}, {"type": "subtitle", "time": 16526.75, "timestamp": "04:35:26", "text": "如果你是我的闹钟"}, {"type": "subtitle", "time": 16529.83, "timestamp": "04:35:29", "text": "响了。早上7点闹钟。一旦你离开"}, {"type": "subtitle", "time": 16532.15, "timestamp": "04:35:32", "text": "从峡谷到那里，只需步行很短一段路即可。"}, {"type": "subtitle", "time": 16541.189, "timestamp": "04:35:41", "text": "新城是最安全的地方。我们走吧。"}, {"type": "subtitle", "time": 16543.59, "timestamp": "04:35:43", "text": "共振连接提供覆盖范围。"}, {"type": "subtitle", "time": 16546.07, "timestamp": "04:35:46", "text": "这是原神的最新更新。得到一个"}, {"type": "subtitle", "time": 16548.31, "timestamp": "04:35:48", "text": "防护屏障，坚固耐用。是的。"}, {"type": "subtitle", "time": 16551.83, "timestamp": "04:35:51", "text": "原神2.0。"}, {"type": "subtitle", "time": 16554.31, "timestamp": "04:35:54", "text": "是的。"}, {"type": "subtitle", "time": 16556.709, "timestamp": "04:35:56", "text": "京州位于沙漠高地之间"}, {"type": "subtitle", "time": 16559.189, "timestamp": "04:35:59", "text": "以及普通的荒地。它在一艘船上"}]
[{"type": "subtitle", "time": 1920.47, "timestamp": "00:32:00", "text": "加入G3是我们做过的最明智的决定。"}, {"type": "subtitle", "time": 1923.029, "timestamp": "00:32:03", "text": "曾经有过。我从未感觉如此充满活力。哦"}, {"type": "subtitle", "time": 1924.78, "timestamp": "00:32:04", "text": "我的"}, {"type": "subtitle", "time": 1927.23, "timestamp": "00:32:07", "text": "[音乐]"}, {"type": "subtitle", "time": 1931.029, "timestamp": "00:32:11", "text": "上帝。这是什么？你只是走过"}, {"type": "subtitle", "time": 1933.269, "timestamp": "00:32:13", "text": "我需要杀了你。你刚才说"}, {"type": "subtitle", "time": 1937.35, "timestamp": "00:32:17", "text": "你加入了D G3部队，对吧？"}, {"type": "subtitle", "time": 1940.549, "timestamp": "00:32:20", "text": "对不起，我不该杀了自己。"}, {"type": "subtitle", "time": 1943.549, "timestamp": "00:32:23", "text": "是的。是的。当然。我想"}, {"type": "subtitle", "time": 1945.149, "timestamp": "00:32:25", "text": "你"}, {"type": "subtitle", "time": 1965.35, "timestamp": "00:32:45", "text": "老牛仔以前就是这么做的吗？"}, {"type": "subtitle", "time": 1969.029, "timestamp": "00:32:49", "text": "两个人聊天，还有高科技？"}, {"type": "subtitle", "time": 1970.71, "timestamp": "00:32:50", "text": "这里记录着小镇的过去。我只是站着"}, {"type": "subtitle", "time": 1972.07, "timestamp": "00:32:52", "text": "到处跟人说。这是怎么回事"}, {"type": "subtitle", "time": 1973.909, "timestamp": "00:32:53", "text": "狗狗，你在吗？你好。我不能让任何人进来。"}, {"type": "subtitle", "time": 1975.269, "timestamp": "00:32:55", "text": "现在。新兵太多了"}, {"type": "subtitle", "time": 1976.63, "timestamp": "00:32:56", "text": "在镇上惹是生非。我进去了"}, {"type": "subtitle", "time": 1977.99, "timestamp": "00:32:57", "text": "这种情况发生时就会很麻烦。所以，我要走了"}, {"type": "subtitle", "time": 1979.509, "timestamp": "00:32:59", "text": "直到他们停下来，才会关上大门。"}]
[{"type": "subtitle", "time": 3927.069, "timestamp": "01:05:27", "text": "我当时正在服用脑部药物"}, {"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "集中注意力，思考最后一个是关于"}, {"type": "subtitle", "time": 3932.549, "timestamp": "01:05:32", "text": "加入，但这个是关于我如何"}, {"type": "subtitle", "time": 3935.23, "timestamp": "01:05:35", "text": "喜欢折磨人。它不是"}, {"type": "subtitle", "time": 3942.069, "timestamp": "01:05:42", "text": "我很确定我们能找到解决办法。"}, {"type": "subtitle", "time": 3945.27, "timestamp": "01:05:45", "text": "进来。我要折磨任何人。"}, {"type": "subtitle", "time": 3947.75, "timestamp": "01:05:47", "text": "我有个问题。是的。把你的"}, {"type": "subtitle", "time": 3949.51, "timestamp": "01:05:49", "text": "举手。当你……时举起双手"}, {"type": "subtitle", "time": 3952.39, "timestamp": "01:05:52", "text": "滑下动力滑道。嘿。嘿，"}, {"type": "subtitle", "time": 3954.069, "timestamp": "01:05:54", "text": "你看看这个。我弄到了一些粘稠物"}, {"type": "subtitle", "time": 3955.51, "timestamp": "01:05:55", "text": "这里。你一定会喜欢的。你可以"}, {"type": "subtitle", "time": 3957.109, "timestamp": "01:05:57", "text": "用它偷偷溜进去。来。嘿。嘿"}, {"type": "subtitle", "time": 3959.51, "timestamp": "01:05:59", "text": "那里。谢谢您过来。盖伊"}]
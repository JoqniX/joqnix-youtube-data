[{"type": "subtitle", "time": 3487.589, "timestamp": "00:58:07", "text": "我们的工作正在蚕食我们的器官。所以，就像我"}, {"type": "subtitle", "time": 3489.109, "timestamp": "00:58:09", "text": "我哥哥告诉我，道格拉斯"}, {"type": "subtitle", "time": 3491.43, "timestamp": "00:58:11", "text": "他真的很喜欢酷刑。比如性方面？"}, {"type": "subtitle", "time": 3493.109, "timestamp": "00:58:13", "text": "这重要吗？是的。对我来说，它需要"}, {"type": "subtitle", "time": 3494.47, "timestamp": "00:58:14", "text": "具有性吸引力。你为什么要告诉我这些？"}, {"type": "subtitle", "time": 3496.87, "timestamp": "00:58:16", "text": "我几乎不认识你。"}, {"type": "subtitle", "time": 3507.19, "timestamp": "00:58:27", "text": "上帝。我看到你了，伙计。我得到了很多"}, {"type": "subtitle", "time": 3509.31, "timestamp": "00:58:29", "text": "从这里取出的箱子。"}, {"type": "subtitle", "time": 3511.829, "timestamp": "00:58:31", "text": "[音乐]"}, {"type": "subtitle", "time": 3513.99, "timestamp": "00:58:33", "text": "我是参议员托马斯·迈克尔·菲利普斯，"}, {"type": "subtitle", "time": 3517.589, "timestamp": "00:58:37", "text": "我支持“母亲反对暴力”组织。"}, {"type": "subtitle", "time": 3519.51, "timestamp": "00:58:39", "text": "这个区域是“母亲反对运动”的一部分。"}, {"type": "subtitle", "time": 3521.91, "timestamp": "00:58:41", "text": "暴力条约。所以，禁止一切暴力行为。"}, {"type": "subtitle", "time": 3527.75, "timestamp": "00:58:47", "text": "那么，“反对暴力母亲组织”是如何运作的呢？"}, {"type": "subtitle", "time": 3530.39, "timestamp": "00:58:50", "text": "怎么回事？嗯，我们所有人，你们是什么？"}, {"type": "subtitle", "time": 3532.47, "timestamp": "00:58:52", "text": "正在做？"}, {"type": "subtitle", "time": 3534.47, "timestamp": "00:58:54", "text": "你在查找什么？然后决定了"}, {"type": "subtitle", "time": 3536.39, "timestamp": "00:58:56", "text": "如果能有几个小板块就太好了。"}, {"type": "subtitle", "time": 3538.39, "timestamp": "00:58:58", "text": "在那里，我们不会互相残杀。"}]
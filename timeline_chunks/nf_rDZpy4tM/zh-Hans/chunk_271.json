[{"type": "subtitle", "time": 16261.389, "timestamp": "04:31:01", "text": "你当时与我们面对面站着。"}, {"type": "subtitle", "time": 16263.75, "timestamp": "04:31:03", "text": "哨兵。我们几乎看不见我们"}, {"type": "subtitle", "time": 16266.07, "timestamp": "04:31:06", "text": "用自己的眼睛当哨兵。最多"}, {"type": "subtitle", "time": 16267.83, "timestamp": "04:31:07", "text": "人们只有在以下情况下才有机会："}, {"type": "subtitle", "time": 16269.75, "timestamp": "04:31:09", "text": "任命仪式。预约"}, {"type": "subtitle", "time": 16272.469, "timestamp": "04:31:12", "text": "仪式。根据你的描述，你站在那里"}, {"type": "subtitle", "time": 16275.269, "timestamp": "04:31:15", "text": "八九不离十。只有哨兵的"}, {"type": "subtitle", "time": 16277.55, "timestamp": "04:31:17", "text": "指定的谐振器在其内部是允许的。"}, {"type": "subtitle", "time": 16280.63, "timestamp": "04:31:20", "text": "距离近。目前，这个人就是"}, {"type": "subtitle", "time": 16283.59, "timestamp": "04:31:23", "text": "詹·乔尔的治安法官。谁是"}, {"type": "subtitle", "time": 16286.229, "timestamp": "04:31:26", "text": "迪诺的治安官？"}, {"type": "subtitle", "time": 16291.03, "timestamp": "04:31:31", "text": "哇。真糟糕。那一定是精英阶层。"}, {"type": "subtitle", "time": 16293.91, "timestamp": "04:31:33", "text": "哦，发生什么事了？"}, {"type": "subtitle", "time": 16296.07, "timestamp": "04:31:36", "text": "杰西娅可能身处险境。机器人，"}, {"type": "subtitle", "time": 16299.79, "timestamp": "04:31:39", "text": "请。请。哦，我们走吧。斗争"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "战斗时刻。我们走吧。"}, {"type": "subtitle", "time": 16315.309, "timestamp": "04:31:55", "text": "共鸣时刻。谐振。哦，我的"}, {"type": "subtitle", "time": 16317.07, "timestamp": "04:31:57", "text": "上帝。"}]
[{"type": "subtitle", "time": 7980.47, "timestamp": "02:13:00", "text": "物种。行了，蠢货。我们走吧。"}, {"type": "subtitle", "time": 7983.189, "timestamp": "02:13:03", "text": "什么？不。你好。很高兴见到你。或者"}, {"type": "subtitle", "time": 7985.51, "timestamp": "02:13:05", "text": "谢谢你救了我。为什么？就像你一样"}, {"type": "subtitle", "time": 7987.43, "timestamp": "02:13:07", "text": "没死在那里或许是一种恩惠。"}, {"type": "subtitle", "time": 7990.55, "timestamp": "02:13:10", "text": "大部头书？你好，我是瑞典人，非常感谢。"}, {"type": "subtitle", "time": 7993.51, "timestamp": "02:13:13", "text": "谢谢你救了我。怎么样，蠢货？"}, {"type": "subtitle", "time": 7995.51, "timestamp": "02:13:15", "text": "好了，快点。利用我的时间泡泡"}, {"type": "subtitle", "time": 7998.149, "timestamp": "02:13:18", "text": "通过世界上最大的风扇逃脱。"}, {"type": "subtitle", "time": 8000.55, "timestamp": "02:13:20", "text": "很酷吧？你会发现"}, {"type": "subtitle", "time": 8003.35, "timestamp": "02:13:23", "text": "很快就证明我是最棒的加特林。"}, {"type": "subtitle", "time": 8007.03, "timestamp": "02:13:27", "text": "最智能、最实用、最好看。不。"}, {"type": "subtitle", "time": 8008.229, "timestamp": "02:13:28", "text": "不，别这样。快点。我很漂亮"}, {"type": "subtitle", "time": 8011.109, "timestamp": "02:13:31", "text": "道格拉斯。它是服装。哪里"}, {"type": "subtitle", "time": 8013.27, "timestamp": "02:13:33", "text": "你他妈是？我听说你做了"}, {"type": "subtitle", "time": 8015.03, "timestamp": "02:13:35", "text": "你在派对上真是个十足的傻瓜"}, {"type": "subtitle", "time": 8020.229, "timestamp": "02:13:40", "text": "昨夜。情况不妙，道格拉斯。不太好。"}, {"type": "subtitle", "time": 8021.75, "timestamp": "02:13:41", "text": "我需要你全力以赴"}, {"type": "subtitle", "time": 8023.43, "timestamp": "02:13:43", "text": "现在我们已经掌握了这些，游戏开始了。"}, {"type": "subtitle", "time": 8026.229, "timestamp": "02:13:46", "text": "人类。我们在地球上的分布非常分散，"}, {"type": "subtitle", "time": 8029.75, "timestamp": "02:13:49", "text": "我急需更多部队。"}, {"type": "subtitle", "time": 8031.43, "timestamp": "02:13:51", "text": "事情将会变得越来越激烈。"}, {"type": "subtitle", "time": 8034.95, "timestamp": "02:13:54", "text": "随着需求上升，整个银河系都在关注。大的"}, {"type": "subtitle", "time": 8037.31, "timestamp": "02:13:57", "text": "事情正在发生，道格拉斯。得到"}, {"type": "subtitle", "time": 8039.83, "timestamp": "02:13:59", "text": "兴奋起来，赶紧把你的破烂玩意儿拿来"}]
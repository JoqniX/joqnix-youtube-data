[{"type": "subtitle", "time": 16440.949, "timestamp": "04:34:00", "text": "在他能好好休息之前就被处理掉了"}, {"type": "subtitle", "time": 16442.45, "timestamp": "04:34:02", "text": "看。"}, {"type": "subtitle", "time": 16445.67, "timestamp": "04:34:05", "text": "[音乐]"}, {"type": "subtitle", "time": 16448.869, "timestamp": "04:34:08", "text": "让我看看我自己的片子。说到这个，"}, {"type": "subtitle", "time": 16451.269, "timestamp": "04:34:11", "text": "我们快到了。这里有个箱子。"}, {"type": "subtitle", "time": 16453.59, "timestamp": "04:34:13", "text": "说过我们会和巴见面。她是"}, {"type": "subtitle", "time": 16455.91, "timestamp": "04:34:15", "text": "谐振器。收集所有植物。为什么"}, {"type": "subtitle", "time": 16457.51, "timestamp": "04:34:17", "text": "不是？我能应付她的共鸣"}, {"type": "subtitle", "time": 16459.75, "timestamp": "04:34:19", "text": "我们的能力让我们找到了彼此。"}, {"type": "subtitle", "time": 16461.91, "timestamp": "04:34:21", "text": "峡谷底部。拜拉做了一些"}, {"type": "subtitle", "time": 16464.47, "timestamp": "04:34:24", "text": "给你提供急救信息。你似乎有"}, {"type": "subtitle", "time": 16468.39, "timestamp": "04:34:28", "text": "你溺水了，但你的呼吸道是畅通的。看，"}, {"type": "subtitle", "time": 16471.51, "timestamp": "04:34:31", "text": "那边有个共振信标。"}, {"type": "subtitle", "time": 16473.349, "timestamp": "04:34:33", "text": "当你看到信标时，一定要"}, {"type": "subtitle", "time": 16475.67, "timestamp": "04:34:35", "text": "注册并激活。通常是"}, {"type": "subtitle", "time": 16477.83, "timestamp": "04:34:37", "text": "安全！哦，这边有个箱子。"}, {"type": "subtitle", "time": 16480.23, "timestamp": "04:34:40", "text": "灯塔。它可以保护你免受危险。"}, {"type": "subtitle", "time": 16482.709, "timestamp": "04:34:42", "text": "有时。罗孚，你能把你的给我吗？"}, {"type": "subtitle", "time": 16484.67, "timestamp": "04:34:44", "text": "终端"}, {"type": "subtitle", "time": 16488.15, "timestamp": "04:34:48", "text": "片刻？完毕。它的设计和系统"}, {"type": "subtitle", "time": 16490.789, "timestamp": "04:34:50", "text": "版本与我们的版本不同，但是"}, {"type": "subtitle", "time": 16492.789, "timestamp": "04:34:52", "text": "你的终端仍然保留着数据。"}]
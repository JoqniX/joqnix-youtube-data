[{"type": "subtitle", "time": 1515.51, "timestamp": "00:25:15", "text": "滑索。呃，好吧，我还是继续往下说吧。"}, {"type": "subtitle", "time": 1518.19, "timestamp": "00:25:18", "text": "没关系。离开"}, {"type": "subtitle", "time": 1520.47, "timestamp": "00:25:20", "text": "它。那些巨大的旧支撑梁"}, {"type": "subtitle", "time": 1521.75, "timestamp": "00:25:21", "text": "从房子底部传来"}, {"type": "subtitle", "time": 1523.43, "timestamp": "00:25:23", "text": "你知道，就是走到山坡边去。"}, {"type": "subtitle", "time": 1525.59, "timestamp": "00:25:25", "text": "等等，等等，等等。你可以步行"}, {"type": "subtitle", "time": 1527.35, "timestamp": "00:25:27", "text": "你想去哪儿都行。这是一台他妈的苹果电脑"}, {"type": "subtitle", "time": 1529.549, "timestamp": "00:25:29", "text": "兄弟建筑工地。"}, {"type": "subtitle", "time": 1532.549, "timestamp": "00:25:32", "text": "这里。喔喔喔。冷静下来。我们没事。"}, {"type": "subtitle", "time": 1534.23, "timestamp": "00:25:34", "text": "好的。那么，你打算如何处理这件事？"}, {"type": "subtitle", "time": 1536.63, "timestamp": "00:25:36", "text": "像这样的硬汉只尊重他人。"}, {"type": "subtitle", "time": 1538.71, "timestamp": "00:25:38", "text": "硬汉。所以，别让我难堪。你"}, {"type": "subtitle", "time": 1540.07, "timestamp": "00:25:40", "text": "你以为你可以直接走进一家苹果公司吗？"}, {"type": "subtitle", "time": 1541.669, "timestamp": "00:25:41", "text": "还有奶酪兄弟的建筑工地"}, {"type": "subtitle", "time": 1543.269, "timestamp": "00:25:43", "text": "你简直就像个该死的耶稣"}, {"type": "subtitle", "time": 1545.35, "timestamp": "00:25:45", "text": "基督啊，你就当自己人一样到处走走吧"}, {"type": "subtitle", "time": 1546.87, "timestamp": "00:25:46", "text": "地方？这简直是​​个无底洞"}, {"type": "subtitle", "time": 1548.31, "timestamp": "00:25:48", "text": "混蛋，过来这边。你认为你"}, {"type": "subtitle", "time": 1549.669, "timestamp": "00:25:49", "text": "掉下去也能活下来"}, {"type": "subtitle", "time": 1550.95, "timestamp": "00:25:50", "text": "他妈的无底洞，一直延伸到"}, {"type": "subtitle", "time": 1553.11, "timestamp": "00:25:53", "text": "底部？我不这么认为。我们找到了工作"}, {"type": "subtitle", "time": 1555.11, "timestamp": "00:25:55", "text": "做。行了，蠢货。咱们他妈的走吧"}, {"type": "subtitle", "time": 1557.51, "timestamp": "00:25:57", "text": "滚出去，混蛋。你知道，嘿，"}, {"type": "subtitle", "time": 1559.43, "timestamp": "00:25:59", "text": "去你的。你这个混蛋。你走进去"}]
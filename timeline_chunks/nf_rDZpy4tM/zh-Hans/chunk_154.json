[{"type": "subtitle", "time": 9242.309, "timestamp": "02:34:02", "text": "克拉格·纳格曼，布利姆市法官。作为"}, {"type": "subtitle", "time": 9244.389, "timestamp": "02:34:04", "text": "你们都知道，我正在努力冲洗。"}, {"type": "subtitle", "time": 9246.389, "timestamp": "02:34:06", "text": "清除我们所有的犯罪和毒品"}, {"type": "subtitle", "time": 9248.79, "timestamp": "02:34:08", "text": "街道。我首先承认，我们"}, {"type": "subtitle", "time": 9250.469, "timestamp": "02:34:10", "text": "这场斗争并没有取得多大进展。"}, {"type": "subtitle", "time": 9252.63, "timestamp": "02:34:12", "text": "反对G3卡特尔。好了，现在"}, {"type": "subtitle", "time": 9254.55, "timestamp": "02:34:14", "text": "注意接下来这段。即将"}, {"type": "subtitle", "time": 9256.87, "timestamp": "02:34:16", "text": "改变。我们得知了一项大胆的赏金计划"}, {"type": "subtitle", "time": 9259.429, "timestamp": "02:34:19", "text": "勇敢地使用这台G3的猎人"}, {"type": "subtitle", "time": 9261.51, "timestamp": "02:34:21", "text": "事情掌握在他们自己手中。你听到"}, {"type": "subtitle", "time": 9263.83, "timestamp": "02:34:23", "text": "那？他说的就是你。他们有"}, {"type": "subtitle", "time": 9265.75, "timestamp": "02:34:25", "text": "已经处理了其中两个卡特尔的"}, {"type": "subtitle", "time": 9268.07, "timestamp": "02:34:28", "text": "最有权势的官员。是的，你得到了"}, {"type": "subtitle", "time": 9271.429, "timestamp": "02:34:31", "text": "幸运的。我并不骄傲。"}, {"type": "subtitle", "time": 9273.83, "timestamp": "02:34:33", "text": "但是，然后你确实"}, {"type": "subtitle", "time": 9275.67, "timestamp": "02:34:35", "text": "各位听众，请考虑加入"}, {"type": "subtitle", "time": 9277.59, "timestamp": "02:34:37", "text": "与布林镇的善良人民并肩作战"}, {"type": "subtitle", "time": 9279.59, "timestamp": "02:34:39", "text": "城市。我希望您能来。"}, {"type": "subtitle", "time": 9281.75, "timestamp": "02:34:41", "text": "请您亲自到场与我见面。"}, {"type": "subtitle", "time": 9283.51, "timestamp": "02:34:43", "text": "我在市政厅的办公室。我的天哪。"}, {"type": "subtitle", "time": 9285.59, "timestamp": "02:34:45", "text": "我们应该去见他吗？我已经告诉他了"}, {"type": "subtitle", "time": 9289.19, "timestamp": "02:34:49", "text": "你去。什么？不，别开始。相信我，"}, {"type": "subtitle", "time": 9291.67, "timestamp": "02:34:51", "text": "他是正规的。这家伙一直反对G3"}, {"type": "subtitle", "time": 9293.429, "timestamp": "02:34:53", "text": "早在你们任何人入伍之前就已如此。"}, {"type": "subtitle", "time": 9295.51, "timestamp": "02:34:55", "text": "尿布。说实话，我不知道是否"}, {"type": "subtitle", "time": 9298.15, "timestamp": "02:34:58", "text": "加特林一家甚至还穿尿布。穿过"}]
[{"type": "subtitle", "time": 13447.51, "timestamp": "03:44:07", "text": "问一下，也谢谢你和我聊天。"}, {"type": "subtitle", "time": 13454.59, "timestamp": "03:44:14", "text": "Mingasa，我希望你能……"}, {"type": "subtitle", "time": 13457.95, "timestamp": "03:44:17", "text": "懂英语，但是"}, {"type": "subtitle", "time": 13460.63, "timestamp": "03:44:20", "text": "呃，如果你愿意的话，我可以帮你翻译。"}, {"type": "subtitle", "time": 13462.55, "timestamp": "03:44:22", "text": "可以用中文输入吗？我不知道"}, {"type": "subtitle", "time": 13467.83, "timestamp": "03:44:27", "text": "你是中国人，呃，你是中国人，但是"}, {"type": "subtitle", "time": 13468.99, "timestamp": "03:44:28", "text": "做"}, {"type": "subtitle", "time": 13472.389, "timestamp": "03:44:32", "text": "用你自己的语言写。"}, {"type": "subtitle", "time": 13474.63, "timestamp": "03:44:34", "text": "所以我会读它，翻译它，然后……"}, {"type": "subtitle", "time": 13478.55, "timestamp": "03:44:38", "text": "现在就联系你。嗨，谢谢"}, {"type": "subtitle", "time": 13480.71, "timestamp": "03:44:40", "text": "谢谢你的光临。真的真的真的"}, {"type": "subtitle", "time": 13486.87, "timestamp": "03:44:46", "text": "你。他们发现他就像尼克·弗瑞一样。"}, {"type": "subtitle", "time": 13488.429, "timestamp": "03:44:48", "text": "录制"}, {"type": "subtitle", "time": 13491.269, "timestamp": "03:44:51", "text": "复仇者联盟。你是如何找到星空景观的？"}, {"type": "subtitle", "time": 13493.75, "timestamp": "03:44:53", "text": "团体？呃，我想我之前提过这件事。"}, {"type": "subtitle", "time": 13496.389, "timestamp": "03:44:56", "text": "两三次，对吧？我发现"}, {"type": "subtitle", "time": 13498.95, "timestamp": "03:44:58", "text": "星空"}, {"type": "subtitle", "time": 13499.87, "timestamp": "03:44:59", "text": "呃"}]
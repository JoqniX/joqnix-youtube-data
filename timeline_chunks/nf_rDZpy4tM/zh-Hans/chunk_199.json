[{"type": "subtitle", "time": 11941.75, "timestamp": "03:19:01", "text": "你的经理会联系你。"}, {"type": "subtitle", "time": 11944.63, "timestamp": "03:19:04", "text": "就像那样，就像……该怎么称呼它呢？"}, {"type": "subtitle", "time": 11955.15, "timestamp": "03:19:15", "text": "[音乐]"}, {"type": "subtitle", "time": 11957.469, "timestamp": "03:19:17", "text": "嗯，他们是"}, {"type": "subtitle", "time": 11959.19, "timestamp": "03:19:19", "text": "比如，你怎么称呼它"}, {"type": "subtitle", "time": 11961.389, "timestamp": "03:19:21", "text": "[音乐]"}, {"type": "subtitle", "time": 11964.67, "timestamp": "03:19:24", "text": "它？是的。是的。诸如此类的事情，"}, {"type": "subtitle", "time": 11967.349, "timestamp": "03:19:27", "text": "正确的？接下来会发生什么？"}, {"type": "subtitle", "time": 11970.469, "timestamp": "03:19:30", "text": "乔？我不知道。但我希望我能"}, {"type": "subtitle", "time": 11973.469, "timestamp": "03:19:33", "text": "一年中不断摸索解决这个问题。我"}, {"type": "subtitle", "time": 11977.67, "timestamp": "03:19:37", "text": "我觉得，嗯，就是这样。"}, {"type": "subtitle", "time": 11980.79, "timestamp": "03:19:40", "text": "也可以像保护乔克和阿迪什一样保护他们"}, {"type": "subtitle", "time": 11982.67, "timestamp": "03:19:42", "text": "亚历克斯。是的。所以"}, {"type": "subtitle", "time": 11985.67, "timestamp": "03:19:45", "text": "他们永远不会受伤或喜欢"}, {"type": "subtitle", "time": 11986.59, "timestamp": "03:19:46", "text": "你"}, {"type": "subtitle", "time": 11990.229, "timestamp": "03:19:50", "text": "别惹麻烦什么的。是的。"}, {"type": "subtitle", "time": 11992.63, "timestamp": "03:19:52", "text": "我不知道这样的事情。是的。"}, {"type": "subtitle", "time": 11994.79, "timestamp": "03:19:54", "text": "不过，就像我刚才说的，呃"}, {"type": "subtitle", "time": 11997.91, "timestamp": "03:19:57", "text": "这样就能证明我的帮助是合理的，对吧？我希望"}]
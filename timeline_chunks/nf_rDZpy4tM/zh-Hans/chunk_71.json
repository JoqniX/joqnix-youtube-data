[{"type": "subtitle", "time": 4262.11, "timestamp": "01:11:02", "text": "[音乐]"}, {"type": "subtitle", "time": 4266.149, "timestamp": "01:11:06", "text": "上帝。人们可以加入，呃，可以等待。这"}, {"type": "subtitle", "time": 4267.91, "timestamp": "01:11:07", "text": "工作原理。我认为当人们加入一个"}, {"type": "subtitle", "time": 4270.229, "timestamp": "01:11:10", "text": "通过分享共同点制作企业视频"}, {"type": "subtitle", "time": 4272.39, "timestamp": "01:11:12", "text": "然后向他们介绍常旅客"}, {"type": "subtitle", "time": 4274.55, "timestamp": "01:11:14", "text": "他们对他们感兴趣。人们来了，"}, {"type": "subtitle", "time": 4277.669, "timestamp": "01:11:17", "text": "去吧，好的。是的。确切地。那就像"}, {"type": "subtitle", "time": 4283.27, "timestamp": "01:11:23", "text": "是的。是的。过了一段时间，我……"}, {"type": "subtitle", "time": 4284.79, "timestamp": "01:11:24", "text": "确定了受众群体。是的。感谢"}, {"type": "subtitle", "time": 4286.95, "timestamp": "01:11:26", "text": "你。这就是我想分享的。"}, {"type": "subtitle", "time": 4289.91, "timestamp": "01:11:29", "text": "是的。"}, {"type": "subtitle", "time": 4291.83, "timestamp": "01:11:31", "text": "好的。你知道吗？看起来像一些"}, {"type": "subtitle", "time": 4293.91, "timestamp": "01:11:33", "text": "简单的平台跳跃。你知道，就像什么"}, {"type": "subtitle", "time": 4296.79, "timestamp": "01:11:36", "text": "你会在《真的吗？》中看到吗？你受伤了吗？是的。"}, {"type": "subtitle", "time": 4298.149, "timestamp": "01:11:38", "text": "那看起来应该是……"}, {"type": "subtitle", "time": 4300.31, "timestamp": "01:11:40", "text": "一直都很顺利。我的天哪。我状态下滑了。我是"}, {"type": "subtitle", "time": 4302.229, "timestamp": "01:11:42", "text": "滑倒。我状态下滑了。滑倒。我是"}, {"type": "subtitle", "time": 4308.95, "timestamp": "01:11:48", "text": "你知道，听着，你不会……"}, {"type": "subtitle", "time": 4310.709, "timestamp": "01:11:50", "text": "如果你能做到，就让我印象深刻吧。"}, {"type": "subtitle", "time": 4313.35, "timestamp": "01:11:53", "text": "通过这种方式。很简单。我"}, {"type": "subtitle", "time": 4316.87, "timestamp": "01:11:56", "text": "安装心脏起搏器。被电一下就能要了我的命。"}, {"type": "subtitle", "time": 4319.669, "timestamp": "01:11:59", "text": "我装有心脏起搏器。你是什​​么意思？"}]
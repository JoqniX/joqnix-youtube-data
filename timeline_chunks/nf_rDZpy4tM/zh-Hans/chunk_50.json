[{"type": "subtitle", "time": 3000.309, "timestamp": "00:50:00", "text": "我不知道我已经跟他说过多少遍了"}, {"type": "subtitle", "time": 3004.15, "timestamp": "00:50:04", "text": "新兵。耽误。"}, {"type": "subtitle", "time": 3006.87, "timestamp": "00:50:06", "text": "你命令我们杀了他们。土豆。我是"}, {"type": "subtitle", "time": 3009.51, "timestamp": "00:50:09", "text": "只是个笨门卫。等等，你真的这么做了？"}, {"type": "subtitle", "time": 3012.79, "timestamp": "00:50:12", "text": "发布时像这样：哦，是的。现在你发帖了"}, {"type": "subtitle", "time": 3014.39, "timestamp": "00:50:14", "text": "好的，好的，好的。我当时就想，等等，你"}, {"type": "subtitle", "time": 3017.67, "timestamp": "00:50:17", "text": "上次发布。等等，你是什么时候发的？"}, {"type": "subtitle", "time": 3020.23, "timestamp": "00:50:20", "text": "更早一些？等等，你之前发过帖子，但是"}, {"type": "subtitle", "time": 3021.309, "timestamp": "00:50:21", "text": "发生了什么"}, {"type": "subtitle", "time": 3024.39, "timestamp": "00:50:24", "text": "它是如何变化的？我正要问"}, {"type": "subtitle", "time": 3032.71, "timestamp": "00:50:32", "text": "嘿，祝你在变装小镇玩得开心！是"}, {"type": "subtitle", "time": 3034.95, "timestamp": "00:50:34", "text": "小心。那里有很多G3的选手，"}, {"type": "subtitle", "time": 3038.71, "timestamp": "00:50:38", "text": "他们有点动不动就开枪。滚开。"}, {"type": "subtitle", "time": 3041.51, "timestamp": "00:50:41", "text": "哦，你要去德拉格镇吗？它是"}, {"type": "subtitle", "time": 3044.549, "timestamp": "00:50:44", "text": "比老城区酷多了。我老城是一个"}, {"type": "subtitle", "time": 3046.069, "timestamp": "00:50:46", "text": "钻孔集尘桶。我告诉你，"}, {"type": "subtitle", "time": 3049.27, "timestamp": "00:50:49", "text": "很多。我讨厌老城区。我只是站着"}, {"type": "subtitle", "time": 3050.87, "timestamp": "00:50:50", "text": "这里到处都在告诉人们有多少"}, {"type": "subtitle", "time": 3052.87, "timestamp": "00:50:52", "text": "老城区糟透了。这就是我做的事。那是"}, {"type": "subtitle", "time": 3054.79, "timestamp": "00:50:54", "text": "我的天哪，这太酷了。这就是我的意思。"}, {"type": "subtitle", "time": 3057.91, "timestamp": "00:50:57", "text": "让我兴奋不已。你为什么没有"}]
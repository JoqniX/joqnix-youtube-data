[{"type": "subtitle", "time": 11880.99, "timestamp": "03:18:00", "text": "拥有最受欢迎艺人的经纪公司"}, {"type": "subtitle", "time": 11885.07, "timestamp": "03:18:05", "text": "我忘了它的名字了，但是"}, {"type": "subtitle", "time": 11892.03, "timestamp": "03:18:12", "text": "呃，但是"}, {"type": "subtitle", "time": 11895.469, "timestamp": "03:18:15", "text": "是的，我喜欢。"}, {"type": "subtitle", "time": 11899.59, "timestamp": "03:18:19", "text": "嗯，我喜欢。有些人倾向于"}, {"type": "subtitle", "time": 11902.19, "timestamp": "03:18:22", "text": "去他们自己"}, {"type": "subtitle", "time": 11905.349, "timestamp": "03:18:25", "text": "是的。 United Talent.com。然后"}, {"type": "subtitle", "time": 11907.83, "timestamp": "03:18:27", "text": "联合人才公司是其中之一。它是"}, {"type": "subtitle", "time": 11910.11, "timestamp": "03:18:30", "text": "就像一种天赋"}, {"type": "subtitle", "time": 11912.349, "timestamp": "03:18:32", "text": "正在寻找。是的。是的。"}, {"type": "subtitle", "time": 11915.429, "timestamp": "03:18:35", "text": "是的。有点像个代理机构。不，就像"}, {"type": "subtitle", "time": 11919.389, "timestamp": "03:18:39", "text": "感觉就像他们给你配了个私人经理。"}, {"type": "subtitle", "time": 11923.83, "timestamp": "03:18:43", "text": "比如为了自己的利益而做的事情之类的"}, {"type": "subtitle", "time": 11926.59, "timestamp": "03:18:46", "text": "对，UTA，那就是UTA"}, {"type": "subtitle", "time": 11929.59, "timestamp": "03:18:49", "text": "做。所以，就像大多数音乐剧一样"}, {"type": "subtitle", "time": 11932.469, "timestamp": "03:18:52", "text": "艺术家拥有这种能力，所以人们可以接触到他们。"}, {"type": "subtitle", "time": 11933.91, "timestamp": "03:18:53", "text": "品牌可以外出并合作"}, {"type": "subtitle", "time": 11936.71, "timestamp": "03:18:56", "text": "通过协作"}, {"type": "subtitle", "time": 11939.07, "timestamp": "03:18:59", "text": "然后他们联系了该机构。"}]
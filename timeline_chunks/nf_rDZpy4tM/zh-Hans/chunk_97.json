[{"type": "subtitle", "time": 5831.43, "timestamp": "01:37:11", "text": "它。所以，这个存储库在科学上"}, {"type": "subtitle", "time": 5834.39, "timestamp": "01:37:14", "text": "准确的。哦，太棒了。惊人的。你做到了"}, {"type": "subtitle", "time": 5836.95, "timestamp": "01:37:16", "text": "又来了。道格拉斯的办公室离这里不远。"}, {"type": "subtitle", "time": 5839.109, "timestamp": "01:37:19", "text": "从这里开始。我先走一步。我看看。"}, {"type": "subtitle", "time": 5841.669, "timestamp": "01:37:21", "text": "你在那里。嘿，祝你好运，小家伙。"}, {"type": "subtitle", "time": 5844.39, "timestamp": "01:37:24", "text": "好吧，我真的很喜欢那个人。在"}, {"type": "subtitle", "time": 5846.31, "timestamp": "01:37:26", "text": "我希望，在理想的世界里，道格拉斯"}, {"type": "subtitle", "time": 5849.109, "timestamp": "01:37:29", "text": "不只是把他打死。"}, {"type": "subtitle", "time": 5854.709, "timestamp": "01:37:34", "text": "这是一项紧急通知。这"}, {"type": "subtitle", "time": 5856.47, "timestamp": "01:37:36", "text": "该行业已被暂时指定"}, {"type": "subtitle", "time": 5877.35, "timestamp": "01:37:57", "text": "看来我们取得了相当大的成就"}, {"type": "subtitle", "time": 5879.43, "timestamp": "01:37:59", "text": "印象。"}]
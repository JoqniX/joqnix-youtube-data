[{"type": "subtitle", "time": 14881.15, "timestamp": "04:08:01", "text": "已发布。什么？希望我没迟到。我是"}, {"type": "subtitle", "time": 14884.55, "timestamp": "04:08:04", "text": "为什么？是的。大家最近怎么样？"}, {"type": "subtitle", "time": 14888.71, "timestamp": "04:08:08", "text": "我太兴奋了！呀，掉下来。是的。快点。"}, {"type": "subtitle", "time": 14891.469, "timestamp": "04:08:11", "text": "来，来。我是否"}, {"type": "subtitle", "time": 14895.07, "timestamp": "04:08:15", "text": "鸣叫？我怀疑我"}, {"type": "subtitle", "time": 14896.91, "timestamp": "04:08:16", "text": "已发推文。"}, {"type": "subtitle", "time": 14898.83, "timestamp": "04:08:18", "text": "哦"}, {"type": "subtitle", "time": 14902.229, "timestamp": "04:08:22", "text": "天哪，我太兴奋了。所以，我们要……"}, {"type": "subtitle", "time": 14904.15, "timestamp": "04:08:24", "text": "大家一起玩游戏吧。我们将要"}, {"type": "subtitle", "time": 14905.67, "timestamp": "04:08:25", "text": "玩游戏。我们将要……"}, {"type": "subtitle", "time": 14914.15, "timestamp": "04:08:34", "text": "派对。我们将要 我们将要"}, {"type": "subtitle", "time": 14917.83, "timestamp": "04:08:37", "text": "我们会玩得很开心。好的。"}, {"type": "subtitle", "time": 14921.55, "timestamp": "04:08:41", "text": "我很兴奋。我很兴奋。我是"}, {"type": "subtitle", "time": 14924.71, "timestamp": "04:08:44", "text": "兴奋的。等待。呃，让我发条推特。"}]
[{"type": "subtitle", "time": 15120.349, "timestamp": "04:12:00", "text": "我失去了希望"}, {"type": "subtitle", "time": 15132.55, "timestamp": "04:12:12", "text": "它。大家都在玩。我当时就想，"}, {"type": "subtitle", "time": 15135.189, "timestamp": "04:12:15", "text": "稍等片刻。"}, {"type": "subtitle", "time": 15137.189, "timestamp": "04:12:17", "text": "敏感的 Pew pew。我忘了这件事"}, {"type": "subtitle", "time": 15140.55, "timestamp": "04:12:20", "text": "游戏里没有战斗，我的意思是打架。"}, {"type": "subtitle", "time": 15142.349, "timestamp": "04:12:22", "text": "祝你玩得开心。"}, {"type": "subtitle", "time": 15145.75, "timestamp": "04:12:25", "text": "知道。但是，你看，罗赞正在做什么"}, {"type": "subtitle", "time": 15148.51, "timestamp": "04:12:28", "text": "第一场 Boss 战，也就是教学关卡的 Boss 战"}, {"type": "subtitle", "time": 15151.51, "timestamp": "04:12:31", "text": "采取不同的战斗方式。不，他们选择的是呃"}, {"type": "subtitle", "time": 15154.51, "timestamp": "04:12:34", "text": "它们都在"}, {"type": "subtitle", "time": 15159.11, "timestamp": "04:12:39", "text": "海。我真的需要像这样等吗？"}, {"type": "subtitle", "time": 15164.71, "timestamp": "04:12:44", "text": "我需要排队等候才能进去吗？"}, {"type": "subtitle", "time": 15166.75, "timestamp": "04:12:46", "text": "我必须喜欢吗？"}, {"type": "subtitle", "time": 15170.91, "timestamp": "04:12:50", "text": "等待？我进不去。"}, {"type": "subtitle", "time": 15175.63, "timestamp": "04:12:55", "text": "什么？等待。哦，我刚从你那儿查了一下。"}, {"type": "subtitle", "time": 15178.83, "timestamp": "04:12:58", "text": "如果你 如果你 如果你"}]
[{"type": "subtitle", "time": 10020.87, "timestamp": "02:47:00", "text": "说实话，我知道我原本期待的是什么。"}, {"type": "subtitle", "time": 10023.75, "timestamp": "02:47:03", "text": "这里。"}, {"type": "subtitle", "time": 10025.59, "timestamp": "02:47:05", "text": "嘿，晚安，伙伴。我只是要走了"}, {"type": "subtitle", "time": 10027.19, "timestamp": "02:47:07", "text": "就坐在这里，看着你坠落"}, {"type": "subtitle", "time": 10029.269, "timestamp": "02:47:09", "text": "睡着了。很高兴我们相遇。你"}, {"type": "subtitle", "time": 10031.11, "timestamp": "02:47:11", "text": "我知道，我觉得我们正在做"}, {"type": "subtitle", "time": 10032.95, "timestamp": "02:47:12", "text": "这里面有些东西很神奇。那该有多酷啊！"}, {"type": "subtitle", "time": 10035.429, "timestamp": "02:47:15", "text": "如果我们真的阻止了G3峰会呢？"}, {"type": "subtitle", "time": 10038.23, "timestamp": "02:47:18", "text": "对不起。对不起。我，我太兴奋了。"}, {"type": "subtitle", "time": 10040.309, "timestamp": "02:47:20", "text": "我闭嘴。我们去睡觉吧"}, {"type": "subtitle", "time": 10041.59, "timestamp": "02:47:21", "text": "很快了。你知道，我们会"}, {"type": "subtitle", "time": 10043.51, "timestamp": "02:47:23", "text": "乘坐喷气背包穿越整个太空。对不起。"}, {"type": "subtitle", "time": 10045.03, "timestamp": "02:47:25", "text": "我声音太大了。你很可能"}, {"type": "subtitle", "time": 10047.44, "timestamp": "02:47:27", "text": "想办法让你入睡。"}, {"type": "subtitle", "time": 10050.23, "timestamp": "02:47:30", "text": "[音乐]"}, {"type": "subtitle", "time": 10057.23, "timestamp": "02:47:37", "text": "天。哦，他们喜欢时光"}, {"type": "subtitle", "time": 10065.87, "timestamp": "02:47:45", "text": "等待。什么是"}, {"type": "subtitle", "time": 10069.309, "timestamp": "02:47:49", "text": "这？我们是在做梦吗？"}, {"type": "subtitle", "time": 10071.51, "timestamp": "02:47:51", "text": "某物？好的，伙伴。我们开始吧"}, {"type": "subtitle", "time": 10073.59, "timestamp": "02:47:53", "text": "试试这款喷气背包吧。你可以吗"}, {"type": "subtitle", "time": 10076.15, "timestamp": "02:47:56", "text": "你能越过那个缝隙吗？"}, {"type": "subtitle", "time": 10077.87, "timestamp": "02:47:57", "text": "我的天哪。这"}]
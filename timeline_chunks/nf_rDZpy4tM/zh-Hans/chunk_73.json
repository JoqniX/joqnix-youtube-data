[{"type": "subtitle", "time": 4382.11, "timestamp": "01:13:02", "text": "你打算怎么做？"}, {"type": "subtitle", "time": 4385.11, "timestamp": "01:13:05", "text": "人们会发现你的存在，然后你"}, {"type": "subtitle", "time": 4387.11, "timestamp": "01:13:07", "text": "循序渐进地建立你的家庭观众群。"}, {"type": "subtitle", "time": 4389.11, "timestamp": "01:13:09", "text": "对，没错。"}, {"type": "subtitle", "time": 4391.149, "timestamp": "01:13:11", "text": "谢谢你避开了这件事，但是"}, {"type": "subtitle", "time": 4406.31, "timestamp": "01:13:26", "text": "感谢各位前来拜谒我的神。好的，我们开始吧"}, {"type": "subtitle", "time": 4408.07, "timestamp": "01:13:28", "text": "别再搞这些招聘的破事了。"}, {"type": "subtitle", "time": 4417.8, "timestamp": "01:13:37", "text": "哦，我的"}, {"type": "subtitle", "time": 4429.189, "timestamp": "01:13:49", "text": "上帝。妈的。好的。好了，就这样吧。"}, {"type": "subtitle", "time": 4431.43, "timestamp": "01:13:51", "text": "那坨盗版糊状物。我想那并没有。"}, {"type": "subtitle", "time": 4435.03, "timestamp": "01:13:55", "text": "持续时间很长。"}, {"type": "subtitle", "time": 4438.31, "timestamp": "01:13:58", "text": "我的天啊。你好。感谢上帝你来了。"}]
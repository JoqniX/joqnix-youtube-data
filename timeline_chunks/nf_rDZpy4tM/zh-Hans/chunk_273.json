[{"type": "subtitle", "time": 16381.11, "timestamp": "04:33:01", "text": "过来。"}, {"type": "subtitle", "time": 16383.15, "timestamp": "04:33:03", "text": "耶，我"}, {"type": "subtitle", "time": 16387.349, "timestamp": "04:33:07", "text": "被杀。谐振器可以获得音乐会"}, {"type": "subtitle", "time": 16389.75, "timestamp": "04:33:09", "text": "在造成伤害或执行动作时消耗能量"}, {"type": "subtitle", "time": 16392.869, "timestamp": "04:33:12", "text": "战斗中的闪避。当协奏曲能量"}, {"type": "subtitle", "time": 16394.869, "timestamp": "04:33:14", "text": "如果已满，其他共振器图标将"}, {"type": "subtitle", "time": 16397.269, "timestamp": "04:33:17", "text": "焕然一新。好的，明白了。所以，就像"}, {"type": "subtitle", "time": 16399.51, "timestamp": "04:33:19", "text": "香港第三套体系之类的东西。"}, {"type": "subtitle", "time": 16400.429, "timestamp": "04:33:20", "text": "得到"}, {"type": "subtitle", "time": 16403.75, "timestamp": "04:33:23", "text": "它。所以，你的能量已经充满，可以触发"}, {"type": "subtitle", "time": 16405.75, "timestamp": "04:33:25", "text": "退出谐振器结尾技巧和"}, {"type": "subtitle", "time": 16408.15, "timestamp": "04:33:28", "text": "消耗所有保守能量来触发"}, {"type": "subtitle", "time": 16410.47, "timestamp": "04:33:30", "text": "即将到来的共振器的介绍技能。"}, {"type": "subtitle", "time": 16412.709, "timestamp": "04:33:32", "text": "每个共鸣器都有独特的结尾和"}, {"type": "subtitle", "time": 16414.349, "timestamp": "04:33:34", "text": "入门技能。"}, {"type": "subtitle", "time": 16421.269, "timestamp": "04:33:41", "text": "不错的配音演员，但是Twitch有点卡顿。等等，这是Twitch吗？"}, {"type": "subtitle", "time": 16423.349, "timestamp": "04:33:43", "text": "服务器是不是不堪重负导致卡顿？"}, {"type": "subtitle", "time": 16426.15, "timestamp": "04:33:46", "text": "所有人的直播。是你奋力拼搏。"}, {"type": "subtitle", "time": 16428.709, "timestamp": "04:33:48", "text": "出色地。等等，我甚至都没注册Twitch。"}, {"type": "subtitle", "time": 16431.189, "timestamp": "04:33:51", "text": "视频流卡顿。杨就这么冲了过去。"}, {"type": "subtitle", "time": 16432.83, "timestamp": "04:33:52", "text": "像保护你一样"}, {"type": "subtitle", "time": 16436.31, "timestamp": "04:33:56", "text": "总之，阴阳当时正在试图掩护"}, {"type": "subtitle", "time": 16439.189, "timestamp": "04:33:59", "text": "你，然后砰的一声，Tessa Discord 就出现了。"}]
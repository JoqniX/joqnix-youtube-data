[{"type": "subtitle", "time": 12900.53, "timestamp": "03:35:00", "text": "难的。汤姆在偷懒。"}, {"type": "subtitle", "time": 12903.469, "timestamp": "03:35:03", "text": "[音乐]"}, {"type": "subtitle", "time": 12906.87, "timestamp": "03:35:06", "text": "嗯，某种程度上是这样。呃，我不知道。是的，"}, {"type": "subtitle", "time": 12909.229, "timestamp": "03:35:09", "text": "从某种程度上来说，你不觉得这很伤人吗？"}, {"type": "subtitle", "time": 12914.07, "timestamp": "03:35:14", "text": "难道你不讨厌那些不停地……的人吗？"}, {"type": "subtitle", "time": 12917.07, "timestamp": "03:35:17", "text": "前途光明，前途光明，却从未"}, {"type": "subtitle", "time": 12918.99, "timestamp": "03:35:18", "text": "绝不"}, {"type": "subtitle", "time": 12927.269, "timestamp": "03:35:27", "text": "从来没有，该怎么称呼它呢？是的。"}, {"type": "subtitle", "time": 12929.63, "timestamp": "03:35:29", "text": "承诺和承诺我从未"}, {"type": "subtitle", "time": 12933.91, "timestamp": "03:35:33", "text": "就像做这件事一样。我有点担心我是否"}, {"type": "subtitle", "time": 12936.19, "timestamp": "03:35:36", "text": "做同样的事情。我觉得我"}, {"type": "subtitle", "time": 12938.269, "timestamp": "03:35:38", "text": "是，"}, {"type": "subtitle", "time": 12941.51, "timestamp": "03:35:41", "text": "但我会尽力避免那样做。我"}, {"type": "subtitle", "time": 12950.429, "timestamp": "03:35:50", "text": "知道。"}]
[{"type": "subtitle", "time": 12060.63, "timestamp": "03:21:00", "text": "就像你甚至可以接手这个案子一样。"}, {"type": "subtitle", "time": 12064.07, "timestamp": "03:21:04", "text": "关于人工智能艺术，大多数人的艺术作品都是"}, {"type": "subtitle", "time": 12066.309, "timestamp": "03:21:06", "text": "就像你知道的那样，混在一起"}, {"type": "subtitle", "time": 12069.19, "timestamp": "03:21:09", "text": "自动生成，它是……的一部分"}, {"type": "subtitle", "time": 12071.429, "timestamp": "03:21:11", "text": "每个人的风格，他们合作过的艺术家。"}, {"type": "subtitle", "time": 12074.15, "timestamp": "03:21:14", "text": "继续，还有东西，就在他们自己的原创作品里"}, {"type": "subtitle", "time": 12075.99, "timestamp": "03:21:15", "text": "绘画风格，一切都变得如此。"}, {"type": "subtitle", "time": 12080.11, "timestamp": "03:21:20", "text": "合并成类似自动化人工智能的东西"}, {"type": "subtitle", "time": 12084.63, "timestamp": "03:21:24", "text": "现在，从某种程度上来说，这很伤人，但同时你……"}, {"type": "subtitle", "time": 12089.03, "timestamp": "03:21:29", "text": "即使人工智能是……，也必须继续做下去。"}, {"type": "subtitle", "time": 12092.19, "timestamp": "03:21:32", "text": "那并不意味着即使那样也是真的。"}, {"type": "subtitle", "time": 12095.67, "timestamp": "03:21:35", "text": "一些客户会离开，这会让你损失一些客户。"}, {"type": "subtitle", "time": 12097.79, "timestamp": "03:21:37", "text": "做艺术，但是"}, {"type": "subtitle", "time": 12100.63, "timestamp": "03:21:40", "text": "但你依然忠于自己，你会"}, {"type": "subtitle", "time": 12103.75, "timestamp": "03:21:43", "text": "继续做你正在做的事"}, {"type": "subtitle", "time": 12105.51, "timestamp": "03:21:45", "text": "你一直以来所热衷的事情"}, {"type": "subtitle", "time": 12108.71, "timestamp": "03:21:48", "text": "年复一年，就是这样。所以要继续"}, {"type": "subtitle", "time": 12114.429, "timestamp": "03:21:54", "text": "刷子。一样"}]
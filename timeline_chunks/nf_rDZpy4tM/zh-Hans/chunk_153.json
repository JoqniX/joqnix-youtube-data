[{"type": "subtitle", "time": 9203.83, "timestamp": "02:33:23", "text": "再见。是的。是的。这很好。哦，我的"}, {"type": "subtitle", "time": 9205.71, "timestamp": "02:33:25", "text": "上帝。我就是这样，我就是这样"}, {"type": "subtitle", "time": 9207.55, "timestamp": "02:33:27", "text": "天才。"}, {"type": "subtitle", "time": 9222.51, "timestamp": "02:33:42", "text": "嘿，"}, {"type": "subtitle", "time": 9226.389, "timestamp": "02:33:46", "text": "孩子。干得好。但是，呃，还有……"}, {"type": "subtitle", "time": 9228.55, "timestamp": "02:33:48", "text": "你应该看看。看看"}, {"type": "subtitle", "time": 9231.99, "timestamp": "02:33:51", "text": "交出赏金之后。"}, {"type": "subtitle", "time": 9234.79, "timestamp": "02:33:54", "text": "好的。好的。过来。"}, {"type": "subtitle", "time": 9237.03, "timestamp": "02:33:57", "text": "发生了什么？你为什么在看这个？"}, {"type": "subtitle", "time": 9239.91, "timestamp": "02:33:59", "text": "场景？你好，布林市的市民。那是"}]
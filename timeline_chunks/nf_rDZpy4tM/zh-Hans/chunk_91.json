[{"type": "subtitle", "time": 5462.629, "timestamp": "01:31:02", "text": "某物。呃，希望我没打破什么规则。"}, {"type": "subtitle", "time": 5464.79, "timestamp": "01:31:04", "text": "主播提到了这一点。我的意思是，它是"}, {"type": "subtitle", "time": 5466.79, "timestamp": "01:31:06", "text": "好吧，因为我提到了星空景观，对吧？"}, {"type": "subtitle", "time": 5469.35, "timestamp": "01:31:09", "text": "还有虚拟的之类的。所以，没问题。"}, {"type": "subtitle", "time": 5470.87, "timestamp": "01:31:10", "text": "没关系。美好的。不用担心。不"}, {"type": "subtitle", "time": 5472.59, "timestamp": "01:31:12", "text": "担心。不用担心。"}, {"type": "subtitle", "time": 5476.07, "timestamp": "01:31:16", "text": "但是，是的，我见过不少……"}, {"type": "subtitle", "time": 5478.229, "timestamp": "01:31:18", "text": "有人提到了其他主播"}, {"type": "subtitle", "time": 5480.55, "timestamp": "01:31:20", "text": "虽然我没有提及他们。记住"}, {"type": "subtitle", "time": 5482.11, "timestamp": "01:31:22", "text": "那些"}, {"type": "subtitle", "time": 5485.189, "timestamp": "01:31:25", "text": "这些都违反了直播规则。"}, {"type": "subtitle", "time": 5488.229, "timestamp": "01:31:28", "text": "我的意思是，如果你想知道为什么它是……"}, {"type": "subtitle", "time": 5490.87, "timestamp": "01:31:30", "text": "为什么不能提及其他事项"}, {"type": "subtitle", "time": 5493.87, "timestamp": "01:31:33", "text": "主播们，我无法解释这一点。"}, {"type": "subtitle", "time": 5496.149, "timestamp": "01:31:36", "text": "一部分，而且我认为还有视频。"}, {"type": "subtitle", "time": 5498.629, "timestamp": "01:31:38", "text": "没错，我确实看过一些视频。"}, {"type": "subtitle", "time": 5500.55, "timestamp": "01:31:40", "text": "我很高兴人们身体都很好。"}, {"type": "subtitle", "time": 5502.47, "timestamp": "01:31:42", "text": "但就像在管道里的人一样"}, {"type": "subtitle", "time": 5505.51, "timestamp": "01:31:45", "text": "实际上，我还制作了相关视频来讲解原因。"}, {"type": "subtitle", "time": 5507.99, "timestamp": "01:31:47", "text": "不方便提及其他事情"}, {"type": "subtitle", "time": 5509.59, "timestamp": "01:31:49", "text": "如果主播不说话，那就说明主播们都沉默了。"}, {"type": "subtitle", "time": 5513.03, "timestamp": "01:31:53", "text": "关于它，就像顶部和这个聊天"}, {"type": "subtitle", "time": 5517.03, "timestamp": "01:31:57", "text": "偏离主题，我想我是对的"}, {"type": "subtitle", "time": 5519.669, "timestamp": "01:31:59", "text": "团队中不同的主播"}]
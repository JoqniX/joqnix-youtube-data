[{"type": "subtitle", "time": 9301.99, "timestamp": "02:35:01", "text": "那里。克拉格在等你。"}, {"type": "subtitle", "time": 9305.429, "timestamp": "02:35:05", "text": "我们大概会从那里经过。嘿，"}, {"type": "subtitle", "time": 9307.67, "timestamp": "02:35:07", "text": "你到底要去哪儿？去和……谈谈"}, {"type": "subtitle", "time": 9311.27, "timestamp": "02:35:11", "text": "呃，耶稣。我得去哦我的天哪。"}, {"type": "subtitle", "time": 9316.16, "timestamp": "02:35:16", "text": "快点。我当时想买东西。"}, {"type": "subtitle", "time": 9322.23, "timestamp": "02:35:22", "text": "非常感谢你的到来，赏金"}, {"type": "subtitle", "time": 9324.79, "timestamp": "02:35:24", "text": "猎人。没问题。是，是，是，是"}, {"type": "subtitle", "time": 9327.11, "timestamp": "02:35:27", "text": "很高兴见到您，先生。听着，我这就切到"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "追逐。我需要你的帮助。你是"}, {"type": "subtitle", "time": 9331.83, "timestamp": "02:35:31", "text": "人类，对吧？我的人调查过了。"}, {"type": "subtitle", "time": 9334.15, "timestamp": "02:35:34", "text": "对不起。你从G3的攻击中幸存了下来"}, {"type": "subtitle", "time": 9336.07, "timestamp": "02:35:36", "text": "你的家乡星球是地球，对吧？嗯，我们"}, {"type": "subtitle", "time": 9338.63, "timestamp": "02:35:38", "text": "我们是加塔利亚人，但是，呃，当然。"}, {"type": "subtitle", "time": 9340.55, "timestamp": "02:35:40", "text": "对不起。我了解你的困境。"}, {"type": "subtitle", "time": 9342.469, "timestamp": "02:35:42", "text": "出色地。发生这样的事真是太悲惨了。"}, {"type": "subtitle", "time": 9344.71, "timestamp": "02:35:44", "text": "在 Gatlas 上。你这样做很有道理。"}, {"type": "subtitle", "time": 9346.79, "timestamp": "02:35:46", "text": "人类也会加入进来。但"}, {"type": "subtitle", "time": 9349.03, "timestamp": "02:35:49", "text": "或许你还能再容纳一位盟友。"}, {"type": "subtitle", "time": 9350.87, "timestamp": "02:35:50", "text": "也一样。但是，你可是个大人物啊！"}, {"type": "subtitle", "time": 9352.71, "timestamp": "02:35:52", "text": "政客们，我们都在外面，你们"}, {"type": "subtitle", "time": 9354.389, "timestamp": "02:35:54", "text": "知道，就是杀人。比如，不会吧"}, {"type": "subtitle", "time": 9356.63, "timestamp": "02:35:56", "text": "看起来很糟糕吗？正因如此，我"}, {"type": "subtitle", "time": 9358.55, "timestamp": "02:35:58", "text": "需要你的帮助。我真是太奇怪了"}]
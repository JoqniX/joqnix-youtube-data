[{"type": "subtitle", "time": 8764.51, "timestamp": "02:26:04", "text": "哦"}, {"type": "subtitle", "time": 8768.469, "timestamp": "02:26:08", "text": "男生。我究竟来自哪里？好的。"}, {"type": "subtitle", "time": 8770.309, "timestamp": "02:26:10", "text": "这个区域是“母亲反对运动”的一部分。"}, {"type": "subtitle", "time": 8772.469, "timestamp": "02:26:12", "text": "暴力条约。所以，没有暴力"}, {"type": "subtitle", "time": 8775.27, "timestamp": "02:26:15", "text": "允许。"}, {"type": "subtitle", "time": 8777.59, "timestamp": "02:26:17", "text": "[音乐]"}, {"type": "subtitle", "time": 8787.389, "timestamp": "02:26:27", "text": "曾是？在哪里？"}, {"type": "subtitle", "time": 8804.71, "timestamp": "02:26:44", "text": "不。剪裁。我的天哪，我剪线了"}, {"type": "subtitle", "time": 8806.83, "timestamp": "02:26:46", "text": "再次进入"}]
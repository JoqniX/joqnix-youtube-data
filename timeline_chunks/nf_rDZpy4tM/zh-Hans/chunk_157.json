[{"type": "subtitle", "time": 9421.19, "timestamp": "02:37:01", "text": "从技术上讲，人类本身就是一种药物。我"}, {"type": "subtitle", "time": 9423.03, "timestamp": "02:37:03", "text": "不能有危险的、有感知能力的药物"}, {"type": "subtitle", "time": 9424.63, "timestamp": "02:37:04", "text": "我的子民们，你们不能这样做。"}, {"type": "subtitle", "time": 9426.15, "timestamp": "02:37:06", "text": "让你的人民被俘虏"}, {"type": "subtitle", "time": 9428.15, "timestamp": "02:37:08", "text": "已消耗。这解决了我们俩的问题。"}, {"type": "subtitle", "time": 9430.309, "timestamp": "02:37:10", "text": "问题。所以，你打算继续"}, {"type": "subtitle", "time": 9433.55, "timestamp": "02:37:13", "text": "把G3拿出来？当然。"}, {"type": "subtitle", "time": 9437.19, "timestamp": "02:37:17", "text": "那么，衷心感谢你。你们人类"}, {"type": "subtitle", "time": 9439.51, "timestamp": "02:37:19", "text": "加特隆斯，你们两位都非常高尚。"}, {"type": "subtitle", "time": 9442.23, "timestamp": "02:37:22", "text": "物种。这对我意义重大。我已经"}, {"type": "subtitle", "time": 9444.15, "timestamp": "02:37:24", "text": "我毕生致力于运用我的权力"}, {"type": "subtitle", "time": 9446.07, "timestamp": "02:37:26", "text": "帮助有需要的人，但即使是我也有"}, {"type": "subtitle", "time": 9448.15, "timestamp": "02:37:28", "text": "我的极限。我很高兴身边有个人陪伴。"}, {"type": "subtitle", "time": 9450.309, "timestamp": "02:37:30", "text": "就像你可以依靠一样。作为象征"}, {"type": "subtitle", "time": 9452.389, "timestamp": "02:37:32", "text": "谢谢，我的团队会负责所有事宜。"}, {"type": "subtitle", "time": 9454.95, "timestamp": "02:37:34", "text": "我们在G3上找到的情报直接发送给您"}, {"type": "subtitle", "time": 9456.87, "timestamp": "02:37:36", "text": "驯兽师，泽鲁西安先生。我们已经"}, {"type": "subtitle", "time": 9459.11, "timestamp": "02:37:39", "text": "我们把所有东西都寄给了他。其余部分是"}, {"type": "subtitle", "time": 9461.59, "timestamp": "02:37:41", "text": "就在你手中。非常感谢您，先生。"}, {"type": "subtitle", "time": 9463.67, "timestamp": "02:37:43", "text": "纳格曼。这就是我要告诉你的全部内容。感觉"}, {"type": "subtitle", "time": 9465.27, "timestamp": "02:37:45", "text": "您可以随意停留，想待多久就待多久。这"}, {"type": "subtitle", "time": 9468.07, "timestamp": "02:37:48", "text": "景色美得令人窒息。"}, {"type": "subtitle", "time": 9470.55, "timestamp": "02:37:50", "text": "是的，景色美得令人窒息。你呢"}, {"type": "subtitle", "time": 9477.59, "timestamp": "02:37:57", "text": "哦。呃，您可以随意待多久就待多久。"}]
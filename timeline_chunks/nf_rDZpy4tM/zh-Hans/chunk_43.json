[{"type": "subtitle", "time": 2582.109, "timestamp": "00:43:02", "text": "哇。我坚持了下来"}, {"type": "subtitle", "time": 2584.589, "timestamp": "00:43:04", "text": "我的没错"}, {"type": "subtitle", "time": 2593.109, "timestamp": "00:43:13", "text": "我不知道他发生了什么事。"}, {"type": "subtitle", "time": 2607.51, "timestamp": "00:43:27", "text": "我认为当我们进行检查点操作时，或者"}, {"type": "subtitle", "time": 2609.71, "timestamp": "00:43:29", "text": "将会是某种东西"}, {"type": "subtitle", "time": 2621.55, "timestamp": "00:43:41", "text": "知道。赏金大师。"}, {"type": "subtitle", "time": 2633.349, "timestamp": "00:43:53", "text": "他们。不要被敌人击中。那是"}, {"type": "subtitle", "time": 2635.55, "timestamp": "00:43:55", "text": "真的很难，"}, {"type": "subtitle", "time": 2637.05, "timestamp": "00:43:57", "text": "也。"}]
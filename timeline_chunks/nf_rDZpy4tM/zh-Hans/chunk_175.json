[{"type": "subtitle", "time": 10503.269, "timestamp": "02:55:03", "text": "可供人类食用。不，他其实是"}, {"type": "subtitle", "time": 10505.59, "timestamp": "02:55:05", "text": "甜的。别担心我。你可以"}, {"type": "subtitle", "time": 10509.03, "timestamp": "02:55:09", "text": "集中火力消灭太空黑手党"}, {"type": "subtitle", "time": 10510.87, "timestamp": "02:55:10", "text": "任何。"}, {"type": "subtitle", "time": 10512.87, "timestamp": "02:55:12", "text": "你好。我们呢？你有吗？"}, {"type": "subtitle", "time": 10515.55, "timestamp": "02:55:15", "text": "对话？"}, {"type": "subtitle", "time": 10519.07, "timestamp": "02:55:19", "text": "不看这部电影。看看"}, {"type": "subtitle", "time": 10527.56, "timestamp": "02:55:27", "text": "N. 这是什么电影？我就像"}, {"type": "subtitle", "time": 10536.64, "timestamp": "02:55:36", "text": "好奇的。你为什么看着我？"}, {"type": "subtitle", "time": 10544.11, "timestamp": "02:55:44", "text": "[音乐]"}, {"type": "subtitle", "time": 10546.62, "timestamp": "02:55:46", "text": "巴酱。"}, {"type": "subtitle", "time": 10555.349, "timestamp": "02:55:55", "text": "好的，我们这边就到此为止吧。"}, {"type": "subtitle", "time": 10558.07, "timestamp": "02:55:58", "text": "我的天哪，我们会站起来的。我一直"}]
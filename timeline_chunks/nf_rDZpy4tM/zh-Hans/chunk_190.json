[{"type": "subtitle", "time": 11402.15, "timestamp": "03:10:02", "text": "喜欢那样是因为你知道当"}, {"type": "subtitle", "time": 11404.07, "timestamp": "03:10:04", "text": "你活跃在推特上或者喜欢当"}, {"type": "subtitle", "time": 11406.15, "timestamp": "03:10:06", "text": "你在推特上看到很多"}, {"type": "subtitle", "time": 11410.23, "timestamp": "03:10:10", "text": "各种各样的事情，所有的戏剧性事件，所有的一切。"}, {"type": "subtitle", "time": 11412.91, "timestamp": "03:10:12", "text": "Vtubing中的戏剧"}, {"type": "subtitle", "time": 11416.03, "timestamp": "03:10:16", "text": "文化。这让我想起了"}, {"type": "subtitle", "time": 11419.269, "timestamp": "03:10:19", "text": "呃，一个曾经是虚拟主播的人，后来……"}, {"type": "subtitle", "time": 11422.75, "timestamp": "03:10:22", "text": "因有类似情况而被点名批评"}, {"type": "subtitle", "time": 11426.23, "timestamp": "03:10:26", "text": "设计风格类似一位人气 YouTuber。我不会"}, {"type": "subtitle", "time": 11429.269, "timestamp": "03:10:29", "text": "我不会说出他们的名字。是的。所以，我"}, {"type": "subtitle", "time": 11430.51, "timestamp": "03:10:30", "text": "当时的感觉就像是，“哦”"}, {"type": "subtitle", "time": 11432.99, "timestamp": "03:10:32", "text": "不。哦"}, {"type": "subtitle", "time": 11436.79, "timestamp": "03:10:36", "text": "不。如果呢？”不，不，不。那时"}, {"type": "subtitle", "time": 11439.269, "timestamp": "03:10:39", "text": "当我看到它的时候，我把它放在了我的脑海里"}, {"type": "subtitle", "time": 11442.55, "timestamp": "03:10:42", "text": "心就像一个念头，或者，如果……"}, {"type": "subtitle", "time": 11444.67, "timestamp": "03:10:44", "text": "一"}, {"type": "subtitle", "time": 11449.03, "timestamp": "03:10:49", "text": "有一天，如果有一天我不得不……"}, {"type": "subtitle", "time": 11451.07, "timestamp": "03:10:51", "text": "知道就像他们一样"}, {"type": "subtitle", "time": 11454.55, "timestamp": "03:10:54", "text": "该职位必须为运动员挺身而出"}, {"type": "subtitle", "time": 11456.389, "timestamp": "03:10:56", "text": "当然，为了乔克我什么都愿意做。"}, {"type": "subtitle", "time": 11459.11, "timestamp": "03:10:59", "text": "无论如何都会支持运动员"}]
[{"type": "subtitle", "time": 303.469, "timestamp": "00:05:03", "text": "昨天我们好像直播了。"}, {"type": "subtitle", "time": 305.909, "timestamp": "00:05:05", "text": "我们下次直播要持续多久？我"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "忘了。所以昨天我们做了高难度操作。"}, {"type": "subtitle", "time": 312.07, "timestamp": "00:05:12", "text": "在直播过程中，我结束了直播。"}, {"type": "subtitle", "time": 315.59, "timestamp": "00:05:15", "text": "应该是7。然后我想我就开始了"}, {"type": "subtitle", "time": 318.629, "timestamp": "00:05:18", "text": "9点还有一场直播。我本来应该……"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "原本应该在8:30直播，但我已经看了。"}, {"type": "subtitle", "time": 325.27, "timestamp": "00:05:25", "text": "9:30 或 9:00。是的。是的。是的。所以，我们"}, {"type": "subtitle", "time": 327.31, "timestamp": "00:05:27", "text": "香港做了什么？"}, {"type": "subtitle", "time": 330.43, "timestamp": "00:05:30", "text": "昨天我们结束了"}, {"type": "subtitle", "time": 333.83, "timestamp": "00:05:33", "text": "到第15章。我们从第16章开始讲解。"}, {"type": "subtitle", "time": 335.99, "timestamp": "00:05:35", "text": "所以这次直播是在 Hon 直播之后进行的。"}, {"type": "subtitle", "time": 340.23, "timestamp": "00:05:40", "text": "今天直播他们会是，我们会做的"}, {"type": "subtitle", "time": 343.83, "timestamp": "00:05:43", "text": "洪恺也在直播。所以，千万别这么做"}, {"type": "subtitle", "time": 345.31, "timestamp": "00:05:45", "text": "担心"}]
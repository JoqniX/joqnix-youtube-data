[{"type": "subtitle", "time": 15301.91, "timestamp": "04:15:01", "text": "好的。最后我想到的是……"}, {"type": "subtitle", "time": 15303.75, "timestamp": "04:15:03", "text": "去亚洲是因为你们让我去。不，"}, {"type": "subtitle", "time": 15307.429, "timestamp": "04:15:07", "text": "不要去亚洲。选择加州银行。"}, {"type": "subtitle", "time": 15310.229, "timestamp": "04:15:10", "text": "来加州清除斑点。我应该吗？"}, {"type": "subtitle", "time": 15313.269, "timestamp": "04:15:13", "text": "重新下载？好的。好的。您认为"}, {"type": "subtitle", "time": 15319.189, "timestamp": "04:15:19", "text": "哦，不。"}, {"type": "subtitle", "time": 15322.55, "timestamp": "04:15:22", "text": "布罗只是想玩玩而已。是的。不，我"}, {"type": "subtitle", "time": 15327.189, "timestamp": "04:15:27", "text": "醒了。醒了。我的意思是，我可以玩 I"}, {"type": "subtitle", "time": 15329.83, "timestamp": "04:15:29", "text": "可以尝试玩C版本，但是"}, {"type": "subtitle", "time": 15332.149, "timestamp": "04:15:32", "text": "问题是我没有指示牌电话。"}, {"type": "subtitle", "time": 15334.55, "timestamp": "04:15:34", "text": "数字。不。所以我才觉得，唉，"}, {"type": "subtitle", "time": 15338.149, "timestamp": "04:15:38", "text": "全身都在疼痛。"}, {"type": "subtitle", "time": 15340.469, "timestamp": "04:15:40", "text": "哦，是的。你好。欢迎你，Alex。好的"}, {"type": "subtitle", "time": 15342.389, "timestamp": "04:15:42", "text": "早晨。"}, {"type": "subtitle", "time": 15344.149, "timestamp": "04:15:44", "text": "你下载游戏了吗？"}, {"type": "subtitle", "time": 15346.229, "timestamp": "04:15:46", "text": "喝我一口还是别的什么？"}, {"type": "subtitle", "time": 15350.03, "timestamp": "04:15:50", "text": "那是什么？是"}]
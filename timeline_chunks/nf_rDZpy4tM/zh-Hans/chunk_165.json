[{"type": "subtitle", "time": 9901.429, "timestamp": "02:45:01", "text": "不，不，不。即使我把它拿走，他"}, {"type": "subtitle", "time": 9904.2, "timestamp": "02:45:04", "text": "依然变得面目模糊。看"}, {"type": "subtitle", "time": 9926.55, "timestamp": "02:45:26", "text": "微风。太喜欢这阵微风了。"}, {"type": "subtitle", "time": 9928.15, "timestamp": "02:45:28", "text": "没有什么比滑行更爽的了"}, {"type": "subtitle", "time": 9936.55, "timestamp": "02:45:36", "text": "全新门徒。没错。"}, {"type": "subtitle", "time": 9938.55, "timestamp": "02:45:38", "text": "就是你遇到的那个凶神恶煞的赏金猎人。"}, {"type": "subtitle", "time": 9940.389, "timestamp": "02:45:40", "text": "我一直都听说了这件事。他们一直是"}, {"type": "subtitle", "time": 9943.03, "timestamp": "02:45:43", "text": "逐一击落G3，现在"}, {"type": "subtitle", "time": 9945.349, "timestamp": "02:45:45", "text": "他们已准备好工作。这是怎么回事？"}, {"type": "subtitle", "time": 9946.95, "timestamp": "02:45:46", "text": "干掉你那恶毒的老板。你是个强悍的人。"}, {"type": "subtitle", "time": 9949.11, "timestamp": "02:45:49", "text": "土匪。"}, {"type": "subtitle", "time": 9950.83, "timestamp": "02:45:50", "text": "快来吧！"}, {"type": "subtitle", "time": 9953.59, "timestamp": "02:45:53", "text": "Jean Emporium。这是一栋奇怪的房子"}, {"type": "subtitle", "time": 9955.51, "timestamp": "02:45:55", "text": "林城广场中心，就在附近"}, {"type": "subtitle", "time": 9957.83, "timestamp": "02:45:57", "text": "波尔多。如果一个古怪的女孩对你大喊大叫，"}, {"type": "subtitle", "time": 9959.83, "timestamp": "02:45:59", "text": "直接从她身边走过去就行了。她不是"}]
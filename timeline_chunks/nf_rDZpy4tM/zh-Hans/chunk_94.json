[{"type": "subtitle", "time": 5640.31, "timestamp": "01:34:00", "text": "看法。它就像土星之类的东西。"}, {"type": "subtitle", "time": 5641.39, "timestamp": "01:34:01", "text": "它是"}, {"type": "subtitle", "time": 5649.189, "timestamp": "01:34:09", "text": "哇。这不是很酷吗？我的天哪，那个"}, {"type": "subtitle", "time": 5657.27, "timestamp": "01:34:17", "text": "是你。又是你。我很高兴看到"}, {"type": "subtitle", "time": 5659.91, "timestamp": "01:34:19", "text": "你？我太高兴了。我只看到过类似的东西"}, {"type": "subtitle", "time": 5664.07, "timestamp": "01:34:24", "text": "我拥有宇宙的力量，但并非利用我这个人。"}, {"type": "subtitle", "time": 5666.709, "timestamp": "01:34:26", "text": "丢失的。确切地。最爱的小家伙。博士"}, {"type": "subtitle", "time": 5669.03, "timestamp": "01:34:29", "text": "J：那是黑洞。那是黑色的"}, {"type": "subtitle", "time": 5671.27, "timestamp": "01:34:31", "text": "洞。我时间不多了。天哪，我"}, {"type": "subtitle", "time": 5673.75, "timestamp": "01:34:33", "text": "我非常担心我的孩子和一个小家伙。"}, {"type": "subtitle", "time": 5675.43, "timestamp": "01:34:35", "text": "讲了一些关于我妻子的事，但主要还是关于我的孩子。"}, {"type": "subtitle", "time": 5677.27, "timestamp": "01:34:37", "text": "哦，难题。又一个谜题，是吗？谜"}, {"type": "subtitle", "time": 5678.87, "timestamp": "01:34:38", "text": "时间。我们来尝试一下。"}, {"type": "subtitle", "time": 5681.03, "timestamp": "01:34:41", "text": "怎么样？哦，我可怜的孩子们。我希望"}, {"type": "subtitle", "time": 5683.83, "timestamp": "01:34:43", "text": "D 不会杀死它们。我能感觉到我的路"}, {"type": "subtitle", "time": 5686.229, "timestamp": "01:34:46", "text": "有人在叫我。你要解决"}, {"type": "subtitle", "time": 5689.75, "timestamp": "01:34:49", "text": "这个也是。谢谢。"}, {"type": "subtitle", "time": 5691.75, "timestamp": "01:34:51", "text": "我们开始做吧。"}, {"type": "subtitle", "time": 5695.11, "timestamp": "01:34:55", "text": "我的天哪。这丛灌木真碍事。"}, {"type": "subtitle", "time": 5697.27, "timestamp": "01:34:57", "text": "Swoopy 和 Fr 会非常喜欢你。"}, {"type": "subtitle", "time": 5699.51, "timestamp": "01:34:59", "text": "也。哦，他们都是好孩子。我等不及了"}]
[{"type": "subtitle", "time": 1321.47, "timestamp": "00:22:01", "text": "难道你不这么认为吗？"}, {"type": "subtitle", "time": 1332.63, "timestamp": "00:22:12", "text": "敢。不，不，不，不，不，不，你不能。"}, {"type": "subtitle", "time": 1342.99, "timestamp": "00:22:22", "text": "一个"}, {"type": "subtitle", "time": 1345.95, "timestamp": "00:22:25", "text": "我听到有人说了这句话。"}, {"type": "subtitle", "time": 1351.07, "timestamp": "00:22:31", "text": "电影。我不知道那是什么意思，但是"}, {"type": "subtitle", "time": 1353.43, "timestamp": "00:22:33", "text": "是的，世界上任何东西。是的，不是这样的。"}, {"type": "subtitle", "time": 1354.59, "timestamp": "00:22:34", "text": "我"}, {"type": "subtitle", "time": 1368.23, "timestamp": "00:22:48", "text": "最后。最后。我的天啊。终于拿到了"}, {"type": "subtitle", "time": 1370.19, "timestamp": "00:22:50", "text": "这"}, {"type": "subtitle", "time": 1374.83, "timestamp": "00:22:54", "text": "胸部。我的天啊。那花了我"}]
[{"type": "subtitle", "time": 5427.83, "timestamp": "01:30:27", "text": "干得好，伙计。这是最后一个了。"}, {"type": "subtitle", "time": 5430.43, "timestamp": "01:30:30", "text": "我想我们会从中结晶出来"}, {"type": "subtitle", "time": 5433.99, "timestamp": "01:30:33", "text": "加入 G3 或其他什么的方框。我"}, {"type": "subtitle", "time": 5435.83, "timestamp": "01:30:35", "text": "我真的怎么强调都不为过，我有多少"}, {"type": "subtitle", "time": 5437.75, "timestamp": "01:30:37", "text": "在乎吗？现在，向你汇报"}, {"type": "subtitle", "time": 5439.43, "timestamp": "01:30:39", "text": "指挥官，我们会派你过去。"}, {"type": "subtitle", "time": 5441.43, "timestamp": "01:30:41", "text": "去为我们而战，哪怕牺牲也在所不惜"}, {"type": "subtitle", "time": 5449.35, "timestamp": "01:30:49", "text": "哇。好的，所以我们需要收集"}, {"type": "subtitle", "time": 5459.59, "timestamp": "01:30:59", "text": "但说到星星，我一直在想"}]
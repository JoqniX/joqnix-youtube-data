[{"type": "subtitle", "time": 12362.63, "timestamp": "03:26:02", "text": "签订合同才能成为旗下艺人"}, {"type": "subtitle", "time": 12363.79, "timestamp": "03:26:03", "text": "这"}, {"type": "subtitle", "time": 12366.15, "timestamp": "03:26:06", "text": "机构。你必须与……签订合同"}, {"type": "subtitle", "time": 12368.95, "timestamp": "03:26:08", "text": "你的真实个人信息、其他银行卡等等"}, {"type": "subtitle", "time": 12372.19, "timestamp": "03:26:12", "text": "因为这是官方文件。"}, {"type": "subtitle", "time": 12376.63, "timestamp": "03:26:16", "text": "正确的？所以，骗子们将会……"}, {"type": "subtitle", "time": 12379.11, "timestamp": "03:26:19", "text": "限制，即你持续的时间。"}, {"type": "subtitle", "time": 12382.389, "timestamp": "03:26:22", "text": "应该和他们一起工作什么的。"}, {"type": "subtitle", "time": 12383.75, "timestamp": "03:26:23", "text": "你应该直播多久"}, {"type": "subtitle", "time": 12386.07, "timestamp": "03:26:26", "text": "定期做这些事。"}, {"type": "subtitle", "time": 12388.07, "timestamp": "03:26:28", "text": "好的。"}, {"type": "subtitle", "time": 12391.349, "timestamp": "03:26:31", "text": "所以，如果您感到不舒服的话"}, {"type": "subtitle", "time": 12393.83, "timestamp": "03:26:33", "text": "与公司或机构合作，尽管"}, {"type": "subtitle", "time": 12395.63, "timestamp": "03:26:35", "text": "你已经做到了"}, {"type": "subtitle", "time": 12402.07, "timestamp": "03:26:42", "text": "一个月、两个月或三个月，你"}, {"type": "subtitle", "time": 12403.95, "timestamp": "03:26:43", "text": "感觉不舒服"}, {"type": "subtitle", "time": 12407.07, "timestamp": "03:26:47", "text": "认为你"}, {"type": "subtitle", "time": 12412.309, "timestamp": "03:26:52", "text": "可以离开，你知道，呃，就像这样。"}, {"type": "subtitle", "time": 12414.95, "timestamp": "03:26:54", "text": "是的，你得跟……谈谈"}, {"type": "subtitle", "time": 12417.269, "timestamp": "03:26:57", "text": "公司经理，比如CEO之类的。"}, {"type": "subtitle", "time": 12419.75, "timestamp": "03:26:59", "text": "和这些东西说话，然后……"}]
[{"type": "subtitle", "time": 16320.55, "timestamp": "04:32:00", "text": "哇。造成伤害。击败敌人或"}, {"type": "subtitle", "time": 16322.83, "timestamp": "04:32:02", "text": "表演闪避赋予共鸣"}, {"type": "subtitle", "time": 16325.99, "timestamp": "04:32:05", "text": "活力。当共振能量达到饱和时，"}, {"type": "subtitle", "time": 16328.149, "timestamp": "04:32:08", "text": "强大的共鸣解放"}, {"type": "subtitle", "time": 16330.75, "timestamp": "04:32:10", "text": "变得可用。"}, {"type": "subtitle", "time": 16333.83, "timestamp": "04:32:13", "text": "哇。小心。"}, {"type": "subtitle", "time": 16337.189, "timestamp": "04:32:17", "text": "我现在就想挑战最终boss。我躲开了"}, {"type": "subtitle", "time": 16345.229, "timestamp": "04:32:25", "text": "按"}, {"type": "subtitle", "time": 16354.03, "timestamp": "04:32:34", "text": "哦，不错。超速"}, {"type": "subtitle", "time": 16362.149, "timestamp": "04:32:42", "text": "我错过了。"}, {"type": "subtitle", "time": 16364.83, "timestamp": "04:32:44", "text": "我的传感器"}, {"type": "subtitle", "time": 16368.55, "timestamp": "04:32:48", "text": "弱点就是你的利刃。"}, {"type": "subtitle", "time": 16371.03, "timestamp": "04:32:51", "text": "太酷了！"}, {"type": "subtitle", "time": 16372.75, "timestamp": "04:32:52", "text": "迅捷与"}]
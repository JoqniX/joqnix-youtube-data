[{"type": "subtitle", "time": 2461.27, "timestamp": "00:41:01", "text": "我。我的真名。连我父母都做不到。"}, {"type": "subtitle", "time": 2469.109, "timestamp": "00:41:09", "text": "你呢？你想要什么？你新"}, {"type": "subtitle", "time": 2471.349, "timestamp": "00:41:11", "text": "去老城区吗？你觉得这样做没问题吗？"}, {"type": "subtitle", "time": 2473.91, "timestamp": "00:41:13", "text": "走到陌生人面前和他们交谈？"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "是的，这样做没问题。"}, {"type": "subtitle", "time": 2478.829, "timestamp": "00:41:18", "text": "你差点吓到我了"}, {"type": "subtitle", "time": 2481.91, "timestamp": "00:41:21", "text": "那里。你呢？物种真的"}, {"type": "subtitle", "time": 2484.95, "timestamp": "00:41:24", "text": "耐酒精。所以，我刚买了一些"}, {"type": "subtitle", "time": 2487.03, "timestamp": "00:41:27", "text": "为了扳回一局，喝了更多酒。"}, {"type": "subtitle", "time": 2489.19, "timestamp": "00:41:29", "text": "哪怕是最轻微的瞬间。祝你今天过得愉快。有"}, {"type": "subtitle", "time": 2492.71, "timestamp": "00:41:32", "text": "几分钟后过来。你好。你好。你好。你好。"}, {"type": "subtitle", "time": 2496.39, "timestamp": "00:41:36", "text": "现在，有人在等着你。"}, {"type": "subtitle", "time": 2499.15, "timestamp": "00:41:39", "text": "我很好。我有点……"}, {"type": "subtitle", "time": 2501.589, "timestamp": "00:41:41", "text": "有点傻。我不知道。我正在做"}, {"type": "subtitle", "time": 2503.109, "timestamp": "00:41:43", "text": "还不错。"}, {"type": "subtitle", "time": 2506.71, "timestamp": "00:41:46", "text": "嘿，胖手指漂浮着我的名字，"}, {"type": "subtitle", "time": 2510.39, "timestamp": "00:41:50", "text": "Trungle Funk是我的强项。哦，是的。不，我"}, {"type": "subtitle", "time": 2511.43, "timestamp": "00:41:51", "text": "我们我们我们不知道这他妈到底是怎么回事"}, {"type": "subtitle", "time": 2514.15, "timestamp": "00:41:54", "text": "Trungle Funk 是。哦，你看上去很困惑。"}, {"type": "subtitle", "time": 2516.39, "timestamp": "00:41:56", "text": "但我看得出来你想听我甜言蜜语"}]
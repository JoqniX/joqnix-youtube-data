[{"type": "subtitle", "time": 12241.79, "timestamp": "03:24:01", "text": "谈论"}, {"type": "subtitle", "time": 12244.15, "timestamp": "03:24:04", "text": "它。是的。是的。我们当时在谈论……"}, {"type": "subtitle", "time": 12245.75, "timestamp": "03:24:05", "text": "你能再说一遍吗？是的。我当时"}, {"type": "subtitle", "time": 12246.99, "timestamp": "03:24:06", "text": "谈论"}, {"type": "subtitle", "time": 12249.51, "timestamp": "03:24:09", "text": "你写的这种方式真棒。你正在制作"}, {"type": "subtitle", "time": 12252.07, "timestamp": "03:24:12", "text": "你的……等等，你写这段话的方式……"}, {"type": "subtitle", "time": 12254.15, "timestamp": "03:24:14", "text": "呃，《上古卷轴5：天际》。你让我们觉得"}, {"type": "subtitle", "time": 12256.389, "timestamp": "03:24:16", "text": "对面的。等等，你这话是什么意思？"}, {"type": "subtitle", "time": 12258.71, "timestamp": "03:24:18", "text": "那？等等，你这话是什么意思？"}, {"type": "subtitle", "time": 12261.11, "timestamp": "03:24:21", "text": "详细说说，阿什。等等，我发出过什么信号吗？"}, {"type": "subtitle", "time": 12273.429, "timestamp": "03:24:33", "text": "等等，除非我看了他们的首秀……"}, {"type": "subtitle", "time": 12275.63, "timestamp": "03:24:35", "text": "如果声音类似，我会很高兴。"}, {"type": "subtitle", "time": 12285.87, "timestamp": "03:24:45", "text": "啊"}, {"type": "subtitle", "time": 12289.349, "timestamp": "03:24:49", "text": "好的。所以自从你上次……"}, {"type": "subtitle", "time": 12291.75, "timestamp": "03:24:51", "text": "你离开时问了这个问题"}, {"type": "subtitle", "time": 12294.79, "timestamp": "03:24:54", "text": "如果你在群组里，那就对了。你可以吗"}, {"type": "subtitle", "time": 12296.87, "timestamp": "03:24:56", "text": "如果你是一群人，请离开群组。"}, {"type": "subtitle", "time": 12298.309, "timestamp": "03:24:58", "text": "如果你身处一群人之中，你就是"}]
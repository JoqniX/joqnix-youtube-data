[{"type": "subtitle", "time": 8043.109, "timestamp": "02:14:03", "text": "一起。哎呀，他不知道。是的，"}, {"type": "subtitle", "time": 8052.149, "timestamp": "02:14:12", "text": "这就是我们需要的甜心。好的，明白了。"}, {"type": "subtitle", "time": 8068.95, "timestamp": "02:14:28", "text": "速射？我的天啊。这群白痴。"}, {"type": "subtitle", "time": 8071.03, "timestamp": "02:14:31", "text": "嘿，你想知道我真正的帽子戏法吗？"}, {"type": "subtitle", "time": 8073.03, "timestamp": "02:14:33", "text": "我的水晶粘在袋子里，它们会"}, {"type": "subtitle", "time": 8075.03, "timestamp": "02:14:35", "text": "如果你用力击打它们，它们会爆炸。斗争"}, {"type": "subtitle", "time": 8086.229, "timestamp": "02:14:46", "text": "哦，捅他屁股。等着瞧我的敌人"}, {"type": "subtitle", "time": 8090.149, "timestamp": "02:14:50", "text": "击打他们之后。但要用它。"}, {"type": "subtitle", "time": 8096.87, "timestamp": "02:14:56", "text": "他们已经完成了。我当时只是"}]
[{"type": "subtitle", "time": 6361.27, "timestamp": "01:46:01", "text": "[音乐]"}, {"type": "subtitle", "time": 6363.669, "timestamp": "01:46:03", "text": "正在追踪你。"}, {"type": "subtitle", "time": 6366.07, "timestamp": "01:46:06", "text": "有粘性的东西吗？我不知道该怎么做"}, {"type": "subtitle", "time": 6392.87, "timestamp": "01:46:32", "text": "这就是他们加入G3的下场。"}, {"type": "subtitle", "time": 6394.55, "timestamp": "01:46:34", "text": "你知道。我，我，我想我没有，我没有"}, {"type": "subtitle", "time": 6396.79, "timestamp": "01:46:36", "text": "知道。这是一个团体，你想参与其中。"}, {"type": "subtitle", "time": 6398.87, "timestamp": "01:46:38", "text": "作为合伙人，你真的可以吗？"}, {"type": "subtitle", "time": 6401.43, "timestamp": "01:46:41", "text": "退出群组？你是说“团体”吗？"}, {"type": "subtitle", "time": 6404.39, "timestamp": "01:46:44", "text": "公司，对吧？请记住你"}, {"type": "subtitle", "time": 6407.27, "timestamp": "01:46:47", "text": "不能自由离开公司"}, {"type": "subtitle", "time": 6409.59, "timestamp": "01:46:49", "text": "像这样的团体，因为是企业性质的。"}, {"type": "subtitle", "time": 6412.47, "timestamp": "01:46:52", "text": "这意味着你必须签署一份合同。"}, {"type": "subtitle", "time": 6415.83, "timestamp": "01:46:55", "text": "您与对方之间的法律合同"}]
[{"type": "subtitle", "time": 1982.07, "timestamp": "00:33:02", "text": "否则就会被杀。眨眼。哦好的。我"}, {"type": "subtitle", "time": 1983.43, "timestamp": "00:33:03", "text": "看看这里发生了什么。你们想要我们"}, {"type": "subtitle", "time": 1985.509, "timestamp": "00:33:05", "text": "杀了他们？哇。我没说过那样的话。我"}, {"type": "subtitle", "time": 1987.75, "timestamp": "00:33:07", "text": "只是眨了眨眼，然后说了声“好的”。是的，"}, {"type": "subtitle", "time": 1989.59, "timestamp": "00:33:09", "text": "我的意思就是这样。所以，去杀了他。"}, {"type": "subtitle", "time": 1992.389, "timestamp": "00:33:12", "text": "我会让你通过。不，我我我"}, {"type": "subtitle", "time": 1995.669, "timestamp": "00:33:15", "text": "我觉得我们应该去塔可钟。"}, {"type": "subtitle", "time": 2006.87, "timestamp": "00:33:26", "text": "钟？好的，我们需要探讨一下这个问题。"}, {"type": "subtitle", "time": 2009.75, "timestamp": "00:33:29", "text": "地方。我想那里面肯定有什么问题。"}, {"type": "subtitle", "time": 2023.99, "timestamp": "00:33:43", "text": "哦，非常感谢。好了。"}, {"type": "subtitle", "time": 2026.31, "timestamp": "00:33:46", "text": "你为什么一直没用我？我是"}, {"type": "subtitle", "time": 2029.029, "timestamp": "00:33:49", "text": "对不起。"}, {"type": "subtitle", "time": 2030.87, "timestamp": "00:33:50", "text": "你不必回家，但你也不能回家。"}, {"type": "subtitle", "time": 2033.11, "timestamp": "00:33:53", "text": "就住这儿吧。每次我抱怨"}, {"type": "subtitle", "time": 2036.07, "timestamp": "00:33:56", "text": "镇议会总是告诉我，G3"}, {"type": "subtitle", "time": 2038.87, "timestamp": "00:33:58", "text": "同一件事。对不起，肯托。没有"}]
[{"type": "subtitle", "time": 17041.99, "timestamp": "04:44:01", "text": "你还好吗？你受伤了吗？"}, {"type": "subtitle", "time": 17045.99, "timestamp": "04:44:05", "text": "摇头。我很好。"}, {"type": "subtitle", "time": 17048.948, "timestamp": "04:44:08", "text": "谢天谢地。我们能看到那该死的"}, {"type": "subtitle", "time": 17051.47, "timestamp": "04:44:11", "text": "有障碍，但却无法触及。"}, {"type": "subtitle", "time": 17054.55, "timestamp": "04:44:14", "text": "它。我也很好。"}, {"type": "subtitle", "time": 17057.11, "timestamp": "04:44:17", "text": "我从未见过如此惊人的沉默。"}, {"type": "subtitle", "time": 17059.51, "timestamp": "04:44:19", "text": "之前有过不和谐。默许弃置。罗孚是"}, {"type": "subtitle", "time": 17062.07, "timestamp": "04:44:22", "text": "能够彻底击败它。他们击败了"}, {"type": "subtitle", "time": 17068.39, "timestamp": "04:44:28", "text": "我其实没做什么。这一切都是"}, {"type": "subtitle", "time": 17071.35, "timestamp": "04:44:31", "text": "谢谢你，Rover。她为什么这么……"}, {"type": "subtitle", "time": 17075.628, "timestamp": "04:44:35", "text": "可爱的？这个地方并不以如此闻名。"}, {"type": "subtitle", "time": 17090.67, "timestamp": "04:44:50", "text": "哦，这是一个"}, {"type": "subtitle", "time": 17095.15, "timestamp": "04:44:55", "text": "回声。哇，精英阶层的回响。"}, {"type": "subtitle", "time": 17098.948, "timestamp": "04:44:58", "text": "班级。今天有人走运了。精英"}]
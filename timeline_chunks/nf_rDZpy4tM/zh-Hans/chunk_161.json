[{"type": "subtitle", "time": 9660.15, "timestamp": "02:41:00", "text": "你？我知道这很恶心，但冷静点。"}, {"type": "subtitle", "time": 9662.389, "timestamp": "02:41:02", "text": "我叫斯坦，我要说一句可怕的话"}, {"type": "subtitle", "time": 9664.71, "timestamp": "02:41:04", "text": "各种各样的外星人来了"}, {"type": "subtitle", "time": 9666.23, "timestamp": "02:41:06", "text": "我们只能接受这个现实了。"}, {"type": "subtitle", "time": 9669.83, "timestamp": "02:41:09", "text": "这些知识结合起来。现在我不能"}, {"type": "subtitle", "time": 9671.67, "timestamp": "02:41:11", "text": "相信我们正在这样做，但让我们……"}, {"type": "subtitle", "time": 9675.19, "timestamp": "02:41:15", "text": "有些人来了。哇，看看你。你想"}, {"type": "subtitle", "time": 9677.429, "timestamp": "02:41:17", "text": "外星人的精液？我很高兴你"}, {"type": "subtitle", "time": 9679.19, "timestamp": "02:41:19", "text": "感兴趣的。你看，你抓到我了"}, {"type": "subtitle", "time": 9681.51, "timestamp": "02:41:21", "text": "再会。我正在做一次性的促销活动"}, {"type": "subtitle", "time": 9684.23, "timestamp": "02:41:24", "text": "免费的外星人精液。承担一些责任"}, {"type": "subtitle", "time": 9686.07, "timestamp": "02:41:26", "text": "房子。如果你喜欢，就过来吧。"}, {"type": "subtitle", "time": 9690.75, "timestamp": "02:41:30", "text": "回去再买一些。就说"}, {"type": "subtitle", "time": 9694.15, "timestamp": "02:41:34", "text": "他们拥有绝对最棒的外星人"}, {"type": "subtitle", "time": 9696.23, "timestamp": "02:41:36", "text": "我见过的。好了，你找到她了。"}, {"type": "subtitle", "time": 9704.389, "timestamp": "02:41:44", "text": "我们是不是在藏匿毒品？好的。啊，看起来"}, {"type": "subtitle", "time": 9707.03, "timestamp": "02:41:47", "text": "想看更多《异形来袭》吗？嗯，我是"}, {"type": "subtitle", "time": 9709.27, "timestamp": "02:41:49", "text": "对不起。我的Alien Come用完了"}, {"type": "subtitle", "time": 9711.67, "timestamp": "02:41:51", "text": "现在。我们有时会提前售罄。我得到了"}, {"type": "subtitle", "time": 9713.83, "timestamp": "02:41:53", "text": "去补充我的库存，但这并非事实。"}, {"type": "subtitle", "time": 9715.67, "timestamp": "02:41:55", "text": "太简单了。相信我。但请给我一点时间"}, {"type": "subtitle", "time": 9717.51, "timestamp": "02:41:57", "text": "一点儿，我还会再来很多。我"}, {"type": "subtitle", "time": 9719.83, "timestamp": "02:41:59", "text": "承诺。我只是，我只是需要一些"}]
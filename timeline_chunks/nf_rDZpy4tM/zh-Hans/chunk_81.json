[{"type": "subtitle", "time": 4861.75, "timestamp": "01:21:01", "text": "我正在数。是的，可以这么说。所以呢"}, {"type": "subtitle", "time": 4864.87, "timestamp": "01:21:04", "text": "我做了吗？呃，我是从零开始的。"}, {"type": "subtitle", "time": 4868.31, "timestamp": "01:21:08", "text": "我刚开始直播的时候，我只是个普通人。"}, {"type": "subtitle", "time": 4870.189, "timestamp": "01:21:10", "text": "你是主播吧？那段时间是"}, {"type": "subtitle", "time": 4875.11, "timestamp": "01:21:15", "text": "更难了，但我确实有一些"}, {"type": "subtitle", "time": 4878.07, "timestamp": "01:21:18", "text": "有人进来就看我，对吧？但"}, {"type": "subtitle", "time": 4881.669, "timestamp": "01:21:21", "text": "我刚开始做 YouTube 的时候，拥有的账号比较少。"}, {"type": "subtitle", "time": 4884.229, "timestamp": "01:21:24", "text": "又有几个人进来了，然后……"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "看着我什么的。"}, {"type": "subtitle", "time": 4889.55, "timestamp": "01:21:29", "text": "然后他们就成了常客，慢慢地"}, {"type": "subtitle", "time": 4892.07, "timestamp": "01:21:32", "text": "慢慢地，很多人进来了。"}, {"type": "subtitle", "time": 4893.83, "timestamp": "01:21:33", "text": "就是这么残酷，就是这么梦幻。"}, {"type": "subtitle", "time": 4895.75, "timestamp": "01:21:35", "text": "就这样，大家都来到了阿迪蒂这里。"}, {"type": "subtitle", "time": 4897.99, "timestamp": "01:21:37", "text": "你们进来吧，交换一下，我的"}, {"type": "subtitle", "time": 4900.47, "timestamp": "01:21:40", "text": "我的大部分直播都是这样，但是"}, {"type": "subtitle", "time": 4903.03, "timestamp": "01:21:43", "text": "即使你不是每天都来，或者"}, {"type": "subtitle", "time": 4904.55, "timestamp": "01:21:44", "text": "你仍然是其中的一部分"}, {"type": "subtitle", "time": 4906.31, "timestamp": "01:21:46", "text": "社区对吧，因为你确实在关注我，而且"}, {"type": "subtitle", "time": 4909.11, "timestamp": "01:21:49", "text": "你是来看我、支持我的吗？"}, {"type": "subtitle", "time": 4911.709, "timestamp": "01:21:51", "text": "我当时就在某个时刻"}, {"type": "subtitle", "time": 4916.629, "timestamp": "01:21:56", "text": "我的旅程中就是这样的一段时间。"}, {"type": "subtitle", "time": 4919.99, "timestamp": "01:21:59", "text": "就这样。假设有一位新的BTuber"}]
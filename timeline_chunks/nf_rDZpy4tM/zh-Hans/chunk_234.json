[{"type": "subtitle", "time": 14041.91, "timestamp": "03:54:01", "text": "观看和光顾我的直播间"}, {"type": "subtitle", "time": 14043.67, "timestamp": "03:54:03", "text": "评论时请确保不要这样做"}, {"type": "subtitle", "time": 14046.79, "timestamp": "03:54:06", "text": "那是因为他们大多数人都不这样做。"}, {"type": "subtitle", "time": 14048.95, "timestamp": "03:54:08", "text": "知道我们用的管子是什么之类的东西吧？"}, {"type": "subtitle", "time": 14051.63, "timestamp": "03:54:11", "text": "它在周围地区并不太受欢迎。"}, {"type": "subtitle", "time": 14055.11, "timestamp": "03:54:15", "text": "这跟动漫的运作方式很像，对吧？"}, {"type": "subtitle", "time": 14056.63, "timestamp": "03:54:16", "text": "有些人不知道……不知道"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "所以，是的，这就是为什么如果你知道如果"}, {"type": "subtitle", "time": 14066.91, "timestamp": "03:54:26", "text": "你就像一个"}, {"type": "subtitle", "time": 14071.03, "timestamp": "03:54:31", "text": "曾经见过所有事情的元老级人物"}, {"type": "subtitle", "time": 14073.11, "timestamp": "03:54:33", "text": "Instagram 之类的社交媒体"}, {"type": "subtitle", "time": 14074.87, "timestamp": "03:54:34", "text": "东西，你可能已经注意到我以前……"}, {"type": "subtitle", "time": 14076.59, "timestamp": "03:54:36", "text": "有喜欢"}, {"type": "subtitle", "time": 14079.79, "timestamp": "03:54:39", "text": "千。是的，接近 1000 呃"}, {"type": "subtitle", "time": 14082.91, "timestamp": "03:54:42", "text": "我在Instagram上有粉丝，但我步行"}, {"type": "subtitle", "time": 14085.83, "timestamp": "03:54:45", "text": "它。是的，骑车过去了。现在大概是 800 或"}, {"type": "subtitle", "time": 14088.229, "timestamp": "03:54:48", "text": "900。我不知道。"}, {"type": "subtitle", "time": 14095.71, "timestamp": "03:54:55", "text": "由认识我的人组成的董事会"}, {"type": "subtitle", "time": 14098.55, "timestamp": "03:54:58", "text": "一切都是因为那时我一无所知。"}]
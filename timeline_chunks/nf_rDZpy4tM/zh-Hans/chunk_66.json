[{"type": "subtitle", "time": 3961.349, "timestamp": "01:06:01", "text": "在这一带。你想偷偷溜进去"}, {"type": "subtitle", "time": 3963.27, "timestamp": "01:06:03", "text": "G3设施？是的，我得去"}, {"type": "subtitle", "time": 3964.71, "timestamp": "01:06:04", "text": "浑身黏糊糊的。就是这样。"}, {"type": "subtitle", "time": 3966.789, "timestamp": "01:06:06", "text": "走了。我的东西质量很好。是的。你"}, {"type": "subtitle", "time": 3969.029, "timestamp": "01:06:09", "text": "想要点黏糊糊的东西，对吧？"}, {"type": "subtitle", "time": 3970.63, "timestamp": "01:06:10", "text": "走吧。这并非第一次"}, {"type": "subtitle", "time": 3972.789, "timestamp": "01:06:12", "text": "我被泼了一身胶水。我们开始吧。"}, {"type": "subtitle", "time": 3975.029, "timestamp": "01:06:15", "text": "完美的。沿着那边的小巷走。只是"}, {"type": "subtitle", "time": 3977.829, "timestamp": "01:06:17", "text": "嗯，就让奇迹发生吧。呃"}, {"type": "subtitle", "time": 3979.43, "timestamp": "01:06:19", "text": "别担心。你的第一个黏糊糊的东西"}, {"type": "subtitle", "time": 3981.43, "timestamp": "01:06:21", "text": "我。把这件事告诉你的所有朋友。"}, {"type": "subtitle", "time": 3985.109, "timestamp": "01:06:25", "text": "我就是那个搞Goop的家伙。我做Goop牌的东西。好的。"}, {"type": "subtitle", "time": 3987.99, "timestamp": "01:06:27", "text": "你没事。我打算选择"}, {"type": "subtitle", "time": 3989.99, "timestamp": "01:06:29", "text": "此处流水。但我对此并不感到兴奋。"}, {"type": "subtitle", "time": 3992.63, "timestamp": "01:06:32", "text": "它。"}, {"type": "subtitle", "time": 3996.15, "timestamp": "01:06:36", "text": "我的天哪。但这太恶心了。嘿，看"}, {"type": "subtitle", "time": 3998.069, "timestamp": "01:06:38", "text": "对着你。你浑身都黏糊糊的。我得去"}, {"type": "subtitle", "time": 4000.95, "timestamp": "01:06:40", "text": "要诚实。我的天啊。真恶心。"}, {"type": "subtitle", "time": 4003.75, "timestamp": "01:06:43", "text": "我的天啊。进去。出来。别待在这里"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "在那里待的时间太长了。不要搞糖果门事件。"}, {"type": "subtitle", "time": 4017.15, "timestamp": "01:06:57", "text": "上帝。"}]
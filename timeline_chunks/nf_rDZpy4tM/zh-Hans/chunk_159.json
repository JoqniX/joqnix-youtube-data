[{"type": "subtitle", "time": 9551.51, "timestamp": "02:39:11", "text": "我的天哪。柴油机。是的，"}, {"type": "subtitle", "time": 9554.469, "timestamp": "02:39:14", "text": "男人。肯尼的脸怎么了？"}, {"type": "subtitle", "time": 9556.63, "timestamp": "02:39:16", "text": "整整那么长时间？哦，你想让我离开"}, {"type": "subtitle", "time": 9559.349, "timestamp": "02:39:19", "text": "你又来了？"}, {"type": "subtitle", "time": 9563.429, "timestamp": "02:39:23", "text": "他的脸怎么了？"}, {"type": "subtitle", "time": 9566.55, "timestamp": "02:39:26", "text": "我想要回肯尼的脸。"}, {"type": "subtitle", "time": 9568.79, "timestamp": "02:39:28", "text": "嘿，这边。会说话的寡妇"}, {"type": "subtitle", "time": 9571.51, "timestamp": "02:39:31", "text": "枪。事情是这样的。我的名字叫斯坦，"}, {"type": "subtitle", "time": 9573.83, "timestamp": "02:39:33", "text": "我出售外星人精液小瓶。我知道"}, {"type": "subtitle", "time": 9575.19, "timestamp": "02:39:35", "text": "这可能不是你想要的。"}, {"type": "subtitle", "time": 9577.03, "timestamp": "02:39:37", "text": "听到你走过来时的情景了。你"}, {"type": "subtitle", "time": 9582.55, "timestamp": "02:39:42", "text": "我们看起来怎么样？我没生气。我只是"}, {"type": "subtitle", "time": 9584.55, "timestamp": "02:39:44", "text": "好奇的。我们真的长得像你吗？"}, {"type": "subtitle", "time": 9587.99, "timestamp": "02:39:47", "text": "典型客户？当然。你看，我有"}, {"type": "subtitle", "time": 9590.389, "timestamp": "02:39:50", "text": "完全没有头绪。我感到震惊"}, {"type": "subtitle", "time": 9593.03, "timestamp": "02:39:53", "text": "每次有人购买时都是核心内容"}, {"type": "subtitle", "time": 9595.349, "timestamp": "02:39:55", "text": "我体内会产下成卡车的外星人。但"}, {"type": "subtitle", "time": 9597.59, "timestamp": "02:39:57", "text": "他们经常这样做。没有"}, {"type": "subtitle", "time": 9599.349, "timestamp": "02:39:59", "text": "这其中蕴含着韵律或道理。我一直"}]
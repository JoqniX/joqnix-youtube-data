[{"type": "subtitle", "time": 7270.31, "timestamp": "02:01:10", "text": "是的，我需要建立一个系统。"}, {"type": "subtitle", "time": 7272.95, "timestamp": "02:01:12", "text": "每当我把麦克风静音时，不，不。"}, {"type": "subtitle", "time": 7275.27, "timestamp": "02:01:15", "text": "每当我打开黑莓手机或者每当我"}, {"type": "subtitle", "time": 7278.07, "timestamp": "02:01:18", "text": "打开麦克风，然后将其静音一段时间。"}, {"type": "subtitle", "time": 7279.99, "timestamp": "02:01:19", "text": "聊天记录里会显示一个小提示。"}, {"type": "subtitle", "time": 7282.75, "timestamp": "02:01:22", "text": "我暂时被静音了。"}, {"type": "subtitle", "time": 7287.03, "timestamp": "02:01:27", "text": "那样做，嗯，是的，那样做"}, {"type": "subtitle", "time": 7289.91, "timestamp": "02:01:29", "text": "我可以像这样获取时间戳。"}, {"type": "subtitle", "time": 7292.39, "timestamp": "02:01:32", "text": "我拍了很久的视频，感觉很好。"}, {"type": "subtitle", "time": 7293.81, "timestamp": "02:01:33", "text": "东西。"}, {"type": "subtitle", "time": 7296.629, "timestamp": "02:01:36", "text": "[音乐]"}, {"type": "subtitle", "time": 7298.229, "timestamp": "02:01:38", "text": "谢谢你让我欣赏到这些美景"}, {"type": "subtitle", "time": 7299.75, "timestamp": "02:01:39", "text": "睡眠。"}, {"type": "subtitle", "time": 7301.75, "timestamp": "02:01:41", "text": "我们有点放纵自己了"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "配合刀具进行智力上的结合。等待，"}, {"type": "subtitle", "time": 7306.43, "timestamp": "02:01:46", "text": "什么？什么？刀？"}]
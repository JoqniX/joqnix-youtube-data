[{"type": "subtitle", "time": 2340.71, "timestamp": "00:39:00", "text": "[音乐]"}, {"type": "subtitle", "time": 2342.15, "timestamp": "00:39:02", "text": "我没有足够的耐力来做这件事。"}, {"type": "subtitle", "time": 2345.1, "timestamp": "00:39:05", "text": "拉屎。"}, {"type": "subtitle", "time": 2347.589, "timestamp": "00:39:07", "text": "[音乐]"}, {"type": "subtitle", "time": 2349.43, "timestamp": "00:39:09", "text": "我们还需要再杀谁？"}, {"type": "subtitle", "time": 2350.67, "timestamp": "00:39:10", "text": "地方，"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "让我们一起装点这座小镇。无论什么颜色"}, {"type": "subtitle", "time": 2368.39, "timestamp": "00:39:28", "text": "哦，你可以把它设为无限大。圣"}, {"type": "subtitle", "time": 2371.19, "timestamp": "00:39:31", "text": "真他妈操蛋。"}, {"type": "subtitle", "time": 2388.63, "timestamp": "00:39:48", "text": "回来。哦，我死了。好的。"}, {"type": "subtitle", "time": 2390.069, "timestamp": "00:39:50", "text": "好的。看起来像东西。怎样"}, {"type": "subtitle", "time": 2392.95, "timestamp": "00:39:52", "text": "你，乔克？我很好。多亏了我们，"}, {"type": "subtitle", "time": 2396.39, "timestamp": "00:39:56", "text": "你知道。我不知道为什么肯尼的"}, {"type": "subtitle", "time": 2399.829, "timestamp": "00:39:59", "text": "脸不见了。肯尼怎么了？"}]
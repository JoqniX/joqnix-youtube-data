[{"type": "subtitle", "time": 2101.19, "timestamp": "00:35:01", "text": "是的。想想看，你知道，早期的……"}, {"type": "subtitle", "time": 2103.19, "timestamp": "00:35:03", "text": "什么？我只是有一种奇怪而神秘的感觉"}, {"type": "subtitle", "time": 2104.63, "timestamp": "00:35:04", "text": "感觉可能还有一些"}, {"type": "subtitle", "time": 2106.71, "timestamp": "00:35:06", "text": "G3 在某个地方惹麻烦了，你知道的。"}, {"type": "subtitle", "time": 2109.03, "timestamp": "00:35:09", "text": "在城里四处走走。我们应该 我们应该"}, {"type": "subtitle", "time": 2112.55, "timestamp": "00:35:12", "text": "或许该处理一下。这看起来像"}, {"type": "subtitle", "time": 2129.75, "timestamp": "00:35:29", "text": "[音乐]"}, {"type": "subtitle", "time": 2151.19, "timestamp": "00:35:51", "text": "呃，我不能。瞧我们走得多远。"}, {"type": "subtitle", "time": 2156.15, "timestamp": "00:35:56", "text": "砰。所以，这个滑动装置只适用于……"}, {"type": "subtitle", "time": 2159.589, "timestamp": "00:35:59", "text": "地面，而非空中。一号机被射出"}]
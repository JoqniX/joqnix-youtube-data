[{"type": "subtitle", "time": 11462.07, "timestamp": "03:11:02", "text": "如果我没加入公会，我就不在公会里。"}, {"type": "subtitle", "time": 11464.63, "timestamp": "03:11:04", "text": "犯错或者如果我没做到"}, {"type": "subtitle", "time": 11466.23, "timestamp": "03:11:06", "text": "为了正义或类似的事情，什么都行。"}, {"type": "subtitle", "time": 11468.59, "timestamp": "03:11:08", "text": "那。是的，"}, {"type": "subtitle", "time": 11472.23, "timestamp": "03:11:12", "text": "但那是我的作品之一。我当时"}, {"type": "subtitle", "time": 11474.71, "timestamp": "03:11:14", "text": "希望这样的事情永远不会再发生。"}, {"type": "subtitle", "time": 11476.79, "timestamp": "03:11:16", "text": "目前，Jock 设计是，即使是"}, {"type": "subtitle", "time": 11479.03, "timestamp": "03:11:19", "text": "尚未证实，或者即便证实了也未证实。"}, {"type": "subtitle", "time": 11480.429, "timestamp": "03:11:20", "text": "官方或"}, {"type": "subtitle", "time": 11484.51, "timestamp": "03:11:24", "text": "一直把他叫醒，真是太难受了。"}, {"type": "subtitle", "time": 11491.389, "timestamp": "03:11:31", "text": "三年过去了？ 3年"}, {"type": "subtitle", "time": 11493.95, "timestamp": "03:11:33", "text": "现在，"}, {"type": "subtitle", "time": 11496.95, "timestamp": "03:11:36", "text": "医生。每次我看到有人"}, {"type": "subtitle", "time": 11498.349, "timestamp": "03:11:38", "text": "名字"}, {"type": "subtitle", "time": 11501.469, "timestamp": "03:11:41", "text": "乔克，我立刻就走了"}, {"type": "subtitle", "time": 11504.269, "timestamp": "03:11:44", "text": "乐队"}, {"type": "subtitle", "time": 11511.59, "timestamp": "03:11:51", "text": "疯狂的。是的。彻底疯掉。那是"}, {"type": "subtitle", "time": 11514.15, "timestamp": "03:11:54", "text": "我之所以要确保永远不会有人这样做。"}, {"type": "subtitle", "time": 11515.99, "timestamp": "03:11:55", "text": "不。是的。实际上不会有人真的"}, {"type": "subtitle", "time": 11518.51, "timestamp": "03:11:58", "text": "冒充他人或其他什么"}]
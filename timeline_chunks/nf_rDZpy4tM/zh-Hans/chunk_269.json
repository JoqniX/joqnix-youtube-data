[{"type": "subtitle", "time": 16141.51, "timestamp": "04:29:01", "text": "[音乐]"}, {"type": "subtitle", "time": 16151.67, "timestamp": "04:29:11", "text": "去。她挺可爱的。哦，那是一个"}, {"type": "subtitle", "time": 16155.149, "timestamp": "04:29:15", "text": "巨大的龙头。"}, {"type": "subtitle", "time": 16157.269, "timestamp": "04:29:17", "text": "哇。哦，你一直收到……"}, {"type": "subtitle", "time": 16159.59, "timestamp": "04:29:19", "text": "倒叙。"}, {"type": "subtitle", "time": 16171.349, "timestamp": "04:29:31", "text": "这？怎么了？你受伤了吗？"}, {"type": "subtitle", "time": 16174.51, "timestamp": "04:29:34", "text": "打架？"}, {"type": "subtitle", "time": 16179.67, "timestamp": "04:29:39", "text": "亲爱的，我想我记起一件事了。"}, {"type": "subtitle", "time": 16184.229, "timestamp": "04:29:44", "text": "你在记忆中看到了我们的哨兵。"}, {"type": "subtitle", "time": 16186.55, "timestamp": "04:29:46", "text": "哨兵？"}, {"type": "subtitle", "time": 16190.309, "timestamp": "04:29:50", "text": "是的。我们为他/她建造了这座雕像。"}, {"type": "subtitle", "time": 16193.91, "timestamp": "04:29:53", "text": "Jen Joe 中的 Oracle Engine Sentinel。"}, {"type": "subtitle", "time": 16197.67, "timestamp": "04:29:57", "text": "啊，Oracle引擎。香港的六个城市"}]
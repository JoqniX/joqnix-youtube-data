[{"type": "subtitle", "time": 8644.389, "timestamp": "02:24:04", "text": "好了，我们把这件事做完吧。我们走吧"}, {"type": "subtitle", "time": 8655.55, "timestamp": "02:24:15", "text": "是的，我们一路跋涉来到这里。"}, {"type": "subtitle", "time": 8658.63, "timestamp": "02:24:18", "text": "正确的？我们真的走到最后了吗？"}, {"type": "subtitle", "time": 8671.99, "timestamp": "02:24:31", "text": "嘿，舔蛋虫。我要把你变成"}, {"type": "subtitle", "time": 8674.52, "timestamp": "02:24:34", "text": "雾蛋。"}, {"type": "subtitle", "time": 8687.27, "timestamp": "02:24:47", "text": "[音乐]"}, {"type": "subtitle", "time": 8689.59, "timestamp": "02:24:49", "text": "好的，又是道格拉斯。这条广告即将开始"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "酷刑。不是"}, {"type": "subtitle", "time": 8694.55, "timestamp": "02:24:54", "text": "我们要一路走到最后。不，她不会。"}, {"type": "subtitle", "time": 8696.79, "timestamp": "02:24:56", "text": "让我们或者任何东西。它就像……"}, {"type": "subtitle", "time": 8699.389, "timestamp": "02:24:59", "text": "提醒。哦，我的"}]
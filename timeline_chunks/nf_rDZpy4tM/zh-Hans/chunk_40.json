[{"type": "subtitle", "time": 2402.39, "timestamp": "00:40:02", "text": "看看他。他的脸被打伤了"}, {"type": "subtitle", "time": 2404.67, "timestamp": "00:40:04", "text": "某物。"}, {"type": "subtitle", "time": 2408.23, "timestamp": "00:40:08", "text": "哇。看看肯尼·陈的下场。"}, {"type": "subtitle", "time": 2411.75, "timestamp": "00:40:11", "text": "我的天啊。他的脸。他的脸不见了。"}, {"type": "subtitle", "time": 2413.829, "timestamp": "00:40:13", "text": "它不见了。游戏会给予回报"}, {"type": "subtitle", "time": 2420.31, "timestamp": "00:40:20", "text": "嘿，伙计。你不是本地人"}, {"type": "subtitle", "time": 2422.55, "timestamp": "00:40:22", "text": "你在这儿吗？我猜听起来像是"}, {"type": "subtitle", "time": 2425.43, "timestamp": "00:40:25", "text": "有点老套了。"}, {"type": "subtitle", "time": 2426.75, "timestamp": "00:40:26", "text": "不，"}, {"type": "subtitle", "time": 2441.67, "timestamp": "00:40:41", "text": "知道。很有意思的直播标题。是的，我"}, {"type": "subtitle", "time": 2444.63, "timestamp": "00:40:44", "text": "我不想杀他们，但我不得不……"}, {"type": "subtitle", "time": 2447.109, "timestamp": "00:40:47", "text": "等待。"}, {"type": "subtitle", "time": 2448.91, "timestamp": "00:40:48", "text": "我的名字是Yeah。"}, {"type": "subtitle", "time": 2452.23, "timestamp": "00:40:52", "text": "你好。你好吗？因为有一次我……"}, {"type": "subtitle", "time": 2453.99, "timestamp": "00:40:53", "text": "我喝得酩酊大醉，把手伸进了一个大……"}, {"type": "subtitle", "time": 2456.63, "timestamp": "00:40:56", "text": "蛋糕。他们觉得这太搞笑了"}, {"type": "subtitle", "time": 2457.95, "timestamp": "00:40:57", "text": "开始打电话"}]
[{"type": "subtitle", "time": 14101.429, "timestamp": "03:55:01", "text": "是的，我只有几个账户。一"}, {"type": "subtitle", "time": 14106.469, "timestamp": "03:55:06", "text": "例如用于 YouTube 等平台。我没有"}, {"type": "subtitle", "time": 14107.309, "timestamp": "03:55:07", "text": "甚至"}, {"type": "subtitle", "time": 14111.59, "timestamp": "03:55:11", "text": "后来我才知道，我开始这么做了。我"}, {"type": "subtitle", "time": 14113.91, "timestamp": "03:55:13", "text": "仍然认为这次清洗还没有完全完成"}, {"type": "subtitle", "time": 14116.71, "timestamp": "03:55:16", "text": "特别是我的粉丝们，已经完成了。现在"}, {"type": "subtitle", "time": 14118.95, "timestamp": "03:55:18", "text": "关注我们，清洗工作已完成，但关注者"}, {"type": "subtitle", "time": 14121.229, "timestamp": "03:55:21", "text": "我需要清理一下"}, {"type": "subtitle", "time": 14124.75, "timestamp": "03:55:24", "text": "我是一个愿意支持的人。"}, {"type": "subtitle", "time": 14127.189, "timestamp": "03:55:27", "text": "除了你，其他人都在关注你的账号。"}, {"type": "subtitle", "time": 14129.79, "timestamp": "03:55:29", "text": "社交媒体是有局限性的，对吧？"}, {"type": "subtitle", "time": 14132.79, "timestamp": "03:55:32", "text": "Twitch 我快要达到上限了"}, {"type": "subtitle", "time": 14135.269, "timestamp": "03:55:35", "text": "Twitch 我无法再关注任何人了，因为"}, {"type": "subtitle", "time": 14137.95, "timestamp": "03:55:37", "text": "我的关注者数量达到了2000人的上限。"}, {"type": "subtitle", "time": 14141.71, "timestamp": "03:55:41", "text": "我甚至联系了 YouTube 等频道。"}, {"type": "subtitle", "time": 14144.67, "timestamp": "03:55:44", "text": "有7000人关注"}, {"type": "subtitle", "time": 14148.429, "timestamp": "03:55:48", "text": "订阅 订阅 用户"}, {"type": "subtitle", "time": 14151.03, "timestamp": "03:55:51", "text": "我不得不清除所有频道。"}, {"type": "subtitle", "time": 14153.55, "timestamp": "03:55:53", "text": "其中之一"}, {"type": "subtitle", "time": 14155.99, "timestamp": "03:55:55", "text": "令人遗憾。哦，等等。我还有吗？"}, {"type": "subtitle", "time": 14158.63, "timestamp": "03:55:58", "text": "备份 CSV 文件？我忘了。我需要"}]
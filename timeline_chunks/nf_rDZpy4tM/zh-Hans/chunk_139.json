[{"type": "subtitle", "time": 8352.79, "timestamp": "02:19:12", "text": "[音乐]"}, {"type": "subtitle", "time": 8356.469, "timestamp": "02:19:16", "text": "哦，这个懦夫想躲起来啊？出色地，"}, {"type": "subtitle", "time": 8360.23, "timestamp": "02:19:20", "text": "它不会向女皇收取任何费用。"}, {"type": "subtitle", "time": 8363.75, "timestamp": "02:19:23", "text": "那甜美的屁股。爽！他没有"}, {"type": "subtitle", "time": 8367.349, "timestamp": "02:19:27", "text": "他完全不知道发生了什么。哦，现在我们得去……"}, {"type": "subtitle", "time": 8369.589, "timestamp": "02:19:29", "text": "对面，是吗？嘿，你想看看什么"}, {"type": "subtitle", "time": 8372.309, "timestamp": "02:19:32", "text": "这次泡沫还能做什么呢？哦，什么？"}, {"type": "subtitle", "time": 8375.83, "timestamp": "02:19:35", "text": "我还能做什么？哦，我有"}, {"type": "subtitle", "time": 8378.95, "timestamp": "02:19:38", "text": "停车。伟大的。完美的。"}, {"type": "subtitle", "time": 8381.27, "timestamp": "02:19:41", "text": "现在，快点过马路。哦，原来是这样。"}, {"type": "subtitle", "time": 8385.589, "timestamp": "02:19:45", "text": "你做。我很好。"}, {"type": "subtitle", "time": 8388.07, "timestamp": "02:19:48", "text": "你看，我的时间泡泡只能做到这一点。"}, {"type": "subtitle", "time": 8389.83, "timestamp": "02:19:49", "text": "很多。你得去接"}, {"type": "subtitle", "time": 8392.87, "timestamp": "02:19:52", "text": "其余的松弛部分。"}, {"type": "subtitle", "time": 8394.63, "timestamp": "02:19:54", "text": "快速回传。时间泡"}, {"type": "subtitle", "time": 8396.79, "timestamp": "02:19:56", "text": "你知道，这种事不会永远持续下去。"}, {"type": "subtitle", "time": 8399.83, "timestamp": "02:19:59", "text": "难以置信，对吧？真是太刺激了。你"}]
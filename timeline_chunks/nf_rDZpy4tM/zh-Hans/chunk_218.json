[{"type": "subtitle", "time": 13080.55, "timestamp": "03:38:00", "text": "善行，帮助他人，做家务或"}, {"type": "subtitle", "time": 13083.429, "timestamp": "03:38:03", "text": "任何。和某人交谈"}, {"type": "subtitle", "time": 13086.67, "timestamp": "03:38:06", "text": "无论是否感到孤独，过得好不好，等等等等"}, {"type": "subtitle", "time": 13090.349, "timestamp": "03:38:10", "text": "东西。尽你所能陪伴在他们身边。"}, {"type": "subtitle", "time": 13093.51, "timestamp": "03:38:13", "text": "有人和其他人，是的。每日"}, {"type": "subtitle", "time": 13097.67, "timestamp": "03:38:17", "text": "善行。是的。主要就是这样。嗯。"}, {"type": "subtitle", "time": 13099.389, "timestamp": "03:38:19", "text": "那"}, {"type": "subtitle", "time": 13102.309, "timestamp": "03:38:22", "text": "你应该通过 VC 来这里。"}, {"type": "subtitle", "time": 13105.51, "timestamp": "03:38:25", "text": "你知道，乔，就是那种会议。是的，这就是原因。"}, {"type": "subtitle", "time": 13108.07, "timestamp": "03:38:28", "text": "我刚才说的是“呃”。是的，我想要"}, {"type": "subtitle", "time": 13111.71, "timestamp": "03:38:31", "text": "像聚会一样"}, {"type": "subtitle", "time": 13119.99, "timestamp": "03:38:39", "text": "周末，每个周末，但我也是"}, {"type": "subtitle", "time": 13124.269, "timestamp": "03:38:44", "text": "做匈牙利菜，对吧？所以，我很担心"}, {"type": "subtitle", "time": 13127.95, "timestamp": "03:38:47", "text": "如果我担心如果"}, {"type": "subtitle", "time": 13131.63, "timestamp": "03:38:51", "text": "嗯，是的，我很担心。"}, {"type": "subtitle", "time": 13134.71, "timestamp": "03:38:54", "text": "如果至少需要1小时，那么2小时就足够了。"}, {"type": "subtitle", "time": 13136.71, "timestamp": "03:38:56", "text": "我至少可以待一会儿，然后我就走。"}, {"type": "subtitle", "time": 13139.83, "timestamp": "03:38:59", "text": "回到我的直播间。我希望不会如此。"}]
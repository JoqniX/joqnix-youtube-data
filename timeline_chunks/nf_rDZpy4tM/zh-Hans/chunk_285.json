[{"type": "subtitle", "time": 17101.43, "timestamp": "04:45:01", "text": "班级。抱歉。我们有点"}, {"type": "subtitle", "time": 17105.51, "timestamp": "04:45:05", "text": "被带走了。是否存在混响或回声"}, {"type": "subtitle", "time": 17108.788, "timestamp": "04:45:08", "text": "是不是觉得似曾相识？混响。回声。哦，"}, {"type": "subtitle", "time": 17110.788, "timestamp": "04:45:10", "text": "音乐相关的内容。"}, {"type": "subtitle", "time": 17112.55, "timestamp": "04:45:12", "text": "我们世界中的一切都由……构成"}, {"type": "subtitle", "time": 17114.948, "timestamp": "04:45:14", "text": "频率。每一种声音都会产生一种"}, {"type": "subtitle", "time": 17118.788, "timestamp": "04:45:18", "text": "混响。哦，那些回声"}, {"type": "subtitle", "time": 17120.948, "timestamp": "04:45:20", "text": "酸味的余音挥之不去"}, {"type": "subtitle", "time": 17123.868, "timestamp": "04:45:23", "text": "不和谐。让我打开我的"}, {"type": "subtitle", "time": 17128.66, "timestamp": "04:45:28", "text": "我们盘古航站楼的风扇组。"}, {"type": "subtitle", "time": 17131.83, "timestamp": "04:45:31", "text": "[音乐]"}, {"type": "subtitle", "time": 17133.99, "timestamp": "04:45:33", "text": "外面下着瓢泼大雨。"}, {"type": "subtitle", "time": 17136.47, "timestamp": "04:45:36", "text": "我这里正在发生一些事情。我不知道"}, {"type": "subtitle", "time": 17138.39, "timestamp": "04:45:38", "text": "如果你能听到的话。我的降噪功能"}, {"type": "subtitle", "time": 17141.27, "timestamp": "04:45:41", "text": "或许这消息太好了，不听可惜。但"}, {"type": "subtitle", "time": 17144.23, "timestamp": "04:45:44", "text": "是的，就像一封重重的信。"}, {"type": "subtitle", "time": 17146.47, "timestamp": "04:45:46", "text": "暴雨倾盆而下。"}, {"type": "subtitle", "time": 17150.868, "timestamp": "04:45:50", "text": "现在弗拉德的街道一片狼藉。哦，真是恐慌"}, {"type": "subtitle", "time": 17152.788, "timestamp": "04:45:52", "text": "终端，她指的是葫芦状的"}, {"type": "subtitle", "time": 17155.51, "timestamp": "04:45:55", "text": "每个谐振器都开发了这种装置"}, {"type": "subtitle", "time": 17157.67, "timestamp": "04:45:57", "text": "广隆的研究人员。但是你看，"}, {"type": "subtitle", "time": 17159.99, "timestamp": "04:45:59", "text": "我们并非总能找到这些东西。"}]
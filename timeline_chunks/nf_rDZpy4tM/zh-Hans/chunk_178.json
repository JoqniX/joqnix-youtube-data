[{"type": "subtitle", "time": 10687.03, "timestamp": "02:58:07", "text": "但是，今天是星期四，对吧？"}, {"type": "subtitle", "time": 10688.349, "timestamp": "02:58:08", "text": "明天就是"}, {"type": "subtitle", "time": 10692.4, "timestamp": "02:58:12", "text": "周末是星期天，对吧？"}, {"type": "subtitle", "time": 10693.469, "timestamp": "02:58:13", "text": "[音乐]"}, {"type": "subtitle", "time": 10696.15, "timestamp": "02:58:16", "text": "总之，我想和你一起出去玩。"}, {"type": "subtitle", "time": 10697.389, "timestamp": "02:58:17", "text": "伙计们"}, {"type": "subtitle", "time": 10701.51, "timestamp": "02:58:21", "text": "实际上。我不知道。不知道我是否"}, {"type": "subtitle", "time": 10704.51, "timestamp": "02:58:24", "text": "不知道你们会不会"}, {"type": "subtitle", "time": 10706.51, "timestamp": "02:58:26", "text": "免费，但是"}, {"type": "subtitle", "time": 10709.269, "timestamp": "02:58:29", "text": "是啊，我需要弄到服务器。"}, {"type": "subtitle", "time": 10712.51, "timestamp": "02:58:32", "text": "也十分活跃。不想太"}, {"type": "subtitle", "time": 10716.389, "timestamp": "02:58:36", "text": "不活跃。是的，我们会做一些事情。"}, {"type": "subtitle", "time": 10718.63, "timestamp": "02:58:38", "text": "我会组织个活动什么的。但"}, {"type": "subtitle", "time": 10721.51, "timestamp": "02:58:41", "text": "我也担心如果"}, {"type": "subtitle", "time": 10723.51, "timestamp": "02:58:43", "text": "嗯，对，星期五，明天就出发了。"}, {"type": "subtitle", "time": 10726.83, "timestamp": "02:58:46", "text": "因洪而成为一条长溪"}, {"type": "subtitle", "time": 10731.87, "timestamp": "02:58:51", "text": "凯。所以我很困惑，这到底会如何发展。"}, {"type": "subtitle", "time": 10734.67, "timestamp": "02:58:54", "text": "去。"}, {"type": "subtitle", "time": 10737.07, "timestamp": "02:58:57", "text": "H"}]
[{"type": "subtitle", "time": 12721.99, "timestamp": "03:32:01", "text": "他们事事都要拿出结果来。或者"}, {"type": "subtitle", "time": 12725.03, "timestamp": "03:32:05", "text": "否则他们就会被解雇，或者像……一样。"}, {"type": "subtitle", "time": 12728.15, "timestamp": "03:32:08", "text": "延期或借口，而不是借口"}, {"type": "subtitle", "time": 12730.389, "timestamp": "03:32:10", "text": "就像你知道的，截止日期之类的。"}, {"type": "subtitle", "time": 12732.429, "timestamp": "03:32:12", "text": "为了提供所有这些，就像"}, {"type": "subtitle", "time": 12734.95, "timestamp": "03:32:14", "text": "那。但如果你自己动手的话"}, {"type": "subtitle", "time": 12738.229, "timestamp": "03:32:18", "text": "你拥有某种程度的自由，但同时也……"}, {"type": "subtitle", "time": 12739.95, "timestamp": "03:32:19", "text": "如果你有那么多钱"}, {"type": "subtitle", "time": 12743.349, "timestamp": "03:32:23", "text": "某种程度上的自由，你可能会因此而懈怠，但"}, {"type": "subtitle", "time": 12744.51, "timestamp": "03:32:24", "text": "如果你"}, {"type": "subtitle", "time": 12749.59, "timestamp": "03:32:29", "text": "放松警惕。你会继续尽力而为。"}, {"type": "subtitle", "time": 12750.349, "timestamp": "03:32:30", "text": "喜欢"}, {"type": "subtitle", "time": 12752.79, "timestamp": "03:32:32", "text": "是吗？你可以这样理解："}, {"type": "subtitle", "time": 12755.95, "timestamp": "03:32:35", "text": "那。不要把捐赠看作一件严肃的事情"}, {"type": "subtitle", "time": 12760.15, "timestamp": "03:32:40", "text": "事物。我的意思是，如果你愿意的话，当然可以。"}, {"type": "subtitle", "time": 12767.51, "timestamp": "03:32:47", "text": "沙。那么，呃，让我继续说下去……"}, {"type": "subtitle", "time": 12770.15, "timestamp": "03:32:50", "text": "当时路过的人。 Vaigata 的"}, {"type": "subtitle", "time": 12772.389, "timestamp": "03:32:52", "text": "路过。希望你今天过得愉快。希望"}, {"type": "subtitle", "time": 12774.99, "timestamp": "03:32:54", "text": "对你来说很有趣吗？"}, {"type": "subtitle", "time": 12778.03, "timestamp": "03:32:58", "text": "未来。玛雅桑也来了"}]
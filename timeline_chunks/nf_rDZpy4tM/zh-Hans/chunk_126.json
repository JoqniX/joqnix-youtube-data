[{"type": "subtitle", "time": 7560.669, "timestamp": "02:06:00", "text": "这。哦，太棒了。普利茅斯，"}, {"type": "subtitle", "time": 7583.109, "timestamp": "02:06:23", "text": "你为什么这么想杀了他们？我是"}, {"type": "subtitle", "time": 7590.31, "timestamp": "02:06:30", "text": "你真擅长这些。有些人"}, {"type": "subtitle", "time": 7591.95, "timestamp": "02:06:31", "text": "毕业后学点商业之类的东西，但是"}, {"type": "subtitle", "time": 7596.149, "timestamp": "02:06:36", "text": "一切隐藏在事物背后的东西。对，就是那个。"}, {"type": "subtitle", "time": 7598.31, "timestamp": "02:06:38", "text": "钠也体现了这一点。一些"}, {"type": "subtitle", "time": 7600.43, "timestamp": "02:06:40", "text": "人们会这样做。"}, {"type": "subtitle", "time": 7604.149, "timestamp": "02:06:44", "text": "是的。确切地。"}, {"type": "subtitle", "time": 7607.229, "timestamp": "02:06:47", "text": "哦，天哪，这真是……"}, {"type": "subtitle", "time": 7618.51, "timestamp": "02:06:58", "text": "[音乐]"}]
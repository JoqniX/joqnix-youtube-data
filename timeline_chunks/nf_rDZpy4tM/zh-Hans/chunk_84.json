[{"type": "subtitle", "time": 5043.03, "timestamp": "01:24:03", "text": "社区权利，然后是这部分"}, {"type": "subtitle", "time": 5046.39, "timestamp": "01:24:06", "text": "维护社区和类似"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "嗯，是的，维护一个社区，这样……"}, {"type": "subtitle", "time": 5051.51, "timestamp": "01:24:11", "text": "它，呃，它有持久的影响，或者"}, {"type": "subtitle", "time": 5054.31, "timestamp": "01:24:14", "text": "好像会永远持续下去似的，因为"}, {"type": "subtitle", "time": 5056.31, "timestamp": "01:24:16", "text": "有些社区可以"}, {"type": "subtitle", "time": 5058.31, "timestamp": "01:24:18", "text": "断开，就像断开的意思"}, {"type": "subtitle", "time": 5061.75, "timestamp": "01:24:21", "text": "它们可能会像这样断裂，嗯，你觉得怎么样？"}, {"type": "subtitle", "time": 5063.51, "timestamp": "01:24:23", "text": "叫它什么？我不知道这个例子是什么。"}, {"type": "subtitle", "time": 5066.31, "timestamp": "01:24:26", "text": "就像说你做了某件事……"}, {"type": "subtitle", "time": 5068.47, "timestamp": "01:24:28", "text": "类似追云之类的活动"}, {"type": "subtitle", "time": 5069.99, "timestamp": "01:24:29", "text": "你投入到戏剧中的事情"}, {"type": "subtitle", "time": 5072.79, "timestamp": "01:24:32", "text": "然后你的社区会更喜欢一切"}, {"type": "subtitle", "time": 5074.229, "timestamp": "01:24:34", "text": "你所在社区一半的人都讨厌你，或者"}, {"type": "subtitle", "time": 5076.709, "timestamp": "01:24:36", "text": "如果做对了，你的社区就会"}, {"type": "subtitle", "time": 5079.99, "timestamp": "01:24:39", "text": "分开之后，一方会恨你。"}, {"type": "subtitle", "time": 5082.59, "timestamp": "01:24:42", "text": "一方即便明知也会如此"}, {"type": "subtitle", "time": 5086.629, "timestamp": "01:24:46", "text": "他们知道你做错了。"}, {"type": "subtitle", "time": 5089.669, "timestamp": "01:24:49", "text": "但他们作为人，依然会是他们。"}, {"type": "subtitle", "time": 5092.229, "timestamp": "01:24:52", "text": "他们会支持你，所以他们希望"}, {"type": "subtitle", "time": 5093.83, "timestamp": "01:24:53", "text": "你仍然可以更改或类似的东西"}, {"type": "subtitle", "time": 5096.149, "timestamp": "01:24:56", "text": "是吗？两个不同的部分。你可以"}, {"type": "subtitle", "time": 5099.39, "timestamp": "01:24:59", "text": "在大多数互联网上都能看到这种情况"}]
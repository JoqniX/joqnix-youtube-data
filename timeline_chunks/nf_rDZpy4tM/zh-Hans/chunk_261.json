[{"type": "subtitle", "time": 15660.349, "timestamp": "04:21:00", "text": "为什么？我以为你们都喜欢"}, {"type": "subtitle", "time": 15664.229, "timestamp": "04:21:04", "text": "我。我心想：等等，这是怎么回事？"}, {"type": "subtitle", "time": 15666.83, "timestamp": "04:21:06", "text": "她？她正在获得"}, {"type": "subtitle", "time": 15675.469, "timestamp": "04:21:15", "text": "为什么？为什么要放手？为什么是最后一个"}, {"type": "subtitle", "time": 15686.87, "timestamp": "04:21:26", "text": "不，是海浪。"}, {"type": "subtitle", "time": 15689.91, "timestamp": "04:21:29", "text": "我的天啊。哦，谢谢你。"}, {"type": "subtitle", "time": 15690.95, "timestamp": "04:21:30", "text": "事物。哦，谢谢。谢谢。感谢"}, {"type": "subtitle", "time": 15692.95, "timestamp": "04:21:32", "text": "你。谢谢。谢谢。我，我就……"}, {"type": "subtitle", "time": 15713.149, "timestamp": "04:21:53", "text": "哇。这是"}]
[{"type": "subtitle", "time": 9480.469, "timestamp": "02:38:00", "text": "你会喜欢的。"}, {"type": "subtitle", "time": 9482.51, "timestamp": "02:38:02", "text": "那是一个很长的"}, {"type": "subtitle", "time": 9486.55, "timestamp": "02:38:06", "text": "骑？你不觉得无聊吗？"}, {"type": "subtitle", "time": 9488.389, "timestamp": "02:38:08", "text": "您可以亲自去参观这个人类避难所。"}, {"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "顺便说一句，我们并不确切知道是什么"}, {"type": "subtitle", "time": 9491.67, "timestamp": "02:38:11", "text": "让人感到舒适，但我希望你"}, {"type": "subtitle", "time": 9509.11, "timestamp": "02:38:29", "text": "哦，一切顺利啊？等等，为什么我不能"}, {"type": "subtitle", "time": 9510.95, "timestamp": "02:38:30", "text": "停止移动？"}, {"type": "subtitle", "time": 9514.07, "timestamp": "02:38:34", "text": "G3 直到找到为止。是的，不仅如此，"}, {"type": "subtitle", "time": 9516.389, "timestamp": "02:38:36", "text": "他给了我们拯救人类的方法。上帝"}, {"type": "subtitle", "time": 9519.59, "timestamp": "02:38:39", "text": "真棒，你做到了。没有什么比这更方便的了"}, {"type": "subtitle", "time": 9521.11, "timestamp": "02:38:41", "text": "这事儿在我当赏金猎人的时候发生过吗？"}, {"type": "subtitle", "time": 9524.469, "timestamp": "02:38:44", "text": "打猎。嘿，呃，说到这个，我们应该"}, {"type": "subtitle", "time": 9525.99, "timestamp": "02:38:45", "text": "回去之前记得给你弄个喷气背包。"}, {"type": "subtitle", "time": 9527.67, "timestamp": "02:38:47", "text": "走到田野里。你真的要走了"}, {"type": "subtitle", "time": 9529.67, "timestamp": "02:38:49", "text": "需要它。前往兵营"}, {"type": "subtitle", "time": 9531.51, "timestamp": "02:38:51", "text": "去店里看看有没有现货。"}, {"type": "subtitle", "time": 9533.11, "timestamp": "02:38:53", "text": "哦，对了，你可能想联系一下"}, {"type": "subtitle", "time": 9535.19, "timestamp": "02:38:55", "text": "Borto Chef 也设有展位。她有点"}, {"type": "subtitle", "time": 9537.429, "timestamp": "02:38:57", "text": "虽然有点可疑，但是呃，那些战争光盘是他"}]
[{"type": "subtitle", "time": 4441.11, "timestamp": "01:14:01", "text": "我叫朱皮博士。道格拉斯绑架了我"}, {"type": "subtitle", "time": 4442.79, "timestamp": "01:14:02", "text": "我和全家人正试图偷偷溜进去。"}, {"type": "subtitle", "time": 4445.189, "timestamp": "01:14:05", "text": "把它们保存下来。过不去这些"}, {"type": "subtitle", "time": 4447.51, "timestamp": "01:14:07", "text": "隔壁房间的管道。我的天哪，我"}, {"type": "subtitle", "time": 4450.07, "timestamp": "01:14:10", "text": "吓坏了。嘿，等等，等等。听，"}, {"type": "subtitle", "time": 4452.149, "timestamp": "01:14:12", "text": "小家伙。我们正在寻找"}, {"type": "subtitle", "time": 4454.39, "timestamp": "01:14:14", "text": "道格拉斯也是。你知道，或许我们可以"}, {"type": "subtitle", "time": 4456.63, "timestamp": "01:14:16", "text": "互相帮助。天哪，我好担心……"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "想吐。你真的在帮我吗？"}, {"type": "subtitle", "time": 4471.669, "timestamp": "01:14:31", "text": "你得帮我把这些管道连接起来。"}, {"type": "subtitle", "time": 4474.47, "timestamp": "01:14:34", "text": "我可以挺过去，救我的家人。"}, {"type": "subtitle", "time": 4476.63, "timestamp": "01:14:36", "text": "嘿。小家伙，猜猜会发生什么？我"}, {"type": "subtitle", "time": 4478.47, "timestamp": "01:14:38", "text": "热爱拼图游戏。我百看不厌"}, {"type": "subtitle", "time": 4480.149, "timestamp": "01:14:40", "text": "他们。我们将会有一点“哦”，"}, {"type": "subtitle", "time": 4491.51, "timestamp": "01:14:51", "text": "您也能说说您的看法吗？哇，"}, {"type": "subtitle", "time": 4495.75, "timestamp": "01:14:55", "text": "你做到了。你拿到了门。呃，"}, {"type": "subtitle", "time": 4498.63, "timestamp": "01:14:58", "text": "我希望是哦，天哪。"}, {"type": "subtitle", "time": 4499.95, "timestamp": "01:14:59", "text": "不"}]
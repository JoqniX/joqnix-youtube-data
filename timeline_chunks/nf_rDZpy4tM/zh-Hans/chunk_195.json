[{"type": "subtitle", "time": 11700.07, "timestamp": "03:15:00", "text": "小丑是什么？我永远不知道会发生什么"}, {"type": "subtitle", "time": 11702.51, "timestamp": "03:15:02", "text": "小丑是"}, {"type": "subtitle", "time": 11705.11, "timestamp": "03:15:05", "text": "直到我的窗户。等等，我被……了吗？"}, {"type": "subtitle", "time": 11706.91, "timestamp": "03:15:06", "text": "某物"}, {"type": "subtitle", "time": 11709.99, "timestamp": "03:15:09", "text": "只是一个职业小丑或者一个"}, {"type": "subtitle", "time": 11712.309, "timestamp": "03:15:12", "text": "医疗法庭重复帽子的傻瓜"}, {"type": "subtitle", "time": 11715.11, "timestamp": "03:15:15", "text": "上面挂着铃铛，还带着一个假想的"}, {"type": "subtitle", "time": 11717.55, "timestamp": "03:15:17", "text": "权杖。哦，一个"}, {"type": "subtitle", "time": 11720.24, "timestamp": "03:15:20", "text": "胸部。那很有意思。"}, {"type": "subtitle", "time": 11723.83, "timestamp": "03:15:23", "text": "[音乐]"}, {"type": "subtitle", "time": 11730.309, "timestamp": "03:15:30", "text": "是啊，某种程度上我开始这么想"}, {"type": "subtitle", "time": 11733.19, "timestamp": "03:15:33", "text": "我开始以不同的方式看待这件事，就像我开始……"}, {"type": "subtitle", "time": 11736.309, "timestamp": "03:15:36", "text": "接受吧。但如果说到什么呢？"}, {"type": "subtitle", "time": 11740.11, "timestamp": "03:15:40", "text": "我想要，对吧？如果我能逃出去"}, {"type": "subtitle", "time": 11743.19, "timestamp": "03:15:43", "text": "在那里，你可以与任何人合作"}, {"type": "subtitle", "time": 11745.15, "timestamp": "03:15:45", "text": "我希望有一天，"}, {"type": "subtitle", "time": 11748.71, "timestamp": "03:15:48", "text": "正确的？合作或喜欢会很酷"}, {"type": "subtitle", "time": 11752.229, "timestamp": "03:15:52", "text": "说点什么，但还是……嗯，走吧。谈谈"}, {"type": "subtitle", "time": 11754.429, "timestamp": "03:15:54", "text": "但加夫是个但是"}]
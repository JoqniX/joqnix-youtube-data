[{"type": "subtitle", "time": 11520.95, "timestamp": "03:12:00", "text": "东西。是的。是的。是的。连标志都是如此。"}, {"type": "subtitle", "time": 11523.51, "timestamp": "03:12:03", "text": "我想我刚开始的时候就是这样。"}, {"type": "subtitle", "time": 11526.63, "timestamp": "03:12:06", "text": "Jockn，我已经遇到过这个问题了。有点儿"}, {"type": "subtitle", "time": 11528.389, "timestamp": "03:12:08", "text": "最讨厌相似的地方了"}, {"type": "subtitle", "time": 11530.79, "timestamp": "03:12:10", "text": "或者像和你同名的人一样"}, {"type": "subtitle", "time": 11533.19, "timestamp": "03:12:13", "text": "某物。这就是为什么我确保大多数"}, {"type": "subtitle", "time": 11536.23, "timestamp": "03:12:16", "text": "我所有的所有角色，从未"}, {"type": "subtitle", "time": 11538.87, "timestamp": "03:12:18", "text": "共享或类似名称"}, {"type": "subtitle", "time": 11542.79, "timestamp": "03:12:22", "text": "任何人。即使从设计或其他方面来看，"}, {"type": "subtitle", "time": 11545.429, "timestamp": "03:12:25", "text": "至于标志方面，什么都行。是的。必须是"}, {"type": "subtitle", "time": 11547.23, "timestamp": "03:12:27", "text": "独特的。必须"}, {"type": "subtitle", "time": 11550.469, "timestamp": "03:12:30", "text": "忠于自己，真心实意地爱自己"}, {"type": "subtitle", "time": 11553.07, "timestamp": "03:12:33", "text": "独特的。是的。"}, {"type": "subtitle", "time": 11555.75, "timestamp": "03:12:35", "text": "但我不知道。看到这个的时候，我"}, {"type": "subtitle", "time": 11558.309, "timestamp": "03:12:38", "text": "比如，“哇哦，这简直太棒了！”"}, {"type": "subtitle", "time": 11560.79, "timestamp": "03:12:40", "text": "另一种版本的笑话或"}, {"type": "subtitle", "time": 11563.389, "timestamp": "03:12:43", "text": "“某种东西。”我当时就是这么想的。"}, {"type": "subtitle", "time": 11565.75, "timestamp": "03:12:45", "text": "心。是的。我想这就是我的想法。"}, {"type": "subtitle", "time": 11567.469, "timestamp": "03:12:47", "text": "我开始"}, {"type": "subtitle", "time": 11570.03, "timestamp": "03:12:50", "text": "哭泣。开始哭泣"}, {"type": "subtitle", "time": 11575.19, "timestamp": "03:12:55", "text": "出去太多了。但从某种意义上说，当然"}, {"type": "subtitle", "time": 11577.429, "timestamp": "03:12:57", "text": "不，我又不能复制。"}]
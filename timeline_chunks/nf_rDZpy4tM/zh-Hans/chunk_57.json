[{"type": "subtitle", "time": 3421.43, "timestamp": "00:57:01", "text": "在聊天中互相交流，或者像拥抱一样交流"}, {"type": "subtitle", "time": 3425.309, "timestamp": "00:57:05", "text": "某物？我这样做是为了其他人。"}, {"type": "subtitle", "time": 3428.069, "timestamp": "00:57:08", "text": "朋友们可以去他们自己的频道看看。我帮忙"}, {"type": "subtitle", "time": 3430.95, "timestamp": "00:57:10", "text": "出去。哦，我希望我们不是道格拉斯"}, {"type": "subtitle", "time": 3433.19, "timestamp": "00:57:13", "text": "束。那家伙吓死人了"}, {"type": "subtitle", "time": 3435.67, "timestamp": "00:57:15", "text": "我。他当时试图扮演一个活着的加里。"}, {"type": "subtitle", "time": 3437.19, "timestamp": "00:57:17", "text": "昨晚的派对。他本应该"}, {"type": "subtitle", "time": 3438.95, "timestamp": "00:57:18", "text": "诚实地。所以，是的，我也应该这样做。"}, {"type": "subtitle", "time": 3442.23, "timestamp": "00:57:22", "text": "是吗？就像昨晚的聊天一样。我"}, {"type": "subtitle", "time": 3444.15, "timestamp": "00:57:24", "text": "真不敢相信尼普尔竟然出现了。即使"}, {"type": "subtitle", "time": 3446.95, "timestamp": "00:57:26", "text": "它不是视觉上的。尼普尔太酷了。甚至"}, {"type": "subtitle", "time": 3449.43, "timestamp": "00:57:29", "text": "即使不是视觉上的，至少也会如此。"}, {"type": "subtitle", "time": 3451.71, "timestamp": "00:57:31", "text": "要乖哦？尼普尔没那么火了"}, {"type": "subtitle", "time": 3454.87, "timestamp": "00:57:34", "text": "就这样。相信我。而且他很有魅力。"}, {"type": "subtitle", "time": 3457.87, "timestamp": "00:57:37", "text": "拥抱帕特。是的。是的。是的。"}, {"type": "subtitle", "time": 3461.91, "timestamp": "00:57:41", "text": "问：迫不及待想啪啪啪。"}, {"type": "subtitle", "time": 3463.829, "timestamp": "00:57:43", "text": "我通常都很支持宣传，但是……"}, {"type": "subtitle", "time": 3466.95, "timestamp": "00:57:46", "text": "我讨厌G3。我讨厌他们。仍然可以"}, {"type": "subtitle", "time": 3471.27, "timestamp": "00:57:51", "text": "看到你这么小。哦，我当时就像个小……"}, {"type": "subtitle", "time": 3473.03, "timestamp": "00:57:53", "text": "就像他们必须穿过这些人一样"}, {"type": "subtitle", "time": 3475.99, "timestamp": "00:57:55", "text": "就像我一口气吃完一整盒奥利奥饼干一样。哦"}, {"type": "subtitle", "time": 3477.99, "timestamp": "00:57:57", "text": "是的，我自己也杀过几个。"}]
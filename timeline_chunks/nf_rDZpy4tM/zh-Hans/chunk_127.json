[{"type": "subtitle", "time": 7622.31, "timestamp": "02:07:02", "text": "哦，我尽量不去想我的"}, {"type": "subtitle", "time": 7624.47, "timestamp": "02:07:04", "text": "妻子的身体被一个人撕成了两半"}, {"type": "subtitle", "time": 7626.95, "timestamp": "02:07:06", "text": "道格拉斯的酷刑装置，而且是"}, {"type": "subtitle", "time": 7628.95, "timestamp": "02:07:08", "text": "对我来说不起作用。也不是。是的，注意"}, {"type": "subtitle", "time": 7632.27, "timestamp": "02:07:12", "text": "那。我的意思是，菲安娜做了"}, {"type": "subtitle", "time": 7635.43, "timestamp": "02:07:15", "text": "就像在一股流中做的那样的东西"}, {"type": "subtitle", "time": 7638.31, "timestamp": "02:07:18", "text": "网上有一段菲亚娜的视频片段。"}, {"type": "subtitle", "time": 7641.75, "timestamp": "02:07:21", "text": "如果我打算杀人，我会提到这件事"}, {"type": "subtitle", "time": 7644.31, "timestamp": "02:07:24", "text": "我自己也加入他们，呃，你可能会"}, {"type": "subtitle", "time": 7647.03, "timestamp": "02:07:27", "text": "我不知道有没有人知道"}, {"type": "subtitle", "time": 7647.87, "timestamp": "02:07:27", "text": "呃"}, {"type": "subtitle", "time": 7650.55, "timestamp": "02:07:30", "text": "来自正确音乐领域的Sakisan。她"}, {"type": "subtitle", "time": 7653.069, "timestamp": "02:07:33", "text": "其实，呃，我不应该……嗯，我应该……"}, {"type": "subtitle", "time": 7655.35, "timestamp": "02:07:35", "text": "不是。是的。是的。是的。诸如此类的事情。"}, {"type": "subtitle", "time": 7657.03, "timestamp": "02:07:37", "text": "你不应该使用公司的资产。"}, {"type": "subtitle", "time": 7661.43, "timestamp": "02:07:41", "text": "就像菲亚娜一样。是的。南吉·菲亚纳"}, {"type": "subtitle", "time": 7664.149, "timestamp": "02:07:44", "text": "鱼儿游走了。是的。是的。所以你应该"}, {"type": "subtitle", "time": 7665.99, "timestamp": "02:07:45", "text": "不要滥用公司资产"}, {"type": "subtitle", "time": 7668.149, "timestamp": "02:07:48", "text": "比如，如果你的公司给了你……"}, {"type": "subtitle", "time": 7670.55, "timestamp": "02:07:50", "text": "就像卡拉OK清唱版或类似"}, {"type": "subtitle", "time": 7672.47, "timestamp": "02:07:52", "text": "卡拉OK直播的伴奏音乐"}, {"type": "subtitle", "time": 7675.35, "timestamp": "02:07:55", "text": "还有一些其他的东西。我还想让你记住"}]
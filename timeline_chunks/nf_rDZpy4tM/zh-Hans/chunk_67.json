[{"type": "subtitle", "time": 4021.109, "timestamp": "01:07:01", "text": "T3，我们必须分组吗？"}, {"type": "subtitle", "time": 4023.349, "timestamp": "01:07:03", "text": "你可以先从你开始，还是可以自己开始？"}, {"type": "subtitle", "time": 4025.43, "timestamp": "01:07:05", "text": "这取决于你。你想做什么？"}, {"type": "subtitle", "time": 4027.19, "timestamp": "01:07:07", "text": "你想成为企业人士，还是你想成为……"}, {"type": "subtitle", "time": 4028.87, "timestamp": "01:07:08", "text": "独立的？"}, {"type": "subtitle", "time": 4031.029, "timestamp": "01:07:11", "text": "请注意，G3卡特尔并非"}, {"type": "subtitle", "time": 4032.95, "timestamp": "01:07:12", "text": "负责任的。所以，这取决于你。受伤"}, {"type": "subtitle", "time": 4034.71, "timestamp": "01:07:14", "text": "您可能会因此产生费用。你"}, {"type": "subtitle", "time": 4037.109, "timestamp": "01:07:17", "text": "想在任何方面拥有更多自由"}, {"type": "subtitle", "time": 4039.349, "timestamp": "01:07:19", "text": "你做"}, {"type": "subtitle", "time": 4042.309, "timestamp": "01:07:22", "text": "或者你想……我相信你已经……"}, {"type": "subtitle", "time": 4044.47, "timestamp": "01:07:24", "text": "知道我是谁。你想成为你吗？"}, {"type": "subtitle", "time": 4047.51, "timestamp": "01:07:27", "text": "想一开始就做大，但也想成为其中的一份子"}, {"type": "subtitle", "time": 4051.19, "timestamp": "01:07:31", "text": "现有社区有点像模糊不清的地方"}, {"type": "subtitle", "time": 4053.19, "timestamp": "01:07:33", "text": "走过去？是什么？"}, {"type": "subtitle", "time": 4054.39, "timestamp": "01:07:34", "text": "不同之处？"}, {"type": "subtitle", "time": 4056.15, "timestamp": "01:07:36", "text": "或者你想从头开始？"}, {"type": "subtitle", "time": 4057.91, "timestamp": "01:07:37", "text": "比如创建自己的社区并进行建设"}, {"type": "subtitle", "time": 4060.87, "timestamp": "01:07:40", "text": "慢慢地，靠自己慢慢地"}, {"type": "subtitle", "time": 4062.789, "timestamp": "01:07:42", "text": "准确的基于工作的模拟是什么"}, {"type": "subtitle", "time": 4064.39, "timestamp": "01:07:44", "text": "它看起来会像什么，而且会做任何类型的事情"}, {"type": "subtitle", "time": 4066.47, "timestamp": "01:07:46", "text": "你想要的内容，却没人会提供。"}, {"type": "subtitle", "time": 4068.23, "timestamp": "01:07:48", "text": "评判你，或者就像没人会说的那样"}, {"type": "subtitle", "time": 4070.39, "timestamp": "01:07:50", "text": "你不要这样做，而且有很多事情要做。"}, {"type": "subtitle", "time": 4074.51, "timestamp": "01:07:54", "text": "自由，这就是独立"}, {"type": "subtitle", "time": 4077.829, "timestamp": "01:07:57", "text": "你看到那看起来像有一加仑吗？"}, {"type": "subtitle", "time": 4079.43, "timestamp": "01:07:59", "text": "我们或许应该救她，好吧。"}]
[{"type": "subtitle", "time": 9723.03, "timestamp": "02:42:03", "text": "恢复时间。哇。你真是走投无路了"}, {"type": "subtitle", "time": 9725.11, "timestamp": "02:42:05", "text": "还会有更多外星人出现吗？你看，我已经完成了"}, {"type": "subtitle", "time": 9727.429, "timestamp": "02:42:07", "text": "我跟你说过。等等，所以这一切都是他做的。"}, {"type": "subtitle", "time": 9729.349, "timestamp": "02:42:09", "text": "他自己，然后突然？你得到了我的最后一个"}, {"type": "subtitle", "time": 9731.349, "timestamp": "02:42:11", "text": "外星液体滴落下来，我却什么也看不到。"}, {"type": "subtitle", "time": 9734.23, "timestamp": "02:42:14", "text": "还有其他的吗？外星人不是这样的。"}, {"type": "subtitle", "time": 9737.429, "timestamp": "02:42:17", "text": "射精阀系统运作。好的，"}, {"type": "subtitle", "time": 9739.349, "timestamp": "02:42:19", "text": "现在我很想帮你，但是……"}, {"type": "subtitle", "time": 9741.429, "timestamp": "02:42:21", "text": "不能。"}, {"type": "subtitle", "time": 9743.11, "timestamp": "02:42:23", "text": "好的。"}, {"type": "subtitle", "time": 9752.23, "timestamp": "02:42:32", "text": "哟，Keep先生，你的喷气背包还剩多少？"}, {"type": "subtitle", "time": 9755.19, "timestamp": "02:42:35", "text": "那里？喷气背包？哦，当然可以。"}, {"type": "subtitle", "time": 9767.59, "timestamp": "02:42:47", "text": "啊，喷气背包啊？绝佳的选择。真的"}, {"type": "subtitle", "time": 9769.83, "timestamp": "02:42:49", "text": "绝佳的选择。我们把它锁定吧。"}, {"type": "subtitle", "time": 9772.55, "timestamp": "02:42:52", "text": "购买。不错。我们难道得不到什么吗？"}, {"type": "subtitle", "time": 9775.429, "timestamp": "02:42:55", "text": "现在就用喷气背包？别急。我回到了"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "点那款好东西。我会准备好的。"}, {"type": "subtitle", "time": 9779.75, "timestamp": "02:42:59", "text": "几天后就能送到您手中。我保证。"}]
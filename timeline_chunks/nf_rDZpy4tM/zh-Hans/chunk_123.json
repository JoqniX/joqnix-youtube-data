[{"type": "subtitle", "time": 7381.51, "timestamp": "02:03:01", "text": "那里，但是，是的，他们有，呃，他们有一个"}, {"type": "subtitle", "time": 7385.189, "timestamp": "02:03:05", "text": "呃，就像……呃，就像……就像……你……"}, {"type": "subtitle", "time": 7389.03, "timestamp": "02:03:09", "text": "就叫它MBR足球队吧"}, {"type": "subtitle", "time": 7392.07, "timestamp": "02:03:12", "text": "球员们与他们签订了多少份合同？"}, {"type": "subtitle", "time": 7395.229, "timestamp": "02:03:15", "text": "他们可以在那家俱乐部踢球的年限"}, {"type": "subtitle", "time": 7398.629, "timestamp": "02:03:18", "text": "足球俱乐部，比如巴塞罗那之类的。"}, {"type": "subtitle", "time": 7401.589, "timestamp": "02:03:21", "text": "他们有类似的反对意见"}, {"type": "subtitle", "time": 7403.51, "timestamp": "02:03:23", "text": "限制条件，比如有效期或其他什么。"}, {"type": "subtitle", "time": 7405.51, "timestamp": "02:03:25", "text": "就像你玩FIFA游戏之类的。"}, {"type": "subtitle", "time": 7407.669, "timestamp": "02:03:27", "text": "你会知道存在一份合同。"}, {"type": "subtitle", "time": 7410.07, "timestamp": "02:03:30", "text": "有效期之类的东西，"}, {"type": "subtitle", "time": 7413.75, "timestamp": "02:03:33", "text": "正确的？跟那件事一模一样。所以对于"}, {"type": "subtitle", "time": 7415.75, "timestamp": "02:03:35", "text": "大多数机构，这需要一年或更长时间。"}, {"type": "subtitle", "time": 7419.669, "timestamp": "02:03:39", "text": "二。是的。所以你可以继续制作"}, {"type": "subtitle", "time": 7421.589, "timestamp": "02:03:41", "text": "内容以及你所知道的一切"}, {"type": "subtitle", "time": 7424.87, "timestamp": "02:03:44", "text": "每年大约只能表演一两个小时。做"}, {"type": "subtitle", "time": 7427.27, "timestamp": "02:03:47", "text": "尽你所能做到最好。如果你不是"}, {"type": "subtitle", "time": 7429.27, "timestamp": "02:03:49", "text": "感觉舒服，或者如果你不这样的话"}, {"type": "subtitle", "time": 7432.149, "timestamp": "02:03:52", "text": "希望继续推进"}, {"type": "subtitle", "time": 7433.31, "timestamp": "02:03:53", "text": "超速"}, {"type": "subtitle", "time": 7437.47, "timestamp": "02:03:57", "text": "旅途中，你其实可以"}]
[{"type": "subtitle", "time": 13564.11, "timestamp": "03:46:04", "text": "我知道，你们大多数人可能都知道"}, {"type": "subtitle", "time": 13566.59, "timestamp": "03:46:06", "text": "我正在帮忙"}, {"type": "subtitle", "time": 13570.309, "timestamp": "03:46:10", "text": "星空之旅，也乐于助人"}, {"type": "subtitle", "time": 13572.349, "timestamp": "03:46:12", "text": "我以前帮忙"}, {"type": "subtitle", "time": 13575.429, "timestamp": "03:46:15", "text": "即使我并非虚拟主义者，我也在尝试虚拟主义。"}, {"type": "subtitle", "time": 13578.309, "timestamp": "03:46:18", "text": "虽然我已经不再帮忙了……"}, {"type": "subtitle", "time": 13580.309, "timestamp": "03:46:20", "text": "虚拟世界，比如播客之类的东西"}, {"type": "subtitle", "time": 13581.07, "timestamp": "03:46:21", "text": "但"}, {"type": "subtitle", "time": 13584.07, "timestamp": "03:46:24", "text": "我们依然如此，你知道，我依然如此"}, {"type": "subtitle", "time": 13586.469, "timestamp": "03:46:26", "text": "我想，大概是其中一部分吧。我不"}, {"type": "subtitle", "time": 13590.229, "timestamp": "03:46:30", "text": "知道那种感觉，你知道的"}, {"type": "subtitle", "time": 13594.67, "timestamp": "03:46:34", "text": "嗯，是的，我希望能帮助到所有人。"}, {"type": "subtitle", "time": 13598.469, "timestamp": "03:46:38", "text": "他们。哎呀，为什么不呢？是的，我想我是"}, {"type": "subtitle", "time": 13600.389, "timestamp": "03:46:40", "text": "是的。是的。比如，别拿它"}, {"type": "subtitle", "time": 13603.429, "timestamp": "03:46:43", "text": "不一样。但话说回来，就像我不使用一样"}, {"type": "subtitle", "time": 13605.83, "timestamp": "03:46:45", "text": "萨斯喀彻温省我的脑子里只有萨斯喀彻温省的那种想法。我的大脑"}, {"type": "subtitle", "time": 13608.03, "timestamp": "03:46:48", "text": "细胞死亡数量很多。哦，"}, {"type": "subtitle", "time": 13612.309, "timestamp": "03:46:52", "text": "不。更多更多。不用担心。"}, {"type": "subtitle", "time": 13615.75, "timestamp": "03:46:55", "text": "我的问题在于，我不知道为什么我"}, {"type": "subtitle", "time": 13618.469, "timestamp": "03:46:58", "text": "当我看到有人需要帮助时，我做不到"}]
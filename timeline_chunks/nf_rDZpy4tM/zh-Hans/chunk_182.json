[{"type": "subtitle", "time": 10920.63, "timestamp": "03:02:00", "text": "某物。你对此感到高兴，"}, {"type": "subtitle", "time": 10921.79, "timestamp": "03:02:01", "text": "灵感"}, {"type": "subtitle", "time": 10923.469, "timestamp": "03:02:03", "text": "关于。"}, {"type": "subtitle", "time": 10927.349, "timestamp": "03:02:07", "text": "是的。是的。当然，我肯定会……"}, {"type": "subtitle", "time": 10931.55, "timestamp": "03:02:11", "text": "在那里支持你的旅程"}, {"type": "subtitle", "time": 10933.63, "timestamp": "03:02:13", "text": "前方。出色地，"}, {"type": "subtitle", "time": 10936.71, "timestamp": "03:02:16", "text": "所以我想我会开始想念你，或者"}, {"type": "subtitle", "time": 10938.11, "timestamp": "03:02:18", "text": "有些我不认识。"}, {"type": "subtitle", "time": 10940.59, "timestamp": "03:02:20", "text": "知道。"}, {"type": "subtitle", "time": 10943.75, "timestamp": "03:02:23", "text": "是的，因为零售业也正在变得越来越……"}, {"type": "subtitle", "time": 10946.269, "timestamp": "03:02:26", "text": "受欢迎的"}, {"type": "subtitle", "time": 10950.91, "timestamp": "03:02:30", "text": "现在很多人都能做到，你"}, {"type": "subtitle", "time": 10953.349, "timestamp": "03:02:33", "text": "知道，因为你不需要露脸。"}, {"type": "subtitle", "time": 10955.59, "timestamp": "03:02:35", "text": "以及所有的一切。更容易拥有"}, {"type": "subtitle", "time": 10958.23, "timestamp": "03:02:38", "text": "如果你有，如果你合适"}, {"type": "subtitle", "time": 10959.71, "timestamp": "03:02:39", "text": "诸如以下标准"}, {"type": "subtitle", "time": 10962.51, "timestamp": "03:02:42", "text": "那"}, {"type": "subtitle", "time": 10966.429, "timestamp": "03:02:46", "text": "东西。你能等吗？你知道吗？"}, {"type": "subtitle", "time": 10969.19, "timestamp": "03:02:49", "text": "我当时就想，你知道那种立场吗？"}, {"type": "subtitle", "time": 10971.349, "timestamp": "03:02:51", "text": "你喜欢把手放在哪里"}, {"type": "subtitle", "time": 10974.79, "timestamp": "03:02:54", "text": "你的脚，大概就是这样，呃……"}, {"type": "subtitle", "time": 10977.67, "timestamp": "03:02:57", "text": "就像女孩们直接坐在椅子上一样"}]
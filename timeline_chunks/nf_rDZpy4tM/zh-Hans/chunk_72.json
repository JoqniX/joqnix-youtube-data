[{"type": "subtitle", "time": 4321.35, "timestamp": "01:12:01", "text": "好的。好了，我们赶紧结束这件事吧。"}, {"type": "subtitle", "time": 4324.47, "timestamp": "01:12:04", "text": "请用……"}, {"type": "subtitle", "time": 4327.91, "timestamp": "01:12:07", "text": "妈的。看看。啊，我死了。"}, {"type": "subtitle", "time": 4333.63, "timestamp": "01:12:13", "text": "我没有"}, {"type": "subtitle", "time": 4340.87, "timestamp": "01:12:20", "text": "看来这显然更难。"}, {"type": "subtitle", "time": 4343.59, "timestamp": "01:12:23", "text": "比看起来要好。请继续。"}, {"type": "subtitle", "time": 4350.47, "timestamp": "01:12:30", "text": "妈的。"}, {"type": "subtitle", "time": 4361.35, "timestamp": "01:12:41", "text": "真他妈要跳起来！"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "该死。那有点……我们"}, {"type": "subtitle", "time": 4364.63, "timestamp": "01:12:44", "text": "我们成功了。那有点难。"}, {"type": "subtitle", "time": 4366.63, "timestamp": "01:12:46", "text": "不过，真是些混蛋。所以，你成功通过了"}, {"type": "subtitle", "time": 4369.51, "timestamp": "01:12:49", "text": "第一次训练演习。没什么大不了的。"}, {"type": "subtitle", "time": 4371.83, "timestamp": "01:12:51", "text": "那道题很简单。我们撒谎说了这话。"}, {"type": "subtitle", "time": 4374.07, "timestamp": "01:12:54", "text": "很难吓到你。哦，这很有趣"}, {"type": "subtitle", "time": 4376.47, "timestamp": "01:12:56", "text": "吓唬你，扰乱你的初始状态"}, {"type": "subtitle", "time": 4378.149, "timestamp": "01:12:58", "text": "视频就像你突然停在了地上一样。"}, {"type": "subtitle", "time": 4379.669, "timestamp": "01:12:59", "text": "想着你。"}]
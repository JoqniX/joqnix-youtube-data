[{"type": "subtitle", "time": 10081.429, "timestamp": "02:48:01", "text": "规则。哦，看看那个。该死的。"}, {"type": "subtitle", "time": 10083.83, "timestamp": "02:48:03", "text": "这有什么好笑的？我的意思是，它是"}, {"type": "subtitle", "time": 10086.389, "timestamp": "02:48:06", "text": "就像背叛了你的信任。你的妻子"}, {"type": "subtitle", "time": 10088.389, "timestamp": "02:48:08", "text": "背叛你。你最好的朋友背叛了你"}, {"type": "subtitle", "time": 10090.23, "timestamp": "02:48:10", "text": "其他"}, {"type": "subtitle", "time": 10097.03, "timestamp": "02:48:17", "text": "哎呀。这他妈什么鬼？呃，也许吧。"}, {"type": "subtitle", "time": 10103.309, "timestamp": "02:48:23", "text": "该死。你就像……"}, {"type": "subtitle", "time": 10106.71, "timestamp": "02:48:26", "text": "TonyHawk.com 喷气式飞机专业版。哦，托尼"}, {"type": "subtitle", "time": 10109.19, "timestamp": "02:48:29", "text": "Hawk滑板。哦，哇。他他们"}, {"type": "subtitle", "time": 10116.75, "timestamp": "02:48:36", "text": "[音乐]"}, {"type": "subtitle", "time": 10119.349, "timestamp": "02:48:39", "text": "好的。嗯，我得告诉你，珍妮是"}, {"type": "subtitle", "time": 10121.269, "timestamp": "02:48:41", "text": "正确的。那肯定会派上用场。"}, {"type": "subtitle", "time": 10123.75, "timestamp": "02:48:43", "text": "这也很有趣。你可以一边飞行一边做"}, {"type": "subtitle", "time": 10126.71, "timestamp": "02:48:46", "text": "战斗。这是一个非常酷的功能。"}, {"type": "subtitle", "time": 10128.63, "timestamp": "02:48:48", "text": "我们这里有。我们投入了大量时间和精力。"}, {"type": "subtitle", "time": 10130.55, "timestamp": "02:48:50", "text": "投入精力。我们回去吧。"}, {"type": "subtitle", "time": 10131.75, "timestamp": "02:48:51", "text": "用机器看看有没有什么新的"}, {"type": "subtitle", "time": 10134.71, "timestamp": "02:48:54", "text": "赏金。"}, {"type": "subtitle", "time": 10136.63, "timestamp": "02:48:56", "text": "我们走吧。"}, {"type": "subtitle", "time": 10138.07, "timestamp": "02:48:58", "text": "我们一到家，我就检查了一下。"}, {"type": "subtitle", "time": 10139.59, "timestamp": "02:48:59", "text": "他在他的小屋里消失了。我一直"}]
[{"type": "subtitle", "time": 10141.75, "timestamp": "02:49:01", "text": "让你收拾干净。这个地方是"}, {"type": "subtitle", "time": 10144.07, "timestamp": "02:49:04", "text": "混乱。我需要你在此之前把它清理干净。"}, {"type": "subtitle", "time": 10147.349, "timestamp": "02:49:07", "text": "粗花呢到了。哦，有个重要的约会。"}, {"type": "subtitle", "time": 10149.83, "timestamp": "02:49:09", "text": "你那可怜的弗林博格男宠。在哪里？"}, {"type": "subtitle", "time": 10152.07, "timestamp": "02:49:12", "text": "特维，珍？就像你从未经历过一样"}, {"type": "subtitle", "time": 10153.99, "timestamp": "02:49:13", "text": "约会时。嘿，别开始了。"}, {"type": "subtitle", "time": 10156.309, "timestamp": "02:49:16", "text": "姐姐。我对日期了解很多。我"}, {"type": "subtitle", "time": 10158.15, "timestamp": "02:49:18", "text": "睡过的外星人比你脑子能睡的还多"}, {"type": "subtitle", "time": 10159.83, "timestamp": "02:49:19", "text": "理解。甚至连我自己都不想"}, {"type": "subtitle", "time": 10161.91, "timestamp": "02:49:21", "text": "摸摸你男朋友。真是听腻了"}, {"type": "subtitle", "time": 10163.91, "timestamp": "02:49:23", "text": "关于你的……是啊，太酷了。他们制造"}, {"type": "subtitle", "time": 10166.309, "timestamp": "02:49:26", "text": "引用太多了。我男朋友真是太"}, {"type": "subtitle", "time": 10168.87, "timestamp": "02:49:28", "text": "真是他妈的性感，对吧？"}, {"type": "subtitle", "time": 10170.29, "timestamp": "02:49:30", "text": "什么？"}, {"type": "subtitle", "time": 10173.67, "timestamp": "02:49:33", "text": "[音乐]"}, {"type": "subtitle", "time": 10176.23, "timestamp": "02:49:36", "text": "等等，你甚至还没见过他呢。为什么是"}, {"type": "subtitle", "time": 10178.95, "timestamp": "02:49:38", "text": "你觉得他恶心？你知道我有"}, {"type": "subtitle", "time": 10181.349, "timestamp": "02:49:41", "text": "当你在这里的时候，这里正在发生着完整的人生。"}, {"type": "subtitle", "time": 10184.389, "timestamp": "02:49:44", "text": "尽情享受你正在做的事情吧"}, {"type": "subtitle", "time": 10186.55, "timestamp": "02:49:46", "text": "做。不，你说得对。她男朋友的"}, {"type": "subtitle", "time": 10188.87, "timestamp": "02:49:48", "text": "丑陋的。请自行清理用过的物品。"}, {"type": "subtitle", "time": 10191.349, "timestamp": "02:49:51", "text": "耶稣。好的。听着，如果我……我很抱歉"}, {"type": "subtitle", "time": 10193.83, "timestamp": "02:49:53", "text": "语气生硬。他把事情搞砸了"}, {"type": "subtitle", "time": 10196.15, "timestamp": "02:49:56", "text": "群体动力学。我们得到了一件好东西。"}, {"type": "subtitle", "time": 10198.79, "timestamp": "02:49:58", "text": "去这里。我们进行那种有趣的喜剧式对话"}]
[{"type": "subtitle", "time": 7500.47, "timestamp": "02:05:00", "text": "公司给你的那些资产"}, {"type": "subtitle", "time": 7503.589, "timestamp": "02:05:03", "text": "呃，比如那个油管博主，不要"}, {"type": "subtitle", "time": 7506.31, "timestamp": "02:05:06", "text": "利用这一点，就像你知道人们是如何做的一样"}, {"type": "subtitle", "time": 7508.55, "timestamp": "02:05:08", "text": "他们有自己的想法，比如说你是"}, {"type": "subtitle", "time": 7510.709, "timestamp": "02:05:10", "text": "企业 YouTuber 可以拥有自己的"}, {"type": "subtitle", "time": 7512.79, "timestamp": "02:05:12", "text": "像地下音乐圈一样的独立 YouTuber"}, {"type": "subtitle", "time": 7517.35, "timestamp": "02:05:17", "text": "就像一个隐藏的秘密身份"}, {"type": "subtitle", "time": 7519.39, "timestamp": "02:05:19", "text": "除了你，没人知道。"}, {"type": "subtitle", "time": 7522.229, "timestamp": "02:05:22", "text": "我知道你可以拥有它，但是"}, {"type": "subtitle", "time": 7524.79, "timestamp": "02:05:24", "text": "提醒您永远不应该使用您的"}, {"type": "subtitle", "time": 7528.79, "timestamp": "02:05:28", "text": "公司 u 资产或其他什么东西，好吧，因为"}, {"type": "subtitle", "time": 7531.43, "timestamp": "02:05:31", "text": "一旦公司发现你加入了"}, {"type": "subtitle", "time": 7534.87, "timestamp": "02:05:34", "text": "麻烦，而且是反对……"}, {"type": "subtitle", "time": 7540.709, "timestamp": "02:05:40", "text": "呃，这违反了公司规定。"}, {"type": "subtitle", "time": 7543.99, "timestamp": "02:05:43", "text": "诸如“是啊”。所以，提醒一下你"}, {"type": "subtitle", "time": 7545.99, "timestamp": "02:05:45", "text": "或许有人目睹过这种情况，但是博士"}, {"type": "subtitle", "time": 7548.79, "timestamp": "02:05:48", "text": "朱皮，你还活着。"}, {"type": "subtitle", "time": 7552.47, "timestamp": "02:05:52", "text": "哦，我的好朋友们。就是这样。道格拉斯"}, {"type": "subtitle", "time": 7554.629, "timestamp": "02:05:54", "text": "就在这扇门后面。你能帮忙吗？"}, {"type": "subtitle", "time": 7557.51, "timestamp": "02:05:57", "text": "最后一次带我出去玩？好，我们开始吧"}]
[{"type": "subtitle", "time": 482.909, "timestamp": "00:08:02", "text": "希望你一切都好。怎样"}, {"type": "subtitle", "time": 488.95, "timestamp": "00:08:08", "text": "你？上次我们停在哪里了？我们"}, {"type": "subtitle", "time": 490.43, "timestamp": "00:08:10", "text": "买了很多"}, {"type": "subtitle", "time": 493.43, "timestamp": "00:08:13", "text": "升级方面，我确实提到过我会……"}, {"type": "subtitle", "time": 495.749, "timestamp": "00:08:15", "text": "达到100%"}, {"type": "subtitle", "time": 498.07, "timestamp": "00:08:18", "text": "呃，这个游戏。所以，我们会买很多。"}, {"type": "subtitle", "time": 500.71, "timestamp": "00:08:20", "text": "今天发生的事情。我们将探索很多地方。"}, {"type": "subtitle", "time": 509.029, "timestamp": "00:08:29", "text": "是的，我很好。你呢？"}, {"type": "subtitle", "time": 511.949, "timestamp": "00:08:31", "text": "哦，我也在做"}, {"type": "subtitle", "time": 516.389, "timestamp": "00:08:36", "text": "好的。我一切都好。"}, {"type": "subtitle", "time": 519.31, "timestamp": "00:08:39", "text": "瞧瞧谁来了。"}, {"type": "subtitle", "time": 524.389, "timestamp": "00:08:44", "text": "哦，所以我们得到了Gastama，我们还有"}, {"type": "subtitle", "time": 527.91, "timestamp": "00:08:47", "text": "凯文。等等，他的名字叫凯文，对吧？"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "肯尼。好的，肯尼。我的错。不是凯文。"}, {"type": "subtitle", "time": 532.19, "timestamp": "00:08:52", "text": "对不起。"}, {"type": "subtitle", "time": 537.829, "timestamp": "00:08:57", "text": "肯尼。好了，我们找到了肯尼和格斯。哦，"}]
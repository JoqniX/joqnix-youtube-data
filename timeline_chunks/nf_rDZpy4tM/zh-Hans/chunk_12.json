[{"type": "subtitle", "time": 723.99, "timestamp": "00:12:03", "text": "好的。或许在未知之处。哦，"}, {"type": "subtitle", "time": 736.069, "timestamp": "00:12:16", "text": "在我嘴里。你他妈的戴头盔"}, {"type": "subtitle", "time": 737.269, "timestamp": "00:12:17", "text": "混蛋。你没有，你不能"}, {"type": "subtitle", "time": 738.949, "timestamp": "00:12:18", "text": "与此相关。为什么我没有"}, {"type": "subtitle", "time": 741.389, "timestamp": "00:12:21", "text": "头盔？你把头盔给我。哦"}, {"type": "subtitle", "time": 744.389, "timestamp": "00:12:24", "text": "拉屎。看他们走了。它们吃的是碎的。"}, {"type": "subtitle", "time": 746.949, "timestamp": "00:12:26", "text": "等等，那是什么标志？沙蚕。哦"}, {"type": "subtitle", "time": 749.19, "timestamp": "00:12:29", "text": "拉屎。这是正确的。我们 我们必须"}, {"type": "subtitle", "time": 751.19, "timestamp": "00:12:31", "text": "务必小心。"}]
[{"type": "subtitle", "time": 14641.51, "timestamp": "04:04:01", "text": "尽管。进展顺利。为什么不呢？"}, {"type": "subtitle", "time": 14644.55, "timestamp": "04:04:04", "text": "你创作音乐的方式和艾森一样吗？我"}, {"type": "subtitle", "time": 14649.91, "timestamp": "04:04:09", "text": "最好的。好了，直播就到此结束了。"}, {"type": "subtitle", "time": 14652.11, "timestamp": "04:04:12", "text": "谢谢你"}, {"type": "subtitle", "time": 14667.189, "timestamp": "04:04:27", "text": "听着。听我说话直到"}, {"type": "subtitle", "time": 14670.15, "timestamp": "04:04:30", "text": "结尾意义重大。所有的储物柜"}, {"type": "subtitle", "time": 14671.83, "timestamp": "04:04:31", "text": "路过的朋友们，谢谢你们锁定页面"}, {"type": "subtitle", "time": 14674.229, "timestamp": "04:04:34", "text": "溪流。感谢那些"}, {"type": "subtitle", "time": 14676.79, "timestamp": "04:04:36", "text": "和我们互动等等。真的"}, {"type": "subtitle", "time": 14678.189, "timestamp": "04:04:38", "text": "意思是"}, {"type": "subtitle", "time": 14681.79, "timestamp": "04:04:41", "text": "很多。还有明吉亚"}, {"type": "subtitle", "time": 14684.71, "timestamp": "04:04:44", "text": "Mingia，谢谢你的到来，也"}, {"type": "subtitle", "time": 14687.189, "timestamp": "04:04:47", "text": "欢迎来到龙霞。"}, {"type": "subtitle", "time": 14691.03, "timestamp": "04:04:51", "text": "谢谢光临。我希望你能"}, {"type": "subtitle", "time": 14692.55, "timestamp": "04:04:52", "text": "希望你以后有机会再来。"}, {"type": "subtitle", "time": 14695.309, "timestamp": "04:04:55", "text": "流和谈话"}, {"type": "subtitle", "time": 14699.03, "timestamp": "04:04:59", "text": "更多的。谢谢。你好。我们将结束"}]
[{"type": "subtitle", "time": 3371.43, "timestamp": "00:56:11", "text": "漂浮的。这是一辆踏板车，它"}, {"type": "subtitle", "time": 3379.43, "timestamp": "00:56:19", "text": "和大家一样，我也讨厌G3。当然。"}, {"type": "subtitle", "time": 3381.829, "timestamp": "00:56:21", "text": "但是，如果G3不在，谁来呢？"}, {"type": "subtitle", "time": 3385.349, "timestamp": "00:56:25", "text": "地狱会买我的探鱼器吗？"}, {"type": "subtitle", "time": 3386.349, "timestamp": "00:56:26", "text": "查令"}, {"type": "subtitle", "time": 3390.069, "timestamp": "00:56:30", "text": "杆？我的另一个传感器？这不是探测"}, {"type": "subtitle", "time": 3392.47, "timestamp": "00:56:32", "text": "杆？哦，是啊，当然。趁我离开的时候，"}, {"type": "subtitle", "time": 3395.37, "timestamp": "00:56:35", "text": "谈谈声音。"}, {"type": "subtitle", "time": 3401.99, "timestamp": "00:56:41", "text": "哦，是啊，当然。趁我说话的时候你走开。"}, {"type": "subtitle", "time": 3412.309, "timestamp": "00:56:52", "text": "是啊，抱抱。哦，是的。我当时在想我"}, {"type": "subtitle", "time": 3415.43, "timestamp": "00:56:55", "text": "我在想，呃，我应该点个赞吗？"}, {"type": "subtitle", "time": 3417.91, "timestamp": "00:56:57", "text": "床头板指令，这样你就可以拥抱"}]
[{"type": "subtitle", "time": 7440.229, "timestamp": "02:04:00", "text": "你实际上可以拥有像"}, {"type": "subtitle", "time": 7443.47, "timestamp": "02:04:03", "text": "与公司进行对话"}, {"type": "subtitle", "time": 7446.149, "timestamp": "02:04:06", "text": "就像得到，呃，得到，就像你知道得到"}, {"type": "subtitle", "time": 7448.31, "timestamp": "02:04:08", "text": "赶紧离开那里，继续前进。"}, {"type": "subtitle", "time": 7451.99, "timestamp": "02:04:11", "text": "就像毕业生一样，想办法毕业"}, {"type": "subtitle", "time": 7453.589, "timestamp": "02:04:13", "text": "就像从玉米地毕业一样"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "差不多就是这样。是的。是的。如果你"}, {"type": "subtitle", "time": 7459.07, "timestamp": "02:04:19", "text": "不喜欢就这么简单。"}, {"type": "subtitle", "time": 7463.629, "timestamp": "02:04:23", "text": "到期日就是这样"}, {"type": "subtitle", "time": 7466.629, "timestamp": "02:04:26", "text": "公司可能会问你，你是否愿意"}, {"type": "subtitle", "time": 7470.149, "timestamp": "02:04:30", "text": "希望继续或与我们保持联系"}, {"type": "subtitle", "time": 7471.629, "timestamp": "02:04:31", "text": "类似"}, {"type": "subtitle", "time": 7473.39, "timestamp": "02:04:33", "text": "那。"}, {"type": "subtitle", "time": 7475.669, "timestamp": "02:04:35", "text": "是的，他们确实有一个印度"}, {"type": "subtitle", "time": 7477.27, "timestamp": "02:04:37", "text": "合同规定了他们必须遵守的时间。"}, {"type": "subtitle", "time": 7479.03, "timestamp": "02:04:39", "text": "和他们一起商量他们需要多少东西"}, {"type": "subtitle", "time": 7481.109, "timestamp": "02:04:41", "text": "即使你离开他们，也要定期直播。"}, {"type": "subtitle", "time": 7483.03, "timestamp": "02:04:43", "text": "双方会达成一些协议。是的。"}, {"type": "subtitle", "time": 7484.31, "timestamp": "02:04:44", "text": "是的。是的。会有一些"}, {"type": "subtitle", "time": 7487.669, "timestamp": "02:04:47", "text": "协议，尤其是特别的"}, {"type": "subtitle", "time": 7489.75, "timestamp": "02:04:49", "text": "如果你像我一样见过这种情况，你就不应该这样做。"}, {"type": "subtitle", "time": 7492.87, "timestamp": "02:04:52", "text": "其他机构也发生过类似情况。"}, {"type": "subtitle", "time": 7495.51, "timestamp": "02:04:55", "text": "比如你毕业之类的，或者类似的事情"}, {"type": "subtitle", "time": 7498.07, "timestamp": "02:04:58", "text": "如果您是该机构的成员，请勿使用"}]
[{"type": "subtitle", "time": 7755.43, "timestamp": "02:09:15", "text": "好了。是的，我知道。加油，兄弟。我是"}, {"type": "subtitle", "time": 7758.709, "timestamp": "02:09:18", "text": "我不擅长这个。是的，你已经完成一半了。"}, {"type": "subtitle", "time": 7760.95, "timestamp": "02:09:20", "text": "继续前进。你可以做到。哦，我不能"}, {"type": "subtitle", "time": 7763.189, "timestamp": "02:09:23", "text": "等着看我那小小的、脆弱的、道具，"}, {"type": "subtitle", "time": 7764.709, "timestamp": "02:09:24", "text": "下垂的。"}, {"type": "subtitle", "time": 7767.43, "timestamp": "02:09:27", "text": "你改了名字。好的。好的。看，"}, {"type": "subtitle", "time": 7769.189, "timestamp": "02:09:29", "text": "就是这样。我不会坐在这里……"}, {"type": "subtitle", "time": 7770.95, "timestamp": "02:09:30", "text": "别再假装了。你又犯错了。"}, {"type": "subtitle", "time": 7773.03, "timestamp": "02:09:33", "text": "你老是改孩子的名字。"}, {"type": "subtitle", "time": 7774.95, "timestamp": "02:09:34", "text": "好的。他正在改变。发生了什么事？"}, {"type": "subtitle", "time": 7776.709, "timestamp": "02:09:36", "text": "到底发生了什么？最近流行什么？"}, {"type": "subtitle", "time": 7779.189, "timestamp": "02:09:39", "text": "宝贝，最近怎么样？什么？什么是"}, {"type": "subtitle", "time": 7780.95, "timestamp": "02:09:40", "text": "你在说什么？你是"}, {"type": "subtitle", "time": 7783.669, "timestamp": "02:09:43", "text": "跟我们耍花招？操，哦，你是"}, {"type": "subtitle", "time": 7786.149, "timestamp": "02:09:46", "text": "错误的。我绝不会那样做。看看"}, {"type": "subtitle", "time": 7788.069, "timestamp": "02:09:48", "text": "我现在很脆弱。你是什​​么"}, {"type": "subtitle", "time": 7790.31, "timestamp": "02:09:50", "text": "意思是说谎吗？我会让自己如此吗？"}, {"type": "subtitle", "time": 7792.87, "timestamp": "02:09:52", "text": "易受伤害的？毙了他。相信我。"}, {"type": "subtitle", "time": 7796.069, "timestamp": "02:09:56", "text": "等一下，稍等片刻。哦，我没有"}, {"type": "subtitle", "time": 7798.149, "timestamp": "02:09:58", "text": "知道。他在撒谎。他他妈的在撒谎"}]
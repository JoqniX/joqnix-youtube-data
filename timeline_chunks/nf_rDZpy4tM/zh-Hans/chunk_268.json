[{"type": "subtitle", "time": 16081.269, "timestamp": "04:28:01", "text": "下载官方启动器或Epic启动器"}, {"type": "subtitle", "time": 16102.79, "timestamp": "04:28:22", "text": "哦，不错。他会记得如何战斗"}, {"type": "subtitle", "time": 16105.03, "timestamp": "04:28:25", "text": "尽管他已经忘记了一切。"}, {"type": "subtitle", "time": 16108.79, "timestamp": "04:28:28", "text": "哇。下次等着瞧我冲锋陷阵吧。"}, {"type": "subtitle", "time": 16111.11, "timestamp": "04:28:31", "text": "那是一只兔子。我杀了那只兔子。我"}, {"type": "subtitle", "time": 16112.83, "timestamp": "04:28:32", "text": "意思是，奇莎，"}, {"type": "subtitle", "time": 16114.469, "timestamp": "04:28:34", "text": "[音乐]"}, {"type": "subtitle", "time": 16118.349, "timestamp": "04:28:38", "text": "这很有趣。桑迪"}]
[{"type": "subtitle", "time": 10381.19, "timestamp": "02:53:01", "text": "你之前见过他。在接下来的时间里做"}, {"type": "subtitle", "time": 10382.79, "timestamp": "02:53:02", "text": "溪流。看到一张照片。你没有"}, {"type": "subtitle", "time": 10385.51, "timestamp": "02:53:05", "text": "给我找一个。是的，我们可以结束了。"}, {"type": "subtitle", "time": 10387.99, "timestamp": "02:53:07", "text": "我猜也是。对S来说，什么才算足够好？好的"}, {"type": "subtitle", "time": 10389.429, "timestamp": "02:53:09", "text": "对我来说足够了。是的。是的，我们可以包装"}, {"type": "subtitle", "time": 10392.309, "timestamp": "02:53:12", "text": "向上"}, {"type": "subtitle", "time": 10395.429, "timestamp": "02:53:15", "text": "因为现在已经六点了，对吧？"}, {"type": "subtitle", "time": 10398.15, "timestamp": "02:53:18", "text": "需要3个小时。"}, {"type": "subtitle", "time": 10400.71, "timestamp": "02:53:20", "text": "但别担心，我们会找到宝藏的。"}, {"type": "subtitle", "time": 10403.03, "timestamp": "02:53:23", "text": "我们将进行几场高质量的直播。"}, {"type": "subtitle", "time": 10405.59, "timestamp": "02:53:25", "text": "不用担心。所以，呃，是什么样的东西？"}, {"type": "subtitle", "time": 10407.11, "timestamp": "02:53:27", "text": "你在这里干了什么？比如，任何事"}, {"type": "subtitle", "time": 10409.11, "timestamp": "02:53:29", "text": "总的？你得告诉我。喜欢，"}, {"type": "subtitle", "time": 10410.389, "timestamp": "02:53:30", "text": "说真的，拜托。我们是最好的朋友"}, {"type": "subtitle", "time": 10412.07, "timestamp": "02:53:32", "text": "现在。"}, {"type": "subtitle", "time": 10416.309, "timestamp": "02:53:36", "text": "哇。好了，就这些。我打电话"}, {"type": "subtitle", "time": 10418.71, "timestamp": "02:53:38", "text": "现在所有人都在。要么斯科特没做到"}, {"type": "subtitle", "time": 10420.71, "timestamp": "02:53:40", "text": "它到底有没有进城，或者它只是"}, {"type": "subtitle", "time": 10423.11, "timestamp": "02:53:43", "text": "从“他们为什么保留电影”中消失了"}, {"type": "subtitle", "time": 10425.59, "timestamp": "02:53:45", "text": "游戏里是这样的吗？那岂不是违背了……"}, {"type": "subtitle", "time": 10427.83, "timestamp": "02:53:47", "text": "操作系统之类的东西？版权几乎是一个"}, {"type": "subtitle", "time": 10430.95, "timestamp": "02:53:50", "text": "一小时前。真奇怪。我猜我是"}, {"type": "subtitle", "time": 10432.55, "timestamp": "02:53:52", "text": "G，你为什么？你为什么？"}, {"type": "subtitle", "time": 10434.23, "timestamp": "02:53:54", "text": "正在看这些吗？我就是不明白"}, {"type": "subtitle", "time": 10438.469, "timestamp": "02:53:58", "text": "这一切。哇。嗯，有一个非常"}]
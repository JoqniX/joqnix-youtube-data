[{"type": "subtitle", "time": 3180.79, "timestamp": "00:53:00", "text": "哦，踉跄跄。好的。就是他"}, {"type": "subtitle", "time": 3182.95, "timestamp": "00:53:02", "text": "我是。我没办法。现在，我们只需"}, {"type": "subtitle", "time": 3185.589, "timestamp": "00:53:05", "text": "继续经营。是的。"}, {"type": "subtitle", "time": 3187.51, "timestamp": "00:53:07", "text": "好的。我认为这是他唯一做的事。"}, {"type": "subtitle", "time": 3189.99, "timestamp": "00:53:09", "text": "对我来说，好吧，我要买这个。"}, {"type": "subtitle", "time": 3192.87, "timestamp": "00:53:12", "text": "浪费我的时间。"}, {"type": "subtitle", "time": 3195.349, "timestamp": "00:53:15", "text": "伟大的。还有什么？"}, {"type": "subtitle", "time": 3197.91, "timestamp": "00:53:17", "text": "还有什么？你还想要更多吗？不是"}, {"type": "subtitle", "time": 3205.51, "timestamp": "00:53:25", "text": "[音乐]"}, {"type": "subtitle", "time": 3209.109, "timestamp": "00:53:29", "text": "所以现在如果他有了新的交错技巧"}, {"type": "subtitle", "time": 3217.75, "timestamp": "00:53:37", "text": "我的天哪。一部大型横向电梯"}, {"type": "subtitle", "time": 3219.19, "timestamp": "00:53:39", "text": "原来的。你知道他们有一个这样的东西"}, {"type": "subtitle", "time": 3221.549, "timestamp": "00:53:41", "text": "在《阿基拉》里，我觉得"}, {"type": "subtitle", "time": 3224.23, "timestamp": "00:53:44", "text": "福音派存在于太空。你知道"}, {"type": "subtitle", "time": 3225.91, "timestamp": "00:53:45", "text": "那已经是关于动漫的了。太空人"}, {"type": "subtitle", "time": 3226.829, "timestamp": "00:53:46", "text": "爱"}, {"type": "subtitle", "time": 3229.51, "timestamp": "00:53:49", "text": "日本动画片。不喜欢被视为禁忌。"}, {"type": "subtitle", "time": 3232.309, "timestamp": "00:53:52", "text": "太空动漫。我们甚至还喜欢那个节目。"}, {"type": "subtitle", "time": 3233.91, "timestamp": "00:53:53", "text": "你记得20世纪20年代的那部动画片吗？"}, {"type": "subtitle", "time": 3235.91, "timestamp": "00:53:55", "text": "几年前看起来有点像动漫，除了"}, {"type": "subtitle", "time": 3237.349, "timestamp": "00:53:57", "text": "每个人的额头都很大，这种情况持续了一段时间。"}, {"type": "subtitle", "time": 3239.03, "timestamp": "00:53:59", "text": "原因。是的，我们很喜欢。你知道吗"}]
[{"type": "subtitle", "time": 12000.349, "timestamp": "03:20:00", "text": "在这段旅程中，我可以"}, {"type": "subtitle", "time": 12002.51, "timestamp": "03:20:02", "text": "就像我一样"}, {"type": "subtitle", "time": 12005.429, "timestamp": "03:20:05", "text": "最好，没错，就是这样。那就是"}, {"type": "subtitle", "time": 12008.75, "timestamp": "03:20:08", "text": "事物。我的天啊。我不知道为什么，"}, {"type": "subtitle", "time": 12011.469, "timestamp": "03:20:11", "text": "但是来"}, {"type": "subtitle", "time": 12014.15, "timestamp": "03:20:14", "text": "如果他们那样说，我大概会想："}, {"type": "subtitle", "time": 12017.19, "timestamp": "03:20:17", "text": "你嗑了什么药？你竟敢这样？"}, {"type": "subtitle", "time": 12024.75, "timestamp": "03:20:24", "text": "凡人？还有你？"}, {"type": "subtitle", "time": 12030.11, "timestamp": "03:20:30", "text": "是的。是的，像这样的案例"}, {"type": "subtitle", "time": 12032.71, "timestamp": "03:20:32", "text": "事情发生时，你需要知道自己需要什么。"}, {"type": "subtitle", "time": 12036.469, "timestamp": "03:20:36", "text": "要去做，你知道你自己也知道"}, {"type": "subtitle", "time": 12038.67, "timestamp": "03:20:38", "text": "你需要做什么，"}, {"type": "subtitle", "time": 12041.269, "timestamp": "03:20:41", "text": "正确的？是的。所以你继续做你的"}, {"type": "subtitle", "time": 12043.15, "timestamp": "03:20:43", "text": "最好的。"}, {"type": "subtitle", "time": 12045.87, "timestamp": "03:20:45", "text": "等等，我本来也可以这么说"}, {"type": "subtitle", "time": 12048.87, "timestamp": "03:20:48", "text": "没错吧？总会有那么一些时候"}, {"type": "subtitle", "time": 12051.349, "timestamp": "03:20:51", "text": "你的科学和模型在哪里？"}, {"type": "subtitle", "time": 12052.51, "timestamp": "03:20:52", "text": "东西将会是"}, {"type": "subtitle", "time": 12055.91, "timestamp": "03:20:55", "text": "情况类似，但还是要继续尽力而为。"}, {"type": "subtitle", "time": 12057.309, "timestamp": "03:20:57", "text": "出去"}]
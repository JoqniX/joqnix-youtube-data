[{"type": "subtitle", "time": 11762.309, "timestamp": "03:16:02", "text": "对，很好，但是不管怎样，我没有"}, {"type": "subtitle", "time": 11765.07, "timestamp": "03:16:05", "text": "我知道，是的，这个"}, {"type": "subtitle", "time": 11767.309, "timestamp": "03:16:07", "text": "我希望的旅程"}, {"type": "subtitle", "time": 11774.469, "timestamp": "03:16:14", "text": "我知道我不想任何人这么说。"}, {"type": "subtitle", "time": 11776.79, "timestamp": "03:16:16", "text": "来我的直播间看看那些新来的人吧"}, {"type": "subtitle", "time": 11778.469, "timestamp": "03:16:18", "text": "来吧，我不想任何人"}, {"type": "subtitle", "time": 11781.269, "timestamp": "03:16:21", "text": "来我的直播间，我心想：哦，运动健将。"}, {"type": "subtitle", "time": 11784.87, "timestamp": "03:16:24", "text": "你是不是抄袭了Gavis的模型之类的？"}, {"type": "subtitle", "time": 11786.71, "timestamp": "03:16:26", "text": "像这样吗？我不想那样。是的，我是"}, {"type": "subtitle", "time": 11788.03, "timestamp": "03:16:28", "text": "害怕"}, {"type": "subtitle", "time": 11792.91, "timestamp": "03:16:32", "text": "那。但是，数量够吗？"}, {"type": "subtitle", "time": 11796.19, "timestamp": "03:16:36", "text": "证据？够吗？"}, {"type": "subtitle", "time": 11801.389, "timestamp": "03:16:41", "text": "证明我有勇气维护自己的权益？我不"}, {"type": "subtitle", "time": 11804.15, "timestamp": "03:16:44", "text": "知道。我的意思是，有人可能会说，乔，你已经"}, {"type": "subtitle", "time": 11806.79, "timestamp": "03:16:46", "text": "做了大约12年的主播"}, {"type": "subtitle", "time": 11808.07, "timestamp": "03:16:48", "text": "某物。您在这两方面都有内容。"}, {"type": "subtitle", "time": 11810.55, "timestamp": "03:16:50", "text": "Twitch 和 YouTube。"}, {"type": "subtitle", "time": 11812.63, "timestamp": "03:16:52", "text": "你做了很多直播等等。"}, {"type": "subtitle", "time": 11815.51, "timestamp": "03:16:55", "text": "这可以算作证据，对吧？"}, {"type": "subtitle", "time": 11818.51, "timestamp": "03:16:58", "text": "是的。某种程度上来说，是的。"}]
[{"type": "subtitle", "time": 1680.83, "timestamp": "00:28:00", "text": "我的天啊。那"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "男。他惊呼：“我的天哪。”尽量不要"}, {"type": "subtitle", "time": 1686.31, "timestamp": "00:28:06", "text": "滑倒，掉进那个无底洞里，"}, {"type": "subtitle", "time": 1693.35, "timestamp": "00:28:13", "text": "我对此帮不上忙。"}, {"type": "subtitle", "time": 1701.19, "timestamp": "00:28:21", "text": "好了，我们到了。我们成功了。"}, {"type": "subtitle", "time": 1721.47, "timestamp": "00:28:41", "text": "这里？好的，我拿到这些箱子了。"}, {"type": "subtitle", "time": 1732.95, "timestamp": "00:28:52", "text": "这肯定是我还没解锁的东西。"}, {"type": "subtitle", "time": 1734.83, "timestamp": "00:28:54", "text": "或者"}, {"type": "subtitle", "time": 1737.43, "timestamp": "00:28:57", "text": "某物。但是等等，我想尝试一下"}]
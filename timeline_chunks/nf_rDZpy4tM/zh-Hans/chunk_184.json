[{"type": "subtitle", "time": 11040.15, "timestamp": "03:04:00", "text": "就像玛雅人一样。这让我不禁感叹：我的天哪！"}, {"type": "subtitle", "time": 11042.71, "timestamp": "03:04:02", "text": "这音乐让我浑身发热"}, {"type": "subtitle", "time": 11044.83, "timestamp": "03:04:04", "text": "热狗。哦，我的"}, {"type": "subtitle", "time": 11048.269, "timestamp": "03:04:08", "text": "上帝。哦，是的。在"}, {"type": "subtitle", "time": 11052.59, "timestamp": "03:04:12", "text": "从某种意义上说，我对此感到兴奋。"}, {"type": "subtitle", "time": 11057.67, "timestamp": "03:04:17", "text": "区域。我对很多事情都感到兴奋。"}, {"type": "subtitle", "time": 11059.15, "timestamp": "03:04:19", "text": "呃"}, {"type": "subtitle", "time": 11062.99, "timestamp": "03:04:22", "text": "比如我周围的事物。那是星空"}, {"type": "subtitle", "time": 11065.75, "timestamp": "03:04:25", "text": "虚拟主义和个人创作者"}, {"type": "subtitle", "time": 11068.51, "timestamp": "03:04:28", "text": "以及周围的独立游戏"}, {"type": "subtitle", "time": 11071.67, "timestamp": "03:04:31", "text": "我。它们都是它们都是"}, {"type": "subtitle", "time": 11074.389, "timestamp": "03:04:34", "text": "他们正在尽力而为。"}, {"type": "subtitle", "time": 11082.55, "timestamp": "03:04:42", "text": "东西。是的。所以，投资于新的"}, {"type": "subtitle", "time": 11085.67, "timestamp": "03:04:45", "text": "做事情，制作更多内容，做事情"}, {"type": "subtitle", "time": 11087.36, "timestamp": "03:04:47", "text": "全新的事物等等，"}, {"type": "subtitle", "time": 11089.63, "timestamp": "03:04:49", "text": "[音乐]"}, {"type": "subtitle", "time": 11092.51, "timestamp": "03:04:52", "text": "正确的？"}, {"type": "subtitle", "time": 11096.07, "timestamp": "03:04:56", "text": "对，就是这样。而且，这让我"}, {"type": "subtitle", "time": 11098.19, "timestamp": "03:04:58", "text": "看看我的书架，"}]
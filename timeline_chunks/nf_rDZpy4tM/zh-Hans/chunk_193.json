[{"type": "subtitle", "time": 11581.67, "timestamp": "03:13:01", "text": "打击或者像呃，去空心镜头"}, {"type": "subtitle", "time": 11583.51, "timestamp": "03:13:03", "text": "空心星星，请更改"}, {"type": "subtitle", "time": 11585.15, "timestamp": "03:13:05", "text": "模型之类的。"}, {"type": "subtitle", "time": 11588.99, "timestamp": "03:13:08", "text": "不，我不能。此时此刻，我"}, {"type": "subtitle", "time": 11592.91, "timestamp": "03:13:12", "text": "不能。而且，当谈到……"}, {"type": "subtitle", "time": 11596.03, "timestamp": "03:13:16", "text": "Vubing，我不得不接受这个事实："}, {"type": "subtitle", "time": 11599.71, "timestamp": "03:13:19", "text": "是的，如果说到自己的话，"}, {"type": "subtitle", "time": 11602.95, "timestamp": "03:13:22", "text": "正确的？我觉得那只是个传说之类的。"}, {"type": "subtitle", "time": 11605.03, "timestamp": "03:13:25", "text": "我不知道这是不是真的，但有可能"}, {"type": "subtitle", "time": 11605.95, "timestamp": "03:13:25", "text": "是"}, {"type": "subtitle", "time": 11609.83, "timestamp": "03:13:29", "text": "外面有七个人，就像七个人一样"}, {"type": "subtitle", "time": 11612.55, "timestamp": "03:13:32", "text": "跟你本人长得一样。可以"}, {"type": "subtitle", "time": 11615.51, "timestamp": "03:13:35", "text": "还有另外七个人也在那里。"}, {"type": "subtitle", "time": 11617.91, "timestamp": "03:13:37", "text": "世界里所有长得和你一模一样的人"}, {"type": "subtitle", "time": 11618.91, "timestamp": "03:13:38", "text": "某物，"}, {"type": "subtitle", "time": 11622.389, "timestamp": "03:13:42", "text": "正确的？就这样。同样的情况也可能发生。"}, {"type": "subtitle", "time": 11625.15, "timestamp": "03:13:45", "text": "据说虚拟主播"}, {"type": "subtitle", "time": 11628.87, "timestamp": "03:13:48", "text": "出色地。它接受了这个事实，是的，当"}, {"type": "subtitle", "time": 11630.79, "timestamp": "03:13:50", "text": "说到虚拟主播，任何人都可以创作。"}, {"type": "subtitle", "time": 11633.429, "timestamp": "03:13:53", "text": "他们自己想象中的梦境人物。"}, {"type": "subtitle", "time": 11635.51, "timestamp": "03:13:55", "text": "他们可以修改它。他们可以改变"}, {"type": "subtitle", "time": 11638.15, "timestamp": "03:13:58", "text": "他们的东西。他们可以随意选择。"}]
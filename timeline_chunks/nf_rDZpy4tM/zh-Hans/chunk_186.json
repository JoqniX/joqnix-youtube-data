[{"type": "subtitle", "time": 11160.83, "timestamp": "03:06:00", "text": "做我的"}, {"type": "subtitle", "time": 11163.309, "timestamp": "03:06:03", "text": "最适合"}, {"type": "subtitle", "time": 11165.99, "timestamp": "03:06:05", "text": "即使这让我很想进入……"}, {"type": "subtitle", "time": 11169.19, "timestamp": "03:06:09", "text": "传统的，嗯，有点传统，但是"}, {"type": "subtitle", "time": 11171.309, "timestamp": "03:06:11", "text": "至少目前为止"}, {"type": "subtitle", "time": 11175.469, "timestamp": "03:06:15", "text": "运动健将，我不友善，我不友善"}, {"type": "subtitle", "time": 11179.59, "timestamp": "03:06:19", "text": "有点……呃，就像我不知道一样。"}, {"type": "subtitle", "time": 11182.23, "timestamp": "03:06:22", "text": "这该怎么说呢"}, {"type": "subtitle", "time": 11184.07, "timestamp": "03:06:24", "text": "呃，我总有一天会直播的。"}, {"type": "subtitle", "time": 11186.87, "timestamp": "03:06:26", "text": "总有一天，我会把自己的照片挂在自己的地方。"}, {"type": "subtitle", "time": 11187.83, "timestamp": "03:06:27", "text": "一"}, {"type": "subtitle", "time": 11191.07, "timestamp": "03:06:31", "text": "是的。是的。你也是。我是"}, {"type": "subtitle", "time": 11194.87, "timestamp": "03:06:34", "text": "嘘。来教堂看长椅，我一个人。"}, {"type": "subtitle", "time": 11198.11, "timestamp": "03:06:38", "text": "然后直播，尽情玩乐，开怀大笑"}, {"type": "subtitle", "time": 11202.269, "timestamp": "03:06:42", "text": "就是围绕着所有这些事情。一切美好"}, {"type": "subtitle", "time": 11205.51, "timestamp": "03:06:45", "text": "东西。哦，他在想我。思维"}, {"type": "subtitle", "time": 11214.99, "timestamp": "03:06:54", "text": "上帝。我为什么哭了？他妈的。等待。"}, {"type": "subtitle", "time": 11217.429, "timestamp": "03:06:57", "text": "是的，很高兴看到大家"}]
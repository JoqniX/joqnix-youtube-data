[{"type": "subtitle", "time": 4742.27, "timestamp": "01:19:02", "text": "拿或喜欢"}, {"type": "subtitle", "time": 4745.91, "timestamp": "01:19:05", "text": "呃，拿走或者喜欢，还有另一家公司"}, {"type": "subtitle", "time": 4750.229, "timestamp": "01:19:10", "text": "例如，虚拟现实就是一个例子，对吧？所以对于"}, {"type": "subtitle", "time": 4753.51, "timestamp": "01:19:13", "text": "虚拟的，虚拟主义，它们将会是"}, {"type": "subtitle", "time": 4755.51, "timestamp": "01:19:15", "text": "从零开始。记住这一点"}, {"type": "subtitle", "time": 4757.75, "timestamp": "01:19:17", "text": "他们将从零开始"}, {"type": "subtitle", "time": 4761.189, "timestamp": "01:19:21", "text": "parados gen come 出来了。他们得逞了"}, {"type": "subtitle", "time": 4764.55, "timestamp": "01:19:24", "text": "他们竭尽全力，就像星空一样。"}, {"type": "subtitle", "time": 4767.189, "timestamp": "01:19:27", "text": "做过。但他们确实进行了直播。他们"}, {"type": "subtitle", "time": 4769.83, "timestamp": "01:19:29", "text": "做了很多直播，也经常互动。"}, {"type": "subtitle", "time": 4772.229, "timestamp": "01:19:32", "text": "慢慢地，人们慢慢地走过来"}, {"type": "subtitle", "time": 4774.79, "timestamp": "01:19:34", "text": "他们其他人也都知道了这件事。"}, {"type": "subtitle", "time": 4776.63, "timestamp": "01:19:36", "text": "星空就是这样。虚拟主义"}, {"type": "subtitle", "time": 4778.95, "timestamp": "01:19:38", "text": "也会做同样的事情，对吧？"}, {"type": "subtitle", "time": 4781.43, "timestamp": "01:19:41", "text": "比如说，我们有第一代"}, {"type": "subtitle", "time": 4784.63, "timestamp": "01:19:44", "text": "虚拟生活持续了一年左右"}, {"type": "subtitle", "time": 4786.55, "timestamp": "01:19:46", "text": "六七个月后，接下来"}, {"type": "subtitle", "time": 4788.79, "timestamp": "01:19:48", "text": "基因进化后，他们甚至必须做同样的事情。"}, {"type": "subtitle", "time": 4790.79, "timestamp": "01:19:50", "text": "作为任务披风，是的，它们也必须工作。"}, {"type": "subtitle", "time": 4793.27, "timestamp": "01:19:53", "text": "他们竭尽全力，他们正在加入"}, {"type": "subtitle", "time": 4795.189, "timestamp": "01:19:55", "text": "人们会有很多期望，"}, {"type": "subtitle", "time": 4796.95, "timestamp": "01:19:56", "text": "但他们仍然会做他们的事情。"}]
[{"type": "subtitle", "time": 9976.469, "timestamp": "02:46:16", "text": "让我们把杀人冲动留到以后再说吧"}, {"type": "subtitle", "time": 9980.91, "timestamp": "02:46:20", "text": "坏人。好的。好的。"}, {"type": "subtitle", "time": 9986.63, "timestamp": "02:46:26", "text": "你还在看这个？是的，但是"}, {"type": "subtitle", "time": 9989.19, "timestamp": "02:46:29", "text": "目前缺货。伟大的。完美的"}, {"type": "subtitle", "time": 9991.19, "timestamp": "02:46:31", "text": "找个借口休息一下。我们仍在等待"}, {"type": "subtitle", "time": 9993.67, "timestamp": "02:46:33", "text": "根据Clug提供的情报。总之，你为什么不呢？"}, {"type": "subtitle", "time": 9995.59, "timestamp": "02:46:35", "text": "去睡觉，把那些情绪都消下去。"}, {"type": "subtitle", "time": 9997.59, "timestamp": "02:46:37", "text": "激动？吉恩说得对。就是这样。"}, {"type": "subtitle", "time": 10006.51, "timestamp": "02:46:46", "text": "[音乐]"}, {"type": "subtitle", "time": 10011.469, "timestamp": "02:46:51", "text": "风险。杰西在哪儿？杰西"}, {"type": "subtitle", "time": 10014.95, "timestamp": "02:46:54", "text": "莉伊的妹妹。"}, {"type": "subtitle", "time": 10017.11, "timestamp": "02:46:57", "text": "所以，这就是你的卧室，是吗？它是"}, {"type": "subtitle", "time": 10018.71, "timestamp": "02:46:58", "text": "美好的。我的意思是，我真的不……"}]
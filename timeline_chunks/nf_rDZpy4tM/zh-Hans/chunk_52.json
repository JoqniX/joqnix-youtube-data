[{"type": "subtitle", "time": 3123.27, "timestamp": "00:52:03", "text": "这？哦，现在是电梯了。好的。"}, {"type": "subtitle", "time": 3125.829, "timestamp": "00:52:05", "text": "你在追求荣耀吗？然后加入"}, {"type": "subtitle", "time": 3129.03, "timestamp": "00:52:09", "text": "G3卡特尔。我叫道格拉斯，G3"}, {"type": "subtitle", "time": 3131.589, "timestamp": "00:52:11", "text": "训练和酷刑主管。第二"}, {"type": "subtitle", "time": 3133.27, "timestamp": "00:52:13", "text": "为这条广告投点钱。这差不多就是"}, {"type": "subtitle", "time": 3135.03, "timestamp": "00:52:15", "text": "训练。"}, {"type": "subtitle", "time": 3136.87, "timestamp": "00:52:16", "text": "哎呀，真倒霉。有"}, {"type": "subtitle", "time": 3139.109, "timestamp": "00:52:19", "text": "道格拉斯就在那里。这就是你了解它的方式。"}, {"type": "subtitle", "time": 3141.75, "timestamp": "00:52:21", "text": "我们来对了地方。"}, {"type": "subtitle", "time": 3149.829, "timestamp": "00:52:29", "text": "嗨，我是道格拉斯。这是关于"}, {"type": "subtitle", "time": 3151.43, "timestamp": "00:52:31", "text": "酷刑。呃，最后一个是关于"}, {"type": "subtitle", "time": 3153.19, "timestamp": "00:52:33", "text": "加入G3，但这次是关于"}, {"type": "subtitle", "time": 3156.309, "timestamp": "00:52:36", "text": "我多么喜欢折磨人啊。这根本不存在。"}, {"type": "subtitle", "time": 3157.91, "timestamp": "00:52:37", "text": "这就像是在提醒我们，这部分"}, {"type": "subtitle", "time": 3160.309, "timestamp": "00:52:40", "text": "我的工作也是折磨人。敌人"}, {"type": "subtitle", "time": 3162.63, "timestamp": "00:52:42", "text": "G3 中的陌生人"}, {"type": "subtitle", "time": 3164.95, "timestamp": "00:52:44", "text": "要幽默。任何人。是其中的一部分"}, {"type": "subtitle", "time": 3167.27, "timestamp": "00:52:47", "text": "反对暴力母亲条约。所以，不"}, {"type": "subtitle", "time": 3169.109, "timestamp": "00:52:49", "text": "这里允许暴力。小心。"}, {"type": "subtitle", "time": 3172.39, "timestamp": "00:52:52", "text": "母亲反对暴力。嗯，就是这样。"}, {"type": "subtitle", "time": 3174.15, "timestamp": "00:52:54", "text": "对我们有利。我们不会"}, {"type": "subtitle", "time": 3175.67, "timestamp": "00:52:55", "text": "不必担心这方面会有什么麻烦。"}, {"type": "subtitle", "time": 3177.99, "timestamp": "00:52:57", "text": "区域。"}]
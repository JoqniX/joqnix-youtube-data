[{"type": "subtitle", "time": 1026.23, "timestamp": "00:17:06", "text": "好的。是的，我可以用它们来……"}, {"type": "subtitle", "time": 1029.35, "timestamp": "00:17:09", "text": "优势。就像吸吮它们一样，"}, {"type": "subtitle", "time": 1032.429, "timestamp": "00:17:12", "text": "把他们带过来打我"}, {"type": "subtitle", "time": 1035.669, "timestamp": "00:17:15", "text": "你或者其他什么人。我等不及你了。"}, {"type": "subtitle", "time": 1037.669, "timestamp": "00:17:17", "text": "去看看飙车小镇。我只去了"}, {"type": "subtitle", "time": 1039.829, "timestamp": "00:17:19", "text": "几次之后，G3 就让我吃到了薯片。"}, {"type": "subtitle", "time": 1041.99, "timestamp": "00:17:21", "text": "所以我实际上什么也做不了。所以，"}, {"type": "subtitle", "time": 1044.23, "timestamp": "00:17:24", "text": "我真的不知道这到底好不好玩。"}, {"type": "subtitle", "time": 1045.35, "timestamp": "00:17:25", "text": "你明白我的意思吗？比如，我不能"}, {"type": "subtitle", "time": 1047.829, "timestamp": "00:17:27", "text": "我不能成为Drag Town的评论家，因为"}, {"type": "subtitle", "time": 1050.95, "timestamp": "00:17:30", "text": "我真的不记得了，或者，或者，我不知道。"}, {"type": "subtitle", "time": 1053.43, "timestamp": "00:17:33", "text": "真的就是关于恐怖小镇的。我不知道。我"}, {"type": "subtitle", "time": 1061.95, "timestamp": "00:17:41", "text": "[音乐]"}, {"type": "subtitle", "time": 1064.87, "timestamp": "00:17:44", "text": "再见。难道教堂已经不存在了吗？"}, {"type": "subtitle", "time": 1072.12, "timestamp": "00:17:52", "text": "什么？不。这是一个非常糟糕的大事件。"}]
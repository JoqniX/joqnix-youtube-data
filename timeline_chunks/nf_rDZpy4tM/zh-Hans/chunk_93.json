[{"type": "subtitle", "time": 5581.95, "timestamp": "01:33:01", "text": "正确的？他们在扮演自己的角色"}, {"type": "subtitle", "time": 5583.91, "timestamp": "01:33:03", "text": "特点。他们有法律，而且"}, {"type": "subtitle", "time": 5585.83, "timestamp": "01:33:05", "text": "一切。这不是很酷吗？哪里有"}, {"type": "subtitle", "time": 5588.07, "timestamp": "01:33:08", "text": "你看到这个了吗？你有没有看到任何地方"}, {"type": "subtitle", "time": 5591.51, "timestamp": "01:33:11", "text": "别的？呃，即使在西方场景中也是如此。"}, {"type": "subtitle", "time": 5595.35, "timestamp": "01:33:15", "text": "以及其他一些地方"}, {"type": "subtitle", "time": 5597.51, "timestamp": "01:33:17", "text": "日本人或世界各地。你看过吗？"}, {"type": "subtitle", "time": 5600.95, "timestamp": "01:33:20", "text": "哪里可以进行这种角色扮演直播"}, {"type": "subtitle", "time": 5603.35, "timestamp": "01:33:23", "text": "就像V2一样"}, {"type": "subtitle", "time": 5605.55, "timestamp": "01:33:25", "text": "兄弟，但是"}, {"type": "subtitle", "time": 5607.87, "timestamp": "01:33:27", "text": "是的，你有类似"}, {"type": "subtitle", "time": 5611.43, "timestamp": "01:33:31", "text": "你，嗯，你扮演你的角色"}, {"type": "subtitle", "time": 5612.43, "timestamp": "01:33:32", "text": "和"}, {"type": "subtitle", "time": 5616.07, "timestamp": "01:33:36", "text": "东西。是啊，这简直太聪明了。"}, {"type": "subtitle", "time": 5618.43, "timestamp": "01:33:38", "text": "正确的？它太大了"}, {"type": "subtitle", "time": 5630.47, "timestamp": "01:33:50", "text": "是的，很少。是的。这人是谁？"}, {"type": "subtitle", "time": 5631.91, "timestamp": "01:33:51", "text": "正在做？这个人在这里干什么？"}, {"type": "subtitle", "time": 5633.75, "timestamp": "01:33:53", "text": "住手。我们不会杀了它。"}, {"type": "subtitle", "time": 5635.149, "timestamp": "01:33:55", "text": "他只是在看着。"}, {"type": "subtitle", "time": 5637.87, "timestamp": "01:33:57", "text": "我的天哪，这是什么"}]
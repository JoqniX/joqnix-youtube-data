[{"type": "subtitle", "time": 5102.709, "timestamp": "01:25:02", "text": "社区，互联网，呃，就像"}, {"type": "subtitle", "time": 5104.95, "timestamp": "01:25:04", "text": "YouTube 用户或类似 Instagram 用户。你可以"}, {"type": "subtitle", "time": 5107.91, "timestamp": "01:25:07", "text": "你看，真主也会这样做。"}, {"type": "subtitle", "time": 5117.39, "timestamp": "01:25:17", "text": "是啊，就像"}, {"type": "subtitle", "time": 5120.47, "timestamp": "01:25:20", "text": "我们正朝你走来。我希望如此"}, {"type": "subtitle", "time": 5123.75, "timestamp": "01:25:23", "text": "当时抱有希望。"}, {"type": "subtitle", "time": 5126.51, "timestamp": "01:25:26", "text": "将这一段全部变成"}, {"type": "subtitle", "time": 5129.51, "timestamp": "01:25:29", "text": "播客。好的。这是什么？"}, {"type": "subtitle", "time": 5132.07, "timestamp": "01:25:32", "text": "恭喜你们这些虫子！"}, {"type": "subtitle", "time": 5134.39, "timestamp": "01:25:34", "text": "你已经完成了训练的这一步。这是"}, {"type": "subtitle", "time": 5136.87, "timestamp": "01:25:36", "text": "现在是最终测试的时候了。血腥的"}, {"type": "subtitle", "time": 5138.79, "timestamp": "01:25:38", "text": "免费用于体育话题。等等，什么？"}, {"type": "subtitle", "time": 5141.91, "timestamp": "01:25:41", "text": "站立者可以加入G3。没有规则，"}, {"type": "subtitle", "time": 5144.95, "timestamp": "01:25:44", "text": "纯粹的杀戮。祝你好运，混蛋。鳗鱼。上帝"}, {"type": "subtitle", "time": 5147.189, "timestamp": "01:25:47", "text": "该死的。还有另一件该死的事"}, {"type": "subtitle", "time": 5149.43, "timestamp": "01:25:49", "text": "这。我的天哪。把他们都杀了。我"}, {"type": "subtitle", "time": 5151.83, "timestamp": "01:25:51", "text": "我的意思是，你知道，我以前确实做过……"}, {"type": "subtitle", "time": 5154.87, "timestamp": "01:25:54", "text": "播客，对吧？我的意思是，我以前是"}, {"type": "subtitle", "time": 5158.229, "timestamp": "01:25:58", "text": "这是播客虚拟主义的一部分"}, {"type": "subtitle", "time": 5159.629, "timestamp": "01:25:59", "text": "过去的日子"}]
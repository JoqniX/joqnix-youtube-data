[{"type": "subtitle", "time": 10322.07, "timestamp": "02:52:02", "text": "沉闷。哈尔。"}, {"type": "subtitle", "time": 10327.03, "timestamp": "02:52:07", "text": "珍，你只要收拾干净就行了。好吧，抱歉拖延时间。"}, {"type": "subtitle", "time": 10330.07, "timestamp": "02:52:10", "text": "你完全投入其中。总之，一个不错的小"}, {"type": "subtitle", "time": 10332.07, "timestamp": "02:52:12", "text": "与Clug的合作正在取得成效。"}, {"type": "subtitle", "time": 10334.55, "timestamp": "02:52:14", "text": "他们向我们提供了关于两项新悬赏的情报。"}, {"type": "subtitle", "time": 10336.63, "timestamp": "02:52:16", "text": "所以，呃，如果你想的话，就去做吧。"}, {"type": "subtitle", "time": 10350.87, "timestamp": "02:52:30", "text": "你右边有两个。"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "你……你见过M吗？呃，不。"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "未知扇区部分。"}, {"type": "subtitle", "time": 10360.23, "timestamp": "02:52:40", "text": "我们一到家他就走了。哇，"}, {"type": "subtitle", "time": 10363.03, "timestamp": "02:52:43", "text": "太多了。一二三。我从未"}, {"type": "subtitle", "time": 10365.19, "timestamp": "02:52:45", "text": "见过他这么沮丧。恐怕他是"}, {"type": "subtitle", "time": 10367.269, "timestamp": "02:52:47", "text": "准备做点什么。我们得到了2000。"}, {"type": "subtitle", "time": 10369.07, "timestamp": "02:52:49", "text": "这家伙还没回来。"}, {"type": "subtitle", "time": 10372.469, "timestamp": "02:52:52", "text": "任何一个。我保留着还有 20,000。我"}, {"type": "subtitle", "time": 10374.71, "timestamp": "02:52:54", "text": "我发现自己又回到了学校的床上。"}, {"type": "subtitle", "time": 10376.63, "timestamp": "02:52:56", "text": "就等着回家了。等等，应该"}, {"type": "subtitle", "time": 10379.19, "timestamp": "02:52:59", "text": "我们是否应该结束今天的直播呢？"}]
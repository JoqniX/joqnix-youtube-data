[{"type": "subtitle", "time": 6304.229, "timestamp": "01:45:04", "text": "出来。出来。闪光镜头。我确实有"}, {"type": "subtitle", "time": 6306.87, "timestamp": "01:45:06", "text": "一把枪。这是手套击球镜头。肯尼是"}, {"type": "subtitle", "time": 6322.75, "timestamp": "01:45:22", "text": "显示一个减缓速度的气泡。"}, {"type": "subtitle", "time": 6325.75, "timestamp": "01:45:25", "text": "不是这个。"}, {"type": "subtitle", "time": 6350.709, "timestamp": "01:45:50", "text": "你要杀了我吗？是的。"}, {"type": "subtitle", "time": 6359.38, "timestamp": "01:45:59", "text": "挤压。哦，我没有挤压器。"}]
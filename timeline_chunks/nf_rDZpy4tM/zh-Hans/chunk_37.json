[{"type": "subtitle", "time": 2225.349, "timestamp": "00:37:05", "text": "这些人是谁？"}, {"type": "subtitle", "time": 2228.39, "timestamp": "00:37:08", "text": "你不属于这里，赶紧离开。"}, {"type": "subtitle", "time": 2230.31, "timestamp": "00:37:10", "text": "你不必回家，但你也不能回家。"}, {"type": "subtitle", "time": 2233.45, "timestamp": "00:37:13", "text": "就住这儿吧。"}, {"type": "subtitle", "time": 2242.31, "timestamp": "00:37:22", "text": "天哪，他的脸简直就是游戏物理引擎的化身。我的"}, {"type": "subtitle", "time": 2252.43, "timestamp": "00:37:32", "text": "做你自己的。我什么都不怕。"}, {"type": "subtitle", "time": 2268.47, "timestamp": "00:37:48", "text": "是的。又怎么了？"}, {"type": "subtitle", "time": 2270.589, "timestamp": "00:37:50", "text": "所以如果是"}]
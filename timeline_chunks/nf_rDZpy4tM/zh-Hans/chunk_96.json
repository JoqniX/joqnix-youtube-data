[{"type": "subtitle", "time": 5767.51, "timestamp": "01:36:07", "text": "谜。他化了点淡妆。"}, {"type": "subtitle", "time": 5769.189, "timestamp": "01:36:09", "text": "他自己。这个比这个稍微难一点。"}, {"type": "subtitle", "time": 5774.44, "timestamp": "01:36:14", "text": "哦，"}, {"type": "subtitle", "time": 5783.75, "timestamp": "01:36:23", "text": "我该如何报答你？我应该给小费吗？要给小费吗？"}, {"type": "subtitle", "time": 5785.43, "timestamp": "01:36:25", "text": "你？帮忙的话，你会给多少小费？"}, {"type": "subtitle", "time": 5788.39, "timestamp": "01:36:28", "text": "解谜题？ 15%，20？做完所有"}, {"type": "subtitle", "time": 5789.99, "timestamp": "01:36:29", "text": "解谜高手们纷纷掏出小费，然后"}, {"type": "subtitle", "time": 5791.27, "timestamp": "01:36:31", "text": "你们后来在最后分开了。"}, {"type": "subtitle", "time": 5792.79, "timestamp": "01:36:32", "text": "夜晚？或者它是一种……"}, {"type": "subtitle", "time": 5794.79, "timestamp": "01:36:34", "text": "解谜者联盟？我帮了点忙。"}]
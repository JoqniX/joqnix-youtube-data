[{"type": "subtitle", "time": 13681.11, "timestamp": "03:48:01", "text": "那里。有很多淋浴间"}, {"type": "subtitle", "time": 13684.429, "timestamp": "03:48:04", "text": "我想做的菜"}, {"type": "subtitle", "time": 13688.03, "timestamp": "03:48:08", "text": "把东西收拾干净，就像……"}, {"type": "subtitle", "time": 13692.07, "timestamp": "03:48:12", "text": "一切。我使用自己的服务器作为"}, {"type": "subtitle", "time": 13694.03, "timestamp": "03:48:14", "text": "试验场，用于测试新产品"}, {"type": "subtitle", "time": 13696.269, "timestamp": "03:48:16", "text": "[音乐]"}, {"type": "subtitle", "time": 13699.63, "timestamp": "03:48:19", "text": "东西，最后，经过漫长的一段时间"}, {"type": "subtitle", "time": 13704.469, "timestamp": "03:48:24", "text": "多年来，我一直自己修理铲子。"}, {"type": "subtitle", "time": 13707.75, "timestamp": "03:48:27", "text": "像流媒体之类的东西真丢人，显而易见"}, {"type": "subtitle", "time": 13709.91, "timestamp": "03:48:29", "text": "东西。如果有人需要帮助，"}, {"type": "subtitle", "time": 13712.57, "timestamp": "03:48:32", "text": "技术方面的事情，我只是帮忙而已。"}, {"type": "subtitle", "time": 13714.389, "timestamp": "03:48:34", "text": "[音乐]"}, {"type": "subtitle", "time": 13717.429, "timestamp": "03:48:37", "text": "有时我真的开始意识到这一点"}, {"type": "subtitle", "time": 13720.63, "timestamp": "03:48:40", "text": "即使我在直播，我也会尽量同时处理多项任务。"}, {"type": "subtitle", "time": 13722.71, "timestamp": "03:48:42", "text": "虽然他们自己也做着类似的事情。"}, {"type": "subtitle", "time": 13725.309, "timestamp": "03:48:45", "text": "在 Discord 上看不到状态，这是"}, {"type": "subtitle", "time": 13727.87, "timestamp": "03:48:47", "text": "紫色，意思是我是"}, {"type": "subtitle", "time": 13730.229, "timestamp": "03:48:50", "text": "直播，但还是不肯告诉他们"}, {"type": "subtitle", "time": 13733.189, "timestamp": "03:48:53", "text": "我正在直播，但我开始帮忙"}, {"type": "subtitle", "time": 13736.229, "timestamp": "03:48:56", "text": "他们。我注意到，过了一段时间，很长一段时间……"}, {"type": "subtitle", "time": 13738.59, "timestamp": "03:48:58", "text": "我一直在做"}]
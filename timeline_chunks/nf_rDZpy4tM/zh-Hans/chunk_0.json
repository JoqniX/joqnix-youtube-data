[{"type": "subtitle", "time": 14.03, "timestamp": "00:00:14", "text": "大家好，欢迎大家参加 Joathon 日"}, {"type": "subtitle", "time": 16.79, "timestamp": "00:00:16", "text": "35 第二部分流。我们目前"}, {"type": "subtitle", "time": 20.59, "timestamp": "00:00:20", "text": "我要去睡觉了。我好累"}, {"type": "subtitle", "time": 24.79, "timestamp": "00:00:24", "text": "今天我要睡觉了。所以是"}, {"type": "subtitle", "time": 26.91, "timestamp": "00:00:26", "text": "更困倦的意志"}, {"type": "subtitle", "time": 29.99, "timestamp": "00:00:29", "text": "今天会直播睡觉。"}, {"type": "subtitle", "time": 32.91, "timestamp": "00:00:32", "text": "谢谢观看。我去"}, {"type": "subtitle", "time": 36.549, "timestamp": "00:00:36", "text": "无需赘言，直接播放EP。现在是10点。我想要"}, {"type": "subtitle", "time": 39.15, "timestamp": "00:00:39", "text": "我希望修复我的"}, {"type": "subtitle", "time": 43.31, "timestamp": "00:00:43", "text": "日程。是的，"}, {"type": "subtitle", "time": 52.75, "timestamp": "00:00:52", "text": "领先"}, {"type": "subtitle", "time": 55.029, "timestamp": "00:00:55", "text": "出色地。感谢所有参与的人"}, {"type": "subtitle", "time": 57.27, "timestamp": "00:00:57", "text": "今天很细心，还过来拜访了我。"}, {"type": "subtitle", "time": 59.75, "timestamp": "00:00:59", "text": "流。"}]
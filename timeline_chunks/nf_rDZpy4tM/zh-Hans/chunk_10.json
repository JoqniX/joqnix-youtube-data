[{"type": "subtitle", "time": 603.47, "timestamp": "00:10:03", "text": "正确的。我以前的是AR48。哦，"}, {"type": "subtitle", "time": 609.949, "timestamp": "00:10:09", "text": "[音乐]"}, {"type": "subtitle", "time": 612.79, "timestamp": "00:10:12", "text": "嗯？小子，你最好小心点。我"}, {"type": "subtitle", "time": 614.87, "timestamp": "00:10:14", "text": "这些东西可不是我送的。哦，他是"}, {"type": "subtitle", "time": 616.71, "timestamp": "00:10:16", "text": "看看剧什么的。可以"}, {"type": "subtitle", "time": 618.71, "timestamp": "00:10:18", "text": "请告诉我你的微型火箭是怎么回事？"}, {"type": "subtitle", "time": 621.829, "timestamp": "00:10:21", "text": "这是什么？稍等片刻。"}, {"type": "subtitle", "time": 624.23, "timestamp": "00:10:24", "text": "哦，他在重症监护室。那是房间"}, {"type": "subtitle", "time": 627.55, "timestamp": "00:10:27", "text": "走廊尽头的203号。谢谢。那是……"}, {"type": "subtitle", "time": 631.269, "timestamp": "00:10:31", "text": "他在看什么？"}, {"type": "subtitle", "time": 633.31, "timestamp": "00:10:33", "text": "这是一部老电影吗？"}, {"type": "subtitle", "time": 635.55, "timestamp": "00:10:35", "text": "某物？你是做什么的"}, {"type": "subtitle", "time": 638.99, "timestamp": "00:10:38", "text": "正在看吗？等等，你是什么人？"}, {"type": "subtitle", "time": 641.91, "timestamp": "00:10:41", "text": "正在看吗？我想看看你妹妹。"}, {"type": "subtitle", "time": 643.59, "timestamp": "00:10:43", "text": "我打算去探索布林，同时"}, {"type": "subtitle", "time": 646.31, "timestamp": "00:10:46", "text": "你正在外面从事赏金猎人的工作。嘿，是"}, {"type": "subtitle", "time": 648.63, "timestamp": "00:10:48", "text": "小心点。人类是宝贵的"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "商品。商品。把你抓起来。我"}, {"type": "subtitle", "time": 654.15, "timestamp": "00:10:54", "text": "珍妮，我可以照顾好自己。"}, {"type": "subtitle", "time": 657.9, "timestamp": "00:10:57", "text": "坐下来谈谈。"}, {"type": "subtitle", "time": 659.91, "timestamp": "00:10:59", "text": "[音乐]"}]
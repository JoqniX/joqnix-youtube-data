[{"type": "subtitle", "time": 16620.07, "timestamp": "04:37:00", "text": "塔塞特田。"}, {"type": "subtitle", "time": 16622.269, "timestamp": "04:37:02", "text": "某物是"}, {"type": "subtitle", "time": 16626.26, "timestamp": "04:37:06", "text": "那里。哦"}, {"type": "subtitle", "time": 16631.269, "timestamp": "04:37:11", "text": "[音乐]"}, {"type": "subtitle", "time": 16633.67, "timestamp": "04:37:13", "text": "我们离得太远了。或许他做不到"}, {"type": "subtitle", "time": 16637.269, "timestamp": "04:37:17", "text": "他们听不到我们说话。好的。形成酸"}, {"type": "subtitle", "time": 16639.83, "timestamp": "04:37:19", "text": "在此期间，田地处于休眠期"}, {"type": "subtitle", "time": 16643.67, "timestamp": "04:37:23", "text": "时间。这里相对安全。好的。"}, {"type": "subtitle", "time": 16645.83, "timestamp": "04:37:25", "text": "在此期间，问号期"}, {"type": "subtitle", "time": 16647.99, "timestamp": "04:37:27", "text": "酸场的性质取决于其"}, {"type": "subtitle", "time": 16650.949, "timestamp": "04:37:30", "text": "形成时间。形成时间。知道了。"}, {"type": "subtitle", "time": 16654.15, "timestamp": "04:37:34", "text": "形成时间即休眠期。"}, {"type": "subtitle", "time": 16656.709, "timestamp": "04:37:36", "text": "然而，如果休眠期更长，"}, {"type": "subtitle", "time": 16658.789, "timestamp": "04:37:38", "text": "内部产生的酸涩不和谐是"}, {"type": "subtitle", "time": 16662.15, "timestamp": "04:37:42", "text": "通常更强劲。通常更强劲。哦，"}, {"type": "subtitle", "time": 16664.629, "timestamp": "04:37:44", "text": "酸性场形成速度越快，"}, {"type": "subtitle", "time": 16667.349, "timestamp": "04:37:47", "text": "休眠期越长。哦，我没有"}, {"type": "subtitle", "time": 16679.91, "timestamp": "04:37:59", "text": "滑翔机不行，希望我没事。"}]
[{"type": "subtitle", "time": 8708.349, "timestamp": "02:25:08", "text": "地方？我究竟是怎么来的？"}, {"type": "subtitle", "time": 8711.469, "timestamp": "02:25:11", "text": "这里？我需要去谷歌吗？"}, {"type": "subtitle", "time": 8726.95, "timestamp": "02:25:26", "text": "我的天啊。我一路返回去了。"}, {"type": "subtitle", "time": 8730.71, "timestamp": "02:25:30", "text": "太空漫步者。哦，我好喜欢这张幻灯片。"}, {"type": "subtitle", "time": 8731.99, "timestamp": "02:25:31", "text": "我们会让你变得坚强。是"}, {"type": "subtitle", "time": 8734.07, "timestamp": "02:25:34", "text": "会让你"}, {"type": "subtitle", "time": 8736.389, "timestamp": "02:25:36", "text": "我的天啊。真酷。我们要走了"}, {"type": "subtitle", "time": 8738.55, "timestamp": "02:25:38", "text": "我们要制作一把枪"}, {"type": "subtitle", "time": 8742.87, "timestamp": "02:25:42", "text": "你的手臂。开枪。"}, {"type": "subtitle", "time": 8746.15, "timestamp": "02:25:46", "text": "我的天啊。我一路折返回来了。"}]
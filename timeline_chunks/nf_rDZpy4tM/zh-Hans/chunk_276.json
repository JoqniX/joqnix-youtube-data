[{"type": "subtitle", "time": 16561.83, "timestamp": "04:36:01", "text": "城市和堡垒。这非常关键"}, {"type": "subtitle", "time": 16564.47, "timestamp": "04:36:04", "text": "为了安全"}, {"type": "subtitle", "time": 16567.269, "timestamp": "04:36:07", "text": "嗯？我们已同意与白见面。"}, {"type": "subtitle", "time": 16570.429, "timestamp": "04:36:10", "text": "这里。她在哪儿？"}, {"type": "subtitle", "time": 16572.409, "timestamp": "04:36:12", "text": "白。哦，是谁？"}, {"type": "subtitle", "time": 16573.869, "timestamp": "04:36:13", "text": "[音乐]"}, {"type": "subtitle", "time": 16576.269, "timestamp": "04:36:16", "text": "白？ Bishi是谁？"}, {"type": "subtitle", "time": 16579.349, "timestamp": "04:36:19", "text": "我不知道这个角色的名字，"}, {"type": "subtitle", "time": 16588.269, "timestamp": "04:36:28", "text": "这里是气海的中心。"}, {"type": "subtitle", "time": 16592.99, "timestamp": "04:36:32", "text": "大西洋海酸田。酸性场。什么是"}, {"type": "subtitle", "time": 16595.75, "timestamp": "04:36:35", "text": "正在发生？哦，那是什么？哦，星星。"}, {"type": "subtitle", "time": 16599.269, "timestamp": "04:36:39", "text": "那是一颗星星。回声星。它不在这里"}, {"type": "subtitle", "time": 16601.51, "timestamp": "04:36:41", "text": "我们刚到这里的时候，但我没有"}, {"type": "subtitle", "time": 16603.349, "timestamp": "04:36:43", "text": "隐约感觉到一丝酸性场的气息"}, {"type": "subtitle", "time": 16605.67, "timestamp": "04:36:45", "text": "在场。"}, {"type": "subtitle", "time": 16608.47, "timestamp": "04:36:48", "text": "所以，趁我们不注意的时候，它就出现了。"}, {"type": "subtitle", "time": 16611.99, "timestamp": "04:36:51", "text": "眼皮都要眨掉了。哦，也许是"}, {"type": "subtitle", "time": 16614.349, "timestamp": "04:36:54", "text": "以太之海可以告诉我们身在何处。"}, {"type": "subtitle", "time": 16617.67, "timestamp": "04:36:57", "text": "伦理跟随我们，中心是"}]
[{"type": "subtitle", "time": 16682.31, "timestamp": "04:38:02", "text": "那我走了。此外，我只是想"}, {"type": "subtitle", "time": 16684.869, "timestamp": "04:38:04", "text": "斗争。我们得下去。给我"}, {"type": "subtitle", "time": 16687.67, "timestamp": "04:38:07", "text": "一些战斗。"}, {"type": "subtitle", "time": 16689.91, "timestamp": "04:38:09", "text": "我想战斗。现在，是时候使用……了"}, {"type": "subtitle", "time": 16693.349, "timestamp": "04:38:13", "text": "滑翔机模块。哦，滑翔机。让我来帮忙"}, {"type": "subtitle", "time": 16697.029, "timestamp": "04:38:17", "text": "你激活它。"}, {"type": "subtitle", "time": 16698.709, "timestamp": "04:38:18", "text": "哦，那真酷。你可以拥有"}, {"type": "subtitle", "time": 16700.429, "timestamp": "04:38:20", "text": "滑翔机。所以，"}, {"type": "subtitle", "time": 16702.629, "timestamp": "04:38:22", "text": "等待。对了，我收集过吗？"}, {"type": "subtitle", "time": 16705.029, "timestamp": "04:38:25", "text": "这个区域的所有东西？什么也没有"}, {"type": "subtitle", "time": 16705.869, "timestamp": "04:38:25", "text": "别的，"}, {"type": "subtitle", "time": 16710.59, "timestamp": "04:38:30", "text": "正确的？是古驰吧？好的。"}, {"type": "subtitle", "time": 16714.109, "timestamp": "04:38:34", "text": "你好。我动不了"}, {"type": "subtitle", "time": 16716.189, "timestamp": "04:38:36", "text": "相机。"}, {"type": "subtitle", "time": 16719.67, "timestamp": "04:38:39", "text": "哦，过场动画。你可以放一只鼠标"}, {"type": "subtitle", "time": 16729.99, "timestamp": "04:38:49", "text": "我们正处于一个沉寂的、隐性领域，对吧？"}, {"type": "subtitle", "time": 16737.949, "timestamp": "04:38:57", "text": "你自己？你知道，"}, {"type": "subtitle", "time": 16739.709, "timestamp": "04:38:59", "text": "我们"}]
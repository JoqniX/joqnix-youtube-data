[{"type": "subtitle", "time": 15181.83, "timestamp": "04:13:01", "text": "能。你没做亚洲市场。嗯，我会的"}, {"type": "subtitle", "time": 15184.87, "timestamp": "04:13:04", "text": "两个都。我两个都做。我两个都做。患病的"}, {"type": "subtitle", "time": 15187.87, "timestamp": "04:13:07", "text": "两者都做。我两个都做。"}, {"type": "subtitle", "time": 15197.309, "timestamp": "04:13:17", "text": "但是这样"}, {"type": "subtitle", "time": 15204.51, "timestamp": "04:13:24", "text": "走吧，我是"}, {"type": "subtitle", "time": 15210.11, "timestamp": "04:13:30", "text": "卡在了呃"}, {"type": "subtitle", "time": 15214.87, "timestamp": "04:13:34", "text": "学习。哦，我不会玩。它说"}, {"type": "subtitle", "time": 15223.229, "timestamp": "04:13:43", "text": "你好吗？"}, {"type": "subtitle", "time": 15229.67, "timestamp": "04:13:49", "text": "一分钟也不行。不用担心。我想要"}, {"type": "subtitle", "time": 15232.71, "timestamp": "04:13:52", "text": "查一下。但您的终端仍然有"}, {"type": "subtitle", "time": 15235.349, "timestamp": "04:13:55", "text": "数据。玩不了。它说不是"}, {"type": "subtitle", "time": 15238.149, "timestamp": "04:13:58", "text": "已启动。哦，你好。欢迎。欢迎。"}]
[{"type": "subtitle", "time": 13620.269, "timestamp": "03:47:00", "text": "帮助。我就是做不到"}, {"type": "subtitle", "time": 13624.429, "timestamp": "03:47:04", "text": "比如关心自己，喜欢或喜欢"}, {"type": "subtitle", "time": 13626.469, "timestamp": "03:47:06", "text": "那它叫什么来着？怎么说？"}, {"type": "subtitle", "time": 13629.189, "timestamp": "03:47:09", "text": "自我中心，只关心自己"}, {"type": "subtitle", "time": 13632.11, "timestamp": "03:47:12", "text": "东西和类似"}, {"type": "subtitle", "time": 13635.51, "timestamp": "03:47:15", "text": "忽略该请求或求助。"}, {"type": "subtitle", "time": 13637.67, "timestamp": "03:47:17", "text": "是的。我不知道。我正在"}, {"type": "subtitle", "time": 13641.189, "timestamp": "03:47:21", "text": "这样做会有麻烦。但从某种意义上说，如果"}, {"type": "subtitle", "time": 13644.71, "timestamp": "03:47:24", "text": "有人需要帮忙，我就帮他们一把。"}, {"type": "subtitle", "time": 13652.229, "timestamp": "03:47:32", "text": "请帮帮我，意思是请帮我做这件事。"}, {"type": "subtitle", "time": 13654.59, "timestamp": "03:47:34", "text": "或者设置这个，然后"}, {"type": "subtitle", "time": 13656.83, "timestamp": "03:47:36", "text": "就像"}, {"type": "subtitle", "time": 13659.389, "timestamp": "03:47:39", "text": "那"}, {"type": "subtitle", "time": 13662.189, "timestamp": "03:47:42", "text": "萨沙和我"}, {"type": "subtitle", "time": 13665.03, "timestamp": "03:47:45", "text": "即使我有很多希望，我"}, {"type": "subtitle", "time": 13668.79, "timestamp": "03:47:48", "text": "我相信，而且我希望我还能做到。"}, {"type": "subtitle", "time": 13676.389, "timestamp": "03:47:56", "text": "人，是啊，最近我有点……"}, {"type": "subtitle", "time": 13678.59, "timestamp": "03:47:58", "text": "一直忽视"}]
[{"type": "subtitle", "time": 9601.27, "timestamp": "02:40:01", "text": "完全无法将其缩小到"}, {"type": "subtitle", "time": 9604.07, "timestamp": "02:40:04", "text": "人口统计数据集。奶奶家，警察，"}, {"type": "subtitle", "time": 9606.79, "timestamp": "02:40:06", "text": "电影明星、政客，所有人"}, {"type": "subtitle", "time": 9609.99, "timestamp": "02:40:09", "text": "喜欢我美味的外星人精液。我已经有了"}, {"type": "subtitle", "time": 9611.59, "timestamp": "02:40:11", "text": "这里什么怪人都有。"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "他说：“我喜欢你600加仑的……”"}, {"type": "subtitle", "time": 9615.67, "timestamp": "02:40:15", "text": "“绝对最高品质的外星口香糖。”"}, {"type": "subtitle", "time": 9617.75, "timestamp": "02:40:17", "text": "然后我说，“哪个重要吗？”"}, {"type": "subtitle", "time": 9619.429, "timestamp": "02:40:19", "text": "外星人，精液是从哪里来的？他们"}, {"type": "subtitle", "time": 9622.389, "timestamp": "02:40:22", "text": "我说：“不，先生。真的没有。我只是……”"}, {"type": "subtitle", "time": 9625.67, "timestamp": "02:40:25", "text": "想要一些外星人来。没有更多细节"}, {"type": "subtitle", "time": 9628.469, "timestamp": "02:40:28", "text": "需要。所以，结果会是什么呢？"}, {"type": "subtitle", "time": 9637.67, "timestamp": "02:40:37", "text": "呃，何塞，你那里人真多啊。"}, {"type": "subtitle", "time": 9639.91, "timestamp": "02:40:39", "text": "想买外星人口香糖吗？我"}, {"type": "subtitle", "time": 9642.469, "timestamp": "02:40:42", "text": "我不建议我的客户询问相关问题，这是我的政策。"}, {"type": "subtitle", "time": 9643.91, "timestamp": "02:40:43", "text": "他们为什么想要那么多加仑的"}, {"type": "subtitle", "time": 9645.75, "timestamp": "02:40:45", "text": "他们从我这里购买的外国收入。我觉得"}, {"type": "subtitle", "time": 9647.27, "timestamp": "02:40:47", "text": "我问的问题越少，就越不会问关于什么的问题。"}, {"type": "subtitle", "time": 9648.79, "timestamp": "02:40:48", "text": "人们正在用这些外星人做什么"}, {"type": "subtitle", "time": 9654.07, "timestamp": "02:40:54", "text": "来吧，越来越好。所以，你的答案是否定的？"}, {"type": "subtitle", "time": 9657.11, "timestamp": "02:40:57", "text": "真的有外星人精液吗？有什么问题？"}]
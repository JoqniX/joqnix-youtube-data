[{"type": "subtitle", "time": 2520.69, "timestamp": "00:42:00", "text": "长笛曲调。我说得对不对？"}, {"type": "subtitle", "time": 2522.39, "timestamp": "00:42:02", "text": "[音乐]"}, {"type": "subtitle", "time": 2525.349, "timestamp": "00:42:05", "text": "清洁你的耳朵。它是"}, {"type": "subtitle", "time": 2532.309, "timestamp": "00:42:12", "text": "好吧，你知道吗？我承认。"}, {"type": "subtitle", "time": 2535.109, "timestamp": "00:42:15", "text": "这很好。"}, {"type": "subtitle", "time": 2544.03, "timestamp": "00:42:24", "text": "哦"}, {"type": "subtitle", "time": 2547.2, "timestamp": "00:42:27", "text": "我的天哪。"}, {"type": "subtitle", "time": 2554.23, "timestamp": "00:42:34", "text": "[音乐]"}, {"type": "subtitle", "time": 2556.87, "timestamp": "00:42:36", "text": "我的天啊。你会过得很好"}, {"type": "subtitle", "time": 2559.829, "timestamp": "00:42:39", "text": "时间。你想避开蚂蚁人。"}, {"type": "subtitle", "time": 2562.55, "timestamp": "00:42:42", "text": "不太友善。"}, {"type": "subtitle", "time": 2567.43, "timestamp": "00:42:47", "text": "我的天啊。蚂蚁雾。那是"}, {"type": "subtitle", "time": 2570.069, "timestamp": "00:42:50", "text": "把它藏在显眼的地方。他说把它藏起来。"}, {"type": "subtitle", "time": 2571.75, "timestamp": "00:42:51", "text": "就在眼前。唉，我的……"}, {"type": "subtitle", "time": 2574.23, "timestamp": "00:42:54", "text": "宝藏。该死。"}]
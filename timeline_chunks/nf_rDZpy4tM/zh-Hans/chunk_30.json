[{"type": "subtitle", "time": 1803.029, "timestamp": "00:30:03", "text": "好吧，那是另一回事。我认为我们"}, {"type": "subtitle", "time": 1805.71, "timestamp": "00:30:05", "text": "会得到另一把不同的枪，或者"}, {"type": "subtitle", "time": 1810.07, "timestamp": "00:30:10", "text": "某物。拿不到那个箱子。屋顶。"}, {"type": "subtitle", "time": 1812.23, "timestamp": "00:30:12", "text": "老城区就在逃生通道的后面。我"}, {"type": "subtitle", "time": 1814.63, "timestamp": "00:30:14", "text": "听说这里很危险。所以，"}, {"type": "subtitle", "time": 1816.87, "timestamp": "00:30:16", "text": "你知道，你很可能会……"}, {"type": "subtitle", "time": 1820.19, "timestamp": "00:30:20", "text": "被枪击。这里就像无法无天的牛仔之地。"}, {"type": "subtitle", "time": 1824.11, "timestamp": "00:30:24", "text": "您好，欢迎来到老城区。老的"}, {"type": "subtitle", "time": 1828.23, "timestamp": "00:30:28", "text": "镇。我怎么帮你？"}, {"type": "subtitle", "time": 1830.789, "timestamp": "00:30:30", "text": "这是什么地方？我可能会说 fmi，但是"}, {"type": "subtitle", "time": 1832.63, "timestamp": "00:30:32", "text": "请问这是什么地方？"}, {"type": "subtitle", "time": 1834.549, "timestamp": "00:30:34", "text": "这一切究竟是怎么回事？嗯，我只是"}, {"type": "subtitle", "time": 1837.51, "timestamp": "00:30:37", "text": "我早就说过它叫老城区。那时候"}, {"type": "subtitle", "time": 1839.99, "timestamp": "00:30:39", "text": "最早登陆这颗小行星的是殖民者。"}, {"type": "subtitle", "time": 1841.83, "timestamp": "00:30:41", "text": "我们成立了一个小型免费交易站。"}, {"type": "subtitle", "time": 1844.07, "timestamp": "00:30:44", "text": "从银河系法律来看，任何人都可以"}, {"type": "subtitle", "time": 1847.83, "timestamp": "00:30:47", "text": "来吧，随他们便。如今，"}, {"type": "subtitle", "time": 1850.149, "timestamp": "00:30:50", "text": "Drag Town 抢尽了风头。但"}, {"type": "subtitle", "time": 1852.95, "timestamp": "00:30:52", "text": "有几年时间，老城区是"}, {"type": "subtitle", "time": 1856.23, "timestamp": "00:30:56", "text": "没什么大不了的。哦，我明白了。我"}, {"type": "subtitle", "time": 1858.63, "timestamp": "00:30:58", "text": "知道了。老城区就是古老的城区，"}]
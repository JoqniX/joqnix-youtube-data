[{"type": "subtitle", "time": 8401.59, "timestamp": "02:20:01", "text": "你知道，你可以利用那个时间气泡……"}, {"type": "subtitle", "time": 8404.95, "timestamp": "02:20:04", "text": "G3也是。尝试加载气泡"}, {"type": "subtitle", "time": 8412.07, "timestamp": "02:20:12", "text": "晶体。我们将会组成一支优秀的团队。"}, {"type": "subtitle", "time": 8414.23, "timestamp": "02:20:14", "text": "我能感觉到。听听所有内容"}, {"type": "subtitle", "time": 8416.389, "timestamp": "02:20:16", "text": "我说。"}, {"type": "subtitle", "time": 8420.75, "timestamp": "02:20:20", "text": "垃圾袋，宝贝。 N放屁"}, {"type": "subtitle", "time": 8423.349, "timestamp": "02:20:23", "text": "一个放屁很随意的家伙。没什么特别的"}, {"type": "subtitle", "time": 8425.51, "timestamp": "02:20:25", "text": "特别的。一点也不好笑。是的，"}, {"type": "subtitle", "time": 8427.75, "timestamp": "02:20:27", "text": "他确实经常放屁"}, {"type": "subtitle", "time": 8430.71, "timestamp": "02:20:30", "text": "不断地。他这样做是在……上"}, {"type": "subtitle", "time": 8432.79, "timestamp": "02:20:32", "text": "目的也很重要。他甚至把他推出去"}, {"type": "subtitle", "time": 8435.75, "timestamp": "02:20:35", "text": "他明明不必做这件事，却偏要去做。"}, {"type": "subtitle", "time": 8438.15, "timestamp": "02:20:38", "text": "他病了。他脑子有问题。"}, {"type": "subtitle", "time": 8445.91, "timestamp": "02:20:45", "text": "你好呀。"}, {"type": "subtitle", "time": 8448.63, "timestamp": "02:20:48", "text": "别再试图杀人了。那么，接下来呢？"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "你把赏金交到某个地方。去做"}, {"type": "subtitle", "time": 8453.27, "timestamp": "02:20:53", "text": "那。我们可以结束这次谈话了。此外，在此之前"}, {"type": "subtitle", "time": 8454.71, "timestamp": "02:20:54", "text": "我交出了赏金，我需要赚钱"}, {"type": "subtitle", "time": 8458.67, "timestamp": "02:20:58", "text": "当然，我全都拿到了。"}]
[{"type": "subtitle", "time": 13203.11, "timestamp": "03:40:03", "text": "米娅，等等。你是怎么找到我的？你是"}, {"type": "subtitle", "time": 13205.55, "timestamp": "03:40:05", "text": "来自《相信吗？》"}, {"type": "subtitle", "time": 13209.87, "timestamp": "03:40:09", "text": "哦，等等。中文怎么说？"}, {"type": "subtitle", "time": 13224.86, "timestamp": "03:40:24", "text": "呃，中文。"}, {"type": "subtitle", "time": 13232.07, "timestamp": "03:40:32", "text": "[音乐]"}, {"type": "subtitle", "time": 13247.15, "timestamp": "03:40:47", "text": "比利。如何"}, {"type": "subtitle", "time": 13256.19, "timestamp": "03:40:56", "text": "[音乐]"}]
[{"type": "subtitle", "time": 4621.35, "timestamp": "01:17:01", "text": "他们自己的粉丝群体和他们自己的所有爱好"}, {"type": "subtitle", "time": 4622.95, "timestamp": "01:17:02", "text": "社区，对吧？即使他们是"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "在一个庞大的星空景观家族中，或者"}, {"type": "subtitle", "time": 4629.669, "timestamp": "01:17:09", "text": "星景家族可以说他们拥有"}, {"type": "subtitle", "time": 4631.189, "timestamp": "01:17:11", "text": "就像不同的房间一样"}, {"type": "subtitle", "time": 4633.03, "timestamp": "01:17:13", "text": "你可以这样说，比如想想"}, {"type": "subtitle", "time": 4636.63, "timestamp": "01:17:16", "text": "是吗？是的。所以，所以，正如你所知"}, {"type": "subtitle", "time": 4640.149, "timestamp": "01:17:20", "text": "Starscape IRL Jan 会来吗？"}, {"type": "subtitle", "time": 4643.11, "timestamp": "01:17:23", "text": "《精神航行者》将于何时首播？"}, {"type": "subtitle", "time": 4647.27, "timestamp": "01:17:27", "text": "星期六，或者6月7日，或者7月7日"}, {"type": "subtitle", "time": 4650.59, "timestamp": "01:17:30", "text": "是1月份的，对吧？那么接下来会发生什么呢？"}, {"type": "subtitle", "time": 4653.27, "timestamp": "01:17:33", "text": "Psychosoan 将加入一个"}, {"type": "subtitle", "time": 4656.709, "timestamp": "01:17:36", "text": "她将在一个已建立的社区里……"}, {"type": "subtitle", "time": 4659.99, "timestamp": "01:17:39", "text": "她必须尽力做到最好，并且"}, {"type": "subtitle", "time": 4662.07, "timestamp": "01:17:42", "text": "就像喜欢给所有人留下深刻印象之类的。"}, {"type": "subtitle", "time": 4664.39, "timestamp": "01:17:44", "text": "诸如此类的事情，他们就是在尽力而为。"}, {"type": "subtitle", "time": 4666.39, "timestamp": "01:17:46", "text": "意思是像做内容和刷牙一样"}, {"type": "subtitle", "time": 4668.39, "timestamp": "01:17:48", "text": "就像第一印象一样，没错。"}, {"type": "subtitle", "time": 4669.91, "timestamp": "01:17:49", "text": "那些东西，首秀的东西，还有"}, {"type": "subtitle", "time": 4672.149, "timestamp": "01:17:52", "text": "之后的一切都发生在几场直播之后"}, {"type": "subtitle", "time": 4675.11, "timestamp": "01:17:55", "text": "任何地方都会有人"}, {"type": "subtitle", "time": 4678.229, "timestamp": "01:17:58", "text": "将会发现精神病患者，他们会"}]
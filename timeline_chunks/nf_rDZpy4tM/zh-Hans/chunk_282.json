[{"type": "subtitle", "time": 16930.23, "timestamp": "04:42:10", "text": "哦，漂亮的进攻。啊，"}, {"type": "subtitle", "time": 16932.39, "timestamp": "04:42:12", "text": "你快完成了。"}, {"type": "subtitle", "time": 16946.11, "timestamp": "04:42:26", "text": "他长出了翅膀"}, {"type": "subtitle", "time": 16948.67, "timestamp": "04:42:28", "text": "现在。"}, {"type": "subtitle", "time": 16957.43, "timestamp": "04:42:37", "text": "哇。哦，你可以反击。你可以"}, {"type": "subtitle", "time": 16971.27, "timestamp": "04:42:51", "text": "凉爽的。保持冷静。好的。我该怎么做？"}, {"type": "subtitle", "time": 16972.55, "timestamp": "04:42:52", "text": "反击他们？等等，等等，等等，等等"}, {"type": "subtitle", "time": 16975.03, "timestamp": "04:42:55", "text": "等等，等等，等等，等等。还有音乐"}, {"type": "subtitle", "time": 16976.55, "timestamp": "04:42:56", "text": "太棒了。我要把我的声音静音。"}]
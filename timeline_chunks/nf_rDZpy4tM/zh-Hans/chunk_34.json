[{"type": "subtitle", "time": 2040.87, "timestamp": "00:34:00", "text": "这颗小行星上有法律。我们无法制造"}, {"type": "subtitle", "time": 2043.19, "timestamp": "00:34:03", "text": "任何规则。如果你住在这里，你就必须"}, {"type": "subtitle", "time": 2046.549, "timestamp": "00:34:06", "text": "接受没有法律的情况。他并非最后一位。"}, {"type": "subtitle", "time": 2048.55, "timestamp": "00:34:08", "text": "说。"}, {"type": "subtitle", "time": 2057.03, "timestamp": "00:34:17", "text": "[音乐]"}, {"type": "subtitle", "time": 2061.829, "timestamp": "00:34:21", "text": "糟了，G3又出问题了。"}, {"type": "subtitle", "time": 2065.03, "timestamp": "00:34:25", "text": "该倒垃圾了。哦，我得到了"}, {"type": "subtitle", "time": 2066.71, "timestamp": "00:34:26", "text": "太自信了。我不知道。我不是"}, {"type": "subtitle", "time": 2068.869, "timestamp": "00:34:28", "text": "确实如此。对不起。看看我们。"}, {"type": "subtitle", "time": 2071.52, "timestamp": "00:34:31", "text": "我们才刚刚起步。活下去。"}, {"type": "subtitle", "time": 2079.03, "timestamp": "00:34:39", "text": "[音乐]"}]
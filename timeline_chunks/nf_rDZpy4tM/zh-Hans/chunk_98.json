[{"type": "subtitle", "time": 5881.27, "timestamp": "01:38:01", "text": "我该怎么做？"}, {"type": "subtitle", "time": 5884.07, "timestamp": "01:38:04", "text": "[音乐]"}, {"type": "subtitle", "time": 5890.229, "timestamp": "01:38:10", "text": "我必须阻止这一切。"}, {"type": "subtitle", "time": 5893.189, "timestamp": "01:38:13", "text": "这。"}, {"type": "subtitle", "time": 5894.95, "timestamp": "01:38:14", "text": "嘿，是个混蛋，他一直在乱搞"}, {"type": "subtitle", "time": 5897.91, "timestamp": "01:38:17", "text": "通过我们的训练演习。不要碰"}, {"type": "subtitle", "time": 5900.229, "timestamp": "01:38:20", "text": "你。"}, {"type": "subtitle", "time": 5909.189, "timestamp": "01:38:29", "text": "我只是说准备好开火了。"}, {"type": "subtitle", "time": 5910.84, "timestamp": "01:38:30", "text": "光盘。"}, {"type": "subtitle", "time": 5935.27, "timestamp": "01:38:55", "text": "他去了哪里？我的天哪，他"}]
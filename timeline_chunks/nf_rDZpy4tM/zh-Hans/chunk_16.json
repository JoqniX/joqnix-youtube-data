[{"type": "subtitle", "time": 962.71, "timestamp": "00:16:02", "text": "哦是的。是的当然。我会把你埋葬。"}, {"type": "subtitle", "time": 964.47, "timestamp": "00:16:04", "text": "是的，我爱你胜过一切。"}, {"type": "subtitle", "time": 979.949, "timestamp": "00:16:19", "text": "我的天哪。等等，让我拿"}, {"type": "subtitle", "time": 982.55, "timestamp": "00:16:22", "text": "格斯。你以前去过沙漠吗？"}, {"type": "subtitle", "time": 985.509, "timestamp": "00:16:25", "text": "真糟糕。 Gus很擅长用霰弹枪射击。"}, {"type": "subtitle", "time": 987.67, "timestamp": "00:16:27", "text": "黑色星期五促销。你到得晚了，"}, {"type": "subtitle", "time": 989.269, "timestamp": "00:16:29", "text": "所有好东西。不要你的"}, {"type": "subtitle", "time": 991.509, "timestamp": "00:16:31", "text": "尺寸。你抓住左边。屎在……"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "地板和所有人都在争吵"}, {"type": "subtitle", "time": 995.43, "timestamp": "00:16:35", "text": "东西。这就是沙漠。不"}, {"type": "subtitle", "time": 997.749, "timestamp": "00:16:37", "text": "这东西不错。"}, {"type": "subtitle", "time": 999.79, "timestamp": "00:16:39", "text": "哦，我的"}, {"type": "subtitle", "time": 1011.749, "timestamp": "00:16:51", "text": "他们？哦，他们说他们会让你上去。"}]
[{"type": "subtitle", "time": 11340.71, "timestamp": "03:09:00", "text": "Temples将于1月7日首映。"}, {"type": "subtitle", "time": 11342.349, "timestamp": "03:09:02", "text": "那就是"}, {"type": "subtitle", "time": 11350.71, "timestamp": "03:09:10", "text": "我不知道我们是否经历过同样的战斗"}, {"type": "subtitle", "time": 11351.95, "timestamp": "03:09:11", "text": "种类"}, {"type": "subtitle", "time": 11355.59, "timestamp": "03:09:15", "text": "有点像增加光泽，或者像……"}, {"type": "subtitle", "time": 11358.11, "timestamp": "03:09:18", "text": "某种程度上来说，这是个同伴牧场。同一种"}, {"type": "subtitle", "time": 11368.389, "timestamp": "03:09:28", "text": "长相都差不多。我不知道。"}, {"type": "subtitle", "time": 11369.99, "timestamp": "03:09:29", "text": "这就是我的头发类型。"}, {"type": "subtitle", "time": 11373.67, "timestamp": "03:09:33", "text": "想给乔克准备一个备用方案"}, {"type": "subtitle", "time": 11376.63, "timestamp": "03:09:36", "text": "形式或其他什么。但我不知道。在"}, {"type": "subtitle", "time": 11378.75, "timestamp": "03:09:38", "text": "某种程度上，我当时是这样的："}, {"type": "subtitle", "time": 11382.15, "timestamp": "03:09:42", "text": "哇，太可爱了。他好可爱。"}, {"type": "subtitle", "time": 11384.87, "timestamp": "03:09:44", "text": "射杀了凯，但也有一部分我感觉像……哦"}, {"type": "subtitle", "time": 11388.07, "timestamp": "03:09:48", "text": "我的天啊，为什么一切都几乎都对了？"}, {"type": "subtitle", "time": 11391.87, "timestamp": "03:09:51", "text": "类似于 jock jock 的 oc"}, {"type": "subtitle", "time": 11394.75, "timestamp": "03:09:54", "text": "设计"}, {"type": "subtitle", "time": 11399.07, "timestamp": "03:09:59", "text": "然后，我就不知道我为什么开始了。"}]
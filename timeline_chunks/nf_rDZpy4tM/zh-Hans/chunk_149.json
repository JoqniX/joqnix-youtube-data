[{"type": "subtitle", "time": 8956.429, "timestamp": "02:29:16", "text": "门。"}, {"type": "subtitle", "time": 8968.83, "timestamp": "02:29:28", "text": "哟，"}, {"type": "subtitle", "time": 8973.389, "timestamp": "02:29:33", "text": "什么？它就升起来了。不，"}, {"type": "subtitle", "time": 8976.389, "timestamp": "02:29:36", "text": "已剪辑。它把我向上托起，然后我"}, {"type": "subtitle", "time": 8979.83, "timestamp": "02:29:39", "text": "被剪断并摔倒了。我的天啊。我的"}, {"type": "subtitle", "time": 8987.63, "timestamp": "02:29:47", "text": "你走，我讲，我射。"}]
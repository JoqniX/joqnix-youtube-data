[{"type": "subtitle", "time": 10621.429, "timestamp": "02:57:01", "text": "希望您喜欢。希望你真的这么做了"}, {"type": "subtitle", "time": 10623.07, "timestamp": "02:57:03", "text": "享受"}, {"type": "subtitle", "time": 10627.11, "timestamp": "02:57:07", "text": "今天。所以那些过来的人，哦，我的"}, {"type": "subtitle", "time": 10633.429, "timestamp": "02:57:13", "text": "音乐又一次让我沉醉其中。哦，我的"}, {"type": "subtitle", "time": 10636.23, "timestamp": "02:57:16", "text": "天哪，它又来折磨我了。我想"}, {"type": "subtitle", "time": 10638.79, "timestamp": "02:57:18", "text": "每当我听到"}, {"type": "subtitle", "time": 10642.83, "timestamp": "02:57:22", "text": "这是艾森创作的背景音乐。"}, {"type": "subtitle", "time": 10645.75, "timestamp": "02:57:25", "text": "这让我很想敞开心扉地倾诉。"}, {"type": "subtitle", "time": 10647.71, "timestamp": "02:57:27", "text": "或者别的什么。我不"}, {"type": "subtitle", "time": 10656.03, "timestamp": "02:57:36", "text": "这。我对此毫无抵抗力。"}, {"type": "subtitle", "time": 10658.87, "timestamp": "02:57:38", "text": "歌曲。这首乐曲。我对此很无力"}, {"type": "subtitle", "time": 10667.23, "timestamp": "02:57:47", "text": "[音乐]"}, {"type": "subtitle", "time": 10669.75, "timestamp": "02:57:49", "text": "这也让我想要谈论……"}, {"type": "subtitle", "time": 10672.99, "timestamp": "02:57:52", "text": "今天我在这里注意到了一件事"}, {"type": "subtitle", "time": 10676.23, "timestamp": "02:57:56", "text": "早晨。我不知道我是否应该说话。"}]
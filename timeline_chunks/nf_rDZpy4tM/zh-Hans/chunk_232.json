[{"type": "subtitle", "time": 13922.95, "timestamp": "03:52:02", "text": "一切。是的。是的。就是这样。但"}, {"type": "subtitle", "time": 13926.95, "timestamp": "03:52:06", "text": "从某种意义上说，我想应该不多吧。"}, {"type": "subtitle", "time": 13930.349, "timestamp": "03:52:10", "text": "我没有朋友"}, {"type": "subtitle", "time": 13931.87, "timestamp": "03:52:11", "text": "附近"}, {"type": "subtitle", "time": 13937.75, "timestamp": "03:52:17", "text": "我可以和谁出去玩？"}, {"type": "subtitle", "time": 13940.349, "timestamp": "03:52:20", "text": "挂出。不，我没有"}, {"type": "subtitle", "time": 13942.349, "timestamp": "03:52:22", "text": "任何人。"}, {"type": "subtitle", "time": 13945.189, "timestamp": "03:52:25", "text": "所以它们大多都很远。大部分"}, {"type": "subtitle", "time": 13948.79, "timestamp": "03:52:28", "text": "他们都在忙自己的事情。"}, {"type": "subtitle", "time": 13950.79, "timestamp": "03:52:30", "text": "我相信他们大多数人都毕业了。"}, {"type": "subtitle", "time": 13953.469, "timestamp": "03:52:33", "text": "大学之类的"}, {"type": "subtitle", "time": 13955.229, "timestamp": "03:52:35", "text": "现在。"}, {"type": "subtitle", "time": 13960.71, "timestamp": "03:52:40", "text": "哇。时间过得真快。时间过得真快。"}, {"type": "subtitle", "time": 13973.91, "timestamp": "03:52:53", "text": "是的，很高兴看到这一点。呃，就像"}, {"type": "subtitle", "time": 13976.67, "timestamp": "03:52:56", "text": "感觉很高兴看到"}]
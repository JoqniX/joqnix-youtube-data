[{"type": "subtitle", "time": 1082.87, "timestamp": "00:18:02", "text": "地方。等等，我可以吸胸口吗？"}, {"type": "subtitle", "time": 1084.63, "timestamp": "00:18:04", "text": "对你来说？等等，等等，等等。我想要"}, {"type": "subtitle", "time": 1087.71, "timestamp": "00:18:07", "text": "测试一下，对吧？我该如何获得"}, {"type": "subtitle", "time": 1091.789, "timestamp": "00:18:11", "text": "向上？我还没测试过呢。"}, {"type": "subtitle", "time": 1097.43, "timestamp": "00:18:17", "text": "猜测。是否可以关闭"}, {"type": "subtitle", "time": 1099.27, "timestamp": "00:18:19", "text": "糟糕？想听个很酷的消息吗？他们"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "把它降下来了。一块大磁铁。他们"}, {"type": "subtitle", "time": 1103.75, "timestamp": "00:18:23", "text": "简直把所有东西都吸进去了。就像"}, {"type": "subtitle", "time": 1106.31, "timestamp": "00:18:26", "text": "磁铁。所以，我把一切都吸收了。你"}, {"type": "subtitle", "time": 1108.31, "timestamp": "00:18:28", "text": "知道，港口地带的拾荒者们，"}, {"type": "subtitle", "time": 1110.549, "timestamp": "00:18:30", "text": "他们真的很有创意。等等，等等，"}, {"type": "subtitle", "time": 1112.07, "timestamp": "00:18:32", "text": "等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 1114.07, "timestamp": "00:18:34", "text": "等等，等等，等等。我有个主意。我得到了"}, {"type": "subtitle", "time": 1118.11, "timestamp": "00:18:38", "text": "一个想法。我带来了其中一项任务。"}, {"type": "subtitle", "time": 1121.669, "timestamp": "00:18:41", "text": "福克尔。把它举过来。我可以得到"}, {"type": "subtitle", "time": 1124.47, "timestamp": "00:18:44", "text": "向上跳跃的助力。是的，那是一个"}, {"type": "subtitle", "time": 1127.75, "timestamp": "00:18:47", "text": "好主意，乔。好的。你真是个聪明人。"}, {"type": "subtitle", "time": 1130.909, "timestamp": "00:18:50", "text": "是的。等等，我得找到其中一个。"}, {"type": "subtitle", "time": 1134.95, "timestamp": "00:18:54", "text": "正确的？继续吸吮它们。"}, {"type": "subtitle", "time": 1137.909, "timestamp": "00:18:57", "text": "是的。是的。是的。我爱你胜过一切"}]
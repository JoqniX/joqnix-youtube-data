[{"type": "subtitle", "time": 8461.59, "timestamp": "02:21:01", "text": "箱子。我记得我没有得到"}, {"type": "subtitle", "time": 8462.75, "timestamp": "02:21:02", "text": "很少"}, {"type": "subtitle", "time": 8466.23, "timestamp": "02:21:06", "text": "某处的箱子。最后。我做了什么？"}, {"type": "subtitle", "time": 8475.27, "timestamp": "02:21:15", "text": "我的天。钓鱼很烦人，"}, {"type": "subtitle", "time": 8476.87, "timestamp": "02:21:16", "text": "别拉伤肌肉，赏金猎人。"}, {"type": "subtitle", "time": 8489.23, "timestamp": "02:21:29", "text": "这是正确的。你需要男人，即使"}, {"type": "subtitle", "time": 8493.429, "timestamp": "02:21:33", "text": "现在。即使到了现在，他的脸色也没有变大。"}, {"type": "subtitle", "time": 8496.389, "timestamp": "02:21:36", "text": "后退。"}]
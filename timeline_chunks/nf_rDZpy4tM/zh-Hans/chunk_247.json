[{"type": "subtitle", "time": 14820.95, "timestamp": "04:07:00", "text": "[掌声]"}, {"type": "subtitle", "time": 14842.269, "timestamp": "04:07:22", "text": "你好"}, {"type": "subtitle", "time": 14846.07, "timestamp": "04:07:26", "text": "每个人。 W1.各位早上好。哦，我的"}, {"type": "subtitle", "time": 14849.269, "timestamp": "04:07:29", "text": "上帝。大家今天过得怎么样？哦，我的"}, {"type": "subtitle", "time": 14851.229, "timestamp": "04:07:31", "text": "上帝。你好吗？"}, {"type": "subtitle", "time": 14852.75, "timestamp": "04:07:32", "text": "伙计们？"}, {"type": "subtitle", "time": 14857.269, "timestamp": "04:07:37", "text": "你好。希望我没迟到。我的天啊。"}, {"type": "subtitle", "time": 14859.59, "timestamp": "04:07:39", "text": "服务器刚刚发布。我当时"}, {"type": "subtitle", "time": 14862.79, "timestamp": "04:07:42", "text": "我当时在看CN频道"}, {"type": "subtitle", "time": 14865.349, "timestamp": "04:07:45", "text": "配送流程，他们能够"}, {"type": "subtitle", "time": 14868.15, "timestamp": "04:07:48", "text": "玩。我当时就想，“哦。”然后我"}, {"type": "subtitle", "time": 14870.269, "timestamp": "04:07:50", "text": "跳上Roco"}, {"type": "subtitle", "time": 14873.95, "timestamp": "04:07:53", "text": "溪流。我的一位朋友，我的一位好朋友"}, {"type": "subtitle", "time": 14877.269, "timestamp": "04:07:57", "text": "Roco 和全球服务器也"}]
[{"type": "subtitle", "time": 30724.15, "timestamp": "08:32:04", "text": "Please avoid anything to do with that."}, {"type": "subtitle", "time": 30726.628, "timestamp": "08:32:06", "text": "Share the spells. I'mma try with my"}, {"type": "subtitle", "time": 30732.948, "timestamp": "08:32:12", "text": "Those references in the book seem"}, {"type": "subtitle", "time": 30735.91, "timestamp": "08:32:15", "text": "promising. Everything to do with Salazar"}, {"type": "subtitle", "time": 30738.708, "timestamp": "08:32:18", "text": "Slytherin seems promising. It's too"}, {"type": "subtitle", "time": 30742.308, "timestamp": "08:32:22", "text": "late. Too late. I hope Sebastian pursues"}, {"type": "subtitle", "time": 30744.948, "timestamp": "08:32:24", "text": "this no further. But if you think he"}, {"type": "subtitle", "time": 30749.11, "timestamp": "08:32:29", "text": "might, let me know. Oh no."}, {"type": "subtitle", "time": 30770.308, "timestamp": "08:32:50", "text": "zombie? I'm supposed to get out of this"}, {"type": "subtitle", "time": 30777.59, "timestamp": "08:32:57", "text": "I I cannot"}]
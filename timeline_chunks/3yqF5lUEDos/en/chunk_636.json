[{"type": "subtitle", "time": 38161.35, "timestamp": "10:36:01", "text": "Yeah, this is the guy who uh killed our"}, {"type": "subtitle", "time": 38165.906, "timestamp": "10:36:05", "text": "mother. This guy Pete studies marine"}, {"type": "subtitle", "time": 38172.47, "timestamp": "10:36:12", "text": "Look at that. I got one hand can still"}, {"type": "subtitle", "time": 38174.71, "timestamp": "10:36:14", "text": "tie a hook. You got two. Can Benny tie"}, {"type": "subtitle", "time": 38184.87, "timestamp": "10:36:24", "text": "Yeah."}, {"type": "subtitle", "time": 38187.83, "timestamp": "10:36:27", "text": "Used to help my daddy around. Hm. Spent"}, {"type": "subtitle", "time": 38189.746, "timestamp": "10:36:29", "text": "a lot of time together. What happened to"}, {"type": "subtitle", "time": 38192.87, "timestamp": "10:36:32", "text": "her daughter? We wasn't close."}, {"type": "subtitle", "time": 38195.03, "timestamp": "10:36:35", "text": "Ah, a son. He was a shark, hunter."}, {"type": "subtitle", "time": 38198.07, "timestamp": "10:36:38", "text": "That's all he was. If anybody were going"}, {"type": "subtitle", "time": 38202.07, "timestamp": "10:36:42", "text": "to catch the mega, it'd be him."}, {"type": "subtitle", "time": 38203.51, "timestamp": "10:36:43", "text": "Thought it was a government experiment."}, {"type": "subtitle", "time": 38206.87, "timestamp": "10:36:46", "text": "Got itself loose. Boy, he wanted that"}, {"type": "subtitle", "time": 38208.39, "timestamp": "10:36:48", "text": "child."}, {"type": "subtitle", "time": 38211.586, "timestamp": "10:36:51", "text": "Wanted it bad."}, {"type": "subtitle", "time": 38214.63, "timestamp": "10:36:54", "text": "Found it once."}, {"type": "subtitle", "time": 38217.266, "timestamp": "10:36:57", "text": "Didn't catch it. No."}]
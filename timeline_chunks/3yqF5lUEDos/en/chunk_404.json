[{"type": "subtitle", "time": 24247.11, "timestamp": "06:44:07", "text": "She is dead."}, {"type": "subtitle", "time": 24251.99, "timestamp": "06:44:11", "text": "He is that she just became a mummy. And"}, {"type": "subtitle", "time": 24257.99, "timestamp": "06:44:17", "text": "Who is that guy who looks like a"}, {"type": "subtitle", "time": 24260.39, "timestamp": "06:44:20", "text": "Dracula? Oh, wait."}, {"type": "subtitle", "time": 24268.468, "timestamp": "06:44:28", "text": "So, you're Catherine and also Haggi."}, {"type": "subtitle", "time": 24273.91, "timestamp": "06:44:33", "text": "[Music]"}, {"type": "subtitle", "time": 24278.948, "timestamp": "06:44:38", "text": "Can someone help me? She can't see me."}, {"type": "subtitle", "time": 24289.59, "timestamp": "06:44:49", "text": "That's a lady."}]
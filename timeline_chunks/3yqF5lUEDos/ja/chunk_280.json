[{"type": "subtitle", "time": 16800.39, "timestamp": "04:40:00", "text": "移動中。"}, {"type": "subtitle", "time": 16802.55, "timestamp": "04:40:02", "text": "えっと、あなたはこれをクリックしてるんですね、"}, {"type": "subtitle", "time": 16804.47, "timestamp": "04:40:04", "text": "右？何かを置くだけです"}, {"type": "subtitle", "time": 16806.868, "timestamp": "04:40:06", "text": "マウス上で。"}, {"type": "subtitle", "time": 16810.15, "timestamp": "04:40:10", "text": "左クリック。わかった。わかった。わかった。何てことだ、"}, {"type": "subtitle", "time": 16816.788, "timestamp": "04:40:16", "text": "それはとても賢いですね。"}, {"type": "subtitle", "time": 16818.868, "timestamp": "04:40:18", "text": "ご覧のとおり、モンスターがさらに多く出現しています"}, {"type": "subtitle", "time": 16840.39, "timestamp": "04:40:40", "text": "やらなきゃいけないことが山ほどある。何てことだ。"}, {"type": "subtitle", "time": 16842.788, "timestamp": "04:40:42", "text": "そして、ずる賢いクモが"}, {"type": "subtitle", "time": 16846.07, "timestamp": "04:40:46", "text": "上。クモでさえ生き残れない、"}, {"type": "subtitle", "time": 16849.59, "timestamp": "04:40:49", "text": "bo。ええ、それでもまだ下降傾向にあります。"}, {"type": "subtitle", "time": 16857.03, "timestamp": "04:40:57", "text": "ニース。"}]
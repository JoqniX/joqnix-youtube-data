[{"type": "subtitle", "time": 7295.43, "timestamp": "02:01:35", "text": "彼らは撤退している。素晴らしい仕事ぶりです。"}, {"type": "subtitle", "time": 7297.99, "timestamp": "02:01:37", "text": "私たちはこの日をいつまでも懐かしく思い出すでしょう。"}, {"type": "subtitle", "time": 7300.07, "timestamp": "02:01:40", "text": "すべて"}, {"type": "subtitle", "time": 7306.79, "timestamp": "02:01:46", "text": "インド。それが地図の名前です。"}, {"type": "subtitle", "time": 7311.03, "timestamp": "02:01:51", "text": "はい。すべて予想通りだった。"}]
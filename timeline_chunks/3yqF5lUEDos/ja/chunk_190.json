[{"type": "subtitle", "time": 11400.15, "timestamp": "03:10:00", "text": "うん。待って。ええと、これはええ。の"}, {"type": "subtitle", "time": 11407.99, "timestamp": "03:10:07", "text": "そうそう。これです。"}, {"type": "subtitle", "time": 11411.83, "timestamp": "03:10:11", "text": "うん。中に猫がいるよ。うん。"}, {"type": "subtitle", "time": 11414.55, "timestamp": "03:10:14", "text": "その他の石の種類。何もありません。これ"}, {"type": "subtitle", "time": 11417.19, "timestamp": "03:10:17", "text": "石です。開ける。開封するプレゼント。うん。"}, {"type": "subtitle", "time": 11420.309, "timestamp": "03:10:20", "text": "これは私の誕生日の出来事でした。ズキ。ズキ。それ"}, {"type": "subtitle", "time": 11422.55, "timestamp": "03:10:22", "text": "何も取らなかった。"}, {"type": "subtitle", "time": 11426.71, "timestamp": "03:10:26", "text": "本を読み上げてください。ああ、神様。"}, {"type": "subtitle", "time": 11430.63, "timestamp": "03:10:30", "text": "待って。いいえ、いいえ。彼女は農業をたくさんしていました。"}, {"type": "subtitle", "time": 11432.309, "timestamp": "03:10:32", "text": "ああ、"}, {"type": "subtitle", "time": 11435.91, "timestamp": "03:10:35", "text": "これです。ああ、神様。私は読むべきだった"}, {"type": "subtitle", "time": 11437.67, "timestamp": "03:10:37", "text": "それ？"}, {"type": "subtitle", "time": 11439.99, "timestamp": "03:10:39", "text": "レディット。"}, {"type": "subtitle", "time": 11443.99, "timestamp": "03:10:43", "text": "何てことだ。こんにちは。これは手紙ではありません"}, {"type": "subtitle", "time": 11445.59, "timestamp": "03:10:45", "text": "前回と同様です。代わりに、"}, {"type": "subtitle", "time": 11448.71, "timestamp": "03:10:48", "text": "感謝の気持ちを込めた贈り物です。ありがとう"}, {"type": "subtitle", "time": 11450.87, "timestamp": "03:10:50", "text": "基地の仲間。たとえ私がたくさんプレイできなくても"}, {"type": "subtitle", "time": 11452.87, "timestamp": "03:10:52", "text": "もうあなたとゲームをするのはやめます、正直に言うと、"}, {"type": "subtitle", "time": 11455.75, "timestamp": "03:10:55", "text": "あなたと一緒にマインクラフトをプレイします。"}, {"type": "subtitle", "time": 11458.07, "timestamp": "03:10:58", "text": "原神をプレイしたり、あまりお手伝いすることはできません"}]
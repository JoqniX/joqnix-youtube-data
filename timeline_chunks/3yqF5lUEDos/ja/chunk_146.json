[{"type": "subtitle", "time": 8763.11, "timestamp": "02:26:03", "text": "今日は運転教習を欠席しました。"}, {"type": "subtitle", "time": 8766.15, "timestamp": "02:26:06", "text": "とても申し訳ない気持ちになった。ああ、試験が私の"}, {"type": "subtitle", "time": 8770.389, "timestamp": "02:26:10", "text": "運転免許試験は27日です"}, {"type": "subtitle", "time": 8776.389, "timestamp": "02:26:16", "text": "ああ、来週の土曜日は24日だ"}, {"type": "subtitle", "time": 8779.67, "timestamp": "02:26:19", "text": "クリスマス25日です。日曜日は26日です。"}, {"type": "subtitle", "time": 8788.55, "timestamp": "02:26:28", "text": "私たちは働かなければならない。話し合う必要がある。はい。"}, {"type": "subtitle", "time": 8791.429, "timestamp": "02:26:31", "text": "仕事関係。"}, {"type": "subtitle", "time": 8793.91, "timestamp": "02:26:33", "text": "こんにちは。ええ、ええと、"}, {"type": "subtitle", "time": 8797.67, "timestamp": "02:26:37", "text": "最初からそこにいたが、"}, {"type": "subtitle", "time": 8800.309, "timestamp": "02:26:40", "text": "私のボードの電源を入れたので、"}, {"type": "subtitle", "time": 8802.55, "timestamp": "02:26:42", "text": "お名前を間違えてしまって、本当にごめんなさい。"}, {"type": "subtitle", "time": 8805.429, "timestamp": "02:26:45", "text": "それで"}, {"type": "subtitle", "time": 8807.67, "timestamp": "02:26:47", "text": "来るために"}, {"type": "subtitle", "time": 8818.23, "timestamp": "02:26:58", "text": "えっと"}]
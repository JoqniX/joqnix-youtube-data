[{"type": "subtitle", "time": 20580.948, "timestamp": "05:43:00", "text": "PCちゃんに何かが起こったので、"}, {"type": "subtitle", "time": 20582.788, "timestamp": "05:43:02", "text": "できなかった"}, {"type": "subtitle", "time": 20585.67, "timestamp": "05:43:05", "text": "出席したので、あの、えっと"}, {"type": "subtitle", "time": 20587.91, "timestamp": "05:43:07", "text": "来週やろう、そして最後に私は"}, {"type": "subtitle", "time": 20591.03, "timestamp": "05:43:11", "text": "今週それができてよかった。"}, {"type": "subtitle", "time": 20594.548, "timestamp": "05:43:14", "text": "はい。そうですね、"}, {"type": "subtitle", "time": 20597.91, "timestamp": "05:43:17", "text": "Arasuch Chama のストリームがたくさんあります"}, {"type": "subtitle", "time": 20601.43, "timestamp": "05:43:21", "text": "未来、だって、だって、ワクワクしてるから、だって、"}, {"type": "subtitle", "time": 20604.15, "timestamp": "05:43:24", "text": "9月ですね、9月だと思います。"}, {"type": "subtitle", "time": 20606.628, "timestamp": "05:43:26", "text": "9月中旬または9月末までに"}, {"type": "subtitle", "time": 20610.788, "timestamp": "05:43:30", "text": "少なくとも10月までには確実に"}, {"type": "subtitle", "time": 20612.868, "timestamp": "05:43:32", "text": "GPUを取得します"}, {"type": "subtitle", "time": 20616.15, "timestamp": "05:43:36", "text": "新しいCPU関連すべて"}, {"type": "subtitle", "time": 20620.23, "timestamp": "05:43:40", "text": "ついにApex Valerinをプレイできる"}, {"type": "subtitle", "time": 20623.27, "timestamp": "05:43:43", "text": "私がプレイしたいゲーム。私は演奏できます"}, {"type": "subtitle", "time": 20626.15, "timestamp": "05:43:46", "text": "アルスチャと一緒で、PCはありません"}, {"type": "subtitle", "time": 20629.19, "timestamp": "05:43:49", "text": "制限やFPS制限はもうありません。おお"}, {"type": "subtitle", "time": 20631.75, "timestamp": "05:43:51", "text": "ああ、本当に嬉しい。"}, {"type": "subtitle", "time": 20633.99, "timestamp": "05:43:53", "text": "私はただその瞬間を待っているだけです"}, {"type": "subtitle", "time": 20637.19, "timestamp": "05:43:57", "text": "君はまるで"}]
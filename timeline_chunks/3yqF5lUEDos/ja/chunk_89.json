[{"type": "subtitle", "time": 5348.709, "timestamp": "01:29:08", "text": "これは橋だったのか？何てことだ。"}, {"type": "subtitle", "time": 5352.229, "timestamp": "01:29:12", "text": "何てことだ。私はひどく打ちのめされた。"}, {"type": "subtitle", "time": 5354.87, "timestamp": "01:29:14", "text": "ああ、ひどい目に遭った。何"}, {"type": "subtitle", "time": 5388.55, "timestamp": "01:29:48", "text": "こんにちは。何って言ったの？さあ行こう。私は言った"}, {"type": "subtitle", "time": 5398.709, "timestamp": "01:29:58", "text": "どういう意味ですか？ステップ"}]
[{"type": "subtitle", "time": 12482.229, "timestamp": "03:28:02", "text": "確か100点くらい取ったと思う。"}, {"type": "subtitle", "time": 12485.349, "timestamp": "03:28:05", "text": "100個ありますか？それをした後、"}, {"type": "subtitle", "time": 12489.19, "timestamp": "03:28:09", "text": "アカウント停止処分を受けた。私はあなたを追放した覚えはありません。"}, {"type": "subtitle", "time": 12496.95, "timestamp": "03:28:16", "text": "ええ、そうではありません。よし、行こう。"}, {"type": "subtitle", "time": 12498.469, "timestamp": "03:28:18", "text": "レベル分けは必要ありません。"}, {"type": "subtitle", "time": 12507.429, "timestamp": "03:28:27", "text": "では、他に何があるというのか？何だったか忘れた"}, {"type": "subtitle", "time": 12511.03, "timestamp": "03:28:31", "text": "そうでなければ、私たちは終わりを迎えた。えっと、それからあなたは"}, {"type": "subtitle", "time": 12513.99, "timestamp": "03:28:33", "text": "祭りの準備。"}, {"type": "subtitle", "time": 12518.79, "timestamp": "03:28:38", "text": "えっと、他に何かありますか？"}, {"type": "subtitle", "time": 12523.51, "timestamp": "03:28:43", "text": "ようこそ、ミク。何だって？"}, {"type": "subtitle", "time": 12525.83, "timestamp": "03:28:45", "text": "サーバーでの最後のイベントは"}, {"type": "subtitle", "time": 12530.309, "timestamp": "03:28:50", "text": "フェスティバル。 H 最後のイベントはまだ"}, {"type": "subtitle", "time": 12533.349, "timestamp": "03:28:53", "text": "流れを覚えておいてください。何てことだ。どれの"}, {"type": "subtitle", "time": 12535.429, "timestamp": "03:28:55", "text": "1つ？"}, {"type": "subtitle", "time": 12537.91, "timestamp": "03:28:57", "text": "私たちは二人とも「待って、わからない」をストリーミングしました"}]
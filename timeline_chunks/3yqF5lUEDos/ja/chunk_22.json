[{"type": "subtitle", "time": 1321.19, "timestamp": "00:22:01", "text": "ああ、でもそうなりそうですね。"}, {"type": "subtitle", "time": 1330.47, "timestamp": "00:22:10", "text": "ズキ、もしできるなら、私もそうするよ。"}, {"type": "subtitle", "time": 1333.75, "timestamp": "00:22:13", "text": "えーと、もし私が、もし私ができるなら、えーと、もう十分だ、"}, {"type": "subtitle", "time": 1336.39, "timestamp": "00:22:16", "text": "私はあなたに送ります"}, {"type": "subtitle", "time": 1340.71, "timestamp": "00:22:20", "text": "えーと、ブログ記事で、えーと、説明している"}, {"type": "subtitle", "time": 1345.19, "timestamp": "00:22:25", "text": "すべての詳細、すべての設定、なぜ"}, {"type": "subtitle", "time": 1348.549, "timestamp": "00:22:28", "text": "あなたはそれを変えるべきです、そしてそれは"}, {"type": "subtitle", "time": 1351.75, "timestamp": "00:22:31", "text": "それが何をするのかなど。だからできない"}, {"type": "subtitle", "time": 1354.549, "timestamp": "00:22:34", "text": "通常、あなた自身はそれを知ることはできません。"}, {"type": "subtitle", "time": 1374.63, "timestamp": "00:22:54", "text": "何てことだ。何てことだ。何てことだ。私は"}]
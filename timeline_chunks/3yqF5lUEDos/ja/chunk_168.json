[{"type": "subtitle", "time": 10087.67, "timestamp": "02:48:07", "text": "うん。あなたは「たぶん」と言いましたね。うん。 S. 待って"}, {"type": "subtitle", "time": 10090.55, "timestamp": "02:48:10", "text": "私は推測する。待って。温泉ですよね？"}, {"type": "subtitle", "time": 10097.11, "timestamp": "02:48:17", "text": "温泉。うん。たぶんSaだと思う。"}, {"type": "subtitle", "time": 10099.51, "timestamp": "02:48:19", "text": "全く分からない。もうここを出よう。私たちは"}, {"type": "subtitle", "time": 10107.83, "timestamp": "02:48:27", "text": "ああ、ここはいい場所だ。うん。リラックスするために"}, {"type": "subtitle", "time": 10110.469, "timestamp": "02:48:30", "text": "外に出て、すべて。"}, {"type": "subtitle", "time": 10113.19, "timestamp": "02:48:33", "text": "大丈夫です。うん。"}, {"type": "subtitle", "time": 10116.07, "timestamp": "02:48:36", "text": "腕の良い建築業者がいる。"}, {"type": "subtitle", "time": 10120.95, "timestamp": "02:48:40", "text": "ああ、ここには3人か4人の子供がいたよ。"}, {"type": "subtitle", "time": 10125.83, "timestamp": "02:48:45", "text": "ああ、それはすごい人だ。"}, {"type": "subtitle", "time": 10128.55, "timestamp": "02:48:48", "text": "まあ、試みではあるけどね。"}, {"type": "subtitle", "time": 10131.11, "timestamp": "02:48:51", "text": "もちろん、彼らは誘惑に駆られるだろう。ああ、彼らは"}, {"type": "subtitle", "time": 10134.07, "timestamp": "02:48:54", "text": "t."}, {"type": "subtitle", "time": 10135.75, "timestamp": "02:48:55", "text": "よし、これで終わりだ。私たちは"}, {"type": "subtitle", "time": 10139.269, "timestamp": "02:48:59", "text": "あの巨大な木。あの巨大な木はどこにあったのか"}]
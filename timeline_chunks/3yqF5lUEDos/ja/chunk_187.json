[{"type": "subtitle", "time": 11221.349, "timestamp": "03:07:01", "text": "これは何ですか？これは これは これは"}, {"type": "subtitle", "time": 11224.389, "timestamp": "03:07:04", "text": "そこに書いてあること。"}, {"type": "subtitle", "time": 11227.19, "timestamp": "03:07:07", "text": "これは、ええと、シンプルにいきましょう。"}, {"type": "subtitle", "time": 11229.349, "timestamp": "03:07:09", "text": "ここは刑務所だ。"}, {"type": "subtitle", "time": 11235.83, "timestamp": "03:07:15", "text": "私はここで悪い言葉は使っていません。つまり、"}, {"type": "subtitle", "time": 11240.469, "timestamp": "03:07:20", "text": "ここで一番悪い言葉。私は壊しました。おお。おお。"}, {"type": "subtitle", "time": 11244.389, "timestamp": "03:07:24", "text": "おお。ああ、それは文字通り刑務所だ。"}, {"type": "subtitle", "time": 11247.19, "timestamp": "03:07:27", "text": "私は思う。"}, {"type": "subtitle", "time": 11249.91, "timestamp": "03:07:29", "text": "なぜ刑務所を作ったのですか？"}, {"type": "subtitle", "time": 11254.23, "timestamp": "03:07:34", "text": "私ではありません。コロナだ。"}, {"type": "subtitle", "time": 11256.55, "timestamp": "03:07:36", "text": "何てことだ。"}, {"type": "subtitle", "time": 11259.19, "timestamp": "03:07:39", "text": "ああ、ベイビー。ドアの片側が施錠されている。"}, {"type": "subtitle", "time": 11261.269, "timestamp": "03:07:41", "text": "え、何？"}, {"type": "subtitle", "time": 11269.91, "timestamp": "03:07:49", "text": "よし、行こう。"}, {"type": "subtitle", "time": 11276.55, "timestamp": "03:07:56", "text": "力。"}]
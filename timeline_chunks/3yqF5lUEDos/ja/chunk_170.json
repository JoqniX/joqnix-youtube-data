[{"type": "subtitle", "time": 10200.87, "timestamp": "02:50:00", "text": "私はトップに立っている。木のてっぺんに。"}, {"type": "subtitle", "time": 10204.55, "timestamp": "02:50:04", "text": "ああ、水の中だよ。ああ、神様。水の中。"}, {"type": "subtitle", "time": 10207.429, "timestamp": "02:50:07", "text": "私は水の中にいます。"}, {"type": "subtitle", "time": 10211.349, "timestamp": "02:50:11", "text": "水の中。はい。ああ、これは"}, {"type": "subtitle", "time": 10215.75, "timestamp": "02:50:15", "text": "クールなプラットフォームゲーム。コサンはいつ製造されましたか？"}, {"type": "subtitle", "time": 10218.71, "timestamp": "02:50:18", "text": "これ？"}, {"type": "subtitle", "time": 10226.95, "timestamp": "02:50:26", "text": "待って、ここは私たちの基地だよね？トップ"}, {"type": "subtitle", "time": 10231.59, "timestamp": "02:50:31", "text": "基地、ストレージ、すべて。それはできる"}, {"type": "subtitle", "time": 10235.11, "timestamp": "02:50:35", "text": "こちらからアクセスしてください。おお。ジャンプしてもいいですか？"}, {"type": "subtitle", "time": 10239.59, "timestamp": "02:50:39", "text": "もし私が飛び降りたらどうなりますか？いいえ、私は死ぬでしょう。"}, {"type": "subtitle", "time": 10242.23, "timestamp": "02:50:42", "text": "私は文字通りトップの頂点にいます"}, {"type": "subtitle", "time": 10244.79, "timestamp": "02:50:44", "text": "木ですよね？今行ってる。はい、そこにいます"}, {"type": "subtitle", "time": 10247.59, "timestamp": "02:50:47", "text": "は。"}, {"type": "subtitle", "time": 10255.91, "timestamp": "02:50:55", "text": "うん。時々気づかないけど、これは"}, {"type": "subtitle", "time": 10257.59, "timestamp": "02:50:57", "text": "巨大だ。"}, {"type": "subtitle", "time": 10259.99, "timestamp": "02:50:59", "text": "うん、これはすごいことだ。"}]
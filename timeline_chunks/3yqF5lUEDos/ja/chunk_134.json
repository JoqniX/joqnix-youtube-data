[{"type": "subtitle", "time": 8040.069, "timestamp": "02:14:00", "text": "ソフトウェアとソフトウェアに優しく"}, {"type": "subtitle", "time": 8043.669, "timestamp": "02:14:03", "text": "あなたに親切にしてくれるでしょう。はい、その通りです。"}, {"type": "subtitle", "time": 8048.31, "timestamp": "02:14:08", "text": "配信前はこんな感じだった"}, {"type": "subtitle", "time": 8051.75, "timestamp": "02:14:11", "text": "2042年のバトルフィールドは"}, {"type": "subtitle", "time": 8054.55, "timestamp": "02:14:14", "text": "ヘビーゲーム。お願いします"}, {"type": "subtitle", "time": 8063.189, "timestamp": "02:14:23", "text": "働いてください"}, {"type": "subtitle", "time": 8066.149, "timestamp": "02:14:26", "text": "たとえ"}, {"type": "subtitle", "time": 8068.39, "timestamp": "02:14:28", "text": "クラッシュした場合"}, {"type": "subtitle", "time": 8072.87, "timestamp": "02:14:32", "text": "大丈夫ですが、はい、それから作業してください"}, {"type": "subtitle", "time": 8075.109, "timestamp": "02:14:35", "text": "このフレームを開始します"}, {"type": "subtitle", "time": 8078.95, "timestamp": "02:14:38", "text": "ゲーム用PCでね"}, {"type": "subtitle", "time": 8084.29, "timestamp": "02:14:44", "text": "マヤ"}, {"type": "subtitle", "time": 8086.629, "timestamp": "02:14:46", "text": "[音楽]"}, {"type": "subtitle", "time": 8092.39, "timestamp": "02:14:52", "text": "そして私や他の皆のために"}, {"type": "subtitle", "time": 8096.229, "timestamp": "02:14:56", "text": "ラグが発生していると言われました。"}, {"type": "subtitle", "time": 8098.709, "timestamp": "02:14:58", "text": "音声は大きくて、何もかも問題なかった。ありがとう"}]
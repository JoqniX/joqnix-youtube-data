[{"type": "subtitle", "time": 11700.95, "timestamp": "03:15:00", "text": "うん。すごくかっこいい。うん。パティ1。"}, {"type": "subtitle", "time": 11702.95, "timestamp": "03:15:02", "text": "わかった。"}, {"type": "subtitle", "time": 11705.19, "timestamp": "03:15:05", "text": "お招きいただきありがとうございます。どのように言いますか"}, {"type": "subtitle", "time": 11707.11, "timestamp": "03:15:07", "text": "日本語で言うと？"}, {"type": "subtitle", "time": 11712.229, "timestamp": "03:15:12", "text": "私は推測する。"}, {"type": "subtitle", "time": 11714.389, "timestamp": "03:15:14", "text": "うん。"}, {"type": "subtitle", "time": 11723.99, "timestamp": "03:15:23", "text": "私は外にいます。"}, {"type": "subtitle", "time": 11726.95, "timestamp": "03:15:26", "text": "あなたは私を置いていった。"}, {"type": "subtitle", "time": 11737.99, "timestamp": "03:15:37", "text": "よし、次はメインの地下室だ。"}, {"type": "subtitle", "time": 11741.99, "timestamp": "03:15:41", "text": "本当に行きたいの？うん。さようなら。"}, {"type": "subtitle", "time": 11750.309, "timestamp": "03:15:50", "text": "何てことだ。覚えておいて、彼はほとばしるように"}, {"type": "subtitle", "time": 11753.75, "timestamp": "03:15:53", "text": "難しい。何てことだ、"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "彼らはあの映像を覚えている。もし"}, {"type": "subtitle", "time": 11759.75, "timestamp": "03:15:59", "text": "このストリームで、またはそれを視聴するのが好きです。"}]
[{"type": "subtitle", "time": 11762.07, "timestamp": "03:16:02", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 11772.87, "timestamp": "03:16:12", "text": "わかった。ああ、そうそう、ベリーのことね。以前はよく＿＿していた"}, {"type": "subtitle", "time": 11776.71, "timestamp": "03:16:16", "text": "これらのベリーでHPを上げてください。"}, {"type": "subtitle", "time": 11778.229, "timestamp": "03:16:18", "text": "わかった。"}, {"type": "subtitle", "time": 11781.269, "timestamp": "03:16:21", "text": "ドゥキサンが"}, {"type": "subtitle", "time": 11783.91, "timestamp": "03:16:23", "text": "プレイもしていて、君を突き落として殺した。"}, {"type": "subtitle", "time": 11786.55, "timestamp": "03:16:26", "text": "ああ、そうだ。"}, {"type": "subtitle", "time": 11789.59, "timestamp": "03:16:29", "text": "何てことだ。そう、そうでない人たちのために"}, {"type": "subtitle", "time": 11793.91, "timestamp": "03:16:33", "text": "ここは私の拠点です。以前はよく＿＿していた"}, {"type": "subtitle", "time": 11797.51, "timestamp": "03:16:37", "text": "うん。何てことだ。何てことだ。猫と"}, {"type": "subtitle", "time": 11801.51, "timestamp": "03:16:41", "text": "犬たち。私の子供たち。このキノコ。"}, {"type": "subtitle", "time": 11803.19, "timestamp": "03:16:43", "text": "私たちはそれらを集めました。あなたたち二人とも"}, {"type": "subtitle", "time": 11806.63, "timestamp": "03:16:46", "text": "それらを集めた。そうだよね。"}, {"type": "subtitle", "time": 11811.03, "timestamp": "03:16:51", "text": "動物たちと、私たちのメインの農場、その他諸々。"}, {"type": "subtitle", "time": 11813.03, "timestamp": "03:16:53", "text": "ここはかつて私たちが住んでいた農場です"}, {"type": "subtitle", "time": 11818.15, "timestamp": "03:16:58", "text": "そしてこれは"}, {"type": "subtitle", "time": 11819.83, "timestamp": "03:16:59", "text": "拡大。"}]
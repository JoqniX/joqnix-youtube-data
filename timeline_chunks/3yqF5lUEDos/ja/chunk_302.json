[{"type": "subtitle", "time": 18122.788, "timestamp": "05:02:02", "text": "原神？つまり、昨日やったんです。"}, {"type": "subtitle", "time": 18124.788, "timestamp": "05:02:04", "text": "どうだった？"}, {"type": "subtitle", "time": 18127.99, "timestamp": "05:02:07", "text": "ええと、フォンテーヌ。泳ぐのは本当に楽しい"}, {"type": "subtitle", "time": 18129.59, "timestamp": "05:02:09", "text": "その周り。"}, {"type": "subtitle", "time": 18131.99, "timestamp": "05:02:11", "text": "うん。"}, {"type": "subtitle", "time": 18135.19, "timestamp": "05:02:15", "text": "どうもありがとうございます。"}, {"type": "subtitle", "time": 18137.35, "timestamp": "05:02:17", "text": "その後"}, {"type": "subtitle", "time": 18140.708, "timestamp": "05:02:20", "text": "そして、一番気付いたのは、"}, {"type": "subtitle", "time": 18145.83, "timestamp": "05:02:25", "text": "まだアートキャストをプレイしていません。それで"}, {"type": "subtitle", "time": 18149.99, "timestamp": "05:02:29", "text": "パズルをいくつかやりました。私は見つけました"}, {"type": "subtitle", "time": 18153.59, "timestamp": "05:02:33", "text": "少し難しいパズルのようなもの"}, {"type": "subtitle", "time": 18157.11, "timestamp": "05:02:37", "text": "水を適用すると、"}, {"type": "subtitle", "time": 18161.83, "timestamp": "05:02:41", "text": "2つの要素を同時に維持し、"}, {"type": "subtitle", "time": 18164.708, "timestamp": "05:02:44", "text": "数秒間一緒に歩くように"}, {"type": "subtitle", "time": 18168.39, "timestamp": "05:02:48", "text": "彼ら。難しいですね。必ず見つけ出す。"}, {"type": "subtitle", "time": 18171.11, "timestamp": "05:02:51", "text": "まだ終わっていないので、"}, {"type": "subtitle", "time": 18174.07, "timestamp": "05:02:54", "text": "スピードラン。夏のアーロンはもう終わりだ"}, {"type": "subtitle", "time": 18176.948, "timestamp": "05:02:56", "text": "クエストですが、ワールドクエストがいくつかあります"}]
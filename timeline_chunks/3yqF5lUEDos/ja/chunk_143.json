[{"type": "subtitle", "time": 8582.07, "timestamp": "02:23:02", "text": "ストリーム。こんにちは。生産的に行動しよう。こんにちは。"}, {"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "くそ。"}, {"type": "subtitle", "time": 8589.429, "timestamp": "02:23:09", "text": "でもでも"}, {"type": "subtitle", "time": 8591.99, "timestamp": "02:23:11", "text": "ゲームに基づいていない。わかった。つまり、もし"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "私はアート配信をやっていますが、それは問題ありません。のように"}, {"type": "subtitle", "time": 8599.83, "timestamp": "02:23:19", "text": "創造性、あるいは芸術性。私が"}, {"type": "subtitle", "time": 8611.11, "timestamp": "02:23:31", "text": "なんてこった。配信を終えるのは本当に辛い。"}, {"type": "subtitle", "time": 8615.91, "timestamp": "02:23:35", "text": "とても難しい。うん、本当に大変だよ。"}, {"type": "subtitle", "time": 8624.07, "timestamp": "02:23:44", "text": "はい。クレアチン。わかりました。するとそれは"}, {"type": "subtitle", "time": 8626.79, "timestamp": "02:23:46", "text": "わかった。ゲーム禁止。わかった。大丈夫。私はしません"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "ゲームに時間を費やす。"}, {"type": "subtitle", "time": 8633.03, "timestamp": "02:23:53", "text": "口の中に一度入ったら。"}]
[{"type": "subtitle", "time": 9600.469, "timestamp": "02:40:00", "text": "それでは、"}, {"type": "subtitle", "time": 9606.469, "timestamp": "02:40:06", "text": "サーバ。はい。ここに来て。さあ行こう。 NBC。"}, {"type": "subtitle", "time": 9609.349, "timestamp": "02:40:09", "text": "ええ、それが私たちが最後にやったことです。うん、"}, {"type": "subtitle", "time": 9611.429, "timestamp": "02:40:11", "text": "以前はそうだった。これは"}, {"type": "subtitle", "time": 9613.11, "timestamp": "02:40:13", "text": "サーバ。"}, {"type": "subtitle", "time": 9615.03, "timestamp": "02:40:15", "text": "はい。ここから始めます"}, {"type": "subtitle", "time": 9617.11, "timestamp": "02:40:17", "text": "サーバ。私が始めたんです。"}, {"type": "subtitle", "time": 9621.75, "timestamp": "02:40:21", "text": "はい。何てことだ。私たちはこれらを購入しました"}, {"type": "subtitle", "time": 9625.03, "timestamp": "02:40:25", "text": "待って、ズキはそこにいたの？"}, {"type": "subtitle", "time": 9627.99, "timestamp": "02:40:27", "text": "ええ、ズキもそこにいましたよ。ええ、彼女は演奏しました"}, {"type": "subtitle", "time": 9630.309, "timestamp": "02:40:30", "text": "サーバー内。ええ、ずいぶん昔のことですね。うん。"}, {"type": "subtitle", "time": 9632.71, "timestamp": "02:40:32", "text": "うん。うん。何てことだ。あなたは"}, {"type": "subtitle", "time": 9635.75, "timestamp": "02:40:35", "text": "ヘッダーのことだよ。はい、それらは"}, {"type": "subtitle", "time": 9637.429, "timestamp": "02:40:37", "text": "採掘関連。そしてこれが主な"}, {"type": "subtitle", "time": 9639.75, "timestamp": "02:40:39", "text": "入り口。うん。"}, {"type": "subtitle", "time": 9642.71, "timestamp": "02:40:42", "text": "何てことだ。彼らはそこでそれを使うべきだ。"}, {"type": "subtitle", "time": 9644.71, "timestamp": "02:40:44", "text": "ここにはたくさんの物があります。いくつかの"}, {"type": "subtitle", "time": 9648.15, "timestamp": "02:40:48", "text": "つるはし。ああ、モンスターハンター。あなたは殺した"}, {"type": "subtitle", "time": 9650.63, "timestamp": "02:40:50", "text": "1つ。何を殺したんだ？私は殺した"}, {"type": "subtitle", "time": 9654.469, "timestamp": "02:40:54", "text": "あちらの方を見ていた骸骨。"}, {"type": "subtitle", "time": 9658.469, "timestamp": "02:40:58", "text": "なるほど。私は、なぜあなたをそばに置いておくのかと思った"}]
[{"type": "subtitle", "time": 9727.19, "timestamp": "02:42:07", "text": "古いものは持っていますよ。"}, {"type": "subtitle", "time": 9729.99, "timestamp": "02:42:09", "text": "古いものが手元にあるといいですね。つまり私は"}, {"type": "subtitle", "time": 9732.07, "timestamp": "02:42:12", "text": "持っていませんか？あなたのように"}, {"type": "subtitle", "time": 9734.87, "timestamp": "02:42:14", "text": "古いアカウントを使っているんですよね？いいえ、これは"}, {"type": "subtitle", "time": 9737.19, "timestamp": "02:42:17", "text": "これは新しいアカウントです。"}, {"type": "subtitle", "time": 9741.75, "timestamp": "02:42:21", "text": "マイクロソフトの製品が今や主流になりつつあります。なるほど。うん、そう思う"}, {"type": "subtitle", "time": 9747.03, "timestamp": "02:42:27", "text": "バージョン1にはそれが含まれます。"}, {"type": "subtitle", "time": 9754.469, "timestamp": "02:42:34", "text": "わかった。わかった。骸骨の馬がいる。"}, {"type": "subtitle", "time": 9756.389, "timestamp": "02:42:36", "text": "そうそう。うん。覚えていますか"}, {"type": "subtitle", "time": 9758.79, "timestamp": "02:42:38", "text": "雷雨が発生し、たくさんの穴が開いた"}, {"type": "subtitle", "time": 9762.23, "timestamp": "02:42:42", "text": "来た？まるで6人いるみたいだった。ああ、神様。そこには"}, {"type": "subtitle", "time": 9765.67, "timestamp": "02:42:45", "text": "6人くらいだった。"}, {"type": "subtitle", "time": 9769.19, "timestamp": "02:42:49", "text": "うん。そしてこの家は誰の家だったのか"}, {"type": "subtitle", "time": 9770.87, "timestamp": "02:42:50", "text": "また？"}, {"type": "subtitle", "time": 9773.27, "timestamp": "02:42:53", "text": "ああ、ヒカリス。"}, {"type": "subtitle", "time": 9777.429, "timestamp": "02:42:57", "text": "ヒカランがそこにいる。見てみましょう。私は"}]
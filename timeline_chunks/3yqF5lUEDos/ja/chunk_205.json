[{"type": "subtitle", "time": 12300.07, "timestamp": "03:25:00", "text": "ニース。配信へようこ​​そ。"}, {"type": "subtitle", "time": 12304.07, "timestamp": "03:25:04", "text": "そこじゃなかったっけ？これです。わかった。"}, {"type": "subtitle", "time": 12307.99, "timestamp": "03:25:07", "text": "わかった。やってみました。木を植える"}, {"type": "subtitle", "time": 12310.07, "timestamp": "03:25:10", "text": "終わり、"}, {"type": "subtitle", "time": 12311.99, "timestamp": "03:25:11", "text": "でも、そうするとプロジェクトは"}, {"type": "subtitle", "time": 12315.11, "timestamp": "03:25:15", "text": "開始しました。そうそう。ここは農場です"}, {"type": "subtitle", "time": 12318.87, "timestamp": "03:25:18", "text": "そこには。そうそう。ココ、見ないで"}, {"type": "subtitle", "time": 12322.95, "timestamp": "03:25:22", "text": "彼らの目。あなたは苦しむことになるでしょう。"}, {"type": "subtitle", "time": 12325.99, "timestamp": "03:25:25", "text": "一瞬、彼らに気づかれたと思った。"}, {"type": "subtitle", "time": 12329.59, "timestamp": "03:25:29", "text": "新しいPCでプレイしよう。私はしません。"}, {"type": "subtitle", "time": 12334.389, "timestamp": "03:25:34", "text": "遅かれ早かれ、GPUを手に入れるつもりだ。"}, {"type": "subtitle", "time": 12338.71, "timestamp": "03:25:38", "text": "待って、君はどこにいるの？今降りてきます。私"}, {"type": "subtitle", "time": 12341.429, "timestamp": "03:25:41", "text": "下降傾向にある。"}, {"type": "subtitle", "time": 12345.19, "timestamp": "03:25:45", "text": "でも、確かに少ないのは分かっています。私は"}, {"type": "subtitle", "time": 12347.11, "timestamp": "03:25:47", "text": "現在ストリーミング配信もされています。そうですね、私は普段"}, {"type": "subtitle", "time": 12351.03, "timestamp": "03:25:51", "text": "ストリーミングなしで100個くらいある。待って、"}, {"type": "subtitle", "time": 12355.67, "timestamp": "03:25:55", "text": "私の意見は、ああ、それは良いですね。"}]
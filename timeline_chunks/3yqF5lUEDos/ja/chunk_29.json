[{"type": "subtitle", "time": 1764.47, "timestamp": "00:29:24", "text": "ジョッキー、おかげで素敵な一日になったよ。ありがとう。"}, {"type": "subtitle", "time": 1766.789, "timestamp": "00:29:26", "text": "いえ、結構です。"}, {"type": "subtitle", "time": 1786.389, "timestamp": "00:29:46", "text": "やっと録音できるようになって嬉しいです。はい。うん。"}, {"type": "subtitle", "time": 1789.11, "timestamp": "00:29:49", "text": "私の過去の実績。"}, {"type": "subtitle", "time": 1796.23, "timestamp": "00:29:56", "text": "[音楽]"}]
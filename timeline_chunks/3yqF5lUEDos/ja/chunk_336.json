[{"type": "subtitle", "time": 20160.708, "timestamp": "05:36:00", "text": "えっと、よくわからないんです。私の一部は"}, {"type": "subtitle", "time": 20162.47, "timestamp": "05:36:02", "text": "フォンテーヌのすべてをアンロックするには、"}, {"type": "subtitle", "time": 20165.75, "timestamp": "05:36:05", "text": "征服を行う前に知っておくべきことだ。"}, {"type": "subtitle", "time": 20167.51, "timestamp": "05:36:07", "text": "そして、私の中にはそうしたくない部分もある"}, {"type": "subtitle", "time": 20169.91, "timestamp": "05:36:09", "text": "それ。ゴールを見届けたいだけ"}, {"type": "subtitle", "time": 20172.868, "timestamp": "05:36:12", "text": "1つのエリアを上げて、次に別のエリアを上げるか、"}, {"type": "subtitle", "time": 20175.75, "timestamp": "05:36:15", "text": "何か。わからない。なるほど。全て"}, {"type": "subtitle", "time": 20178.31, "timestamp": "05:36:18", "text": "右。"}, {"type": "subtitle", "time": 20201.67, "timestamp": "05:36:41", "text": "私は本当に正しいと信じています。こんにちは、アラマさん、左へ"}, {"type": "subtitle", "time": 20204.708, "timestamp": "05:36:44", "text": "男。今日は本当に楽しかった。何てことだ。おお"}, {"type": "subtitle", "time": 20207.35, "timestamp": "05:36:47", "text": "我が神よ。"}, {"type": "subtitle", "time": 20210.868, "timestamp": "05:36:50", "text": "爆発するのは我々だけではない。"}, {"type": "subtitle", "time": 20215.35, "timestamp": "05:36:55", "text": "今日では、物を爆破するだけではありません。"}, {"type": "subtitle", "time": 20218.548, "timestamp": "05:36:58", "text": "私たちはたくさん話しました、そしてエマ・シャン・チャマも"}]
[{"type": "subtitle", "time": 12000.469, "timestamp": "03:20:00", "text": "[音楽]"}, {"type": "subtitle", "time": 12003.349, "timestamp": "03:20:03", "text": "シェルメモリ"}, {"type": "subtitle", "time": 12005.03, "timestamp": "03:20:05", "text": "夜に。見た目が良いのは"}, {"type": "subtitle", "time": 12008.229, "timestamp": "03:20:08", "text": "懐中電灯とかそういうもの。"}, {"type": "subtitle", "time": 12010.07, "timestamp": "03:20:10", "text": "夜になるまで一緒に過ごそうと言ってくれ。私は持っている"}, {"type": "subtitle", "time": 12013.67, "timestamp": "03:20:13", "text": "管理者権限。"}, {"type": "subtitle", "time": 12026.15, "timestamp": "03:20:26", "text": "この男は誰だ？こちらはアラシルです。"}, {"type": "subtitle", "time": 12029.42, "timestamp": "03:20:29", "text": "うん、良さそうだね。"}, {"type": "subtitle", "time": 12031.11, "timestamp": "03:20:31", "text": "[音楽]"}, {"type": "subtitle", "time": 12034.55, "timestamp": "03:20:34", "text": "うん、私たちが"}, {"type": "subtitle", "time": 12037.349, "timestamp": "03:20:37", "text": "戻る。覚えているのは、ここでただ回転していたとき"}, {"type": "subtitle", "time": 12042.55, "timestamp": "03:20:42", "text": "あなたはこれを作っていたのです。そうそう。"}, {"type": "subtitle", "time": 12044.87, "timestamp": "03:20:44", "text": "私は自分の最初の"}, {"type": "subtitle", "time": 12049.349, "timestamp": "03:20:49", "text": "この基地にはずっと前から計画があった。"}, {"type": "subtitle", "time": 12052.229, "timestamp": "03:20:52", "text": "覚えているのは「オーケー」という言葉だけだ。私が覚えているのは"}, {"type": "subtitle", "time": 12056.71, "timestamp": "03:20:56", "text": "大きな城を作りたかったのですが、"}, {"type": "subtitle", "time": 12059.51, "timestamp": "03:20:59", "text": "何かだけど、本当に本当に"}]
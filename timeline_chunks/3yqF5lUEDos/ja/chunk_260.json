[{"type": "subtitle", "time": 15602.229, "timestamp": "04:20:02", "text": "見つけた後の最高の気分"}, {"type": "subtitle", "time": 15605.91, "timestamp": "04:20:05", "text": "ロケットと電子と共にここに来た。"}, {"type": "subtitle", "time": 15608.149, "timestamp": "04:20:08", "text": "うん。 Isuk Isuki が作業している間"}, {"type": "subtitle", "time": 15610.149, "timestamp": "04:20:10", "text": "農場"}, {"type": "subtitle", "time": 15612.71, "timestamp": "04:20:12", "text": "私の基地では、私たちは二人とも"}, {"type": "subtitle", "time": 15616.79, "timestamp": "04:20:16", "text": "こちらで冒険し、戦う"}, {"type": "subtitle", "time": 15625.03, "timestamp": "04:20:25", "text": "この場所で。"}, {"type": "subtitle", "time": 15627.349, "timestamp": "04:20:27", "text": "そうそう。うん。私たちは"}, {"type": "subtitle", "time": 15630.71, "timestamp": "04:20:30", "text": "このことから、本をどこかに持っていく方法を見つける。"}, {"type": "subtitle", "time": 15633.67, "timestamp": "04:20:33", "text": "はい。この地域。"}, {"type": "subtitle", "time": 15635.91, "timestamp": "04:20:35", "text": "私は今、ドアを壊しました。わかった、"}, {"type": "subtitle", "time": 15650.87, "timestamp": "04:20:50", "text": "[音楽]"}, {"type": "subtitle", "time": 15653.429, "timestamp": "04:20:53", "text": "そこには人目につかない大邸宅があった。私"}]
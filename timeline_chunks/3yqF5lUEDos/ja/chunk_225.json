[{"type": "subtitle", "time": 13501.429, "timestamp": "03:45:01", "text": "そして、そういったものすべて。ええ、私たちは"}, {"type": "subtitle", "time": 13504.79, "timestamp": "03:45:04", "text": "手に入れようとしている。頭も、"}, {"type": "subtitle", "time": 13506.05, "timestamp": "03:45:06", "text": "右？"}, {"type": "subtitle", "time": 13507.83, "timestamp": "03:45:07", "text": "[音楽]"}, {"type": "subtitle", "time": 13511.67, "timestamp": "03:45:11", "text": "キーパーの頭。私はそれらを家に持っています、"}, {"type": "subtitle", "time": 13513.67, "timestamp": "03:45:13", "text": "考える。"}, {"type": "subtitle", "time": 13517.11, "timestamp": "03:45:17", "text": "つまり、1.5というのは感度のことですよね？もし"}, {"type": "subtitle", "time": 13519.83, "timestamp": "03:45:19", "text": "感度は1.5です。"}, {"type": "subtitle", "time": 13523.11, "timestamp": "03:45:23", "text": "2桁目を追加して"}, {"type": "subtitle", "time": 13527.75, "timestamp": "03:45:27", "text": "5時以降。つまり、1 50 か、いや、"}, {"type": "subtitle", "time": 13532.95, "timestamp": "03:45:32", "text": "ゼロを入力しないでください。 1.5ポイント 1.51"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "それは1.5の件を改良するものだ。追加"}, {"type": "subtitle", "time": 13537.99, "timestamp": "03:45:37", "text": "ビットをさらに細かくする別の数字"}, {"type": "subtitle", "time": 13541.349, "timestamp": "03:45:41", "text": "また。そうやって滑らかにするんだ。しかし"}, {"type": "subtitle", "time": 13543.11, "timestamp": "03:45:43", "text": "のように"}, {"type": "subtitle", "time": 13546.63, "timestamp": "03:45:46", "text": "これは1.5だとしましょう。わかった。もし私が"}, {"type": "subtitle", "time": 13548.87, "timestamp": "03:45:48", "text": "センスを1.5.11に"}, {"type": "subtitle", "time": 13550.55, "timestamp": "03:45:50", "text": "つまり少し"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "こうすると滑らかになる。同じになるでしょう"}, {"type": "subtitle", "time": 13555.429, "timestamp": "03:45:55", "text": "少しだけ小数点以下の値です。えっと"}, {"type": "subtitle", "time": 13556.71, "timestamp": "03:45:56", "text": "より滑らかに。"}, {"type": "subtitle", "time": 13559.349, "timestamp": "03:45:59", "text": "私は、"}]
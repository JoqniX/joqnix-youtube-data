[{"type": "subtitle", "time": 20040.47, "timestamp": "05:34:00", "text": "だから、あなたが去る前に、私も"}, {"type": "subtitle", "time": 20060.548, "timestamp": "05:34:20", "text": "はい。こんにちは。こんにちは。皆さん、来てくれてありがとう。"}, {"type": "subtitle", "time": 20065.11, "timestamp": "05:34:25", "text": "配信へようこ​​そ。招待していただきありがとうございます。"}, {"type": "subtitle", "time": 20067.11, "timestamp": "05:34:27", "text": "はい。私も招待していただき、ありがとうございます。"}, {"type": "subtitle", "time": 20070.788, "timestamp": "05:34:30", "text": "みんな。お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 20073.91, "timestamp": "05:34:33", "text": "二人の思い出を一緒に振り返る。そうだった"}, {"type": "subtitle", "time": 20077.03, "timestamp": "05:34:37", "text": "今日は本当に冒険だった。"}, {"type": "subtitle", "time": 20094.708, "timestamp": "05:34:54", "text": "えっと、もう終わりに近づいてるの？私はほしくない"}, {"type": "subtitle", "time": 20097.43, "timestamp": "05:34:57", "text": "最後にまとめたいのですが、同時にまとめたい気持ちもあります。"}]
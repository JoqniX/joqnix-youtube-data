[{"type": "subtitle", "time": 9006.469, "timestamp": "02:30:06", "text": "それでは、また次回お会いしましょう。"}, {"type": "subtitle", "time": 9012.23, "timestamp": "02:30:12", "text": "可愛さを忘れずに、バカでいてください"}, {"type": "subtitle", "time": 9016.309, "timestamp": "02:30:16", "text": "バカ。バカでもいいんだよ。"}, {"type": "subtitle", "time": 9019.59, "timestamp": "02:30:19", "text": "だから、この間は暖かく快適に過ごしてください。"}, {"type": "subtitle", "time": 9021.99, "timestamp": "02:30:21", "text": "ホリデーシーズン。"}, {"type": "subtitle", "time": 9024.71, "timestamp": "02:30:24", "text": "皆様、楽しい休日をお過ごしください。"}, {"type": "subtitle", "time": 9027.59, "timestamp": "02:30:27", "text": "クリスマスがもうすぐやってきます。"}, {"type": "subtitle", "time": 9030.389, "timestamp": "02:30:30", "text": "どんどん近づいてくる。うん、幸せ"}, {"type": "subtitle", "time": 9032.95, "timestamp": "02:30:32", "text": "皆さま、良い休日をお過ごしください。うん。私たちは"}, {"type": "subtitle", "time": 9035.59, "timestamp": "02:30:35", "text": "すぐにストリームから雪のものが"}, {"type": "subtitle", "time": 9038.15, "timestamp": "02:30:38", "text": "明日から。作りたい"}, {"type": "subtitle", "time": 9040.87, "timestamp": "02:30:40", "text": "クリスマスをテーマにした。そうですね、"}, {"type": "subtitle", "time": 9043.51, "timestamp": "02:30:43", "text": "私たちは氷流の中で活動する予定です。"}]
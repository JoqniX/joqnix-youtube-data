[{"type": "subtitle", "time": 17701.75, "timestamp": "04:55:01", "text": "混ぜてごちゃごちゃした感じにならないようにすればいいんじゃない？"}, {"type": "subtitle", "time": 17704.708, "timestamp": "04:55:04", "text": "上。わかった。建築のヒント。"}, {"type": "subtitle", "time": 17707.99, "timestamp": "04:55:07", "text": "他のプレイヤーのアイテムを盗まないでください。"}, {"type": "subtitle", "time": 17710.31, "timestamp": "04:55:10", "text": "ああ、覚えているよ。私は覚えています"}, {"type": "subtitle", "time": 17713.83, "timestamp": "04:55:13", "text": "誰かが私の本を盗んでいる。"}, {"type": "subtitle", "time": 17716.868, "timestamp": "04:55:16", "text": "不正行為は一切禁止です。"}, {"type": "subtitle", "time": 17720.628, "timestamp": "04:55:20", "text": "はぁ？私だったの？わからない。いいえ、あなた"}, {"type": "subtitle", "time": 17726.23, "timestamp": "04:55:26", "text": "幻のテープを覚えていますか？ああ、そうだね。"}, {"type": "subtitle", "time": 17731.11, "timestamp": "04:55:31", "text": "ああ、彼はやったよ。ええ、そうですね。六。今は"}, {"type": "subtitle", "time": 17733.35, "timestamp": "04:55:33", "text": "複製グリッチのように座ることが許可されています"}, {"type": "subtitle", "time": 17736.23, "timestamp": "04:55:36", "text": "あるいは、レントゲン写真のようなもの。岩盤を砕く"}, {"type": "subtitle", "time": 17738.39, "timestamp": "04:55:38", "text": "ネザーの頂上でのみ許可されています"}, {"type": "subtitle", "time": 17740.628, "timestamp": "04:55:40", "text": "それは大いに役立ち、いくつかの大企業によって支えられています"}, {"type": "subtitle", "time": 17744.15, "timestamp": "04:55:44", "text": "プレイヤー。ああ、そうそう、コード3だけが"}, {"type": "subtitle", "time": 17745.75, "timestamp": "04:55:45", "text": "サーバーの運営者。ええ、その間"}, {"type": "subtitle", "time": 17748.55, "timestamp": "04:55:48", "text": "その時は誰もOPにならないだろう"}, {"type": "subtitle", "time": 17750.788, "timestamp": "04:55:50", "text": "未来。彼はまた、"}, {"type": "subtitle", "time": 17753.83, "timestamp": "04:55:53", "text": "制限。後ほど掲載します"}, {"type": "subtitle", "time": 17755.91, "timestamp": "04:55:55", "text": "一部のイベントは、"}, {"type": "subtitle", "time": 17757.99, "timestamp": "04:55:57", "text": "サーバーは時々夏祭りのような"}]
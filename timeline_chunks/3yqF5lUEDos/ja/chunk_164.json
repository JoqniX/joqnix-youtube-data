[{"type": "subtitle", "time": 9841.269, "timestamp": "02:44:01", "text": "わかりました、ではあなたの本部へ向かいます。"}, {"type": "subtitle", "time": 9843.67, "timestamp": "02:44:03", "text": "そうそう。この場所。あなたが建てたもの。"}, {"type": "subtitle", "time": 9847.349, "timestamp": "02:44:07", "text": "この長蛇の列。そうそう。これです。おお、"}, {"type": "subtitle", "time": 9850.79, "timestamp": "02:44:10", "text": "うん。この農場。うん。見て、"}, {"type": "subtitle", "time": 9854.07, "timestamp": "02:44:14", "text": "村人や略奪者がたくさんいる。"}, {"type": "subtitle", "time": 9858.63, "timestamp": "02:44:18", "text": "おお。鉄のゴーレムを攻撃しないでください。"}, {"type": "subtitle", "time": 9863.51, "timestamp": "02:44:23", "text": "そうそう。覚えているよ。"}, {"type": "subtitle", "time": 9865.99, "timestamp": "02:44:25", "text": "これを見てください。この竹林は"}, {"type": "subtitle", "time": 9875.429, "timestamp": "02:44:35", "text": "上へ行きたいの？待って、どこにいるの？"}, {"type": "subtitle", "time": 9877.59, "timestamp": "02:44:37", "text": "では、どうやって上に登ればいいのでしょうか？忘れた。あれは"}, {"type": "subtitle", "time": 9879.99, "timestamp": "02:44:39", "text": "それ？そうそう。ええ、"}, {"type": "subtitle", "time": 9883.59, "timestamp": "02:44:43", "text": "これ。うん、"}, {"type": "subtitle", "time": 9886.79, "timestamp": "02:44:46", "text": "ニンジン農園。"}, {"type": "subtitle", "time": 9890.07, "timestamp": "02:44:50", "text": "あの時は全部一人でやったんだね。"}, {"type": "subtitle", "time": 9893.99, "timestamp": "02:44:53", "text": "それと、ソウルストーンみたいなやつ。"}, {"type": "subtitle", "time": 9896.79, "timestamp": "02:44:56", "text": "はい、どちらの単語もここにはありませんでした。"}]
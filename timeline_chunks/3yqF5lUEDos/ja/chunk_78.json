[{"type": "subtitle", "time": 4691.75, "timestamp": "01:18:11", "text": "何てことだ。ジョー。"}, {"type": "subtitle", "time": 4695.83, "timestamp": "01:18:15", "text": "ああ、私はいつもこんな感じなんです。どうすれば入手できますか"}, {"type": "subtitle", "time": 4698.55, "timestamp": "01:18:18", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 4700.87, "timestamp": "01:18:20", "text": "全て無駄だった。はぁ？いいえ、それは"}, {"type": "subtitle", "time": 4702.47, "timestamp": "01:18:22", "text": "無駄"}, {"type": "subtitle", "time": 4709.51, "timestamp": "01:18:29", "text": "え、何？あなたが話したことは何でしたか"}, {"type": "subtitle", "time": 4713.03, "timestamp": "01:18:33", "text": "もう一度やらせればいいの？忘れてしまった。"}, {"type": "subtitle", "time": 4714.87, "timestamp": "01:18:34", "text": "歌の練習をするように言われた。私は"}, {"type": "subtitle", "time": 4717.51, "timestamp": "01:18:37", "text": "そうしてきたよ。私は絵を描いています"}, {"type": "subtitle", "time": 4720.229, "timestamp": "01:18:40", "text": "若干。"}, {"type": "subtitle", "time": 4723.75, "timestamp": "01:18:43", "text": "そして今、私が退屈しているとき"}, {"type": "subtitle", "time": 4727.11, "timestamp": "01:18:47", "text": "紙に、"}, {"type": "subtitle", "time": 4738.79, "timestamp": "01:18:58", "text": "私があなたに言ったことは何でしたっけ？ええ、"}]
[{"type": "subtitle", "time": 20460.47, "timestamp": "05:41:00", "text": "すでに説明したけど、それはちょっと"}, {"type": "subtitle", "time": 20463.59, "timestamp": "05:41:03", "text": "ロバート・ジャクソンが皆さんにユニークな存在であること"}, {"type": "subtitle", "time": 20467.67, "timestamp": "05:41:07", "text": "チャマはそれを使う、なぜならそれは実際にはハッジだから"}, {"type": "subtitle", "time": 20470.23, "timestamp": "05:41:10", "text": "実際には朝の挨拶は"}, {"type": "subtitle", "time": 20472.23, "timestamp": "05:41:12", "text": "私の。"}, {"type": "subtitle", "time": 20476.07, "timestamp": "05:41:16", "text": "だから、どこへ行っても、もし私が"}, {"type": "subtitle", "time": 20480.07, "timestamp": "05:41:20", "text": "誰かが書いたオー・ジョーを見たことがあるだろうか"}, {"type": "subtitle", "time": 20481.83, "timestamp": "05:41:21", "text": "ああ、そうだ、それは"}, {"type": "subtitle", "time": 20484.47, "timestamp": "05:41:24", "text": "ロバート・ジャクソン。唯一そうする人"}, {"type": "subtitle", "time": 20487.51, "timestamp": "05:41:27", "text": "あれはロバート・ケンだ"}, {"type": "subtitle", "time": 20489.51, "timestamp": "05:41:29", "text": "なぜなら私の心はすでに"}, {"type": "subtitle", "time": 20491.59, "timestamp": "05:41:31", "text": "たった一人しかいないということを刷り込んだ"}, {"type": "subtitle", "time": 20496.47, "timestamp": "05:41:36", "text": "オハイオ州以外で「オー・ジョック」を使うのは誰？"}, {"type": "subtitle", "time": 20498.548, "timestamp": "05:41:38", "text": "朝はダメだ、あれはロバート・ジャクソンだ"}, {"type": "subtitle", "time": 20500.15, "timestamp": "05:41:40", "text": "アクション。"}, {"type": "subtitle", "time": 20502.788, "timestamp": "05:41:42", "text": "そうそう。お越しいただきありがとうございます。希望"}, {"type": "subtitle", "time": 20511.91, "timestamp": "05:41:51", "text": "手術の成功をお祈りしています。私"}, {"type": "subtitle", "time": 20514.15, "timestamp": "05:41:54", "text": "延期になったことは知ってるし、"}, {"type": "subtitle", "time": 20516.548, "timestamp": "05:41:56", "text": "今日は配信をしました。私はあなたの"}, {"type": "subtitle", "time": 20519.35, "timestamp": "05:41:59", "text": "私が出席していたストリーム"}]
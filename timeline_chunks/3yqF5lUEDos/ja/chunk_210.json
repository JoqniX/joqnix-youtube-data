[{"type": "subtitle", "time": 12601.75, "timestamp": "03:30:01", "text": "ああ、神様。はい。"}, {"type": "subtitle", "time": 12603.91, "timestamp": "03:30:03", "text": "待って、待って、戻ったの？私は"}, {"type": "subtitle", "time": 12613.67, "timestamp": "03:30:13", "text": "待つべきだろうか？"}, {"type": "subtitle", "time": 12617.19, "timestamp": "03:30:17", "text": "キャンセルするにはどうすればいいですか？はい。見る？うん。"}, {"type": "subtitle", "time": 12621.19, "timestamp": "03:30:21", "text": "はい。見る？うん。逃げる。エスケープキー。"}, {"type": "subtitle", "time": 12623.67, "timestamp": "03:30:23", "text": "ごめん。リスポーン地点を設定しましたか？あなた"}, {"type": "subtitle", "time": 12627.51, "timestamp": "03:30:27", "text": "そうしなかった。ええ、基地でやりましたよ。あなたの"}, {"type": "subtitle", "time": 12630.07, "timestamp": "03:30:30", "text": "ベース？そう思ってたよ。また戻ってきます。"}, {"type": "subtitle", "time": 12632.309, "timestamp": "03:30:32", "text": "つまり、私はあなたの"}, {"type": "subtitle", "time": 12635.11, "timestamp": "03:30:35", "text": "ベース。まるで眠っていたかのように。私は"}, {"type": "subtitle", "time": 12639.11, "timestamp": "03:30:39", "text": "寝ていたが、私は寝なかった。私のリスポーン"}, {"type": "subtitle", "time": 12643.269, "timestamp": "03:30:43", "text": "問題の箇所は私の家にあった。わかった、今行くよ"}, {"type": "subtitle", "time": 12646.71, "timestamp": "03:30:46", "text": "迎えに行きます。私は戻ってきました。私は私は"}, {"type": "subtitle", "time": 12653.11, "timestamp": "03:30:53", "text": "あなたはどのように走りますか？ダブルタップが機能しません。"}, {"type": "subtitle", "time": 12656.79, "timestamp": "03:30:56", "text": "ああ、うまくいってる。わかった。どうやって走ったの？"}, {"type": "subtitle", "time": 12659.349, "timestamp": "03:30:59", "text": "こっちに手を伸ばして？おお、"}]
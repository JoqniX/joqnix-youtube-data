[{"type": "subtitle", "time": 4397.669, "timestamp": "01:13:17", "text": "死ね、死ね、死ね、死ね。"}, {"type": "subtitle", "time": 4400.709, "timestamp": "01:13:20", "text": "なぜ私は黙っているのだろうか？"}, {"type": "subtitle", "time": 4403.03, "timestamp": "01:13:23", "text": "脱落。"}, {"type": "subtitle", "time": 4406.39, "timestamp": "01:13:26", "text": "私は何度も何度も沈黙を守っている。くそ。"}, {"type": "subtitle", "time": 4414.47, "timestamp": "01:13:34", "text": "いいえ。この明白な状況でアートをストリーミング配信できますか？"}, {"type": "subtitle", "time": 4417.83, "timestamp": "01:13:37", "text": "はい、できます。これが"}, {"type": "subtitle", "time": 4431.59, "timestamp": "01:13:51", "text": "私はアサルトライフルをレベルアップさせているので、"}, {"type": "subtitle", "time": 4435.03, "timestamp": "01:13:55", "text": "最大量のアイテムを入手できます。"}]
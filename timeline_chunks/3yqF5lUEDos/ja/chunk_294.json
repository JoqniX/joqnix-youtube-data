[{"type": "subtitle", "time": 17642.31, "timestamp": "04:54:02", "text": "普通の何か"}, {"type": "subtitle", "time": 17645.27, "timestamp": "04:54:05", "text": "魔王のアバターへの戦士は"}, {"type": "subtitle", "time": 17647.43, "timestamp": "04:54:07", "text": "レベル千とか、あるいは"}, {"type": "subtitle", "time": 17650.47, "timestamp": "04:54:10", "text": "そういう強力なものだから、私は言い続ける"}, {"type": "subtitle", "time": 17655.03, "timestamp": "04:54:15", "text": "エイリアスの代わりにアバター、なんてこった"}, {"type": "subtitle", "time": 17657.91, "timestamp": "04:54:17", "text": "ああ、信じられない"}, {"type": "subtitle", "time": 17661.91, "timestamp": "04:54:21", "text": "非常に古いアナウンスチャンネルです"}, {"type": "subtitle", "time": 17664.788, "timestamp": "04:54:24", "text": "7 920 2021。"}, {"type": "subtitle", "time": 17667.43, "timestamp": "04:54:27", "text": "ええ、2年前ですね。ルール一覧と"}, {"type": "subtitle", "time": 17669.19, "timestamp": "04:54:29", "text": "KAの選手向け情報"}, {"type": "subtitle", "time": 17671.43, "timestamp": "04:54:31", "text": "Minecraftサーバー。"}, {"type": "subtitle", "time": 17674.628, "timestamp": "04:54:34", "text": "ああ、他人には優しくしよう。"}, {"type": "subtitle", "time": 17677.27, "timestamp": "04:54:37", "text": "第二に、他の人に聞いてみてはどうですか？"}, {"type": "subtitle", "time": 17679.35, "timestamp": "04:54:39", "text": "これを投稿した人が誰か知らない？"}, {"type": "subtitle", "time": 17685.19, "timestamp": "04:54:45", "text": "何てことだ。好きなものを作ろう、でも"}, {"type": "subtitle", "time": 17687.11, "timestamp": "04:54:47", "text": "他人のビルドを作らないように注意してください"}, {"type": "subtitle", "time": 17689.11, "timestamp": "04:54:49", "text": "近くに何かを作ると悪く見える"}, {"type": "subtitle", "time": 17690.868, "timestamp": "04:54:50", "text": "彼らの体型は彼らの"}, {"type": "subtitle", "time": 17693.43, "timestamp": "04:54:53", "text": "そこの環境に合わせる。"}, {"type": "subtitle", "time": 17695.19, "timestamp": "04:54:55", "text": "何てことだ。そして、必ず"}, {"type": "subtitle", "time": 17697.67, "timestamp": "04:54:57", "text": "建物を建てるのに最適な場所を選びましょう。"}, {"type": "subtitle", "time": 17699.59, "timestamp": "04:54:59", "text": "組み立てる場所の周囲に余裕を持たせてください。"}]
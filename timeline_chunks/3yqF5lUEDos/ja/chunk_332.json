[{"type": "subtitle", "time": 19924.15, "timestamp": "05:32:04", "text": "夢？何てことだ。いいえ。"}, {"type": "subtitle", "time": 19928.23, "timestamp": "05:32:08", "text": "誰かに私の頬をつねってほしい。待って。"}, {"type": "subtitle", "time": 19931.51, "timestamp": "05:32:11", "text": "わかった。これは夢ではない。"}, {"type": "subtitle", "time": 19939.59, "timestamp": "05:32:19", "text": "何てことだ。"}, {"type": "subtitle", "time": 19944.788, "timestamp": "05:32:24", "text": "まあ、いいよ。楽しみにしています。"}, {"type": "subtitle", "time": 19948.628, "timestamp": "05:32:28", "text": "こんにちは。あなたもそろそろ締めくくりですね。こんにちは。"}, {"type": "subtitle", "time": 19950.23, "timestamp": "05:32:30", "text": "何ですか"}, {"type": "subtitle", "time": 19953.27, "timestamp": "05:32:33", "text": "今日？本当に楽しかった。そして、"}, {"type": "subtitle", "time": 19955.83, "timestamp": "05:32:35", "text": "わからない、これが私たちの初めての"}, {"type": "subtitle", "time": 19958.628, "timestamp": "05:32:38", "text": "公式コラボレーションと言えるかもしれませんが、"}, {"type": "subtitle", "time": 19966.07, "timestamp": "05:32:46", "text": "はい。"}, {"type": "subtitle", "time": 19968.948, "timestamp": "05:32:48", "text": "楽しかった。"}, {"type": "subtitle", "time": 19972.31, "timestamp": "05:32:52", "text": "つまり、私はよくあなたと一緒にVCに参加していました。"}, {"type": "subtitle", "time": 19975.03, "timestamp": "05:32:55", "text": "ゲームビジ"}, {"type": "subtitle", "time": 19977.59, "timestamp": "05:32:57", "text": "などなど。うん、あれはぶら下がっているような感じ"}, {"type": "subtitle", "time": 19979.27, "timestamp": "05:32:59", "text": "外。"}]
[{"type": "subtitle", "time": 15181.269, "timestamp": "04:13:01", "text": "ええと、この商品はもう必要ありません。しかし"}, {"type": "subtitle", "time": 15183.269, "timestamp": "04:13:03", "text": "まだ、"}, {"type": "subtitle", "time": 15193.83, "timestamp": "04:13:13", "text": "良い質問ですね。"}, {"type": "subtitle", "time": 15197.99, "timestamp": "04:13:17", "text": "何てことだ。私は本当に空高く昇る"}, {"type": "subtitle", "time": 15205.269, "timestamp": "04:13:25", "text": "上へ行ったの？私はまだ上昇中です。しかし"}, {"type": "subtitle", "time": 15208.149, "timestamp": "04:13:28", "text": "実際にそこに"}, {"type": "subtitle", "time": 15222.149, "timestamp": "04:13:42", "text": "バック。ああ、バケツが取れなかった。"}, {"type": "subtitle", "time": 15230.71, "timestamp": "04:13:50", "text": "それはどこで出現したのですか？ネザー。えーと、"}]
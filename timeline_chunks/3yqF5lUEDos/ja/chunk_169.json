[{"type": "subtitle", "time": 10142.63, "timestamp": "02:49:02", "text": "また？待って、ここから登るの？私"}, {"type": "subtitle", "time": 10145.269, "timestamp": "02:49:05", "text": "わからない。"}, {"type": "subtitle", "time": 10147.75, "timestamp": "02:49:07", "text": "ジャンプしよう。私たちはここから登ります、私は"}, {"type": "subtitle", "time": 10150.15, "timestamp": "02:49:10", "text": "推測。いや、待って。"}, {"type": "subtitle", "time": 10152.309, "timestamp": "02:49:12", "text": "では、どうすればトップに立てるのでしょうか？そうそう。"}, {"type": "subtitle", "time": 10155.19, "timestamp": "02:49:15", "text": "はい、どうぞ。うん。骸骨の撮影"}, {"type": "subtitle", "time": 10157.67, "timestamp": "02:49:17", "text": "私を見て。"}, {"type": "subtitle", "time": 10169.19, "timestamp": "02:49:29", "text": "私たちは木のてっぺんにいる。ええ、私は"}, {"type": "subtitle", "time": 10173.59, "timestamp": "02:49:33", "text": "どこかで骸骨に撃たれる。"}, {"type": "subtitle", "time": 10176.469, "timestamp": "02:49:36", "text": "はぁ？おお、"}, {"type": "subtitle", "time": 10178.15, "timestamp": "02:49:38", "text": "見て。"}, {"type": "subtitle", "time": 10179.83, "timestamp": "02:49:39", "text": "じゃあ、水の中かな。私は持っていません"}, {"type": "subtitle", "time": 10182.309, "timestamp": "02:49:42", "text": "弓。矢を持っていません。ああ、ただ"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "はい、今行きます。"}, {"type": "subtitle", "time": 10191.75, "timestamp": "02:49:51", "text": "ああ、降りてきて。"}, {"type": "subtitle", "time": 10194.389, "timestamp": "02:49:54", "text": "ここでは、"}, {"type": "subtitle", "time": 10196.55, "timestamp": "02:49:56", "text": "する"}]
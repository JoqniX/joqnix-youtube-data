[{"type": "subtitle", "time": 61.028999999999996, "timestamp": "00:01:01", "text": "彼女はOBSで録画することができません。"}, {"type": "subtitle", "time": 64.95, "timestamp": "00:01:04", "text": "なぜあからさまなバカっぽさが魅力なのか？"}, {"type": "subtitle", "time": 79.19, "timestamp": "00:01:19", "text": "ダークが次に登場した新銃だ。私はすべきでしょうか"}, {"type": "subtitle", "time": 87.59, "timestamp": "00:01:27", "text": "私にさせて"}, {"type": "subtitle", "time": 91.59, "timestamp": "00:01:31", "text": "彼女に状況を伝えましょう"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "チャットを一時停止"}, {"type": "subtitle", "time": 96.71000000000001, "timestamp": "00:01:36", "text": "OBSを起動します。"}, {"type": "subtitle", "time": 99.67, "timestamp": "00:01:39", "text": "何かが燃えているような気がする。何"}, {"type": "subtitle", "time": 102.39, "timestamp": "00:01:42", "text": "燃えているのか？"}, {"type": "subtitle", "time": 104.71000000000001, "timestamp": "00:01:44", "text": "何かが燃えている。"}, {"type": "subtitle", "time": 108.789, "timestamp": "00:01:48", "text": "わかった。えっと、彼女は64をやらなきゃいけない。"}, {"type": "subtitle", "time": 111.03, "timestamp": "00:01:51", "text": "であるべき"}, {"type": "subtitle", "time": 112.87, "timestamp": "00:01:52", "text": "6,000。"}, {"type": "subtitle", "time": 116.38900000000001, "timestamp": "00:01:56", "text": "これは"}]
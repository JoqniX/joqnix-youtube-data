[{"type": "subtitle", "time": 7336.95, "timestamp": "02:02:16", "text": "はい、そうです。えっと、今は7時30分です。"}, {"type": "subtitle", "time": 7339.83, "timestamp": "02:02:19", "text": "わかった。それでね、知ってる？"}, {"type": "subtitle", "time": 7342.47, "timestamp": "02:02:22", "text": "私はそうすべきでしょうか？"}, {"type": "subtitle", "time": 7345.91, "timestamp": "02:02:25", "text": "ストリームの代わりに"}, {"type": "subtitle", "time": 7349.51, "timestamp": "02:02:29", "text": "永遠にプレイする代わりに？あるいは、"}, {"type": "subtitle", "time": 7351.75, "timestamp": "02:02:31", "text": "別のゲームに切り替える。いくつか作ってみよう"}, {"type": "subtitle", "time": 7353.99, "timestamp": "02:02:33", "text": "トラブル。はい、別のものに切り替えることができます"}, {"type": "subtitle", "time": 7356.709, "timestamp": "02:02:36", "text": "ゲームか何かできる"}, {"type": "subtitle", "time": 7358.39, "timestamp": "02:02:38", "text": "生産的。わからない。あなたは何を"}, {"type": "subtitle", "time": 7362.07, "timestamp": "02:02:42", "text": "みんなは私が何をすべきだと思う？"}, {"type": "subtitle", "time": 7365.75, "timestamp": "02:02:45", "text": "誰でも"}, {"type": "subtitle", "time": 7369.27, "timestamp": "02:02:49", "text": "もっと良い解決策を知っている人はいますか？"}, {"type": "subtitle", "time": 7373.43, "timestamp": "02:02:53", "text": "私にもできること。というわけで、これで終わりにします。"}, {"type": "subtitle", "time": 7378.87, "timestamp": "02:02:58", "text": "最後に、ストリームを終了します。"}]
[{"type": "subtitle", "time": 7684.47, "timestamp": "02:08:04", "text": "えっと、待って、これはピクセルゲームだよ。"}, {"type": "subtitle", "time": 7688.229, "timestamp": "02:08:08", "text": "ディーパーソード。よし、これをインストールしよう。"}, {"type": "subtitle", "time": 7691.91, "timestamp": "02:08:11", "text": "70メガピクセルです。何？"}, {"type": "subtitle", "time": 7694.55, "timestamp": "02:08:14", "text": "よし、これは面白そうだ。"}, {"type": "subtitle", "time": 7699.589, "timestamp": "02:08:19", "text": "わかった。 70MPPゲーム、ピクセルゲーム。さあ行こう。"}, {"type": "subtitle", "time": 7703.91, "timestamp": "02:08:23", "text": "それについては、配信を行います。"}, {"type": "subtitle", "time": 7705.99, "timestamp": "02:08:25", "text": "さて、皆さんは何か"}, {"type": "subtitle", "time": 7708.629, "timestamp": "02:08:28", "text": "ピクセルゲームのおすすめはありますか？あなたはできる"}, {"type": "subtitle", "time": 7715.51, "timestamp": "02:08:35", "text": "健康を損なうものではない。"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "英雄と将軍たち"}, {"type": "subtitle", "time": 7726.629, "timestamp": "02:08:46", "text": "影響力がある。専門家の意見を遮って議論を続ける。私"}, {"type": "subtitle", "time": 7729.589, "timestamp": "02:08:49", "text": "この試合を見逃した。"}, {"type": "subtitle", "time": 7733.27, "timestamp": "02:08:53", "text": "専門家の意見を遮って議論を続ける。"}, {"type": "subtitle", "time": 7736.79, "timestamp": "02:08:56", "text": "健康は病気です。ええ、見ました"}, {"type": "subtitle", "time": 7739.27, "timestamp": "02:08:59", "text": "それに関する漫画とか。マンガ"}]
[{"type": "subtitle", "time": 7863.51, "timestamp": "02:11:03", "text": "DLCの秘密のストリームを"}, {"type": "subtitle", "time": 7867.109, "timestamp": "02:11:07", "text": "ええと、他に数人。"}, {"type": "subtitle", "time": 7870.229, "timestamp": "02:11:10", "text": "他にはほとんど人がいなかった。"}, {"type": "subtitle", "time": 7872.79, "timestamp": "02:11:12", "text": "これは私がコラボレーションできる方法のようなもの"}, {"type": "subtitle", "time": 7876.39, "timestamp": "02:11:16", "text": "人々。それで、ええと、私ができる方法の1つは、"}, {"type": "subtitle", "time": 7879.35, "timestamp": "02:11:19", "text": "えーと、コラボ。秘密のゲストは知っているのだろうか？"}, {"type": "subtitle", "time": 7882.149, "timestamp": "02:11:22", "text": "いいえ、彼らは知りません。もしかしたら、そうかもしれない。誰が"}, {"type": "subtitle", "time": 7885.99, "timestamp": "02:11:25", "text": "知っている？それは秘密です。 2042年はどうですか？それ"}, {"type": "subtitle", "time": 7888.629, "timestamp": "02:11:28", "text": "良かった。"}, {"type": "subtitle", "time": 7891.91, "timestamp": "02:11:31", "text": "良かったよ。良かったよ。私はたくさんおしっこをした、"}, {"type": "subtitle", "time": 7895.589, "timestamp": "02:11:35", "text": "何度も死んだ。私はたくさんの魂を殺し、"}, {"type": "subtitle", "time": 7897.43, "timestamp": "02:11:37", "text": "人間"}, {"type": "subtitle", "time": 7900.95, "timestamp": "02:11:40", "text": "戦争において。そして私は自分のことを楽しんだ"}, {"type": "subtitle", "time": 7904.31, "timestamp": "02:11:44", "text": "地獄のような道を走り抜ける"}, {"type": "subtitle", "time": 7905.83, "timestamp": "02:11:45", "text": "戦場"}, {"type": "subtitle", "time": 7908.229, "timestamp": "02:11:48", "text": "満たされた"}, {"type": "subtitle", "time": 7913.43, "timestamp": "02:11:53", "text": "血と汗と叫び声"}, {"type": "subtitle", "time": 7917.75, "timestamp": "02:11:57", "text": "轟音とか色々。うん。でも、そうだった"}]
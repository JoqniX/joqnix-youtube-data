[{"type": "subtitle", "time": 16741.109, "timestamp": "04:39:01", "text": "マインクラフトで。たくさんの新しい新バージョン"}, {"type": "subtitle", "time": 16745.67, "timestamp": "04:39:05", "text": "今、出てきた。ああ、120秒だ。"}, {"type": "subtitle", "time": 16749.029, "timestamp": "04:39:09", "text": "ええ、今は1時20分です。あのね？"}, {"type": "subtitle", "time": 16751.99, "timestamp": "04:39:11", "text": "降りていくよ。このダウンの場所は"}, {"type": "subtitle", "time": 16755.83, "timestamp": "04:39:15", "text": "日陰になっているから、その方が良い。"}, {"type": "subtitle", "time": 16757.91, "timestamp": "04:39:17", "text": "うん。ああ、それは陰口じゃないよ。これは水です。"}, {"type": "subtitle", "time": 16760.869, "timestamp": "04:39:20", "text": "おお、"}, {"type": "subtitle", "time": 16763.75, "timestamp": "04:39:23", "text": "これはあなたがAFKする場所です"}, {"type": "subtitle", "time": 16765.99, "timestamp": "04:39:25", "text": "暴徒。"}, {"type": "subtitle", "time": 16767.91, "timestamp": "04:39:27", "text": "ああ、"}, {"type": "subtitle", "time": 16771.029, "timestamp": "04:39:31", "text": "これは、つまり、"}, {"type": "subtitle", "time": 16773.19, "timestamp": "04:39:33", "text": "AFK（離席）していたため、ゲームから追放された。"}, {"type": "subtitle", "time": 16778.23, "timestamp": "04:39:38", "text": "待って、もし"}, {"type": "subtitle", "time": 16782.868, "timestamp": "04:39:42", "text": "あなたはAFK（離席中）です。ええ、順番に。"}, {"type": "subtitle", "time": 16793.43, "timestamp": "04:39:53", "text": "待って、でもそれってどういう仕組みなの？"}, {"type": "subtitle", "time": 16796.948, "timestamp": "04:39:56", "text": "はぁ？追い出されないためにはどうすればいいですか？"}, {"type": "subtitle", "time": 16798.708, "timestamp": "04:39:58", "text": "あなたはそこに立っているのですか？あなたはまだ"}]
[{"type": "subtitle", "time": 14222.55, "timestamp": "03:57:02", "text": "本気ですか？"}, {"type": "subtitle", "time": 14224.71, "timestamp": "03:57:04", "text": "わかった。うん、私は家にいるよ、"}, {"type": "subtitle", "time": 14253.59, "timestamp": "03:57:33", "text": "でも、本当に懐かしい思い出です。"}, {"type": "subtitle", "time": 14259.75, "timestamp": "03:57:39", "text": "ああ、そうだね。待って、待って、待って。私"}, {"type": "subtitle", "time": 14261.67, "timestamp": "03:57:41", "text": "私は思う"}, {"type": "subtitle", "time": 14264.07, "timestamp": "03:57:44", "text": "はぁ？あなたは"}, {"type": "subtitle", "time": 14268.63, "timestamp": "03:57:48", "text": "私はまだそのビデオを持っているのを覚えています。"}, {"type": "subtitle", "time": 14272.389, "timestamp": "03:57:52", "text": "あなたは何をしたいですか？あなたは欲しい"}, {"type": "subtitle", "time": 14276.55, "timestamp": "03:57:56", "text": "それをシュリムに見せるために私に？何？"}, {"type": "subtitle", "time": 14278.71, "timestamp": "03:57:58", "text": "あなたがそれを正しく理解したビデオ"}]
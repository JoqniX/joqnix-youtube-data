[{"type": "subtitle", "time": 5645.43, "timestamp": "01:34:05", "text": "O"}, {"type": "subtitle", "time": 5656.149, "timestamp": "01:34:16", "text": "敵対勢力が我々の1つを攻撃している"}, {"type": "subtitle", "time": 5658.95, "timestamp": "01:34:18", "text": "目的。"}, {"type": "subtitle", "time": 5661.99, "timestamp": "01:34:21", "text": "ああ、なんてことだ、あれを見て。"}, {"type": "subtitle", "time": 5665.59, "timestamp": "01:34:25", "text": "これは実際の戦争だ。私は走り抜けています"}, {"type": "subtitle", "time": 5669.99, "timestamp": "01:34:29", "text": "赤い橋の地獄の底。"}, {"type": "subtitle", "time": 5674.07, "timestamp": "01:34:34", "text": "目にする人全員を殺して"}, {"type": "subtitle", "time": 5677.11, "timestamp": "01:34:37", "text": "私の愛しいミツバチ。"}]
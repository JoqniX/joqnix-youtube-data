[{"type": "subtitle", "time": 19801.43, "timestamp": "05:30:01", "text": "安全ではありません。だから私は純粋に純粋に"}, {"type": "subtitle", "time": 19804.07, "timestamp": "05:30:04", "text": "イソ"}, {"type": "subtitle", "time": 19806.868, "timestamp": "05:30:06", "text": "はい、そうは言いません。"}, {"type": "subtitle", "time": 19809.35, "timestamp": "05:30:09", "text": "切り取られる。"}, {"type": "subtitle", "time": 19812.708, "timestamp": "05:30:12", "text": "ああ、なんてことだ、そしてゲームは意地悪だと言う"}, {"type": "subtitle", "time": 19815.19, "timestamp": "05:30:15", "text": "試したことがないので、よくわかりません。"}, {"type": "subtitle", "time": 19816.948, "timestamp": "05:30:16", "text": "知る。"}, {"type": "subtitle", "time": 19829.1, "timestamp": "05:30:29", "text": "おお、"}, {"type": "subtitle", "time": 19836.788, "timestamp": "05:30:36", "text": "うん。今、仕上げをするかもしれない。こんにちは。こんにちは。あなたの"}, {"type": "subtitle", "time": 19848.708, "timestamp": "05:30:48", "text": "はい。今日は楽しかった。楽しかったですか？"}, {"type": "subtitle", "time": 19852.47, "timestamp": "05:30:52", "text": "うん。久しぶりにマインクラフトをプレイした。"}, {"type": "subtitle", "time": 19856.708, "timestamp": "05:30:56", "text": "はい、私たちはクリスマスを訪れました"}]
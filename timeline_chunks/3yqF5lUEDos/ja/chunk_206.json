[{"type": "subtitle", "time": 12362.55, "timestamp": "03:26:02", "text": "そうそう。ここは私たちが"}, {"type": "subtitle", "time": 12364.389, "timestamp": "03:26:04", "text": "レベルを削り落とした。"}, {"type": "subtitle", "time": 12367.03, "timestamp": "03:26:07", "text": "うん。何てことだ。"}, {"type": "subtitle", "time": 12368.71, "timestamp": "03:26:08", "text": "懐かしさ。"}, {"type": "subtitle", "time": 12371.67, "timestamp": "03:26:11", "text": "ちょっと怖いんだけど、"}, {"type": "subtitle", "time": 12375.19, "timestamp": "03:26:15", "text": "穴が開いているかどうか考えてみてください。"}, {"type": "subtitle", "time": 12382.229, "timestamp": "03:26:22", "text": "おお、"}, {"type": "subtitle", "time": 12384.63, "timestamp": "03:26:24", "text": "この場所が恋しかった。"}, {"type": "subtitle", "time": 12388.229, "timestamp": "03:26:28", "text": "これは楽しい。一発撃て。"}, {"type": "subtitle", "time": 12401.67, "timestamp": "03:26:41", "text": "ここは本屋です。"}, {"type": "subtitle", "time": 12404.07, "timestamp": "03:26:44", "text": "これらは、書籍の執筆に用いるための材料だ。私"}, {"type": "subtitle", "time": 12406.79, "timestamp": "03:26:46", "text": "つまり、弾薬ではなく、"}, {"type": "subtitle", "time": 12411.51, "timestamp": "03:26:51", "text": "ラピス ly。ラピスは弾薬を持っている。"}, {"type": "subtitle", "time": 12414.389, "timestamp": "03:26:54", "text": "フェラントをやりすぎだよ。"}, {"type": "subtitle", "time": 12418.63, "timestamp": "03:26:58", "text": "ええ、ラピスみたいなやつには弾薬があるって言ったんだけど"}]
[{"type": "subtitle", "time": 16383.269, "timestamp": "04:33:03", "text": "アイスバケツチャレンジ。どうやって？いつ？はぁ？"}, {"type": "subtitle", "time": 16396.789, "timestamp": "04:33:16", "text": "他に何か流れているような場所。"}, {"type": "subtitle", "time": 16402.629, "timestamp": "04:33:22", "text": "[拍手]"}, {"type": "subtitle", "time": 16406.14, "timestamp": "04:33:26", "text": "これは実は骨粉農場向けのものです。"}, {"type": "subtitle", "time": 16433.99, "timestamp": "04:33:53", "text": "ようやくスムーズに動くようになった。何てことだ。"}, {"type": "subtitle", "time": 16435.67, "timestamp": "04:33:55", "text": "おお、"}, {"type": "subtitle", "time": 16439.83, "timestamp": "04:33:59", "text": "私の、私の、これはかなり遅れていました"}]
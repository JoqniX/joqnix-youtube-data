[{"type": "subtitle", "time": 18420.31, "timestamp": "05:07:00", "text": "子供たちはまだそこにいる。犬"}, {"type": "subtitle", "time": 18421.75, "timestamp": "05:07:01", "text": "そして"}, {"type": "subtitle", "time": 18425.03, "timestamp": "05:07:05", "text": "猫とみんな牛"}, {"type": "subtitle", "time": 18427.67, "timestamp": "05:07:07", "text": "キノコの牛、みんなそこにいた。ああ、"}, {"type": "subtitle", "time": 18429.43, "timestamp": "05:07:09", "text": "神。"}, {"type": "subtitle", "time": 18431.99, "timestamp": "05:07:11", "text": "うん。それから私たちは"}, {"type": "subtitle", "time": 18434.55, "timestamp": "05:07:14", "text": "私たちはあらゆる場所や物を探検しました"}, {"type": "subtitle", "time": 18437.67, "timestamp": "05:07:17", "text": "それは、私たちが皆探検したものでした"}, {"type": "subtitle", "time": 18441.99, "timestamp": "05:07:21", "text": "えーと、私たちは送別会をしました、そして私たちは"}, {"type": "subtitle", "time": 18444.708, "timestamp": "05:07:24", "text": "ゲームを辞めた。ええ、私たちは"}, {"type": "subtitle", "time": 18448.708, "timestamp": "05:07:28", "text": "いろいろなものを遊んだ後にゲームをする。はい。しかしそれは"}, {"type": "subtitle", "time": 18451.27, "timestamp": "05:07:31", "text": "本当に素晴らしい作品だった。"}, {"type": "subtitle", "time": 18459.35, "timestamp": "05:07:39", "text": "うん。だいたい2時間くらいかかりました。"}, {"type": "subtitle", "time": 18466.31, "timestamp": "05:07:46", "text": "3つ目が見つからなかったのは残念です"}, {"type": "subtitle", "time": 18476.868, "timestamp": "05:07:56", "text": "まあ、楽しい時間だったよ。"}, {"type": "subtitle", "time": 18479.99, "timestamp": "05:07:59", "text": "他に何を言えばいいのか分かりません。ごめん。"}]
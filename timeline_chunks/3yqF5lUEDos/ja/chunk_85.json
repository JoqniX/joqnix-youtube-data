[{"type": "subtitle", "time": 5102.31, "timestamp": "01:25:02", "text": "シーツか洗濯バケツみたいなもの"}, {"type": "subtitle", "time": 5105.35, "timestamp": "01:25:05", "text": "えっと、押し売り機みたいなものの中に。そして私は"}, {"type": "subtitle", "time": 5107.35, "timestamp": "01:25:07", "text": "ベッドシーツを引き出すと、そこに"}, {"type": "subtitle", "time": 5110.07, "timestamp": "01:25:10", "text": "行く。私の眼鏡が落ちてきた。私は"}, {"type": "subtitle", "time": 5113.43, "timestamp": "01:25:13", "text": "「ああ、想像してみて」"}, {"type": "subtitle", "time": 5117.51, "timestamp": "01:25:17", "text": "何てことだ。もし私が眼鏡を手に入れたらどうなるか想像してみて"}, {"type": "subtitle", "time": 5120.55, "timestamp": "01:25:20", "text": "洗濯機で洗った。それは"}, {"type": "subtitle", "time": 5122.47, "timestamp": "01:25:22", "text": "最悪。\""}, {"type": "subtitle", "time": 5125.83, "timestamp": "01:25:25", "text": "うん。こんにちは、ハニー。元気かい？バカ、"}, {"type": "subtitle", "time": 5128.629, "timestamp": "01:25:28", "text": "バカは今日はどうしている？"}, {"type": "subtitle", "time": 5130.79, "timestamp": "01:25:30", "text": "お元気でお過ごしでしょうか。お腹が痛い"}, {"type": "subtitle", "time": 5134.39, "timestamp": "01:25:34", "text": "もっと。私があなたに言ったことを覚えていますか？"}, {"type": "subtitle", "time": 5137.27, "timestamp": "01:25:37", "text": "前回はお腹が痛かったんですよね。"}, {"type": "subtitle", "time": 5140.709, "timestamp": "01:25:40", "text": "リラックス、リラックス、とたくさん唱えてみてください。"}, {"type": "subtitle", "time": 5144.31, "timestamp": "01:25:44", "text": "また、濡れたタオルや温かいものを当ててみてください。"}, {"type": "subtitle", "time": 5147.669, "timestamp": "01:25:47", "text": "タオル。いや、いや、実際は、濡れてて寒い"}, {"type": "subtitle", "time": 5151.59, "timestamp": "01:25:51", "text": "タオル。すすぐだけで"}, {"type": "subtitle", "time": 5153.83, "timestamp": "01:25:53", "text": "タオル"}, {"type": "subtitle", "time": 5155.75, "timestamp": "01:25:55", "text": "普通の水を入れて"}, {"type": "subtitle", "time": 5159.35, "timestamp": "01:25:59", "text": "お腹を胃の上に。"}]
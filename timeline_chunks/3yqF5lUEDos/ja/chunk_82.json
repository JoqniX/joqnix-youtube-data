[{"type": "subtitle", "time": 4928.79, "timestamp": "01:22:08", "text": "人々はただ諦めるだけで、あなたはここにいる"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "いや、ジャック、自分のやるべきことをやらなきゃ。"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "ああ、大変だ。ああ、なんてうるさいんだ。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 4963.27, "timestamp": "01:22:43", "text": "待って、それだ。彼らの防御はあまりにも"}, {"type": "subtitle", "time": 4975.11, "timestamp": "01:22:55", "text": "本当に驚いていますか？"}, {"type": "subtitle", "time": 4978.149, "timestamp": "01:22:58", "text": "私は過信していません。私は安心しています"}]
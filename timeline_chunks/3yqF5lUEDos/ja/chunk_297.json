[{"type": "subtitle", "time": 17822.628, "timestamp": "04:57:02", "text": "照明がとても明るかったので、誰も反応しませんでした"}, {"type": "subtitle", "time": 17832.39, "timestamp": "04:57:12", "text": "ブロックを壊さないでください"}, {"type": "subtitle", "time": 17834.15, "timestamp": "04:57:14", "text": "終わりとネザー次元。人々は"}, {"type": "subtitle", "time": 17836.708, "timestamp": "04:57:16", "text": "落下して落下ダメージで死亡するか、"}, {"type": "subtitle", "time": 17839.11, "timestamp": "04:57:19", "text": "空所。"}, {"type": "subtitle", "time": 17841.99, "timestamp": "04:57:21", "text": "15日。誰かが参加しない場合"}, {"type": "subtitle", "time": 17843.83, "timestamp": "04:57:23", "text": "サーバーは、入手後3週間で"}, {"type": "subtitle", "time": 17845.67, "timestamp": "04:57:25", "text": "サーバー内のMinecraftルールでは、"}, {"type": "subtitle", "time": 17848.07, "timestamp": "04:57:28", "text": "失格となる。また、誰かが"}, {"type": "subtitle", "time": 17850.15, "timestamp": "04:57:30", "text": "1、2回しか参加せず、"}, {"type": "subtitle", "time": 17852.39, "timestamp": "04:57:32", "text": "数ヶ月後に再び参加すれば、"}, {"type": "subtitle", "time": 17854.788, "timestamp": "04:57:34", "text": "失格となる。あなたはそうする必要はありません"}, {"type": "subtitle", "time": 17856.23, "timestamp": "04:57:36", "text": "3回以上プレイした場合は心配してください"}, {"type": "subtitle", "time": 17858.31, "timestamp": "04:57:38", "text": "回。これはプレイヤーアカウントを維持するためです"}, {"type": "subtitle", "time": 17861.75, "timestamp": "04:57:41", "text": "小規模ながら順調に進んでいる。"}, {"type": "subtitle", "time": 17864.07, "timestamp": "04:57:44", "text": "よし、それは良いルールだったが、それでも"}, {"type": "subtitle", "time": 17868.15, "timestamp": "04:57:48", "text": "Minecraftのロールオーナーがたくさんいます。"}, {"type": "subtitle", "time": 17869.75, "timestamp": "04:57:49", "text": "うん。"}, {"type": "subtitle", "time": 17872.47, "timestamp": "04:57:52", "text": "よし、それなら今のところルールはこれで十分だ。"}, {"type": "subtitle", "time": 17874.15, "timestamp": "04:57:54", "text": "サーバーの制限事項を見てみましょう"}, {"type": "subtitle", "time": 17876.788, "timestamp": "04:57:56", "text": "所有者。はい、私の制限事項です。レイ。おお"}]
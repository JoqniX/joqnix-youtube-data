[{"type": "subtitle", "time": 12540.79, "timestamp": "03:29:00", "text": "もしあなたが配信していたなら。そう、フェスティバルね。"}, {"type": "subtitle", "time": 12543.03, "timestamp": "03:29:03", "text": "あなたはヴァレラントで何者ですか？私はランキング外です。"}, {"type": "subtitle", "time": 12546.87, "timestamp": "03:29:06", "text": "D 私はランク外です。私はランク戦はプレイしません"}, {"type": "subtitle", "time": 12551.269, "timestamp": "03:29:11", "text": "あなたのような。そして私はランキング外です。そしてそれは"}, {"type": "subtitle", "time": 12554.309, "timestamp": "03:29:14", "text": "うん。怖い。"}, {"type": "subtitle", "time": 12557.59, "timestamp": "03:29:17", "text": "ビデオ、つまりノイズそのものは"}, {"type": "subtitle", "time": 12559.349, "timestamp": "03:29:19", "text": "素晴らしい"}, {"type": "subtitle", "time": 12560.87, "timestamp": "03:29:20", "text": "まるで長い間プレイしていないみたいだ"}, {"type": "subtitle", "time": 12563.19, "timestamp": "03:29:23", "text": "また、エンダーマンも見ています"}, {"type": "subtitle", "time": 12566.71, "timestamp": "03:29:26", "text": "彼らの声もノイズです"}, {"type": "subtitle", "time": 12569.19, "timestamp": "03:29:29", "text": "あるいは何であれ、そうだ"}, {"type": "subtitle", "time": 12573.349, "timestamp": "03:29:33", "text": "ホラー映画は得意ですか？"}, {"type": "subtitle", "time": 12576.309, "timestamp": "03:29:36", "text": "ホラーが得意ですか？"}, {"type": "subtitle", "time": 12581.03, "timestamp": "03:29:41", "text": "ホラーホラーとは、"}, {"type": "subtitle", "time": 12582.95, "timestamp": "03:29:42", "text": "同じ"}, {"type": "subtitle", "time": 12585.75, "timestamp": "03:29:45", "text": "男。ついに、私には"}, {"type": "subtitle", "time": 12592.07, "timestamp": "03:29:52", "text": "私もホラー映画は苦手です。"}, {"type": "subtitle", "time": 12595.19, "timestamp": "03:29:55", "text": "なるほど。つまり、私は正気を失いかけたんです。"}, {"type": "subtitle", "time": 12598.15, "timestamp": "03:29:58", "text": "DDLCでもそうだ。"}]
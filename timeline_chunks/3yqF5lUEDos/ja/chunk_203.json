[{"type": "subtitle", "time": 12181.83, "timestamp": "03:23:01", "text": "うん。あ、待てよ、灰色の箱があるぞ。だれの"}, {"type": "subtitle", "time": 12202.15, "timestamp": "03:23:22", "text": "何てことだ。"}, {"type": "subtitle", "time": 12207.91, "timestamp": "03:23:27", "text": "結局何かできたかな？"}, {"type": "subtitle", "time": 12210.63, "timestamp": "03:23:30", "text": "終着点？"}, {"type": "subtitle", "time": 12214.79, "timestamp": "03:23:34", "text": "つまり、私たちはエンダーマンファームを作ったんです。"}, {"type": "subtitle", "time": 12216.87, "timestamp": "03:23:36", "text": "ああ、そうしましょうか？私たちはそこを訪れます。したい"}, {"type": "subtitle", "time": 12220.389, "timestamp": "03:23:40", "text": "一度訪れて、また戻ってきますか？さて、私たちがここにいるので"}, {"type": "subtitle", "time": 12223.99, "timestamp": "03:23:43", "text": "私は、"}, {"type": "subtitle", "time": 12227.91, "timestamp": "03:23:47", "text": "空が、ほら、空が"}, {"type": "subtitle", "time": 12232.389, "timestamp": "03:23:52", "text": "怖いし、ここはすごく暗い。"}]
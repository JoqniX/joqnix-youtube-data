[{"type": "subtitle", "time": 17164.16, "timestamp": "04:46:04", "text": "それは2020年か2021年のいつのことだった？忘れた。 えっと、2020年は3つか4つくらいかな。"}, {"type": "subtitle", "time": 17168.08, "timestamp": "04:46:08", "text": "えっと、2020年は3つか4つくらいかな。 うん。ああ、そうそうそう。"}, {"type": "subtitle", "time": 17178.868, "timestamp": "04:46:18", "text": "嬉しいし、誇りに思います。"}, {"type": "subtitle", "time": 17182.07, "timestamp": "04:46:22", "text": "お会いできて嬉しいです。"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "同じ。"}, {"type": "subtitle", "time": 17185.67, "timestamp": "04:46:25", "text": "うん。"}, {"type": "subtitle", "time": 17189.72, "timestamp": "04:46:29", "text": "私たちはたくさんの思い出を共有しています。 A"}, {"type": "subtitle", "time": 17198.35, "timestamp": "04:46:38", "text": "こんにちは。"}, {"type": "subtitle", "time": 17199.59, "timestamp": "04:46:39", "text": "[音楽]"}, {"type": "subtitle", "time": 17207.43, "timestamp": "04:46:47", "text": "待って、削除するの？"}, {"type": "subtitle", "time": 17210.868, "timestamp": "04:46:50", "text": "マルチプレイヤーから？ああ、わかりました。えっと"}, {"type": "subtitle", "time": 17213.75, "timestamp": "04:46:53", "text": "私はこのバージョンではプレイしないので、"}, {"type": "subtitle", "time": 17215.27, "timestamp": "04:46:55", "text": "「わからない」と書きます。私はただ続けるだけです"}, {"type": "subtitle", "time": 17219.43, "timestamp": "04:46:59", "text": "そうだと思う。もし私が戻ったら"}]
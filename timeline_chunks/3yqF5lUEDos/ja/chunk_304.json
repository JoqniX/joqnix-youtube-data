[{"type": "subtitle", "time": 18248.948, "timestamp": "05:04:08", "text": "そしてそれらはブラウザに埋め込まれています"}, {"type": "subtitle", "time": 18252.31, "timestamp": "05:04:12", "text": "彼ら自身のプロジェクトだったんです。」だから、そうなんです、人々は"}, {"type": "subtitle", "time": 18254.55, "timestamp": "05:04:14", "text": "行くのは素晴らしい方法だ"}, {"type": "subtitle", "time": 18258.23, "timestamp": "05:04:18", "text": "プロモーション。うん、"}, {"type": "subtitle", "time": 18260.47, "timestamp": "05:04:20", "text": "ある日、Google Chromeに"}, {"type": "subtitle", "time": 18264.39, "timestamp": "05:04:24", "text": "VTubaやMicrosoft Edgeには"}, {"type": "subtitle", "time": 18267.27, "timestamp": "05:04:27", "text": "ヴバ。彼らは文字通りオペラをやるだろう"}, {"type": "subtitle", "time": 18269.51, "timestamp": "05:04:29", "text": "GXはそうした。"}, {"type": "subtitle", "time": 18272.23, "timestamp": "05:04:32", "text": "うん。"}, {"type": "subtitle", "time": 18288.07, "timestamp": "05:04:48", "text": "でも、本当に良かった。"}, {"type": "subtitle", "time": 18292.15, "timestamp": "05:04:52", "text": "そうですね、配信の前に、"}, {"type": "subtitle", "time": 18294.55, "timestamp": "05:04:54", "text": "エマが私を引き止め、そしてこうなった"}]
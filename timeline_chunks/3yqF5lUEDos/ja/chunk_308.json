[{"type": "subtitle", "time": 18484.15, "timestamp": "05:08:04", "text": "私はまだエマのしたことに苦しんでいる"}, {"type": "subtitle", "time": 18487.91, "timestamp": "05:08:07", "text": "私にとって。なんてこった。そしてそれは「はい」でした。いくつかの"}, {"type": "subtitle", "time": 18494.47, "timestamp": "05:08:14", "text": "うん。"}, {"type": "subtitle", "time": 18532.628, "timestamp": "05:08:52", "text": "いいえ、メモとか取っておくことではありません。待って。"}, {"type": "subtitle", "time": 18534.47, "timestamp": "05:08:54", "text": "それで、"}]
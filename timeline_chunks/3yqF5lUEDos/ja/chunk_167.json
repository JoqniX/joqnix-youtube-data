[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "これはうまくいっていますか？はい、1つの車輪は"}, {"type": "subtitle", "time": 10022.87, "timestamp": "02:47:02", "text": "正常に動作しています。"}, {"type": "subtitle", "time": 10025.67, "timestamp": "02:47:05", "text": "彼らから車輪を一つ盗むつもりだ。これ"}, {"type": "subtitle", "time": 10028.09, "timestamp": "02:47:08", "text": "もの。おお、"}, {"type": "subtitle", "time": 10030.07, "timestamp": "02:47:10", "text": "[音楽]"}, {"type": "subtitle", "time": 10032.469, "timestamp": "02:47:12", "text": "そうじゃない。下のほうにあるやつです。そこには"}, {"type": "subtitle", "time": 10036.309, "timestamp": "02:47:16", "text": "骨製の車輪は自動式だが、動作が遅い。うん。"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "おお。"}, {"type": "subtitle", "time": 10042.15, "timestamp": "02:47:22", "text": "あなたは私の得意分野に長けていますか？あまり。私"}, {"type": "subtitle", "time": 10044.63, "timestamp": "02:47:24", "text": "何十年もプレイしていない。"}, {"type": "subtitle", "time": 10048.07, "timestamp": "02:47:28", "text": "同じ。うん、まあ、悪くはなかったよ。これは"}, {"type": "subtitle", "time": 10053.75, "timestamp": "02:47:33", "text": "クリエルソンの時だと思う。ええ、そうですね。うん。"}, {"type": "subtitle", "time": 10057.67, "timestamp": "02:47:37", "text": "M邸。うん。これ"}, {"type": "subtitle", "time": 10060.469, "timestamp": "02:47:40", "text": "何てことだ。一度彼と会ったことがあるけど、"}, {"type": "subtitle", "time": 10063.269, "timestamp": "02:47:43", "text": "彼を困らせたい。ええ、そうですね。"}, {"type": "subtitle", "time": 10071.59, "timestamp": "02:47:51", "text": "これはとても"}, {"type": "subtitle", "time": 10073.429, "timestamp": "02:47:53", "text": "また。わかった。それは何と呼ばれますか？それ"}, {"type": "subtitle", "time": 10077.83, "timestamp": "02:47:57", "text": "発症しない。何てことだ。正午。"}]
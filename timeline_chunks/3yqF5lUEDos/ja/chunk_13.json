[{"type": "subtitle", "time": 811.75, "timestamp": "00:13:31", "text": "まさかそんなことするなんて、坊や。あなた"}, {"type": "subtitle", "time": 814.87, "timestamp": "00:13:34", "text": "子供。ああ、なんてことだ。"}, {"type": "subtitle", "time": 816.87, "timestamp": "00:13:36", "text": "殺されたよ。"}, {"type": "subtitle", "time": 819.19, "timestamp": "00:13:39", "text": "ウェイン、"}, {"type": "subtitle", "time": 822.15, "timestamp": "00:13:42", "text": "戦闘状態でこちらに来られますか？お願いします"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "死ぬな。死なないでください。お願いします"}, {"type": "subtitle", "time": 829.03, "timestamp": "00:13:49", "text": "死ぬな。我々の戦術は"}, {"type": "subtitle", "time": 832.31, "timestamp": "00:13:52", "text": "彼らの。勝利は我々のものだ。"}]
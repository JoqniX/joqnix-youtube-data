[{"type": "subtitle", "time": 19200.15, "timestamp": "05:20:00", "text": "いいえ、彼女はたいてい忙しいんです。だから私は"}, {"type": "subtitle", "time": 19211.91, "timestamp": "05:20:11", "text": "ジョークを言って"}, {"type": "subtitle", "time": 19216.708, "timestamp": "05:20:16", "text": "待って。まあ、ほとんどの場合は"}, {"type": "subtitle", "time": 19221.99, "timestamp": "05:20:21", "text": "えっと、オンコールだし、そうだね"}, {"type": "subtitle", "time": 19224.23, "timestamp": "05:20:24", "text": "常に痛み"}, {"type": "subtitle", "time": 19227.03, "timestamp": "05:20:27", "text": "日本語で話してください。だから私は英語を混ぜて"}, {"type": "subtitle", "time": 19229.67, "timestamp": "05:20:29", "text": "そして日本語も一緒に。"}, {"type": "subtitle", "time": 19232.628, "timestamp": "05:20:32", "text": "こんにちは。知らない単語があるときはいつでも、"}, {"type": "subtitle", "time": 19235.43, "timestamp": "05:20:35", "text": "英語で言ってみて、もし彼女が"}, {"type": "subtitle", "time": 19242.39, "timestamp": "05:20:42", "text": "私はいつも翻訳ツール、Googleを使っています"}, {"type": "subtitle", "time": 19244.708, "timestamp": "05:20:44", "text": "翻訳者。しかし、私はそれが"}, {"type": "subtitle", "time": 19246.788, "timestamp": "05:20:46", "text": "良くない。"}, {"type": "subtitle", "time": 19249.27, "timestamp": "05:20:49", "text": "えっと、Google翻訳って、それじゃないの？"}, {"type": "subtitle", "time": 19252.23, "timestamp": "05:20:52", "text": "良い。それに翻訳もバカげてる"}, {"type": "subtitle", "time": 19253.91, "timestamp": "05:20:53", "text": "バカ。"}]
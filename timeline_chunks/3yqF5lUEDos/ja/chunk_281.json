[{"type": "subtitle", "time": 16873.51, "timestamp": "04:41:13", "text": "[音楽]"}, {"type": "subtitle", "time": 16875.11, "timestamp": "04:41:15", "text": "箱の中には何か入っていますか？おお、"}, {"type": "subtitle", "time": 16876.948, "timestamp": "04:41:16", "text": "鎧"}, {"type": "subtitle", "time": 16881.75, "timestamp": "04:41:21", "text": "メリングクリスタルを押し付ける。おお、"}, {"type": "subtitle", "time": 16884.79, "timestamp": "04:41:24", "text": "また、このレバーはフォーク状になっています。"}, {"type": "subtitle", "time": 16892.39, "timestamp": "04:41:32", "text": "さようなら。"}, {"type": "subtitle", "time": 16897.67, "timestamp": "04:41:37", "text": "[音楽]"}, {"type": "subtitle", "time": 16900.708, "timestamp": "04:41:40", "text": "フラッシュ。"}, {"type": "subtitle", "time": 16908.31, "timestamp": "04:41:48", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 16910.67, "timestamp": "04:41:50", "text": "よし、ここで終わりにしよう。"}, {"type": "subtitle", "time": 16913.43, "timestamp": "04:41:53", "text": "[音楽]"}, {"type": "subtitle", "time": 16916.948, "timestamp": "04:41:56", "text": "私たちは二度とここには来ません。"}]
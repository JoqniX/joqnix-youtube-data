[{"type": "subtitle", "time": 1260.24, "timestamp": "00:21:00", "text": "私を殺さないで。子供、子供、子供、子供。 チル。チル。チル。子供たち。"}, {"type": "subtitle", "time": 1268.789, "timestamp": "00:21:08", "text": "これを使ったストリーミングはテストしていません"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "1つ。ええ、試してみてください。大丈夫です。"}, {"type": "subtitle", "time": 1275.909, "timestamp": "00:21:15", "text": "単にアンリスト配信をすればいい。ただ"}, {"type": "subtitle", "time": 1278.31, "timestamp": "00:21:18", "text": "アンリストストリーム"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "あるいは、そんな感じ。"}, {"type": "subtitle", "time": 1289.35, "timestamp": "00:21:29", "text": "まだ早い段階ですが"}, {"type": "subtitle", "time": 1319.669, "timestamp": "00:21:59", "text": "後で。私"}]
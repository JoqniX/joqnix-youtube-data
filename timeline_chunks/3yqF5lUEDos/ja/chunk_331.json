[{"type": "subtitle", "time": 19860.39, "timestamp": "05:31:00", "text": "それで、いいえ、1箇所見逃しました"}, {"type": "subtitle", "time": 19863.03, "timestamp": "05:31:03", "text": "3つ目のえーと、でもそれ以外は"}, {"type": "subtitle", "time": 19865.27, "timestamp": "05:31:05", "text": "私たちはほとんどあらゆることを探求する。"}, {"type": "subtitle", "time": 19869.67, "timestamp": "05:31:09", "text": "右。そうそう。うん。とても楽しかった"}, {"type": "subtitle", "time": 19873.67, "timestamp": "05:31:13", "text": "サーバーを最後にもう一度確認する"}, {"type": "subtitle", "time": 19877.43, "timestamp": "05:31:17", "text": "そして最後に別れを告げる。うん。"}, {"type": "subtitle", "time": 19880.47, "timestamp": "05:31:20", "text": "でも、フェスティバルのやつも見たいな"}, {"type": "subtitle", "time": 19903.99, "timestamp": "05:31:43", "text": "お願いします。私はそのマッシュで遊びたい。私"}, {"type": "subtitle", "time": 19907.99, "timestamp": "05:31:47", "text": "彼女とは一緒に遊べないことは分かっている。お願いします。"}, {"type": "subtitle", "time": 19910.23, "timestamp": "05:31:50", "text": "何てことだ。さあ行こう。さあ行こう。ああ、"}, {"type": "subtitle", "time": 19913.27, "timestamp": "05:31:53", "text": "神。さあ行こう。"}, {"type": "subtitle", "time": 19914.948, "timestamp": "05:31:54", "text": "うん。"}, {"type": "subtitle", "time": 19919.91, "timestamp": "05:31:59", "text": "参加する。何てことだ。さあ行こう。これは"}]
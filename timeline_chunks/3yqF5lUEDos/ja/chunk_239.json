[{"type": "subtitle", "time": 14341.429, "timestamp": "03:59:01", "text": "ハニー"}, {"type": "subtitle", "time": 14345.189, "timestamp": "03:59:05", "text": "胸を攻撃するハニー。"}, {"type": "subtitle", "time": 14351.67, "timestamp": "03:59:11", "text": "おお、"}, {"type": "subtitle", "time": 14355.429, "timestamp": "03:59:15", "text": "わかった。何もありません。"}, {"type": "subtitle", "time": 14360.309, "timestamp": "03:59:20", "text": "誰かが私を盗んだ。はぁ？盗んだんだ。あなた"}, {"type": "subtitle", "time": 14362.87, "timestamp": "03:59:22", "text": "忘れた。多分"}, {"type": "subtitle", "time": 14365.67, "timestamp": "03:59:25", "text": "そうだった。これです。それは後半にあります"}, {"type": "subtitle", "time": 14377.429, "timestamp": "03:59:37", "text": "保存したはずのvaudeが見つかりません。私"}, {"type": "subtitle", "time": 14385.31, "timestamp": "03:59:45", "text": "いいね。"}, {"type": "subtitle", "time": 14386.79, "timestamp": "03:59:46", "text": "[音楽]"}, {"type": "subtitle", "time": 14389.189, "timestamp": "03:59:49", "text": "それでは、動画リンクをお送りします。"}, {"type": "subtitle", "time": 14391.349, "timestamp": "03:59:51", "text": "不和。"}, {"type": "subtitle", "time": 14394.229, "timestamp": "03:59:54", "text": "共有できます。うん。うん、見せてあげるよ"}, {"type": "subtitle", "time": 14395.99, "timestamp": "03:59:55", "text": "後で。心配ない。"}, {"type": "subtitle", "time": 14399.59, "timestamp": "03:59:59", "text": "はい、こちらへ向かいます。"}]
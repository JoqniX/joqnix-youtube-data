[{"type": "subtitle", "time": 20341.19, "timestamp": "05:39:01", "text": "そして私は「え、どうして？」と思った。はぁ？待って、"}, {"type": "subtitle", "time": 20344.47, "timestamp": "05:39:04", "text": "何？どうやって？"}, {"type": "subtitle", "time": 20346.548, "timestamp": "05:39:06", "text": "それは本当に驚きでした。でも、そうですね"}, {"type": "subtitle", "time": 20349.91, "timestamp": "05:39:09", "text": "彼も一緒にいてくれて本当に楽しかった。"}, {"type": "subtitle", "time": 20352.628, "timestamp": "05:39:12", "text": "ミカマが来てくれてありがとう"}, {"type": "subtitle", "time": 20355.59, "timestamp": "05:39:15", "text": "チャマが今日来たよ。来てくれてありがとう、チャマ。"}, {"type": "subtitle", "time": 20357.59, "timestamp": "05:39:17", "text": "今日。"}, {"type": "subtitle", "time": 20360.788, "timestamp": "05:39:20", "text": "今日を楽しんでください。そしてコスモエクシがやって来た。"}, {"type": "subtitle", "time": 20363.51, "timestamp": "05:39:23", "text": "今日は来てくれてありがとう、アラタ・コスモ。希望"}, {"type": "subtitle", "time": 20366.39, "timestamp": "05:39:26", "text": "あなたは今日それを楽しんでいます。頑張ってください"}, {"type": "subtitle", "time": 20369.27, "timestamp": "05:39:29", "text": "残りの一日をお楽しみください。それからルフィチャマ"}, {"type": "subtitle", "time": 20372.948, "timestamp": "05:39:32", "text": "今日立ち寄りました。ルフィ、来てくれてありがとう。希望"}, {"type": "subtitle", "time": 20375.59, "timestamp": "05:39:35", "text": "あなたは今日それを楽しんでいます。ありがとう。うん。"}, {"type": "subtitle", "time": 20379.19, "timestamp": "05:39:39", "text": "今日はカコさんが来てくれました。カコサ"}, {"type": "subtitle", "time": 20381.99, "timestamp": "05:39:41", "text": "友人が昨日ヴァレラントにいました"}, {"type": "subtitle", "time": 20383.59, "timestamp": "05:39:43", "text": "ストリーム。"}, {"type": "subtitle", "time": 20386.47, "timestamp": "05:39:46", "text": "うん。カコさん、お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 20390.628, "timestamp": "05:39:50", "text": "また。それから今日はニシャ・ニシャーンがやって来ました。"}, {"type": "subtitle", "time": 20396.39, "timestamp": "05:39:56", "text": "ニシャーンはこのチャンネルの新しい視聴者です。"}]
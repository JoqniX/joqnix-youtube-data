[{"type": "subtitle", "time": 14641.11, "timestamp": "04:04:01", "text": "そしてロバ。そして、砂もある。"}, {"type": "subtitle", "time": 14645.429, "timestamp": "04:04:05", "text": "砂の城もここにありました。"}, {"type": "subtitle", "time": 14647.349, "timestamp": "04:04:07", "text": "砂の城。"}, {"type": "subtitle", "time": 14663.429, "timestamp": "04:04:23", "text": "ああ、ジョン。あの時のことを覚えていますか？"}, {"type": "subtitle", "time": 14665.51, "timestamp": "04:04:25", "text": "私たちは"}, {"type": "subtitle", "time": 14668.55, "timestamp": "04:04:28", "text": "クリエイティブモードを探求中？うん。のように"}, {"type": "subtitle", "time": 14670.71, "timestamp": "04:04:30", "text": "私たちは長い間サバイバルモードでスタートしました"}, {"type": "subtitle", "time": 14673.67, "timestamp": "04:04:33", "text": "時間があって、それからクリエイティブモードに入ったとき"}, {"type": "subtitle", "time": 14684.95, "timestamp": "04:04:44", "text": "ええ、ただ探検しているだけです。"}, {"type": "subtitle", "time": 14693.189, "timestamp": "04:04:53", "text": "君のところにテレポートしようか。"}, {"type": "subtitle", "time": 14695.269, "timestamp": "04:04:55", "text": "うん、うん、うん。"}, {"type": "subtitle", "time": 14697.03, "timestamp": "04:04:57", "text": "待って、いや、それは必要ないよ。私は"}]
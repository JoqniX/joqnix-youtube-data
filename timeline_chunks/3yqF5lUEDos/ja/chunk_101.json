[{"type": "subtitle", "time": 6060.47, "timestamp": "01:41:00", "text": "ああ。"}, {"type": "subtitle", "time": 6065.669, "timestamp": "01:41:05", "text": "神。友軍がデルタを制圧している"}, {"type": "subtitle", "time": 6068.39, "timestamp": "01:41:08", "text": "1."}, {"type": "subtitle", "time": 6072.39, "timestamp": "01:41:12", "text": "痛み。私はこれを乗り越える。私はします"}, {"type": "subtitle", "time": 6075.669, "timestamp": "01:41:15", "text": "これを乗り越えろ。"}, {"type": "subtitle", "time": 6087.109, "timestamp": "01:41:27", "text": "彼らはチャーリー地区を占領した。"}, {"type": "subtitle", "time": 6088.87, "timestamp": "01:41:28", "text": "我々が止めなければ、彼らは"}, {"type": "subtitle", "time": 6107.27, "timestamp": "01:41:47", "text": "デルタ1は我々の支配下にある。"}, {"type": "subtitle", "time": 6115.99, "timestamp": "01:41:55", "text": "ああ、なんてことだ、怖かったよ。"}]
[{"type": "subtitle", "time": 13742.79, "timestamp": "03:49:02", "text": "ああ、あの羊牧場ね。うん。ええ、そうです"}, {"type": "subtitle", "time": 13745.91, "timestamp": "03:49:05", "text": "久しぶりですね。覚えているよ。の"}, {"type": "subtitle", "time": 13748.55, "timestamp": "03:49:08", "text": "色とりどりの羊を飼育する牧場。つまり、これらはすべて"}, {"type": "subtitle", "time": 13753.03, "timestamp": "03:49:13", "text": "ゲームで羊に使える色は？"}, {"type": "subtitle", "time": 13755.11, "timestamp": "03:49:15", "text": "もっと色があると思うけど、うん、"}, {"type": "subtitle", "time": 13759.83, "timestamp": "03:49:19", "text": "私はそれらを持っています。よくあるもの。ああ、神様。"}, {"type": "subtitle", "time": 13762.15, "timestamp": "03:49:22", "text": "もう一度色を付けるとしたら、どう表現すればいいでしょうか？"}, {"type": "subtitle", "time": 13764.95, "timestamp": "03:49:24", "text": "染料を入れたのはあなたですよね？"}, {"type": "subtitle", "time": 13766.469, "timestamp": "03:49:26", "text": "うん。"}, {"type": "subtitle", "time": 13769.51, "timestamp": "03:49:29", "text": "染料をかけて、それらを繁殖させるんだ。"}, {"type": "subtitle", "time": 13773.269, "timestamp": "03:49:33", "text": "とか、そんな感じ。うんうん。彼らを"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 13785.269, "timestamp": "03:49:45", "text": "お元気でお過ごしでしょうか。住宅検査と"}, {"type": "subtitle", "time": 13787.03, "timestamp": "03:49:47", "text": "もの。"}, {"type": "subtitle", "time": 13794.95, "timestamp": "03:49:54", "text": "はい、"}, {"type": "subtitle", "time": 13798.04, "timestamp": "03:49:58", "text": "それはとても"}]
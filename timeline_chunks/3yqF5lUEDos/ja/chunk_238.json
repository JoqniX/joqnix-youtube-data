[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "初めてハンマーを振る。スーツ。"}, {"type": "subtitle", "time": 14284.71, "timestamp": "03:58:04", "text": "ああ、わかりました。その前に、もう1つ"}, {"type": "subtitle", "time": 14307.67, "timestamp": "03:58:27", "text": "この長い道は存在しない"}, {"type": "subtitle", "time": 14309.59, "timestamp": "03:58:29", "text": "何もない。"}, {"type": "subtitle", "time": 14311.99, "timestamp": "03:58:31", "text": "ああ、そうだね。はい。剣。剣。はい。"}, {"type": "subtitle", "time": 14333.91, "timestamp": "03:58:53", "text": "何か作りましたか？"}, {"type": "subtitle", "time": 14336.87, "timestamp": "03:58:56", "text": "わかった。ここに来て。こちらへ上がってきてください。そこには"}, {"type": "subtitle", "time": 14339.189, "timestamp": "03:58:59", "text": "ここに秘密がある。"}]
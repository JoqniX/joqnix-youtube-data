[{"type": "subtitle", "time": 17342.788, "timestamp": "04:49:02", "text": "まるで彼が彼女と会話をしていたかのように"}, {"type": "subtitle", "time": 17345.83, "timestamp": "04:49:05", "text": "それで彼らはそう決めたんだ"}, {"type": "subtitle", "time": 17349.75, "timestamp": "04:49:09", "text": "私たちのチームを去った人々。"}, {"type": "subtitle", "time": 17353.35, "timestamp": "04:49:13", "text": "うん。単に「うん」というだけではない。もし彼らが"}, {"type": "subtitle", "time": 17354.948, "timestamp": "04:49:14", "text": "プロジェクトから離れても大丈夫だよ。しかし"}, {"type": "subtitle", "time": 17360.07, "timestamp": "04:49:20", "text": "左側のアーロンがアップデートを気に入っている場合、"}, {"type": "subtitle", "time": 17361.59, "timestamp": "04:49:21", "text": "後続のアップデートは"}, {"type": "subtitle", "time": 17365.35, "timestamp": "04:49:25", "text": "彼らにとって機密事項である。はぁ。"}, {"type": "subtitle", "time": 17367.89, "timestamp": "04:49:27", "text": "うん。"}, {"type": "subtitle", "time": 17369.35, "timestamp": "04:49:29", "text": "[音楽]"}, {"type": "subtitle", "time": 17372.788, "timestamp": "04:49:32", "text": "でも、私は"}, {"type": "subtitle", "time": 17375.27, "timestamp": "04:49:35", "text": "変な話なんだけど。ああ、コイヴ"}, {"type": "subtitle", "time": 17377.67, "timestamp": "04:49:37", "text": "彼らが作っていたテーマ。そうそう。の"}, {"type": "subtitle", "time": 17380.15, "timestamp": "04:49:40", "text": "ライトみたいなもの。うん。うん。うん。何"}, {"type": "subtitle", "time": 17381.67, "timestamp": "04:49:41", "text": "それに何が起こったのですか？"}, {"type": "subtitle", "time": 17384.47, "timestamp": "04:49:44", "text": "彼らは90%で止まっただけだと思う"}, {"type": "subtitle", "time": 17386.47, "timestamp": "04:49:46", "text": "進捗。"}, {"type": "subtitle", "time": 17388.07, "timestamp": "04:49:48", "text": "ああ、"}, {"type": "subtitle", "time": 17390.15, "timestamp": "04:49:50", "text": "そして彼らは奇妙なことをしようとさえした"}, {"type": "subtitle", "time": 17396.55, "timestamp": "04:49:56", "text": "本当のこと、奇妙なこと、奇妙なこと。"}, {"type": "subtitle", "time": 17399.43, "timestamp": "04:49:59", "text": "ああ、バーチャルリアリティ。"}]
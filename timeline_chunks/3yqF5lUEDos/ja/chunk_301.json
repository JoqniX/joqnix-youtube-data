[{"type": "subtitle", "time": 18064.628, "timestamp": "05:01:04", "text": "ええ、関係ありません。"}, {"type": "subtitle", "time": 18066.47, "timestamp": "05:01:06", "text": "活動停止。"}, {"type": "subtitle", "time": 18068.39, "timestamp": "05:01:08", "text": "クリスのスタッフの活動のなさ"}, {"type": "subtitle", "time": 18070.31, "timestamp": "05:01:10", "text": "サーバーはファンベースに変更されます。"}, {"type": "subtitle", "time": 18072.07, "timestamp": "05:01:12", "text": "クリスの公式発表と作品"}, {"type": "subtitle", "time": 18074.39, "timestamp": "05:01:14", "text": "依然として、依然として遠ざかるだろう"}, {"type": "subtitle", "time": 18076.23, "timestamp": "05:01:16", "text": "このサーバーと別々のチャネルで。"}, {"type": "subtitle", "time": 18077.67, "timestamp": "05:01:17", "text": "サーバーテナントは"}, {"type": "subtitle", "time": 18079.19, "timestamp": "05:01:19", "text": "再建された。"}, {"type": "subtitle", "time": 18081.83, "timestamp": "05:01:21", "text": "うん。管理者と監視担当者に通知しました。いくつかの"}, {"type": "subtitle", "time": 18084.15, "timestamp": "05:01:24", "text": "ロールは削除されます。私たちはそうしないだろう"}, {"type": "subtitle", "time": 18086.948, "timestamp": "05:01:26", "text": "それぞれの役割を担っているメンバーを把握しておく。だから私たちは"}, {"type": "subtitle", "time": 18118.788, "timestamp": "05:01:58", "text": "そうそう。原神をプレイしましたか？"}]
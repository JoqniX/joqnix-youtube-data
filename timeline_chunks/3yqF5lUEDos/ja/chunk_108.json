[{"type": "subtitle", "time": 6483.81, "timestamp": "01:48:03", "text": "私は"}, {"type": "subtitle", "time": 6487.109, "timestamp": "01:48:07", "text": "[音楽]"}, {"type": "subtitle", "time": 6490.31, "timestamp": "01:48:10", "text": "廃棄された。何？廃棄された。何？おお、"}, {"type": "subtitle", "time": 6493.83, "timestamp": "01:48:13", "text": "待って。それはインドにある。待て、ここはインドだ。"}, {"type": "subtitle", "time": 6497.43, "timestamp": "01:48:17", "text": "え、何？待って、この地図はインドのものだ。"}, {"type": "subtitle", "time": 6500.229, "timestamp": "01:48:20", "text": "一体どういうことだ？何？"}, {"type": "subtitle", "time": 6502.08, "timestamp": "01:48:22", "text": "何？ これは何の中にあるのですか？"}, {"type": "subtitle", "time": 6505.36, "timestamp": "01:48:25", "text": "これは何の中にあるのですか？ 何？それらの目標を守れ。何でも"}, {"type": "subtitle", "time": 6507.92, "timestamp": "01:48:27", "text": "何？それらの目標を守れ。何でも かかる。このセクターを失うと、"}, {"type": "subtitle", "time": 6510.32, "timestamp": "01:48:30", "text": "かかる。このセクターを失うと、 まだ後退しているが、我々は減速しなければならない"}, {"type": "subtitle", "time": 6512.32, "timestamp": "01:48:32", "text": "まだ後退しているが、我々は減速しなければならない 敵軍。何？"}, {"type": "subtitle", "time": 6515.199, "timestamp": "01:48:35", "text": "敵軍。何？ この地図はインドのものです。何？"}, {"type": "subtitle", "time": 6519.04, "timestamp": "01:48:39", "text": "この地図はインドのものです。何？ 正直に言うと、これはちょっと"}, {"type": "subtitle", "time": 6520.96, "timestamp": "01:48:40", "text": "正直に言うと、これはちょっと インド人。"}, {"type": "subtitle", "time": 6534.79, "timestamp": "01:48:54", "text": "ええ、この地図はインドと呼ばれています。から"}, {"type": "subtitle", "time": 6539.75, "timestamp": "01:48:59", "text": "インド。アグラ。インド。"}]
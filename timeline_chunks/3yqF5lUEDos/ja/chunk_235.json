[{"type": "subtitle", "time": 14102.389, "timestamp": "03:55:02", "text": "そう、まるで溺れているみたい"}, {"type": "subtitle", "time": 14104.63, "timestamp": "03:55:04", "text": "そして、もうできないことを思い出す"}, {"type": "subtitle", "time": 14115.67, "timestamp": "03:55:15", "text": "マンションの電力問題もまだ残っています。"}, {"type": "subtitle", "time": 14117.269, "timestamp": "03:55:17", "text": "しましょうか？"}, {"type": "subtitle", "time": 14125.189, "timestamp": "03:55:25", "text": "ああ、彼は亡くなった。ニース。"}, {"type": "subtitle", "time": 14143.83, "timestamp": "03:55:43", "text": "ニース。ある時点で"}, {"type": "subtitle", "time": 14147.269, "timestamp": "03:55:47", "text": "あなたはネオちゃんを憎んでいて、ネオを殺した"}, {"type": "subtitle", "time": 14152.229, "timestamp": "03:55:52", "text": "チャン。覚えていますか？そう思う"}, {"type": "subtitle", "time": 14154.229, "timestamp": "03:55:54", "text": "明確には言えない。"}, {"type": "subtitle", "time": 14158.15, "timestamp": "03:55:58", "text": "何てことだ。うん。毎回私は"}, {"type": "subtitle", "time": 14159.83, "timestamp": "03:55:59", "text": "見て"}]
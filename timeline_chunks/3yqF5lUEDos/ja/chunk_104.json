[{"type": "subtitle", "time": 6253.03, "timestamp": "01:44:13", "text": "私はワシの絵柄のものを手に入れました。"}, {"type": "subtitle", "time": 6266.149, "timestamp": "01:44:26", "text": "それならイーグルワンを買うよ。"}, {"type": "subtitle", "time": 6268.629, "timestamp": "01:44:28", "text": "何てことだ。"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "大丈夫。イーグルに行かなければならない。イーグル"}]
[{"type": "subtitle", "time": 13620.469, "timestamp": "03:47:00", "text": "ウィンドウを全画面表示に変更してください。"}, {"type": "subtitle", "time": 13625.429, "timestamp": "03:47:05", "text": "そのため、ゲームを調整する必要があります。"}, {"type": "subtitle", "time": 13627.99, "timestamp": "03:47:07", "text": "もしそれがそういうことなら"}, {"type": "subtitle", "time": 13630.309, "timestamp": "03:47:10", "text": "またはゲーム内で変更してから"}, {"type": "subtitle", "time": 13632.71, "timestamp": "03:47:12", "text": "設定ファイル。"}, {"type": "subtitle", "time": 13635.59, "timestamp": "03:47:15", "text": "はい。わかった。設定ファイル。"}, {"type": "subtitle", "time": 13638.71, "timestamp": "03:47:18", "text": "設定ファイル。ああ、Apexのやつね。おお"}, {"type": "subtitle", "time": 13640.87, "timestamp": "03:47:20", "text": "うん。試着はしなかったの？どうでしたか？"}, {"type": "subtitle", "time": 13644.15, "timestamp": "03:47:24", "text": "それ？私はできませんでした。"}, {"type": "subtitle", "time": 13647.429, "timestamp": "03:47:27", "text": "墜落した。私は"}, {"type": "subtitle", "time": 13649.189, "timestamp": "03:47:29", "text": "いいえ、"}, {"type": "subtitle", "time": 13652.95, "timestamp": "03:47:32", "text": "でもすぐにプレイできるようになります。私は幸せです"}, {"type": "subtitle", "time": 13660.389, "timestamp": "03:47:40", "text": "うん。すごく興奮してる。私はゲームをすることができます"}, {"type": "subtitle", "time": 13662.229, "timestamp": "03:47:42", "text": "あなたと。"}, {"type": "subtitle", "time": 13664.389, "timestamp": "03:47:44", "text": "ついに。"}, {"type": "subtitle", "time": 13667.349, "timestamp": "03:47:47", "text": "何てことだ。私はとても幸せです"}, {"type": "subtitle", "time": 13669.349, "timestamp": "03:47:49", "text": "それ。"}]
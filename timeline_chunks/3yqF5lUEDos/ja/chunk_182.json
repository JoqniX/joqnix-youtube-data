[{"type": "subtitle", "time": 10926.71, "timestamp": "03:02:06", "text": "待って、カーペットは全部大丈夫だったの？"}, {"type": "subtitle", "time": 10929.75, "timestamp": "03:02:09", "text": "はい、カーペットは全部揃っていますね。"}, {"type": "subtitle", "time": 10933.99, "timestamp": "03:02:13", "text": "ブロック。"}, {"type": "subtitle", "time": 10938.79, "timestamp": "03:02:18", "text": "全部渡しましたか？はい。"}, {"type": "subtitle", "time": 10941.429, "timestamp": "03:02:21", "text": "私には必要ない。"}, {"type": "subtitle", "time": 10943.67, "timestamp": "03:02:23", "text": "ありがとう。"}, {"type": "subtitle", "time": 10947.349, "timestamp": "03:02:27", "text": "えっと、木材に交換した方がいいでしょうか？ H."}, {"type": "subtitle", "time": 10949.67, "timestamp": "03:02:29", "text": "それで、"}, {"type": "subtitle", "time": 10954.469, "timestamp": "03:02:34", "text": "誰も知らないだろう。私たちはそれをやり直した。"}, {"type": "subtitle", "time": 10961.269, "timestamp": "03:02:41", "text": "わかった。クラフト機能すらありません"}, {"type": "subtitle", "time": 10963.67, "timestamp": "03:02:43", "text": "ここに表があります。なぜ彼らはこれを作ったのか"}, {"type": "subtitle", "time": 10967.67, "timestamp": "03:02:47", "text": "役に立たない客室？いいえ、クラフトは終了しました"}, {"type": "subtitle", "time": 10969.51, "timestamp": "03:02:49", "text": "ここ。"}, {"type": "subtitle", "time": 10976.55, "timestamp": "03:02:56", "text": "作業現場。"}]
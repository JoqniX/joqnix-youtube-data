[{"type": "subtitle", "time": 10985.269, "timestamp": "03:03:05", "text": "呪術が欲しい。殺してはいけない。わかった、"}, {"type": "subtitle", "time": 10987.51, "timestamp": "03:03:07", "text": "どうでも。あ、待って。あなたのビデオ"}, {"type": "subtitle", "time": 10990.23, "timestamp": "03:03:10", "text": "再生埋め込みは無効になっています。だから私は"}, {"type": "subtitle", "time": 10994.63, "timestamp": "03:03:14", "text": "見えないよ、見えないよ。あ、待って。"}, {"type": "subtitle", "time": 10999.03, "timestamp": "03:03:19", "text": "私の休暇中。はい、あなたの埋め込みは"}, {"type": "subtitle", "time": 11001.03, "timestamp": "03:03:21", "text": "見る。"}, {"type": "subtitle", "time": 11004.79, "timestamp": "03:03:24", "text": "そう、それが痛みなんだ。私はしません"}, {"type": "subtitle", "time": 11010.79, "timestamp": "03:03:30", "text": "ここ。"}, {"type": "subtitle", "time": 11025.51, "timestamp": "03:03:45", "text": "[音楽]"}, {"type": "subtitle", "time": 11028.79, "timestamp": "03:03:48", "text": "はい、気にしないでください。こんにちは。ゆっくりしてください。"}, {"type": "subtitle", "time": 11032.95, "timestamp": "03:03:52", "text": "私たちの願いを知ってください。私の両親は"}, {"type": "subtitle", "time": 11035.269, "timestamp": "03:03:55", "text": "私の両親は二人とも"}, {"type": "subtitle", "time": 11037.75, "timestamp": "03:03:57", "text": "来て、しばらく私の隣に座った"}]
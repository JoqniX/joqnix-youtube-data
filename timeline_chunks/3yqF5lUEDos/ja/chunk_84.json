[{"type": "subtitle", "time": 5042.55, "timestamp": "01:24:02", "text": "それは見られさえしなかった。 「待って、"}, {"type": "subtitle", "time": 5048.229, "timestamp": "01:24:08", "text": "え、何だって？あれはどこにあるの？"}, {"type": "subtitle", "time": 5053.59, "timestamp": "01:24:13", "text": "私はすごく心配していたんだけど、どうなったと思う？"}, {"type": "subtitle", "time": 5056.709, "timestamp": "01:24:16", "text": "そして私は見て見て"}, {"type": "subtitle", "time": 5060.79, "timestamp": "01:24:20", "text": "探していたら、ついに見つけた。それはああ、"}, {"type": "subtitle", "time": 5083.669, "timestamp": "01:24:43", "text": "右。そして私は30を探さなければならなかった"}, {"type": "subtitle", "time": 5086.39, "timestamp": "01:24:46", "text": "分。私は自分の"}, {"type": "subtitle", "time": 5089.83, "timestamp": "01:24:49", "text": "眼鏡なしでランチ。だから私は"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "あらゆる場所を探している。見つけることができませんでした。"}, {"type": "subtitle", "time": 5096.07, "timestamp": "01:24:56", "text": "私は泣き出してしまった。私は心配だった。それから私は"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "ふむ、ベッドをチェックしてみよう"}]
[{"type": "subtitle", "time": 11160.469, "timestamp": "03:06:00", "text": "あ、でもスコップは持ってるよ。感謝しない限り"}, {"type": "subtitle", "time": 11163.429, "timestamp": "03:06:03", "text": "斧のために。"}, {"type": "subtitle", "time": 11182.23, "timestamp": "03:06:22", "text": "[音楽]"}, {"type": "subtitle", "time": 11184.79, "timestamp": "03:06:24", "text": "なんてこった。"}, {"type": "subtitle", "time": 11193.269, "timestamp": "03:06:33", "text": "よし、じゃあ本部へ向かおう。"}, {"type": "subtitle", "time": 11212.15, "timestamp": "03:06:52", "text": "あれはカメです。待って、あれはカメ？"}, {"type": "subtitle", "time": 11214.95, "timestamp": "03:06:54", "text": "あれはカメです。はい。"}, {"type": "subtitle", "time": 11217.03, "timestamp": "03:06:57", "text": "待って、この装置は何？"}]
[{"type": "subtitle", "time": 15783.11, "timestamp": "04:23:03", "text": "そうそう。だって、ほら、私は"}, {"type": "subtitle", "time": 15785.59, "timestamp": "04:23:05", "text": "別のサーバーで実行されています。"}, {"type": "subtitle", "time": 15787.349, "timestamp": "04:23:07", "text": "ああ、もしかしたらそれが理由かもしれないね。うん。うん。"}, {"type": "subtitle", "time": 15799.91, "timestamp": "04:23:19", "text": "さあ、見てごらん。"}, {"type": "subtitle", "time": 15802.63, "timestamp": "04:23:22", "text": "私たちは戻るのですか？もちろん。うん、行けるよ"}, {"type": "subtitle", "time": 15805.349, "timestamp": "04:23:25", "text": "戻る。"}, {"type": "subtitle", "time": 15807.11, "timestamp": "04:23:27", "text": "入り口はどこでしたっけ？洞窟"}, {"type": "subtitle", "time": 15816.95, "timestamp": "04:23:36", "text": "私が見るのは、私が"}, {"type": "subtitle", "time": 15823.75, "timestamp": "04:23:43", "text": "ああ、ここは君が盗んだ村だ。おお"}, {"type": "subtitle", "time": 15826.79, "timestamp": "04:23:46", "text": "我が神よ。待って、"}, {"type": "subtitle", "time": 15839.189, "timestamp": "04:23:59", "text": "猫が開けさせてくれない、待って、"}]
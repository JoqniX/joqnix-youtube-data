[{"type": "subtitle", "time": 14593.67, "timestamp": "04:03:13", "text": "これはとても長い"}, {"type": "subtitle", "time": 14596.389, "timestamp": "04:03:16", "text": "なぜこんなに時間がかかってしまったのか、もう一度考えてみよう。私はしません"}, {"type": "subtitle", "time": 14602.309, "timestamp": "04:03:22", "text": "ああ、あなたはここにいたんですね。"}, {"type": "subtitle", "time": 14603.83, "timestamp": "04:03:23", "text": "うん、"}, {"type": "subtitle", "time": 14605.349, "timestamp": "04:03:25", "text": "それは"}, {"type": "subtitle", "time": 14608.309, "timestamp": "04:03:28", "text": "はい。おお、"}, {"type": "subtitle", "time": 14610.389, "timestamp": "04:03:30", "text": "ここが私がキノコを手に入れた場所です"}, {"type": "subtitle", "time": 14612.309, "timestamp": "04:03:32", "text": "あれ。"}, {"type": "subtitle", "time": 14616.71, "timestamp": "04:03:36", "text": "いいえ、海全体です。こんにちは。わかりました。私たちは"}, {"type": "subtitle", "time": 14621.349, "timestamp": "04:03:41", "text": "ここにいた時のことを覚えてるよね？はい、これは"}, {"type": "subtitle", "time": 14628.95, "timestamp": "04:03:48", "text": "私たちはここに建てたのです。"}, {"type": "subtitle", "time": 14631.75, "timestamp": "04:03:51", "text": "私たちはなぜここにいたのか？忘れた。"}, {"type": "subtitle", "time": 14634.55, "timestamp": "04:03:54", "text": "私も、もしかしたら馬が2頭いたのかもしれない"}, {"type": "subtitle", "time": 14636.87, "timestamp": "04:03:56", "text": "家を手に入れるためだろうね。良い馬たちだ。"}, {"type": "subtitle", "time": 14638.389, "timestamp": "04:03:58", "text": "うん。"}]
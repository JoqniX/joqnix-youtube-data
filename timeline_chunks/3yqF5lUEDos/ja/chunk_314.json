[{"type": "subtitle", "time": 18843.59, "timestamp": "05:14:03", "text": "アニメを見過ぎてるんだよね？"}, {"type": "subtitle", "time": 18845.91, "timestamp": "05:14:05", "text": "だって、アニメをたくさん見ると、"}, {"type": "subtitle", "time": 18848.628, "timestamp": "05:14:08", "text": "そう、キャラクターや"}, {"type": "subtitle", "time": 18852.15, "timestamp": "05:14:12", "text": "その人は日本語でこう言っています。"}, {"type": "subtitle", "time": 18854.23, "timestamp": "05:14:14", "text": "右？そして、もしそれが他の何かだったら"}, {"type": "subtitle", "time": 18859.99, "timestamp": "05:14:19", "text": "しかし、もしそれが何か別のものなら"}, {"type": "subtitle", "time": 18863.27, "timestamp": "05:14:23", "text": "言語の権利には媒体がありません"}, {"type": "subtitle", "time": 18865.91, "timestamp": "05:14:25", "text": "メディアのようなもの、例えばメディアのようなもの"}, {"type": "subtitle", "time": 18868.39, "timestamp": "05:14:28", "text": "あなたはあまり観戦に関わっていません"}, {"type": "subtitle", "time": 18872.868, "timestamp": "05:14:32", "text": "例えば、私は、人々は"}, {"type": "subtitle", "time": 18874.868, "timestamp": "05:14:34", "text": "今はK-POPとかにハマってると思う"}, {"type": "subtitle", "time": 18877.51, "timestamp": "05:14:37", "text": "彼らはK-POPをたくさん見て聴いている"}, {"type": "subtitle", "time": 18880.788, "timestamp": "05:14:40", "text": "歌を歌うので、ある意味彼らは韓国語が得意です"}, {"type": "subtitle", "time": 18884.788, "timestamp": "05:14:44", "text": "もう既にそういう感じなんだろうね。"}, {"type": "subtitle", "time": 18887.51, "timestamp": "05:14:47", "text": "でも私は中国語を見ようとしている"}, {"type": "subtitle", "time": 18889.67, "timestamp": "05:14:49", "text": "ビリー・ブリッシュのフレームのように、"}, {"type": "subtitle", "time": 18891.99, "timestamp": "05:14:51", "text": "すべて。私はまだ理解していない"}, {"type": "subtitle", "time": 18898.39, "timestamp": "05:14:58", "text": "私は中国語に合わせて歌ってみました"}]
[{"type": "subtitle", "time": 8700.79, "timestamp": "02:25:00", "text": "私は著作権で保護された音楽を聴いています。私はできる"}, {"type": "subtitle", "time": 8703.99, "timestamp": "02:25:03", "text": "ちょっとだけお聴きください。"}, {"type": "subtitle", "time": 8712.87, "timestamp": "02:25:12", "text": "えっと、ちょっと待って"}, {"type": "subtitle", "time": 8717.67, "timestamp": "02:25:17", "text": "私はこれを聴いています"}, {"type": "subtitle", "time": 8727.429, "timestamp": "02:25:27", "text": "ああ、そう、私はルナと気楽に過ごしているだけだよ"}, {"type": "subtitle", "time": 8735.27, "timestamp": "02:25:35", "text": "だから、私は自分の"}, {"type": "subtitle", "time": 8737.75, "timestamp": "02:25:37", "text": "実際、いろいろあります。だから、私はストリーミングを続けるかもしれない"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "Xは実際にはこの後です。だから、私は"}, {"type": "subtitle", "time": 8744.87, "timestamp": "02:25:44", "text": "創造的な自分に戻る。そう、もし"}, {"type": "subtitle", "time": 8747.51, "timestamp": "02:25:47", "text": "Xで配信中なので、そちらでお会いしましょう。"}, {"type": "subtitle", "time": 8749.11, "timestamp": "02:25:49", "text": "今日。"}, {"type": "subtitle", "time": 8752.07, "timestamp": "02:25:52", "text": "こんにちは、元気ですか？そして明日は日曜日です"}, {"type": "subtitle", "time": 8756.63, "timestamp": "02:25:56", "text": "ああ、じゃあ私は、えーと、"}, {"type": "subtitle", "time": 8759.99, "timestamp": "02:25:59", "text": "運転教習。ああ、痛い。"}]
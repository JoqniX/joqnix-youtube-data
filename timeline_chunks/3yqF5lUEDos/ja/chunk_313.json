[{"type": "subtitle", "time": 18786.868, "timestamp": "05:13:06", "text": "おお。えっと、"}, {"type": "subtitle", "time": 18788.948, "timestamp": "05:13:08", "text": "他に希望する言語はありますか？"}, {"type": "subtitle", "time": 18791.91, "timestamp": "05:13:11", "text": "日本語以外の言語を学ぶ？私は持っている"}, {"type": "subtitle", "time": 18794.788, "timestamp": "05:13:14", "text": "少しベトナム風に興味があるが、"}, {"type": "subtitle", "time": 18798.39, "timestamp": "05:13:18", "text": "難しいですね。ベトナム風？そうそう。私"}, {"type": "subtitle", "time": 18800.15, "timestamp": "05:13:20", "text": "つまり、私にはベトナム出身の友達が何人かいるんです。"}, {"type": "subtitle", "time": 18808.55, "timestamp": "05:13:28", "text": "のように"}, {"type": "subtitle", "time": 18811.19, "timestamp": "05:13:31", "text": "インドネシア人よりもベトナム人の友人が多い"}, {"type": "subtitle", "time": 18813.91, "timestamp": "05:13:33", "text": "友達。インドネシアの友人のように、"}, {"type": "subtitle", "time": 18815.51, "timestamp": "05:13:35", "text": "インドネシア人は世界中にいます、"}, {"type": "subtitle", "time": 18817.59, "timestamp": "05:13:37", "text": "知る。"}, {"type": "subtitle", "time": 18819.91, "timestamp": "05:13:39", "text": "ええ、何人か知っていますよ。そして今日は"}, {"type": "subtitle", "time": 18822.868, "timestamp": "05:13:42", "text": "インドネシア出身の新規視聴者。の"}, {"type": "subtitle", "time": 18826.07, "timestamp": "05:13:46", "text": "名前はミーシャだった。ニシャ。私は見たと思います"}, {"type": "subtitle", "time": 18837.27, "timestamp": "05:13:57", "text": "私は中国語を学びたいです。わからない"}, {"type": "subtitle", "time": 18839.75, "timestamp": "05:13:59", "text": "どうやって。主に理由は"}]
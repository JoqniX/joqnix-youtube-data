[{"type": "subtitle", "time": 11520.87, "timestamp": "03:12:00", "text": "サーバーは私に開くように言っている"}, {"type": "subtitle", "time": 11525.67, "timestamp": "03:12:05", "text": "サーバーと、はい。うん。あの頃は。"}, {"type": "subtitle", "time": 11527.75, "timestamp": "03:12:07", "text": "わかった。うん。サティサン。私たちは"}, {"type": "subtitle", "time": 11529.75, "timestamp": "03:12:09", "text": "サティサン。うん。サティサン。うん。うん。それ"}, {"type": "subtitle", "time": 11531.91, "timestamp": "03:12:11", "text": "それがその名前だった。私は「えっと、あれは彼女だ」って思った。"}, {"type": "subtitle", "time": 11536.15, "timestamp": "03:12:16", "text": "家。サティサン。うん。あれが彼女の家です"}, {"type": "subtitle", "time": 11539.349, "timestamp": "03:12:19", "text": "そこには。今でもあの日のことを覚えている"}, {"type": "subtitle", "time": 11542.79, "timestamp": "03:12:22", "text": "彼女と初めて一緒に過ごしました。"}, {"type": "subtitle", "time": 11544.87, "timestamp": "03:12:24", "text": "うん。そのような"}, {"type": "subtitle", "time": 11547.75, "timestamp": "03:12:27", "text": "彼女の家を見てみて。その"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "彼女はまだかなり駆け出しの新人だ。"}, {"type": "subtitle", "time": 11555.75, "timestamp": "03:12:35", "text": "彼女をずっと待っていたと思う"}, {"type": "subtitle", "time": 11567.349, "timestamp": "03:12:47", "text": "おお。そうそう。私は慣れてきたことを覚えている"}, {"type": "subtitle", "time": 11569.67, "timestamp": "03:12:49", "text": "彼女を利用する。これを見てください。また、"}, {"type": "subtitle", "time": 11572.71, "timestamp": "03:12:52", "text": "私の工房ではなく、こちらの工房を使います。"}, {"type": "subtitle", "time": 11576.15, "timestamp": "03:12:56", "text": "そうそう。うん。彼女はこの本を作った"}]
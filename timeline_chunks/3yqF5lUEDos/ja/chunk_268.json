[{"type": "subtitle", "time": 16111.51, "timestamp": "04:28:31", "text": "何を見ているんですか？"}, {"type": "subtitle", "time": 16115.51, "timestamp": "04:28:35", "text": "私はただ何もしていないだけです。"}, {"type": "subtitle", "time": 16117.83, "timestamp": "04:28:37", "text": "なぜドローンがカメと一緒にいるのですか？"}, {"type": "subtitle", "time": 16120.469, "timestamp": "04:28:40", "text": "君たちは友達なの？"}, {"type": "subtitle", "time": 16125.429, "timestamp": "04:28:45", "text": "お二人の姿を見てみました。ここに来て。"}, {"type": "subtitle", "time": 16131.59, "timestamp": "04:28:51", "text": "フォローしています。"}, {"type": "subtitle", "time": 16134.63, "timestamp": "04:28:54", "text": "ああ、こっちです。ああ、これだ。おお、"}, {"type": "subtitle", "time": 16137.51, "timestamp": "04:28:57", "text": "うん。そう、それが秘密。"}]
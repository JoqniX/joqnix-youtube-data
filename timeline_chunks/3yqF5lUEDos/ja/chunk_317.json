[{"type": "subtitle", "time": 19026.948, "timestamp": "05:17:06", "text": "男。純粋にそう"}, {"type": "subtitle", "time": 19029.35, "timestamp": "05:17:09", "text": "そう言ったことを撤回しないで。 Uはありませんし、"}, {"type": "subtitle", "time": 19032.39, "timestamp": "05:17:12", "text": "そう言ってください。そう言ってください。"}, {"type": "subtitle", "time": 19036.31, "timestamp": "05:17:16", "text": "おかえりなさい。いらっしゃいませ。いらっしゃいませ。こんにちは。"}, {"type": "subtitle", "time": 19039.83, "timestamp": "05:17:19", "text": "待って。他に適切な言葉はありますか？男、"}, {"type": "subtitle", "time": 19047.43, "timestamp": "05:17:27", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 19050.628, "timestamp": "05:17:30", "text": "そうそう。グラフィックカードを購入する前に"}, {"type": "subtitle", "time": 19053.19, "timestamp": "05:17:33", "text": "来月、どのゲームをプレイしますか？"}, {"type": "subtitle", "time": 19057.03, "timestamp": "05:17:37", "text": "プレイするのが楽しみですか？叙事詩。"}, {"type": "subtitle", "time": 19071.27, "timestamp": "05:17:51", "text": "ハンガイの質問です。うん。"}, {"type": "subtitle", "time": 19073.67, "timestamp": "05:17:53", "text": "H."}, {"type": "subtitle", "time": 19075.67, "timestamp": "05:17:55", "text": "うん。五。"}]
[{"type": "subtitle", "time": 11461.19, "timestamp": "03:11:01", "text": "ジョニー、君のチューバだよ。悲しいことに、私は"}, {"type": "subtitle", "time": 11463.67, "timestamp": "03:11:03", "text": "できた。ああ、でも私はその日まで待つよ"}, {"type": "subtitle", "time": 11466.309, "timestamp": "03:11:06", "text": "もう一度プレイしよう。あなたは最高だった"}, {"type": "subtitle", "time": 11468.07, "timestamp": "03:11:08", "text": "ベースメイト。"}, {"type": "subtitle", "time": 11471.349, "timestamp": "03:11:11", "text": "パカンクス。何てことだ。頑張ってください"}, {"type": "subtitle", "time": 11473.429, "timestamp": "03:11:13", "text": "旅。誕生日おめでとうございます。知っている。それ"}, {"type": "subtitle", "time": 11476.23, "timestamp": "03:11:16", "text": "きっと素敵になるでしょう。後はかなりきれいになるでしょう"}, {"type": "subtitle", "time": 11479.75, "timestamp": "03:11:19", "text": "あなたがこれを読む頃には、誕生日を迎えているでしょう。"}, {"type": "subtitle", "time": 11482.23, "timestamp": "03:11:22", "text": "実際は私の誕生日の後なんです。ああ、"}, {"type": "subtitle", "time": 11485.429, "timestamp": "03:11:25", "text": "神。うん、"}, {"type": "subtitle", "time": 11493.75, "timestamp": "03:11:33", "text": "そして彼女は鉄のブーツを飾り付け、作った。"}, {"type": "subtitle", "time": 11501.99, "timestamp": "03:11:41", "text": "何てことだ。それは本当に手に入れるのが難しいです。"}, {"type": "subtitle", "time": 11506.87, "timestamp": "03:11:46", "text": "あなたが知っている。ええ、彼女は剣を見つけました。"}, {"type": "subtitle", "time": 11510.309, "timestamp": "03:11:50", "text": "それで、えっと、私は"}, {"type": "subtitle", "time": 11513.349, "timestamp": "03:11:53", "text": "黒い方が鍵だったのを覚えている。それで"}, {"type": "subtitle", "time": 11516.469, "timestamp": "03:11:56", "text": "もしかしたら逆かもしれない。わからない。"}, {"type": "subtitle", "time": 11518.63, "timestamp": "03:11:58", "text": "彼女はよく遊んでいたのを覚えている"}]
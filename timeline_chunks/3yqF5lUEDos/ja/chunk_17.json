[{"type": "subtitle", "time": 1021.43, "timestamp": "00:17:01", "text": "さあ行こう"}, {"type": "subtitle", "time": 1023.67, "timestamp": "00:17:03", "text": "以上。"}, {"type": "subtitle", "time": 1026.47, "timestamp": "00:17:06", "text": "奴らを追い詰めてやる。ガンダムダウン"}, {"type": "subtitle", "time": 1029.11, "timestamp": "00:17:09", "text": "そこには。ピューピューピューニャスをやるよ"}, {"type": "subtitle", "time": 1032.39, "timestamp": "00:17:12", "text": "彼らをこの地図から排除せよ。試合に行くよ。"}, {"type": "subtitle", "time": 1033.99, "timestamp": "00:17:13", "text": "ああ、そうそう、これは"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "12時までの持久力。ええ、私は"}, {"type": "subtitle", "time": 1039.51, "timestamp": "00:17:19", "text": "ストリームは"}, {"type": "subtitle", "time": 1041.59, "timestamp": "00:17:21", "text": "持久力が必要だ、だって私はこれが好きなんだもの"}, {"type": "subtitle", "time": 1044.87, "timestamp": "00:17:24", "text": "ゲーム。戦争で銃を撃ちまくりたい。あなた"}, {"type": "subtitle", "time": 1048.23, "timestamp": "00:17:28", "text": "現代の実際の戦争では、"}, {"type": "subtitle", "time": 1052.07, "timestamp": "00:17:32", "text": "3～4日かかるんですよね？で"}, {"type": "subtitle", "time": 1055.27, "timestamp": "00:17:35", "text": "実際の戦争。"}, {"type": "subtitle", "time": 1058.39, "timestamp": "00:17:38", "text": "ええ、そうですね、ここにいます。それで"}, {"type": "subtitle", "time": 1061.83, "timestamp": "00:17:41", "text": "気軽に立ち寄って私に会いに来てください。わかった、"}, {"type": "subtitle", "time": 1064.39, "timestamp": "00:17:44", "text": "そして挨拶をしましょう。"}, {"type": "subtitle", "time": 1066.39, "timestamp": "00:17:46", "text": "そうするよ。でも行かなきゃいけないんだ。またね。"}, {"type": "subtitle", "time": 1069.75, "timestamp": "00:17:49", "text": "しばらくしたら。そしてメタク。"}, {"type": "subtitle", "time": 1074.31, "timestamp": "00:17:54", "text": "はい、とてもそうです。あの曲は本当に良いですね"}]
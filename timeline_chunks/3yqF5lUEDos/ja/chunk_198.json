[{"type": "subtitle", "time": 11883.59, "timestamp": "03:18:03", "text": "懐かしさ。"}, {"type": "subtitle", "time": 11886.55, "timestamp": "03:18:06", "text": "ああ、私はエリトラを持っていません。"}, {"type": "subtitle", "time": 11889.349, "timestamp": "03:18:09", "text": "わかりました。海底神殿を覚えていますか？"}, {"type": "subtitle", "time": 11891.11, "timestamp": "03:18:11", "text": "クリアした？"}, {"type": "subtitle", "time": 11893.349, "timestamp": "03:18:13", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 11896.07, "timestamp": "03:18:16", "text": "私はすべての持ち物を失くしたことを覚えています"}, {"type": "subtitle", "time": 11900.469, "timestamp": "03:18:20", "text": "こちらのエレクトラでさえも。何てことだ。"}, {"type": "subtitle", "time": 11902.79, "timestamp": "03:18:22", "text": "私は溶岩の中で死んだ。"}, {"type": "subtitle", "time": 11910.389, "timestamp": "03:18:30", "text": "それはとても"}, {"type": "subtitle", "time": 11919.91, "timestamp": "03:18:39", "text": "うん。そしてエレクトラは私のfだった、あなたの"}, {"type": "subtitle", "time": 11924.229, "timestamp": "03:18:44", "text": "私にとって初めての贈り物だと思う。いいえ、OPのように"}, {"type": "subtitle", "time": 11926.71, "timestamp": "03:18:46", "text": "贈り物"}, {"type": "subtitle", "time": 11931.349, "timestamp": "03:18:51", "text": "だって、あなたがくれたものが好きだから"}, {"type": "subtitle", "time": 11934.95, "timestamp": "03:18:54", "text": "ロケットをたくさん飛ばす。ほとんどの場合そうです。私"}, {"type": "subtitle", "time": 11937.19, "timestamp": "03:18:57", "text": "つまり、私は勝った"}, {"type": "subtitle", "time": 11939.75, "timestamp": "03:18:59", "text": "ええ、エンダーを倒しましたよ。うん、エンダー"}]
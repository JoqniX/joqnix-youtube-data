[{"type": "subtitle", "time": 7087.27, "timestamp": "01:58:07", "text": "何てことだ。"}, {"type": "subtitle", "time": 7090.149, "timestamp": "01:58:10", "text": "いいえ。"}, {"type": "subtitle", "time": 7099.669, "timestamp": "01:58:19", "text": "私たちは目標を設定しました。"}, {"type": "subtitle", "time": 7102.55, "timestamp": "01:58:22", "text": "私は助けが必要です。"}, {"type": "subtitle", "time": 7105.03, "timestamp": "01:58:25", "text": "我々の目標の一つが攻撃を受けている。"}, {"type": "subtitle", "time": 7106.87, "timestamp": "01:58:26", "text": "たくさんの人がいる。何てことだ。"}, {"type": "subtitle", "time": 7109.669, "timestamp": "01:58:29", "text": "今こそその時だ。"}, {"type": "subtitle", "time": 7113.83, "timestamp": "01:58:33", "text": "今こそ、ピューピューと撃つ時だ。"}, {"type": "subtitle", "time": 7118.31, "timestamp": "01:58:38", "text": "ああ、今気づいたんだけど、ああ、待って。私"}, {"type": "subtitle", "time": 7122.709, "timestamp": "01:58:42", "text": "配信が止まったことに今気づいた。"}]
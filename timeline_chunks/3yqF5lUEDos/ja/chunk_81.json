[{"type": "subtitle", "time": 4860.79, "timestamp": "01:21:00", "text": "その間"}, {"type": "subtitle", "time": 4863.27, "timestamp": "01:21:03", "text": "それ以降は、それをするのに少し時間がかかります。"}, {"type": "subtitle", "time": 4866.47, "timestamp": "01:21:06", "text": "「やるよ、やるよ」と言うだけで、決して実行しない。"}, {"type": "subtitle", "time": 4868.79, "timestamp": "01:21:08", "text": "それが問題なのです。"}, {"type": "subtitle", "time": 4872.709, "timestamp": "01:21:12", "text": "変化が必要だと分かっている。うん。"}, {"type": "subtitle", "time": 4874.709, "timestamp": "01:21:14", "text": "そして、気にかけてくれる人たちの言うことを聞くのをやめましょう"}, {"type": "subtitle", "time": 4878.63, "timestamp": "01:21:18", "text": "私について。私は決して考えない"}, {"type": "subtitle", "time": 4882.31, "timestamp": "01:21:22", "text": "私は彼らの時間を無駄にしない。"}, {"type": "subtitle", "time": 4908.31, "timestamp": "01:21:48", "text": "いいえ、だからこそ私はあなたをそばに置いておくのです。えっと、それは"}]
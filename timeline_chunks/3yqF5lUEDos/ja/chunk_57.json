[{"type": "subtitle", "time": 3435.19, "timestamp": "00:57:15", "text": "ションがここにいる。"}, {"type": "subtitle", "time": 3448.63, "timestamp": "00:57:28", "text": "いいえ。何てことだ。あなたはただそうしなかったのですか"}, {"type": "subtitle", "time": 3457.349, "timestamp": "00:57:37", "text": "アルファワンへの攻撃。私はそこで見た"}, {"type": "subtitle", "time": 3469.109, "timestamp": "00:57:49", "text": "男は一人いるべきだ。彼は終わった"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "そこには。あそこにあります。"}, {"type": "subtitle", "time": 3476.15, "timestamp": "00:57:56", "text": "ああ、こっそり忍び込んでいるこの男のことだよ。"}]
[{"type": "subtitle", "time": 17582.868, "timestamp": "04:53:02", "text": "参加しました。あれ覚えてる？私は言った"}, {"type": "subtitle", "time": 17585.11, "timestamp": "04:53:05", "text": "それです"}, {"type": "subtitle", "time": 17586.708, "timestamp": "04:53:06", "text": "えーと"}, {"type": "subtitle", "time": 17589.59, "timestamp": "04:53:09", "text": "彼女がサーバー上で発表した内容。おお、"}, {"type": "subtitle", "time": 17594.948, "timestamp": "04:53:14", "text": "うん。うん。うん。正しい。うん。"}, {"type": "subtitle", "time": 17607.43, "timestamp": "04:53:27", "text": "うん。私が辞める前のこと"}, {"type": "subtitle", "time": 17608.948, "timestamp": "04:53:28", "text": "YouTuber。"}, {"type": "subtitle", "time": 17615.19, "timestamp": "04:53:35", "text": "以前のエイリアス。それは何と呼ばれますか？"}, {"type": "subtitle", "time": 17619.91, "timestamp": "04:53:39", "text": "エイリアス。いいえ。別名ではありません。アバター。いいえ。なぜなら"}, {"type": "subtitle", "time": 17623.03, "timestamp": "04:53:43", "text": "私は見ています、私は読みすぎているマナ。"}, {"type": "subtitle", "time": 17625.99, "timestamp": "04:53:45", "text": "えっと、最近のマナのせいだと思う"}, {"type": "subtitle", "time": 17628.07, "timestamp": "04:53:48", "text": "アバターのようなものだと読んでいた"}, {"type": "subtitle", "time": 17631.51, "timestamp": "04:53:51", "text": "あれ。つまり、えーと、"}, {"type": "subtitle", "time": 17633.51, "timestamp": "04:53:53", "text": "レベル50。"}, {"type": "subtitle", "time": 17636.708, "timestamp": "04:53:56", "text": "うん、レベル50のこれをさらに上のレベルに"}, {"type": "subtitle", "time": 17639.03, "timestamp": "04:53:59", "text": "魔王のアバターのようなレベル、または"}]
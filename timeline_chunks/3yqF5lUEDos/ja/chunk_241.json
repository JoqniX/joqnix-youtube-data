[{"type": "subtitle", "time": 14469.99, "timestamp": "04:01:09", "text": "よし、降りよう。あるいは、むしろ"}, {"type": "subtitle", "time": 14476.63, "timestamp": "04:01:16", "text": "[音楽]"}, {"type": "subtitle", "time": 14479.67, "timestamp": "04:01:19", "text": "待って、あれはもう上がってるよ。"}, {"type": "subtitle", "time": 14481.99, "timestamp": "04:01:21", "text": "ああ、覚えてるの？そうそう。うん。うん。"}, {"type": "subtitle", "time": 14484.55, "timestamp": "04:01:24", "text": "基礎となる場所。はい。はい。"}, {"type": "subtitle", "time": 14489.11, "timestamp": "04:01:29", "text": "はい。ここにありますか？これ覚えてる？"}, {"type": "subtitle", "time": 14491.03, "timestamp": "04:01:31", "text": "もの？それがあなただったかどうかはわかりません"}, {"type": "subtitle", "time": 14494.389, "timestamp": "04:01:34", "text": "誰が彼らをここに連れてきたのか。"}, {"type": "subtitle", "time": 14501.03, "timestamp": "04:01:41", "text": "ああ、そうそう、馬のことね。何てことだ。私はただ"}, {"type": "subtitle", "time": 14504.469, "timestamp": "04:01:44", "text": "彼らがまだここにいるといいんだけど。思い出。ああ、"}, {"type": "subtitle", "time": 14507.91, "timestamp": "04:01:47", "text": "神。その道を進みたいですか？うん。"}, {"type": "subtitle", "time": 14510.229, "timestamp": "04:01:50", "text": "これです。"}, {"type": "subtitle", "time": 14518.07, "timestamp": "04:01:58", "text": "その部分。ああ、これ覚えてるよ。"}]
[{"type": "subtitle", "time": 17280.55, "timestamp": "04:48:00", "text": "元クリサチーム。そう、私は"}, {"type": "subtitle", "time": 17285.11, "timestamp": "04:48:05", "text": "彼らの基地へ直行した。"}, {"type": "subtitle", "time": 17288.868, "timestamp": "04:48:08", "text": "ええ、正式に私たちの拠点です"}, {"type": "subtitle", "time": 17292.15, "timestamp": "04:48:12", "text": "そして、訪問したように、"}, {"type": "subtitle", "time": 17294.628, "timestamp": "04:48:14", "text": "訪問して、彼らがどんなプロジェクトをしているか見ました"}, {"type": "subtitle", "time": 17297.51, "timestamp": "04:48:17", "text": "取り組んでいた。実際にはそうではない"}, {"type": "subtitle", "time": 17300.07, "timestamp": "04:48:20", "text": "約半分を見せてくれる"}, {"type": "subtitle", "time": 17304.15, "timestamp": "04:48:24", "text": "彼ら。誰もまだ私のような人ではないと思います"}, {"type": "subtitle", "time": 17306.39, "timestamp": "04:48:26", "text": "元メンバー。"}, {"type": "subtitle", "time": 17309.43, "timestamp": "04:48:29", "text": "ええ、元メンバーですが、はい、います"}, {"type": "subtitle", "time": 17311.43, "timestamp": "04:48:31", "text": "何か秘密保持契約とかあったの？"}, {"type": "subtitle", "time": 17313.11, "timestamp": "04:48:33", "text": "何か？"}, {"type": "subtitle", "time": 17315.75, "timestamp": "04:48:35", "text": "「私は創設者の一人です」と署名しなければなりませんでした。"}, {"type": "subtitle", "time": 17318.788, "timestamp": "04:48:38", "text": "秘密保持契約（NDA）についてはどうでしょうか？はぁ？ええ、あなたは"}, {"type": "subtitle", "time": 17321.75, "timestamp": "04:48:41", "text": "創業者たち。どうして彼らはあなたをそんな風に扱えるだろうか"}, {"type": "subtitle", "time": 17326.15, "timestamp": "04:48:46", "text": "今はそんな感じ？うん。または、言ったように３つ"}, {"type": "subtitle", "time": 17329.67, "timestamp": "04:48:49", "text": "彼女は彼が決してしないと決めたように。"}, {"type": "subtitle", "time": 17332.55, "timestamp": "04:48:52", "text": "うん。彼女はまるで、ほら、警部みたいな"}, {"type": "subtitle", "time": 17335.51, "timestamp": "04:48:55", "text": "彼女が確認するようなプロジェクト検査官"}, {"type": "subtitle", "time": 17339.27, "timestamp": "04:48:59", "text": "すべて順調です。おお"}]
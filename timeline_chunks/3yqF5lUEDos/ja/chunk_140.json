[{"type": "subtitle", "time": 8401.11, "timestamp": "02:20:01", "text": "私が知っている友人たち。彼らは私にそう言った"}, {"type": "subtitle", "time": 8404.309, "timestamp": "02:20:04", "text": "彼らはその件で私を助けてくれるでしょう。そう、私たちは"}, {"type": "subtitle", "time": 8407.31, "timestamp": "02:20:07", "text": "近いうちに3Dや2Dにも挑戦するかもしれません。"}, {"type": "subtitle", "time": 8408.79, "timestamp": "02:20:08", "text": "[音楽]"}, {"type": "subtitle", "time": 8413.27, "timestamp": "02:20:13", "text": "ええ、それで、もっと色々なことをしたかったんです"}, {"type": "subtitle", "time": 8416.389, "timestamp": "02:20:16", "text": "皆さんが楽しむために"}, {"type": "subtitle", "time": 8418.469, "timestamp": "02:20:18", "text": "このPNGを見て、"}, {"type": "subtitle", "time": 8421.03, "timestamp": "02:20:21", "text": "あなたの魂。"}, {"type": "subtitle", "time": 8423.91, "timestamp": "02:20:23", "text": "あなたの魂を見つめている。"}, {"type": "subtitle", "time": 8426.55, "timestamp": "02:20:26", "text": "あなたの魂を見つめる"}, {"type": "subtitle", "time": 8431.59, "timestamp": "02:20:31", "text": "うん。"}, {"type": "subtitle", "time": 8433.429, "timestamp": "02:20:33", "text": "そうですね、"}, {"type": "subtitle", "time": 8436.469, "timestamp": "02:20:36", "text": "そうするつもりです。動きが欲しい、"}, {"type": "subtitle", "time": 8444.23, "timestamp": "02:20:44", "text": "ええと、ちょっと待って、私のツイートはどこ？私にさせて"}, {"type": "subtitle", "time": 8447.27, "timestamp": "02:20:47", "text": "私のツイートを受け取ってください。"}, {"type": "subtitle", "time": 8448.87, "timestamp": "02:20:48", "text": "えっと、"}, {"type": "subtitle", "time": 8450.79, "timestamp": "02:20:50", "text": "どこにいるの？"}, {"type": "subtitle", "time": 8454.309, "timestamp": "02:20:54", "text": "こんにちは、75 があります"}]
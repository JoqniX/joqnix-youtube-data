[{"type": "subtitle", "time": 15365.349, "timestamp": "04:16:05", "text": "いや、違う。えっと、"}, {"type": "subtitle", "time": 15367.83, "timestamp": "04:16:07", "text": "私はこのモンスタースポナーの上にいます"}, {"type": "subtitle", "time": 15371.51, "timestamp": "04:16:11", "text": "もの。私は屋敷に戻ります。"}, {"type": "subtitle", "time": 15373.51, "timestamp": "04:16:13", "text": "そうそう。これはあなたの発明でした。"}, {"type": "subtitle", "time": 15376.63, "timestamp": "04:16:16", "text": "右？牛牧場"}, {"type": "subtitle", "time": 15380.469, "timestamp": "04:16:20", "text": "そして農場。うん、"}, {"type": "subtitle", "time": 15383.03, "timestamp": "04:16:23", "text": "村人のvのこと。ここにあります、"}, {"type": "subtitle", "time": 15385.03, "timestamp": "04:16:25", "text": "右？"}, {"type": "subtitle", "time": 15388.55, "timestamp": "04:16:28", "text": "隠された村はどこにあるのか"}, {"type": "subtitle", "time": 15391.429, "timestamp": "04:16:31", "text": "交渉の場？"}, {"type": "subtitle", "time": 15395.51, "timestamp": "04:16:35", "text": "ああ、この場所。うん。ああ、これだ。"}, {"type": "subtitle", "time": 15397.59, "timestamp": "04:16:37", "text": "ここで私は雌犬を治すか、"}, {"type": "subtitle", "time": 15401.51, "timestamp": "04:16:41", "text": "何か。私は覚えています。うん。そうそう。"}, {"type": "subtitle", "time": 15403.99, "timestamp": "04:16:43", "text": "それは鉄道関係の物です。覚えていますか"}, {"type": "subtitle", "time": 15407.75, "timestamp": "04:16:47", "text": "それ？ああ、行こうよ、そうしよう"}, {"type": "subtitle", "time": 15411.269, "timestamp": "04:16:51", "text": "そこには。うん。うん。"}, {"type": "subtitle", "time": 15418.55, "timestamp": "04:16:58", "text": "[音楽]"}]
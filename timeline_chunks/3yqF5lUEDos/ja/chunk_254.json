[{"type": "subtitle", "time": 15240.229, "timestamp": "04:14:00", "text": "はい。ネザーでリスポーンするんですか？はい。の"}, {"type": "subtitle", "time": 15241.91, "timestamp": "04:14:01", "text": "リスポーン"}, {"type": "subtitle", "time": 15245.83, "timestamp": "04:14:05", "text": "ええと、返答してください。"}, {"type": "subtitle", "time": 15252.55, "timestamp": "04:14:12", "text": "行く。"}, {"type": "subtitle", "time": 15254.71, "timestamp": "04:14:14", "text": "ええ、戻ってきましたよ。私たちは"}, {"type": "subtitle", "time": 15273.03, "timestamp": "04:14:33", "text": "戻る。はい。戻る。そして今"}, {"type": "subtitle", "time": 15276.71, "timestamp": "04:14:36", "text": "えっと、電話です。うん。右。"}, {"type": "subtitle", "time": 15279.51, "timestamp": "04:14:39", "text": "あなたはクリエイティブ系の仕事をしていますか？"}, {"type": "subtitle", "time": 15283.349, "timestamp": "04:14:43", "text": "いや、待って。私はそうでしょうか？いいえ、違います。ああ、あなたは"}, {"type": "subtitle", "time": 15293.11, "timestamp": "04:14:53", "text": "なぜあれはクモなのですか？"}, {"type": "subtitle", "time": 15294.95, "timestamp": "04:14:54", "text": "わかった、"}]
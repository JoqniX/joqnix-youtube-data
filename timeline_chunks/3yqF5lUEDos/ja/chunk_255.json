[{"type": "subtitle", "time": 15304.389, "timestamp": "04:15:04", "text": "よし、どちらの方向か確認しよう"}, {"type": "subtitle", "time": 15306.79, "timestamp": "04:15:06", "text": "はい、こちらですね？それからこれあれ"}, {"type": "subtitle", "time": 15309.67, "timestamp": "04:15:09", "text": "方法、"}, {"type": "subtitle", "time": 15312.63, "timestamp": "04:15:12", "text": "私はここにいます"}, {"type": "subtitle", "time": 15316.71, "timestamp": "04:15:16", "text": "階段みたいなもの。どこにいるの？"}, {"type": "subtitle", "time": 15320.229, "timestamp": "04:15:20", "text": "私は剣の近くにいる。私はそこへ行きます。"}, {"type": "subtitle", "time": 15327.349, "timestamp": "04:15:27", "text": "私は剣のすぐ近くにいます。"}, {"type": "subtitle", "time": 15330.55, "timestamp": "04:15:30", "text": "はい、こちらに誰かがいます。つまり、"}, {"type": "subtitle", "time": 15345.59, "timestamp": "04:15:45", "text": "私は保管場所にいます。"}, {"type": "subtitle", "time": 15348.63, "timestamp": "04:15:48", "text": "私は剣の中にいる。私は剣のところにいる。で"}, {"type": "subtitle", "time": 15355.83, "timestamp": "04:15:55", "text": "ああ、このモンスタースポナーの上にあるような"}, {"type": "subtitle", "time": 15357.91, "timestamp": "04:15:57", "text": "あれ。"}]
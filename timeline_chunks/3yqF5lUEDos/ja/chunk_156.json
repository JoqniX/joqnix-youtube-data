[{"type": "subtitle", "time": 9360.79, "timestamp": "02:36:00", "text": "すべて順調です。"}, {"type": "subtitle", "time": 9365.03, "timestamp": "02:36:05", "text": "すぐにプレイします。あなたは何と言いますか？"}, {"type": "subtitle", "time": 9368.71, "timestamp": "02:36:08", "text": "うん、遊ぼうよ。"}, {"type": "subtitle", "time": 9373.51, "timestamp": "02:36:13", "text": "こんにちは。私はそこに入る。こんにちは。 ３、２、１。する"}, {"type": "subtitle", "time": 9375.429, "timestamp": "02:36:15", "text": "それ。"}, {"type": "subtitle", "time": 9378.15, "timestamp": "02:36:18", "text": "以前、テストのためにログインしました。それで、"}, {"type": "subtitle", "time": 9380.63, "timestamp": "02:36:20", "text": "うん。"}, {"type": "subtitle", "time": 9382.95, "timestamp": "02:36:22", "text": "何てことだ。"}, {"type": "subtitle", "time": 9384.63, "timestamp": "02:36:24", "text": "うん。"}, {"type": "subtitle", "time": 9387.91, "timestamp": "02:36:27", "text": "わかった。少し遅れています。私はここにいます。これ"}, {"type": "subtitle", "time": 9390.23, "timestamp": "02:36:30", "text": "FPSが安定しています。わからない。わかった。私はできる"}, {"type": "subtitle", "time": 9395.34, "timestamp": "02:36:35", "text": "私の肌を見てください。こんにちは。こんにちは。待って。"}, {"type": "subtitle", "time": 9397.91, "timestamp": "02:36:37", "text": "[音楽]"}, {"type": "subtitle", "time": 9405.59, "timestamp": "02:36:45", "text": "わかった。私のは安定していません、"}, {"type": "subtitle", "time": 9408.87, "timestamp": "02:36:48", "text": "でも、あなたの側がそうであることを願っています。うん。"}, {"type": "subtitle", "time": 9410.95, "timestamp": "02:36:50", "text": "つまり、私のものは一時的なものになる"}, {"type": "subtitle", "time": 9413.51, "timestamp": "02:36:53", "text": "非公開。だから、まあ、"}, {"type": "subtitle", "time": 9416.309, "timestamp": "02:36:56", "text": "私たちが楽しむように。"}]
[{"type": "subtitle", "time": 8461.11, "timestamp": "02:21:01", "text": "彼らは"}, {"type": "subtitle", "time": 8463.429, "timestamp": "02:21:03", "text": "君は僕みたいな男が好き？それとも嫌い？"}, {"type": "subtitle", "time": 8465.51, "timestamp": "02:21:05", "text": "ストリーミングしすぎ？あなたのことを知りたい"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "考え。それで"}, {"type": "subtitle", "time": 8471.83, "timestamp": "02:21:11", "text": "75人が、パーセントの人が"}, {"type": "subtitle", "time": 8475.03, "timestamp": "02:21:15", "text": "はい、はいと言った人の割合と"}, {"type": "subtitle", "time": 8478.309, "timestamp": "02:21:18", "text": "25％が「いいえ」と答えた。だから私はこう思う"}, {"type": "subtitle", "time": 8480.87, "timestamp": "02:21:20", "text": "混乱した。"}, {"type": "subtitle", "time": 8483.99, "timestamp": "02:21:23", "text": "私が配信しすぎるのが嫌ですか？"}, {"type": "subtitle", "time": 8488.87, "timestamp": "02:21:28", "text": "それとも、好きか嫌いか、どちらかを選べと言ったから好きですか？"}, {"type": "subtitle", "time": 8493.75, "timestamp": "02:21:33", "text": "だから、まずはいいねが先なので、そうなります"}, {"type": "subtitle", "time": 8495.67, "timestamp": "02:21:35", "text": "そうですよね。君たちは私のことが好きなんだね"}, {"type": "subtitle", "time": 8502.07, "timestamp": "02:21:42", "text": "あなたは勝ちました"}, {"type": "subtitle", "time": 8506.71, "timestamp": "02:21:46", "text": "12時間分の配信を遡って視聴できます。"}, {"type": "subtitle", "time": 8509.83, "timestamp": "02:21:49", "text": "ズキがここにいないことを願う。彼女はボンと鳴らすだろう"}, {"type": "subtitle", "time": 8513.19, "timestamp": "02:21:53", "text": "自分。つまり、彼女は私をボングするだろう。ああ、12"}, {"type": "subtitle", "time": 8515.67, "timestamp": "02:21:55", "text": "時間ごとの配信。人々はしたくない"}, {"type": "subtitle", "time": 8517.67, "timestamp": "02:21:57", "text": "ストリーミングが長すぎます。"}, {"type": "subtitle", "time": 8519.75, "timestamp": "02:21:59", "text": "欲しい"}]
[{"type": "subtitle", "time": 13980.71, "timestamp": "03:53:00", "text": "行きたい場所はありますか？おお"}, {"type": "subtitle", "time": 13982.95, "timestamp": "03:53:02", "text": "ええ、ここです。右。うん、"}, {"type": "subtitle", "time": 13985.349, "timestamp": "03:53:05", "text": "ここです。"}, {"type": "subtitle", "time": 13987.189, "timestamp": "03:53:07", "text": "私はここで初日に亡くなりました"}, {"type": "subtitle", "time": 13993.189, "timestamp": "03:53:13", "text": "サーバ。ああ、覚えてる？はい。はい。"}, {"type": "subtitle", "time": 13996.55, "timestamp": "03:53:16", "text": "あの骸骨に殺された。そして私は大きな"}, {"type": "subtitle", "time": 14000.309, "timestamp": "03:53:20", "text": "一晩だけここに塔がある"}, {"type": "subtitle", "time": 14002.309, "timestamp": "03:53:22", "text": "私が降りてきたときの最初のキルは"}, {"type": "subtitle", "time": 14004.389, "timestamp": "03:53:24", "text": "ここ。"}, {"type": "subtitle", "time": 14007.75, "timestamp": "03:53:27", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "私の記憶は文字通り"}, {"type": "subtitle", "time": 14014.63, "timestamp": "03:53:34", "text": "あなたのこの豪邸で、一緒に寝る"}, {"type": "subtitle", "time": 14017.51, "timestamp": "03:53:37", "text": "そして、そういったものすべて。ああ、秘密"}, {"type": "subtitle", "time": 14022.63, "timestamp": "03:53:42", "text": "ボタン。音楽用にシャボックスを設置したんですね。"}, {"type": "subtitle", "time": 14026.63, "timestamp": "03:53:46", "text": "ドラゴンの頭部も。ええ、あります"}, {"type": "subtitle", "time": 14030.71, "timestamp": "03:53:50", "text": "また、石の羅針盤は宝物である"}, {"type": "subtitle", "time": 14034.389, "timestamp": "03:53:54", "text": "マップサドル。襲撃があった"}, {"type": "subtitle", "time": 14038.95, "timestamp": "03:53:58", "text": "サーバーは一度だけ稼働します。うん。うん。うん。"}]
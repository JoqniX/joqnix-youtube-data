[{"type": "subtitle", "time": 15426.71, "timestamp": "04:17:06", "text": "ネオンサインの取り外し方。"}, {"type": "subtitle", "time": 15455.269, "timestamp": "04:17:35", "text": "全速力で突っ込んでいく。"}, {"type": "subtitle", "time": 15458.389, "timestamp": "04:17:38", "text": "私は戻ってきた。"}, {"type": "subtitle", "time": 15467.59, "timestamp": "04:17:47", "text": "行け、行け、行け、行け、行け、行け、行け、行け、行け。"}, {"type": "subtitle", "time": 15470.149, "timestamp": "04:17:50", "text": "はい。あと、チャド、私が食べてるのを気にしないでね"}, {"type": "subtitle", "time": 15472.229, "timestamp": "04:17:52", "text": "ポップコーン。"}, {"type": "subtitle", "time": 15476.63, "timestamp": "04:17:56", "text": "あ、ポップコーンを食べているんですか？"}]
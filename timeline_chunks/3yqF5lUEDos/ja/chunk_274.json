[{"type": "subtitle", "time": 16443.029, "timestamp": "04:34:03", "text": "最初から。今度はモーターだ。私"}, {"type": "subtitle", "time": 16444.789, "timestamp": "04:34:04", "text": "設定をいくつか変更して、今は"}, {"type": "subtitle", "time": 16462.019, "timestamp": "04:34:22", "text": "[音楽]"}, {"type": "subtitle", "time": 16474.98, "timestamp": "04:34:34", "text": "もう彼らは必要ない。"}, {"type": "subtitle", "time": 16484.07, "timestamp": "04:34:44", "text": "あれらは全て近辺の出来事だったと思う。私"}, {"type": "subtitle", "time": 16487.99, "timestamp": "04:34:47", "text": "あの砂漠の村を覚えていない"}, {"type": "subtitle", "time": 16490.31, "timestamp": "04:34:50", "text": "私たちはそこに来たのです。"}]
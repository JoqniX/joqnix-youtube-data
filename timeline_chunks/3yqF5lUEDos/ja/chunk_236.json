[{"type": "subtitle", "time": 14161.51, "timestamp": "03:56:01", "text": "そこには"}, {"type": "subtitle", "time": 14164.71, "timestamp": "03:56:04", "text": "そして彼は、私が離れると、"}, {"type": "subtitle", "time": 14167.269, "timestamp": "03:56:07", "text": "ネオア人にはならないだろう。死者が出るだろう"}, {"type": "subtitle", "time": 14177.59, "timestamp": "03:56:17", "text": "\"おい、"}, {"type": "subtitle", "time": 14185.349, "timestamp": "03:56:25", "text": "そしてそれ以来、あなたは"}, {"type": "subtitle", "time": 14188.55, "timestamp": "03:56:28", "text": "この場所には猫が３匹しかいない。それは"}, {"type": "subtitle", "time": 14191.11, "timestamp": "03:56:31", "text": "この３つ。"}, {"type": "subtitle", "time": 14200.15, "timestamp": "03:56:40", "text": "ノスタルジア"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "あの男。そして、これらもある"}, {"type": "subtitle", "time": 14205.429, "timestamp": "03:56:45", "text": "3匹の猫"}, {"type": "subtitle", "time": 14207.67, "timestamp": "03:56:47", "text": "一部の人にとっては、4つあります。ああ、"}, {"type": "subtitle", "time": 14210.95, "timestamp": "03:56:50", "text": "神。彼らはどこから来たのか？"}]
[{"type": "subtitle", "time": 3546.549, "timestamp": "00:59:06", "text": "うん。行け、行け、行け、行け。これは戦争だ。"}, {"type": "subtitle", "time": 3548.309, "timestamp": "00:59:08", "text": "死ぬ。"}, {"type": "subtitle", "time": 3549.91, "timestamp": "00:59:09", "text": "いいえ、"}, {"type": "subtitle", "time": 3583.43, "timestamp": "00:59:43", "text": "待って。これを変えなきゃ。"}, {"type": "subtitle", "time": 3586.87, "timestamp": "00:59:46", "text": "変更できますか？はい。ありがとう。"}, {"type": "subtitle", "time": 3590.789, "timestamp": "00:59:50", "text": "まだロックを解除していません。大丈夫。"}, {"type": "subtitle", "time": 3592.95, "timestamp": "00:59:52", "text": "わかった。"}, {"type": "subtitle", "time": 3598.87, "timestamp": "00:59:58", "text": "他に何ができるだろうか、他に何をしただろうか"}]
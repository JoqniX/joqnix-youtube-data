[{"type": "subtitle", "time": 4459.35, "timestamp": "01:14:19", "text": "来て。私たちは壁と戦っている。さあ"}, {"type": "subtitle", "time": 4462.95, "timestamp": "01:14:22", "text": "行く。ピュー。弾薬を手に入れろ。ピュー。ピュー。ピュー。"}, {"type": "subtitle", "time": 4465.83, "timestamp": "01:14:25", "text": "さあ行こう。走る。走る。走る。私は走っています"}, {"type": "subtitle", "time": 4468.39, "timestamp": "01:14:28", "text": "地獄を通り抜けて。私は走っています、ああ、"}, {"type": "subtitle", "time": 4471.43, "timestamp": "01:14:31", "text": "あれは私のチームメイトです。どうぞお入りください。どうぞお入りください。"}, {"type": "subtitle", "time": 4473.189, "timestamp": "01:14:33", "text": "弾薬を手に入れろ。弾薬を手に入れろ。入手する"}]
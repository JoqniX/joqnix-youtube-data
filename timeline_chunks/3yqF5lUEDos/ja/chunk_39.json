[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "あの笑顔、見えますか？それは私です。つまり私は"}, {"type": "subtitle", "time": 2343.589, "timestamp": "00:39:03", "text": "今、笑顔です。"}, {"type": "subtitle", "time": 2345.03, "timestamp": "00:39:05", "text": "我々は港への攻撃を開始する"}, {"type": "subtitle", "time": 2347.109, "timestamp": "00:39:07", "text": "シンガポールの。ここはグローバルな中心地です"}, {"type": "subtitle", "time": 2348.63, "timestamp": "00:39:08", "text": "貿易。ロシア人が"}, {"type": "subtitle", "time": 2350.95, "timestamp": "00:39:10", "text": "自分たちの有利になるように操作する。最後に"}, {"type": "subtitle", "time": 2353.91, "timestamp": "00:39:13", "text": "今日。あなたは包囲攻撃を仕掛ける"}, {"type": "subtitle", "time": 2355.91, "timestamp": "00:39:15", "text": "港に出てロシア軍を追い出す。"}, {"type": "subtitle", "time": 2357.67, "timestamp": "00:39:17", "text": "私たちはあなたに期待しています。残りの"}, {"type": "subtitle", "time": 2360.39, "timestamp": "00:39:20", "text": "世界も同様だ。なぜこんなにあくびばかりするんだろう？"}, {"type": "subtitle", "time": 2381.99, "timestamp": "00:39:41", "text": "おい、"}]
[{"type": "subtitle", "time": 13383.75, "timestamp": "03:43:03", "text": "えーと15 えーと"}, {"type": "subtitle", "time": 13386.15, "timestamp": "03:43:06", "text": "どこにいるの？商品は届きましたか？"}, {"type": "subtitle", "time": 13389.51, "timestamp": "03:43:09", "text": "いや、いや、いや、いや、いや、いや。これはあなたのものですか？"}, {"type": "subtitle", "time": 13393.99, "timestamp": "03:43:13", "text": "ああ、君のお墓を見つけたと思うよ。"}, {"type": "subtitle", "time": 13403.59, "timestamp": "03:43:23", "text": "これは違う。"}, {"type": "subtitle", "time": 13411.67, "timestamp": "03:43:31", "text": "これは違う、いや、待って。ああ、"}, {"type": "subtitle", "time": 13415.03, "timestamp": "03:43:35", "text": "27歳、あなたへ。"}, {"type": "subtitle", "time": 13423.11, "timestamp": "03:43:43", "text": "待って。えっと、27番。はい、こちらです。私の"}, {"type": "subtitle", "time": 13429.91, "timestamp": "03:43:49", "text": "私は昔に慣れすぎている。私もそうだった"}, {"type": "subtitle", "time": 13435.91, "timestamp": "03:43:55", "text": "[音楽]"}, {"type": "subtitle", "time": 13439.269, "timestamp": "03:43:59", "text": "うん。こんにちは。答えは得られましたか？それ"}]
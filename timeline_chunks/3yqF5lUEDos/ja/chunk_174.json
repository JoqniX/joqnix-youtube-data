[{"type": "subtitle", "time": 10442.55, "timestamp": "02:54:02", "text": "そう、私たちは思い出のためにここにいるんだ"}, {"type": "subtitle", "time": 10466.71, "timestamp": "02:54:26", "text": "景色を楽しみましょう。"}, {"type": "subtitle", "time": 10470.87, "timestamp": "02:54:30", "text": "ああ、お母さんたちが倒れてるよ。"}, {"type": "subtitle", "time": 10473.11, "timestamp": "02:54:33", "text": "何か楽しめるものはありますか？私は推測する"}, {"type": "subtitle", "time": 10475.349, "timestamp": "02:54:35", "text": "満足感がある。"}, {"type": "subtitle", "time": 10481.19, "timestamp": "02:54:41", "text": "あと、えっと"}, {"type": "subtitle", "time": 10484.63, "timestamp": "02:54:44", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 10487.91, "timestamp": "02:54:47", "text": "ロア、あなたはここに来たばかりですか？あなただと思う"}, {"type": "subtitle", "time": 10489.67, "timestamp": "02:54:49", "text": "今日、私のチャンネルをどのように見つけましたか？"}, {"type": "subtitle", "time": 10492.15, "timestamp": "02:54:52", "text": "そして、どれほど歓迎されたことでしょう？いらっしゃいませ"}, {"type": "subtitle", "time": 10496.389, "timestamp": "02:54:56", "text": "空高く。どれ？週末。"}, {"type": "subtitle", "time": 10498.63, "timestamp": "02:54:58", "text": "ああ、あれみたいなやつだよね？あの黒"}]
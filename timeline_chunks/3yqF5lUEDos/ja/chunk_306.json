[{"type": "subtitle", "time": 18363.59, "timestamp": "05:06:03", "text": "つまり、ひどく失敗したということだ。なぜ？の"}, {"type": "subtitle", "time": 18365.51, "timestamp": "05:06:05", "text": "文化的な事柄。"}, {"type": "subtitle", "time": 18369.91, "timestamp": "05:06:09", "text": "日本人の心。ああ、日本語のことですね。"}, {"type": "subtitle", "time": 18371.67, "timestamp": "05:06:11", "text": "ああ、わかりました。わかった。わかった。わかった。ええ、それは"}, {"type": "subtitle", "time": 18373.43, "timestamp": "05:06:13", "text": "大丈夫。"}, {"type": "subtitle", "time": 18375.67, "timestamp": "05:06:15", "text": "日本語で文化について語る。"}, {"type": "subtitle", "time": 18377.43, "timestamp": "05:06:17", "text": "それでおしまい。"}, {"type": "subtitle", "time": 18379.99, "timestamp": "05:06:19", "text": "あ、待って。コラボレーションのようなものですか、それとも"}, {"type": "subtitle", "time": 18381.91, "timestamp": "05:06:21", "text": "彼らの配信か何かで何かあったの？"}, {"type": "subtitle", "time": 18385.27, "timestamp": "05:06:25", "text": "いいえ、私たちはオーケーと一緒にPCにいました。"}, {"type": "subtitle", "time": 18389.11, "timestamp": "05:06:29", "text": "こんにちは。こんにちは。やあ、君。どうやってやってるの？"}, {"type": "subtitle", "time": 18392.31, "timestamp": "05:06:32", "text": "日本語？私はまだそれほど上手ではありません。私 私"}, {"type": "subtitle", "time": 18396.868, "timestamp": "05:06:36", "text": "死んだに違いない。心配しないで。あっちへ。"}, {"type": "subtitle", "time": 18400.628, "timestamp": "05:06:40", "text": "VRチャットはどこにあるの？"}, {"type": "subtitle", "time": 18403.59, "timestamp": "05:06:43", "text": "うん。こんにちは、ズキ。いらっしゃいませ。何てことだ。"}, {"type": "subtitle", "time": 18407.91, "timestamp": "05:06:47", "text": "私たちはまるでその場所を訪れているようだった。"}, {"type": "subtitle", "time": 18410.07, "timestamp": "05:06:50", "text": "もっと早く来てくれればよかったのに。"}, {"type": "subtitle", "time": 18417.27, "timestamp": "05:06:57", "text": "その物。"}]
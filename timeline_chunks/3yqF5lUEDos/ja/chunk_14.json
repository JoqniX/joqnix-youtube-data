[{"type": "subtitle", "time": 842.31, "timestamp": "00:14:02", "text": "仕事ばかりで、遊びがない。"}, {"type": "subtitle", "time": 845.59, "timestamp": "00:14:05", "text": "今日、今日は誇りに思う。"}, {"type": "subtitle", "time": 848.77, "timestamp": "00:14:08", "text": "あれはすごいことだった。"}, {"type": "subtitle", "time": 856.23, "timestamp": "00:14:16", "text": "SMGでのキルはわずか2回。前回、すごく勢いよくおしっこをした"}, {"type": "subtitle", "time": 869.91, "timestamp": "00:14:29", "text": "9月。"}, {"type": "subtitle", "time": 873.269, "timestamp": "00:14:33", "text": "これはどのアニメですか？実は、"}, {"type": "subtitle", "time": 875.43, "timestamp": "00:14:35", "text": "とても美味しいです。このモードの音楽はとても"}, {"type": "subtitle", "time": 881.11, "timestamp": "00:14:41", "text": "良い。全力で。私は全面戦争を望む。"}, {"type": "subtitle", "time": 883.91, "timestamp": "00:14:43", "text": "征服。"}, {"type": "subtitle", "time": 886.949, "timestamp": "00:14:46", "text": "難易度：初心者向け。勇敢な征服。"}, {"type": "subtitle", "time": 889.03, "timestamp": "00:14:49", "text": "わかった。よし。このゲームを起動するよ。"}, {"type": "subtitle", "time": 892.949, "timestamp": "00:14:52", "text": "じゃあ、私は猫のところへ行くよ。 1つ"}]
[{"type": "subtitle", "time": 8281.91, "timestamp": "02:18:01", "text": "えっと、皆さんと一緒に作ることによって。運命、"}, {"type": "subtitle", "time": 8283.429, "timestamp": "02:18:03", "text": "開店してからしばらく経ちました"}, {"type": "subtitle", "time": 8286.95, "timestamp": "02:18:06", "text": "運命。アッシュ、元気かい？あなたは何者ですか"}, {"type": "subtitle", "time": 8289.99, "timestamp": "02:18:09", "text": "男たちは何をしているの？"}, {"type": "subtitle", "time": 8293.99, "timestamp": "02:18:13", "text": "待って、今日はディープストーンクリプトの日なの？"}, {"type": "subtitle", "time": 8296.709, "timestamp": "02:18:16", "text": "うん。"}, {"type": "subtitle", "time": 8299.589, "timestamp": "02:18:19", "text": "元気でしたか？私は元気でした。私は"}, {"type": "subtitle", "time": 8302.549, "timestamp": "02:18:22", "text": "調子は良かった。久しぶりですね。えっと"}, {"type": "subtitle", "time": 8306.389, "timestamp": "02:18:26", "text": "Destinyをプレイした。私はちょっと寝ていた"}, {"type": "subtitle", "time": 8309.589, "timestamp": "02:18:29", "text": "Destiny なぜなら、私はやりすぎたし、"}, {"type": "subtitle", "time": 8314.07, "timestamp": "02:18:34", "text": "私はApexなどの他のゲームに切り替えました"}, {"type": "subtitle", "time": 8316.79, "timestamp": "02:18:36", "text": "少しだけ。"}, {"type": "subtitle", "time": 8318.87, "timestamp": "02:18:38", "text": "うん、"}, {"type": "subtitle", "time": 8322.469, "timestamp": "02:18:42", "text": "Destiny 2。そう、今夜はDSCはなし。おお、"}, {"type": "subtitle", "time": 8328.309, "timestamp": "02:18:48", "text": "こんにちは。次のダンジョンがいつ来るか教えてください"}, {"type": "subtitle", "time": 8331.83, "timestamp": "02:18:51", "text": "襲撃は。私は興奮しています。はい。気にしないで"}, {"type": "subtitle", "time": 8335.11, "timestamp": "02:18:55", "text": "自分。声が聞こえても気にしない"}]
[{"type": "subtitle", "time": 7442.95, "timestamp": "02:04:02", "text": "はい、そうです。ミナ、私たちはどうするの？"}, {"type": "subtitle", "time": 7447.589, "timestamp": "02:04:07", "text": "正直、よくわかりません。えっと"}, {"type": "subtitle", "time": 7450.629, "timestamp": "02:04:10", "text": "えっと、始めよう、これを終わらせよう"}, {"type": "subtitle", "time": 7452.55, "timestamp": "02:04:12", "text": "配信を終えたら、新しい配信を始めます"}, {"type": "subtitle", "time": 7454.95, "timestamp": "02:04:14", "text": "多分"}, {"type": "subtitle", "time": 7458.31, "timestamp": "02:04:18", "text": "だって、コンテンツが欲しいんだもん"}, {"type": "subtitle", "time": 7461.83, "timestamp": "02:04:21", "text": "このストリームをそのストリーム固有のものにする"}, {"type": "subtitle", "time": 7463.99, "timestamp": "02:04:23", "text": "もし私が他の何かを正しく行っているなら"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "2番目の配信にしたかった"}, {"type": "subtitle", "time": 7469.03, "timestamp": "02:04:29", "text": "それについて、あるいは少し話せるかもしれません"}, {"type": "subtitle", "time": 7472.87, "timestamp": "02:04:32", "text": "少しだけど、2日間歯痛が続いている"}, {"type": "subtitle", "time": 7479.83, "timestamp": "02:04:39", "text": "しばらく席を外すかもしれません"}, {"type": "subtitle", "time": 7482.55, "timestamp": "02:04:42", "text": "その後"}, {"type": "subtitle", "time": 7491.03, "timestamp": "02:04:51", "text": "だから今日は、ほとんどの場合私は"}, {"type": "subtitle", "time": 7494.149, "timestamp": "02:04:54", "text": "ゲーム用PC経由でストリーミングしない理由は"}, {"type": "subtitle", "time": 7497.91, "timestamp": "02:04:57", "text": "Battlefieldは非常にGPU負荷の高いゲームです"}]
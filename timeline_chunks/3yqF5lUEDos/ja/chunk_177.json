[{"type": "subtitle", "time": 10630.15, "timestamp": "02:57:10", "text": "そう、ここは海の神殿です。"}, {"type": "subtitle", "time": 10635.75, "timestamp": "02:57:15", "text": "良い。"}, {"type": "subtitle", "time": 10639.429, "timestamp": "02:57:19", "text": "があります"}, {"type": "subtitle", "time": 10642.23, "timestamp": "02:57:22", "text": "ここに神の武器がある。"}, {"type": "subtitle", "time": 10645.429, "timestamp": "02:57:25", "text": "神様、あなたは1つ取ってもいいですよ。"}, {"type": "subtitle", "time": 10647.83, "timestamp": "02:57:27", "text": "ああ、三叉槍。"}, {"type": "subtitle", "time": 10650.23, "timestamp": "02:57:30", "text": "トライデント。彼らは完全に魅了されている。マックス"}, {"type": "subtitle", "time": 10660.79, "timestamp": "02:57:40", "text": "カメの卵。"}, {"type": "subtitle", "time": 10663.75, "timestamp": "02:57:43", "text": "おお、"}, {"type": "subtitle", "time": 10669.83, "timestamp": "02:57:49", "text": "カナはなぜ亀の卵を捨てたのか？"}, {"type": "subtitle", "time": 10672.71, "timestamp": "02:57:52", "text": "おや、これは何でしょう？いいと思うよ、"}, {"type": "subtitle", "time": 10675.429, "timestamp": "02:57:55", "text": "ゲストルームがあります。"}]
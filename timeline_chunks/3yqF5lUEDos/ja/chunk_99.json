[{"type": "subtitle", "time": 5940.95, "timestamp": "01:39:00", "text": "エコー。それでは、セクターについて見ていきましょう。"}, {"type": "subtitle", "time": 5947.03, "timestamp": "01:39:07", "text": "私はそれを見ていません。彼はキャンプをしていた。何"}, {"type": "subtitle", "time": 5969.51, "timestamp": "01:39:29", "text": "さあ行こう。ピューピューウルトラ。"}, {"type": "subtitle", "time": 5985.669, "timestamp": "01:39:45", "text": "あ、待って。ああ、神様。我が神よ。これを手に入れる"}, {"type": "subtitle", "time": 5988.55, "timestamp": "01:39:48", "text": "どうにか。これらの人たちはとても強力で"}, {"type": "subtitle", "time": 5992.31, "timestamp": "01:39:52", "text": "ここ。それによって、"}]
[{"type": "subtitle", "time": 5597.83, "timestamp": "01:33:17", "text": "私は9月にいくつかの曲を聴いていました"}, {"type": "subtitle", "time": 5607.189, "timestamp": "01:33:27", "text": "誰かの声が聞こえる。あ、待って。この男は"}, {"type": "subtitle", "time": 5609.669, "timestamp": "01:33:29", "text": "1、2発で私を撃った。"}, {"type": "subtitle", "time": 5612.149, "timestamp": "01:33:32", "text": "何？"}, {"type": "subtitle", "time": 5632.79, "timestamp": "01:33:52", "text": "うん。起きる。さあ行こう。それはピューピューです"}]
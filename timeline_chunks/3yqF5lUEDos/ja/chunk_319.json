[{"type": "subtitle", "time": 19140.788, "timestamp": "05:19:00", "text": "今回は何をしたの？私はそうしました"}, {"type": "subtitle", "time": 19142.31, "timestamp": "05:19:02", "text": "何もない。"}, {"type": "subtitle", "time": 19144.788, "timestamp": "05:19:04", "text": "それはあなたが最後に話した時間に基づいています"}, {"type": "subtitle", "time": 19147.19, "timestamp": "05:19:07", "text": "Amazonと提携。"}, {"type": "subtitle", "time": 19148.948, "timestamp": "05:19:08", "text": "最後に話したのはいつだったか"}, {"type": "subtitle", "time": 19153.35, "timestamp": "05:19:13", "text": "アマゾン？彼女が私にDMでプレゼントを送ってくれたと思う"}, {"type": "subtitle", "time": 19157.51, "timestamp": "05:19:17", "text": "こんにちはの贈り物のように、私は送りました"}, {"type": "subtitle", "time": 19159.75, "timestamp": "05:19:19", "text": "こんにちは、ギフトのお返しです。私はあまり話さなかった"}, {"type": "subtitle", "time": 19162.868, "timestamp": "05:19:22", "text": "なぜなら、その時私は"}, {"type": "subtitle", "time": 19166.39, "timestamp": "05:19:26", "text": "熱があったので、話すことも電話を使うこともできませんでした"}, {"type": "subtitle", "time": 19168.868, "timestamp": "05:19:28", "text": "それだけだ。"}, {"type": "subtitle", "time": 19171.27, "timestamp": "05:19:31", "text": "半分眠っていたのを覚えている。"}, {"type": "subtitle", "time": 19180.15, "timestamp": "05:19:40", "text": "アマさんとはどのくらいの頻度で話しますか？"}, {"type": "subtitle", "time": 19181.75, "timestamp": "05:19:41", "text": "えっと、"}, {"type": "subtitle", "time": 19184.15, "timestamp": "05:19:44", "text": "ほぼ毎日。"}, {"type": "subtitle", "time": 19186.31, "timestamp": "05:19:46", "text": "え、本当に？"}, {"type": "subtitle", "time": 19190.708, "timestamp": "05:19:50", "text": "日本語ですか、それとも英語ですか？両方。"}]
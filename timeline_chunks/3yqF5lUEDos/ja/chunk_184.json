[{"type": "subtitle", "time": 11041.83, "timestamp": "03:04:01", "text": "秒。なんてこった。そして私は何て言ったの？"}, {"type": "subtitle", "time": 11043.75, "timestamp": "03:04:03", "text": "一体ここで何をしているんだ？つまり私は"}, {"type": "subtitle", "time": 11044.95, "timestamp": "03:04:04", "text": "何も見えなかったのは"}, {"type": "subtitle", "time": 11059.269, "timestamp": "03:04:19", "text": "何してるの？"}, {"type": "subtitle", "time": 11061.51, "timestamp": "03:04:21", "text": "その気持ち、よくわかるよ。しかし、時には"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "私の父や母が行くところ"}, {"type": "subtitle", "time": 11067.03, "timestamp": "03:04:27", "text": "私の部屋でただ私の部屋に座って、私は"}, {"type": "subtitle", "time": 11086.15, "timestamp": "03:04:46", "text": "1つ取ってください。"}, {"type": "subtitle", "time": 11088.15, "timestamp": "03:04:48", "text": "在庫を確認しましょう。"}, {"type": "subtitle", "time": 11090.309, "timestamp": "03:04:50", "text": "ああ、ダイヤモンドは全部君が持って行くんだ。私は"}]
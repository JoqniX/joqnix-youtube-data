[{"type": "subtitle", "time": 15488.95, "timestamp": "04:18:08", "text": "皆さんお元気でお過ごしでしょうか。今、"}, {"type": "subtitle", "time": 15491.67, "timestamp": "04:18:11", "text": "ちょっと風邪気味なので"}, {"type": "subtitle", "time": 15500.63, "timestamp": "04:18:20", "text": "私たちは買ったことを覚えています、私たちは"}, {"type": "subtitle", "time": 15502.87, "timestamp": "04:18:22", "text": "この鉄道線路をこんなに長くした"}, {"type": "subtitle", "time": 15508.149, "timestamp": "04:18:28", "text": "パス。ええ、この部分は完成しました。"}, {"type": "subtitle", "time": 15511.51, "timestamp": "04:18:31", "text": "何てことだ。"}]
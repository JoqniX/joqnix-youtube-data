[{"type": "subtitle", "time": 10263.59, "timestamp": "02:51:03", "text": "ええ、でも私は転びそうになっていたんです。"}, {"type": "subtitle", "time": 10271.349, "timestamp": "02:51:11", "text": "何？どうやってそこに行ったのですか？私はただ"}, {"type": "subtitle", "time": 10273.91, "timestamp": "02:51:13", "text": "ジャンプして"}, {"type": "subtitle", "time": 10276.71, "timestamp": "02:51:16", "text": "どんな気持ちでしたか？まるでこれがあるみたい"}, {"type": "subtitle", "time": 10279.26, "timestamp": "02:51:19", "text": "もの。おお。"}, {"type": "subtitle", "time": 10282.23, "timestamp": "02:51:22", "text": "[音楽]"}, {"type": "subtitle", "time": 10291.19, "timestamp": "02:51:31", "text": "うん。いつ、いつ"}, {"type": "subtitle", "time": 10295.11, "timestamp": "02:51:35", "text": "上部に拡張部分がありますか？そうそう。暴徒。"}, {"type": "subtitle", "time": 10297.99, "timestamp": "02:51:37", "text": "モンスター農場。うん。"}, {"type": "subtitle", "time": 10301.99, "timestamp": "02:51:41", "text": "ああ、神様。こちらです。よし、では"}, {"type": "subtitle", "time": 10305.67, "timestamp": "02:51:45", "text": "タワー。私たちは飛び降りるのか？"}, {"type": "subtitle", "time": 10309.11, "timestamp": "02:51:49", "text": "つまり、水があるってことだ。つまり、私は"}, {"type": "subtitle", "time": 10310.95, "timestamp": "02:51:50", "text": "水があるという意味ですが、私たちはどこに"}, {"type": "subtitle", "time": 10314.309, "timestamp": "02:51:54", "text": "ジャンプ？階段とかもあるよ。おお、"}, {"type": "subtitle", "time": 10319.19, "timestamp": "02:51:59", "text": "あなたは死んだのですか？死ななくて本当に良かった。"}]
[{"type": "subtitle", "time": 8523.99, "timestamp": "02:22:03", "text": "12時間連続配信をしたい。楽しいけど"}, {"type": "subtitle", "time": 8532.389, "timestamp": "02:22:12", "text": "ああ、笑わないでくれ。ああ、私は"}, {"type": "subtitle", "time": 8535.03, "timestamp": "02:22:15", "text": "それを実行する。"}, {"type": "subtitle", "time": 8537.27, "timestamp": "02:22:17", "text": "ストリーミングはこれ以上長くしてはいけません"}, {"type": "subtitle", "time": 8539.83, "timestamp": "02:22:19", "text": "そうしたい。"}, {"type": "subtitle", "time": 8545.03, "timestamp": "02:22:25", "text": "だから、そう、憎しみは変化をもたらした。"}, {"type": "subtitle", "time": 8547.03, "timestamp": "02:22:27", "text": "わかった、いいよ。"}, {"type": "subtitle", "time": 8553.75, "timestamp": "02:22:33", "text": "私はストリーミング配信しすぎているのではないかと考えています"}, {"type": "subtitle", "time": 8556.63, "timestamp": "02:22:36", "text": "時間の無駄だ。実際に置きたい"}, {"type": "subtitle", "time": 8560.15, "timestamp": "02:22:40", "text": "物作りに費やす時間"}, {"type": "subtitle", "time": 8563.75, "timestamp": "02:22:43", "text": "配信か何かのために。"}, {"type": "subtitle", "time": 8568.55, "timestamp": "02:22:48", "text": "でも、オカ、君のえーと"}, {"type": "subtitle", "time": 8571.429, "timestamp": "02:22:51", "text": "提案"}, {"type": "subtitle", "time": 8574.23, "timestamp": "02:22:54", "text": "えーと"}, {"type": "subtitle", "time": 8577.75, "timestamp": "02:22:57", "text": "やってみて。こんにちは、もう長すぎません"}]
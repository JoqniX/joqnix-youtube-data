[{"type": "subtitle", "time": 17880.23, "timestamp": "04:58:00", "text": "我が神よ。そして、レイがいる。彼は数えられている。"}, {"type": "subtitle", "time": 17881.99, "timestamp": "04:58:01", "text": "サーバーオーナーはいるが、"}, {"type": "subtitle", "time": 17885.59, "timestamp": "04:58:05", "text": "オペレーターになることは許可されていますか？ふむ。彼はただ"}, {"type": "subtitle", "time": 17886.868, "timestamp": "04:58:06", "text": "サーバー内の普通のプレイヤー"}, {"type": "subtitle", "time": 17888.39, "timestamp": "04:58:08", "text": "その他。よし。彼はアクセスできる"}, {"type": "subtitle", "time": 17891.51, "timestamp": "04:58:11", "text": "プラグイン、ログ、サーバーのオン/オフ"}, {"type": "subtitle", "time": 17893.83, "timestamp": "04:58:13", "text": "のみ。彼は世界ファイルにもアクセスできる"}, {"type": "subtitle", "time": 17895.43, "timestamp": "04:58:15", "text": "しかしそれはプラグインの設定と"}, {"type": "subtitle", "time": 17897.67, "timestamp": "04:58:17", "text": "世界のバックアップ。コード3のみ許可されています"}, {"type": "subtitle", "time": 17899.43, "timestamp": "04:58:19", "text": "サーバー上でオペレーター操作を実行します。"}, {"type": "subtitle", "time": 17903.11, "timestamp": "04:58:23", "text": "いいえ、サーバーに表示することは許可されていません"}, {"type": "subtitle", "time": 17905.03, "timestamp": "04:58:25", "text": "彼はサーバーオペレーターなので、"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "クリエイティブインベントリからアイテムを入手したり、"}, {"type": "subtitle", "time": 17909.75, "timestamp": "04:58:29", "text": "コメントを簡単に"}, {"type": "subtitle", "time": 17913.43, "timestamp": "04:58:33", "text": "不正行為とみなされる。うん。参加できます"}, {"type": "subtitle", "time": 17915.67, "timestamp": "04:58:35", "text": "彼が望むなら、しかし彼はオペレーターを持たないだろう"}, {"type": "subtitle", "time": 17917.67, "timestamp": "04:58:37", "text": "そうしながら。"}, {"type": "subtitle", "time": 17931.03, "timestamp": "04:58:51", "text": "男。それはとても懐かしい、"}, {"type": "subtitle", "time": 17933.03, "timestamp": "04:58:53", "text": "男。"}, {"type": "subtitle", "time": 17936.85, "timestamp": "04:58:56", "text": "そうそう。全部。"}, {"type": "subtitle", "time": 17938.868, "timestamp": "04:58:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 11822.309, "timestamp": "03:17:02", "text": "うん、これはうん、この大きな"}, {"type": "subtitle", "time": 11824.87, "timestamp": "03:17:04", "text": "ストレージ。満員ではありません。"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "そう、あのたくさんのおもちゃ。これは"}, {"type": "subtitle", "time": 11831.19, "timestamp": "03:17:11", "text": "レイの自動車からの二次ストレージ"}, {"type": "subtitle", "time": 11837.51, "timestamp": "03:17:17", "text": "私たちは以前はお互いのリソースを共有していました"}, {"type": "subtitle", "time": 11839.99, "timestamp": "03:17:19", "text": "基地内の貯蔵庫。"}, {"type": "subtitle", "time": 11841.63, "timestamp": "03:17:21", "text": "何てことだ。"}, {"type": "subtitle", "time": 11843.429, "timestamp": "03:17:23", "text": "[音楽]"}, {"type": "subtitle", "time": 11845.83, "timestamp": "03:17:25", "text": "ニコ。"}, {"type": "subtitle", "time": 11848.79, "timestamp": "03:17:28", "text": "わかった。あなたはこれを彼女に渡しました。そこには"}, {"type": "subtitle", "time": 11851.429, "timestamp": "03:17:31", "text": "空の。彼女はそれを受け取ったと思う。"}, {"type": "subtitle", "time": 11856.79, "timestamp": "03:17:36", "text": "うん。彼女がそれを受け取ったと思う。うん。"}, {"type": "subtitle", "time": 11859.59, "timestamp": "03:17:39", "text": "あなたとは違ってね。"}, {"type": "subtitle", "time": 11864.309, "timestamp": "03:17:44", "text": "いいえ、私はそれをそのままにしておきました"}, {"type": "subtitle", "time": 11866.229, "timestamp": "03:17:46", "text": "推測"}, {"type": "subtitle", "time": 11867.83, "timestamp": "03:17:47", "text": "もっと。"}, {"type": "subtitle", "time": 11871.19, "timestamp": "03:17:51", "text": "ああ、なんて無秩序なんだ"}]
[{"type": "subtitle", "time": 7562.87, "timestamp": "02:06:02", "text": "できません。ああ、それは"}, {"type": "subtitle", "time": 7564.52, "timestamp": "02:06:04", "text": "ああ、これ。"}, {"type": "subtitle", "time": 7568.629, "timestamp": "02:06:08", "text": "[音楽]"}, {"type": "subtitle", "time": 7571.35, "timestamp": "02:06:11", "text": "ええと、そうですね、ニュー"}, {"type": "subtitle", "time": 7573.589, "timestamp": "02:06:13", "text": "世界。ええ、ニューは久しぶりですね"}, {"type": "subtitle", "time": 7576.79, "timestamp": "02:06:16", "text": "ワールドと私は一緒に遊ぶ仲間がいる"}, {"type": "subtitle", "time": 7580.47, "timestamp": "02:06:20", "text": "今すぐ。ええと、アーバンナイト。それは"}, {"type": "subtitle", "time": 7582.95, "timestamp": "02:06:22", "text": "Urban Knightをプレイしてからしばらく経ちました。"}, {"type": "subtitle", "time": 7588.39, "timestamp": "02:06:28", "text": "ええ、そうですね。彼のサーバーに参加します。"}, {"type": "subtitle", "time": 7590.47, "timestamp": "02:06:30", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 7593.99, "timestamp": "02:06:33", "text": "えっと、彼のサーバーはAPにあります"}, {"type": "subtitle", "time": 7597.51, "timestamp": "02:06:37", "text": "新世界の南東部。ええ、そうします"}, {"type": "subtitle", "time": 7599.669, "timestamp": "02:06:39", "text": "内側から死んでいく。お前はわがままな奴になるだろう"}]
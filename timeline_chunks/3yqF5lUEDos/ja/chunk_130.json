[{"type": "subtitle", "time": 7801.99, "timestamp": "02:10:01", "text": "そのゲームは、"}, {"type": "subtitle", "time": 7804.149, "timestamp": "02:10:04", "text": "あなたのような人たち、ミス・メッシ。私は推測する"}, {"type": "subtitle", "time": 7807.109, "timestamp": "02:10:07", "text": "それはあなたにも起こり得ることです。うん、"}, {"type": "subtitle", "time": 7809.51, "timestamp": "02:10:09", "text": "サリー。うん、"}, {"type": "subtitle", "time": 7812.709, "timestamp": "02:10:12", "text": "私は誤報に関する詳細な夢を見た。"}, {"type": "subtitle", "time": 7816.47, "timestamp": "02:10:16", "text": "それで、Markiplier を見たんだけど、"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "Markiplier Jaccept の男がプレイしたのか"}, {"type": "subtitle", "time": 7823.51, "timestamp": "02:10:23", "text": "ゲーム？それから私はモウズモウズを見た"}, {"type": "subtitle", "time": 7827.27, "timestamp": "02:10:27", "text": "それと他の人のゲームプレイと私"}, {"type": "subtitle", "time": 7829.35, "timestamp": "02:10:29", "text": "まるで"}, {"type": "subtitle", "time": 7831.91, "timestamp": "02:10:31", "text": "その日"}, {"type": "subtitle", "time": 7835.669, "timestamp": "02:10:35", "text": "えっと、それは深い夢だった、違った"}, {"type": "subtitle", "time": 7838.39, "timestamp": "02:10:38", "text": "生死のさまざまなシナリオ"}, {"type": "subtitle", "time": 7840.79, "timestamp": "02:10:40", "text": "そして全て。あなたがすべきことすべて"}, {"type": "subtitle", "time": 7843.189, "timestamp": "02:10:43", "text": "DDLCをクリアする。はい、それは起こるでしょう"}, {"type": "subtitle", "time": 7845.51, "timestamp": "02:10:45", "text": "今週。ええと、DLCをやります"}, {"type": "subtitle", "time": 7847.27, "timestamp": "02:10:47", "text": "終了。"}, {"type": "subtitle", "time": 7851.35, "timestamp": "02:10:51", "text": "私の秘密のゲストは、えっと、私の秘密のゲストです"}, {"type": "subtitle", "time": 7854.95, "timestamp": "02:10:54", "text": "今週のDLCはまだ"}, {"type": "subtitle", "time": 7857.99, "timestamp": "02:10:57", "text": "秘密。そう、その後は"}]
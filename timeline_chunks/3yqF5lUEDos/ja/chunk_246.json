[{"type": "subtitle", "time": 14766.389, "timestamp": "04:06:06", "text": "MSの施設に行けたらいいのに。"}, {"type": "subtitle", "time": 14769.75, "timestamp": "04:06:09", "text": "構造物か何かを作ったと思う"}, {"type": "subtitle", "time": 14772.87, "timestamp": "04:06:12", "text": "あちらでも。うん、"}, {"type": "subtitle", "time": 14775.83, "timestamp": "04:06:15", "text": "オブリジウムで何かを作った。"}, {"type": "subtitle", "time": 14779.429, "timestamp": "04:06:19", "text": "うん。うん。ええ、そうしましたよ。"}, {"type": "subtitle", "time": 14783.11, "timestamp": "04:06:23", "text": "えっと、その場所をどうやって見つけるか。"}, {"type": "subtitle", "time": 14785.429, "timestamp": "04:06:25", "text": "メインの場所に戻りましょう、"}, {"type": "subtitle", "time": 14788.87, "timestamp": "04:06:28", "text": "推測。うん。"}, {"type": "subtitle", "time": 14791.429, "timestamp": "04:06:31", "text": "スポーン地点へテレポートする。クマ。これは何ですか"}, {"type": "subtitle", "time": 14793.11, "timestamp": "04:06:33", "text": "奇妙な装置？待って、これは待って、"}, {"type": "subtitle", "time": 14795.75, "timestamp": "04:06:35", "text": "これじゃないの？いいえ、これは"}, {"type": "subtitle", "time": 14797.99, "timestamp": "04:06:37", "text": "村。"}, {"type": "subtitle", "time": 14800.15, "timestamp": "04:06:40", "text": "ああ、"}, {"type": "subtitle", "time": 14803.51, "timestamp": "04:06:43", "text": "実際に見つけたと思ったのですが、"}, {"type": "subtitle", "time": 14806.309, "timestamp": "04:06:46", "text": "砂の村。あれは村だ。私は言った"}, {"type": "subtitle", "time": 14809.59, "timestamp": "04:06:49", "text": "村。そうそう。私も覚えています"}, {"type": "subtitle", "time": 14815.99, "timestamp": "04:06:55", "text": "長い村ですね。はるか遠くへ。"}]
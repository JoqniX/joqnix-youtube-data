[{"type": "subtitle", "time": 7622.069, "timestamp": "02:07:02", "text": "私は何をしているのだろう？彼がそうしないことを願う"}, {"type": "subtitle", "time": 7623.21, "timestamp": "02:07:03", "text": "それ。"}, {"type": "subtitle", "time": 7629.23, "timestamp": "02:07:09", "text": "彼は行儀よくするだろう。"}, {"type": "subtitle", "time": 7630.709, "timestamp": "02:07:10", "text": "[音楽]"}, {"type": "subtitle", "time": 7633.83, "timestamp": "02:07:13", "text": "そうだろ、犬？えっと、"}, {"type": "subtitle", "time": 7636.95, "timestamp": "02:07:16", "text": "はい。多分"}, {"type": "subtitle", "time": 7639.35, "timestamp": "02:07:19", "text": "はい。"}, {"type": "subtitle", "time": 7641.109, "timestamp": "02:07:21", "text": "うん、"}, {"type": "subtitle", "time": 7644.229, "timestamp": "02:07:24", "text": "これはゲームに関するジョークです。いつ？ええと、それは"}, {"type": "subtitle", "time": 7646.87, "timestamp": "02:07:26", "text": "おそらく月曜日かその頃になるでしょう。"}, {"type": "subtitle", "time": 7650.95, "timestamp": "02:07:30", "text": "質問させてください。私はサジュを買う必要があるだけです"}, {"type": "subtitle", "time": 7657.35, "timestamp": "02:07:37", "text": "そう、ピクセルゲームだよ。ピクセルがいくつか"}, {"type": "subtitle", "time": 7659.99, "timestamp": "02:07:39", "text": "SteamとEpic Gamesでプレイしているピクセルゲーム"}, {"type": "subtitle", "time": 7662.79, "timestamp": "02:07:42", "text": "ゲーム。それらなら演奏できるよ。それは"}, {"type": "subtitle", "time": 7665.83, "timestamp": "02:07:45", "text": "私がコードスペルをプレイして以来。"}, {"type": "subtitle", "time": 7668.31, "timestamp": "02:07:48", "text": "双子。ああ、ツインシラはゲームの一つです"}, {"type": "subtitle", "time": 7670.87, "timestamp": "02:07:50", "text": "一緒に遊べるよ。ホロウナイト。 1つ目"}, {"type": "subtitle", "time": 7679.43, "timestamp": "02:07:59", "text": "スターではなく、一人の男。 H ディーパーソード。それは"}]
[{"type": "subtitle", "time": 20100.15, "timestamp": "05:35:00", "text": "どうやって締めくくったの？こんにちは。こんにちは。私も包む"}, {"type": "subtitle", "time": 20102.948, "timestamp": "05:35:02", "text": "上には"}, {"type": "subtitle", "time": 20106.39, "timestamp": "05:35:06", "text": "シャ。えっと、次の配信は"}, {"type": "subtitle", "time": 20108.548, "timestamp": "05:35:08", "text": "明日。明日は試合をします"}, {"type": "subtitle", "time": 20111.51, "timestamp": "05:35:11", "text": "私たちは一体何をプレイしているんだっけ？何てことだ。えっと"}, {"type": "subtitle", "time": 20114.07, "timestamp": "05:35:14", "text": "神様のことを忘れていました。ええと、明日私たちは"}, {"type": "subtitle", "time": 20117.03, "timestamp": "05:35:17", "text": "えっと、原神をプレイしています。"}, {"type": "subtitle", "time": 20119.67, "timestamp": "05:35:19", "text": "インパクト。"}, {"type": "subtitle", "time": 20122.31, "timestamp": "05:35:22", "text": "うん、1回プレイしたらそのゲームに触ってみるよ"}, {"type": "subtitle", "time": 20125.75, "timestamp": "05:35:25", "text": "たぶん1年かな。 1年"}, {"type": "subtitle", "time": 20128.23, "timestamp": "05:35:28", "text": "3～4ヶ月。うん。うん。うん。"}, {"type": "subtitle", "time": 20131.43, "timestamp": "05:35:31", "text": "何てことだ。痛み。"}, {"type": "subtitle", "time": 20133.43, "timestamp": "05:35:33", "text": "こんにちは。ゲンジンについては"}, {"type": "subtitle", "time": 20135.43, "timestamp": "05:35:35", "text": "長い間。"}, {"type": "subtitle", "time": 20137.43, "timestamp": "05:35:37", "text": "わかった。私を代弁者として自由にお使いください"}, {"type": "subtitle", "time": 20139.83, "timestamp": "05:35:39", "text": "アーティスト。"}, {"type": "subtitle", "time": 20142.628, "timestamp": "05:35:42", "text": "うん。うん、来てもいいよ。私は"}, {"type": "subtitle", "time": 20144.548, "timestamp": "05:35:44", "text": "主にアオンのクエストをクリアしようとしている"}, {"type": "subtitle", "time": 20148.31, "timestamp": "05:35:48", "text": "そして、フォンティーヌに行けるように全て準備しました。"}, {"type": "subtitle", "time": 20150.628, "timestamp": "05:35:50", "text": "じゃあ、フォンテーヌに行ってもいいよ"}, {"type": "subtitle", "time": 20153.75, "timestamp": "05:35:53", "text": "キルはなかったけど、うん、君の、ああ、君"}, {"type": "subtitle", "time": 20158.15, "timestamp": "05:35:58", "text": "できる。おお。そうそう。ニース。ニース。それから私は"}]
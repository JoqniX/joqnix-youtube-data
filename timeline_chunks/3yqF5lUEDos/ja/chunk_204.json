[{"type": "subtitle", "time": 12251.269, "timestamp": "03:24:11", "text": "私もそれを受け取った。ニース。ああ、待って。"}, {"type": "subtitle", "time": 12255.91, "timestamp": "03:24:15", "text": "そうそう。ここは場所の入り口です。"}, {"type": "subtitle", "time": 12258.309, "timestamp": "03:24:18", "text": "どうして忘れられるだろうか"}, {"type": "subtitle", "time": 12280.15, "timestamp": "03:24:40", "text": "何？ミック・ミコンがここにいます。"}, {"type": "subtitle", "time": 12283.51, "timestamp": "03:24:43", "text": "ああ、ミク。うん。こんにちは、ミク。あなたは"}, {"type": "subtitle", "time": 12285.51, "timestamp": "03:24:45", "text": "話は、"}, {"type": "subtitle", "time": 12287.99, "timestamp": "03:24:47", "text": "あなたが知っている、"}, {"type": "subtitle", "time": 12290.469, "timestamp": "03:24:50", "text": "そうそう。"}, {"type": "subtitle", "time": 12294.87, "timestamp": "03:24:54", "text": "私たちはどこからともなくそれらを生み出すのが好きです。"}, {"type": "subtitle", "time": 12297.03, "timestamp": "03:24:57", "text": "うん。"}]
[{"type": "subtitle", "time": 20522.708, "timestamp": "05:42:02", "text": "えーと、オンライン講座とか授業とか。私"}, {"type": "subtitle", "time": 20525.27, "timestamp": "05:42:05", "text": "君がミュージックダッシュをプレイしているのを見ていたよ。そうだった"}, {"type": "subtitle", "time": 20526.788, "timestamp": "05:42:06", "text": "楽しい。"}, {"type": "subtitle", "time": 20529.75, "timestamp": "05:42:09", "text": "というわけで、幸運を祈ります。そして、"}, {"type": "subtitle", "time": 20531.75, "timestamp": "05:42:11", "text": "通りかかるよ。"}, {"type": "subtitle", "time": 20533.91, "timestamp": "05:42:13", "text": "うん、"}, {"type": "subtitle", "time": 20535.67, "timestamp": "05:42:15", "text": "マインクラフトで遊ぶのが好きです"}, {"type": "subtitle", "time": 20538.15, "timestamp": "05:42:18", "text": "いつか。"}, {"type": "subtitle", "time": 20541.43, "timestamp": "05:42:21", "text": "そして今日、ヴァマがやって来た。"}, {"type": "subtitle", "time": 20544.47, "timestamp": "05:42:24", "text": "本日もお越しいただき、ありがとうございました。私"}, {"type": "subtitle", "time": 20546.948, "timestamp": "05:42:26", "text": "今日は楽しんでいただけたでしょうか。ありがとう。それから"}, {"type": "subtitle", "time": 20549.27, "timestamp": "05:42:29", "text": "最後に、そして最も重要なこととして、特別な"}, {"type": "subtitle", "time": 20551.99, "timestamp": "05:42:31", "text": "特別な感謝とたくさんの"}, {"type": "subtitle", "time": 20556.15, "timestamp": "05:42:36", "text": "イサマに行くためのハートとヘッドパッチ"}, {"type": "subtitle", "time": 20558.83, "timestamp": "05:42:38", "text": "は"}, {"type": "subtitle", "time": 20565.43, "timestamp": "05:42:45", "text": "このコラボレーションを招待し、提案する。"}, {"type": "subtitle", "time": 20568.15, "timestamp": "05:42:48", "text": "私たちは長い間コラボレーションしたいと思っていました"}, {"type": "subtitle", "time": 20571.83, "timestamp": "05:42:51", "text": "その間。計画や仕事で、"}, {"type": "subtitle", "time": 20574.47, "timestamp": "05:42:54", "text": "ついに、まるでコラボレーションする運命だったかのように"}, {"type": "subtitle", "time": 20578.628, "timestamp": "05:42:58", "text": "先週のことだけど、アルシャマのPCは"}]
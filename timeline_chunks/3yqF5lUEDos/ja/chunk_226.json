[{"type": "subtitle", "time": 13569.11, "timestamp": "03:46:09", "text": "あ、待って。あなたは弓を持っています。ニース。"}, {"type": "subtitle", "time": 13572.309, "timestamp": "03:46:12", "text": "でも、弁護士かな。"}, {"type": "subtitle", "time": 13575.51, "timestamp": "03:46:15", "text": "ああ、私はあなたの炎を集めることができる。"}, {"type": "subtitle", "time": 13578.15, "timestamp": "03:46:18", "text": "ああ、つまり同じメカニズムなんですね"}, {"type": "subtitle", "time": 13580.389, "timestamp": "03:46:20", "text": "ヴァレラント。それは以下に適用できると言えます"}, {"type": "subtitle", "time": 13583.349, "timestamp": "03:46:23", "text": "他の"}, {"type": "subtitle", "time": 13599.51, "timestamp": "03:46:39", "text": "よし、ゲームは変わり続ける"}, {"type": "subtitle", "time": 13602.07, "timestamp": "03:46:42", "text": "自体。もしそうなら、"}, {"type": "subtitle", "time": 13607.429, "timestamp": "03:46:47", "text": "ゲーム設定は、設定ファイルにあります。"}, {"type": "subtitle", "time": 13609.75, "timestamp": "03:46:49", "text": "読み取り専用じゃないといいんだけど。"}, {"type": "subtitle", "time": 13612.229, "timestamp": "03:46:52", "text": "読み書き可能であることを確認してください。"}, {"type": "subtitle", "time": 13615.99, "timestamp": "03:46:55", "text": "私にとって私のゲームは自動的に"}, {"type": "subtitle", "time": 13617.83, "timestamp": "03:46:57", "text": "起動時にフルスクリーンにすると、"}]
[{"type": "subtitle", "time": 4740.55, "timestamp": "01:19:00", "text": "変化？"}, {"type": "subtitle", "time": 4745.189, "timestamp": "01:19:05", "text": "ああ、あれね。それを忘れていました。"}, {"type": "subtitle", "time": 4748.07, "timestamp": "01:19:08", "text": "ああ、このスポーツマンをどうしたらいいんだろう？ああ、"}, {"type": "subtitle", "time": 4750.07, "timestamp": "01:19:10", "text": "神。"}, {"type": "subtitle", "time": 4753.91, "timestamp": "01:19:13", "text": "丸太のチェロはもうどうしたらいいんだろう？私"}, {"type": "subtitle", "time": 4756.47, "timestamp": "01:19:16", "text": "チェロの記録をつけなければならない。"}, {"type": "subtitle", "time": 4758.47, "timestamp": "01:19:18", "text": "ああ、"}, {"type": "subtitle", "time": 4771.43, "timestamp": "01:19:31", "text": "これは、いわゆる「後部座席でゲームをする人」の一人ですか？"}, {"type": "subtitle", "time": 4773.83, "timestamp": "01:19:33", "text": "どれ？"}, {"type": "subtitle", "time": 4791.35, "timestamp": "01:19:51", "text": "お前はオニキスチームの一員だ、バカ。"}, {"type": "subtitle", "time": 4795.83, "timestamp": "01:19:55", "text": "君はONXチームの一員だ、バカ、バカ"}, {"type": "subtitle", "time": 4797.669, "timestamp": "01:19:57", "text": "そうですね"}]
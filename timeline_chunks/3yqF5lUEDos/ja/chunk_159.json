[{"type": "subtitle", "time": 9540.469, "timestamp": "02:39:00", "text": "わかった。何があるのか​​見てみましょう。がある"}, {"type": "subtitle", "time": 9542.309, "timestamp": "02:39:02", "text": "たくさんのブロック。もっと取れば"}, {"type": "subtitle", "time": 9548.71, "timestamp": "02:39:08", "text": "数スタック欲しい。そして私は"}, {"type": "subtitle", "time": 9552.79, "timestamp": "02:39:12", "text": "ダイヤモンドピック。わかった。私は自分の"}, {"type": "subtitle", "time": 9554.63, "timestamp": "02:39:14", "text": "古い"}, {"type": "subtitle", "time": 9558.95, "timestamp": "02:39:18", "text": "ええ、これはまさにこの弓に似ています。"}, {"type": "subtitle", "time": 9561.349, "timestamp": "02:39:21", "text": "そうそう。無限"}, {"type": "subtitle", "time": 9566.389, "timestamp": "02:39:26", "text": "そして、こちら。ああ、そうだ。"}, {"type": "subtitle", "time": 9568.95, "timestamp": "02:39:28", "text": "うん。"}, {"type": "subtitle", "time": 9572.79, "timestamp": "02:39:32", "text": "いいえ。ええ。"}, {"type": "subtitle", "time": 9579.75, "timestamp": "02:39:39", "text": "よし、じゃあ剣を抜くよ。"}, {"type": "subtitle", "time": 9582.87, "timestamp": "02:39:42", "text": "わかった。ああ、剣を持って行け。"}, {"type": "subtitle", "time": 9584.71, "timestamp": "02:39:44", "text": "ご希望であれば、クリエイティブな"}, {"type": "subtitle", "time": 9586.07, "timestamp": "02:39:46", "text": "でも、今のところは、"}, {"type": "subtitle", "time": 9590.469, "timestamp": "02:39:50", "text": "サバイバルモードに入る予定です。はい。"}, {"type": "subtitle", "time": 9597.03, "timestamp": "02:39:57", "text": "飛び降りる。こんにちは。私たちは"}, {"type": "subtitle", "time": 9598.79, "timestamp": "02:39:58", "text": "正面玄関。"}]
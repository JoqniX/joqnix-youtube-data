[{"type": "subtitle", "time": 20702.23, "timestamp": "05:45:02", "text": "辛抱強く。私は幸せですが"}, {"type": "subtitle", "time": 20703.99, "timestamp": "05:45:03", "text": "私はこれから"}, {"type": "subtitle", "time": 20707.35, "timestamp": "05:45:07", "text": "爆発するけど、それでも、私は待つよ"}, {"type": "subtitle", "time": 20712.07, "timestamp": "05:45:12", "text": "来月か、遅くとも10月までには必ず。"}, {"type": "subtitle", "time": 20717.99, "timestamp": "05:45:17", "text": "ええ、出席者全員です"}, {"type": "subtitle", "time": 20720.788, "timestamp": "05:45:20", "text": "今日。皆さん、お越しいただきありがとうございました。"}, {"type": "subtitle", "time": 20723.83, "timestamp": "05:45:23", "text": "今日までに。そして、私は"}, {"type": "subtitle", "time": 20728.948, "timestamp": "05:45:28", "text": "明日YouTubeで配信します。えっと、"}, {"type": "subtitle", "time": 20731.51, "timestamp": "05:45:31", "text": "皆さんにお会いできるのを楽しみにしています。えっと、マークしてください"}, {"type": "subtitle", "time": 20734.15, "timestamp": "05:45:34", "text": "あなたのカレンダー。 Googleで調べると、"}, {"type": "subtitle", "time": 20736.628, "timestamp": "05:45:36", "text": "Googleカレンダーを更新しました。えっと"}, {"type": "subtitle", "time": 20738.708, "timestamp": "05:45:38", "text": "Googleをご利用の方へのリマインダー"}, {"type": "subtitle", "time": 20742.39, "timestamp": "05:45:42", "text": "カレンダー。通知は保存しません"}, {"type": "subtitle", "time": 20745.59, "timestamp": "05:45:45", "text": "全くリマインダーではありません。通知はありません。"}, {"type": "subtitle", "time": 20748.15, "timestamp": "05:45:48", "text": "あなたは私の"}, {"type": "subtitle", "time": 20751.59, "timestamp": "05:45:51", "text": "ドキュメント配信のスケジュール。次に"}, {"type": "subtitle", "time": 20753.75, "timestamp": "05:45:53", "text": "手動通知機能（5番など）"}, {"type": "subtitle", "time": 20755.99, "timestamp": "05:45:55", "text": "数分前または15分前"}]
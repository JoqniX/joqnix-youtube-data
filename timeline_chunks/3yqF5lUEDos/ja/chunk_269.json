[{"type": "subtitle", "time": 16140.07, "timestamp": "04:29:00", "text": "そうそう。"}, {"type": "subtitle", "time": 16150.469, "timestamp": "04:29:10", "text": "どうやって？どうやって中に入ったの？"}, {"type": "subtitle", "time": 16153.11, "timestamp": "04:29:13", "text": "この場所？"}, {"type": "subtitle", "time": 16164.87, "timestamp": "04:29:24", "text": "何？私は何をしたのか"}, {"type": "subtitle", "time": 16169.03, "timestamp": "04:29:29", "text": "何が壊れたのですか？いいえ、私は示しました"}, {"type": "subtitle", "time": 16171.99, "timestamp": "04:29:31", "text": "誤ってDiscordのDMを送信してしまった。ああ、私は"}, {"type": "subtitle", "time": 16174.87, "timestamp": "04:29:34", "text": "ストリーマーモードをオンにしようとしています。"}, {"type": "subtitle", "time": 16177.99, "timestamp": "04:29:37", "text": "私は本当にバカだ。"}, {"type": "subtitle", "time": 16182.55, "timestamp": "04:29:42", "text": "大丈夫。見るべきものは何もない。"}, {"type": "subtitle", "time": 16193.03, "timestamp": "04:29:53", "text": "えっと、どうやって降りてくるんですか？"}, {"type": "subtitle", "time": 16196.79, "timestamp": "04:29:56", "text": "エレベーターがあります。知っている。"}]
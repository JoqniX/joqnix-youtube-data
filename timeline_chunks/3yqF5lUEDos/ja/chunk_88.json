[{"type": "subtitle", "time": 5301.669, "timestamp": "01:28:21", "text": "明日は私の仕事日（日曜日）です。なんてこった、"}, {"type": "subtitle", "time": 5305.11, "timestamp": "01:28:25", "text": "あなたは日曜日に仕事があります。それは残念だ。"}, {"type": "subtitle", "time": 5306.95, "timestamp": "01:28:26", "text": "おお、"}, {"type": "subtitle", "time": 5310.79, "timestamp": "01:28:30", "text": "バカ。あなたは本当に一生懸命働いていますね。"}, {"type": "subtitle", "time": 5319.99, "timestamp": "01:28:39", "text": "この働き者のバカ。"}, {"type": "subtitle", "time": 5323.11, "timestamp": "01:28:43", "text": "連合軍は現在、デルタ地区を掌握している。"}]
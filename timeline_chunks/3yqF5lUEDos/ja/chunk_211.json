[{"type": "subtitle", "time": 12662.07, "timestamp": "03:31:02", "text": "それは遠いですね。"}, {"type": "subtitle", "time": 12667.75, "timestamp": "03:31:07", "text": "うん。それから私は思い出した、えっと"}, {"type": "subtitle", "time": 12669.67, "timestamp": "03:31:09", "text": "さまざまなものを見つけようとしています"}, {"type": "subtitle", "time": 12672.15, "timestamp": "03:31:12", "text": "場所。私は地図とその他諸々を使いました"}, {"type": "subtitle", "time": 12674.55, "timestamp": "03:31:14", "text": "座標"}, {"type": "subtitle", "time": 12676.95, "timestamp": "03:31:16", "text": "キノコの場所を見つけて"}, {"type": "subtitle", "time": 12680.07, "timestamp": "03:31:20", "text": "牛とかそういうもの。"}, {"type": "subtitle", "time": 12691.269, "timestamp": "03:31:31", "text": "もし今電気があれば"}, {"type": "subtitle", "time": 12692.71, "timestamp": "03:31:32", "text": "ええ、メインにエレクトラがありました"}, {"type": "subtitle", "time": 12694.389, "timestamp": "03:31:34", "text": "アカウント。"}, {"type": "subtitle", "time": 12697.429, "timestamp": "03:31:37", "text": "うん。わかった。さあ、フェスティバルへ。"}, {"type": "subtitle", "time": 12701.269, "timestamp": "03:31:41", "text": "側。はい、お祭りです。私にはそうは見えません。"}, {"type": "subtitle", "time": 12703.99, "timestamp": "03:31:43", "text": "ああ、あの大きなボールを覚えているよ。"}, {"type": "subtitle", "time": 12706.469, "timestamp": "03:31:46", "text": "何か。何てことだ。私とミクは"}, {"type": "subtitle", "time": 12709.03, "timestamp": "03:31:49", "text": "互いに競い合うように"}, {"type": "subtitle", "time": 12714.15, "timestamp": "03:31:54", "text": "もの。何てことだ。覚えていますよ。うん。"}, {"type": "subtitle", "time": 12719.03, "timestamp": "03:31:59", "text": "ああ、なんてことだ。思い出。わかった。やった やった"}]
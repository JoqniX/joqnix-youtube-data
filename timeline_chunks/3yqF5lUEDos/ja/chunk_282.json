[{"type": "subtitle", "time": 16920.788, "timestamp": "04:42:00", "text": "ああ、これが最後の思い出だ"}, {"type": "subtitle", "time": 16925.27, "timestamp": "04:42:05", "text": "永遠に。ええ、配信を見ることができますよ。"}, {"type": "subtitle", "time": 16929.11, "timestamp": "04:42:09", "text": "うん。新しい未来と終わりに乾杯"}, {"type": "subtitle", "time": 16932.39, "timestamp": "04:42:12", "text": "私たち。我々は始めよう。"}, {"type": "subtitle", "time": 16936.788, "timestamp": "04:42:16", "text": "うん。花。花を飾ったら。おお"}, {"type": "subtitle", "time": 16939.83, "timestamp": "04:42:19", "text": "我が神よ。"}, {"type": "subtitle", "time": 16941.43, "timestamp": "04:42:21", "text": "アイロンがけのカット。これがどこなのかわかりません"}, {"type": "subtitle", "time": 16944.23, "timestamp": "04:42:24", "text": "どこから来たのかはさておき、さあ始めましょう。"}, {"type": "subtitle", "time": 16946.23, "timestamp": "04:42:26", "text": "そして、私にはできない。これはどうでしょう？何"}, {"type": "subtitle", "time": 16948.788, "timestamp": "04:42:28", "text": "これ、どうすればいいでしょうか？"}, {"type": "subtitle", "time": 16954.948, "timestamp": "04:42:34", "text": "これをあなたに投げかけます。あ、待って。"}, {"type": "subtitle", "time": 16960.39, "timestamp": "04:42:40", "text": "えっと、それから胸も。"}, {"type": "subtitle", "time": 16964.81, "timestamp": "04:42:44", "text": "ああ、大きなものが必要なんです。"}, {"type": "subtitle", "time": 16970.15, "timestamp": "04:42:50", "text": "[音楽]"}, {"type": "subtitle", "time": 16973.35, "timestamp": "04:42:53", "text": "うん。こんにちは、ニシャサさん。ようこそ、ようこそ、"}, {"type": "subtitle", "time": 16977.03, "timestamp": "04:42:57", "text": "いらっしゃいませ。うん。こんにちは。私たちは去っています"}, {"type": "subtitle", "time": 16979.27, "timestamp": "04:42:59", "text": "サーバーは永遠に、しかしこれはまだ"}]
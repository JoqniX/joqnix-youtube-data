[{"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "墓はあちこちに散らばってはならない。"}, {"type": "subtitle", "time": 13447.59, "timestamp": "03:44:07", "text": "ああ、わかった。 27."}, {"type": "subtitle", "time": 13451.349, "timestamp": "03:44:11", "text": "犬が去っていくのが見えた。"}, {"type": "subtitle", "time": 13454.63, "timestamp": "03:44:14", "text": "だから、私はすぐに死んだ"}, {"type": "subtitle", "time": 13458.229, "timestamp": "03:44:18", "text": "そこには。分かりますよ。分かりますよ。手に入れよう"}, {"type": "subtitle", "time": 13462.389, "timestamp": "03:44:22", "text": "アイテム。あなたをどこかへテレポートさせます。"}, {"type": "subtitle", "time": 13472.07, "timestamp": "03:44:32", "text": "わかった。"}, {"type": "subtitle", "time": 13480.63, "timestamp": "03:44:40", "text": "アディティ、今回は一体何があったの？何"}, {"type": "subtitle", "time": 13483.429, "timestamp": "03:44:43", "text": "麻を栽培していた時に何が起こったのですか？基本的に"}, {"type": "subtitle", "time": 13485.99, "timestamp": "03:44:45", "text": "1.5または1"}, {"type": "subtitle", "time": 13489.67, "timestamp": "03:44:49", "text": "そして、ここは壮大な場所だ。"}, {"type": "subtitle", "time": 13492.07, "timestamp": "03:44:52", "text": "どれ？そうそう。ここがその場所だ"}, {"type": "subtitle", "time": 13494.07, "timestamp": "03:44:54", "text": "私たちがここでこれは私があなたに言ったものです"}, {"type": "subtitle", "time": 13497.11, "timestamp": "03:44:57", "text": "について。私たちが雪の降る地域にいる場所です。私たちは"}, {"type": "subtitle", "time": 13499.51, "timestamp": "03:44:59", "text": "私たちは防御しようとしていましたが、私は何度も死んでしまいました"}]
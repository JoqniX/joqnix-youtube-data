[{"type": "subtitle", "time": 14522.15, "timestamp": "04:02:02", "text": "青、赤、そしてもうひとつ"}, {"type": "subtitle", "time": 14525.83, "timestamp": "04:02:05", "text": "色かな。すると、"}, {"type": "subtitle", "time": 14529.189, "timestamp": "04:02:09", "text": "終わりにたどり着くんだろうね。"}, {"type": "subtitle", "time": 14533.429, "timestamp": "04:02:13", "text": "私たちは別の場所に行って、"}, {"type": "subtitle", "time": 14537.75, "timestamp": "04:02:17", "text": "馬たちと私はここに馬たちを連れてきました。うん、"}, {"type": "subtitle", "time": 14540.71, "timestamp": "04:02:20", "text": "男。"}, {"type": "subtitle", "time": 14543.269, "timestamp": "04:02:23", "text": "道のりは長い。"}, {"type": "subtitle", "time": 14546.63, "timestamp": "04:02:26", "text": "まだついてきてくれている？はい。"}, {"type": "subtitle", "time": 14550.55, "timestamp": "04:02:30", "text": "青、赤、紫、そして素晴らしい。私"}, {"type": "subtitle", "time": 14552.95, "timestamp": "04:02:32", "text": "では、推測してみましょう"}, {"type": "subtitle", "time": 14555.99, "timestamp": "04:02:35", "text": "これは本当に長い道のりです。待って、どこ"}, {"type": "subtitle", "time": 14557.99, "timestamp": "04:02:37", "text": "あなたは？"}, {"type": "subtitle", "time": 14560.87, "timestamp": "04:02:40", "text": "あなたははるかに先を行っています。どうやって遠くへ行ったの？"}, {"type": "subtitle", "time": 14563.83, "timestamp": "04:02:43", "text": "先に？どうすればスピードアップできますか？えっと"}, {"type": "subtitle", "time": 14566.63, "timestamp": "04:02:46", "text": "えーっと、地面に着地して、走って、そう、"}, {"type": "subtitle", "time": 14570.87, "timestamp": "04:02:50", "text": "スペースキーを2回押してください。"}, {"type": "subtitle", "time": 14572.79, "timestamp": "04:02:52", "text": "私はここにいます。"}]
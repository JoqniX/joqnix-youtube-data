[{"type": "subtitle", "time": 11642.66, "timestamp": "03:14:02", "text": "冷蔵庫。何てことだ。"}, {"type": "subtitle", "time": 11644.469, "timestamp": "03:14:04", "text": "[音楽]"}, {"type": "subtitle", "time": 11654.55, "timestamp": "03:14:14", "text": "そして、あなたはロシア料理のあのやつ。おお"}, {"type": "subtitle", "time": 11656.87, "timestamp": "03:14:16", "text": "我が神よ。"}, {"type": "subtitle", "time": 11659.91, "timestamp": "03:14:19", "text": "私はとても優秀です。"}, {"type": "subtitle", "time": 11663.349, "timestamp": "03:14:23", "text": "屋上もあります"}, {"type": "subtitle", "time": 11666.389, "timestamp": "03:14:26", "text": "ここに鎧立てを置いてください。"}, {"type": "subtitle", "time": 11674.55, "timestamp": "03:14:34", "text": "屋上に行くこともできます"}, {"type": "subtitle", "time": 11676.95, "timestamp": "03:14:36", "text": "ここから。屋根はまだまだたくさんある。"}, {"type": "subtitle", "time": 11683.99, "timestamp": "03:14:43", "text": "これは本当に素晴らしいですね。"}, {"type": "subtitle", "time": 11686.79, "timestamp": "03:14:46", "text": "私たちは何をしたのか？私たちは何も行動を起こさなかった。"}, {"type": "subtitle", "time": 11689.59, "timestamp": "03:14:49", "text": "よし、農場を始めよう。"}, {"type": "subtitle", "time": 11691.83, "timestamp": "03:14:51", "text": "あれを見てください。それはヒュエルです。それはすごい"}, {"type": "subtitle", "time": 11694.229, "timestamp": "03:14:54", "text": "私のものより。"}]
[{"type": "subtitle", "time": 14041.67, "timestamp": "03:54:01", "text": "うん。私はあなたの家を利用したことを覚えています"}, {"type": "subtitle", "time": 14044.71, "timestamp": "03:54:04", "text": "ベッドとテレポートポイントとして"}, {"type": "subtitle", "time": 14047.75, "timestamp": "03:54:07", "text": "いろいろなものを探検していました"}, {"type": "subtitle", "time": 14050.71, "timestamp": "03:54:10", "text": "郊外。"}, {"type": "subtitle", "time": 14053.349, "timestamp": "03:54:13", "text": "うん。"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "何かやりたいことはありますか？"}, {"type": "subtitle", "time": 14067.91, "timestamp": "03:54:27", "text": "あるいは、しばらく話し合うこともできます"}, {"type": "subtitle", "time": 14069.67, "timestamp": "03:54:29", "text": "それから"}, {"type": "subtitle", "time": 14072.95, "timestamp": "03:54:32", "text": "ゲームを終了するのですか？はい、私たちもできます"}, {"type": "subtitle", "time": 14078.07, "timestamp": "03:54:38", "text": "わかった。"}, {"type": "subtitle", "time": 14082.55, "timestamp": "03:54:42", "text": "うん、オーケーで会おうって話に参加してるよ。"}, {"type": "subtitle", "time": 14084.229, "timestamp": "03:54:44", "text": "大邸宅。"}, {"type": "subtitle", "time": 14089.189, "timestamp": "03:54:49", "text": "あらら。ああ、それは乱闘だ。ご存知のとおり"}, {"type": "subtitle", "time": 14095.51, "timestamp": "03:54:55", "text": "溺死。"}, {"type": "subtitle", "time": 14099.03, "timestamp": "03:54:59", "text": "ああ、昔はよく死んでたよ。"}]
[{"type": "subtitle", "time": 12840.71, "timestamp": "03:34:00", "text": "[音楽]"}, {"type": "subtitle", "time": 12842.229, "timestamp": "03:34:02", "text": "くそ。"}, {"type": "subtitle", "time": 12844.79, "timestamp": "03:34:04", "text": "入場方法は？わかった。あなた"}, {"type": "subtitle", "time": 12848.229, "timestamp": "03:34:08", "text": "入り口を見つけて中に入った。"}, {"type": "subtitle", "time": 12851.03, "timestamp": "03:34:11", "text": "ここには何もない。見たかった"}, {"type": "subtitle", "time": 12852.71, "timestamp": "03:34:12", "text": "それ。"}, {"type": "subtitle", "time": 12855.11, "timestamp": "03:34:15", "text": "私は見たくない、どのように"}, {"type": "subtitle", "time": 12867.59, "timestamp": "03:34:27", "text": "[音楽]"}, {"type": "subtitle", "time": 12870.229, "timestamp": "03:34:30", "text": "それは良いことだ。"}, {"type": "subtitle", "time": 12873.67, "timestamp": "03:34:33", "text": "思い出。ああ、私たちがどこにいたか覚えてる？"}, {"type": "subtitle", "time": 12875.99, "timestamp": "03:34:35", "text": "まるでゴブリンみたいに戦っていた？ない"}, {"type": "subtitle", "time": 12879.67, "timestamp": "03:34:39", "text": "ゴブリン。ゴブリンはゾンビなどが好きです"}, {"type": "subtitle", "time": 12881.67, "timestamp": "03:34:41", "text": "雪。"}, {"type": "subtitle", "time": 12885.67, "timestamp": "03:34:45", "text": "ああ、そうです。うん。うん。そして私は"}, {"type": "subtitle", "time": 12888.15, "timestamp": "03:34:48", "text": "高台に陣取って、戦おうとした。"}, {"type": "subtitle", "time": 12891.67, "timestamp": "03:34:51", "text": "とても痛かった。こっちじゃなかったっけ？"}, {"type": "subtitle", "time": 12894.55, "timestamp": "03:34:54", "text": "どこかで？"}, {"type": "subtitle", "time": 12898.71, "timestamp": "03:34:58", "text": "ああ、あの頃が懐かしい。"}]
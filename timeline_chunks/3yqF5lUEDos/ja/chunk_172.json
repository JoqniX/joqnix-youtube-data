[{"type": "subtitle", "time": 10322.23, "timestamp": "02:52:02", "text": "死ななくて本当に良かった。私は"}, {"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "二度目に私は死ぬだろう。"}, {"type": "subtitle", "time": 10326.87, "timestamp": "02:52:06", "text": "幸いにも、私はそうしなかった。"}, {"type": "subtitle", "time": 10329.11, "timestamp": "02:52:09", "text": "今降りてきます。"}, {"type": "subtitle", "time": 10336.07, "timestamp": "02:52:16", "text": "私はここにいます。なぜプロの少年が来たのか？おお、"}, {"type": "subtitle", "time": 10340.389, "timestamp": "02:52:20", "text": "私は塔の入り口にいます。"}, {"type": "subtitle", "time": 10342.55, "timestamp": "02:52:22", "text": "あなたが見えてます。"}, {"type": "subtitle", "time": 10345.59, "timestamp": "02:52:25", "text": "あ、待って。ああ、あなたは"}, {"type": "subtitle", "time": 10347.51, "timestamp": "02:52:27", "text": "水。"}, {"type": "subtitle", "time": 10365.67, "timestamp": "02:52:45", "text": "これは私が最初に作ったものです"}, {"type": "subtitle", "time": 10368.63, "timestamp": "02:52:48", "text": "私の家の前にサーバーがあります。"}, {"type": "subtitle", "time": 10375.19, "timestamp": "02:52:55", "text": "うん。上へ行こう。"}]
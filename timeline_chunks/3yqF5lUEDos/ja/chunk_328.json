[{"type": "subtitle", "time": 19686.39, "timestamp": "05:28:06", "text": "何てことだ。"}, {"type": "subtitle", "time": 19688.628, "timestamp": "05:28:08", "text": "持ち帰り。"}, {"type": "subtitle", "time": 19696.708, "timestamp": "05:28:16", "text": "これは私が"}, {"type": "subtitle", "time": 19699.91, "timestamp": "05:28:19", "text": "コラボとかメインの"}, {"type": "subtitle", "time": 19702.708, "timestamp": "05:28:22", "text": "VCや車にこのようなアカウントがあり、私の"}, {"type": "subtitle", "time": 19705.03, "timestamp": "05:28:25", "text": "別のアカウントで他のサーバーにいました"}, {"type": "subtitle", "time": 19708.628, "timestamp": "05:28:28", "text": "ミュート状態でVCが挨拶している。"}, {"type": "subtitle", "time": 19710.39, "timestamp": "05:28:30", "text": "わかった、"}, {"type": "subtitle", "time": 19713.03, "timestamp": "05:28:33", "text": "2つのタイミング。 2つのタイミング。私もちょっと"}, {"type": "subtitle", "time": 19727.91, "timestamp": "05:28:47", "text": "ほら、うちにはマルチタスクが得意な人が増えたでしょ。"}, {"type": "subtitle", "time": 19731.11, "timestamp": "05:28:51", "text": "こういう人がもっと必要だ。"}, {"type": "subtitle", "time": 19733.51, "timestamp": "05:28:53", "text": "私のような人がもっと増える。"}, {"type": "subtitle", "time": 19735.99, "timestamp": "05:28:55", "text": "カウントはありますか？"}, {"type": "subtitle", "time": 19739.75, "timestamp": "05:28:59", "text": "はい。そうそう。うん。彼女はまたマルチ"}]
[{"type": "subtitle", "time": 9900.389, "timestamp": "02:45:00", "text": "そして、これはジャンプしようとしていた"}, {"type": "subtitle", "time": 9902.469, "timestamp": "02:45:02", "text": "オフとか、何か。"}, {"type": "subtitle", "time": 9904.469, "timestamp": "02:45:04", "text": "何てことだ。"}, {"type": "subtitle", "time": 9912.07, "timestamp": "02:45:12", "text": "私たちは上昇している。これは空っぽです。まるで私が"}, {"type": "subtitle", "time": 9915.75, "timestamp": "02:45:15", "text": "そうじゃなかった。ここで何でも見つけられます。"}, {"type": "subtitle", "time": 9918.95, "timestamp": "02:45:18", "text": "そして、そう。これもそうではないようです"}, {"type": "subtitle", "time": 9921.429, "timestamp": "02:45:21", "text": "まだ使用されていません。どれだけのことができたか想像してみてください"}, {"type": "subtitle", "time": 9923.91, "timestamp": "02:45:23", "text": "された。そして、これも。これは"}, {"type": "subtitle", "time": 9928.87, "timestamp": "02:45:28", "text": "ここは素晴らしい場所です。はい。はい。はい。"}, {"type": "subtitle", "time": 9931.269, "timestamp": "02:45:31", "text": "あらゆる種類のネザー ws と"}, {"type": "subtitle", "time": 9933.91, "timestamp": "02:45:33", "text": "すべて。それはネザーWSと呼ばれていますか？"}, {"type": "subtitle", "time": 9938.15, "timestamp": "02:45:38", "text": "うん。冥界から来た植物たち。"}, {"type": "subtitle", "time": 9940.15, "timestamp": "02:45:40", "text": "ネザー。うん。わかった。下に降りましょう。"}, {"type": "subtitle", "time": 9942.389, "timestamp": "02:45:42", "text": "何もないよ。ないよ。うん。"}, {"type": "subtitle", "time": 9944.309, "timestamp": "02:45:44", "text": "何もすることがない。私たちには"}, {"type": "subtitle", "time": 9947.51, "timestamp": "02:45:47", "text": "上翅を使って飛び降りる。"}, {"type": "subtitle", "time": 9958.15, "timestamp": "02:45:58", "text": "どうやって降りるのですか？わかった。えっと、LC をシフトします。"}]
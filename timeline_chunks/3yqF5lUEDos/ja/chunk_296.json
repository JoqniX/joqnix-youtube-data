[{"type": "subtitle", "time": 17762.23, "timestamp": "04:56:02", "text": "冬。はい、確かに1回開催しました。はい、"}, {"type": "subtitle", "time": 17763.91, "timestamp": "04:56:03", "text": "ただの遊びです。どのメンバーでもホストできます"}, {"type": "subtitle", "time": 17766.15, "timestamp": "04:56:06", "text": "イベントですが、レイに尋ねるのを忘れないでください。"}, {"type": "subtitle", "time": 17768.31, "timestamp": "04:56:08", "text": "最初のプレイヤーとサーバーの1つと"}, {"type": "subtitle", "time": 17773.27, "timestamp": "04:56:13", "text": "サーバーオーナーのような存在。わかった。はい。"}, {"type": "subtitle", "time": 17775.67, "timestamp": "04:56:15", "text": "第九に、私たちは平和を好むので、戦わないでください。"}, {"type": "subtitle", "time": 17778.868, "timestamp": "04:56:18", "text": "あなたたちの間で。"}, {"type": "subtitle", "time": 17782.23, "timestamp": "04:56:22", "text": "うん。 10日、データの追加は行いません。"}, {"type": "subtitle", "time": 17783.75, "timestamp": "04:56:23", "text": "将来的にはパックやプラグインも追加する予定ですが、"}, {"type": "subtitle", "time": 17785.91, "timestamp": "04:56:25", "text": "常に私たちは常に使用する"}, {"type": "subtitle", "time": 17788.47, "timestamp": "04:56:28", "text": "バニラの代わりに紙。私たちは"}, {"type": "subtitle", "time": 17790.92, "timestamp": "04:56:30", "text": "座標とグライア"}, {"type": "subtitle", "time": 17792.47, "timestamp": "04:56:32", "text": "[音楽]"}, {"type": "subtitle", "time": 17794.47, "timestamp": "04:56:34", "text": "罠について。はい、罠を作ることができます"}, {"type": "subtitle", "time": 17796.31, "timestamp": "04:56:36", "text": "他の人は、でも、でも、それを作らないでください"}, {"type": "subtitle", "time": 17799.19, "timestamp": "04:56:39", "text": "致命的だ。"}, {"type": "subtitle", "time": 17803.35, "timestamp": "04:56:43", "text": "自分のことを意識して、"}, {"type": "subtitle", "time": 17807.91, "timestamp": "04:56:47", "text": "つまり、私たちはそんなに多くの罠を仕掛けたわけではないんです。"}, {"type": "subtitle", "time": 17810.868, "timestamp": "04:56:50", "text": "うん。それから、つる植物に注意して、"}, {"type": "subtitle", "time": 17814.23, "timestamp": "04:56:54", "text": "爆発させないように気をつけてください。うん。うん、"}, {"type": "subtitle", "time": 17816.31, "timestamp": "04:56:56", "text": "現在のクイズサーバーや"}, {"type": "subtitle", "time": 17819.99, "timestamp": "04:56:59", "text": "以前のクイズサーバーが現在稼働中です。うん。気に入った"}]
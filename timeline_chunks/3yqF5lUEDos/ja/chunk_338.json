[{"type": "subtitle", "time": 20281.11, "timestamp": "05:38:01", "text": "今日。本日お越しいただいたお礼にパンを差し上げます。"}, {"type": "subtitle", "time": 20285.43, "timestamp": "05:38:05", "text": "お越しいただきありがとうございます。デッキ"}, {"type": "subtitle", "time": 20287.59, "timestamp": "05:38:07", "text": "王様、お越しいただきありがとうございます。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 20291.03, "timestamp": "05:38:11", "text": "今日。ありがとう。そしてプロは新しい"}, {"type": "subtitle", "time": 20293.83, "timestamp": "05:38:13", "text": "ここに人がいます。ノンシアファミリーへようこそ。"}, {"type": "subtitle", "time": 20295.91, "timestamp": "05:38:15", "text": "私の配信を見つけてくださってありがとうございます。希望"}, {"type": "subtitle", "time": 20299.67, "timestamp": "05:38:19", "text": "あなたは今日それを楽しんでいます。ありがとう。"}, {"type": "subtitle", "time": 20303.03, "timestamp": "05:38:23", "text": "そして今日、ハマがやって来た。来てくれてありがとう。"}, {"type": "subtitle", "time": 20309.19, "timestamp": "05:38:29", "text": "そして今日、太陽の剣がやってきた。"}, {"type": "subtitle", "time": 20312.23, "timestamp": "05:38:32", "text": "本日はお越しいただきありがとうございます。ありがとう。それから男"}, {"type": "subtitle", "time": 20315.19, "timestamp": "05:38:35", "text": "そして今日は息子が来て、シャが来てくれました"}, {"type": "subtitle", "time": 20318.23, "timestamp": "05:38:38", "text": "今日までに。そして、ミクちゃまがやって来た。私"}, {"type": "subtitle", "time": 20319.99, "timestamp": "05:38:39", "text": "ミクを長い間見ていない。感謝"}, {"type": "subtitle", "time": 20322.31, "timestamp": "05:38:42", "text": "ミク、来てくれてありがとう。わからない"}, {"type": "subtitle", "time": 20325.35, "timestamp": "05:38:45", "text": "ちょうどザキの話をしていたところだったね。えっと"}, {"type": "subtitle", "time": 20328.07, "timestamp": "05:38:48", "text": "私とアリス・チャマはこんな話をしていました"}, {"type": "subtitle", "time": 20331.59, "timestamp": "05:38:51", "text": "私たち３人での懐かしい瞬間"}, {"type": "subtitle", "time": 20333.91, "timestamp": "05:38:53", "text": "Chrissaサーバー内のサーバー。それから"}, {"type": "subtitle", "time": 20336.39, "timestamp": "05:38:56", "text": "突然、私たちは実際に"}, {"type": "subtitle", "time": 20338.39, "timestamp": "05:38:58", "text": "ミク。"}]
[{"type": "subtitle", "time": 4804.229, "timestamp": "01:20:04", "text": "敵対勢力はブラボーNo.アリを奪った。"}, {"type": "subtitle", "time": 4807.189, "timestamp": "01:20:07", "text": "ブラボーワンを標的とする部隊。"}, {"type": "subtitle", "time": 4810.39, "timestamp": "01:20:10", "text": "待って、これって洗濯機？待って、"}, {"type": "subtitle", "time": 4814.47, "timestamp": "01:20:14", "text": "これらはスピーカーです。何？"}, {"type": "subtitle", "time": 4818.709, "timestamp": "01:20:18", "text": "一体どういうことだ？何？これらは何ですか？"}, {"type": "subtitle", "time": 4833.75, "timestamp": "01:20:33", "text": "ハイテク。"}, {"type": "subtitle", "time": 4835.83, "timestamp": "01:20:35", "text": "それはハイテクだ。"}, {"type": "subtitle", "time": 4837.91, "timestamp": "01:20:37", "text": "おお。"}, {"type": "subtitle", "time": 4841.27, "timestamp": "01:20:41", "text": "さて、どこまで話しましたっけ？"}, {"type": "subtitle", "time": 4851.669, "timestamp": "01:20:51", "text": "そう、思い出させてくれてありがとう、バカ。ダムダム。"}, {"type": "subtitle", "time": 4853.99, "timestamp": "01:20:53", "text": "ただ、私にはたくさんの"}, {"type": "subtitle", "time": 4858.39, "timestamp": "01:20:58", "text": "やるべきことはあるが、私が"}]
[{"type": "subtitle", "time": 17402.868, "timestamp": "04:50:02", "text": "おお、それはいいですね。おお。"}, {"type": "subtitle", "time": 17405.59, "timestamp": "04:50:05", "text": "どうやら彼らはIを作ることができたようだ"}, {"type": "subtitle", "time": 17408.628, "timestamp": "04:50:08", "text": "通常の脳は知っているが、脳の読み方"}, {"type": "subtitle", "time": 17411.67, "timestamp": "04:50:11", "text": "データ、というか文章は、そう、彼らは"}, {"type": "subtitle", "time": 17414.788, "timestamp": "04:50:14", "text": "文章を書くことができなかった。"}, {"type": "subtitle", "time": 17420.15, "timestamp": "04:50:20", "text": "男。"}, {"type": "subtitle", "time": 17423.99, "timestamp": "04:50:23", "text": "だから私は彼らが何かするだろうと思った"}, {"type": "subtitle", "time": 17427.75, "timestamp": "04:50:27", "text": "実際にそのビールを試飲してみました。え、そうだったの？"}, {"type": "subtitle", "time": 17431.35, "timestamp": "04:50:31", "text": "どうだった？つまり、あなたは"}, {"type": "subtitle", "time": 17435.27, "timestamp": "04:50:35", "text": "完全にテクスチャのあるフルに立っている"}, {"type": "subtitle", "time": 17438.788, "timestamp": "04:50:38", "text": "VRゲーム。いいね"}, {"type": "subtitle", "time": 17442.31, "timestamp": "04:50:42", "text": "一歩ずつ、つまり歩くことができる"}, {"type": "subtitle", "time": 17443.83, "timestamp": "04:50:43", "text": "その周り"}, {"type": "subtitle", "time": 17446.868, "timestamp": "04:50:46", "text": "ええ、あなたのハンドルで、でもあなたは見ていました"}, {"type": "subtitle", "time": 17449.27, "timestamp": "04:50:49", "text": "VRゴーグルを通して見る。そうではありません"}, {"type": "subtitle", "time": 17451.99, "timestamp": "04:50:51", "text": "脳に直接投影されます。それで"}, {"type": "subtitle", "time": 17453.83, "timestamp": "04:50:53", "text": "まるであなたがただ"}, {"type": "subtitle", "time": 17457.83, "timestamp": "04:50:57", "text": "普通のVRゲームだけど、そう、君は"}]
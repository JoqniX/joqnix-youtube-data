[{"type": "subtitle", "time": 18902.708, "timestamp": "05:15:02", "text": "歌を歌ったが、見事に失敗した。"}, {"type": "subtitle", "time": 18905.35, "timestamp": "05:15:05", "text": "ああ、痛い。"}, {"type": "subtitle", "time": 18907.51, "timestamp": "05:15:07", "text": "そして彼らは才能が​​あり、熟練している。"}, {"type": "subtitle", "time": 18910.788, "timestamp": "05:15:10", "text": "日本語と英語の両方を歌える人"}, {"type": "subtitle", "time": 18914.39, "timestamp": "05:15:14", "text": "中国語と英語がとても堪能です。うん、"}, {"type": "subtitle", "time": 18917.27, "timestamp": "05:15:17", "text": "中国人は中国人が好きです"}, {"type": "subtitle", "time": 18920.55, "timestamp": "05:15:20", "text": "英語の曲もカバーしている"}, {"type": "subtitle", "time": 18923.43, "timestamp": "05:15:23", "text": "日本語吹き替え。うん。何"}, {"type": "subtitle", "time": 18927.11, "timestamp": "05:15:27", "text": "地獄？うん。うん。"}, {"type": "subtitle", "time": 18928.788, "timestamp": "05:15:28", "text": "切り取りました。それは"}, {"type": "subtitle", "time": 18931.27, "timestamp": "05:15:31", "text": "oに投稿されました。"}, {"type": "subtitle", "time": 18938.868, "timestamp": "05:15:38", "text": "その動画を楽しみに待っています。"}, {"type": "subtitle", "time": 18947.19, "timestamp": "05:15:47", "text": "クリップ。"}, {"type": "subtitle", "time": 18949.43, "timestamp": "05:15:49", "text": "なんてこった。待って。あなたは実際に投稿しましたね。なぜ"}, {"type": "subtitle", "time": 18952.07, "timestamp": "05:15:52", "text": "そういうことってあるのか？待って。何？"}, {"type": "subtitle", "time": 18954.868, "timestamp": "05:15:54", "text": "両手を上げて。"}, {"type": "subtitle", "time": 18958.15, "timestamp": "05:15:58", "text": "いいえ、よくわかりません。私は無事です。"}, {"type": "subtitle", "time": 18959.99, "timestamp": "05:15:59", "text": "待って、待って、待って。"}]
[{"type": "subtitle", "time": 1440.31, "timestamp": "00:24:00", "text": "誰が話しているの？我々の資源と部隊"}, {"type": "subtitle", "time": 1452.549, "timestamp": "00:24:12", "text": "私は転んだ。何てことだ。私にはできない"}, {"type": "subtitle", "time": 1456.47, "timestamp": "00:24:16", "text": "階段を上る。何てことだ。あなたは"}, {"type": "subtitle", "time": 1458.71, "timestamp": "00:24:18", "text": "冗談でしょ。"}, {"type": "subtitle", "time": 1469.029, "timestamp": "00:24:29", "text": "何てことだ。"}, {"type": "subtitle", "time": 1472.71, "timestamp": "00:24:32", "text": "私をどれだけ苦しめるつもりですか？私たちは"}]
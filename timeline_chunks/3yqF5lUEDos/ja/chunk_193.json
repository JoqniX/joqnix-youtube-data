[{"type": "subtitle", "time": 11582.55, "timestamp": "03:13:02", "text": "などなど。たくさんの物。オルゴール"}, {"type": "subtitle", "time": 11584.71, "timestamp": "03:13:04", "text": "同じように。"}, {"type": "subtitle", "time": 11590.27, "timestamp": "03:13:10", "text": "これは一体何だったのか？そうそう。"}, {"type": "subtitle", "time": 11592.15, "timestamp": "03:13:12", "text": "[音楽]"}, {"type": "subtitle", "time": 11594.07, "timestamp": "03:13:14", "text": "そこに彼女がいると思う"}, {"type": "subtitle", "time": 11595.99, "timestamp": "03:13:15", "text": "採掘された。"}, {"type": "subtitle", "time": 11599.59, "timestamp": "03:13:19", "text": "ええ、ダイヤモンドとかそういうもののためにね。"}, {"type": "subtitle", "time": 11602.15, "timestamp": "03:13:22", "text": "見るべきものは何もない。上へ行こう。"}, {"type": "subtitle", "time": 11604.55, "timestamp": "03:13:24", "text": "ええ、彼女を手伝ったのを覚えています。"}, {"type": "subtitle", "time": 11606.95, "timestamp": "03:13:26", "text": "クリーパーに殺された。"}, {"type": "subtitle", "time": 11609.91, "timestamp": "03:13:29", "text": "なんてこった。"}, {"type": "subtitle", "time": 11618.2, "timestamp": "03:13:38", "text": "しかし、これは実に懐かしい思い出だ。"}, {"type": "subtitle", "time": 11621.19, "timestamp": "03:13:41", "text": "[音楽]"}, {"type": "subtitle", "time": 11628.71, "timestamp": "03:13:48", "text": "よし、上がってもいいよ。"}, {"type": "subtitle", "time": 11631.75, "timestamp": "03:13:51", "text": "ああ、上がっていく。ええ、これは大きな"}, {"type": "subtitle", "time": 11634.309, "timestamp": "03:13:54", "text": "大邸宅だよ、わかるだろ。これはとてもオープンな"}, {"type": "subtitle", "time": 11636.87, "timestamp": "03:13:56", "text": "場所。クリーパーに殺されたのを覚えている"}, {"type": "subtitle", "time": 11639.67, "timestamp": "03:13:59", "text": "ここにたいまつがないから。彼女が作ったかもしれない"}]
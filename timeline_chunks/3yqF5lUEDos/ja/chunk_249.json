[{"type": "subtitle", "time": 14949.269, "timestamp": "04:09:09", "text": "描画距離の外に出てしまいました"}, {"type": "subtitle", "time": 14953.59, "timestamp": "04:09:13", "text": "そして私はあなたを失ってしまった。ああ、いや、私はただ行くだけです"}, {"type": "subtitle", "time": 14960.87, "timestamp": "04:09:20", "text": "想像する"}, {"type": "subtitle", "time": 14983.51, "timestamp": "04:09:43", "text": "死んでしまえばいい。そうそう。私はただ"}, {"type": "subtitle", "time": 14986.63, "timestamp": "04:09:46", "text": "死ぬ。そして私は、グレーボックスはどうですか、"}, {"type": "subtitle", "time": 14988.63, "timestamp": "04:09:48", "text": "男？いいえ。"}, {"type": "subtitle", "time": 14991.189, "timestamp": "04:09:51", "text": "えっと"}]
[{"type": "subtitle", "time": 8820.55, "timestamp": "02:27:00", "text": "来るために"}, {"type": "subtitle", "time": 8824.71, "timestamp": "02:27:04", "text": "その時私たちは"}, {"type": "subtitle", "time": 8826.63, "timestamp": "02:27:06", "text": "えっと"}, {"type": "subtitle", "time": 8832.309, "timestamp": "02:27:12", "text": "アンドリュー・ソナタが来る、それからH"}, {"type": "subtitle", "time": 8833.83, "timestamp": "02:27:13", "text": "来るよ。"}, {"type": "subtitle", "time": 8835.51, "timestamp": "02:27:15", "text": "アシャ"}, {"type": "subtitle", "time": 8837.59, "timestamp": "02:27:17", "text": "来るべきアッシュのために。初めてですね"}, {"type": "subtitle", "time": 8840.309, "timestamp": "02:27:20", "text": "ここに来るんですよね？はい。ありがとう。希望"}, {"type": "subtitle", "time": 8843.75, "timestamp": "02:27:23", "text": "家族の一員として、私たちの滞在を楽しんでください。"}, {"type": "subtitle", "time": 8845.83, "timestamp": "02:27:25", "text": "そして、そして"}, {"type": "subtitle", "time": 8848.55, "timestamp": "02:27:28", "text": "他に誰か見落とした人はいますか？誰でも？ズキは"}, {"type": "subtitle", "time": 8850.07, "timestamp": "02:27:30", "text": "ここ。"}, {"type": "subtitle", "time": 8852.389, "timestamp": "02:27:32", "text": "もしかしたらここにいたのかもしれない。"}, {"type": "subtitle", "time": 8857.349, "timestamp": "02:27:37", "text": "えっと、ロートが来るのを忘れてた。忘れた"}, {"type": "subtitle", "time": 8861.429, "timestamp": "02:27:41", "text": "あなたの名前。はい。えっと、じゃあ、じゃあ、誰が"}, {"type": "subtitle", "time": 8864.389, "timestamp": "02:27:44", "text": "もう片方は？なぜ私はバックログを取らなかったのか"}, {"type": "subtitle", "time": 8868.23, "timestamp": "02:27:48", "text": "今日のチャットは？ああ、私はなんて愚かだったんだろう。私"}, {"type": "subtitle", "time": 8875.429, "timestamp": "02:27:55", "text": "tチャットのバックログを忘れていました。ああ、そうですね"}, {"type": "subtitle", "time": 8877.51, "timestamp": "02:27:57", "text": "みんな"}, {"type": "subtitle", "time": 8879.75, "timestamp": "02:27:59", "text": "私の配信を見てくれてありがとう。それはありました"}]
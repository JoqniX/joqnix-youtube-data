[{"type": "subtitle", "time": 20403.51, "timestamp": "05:40:03", "text": "私の配信を見つけてくれてありがとう。本当に本当に"}, {"type": "subtitle", "time": 20406.07, "timestamp": "05:40:06", "text": "とても意味があります。そしてあなたは、自分がどこから来たのかと言っている"}, {"type": "subtitle", "time": 20407.59, "timestamp": "05:40:07", "text": "インドネシア。"}, {"type": "subtitle", "time": 20410.31, "timestamp": "05:40:10", "text": "だから、もう一人インドネシア人が来てくれて本当に嬉しい"}, {"type": "subtitle", "time": 20413.35, "timestamp": "05:40:13", "text": "インドネシア人の友達だけどね。数えきれなくなった"}, {"type": "subtitle", "time": 20416.548, "timestamp": "05:40:16", "text": "私にはインテリアの友達が何人いるか"}, {"type": "subtitle", "time": 20419.03, "timestamp": "05:40:19", "text": "それは、数人のインドネシア人のような"}, {"type": "subtitle", "time": 20424.788, "timestamp": "05:40:24", "text": "視聴者やリスナー、そしてBTuber"}, {"type": "subtitle", "time": 20427.35, "timestamp": "05:40:27", "text": "私には友達がいる"}, {"type": "subtitle", "time": 20429.83, "timestamp": "05:40:29", "text": "私が出会ったのは"}, {"type": "subtitle", "time": 20433.43, "timestamp": "05:40:33", "text": "クサン。そう、インドネシアのVTuberが何人かいるんだ。"}, {"type": "subtitle", "time": 20436.23, "timestamp": "05:40:36", "text": "そこにあります。忘れた。でも、ありがとう"}, {"type": "subtitle", "time": 20438.708, "timestamp": "05:40:38", "text": "来てくれて本当にありがとう。願わくば"}, {"type": "subtitle", "time": 20443.27, "timestamp": "05:40:43", "text": "自分の配信と配信の両方を楽しんだ。"}, {"type": "subtitle", "time": 20450.07, "timestamp": "05:40:50", "text": "ロバート・ジャクソンさん、お越しいただきありがとうございます。"}, {"type": "subtitle", "time": 20453.51, "timestamp": "05:40:53", "text": "ありがとう。まだ使っているようですね"}, {"type": "subtitle", "time": 20458.39, "timestamp": "05:40:58", "text": "また冗談か。まあ、いいんだけどね。そして、えっと、私は"}]
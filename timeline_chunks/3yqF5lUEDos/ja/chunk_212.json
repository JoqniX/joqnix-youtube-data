[{"type": "subtitle", "time": 12721.75, "timestamp": "03:32:01", "text": "それのバックアップがない？"}, {"type": "subtitle", "time": 12728.469, "timestamp": "03:32:08", "text": "そのバックアップは持っていないと思います"}, {"type": "subtitle", "time": 12730.63, "timestamp": "03:32:10", "text": "なぜならこの場所には、ほら"}, {"type": "subtitle", "time": 12733.67, "timestamp": "03:32:13", "text": "市場の低迷か何かだろう。"}, {"type": "subtitle", "time": 12736.55, "timestamp": "03:32:16", "text": "あ、待って"}, {"type": "subtitle", "time": 12739.75, "timestamp": "03:32:19", "text": "これが最新版だと思った"}, {"type": "subtitle", "time": 12742.79, "timestamp": "03:32:22", "text": "最新版。私もそう思いましたが"}, {"type": "subtitle", "time": 12746.07, "timestamp": "03:32:26", "text": "外には何も見えない。"}, {"type": "subtitle", "time": 12750.469, "timestamp": "03:32:30", "text": "これは何バージョンですか？これは17.1です"}, {"type": "subtitle", "time": 12752.71, "timestamp": "03:32:32", "text": "20ではない。"}, {"type": "subtitle", "time": 12761.269, "timestamp": "03:32:41", "text": "どうすれば上に上がれるのか？さあ、積み上げていきましょう。私たちは"}, {"type": "subtitle", "time": 12763.349, "timestamp": "03:32:43", "text": "ブロックがあります。このニワトリは何をしているの？"}, {"type": "subtitle", "time": 12765.51, "timestamp": "03:32:45", "text": "ここ？"}]
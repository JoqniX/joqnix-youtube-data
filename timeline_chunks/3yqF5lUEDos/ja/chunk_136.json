[{"type": "subtitle", "time": 8163.03, "timestamp": "02:16:03", "text": "ASMR のものかもしれないし、"}, {"type": "subtitle", "time": 8167.75, "timestamp": "02:16:07", "text": "深夜のASMR その１。うん。えーと、それから"}, {"type": "subtitle", "time": 8171.27, "timestamp": "02:16:11", "text": "来週はGTA Vを予定しています。えっと、"}, {"type": "subtitle", "time": 8174.709, "timestamp": "02:16:14", "text": "特別なDZLCを計画しています"}, {"type": "subtitle", "time": 8177.75, "timestamp": "02:16:17", "text": "ゲスト、シーカーシークレット。"}, {"type": "subtitle", "time": 8180.31, "timestamp": "02:16:20", "text": "そして私たちは"}, {"type": "subtitle", "time": 8185.83, "timestamp": "02:16:25", "text": "エイクセルゲームとスタリバレーがあります"}, {"type": "subtitle", "time": 8188.149, "timestamp": "02:16:28", "text": "最も可能性が高い。"}, {"type": "subtitle", "time": 8191.99, "timestamp": "02:16:31", "text": "次にヴァレラントです。"}, {"type": "subtitle", "time": 8196.709, "timestamp": "02:16:36", "text": "そして、フォートナイトをやるかもしれません"}, {"type": "subtitle", "time": 8199.03, "timestamp": "02:16:39", "text": "ストリームで"}, {"type": "subtitle", "time": 8201.99, "timestamp": "02:16:41", "text": "ある誰それ"}, {"type": "subtitle", "time": 8204.87, "timestamp": "02:16:44", "text": "確証はないが、こう言える。"}, {"type": "subtitle", "time": 8206.79, "timestamp": "02:16:46", "text": "だから、フォートナイトをダウンロードしないといけないかもしれない"}, {"type": "subtitle", "time": 8209.27, "timestamp": "02:16:49", "text": "アンインストールしたので、また同じことを言っています。そして私も"}, {"type": "subtitle", "time": 8212.15, "timestamp": "02:16:52", "text": "バトルフィールドは今はアンインストールしていません"}, {"type": "subtitle", "time": 8214.95, "timestamp": "02:16:54", "text": "だって、もう配信は終わったんだもんね？私"}, {"type": "subtitle", "time": 8216.95, "timestamp": "02:16:56", "text": "今週末は無料だと知っておいて。わからない"}, {"type": "subtitle", "time": 8219.75, "timestamp": "02:16:59", "text": "私はそのゲームをやり込むつもりです。"}]
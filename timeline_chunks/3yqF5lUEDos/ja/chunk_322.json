[{"type": "subtitle", "time": 19320.948, "timestamp": "05:22:00", "text": "しばらくすると、"}, {"type": "subtitle", "time": 19323.11, "timestamp": "05:22:03", "text": "日本語？"}, {"type": "subtitle", "time": 19329.75, "timestamp": "05:22:09", "text": "[音楽]"}, {"type": "subtitle", "time": 19359.43, "timestamp": "05:22:39", "text": "まるで魔法のよう、この魔法のよう"}, {"type": "subtitle", "time": 19361.75, "timestamp": "05:22:41", "text": "日本語がわからないという感覚"}, {"type": "subtitle", "time": 19363.59, "timestamp": "05:22:43", "text": "どこにも話しかけない"}, {"type": "subtitle", "time": 19366.628, "timestamp": "05:22:46", "text": "日本語を1、2時間くらい勉強する。"}, {"type": "subtitle", "time": 19372.15, "timestamp": "05:22:52", "text": "私は「えっ？」って感じでした。"}]
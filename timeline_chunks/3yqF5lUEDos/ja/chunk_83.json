[{"type": "subtitle", "time": 4992.87, "timestamp": "01:23:12", "text": "賛成です。いや、いや、いや、いや。あ、待って。私"}, {"type": "subtitle", "time": 4994.95, "timestamp": "01:23:14", "text": "忘れた。"}, {"type": "subtitle", "time": 4997.669, "timestamp": "01:23:17", "text": "ああ、今日何があったか知ってる？負けました"}, {"type": "subtitle", "time": 5002.149, "timestamp": "01:23:22", "text": "部屋を掃除しているときに、眼鏡をかけてしまった。"}, {"type": "subtitle", "time": 5005.51, "timestamp": "01:23:25", "text": "私の部屋の掃除。今日はテストをしていました"}, {"type": "subtitle", "time": 5007.75, "timestamp": "01:23:27", "text": "すべての"}, {"type": "subtitle", "time": 5012.31, "timestamp": "01:23:32", "text": "私の部屋とコンピューター関連機器。ああ、大変だ。"}, {"type": "subtitle", "time": 5016.47, "timestamp": "01:23:36", "text": "ハッシュ値が上限に達しました。何？"}, {"type": "subtitle", "time": 5021.99, "timestamp": "01:23:41", "text": "何？わかった。えっと、どうやら私は"}, {"type": "subtitle", "time": 5025.51, "timestamp": "01:23:45", "text": "うっかりメガネをなくしてしまいました。"}, {"type": "subtitle", "time": 5028.149, "timestamp": "01:23:48", "text": "私は眼鏡をベッドに置いて、"}, {"type": "subtitle", "time": 5031.51, "timestamp": "01:23:51", "text": "ベッドシーツを取り出して、"}, {"type": "subtitle", "time": 5034.47, "timestamp": "01:23:54", "text": "洗濯機が洗濯台の上にある"}, {"type": "subtitle", "time": 5037.43, "timestamp": "01:23:57", "text": "そして私はあらゆる所で私の"}, {"type": "subtitle", "time": 5039.83, "timestamp": "01:23:59", "text": "眼鏡。"}]
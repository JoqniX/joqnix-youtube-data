[{"type": "subtitle", "time": 14705.11, "timestamp": "04:05:05", "text": "ああ、魔法使い。"}, {"type": "subtitle", "time": 14708.07, "timestamp": "04:05:08", "text": "私たちが"}, {"type": "subtitle", "time": 14710.55, "timestamp": "04:05:10", "text": "砂漠？私たちは戦っていたと思います"}, {"type": "subtitle", "time": 14716.229, "timestamp": "04:05:16", "text": "ああ、そうそうそうそう。それはどこだったのか"}, {"type": "subtitle", "time": 14718.87, "timestamp": "04:05:18", "text": "場所？何てことだ。その場所はどこですか？私"}, {"type": "subtitle", "time": 14725.429, "timestamp": "04:05:25", "text": "私たちが"}, {"type": "subtitle", "time": 14733.269, "timestamp": "04:05:33", "text": "とても思い出深い場所でした。私"}, {"type": "subtitle", "time": 14736.63, "timestamp": "04:05:36", "text": "覚えてる？あの時のことだけ覚えてるよ"}, {"type": "subtitle", "time": 14742.229, "timestamp": "04:05:42", "text": "原神はそれを推測しない、"}, {"type": "subtitle", "time": 14745.189, "timestamp": "04:05:45", "text": "どういうわけか私は"}, {"type": "subtitle", "time": 14747.429, "timestamp": "04:05:47", "text": "去らない"}, {"type": "subtitle", "time": 14749.03, "timestamp": "04:05:49", "text": "犬沼"}, {"type": "subtitle", "time": 14751.269, "timestamp": "04:05:51", "text": "期間そうですね"}, {"type": "subtitle", "time": 14754.15, "timestamp": "04:05:54", "text": "うん、ちょうどその頃に出たんだと思う"}]
[{"type": "subtitle", "time": 14839.189, "timestamp": "04:07:19", "text": "スポーン地点をここに変更しました。"}, {"type": "subtitle", "time": 14847.349, "timestamp": "04:07:27", "text": "昔は地図を使っていたと思う"}, {"type": "subtitle", "time": 14850.309, "timestamp": "04:07:30", "text": "世界地図プラグイン"}, {"type": "subtitle", "time": 14853.269, "timestamp": "04:07:33", "text": "モードか何か、どこにいるかを知る"}, {"type": "subtitle", "time": 14855.67, "timestamp": "04:07:35", "text": "行って色々やってみる。"}, {"type": "subtitle", "time": 14858.07, "timestamp": "04:07:38", "text": "ああ、そうそう、私も昔使ってたよ。ええ、ええ、"}, {"type": "subtitle", "time": 14859.59, "timestamp": "04:07:39", "text": "うん。"}, {"type": "subtitle", "time": 14862.95, "timestamp": "04:07:42", "text": "宝箱に砂が少し入っているのが見える"}, {"type": "subtitle", "time": 14868.63, "timestamp": "04:07:48", "text": "そしてオアシスのような、あるいは大きな"}, {"type": "subtitle", "time": 14874.79, "timestamp": "04:07:54", "text": "うん。"}, {"type": "subtitle", "time": 14877.75, "timestamp": "04:07:57", "text": "うん、これで大丈夫だよ。私たちは間違いなく"}, {"type": "subtitle", "time": 14879.75, "timestamp": "04:07:59", "text": "おお、"}]
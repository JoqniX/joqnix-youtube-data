[{"type": "subtitle", "time": 13082.15, "timestamp": "03:38:02", "text": "おお、"}, {"type": "subtitle", "time": 13084.95, "timestamp": "03:38:04", "text": "ちょっと待って。わかった。"}, {"type": "subtitle", "time": 13103.59, "timestamp": "03:38:23", "text": "わかった。誰にもさせてはいけないと思う"}, {"type": "subtitle", "time": 13107.269, "timestamp": "03:38:27", "text": "参加する。今のところ。でも私はいつでも共有できます"}, {"type": "subtitle", "time": 13110.469, "timestamp": "03:38:30", "text": "ファイル。いつでもファイルを共有できます"}, {"type": "subtitle", "time": 13112.229, "timestamp": "03:38:32", "text": "あなたへ。"}, {"type": "subtitle", "time": 13115.91, "timestamp": "03:38:35", "text": "ええ、私たちはただ、ほら、"}, {"type": "subtitle", "time": 13120.15, "timestamp": "03:38:40", "text": "メモを具体化したものはこちらです。はい。"}, {"type": "subtitle", "time": 13122.309, "timestamp": "03:38:42", "text": "昔の思い出を振り返る。私たちは"}, {"type": "subtitle", "time": 13124.87, "timestamp": "03:38:44", "text": "本当は、私たちは本当に遊んでいるわけではないんです。だった"}, {"type": "subtitle", "time": 13127.51, "timestamp": "03:38:47", "text": "ただ知っておいてほしい。うん。観光。だった"}]
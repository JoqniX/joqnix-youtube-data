[{"type": "subtitle", "time": 12902.229, "timestamp": "03:35:02", "text": "ああ、もう、泣けてくる。"}, {"type": "subtitle", "time": 12905.11, "timestamp": "03:35:05", "text": "ああ、懐かしい思い出だ。"}, {"type": "subtitle", "time": 12908.87, "timestamp": "03:35:08", "text": "多くの人がアリを探すためにボートを利用している。"}, {"type": "subtitle", "time": 12912.55, "timestamp": "03:35:12", "text": "わかった。なぜ憎しみをもって殴ったのか"}, {"type": "subtitle", "time": 12916.63, "timestamp": "03:35:16", "text": "これからは皆があなたを狙ってくるでしょう。私"}, {"type": "subtitle", "time": 12918.87, "timestamp": "03:35:18", "text": "走る。"}, {"type": "subtitle", "time": 12922.229, "timestamp": "03:35:22", "text": "たくさんあるよ。"}, {"type": "subtitle", "time": 12924.36, "timestamp": "03:35:24", "text": "私たちは死ぬだろう。あなたは毒を盛られた。"}, {"type": "subtitle", "time": 12927.75, "timestamp": "03:35:27", "text": "[音楽]"}, {"type": "subtitle", "time": 12940.07, "timestamp": "03:35:40", "text": "あの厄介なハチたち。私は1つだけと思った"}, {"type": "subtitle", "time": 12941.67, "timestamp": "03:35:41", "text": "だろう"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "一人しか来ないと思っていた。私"}, {"type": "subtitle", "time": 12947.11, "timestamp": "03:35:47", "text": "蜂の大群全体がどうなっているのか知らなかった"}, {"type": "subtitle", "time": 12951.51, "timestamp": "03:35:51", "text": "来るだろう。まだ怒ってるよ、どこが"}, {"type": "subtitle", "time": 12954.53, "timestamp": "03:35:54", "text": "あそこのやつ。"}, {"type": "subtitle", "time": 12956.07, "timestamp": "03:35:56", "text": "[音楽]"}, {"type": "subtitle", "time": 12959.11, "timestamp": "03:35:59", "text": "ベイビー、彼らは私を攻撃するだろうか？いいえ。見る"}]
[{"type": "subtitle", "time": 9961.51, "timestamp": "02:46:01", "text": "私はそれを自分の名前に変更しました。"}, {"type": "subtitle", "time": 9987.19, "timestamp": "02:46:27", "text": "ついに、私は烙印を押された。"}, {"type": "subtitle", "time": 9990.07, "timestamp": "02:46:30", "text": "長い旅だ。"}, {"type": "subtitle", "time": 9993.59, "timestamp": "02:46:33", "text": "ええ、長い旅になりますね。"}, {"type": "subtitle", "time": 9995.75, "timestamp": "02:46:35", "text": "ここには村があります。いくつか見てみましょう"}, {"type": "subtitle", "time": 10007.19, "timestamp": "02:46:47", "text": "ぶつけないでください。"}, {"type": "subtitle", "time": 10009.11, "timestamp": "02:46:49", "text": "ああ、みんな「私は元気です」とか"}, {"type": "subtitle", "time": 10015.349, "timestamp": "02:46:55", "text": "リスポーン設定はしていません。設定したっけ？"}, {"type": "subtitle", "time": 10018.469, "timestamp": "02:46:58", "text": "こちらですか？"}]
[{"type": "subtitle", "time": 12063.269, "timestamp": "03:21:03", "text": "それらには大量の木材が必要です。それから私は"}, {"type": "subtitle", "time": 12066.07, "timestamp": "03:21:06", "text": "えっと、それを知ったんだけど、待って、なんで私は"}, {"type": "subtitle", "time": 12068.63, "timestamp": "03:21:08", "text": "集めた木材を全部無駄にしてしまった"}, {"type": "subtitle", "time": 12072.389, "timestamp": "03:21:12", "text": "このように拠点を拡大したいですか？"}, {"type": "subtitle", "time": 12074.389, "timestamp": "03:21:14", "text": "えっと"}, {"type": "subtitle", "time": 12077.59, "timestamp": "03:21:17", "text": "ああ、痛み"}, {"type": "subtitle", "time": 12080.07, "timestamp": "03:21:20", "text": "でも、まあいいでしょう。あなたは他の場所にいますか"}, {"type": "subtitle", "time": 12083.19, "timestamp": "03:21:23", "text": "Minecraftサーバーができましたか？いいえ、していません"}, {"type": "subtitle", "time": 12086.63, "timestamp": "03:21:26", "text": "マインクラフトをずっとプレイしています。さあ"}, {"type": "subtitle", "time": 12088.87, "timestamp": "03:21:28", "text": "新しいものを作成する。"}, {"type": "subtitle", "time": 12092.63, "timestamp": "03:21:32", "text": "でもそれは私がそうしない時間です"}, {"type": "subtitle", "time": 12094.79, "timestamp": "03:21:34", "text": "時間を確保できる。それが理由です"}, {"type": "subtitle", "time": 12098.95, "timestamp": "03:21:38", "text": "私はまるで"}, {"type": "subtitle", "time": 12101.429, "timestamp": "03:21:41", "text": "理解できます。"}, {"type": "subtitle", "time": 12103.11, "timestamp": "03:21:43", "text": "ねえ、少し時間を作って"}, {"type": "subtitle", "time": 12106.229, "timestamp": "03:21:46", "text": "Minecraft Steamまたはコラボ、追加"}, {"type": "subtitle", "time": 12108.55, "timestamp": "03:21:48", "text": "サーバーにさらにメンバーを追加して"}, {"type": "subtitle", "time": 12111.59, "timestamp": "03:21:51", "text": "彼らと協力する。うん、そうだろうね。"}, {"type": "subtitle", "time": 12113.75, "timestamp": "03:21:53", "text": "それは楽しそうですね。"}]
[{"type": "subtitle", "time": 20221.83, "timestamp": "05:37:01", "text": "エマ・チャマも参加するのかな"}, {"type": "subtitle", "time": 20226.31, "timestamp": "05:37:06", "text": "新しいサーバー向け。えーとデザインは"}, {"type": "subtitle", "time": 20230.47, "timestamp": "05:37:10", "text": "作成中。つまり、可能であれば"}, {"type": "subtitle", "time": 20232.47, "timestamp": "05:37:12", "text": "日本人とつながりたい"}, {"type": "subtitle", "time": 20234.07, "timestamp": "05:37:14", "text": "ストリーマー"}, {"type": "subtitle", "time": 20236.708, "timestamp": "05:37:16", "text": "日本語のnihon なので、私は好きです"}, {"type": "subtitle", "time": 20240.23, "timestamp": "05:37:20", "text": "日本語を上達させたいんです、ご存知の通りですから"}, {"type": "subtitle", "time": 20245.99, "timestamp": "05:37:25", "text": "ああ、いつか、いつか"}, {"type": "subtitle", "time": 20248.23, "timestamp": "05:37:28", "text": "ということで、これを締めくくります"}, {"type": "subtitle", "time": 20251.75, "timestamp": "05:37:31", "text": "ここは午後6時になります。私"}, {"type": "subtitle", "time": 20254.628, "timestamp": "05:37:34", "text": "午前6時って言いそうになったよ。ああ、なんてことだ。うん、"}, {"type": "subtitle", "time": 20257.59, "timestamp": "05:37:37", "text": "今日は楽しい配信だった。それでは感謝しましょう"}, {"type": "subtitle", "time": 20260.39, "timestamp": "05:37:40", "text": "今日立ち寄ってくれた皆さん"}, {"type": "subtitle", "time": 20263.19, "timestamp": "05:37:43", "text": "ストリーム。こんにちは。"}, {"type": "subtitle", "time": 20265.11, "timestamp": "05:37:45", "text": "まず最初に、最初にやってきた人"}, {"type": "subtitle", "time": 20271.59, "timestamp": "05:37:51", "text": "本日はお越しいただきありがとうございます。楽しんでいただけたでしょうか。"}, {"type": "subtitle", "time": 20273.83, "timestamp": "05:37:53", "text": "今日。"}, {"type": "subtitle", "time": 20276.47, "timestamp": "05:37:56", "text": "楽しんでいただけたなら幸いです。それからパンが運ばれてきた"}]
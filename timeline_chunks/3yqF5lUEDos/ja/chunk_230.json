[{"type": "subtitle", "time": 13804.389, "timestamp": "03:50:04", "text": "この男、最後に会ってからずいぶん経つ"}, {"type": "subtitle", "time": 13807.51, "timestamp": "03:50:07", "text": "この男を見た。そうそう。この男は、"}, {"type": "subtitle", "time": 13811.83, "timestamp": "03:50:11", "text": "[音楽]"}, {"type": "subtitle", "time": 13820.79, "timestamp": "03:50:20", "text": "彼には良いものは何もない"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "ジャングルの若木。"}, {"type": "subtitle", "time": 13825.03, "timestamp": "03:50:25", "text": "でも、もうあなたは必要ない。私は持っている"}, {"type": "subtitle", "time": 13837.75, "timestamp": "03:50:37", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 13846.52, "timestamp": "03:50:46", "text": "暴力的な意味ではなく、ただ彼が嫌いなんです。"}]
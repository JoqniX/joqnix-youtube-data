[{"type": "subtitle", "time": 18961.75, "timestamp": "05:16:01", "text": "ああ、彼が本当に投稿した。ああ、"}, {"type": "subtitle", "time": 18973.19, "timestamp": "05:16:13", "text": "ええ、私はただ闇は純粋で"}, {"type": "subtitle", "time": 18975.83, "timestamp": "05:16:15", "text": "そう言ってください。うん。"}, {"type": "subtitle", "time": 18978.708, "timestamp": "05:16:18", "text": "あら、どうしたの？何？何をしたの？"}, {"type": "subtitle", "time": 18986.868, "timestamp": "05:16:26", "text": "おお、"}, {"type": "subtitle", "time": 18989.67, "timestamp": "05:16:29", "text": "純粋で、そう言ってください。"}, {"type": "subtitle", "time": 18996.39, "timestamp": "05:16:36", "text": "発音が危険になる？それで、"}, {"type": "subtitle", "time": 19001.35, "timestamp": "05:16:41", "text": "声。いいえ。ピュアがそう言っています。"}, {"type": "subtitle", "time": 19013.27, "timestamp": "05:16:53", "text": "うーん、わからない。"}, {"type": "subtitle", "time": 19015.44, "timestamp": "05:16:55", "text": "わからない。 何てことだ。またクリッピングエラーが発生しました。いいえ、"}]
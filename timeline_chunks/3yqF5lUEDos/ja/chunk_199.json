[{"type": "subtitle", "time": 11942.15, "timestamp": "03:19:02", "text": "ドラゴンは何度も。"}, {"type": "subtitle", "time": 11944.79, "timestamp": "03:19:04", "text": "ええと、記憶力はあまり良くありません"}, {"type": "subtitle", "time": 11947.83, "timestamp": "03:19:07", "text": "サーバー内部のドラゴン。"}, {"type": "subtitle", "time": 11949.349, "timestamp": "03:19:09", "text": "うん、"}, {"type": "subtitle", "time": 11951.03, "timestamp": "03:19:11", "text": "しかし、今はどうやってそれを打ち負かすのか分からない。"}, {"type": "subtitle", "time": 11958.389, "timestamp": "03:19:18", "text": "待って、私たちだったっけ？それとも私だったっけ？"}, {"type": "subtitle", "time": 11962.309, "timestamp": "03:19:22", "text": "これらのいくつかに名前を付けたのを覚えている"}, {"type": "subtitle", "time": 11966.55, "timestamp": "03:19:26", "text": "ペット。ペットチェーンはどこにありますか？私"}, {"type": "subtitle", "time": 11977.03, "timestamp": "03:19:37", "text": "待って、彼を飼いならすことはできるの？いや、私はどちらかというと"}, {"type": "subtitle", "time": 11983.11, "timestamp": "03:19:43", "text": "それは"}, {"type": "subtitle", "time": 11986.229, "timestamp": "03:19:46", "text": "私は、私は、別の場所であなたのオーナーです"}, {"type": "subtitle", "time": 11989.429, "timestamp": "03:19:49", "text": "あなたよりもアバター。私が本物ですが、"}, {"type": "subtitle", "time": 11991.67, "timestamp": "03:19:51", "text": "それでもあなたは私のことを認識していない。それが理由です"}, {"type": "subtitle", "time": 11994.15, "timestamp": "03:19:54", "text": "あなたは頭を傾けていますね。"}]
[{"type": "subtitle", "time": 15.749, "timestamp": "00:00:15", "text": "どの川のことですか？待って、ズキはここにいるの？欲しい"}, {"type": "subtitle", "time": 18.95, "timestamp": "00:00:18", "text": "ズキがここにいる。彼女が私たちのものになってほしい"}, {"type": "subtitle", "time": 21.75, "timestamp": "00:00:21", "text": "ヘルパー。"}, {"type": "subtitle", "time": 24.07, "timestamp": "00:00:24", "text": "あなたが言った方法はうまくいきません。痛み"}, {"type": "subtitle", "time": 39.91, "timestamp": "00:00:39", "text": "待って。"}, {"type": "subtitle", "time": 42.549, "timestamp": "00:00:42", "text": "それで、えーと、奥様、ズキを見かけたら、彼女は"}, {"type": "subtitle", "time": 45.67, "timestamp": "00:00:45", "text": "少し前にここに来ました。ええ、私は遅刻しました"}, {"type": "subtitle", "time": 49.19, "timestamp": "00:00:49", "text": "彼女のメッセージに返信する。 DMを見た"}, {"type": "subtitle", "time": 57.35, "timestamp": "00:00:57", "text": "私はこのバカを助けたい。"}]
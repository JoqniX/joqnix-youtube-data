[{"type": "subtitle", "time": 19565.75, "timestamp": "05:26:05", "text": "そうそう。あなたはVaをプレイしていません"}, {"type": "subtitle", "time": 19569.35, "timestamp": "05:26:09", "text": "今？えっと、今PCで持ってるんだけど"}, {"type": "subtitle", "time": 19573.19, "timestamp": "05:26:13", "text": "でも、ストリーミング配信はできないと思う。うん、"}, {"type": "subtitle", "time": 19575.99, "timestamp": "05:26:15", "text": "少し痛いけど"}, {"type": "subtitle", "time": 19577.59, "timestamp": "05:26:17", "text": "うん、"}, {"type": "subtitle", "time": 19579.67, "timestamp": "05:26:19", "text": "もうすぐプレイできるようになります。しないで"}, {"type": "subtitle", "time": 19581.19, "timestamp": "05:26:21", "text": "心配。"}, {"type": "subtitle", "time": 19583.75, "timestamp": "05:26:23", "text": "ええ、将来も使えますよ"}, {"type": "subtitle", "time": 19586.47, "timestamp": "05:26:26", "text": "ベータ版が終わったら、プレイできます"}, {"type": "subtitle", "time": 19588.39, "timestamp": "05:26:28", "text": "モバイルで利用できます。"}, {"type": "subtitle", "time": 19591.67, "timestamp": "05:26:31", "text": "ああ、もちろんです。しかし、問題は、"}, {"type": "subtitle", "time": 19595.03, "timestamp": "05:26:35", "text": "VRコミュニティはVR開発者たちに怒っている"}, {"type": "subtitle", "time": 19597.27, "timestamp": "05:26:37", "text": "モバイル向けに開くには少し"}, {"type": "subtitle", "time": 19599.67, "timestamp": "05:26:39", "text": "子供たちや彼らが参加するもの"}, {"type": "subtitle", "time": 19603.11, "timestamp": "05:26:43", "text": "騒ぎを起こしてるんだよ。"}, {"type": "subtitle", "time": 19605.99, "timestamp": "05:26:45", "text": "支払いは済んでいます。まるで、まるで"}, {"type": "subtitle", "time": 19608.47, "timestamp": "05:26:48", "text": "代替ゲームの一種で無料"}, {"type": "subtitle", "time": 19610.948, "timestamp": "05:26:50", "text": "遊ぶのも。だから、もしあなたがそれに参加するなら、"}, {"type": "subtitle", "time": 19613.11, "timestamp": "05:26:53", "text": "かなりの量になるでしょう。うん。うん。私は忘れた"}, {"type": "subtitle", "time": 19616.47, "timestamp": "05:26:56", "text": "名前。小さな子供がたくさんいます"}, {"type": "subtitle", "time": 19618.628, "timestamp": "05:26:58", "text": "10歳、7歳、または14歳"}]
[{"type": "subtitle", "time": 19991.27, "timestamp": "05:33:11", "text": "あ、待って、音楽バッグのBGMを忘れてた"}, {"type": "subtitle", "time": 19995.19, "timestamp": "05:33:15", "text": "ずっとオフだった。おお。"}, {"type": "subtitle", "time": 19997.51, "timestamp": "05:33:17", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 20000.948, "timestamp": "05:33:20", "text": "何がジョークなの？こんにちは。親指を立ててもいいですか？"}, {"type": "subtitle", "time": 20003.59, "timestamp": "05:33:23", "text": "ええ、古いセーブデータがあります、"}, {"type": "subtitle", "time": 20006.07, "timestamp": "05:33:26", "text": "最新版。フェスティバルの方はそうではない"}, {"type": "subtitle", "time": 20007.83, "timestamp": "05:33:27", "text": "残念ながら。"}, {"type": "subtitle", "time": 20010.07, "timestamp": "05:33:30", "text": "まあ、そうですね。ええ、参加できますよ。"}, {"type": "subtitle", "time": 20013.35, "timestamp": "05:33:33", "text": "削除する前に。はい、参加できますよ。"}, {"type": "subtitle", "time": 20015.91, "timestamp": "05:33:35", "text": "そして一緒にショーに出演する。つまり、私は"}, {"type": "subtitle", "time": 20017.35, "timestamp": "05:33:37", "text": "参加できないかもしれないけど、うん、"}, {"type": "subtitle", "time": 20024.548, "timestamp": "05:33:44", "text": "ああ、声が出なくなってきた。うん。うん。"}, {"type": "subtitle", "time": 20028.868, "timestamp": "05:33:48", "text": "ゆっくり休んでください。今日はよく頑張っていますね。"}, {"type": "subtitle", "time": 20035.91, "timestamp": "05:33:55", "text": "それが私の新しいものよ。"}, {"type": "subtitle", "time": 20038.23, "timestamp": "05:33:58", "text": "こんにちは。"}]
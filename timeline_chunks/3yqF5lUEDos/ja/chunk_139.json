[{"type": "subtitle", "time": 8349.669, "timestamp": "02:19:09", "text": "えーっと、それで、えーっと、一つ聞きたいことがあるんだけど"}, {"type": "subtitle", "time": 8352.15, "timestamp": "02:19:12", "text": "もの。えっと、もしあなたがまだ行ったことがないなら"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "Twitterで私をフォローしているので、"}, {"type": "subtitle", "time": 8358.709, "timestamp": "02:19:18", "text": "これを尋ねるツイートですよね？教えてください"}, {"type": "subtitle", "time": 8362.549, "timestamp": "02:19:22", "text": "皆さんが望む提案はすべてここにあります。"}, {"type": "subtitle", "time": 8366.389, "timestamp": "02:19:26", "text": "えーっと、ご存知のように、私は"}, {"type": "subtitle", "time": 8369.99, "timestamp": "02:19:29", "text": "ストリーミング ストリーミング 長時間 複数回"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "時間帯によっては試してみたい場合もある"}, {"type": "subtitle", "time": 8376.469, "timestamp": "02:19:36", "text": "動画コンテンツのように、または、"}, {"type": "subtitle", "time": 8380.389, "timestamp": "02:19:40", "text": "クリエイティブなストリームって、ほら、"}, {"type": "subtitle", "time": 8384.79, "timestamp": "02:19:44", "text": "1月は音楽関係の"}, {"type": "subtitle", "time": 8388.87, "timestamp": "02:19:48", "text": "計画しました、計画しました、そうしますので"}, {"type": "subtitle", "time": 8392.07, "timestamp": "02:19:52", "text": "実際に航海に携わることを考えた"}, {"type": "subtitle", "time": 8395.67, "timestamp": "02:19:55", "text": "モデル。私は2Dが好きです。"}, {"type": "subtitle", "time": 8398.309, "timestamp": "02:19:58", "text": "だから、私が知っている人たちは美しい"}]
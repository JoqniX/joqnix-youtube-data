[{"type": "subtitle", "time": 9423.67, "timestamp": "02:37:03", "text": "わかった。低い姿勢でジャンプするのは難しい"}, {"type": "subtitle", "time": 9425.51, "timestamp": "02:37:05", "text": "もの。"}, {"type": "subtitle", "time": 9427.19, "timestamp": "02:37:07", "text": "わかった。"}, {"type": "subtitle", "time": 9429.03, "timestamp": "02:37:09", "text": "どこに行きたいですか？うん、じゃあ"}, {"type": "subtitle", "time": 9430.95, "timestamp": "02:37:10", "text": "まずはどこかから始めよう。どこへ行こうか"}, {"type": "subtitle", "time": 9433.51, "timestamp": "02:37:13", "text": "サーバーが起動した場所。でもまあいいや、"}, {"type": "subtitle", "time": 9436.71, "timestamp": "02:37:16", "text": "その前に、必要な道具をいくつか用意しましょう。はい、"}, {"type": "subtitle", "time": 9439.51, "timestamp": "02:37:19", "text": "私と一緒に。何らかのツールが必要だ。私"}, {"type": "subtitle", "time": 9441.91, "timestamp": "02:37:21", "text": "これを覚えておいてください。私は以前これを使っていました"}, {"type": "subtitle", "time": 9446.07, "timestamp": "02:37:26", "text": "あれ。 E だけとやり取りする方法、"}, {"type": "subtitle", "time": 9451.19, "timestamp": "02:37:31", "text": "右？左クリックするだけです。"}, {"type": "subtitle", "time": 9453.51, "timestamp": "02:37:33", "text": "右クリック。うん。わかった。わかった。右"}, {"type": "subtitle", "time": 9456.309, "timestamp": "02:37:36", "text": "クリック。うん。"}, {"type": "subtitle", "time": 9459.83, "timestamp": "02:37:39", "text": "どうぞお入りください。こんにちは。私がいなければ何もない"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "間違っている。どうぞお入りください。ああ、なんてことだ。この場所"}, {"type": "subtitle", "time": 9468.71, "timestamp": "02:37:48", "text": "たくさん。うん。食べ物をいくつか持っていくことができます"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "そうそう。キッチン。何てことだ。その"}, {"type": "subtitle", "time": 9479.349, "timestamp": "02:37:59", "text": "竹の輪、そして思い出。"}]
[{"type": "subtitle", "time": 10561.03, "timestamp": "02:56:01", "text": "病気"}, {"type": "subtitle", "time": 10562.95, "timestamp": "02:56:02", "text": "モンスターハンターのやつも手に入れたよ。"}, {"type": "subtitle", "time": 10570.87, "timestamp": "02:56:10", "text": "導管"}, {"type": "subtitle", "time": 10573.99, "timestamp": "02:56:13", "text": "こちらです。"}, {"type": "subtitle", "time": 10577.11, "timestamp": "02:56:17", "text": "原因は導管でしょうか？海のことですか？"}, {"type": "subtitle", "time": 10580.07, "timestamp": "02:56:20", "text": "あれ？"}, {"type": "subtitle", "time": 10584.309, "timestamp": "02:56:24", "text": "効果を実感できるでしょう"}, {"type": "subtitle", "time": 10586.309, "timestamp": "02:56:26", "text": "効果としては、次のようなものがあるはずです"}, {"type": "subtitle", "time": 10587.99, "timestamp": "02:56:27", "text": "寺院。"}, {"type": "subtitle", "time": 10591.11, "timestamp": "02:56:31", "text": "これは、オーケー、見つけた"}, {"type": "subtitle", "time": 10592.63, "timestamp": "02:56:32", "text": "それ。"}, {"type": "subtitle", "time": 10595.83, "timestamp": "02:56:35", "text": "ああ、これだ。"}, {"type": "subtitle", "time": 10598.469, "timestamp": "02:56:38", "text": "ここは昔からずっと下だったのだろうか？ええ、そうでした"}, {"type": "subtitle", "time": 10601.03, "timestamp": "02:56:41", "text": "いつもここにいるか、あるいはほとんどの場合ここにいる。うん、"}, {"type": "subtitle", "time": 10605.269, "timestamp": "02:56:45", "text": "ほとんどの場合そうです。おお、"}, {"type": "subtitle", "time": 10607.83, "timestamp": "02:56:47", "text": "心臓の鼓動が聞こえる。"}, {"type": "subtitle", "time": 10611.83, "timestamp": "02:56:51", "text": "え、心臓の音が聞こえるの？"}, {"type": "subtitle", "time": 10614.71, "timestamp": "02:56:54", "text": "そうそう。聞こえないなんて知らなかった"}]
[{"type": "subtitle", "time": 8884.07, "timestamp": "02:28:04", "text": "3時間配信します。えっと"}, {"type": "subtitle", "time": 8887.91, "timestamp": "02:28:07", "text": "えっと、いくらですか？ 3時間。"}, {"type": "subtitle", "time": 8892.55, "timestamp": "02:28:12", "text": "3時間ほどかかるが。ええ、でも"}, {"type": "subtitle", "time": 8894.71, "timestamp": "02:28:14", "text": "短い流れです。"}, {"type": "subtitle", "time": 8897.51, "timestamp": "02:28:17", "text": "明日はASMRをするか、"}, {"type": "subtitle", "time": 8901.67, "timestamp": "02:28:21", "text": "ASMRをやっていて、明日は待つことになる"}, {"type": "subtitle", "time": 8903.59, "timestamp": "02:28:23", "text": "明日は運転免許の授業があるから。私"}, {"type": "subtitle", "time": 8906.87, "timestamp": "02:28:26", "text": "朝のようにはできない。だから、私たちは"}, {"type": "subtitle", "time": 8911.75, "timestamp": "02:28:31", "text": "10時か12時頃のアート配信"}, {"type": "subtitle", "time": 8915.429, "timestamp": "02:28:35", "text": "もしくは午後の何か。"}, {"type": "subtitle", "time": 8918.07, "timestamp": "02:28:38", "text": "うん、ASMRをやるかもしれないし、"}, {"type": "subtitle", "time": 8922.309, "timestamp": "02:28:42", "text": "夜と同じように芸術活動を行う。ねえ、それは"}, {"type": "subtitle", "time": 8924.95, "timestamp": "02:28:44", "text": "約4時間。はい、3時間57分"}, {"type": "subtitle", "time": 8927.349, "timestamp": "02:28:47", "text": "私は今、配信を始めました。こんにちは。そして何が"}, {"type": "subtitle", "time": 8928.95, "timestamp": "02:28:48", "text": "それ以外？ほかに何か？ほかに何か？えっと、ありますか？"}, {"type": "subtitle", "time": 8930.96, "timestamp": "02:28:50", "text": "他に何か？私が忘れたのでしょうか？"}, {"type": "subtitle", "time": 8933.429, "timestamp": "02:28:53", "text": "[音楽]"}, {"type": "subtitle", "time": 8937.03, "timestamp": "02:28:57", "text": "こんにちは。ええと、以上です。はい、私はそう思います"}]
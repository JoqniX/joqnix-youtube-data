[{"type": "subtitle", "time": 9481.99, "timestamp": "02:38:01", "text": "これはエンチャントテーブルです。"}, {"type": "subtitle", "time": 9486.15, "timestamp": "02:38:06", "text": "まるで私が全身に魔法のかかった鎧を装備しているかのように。私は"}, {"type": "subtitle", "time": 9491.72, "timestamp": "02:38:11", "text": "ここに来て何かをするんだよ。上へ行け。"}, {"type": "subtitle", "time": 9494.389, "timestamp": "02:38:14", "text": "[音楽]"}, {"type": "subtitle", "time": 9505.11, "timestamp": "02:38:25", "text": "待って、それはああ、そうだね。青いやつ。私"}, {"type": "subtitle", "time": 9508.469, "timestamp": "02:38:28", "text": "これを覚えておいてください。うん。うん。そして"}, {"type": "subtitle", "time": 9512.15, "timestamp": "02:38:32", "text": "上は私たちが寝たりしていたもので、"}, {"type": "subtitle", "time": 9514.23, "timestamp": "02:38:34", "text": "狩猟用の道具をくれた"}, {"type": "subtitle", "time": 9516.95, "timestamp": "02:38:36", "text": "天気も良くて、苦いこともたくさんありました"}, {"type": "subtitle", "time": 9519.83, "timestamp": "02:38:39", "text": "頭蓋骨とか、そういう類のもの。ここに"}, {"type": "subtitle", "time": 9521.91, "timestamp": "02:38:41", "text": "私はそこで多くの時間を過ごしました"}, {"type": "subtitle", "time": 9525.03, "timestamp": "02:38:45", "text": "ゲーム。うん。うん。うん。シャ貝"}, {"type": "subtitle", "time": 9528.87, "timestamp": "02:38:48", "text": "などなど。何てことだ。"}, {"type": "subtitle", "time": 9532.87, "timestamp": "02:38:52", "text": "あなたはたくさんの貝殻を持っていましたね。私はこう思った"}, {"type": "subtitle", "time": 9534.389, "timestamp": "02:38:54", "text": "どうやって"}, {"type": "subtitle", "time": 9536.87, "timestamp": "02:38:56", "text": "それから私たちはドラゴンを倒したりした。"}, {"type": "subtitle", "time": 9538.469, "timestamp": "02:38:58", "text": "うん。"}]
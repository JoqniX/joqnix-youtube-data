[{"type": "subtitle", "time": 19261.67, "timestamp": "05:21:01", "text": "つまり、日本だ。私に話して。私に話して"}, {"type": "subtitle", "time": 19286.07, "timestamp": "05:21:26", "text": "ええ、日本語で話し続けましょう。"}, {"type": "subtitle", "time": 19288.15, "timestamp": "05:21:28", "text": "これは研修になります。"}, {"type": "subtitle", "time": 19292.15, "timestamp": "05:21:32", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 19306.15, "timestamp": "05:21:46", "text": "えっと、"}, {"type": "subtitle", "time": 19315.27, "timestamp": "05:21:55", "text": "ええと、しばらくしてから。それはどう言うんですか？"}, {"type": "subtitle", "time": 19319.27, "timestamp": "05:21:59", "text": "しばらくして。えっと、"}]
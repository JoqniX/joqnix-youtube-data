[{"type": "subtitle", "time": 16981.43, "timestamp": "04:43:01", "text": "もったいない気がする。"}, {"type": "subtitle", "time": 16987.24, "timestamp": "04:43:07", "text": "永遠の別れ。"}, {"type": "subtitle", "time": 16988.55, "timestamp": "04:43:08", "text": "[音楽]"}, {"type": "subtitle", "time": 16991.51, "timestamp": "04:43:11", "text": "私は剣を投げた。"}, {"type": "subtitle", "time": 16994.708, "timestamp": "04:43:14", "text": "つまり、それは下の方にあるだろう。"}, {"type": "subtitle", "time": 16998.31, "timestamp": "04:43:18", "text": "一滴残らず。そうそう。すべてがダウンしている"}, {"type": "subtitle", "time": 16999.99, "timestamp": "04:43:19", "text": "ここ。"}, {"type": "subtitle", "time": 17003.43, "timestamp": "04:43:23", "text": "それなら、これからも挑戦し続けます。"}, {"type": "subtitle", "time": 17007.75, "timestamp": "04:43:27", "text": "それとも水に浸けるべきでしょうか"}, {"type": "subtitle", "time": 17011.19, "timestamp": "04:43:31", "text": "それを食べる魚は？"}, {"type": "subtitle", "time": 17013.91, "timestamp": "04:43:33", "text": "どのように進めたいですか？"}, {"type": "subtitle", "time": 17015.68, "timestamp": "04:43:35", "text": "何？"}, {"type": "subtitle", "time": 17018.15, "timestamp": "04:43:38", "text": "[音楽]"}, {"type": "subtitle", "time": 17019.83, "timestamp": "04:43:39", "text": "うん。"}, {"type": "subtitle", "time": 17022.708, "timestamp": "04:43:42", "text": "私の番を見つけてくれてありがとう。"}, {"type": "subtitle", "time": 17025.35, "timestamp": "04:43:45", "text": "よし、タイミングも最高だった"}, {"type": "subtitle", "time": 17027.43, "timestamp": "04:43:47", "text": "音楽が好きです。"}, {"type": "subtitle", "time": 17034.07, "timestamp": "04:43:54", "text": "インドネシアからエールを送ります。"}, {"type": "subtitle", "time": 17037.91, "timestamp": "04:43:57", "text": "ええ、たくさんの思い出をありがとう。"}]
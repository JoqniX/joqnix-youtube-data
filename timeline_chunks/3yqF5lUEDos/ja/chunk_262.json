[{"type": "subtitle", "time": 15722.389, "timestamp": "04:22:02", "text": "うん。待って。すべて何ヶ月だったか"}, {"type": "subtitle", "time": 15725.59, "timestamp": "04:22:05", "text": "ハッサバ年齢？私は推測する"}, {"type": "subtitle", "time": 15727.429, "timestamp": "04:22:07", "text": "えっと、F3。"}, {"type": "subtitle", "time": 15730.63, "timestamp": "04:22:10", "text": "3年ですよね？あるいは、そんな感じ。いいえ、"}, {"type": "subtitle", "time": 15739.91, "timestamp": "04:22:19", "text": "しかし、サーバーは少なくとも5年前のものである。"}, {"type": "subtitle", "time": 15742.71, "timestamp": "04:22:22", "text": "古い。うん。 5歳。うん。うん。"}, {"type": "subtitle", "time": 15756.469, "timestamp": "04:22:36", "text": "ああ、Discord を設定しました"}, {"type": "subtitle", "time": 15758.87, "timestamp": "04:22:38", "text": "Discordのやつ。"}, {"type": "subtitle", "time": 15761.67, "timestamp": "04:22:41", "text": "まだ動いているのかな。"}, {"type": "subtitle", "time": 15768.469, "timestamp": "04:22:48", "text": "サーバ。"}, {"type": "subtitle", "time": 15775.189, "timestamp": "04:22:55", "text": "[音楽]"}]
[{"type": "subtitle", "time": 18723.11, "timestamp": "05:12:03", "text": "闇は純粋だ、そう言ってみろ。今、暗闇は"}, {"type": "subtitle", "time": 18725.74, "timestamp": "05:12:05", "text": "純粋で、まさに魔法のようだ。"}, {"type": "subtitle", "time": 18726.948, "timestamp": "05:12:06", "text": "[音楽]"}, {"type": "subtitle", "time": 18729.75, "timestamp": "05:12:09", "text": "うん。彼はそういう人だろう。彼は"}, {"type": "subtitle", "time": 18733.67, "timestamp": "05:12:13", "text": "そうして永遠に。何が"}, {"type": "subtitle", "time": 18735.99, "timestamp": "05:12:15", "text": "本の歴史"}, {"type": "subtitle", "time": 18740.47, "timestamp": "05:12:20", "text": "彼の百科事典ではこうなっている"}, {"type": "subtitle", "time": 18742.788, "timestamp": "05:12:22", "text": "でもそう言っておきます"}, {"type": "subtitle", "time": 18753.11, "timestamp": "05:12:33", "text": "[笑い]"}, {"type": "subtitle", "time": 18762.47, "timestamp": "05:12:42", "text": "あなたの言うことは"}, {"type": "subtitle", "time": 18775.51, "timestamp": "05:12:55", "text": "こんにちは。"}]
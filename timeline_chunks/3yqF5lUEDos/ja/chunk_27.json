[{"type": "subtitle", "time": 1627.51, "timestamp": "00:27:07", "text": "私のチャットが削除されました。え、何？それは"}, {"type": "subtitle", "time": 1635.51, "timestamp": "00:27:15", "text": "目標を取っただけです。"}, {"type": "subtitle", "time": 1664.47, "timestamp": "00:27:44", "text": "こんにちは。私の子供は連れ去られた。わからない"}, {"type": "subtitle", "time": 1667.669, "timestamp": "00:27:47", "text": "何が起こっていますか。ズーク"}, {"type": "subtitle", "time": 1674.71, "timestamp": "00:27:54", "text": "こんにちは。アメリカ国旗。"}, {"type": "subtitle", "time": 1676.95, "timestamp": "00:27:56", "text": "さあ行こう。我々は目標を失った"}]
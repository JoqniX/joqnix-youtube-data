[{"type": "subtitle", "time": 10809.51, "timestamp": "03:00:09", "text": "えっと、"}, {"type": "subtitle", "time": 10811.19, "timestamp": "03:00:11", "text": "わかった。私は近くにいます。私はただ手に入れるだけです"}, {"type": "subtitle", "time": 10813.11, "timestamp": "03:00:13", "text": "つるはしを持って降りてくる。降りてくる。"}, {"type": "subtitle", "time": 10817.429, "timestamp": "03:00:17", "text": "あなたは誰ですか？私もあなたと同じ気持ちです。何？"}, {"type": "subtitle", "time": 10825.11, "timestamp": "03:00:25", "text": "念のため、つるはしを持っていく。それは"}, {"type": "subtitle", "time": 10828.79, "timestamp": "03:00:28", "text": "サーバーに残っているダイヤモンドはすべて。"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "何てことだ。"}, {"type": "subtitle", "time": 10834.07, "timestamp": "03:00:34", "text": "えっと、私のダイヤモンドはエンダーチェストの中にありました。"}, {"type": "subtitle", "time": 10839.59, "timestamp": "03:00:39", "text": "私は自分の側で確認していませんでした。あ、待って。一度もない"}, {"type": "subtitle", "time": 10842.389, "timestamp": "03:00:42", "text": "心。そこにはないだろう。"}, {"type": "subtitle", "time": 10846.469, "timestamp": "03:00:46", "text": "そしてここは、えーと、ここはここです。わかった、"}, {"type": "subtitle", "time": 10848.79, "timestamp": "03:00:48", "text": "その話はやめよう。"}, {"type": "subtitle", "time": 10852.469, "timestamp": "03:00:52", "text": "戻ってきたら見せてあげるよ。こんにちは。私は"}, {"type": "subtitle", "time": 10859.11, "timestamp": "03:00:59", "text": "電話。電話。今行ってる。あなたは"}]
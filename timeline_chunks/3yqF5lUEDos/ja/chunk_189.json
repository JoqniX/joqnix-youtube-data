[{"type": "subtitle", "time": 11340.71, "timestamp": "03:09:00", "text": "ああ、彼女の名前は？彼女の名前は何ですか？"}, {"type": "subtitle", "time": 11343.51, "timestamp": "03:09:03", "text": "何？誰が？望んでいた人"}, {"type": "subtitle", "time": 11346.15, "timestamp": "03:09:06", "text": "デビューする予定だったが、デビューできなかった理由は"}, {"type": "subtitle", "time": 11347.75, "timestamp": "03:09:07", "text": "インターネット。"}, {"type": "subtitle", "time": 11350.15, "timestamp": "03:09:10", "text": "インターネットのおかげで。"}, {"type": "subtitle", "time": 11355.75, "timestamp": "03:09:15", "text": "ええと、覚えてはいるんですが、言えません。"}, {"type": "subtitle", "time": 11357.51, "timestamp": "03:09:17", "text": "うん。"}, {"type": "subtitle", "time": 11360.15, "timestamp": "03:09:20", "text": "舌先まで出かかっているのに。"}, {"type": "subtitle", "time": 11361.99, "timestamp": "03:09:21", "text": "どうしたの？"}, {"type": "subtitle", "time": 11365.429, "timestamp": "03:09:25", "text": "竹林や木々も見てください"}, {"type": "subtitle", "time": 11367.75, "timestamp": "03:09:27", "text": "そこには。"}, {"type": "subtitle", "time": 11370.07, "timestamp": "03:09:30", "text": "うん。サトウキビから作られたものもある"}, {"type": "subtitle", "time": 11374.309, "timestamp": "03:09:34", "text": "あなたによって。どれだと思う？"}, {"type": "subtitle", "time": 11386.389, "timestamp": "03:09:46", "text": "そしてあなたの家"}, {"type": "subtitle", "time": 11388.469, "timestamp": "03:09:48", "text": "あなたの家。"}, {"type": "subtitle", "time": 11396.07, "timestamp": "03:09:56", "text": "これらのことを忘れていました。"}]
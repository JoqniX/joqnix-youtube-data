[{"type": "subtitle", "time": 18300.868, "timestamp": "05:05:00", "text": "ビデオ。私は好きではないと思います、私は見たいです"}, {"type": "subtitle", "time": 18303.91, "timestamp": "05:05:03", "text": "以前から、あるいは少なくとも彼らがコラボレーションしているのを見たことがある"}, {"type": "subtitle", "time": 18307.03, "timestamp": "05:05:07", "text": "エマと一緒にいたはずなのに、思い出せなかった。"}, {"type": "subtitle", "time": 18311.27, "timestamp": "05:05:11", "text": "うん。そして、彼らはただ話したかっただけだった"}, {"type": "subtitle", "time": 18314.07, "timestamp": "05:05:14", "text": "なぜか私と一緒にいる。"}, {"type": "subtitle", "time": 18319.27, "timestamp": "05:05:19", "text": "「えっと、つまり、どうやって"}, {"type": "subtitle", "time": 18323.75, "timestamp": "05:05:23", "text": "「これは日本語ですか？」私は「ええと、"}, {"type": "subtitle", "time": 18325.59, "timestamp": "05:05:25", "text": "「彼らは英語を話すのか？」それが"}, {"type": "subtitle", "time": 18329.43, "timestamp": "05:05:29", "text": "私がエマに尋ねた最初の質問"}, {"type": "subtitle", "time": 18333.51, "timestamp": "05:05:33", "text": "それから。そして、「ああ、ごめんなさい」"}, {"type": "subtitle", "time": 18335.83, "timestamp": "05:05:35", "text": "これについては、我慢しなければならない"}, {"type": "subtitle", "time": 18341.27, "timestamp": "05:05:41", "text": "まさにその通り。"}, {"type": "subtitle", "time": 18350.39, "timestamp": "05:05:50", "text": "いくつかのゲームについて話したように、"}, {"type": "subtitle", "time": 18357.03, "timestamp": "05:05:57", "text": "それから"}, {"type": "subtitle", "time": 18359.75, "timestamp": "05:05:59", "text": "そして私は惨めに失敗した。"}]
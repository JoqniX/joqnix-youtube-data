[{"type": "subtitle", "time": 10740.95, "timestamp": "02:59:00", "text": "うん、"}, {"type": "subtitle", "time": 10744.15, "timestamp": "02:59:04", "text": "木製のものを作ってみよう"}, {"type": "subtitle", "time": 10748.71, "timestamp": "02:59:08", "text": "あるいは、そんな感じ。ああ、ここには鉄があるよ。"}, {"type": "subtitle", "time": 10751.91, "timestamp": "02:59:11", "text": "もしかしたらそうかもしれない。ああ、このインタールームは"}, {"type": "subtitle", "time": 10758.71, "timestamp": "02:59:18", "text": "何てことだ。"}, {"type": "subtitle", "time": 10762.469, "timestamp": "02:59:22", "text": "リュックサックを持っていくべきだった。ああ、私は"}, {"type": "subtitle", "time": 10764.469, "timestamp": "02:59:24", "text": "もうすぐそこだという意味です。私たちはただ手に入れることができます"}, {"type": "subtitle", "time": 10777.03, "timestamp": "02:59:37", "text": "はい、ゆっくりで構いません。ここに来て。どこ"}, {"type": "subtitle", "time": 10782.389, "timestamp": "02:59:42", "text": "行きましたか？私はクリスタルを取りに行った"}, {"type": "subtitle", "time": 10784.71, "timestamp": "02:59:44", "text": "つるはし。"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "えっと、待って。ここはどこですか？待って、"}, {"type": "subtitle", "time": 10789.99, "timestamp": "02:59:49", "text": "私たちは同じ場所にいるの？待って、待って、待って。"}, {"type": "subtitle", "time": 10795.59, "timestamp": "02:59:55", "text": "我慢する。これは、"}, {"type": "subtitle", "time": 10799.03, "timestamp": "02:59:59", "text": "チャットに新しい人がいるのを見ましたが、"}]
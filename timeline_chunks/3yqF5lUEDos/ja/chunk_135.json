[{"type": "subtitle", "time": 8101.189, "timestamp": "02:15:01", "text": "私に知らせてくれてありがとう。"}, {"type": "subtitle", "time": 8103.109, "timestamp": "02:15:03", "text": "調整できる。"}, {"type": "subtitle", "time": 8105.189, "timestamp": "02:15:05", "text": "はい。"}, {"type": "subtitle", "time": 8108.629, "timestamp": "02:15:08", "text": "えっと、今週の予定はこんな感じです。今日は"}, {"type": "subtitle", "time": 8111.43, "timestamp": "02:15:11", "text": "今日は土曜日です。"}, {"type": "subtitle", "time": 8113.51, "timestamp": "02:15:13", "text": "明日は日曜日です。明日は"}, {"type": "subtitle", "time": 8115.51, "timestamp": "02:15:15", "text": "ASMR。"}, {"type": "subtitle", "time": 8119.669, "timestamp": "02:15:19", "text": "深夜のASMRをお届けします。"}, {"type": "subtitle", "time": 8122.95, "timestamp": "02:15:22", "text": "でも、皆さんは早朝のASMRが見たいですか？"}, {"type": "subtitle", "time": 8127.27, "timestamp": "02:15:27", "text": "ASMRが好きですか？皆さんに気に入ってもらいたい"}, {"type": "subtitle", "time": 8134.31, "timestamp": "02:15:34", "text": "耳が死んでしまった。"}, {"type": "subtitle", "time": 8151.99, "timestamp": "02:15:51", "text": "はい、そうです。えっと、"}, {"type": "subtitle", "time": 8153.83, "timestamp": "02:15:53", "text": "ほかに何か？"}, {"type": "subtitle", "time": 8157.189, "timestamp": "02:15:57", "text": "ええと、しばらくASAをやってないんです。"}, {"type": "subtitle", "time": 8159.91, "timestamp": "02:15:59", "text": "右？明日やります。それ"}]
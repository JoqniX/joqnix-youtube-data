[{"type": "subtitle", "time": 12781.91, "timestamp": "03:33:01", "text": "[音楽]"}, {"type": "subtitle", "time": 12785.75, "timestamp": "03:33:05", "text": "何も見えません。私のバックアップです。"}, {"type": "subtitle", "time": 12788.95, "timestamp": "03:33:08", "text": "待って、本当にここに置いたの？"}, {"type": "subtitle", "time": 12792.309, "timestamp": "03:33:12", "text": "ええ、ここにありました。"}, {"type": "subtitle", "time": 12799.11, "timestamp": "03:33:19", "text": "そうそう。今思い出した。うん。うん。"}, {"type": "subtitle", "time": 12800.79, "timestamp": "03:33:20", "text": "ここはここは私たちが"}, {"type": "subtitle", "time": 12802.87, "timestamp": "03:33:22", "text": "できたよ。"}, {"type": "subtitle", "time": 12805.19, "timestamp": "03:33:25", "text": "うん。"}, {"type": "subtitle", "time": 12807.67, "timestamp": "03:33:27", "text": "コマンドブロックを使用して生成しました"}, {"type": "subtitle", "time": 12810.07, "timestamp": "03:33:30", "text": "ブロックとか色々"}, {"type": "subtitle", "time": 12813.51, "timestamp": "03:33:33", "text": "全く新しい飛行機と、その他すべてについて。"}, {"type": "subtitle", "time": 12817.03, "timestamp": "03:33:37", "text": "うん。遊び場。はい。わかった。そこには"}, {"type": "subtitle", "time": 12826.55, "timestamp": "03:33:46", "text": "ああ、彼も家を持っている。つまり未完成"}, {"type": "subtitle", "time": 12828.309, "timestamp": "03:33:48", "text": "家。"}, {"type": "subtitle", "time": 12831.11, "timestamp": "03:33:51", "text": "M"}, {"type": "subtitle", "time": 12835.11, "timestamp": "03:33:55", "text": "寿司の息子がここにいました。そうそう。寿司は"}, {"type": "subtitle", "time": 12838.05, "timestamp": "03:33:58", "text": "うん。うん。うん。うん。うん。"}]
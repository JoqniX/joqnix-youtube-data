[{"type": "subtitle", "time": 5467.43, "timestamp": "01:31:07", "text": "私たちは今、どのような状況にあるのか？"}, {"type": "subtitle", "time": 5469.75, "timestamp": "01:31:09", "text": "それは良くないですね、旦那様。我々は戦争を安全にする必要がある"}, {"type": "subtitle", "time": 5472.25, "timestamp": "01:31:12", "text": "地域。確保する必要がある。"}, {"type": "subtitle", "time": 5474.31, "timestamp": "01:31:14", "text": "[音楽]"}, {"type": "subtitle", "time": 5483.11, "timestamp": "01:31:23", "text": "敵陣へ突入する。"}, {"type": "subtitle", "time": 5484.79, "timestamp": "01:31:24", "text": "野原を駆け抜けて"}, {"type": "subtitle", "time": 5487.35, "timestamp": "01:31:27", "text": "戦争。私は撃たれそうになっている。私は手に入れている"}, {"type": "subtitle", "time": 5491.35, "timestamp": "01:31:31", "text": "左右に撃たれた。何てことだ。"}, {"type": "subtitle", "time": 5493.99, "timestamp": "01:31:33", "text": "ああ、撃たれた。私は走っています"}, {"type": "subtitle", "time": 5497.99, "timestamp": "01:31:37", "text": "アルファワンに向けて。さあ行こう。"}, {"type": "subtitle", "time": 5502.55, "timestamp": "01:31:42", "text": "ああ、雪だ。雪だ。"}, {"type": "subtitle", "time": 5504.07, "timestamp": "01:31:44", "text": "さあ行こう。"}, {"type": "subtitle", "time": 5512.79, "timestamp": "01:31:52", "text": "このエリアを占領してみてください。"}, {"type": "subtitle", "time": 5514.709, "timestamp": "01:31:54", "text": "誰もいない。これを捉えようとしています"}]
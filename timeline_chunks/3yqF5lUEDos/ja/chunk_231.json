[{"type": "subtitle", "time": 13865.59, "timestamp": "03:51:05", "text": "君の姿が見えない。"}, {"type": "subtitle", "time": 13873.03, "timestamp": "03:51:13", "text": "ああ、これは"}, {"type": "subtitle", "time": 13875.67, "timestamp": "03:51:15", "text": "これ。待って。"}, {"type": "subtitle", "time": 13886.87, "timestamp": "03:51:26", "text": "私はくしゃみをしていた。"}, {"type": "subtitle", "time": 13889.75, "timestamp": "03:51:29", "text": "だから、これは私たちの"}, {"type": "subtitle", "time": 13893.64, "timestamp": "03:51:33", "text": "えっと、フェスティバル"}, {"type": "subtitle", "time": 13905.99, "timestamp": "03:51:45", "text": "その祭り。うん。えっと、なんで負けたんだろう"}, {"type": "subtitle", "time": 13909.269, "timestamp": "03:51:49", "text": "フェスティバルのイベントにはこれがありました"}, {"type": "subtitle", "time": 13914.63, "timestamp": "03:51:54", "text": "大きなカメで、水族館みたいなの知ってるでしょ。"}]
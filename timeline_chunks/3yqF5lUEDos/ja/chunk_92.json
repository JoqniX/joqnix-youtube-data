[{"type": "subtitle", "time": 5521.669, "timestamp": "01:32:01", "text": "ええ、実際は誰もいません。"}, {"type": "subtitle", "time": 5525.11, "timestamp": "01:32:05", "text": "制御しようとしている。"}, {"type": "subtitle", "time": 5528.629, "timestamp": "01:32:08", "text": "ああ、あれは怖かった。なんてこった？"}, {"type": "subtitle", "time": 5537.83, "timestamp": "01:32:17", "text": "こうやって隠れるよ。"}, {"type": "subtitle", "time": 5541.51, "timestamp": "01:32:21", "text": "私はアルファ1に参加しています。コピー。誰かコピーした？"}, {"type": "subtitle", "time": 5543.75, "timestamp": "01:32:23", "text": "手伝ってください。"}, {"type": "subtitle", "time": 5545.51, "timestamp": "01:32:25", "text": "待って。"}, {"type": "subtitle", "time": 5547.669, "timestamp": "01:32:27", "text": "手伝ってください。"}, {"type": "subtitle", "time": 5552.95, "timestamp": "01:32:32", "text": "援護が必要だ。援護が必要だ。バックアップ。"}, {"type": "subtitle", "time": 5555.91, "timestamp": "01:32:35", "text": "引き取りが必要です。"}, {"type": "subtitle", "time": 5558.79, "timestamp": "01:32:38", "text": "交通手段を持っている人はいますか？"}, {"type": "subtitle", "time": 5561.03, "timestamp": "01:32:41", "text": "E4に行く必要がある"}, {"type": "subtitle", "time": 5563.59, "timestamp": "01:32:43", "text": "自己再構築する。"}, {"type": "subtitle", "time": 5567.11, "timestamp": "01:32:47", "text": "待って、援軍が必要だ。"}]
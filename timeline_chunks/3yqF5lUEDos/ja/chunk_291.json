[{"type": "subtitle", "time": 17460.23, "timestamp": "04:51:00", "text": "体の動きを使って、"}, {"type": "subtitle", "time": 17464.23, "timestamp": "04:51:04", "text": "脳のネットワーク。わかった。それは、"}, {"type": "subtitle", "time": 17466.15, "timestamp": "04:51:06", "text": "画像をあなたの"}, {"type": "subtitle", "time": 17468.15, "timestamp": "04:51:08", "text": "脳は、あなたが考えるようにする"}, {"type": "subtitle", "time": 17470.55, "timestamp": "04:51:10", "text": "試合に出ていた。まさにその通りです。ああ"}, {"type": "subtitle", "time": 17472.47, "timestamp": "04:51:12", "text": "うん"}, {"type": "subtitle", "time": 17474.628, "timestamp": "04:51:14", "text": "しかし、キューブのような概念は"}, {"type": "subtitle", "time": 17477.43, "timestamp": "04:51:17", "text": "でも、かっこいいですね。 SEOのように感じました"}, {"type": "subtitle", "time": 17480.55, "timestamp": "04:51:20", "text": "それを言ったときの、神学的なこと"}, {"type": "subtitle", "time": 17481.43, "timestamp": "04:51:21", "text": "自分。"}, {"type": "subtitle", "time": 17484.55, "timestamp": "04:51:24", "text": "私は「なんてことだ」と思いました。"}, {"type": "subtitle", "time": 17487.27, "timestamp": "04:51:27", "text": "あなたに何があったのか気になります。彼らはできる"}, {"type": "subtitle", "time": 17489.99, "timestamp": "04:51:29", "text": "実際にはさらに進歩する。うん。うん。"}, {"type": "subtitle", "time": 17492.868, "timestamp": "04:51:32", "text": "うん。うん。彼らにはそれが可能だった。はい。彼らはできる"}, {"type": "subtitle", "time": 17495.27, "timestamp": "04:51:35", "text": "さらに前進する。"}, {"type": "subtitle", "time": 17497.99, "timestamp": "04:51:37", "text": "一番必要なのは"}, {"type": "subtitle", "time": 17500.31, "timestamp": "04:51:40", "text": "優れた電源。"}, {"type": "subtitle", "time": 17502.628, "timestamp": "04:51:42", "text": "ああ、そうだ。"}, {"type": "subtitle", "time": 17504.788, "timestamp": "04:51:44", "text": "つまり、彼らはいつでも挑戦できると思う"}, {"type": "subtitle", "time": 17507.19, "timestamp": "04:51:47", "text": "反応性元素"}, {"type": "subtitle", "time": 17510.23, "timestamp": "04:51:50", "text": "権力のために。"}, {"type": "subtitle", "time": 17513.27, "timestamp": "04:51:53", "text": "いいと思うけど、やめた方がいいと思う"}, {"type": "subtitle", "time": 17515.67, "timestamp": "04:51:55", "text": "機密事項について話す。うん。"}, {"type": "subtitle", "time": 17518.39, "timestamp": "04:51:58", "text": "うん。そうすべきではありません。うん。うん。"}]
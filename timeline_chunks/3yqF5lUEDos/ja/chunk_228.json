[{"type": "subtitle", "time": 13684.55, "timestamp": "03:48:04", "text": "うん。変更を加えて「読む」をクリックしてください。"}, {"type": "subtitle", "time": 13687.349, "timestamp": "03:48:07", "text": "不動産のみ。"}, {"type": "subtitle", "time": 13697.51, "timestamp": "03:48:17", "text": "私たちは道に迷ったのかもしれない。"}, {"type": "subtitle", "time": 13705.11, "timestamp": "03:48:25", "text": "見てみましょう。"}, {"type": "subtitle", "time": 13708.469, "timestamp": "03:48:28", "text": "私たちは登録から来たのですか？"}, {"type": "subtitle", "time": 13711.75, "timestamp": "03:48:31", "text": "ああ、そう、まっすぐI"}, {"type": "subtitle", "time": 13715.83, "timestamp": "03:48:35", "text": "推測。いいえ。近くのどこかでですか？"}, {"type": "subtitle", "time": 13718.55, "timestamp": "03:48:38", "text": "うん。"}, {"type": "subtitle", "time": 13720.309, "timestamp": "03:48:40", "text": "つまり、もし場所が見つかったら、"}, {"type": "subtitle", "time": 13723.75, "timestamp": "03:48:43", "text": "コースはあなたのところへテレポートします。うん。ああ、"}, {"type": "subtitle", "time": 13725.83, "timestamp": "03:48:45", "text": "真っ直ぐ。真っ直ぐ。わかった。見つけた。私"}, {"type": "subtitle", "time": 13728.469, "timestamp": "03:48:48", "text": "ビーコンを見てください。うん、"}]
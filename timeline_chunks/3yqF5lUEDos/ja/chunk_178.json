[{"type": "subtitle", "time": 10681.91, "timestamp": "02:58:01", "text": "宝箱の中には何も入っていなかった。"}, {"type": "subtitle", "time": 10684.55, "timestamp": "02:58:04", "text": "痛み。しかし、ここには確かに誰かがいます。"}, {"type": "subtitle", "time": 10686.71, "timestamp": "02:58:06", "text": "ここに何かある。"}, {"type": "subtitle", "time": 10690.95, "timestamp": "02:58:10", "text": "間違っていなければ、カーペットを1枚作ってください。"}, {"type": "subtitle", "time": 10697.11, "timestamp": "02:58:17", "text": "ダイヤモンド。"}, {"type": "subtitle", "time": 10699.269, "timestamp": "02:58:19", "text": "うん。"}, {"type": "subtitle", "time": 10708.79, "timestamp": "02:58:28", "text": "いくつありますか？"}, {"type": "subtitle", "time": 10714.79, "timestamp": "02:58:34", "text": "九。"}, {"type": "subtitle", "time": 10723.99, "timestamp": "02:58:43", "text": "ダイヤモンドは見えるようにしておこう。"}, {"type": "subtitle", "time": 10727.03, "timestamp": "02:58:47", "text": "ええ、私はそれらを手に入れたくないんです。さあ"}, {"type": "subtitle", "time": 10730.07, "timestamp": "02:58:50", "text": "鎧を作る。"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "持っていません。木製です。私はしませんでした"}]
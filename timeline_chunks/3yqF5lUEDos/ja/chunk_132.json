[{"type": "subtitle", "time": 7920.72, "timestamp": "02:12:00", "text": "楽しい。とても楽しかったです。はい、"}, {"type": "subtitle", "time": 7922.149, "timestamp": "02:12:02", "text": "[音楽]"}, {"type": "subtitle", "time": 7924.069, "timestamp": "02:12:04", "text": "私たちは彼の情報源について話しています"}, {"type": "subtitle", "time": 7930.31, "timestamp": "02:12:10", "text": "これは重要です"}, {"type": "subtitle", "time": 7933.03, "timestamp": "02:12:13", "text": "あなたのバカな喜びは学ぶことです"}, {"type": "subtitle", "time": 7937.589, "timestamp": "02:12:17", "text": "すぐに、そして言葉を使う"}, {"type": "subtitle", "time": 7957.99, "timestamp": "02:12:37", "text": "それで、ヴァレラントのアップデートについて"}, {"type": "subtitle", "time": 7960.069, "timestamp": "02:12:40", "text": "バルーントーナメント。"}, {"type": "subtitle", "time": 7963.35, "timestamp": "02:12:43", "text": "バルーン大会は開催されません"}, {"type": "subtitle", "time": 7967.75, "timestamp": "02:12:47", "text": "今月に。 1月に開催されます"}, {"type": "subtitle", "time": 7971.589, "timestamp": "02:12:51", "text": "1月16日か17日。それでいくつか手に入れました"}, {"type": "subtitle", "time": 7973.35, "timestamp": "02:12:53", "text": "キャプチャカードを手に入れるまでの時間"}, {"type": "subtitle", "time": 7974.95, "timestamp": "02:12:54", "text": "すべて。"}, {"type": "subtitle", "time": 7977.589, "timestamp": "02:12:57", "text": "キャプチャーカードが手に入るよう祈りましょう"}]
[{"type": "subtitle", "time": 9788.15, "timestamp": "02:43:08", "text": "うん。ミアもこの場所にいた。うん。"}, {"type": "subtitle", "time": 9791.83, "timestamp": "02:43:11", "text": "そして、この人物は一体誰だったのか？ここは強盗の場所ですか？"}, {"type": "subtitle", "time": 9795.91, "timestamp": "02:43:15", "text": "わかった。これもヒカリスだと言えるでしょう。うん。"}, {"type": "subtitle", "time": 9798.71, "timestamp": "02:43:18", "text": "ありがとう。彼女はいくつか物を残していった。どこ"}, {"type": "subtitle", "time": 9800.71, "timestamp": "02:43:20", "text": "私の家は？ああ、そうだね。うん。これ"}, {"type": "subtitle", "time": 9802.79, "timestamp": "02:43:22", "text": "ああ、そうだね。ここがその場所です。おお、"}, {"type": "subtitle", "time": 9806.55, "timestamp": "02:43:26", "text": "うん。私の犬の本部。"}, {"type": "subtitle", "time": 9810.07, "timestamp": "02:43:30", "text": "おいしい、おいしい。わかった。"}, {"type": "subtitle", "time": 9812.469, "timestamp": "02:43:32", "text": "うん。ここは羊毛農場がある場所です。"}, {"type": "subtitle", "time": 9815.67, "timestamp": "02:43:35", "text": "そして、ここがスタート地点です。いいえ。"}]
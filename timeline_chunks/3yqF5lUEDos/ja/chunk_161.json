[{"type": "subtitle", "time": 9667.51, "timestamp": "02:41:07", "text": "そうそう。ここは長い場所だ。うん。"}, {"type": "subtitle", "time": 9670.389, "timestamp": "02:41:10", "text": "うん。できません。"}, {"type": "subtitle", "time": 9673.75, "timestamp": "02:41:13", "text": "そして私たちはこれを気にしています。ええ、私たちはとても気にしています"}, {"type": "subtitle", "time": 9682.389, "timestamp": "02:41:22", "text": "うん。"}, {"type": "subtitle", "time": 9683.91, "timestamp": "02:41:23", "text": "わかった。私たちはどこから来たのか？わかった。の"}, {"type": "subtitle", "time": 9686.309, "timestamp": "02:41:26", "text": "胸。うん。"}, {"type": "subtitle", "time": 9692.63, "timestamp": "02:41:32", "text": "わかった。戻りましょう。特に何もない"}, {"type": "subtitle", "time": 9694.63, "timestamp": "02:41:34", "text": "通路以外には見るべきものはないが、"}, {"type": "subtitle", "time": 9706.95, "timestamp": "02:41:46", "text": "また別の経路もある"}, {"type": "subtitle", "time": 9709.11, "timestamp": "02:41:49", "text": "ダイヤモンドのために。ええ、これはああ、"}, {"type": "subtitle", "time": 9710.95, "timestamp": "02:41:50", "text": "ダイヤモンド。そうそう。うん。うん。これは"}, {"type": "subtitle", "time": 9713.67, "timestamp": "02:41:53", "text": "ダイヤモンドのために。"}, {"type": "subtitle", "time": 9715.03, "timestamp": "02:41:55", "text": "まるで、"}, {"type": "subtitle", "time": 9717.67, "timestamp": "02:41:57", "text": "2つのブロックのような構造。"}]
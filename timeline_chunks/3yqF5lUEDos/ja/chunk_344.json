[{"type": "subtitle", "time": 20640.47, "timestamp": "05:44:00", "text": "だって、えーっと、今日私は"}, {"type": "subtitle", "time": 20644.39, "timestamp": "05:44:04", "text": "ズキからの手紙を読んで"}, {"type": "subtitle", "time": 20647.19, "timestamp": "05:44:07", "text": "誕生日のお祝いの品が"}, {"type": "subtitle", "time": 20649.75, "timestamp": "05:44:09", "text": "私たちの古い家。いいえ。だから、ちょうど"}, {"type": "subtitle", "time": 20652.47, "timestamp": "05:44:12", "text": "ずっと望んでいた人たち"}, {"type": "subtitle", "time": 20656.39, "timestamp": "05:44:16", "text": "他のゲームをプレイする代わりに"}, {"type": "subtitle", "time": 20658.788, "timestamp": "05:44:18", "text": "マインクラフトや他のゲームのように"}, {"type": "subtitle", "time": 20661.43, "timestamp": "05:44:21", "text": "低スペックゲームは文字通り"}, {"type": "subtitle", "time": 20664.948, "timestamp": "05:44:24", "text": "アルスチャマとズキ。ええ、アルスチャと"}, {"type": "subtitle", "time": 20669.59, "timestamp": "05:44:29", "text": "ズキと他の数人も、だってある日"}, {"type": "subtitle", "time": 20672.23, "timestamp": "05:44:32", "text": "えーと、ようやく良いシステムを手に入れたら"}, {"type": "subtitle", "time": 20674.15, "timestamp": "05:44:34", "text": "そして、これで遊べるようになった。ない"}, {"type": "subtitle", "time": 20676.788, "timestamp": "05:44:36", "text": "制限。制限はありません"}, {"type": "subtitle", "time": 20679.27, "timestamp": "05:44:39", "text": "あれ。私たちはどんなゲームでもプレイできます"}, {"type": "subtitle", "time": 20682.708, "timestamp": "05:44:42", "text": "欲しい。どのような種類のものでも"}, {"type": "subtitle", "time": 20686.47, "timestamp": "05:44:46", "text": "やればいい、私たちはただそれをやるだけだ。そう、私は"}, {"type": "subtitle", "time": 20691.27, "timestamp": "05:44:51", "text": "やっと私は"}, {"type": "subtitle", "time": 20693.27, "timestamp": "05:44:53", "text": "最後に他の種類のゲームをプレイする"}, {"type": "subtitle", "time": 20695.35, "timestamp": "05:44:55", "text": "などなど。"}, {"type": "subtitle", "time": 20698.15, "timestamp": "05:44:58", "text": "そう、待ってるよ"}]
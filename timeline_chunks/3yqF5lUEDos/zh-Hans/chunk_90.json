[{"type": "subtitle", "time": 5425.27, "timestamp": "01:30:25", "text": "手榴弹。我的天哪，我喊得好大声。"}, {"type": "subtitle", "time": 5439.99, "timestamp": "01:30:39", "text": "我的天啊。努力工作直到找到我的老板。"}, {"type": "subtitle", "time": 5443.35, "timestamp": "01:30:43", "text": "我情绪不稳定，像条狗一样。是的。你好。做"}, {"type": "subtitle", "time": 5446.149, "timestamp": "01:30:46", "text": "你最好了解我勤奋的工作态度。"}, {"type": "subtitle", "time": 5447.669, "timestamp": "01:30:47", "text": "堵塞。"}]
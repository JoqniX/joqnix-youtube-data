[{"type": "subtitle", "time": 17402.868, "timestamp": "04:50:02", "text": "哦，那真酷。哇。"}, {"type": "subtitle", "time": 17405.59, "timestamp": "04:50:05", "text": "显然他们可以，他们确实制作了一个 I"}, {"type": "subtitle", "time": 17408.628, "timestamp": "04:50:08", "text": "知道正常情况，但阅读大脑"}, {"type": "subtitle", "time": 17411.67, "timestamp": "04:50:11", "text": "数据，或者更确切地说是写作，是的，他们"}, {"type": "subtitle", "time": 17414.788, "timestamp": "04:50:14", "text": "写不出来。"}, {"type": "subtitle", "time": 17420.15, "timestamp": "04:50:20", "text": "男人。"}, {"type": "subtitle", "time": 17423.99, "timestamp": "04:50:23", "text": "所以我认为他们会做些什么。"}, {"type": "subtitle", "time": 17427.75, "timestamp": "04:50:27", "text": "我实际品尝过这款啤酒。哦，你真的这么做了？"}, {"type": "subtitle", "time": 17431.35, "timestamp": "04:50:31", "text": "它怎么样？所以你就像……"}, {"type": "subtitle", "time": 17435.27, "timestamp": "04:50:35", "text": "站立着，就像完全有纹理一样"}, {"type": "subtitle", "time": 17438.788, "timestamp": "04:50:38", "text": "VR游戏。你可以点赞"}, {"type": "subtitle", "time": 17442.31, "timestamp": "04:50:42", "text": "一步一步来，我的意思是你可以走"}, {"type": "subtitle", "time": 17443.83, "timestamp": "04:50:43", "text": "大约"}, {"type": "subtitle", "time": 17446.868, "timestamp": "04:50:46", "text": "是的，你当时正开车，但你看到了"}, {"type": "subtitle", "time": 17449.27, "timestamp": "04:50:49", "text": "透过VR眼镜观看。它不是"}, {"type": "subtitle", "time": 17451.99, "timestamp": "04:50:51", "text": "直接投射到你的大脑。所以"}, {"type": "subtitle", "time": 17453.83, "timestamp": "04:50:53", "text": "就像你当时正在使用一个"}, {"type": "subtitle", "time": 17457.83, "timestamp": "04:50:57", "text": "普通的VR游戏，没错，你就是。"}]
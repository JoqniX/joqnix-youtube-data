[{"type": "subtitle", "time": 18601.43, "timestamp": "05:10:01", "text": "扭曲的状态，巴卡定子，锯"}, {"type": "subtitle", "time": 18606.868, "timestamp": "05:10:06", "text": "而且自从他……嗯……以来"}, {"type": "subtitle", "time": 18610.948, "timestamp": "05:10:10", "text": "他一直用这件事来逗我。"}, {"type": "subtitle", "time": 18614.23, "timestamp": "05:10:14", "text": "嗯哼。我懂了。我的天啊。那就是"}, {"type": "subtitle", "time": 18621.27, "timestamp": "05:10:21", "text": "我当时在试玩球。"}, {"type": "subtitle", "time": 18624.39, "timestamp": "05:10:24", "text": "不要那么随意地使用那个脏字。"}, {"type": "subtitle", "time": 18626.47, "timestamp": "05:10:26", "text": "那真是"}, {"type": "subtitle", "time": 18630.23, "timestamp": "05:10:30", "text": "深刻的词语。哦，对，那就像病毒一样。"}, {"type": "subtitle", "time": 18638.47, "timestamp": "05:10:38", "text": "不，不管留下来的人都知道，他会……不"}, {"type": "subtitle", "time": 18643.03, "timestamp": "05:10:43", "text": "他们现在就像培根一样，吃着面包。"}, {"type": "subtitle", "time": 18645.43, "timestamp": "05:10:45", "text": "其他人已经知道了，我不知道。"}, {"type": "subtitle", "time": 18648.47, "timestamp": "05:10:48", "text": "它像病毒一样传播开来。我必须"}, {"type": "subtitle", "time": 18651.03, "timestamp": "05:10:51", "text": "继续解释它们。这一切都是真的"}, {"type": "subtitle", "time": 18653.99, "timestamp": "05:10:53", "text": "这一切都是Steam数据库网站的错。我"}, {"type": "subtitle", "time": 18658.31, "timestamp": "05:10:58", "text": "我怪他们没有像……那样……"}]
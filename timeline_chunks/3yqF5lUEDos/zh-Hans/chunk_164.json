[{"type": "subtitle", "time": 9841.269, "timestamp": "02:44:01", "text": "好的，我们要去你们总部。"}, {"type": "subtitle", "time": 9843.67, "timestamp": "02:44:03", "text": "哦，是的。这个地方。你建造的那个。"}, {"type": "subtitle", "time": 9847.349, "timestamp": "02:44:07", "text": "这条长长的队伍。哦，是的。这个。哦，"}, {"type": "subtitle", "time": 9850.79, "timestamp": "02:44:10", "text": "是的。这个农场。是的。看，这里有一个"}, {"type": "subtitle", "time": 9854.07, "timestamp": "02:44:14", "text": "很多村民或劫掠者。"}, {"type": "subtitle", "time": 9858.63, "timestamp": "02:44:18", "text": "哇。不要攻击铁傀儡。"}, {"type": "subtitle", "time": 9863.51, "timestamp": "02:44:23", "text": "哦，是的。我记得这件事。"}, {"type": "subtitle", "time": 9865.99, "timestamp": "02:44:25", "text": "看看这个。这个竹林要走了"}, {"type": "subtitle", "time": 9875.429, "timestamp": "02:44:35", "text": "想上去？等等，你在哪里？"}, {"type": "subtitle", "time": 9877.59, "timestamp": "02:44:37", "text": "但该如何上去呢？我忘了。是那样吗？"}, {"type": "subtitle", "time": 9879.99, "timestamp": "02:44:39", "text": "它？哦，是的。是的，"}, {"type": "subtitle", "time": 9883.59, "timestamp": "02:44:43", "text": "这个东西。是的，"}, {"type": "subtitle", "time": 9886.79, "timestamp": "02:44:46", "text": "胡萝卜农场。"}, {"type": "subtitle", "time": 9890.07, "timestamp": "02:44:50", "text": "那次都是你一个人完成的。"}, {"type": "subtitle", "time": 9893.99, "timestamp": "02:44:53", "text": "还有那个灵魂宝石之类的东西。"}, {"type": "subtitle", "time": 9896.79, "timestamp": "02:44:56", "text": "好的，这两个词都没有出现在这里。"}]
[{"type": "subtitle", "time": 1627.51, "timestamp": "00:27:07", "text": "我的聊天记录被删除了。等等，什么？那是"}, {"type": "subtitle", "time": 1635.51, "timestamp": "00:27:15", "text": "刚刚完成了一个目标。"}, {"type": "subtitle", "time": 1664.47, "timestamp": "00:27:44", "text": "你好。我的孩子被带走了。不知道"}, {"type": "subtitle", "time": 1667.669, "timestamp": "00:27:47", "text": "发生了什么事？祖克"}, {"type": "subtitle", "time": 1674.71, "timestamp": "00:27:54", "text": "你好。美国国旗。"}, {"type": "subtitle", "time": 1676.95, "timestamp": "00:27:56", "text": "我们走吧。我们失去了一个目标。"}]
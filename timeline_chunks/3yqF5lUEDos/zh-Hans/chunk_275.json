[{"type": "subtitle", "time": 16500.869, "timestamp": "04:35:00", "text": "[掌声]"}, {"type": "subtitle", "time": 16510.06, "timestamp": "04:35:10", "text": "今天就到这里吧。"}, {"type": "subtitle", "time": 16512.31, "timestamp": "04:35:12", "text": "[音乐]"}, {"type": "subtitle", "time": 16514.949, "timestamp": "04:35:14", "text": "我们先和第一个见面，或者好的。"}, {"type": "subtitle", "time": 16517.269, "timestamp": "04:35:17", "text": "我们去见见那座塔吧。顶部"}, {"type": "subtitle", "time": 16521.99, "timestamp": "04:35:21", "text": "塔。塔顶。那个储物装置。"}, {"type": "subtitle", "time": 16529.269, "timestamp": "04:35:29", "text": "这是第一个空间。"}, {"type": "subtitle", "time": 16531.51, "timestamp": "04:35:31", "text": "我在服务器端工作的第一天实际上是"}, {"type": "subtitle", "time": 16533.429, "timestamp": "04:35:33", "text": "这里。"}, {"type": "subtitle", "time": 16535.83, "timestamp": "04:35:35", "text": "等等，呃，另一个帮手是谁？"}, {"type": "subtitle", "time": 16538.789, "timestamp": "04:35:38", "text": "制作这个东西的时候有什么想法？"}, {"type": "subtitle", "time": 16540.869, "timestamp": "04:35:40", "text": "Kito，"}, {"type": "subtitle", "time": 16545.189, "timestamp": "04:35:45", "text": "是吗？不。哦，"}, {"type": "subtitle", "time": 16550.629, "timestamp": "04:35:50", "text": "黑暗的。天黑吗？不。呃，哭。是的。"}, {"type": "subtitle", "time": 16553.67, "timestamp": "04:35:53", "text": "哦，是的。 Cry也在这里，但我没有"}]
[{"type": "subtitle", "time": 4804.229, "timestamp": "01:20:04", "text": "敌对势力已采取勇敢行动。"}, {"type": "subtitle", "time": 4807.189, "timestamp": "01:20:07", "text": "部队正瞄准 Bravo 一号。"}, {"type": "subtitle", "time": 4810.39, "timestamp": "01:20:10", "text": "等等，这些是洗衣机吗？等待，"}, {"type": "subtitle", "time": 4814.47, "timestamp": "01:20:14", "text": "这些是扬声器。什么？"}, {"type": "subtitle", "time": 4818.709, "timestamp": "01:20:18", "text": "搞什么鬼？什么？这些是什么？"}, {"type": "subtitle", "time": 4833.75, "timestamp": "01:20:33", "text": "高科技。"}, {"type": "subtitle", "time": 4835.83, "timestamp": "01:20:35", "text": "这是高科技。"}, {"type": "subtitle", "time": 4837.91, "timestamp": "01:20:37", "text": "哇。"}, {"type": "subtitle", "time": 4841.27, "timestamp": "01:20:41", "text": "我刚才说到哪儿了？"}, {"type": "subtitle", "time": 4851.669, "timestamp": "01:20:51", "text": "所以，是的，笨蛋，谢谢你提醒我。咚咚。"}, {"type": "subtitle", "time": 4853.99, "timestamp": "01:20:53", "text": "只是我知道我有很多"}, {"type": "subtitle", "time": 4858.39, "timestamp": "01:20:58", "text": "有很多事要做，但我选择……"}]
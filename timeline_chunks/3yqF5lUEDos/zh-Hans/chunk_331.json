[{"type": "subtitle", "time": 19860.39, "timestamp": "05:31:00", "text": "呃，所以每个“不”，我们漏掉了一个地方"}, {"type": "subtitle", "time": 19863.03, "timestamp": "05:31:03", "text": "第三个呃东西，但除此之外"}, {"type": "subtitle", "time": 19865.27, "timestamp": "05:31:05", "text": "我们几乎探索了所有事物。"}, {"type": "subtitle", "time": 19869.67, "timestamp": "05:31:09", "text": "正确的。哦，是的。是的。真的很有趣"}, {"type": "subtitle", "time": 19873.67, "timestamp": "05:31:13", "text": "最后再看一眼服务器"}, {"type": "subtitle", "time": 19877.43, "timestamp": "05:31:17", "text": "并向它作最后的告别。嗯。"}, {"type": "subtitle", "time": 19880.47, "timestamp": "05:31:20", "text": "但我希望我能看到那个节日。"}, {"type": "subtitle", "time": 19903.99, "timestamp": "05:31:43", "text": "请。我想玩玩那堆土豆泥。我"}, {"type": "subtitle", "time": 19907.99, "timestamp": "05:31:47", "text": "我知道我不能和她一起玩。请。"}, {"type": "subtitle", "time": 19910.23, "timestamp": "05:31:50", "text": "我的天啊。我们走吧。我们走吧。哦，我的"}, {"type": "subtitle", "time": 19913.27, "timestamp": "05:31:53", "text": "上帝。我们走吧。"}, {"type": "subtitle", "time": 19914.948, "timestamp": "05:31:54", "text": "是的。"}, {"type": "subtitle", "time": 19919.91, "timestamp": "05:31:59", "text": "加入。我的天啊。我们走吧。这是"}]
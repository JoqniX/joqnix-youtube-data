[{"type": "subtitle", "time": 16981.43, "timestamp": "04:43:01", "text": "感觉像是浪费。"}, {"type": "subtitle", "time": 16987.24, "timestamp": "04:43:07", "text": "永别了。"}, {"type": "subtitle", "time": 16988.55, "timestamp": "04:43:08", "text": "[音乐]"}, {"type": "subtitle", "time": 16991.51, "timestamp": "04:43:11", "text": "我扔掉了剑。"}, {"type": "subtitle", "time": 16994.708, "timestamp": "04:43:14", "text": "我的意思是，它应该就在下面。"}, {"type": "subtitle", "time": 16998.31, "timestamp": "04:43:18", "text": "每一滴。哦，是的。一切都崩溃了"}, {"type": "subtitle", "time": 16999.99, "timestamp": "04:43:19", "text": "这里。"}, {"type": "subtitle", "time": 17003.43, "timestamp": "04:43:23", "text": "那我继续努力吧。"}, {"type": "subtitle", "time": 17007.75, "timestamp": "04:43:27", "text": "或者我们应该把它放到水里？"}, {"type": "subtitle", "time": 17011.19, "timestamp": "04:43:31", "text": "鱼可以吃吗？"}, {"type": "subtitle", "time": 17013.91, "timestamp": "04:43:33", "text": "你想怎么做？"}, {"type": "subtitle", "time": 17015.68, "timestamp": "04:43:35", "text": "什么？"}, {"type": "subtitle", "time": 17018.15, "timestamp": "04:43:38", "text": "[音乐]"}, {"type": "subtitle", "time": 17019.83, "timestamp": "04:43:39", "text": "是的。"}, {"type": "subtitle", "time": 17022.708, "timestamp": "04:43:42", "text": "谢谢你帮我找到轮到我的地方。"}, {"type": "subtitle", "time": 17025.35, "timestamp": "04:43:45", "text": "好吧，那真是个绝佳的时机。"}, {"type": "subtitle", "time": 17027.43, "timestamp": "04:43:47", "text": "喜欢这种音乐。"}, {"type": "subtitle", "time": 17034.07, "timestamp": "04:43:54", "text": "来自印度尼西亚的问候。"}, {"type": "subtitle", "time": 17037.91, "timestamp": "04:43:57", "text": "是的，谢谢你带给我的一切美好回忆。"}]
[{"type": "subtitle", "time": 18420.31, "timestamp": "05:07:00", "text": "孩子们还在那里。狗狗"}, {"type": "subtitle", "time": 18421.75, "timestamp": "05:07:01", "text": "以及"}, {"type": "subtitle", "time": 18425.03, "timestamp": "05:07:05", "text": "猫和所有人，还有牛，还有"}, {"type": "subtitle", "time": 18427.67, "timestamp": "05:07:07", "text": "蘑菇牛，大家都在场。哦，我的"}, {"type": "subtitle", "time": 18429.43, "timestamp": "05:07:09", "text": "上帝。"}, {"type": "subtitle", "time": 18431.99, "timestamp": "05:07:11", "text": "是的。然后我们嗯"}, {"type": "subtitle", "time": 18434.55, "timestamp": "05:07:14", "text": "我们游览了所有的地方和东西"}, {"type": "subtitle", "time": 18437.67, "timestamp": "05:07:17", "text": "那是我们当时都探索过的地方。"}, {"type": "subtitle", "time": 18441.99, "timestamp": "05:07:21", "text": "呃，我们送走了，我们呃，我们"}, {"type": "subtitle", "time": 18444.708, "timestamp": "05:07:24", "text": "退出了游戏。是的，我们退出了"}, {"type": "subtitle", "time": 18448.708, "timestamp": "05:07:28", "text": "玩游戏之后再玩游戏。是的。但是它"}, {"type": "subtitle", "time": 18451.27, "timestamp": "05:07:31", "text": "真是太棒了。"}, {"type": "subtitle", "time": 18459.35, "timestamp": "05:07:39", "text": "是的。我们大概花了两个小时。"}, {"type": "subtitle", "time": 18466.31, "timestamp": "05:07:46", "text": "很遗憾我们没能找到第三个。"}, {"type": "subtitle", "time": 18476.868, "timestamp": "05:07:56", "text": "嗯，那段时光很美好。"}, {"type": "subtitle", "time": 18479.99, "timestamp": "05:07:59", "text": "我不知道还能说什么。对不起。"}]
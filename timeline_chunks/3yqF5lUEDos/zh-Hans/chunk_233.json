[{"type": "subtitle", "time": 13980.71, "timestamp": "03:53:00", "text": "你想去哪里？哦"}, {"type": "subtitle", "time": 13982.95, "timestamp": "03:53:02", "text": "对，就是这个地方。正确的。是的，"}, {"type": "subtitle", "time": 13985.349, "timestamp": "03:53:05", "text": "就在这里。"}, {"type": "subtitle", "time": 13987.189, "timestamp": "03:53:07", "text": "我死在这里的第一天。"}, {"type": "subtitle", "time": 13993.189, "timestamp": "03:53:13", "text": "服务器。啊，还记得吗？是的。是的。"}, {"type": "subtitle", "time": 13996.55, "timestamp": "03:53:16", "text": "那具骷髅杀了我。我当时非常"}, {"type": "subtitle", "time": 14000.309, "timestamp": "03:53:20", "text": "这座塔就像那一晚一样。"}, {"type": "subtitle", "time": 14002.309, "timestamp": "03:53:22", "text": "就像我下来的时候，我的第一次击杀是"}, {"type": "subtitle", "time": 14004.389, "timestamp": "03:53:24", "text": "这里。"}, {"type": "subtitle", "time": 14007.75, "timestamp": "03:53:27", "text": "是的，"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "我的记忆简直就悬在……"}, {"type": "subtitle", "time": 14014.63, "timestamp": "03:53:34", "text": "你的这座豪宅，我们一起入睡"}, {"type": "subtitle", "time": 14017.51, "timestamp": "03:53:37", "text": "以及所有那些东西。哦，对了，那个秘密"}, {"type": "subtitle", "time": 14022.63, "timestamp": "03:53:42", "text": "按钮。你把沙盒放进音乐盒里。"}, {"type": "subtitle", "time": 14026.63, "timestamp": "03:53:46", "text": "还有龙头。是的，有。"}, {"type": "subtitle", "time": 14030.71, "timestamp": "03:53:50", "text": "石头罗盘定位器也可能是宝藏"}, {"type": "subtitle", "time": 14034.389, "timestamp": "03:53:54", "text": "地图鞍座。我们就像突袭了……"}, {"type": "subtitle", "time": 14038.95, "timestamp": "03:53:58", "text": "服务器一次。是的。是的。是的。"}]
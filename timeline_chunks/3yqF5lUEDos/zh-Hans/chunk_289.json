[{"type": "subtitle", "time": 17342.788, "timestamp": "04:49:02", "text": "就像他和她交谈过一样"}, {"type": "subtitle", "time": 17345.83, "timestamp": "04:49:05", "text": "他们决定，是的，就像"}, {"type": "subtitle", "time": 17349.75, "timestamp": "04:49:09", "text": "离开了我们团队的人。"}, {"type": "subtitle", "time": 17353.35, "timestamp": "04:49:13", "text": "是的。不仅仅是“是”。如果他们愿意"}, {"type": "subtitle", "time": 17354.948, "timestamp": "04:49:14", "text": "你就放弃这个项目吧，没关系。但"}, {"type": "subtitle", "time": 17360.07, "timestamp": "04:49:20", "text": "如果左翼人士喜欢这些更新，"}, {"type": "subtitle", "time": 17361.59, "timestamp": "04:49:21", "text": "后续更新将成为"}, {"type": "subtitle", "time": 17365.35, "timestamp": "04:49:25", "text": "对他们来说是秘密。嗯。"}, {"type": "subtitle", "time": 17367.89, "timestamp": "04:49:27", "text": "是的。"}, {"type": "subtitle", "time": 17369.35, "timestamp": "04:49:29", "text": "[音乐]"}, {"type": "subtitle", "time": 17372.788, "timestamp": "04:49:32", "text": "但是，是的，我听到了一些关于……的消息。"}, {"type": "subtitle", "time": 17375.27, "timestamp": "04:49:35", "text": "你知道那件奇怪的事吗？哦，海湾"}, {"type": "subtitle", "time": 17377.67, "timestamp": "04:49:37", "text": "他们正在制作的主题。哦，是的。这"}, {"type": "subtitle", "time": 17380.15, "timestamp": "04:49:40", "text": "发光的东西。是的。是的。是的。什么"}, {"type": "subtitle", "time": 17381.67, "timestamp": "04:49:41", "text": "发生了什么事？"}, {"type": "subtitle", "time": 17384.47, "timestamp": "04:49:44", "text": "我认为他们只做到了90%。"}, {"type": "subtitle", "time": 17386.47, "timestamp": "04:49:46", "text": "进步。"}, {"type": "subtitle", "time": 17388.07, "timestamp": "04:49:48", "text": "啊，"}, {"type": "subtitle", "time": 17390.15, "timestamp": "04:49:50", "text": "他们甚至试图制造怪异的东西"}, {"type": "subtitle", "time": 17396.55, "timestamp": "04:49:56", "text": "真是件怪事，真是怪事。"}, {"type": "subtitle", "time": 17399.43, "timestamp": "04:49:59", "text": "哦，虚拟现实。"}]
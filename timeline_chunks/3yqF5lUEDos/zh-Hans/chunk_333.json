[{"type": "subtitle", "time": 19991.27, "timestamp": "05:33:11", "text": "哦等等，我忘了音乐包的背景音乐是"}, {"type": "subtitle", "time": 19995.19, "timestamp": "05:33:15", "text": "这段时间一直处于关闭状态。哇。"}, {"type": "subtitle", "time": 19997.51, "timestamp": "05:33:17", "text": "是的。"}, {"type": "subtitle", "time": 20000.948, "timestamp": "05:33:20", "text": "笑点是什么？你好。我可以许愿要个大拇指吗？"}, {"type": "subtitle", "time": 20003.59, "timestamp": "05:33:23", "text": "是的，我们有旧存档，没有新存档。"}, {"type": "subtitle", "time": 20006.07, "timestamp": "05:33:26", "text": "最新的一个。节日的那个不是那样。"}, {"type": "subtitle", "time": 20007.83, "timestamp": "05:33:27", "text": "令人遗憾。"}, {"type": "subtitle", "time": 20010.07, "timestamp": "05:33:30", "text": "是的。是的，你可以加入，就像……"}, {"type": "subtitle", "time": 20013.35, "timestamp": "05:33:33", "text": "在删除之前。是的，你可以加入。"}, {"type": "subtitle", "time": 20015.91, "timestamp": "05:33:35", "text": "一起去看演出。我的意思是，我"}, {"type": "subtitle", "time": 20017.35, "timestamp": "05:33:37", "text": "也许我参加不了，不过，嗯。"}, {"type": "subtitle", "time": 20024.548, "timestamp": "05:33:44", "text": "我的嗓子快哑了。是的。是的。"}, {"type": "subtitle", "time": 20028.868, "timestamp": "05:33:48", "text": "好好休息。你今天表现不错。"}, {"type": "subtitle", "time": 20035.91, "timestamp": "05:33:55", "text": "那是我的新车。"}, {"type": "subtitle", "time": 20038.23, "timestamp": "05:33:58", "text": "你好。"}]
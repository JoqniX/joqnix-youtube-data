[{"type": "subtitle", "time": 5597.83, "timestamp": "01:33:17", "text": "我一直在听一些九月份的歌。"}, {"type": "subtitle", "time": 5607.189, "timestamp": "01:33:27", "text": "我听到有人说话。哦，等等。这家伙"}, {"type": "subtitle", "time": 5609.669, "timestamp": "01:33:29", "text": "一两枪就打中了我。"}, {"type": "subtitle", "time": 5612.149, "timestamp": "01:33:32", "text": "什么？"}, {"type": "subtitle", "time": 5632.79, "timestamp": "01:33:52", "text": "是的。起床。我们走吧。那是砰砰声"}]
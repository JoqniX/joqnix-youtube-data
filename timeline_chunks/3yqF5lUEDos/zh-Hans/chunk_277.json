[{"type": "subtitle", "time": 16620.709, "timestamp": "04:37:00", "text": "他们说他们不在乎。和"}, {"type": "subtitle", "time": 16622.629, "timestamp": "04:37:02", "text": "所以他们就说：“是啊，他们不……”"}, {"type": "subtitle", "time": 16626.15, "timestamp": "04:37:06", "text": "真心喜欢它。"}, {"type": "subtitle", "time": 16629.67, "timestamp": "04:37:09", "text": "是的。此时此刻，伙计。"}, {"type": "subtitle", "time": 16631.83, "timestamp": "04:37:11", "text": "是的，他们甚至没有报告任何情况。"}, {"type": "subtitle", "time": 16634.629, "timestamp": "04:37:14", "text": "预设进度对我来说。或许是"}, {"type": "subtitle", "time": 16637.91, "timestamp": "04:37:17", "text": "要么中止，要么取消。"}, {"type": "subtitle", "time": 16639.75, "timestamp": "04:37:19", "text": "是的。"}, {"type": "subtitle", "time": 16642.47, "timestamp": "04:37:22", "text": "就是这样。"}, {"type": "subtitle", "time": 16645.91, "timestamp": "04:37:25", "text": "是的。那是因为我没做。"}, {"type": "subtitle", "time": 16648.64, "timestamp": "04:37:28", "text": "那是主要问题。"}, {"type": "subtitle", "time": 16657.59, "timestamp": "04:37:37", "text": "我因为抬头看顶而摔了下来。"}, {"type": "subtitle", "time": 16661.349, "timestamp": "04:37:41", "text": "东西。我的天哪。好的。"}, {"type": "subtitle", "time": 16665.59, "timestamp": "04:37:45", "text": "我从来没遇到过这种情况。好吧。"}, {"type": "subtitle", "time": 16668.07, "timestamp": "04:37:48", "text": "我又要因为多看一眼而跳下去了吗？"}, {"type": "subtitle", "time": 16670.23, "timestamp": "04:37:50", "text": "我的天啊。"}, {"type": "subtitle", "time": 16672.629, "timestamp": "04:37:52", "text": "是的。再见。哦，对，这不是……"}, {"type": "subtitle", "time": 16675.109, "timestamp": "04:37:55", "text": "已更新。不，我们放的是植物之类的东西。"}, {"type": "subtitle", "time": 16679.029, "timestamp": "04:37:59", "text": "以及最新一期里的内容。最后"}]
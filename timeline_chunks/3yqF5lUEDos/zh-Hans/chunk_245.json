[{"type": "subtitle", "time": 14705.11, "timestamp": "04:05:05", "text": "啊，巫师们。"}, {"type": "subtitle", "time": 14708.07, "timestamp": "04:05:08", "text": "你还记得我们上次在……"}, {"type": "subtitle", "time": 14710.55, "timestamp": "04:05:10", "text": "沙漠？我认为我们当时正在战斗"}, {"type": "subtitle", "time": 14716.229, "timestamp": "04:05:16", "text": "哦耶耶耶耶。那东西在哪儿？"}, {"type": "subtitle", "time": 14718.87, "timestamp": "04:05:18", "text": "地方？我的天啊。那地方在哪里？我"}, {"type": "subtitle", "time": 14725.429, "timestamp": "04:05:25", "text": "我们用过的那个地方在哪儿？"}, {"type": "subtitle", "time": 14733.269, "timestamp": "04:05:33", "text": "那真是一个令人难忘的地方。我"}, {"type": "subtitle", "time": 14736.63, "timestamp": "04:05:36", "text": "记得吗？因为那段时间我只记得……"}, {"type": "subtitle", "time": 14742.229, "timestamp": "04:05:42", "text": "Genshin ped that sume not sume that"}, {"type": "subtitle", "time": 14745.189, "timestamp": "04:05:45", "text": "不知何故，我遇到了这个问题。"}, {"type": "subtitle", "time": 14747.429, "timestamp": "04:05:47", "text": "不离开"}, {"type": "subtitle", "time": 14749.03, "timestamp": "04:05:49", "text": "伊努玛"}, {"type": "subtitle", "time": 14751.269, "timestamp": "04:05:51", "text": "是的"}, {"type": "subtitle", "time": 14754.15, "timestamp": "04:05:54", "text": "嗯，大概就是那时候出来的吧。"}]
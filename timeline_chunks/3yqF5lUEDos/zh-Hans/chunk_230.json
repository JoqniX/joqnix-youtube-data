[{"type": "subtitle", "time": 13804.389, "timestamp": "03:50:04", "text": "这个人，距离我上次见面已经很久了。"}, {"type": "subtitle", "time": 13807.51, "timestamp": "03:50:07", "text": "见过这个人。哦，是的。这个人，"}, {"type": "subtitle", "time": 13811.83, "timestamp": "03:50:11", "text": "[音乐]"}, {"type": "subtitle", "time": 13820.79, "timestamp": "03:50:20", "text": "除了……之外，他一无所有。"}, {"type": "subtitle", "time": 13823.349, "timestamp": "03:50:23", "text": "丛林幼苗。"}, {"type": "subtitle", "time": 13825.03, "timestamp": "03:50:25", "text": "但我不再需要你了。我有"}, {"type": "subtitle", "time": 13837.75, "timestamp": "03:50:37", "text": "对不起。"}, {"type": "subtitle", "time": 13846.52, "timestamp": "03:50:46", "text": "我不是说要动暴力，但我恨他。"}]
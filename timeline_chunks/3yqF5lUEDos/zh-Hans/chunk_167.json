[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "这样可以吗？好的，一个轮子是"}, {"type": "subtitle", "time": 10022.87, "timestamp": "02:47:02", "text": "运行正常。"}, {"type": "subtitle", "time": 10025.67, "timestamp": "02:47:05", "text": "我要偷走他们一个轮子。这"}, {"type": "subtitle", "time": 10028.09, "timestamp": "02:47:08", "text": "事物。哦，"}, {"type": "subtitle", "time": 10030.07, "timestamp": "02:47:10", "text": "[音乐]"}, {"type": "subtitle", "time": 10032.469, "timestamp": "02:47:12", "text": "不是那样。下面这个。有"}, {"type": "subtitle", "time": 10036.309, "timestamp": "02:47:16", "text": "骨轮自动，但速度慢。是的。"}, {"type": "subtitle", "time": 10038.87, "timestamp": "02:47:18", "text": "哇。"}, {"type": "subtitle", "time": 10042.15, "timestamp": "02:47:22", "text": "你擅长我擅长的吗？并不真地。我"}, {"type": "subtitle", "time": 10044.63, "timestamp": "02:47:24", "text": "已经几十年没玩过了。"}, {"type": "subtitle", "time": 10048.07, "timestamp": "02:47:28", "text": "相同的。是的，这还不错。这是"}, {"type": "subtitle", "time": 10053.75, "timestamp": "02:47:33", "text": "我猜是库里尔森。嗯，是的。是的。"}, {"type": "subtitle", "time": 10057.67, "timestamp": "02:47:37", "text": "M 豪宅。是的。这"}, {"type": "subtitle", "time": 10060.469, "timestamp": "02:47:40", "text": "我的天啊。我曾经见过他，但我不再认识他了。"}, {"type": "subtitle", "time": 10063.269, "timestamp": "02:47:43", "text": "想打扰他。是的。"}, {"type": "subtitle", "time": 10071.59, "timestamp": "02:47:51", "text": "这真是太……"}, {"type": "subtitle", "time": 10073.429, "timestamp": "02:47:53", "text": "还。好的。它叫什么？它"}, {"type": "subtitle", "time": 10077.83, "timestamp": "02:47:57", "text": "不会发作。我的天啊。不。开启。"}]
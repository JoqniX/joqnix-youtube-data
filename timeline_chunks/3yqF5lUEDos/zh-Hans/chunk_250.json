[{"type": "subtitle", "time": 15007.59, "timestamp": "04:10:07", "text": "我猜，这是最后的墓地位置。等等，我"}, {"type": "subtitle", "time": 15009.83, "timestamp": "04:10:09", "text": "可以做到，对吧？"}, {"type": "subtitle", "time": 15011.59, "timestamp": "04:10:11", "text": "DP"}, {"type": "subtitle", "time": 15027.83, "timestamp": "04:10:27", "text": "我没有最终的坟墓。哦，不。"}, {"type": "subtitle", "time": 15031.91, "timestamp": "04:10:31", "text": "好吧，我真的迷路了。"}, {"type": "subtitle", "time": 15037.11, "timestamp": "04:10:37", "text": "呃，让我来接你吧。让它影响到你。"}, {"type": "subtitle", "time": 15039.91, "timestamp": "04:10:39", "text": "我，我，我身处一个我们……的地方"}, {"type": "subtitle", "time": 15043.11, "timestamp": "04:10:43", "text": "看起来像我们来的地方。我懂了"}, {"type": "subtitle", "time": 15045.91, "timestamp": "04:10:45", "text": "蘑菇。这里有沼泽吗？"}, {"type": "subtitle", "time": 15049.51, "timestamp": "04:10:49", "text": "从这里开始？在你身后。"}]
[{"type": "subtitle", "time": 14282.15, "timestamp": "03:58:02", "text": "第一次使用锤子。套装。"}, {"type": "subtitle", "time": 14284.71, "timestamp": "03:58:04", "text": "哦好的。在此之前，还有最后一件事。"}, {"type": "subtitle", "time": 14307.67, "timestamp": "03:58:27", "text": "这条漫长的路径并不存在"}, {"type": "subtitle", "time": 14309.59, "timestamp": "03:58:29", "text": "没有什么。"}, {"type": "subtitle", "time": 14311.99, "timestamp": "03:58:31", "text": "哦是的。是的。剑。剑。是的。"}, {"type": "subtitle", "time": 14333.91, "timestamp": "03:58:53", "text": "你做了什么吗？"}, {"type": "subtitle", "time": 14336.87, "timestamp": "03:58:56", "text": "好的。过来。上来。有一个"}, {"type": "subtitle", "time": 14339.189, "timestamp": "03:58:59", "text": "这里面藏着个秘密。"}]
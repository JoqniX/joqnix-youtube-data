[{"type": "subtitle", "time": 19026.948, "timestamp": "05:17:06", "text": "男人。纯粹的"}, {"type": "subtitle", "time": 19029.35, "timestamp": "05:17:09", "text": "没人这么说。没有 U，也没有"}, {"type": "subtitle", "time": 19032.39, "timestamp": "05:17:12", "text": "说出来。说得好。"}, {"type": "subtitle", "time": 19036.31, "timestamp": "05:17:16", "text": "欢迎回来。欢迎。欢迎。你好。"}, {"type": "subtitle", "time": 19039.83, "timestamp": "05:17:19", "text": "等待。是否有其他替代词？男人，"}, {"type": "subtitle", "time": 19047.43, "timestamp": "05:17:27", "text": "是的。"}, {"type": "subtitle", "time": 19050.628, "timestamp": "05:17:30", "text": "哦，是的。在你购买显卡之前"}, {"type": "subtitle", "time": 19053.19, "timestamp": "05:17:33", "text": "下个月，呃，你玩的所有游戏是什么？"}, {"type": "subtitle", "time": 19057.03, "timestamp": "05:17:37", "text": "迫不及待想玩了吗？史诗级作品。"}, {"type": "subtitle", "time": 19071.27, "timestamp": "05:17:51", "text": "洪盖问题。是的。"}, {"type": "subtitle", "time": 19073.67, "timestamp": "05:17:53", "text": "H."}, {"type": "subtitle", "time": 19075.67, "timestamp": "05:17:55", "text": "是的。五。"}]
[{"type": "subtitle", "time": 9423.67, "timestamp": "02:37:03", "text": "好的。很难喜欢低跳。"}, {"type": "subtitle", "time": 9425.51, "timestamp": "02:37:05", "text": "东西。"}, {"type": "subtitle", "time": 9427.19, "timestamp": "02:37:07", "text": "好的。"}, {"type": "subtitle", "time": 9429.03, "timestamp": "02:37:09", "text": "你想去哪里？是啊，我们就这么办吧"}, {"type": "subtitle", "time": 9430.95, "timestamp": "02:37:10", "text": "从某个地方开始。我们去哪里"}, {"type": "subtitle", "time": 9433.51, "timestamp": "02:37:13", "text": "服务器启动的位置。好吧，"}, {"type": "subtitle", "time": 9436.71, "timestamp": "02:37:16", "text": "在此之前，我们先准备一些工具。是的，"}, {"type": "subtitle", "time": 9439.51, "timestamp": "02:37:19", "text": "与我一起。应该有一些工具。我"}, {"type": "subtitle", "time": 9441.91, "timestamp": "02:37:21", "text": "记住这一点。我以前用过这个"}, {"type": "subtitle", "time": 9446.07, "timestamp": "02:37:26", "text": "东西。如何仅与 E 进行交互，"}, {"type": "subtitle", "time": 9451.19, "timestamp": "02:37:31", "text": "正确的？只需单击鼠标左键。"}, {"type": "subtitle", "time": 9453.51, "timestamp": "02:37:33", "text": "点击右键。是的。好的。好的。正确的"}, {"type": "subtitle", "time": 9456.309, "timestamp": "02:37:36", "text": "点击。是的。"}, {"type": "subtitle", "time": 9459.83, "timestamp": "02:37:39", "text": "请进。你好。如果我不在，那就什么都没有了。"}, {"type": "subtitle", "time": 9466.07, "timestamp": "02:37:46", "text": "错误的。进来。我的天哪。这个地方"}, {"type": "subtitle", "time": 9468.71, "timestamp": "02:37:48", "text": "很多。是的。你可以从……拿些食物"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "哦，是的。厨房。我的天啊。的"}, {"type": "subtitle", "time": 9479.349, "timestamp": "02:37:59", "text": "竹戒指，承载着回忆。"}]
[{"type": "subtitle", "time": 13742.79, "timestamp": "03:49:02", "text": "哦，那是养羊场。是的。是的，就是这样。"}, {"type": "subtitle", "time": 13745.91, "timestamp": "03:49:05", "text": "好久不见。我记得这件事。这"}, {"type": "subtitle", "time": 13748.55, "timestamp": "03:49:08", "text": "彩色绵羊养殖场。所以，这些就都是这些吗？"}, {"type": "subtitle", "time": 13753.03, "timestamp": "03:49:13", "text": "游戏中绵羊有哪些颜色可供选择？"}, {"type": "subtitle", "time": 13755.11, "timestamp": "03:49:15", "text": "我觉得应该还有更多颜色，不过是的。"}, {"type": "subtitle", "time": 13759.83, "timestamp": "03:49:19", "text": "我有。常见的那些。我的天哪。"}, {"type": "subtitle", "time": 13762.15, "timestamp": "03:49:22", "text": "如何才能让它们重新焕发光彩？"}, {"type": "subtitle", "time": 13764.95, "timestamp": "03:49:24", "text": "你放了染料，对吧？"}, {"type": "subtitle", "time": 13766.469, "timestamp": "03:49:26", "text": "是的。"}, {"type": "subtitle", "time": 13769.51, "timestamp": "03:49:29", "text": "你给它们染色，然后进行繁殖。"}, {"type": "subtitle", "time": 13773.269, "timestamp": "03:49:33", "text": "所以大概就是这样。嗯哼。用呃布雷他们"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "欢迎。"}, {"type": "subtitle", "time": 13785.269, "timestamp": "03:49:45", "text": "希望你一切都好。房屋检查和"}, {"type": "subtitle", "time": 13787.03, "timestamp": "03:49:47", "text": "东西。"}, {"type": "subtitle", "time": 13794.95, "timestamp": "03:49:54", "text": "是的，"}, {"type": "subtitle", "time": 13798.04, "timestamp": "03:49:58", "text": "真是太……"}]
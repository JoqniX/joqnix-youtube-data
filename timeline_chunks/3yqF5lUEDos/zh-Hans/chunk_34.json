[{"type": "subtitle", "time": 2057.909, "timestamp": "00:34:17", "text": "等等，我无法正确控制它。"}, {"type": "subtitle", "time": 2073.99, "timestamp": "00:34:33", "text": "我让游戏出故障了。我搞砸了"}, {"type": "subtitle", "time": 2077.909, "timestamp": "00:34:37", "text": "游戏。什么？我让游戏出故障了。"}, {"type": "subtitle", "time": 2080.55, "timestamp": "00:34:40", "text": "我勒个去？这是哪里？我出故障了。"}, {"type": "subtitle", "time": 2084.23, "timestamp": "00:34:44", "text": "游戏。搞什么鬼？你们呢？"}, {"type": "subtitle", "time": 2087.03, "timestamp": "00:34:47", "text": "看到了吗？"}]
[{"type": "subtitle", "time": 16566.07, "timestamp": "04:36:06", "text": "所以，"}, {"type": "subtitle", "time": 16568.789, "timestamp": "04:36:08", "text": "所以"}, {"type": "subtitle", "time": 16572.07, "timestamp": "04:36:12", "text": "这是"}, {"type": "subtitle", "time": 16574.629, "timestamp": "04:36:14", "text": "是的，我们已经持续两个小时了。"}, {"type": "subtitle", "time": 16575.51, "timestamp": "04:36:15", "text": "哇。"}, {"type": "subtitle", "time": 16586.949, "timestamp": "04:36:26", "text": "你今天过得愉快吗？是的，我没有。"}, {"type": "subtitle", "time": 16592.47, "timestamp": "04:36:32", "text": "我想，你今天玩得太开心了。"}, {"type": "subtitle", "time": 16595.51, "timestamp": "04:36:35", "text": "满满的怀旧回忆。"}, {"type": "subtitle", "time": 16602.47, "timestamp": "04:36:42", "text": "哦，是的。在进入服务器之前，"}, {"type": "subtitle", "time": 16606.709, "timestamp": "04:36:46", "text": "我问过前开发团队。"}, {"type": "subtitle", "time": 16609.269, "timestamp": "04:36:49", "text": "请求许可。他们当时就说：“哦，你"}, {"type": "subtitle", "time": 16612.23, "timestamp": "04:36:52", "text": "“真的吗？”嗯，他们好像没说。"}, {"type": "subtitle", "time": 16614.07, "timestamp": "04:36:54", "text": "关心。"}, {"type": "subtitle", "time": 16616.39, "timestamp": "04:36:56", "text": "好的。但是，我还是问了我的"}, {"type": "subtitle", "time": 16617.99, "timestamp": "04:36:57", "text": "耳机掉了。等等，你是"}]
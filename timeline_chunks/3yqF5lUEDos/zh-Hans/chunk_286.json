[{"type": "subtitle", "time": 17164.16, "timestamp": "04:46:04", "text": "是2020年还是2021年？我忘了。 呃，2020年，我猜是三四年左右。"}, {"type": "subtitle", "time": 17168.08, "timestamp": "04:46:08", "text": "呃，2020年，我猜是三四年左右。 是的。啊，对对对。"}, {"type": "subtitle", "time": 17178.868, "timestamp": "04:46:18", "text": "我感到高兴，也感到自豪。"}, {"type": "subtitle", "time": 17182.07, "timestamp": "04:46:22", "text": "很高兴见到你。"}, {"type": "subtitle", "time": 17184.07, "timestamp": "04:46:24", "text": "相同的。"}, {"type": "subtitle", "time": 17185.67, "timestamp": "04:46:25", "text": "是的。"}, {"type": "subtitle", "time": 17189.72, "timestamp": "04:46:29", "text": "我们有很多共同的回忆。一个"}, {"type": "subtitle", "time": 17198.35, "timestamp": "04:46:38", "text": "你好。"}, {"type": "subtitle", "time": 17199.59, "timestamp": "04:46:39", "text": "[音乐]"}, {"type": "subtitle", "time": 17207.43, "timestamp": "04:46:47", "text": "等等，你是要把它删掉吗？"}, {"type": "subtitle", "time": 17210.868, "timestamp": "04:46:50", "text": "来自多人游戏？哦好的。我呃"}, {"type": "subtitle", "time": 17213.75, "timestamp": "04:46:53", "text": "我不会玩这个版本，所以"}, {"type": "subtitle", "time": 17215.27, "timestamp": "04:46:55", "text": "我填“我不知道”。我还是继续吧"}, {"type": "subtitle", "time": 17219.43, "timestamp": "04:46:59", "text": "我想应该是吧。以防我返回"}]
[{"type": "subtitle", "time": 10142.63, "timestamp": "02:49:02", "text": "再次？等等，我们从这里往上爬吗？我"}, {"type": "subtitle", "time": 10145.269, "timestamp": "02:49:05", "text": "不知道。"}, {"type": "subtitle", "time": 10147.75, "timestamp": "02:49:07", "text": "我们跳吧。我们从这里往上爬，我"}, {"type": "subtitle", "time": 10150.15, "timestamp": "02:49:10", "text": "猜测。不，等等。"}, {"type": "subtitle", "time": 10152.309, "timestamp": "02:49:12", "text": "那么，如何才能登上顶峰呢？哦，是的。"}, {"type": "subtitle", "time": 10155.19, "timestamp": "02:49:15", "text": "对，就在这儿。是的。一些骷髅射击"}, {"type": "subtitle", "time": 10157.67, "timestamp": "02:49:17", "text": "看着我。"}, {"type": "subtitle", "time": 10169.19, "timestamp": "02:49:29", "text": "我们在树顶上。是的，我是"}, {"type": "subtitle", "time": 10173.59, "timestamp": "02:49:33", "text": "被某个骷髅射杀了。"}, {"type": "subtitle", "time": 10176.469, "timestamp": "02:49:36", "text": "嗯？哦，"}, {"type": "subtitle", "time": 10178.15, "timestamp": "02:49:38", "text": "看。"}, {"type": "subtitle", "time": 10179.83, "timestamp": "02:49:39", "text": "或许是在水里。我没有"}, {"type": "subtitle", "time": 10182.309, "timestamp": "02:49:42", "text": "弓。我没有箭。哦，我只是"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "好的，我马上就来。"}, {"type": "subtitle", "time": 10191.75, "timestamp": "02:49:51", "text": "哦，下来吧。"}, {"type": "subtitle", "time": 10194.389, "timestamp": "02:49:54", "text": "这里，"}, {"type": "subtitle", "time": 10196.55, "timestamp": "02:49:56", "text": "做"}]
[{"type": "subtitle", "time": 15061.03, "timestamp": "04:11:01", "text": "这里有一片沼泽。在哪里？应该是"}, {"type": "subtitle", "time": 15063.269, "timestamp": "04:11:03", "text": "就在附近。"}, {"type": "subtitle", "time": 15065.75, "timestamp": "04:11:05", "text": "洛科，别迷路了。"}, {"type": "subtitle", "time": 15067.59, "timestamp": "04:11:07", "text": "洛科，"}, {"type": "subtitle", "time": 15077.59, "timestamp": "04:11:17", "text": "我没看见你。"}, {"type": "subtitle", "time": 15081.189, "timestamp": "04:11:21", "text": "我也不喜欢。"}, {"type": "subtitle", "time": 15083.03, "timestamp": "04:11:23", "text": "是的，天色渐晚了。哦，对了，"}, {"type": "subtitle", "time": 15111.83, "timestamp": "04:11:51", "text": "这是为什么？为什么它是亮着的？"}, {"type": "subtitle", "time": 15115.03, "timestamp": "04:11:55", "text": "你现在做到了吗？"}]
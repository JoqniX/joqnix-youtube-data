[{"type": "subtitle", "time": 11340.71, "timestamp": "03:09:00", "text": "啊，她叫什么名字？她叫什么名字？"}, {"type": "subtitle", "time": 11343.51, "timestamp": "03:09:03", "text": "什么？ WHO？那个想要"}, {"type": "subtitle", "time": 11346.15, "timestamp": "03:09:06", "text": "想出道但因为……而未能出道"}, {"type": "subtitle", "time": 11347.75, "timestamp": "03:09:07", "text": "互联网。"}, {"type": "subtitle", "time": 11350.15, "timestamp": "03:09:10", "text": "因为互联网。"}, {"type": "subtitle", "time": 11355.75, "timestamp": "03:09:15", "text": "呃，我记得，但我说不出来。"}, {"type": "subtitle", "time": 11357.51, "timestamp": "03:09:17", "text": "是的。"}, {"type": "subtitle", "time": 11360.15, "timestamp": "03:09:20", "text": "差点就说不出口了。"}, {"type": "subtitle", "time": 11361.99, "timestamp": "03:09:21", "text": "发生了什么？"}, {"type": "subtitle", "time": 11365.429, "timestamp": "03:09:25", "text": "看看竹林和树木"}, {"type": "subtitle", "time": 11367.75, "timestamp": "03:09:27", "text": "那里。"}, {"type": "subtitle", "time": 11370.07, "timestamp": "03:09:30", "text": "是的。还有甘蔗制品"}, {"type": "subtitle", "time": 11374.309, "timestamp": "03:09:34", "text": "由你。我猜是哪一个"}, {"type": "subtitle", "time": 11386.389, "timestamp": "03:09:46", "text": "还有你的房子"}, {"type": "subtitle", "time": 11388.469, "timestamp": "03:09:48", "text": "你的房子。"}, {"type": "subtitle", "time": 11396.07, "timestamp": "03:09:56", "text": "我把这些东西都忘了。"}]
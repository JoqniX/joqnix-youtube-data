[{"type": "subtitle", "time": 18300.868, "timestamp": "05:05:00", "text": "视频。我不觉得我喜欢看"}, {"type": "subtitle", "time": 18303.91, "timestamp": "05:05:03", "text": "之前见过他们，或者至少见过他们合作。"}, {"type": "subtitle", "time": 18307.03, "timestamp": "05:05:07", "text": "和艾玛在一起，但我记不起他们了。"}, {"type": "subtitle", "time": 18311.27, "timestamp": "05:05:11", "text": "嗯。他们只想聊聊天。"}, {"type": "subtitle", "time": 18314.07, "timestamp": "05:05:14", "text": "不知为何，他一直和我在一起。"}, {"type": "subtitle", "time": 18319.27, "timestamp": "05:05:19", "text": "我当时就想，“等等，呃，我的意思是，怎么"}, {"type": "subtitle", "time": 18323.75, "timestamp": "05:05:23", "text": "这是日语吗？我心想：“嗯，可以吗？”"}, {"type": "subtitle", "time": 18325.59, "timestamp": "05:05:25", "text": "他们说英语吗？那是"}, {"type": "subtitle", "time": 18329.43, "timestamp": "05:05:29", "text": "我问艾玛的第一个问题是……"}, {"type": "subtitle", "time": 18333.51, "timestamp": "05:05:33", "text": "然后。然后就像，“好吧，对不起”"}, {"type": "subtitle", "time": 18335.83, "timestamp": "05:05:35", "text": "关于这件事，你只能忍受了。"}, {"type": "subtitle", "time": 18341.27, "timestamp": "05:05:41", "text": "就这样。"}, {"type": "subtitle", "time": 18350.39, "timestamp": "05:05:50", "text": "就像我们聊过的一些游戏一样"}, {"type": "subtitle", "time": 18357.03, "timestamp": "05:05:57", "text": "然后"}, {"type": "subtitle", "time": 18359.75, "timestamp": "05:05:59", "text": "我彻底失败了。"}]
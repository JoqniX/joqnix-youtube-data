[{"type": "subtitle", "time": 1705.43, "timestamp": "00:28:25", "text": "为什么不再为某些事道歉呢？呃，"}, {"type": "subtitle", "time": 1708.87, "timestamp": "00:28:28", "text": "你无能为力。"}, {"type": "subtitle", "time": 1726.789, "timestamp": "00:28:46", "text": "碳灰色"}, {"type": "subtitle", "time": 1738.31, "timestamp": "00:28:58", "text": "哦，我死了。等等，等等，等等。让我去"}]
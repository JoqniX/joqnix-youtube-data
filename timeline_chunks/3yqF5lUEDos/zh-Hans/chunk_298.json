[{"type": "subtitle", "time": 17880.23, "timestamp": "04:58:00", "text": "我的上帝。还有雷。他被算在内了。"}, {"type": "subtitle", "time": 17881.99, "timestamp": "04:58:01", "text": "服务器是有所有者的，但不是。"}, {"type": "subtitle", "time": 17885.59, "timestamp": "04:58:05", "text": "可以担任操作员吗？嗯。他只是"}, {"type": "subtitle", "time": 17886.868, "timestamp": "04:58:06", "text": "服务器中的普通玩家"}, {"type": "subtitle", "time": 17888.39, "timestamp": "04:58:08", "text": "其他的。好的。他可以接触到"}, {"type": "subtitle", "time": 17891.51, "timestamp": "04:58:11", "text": "插件、日志、开启和关闭服务器"}, {"type": "subtitle", "time": 17893.83, "timestamp": "04:58:13", "text": "仅有的。他还可以查阅世界文件。"}, {"type": "subtitle", "time": 17895.43, "timestamp": "04:58:15", "text": "但这仅仅是因为插件设置和"}, {"type": "subtitle", "time": 17897.67, "timestamp": "04:58:17", "text": "全球备份。代码三仅允许"}, {"type": "subtitle", "time": 17899.43, "timestamp": "04:58:19", "text": "在服务器端执行操作员操作。"}, {"type": "subtitle", "time": 17903.11, "timestamp": "04:58:23", "text": "不，不允许在服务器上显示。"}, {"type": "subtitle", "time": 17905.03, "timestamp": "04:58:25", "text": "不再是了，因为他是服务器操作员，"}, {"type": "subtitle", "time": 17907.67, "timestamp": "04:58:27", "text": "可以从创意库存中获取物品或"}, {"type": "subtitle", "time": 17909.75, "timestamp": "04:58:29", "text": "评论很容易区分哪个是哪个是"}, {"type": "subtitle", "time": 17913.43, "timestamp": "04:58:33", "text": "被视为作弊。嗯。可以加入"}, {"type": "subtitle", "time": 17915.67, "timestamp": "04:58:35", "text": "如果他愿意的话，但他不会有操作员。"}, {"type": "subtitle", "time": 17917.67, "timestamp": "04:58:37", "text": "与此同时。"}, {"type": "subtitle", "time": 17931.03, "timestamp": "04:58:51", "text": "男人。真是令人怀念啊！"}, {"type": "subtitle", "time": 17933.03, "timestamp": "04:58:53", "text": "男人。"}, {"type": "subtitle", "time": 17936.85, "timestamp": "04:58:56", "text": "哦，是的。所有东西。"}, {"type": "subtitle", "time": 17938.868, "timestamp": "04:58:58", "text": "[音乐]"}]
[{"type": "subtitle", "time": 10263.59, "timestamp": "02:51:03", "text": "是啊，但我当时差点摔倒。"}, {"type": "subtitle", "time": 10271.349, "timestamp": "02:51:11", "text": "什么？你是怎么到那儿的？我只是"}, {"type": "subtitle", "time": 10273.91, "timestamp": "02:51:13", "text": "跳了起来"}, {"type": "subtitle", "time": 10276.71, "timestamp": "02:51:16", "text": "你当时感觉如何？就像有这么一个"}, {"type": "subtitle", "time": 10279.26, "timestamp": "02:51:19", "text": "事物。哦。"}, {"type": "subtitle", "time": 10282.23, "timestamp": "02:51:22", "text": "[音乐]"}, {"type": "subtitle", "time": 10291.19, "timestamp": "02:51:31", "text": "是的。你什么时候做的"}, {"type": "subtitle", "time": 10295.11, "timestamp": "02:51:35", "text": "顶部加装延伸件？哦，是的。暴民。"}, {"type": "subtitle", "time": 10297.99, "timestamp": "02:51:37", "text": "怪物农场。是的。"}, {"type": "subtitle", "time": 10301.99, "timestamp": "02:51:41", "text": "我的天哪。这边走。好的，我们去……"}, {"type": "subtitle", "time": 10305.67, "timestamp": "02:51:45", "text": "塔。我们跳吗？"}, {"type": "subtitle", "time": 10309.11, "timestamp": "02:51:49", "text": "我的意思是，这里有水。我的意思是，我"}, {"type": "subtitle", "time": 10310.95, "timestamp": "02:51:50", "text": "这意味着有水，但我们在哪里？"}, {"type": "subtitle", "time": 10314.309, "timestamp": "02:51:54", "text": "跳？还有楼梯之类的东西。哦，"}, {"type": "subtitle", "time": 10319.19, "timestamp": "02:51:59", "text": "你死了吗？感谢上帝我没死。"}]
[{"type": "subtitle", "time": 12840.71, "timestamp": "03:34:00", "text": "[音乐]"}, {"type": "subtitle", "time": 12842.229, "timestamp": "03:34:02", "text": "该死。"}, {"type": "subtitle", "time": 12844.79, "timestamp": "03:34:04", "text": "我们如何进入？好的。你"}, {"type": "subtitle", "time": 12848.229, "timestamp": "03:34:08", "text": "找到入口就进去了。"}, {"type": "subtitle", "time": 12851.03, "timestamp": "03:34:11", "text": "这里什么也没有。我想看看"}, {"type": "subtitle", "time": 12852.71, "timestamp": "03:34:12", "text": "那。"}, {"type": "subtitle", "time": 12855.11, "timestamp": "03:34:15", "text": "我不想看，我想看的是如何"}, {"type": "subtitle", "time": 12867.59, "timestamp": "03:34:27", "text": "[音乐]"}, {"type": "subtitle", "time": 12870.229, "timestamp": "03:34:30", "text": "那也挺好的。"}, {"type": "subtitle", "time": 12873.67, "timestamp": "03:34:33", "text": "回忆。哦，你还记得我们在哪里吗？"}, {"type": "subtitle", "time": 12875.99, "timestamp": "03:34:35", "text": "我们像哥布林一样战斗吗？不是"}, {"type": "subtitle", "time": 12879.67, "timestamp": "03:34:39", "text": "哥布林。像哥布林一样的僵尸之类的东西"}, {"type": "subtitle", "time": 12881.67, "timestamp": "03:34:41", "text": "雪。"}, {"type": "subtitle", "time": 12885.67, "timestamp": "03:34:45", "text": "呃。是的。是的。我不得不接受"}, {"type": "subtitle", "time": 12888.15, "timestamp": "03:34:48", "text": "占据高地，试图反击。"}, {"type": "subtitle", "time": 12891.67, "timestamp": "03:34:51", "text": "太痛苦了。难道不是在这里吗？"}, {"type": "subtitle", "time": 12894.55, "timestamp": "03:34:54", "text": "某处？"}, {"type": "subtitle", "time": 12898.71, "timestamp": "03:34:58", "text": "我的天哪，那些日子。"}]
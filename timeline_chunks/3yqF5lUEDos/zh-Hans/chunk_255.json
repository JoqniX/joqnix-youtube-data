[{"type": "subtitle", "time": 15309.67, "timestamp": "04:15:09", "text": "方式，"}, {"type": "subtitle", "time": 15312.63, "timestamp": "04:15:12", "text": "我参与了这个呃"}, {"type": "subtitle", "time": 15316.71, "timestamp": "04:15:16", "text": "楼梯之类的东西。你在哪里？"}, {"type": "subtitle", "time": 15320.229, "timestamp": "04:15:20", "text": "我离剑很近。我会去那里。"}, {"type": "subtitle", "time": 15327.349, "timestamp": "04:15:27", "text": "我就在剑旁边。"}, {"type": "subtitle", "time": 15330.55, "timestamp": "04:15:30", "text": "是的，这边有人。我的意思是，在"}, {"type": "subtitle", "time": 15345.59, "timestamp": "04:15:45", "text": "我在储藏室里。"}, {"type": "subtitle", "time": 15348.63, "timestamp": "04:15:48", "text": "我在剑里。我在剑那里。在"}, {"type": "subtitle", "time": 15355.83, "timestamp": "04:15:55", "text": "哦，就像在这个怪物生成器上面一样"}, {"type": "subtitle", "time": 15357.91, "timestamp": "04:15:57", "text": "东西。"}]
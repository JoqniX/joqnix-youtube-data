[{"type": "subtitle", "time": 18786.868, "timestamp": "05:13:06", "text": "哦。呃，"}, {"type": "subtitle", "time": 18788.948, "timestamp": "05:13:08", "text": "您还想学习其他语言吗？"}, {"type": "subtitle", "time": 18791.91, "timestamp": "05:13:11", "text": "除了日语，你还会学其他语言吗？我有"}, {"type": "subtitle", "time": 18794.788, "timestamp": "05:13:14", "text": "对越南文化有点兴趣，但是"}, {"type": "subtitle", "time": 18798.39, "timestamp": "05:13:18", "text": "这很难。越南风情？哦，是的。我"}, {"type": "subtitle", "time": 18800.15, "timestamp": "05:13:20", "text": "我的意思是，我有一些来自越南的朋友。"}, {"type": "subtitle", "time": 18808.55, "timestamp": "05:13:28", "text": "喜欢"}, {"type": "subtitle", "time": 18811.19, "timestamp": "05:13:31", "text": "越南朋友比印尼朋友多。"}, {"type": "subtitle", "time": 18813.91, "timestamp": "05:13:33", "text": "朋友们。就像我的印尼朋友一样，"}, {"type": "subtitle", "time": 18815.51, "timestamp": "05:13:35", "text": "印尼人到处都是，你"}, {"type": "subtitle", "time": 18817.59, "timestamp": "05:13:37", "text": "知道。"}, {"type": "subtitle", "time": 18819.91, "timestamp": "05:13:39", "text": "是的，我认识几个。今天有"}, {"type": "subtitle", "time": 18822.868, "timestamp": "05:13:42", "text": "一位来自印度尼西亚的新观众。这"}, {"type": "subtitle", "time": 18826.07, "timestamp": "05:13:46", "text": "他的名字叫米沙。妮莎。我想我看到了"}, {"type": "subtitle", "time": 18837.27, "timestamp": "05:13:57", "text": "我想学中文。我不知道"}, {"type": "subtitle", "time": 18839.75, "timestamp": "05:13:59", "text": "如何。我觉得主要原因在于……"}]
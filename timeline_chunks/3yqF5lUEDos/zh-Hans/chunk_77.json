[{"type": "subtitle", "time": 4647.11, "timestamp": "01:17:27", "text": "哦，我太喜欢这个了。"}, {"type": "subtitle", "time": 4654.79, "timestamp": "01:17:34", "text": "他是不是出故障了？"}, {"type": "subtitle", "time": 4657.669, "timestamp": "01:17:37", "text": "先生，您死了吗？"}, {"type": "subtitle", "time": 4660.39, "timestamp": "01:17:40", "text": "你有没有按照我的指示去做？"}, {"type": "subtitle", "time": 4671.35, "timestamp": "01:17:51", "text": "我的意思是，我仍然在尽力去做。"}, {"type": "subtitle", "time": 4674.07, "timestamp": "01:17:54", "text": "慢慢来，慢慢来。不过还有更多东西。"}, {"type": "subtitle", "time": 4676.55, "timestamp": "01:17:56", "text": "更多东西被放下来了。他们都拥有更多"}]
[{"type": "subtitle", "time": 4397.669, "timestamp": "01:13:17", "text": "去死，去死，去死，去死。"}, {"type": "subtitle", "time": 4400.709, "timestamp": "01:13:20", "text": "我为什么保持沉默？"}, {"type": "subtitle", "time": 4403.03, "timestamp": "01:13:23", "text": "已淘汰。"}, {"type": "subtitle", "time": 4406.39, "timestamp": "01:13:26", "text": "我一次又一次地保持沉默。他妈的。"}, {"type": "subtitle", "time": 4414.47, "timestamp": "01:13:34", "text": "不。你能在这种显而易见的情况下进行艺术直播吗？"}, {"type": "subtitle", "time": 4417.83, "timestamp": "01:13:37", "text": "是的，我可以做到。如果这是"}, {"type": "subtitle", "time": 4431.59, "timestamp": "01:13:51", "text": "我正在升级我的突击步枪，所以我"}, {"type": "subtitle", "time": 4435.03, "timestamp": "01:13:55", "text": "可以获得最高等级的物品。"}]
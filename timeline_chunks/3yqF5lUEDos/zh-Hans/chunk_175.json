[{"type": "subtitle", "time": 10500.95, "timestamp": "02:55:00", "text": "或者那个棕色的东西。灵魂石或"}, {"type": "subtitle", "time": 10504.23, "timestamp": "02:55:04", "text": "那边很远的地方。哦，是的。"}, {"type": "subtitle", "time": 10515.19, "timestamp": "02:55:15", "text": "这里有一颗灵魂石。"}, {"type": "subtitle", "time": 10526.71, "timestamp": "02:55:26", "text": "就连蜘蛛都无法生存。"}, {"type": "subtitle", "time": 10529.67, "timestamp": "02:55:29", "text": "好了，我要跳了。我们不能死。"}, {"type": "subtitle", "time": 10532.87, "timestamp": "02:55:32", "text": "我要跳下去。好的。好的，我们有"}, {"type": "subtitle", "time": 10536.71, "timestamp": "02:55:36", "text": "这里是管道。看，"}, {"type": "subtitle", "time": 10539.67, "timestamp": "02:55:39", "text": "你会跳吗？导管，"}, {"type": "subtitle", "time": 10542.07, "timestamp": "02:55:42", "text": "等待。是的，下面有一条管道。"}, {"type": "subtitle", "time": 10546.71, "timestamp": "02:55:46", "text": "别摔倒。好的。好，我们下去吧。"}, {"type": "subtitle", "time": 10549.269, "timestamp": "02:55:49", "text": "公寓。"}, {"type": "subtitle", "time": 10551.83, "timestamp": "02:55:51", "text": "哦，这里有个低洼处。"}, {"type": "subtitle", "time": 10554.23, "timestamp": "02:55:54", "text": "哦，向下。"}, {"type": "subtitle", "time": 10557.429, "timestamp": "02:55:57", "text": "你为什么不去管道那里？"}, {"type": "subtitle", "time": 10559.429, "timestamp": "02:55:59", "text": "我这就去"}]
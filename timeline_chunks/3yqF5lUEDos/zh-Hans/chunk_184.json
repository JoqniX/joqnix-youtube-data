[{"type": "subtitle", "time": 11041.83, "timestamp": "03:04:01", "text": "秒。哦，不。然后我就问：什么？"}, {"type": "subtitle", "time": 11043.75, "timestamp": "03:04:03", "text": "你到底在这里干什么？我的意思是，"}, {"type": "subtitle", "time": 11044.95, "timestamp": "03:04:04", "text": "因为我当时什么也看不见，所以我"}, {"type": "subtitle", "time": 11059.269, "timestamp": "03:04:19", "text": "你在干什么？"}, {"type": "subtitle", "time": 11061.51, "timestamp": "03:04:21", "text": "我懂那种感觉。但有时"}, {"type": "subtitle", "time": 11065.03, "timestamp": "03:04:25", "text": "我爸妈去的地方就像……"}, {"type": "subtitle", "time": 11067.03, "timestamp": "03:04:27", "text": "我待在我的房间里，就坐在我的房间里，我"}, {"type": "subtitle", "time": 11086.15, "timestamp": "03:04:46", "text": "拿一个。"}, {"type": "subtitle", "time": 11088.15, "timestamp": "03:04:48", "text": "清点一下你的库存。"}, {"type": "subtitle", "time": 11090.309, "timestamp": "03:04:50", "text": "对，你把所有的钻石都拿走了。我是"}]
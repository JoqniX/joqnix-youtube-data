[{"type": "subtitle", "time": 8040.069, "timestamp": "02:14:00", "text": "对软件和软件要友善。"}, {"type": "subtitle", "time": 8043.669, "timestamp": "02:14:03", "text": "会对你很好。是的，没错。"}, {"type": "subtitle", "time": 8048.31, "timestamp": "02:14:08", "text": "直播前我就像那样"}, {"type": "subtitle", "time": 8051.75, "timestamp": "02:14:11", "text": "我知道对于《战地2042》来说，它是一款……"}, {"type": "subtitle", "time": 8054.55, "timestamp": "02:14:14", "text": "重型游戏。请"}, {"type": "subtitle", "time": 8063.189, "timestamp": "02:14:23", "text": "请工作"}, {"type": "subtitle", "time": 8066.149, "timestamp": "02:14:26", "text": "即使如此，我也不会把任何责任归咎于你。"}, {"type": "subtitle", "time": 8068.39, "timestamp": "02:14:28", "text": "如果你崩溃了"}, {"type": "subtitle", "time": 8072.87, "timestamp": "02:14:32", "text": "没关系，不过请你先工作吧。"}, {"type": "subtitle", "time": 8075.109, "timestamp": "02:14:35", "text": "开始此帧"}, {"type": "subtitle", "time": 8078.95, "timestamp": "02:14:38", "text": "是的，在游戏电脑上。"}, {"type": "subtitle", "time": 8084.29, "timestamp": "02:14:44", "text": "玛雅"}, {"type": "subtitle", "time": 8086.629, "timestamp": "02:14:46", "text": "[音乐]"}, {"type": "subtitle", "time": 8092.39, "timestamp": "02:14:52", "text": "也为了我和其他所有人"}, {"type": "subtitle", "time": 8096.229, "timestamp": "02:14:56", "text": "呃，他告诉我它运行缓慢，而且"}, {"type": "subtitle", "time": 8098.709, "timestamp": "02:14:58", "text": "声音很大，一切都很正常。谢谢"}]
[{"type": "subtitle", "time": 811.75, "timestamp": "00:13:31", "text": "孩子，你竟然做了那种事？你"}, {"type": "subtitle", "time": 814.87, "timestamp": "00:13:34", "text": "孩子。我的天哪。"}, {"type": "subtitle", "time": 816.87, "timestamp": "00:13:36", "text": "杀了我。"}, {"type": "subtitle", "time": 819.19, "timestamp": "00:13:39", "text": "韦恩，"}, {"type": "subtitle", "time": 822.15, "timestamp": "00:13:42", "text": "我可以战斗过去吗？请"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "别死。请不要死。请"}, {"type": "subtitle", "time": 829.03, "timestamp": "00:13:49", "text": "别死。我们的战术优于"}, {"type": "subtitle", "time": 832.31, "timestamp": "00:13:52", "text": "他们的。胜利属于我们。"}]
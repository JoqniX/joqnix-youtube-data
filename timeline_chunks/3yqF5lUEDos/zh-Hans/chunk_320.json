[{"type": "subtitle", "time": 19200.15, "timestamp": "05:20:00", "text": "不，她大部分时间都很忙。所以，我是"}, {"type": "subtitle", "time": 19211.91, "timestamp": "05:20:11", "text": "开玩笑说"}, {"type": "subtitle", "time": 19216.708, "timestamp": "05:20:16", "text": "等待。嗯，大多数时候"}, {"type": "subtitle", "time": 19221.99, "timestamp": "05:20:21", "text": "就像……呃，它随时待命，是的。"}, {"type": "subtitle", "time": 19224.23, "timestamp": "05:20:24", "text": "总是疼痛"}, {"type": "subtitle", "time": 19227.03, "timestamp": "05:20:27", "text": "用日语交谈。所以我把英语搞混了"}, {"type": "subtitle", "time": 19229.67, "timestamp": "05:20:29", "text": "和日本人一起。"}, {"type": "subtitle", "time": 19232.628, "timestamp": "05:20:32", "text": "你好。比如每当我不认识某个词的时候，我"}, {"type": "subtitle", "time": 19235.43, "timestamp": "05:20:35", "text": "试着用英语说出来，如果她"}, {"type": "subtitle", "time": 19242.39, "timestamp": "05:20:42", "text": "我一直都用翻译器，比如谷歌翻译。"}, {"type": "subtitle", "time": 19244.708, "timestamp": "05:20:44", "text": "译者。但我了解到那是"}, {"type": "subtitle", "time": 19246.788, "timestamp": "05:20:46", "text": "不太好。"}, {"type": "subtitle", "time": 19249.27, "timestamp": "05:20:49", "text": "呃，谷歌翻译，那不是吗？"}, {"type": "subtitle", "time": 19252.23, "timestamp": "05:20:52", "text": "好的。而且翻译也很糟糕"}, {"type": "subtitle", "time": 19253.91, "timestamp": "05:20:53", "text": "笨蛋。"}]
[{"type": "subtitle", "time": 17460.23, "timestamp": "04:51:00", "text": "运用你的动作，你知道的"}, {"type": "subtitle", "time": 17464.23, "timestamp": "04:51:04", "text": "大脑网络。好的。它不是在放呃"}, {"type": "subtitle", "time": 17466.15, "timestamp": "04:51:06", "text": "它不是把图片放在你的……里面。"}, {"type": "subtitle", "time": 17468.15, "timestamp": "04:51:08", "text": "大脑会让你像你一样思考"}, {"type": "subtitle", "time": 17470.55, "timestamp": "04:51:10", "text": "参与了比赛。就是这样。啊"}, {"type": "subtitle", "time": 17472.47, "timestamp": "04:51:12", "text": "是的"}, {"type": "subtitle", "time": 17474.628, "timestamp": "04:51:14", "text": "但是，类似立方体的概念是如此"}, {"type": "subtitle", "time": 17477.43, "timestamp": "04:51:17", "text": "挺酷的。感觉就像是搜索引擎优化（SEO）"}, {"type": "subtitle", "time": 17480.55, "timestamp": "04:51:20", "text": "当你说起那个“化”的时候"}, {"type": "subtitle", "time": 17481.43, "timestamp": "04:51:21", "text": "我。"}, {"type": "subtitle", "time": 17484.55, "timestamp": "04:51:24", "text": "我当时就想：“我的天哪。”"}, {"type": "subtitle", "time": 17487.27, "timestamp": "04:51:27", "text": "我想知道你发生了什么事。他们可以"}, {"type": "subtitle", "time": 17489.99, "timestamp": "04:51:29", "text": "实际上取得了进一步进展。是的。是的。"}, {"type": "subtitle", "time": 17492.868, "timestamp": "04:51:32", "text": "是的。是的。他们可以。是的。他们可以"}, {"type": "subtitle", "time": 17495.27, "timestamp": "04:51:35", "text": "继续前进。"}, {"type": "subtitle", "time": 17497.99, "timestamp": "04:51:37", "text": "我认为最需要的是一个"}, {"type": "subtitle", "time": 17500.31, "timestamp": "04:51:40", "text": "良好的电源。"}, {"type": "subtitle", "time": 17502.628, "timestamp": "04:51:42", "text": "哦是的。"}, {"type": "subtitle", "time": 17504.788, "timestamp": "04:51:44", "text": "我的意思是，我觉得他们总可以试试。"}, {"type": "subtitle", "time": 17507.19, "timestamp": "04:51:47", "text": "活性元素"}, {"type": "subtitle", "time": 17510.23, "timestamp": "04:51:50", "text": "为了电力。"}, {"type": "subtitle", "time": 17513.27, "timestamp": "04:51:53", "text": "我觉得好吧，我不应该"}, {"type": "subtitle", "time": 17515.67, "timestamp": "04:51:55", "text": "谈论机密事项。是的。"}, {"type": "subtitle", "time": 17518.39, "timestamp": "04:51:58", "text": "是的。你不应该这样做。是的。是的。"}]
[{"type": "subtitle", "time": 14593.67, "timestamp": "04:03:13", "text": "这太长了"}, {"type": "subtitle", "time": 14596.389, "timestamp": "04:03:16", "text": "我们为什么又拖了这么久？我不"}, {"type": "subtitle", "time": 14602.309, "timestamp": "04:03:22", "text": "啊，你来了。"}, {"type": "subtitle", "time": 14603.83, "timestamp": "04:03:23", "text": "是的，"}, {"type": "subtitle", "time": 14605.349, "timestamp": "04:03:25", "text": "那就是"}, {"type": "subtitle", "time": 14608.309, "timestamp": "04:03:28", "text": "是的。哦，"}, {"type": "subtitle", "time": 14610.389, "timestamp": "04:03:30", "text": "我就是在这里弄到蘑菇的。"}, {"type": "subtitle", "time": 14612.309, "timestamp": "04:03:32", "text": "东西。"}, {"type": "subtitle", "time": 14616.71, "timestamp": "04:03:36", "text": "不，是整个海洋。你好。好的。我们"}, {"type": "subtitle", "time": 14621.349, "timestamp": "04:03:41", "text": "还记得来过这里吗？是的，这是"}, {"type": "subtitle", "time": 14628.95, "timestamp": "04:03:48", "text": "我们在这里建造了房屋。"}, {"type": "subtitle", "time": 14631.75, "timestamp": "04:03:51", "text": "我们为什么会在这里？我忘了。"}, {"type": "subtitle", "time": 14634.55, "timestamp": "04:03:54", "text": "我也觉得也许有两匹马"}, {"type": "subtitle", "time": 14636.87, "timestamp": "04:03:56", "text": "我想，大概是为了买房子吧。好马。"}, {"type": "subtitle", "time": 14638.389, "timestamp": "04:03:58", "text": "是的。"}]
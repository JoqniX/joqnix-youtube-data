[{"type": "subtitle", "time": 4992.87, "timestamp": "01:23:12", "text": "我倒下了。不，不，不，不。哦，等等。我"}, {"type": "subtitle", "time": 4994.95, "timestamp": "01:23:14", "text": "忘了。"}, {"type": "subtitle", "time": 4997.669, "timestamp": "01:23:17", "text": "哦，你知道今天发生了什么事吗？我输了"}, {"type": "subtitle", "time": 5002.149, "timestamp": "01:23:22", "text": "我在打扫房间的时候弄丢了我的眼镜。"}, {"type": "subtitle", "time": 5005.51, "timestamp": "01:23:25", "text": "我的房间清洁工作。今天我测试"}, {"type": "subtitle", "time": 5007.75, "timestamp": "01:23:27", "text": "全部"}, {"type": "subtitle", "time": 5012.31, "timestamp": "01:23:32", "text": "我的房间和电脑设备。我的天哪。"}, {"type": "subtitle", "time": 5016.47, "timestamp": "01:23:36", "text": "哈希值达到上限。什么？"}, {"type": "subtitle", "time": 5021.99, "timestamp": "01:23:41", "text": "什么？好的。所以，嗯，显然我"}, {"type": "subtitle", "time": 5025.51, "timestamp": "01:23:45", "text": "不小心把眼镜弄丢了。"}, {"type": "subtitle", "time": 5028.149, "timestamp": "01:23:48", "text": "我把眼镜放在床上，然后我拿"}, {"type": "subtitle", "time": 5031.51, "timestamp": "01:23:51", "text": "我把床单拿出来，铺好。"}, {"type": "subtitle", "time": 5034.47, "timestamp": "01:23:54", "text": "洗衣机在洗衣房里"}, {"type": "subtitle", "time": 5037.43, "timestamp": "01:23:57", "text": "我当时就像到处找我的东西一样。"}, {"type": "subtitle", "time": 5039.83, "timestamp": "01:23:59", "text": "眼镜。"}]
[{"type": "subtitle", "time": 8281.91, "timestamp": "02:18:01", "text": "呃，通过和你们一起制作。命运，"}, {"type": "subtitle", "time": 8283.429, "timestamp": "02:18:03", "text": "我已经有一段时间没打开它了"}, {"type": "subtitle", "time": 8286.95, "timestamp": "02:18:06", "text": "命运。阿什，你好吗？你是什​​么人"}, {"type": "subtitle", "time": 8289.99, "timestamp": "02:18:09", "text": "伙计们，你们在干嘛？"}, {"type": "subtitle", "time": 8293.99, "timestamp": "02:18:13", "text": "等等，深石地穴今天开放吗？"}, {"type": "subtitle", "time": 8296.709, "timestamp": "02:18:16", "text": "是的。"}, {"type": "subtitle", "time": 8299.589, "timestamp": "02:18:19", "text": "你最近怎么样？我一直都表现得很好。我已经"}, {"type": "subtitle", "time": 8302.549, "timestamp": "02:18:22", "text": "一直都很好。好久不见了。我呃"}, {"type": "subtitle", "time": 8306.389, "timestamp": "02:18:26", "text": "玩了《命运》。我有点……睡着了。"}, {"type": "subtitle", "time": 8309.589, "timestamp": "02:18:29", "text": "命运，因为我刷得太多了。"}, {"type": "subtitle", "time": 8314.07, "timestamp": "02:18:34", "text": "我转而玩其他游戏，比如Apex英雄。"}, {"type": "subtitle", "time": 8316.79, "timestamp": "02:18:36", "text": "一点。"}, {"type": "subtitle", "time": 8318.87, "timestamp": "02:18:38", "text": "是的，"}, {"type": "subtitle", "time": 8322.469, "timestamp": "02:18:42", "text": "命运2。是的，今晚没有DSC。哦，"}, {"type": "subtitle", "time": 8328.309, "timestamp": "02:18:48", "text": "你好。下次副本什么时候打？"}, {"type": "subtitle", "time": 8331.83, "timestamp": "02:18:51", "text": "突袭是。我很兴奋。是的。别介意"}, {"type": "subtitle", "time": 8335.11, "timestamp": "02:18:55", "text": "我。如果声音一直响着，请不要介意。"}]
[{"type": "subtitle", "time": 12902.229, "timestamp": "03:35:02", "text": "天哪，我都要哭了。"}, {"type": "subtitle", "time": 12905.11, "timestamp": "03:35:05", "text": "啊，回忆啊。"}, {"type": "subtitle", "time": 12908.87, "timestamp": "03:35:08", "text": "很多人乘船去找蚂蚁。"}, {"type": "subtitle", "time": 12912.55, "timestamp": "03:35:12", "text": "好的。你为什么恨击？"}, {"type": "subtitle", "time": 12916.63, "timestamp": "03:35:16", "text": "现在所有人都会来找你麻烦了。我"}, {"type": "subtitle", "time": 12918.87, "timestamp": "03:35:18", "text": "跑步。"}, {"type": "subtitle", "time": 12922.229, "timestamp": "03:35:22", "text": "有很多。"}, {"type": "subtitle", "time": 12924.36, "timestamp": "03:35:24", "text": "我们都要死了。你中毒了。"}, {"type": "subtitle", "time": 12927.75, "timestamp": "03:35:27", "text": "[音乐]"}, {"type": "subtitle", "time": 12940.07, "timestamp": "03:35:40", "text": "那些烦人的蜜蜂。我以为只有一个"}, {"type": "subtitle", "time": 12941.67, "timestamp": "03:35:41", "text": "会"}, {"type": "subtitle", "time": 12944.79, "timestamp": "03:35:44", "text": "我以为只会有一个人来。我"}, {"type": "subtitle", "time": 12947.11, "timestamp": "03:35:47", "text": "就像那群蜜蜂一样，他们什么都不知道。"}, {"type": "subtitle", "time": 12951.51, "timestamp": "03:35:51", "text": "会来的。还在生气，你知道吗？"}, {"type": "subtitle", "time": 12954.53, "timestamp": "03:35:54", "text": "下面那个。"}, {"type": "subtitle", "time": 12956.07, "timestamp": "03:35:56", "text": "[音乐]"}, {"type": "subtitle", "time": 12959.11, "timestamp": "03:35:59", "text": "宝贝，他们会攻击我吗？不，很好。看"}]
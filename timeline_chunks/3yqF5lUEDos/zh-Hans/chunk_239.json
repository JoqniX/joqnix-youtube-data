[{"type": "subtitle", "time": 14341.429, "timestamp": "03:59:01", "text": "蜂蜜"}, {"type": "subtitle", "time": 14345.189, "timestamp": "03:59:05", "text": "突击胸部蜂蜜。"}, {"type": "subtitle", "time": 14351.67, "timestamp": "03:59:11", "text": "哦，"}, {"type": "subtitle", "time": 14355.429, "timestamp": "03:59:15", "text": "好的。什么也没有。"}, {"type": "subtitle", "time": 14360.309, "timestamp": "03:59:20", "text": "有人把我偷走了。嗯？偷来的。你"}, {"type": "subtitle", "time": 14362.87, "timestamp": "03:59:22", "text": "忘了。或许"}, {"type": "subtitle", "time": 14365.67, "timestamp": "03:59:25", "text": "确实如此。这个。它在后面。"}, {"type": "subtitle", "time": 14377.429, "timestamp": "03:59:37", "text": "我找不到我保存的那个视频了。我"}, {"type": "subtitle", "time": 14385.31, "timestamp": "03:59:45", "text": "凉爽的。"}, {"type": "subtitle", "time": 14386.79, "timestamp": "03:59:46", "text": "[音乐]"}, {"type": "subtitle", "time": 14389.189, "timestamp": "03:59:49", "text": "我会把视频链接发给你"}, {"type": "subtitle", "time": 14391.349, "timestamp": "03:59:51", "text": "Discord。"}, {"type": "subtitle", "time": 14394.229, "timestamp": "03:59:54", "text": "您可以分享。是的。是的，我会展示的。"}, {"type": "subtitle", "time": 14395.99, "timestamp": "03:59:55", "text": "之后。不用担心。"}, {"type": "subtitle", "time": 14399.59, "timestamp": "03:59:59", "text": "好的，这边来了。"}]
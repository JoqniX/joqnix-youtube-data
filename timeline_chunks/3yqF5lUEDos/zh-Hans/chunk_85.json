[{"type": "subtitle", "time": 5102.31, "timestamp": "01:25:02", "text": "床单或者洗衣桶之类的东西"}, {"type": "subtitle", "time": 5105.35, "timestamp": "01:25:05", "text": "呃，在那个推机里面。我"}, {"type": "subtitle", "time": 5107.35, "timestamp": "01:25:07", "text": "拉开床单，然后……"}, {"type": "subtitle", "time": 5110.07, "timestamp": "01:25:10", "text": "去。我的眼镜掉了下来，掉了出来。我当时"}, {"type": "subtitle", "time": 5113.43, "timestamp": "01:25:13", "text": "比如，“我的天哪，想象一下”"}, {"type": "subtitle", "time": 5117.51, "timestamp": "01:25:17", "text": "我的天啊。想象一下如果我戴上眼镜会怎样"}, {"type": "subtitle", "time": 5120.55, "timestamp": "01:25:20", "text": "用洗衣机洗过。那将是"}, {"type": "subtitle", "time": 5122.47, "timestamp": "01:25:22", "text": "可怕。”"}, {"type": "subtitle", "time": 5125.83, "timestamp": "01:25:25", "text": "是的。亲爱的你好。你好吗？巴卡，"}, {"type": "subtitle", "time": 5128.629, "timestamp": "01:25:28", "text": "今天这只鲹鱼过得怎么样？"}, {"type": "subtitle", "time": 5130.79, "timestamp": "01:25:30", "text": "希望你一切都好。我肚子疼。"}, {"type": "subtitle", "time": 5134.39, "timestamp": "01:25:34", "text": "更多的。你还记得我对你说的话吗？"}, {"type": "subtitle", "time": 5137.27, "timestamp": "01:25:37", "text": "你上次是不是胃痛？"}, {"type": "subtitle", "time": 5140.709, "timestamp": "01:25:40", "text": "试着说放松，放松，多念诵。"}, {"type": "subtitle", "time": 5144.31, "timestamp": "01:25:44", "text": "也可以试试用湿毛巾或温热的毛巾敷一下。"}, {"type": "subtitle", "time": 5147.669, "timestamp": "01:25:47", "text": "毛巾。不，不，其实呃，湿冷"}, {"type": "subtitle", "time": 5151.59, "timestamp": "01:25:51", "text": "毛巾。只需用清水冲洗即可"}, {"type": "subtitle", "time": 5153.83, "timestamp": "01:25:53", "text": "毛巾"}, {"type": "subtitle", "time": 5155.75, "timestamp": "01:25:55", "text": "用普通水冲洗一下，然后倒在你的……上"}, {"type": "subtitle", "time": 5159.35, "timestamp": "01:25:59", "text": "肚子贴着你的胃。"}]
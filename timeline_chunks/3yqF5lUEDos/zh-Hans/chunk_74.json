[{"type": "subtitle", "time": 4459.35, "timestamp": "01:14:19", "text": "快点。我们是在与一堵墙作斗争。我们开始吧"}, {"type": "subtitle", "time": 4462.95, "timestamp": "01:14:22", "text": "去。座位。去拿弹药。座位。座位。座位。"}, {"type": "subtitle", "time": 4465.83, "timestamp": "01:14:25", "text": "我们走吧。跑步。跑步。跑步。我正在跑步"}, {"type": "subtitle", "time": 4468.39, "timestamp": "01:14:28", "text": "经历了地狱般的折磨。我正在奔向哦，"}, {"type": "subtitle", "time": 4471.43, "timestamp": "01:14:31", "text": "那是我的队友。进来。进来。"}, {"type": "subtitle", "time": 4473.189, "timestamp": "01:14:33", "text": "去拿弹药。去拿弹药。获取"}]
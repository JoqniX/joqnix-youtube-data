[{"type": "subtitle", "time": 11520.87, "timestamp": "03:12:00", "text": "服务器好像在告诉我打开"}, {"type": "subtitle", "time": 11525.67, "timestamp": "03:12:05", "text": "服务器，是的。是的。那些日子。"}, {"type": "subtitle", "time": 11527.75, "timestamp": "03:12:07", "text": "好的。是的。萨蒂安。我们正在谈论的是"}, {"type": "subtitle", "time": 11529.75, "timestamp": "03:12:09", "text": "萨蒂安。是的。萨蒂安。是的。是的。那"}, {"type": "subtitle", "time": 11531.91, "timestamp": "03:12:11", "text": "就是这个名字。我当时就想，呃，那是她"}, {"type": "subtitle", "time": 11536.15, "timestamp": "03:12:16", "text": "房子。萨蒂安。是的。那是她的房子"}, {"type": "subtitle", "time": 11539.349, "timestamp": "03:12:19", "text": "那里。我至今仍记得我玩耍的那一天。"}, {"type": "subtitle", "time": 11542.79, "timestamp": "03:12:22", "text": "嗯，这是我第一次和她在一起。"}, {"type": "subtitle", "time": 11544.87, "timestamp": "03:12:24", "text": "是的。这样的"}, {"type": "subtitle", "time": 11547.75, "timestamp": "03:12:27", "text": "看看她的房子。它是"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "她仍然是一位相当漂亮的新人。"}, {"type": "subtitle", "time": 11555.75, "timestamp": "03:12:35", "text": "我想我一直在等她"}, {"type": "subtitle", "time": 11567.349, "timestamp": "03:12:47", "text": "哦。哦，是的。我记得我已经习惯了"}, {"type": "subtitle", "time": 11569.67, "timestamp": "03:12:49", "text": "利用她。看看这个。还有"}, {"type": "subtitle", "time": 11572.71, "timestamp": "03:12:52", "text": "这里是制作室，而不是我的。"}, {"type": "subtitle", "time": 11576.15, "timestamp": "03:12:56", "text": "哦，是的。是的。她写了这本书"}]
[{"type": "subtitle", "time": 4691.75, "timestamp": "01:18:11", "text": "我的天啊。乔。"}, {"type": "subtitle", "time": 4695.83, "timestamp": "01:18:15", "text": "哦，我一直都是这样。我该如何获得"}, {"type": "subtitle", "time": 4698.55, "timestamp": "01:18:18", "text": "我该怎么做？"}, {"type": "subtitle", "time": 4700.87, "timestamp": "01:18:20", "text": "这一切都是徒劳。嗯？不，这不是"}, {"type": "subtitle", "time": 4702.47, "timestamp": "01:18:22", "text": "浪费"}, {"type": "subtitle", "time": 4709.51, "timestamp": "01:18:29", "text": "等等，什么？你都跟我讲了些什么？"}, {"type": "subtitle", "time": 4713.03, "timestamp": "01:18:33", "text": "让我再做一遍？我忘了。"}, {"type": "subtitle", "time": 4714.87, "timestamp": "01:18:34", "text": "他让我练习唱歌。我，我已经"}, {"type": "subtitle", "time": 4717.51, "timestamp": "01:18:37", "text": "一直在这样做。我一直在画一幅"}, {"type": "subtitle", "time": 4720.229, "timestamp": "01:18:40", "text": "一点。"}, {"type": "subtitle", "time": 4723.75, "timestamp": "01:18:43", "text": "现在当我感到无聊的时候"}, {"type": "subtitle", "time": 4727.11, "timestamp": "01:18:47", "text": "在一张纸上，"}, {"type": "subtitle", "time": 4738.79, "timestamp": "01:18:58", "text": "我跟你说过什么来着？呃，对了。"}]
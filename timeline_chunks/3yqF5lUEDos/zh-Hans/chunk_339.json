[{"type": "subtitle", "time": 20341.19, "timestamp": "05:39:01", "text": "我当时就想，等等，怎么会这样？嗯？等待，"}, {"type": "subtitle", "time": 20344.47, "timestamp": "05:39:04", "text": "什么？如何？"}, {"type": "subtitle", "time": 20346.548, "timestamp": "05:39:06", "text": "真是太出乎意料了。是的，就是这样。"}, {"type": "subtitle", "time": 20349.91, "timestamp": "05:39:09", "text": "和他在一起真的非常开心。"}, {"type": "subtitle", "time": 20352.628, "timestamp": "05:39:12", "text": "感谢Mikama的到来"}, {"type": "subtitle", "time": 20355.59, "timestamp": "05:39:15", "text": "查玛今天来了。查玛，谢谢你来访"}, {"type": "subtitle", "time": 20357.59, "timestamp": "05:39:17", "text": "今天。"}, {"type": "subtitle", "time": 20360.788, "timestamp": "05:39:20", "text": "希望你今天过得愉快。 Cosmo exi 也来了。"}, {"type": "subtitle", "time": 20363.51, "timestamp": "05:39:23", "text": "感谢Arata Cosmo今天光临。希望"}, {"type": "subtitle", "time": 20366.39, "timestamp": "05:39:26", "text": "你今天过得很开心。祝你好运！"}, {"type": "subtitle", "time": 20369.27, "timestamp": "05:39:29", "text": "今天剩下的时间你都还未准备好。然后是路飞·查玛"}, {"type": "subtitle", "time": 20372.948, "timestamp": "05:39:32", "text": "今天过来了。感谢路飞的到来。希望"}, {"type": "subtitle", "time": 20375.59, "timestamp": "05:39:35", "text": "你今天过得很开心。谢谢。是的。"}, {"type": "subtitle", "time": 20379.19, "timestamp": "05:39:39", "text": "Kakosan今天来了。卡科萨你的"}, {"type": "subtitle", "time": 20381.99, "timestamp": "05:39:41", "text": "朋友昨天来过瓦莱兰特"}, {"type": "subtitle", "time": 20383.59, "timestamp": "05:39:43", "text": "溪流。"}, {"type": "subtitle", "time": 20386.47, "timestamp": "05:39:46", "text": "是的。感谢您光临Kakosan"}, {"type": "subtitle", "time": 20390.628, "timestamp": "05:39:50", "text": "再次。然后尼莎·尼莎今天过来了。"}, {"type": "subtitle", "time": 20396.39, "timestamp": "05:39:56", "text": "Nishaan是本频道的新观众。"}]
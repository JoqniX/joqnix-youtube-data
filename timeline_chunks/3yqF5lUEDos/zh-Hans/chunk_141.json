[{"type": "subtitle", "time": 8461.11, "timestamp": "02:21:01", "text": "他们"}, {"type": "subtitle", "time": 8463.429, "timestamp": "02:21:03", "text": "你喜欢男生吗？喜欢我还是讨厌我？"}, {"type": "subtitle", "time": 8465.51, "timestamp": "02:21:05", "text": "是不是看视频看得太多了？我想知道你的"}, {"type": "subtitle", "time": 8467.51, "timestamp": "02:21:07", "text": "想法。所以"}, {"type": "subtitle", "time": 8471.83, "timestamp": "02:21:11", "text": "呃，75 人说，百分比的人说"}, {"type": "subtitle", "time": 8475.03, "timestamp": "02:21:15", "text": "嗯，是的，说“是”的百分比"}, {"type": "subtitle", "time": 8478.309, "timestamp": "02:21:18", "text": "25% 的人表示不同意。所以我就想"}, {"type": "subtitle", "time": 8480.87, "timestamp": "02:21:20", "text": "使困惑。"}, {"type": "subtitle", "time": 8483.99, "timestamp": "02:21:23", "text": "你是不是讨厌我直播太多？"}, {"type": "subtitle", "time": 8488.87, "timestamp": "02:21:28", "text": "还是你喜欢我说的“喜欢”或“讨厌”？"}, {"type": "subtitle", "time": 8493.75, "timestamp": "02:21:33", "text": "所以，就像是第一个，所以是的，会是"}, {"type": "subtitle", "time": 8495.67, "timestamp": "02:21:35", "text": "就像对的一样。所以你们喜欢我"}, {"type": "subtitle", "time": 8502.07, "timestamp": "02:21:42", "text": "你赢了"}, {"type": "subtitle", "time": 8506.71, "timestamp": "02:21:46", "text": "倒退12小时。"}, {"type": "subtitle", "time": 8509.83, "timestamp": "02:21:49", "text": "我希望祖基不在这里。她会敲钟"}, {"type": "subtitle", "time": 8513.19, "timestamp": "02:21:53", "text": "我。又名她，他们会把我打得鼻青脸肿。啊 12"}, {"type": "subtitle", "time": 8515.67, "timestamp": "02:21:55", "text": "每小时直播。人们不想做"}, {"type": "subtitle", "time": 8517.67, "timestamp": "02:21:57", "text": "直播时间过长。"}, {"type": "subtitle", "time": 8519.75, "timestamp": "02:21:59", "text": "我想"}]
[{"type": "subtitle", "time": 11700.95, "timestamp": "03:15:00", "text": "是的。太酷了。是的。帕蒂一号。"}, {"type": "subtitle", "time": 11702.95, "timestamp": "03:15:02", "text": "好的。"}, {"type": "subtitle", "time": 11705.19, "timestamp": "03:15:05", "text": "谢谢你们的款待。你怎么说"}, {"type": "subtitle", "time": 11707.11, "timestamp": "03:15:07", "text": "用日语怎么说？"}, {"type": "subtitle", "time": 11712.229, "timestamp": "03:15:12", "text": "我猜也是。"}, {"type": "subtitle", "time": 11714.389, "timestamp": "03:15:14", "text": "是的。"}, {"type": "subtitle", "time": 11723.99, "timestamp": "03:15:23", "text": "我在外面。"}, {"type": "subtitle", "time": 11726.95, "timestamp": "03:15:26", "text": "你离开了我。"}, {"type": "subtitle", "time": 11737.99, "timestamp": "03:15:37", "text": "好了，现在该去主地下室了。"}, {"type": "subtitle", "time": 11741.99, "timestamp": "03:15:41", "text": "你真的想去吗？是的。再见。"}, {"type": "subtitle", "time": 11750.309, "timestamp": "03:15:50", "text": "我的天啊。记得他当时就像滔滔不绝地滔滔不绝地讲着什么。"}, {"type": "subtitle", "time": 11753.75, "timestamp": "03:15:53", "text": "难的。我的天啊，"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "他们记得那段视频。想象一下如果是"}, {"type": "subtitle", "time": 11759.75, "timestamp": "03:15:59", "text": "这里是直播间，或者就像在看直播一样。"}]
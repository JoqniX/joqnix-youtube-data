[{"type": "subtitle", "time": 11221.349, "timestamp": "03:07:01", "text": "这是什么？这是 这是"}, {"type": "subtitle", "time": 11224.389, "timestamp": "03:07:04", "text": "它上面写了什么。"}, {"type": "subtitle", "time": 11227.19, "timestamp": "03:07:07", "text": "好吧，我们尽量简单点。"}, {"type": "subtitle", "time": 11229.349, "timestamp": "03:07:09", "text": "这是一座监狱。"}, {"type": "subtitle", "time": 11235.83, "timestamp": "03:07:15", "text": "我在这里没有说脏话。我是说，"}, {"type": "subtitle", "time": 11240.469, "timestamp": "03:07:20", "text": "这里最糟糕的词。我崩溃了。哦。哦。"}, {"type": "subtitle", "time": 11244.389, "timestamp": "03:07:24", "text": "哦。哦，那简直就是一座监狱。"}, {"type": "subtitle", "time": 11247.19, "timestamp": "03:07:27", "text": "我认为。"}, {"type": "subtitle", "time": 11249.91, "timestamp": "03:07:29", "text": "你为什么要建监狱？"}, {"type": "subtitle", "time": 11254.23, "timestamp": "03:07:34", "text": "不是我。是新冠病毒。"}, {"type": "subtitle", "time": 11256.55, "timestamp": "03:07:36", "text": "我的天啊。"}, {"type": "subtitle", "time": 11259.19, "timestamp": "03:07:39", "text": "哦，宝贝。门的一侧锁上了。"}, {"type": "subtitle", "time": 11261.269, "timestamp": "03:07:41", "text": "等等，什么？"}, {"type": "subtitle", "time": 11269.91, "timestamp": "03:07:49", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 11276.55, "timestamp": "03:07:56", "text": "力量。"}]
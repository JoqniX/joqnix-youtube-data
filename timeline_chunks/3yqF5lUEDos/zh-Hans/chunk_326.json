[{"type": "subtitle", "time": 19565.75, "timestamp": "05:26:05", "text": "哦，是的。你自从……之后就没玩过Va了"}, {"type": "subtitle", "time": 19569.35, "timestamp": "05:26:09", "text": "现在？呃，我的意思是，我现在电脑上就有。"}, {"type": "subtitle", "time": 19573.19, "timestamp": "05:26:13", "text": "但我认为我无法在线观看。是的，"}, {"type": "subtitle", "time": 19575.99, "timestamp": "05:26:15", "text": "虽然有点麻烦，但"}, {"type": "subtitle", "time": 19577.59, "timestamp": "05:26:17", "text": "是的，"}, {"type": "subtitle", "time": 19579.67, "timestamp": "05:26:19", "text": "我们很快就能玩到它了。不"}, {"type": "subtitle", "time": 19581.19, "timestamp": "05:26:21", "text": "担心。"}, {"type": "subtitle", "time": 19583.75, "timestamp": "05:26:23", "text": "是的，将来也可以用。"}, {"type": "subtitle", "time": 19586.47, "timestamp": "05:26:26", "text": "测试版结束后，你就可以玩了。"}, {"type": "subtitle", "time": 19588.39, "timestamp": "05:26:28", "text": "在手机上查看。"}, {"type": "subtitle", "time": 19591.67, "timestamp": "05:26:31", "text": "啊，当然。但问题是，每个人都来自"}, {"type": "subtitle", "time": 19595.03, "timestamp": "05:26:35", "text": "VR社区对VR开发商感到愤怒。"}, {"type": "subtitle", "time": 19597.27, "timestamp": "05:26:37", "text": "因为手机上打开它有点小问题"}, {"type": "subtitle", "time": 19599.67, "timestamp": "05:26:39", "text": "孩子们和他们会加入的那些东西"}, {"type": "subtitle", "time": 19603.11, "timestamp": "05:26:43", "text": "你知道，就是制造骚乱。"}, {"type": "subtitle", "time": 19605.99, "timestamp": "05:26:45", "text": "这是付费的。就像……就像……"}, {"type": "subtitle", "time": 19608.47, "timestamp": "05:26:48", "text": "免费，通过一种替代游戏方式"}, {"type": "subtitle", "time": 19610.948, "timestamp": "05:26:50", "text": "也玩。所以如果你加入那个组织，就会有"}, {"type": "subtitle", "time": 19613.11, "timestamp": "05:26:53", "text": "会很多。是的。是的。我忘了"}, {"type": "subtitle", "time": 19616.47, "timestamp": "05:26:56", "text": "姓名。有很多像我这样的小孩子。"}, {"type": "subtitle", "time": 19618.628, "timestamp": "05:26:58", "text": "10岁、7岁或14岁"}]
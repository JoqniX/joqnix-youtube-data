[{"type": "subtitle", "time": 11822.309, "timestamp": "03:17:02", "text": "对，这就是……对，看看这个大家伙"}, {"type": "subtitle", "time": 11824.87, "timestamp": "03:17:04", "text": "贮存。它还没满。"}, {"type": "subtitle", "time": 11828.07, "timestamp": "03:17:08", "text": "是啊，那些玩具。这是"}, {"type": "subtitle", "time": 11831.19, "timestamp": "03:17:11", "text": "雷的汽车的辅助存储"}, {"type": "subtitle", "time": 11837.51, "timestamp": "03:17:17", "text": "我们过去常常共享彼此的资源。"}, {"type": "subtitle", "time": 11839.99, "timestamp": "03:17:19", "text": "基地仓库。"}, {"type": "subtitle", "time": 11841.63, "timestamp": "03:17:21", "text": "我的天啊。"}, {"type": "subtitle", "time": 11843.429, "timestamp": "03:17:23", "text": "[音乐]"}, {"type": "subtitle", "time": 11845.83, "timestamp": "03:17:25", "text": "尼科。"}, {"type": "subtitle", "time": 11848.79, "timestamp": "03:17:28", "text": "好的。你把这个给了她。有"}, {"type": "subtitle", "time": 11851.429, "timestamp": "03:17:31", "text": "空的。我猜她拿走了。"}, {"type": "subtitle", "time": 11856.79, "timestamp": "03:17:36", "text": "是的。我觉得她拿走了。是的。"}, {"type": "subtitle", "time": 11859.59, "timestamp": "03:17:39", "text": "不像你。"}, {"type": "subtitle", "time": 11864.309, "timestamp": "03:17:44", "text": "不，我确实拿了，我一直把它放在那里。"}, {"type": "subtitle", "time": 11866.229, "timestamp": "03:17:46", "text": "猜测"}, {"type": "subtitle", "time": 11867.83, "timestamp": "03:17:47", "text": "更多的。"}, {"type": "subtitle", "time": 11871.19, "timestamp": "03:17:51", "text": "天哪，这群无所事事的人"}]
[{"type": "subtitle", "time": 11883.59, "timestamp": "03:18:03", "text": "怀旧。"}, {"type": "subtitle", "time": 11886.55, "timestamp": "03:18:06", "text": "哦，我没有鞘翅。"}, {"type": "subtitle", "time": 11889.349, "timestamp": "03:18:09", "text": "好的。记住那座海洋纪念碑"}, {"type": "subtitle", "time": 11891.11, "timestamp": "03:18:11", "text": "我们清点完毕了吗？"}, {"type": "subtitle", "time": 11893.349, "timestamp": "03:18:13", "text": "哦是的。"}, {"type": "subtitle", "time": 11896.07, "timestamp": "03:18:16", "text": "我记得我丢失了所有东西，"}, {"type": "subtitle", "time": 11900.469, "timestamp": "03:18:20", "text": "甚至连这边的伊莱克特拉也一样。我的天啊。"}, {"type": "subtitle", "time": 11902.79, "timestamp": "03:18:22", "text": "我死于岩浆中。"}, {"type": "subtitle", "time": 11910.389, "timestamp": "03:18:30", "text": "那真是太……"}, {"type": "subtitle", "time": 11919.91, "timestamp": "03:18:39", "text": "是的。而Electra是我的f是你的"}, {"type": "subtitle", "time": 11924.229, "timestamp": "03:18:44", "text": "我想，这是别人送给我的第一份礼物吧。不，就像楼主一样。"}, {"type": "subtitle", "time": 11926.71, "timestamp": "03:18:46", "text": "礼物"}, {"type": "subtitle", "time": 11931.349, "timestamp": "03:18:51", "text": "因为我爱你，你给了我一个我喜欢的东西"}, {"type": "subtitle", "time": 11934.95, "timestamp": "03:18:54", "text": "火箭很多。很多时候是这样。我"}, {"type": "subtitle", "time": 11937.19, "timestamp": "03:18:57", "text": "我的意思是，我确实赢了。"}, {"type": "subtitle", "time": 11939.75, "timestamp": "03:18:59", "text": "是的，我打败了最终boss。是的，Ender"}]
[{"type": "subtitle", "time": 5042.55, "timestamp": "01:24:02", "text": "它甚至都没被人看到。我当时想，“等等，"}, {"type": "subtitle", "time": 5048.229, "timestamp": "01:24:08", "text": "什么鬼？那东西在哪儿？"}, {"type": "subtitle", "time": 5053.59, "timestamp": "01:24:13", "text": "我当时非常担心，你知道吗？"}, {"type": "subtitle", "time": 5056.709, "timestamp": "01:24:16", "text": "我当时就像在四处张望一样。"}, {"type": "subtitle", "time": 5060.79, "timestamp": "01:24:20", "text": "找了半天，终于找到了。哦，"}, {"type": "subtitle", "time": 5083.669, "timestamp": "01:24:43", "text": "正确的。我不得不搜索30个"}, {"type": "subtitle", "time": 5086.39, "timestamp": "01:24:46", "text": "分钟。我生完孩子后进行了搜索"}, {"type": "subtitle", "time": 5089.83, "timestamp": "01:24:49", "text": "午餐时没戴眼镜。所以我一直"}, {"type": "subtitle", "time": 5092.149, "timestamp": "01:24:52", "text": "四处张望。我找不到它。"}, {"type": "subtitle", "time": 5096.07, "timestamp": "01:24:56", "text": "我开始哭泣。我当时很担心。然后我"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "心想，嗯，我还是去看看床吧。"}]
[{"type": "subtitle", "time": 4323.51, "timestamp": "01:12:03", "text": "可以在VR上玩。老兄，VR是"}, {"type": "subtitle", "time": 4326.47, "timestamp": "01:12:06", "text": "我被俘后想做的一件事"}, {"type": "subtitle", "time": 4329.35, "timestamp": "01:12:09", "text": "卡片。"}, {"type": "subtitle", "time": 4335.75, "timestamp": "01:12:15", "text": "我不知道。谁知道呢？未来我"}, {"type": "subtitle", "time": 4338.39, "timestamp": "01:12:18", "text": "想要VR"}, {"type": "subtitle", "time": 4341.43, "timestamp": "01:12:21", "text": "但我必须工作，必须上班，必须做所有的事情。"}, {"type": "subtitle", "time": 4350.87, "timestamp": "01:12:30", "text": "嗨，Adiga，谢谢你提醒我不要……"}, {"type": "subtitle", "time": 4356.47, "timestamp": "01:12:36", "text": "安静，呃，不是保持安静，而是要说话。"}, {"type": "subtitle", "time": 4360.55, "timestamp": "01:12:40", "text": "我很感激。谢谢"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "太多了。谢谢。"}]
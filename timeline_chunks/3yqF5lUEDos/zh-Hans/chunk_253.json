[{"type": "subtitle", "time": 15181.269, "timestamp": "04:13:01", "text": "嗯，我们以后不需要这个物品了。但"}, {"type": "subtitle", "time": 15183.269, "timestamp": "04:13:03", "text": "仍然，"}, {"type": "subtitle", "time": 15193.83, "timestamp": "04:13:13", "text": "问得好。"}, {"type": "subtitle", "time": 15197.99, "timestamp": "04:13:17", "text": "我的天啊。我真的会飞上天空。"}, {"type": "subtitle", "time": 15205.269, "timestamp": "04:13:25", "text": "你上去了吗？我还在上升。但"}, {"type": "subtitle", "time": 15208.149, "timestamp": "04:13:28", "text": "实际上那里"}, {"type": "subtitle", "time": 15222.149, "timestamp": "04:13:42", "text": "雄鹿。糟糕，我没能拿到水桶。"}, {"type": "subtitle", "time": 15230.71, "timestamp": "04:13:50", "text": "它在哪里生成的？下界。呃，这"}]
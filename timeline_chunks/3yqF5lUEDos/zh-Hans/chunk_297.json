[{"type": "subtitle", "time": 17822.628, "timestamp": "04:57:02", "text": "灯光太亮了，以至于没有人回应"}, {"type": "subtitle", "time": 17832.39, "timestamp": "04:57:12", "text": "不要破坏任何已建造的方块。"}, {"type": "subtitle", "time": 17834.15, "timestamp": "04:57:14", "text": "终点和冥界。人们可能"}, {"type": "subtitle", "time": 17836.708, "timestamp": "04:57:16", "text": "摔落后因摔伤而死亡，或者"}, {"type": "subtitle", "time": 17839.11, "timestamp": "04:57:19", "text": "空白。"}, {"type": "subtitle", "time": 17841.99, "timestamp": "04:57:21", "text": "15日如果有人不加入"}, {"type": "subtitle", "time": 17843.83, "timestamp": "04:57:23", "text": "服务器在收到后 3 周内运行"}, {"type": "subtitle", "time": 17845.67, "timestamp": "04:57:25", "text": "Minecraft 在服务器中占据主导地位，他们可以"}, {"type": "subtitle", "time": 17848.07, "timestamp": "04:57:28", "text": "被取消资格。而且如果有人"}, {"type": "subtitle", "time": 17850.15, "timestamp": "04:57:30", "text": "只加入一到两次，而且不"}, {"type": "subtitle", "time": 17852.39, "timestamp": "04:57:32", "text": "几个月后他们可以再次加入。"}, {"type": "subtitle", "time": 17854.788, "timestamp": "04:57:34", "text": "也会被取消资格。你不必"}, {"type": "subtitle", "time": 17856.23, "timestamp": "04:57:36", "text": "如果你玩过三局以上，就不用担心了。"}, {"type": "subtitle", "time": 17858.31, "timestamp": "04:57:38", "text": "次数。这是为了维护玩家账户"}, {"type": "subtitle", "time": 17861.75, "timestamp": "04:57:41", "text": "小而精悍，进展顺利。"}, {"type": "subtitle", "time": 17864.07, "timestamp": "04:57:44", "text": "好吧，那条规则很好，但我们仍然"}, {"type": "subtitle", "time": 17868.15, "timestamp": "04:57:48", "text": "拥有很多 Minecraft 角色。"}, {"type": "subtitle", "time": 17869.75, "timestamp": "04:57:49", "text": "是的。"}, {"type": "subtitle", "time": 17872.47, "timestamp": "04:57:52", "text": "好了，规则就先到此为止吧。"}, {"type": "subtitle", "time": 17874.15, "timestamp": "04:57:54", "text": "我们来看看服务器的限制。"}, {"type": "subtitle", "time": 17876.788, "timestamp": "04:57:56", "text": "业主。好的，我的限制。射线。哦"}]
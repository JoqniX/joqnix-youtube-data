[{"type": "subtitle", "time": 8532.389, "timestamp": "02:22:12", "text": "别笑。哦，我"}, {"type": "subtitle", "time": 8535.03, "timestamp": "02:22:15", "text": "做它。"}, {"type": "subtitle", "time": 8537.27, "timestamp": "02:22:17", "text": "你不应该直播超过……"}, {"type": "subtitle", "time": 8539.83, "timestamp": "02:22:19", "text": "想。"}, {"type": "subtitle", "time": 8545.03, "timestamp": "02:22:25", "text": "所以，是的，我讨厌改变。"}, {"type": "subtitle", "time": 8547.03, "timestamp": "02:22:27", "text": "好吧，行。"}, {"type": "subtitle", "time": 8553.75, "timestamp": "02:22:33", "text": "我一直在想我是不是直播太多了。"}, {"type": "subtitle", "time": 8556.63, "timestamp": "02:22:36", "text": "浪费时间。我其实想放"}, {"type": "subtitle", "time": 8560.15, "timestamp": "02:22:40", "text": "我投入时间做东西"}, {"type": "subtitle", "time": 8563.75, "timestamp": "02:22:43", "text": "用于直播或其他用途。"}, {"type": "subtitle", "time": 8568.55, "timestamp": "02:22:48", "text": "但是，奥卡，我会接受你的……"}, {"type": "subtitle", "time": 8571.429, "timestamp": "02:22:51", "text": "建议"}, {"type": "subtitle", "time": 8574.23, "timestamp": "02:22:54", "text": "呃，还有"}, {"type": "subtitle", "time": 8577.75, "timestamp": "02:22:57", "text": "去做。嗨，就说这么多吧"}]
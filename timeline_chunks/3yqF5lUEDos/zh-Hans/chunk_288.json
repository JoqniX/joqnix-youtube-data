[{"type": "subtitle", "time": 17280.55, "timestamp": "04:48:00", "text": "前克里萨团队。所以，是的，就像我当时那样"}, {"type": "subtitle", "time": 17285.11, "timestamp": "04:48:05", "text": "直接前往了他们的基地。"}, {"type": "subtitle", "time": 17288.868, "timestamp": "04:48:08", "text": "是的，正式的我们的基地"}, {"type": "subtitle", "time": 17292.15, "timestamp": "04:48:12", "text": "就像去拜访了一下，你知道，去了一趟"}, {"type": "subtitle", "time": 17294.628, "timestamp": "04:48:14", "text": "去参观了一下，就看到了他们的项目。"}, {"type": "subtitle", "time": 17297.51, "timestamp": "04:48:17", "text": "正在努力。所以他们实际上并没有"}, {"type": "subtitle", "time": 17300.07, "timestamp": "04:48:20", "text": "想给我展示大约一半的内容"}, {"type": "subtitle", "time": 17304.15, "timestamp": "04:48:24", "text": "他们。我觉得你们中没有人像我一样。"}, {"type": "subtitle", "time": 17306.39, "timestamp": "04:48:26", "text": "前成员。"}, {"type": "subtitle", "time": 17309.43, "timestamp": "04:48:29", "text": "是的，前成员，不过他确实还在。"}, {"type": "subtitle", "time": 17311.43, "timestamp": "04:48:31", "text": "是不是签了保密协议之类的？"}, {"type": "subtitle", "time": 17313.11, "timestamp": "04:48:33", "text": "某物？"}, {"type": "subtitle", "time": 17315.75, "timestamp": "04:48:35", "text": "你必须签字，我是创始人之一。"}, {"type": "subtitle", "time": 17318.788, "timestamp": "04:48:38", "text": "保密协议呢？嗯？是的，你就是"}, {"type": "subtitle", "time": 17321.75, "timestamp": "04:48:41", "text": "创始人。他们会怎么对待你？"}, {"type": "subtitle", "time": 17326.15, "timestamp": "04:48:46", "text": "现在是这样吗？是的。或者像上面说的三个。"}, {"type": "subtitle", "time": 17329.67, "timestamp": "04:48:49", "text": "她就像他决定的那样，永远不会。"}, {"type": "subtitle", "time": 17332.55, "timestamp": "04:48:52", "text": "是的。她就像你知道的，督察"}, {"type": "subtitle", "time": 17335.51, "timestamp": "04:48:55", "text": "项目检查员像她一样确认是否"}, {"type": "subtitle", "time": 17339.27, "timestamp": "04:48:59", "text": "一切都还好。哦"}]
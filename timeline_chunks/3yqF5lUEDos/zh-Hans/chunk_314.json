[{"type": "subtitle", "time": 18843.59, "timestamp": "05:14:03", "text": "是不是动漫看多了？"}, {"type": "subtitle", "time": 18845.91, "timestamp": "05:14:05", "text": "因为当你看了很多动漫之后，"}, {"type": "subtitle", "time": 18848.628, "timestamp": "05:14:08", "text": "对，你知道这个角色或"}, {"type": "subtitle", "time": 18852.15, "timestamp": "05:14:12", "text": "那个人用日语说："}, {"type": "subtitle", "time": 18854.23, "timestamp": "05:14:14", "text": "正确的？如果是其他什么东西呢？"}, {"type": "subtitle", "time": 18859.99, "timestamp": "05:14:19", "text": "但如果是其他一些情况呢？"}, {"type": "subtitle", "time": 18863.27, "timestamp": "05:14:23", "text": "语言权利，没有媒介，没有"}, {"type": "subtitle", "time": 18865.91, "timestamp": "05:14:25", "text": "媒体之类的东西，比如哪个"}, {"type": "subtitle", "time": 18868.39, "timestamp": "05:14:28", "text": "你不太关注观看"}, {"type": "subtitle", "time": 18872.868, "timestamp": "05:14:32", "text": "例如，我认为，呃，我认为，呃，那些人"}, {"type": "subtitle", "time": 18874.868, "timestamp": "05:14:34", "text": "我觉得我现在迷上了K-pop之类的东西。"}, {"type": "subtitle", "time": 18877.51, "timestamp": "05:14:37", "text": "他们经常观看和收听韩国流行音乐。"}, {"type": "subtitle", "time": 18880.788, "timestamp": "05:14:40", "text": "歌曲方面，从某种程度上来说，他们很擅长韩语。"}, {"type": "subtitle", "time": 18884.788, "timestamp": "05:14:44", "text": "我想大概就是这样吧。"}, {"type": "subtitle", "time": 18887.51, "timestamp": "05:14:47", "text": "但对我来说，我正在尝试看中文片。"}, {"type": "subtitle", "time": 18889.67, "timestamp": "05:14:49", "text": "就像比利·布里什的画框一样"}, {"type": "subtitle", "time": 18891.99, "timestamp": "05:14:51", "text": "一切。我还是不明白"}, {"type": "subtitle", "time": 18898.39, "timestamp": "05:14:58", "text": "我试着跟着中文一起唱歌。"}]
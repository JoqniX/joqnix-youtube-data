[{"type": "subtitle", "time": 15.749, "timestamp": "00:00:15", "text": "什么流？等等，祖琪在这里吗？我想"}, {"type": "subtitle", "time": 18.95, "timestamp": "00:00:18", "text": "祖基会来这里。我希望她成为我们的"}, {"type": "subtitle", "time": 21.75, "timestamp": "00:00:21", "text": "帮手。"}, {"type": "subtitle", "time": 24.07, "timestamp": "00:00:24", "text": "你说的那个方法行不通。疼痛"}, {"type": "subtitle", "time": 39.91, "timestamp": "00:00:39", "text": "等待。"}, {"type": "subtitle", "time": 42.549, "timestamp": "00:00:42", "text": "所以，呃，女士，如果您看到祖基，她……"}, {"type": "subtitle", "time": 45.67, "timestamp": "00:00:45", "text": "不久前在这里。是的，我迟到了。"}, {"type": "subtitle", "time": 49.19, "timestamp": "00:00:49", "text": "回复她的信息。我看到了私信。"}, {"type": "subtitle", "time": 57.35, "timestamp": "00:00:57", "text": "我想帮助这个笨蛋。"}]
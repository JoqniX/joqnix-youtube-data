[{"type": "subtitle", "time": 19686.39, "timestamp": "05:28:06", "text": "我的天啊。"}, {"type": "subtitle", "time": 19688.628, "timestamp": "05:28:08", "text": "走吧。"}, {"type": "subtitle", "time": 19696.708, "timestamp": "05:28:16", "text": "这让我想起了那段时间，当时我……"}, {"type": "subtitle", "time": 19699.91, "timestamp": "05:28:19", "text": "比如在我的主账号里进行合作或其他什么活动"}, {"type": "subtitle", "time": 19702.708, "timestamp": "05:28:22", "text": "像这样的账户在风险投资或汽车中以及我的"}, {"type": "subtitle", "time": 19705.03, "timestamp": "05:28:25", "text": "我用小号登录了其他服务器"}, {"type": "subtitle", "time": 19708.628, "timestamp": "05:28:28", "text": "VC在静音状态下打招呼。"}, {"type": "subtitle", "time": 19710.39, "timestamp": "05:28:30", "text": "好的，"}, {"type": "subtitle", "time": 19713.03, "timestamp": "05:28:33", "text": "脚踏两只船。双重目的。我也有点"}, {"type": "subtitle", "time": 19727.91, "timestamp": "05:28:47", "text": "你看，我们现在有更多能同时处理多项任务的人了。"}, {"type": "subtitle", "time": 19731.11, "timestamp": "05:28:51", "text": "我们需要更多这样的人。"}, {"type": "subtitle", "time": 19733.51, "timestamp": "05:28:53", "text": "更多像我一样的人。"}, {"type": "subtitle", "time": 19735.99, "timestamp": "05:28:55", "text": "有计数吗？"}, {"type": "subtitle", "time": 19739.75, "timestamp": "05:28:59", "text": "是的。哦，是的。是的。她也是一位多才多艺的人。"}]
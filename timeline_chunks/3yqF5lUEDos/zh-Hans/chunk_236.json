[{"type": "subtitle", "time": 14161.51, "timestamp": "03:56:01", "text": "那里"}, {"type": "subtitle", "time": 14164.71, "timestamp": "03:56:04", "text": "他就像我离开的时候那样。"}, {"type": "subtitle", "time": 14167.269, "timestamp": "03:56:07", "text": "不会是新星人。会有一个死者"}, {"type": "subtitle", "time": 14177.59, "timestamp": "03:56:17", "text": "“嘿，"}, {"type": "subtitle", "time": 14185.349, "timestamp": "03:56:25", "text": "因此，从那时起，你就一直……"}, {"type": "subtitle", "time": 14188.55, "timestamp": "03:56:28", "text": "这里只有三只猫。那是"}, {"type": "subtitle", "time": 14191.11, "timestamp": "03:56:31", "text": "这三个人。"}, {"type": "subtitle", "time": 14200.15, "timestamp": "03:56:40", "text": "怀旧"}, {"type": "subtitle", "time": 14203.189, "timestamp": "03:56:43", "text": "那个人。还有这些"}, {"type": "subtitle", "time": 14205.429, "timestamp": "03:56:45", "text": "三只猫"}, {"type": "subtitle", "time": 14207.67, "timestamp": "03:56:47", "text": "对某些人来说，他们有四个。哦，我的"}, {"type": "subtitle", "time": 14210.95, "timestamp": "03:56:50", "text": "上帝。他们来自哪里？"}]
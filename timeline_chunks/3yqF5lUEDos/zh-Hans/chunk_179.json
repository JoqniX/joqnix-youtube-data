[{"type": "subtitle", "time": 10740.95, "timestamp": "02:59:00", "text": "是的，"}, {"type": "subtitle", "time": 10744.15, "timestamp": "02:59:04", "text": "我们来做一个木制的吧。"}, {"type": "subtitle", "time": 10748.71, "timestamp": "02:59:08", "text": "或者别的什么。哦，我们这里有铁。"}, {"type": "subtitle", "time": 10751.91, "timestamp": "02:59:11", "text": "或许我们确实如此。哦，这个中间房间是……"}, {"type": "subtitle", "time": 10758.71, "timestamp": "02:59:18", "text": "我的天啊。"}, {"type": "subtitle", "time": 10762.469, "timestamp": "02:59:22", "text": "我应该带上背包的。哦，我"}, {"type": "subtitle", "time": 10764.469, "timestamp": "02:59:24", "text": "意思是它现在就在附近。我们可以直接获得"}, {"type": "subtitle", "time": 10777.03, "timestamp": "02:59:37", "text": "好的，慢慢来。过来。在哪里"}, {"type": "subtitle", "time": 10782.389, "timestamp": "02:59:42", "text": "你去了吗？我上去拿水晶"}, {"type": "subtitle", "time": 10784.71, "timestamp": "02:59:44", "text": "镐。"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "呃，等等。这是哪里？等等，是"}, {"type": "subtitle", "time": 10789.99, "timestamp": "02:59:49", "text": "我们身处同一地点吗？等等，等等，等等。"}, {"type": "subtitle", "time": 10795.59, "timestamp": "02:59:55", "text": "耽误。这看起来不一样"}, {"type": "subtitle", "time": 10799.03, "timestamp": "02:59:59", "text": "我在聊天室里看到一个新人，但是"}]
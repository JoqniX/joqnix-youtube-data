[{"type": "subtitle", "time": 18122.788, "timestamp": "05:02:02", "text": "原神？我是说，我昨天做了。"}, {"type": "subtitle", "time": 18124.788, "timestamp": "05:02:04", "text": "它怎么样？"}, {"type": "subtitle", "time": 18127.99, "timestamp": "05:02:07", "text": "呃，方丹。游泳真是一件很有趣的事。"}, {"type": "subtitle", "time": 18129.59, "timestamp": "05:02:09", "text": "大约。"}, {"type": "subtitle", "time": 18131.99, "timestamp": "05:02:11", "text": "是的。"}, {"type": "subtitle", "time": 18135.19, "timestamp": "05:02:15", "text": "非常感谢。"}, {"type": "subtitle", "time": 18137.35, "timestamp": "05:02:17", "text": "进而"}, {"type": "subtitle", "time": 18140.708, "timestamp": "05:02:20", "text": "然后我觉得最引人注目的是，是的，我"}, {"type": "subtitle", "time": 18145.83, "timestamp": "05:02:25", "text": "还没有像现在这样扮演艺术演员。所以"}, {"type": "subtitle", "time": 18149.99, "timestamp": "05:02:29", "text": "我刚刚做了一些拼图。我确实找到了一个"}, {"type": "subtitle", "time": 18153.59, "timestamp": "05:02:33", "text": "有些小谜题很难，比如……"}, {"type": "subtitle", "time": 18157.11, "timestamp": "05:02:37", "text": "你知道，将水力应用于"}, {"type": "subtitle", "time": 18161.83, "timestamp": "05:02:41", "text": "同时处理两个元素并保持平衡"}, {"type": "subtitle", "time": 18164.708, "timestamp": "05:02:44", "text": "就像沿着……走了几秒钟"}, {"type": "subtitle", "time": 18168.39, "timestamp": "05:02:48", "text": "他们。这很难。我们会找到的。"}, {"type": "subtitle", "time": 18171.11, "timestamp": "05:02:51", "text": "我还没完成，所以我必须……"}, {"type": "subtitle", "time": 18174.07, "timestamp": "05:02:54", "text": "速通。我已经厌倦了夏天的阿隆"}, {"type": "subtitle", "time": 18176.948, "timestamp": "05:02:56", "text": "任务，但我还有一些世界任务"}]
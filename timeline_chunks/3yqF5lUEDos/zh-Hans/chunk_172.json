[{"type": "subtitle", "time": 10322.23, "timestamp": "02:52:02", "text": "感谢上帝，我没有死。我思考了一下"}, {"type": "subtitle", "time": 10324.55, "timestamp": "02:52:04", "text": "其次，我会死。"}, {"type": "subtitle", "time": 10326.87, "timestamp": "02:52:06", "text": "幸好我没有。"}, {"type": "subtitle", "time": 10329.11, "timestamp": "02:52:09", "text": "我正在下来。"}, {"type": "subtitle", "time": 10336.07, "timestamp": "02:52:16", "text": "我会在这里。职业小子怎么会来？哦，"}, {"type": "subtitle", "time": 10340.389, "timestamp": "02:52:20", "text": "我来到了塔楼入口处。"}, {"type": "subtitle", "time": 10342.55, "timestamp": "02:52:22", "text": "我看见你。"}, {"type": "subtitle", "time": 10345.59, "timestamp": "02:52:25", "text": "哦，等等。哦，你没有掉进……"}, {"type": "subtitle", "time": 10347.51, "timestamp": "02:52:27", "text": "水。"}, {"type": "subtitle", "time": 10365.67, "timestamp": "02:52:45", "text": "这是我做的第一件事"}, {"type": "subtitle", "time": 10368.63, "timestamp": "02:52:48", "text": "服务器在我家前面。"}, {"type": "subtitle", "time": 10375.19, "timestamp": "02:52:55", "text": "是的。我们上去吧。"}]
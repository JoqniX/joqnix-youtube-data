[{"type": "subtitle", "time": 12601.75, "timestamp": "03:30:01", "text": "我的天哪。是的。"}, {"type": "subtitle", "time": 12603.91, "timestamp": "03:30:03", "text": "等等，等等，你回去了吗？我是"}, {"type": "subtitle", "time": 12613.67, "timestamp": "03:30:13", "text": "我还要等吗？"}, {"type": "subtitle", "time": 12617.19, "timestamp": "03:30:17", "text": "如何取消？是的。看？是的。"}, {"type": "subtitle", "time": 12621.19, "timestamp": "03:30:21", "text": "是的。看？是的。逃脱。退出键。"}, {"type": "subtitle", "time": 12623.67, "timestamp": "03:30:23", "text": "对不起。你设置了重生点吗？你"}, {"type": "subtitle", "time": 12627.51, "timestamp": "03:30:27", "text": "没有。是的，我在我的基地做了。在您的"}, {"type": "subtitle", "time": 12630.07, "timestamp": "03:30:30", "text": "根据？我以为你做到了。我会回来的。"}, {"type": "subtitle", "time": 12632.309, "timestamp": "03:30:32", "text": "我的意思是，我没有，我没有在你那里做这件事。"}, {"type": "subtitle", "time": 12635.11, "timestamp": "03:30:35", "text": "根据。就像你睡着了一样。我以为我是"}, {"type": "subtitle", "time": 12639.11, "timestamp": "03:30:39", "text": "我睡着了，但我没睡。我的重生"}, {"type": "subtitle", "time": 12643.269, "timestamp": "03:30:43", "text": "重点是在我家。好的，我来了"}, {"type": "subtitle", "time": 12646.71, "timestamp": "03:30:46", "text": "来接你。我回来了。我 我"}, {"type": "subtitle", "time": 12653.11, "timestamp": "03:30:53", "text": "你跑步的方式是什么？双击不起作用。"}, {"type": "subtitle", "time": 12656.79, "timestamp": "03:30:56", "text": "哦，它奏效了。好的。你是怎么跑的"}, {"type": "subtitle", "time": 12659.349, "timestamp": "03:30:59", "text": "伸手过来？哇，"}]
[{"type": "subtitle", "time": 19320.948, "timestamp": "05:22:00", "text": "过了一段时间后，怎么说？"}, {"type": "subtitle", "time": 19323.11, "timestamp": "05:22:03", "text": "日本人？"}, {"type": "subtitle", "time": 19329.75, "timestamp": "05:22:09", "text": "[音乐]"}, {"type": "subtitle", "time": 19359.43, "timestamp": "05:22:39", "text": "就像这种神奇的……这种神奇的"}, {"type": "subtitle", "time": 19361.75, "timestamp": "05:22:41", "text": "感觉自己好像不懂日语"}, {"type": "subtitle", "time": 19363.59, "timestamp": "05:22:43", "text": "当你开始和……说话时，到处都找不到"}, {"type": "subtitle", "time": 19366.628, "timestamp": "05:22:46", "text": "日语课大概一两个小时。"}, {"type": "subtitle", "time": 19372.15, "timestamp": "05:22:52", "text": "我当时就想，“啊？”"}]
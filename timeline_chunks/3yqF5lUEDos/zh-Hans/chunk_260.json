[{"type": "subtitle", "time": 15602.229, "timestamp": "04:20:02", "text": "找到我们之后，感觉棒极了"}, {"type": "subtitle", "time": 15605.91, "timestamp": "04:20:05", "text": "我们带着火箭和电子来到这里。"}, {"type": "subtitle", "time": 15608.149, "timestamp": "04:20:08", "text": "是的。当 Isuk Isuki 正在工作时"}, {"type": "subtitle", "time": 15610.149, "timestamp": "04:20:10", "text": "农场"}, {"type": "subtitle", "time": 15612.71, "timestamp": "04:20:12", "text": "在我的基地，我当时想，我们俩都是"}, {"type": "subtitle", "time": 15616.79, "timestamp": "04:20:16", "text": "来到这里冒险，战斗"}, {"type": "subtitle", "time": 15625.03, "timestamp": "04:20:25", "text": "就在这里。"}, {"type": "subtitle", "time": 15627.349, "timestamp": "04:20:27", "text": "哦，是的。是的。我们当时说我们是"}, {"type": "subtitle", "time": 15630.71, "timestamp": "04:20:30", "text": "从某个地方弄到这本书。"}, {"type": "subtitle", "time": 15633.67, "timestamp": "04:20:33", "text": "是的。这个区域。"}, {"type": "subtitle", "time": 15635.91, "timestamp": "04:20:35", "text": "我刚刚把门弄坏了。好的，"}, {"type": "subtitle", "time": 15650.87, "timestamp": "04:20:50", "text": "[音乐]"}, {"type": "subtitle", "time": 15653.429, "timestamp": "04:20:53", "text": "那里有一座隐蔽的豪宅。我"}]
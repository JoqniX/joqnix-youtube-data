[{"type": "subtitle", "time": 11400.15, "timestamp": "03:10:00", "text": "是的。等待。嗯，这是……是的。这"}, {"type": "subtitle", "time": 11407.99, "timestamp": "03:10:07", "text": "哦，是的。这个。"}, {"type": "subtitle", "time": 11411.83, "timestamp": "03:10:11", "text": "是的。里面有只猫。是的。"}, {"type": "subtitle", "time": 11414.55, "timestamp": "03:10:14", "text": "其他类型的石头。什么也没有。这"}, {"type": "subtitle", "time": 11417.19, "timestamp": "03:10:17", "text": "是一块石头。打开。待拆的礼物。是的。"}, {"type": "subtitle", "time": 11420.309, "timestamp": "03:10:20", "text": "那天是我生日。祖基。祖基。它"}, {"type": "subtitle", "time": 11422.55, "timestamp": "03:10:22", "text": "什么都没拿。"}, {"type": "subtitle", "time": 11426.71, "timestamp": "03:10:26", "text": "把这本书读完。我的天哪。"}, {"type": "subtitle", "time": 11430.63, "timestamp": "03:10:30", "text": "等待。不，不。她种了很多地。"}, {"type": "subtitle", "time": 11432.309, "timestamp": "03:10:32", "text": "啊，"}, {"type": "subtitle", "time": 11435.91, "timestamp": "03:10:35", "text": "这个。我的天哪。我应该读吗？"}, {"type": "subtitle", "time": 11437.67, "timestamp": "03:10:37", "text": "它？"}, {"type": "subtitle", "time": 11439.99, "timestamp": "03:10:39", "text": "Reddit。"}, {"type": "subtitle", "time": 11443.99, "timestamp": "03:10:43", "text": "我的天啊。你好。这不是一封信。"}, {"type": "subtitle", "time": 11445.59, "timestamp": "03:10:45", "text": "与上次类似。相反，"}, {"type": "subtitle", "time": 11448.71, "timestamp": "03:10:48", "text": "以表谢意。感谢你的支持。"}, {"type": "subtitle", "time": 11450.87, "timestamp": "03:10:50", "text": "基地伙伴。即使我不能玩很多游戏"}, {"type": "subtitle", "time": 11452.87, "timestamp": "03:10:52", "text": "以后再也不跟你一起玩游戏了，我真的很喜欢"}, {"type": "subtitle", "time": 11455.75, "timestamp": "03:10:55", "text": "和你一起玩我的世界。"}, {"type": "subtitle", "time": 11458.07, "timestamp": "03:10:58", "text": "我不会玩原神，也帮不上你什么忙。"}]
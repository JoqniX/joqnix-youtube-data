[{"type": "subtitle", "time": 20281.11, "timestamp": "05:38:01", "text": "今天。今天带来的是面包。"}, {"type": "subtitle", "time": 20285.43, "timestamp": "05:38:05", "text": "谢谢光临。甲板"}, {"type": "subtitle", "time": 20287.59, "timestamp": "05:38:07", "text": "国王驾到。希望你喜欢"}, {"type": "subtitle", "time": 20291.03, "timestamp": "05:38:11", "text": "今天。谢谢。那么，专业版就是一个新的"}, {"type": "subtitle", "time": 20293.83, "timestamp": "05:38:13", "text": "这里有人。欢迎加入 Nonxia 大家庭。"}, {"type": "subtitle", "time": 20295.91, "timestamp": "05:38:15", "text": "感谢您找到我的直播间。希望"}, {"type": "subtitle", "time": 20299.67, "timestamp": "05:38:19", "text": "你今天过得很开心。谢谢。"}, {"type": "subtitle", "time": 20303.03, "timestamp": "05:38:23", "text": "今天哈马来了。 H 代表前来拜访"}, {"type": "subtitle", "time": 20309.19, "timestamp": "05:38:29", "text": "今天太阳剑也来了。"}, {"type": "subtitle", "time": 20312.23, "timestamp": "05:38:32", "text": "感谢您今天光临。谢谢。然后是人"}, {"type": "subtitle", "time": 20315.19, "timestamp": "05:38:35", "text": "儿子今天来了，沙也来了。"}, {"type": "subtitle", "time": 20318.23, "timestamp": "05:38:38", "text": "今天之前。 Miku Chama 也来了。我"}, {"type": "subtitle", "time": 20319.99, "timestamp": "05:38:39", "text": "好久没见到初音未来了。感谢"}, {"type": "subtitle", "time": 20322.31, "timestamp": "05:38:42", "text": "谢谢你，Miku，能来一趟。我不知道"}, {"type": "subtitle", "time": 20325.35, "timestamp": "05:38:45", "text": "我们刚才还在聊扎基呢。呃"}, {"type": "subtitle", "time": 20328.07, "timestamp": "05:38:48", "text": "我和阿里斯·查马当时正在谈论……"}, {"type": "subtitle", "time": 20331.59, "timestamp": "05:38:51", "text": "我们三人一起度过的那些令人怀念的时光"}, {"type": "subtitle", "time": 20333.91, "timestamp": "05:38:53", "text": "Chrissa 服务器上的服务器。然后"}, {"type": "subtitle", "time": 20336.39, "timestamp": "05:38:56", "text": "我们竟然凭空出现了"}, {"type": "subtitle", "time": 20338.39, "timestamp": "05:38:58", "text": "初音未来。"}]
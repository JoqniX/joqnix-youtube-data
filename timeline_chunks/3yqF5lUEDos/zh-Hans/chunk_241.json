[{"type": "subtitle", "time": 14469.99, "timestamp": "04:01:09", "text": "好的，我们下去吧。或者，或者我们不妨这样说"}, {"type": "subtitle", "time": 14476.63, "timestamp": "04:01:16", "text": "[音乐]"}, {"type": "subtitle", "time": 14479.67, "timestamp": "04:01:19", "text": "等等，已经结束了。"}, {"type": "subtitle", "time": 14481.99, "timestamp": "04:01:21", "text": "哦，你还记得？哦，是的。是的。是的。"}, {"type": "subtitle", "time": 14484.55, "timestamp": "04:01:24", "text": "基岩所在的地方。是的。是的。"}, {"type": "subtitle", "time": 14489.11, "timestamp": "04:01:29", "text": "是的。在这里吗？你还记得这件事吗？"}, {"type": "subtitle", "time": 14491.03, "timestamp": "04:01:31", "text": "事物？我不知道是不是你。"}, {"type": "subtitle", "time": 14494.389, "timestamp": "04:01:34", "text": "是谁把他们弄到这里来的？"}, {"type": "subtitle", "time": 14501.03, "timestamp": "04:01:41", "text": "哦，对了，是马。我的天啊。我只是"}, {"type": "subtitle", "time": 14504.469, "timestamp": "04:01:44", "text": "希望他们还在。回忆。哦，我的"}, {"type": "subtitle", "time": 14507.91, "timestamp": "04:01:47", "text": "上帝。想走这条路吗？是的。"}, {"type": "subtitle", "time": 14510.229, "timestamp": "04:01:50", "text": "这个。"}, {"type": "subtitle", "time": 14518.07, "timestamp": "04:01:58", "text": "该部分。我的天哪，我记得这件事。"}]
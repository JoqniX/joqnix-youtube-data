[{"type": "subtitle", "time": 1021.43, "timestamp": "00:17:01", "text": "我们走吧"}, {"type": "subtitle", "time": 1023.67, "timestamp": "00:17:03", "text": "超过。"}, {"type": "subtitle", "time": 1026.47, "timestamp": "00:17:06", "text": "我们要追捕他们。高达坠落"}, {"type": "subtitle", "time": 1029.11, "timestamp": "00:17:09", "text": "那里。我们要砰砰砰地打尼亚苏"}, {"type": "subtitle", "time": 1032.39, "timestamp": "00:17:12", "text": "将它们从这张地图中移除。我们要去玩游戏。"}, {"type": "subtitle", "time": 1033.99, "timestamp": "00:17:13", "text": "哦，对了，这将是"}, {"type": "subtitle", "time": 1037.59, "timestamp": "00:17:17", "text": "坚持到中午12点。是的，我"}, {"type": "subtitle", "time": 1039.51, "timestamp": "00:17:19", "text": "忘了提一下，直播将会"}, {"type": "subtitle", "time": 1041.59, "timestamp": "00:17:21", "text": "坚持和毅力，因为我爱这一切"}, {"type": "subtitle", "time": 1044.87, "timestamp": "00:17:24", "text": "游戏。我想在战场上开枪扫射。你"}, {"type": "subtitle", "time": 1048.23, "timestamp": "00:17:28", "text": "要知道，在现代实际战争中，它"}, {"type": "subtitle", "time": 1052.07, "timestamp": "00:17:32", "text": "需要三到四天，对吧？在"}, {"type": "subtitle", "time": 1055.27, "timestamp": "00:17:35", "text": "真正的战争。"}, {"type": "subtitle", "time": 1058.39, "timestamp": "00:17:38", "text": "是的，我会在这里。所以"}, {"type": "subtitle", "time": 1061.83, "timestamp": "00:17:41", "text": "欢迎随时过来找我。好的，"}, {"type": "subtitle", "time": 1064.39, "timestamp": "00:17:44", "text": "打个招呼。"}, {"type": "subtitle", "time": 1066.39, "timestamp": "00:17:46", "text": "我会的，但我得走了，再见。"}, {"type": "subtitle", "time": 1069.75, "timestamp": "00:17:49", "text": "过一会儿。还有 metak。"}, {"type": "subtitle", "time": 1074.31, "timestamp": "00:17:54", "text": "是的，就是这样。那首歌真好听"}]
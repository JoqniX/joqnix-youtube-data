[{"type": "subtitle", "time": 20460.47, "timestamp": "05:41:00", "text": "已经解释过了，但有点……"}, {"type": "subtitle", "time": 20463.59, "timestamp": "05:41:03", "text": "你们都是罗伯特·杰克逊，这很独特。"}, {"type": "subtitle", "time": 20467.67, "timestamp": "05:41:07", "text": "查玛用它，因为呃，它实际上是朝觐"}, {"type": "subtitle", "time": 20470.23, "timestamp": "05:41:10", "text": "实际上，这是早晨的问候语。"}, {"type": "subtitle", "time": 20472.23, "timestamp": "05:41:12", "text": "矿。"}, {"type": "subtitle", "time": 20476.07, "timestamp": "05:41:16", "text": "所以无论你去哪里，如果我曾经"}, {"type": "subtitle", "time": 20480.07, "timestamp": "05:41:20", "text": "有没有见过《哦，乔》这首歌，是任何人写的？我会"}, {"type": "subtitle", "time": 20481.83, "timestamp": "05:41:21", "text": "立刻就知道，哦，对，那就是"}, {"type": "subtitle", "time": 20484.47, "timestamp": "05:41:24", "text": "罗伯特·杰克逊。唯一一个这样做的人"}, {"type": "subtitle", "time": 20487.51, "timestamp": "05:41:27", "text": "那是罗伯特·肯"}, {"type": "subtitle", "time": 20489.51, "timestamp": "05:41:29", "text": "因为我心里已经"}, {"type": "subtitle", "time": 20491.59, "timestamp": "05:41:31", "text": "深深地印刻着只有一个人的观念"}, {"type": "subtitle", "time": 20496.47, "timestamp": "05:41:36", "text": "谁会在不是俄亥俄州的时候用“哦，乔克”这种说法？"}, {"type": "subtitle", "time": 20498.548, "timestamp": "05:41:38", "text": "不是早上，那是罗伯特·杰克逊"}, {"type": "subtitle", "time": 20500.15, "timestamp": "05:41:40", "text": "行动。"}, {"type": "subtitle", "time": 20502.788, "timestamp": "05:41:42", "text": "哦，是的。谢谢光临。希望"}, {"type": "subtitle", "time": 20511.91, "timestamp": "05:41:51", "text": "祝你手术一切顺利。我"}, {"type": "subtitle", "time": 20514.15, "timestamp": "05:41:54", "text": "我知道它被推迟了之类的，还有你"}, {"type": "subtitle", "time": 20516.548, "timestamp": "05:41:56", "text": "今天直播了。我在看你"}, {"type": "subtitle", "time": 20519.35, "timestamp": "05:41:59", "text": "直播的时候我正在参加我的"}]
[{"type": "subtitle", "time": 4502.63, "timestamp": "01:15:02", "text": "我需要疗伤。"}, {"type": "subtitle", "time": 4512.87, "timestamp": "01:15:12", "text": "哦，那边人太多了。"}, {"type": "subtitle", "time": 4515.51, "timestamp": "01:15:15", "text": "运动健将多久？哦，这将持续到"}, {"type": "subtitle", "time": 4519.11, "timestamp": "01:15:19", "text": "12晚。我和他一起吃了午饭、晚饭。"}, {"type": "subtitle", "time": 4521.189, "timestamp": "01:15:21", "text": "知道。我的意思是，我不……我的意思是，我不"}, {"type": "subtitle", "time": 4525.11, "timestamp": "01:15:25", "text": "除了看视频之外，还能做些什么？"}, {"type": "subtitle", "time": 4527.83, "timestamp": "01:15:27", "text": "尽管有很多事情要做，"}, {"type": "subtitle", "time": 4542.149, "timestamp": "01:15:42", "text": "所以这就是我开通推特账号的原因。"}, {"type": "subtitle", "time": 4543.91, "timestamp": "01:15:43", "text": "轮询。"}, {"type": "subtitle", "time": 4547.83, "timestamp": "01:15:47", "text": "你们想要吗？"}, {"type": "subtitle", "time": 4550.55, "timestamp": "01:15:50", "text": "你们想要更长的直播时间吗？"}, {"type": "subtitle", "time": 4553.83, "timestamp": "01:15:53", "text": "你能接受更长的直播时间吗？"}, {"type": "subtitle", "time": 4557.189, "timestamp": "01:15:57", "text": "如果你提出任何要求呢？"}]
[{"type": "subtitle", "time": 12482.229, "timestamp": "03:28:02", "text": "我记得我好像达到了100分左右。"}, {"type": "subtitle", "time": 12485.349, "timestamp": "03:28:05", "text": "有100个吗？我觉得做完那件事之后，我"}, {"type": "subtitle", "time": 12489.19, "timestamp": "03:28:09", "text": "被封禁了。我不认为我封禁了你。"}, {"type": "subtitle", "time": 12496.95, "timestamp": "03:28:16", "text": "是的，你不需要。好了，我们走吧。"}, {"type": "subtitle", "time": 12498.469, "timestamp": "03:28:18", "text": "我们不需要等级制度。"}, {"type": "subtitle", "time": 12507.429, "timestamp": "03:28:27", "text": "还有什么呢？我忘了什么"}, {"type": "subtitle", "time": 12511.03, "timestamp": "03:28:31", "text": "否则我们还能完成结尾吗？呃，然后你就这么做了"}, {"type": "subtitle", "time": 12513.99, "timestamp": "03:28:33", "text": "节日筹备工作。"}, {"type": "subtitle", "time": 12518.79, "timestamp": "03:28:38", "text": "嗯，然后呢？"}, {"type": "subtitle", "time": 12523.51, "timestamp": "03:28:43", "text": "欢迎 Miku。什么鬼？"}, {"type": "subtitle", "time": 12525.83, "timestamp": "03:28:45", "text": "就像服务器上的最后一个事件一样……"}, {"type": "subtitle", "time": 12530.309, "timestamp": "03:28:50", "text": "节日。上次活动我仍然"}, {"type": "subtitle", "time": 12533.349, "timestamp": "03:28:53", "text": "记住这条溪流。我的天啊。哪个"}, {"type": "subtitle", "time": 12535.429, "timestamp": "03:28:55", "text": "一？"}, {"type": "subtitle", "time": 12537.91, "timestamp": "03:28:57", "text": "我们俩都看了《等等，我不知道》的直播"}]
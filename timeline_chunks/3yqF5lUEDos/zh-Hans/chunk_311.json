[{"type": "subtitle", "time": 18661.51, "timestamp": "05:11:01", "text": "功能类似于……呃，比如……忽略"}, {"type": "subtitle", "time": 18664.55, "timestamp": "05:11:04", "text": "过滤装置。"}, {"type": "subtitle", "time": 18666.868, "timestamp": "05:11:06", "text": "是的，他们只有一种过滤器。"}, {"type": "subtitle", "time": 18670.708, "timestamp": "05:11:10", "text": "试玩游戏和试用版之类的东西。他们"}, {"type": "subtitle", "time": 18673.51, "timestamp": "05:11:13", "text": "没有针对特定类型的筛选条件。"}, {"type": "subtitle", "time": 18676.55, "timestamp": "05:11:16", "text": "如果他们能拥有就好了。你知道吗？"}, {"type": "subtitle", "time": 18679.19, "timestamp": "05:11:19", "text": "直播结束后，我会把它放进去。"}, {"type": "subtitle", "time": 18682.23, "timestamp": "05:11:22", "text": "GitHub 上的功能请求工具。"}, {"type": "subtitle", "time": 18690.15, "timestamp": "05:11:30", "text": "我会这么做。我想把这件事弄清楚。"}, {"type": "subtitle", "time": 18693.11, "timestamp": "05:11:33", "text": "误会之类的。是，是呃"}, {"type": "subtitle", "time": 18696.868, "timestamp": "05:11:36", "text": "这件事一直让我耿耿于怀。"}, {"type": "subtitle", "time": 18699.51, "timestamp": "05:11:39", "text": "我会回来的。嗨。嗨。嗨。带上你的"}, {"type": "subtitle", "time": 18701.19, "timestamp": "05:11:41", "text": "时间。"}, {"type": "subtitle", "time": 18704.55, "timestamp": "05:11:44", "text": "这说明你真的很喜欢极品飞车系列。不。"}, {"type": "subtitle", "time": 18709.43, "timestamp": "05:11:49", "text": "我为什么要这样做？"}, {"type": "subtitle", "time": 18712.31, "timestamp": "05:11:52", "text": "笨蛋？好的。呃，还不算太"}, {"type": "subtitle", "time": 18719.43, "timestamp": "05:11:59", "text": "不，那是你的"}]
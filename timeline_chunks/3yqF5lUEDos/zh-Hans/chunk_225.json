[{"type": "subtitle", "time": 13501.429, "timestamp": "03:45:01", "text": "以及所有那些东西。是的，我们当时"}, {"type": "subtitle", "time": 13504.79, "timestamp": "03:45:04", "text": "想得到“是”。头部也是，"}, {"type": "subtitle", "time": 13506.05, "timestamp": "03:45:06", "text": "正确的？"}, {"type": "subtitle", "time": 13507.83, "timestamp": "03:45:07", "text": "[音乐]"}, {"type": "subtitle", "time": 13511.67, "timestamp": "03:45:11", "text": "守门员头颅。我家有它们，我"}, {"type": "subtitle", "time": 13513.67, "timestamp": "03:45:13", "text": "思考。"}, {"type": "subtitle", "time": 13517.11, "timestamp": "03:45:17", "text": "所以1.5是灵敏度，对吧？如果"}, {"type": "subtitle", "time": 13519.83, "timestamp": "03:45:19", "text": "灵敏度是 1.5，你可以进行微调。"}, {"type": "subtitle", "time": 13523.11, "timestamp": "03:45:23", "text": "加上第二个辅助数字"}, {"type": "subtitle", "time": 13527.75, "timestamp": "03:45:27", "text": "五点以后。所以那是1，呃，50，或者呃，不，"}, {"type": "subtitle", "time": 13532.95, "timestamp": "03:45:32", "text": "不要填零。 1.5 分 1.51"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "这样就完善了1.5这个东西。你添加"}, {"type": "subtitle", "time": 13537.99, "timestamp": "03:45:37", "text": "另一个数字进一步细化了它"}, {"type": "subtitle", "time": 13541.349, "timestamp": "03:45:41", "text": "再次。这样就能把它抚平了。但"}, {"type": "subtitle", "time": 13543.11, "timestamp": "03:45:43", "text": "喜欢"}, {"type": "subtitle", "time": 13546.63, "timestamp": "03:45:46", "text": "假设这是 1.5。好的。如果我改变我的"}, {"type": "subtitle", "time": 13548.87, "timestamp": "03:45:48", "text": "1.5.11 的含义"}, {"type": "subtitle", "time": 13550.55, "timestamp": "03:45:50", "text": "这意味着还需要一点时间"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "这样更流畅。还是一样。"}, {"type": "subtitle", "time": 13555.429, "timestamp": "03:45:55", "text": "有点儿……但又有点儿……零碎。呃"}, {"type": "subtitle", "time": 13556.71, "timestamp": "03:45:56", "text": "更顺滑。"}, {"type": "subtitle", "time": 13559.349, "timestamp": "03:45:59", "text": "我当时就像在解释……"}]
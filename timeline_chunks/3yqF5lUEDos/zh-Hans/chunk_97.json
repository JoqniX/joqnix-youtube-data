[{"type": "subtitle", "time": 5820.149, "timestamp": "01:37:00", "text": "我们走吧。"}, {"type": "subtitle", "time": 5828.229, "timestamp": "01:37:08", "text": "好的。前往鹰一号。我们拥有全部"}, {"type": "subtitle", "time": 5845.59, "timestamp": "01:37:25", "text": "哦，那是坦克吗？哦，那是敌人"}, {"type": "subtitle", "time": 5849.75, "timestamp": "01:37:29", "text": "坦克。我的天啊。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 5851.75, "timestamp": "01:37:31", "text": "哦。"}, {"type": "subtitle", "time": 5855.99, "timestamp": "01:37:35", "text": "我的天啊。我遭到了“哦，我的”的攻击"}, {"type": "subtitle", "time": 5858.629, "timestamp": "01:37:38", "text": "上帝。我的天哪。它"}, {"type": "subtitle", "time": 5861.43, "timestamp": "01:37:41", "text": "爆炸了。"}, {"type": "subtitle", "time": 5868.55, "timestamp": "01:37:48", "text": "帮助任何人。"}, {"type": "subtitle", "time": 5876.47, "timestamp": "01:37:56", "text": "疼痛。"}]
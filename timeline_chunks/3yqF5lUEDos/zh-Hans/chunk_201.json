[{"type": "subtitle", "time": 12063.269, "timestamp": "03:21:03", "text": "这些需要大量的木材。然后我"}, {"type": "subtitle", "time": 12066.07, "timestamp": "03:21:06", "text": "呃，后来才知道这件事，哦等等，我为什么会这样？"}, {"type": "subtitle", "time": 12068.63, "timestamp": "03:21:08", "text": "浪费了我收集的所有木材"}, {"type": "subtitle", "time": 12072.389, "timestamp": "03:21:12", "text": "像这样扩大基地吗？"}, {"type": "subtitle", "time": 12074.389, "timestamp": "03:21:14", "text": "呃"}, {"type": "subtitle", "time": 12077.59, "timestamp": "03:21:17", "text": "是的，疼痛"}, {"type": "subtitle", "time": 12080.07, "timestamp": "03:21:20", "text": "好吧。你是在其他任何地方吗？"}, {"type": "subtitle", "time": 12083.19, "timestamp": "03:21:23", "text": "现在有Minecraft服务器了吗？不，我没有。"}, {"type": "subtitle", "time": 12086.63, "timestamp": "03:21:26", "text": "玩Minecraft已经很久了。我们开始吧"}, {"type": "subtitle", "time": 12088.87, "timestamp": "03:21:28", "text": "创建一个新的。"}, {"type": "subtitle", "time": 12092.63, "timestamp": "03:21:32", "text": "但正是这个时候我不会……"}, {"type": "subtitle", "time": 12094.79, "timestamp": "03:21:34", "text": "能够投入时间。这就是原因"}, {"type": "subtitle", "time": 12098.95, "timestamp": "03:21:38", "text": "我感觉像是在付钱"}, {"type": "subtitle", "time": 12101.429, "timestamp": "03:21:41", "text": "可以理解。"}, {"type": "subtitle", "time": 12103.11, "timestamp": "03:21:43", "text": "你知道，我们还是抽出点时间来……"}, {"type": "subtitle", "time": 12106.229, "timestamp": "03:21:46", "text": "Minecraft Steam 或合作，你知道，添加"}, {"type": "subtitle", "time": 12108.55, "timestamp": "03:21:48", "text": "服务器又增加了一些成员。"}, {"type": "subtitle", "time": 12111.59, "timestamp": "03:21:51", "text": "与他们合作。是的，那会的。"}, {"type": "subtitle", "time": 12113.75, "timestamp": "03:21:53", "text": "那一定很有趣。"}]
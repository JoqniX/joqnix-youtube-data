[{"type": "subtitle", "time": 9961.51, "timestamp": "02:46:01", "text": "我把它改成了我自己。"}, {"type": "subtitle", "time": 9987.19, "timestamp": "02:46:27", "text": "最后，我被标记了。"}, {"type": "subtitle", "time": 9990.07, "timestamp": "02:46:30", "text": "这是一趟漫长的旅程。"}, {"type": "subtitle", "time": 9993.59, "timestamp": "02:46:33", "text": "是啊，路途遥远。"}, {"type": "subtitle", "time": 9995.75, "timestamp": "02:46:35", "text": "这里有村庄。我们来看一些"}, {"type": "subtitle", "time": 10007.19, "timestamp": "02:46:47", "text": "别撞到它。"}, {"type": "subtitle", "time": 10009.11, "timestamp": "02:46:49", "text": "哦，是的，他们都很好，或者"}, {"type": "subtitle", "time": 10015.349, "timestamp": "02:46:55", "text": "我没有设置重生点。我设置过吗？"}, {"type": "subtitle", "time": 10018.469, "timestamp": "02:46:58", "text": "这边？"}]
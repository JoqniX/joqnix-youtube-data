[{"type": "subtitle", "time": 10442.55, "timestamp": "02:54:02", "text": "是的，我们来这里是为了留下回忆。"}, {"type": "subtitle", "time": 10466.71, "timestamp": "02:54:26", "text": "让我们一起欣赏风景吧。"}, {"type": "subtitle", "time": 10470.87, "timestamp": "02:54:30", "text": "是啊，妈妈们都摔倒了。"}, {"type": "subtitle", "time": 10473.11, "timestamp": "02:54:33", "text": "有什么好玩的吗？我猜"}, {"type": "subtitle", "time": 10475.349, "timestamp": "02:54:35", "text": "这令人满足。"}, {"type": "subtitle", "time": 10481.19, "timestamp": "02:54:41", "text": "还有，嗯"}, {"type": "subtitle", "time": 10484.63, "timestamp": "02:54:44", "text": "是的，男孩。"}, {"type": "subtitle", "time": 10487.91, "timestamp": "02:54:47", "text": "Roa，你是新来的吗？我觉得你"}, {"type": "subtitle", "time": 10489.67, "timestamp": "02:54:49", "text": "今天你是怎么找到我的频道的？"}, {"type": "subtitle", "time": 10492.15, "timestamp": "02:54:52", "text": "多么受欢迎啊！欢迎"}, {"type": "subtitle", "time": 10496.389, "timestamp": "02:54:56", "text": "在天上。哪个？周末。"}, {"type": "subtitle", "time": 10498.63, "timestamp": "02:54:58", "text": "哦，就像那个东西一样，对吧？那黑色"}]
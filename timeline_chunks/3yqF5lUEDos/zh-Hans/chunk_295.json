[{"type": "subtitle", "time": 17701.75, "timestamp": "04:55:01", "text": "或许只要别弄得乱七八糟就行了。"}, {"type": "subtitle", "time": 17704.708, "timestamp": "04:55:04", "text": "向上。好的。建筑提示。"}, {"type": "subtitle", "time": 17707.99, "timestamp": "04:55:07", "text": "请不要偷窃其他玩家的物品。"}, {"type": "subtitle", "time": 17710.31, "timestamp": "04:55:10", "text": "哦，对，我记得。我记得"}, {"type": "subtitle", "time": 17713.83, "timestamp": "04:55:13", "text": "有人偷了我的书。"}, {"type": "subtitle", "time": 17716.868, "timestamp": "04:55:16", "text": "禁止作弊。"}, {"type": "subtitle", "time": 17720.628, "timestamp": "04:55:20", "text": "嗯？是我吗？我不知道。不，你"}, {"type": "subtitle", "time": 17726.23, "timestamp": "04:55:26", "text": "你还记得那盘幽灵录像带吗？啊，是的。"}, {"type": "subtitle", "time": 17731.11, "timestamp": "04:55:31", "text": "是的，是他干的。是的。六。现在是"}, {"type": "subtitle", "time": 17733.35, "timestamp": "04:55:33", "text": "允许坐着就像复制漏洞一样"}, {"type": "subtitle", "time": 17736.23, "timestamp": "04:55:36", "text": "或者像X光之类的东西。破碎基岩"}, {"type": "subtitle", "time": 17738.39, "timestamp": "04:55:38", "text": "仅允许在下界顶部使用。"}, {"type": "subtitle", "time": 17740.628, "timestamp": "04:55:40", "text": "它很有帮助，并得到了一些大公司的支持。"}, {"type": "subtitle", "time": 17744.15, "timestamp": "04:55:44", "text": "玩家。哦，是的，只有代码三是"}, {"type": "subtitle", "time": 17745.75, "timestamp": "04:55:45", "text": "服务器的运营者。是的，在……期间"}, {"type": "subtitle", "time": 17748.55, "timestamp": "04:55:48", "text": "那时没有人会获得OP（过于强大）的称号。"}, {"type": "subtitle", "time": 17750.788, "timestamp": "04:55:50", "text": "未来。他也会有一些"}, {"type": "subtitle", "time": 17753.83, "timestamp": "04:55:53", "text": "限制。我们稍后会列出来。"}, {"type": "subtitle", "time": 17755.91, "timestamp": "04:55:55", "text": "部分活动将以手工方式举办。"}, {"type": "subtitle", "time": 17757.99, "timestamp": "04:55:57", "text": "服务器有时就像夏季节日一样"}]
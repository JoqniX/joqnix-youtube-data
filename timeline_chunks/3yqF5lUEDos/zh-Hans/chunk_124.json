[{"type": "subtitle", "time": 7442.95, "timestamp": "02:04:02", "text": "是的。米娜，我们该怎么办？"}, {"type": "subtitle", "time": 7447.589, "timestamp": "02:04:07", "text": "我其实也不知道。嗯"}, {"type": "subtitle", "time": 7450.629, "timestamp": "02:04:10", "text": "呃，我们可以直接开始，我来结束这个。"}, {"type": "subtitle", "time": 7452.55, "timestamp": "02:04:12", "text": "直播结束后，我会开始一个新的直播。"}, {"type": "subtitle", "time": 7454.95, "timestamp": "02:04:14", "text": "或许"}, {"type": "subtitle", "time": 7458.31, "timestamp": "02:04:18", "text": "因为你知道我想要这些内容。"}, {"type": "subtitle", "time": 7461.83, "timestamp": "02:04:21", "text": "这个流要具体到那个流。"}, {"type": "subtitle", "time": 7463.99, "timestamp": "02:04:23", "text": "如果我做对了其他事情，我"}, {"type": "subtitle", "time": 7466.31, "timestamp": "02:04:26", "text": "想把它做成第二个直播流"}, {"type": "subtitle", "time": 7469.03, "timestamp": "02:04:29", "text": "或许我们可以稍微聊聊。"}, {"type": "subtitle", "time": 7472.87, "timestamp": "02:04:32", "text": "有点疼，但我牙疼已经两天了。"}, {"type": "subtitle", "time": 7479.83, "timestamp": "02:04:39", "text": "所以我可能会暂时离开一会儿。"}, {"type": "subtitle", "time": 7482.55, "timestamp": "02:04:42", "text": "进而"}, {"type": "subtitle", "time": 7491.03, "timestamp": "02:04:51", "text": "所以今天，呃，我大部分时间都能"}, {"type": "subtitle", "time": 7494.149, "timestamp": "02:04:54", "text": "无法通过我的游戏电脑进行串流，因为"}, {"type": "subtitle", "time": 7497.91, "timestamp": "02:04:57", "text": "《战地》系列游戏对GPU的要求非常高。"}]
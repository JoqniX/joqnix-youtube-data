[{"type": "subtitle", "time": 10681.91, "timestamp": "02:58:01", "text": "箱子里什么也没有。"}, {"type": "subtitle", "time": 10684.55, "timestamp": "02:58:04", "text": "疼痛。但我们这里确实有人。"}, {"type": "subtitle", "time": 10686.71, "timestamp": "02:58:06", "text": "这里面有些东西。"}, {"type": "subtitle", "time": 10690.95, "timestamp": "02:58:10", "text": "如果我没记错的话，只做一块地毯。"}, {"type": "subtitle", "time": 10697.11, "timestamp": "02:58:17", "text": "钻石。"}, {"type": "subtitle", "time": 10699.269, "timestamp": "02:58:19", "text": "是的。"}, {"type": "subtitle", "time": 10708.79, "timestamp": "02:58:28", "text": "一共有多少个？"}, {"type": "subtitle", "time": 10714.79, "timestamp": "02:58:34", "text": "九。"}, {"type": "subtitle", "time": 10723.99, "timestamp": "02:58:43", "text": "让我们把钻石展示出来。"}, {"type": "subtitle", "time": 10727.03, "timestamp": "02:58:47", "text": "是的，我不想得到它们。我们开始吧"}, {"type": "subtitle", "time": 10730.07, "timestamp": "02:58:50", "text": "制作一套盔甲。"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "我没有。好吧，它是木制的。我没有"}]
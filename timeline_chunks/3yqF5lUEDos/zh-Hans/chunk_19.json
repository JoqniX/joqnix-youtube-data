[{"type": "subtitle", "time": 1142.87, "timestamp": "00:19:02", "text": "确实奏效了。等等，成功了。哦，太好了。"}, {"type": "subtitle", "time": 1146.549, "timestamp": "00:19:06", "text": "好的。祖基，我很高兴它奏效了。我是"}, {"type": "subtitle", "time": 1149.83, "timestamp": "00:19:09", "text": "快乐的。不好意思打扰您了。不，不"}, {"type": "subtitle", "time": 1153.35, "timestamp": "00:19:13", "text": "别后悔。笨蛋，你有什么吗？"}, {"type": "subtitle", "time": 1157.99, "timestamp": "00:19:17", "text": "我在这里。妮娅，我想让你告诉我。"}, {"type": "subtitle", "time": 1170.63, "timestamp": "00:19:30", "text": "Bravo 一号遭到盟军攻击"}, {"type": "subtitle", "time": 1181.669, "timestamp": "00:19:41", "text": "哦，等等。你杀了我。我好害怕"}, {"type": "subtitle", "time": 1186.31, "timestamp": "00:19:46", "text": "用来描述事件。这是一辆车。"}, {"type": "subtitle", "time": 1190.789, "timestamp": "00:19:50", "text": "我用的是快速 x264"}, {"type": "subtitle", "time": 1193.35, "timestamp": "00:19:53", "text": "呃，通常情况下。你好。在你改变之前"}, {"type": "subtitle", "time": 1196.549, "timestamp": "00:19:56", "text": "任何内容，务必截图保存。是"}, {"type": "subtitle", "time": 1199.59, "timestamp": "00:19:59", "text": "一定要截图。以防万一"}]
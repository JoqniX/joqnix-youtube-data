[{"type": "subtitle", "time": 16202.71, "timestamp": "04:30:02", "text": "你知道吗？我就要崩溃了。"}, {"type": "subtitle", "time": 16210.309, "timestamp": "04:30:10", "text": "好的。我在这里的时候把它弄坏了。等待，"}, {"type": "subtitle", "time": 16212.95, "timestamp": "04:30:12", "text": "为什么会有魔像，被囚禁的铁魔像？"}, {"type": "subtitle", "time": 16225.67, "timestamp": "04:30:25", "text": "哦，"}, {"type": "subtitle", "time": 16237.67, "timestamp": "04:30:37", "text": "B，可是我究竟是从哪里来的呢？"}, {"type": "subtitle", "time": 16252.79, "timestamp": "04:30:52", "text": "你在哪里？我在这里。"}, {"type": "subtitle", "time": 16255.59, "timestamp": "04:30:55", "text": "我没看见你。在这个里面 在这个里面"}]
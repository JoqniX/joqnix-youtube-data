[{"type": "subtitle", "time": 11642.66, "timestamp": "03:14:02", "text": "一台冰箱。我的天啊。"}, {"type": "subtitle", "time": 11644.469, "timestamp": "03:14:04", "text": "[音乐]"}, {"type": "subtitle", "time": 11654.55, "timestamp": "03:14:14", "text": "还有你那个俄罗斯厨房玩意儿。哦"}, {"type": "subtitle", "time": 11656.87, "timestamp": "03:14:16", "text": "我的上帝。"}, {"type": "subtitle", "time": 11659.91, "timestamp": "03:14:19", "text": "我太棒了。"}, {"type": "subtitle", "time": 11663.349, "timestamp": "03:14:23", "text": "还有屋顶"}, {"type": "subtitle", "time": 11666.389, "timestamp": "03:14:26", "text": "盔甲架在这里。"}, {"type": "subtitle", "time": 11674.55, "timestamp": "03:14:34", "text": "我们也可以去真正的屋顶。"}, {"type": "subtitle", "time": 11676.95, "timestamp": "03:14:36", "text": "从这里开始。还有更多的屋顶。"}, {"type": "subtitle", "time": 11683.99, "timestamp": "03:14:43", "text": "这太酷了。"}, {"type": "subtitle", "time": 11686.79, "timestamp": "03:14:46", "text": "我们做了什么？我们什么也没做。"}, {"type": "subtitle", "time": 11689.59, "timestamp": "03:14:49", "text": "是的，我们开始经营农场吧。"}, {"type": "subtitle", "time": 11691.83, "timestamp": "03:14:51", "text": "瞧瞧。那是赫尔。那太惊人了。"}, {"type": "subtitle", "time": 11694.229, "timestamp": "03:14:54", "text": "比我的还不如。"}]
[{"type": "subtitle", "time": 3435.19, "timestamp": "00:57:15", "text": "肖恩来了。"}, {"type": "subtitle", "time": 3448.63, "timestamp": "00:57:28", "text": "不。我的天啊。你刚才不是这么做的吗？"}, {"type": "subtitle", "time": 3457.349, "timestamp": "00:57:37", "text": "对阿尔法一号的攻击。我在那里看到了"}, {"type": "subtitle", "time": 3469.109, "timestamp": "00:57:49", "text": "应该只有一个人。他结束了"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "那里。那边有。"}, {"type": "subtitle", "time": 3476.15, "timestamp": "00:57:56", "text": "对，就是这个偷偷摸摸进来的家伙。"}]
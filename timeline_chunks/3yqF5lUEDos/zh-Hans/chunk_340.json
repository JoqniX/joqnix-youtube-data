[{"type": "subtitle", "time": 20403.51, "timestamp": "05:40:03", "text": "感谢找到我的直播流。真的真的"}, {"type": "subtitle", "time": 20406.07, "timestamp": "05:40:06", "text": "意义重大。你说你来自"}, {"type": "subtitle", "time": 20407.59, "timestamp": "05:40:07", "text": "印度尼西亚。"}, {"type": "subtitle", "time": 20410.31, "timestamp": "05:40:10", "text": "所以我很高兴能再添一位印尼朋友。"}, {"type": "subtitle", "time": 20413.35, "timestamp": "05:40:13", "text": "虽然是我的印尼朋友。我数不清了。"}, {"type": "subtitle", "time": 20416.548, "timestamp": "05:40:16", "text": "我有多少国际朋友，因为"}, {"type": "subtitle", "time": 20419.03, "timestamp": "05:40:19", "text": "它由一些印尼人组成"}, {"type": "subtitle", "time": 20424.788, "timestamp": "05:40:24", "text": "观众、听众，还有BTuber们"}, {"type": "subtitle", "time": 20427.35, "timestamp": "05:40:27", "text": "我的朋友"}, {"type": "subtitle", "time": 20429.83, "timestamp": "05:40:29", "text": "我通过……认识了他"}, {"type": "subtitle", "time": 20433.43, "timestamp": "05:40:33", "text": "库桑。是的，有一些印尼虚拟主播"}, {"type": "subtitle", "time": 20436.23, "timestamp": "05:40:36", "text": "就在那里。我忘了。是的，谢谢"}, {"type": "subtitle", "time": 20438.708, "timestamp": "05:40:38", "text": "非常感谢你过来。希望你"}, {"type": "subtitle", "time": 20443.27, "timestamp": "05:40:43", "text": "我很喜欢我的直播和直播。"}, {"type": "subtitle", "time": 20450.07, "timestamp": "05:40:50", "text": "感谢罗伯特·杰克逊的光临。"}, {"type": "subtitle", "time": 20453.51, "timestamp": "05:40:53", "text": "谢谢。我看到你还在使用"}, {"type": "subtitle", "time": 20458.39, "timestamp": "05:40:58", "text": "再开个玩笑。我的意思是，没关系。嗯，我"}]
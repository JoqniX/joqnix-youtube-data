[{"type": "subtitle", "time": 4928.79, "timestamp": "01:22:08", "text": "人们都放弃了，而你却在这里。"}, {"type": "subtitle", "time": 4934.55, "timestamp": "01:22:14", "text": "不，杰克，你得做你自己的事。"}, {"type": "subtitle", "time": 4948.31, "timestamp": "01:22:28", "text": "我的天哪。天哪，太吵了。我的天哪，我"}, {"type": "subtitle", "time": 4963.27, "timestamp": "01:22:43", "text": "等等，就是这样。他们的防御也太强了。"}, {"type": "subtitle", "time": 4975.11, "timestamp": "01:22:55", "text": "你真的感到惊讶吗？"}, {"type": "subtitle", "time": 4978.149, "timestamp": "01:22:58", "text": "我并不自负。我很有安全感，而且"}]
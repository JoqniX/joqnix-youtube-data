[{"type": "subtitle", "time": 13201.91, "timestamp": "03:40:01", "text": "我启动。你问为什么？"}, {"type": "subtitle", "time": 13205.11, "timestamp": "03:40:05", "text": "我不知道。我只是想确认一下"}, {"type": "subtitle", "time": 13209.349, "timestamp": "03:40:09", "text": "车辆所在位置的帧率。"}, {"type": "subtitle", "time": 13212.469, "timestamp": "03:40:12", "text": "是的，我不小心"}, {"type": "subtitle", "time": 13215.99, "timestamp": "03:40:15", "text": "敲击地板。我可能处境很糟糕。"}, {"type": "subtitle", "time": 13225.429, "timestamp": "03:40:25", "text": "首先要做的是发出“是”的声音。制作一个"}, {"type": "subtitle", "time": 13226.53, "timestamp": "03:40:26", "text": "塔。"}, {"type": "subtitle", "time": 13227.99, "timestamp": "03:40:27", "text": "[音乐]"}, {"type": "subtitle", "time": 13252.07, "timestamp": "03:40:52", "text": "它会撞到什么东西吗？"}, {"type": "subtitle", "time": 13254.63, "timestamp": "03:40:54", "text": "哦，"}, {"type": "subtitle", "time": 13258.309, "timestamp": "03:40:58", "text": "如果我没记错的话，应该是……"}]
[{"type": "subtitle", "time": 18363.59, "timestamp": "05:06:03", "text": "我的意思是，彻底失败了。为什么？这"}, {"type": "subtitle", "time": 18365.51, "timestamp": "05:06:05", "text": "文化方面的东西。"}, {"type": "subtitle", "time": 18369.91, "timestamp": "05:06:09", "text": "日本之心。哦，你是说日本人。"}, {"type": "subtitle", "time": 18371.67, "timestamp": "05:06:11", "text": "哦好的。好的。好的。好的。是的，就是这样。"}, {"type": "subtitle", "time": 18373.43, "timestamp": "05:06:13", "text": "美好的。"}, {"type": "subtitle", "time": 18375.67, "timestamp": "05:06:15", "text": "用日语谈论文化。"}, {"type": "subtitle", "time": 18377.43, "timestamp": "05:06:17", "text": "就是这样。"}, {"type": "subtitle", "time": 18379.99, "timestamp": "05:06:19", "text": "哦，等等。这像是合作吗？"}, {"type": "subtitle", "time": 18381.91, "timestamp": "05:06:21", "text": "他们直播里是不是有什么事？"}, {"type": "subtitle", "time": 18385.27, "timestamp": "05:06:25", "text": "不，我们当时和Okay一起在PC上。"}, {"type": "subtitle", "time": 18389.11, "timestamp": "05:06:29", "text": "你好。你好。嗨，哥们。你是如何做到的？"}, {"type": "subtitle", "time": 18392.31, "timestamp": "05:06:32", "text": "日本人？我还是不够优秀。我 我"}, {"type": "subtitle", "time": 18396.868, "timestamp": "05:06:36", "text": "肯定死了。不用担心。离开那里。"}, {"type": "subtitle", "time": 18400.628, "timestamp": "05:06:40", "text": "VR聊天在哪里？"}, {"type": "subtitle", "time": 18403.59, "timestamp": "05:06:43", "text": "是的。你好，Zuki。欢迎。我的天啊。"}, {"type": "subtitle", "time": 18407.91, "timestamp": "05:06:47", "text": "我们就像是在参观那个东西。"}, {"type": "subtitle", "time": 18410.07, "timestamp": "05:06:50", "text": "老兄，你应该早点来的。"}, {"type": "subtitle", "time": 18417.27, "timestamp": "05:06:57", "text": "那些东西。"}]
[{"type": "subtitle", "time": 14766.389, "timestamp": "04:06:06", "text": "我真希望我能去MS中心。"}, {"type": "subtitle", "time": 14769.75, "timestamp": "04:06:09", "text": "我想我搭建了一个结构之类的东西。"}, {"type": "subtitle", "time": 14772.87, "timestamp": "04:06:12", "text": "那边也是。是的，我认为我们"}, {"type": "subtitle", "time": 14775.83, "timestamp": "04:06:15", "text": "用奥布利迪姆做了一些东西。"}, {"type": "subtitle", "time": 14779.429, "timestamp": "04:06:19", "text": "是的。是的。是的，我们做到了。"}, {"type": "subtitle", "time": 14783.11, "timestamp": "04:06:23", "text": "呃，可是该怎么找到那个地方呢？"}, {"type": "subtitle", "time": 14785.429, "timestamp": "04:06:25", "text": "我们回到正题吧，我"}, {"type": "subtitle", "time": 14788.87, "timestamp": "04:06:28", "text": "猜测。是的。"}, {"type": "subtitle", "time": 14791.429, "timestamp": "04:06:31", "text": "传送至出生点。熊。这是什么？"}, {"type": "subtitle", "time": 14793.11, "timestamp": "04:06:33", "text": "装置？等等，这是等等吗？"}, {"type": "subtitle", "time": 14795.75, "timestamp": "04:06:35", "text": "是不是就是这个？不，这是"}, {"type": "subtitle", "time": 14797.99, "timestamp": "04:06:37", "text": "村庄。"}, {"type": "subtitle", "time": 14800.15, "timestamp": "04:06:40", "text": "啊，"}, {"type": "subtitle", "time": 14803.51, "timestamp": "04:06:43", "text": "我以为我们真的找到了，我看到了"}, {"type": "subtitle", "time": 14806.309, "timestamp": "04:06:46", "text": "一个沙村。那是一个村庄。我说"}, {"type": "subtitle", "time": 14809.59, "timestamp": "04:06:49", "text": "村庄。哦，是的。我也记得"}, {"type": "subtitle", "time": 14815.99, "timestamp": "04:06:55", "text": "一个很长的村庄，是的。很远的地方。"}]
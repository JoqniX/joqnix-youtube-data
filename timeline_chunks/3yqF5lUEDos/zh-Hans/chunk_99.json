[{"type": "subtitle", "time": 5940.95, "timestamp": "01:39:00", "text": "回声。现在，让我们来看看这个行业。"}, {"type": "subtitle", "time": 5947.03, "timestamp": "01:39:07", "text": "我没看到。他当时在露营。什么"}, {"type": "subtitle", "time": 5969.51, "timestamp": "01:39:29", "text": "我们走吧。砰砰超强。"}, {"type": "subtitle", "time": 5985.669, "timestamp": "01:39:45", "text": "哦，等等。我的天哪。我的上帝。我要拿到这个"}, {"type": "subtitle", "time": 5988.55, "timestamp": "01:39:48", "text": "不知怎么的。这些人太强大了"}, {"type": "subtitle", "time": 5992.31, "timestamp": "01:39:52", "text": "这里。这使得它更"}]
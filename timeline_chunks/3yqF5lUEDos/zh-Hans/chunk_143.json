[{"type": "subtitle", "time": 8582.07, "timestamp": "02:23:02", "text": "流。你好。提高效率。你好。"}, {"type": "subtitle", "time": 8587.11, "timestamp": "02:23:07", "text": "他妈的。"}, {"type": "subtitle", "time": 8589.429, "timestamp": "02:23:09", "text": "但是但是"}, {"type": "subtitle", "time": 8591.99, "timestamp": "02:23:11", "text": "不要以游戏为依据。好的。我的意思是，如果"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "我做艺术直播，这没问题。喜欢"}, {"type": "subtitle", "time": 8599.83, "timestamp": "02:23:19", "text": "创意或艺术。我可以吗？"}, {"type": "subtitle", "time": 8611.11, "timestamp": "02:23:31", "text": "哦，不。结束直播太难了。"}, {"type": "subtitle", "time": 8615.91, "timestamp": "02:23:35", "text": "太难了。是啊，太难了。"}, {"type": "subtitle", "time": 8624.07, "timestamp": "02:23:44", "text": "是的。肌酸。好的。然后就是"}, {"type": "subtitle", "time": 8626.79, "timestamp": "02:23:46", "text": "好的。禁止玩游戏。好的。美好的。我不会"}, {"type": "subtitle", "time": 8630.63, "timestamp": "02:23:50", "text": "花时间玩游戏。"}, {"type": "subtitle", "time": 8633.03, "timestamp": "02:23:53", "text": "一次进入口腔。"}]
[{"type": "subtitle", "time": 8349.669, "timestamp": "02:19:09", "text": "呃，所以，所以，呃，我想问一个问题。"}, {"type": "subtitle", "time": 8352.15, "timestamp": "02:19:12", "text": "事物。呃，所以如果你还没去过"}, {"type": "subtitle", "time": 8355.11, "timestamp": "02:19:15", "text": "有人在推特上关注了我，所以我做了"}, {"type": "subtitle", "time": 8358.709, "timestamp": "02:19:18", "text": "这条推文问的就是这个问题，对吧？告诉我什么"}, {"type": "subtitle", "time": 8362.549, "timestamp": "02:19:22", "text": "你们有什么建议吗？"}, {"type": "subtitle", "time": 8366.389, "timestamp": "02:19:26", "text": "呃，你知道，我一直都只是"}, {"type": "subtitle", "time": 8369.99, "timestamp": "02:19:29", "text": "多次长时间流媒体播放"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "如果你想的话，可以尝试几个小时的时间段。"}, {"type": "subtitle", "time": 8376.469, "timestamp": "02:19:36", "text": "比如视频内容，或者如果你想喜欢的话"}, {"type": "subtitle", "time": 8380.389, "timestamp": "02:19:40", "text": "呃，创意流，你知道的，呃"}, {"type": "subtitle", "time": 8384.79, "timestamp": "02:19:44", "text": "一月份我们有一些音乐方面的东西。"}, {"type": "subtitle", "time": 8388.87, "timestamp": "02:19:48", "text": "计划好了，我们会这么做的，所以我"}, {"type": "subtitle", "time": 8392.07, "timestamp": "02:19:52", "text": "想到了真正参与航行。"}, {"type": "subtitle", "time": 8395.67, "timestamp": "02:19:55", "text": "模型。我喜欢2D。"}, {"type": "subtitle", "time": 8398.309, "timestamp": "02:19:58", "text": "所以，我认识的那些人，都很美。"}]
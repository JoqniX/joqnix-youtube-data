[{"type": "subtitle", "time": 12181.83, "timestamp": "03:23:01", "text": "是的。哦，等等，那里有个灰色方框。谁"}, {"type": "subtitle", "time": 12202.15, "timestamp": "03:23:22", "text": "我的天啊。"}, {"type": "subtitle", "time": 12207.91, "timestamp": "03:23:27", "text": "最后我们做出什么成果了吗？呃……"}, {"type": "subtitle", "time": 12210.63, "timestamp": "03:23:30", "text": "终点站？"}, {"type": "subtitle", "time": 12214.79, "timestamp": "03:23:34", "text": "我的意思是，我们建好了末影人农场。"}, {"type": "subtitle", "time": 12216.87, "timestamp": "03:23:36", "text": "哦，我们开始吧？我们去那里参观了。想要"}, {"type": "subtitle", "time": 12220.389, "timestamp": "03:23:40", "text": "来玩过之后还会再来吗？好的，既然我们在这里"}, {"type": "subtitle", "time": 12223.99, "timestamp": "03:23:43", "text": "我有点害怕那种感觉"}, {"type": "subtitle", "time": 12227.91, "timestamp": "03:23:47", "text": "每次看到天空，你知道，天空"}, {"type": "subtitle", "time": 12232.389, "timestamp": "03:23:52", "text": "这里太黑了，而且让我感到害怕。"}]
[{"type": "subtitle", "time": 20160.708, "timestamp": "05:36:00", "text": "呃，我不知道。我的一部分想要"}, {"type": "subtitle", "time": 20162.47, "timestamp": "05:36:02", "text": "要解锁 Fontaine 的一切，你"}, {"type": "subtitle", "time": 20165.75, "timestamp": "05:36:05", "text": "在进行征服之前，先了解情况。"}, {"type": "subtitle", "time": 20167.51, "timestamp": "05:36:07", "text": "而且我内心深处也不想这样做。"}, {"type": "subtitle", "time": 20169.91, "timestamp": "05:36:09", "text": "那。我只想关注比赛结果。"}, {"type": "subtitle", "time": 20172.868, "timestamp": "05:36:12", "text": "先上一个区域，然后再上下一个区域，或者"}, {"type": "subtitle", "time": 20175.75, "timestamp": "05:36:15", "text": "某物。我不知道。我懂了。全部"}, {"type": "subtitle", "time": 20178.31, "timestamp": "05:36:18", "text": "正确的。"}, {"type": "subtitle", "time": 20201.67, "timestamp": "05:36:41", "text": "我真的相信我是对的。嗨，阿拉玛离开了"}, {"type": "subtitle", "time": 20204.708, "timestamp": "05:36:44", "text": "男人。今天真的太开心了。我的天啊。哦"}, {"type": "subtitle", "time": 20207.35, "timestamp": "05:36:47", "text": "我的上帝。"}, {"type": "subtitle", "time": 20210.868, "timestamp": "05:36:50", "text": "我们不仅会爆炸。"}, {"type": "subtitle", "time": 20215.35, "timestamp": "05:36:55", "text": "我们今天不仅会炸东西。"}, {"type": "subtitle", "time": 20218.548, "timestamp": "05:36:58", "text": "我们聊了很多，还有艾玛·珊·查玛"}]
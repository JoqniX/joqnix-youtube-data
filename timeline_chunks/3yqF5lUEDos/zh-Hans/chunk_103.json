[{"type": "subtitle", "time": 6203.109, "timestamp": "01:43:23", "text": "这边这边。让我们来看看。对吧，是阿尔法星？"}, {"type": "subtitle", "time": 6206.39, "timestamp": "01:43:26", "text": "这是直升机停机坪吗？"}, {"type": "subtitle", "time": 6213.99, "timestamp": "01:43:33", "text": "这样更混乱。我们来回顾一下"}, {"type": "subtitle", "time": 6237.75, "timestamp": "01:43:57", "text": "请伸出手。"}]
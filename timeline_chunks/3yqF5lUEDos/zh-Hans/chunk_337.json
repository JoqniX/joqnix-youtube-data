[{"type": "subtitle", "time": 20221.83, "timestamp": "05:37:01", "text": "呃，艾玛·查玛（Emma Chama）也想知道她是否会加入。"}, {"type": "subtitle", "time": 20226.31, "timestamp": "05:37:06", "text": "适用于新服务器。呃，设计是"}, {"type": "subtitle", "time": 20230.47, "timestamp": "05:37:10", "text": "制作。所以，如果可能的话"}, {"type": "subtitle", "time": 20232.47, "timestamp": "05:37:12", "text": "我想联系一位日本人"}, {"type": "subtitle", "time": 20234.07, "timestamp": "05:37:14", "text": "主播"}, {"type": "subtitle", "time": 20236.708, "timestamp": "05:37:16", "text": "日语其实是nihon，所以我可以喜欢"}, {"type": "subtitle", "time": 20240.23, "timestamp": "05:37:20", "text": "其实我想提高一下我的日语水平，你知道的。"}, {"type": "subtitle", "time": 20245.99, "timestamp": "05:37:25", "text": "是啊，总有一天。"}, {"type": "subtitle", "time": 20248.23, "timestamp": "05:37:28", "text": "所以，是的，我会把它总结起来。"}, {"type": "subtitle", "time": 20251.75, "timestamp": "05:37:31", "text": "现在就下午6点了。我"}, {"type": "subtitle", "time": 20254.628, "timestamp": "05:37:34", "text": "差点说是早上6点。我的天哪。是的，"}, {"type": "subtitle", "time": 20257.59, "timestamp": "05:37:37", "text": "今天的直播很愉快。所以让我们感谢"}, {"type": "subtitle", "time": 20260.39, "timestamp": "05:37:40", "text": "今天所有来过的人"}, {"type": "subtitle", "time": 20263.19, "timestamp": "05:37:43", "text": "溪流。你好。"}, {"type": "subtitle", "time": 20265.11, "timestamp": "05:37:45", "text": "首先，第一个路过的人"}, {"type": "subtitle", "time": 20271.59, "timestamp": "05:37:51", "text": "感谢您今天光临。希望你喜欢"}, {"type": "subtitle", "time": 20273.83, "timestamp": "05:37:53", "text": "今天。"}, {"type": "subtitle", "time": 20276.47, "timestamp": "05:37:56", "text": "希望你喜欢。然后面包送来了。"}]
[{"type": "subtitle", "time": 19140.788, "timestamp": "05:19:00", "text": "这次你又做了什么？我做了"}, {"type": "subtitle", "time": 19142.31, "timestamp": "05:19:02", "text": "没有什么。"}, {"type": "subtitle", "time": 19144.788, "timestamp": "05:19:04", "text": "这是根据你上次谈话的内容而定的。"}, {"type": "subtitle", "time": 19147.19, "timestamp": "05:19:07", "text": "与亚马逊合作。"}, {"type": "subtitle", "time": 19148.948, "timestamp": "05:19:08", "text": "我上次和……说话是什么时候？"}, {"type": "subtitle", "time": 19153.35, "timestamp": "05:19:13", "text": "亚马逊？我觉得她私信我送了我一份礼物。"}, {"type": "subtitle", "time": 19157.51, "timestamp": "05:19:17", "text": "就像一份问候礼物，我寄了一份"}, {"type": "subtitle", "time": 19159.75, "timestamp": "05:19:19", "text": "你好，礼物回来了。我没怎么说话。"}, {"type": "subtitle", "time": 19162.868, "timestamp": "05:19:22", "text": "因为那时候我就想，呃，有"}, {"type": "subtitle", "time": 19166.39, "timestamp": "05:19:26", "text": "我发烧了，所以不能说话也不能打电话。"}, {"type": "subtitle", "time": 19168.868, "timestamp": "05:19:28", "text": "就这么多。"}, {"type": "subtitle", "time": 19171.27, "timestamp": "05:19:31", "text": "我记得当时我半睡半醒，就……"}, {"type": "subtitle", "time": 19180.15, "timestamp": "05:19:40", "text": "你多久和阿玛桑联系一次？"}, {"type": "subtitle", "time": 19181.75, "timestamp": "05:19:41", "text": "呃，"}, {"type": "subtitle", "time": 19184.15, "timestamp": "05:19:44", "text": "几乎每天都是如此。"}, {"type": "subtitle", "time": 19186.31, "timestamp": "05:19:46", "text": "等等，真的吗？"}, {"type": "subtitle", "time": 19190.708, "timestamp": "05:19:50", "text": "日语还是英语？两个都。"}]
[{"type": "subtitle", "time": 1260.23, "timestamp": "00:21:00", "text": "别杀我。孩子们，孩子们，孩子们，孩子们。"}, {"type": "subtitle", "time": 1268.789, "timestamp": "00:21:08", "text": "我还没用这个测试过串流。"}, {"type": "subtitle", "time": 1273.83, "timestamp": "00:21:13", "text": "一。是的，试试看。没关系。"}, {"type": "subtitle", "time": 1275.909, "timestamp": "00:21:15", "text": "只需进行一次取消监听直播即可。就做"}, {"type": "subtitle", "time": 1278.31, "timestamp": "00:21:18", "text": "取消流"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "或者别的什么。"}, {"type": "subtitle", "time": 1289.35, "timestamp": "00:21:29", "text": "虽然现在还为时尚早。"}, {"type": "subtitle", "time": 1319.669, "timestamp": "00:21:59", "text": "或许以后吧。我"}]
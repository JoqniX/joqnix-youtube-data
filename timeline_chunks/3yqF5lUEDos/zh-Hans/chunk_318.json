[{"type": "subtitle", "time": 19081.19, "timestamp": "05:18:01", "text": "嗯，存档。可能有一点点。六。"}, {"type": "subtitle", "time": 19084.708, "timestamp": "05:18:04", "text": "让我看看我有多少游戏。"}, {"type": "subtitle", "time": 19087.27, "timestamp": "05:18:07", "text": "好的。那一定意味着你有很多"}, {"type": "subtitle", "time": 19090.39, "timestamp": "05:18:10", "text": "是储物空间吗？"}, {"type": "subtitle", "time": 19093.35, "timestamp": "05:18:13", "text": "Epic Games，《Among Us》。我觉得我没有"}, {"type": "subtitle", "time": 19097.83, "timestamp": "05:18:17", "text": "是的，我不需要显卡。"}, {"type": "subtitle", "time": 19105.75, "timestamp": "05:18:25", "text": "好了，我暂时就这些了。"}, {"type": "subtitle", "time": 19121.43, "timestamp": "05:18:41", "text": "我要清理我的"}, {"type": "subtitle", "time": 19130.948, "timestamp": "05:18:50", "text": "所以我下载了最新的基因"}, {"type": "subtitle", "time": 19138.708, "timestamp": "05:18:58", "text": "啊"}]
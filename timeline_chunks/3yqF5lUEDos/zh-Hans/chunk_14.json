[{"type": "subtitle", "time": 842.31, "timestamp": "00:14:02", "text": "只工作，不玩耍。"}, {"type": "subtitle", "time": 845.59, "timestamp": "00:14:05", "text": "今天，我感到无比自豪。"}, {"type": "subtitle", "time": 848.77, "timestamp": "00:14:08", "text": "那可真是件了不起的事。"}, {"type": "subtitle", "time": 856.23, "timestamp": "00:14:16", "text": "只有两具冲锋枪击杀。我上次小便很用力"}, {"type": "subtitle", "time": 869.91, "timestamp": "00:14:29", "text": "九月。"}, {"type": "subtitle", "time": 873.269, "timestamp": "00:14:33", "text": "这是哪部动画？实际上，"}, {"type": "subtitle", "time": 875.43, "timestamp": "00:14:35", "text": "太棒了。这种模式音乐真是太棒了"}, {"type": "subtitle", "time": 881.11, "timestamp": "00:14:41", "text": "好的。全部出局。我希望爆发全面战争。"}, {"type": "subtitle", "time": 883.91, "timestamp": "00:14:43", "text": "征服。"}, {"type": "subtitle", "time": 886.949, "timestamp": "00:14:46", "text": "难度：初级。勇敢的征服。"}, {"type": "subtitle", "time": 889.03, "timestamp": "00:14:49", "text": "好的。好的。我要加载这个游戏了。"}, {"type": "subtitle", "time": 892.949, "timestamp": "00:14:52", "text": "之后我就要去遛我的猫了。一"}]
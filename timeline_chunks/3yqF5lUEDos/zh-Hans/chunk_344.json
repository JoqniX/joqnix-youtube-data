[{"type": "subtitle", "time": 20640.47, "timestamp": "05:44:00", "text": "因为就像，嗯，就像我们今天一样，我"}, {"type": "subtitle", "time": 20644.39, "timestamp": "05:44:04", "text": "读了祖基写给我的信"}, {"type": "subtitle", "time": 20647.19, "timestamp": "05:44:07", "text": "我们在里面找到的生日礼物"}, {"type": "subtitle", "time": 20649.75, "timestamp": "05:44:09", "text": "我们的老房子。不。就像……"}, {"type": "subtitle", "time": 20652.47, "timestamp": "05:44:12", "text": "那些一直渴望的人"}, {"type": "subtitle", "time": 20656.39, "timestamp": "05:44:16", "text": "玩其他游戏而不是玩这个"}, {"type": "subtitle", "time": 20658.788, "timestamp": "05:44:18", "text": "像《我的世界》和其他类似游戏"}, {"type": "subtitle", "time": 20661.43, "timestamp": "05:44:21", "text": "低端游戏简直就像"}, {"type": "subtitle", "time": 20664.948, "timestamp": "05:44:24", "text": "Arsuchama 和 Zuki。是的，Arsucha 和"}, {"type": "subtitle", "time": 20669.59, "timestamp": "05:44:29", "text": "Zuki 和其他几个人也是，因为……总有一天"}, {"type": "subtitle", "time": 20672.23, "timestamp": "05:44:32", "text": "呃，当你终于得到一套好的系统时"}, {"type": "subtitle", "time": 20674.15, "timestamp": "05:44:34", "text": "现在我们可以玩了。没有"}, {"type": "subtitle", "time": 20676.788, "timestamp": "05:44:36", "text": "局限性。没有限制"}, {"type": "subtitle", "time": 20679.27, "timestamp": "05:44:39", "text": "东西。我们可以玩任何游戏"}, {"type": "subtitle", "time": 20682.708, "timestamp": "05:44:42", "text": "想。无论我们想要什么类型的东西"}, {"type": "subtitle", "time": 20686.47, "timestamp": "05:44:46", "text": "没问题，我们能做到。是的，我是"}, {"type": "subtitle", "time": 20691.27, "timestamp": "05:44:51", "text": "终于可以高兴了，嗯，我终于可以了"}, {"type": "subtitle", "time": 20693.27, "timestamp": "05:44:53", "text": "终于可以玩其他类型的游戏了"}, {"type": "subtitle", "time": 20695.35, "timestamp": "05:44:55", "text": "还有一些其他的东西。"}, {"type": "subtitle", "time": 20698.15, "timestamp": "05:44:58", "text": "是的，我会等着。"}]
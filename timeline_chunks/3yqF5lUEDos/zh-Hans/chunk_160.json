[{"type": "subtitle", "time": 9600.469, "timestamp": "02:40:00", "text": "所以，我们要回到开头了。"}, {"type": "subtitle", "time": 9606.469, "timestamp": "02:40:06", "text": "服务器。是的。过来。我们走吧。 NBC。"}, {"type": "subtitle", "time": 9609.349, "timestamp": "02:40:09", "text": "是的，那是我们最近一次做的。是的，"}, {"type": "subtitle", "time": 9611.429, "timestamp": "02:40:11", "text": "我们以前是这样。这是开始"}, {"type": "subtitle", "time": 9613.11, "timestamp": "02:40:13", "text": "服务器。"}, {"type": "subtitle", "time": 9615.03, "timestamp": "02:40:15", "text": "是的。这就是我们开始的地方。"}, {"type": "subtitle", "time": 9617.11, "timestamp": "02:40:17", "text": "服务器。我先开始的。"}, {"type": "subtitle", "time": 9621.75, "timestamp": "02:40:21", "text": "是的。我的天啊。我们买了这些"}, {"type": "subtitle", "time": 9625.03, "timestamp": "02:40:25", "text": "等等，祖基当时也在场吗？"}, {"type": "subtitle", "time": 9627.99, "timestamp": "02:40:27", "text": "是的，祖基当时也在场。是的，她确实出演了。"}, {"type": "subtitle", "time": 9630.309, "timestamp": "02:40:30", "text": "在服务器上。是的，很久以前了。是的。"}, {"type": "subtitle", "time": 9632.71, "timestamp": "02:40:32", "text": "是的。是的。我的天啊。你有你的"}, {"type": "subtitle", "time": 9635.75, "timestamp": "02:40:35", "text": "你知道，就是标题。好的，这些是"}, {"type": "subtitle", "time": 9637.429, "timestamp": "02:40:37", "text": "采矿相关的东西。这是主要"}, {"type": "subtitle", "time": 9639.75, "timestamp": "02:40:39", "text": "入口。是的。"}, {"type": "subtitle", "time": 9642.71, "timestamp": "02:40:42", "text": "我的天啊。他们应该在那里用一些。"}, {"type": "subtitle", "time": 9644.71, "timestamp": "02:40:44", "text": "我们这里有很多东西。一些"}, {"type": "subtitle", "time": 9648.15, "timestamp": "02:40:48", "text": "镐。哦，怪物猎人。你杀了"}, {"type": "subtitle", "time": 9650.63, "timestamp": "02:40:50", "text": "一。你杀了什么？我杀了一个人"}, {"type": "subtitle", "time": 9654.469, "timestamp": "02:40:54", "text": "一个骷髅正往那边看。"}, {"type": "subtitle", "time": 9658.469, "timestamp": "02:40:58", "text": "我懂了。我当时想，为什么，为什么我要留着你？"}]
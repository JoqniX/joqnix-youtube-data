[{"type": "subtitle", "time": 10809.51, "timestamp": "03:00:09", "text": "呃，"}, {"type": "subtitle", "time": 10811.19, "timestamp": "03:00:11", "text": "好的。我就在附近。我这就去拿"}, {"type": "subtitle", "time": 10813.11, "timestamp": "03:00:13", "text": "拿着镐下来。坠落。"}, {"type": "subtitle", "time": 10817.429, "timestamp": "03:00:17", "text": "你是谁？我和你一样，都想参加。什么？"}, {"type": "subtitle", "time": 10825.11, "timestamp": "03:00:25", "text": "以防万一，带上镐子。那是"}, {"type": "subtitle", "time": 10828.79, "timestamp": "03:00:28", "text": "服务器里还剩下那么多钻石。"}, {"type": "subtitle", "time": 10830.79, "timestamp": "03:00:30", "text": "我的天啊。"}, {"type": "subtitle", "time": 10834.07, "timestamp": "03:00:34", "text": "呃，我的钻石都在末影箱里。"}, {"type": "subtitle", "time": 10839.59, "timestamp": "03:00:39", "text": "我从来没检查过我这边。哦，等等。绝不"}, {"type": "subtitle", "time": 10842.389, "timestamp": "03:00:42", "text": "头脑。它不会在那里。"}, {"type": "subtitle", "time": 10846.469, "timestamp": "03:00:46", "text": "这就是……这个地方。好的，"}, {"type": "subtitle", "time": 10848.79, "timestamp": "03:00:48", "text": "我们还是别谈这个了。"}, {"type": "subtitle", "time": 10852.469, "timestamp": "03:00:52", "text": "等你回来后我给你看。你好。我是"}, {"type": "subtitle", "time": 10859.11, "timestamp": "03:00:59", "text": "电话。电话。我来了。你"}]
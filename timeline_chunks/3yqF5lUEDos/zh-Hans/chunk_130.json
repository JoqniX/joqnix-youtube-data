[{"type": "subtitle", "time": 7801.99, "timestamp": "02:10:01", "text": "那个游戏应该是由……玩的"}, {"type": "subtitle", "time": 7804.149, "timestamp": "02:10:04", "text": "像您这样的人，梅西小姐。我猜"}, {"type": "subtitle", "time": 7807.109, "timestamp": "02:10:07", "text": "这种情况也可能发生在你身上。是的，"}, {"type": "subtitle", "time": 7809.51, "timestamp": "02:10:09", "text": "莎莉。是的，"}, {"type": "subtitle", "time": 7812.709, "timestamp": "02:10:12", "text": "我做了关于误会的梦，梦境很详细。"}, {"type": "subtitle", "time": 7816.47, "timestamp": "02:10:16", "text": "所以，我看过Markiplier的表演，"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "是 Markiplier Jaccept 扮演的那个人吗？"}, {"type": "subtitle", "time": 7823.51, "timestamp": "02:10:23", "text": "游戏？然后我看了《Mow's Mow's》。"}, {"type": "subtitle", "time": 7827.27, "timestamp": "02:10:27", "text": "我玩了这款游戏，也玩了别人的游戏。"}, {"type": "subtitle", "time": 7829.35, "timestamp": "02:10:29", "text": "就像"}, {"type": "subtitle", "time": 7831.91, "timestamp": "02:10:31", "text": "当天"}, {"type": "subtitle", "time": 7835.669, "timestamp": "02:10:35", "text": "呃，那是深入的梦境，与众不同。"}, {"type": "subtitle", "time": 7838.39, "timestamp": "02:10:38", "text": "不同的生死情景"}, {"type": "subtitle", "time": 7840.79, "timestamp": "02:10:40", "text": "以及所有的一切。你应该做的一切"}, {"type": "subtitle", "time": 7843.189, "timestamp": "02:10:43", "text": "完成 DDLC。是的，这肯定会发生。"}, {"type": "subtitle", "time": 7845.51, "timestamp": "02:10:45", "text": "本星期。呃，我们会做DLC的。"}, {"type": "subtitle", "time": 7847.27, "timestamp": "02:10:47", "text": "精加工。"}, {"type": "subtitle", "time": 7851.35, "timestamp": "02:10:51", "text": "我的神秘嘉宾就是我的神秘嘉宾"}, {"type": "subtitle", "time": 7854.95, "timestamp": "02:10:54", "text": "本周的DLC仍然是……"}, {"type": "subtitle", "time": 7857.99, "timestamp": "02:10:57", "text": "秘密。所以，是的，在那之后我在想"}]
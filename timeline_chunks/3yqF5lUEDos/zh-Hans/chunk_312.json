[{"type": "subtitle", "time": 18723.11, "timestamp": "05:12:03", "text": "黑暗是纯粹的，就这么说吧。现在黑暗笼罩着一切。"}, {"type": "subtitle", "time": 18725.74, "timestamp": "05:12:05", "text": "纯粹而神奇。"}, {"type": "subtitle", "time": 18726.948, "timestamp": "05:12:06", "text": "[音乐]"}, {"type": "subtitle", "time": 18729.75, "timestamp": "05:12:09", "text": "是的。他会变成那样。他将"}, {"type": "subtitle", "time": 18733.67, "timestamp": "05:12:13", "text": "永远如此。无论在什么"}, {"type": "subtitle", "time": 18735.99, "timestamp": "05:12:15", "text": "书籍史"}, {"type": "subtitle", "time": 18740.47, "timestamp": "05:12:20", "text": "在他的百科全书中是这样写的。"}, {"type": "subtitle", "time": 18742.788, "timestamp": "05:12:22", "text": "但我会这么说。"}, {"type": "subtitle", "time": 18753.11, "timestamp": "05:12:33", "text": "[笑声]"}, {"type": "subtitle", "time": 18762.47, "timestamp": "05:12:42", "text": "你说的听起来确实如此。"}, {"type": "subtitle", "time": 18775.51, "timestamp": "05:12:55", "text": "你好。"}]
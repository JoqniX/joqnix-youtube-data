[{"type": "subtitle", "time": 7920.72, "timestamp": "02:12:00", "text": "乐趣。真的很有趣。是的，"}, {"type": "subtitle", "time": 7922.149, "timestamp": "02:12:02", "text": "[音乐]"}, {"type": "subtitle", "time": 7924.069, "timestamp": "02:12:04", "text": "我们正在讨论他的资金来源"}, {"type": "subtitle", "time": 7930.31, "timestamp": "02:12:10", "text": "这很重要"}, {"type": "subtitle", "time": 7933.03, "timestamp": "02:12:13", "text": "你的巴卡快乐在于学习如何成为"}, {"type": "subtitle", "time": 7937.589, "timestamp": "02:12:17", "text": "迅速且使用词语"}, {"type": "subtitle", "time": 7957.99, "timestamp": "02:12:37", "text": "所以关于Valerant的更新……"}, {"type": "subtitle", "time": 7960.069, "timestamp": "02:12:40", "text": "气球锦标赛。"}, {"type": "subtitle", "time": 7963.35, "timestamp": "02:12:43", "text": "所以，气球锦标赛取消了。"}, {"type": "subtitle", "time": 7967.75, "timestamp": "02:12:47", "text": "本月。这件事发生在1月份。"}, {"type": "subtitle", "time": 7971.589, "timestamp": "02:12:51", "text": "1月16日或17日。所以我弄到了一些"}, {"type": "subtitle", "time": 7973.35, "timestamp": "02:12:53", "text": "距离我拿到采集卡还有一段时间"}, {"type": "subtitle", "time": 7974.95, "timestamp": "02:12:54", "text": "一切。"}, {"type": "subtitle", "time": 7977.589, "timestamp": "02:12:57", "text": "祈祷我能拿到采集卡"}]
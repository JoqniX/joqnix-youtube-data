[{"type": "subtitle", "time": 13143.03, "timestamp": "03:39:03", "text": "我觉得那是他的，还是为了塑形？"}, {"type": "subtitle", "time": 13145.5, "timestamp": "03:39:05", "text": "我不知道。"}, {"type": "subtitle", "time": 13155.19, "timestamp": "03:39:15", "text": "等等，这个游戏里有狼吗？"}, {"type": "subtitle", "time": 13157.03, "timestamp": "03:39:17", "text": "我有一份完整的报告。我只是"}, {"type": "subtitle", "time": 13161.349, "timestamp": "03:39:21", "text": "只是想表达一下这个意思。哦，"}, {"type": "subtitle", "time": 13163.269, "timestamp": "03:39:23", "text": "好的。我们该如何才能做到？好吧，从"}, {"type": "subtitle", "time": 13169.269, "timestamp": "03:39:29", "text": "你从哪里掉下来的？哪一边？我"}, {"type": "subtitle", "time": 13172.63, "timestamp": "03:39:32", "text": "正要说怎么下去。"}, {"type": "subtitle", "time": 13175.19, "timestamp": "03:39:35", "text": "我觉得你把东西弄丢了。"}, {"type": "subtitle", "time": 13181.03, "timestamp": "03:39:41", "text": "哦，等等。我……我的天哪。我当时"}, {"type": "subtitle", "time": 13185.91, "timestamp": "03:39:45", "text": "尝试按下F3键。我可以这样做吗？不。"}, {"type": "subtitle", "time": 13189.67, "timestamp": "03:39:49", "text": "不，等等。让我 让我 让我 让我 哦"}, {"type": "subtitle", "time": 13192.71, "timestamp": "03:39:52", "text": "我的上帝。我为什么会因为这件事而辞职？我的"}, {"type": "subtitle", "time": 13196.07, "timestamp": "03:39:56", "text": "名称是 Makeup online。"}, {"type": "subtitle", "time": 13197.99, "timestamp": "03:39:57", "text": "现在让我发射我的。稍等片刻。让"}]
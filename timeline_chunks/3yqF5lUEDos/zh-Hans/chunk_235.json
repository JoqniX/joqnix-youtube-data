[{"type": "subtitle", "time": 14102.389, "timestamp": "03:55:02", "text": "是啊，就像我溺水一样"}, {"type": "subtitle", "time": 14104.63, "timestamp": "03:55:04", "text": "然后我想起来，因为……你不能再这样做了"}, {"type": "subtitle", "time": 14115.67, "timestamp": "03:55:15", "text": "还有公寓电力方面的问题，"}, {"type": "subtitle", "time": 14117.269, "timestamp": "03:55:17", "text": "我们可以？"}, {"type": "subtitle", "time": 14125.189, "timestamp": "03:55:25", "text": "哦，他去世了。好的。"}, {"type": "subtitle", "time": 14143.83, "timestamp": "03:55:43", "text": "好的。曾有那么一段时间，"}, {"type": "subtitle", "time": 14147.269, "timestamp": "03:55:47", "text": "你恨透了Neo Chan，你杀了Neo。"}, {"type": "subtitle", "time": 14152.229, "timestamp": "03:55:52", "text": "陈。你还记得这件事吗？我想我的确如此"}, {"type": "subtitle", "time": 14154.229, "timestamp": "03:55:54", "text": "不清楚。"}, {"type": "subtitle", "time": 14158.15, "timestamp": "03:55:58", "text": "我的天啊。是的。每次我都像这样"}, {"type": "subtitle", "time": 14159.83, "timestamp": "03:55:59", "text": "看"}]
[{"type": "subtitle", "time": 19924.15, "timestamp": "05:32:04", "text": "梦？我的天啊。不。"}, {"type": "subtitle", "time": 19928.23, "timestamp": "05:32:08", "text": "我想让别人掐我一下。等待。"}, {"type": "subtitle", "time": 19931.51, "timestamp": "05:32:11", "text": "好的。这不是梦。"}, {"type": "subtitle", "time": 19939.59, "timestamp": "05:32:19", "text": "我的天啊。"}, {"type": "subtitle", "time": 19944.788, "timestamp": "05:32:24", "text": "好吧，那就去吧。我很期待。"}, {"type": "subtitle", "time": 19948.628, "timestamp": "05:32:28", "text": "你好。你也快要结束了。你好。"}, {"type": "subtitle", "time": 19950.23, "timestamp": "05:32:30", "text": "是什么"}, {"type": "subtitle", "time": 19953.27, "timestamp": "05:32:33", "text": "今天？真的很有趣。而对于那些"}, {"type": "subtitle", "time": 19955.83, "timestamp": "05:32:35", "text": "不知道，这是我们的第一次"}, {"type": "subtitle", "time": 19958.628, "timestamp": "05:32:38", "text": "可以说是官方的一次合作，但是……"}, {"type": "subtitle", "time": 19966.07, "timestamp": "05:32:46", "text": "是的。"}, {"type": "subtitle", "time": 19968.948, "timestamp": "05:32:48", "text": "很有趣。"}, {"type": "subtitle", "time": 19972.31, "timestamp": "05:32:52", "text": "我的意思是，我经常和你们一起参加风险投资。"}, {"type": "subtitle", "time": 19975.03, "timestamp": "05:32:55", "text": "游戏画面"}, {"type": "subtitle", "time": 19977.59, "timestamp": "05:32:57", "text": "还有一些其他的东西。对，那些就像挂起来一样。"}, {"type": "subtitle", "time": 19979.27, "timestamp": "05:32:59", "text": "出去。"}]
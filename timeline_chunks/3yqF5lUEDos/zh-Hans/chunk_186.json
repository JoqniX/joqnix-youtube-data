[{"type": "subtitle", "time": 11160.469, "timestamp": "03:06:00", "text": "哦，不过我有一把铲子。除非谢谢"}, {"type": "subtitle", "time": 11163.429, "timestamp": "03:06:03", "text": "你拿斧头。"}, {"type": "subtitle", "time": 11182.23, "timestamp": "03:06:22", "text": "[音乐]"}, {"type": "subtitle", "time": 11184.79, "timestamp": "03:06:24", "text": "哦，不。"}, {"type": "subtitle", "time": 11193.269, "timestamp": "03:06:33", "text": "好了，回总部去吧。"}, {"type": "subtitle", "time": 11212.15, "timestamp": "03:06:52", "text": "那是一只乌龟。等等，那是只乌龟吗？"}, {"type": "subtitle", "time": 11214.95, "timestamp": "03:06:54", "text": "那是一只乌龟。是的。"}, {"type": "subtitle", "time": 11217.03, "timestamp": "03:06:57", "text": "等等，这是什么玩意儿？"}]
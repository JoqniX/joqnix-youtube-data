[{"type": "subtitle", "time": 15365.349, "timestamp": "04:16:05", "text": "等等，不对。呃，"}, {"type": "subtitle", "time": 15367.83, "timestamp": "04:16:07", "text": "我正站在这个怪物生成器上面"}, {"type": "subtitle", "time": 15371.51, "timestamp": "04:16:11", "text": "事物。我这就回宅邸。"}, {"type": "subtitle", "time": 15373.51, "timestamp": "04:16:13", "text": "哦，是的。这是你的发明，"}, {"type": "subtitle", "time": 15376.63, "timestamp": "04:16:16", "text": "正确的？奶牛场"}, {"type": "subtitle", "time": 15380.469, "timestamp": "04:16:20", "text": "还有农场。是的，"}, {"type": "subtitle", "time": 15383.03, "timestamp": "04:16:23", "text": "村民那个东西。就在这里，"}, {"type": "subtitle", "time": 15385.03, "timestamp": "04:16:25", "text": "正确的？"}, {"type": "subtitle", "time": 15388.55, "timestamp": "04:16:28", "text": "隐秘村庄在哪里？"}, {"type": "subtitle", "time": 15391.429, "timestamp": "04:16:31", "text": "谈判地点？"}, {"type": "subtitle", "time": 15395.51, "timestamp": "04:16:35", "text": "啊，这个地方。是的。对，就是这个。"}, {"type": "subtitle", "time": 15397.59, "timestamp": "04:16:37", "text": "这就是我治好这只母狗的地方，或者"}, {"type": "subtitle", "time": 15401.51, "timestamp": "04:16:41", "text": "某物。我记得。是的。哦，是的。"}, {"type": "subtitle", "time": 15403.99, "timestamp": "04:16:43", "text": "那是铁路的东西。你是否记得"}, {"type": "subtitle", "time": 15407.75, "timestamp": "04:16:47", "text": "它？哦，我们走吧，耶，我们走吧"}, {"type": "subtitle", "time": 15411.269, "timestamp": "04:16:51", "text": "那里。是的。是的。"}, {"type": "subtitle", "time": 15418.55, "timestamp": "04:16:58", "text": "[音乐]"}]
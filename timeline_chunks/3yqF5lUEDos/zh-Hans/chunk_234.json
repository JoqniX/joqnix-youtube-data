[{"type": "subtitle", "time": 14041.67, "timestamp": "03:54:01", "text": "是的。我记得我用过你家"}, {"type": "subtitle", "time": 14044.71, "timestamp": "03:54:04", "text": "作为床的传送点"}, {"type": "subtitle", "time": 14047.75, "timestamp": "03:54:07", "text": "我以前经常探索这些东西。"}, {"type": "subtitle", "time": 14050.71, "timestamp": "03:54:10", "text": "郊区。"}, {"type": "subtitle", "time": 14053.349, "timestamp": "03:54:13", "text": "是的。"}, {"type": "subtitle", "time": 14065.67, "timestamp": "03:54:25", "text": "有什么我想做的吗？"}, {"type": "subtitle", "time": 14067.91, "timestamp": "03:54:27", "text": "或者我们可以讨论一会儿。"}, {"type": "subtitle", "time": 14069.67, "timestamp": "03:54:29", "text": "然后"}, {"type": "subtitle", "time": 14072.95, "timestamp": "03:54:32", "text": "游戏要结束了吗？是的，我们也可以这样做"}, {"type": "subtitle", "time": 14078.07, "timestamp": "03:54:38", "text": "好的。"}, {"type": "subtitle", "time": 14082.55, "timestamp": "03:54:42", "text": "是的，我同意，我们约好在Okay见面。"}, {"type": "subtitle", "time": 14084.229, "timestamp": "03:54:44", "text": "大厦。"}, {"type": "subtitle", "time": 14089.189, "timestamp": "03:54:49", "text": "糟糕。没错，那是一场混战。你知道的"}, {"type": "subtitle", "time": 14095.51, "timestamp": "03:54:55", "text": "溺水。"}, {"type": "subtitle", "time": 14099.03, "timestamp": "03:54:59", "text": "是的，我以前会死。"}]
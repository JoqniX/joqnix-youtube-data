[{"type": "subtitle", "time": 17642.31, "timestamp": "04:54:02", "text": "类似正常的情况"}, {"type": "subtitle", "time": 17645.27, "timestamp": "04:54:05", "text": "战士化身为魔王化身"}, {"type": "subtitle", "time": 17647.43, "timestamp": "04:54:07", "text": "一千级或者更高，甚至更高"}, {"type": "subtitle", "time": 17650.47, "timestamp": "04:54:10", "text": "那种强大的力量，所以我一直这么说。"}, {"type": "subtitle", "time": 17655.03, "timestamp": "04:54:15", "text": "头像而不是别名，我的天哪"}, {"type": "subtitle", "time": 17657.91, "timestamp": "04:54:17", "text": "哦，我看到了，他们简直不敢相信"}, {"type": "subtitle", "time": 17661.91, "timestamp": "04:54:21", "text": "是一个非常古老的公告渠道，例如"}, {"type": "subtitle", "time": 17664.788, "timestamp": "04:54:24", "text": "7 920 2021。"}, {"type": "subtitle", "time": 17667.43, "timestamp": "04:54:27", "text": "是的，两年前。规则列表和"}, {"type": "subtitle", "time": 17669.19, "timestamp": "04:54:29", "text": "KA玩家须知"}, {"type": "subtitle", "time": 17671.43, "timestamp": "04:54:31", "text": "我的世界服务器。"}, {"type": "subtitle", "time": 17674.628, "timestamp": "04:54:34", "text": "啊，要善待他人。"}, {"type": "subtitle", "time": 17677.27, "timestamp": "04:54:37", "text": "其次，你为什么不问问其他人呢？"}, {"type": "subtitle", "time": 17679.35, "timestamp": "04:54:39", "text": "不知道是谁发的这条消息？"}, {"type": "subtitle", "time": 17685.19, "timestamp": "04:54:45", "text": "我的天啊。打造你想要的一切，但要创造"}, {"type": "subtitle", "time": 17687.11, "timestamp": "04:54:47", "text": "请确保不要使用别人的版本。"}, {"type": "subtitle", "time": 17689.11, "timestamp": "04:54:49", "text": "用类似的东西制造糟糕的效果"}, {"type": "subtitle", "time": 17690.868, "timestamp": "04:54:50", "text": "他们的体型与他们不符"}, {"type": "subtitle", "time": 17693.43, "timestamp": "04:54:53", "text": "与当地环境相协调。"}, {"type": "subtitle", "time": 17695.19, "timestamp": "04:54:55", "text": "我的天啊。然后还要确保"}, {"type": "subtitle", "time": 17697.67, "timestamp": "04:54:57", "text": "选择合适的地点进行搭建。"}, {"type": "subtitle", "time": 17699.59, "timestamp": "04:54:59", "text": "在你的建筑周围留出一些空地。"}]
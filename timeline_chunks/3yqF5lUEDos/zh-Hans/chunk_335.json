[{"type": "subtitle", "time": 20100.15, "timestamp": "05:35:00", "text": "你是如何结束的？你好。你好。我也包"}, {"type": "subtitle", "time": 20102.948, "timestamp": "05:35:02", "text": "向上"}, {"type": "subtitle", "time": 20106.39, "timestamp": "05:35:06", "text": "沙。呃，我的下一次直播将在……"}, {"type": "subtitle", "time": 20108.548, "timestamp": "05:35:08", "text": "明天。明天我们要比赛……"}, {"type": "subtitle", "time": 20111.51, "timestamp": "05:35:11", "text": "我们刚才玩的是什么来着？我的天啊。嗯"}, {"type": "subtitle", "time": 20114.07, "timestamp": "05:35:14", "text": "我忘了上帝。呃，明天我们是"}, {"type": "subtitle", "time": 20117.03, "timestamp": "05:35:17", "text": "玩的游戏，呃，我想应该是原神吧。"}, {"type": "subtitle", "time": 20119.67, "timestamp": "05:35:19", "text": "影响。"}, {"type": "subtitle", "time": 20122.31, "timestamp": "05:35:22", "text": "是的，我玩了一会儿就又玩了一遍。"}, {"type": "subtitle", "time": 20125.75, "timestamp": "05:35:25", "text": "大概是今年吧。一年"}, {"type": "subtitle", "time": 20128.23, "timestamp": "05:35:28", "text": "三到四个月。是的。是的。是的。"}, {"type": "subtitle", "time": 20131.43, "timestamp": "05:35:31", "text": "我的天啊。疼痛。"}, {"type": "subtitle", "time": 20133.43, "timestamp": "05:35:33", "text": "你好。我们将在之后触摸源神"}, {"type": "subtitle", "time": 20135.43, "timestamp": "05:35:35", "text": "很久。"}, {"type": "subtitle", "time": 20137.43, "timestamp": "05:35:37", "text": "好的。请随时让我发言。"}, {"type": "subtitle", "time": 20139.83, "timestamp": "05:35:39", "text": "艺术家。"}, {"type": "subtitle", "time": 20142.628, "timestamp": "05:35:42", "text": "是的。可以，你可以过来。我会"}, {"type": "subtitle", "time": 20144.548, "timestamp": "05:35:44", "text": "主要目的是完成艾恩任务"}, {"type": "subtitle", "time": 20148.31, "timestamp": "05:35:48", "text": "一切都安排妥当，这样我就可以去方廷了。"}, {"type": "subtitle", "time": 20150.628, "timestamp": "05:35:50", "text": "所以，好吧，你可以去方丹"}, {"type": "subtitle", "time": 20153.75, "timestamp": "05:35:53", "text": "没有杀戮，但是，是的，你的哦，你"}, {"type": "subtitle", "time": 20158.15, "timestamp": "05:35:58", "text": "能。哦。哦，是的。好的。好的。然后我会"}]
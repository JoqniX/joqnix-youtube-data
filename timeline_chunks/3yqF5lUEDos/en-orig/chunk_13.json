[{"type": "subtitle", "time": 811.75, "timestamp": "00:13:31", "text": "You did not just do that, kid. You"}, {"type": "subtitle", "time": 814.87, "timestamp": "00:13:34", "text": "child. Oh my."}, {"type": "subtitle", "time": 816.87, "timestamp": "00:13:36", "text": "Killed me."}, {"type": "subtitle", "time": 819.19, "timestamp": "00:13:39", "text": "Wayne,"}, {"type": "subtitle", "time": 822.15, "timestamp": "00:13:42", "text": "can I get over here in combat? Please"}, {"type": "subtitle", "time": 823.43, "timestamp": "00:13:43", "text": "don't die. Please don't die. Please"}, {"type": "subtitle", "time": 829.03, "timestamp": "00:13:49", "text": "don't die. Our tactics were superior to"}, {"type": "subtitle", "time": 832.31, "timestamp": "00:13:52", "text": "theirs. Victory is ours."}]
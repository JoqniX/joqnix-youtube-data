[{"type": "subtitle", "time": 24183.27, "timestamp": "06:43:03", "text": "And also I like this character too."}, {"type": "subtitle", "time": 24185.13, "timestamp": "06:43:05", "text": "This one."}, {"type": "subtitle", "time": 24197.91, "timestamp": "06:43:17", "text": "Uh, what was I doing?"}, {"type": "subtitle", "time": 24200.548, "timestamp": "06:43:20", "text": "Hogwatch."}, {"type": "subtitle", "time": 24203.03, "timestamp": "06:43:23", "text": "By the way, do you have short hair? Oh,"}, {"type": "subtitle", "time": 24207.19, "timestamp": "06:43:27", "text": "yeah. Long. You tied it up, huh?"}, {"type": "subtitle", "time": 24208.708, "timestamp": "06:43:28", "text": "If you had short hair, I would have"}, {"type": "subtitle", "time": 24210.948, "timestamp": "06:43:30", "text": "called you my ultimate waifu and"}, {"type": "subtitle", "time": 24224.468, "timestamp": "06:43:44", "text": "Shall we go? Boom. Boom. Boom. Boom."}, {"type": "subtitle", "time": 24226.788, "timestamp": "06:43:46", "text": "Think he saw it happen, do you? Of"}, {"type": "subtitle", "time": 24228.39, "timestamp": "06:43:48", "text": "course he did. Why else would he have"}, {"type": "subtitle", "time": 24231.43, "timestamp": "06:43:51", "text": "run? He's just a child. We should"}, {"type": "subtitle", "time": 24234.468, "timestamp": "06:43:54", "text": "release decide what to do with him once"}, {"type": "subtitle", "time": 24236.02, "timestamp": "06:43:56", "text": "he gets back."}]
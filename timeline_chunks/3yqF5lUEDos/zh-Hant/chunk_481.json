[{"type": "subtitle", "time": 28873.11, "timestamp": "08:01:13", "text": "嗯，不。我不擅長讀那部三部曲。"}, {"type": "subtitle", "time": 28877.99, "timestamp": "08:01:17", "text": "呃，拿出你"}, {"type": "subtitle", "time": 28881.75, "timestamp": "08:01:21", "text": "最好的表現吧"}, {"type": "subtitle", "time": 28892.628, "timestamp": "08:01:32", "text": "這簡直是痛。不。好吧，行。"}, {"type": "subtitle", "time": 28904.788, "timestamp": "08:01:44", "text": "我放棄。我了解的不多"}, {"type": "subtitle", "time": 28909.75, "timestamp": "08:01:49", "text": "。好的。"}]
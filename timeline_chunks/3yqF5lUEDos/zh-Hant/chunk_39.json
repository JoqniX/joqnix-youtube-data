[{"type": "subtitle", "time": 2340.95, "timestamp": "00:39:00", "text": "我的天哪"}, {"type": "subtitle", "time": 2343.589, "timestamp": "00:39:03", "text": "。  敵方正在"}, {"type": "subtitle", "time": 2345.03, "timestamp": "00:39:05", "text": "攻擊我方目標之一"}, {"type": "subtitle", "time": 2347.109, "timestamp": "00:39:07", "text": "。  仍在堅持，而且很堅強。  死亡工作。  好的。"}, {"type": "subtitle", "time": 2355.91, "timestamp": "00:39:15", "text": "敵對勢力正試圖奪取我們的一個目標。  重新加載。  敵軍遭受重創。他們會繼續來的。  我們已經失去了對目標的控制。  敵方佔領"}]
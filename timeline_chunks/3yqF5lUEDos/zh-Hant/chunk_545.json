[{"type": "subtitle", "time": 32711.43, "timestamp": "09:05:11", "text": "這應該是四。我真笨。好的，我明白了。"}, {"type": "subtitle", "time": 32718.708, "timestamp": "09:05:18", "text": "解鎖了秘密通道。豬的秘密。"}, {"type": "subtitle", "time": 32732.708, "timestamp": "09:05:32", "text": "你好嗎？什麼？我想知道孟加拉。我不知道該怎麼辦。嗯？好的。明白了。明白了箱子。 [音樂] 我搞定了。我的滑鼠在亂跳。別亂跳了。"}, {"type": "subtitle", "time": 32742.388, "timestamp": "09:05:42", "text": "哦，我的滑鼠有時候會亂跳。我只是……"}, {"type": "subtitle", "time": 32745.75, "timestamp": "09:05:45", "text": "你好。你會跌倒"}]
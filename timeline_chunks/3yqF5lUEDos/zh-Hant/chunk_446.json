[{"type": "subtitle", "time": 26761.27, "timestamp": "07:26:01", "text": "我希望你是對的。我打敗了她。走吧。殺人不眨眼。"}, {"type": "subtitle", "time": 26781.67, "timestamp": "07:26:21", "text": "我比你快。石頭。我的天哪。我比你快。她在哪裡？嗯？"}, {"type": "subtitle", "time": 26813.83, "timestamp": "07:26:53", "text": "什麼？你怎麼上去的？狼群，準備戰鬥。狼。我來了。我的天哪。啊，我受傷了"}]
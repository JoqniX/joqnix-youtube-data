[{"type": "subtitle", "time": 23642.948, "timestamp": "06:34:02", "text": "交到一位印尼朋友"}, {"type": "subtitle", "time": 23646.07, "timestamp": "06:34:06", "text": "。我已經數不清"}, {"type": "subtitle", "time": 23654.468, "timestamp": "06:34:14", "text": "我有多少國際朋友了，因為這其中既包括一些印尼觀眾和聽眾，也包括我透過 Kusan 認識的 BTuber 朋友。是的，那裡有一些印尼虛擬主播。我忘了。是的，非常感謝"}, {"type": "subtitle", "time": 23657.35, "timestamp": "06:34:17", "text": "您能來。希望你喜歡我的兩次直播。  是的"}, {"type": "subtitle", "time": 23673.75, "timestamp": "06:34:33", "text": "，感謝羅伯特傑克森的光臨。  謝謝。看來你又在用這個笑話了。我的意思是，沒關係。嗯，我已經解釋過了，但是你們羅伯特·傑克遜的粉絲"}, {"type": "subtitle", "time": 23695.83, "timestamp": "06:34:55", "text": "團都用這個名字，"}]
[{"type": "subtitle", "time": 11280.23, "timestamp": "03:08:00", "text": "如何才能登上頂峰呢？哦，是的"}, {"type": "subtitle", "time": 11288.63, "timestamp": "03:08:08", "text": "。  對"}, {"type": "subtitle", "time": 11291.67, "timestamp": "03:08:11", "text": "，就在這裡。是的"}, {"type": "subtitle", "time": 11293.99, "timestamp": "03:08:13", "text": "。有個骷髏在朝我開槍。  等等，什麼？  是的，我目前處於"}, {"type": "subtitle", "time": 11302.79, "timestamp": "03:08:22", "text": "領先地位。  我們在樹頂上。是啊，我好像被某個骷髏射殺了。  嗯？哦，"}, {"type": "subtitle", "time": 11326.95, "timestamp": "03:08:46", "text": "瞧。  或許是在水裡。我沒有弓。我沒有箭。"}, {"type": "subtitle", "time": 11334.79, "timestamp": "03:08:54", "text": "哦，我只有弓。  好的，"}, {"type": "subtitle", "time": 11338.23, "timestamp": "03:08:58", "text": "我馬上就來。  哦，下來吧。  在這裡，我站在頂峰。在樹頂上。"}]
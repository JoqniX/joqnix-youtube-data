[{"type": "subtitle", "time": 25816.15, "timestamp": "07:10:16", "text": "不，"}, {"type": "subtitle", "time": 25819.35, "timestamp": "07:10:19", "text": "我只是說，你知道，這有利於安全。你永遠"}, {"type": "subtitle", "time": 25824.708, "timestamp": "07:10:24", "text": "不知道會不會有小偷或什麼人趁你不注意偷了你的錢包之類的，"}, {"type": "subtitle", "time": 25830.31, "timestamp": "07:10:30", "text": "但當你發現他，抓住他，你就可以用你學過的空手道技巧製服他。所以我"}, {"type": "subtitle", "time": 25838.708, "timestamp": "07:10:38", "text": "覺得這就是它好的地方。它有利於你的安全。有利於安全。好了，夠了，別再說這些蠢話了。現在"}]
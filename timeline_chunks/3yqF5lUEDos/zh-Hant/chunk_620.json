[{"type": "subtitle", "time": 37231.426, "timestamp": "10:20:31", "text": "一個人漂浮在水面上。殺了他。"}, {"type": "subtitle", "time": 37233.746, "timestamp": "10:20:33", "text": "好的，HP"}, {"type": "subtitle", "time": 37240.31, "timestamp": "10:20:40", "text": "全滿。  殺了他。  還有這位倖存者。  好的。滿血。我的HP丟失了。  好，殺了他們。  殺了"}, {"type": "subtitle", "time": 37242.63, "timestamp": "10:20:42", "text": "他們。  好了，快完成了"}]
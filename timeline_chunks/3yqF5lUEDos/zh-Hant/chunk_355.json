[{"type": "subtitle", "time": 21303.03, "timestamp": "05:55:03", "text": "怎麼樣？我還是不太好。我肯定已經死了。別擔心。走了。"}, {"type": "subtitle", "time": 21312.39, "timestamp": "05:55:12", "text": "我在…VR聊天室在哪裡？對。你好，Zuki。歡迎"}, {"type": "subtitle", "time": 21324.628, "timestamp": "05:55:24", "text": "。我的天哪。我們好像在參觀那個東西。夥計，你應該早點來的。 Zuki，那些東西。孩子們還在那裡。狗狗、貓咪，還有所有人，乳牛、蘑菇"}, {"type": "subtitle", "time": 21328.868, "timestamp": "05:55:28", "text": "牛，所有人都在那裡。哦我"}, {"type": "subtitle", "time": 21331.83, "timestamp": "05:55:31", "text": "的天啊。是啊。然後我們……"}, {"type": "subtitle", "time": 21342.708, "timestamp": "05:55:42", "text": "我們探索了所有的地方，呃，我們都探索過了，然後呃，我們告別了，然後"}, {"type": "subtitle", "time": 21358.47, "timestamp": "05:55:58", "text": "呃，我們退出了遊戲。是的，玩了一會兒後我們就"}]
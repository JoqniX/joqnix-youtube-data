[{"type": "subtitle", "time": 29950.548, "timestamp": "08:19:10", "text": "，寶貝。  搜尋 Thob。我覺得他領先。  你只想看忍者嗎？  我的天啊。  我的天啊。那是一隻"}, {"type": "subtitle", "time": 29953.19, "timestamp": "08:19:13", "text": "大蜘蛛。你好。  他變小了。"}, {"type": "subtitle", "time": 29958.23, "timestamp": "08:19:18", "text": "哦。哦。我的"}, {"type": "subtitle", "time": 29963.27, "timestamp": "08:19:23", "text": "天啊。我的天啊。你想……你想……哦，我的天哪。這很難。  兄弟，這聽起來沒什麼特別的。啊"}, {"type": "subtitle", "time": 29990.708, "timestamp": "08:19:50", "text": "，我為什麼會說「兄弟」呢？我的詞彙"}]
[{"type": "subtitle", "time": 33660.07, "timestamp": "09:21:00", "text": "。一個朋友教的。"}, {"type": "subtitle", "time": 33663.266, "timestamp": "09:21:03", "text": "哦，不錯，不錯，不錯。是啊，是啊，是啊。你可以用很多OBS插件，真正自訂你的，讓它"}, {"type": "subtitle", "time": 33676.23, "timestamp": "09:21:16", "text": "更"}, {"type": "subtitle", "time": 33678.23, "timestamp": "09:21:18", "text": "輕鬆。就是那種"}, {"type": "subtitle", "time": 33680.71, "timestamp": "09:21:20", "text": "東西。 Noctua 簽的，真不錯。復仇。你的家人來過這裡。瓦礫堆成了一個人面對蛇的浮雕。"}, {"type": "subtitle", "time": 33682.71, "timestamp": "09:21:22", "text": "不錯。那一定是我聽到的聲音。揚聲器的嘴。聲音很"}, {"type": "subtitle", "time": 33694.31, "timestamp": "09:21:34", "text": "古老。你聽到一個聲音？它從你修好它的時候就開始了。"}, {"type": "subtitle", "time": 33696.71, "timestamp": "09:21:36", "text": "我聽到一個低語說：「跟我說話。」跟我說話。"}, {"type": "subtitle", "time": 33703.83, "timestamp": "09:21:43", "text": "」包裹嘴。我能聽見蛇的聲音，也能跟蛇說話。陽傘嘴，幾乎所有"}, {"type": "subtitle", "time": 33707.746, "timestamp": "09:21:47", "text": "已知的包裹嘴。哦，"}]
[{"type": "subtitle", "time": 32352.07, "timestamp": "08:59:12", "text": "太多屏幕，當你刷太多的時候。正如你所看到的，是的，它真的把它搞壞了"}, {"type": "subtitle", "time": 32365.65, "timestamp": "08:59:25", "text": "。如果刷屏太多，"}, {"type": "subtitle", "time": 32379.19, "timestamp": "08:59:39", "text": "需要一段時間才能恢復"}, {"type": "subtitle", "time": 32383.43, "timestamp": "08:59:43", "text": "。你狂發訊息。它就排到長長的隊列裡了"}]
[{"type": "subtitle", "time": 25500.868, "timestamp": "07:05:00", "text": "三趟公車才到目的地。  還有，第四個在哪裡？我找不到。  它在哪裡？"}, {"type": "subtitle", "time": 25511.75, "timestamp": "07:05:11", "text": "你躲在哪裡？  它就在我眼前。"}, {"type": "subtitle", "time": 25528.548, "timestamp": "07:05:28", "text": "還是我太笨了？我找不到。它在哪裡？"}, {"type": "subtitle", "time": 25536.23, "timestamp": "07:05:36", "text": "它在哪裡？  一二三。一二三。第四個在哪裡？我只是在找那四個人。"}, {"type": "subtitle", "time": 25541.11, "timestamp": "07:05:41", "text": "你在那裡。哦，不只四個。"}, {"type": "subtitle", "time": 25547.67, "timestamp": "07:05:47", "text": "我的天哪，不只四個。不止四個。  呃，1 2 3 4 5 4 5 6。還不夠。  六。"}]
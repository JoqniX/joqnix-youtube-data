[{"type": "subtitle", "time": 13201.91, "timestamp": "03:40:01", "text": "。是的。  不像你。"}, {"type": "subtitle", "time": 13212.469, "timestamp": "03:40:12", "text": "不，我確實拿走了，我把它放在那裡，我想更多。  天哪，這"}, {"type": "subtitle", "time": 13215.99, "timestamp": "03:40:15", "text": "亂糟糟的箱子。"}, {"type": "subtitle", "time": 13254.63, "timestamp": "03:40:54", "text": "哦是的。"}, {"type": "subtitle", "time": 13258.309, "timestamp": "03:40:58", "text": "我記得我在這裡丟掉了所有東西，甚至包括我的伊萊克特拉轎車。我的天啊。  我死於"}]
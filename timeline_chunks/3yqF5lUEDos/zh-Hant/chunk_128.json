[{"type": "subtitle", "time": 7688.229, "timestamp": "02:08:08", "text": "做了一個「茶包」動作？我的天啊。你小子。"}, {"type": "subtitle", "time": 7703.91, "timestamp": "02:08:23", "text": "滾開。不"}, {"type": "subtitle", "time": 7705.99, "timestamp": "02:08:25", "text": "，你小子。這些人真友善。我的天啊。啊！我的天啊。"}, {"type": "subtitle", "time": 7708.629, "timestamp": "02:08:28", "text": "你知道嗎？這些人好勝心太強了"}, {"type": "subtitle", "time": 7726.629, "timestamp": "02:08:46", "text": "。所以，我也要加入競爭。升到八級了。好的。不錯。陸地上有船嗎？我的天啊"}, {"type": "subtitle", "time": 7729.589, "timestamp": "02:08:49", "text": "。我的天啊。這是什麼？我的天啊，這架直升機。這些人，人類，真"}]
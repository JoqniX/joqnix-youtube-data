[{"type": "subtitle", "time": 7090.149, "timestamp": "01:58:10", "text": "不。好吧，好吧。承受痛苦。好的，"}, {"type": "subtitle", "time": 7099.669, "timestamp": "01:58:19", "text": "我們"}, {"type": "subtitle", "time": 7102.55, "timestamp": "01:58:22", "text": "需要……過來。我得像職業選手那樣幹掉這兩"}, {"type": "subtitle", "time": 7106.87, "timestamp": "01:58:26", "text": "個人。對，熱火。我幹掉了他們。我們損失了一點生命值，不過沒關係。迴聲。"}, {"type": "subtitle", "time": 7109.669, "timestamp": "01:58:29", "text": "現在，我們拿下"}]
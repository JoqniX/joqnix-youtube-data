[{"type": "subtitle", "time": 7409.99, "timestamp": "02:03:29", "text": "直升機包圍了。至少我能拿到一架鷹式直升機。我的天。嗯哼。不。俄羅斯"}, {"type": "subtitle", "time": 7427.51, "timestamp": "02:03:47", "text": "海軍。"}, {"type": "subtitle", "time": 7429.669, "timestamp": "02:03:49", "text": "沒關係"}, {"type": "subtitle", "time": 7431.51, "timestamp": "02:03:51", "text": "。我們需要"}, {"type": "subtitle", "time": 7433.35, "timestamp": "02:03:53", "text": "去鷹式直升機。鷹式直升機"}]
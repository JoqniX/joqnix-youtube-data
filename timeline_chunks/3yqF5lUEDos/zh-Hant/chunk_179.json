[{"type": "subtitle", "time": 10751.91, "timestamp": "02:59:11", "text": "那棟房子是誰的房子來著？  呃，Hikaris。  Hikaran就在那裡。讓"}, {"type": "subtitle", "time": 10764.469, "timestamp": "02:59:24", "text": "我們來"}, {"type": "subtitle", "time": 10782.389, "timestamp": "02:59:42", "text": "她留下了一些東西。我的"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "房子在哪裡？我同意。哦，是的。是的。"}, {"type": "subtitle", "time": 10795.59, "timestamp": "02:59:55", "text": "這是哦，是的。就是這裡。"}]
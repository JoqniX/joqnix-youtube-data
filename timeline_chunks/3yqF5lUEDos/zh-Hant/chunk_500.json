[{"type": "subtitle", "time": 30000.15, "timestamp": "08:20:00", "text": "表裡沒有這個字。 WHO？為什麼"}, {"type": "subtitle", "time": 30003.67, "timestamp": "08:20:03", "text": "我會"}, {"type": "subtitle", "time": 30006.07, "timestamp": "08:20:06", "text": "說出這些根本不是我自己的聲音說的話？  這很奇怪。  啊，他們死了嗎？  我被困住了。"}, {"type": "subtitle", "time": 30009.03, "timestamp": "08:20:09", "text": "快點。快點。快點。快點。快點。"}, {"type": "subtitle", "time": 30014.868, "timestamp": "08:20:14", "text": "不，不，不，不，不，不。你為什麼死了？為什麼會"}, {"type": "subtitle", "time": 30017.27, "timestamp": "08:20:17", "text": "喜樂寶箱？我懂了"}, {"type": "subtitle", "time": 30021.43, "timestamp": "08:20:21", "text": "。不，我沒有。"}, {"type": "subtitle", "time": 30023.19, "timestamp": "08:20:23", "text": "等待。我的意思是，他們人挺好的"}, {"type": "subtitle", "time": 30028.468, "timestamp": "08:20:28", "text": "。  就我個人而言，如果我有的話，"}, {"type": "subtitle", "time": 30034.468, "timestamp": "08:20:34", "text": "呃，我不喜歡。我的意思是，"}, {"type": "subtitle", "time": 30037.03, "timestamp": "08:20:37", "text": "如果我有的話，我會像刮鬍子一樣把它剃掉。就是這樣。這"}]
[{"type": "subtitle", "time": 33288.228, "timestamp": "09:14:48", "text": "我想這說得通。只是塞巴斯蒂安最近一直在煩我，問了我一些事……我真對他感到惱火。別告訴我他還在念著是"}, {"type": "subtitle", "time": 33294.79, "timestamp": "09:14:54", "text": "什麼來著？呃，抄本。他跟你說過。"}, {"type": "subtitle", "time": 33297.428, "timestamp": "09:14:57", "text": "真的。"}]
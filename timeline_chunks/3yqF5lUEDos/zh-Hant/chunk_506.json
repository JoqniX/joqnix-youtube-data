[{"type": "subtitle", "time": 30371.19, "timestamp": "08:26:11", "text": "我當時很生氣"}, {"type": "subtitle", "time": 30375.51, "timestamp": "08:26:15", "text": "。  我做完那件事就到此為止了。  我的天啊。短跑。  你的孩子。管好你的孩子。  管好你的孩子。  移動。"}, {"type": "subtitle", "time": 30391.91, "timestamp": "08:26:31", "text": "不，不，不，不"}, {"type": "subtitle", "time": 30396.628, "timestamp": "08:26:36", "text": "，不，不。我只有一瓶"}, {"type": "subtitle", "time": 30400.15, "timestamp": "08:26:40", "text": "藥水。  老天，我還能躲"}, {"type": "subtitle", "time": 30402.468, "timestamp": "08:26:42", "text": "多久？  所以他做了四次。  我的天哪。  啊。"}]
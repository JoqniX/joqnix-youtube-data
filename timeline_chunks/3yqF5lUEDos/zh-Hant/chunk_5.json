[{"type": "subtitle", "time": 313.27, "timestamp": "00:05:13", "text": "硬碟。  等等，這是被污染了嗎？  哇。  有一枚火箭正在購買部隊。  可能離得更近一些。  完全的。  別買。好吧，喬，別因為這款遊戲看起來不錯就買它。"}, {"type": "subtitle", "time": 318.15, "timestamp": "00:05:18", "text": "不，不，"}, {"type": "subtitle", "time": 321.189, "timestamp": "00:05:21", "text": "我不會買。但"}, {"type": "subtitle", "time": 344.23, "timestamp": "00:05:44", "text": "你知道我的，我現在"}, {"type": "subtitle", "time": 352.23, "timestamp": "00:05:52", "text": "不會買"}, {"type": "subtitle", "time": 359.59000000000003, "timestamp": "00:05:59", "text": "。空閒的時候的記憶，對吧？"}]
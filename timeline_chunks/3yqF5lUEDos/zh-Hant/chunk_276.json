[{"type": "subtitle", "time": 16586.949, "timestamp": "04:36:26", "text": "你還記得這件事嗎？"}, {"type": "subtitle", "time": 16592.47, "timestamp": "04:36:32", "text": "我覺得我不太清楚。  我的天啊。是的"}, {"type": "subtitle", "time": 16602.47, "timestamp": "04:36:42", "text": "。每次我都說“看那裡”，他都會說"}, {"type": "subtitle", "time": 16609.269, "timestamp": "04:36:49", "text": "“等我走了，就不會有新星人了”。教練的心將化為一具屍體。"}, {"type": "subtitle", "time": 16616.39, "timestamp": "04:36:56", "text": "我會說：「嘿，那件事真是太"}]
[{"type": "subtitle", "time": 30850.23, "timestamp": "08:34:10", "text": "被這些"}, {"type": "subtitle", "time": 30854.308, "timestamp": "08:34:14", "text": "人分心了。  你知道[音樂]"}, {"type": "subtitle", "time": 30856.868, "timestamp": "08:34:16", "text": "有時候我覺得不，我不想，我不想陷入病態的情緒。我可能說太多關於這件事了。"}, {"type": "subtitle", "time": 30865.43, "timestamp": "08:34:25", "text": "好的，等等。呃，"}, {"type": "subtitle", "time": 30867.91, "timestamp": "08:34:27", "text": "迪克在哪裡？呃，這邊請"}, {"type": "subtitle", "time": 30871.35, "timestamp": "08:34:31", "text": "留言。  哦，我在做什麼？  嗯，爸爸。等等，讓我"}, {"type": "subtitle", "time": 30873.51, "timestamp": "08:34:33", "text": "跟上。但是，呃，真糟糕。"}, {"type": "subtitle", "time": 30884.468, "timestamp": "08:34:44", "text": "我還要加上喬。好的，沒錯。  喬喬。  不過，確實有三個人叫我喬喬。一個是"}, {"type": "subtitle", "time": 30890.388, "timestamp": "08:34:50", "text": "帕基奇老師，嗯……他們叫"}]
[{"type": "subtitle", "time": 22211.11, "timestamp": "06:10:11", "text": "我當時沒怎麼說話，因為我發燒了，所以"}, {"type": "subtitle", "time": 22214.15, "timestamp": "06:10:14", "text": "不能說話也不能用手機。我記得我當時半睡半醒，就"}, {"type": "subtitle", "time": 22217.19, "timestamp": "06:10:17", "text": "那樣做了，"}, {"type": "subtitle", "time": 22220.39, "timestamp": "06:10:20", "text": "然後"}, {"type": "subtitle", "time": 22225.59, "timestamp": "06:10:25", "text": "不知怎麼就睡著了。你多久跟亞馬遜聊一次？嗯"}, {"type": "subtitle", "time": 22250.23, "timestamp": "06:10:50", "text": "，幾乎每天都聊。等等，真的嗎？用日語還是英語？兩種都用。哇。"}]
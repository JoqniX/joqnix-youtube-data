[{"type": "subtitle", "time": 29341.11, "timestamp": "08:09:01", "text": "剃光了，結果剃過的地方反而長得更快了。我不知道那是什麼機制，也不知道車身為什麼會那樣做。我非常討厭它。"}, {"type": "subtitle", "time": 29349.03, "timestamp": "08:09:09", "text": "我修"}, {"type": "subtitle", "time": 29351.99, "timestamp": "08:09:11", "text": "不好。所以我就在想，蜜蠟除毛或雷射除毛會有幫助嗎？"}, {"type": "subtitle", "time": 29364.31, "timestamp": "08:09:24", "text": "我不知道雷射治療很貴。"}, {"type": "subtitle", "time": 29369.19, "timestamp": "08:09:29", "text": "做蜜蠟除毛的話，大概需要30到40片除毛膏之類的東西。"}, {"type": "subtitle", "time": 29374.948, "timestamp": "08:09:34", "text": "你說刮鬍子，那就是你刮鬍子的地方。嗯？  大家都知道嗎？"}, {"type": "subtitle", "time": 29377.35, "timestamp": "08:09:37", "text": "我不"}, {"type": "subtitle", "time": 29379.83, "timestamp": "08:09:39", "text": "知道。"}, {"type": "subtitle", "time": 29381.99, "timestamp": "08:09:41", "text": "我當時還是個小孩子。我以前不了解這個世界的運作方式。我，我，我，我是個嬰兒。我當時還是個嬰兒。"}, {"type": "subtitle", "time": 29389.67, "timestamp": "08:09:49", "text": "我仍然覺得自己像個嬰兒。  但是，你"}, {"type": "subtitle", "time": 29396.548, "timestamp": "08:09:56", "text": "知道，我對此一無所知。我以前從未知道。  托布的師傅很糟糕。我以前從未知道。"}]
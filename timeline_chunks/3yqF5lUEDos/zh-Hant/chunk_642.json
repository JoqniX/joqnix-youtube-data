[{"type": "subtitle", "time": 38549.266, "timestamp": "10:42:29", "text": "成群的"}, {"type": "subtitle", "time": 38551.746, "timestamp": "10:42:31", "text": "石斑魚和鯰魚，它們能給我提供很多生命值。滿血。好的。  是的，亨特。  是的，是那條河。  面對"}, {"type": "subtitle", "time": 38555.746, "timestamp": "10:42:35", "text": "憤怒的牛鯊"}, {"type": "subtitle", "time": 38561.67, "timestamp": "10:42:41", "text": "，當地獵人們被迫繳納保釋金"}, {"type": "subtitle", "time": 38564.15, "timestamp": "10:42:44", "text": "，並強忍著昨晚的宿醉，下水捕魚"}, {"type": "subtitle", "time": 38567.51, "timestamp": "10:42:47", "text": "。"}]
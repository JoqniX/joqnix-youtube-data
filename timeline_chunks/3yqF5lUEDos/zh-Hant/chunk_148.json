[{"type": "subtitle", "time": 8884.07, "timestamp": "02:28:04", "text": "我們直播結束了，對吧"}, {"type": "subtitle", "time": 8887.91, "timestamp": "02:28:07", "text": "？我知道這是免費週末。我不知道"}, {"type": "subtitle", "time": 8897.51, "timestamp": "02:28:17", "text": "我會不會玩那個遊戲，因為即使是免費週末，我也剛剛卸載了。所以，我玩不了"}, {"type": "subtitle", "time": 8903.59, "timestamp": "02:28:23", "text": "Battlefield。如果你現在問我的話，因為我正在下載《新世界》。韋恩。是的。"}, {"type": "subtitle", "time": 8906.87, "timestamp": "02:28:26", "text": "所以，《新世界》會在那裡。還有DLC《Stu》和一個"}, {"type": "subtitle", "time": 8911.75, "timestamp": "02:28:31", "text": "像素遊戲。"}, {"type": "subtitle", "time": 8918.07, "timestamp": "02:28:38", "text": "可能是《地獄之門》"}, {"type": "subtitle", "time": 8922.309, "timestamp": "02:28:42", "text": "。嗨，"}, {"type": "subtitle", "time": 8927.349, "timestamp": "02:28:47", "text": "Twitch上會有一個新系列，因為我們之前沒有做過Twitch系列。所以，嗯，實際上YouTube上有兩個系列。我們在Twitch上只有一個系列，《空洞之"}]
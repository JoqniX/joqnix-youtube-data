[{"type": "subtitle", "time": 27316.26, "timestamp": "07:35:16", "text": "哦，太酷了。他融化了，我用了火，他再生了，我用了冰。太酷了。現在他在"}, {"type": "subtitle", "time": 27320.23, "timestamp": "07:35:20", "text": "這裡收養孩子"}, {"type": "subtitle", "time": 27323.59, "timestamp": "07:35:23", "text": "。我們要去他那裡嗎？我為什麼要按Esc"}, {"type": "subtitle", "time": 27357.75, "timestamp": "07:35:57", "text": "鍵？我不能受傷。"}, {"type": "subtitle", "time": 27359.51, "timestamp": "07:35:59", "text": "我的天啊。哦"}]
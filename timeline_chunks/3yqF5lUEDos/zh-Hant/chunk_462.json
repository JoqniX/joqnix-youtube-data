[{"type": "subtitle", "time": 27733.91, "timestamp": "07:42:13", "text": "天哪，他們跟著我。去死吧。"}, {"type": "subtitle", "time": 27764.31, "timestamp": "07:42:44", "text": "。她太強了，簡直逆天。走吧。你怎麼敢？我都沒注意到我按鍵有多快，快到"}, {"type": "subtitle", "time": 27774.07, "timestamp": "07:42:54", "text": "遊戲都暫停了"}, {"type": "subtitle", "time": 27776.468, "timestamp": "07:42:56", "text": "。石化"}]
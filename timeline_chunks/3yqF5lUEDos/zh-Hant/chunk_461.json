[{"type": "subtitle", "time": 27678.948, "timestamp": "07:41:18", "text": "我們應該再決定怎麼"}, {"type": "subtitle", "time": 27683.83, "timestamp": "07:41:23", "text": "處置他。 [音樂] 她死了。他只是"}, {"type": "subtitle", "time": 27690.23, "timestamp": "07:41:30", "text": "變成了木乃伊。真好。那個長得像德古拉的傢伙是誰？哦，等等。凱瑟琳。凱瑟琳。哈加蒂。所以，你是凱瑟琳，也是"}]
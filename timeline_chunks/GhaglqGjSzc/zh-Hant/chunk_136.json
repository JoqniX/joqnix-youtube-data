[{"type": "subtitle", "time": 8174.79, "timestamp": "02:16:14", "text": "哦，對了，這將是我和家人最後一次一起坐火車了。"}, {"type": "subtitle", "time": 8181.43, "timestamp": "02:16:21", "text": "我的天啊。  哦，是的。  我的天啊。  哦，等等。我跟你們說過我和"}, {"type": "subtitle", "time": 8210.629, "timestamp": "02:16:50", "text": "家人一起旅行的事嗎？"}, {"type": "subtitle", "time": 8215.03, "timestamp": "02:16:55", "text": "就像我們去旅行了一樣。  是的，我們出去旅行了，玩得很"}]
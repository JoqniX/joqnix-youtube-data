[{"type": "subtitle", "time": 7921.83, "timestamp": "02:12:01", "text": "ええ、つまり、"}, {"type": "subtitle", "time": 7923.99, "timestamp": "02:12:03", "text": "私がこんなことをしていると思っている人たちもいます。"}, {"type": "subtitle", "time": 7928.55, "timestamp": "02:12:08", "text": "あなたは私のことを見たことがないみたいに。私は"}, {"type": "subtitle", "time": 7932.55, "timestamp": "02:12:12", "text": "とてもシャイで寡黙で、私もそうです。私もそうです。"}, {"type": "subtitle", "time": 7939.51, "timestamp": "02:12:19", "text": "そうですね、"}, {"type": "subtitle", "time": 7941.75, "timestamp": "02:12:21", "text": "今はキャラクターを演じるのは難しいですね。   やってみましたが、"}, {"type": "subtitle", "time": 7952.149, "timestamp": "02:12:32", "text": "、私にできるのは、ありのままの自分を見せることだけ"}]
[{"type": "subtitle", "time": 256.39, "timestamp": "00:04:16", "text": "H. ちょっと"}, {"type": "subtitle", "time": 260.949, "timestamp": "00:04:20", "text": "待って、忘れてた。うん、じゃあね。 こんにちは、"}, {"type": "subtitle", "time": 271.749, "timestamp": "00:04:31", "text": "死すべき者。"}, {"type": "subtitle", "time": 274.23, "timestamp": "00:04:34", "text": "私のモデルはどこですか?   何てことだ"}, {"type": "subtitle", "time": 276.95, "timestamp": "00:04:36", "text": "。"}, {"type": "subtitle", "time": 279.189, "timestamp": "00:04:39", "text": "M"}, {"type": "subtitle", "time": 283.03, "timestamp": "00:04:43", "text": "リフレッシュ。 はい、ここにいます。 こんにちは。"}, {"type": "subtitle", "time": 290.87, "timestamp": "00:04:50", "text": "それで、えーっと、どうやら"}, {"type": "subtitle", "time": 297.27, "timestamp": "00:04:57", "text": "マイクを変えないといけないようです"}]
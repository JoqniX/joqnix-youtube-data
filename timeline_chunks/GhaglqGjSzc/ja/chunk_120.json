[{"type": "subtitle", "time": 7205.669, "timestamp": "02:00:05", "text": "シュウ。"}, {"type": "subtitle", "time": 7207.589, "timestamp": "02:00:07", "text": "はい、同意します。 君はそれが下手だよ。 そうそう"}, {"type": "subtitle", "time": 7209.43, "timestamp": "02:00:09", "text": "。 私はそれが苦手です。 はい、もちろん下手です"}, {"type": "subtitle", "time": 7212.79, "timestamp": "02:00:12", "text": "。 私は自分の言語、"}, {"type": "subtitle", "time": 7215.75, "timestamp": "02:00:15", "text": "母国語が苦手です。 私は英語が苦手です。 私は"}, {"type": "subtitle", "time": 7219.99, "timestamp": "02:00:19", "text": "記号的な英語しか使いません。きちんと"}, {"type": "subtitle", "time": 7228.39, "timestamp": "02:00:28", "text": "発音された英語は使いません。 ええ、どこか別の場所です"}, {"type": "subtitle", "time": 7231.27, "timestamp": "02:00:31", "text": "。 そして私はもう一つの"}, {"type": "subtitle", "time": 7240.07, "timestamp": "02:00:40", "text": "えっと、いや、いや、いや、いや、いや。 わかった。 わかった。   わかった"}, {"type": "subtitle", "time": 7242.39, "timestamp": "02:00:42", "text": "。 誤ってZをすべて制御してしまいました。"}, {"type": "subtitle", "time": 7244.31, "timestamp": "02:00:44", "text": "わかりました。   えっと、やめたほうがいいですね。"}, {"type": "subtitle", "time": 7249.27, "timestamp": "02:00:49", "text": "あ、ご"}, {"type": "subtitle", "time": 7258.55, "timestamp": "02:00:58", "text": "挨拶。 えーっと、"}]
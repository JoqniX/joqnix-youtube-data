[{"type": "subtitle", "time": 5709.43, "timestamp": "01:35:09", "text": "待って。わかりました。"}, {"type": "subtitle", "time": 5712.149, "timestamp": "01:35:12", "text": "つまり、見えた、見えたということです"}, {"type": "subtitle", "time": 5716.629, "timestamp": "01:35:16", "text": "。こんにちは、チャンダ。ようこそ。おはようございます"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "。えーと、日本語の"}, {"type": "subtitle", "time": 5722.87, "timestamp": "01:35:22", "text": "勉強をしています。えーと、復習していました。"}, {"type": "subtitle", "time": 5727.91, "timestamp": "01:35:27", "text": "日曜日に試験があります。日曜日にN4の試験です"}, {"type": "subtitle", "time": 5730.31, "timestamp": "01:35:30", "text": "。ええと、私たちは語彙の勉強をしていました"}, {"type": "subtitle", "time": 5737.75, "timestamp": "01:35:37", "text": "それで、"}, {"type": "subtitle", "time": 5740.79, "timestamp": "01:35:40", "text": "これらの語彙を使って文章を作ろうとしています。そうすれば、"}, {"type": "subtitle", "time": 5744.07, "timestamp": "01:35:44", "text": "正しく理解できるようになります。"}, {"type": "subtitle", "time": 5747.83, "timestamp": "01:35:47", "text": "文法なども含めて。"}, {"type": "subtitle", "time": 5750.39, "timestamp": "01:35:50", "text": "日本にいますか？まだです。来月以降は"}, {"type": "subtitle", "time": 5752.55, "timestamp": "01:35:52", "text": "日本にいます。今はまだ"}, {"type": "subtitle", "time": 5754.229, "timestamp": "01:35:54", "text": "インドにいます。"}, {"type": "subtitle", "time": 5756.79, "timestamp": "01:35:56", "text": "来月は"}]
[{"type": "subtitle", "time": 7322.39, "timestamp": "02:02:02", "text": "配信で描いたので絵が下手です。 私は"}, {"type": "subtitle", "time": 7326.87, "timestamp": "02:02:06", "text": "音楽を作るのが苦手です。 私はストリーミングで音楽を​​制作し、"}, {"type": "subtitle", "time": 7333.43, "timestamp": "02:02:13", "text": "ストリーミング中に苦手な言語を学んでいます。 それは"}, {"type": "subtitle", "time": 7337.109, "timestamp": "02:02:17", "text": "問題ではないと思います。 ある意味、"}, {"type": "subtitle", "time": 7341.35, "timestamp": "02:02:21", "text": "私の旅を闇として見ると、"}, {"type": "subtitle", "time": 7347.589, "timestamp": "02:02:27", "text": "趣味がたくさんあって、"}, {"type": "subtitle", "time": 7350.39, "timestamp": "02:02:30", "text": "自分自身を見つけようとしているようなもので、"}, {"type": "subtitle", "time": 7354.95, "timestamp": "02:02:34", "text": "それを何と呼ぶか​​わかりません。 えっと、私は何でもできるけど何一つ"}, {"type": "subtitle", "time": 7357.83, "timestamp": "02:02:37", "text": "専門的にできない人間で、"}, {"type": "subtitle", "time": 7360.39, "timestamp": "02:02:40", "text": "何事も苦手だということはわかっていますが、"}, {"type": "subtitle", "time": 7362.229, "timestamp": "02:02:42", "text": "何かをしてみたい、"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "スキルを学びたい、という興味はあるんですよね？ だから、僕がそれをビデオでやったり、"}, {"type": "subtitle", "time": 7374.55, "timestamp": "02:02:54", "text": "ネット上で公にやったりするのは、ある意味、僕はベストを尽くそうとしていて、やっていくつもりだということをアピールするためなんだ"}]
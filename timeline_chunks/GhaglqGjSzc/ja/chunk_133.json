[{"type": "subtitle", "time": 7990.95, "timestamp": "02:13:10", "text": "13日の夜はあの場所へ旅行に行きます"}, {"type": "subtitle", "time": 8000.55, "timestamp": "02:13:20", "text": "ああそうだ、これが"}, {"type": "subtitle", "time": 8004.39, "timestamp": "02:13:24", "text": "家族と行く最後の電車の旅になるだろう。 何てことだ。"}, {"type": "subtitle", "time": 8006.229, "timestamp": "02:13:26", "text": "そうそう。   何てことだ"}, {"type": "subtitle", "time": 8008.629, "timestamp": "02:13:28", "text": "。"}, {"type": "subtitle", "time": 8010.79, "timestamp": "02:13:30", "text": "ああ、待って。"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "家族と行った旅行について話しましたか? ああ、まるで"}, {"type": "subtitle", "time": 8019.91, "timestamp": "02:13:39", "text": "はい、"}, {"type": "subtitle", "time": 8023.669, "timestamp": "02:13:43", "text": "旅行に行きましたが楽しかったです。"}, {"type": "subtitle", "time": 8027.91, "timestamp": "02:13:47", "text": "えっと、いろんなところに行きました。"}, {"type": "subtitle", "time": 8033.91, "timestamp": "02:13:53", "text": "ええと、私たちは行くつもりです、私はただここにいるつもりです"}, {"type": "subtitle", "time": 8036.629, "timestamp": "02:13:56", "text": "。  30"}, {"type": "subtitle", "time": 8039.03, "timestamp": "02:13:59", "text": "分くらい話します。   では、これで終わりにします"}]
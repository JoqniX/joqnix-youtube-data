[{"type": "subtitle", "time": 2461.67, "timestamp": "00:41:01", "text": "ええ。それからオーナーは"}, {"type": "subtitle", "time": 2464.39, "timestamp": "00:41:04", "text": "再び「"}, {"type": "subtitle", "time": 2475.03, "timestamp": "00:41:15", "text": "ジョンは「はい、"}, {"type": "subtitle", "time": 2478.069, "timestamp": "00:41:18", "text": "一緒に働きましょう」と答え、オーナーは「頑張りましょう」と言いました。"}, {"type": "subtitle", "time": 2485.829, "timestamp": "00:41:25", "text": "次は"}, {"type": "subtitle", "time": 2488.55, "timestamp": "00:41:28", "text": "山下教授が来ます"}, {"type": "subtitle", "time": 2490.79, "timestamp": "00:41:30", "text": "。ええ。"}, {"type": "subtitle", "time": 2494.79, "timestamp": "00:41:34", "text": "つまり、実際にはお客様"}, {"type": "subtitle", "time": 2496.95, "timestamp": "00:41:36", "text": "でジョンです。こちらはジョンです。ああ、待って。"}, {"type": "subtitle", "time": 2499.91, "timestamp": "00:41:39", "text": "見えませんね。はい。こちらはジョンで、"}, {"type": "subtitle", "time": 2502.71, "timestamp": "00:41:42", "text": "これは山下教授の"}, {"type": "subtitle", "time": 2506.63, "timestamp": "00:41:46", "text": "曲です。こんにちは。では行きましょう。"}, {"type": "subtitle", "time": 2512.55, "timestamp": "00:41:52", "text": "これを読んでみましょう。山田教授が来ました。こんにちは。"}]
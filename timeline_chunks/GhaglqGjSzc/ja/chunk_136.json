[{"type": "subtitle", "time": 8169.51, "timestamp": "02:16:09", "text": "ああ、そうだ。"}, {"type": "subtitle", "time": 8173.03, "timestamp": "02:16:13", "text": "皆さんに、"}, {"type": "subtitle", "time": 8174.79, "timestamp": "02:16:14", "text": "最近の話、ああ、そうだよ。 これは最近の"}, {"type": "subtitle", "time": 8178.229, "timestamp": "02:16:18", "text": "出来事です。 はい、これも言えます。 私の猫の"}, {"type": "subtitle", "time": 8181.43, "timestamp": "02:16:21", "text": "1匹、ええと、私の猫ではないのですが、私の"}, {"type": "subtitle", "time": 8184.069, "timestamp": "02:16:24", "text": "母猫は"}, {"type": "subtitle", "time": 8187.27, "timestamp": "02:16:27", "text": "すでに子供を産んでいて、確か"}, {"type": "subtitle", "time": 8193.19, "timestamp": "02:16:33", "text": "7代目の子供を産んでいて、どうやら今は"}, {"type": "subtitle", "time": 8195.99, "timestamp": "02:16:35", "text": "8代目の子供が生まれようとしているようです"}, {"type": "subtitle", "time": 8200.07, "timestamp": "02:16:40", "text": "。 それで、最近"}, {"type": "subtitle", "time": 8202.549, "timestamp": "02:16:42", "text": "毎晩のようにたくさんの"}, {"type": "subtitle", "time": 8206.389, "timestamp": "02:16:46", "text": "野良猫が私の家に来るのはなぜか分かりません"}, {"type": "subtitle", "time": 8210.629, "timestamp": "02:16:50", "text": "。 彼らは"}, {"type": "subtitle", "time": 8215.03, "timestamp": "02:16:55", "text": "戦っているように戦っています。"}, {"type": "subtitle", "time": 8218.23, "timestamp": "02:16:58", "text": "遠吠えしたりもします。うちの犬は"}]
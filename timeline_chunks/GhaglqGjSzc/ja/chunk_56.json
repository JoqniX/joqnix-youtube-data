[{"type": "subtitle", "time": 3362.47, "timestamp": "00:56:02", "text": "勉強してるだけ。日曜日に試験があるんです。ええ"}, {"type": "subtitle", "time": 3365.51, "timestamp": "00:56:05", "text": "。試験のためには、えっと、今までずっと"}, {"type": "subtitle", "time": 3367.67, "timestamp": "00:56:07", "text": "書いてきたことを全部覚えて、"}, {"type": "subtitle", "time": 3377.19, "timestamp": "00:56:17", "text": "復習しなきゃいけないんです。"}, {"type": "subtitle", "time": 3380.63, "timestamp": "00:56:20", "text": "まるで生き延びなきゃいけないみたいに勉強しなきゃいけないんです。ええ、"}, {"type": "subtitle", "time": 3382.87, "timestamp": "00:56:22", "text": "二度目は失敗できない。だから、"}, {"type": "subtitle", "time": 3385.75, "timestamp": "00:56:25", "text": "勉強しなきゃいけないんです。"}, {"type": "subtitle", "time": 3393.27, "timestamp": "00:56:33", "text": "日本でN4クラスに入れられたくないんです。ええと。N3クラスに"}, {"type": "subtitle", "time": 3396.15, "timestamp": "00:56:36", "text": "入れてもらえたら嬉しいんですけど、もし"}, {"type": "subtitle", "time": 3398.87, "timestamp": "00:56:38", "text": "N4クラスに入れられたら、"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "N4を何ヶ月勉強したことになるんですか？"}, {"type": "subtitle", "time": 3404.63, "timestamp": "00:56:44", "text": "ええと、去年の"}, {"type": "subtitle", "time": 3407.349, "timestamp": "00:56:47", "text": "10月からこのコースを始めました。N4のレッスンですよね。10月、11月、12月、1月、2月、3月。6ヶ月ですね。"}]
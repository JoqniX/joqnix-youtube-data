[{"type": "subtitle", "time": 7140.629, "timestamp": "01:59:00", "text": "話しているんですが、"}, {"type": "subtitle", "time": 7160.629, "timestamp": "01:59:20", "text": "スピーキングに関しては、"}, {"type": "subtitle", "time": 7162.55, "timestamp": "01:59:22", "text": "今はあまり日本語を練習していません。 だから"}, {"type": "subtitle", "time": 7165.109, "timestamp": "01:59:25", "text": "日本語を話せる人もいないので日本語が下手です"}, {"type": "subtitle", "time": 7171.669, "timestamp": "01:59:31", "text": "そうですね、それらを話したり読んだりするのは私の"}, {"type": "subtitle", "time": 7174.39, "timestamp": "01:59:34", "text": "弱点です。"}, {"type": "subtitle", "time": 7176.629, "timestamp": "01:59:36", "text": "聞くのは大丈夫です。"}, {"type": "subtitle", "time": 7180.149, "timestamp": "01:59:40", "text": "ロシア語とイタリア語を話します。 わあ、それは"}]
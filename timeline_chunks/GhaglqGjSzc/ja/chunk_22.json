[{"type": "subtitle", "time": 1321.83, "timestamp": "00:22:01", "text": "はい、そうなりました。 それは良いはずです。"}, {"type": "chat", "time": 1324.593, "timestamp": "00:22:04", "author": "@WispyAbyss", "avatar": "https://yt4.ggpht.com/s9iluR-R4Y6B-bN9RDEvxzCLoxA50gkI7hsqVgt7qzw0NPEWPjCIlGKutgS0beWIoGMM5euvdg=s64-c-k-c0x00ffffff-no-rj", "message": "11:41 PM?!?!"}, {"type": "chat", "time": 1327.003, "timestamp": "00:22:07", "author": "@WispyAbyss", "avatar": "https://yt4.ggpht.com/s9iluR-R4Y6B-bN9RDEvxzCLoxA50gkI7hsqVgt7qzw0NPEWPjCIlGKutgS0beWIoGMM5euvdg=s64-c-k-c0x00ffffff-no-rj", "message": "holy.."}, {"type": "chat", "time": 1336.237, "timestamp": "00:22:16", "author": "@Solaralt-k8h", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lA7jr0LZvBQFLmBc7jijnVjyoazsJEdCveoYk4bFvSLqy3mJRIVzhAwp7IKIkTOUTl9A=s64-c-k-c0x00ffffff-no-rj", "message": "Yup"}, {"type": "subtitle", "time": 1338.31, "timestamp": "00:22:18", "text": "私もカニスを調べていたのですが、"}, {"type": "subtitle", "time": 1340.63, "timestamp": "00:22:20", "text": "そうそう、いいウェブサイトを見つけました"}, {"type": "subtitle", "time": 1344.87, "timestamp": "00:22:24", "text": "。 それは漢字かなといいます。 そこで、"}, {"type": "subtitle", "time": 1347.909, "timestamp": "00:22:27", "text": "N4 を選択して、漢字の 1 つをクリックすると、"}, {"type": "subtitle", "time": 1354.23, "timestamp": "00:22:34", "text": "このように書き順が表示されます。視覚化されているので、"}, {"type": "subtitle", "time": 1355.99, "timestamp": "00:22:35", "text": "正しい書き順の"}, {"type": "subtitle", "time": 1359.669, "timestamp": "00:22:39", "text": "パターンを忘れることはありません。また、"}, {"type": "subtitle", "time": 1364.39, "timestamp": "00:22:44", "text": "この漢字に使用されている訓読みと音読み、部首も表示され、"}, {"type": "subtitle", "time": 1367.19, "timestamp": "00:22:47", "text": "よく使われる単語もあります。 これは"}, {"type": "subtitle", "time": 1371.83, "timestamp": "00:22:51", "text": "私にとっては良いことです。なぜなら、この"}, {"type": "subtitle", "time": 1374.47, "timestamp": "00:22:54", "text": "漢字はどこかで見たことがあるけれど、他の漢字と"}, {"type": "subtitle", "time": 1376.63, "timestamp": "00:22:56", "text": "一緒になったときにどう読むのか、ということをいつも忘れてしまうからです"}]
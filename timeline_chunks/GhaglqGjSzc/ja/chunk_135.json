[{"type": "subtitle", "time": 8101.109, "timestamp": "02:15:01", "text": "。 うん。 ああ、これ。"}, {"type": "subtitle", "time": 8109.35, "timestamp": "02:15:09", "text": "そうですね。 ああ、これ。"}, {"type": "subtitle", "time": 8111.669, "timestamp": "02:15:11", "text": "YouTubeのステッカーみたいに貼ってみました。"}, {"type": "subtitle", "time": 8114.39, "timestamp": "02:15:14", "text": "それで、ええ、"}, {"type": "subtitle", "time": 8118.149, "timestamp": "02:15:18", "text": "ここには鳥がたくさんいるな、と思いました。 私はそれを取って、それから、えーっと、"}, {"type": "subtitle", "time": 8124.709, "timestamp": "02:15:24", "text": "教会の中に行ったと思います。 彼らは、"}, {"type": "subtitle", "time": 8126.79, "timestamp": "02:15:26", "text": "うーん、聖域か"}, {"type": "subtitle", "time": 8129.109, "timestamp": "02:15:29", "text": "何か、鳥の聖域のようなものがあると思っていました。"}, {"type": "subtitle", "time": 8133.109, "timestamp": "02:15:33", "text": "鶏や鳩などもいました。"}, {"type": "subtitle", "time": 8135.91, "timestamp": "02:15:35", "text": "鳥がここにいました。"}, {"type": "subtitle", "time": 8138.95, "timestamp": "02:15:38", "text": "そしてこの男はこうでした、この鳥はまったく"}, {"type": "subtitle", "time": 8142.39, "timestamp": "02:15:42", "text": "ひるみませんでした。 私は"}, {"type": "subtitle", "time": 8146.95, "timestamp": "02:15:46", "text": "金属格子の中に指を入れようとしていました。   びくともしなかった"}, {"type": "subtitle", "time": 8149.589, "timestamp": "02:15:49", "text": "。 それはそこにいて見ていました"}, {"type": "subtitle", "time": 8153.189, "timestamp": "02:15:53", "text": "。 この人間は何をしてるのでしょうか?   何てことだ"}, {"type": "subtitle", "time": 8158.069, "timestamp": "02:15:58", "text": "。 これはいいですね。"}]
[{"type": "subtitle", "time": 2413.91, "timestamp": "00:40:13", "text": "オーナーはジョーに、このアルバイトに興味があるかと尋ねました。ジョーはジョンに尋ね、"}, {"type": "subtitle", "time": 2416.71, "timestamp": "00:40:16", "text": "ジョンは「"}, {"type": "subtitle", "time": 2418.23, "timestamp": "00:40:18", "text": "面白いし、"}, {"type": "subtitle", "time": 2423.19, "timestamp": "00:40:23", "text": "新しい人に会えるし」と答えました。ええ"}, {"type": "subtitle", "time": 2425.51, "timestamp": "00:40:25", "text": "、新しい人に会えるし、"}, {"type": "subtitle", "time": 2431.91, "timestamp": "00:40:31", "text": "日本語をもっと使えるようになるし」と答えました。"}, {"type": "subtitle", "time": 2436.39, "timestamp": "00:40:36", "text": "ええ。そしてオーナーは「日本とか、"}, {"type": "subtitle", "time": 2441.589, "timestamp": "00:40:41", "text": "日本語で働いたことある"}, {"type": "subtitle", "time": 2443.43, "timestamp": "00:40:43", "text": "？」と聞きました。他の場所で働いたことはありますか"}, {"type": "subtitle", "time": 2446.47, "timestamp": "00:40:46", "text": "？"}, {"type": "subtitle", "time": 2449.43, "timestamp": "00:40:49", "text": "とジョンは答えました。「"}, {"type": "subtitle", "time": 2451.99, "timestamp": "00:40:51", "text": "はい、コンビニでアルバイトとして働いたことがあります」と答えました。"}]
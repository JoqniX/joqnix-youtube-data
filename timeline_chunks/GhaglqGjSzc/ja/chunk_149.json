[{"type": "subtitle", "time": 8943.59, "timestamp": "02:29:03", "text": "インド出身の方、そうそう、もし今日が"}, {"type": "subtitle", "time": 8946.309, "timestamp": "02:29:06", "text": "朝だったら、良い一日を、"}, {"type": "subtitle", "time": 8949.51, "timestamp": "02:29:09", "text": "夜だったら良い一日を。"}, {"type": "subtitle", "time": 8952.71, "timestamp": "02:29:12", "text": "午後はおいしいランチなどを食べ、夜は"}, {"type": "subtitle", "time": 8955.19, "timestamp": "02:29:15", "text": "おやすみなさい。ええ、こんにちは、ええ、ええ、"}, {"type": "subtitle", "time": 8960.469, "timestamp": "02:29:20", "text": "BLAT。それは"}, {"type": "subtitle", "time": 8962.389, "timestamp": "02:29:22", "text": "何ですか？ああ、ええ。学ぶの。"}, {"type": "subtitle", "time": 8965.19, "timestamp": "02:29:25", "text": "ロシア語はわかるよね？ああ、こんにちは。こんにちは。さようなら。おやすみなさい"}, {"type": "subtitle", "time": 8966.95, "timestamp": "02:29:26", "text": "。待って、おやすみなさいじゃないよ"}, {"type": "subtitle", "time": 8976.63, "timestamp": "02:29:36", "text": "見てくれてありがとう。"}, {"type": "subtitle", "time": 8983.67, "timestamp": "02:29:43", "text": "私のVチャンネルにリダイレクトします"}, {"type": "subtitle", "time": 8986.309, "timestamp": "02:29:46", "text": "。こんにちは。"}, {"type": "subtitle", "time": 8987.99, "timestamp": "02:29:47", "text": "現在、ええと、"}, {"type": "subtitle", "time": 8990.07, "timestamp": "02:29:50", "text": "私のウォッチチャンネルでMinecraftをプレイしています。それでは、"}, {"type": "subtitle", "time": 8993.429, "timestamp": "02:29:53", "text": "私のチャンネルをレイドします。では、ええ。"}]
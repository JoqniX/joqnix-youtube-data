[{"type": "subtitle", "time": 2641.109, "timestamp": "00:44:01", "text": "回やっています。"}, {"type": "subtitle", "time": 2643.27, "timestamp": "00:44:03", "text": "待って、待って、待って、待って。イスカ、待って。おい"}, {"type": "subtitle", "time": 2654.55, "timestamp": "00:44:14", "text": "週ですよね？1週間で3回やっています。わかりました"}, {"type": "subtitle", "time": 2659.27, "timestamp": "00:44:19", "text": "。1週間で3回やっていますよね"}, {"type": "subtitle", "time": 2662.309, "timestamp": "00:44:22", "text": "？ええ、ええ。それで、彼は1"}, {"type": "subtitle", "time": 2664.87, "timestamp": "00:44:24", "text": "週間で3回やっています。"}, {"type": "subtitle", "time": 2666.87, "timestamp": "00:44:26", "text": "ここ"}, {"type": "subtitle", "time": 2669.349, "timestamp": "00:44:29", "text": "リトルアジアというレストランでアルバイトをしています。"}, {"type": "subtitle", "time": 2673.589, "timestamp": "00:44:33", "text": "教授は「なるほど」と言いました。えーと、"}, {"type": "subtitle", "time": 2677.109, "timestamp": "00:44:37", "text": "メニューから…えーと、どれが…えーと、どれが…"}, {"type": "subtitle", "time": 2681.109, "timestamp": "00:44:41", "text": "えっと、食べ物のこと"}, {"type": "subtitle", "time": 2684.309, "timestamp": "00:44:44", "text": "か、メニューのどれが"}, {"type": "subtitle", "time": 2688.23, "timestamp": "00:44:48", "text": "美味しいかって話になったのは、"}, {"type": "subtitle", "time": 2697.91, "timestamp": "00:44:57", "text": "ジョンがメニューをこちらに持ってきて、何を注文しますか？って聞いてるみたいだったから。"}]
[{"type": "subtitle", "time": 4886.55, "timestamp": "01:21:26", "text": "バレンタインデー。また別の贈り物への招待、"}, {"type": "subtitle", "time": 4897.59, "timestamp": "01:21:37", "text": "ええ、最後にこれを見ていきましょう"}, {"type": "subtitle", "time": 4906.63, "timestamp": "01:21:46", "text": "。その後、ニュースのようなものを数行読みます。わかりました。"}, {"type": "subtitle", "time": 4910.709, "timestamp": "01:21:50", "text": "それから"}, {"type": "subtitle", "time": 4913.99, "timestamp": "01:21:53", "text": "すぐにまとめることができます。わかりました。わかりました。"}]
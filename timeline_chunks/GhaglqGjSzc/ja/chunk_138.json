[{"type": "subtitle", "time": 8280.79, "timestamp": "02:18:00", "text": "いつも、うーん、私の"}, {"type": "subtitle", "time": 8283.75, "timestamp": "02:18:03", "text": "足の後ろにいて、私が"}, {"type": "subtitle", "time": 8288.549, "timestamp": "02:18:08", "text": "裏庭に歩いて行くときはいつも、猫のドアが"}, {"type": "subtitle", "time": 8291.509, "timestamp": "02:18:11", "text": "私のところに来て、私を撫でてくれる"}, {"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "、撫でてくれるような感じでした。"}, {"type": "subtitle", "time": 8308.23, "timestamp": "02:18:28", "text": "猫から何かを学びましょう。 待って、今は人間"}, {"type": "subtitle", "time": 8315.03, "timestamp": "02:18:35", "text": "関係とかに重点を置くべきじゃないと思う"}, {"type": "subtitle", "time": 8317.11, "timestamp": "02:18:37", "text": "。 今はただ"}, {"type": "subtitle", "time": 8320.07, "timestamp": "02:18:40", "text": "自分の人生に集中したいだけです。 そうすれば"}, {"type": "subtitle", "time": 8325.03, "timestamp": "02:18:45", "text": "後で心配することができます。 はい、心配しないでください。   すでにやることが山ほどあるんです"}, {"type": "subtitle", "time": 8327.75, "timestamp": "02:18:47", "text": "。"}, {"type": "subtitle", "time": 8330.709, "timestamp": "02:18:50", "text": "今は、"}, {"type": "subtitle", "time": 8332.79, "timestamp": "02:18:52", "text": "日本語を勉強して、"}, {"type": "subtitle", "time": 8335.349, "timestamp": "02:18:55", "text": "試験に合格して、学位を取得して、"}, {"type": "subtitle", "time": 8339.509, "timestamp": "02:18:59", "text": "修士号を取得することが優先事項です。   僕はまだ"}]
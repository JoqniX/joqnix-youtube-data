[{"type": "subtitle", "time": 7441.75, "timestamp": "02:04:01", "text": "？ 私は、ただ絵を描いているだけのストリームを配信している人を何人か見ていますが、彼らはバックグラウンドで"}, {"type": "subtitle", "time": 7452.87, "timestamp": "02:04:12", "text": "勉強したり仕事をしたりしながら、とにかくそういったものを描くことを学んでいます"}, {"type": "subtitle", "time": 7455.75, "timestamp": "02:04:15", "text": "。 ただ何かを見て、"}, {"type": "subtitle", "time": 7458.709, "timestamp": "02:04:18", "text": "彼らが最善を尽くしているのはいいことだ、そう思うだけだよ。 だから"}, {"type": "subtitle", "time": 7462.149, "timestamp": "02:04:22", "text": "、私はそのように受け止めます。"}, {"type": "subtitle", "time": 7471.189, "timestamp": "02:04:31", "text": "でも、まあ、公平に言えば、ちょっと"}, {"type": "subtitle", "time": 7474.55, "timestamp": "02:04:34", "text": "奇妙だし、それほど楽しいものではないと思う。だって、"}, {"type": "subtitle", "time": 7476.39, "timestamp": "02:04:36", "text": "人々は何か面白くて楽しいものを見たいだろう"}, {"type": "subtitle", "time": 7479.35, "timestamp": "02:04:39", "text": "？ そして、それはそこにもあります"}, {"type": "subtitle", "time": 7486.07, "timestamp": "02:04:46", "text": "ああ、そういうことだよ。 だから、"}, {"type": "subtitle", "time": 7489.189, "timestamp": "02:04:49", "text": "時々何か"}, {"type": "subtitle", "time": 7491.189, "timestamp": "02:04:51", "text": "アクティビティをしたいと思ったときに、"}, {"type": "subtitle", "time": 7495.91, "timestamp": "02:04:55", "text": "このストリームをやるべきだろうかと思うんです。"}, {"type": "subtitle", "time": 7498.79, "timestamp": "02:04:58", "text": "もちろん、古いアカウントなどでいつでもストリーミングできます"}]
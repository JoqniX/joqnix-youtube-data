[{"type": "subtitle", "time": 7381.669, "timestamp": "02:03:01", "text": "。 結果に関係なく"}, {"type": "subtitle", "time": 7383.589, "timestamp": "02:03:03", "text": "。"}, {"type": "subtitle", "time": 7386.55, "timestamp": "02:03:06", "text": "うん。 そうすれば、いつでも「"}, {"type": "subtitle", "time": 7390.39, "timestamp": "02:03:10", "text": "そうだ」と振り返ることができるんです。 何"}, {"type": "subtitle", "time": 7398.55, "timestamp": "02:03:18", "text": "年か前、私は"}, {"type": "subtitle", "time": 7402.709, "timestamp": "02:03:22", "text": "日本語を勉強していました。これは私が日本語が下手だったにもかかわらず、"}, {"type": "subtitle", "time": 7405.75, "timestamp": "02:03:25", "text": "勉強しようとしていたときのことであり、"}, {"type": "subtitle", "time": 7408.55, "timestamp": "02:03:28", "text": "時間が経つにつれて上達したとか何とかです。"}, {"type": "subtitle", "time": 7411.35, "timestamp": "02:03:31", "text": "2、3年後には"}, {"type": "subtitle", "time": 7413.109, "timestamp": "02:03:33", "text": "日本語で話すのが上手い声とか"}, {"type": "subtitle", "time": 7414.79, "timestamp": "02:03:34", "text": "その他もろもろが戻ってきたりもするし、振り返る"}, {"type": "subtitle", "time": 7419.75, "timestamp": "02:03:39", "text": "思い出や思い出の小道みたいなものもあるよね。"}, {"type": "subtitle", "time": 7424.709, "timestamp": "02:03:44", "text": "だから私はそれを旅のように考えているんだけど、"}, {"type": "subtitle", "time": 7430.39, "timestamp": "02:03:50", "text": "Twitch自体でも、絵の描き方を学んでいる、あるいは絵を"}, {"type": "subtitle", "time": 7438.07, "timestamp": "02:03:58", "text": "描くストリームが好きな小規模なストリーマーがたくさんいるよね"}]
[{"type": "subtitle", "time": 7562.39, "timestamp": "02:06:02", "text": "。 ああ。 何てことだ。"}, {"type": "subtitle", "time": 7569.91, "timestamp": "02:06:09", "text": "頭を使うことはできたかもしれないけど、あまり頭を使わない。"}, {"type": "subtitle", "time": 7576.31, "timestamp": "02:06:16", "text": "キッチー、オー、チー、帰り道。"}, {"type": "subtitle", "time": 7579.91, "timestamp": "02:06:19", "text": "そうですね、私は語彙が苦手だと思います。"}, {"type": "subtitle", "time": 7584.39, "timestamp": "02:06:24", "text": "うーん、適切な言葉が分からないんです。"}, {"type": "subtitle", "time": 7587.109, "timestamp": "02:06:27", "text": "えっと、"}, {"type": "subtitle", "time": 7588.95, "timestamp": "02:06:28", "text": "ちょっとした文化的なメモです。 日本語では"}, {"type": "subtitle", "time": 7593.35, "timestamp": "02:06:33", "text": "彼女の夫を「彼」と言うことはほとんどありません。"}, {"type": "subtitle", "time": 7597.589, "timestamp": "02:06:37", "text": "たいてい私たちは、「ああ、もう"}]
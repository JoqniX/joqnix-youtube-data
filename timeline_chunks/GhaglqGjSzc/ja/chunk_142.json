[{"type": "subtitle", "time": 8524.23, "timestamp": "02:22:04", "text": "大事だって言ってたよね。俺も散々な恋愛"}, {"type": "subtitle", "time": 8527.75, "timestamp": "02:22:07", "text": "経験があるから、あんなのはもう二度と経験したく"}, {"type": "subtitle", "time": 8533.67, "timestamp": "02:22:13", "text": "ない。いや、"}, {"type": "subtitle", "time": 8543.83, "timestamp": "02:22:23", "text": "男として噛みつくなんて、"}, {"type": "subtitle", "time": 8557.83, "timestamp": "02:22:37", "text": "。何人か俺にアプローチしてきたけど、断った"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "。"}, {"type": "subtitle", "time": 8567.59, "timestamp": "02:22:47", "text": "気まずい関係だった。うん、うん、"}, {"type": "subtitle", "time": 8572.95, "timestamp": "02:22:52", "text": "つまり、この時点で俺のコンテンツはもう"}, {"type": "subtitle", "time": 8575.99, "timestamp": "02:22:55", "text": "公開されてる。何が起こったかは知らないけど、全部明かさなきゃいけなかったから」"}]
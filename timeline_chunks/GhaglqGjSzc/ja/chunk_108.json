[{"type": "subtitle", "time": 6481.91, "timestamp": "01:48:01", "text": "変な時間に起きて、"}, {"type": "subtitle", "time": 6485.35, "timestamp": "01:48:05", "text": "アニメを見たり、読書したり、"}, {"type": "subtitle", "time": 6488.31, "timestamp": "01:48:08", "text": "音楽を聞いたりして時間を無駄にしていました。先月はストリーミングはしなかったと思いますが、"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "ええ。ええと、今は土壇場で"}, {"type": "subtitle", "time": 6494.31, "timestamp": "01:48:14", "text": "勉強していて、"}, {"type": "subtitle", "time": 6497.27, "timestamp": "01:48:17", "text": "何があろうと失敗は許されない。一度失敗して、それだけじゃなくて、えーっと、何があろうと"}, {"type": "subtitle", "time": 6506.87, "timestamp": "01:48:26", "text": "勉強しなきゃいけない"}, {"type": "subtitle", "time": 6509.189, "timestamp": "01:48:29", "text": "。実は"}, {"type": "subtitle", "time": 6516.39, "timestamp": "01:48:36", "text": "配信も少し休もうかと思ってるんだ。だって、日本に行くと"}, {"type": "subtitle", "time": 6521.99, "timestamp": "01:48:41", "text": "日本語の勉強だけじゃなくて、パートタイムの仕事もやらなきゃいけないし、"}, {"type": "subtitle", "time": 6532.07, "timestamp": "01:48:52", "text": "英文学の試験対策もやらなきゃいけないし、"}, {"type": "subtitle", "time": 6536.95, "timestamp": "01:48:56", "text": "日本から送らなきゃいけない書類も全部やらなきゃいけない。"}]
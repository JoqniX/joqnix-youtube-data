[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "リコーダーのようなものを作りました。"}, {"type": "subtitle", "time": 8466.389, "timestamp": "02:21:06", "text": "ライブ配信中は常にチャットをスキャンします。 ええ、"}, {"type": "subtitle", "time": 8469.51, "timestamp": "02:21:09", "text": "247チャンネルとジョークジョーク"}, {"type": "subtitle", "time": 8471.19, "timestamp": "02:21:11", "text": "チャンネルの両方です。 新しいメッセージがあるたびに"}, {"type": "subtitle", "time": 8475.83, "timestamp": "02:21:15", "text": "スキャンされます。 およそ6時間ごとに運行します。   えっと、私がそれをやりました"}, {"type": "subtitle", "time": 8479.19, "timestamp": "02:21:19", "text": "。 うん。 だから、まだやるべきことがたくさんあるような気がします"}, {"type": "subtitle", "time": 8481.03, "timestamp": "02:21:21", "text": "。 それで"}, {"type": "subtitle", "time": 8483.27, "timestamp": "02:21:23", "text": "「ああ、勉強が最優先だよね？"}, {"type": "subtitle", "time": 8485.51, "timestamp": "02:21:25", "text": "試験が最優先。"}, {"type": "subtitle", "time": 8489.429, "timestamp": "02:21:29", "text": "そういうのは置いておく。"}, {"type": "subtitle", "time": 8491.349, "timestamp": "02:21:31", "text": "後でやる。えーっと、えーっと、そんなに"}, {"type": "subtitle", "time": 8504.389, "timestamp": "02:21:44", "text": "13日か12日にフォートナイトに来るらしい"}, {"type": "subtitle", "time": 8507.27, "timestamp": "02:21:47", "text": "。うん、13日。13日。ああ"}, {"type": "subtitle", "time": 8510.87, "timestamp": "02:21:50", "text": "、推しがフォートナイトに来るんだ。"}, {"type": "subtitle", "time": 8514.63, "timestamp": "02:21:54", "text": "彼女を買いたいんだけど、お金がない。"}, {"type": "subtitle", "time": 8517.429, "timestamp": "02:21:57", "text": "えーっと、スキンシップって"}]
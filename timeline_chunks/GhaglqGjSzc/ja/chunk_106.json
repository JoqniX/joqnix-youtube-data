[{"type": "subtitle", "time": 6360.39, "timestamp": "01:46:00", "text": "単語を学ぶだけでなく、文法の使い方も学んでいる。"}, {"type": "subtitle", "time": 6371.99, "timestamp": "01:46:11", "text": "文の中でどうやって文を使うか、正しく使うか、"}, {"type": "subtitle", "time": 6374.87, "timestamp": "01:46:14", "text": "そして本当にいいものなんだ。だから"}, {"type": "subtitle", "time": 6378.39, "timestamp": "01:46:18", "text": "食べられなかった。"}, {"type": "subtitle", "time": 6381.35, "timestamp": "01:46:21", "text": "君の安定した流れのせいだと思う。"}, {"type": "subtitle", "time": 6383.59, "timestamp": "01:46:23", "text": "どういう意味？僕のせいにはできないよ"}, {"type": "subtitle", "time": 6392.709, "timestamp": "01:46:32", "text": "えーと、わかった。文を作ってみよう。えーと、"}, {"type": "subtitle", "time": 6395.35, "timestamp": "01:46:35", "text": "旦那さん、そうでしょう？"}, {"type": "subtitle", "time": 6404.95, "timestamp": "01:46:44", "text": "例を見る前はメアリーでしたよね"}, {"type": "subtitle", "time": 6408.31, "timestamp": "01:46:48", "text": "？テシとメアリーですよね？"}, {"type": "subtitle", "time": 6412.229, "timestamp": "01:46:52", "text": "ええ。では、メアリーを例に挙げましょう。"}]
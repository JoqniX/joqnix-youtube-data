[{"type": "subtitle", "time": 6429.109, "timestamp": "01:47:09", "text": "アパートに戻る途中のシナリオを想像してみてください。"}, {"type": "subtitle", "time": 6436.229, "timestamp": "01:47:16", "text": "妻のメアリーが、"}, {"type": "subtitle", "time": 6444.79, "timestamp": "01:47:24", "text": "仕事に行く夫に「バイバイ」と言っているのに気づきました。日本語ではどう書けばいいでしょうか？"}, {"type": "subtitle", "time": 6447.109, "timestamp": "01:47:27", "text": "ああ、大変。"}, {"type": "subtitle", "time": 6456.709, "timestamp": "01:47:36", "text": "このシステムは、私たちを勉強勉強勉強で燃やしているように感じます"}, {"type": "subtitle", "time": 6458.149, "timestamp": "01:47:38", "text": "。みんな落ち着いて、"}, {"type": "subtitle", "time": 6460.07, "timestamp": "01:47:40", "text": "このループから抜け出せる日は来るのでしょうか？"}, {"type": "subtitle", "time": 6463.75, "timestamp": "01:47:43", "text": "ええ、"}, {"type": "subtitle", "time": 6467.91, "timestamp": "01:47:47", "text": "正直、気持ちは分かります。私の場合は、"}, {"type": "subtitle", "time": 6470.47, "timestamp": "01:47:50", "text": "先月はサボっていました"}, {"type": "subtitle", "time": 6474.149, "timestamp": "01:47:54", "text": "。かなりサボっていました。"}, {"type": "subtitle", "time": 6477.669, "timestamp": "01:47:57", "text": "ベッドでゴロゴロ寝て、"}]
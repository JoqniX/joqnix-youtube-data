[{"type": "subtitle", "time": 1921.669, "timestamp": "00:32:01", "text": "。 何が起こっていますか？"}, {"type": "subtitle", "time": 1924.149, "timestamp": "00:32:04", "text": "練習しなきゃな。 何てことだ。 そしてこれは"}, {"type": "subtitle", "time": 1926.87, "timestamp": "00:32:06", "text": "悪いことだ。"}, {"type": "subtitle", "time": 1930.63, "timestamp": "00:32:10", "text": "これはまずい。 悪い。"}, {"type": "subtitle", "time": 1971.19, "timestamp": "00:32:51", "text": "。 もう一度読んでみましょう。 わかった。"}]
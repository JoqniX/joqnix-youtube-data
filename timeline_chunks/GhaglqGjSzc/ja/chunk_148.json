[{"type": "subtitle", "time": 8881.349, "timestamp": "02:28:01", "text": "今日の授業中に先生にアドバイスをもらいます。"}, {"type": "subtitle", "time": 8884.87, "timestamp": "02:28:04", "text": "またまた時間を無駄にしてサボっていることを後悔しているんですが、まあ、大丈夫です。あと、何かやります。よくわからない"}, {"type": "subtitle", "time": 8895.429, "timestamp": "02:28:15", "text": "けど、また"}, {"type": "subtitle", "time": 8905.67, "timestamp": "02:28:25", "text": "食べてください。そんなこと言わないで。待って、"}, {"type": "subtitle", "time": 8910.23, "timestamp": "02:28:30", "text": "自分を大切にしてください。はい。こんにちは。とにかく、"}, {"type": "subtitle", "time": 8915.99, "timestamp": "02:28:35", "text": "これで終わりにします。"}, {"type": "subtitle", "time": 8919.349, "timestamp": "02:28:39", "text": "短い配信でしたが、お付き合いありがとうございました。ええと、こんにちは。おそらく"}, {"type": "subtitle", "time": 8921.429, "timestamp": "02:28:41", "text": "明日も、"}, {"type": "subtitle", "time": 8923.83, "timestamp": "02:28:43", "text": "午後の授業の前に配信するので、"}, {"type": "subtitle", "time": 8927.51, "timestamp": "02:28:47", "text": "この時間くらいになると思います。それでは"}, {"type": "subtitle", "time": 8930.79, "timestamp": "02:28:50", "text": "終わりにします。それでは、改めて、"}, {"type": "subtitle", "time": 8937.19, "timestamp": "02:28:57", "text": "良い火曜日をお過ごしください。"}]
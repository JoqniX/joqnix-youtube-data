[{"type": "subtitle", "time": 6241.83, "timestamp": "01:44:01", "text": "あらまあ、こういう文法のこと、"}, {"type": "subtitle", "time": 6250.149, "timestamp": "01:44:10", "text": "こんにちは、キサ。おはようございます。"}, {"type": "subtitle", "time": 6252.149, "timestamp": "01:44:12", "text": "では、"}, {"type": "subtitle", "time": 6274.629, "timestamp": "01:44:34", "text": "昨日、公園を歩いているときに"}, {"type": "subtitle", "time": 6277.669, "timestamp": "01:44:37", "text": "、偶然、テシの奥さんが"}, {"type": "subtitle", "time": 6285.109, "timestamp": "01:44:45", "text": "問題は、私は"}, {"type": "subtitle", "time": 6289.669, "timestamp": "01:44:49", "text": "N5レベルではないので、基本的な日本語が使えないということです。"}, {"type": "subtitle", "time": 6293.43, "timestamp": "01:44:53", "text": "現在N4を勉強中です。だから、"}, {"type": "subtitle", "time": 6295.83, "timestamp": "01:44:55", "text": "基本的な文を拡張して"}, {"type": "subtitle", "time": 6299.59, "timestamp": "01:44:59", "text": "もっと"}]
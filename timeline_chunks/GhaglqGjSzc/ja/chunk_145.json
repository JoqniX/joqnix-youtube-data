[{"type": "subtitle", "time": 8705.67, "timestamp": "02:25:05", "text": "。いや、私はホットでも何でもない"}, {"type": "subtitle", "time": 8708.23, "timestamp": "02:25:08", "text": "。自分の写真は撮らない"}, {"type": "subtitle", "time": 8712.07, "timestamp": "02:25:12", "text": "。"}, {"type": "subtitle", "time": 8713.91, "timestamp": "02:25:13", "text": "自分のことが嫌いだとは言いたくないけど、"}, {"type": "subtitle", "time": 8719.19, "timestamp": "02:25:19", "text": "もっと内向的になるようにしてるけど、"}, {"type": "subtitle", "time": 8734.469, "timestamp": "02:25:34", "text": "心の健康はすごく大事だよね？"}, {"type": "subtitle", "time": 8744.79, "timestamp": "02:25:44", "text": "ああ、待って。ああ、私のもの。えーと、"}]
[{"type": "subtitle", "time": 5221.91, "timestamp": "01:27:01", "text": "何かを送ってくれる。"}, {"type": "subtitle", "time": 5233.35, "timestamp": "01:27:13", "text": "見栄えの良い何かオーケー。"}, {"type": "subtitle", "time": 5251.83, "timestamp": "01:27:31", "text": "私にくれる。オーケー。"}, {"type": "subtitle", "time": 5257.91, "timestamp": "01:27:37", "text": "ええと、鍵は、ええと、待つことができるように、"}, {"type": "subtitle", "time": 5269.27, "timestamp": "01:27:49", "text": "次に来るのを待つ。オーケー。"}, {"type": "subtitle", "time": 5271.11, "timestamp": "01:27:51", "text": "こんにちは、"}, {"type": "subtitle", "time": 5279.75, "timestamp": "01:27:59", "text": "人。"}]
[{"type": "subtitle", "time": 6674.149, "timestamp": "01:51:14", "text": "ケイ、マッシュ。"}, {"type": "subtitle", "time": 6676.55, "timestamp": "01:51:16", "text": "それで、"}, {"type": "subtitle", "time": 6678.709, "timestamp": "01:51:18", "text": "待って、待って、待って、待って、私は何をしているんだろう"}, {"type": "subtitle", "time": 6680.95, "timestamp": "01:51:20", "text": "? 次の英語の文章は、"}, {"type": "subtitle", "time": 6685.03, "timestamp": "01:51:25", "text": "アルバイトを終えて"}, {"type": "subtitle", "time": 6699.03, "timestamp": "01:51:39", "text": "アパートに戻る途中、"}, {"type": "subtitle", "time": 6702.229, "timestamp": "01:51:42", "text": "メアリー夫人が"}, {"type": "subtitle", "time": 6705.189, "timestamp": "01:51:45", "text": "彼女に別れを告げているのを見ました。   いや"}, {"type": "subtitle", "time": 6708.629, "timestamp": "01:51:48", "text": "、待って。 変えてみましょう。 えーっと、"}, {"type": "subtitle", "time": 6711.189, "timestamp": "01:51:51", "text": "アルバイト終わったから帰るよって言ったよ"}, {"type": "subtitle", "time": 6715.43, "timestamp": "01:51:55", "text": "ね？"}]
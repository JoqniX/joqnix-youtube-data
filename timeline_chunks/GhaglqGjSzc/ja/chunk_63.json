[{"type": "subtitle", "time": 3782.309, "timestamp": "01:03:02", "text": "セーターをティーシにあげるんです。ティーシは"}, {"type": "subtitle", "time": 3789.349, "timestamp": "01:03:09", "text": "メアリーからバレンタインのプレゼントをもらってとても驚いて喜んでいて、「"}, {"type": "subtitle", "time": 3798.549, "timestamp": "01:03:18", "text": "自分で編んだの？」と聞いて、メアリーは「ええ、編みました。"}, {"type": "subtitle", "time": 3803.43, "timestamp": "01:03:23", "text": "小さいかな、えーっと」と答えると、"}, {"type": "subtitle", "time": 3820.87, "timestamp": "01:03:40", "text": "ありがとう」と言うんです。"}, {"type": "subtitle", "time": 3825.829, "timestamp": "01:03:45", "text": "こんにちは。ええと、これは翻訳です。"}, {"type": "subtitle", "time": 3828.39, "timestamp": "01:03:48", "text": "必要でしたか？ああ、そうそう、もう一つ忘れてた"}, {"type": "subtitle", "time": 3830.549, "timestamp": "01:03:50", "text": "。ああ、こういうのが欲しかったんです これ。"}, {"type": "subtitle", "time": 3833.349, "timestamp": "01:03:53", "text": "うん。うん、これは重要だった。"}, {"type": "subtitle", "time": 3834.95, "timestamp": "01:03:54", "text": "えーと、"}]
[{"type": "subtitle", "time": 3600.71, "timestamp": "01:00:00", "text": "ヤンド。ああ、あなたはしないの？なぜ"}, {"type": "subtitle", "time": 3623.03, "timestamp": "01:00:23", "text": "編むという意味、ええとcomコンピレーション。"}, {"type": "subtitle", "time": 3641.67, "timestamp": "01:00:41", "text": "私はヤミカンが好きですが、それは"}, {"type": "subtitle", "time": 3645.51, "timestamp": "01:00:45", "text": "クニー語であんな風に朗読してくれたらもっと良かったのに"}, {"type": "subtitle", "time": 3647.99, "timestamp": "01:00:47", "text": "。"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "ええと、えーっと、プレーンブレード、ツイスト、編集、"}, {"type": "subtitle", "time": 3659.03, "timestamp": "01:00:59", "text": "完成した詩、本の一部。こんにちは。"}]
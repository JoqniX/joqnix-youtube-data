[{"type": "subtitle", "time": 5880.709, "timestamp": "01:38:00", "text": "ああ、このミカシュタを使えばよかったのに"}, {"type": "subtitle", "time": 5885.27, "timestamp": "01:38:05", "text": "。それで、"}, {"type": "subtitle", "time": 5891.03, "timestamp": "01:38:11", "text": "公園を散歩しています。テシの奥さんが公園に座っているのを見ました"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "。"}, {"type": "subtitle", "time": 5896.39, "timestamp": "01:38:16", "text": "公園のベンチに座っていました。なんて"}, {"type": "subtitle", "time": 5898.629, "timestamp": "01:38:18", "text": "言えばいいでしょうか？待って、"}, {"type": "subtitle", "time": 5901.35, "timestamp": "01:38:21", "text": "なんて言えばいいでしょうか？"}, {"type": "subtitle", "time": 5908.39, "timestamp": "01:38:28", "text": "インドで日本語を勉強している人に会ったことはありません。"}, {"type": "subtitle", "time": 5910.229, "timestamp": "01:38:30", "text": "ええ、インドからはたくさんの人が"}, {"type": "subtitle", "time": 5917.91, "timestamp": "01:38:37", "text": "アニメなどに興味を持っているので、ええと、日本語を学んでいます"}, {"type": "subtitle", "time": 5920.87, "timestamp": "01:38:40", "text": "。いいえ、だから彼らは日本語を学ぼうとして、"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "JPT試験やNAT試験を受けようとしています。ええ。ええ。"}, {"type": "subtitle", "time": 5935.52, "timestamp": "01:38:55", "text": "ええ。 インド出身で"}, {"type": "subtitle", "time": 5938.08, "timestamp": "01:38:58", "text": "インド出身で 日本語を勉強しようとしている人を何人か知っています。"}]
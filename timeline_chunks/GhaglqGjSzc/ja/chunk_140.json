[{"type": "subtitle", "time": 8405.19, "timestamp": "02:20:05", "text": "おい。   ああ、そうだ。   わかった"}, {"type": "subtitle", "time": 8413.75, "timestamp": "02:20:13", "text": "。 えっと、今日って火曜日みたいな感じですよね"}, {"type": "subtitle", "time": 8416.23, "timestamp": "02:20:16", "text": "？ わかった。 だから、明日は"}, {"type": "subtitle", "time": 8418.07, "timestamp": "02:20:18", "text": "配信できるかどうか分かりません。 えっと…何だか分かる？"}, {"type": "subtitle", "time": 8422.389, "timestamp": "02:20:22", "text": "もう一度ストリーミング配信してみようと思います。ストリーミング配信する場合は、現時点ではこれに非常に注意を"}, {"type": "subtitle", "time": 8426.15, "timestamp": "02:20:26", "text": "払わなければならないため、安定したストリーミング配信しかできません"}, {"type": "subtitle", "time": 8432.79, "timestamp": "02:20:32", "text": "。"}, {"type": "subtitle", "time": 8443.03, "timestamp": "02:20:43", "text": "他のニュースとしては、最近"}, {"type": "subtitle", "time": 8445.11, "timestamp": "02:20:45", "text": "何か作ったんです。 えっと、それが"}, {"type": "subtitle", "time": 8448.15, "timestamp": "02:20:48", "text": "今日私がストリーミング配信をする理由でもあります。"}, {"type": "subtitle", "time": 8451.11, "timestamp": "02:20:51", "text": "それで、ええと、私が最近やっていたアーカイブ ウェブサイトのことですよね"}, {"type": "subtitle", "time": 8454.71, "timestamp": "02:20:54", "text": "？"}, {"type": "subtitle", "time": 8457.51, "timestamp": "02:20:57", "text": "えっと、キックチャットがログに記録されます。"}, {"type": "subtitle", "time": 8459.349, "timestamp": "02:20:59", "text": "彼はそれで、"}]
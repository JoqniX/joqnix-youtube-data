[{"type": "subtitle", "time": 6721.589, "timestamp": "01:52:01", "text": "家に帰ると、メアリーが"}, {"type": "subtitle", "time": 6726.149, "timestamp": "01:52:06", "text": "仕事から帰ってきた夫に挨拶しているのが見えます。"}, {"type": "subtitle", "time": 6728.87, "timestamp": "01:52:08", "text": "右。 それは良い"}, {"type": "subtitle", "time": 6730.629, "timestamp": "01:52:10", "text": "例です。   何てことだ"}, {"type": "subtitle", "time": 6733.27, "timestamp": "01:52:13", "text": "。"}, {"type": "subtitle", "time": 6735.75, "timestamp": "01:52:15", "text": "今、私は苦労しています。 しかし、ある意味では、"}, {"type": "subtitle", "time": 6739.109, "timestamp": "01:52:19", "text": "これらすべてを声に出して言わなければなりませんよね?"}, {"type": "subtitle", "time": 6741.83, "timestamp": "01:52:21", "text": "そうそう。 さよなら。"}, {"type": "subtitle", "time": 6775.99, "timestamp": "01:52:55", "text": "事故だったの？ いや。待って。"}, {"type": "subtitle", "time": 6779.03, "timestamp": "01:52:59", "text": "ああ神様。 いいえ。日本人は何かを経験するのです"}]
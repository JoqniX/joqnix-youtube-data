[{"type": "subtitle", "time": 8042.55, "timestamp": "02:14:02", "text": "。 わかった。"}, {"type": "subtitle", "time": 8044.79, "timestamp": "02:14:04", "text": "私はしませんでした。 そうそう。 それでどうやら私は"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "ヴァラガニに行ったようです。"}, {"type": "subtitle", "time": 8050.39, "timestamp": "02:14:10", "text": "インドのその場所を知っているかどうか分かりません。   えっと、"}, {"type": "subtitle", "time": 8053.51, "timestamp": "02:14:13", "text": "家族と一緒にそこへ行きました。 私たちは"}, {"type": "subtitle", "time": 8056.87, "timestamp": "02:14:16", "text": "教会などを訪問しました。"}, {"type": "subtitle", "time": 8059.589, "timestamp": "02:14:19", "text": "そうですね、コミュニティを投稿しました。"}, {"type": "subtitle", "time": 8061.99, "timestamp": "02:14:21", "text": "コミュニティ投稿をしました。"}, {"type": "subtitle", "time": 8066.149, "timestamp": "02:14:26", "text": "実は鳩の写真も撮りました。"}, {"type": "subtitle", "time": 8069.109, "timestamp": "02:14:29", "text": "鳩の写真を撮りました。"}, {"type": "subtitle", "time": 8072.87, "timestamp": "02:14:32", "text": "待ってください、見つけさせてください。"}, {"type": "subtitle", "time": 8083.189, "timestamp": "02:14:43", "text": "鳩がたくさんいるようです。"}, {"type": "subtitle", "time": 8085.99, "timestamp": "02:14:45", "text": "それで私たちはここに行って、確かモスクを見たんですが、その"}, {"type": "subtitle", "time": 8092.87, "timestamp": "02:14:52", "text": "建物の上には"}, {"type": "subtitle", "time": 8098.229, "timestamp": "02:14:58", "text": "鳩がたくさんいたんです。 ちょっと待って、その投稿はどこにあるの？ はい、見つかりました"}]
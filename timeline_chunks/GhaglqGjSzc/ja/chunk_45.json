[{"type": "subtitle", "time": 2701.109, "timestamp": "00:45:01", "text": "それで、彼は"}, {"type": "subtitle", "time": 2704.39, "timestamp": "00:45:04", "text": "ここに来た目的の話に戻った。それで、"}, {"type": "subtitle", "time": 2708.95, "timestamp": "00:45:08", "text": "ジョンは「えっと、この"}, {"type": "subtitle", "time": 2711.75, "timestamp": "00:45:11", "text": "カレー、えっと、"}, {"type": "subtitle", "time": 2718.87, "timestamp": "00:45:18", "text": "本当に、えっと、一番おすすめ、えっと、"}, {"type": "subtitle", "time": 2726.87, "timestamp": "00:45:26", "text": "ニンキが人気なの」って感じだった。「えっと、待って。"}, {"type": "subtitle", "time": 2730.87, "timestamp": "00:45:30", "text": "ニンキモナ有名でしょ？このカレーは"}, {"type": "subtitle", "time": 2735.27, "timestamp": "00:45:35", "text": "ここで一番人気だよ」って言ってた。「えっと、"}, {"type": "subtitle", "time": 2739.03, "timestamp": "00:45:39", "text": "彼はそう言ってたし、ヤマシ、えっと、"}, {"type": "subtitle", "time": 2742.23, "timestamp": "00:45:42", "text": "美味しそう。じゃあ、それを"}, {"type": "subtitle", "time": 2746.71, "timestamp": "00:45:46", "text": "食べよう」って。"}, {"type": "subtitle", "time": 2750.39, "timestamp": "00:45:50", "text": "私の翻訳は下手だ。うん"}, {"type": "subtitle", "time": 2754.55, "timestamp": "00:45:54", "text": "。じゃあね。わかった。実際は1時だよ。わかった。1"}, {"type": "subtitle", "time": 2758.47, "timestamp": "00:45:58", "text": "つじゃない。えっと、わかった。これが私たちが"}]
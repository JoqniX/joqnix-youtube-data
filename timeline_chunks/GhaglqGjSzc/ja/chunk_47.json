[{"type": "subtitle", "time": 2823.349, "timestamp": "00:47:03", "text": "伝統的なもの、"}, {"type": "subtitle", "time": 2825.589, "timestamp": "00:47:05", "text": "kji"}, {"type": "subtitle", "time": 2835.03, "timestamp": "00:47:15", "text": "セーターをセットして、えーっと"}, {"type": "subtitle", "time": 2841.19, "timestamp": "00:47:21", "text": "、待って。えーっと"}, {"type": "subtitle", "time": 2850.71, "timestamp": "00:47:30", "text": "、gaki。待って。ギガキ。ああ"}, {"type": "subtitle", "time": 2855.2, "timestamp": "00:47:35", "text": "。ああ 、待って。ガキとガキは違うの。ああそうそう。ああ、待って。忘れてた。ああそうそう。"}, {"type": "subtitle", "time": 2870.39, "timestamp": "00:47:50", "text": "ゴキってパンみたいな。うん。ギ。うん。ギ。えーっと、ちょっと"}]
[{"type": "subtitle", "time": 6151.27, "timestamp": "01:42:31", "text": "ああ、続きをありがとう。"}, {"type": "subtitle", "time": 6153.75, "timestamp": "01:42:33", "text": "マック・ザ・ナイフ。続きをありがとう"}, {"type": "subtitle", "time": 6156.149, "timestamp": "01:42:36", "text": "。こんにちは。こんにちは。ようこそ。おはようございます"}, {"type": "subtitle", "time": 6157.99, "timestamp": "01:42:37", "text": "。"}, {"type": "subtitle", "time": 6160.39, "timestamp": "01:42:40", "text": "ええと 複数の"}, {"type": "subtitle", "time": 6162.39, "timestamp": "01:42:42", "text": "行動を1つの長い考えにつなげようとしているんですね。では、"}, {"type": "subtitle", "time": 6174.07, "timestamp": "01:42:54", "text": "仕事しながら歩いている」。"}]
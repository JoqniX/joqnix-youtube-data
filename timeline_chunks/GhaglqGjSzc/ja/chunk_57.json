[{"type": "subtitle", "time": 3421.27, "timestamp": "00:57:01", "text": "もう6ヶ月"}, {"type": "subtitle", "time": 3424.47, "timestamp": "00:57:04", "text": "勉強しているんですが、サボってます。勉強したく"}, {"type": "subtitle", "time": 3427.03, "timestamp": "00:57:07", "text": "ないし、"}, {"type": "subtitle", "time": 3431.19, "timestamp": "00:57:11", "text": "次の6ヶ月も勉強したら、時間を無駄にしてしまうので、すぐにでも"}, {"type": "subtitle", "time": 3435.91, "timestamp": "00:57:15", "text": "入学したいんです。でも、まだ"}, {"type": "subtitle", "time": 3438.23, "timestamp": "00:57:18", "text": "準備ができていないような気がします。 エントリーへ移動します。"}, {"type": "subtitle", "time": 3442.39, "timestamp": "00:57:22", "text": "読解力と漢字の読み書き、"}, {"type": "subtitle", "time": 3445.51, "timestamp": "00:57:25", "text": "そして文法の使い方が足りないからです。"}, {"type": "subtitle", "time": 3449.67, "timestamp": "00:57:29", "text": "文法の使い方も最低です。ええ、"}, {"type": "subtitle", "time": 3452.069, "timestamp": "00:57:32", "text": "本当にひどいです。頑張らなきゃ。ええ。じゃあね。"}, {"type": "subtitle", "time": 3459.19, "timestamp": "00:57:39", "text": "頑張らなきゃ。"}, {"type": "subtitle", "time": 3472.069, "timestamp": "00:57:52", "text": "チャットが読めるように横に置いておきましょう。はい。こんにちは。ええと、"}]
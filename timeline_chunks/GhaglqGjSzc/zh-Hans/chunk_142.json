[{"type": "subtitle", "time": 8524.23, "timestamp": "02:22:04", "text": "感情关系很重要。我以前"}, {"type": "subtitle", "time": 8527.75, "timestamp": "02:22:07", "text": "有过不少糟糕的感情经历，"}, {"type": "subtitle", "time": 8529.59, "timestamp": "02:22:09", "text": "老兄。"}, {"type": "subtitle", "time": 8533.67, "timestamp": "02:22:13", "text": "我不想再经历一次了。"}, {"type": "subtitle", "time": 8535.27, "timestamp": "02:22:15", "text": "不，"}, {"type": "subtitle", "time": 8543.83, "timestamp": "02:22:23", "text": "哦，天哪。与其说是像个男人一样去咬人，不如说更像是"}, {"type": "subtitle", "time": 8555.83, "timestamp": "02:22:35", "text": "单相思之类的"}, {"type": "subtitle", "time": 8557.83, "timestamp": "02:22:37", "text": "。"}, {"type": "subtitle", "time": 8562.469, "timestamp": "02:22:42", "text": "有些人来找我，我拒绝了。那"}, {"type": "subtitle", "time": 8567.59, "timestamp": "02:22:47", "text": "是一种尴尬的暧昧关系。是的。"}, {"type": "subtitle", "time": 8569.59, "timestamp": "02:22:49", "text": "呃，是的，"}, {"type": "subtitle", "time": 8572.95, "timestamp": "02:22:52", "text": "我的意思是，现在我的事情"}, {"type": "subtitle", "time": 8575.99, "timestamp": "02:22:55", "text": "已经公开了。不管发生了什么，"}, {"type": "subtitle", "time": 8579.349, "timestamp": "02:22:59", "text": "因为我不得不说，是的，"}]
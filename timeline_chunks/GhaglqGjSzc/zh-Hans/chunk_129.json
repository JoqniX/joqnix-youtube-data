[{"type": "subtitle", "time": 7747.43, "timestamp": "02:09:07", "text": "哦，我忘了还有这回事。"}, {"type": "subtitle", "time": 7751.27, "timestamp": "02:09:11", "text": "又一个小的。 是的，我不"}, {"type": "subtitle", "time": 7754.47, "timestamp": "02:09:14", "text": "擅长这些。"}, {"type": "subtitle", "time": 7757.83, "timestamp": "02:09:17", "text": "离开。 对不起。   是的"}, {"type": "subtitle", "time": 7760.149, "timestamp": "02:09:20", "text": "。"}, {"type": "subtitle", "time": 7762.709, "timestamp": "02:09:22", "text": "我的天啊。 这就是我为什么这么容易轻信他人的原因。"}, {"type": "subtitle", "time": 7764.47, "timestamp": "02:09:24", "text": "我觉得"}, {"type": "subtitle", "time": 7786.39, "timestamp": "02:09:46", "text": "不，是"}, {"type": "subtitle", "time": 7789.35, "timestamp": "02:09:49", "text": "啊，我太容易上当受骗了。 我的天啊。"}, {"type": "subtitle", "time": 7791.99, "timestamp": "02:09:51", "text": "这个世界承受不了这么多。"}]
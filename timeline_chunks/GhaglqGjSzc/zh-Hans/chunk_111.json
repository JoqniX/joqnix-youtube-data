[{"type": "subtitle", "time": 6674.149, "timestamp": "01:51:14", "text": "凯捣碎。"}, {"type": "subtitle", "time": 6678.709, "timestamp": "01:51:18", "text": "等等等等等等，我到底在干什么"}, {"type": "subtitle", "time": 6680.95, "timestamp": "01:51:20", "text": "？ 接下来，呃，英语句子"}, {"type": "subtitle", "time": 6685.03, "timestamp": "01:51:25", "text": "会是：做完兼职后，"}, {"type": "subtitle", "time": 6699.03, "timestamp": "01:51:39", "text": "回公寓的路上，我看到"}, {"type": "subtitle", "time": 6702.229, "timestamp": "01:51:42", "text": "玛丽太太在"}, {"type": "subtitle", "time": 6705.189, "timestamp": "01:51:45", "text": "跟她道别。"}, {"type": "subtitle", "time": 6708.629, "timestamp": "01:51:48", "text": "不，等等。 我们来改变它。 我说，呃，"}, {"type": "subtitle", "time": 6711.189, "timestamp": "01:51:51", "text": "我已经完成兼职工作了，我要"}, {"type": "subtitle", "time": 6715.43, "timestamp": "01:51:55", "text": "回家了，对吧？ 我可以这样说：嗯……"}]
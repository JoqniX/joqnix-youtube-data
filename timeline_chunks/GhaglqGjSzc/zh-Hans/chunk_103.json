[{"type": "subtitle", "time": 6192.47, "timestamp": "01:43:12", "text": "呃，我一边走路一边走路，然后Nagada"}, {"type": "subtitle", "time": 6195.91, "timestamp": "01:43:15", "text": "是用来同时做两件事的，比如"}, {"type": "subtitle", "time": 6199.59, "timestamp": "01:43:19", "text": "边走边吃。啊，原来如此，"}, {"type": "subtitle", "time": 6217.27, "timestamp": "01:43:37", "text": "啊，我的错。好的。呃，okusan。"}, {"type": "subtitle", "time": 6219.83, "timestamp": "01:43:39", "text": "哦，好的。因为妻子是人，而你指的"}, {"type": "subtitle", "time": 6222.229, "timestamp": "01:43:42", "text": "是动作的对象，所以我们"}, {"type": "subtitle", "time": 6225.189, "timestamp": "01:43:45", "text": "用o。哦。"}, {"type": "subtitle", "time": 6233.35, "timestamp": "01:43:53", "text": "要表示某人处于主动坐姿，我们使用"}, {"type": "subtitle", "time": 6237.99, "timestamp": "01:43:57", "text": "they形式加上 不。"}]
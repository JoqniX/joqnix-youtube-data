[{"type": "subtitle", "time": 2350.39, "timestamp": "00:39:10", "text": "我的天哪，我居然读对了。"}, {"type": "subtitle", "time": 2353.109, "timestamp": "00:39:13", "text": "哇，我居然读对了。我的天哪。"}, {"type": "subtitle", "time": 2356.069, "timestamp": "00:39:16", "text": "不错。"}, {"type": "subtitle", "time": 2359.75, "timestamp": "00:39:19", "text": "我的天哪。我……我有能力"}, {"type": "subtitle", "time": 2371.51, "timestamp": "00:39:31", "text": "我真的做到了。好的。好的。所以"}, {"type": "subtitle", "time": 2375.51, "timestamp": "00:39:35", "text": "翻译是这样的：两个人都在"}, {"type": "subtitle", "time": 2379.109, "timestamp": "00:39:39", "text": "餐厅里，然后老板乔说，"}, {"type": "subtitle", "time": 2382.95, "timestamp": "00:39:42", "text": "呃，一个儿子实际上是约翰的"}, {"type": "subtitle", "time": 2386.63, "timestamp": "00:39:46", "text": "姓。所以约翰，呃，"}, {"type": "subtitle", "time": 2389.27, "timestamp": "00:39:49", "text": "你为什么选择……呃，你为什么选择……"}, {"type": "subtitle", "time": 2394.15, "timestamp": "00:39:54", "text": "呃，就像，是的，"}, {"type": "subtitle", "time": 2398.95, "timestamp": "00:39:58", "text": "你为什么选择这份……呃，这份"}]
[{"type": "subtitle", "time": 8042.55, "timestamp": "02:14:02", "text": "嗯，我们就此结束吧。 好的。"}, {"type": "subtitle", "time": 8044.79, "timestamp": "02:14:04", "text": "我没有。 哦，是的。 所以，我显然去了"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "瓦拉加尼。 我不知道你是否了解"}, {"type": "subtitle", "time": 8050.39, "timestamp": "02:14:10", "text": "印度的那个地方。"}, {"type": "subtitle", "time": 8053.51, "timestamp": "02:14:13", "text": "嗯，所以我和家人一起去了那里。 我们"}, {"type": "subtitle", "time": 8056.87, "timestamp": "02:14:16", "text": "参观了教堂。"}, {"type": "subtitle", "time": 8059.589, "timestamp": "02:14:19", "text": "我想我……是的，我发帖到社区了。 我"}, {"type": "subtitle", "time": 8061.99, "timestamp": "02:14:21", "text": "发了一篇社区帖子。 我"}, {"type": "subtitle", "time": 8066.149, "timestamp": "02:14:26", "text": "其实拍了一些鸽子之类的照片。"}, {"type": "subtitle", "time": 8069.109, "timestamp": "02:14:29", "text": "我拍了鸽子的照片。"}, {"type": "subtitle", "time": 8072.87, "timestamp": "02:14:32", "text": "等等，让我找找。"}, {"type": "subtitle", "time": 8076.229, "timestamp": "02:14:36", "text": "我拍了一些偶然遇到的鸽子的照片"}, {"type": "subtitle", "time": 8083.189, "timestamp": "02:14:43", "text": "那里有很多鸽子。"}, {"type": "subtitle", "time": 8085.99, "timestamp": "02:14:45", "text": "所以我们去了那里，我们看到了一座"}, {"type": "subtitle", "time": 8088.95, "timestamp": "02:14:48", "text": "清真寺，我记得是这样，在其中"}, {"type": "subtitle", "time": 8092.87, "timestamp": "02:14:52", "text": "一座建筑物的顶部有"}, {"type": "subtitle", "time": 8095.51, "timestamp": "02:14:55", "text": "很多"}, {"type": "subtitle", "time": 8098.229, "timestamp": "02:14:58", "text": "鸽子。 等等，那篇帖子在哪儿？ 好了，"}]
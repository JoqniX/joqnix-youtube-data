[{"type": "subtitle", "time": 3600.71, "timestamp": "01:00:00", "text": "Yan do。哦，你是……不是吗？"}, {"type": "subtitle", "time": 3623.03, "timestamp": "01:00:23", "text": "意思是编织……呃……com compilation。"}, {"type": "subtitle", "time": 3641.67, "timestamp": "01:00:41", "text": "我喜欢Yamikan，但如果"}, {"type": "subtitle", "time": 3645.51, "timestamp": "01:00:45", "text": "他们"}, {"type": "subtitle", "time": 3647.99, "timestamp": "01:00:47", "text": "像这样用Kuny读音就更好了。我想我得让你去"}, {"type": "subtitle", "time": 3656.789, "timestamp": "01:00:56", "text": "好的。呃，编织，平针，辫子，扭针，编辑，"}, {"type": "subtitle", "time": 3659.03, "timestamp": "01:00:59", "text": "完成的诗，书的一部分。嗨。"}]
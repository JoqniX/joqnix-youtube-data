[{"type": "subtitle", "time": 8462.95, "timestamp": "02:21:02", "text": "我呃，就像做了个录音机一样。 它会"}, {"type": "subtitle", "time": 8466.389, "timestamp": "02:21:06", "text": "在我直播时扫描我的聊天记录。 是的，"}, {"type": "subtitle", "time": 8469.51, "timestamp": "02:21:09", "text": "24小时频道和开玩笑"}, {"type": "subtitle", "time": 8471.19, "timestamp": "02:21:11", "text": "频道都是如此。 每当有新消息时，"}, {"type": "subtitle", "time": 8475.83, "timestamp": "02:21:15", "text": "它都会进行扫描。 它大约每6小时运行一次。"}, {"type": "subtitle", "time": 8479.19, "timestamp": "02:21:19", "text": "呃，我做过那件事。 是的。 所以我就想，我还有"}, {"type": "subtitle", "time": 8481.03, "timestamp": "02:21:21", "text": "更多事情要做。 然后我"}, {"type": "subtitle", "time": 8483.27, "timestamp": "02:21:23", "text": "就想，“是啊，学习才是最重要的，对吧？"}, {"type": "subtitle", "time": 8485.51, "timestamp": "02:21:25", "text": "考试才是最重要的。"}, {"type": "subtitle", "time": 8489.429, "timestamp": "02:21:29", "text": "那些事我先放一边，"}, {"type": "subtitle", "time": 8491.349, "timestamp": "02:21:31", "text": "以后再说。"}, {"type": "subtitle", "time": 8494.15, "timestamp": "02:21:34", "text": "不是说这些"}, {"type": "subtitle", "time": 8504.389, "timestamp": "02:21:44", "text": "12号还是13号要上 Fortnite 了。"}, {"type": "subtitle", "time": 8507.27, "timestamp": "02:21:47", "text": "对，13号。"}, {"type": "subtitle", "time": 8510.87, "timestamp": "02:21:50", "text": "天哪，我的 Oshi 要上 Fortnite 了。我"}, {"type": "subtitle", "time": 8514.63, "timestamp": "02:21:54", "text": "想买她，但我没钱。"}, {"type": "subtitle", "time": 8517.429, "timestamp": "02:21:57", "text": "呃，"}]
[{"type": "subtitle", "time": 6241.83, "timestamp": "01:44:01", "text": "我的天哪，这些语法东西"}, {"type": "subtitle", "time": 6250.149, "timestamp": "01:44:10", "text": "你好，Kisa。早上好。"}, {"type": "subtitle", "time": 6252.149, "timestamp": "01:44:12", "text": "好的，"}, {"type": "subtitle", "time": 6274.629, "timestamp": "01:44:34", "text": "昨天我在公园散步的时候"}, {"type": "subtitle", "time": 6277.669, "timestamp": "01:44:37", "text": "，碰巧看到Teshi的妻子"}, {"type": "subtitle", "time": 6285.109, "timestamp": "01:44:45", "text": "问题是我现在不能用基本的"}, {"type": "subtitle", "time": 6286.629, "timestamp": "01:44:46", "text": "日语，"}, {"type": "subtitle", "time": 6289.669, "timestamp": "01:44:49", "text": "因为我还没到N5水平。我"}, {"type": "subtitle", "time": 6293.43, "timestamp": "01:44:53", "text": "现在正在学习N4。所以我必须扩展一个"}, {"type": "subtitle", "time": 6295.83, "timestamp": "01:44:55", "text": "基本的句子，"}, {"type": "subtitle", "time": 6299.59, "timestamp": "01:44:59", "text": "让它更"}]
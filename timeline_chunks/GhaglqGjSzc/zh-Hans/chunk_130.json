[{"type": "subtitle", "time": 7808.229, "timestamp": "02:10:08", "text": "你太天真了。 是啊，我太"}, {"type": "subtitle", "time": 7811.109, "timestamp": "02:10:11", "text": "单纯了，这不好。"}, {"type": "subtitle", "time": 7813.51, "timestamp": "02:10:13", "text": "我因为太过天真而受了很多苦"}, {"type": "subtitle", "time": 7815.03, "timestamp": "02:10:15", "text": "。   是的"}, {"type": "subtitle", "time": 7824.79, "timestamp": "02:10:24", "text": "哦，现在应该是12点了。好的，我们已经过了"}, {"type": "subtitle", "time": 7828.95, "timestamp": "02:10:28", "text": "2点25分的标记。 不。好的。"}, {"type": "subtitle", "time": 7831.589, "timestamp": "02:10:31", "text": "所以，我可以预料到老师会打电话"}, {"type": "subtitle", "time": 7833.83, "timestamp": "02:10:33", "text": "或发信息告诉我，好了，"}, {"type": "subtitle", "time": 7837.27, "timestamp": "02:10:37", "text": "现在就来上课之类的。"}, {"type": "subtitle", "time": 7840.149, "timestamp": "02:10:40", "text": "呃，"}, {"type": "subtitle", "time": 7842.709, "timestamp": "02:10:42", "text": "好的。 我们可以过渡到"}, {"type": "subtitle", "time": 7845.109, "timestamp": "02:10:45", "text": "讨论环节，对吧？ 我们学习了2个"}, {"type": "subtitle", "time": 7846.79, "timestamp": "02:10:46", "text": "小时。"}, {"type": "subtitle", "time": 7857.109, "timestamp": "02:10:57", "text": "好的。 我好的。"}]
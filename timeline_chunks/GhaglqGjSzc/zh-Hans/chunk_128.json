[{"type": "subtitle", "time": 7681.91, "timestamp": "02:08:01", "text": "你当时在哪儿？ 哦，来吧。 哦，等等。 我"}, {"type": "subtitle", "time": 7684.87, "timestamp": "02:08:04", "text": "之前说过吗？我之前提过吗？"}, {"type": "subtitle", "time": 7687.589, "timestamp": "02:08:07", "text": "我超级笨，不擅长理解"}, {"type": "subtitle", "time": 7690.709, "timestamp": "02:08:10", "text": "笑话和论文主题。 所有那些东西。 所以，我很"}, {"type": "subtitle", "time": 7692.95, "timestamp": "02:08:12", "text": "重视这件事。"}, {"type": "subtitle", "time": 7696.229, "timestamp": "02:08:16", "text": "等等，我提过那条免责声明吗？ 我"}, {"type": "subtitle", "time": 7699.03, "timestamp": "02:08:19", "text": "应该把它写在某个地方，比如我的个人简介之类的"}, {"type": "subtitle", "time": 7701.51, "timestamp": "02:08:21", "text": "。 是的。 我"}, {"type": "subtitle", "time": 7703.43, "timestamp": "02:08:23", "text": "不明白别人为什么取笑我、跟我"}, {"type": "subtitle", "time": 7706.149, "timestamp": "02:08:26", "text": "开玩笑或者做"}, {"type": "subtitle", "time": 7716.629, "timestamp": "02:08:36", "text": "如果我不是那样，我就会听到"}, {"type": "subtitle", "time": 7725.43, "timestamp": "02:08:45", "text": "好的。 挑战时间。 我看得出来，萨拉萨让"}, {"type": "subtitle", "time": 7728.069, "timestamp": "02:08:48", "text": "你有点招架不住。"}, {"type": "subtitle", "time": 7731.03, "timestamp": "02:08:51", "text": "讽刺。 什么是讽刺来着？ 我的"}]
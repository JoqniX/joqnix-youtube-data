[{"type": "subtitle", "time": 8169.51, "timestamp": "02:16:09", "text": "天哪。"}, {"type": "subtitle", "time": 8173.03, "timestamp": "02:16:13", "text": "我有没有跟你们讲过"}, {"type": "subtitle", "time": 8174.79, "timestamp": "02:16:14", "text": "最近发生的事？哦，是的。 这是最近"}, {"type": "subtitle", "time": 8178.229, "timestamp": "02:16:18", "text": "发生的一件事。 好吧，我也可以这么说。 所以，"}, {"type": "subtitle", "time": 8181.43, "timestamp": "02:16:21", "text": "我的其中一只，呃，好吧，不是我的其中一只，我的"}, {"type": "subtitle", "time": 8184.069, "timestamp": "02:16:24", "text": "母猫，"}, {"type": "subtitle", "time": 8187.27, "timestamp": "02:16:27", "text": "呃，她已经生了孩子，我"}, {"type": "subtitle", "time": 8190.79, "timestamp": "02:16:30", "text": "想，呃，她"}, {"type": "subtitle", "time": 8193.19, "timestamp": "02:16:33", "text": "已经生了第七代孩子，现在"}, {"type": "subtitle", "time": 8195.99, "timestamp": "02:16:35", "text": "第八代孩子"}, {"type": "subtitle", "time": 8200.07, "timestamp": "02:16:40", "text": "显然要来了。 所以，我不知道为什么"}, {"type": "subtitle", "time": 8202.549, "timestamp": "02:16:42", "text": "最近每晚都有"}, {"type": "subtitle", "time": 8206.389, "timestamp": "02:16:46", "text": "这么多流浪猫来到我"}, {"type": "subtitle", "time": 8210.629, "timestamp": "02:16:50", "text": "家。 他们打得"}, {"type": "subtitle", "time": 8215.03, "timestamp": "02:16:55", "text": "就像在打仗一样。 它们就像在"}, {"type": "subtitle", "time": 8218.23, "timestamp": "02:16:58", "text": "嚎叫一样。我的狗"}]
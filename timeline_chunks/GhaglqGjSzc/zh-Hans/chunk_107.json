[{"type": "subtitle", "time": 6420.229, "timestamp": "01:47:00", "text": "呃，想象一下这样的场景："}, {"type": "subtitle", "time": 6429.109, "timestamp": "01:47:09", "text": "我现在正在回公寓。"}, {"type": "subtitle", "time": 6431.91, "timestamp": "01:47:11", "text": "我注意到妻子"}, {"type": "subtitle", "time": 6433.43, "timestamp": "01:47:13", "text": "玛丽正在"}, {"type": "subtitle", "time": 6441.27, "timestamp": "01:47:21", "text": "和她去上班的丈夫说再见"}, {"type": "subtitle", "time": 6444.79, "timestamp": "01:47:24", "text": "。我该怎么用日语写出来呢？"}, {"type": "subtitle", "time": 6447.109, "timestamp": "01:47:27", "text": "我的天哪。我这是在出"}, {"type": "subtitle", "time": 6456.709, "timestamp": "01:47:36", "text": "觉得这套系统简直是在用学习、学习、再学习折磨我们"}, {"type": "subtitle", "time": 6458.149, "timestamp": "01:47:38", "text": "。每个人都在"}, {"type": "subtitle", "time": 6460.07, "timestamp": "01:47:40", "text": "不停地学习，我们什么时候才能摆脱这个"}, {"type": "subtitle", "time": 6463.75, "timestamp": "01:47:43", "text": "循环？是啊，我知道你的感受，"}, {"type": "subtitle", "time": 6467.91, "timestamp": "01:47:47", "text": "因为就我而言，对吧，"}, {"type": "subtitle", "time": 6470.47, "timestamp": "01:47:50", "text": "我最近一直在偷懒。 上个月"}, {"type": "subtitle", "time": 6474.149, "timestamp": "01:47:54", "text": "我彻底懈怠了。整天"}, {"type": "subtitle", "time": 6477.669, "timestamp": "01:47:57", "text": "在床上睡觉，"}]
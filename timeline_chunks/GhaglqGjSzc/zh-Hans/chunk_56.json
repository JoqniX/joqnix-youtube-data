[{"type": "subtitle", "time": 3362.47, "timestamp": "00:56:02", "text": "学。我星期天有个考试。"}, {"type": "subtitle", "time": 3365.51, "timestamp": "00:56:05", "text": "而且，嗯，考试我要写，"}, {"type": "subtitle", "time": 3371.589, "timestamp": "00:56:11", "text": "我一直在，我得学习。"}, {"type": "subtitle", "time": 3377.19, "timestamp": "00:56:17", "text": "把所有东西都复习一遍。然后像要活下去一样努力学习"}, {"type": "subtitle", "time": 3380.63, "timestamp": "00:56:20", "text": "。是的，我"}, {"type": "subtitle", "time": 3382.87, "timestamp": "00:56:22", "text": "不能再失败第二次了。所以，我"}, {"type": "subtitle", "time": 3385.75, "timestamp": "00:56:25", "text": "必须学习。"}, {"type": "subtitle", "time": 3389.51, "timestamp": "00:56:29", "text": "我不想在日本被分到N4班"}, {"type": "subtitle", "time": 3393.27, "timestamp": "00:56:33", "text": "。好吧。如果"}, {"type": "subtitle", "time": 3396.15, "timestamp": "00:56:36", "text": "他们能把我分到N3班我会很开心，但如果被"}, {"type": "subtitle", "time": 3398.87, "timestamp": "00:56:38", "text": "分到N4班，那就意味着我已经"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "学了几个月的N4了？"}, {"type": "subtitle", "time": 3404.63, "timestamp": "00:56:44", "text": "嗯，去年"}, {"type": "subtitle", "time": 3407.349, "timestamp": "00:56:47", "text": "十月我开始上"}, {"type": "subtitle", "time": 3411.349, "timestamp": "00:56:51", "text": "N4的课，所以从十月到十一月，"}, {"type": "subtitle", "time": 3416.069, "timestamp": "00:56:56", "text": "十二月到一月，二月到"}, {"type": "subtitle", "time": 3417.99, "timestamp": "00:56:57", "text": "三月，一共六个月了。"}]
[{"type": "subtitle", "time": 7990.95, "timestamp": "02:13:10", "text": "13号晚上我要去"}, {"type": "subtitle", "time": 8000.55, "timestamp": "02:13:20", "text": "哦，对了，这将是我"}, {"type": "subtitle", "time": 8004.39, "timestamp": "02:13:24", "text": "和家人最后一次一起坐火车了。 我的天啊。"}, {"type": "subtitle", "time": 8006.229, "timestamp": "02:13:26", "text": "哦，是的。"}, {"type": "subtitle", "time": 8008.629, "timestamp": "02:13:28", "text": "我的天啊。"}, {"type": "subtitle", "time": 8010.79, "timestamp": "02:13:30", "text": "哦，等等。 我跟你们说过"}, {"type": "subtitle", "time": 8014.629, "timestamp": "02:13:34", "text": "我和家人一起旅行的事吗？ 就像我们"}, {"type": "subtitle", "time": 8019.91, "timestamp": "02:13:39", "text": "是的，"}, {"type": "subtitle", "time": 8023.669, "timestamp": "02:13:43", "text": "我们出去旅行了，玩得很开心。"}, {"type": "subtitle", "time": 8027.91, "timestamp": "02:13:47", "text": "呃，去过很多地方。"}, {"type": "subtitle", "time": 8033.91, "timestamp": "02:13:53", "text": "呃，我们要去的地方，我一会儿就在"}, {"type": "subtitle", "time": 8036.629, "timestamp": "02:13:56", "text": "这里。 我们聊了大概30"}, {"type": "subtitle", "time": 8039.03, "timestamp": "02:13:59", "text": "分钟左右。"}]
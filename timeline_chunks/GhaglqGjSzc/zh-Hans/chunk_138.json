[{"type": "subtitle", "time": 8280.79, "timestamp": "02:18:00", "text": "总是……嗯……"}, {"type": "subtitle", "time": 8283.75, "timestamp": "02:18:03", "text": "就像每当我走到"}, {"type": "subtitle", "time": 8288.549, "timestamp": "02:18:08", "text": "后院时，猫门"}, {"type": "subtitle", "time": 8291.509, "timestamp": "02:18:11", "text": "就会朝我走过来，好像在"}, {"type": "subtitle", "time": 8295.19, "timestamp": "02:18:15", "text": "摸摸我，摸摸我之类的。"}, {"type": "subtitle", "time": 8308.23, "timestamp": "02:18:28", "text": "向猫学习。 等等，"}, {"type": "subtitle", "time": 8312.23, "timestamp": "02:18:32", "text": "我不想……我觉得我现在不"}, {"type": "subtitle", "time": 8315.03, "timestamp": "02:18:35", "text": "应该……嗯……把注意力放在感情或其他任何事情上"}, {"type": "subtitle", "time": 8317.11, "timestamp": "02:18:37", "text": "。 我现在只想专注"}, {"type": "subtitle", "time": 8320.07, "timestamp": "02:18:40", "text": "于自己的生活。 那我以后再"}, {"type": "subtitle", "time": 8325.03, "timestamp": "02:18:45", "text": "考虑吧。 没事的。"}, {"type": "subtitle", "time": 8327.75, "timestamp": "02:18:47", "text": "我手头已经够忙的了。"}, {"type": "subtitle", "time": 8330.709, "timestamp": "02:18:50", "text": "目前的首要任务是"}, {"type": "subtitle", "time": 8332.79, "timestamp": "02:18:52", "text": "学习日语，"}, {"type": "subtitle", "time": 8335.349, "timestamp": "02:18:55", "text": "通过考试，拿到学位，"}, {"type": "subtitle", "time": 8339.509, "timestamp": "02:18:59", "text": "以后再读硕士。"}]
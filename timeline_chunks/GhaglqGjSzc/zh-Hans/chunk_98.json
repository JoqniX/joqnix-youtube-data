[{"type": "subtitle", "time": 5880.709, "timestamp": "01:38:00", "text": "啊，我本来可以用这个"}, {"type": "subtitle", "time": 5885.27, "timestamp": "01:38:05", "text": "mikashta的。所以，我在公园里散步"}, {"type": "subtitle", "time": 5891.03, "timestamp": "01:38:11", "text": "。我看到Teshi的妻子坐在"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "公园里。"}, {"type": "subtitle", "time": 5896.39, "timestamp": "01:38:16", "text": "坐在公园的长椅上。我该怎么说"}, {"type": "subtitle", "time": 5898.629, "timestamp": "01:38:18", "text": "呢？等等，"}, {"type": "subtitle", "time": 5901.35, "timestamp": "01:38:21", "text": "我该怎么说呢？我从来没见过有人"}, {"type": "subtitle", "time": 5905.109, "timestamp": "01:38:25", "text": "在学日语。 呃"}, {"type": "subtitle", "time": 5910.229, "timestamp": "01:38:30", "text": "，在印度的日本人。是的，有很多"}, {"type": "subtitle", "time": 5914.229, "timestamp": "01:38:34", "text": "印度人会学日语，"}, {"type": "subtitle", "time": 5917.91, "timestamp": "01:38:37", "text": "因为很多人都喜欢动漫之类的"}, {"type": "subtitle", "time": 5920.87, "timestamp": "01:38:40", "text": "。不，所以他们会尝试学习日语，"}, {"type": "subtitle", "time": 5925.99, "timestamp": "01:38:45", "text": "参加JPT考试或者NAT考试。"}, {"type": "subtitle", "time": 5929.43, "timestamp": "01:38:49", "text": "所以，是的。所以，是的。是的。是的"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "。我认识一些"}, {"type": "subtitle", "time": 5938.07, "timestamp": "01:38:58", "text": "来自印度的人，他们正在努力"}]
[{"type": "subtitle", "time": 6481.91, "timestamp": "01:48:01", "text": "半夜醒来，浪费时间看"}, {"type": "subtitle", "time": 6485.35, "timestamp": "01:48:05", "text": "动漫、看书、听"}, {"type": "subtitle", "time": 6488.31, "timestamp": "01:48:08", "text": "音乐什么的。我上个月好像没直播，反正就是这样"}, {"type": "subtitle", "time": 6491.59, "timestamp": "01:48:11", "text": "。现在我在拼命"}, {"type": "subtitle", "time": 6494.31, "timestamp": "01:48:14", "text": "复习，感觉无论如何都"}, {"type": "subtitle", "time": 6497.27, "timestamp": "01:48:17", "text": "不能挂科。我之前挂过"}, {"type": "subtitle", "time": 6503.189, "timestamp": "01:48:23", "text": "一次，而且不光是这个，我必须"}, {"type": "subtitle", "time": 6506.87, "timestamp": "01:48:26", "text": "学习，"}, {"type": "subtitle", "time": 6509.189, "timestamp": "01:48:29", "text": "不管怎样。我其实一直在"}, {"type": "subtitle", "time": 6511.43, "timestamp": "01:48:31", "text": "考虑要不要暂停"}, {"type": "subtitle", "time": 6516.39, "timestamp": "01:48:36", "text": "直播，因为去"}, {"type": "subtitle", "time": 6519.669, "timestamp": "01:48:39", "text": "日本之后，不仅要学日语，还要"}, {"type": "subtitle", "time": 6521.99, "timestamp": "01:48:41", "text": "兼职，还要"}, {"type": "subtitle", "time": 6526.39, "timestamp": "01:48:46", "text": "准备"}, {"type": "subtitle", "time": 6532.07, "timestamp": "01:48:52", "text": "英语文学考试，还有之前在"}, {"type": "subtitle", "time": 6536.95, "timestamp": "01:48:56", "text": "日本落下的那些作业。"}]
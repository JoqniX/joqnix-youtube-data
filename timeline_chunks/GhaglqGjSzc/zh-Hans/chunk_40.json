[{"type": "subtitle", "time": 2407.109, "timestamp": "00:40:07", "text": "兼职工作……为什么……呃，我该怎么说呢……"}, {"type": "subtitle", "time": 2410.63, "timestamp": "00:40:10", "text": "呃，是什么让你对这份"}, {"type": "subtitle", "time": 2413.91, "timestamp": "00:40:13", "text": "兼职工作感兴趣？老板问道。 老板问"}, {"type": "subtitle", "time": 2416.71, "timestamp": "00:40:16", "text": "约翰，约翰回答说这很"}, {"type": "subtitle", "time": 2418.23, "timestamp": "00:40:18", "text": "有趣，"}, {"type": "subtitle", "time": 2423.19, "timestamp": "00:40:23", "text": "而且可以认识新朋友。"}, {"type": "subtitle", "time": 2425.51, "timestamp": "00:40:25", "text": "嗯，是的，可以认识新朋友，而且"}, {"type": "subtitle", "time": 2428.79, "timestamp": "00:40:28", "text": "还可以"}, {"type": "subtitle", "time": 2431.91, "timestamp": "00:40:31", "text": "更多地使用日语。"}, {"type": "subtitle", "time": 2436.39, "timestamp": "00:40:36", "text": "是的。然后老板问，"}, {"type": "subtitle", "time": 2441.589, "timestamp": "00:40:41", "text": "你以前在"}, {"type": "subtitle", "time": 2443.43, "timestamp": "00:40:43", "text": "日本工作过吗？或者在"}, {"type": "subtitle", "time": 2446.47, "timestamp": "00:40:46", "text": "其他地方工作过？"}, {"type": "subtitle", "time": 2449.43, "timestamp": "00:40:49", "text": "约翰回答"}, {"type": "subtitle", "time": 2451.99, "timestamp": "00:40:51", "text": "说，是的，我以前在便利店做过兼职"}, {"type": "subtitle", "time": 2457.75, "timestamp": "00:40:57", "text": "。"}]
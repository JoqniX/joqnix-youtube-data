[{"type": "subtitle", "time": 2701.109, "timestamp": "00:45:01", "text": "然后，他又回到了"}, {"type": "subtitle", "time": 2704.39, "timestamp": "00:45:04", "text": "他来这里的目的。"}, {"type": "subtitle", "time": 2708.95, "timestamp": "00:45:08", "text": "约翰说：“嗯……这个"}, {"type": "subtitle", "time": 2711.75, "timestamp": "00:45:11", "text": "咖喱……嗯……"}, {"type": "subtitle", "time": 2714.71, "timestamp": "00:45:14", "text": "咖喱……"}, {"type": "subtitle", "time": 2718.87, "timestamp": "00:45:18", "text": "真的……很推荐……"}, {"type": "subtitle", "time": 2726.87, "timestamp": "00:45:26", "text": "等等，仁基很受欢迎。好的，等等。"}, {"type": "subtitle", "time": 2730.87, "timestamp": "00:45:30", "text": "仁基很有名，对吧？所以这个咖喱在"}, {"type": "subtitle", "time": 2735.27, "timestamp": "00:45:35", "text": "这里最受欢迎。”"}, {"type": "subtitle", "time": 2739.03, "timestamp": "00:45:39", "text": "他说完，山下说：“嗯，"}, {"type": "subtitle", "time": 2742.23, "timestamp": "00:45:42", "text": "看起来很好吃。"}, {"type": "subtitle", "time": 2746.71, "timestamp": "00:45:46", "text": "那就来吧，我要这个吃。”"}, {"type": "subtitle", "time": 2750.39, "timestamp": "00:45:50", "text": "我的翻译不太好。是的。再见。好的。"}, {"type": "subtitle", "time": 2754.55, "timestamp": "00:45:54", "text": "实际上是1点。"}, {"type": "subtitle", "time": 2758.47, "timestamp": "00:45:58", "text": "好的。不是1。嗯，好的，明白了。这"}]
[{"type": "subtitle", "time": 8221.83, "timestamp": "02:17:01", "text": "因为它们打架，晚上也一直在吠叫。"}, {"type": "subtitle", "time": 8223.91, "timestamp": "02:17:03", "text": "这真是太"}, {"type": "subtitle", "time": 8230.95, "timestamp": "02:17:10", "text": "是啊，"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "现在猫咪生孩子好频繁啊。"}, {"type": "subtitle", "time": 8242.469, "timestamp": "02:17:22", "text": "她现在怀孕了。"}, {"type": "subtitle", "time": 8245.509, "timestamp": "02:17:25", "text": "嚎叫声停止了。"}, {"type": "subtitle", "time": 8249.349, "timestamp": "02:17:29", "text": "于是，嚎叫声停止了。"}, {"type": "subtitle", "time": 8258.389, "timestamp": "02:17:38", "text": "哦哦，是"}, {"type": "subtitle", "time": 8260.95, "timestamp": "02:17:40", "text": "第六代猫。"}, {"type": "subtitle", "time": 8263.11, "timestamp": "02:17:43", "text": "第五个和第六个孩子都没有死。 他们都"}, {"type": "subtitle", "time": 8271.83, "timestamp": "02:17:51", "text": "，是的，他一直……不，她一直……"}, {"type": "subtitle", "time": 8277.11, "timestamp": "02:17:57", "text": "嗯……就像……"}]
[{"type": "subtitle", "time": 7322.39, "timestamp": "02:02:02", "text": "画画很差，就像我在直播中画的那样。 我不擅长"}, {"type": "subtitle", "time": 7326.87, "timestamp": "02:02:06", "text": "做音乐。 我在直播中制作音乐，现在"}, {"type": "subtitle", "time": 7330.79, "timestamp": "02:02:10", "text": "我一边"}, {"type": "subtitle", "time": 7333.43, "timestamp": "02:02:13", "text": "直播一边学习一门我不擅长的语言。"}, {"type": "subtitle", "time": 7337.109, "timestamp": "02:02:17", "text": "我觉得没关系。 就像你看，"}, {"type": "subtitle", "time": 7341.35, "timestamp": "02:02:21", "text": "从某种意义上说，我把我的旅程看作是黑暗的，就像"}, {"type": "subtitle", "time": 7347.589, "timestamp": "02:02:27", "text": "我有很多爱好，我正在努力"}, {"type": "subtitle", "time": 7350.39, "timestamp": "02:02:30", "text": "寻找自我，那该怎么称呼"}, {"type": "subtitle", "time": 7354.95, "timestamp": "02:02:34", "text": "它呢？ 嗯，我知道我样样通样样松，什么都不懂，很多"}, {"type": "subtitle", "time": 7360.39, "timestamp": "02:02:40", "text": "事情都做不好，但我有兴趣做点什么"}, {"type": "subtitle", "time": 7362.229, "timestamp": "02:02:42", "text": "，"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "学习一门技能，对吧？ 所以，我把它"}, {"type": "subtitle", "time": 7374.55, "timestamp": "02:02:54", "text": "公开地发布到网上，比如做成视频，某种程度上是为了表明，是的"}, {"type": "subtitle", "time": 7378.47, "timestamp": "02:02:58", "text": "，我正在尽我所能，而且"}]
[{"type": "subtitle", "time": 2461.67, "timestamp": "00:41:01", "text": "是的。然后老板又问，你"}, {"type": "subtitle", "time": 2475.03, "timestamp": "00:41:15", "text": "约翰回答说可以，我们"}, {"type": "subtitle", "time": 2478.069, "timestamp": "00:41:18", "text": "一起工作吧。老板说，"}, {"type": "subtitle", "time": 2482.23, "timestamp": "00:41:22", "text": "让我们尽力而为。嗨，"}, {"type": "subtitle", "time": 2485.829, "timestamp": "00:41:25", "text": "下一位是"}, {"type": "subtitle", "time": 2488.55, "timestamp": "00:41:28", "text": "山下教授。是的。"}, {"type": "subtitle", "time": 2494.79, "timestamp": "00:41:34", "text": "实际上，是一位顾客"}, {"type": "subtitle", "time": 2496.95, "timestamp": "00:41:36", "text": "和约翰。这是约翰。哦，等等。你"}, {"type": "subtitle", "time": 2499.91, "timestamp": "00:41:39", "text": "看不到他。是的。这是约翰，"}, {"type": "subtitle", "time": 2502.71, "timestamp": "00:41:42", "text": "这是山下教授的"}, {"type": "subtitle", "time": 2506.63, "timestamp": "00:41:46", "text": "歌。嗨。好的，我们开始吧。我们读"}, {"type": "subtitle", "time": 2512.55, "timestamp": "00:41:52", "text": "一下。山下教授来了。嗨。"}]
[{"type": "subtitle", "time": 6060.47, "timestamp": "01:41:00", "text": "是的，和即将进行的直播类似。"}, {"type": "subtitle", "time": 6062.87, "timestamp": "01:41:02", "text": "这些都是生命的全部。这是"}, {"type": "subtitle", "time": 6064.79, "timestamp": "01:41:04", "text": "由机器人完成。他们有自己的"}, {"type": "subtitle", "time": 6067.51, "timestamp": "01:41:07", "text": "自定义机器人。我与该剧的创作者进行了交谈。"}, {"type": "subtitle", "time": 6069.75, "timestamp": "01:41:09", "text": "我问这个机器人他是做什么的，然后"}, {"type": "subtitle", "time": 6072.47, "timestamp": "01:41:12", "text": "一切。然后我就想，“好吧，我……”"}, {"type": "subtitle", "time": 6074.79, "timestamp": "01:41:14", "text": "我试着自己重新制作了一下。”当我制作时"}, {"type": "subtitle", "time": 6076.95, "timestamp": "01:41:16", "text": "萨米把它放进去了。"}, {"type": "subtitle", "time": 6079.35, "timestamp": "01:41:19", "text": "是的。之后，当我们完成"}, {"type": "subtitle", "time": 6083.91, "timestamp": "01:41:23", "text": "接下来，我们要做一个动态的"}, {"type": "subtitle", "time": 6086.87, "timestamp": "01:41:26", "text": "呃，直播播报员之类的东西。所以当我去"}, {"type": "subtitle", "time": 6089.109, "timestamp": "01:41:29", "text": "现场直播时，我必须手动操作。"}, {"type": "subtitle", "time": 6091.35, "timestamp": "01:41:31", "text": "发短信并提醒一下。正确的？而不是"}, {"type": "subtitle", "time": 6094.39, "timestamp": "01:41:34", "text": "那将是一个自动化系统。我"}, {"type": "subtitle", "time": 6096.709, "timestamp": "01:41:36", "text": "只需安排好直播时间，别……"}, {"type": "subtitle", "time": 6098.47, "timestamp": "01:41:38", "text": "完全不用在意这段代码。它将"}, {"type": "subtitle", "time": 6101.27, "timestamp": "01:41:41", "text": "自动发送上线消息"}, {"type": "subtitle", "time": 6104.95, "timestamp": "01:41:44", "text": "推文取决于"}, {"type": "subtitle", "time": 6108.47, "timestamp": "01:41:48", "text": "如果直播将在10分钟后开始的话"}, {"type": "subtitle", "time": 6110.55, "timestamp": "01:41:50", "text": "几分钟或5分钟。如果它发送"}, {"type": "subtitle", "time": 6114.709, "timestamp": "01:41:54", "text": "立即地。如果超过1小时"}, {"type": "subtitle", "time": 6116.95, "timestamp": "01:41:56", "text": "我的直播开始时，它将成为"}]
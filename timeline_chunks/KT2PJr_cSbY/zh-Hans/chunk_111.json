[{"type": "subtitle", "time": 6660.79, "timestamp": "01:51:00", "text": "我当时真是蠢透了，然后我做了点什么。"}, {"type": "subtitle", "time": 6664.709, "timestamp": "01:51:04", "text": "在之前，因为在之前，呃，因为"}, {"type": "subtitle", "time": 6667.91, "timestamp": "01:51:07", "text": "克里斯蒂娜的踢腿动作没有效果"}, {"type": "subtitle", "time": 6669.51, "timestamp": "01:51:09", "text": "对我来说，云技术是有效的。"}, {"type": "subtitle", "time": 6672.55, "timestamp": "01:51:12", "text": "公平的。不。所以我做了类似这样的事。"}, {"type": "subtitle", "time": 6675.189, "timestamp": "01:51:15", "text": "手动生成刷新令牌等等"}, {"type": "subtitle", "time": 6680.39, "timestamp": "01:51:20", "text": "呃呃，我以前会生成一个代码。"}, {"type": "subtitle", "time": 6682.79, "timestamp": "01:51:22", "text": "嗯"}, {"type": "subtitle", "time": 6686.55, "timestamp": "01:51:26", "text": "我以前会生成代码，是的。"}, {"type": "subtitle", "time": 6688.87, "timestamp": "01:51:28", "text": "事情之所以会发生，是因为我"}, {"type": "subtitle", "time": 6692.79, "timestamp": "01:51:32", "text": "还没重新考虑过。我现在必须重新开始"}, {"type": "subtitle", "time": 6695.83, "timestamp": "01:51:35", "text": "意思是你知道的，我们重新来过。"}, {"type": "subtitle", "time": 6706.39, "timestamp": "01:51:46", "text": "哦，它坏了。我的天，它坏了。"}, {"type": "subtitle", "time": 6710.47, "timestamp": "01:51:50", "text": "它坏了。搞什么鬼？它坏了。"}, {"type": "subtitle", "time": 6718.95, "timestamp": "01:51:58", "text": "无效的不匹配项在"}]
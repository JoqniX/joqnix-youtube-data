[{"type": "subtitle", "time": 13801.99, "timestamp": "03:50:01", "text": "所有通过 YouTube API 获取的数据"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "像我们之前那样填充这些内容"}, {"type": "subtitle", "time": 13808.71, "timestamp": "03:50:08", "text": "YouTube自动流数据按钮和"}, {"type": "subtitle", "time": 13811.99, "timestamp": "03:50:11", "text": "Discord 创建活动按钮和"}, {"type": "subtitle", "time": 13814.95, "timestamp": "03:50:14", "text": "还有“向上调度”按钮。是的，"}, {"type": "subtitle", "time": 13817.75, "timestamp": "03:50:17", "text": "请帮帮我。而且我也是"}, {"type": "subtitle", "time": 13821.03, "timestamp": "03:50:21", "text": "我想在扫描过程中添加一些逻辑。"}, {"type": "subtitle", "time": 13823.51, "timestamp": "03:50:23", "text": "当前时间并与……进行比较"}, {"type": "subtitle", "time": 13826.389, "timestamp": "03:50:26", "text": "安排YouTube直播时间。和"}, {"type": "subtitle", "time": 13831.03, "timestamp": "03:50:31", "text": "如果扫描时间像……更多"}, {"type": "subtitle", "time": 13833.51, "timestamp": "03:50:33", "text": "超过1小时或更长时间，那就……"}, {"type": "subtitle", "time": 13835.189, "timestamp": "03:50:35", "text": "它会发送一条类似等待的消息。"}, {"type": "subtitle", "time": 13838.15, "timestamp": "03:50:38", "text": "房间留言。如果是10分钟或5分钟"}, {"type": "subtitle", "time": 13841.03, "timestamp": "03:50:41", "text": "留给接下来的时间吧"}, {"type": "subtitle", "time": 13843.349, "timestamp": "03:50:43", "text": "扫描的同时发送消息"}, {"type": "subtitle", "time": 13846.15, "timestamp": "03:50:46", "text": "立即以直播形式发送。"}, {"type": "subtitle", "time": 13850.71, "timestamp": "03:50:50", "text": "然后我想做点什么，"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "媒体库之类的东西，用来展示"}, {"type": "subtitle", "time": 13856.55, "timestamp": "03:50:56", "text": "直播预览，还有"}]
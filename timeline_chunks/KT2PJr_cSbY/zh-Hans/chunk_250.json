[{"type": "subtitle", "time": 15002.55, "timestamp": "04:10:02", "text": "《绝命毒师》里确实有那个机器人。"}, {"type": "subtitle", "time": 15005.67, "timestamp": "04:10:05", "text": "每一天，每一个像素"}, {"type": "subtitle", "time": 15008.71, "timestamp": "04:10:08", "text": "比赛就像一场赛跑一样结束了"}, {"type": "subtitle", "time": 15010.87, "timestamp": "04:10:10", "text": "就像过去很多年一样。"}, {"type": "subtitle", "time": 15013.189, "timestamp": "04:10:13", "text": "我看到了"}, {"type": "subtitle", "time": 15016.389, "timestamp": "04:10:16", "text": "它像几年前那样流行起来"}, {"type": "subtitle", "time": 15019.349, "timestamp": "04:10:19", "text": "一年左右。我不知道。"}, {"type": "subtitle", "time": 15029.349, "timestamp": "04:10:29", "text": "就像《绝命毒师》的每一帧画面一样。"}]
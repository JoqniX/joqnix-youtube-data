[{"type": "subtitle", "time": 3666.95, "timestamp": "01:01:06", "text": "这是什么？"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "为什么我会拥有这个？"}, {"type": "subtitle", "time": 3681.99, "timestamp": "01:01:21", "text": "你知道吗？我决定两个都保持不变。"}, {"type": "subtitle", "time": 3685.109, "timestamp": "01:01:25", "text": "美好的。下次轮到你了，萨姆。"}, {"type": "subtitle", "time": 3688.15, "timestamp": "01:01:28", "text": "我有这个吗？"}, {"type": "subtitle", "time": 3692.549, "timestamp": "01:01:32", "text": "我的设备上有Unix时间戳吗？不。所以，我们"}, {"type": "subtitle", "time": 3695.75, "timestamp": "01:01:35", "text": "我将从这里获取。"}, {"type": "subtitle", "time": 3697.829, "timestamp": "01:01:37", "text": "打开它。"}, {"type": "subtitle", "time": 3702.069, "timestamp": "01:01:42", "text": "你在哪里？从你的"}, {"type": "subtitle", "time": 3704.23, "timestamp": "01:01:44", "text": "躲藏。"}, {"type": "subtitle", "time": 3711.27, "timestamp": "01:01:51", "text": "好的，这里没有。没关系。关闭"}, {"type": "subtitle", "time": 3713.19, "timestamp": "01:01:53", "text": "把它搞定。"}, {"type": "subtitle", "time": 3717.589, "timestamp": "01:01:57", "text": "呃，大概就在这里和这里，对吧？"}]
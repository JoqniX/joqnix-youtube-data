[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "替我做这件事"}, {"type": "subtitle", "time": 10023.269, "timestamp": "02:47:03", "text": "锁好之后。是的，即使是今天，我的"}, {"type": "subtitle", "time": 10025.83, "timestamp": "02:47:05", "text": "爸爸打电话问我，你为什么花了这么多钱？"}, {"type": "subtitle", "time": 10028.71, "timestamp": "02:47:08", "text": "他们花了很多钱上音乐课"}, {"type": "subtitle", "time": 10032.309, "timestamp": "02:47:12", "text": "连像65000人那样好好教都没教好"}, {"type": "subtitle", "time": 10035.67, "timestamp": "02:47:15", "text": "那可是巨款啊，你知道吗？"}, {"type": "subtitle", "time": 10038.63, "timestamp": "02:47:18", "text": "我苦苦哀求了四个月"}, {"type": "subtitle", "time": 10041.269, "timestamp": "02:47:21", "text": "我甚至连最后一笔分期付款都付不起。"}, {"type": "subtitle", "time": 10046.63, "timestamp": "02:47:26", "text": "月份因为嗯，那个"}, {"type": "subtitle", "time": 10049.91, "timestamp": "02:47:29", "text": "我当时在做自由职业，做一些他们做的事。"}, {"type": "subtitle", "time": 10054.55, "timestamp": "02:47:34", "text": "已经没有工作留给我了。"}, {"type": "subtitle", "time": 10056.63, "timestamp": "02:47:36", "text": "除了我之前做的那件事之外，还有其他一些事。"}, {"type": "subtitle", "time": 10059.19, "timestamp": "02:47:39", "text": "呃，人们没什么工作可做，"}, {"type": "subtitle", "time": 10062.309, "timestamp": "02:47:42", "text": "我甚至都没拿到工资。"}, {"type": "subtitle", "time": 10066.23, "timestamp": "02:47:46", "text": "是的，就是那场闹剧发生的时候。"}, {"type": "subtitle", "time": 10070.309, "timestamp": "02:47:50", "text": "我想那些东西也被切断了。"}, {"type": "subtitle", "time": 10071.99, "timestamp": "02:47:51", "text": "完全"}, {"type": "subtitle", "time": 10076.79, "timestamp": "02:47:56", "text": "但是，至少我还能买到一个"}, {"type": "subtitle", "time": 10079.83, "timestamp": "02:47:59", "text": "录音棚已满，我很高兴"}]
[{"type": "subtitle", "time": 13443.11, "timestamp": "03:44:03", "text": "利用这辆车进行自动化操作。所以，我们"}, {"type": "subtitle", "time": 13445.429, "timestamp": "03:44:05", "text": "今天很多事情都结束了。我们"}, {"type": "subtitle", "time": 13448.55, "timestamp": "03:44:08", "text": "自动化事件相关工作已完成。它"}, {"type": "subtitle", "time": 13450.71, "timestamp": "03:44:10", "text": "每当我安排一个事件时，它都会创建一个事件"}, {"type": "subtitle", "time": 13454.389, "timestamp": "03:44:14", "text": "我们在 YouTube 上直播，并且也进行了更新。"}, {"type": "subtitle", "time": 13459.03, "timestamp": "03:44:19", "text": "我们这个东西即将推出的流媒体嵌入所以"}, {"type": "subtitle", "time": 13461.51, "timestamp": "03:44:21", "text": "它每次都会更新"}, {"type": "subtitle", "time": 13465.11, "timestamp": "03:44:25", "text": "每当嗯，就像当我……是的，它会检查"}, {"type": "subtitle", "time": 13466.95, "timestamp": "03:44:26", "text": "安排日程并进行更新"}, {"type": "subtitle", "time": 13469.99, "timestamp": "03:44:29", "text": "人们可以密切关注此事。"}, {"type": "subtitle", "time": 13474.55, "timestamp": "03:44:34", "text": "目前我们打算做……嗯"}, {"type": "subtitle", "time": 13477.83, "timestamp": "03:44:37", "text": "直播播报员之类的东西，嗯，就像我计划的那样"}, {"type": "subtitle", "time": 13480.469, "timestamp": "03:44:40", "text": "做三件逻辑事情，比如……取决于"}, {"type": "subtitle", "time": 13483.269, "timestamp": "03:44:43", "text": "比如如果我的日程安排是这样的"}, {"type": "subtitle", "time": 13488.229, "timestamp": "03:44:48", "text": "明天上午11点，对吧？所以它会……"}, {"type": "subtitle", "time": 13490.309, "timestamp": "03:44:50", "text": "将其与当前时间进行比较，如果"}, {"type": "subtitle", "time": 13492.469, "timestamp": "03:44:52", "text": "大概还要一个多小时。"}, {"type": "subtitle", "time": 13495.75, "timestamp": "03:44:55", "text": "候诊室留言。如果不是的话"}, {"type": "subtitle", "time": 13497.75, "timestamp": "03:44:57", "text": "会在10分钟后像直播一样发送。"}]
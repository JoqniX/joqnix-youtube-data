[{"type": "subtitle", "time": 7021.669, "timestamp": "01:57:01", "text": "你需要找到配音演员。你有"}, {"type": "subtitle", "time": 7024.79, "timestamp": "01:57:04", "text": "寻找音乐。我必须创作音乐。"}, {"type": "subtitle", "time": 7027.27, "timestamp": "01:57:07", "text": "这个那个。另外，我不会配音。"}, {"type": "subtitle", "time": 7029.03, "timestamp": "01:57:09", "text": "表演。不同的角色。"}, {"type": "subtitle", "time": 7031.51, "timestamp": "01:57:11", "text": "我做不到。所以，这就是我当时的原因。"}, {"type": "subtitle", "time": 7034.629, "timestamp": "01:57:14", "text": "比如，“好吧，我还是支持Jock。”"}, {"type": "subtitle", "time": 7036.87, "timestamp": "01:57:16", "text": "大家好。欢迎。哦，你在线"}, {"type": "subtitle", "time": 7056.709, "timestamp": "01:57:36", "text": "安比特身体。是的，基本上我们是"}, {"type": "subtitle", "time": 7059.27, "timestamp": "01:57:39", "text": "完毕。"}]
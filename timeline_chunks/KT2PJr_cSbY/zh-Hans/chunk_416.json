[{"type": "subtitle", "time": 24966.468, "timestamp": "06:56:06", "text": "等等，上面是不是说我必须放一个"}, {"type": "subtitle", "time": 24975.51, "timestamp": "06:56:15", "text": "硬编码组件以包含"}, {"type": "subtitle", "time": 24978.708, "timestamp": "06:56:18", "text": "文本？我们可能会添加其他组件。"}, {"type": "subtitle", "time": 24980.468, "timestamp": "06:56:20", "text": "未来。同样，配件也可能是"}, {"type": "subtitle", "time": 24983.91, "timestamp": "06:56:23", "text": "扩展后包含其他组件"}, {"type": "subtitle", "time": 24986.788, "timestamp": "06:56:26", "text": "未来。"}, {"type": "subtitle", "time": 24989.27, "timestamp": "06:56:29", "text": "所以他们的意思是让我不要硬编码"}]
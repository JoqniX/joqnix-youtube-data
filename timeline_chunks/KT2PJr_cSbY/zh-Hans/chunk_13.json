[{"type": "subtitle", "time": 783.59, "timestamp": "00:13:03", "text": "哦好的。所以，呃，我们已经完成了。"}, {"type": "subtitle", "time": 786.31, "timestamp": "00:13:06", "text": "我们已经完成了 YouTube API 的相关工作。"}, {"type": "subtitle", "time": 789.67, "timestamp": "00:13:09", "text": "事情就到此为止了，我们已经结束了 Discord 的使用。"}, {"type": "subtitle", "time": 791.99, "timestamp": "00:13:11", "text": "甚至创造东西"}, {"type": "subtitle", "time": 794.71, "timestamp": "00:13:14", "text": "甚至创建东西，呃，创建和更新"}, {"type": "subtitle", "time": 797.59, "timestamp": "00:13:17", "text": "缩略图。目前为止，这两件事是"}, {"type": "subtitle", "time": 799.59, "timestamp": "00:13:19", "text": "完毕"}, {"type": "subtitle", "time": 803.19, "timestamp": "00:13:23", "text": "呃"}, {"type": "subtitle", "time": 806.15, "timestamp": "00:13:26", "text": "是的，那两件事都办完了。"}, {"type": "subtitle", "time": 807.269, "timestamp": "00:13:27", "text": "和[音乐]"}, {"type": "subtitle", "time": 808.949, "timestamp": "00:13:28", "text": "嗯"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "我需要创造一种新的逻辑[音乐]"}, {"type": "subtitle", "time": 814.23, "timestamp": "00:13:34", "text": "如果我更改，那就是更新。"}, {"type": "subtitle", "time": 817.19, "timestamp": "00:13:37", "text": "直播时间表，直播时间。所以它"}, {"type": "subtitle", "time": 820.71, "timestamp": "00:13:40", "text": "应该提交一个补丁请求，嗯，我需要"}, {"type": "subtitle", "time": 824.23, "timestamp": "00:13:44", "text": "保存这些嵌入内容。不，不，不。"}, {"type": "subtitle", "time": 826.71, "timestamp": "00:13:46", "text": "将这些数据保存到一个文件中，以便它可以提取。"}, {"type": "subtitle", "time": 829.19, "timestamp": "00:13:49", "text": "从文件 [music] 中创建一个数组"}, {"type": "subtitle", "time": 831.99, "timestamp": "00:13:51", "text": "以及其他一些东西，并交叉检查所有直播流。"}, {"type": "subtitle", "time": 835.03, "timestamp": "00:13:55", "text": "以及事件 ID 之类的东西。"}, {"type": "subtitle", "time": 836.949, "timestamp": "00:13:56", "text": "不过，我们看看结果如何吧。出色地"}, {"type": "subtitle", "time": 839.03, "timestamp": "00:13:59", "text": "稍后在临近结尾的时候再做这件事。"}]
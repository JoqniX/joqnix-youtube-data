[{"type": "subtitle", "time": 21379.11, "timestamp": "05:56:19", "text": "运行时会发生什么？"}, {"type": "subtitle", "time": 21381.03, "timestamp": "05:56:21", "text": "奖金。你可以称之为拼布"}, {"type": "subtitle", "time": 21383.19, "timestamp": "05:56:23", "text": "定期地。如果你连接一个定时器回路"}, {"type": "subtitle", "time": 21385.91, "timestamp": "05:56:25", "text": "表示每个都会自动切换"}, {"type": "subtitle", "time": 21389.83, "timestamp": "05:56:29", "text": "您的帖子文本表单。等等，什么？"}, {"type": "subtitle", "time": 21401.83, "timestamp": "05:56:41", "text": "等待状态 等候室 直播"}, {"type": "subtitle", "time": 21405.43, "timestamp": "05:56:45", "text": "不手动运行就会死亡。"}, {"type": "subtitle", "time": 21408.47, "timestamp": "05:56:48", "text": "所以它会自动"}, {"type": "subtitle", "time": 21412.788, "timestamp": "05:56:52", "text": "将您的帖子文本表单从"}]
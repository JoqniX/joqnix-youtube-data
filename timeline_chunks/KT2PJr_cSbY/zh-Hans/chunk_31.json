[{"type": "subtitle", "time": 1864.789, "timestamp": "00:31:04", "text": "呃，现在是晚上。是的，这就是"}, {"type": "subtitle", "time": 1867.909, "timestamp": "00:31:07", "text": "第二股流。我必须参加我的"}, {"type": "subtitle", "time": 1870.31, "timestamp": "00:31:10", "text": "日语课程。之后，我就开始了"}, {"type": "subtitle", "time": 1873.669, "timestamp": "00:31:13", "text": "启动了，是的，这是第二个"}, {"type": "subtitle", "time": 1877.269, "timestamp": "00:31:17", "text": "溪流。我们要一直写代码到深夜。不是"}, {"type": "subtitle", "time": 1881.59, "timestamp": "00:31:21", "text": "写代码，一直修到晚上。他"}, {"type": "subtitle", "time": 1886.389, "timestamp": "00:31:26", "text": "欢迎您的回答。"}, {"type": "subtitle", "time": 1888.23, "timestamp": "00:31:28", "text": "欢迎，"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "好的。所以，"}, {"type": "subtitle", "time": 1912.71, "timestamp": "00:31:52", "text": "所以，到目前为止，我做到了这一点。似乎有效。"}, {"type": "subtitle", "time": 1917.509, "timestamp": "00:31:57", "text": "是这东西吗？"}]
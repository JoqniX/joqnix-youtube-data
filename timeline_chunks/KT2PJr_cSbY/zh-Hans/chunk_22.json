[{"type": "subtitle", "time": 1321.19, "timestamp": "00:22:01", "text": "就像这样，直接发起一次频道攻击。"}, {"type": "subtitle", "time": 1325.11, "timestamp": "00:22:05", "text": "这件事发生很久了，大概是去年吧。"}, {"type": "subtitle", "time": 1326.789, "timestamp": "00:22:06", "text": "只是随意地放松和频道"}, {"type": "subtitle", "time": 1336.149, "timestamp": "00:22:16", "text": "像这样的情况。这就是我过去……"}, {"type": "subtitle", "time": 1340.789, "timestamp": "00:22:20", "text": "比如在我的服务器上使用我自己的机器人"}, {"type": "subtitle", "time": 1343.909, "timestamp": "00:22:23", "text": "人们可以在听音乐的同时享受果酱。"}, {"type": "subtitle", "time": 1347.19, "timestamp": "00:22:27", "text": "我正在用电脑听。但那柔软的"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "我当时用的那个机器人"}, {"type": "subtitle", "time": 1358.149, "timestamp": "00:22:38", "text": "嗯"}, {"type": "subtitle", "time": 1360.23, "timestamp": "00:22:40", "text": "这"}, {"type": "subtitle", "time": 1365.43, "timestamp": "00:22:45", "text": "DS GitHub Discord 机器人"}, {"type": "subtitle", "time": 1367.99, "timestamp": "00:22:47", "text": "精彩的音频流。是的，这东西是"}, {"type": "subtitle", "time": 1371.669, "timestamp": "00:22:51", "text": "由于某些原因，它不再工作了。"}, {"type": "subtitle", "time": 1373.669, "timestamp": "00:22:53", "text": "呃，东西"}, {"type": "subtitle", "time": 1378.549, "timestamp": "00:22:58", "text": "是的，我需要找个合适的替代人选。"}]
[{"type": "subtitle", "time": 10202.87, "timestamp": "02:50:02", "text": "我会这么做。是的。"}, {"type": "subtitle", "time": 10205.269, "timestamp": "02:50:05", "text": "所以，我们正式结束了即将到来的所有工作。"}, {"type": "subtitle", "time": 10207.51, "timestamp": "02:50:07", "text": "日程安排之类的东西。"}, {"type": "subtitle", "time": 10210.15, "timestamp": "02:50:10", "text": "终于，这件事完成了。好的，"}, {"type": "subtitle", "time": 10213.19, "timestamp": "02:50:13", "text": "让我把这些杂物都收起来。"}, {"type": "subtitle", "time": 10215.91, "timestamp": "02:50:15", "text": "删除此项。"}, {"type": "subtitle", "time": 10219.03, "timestamp": "02:50:19", "text": "哦，还有一件事。呃，秋天"}, {"type": "subtitle", "time": 10221.11, "timestamp": "02:50:21", "text": "回去吧？"}, {"type": "subtitle", "time": 10229.83, "timestamp": "02:50:29", "text": "好的。呃，必须得做了。"}, {"type": "subtitle", "time": 10231.67, "timestamp": "02:50:31", "text": "永远不可能把它包起来"}, {"type": "subtitle", "time": 10240.55, "timestamp": "02:50:40", "text": "为什么Joathon还在Twitch的嘉宾阵容中？"}, {"type": "subtitle", "time": 10243.19, "timestamp": "02:50:43", "text": "哦，如果我不这样做，真的会这样吗？"}, {"type": "subtitle", "time": 10246.23, "timestamp": "02:50:46", "text": "在线观看？我不太确定。"}, {"type": "subtitle", "time": 10249.99, "timestamp": "02:50:49", "text": "肯定有一些视频"}, {"type": "subtitle", "time": 10253.51, "timestamp": "02:50:53", "text": "YouTube 上有关于这方面的讨论，尤其是针对 FL 的。"}, {"type": "subtitle", "time": 10256.389, "timestamp": "02:50:56", "text": "Studio PE 这东西不行"}, {"type": "subtitle", "time": 10258.79, "timestamp": "02:50:58", "text": "所以我就很担心"}]
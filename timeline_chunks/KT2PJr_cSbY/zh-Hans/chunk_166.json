[{"type": "subtitle", "time": 9962.23, "timestamp": "02:46:02", "text": "我得开始做10英寸的直播了。"}, {"type": "subtitle", "time": 9965.429, "timestamp": "02:46:05", "text": "我应该那样做。为什么我不是"}, {"type": "subtitle", "time": 9972.95, "timestamp": "02:46:12", "text": "假的。咚咚。"}, {"type": "subtitle", "time": 9976.63, "timestamp": "02:46:16", "text": "但我必须这么做，伙计。"}, {"type": "subtitle", "time": 9979.51, "timestamp": "02:46:19", "text": "使用 CR。是的，我当时用的是标记功能。"}, {"type": "subtitle", "time": 9982.389, "timestamp": "02:46:22", "text": "实际上，在学习和学习时，版本是……"}, {"type": "subtitle", "time": 9984.55, "timestamp": "02:46:24", "text": "东西。 [音乐] 那感觉就像，好吧，一个"}, {"type": "subtitle", "time": 9986.79, "timestamp": "02:46:26", "text": "真实的事情就像如果我发布"}, {"type": "subtitle", "time": 9990.309, "timestamp": "02:46:30", "text": "我的歌是出版商或其他一些人写的"}, {"type": "subtitle", "time": 9993.67, "timestamp": "02:46:33", "text": "人们或某些数字许可"}, {"type": "subtitle", "time": 9995.83, "timestamp": "02:46:35", "text": "他们可以知道我标记了"}, {"type": "subtitle", "time": 9997.99, "timestamp": "02:46:37", "text": "软件。所以我不想让这些问题……"}, {"type": "subtitle", "time": 10000.63, "timestamp": "02:46:40", "text": "发生。不，要么标记该软件。"}, {"type": "subtitle", "time": 10002.79, "timestamp": "02:46:42", "text": "或者标记声音或"}, {"type": "subtitle", "time": 10005.83, "timestamp": "02:46:45", "text": "插件。不，我可能会被抓到，因为我"}, {"type": "subtitle", "time": 10007.99, "timestamp": "02:46:47", "text": "必须真正为许可证付费"}, {"type": "subtitle", "time": 10010.71, "timestamp": "02:46:50", "text": "它。我看过一些相关的视频。所以，我"}, {"type": "subtitle", "time": 10013.11, "timestamp": "02:46:53", "text": "当时我就说：“好吧，那就这样吧。我这就……”"}, {"type": "subtitle", "time": 10016.55, "timestamp": "02:46:56", "text": "想办法买下来。”我求我爸[笑声]"}]
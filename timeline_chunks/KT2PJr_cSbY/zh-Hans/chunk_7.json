[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "后天的直播也有。"}, {"type": "subtitle", "time": 424.15, "timestamp": "00:07:04", "text": "已经安排好了，对吧？所有那些东西。"}, {"type": "subtitle", "time": 426.15, "timestamp": "00:07:06", "text": "在今天的直播结束之前，我将"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "所有自动化功能，它都能检测到"}, {"type": "subtitle", "time": 438.87, "timestamp": "00:07:18", "text": "流媒体播放时间表的时间差，然后"}, {"type": "subtitle", "time": 442.23, "timestamp": "00:07:22", "text": "更新并修复所有这些问题。好的。"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "是的。让我们看看会发生什么"}, {"type": "subtitle", "time": 452.469, "timestamp": "00:07:32", "text": "即使你觉得自己做得不好，"}, {"type": "subtitle", "time": 455.51, "timestamp": "00:07:35", "text": "至少要修改一下内容，并确保……"}, {"type": "subtitle", "time": 458.71, "timestamp": "00:07:38", "text": "下次你表现得不错，对吧？或"}, {"type": "subtitle", "time": 462.55, "timestamp": "00:07:42", "text": "至少你知道什么是什么是什么是。"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "一切。好的。是的。你做到了"}, {"type": "subtitle", "time": 468.55, "timestamp": "00:07:48", "text": "尽你所能。所以，是的，就是这样。"}, {"type": "subtitle", "time": 472.39, "timestamp": "00:07:52", "text": "是。不用担心。"}, {"type": "subtitle", "time": 475.589, "timestamp": "00:07:55", "text": "等等，现在已经是十一月了。不。呃，是这样的吗？"}, {"type": "subtitle", "time": 478.55, "timestamp": "00:07:58", "text": "期末考试？不，不是期末冬季考试。"}]
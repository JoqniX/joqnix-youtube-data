[{"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "和你的朋友们一起"}, {"type": "subtitle", "time": 4144.709, "timestamp": "01:09:04", "text": "一起享受上课和一切"}, {"type": "subtitle", "time": 4147.669, "timestamp": "01:09:07", "text": "所有那些东西，我没有，我没有。"}, {"type": "subtitle", "time": 4150.789, "timestamp": "01:09:10", "text": "那段生活尚未结束，但明年我将……"}, {"type": "subtitle", "time": 4152.95, "timestamp": "01:09:12", "text": "虽然我会带着它，因为我要去日本。"}, {"type": "subtitle", "time": 4157.03, "timestamp": "01:09:17", "text": "我将成为一名学生。他他"}, {"type": "subtitle", "time": 4159.669, "timestamp": "01:09:19", "text": "我会的，我的意思是，一旦我到了日本，我就会"}, {"type": "subtitle", "time": 4162.309, "timestamp": "01:09:22", "text": "现在必须去那里上大学了。所以在"}, {"type": "subtitle", "time": 4166.229, "timestamp": "01:09:26", "text": "即使如此"}, {"type": "subtitle", "time": 4170.709, "timestamp": "01:09:30", "text": "嗯，是啊，即使……我能……也不能……呃"}, {"type": "subtitle", "time": 4173.189, "timestamp": "01:09:33", "text": "享受此刻，我会的。"}, {"type": "subtitle", "time": 4176.63, "timestamp": "01:09:36", "text": "未来可能"}, {"type": "subtitle", "time": 4182.47, "timestamp": "01:09:42", "text": "呃，复制。"}, {"type": "subtitle", "time": 4196.47, "timestamp": "01:09:56", "text": "呃，虽然我正在做……"}, {"type": "subtitle", "time": 4199.35, "timestamp": "01:09:59", "text": "英国文学和英语"}]
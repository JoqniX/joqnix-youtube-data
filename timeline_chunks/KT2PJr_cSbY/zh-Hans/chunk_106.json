[{"type": "subtitle", "time": 6362.31, "timestamp": "01:46:02", "text": "你看过她的Instagram吗？"}, {"type": "subtitle", "time": 6365.43, "timestamp": "01:46:05", "text": "哦，我还没查看其他人的……"}, {"type": "subtitle", "time": 6368.39, "timestamp": "01:46:08", "text": "还没发布Instagram故事呢。"}, {"type": "subtitle", "time": 6371.51, "timestamp": "01:46:11", "text": "所以如果有人看我的故事，我会……"}, {"type": "subtitle", "time": 6375.669, "timestamp": "01:46:15", "text": "他们也倾向于查看他们的故事。"}, {"type": "subtitle", "time": 6379.27, "timestamp": "01:46:19", "text": "我就是那样打扮的。"}, {"type": "subtitle", "time": 6381.75, "timestamp": "01:46:21", "text": "印地语。"}, {"type": "subtitle", "time": 6384.31, "timestamp": "01:46:24", "text": "我的错。没关系。不用担心。我可以"}, {"type": "subtitle", "time": 6388.39, "timestamp": "01:46:28", "text": "读。我能理解。我 我 我 是"}, {"type": "subtitle", "time": 6391.83, "timestamp": "01:46:31", "text": "印地语不好。是的。录制情况如何"}, {"type": "subtitle", "time": 6393.669, "timestamp": "01:46:33", "text": "现在走吗？我用摩卡咖啡机煮咖啡"}, {"type": "subtitle", "time": 6396.55, "timestamp": "01:46:36", "text": "锅。哦，你点了一杯摩卡咖啡。"}, {"type": "subtitle", "time": 6398.55, "timestamp": "01:46:38", "text": "哇。"}, {"type": "subtitle", "time": 6406.39, "timestamp": "01:46:46", "text": "那很好。好好享用你的咖啡吧。"}, {"type": "subtitle", "time": 6409.35, "timestamp": "01:46:49", "text": "但是，嗯，到目前为止，我们已经……我们已经……"}, {"type": "subtitle", "time": 6411.59, "timestamp": "01:46:51", "text": "我们没有用字符串，而是把它做成了一个"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "目的。目前为止一切顺利。呃，还有一些"}, {"type": "subtitle", "time": 6416.709, "timestamp": "01:46:56", "text": "这里那里都有错误。我要修复它"}]
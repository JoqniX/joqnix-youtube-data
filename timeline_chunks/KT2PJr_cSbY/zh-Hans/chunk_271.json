[{"type": "subtitle", "time": 16303.429, "timestamp": "04:31:43", "text": "这一切中唯一的规律是："}, {"type": "subtitle", "time": 16306.389, "timestamp": "04:31:46", "text": "一旦萨米的线索即将关闭，"}, {"type": "subtitle", "time": 16310.229, "timestamp": "04:31:50", "text": "就是这样。它不见了。地图和"}, {"type": "subtitle", "time": 16312.71, "timestamp": "04:31:52", "text": "东西，对吧？我刚刚就这么做了。那些不会是"}, {"type": "subtitle", "time": 16315.429, "timestamp": "04:31:55", "text": "已保存。我确实把它写进了一个文件里，但是"}, {"type": "subtitle", "time": 16318.63, "timestamp": "04:31:58", "text": "必须发出类似“获取”这样的命令"}]
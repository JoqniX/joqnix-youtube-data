[{"type": "subtitle", "time": 12181.67, "timestamp": "03:23:01", "text": "等等，让我等一下。是的，你"}, {"type": "subtitle", "time": 12184.469, "timestamp": "03:23:04", "text": "之前点击“接受”时才看到。"}, {"type": "subtitle", "time": 12187.269, "timestamp": "03:23:07", "text": "此次交互失败。"}, {"type": "subtitle", "time": 12191.03, "timestamp": "03:23:11", "text": "所以，是的，我得用我的滑板来"}, {"type": "subtitle", "time": 12193.91, "timestamp": "03:23:13", "text": "检测到当我点击“接受”按钮时"}, {"type": "subtitle", "time": 12196.389, "timestamp": "03:23:16", "text": "当用户点击此“接受”按钮时"}, {"type": "subtitle", "time": 12199.75, "timestamp": "03:23:19", "text": "做这类事情。或者另一种方法是"}, {"type": "subtitle", "time": 12202.87, "timestamp": "03:23:22", "text": "我可以制作按钮"}, {"type": "subtitle", "time": 12204.79, "timestamp": "03:23:24", "text": "制作按钮并使其转动。"}, {"type": "subtitle", "time": 12207.51, "timestamp": "03:23:27", "text": "进入禁用状态。所以你不能点击"}, {"type": "subtitle", "time": 12209.91, "timestamp": "03:23:29", "text": "它会存在，但它只是作为一种美学元素。"}, {"type": "subtitle", "time": 12213.83, "timestamp": "03:23:33", "text": "出于某种目的，但它看起来像一个"}, {"type": "subtitle", "time": 12217.11, "timestamp": "03:23:37", "text": "略微偏灰的版本，类似深色版本"}, {"type": "subtitle", "time": 12221.83, "timestamp": "03:23:41", "text": "版本如同已禁用。不"}, {"type": "subtitle", "time": 12225.349, "timestamp": "03:23:45", "text": "就只有这一件事。"}, {"type": "subtitle", "time": 12239.59, "timestamp": "03:23:59", "text": "对于自定义 ID 按钮，您需要"}]
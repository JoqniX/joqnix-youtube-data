[{"type": "subtitle", "time": 10081.03, "timestamp": "02:48:01", "text": "呃"}, {"type": "subtitle", "time": 10084.07, "timestamp": "02:48:04", "text": "我爸甚至跟我说，就像如果你有"}, {"type": "subtitle", "time": 10087.83, "timestamp": "02:48:07", "text": "如果你当时攒了钱，你就可以……"}, {"type": "subtitle", "time": 10097.91, "timestamp": "02:48:17", "text": "因为那时候，比如去年十二月"}, {"type": "subtitle", "time": 10101.269, "timestamp": "02:48:21", "text": "感觉我必须平衡很多事情"}, {"type": "subtitle", "time": 10105.59, "timestamp": "02:48:25", "text": "比如一门日语课和"}, {"type": "subtitle", "time": 10107.75, "timestamp": "02:48:27", "text": "去年同时开设了五门课程。"}, {"type": "subtitle", "time": 10111.91, "timestamp": "02:48:31", "text": "12月2日，呃，我的直播和"}, {"type": "subtitle", "time": 10114.63, "timestamp": "02:48:34", "text": "东西。现实生活中，三个。"}, {"type": "subtitle", "time": 10117.99, "timestamp": "02:48:37", "text": "不，不，不，不是现实生活中。呃，学位"}, {"type": "subtitle", "time": 10121.19, "timestamp": "02:48:41", "text": "研究。三。四、"}, {"type": "subtitle", "time": 10124.55, "timestamp": "02:48:44", "text": "音乐。因为我本来就想这么做。"}, {"type": "subtitle", "time": 10127.269, "timestamp": "02:48:47", "text": "五个现实生活中的东西。"}, {"type": "subtitle", "time": 10130.15, "timestamp": "02:48:50", "text": "呃，比如，不，五号会是运动健将。"}, {"type": "subtitle", "time": 10133.67, "timestamp": "02:48:53", "text": "等等，我把运动员相关的东西算进去了吗？"}, {"type": "subtitle", "time": 10136.63, "timestamp": "02:48:56", "text": "我不知道。五人组将参加 IRL 活动"}, {"type": "subtitle", "time": 10138.469, "timestamp": "02:48:58", "text": "比如去健身房之类的"}]
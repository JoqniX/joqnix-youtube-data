[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "旅程的意义在于赋予我的生命意义"}, {"type": "subtitle", "time": 4866.709, "timestamp": "01:21:06", "text": "以我的名字命名。不，就是这样。"}, {"type": "subtitle", "time": 4869.11, "timestamp": "01:21:09", "text": "我得忙网站的事儿了，伙计。哦"}, {"type": "subtitle", "time": 4892.149, "timestamp": "01:21:32", "text": "日本人求助。为什么？"}, {"type": "subtitle", "time": 4899.35, "timestamp": "01:21:39", "text": "你看，这样很好。它正在这样做"}, {"type": "subtitle", "time": 4904.07, "timestamp": "01:21:44", "text": "正确。但是，为什么？它不是"}, {"type": "subtitle", "time": 4913.51, "timestamp": "01:21:53", "text": "所以（音乐）应该能起到很好的效果。"}, {"type": "subtitle", "time": 4916.709, "timestamp": "01:21:56", "text": "我不明白。"}]
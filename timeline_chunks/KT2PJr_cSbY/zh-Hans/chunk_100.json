[{"type": "subtitle", "time": 6002.39, "timestamp": "01:40:02", "text": "实现嵌入式功能的自动化。"}, {"type": "subtitle", "time": 6004.55, "timestamp": "01:40:04", "text": "比如每当我有直播安排的时候，"}, {"type": "subtitle", "time": 6007.43, "timestamp": "01:40:07", "text": "它会在节目表频道中显示。"}, {"type": "subtitle", "time": 6009.91, "timestamp": "01:40:09", "text": "此内容将动态更新。我是"}, {"type": "subtitle", "time": 6013.35, "timestamp": "01:40:13", "text": "只是重新更新一下。所以它是可扩展的"}, {"type": "subtitle", "time": 6016.31, "timestamp": "01:40:16", "text": "至 15 个流。"}, {"type": "subtitle", "time": 6019.99, "timestamp": "01:40:19", "text": "是的，我之前用的旧版本是"}, {"type": "subtitle", "time": 6023.189, "timestamp": "01:40:23", "text": "这个旧版本最多只支持"}, {"type": "subtitle", "time": 6026.229, "timestamp": "01:40:26", "text": "12 个流。不，不是12条。是六条溪流。"}, {"type": "subtitle", "time": 6029.43, "timestamp": "01:40:29", "text": "显然。六个，对吧？是的。是的。这"}, {"type": "subtitle", "time": 6031.83, "timestamp": "01:40:31", "text": "新版本将支持最多 15 个"}, {"type": "subtitle", "time": 6033.59, "timestamp": "01:40:33", "text": "流。"}, {"type": "subtitle", "time": 6035.99, "timestamp": "01:40:35", "text": "所以，每次出现新的流时，就像新的一样。"}, {"type": "subtitle", "time": 6038.709, "timestamp": "01:40:38", "text": "即将播出的节目表"}, {"type": "subtitle", "time": 6043.03, "timestamp": "01:40:43", "text": "如果发生什么事，就会在这里显示。是的，"}, {"type": "subtitle", "time": 6046.709, "timestamp": "01:40:46", "text": "[嗤笑]"}, {"type": "subtitle", "time": 6050.149, "timestamp": "01:40:50", "text": "我的天哪。这与Holive类似。"}, {"type": "subtitle", "time": 6052.229, "timestamp": "01:40:52", "text": "粉丝服务器"}, {"type": "subtitle", "time": 6053.91, "timestamp": "01:40:53", "text": "东西。"}, {"type": "subtitle", "time": 6057.59, "timestamp": "01:40:57", "text": "呃，如果我去他们那儿的话。"}]
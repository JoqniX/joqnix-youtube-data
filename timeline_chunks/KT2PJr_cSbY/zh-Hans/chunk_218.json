[{"type": "subtitle", "time": 13085.11, "timestamp": "03:38:05", "text": "什么？好吧，行。那就别给我"}, {"type": "subtitle", "time": 13088.07, "timestamp": "03:38:08", "text": "我自己去拿。 [嗤笑]"}, {"type": "subtitle", "time": 13090.389, "timestamp": "03:38:10", "text": "嗯"}, {"type": "subtitle", "time": 13102.309, "timestamp": "03:38:22", "text": "呃，"}, {"type": "subtitle", "time": 13106.87, "timestamp": "03:38:26", "text": "它应该在这里，对吧？"}, {"type": "subtitle", "time": 13109.75, "timestamp": "03:38:29", "text": "比利。比利。对，就是这个人。"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "想象一下，你可以预览……"}, {"type": "subtitle", "time": 13115.19, "timestamp": "03:38:35", "text": "我的天啊。想象。"}, {"type": "subtitle", "time": 13120.87, "timestamp": "03:38:40", "text": "等待。"}, {"type": "subtitle", "time": 13124.15, "timestamp": "03:38:44", "text": "不，不，不。我本来就打算这么做。"}, {"type": "subtitle", "time": 13125.59, "timestamp": "03:38:45", "text": "等待。我其实没想过要这么做。"}, {"type": "subtitle", "time": 13129.83, "timestamp": "03:38:49", "text": "那。等待。实际上，并非如此。嘿，"}, {"type": "subtitle", "time": 13132.229, "timestamp": "03:38:52", "text": "等待。我觉得我收到了很多"}, {"type": "subtitle", "time": 13135.03, "timestamp": "03:38:55", "text": "现在的一些想法。让我直说吧"}]
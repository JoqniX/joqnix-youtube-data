[{"type": "subtitle", "time": 540.47, "timestamp": "00:09:00", "text": "你说的系统是什么意思？"}, {"type": "subtitle", "time": 542.07, "timestamp": "00:09:02", "text": "不同的？等等，你是印度人？"}, {"type": "subtitle", "time": 550.389, "timestamp": "00:09:10", "text": "或者等等，"}, {"type": "subtitle", "time": 558.31, "timestamp": "00:09:18", "text": "是的，你来自印度。对不起。我认为"}, {"type": "subtitle", "time": 561.67, "timestamp": "00:09:21", "text": "这是大学里才会有的事。"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "我祈祷我能拿到50分的试卷，然后我写出来。"}, {"type": "subtitle", "time": 567.67, "timestamp": "00:09:27", "text": "50分。"}, {"type": "subtitle", "time": 579.67, "timestamp": "00:09:39", "text": "好的。好的。这是一种不同的怪异现象。"}, {"type": "subtitle", "time": 583.99, "timestamp": "00:09:43", "text": "系统。编号：SM 1、SM 2、SM 3、SM 4。"}, {"type": "subtitle", "time": 586.23, "timestamp": "00:09:46", "text": "哦，是的。"}, {"type": "subtitle", "time": 588.63, "timestamp": "00:09:48", "text": "Ignu 里也有吗？我认为"}]
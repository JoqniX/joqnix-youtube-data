[{"type": "subtitle", "time": 1982.389, "timestamp": "00:33:02", "text": "将嵌入字段数组转换为 JSON"}, {"type": "subtitle", "time": 1986.87, "timestamp": "00:33:06", "text": "在向 Discord 专家发送一行 JSON 之前"}, {"type": "subtitle", "time": 1990.789, "timestamp": "00:33:10", "text": "数组不是 Sami 数组对象。"}, {"type": "subtitle", "time": 1995.909, "timestamp": "00:33:15", "text": "嗯？嗯？嗯？"}, {"type": "subtitle", "time": 1997.59, "timestamp": "00:33:17", "text": "什么？"}, {"type": "subtitle", "time": 2005.83, "timestamp": "00:33:25", "text": "转变"}, {"type": "subtitle", "time": 2017.509, "timestamp": "00:33:37", "text": "什么？"}, {"type": "subtitle", "time": 2021.029, "timestamp": "00:33:41", "text": "移动补丁程序，以便在补丁程序运行之前运行。"}, {"type": "subtitle", "time": 2022.47, "timestamp": "00:33:42", "text": "重复块。这意味着它可能是"}, {"type": "subtitle", "time": 2025.43, "timestamp": "00:33:45", "text": "发送时已完全修复。移动你的 HTB"}, {"type": "subtitle", "time": 2028.07, "timestamp": "00:33:48", "text": "记录下面的操作，以便它在运行后执行。"}, {"type": "subtitle", "time": 2032.07, "timestamp": "00:33:52", "text": "所有字段均已添加。选修的"}]
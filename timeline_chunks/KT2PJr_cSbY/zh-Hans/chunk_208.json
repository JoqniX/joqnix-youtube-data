[{"type": "subtitle", "time": 12491.83, "timestamp": "03:28:11", "text": "我太兴奋了。炒作。炒作。"}, {"type": "subtitle", "time": 12497.99, "timestamp": "03:28:17", "text": "[笑声]"}, {"type": "subtitle", "time": 12500.389, "timestamp": "03:28:20", "text": "我的天啊。"}, {"type": "subtitle", "time": 12503.269, "timestamp": "03:28:23", "text": "所以让我理解一下"}, {"type": "subtitle", "time": 12513.99, "timestamp": "03:28:33", "text": "那面旗子到底是怎么回事？"}, {"type": "subtitle", "time": 12518.71, "timestamp": "03:28:38", "text": "记住 12 型、10 型和 7 年预科"}, {"type": "subtitle", "time": 12521.03, "timestamp": "03:28:41", "text": "对很多人来说，这仍然是开发预览版。你可能会得到"}, {"type": "subtitle", "time": 12523.19, "timestamp": "03:28:43", "text": "如果你的忠诚度不支持这些"}, {"type": "subtitle", "time": 12526.07, "timestamp": "03:28:46", "text": "组件类型。 H"}, {"type": "subtitle", "time": 12528.389, "timestamp": "03:28:48", "text": "谁在乎？没关系。"}, {"type": "subtitle", "time": 12537.99, "timestamp": "03:28:57", "text": "我以前也这样做过。这么久"}]
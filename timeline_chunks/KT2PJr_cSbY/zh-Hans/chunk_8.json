[{"type": "subtitle", "time": 481.029, "timestamp": "00:08:01", "text": "正确的？这本来就是应该发生的。"}, {"type": "subtitle", "time": 485.67, "timestamp": "00:08:05", "text": "12月。不，是这样吗？"}, {"type": "subtitle", "time": 489.83, "timestamp": "00:08:09", "text": "总共50分？啊，我明白了。"}, {"type": "subtitle", "time": 496.39, "timestamp": "00:08:16", "text": "[叹息和喘息] 嗨。回来，"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "Alexa。好了，我这就结束这个话题。"}, {"type": "subtitle", "time": 502.39, "timestamp": "00:08:22", "text": "没关系。你怎么认为？我是"}, {"type": "subtitle", "time": 504.07, "timestamp": "00:08:24", "text": "开玩笑的。"}, {"type": "subtitle", "time": 506.629, "timestamp": "00:08:26", "text": "期末考试如期举行。"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "期末考试就像基于我所知道的那些东西一样"}, {"type": "subtitle", "time": 513.75, "timestamp": "00:08:33", "text": "即使你正在上大学或学院"}, {"type": "subtitle", "time": 517.029, "timestamp": "00:08:37", "text": "或者像某种通常最终的结果"}, {"type": "subtitle", "time": 520.149, "timestamp": "00:08:40", "text": "考试在……举行"}, {"type": "subtitle", "time": 524.31, "timestamp": "00:08:44", "text": "四月、三月等等。不，但它是吗？"}, {"type": "subtitle", "time": 525.91, "timestamp": "00:08:45", "text": "还有别的吗？你学的是什么专业？"}, {"type": "subtitle", "time": 529.829, "timestamp": "00:08:49", "text": "正在做？我忘了问这个问题。"}, {"type": "subtitle", "time": 532.07, "timestamp": "00:08:52", "text": "H"}, {"type": "subtitle", "time": 534.63, "timestamp": "00:08:54", "text": "玛雅"}]
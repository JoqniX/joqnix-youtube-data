[{"type": "subtitle", "time": 300.79, "timestamp": "00:05:00", "text": "日语呃，复习，日语N4"}, {"type": "subtitle", "time": 303.03, "timestamp": "00:05:03", "text": "复习和类似汉字学习"}, {"type": "subtitle", "time": 305.43, "timestamp": "00:05:05", "text": "因为我有一份试卷。"}, {"type": "subtitle", "time": 308.95, "timestamp": "00:05:08", "text": "晚上进行测试。 [音乐] 所以，我"}, {"type": "subtitle", "time": 311.27, "timestamp": "00:05:11", "text": "我想投入时间和精力"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "真正学习我所拥有的一切"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "目前为止学到的东西。好的。就像稳定一样"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "稳稳地做好"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "明天将保持稳定的水流"}, {"type": "subtitle", "time": 325.11, "timestamp": "00:05:25", "text": "而不是偷懒懈怠。就是这样。"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "我们明天要做的。好的，早上好"}, {"type": "subtitle", "time": 329.59, "timestamp": "00:05:29", "text": "嗯，我会尽量早起，然后……"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "修改和所有事情都要做，做那件事"}, {"type": "subtitle", "time": 334.95, "timestamp": "00:05:34", "text": "非常感谢，也请写在……"}, {"type": "subtitle", "time": 338.79, "timestamp": "00:05:38", "text": "我也会做一些粗略的工作，而且喜欢"}, {"type": "subtitle", "time": 341.35, "timestamp": "00:05:41", "text": "还有一些小测验之类的。是的，所以"}, {"type": "subtitle", "time": 346.07, "timestamp": "00:05:46", "text": "我的想法完全正确。"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "是的。这样我就不会忘记了，对吧？如果我这样做"}, {"type": "subtitle", "time": 351.11, "timestamp": "00:05:51", "text": "直播进行中，我稳住了，伙计。如果我不"}, {"type": "subtitle", "time": 353.67, "timestamp": "00:05:53", "text": "去做吧，不然我就偷懒了。所以"}, {"type": "subtitle", "time": 355.83, "timestamp": "00:05:55", "text": "是啊，但愿如此，希望一切顺利。"}]
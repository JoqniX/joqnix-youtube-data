[{"type": "subtitle", "time": 4440.39, "timestamp": "01:14:00", "text": "它将在 YouTube 上直播。"}, {"type": "subtitle", "time": 4443.75, "timestamp": "01:14:03", "text": "此处自动更新。所以今天呃"}, {"type": "subtitle", "time": 4446.39, "timestamp": "01:14:06", "text": "就像下午的溪流一样，我们"}, {"type": "subtitle", "time": 4448.39, "timestamp": "01:14:08", "text": "我昨天找到了一些东西，还有一些我没找到的东西。"}, {"type": "subtitle", "time": 4450.39, "timestamp": "01:14:10", "text": "直播，但我当时在后台工作。"}, {"type": "subtitle", "time": 4454.87, "timestamp": "01:14:14", "text": "场景用来重新制作我以前制作的东西"}, {"type": "subtitle", "time": 4457.83, "timestamp": "01:14:17", "text": "很久以前，那是 YouTube API 的东西"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "以及所有的一切。所以现在一切都结束了"}, {"type": "subtitle", "time": 4462.229, "timestamp": "01:14:22", "text": "自动化。我刚刚安排了一场直播"}, {"type": "subtitle", "time": 4464.87, "timestamp": "01:14:24", "text": "YouTube。它将自动"}, {"type": "subtitle", "time": 4469.03, "timestamp": "01:14:29", "text": "创建 Discord 活动。是的，制作"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "Discord 事件会自动触发，而且"}, {"type": "subtitle", "time": 4475.27, "timestamp": "01:14:35", "text": "它将更新嵌入内容。我现在要走了"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "在我们完成嵌入之后"}, {"type": "subtitle", "time": 4480.07, "timestamp": "01:14:40", "text": "动态更新嵌入内容"}, {"type": "subtitle", "time": 4482.55, "timestamp": "01:14:42", "text": "这些东西，我们要开始处理这些了。"}, {"type": "subtitle", "time": 4485.27, "timestamp": "01:14:45", "text": "比如我如何宣布我的直播，"}, {"type": "subtitle", "time": 4488.07, "timestamp": "01:14:48", "text": "正确的？我手动输入并 ping 用户"}, {"type": "subtitle", "time": 4490.47, "timestamp": "01:14:50", "text": "ping 滚动对了，但我现在要……"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "让它在我……的时候自动运行"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "希望上线，它将自动"}]
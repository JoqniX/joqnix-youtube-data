[{"type": "subtitle", "time": 7445.51, "timestamp": "02:04:05", "text": "但它真的好吗？如果我得到“哦我的”"}, {"type": "subtitle", "time": 7448.87, "timestamp": "02:04:08", "text": "上帝。就连Nocaptopus也有。什么"}, {"type": "subtitle", "time": 7451.669, "timestamp": "02:04:11", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 7454.87, "timestamp": "02:04:14", "text": "想象一下有一天像这样直播：是的，"}, {"type": "subtitle", "time": 7457.43, "timestamp": "02:04:17", "text": "我希望有一天能做到这一点。一"}, {"type": "subtitle", "time": 7459.215, "timestamp": "02:04:19", "text": "天啊，伙计，"}, {"type": "subtitle", "time": 7464.95, "timestamp": "02:04:24", "text": "男人。更多的"}, {"type": "subtitle", "time": 7475.03, "timestamp": "02:04:35", "text": "哦，我不知道。观察。我的错。我"}, {"type": "subtitle", "time": 7480.229, "timestamp": "02:04:40", "text": "[叹气]"}]
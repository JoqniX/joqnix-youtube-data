[{"type": "subtitle", "time": 12550.63, "timestamp": "03:29:10", "text": "我想找到它。比如，我用过我的"}, {"type": "subtitle", "time": 12557.51, "timestamp": "03:29:17", "text": "比利。比利，去泡杯茶。我必须"}, {"type": "subtitle", "time": 12588.87, "timestamp": "03:29:48", "text": "我以前玩迪斯科的时候就是这么做的。"}, {"type": "subtitle", "time": 12590.389, "timestamp": "03:29:50", "text": "钩。"}, {"type": "subtitle", "time": 12593.91, "timestamp": "03:29:53", "text": "哦，等等。它用了我的球。"}]
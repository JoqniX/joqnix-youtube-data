[{"type": "subtitle", "time": 15973.03, "timestamp": "04:26:13", "text": "わかった。閉じ込められた。うん。急がなきゃ。"}, {"type": "subtitle", "time": 15995.269, "timestamp": "04:26:35", "text": "ああ、昨日やったよ。ああ、私は"}, {"type": "subtitle", "time": 16002.229, "timestamp": "04:26:42", "text": "ああ、毎日の課題は全部やったよ。わかった、気にしないで。"}, {"type": "subtitle", "time": 16006.309, "timestamp": "04:26:46", "text": "わかった。それでは、さようなら。集中する時が来た。"}, {"type": "subtitle", "time": 16009.83, "timestamp": "04:26:49", "text": "ゲーム禁止。私たちは集中します。ホカス。"}, {"type": "subtitle", "time": 16011.83, "timestamp": "04:26:51", "text": "わかった。昨日午前4時にやりました。"}, {"type": "subtitle", "time": 16014.87, "timestamp": "04:26:54", "text": "ああ、忘れてた。昨日は7時に寝ました。"}, {"type": "subtitle", "time": 16017.67, "timestamp": "04:26:57", "text": "はぁ？そうそう。"}]
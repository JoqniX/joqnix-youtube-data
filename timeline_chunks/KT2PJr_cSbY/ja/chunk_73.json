[{"type": "subtitle", "time": 4420.07, "timestamp": "01:13:40", "text": "古風な雰囲気も出したかった"}, {"type": "subtitle", "time": 4423.11, "timestamp": "01:13:43", "text": "ライン。いくつかは行ってみたかったと思う"}, {"type": "subtitle", "time": 4425.99, "timestamp": "01:13:45", "text": "他の国。ああ、何だ、君は"}, {"type": "subtitle", "time": 4428.149, "timestamp": "01:13:48", "text": "何をしているの？ああ、今日は"}, {"type": "subtitle", "time": 4431.669, "timestamp": "01:13:51", "text": "Discord用の自動化システム。だから私は"}, {"type": "subtitle", "time": 4434.87, "timestamp": "01:13:54", "text": "私の"}, {"type": "subtitle", "time": 4436.55, "timestamp": "01:13:56", "text": "サーバーにはチャンネルがあります"}, {"type": "subtitle", "time": 4438.95, "timestamp": "01:13:58", "text": "スケジュール。だから私がスケジュールを立てるたびに"}]
[{"type": "subtitle", "time": 7021.669, "timestamp": "01:57:01", "text": "声優を探さなければならない。あなたが持っている"}, {"type": "subtitle", "time": 7024.79, "timestamp": "01:57:04", "text": "音楽を探す。私は音楽を作らなければならない。"}, {"type": "subtitle", "time": 7027.27, "timestamp": "01:57:07", "text": "あれこれ。それに、私は声を出すことができない"}, {"type": "subtitle", "time": 7029.03, "timestamp": "01:57:09", "text": "演技。それぞれ異なる性格。"}, {"type": "subtitle", "time": 7031.51, "timestamp": "01:57:11", "text": "それはできません。だから私は"}, {"type": "subtitle", "time": 7034.629, "timestamp": "01:57:14", "text": "「よし、ジョックでいこう。」"}, {"type": "subtitle", "time": 7036.87, "timestamp": "01:57:16", "text": "みなさん、こんにちは。いらっしゃいませ。ああ、君は"}, {"type": "subtitle", "time": 7056.709, "timestamp": "01:57:36", "text": "アンビットの体。ええ、基本的には私たちは"}, {"type": "subtitle", "time": 7059.27, "timestamp": "01:57:39", "text": "終わり。"}]
[{"type": "subtitle", "time": 16303.429, "timestamp": "04:31:43", "text": "このすべてにおいて唯一の流れは"}, {"type": "subtitle", "time": 16306.389, "timestamp": "04:31:46", "text": "サミーの手がかりが閉じられつつあるとき、"}, {"type": "subtitle", "time": 16310.229, "timestamp": "04:31:50", "text": "それでおしまい。それはなくなってしまった。地図と"}, {"type": "subtitle", "time": 16312.71, "timestamp": "04:31:52", "text": "そういうことですよね？今、そうしました。それらは"}, {"type": "subtitle", "time": 16315.429, "timestamp": "04:31:55", "text": "保存しました。私はそれをファイルに書き込んだが、"}, {"type": "subtitle", "time": 16318.63, "timestamp": "04:31:58", "text": "えーっと、コマンドを出して取得する必要があります"}]
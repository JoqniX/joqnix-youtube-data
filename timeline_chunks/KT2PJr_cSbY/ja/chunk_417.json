[{"type": "subtitle", "time": 25036.998, "timestamp": "06:57:16", "text": "そしてcom。 [笑い]"}, {"type": "subtitle", "time": 25043.11, "timestamp": "06:57:23", "text": "うんうん。"}, {"type": "subtitle", "time": 25050.754, "timestamp": "06:57:30", "text": "私はあなたの名前を発音しません。待って。"}, {"type": "subtitle", "time": 25051.83, "timestamp": "06:57:31", "text": "[笑い]"}, {"type": "subtitle", "time": 25053.59, "timestamp": "06:57:33", "text": "えっと、"}, {"type": "subtitle", "time": 25062.548, "timestamp": "06:57:42", "text": "君のことをECADと呼ぶよ。こんにちは。コメント。"}, {"type": "subtitle", "time": 25079.19, "timestamp": "06:57:59", "text": "関連する。これらは必須です"}]
[{"type": "subtitle", "time": 10081.03, "timestamp": "02:48:01", "text": "えーと"}, {"type": "subtitle", "time": 10084.07, "timestamp": "02:48:04", "text": "父は私にこう言います。「もしあなたが"}, {"type": "subtitle", "time": 10087.83, "timestamp": "02:48:07", "text": "当時貯金していたお金があれば"}, {"type": "subtitle", "time": 10097.91, "timestamp": "02:48:17", "text": "だって、あの頃は去年の12月だったよね"}, {"type": "subtitle", "time": 10101.269, "timestamp": "02:48:21", "text": "まるで私は多くのことをバランスよくこなさなければならないような"}, {"type": "subtitle", "time": 10105.59, "timestamp": "02:48:25", "text": "日本語の授業など"}, {"type": "subtitle", "time": 10107.75, "timestamp": "02:48:27", "text": "昨年は5つのクラスが開講されていた"}, {"type": "subtitle", "time": 10111.91, "timestamp": "02:48:31", "text": "12月2日、私のライブ配信と"}, {"type": "subtitle", "time": 10114.63, "timestamp": "02:48:34", "text": "もの。 3つ目、IRL（アイルランド語）。"}, {"type": "subtitle", "time": 10117.99, "timestamp": "02:48:37", "text": "いやいや、現実世界では違うよ。ええと、学位"}, {"type": "subtitle", "time": 10121.19, "timestamp": "02:48:41", "text": "研究。三つ。 4つ。"}, {"type": "subtitle", "time": 10124.55, "timestamp": "02:48:44", "text": "音楽。だって、そうしたかったんだもん。"}, {"type": "subtitle", "time": 10127.269, "timestamp": "02:48:47", "text": "現実世界での5つのこと。"}, {"type": "subtitle", "time": 10130.15, "timestamp": "02:48:50", "text": "えーと、いや、5番目はジョックニックだよ。"}, {"type": "subtitle", "time": 10133.67, "timestamp": "02:48:53", "text": "あれ、スポーツ関連のものを数えたっけ？"}, {"type": "subtitle", "time": 10136.63, "timestamp": "02:48:56", "text": "わからない。 5人はIRL"}, {"type": "subtitle", "time": 10138.469, "timestamp": "02:48:58", "text": "ジムに行くとか"}]
[{"type": "subtitle", "time": 14106.389, "timestamp": "03:55:06", "text": "状態"}, {"type": "subtitle", "time": 14109.91, "timestamp": "03:55:09", "text": "H 気にしないで、キックも始まるよ"}, {"type": "subtitle", "time": 14113.83, "timestamp": "03:55:13", "text": "プレビューパスはOKです。時間ロジックを感じます。"}, {"type": "subtitle", "time": 14117.99, "timestamp": "03:55:17", "text": "すごくクールだけど、私にはできない"}, {"type": "subtitle", "time": 14120.07, "timestamp": "03:55:20", "text": "ワイプ"}, {"type": "subtitle", "time": 14122.469, "timestamp": "03:55:22", "text": "o"}, {"type": "subtitle", "time": 14126.55, "timestamp": "03:55:26", "text": "あ、待って、変数現在の時刻を設定してください。わかりました。"}, {"type": "subtitle", "time": 14129.349, "timestamp": "03:55:29", "text": "このスケジュール時間の開始時間を実行できます"}, {"type": "subtitle", "time": 14132.71, "timestamp": "03:55:32", "text": "よし、開始時刻から時間差を引いてみよう"}, {"type": "subtitle", "time": 14136.15, "timestamp": "03:55:36", "text": "時差は等しい"}, {"type": "subtitle", "time": 14139.03, "timestamp": "03:55:39", "text": "待機中であることを発表します"}, {"type": "subtitle", "time": 14143.75, "timestamp": "03:55:43", "text": "ええと、マイナスライブとして。わかった。この種類"}]
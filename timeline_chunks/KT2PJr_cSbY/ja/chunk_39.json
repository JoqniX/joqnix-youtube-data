[{"type": "subtitle", "time": 2340.55, "timestamp": "00:39:00", "text": "サポート"}, {"type": "subtitle", "time": 2342.31, "timestamp": "00:39:02", "text": "えーと終わり"}, {"type": "subtitle", "time": 2346.069, "timestamp": "00:39:06", "text": "または底"}, {"type": "subtitle", "time": 2348.31, "timestamp": "00:39:08", "text": "位置。"}, {"type": "subtitle", "time": 2351.67, "timestamp": "00:39:11", "text": "上位か下位か"}, {"type": "subtitle", "time": 2354.069, "timestamp": "00:39:14", "text": "ゼロ"}, {"type": "subtitle", "time": 2356.63, "timestamp": "00:39:16", "text": "または"}, {"type": "subtitle", "time": 2360.95, "timestamp": "00:39:20", "text": "インデックスのいずれか"}, {"type": "subtitle", "time": 2384.47, "timestamp": "00:39:44", "text": "他の文字列や数字を挿入することもできます"}, {"type": "subtitle", "time": 2389.27, "timestamp": "00:39:49", "text": "入れるが、あなたが「入れる」と言わない限り、住所は入れない"}, {"type": "subtitle", "time": 2397.75, "timestamp": "00:39:57", "text": "[ため息と息を呑む音]"}]
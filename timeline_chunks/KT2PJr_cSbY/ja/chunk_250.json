[{"type": "subtitle", "time": 15002.55, "timestamp": "04:10:02", "text": "ブレイキング・バッドにはあのボットがいた"}, {"type": "subtitle", "time": 15005.67, "timestamp": "04:10:05", "text": "毎日すべてのピクセル"}, {"type": "subtitle", "time": 15008.71, "timestamp": "04:10:08", "text": "そしてそれはまるで走っているかのように終わった"}, {"type": "subtitle", "time": 15010.87, "timestamp": "04:10:10", "text": "何年も経ったかのように。"}, {"type": "subtitle", "time": 15013.189, "timestamp": "04:10:13", "text": "私はそれを見た"}, {"type": "subtitle", "time": 15016.389, "timestamp": "04:10:16", "text": "数年前は流行っていた"}, {"type": "subtitle", "time": 15019.349, "timestamp": "04:10:19", "text": "年とか。わからない。"}, {"type": "subtitle", "time": 15029.349, "timestamp": "04:10:29", "text": "『ブレイキング・バッド』のすべてのシーンのように。"}]
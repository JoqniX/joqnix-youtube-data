[{"type": "subtitle", "time": 13801.99, "timestamp": "03:50:01", "text": "YouTube API から取得したすべてのデータ"}, {"type": "subtitle", "time": 13804.71, "timestamp": "03:50:04", "text": "物事を埋める 我々がやったように"}, {"type": "subtitle", "time": 13808.71, "timestamp": "03:50:08", "text": "YouTubeの自動ストリームデータボタンと"}, {"type": "subtitle", "time": 13811.99, "timestamp": "03:50:11", "text": "Discordのイベント作成ボタンと"}, {"type": "subtitle", "time": 13814.95, "timestamp": "03:50:14", "text": "また、スケジュールを上げるボタンもあります。そうですね、"}, {"type": "subtitle", "time": 13817.75, "timestamp": "03:50:17", "text": "これについて助けてください。そして私も"}, {"type": "subtitle", "time": 13821.03, "timestamp": "03:50:21", "text": "スキャンする部分にロジックを追加したい"}, {"type": "subtitle", "time": 13823.51, "timestamp": "03:50:23", "text": "現在時刻と比較し、"}, {"type": "subtitle", "time": 13826.389, "timestamp": "03:50:26", "text": "YouTube配信のスケジュール時間を設定する。そして"}, {"type": "subtitle", "time": 13831.03, "timestamp": "03:50:31", "text": "スキャン時間がもっと"}, {"type": "subtitle", "time": 13833.51, "timestamp": "03:50:33", "text": "1時間以上かかる場合は、"}, {"type": "subtitle", "time": 13835.189, "timestamp": "03:50:35", "text": "待機中のようなメッセージを送信します"}, {"type": "subtitle", "time": 13838.15, "timestamp": "03:50:38", "text": "ルームメッセージ。 10分か5分なら"}, {"type": "subtitle", "time": 13841.03, "timestamp": "03:50:41", "text": "スケジュールされた時間まで残して"}, {"type": "subtitle", "time": 13843.349, "timestamp": "03:50:43", "text": "スキャン中にメッセージを送信します"}, {"type": "subtitle", "time": 13846.15, "timestamp": "03:50:46", "text": "すぐにライブ配信として送信します"}, {"type": "subtitle", "time": 13850.71, "timestamp": "03:50:50", "text": "何かして、それから私は"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "メディアギャラリーのようなものなので、それを紹介します"}, {"type": "subtitle", "time": 13856.55, "timestamp": "03:50:56", "text": "ライブストリームのプレビューと、それから"}]
[{"type": "subtitle", "time": 13200.389, "timestamp": "03:40:00", "text": "そんな感じ。右。そしてそれが"}, {"type": "subtitle", "time": 13204.63, "timestamp": "03:40:04", "text": "ライブ配信されると、"}, {"type": "subtitle", "time": 13206.07, "timestamp": "03:40:06", "text": "ストリームのサムネイル。わかった。"}, {"type": "subtitle", "time": 13208.87, "timestamp": "03:40:08", "text": "サムネイル。わかった。しかし、もし私たちが"}, {"type": "subtitle", "time": 13211.75, "timestamp": "03:40:11", "text": "世界が言ったこと、"}, {"type": "subtitle", "time": 13215.349, "timestamp": "03:40:15", "text": "私がストリーミング配信していると想像して、"}, {"type": "subtitle", "time": 13220.229, "timestamp": "03:40:20", "text": "メッセージIDへのパッチリクエストですよね？"}, {"type": "subtitle", "time": 13224.469, "timestamp": "03:40:24", "text": "そして、産婦人科医から写真が送られてきます。"}, {"type": "subtitle", "time": 13227.03, "timestamp": "03:40:27", "text": "あ、待って。私はOBSを使っていません。いいえ、"}, {"type": "subtitle", "time": 13231.429, "timestamp": "03:40:31", "text": "Meltから画像を入手してください。待って、待って、"}, {"type": "subtitle", "time": 13234.15, "timestamp": "03:40:34", "text": "待って、待って、待って、待って。私ならできます。"}, {"type": "subtitle", "time": 13236.63, "timestamp": "03:40:36", "text": "Wolf Beast拡張機能を使えばそれが可能です。"}, {"type": "subtitle", "time": 13239.75, "timestamp": "03:40:39", "text": "待って、待って。私ならできると思います。待って、"}, {"type": "subtitle", "time": 13242.71, "timestamp": "03:40:42", "text": "待って、待って、待って。写真を撮ってみよう"}, {"type": "subtitle", "time": 13247.11, "timestamp": "03:40:47", "text": "スクリーンショット。メルはどこ？メルはああ、私は"}, {"type": "subtitle", "time": 13255.75, "timestamp": "03:40:55", "text": "何てことだ。わかった。"}, {"type": "subtitle", "time": 13258.389, "timestamp": "03:40:58", "text": "ベースエンコードします"}]
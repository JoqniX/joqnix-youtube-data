[{"type": "subtitle", "time": 19584.708, "timestamp": "05:26:24", "text": "サミーは動作がすごく遅いんだよね。ほら、それは"}, {"type": "subtitle", "time": 19587.67, "timestamp": "05:26:27", "text": "立ち往生。"}, {"type": "subtitle", "time": 19609.75, "timestamp": "05:26:49", "text": "わかった。最初のものが最新のものですよね？"}, {"type": "subtitle", "time": 19617.83, "timestamp": "05:26:57", "text": "わかった。ゼロが最初のものとなるだろう。わかった。"}]
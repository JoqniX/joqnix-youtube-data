[{"type": "subtitle", "time": 4092.63, "timestamp": "01:08:12", "text": "えっと"}, {"type": "subtitle", "time": 4095.109, "timestamp": "01:08:15", "text": "ああ、落ち着く"}, {"type": "subtitle", "time": 4098.709, "timestamp": "01:08:18", "text": "あなたは学期末試験を受けています。おお。"}, {"type": "subtitle", "time": 4108.39, "timestamp": "01:08:28", "text": "はい、どうぞ。はい、送信します"}, {"type": "subtitle", "time": 4115.03, "timestamp": "01:08:35", "text": "わかりました、それではパッチをリクエストします"}, {"type": "subtitle", "time": 4118.39, "timestamp": "01:08:38", "text": "この男。わかった、"}, {"type": "subtitle", "time": 4120.87, "timestamp": "01:08:40", "text": "大学生活が恋しいですか？ええ、"}, {"type": "subtitle", "time": 4125.43, "timestamp": "01:08:45", "text": "実は、私はINUをやっているので、オンラインなんです。"}, {"type": "subtitle", "time": 4128.309, "timestamp": "01:08:48", "text": "えっと、大学[音楽]だから私はただ行くだけです"}, {"type": "subtitle", "time": 4131.43, "timestamp": "01:08:51", "text": "地元の試験センターで試験を受けてください。"}, {"type": "subtitle", "time": 4134.07, "timestamp": "01:08:54", "text": "そういうわけで、学校生活が恋しいです"}, {"type": "subtitle", "time": 4135.829, "timestamp": "01:08:55", "text": "友達と遊ぶ場所"}, {"type": "subtitle", "time": 4139.59, "timestamp": "01:08:59", "text": "友達はカフェテリアに行って食べる"}]
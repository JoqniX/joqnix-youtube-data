[{"type": "subtitle", "time": 5525.59, "timestamp": "01:32:05", "text": "えっと、ストリーム。ああ、これは必要ないね。"}, {"type": "subtitle", "time": 5535.91, "timestamp": "01:32:15", "text": "そして配列への挿入。配列挿入"}, {"type": "subtitle", "time": 5542.709, "timestamp": "01:32:22", "text": "一番上ですよね？ああ、この男は"}, {"type": "subtitle", "time": 5551.43, "timestamp": "01:32:31", "text": "その名前と値を削除してください。"}, {"type": "subtitle", "time": 5559.189, "timestamp": "01:32:39", "text": "はい、ループの後にこれを入力してください。作成する"}, {"type": "subtitle", "time": 5563.59, "timestamp": "01:32:43", "text": "物体。はい、同じことです。"}, {"type": "subtitle", "time": 5565.43, "timestamp": "01:32:45", "text": "オブジェクトを作成する必要はないと思います"}, {"type": "subtitle", "time": 5569.83, "timestamp": "01:32:49", "text": "ここ。それでは、これらをコピーします。"}, {"type": "subtitle", "time": 5571.99, "timestamp": "01:32:51", "text": "これをコピーしてください。"}, {"type": "subtitle", "time": 5575.51, "timestamp": "01:32:55", "text": "ここに貼り付けておきますね。また"}, {"type": "subtitle", "time": 5578.07, "timestamp": "01:32:58", "text": "オブジェクトの作成について、"}]
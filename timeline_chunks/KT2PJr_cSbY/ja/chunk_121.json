[{"type": "subtitle", "time": 7261.589, "timestamp": "02:01:01", "text": "これからはもっと自分の健康に気を遣うようにします。"}, {"type": "subtitle", "time": 7288.07, "timestamp": "02:01:28", "text": "ああ、一体どこまで話したっけ？"}, {"type": "subtitle", "time": 7291.589, "timestamp": "02:01:31", "text": "そうですね、私は、"}, {"type": "subtitle", "time": 7293.83, "timestamp": "02:01:33", "text": "あなたが見たように私は見てきました"}, {"type": "subtitle", "time": 7297.03, "timestamp": "02:01:37", "text": "シュラウドのようなものからインスピレーションを受けている。"}, {"type": "subtitle", "time": 7299.03, "timestamp": "02:01:39", "text": "私もそういうことをしたいんです。"}, {"type": "subtitle", "time": 7301.51, "timestamp": "02:01:41", "text": "そして私は気づいた"}, {"type": "subtitle", "time": 7305.83, "timestamp": "02:01:45", "text": "そして、それは良くないことだと気づいた。"}, {"type": "subtitle", "time": 7314.47, "timestamp": "02:01:54", "text": "覆い布。いや、彼は抜け目のない何かを持っているんだ。"}, {"type": "subtitle", "time": 7316.149, "timestamp": "02:01:56", "text": "抜け目ない。"}, {"type": "subtitle", "time": 7318.39, "timestamp": "02:01:58", "text": "待て、賢いな。"}]
[{"type": "subtitle", "time": 19444.868, "timestamp": "05:24:04", "text": "それはもっと後でやります。わかった。ともかく、"}, {"type": "subtitle", "time": 19452.31, "timestamp": "05:24:12", "text": "待って、スマホにも表示されるの？欲しい"}, {"type": "subtitle", "time": 19455.19, "timestamp": "05:24:15", "text": "それを確認するため。"}, {"type": "subtitle", "time": 19459.83, "timestamp": "05:24:19", "text": "もしそうなら、その電話は正常です。"}, {"type": "subtitle", "time": 19462.39, "timestamp": "05:24:22", "text": "そうでないなら、それは悪い。したい"}, {"type": "subtitle", "time": 19465.27, "timestamp": "05:24:25", "text": "チェック。"}]
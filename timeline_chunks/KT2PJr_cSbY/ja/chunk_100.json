[{"type": "subtitle", "time": 6002.39, "timestamp": "01:40:02", "text": "埋め込み作業を自動化する。"}, {"type": "subtitle", "time": 6004.55, "timestamp": "01:40:04", "text": "スケジュールされたストリームがあるときはいつでも、"}, {"type": "subtitle", "time": 6007.43, "timestamp": "01:40:07", "text": "スケジュールチャンネルに表示されます。"}, {"type": "subtitle", "time": 6009.91, "timestamp": "01:40:09", "text": "これは動的に更新されます。私は"}, {"type": "subtitle", "time": 6013.35, "timestamp": "01:40:13", "text": "単に更新しているだけです。つまり、拡張性があるということです。"}, {"type": "subtitle", "time": 6016.31, "timestamp": "01:40:16", "text": "15のストリームへ。"}, {"type": "subtitle", "time": 6019.99, "timestamp": "01:40:19", "text": "ええ、私が持っていた古いバージョンは"}, {"type": "subtitle", "time": 6023.189, "timestamp": "01:40:23", "text": "この古いバージョンでは、"}, {"type": "subtitle", "time": 6026.229, "timestamp": "01:40:26", "text": "12ストリーム。いいえ、12ではありません。6つのストリームです。"}, {"type": "subtitle", "time": 6029.43, "timestamp": "01:40:29", "text": "どうやら。 6つですよね？うん。うん。の"}, {"type": "subtitle", "time": 6031.83, "timestamp": "01:40:31", "text": "新バージョンは最大15までサポートします"}, {"type": "subtitle", "time": 6033.59, "timestamp": "01:40:33", "text": "ストリーム。"}, {"type": "subtitle", "time": 6035.99, "timestamp": "01:40:35", "text": "だから、新しいストリームが新しい"}, {"type": "subtitle", "time": 6038.709, "timestamp": "01:40:38", "text": "今後のストリームのスケジュールは"}, {"type": "subtitle", "time": 6043.03, "timestamp": "01:40:43", "text": "何かが起これば、ここに表示されます。うん、"}, {"type": "subtitle", "time": 6046.709, "timestamp": "01:40:46", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 6050.149, "timestamp": "01:40:50", "text": "ああ、大変だ。これはホリヴに似ています"}, {"type": "subtitle", "time": 6052.229, "timestamp": "01:40:52", "text": "ファンサーバー"}, {"type": "subtitle", "time": 6053.91, "timestamp": "01:40:53", "text": "もの。"}, {"type": "subtitle", "time": 6057.59, "timestamp": "01:40:57", "text": "えっと、もし私が彼らのイベントに行ったら。"}]
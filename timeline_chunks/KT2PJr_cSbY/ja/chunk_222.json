[{"type": "subtitle", "time": 13320.79, "timestamp": "03:42:00", "text": "今、すごく幸せです。わからない"}, {"type": "subtitle", "time": 13340.79, "timestamp": "03:42:20", "text": "文字列選択。これらはモデルです"}, {"type": "subtitle", "time": 13358.15, "timestamp": "03:42:38", "text": "コンポーネント分離媒体について私が言うように"}, {"type": "subtitle", "time": 13366.55, "timestamp": "03:42:46", "text": "私はこれをやるつもりだ。私たちはああ"}, {"type": "subtitle", "time": 13370.469, "timestamp": "03:42:50", "text": "ああ、アイデアが山ほどある"}, {"type": "subtitle", "time": 13378.71, "timestamp": "03:42:58", "text": "チャットで誰かが感嘆符を発した場合"}]
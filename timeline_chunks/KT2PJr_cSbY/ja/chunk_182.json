[{"type": "subtitle", "time": 10921.11, "timestamp": "03:02:01", "text": "だから、私がスケジュールを組んでいるときは"}, {"type": "subtitle", "time": 10924.55, "timestamp": "03:02:04", "text": "私のチャンネルのストリームは更新されます"}, {"type": "subtitle", "time": 10927.11, "timestamp": "03:02:07", "text": "このような。"}, {"type": "subtitle", "time": 10928.87, "timestamp": "03:02:08", "text": "右。"}, {"type": "subtitle", "time": 10934.07, "timestamp": "03:02:14", "text": "こんにちは、くるみあやみチャンネル。いらっしゃいませ"}, {"type": "subtitle", "time": 10936.55, "timestamp": "03:02:16", "text": "ジョー。あなたはアニメを見ますか？ええ、そうです"}, {"type": "subtitle", "time": 10939.269, "timestamp": "03:02:19", "text": "実際にアニメを見てみよう。"}, {"type": "subtitle", "time": 10943.99, "timestamp": "03:02:23", "text": "私はアニメを見ます。私は"}, {"type": "subtitle", "time": 10947.03, "timestamp": "03:02:27", "text": "アニメをいくつか見ています"}, {"type": "subtitle", "time": 10955.269, "timestamp": "03:02:35", "text": "えっと、"}, {"type": "subtitle", "time": 10961.269, "timestamp": "03:02:41", "text": "それで、"}, {"type": "subtitle", "time": 10964.23, "timestamp": "03:02:44", "text": "ああ、これは資本主義に違いない。"}, {"type": "subtitle", "time": 10968.79, "timestamp": "03:02:48", "text": "待って、Hを変更してもいいですか？それは野原です。"}, {"type": "subtitle", "time": 10978.07, "timestamp": "03:02:58", "text": "今後のエビの出荷予定日が無効です。おお、"}]
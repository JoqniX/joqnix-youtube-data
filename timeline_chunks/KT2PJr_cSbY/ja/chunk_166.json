[{"type": "subtitle", "time": 9962.23, "timestamp": "02:46:02", "text": "10分間隔の配信を始めなければならない。"}, {"type": "subtitle", "time": 9965.429, "timestamp": "02:46:05", "text": "私はそうするべきなのです。なぜ私はそうではないのか"}, {"type": "subtitle", "time": 9972.95, "timestamp": "02:46:12", "text": "ダミー。ダムダム。"}, {"type": "subtitle", "time": 9976.63, "timestamp": "02:46:16", "text": "でも、やらなきゃいけないんだよ。"}, {"type": "subtitle", "time": 9979.51, "timestamp": "02:46:19", "text": "CRを使用してください。ええ、フラグ付きを使っていました"}, {"type": "subtitle", "time": 9982.389, "timestamp": "02:46:22", "text": "実際に学習するときのバージョンと"}, {"type": "subtitle", "time": 9984.55, "timestamp": "02:46:24", "text": "もの。 [音楽] それは、まあ、"}, {"type": "subtitle", "time": 9986.79, "timestamp": "02:46:26", "text": "本物は、私がリリースした場合のように存在します"}, {"type": "subtitle", "time": 9990.309, "timestamp": "02:46:30", "text": "私の歌は出版社か何か"}, {"type": "subtitle", "time": 9993.67, "timestamp": "02:46:33", "text": "人々または一部のデジタルライセンス"}, {"type": "subtitle", "time": 9995.83, "timestamp": "02:46:35", "text": "彼らは私がフラグを立てたことを知ることができる"}, {"type": "subtitle", "time": 9997.99, "timestamp": "02:46:37", "text": "ソフトウェア。だから私はその問題が"}, {"type": "subtitle", "time": 10000.63, "timestamp": "02:46:40", "text": "起こる。いいえ、ソフトウェアにフラグを立てることも"}, {"type": "subtitle", "time": 10002.79, "timestamp": "02:46:42", "text": "または音を知らせる、または"}, {"type": "subtitle", "time": 10005.83, "timestamp": "02:46:45", "text": "プラグイン。いや、捕まるかもしれないから"}, {"type": "subtitle", "time": 10007.99, "timestamp": "02:46:47", "text": "ライセンス料を本当に支払わなければならない"}, {"type": "subtitle", "time": 10010.71, "timestamp": "02:46:50", "text": "それ。それに関する動画をいくつか見ました。だから私は"}, {"type": "subtitle", "time": 10013.11, "timestamp": "02:46:53", "text": "「わかった、じゃあいいよ。"}, {"type": "subtitle", "time": 10016.55, "timestamp": "02:46:56", "text": "「何とかして買ってくれ」と父に頼んだんです（笑）。"}]
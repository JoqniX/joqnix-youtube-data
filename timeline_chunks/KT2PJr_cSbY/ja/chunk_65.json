[{"type": "subtitle", "time": 3902.71, "timestamp": "01:05:02", "text": "こんにちは、フィールドが完了しました。フッターのテストカラー。私たちは"}, {"type": "subtitle", "time": 3907.029, "timestamp": "01:05:07", "text": "色は指定されていません。うん。そして"}, {"type": "subtitle", "time": 3910.789, "timestamp": "01:05:10", "text": "説明完了。タイトル。わかった。"}, {"type": "subtitle", "time": 3914.23, "timestamp": "01:05:14", "text": "うん。基本的に、これで終わりです。"}, {"type": "subtitle", "time": 3916.71, "timestamp": "01:05:16", "text": "他に何か必要なものはありますか？私はしません"}, {"type": "subtitle", "time": 3929.829, "timestamp": "01:05:29", "text": "テスト目的で、私にはアイデアがあります。"}, {"type": "subtitle", "time": 3933.029, "timestamp": "01:05:33", "text": "テスト目的のため。"}, {"type": "subtitle", "time": 3956.15, "timestamp": "01:05:56", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 3958.47, "timestamp": "01:05:58", "text": "編集したくない。私はただ"}]
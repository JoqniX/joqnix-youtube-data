[{"type": "subtitle", "time": 7381.99, "timestamp": "02:03:01", "text": "そういう類のもの。"}, {"type": "subtitle", "time": 7384.55, "timestamp": "02:03:04", "text": "おお。"}, {"type": "subtitle", "time": 7387.43, "timestamp": "02:03:07", "text": "バットマンもそれ持ってるの？何"}, {"type": "subtitle", "time": 7395.75, "timestamp": "02:03:15", "text": "彼らは何をしていつも"}, {"type": "subtitle", "time": 7405.27, "timestamp": "02:03:25", "text": "ジョアソンは当時としては驚異的だった。うん。"}, {"type": "subtitle", "time": 7420.79, "timestamp": "02:03:40", "text": "どうしてこんなに極端な人が多いんだろう。"}]
[{"type": "subtitle", "time": 17281.99, "timestamp": "04:48:01", "text": "よし。"}, {"type": "subtitle", "time": 17283.99, "timestamp": "04:48:03", "text": "私は一体いつ寝ているんだろう？私は普段寝ています"}, {"type": "subtitle", "time": 17286.708, "timestamp": "04:48:06", "text": "この頃"}, {"type": "subtitle", "time": 17300.55, "timestamp": "04:48:20", "text": "とにかく早起きしないといけないんです。明日"}, {"type": "subtitle", "time": 17303.03, "timestamp": "04:48:23", "text": "日本語の練習をしなくてはならない"}, {"type": "subtitle", "time": 17307.83, "timestamp": "04:48:27", "text": "さあ、今すぐやろう。試験があるから復習する"}]
[{"type": "subtitle", "time": 1623.909, "timestamp": "00:27:03", "text": "こんな感じのものですが、とてもひどいです。"}, {"type": "subtitle", "time": 1626.23, "timestamp": "00:27:06", "text": "これはひどい。"}, {"type": "subtitle", "time": 1630.23, "timestamp": "00:27:10", "text": "これは非常に悪いので、"}, {"type": "subtitle", "time": 1632.47, "timestamp": "00:27:12", "text": "ズームインするやつ。"}, {"type": "subtitle", "time": 1634.47, "timestamp": "00:27:14", "text": "ズームイン機能しか使えません。これは"}, {"type": "subtitle", "time": 1638.47, "timestamp": "00:27:18", "text": "ひどい。 Twitch のようなものですよね？もし私が"}, {"type": "subtitle", "time": 1641.99, "timestamp": "00:27:21", "text": "ハローコマースアカデミーを見てみることにした。"}, {"type": "subtitle", "time": 1644.87, "timestamp": "00:27:24", "text": "こんにちは。こんにちは。 Twitchへようこそ、"}, {"type": "subtitle", "time": 1649.11, "timestamp": "00:27:29", "text": "右？えっと、Twitchの垂直方向"}, {"type": "subtitle", "time": 1652.71, "timestamp": "00:27:32", "text": "フォーラム。うん。こんにちは。私はあなたの友達です。"}, {"type": "subtitle", "time": 1656.63, "timestamp": "00:27:36", "text": "はい、あなたのことは知っています。こんにちは。どうやって"}, {"type": "subtitle", "time": 1658.31, "timestamp": "00:27:38", "text": "何をしているの？"}, {"type": "subtitle", "time": 1661.75, "timestamp": "00:27:41", "text": "Twitchでは、"}, {"type": "subtitle", "time": 1665.269, "timestamp": "00:27:45", "text": "ストリームキーを送信してください。今、"}, {"type": "subtitle", "time": 1667.35, "timestamp": "00:27:47", "text": "えーと"}, {"type": "subtitle", "time": 1678.789, "timestamp": "00:27:58", "text": "デュアルストリームのものをプレビューする。"}]
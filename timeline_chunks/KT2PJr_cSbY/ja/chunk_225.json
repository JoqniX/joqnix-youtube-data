[{"type": "subtitle", "time": 13500.15, "timestamp": "03:45:00", "text": "分、カウントダウンのようなもの。うん。"}, {"type": "subtitle", "time": 13503.189, "timestamp": "03:45:03", "text": "そして、新しい"}, {"type": "subtitle", "time": 13505.91, "timestamp": "03:45:05", "text": "コンテナコンポーネント。これは"}, {"type": "subtitle", "time": 13508.389, "timestamp": "03:45:08", "text": "容器。これはテキスト表示です。これ"}, {"type": "subtitle", "time": 13511.51, "timestamp": "03:45:11", "text": "メディア関連のもので、"}, {"type": "subtitle", "time": 13514.229, "timestamp": "03:45:14", "text": "ボタンとかそういう類。ええ、私は"}, {"type": "subtitle", "time": 13518.71, "timestamp": "03:45:18", "text": "昔よくやっていた埋め込みのようなもの"}, {"type": "subtitle", "time": 13521.03, "timestamp": "03:45:21", "text": "どうやら。私は全く覚えていなかった。私"}, {"type": "subtitle", "time": 13524.389, "timestamp": "03:45:24", "text": "Vアップロード通知のためにやった"}, {"type": "subtitle", "time": 13528.71, "timestamp": "03:45:28", "text": "このような。つまり、こんな感じです。うん、"}, {"type": "subtitle", "time": 13531.51, "timestamp": "03:45:31", "text": "これと似たようなもの。それから私は"}, {"type": "subtitle", "time": 13533.349, "timestamp": "03:45:33", "text": "私はそれを、"}, {"type": "subtitle", "time": 13536.07, "timestamp": "03:45:36", "text": "配信画面のスクリーンショット。だから私が"}, {"type": "subtitle", "time": 13539.83, "timestamp": "03:45:39", "text": "ライブ配信中、実際に積極的に"}, {"type": "subtitle", "time": 13542.63, "timestamp": "03:45:42", "text": "このボタンを編集してください。"}, {"type": "subtitle", "time": 13545.59, "timestamp": "03:45:45", "text": "えっと、画面のスクリーンショットを撮る"}, {"type": "subtitle", "time": 13550.15, "timestamp": "03:45:50", "text": "私の溶ける。私は明らかな溶融を使用していません"}, {"type": "subtitle", "time": 13553.349, "timestamp": "03:45:53", "text": "えっと、メディアとしてここにアップロードしてください"}, {"type": "subtitle", "time": 13557.189, "timestamp": "03:45:57", "text": "あれ。ノードをチェックする人々"}]
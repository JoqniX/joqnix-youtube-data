[{"type": "subtitle", "time": 21303.67, "timestamp": "05:55:03", "text": "大文字小文字の切り替えを使うべきだと思う。"}, {"type": "subtitle", "time": 21306.788, "timestamp": "05:55:06", "text": "ケースをこちらに交換してください。"}, {"type": "subtitle", "time": 21314.628, "timestamp": "05:55:14", "text": "そして、その場合。"}, {"type": "subtitle", "time": 21329.11, "timestamp": "05:55:29", "text": "次は生放送です。"}, {"type": "subtitle", "time": 21348.548, "timestamp": "05:55:48", "text": "ああ、神様、私は死にそうです。"}]
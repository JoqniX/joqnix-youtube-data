[{"type": "subtitle", "time": 1864.789, "timestamp": "00:31:04", "text": "ああ、今は夜だ。ええ、これは"}, {"type": "subtitle", "time": 1867.909, "timestamp": "00:31:07", "text": "2番目のストリーム。私は出席しなければならなかった"}, {"type": "subtitle", "time": 1870.31, "timestamp": "00:31:10", "text": "日本語教室。その後、私は"}, {"type": "subtitle", "time": 1873.669, "timestamp": "00:31:13", "text": "起動して、うん、これが2回目"}, {"type": "subtitle", "time": 1877.269, "timestamp": "00:31:17", "text": "ストリーム。夜までコーディングするつもりだ。ない"}, {"type": "subtitle", "time": 1881.59, "timestamp": "00:31:21", "text": "夜までコードを書いて、いろいろ修正する。彼"}, {"type": "subtitle", "time": 1886.389, "timestamp": "00:31:26", "text": "ご回答ありがとうございます。"}, {"type": "subtitle", "time": 1888.23, "timestamp": "00:31:28", "text": "いらっしゃいませ、"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "わかった。それで、"}, {"type": "subtitle", "time": 1912.71, "timestamp": "00:31:52", "text": "というわけで、これまでのところ、私はこれをやってきました。うまくいっているようだ。"}, {"type": "subtitle", "time": 1917.509, "timestamp": "00:31:57", "text": "その物質は"}]
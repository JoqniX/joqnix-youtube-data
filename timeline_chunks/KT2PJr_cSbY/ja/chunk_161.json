[{"type": "subtitle", "time": 9664.95, "timestamp": "02:41:04", "text": "これについても繰り返しますか？または単に引っ張る"}, {"type": "subtitle", "time": 9688.469, "timestamp": "02:41:28", "text": "つまり、ここからストリームが配信されるということです"}, {"type": "subtitle", "time": 9691.75, "timestamp": "02:41:31", "text": "最初の物体と最初の親指"}, {"type": "subtitle", "time": 9698.55, "timestamp": "02:41:38", "text": "私は音楽制作に取り組んでいます"}, {"type": "subtitle", "time": 9702.87, "timestamp": "02:41:42", "text": "良い。ディオ、行こう。わーい。"}, {"type": "subtitle", "time": 9718.309, "timestamp": "02:41:58", "text": "アップルスタジオ。ああ、いいね。私は"}]
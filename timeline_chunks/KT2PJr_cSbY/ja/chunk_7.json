[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "そして明後日の配信も"}, {"type": "subtitle", "time": 424.15, "timestamp": "00:07:04", "text": "予定は組まれていましたよね？それら全て。"}, {"type": "subtitle", "time": 426.15, "timestamp": "00:07:06", "text": "今日の配信を終える前に、"}, {"type": "subtitle", "time": 434.39, "timestamp": "00:07:14", "text": "検出するすべての自動化"}, {"type": "subtitle", "time": 438.87, "timestamp": "00:07:18", "text": "ストリームスケジュールのタイムディッシュと"}, {"type": "subtitle", "time": 442.23, "timestamp": "00:07:22", "text": "それら全てをアップデートしてパッチを適用してください。わかった。"}, {"type": "subtitle", "time": 444.79, "timestamp": "00:07:24", "text": "うん。では、何が起こるか見てみましょう"}, {"type": "subtitle", "time": 452.469, "timestamp": "00:07:32", "text": "たとえ自分がうまくいかなかったと思っても、"}, {"type": "subtitle", "time": 455.51, "timestamp": "00:07:35", "text": "少なくとも内容を修正して、"}, {"type": "subtitle", "time": 458.71, "timestamp": "00:07:38", "text": "次はうまくいくよね？または"}, {"type": "subtitle", "time": 462.55, "timestamp": "00:07:42", "text": "少なくとも何が何だか分かるし、"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "すべて。よし。うん。あなたはそうしました"}, {"type": "subtitle", "time": 468.55, "timestamp": "00:07:48", "text": "あなたのベストを尽くします。そう、それは、それは"}, {"type": "subtitle", "time": 472.39, "timestamp": "00:07:52", "text": "は。心配ない。"}, {"type": "subtitle", "time": 475.589, "timestamp": "00:07:55", "text": "待てよ、今は11月だ。いいえ。えっと、それは"}, {"type": "subtitle", "time": 478.55, "timestamp": "00:07:58", "text": "期末試験？いいえ、冬の期末試験ではありません。"}]
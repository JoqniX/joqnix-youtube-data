[{"type": "subtitle", "time": 2822.15, "timestamp": "00:47:02", "text": "こんにちは、Flash Vさん。こんばんは。こんにちは。"}, {"type": "subtitle", "time": 2828.71, "timestamp": "00:47:08", "text": "あなたの場合、stringifyを使う必要があります。"}, {"type": "subtitle", "time": 2832.309, "timestamp": "00:47:12", "text": "えっと、stringify を使うように指示されています。"}, {"type": "subtitle", "time": 2835.43, "timestamp": "00:47:15", "text": "不適切"}, {"type": "subtitle", "time": 2837.67, "timestamp": "00:47:17", "text": "JSONボディの場合。それはあなたの"}, {"type": "subtitle", "time": 2841.75, "timestamp": "00:47:21", "text": "埋め込み。よし、じゃあstringifiを手に入れたってことだね。"}, {"type": "subtitle", "time": 2855.19, "timestamp": "00:47:35", "text": "要素の感触が悪い。それで"}, {"type": "subtitle", "time": 2856.95, "timestamp": "00:47:36", "text": "配列全体を文字列として返します。あなた"}, {"type": "subtitle", "time": 2858.47, "timestamp": "00:47:38", "text": "このコマンドを使用してファイルを保存できます"}, {"type": "subtitle", "time": 2859.91, "timestamp": "00:47:39", "text": "配列全体を保存する文字列コマンド"}, {"type": "subtitle", "time": 2863.03, "timestamp": "00:47:43", "text": "提出する。わかった。ファイル保存文字列。いいえ。"}, {"type": "subtitle", "time": 2864.55, "timestamp": "00:47:44", "text": "わかった。わかった。わかった。一度ロードすると"}, {"type": "subtitle", "time": 2867.67, "timestamp": "00:47:47", "text": "ファイルでは、pass を使用できます。ああ、ありがとう"}, {"type": "subtitle", "time": 2869.91, "timestamp": "00:47:49", "text": "そのため。私は実際にそれが必要です"}, {"type": "subtitle", "time": 2872.71, "timestamp": "00:47:52", "text": "ローカルログ、ログシステムのようなもの、"}, {"type": "subtitle", "time": 2874.47, "timestamp": "00:47:54", "text": "右？"}, {"type": "subtitle", "time": 2878.47, "timestamp": "00:47:58", "text": "だって、もしあなたが"}]
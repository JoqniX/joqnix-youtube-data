[{"type": "subtitle", "time": 1202.47, "timestamp": "00:20:02", "text": "待って、君は僕が聴いていた音楽を聴いていたの？"}, {"type": "subtitle", "time": 1205.19, "timestamp": "00:20:05", "text": "私の音楽で演奏している？ [息を呑む]"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "待って、"}, {"type": "subtitle", "time": 1211.11, "timestamp": "00:20:11", "text": "音楽を入れないでください。ああ、いや、できない"}, {"type": "subtitle", "time": 1213.75, "timestamp": "00:20:13", "text": "そうしてください。"}, {"type": "subtitle", "time": 1220.23, "timestamp": "00:20:20", "text": "YouTube、"}, {"type": "subtitle", "time": 1223.35, "timestamp": "00:20:23", "text": "ええと、それは私にはできません。 YouTube"}, {"type": "subtitle", "time": 1225.59, "timestamp": "00:20:25", "text": "著作権。"}, {"type": "subtitle", "time": 1229.83, "timestamp": "00:20:29", "text": "知りませんでした。ほら、これを見て。"}, {"type": "subtitle", "time": 1234.149, "timestamp": "00:20:34", "text": "ゲームキャプチャには自動機能があります"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "全画面自動キャプチャ機能。わかった。"}, {"type": "subtitle", "time": 1240.149, "timestamp": "00:20:40", "text": "それは一部のファイルエクスプローラーをキャプチャしていました"}, {"type": "subtitle", "time": 1242.23, "timestamp": "00:20:42", "text": "奇妙な理由だ。私のYouTubeをキャプチャしました"}, {"type": "subtitle", "time": 1243.83, "timestamp": "00:20:43", "text": "音楽。"}, {"type": "subtitle", "time": 1246.789, "timestamp": "00:20:46", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "おお。"}, {"type": "subtitle", "time": 1252.789, "timestamp": "00:20:52", "text": "でも、心配しないでください。えっと、どこ"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "YouTubeの音楽関連のものを"}]
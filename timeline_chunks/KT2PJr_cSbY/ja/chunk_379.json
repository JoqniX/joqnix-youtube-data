[{"type": "subtitle", "time": 22743.27, "timestamp": "06:19:03", "text": "持続する。いつも言いたいことがあるなら"}, {"type": "subtitle", "time": 22746.07, "timestamp": "06:19:06", "text": "ハードコアな、あなたがやったように、またはそれを作る"}, {"type": "subtitle", "time": 22749.59, "timestamp": "06:19:09", "text": "柔軟に対応できるなら、それで構いません。"}, {"type": "subtitle", "time": 22751.91, "timestamp": "06:19:11", "text": "知っている。彼らがそれを成し遂げる唯一の瞬間だと思う"}, {"type": "subtitle", "time": 22770.708, "timestamp": "06:19:30", "text": "不思議に思う"}, {"type": "subtitle", "time": 22774.628, "timestamp": "06:19:34", "text": "それは示されなければならなかったし"}, {"type": "subtitle", "time": 22778.15, "timestamp": "06:19:38", "text": "こんな感じ"}, {"type": "subtitle", "time": 22781.99, "timestamp": "06:19:41", "text": "編集ミスか何かで紛失した。"}, {"type": "subtitle", "time": 22784.39, "timestamp": "06:19:44", "text": "それは何ですか"}, {"type": "subtitle", "time": 22799.59, "timestamp": "06:19:59", "text": "どこかで"}]
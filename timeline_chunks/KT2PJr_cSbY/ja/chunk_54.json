[{"type": "subtitle", "time": 3240.79, "timestamp": "00:54:00", "text": "その瞬間。"}, {"type": "subtitle", "time": 3244.23, "timestamp": "00:54:04", "text": "ああ、あとこのフッターも気に入ってるよ。"}, {"type": "subtitle", "time": 3248.15, "timestamp": "00:54:08", "text": "私はここでそうしました。それをそのままコピーしてもいいですか？おお、"}, {"type": "subtitle", "time": 3250.23, "timestamp": "00:54:10", "text": "待って。コピーする必要はありません"}, {"type": "subtitle", "time": 3252.069, "timestamp": "00:54:12", "text": "もうそれは無理だ。"}, {"type": "subtitle", "time": 3255.43, "timestamp": "00:54:15", "text": "いいえ、忘れていました。私はそうする必要はない"}, {"type": "subtitle", "time": 3257.43, "timestamp": "00:54:17", "text": "なぜなら埋め込みボディは"}, {"type": "subtitle", "time": 3263.51, "timestamp": "00:54:23", "text": "動的なフッター。ああ、この男も欲しがっている"}, {"type": "subtitle", "time": 3266.23, "timestamp": "00:54:26", "text": "それ。わかった。"}, {"type": "subtitle", "time": 3269.829, "timestamp": "00:54:29", "text": "動的なフッター。"}, {"type": "subtitle", "time": 3276.309, "timestamp": "00:54:36", "text": "タイムスタンプを追加します。自動更新。あなたは"}, {"type": "subtitle", "time": 3277.91, "timestamp": "00:54:37", "text": "タイムスタンプを含む。必ず"}, {"type": "subtitle", "time": 3280.71, "timestamp": "00:54:40", "text": "パッチの直前のサムネイル"}, {"type": "subtitle", "time": 3284.15, "timestamp": "00:54:44", "text": "現在の更新時刻。"}, {"type": "subtitle", "time": 3286.87, "timestamp": "00:54:46", "text": "オプションで視覚的な一貫性を保つ。絵文字を追加する"}, {"type": "subtitle", "time": 3290.309, "timestamp": "00:54:50", "text": "プラットフォームごとに動的にキャストします。あなた"}, {"type": "subtitle", "time": 3292.15, "timestamp": "00:54:52", "text": "フィールドごとにストリームを設定でき、"}, {"type": "subtitle", "time": 3296.309, "timestamp": "00:54:56", "text": "絵文字はフィールドとブロックに応じて表示されます"}, {"type": "subtitle", "time": 3299.43, "timestamp": "00:54:59", "text": "テキストマルチリームスケーリングは"}]
[{"type": "subtitle", "time": 7321.35, "timestamp": "02:02:01", "text": "そう、24時間放送のチャンネルみたいな感じ"}, {"type": "subtitle", "time": 7324.79, "timestamp": "02:02:04", "text": "あれ、常時オンのあれ、"}, {"type": "subtitle", "time": 7327.27, "timestamp": "02:02:07", "text": "右？このような、"}, {"type": "subtitle", "time": 7330.629, "timestamp": "02:02:10", "text": "右？彼はストリームを入手してプレイし、"}, {"type": "subtitle", "time": 7332.95, "timestamp": "02:02:12", "text": "もの。彼らはそれを"}, {"type": "subtitle", "time": 7336.87, "timestamp": "02:02:16", "text": "サーバーは今、そして時々、あなたを置いて"}, {"type": "subtitle", "time": 7338.87, "timestamp": "02:02:18", "text": "これらのファイルをダウンロードして配置するか、"}, {"type": "subtitle", "time": 7342.55, "timestamp": "02:02:22", "text": "何かあるよね？"}, {"type": "subtitle", "time": 7345.83, "timestamp": "02:02:25", "text": "何かやってみたい"}, {"type": "subtitle", "time": 7347.91, "timestamp": "02:02:27", "text": "このような"}, {"type": "subtitle", "time": 7351.109, "timestamp": "02:02:31", "text": "基本的にはTwitchで配信されています。 YouTube にはない、"}, {"type": "subtitle", "time": 7353.75, "timestamp": "02:02:33", "text": "Twitch で人々が常に"}, {"type": "subtitle", "time": 7356.629, "timestamp": "02:02:36", "text": "私の配信を見てください、もし彼らが"}, {"type": "subtitle", "time": 7359.189, "timestamp": "02:02:39", "text": "経験や"}, {"type": "subtitle", "time": 7362.709, "timestamp": "02:02:42", "text": "基本的に私がやったような"}, {"type": "subtitle", "time": 7365.589, "timestamp": "02:02:45", "text": "ジョアソンですよね？私が寝ている間に、"}, {"type": "subtitle", "time": 7368.709, "timestamp": "02:02:48", "text": "WSオンですよね？"}, {"type": "subtitle", "time": 7371.669, "timestamp": "02:02:51", "text": "うん。私は、私は、ぜひやってみたいと思います"}, {"type": "subtitle", "time": 7379.43, "timestamp": "02:02:59", "text": "多くの人がこれを常にオンにしています"}]
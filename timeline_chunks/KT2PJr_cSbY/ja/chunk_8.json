[{"type": "subtitle", "time": 481.029, "timestamp": "00:08:01", "text": "右？それは起こるべきことだ"}, {"type": "subtitle", "time": 485.67, "timestamp": "00:08:05", "text": "12月に。いいえ、そうではありません"}, {"type": "subtitle", "time": 489.83, "timestamp": "00:08:09", "text": "合計50点？ああ、なるほど。"}, {"type": "subtitle", "time": 496.39, "timestamp": "00:08:16", "text": "[ため息をつき、息を呑む] こんにちは。戻ってきて、"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "アレクサ。つまり、これで終わりにしましょう。"}, {"type": "subtitle", "time": 502.39, "timestamp": "00:08:22", "text": "大丈夫です。どう思いますか？私は"}, {"type": "subtitle", "time": 504.07, "timestamp": "00:08:24", "text": "冗談だよ。"}, {"type": "subtitle", "time": 506.629, "timestamp": "00:08:26", "text": "期末試験は実施される。"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "最終試験は、私の知る限りでは"}, {"type": "subtitle", "time": 513.75, "timestamp": "00:08:33", "text": "たとえあなたが大学生であっても"}, {"type": "subtitle", "time": 517.029, "timestamp": "00:08:37", "text": "あるいは、通常は最終的なもののようなもの"}, {"type": "subtitle", "time": 520.149, "timestamp": "00:08:40", "text": "試験は"}, {"type": "subtitle", "time": 524.31, "timestamp": "00:08:44", "text": "4月、3月とか。いいえ、でもそれは"}, {"type": "subtitle", "time": 525.91, "timestamp": "00:08:45", "text": "他に何かありますか？あなたはどのコースを受講していますか？"}, {"type": "subtitle", "time": 529.829, "timestamp": "00:08:49", "text": "何をしているの？聞き忘れていました。"}, {"type": "subtitle", "time": 532.07, "timestamp": "00:08:52", "text": "H"}, {"type": "subtitle", "time": 534.63, "timestamp": "00:08:54", "text": "マヤ"}]
[{"type": "subtitle", "time": 4500.87, "timestamp": "01:15:00", "text": "ping 埋め込みを実行して自動的に"}, {"type": "subtitle", "time": 4503.03, "timestamp": "01:15:03", "text": "人々に、そう話すことになるだろうと伝える"}, {"type": "subtitle", "time": 4505.75, "timestamp": "01:15:05", "text": "ライブ配信を開始し、ストリームへのリンクと"}, {"type": "subtitle", "time": 4508.709, "timestamp": "01:15:08", "text": "他のプラットフォームのリンクとか、そういうのもあるね。"}, {"type": "subtitle", "time": 4512.07, "timestamp": "01:15:12", "text": "このようなものの代わりに"}, {"type": "subtitle", "time": 4515.91, "timestamp": "01:15:15", "text": "だから、そうするつもりです。だから、私は"}, {"type": "subtitle", "time": 4519.75, "timestamp": "01:15:19", "text": "Discordで何かに触れる必要はありません。"}, {"type": "subtitle", "time": 4522.39, "timestamp": "01:15:22", "text": "私がしなければならないことはインスタグラムと"}, {"type": "subtitle", "time": 4524.39, "timestamp": "01:15:24", "text": "ツイッター。次はTwitterを自動化する"}, {"type": "subtitle", "time": 4528.39, "timestamp": "01:15:28", "text": "時間。心配しないで。それは私の"}, {"type": "subtitle", "time": 4530.229, "timestamp": "01:15:30", "text": "もの。"}, {"type": "subtitle", "time": 4539.27, "timestamp": "01:15:39", "text": "うん。ライブツイートするには、"}, {"type": "subtitle", "time": 4541.43, "timestamp": "01:15:41", "text": "生放送のアナウンスをしなければならないので、"}, {"type": "subtitle", "time": 4544.31, "timestamp": "01:15:44", "text": "条件付き論理。"}, {"type": "subtitle", "time": 4545.03, "timestamp": "01:15:45", "text": "音楽のように"}, {"type": "subtitle", "time": 4555.99, "timestamp": "01:15:55", "text": "ええ、条件付きにする必要があります"}, {"type": "subtitle", "time": 4557.91, "timestamp": "01:15:57", "text": "論理。今"}]
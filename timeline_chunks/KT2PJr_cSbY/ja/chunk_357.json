[{"type": "subtitle", "time": 21429.35, "timestamp": "05:57:09", "text": "このパッチブロックを定期的に呼び出してください。"}, {"type": "subtitle", "time": 21434.31, "timestamp": "05:57:14", "text": "つまり、ボタンはマッピングアクションの実行時に実行されます。"}, {"type": "subtitle", "time": 21436.948, "timestamp": "05:57:16", "text": "わかった。 JSONを更新して再起動します"}, {"type": "subtitle", "time": 21441.67, "timestamp": "05:57:21", "text": "アクセント。よし、うまくいったと思う。そうですね、"}, {"type": "subtitle", "time": 21460.23, "timestamp": "05:57:40", "text": "わかった。ジェイソンの音楽に取り掛かりましょう"}, {"type": "subtitle", "time": 21462.948, "timestamp": "05:57:42", "text": "ペイロード。"}, {"type": "subtitle", "time": 21467.99, "timestamp": "05:57:47", "text": "ジェイソンのペイロードに取り掛かりましょう。うん。"}, {"type": "subtitle", "time": 21469.35, "timestamp": "05:57:49", "text": "あのね？少し食べよう"}, {"type": "subtitle", "time": 21471.27, "timestamp": "05:57:51", "text": "りんご。私は予備のリンゴを持っています"}, {"type": "subtitle", "time": 21472.39, "timestamp": "05:57:52", "text": "ここ。"}, {"type": "subtitle", "time": 21477.75, "timestamp": "05:57:57", "text": "えっと"}]
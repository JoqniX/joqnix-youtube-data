[{"type": "subtitle", "time": 540.47, "timestamp": "00:09:00", "text": "ここでシステムとはどういう意味ですか"}, {"type": "subtitle", "time": 542.07, "timestamp": "00:09:02", "text": "違う？待って、あなたはインド出身で、"}, {"type": "subtitle", "time": 550.389, "timestamp": "00:09:10", "text": "いや待て、"}, {"type": "subtitle", "time": 558.31, "timestamp": "00:09:18", "text": "ええ、あなたはインド出身ですね。ごめん。私は思う"}, {"type": "subtitle", "time": 561.67, "timestamp": "00:09:21", "text": "それは大学進学において賢明な判断だ。"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "私は50点満点の試験用紙をもらって、"}, {"type": "subtitle", "time": 567.67, "timestamp": "00:09:27", "text": "50点。"}, {"type": "subtitle", "time": 579.67, "timestamp": "00:09:39", "text": "わかった。わかった。それはまた違った奇妙さだ"}, {"type": "subtitle", "time": 583.99, "timestamp": "00:09:43", "text": "システム。番号：SM 1、SM 2、SM 3、SM 4。"}, {"type": "subtitle", "time": 586.23, "timestamp": "00:09:46", "text": "そうそう。"}, {"type": "subtitle", "time": 588.63, "timestamp": "00:09:48", "text": "イグヌ語版にもありますか？私は思う"}]
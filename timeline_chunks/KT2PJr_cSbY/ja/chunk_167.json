[{"type": "subtitle", "time": 10020.71, "timestamp": "02:47:00", "text": "私のためにそれをやってくれる"}, {"type": "subtitle", "time": 10023.269, "timestamp": "02:47:03", "text": "ロック後。ええ、今日でも私の"}, {"type": "subtitle", "time": 10025.83, "timestamp": "02:47:05", "text": "父が私に電話をかけてきて、なぜそんなにお金を使ったのかと聞いてくる"}, {"type": "subtitle", "time": 10028.71, "timestamp": "02:47:08", "text": "音楽コースにたくさんのお金"}, {"type": "subtitle", "time": 10032.309, "timestamp": "02:47:12", "text": "65,000人に対してまともに教えもしなかった"}, {"type": "subtitle", "time": 10035.67, "timestamp": "02:47:15", "text": "とんでもない金額だよ"}, {"type": "subtitle", "time": 10038.63, "timestamp": "02:47:18", "text": "私は4ヶ月間懇願しました"}, {"type": "subtitle", "time": 10041.269, "timestamp": "02:47:21", "text": "分割払いの最後の分さえ払えなかった"}, {"type": "subtitle", "time": 10046.63, "timestamp": "02:47:26", "text": "月、だって、えっと、その、その"}, {"type": "subtitle", "time": 10049.91, "timestamp": "02:47:29", "text": "フリーランスの仕事で、私は"}, {"type": "subtitle", "time": 10054.55, "timestamp": "02:47:34", "text": "私にはもう仕事が残っていなかった"}, {"type": "subtitle", "time": 10056.63, "timestamp": "02:47:36", "text": "私がやっていた例外的なこと"}, {"type": "subtitle", "time": 10059.19, "timestamp": "02:47:39", "text": "えーと、人々はあまり仕事がなく、"}, {"type": "subtitle", "time": 10062.309, "timestamp": "02:47:42", "text": "私は給料さえもらっていなかった"}, {"type": "subtitle", "time": 10066.23, "timestamp": "02:47:46", "text": "そして、あの騒動が起こったとき"}, {"type": "subtitle", "time": 10070.309, "timestamp": "02:47:50", "text": "それもカットされたみたいですね"}, {"type": "subtitle", "time": 10071.99, "timestamp": "02:47:51", "text": "完全に"}, {"type": "subtitle", "time": 10076.79, "timestamp": "02:47:56", "text": "でも、少なくとも私は"}, {"type": "subtitle", "time": 10079.83, "timestamp": "02:47:59", "text": "フルスタジオで嬉しいです"}]
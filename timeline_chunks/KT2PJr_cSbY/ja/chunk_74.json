[{"type": "subtitle", "time": 4440.39, "timestamp": "01:14:00", "text": "YouTube のストリームでは"}, {"type": "subtitle", "time": 4443.75, "timestamp": "01:14:03", "text": "こちらから自動的に更新されます。それで今日は"}, {"type": "subtitle", "time": 4446.39, "timestamp": "01:14:06", "text": "午後の小川のように"}, {"type": "subtitle", "time": 4448.39, "timestamp": "01:14:08", "text": "昨日見つけたものや、私が知らなかったもの"}, {"type": "subtitle", "time": 4450.39, "timestamp": "01:14:10", "text": "ストリームですが、私は裏で作業していました"}, {"type": "subtitle", "time": 4454.87, "timestamp": "01:14:14", "text": "以前作ったものをリメイクするためのシーン"}, {"type": "subtitle", "time": 4457.83, "timestamp": "01:14:17", "text": "ずっと昔のことですが、それはYouTube API関連のことです。"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "そして全て。だから今はすべてが"}, {"type": "subtitle", "time": 4462.229, "timestamp": "01:14:22", "text": "自動化されています。ストリームをスケジュールしました"}, {"type": "subtitle", "time": 4464.87, "timestamp": "01:14:24", "text": "YouTube。自動的に"}, {"type": "subtitle", "time": 4469.03, "timestamp": "01:14:29", "text": "Discordイベントを作成する。うん、作って"}, {"type": "subtitle", "time": 4472.07, "timestamp": "01:14:32", "text": "Discordイベントも自動的に、"}, {"type": "subtitle", "time": 4475.27, "timestamp": "01:14:35", "text": "埋め込みコンテンツが更新されます。今から行くよ"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "埋め込みが完了したら"}, {"type": "subtitle", "time": 4480.07, "timestamp": "01:14:40", "text": "埋め込みを動的に更新する"}, {"type": "subtitle", "time": 4482.55, "timestamp": "01:14:42", "text": "物事、私たちはこれに取り組むつもりです"}, {"type": "subtitle", "time": 4485.27, "timestamp": "01:14:45", "text": "ストリームの告知方法など、"}, {"type": "subtitle", "time": 4488.07, "timestamp": "01:14:48", "text": "右？手動で入力してpingします"}, {"type": "subtitle", "time": 4490.47, "timestamp": "01:14:50", "text": "ピンロールは右に転がるが、今は"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "私が"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "ライブ配信を希望すると自動的に"}]
[{"type": "subtitle", "time": 11707.99, "timestamp": "03:15:07", "text": "何てことだ。チピティは字が読めない。"}, {"type": "subtitle", "time": 11741.51, "timestamp": "03:15:41", "text": "これらは今後のレイアウトの一部です。何"}, {"type": "subtitle", "time": 11743.75, "timestamp": "03:15:43", "text": "つまりそういうことですか？"}, {"type": "subtitle", "time": 11746.71, "timestamp": "03:15:46", "text": "人々はそれを使っています。あなたが教えて。与える"}, {"type": "subtitle", "time": 11749.03, "timestamp": "03:15:49", "text": "私にとってそれはそれです。 [笑い]"}]
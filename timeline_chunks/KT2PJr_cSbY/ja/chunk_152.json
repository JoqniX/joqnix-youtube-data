[{"type": "subtitle", "time": 9147.75, "timestamp": "02:32:27", "text": "はぁ？"}, {"type": "subtitle", "time": 9150.95, "timestamp": "02:32:30", "text": "わかった、君の言うとおりだ。"}, {"type": "subtitle", "time": 9168.389, "timestamp": "02:32:48", "text": "そうそう。午後2時になる前に私は"}, {"type": "subtitle", "time": 9171.27, "timestamp": "02:32:51", "text": "毎日の仕事をして、夜は"}, {"type": "subtitle", "time": 9174.309, "timestamp": "02:32:54", "text": "今すぐビジネスを始めましょう。それを開けて"}, {"type": "subtitle", "time": 9176.23, "timestamp": "02:32:56", "text": "チェック。"}]
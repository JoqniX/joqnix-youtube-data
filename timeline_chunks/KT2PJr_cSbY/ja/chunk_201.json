[{"type": "subtitle", "time": 12061.99, "timestamp": "03:21:01", "text": "よし、見てみよう。"}, {"type": "subtitle", "time": 12065.75, "timestamp": "03:21:05", "text": "想像してみてよ、兄弟。何てことだ。"}, {"type": "subtitle", "time": 12067.75, "timestamp": "03:21:07", "text": "うまくいけば、"}, {"type": "subtitle", "time": 12071.75, "timestamp": "03:21:11", "text": "ストリーム視聴ボタンが表示されるようになりました。"}, {"type": "subtitle", "time": 12086.15, "timestamp": "03:21:26", "text": "何も起こらない。わかった。もっと詳しく知る。それ"}, {"type": "subtitle", "time": 12096.63, "timestamp": "03:21:36", "text": "何てことだ。ああ、なんてことだ。"}, {"type": "subtitle", "time": 12099.59, "timestamp": "03:21:39", "text": "何てことだ。ニース。"}, {"type": "subtitle", "time": 12104.07, "timestamp": "03:21:44", "text": "ああ、うまくいった。"}, {"type": "subtitle", "time": 12106.229, "timestamp": "03:21:46", "text": "何てことだ。わかった。わかった。次。次。次。"}, {"type": "subtitle", "time": 12110.309, "timestamp": "03:21:50", "text": "次。えっと、毛皮を剥ぎたいんです。何が"}, {"type": "subtitle", "time": 12112.95, "timestamp": "03:21:52", "text": "これ？毛皮のないメディア"}]
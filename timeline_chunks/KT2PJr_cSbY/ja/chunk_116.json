[{"type": "subtitle", "time": 6962.229, "timestamp": "01:56:02", "text": "ジョックニックをその一部とする ジョックニックス"}, {"type": "subtitle", "time": 6964.95, "timestamp": "01:56:04", "text": "自社の事業に注力するが"}, {"type": "subtitle", "time": 6967.27, "timestamp": "01:56:07", "text": "ONXは別のものだと思う"}, {"type": "subtitle", "time": 6970.47, "timestamp": "01:56:10", "text": "まるで自分の本を書いているかのように、"}, {"type": "subtitle", "time": 6973.83, "timestamp": "01:56:13", "text": "自分のアニメや自分の漫画で"}, {"type": "subtitle", "time": 6977.83, "timestamp": "01:56:17", "text": "私自身のストーリーか何か"}, {"type": "subtitle", "time": 6982.55, "timestamp": "01:56:22", "text": "あなたのペルソナに似ている"}, {"type": "subtitle", "time": 6984.31, "timestamp": "01:56:24", "text": "それが"}, {"type": "subtitle", "time": 6987.27, "timestamp": "01:56:27", "text": "ペルソナというよりは、私自身が作り出すもの"}, {"type": "subtitle", "time": 6989.27, "timestamp": "01:56:29", "text": "キャラクター"}, {"type": "subtitle", "time": 6991.669, "timestamp": "01:56:31", "text": "摩擦文字のようなものですよね"}, {"type": "subtitle", "time": 6994.229, "timestamp": "01:56:34", "text": "キャラクターたちと、彼らには独自の"}, {"type": "subtitle", "time": 6996.229, "timestamp": "01:56:36", "text": "ストーリーや、彼らがどのように交流するか"}, {"type": "subtitle", "time": 6999.27, "timestamp": "01:56:39", "text": "世界と私はジョックするかもしれない"}, {"type": "subtitle", "time": 7001.91, "timestamp": "01:56:41", "text": "ラスボスか、その中間か、"}, {"type": "subtitle", "time": 7004.55, "timestamp": "01:56:44", "text": "時々NPCが"}, {"type": "subtitle", "time": 7007.83, "timestamp": "01:56:47", "text": "彼らの世界では、フランチャイズ。わからない。"}, {"type": "subtitle", "time": 7010.629, "timestamp": "01:56:50", "text": "ええ、私はもっと大きな長い夢を見ていました"}, {"type": "subtitle", "time": 7012.47, "timestamp": "01:56:52", "text": "このために"}, {"type": "subtitle", "time": 7016.709, "timestamp": "01:56:56", "text": "ゲームを作ったり、それに関連するものを作ったりする。"}, {"type": "subtitle", "time": 7019.91, "timestamp": "01:56:59", "text": "でも、今は確かに大変だ。"}]
[{"type": "subtitle", "time": 300.79, "timestamp": "00:05:00", "text": "日本語の復習、日本語N4"}, {"type": "subtitle", "time": 303.03, "timestamp": "00:05:03", "text": "復習や漢字学習など"}, {"type": "subtitle", "time": 305.43, "timestamp": "00:05:05", "text": "すべてテスト用紙があるから"}, {"type": "subtitle", "time": 308.95, "timestamp": "00:05:08", "text": "夕方にテストします。 [音楽] だから私は"}, {"type": "subtitle", "time": 311.27, "timestamp": "00:05:11", "text": "時間と労力を費やしたい"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "実際に私が持っているものを学ぶ"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "これまでに学んだこと。わかった。そして安定した"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "そして、着実に、きちんと行う"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "明日は適切な安定した流れになります"}, {"type": "subtitle", "time": 325.11, "timestamp": "00:05:25", "text": "そして、気を抜いてはいけません。つまり"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "明日、私たちはそれを実行に移します。はい、おはようございます"}, {"type": "subtitle", "time": 329.59, "timestamp": "00:05:29", "text": "えっと、早起きして、"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "見直しとすべてを行う、それを行う"}, {"type": "subtitle", "time": 334.95, "timestamp": "00:05:34", "text": "たくさんの感謝と、それを書いてください"}, {"type": "subtitle", "time": 338.79, "timestamp": "00:05:38", "text": "私もラフな作業もしますし、"}, {"type": "subtitle", "time": 341.35, "timestamp": "00:05:41", "text": "クイズとか色々あるよ。そうですね、"}, {"type": "subtitle", "time": 346.07, "timestamp": "00:05:46", "text": "私は完全に正しい考えを持っている。"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "うん。だから、忘れないようにするんだよね？もし私がそうしたら"}, {"type": "subtitle", "time": 351.11, "timestamp": "00:05:51", "text": "配信中だよ、俺は安定してるよ。もし私がそうしなければ"}, {"type": "subtitle", "time": 353.67, "timestamp": "00:05:53", "text": "やってくれ、俺はサボってるみたいだ。それで"}, {"type": "subtitle", "time": 355.83, "timestamp": "00:05:55", "text": "うん、うまくいけばすべてがうまくいくといいな"}]
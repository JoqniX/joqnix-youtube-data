[{"type": "subtitle", "time": 9786.23, "timestamp": "02:43:06", "text": "おい、保存しておけよ。実行してください。"}, {"type": "subtitle", "time": 9788.15, "timestamp": "02:43:08", "text": "つまり、これが正式には"}, {"type": "subtitle", "time": 9790.87, "timestamp": "02:43:10", "text": "12歳だよね？公式には、私たちはそれを"}, {"type": "subtitle", "time": 9794.71, "timestamp": "02:43:14", "text": "2時間40分かかりました"}, {"type": "subtitle", "time": 9797.75, "timestamp": "02:43:17", "text": "終了まであと数分"}, {"type": "subtitle", "time": 9801.83, "timestamp": "02:43:21", "text": "このボタン。おそらくそうなると思う"}, {"type": "subtitle", "time": 9805.27, "timestamp": "02:43:25", "text": "仕事。リアルタイムで見てみましょう。それ"}, {"type": "subtitle", "time": 9807.51, "timestamp": "02:43:27", "text": "作品。 [笑い] 更新されました。それ"}, {"type": "subtitle", "time": 9811.03, "timestamp": "02:43:31", "text": "更新しました。わかった。わかった。新しい埋め込み"}, {"type": "subtitle", "time": 9814.55, "timestamp": "02:43:34", "text": "アップデーターパッチャーはこんな感じです。これ"}, {"type": "subtitle", "time": 9818.23, "timestamp": "02:43:38", "text": "資本金となる。えーと、これ、えーと"}, {"type": "subtitle", "time": 9820.469, "timestamp": "02:43:40", "text": "サムネイルが表示されます。ストリーム"}, {"type": "subtitle", "time": 9823.67, "timestamp": "02:43:43", "text": "スケジュールはこちらをご覧ください。ええと、私は変更します"}, {"type": "subtitle", "time": 9826.71, "timestamp": "02:43:46", "text": "これ。心配しないで。今のところは、"}, {"type": "subtitle", "time": 9828.63, "timestamp": "02:43:48", "text": "なれ。"}, {"type": "subtitle", "time": 9831.59, "timestamp": "02:43:51", "text": "もしくは、これを載せてもいいですよ。私"}, {"type": "subtitle", "time": 9838.309, "timestamp": "02:43:58", "text": "とにかく、えっと"}]
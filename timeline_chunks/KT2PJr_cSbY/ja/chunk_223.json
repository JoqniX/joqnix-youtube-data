[{"type": "subtitle", "time": 13381.429, "timestamp": "03:43:01", "text": "スクリーンショットとか何か、いや、私は作れる"}, {"type": "subtitle", "time": 13384.79, "timestamp": "03:43:04", "text": "ボットがスクリーンショットを送信するように"}, {"type": "subtitle", "time": 13386.95, "timestamp": "03:43:06", "text": "タイムスタンプとこのように"}, {"type": "subtitle", "time": 13389.91, "timestamp": "03:43:09", "text": "送信する人の名前と好き"}, {"type": "subtitle", "time": 13392.71, "timestamp": "03:43:12", "text": "不和。待って、Twitchチャットから"}, {"type": "subtitle", "time": 13396.229, "timestamp": "03:43:16", "text": "基本的に。うん。"}, {"type": "subtitle", "time": 13400.789, "timestamp": "03:43:20", "text": "何てことだ。想像してみて。何てことだ。"}, {"type": "subtitle", "time": 13407.359, "timestamp": "03:43:27", "text": "何てことだ。 ああ、コードブロックとか使えるよ。"}, {"type": "subtitle", "time": 13410.624, "timestamp": "03:43:30", "text": "ああ、コードブロックとか使えるよ。 [鼻を鳴らす]"}, {"type": "subtitle", "time": 13412.479, "timestamp": "03:43:32", "text": "[鼻を鳴らす] 非常識な。"}, {"type": "subtitle", "time": 13415.439, "timestamp": "03:43:35", "text": "非常識な。 わかった。わかった。えっと、容器。わかった。来る"}, {"type": "subtitle", "time": 13418.56, "timestamp": "03:43:38", "text": "わかった。わかった。えっと、容器。わかった。来る 戻る。地球に戻ってこいよ、ジョック。次。えっと"}, {"type": "subtitle", "time": 13432.229, "timestamp": "03:43:52", "text": "[笑い]"}, {"type": "subtitle", "time": 13439.75, "timestamp": "03:43:59", "text": "私はインスピレーションに満ち溢れている。私は"}]
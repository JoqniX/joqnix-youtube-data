[{"type": "subtitle", "time": 8520.79, "timestamp": "02:22:00", "text": "もし私が知っている人が"}, {"type": "subtitle", "time": 8529.75, "timestamp": "02:22:09", "text": "消防士はそれを使うのか？彼らは"}, {"type": "subtitle", "time": 8533.11, "timestamp": "02:22:13", "text": "これまで発表した"}, {"type": "subtitle", "time": 8537.19, "timestamp": "02:22:17", "text": "そうなのか？いいえ。その男は手動で"}, {"type": "subtitle", "time": 8543.349, "timestamp": "02:22:23", "text": "それ。わかった。私が会ったことのある人はいますか？"}, {"type": "subtitle", "time": 8547.99, "timestamp": "02:22:27", "text": "いや、違うよ。どのサーバーがそれを使用していますか？男、"}, {"type": "subtitle", "time": 8552.07, "timestamp": "02:22:32", "text": "埋め込み機能を使う人はいますか？みんな"}, {"type": "subtitle", "time": 8555.11, "timestamp": "02:22:35", "text": "手動で入力してください。おお、"}, {"type": "subtitle", "time": 8558.389, "timestamp": "02:22:38", "text": "良い例が必要だ。"}, {"type": "subtitle", "time": 8561.67, "timestamp": "02:22:41", "text": "ああ、市役所まで。おお、"}, {"type": "subtitle", "time": 8566.469, "timestamp": "02:22:46", "text": "誰がこのコヒーレンスを使うんだろう？来て。"}, {"type": "subtitle", "time": 8568.95, "timestamp": "02:22:48", "text": "疑問符。疑問符。いいえ、決して"}, {"type": "subtitle", "time": 8571.67, "timestamp": "02:22:51", "text": "心。"}]
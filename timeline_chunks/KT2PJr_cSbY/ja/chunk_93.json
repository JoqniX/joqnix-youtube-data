[{"type": "subtitle", "time": 5580.79, "timestamp": "01:33:00", "text": "この男をトップに据えることができる。実は"}, {"type": "subtitle", "time": 5583.75, "timestamp": "01:33:03", "text": "配列を作成するときは、"}, {"type": "subtitle", "time": 5587.51, "timestamp": "01:33:07", "text": "そうやってやるんだ。"}, {"type": "subtitle", "time": 5609.43, "timestamp": "01:33:29", "text": "それがうまくいかない場合は、"}, {"type": "subtitle", "time": 5612.47, "timestamp": "01:33:32", "text": "ここに置いてください。"}, {"type": "subtitle", "time": 5631.59, "timestamp": "01:33:51", "text": "よし。"}, {"type": "subtitle", "time": 5635.59, "timestamp": "01:33:55", "text": "私は体型に自信がない"}]
[{"type": "subtitle", "time": 14829.99, "timestamp": "04:07:09", "text": "おお。"}, {"type": "subtitle", "time": 14831.67, "timestamp": "04:07:11", "text": "「ランダムコール」と書かれたボードを想像してみてください。"}, {"type": "subtitle", "time": 14834.71, "timestamp": "04:07:14", "text": "恥から。あ、待って。良い。ああ、よかった"}, {"type": "subtitle", "time": 14837.99, "timestamp": "04:07:17", "text": "アイデア。ストリーマーの中にはそういうのを使っている人もいるのを見たことがある"}, {"type": "subtitle", "time": 14840.07, "timestamp": "04:07:20", "text": "ナイトボードとしてのランダムコード"}, {"type": "subtitle", "time": 14841.75, "timestamp": "04:07:21", "text": "指示。"}, {"type": "subtitle", "time": 14844.55, "timestamp": "04:07:24", "text": "モデレーターたちが付け加えたように。もし私たちが"}, {"type": "subtitle", "time": 14847.03, "timestamp": "04:07:27", "text": "そうするの？"}, {"type": "subtitle", "time": 14851.83, "timestamp": "04:07:31", "text": "ええ、それは十分に可能です。何てことだ。"}, {"type": "subtitle", "time": 14855.03, "timestamp": "04:07:35", "text": "良いアイデア。何てことだ。私たちはそれを"}, {"type": "subtitle", "time": 14859.269, "timestamp": "04:07:39", "text": "今後の作業の流れ。今日はここまで。私は"}, {"type": "subtitle", "time": 14868.63, "timestamp": "04:07:48", "text": "私は何をしていたんだろう？なぜ私はここにいるのだろう？"}, {"type": "subtitle", "time": 14871.83, "timestamp": "04:07:51", "text": "ああ、了解。行きます。私たちはコピーするためにここに来ました"}, {"type": "subtitle", "time": 14873.51, "timestamp": "04:07:53", "text": "これ。"}, {"type": "subtitle", "time": 14876.07, "timestamp": "04:07:56", "text": "ねえ、配信のお知らせを貼り付けて"}, {"type": "subtitle", "time": 14878.63, "timestamp": "04:07:58", "text": "こちらです。"}]
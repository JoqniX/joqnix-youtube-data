[{"type": "subtitle", "time": 14400.71, "timestamp": "04:00:00", "text": "他のものは似ていないように見える？ええ、必要"}, {"type": "subtitle", "time": 14402.87, "timestamp": "04:00:02", "text": "それについて調査する。 Dockerを実行する必要があります"}, {"type": "subtitle", "time": 14405.11, "timestamp": "04:00:05", "text": "あれのことですよね？"}, {"type": "subtitle", "time": 14407.349, "timestamp": "04:00:07", "text": "ああ、なんてことだ、とても"}, {"type": "subtitle", "time": 14414.95, "timestamp": "04:00:14", "text": "何てことだ。よし、こうなるだろう"}, {"type": "subtitle", "time": 14421.83, "timestamp": "04:00:21", "text": "待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 14424.63, "timestamp": "04:00:24", "text": "あ、待って。これと、ああ、なんてことだ。これは"}, {"type": "subtitle", "time": 14430.71, "timestamp": "04:00:30", "text": "ああ、"}, {"type": "subtitle", "time": 14433.429, "timestamp": "04:00:33", "text": "わかった。一般的なものよりずっと良い"}, {"type": "subtitle", "time": 14442.07, "timestamp": "04:00:42", "text": "わかった。だから、えーっと、ジョックは"}, {"type": "subtitle", "time": 14447.429, "timestamp": "04:00:47", "text": "生放送か何か。"}, {"type": "subtitle", "time": 14448.95, "timestamp": "04:00:48", "text": "どちらをご希望ですか？実行できますよ。"}, {"type": "subtitle", "time": 14452.309, "timestamp": "04:00:52", "text": "わかった。 RTX 20 30 80 をお持ちなら、私は持っていません"}, {"type": "subtitle", "time": 14456.71, "timestamp": "04:00:56", "text": "それを持っている。私は1660 Superを使っています。"}]
[{"type": "subtitle", "time": 612.31, "timestamp": "00:10:12", "text": "これ"}, {"type": "subtitle", "time": 614.15, "timestamp": "00:10:14", "text": "私がいくら稼いだと思う？私はしません"}, {"type": "subtitle", "time": 619.99, "timestamp": "00:10:19", "text": "マーク"}, {"type": "subtitle", "time": 622.949, "timestamp": "00:10:22", "text": "あなたがどれくらい得意なのかはわかりません"}, {"type": "subtitle", "time": 626.63, "timestamp": "00:10:26", "text": "学術的なので、どれだけ"}, {"type": "subtitle", "time": 630.23, "timestamp": "00:10:30", "text": "得点したかもしれないが、パスしてくれることを願っている"}, {"type": "subtitle", "time": 651.11, "timestamp": "00:10:51", "text": "私がどうやってこれだけのお金を手に入れたと思う？"}, {"type": "subtitle", "time": 655.829, "timestamp": "00:10:55", "text": "わからない。ただ推測しただけです。"}, {"type": "subtitle", "time": 658.47, "timestamp": "00:10:58", "text": "ただ推測しただけです。わからない。どれくらい良いか"}]
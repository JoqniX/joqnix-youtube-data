[{"type": "subtitle", "time": 13141.269, "timestamp": "03:39:01", "text": "そして皆さんにお伝えします。よし、まず私が"}, {"type": "subtitle", "time": 13143.91, "timestamp": "03:39:03", "text": "ライブ配信するんですよね？ええと、私たちは話します"}, {"type": "subtitle", "time": 13145.67, "timestamp": "03:39:05", "text": "先に条件付きについて話しました"}, {"type": "subtitle", "time": 13149.59, "timestamp": "03:39:09", "text": "論理的ですよね？では、それを自動化します"}, {"type": "subtitle", "time": 13153.51, "timestamp": "03:39:13", "text": "ストリームをスケジュールするだけで済む方法"}, {"type": "subtitle", "time": 13155.59, "timestamp": "03:39:15", "text": "YouTubeで。それでおしまい。触らないで"}, {"type": "subtitle", "time": 13157.429, "timestamp": "03:39:17", "text": "全くの不和。自動的に行われます"}, {"type": "subtitle", "time": 13160.71, "timestamp": "03:39:20", "text": "それは私にとって。それで、えーと、私が"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "それは条件付きのものだったと言った"}, {"type": "subtitle", "time": 13166.389, "timestamp": "03:39:26", "text": "現在時刻を"}, {"type": "subtitle", "time": 13168.79, "timestamp": "03:39:28", "text": "スケジュールに残っている時間"}, {"type": "subtitle", "time": 13171.269, "timestamp": "03:39:31", "text": "YouTube配信の開始時間ですよね？"}, {"type": "subtitle", "time": 13175.75, "timestamp": "03:39:35", "text": "だから、もしそれが、えっと、もし"}, {"type": "subtitle", "time": 13179.99, "timestamp": "03:39:39", "text": "えーと、1時間以上"}, {"type": "subtitle", "time": 13183.269, "timestamp": "03:39:43", "text": "スケジュールされたストリームの開始を待ってください"}, {"type": "subtitle", "time": 13186.469, "timestamp": "03:39:46", "text": "そうすれば1時間以上かかるでしょう"}, {"type": "subtitle", "time": 13188.71, "timestamp": "03:39:48", "text": "そうすれば待合室みたいな感じになるだろう"}, {"type": "subtitle", "time": 13192.07, "timestamp": "03:39:52", "text": "メッセージ。残り時間が10分しかない場合"}, {"type": "subtitle", "time": 13194.95, "timestamp": "03:39:54", "text": "ライブ配信のように送信します"}, {"type": "subtitle", "time": 13197.11, "timestamp": "03:39:57", "text": "今すぐ、もしくは10分後くらいに"}]
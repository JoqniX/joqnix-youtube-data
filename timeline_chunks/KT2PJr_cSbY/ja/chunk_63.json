[{"type": "subtitle", "time": 3798.95, "timestamp": "01:03:18", "text": "詳しいスケジュールは後日お知らせします。わかった。えっと"}, {"type": "subtitle", "time": 3801.91, "timestamp": "01:03:21", "text": "うん、これは共感できる。削除する必要があります"}, {"type": "subtitle", "time": 3819.109, "timestamp": "01:03:39", "text": "それは既に物体として存在している。いいえ。"}, {"type": "subtitle", "time": 3826.15, "timestamp": "01:03:46", "text": "これを置く必要はありません。必要なのは"}, {"type": "subtitle", "time": 3828.549, "timestamp": "01:03:48", "text": "置く"}, {"type": "subtitle", "time": 3832.549, "timestamp": "01:03:52", "text": "このような。そして、私たちはそれに名前をつける。ええと、私たちは"}, {"type": "subtitle", "time": 3834.71, "timestamp": "01:03:54", "text": "あれ"}, {"type": "subtitle", "time": 3837.029, "timestamp": "01:03:57", "text": "埋め込み"}]
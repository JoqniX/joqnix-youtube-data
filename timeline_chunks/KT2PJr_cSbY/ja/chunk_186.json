[{"type": "subtitle", "time": 11162.469, "timestamp": "03:06:02", "text": "だから、これを削除すれば。"}, {"type": "subtitle", "time": 11166.469, "timestamp": "03:06:06", "text": "ああ、サムネイルは一番上のものですね。 URL"}, {"type": "subtitle", "time": 11168.79, "timestamp": "03:06:08", "text": "底辺です。下の画像がそれです。"}, {"type": "subtitle", "time": 11171.83, "timestamp": "03:06:11", "text": "一番上の画像がサムネイルです。わかった。それで、"}, {"type": "subtitle", "time": 11175.11, "timestamp": "03:06:15", "text": "私たちは次のように配置します"}, {"type": "subtitle", "time": 11179.429, "timestamp": "03:06:19", "text": "えっと、この人、私のスケジュール配信"}, {"type": "subtitle", "time": 11181.03, "timestamp": "03:06:21", "text": "のように"}, {"type": "subtitle", "time": 11183.429, "timestamp": "03:06:23", "text": "無料チャットストリームのサムネイル。それは"}, {"type": "subtitle", "time": 11186.389, "timestamp": "03:06:26", "text": "トップに入る"}, {"type": "subtitle", "time": 11190.79, "timestamp": "03:06:30", "text": "こちらをクリックして保存ボタンを押します。"}, {"type": "subtitle", "time": 11193.83, "timestamp": "03:06:33", "text": "これで、アップデート時に更新されます"}, {"type": "subtitle", "time": 11196.309, "timestamp": "03:06:36", "text": "スケジュールはないと言って"}, {"type": "subtitle", "time": 11199.19, "timestamp": "03:06:39", "text": "もの。いいえ、何をすべきかという決まったルールはありません"}, {"type": "subtitle", "time": 11201.269, "timestamp": "03:06:41", "text": "それって何？ない、ない"}, {"type": "subtitle", "time": 11203.429, "timestamp": "03:06:43", "text": "配信スケジュールですが、近日配信予定です"}, {"type": "subtitle", "time": 11207.59, "timestamp": "03:06:47", "text": "ストリーム。つまり、基本的にはこんな感じです。こんにちは。いいえ"}, {"type": "subtitle", "time": 11209.51, "timestamp": "03:06:49", "text": "スケジュールストリーム、"}, {"type": "subtitle", "time": 11212.95, "timestamp": "03:06:52", "text": "でも、そういうものもあるし、これは"}, {"type": "subtitle", "time": 11216.15, "timestamp": "03:06:56", "text": "より整然としており、"}, {"type": "subtitle", "time": 11218.469, "timestamp": "03:06:58", "text": "今後配信される多くのストリームには"}]
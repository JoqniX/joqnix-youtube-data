[{"type": "subtitle", "time": 4742.07, "timestamp": "01:19:02", "text": "よし、もう一度やってみよう。保存してください。"}, {"type": "subtitle", "time": 4744.709, "timestamp": "01:19:04", "text": "箱とか中身が怖い。どれ？"}, {"type": "subtitle", "time": 4747.75, "timestamp": "01:19:07", "text": "これらの箱。ああ、そうだね。それはむしろ"}, {"type": "subtitle", "time": 4750.79, "timestamp": "01:19:10", "text": "構成要素。いいえ、私はプログラミングを知りません"}, {"type": "subtitle", "time": 4754.709, "timestamp": "01:19:14", "text": "多くの。少なくとも私は何とかして"}, {"type": "subtitle", "time": 4758.47, "timestamp": "01:19:18", "text": "私がここで何をしているのか理解してください。"}, {"type": "subtitle", "time": 4760.709, "timestamp": "01:19:20", "text": "私は、Discordのタイムスタンプの代わりにそれを使用することを知っています"}, {"type": "subtitle", "time": 4762.79, "timestamp": "01:19:22", "text": "タイムゾーン。"}, {"type": "subtitle", "time": 4764.63, "timestamp": "01:19:24", "text": "すると、あなたの現地時間が表示され、"}, {"type": "subtitle", "time": 4768.149, "timestamp": "01:19:28", "text": "もの。ああ、エポックをやっているよ。"}, {"type": "subtitle", "time": 4771.83, "timestamp": "01:19:31", "text": "私たちはエポックを実行しています。うん、ユニークだね"}, {"type": "subtitle", "time": 4775.189, "timestamp": "01:19:35", "text": "タイムスタンプ。いいえ、これは特別な時期です"}, {"type": "subtitle", "time": 4779.03, "timestamp": "01:19:39", "text": "切手は、こちらの物に貼るものです。"}, {"type": "subtitle", "time": 4782.07, "timestamp": "01:19:42", "text": "えっと、このcohookはどこで閉じたんだっけ？うん、"}, {"type": "subtitle", "time": 4785.51, "timestamp": "01:19:45", "text": "これは一番下の部分のためです。"}, {"type": "subtitle", "time": 4789.669, "timestamp": "01:19:49", "text": "えーと、今回はこっちじゃなくてこっち"}, {"type": "subtitle", "time": 4793.51, "timestamp": "01:19:53", "text": "固有のタイムスタンプが必要です。残りのもの"}, {"type": "subtitle", "time": 4796.709, "timestamp": "01:19:56", "text": "これはエポックです"}, {"type": "subtitle", "time": 4799.99, "timestamp": "01:19:59", "text": "はい、私はエポック法のみを使用しています"}]
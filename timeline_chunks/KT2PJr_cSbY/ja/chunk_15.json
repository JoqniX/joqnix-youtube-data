[{"type": "subtitle", "time": 900.15, "timestamp": "00:15:00", "text": "ここ。それは良いことだ。"}, {"type": "subtitle", "time": 905.35, "timestamp": "00:15:05", "text": "でも正直に言うと、私は"}, {"type": "subtitle", "time": 907.43, "timestamp": "00:15:07", "text": "何かをしたくない"}, {"type": "subtitle", "time": 908.389, "timestamp": "00:15:08", "text": "音楽みたい"}, {"type": "subtitle", "time": 910.31, "timestamp": "00:15:10", "text": "アプリ"}, {"type": "subtitle", "time": 913.91, "timestamp": "00:15:13", "text": "えーとボタンとコンポーネントを追加して"}, {"type": "subtitle", "time": 915.59, "timestamp": "00:15:15", "text": "このようなコンポーネント。私はしたくない"}, {"type": "subtitle", "time": 918.71, "timestamp": "00:15:18", "text": "クリックが多すぎる、"}, {"type": "subtitle", "time": 923.75, "timestamp": "00:15:23", "text": "右？それが可能かどうか知りたい"}, {"type": "subtitle", "time": 925.59, "timestamp": "00:15:25", "text": "好き、"}, {"type": "subtitle", "time": 930.629, "timestamp": "00:15:30", "text": "あの、クリスティーナは、クリスティーナは、"}, {"type": "subtitle", "time": 933.99, "timestamp": "00:15:33", "text": "Discordが拡張機能を制御しているんですよね？それ"}, {"type": "subtitle", "time": 936.949, "timestamp": "00:15:36", "text": "作品。それは良いことだ。私は自分の"}, {"type": "subtitle", "time": 939.11, "timestamp": "00:15:39", "text": "ボットとか、ボットアカウントとか。"}, {"type": "subtitle", "time": 942.71, "timestamp": "00:15:42", "text": "うん。でも、もし"}, {"type": "subtitle", "time": 944.79, "timestamp": "00:15:44", "text": "今のやり方なら、もし私ができるなら[音楽]できると思う"}, {"type": "subtitle", "time": 948.069, "timestamp": "00:15:48", "text": "自分のDiscordボードを使って自分の"}, {"type": "subtitle", "time": 950.949, "timestamp": "00:15:50", "text": "ウェブフックのことですよね？ [音楽] そして"}, {"type": "subtitle", "time": 953.509, "timestamp": "00:15:53", "text": "何らかの方法でボタンを取り付け、"}, {"type": "subtitle", "time": 956.55, "timestamp": "00:15:56", "text": "サミー本体の部品を使用しています。"}, {"type": "subtitle", "time": 959.35, "timestamp": "00:15:59", "text": "ああ、シェフになるんだ"}]
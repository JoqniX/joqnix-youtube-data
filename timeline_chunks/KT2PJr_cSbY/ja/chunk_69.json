[{"type": "subtitle", "time": 4142.229, "timestamp": "01:09:02", "text": "友達と一緒に"}, {"type": "subtitle", "time": 4144.709, "timestamp": "01:09:04", "text": "一緒に授業を楽しんで、"}, {"type": "subtitle", "time": 4147.669, "timestamp": "01:09:07", "text": "それら全て私は持っていません"}, {"type": "subtitle", "time": 4150.789, "timestamp": "01:09:10", "text": "しかし来年私は"}, {"type": "subtitle", "time": 4152.95, "timestamp": "01:09:12", "text": "日本に行くので、それを手に入れようと思っています。"}, {"type": "subtitle", "time": 4157.03, "timestamp": "01:09:17", "text": "私は学生になります。彼彼"}, {"type": "subtitle", "time": 4159.669, "timestamp": "01:09:19", "text": "私はそうします、つまり日本に着いたら"}, {"type": "subtitle", "time": 4162.309, "timestamp": "01:09:22", "text": "今はそこで大学に通わなければならない。だから"}, {"type": "subtitle", "time": 4166.229, "timestamp": "01:09:26", "text": "たとえ"}, {"type": "subtitle", "time": 4170.709, "timestamp": "01:09:30", "text": "ええ、たとえできたとしても、できないんです"}, {"type": "subtitle", "time": 4173.189, "timestamp": "01:09:33", "text": "今その瞬間を楽しんで、私は"}, {"type": "subtitle", "time": 4176.63, "timestamp": "01:09:36", "text": "将来はおそらく"}, {"type": "subtitle", "time": 4182.47, "timestamp": "01:09:42", "text": "ああ、了解。"}, {"type": "subtitle", "time": 4196.47, "timestamp": "01:09:56", "text": "えーと、私がやっていることは"}, {"type": "subtitle", "time": 4199.35, "timestamp": "01:09:59", "text": "英文学と英語"}]
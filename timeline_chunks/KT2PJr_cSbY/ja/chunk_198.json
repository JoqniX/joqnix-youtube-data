[{"type": "subtitle", "time": 11883.67, "timestamp": "03:18:03", "text": "使わないといけないと思った"}, {"type": "subtitle", "time": 11889.67, "timestamp": "03:18:09", "text": "おお。待って、待って。それがうまくいっているなら"}, {"type": "subtitle", "time": 11891.91, "timestamp": "03:18:11", "text": "メッセージフラグを送信する必要があります。とは"}, {"type": "subtitle", "time": 11907.67, "timestamp": "03:18:27", "text": "私もそうしたいです。"}, {"type": "subtitle", "time": 11909.269, "timestamp": "03:18:29", "text": "なぜ最初はうまくいかなかったのか？私"}, {"type": "subtitle", "time": 11919.59, "timestamp": "03:18:39", "text": "ああ、最初はうまくいかなかった"}, {"type": "subtitle", "time": 11922.229, "timestamp": "03:18:42", "text": "フォーマットが間違っていたためです。これは"}]
[{"type": "subtitle", "time": 9720.63, "timestamp": "02:42:00", "text": "エイブルトン。"}, {"type": "subtitle", "time": 9722.55, "timestamp": "02:42:02", "text": "私はフルスタジオとすべてのプラグインを持っています"}, {"type": "subtitle", "time": 9725.91, "timestamp": "02:42:05", "text": "版。全部買いました。"}, {"type": "subtitle", "time": 9729.51, "timestamp": "02:42:09", "text": "でも、ええ、Abletonは私が料金を払っているんです"}, {"type": "subtitle", "time": 9733.27, "timestamp": "02:42:13", "text": "毎月のリース購入"}, {"type": "subtitle", "time": 9737.91, "timestamp": "02:42:17", "text": "だって、私はこのコースを受講したから。"}, {"type": "subtitle", "time": 9741.429, "timestamp": "02:42:21", "text": "私は今このコースを受講しましたが、彼らは"}, {"type": "subtitle", "time": 9743.99, "timestamp": "02:42:23", "text": "Ableton Liveを教えていますが、"}, {"type": "subtitle", "time": 9746.79, "timestamp": "02:42:26", "text": "長期的に見れば、私にとっては良いことだ。だから私は"}, {"type": "subtitle", "time": 9749.75, "timestamp": "02:42:29", "text": "音楽を作っているなら、そうしようと思った"}, {"type": "subtitle", "time": 9752.23, "timestamp": "02:42:32", "text": "コンサートとか、今はこんなことをしたい"}, {"type": "subtitle", "time": 9755.11, "timestamp": "02:42:35", "text": "死んだネズミは、もしあなたがそのネズミを知っているなら"}, {"type": "subtitle", "time": 9758.71, "timestamp": "02:42:38", "text": "文字通りあなたと同じように"}, {"type": "subtitle", "time": 9760.63, "timestamp": "02:42:40", "text": "あの実験的なもの、ほら、"}, {"type": "subtitle", "time": 9764.15, "timestamp": "02:42:44", "text": "ライブで音楽を演奏するような感じで"}, {"type": "subtitle", "time": 9767.51, "timestamp": "02:42:47", "text": "OSC信号とかOCとか"}, {"type": "subtitle", "time": 9771.429, "timestamp": "02:42:51", "text": "もの。ええ、私はどうすればいいかよく分かっています"}, {"type": "subtitle", "time": 9775.349, "timestamp": "02:42:55", "text": "それなら実装できるだろう。"}]
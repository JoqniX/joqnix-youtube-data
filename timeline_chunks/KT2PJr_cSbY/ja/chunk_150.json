[{"type": "subtitle", "time": 9007.11, "timestamp": "02:30:07", "text": "文字通り、改行するにはエンターキーを押してください"}, {"type": "subtitle", "time": 9010.79, "timestamp": "02:30:10", "text": "Sammy の値ボックスに n と入力する代わりに、値ボックスを使用します。"}, {"type": "subtitle", "time": 9012.87, "timestamp": "02:30:12", "text": "はぁ"}, {"type": "subtitle", "time": 9016.23, "timestamp": "02:30:16", "text": "入力JSON埋め込み"}, {"type": "subtitle", "time": 9020.07, "timestamp": "02:30:20", "text": "ボディは文字列化しない"}, {"type": "subtitle", "time": 9021.59, "timestamp": "02:30:21", "text": "交換する。"}, {"type": "subtitle", "time": 9025.99, "timestamp": "02:30:25", "text": "わかった。構文入力を置換します。検索置換"}, {"type": "subtitle", "time": 9028.15, "timestamp": "02:30:28", "text": "そしてそれと共に。ああ、弦を作らなきゃ"}, {"type": "subtitle", "time": 9042.07, "timestamp": "02:30:42", "text": "正しい方法。よし、それを文字列化する"}, {"type": "subtitle", "time": 9045.67, "timestamp": "02:30:45", "text": "と述べている。それで"}, {"type": "subtitle", "time": 9049.75, "timestamp": "02:30:49", "text": "あなたは私に、ただ"}, {"type": "subtitle", "time": 9053.67, "timestamp": "02:30:53", "text": "この疑問符をしてください。"}]
[{"type": "subtitle", "time": 9420.71, "timestamp": "02:37:00", "text": "教えてあげるよ"}, {"type": "subtitle", "time": 9427.27, "timestamp": "02:37:07", "text": "埋め込みであれば問題ありません"}, {"type": "subtitle", "time": 9429.59, "timestamp": "02:37:09", "text": "絵文字を入れなければならない"}, {"type": "subtitle", "time": 9433.51, "timestamp": "02:37:13", "text": "この行に似ていますね、テキスト"}, {"type": "subtitle", "time": 9435.91, "timestamp": "02:37:15", "text": "白くなる、私はこれが欲しい、灰色"}, {"type": "subtitle", "time": 9443.67, "timestamp": "02:37:23", "text": "見てみたいけど、確認したい"}, {"type": "subtitle", "time": 9447.91, "timestamp": "02:37:27", "text": "私は、私は、私は、私は、Jに尋ねると思います"}, {"type": "subtitle", "time": 9451.749, "timestamp": "02:37:31", "text": "この後、さらにその後。私は知りたいです"}, {"type": "subtitle", "time": 9452.87, "timestamp": "02:37:32", "text": "[笑い]"}, {"type": "subtitle", "time": 9455.27, "timestamp": "02:37:35", "text": "これが可能かどうか知りたい"}, {"type": "subtitle", "time": 9459.11, "timestamp": "02:37:39", "text": "コーディングなしで"}, {"type": "subtitle", "time": 9465.11, "timestamp": "02:37:45", "text": "待って、"}, {"type": "subtitle", "time": 9468.389, "timestamp": "02:37:48", "text": "新しいものを作ります"}, {"type": "subtitle", "time": 9471.27, "timestamp": "02:37:51", "text": "わかった。サムネイルは"}, {"type": "subtitle", "time": 9476.95, "timestamp": "02:37:56", "text": "えっと、2番目みたいですね"}]
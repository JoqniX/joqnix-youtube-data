[{"type": "subtitle", "time": 8222.15, "timestamp": "02:17:02", "text": "いいね。それがすごく欲しい。"}, {"type": "subtitle", "time": 8225.509, "timestamp": "02:17:05", "text": "でも、どうやってコーディングすればいいのか分からないんです。"}, {"type": "subtitle", "time": 8228.15, "timestamp": "02:17:08", "text": "おお、"}, {"type": "subtitle", "time": 8231.27, "timestamp": "02:17:11", "text": "これは今見ると奇妙に見える。これは"}, {"type": "subtitle", "time": 8235.99, "timestamp": "02:17:15", "text": "ひどいですよね？どうすればいいのかわからない。"}, {"type": "subtitle", "time": 8249.509, "timestamp": "02:17:29", "text": "分割する。わかった。では、お見せしましょう。"}, {"type": "subtitle", "time": 8251.589, "timestamp": "02:17:31", "text": "待って。"}, {"type": "subtitle", "time": 8266.07, "timestamp": "02:17:46", "text": "わかった。だから、彼らは"}, {"type": "subtitle", "time": 8272.389, "timestamp": "02:17:52", "text": "えーと"}, {"type": "subtitle", "time": 8279.19, "timestamp": "02:17:59", "text": "彼らは"}]
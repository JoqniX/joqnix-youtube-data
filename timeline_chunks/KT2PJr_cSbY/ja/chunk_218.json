[{"type": "subtitle", "time": 13085.11, "timestamp": "03:38:05", "text": "何？わかった、いいよ。それなら私に"}, {"type": "subtitle", "time": 13088.07, "timestamp": "03:38:08", "text": "自分で取りに行きます。 [鼻を鳴らす]"}, {"type": "subtitle", "time": 13090.389, "timestamp": "03:38:10", "text": "えっと"}, {"type": "subtitle", "time": 13106.87, "timestamp": "03:38:26", "text": "これに含まれているはずですよね？"}, {"type": "subtitle", "time": 13109.75, "timestamp": "03:38:29", "text": "ビリー。ビリー。そう、この人だよ。"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "プレビューを見ることができると想像してみてください"}, {"type": "subtitle", "time": 13115.19, "timestamp": "03:38:35", "text": "何てことだ。想像する。"}, {"type": "subtitle", "time": 13120.87, "timestamp": "03:38:40", "text": "待って。"}, {"type": "subtitle", "time": 13124.15, "timestamp": "03:38:44", "text": "いや、いや、いや。私はそうするつもりだったんだ。"}, {"type": "subtitle", "time": 13125.59, "timestamp": "03:38:45", "text": "待って。実際には考えていなかった"}, {"type": "subtitle", "time": 13129.83, "timestamp": "03:38:49", "text": "それ。待って。実際は、いいえ。おい、"}, {"type": "subtitle", "time": 13132.229, "timestamp": "03:38:52", "text": "待って。私はとてもたくさん手に入れていると思います"}, {"type": "subtitle", "time": 13135.03, "timestamp": "03:38:55", "text": "今のアイデア。はっきり言わせてもらうと"}]
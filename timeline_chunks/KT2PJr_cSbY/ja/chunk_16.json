[{"type": "subtitle", "time": 961.11, "timestamp": "00:16:01", "text": "キス。"}, {"type": "subtitle", "time": 963.269, "timestamp": "00:16:03", "text": "すごくいいものになるよ。私はとても"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "なぜ誰もこれをやらないのか不思議に思う"}, {"type": "subtitle", "time": 968.069, "timestamp": "00:16:08", "text": "その代わり。委託する必要があると思います"}, {"type": "subtitle", "time": 969.67, "timestamp": "00:16:09", "text": "誰か。いいえ、私は"}, {"type": "subtitle", "time": 972.15, "timestamp": "00:16:12", "text": "クリスティーナの息子か何かに依頼する。"}, {"type": "subtitle", "time": 974.629, "timestamp": "00:16:14", "text": "しかし、試運転には費用がかかる。私は私は"}, {"type": "subtitle", "time": 977.59, "timestamp": "00:16:17", "text": "壊れた。"}, {"type": "subtitle", "time": 984.466, "timestamp": "00:16:24", "text": "そうだったらいいですね。"}, {"type": "subtitle", "time": 985.829, "timestamp": "00:16:25", "text": "[笑い]"}, {"type": "subtitle", "time": 993.91, "timestamp": "00:16:33", "text": "こんにちは。"}, {"type": "subtitle", "time": 996.55, "timestamp": "00:16:36", "text": "まあ、そうですね。えっと、私たちは何をうまくやっているのでしょうか？"}, {"type": "subtitle", "time": 998.629, "timestamp": "00:16:38", "text": "今？"}, {"type": "subtitle", "time": 1000.87, "timestamp": "00:16:40", "text": "ああ、これだ。私が出席していたとき"}, {"type": "subtitle", "time": 1004.069, "timestamp": "00:16:44", "text": "今日の授業でこれを見ていて"}, {"type": "subtitle", "time": 1007.189, "timestamp": "00:16:47", "text": "私はちょっとしたことをしていました"}, {"type": "subtitle", "time": 1009.91, "timestamp": "00:16:49", "text": "ここに追記"}, {"type": "subtitle", "time": 1012.389, "timestamp": "00:16:52", "text": "授業中に。"}, {"type": "subtitle", "time": 1014.629, "timestamp": "00:16:54", "text": "ああ、"}, {"type": "subtitle", "time": 1017.35, "timestamp": "00:16:57", "text": "わかった。"}]
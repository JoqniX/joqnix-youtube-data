[{"type": "subtitle", "time": 4620.39, "timestamp": "01:17:00", "text": "つまり、現地時間です。現状では、"}, {"type": "subtitle", "time": 4623.27, "timestamp": "01:17:03", "text": "10:27"}, {"type": "subtitle", "time": 4626.79, "timestamp": "01:17:06", "text": "午後私にとって。ええ、左上にあります"}, {"type": "subtitle", "time": 4630.87, "timestamp": "01:17:10", "text": "私の配信画面の左上。ああ、そうだ、私は"}, {"type": "subtitle", "time": 4633.03, "timestamp": "01:17:13", "text": "今すぐこれを直さなければならない。当社のサーバー"}, {"type": "subtitle", "time": 4636.47, "timestamp": "01:17:16", "text": "時間。そこにある。さあ、見てごらん。おお、"}, {"type": "subtitle", "time": 4640.07, "timestamp": "01:17:20", "text": "うん。壊れています。 [笑い]"}, {"type": "subtitle", "time": 4642.47, "timestamp": "01:17:22", "text": "インド人ではない。はい、それはインドの基準です"}, {"type": "subtitle", "time": 4645.669, "timestamp": "01:17:25", "text": "時間。インド標準時はグリニッジ標準時5時30分です。"}, {"type": "subtitle", "time": 4650.55, "timestamp": "01:17:30", "text": "えっと、5時プラス5時30分。うん。 5時間30分"}, {"type": "subtitle", "time": 4652.39, "timestamp": "01:17:32", "text": "先に。"}, {"type": "subtitle", "time": 4654.95, "timestamp": "01:17:34", "text": "うん。これは壊れています。インド時間、"}, {"type": "subtitle", "time": 4658.63, "timestamp": "01:17:38", "text": "日本時間、中国時間、太平洋時間、"}, {"type": "subtitle", "time": 4662.39, "timestamp": "01:17:42", "text": "昨日。ああ、この男を直さなければならない"}, {"type": "subtitle", "time": 4670.07, "timestamp": "01:17:50", "text": "でも、その理由を突き止めなきゃ。"}, {"type": "subtitle", "time": 4678.229, "timestamp": "01:17:58", "text": "批評家でさえも。"}]
[{"type": "subtitle", "time": 12550.63, "timestamp": "03:29:10", "text": "それを見つけたい。私は自分の"}, {"type": "subtitle", "time": 12557.51, "timestamp": "03:29:17", "text": "ビリー。ビリー、お茶を入れてくれ。私はしなければならない"}, {"type": "subtitle", "time": 12588.87, "timestamp": "03:29:48", "text": "ディスコでは昔こうやってたんだ"}, {"type": "subtitle", "time": 12590.389, "timestamp": "03:29:50", "text": "フック。"}, {"type": "subtitle", "time": 12593.91, "timestamp": "03:29:53", "text": "あ、待って。それは私のボールを使います。"}]
[{"type": "subtitle", "time": 22382.788, "timestamp": "06:13:02", "text": "それは動作します。ニース。ニース。ニース。確認させてください"}, {"type": "subtitle", "time": 22386.23, "timestamp": "06:13:06", "text": "ちなみに、それはスマホでやってるよ。見た目はどうですか"}, {"type": "subtitle", "time": 22413.19, "timestamp": "06:13:33", "text": "仕切り板は良いですね。いいえ、セパレータは"}, {"type": "subtitle", "time": 22415.004, "timestamp": "06:13:35", "text": "ニース。右。"}]
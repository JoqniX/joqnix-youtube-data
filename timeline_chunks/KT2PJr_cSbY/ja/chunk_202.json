[{"type": "subtitle", "time": 12121.83, "timestamp": "03:22:01", "text": "メッセージでのみ利用可能です。"}, {"type": "subtitle", "time": 12124.79, "timestamp": "03:22:04", "text": "埋め込みではありません。"}, {"type": "subtitle", "time": 12127.03, "timestamp": "03:22:07", "text": "コンテナ化したい。私はしたい"}, {"type": "subtitle", "time": 12131.59, "timestamp": "03:22:11", "text": "皿。皿洗いをしたい。"}, {"type": "subtitle", "time": 12135.429, "timestamp": "03:22:15", "text": "えっと、コンテナテキストメディアギャラリー。おお、"}, {"type": "subtitle", "time": 12138.63, "timestamp": "03:22:18", "text": "それはメディアです。わかった。テキスト表示アクション"}, {"type": "subtitle", "time": 12141.51, "timestamp": "03:22:21", "text": "行。"}, {"type": "subtitle", "time": 12143.349, "timestamp": "03:22:23", "text": "プラットフォームごとに作成できますか？それぞれ"}, {"type": "subtitle", "time": 12144.95, "timestamp": "03:22:24", "text": "プラットフォームの色を持つもの"}, {"type": "subtitle", "time": 12149.75, "timestamp": "03:22:29", "text": "良い。いや、いや、待って。それはできません"}, {"type": "subtitle", "time": 12157.83, "timestamp": "03:22:37", "text": "ボタンには独自のインタラクションが必要だから"}, {"type": "subtitle", "time": 12160.63, "timestamp": "03:22:40", "text": "関連情報をリンクする。"}, {"type": "subtitle", "time": 12165.51, "timestamp": "03:22:45", "text": "しかし、もし私がリンクURLを作成するとしたら、"}]
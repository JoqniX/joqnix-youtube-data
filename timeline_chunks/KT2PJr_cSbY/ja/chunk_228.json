[{"type": "subtitle", "time": 13680.229, "timestamp": "03:48:00", "text": "時々"}, {"type": "subtitle", "time": 13682.442, "timestamp": "03:48:02", "text": "[笑い]"}, {"type": "subtitle", "time": 13683.11, "timestamp": "03:48:03", "text": "[息を呑む]"}, {"type": "subtitle", "time": 13687.51, "timestamp": "03:48:07", "text": "えっと、ただ覚えるのが苦手なんです。"}, {"type": "subtitle", "time": 13690.87, "timestamp": "03:48:10", "text": "私は自分の音楽的な側面を何とかしなければならない。"}, {"type": "subtitle", "time": 13692.55, "timestamp": "03:48:12", "text": "見せる。"}, {"type": "subtitle", "time": 13697.03, "timestamp": "03:48:17", "text": "わかった。こんにちは。やりましょう。だから私は"}, {"type": "subtitle", "time": 13699.83, "timestamp": "03:48:19", "text": "配信のお知らせ"}, {"type": "subtitle", "time": 13701.67, "timestamp": "03:48:21", "text": "アナウンサー"}, {"type": "subtitle", "time": 13711.11, "timestamp": "03:48:31", "text": "待って。"}, {"type": "subtitle", "time": 13713.91, "timestamp": "03:48:33", "text": "うん。筆記のストロークとか、そういうもの。脳卒中"}, {"type": "subtitle", "time": 13716.07, "timestamp": "03:48:36", "text": "あるいは、その他諸々。私"}, {"type": "subtitle", "time": 13718.309, "timestamp": "03:48:38", "text": "ええ、いくつか覚えていますよ。私"}, {"type": "subtitle", "time": 13719.91, "timestamp": "03:48:39", "text": "練習を続けなければならない。うん、"}, {"type": "subtitle", "time": 13727.349, "timestamp": "03:48:47", "text": "私はやっていないし、いつも忘れてしまう。おお"}, {"type": "subtitle", "time": 13731.11, "timestamp": "03:48:51", "text": "ああ、今夜寝る前にやるよ。"}, {"type": "subtitle", "time": 13735.75, "timestamp": "03:48:55", "text": "彼は今、私にAnkiの教材を送ってくれた。"}, {"type": "subtitle", "time": 13738.63, "timestamp": "03:48:58", "text": "待って、音声入力で入力できますか？"}]
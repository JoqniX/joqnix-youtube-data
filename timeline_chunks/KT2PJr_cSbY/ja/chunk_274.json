[{"type": "subtitle", "time": 16443.75, "timestamp": "04:34:03", "text": "チャイとマサリ、どちらが良いと思いますか？"}, {"type": "subtitle", "time": 16447.91, "timestamp": "04:34:07", "text": "マサラの木はいいですね。もっと"}, {"type": "subtitle", "time": 16455.67, "timestamp": "04:34:15", "text": "健康にも良いとか、そういうこと。"}, {"type": "subtitle", "time": 16457.59, "timestamp": "04:34:17", "text": "うん。"}, {"type": "subtitle", "time": 16460.949, "timestamp": "04:34:20", "text": "Chはただのミルクと紅茶です。それでおしまい。"}, {"type": "subtitle", "time": 16463.269, "timestamp": "04:34:23", "text": "時々、カルダモンを入れる人もいます"}, {"type": "subtitle", "time": 16465.189, "timestamp": "04:34:25", "text": "またはスパイス。いいえ、それは"}, {"type": "subtitle", "time": 16467.349, "timestamp": "04:34:27", "text": "マサラの木ですよね？マサラの木は"}]
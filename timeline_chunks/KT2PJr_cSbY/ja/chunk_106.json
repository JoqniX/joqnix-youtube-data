[{"type": "subtitle", "time": 6362.31, "timestamp": "01:46:02", "text": "彼女のインスタグラム見た？"}, {"type": "subtitle", "time": 6365.43, "timestamp": "01:46:05", "text": "ああ、他の人のえーと"}, {"type": "subtitle", "time": 6368.39, "timestamp": "01:46:08", "text": "まだインスタグラムのストーリーには出ていない。"}, {"type": "subtitle", "time": 6371.51, "timestamp": "01:46:11", "text": "だから誰かが私のストーリーを見たら、"}, {"type": "subtitle", "time": 6375.669, "timestamp": "01:46:15", "text": "彼らのストーリーもチェックしたがる傾向がある。"}, {"type": "subtitle", "time": 6379.27, "timestamp": "01:46:19", "text": "私はただそう見えるだけです"}, {"type": "subtitle", "time": 6381.75, "timestamp": "01:46:21", "text": "ヒンディー語。"}, {"type": "subtitle", "time": 6384.31, "timestamp": "01:46:24", "text": "私のミスです。大丈夫。心配ない。私はできる"}, {"type": "subtitle", "time": 6388.39, "timestamp": "01:46:28", "text": "読む。理解できます。私は私は"}, {"type": "subtitle", "time": 6391.83, "timestamp": "01:46:31", "text": "ヒンディー語が苦手です。まあ、そうですね。録音はどうですか？"}, {"type": "subtitle", "time": 6393.669, "timestamp": "01:46:33", "text": "今行くの？モカでコーヒーを作っていた"}, {"type": "subtitle", "time": 6396.55, "timestamp": "01:46:36", "text": "ポット。あ、モカをお持ちなんですね。"}, {"type": "subtitle", "time": 6398.55, "timestamp": "01:46:38", "text": "おお。"}, {"type": "subtitle", "time": 6406.39, "timestamp": "01:46:46", "text": "それはすばらしい。コーヒーをお楽しみください。"}, {"type": "subtitle", "time": 6409.35, "timestamp": "01:46:49", "text": "でも、ええ、これまでのところ、私たちは"}, {"type": "subtitle", "time": 6411.59, "timestamp": "01:46:51", "text": "文字列の代わりに、"}, {"type": "subtitle", "time": 6414.47, "timestamp": "01:46:54", "text": "物体。今のところ順調です。ええと、まだいくつか"}, {"type": "subtitle", "time": 6416.709, "timestamp": "01:46:56", "text": "あちこちでエラーが発生する。直します"}]
[{"type": "subtitle", "time": 181.75, "timestamp": "00:03:01", "text": "えーと、それから"}, {"type": "subtitle", "time": 191.91, "timestamp": "00:03:11", "text": "再び生きる。 1秒。ちょっと待ってください"}, {"type": "subtitle", "time": 197.82999999999998, "timestamp": "00:03:17", "text": "Twitterでツイートする。わかった。再び生きる。"}, {"type": "subtitle", "time": 204.22899999999998, "timestamp": "00:03:24", "text": "サム"}, {"type": "subtitle", "time": 205.99, "timestamp": "00:03:25", "text": "もっと。"}, {"type": "subtitle", "time": 210.149, "timestamp": "00:03:30", "text": "私たちはより多くの仕事をしています"}, {"type": "subtitle", "time": 214.869, "timestamp": "00:03:34", "text": "えーと仕事仕事のこと"}, {"type": "subtitle", "time": 221.35, "timestamp": "00:03:41", "text": "うまく機能する。"}, {"type": "subtitle", "time": 227.277, "timestamp": "00:03:47", "text": "こんにちは。砂糖ではない。"}, {"type": "subtitle", "time": 229.67000000000002, "timestamp": "00:03:49", "text": "[笑い] こんにちは、私は発表すらしていません"}]
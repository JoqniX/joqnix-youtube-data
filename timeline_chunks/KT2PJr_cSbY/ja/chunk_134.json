[{"type": "subtitle", "time": 8049.03, "timestamp": "02:14:09", "text": "ああ、間違ったものを見ていた。えっと、"}, {"type": "subtitle", "time": 8074.39, "timestamp": "02:14:34", "text": "H もう改行する必要はありません"}, {"type": "subtitle", "time": 8076.149, "timestamp": "02:14:36", "text": "どうやら。"}, {"type": "subtitle", "time": 8083.99, "timestamp": "02:14:43", "text": "ああ、新しい行を入れる必要はありません"}, {"type": "subtitle", "time": 8085.91, "timestamp": "02:14:45", "text": "もう。これは変わる可能性があると思う"}, {"type": "subtitle", "time": 8088.709, "timestamp": "02:14:48", "text": "何か。以前は機能しませんでした"}, {"type": "subtitle", "time": 8091.51, "timestamp": "02:14:51", "text": "以前はそうだったが、今は変わった。わかった。おお、"}, {"type": "subtitle", "time": 8094.87, "timestamp": "02:14:54", "text": "待って。高い方向に向かって進むことができます。"}, {"type": "subtitle", "time": 8097.03, "timestamp": "02:14:57", "text": "さあ、今すぐやろう。やり方 どうすればいいですか"}, {"type": "subtitle", "time": 8099.91, "timestamp": "02:14:59", "text": "それ？"}]
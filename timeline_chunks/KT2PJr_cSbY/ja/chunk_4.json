[{"type": "subtitle", "time": 241.19, "timestamp": "00:04:01", "text": "でも大丈夫。 [音楽] 手に入れるかもしれない"}, {"type": "subtitle", "time": 251.429, "timestamp": "00:04:11", "text": "明日から、そしてそれは"}, {"type": "subtitle", "time": 260.71, "timestamp": "00:04:20", "text": "すべてが超自動化されるよ、兄弟。"}, {"type": "subtitle", "time": 265.43, "timestamp": "00:04:25", "text": "おお。待ちきれない。待ちきれない。"}, {"type": "subtitle", "time": 268.31, "timestamp": "00:04:28", "text": "明日。でも、今夜は"}, {"type": "subtitle", "time": 271.909, "timestamp": "00:04:31", "text": "物事を終わらせる。こんにちは。"}, {"type": "subtitle", "time": 276.79, "timestamp": "00:04:36", "text": "また明日、私は、"}, {"type": "subtitle", "time": 279.59000000000003, "timestamp": "00:04:39", "text": "明日の配信は青色に予定されています"}, {"type": "subtitle", "time": 283.03, "timestamp": "00:04:43", "text": "プロトコルスター共鳴番号4と"}, {"type": "subtitle", "time": 287.67, "timestamp": "00:04:47", "text": "私たちは夜にチャットしていますが、私は"}, {"type": "subtitle", "time": 291.189, "timestamp": "00:04:51", "text": "それについては別の計画がある。わかった、"}, {"type": "subtitle", "time": 293.59000000000003, "timestamp": "00:04:53", "text": "私はテストするのが好きで、咳払いをしてから、"}, {"type": "subtitle", "time": 297.43, "timestamp": "00:04:57", "text": "明日私たちは"}]
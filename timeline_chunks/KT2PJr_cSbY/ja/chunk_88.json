[{"type": "subtitle", "time": 5291.99, "timestamp": "01:28:11", "text": "書式が間違っていると思います。それは"}, {"type": "subtitle", "time": 5312.95, "timestamp": "01:28:32", "text": "わかった。それは間違っていると思う。うん。我々は持っています"}, {"type": "subtitle", "time": 5315.99, "timestamp": "01:28:35", "text": "別のことをする。うん。これはまずい。"}, {"type": "subtitle", "time": 5319.75, "timestamp": "01:28:39", "text": "これは間違いです。全くの間違いです。このルック"}, {"type": "subtitle", "time": 5322.149, "timestamp": "01:28:42", "text": "物体のような感覚がない。これは"}, {"type": "subtitle", "time": 5325.35, "timestamp": "01:28:45", "text": "何か別のもののように。"}, {"type": "subtitle", "time": 5328.39, "timestamp": "01:28:48", "text": "さあ、ジャチ・プンに耳を傾けて"}, {"type": "subtitle", "time": 5331.99, "timestamp": "01:28:51", "text": "あなたがすべきことは何でも。"}]
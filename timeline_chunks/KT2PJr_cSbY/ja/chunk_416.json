[{"type": "subtitle", "time": 24966.468, "timestamp": "06:56:06", "text": "待って、私が入れなければならないと書いてありますか"}, {"type": "subtitle", "time": 24975.51, "timestamp": "06:56:15", "text": "ハードコードされたコンポーネント"}, {"type": "subtitle", "time": 24978.708, "timestamp": "06:56:18", "text": "文章？弊社は、他のコンポーネントを追加する場合があります。"}, {"type": "subtitle", "time": 24980.468, "timestamp": "06:56:20", "text": "未来。同様に、アクセサリーは"}, {"type": "subtitle", "time": 24983.91, "timestamp": "06:56:23", "text": "他のコンポーネントも含むように拡張"}, {"type": "subtitle", "time": 24986.788, "timestamp": "06:56:26", "text": "未来。"}, {"type": "subtitle", "time": 24989.27, "timestamp": "06:56:29", "text": "つまり、ハードコーディングしないようにと言われているということだ。"}]
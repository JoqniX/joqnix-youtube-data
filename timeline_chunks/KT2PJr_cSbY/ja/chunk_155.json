[{"type": "subtitle", "time": 9327.03, "timestamp": "02:35:27", "text": "彼らが現れたとき、私は怖くなった"}, {"type": "subtitle", "time": 9328.63, "timestamp": "02:35:28", "text": "上。"}, {"type": "subtitle", "time": 9331.883, "timestamp": "02:35:31", "text": "はい、アップデートされました。わーい。"}, {"type": "subtitle", "time": 9332.63, "timestamp": "02:35:32", "text": "[笑い]"}, {"type": "subtitle", "time": 9336.15, "timestamp": "02:35:36", "text": "マークを見て。何てことだ。やったよ。私はそうしました"}, {"type": "subtitle", "time": 9340.95, "timestamp": "02:35:40", "text": "それ。やったよ。わーい。"}, {"type": "subtitle", "time": 9343.6, "timestamp": "02:35:43", "text": "わーい。 ああ、あそこに、この終わりの部分がある"}, {"type": "subtitle", "time": 9346.08, "timestamp": "02:35:46", "text": "ああ、あそこに、この終わりの部分がある こちらでも同様です。おお、"}, {"type": "subtitle", "time": 9349.2, "timestamp": "02:35:49", "text": "こちらでも同様です。おお、 それを直さなければならない。私はよく忘れてしまう。私"}, {"type": "subtitle", "time": 9352.64, "timestamp": "02:35:52", "text": "それを直さなければならない。私はよく忘れてしまう。私 入れる必要はありません"}, {"type": "subtitle", "time": 9355.04, "timestamp": "02:35:55", "text": "入れる必要はありません えーと、フォワードスラッシュ"}]
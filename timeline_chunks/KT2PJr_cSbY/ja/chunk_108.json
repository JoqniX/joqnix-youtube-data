[{"type": "subtitle", "time": 6480.149, "timestamp": "01:48:00", "text": "さまざまな種類のウェブサイト"}, {"type": "subtitle", "time": 6482.55, "timestamp": "01:48:02", "text": "コーヒーや抹茶など、あらゆるもの。"}, {"type": "subtitle", "time": 6485.109, "timestamp": "01:48:05", "text": "ずいぶん昔のことですよね？私"}, {"type": "subtitle", "time": 6487.59, "timestamp": "01:48:07", "text": "覚えておいてください（笑）。 [息を呑む]"}, {"type": "subtitle", "time": 6489.43, "timestamp": "01:48:09", "text": "おお。"}, {"type": "subtitle", "time": 6492.95, "timestamp": "01:48:12", "text": "最近は紅茶か緑茶を飲んでいます。"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "それは緑茶です。うん。"}, {"type": "subtitle", "time": 6499.189, "timestamp": "01:48:19", "text": "俺はコーヒーが大好きだよ。コーヒーはとても"}, {"type": "subtitle", "time": 6524.39, "timestamp": "01:48:44", "text": "こんにちは、お元気で。ありがとうございます"}, {"type": "subtitle", "time": 6526.79, "timestamp": "01:48:46", "text": "ちょっと立ち寄ってみます。それは本当に大きな意味があります。希望"}, {"type": "subtitle", "time": 6530.47, "timestamp": "01:48:50", "text": "良い夜をお過ごしください"}, {"type": "subtitle", "time": 6531.669, "timestamp": "01:48:51", "text": "先に。"}]
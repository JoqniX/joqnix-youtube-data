[{"type": "subtitle", "time": 20288.31, "timestamp": "05:38:08", "text": "わかった。日光。 [音楽]"}, {"type": "subtitle", "time": 20308.07, "timestamp": "05:38:28", "text": "両方の値をブロックすることもできます"}, {"type": "subtitle", "time": 20311.11, "timestamp": "05:38:31", "text": "手動で。そう、管理は"}, {"type": "subtitle", "time": 20312.868, "timestamp": "05:38:32", "text": "マッピングオブジェクト内で見つかりました。だから私は"}, {"type": "subtitle", "time": 20314.948, "timestamp": "05:38:34", "text": "それを制御してください"}, {"type": "subtitle", "time": 20327.99, "timestamp": "05:38:47", "text": "それはパッチ本体です。これはボルチです"}]
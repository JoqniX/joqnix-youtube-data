[{"type": "subtitle", "time": 7141.669, "timestamp": "01:59:01", "text": "Twitchで遊びに来てください。じゃあな、兄弟。こんにちは。取る"}, {"type": "subtitle", "time": 7155.589, "timestamp": "01:59:15", "text": "全力を尽くさなければならない。もう寝なきゃ。"}, {"type": "subtitle", "time": 7157.589, "timestamp": "01:59:17", "text": "明日は私の試験です。こんにちは。おやすみ。"}, {"type": "subtitle", "time": 7160.95, "timestamp": "01:59:20", "text": "おやすみ。早起きして復習しよう。"}, {"type": "subtitle", "time": 7163.669, "timestamp": "01:59:23", "text": "わかった。明日も頑張ってください！"}, {"type": "subtitle", "time": 7166.709, "timestamp": "01:59:26", "text": "テスト。気をつけて。それからあなた"}, {"type": "subtitle", "time": 7169.75, "timestamp": "01:59:29", "text": "気をつけて。"}, {"type": "subtitle", "time": 7181.51, "timestamp": "01:59:41", "text": "対象物"}, {"type": "subtitle", "time": 7193.99, "timestamp": "01:59:53", "text": "夢を見に来るすべての人を、今も歓迎します。こんにちは、"}, {"type": "subtitle", "time": 7196.79, "timestamp": "01:59:56", "text": "よく眠る"}]
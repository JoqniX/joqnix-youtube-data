[{"type": "subtitle", "time": 14643.03, "timestamp": "04:04:03", "text": "私はそうしたいのですが、あなたはそれを作りたいですか？"}, {"type": "subtitle", "time": 14645.269, "timestamp": "04:04:05", "text": "このフラグは削除できます。わかった。私はします"}, {"type": "subtitle", "time": 14647.429, "timestamp": "04:04:07", "text": "好きになりたい"}, {"type": "subtitle", "time": 14651.11, "timestamp": "04:04:11", "text": "それは何と呼ばれますか？"}, {"type": "subtitle", "time": 14653.91, "timestamp": "04:04:13", "text": "私はそうしたい"}, {"type": "subtitle", "time": 14657.349, "timestamp": "04:04:17", "text": "私はDiscordでアクティビティをしたいと思っています"}, {"type": "subtitle", "time": 14659.429, "timestamp": "04:04:19", "text": "いつか学ばなければならないこと"}, {"type": "subtitle", "time": 14662.15, "timestamp": "04:04:22", "text": "コーディングの話だけどね。"}, {"type": "subtitle", "time": 14665.11, "timestamp": "04:04:25", "text": "穏やかな星界の転換。わかった。太字のコンポーネント、"}, {"type": "subtitle", "time": 14677.83, "timestamp": "04:04:37", "text": "わかった。実装に関するもの。"}, {"type": "subtitle", "time": 14680.55, "timestamp": "04:04:40", "text": "時差を計算してください。 JSONを作成する"}, {"type": "subtitle", "time": 14683.67, "timestamp": "04:04:43", "text": "ベースコンテナのようなもの。スマートストリームと"}, {"type": "subtitle", "time": 14686.15, "timestamp": "04:04:46", "text": "答え。わかった。あなたは"}, {"type": "subtitle", "time": 14697.67, "timestamp": "04:04:57", "text": "えーと、発表日。わかった、"}, {"type": "subtitle", "time": 14699.99, "timestamp": "04:04:59", "text": "まずはこのコメントから始めましょう。ああ、違う"}]
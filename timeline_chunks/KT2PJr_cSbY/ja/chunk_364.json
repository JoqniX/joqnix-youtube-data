[{"type": "subtitle", "time": 21846.07, "timestamp": "06:04:06", "text": "コンテンツ？欲しい"}, {"type": "subtitle", "time": 21850.15, "timestamp": "06:04:10", "text": "音楽と歌だけを行う"}, {"type": "subtitle", "time": 21869.91, "timestamp": "06:04:29", "text": "[音楽]を表示できます"}, {"type": "subtitle", "time": 21873.27, "timestamp": "06:04:33", "text": "しかし、相手に通知したり、ピンを立てたりはしません。"}, {"type": "subtitle", "time": 21874.948, "timestamp": "06:04:34", "text": "M"}, {"type": "subtitle", "time": 21894.23, "timestamp": "06:04:54", "text": "ああ、わかった。大丈夫。そして私は"}]
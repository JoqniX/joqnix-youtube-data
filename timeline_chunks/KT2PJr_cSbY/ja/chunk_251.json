[{"type": "subtitle", "time": 15060.309, "timestamp": "04:11:00", "text": "Unix系のシステムでも動作しますか？ああ、私は"}, {"type": "subtitle", "time": 15062.309, "timestamp": "04:11:02", "text": "エポックが必要です。"}, {"type": "subtitle", "time": 15064.63, "timestamp": "04:11:04", "text": "わかった。こんにちは。おやすみ。おやすみ。寝る"}, {"type": "subtitle", "time": 15091.429, "timestamp": "04:11:31", "text": "何とチャットするの？犬の世話をする人との会話"}, {"type": "subtitle", "time": 15093.99, "timestamp": "04:11:33", "text": "そこには。うん、コードメーカーのやつは"}, {"type": "subtitle", "time": 15095.51, "timestamp": "04:11:35", "text": "良い。"}, {"type": "subtitle", "time": 15098.63, "timestamp": "04:11:38", "text": "私は"}]
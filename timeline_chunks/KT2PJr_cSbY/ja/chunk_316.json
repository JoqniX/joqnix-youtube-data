[{"type": "subtitle", "time": 18980.23, "timestamp": "05:16:20", "text": "兄弟。さあ、仕事に取り掛かろう。ぶん殴ってやる"}, {"type": "subtitle", "time": 18984.15, "timestamp": "05:16:24", "text": "とても高い。ああ、なんてことだ。"}, {"type": "subtitle", "time": 18987.35, "timestamp": "05:16:27", "text": "一体何なんだ"}, {"type": "subtitle", "time": 18992.948, "timestamp": "05:16:32", "text": "うわあ、すごく時間を無駄にしてしまった。わかった、"}]
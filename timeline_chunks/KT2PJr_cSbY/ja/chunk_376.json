[{"type": "subtitle", "time": 22561.19, "timestamp": "06:16:01", "text": "えっと、何持ってるの？よし、それでは"}, {"type": "subtitle", "time": 22563.91, "timestamp": "06:16:03", "text": "それは動的です。つまり、テキサスは活気に満ちているということだ。"}, {"type": "subtitle", "time": 22574.15, "timestamp": "06:16:14", "text": "動的用途向けの推奨ベースペイロード"}, {"type": "subtitle", "time": 22577.67, "timestamp": "06:16:17", "text": "バージョン。そこを拠点にしてもいいですよ。わかりました。"}, {"type": "subtitle", "time": 22586.788, "timestamp": "06:16:26", "text": "アクセントカラーにはしたくない"}]
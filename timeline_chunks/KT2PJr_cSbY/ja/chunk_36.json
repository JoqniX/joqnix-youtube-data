[{"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "えっと、配列挿入であって、挿入ではありません。"}, {"type": "subtitle", "time": 2173.51, "timestamp": "00:36:13", "text": "終わりはないよね？私はそうは思わない"}, {"type": "subtitle", "time": 2176.069, "timestamp": "00:36:16", "text": "それは確かに存在する。いや、違う。トップにしましょう"}, {"type": "subtitle", "time": 2178.15, "timestamp": "00:36:18", "text": "初め。"}, {"type": "subtitle", "time": 2180.71, "timestamp": "00:36:20", "text": "１、２。"}, {"type": "subtitle", "time": 2183.51, "timestamp": "00:36:23", "text": "ちょっと置いておきます。"}, {"type": "subtitle", "time": 2189.349, "timestamp": "00:36:29", "text": "うわぁ、うわぁ、うわぁ、うわぁ、うわぁ、うわぁ、"}, {"type": "subtitle", "time": 2191.27, "timestamp": "00:36:31", "text": "うわぁ。"}, {"type": "subtitle", "time": 2204.79, "timestamp": "00:36:44", "text": "今は底値だ。 E"}, {"type": "subtitle", "time": 2207.349, "timestamp": "00:36:47", "text": "もっと。"}, {"type": "subtitle", "time": 2218.5, "timestamp": "00:36:58", "text": "私たちは"}]
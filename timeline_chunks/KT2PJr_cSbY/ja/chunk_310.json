[{"type": "subtitle", "time": 18603.91, "timestamp": "05:10:03", "text": "あ、ごめんなさい。私のミスです。ああ、それは"}, {"type": "subtitle", "time": 18621.83, "timestamp": "05:10:21", "text": "さて、これからどうする？入力フォーマットボタンコマンド"}, {"type": "subtitle", "time": 18623.99, "timestamp": "05:10:23", "text": "入力が間違っています。"}, {"type": "subtitle", "time": 18626.55, "timestamp": "05:10:26", "text": "「間違っている」とはどういう意味ですか？何"}, {"type": "subtitle", "time": 18628.948, "timestamp": "05:10:28", "text": "一体何なんだ？"}, {"type": "subtitle", "time": 18631.59, "timestamp": "05:10:31", "text": "私はXを付けました。"}, {"type": "subtitle", "time": 18645.83, "timestamp": "05:10:45", "text": "配信が発表されました"}]
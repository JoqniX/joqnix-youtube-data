[{"type": "subtitle", "time": 13740.63, "timestamp": "03:49:00", "text": "これ？"}, {"type": "subtitle", "time": 13745.03, "timestamp": "03:49:05", "text": "優先順位のようなものだ。うん。"}, {"type": "subtitle", "time": 13747.189, "timestamp": "03:49:07", "text": "こんにちは。"}, {"type": "subtitle", "time": 13764.63, "timestamp": "03:49:24", "text": "サミーのアナウンサーボタン。つまり"}, {"type": "subtitle", "time": 13768.469, "timestamp": "03:49:28", "text": "昔は、"}, {"type": "subtitle", "time": 13771.67, "timestamp": "03:49:31", "text": "私のDiscordボットをメッセージ送信ツールとして使っています。"}, {"type": "subtitle", "time": 13775.67, "timestamp": "03:49:35", "text": "通常の送信メッセージと同じになりますが"}, {"type": "subtitle", "time": 13778.71, "timestamp": "03:49:38", "text": "今回は、"}, {"type": "subtitle", "time": 13782.71, "timestamp": "03:49:42", "text": "新しいDiscordコンポーネントを使用する"}, {"type": "subtitle", "time": 13785.51, "timestamp": "03:49:45", "text": "えっと、容器とかそういうものですね。それで"}, {"type": "subtitle", "time": 13787.99, "timestamp": "03:49:47", "text": "基本的にはコンテナのようなもの"}, {"type": "subtitle", "time": 13791.269, "timestamp": "03:49:51", "text": "埋め込み可能なもの"}, {"type": "subtitle", "time": 13794.15, "timestamp": "03:49:54", "text": "ストリームの"}, {"type": "subtitle", "time": 13798.63, "timestamp": "03:49:58", "text": "もの。私はメインマップを使用します。"}]
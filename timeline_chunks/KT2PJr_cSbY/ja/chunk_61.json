[{"type": "subtitle", "time": 3666.95, "timestamp": "01:01:06", "text": "これは何ですか？"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "なぜ私はこれを持っているのだろうか？"}, {"type": "subtitle", "time": 3681.99, "timestamp": "01:01:21", "text": "あのね？両方とも同じままにしておきます。"}, {"type": "subtitle", "time": 3685.109, "timestamp": "01:01:25", "text": "大丈夫。次は君の番だよ、サム。"}, {"type": "subtitle", "time": 3688.15, "timestamp": "01:01:28", "text": "これ持ってますか？"}, {"type": "subtitle", "time": 3692.549, "timestamp": "01:01:32", "text": "Unixタイムスタンプはありますか？いいえ。それで、"}, {"type": "subtitle", "time": 3695.75, "timestamp": "01:01:35", "text": "ここからは私が引き継ぎます。"}, {"type": "subtitle", "time": 3697.829, "timestamp": "01:01:37", "text": "開けてください。"}, {"type": "subtitle", "time": 3702.069, "timestamp": "01:01:42", "text": "どこにいるの？外に出て"}, {"type": "subtitle", "time": 3704.23, "timestamp": "01:01:44", "text": "隠蔽。"}, {"type": "subtitle", "time": 3711.27, "timestamp": "01:01:51", "text": "はい、ここにはありません。どうでも。近い"}, {"type": "subtitle", "time": 3713.19, "timestamp": "01:01:53", "text": "それを持ち上げる。"}, {"type": "subtitle", "time": 3717.589, "timestamp": "01:01:57", "text": "えっと、たぶんこことここですよね？"}]
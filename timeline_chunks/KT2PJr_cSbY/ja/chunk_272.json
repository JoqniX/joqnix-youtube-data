[{"type": "subtitle", "time": 16321.11, "timestamp": "04:32:01", "text": "変数を"}, {"type": "subtitle", "time": 16327.03, "timestamp": "04:32:07", "text": "うん、そうするよ。それについては私が心配する。"}, {"type": "subtitle", "time": 16350.63, "timestamp": "04:32:30", "text": "では、あなたはどれくらい進んでいますか？この物"}, {"type": "subtitle", "time": 16354.469, "timestamp": "04:32:34", "text": "今から開始します。これには少し時間がかかります。"}, {"type": "subtitle", "time": 16356.95, "timestamp": "04:32:36", "text": "私は信じている。でも、スピードランでクリアしてみせるよ。いいえ"}, {"type": "subtitle", "time": 16362.95, "timestamp": "04:32:42", "text": "えっと、"}, {"type": "subtitle", "time": 16365.11, "timestamp": "04:32:45", "text": "基本的なことは理解できました。それは"}, {"type": "subtitle", "time": 16368.229, "timestamp": "04:32:48", "text": "それほど難しいことではない。それはただ"}, {"type": "subtitle", "time": 16369.91, "timestamp": "04:32:49", "text": "のように"}, {"type": "subtitle", "time": 16371.75, "timestamp": "04:32:51", "text": "これからメッセージを伝えます"}, {"type": "subtitle", "time": 16374.309, "timestamp": "04:32:54", "text": "ライブ配信後、ボタンをクリック。それでおしまい。の"}, {"type": "subtitle", "time": 16377.11, "timestamp": "04:32:57", "text": "ボタンとかそういう類。充電は"}]
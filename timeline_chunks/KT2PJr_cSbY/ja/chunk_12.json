[{"type": "subtitle", "time": 727.99, "timestamp": "00:12:07", "text": "5つにしたのは、質問が長すぎるからです。おお、"}, {"type": "subtitle", "time": 738.71, "timestamp": "00:12:18", "text": "私のPCを再び修理するにはどうすればいいですか？こんにちは、"}, {"type": "subtitle", "time": 740.389, "timestamp": "00:12:20", "text": "ディラン。"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 747.99, "timestamp": "00:12:27", "text": "ごめん、ちょっと席を外した。私の電力が落ちて"}, {"type": "subtitle", "time": 749.75, "timestamp": "00:12:29", "text": "また顔を直さなければならなかった。ああ、大丈夫ですよ。"}, {"type": "subtitle", "time": 752.15, "timestamp": "00:12:32", "text": "心配ない。すべて順調です。私は実際に"}, {"type": "subtitle", "time": 754.949, "timestamp": "00:12:34", "text": "その後、配信を終了しました。えっと、いとこ"}, {"type": "subtitle", "time": 765.91, "timestamp": "00:12:45", "text": "4つのMCQ問題正解と[歌]"}, {"type": "subtitle", "time": 768.33, "timestamp": "00:12:48", "text": "もし私が7つの18問を受け取ったら。"}, {"type": "subtitle", "time": 768.87, "timestamp": "00:12:48", "text": "[音楽]"}, {"type": "subtitle", "time": 771.35, "timestamp": "00:12:51", "text": "ああ"}, {"type": "subtitle", "time": 775.509, "timestamp": "00:12:55", "text": "うん、君は合格したかもしれないね"}, {"type": "subtitle", "time": 778.389, "timestamp": "00:12:58", "text": "セミトレーラー関連の作業はどうでしたか？"}]
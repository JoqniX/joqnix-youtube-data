[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "それは、えっと"}, {"type": "subtitle", "time": 4933.669, "timestamp": "01:22:13", "text": "それで、パッチを当てようとしたんだけど、"}, {"type": "subtitle", "time": 4937.51, "timestamp": "01:22:17", "text": "機能しません。理解します"}, {"type": "subtitle", "time": 4942.95, "timestamp": "01:22:22", "text": "ステータスエラー400。"}, {"type": "subtitle", "time": 4946.47, "timestamp": "01:22:26", "text": "また、これは埋め込みです"}, {"type": "subtitle", "time": 4963.11, "timestamp": "01:22:43", "text": "あなたの専門分野で。ああ、私のフィールドと配列"}, {"type": "subtitle", "time": 4965.99, "timestamp": "01:22:45", "text": "フォーマットが正しくありません。"}, {"type": "subtitle", "time": 4969.189, "timestamp": "01:22:49", "text": "各要素には文字列が含まれていますが、これはJSONではありません。"}, {"type": "subtitle", "time": 4970.87, "timestamp": "01:22:50", "text": "物体。"}, {"type": "subtitle", "time": 4973.11, "timestamp": "01:22:53", "text": "それらにはコードが付いており、つまり"}, {"type": "subtitle", "time": 4975.189, "timestamp": "01:22:55", "text": "サミーは、それぞれのフィールドが"}, {"type": "subtitle", "time": 4977.83, "timestamp": "01:22:57", "text": "オブジェクトではなく、リテラル文字列。"}]
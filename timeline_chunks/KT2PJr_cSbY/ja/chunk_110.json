[{"type": "subtitle", "time": 6605.83, "timestamp": "01:50:05", "text": "ああ、これだ。入れることができない"}, {"type": "subtitle", "time": 6609.83, "timestamp": "01:50:09", "text": "ここ。目標パスはどこですか？コピー。"}, {"type": "subtitle", "time": 6625.51, "timestamp": "01:50:25", "text": "あの長いエラーは何だったのか？何だって？"}, {"type": "subtitle", "time": 6627.35, "timestamp": "01:50:27", "text": "まさに"}, {"type": "subtitle", "time": 6629.59, "timestamp": "01:50:29", "text": "えーと"}, {"type": "subtitle", "time": 6631.59, "timestamp": "01:50:31", "text": "ほら、僕はいい恐竜だろ。私はいつも来る"}, {"type": "subtitle", "time": 6635.27, "timestamp": "01:50:35", "text": "あなたのシャを見て、ありがとう恐竜。それ"}, {"type": "subtitle", "time": 6638.629, "timestamp": "01:50:38", "text": "本当に大きな意味があります。正直言って、嬉しい"}, {"type": "subtitle", "time": 6642.709, "timestamp": "01:50:42", "text": "あなたが毎日立ち寄る場所です。ありがとう。"}, {"type": "subtitle", "time": 6645.83, "timestamp": "01:50:45", "text": "お忙しい中、お時間を割いていただきありがとうございます。"}, {"type": "subtitle", "time": 6648.47, "timestamp": "01:50:48", "text": "しばらくの間、私を見つめていた。本当に"}, {"type": "subtitle", "time": 6651.35, "timestamp": "01:50:51", "text": "とても意味があります。"}, {"type": "subtitle", "time": 6653.83, "timestamp": "01:50:53", "text": "でも、鶏の丸太はちゃんと世話してね"}, {"type": "subtitle", "time": 6658.229, "timestamp": "01:50:58", "text": "ファイル。あれはおそらく一番の決め手だろう。私"}]
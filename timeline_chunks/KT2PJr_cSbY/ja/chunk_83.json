[{"type": "subtitle", "time": 4980.95, "timestamp": "01:23:00", "text": "また、末尾のカンマは"}, {"type": "subtitle", "time": 4985.11, "timestamp": "01:23:05", "text": "配列はこのコード[音楽]を拒否します。"}, {"type": "subtitle", "time": 4989.59, "timestamp": "01:23:09", "text": "このコードは「Oh my god」を想定しています。"}, {"type": "subtitle", "time": 4993.189, "timestamp": "01:23:13", "text": "何てことだ。"}, {"type": "subtitle", "time": 4995.43, "timestamp": "01:23:15", "text": "文字列変数を設定する代わりに"}, {"type": "subtitle", "time": 4997.83, "timestamp": "01:23:17", "text": "オブジェクトを作成する"}, {"type": "subtitle", "time": 5005.189, "timestamp": "01:23:25", "text": "次にオブジェクトを追加する"}, {"type": "subtitle", "time": 5007.669, "timestamp": "01:23:27", "text": "特性"}, {"type": "subtitle", "time": 5013.59, "timestamp": "01:23:33", "text": "これにより、フィールドエントリは真のオブジェクトではなく"}, {"type": "subtitle", "time": 5015.27, "timestamp": "01:23:35", "text": "テキスト文字列。 [音楽]"}]
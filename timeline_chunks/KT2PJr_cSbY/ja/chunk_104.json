[{"type": "subtitle", "time": 6248.39, "timestamp": "01:44:08", "text": "私がどこにでもいたら、あなたは私のことを知っているかもしれません。"}, {"type": "subtitle", "time": 6250.47, "timestamp": "01:44:10", "text": "うん、"}, {"type": "subtitle", "time": 6253.83, "timestamp": "01:44:13", "text": "スピリッツであなたを見かけたことがあると思います"}, {"type": "subtitle", "time": 6255.43, "timestamp": "01:44:15", "text": "チャネル。"}, {"type": "subtitle", "time": 6259.75, "timestamp": "01:44:19", "text": "精霊たちは会話をする、というのが私の理解が正しければの話だが。持続する。"}, {"type": "subtitle", "time": 6261.99, "timestamp": "01:44:21", "text": "霊的な調子はどうですか？しばらくぶり"}, {"type": "subtitle", "time": 6265.189, "timestamp": "01:44:25", "text": "彼と話した。通知は確認済みです"}, {"type": "subtitle", "time": 6268.229, "timestamp": "01:44:28", "text": "彼のストリームの。"}, {"type": "subtitle", "time": 6271.03, "timestamp": "01:44:31", "text": "私はそれを見た"}, {"type": "subtitle", "time": 6281.59, "timestamp": "01:44:41", "text": "わかりました、保存してください。他に問題点は何ですか？"}, {"type": "subtitle", "time": 6283.669, "timestamp": "01:44:43", "text": "フッターはオブジェクトである必要があります。今すぐ、"}, {"type": "subtitle", "time": 6285.59, "timestamp": "01:44:45", "text": "埋め込み本文は次のようになります。"}, {"type": "subtitle", "time": 6289.03, "timestamp": "01:44:49", "text": "これ。キーを追加します。"}]
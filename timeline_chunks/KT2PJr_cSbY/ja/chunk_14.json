[{"type": "subtitle", "time": 841.269, "timestamp": "00:14:01", "text": "Discordイベント作成"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "えーと、いろいろ。うん。これから私たちは"}, {"type": "subtitle", "time": 847.269, "timestamp": "00:14:07", "text": "今後のスケジュール。まさにこの人"}, {"type": "subtitle", "time": 852.069, "timestamp": "00:14:12", "text": "Discordでは、これを埋め込みます。"}, {"type": "subtitle", "time": 855.67, "timestamp": "00:14:15", "text": "こんにちは。 H22。合格したと思う。うん、君"}, {"type": "subtitle", "time": 859.43, "timestamp": "00:14:19", "text": "おそらく合格していたでしょう。うん。"}, {"type": "subtitle", "time": 861.99, "timestamp": "00:14:21", "text": "見せる。"}, {"type": "subtitle", "time": 866.47, "timestamp": "00:14:26", "text": "わかった。えーっと、まず最初に、"}, {"type": "subtitle", "time": 868.949, "timestamp": "00:14:28", "text": "応用"}, {"type": "subtitle", "time": 872.069, "timestamp": "00:14:32", "text": "復元"}, {"type": "subtitle", "time": 879.43, "timestamp": "00:14:39", "text": "そうそう。これでリンクが手に入る"}, {"type": "subtitle", "time": 881.99, "timestamp": "00:14:41", "text": "なぜなら、これらの埋め込みは、このウェブフックを"}, {"type": "subtitle", "time": 884.069, "timestamp": "00:14:44", "text": "こちらでは近々オニキスが登場します。 [音楽] ああ"}, {"type": "subtitle", "time": 887.11, "timestamp": "00:14:47", "text": "うん、この名前を変える必要がある"}, {"type": "subtitle", "time": 890.629, "timestamp": "00:14:50", "text": "オンクス。うん。うん。えっと"}, {"type": "subtitle", "time": 893.269, "timestamp": "00:14:53", "text": "これらのウェブフックはディスコで作られています"}, {"type": "subtitle", "time": 897.03, "timestamp": "00:14:57", "text": "フックですよね？簡単に編集できます"}]
[{"type": "subtitle", "time": 14281.59, "timestamp": "03:58:01", "text": "12 モデルを使用し、その後 20 アフリカ"}, {"type": "subtitle", "time": 14286.87, "timestamp": "03:58:06", "text": "各国を合わせた数。何てことだ。"}, {"type": "subtitle", "time": 14289.199, "timestamp": "03:58:09", "text": "何てことだ。 おお。"}, {"type": "subtitle", "time": 14295.11, "timestamp": "03:58:15", "text": "私はこれらのことを全く知りませんでした。何てことだ。"}, {"type": "subtitle", "time": 14298.309, "timestamp": "03:58:18", "text": "何？ゲームみたいだと思った"}, {"type": "subtitle", "time": 14300.95, "timestamp": "03:58:20", "text": "サーバーは現在稼働中です。彼らはサーバーを持っています"}, {"type": "subtitle", "time": 14303.269, "timestamp": "03:58:23", "text": "彼らのオフィスか何か。"}, {"type": "subtitle", "time": 14306.309, "timestamp": "03:58:26", "text": "ええ、"}, {"type": "subtitle", "time": 14308.55, "timestamp": "03:58:28", "text": "そんな感じ。"}, {"type": "subtitle", "time": 14336.55, "timestamp": "03:58:56", "text": "待って、埋め込みを使わないといけないの？"}]
[{"type": "subtitle", "time": 1321.19, "timestamp": "00:22:01", "text": "文字通りチャンネルストライクを何のように配置しますか"}, {"type": "subtitle", "time": 1325.11, "timestamp": "00:22:05", "text": "去年のことだったんだけど、"}, {"type": "subtitle", "time": 1326.789, "timestamp": "00:22:06", "text": "のんびりくつろいでチャンネルを"}, {"type": "subtitle", "time": 1336.149, "timestamp": "00:22:16", "text": "このような場合。だから私は"}, {"type": "subtitle", "time": 1340.789, "timestamp": "00:22:20", "text": "自分のサーバーで自分のボットを使うように"}, {"type": "subtitle", "time": 1343.909, "timestamp": "00:22:23", "text": "人々は、ジャムを聴きながら、"}, {"type": "subtitle", "time": 1347.19, "timestamp": "00:22:27", "text": "私はパソコンで聴いています。しかしその柔らかさ"}, {"type": "subtitle", "time": 1350.63, "timestamp": "00:22:30", "text": "私が使っていたあのボット"}, {"type": "subtitle", "time": 1358.149, "timestamp": "00:22:38", "text": "えっと"}, {"type": "subtitle", "time": 1360.23, "timestamp": "00:22:40", "text": "の"}, {"type": "subtitle", "time": 1365.43, "timestamp": "00:22:45", "text": "DS GitHub Discord ボット"}, {"type": "subtitle", "time": 1367.99, "timestamp": "00:22:47", "text": "壮大なオーディオストリーム。ええ、これは"}, {"type": "subtitle", "time": 1371.669, "timestamp": "00:22:51", "text": "何らかの理由でもう機能していません"}, {"type": "subtitle", "time": 1373.669, "timestamp": "00:22:53", "text": "えーっと、いろいろ"}, {"type": "subtitle", "time": 1378.549, "timestamp": "00:22:58", "text": "うん、良い後任を見つけなきゃ。"}]
[{"type": "subtitle", "time": 15901.349, "timestamp": "04:25:01", "text": "はぁ？"}, {"type": "subtitle", "time": 15921.75, "timestamp": "04:25:21", "text": "いいえ、作業スペースの料金は既に支払いました。ええ、私は"}, {"type": "subtitle", "time": 15925.03, "timestamp": "04:25:25", "text": "代金を支払いました。そんなことはあり得ない。はい、それは"}, {"type": "subtitle", "time": 15926.87, "timestamp": "04:25:26", "text": "働く。"}, {"type": "subtitle", "time": 15942.07, "timestamp": "04:25:42", "text": "こんにちは。待っていてください。"}, {"type": "subtitle", "time": 15951.51, "timestamp": "04:25:51", "text": "グーグル"}, {"type": "subtitle", "time": 15953.269, "timestamp": "04:25:53", "text": "ツーステップ。"}]
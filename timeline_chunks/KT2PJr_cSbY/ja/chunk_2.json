[{"type": "subtitle", "time": 159.589, "timestamp": "00:02:39", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 164.47, "timestamp": "00:02:44", "text": "皆さん、今夜はいかがお過ごしですか？こんにちは。"}, {"type": "subtitle", "time": 171.35, "timestamp": "00:02:51", "text": "日本語の授業が終わったところです"}, {"type": "subtitle", "time": 173.35, "timestamp": "00:02:53", "text": "そして私は"}, {"type": "subtitle", "time": 176.309, "timestamp": "00:02:56", "text": "少し休憩した。"}, {"type": "subtitle", "time": 178.79, "timestamp": "00:02:58", "text": "少し休んだ。"}]
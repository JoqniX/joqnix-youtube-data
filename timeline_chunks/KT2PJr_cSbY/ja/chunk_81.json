[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "旅は私の"}, {"type": "subtitle", "time": 4866.709, "timestamp": "01:21:06", "text": "私の名前で命名する。いいえ、それだけです。"}, {"type": "subtitle", "time": 4869.11, "timestamp": "01:21:09", "text": "ウェブサイトの作業をしないといけないんだ。 O"}, {"type": "subtitle", "time": 4892.149, "timestamp": "01:21:32", "text": "日本語で助けてください。なぜ？"}, {"type": "subtitle", "time": 4899.35, "timestamp": "01:21:39", "text": "ほら、いいじゃないか。それはそれをやっています"}, {"type": "subtitle", "time": 4904.07, "timestamp": "01:21:44", "text": "その通りです。でも、でも、でも、なぜ？そうではありません"}, {"type": "subtitle", "time": 4913.51, "timestamp": "01:21:53", "text": "だから（音楽は）うまくいくはずだ。"}, {"type": "subtitle", "time": 4916.709, "timestamp": "01:21:56", "text": "理解できません。"}]
[{"type": "subtitle", "time": 19083.91, "timestamp": "05:18:03", "text": "セットはどこで発表したか、そしてどこで"}, {"type": "subtitle", "time": 19088.23, "timestamp": "05:18:08", "text": "このアナウンスタイプを取得する"}, {"type": "subtitle", "time": 19091.83, "timestamp": "05:18:11", "text": "これはどこから来たのか発表する"}, {"type": "subtitle", "time": 19098.948, "timestamp": "05:18:18", "text": "あなたはこれについて私に何も教えてくれなかった。"}, {"type": "subtitle", "time": 19107.99, "timestamp": "05:18:27", "text": "変数のアナウンス時間を設定します。わかった。セット"}, {"type": "subtitle", "time": 19112.07, "timestamp": "05:18:32", "text": "変数。つまり、ローカル変数ということですね？"}, {"type": "subtitle", "time": 19122.47, "timestamp": "05:18:42", "text": "の"}, {"type": "subtitle", "time": 19131.27, "timestamp": "05:18:51", "text": "待合室"}]
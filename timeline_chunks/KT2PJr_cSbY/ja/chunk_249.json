[{"type": "subtitle", "time": 14940.55, "timestamp": "04:09:00", "text": "しかし、彼はいくつか素晴らしいことを言っています。おお、"}, {"type": "subtitle", "time": 14945.83, "timestamp": "04:09:05", "text": "ストリームの開始をスケジュールします。よし、これ"}, {"type": "subtitle", "time": 14949.75, "timestamp": "04:09:09", "text": "それを真似します。それが一つ目です。待って、私はしない"}, {"type": "subtitle", "time": 14952.71, "timestamp": "04:09:12", "text": "私はこれを支持しません。"}, {"type": "subtitle", "time": 14960.309, "timestamp": "04:09:20", "text": "Twitterにはかつて、"}, {"type": "subtitle", "time": 14962.469, "timestamp": "04:09:22", "text": "数日前のユーザー。これは撮影されました"}, {"type": "subtitle", "time": 14996.389, "timestamp": "04:09:56", "text": "うん。待って、これがあったんだけど"}, {"type": "subtitle", "time": 14999.429, "timestamp": "04:09:59", "text": "ブレイキング・バッドみたいなやつ。すべてのピクセル"}]
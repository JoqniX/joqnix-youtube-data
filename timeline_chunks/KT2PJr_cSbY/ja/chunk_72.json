[{"type": "subtitle", "time": 4321.51, "timestamp": "01:12:01", "text": "来月か1月に試験を受ける予定です。"}, {"type": "subtitle", "time": 4330.07, "timestamp": "01:12:10", "text": "まだ日本語を勉強中です。"}, {"type": "subtitle", "time": 4366.709, "timestamp": "01:12:46", "text": "有効だと書いてあります。"}, {"type": "subtitle", "time": 4370.229, "timestamp": "01:12:50", "text": "はぁ？ほら、テストしてみようと思うんだけど"}, {"type": "subtitle", "time": 4373.91, "timestamp": "01:12:53", "text": "ディスコ風にアレンジする。わかった。"}, {"type": "subtitle", "time": 4375.75, "timestamp": "01:12:55", "text": "オプション"}, {"type": "subtitle", "time": 4379.83, "timestamp": "01:12:59", "text": "言うと、ただ"}]
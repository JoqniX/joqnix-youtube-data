[{"type": "subtitle", "time": 783.59, "timestamp": "00:13:03", "text": "哦好的。所以，"}, {"type": "subtitle", "time": 786.31, "timestamp": "00:13:06", "text": "我們已經完成了與 YouTube API 相關的"}, {"type": "subtitle", "time": 789.67, "timestamp": "00:13:09", "text": "內容，也完成了 Discord 相關的"}, {"type": "subtitle", "time": 791.99, "timestamp": "00:13:11", "text": "內容，"}, {"type": "subtitle", "time": 794.71, "timestamp": "00:13:14", "text": "甚至包括建立和更新"}, {"type": "subtitle", "time": 797.59, "timestamp": "00:13:17", "text": "縮圖。目前這兩件事都"}, {"type": "subtitle", "time": 799.59, "timestamp": "00:13:19", "text": "完成了，"}, {"type": "subtitle", "time": 803.19, "timestamp": "00:13:23", "text": "嗯，"}, {"type": "subtitle", "time": 806.15, "timestamp": "00:13:26", "text": "這兩件事都完成了，"}, {"type": "subtitle", "time": 807.269, "timestamp": "00:13:27", "text": "還有[音樂]"}, {"type": "subtitle", "time": 808.949, "timestamp": "00:13:28", "text": "嗯，"}, {"type": "subtitle", "time": 810.949, "timestamp": "00:13:30", "text": "我需要做一個新的邏輯[音樂]，"}, {"type": "subtitle", "time": 814.23, "timestamp": "00:13:34", "text": "如果我更改串流時間表，它會更新"}, {"type": "subtitle", "time": 817.19, "timestamp": "00:13:37", "text": "。所以它"}, {"type": "subtitle", "time": 820.71, "timestamp": "00:13:40", "text": "應該會發起一個補丁請求，嗯，我需要"}, {"type": "subtitle", "time": 824.23, "timestamp": "00:13:44", "text": "保存這些嵌入內容。不，不，不。"}, {"type": "subtitle", "time": 826.71, "timestamp": "00:13:46", "text": "將這些數據保存到一個文件中，以便它可以"}, {"type": "subtitle", "time": 829.19, "timestamp": "00:13:49", "text": "從 [music] 文件中提取數據，創建一個數組"}, {"type": "subtitle", "time": 831.99, "timestamp": "00:13:51", "text": "等等，並交叉檢查所有流"}, {"type": "subtitle", "time": 835.03, "timestamp": "00:13:55", "text": "和事件 ID 等等。"}, {"type": "subtitle", "time": 836.949, "timestamp": "00:13:56", "text": "不過，我們來看看結果如何吧。我們"}, {"type": "subtitle", "time": 839.03, "timestamp": "00:13:59", "text": "稍後會在"}]
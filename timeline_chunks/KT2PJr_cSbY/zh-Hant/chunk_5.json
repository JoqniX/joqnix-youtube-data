[{"type": "subtitle", "time": 300.79, "timestamp": "00:05:00", "text": "日語，日語N4"}, {"type": "subtitle", "time": 303.03, "timestamp": "00:05:03", "text": "複習，還有漢字學習等等，"}, {"type": "subtitle", "time": 305.43, "timestamp": "00:05:05", "text": "因為我"}, {"type": "subtitle", "time": 308.95, "timestamp": "00:05:08", "text": "晚上有個考試。 [音樂] 所以我"}, {"type": "subtitle", "time": 311.27, "timestamp": "00:05:11", "text": "想投入時間和精力，"}, {"type": "subtitle", "time": 314.39, "timestamp": "00:05:14", "text": "真正學習我"}, {"type": "subtitle", "time": 317.67, "timestamp": "00:05:17", "text": "目前為止所學到的一切。好的。明天要"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "穩紮穩打，認真地進行"}, {"type": "subtitle", "time": 322.39, "timestamp": "00:05:22", "text": "直播，"}, {"type": "subtitle", "time": 325.11, "timestamp": "00:05:25", "text": "不要偷懶。所以這就是"}, {"type": "subtitle", "time": 327.749, "timestamp": "00:05:27", "text": "我們明天要做的事。好的，早上好，"}, {"type": "subtitle", "time": 329.59, "timestamp": "00:05:29", "text": "我會盡量早起，"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "複習一下，做"}, {"type": "subtitle", "time": 334.95, "timestamp": "00:05:34", "text": "很多作業，也會寫一些草稿，做一些小測驗等等。"}, {"type": "subtitle", "time": 341.35, "timestamp": "00:05:41", "text": "所以，是的，"}, {"type": "subtitle", "time": 346.07, "timestamp": "00:05:46", "text": "我已經完全想清楚了。  是的。這樣我就不會忘記了，對吧？"}, {"type": "subtitle", "time": 348.629, "timestamp": "00:05:48", "text": "如果我"}, {"type": "subtitle", "time": 351.11, "timestamp": "00:05:51", "text": "在直播中這樣做，我會很穩，夥計。如果我不做，就好像在偷懶。所以，"}, {"type": "subtitle", "time": 355.83, "timestamp": "00:05:55", "text": "希望一切"}]
[{"type": "subtitle", "time": 4446.39, "timestamp": "01:14:06", "text": "下個月"}, {"type": "subtitle", "time": 4448.39, "timestamp": "01:14:08", "text": "或一月參加N4考試。  還在學習日文。  是的。  這個V是什麼意思？呃，好的。"}, {"type": "subtitle", "time": 4457.83, "timestamp": "01:14:17", "text": "YouTube. 活出精彩人生。  它說有效，是嗎？你知道，"}, {"type": "subtitle", "time": 4462.229, "timestamp": "01:14:22", "text": "我打算把它放到"}, {"type": "subtitle", "time": 4464.87, "timestamp": "01:14:24", "text": "迪斯可音樂裡測試一下。好的。  選項裡說，嗯，好吧，把它刪掉"}, {"type": "subtitle", "time": 4475.27, "timestamp": "01:14:35", "text": "。放在這裡。  什麼？你不想那樣嗎？  這些是什麼？這些錯誤是什麼？呃，我還想賦予它一種復古時尚感。我覺得有些時候我可能會去其他國家。啊，你在做什麼？哦，今天"}, {"type": "subtitle", "time": 4477.59, "timestamp": "01:14:37", "text": "我們正在開發一個用於 Discord 的"}, {"type": "subtitle", "time": 4480.07, "timestamp": "01:14:40", "text": "自動化系統。我以前在我"}, {"type": "subtitle", "time": 4485.27, "timestamp": "01:14:45", "text": "的頻道伺服器上有一個名為“日程安排”的頻道。"}, {"type": "subtitle", "time": 4494.229, "timestamp": "01:14:54", "text": "所以每次我在 YouTube 上安排"}, {"type": "subtitle", "time": 4497.99, "timestamp": "01:14:57", "text": "直播時，這裡都會自動"}]
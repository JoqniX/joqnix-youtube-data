[{"type": "subtitle", "time": 4630.87, "timestamp": "01:17:10", "text": "我需要用到條件邏輯"}, {"type": "subtitle", "time": 4633.03, "timestamp": "01:17:13", "text": "。現在它將當前時間與計劃流"}, {"type": "subtitle", "time": 4636.47, "timestamp": "01:17:16", "text": "時間進行比較。如果時間少於5分鐘或10分鐘，那就進行公告。"}, {"type": "subtitle", "time": 4640.07, "timestamp": "01:17:20", "text": "[音樂] 如果如果如果距離預定的直播時間還有四"}, {"type": "subtitle", "time": 4650.55, "timestamp": "01:17:30", "text": "五個小時或兩三個小時的話。然後，嗯，就像……呃，該怎麼稱呼它呢？候診室留言。是的，我必須做那件事。此外，"}, {"type": "subtitle", "time": 4662.39, "timestamp": "01:17:42", "text": "我們還需要取得"}]
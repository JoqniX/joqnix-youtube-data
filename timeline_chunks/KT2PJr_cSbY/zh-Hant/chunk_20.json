[{"type": "subtitle", "time": 1202.47, "timestamp": "00:20:02", "text": "等等，你剛剛是不是​​聽到我"}, {"type": "subtitle", "time": 1205.19, "timestamp": "00:20:05", "text": "播放的音樂了？ [倒抽一口氣]"}, {"type": "subtitle", "time": 1207.669, "timestamp": "00:20:07", "text": "等等，"}, {"type": "subtitle", "time": 1211.11, "timestamp": "00:20:11", "text": "別放音樂。啊，不，我不能"}, {"type": "subtitle", "time": 1213.75, "timestamp": "00:20:13", "text": "那樣做。"}, {"type": "subtitle", "time": 1220.23, "timestamp": "00:20:20", "text": "YouTube，"}, {"type": "subtitle", "time": 1223.35, "timestamp": "00:20:23", "text": "你知道，我做不到。 YouTube版權所有。"}, {"type": "subtitle", "time": 1229.83, "timestamp": "00:20:29", "text": "我不知道。你看，看看這個。  就像"}, {"type": "subtitle", "time": 1234.149, "timestamp": "00:20:34", "text": "遊戲錄製功能有自動"}, {"type": "subtitle", "time": 1237.029, "timestamp": "00:20:37", "text": "全螢幕錄製功能一樣。好的。  不知何故，"}, {"type": "subtitle", "time": 1240.149, "timestamp": "00:20:40", "text": "它捕獲了文件分解器。它"}, {"type": "subtitle", "time": 1242.23, "timestamp": "00:20:42", "text": "捕捉到了我在 YouTube 上的"}, {"type": "subtitle", "time": 1243.83, "timestamp": "00:20:43", "text": "音樂。  搞什麼鬼？  哇"}, {"type": "subtitle", "time": 1249.35, "timestamp": "00:20:49", "text": "。"}, {"type": "subtitle", "time": 1252.789, "timestamp": "00:20:52", "text": "不過別擔心。呃，"}, {"type": "subtitle", "time": 1256.95, "timestamp": "00:20:56", "text": "我把 YouTube 音樂檔案放在一個"}]
[{"type": "subtitle", "time": 481.029, "timestamp": "00:08:01", "text": "對吧？這件事應該會"}, {"type": "subtitle", "time": 485.67, "timestamp": "00:08:05", "text": "在12月發生。不，"}, {"type": "subtitle", "time": 489.83, "timestamp": "00:08:09", "text": "總共是50分嗎？啊，我明白了。"}, {"type": "subtitle", "time": 496.39, "timestamp": "00:08:16", "text": "[嘆氣與喘息] 嗨。"}, {"type": "subtitle", "time": 500.95, "timestamp": "00:08:20", "text": "Alexa，我回來了。好了，我這就結束這個話題。"}, {"type": "subtitle", "time": 502.39, "timestamp": "00:08:22", "text": "沒關係。你怎麼認為？我是在開玩笑"}, {"type": "subtitle", "time": 504.07, "timestamp": "00:08:24", "text": "。"}, {"type": "subtitle", "time": 506.629, "timestamp": "00:08:26", "text": "期末考如期舉行。  就"}, {"type": "subtitle", "time": 511.189, "timestamp": "00:08:31", "text": "我所知，"}, {"type": "subtitle", "time": 513.75, "timestamp": "00:08:33", "text": "即使你在大學或學院之類的，"}, {"type": "subtitle", "time": 517.029, "timestamp": "00:08:37", "text": "期末考通常也會"}, {"type": "subtitle", "time": 520.149, "timestamp": "00:08:40", "text": "在"}, {"type": "subtitle", "time": 524.31, "timestamp": "00:08:44", "text": "四月或三月舉行。不，那是什麼呢"}, {"type": "subtitle", "time": 525.91, "timestamp": "00:08:45", "text": "？你讀的是什麼專業？"}, {"type": "subtitle", "time": 529.829, "timestamp": "00:08:49", "text": "我忘了問這個問題。"}, {"type": "subtitle", "time": 532.07, "timestamp": "00:08:52", "text": "H"}, {"type": "subtitle", "time": 534.63, "timestamp": "00:08:54", "text": "Maya"}]
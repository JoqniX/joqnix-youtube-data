[{"type": "subtitle", "time": 727.99, "timestamp": "00:12:07", "text": "五，因為我的問題太長了。哦，"}, {"type": "subtitle", "time": 738.71, "timestamp": "00:12:18", "text": "我的電腦又出問題了，該怎麼修？你好，"}, {"type": "subtitle", "time": 740.389, "timestamp": "00:12:20", "text": "迪蘭。"}, {"type": "subtitle", "time": 742.389, "timestamp": "00:12:22", "text": "你好。你好。"}, {"type": "subtitle", "time": 747.99, "timestamp": "00:12:27", "text": "對不起，我溜了。我的電源斷了，我"}, {"type": "subtitle", "time": 749.75, "timestamp": "00:12:29", "text": "不得不重新整理我的臉。哦，沒關係。"}, {"type": "subtitle", "time": 752.15, "timestamp": "00:12:32", "text": "不用擔心。一切都好。那之後我就"}, {"type": "subtitle", "time": 754.949, "timestamp": "00:12:34", "text": "結束直播了。因為"}, {"type": "subtitle", "time": 765.91, "timestamp": "00:12:45", "text": "四道選擇題都答對了，很好，[唱歌]"}, {"type": "subtitle", "time": 768.33, "timestamp": "00:12:48", "text": "如果我答對了七題，18題。"}, {"type": "subtitle", "time": 768.87, "timestamp": "00:12:48", "text": "[音樂]"}, {"type": "subtitle", "time": 771.35, "timestamp": "00:12:51", "text": "啊，是"}, {"type": "subtitle", "time": 775.509, "timestamp": "00:12:55", "text": "啊，你可能已經通過了，那"}, {"type": "subtitle", "time": 778.389, "timestamp": "00:12:58", "text": "你半決賽進行得怎麼樣？"}]
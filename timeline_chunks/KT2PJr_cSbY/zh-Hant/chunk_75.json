[{"type": "subtitle", "time": 4500.87, "timestamp": "01:15:00", "text": "更新。所以今天下午的直播裡，"}, {"type": "subtitle", "time": 4515.91, "timestamp": "01:15:15", "text": "我們發現昨天我沒有直播，而是在幕後工作，重新製作我很久以前製作的一些舊東西，像是 YouTube API 之類的。現在一切都自動化了。我剛剛在YouTube上安排了一場直播。它會自動建立一個"}, {"type": "subtitle", "time": 4519.75, "timestamp": "01:15:19", "text": "Discord 活動。是的，它會自動建立一個 Discord 活動，並且還會更新嵌入內容。"}, {"type": "subtitle", "time": 4524.39, "timestamp": "01:15:24", "text": "現在，在"}, {"type": "subtitle", "time": 4528.39, "timestamp": "01:15:28", "text": "我們完成嵌入內容、動態更新嵌入內容之後，我們將著手"}, {"type": "subtitle", "time": 4541.43, "timestamp": "01:15:41", "text": "處理我如何宣布我的直播"}, {"type": "subtitle", "time": 4544.31, "timestamp": "01:15:44", "text": "串流之類的事情，對吧"}, {"type": "subtitle", "time": 4557.91, "timestamp": "01:15:57", "text": "現在我要把它設置成自動的，當我想直播的時候，它會自動 ping 一下，然後自動嵌入內容，並自動"}]
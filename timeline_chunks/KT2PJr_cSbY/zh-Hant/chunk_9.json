[{"type": "subtitle", "time": 540.47, "timestamp": "00:09:00", "text": "你說的系統"}, {"type": "subtitle", "time": 542.07, "timestamp": "00:09:02", "text": "不同是什麼意思？等等，你是印度人，"}, {"type": "subtitle", "time": 550.389, "timestamp": "00:09:10", "text": "或者等等，"}, {"type": "subtitle", "time": 558.31, "timestamp": "00:09:18", "text": "呃，是的，你來自印度。對不起。我覺得"}, {"type": "subtitle", "time": 561.67, "timestamp": "00:09:21", "text": "這是大學才會有的事。"}, {"type": "subtitle", "time": 564.55, "timestamp": "00:09:24", "text": "我祈禱我的考卷是50分，而且我能考"}, {"type": "subtitle", "time": 567.67, "timestamp": "00:09:27", "text": "50分。"}, {"type": "subtitle", "time": 579.67, "timestamp": "00:09:39", "text": "好的。好的。這是一個截然不同的奇怪"}, {"type": "subtitle", "time": 583.99, "timestamp": "00:09:43", "text": "系統。編號為 Sm 1、SM 2、SM 3、SM 4。"}, {"type": "subtitle", "time": 586.23, "timestamp": "00:09:46", "text": "哦，是的。"}, {"type": "subtitle", "time": 588.63, "timestamp": "00:09:48", "text": "Ignu 裡也有嗎？我認為"}]
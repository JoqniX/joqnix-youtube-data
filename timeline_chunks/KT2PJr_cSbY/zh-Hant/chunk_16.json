[{"type": "subtitle", "time": 963.269, "timestamp": "00:16:03", "text": "很棒。我很"}, {"type": "subtitle", "time": 965.59, "timestamp": "00:16:05", "text": "好奇為什麼沒有人會這樣做"}, {"type": "subtitle", "time": 968.069, "timestamp": "00:16:08", "text": "。我覺得你需要委託"}, {"type": "subtitle", "time": 969.67, "timestamp": "00:16:09", "text": "別人來做。不，我想我得"}, {"type": "subtitle", "time": 972.15, "timestamp": "00:16:12", "text": "委託克里斯蒂娜的兒子之類的。"}, {"type": "subtitle", "time": 974.629, "timestamp": "00:16:14", "text": "但調試費用很高。我"}, {"type": "subtitle", "time": 977.59, "timestamp": "00:16:17", "text": "沒錢了。"}, {"type": "subtitle", "time": 984.466, "timestamp": "00:16:24", "text": "當然很好。"}, {"type": "subtitle", "time": 985.829, "timestamp": "00:16:25", "text": "[笑聲]"}, {"type": "subtitle", "time": 993.91, "timestamp": "00:16:33", "text": "你好。  是的。"}, {"type": "subtitle", "time": 996.55, "timestamp": "00:16:36", "text": "呃，我們現在在做什麼"}, {"type": "subtitle", "time": 998.629, "timestamp": "00:16:38", "text": "？"}, {"type": "subtitle", "time": 1000.87, "timestamp": "00:16:40", "text": "對，就是這個。今天上課的時候"}, {"type": "subtitle", "time": 1004.069, "timestamp": "00:16:44", "text": "，我一直在看這個，還在"}, {"type": "subtitle", "time": 1012.389, "timestamp": "00:16:52", "text": "課堂上做了一些小小的補充。"}, {"type": "subtitle", "time": 1014.629, "timestamp": "00:16:54", "text": "哦，"}, {"type": "subtitle", "time": 1017.35, "timestamp": "00:16:57", "text": "好的。"}]
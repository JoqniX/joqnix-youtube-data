[{"type": "subtitle", "time": 159.589, "timestamp": "00:02:39", "text": "你好。你好。"}, {"type": "subtitle", "time": 164.47, "timestamp": "00:02:44", "text": "大家今晚過得怎麼樣？你好。"}, {"type": "subtitle", "time": 171.35, "timestamp": "00:02:51", "text": "我的日文課剛結束，"}, {"type": "subtitle", "time": 173.35, "timestamp": "00:02:53", "text": "我"}, {"type": "subtitle", "time": 176.309, "timestamp": "00:02:56", "text": "休息了一會兒。  休息了一會兒。"}]
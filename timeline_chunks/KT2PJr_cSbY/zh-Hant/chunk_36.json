[{"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "呃，是數組插入，而不是插入。"}, {"type": "subtitle", "time": 2173.51, "timestamp": "00:36:13", "text": "沒有盡頭，對吧？我不認為"}, {"type": "subtitle", "time": 2176.069, "timestamp": "00:36:16", "text": "這是真的。等等，不對。我們先來看頂部"}, {"type": "subtitle", "time": 2178.15, "timestamp": "00:36:18", "text": "。"}, {"type": "subtitle", "time": 2180.71, "timestamp": "00:36:20", "text": "一，二。"}, {"type": "subtitle", "time": 2183.51, "timestamp": "00:36:23", "text": "讓我放點東西。"}, {"type": "subtitle", "time": 2189.349, "timestamp": "00:36:29", "text": "，哇，哇，哇，哇，哇，"}, {"type": "subtitle", "time": 2191.27, "timestamp": "00:36:31", "text": "哇。  那確實有這麼"}, {"type": "subtitle", "time": 2204.79, "timestamp": "00:36:44", "text": "現在已經跌到谷底了。"}, {"type": "subtitle", "time": 2207.349, "timestamp": "00:36:47", "text": "更多。"}, {"type": "subtitle", "time": 2218.5, "timestamp": "00:36:58", "text": "我們"}]
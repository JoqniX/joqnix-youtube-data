[{"type": "subtitle", "time": 181.75, "timestamp": "00:03:01", "text": "呃，還有，我又"}, {"type": "subtitle", "time": 191.91, "timestamp": "00:03:11", "text": "直播吃了晚餐。一秒鐘。讓我發條"}, {"type": "subtitle", "time": 197.82999999999998, "timestamp": "00:03:17", "text": "推特吧。好的。重獲新生。"}, {"type": "subtitle", "time": 204.22899999999998, "timestamp": "00:03:24", "text": "山姆牌商品"}, {"type": "subtitle", "time": 205.99, "timestamp": "00:03:25", "text": "。"}, {"type": "subtitle", "time": 210.149, "timestamp": "00:03:30", "text": "我們正在做更多工作，"}, {"type": "subtitle", "time": 214.869, "timestamp": "00:03:34", "text": "呃，工作工作方面的事情，"}, {"type": "subtitle", "time": 221.35, "timestamp": "00:03:41", "text": "運作良好。"}, {"type": "subtitle", "time": 227.277, "timestamp": "00:03:47", "text": "你好。不是糖。"}, {"type": "subtitle", "time": 229.67000000000002, "timestamp": "00:03:49", "text": "[笑聲] 嗨，我甚至沒有"}]
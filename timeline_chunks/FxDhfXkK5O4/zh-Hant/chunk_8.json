[{"type": "subtitle", "time": 482.71, "timestamp": "00:08:02", "text": "哦，對，我就是這麼做的。然後我"}, {"type": "subtitle", "time": 486.79, "timestamp": "00:08:06", "text": "四、五點鐘的時候開始用電腦，在三星手機上研究"}, {"type": "subtitle", "time": 492.79, "timestamp": "00:08:12", "text": "本地伺服器、WebSocket 伺服器和"}, {"type": "subtitle", "time": 499.189, "timestamp": "00:08:19", "text": "是啊，當時真是忙得不可開交。然後我突然想到"}, {"type": "subtitle", "time": 503.35, "timestamp": "00:08:23", "text": "一個主意。為什麼我不建立一個監聽器，"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "像伺服器設定本機 WebSocket 相關"}, {"type": "subtitle", "time": 509.83, "timestamp": "00:08:29", "text": "內容一樣，這樣我就可以"}, {"type": "subtitle", "time": 512.31, "timestamp": "00:08:32", "text": "單獨監聽它以及其他四個元素，"}, {"type": "subtitle", "time": 516.07, "timestamp": "00:08:36", "text": "例如即時狀態、串流主題"}, {"type": "subtitle", "time": 519.67, "timestamp": "00:08:39", "text": "狀態和活動狀態。"}, {"type": "subtitle", "time": 523.269, "timestamp": "00:08:43", "text": "他們三個。現在我只能根據"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "接收到的資料進行視覺更新，而且這確實有效。然後我"}, {"type": "subtitle", "time": 532.79, "timestamp": "00:08:52", "text": "意識到，哦，"}, {"type": "subtitle", "time": 534.31, "timestamp": "00:08:54", "text": "這"}, {"type": "subtitle", "time": 537.03, "timestamp": "00:08:57", "text": "東西在控制台裡有很多日誌，導致程式運行卡頓，所以"}]
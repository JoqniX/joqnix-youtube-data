[{"type": "subtitle", "time": 241.67, "timestamp": "00:04:01", "text": "直播不知何故突然中斷了。"}, {"type": "subtitle", "time": 243.429, "timestamp": "00:04:03", "text": "此時此刻，我覺得我應該"}, {"type": "subtitle", "time": 246.949, "timestamp": "00:04:06", "text": "完全改用 Mel"}, {"type": "subtitle", "time": 250.07, "timestamp": "00:04:10", "text": "多重融合。  我用的是"}, {"type": "subtitle", "time": 253.11, "timestamp": "00:04:13", "text": "多平台直播，但我現在還在用Beam，"}, {"type": "subtitle", "time": 257.27, "timestamp": "00:04:17", "text": "因為Beam也有問題，"}, {"type": "subtitle", "time": 260.39, "timestamp": "00:04:20", "text": "Kick倒是沒問題。 Kick 和 Beam 自己的"}, {"type": "subtitle", "time": 262.71, "timestamp": "00:04:22", "text": "平台就很好。"}, {"type": "subtitle", "time": 265.189, "timestamp": "00:04:25", "text": "但是 Twitch，唉，Twitch 和 YouTube"}, {"type": "subtitle", "time": 267.59, "timestamp": "00:04:27", "text": "總是會出問題。它斷了。它會"}, {"type": "subtitle", "time": 269.59, "timestamp": "00:04:29", "text": "時不時隨機斷電。是"}, {"type": "subtitle", "time": 272.15, "timestamp": "00:04:32", "text": "的，今天的直播"}, {"type": "subtitle", "time": 275.83, "timestamp": "00:04:35", "text": "對我來說只是聊天直播。"}, {"type": "subtitle", "time": 278.87, "timestamp": "00:04:38", "text": "我猜他只是閒聊了"}, {"type": "subtitle", "time": 282.31, "timestamp": "00:04:42", "text": "一會兒。實際上，這嚴格來說會持續1小時"}, {"type": "subtitle", "time": 289.749, "timestamp": "00:04:49", "text": "，時間嚴格限制在1小時以內。那"}, {"type": "subtitle", "time": 292.31, "timestamp": "00:04:52", "text": "我今晚就告辭了。今晚……呃，今天早上"}]
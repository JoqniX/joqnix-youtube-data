[{"type": "subtitle", "time": 301.11, "timestamp": "00:05:01", "text": "早上我得去晨练。"}, {"type": "subtitle", "time": 305.749, "timestamp": "00:05:05", "text": "我的"}, {"type": "subtitle", "time": 307.43, "timestamp": "00:05:07", "text": "邻居兼"}, {"type": "subtitle", "time": 311.43, "timestamp": "00:05:11", "text": "老同学，我问他要不要一起出去玩，"}, {"type": "subtitle", "time": 315.67, "timestamp": "00:05:15", "text": "他还邀请我去他"}, {"type": "subtitle", "time": 317.749, "timestamp": "00:05:17", "text": "家什么的，我说不了，"}, {"type": "subtitle", "time": 321.35, "timestamp": "00:05:21", "text": "我不想去，因为我晚上已经有很多事要做了，结果又"}, {"type": "subtitle", "time": 328.95, "timestamp": "00:05:28", "text": "睡着了。"}, {"type": "subtitle", "time": 333.71, "timestamp": "00:05:33", "text": "但是……"}, {"type": "subtitle", "time": 336.31, "timestamp": "00:05:36", "text": "（音乐）……"}, {"type": "subtitle", "time": 340.79, "timestamp": "00:05:40", "text": "所以我就说，是我先"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "提起的，真是蠢。"}, {"type": "subtitle", "time": 346.23, "timestamp": "00:05:46", "text": "也许我们可以像往常一样，做"}, {"type": "subtitle", "time": 350.15, "timestamp": "00:05:50", "text": "我们日常的事情。我"}, {"type": "subtitle", "time": 353.43, "timestamp": "00:05:53", "text": "不该那么说的。说"}, {"type": "subtitle", "time": 358.95, "timestamp": "00:05:58", "text": "实话，我并不介意散步，"}]
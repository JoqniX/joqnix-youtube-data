[{"type": "subtitle", "time": 1744.07, "timestamp": "00:29:04", "text": "我通过"}, {"type": "subtitle", "time": 1747.909, "timestamp": "00:29:07", "text": "QQ 的二维码扫描器在你的账户"}, {"type": "subtitle", "time": 1750.549, "timestamp": "00:29:10", "text": "页面上为 Billy Billy 做了这件事。 它彻底打开了"}, {"type": "subtitle", "time": 1753.8, "timestamp": "00:29:13", "text": "比利比利。 我当时就想，“哇，"}, {"type": "subtitle", "time": 1761.47, "timestamp": "00:29:21", "text": "这音乐真好听。”"}, {"type": "subtitle", "time": 1764.23, "timestamp": "00:29:24", "text": "[音乐]"}, {"type": "subtitle", "time": 1765.99, "timestamp": "00:29:25", "text": "哦，"}, {"type": "subtitle", "time": 1768.23, "timestamp": "00:29:28", "text": "告诉我们印度能为原创人才做些什么"}, {"type": "subtitle", "time": 1771.2, "timestamp": "00:29:31", "text": "。 是的。 所以，所以"}, {"type": "subtitle", "time": 1778.149, "timestamp": "00:29:38", "text": "我从我的声音里能感觉到"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "我现在很累。 我依然死在"}, {"type": "subtitle", "time": 1790.07, "timestamp": "00:29:50", "text": "你相信吗？ 我内心依然一片死寂"}, {"type": "subtitle", "time": 1798.789, "timestamp": "00:29:58", "text": "[音乐]"}]
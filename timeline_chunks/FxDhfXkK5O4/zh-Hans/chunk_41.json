[{"type": "subtitle", "time": 2476.47, "timestamp": "00:41:16", "text": "再见，乔。 吃药"}, {"type": "subtitle", "time": 2479.109, "timestamp": "00:41:19", "text": "睡觉。 你好。 晚安，亲爱的。"}, {"type": "subtitle", "time": 2480.39, "timestamp": "00:41:20", "text": "晚安。 晚安。 谢谢你过来"}, {"type": "subtitle", "time": 2483.43, "timestamp": "00:41:23", "text": "和我聊天。 这对我意义"}, {"type": "subtitle", "time": 2489.51, "timestamp": "00:41:29", "text": "谢谢。"}, {"type": "subtitle", "time": 2491.27, "timestamp": "00:41:31", "text": "睡得好。 愿星辰今晚保佑你"}, {"type": "subtitle", "time": 2506.55, "timestamp": "00:41:46", "text": "[音乐]"}, {"type": "subtitle", "time": 2508.71, "timestamp": "00:41:48", "text": "好的。"}, {"type": "subtitle", "time": 2518.79, "timestamp": "00:41:58", "text": "我看看现在能不能添加一个银行"}]
[{"type": "subtitle", "time": 123.03, "timestamp": "00:02:03", "text": "吃点东西，回来，呃，直播，"}, {"type": "subtitle", "time": 126.069, "timestamp": "00:02:06", "text": "然后再睡一会儿。 但我真的"}, {"type": "subtitle", "time": 128.63, "timestamp": "00:02:08", "text": "睡着了。"}, {"type": "subtitle", "time": 133.19, "timestamp": "00:02:13", "text": "所以，我仍然希望这140天，也就是140天，"}, {"type": "subtitle", "time": 136.71, "timestamp": "00:02:16", "text": "仍然会被算作140天。我的意思是，"}, {"type": "subtitle", "time": 139.19, "timestamp": "00:02:19", "text": "昨天，我知道是"}, {"type": "subtitle", "time": 143.11, "timestamp": "00:02:23", "text": "第二天。 我知道现在已经过了12点"}, {"type": "subtitle", "time": 146.47, "timestamp": "00:02:26", "text": "，但我凌晨1点就醒了。"}, {"type": "subtitle", "time": 149.35, "timestamp": "00:02:29", "text": "真的是凌晨1点整。"}, {"type": "subtitle", "time": 151.35, "timestamp": "00:02:31", "text": "所以，老实说，"}, {"type": "subtitle", "time": 153.43, "timestamp": "00:02:33", "text": "我本来想早上直播的"}, {"type": "subtitle", "time": 155.35, "timestamp": "00:02:35", "text": "。 我当时正在编写"}, {"type": "subtitle", "time": 159.27, "timestamp": "00:02:39", "text": "小部件的HTML叠加层。 正如你在"}, {"type": "subtitle", "time": 163.67000000000002, "timestamp": "00:02:43", "text": "屏幕上看到的，直播功能又回来了。"}, {"type": "subtitle", "time": 166.63, "timestamp": "00:02:46", "text": "天哪，我为此付出了很多心血。"}, {"type": "subtitle", "time": 169.35, "timestamp": "00:02:49", "text": "说实话，当时真是忙得"}, {"type": "subtitle", "time": 173.03, "timestamp": "00:02:53", "text": "不可开交。 我感觉筋疲力尽"}, {"type": "subtitle", "time": 175.19, "timestamp": "00:02:55", "text": "。"}, {"type": "subtitle", "time": 178.949, "timestamp": "00:02:58", "text": "我感觉筋疲力尽。 我当时想，我的"}]
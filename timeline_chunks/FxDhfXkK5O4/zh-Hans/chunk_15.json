[{"type": "subtitle", "time": 903.189, "timestamp": "00:15:03", "text": "他们帮我关联我的银行账户。"}, {"type": "subtitle", "time": 905.509, "timestamp": "00:15:05", "text": "嗯……"}, {"type": "subtitle", "time": 909.11, "timestamp": "00:15:09", "text": "银行账户。"}, {"type": "subtitle", "time": 911.59, "timestamp": "00:15:11", "text": "我必须让他把我的银行账户关联到"}, {"type": "subtitle", "time": 922.069, "timestamp": "00:15:22", "text": "GST 系统中，因为我每隔"}, {"type": "subtitle", "time": 924.55, "timestamp": "00:15:24", "text": "两天就会收到一封电子邮件，说"}, {"type": "subtitle", "time": 927.03, "timestamp": "00:15:27", "text": "我只剩下几天时间来关联"}, {"type": "subtitle", "time": 932.71, "timestamp": "00:15:32", "text": "你的 GST 业务的银行账户。   是的"}, {"type": "subtitle", "time": 937.67, "timestamp": "00:15:37", "text": "。 通用汽车的商业运作，是的。   看来"}, {"type": "subtitle", "time": 942.31, "timestamp": "00:15:42", "text": "我必须这么做。"}, {"type": "subtitle", "time": 944.87, "timestamp": "00:15:44", "text": "让我上传一张我的银行"}, {"type": "subtitle", "time": 951.829, "timestamp": "00:15:51", "text": "所以它正式开业了。 走吧。"}, {"type": "subtitle", "time": 954.389, "timestamp": "00:15:54", "text": "这个名字的全名就是 Jocknix"}, {"type": "subtitle", "time": 957.35, "timestamp": "00:15:57", "text": "。"}]
[{"type": "subtitle", "time": 482.71, "timestamp": "00:08:02", "text": "哦，对，我就是这么做的。 然后我"}, {"type": "subtitle", "time": 486.79, "timestamp": "00:08:06", "text": "四五点钟的时候"}, {"type": "subtitle", "time": 489.83, "timestamp": "00:08:09", "text": "开始用电脑，在三星手机上研究"}, {"type": "subtitle", "time": 492.79, "timestamp": "00:08:12", "text": "本地服务器、WebSocket 服务器和"}, {"type": "subtitle", "time": 499.189, "timestamp": "00:08:19", "text": "是啊，当时真是忙得不可开交。 然后我突然想到"}, {"type": "subtitle", "time": 503.35, "timestamp": "00:08:23", "text": "一个主意。 为什么我不创建一个监听器，"}, {"type": "subtitle", "time": 506.469, "timestamp": "00:08:26", "text": "像服务器设置本地 WebSocket 相关"}, {"type": "subtitle", "time": 509.83, "timestamp": "00:08:29", "text": "内容那样，这样我就可以单独监听它"}, {"type": "subtitle", "time": 512.31, "timestamp": "00:08:32", "text": "以及其他四个元素，"}, {"type": "subtitle", "time": 516.07, "timestamp": "00:08:36", "text": "例如实时状态、流主题"}, {"type": "subtitle", "time": 519.67, "timestamp": "00:08:39", "text": "状态和活动状态。   他们"}, {"type": "subtitle", "time": 523.269, "timestamp": "00:08:43", "text": "三个。 现在我只能"}, {"type": "subtitle", "time": 526.15, "timestamp": "00:08:46", "text": "根据接收到的数据进行视觉更新，"}, {"type": "subtitle", "time": 530.389, "timestamp": "00:08:50", "text": "而且这确实有效。 然后我"}, {"type": "subtitle", "time": 532.79, "timestamp": "00:08:52", "text": "意识到，哦，"}, {"type": "subtitle", "time": 534.31, "timestamp": "00:08:54", "text": "这"}, {"type": "subtitle", "time": 537.03, "timestamp": "00:08:57", "text": "东西在控制台里有很多日志，导致程序运行"}]
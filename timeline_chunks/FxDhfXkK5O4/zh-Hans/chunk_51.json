[{"type": "subtitle", "time": 3070.47, "timestamp": "00:51:10", "text": "我讨厌电话连接。 有时"}, {"type": "subtitle", "time": 3077.67, "timestamp": "00:51:17", "text": "有时能连上，有时"}, {"type": "subtitle", "time": 3079.03, "timestamp": "00:51:19", "text": "连不上。"}, {"type": "subtitle", "time": 3081.91, "timestamp": "00:51:21", "text": "所以我很困惑，我会问，"}, {"type": "subtitle", "time": 3085.43, "timestamp": "00:51:25", "text": "嘿，怎么回事？"}, {"type": "subtitle", "time": 3088.15, "timestamp": "00:51:28", "text": "有时候它连接不上，有时候又"}, {"type": "subtitle", "time": 3090.71, "timestamp": "00:51:30", "text": "复制粘贴不了。"}, {"type": "subtitle", "time": 3092.309, "timestamp": "00:51:32", "text": "我觉得我应该找个"}, {"type": "subtitle", "time": 3094.71, "timestamp": "00:51:34", "text": "其他的应用程序来"}, {"type": "subtitle", "time": 3097.51, "timestamp": "00:51:37", "text": "和电脑"}, {"type": "subtitle", "time": 3099.589, "timestamp": "00:51:39", "text": "、手机"}, {"type": "subtitle", "time": 3102.39, "timestamp": "00:51:42", "text": "等设备共享全局剪贴板，而不是用 Windows Phone，"}, {"type": "subtitle", "time": 3103.99, "timestamp": "00:51:43", "text": "老实说，"}, {"type": "subtitle", "time": 3115.91, "timestamp": "00:51:55", "text": "twitch.tv/dnext"}]
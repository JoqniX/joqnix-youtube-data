[{"type": "subtitle", "time": 2108.55, "timestamp": "00:35:08", "text": "初めての報酬を送ってきて"}, {"type": "subtitle", "time": 2111.829, "timestamp": "00:35:11", "text": "、もっと"}, {"type": "subtitle", "time": 2113.75, "timestamp": "00:35:13", "text": "装飾的なものにしてくれるといいですね。 お金を渡すだけでなく"}, {"type": "subtitle", "time": 2116.15, "timestamp": "00:35:16", "text": "、"}, {"type": "subtitle", "time": 2119.37, "timestamp": "00:35:19", "text": "お祝いの贈り物とか何かもくれるといいな。"}, {"type": "subtitle", "time": 2128.63, "timestamp": "00:35:28", "text": "それは本当に素晴らしいですね。 皮を剥がされたせいで、"}, {"type": "subtitle", "time": 2130.39, "timestamp": "00:35:30", "text": "もっと助けてもらえなかった。"}, {"type": "subtitle", "time": 2133.109, "timestamp": "00:35:33", "text": "皮を剥がされた。"}, {"type": "subtitle", "time": 2139.589, "timestamp": "00:35:39", "text": "お金がほとんどない人。"}, {"type": "subtitle", "time": 2143.19, "timestamp": "00:35:43", "text": "大丈夫。"}]
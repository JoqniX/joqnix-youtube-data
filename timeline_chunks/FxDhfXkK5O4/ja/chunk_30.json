[{"type": "subtitle", "time": 1802.23, "timestamp": "00:30:02", "text": "ええと、そうですね。 えっと、"}, {"type": "subtitle", "time": 1803.83, "timestamp": "00:30:03", "text": "そう、明日配信しないといけないんだよ"}, {"type": "subtitle", "time": 1806.789, "timestamp": "00:30:06", "text": "ね？"}, {"type": "subtitle", "time": 1810.149, "timestamp": "00:30:10", "text": "正直言って、丸一日休みたいんです。 わからない"}, {"type": "subtitle", "time": 1812.47, "timestamp": "00:30:12", "text": "。"}, {"type": "subtitle", "time": 1815.269, "timestamp": "00:30:15", "text": "今でも毎日欠かさずに配信するように自分に言い聞かせなければならない。"}, {"type": "subtitle", "time": 1821.35, "timestamp": "00:30:21", "text": "なぜなら、もし以前YouTubeで配信しないと言っていたら、YouTubeでは配信しないと言った"}, {"type": "subtitle", "time": 1828.95, "timestamp": "00:30:28", "text": "から、配信しないだろうと思ったからだ。"}, {"type": "subtitle", "time": 1833.909, "timestamp": "00:30:33", "text": "でも、"}, {"type": "subtitle", "time": 1836.31, "timestamp": "00:30:36", "text": "私は頑固で、"}, {"type": "subtitle", "time": 1846.71, "timestamp": "00:30:46", "text": "痛みも感じたくない。"}, {"type": "subtitle", "time": 1848.63, "timestamp": "00:30:48", "text": "[音楽] というわけで"}, {"type": "subtitle", "time": 1851.35, "timestamp": "00:30:51", "text": "、"}, {"type": "subtitle", "time": 1855.11, "timestamp": "00:30:55", "text": "もし私が家にいなくて、"}, {"type": "subtitle", "time": 1856.95, "timestamp": "00:30:56", "text": "家族旅行などで外出している場合は、"}]
[{"type": "subtitle", "time": 1685.97, "timestamp": "00:28:05", "text": "そしてそれは正直言ってクレイジーなことです。"}, {"type": "chat", "time": 1686.269, "timestamp": "00:28:06", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "especially QR payments"}, {"type": "subtitle", "time": 1689.029, "timestamp": "00:28:09", "text": "[音楽]が"}, {"type": "subtitle", "time": 1691.83, "timestamp": "00:28:11", "text": "成し遂げてきたこと、特に"}, {"type": "subtitle", "time": 1695.35, "timestamp": "00:28:15", "text": "治癒の数は。 そう、中国とかそういうところ。"}, {"type": "subtitle", "time": 1698.389, "timestamp": "00:28:18", "text": "中国、マレーシア、シンガポールはどこも"}, {"type": "chat", "time": 1700.361, "timestamp": "00:28:20", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "shows what India can do if we retain our talent"}, {"type": "subtitle", "time": 1701.35, "timestamp": "00:28:21", "text": "治療費の支払いが非常に多い。"}, {"type": "subtitle", "time": 1704.23, "timestamp": "00:28:24", "text": "特に中国には、治療費の"}, {"type": "subtitle", "time": 1713.19, "timestamp": "00:28:33", "text": "ソーシャルメディアアプリには"}, {"type": "subtitle", "time": 1717.43, "timestamp": "00:28:37", "text": "QRコードスキャナーがあり、"}, {"type": "subtitle", "time": 1719.83, "timestamp": "00:28:39", "text": "そのQRコードスキャナーは"}, {"type": "subtitle", "time": 1723.43, "timestamp": "00:28:43", "text": "クロスプラットフォームで動作します。つまり、自分のTikTokをスキャンすると、"}, {"type": "subtitle", "time": 1732.95, "timestamp": "00:28:52", "text": "支払いを行う場合はAlipayに移動し、"}, {"type": "subtitle", "time": 1736.63, "timestamp": "00:28:56", "text": "QRコードが"}, {"type": "subtitle", "time": 1738.71, "timestamp": "00:28:58", "text": "リンクしているアプリが"}]
[{"type": "subtitle", "time": 960.87, "timestamp": "00:16:00", "text": "そして、私は自分のメールアドレス、つまり"}, {"type": "subtitle", "time": 963.99, "timestamp": "00:16:03", "text": "仕事用のメールアドレスを持っています。"}, {"type": "subtitle", "time": 967.509, "timestamp": "00:16:07", "text": "ああ、登録番号は私の"}, {"type": "subtitle", "time": 970.87, "timestamp": "00:16:10", "text": "個人です。 いいえ、登録"}, {"type": "subtitle", "time": 973.509, "timestamp": "00:16:13", "text": "番号です。 変更します。 でも、ええ、ちょっと"}, {"type": "chat", "time": 973.535, "timestamp": "00:16:13", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "leeeggoooo"}, {"type": "subtitle", "time": 976.069, "timestamp": "00:16:16", "text": "問題があって、"}, {"type": "subtitle", "time": 980.87, "timestamp": "00:16:20", "text": "今はどうすればいいのかすごく混乱しているんです。というのも、"}, {"type": "subtitle", "time": 983.509, "timestamp": "00:16:23", "text": "今はすべての書類が私の"}, {"type": "subtitle", "time": 985.43, "timestamp": "00:16:25", "text": "個人番号に入っていて、もちろん私は"}, {"type": "subtitle", "time": 988.55, "timestamp": "00:16:28", "text": "9か月後にインドを出国する予定なんです。 つまり、"}, {"type": "subtitle", "time": 990.55, "timestamp": "00:16:30", "text": "アクティブにはならないということです。 それが一つの問題点だ。"}, {"type": "subtitle", "time": 993.829, "timestamp": "00:16:33", "text": "父が今後それを充電して、"}, {"type": "subtitle", "time": 996.949, "timestamp": "00:16:36", "text": "番号をアクティブな状態に保つかどうかはわかりません"}, {"type": "subtitle", "time": 998.389, "timestamp": "00:16:38", "text": "。 わからない。"}, {"type": "subtitle", "time": 1000.79, "timestamp": "00:16:40", "text": "ええ、現在の口座の"}, {"type": "subtitle", "time": 1004.15, "timestamp": "00:16:44", "text": "問題に戻ると、個人の"}, {"type": "subtitle", "time": 1006.87, "timestamp": "00:16:46", "text": "電話番号が個人の銀行口座などにリンクされていて、"}, {"type": "subtitle", "time": 1013.67, "timestamp": "00:16:53", "text": "すでにUPIが登録されている場合、"}, {"type": "subtitle", "time": 1016.87, "timestamp": "00:16:56", "text": "新しい当座預金口座を作成して同じ"}, {"type": "subtitle", "time": 1019.749, "timestamp": "00:16:59", "text": "番号を使用すると、"}]
[{"type": "subtitle", "time": 421.67, "timestamp": "00:07:01", "text": "。"}, {"type": "subtitle", "time": 424.39, "timestamp": "00:07:04", "text": "またインスピレーションを得るために、動画を見るようにしようと思います。"}, {"type": "subtitle", "time": 426.55, "timestamp": "00:07:06", "text": "すると、「ああ、"}, {"type": "subtitle", "time": 431.029, "timestamp": "00:07:11", "text": "起きてお茶を淹れなきゃ」って思うんです。 起きます。 私は仕事が終わるとすぐに二階の"}, {"type": "subtitle", "time": 442.95, "timestamp": "00:07:22", "text": "仕事を始めると、時間を忘れて没頭してしまうんです"}, {"type": "subtitle", "time": 447.99, "timestamp": "00:07:27", "text": "。 それが"}, {"type": "subtitle", "time": 451.749, "timestamp": "00:07:31", "text": "昨日の朝に起こったことです。 午前"}, {"type": "subtitle", "time": 456.629, "timestamp": "00:07:36", "text": "2時に起きてから、午前4時からそれに没頭していました。ああ、"}, {"type": "subtitle", "time": 459.43, "timestamp": "00:07:39", "text": "昨日もこの時間頃に起きました。"}, {"type": "subtitle", "time": 461.83, "timestamp": "00:07:41", "text": "あ、ちょっと待って。   そうそう"}, {"type": "subtitle", "time": 463.919, "timestamp": "00:07:43", "text": "。   そうそう 。"}, {"type": "subtitle", "time": 466.72, "timestamp": "00:07:46", "text": "。 ああ、そうだ"}, {"type": "subtitle", "time": 468.96, "timestamp": "00:07:48", "text": "ああ、そうだ けど、昨日は午後"}, {"type": "subtitle", "time": 470.72, "timestamp": "00:07:50", "text": "けど、昨日は午後 5時か6時に寝たんだ。 右。"}, {"type": "subtitle", "time": 475.039, "timestamp": "00:07:55", "text": "5時か6時に寝たんだ。 右。 私は12時間6分働きました。   ああ"}, {"type": "subtitle", "time": 479.199, "timestamp": "00:07:59", "text": "私は12時間6分働きました。   ああ 、そうだったよ。 それから"}]
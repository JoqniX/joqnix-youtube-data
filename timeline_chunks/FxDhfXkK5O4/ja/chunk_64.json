[{"type": "subtitle", "time": 3841.349, "timestamp": "01:04:01", "text": "寄付金を支払いたい人"}, {"type": "subtitle", "time": 3848.309, "timestamp": "01:04:08", "text": "最善を尽くします。"}, {"type": "subtitle", "time": 3850.95, "timestamp": "01:04:10", "text": "もし、ダッシュボードの設定を無料で行える方法があれば"}, {"type": "subtitle", "time": 3855.829, "timestamp": "01:04:15", "text": "、"}, {"type": "subtitle", "time": 3858.47, "timestamp": "01:04:18", "text": "私は実際にそれを行います。   私がやります"}, {"type": "subtitle", "time": 3861.029, "timestamp": "01:04:21", "text": "。 よし"}, {"type": "subtitle", "time": 3869.589, "timestamp": "01:04:29", "text": "待って。"}, {"type": "subtitle", "time": 3871.75, "timestamp": "01:04:31", "text": "こんにちは。 短い配信で申し訳ありませんが、"}, {"type": "subtitle", "time": 3874.549, "timestamp": "01:04:34", "text": "今日は配信する予定です。"}, {"type": "subtitle", "time": 3881.829, "timestamp": "01:04:41", "text": "今日は141日目の配信を行います。 今日は"}, {"type": "subtitle", "time": 3884.549, "timestamp": "01:04:44", "text": "140。これは昨日のことだと思います。 わかった。"}, {"type": "subtitle", "time": 3887.19, "timestamp": "01:04:47", "text": "こんにちは。   ええ"}, {"type": "subtitle", "time": 3889.75, "timestamp": "01:04:49", "text": "、今日はありがとうございました。"}, {"type": "subtitle", "time": 3891.349, "timestamp": "01:04:51", "text": "皆さんが楽しんでくれたことを願っています。 滞在時間は短かった"}, {"type": "subtitle", "time": 3894.23, "timestamp": "01:04:54", "text": "けど、楽しかったよ"}, {"type": "subtitle", "time": 3896.87, "timestamp": "01:04:56", "text": "。 今夜はご一緒してくださり、ありがとうございました"}]
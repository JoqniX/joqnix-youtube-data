[{"type": "subtitle", "time": 1744.07, "timestamp": "00:29:04", "text": "そして、私は"}, {"type": "subtitle", "time": 1747.909, "timestamp": "00:29:07", "text": "QQのアカウントページにあるQRコードスキャナーを使って、ビリー・ビリーのためにそれを実行しました"}, {"type": "subtitle", "time": 1750.549, "timestamp": "00:29:10", "text": "。 それは文字通りビリー・ビリーの心を開いた"}, {"type": "subtitle", "time": 1753.8, "timestamp": "00:29:13", "text": "。  「わあ、"}, {"type": "subtitle", "time": 1761.47, "timestamp": "00:29:21", "text": "なんて素敵な音楽なんだ」って感じでした。"}, {"type": "subtitle", "time": 1764.23, "timestamp": "00:29:24", "text": "[音楽]"}, {"type": "subtitle", "time": 1765.99, "timestamp": "00:29:25", "text": "ああ、"}, {"type": "subtitle", "time": 1768.23, "timestamp": "00:29:28", "text": "インドがオリジナルの才能のために何ができるか教えてください"}, {"type": "subtitle", "time": 1771.2, "timestamp": "00:29:31", "text": "。 うん。 だから、だから"}, {"type": "subtitle", "time": 1778.149, "timestamp": "00:29:38", "text": "声からして、"}, {"type": "subtitle", "time": 1782.63, "timestamp": "00:29:42", "text": "今すごく疲れているのがわかる。 私はまだ"}, {"type": "subtitle", "time": 1790.07, "timestamp": "00:29:50", "text": "信じられますか？ 私はまだ心の底では死んでいる"}, {"type": "subtitle", "time": 1798.789, "timestamp": "00:29:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 722.23, "timestamp": "00:12:02", "text": "SteamがUPIに"}, {"type": "subtitle", "time": 724.55, "timestamp": "00:12:04", "text": "対応しているって知っていましたか？ 彼らはUPI決済の受付を開始した"}, {"type": "subtitle", "time": 730.55, "timestamp": "00:12:10", "text": "うん。 うん。 うん。 それで、彼らはK Comojo Como"}, {"type": "subtitle", "time": 734.31, "timestamp": "00:12:14", "text": "とかいう日本の決済代行業者を使っているんだ"}, {"type": "subtitle", "time": 744.15, "timestamp": "00:12:24", "text": "。 ちょっと待ってください。"}, {"type": "subtitle", "time": 747.35, "timestamp": "00:12:27", "text": "実際にはこう呼ばれています。"}, {"type": "subtitle", "time": 753.11, "timestamp": "00:12:33", "text": "昨日の午前4時にこれを見ていました。 いいえ、午前3時です。"}, {"type": "subtitle", "time": 757.67, "timestamp": "00:12:37", "text": "夕食を食べていたのですが、忘れていました。 コムー。 これは、"}, {"type": "chat", "time": 757.82, "timestamp": "00:12:37", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "that's great"}, {"type": "subtitle", "time": 759.67, "timestamp": "00:12:39", "text": "日本"}, {"type": "subtitle", "time": 763.269, "timestamp": "00:12:43", "text": "企業が運営するグローバル決済システムです。 日本人が日本"}, {"type": "subtitle", "time": 765.99, "timestamp": "00:12:45", "text": "国内で利用するすべての支払い方法に対応しています"}, {"type": "subtitle", "time": 767.509, "timestamp": "00:12:47", "text": "。"}, {"type": "subtitle", "time": 770.389, "timestamp": "00:12:50", "text": "ええと、中国のような国別では、"}, {"type": "subtitle", "time": 773.59, "timestamp": "00:12:53", "text": "中国のようなQRコードや"}, {"type": "subtitle", "time": 776.79, "timestamp": "00:12:56", "text": "QQ Pay、Valip Payなど、"}, {"type": "subtitle", "time": 778.87, "timestamp": "00:12:58", "text": "あらゆる国があります。"}]
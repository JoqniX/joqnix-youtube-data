[{"type": "subtitle", "time": 3070.47, "timestamp": "00:51:10", "text": "電話回線は大嫌いだ。 接続できない場合もあります"}, {"type": "subtitle", "time": 3077.67, "timestamp": "00:51:17", "text": "接続できる時もあれば、できない時もある"}, {"type": "subtitle", "time": 3079.03, "timestamp": "00:51:19", "text": "。"}, {"type": "subtitle", "time": 3081.91, "timestamp": "00:51:21", "text": "だから私は混乱していて、"}, {"type": "subtitle", "time": 3085.43, "timestamp": "00:51:25", "text": "何が問題なのかと尋ねます。"}, {"type": "subtitle", "time": 3088.15, "timestamp": "00:51:28", "text": "接続できない時もあれば、"}, {"type": "subtitle", "time": 3090.71, "timestamp": "00:51:30", "text": "コピー＆ペーストできない時もあります。Windows"}, {"type": "subtitle", "time": 3102.39, "timestamp": "00:51:42", "text": "Phone を使うのではなく、PC や電話などでグローバル クリップボードを共有するための別のアプリケーションを探すべきだと感じています。"}, {"type": "subtitle", "time": 3103.99, "timestamp": "00:51:43", "text": "正直、あまりにも"}, {"type": "subtitle", "time": 3115.91, "timestamp": "00:51:55", "text": "twitch.tv/dnext"}]
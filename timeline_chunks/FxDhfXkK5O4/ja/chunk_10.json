[{"type": "subtitle", "time": 600.87, "timestamp": "00:10:00", "text": "コーディング"}, {"type": "chat", "time": 601.771, "timestamp": "00:10:01", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "TAKE CARE OF UR HEALTH BUDDY ... GET ENOUGH SLEEP WHENEVER YOU CAN"}, {"type": "subtitle", "time": 603.829, "timestamp": "00:10:03", "text": "関連の作業になると、無料"}, {"type": "subtitle", "time": 609.67, "timestamp": "00:10:09", "text": "コードが頻繁に変更されるなどして使いづらいです。"}, {"type": "subtitle", "time": 611.75, "timestamp": "00:10:11", "text": "昨日は"}, {"type": "subtitle", "time": 614.23, "timestamp": "00:10:14", "text": "そのせいでイライラしました。"}, {"type": "subtitle", "time": 616.55, "timestamp": "00:10:16", "text": "ええ、もう本当にうんざりでした"}, {"type": "subtitle", "time": 618.79, "timestamp": "00:10:18", "text": "。"}, {"type": "subtitle", "time": 620.81, "timestamp": "00:10:20", "text": "ひどく疲れ果てていた。"}, {"type": "subtitle", "time": 623.19, "timestamp": "00:10:23", "text": "[音楽]"}, {"type": "subtitle", "time": 625.269, "timestamp": "00:10:25", "text": "でも、正直言って、またその時期が来たと思う"}, {"type": "subtitle", "time": 631.269, "timestamp": "00:10:31", "text": "。"}, {"type": "subtitle", "time": 637.91, "timestamp": "00:10:37", "text": "昨日医者に行ったって言ったの覚えてる？ 私は"}, {"type": "subtitle", "time": 639.59, "timestamp": "00:10:39", "text": "神経科医を受診します。 彼女は、私がこれまで経験してきた"}, {"type": "subtitle", "time": 641.67, "timestamp": "00:10:41", "text": "目の疲れと脱水症状が原因で神経損傷を起こしていると言いました"}, {"type": "subtitle", "time": 644.79, "timestamp": "00:10:44", "text": "。 大したことないことを願っています"}, {"type": "subtitle", "time": 646.87, "timestamp": "00:10:46", "text": "。"}, {"type": "subtitle", "time": 648.31, "timestamp": "00:10:48", "text": "健康に気をつけてね、相棒。"}, {"type": "subtitle", "time": 657.509, "timestamp": "00:10:57", "text": "うん。 また、私の銀行口座も準備できています。"}]
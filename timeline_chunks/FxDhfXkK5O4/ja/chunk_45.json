[{"type": "subtitle", "time": 2716.23, "timestamp": "00:45:16", "text": "ああ、私のものは更新されていません。 ああ、まだ"}, {"type": "subtitle", "time": 2726.069, "timestamp": "00:45:26", "text": "HP。   何てことだ"}, {"type": "subtitle", "time": 2737.829, "timestamp": "00:45:37", "text": "ここに私の仕事に関する詳細情報はありません。"}, {"type": "subtitle", "time": 2754.15, "timestamp": "00:45:54", "text": "彼らは、まるで有料の"}, {"type": "subtitle", "time": 2757.109, "timestamp": "00:45:57", "text": "ベータテストプログラムであるかのように、"}]
[{"type": "subtitle", "time": 3661.43, "timestamp": "01:01:01", "text": "このアプリをダウンロードして確認する必要があります"}, {"type": "subtitle", "time": 3663.27, "timestamp": "01:01:03", "text": "。 はぁ？"}, {"type": "subtitle", "time": 3670.15, "timestamp": "01:01:10", "text": "ああ、モバイルアプリがあるんですね。"}, {"type": "subtitle", "time": 3672.789, "timestamp": "01:01:12", "text": "面白い。"}, {"type": "subtitle", "time": 3679.19, "timestamp": "01:01:19", "text": "レビューはありませんが、ダウンロード数は5万件以上です。"}, {"type": "subtitle", "time": 3689.109, "timestamp": "01:01:29", "text": "（音楽"}, {"type": "subtitle", "time": 3692.87, "timestamp": "01:01:32", "text": "ファン）とか、そういうやつですよね？"}, {"type": "subtitle", "time": 3694.789, "timestamp": "01:01:34", "text": "あと、ルーム"}, {"type": "subtitle", "time": 3696.71, "timestamp": "01:01:36", "text": "スプレーみたいなのを買ってきました。 私は父に、"}, {"type": "subtitle", "time": 3698.549, "timestamp": "01:01:38", "text": "ほうきのスプレーを私に吹きかけてほしいと頼んだ。 それで、実はルームスプレーを買ったんです"}, {"type": "subtitle", "time": 3701.91, "timestamp": "01:01:41", "text": "。   私にやらせてください"}, {"type": "subtitle", "time": 3705.72, "timestamp": "01:01:45", "text": "。 わかった。 待って。"}, {"type": "subtitle", "time": 3713.99, "timestamp": "01:01:53", "text": "ああ、なんてことだ。 空気中に漂う香りが"}, {"type": "subtitle", "time": 3715.49, "timestamp": "01:01:55", "text": "とてもいい。"}]
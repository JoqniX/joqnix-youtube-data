[{"type": "subtitle", "time": 2822.069, "timestamp": "00:47:02", "text": "受けてみたくなりますね。"}, {"type": "subtitle", "time": 2824.87, "timestamp": "00:47:04", "text": "私はオカネに必死なので、"}, {"type": "subtitle", "time": 2833.67, "timestamp": "00:47:13", "text": "精神が少しリスクを冒すことを望んでいます。"}, {"type": "subtitle", "time": 2853.22, "timestamp": "00:47:33", "text": "問題は、えっと、"}, {"type": "subtitle", "time": 2863.27, "timestamp": "00:47:43", "text": "ちょっと待ってください。 情報は"}, {"type": "subtitle", "time": 2865.91, "timestamp": "00:47:45", "text": "ベータテスト終了後30日以内に削除されます"}, {"type": "subtitle", "time": 2868.069, "timestamp": "00:47:48", "text": "。 プログラムの動作、および"}, {"type": "subtitle", "time": 2871.589, "timestamp": "00:47:51", "text": "ユーザーへの通知。"}, {"type": "subtitle", "time": 2874.47, "timestamp": "00:47:54", "text": "もし彼らが私に"}, {"type": "subtitle", "time": 2876.47, "timestamp": "00:47:56", "text": "この商品のプロモーションを依頼して、動画やコンテンツなどを作ってほしいと頼んできたらどうすればいいでしょうか"}, {"type": "subtitle", "time": 2879.43, "timestamp": "00:47:59", "text": "？"}]
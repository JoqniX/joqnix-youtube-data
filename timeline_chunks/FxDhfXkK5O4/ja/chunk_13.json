[{"type": "subtitle", "time": 781.35, "timestamp": "00:13:01", "text": "最近インドが追加されました。"}, {"type": "subtitle", "time": 783.59, "timestamp": "00:13:03", "text": "国のリストにはインドはありませんが、"}, {"type": "subtitle", "time": 790.15, "timestamp": "00:13:10", "text": "インドでのUPI決済など、"}, {"type": "subtitle", "time": 792.55, "timestamp": "00:13:12", "text": "他の国の支払いプロセスに関するブログ記事があり、"}, {"type": "subtitle", "time": 795.19, "timestamp": "00:13:15", "text": "インドと、"}, {"type": "subtitle", "time": 800.629, "timestamp": "00:13:20", "text": "チームがUPI"}, {"type": "subtitle", "time": 804.71, "timestamp": "00:13:24", "text": "サポートを持っているため、UPIの件があります。"}, {"type": "subtitle", "time": 807.11, "timestamp": "00:13:27", "text": "どうやら、月々の"}, {"type": "chat", "time": 807.902, "timestamp": "00:13:27", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "W UPI"}, {"type": "subtitle", "time": 809.91, "timestamp": "00:13:29", "text": "取引手数料などはかからず、"}, {"type": "subtitle", "time": 815.91, "timestamp": "00:13:35", "text": "取引手数料からのみ手数料を取るようです。それで、"}, {"type": "subtitle", "time": 823.91, "timestamp": "00:13:43", "text": "今ウェブサイトを公開するときに、"}, {"type": "subtitle", "time": 826.389, "timestamp": "00:13:46", "text": "eコマース関連のものが"}, {"type": "subtitle", "time": 829.75, "timestamp": "00:13:49", "text": "完了したら、公開しようと思っています。 それでは、Comoを使ってみます。"}, {"type": "subtitle", "time": 832.71, "timestamp": "00:13:52", "text": "正直に言うと、私は"}, {"type": "subtitle", "time": 835.19, "timestamp": "00:13:55", "text": "決済処理業者、"}, {"type": "subtitle", "time": 837.35, "timestamp": "00:13:57", "text": "決済ゲートウェイとしてComojuを使うつもりです。"}]
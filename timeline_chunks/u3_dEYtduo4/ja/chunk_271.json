[{"type": "subtitle", "time": 16260.63, "timestamp": "04:31:00", "text": "予告編を見に行かないといけないな"}, {"type": "subtitle", "time": 16264.389, "timestamp": "04:31:04", "text": "また。同じ。私は知りたいです。これを見てください"}, {"type": "subtitle", "time": 16268.469, "timestamp": "04:31:08", "text": "こっちの男。何？彼はどんなお仕事をしていますか？"}, {"type": "subtitle", "time": 16278.63, "timestamp": "04:31:18", "text": "見てください、同乗者がいます。彼はとてもかわいい。"}, {"type": "subtitle", "time": 16292.389, "timestamp": "04:31:32", "text": "お仕事は何をされているんですか？"}, {"type": "subtitle", "time": 16295.03, "timestamp": "04:31:35", "text": "ほら、君は一番役に立たないモンスターを選んだんだ"}, {"type": "subtitle", "time": 16296.63, "timestamp": "04:31:36", "text": "これまで。"}, {"type": "subtitle", "time": 16298.79, "timestamp": "04:31:38", "text": "つまり、牛が欲しいなら、誘拐します"}, {"type": "subtitle", "time": 16299.87, "timestamp": "04:31:39", "text": "1"}, {"type": "subtitle", "time": 16307.03, "timestamp": "04:31:47", "text": "いいえ。あ、すみません。でも、私はスピードが遅いんです。私"}, {"type": "subtitle", "time": 16308.71, "timestamp": "04:31:48", "text": "気にしない。"}, {"type": "subtitle", "time": 16311.83, "timestamp": "04:31:51", "text": "冗談です。わかった。もう一つはどこ？"}, {"type": "subtitle", "time": 16312.95, "timestamp": "04:31:52", "text": "もう一つはどこ？私たちはしなければならない"}, {"type": "subtitle", "time": 16316.189, "timestamp": "04:31:56", "text": "私たちの大切なものを守る"}, {"type": "subtitle", "time": 16318.87, "timestamp": "04:31:58", "text": "ゲスト。愛しい子供たち。彼らは子供だ。"}]
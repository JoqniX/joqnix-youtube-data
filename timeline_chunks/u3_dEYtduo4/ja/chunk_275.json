[{"type": "subtitle", "time": 16502.23, "timestamp": "04:35:02", "text": "植物の成長を早めてから待つ"}, {"type": "subtitle", "time": 16509.51, "timestamp": "04:35:09", "text": "今はジャガイモが足りません"}, {"type": "subtitle", "time": 16514.67, "timestamp": "04:35:14", "text": "私はたくさんのジャガイモを持っていた"}, {"type": "subtitle", "time": 16525.349, "timestamp": "04:35:25", "text": "そして私は彼にラピスラズリを尋ねるのを忘れた"}, {"type": "subtitle", "time": 16529.109, "timestamp": "04:35:29", "text": "魅惑的だ。ラピスラズリは持っていません"}, {"type": "subtitle", "time": 16533.15, "timestamp": "04:35:33", "text": "すでにラズリ色です。ああ、彼からね。"}, {"type": "subtitle", "time": 16544.23, "timestamp": "04:35:44", "text": "ああ、それなら基地を作らなきゃ"}, {"type": "subtitle", "time": 16550.949, "timestamp": "04:35:50", "text": "私のものを使っても構いませんよ。私は気にしない。"}, {"type": "subtitle", "time": 16553.99, "timestamp": "04:35:53", "text": "やあ、ジョエラ。"}, {"type": "subtitle", "time": 16557.269, "timestamp": "04:35:57", "text": "溶岩が戻ってきて嬉しいです。私たちの廃棄物"}]
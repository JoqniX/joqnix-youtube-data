[{"type": "subtitle", "time": 8280.15, "timestamp": "02:18:00", "text": "ええと、kofaは機能していますが、"}, {"type": "subtitle", "time": 8281.309, "timestamp": "02:18:01", "text": "インド人"}, {"type": "subtitle", "time": 8283.549, "timestamp": "02:18:03", "text": "私が"}, {"type": "subtitle", "time": 8286.629, "timestamp": "02:18:06", "text": "よし、じゃあこれを試してみよう。"}, {"type": "subtitle", "time": 8293.25, "timestamp": "02:18:13", "text": "実際、私は下げます"}, {"type": "subtitle", "time": 8296.509, "timestamp": "02:18:16", "text": "[音楽]"}, {"type": "subtitle", "time": 8299.75, "timestamp": "02:18:19", "text": "よし、新しい歌を学ぼう"}, {"type": "subtitle", "time": 8303.509, "timestamp": "02:18:23", "text": "私たちは新しい歌を練習しています。だった"}, {"type": "subtitle", "time": 8305.11, "timestamp": "02:18:25", "text": "知っている歌を歌うはずだったが、"}, {"type": "subtitle", "time": 8307.23, "timestamp": "02:18:27", "text": "私たちは新しい歌を練習しています。わかった、"}, {"type": "subtitle", "time": 8317.309, "timestamp": "02:18:37", "text": "えーと"}, {"type": "subtitle", "time": 8320.95, "timestamp": "02:18:40", "text": "M. いつかマラソンを走るつもりだ"}, {"type": "subtitle", "time": 8323.27, "timestamp": "02:18:43", "text": "神スバキの歌を全部歌っています。"}, {"type": "subtitle", "time": 8325.83, "timestamp": "02:18:45", "text": "何？その日は、その日は"}, {"type": "subtitle", "time": 8327.83, "timestamp": "02:18:47", "text": "伝説的な一日になるだろう。その日は私が"}, {"type": "subtitle", "time": 8330.349, "timestamp": "02:18:50", "text": "プロの歌手になるつもりです"}, {"type": "subtitle", "time": 8334.309, "timestamp": "02:18:54", "text": "ディオ。しかし、いつか、その日が来るだろう"}]
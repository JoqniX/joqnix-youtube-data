[{"type": "subtitle", "time": 16200.469, "timestamp": "04:30:00", "text": "もっとずっと良いもの。ああ、なぜ私は"}, {"type": "subtitle", "time": 16203.11, "timestamp": "04:30:03", "text": "きちんとやりますか？ところで、アストラは"}, {"type": "subtitle", "time": 16210.309, "timestamp": "04:30:10", "text": "はぁ？何？"}, {"type": "subtitle", "time": 16211.55, "timestamp": "04:30:11", "text": "与えた"}, {"type": "subtitle", "time": 16215.59, "timestamp": "04:30:15", "text": "さあ、暴徒だ。ああ、彼は私たちに2つの暴徒を与えたか"}, {"type": "subtitle", "time": 16217.99, "timestamp": "04:30:17", "text": "粘土ゴーレムの中の何か、あるいは"}, {"type": "subtitle", "time": 16219.83, "timestamp": "04:30:19", "text": "何か。"}, {"type": "subtitle", "time": 16222.95, "timestamp": "04:30:22", "text": "どちらをご希望ですか？私たちはそうすべきだと思う"}, {"type": "subtitle", "time": 16227.59, "timestamp": "04:30:27", "text": "牛のように行く。どの牛？何？"}, {"type": "subtitle", "time": 16231.429, "timestamp": "04:30:31", "text": "彼が何て言ったか教えてよ"}, {"type": "subtitle", "time": 16234.63, "timestamp": "04:30:34", "text": "ゴーレムは全く役に立たない。銅のゴーレム"}, {"type": "subtitle", "time": 16237.429, "timestamp": "04:30:37", "text": "役に立たない。牛で行こう"}, {"type": "subtitle", "time": 16239.91, "timestamp": "04:30:39", "text": "あなたは牛を繁殖させることができます。"}, {"type": "subtitle", "time": 16243.11, "timestamp": "04:30:43", "text": "牛。ここにはもっとたくさんの牛がいます。銅"}, {"type": "subtitle", "time": 16245.59, "timestamp": "04:30:45", "text": "ゴーレムの方がモブとしてはかっこいいけどね。私たちはそれを持っています"}, {"type": "subtitle", "time": 16248.229, "timestamp": "04:30:48", "text": "けれど。要するに、それは役に立たないということだ。"}, {"type": "subtitle", "time": 16250.51, "timestamp": "04:30:50", "text": "なるがままに。私たちには、"}, {"type": "subtitle", "time": 16258.55, "timestamp": "04:30:58", "text": "それは何ですか？そのものはどこにあるのですか？"}]
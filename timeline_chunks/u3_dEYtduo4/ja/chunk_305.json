[{"type": "subtitle", "time": 18336.708, "timestamp": "05:05:36", "text": "「触らないでください」と書いておきます。"}, {"type": "subtitle", "time": 18338.788, "timestamp": "05:05:38", "text": "いいえ、移動させます。私は作ります"}, {"type": "subtitle", "time": 18348.27, "timestamp": "05:05:48", "text": "なぜ私は"}, {"type": "subtitle", "time": 18350.51, "timestamp": "05:05:50", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 18354.47, "timestamp": "05:05:54", "text": "ああ、ゆりかごはここにある。私は幸せです。これ"}, {"type": "subtitle", "time": 18356.59, "timestamp": "05:05:56", "text": "私を笑顔にしてくれる。の"}]
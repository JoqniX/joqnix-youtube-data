[{"type": "subtitle", "time": 21483.83, "timestamp": "05:58:03", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 21487.27, "timestamp": "05:58:07", "text": "それはあなたへの贈り物です。"}, {"type": "subtitle", "time": 21490.39, "timestamp": "05:58:10", "text": "ああ、なんてことだ。はい、あなたは今"}, {"type": "subtitle", "time": 21492.788, "timestamp": "05:58:12", "text": "より強く。"}, {"type": "subtitle", "time": 21496.19, "timestamp": "05:58:16", "text": "うん。ああ、私たちが持っているからといって"}, {"type": "subtitle", "time": 21498.548, "timestamp": "05:58:18", "text": "厳密に言えば、気にしなくていい。私はしたくない"}, {"type": "subtitle", "time": 21500.708, "timestamp": "05:58:20", "text": "冗談を言う。"}, {"type": "subtitle", "time": 21502.948, "timestamp": "05:58:22", "text": "また、ネザーとエンドは"}, {"type": "subtitle", "time": 21505.99, "timestamp": "05:58:25", "text": "全部閉まってるの？"}, {"type": "subtitle", "time": 21508.708, "timestamp": "05:58:28", "text": "ええ、ネザーは閉鎖されています。わかりました。また、"}, {"type": "subtitle", "time": 21510.23, "timestamp": "05:58:30", "text": "ネザライトを所有している人もいる"}, {"type": "subtitle", "time": 21512.07, "timestamp": "05:58:32", "text": "ネザライトですよね？それについてどうすればいいだろうか？"}, {"type": "subtitle", "time": 21514.23, "timestamp": "05:58:34", "text": "壊れやすいですか？ネザライトを持っている人はいますか？誰が"}, {"type": "subtitle", "time": 21516.628, "timestamp": "05:58:36", "text": "ネザライトはありますか？ハビビは"}, {"type": "subtitle", "time": 21518.788, "timestamp": "05:58:38", "text": "ネザライトと交換する人、または"}, {"type": "subtitle", "time": 21520.708, "timestamp": "05:58:40", "text": "何か？いや、いや、いや。彼は与えることができない"}, {"type": "subtitle", "time": 21524.15, "timestamp": "05:58:44", "text": "ネザライトを誰にでも。わかった。"}, {"type": "subtitle", "time": 21526.948, "timestamp": "05:58:46", "text": "彼は誰かにネザライトをあげたのか？私"}, {"type": "subtitle", "time": 21529.83, "timestamp": "05:58:49", "text": "わからない。ザキから連絡があった"}, {"type": "subtitle", "time": 21531.83, "timestamp": "05:58:51", "text": "一部の人々は権利か何かを得た。"}, {"type": "subtitle", "time": 21535.11, "timestamp": "05:58:55", "text": "私はこう思った"}, {"type": "subtitle", "time": 21538.868, "timestamp": "05:58:58", "text": "私は殺す、もしあなたが私に"}]
[{"type": "subtitle", "time": 6076.629, "timestamp": "01:41:16", "text": "えっと、あれは猫です。黒。えっと、私は"}, {"type": "subtitle", "time": 6084.27, "timestamp": "01:41:24", "text": "ああ、なんてことだ。どこですか？それは"}, {"type": "subtitle", "time": 6095.03, "timestamp": "01:41:35", "text": "1つ。ああ、これだ。うん。うん。うん。"}, {"type": "subtitle", "time": 6099.43, "timestamp": "01:41:39", "text": "与える"}, {"type": "subtitle", "time": 6110.92, "timestamp": "01:41:50", "text": "私 私の"}]
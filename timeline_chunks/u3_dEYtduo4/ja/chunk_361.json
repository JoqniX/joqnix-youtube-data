[{"type": "subtitle", "time": 21661.67, "timestamp": "06:01:01", "text": "ただの郵便受けです。"}, {"type": "subtitle", "time": 21663.83, "timestamp": "06:01:03", "text": "人々が誤って送信した場合"}, {"type": "subtitle", "time": 21667.23, "timestamp": "06:01:07", "text": "彼の郵便受けにはこう書いてある"}, {"type": "subtitle", "time": 21676.788, "timestamp": "06:01:16", "text": "彼女はどこにいるの？失った。何てことだ。"}, {"type": "subtitle", "time": 21679.91, "timestamp": "06:01:19", "text": "彼女は道に迷った。彼女は"}, {"type": "subtitle", "time": 21694.708, "timestamp": "06:01:34", "text": "だから幸運のツルハシは必要ない、あるいは"}, {"type": "subtitle", "time": 21717.11, "timestamp": "06:01:57", "text": "すべて。リールを使いたいのですが、"}]
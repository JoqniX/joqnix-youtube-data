[{"type": "subtitle", "time": 16080.149, "timestamp": "04:28:00", "text": "まだわかりません。わかりました。入れておきます"}, {"type": "subtitle", "time": 16083.03, "timestamp": "04:28:03", "text": "それを箱に入れます。いいえ、いいえ、"}, {"type": "subtitle", "time": 16084.79, "timestamp": "04:28:04", "text": "いや、いや、いや、いや、いや。そこに入れないで"}, {"type": "subtitle", "time": 16087.07, "timestamp": "04:28:07", "text": "胸。わかった。どこかに保管してください"}, {"type": "subtitle", "time": 16091.51, "timestamp": "04:28:11", "text": "それ以外。私は自分のものを作らなければならない。わかった。"}, {"type": "subtitle", "time": 16101.07, "timestamp": "04:28:21", "text": "ここは私の秘密の宝箱です。"}, {"type": "subtitle", "time": 16103.75, "timestamp": "04:28:23", "text": "おお。くそ。大丈夫だよ。取る"}, {"type": "subtitle", "time": 16106.469, "timestamp": "04:28:26", "text": "ちなみに、必要なダイヤモンドです。取る"}, {"type": "subtitle", "time": 16108.79, "timestamp": "04:28:28", "text": "ダイヤモンドの数"}, {"type": "subtitle", "time": 16113.87, "timestamp": "04:28:33", "text": "必要。待って、あなたはオーケー。"}, {"type": "subtitle", "time": 16117.269, "timestamp": "04:28:37", "text": "えっと、いくらですか？"}, {"type": "subtitle", "time": 16119.99, "timestamp": "04:28:39", "text": "1秒。収納スペースが必要です。する"}, {"type": "subtitle", "time": 16122.79, "timestamp": "04:28:42", "text": "胸部を持っているのですか？胸が3つ、または"}, {"type": "subtitle", "time": 16124.55, "timestamp": "04:28:44", "text": "必ずやり遂げる。それは木材です。私は"}, {"type": "subtitle", "time": 16132.63, "timestamp": "04:28:52", "text": "あなたの「Yeah」を主張してください。うん。うん。いいえ、私は"}, {"type": "subtitle", "time": 16135.349, "timestamp": "04:28:55", "text": "在庫がいっぱいです。それが理由です。えっと"}]
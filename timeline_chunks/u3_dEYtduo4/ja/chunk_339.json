[{"type": "subtitle", "time": 20341.59, "timestamp": "05:39:01", "text": "ああ、それは背中につけるものなんですよ。"}, {"type": "subtitle", "time": 20344.31, "timestamp": "05:39:04", "text": "これは私のリュックサックの中には入っていません。"}, {"type": "subtitle", "time": 20345.91, "timestamp": "05:39:05", "text": "それはあなたのリュックサックには付いていません。それはあなたの"}, {"type": "subtitle", "time": 20347.628, "timestamp": "05:39:07", "text": "戻る。のように"}, {"type": "subtitle", "time": 20350.948, "timestamp": "05:39:10", "text": "そこにショートカットキーのようなものがある、"}, {"type": "subtitle", "time": 20353.91, "timestamp": "05:39:13", "text": "右？ホットキーがあったかもしれません"}, {"type": "subtitle", "time": 20355.59, "timestamp": "05:39:15", "text": "それ。"}, {"type": "subtitle", "time": 20357.51, "timestamp": "05:39:17", "text": "ああ、わかりました。わかった。うん。うん。うん。"}, {"type": "subtitle", "time": 20359.91, "timestamp": "05:39:19", "text": "うん。うまくいっていますか？ご覧になりましたか？"}, {"type": "subtitle", "time": 20362.548, "timestamp": "05:39:22", "text": "これで、あなたのバッグには2つのアイテムが入っています。"}, {"type": "subtitle", "time": 20365.11, "timestamp": "05:39:25", "text": "そのため、不具合が発生する可能性があります。"}, {"type": "subtitle", "time": 20367.19, "timestamp": "05:39:27", "text": "ああ、着ているときは"}, {"type": "subtitle", "time": 20369.19, "timestamp": "05:39:29", "text": "さあ、バックパックを背負おう。"}, {"type": "subtitle", "time": 20372.75, "timestamp": "05:39:32", "text": "だから、それは使わないでください。手に入れた"}, {"type": "subtitle", "time": 20375.35, "timestamp": "05:39:35", "text": "それ。それでもその不具合はまだ"}, {"type": "subtitle", "time": 20378.628, "timestamp": "05:39:38", "text": "そこには。でも大丈夫。"}, {"type": "subtitle", "time": 20382.15, "timestamp": "05:39:42", "text": "なあ、俺は疲れすぎているんだ。"}, {"type": "subtitle", "time": 20385.51, "timestamp": "05:39:45", "text": "出て行け。あなたはよく頑張りました。あなたは働いた"}, {"type": "subtitle", "time": 20387.91, "timestamp": "05:39:47", "text": "今日は大変だった。もう寝なさい。あなたは"}, {"type": "subtitle", "time": 20390.788, "timestamp": "05:39:50", "text": "全員にアイテムを？"}, {"type": "subtitle", "time": 20395.11, "timestamp": "05:39:55", "text": "はい、そうしました。今は寝たくない。"}, {"type": "subtitle", "time": 20397.91, "timestamp": "05:39:57", "text": "私は、私は、私たちは何も持っていなかったと言います"}]
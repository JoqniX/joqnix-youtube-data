[{"type": "subtitle", "time": 14943.03, "timestamp": "04:09:03", "text": "Jさん、今日の調子はいかがですか？"}, {"type": "subtitle", "time": 14946.07, "timestamp": "04:09:06", "text": "私は順調だった。えっと、私は歌っていたので"}, {"type": "subtitle", "time": 14948.309, "timestamp": "04:09:08", "text": "多くの。ああ、ダイヤモンドのバックパック"}, {"type": "subtitle", "time": 14951.59, "timestamp": "04:09:11", "text": "あなたによく似合っていますよ。本当に？見えない"}, {"type": "subtitle", "time": 14955.83, "timestamp": "04:09:15", "text": "それは私自身の責任です。ダイヤモンドと赤でできています。"}, {"type": "subtitle", "time": 14958.55, "timestamp": "04:09:18", "text": "あ、それから、何か選ばなければならなかったんです。私"}, {"type": "subtitle", "time": 14961.83, "timestamp": "04:09:21", "text": "アストラに聞くのを忘れた。アストラはどこにいるの？"}, {"type": "subtitle", "time": 14964.95, "timestamp": "04:09:24", "text": "アストラはもういないのか？彼は戻ってくるだろう。私にさせてください"}, {"type": "subtitle", "time": 14966.95, "timestamp": "04:09:26", "text": "えっと、スクリーンショットを撮らせてください"}, {"type": "subtitle", "time": 14975.229, "timestamp": "04:09:35", "text": "[音楽]"}, {"type": "subtitle", "time": 14979.189, "timestamp": "04:09:39", "text": "戻る。チェック。チェック。よし、うまくいった。"}, {"type": "subtitle", "time": 14981.87, "timestamp": "04:09:41", "text": "クエストアイテムも全部失ってしまったのですか？"}, {"type": "subtitle", "time": 14985.67, "timestamp": "04:09:45", "text": "ええ、それはただのええ、"}, {"type": "subtitle", "time": 14988.389, "timestamp": "04:09:48", "text": "究極の武器と牛乳、それらすべて"}, {"type": "subtitle", "time": 14991.429, "timestamp": "04:09:51", "text": "もの。 D 私は6つ、いや5つのダイヤモンドを手に入れました"}, {"type": "subtitle", "time": 14992.67, "timestamp": "04:09:52", "text": "それ"}, {"type": "subtitle", "time": 14996.469, "timestamp": "04:09:56", "text": "胸。パン1束。ええ、たくさんあります"}]
[{"type": "subtitle", "time": 19220.868, "timestamp": "05:20:20", "text": "本当に動揺するのは良いことでしょう"}, {"type": "subtitle", "time": 19222.49, "timestamp": "05:20:22", "text": "実際には動きがある。"}, {"type": "subtitle", "time": 19233.8, "timestamp": "05:20:33", "text": "1つ。"}, {"type": "subtitle", "time": 19235.47, "timestamp": "05:20:35", "text": "[音楽]"}, {"type": "subtitle", "time": 19238.27, "timestamp": "05:20:38", "text": "ええと、でもダイヤモンドは"}, {"type": "subtitle", "time": 19241.11, "timestamp": "05:20:41", "text": "つるはし。文字通り、"}, {"type": "subtitle", "time": 19243.59, "timestamp": "05:20:43", "text": "モルトン。皆さんは私が負けたことを覚えているでしょう"}, {"type": "subtitle", "time": 19245.91, "timestamp": "05:20:45", "text": "ダイヤモンドのつるはしですよね？モレン"}, {"type": "subtitle", "time": 19247.948, "timestamp": "05:20:47", "text": "これによって"}, {"type": "subtitle", "time": 19251.59, "timestamp": "05:20:51", "text": "それ。わかった。斧、木こり、シャベル。"}, {"type": "subtitle", "time": 19253.708, "timestamp": "05:20:53", "text": "私は何者だったのか"}]
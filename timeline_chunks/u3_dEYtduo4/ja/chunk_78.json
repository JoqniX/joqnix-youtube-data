[{"type": "subtitle", "time": 4691.35, "timestamp": "01:18:11", "text": "午後今日は歌いたいんだよ。欲しい"}, {"type": "subtitle", "time": 4694.47, "timestamp": "01:18:14", "text": "歌う。今日は歌ってもいいですか？"}, {"type": "subtitle", "time": 4696.79, "timestamp": "01:18:16", "text": "あなたが寝ていたとは知りませんでした。ああ、"}, {"type": "subtitle", "time": 4701.99, "timestamp": "01:18:21", "text": "待って。えっと、それは、えっと、それは、走った"}, {"type": "subtitle", "time": 4706.39, "timestamp": "01:18:26", "text": "ワイパーは右側にあります。うん。言えません"}, {"type": "subtitle", "time": 4714.709, "timestamp": "01:18:34", "text": "君たちがコラボして寝てるか"}, {"type": "subtitle", "time": 4733.59, "timestamp": "01:18:53", "text": "[音楽]"}, {"type": "subtitle", "time": 4738.03, "timestamp": "01:18:58", "text": "彼はApex Legendsをプレイしていた。ああ、エイペックス。ピュー"}]
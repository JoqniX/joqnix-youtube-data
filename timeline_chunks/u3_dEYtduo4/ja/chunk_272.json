[{"type": "subtitle", "time": 16321.79, "timestamp": "04:32:01", "text": "私たちの子供たち。私たちの"}, {"type": "subtitle", "time": 16325.59, "timestamp": "04:32:05", "text": "テレビ。子供が死ぬ。私たちの子供たち。私は"}, {"type": "subtitle", "time": 16327.269, "timestamp": "04:32:07", "text": "死ぬ。"}, {"type": "subtitle", "time": 16328.59, "timestamp": "04:32:08", "text": "いいえ。ああ、"}, {"type": "subtitle", "time": 16335.91, "timestamp": "04:32:15", "text": "私たち 私たち"}, {"type": "subtitle", "time": 16339.91, "timestamp": "04:32:19", "text": "何てことだ。それは、子供を養子に迎えることです。見て、"}, {"type": "subtitle", "time": 16341.79, "timestamp": "04:32:21", "text": "それは"}, {"type": "subtitle", "time": 16351.63, "timestamp": "04:32:31", "text": "ああ、"}, {"type": "subtitle", "time": 16354.71, "timestamp": "04:32:34", "text": "神。なぜ？ああ、"}, {"type": "subtitle", "time": 16356.79, "timestamp": "04:32:36", "text": "ああ、そんな風に受け取らないで。私は言った"}, {"type": "subtitle", "time": 16370.71, "timestamp": "04:32:50", "text": "ねえ、でももう片方はどこにあるの？見る？"}, {"type": "subtitle", "time": 16373.83, "timestamp": "04:32:53", "text": "では、ちょっとこちらへ来てください。私は"}, {"type": "subtitle", "time": 16377.269, "timestamp": "04:32:57", "text": "ログアウトします。えーと、締めくくりです"}, {"type": "subtitle", "time": 16379.75, "timestamp": "04:32:59", "text": "上。それはあなたのせいだ。私は知らなかった"}]
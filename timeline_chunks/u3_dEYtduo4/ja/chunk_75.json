[{"type": "subtitle", "time": 4500.47, "timestamp": "01:15:00", "text": "その写真があります。最近"}, {"type": "subtitle", "time": 4501.79, "timestamp": "01:15:01", "text": "手に入れた"}, {"type": "subtitle", "time": 4504.59, "timestamp": "01:15:04", "text": "それ。わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 4507.149, "timestamp": "01:15:07", "text": "それ。ああ、そこにいる"}, {"type": "subtitle", "time": 4511.07, "timestamp": "01:15:11", "text": "行く。新品同様に見える。種の、"}, {"type": "subtitle", "time": 4514.07, "timestamp": "01:15:14", "text": "右？うん、新品同様に見えるし"}, {"type": "subtitle", "time": 4514.65, "timestamp": "01:15:14", "text": "もの、"}, {"type": "subtitle", "time": 4517.47, "timestamp": "01:15:17", "text": "[音楽]"}, {"type": "subtitle", "time": 4527.03, "timestamp": "01:15:27", "text": "最悪だ。最悪だ。君を失ってしまった。"}, {"type": "subtitle", "time": 4530.149, "timestamp": "01:15:30", "text": "これは良いGPU Dioでした。それは良かった"}, {"type": "subtitle", "time": 4532.75, "timestamp": "01:15:32", "text": "優れたGPU。"}, {"type": "subtitle", "time": 4535.47, "timestamp": "01:15:35", "text": "そしてそれは"}, {"type": "subtitle", "time": 4539.79, "timestamp": "01:15:39", "text": "最悪だ。そして私の現在のものは"}, {"type": "subtitle", "time": 4545.35, "timestamp": "01:15:45", "text": "20 えーと、どうしていつも間違って言うんだろう？"}, {"type": "subtitle", "time": 4547.79, "timestamp": "01:15:47", "text": "現在のものは"}, {"type": "subtitle", "time": 4553.43, "timestamp": "01:15:53", "text": "この1660 Superは、1台のPCから両方のPCに搭載されています。"}, {"type": "subtitle", "time": 4555.91, "timestamp": "01:15:55", "text": "PCたち。何てことだ。覚えていますか、あれを。"}, {"type": "subtitle", "time": 4557.91, "timestamp": "01:15:57", "text": "三つ？誰か覚えているかどうかわからない"}, {"type": "subtitle", "time": 4559.87, "timestamp": "01:15:59", "text": "それらだが、"}]
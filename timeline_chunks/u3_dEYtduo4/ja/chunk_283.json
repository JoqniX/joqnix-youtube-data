[{"type": "subtitle", "time": 16980.868, "timestamp": "04:43:00", "text": "ニース。昨日、うっかり"}, {"type": "subtitle", "time": 16984.99, "timestamp": "04:43:04", "text": "クエストエリアを破壊したのは、"}, {"type": "subtitle", "time": 16988.39, "timestamp": "04:43:08", "text": "木こり。それは木でできていた。それ"}, {"type": "subtitle", "time": 16991.19, "timestamp": "04:43:11", "text": "裸だった。すべてが壊れていた"}, {"type": "subtitle", "time": 16994.43, "timestamp": "04:43:14", "text": "そして私は気分が悪くなった。そして私は配置し始めました"}, {"type": "subtitle", "time": 16997.91, "timestamp": "04:43:17", "text": "すべて。何てことだ。"}, {"type": "subtitle", "time": 17000.868, "timestamp": "04:43:20", "text": "私が薬をどこに置いたか覚えていますか？による"}, {"type": "subtitle", "time": 17004.948, "timestamp": "04:43:24", "text": "そういうわけで、私たちには柱があった。"}, {"type": "subtitle", "time": 17008.23, "timestamp": "04:43:28", "text": "我々は時間のように配置すべきだ"}, {"type": "subtitle", "time": 17010.23, "timestamp": "04:43:30", "text": "旗のような配置マーカーまたは"}, {"type": "subtitle", "time": 17012.39, "timestamp": "04:43:32", "text": "何かの改造か何か。尋ねてもいいですよ。"}, {"type": "subtitle", "time": 17016.39, "timestamp": "04:43:36", "text": "私は、いくつのモッドを使うのかと尋ねました。"}, {"type": "subtitle", "time": 17020.628, "timestamp": "04:43:40", "text": "尋ねるために？サーバーに影響します"}, {"type": "subtitle", "time": 17036.708, "timestamp": "04:43:56", "text": "弾むような、弾むような音、そう、"}]
[{"type": "subtitle", "time": 2736.79, "timestamp": "00:45:36", "text": "私は本当に深夜まで夜遊びしたい"}, {"type": "subtitle", "time": 2740.67, "timestamp": "00:45:40", "text": "コケみたいな歌"}, {"type": "subtitle", "time": 2743.91, "timestamp": "00:45:43", "text": "何か、だって私は知らないと思うから"}, {"type": "subtitle", "time": 2747.589, "timestamp": "00:45:47", "text": "歌は上手だけど、私も歌ってみたい。私"}, {"type": "subtitle", "time": 2749.15, "timestamp": "00:45:49", "text": "学びたい"}]
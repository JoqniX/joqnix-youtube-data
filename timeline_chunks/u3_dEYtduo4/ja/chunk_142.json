[{"type": "subtitle", "time": 8521.17, "timestamp": "02:22:01", "text": "歌う前にそれを覚えなければならなかった"}, {"type": "subtitle", "time": 8531.15, "timestamp": "02:22:11", "text": "純粋に"}, {"type": "subtitle", "time": 8534.389, "timestamp": "02:22:14", "text": "おもちゃで遊ぶことだけを満足する"}, {"type": "subtitle", "time": 8536.63, "timestamp": "02:22:16", "text": "一緒に。"}, {"type": "subtitle", "time": 8541.11, "timestamp": "02:22:21", "text": "ベイビー、私は何千もの思い出を形作ってきた"}, {"type": "subtitle", "time": 8543.23, "timestamp": "02:22:23", "text": "の"}, {"type": "subtitle", "time": 8545.23, "timestamp": "02:22:25", "text": "[音楽]"}, {"type": "subtitle", "time": 8547.52, "timestamp": "02:22:27", "text": "あなた。ああ、それは"}, {"type": "subtitle", "time": 8555.79, "timestamp": "02:22:35", "text": "[音楽]"}]
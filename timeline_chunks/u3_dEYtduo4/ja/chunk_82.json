[{"type": "subtitle", "time": 4927.59, "timestamp": "01:22:07", "text": "あ、待って。あ、ああ、今気づいたんだけど"}, {"type": "subtitle", "time": 4928.91, "timestamp": "01:22:08", "text": "持ってこなかった"}, {"type": "subtitle", "time": 4932.39, "timestamp": "01:22:12", "text": "ああ、そのシーンはまだ設定していません。"}, {"type": "subtitle", "time": 4936.55, "timestamp": "01:22:16", "text": "あ、待って。ああ、ああ、ああ、ああ、ああ。なんてこった。"}, {"type": "subtitle", "time": 4938.11, "timestamp": "01:22:18", "text": "[音楽]"}, {"type": "subtitle", "time": 4941.55, "timestamp": "01:22:21", "text": "ええと、ここにはありません。ああ、神様。おお"}, {"type": "subtitle", "time": 4946.11, "timestamp": "01:22:26", "text": "いいえ。私のOBSはラグを起こすかもしれないが、私は"}, {"type": "subtitle", "time": 4948.95, "timestamp": "01:22:28", "text": "他のシーンにあるのを忘れていました"}, {"type": "subtitle", "time": 4953.629, "timestamp": "01:22:33", "text": "コレクション。ああ、もし私がそれを開けたら"}, {"type": "subtitle", "time": 4957.189, "timestamp": "01:22:37", "text": "上へ移動しても、OBS 全体が壊れることはありません。それ"}, {"type": "subtitle", "time": 4958.79, "timestamp": "01:22:38", "text": "墜落した。もし墜落したら、"}, {"type": "subtitle", "time": 4960.229, "timestamp": "01:22:40", "text": "配信を再開します。はい、いいえ"}]
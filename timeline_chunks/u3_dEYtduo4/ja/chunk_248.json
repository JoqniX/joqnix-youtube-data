[{"type": "subtitle", "time": 14885.91, "timestamp": "04:08:05", "text": "Sh。バックパックはどのように使えばいいのでしょうか？した"}, {"type": "subtitle", "time": 14889.269, "timestamp": "04:08:09", "text": "えっと、鳥のやつ手に入れた？いいえ、鳥"}, {"type": "subtitle", "time": 14891.349, "timestamp": "04:08:11", "text": "1つは互換性がなかったが、"}, {"type": "subtitle", "time": 14895.03, "timestamp": "04:08:15", "text": "墓。おお、いいね。使い方"}, {"type": "subtitle", "time": 14898.51, "timestamp": "04:08:18", "text": "バックパックは使う？ああ、私は"}, {"type": "subtitle", "time": 14901.59, "timestamp": "04:08:21", "text": "Bを使うように。これは一体何ですか？ありがとう、"}, {"type": "subtitle", "time": 14904.55, "timestamp": "04:08:24", "text": "ヴァゲラ。えっと、水とか色々加えることができます"}, {"type": "subtitle", "time": 14908.71, "timestamp": "04:08:28", "text": "その中に。何てことだ。何てことだ。これはあなたです"}, {"type": "subtitle", "time": 14912.91, "timestamp": "04:08:32", "text": "水を貯蔵できる。保存できます。"}, {"type": "subtitle", "time": 14918.79, "timestamp": "04:08:38", "text": "えっと、水か溶岩か牛乳。そうだな、"}, {"type": "subtitle", "time": 14921.83, "timestamp": "04:08:41", "text": "今日で私の人生は完璧になった。私はしたい"}, {"type": "subtitle", "time": 14924.55, "timestamp": "04:08:44", "text": "幸せな気持ちで死にたい。いいえ、私はしません"}, {"type": "subtitle", "time": 14926.469, "timestamp": "04:08:46", "text": "死にたい。十分な"}, {"type": "subtitle", "time": 14933.429, "timestamp": "04:08:53", "text": "わかった。わかった。えーと、その頃には、えーと、"}, {"type": "subtitle", "time": 14936.07, "timestamp": "04:08:56", "text": "また戻ってきたら、物を送ります。"}, {"type": "subtitle", "time": 14939.75, "timestamp": "04:08:59", "text": "わかった。こんにちは。"}]
[{"type": "subtitle", "time": 22740.07, "timestamp": "06:19:00", "text": "くそ、このバックパック、すごくいいよ。"}, {"type": "subtitle", "time": 22751.11, "timestamp": "06:19:11", "text": "ホースの使い方は？お前は物をしゃぶれるんだな。"}, {"type": "subtitle", "time": 22753.15, "timestamp": "06:19:13", "text": "ああ、"}, {"type": "subtitle", "time": 22756.47, "timestamp": "06:19:16", "text": "神。右を押してタンクを投稿します"}, {"type": "subtitle", "time": 22759.35, "timestamp": "06:19:19", "text": "ねずみ。わかった。バスとはホースのことである。私はとても"}, {"type": "subtitle", "time": 22762.548, "timestamp": "06:19:22", "text": "ごめんね、ジョー。ポールダンスエリアを壊してしまいました。"}, {"type": "subtitle", "time": 22772.23, "timestamp": "06:19:32", "text": "ああ、助かった。ああ、助かった。もう一度作ってください。いいえ、"}, {"type": "subtitle", "time": 22774.868, "timestamp": "06:19:34", "text": "二度と作らないで。うん。作らせてください"}, {"type": "subtitle", "time": 22778.23, "timestamp": "06:19:38", "text": "またそれだ。いいえ。"}, {"type": "subtitle", "time": 22780.39, "timestamp": "06:19:40", "text": "いいえ。いいえ。いいえ。ジョーク。ジョーク。ジョークが欲しい"}, {"type": "subtitle", "time": 22782.948, "timestamp": "06:19:42", "text": "あなたに持たせる。彼が何をしているのかわからない"}, {"type": "subtitle", "time": 22785.99, "timestamp": "06:19:45", "text": "話している。時計の使い方。どうやって"}, {"type": "subtitle", "time": 22788.628, "timestamp": "06:19:48", "text": "時計を使う。あなたは知っていますか？置くだけ"}, {"type": "subtitle", "time": 22795.59, "timestamp": "06:19:55", "text": "真剣に、あなたは"}, {"type": "subtitle", "time": 22798.31, "timestamp": "06:19:58", "text": "わからない。私は「わからない」という感じでした"}]
[{"type": "subtitle", "time": 4447.11, "timestamp": "01:14:07", "text": "何だって？みんな、傷は気にしないで。"}, {"type": "subtitle", "time": 4449.07, "timestamp": "01:14:09", "text": "気にしないで"}, {"type": "subtitle", "time": 4451.75, "timestamp": "01:14:11", "text": "擦り傷。抱きしめる。うん。これは"}, {"type": "subtitle", "time": 4453.59, "timestamp": "01:14:13", "text": "ファンの視線。そして、これらが３つです"}, {"type": "subtitle", "time": 4455.149, "timestamp": "01:14:15", "text": "刃。"}, {"type": "subtitle", "time": 4464.11, "timestamp": "01:14:24", "text": "だから、最悪だ。私"}, {"type": "subtitle", "time": 4483.91, "timestamp": "01:14:43", "text": "カ。これは現在壊れている2060です"}, {"type": "subtitle", "time": 4486.95, "timestamp": "01:14:46", "text": "粉々に砕け散り、その間には塵が舞っている。"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "2060年の写真を見たいですか？"}, {"type": "subtitle", "time": 4492.95, "timestamp": "01:14:52", "text": "ベンディショップに持っていく前に、"}, {"type": "subtitle", "time": 4494.95, "timestamp": "01:14:54", "text": "ファンが壊れたとき、または"}, {"type": "subtitle", "time": 4497.189, "timestamp": "01:14:57", "text": "何か？覚えていない。でも、そうですね、"}]
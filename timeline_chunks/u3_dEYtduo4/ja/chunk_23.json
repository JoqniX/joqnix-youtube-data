[{"type": "subtitle", "time": 1383.11, "timestamp": "00:23:03", "text": "割引価格で提供されました。そのため、私は"}, {"type": "subtitle", "time": 1385.27, "timestamp": "00:23:05", "text": "開発者か何かに頼まなければならなかった"}, {"type": "subtitle", "time": 1388.549, "timestamp": "00:23:08", "text": "これを自動的にやらせてください"}, {"type": "subtitle", "time": 1391.11, "timestamp": "00:23:11", "text": "ユーザーが YouTube メンバーか"}, {"type": "subtitle", "time": 1394.47, "timestamp": "00:23:14", "text": "Twitchメンバーまたはサブスクライバーであれば"}, {"type": "subtitle", "time": 1398.07, "timestamp": "00:23:18", "text": "チェックアウト時にこのような価格を自動的に追加します"}, {"type": "subtitle", "time": 1400.149, "timestamp": "00:23:20", "text": "あるいは、そんな感じ。そのためには、"}, {"type": "subtitle", "time": 1402.43, "timestamp": "00:23:22", "text": "YouTubeやTwitchのように"}, {"type": "subtitle", "time": 1405.909, "timestamp": "00:23:25", "text": "アカウント。自分で何か作らなきゃいけない"}, {"type": "subtitle", "time": 1407.83, "timestamp": "00:23:27", "text": "独自のアカウントプラットフォームのように、"}, {"type": "subtitle", "time": 1411.19, "timestamp": "00:23:31", "text": "何か。ああ、それはカスタム品だ"}, {"type": "subtitle", "time": 1413.19, "timestamp": "00:23:33", "text": "欲しい。接続できるもの"}, {"type": "subtitle", "time": 1415.27, "timestamp": "00:23:35", "text": "Discordや他のプラットフォームも同様です。"}, {"type": "subtitle", "time": 1417.59, "timestamp": "00:23:37", "text": "Twitterとか、そういうの。何でも読めます"}, {"type": "subtitle", "time": 1419.99, "timestamp": "00:23:39", "text": "私へのツイートやライブチャット"}, {"type": "subtitle", "time": 1422.47, "timestamp": "00:23:42", "text": "コメントも含め全て。 XPを獲得できます"}, {"type": "subtitle", "time": 1427.11, "timestamp": "00:23:47", "text": "そして、無料で何かを受け取るようなもの"}, {"type": "subtitle", "time": 1429.75, "timestamp": "00:23:49", "text": "ええと、そのインセンティブ制度は役に立ちます。"}, {"type": "subtitle", "time": 1432.149, "timestamp": "00:23:52", "text": "いいえ、それはゲームか何かだと思います"}, {"type": "subtitle", "time": 1433.83, "timestamp": "00:23:53", "text": "何か。わからない。それは"}, {"type": "subtitle", "time": 1435.75, "timestamp": "00:23:55", "text": "やりたいことはあるけど、やらない"}]
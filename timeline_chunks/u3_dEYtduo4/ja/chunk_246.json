[{"type": "subtitle", "time": 14767.91, "timestamp": "04:06:07", "text": "あ、待って。まだ準備していません。"}, {"type": "subtitle", "time": 14769.91, "timestamp": "04:06:09", "text": "鈴木さんのところへ送ってあげましょうか？"}, {"type": "subtitle", "time": 14772.79, "timestamp": "04:06:12", "text": "はい。"}, {"type": "subtitle", "time": 14780.389, "timestamp": "04:06:20", "text": "あ、こんにちは。こんにちは。こんにちは、ジョー。どうやって来たの？"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "ここ？ああ、アストラ・ミー。ああ、あなたは作ったの？"}, {"type": "subtitle", "time": 14787.11, "timestamp": "04:06:27", "text": "これを全部一人でやるの？何てことだ。うん、"}, {"type": "subtitle", "time": 14790.389, "timestamp": "04:06:30", "text": "全てを失った後、私は"}, {"type": "subtitle", "time": 14793.03, "timestamp": "04:06:33", "text": "思いついた。これは最高とは言えない"}, {"type": "subtitle", "time": 14798.389, "timestamp": "04:06:38", "text": "これまでで最高のデザイン。それは構成要素です。 H."}, {"type": "subtitle", "time": 14800.95, "timestamp": "04:06:40", "text": "わかった。ニース。"}, {"type": "subtitle", "time": 14805.11, "timestamp": "04:06:45", "text": "ああ、すべてが変わってしまった。ええ、そうはならないでしょう"}, {"type": "subtitle", "time": 14807.99, "timestamp": "04:06:47", "text": "遅れ。メールボックスを追加しました。これであなたは"}, {"type": "subtitle", "time": 14810.15, "timestamp": "04:06:50", "text": "たとえあなたが"}, {"type": "subtitle", "time": 14813.67, "timestamp": "04:06:53", "text": "離れて。私は鈴木にリュックサックを渡しました。"}, {"type": "subtitle", "time": 14815.59, "timestamp": "04:06:55", "text": "ああ、それから私は2つのスタックを与えました"}, {"type": "subtitle", "time": 14818.15, "timestamp": "04:06:58", "text": "ダイヤモンドと鉄のスタック1つ"}]
[{"type": "subtitle", "time": 421.189, "timestamp": "00:07:01", "text": "28日午前9時。よし、次の配信だ。"}, {"type": "subtitle", "time": 424.07, "timestamp": "00:07:04", "text": "今は投稿する必要がないことを覚えておいてください"}, {"type": "subtitle", "time": 427.27, "timestamp": "00:07:07", "text": "チャット内のリンク。それは本当に便利だよ。"}, {"type": "subtitle", "time": 430.55, "timestamp": "00:07:10", "text": "準備万端にしておくことができます。これは"}, {"type": "subtitle", "time": 436.51, "timestamp": "00:07:16", "text": "ハンディ。"}, {"type": "subtitle", "time": 440.43, "timestamp": "00:07:20", "text": "わーい。はい、メンバーシップストリームは、"}, {"type": "subtitle", "time": 443.189, "timestamp": "00:07:23", "text": "上。次の配信は9時からです。"}, {"type": "subtitle", "time": 445.83, "timestamp": "00:07:25", "text": "午前17日目。えっと、私が何をしようとしているかは分かりますよね。"}, {"type": "subtitle", "time": 448.23, "timestamp": "00:07:28", "text": "何をすべきか？この現在のビデオを編集してください"}, {"type": "subtitle", "time": 450.909, "timestamp": "00:07:30", "text": "現在のストリーム"}, {"type": "subtitle", "time": 454.11, "timestamp": "00:07:34", "text": "そして置いた"}, {"type": "subtitle", "time": 464.51, "timestamp": "00:07:44", "text": "リダイレクト先"}, {"type": "subtitle", "time": 466.029, "timestamp": "00:07:46", "text": "リダイレクトされました"}, {"type": "subtitle", "time": 470.87, "timestamp": "00:07:50", "text": "カスタマイズのリダイレクト70日目"}, {"type": "subtitle", "time": 473.71, "timestamp": "00:07:53", "text": "ストリーム。わーい。だから夜と"}, {"type": "subtitle", "time": 476.869, "timestamp": "00:07:56", "text": "この日、70番目のストリームが現れるだろう。"}, {"type": "subtitle", "time": 479.55, "timestamp": "00:07:59", "text": "わーい。それはまさに"}]
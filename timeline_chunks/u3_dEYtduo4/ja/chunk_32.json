[{"type": "subtitle", "time": 1923.43, "timestamp": "00:32:03", "text": "いいえ。Wを上げて。"}, {"type": "subtitle", "time": 1925.389, "timestamp": "00:32:05", "text": "乗った"}, {"type": "subtitle", "time": 1928.149, "timestamp": "00:32:08", "text": "地図？よし、みんな。より多くのアイテム"}, {"type": "subtitle", "time": 1931.35, "timestamp": "00:32:11", "text": "あなたが一番よく話してくれるもの。最も。"}, {"type": "subtitle", "time": 1933.75, "timestamp": "00:32:13", "text": "なんてこった。私は自分が何をしたのか覚えていない"}, {"type": "subtitle", "time": 1936.47, "timestamp": "00:32:16", "text": "今日。つまり、私は見てきましたが、私は"}, {"type": "subtitle", "time": 1939.789, "timestamp": "00:32:19", "text": "おそらくもっと価値があるのを見た"}, {"type": "subtitle", "time": 1942.59, "timestamp": "00:32:22", "text": "私がやったことよりも"}, {"type": "subtitle", "time": 1955.87, "timestamp": "00:32:35", "text": "えっと、私は2倍に"}, {"type": "subtitle", "time": 1957.47, "timestamp": "00:32:37", "text": "スペクト"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "また。警告を与えたら"}, {"type": "subtitle", "time": 1979.35, "timestamp": "00:32:59", "text": "自動販売機 ええ、大丈夫です。何てことだ。"}]
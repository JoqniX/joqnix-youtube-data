[{"type": "subtitle", "time": 6362.109, "timestamp": "01:46:02", "text": "ええ、そうです"}, {"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "これで終わりだと思う。"}, {"type": "subtitle", "time": 6371.149, "timestamp": "01:46:11", "text": "この男は"}, {"type": "subtitle", "time": 6375.99, "timestamp": "01:46:15", "text": "どこかで。私はそれをしたいですか？"}, {"type": "subtitle", "time": 6377.79, "timestamp": "01:46:17", "text": "このような"}, {"type": "subtitle", "time": 6381.709, "timestamp": "01:46:21", "text": "多分？読みたいですか"}, {"type": "subtitle", "time": 6384.149, "timestamp": "01:46:24", "text": "歌詞？歌詞を読みたいですか、"}, {"type": "subtitle", "time": 6391.149, "timestamp": "01:46:31", "text": "えっと"}, {"type": "subtitle", "time": 6394.149, "timestamp": "01:46:34", "text": "歌詞？いいえ、何もありません。わかった、"}, {"type": "subtitle", "time": 6396.07, "timestamp": "01:46:36", "text": "待って。必ず手に入れる。私は手に入れるつもりです"}, {"type": "subtitle", "time": 6409.709, "timestamp": "01:46:49", "text": "[音楽]"}, {"type": "subtitle", "time": 6412.59, "timestamp": "01:46:52", "text": "女の子。どうして？あ、待って。いいえ、"}, {"type": "subtitle", "time": 6415.149, "timestamp": "01:46:55", "text": "待って。はい、どうぞ"}, {"type": "subtitle", "time": 6417.91, "timestamp": "01:46:57", "text": "行く。ロマの人々はどこにいるのか？私はインストールしました"}]
[{"type": "subtitle", "time": 19860.11, "timestamp": "05:31:00", "text": "私は手に入れた"}, {"type": "subtitle", "time": 19870.11, "timestamp": "05:31:10", "text": "[音楽]"}, {"type": "subtitle", "time": 19872.59, "timestamp": "05:31:12", "text": "で。"}, {"type": "subtitle", "time": 19880.43, "timestamp": "05:31:20", "text": "わかった。わーい。"}, {"type": "subtitle", "time": 19883.91, "timestamp": "05:31:23", "text": "ハルラ。うん。あなたは何が必要ですか？"}, {"type": "subtitle", "time": 19886.99, "timestamp": "05:31:26", "text": "ああ、しまった、忘れてた。"}, {"type": "subtitle", "time": 19890.948, "timestamp": "05:31:30", "text": "えっと、私のダイヤモンドの鍬が見当たらない。それ"}, {"type": "subtitle", "time": 19900.31, "timestamp": "05:31:40", "text": "穴。なぜダイヤモンドをつけているのですか？待って、君"}, {"type": "subtitle", "time": 19902.47, "timestamp": "05:31:42", "text": "ダイヤモンドを穴の大きさで判断しない？あ、待って。"}, {"type": "subtitle", "time": 19907.19, "timestamp": "05:31:47", "text": "これは誰のことではありませんか?"}, {"type": "subtitle", "time": 19909.67, "timestamp": "05:31:49", "text": "待って、誰が殺してるの？誰が殺しているんだ？"}, {"type": "subtitle", "time": 19912.31, "timestamp": "05:31:52", "text": "待って、誰が死ぬの？"}, {"type": "subtitle", "time": 19914.31, "timestamp": "05:31:54", "text": "そこには群衆がいた。暴徒がいる"}]
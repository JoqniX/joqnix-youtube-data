[{"type": "subtitle", "time": 5521.31, "timestamp": "01:32:01", "text": "すべての親指。 Vがあります"}, {"type": "subtitle", "time": 5523.91, "timestamp": "01:32:03", "text": "映像。あなたは自分の配信を持っています。ミツキ"}, {"type": "subtitle", "time": 5526.79, "timestamp": "01:32:06", "text": "彼女は配信用のグッズを持っている。 Vフットがあります"}, {"type": "subtitle", "time": 5528.95, "timestamp": "01:32:08", "text": "映像。私たちはすべてを取り戻します"}, {"type": "subtitle", "time": 5532.31, "timestamp": "01:32:12", "text": "失われた。ディオ、あまり心配しなくていいよ。恥"}, {"type": "subtitle", "time": 5534.99, "timestamp": "01:32:14", "text": "私と一緒に。昨日私は"}, {"type": "subtitle", "time": 5537.51, "timestamp": "01:32:17", "text": "理由。だから私は彼らに戻ってきてと頼むことができる"}, {"type": "subtitle", "time": 5545.91, "timestamp": "01:32:25", "text": "ディオ、私はシングルを一つも見逃すつもりはない"}, {"type": "subtitle", "time": 5549.11, "timestamp": "01:32:29", "text": "アイテム。マジでディオだよ。なぜ私は"}, {"type": "subtitle", "time": 5552.55, "timestamp": "01:32:32", "text": "ディオのことを言い過ぎ？"}, {"type": "subtitle", "time": 5554.79, "timestamp": "01:32:34", "text": "隅々まで調べて"}, {"type": "subtitle", "time": 5556.709, "timestamp": "01:32:36", "text": "私のインベントリの隅と私が"}, {"type": "subtitle", "time": 5558.99, "timestamp": "01:32:38", "text": "持っていなかった"}, {"type": "subtitle", "time": 5562.709, "timestamp": "01:32:42", "text": "パーツは持っているけど、私の"}, {"type": "subtitle", "time": 5564.189, "timestamp": "01:32:44", "text": "胸"}, {"type": "subtitle", "time": 5566.39, "timestamp": "01:32:46", "text": "私たちがクロスチになるために必要なものすべて"}, {"type": "subtitle", "time": 5568.41, "timestamp": "01:32:48", "text": "今日時計をチェックする"}]
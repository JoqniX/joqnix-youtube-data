[{"type": "subtitle", "time": 16442.349, "timestamp": "04:34:02", "text": "ブロック。ウォーターブロック。"}, {"type": "subtitle", "time": 16445.67, "timestamp": "04:34:05", "text": "うわぁ。つまり、時間が止まったのか、それとも時間が止まったのか"}, {"type": "subtitle", "time": 16454.429, "timestamp": "04:34:14", "text": "伝承？でも彼は直したと思う"}, {"type": "subtitle", "time": 16458.15, "timestamp": "04:34:18", "text": "それ。アストラは物事を変えたかった"}, {"type": "subtitle", "time": 16466.629, "timestamp": "04:34:26", "text": "何？何？何？アストラは変わりたかった"}, {"type": "subtitle", "time": 16468.551, "timestamp": "04:34:28", "text": "現在のストーリーのような伝承または"}, {"type": "subtitle", "time": 16470.269, "timestamp": "04:34:30", "text": "何か。彼が思うようには進んでいない"}, {"type": "subtitle", "time": 16474.15, "timestamp": "04:34:34", "text": "人々が虐待したりすることを望んでいた。"}, {"type": "subtitle", "time": 16476.39, "timestamp": "04:34:36", "text": "人々は何だって？"}, {"type": "subtitle", "time": 16491.429, "timestamp": "04:34:51", "text": "ジャガイモ。ところで、"}, {"type": "subtitle", "time": 16495.59, "timestamp": "04:34:55", "text": "両方の作物を同じ列に植える。小麦を入れる"}, {"type": "subtitle", "time": 16498.869, "timestamp": "04:34:58", "text": "作物を1列に植えると、ジャガイモの作物ができます。"}]
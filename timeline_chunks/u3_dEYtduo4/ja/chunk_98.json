[{"type": "subtitle", "time": 5884.39, "timestamp": "01:38:04", "text": "私のあのクロみたいなやつはどこに置いたっけ？待って、"}, {"type": "subtitle", "time": 5888.109, "timestamp": "01:38:08", "text": "私はそれを誰かに送ったのだろうか？私"}, {"type": "subtitle", "time": 5894.109, "timestamp": "01:38:14", "text": "忘れた。次に、ユニークな話題について話しましょう。拒否"}, {"type": "subtitle", "time": 5898.59, "timestamp": "01:38:18", "text": "資産。何てことだ。どこ"}, {"type": "subtitle", "time": 5901.91, "timestamp": "01:38:21", "text": "それ？どこ？ああ、私の資産だ。いや、マイクじゃない。"}, {"type": "subtitle", "time": 5910.79, "timestamp": "01:38:30", "text": "えっと、Dはどこにあるんですか？見つかりません。私は"}, {"type": "subtitle", "time": 5912.79, "timestamp": "01:38:32", "text": "Sジャンパーは使用していません。辞めるつもりです"}, {"type": "subtitle", "time": 5915.189, "timestamp": "01:38:35", "text": "そして、また演奏します。ああ、諦めないで。なぜ"}, {"type": "subtitle", "time": 5918.709, "timestamp": "01:38:38", "text": "辞めるんですか？来て。彼は手に入れている"}, {"type": "subtitle", "time": 5920.99, "timestamp": "01:38:40", "text": "あなたのサーバーで。いいえ、"}, {"type": "subtitle", "time": 5922.59, "timestamp": "01:38:42", "text": "やめてください。"}, {"type": "subtitle", "time": 5925.87, "timestamp": "01:38:45", "text": "バカ、それは"}, {"type": "chat", "time": 5927.576, "timestamp": "01:38:47", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "but what about my wasted time"}, {"type": "subtitle", "time": 5928.79, "timestamp": "01:38:48", "text": "わかった。良くないことだと分かっているけど、"}, {"type": "chat", "time": 5929.935, "timestamp": "01:38:49", "author": "@SuzukiZurikoVTuber", "avatar": "https://yt4.ggpht.com/852SZLheWUnfQGntgjphW0AD17oXLR9MhuzMLEzOm451wzhCllgmSUMTMpDu7wtBK7HSHR9J=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/7cIfY5niDOmSkNAP08CA6A4"}, {"type": "subtitle", "time": 5932.39, "timestamp": "01:38:52", "text": "今はただのゲームだ。私たちはまだそれを挽くことができる"}, {"type": "subtitle", "time": 5935.87, "timestamp": "01:38:55", "text": "また戻ってきました。私たちは彼らを打ち負かすことができる"}, {"type": "subtitle", "time": 5939.27, "timestamp": "01:38:59", "text": "全て時間の無駄だった。つまりそれは"}]
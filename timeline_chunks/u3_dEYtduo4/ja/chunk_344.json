[{"type": "subtitle", "time": 20644.23, "timestamp": "05:44:04", "text": "スライド。いい考えがある。ウォータースライダー。それ"}, {"type": "subtitle", "time": 20646.708, "timestamp": "05:44:06", "text": "全てを壊してしまうかもしれない。"}, {"type": "subtitle", "time": 20649.67, "timestamp": "05:44:09", "text": "いいえ、壊れません。わかった。そうですね、"}, {"type": "subtitle", "time": 20653.27, "timestamp": "05:44:13", "text": "ミツキー、君のために良い鎧を作ってあげるよ"}, {"type": "subtitle", "time": 20657.11, "timestamp": "05:44:17", "text": "そうすれば、いつでも安全が確保されます。"}, {"type": "subtitle", "time": 20660.948, "timestamp": "05:44:20", "text": "ああ、大丈夫ですよ。私はできる 私はしない 私はしない する"}, {"type": "subtitle", "time": 20663.75, "timestamp": "05:44:23", "text": "あなたはそれをしたいですか？したいですか"}, {"type": "subtitle", "time": 20667.11, "timestamp": "05:44:27", "text": "自分でやりたいですか、それとも"}, {"type": "subtitle", "time": 20670.31, "timestamp": "05:44:30", "text": "私はただ皆さんに見せてほしいだけです"}, {"type": "subtitle", "time": 20672.628, "timestamp": "05:44:32", "text": "私が採掘できる場所は"}, {"type": "subtitle", "time": 20675.43, "timestamp": "05:44:35", "text": "どこで採掘すればいいのか全く分かりません。"}, {"type": "subtitle", "time": 20680.19, "timestamp": "05:44:40", "text": "鉱業。ええと、でも今すぐ装備が必要です。"}, {"type": "subtitle", "time": 20698.11, "timestamp": "05:44:58", "text": "ああ、わかった。ベール、"}]
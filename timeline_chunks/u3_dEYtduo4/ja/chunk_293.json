[{"type": "subtitle", "time": 17581.948, "timestamp": "04:53:01", "text": "これ。待って、私たちの"}, {"type": "subtitle", "time": 17585.43, "timestamp": "04:53:05", "text": "ベース？なんてこった。"}, {"type": "subtitle", "time": 17588.07, "timestamp": "04:53:08", "text": "設定方法は…待って、地図は取得できません"}, {"type": "subtitle", "time": 17590.07, "timestamp": "04:53:10", "text": "機能ですよね？"}, {"type": "subtitle", "time": 17604.83, "timestamp": "04:53:24", "text": "でも、地図は手に入らないのかな？"}, {"type": "subtitle", "time": 17608.55, "timestamp": "04:53:28", "text": "あれ？ミニミニミニマップ？"}, {"type": "subtitle", "time": 17613.01, "timestamp": "04:53:33", "text": "いいえ、それは非常に強力なMODです。"}, {"type": "subtitle", "time": 17615.19, "timestamp": "04:53:35", "text": "[音楽]"}, {"type": "subtitle", "time": 17618.18, "timestamp": "04:53:38", "text": "実際、誰もがそれに反対している。"}, {"type": "subtitle", "time": 17631.47, "timestamp": "04:53:51", "text": "はい、それではログアウトします。最後の"}, {"type": "subtitle", "time": 17634.15, "timestamp": "04:53:54", "text": "言葉？私が使ったもの全てを必ず使ってください"}, {"type": "subtitle", "time": 17637.19, "timestamp": "04:53:57", "text": "準備しました。あ、待ってください。忘れてしまった"}]
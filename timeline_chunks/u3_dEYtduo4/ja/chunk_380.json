[{"type": "subtitle", "time": 22800.868, "timestamp": "06:20:00", "text": "誰が言ったのか、誰がやりたいのか"}, {"type": "subtitle", "time": 22808.868, "timestamp": "06:20:08", "text": "ポールダンスは"}, {"type": "subtitle", "time": 22811.51, "timestamp": "06:20:11", "text": "消防士の人たちのことだよ。"}, {"type": "subtitle", "time": 22815.11, "timestamp": "06:20:15", "text": "いいえ、彼らは飛び降りて、"}, {"type": "subtitle", "time": 22817.51, "timestamp": "06:20:17", "text": "棒を滑らせる、ですよね？私はそう思った"}, {"type": "subtitle", "time": 22820.628, "timestamp": "06:20:20", "text": "現実世界のアクロパシー療法士みたいな感じ。それから"}, {"type": "subtitle", "time": 22823.43, "timestamp": "06:20:23", "text": "これらは停止します。やめろ。君が知ってることは分かってるよ"}, {"type": "subtitle", "time": 22827.59, "timestamp": "06:20:27", "text": "どういう意味ですか。仕事。どういう意味ですか？"}, {"type": "subtitle", "time": 22830.31, "timestamp": "06:20:30", "text": "あなたは嘘をついています。ディオ。"}, {"type": "subtitle", "time": 22833.11, "timestamp": "06:20:33", "text": "嘘をついている。何？ディオ。"}, {"type": "subtitle", "time": 22834.788, "timestamp": "06:20:34", "text": "あなたはやりたくないと嘘をついている"}, {"type": "subtitle", "time": 22838.23, "timestamp": "06:20:38", "text": "ポールダンス。 D. どういう意味ですか？私"}, {"type": "subtitle", "time": 22840.31, "timestamp": "06:20:40", "text": "ポールダンスをやりたいのは分かってるよ。私"}]
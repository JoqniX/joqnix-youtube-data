[{"type": "subtitle", "time": 19921.15, "timestamp": "05:32:01", "text": "えっと、私は"}, {"type": "subtitle", "time": 19923.83, "timestamp": "05:32:03", "text": "プレイしていなかったので、"}, {"type": "subtitle", "time": 19927.27, "timestamp": "05:32:07", "text": "正直に言うと、あなたは才能があります。"}, {"type": "subtitle", "time": 19929.11, "timestamp": "05:32:09", "text": "けれど。かっこいいものが見つからなかった"}, {"type": "subtitle", "time": 19931.75, "timestamp": "05:32:11", "text": "そもそも使うために。ええ、私は"}, {"type": "subtitle", "time": 19940.51, "timestamp": "05:32:20", "text": "[音楽]"}, {"type": "subtitle", "time": 19944.15, "timestamp": "05:32:24", "text": "鎧。私にさせて"}, {"type": "subtitle", "time": 19944.59, "timestamp": "05:32:24", "text": "シャット"}, {"type": "subtitle", "time": 19950.27, "timestamp": "05:32:30", "text": "[音楽]"}, {"type": "subtitle", "time": 19954.43, "timestamp": "05:32:34", "text": "上。えっと、私はあなたに"}, {"type": "subtitle", "time": 19957.03, "timestamp": "05:32:37", "text": "家。どれだけ多くの犠牲者が出ようとも、私は死なない"}, {"type": "subtitle", "time": 19958.948, "timestamp": "05:32:38", "text": "私を殺せる時もある。あなたを知りませんでした"}, {"type": "subtitle", "time": 19961.27, "timestamp": "05:32:41", "text": "お金を使ってダイヤモンドを作らない"}, {"type": "subtitle", "time": 19964.548, "timestamp": "05:32:44", "text": "ほ。どれくらいお金を使うのか分からない"}, {"type": "subtitle", "time": 19971.75, "timestamp": "05:32:51", "text": "何？そしてDiscordのアップデートは本当に"}, {"type": "subtitle", "time": 19974.628, "timestamp": "05:32:54", "text": "良い。私はそれが好きです。彼らは配置を変えた"}]
[{"type": "subtitle", "time": 5700.51, "timestamp": "01:35:00", "text": "えーとメカジキとか"}, {"type": "subtitle", "time": 5702.189, "timestamp": "01:35:02", "text": "えっと"}, {"type": "subtitle", "time": 5706.709, "timestamp": "01:35:06", "text": "えーとソードフィッシュと、えーとハズもそこにいたんだけど、"}, {"type": "subtitle", "time": 5708.11, "timestamp": "01:35:08", "text": "右？"}, {"type": "subtitle", "time": 5710.55, "timestamp": "01:35:10", "text": "うん。あなたはどのようにしてYouTubeと結婚したのですか？いいえ、"}, {"type": "subtitle", "time": 5712.629, "timestamp": "01:35:12", "text": "YouTubeパートナー。 YouTubeに登録しました。私は手に入れた"}, {"type": "subtitle", "time": 5715.87, "timestamp": "01:35:15", "text": "YouTubeパートナープログラムに参加しましょう。そうやって手に入れるんだ"}, {"type": "subtitle", "time": 5718.709, "timestamp": "01:35:18", "text": "収益化とスーパーチャットと"}, {"type": "subtitle", "time": 5720.189, "timestamp": "01:35:20", "text": "会員資格と"}, {"type": "chat", "time": 5721.695, "timestamp": "01:35:21", "author": "@reaper924", "avatar": "https://yt4.ggpht.com/kuklexz7rak_dhdCeZkOUm-bT-btAnIjrCJKSn7JsuLYW0S7Zg39gqkwXDALfCFLVswi94-u4aI=s64-c-k-c0x00ffffff-no-rj", "message": "congrats"}, {"type": "subtitle", "time": 5722.709, "timestamp": "01:35:22", "text": "もの。それはYouTubeの"}, {"type": "subtitle", "time": 5723.79, "timestamp": "01:35:23", "text": "パートナー"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "プログラムではなく、もう一方のパートナーのマディ"}, {"type": "subtitle", "time": 5728.91, "timestamp": "01:35:28", "text": "あれ。いいえ、"}, {"type": "chat", "time": 5729.662, "timestamp": "01:35:29", "author": "@natsukisouta", "avatar": "https://yt4.ggpht.com/DoWHfl2un-x9C1FjOZkls_H2TTeAipp9__JetXpYAJhuduFn6-Pn9_VXt5jORITV_b2weavr=s64-c-k-c0x00ffffff-no-rj", "message": "CONGRATSSSSS JOQQQQ"}, {"type": "subtitle", "time": 5731.83, "timestamp": "01:35:31", "text": "ダミー。ありがとう、リーパー。そしてまた、"}, {"type": "chat", "time": 5732.067, "timestamp": "01:35:32", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Natsukiii Ch.~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 5733.149, "timestamp": "01:35:33", "text": "ようこそ"}, {"type": "subtitle", "time": 5735.83, "timestamp": "01:35:35", "text": "ストリーム。良い。こんばんは。良くない"}, {"type": "subtitle", "time": 5737.47, "timestamp": "01:35:37", "text": "午後。すみません、"}, {"type": "subtitle", "time": 5742.07, "timestamp": "01:35:42", "text": "遅い。それが鍵だ。こんにちは。ありがとう。"}, {"type": "subtitle", "time": 5743.149, "timestamp": "01:35:43", "text": "良い"}, {"type": "subtitle", "time": 5746.31, "timestamp": "01:35:46", "text": "夕方。おやすみなさいと言おうとしていたところだった。"}, {"type": "subtitle", "time": 5749.709, "timestamp": "01:35:49", "text": "こんばんは、Dさん。"}, {"type": "chat", "time": 5750.464, "timestamp": "01:35:50", "author": "@natsukisouta", "avatar": "https://yt4.ggpht.com/DoWHfl2un-x9C1FjOZkls_H2TTeAipp9__JetXpYAJhuduFn6-Pn9_VXt5jORITV_b2weavr=s64-c-k-c0x00ffffff-no-rj", "message": "good evening x"}, {"type": "subtitle", "time": 5751.14, "timestamp": "01:35:51", "text": "こんにちは。"}, {"type": "subtitle", "time": 5757.189, "timestamp": "01:35:57", "text": "いらっしゃいませ。明日は会員登録の日です"}, {"type": "subtitle", "time": 5759.75, "timestamp": "01:35:59", "text": "午前9時に配信されます。配信は"}]
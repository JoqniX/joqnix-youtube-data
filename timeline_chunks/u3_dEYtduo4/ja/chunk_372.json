[{"type": "subtitle", "time": 22321.35, "timestamp": "06:12:01", "text": "ああ、疲れた。"}, {"type": "subtitle", "time": 22323.91, "timestamp": "06:12:03", "text": "あなたは眠る必要があります。なぜ起きているのですか？"}, {"type": "subtitle", "time": 22326.708, "timestamp": "06:12:06", "text": "もう寝た方がいいよ。そうそう。えっと、"}, {"type": "subtitle", "time": 22328.948, "timestamp": "06:12:08", "text": "寝る。"}, {"type": "subtitle", "time": 22332.788, "timestamp": "06:12:12", "text": "鎌を忘れた。ではない"}, {"type": "subtitle", "time": 22335.948, "timestamp": "06:12:15", "text": "鎌。その血を吐く"}, {"type": "subtitle", "time": 22339.31, "timestamp": "06:12:19", "text": "視力。それは私の"}, {"type": "subtitle", "time": 22342.31, "timestamp": "06:12:22", "text": "個性的。それは私があなたに聞き忘れていたことです"}, {"type": "subtitle", "time": 22349.23, "timestamp": "06:12:29", "text": "元気かい？こんにちは。感謝"}, {"type": "subtitle", "time": 22352.27, "timestamp": "06:12:32", "text": "あなた。うん、睡眠が必要だね"}, {"type": "subtitle", "time": 22355.35, "timestamp": "06:12:35", "text": "3つ。"}, {"type": "subtitle", "time": 22369.67, "timestamp": "06:12:49", "text": "わからない。私は何らかの理由で私は"}, {"type": "subtitle", "time": 22372.39, "timestamp": "06:12:52", "text": "とても元気いっぱいな感じがする。私はそうは思わない"}, {"type": "subtitle", "time": 22375.43, "timestamp": "06:12:55", "text": "私は全く眠くありません。"}, {"type": "subtitle", "time": 22378.948, "timestamp": "06:12:58", "text": "このジュラはいい子だね。"}]
[{"type": "subtitle", "time": 21361.75, "timestamp": "05:56:01", "text": "わかった、わかった。はぁ？終わり。終わり。終わり。"}, {"type": "subtitle", "time": 21363.868, "timestamp": "05:56:03", "text": "終わり。そして"}, {"type": "subtitle", "time": 21372.948, "timestamp": "05:56:12", "text": "今ならできる。わかった。ごめん。うん。しかしそれは"}, {"type": "subtitle", "time": 21375.75, "timestamp": "05:56:15", "text": "一方通行です。つまり、"}, {"type": "subtitle", "time": 21377.39, "timestamp": "05:56:17", "text": "取る"}, {"type": "subtitle", "time": 21388.47, "timestamp": "05:56:28", "text": "だから、迷子にならないように。わかった。うん。あなたは"}, {"type": "subtitle", "time": 21391.51, "timestamp": "05:56:31", "text": "速い。君は今、速くて激しい。"}, {"type": "subtitle", "time": 21397.59, "timestamp": "05:56:37", "text": "神。でもこれは本当に美味しい。何？さあ"}, {"type": "subtitle", "time": 21406.31, "timestamp": "05:56:46", "text": "待って、スラムには何を使うの？"}, {"type": "subtitle", "time": 21409.788, "timestamp": "05:56:49", "text": "あなたは何をコントロールできますか？"}, {"type": "subtitle", "time": 21413.59, "timestamp": "05:56:53", "text": "わかった。また、何が良いですか"}, {"type": "subtitle", "time": 21416.788, "timestamp": "05:56:56", "text": "胸の平面？ええと、看守のスプライトです。持っている"}]
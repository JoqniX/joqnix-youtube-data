[{"type": "subtitle", "time": 19041.708, "timestamp": "05:17:21", "text": "もの。"}, {"type": "subtitle", "time": 19044.868, "timestamp": "05:17:24", "text": "ええ、私のホは私のモレンを失っています"}, {"type": "subtitle", "time": 19047.628, "timestamp": "05:17:27", "text": "あれ。アストラに聞くのを忘れた"}, {"type": "subtitle", "time": 19056.23, "timestamp": "05:17:36", "text": "わかった。だから、私はこれをする必要がある"}, {"type": "subtitle", "time": 19061.31, "timestamp": "05:17:41", "text": "右？"}, {"type": "subtitle", "time": 19065.23, "timestamp": "05:17:45", "text": "星座はブーツを強化する。ない"}]
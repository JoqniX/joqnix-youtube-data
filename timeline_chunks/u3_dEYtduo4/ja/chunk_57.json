[{"type": "subtitle", "time": 3422.549, "timestamp": "00:57:02", "text": "ああ、なんてことだ、めちゃくちゃ動作が重かった。"}, {"type": "subtitle", "time": 3426.51, "timestamp": "00:57:06", "text": "でも、本当に"}, {"type": "subtitle", "time": 3428.589, "timestamp": "00:57:08", "text": "動作が遅い。"}, {"type": "subtitle", "time": 3431.91, "timestamp": "00:57:11", "text": "そう、それが私のゲーム関連グッズの作り方です"}, {"type": "subtitle", "time": 3436.069, "timestamp": "00:57:16", "text": "開始しました。私はAMD Radio HD60を使いました"}, {"type": "subtitle", "time": 3441.03, "timestamp": "00:57:21", "text": "HD 5450 GPU、1GBのVR RAMを搭載。そして"}, {"type": "subtitle", "time": 3443.589, "timestamp": "00:57:23", "text": "そう、それから私は「遊びたい」と思った"}, {"type": "subtitle", "time": 3447.43, "timestamp": "00:57:27", "text": "その他のゲームやその他。ええ、私は"}, {"type": "subtitle", "time": 3451.71, "timestamp": "00:57:31", "text": "そのGPでフォートナイトをプレイする"}, {"type": "subtitle", "time": 3455.17, "timestamp": "00:57:35", "text": "RAM GPU。"}, {"type": "subtitle", "time": 3456.27, "timestamp": "00:57:36", "text": "[音楽]"}, {"type": "subtitle", "time": 3459.03, "timestamp": "00:57:39", "text": "こんにちは。新しいのを買うつもりですか？"}, {"type": "subtitle", "time": 3461.829, "timestamp": "00:57:41", "text": "交換用ですか？いいえ。ええと、おそらく私は"}, {"type": "subtitle", "time": 3464.069, "timestamp": "00:57:44", "text": "代わりにノートパソコンを買うつもりです。"}, {"type": "subtitle", "time": 3465.87, "timestamp": "00:57:45", "text": "旅行中"}, {"type": "subtitle", "time": 3468.19, "timestamp": "00:57:48", "text": "未来。"}, {"type": "subtitle", "time": 3472.43, "timestamp": "00:57:52", "text": "えっと、こんにちは、ピアン。ああ、Pですね。わかりました。わかった。"}, {"type": "subtitle", "time": 3476.15, "timestamp": "00:57:56", "text": "わかった。わかった。あなたは名前を変えましたね。はい、"}]
[{"type": "subtitle", "time": 20760.27, "timestamp": "05:46:00", "text": "これ？"}, {"type": "subtitle", "time": 20763.67, "timestamp": "05:46:03", "text": "はぁ？次。"}, {"type": "subtitle", "time": 20768.15, "timestamp": "05:46:08", "text": "何してるの？ドライブに出かけます。"}, {"type": "subtitle", "time": 20771.35, "timestamp": "05:46:11", "text": "あなたは正しいことをすることができる。"}, {"type": "subtitle", "time": 20773.47, "timestamp": "05:46:13", "text": "私は"}, {"type": "subtitle", "time": 20775.86, "timestamp": "05:46:15", "text": "試しています。私は違います"}, {"type": "subtitle", "time": 20777.868, "timestamp": "05:46:17", "text": "[音楽]"}, {"type": "subtitle", "time": 20781.03, "timestamp": "05:46:21", "text": "もちろん。おお。私たちの家は素敵に見える。これ"}, {"type": "subtitle", "time": 20789.43, "timestamp": "05:46:29", "text": "待って。えっと、アストラ、弾むと思う？"}, {"type": "subtitle", "time": 20792.59, "timestamp": "05:46:32", "text": "ミツキーにとってより良いことだろうか？"}, {"type": "subtitle", "time": 20796.47, "timestamp": "05:46:36", "text": "うん、たくさん落ちるだろうね。はい、弾ませてください"}, {"type": "subtitle", "time": 20798.788, "timestamp": "05:46:38", "text": "は。"}]
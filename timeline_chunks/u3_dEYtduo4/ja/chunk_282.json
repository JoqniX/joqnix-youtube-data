[{"type": "subtitle", "time": 16921.99, "timestamp": "04:42:01", "text": "最高。昨日はズームなしで"}, {"type": "subtitle", "time": 16923.83, "timestamp": "04:42:03", "text": "ボート。私は海をズームして"}, {"type": "subtitle", "time": 16927.628, "timestamp": "04:42:07", "text": "すべて。最高の気分だった"}, {"type": "subtitle", "time": 16932.11, "timestamp": "04:42:12", "text": "これまで。えっと、どこかで何かを見つけたんです"}, {"type": "subtitle", "time": 16936.39, "timestamp": "04:42:16", "text": "ここにも柱を作ってみました。"}, {"type": "subtitle", "time": 16939.99, "timestamp": "04:42:19", "text": "それを見た記憶はありますか？"}, {"type": "subtitle", "time": 16943.03, "timestamp": "04:42:23", "text": "どれ？"}, {"type": "subtitle", "time": 16973.55, "timestamp": "04:42:53", "text": "うん。うん。私はここにいます。私はここにいます"}, {"type": "subtitle", "time": 16976.83, "timestamp": "04:42:56", "text": "あなた。ああ、木こりを雇ったんですね。"}]
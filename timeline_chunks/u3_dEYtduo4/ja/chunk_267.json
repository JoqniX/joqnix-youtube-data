[{"type": "subtitle", "time": 16020.229, "timestamp": "04:27:00", "text": "待って。次にukiをクリックして、"}, {"type": "subtitle", "time": 16024.87, "timestamp": "04:27:04", "text": "何かをしてから送信します。"}, {"type": "subtitle", "time": 16027.269, "timestamp": "04:27:07", "text": "ああ、そして、こうなるはずです"}, {"type": "subtitle", "time": 16029.03, "timestamp": "04:27:09", "text": "箱。"}, {"type": "subtitle", "time": 16032.229, "timestamp": "04:27:12", "text": "あ、待って。ドラゴンたちが私たちに何かを送ってくれた。"}, {"type": "subtitle", "time": 16034.95, "timestamp": "04:27:14", "text": "開けてみますか？待って。どこ"}, {"type": "subtitle", "time": 16040.309, "timestamp": "04:27:20", "text": "使者たち？ええ、もちろんです。どこですか？"}, {"type": "subtitle", "time": 16042.99, "timestamp": "04:27:22", "text": "わかった。開ける"}, {"type": "subtitle", "time": 16047.11, "timestamp": "04:27:27", "text": "それ。彼は私たちに魂の星を与えてくれた。"}, {"type": "subtitle", "time": 16050.55, "timestamp": "04:27:30", "text": "何？屋台のスター。それは何ですか？"}, {"type": "subtitle", "time": 16054.07, "timestamp": "04:27:34", "text": "何かのことだ。"}, {"type": "subtitle", "time": 16058.389, "timestamp": "04:27:38", "text": "ネザースターとかいうやつ。これは何ですか？"}, {"type": "subtitle", "time": 16060.79, "timestamp": "04:27:40", "text": "使用しないでください。使用しないでください。わかった。ああ、"}, {"type": "subtitle", "time": 16063.189, "timestamp": "04:27:43", "text": "神。"}, {"type": "subtitle", "time": 16067.189, "timestamp": "04:27:47", "text": "待って。ええと、ソウルスター。使いましたか？"}, {"type": "subtitle", "time": 16069.03, "timestamp": "04:27:49", "text": "うん。あと、こちらへ来てください。ところで、私は"}, {"type": "subtitle", "time": 16071.189, "timestamp": "04:27:51", "text": "ソウルスターは何をするのか？それは"}, {"type": "subtitle", "time": 16073.349, "timestamp": "04:27:53", "text": "冥界の星みたい？ネザーとは何ですか？"}, {"type": "subtitle", "time": 16075.189, "timestamp": "04:27:55", "text": "スター？"}, {"type": "subtitle", "time": 16077.51, "timestamp": "04:27:57", "text": "いや、いや、いや、いや。クリックしないでください。私たちは"}]
[{"type": "subtitle", "time": 17107.27, "timestamp": "04:45:07", "text": "ここ。大丈夫ですか？ここ。ここ。後ろに。"}, {"type": "subtitle", "time": 17114.11, "timestamp": "04:45:14", "text": "どこ？ここ。ここ。ここ。ここ。"}, {"type": "subtitle", "time": 17116.868, "timestamp": "04:45:16", "text": "後ろに。ああ、どうぞ。うん。来る。来る。"}, {"type": "subtitle", "time": 17120.39, "timestamp": "04:45:20", "text": "来る。どこで転んだのですか？"}, {"type": "subtitle", "time": 17122.628, "timestamp": "04:45:22", "text": "こちらです。こちらです。こちらです。"}, {"type": "subtitle", "time": 17126.868, "timestamp": "04:45:26", "text": "真下へ。上。上。上。落ち込んではいない。"}, {"type": "subtitle", "time": 17130.31, "timestamp": "04:45:30", "text": "うん。あれが見えますか？柱。うん。"}, {"type": "subtitle", "time": 17134.83, "timestamp": "04:45:34", "text": "それはあなたのものですか？"}, {"type": "subtitle", "time": 17138.39, "timestamp": "04:45:38", "text": "ええと、そこにも何もありません。"}, {"type": "subtitle", "time": 17141.27, "timestamp": "04:45:41", "text": "私たちの近くで陶器のようなものを見かけましたか？"}, {"type": "subtitle", "time": 17148.23, "timestamp": "04:45:48", "text": "これらを利用して氷の高速道路を建設する。によって"}, {"type": "subtitle", "time": 17151.03, "timestamp": "04:45:51", "text": "道、氷の高速道路。"}, {"type": "subtitle", "time": 17153.67, "timestamp": "04:45:53", "text": "ええ、私たちはすぐに一つから別のものへと移ることができます"}, {"type": "subtitle", "time": 17157.11, "timestamp": "04:45:57", "text": "これらを使って別の場所に移動させる。もし"}, {"type": "subtitle", "time": 17159.82, "timestamp": "04:45:59", "text": "シルクのような手触りを実感できる。"}]
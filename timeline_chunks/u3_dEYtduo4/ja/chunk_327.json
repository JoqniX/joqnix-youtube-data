[{"type": "subtitle", "time": 19647.948, "timestamp": "05:27:27", "text": "ですが、使用すべきではないと感じています"}, {"type": "subtitle", "time": 19651.51, "timestamp": "05:27:31", "text": "これ。私にはないはずなのに"}, {"type": "subtitle", "time": 19653.628, "timestamp": "05:27:33", "text": "長い ああ、なんてことだ、"}, {"type": "subtitle", "time": 19656.23, "timestamp": "05:27:36", "text": "立ち往生。はい、長い時間はありません"}, {"type": "subtitle", "time": 19658.628, "timestamp": "05:27:38", "text": "今は遠距離武器だ。これを次のように使用できます"}, {"type": "subtitle", "time": 19660.19, "timestamp": "05:27:40", "text": "離れて"}, {"type": "subtitle", "time": 19663.83, "timestamp": "05:27:43", "text": "うん、それを使うべきじゃない"}, {"type": "subtitle", "time": 19666.59, "timestamp": "05:27:46", "text": "長いもの以外のもの"}, {"type": "subtitle", "time": 19669.91, "timestamp": "05:27:49", "text": "距離は組み合いのように、"}, {"type": "subtitle", "time": 19673.43, "timestamp": "05:27:53", "text": "移動技術はスーパージャンプになります"}, {"type": "subtitle", "time": 19674.27, "timestamp": "05:27:54", "text": "のように"}, {"type": "subtitle", "time": 19678.39, "timestamp": "05:27:58", "text": "これとスライド式のやつを手に入れたので"}]
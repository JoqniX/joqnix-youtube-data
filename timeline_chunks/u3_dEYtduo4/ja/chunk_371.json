[{"type": "subtitle", "time": 22260.628, "timestamp": "06:11:00", "text": "何も間違ったことは言ってないよ。"}, {"type": "subtitle", "time": 22262.788, "timestamp": "06:11:02", "text": "わかった。"}, {"type": "subtitle", "time": 22264.39, "timestamp": "06:11:04", "text": "私は、"}, {"type": "subtitle", "time": 22266.51, "timestamp": "06:11:06", "text": "もし私がたくさんのものを追加したら、あなたはどう思うでしょう。あなたはなれます"}, {"type": "subtitle", "time": 22268.788, "timestamp": "06:11:08", "text": "混乱してイライラするでしょう"}, {"type": "subtitle", "time": 22272.75, "timestamp": "06:11:12", "text": "あなたはそれを楽しめないでしょう。見る？"}, {"type": "subtitle", "time": 22276.07, "timestamp": "06:11:16", "text": "うん。確かに、確かに、確かに。"}, {"type": "subtitle", "time": 22285.75, "timestamp": "06:11:25", "text": "彼はまるでテディベアのようだ。待って、私はできる"}, {"type": "subtitle", "time": 22299.15, "timestamp": "06:11:39", "text": "置かないで"}, {"type": "subtitle", "time": 22301.628, "timestamp": "06:11:41", "text": "1"}, {"type": "subtitle", "time": 22314.67, "timestamp": "06:11:54", "text": "[音楽]"}, {"type": "subtitle", "time": 22317.15, "timestamp": "06:11:57", "text": "それ。何てことだ。"}]
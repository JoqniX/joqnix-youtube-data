[{"type": "subtitle", "time": 4022.15, "timestamp": "01:07:02", "text": "えっと、ゲーム配信ってなんでこんなに面倒なの？したい"}, {"type": "subtitle", "time": 4026.109, "timestamp": "01:07:06", "text": "私のGPUを使ってください。その時、ハッと気づいた。待って"}, {"type": "subtitle", "time": 4030.63, "timestamp": "01:07:10", "text": "分。ゲーム用PCのストレージを"}, {"type": "subtitle", "time": 4034.87, "timestamp": "01:07:14", "text": "SSDをストリームPCに、"}, {"type": "subtitle", "time": 4037.67, "timestamp": "01:07:17", "text": "右？だから私はまだアクセスできる"}, {"type": "subtitle", "time": 4039.91, "timestamp": "01:07:19", "text": "私のファイルも何もかも。だから私はそうした"}, {"type": "subtitle", "time": 4041.75, "timestamp": "01:07:21", "text": "そして最近"}, {"type": "subtitle", "time": 4047.91, "timestamp": "01:07:27", "text": "えっと、1週間前にNVMe SSDを入れたと思う"}, {"type": "subtitle", "time": 4050.549, "timestamp": "01:07:30", "text": "内蔵SSDを取り付けた"}, {"type": "subtitle", "time": 4053.19, "timestamp": "01:07:33", "text": "マザーボード上に直接。私はそれを置いた"}, {"type": "subtitle", "time": 4057.589, "timestamp": "01:07:37", "text": "それで私はPCのWindowsをリセットしました"}, {"type": "subtitle", "time": 4061.029, "timestamp": "01:07:41", "text": "PCでストリーミング配信をしていたのですが、順調でした。そうだった"}, {"type": "subtitle", "time": 4063.109, "timestamp": "01:07:43", "text": "順調です。すべて更新しました。"}, {"type": "subtitle", "time": 4064.91, "timestamp": "01:07:44", "text": "すべてインストールしました"}, {"type": "subtitle", "time": 4069.029, "timestamp": "01:07:49", "text": "必要。ええ、それで私は配信をしました"}, {"type": "subtitle", "time": 4070.51, "timestamp": "01:07:50", "text": "は"}, {"type": "subtitle", "time": 4072.19, "timestamp": "01:07:52", "text": "口笛"}, {"type": "subtitle", "time": 4078.029, "timestamp": "01:07:58", "text": "それ？"}]
[{"type": "subtitle", "time": 16686.629, "timestamp": "04:38:06", "text": "[音楽]"}, {"type": "subtitle", "time": 16700.709, "timestamp": "04:38:20", "text": "右？つまり、もし私たちが望むなら、"}, {"type": "subtitle", "time": 16703.07, "timestamp": "04:38:23", "text": "ブロックを1つだけ作る"}, {"type": "subtitle", "time": 16706.75, "timestamp": "04:38:26", "text": "今。水の表現方法みたいに"}, {"type": "subtitle", "time": 16714.789, "timestamp": "04:38:34", "text": "何か、あるいは部屋一つあれば十分です。我々はできる"}, {"type": "subtitle", "time": 16723.349, "timestamp": "04:38:43", "text": "誰も転ばないことを祈るばかりだ。"}]
[{"type": "subtitle", "time": 5293.189, "timestamp": "01:28:13", "text": "悲しい歌も、良い歌もいくつかあります。"}, {"type": "subtitle", "time": 5295.79, "timestamp": "01:28:15", "text": "楽しい歌。どちらが"}, {"type": "subtitle", "time": 5298.27, "timestamp": "01:28:18", "text": "しーい"}, {"type": "subtitle", "time": 5302.229, "timestamp": "01:28:22", "text": "できません。はい、設定が完了していません"}, {"type": "subtitle", "time": 5304.51, "timestamp": "01:28:24", "text": "現時点で。"}, {"type": "subtitle", "time": 5308.43, "timestamp": "01:28:28", "text": "つまり、これはまずい"}, {"type": "subtitle", "time": 5311.51, "timestamp": "01:28:31", "text": "痛み。読み込みに時間がかかりすぎている"}, {"type": "subtitle", "time": 5314.3, "timestamp": "01:28:34", "text": "良い。"}, {"type": "subtitle", "time": 5327.08, "timestamp": "01:28:47", "text": "私"}, {"type": "subtitle", "time": 5337.14, "timestamp": "01:28:57", "text": "欲しい"}]
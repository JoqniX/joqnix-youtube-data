[{"type": "subtitle", "time": 18123.788, "timestamp": "05:02:03", "text": "思いつきで。見えますか？ああ、今は違う"}, {"type": "subtitle", "time": 18127.948, "timestamp": "05:02:07", "text": "行くよ。しかしその前に私は"}, {"type": "subtitle", "time": 18133.75, "timestamp": "05:02:13", "text": "「ああ、こういうことは時々あるよ」といった項目。"}, {"type": "subtitle", "time": 18135.91, "timestamp": "05:02:15", "text": "現在在庫がいっぱいの場合、アイテム"}, {"type": "subtitle", "time": 18136.83, "timestamp": "05:02:16", "text": "意思"}, {"type": "subtitle", "time": 18143.03, "timestamp": "05:02:23", "text": "どうやら今はサーバーが復旧したようです。"}, {"type": "subtitle", "time": 18145.75, "timestamp": "05:02:25", "text": "負けた時に泣かなくてよかった"}, {"type": "subtitle", "time": 18148.628, "timestamp": "05:02:28", "text": "私のダイヤモンドのつるはし。サーバーは"}, {"type": "subtitle", "time": 18151.43, "timestamp": "05:02:31", "text": "よりスムーズに動作しています。正直言って、そうだね"}, {"type": "subtitle", "time": 18153.67, "timestamp": "05:02:33", "text": "とても短い。なぜもっと早くやらなかったのか"}, {"type": "subtitle", "time": 18157.27, "timestamp": "05:02:37", "text": "このような？しかし、今あなたは"}, {"type": "subtitle", "time": 18159.83, "timestamp": "05:02:39", "text": "いい教訓になったね。使わないように"}, {"type": "subtitle", "time": 18168.47, "timestamp": "05:02:48", "text": "そしてそれは16GBのYeahではありません。そんなに"}, {"type": "subtitle", "time": 18171.75, "timestamp": "05:02:51", "text": "あなたにできること。何てことだ。できるだけ"}, {"type": "subtitle", "time": 18174.83, "timestamp": "05:02:54", "text": "私のPC。"}]
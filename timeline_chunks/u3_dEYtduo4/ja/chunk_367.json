[{"type": "subtitle", "time": 22020.47, "timestamp": "06:07:00", "text": "このスクリーンショットを撮って保存する必要があります"}, {"type": "subtitle", "time": 22022.788, "timestamp": "06:07:02", "text": "自分のギャラリーを見ている。"}, {"type": "subtitle", "time": 22033.19, "timestamp": "06:07:13", "text": "なんだか複雑な感じですね。そうはならないだろう。"}, {"type": "subtitle", "time": 22035.51, "timestamp": "06:07:15", "text": "それは必要ないでしょう。どちらも複雑だ。"}, {"type": "subtitle", "time": 22038.03, "timestamp": "06:07:18", "text": "ええ、私は"}, {"type": "subtitle", "time": 22046.628, "timestamp": "06:07:26", "text": "待って、いつになったら自分たちの家が持てるの？"}, {"type": "subtitle", "time": 22048.948, "timestamp": "06:07:28", "text": "位置？あなたが言ったように、今あなたは"}, {"type": "subtitle", "time": 22051.43, "timestamp": "06:07:31", "text": "そんな感じだったと思う。"}, {"type": "subtitle", "time": 22053.59, "timestamp": "06:07:33", "text": "まるで私がそれをやっていたかのように。ええ、やっていました"}, {"type": "subtitle", "time": 22056.628, "timestamp": "06:07:36", "text": "それ。しかし問題は、私が唯一のものを追加すると"}, {"type": "subtitle", "time": 22060.07, "timestamp": "06:07:40", "text": "それを実現する方法の一つは、マップのようなMODを使うことです。しかし"}, {"type": "subtitle", "time": 22062.31, "timestamp": "06:07:42", "text": "誰もが、他の人を見つけることができる"}, {"type": "subtitle", "time": 22064.788, "timestamp": "06:07:44", "text": "プレイヤー。なんてこった。私たちはそれを望んでいません。"}, {"type": "subtitle", "time": 22071.83, "timestamp": "06:07:51", "text": "[音楽]"}, {"type": "subtitle", "time": 22075.07, "timestamp": "06:07:55", "text": "他に導入予定のMODはありますか？"}, {"type": "subtitle", "time": 22078.39, "timestamp": "06:07:58", "text": "私は確信しています。"}]
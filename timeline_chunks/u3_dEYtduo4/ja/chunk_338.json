[{"type": "subtitle", "time": 20280.47, "timestamp": "05:38:00", "text": "ごめん。何も食べないつもりですか？"}, {"type": "subtitle", "time": 20283.708, "timestamp": "05:38:03", "text": "待って、つるはしはどこ？"}, {"type": "subtitle", "time": 20287.948, "timestamp": "05:38:07", "text": "ええと、全く分かりません。"}, {"type": "subtitle", "time": 20291.67, "timestamp": "05:38:11", "text": "おい、何、何、何、何"}, {"type": "subtitle", "time": 20293.27, "timestamp": "05:38:13", "text": "くそ？"}, {"type": "subtitle", "time": 20296.27, "timestamp": "05:38:16", "text": "どうしたの？"}, {"type": "subtitle", "time": 20300.31, "timestamp": "05:38:20", "text": "何もない。不具合が発生しています。なぜ？何が"}, {"type": "subtitle", "time": 20302.47, "timestamp": "05:38:22", "text": "不具合？"}, {"type": "subtitle", "time": 20305.75, "timestamp": "05:38:25", "text": "ええ、あなたはそれをやったのかもしれませんね。ああ、戻る"}, {"type": "subtitle", "time": 20309.75, "timestamp": "05:38:29", "text": "チーズは時々その不具合を引き起こします。"}, {"type": "subtitle", "time": 20312.23, "timestamp": "05:38:32", "text": "バックチーズ。"}, {"type": "subtitle", "time": 20315.27, "timestamp": "05:38:35", "text": "うん。つまり、基本的にはアーセナル"}, {"type": "subtitle", "time": 20324.35, "timestamp": "05:38:44", "text": "なぜ？何が問題なの？私はしません"}, {"type": "subtitle", "time": 20328.23, "timestamp": "05:38:48", "text": "知る。アーセナル。"}, {"type": "subtitle", "time": 20330.788, "timestamp": "05:38:50", "text": "うん。つまり、アイテムを置くことができるということです"}, {"type": "subtitle", "time": 20333.35, "timestamp": "05:38:53", "text": "あなたの背景に。うん。バックパックではない"}, {"type": "subtitle", "time": 20336.07, "timestamp": "05:38:56", "text": "背面のように。うん。不具合が発生する可能性あり"}, {"type": "subtitle", "time": 20337.83, "timestamp": "05:38:57", "text": "時々、あなたが着ているから"}, {"type": "subtitle", "time": 20339.91, "timestamp": "05:38:59", "text": "バックパック。"}]
[{"type": "subtitle", "time": 3187.71, "timestamp": "00:53:07", "text": "みんな。皆様、こんばんは。"}, {"type": "subtitle", "time": 3191.87, "timestamp": "00:53:11", "text": "こんにちは。皆さん、私の声が聞こえますか？"}, {"type": "subtitle", "time": 3203.549, "timestamp": "00:53:23", "text": "えっと、ただ"}, {"type": "subtitle", "time": 3206.27, "timestamp": "00:53:26", "text": "音楽"}, {"type": "subtitle", "time": 3208.75, "timestamp": "00:53:28", "text": "右。こんにちは"}, {"type": "subtitle", "time": 3211.63, "timestamp": "00:53:31", "text": "カワ。皆さんお元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 3215.43, "timestamp": "00:53:35", "text": "良い。こんにちは。"}, {"type": "subtitle", "time": 3218.27, "timestamp": "00:53:38", "text": "というわけで、今日はただ"}, {"type": "subtitle", "time": 3221.069, "timestamp": "00:53:41", "text": "クイックストリーム"}, {"type": "subtitle", "time": 3225.349, "timestamp": "00:53:45", "text": "えーと、最近は忙しいので"}, {"type": "subtitle", "time": 3229.549, "timestamp": "00:53:49", "text": "いろいろあって追いつけなかった"}, {"type": "subtitle", "time": 3232.15, "timestamp": "00:53:52", "text": "みんな。でも、皆さんが"}, {"type": "subtitle", "time": 3234.589, "timestamp": "00:53:54", "text": "みんなよくやっているよ。"}, {"type": "subtitle", "time": 3237.39, "timestamp": "00:53:57", "text": "お元気ですか？"}]
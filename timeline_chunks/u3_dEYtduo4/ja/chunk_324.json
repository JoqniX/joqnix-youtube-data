[{"type": "subtitle", "time": 19458.35, "timestamp": "05:24:18", "text": "タイマーが停止します。いいえ。タイマーみたいなものです。"}, {"type": "subtitle", "time": 19461.83, "timestamp": "05:24:21", "text": "実際は関係ない、なぜなら私は"}, {"type": "subtitle", "time": 19462.91, "timestamp": "05:24:22", "text": "ストリーミング"}, {"type": "subtitle", "time": 19467.55, "timestamp": "05:24:27", "text": "6月24日まで年中無休。"}, {"type": "subtitle", "time": 19470.39, "timestamp": "05:24:30", "text": "だから、私が"}, {"type": "subtitle", "time": 19491.27, "timestamp": "05:24:51", "text": "[音楽]"}, {"type": "subtitle", "time": 19492.75, "timestamp": "05:24:52", "text": "私は"}, {"type": "subtitle", "time": 19495.39, "timestamp": "05:24:55", "text": "スパイダーマン。何てことだ。私は"}, {"type": "subtitle", "time": 19498.708, "timestamp": "05:24:58", "text": "スパイダーマン。ああ、行き詰まってしまった。行き詰まってしまった。"}, {"type": "subtitle", "time": 19499.868, "timestamp": "05:24:59", "text": "私は"}]
[{"type": "subtitle", "time": 1801.35, "timestamp": "00:30:01", "text": "知ってる？私は以前、他のYouTuberを手伝っていたんだ"}, {"type": "subtitle", "time": 1804.149, "timestamp": "00:30:04", "text": "会員権を持っていた人、"}, {"type": "subtitle", "time": 1806.549, "timestamp": "00:30:06", "text": "もの。私は本当に理解できなかった"}, {"type": "subtitle", "time": 1810.63, "timestamp": "00:30:10", "text": "これって効果があるし、まあまあだね。ええ、"}, {"type": "subtitle", "time": 1813.909, "timestamp": "00:30:13", "text": "今は自分でそれを手にすることができるし"}, {"type": "subtitle", "time": 1817.75, "timestamp": "00:30:17", "text": "試してみてください。すべて発売されました。私は"}, {"type": "subtitle", "time": 1820.89, "timestamp": "00:30:20", "text": "とても幸せです。"}, {"type": "subtitle", "time": 1823.35, "timestamp": "00:30:23", "text": "[音楽]"}, {"type": "subtitle", "time": 1825.19, "timestamp": "00:30:25", "text": "そう、スーパーをやった人たちはみんな"}, {"type": "subtitle", "time": 1829.35, "timestamp": "00:30:29", "text": "チャット関連の話題は、ここに出てくる。会員"}, {"type": "subtitle", "time": 1831.789, "timestamp": "00:30:31", "text": "物がここに来るのは"}, {"type": "subtitle", "time": 1835.269, "timestamp": "00:30:35", "text": "レビュー。明日の朝9時に"}, {"type": "subtitle", "time": 1837.71, "timestamp": "00:30:37", "text": "会員向け配信を行っています。"}, {"type": "subtitle", "time": 1849.07, "timestamp": "00:30:49", "text": "右？私は自分自身を売り込まなければならない。"}]
[{"type": "subtitle", "time": 2821.79, "timestamp": "00:47:01", "text": "2番目を遅らせる方法はありません"}, {"type": "subtitle", "time": 2824.589, "timestamp": "00:47:04", "text": "一部"}, {"type": "subtitle", "time": 2833.75, "timestamp": "00:47:13", "text": "一番良いのは、YouTube を送信しないことです"}, {"type": "subtitle", "time": 2837.03, "timestamp": "00:47:17", "text": "1時間給餌してから1時間後に送る"}, {"type": "subtitle", "time": 2842.829, "timestamp": "00:47:22", "text": "[音楽]"}, {"type": "subtitle", "time": 2845.99, "timestamp": "00:47:25", "text": "それ。しかし、それは問題を引き起こすだろう。だけでなく"}, {"type": "subtitle", "time": 2848.47, "timestamp": "00:47:28", "text": "犠牲は必要ないから"}, {"type": "subtitle", "time": 2851.99, "timestamp": "00:47:31", "text": "これ。 10時って本当に遅い時間だよね。"}, {"type": "subtitle", "time": 2856.069, "timestamp": "00:47:36", "text": "おそらく10時までには寝るだろう。"}, {"type": "subtitle", "time": 2857.91, "timestamp": "00:47:37", "text": "1時間ほど話をしたいのですが、"}, {"type": "subtitle", "time": 2859.23, "timestamp": "00:47:39", "text": "あなた"}, {"type": "subtitle", "time": 2863.27, "timestamp": "00:47:43", "text": "知る。だから、私ができることは"}, {"type": "subtitle", "time": 2865.47, "timestamp": "00:47:45", "text": "だろう"}, {"type": "subtitle", "time": 2869.19, "timestamp": "00:47:49", "text": "私は授業に出席します。"}, {"type": "subtitle", "time": 2871.349, "timestamp": "00:47:51", "text": "ストリームを開始してストリームを終了します"}, {"type": "subtitle", "time": 2873.069, "timestamp": "00:47:53", "text": "の"}, {"type": "subtitle", "time": 2876.069, "timestamp": "00:47:56", "text": "リダイレクトしてチャットテキストチャットでお知らせします"}, {"type": "subtitle", "time": 2879.19, "timestamp": "00:47:59", "text": "画面上のテキストやチャットにも同様に表示されます。"}]
[{"type": "subtitle", "time": 15062.79, "timestamp": "04:11:02", "text": "その時でさえ、すべてがそうだった。送信しましたか？"}, {"type": "subtitle", "time": 15064.95, "timestamp": "04:11:04", "text": "彼に在庫を渡す？"}, {"type": "subtitle", "time": 15067.07, "timestamp": "04:11:07", "text": "ええ、そうしました。"}, {"type": "subtitle", "time": 15069.389, "timestamp": "04:11:09", "text": "えっと、私の"}, {"type": "subtitle", "time": 15073.189, "timestamp": "04:11:13", "text": "ストリーム？昨日は今日で16日でした。わかりました。"}, {"type": "subtitle", "time": 15076.63, "timestamp": "04:11:16", "text": "15. 今日はうんちの日。"}, {"type": "subtitle", "time": 15080.07, "timestamp": "04:11:20", "text": "私が泣いた日。いや、私が怒って辞めた日"}, {"type": "subtitle", "time": 15088.55, "timestamp": "04:11:28", "text": "昨日。おい、なんで怒ってゲームをやめたんだよ"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "昨日？愚かな柱と"}, {"type": "subtitle", "time": 15094.03, "timestamp": "04:11:34", "text": "斧。私はすでに殺した"}, {"type": "subtitle", "time": 15098.309, "timestamp": "04:11:38", "text": "56人の村人が、ご存知のように"}, {"type": "subtitle", "time": 15100.55, "timestamp": "04:11:40", "text": "頂点のような動き、みたいな感じ"}, {"type": "subtitle", "time": 15102.99, "timestamp": "04:11:42", "text": "タップして渇き、スライディスライディのように"}, {"type": "subtitle", "time": 15112.75, "timestamp": "04:11:52", "text": "わからない、私がやったんだけど、えっと"}, {"type": "subtitle", "time": 15116.95, "timestamp": "04:11:56", "text": "そして全てが"}]
[{"type": "subtitle", "time": 22685.15, "timestamp": "06:18:05", "text": "ホットVRと、えっと、ゾンビがいる"}, {"type": "subtitle", "time": 22690.07, "timestamp": "06:18:10", "text": "VA、えっと、待って、VRゲームがたくさんあるんだ"}, {"type": "subtitle", "time": 22692.27, "timestamp": "06:18:12", "text": "君も知ってるよね"}, {"type": "subtitle", "time": 22694.868, "timestamp": "06:18:14", "text": "うん、でも、君がすべきことは分かってるよね"}, {"type": "subtitle", "time": 22699.19, "timestamp": "06:18:19", "text": "いつかVRチャートに参加すべきだよ、兄弟"}, {"type": "subtitle", "time": 22702.39, "timestamp": "06:18:22", "text": "VRチャット、PCを手に入れたら"}, {"type": "subtitle", "time": 22705.03, "timestamp": "06:18:25", "text": "PCさん、楽しいことがたくさんあるって教えてくれました"}, {"type": "subtitle", "time": 22707.27, "timestamp": "06:18:27", "text": "お見せできますよ、おやおやおや"}, {"type": "subtitle", "time": 22709.75, "timestamp": "06:18:29", "text": "プレイテスト版を試してみてください。わかった。"}, {"type": "subtitle", "time": 22711.39, "timestamp": "06:18:31", "text": "だからあなたはそうしない"}, {"type": "subtitle", "time": 22715.83, "timestamp": "06:18:35", "text": "窒息させる、そして場所と言うだろう"}, {"type": "subtitle", "time": 22719.35, "timestamp": "06:18:39", "text": "エアコンのある部屋でパソコンを使う"}, {"type": "subtitle", "time": 22723.27, "timestamp": "06:18:43", "text": "信じてください、とても暑くなる可能性があります。"}, {"type": "subtitle", "time": 22729.19, "timestamp": "06:18:49", "text": "なるほど。"}, {"type": "subtitle", "time": 22736.628, "timestamp": "06:18:56", "text": "辛い。ああ、寝袋を持って行ってもいいですよ。"}]
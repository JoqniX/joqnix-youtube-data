[{"type": "subtitle", "time": 8654.469, "timestamp": "02:24:14", "text": "ロマニ語だけを読んでいるのが気に入っています。"}, {"type": "subtitle", "time": 8657.03, "timestamp": "02:24:17", "text": "私は実際の日本語を飛ばしているようなものです。"}, {"type": "subtitle", "time": 8660.07, "timestamp": "02:24:20", "text": "私は日本に行くんだ、坊や。ああ、私の娘よ。おお"}, {"type": "subtitle", "time": 8663.95, "timestamp": "02:24:23", "text": "我が神よ。俺は字も読めないんだよ、兄弟。何"}]
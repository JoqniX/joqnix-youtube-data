[{"type": "subtitle", "time": 21900.788, "timestamp": "06:05:00", "text": "私のはどうなの？"}, {"type": "subtitle", "time": 21904.708, "timestamp": "06:05:04", "text": "私のは3週間点灯しています。"}, {"type": "subtitle", "time": 21906.788, "timestamp": "06:05:06", "text": "ああ、神様。"}, {"type": "subtitle", "time": 21909.83, "timestamp": "06:05:09", "text": "ええ、一度やり直しました。そうすべきだよ、"}, {"type": "subtitle", "time": 21912.31, "timestamp": "06:05:12", "text": "あなたはパソコンから離れるべきです。しないでください"}, {"type": "subtitle", "time": 21914.31, "timestamp": "06:05:14", "text": "もの。"}, {"type": "subtitle", "time": 21915.67, "timestamp": "06:05:15", "text": "あなたはノートパソコンを持っています。どうですか"}, {"type": "subtitle", "time": 21924.31, "timestamp": "06:05:24", "text": "PC。私のパソコン、すごく熱い。わかった。それを見つけてください。えっと、"}, {"type": "subtitle", "time": 21927.75, "timestamp": "06:05:27", "text": "チャットのあのところにスラッシュを入力してください"}, {"type": "subtitle", "time": 21940.99, "timestamp": "06:05:40", "text": "指輪。謝罪って一体何なの？それからch"}, {"type": "subtitle", "time": 21943.47, "timestamp": "06:05:43", "text": "に"}, {"type": "subtitle", "time": 21947.27, "timestamp": "06:05:47", "text": "あなたがそばにいるときはいつでも、私は"}, {"type": "subtitle", "time": 21950.788, "timestamp": "06:05:50", "text": "君を子供扱いする。"}]
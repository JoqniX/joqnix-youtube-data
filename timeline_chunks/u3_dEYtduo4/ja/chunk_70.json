[{"type": "subtitle", "time": 4201.07, "timestamp": "01:10:01", "text": "は"}, {"type": "subtitle", "time": 4206.229, "timestamp": "01:10:06", "text": "GPU をすでに削除したので"}, {"type": "subtitle", "time": 4210.47, "timestamp": "01:10:10", "text": "ストリーミングPCのGPUは1660 Superでした。私"}, {"type": "subtitle", "time": 4212.79, "timestamp": "01:10:12", "text": "「よし、テストしてみよう」"}, {"type": "subtitle", "time": 4216.149, "timestamp": "01:10:16", "text": "1660スーパー、またか。 30日間機能しているなら"}, {"type": "subtitle", "time": 4219.59, "timestamp": "01:10:19", "text": "数分後、つまりこの2060年は終焉を迎えるということだ。"}, {"type": "subtitle", "time": 4222.95, "timestamp": "01:10:22", "text": "「公式に衰退している。」そして、何だと思いますか？"}, {"type": "subtitle", "time": 4226.47, "timestamp": "01:10:26", "text": "そして最初に削除したものを削除したとき"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "2060で、ファンに指が挟まってしまった。"}, {"type": "subtitle", "time": 4233.189, "timestamp": "01:10:33", "text": "実行中だった。電源を切るのを忘れた"}, {"type": "subtitle", "time": 4237.83, "timestamp": "01:10:37", "text": "オフ、えーと、えーと、ターンする"}, {"type": "subtitle", "time": 4240.79, "timestamp": "01:10:40", "text": "取り外す前にコンピューターの電源を切ってください。"}, {"type": "subtitle", "time": 4243.87, "timestamp": "01:10:43", "text": "コンポーネント。今私は忘れてしまったし、私の"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "指が切れた。スライスされたのではなく、切断された。"}, {"type": "subtitle", "time": 4251.91, "timestamp": "01:10:51", "text": "大丈夫。それはカットされた。プラスファン２人"}, {"type": "subtitle", "time": 4256.51, "timestamp": "01:10:56", "text": "両側から刃が"}]
[{"type": "subtitle", "time": 2880.95, "timestamp": "00:48:00", "text": "ストリームへようこそ、そして"}, {"type": "subtitle", "time": 2883.27, "timestamp": "00:48:03", "text": "すべて。それって一度やったことありますよね？私たちは"}, {"type": "subtitle", "time": 2885.95, "timestamp": "00:48:05", "text": "一度だけやったことがある。私がそれをする"}, {"type": "subtitle", "time": 2890.03, "timestamp": "00:48:10", "text": "また。ああ、もう一度やってみよう。それ"}, {"type": "subtitle", "time": 2892.63, "timestamp": "00:48:12", "text": "クソ、それで十分だ"}, {"type": "subtitle", "time": 2895.829, "timestamp": "00:48:15", "text": "十分だ。授業後、私は"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "さっぱりして、顔を洗ったりして、"}, {"type": "subtitle", "time": 2900.109, "timestamp": "00:48:20", "text": "それから"}, {"type": "subtitle", "time": 2938.91, "timestamp": "00:48:58", "text": "[音楽]"}]
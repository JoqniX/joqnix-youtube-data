[{"type": "subtitle", "time": 21797.75, "timestamp": "06:03:17", "text": "コネクタから抽出します。これ全部"}, {"type": "subtitle", "time": 21816.948, "timestamp": "06:03:36", "text": "私は"}, {"type": "subtitle", "time": 21820.708, "timestamp": "06:03:40", "text": "戻ってきてくれて嬉しいです。行かなければならなかった"}, {"type": "subtitle", "time": 21823.59, "timestamp": "06:03:43", "text": "入って、兄弟。そうそう。彼女にどうやって伝えたの？"}, {"type": "subtitle", "time": 21827.35, "timestamp": "06:03:47", "text": "座標を使うには？"}, {"type": "subtitle", "time": 21830.47, "timestamp": "06:03:50", "text": "なんてこった。忘れた。"}, {"type": "subtitle", "time": 21837.91, "timestamp": "06:03:57", "text": "ああ、あのね？彼女はできないだろう"}]
[{"type": "subtitle", "time": 4141.99, "timestamp": "01:09:01", "text": "戻る。しかし、しばらくすると、"}, {"type": "subtitle", "time": 4143.99, "timestamp": "01:09:03", "text": "また同じことが起きてる。あのね？それ"}, {"type": "subtitle", "time": 4146.789, "timestamp": "01:09:06", "text": "それは私に思い出させた それは私に思い出させた"}, {"type": "subtitle", "time": 4151.349, "timestamp": "01:09:11", "text": "CPUが変わった後"}, {"type": "subtitle", "time": 4155.669, "timestamp": "01:09:15", "text": "その日のストリームボディカムストリーム"}, {"type": "subtitle", "time": 4158.309, "timestamp": "01:09:18", "text": "6月だったか、それとも5月だったか？待って、いつ"}, {"type": "subtitle", "time": 4160.789, "timestamp": "01:09:20", "text": "いつ私は"}, {"type": "subtitle", "time": 4162.51, "timestamp": "01:09:22", "text": "えっと、体"}, {"type": "subtitle", "time": 4166.87, "timestamp": "01:09:26", "text": "またカメラ配信？ 6月20日。うん、それ"}, {"type": "subtitle", "time": 4170.47, "timestamp": "01:09:30", "text": "毎日同じことの繰り返し。私は"}, {"type": "subtitle", "time": 4173.03, "timestamp": "01:09:33", "text": "PC。オフかオフかのどちらかです"}, {"type": "subtitle", "time": 4175.99, "timestamp": "01:09:35", "text": "動作しているか、画面が真っ暗か。私は「ああ」と思った"}, {"type": "subtitle", "time": 4184.269, "timestamp": "01:09:44", "text": "ああ、だから私が何をしたか分かるでしょう"}, {"type": "subtitle", "time": 4187.43, "timestamp": "01:09:47", "text": "いつものように試してみたが、"}, {"type": "subtitle", "time": 4190.55, "timestamp": "01:09:50", "text": "チュートリアルで何をすべきか、そしてGPDとチャットします"}, {"type": "subtitle", "time": 4194.229, "timestamp": "01:09:54", "text": "そして、そこからseosをリセットしました"}, {"type": "subtitle", "time": 4197.189, "timestamp": "01:09:57", "text": "マザーボードのすべてがリセットされ、RAMもリセットされました。"}, {"type": "subtitle", "time": 4199.669, "timestamp": "01:09:59", "text": "すべてを理解し、犯人に気づいた"}]
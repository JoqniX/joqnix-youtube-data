[{"type": "subtitle", "time": 5226.31, "timestamp": "01:27:06", "text": "明日からサブが登場。はい。えっと、明日"}, {"type": "subtitle", "time": 5229.27, "timestamp": "01:27:09", "text": "会員登録受付開始"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "ストリーム。正直に言うと、"}, {"type": "subtitle", "time": 5234.47, "timestamp": "01:27:14", "text": "モデルをリリースしたときのメンバーシップまたは"}, {"type": "subtitle", "time": 5238.79, "timestamp": "01:27:18", "text": "デビューするみたいだけど、"}, {"type": "subtitle", "time": 5240.79, "timestamp": "01:27:20", "text": "えっと、あまり長く待たない方がいい"}, {"type": "subtitle", "time": 5242.629, "timestamp": "01:27:22", "text": "完璧な瞬間。ただ、ただ"}, {"type": "subtitle", "time": 5246.149, "timestamp": "01:27:26", "text": "その金額も"}, {"type": "subtitle", "time": 5248.47, "timestamp": "01:27:28", "text": "チョコレートの件まで数え上げてください、ですよね？"}, {"type": "subtitle", "time": 5251.91, "timestamp": "01:27:31", "text": "だから、4月の支払いに使える"}, {"type": "subtitle", "time": 5255.629, "timestamp": "01:27:35", "text": "えーと、コミッション"}, {"type": "subtitle", "time": 5258.95, "timestamp": "01:27:38", "text": "もの。まだ終わってないよ。たくさんのこと"}, {"type": "subtitle", "time": 5260.669, "timestamp": "01:27:40", "text": "全てがうまくいくことを願います"}, {"type": "subtitle", "time": 5262.669, "timestamp": "01:27:42", "text": "良い。"}]
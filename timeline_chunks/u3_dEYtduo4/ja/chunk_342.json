[{"type": "subtitle", "time": 20542.11, "timestamp": "05:42:22", "text": "これ。我々はできる"}, {"type": "subtitle", "time": 20544.628, "timestamp": "05:42:24", "text": "何？ああ、君たちは一緒に咆哮できるんだ。おお、"}, {"type": "subtitle", "time": 20546.07, "timestamp": "05:42:26", "text": "うん。"}, {"type": "subtitle", "time": 20548.948, "timestamp": "05:42:28", "text": "スライドを作成しました。"}, {"type": "subtitle", "time": 20551.03, "timestamp": "05:42:31", "text": "こんにちは、犬さん。"}, {"type": "subtitle", "time": 20553.59, "timestamp": "05:42:33", "text": "こんにちは。"}, {"type": "subtitle", "time": 20558.15, "timestamp": "05:42:38", "text": "おお。このボードはgraで使用できます。"}, {"type": "subtitle", "time": 20567.67, "timestamp": "05:42:47", "text": "シフト。わかった。私にとってはシフト勤務は都合が良い。ください"}, {"type": "subtitle", "time": 20570.39, "timestamp": "05:42:50", "text": "うん。ボードを渡してください。 E を押して"}, {"type": "subtitle", "time": 20572.548, "timestamp": "05:42:52", "text": "右クリックして"}, {"type": "subtitle", "time": 20576.788, "timestamp": "05:42:56", "text": "在庫バーのような、型破りなデザイン。"}, {"type": "subtitle", "time": 20579.99, "timestamp": "05:42:59", "text": "知っている。"}]
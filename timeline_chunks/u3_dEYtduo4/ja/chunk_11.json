[{"type": "subtitle", "time": 666.74, "timestamp": "00:11:06", "text": "バカ。ああ、"}, {"type": "subtitle", "time": 670.35, "timestamp": "00:11:10", "text": "[音楽]"}, {"type": "subtitle", "time": 673.55, "timestamp": "00:11:13", "text": "神。痛み。私はできません。"}, {"type": "subtitle", "time": 677.67, "timestamp": "00:11:17", "text": "O. 私たちはそれを「私は」に入れるべきだ"}, {"type": "subtitle", "time": 679.43, "timestamp": "00:11:19", "text": "レベルを削除すべきでしょうか？"}, {"type": "subtitle", "time": 682.269, "timestamp": "00:11:22", "text": "レベルを削除してやり直した方がいいでしょうか？"}, {"type": "subtitle", "time": 684.389, "timestamp": "00:11:24", "text": "また？削除すべきだと思う"}, {"type": "subtitle", "time": 685.389, "timestamp": "00:11:25", "text": "レベル。"}, {"type": "subtitle", "time": 688.069, "timestamp": "00:11:28", "text": "H、つまり絵文字を追加しました"}, {"type": "subtitle", "time": 690.59, "timestamp": "00:11:30", "text": "すべて。やり直さなければならない"}, {"type": "subtitle", "time": 693.949, "timestamp": "00:11:33", "text": "また。大丈夫です。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 703.99, "timestamp": "00:11:43", "text": "バカ。ああ、神様。バカめ。バカめ"}, {"type": "subtitle", "time": 705.069, "timestamp": "00:11:45", "text": "[音楽]"}]
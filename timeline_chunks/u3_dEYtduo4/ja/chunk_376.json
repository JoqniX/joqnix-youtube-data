[{"type": "subtitle", "time": 22572.23, "timestamp": "06:16:12", "text": "待って、あなたに渡させてください。ああ、だめです。おい、何だって？"}, {"type": "subtitle", "time": 22576.39, "timestamp": "06:16:16", "text": "どこ？それはどこへ行ったの？はぁ？あなたはそれを保管します"}, {"type": "subtitle", "time": 22579.35, "timestamp": "06:16:19", "text": "彼女のバッグの中に。"}, {"type": "subtitle", "time": 22582.868, "timestamp": "06:16:22", "text": "彼女が来る。彼女は、ああ、あなたはとても"}, {"type": "subtitle", "time": 22586.07, "timestamp": "06:16:26", "text": "かわいいね、兄弟。"}, {"type": "subtitle", "time": 22594.39, "timestamp": "06:16:34", "text": "リュックサックがたくさんある。ドラゴン"}, {"type": "subtitle", "time": 22598.23, "timestamp": "06:16:38", "text": "バックパック。クリーパー。パンプキン。メロン。猫の"}, {"type": "subtitle", "time": 22600.83, "timestamp": "06:16:40", "text": "ケーキ柄のバックパック。ああ、"}, {"type": "subtitle", "time": 22603.83, "timestamp": "06:16:43", "text": "神。エンダーマン。このバックパックは何ですか？"}, {"type": "subtitle", "time": 22607.59, "timestamp": "06:16:47", "text": "フェスティバル？悪い仲間になれ。"}, {"type": "subtitle", "time": 22611.19, "timestamp": "06:16:51", "text": "何？何してるの？ひどいリュックサックだ。"}, {"type": "subtitle", "time": 22614.99, "timestamp": "06:16:54", "text": "クモのバックパック。なぜあなたはなぜあなたは"}, {"type": "subtitle", "time": 22617.99, "timestamp": "06:16:57", "text": "フライング？飛行機の調子はどうですか？飛行機には乗らない。"}]
[{"type": "subtitle", "time": 18784.15, "timestamp": "05:13:04", "text": "物事は元に戻り、ゆっくりとした主が"}, {"type": "subtitle", "time": 18786.83, "timestamp": "05:13:06", "text": "遅いとは呼ばれません"}, {"type": "subtitle", "time": 18795.47, "timestamp": "05:13:15", "text": "ええと、シグマは予約を保存し、アイテムを無視します"}, {"type": "subtitle", "time": 18797.67, "timestamp": "05:13:17", "text": "コンポーネント。数学的な"}, {"type": "subtitle", "time": 18798.67, "timestamp": "05:13:18", "text": "表現"}, {"type": "subtitle", "time": 18805.23, "timestamp": "05:13:25", "text": "使用する"}, {"type": "subtitle", "time": 18808.59, "timestamp": "05:13:28", "text": "寝ている。私は何をしたのか"}, {"type": "subtitle", "time": 18813.948, "timestamp": "05:13:33", "text": "する？寝袋を持ってきてもいいですよ。ああ、"}, {"type": "subtitle", "time": 18828.91, "timestamp": "05:13:48", "text": "そこには。寝袋とは何ですか"}, {"type": "subtitle", "time": 18830.83, "timestamp": "05:13:50", "text": "あれ？どのように読みますか"}, {"type": "subtitle", "time": 18833.15, "timestamp": "05:13:53", "text": "ドキュメント"}, {"type": "subtitle", "time": 18834.18, "timestamp": "05:13:54", "text": "実は？"}]
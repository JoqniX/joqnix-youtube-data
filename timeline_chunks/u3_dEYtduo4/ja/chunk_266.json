[{"type": "subtitle", "time": 15968.03, "timestamp": "04:26:08", "text": "今は正しい方向に向かっていると感じている"}, {"type": "subtitle", "time": 15972.189, "timestamp": "04:26:12", "text": "方向。私のシャベルで何ができるの？"}, {"type": "subtitle", "time": 15976.309, "timestamp": "04:26:16", "text": "埋める。敵モブに使用する。使用する際は、"}, {"type": "subtitle", "time": 15979.349, "timestamp": "04:26:19", "text": "地面が柔らかい場合は群衆が埋めるだろう"}, {"type": "subtitle", "time": 15981.55, "timestamp": "04:26:21", "text": "十分。それは何"}, {"type": "subtitle", "time": 15984.389, "timestamp": "04:26:24", "text": "平均？追加ダメージを与え、青"}, {"type": "subtitle", "time": 15985.469, "timestamp": "04:26:25", "text": "滴。"}, {"type": "subtitle", "time": 15989.67, "timestamp": "04:26:29", "text": "どんな仕事？こんにちは。"}, {"type": "subtitle", "time": 15991.75, "timestamp": "04:26:31", "text": "実際に農業する方法を教えてあげよう"}, {"type": "subtitle", "time": 15995.269, "timestamp": "04:26:35", "text": "きちんと。あなたが作った農場はDr. Vです。"}, {"type": "subtitle", "time": 15998.469, "timestamp": "04:26:38", "text": "V博士、何ですって？"}, {"type": "subtitle", "time": 16002.07, "timestamp": "04:26:42", "text": "何？あなたはドクターVと言いました。私は、えっと、"}, {"type": "subtitle", "time": 16005.03, "timestamp": "04:26:45", "text": "V博士とは何ですか？医者が言ったのを聞いたけど、"}, {"type": "subtitle", "time": 16007.51, "timestamp": "04:26:47", "text": "農業のやり方を知らない"}, {"type": "subtitle", "time": 16011.269, "timestamp": "04:26:51", "text": "きちんと。わからない。私は農家です。"}, {"type": "subtitle", "time": 16014.07, "timestamp": "04:26:54", "text": "だから、これをクリックすると、"}, {"type": "subtitle", "time": 16017.349, "timestamp": "04:26:57", "text": "自分自身に何かを送ることができます。おお、"}]
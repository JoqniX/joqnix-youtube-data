[{"type": "subtitle", "time": 12305.309, "timestamp": "03:25:05", "text": "[音楽]"}, {"type": "subtitle", "time": 12339.67, "timestamp": "03:25:39", "text": "待って、ちょっと待って。えっと、忘れちゃった、待って、"}, {"type": "subtitle", "time": 12342.79, "timestamp": "03:25:42", "text": "待って、待って。俺はそういう気分だったんだよ、兄弟。"}, {"type": "subtitle", "time": 12344.99, "timestamp": "03:25:44", "text": "待って、忘れてた"}, {"type": "subtitle", "time": 12348.71, "timestamp": "03:25:48", "text": "私はとても頑張っていました。どこにあるの"}, {"type": "subtitle", "time": 12350.63, "timestamp": "03:25:50", "text": "どこだ どこだ どこだ"}, {"type": "subtitle", "time": 12357.59, "timestamp": "03:25:57", "text": "わかった。さあ行こう。さあ行こう。もう一度やってみて。"}]
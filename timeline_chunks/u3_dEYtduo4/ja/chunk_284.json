[{"type": "subtitle", "time": 17045.35, "timestamp": "04:44:05", "text": "あなたの不運について話してください。"}, {"type": "subtitle", "time": 17048.67, "timestamp": "04:44:08", "text": "クソくらえ。ああ、"}, {"type": "subtitle", "time": 17051.67, "timestamp": "04:44:11", "text": "神。ああ、なんてことだ。何が起こっている"}, {"type": "subtitle", "time": 17054.31, "timestamp": "04:44:14", "text": "今日？"}, {"type": "subtitle", "time": 17057.83, "timestamp": "04:44:17", "text": "今日はすごく変だよ。"}, {"type": "subtitle", "time": 17059.91, "timestamp": "04:44:19", "text": "その通り。何が"}, {"type": "subtitle", "time": 17063.788, "timestamp": "04:44:23", "text": "私に起こっていること。私は酔って眠っている"}, {"type": "subtitle", "time": 17067.11, "timestamp": "04:44:27", "text": "また。私は何を失ってしまったのでしょうか？はい、あなたは"}, {"type": "subtitle", "time": 17071.07, "timestamp": "04:44:31", "text": "ここ。あなたは本当に"}, {"type": "subtitle", "time": 17082.27, "timestamp": "04:44:42", "text": "いいえ、私はちょっと怖いことを言っているんです。ああ、"}, {"type": "subtitle", "time": 17085.75, "timestamp": "04:44:45", "text": "神。それはどこにあるのですか？なくなってしまったのですか？"}, {"type": "subtitle", "time": 17089.75, "timestamp": "04:44:49", "text": "消えた。もうなくなってしまったと思う。なるほど。なるほど。私"}, {"type": "subtitle", "time": 17092.31, "timestamp": "04:44:52", "text": "見る。なるほど。なるほど。こちらです。真っ直ぐ"}, {"type": "subtitle", "time": 17094.39, "timestamp": "04:44:54", "text": "下。見る"}, {"type": "subtitle", "time": 17097.868, "timestamp": "04:44:57", "text": "これです？これです。これ"}]
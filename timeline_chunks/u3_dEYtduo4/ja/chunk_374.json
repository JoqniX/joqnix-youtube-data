[{"type": "subtitle", "time": 22441.59, "timestamp": "06:14:01", "text": "えっと、ズキがここにいました。ええ、ズキはここにいましたよ。"}, {"type": "subtitle", "time": 22450.47, "timestamp": "06:14:10", "text": "なるほど。それで、あなたはどうしたのですか？する"}, {"type": "subtitle", "time": 22454.11, "timestamp": "06:14:14", "text": "えっと、彼女は私にやり方を教えてくれた"}, {"type": "subtitle", "time": 22457.67, "timestamp": "06:14:17", "text": "農業。何てことだ。行かないで。行かないで。"}, {"type": "subtitle", "time": 22460.27, "timestamp": "06:14:20", "text": "そこにクリーパーがいる。ああ、"}, {"type": "subtitle", "time": 22462.67, "timestamp": "06:14:22", "text": "神。なんてこった。そこには"}, {"type": "subtitle", "time": 22467.31, "timestamp": "06:14:27", "text": "つる植物。気をつけて。越えた"}, {"type": "subtitle", "time": 22471.948, "timestamp": "06:14:31", "text": "そこには。それはなくなってしまった。それはなくなってしまった。ああ、できない"}, {"type": "subtitle", "time": 22484.59, "timestamp": "06:14:44", "text": "いいえ、いいえ、いいえ。待って。ええと、私たちは"}, {"type": "subtitle", "time": 22488.548, "timestamp": "06:14:48", "text": "農場だけど、作物は育てられないって言ったよね。"}, {"type": "subtitle", "time": 22499.19, "timestamp": "06:14:59", "text": "ああ、どうやら私は断食しすぎているようだ。"}]
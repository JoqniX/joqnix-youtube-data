[{"type": "subtitle", "time": 21541.67, "timestamp": "05:59:01", "text": "実際にはわからない"}, {"type": "subtitle", "time": 21545.27, "timestamp": "05:59:05", "text": "そうすれば、私に教えてくれるでしょう。何てことだ。いいえ、"}, {"type": "subtitle", "time": 21547.51, "timestamp": "05:59:07", "text": "あなたは私を迎えに来るでしょう。責任はYeahに負わせる。"}, {"type": "subtitle", "time": 21550.99, "timestamp": "05:59:10", "text": "そして、私はジョック、お前に責任を負わせるつもりだ。"}, {"type": "subtitle", "time": 21554.548, "timestamp": "05:59:14", "text": "なぜ？何てことだ。"}, {"type": "subtitle", "time": 21557.91, "timestamp": "05:59:17", "text": "待って、待って、待って、待って、待って、待って。私"}, {"type": "subtitle", "time": 21559.43, "timestamp": "05:59:19", "text": "木こりがいるから、それを壊すことができる"}, {"type": "subtitle", "time": 21564.39, "timestamp": "05:59:24", "text": "一度。ああ、クエストを壊してしまった"}, {"type": "subtitle", "time": 21567.11, "timestamp": "05:59:27", "text": "クエストエリアは木こりのせいだよ。私"}, {"type": "subtitle", "time": 21569.27, "timestamp": "05:59:29", "text": "とても気分が悪かった。"}, {"type": "subtitle", "time": 21572.948, "timestamp": "05:59:32", "text": "えっと、何だと思う？壊した、壊した、えーとドルー"}, {"type": "subtitle", "time": 21577.43, "timestamp": "05:59:37", "text": "ベース。何てことだ。そして"}, {"type": "subtitle", "time": 21580.31, "timestamp": "05:59:40", "text": "ええ、それから新しいのを召喚しました。おお。"}, {"type": "subtitle", "time": 21582.31, "timestamp": "05:59:42", "text": "バックアップとして使用しているからです"}, {"type": "subtitle", "time": 21585.35, "timestamp": "05:59:45", "text": "バージョン。だから大丈夫だよ。うん。また、"}, {"type": "subtitle", "time": 21587.91, "timestamp": "05:59:47", "text": "ネザライトスターとは何ですか？"}, {"type": "subtitle", "time": 21591.83, "timestamp": "05:59:51", "text": "する？ノーススターとかいう名前だったかな。だからそれは"}, {"type": "subtitle", "time": 21593.51, "timestamp": "05:59:53", "text": "わかった。教えてあげましょう。それはあなたを導きます"}, {"type": "subtitle", "time": 21597.11, "timestamp": "05:59:57", "text": "どこかで。探し出す。だから良い点は"}]
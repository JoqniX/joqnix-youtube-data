[{"type": "subtitle", "time": 4321.11, "timestamp": "01:12:01", "text": "画面。 3分後、画面が真っ暗になった。"}, {"type": "subtitle", "time": 4323.229, "timestamp": "01:12:03", "text": "また。黒い画面"}, {"type": "subtitle", "time": 4325.91, "timestamp": "01:12:05", "text": "また。それから私はあらゆることを試しました。それから"}, {"type": "subtitle", "time": 4329.59, "timestamp": "01:12:09", "text": "掃除中に誤ってまた"}, {"type": "subtitle", "time": 4333.27, "timestamp": "01:12:13", "text": "私の指を切ったのと同じ指が"}, {"type": "subtitle", "time": 4336.55, "timestamp": "01:12:16", "text": "ファンなしでそれを切った"}, {"type": "subtitle", "time": 4339.11, "timestamp": "01:12:19", "text": "刃がそれを切断したが、"}, {"type": "subtitle", "time": 4341.59, "timestamp": "01:12:21", "text": "扇風機の羽根を2枚折ってしまった。同じ"}, {"type": "subtitle", "time": 4346.55, "timestamp": "01:12:26", "text": "指をうっかり息を吹きかけている間に"}, {"type": "subtitle", "time": 4349.11, "timestamp": "01:12:29", "text": "ファンを吹き飛ばす。わかった。取り除くために"}, {"type": "subtitle", "time": 4352.07, "timestamp": "01:12:32", "text": "埃を、うっかり押しつぶしてしまった"}, {"type": "subtitle", "time": 4355.11, "timestamp": "01:12:35", "text": "親指で、そしてまた三番目の指で"}, {"type": "chat", "time": 4357.692, "timestamp": "01:12:37", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "okie ill be back in 2mins"}, {"type": "subtitle", "time": 4358.27, "timestamp": "01:12:38", "text": "ファンブレードが破損しました"}, {"type": "subtitle", "time": 4361.189, "timestamp": "01:12:41", "text": "また。ああ、写真を見たいですか？"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "Discordに写真を送ったと思う"}, {"type": "chat", "time": 4372.333, "timestamp": "01:12:52", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "done with dinner"}]
[{"type": "subtitle", "time": 3781.51, "timestamp": "01:03:01", "text": "誕生日は8日でした。待って、8番目？それとも7番目？"}, {"type": "subtitle", "time": 3782.91, "timestamp": "01:03:02", "text": "ええ、私が"}, {"type": "subtitle", "time": 3787.109, "timestamp": "01:03:07", "text": "それでも、ああ、8番目と7番目。ああ、私は"}, {"type": "subtitle", "time": 3789.549, "timestamp": "01:03:09", "text": "忙しい人たちはストリーミング配信を希望していた。"}, {"type": "subtitle", "time": 3792.87, "timestamp": "01:03:12", "text": "ああ、大丈夫です。こんにちは、ハッピー"}, {"type": "subtitle", "time": 3794.27, "timestamp": "01:03:14", "text": "誕生日"}, {"type": "subtitle", "time": 3797.67, "timestamp": "01:03:17", "text": "歌。待って、誕生日おめでとうってどういう意味？"}, {"type": "subtitle", "time": 3799.87, "timestamp": "01:03:19", "text": "歌は行く？"}, {"type": "subtitle", "time": 3802.95, "timestamp": "01:03:22", "text": "えっと、あなたが歌っている日本の曲は知っています"}, {"type": "subtitle", "time": 3805.069, "timestamp": "01:03:25", "text": "子供たち。私はそれをできますか？"}, {"type": "subtitle", "time": 3831.069, "timestamp": "01:03:51", "text": "お誕生日おめでとう。お誕生日おめでとう"}, {"type": "subtitle", "time": 3833.6, "timestamp": "01:03:53", "text": "あなた。お誕生日おめでとう"}, {"type": "subtitle", "time": 3835.63, "timestamp": "01:03:55", "text": "[音楽]"}, {"type": "subtitle", "time": 3838.76, "timestamp": "01:03:58", "text": "お誕生日おめでとう"}]
[{"type": "subtitle", "time": 5407.27, "timestamp": "01:30:07", "text": "学習のインセンティブとは何ですか"}, {"type": "subtitle", "time": 5410.43, "timestamp": "01:30:10", "text": "あなたが現在試している言語"}, {"type": "subtitle", "time": 5413.43, "timestamp": "01:30:13", "text": "学ぶ？もしあなたがマスターできたなら"}, {"type": "subtitle", "time": 5415.35, "timestamp": "01:30:15", "text": "あなたが破壊する言語、あなたは何をしますか？"}, {"type": "subtitle", "time": 5418.55, "timestamp": "01:30:18", "text": "それと一緒に？よし、これらは良い話題だ"}, {"type": "subtitle", "time": 5422.189, "timestamp": "01:30:22", "text": "明日、彼らは、あ、待って。土曜日"}, {"type": "subtitle", "time": 5425.59, "timestamp": "01:30:25", "text": "日曜日はチャット会だ。私はそうすべきだ"}, {"type": "subtitle", "time": 5430.27, "timestamp": "01:30:30", "text": "それ。そうするべきだ。よし、熱い"}, {"type": "subtitle", "time": 5434.95, "timestamp": "01:30:34", "text": "水。お湯の準備ができました。私は使っていません"}, {"type": "subtitle", "time": 5451.51, "timestamp": "01:30:51", "text": "今日。暑い天気のように暑い暖かい"}, {"type": "subtitle", "time": 5454.51, "timestamp": "01:30:54", "text": "暑いけど、私は"}, {"type": "subtitle", "time": 5457.79, "timestamp": "01:30:57", "text": "言語の練習をしなくてはならない。それは"}]
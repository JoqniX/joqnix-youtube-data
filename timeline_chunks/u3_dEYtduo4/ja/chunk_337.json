[{"type": "subtitle", "time": 20222.07, "timestamp": "05:37:02", "text": "ああ、ダイヤモンド付きで。ダイヤモンドが必要です"}, {"type": "subtitle", "time": 20229.75, "timestamp": "05:37:09", "text": "[音楽]"}, {"type": "subtitle", "time": 20232.47, "timestamp": "05:37:12", "text": "どうやって起き上がればいいですか？ほら、コントロールだ。おお、"}, {"type": "subtitle", "time": 20239.27, "timestamp": "05:37:19", "text": "コントロール。ええ、コントロールだけを入れました。"}, {"type": "subtitle", "time": 20243.35, "timestamp": "05:37:23", "text": "うまくいきません。もしかしたらCシフトかもしれません。"}, {"type": "subtitle", "time": 20245.07, "timestamp": "05:37:25", "text": "コントロール左"}, {"type": "subtitle", "time": 20248.948, "timestamp": "05:37:28", "text": "シフト。ああ、やったね。さあ行こう。しゃがむ。"}, {"type": "subtitle", "time": 20253.75, "timestamp": "05:37:33", "text": "ああ、なんてことだ。ニース。それは良かった。私はできる"}, {"type": "subtitle", "time": 20256.03, "timestamp": "05:37:36", "text": "実際に休息を取る。"}, {"type": "subtitle", "time": 20259.51, "timestamp": "05:37:39", "text": "くそ。あら、どうしてここにベッドが2つあるの？"}, {"type": "subtitle", "time": 20264.39, "timestamp": "05:37:44", "text": "それはいつのことですか？私は1つ入れた。"}, {"type": "subtitle", "time": 20266.59, "timestamp": "05:37:46", "text": "何てことだ。私は持っている"}, {"type": "subtitle", "time": 20269.75, "timestamp": "05:37:49", "text": "何もない。わかった。"}, {"type": "subtitle", "time": 20273.43, "timestamp": "05:37:53", "text": "うん。せめて君には脳みそがあればよかったのに。"}, {"type": "subtitle", "time": 20276.43, "timestamp": "05:37:56", "text": "ごめんなさい。それで"}]
[{"type": "subtitle", "time": 1872.89, "timestamp": "00:31:12", "text": "えーっと"}, {"type": "subtitle", "time": 1890.029, "timestamp": "00:31:30", "text": "ああ、サーバーアップデート"}, {"type": "subtitle", "time": 1901.35, "timestamp": "00:31:41", "text": "えっ？なんてこった。待って、私は2週間で何をしたの？"}, {"type": "subtitle", "time": 1904.909, "timestamp": "00:31:44", "text": "日？ダイヤモンド、ダイヤモンドの鎧を手に入れました。"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "すべて。全部セットですよね？ 2日間。"}]
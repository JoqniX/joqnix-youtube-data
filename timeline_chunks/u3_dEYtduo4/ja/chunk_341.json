[{"type": "subtitle", "time": 20461.67, "timestamp": "05:41:01", "text": "旅行者のバックパック？どちらを選びましたか？"}, {"type": "subtitle", "time": 20463.75, "timestamp": "05:41:03", "text": "追加？"}, {"type": "subtitle", "time": 20466.39, "timestamp": "05:41:06", "text": "わからない。私は自分で試したことはありません。"}, {"type": "subtitle", "time": 20470.07, "timestamp": "05:41:10", "text": "もし私が始めたばかりで、皆さんにプレイさせてみたらどうでしょう。"}, {"type": "subtitle", "time": 20471.868, "timestamp": "05:41:11", "text": "はい、確認する必要があります"}, {"type": "subtitle", "time": 20474.15, "timestamp": "05:41:14", "text": "何をすべきかの指示。欲しい"}, {"type": "subtitle", "time": 20475.98, "timestamp": "05:41:15", "text": "クッキー。"}, {"type": "subtitle", "time": 20492.548, "timestamp": "05:41:32", "text": "かわいい。ジョー、ボートを貸してくれる？"}, {"type": "subtitle", "time": 20501.43, "timestamp": "05:41:41", "text": "それは何ですか？"}]
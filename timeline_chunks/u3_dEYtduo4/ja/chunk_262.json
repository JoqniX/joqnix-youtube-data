[{"type": "subtitle", "time": 15723.91, "timestamp": "04:22:03", "text": "スライド。そしてダイヤモンドブーツは、ああ、そうだった。"}, {"type": "subtitle", "time": 15726.389, "timestamp": "04:22:06", "text": "あなたは弾むような感じを与えた。では、それを使います。そして"}, {"type": "subtitle", "time": 15729.349, "timestamp": "04:22:09", "text": "金色のブーツを履いたもの"}, {"type": "subtitle", "time": 15733.63, "timestamp": "04:22:13", "text": "1つは、1つはボンのブイでした"}, {"type": "subtitle", "time": 15737.309, "timestamp": "04:22:17", "text": "あれ。もう一つは"}, {"type": "subtitle", "time": 15743.03, "timestamp": "04:22:23", "text": "ゲイル。道に迷ったら教えてください。"}, {"type": "subtitle", "time": 15746.269, "timestamp": "04:22:26", "text": "それはただ、ああ、あなたは昇天した"}, {"type": "subtitle", "time": 15750.469, "timestamp": "04:22:30", "text": "すべて。よし、水陸両用スライド発射。"}, {"type": "subtitle", "time": 15752.95, "timestamp": "04:22:32", "text": "ファンシー。わかった。剣を取り戻しに戻ってきた。"}, {"type": "subtitle", "time": 15754.75, "timestamp": "04:22:34", "text": "爆発する"}, {"type": "subtitle", "time": 15756.75, "timestamp": "04:22:36", "text": "クロスボウ"}, {"type": "subtitle", "time": 15759.91, "timestamp": "04:22:39", "text": "斧。そうそう。これ。そうそう。"}, {"type": "subtitle", "time": 15763.429, "timestamp": "04:22:43", "text": "えーと、アンカーについては、"}, {"type": "subtitle", "time": 15766.87, "timestamp": "04:22:46", "text": "あれをやれ。ええと、でも私はそうは思わない"}, {"type": "subtitle", "time": 15770.55, "timestamp": "04:22:50", "text": "それもカウントされますよね？動揺。"}, {"type": "subtitle", "time": 15773.83, "timestamp": "04:22:53", "text": "ところで、えーと、えーと、"}, {"type": "subtitle", "time": 15775.51, "timestamp": "04:22:55", "text": "食品。君なら手に入れられるよね？私"}, {"type": "subtitle", "time": 15776.79, "timestamp": "04:22:56", "text": "あなたにすべての食べ物を与える必要はありません"}, {"type": "subtitle", "time": 15778.55, "timestamp": "04:22:58", "text": "アイテムですよね？私はただ魚をあげて"}]
[{"type": "subtitle", "time": 15001.51, "timestamp": "04:10:01", "text": "山積みのパン。ところで、私も"}, {"type": "subtitle", "time": 15004.389, "timestamp": "04:10:04", "text": "まもなく配信を終了します。あなたはしたい"}, {"type": "subtitle", "time": 15007.75, "timestamp": "04:10:07", "text": "ストリーム？今、配信中です。"}, {"type": "subtitle", "time": 15010.15, "timestamp": "04:10:10", "text": "あ、待って。今、ストリーミング配信中ですか？"}, {"type": "subtitle", "time": 15012.229, "timestamp": "04:10:12", "text": "はい。知らなかったの？いいえ。こんにちは。"}, {"type": "subtitle", "time": 15019.189, "timestamp": "04:10:19", "text": "ザック。私は自分のことに気を取られすぎていた"}, {"type": "subtitle", "time": 15022.11, "timestamp": "04:10:22", "text": "ストリームと歌と"}, {"type": "subtitle", "time": 15025.429, "timestamp": "04:10:25", "text": "すべて。いえ、問題ありません。私はとても"}, {"type": "subtitle", "time": 15028.469, "timestamp": "04:10:28", "text": "でも幸せだ。理由がわからない。ついに"}, {"type": "subtitle", "time": 15031.349, "timestamp": "04:10:31", "text": "会員登録しました。私はこう思った"}, {"type": "subtitle", "time": 15033.99, "timestamp": "04:10:33", "text": "行く。まだ手に入れていませんが、とても"}, {"type": "subtitle", "time": 15035.91, "timestamp": "04:10:35", "text": "努力して手に入れたので嬉しいです"}, {"type": "subtitle", "time": 15037.87, "timestamp": "04:10:37", "text": "難しい。"}, {"type": "subtitle", "time": 15049.99, "timestamp": "04:10:49", "text": "アップデートの方法はすべて追加されます"}, {"type": "subtitle", "time": 15052.309, "timestamp": "04:10:52", "text": "サーバー上で、私はこう思う、"}, {"type": "subtitle", "time": 15055.349, "timestamp": "04:10:55", "text": "IOと一緒に寝る。とても良いので"}, {"type": "subtitle", "time": 15059.51, "timestamp": "04:10:59", "text": "今はバックパックが必要です。何てことだ。負けました"}]
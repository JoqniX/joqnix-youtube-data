[{"type": "subtitle", "time": 20587.19, "timestamp": "05:43:07", "text": "私はそんなに馬鹿じゃない。"}, {"type": "subtitle", "time": 20593.35, "timestamp": "05:43:13", "text": "バカ？来て。来て。やってみよう"}, {"type": "subtitle", "time": 20594.73, "timestamp": "05:43:14", "text": "正しいこと。"}, {"type": "subtitle", "time": 20597.59, "timestamp": "05:43:17", "text": "[音楽]"}, {"type": "subtitle", "time": 20600.31, "timestamp": "05:43:20", "text": "わあ、すごい。何？何？何？何？何"}, {"type": "subtitle", "time": 20603.59, "timestamp": "05:43:23", "text": "あれはそうだったのか？それは嘘だった。それは嘘だった。"}, {"type": "subtitle", "time": 20605.35, "timestamp": "05:43:25", "text": "うん。"}, {"type": "subtitle", "time": 20608.88, "timestamp": "05:43:28", "text": "ああ、神様。お二人とも。"}, {"type": "subtitle", "time": 20610.15, "timestamp": "05:43:30", "text": "[音楽]"}, {"type": "subtitle", "time": 20620.15, "timestamp": "05:43:40", "text": "ああ、わかりました。これ、すごく可愛い。こちらはYです。"}, {"type": "subtitle", "time": 20622.15, "timestamp": "05:43:42", "text": "配信できたらよかったのに。なんてこった？"}, {"type": "subtitle", "time": 20625.2, "timestamp": "05:43:45", "text": "これ、すごく可愛い。"}, {"type": "subtitle", "time": 20630.868, "timestamp": "05:43:50", "text": "くそ。"}, {"type": "subtitle", "time": 20634.03, "timestamp": "05:43:54", "text": "ウォータースライダーを作る方法はありますか、または"}, {"type": "subtitle", "time": 20636.31, "timestamp": "05:43:56", "text": "何か？私たちはそうすべきです、または"}, {"type": "subtitle", "time": 20638.548, "timestamp": "05:43:58", "text": "速いみたいな感じ。あのね？あなた"}, {"type": "subtitle", "time": 20639.948, "timestamp": "05:43:59", "text": "水を作ることができる"}]
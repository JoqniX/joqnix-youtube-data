[{"type": "subtitle", "time": 16560.709, "timestamp": "04:36:00", "text": "リサイクルボックスはそこにあります。わーい。あなたはできる"}, {"type": "subtitle", "time": 16563.91, "timestamp": "04:36:03", "text": "もっと小さいものを作ってください。ミツキはその中で亡くなる"}, {"type": "subtitle", "time": 16566.31, "timestamp": "04:36:06", "text": "1つ。"}, {"type": "subtitle", "time": 16569.99, "timestamp": "04:36:09", "text": "何か行動を起こします。私と来て。"}, {"type": "subtitle", "time": 16573.189, "timestamp": "04:36:13", "text": "ログアウトしないといけません。"}, {"type": "subtitle", "time": 16578.39, "timestamp": "04:36:18", "text": "もうすぐ出発します。私はそうではない"}, {"type": "subtitle", "time": 16580.869, "timestamp": "04:36:20", "text": "長く滞在するつもりだ。私は集中していました"}, {"type": "subtitle", "time": 16583.839, "timestamp": "04:36:23", "text": "そして、私はそれを手に入れることができた。"}, {"type": "subtitle", "time": 16586.23, "timestamp": "04:36:26", "text": "[音楽]"}, {"type": "subtitle", "time": 16589.109, "timestamp": "04:36:29", "text": "階段がまだ残っていてよかった。私"}, {"type": "subtitle", "time": 16601.67, "timestamp": "04:36:41", "text": "神。これはドラゴンの翼のように見える。おお、"}, {"type": "subtitle", "time": 16603.59, "timestamp": "04:36:43", "text": "この花。この大きな花は何"}, {"type": "subtitle", "time": 16605.269, "timestamp": "04:36:45", "text": "する？"}, {"type": "subtitle", "time": 16616.15, "timestamp": "04:36:56", "text": "ああ、なぜ私たちのキャンプファイヤーは"}, {"type": "subtitle", "time": 16618.47, "timestamp": "04:36:58", "text": "真ん中にブロックがある？なぜ？それは何ですか"}]
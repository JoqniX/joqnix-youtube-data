[{"type": "subtitle", "time": 4080.63, "timestamp": "01:08:00", "text": "いや、私と安定している"}, {"type": "subtitle", "time": 4082.71, "timestamp": "01:08:02", "text": "口笛を吹く小川。いいえ、口笛だと思います"}, {"type": "subtitle", "time": 4086.51, "timestamp": "01:08:06", "text": "新しい設定のストリームは、"}, {"type": "subtitle", "time": 4089.43, "timestamp": "01:08:09", "text": "推測。うん。そして、それは順調に進んでいた。それから"}, {"type": "subtitle", "time": 4092.39, "timestamp": "01:08:12", "text": "すると私はなぜか待って"}, {"type": "subtitle", "time": 4095.27, "timestamp": "01:08:15", "text": "私は毎日パソコンの前に来なければならない"}, {"type": "subtitle", "time": 4098.229, "timestamp": "01:08:18", "text": "毎朝7時に始めて"}, {"type": "subtitle", "time": 4100.63, "timestamp": "01:08:20", "text": "仕事や何かをして準備する"}, {"type": "subtitle", "time": 4102.55, "timestamp": "01:08:22", "text": "物事と練習。だから私はこう思った"}, {"type": "subtitle", "time": 4104.709, "timestamp": "01:08:24", "text": "自動起動の設定をします"}, {"type": "subtitle", "time": 4108.709, "timestamp": "01:08:28", "text": "私のPCにはBを入れます。それで私はそれをやって"}, {"type": "subtitle", "time": 4111.59, "timestamp": "01:08:31", "text": "翌日目が覚めると、それは起きていなかった。それで"}, {"type": "subtitle", "time": 4114.709, "timestamp": "01:08:34", "text": "陸上では、えーと、航跡を使わないといけないんです。あなたが知っている、"}, {"type": "subtitle", "time": 4117.269, "timestamp": "01:08:37", "text": "携帯電話を使って送信できます"}, {"type": "subtitle", "time": 4120.229, "timestamp": "01:08:40", "text": "パソコンを起動してくださいね？私はそれをしました。それから"}, {"type": "subtitle", "time": 4123.669, "timestamp": "01:08:43", "text": "私は、外出する必要があったと思います。それから私は"}, {"type": "subtitle", "time": 4126.03, "timestamp": "01:08:46", "text": "外出とか色々。それから私は"}, {"type": "subtitle", "time": 4130.07, "timestamp": "01:08:50", "text": "音楽が流れていることに気づいた"}, {"type": "subtitle", "time": 4132.59, "timestamp": "01:08:52", "text": "スピーカーを通してですが、ディスプレイは"}, {"type": "subtitle", "time": 4136.149, "timestamp": "01:08:56", "text": "何らかの理由でオフになっています。空白です。そして私は"}, {"type": "subtitle", "time": 4139.229, "timestamp": "01:08:59", "text": "PCを再起動したら、"}]
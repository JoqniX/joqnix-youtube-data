[{"type": "subtitle", "time": 17521.27, "timestamp": "04:52:01", "text": "うん。スーパージャンプして移動しましたか？"}, {"type": "subtitle", "time": 17523.59, "timestamp": "04:52:03", "text": "もっと早く？"}, {"type": "subtitle", "time": 17527.51, "timestamp": "04:52:07", "text": "私は、私の否定が落ちるのを否定できます"}, {"type": "subtitle", "time": 17530.15, "timestamp": "04:52:10", "text": "ダメージ？"}, {"type": "subtitle", "time": 17533.47, "timestamp": "04:52:13", "text": "君ならできるよ。 C を保持"}, {"type": "subtitle", "time": 17550.91, "timestamp": "04:52:30", "text": "知りませんでした"}, {"type": "subtitle", "time": 17554.07, "timestamp": "04:52:34", "text": "それ。うん。完全に出来上がるまで保持してください"}, {"type": "subtitle", "time": 17557.55, "timestamp": "04:52:37", "text": "オレンジ色か黄色になるまで"}, {"type": "subtitle", "time": 17568.788, "timestamp": "04:52:48", "text": "基地に戻りましょう。見つけた。"}, {"type": "subtitle", "time": 17572.23, "timestamp": "04:52:52", "text": "簡単でしょう？"}]
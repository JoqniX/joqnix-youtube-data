[{"type": "subtitle", "time": 19680.628, "timestamp": "05:28:00", "text": "2つの動作スタイルとスライド式"}, {"type": "subtitle", "time": 19683.628, "timestamp": "05:28:03", "text": "とても良いですね、ほら、私は"}, {"type": "subtitle", "time": 19689.31, "timestamp": "05:28:09", "text": "右にスライドするが、これを手に入れたら"}, {"type": "subtitle", "time": 19704.43, "timestamp": "05:28:24", "text": "良い。私はすでに動きがあります"}, {"type": "subtitle", "time": 19707.11, "timestamp": "05:28:27", "text": "アドバンテージ？つまり、もちろん、"}, {"type": "subtitle", "time": 19719.43, "timestamp": "05:28:39", "text": "でも時々行き詰まってしまう、"}, {"type": "subtitle", "time": 19724.15, "timestamp": "05:28:44", "text": "聞こえません。ああ、こんにちは。"}, {"type": "subtitle", "time": 19726.91, "timestamp": "05:28:46", "text": "こんにちは、ジョー。"}, {"type": "subtitle", "time": 19730.948, "timestamp": "05:28:50", "text": "こんにちは。私は元気です。"}, {"type": "subtitle", "time": 19732.708, "timestamp": "05:28:52", "text": "元気ですか？"}, {"type": "subtitle", "time": 19733.548, "timestamp": "05:28:53", "text": "私は"}, {"type": "subtitle", "time": 19737.83, "timestamp": "05:28:57", "text": "昨日は泣いたけど、今は幸せです。"}]
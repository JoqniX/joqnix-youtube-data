[{"type": "subtitle", "time": 22207.19, "timestamp": "06:10:07", "text": "シーズン2では、シーズン2を追加する必要があります"}, {"type": "subtitle", "time": 22209.03, "timestamp": "06:10:09", "text": "プレイヤーのカスタマイズ機能を追加すべきだ"}, {"type": "subtitle", "time": 22212.948, "timestamp": "06:10:12", "text": "V2用のものやその他すべて"}, {"type": "subtitle", "time": 22217.03, "timestamp": "06:10:17", "text": "えっと、シーズン2をやるときに送ります"}, {"type": "subtitle", "time": 22218.948, "timestamp": "06:10:18", "text": "自分のものを手に入れる前に私は"}, {"type": "subtitle", "time": 22226.708, "timestamp": "06:10:26", "text": "でも、そうするべきだね、君にもあげるよ"}, {"type": "subtitle", "time": 22230.15, "timestamp": "06:10:30", "text": "あなたが見たいと思うビデオ"}, {"type": "subtitle", "time": 22232.948, "timestamp": "06:10:32", "text": "他のユーチューバー"}, {"type": "subtitle", "time": 22235.708, "timestamp": "06:10:35", "text": "尻尾を付けることができます"}, {"type": "subtitle", "time": 22238.15, "timestamp": "06:10:38", "text": "マインクラフトはドラゴンの尻尾みたいな感じ"}, {"type": "subtitle", "time": 22240.39, "timestamp": "06:10:40", "text": "どのような"}, {"type": "subtitle", "time": 22242.47, "timestamp": "06:10:42", "text": "あなたにはそれができます。よし、問題は私が"}, {"type": "subtitle", "time": 22245.59, "timestamp": "06:10:45", "text": "まず、たくさんのものを手に入れました。私は"}, {"type": "subtitle", "time": 22247.27, "timestamp": "06:10:47", "text": "多くの人が制限されている"}, {"type": "subtitle", "time": 22249.75, "timestamp": "06:10:49", "text": "あなたと同じように新しい。だからとても"}, {"type": "subtitle", "time": 22255.19, "timestamp": "06:10:55", "text": "彼女にとっては圧倒的な負担だった。ああ、確かにそうだね。"}, {"type": "subtitle", "time": 22258.07, "timestamp": "06:10:58", "text": "君は新人選手だって言ったばかりだよ。私"}]
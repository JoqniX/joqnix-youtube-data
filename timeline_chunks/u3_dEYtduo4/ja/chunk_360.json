[{"type": "subtitle", "time": 21600.628, "timestamp": "06:00:00", "text": "彼は私たちに郵便で何かを送ってくれた。"}, {"type": "subtitle", "time": 21602.708, "timestamp": "06:00:02", "text": "理由がわからない。"}, {"type": "subtitle", "time": 21606.39, "timestamp": "06:00:06", "text": "ちょっと待って、見せて。彼はあなたに何をくれたの？"}, {"type": "subtitle", "time": 21610.07, "timestamp": "06:00:10", "text": "彼は私たちに、どこにあるか忘れたようなものをくれました。"}, {"type": "subtitle", "time": 21612.23, "timestamp": "06:00:12", "text": "でも、それはネザライトスターみたいだった"}, {"type": "subtitle", "time": 21613.39, "timestamp": "06:00:13", "text": "または"}, {"type": "subtitle", "time": 21615.99, "timestamp": "06:00:15", "text": "何か。どちらでもないですよね？待って。えっと、"}, {"type": "subtitle", "time": 21617.868, "timestamp": "06:00:17", "text": "どこ"}, {"type": "subtitle", "time": 21620.91, "timestamp": "06:00:20", "text": "それ？ソウルスター。魂"}, {"type": "subtitle", "time": 21629.11, "timestamp": "06:00:29", "text": "ソウルスターは何をするのか？それはあなたを導く。"}, {"type": "subtitle", "time": 21630.99, "timestamp": "06:00:30", "text": "結局はこうなるんだ。それはあなたを導きます"}, {"type": "subtitle", "time": 21645.83, "timestamp": "06:00:45", "text": "こちらはあなたのメールボックスです。いいえ、しかし、しかし、"}, {"type": "subtitle", "time": 21649.67, "timestamp": "06:00:49", "text": "次はジョックが欲しい。"}, {"type": "subtitle", "time": 21654.27, "timestamp": "06:00:54", "text": "自分で作ることができます。ああ、工芸。"}, {"type": "subtitle", "time": 21658.628, "timestamp": "06:00:58", "text": "わかった。私はドラゴノスが大好きです。メールは"}]
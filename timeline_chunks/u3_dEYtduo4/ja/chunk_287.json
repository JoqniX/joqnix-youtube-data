[{"type": "subtitle", "time": 17222.708, "timestamp": "04:47:02", "text": "私がそれをどこで手に入れたか。そのポトリー"}, {"type": "subtitle", "time": 17226.75, "timestamp": "04:47:06", "text": "あれのことですよね？たくさん手に入れました"}, {"type": "subtitle", "time": 17239.15, "timestamp": "04:47:19", "text": "音声に頻繁にノイズが入ります。そうです。何？"}, {"type": "subtitle", "time": 17262.47, "timestamp": "04:47:42", "text": "いいえ、それは時々起こります"}, {"type": "subtitle", "time": 17264.19, "timestamp": "04:47:44", "text": "数日後"}, {"type": "subtitle", "time": 17279.59, "timestamp": "04:47:59", "text": "その趣味は、今日まで私にはまだ縁がありませんでした。"}]
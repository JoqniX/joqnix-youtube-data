[{"type": "subtitle", "time": 5584.47, "timestamp": "01:33:04", "text": "リバーブがかかった。歌を歌うにはどうすればいいですか？"}, {"type": "subtitle", "time": 5587.03, "timestamp": "01:33:07", "text": "もう一度配信しますか？忘れた。そしてこれも"}, {"type": "subtitle", "time": 5589.31, "timestamp": "01:33:09", "text": "明らかなチャマは"}, {"type": "subtitle", "time": 5592.189, "timestamp": "01:33:12", "text": "壊れた。おい、お前は壊れてるぞ。"}, {"type": "subtitle", "time": 5595.229, "timestamp": "01:33:15", "text": "D. わかった、彼は"}, {"type": "subtitle", "time": 5597.07, "timestamp": "01:33:17", "text": "亡くなった。"}, {"type": "subtitle", "time": 5598.5, "timestamp": "01:33:18", "text": "さようなら。わかった。"}, {"type": "subtitle", "time": 5599.79, "timestamp": "01:33:19", "text": "[音楽]"}, {"type": "subtitle", "time": 5603.03, "timestamp": "01:33:23", "text": "えっと、こんにちは。 2回目の配信をしましょう。"}, {"type": "subtitle", "time": 5603.87, "timestamp": "01:33:23", "text": "そしてそして"}, {"type": "subtitle", "time": 5606.199, "timestamp": "01:33:26", "text": "そして ブラウジッシャー。私は本当に新しいものを作る必要がある"}, {"type": "subtitle", "time": 5609.04, "timestamp": "01:33:29", "text": "ブラウジッシャー。私は本当に新しいものを作る必要がある そのためのシーン。実際、複製します"}, {"type": "subtitle", "time": 5611.04, "timestamp": "01:33:31", "text": "そのためのシーン。実際、複製します あなたとあなたに電話をかけさせます"}, {"type": "subtitle", "time": 5614.37, "timestamp": "01:33:34", "text": "あなたとあなたに電話をかけさせます [音楽]"}, {"type": "subtitle", "time": 5637.82, "timestamp": "01:33:57", "text": "そこ。"}, {"type": "subtitle", "time": 5639.07, "timestamp": "01:33:59", "text": "[音楽]"}]
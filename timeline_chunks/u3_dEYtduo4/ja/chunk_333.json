[{"type": "subtitle", "time": 19982.548, "timestamp": "05:33:02", "text": "私が持っているものを見てください。だから私は"}, {"type": "subtitle", "time": 19986.15, "timestamp": "05:33:06", "text": "溶けたものが必要だ。えっと、これ持ってます。"}, {"type": "subtitle", "time": 19989.03, "timestamp": "05:33:09", "text": "私はこれを持っています。今、何が必要ですか？このモル"}, {"type": "subtitle", "time": 19991.67, "timestamp": "05:33:11", "text": "モレン。ジョー、あなたは保存できます"}, {"type": "subtitle", "time": 19994.868, "timestamp": "05:33:14", "text": "あなたの上にたくさんの水や溶岩やミルク"}, {"type": "subtitle", "time": 19998.39, "timestamp": "05:33:18", "text": "バックパック。しかし、バケツ。どのように"}, {"type": "subtitle", "time": 20001.59, "timestamp": "05:33:21", "text": "アップグレード作業ですか？"}, {"type": "subtitle", "time": 20003.35, "timestamp": "05:33:23", "text": "ええと、自分で考えなければなりません。待って、君"}, {"type": "subtitle", "time": 20005.75, "timestamp": "05:33:25", "text": "モルが必要です。えっと、何が必要なんですか？モルトン。"}, {"type": "subtitle", "time": 20009.35, "timestamp": "05:33:29", "text": "モルトン。うん。待って、待って、"}, {"type": "subtitle", "time": 20012.628, "timestamp": "05:33:32", "text": "1秒。なぜあなたは死なないのですか？"}, {"type": "subtitle", "time": 20014.788, "timestamp": "05:33:34", "text": "それは、相手をよろめかせる武器だ。えっと、あなたは"}, {"type": "subtitle", "time": 20018.83, "timestamp": "05:33:38", "text": "サブスパイダーマンになるはずだった。"}, {"type": "subtitle", "time": 20029.03, "timestamp": "05:33:49", "text": "飛べよ、兄弟。真剣に。"}, {"type": "subtitle", "time": 20034.59, "timestamp": "05:33:54", "text": "真剣に。そして"}, {"type": "subtitle", "time": 20039.82, "timestamp": "05:33:59", "text": "神のために麦芽と絹を。ありがとう。"}]
[{"type": "subtitle", "time": 2160.79, "timestamp": "00:36:00", "text": "1つ。 Sparkもそれほど良くはなかった。ええ、スポックは"}, {"type": "subtitle", "time": 2188.71, "timestamp": "00:36:28", "text": "えっと、もし私が"}, {"type": "subtitle", "time": 2204.47, "timestamp": "00:36:44", "text": "ええ、私のチームメイトは"}, {"type": "subtitle", "time": 2211.15, "timestamp": "00:36:51", "text": "今。私はしません"}, {"type": "subtitle", "time": 2213.87, "timestamp": "00:36:53", "text": "知る。待って、ミツキだ"}, {"type": "subtitle", "time": 2216.36, "timestamp": "00:36:56", "text": "ストリーミング配信。何？何？彼女は何者ですか？"}, {"type": "subtitle", "time": 2217.55, "timestamp": "00:36:57", "text": "[音楽]"}]
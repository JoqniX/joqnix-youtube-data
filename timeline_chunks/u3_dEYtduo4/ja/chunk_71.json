[{"type": "subtitle", "time": 4260.31, "timestamp": "01:11:00", "text": "壊れた。まるで歯が抜け落ちるようなものだ。"}, {"type": "subtitle", "time": 4262.87, "timestamp": "01:11:02", "text": "何てことだ。"}, {"type": "subtitle", "time": 4266.75, "timestamp": "01:11:06", "text": "ええ、ファンブレードが2枚折れました"}, {"type": "subtitle", "time": 4268.75, "timestamp": "01:11:08", "text": "そしてああ"}, {"type": "subtitle", "time": 4272.39, "timestamp": "01:11:12", "text": "少年と私はそれを取り外したが、"}, {"type": "subtitle", "time": 4276.31, "timestamp": "01:11:16", "text": "20 uh 1660 スーパーで作業してから、"}, {"type": "subtitle", "time": 4279.669, "timestamp": "01:11:19", "text": "わかった、後でやるよ"}, {"type": "subtitle", "time": 4281.91, "timestamp": "01:11:21", "text": "えっと、机とか全部掃除して"}, {"type": "subtitle", "time": 4284.63, "timestamp": "01:11:24", "text": "1時間後に元に戻して、私はそれをやった"}, {"type": "subtitle", "time": 4286.55, "timestamp": "01:11:26", "text": "そして私は「ああ、うまくいくはずだ」と思った。"}, {"type": "subtitle", "time": 4289.35, "timestamp": "01:11:29", "text": "うまくいくはずなのに、私は祈ったのに、"}, {"type": "subtitle", "time": 4291.51, "timestamp": "01:11:31", "text": "26を使いたい"}, {"type": "subtitle", "time": 4294.63, "timestamp": "01:11:34", "text": "1660 を使いたくないのですが"}, {"type": "subtitle", "time": 4298.63, "timestamp": "01:11:38", "text": "ストリーミング配信は苦痛だから。私のFPS D。"}, {"type": "subtitle", "time": 4301.91, "timestamp": "01:11:41", "text": "2016年にフォートナイトをプレイしました。私の200"}, {"type": "subtitle", "time": 4305.51, "timestamp": "01:11:45", "text": "FPS、それが必要なんだ。私は"}, {"type": "subtitle", "time": 4307.39, "timestamp": "01:11:47", "text": "神。"}, {"type": "subtitle", "time": 4308.82, "timestamp": "01:11:48", "text": "D"}, {"type": "subtitle", "time": 4310.03, "timestamp": "01:11:50", "text": "[音楽]"}, {"type": "subtitle", "time": 4313.63, "timestamp": "01:11:53", "text": "FPS。しかし残念ながら、"}, {"type": "subtitle", "time": 4317.669, "timestamp": "01:11:57", "text": "ああ、起動したよ。私はブーツを見た"}]
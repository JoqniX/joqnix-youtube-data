[{"type": "subtitle", "time": 18002.948, "timestamp": "05:00:02", "text": "学ぶ。申し訳ありません。また、ポットは"}, {"type": "subtitle", "time": 18004.47, "timestamp": "05:00:04", "text": "ここ。私はどこに行きたいですか？どこに行きたいですか？"}, {"type": "subtitle", "time": 18009.67, "timestamp": "05:00:09", "text": "ここ。港。ポートを設置しました。さあ"}, {"type": "subtitle", "time": 18012.07, "timestamp": "05:00:12", "text": "ここに置いておいてください。"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "[音楽]"}, {"type": "subtitle", "time": 18016.47, "timestamp": "05:00:16", "text": "この調子で続けよう。よし、じゃあ私が始めるよ"}, {"type": "subtitle", "time": 18024.788, "timestamp": "05:00:24", "text": "ああ、眠くなってきた。"}, {"type": "subtitle", "time": 18025.868, "timestamp": "05:00:25", "text": "しかし"}, {"type": "subtitle", "time": 18031.27, "timestamp": "05:00:31", "text": "ミツキが参加するなら、"}, {"type": "subtitle", "time": 18034.23, "timestamp": "05:00:34", "text": "ああ、怖いよ。何てことだ、"}, {"type": "subtitle", "time": 18038.15, "timestamp": "05:00:38", "text": "あなたには良いものがすべて揃っていて、"}, {"type": "subtitle", "time": 18041.31, "timestamp": "05:00:41", "text": "オープン。いいえ、私はただ作業するつもりです"}, {"type": "subtitle", "time": 18044.19, "timestamp": "05:00:44", "text": "それ。ちょっと待って。火"}, {"type": "subtitle", "time": 18047.43, "timestamp": "05:00:47", "text": "側面。水陸両用木こり。待って、私は"}, {"type": "subtitle", "time": 18049.39, "timestamp": "05:00:49", "text": "実際、これら全て持っています。"}]
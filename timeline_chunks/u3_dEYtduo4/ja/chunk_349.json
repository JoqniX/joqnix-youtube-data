[{"type": "subtitle", "time": 20942.868, "timestamp": "05:49:02", "text": "よし、これでウォータースライダーができたぞ。わーい。私"}, {"type": "subtitle", "time": 20946.788, "timestamp": "05:49:06", "text": "行きたいです。"}, {"type": "subtitle", "time": 20949.67, "timestamp": "05:49:09", "text": "あなたはただ"}, {"type": "subtitle", "time": 20954.27, "timestamp": "05:49:14", "text": "私はできません。はい、どうぞ。私"}, {"type": "subtitle", "time": 20959.59, "timestamp": "05:49:19", "text": "ああ、実は待つことができます。ミツキーのために"}, {"type": "subtitle", "time": 20962.31, "timestamp": "05:49:22", "text": "さて、えっと、どう思いますか？"}, {"type": "subtitle", "time": 20964.788, "timestamp": "05:49:24", "text": "レギンスの方がいいですね"}, {"type": "subtitle", "time": 20968.35, "timestamp": "05:49:28", "text": "アドレナリンのようなものを求めてさまよう、"}, {"type": "subtitle", "time": 20971.91, "timestamp": "05:49:31", "text": "彼女にとってどう思うか"}, {"type": "subtitle", "time": 20974.23, "timestamp": "05:49:34", "text": "保護？"}, {"type": "subtitle", "time": 20976.868, "timestamp": "05:49:36", "text": "誰でも好きなもの"}, {"type": "subtitle", "time": 20977.628, "timestamp": "05:49:37", "text": "仕事"}, {"type": "subtitle", "time": 20980.47, "timestamp": "05:49:40", "text": "大丈夫、そして彼女は死ぬかもしれない"}, {"type": "subtitle", "time": 20982.788, "timestamp": "05:49:42", "text": "そして、ご存知のように"}, {"type": "subtitle", "time": 20986.07, "timestamp": "05:49:46", "text": "ねえ、聞こえてるよ。聞こえますよ。"}, {"type": "subtitle", "time": 20987.83, "timestamp": "05:49:47", "text": "移動速度は向上すると思います。"}, {"type": "subtitle", "time": 20990.948, "timestamp": "05:49:50", "text": "だから彼女は今、より速く動けるようになった。しかしスライドは"}, {"type": "subtitle", "time": 20994.47, "timestamp": "05:49:54", "text": "はるかに良い。うん、スライドの方がいいね。おお"}, {"type": "subtitle", "time": 20998.31, "timestamp": "05:49:58", "text": "神様、スライドを手に入れてください。"}]
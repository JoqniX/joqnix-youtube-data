[{"type": "subtitle", "time": 17847.51, "timestamp": "04:57:27", "text": "こんにちは。ああ、こんにちは。"}, {"type": "subtitle", "time": 17850.39, "timestamp": "04:57:30", "text": "ええ、ここにいますよ。私はここにいます。 1秒。"}, {"type": "subtitle", "time": 17860.868, "timestamp": "04:57:40", "text": "何？アップグレードできるなんて知らなかった"}, {"type": "subtitle", "time": 17867.19, "timestamp": "04:57:47", "text": "わかった。また、鍛冶屋もいます"}, {"type": "subtitle", "time": 17875.51, "timestamp": "04:57:55", "text": "ああ、それはミト・ミツキーの、あの"}, {"type": "subtitle", "time": 17878.628, "timestamp": "04:57:58", "text": "ミツキーのやつと一緒にいた。だから、それを"}]
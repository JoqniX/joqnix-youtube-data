[{"type": "subtitle", "time": 3601.829, "timestamp": "01:00:01", "text": "昨年行ったボディカメラ配信。何ですか"}, {"type": "subtitle", "time": 3603.51, "timestamp": "01:00:03", "text": "えっと、何曜日だったっけ？何"}, {"type": "subtitle", "time": 3606.789, "timestamp": "01:00:06", "text": "月？ 7月～6月期。その時が来た"}, {"type": "subtitle", "time": 3611.03, "timestamp": "01:00:11", "text": "そのパソコンは壊れた。 G CPU、6年後。"}, {"type": "subtitle", "time": 3615.03, "timestamp": "01:00:15", "text": "いいえ、5年です。 5年以上経って枯れてしまった。"}, {"type": "subtitle", "time": 3617.15, "timestamp": "01:00:17", "text": "5年。なし"}, {"type": "subtitle", "time": 3618.75, "timestamp": "01:00:18", "text": "そこには。"}, {"type": "subtitle", "time": 3623.43, "timestamp": "01:00:23", "text": "えっと、それで私は、ほとんど"}, {"type": "subtitle", "time": 3626.71, "timestamp": "01:00:26", "text": "私のゲームからすべてが死んだ"}, {"type": "subtitle", "time": 3630.15, "timestamp": "01:00:30", "text": "ジョッキーPC初期ジョッキーPC時代右"}, {"type": "subtitle", "time": 3633.27, "timestamp": "01:00:33", "text": "ほとんどすべてが死んでしまいました。こんにちは、ようこそ"}, {"type": "subtitle", "time": 3635.51, "timestamp": "01:00:35", "text": "ストリーム"}, {"type": "subtitle", "time": 3638.069, "timestamp": "01:00:38", "text": "えっと、お元気ですか？"}, {"type": "subtitle", "time": 3640.549, "timestamp": "01:00:40", "text": "元気でいることを願っています。ようこそ。"}, {"type": "subtitle", "time": 3643.349, "timestamp": "01:00:43", "text": "皆さんを歓迎するのを忘れていました。"}, {"type": "subtitle", "time": 3646.349, "timestamp": "01:00:46", "text": "金曜日は順調なので、そうですね"}, {"type": "subtitle", "time": 3650.309, "timestamp": "01:00:50", "text": "えっと、RAMが壊れたと思います。そうしなければならなかった"}, {"type": "subtitle", "time": 3654.309, "timestamp": "01:00:54", "text": "RAMを交換してください。いいえ、"}, {"type": "subtitle", "time": 3656.39, "timestamp": "01:00:56", "text": "マザーボードはまだ動いている。はい、"}]
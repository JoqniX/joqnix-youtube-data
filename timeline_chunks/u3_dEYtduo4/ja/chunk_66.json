[{"type": "subtitle", "time": 3961.829, "timestamp": "01:06:01", "text": "集中的で、その流れの中でも、"}, {"type": "subtitle", "time": 3963.23, "timestamp": "01:06:03", "text": "の"}, {"type": "subtitle", "time": 3968.39, "timestamp": "01:06:08", "text": "PCが壊れた、つまりシャットダウンした"}, {"type": "subtitle", "time": 3971.15, "timestamp": "01:06:11", "text": "そのシングルで7回"}, {"type": "subtitle", "time": 3975.029, "timestamp": "01:06:15", "text": "ストリーム。私はどういうわけか"}, {"type": "subtitle", "time": 3977.67, "timestamp": "01:06:17", "text": "「うん、"}, {"type": "subtitle", "time": 3980.91, "timestamp": "01:06:20", "text": "私は終わった。 「これで終わりにしましょう。」そして、"}, {"type": "subtitle", "time": 3984.069, "timestamp": "01:06:24", "text": "何？数日後には消えてしまう。その"}, {"type": "subtitle", "time": 3985.39, "timestamp": "01:06:25", "text": "以上。"}, {"type": "subtitle", "time": 3989.349, "timestamp": "01:06:29", "text": "ああ、ボディカメラだ。 6か月前、このCPUは"}, {"type": "subtitle", "time": 3993.349, "timestamp": "01:06:33", "text": "亡くなった。ゲームに触れて以来"}, {"type": "subtitle", "time": 3998.069, "timestamp": "01:06:38", "text": "PC関連のもの、マザーボードなど、"}, {"type": "subtitle", "time": 4000.789, "timestamp": "01:06:40", "text": "私はそれを外のどこかに置いた"}, {"type": "subtitle", "time": 4003.549, "timestamp": "01:06:43", "text": "保管しておいて、触らなかった。それから私は"}, {"type": "subtitle", "time": 4006.789, "timestamp": "01:06:46", "text": "私にはまだゲーム配信用のPCがありました。私"}, {"type": "subtitle", "time": 4008.71, "timestamp": "01:06:48", "text": "代替品として使用していました"}, {"type": "subtitle", "time": 4011.109, "timestamp": "01:06:51", "text": "すべて。それから私の新しい部屋と"}, {"type": "subtitle", "time": 4013.549, "timestamp": "01:06:53", "text": "物が建てられ、"}, {"type": "subtitle", "time": 4015.47, "timestamp": "01:06:55", "text": "すべて"}, {"type": "subtitle", "time": 4018.029, "timestamp": "01:06:58", "text": "ええ、私はこう思いました"}]
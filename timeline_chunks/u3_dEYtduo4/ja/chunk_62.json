[{"type": "subtitle", "time": 3722.03, "timestamp": "01:02:02", "text": "誕生日はいつですか？誕生日おめでとう"}, {"type": "subtitle", "time": 3725.51, "timestamp": "01:02:05", "text": "歌。歌を歌ってもいいですか？"}, {"type": "subtitle", "time": 3728.15, "timestamp": "01:02:08", "text": "誕生日おめでとうの歌？"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "ピンク。あなたの誕生日だと考えてもいいですか？"}, {"type": "subtitle", "time": 3734.19, "timestamp": "01:02:14", "text": "今日？申し訳ありませんでした。私はしませんでした"}, {"type": "subtitle", "time": 3738.829, "timestamp": "01:02:18", "text": "知る。待って、あなたは私にあなたの"}, {"type": "subtitle", "time": 3741.789, "timestamp": "01:02:21", "text": "誕生日？"}, {"type": "subtitle", "time": 3744.789, "timestamp": "01:02:24", "text": "何？もしあなたが私と同じように持っていたら、"}, {"type": "subtitle", "time": 3748.789, "timestamp": "01:02:28", "text": "Discordサーバーにこれを投稿して、このように"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "そのDiscordサーバーの掲示板は"}, {"type": "subtitle", "time": 3753.71, "timestamp": "01:02:33", "text": "みんなの"}, {"type": "subtitle", "time": 3757.349, "timestamp": "01:02:37", "text": "誕生日、だって、もし私が"}, {"type": "subtitle", "time": 3760.15, "timestamp": "01:02:40", "text": "カレンダーには入れないで。忘れちゃうから。"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "でも、誕生日おめでとうの歌を歌ってあげるよ"}, {"type": "subtitle", "time": 3765.789, "timestamp": "01:02:45", "text": "歌は大丈夫、あなたがそうしなくても"}, {"type": "subtitle", "time": 3770.87, "timestamp": "01:02:50", "text": "大丈夫、アレクサ、ちょっと願い事をしよう"}, {"type": "subtitle", "time": 3772.549, "timestamp": "01:02:52", "text": "よし、息子よ"}, {"type": "subtitle", "time": 3774.71, "timestamp": "01:02:54", "text": "ええと、息子の誕生日は2日後でした"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "前。それはおそらく彼の"}]
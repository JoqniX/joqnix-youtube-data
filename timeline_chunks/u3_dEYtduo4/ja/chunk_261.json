[{"type": "subtitle", "time": 15660.429, "timestamp": "04:21:00", "text": "黄金の剣。わかった。ベルセルク。うん。"}, {"type": "subtitle", "time": 15663.75, "timestamp": "04:21:03", "text": "ベルセルク。紳士的に言うと、"}, {"type": "subtitle", "time": 15667.91, "timestamp": "04:21:07", "text": "狂乱はその剣のためだった。それから"}, {"type": "subtitle", "time": 15670.429, "timestamp": "04:21:10", "text": "えーと、クロスボウは"}, {"type": "subtitle", "time": 15673.71, "timestamp": "04:21:13", "text": "爆発物"}, {"type": "subtitle", "time": 15677.63, "timestamp": "04:21:17", "text": "1つ。それから、"}, {"type": "subtitle", "time": 15681.79, "timestamp": "04:21:21", "text": "斧には木こりがいた"}, {"type": "subtitle", "time": 15685.429, "timestamp": "04:21:25", "text": "1つ。それからシャベルには何が"}, {"type": "subtitle", "time": 15688.79, "timestamp": "04:21:28", "text": "シャベルはありますか？えっと、シャベルは何をしたの？"}, {"type": "subtitle", "time": 15691.59, "timestamp": "04:21:31", "text": "持っている？神のシャベル。私は入れなかったと思います"}, {"type": "subtitle", "time": 15695.229, "timestamp": "04:21:35", "text": "終わり。大丈夫です。それから"}, {"type": "subtitle", "time": 15705.63, "timestamp": "04:21:45", "text": "プチ。えっと、他に何かありますか？ヘルメットは"}, {"type": "subtitle", "time": 15709.229, "timestamp": "04:21:49", "text": "ベール。ダイヤモンドヘルメットは"}, {"type": "subtitle", "time": 15715.07, "timestamp": "04:21:55", "text": "ベール。えっと、ダイヤモンドの胸当ては、えっと"}, {"type": "subtitle", "time": 15719.87, "timestamp": "04:21:59", "text": "両生類。そしてダイヤモンドペンシルは"}]
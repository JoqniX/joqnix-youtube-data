[{"type": "subtitle", "time": 18185.43, "timestamp": "05:03:05", "text": "わかった、もう行くよ。"}, {"type": "subtitle", "time": 18188.07, "timestamp": "05:03:08", "text": "ミツキが恋しい。え、何？"}, {"type": "subtitle", "time": 18190.07, "timestamp": "05:03:10", "text": "彼女にダイヤモンドを渡すには、どこに渡せばいいでしょうか？"}, {"type": "subtitle", "time": 18192.47, "timestamp": "05:03:12", "text": "彼女はダイヤモンドを持っていますか？"}, {"type": "subtitle", "time": 18195.83, "timestamp": "05:03:15", "text": "ここから少し分けてあげて。"}, {"type": "subtitle", "time": 18197.39, "timestamp": "05:03:17", "text": "おお、"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "わかった。私も彼女に教えてあげたい。私は思う"}, {"type": "subtitle", "time": 18205.43, "timestamp": "05:03:25", "text": "ベールは彼女にとって非常に良い魔法だ。"}, {"type": "subtitle", "time": 18208.628, "timestamp": "05:03:28", "text": "はい、これです。"}, {"type": "subtitle", "time": 18211.19, "timestamp": "05:03:31", "text": "えっと、私のダイヤモンドヘルメットをあげてください"}, {"type": "subtitle", "time": 18215.67, "timestamp": "05:03:35", "text": "彼女へ。でも、あなたはどうですか？"}, {"type": "subtitle", "time": 18218.11, "timestamp": "05:03:38", "text": "いいえ、あなたの分を持って行ってください。"}, {"type": "subtitle", "time": 18220.47, "timestamp": "05:03:40", "text": "うん、彼女のために作ってあげるよ。しないで"}, {"type": "subtitle", "time": 18222.23, "timestamp": "05:03:42", "text": "心配。"}, {"type": "subtitle", "time": 18224.628, "timestamp": "05:03:44", "text": "また"}, {"type": "subtitle", "time": 18227.11, "timestamp": "05:03:47", "text": "クジラの方が良いのか？"}, {"type": "subtitle", "time": 18234.83, "timestamp": "05:03:54", "text": "[音楽]"}, {"type": "subtitle", "time": 18237.75, "timestamp": "05:03:57", "text": "ええ、ベールと両生類は"}, {"type": "subtitle", "time": 18239.43, "timestamp": "05:03:59", "text": "より良い。何？何？何をするの？何をするの？"}]
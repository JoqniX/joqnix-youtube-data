[{"type": "subtitle", "time": 14235.63, "timestamp": "03:57:15", "text": "私のえ？"}, {"type": "subtitle", "time": 14243.59, "timestamp": "03:57:23", "text": "発売？はい、少ししたら戻ります。"}, {"type": "subtitle", "time": 14246.07, "timestamp": "03:57:26", "text": "休憩してもいいですか？私はなりたい"}, {"type": "subtitle", "time": 14254.79, "timestamp": "03:57:34", "text": "ミーティング。私は待ちたい。する必要がある"}, {"type": "subtitle", "time": 14256.83, "timestamp": "03:57:36", "text": "新しいものを作る"}, {"type": "subtitle", "time": 14259.11, "timestamp": "03:57:39", "text": "もの。私は自分のアイドルに会いに行くつもりです"}, {"type": "subtitle", "time": 14262.469, "timestamp": "03:57:42", "text": "ミーティング。よし、とりあえず今はそれを使おう。"}]
[{"type": "subtitle", "time": 3485.19, "timestamp": "00:58:05", "text": "自分。そう、それが私の最初のGPUだったんです。"}, {"type": "subtitle", "time": 3486.87, "timestamp": "00:58:06", "text": "両親が私を買った。それから私は"}, {"type": "subtitle", "time": 3489.27, "timestamp": "00:58:09", "text": "貯金して、貯金して、ちゃんとした"}, {"type": "subtitle", "time": 3492.789, "timestamp": "00:58:12", "text": "ゲーミングPC、つまりゲーム用PCだった。私"}, {"type": "subtitle", "time": 3501.71, "timestamp": "00:58:21", "text": "えっと、私はそれをジョッキーと名付けました"}, {"type": "subtitle", "time": 3504.47, "timestamp": "00:58:24", "text": "PCだよ、だって今は弟とバターなんだから。"}, {"type": "subtitle", "time": 3508.23, "timestamp": "00:58:28", "text": "これは私の初めてのGPU搭載PCです。の"}, {"type": "subtitle", "time": 3514.549, "timestamp": "00:58:34", "text": "AMD Ryzen 7 3800Xと2060"}, {"type": "subtitle", "time": 3518.829, "timestamp": "00:58:38", "text": "えーと、2060年、私はツインファンエディションを持っていました。"}, {"type": "subtitle", "time": 3522.829, "timestamp": "00:58:42", "text": "ゾタック。うん。"}, {"type": "subtitle", "time": 3525.15, "timestamp": "00:58:45", "text": "ええ、"}, {"type": "subtitle", "time": 3527.47, "timestamp": "00:58:47", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 3531.91, "timestamp": "00:58:51", "text": "神。どちらも2019年頃のものです"}, {"type": "subtitle", "time": 3537.109, "timestamp": "00:58:57", "text": "期間。ええ、2019年頃に手に入れました。それで、"}, {"type": "subtitle", "time": 3539.67, "timestamp": "00:58:59", "text": "えっと、写真をアップロードしてみると"}]
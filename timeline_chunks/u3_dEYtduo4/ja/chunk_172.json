[{"type": "subtitle", "time": 10322.51, "timestamp": "02:52:02", "text": "何てことだ。神スバキは相変わらず狂気じみている"}, {"type": "subtitle", "time": 10349.07, "timestamp": "02:52:29", "text": "くそ。これはオールドスクールヒップホップのようだ"}, {"type": "subtitle", "time": 10353.06, "timestamp": "02:52:33", "text": "タイプだが日本のヒップホップ"}, {"type": "subtitle", "time": 10354.429, "timestamp": "02:52:34", "text": "[音楽]"}]
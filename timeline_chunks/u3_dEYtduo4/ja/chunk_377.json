[{"type": "subtitle", "time": 22621.91, "timestamp": "06:17:01", "text": "ちゃんと把握しています。ああ、できるよ。ちょっと待って。"}, {"type": "subtitle", "time": 22631.19, "timestamp": "06:17:11", "text": "おお。おお。ああ、なるほど。ああ、なるほど。"}, {"type": "subtitle", "time": 22632.67, "timestamp": "06:17:12", "text": "[音楽]"}, {"type": "subtitle", "time": 22635.75, "timestamp": "06:17:15", "text": "ジョギングをしているような気分。"}, {"type": "subtitle", "time": 22637.59, "timestamp": "06:17:17", "text": "うん。"}, {"type": "subtitle", "time": 22640.948, "timestamp": "06:17:20", "text": "VRで一緒に配信してみませんか？"}, {"type": "subtitle", "time": 22643.27, "timestamp": "06:17:23", "text": "いつ？"}, {"type": "subtitle", "time": 22646.39, "timestamp": "06:17:26", "text": "今週が終わったら、Repoをプレイできるよ。リポジトリ"}, {"type": "subtitle", "time": 22652.07, "timestamp": "06:17:32", "text": "VRで。私はRepoを持っていません。私はVRです。"}, {"type": "subtitle", "time": 22655.03, "timestamp": "06:17:35", "text": "はい、はい、はい。だから、それをプレイできる"}, {"type": "subtitle", "time": 22657.19, "timestamp": "06:17:37", "text": "そして私は全身トラッキングできます"}, {"type": "subtitle", "time": 22660.868, "timestamp": "06:17:40", "text": "もの。今日は何について話すのですか？"}, {"type": "subtitle", "time": 22662.788, "timestamp": "06:17:42", "text": "ナビーラがそれをプレイしていて、"}, {"type": "subtitle", "time": 22666.628, "timestamp": "06:17:46", "text": "リポジトリについて話しています。それは何ですか？それは"}, {"type": "subtitle", "time": 22667.868, "timestamp": "06:17:47", "text": "ゲームのような"}, {"type": "subtitle", "time": 22672.39, "timestamp": "06:17:52", "text": "恐ろしいゲームだけど、私はプレイしたことがない。それは"}, {"type": "subtitle", "time": 22674.868, "timestamp": "06:17:54", "text": "しかし"}, {"type": "subtitle", "time": 22676.788, "timestamp": "06:17:56", "text": "あ、待って。知ってる？私が"}, {"type": "subtitle", "time": 22679.59, "timestamp": "06:17:59", "text": "VRゲームについて教えてあげようか？スーパーを知ってるよ"}]
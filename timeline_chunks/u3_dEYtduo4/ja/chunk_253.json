[{"type": "subtitle", "time": 15180.75, "timestamp": "04:13:00", "text": "背骨は、"}, {"type": "subtitle", "time": 15184.07, "timestamp": "04:13:04", "text": "私を攻撃してください。待って、待って、待って、待って。さあ"}, {"type": "subtitle", "time": 15191.349, "timestamp": "04:13:11", "text": "1つ。待って。何も起こらない。私は違います"}, {"type": "subtitle", "time": 15193.75, "timestamp": "04:13:13", "text": "盲目。ああ、そして今、私は目が見えなくなってしまった。おお、"}, {"type": "subtitle", "time": 15196.269, "timestamp": "04:13:16", "text": "あたりは真っ暗だ。"}, {"type": "subtitle", "time": 15199.67, "timestamp": "04:13:19", "text": "暗闇。でも、あなたの姿は見えないんです。私"}, {"type": "subtitle", "time": 15201.87, "timestamp": "04:13:21", "text": "でも、あなたの姿は見えないよ。おお、"}, {"type": "subtitle", "time": 15232.75, "timestamp": "04:13:52", "text": "ああ、私はどこにいるのか"}]
[{"type": "subtitle", "time": 18423.39, "timestamp": "05:07:03", "text": "[音楽]"}, {"type": "subtitle", "time": 18427.19, "timestamp": "05:07:07", "text": "どこ？何てことだ。私は「待って」と思った。おお、"}, {"type": "subtitle", "time": 18430.27, "timestamp": "05:07:10", "text": "待って。いや。ああ、いやだ。なんてこった。おお"}, {"type": "subtitle", "time": 18432.27, "timestamp": "05:07:12", "text": "いいえ。おお"}, {"type": "subtitle", "time": 18436.628, "timestamp": "05:07:16", "text": "いいえ。なんてこった。あの笑顔だよ。ああ、これは"}, {"type": "subtitle", "time": 18438.43, "timestamp": "05:07:18", "text": "贈る"}, {"type": "subtitle", "time": 18440.67, "timestamp": "05:07:20", "text": "俺だよ。"}, {"type": "subtitle", "time": 18445.708, "timestamp": "05:07:25", "text": "N. 私は彼女が好きだ。私は眠りにつく、"}, {"type": "subtitle", "time": 18449.66, "timestamp": "05:07:29", "text": "兄弟。寝る。なぜ？"}, {"type": "subtitle", "time": 18453.67, "timestamp": "05:07:33", "text": "[音楽]"}, {"type": "subtitle", "time": 18456.46, "timestamp": "05:07:36", "text": "これは最悪なスタイルだ。"}, {"type": "subtitle", "time": 18458.07, "timestamp": "05:07:38", "text": "[音楽]"}, {"type": "subtitle", "time": 18468.07, "timestamp": "05:07:48", "text": "よし、もう行くよ。"}, {"type": "subtitle", "time": 18470.47, "timestamp": "05:07:50", "text": "本当に食べたい。うん。うん。はい。"}, {"type": "subtitle", "time": 18473.59, "timestamp": "05:07:53", "text": "はい。はい。はい。はい。はい。バイバイ。"}]
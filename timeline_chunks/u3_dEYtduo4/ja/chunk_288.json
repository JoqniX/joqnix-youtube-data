[{"type": "subtitle", "time": 17283.03, "timestamp": "04:48:03", "text": "待って、彼はログインしたの？ええ、彼はログインしました"}, {"type": "subtitle", "time": 17284.67, "timestamp": "04:48:04", "text": "そして彼は来なかった"}, {"type": "subtitle", "time": 17288.47, "timestamp": "04:48:08", "text": "自分。なんて失礼な。"}, {"type": "subtitle", "time": 17291.51, "timestamp": "04:48:11", "text": "彼は来ると思うよ。"}, {"type": "subtitle", "time": 17294.07, "timestamp": "04:48:14", "text": "どうやら8人が"}, {"type": "subtitle", "time": 17297.31, "timestamp": "04:48:17", "text": "あなたに"}, {"type": "subtitle", "time": 17307.19, "timestamp": "04:48:27", "text": "知らないことは気にしないで、知らないべき"}, {"type": "subtitle", "time": 17309.99, "timestamp": "04:48:29", "text": "甘やかす"}, {"type": "subtitle", "time": 17319.03, "timestamp": "04:48:39", "text": "実際は、でも誰もが"}, {"type": "subtitle", "time": 17320.43, "timestamp": "04:48:40", "text": "異なる異なる"}, {"type": "subtitle", "time": 17324.31, "timestamp": "04:48:44", "text": "他の8人以外の1人"}, {"type": "subtitle", "time": 17326.788, "timestamp": "04:48:46", "text": "私たちにはドラゴンがいる、確かに"}, {"type": "subtitle", "time": 17329.75, "timestamp": "04:48:49", "text": "殺す"}, {"type": "subtitle", "time": 17334.708, "timestamp": "04:48:54", "text": "ハビビはそれをしっかり持っててと言った。"}, {"type": "subtitle", "time": 17337.59, "timestamp": "04:48:57", "text": "私も自分のクエストを持っているが、"}]
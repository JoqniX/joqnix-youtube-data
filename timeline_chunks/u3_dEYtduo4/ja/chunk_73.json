[{"type": "subtitle", "time": 4390.79, "timestamp": "01:13:10", "text": "それ。うん。置けるかな、置けないよ。"}, {"type": "subtitle", "time": 4392.31, "timestamp": "01:13:12", "text": "あのね？ YouTubeにアップロードできます"}, {"type": "subtitle", "time": 4394.79, "timestamp": "01:13:14", "text": "スタジオ。そうします"}, {"type": "subtitle", "time": 4396.35, "timestamp": "01:13:16", "text": "[音楽]"}, {"type": "subtitle", "time": 4398.11, "timestamp": "01:13:18", "text": "それ。全て"}, {"type": "subtitle", "time": 4404.83, "timestamp": "01:13:24", "text": "[音楽]"}, {"type": "subtitle", "time": 4408.31, "timestamp": "01:13:28", "text": "えっと、着けられないんです。何てことだ。私は持っている"}, {"type": "subtitle", "time": 4429.95, "timestamp": "01:13:49", "text": "えっと、これをトリミングする必要がある"}]
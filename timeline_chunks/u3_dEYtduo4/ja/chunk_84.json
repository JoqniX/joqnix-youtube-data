[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "それに対する収益化ですが、今は"}, {"type": "subtitle", "time": 5044.709, "timestamp": "01:24:04", "text": "見せるものには気をつけなきゃいけない"}, {"type": "subtitle", "time": 5047.35, "timestamp": "01:24:07", "text": "なあ、俺は「ああ、そうだな」なんて言えないんだよ"}, {"type": "subtitle", "time": 5049.83, "timestamp": "01:24:09", "text": "私は自分の好きなようにする。私は"}, {"type": "subtitle", "time": 5052.79, "timestamp": "01:24:12", "text": "今すぐパートナーになりましょう。私は、えっと、私は"}, {"type": "subtitle", "time": 5055.87, "timestamp": "01:24:15", "text": "ルールとかを守れよ。"}, {"type": "subtitle", "time": 5059.229, "timestamp": "01:24:19", "text": "おお。こんにちは、Sfishさん。良い"}, {"type": "subtitle", "time": 5062.11, "timestamp": "01:24:22", "text": "夕方。ダマはどうですか"}, {"type": "subtitle", "time": 5064.35, "timestamp": "01:24:24", "text": "何をしているの？あなたが知っている、"}, {"type": "subtitle", "time": 5066.39, "timestamp": "01:24:26", "text": "昨日、ああ、大変だった。君は台無しにした"}, {"type": "subtitle", "time": 5069.75, "timestamp": "01:24:29", "text": "昨日。あなたは眠ってしまった。私は"}, {"type": "chat", "time": 5078.294, "timestamp": "01:24:38", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "and lost it all as well"}, {"type": "subtitle", "time": 5080.87, "timestamp": "01:24:40", "text": "なし。クエストをすべて完了しました。私は"}, {"type": "subtitle", "time": 5083.51, "timestamp": "01:24:43", "text": "家に帰ろうとしている。持ち物をなくしました"}, {"type": "subtitle", "time": 5086.189, "timestamp": "01:24:46", "text": "両手のおかげで"}, {"type": "subtitle", "time": 5088.79, "timestamp": "01:24:48", "text": "あれ。ええ、私はこれらすべてを失いました"}, {"type": "subtitle", "time": 5092.03, "timestamp": "01:24:52", "text": "まあ、兄弟。なあ、兄弟、"}, {"type": "subtitle", "time": 5095.99, "timestamp": "01:24:55", "text": "錨、ダイヤモンド、ミルクバケツ。"}, {"type": "subtitle", "time": 5097.709, "timestamp": "01:24:57", "text": "ああ、なんてことだ、"}]
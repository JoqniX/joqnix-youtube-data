[{"type": "subtitle", "time": 18072.43, "timestamp": "05:01:12", "text": "[音楽]"}, {"type": "subtitle", "time": 18076.07, "timestamp": "05:01:16", "text": "跳ね返る。いいえ。刀が欲しいのですか？"}, {"type": "subtitle", "time": 18078.47, "timestamp": "05:01:18", "text": "刀が欲しいですか？私は"}, {"type": "subtitle", "time": 18085.11, "timestamp": "05:01:25", "text": "カタナ。もっと良いものを見つけた"}, {"type": "subtitle", "time": 18088.59, "timestamp": "05:01:28", "text": "けれど。何てことだ。私"}, {"type": "subtitle", "time": 18092.628, "timestamp": "05:01:32", "text": "ああ、私があなたにあげた斧のことじゃない。わかった。"}, {"type": "subtitle", "time": 18094.39, "timestamp": "05:01:34", "text": "何てことだ。あなたはまだ私がそれを成し遂げたと思っている。私"}, {"type": "subtitle", "time": 18095.91, "timestamp": "05:01:35", "text": "できたよ。よくやったね。何が起こったのか"}, {"type": "subtitle", "time": 18097.99, "timestamp": "05:01:37", "text": "ああ、そうだね。私はあなたにハンマーを渡しました。"}, {"type": "subtitle", "time": 18099.59, "timestamp": "05:01:39", "text": "わかった。"}, {"type": "subtitle", "time": 18109.91, "timestamp": "05:01:49", "text": "それで、決着はついたのか？でもあなたは"}, {"type": "subtitle", "time": 18112.35, "timestamp": "05:01:52", "text": "これら2つを握ると、"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "両手武器では、"}, {"type": "subtitle", "time": 18117.35, "timestamp": "05:01:57", "text": "アイテム？"}, {"type": "subtitle", "time": 18119.75, "timestamp": "05:01:59", "text": "商品はどこにありますか？それをそのままにしておくと"}]
[{"type": "subtitle", "time": 5160.79, "timestamp": "01:26:00", "text": "ああ、2日前だよ。何が"}, {"type": "subtitle", "time": 5165.55, "timestamp": "01:26:05", "text": "私はします？あなたは私に2本の鎌斧をくれました"}, {"type": "subtitle", "time": 5167.99, "timestamp": "01:26:07", "text": "そういうことですよね？あなたは私に2つくれた。私は必要としている"}, {"type": "subtitle", "time": 5172.83, "timestamp": "01:26:12", "text": "過去2人と現在の1人。男、"}, {"type": "subtitle", "time": 5175.27, "timestamp": "01:26:15", "text": "2つ以外のすべて。あなたは私にくれたと思います"}, {"type": "subtitle", "time": 5177.709, "timestamp": "01:26:17", "text": "1つですよね？いや、待って。私はそうは思わない"}, {"type": "subtitle", "time": 5180.47, "timestamp": "01:26:20", "text": "覚えて。ダイヤモンドアーマーセット、"}, {"type": "subtitle", "time": 5184.39, "timestamp": "01:26:24", "text": "すべて。星の斧。スタラックス"}, {"type": "subtitle", "time": 5189.35, "timestamp": "01:26:29", "text": "消えてしまった。そして星のマイナーは"}, {"type": "subtitle", "time": 5194.75, "timestamp": "01:26:34", "text": "去った。カット カタンの"}, {"type": "subtitle", "time": 5197.629, "timestamp": "01:26:37", "text": "コナラナもいなくなってしまった。の"}, {"type": "subtitle", "time": 5201.75, "timestamp": "01:26:41", "text": "刀が全てを支配している。"}]
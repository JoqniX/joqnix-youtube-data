[{"type": "subtitle", "time": 21180.868, "timestamp": "05:53:00", "text": "あ、待って。私はこのズボンを持っています。その"}, {"type": "subtitle", "time": 21183.11, "timestamp": "05:53:03", "text": "革のパンツ。何を言うのですか"}, {"type": "subtitle", "time": 21186.31, "timestamp": "05:53:06", "text": "カーソルを合わせますか？"}, {"type": "subtitle", "time": 21189.23, "timestamp": "05:53:09", "text": "よし、左コントロールを試してみよう。滑り落ちる可能性がある。それ"}, {"type": "subtitle", "time": 21192.31, "timestamp": "05:53:12", "text": "左シフトを押すと表示されます"}, {"type": "subtitle", "time": 21195.67, "timestamp": "05:53:15", "text": "空気があなたを左方向に飛ばします"}, {"type": "subtitle", "time": 21199.03, "timestamp": "05:53:19", "text": "脚で立っているとき。どこがいいのかわかりません"}, {"type": "subtitle", "time": 21200.51, "timestamp": "05:53:20", "text": "革製のもの。"}, {"type": "subtitle", "time": 21207.91, "timestamp": "05:53:27", "text": "滑ることができます。"}, {"type": "subtitle", "time": 21211.27, "timestamp": "05:53:31", "text": "やってみてください。"}, {"type": "chat", "time": 21213.3, "timestamp": "05:53:33", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Try the furniture mod pack in Minecraft marketplace"}, {"type": "subtitle", "time": 21214.19, "timestamp": "05:53:34", "text": "あ、すみません。大丈夫。十分"}, {"type": "subtitle", "time": 21217.51, "timestamp": "05:53:37", "text": "コントロール。そのまま持っていてください。"}, {"type": "subtitle", "time": 21225.11, "timestamp": "05:53:45", "text": "そうではありません。"}, {"type": "subtitle", "time": 21226.548, "timestamp": "05:53:46", "text": "あのね？ Escキーを押してください。プレス"}, {"type": "subtitle", "time": 21229.19, "timestamp": "05:53:49", "text": "逃げる。"}, {"type": "subtitle", "time": 21231.67, "timestamp": "05:53:51", "text": "オプションを開いてください。"}, {"type": "chat", "time": 21232.38, "timestamp": "05:53:52", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "
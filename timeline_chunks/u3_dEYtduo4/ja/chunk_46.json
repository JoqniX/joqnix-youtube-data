[{"type": "subtitle", "time": 2774.39, "timestamp": "00:46:14", "text": "夕方7時から12時、7時から10時。了解。だから私は"}, {"type": "subtitle", "time": 2781.349, "timestamp": "00:46:21", "text": "日本語の授業のようなクラス"}, {"type": "subtitle", "time": 2783.67, "timestamp": "00:46:23", "text": "特別なものが欲しい学生"}, {"type": "subtitle", "time": 2785.589, "timestamp": "00:46:25", "text": "クラスですよね？"}, {"type": "subtitle", "time": 2789.27, "timestamp": "00:46:29", "text": "復習クラス。だからいつになるかわからない"}, {"type": "subtitle", "time": 2791.15, "timestamp": "00:46:31", "text": "日付はですが、"}, {"type": "subtitle", "time": 2793.79, "timestamp": "00:46:33", "text": "すぐに"}, {"type": "subtitle", "time": 2798.309, "timestamp": "00:46:38", "text": "えっと、7～10って書いてあるから、たぶん私は"}, {"type": "subtitle", "time": 2799.069, "timestamp": "00:46:39", "text": "持っている"}, {"type": "subtitle", "time": 2801.71, "timestamp": "00:46:41", "text": "開始する"}, {"type": "subtitle", "time": 2811.19, "timestamp": "00:46:51", "text": "私はそれについて何かしなければならない"}, {"type": "subtitle", "time": 2812.829, "timestamp": "00:46:52", "text": "ストリーム"}, {"type": "subtitle", "time": 2816.39, "timestamp": "00:46:56", "text": "おそらく早期に終了するか、"}, {"type": "subtitle", "time": 2817.55, "timestamp": "00:46:57", "text": "多分"}]
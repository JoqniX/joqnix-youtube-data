[{"type": "subtitle", "time": 22169.948, "timestamp": "06:09:29", "text": "なぜ"}, {"type": "subtitle", "time": 22174.708, "timestamp": "06:09:34", "text": "君はやってるね。ああ、そうだね。待って、どうやって"}, {"type": "subtitle", "time": 22177.11, "timestamp": "06:09:37", "text": "どうやって座ることができるのですか？はい、どうぞ"}, {"type": "subtitle", "time": 22183.43, "timestamp": "06:09:43", "text": "床にある物。私は疲れている。私は"}, {"type": "subtitle", "time": 22188.788, "timestamp": "06:09:48", "text": "[音楽]"}, {"type": "subtitle", "time": 22191.43, "timestamp": "06:09:51", "text": "えっと、"}, {"type": "subtitle", "time": 22194.07, "timestamp": "06:09:54", "text": "待って。モデルは自分で作ったのですか？"}, {"type": "subtitle", "time": 22195.83, "timestamp": "06:09:55", "text": "マインクラフト？"}]
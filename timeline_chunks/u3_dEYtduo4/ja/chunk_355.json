[{"type": "subtitle", "time": 21303.708, "timestamp": "05:55:03", "text": "バックパック。わかった。"}, {"type": "subtitle", "time": 21307.15, "timestamp": "05:55:07", "text": "え、何？ああ、わかりました。"}, {"type": "subtitle", "time": 21310.548, "timestamp": "05:55:10", "text": "機能強化。いやいやいや、それは「いやいや」と書いてある。"}, {"type": "subtitle", "time": 21312.9, "timestamp": "05:55:12", "text": "開いたバックパック"}, {"type": "subtitle", "time": 21331.17, "timestamp": "05:55:31", "text": "スライド。もう一度やってみてください。"}, {"type": "subtitle", "time": 21332.39, "timestamp": "05:55:32", "text": "[音楽]"}, {"type": "subtitle", "time": 21342.72, "timestamp": "05:55:42", "text": "言う？わかった、絶対にない"}, {"type": "subtitle", "time": 21358.07, "timestamp": "05:55:58", "text": "ボタン。石鹸のホットキーとしてキャップを使用しています"}, {"type": "subtitle", "time": 21359.59, "timestamp": "05:55:59", "text": "それ。"}]
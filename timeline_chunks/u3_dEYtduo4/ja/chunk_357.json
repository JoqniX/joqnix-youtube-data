[{"type": "subtitle", "time": 21420.07, "timestamp": "05:57:00", "text": "使ったの？胸に横移動があります"}, {"type": "subtitle", "time": 21423.948, "timestamp": "05:57:03", "text": "場所。それで、私にはこうなります"}, {"type": "subtitle", "time": 21426.788, "timestamp": "05:57:06", "text": "横移動。でもそれはほんの少しだけ"}, {"type": "subtitle", "time": 21430.31, "timestamp": "05:57:10", "text": "少し。いいえ、良くありません。価値がない、私は"}, {"type": "subtitle", "time": 21434.23, "timestamp": "05:57:14", "text": "推測。後で変更します。しかし"}, {"type": "subtitle", "time": 21445.99, "timestamp": "05:57:25", "text": "フェブキ。どう思いますか？私は女性らしい"}, {"type": "subtitle", "time": 21448.47, "timestamp": "05:57:28", "text": "今は良くなりました。水中に行くかもしれない"}, {"type": "subtitle", "time": 21451.03, "timestamp": "05:57:31", "text": "まもなく探査開始。"}, {"type": "subtitle", "time": 21455.07, "timestamp": "05:57:35", "text": "でも、彼女に"}, {"type": "subtitle", "time": 21459.59, "timestamp": "05:57:39", "text": "私たちは今そうしません、なぜならまず彼女は"}, {"type": "subtitle", "time": 21466.868, "timestamp": "05:57:46", "text": "彼女は初心者です。"}, {"type": "subtitle", "time": 21469.99, "timestamp": "05:57:49", "text": "何てことだ。何？つまり両生類だ。私はすべきでしょうか"}, {"type": "subtitle", "time": 21471.91, "timestamp": "05:57:51", "text": "渡さないの？鎧を渡せばいい。それは"}]
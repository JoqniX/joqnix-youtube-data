[{"type": "subtitle", "time": 21061.99, "timestamp": "05:51:01", "text": "ある夏の日のように"}, {"type": "subtitle", "time": 21066.07, "timestamp": "05:51:06", "text": "えっと、ウォーターパーク、ウォーターパークみたいなやつ。"}, {"type": "chat", "time": 21066.096, "timestamp": "05:51:06", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "JOQ GO TO BED"}, {"type": "subtitle", "time": 21069.03, "timestamp": "05:51:09", "text": "こんにちは。"}, {"type": "subtitle", "time": 21071.51, "timestamp": "05:51:11", "text": "ほら、冒険を思い出させてくれるんだ。"}, {"type": "subtitle", "time": 21074.59, "timestamp": "05:51:14", "text": "こんにちは、ソーラー。私たちはたくさんいます、私たちは"}, {"type": "subtitle", "time": 21078.31, "timestamp": "05:51:18", "text": "そういうのがたくさんある。うん。うん。寝ます。"}, {"type": "subtitle", "time": 21079.59, "timestamp": "05:51:19", "text": "心配しないで。心配しないで。心配しないで。"}, {"type": "chat", "time": 21081.949, "timestamp": "05:51:21", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "GO TO BED"}, {"type": "subtitle", "time": 21083.35, "timestamp": "05:51:23", "text": "以前はパスポートタイプも好きでした"}, {"type": "subtitle", "time": 21086.548, "timestamp": "05:51:26", "text": "会員制のことですね。知っている。以前は"}, {"type": "subtitle", "time": 21089.75, "timestamp": "05:51:29", "text": "それ。私も以前はそうでした。また、"}, {"type": "subtitle", "time": 21091.67, "timestamp": "05:51:31", "text": "チャットで何か違いに気づきましたか？私"}, {"type": "subtitle", "time": 21094.39, "timestamp": "05:51:34", "text": "ロック解除されたメンバーシップ。"}, {"type": "subtitle", "time": 21096.07, "timestamp": "05:51:36", "text": "待って、明日は会員制の日だよ"}, {"type": "subtitle", "time": 21098.868, "timestamp": "05:51:38", "text": "ストリームですが、今日はスーパーチャットを見ることができます"}, {"type": "subtitle", "time": 21102.31, "timestamp": "05:51:42", "text": "そして全て。すごいね。ついに手に入れた"}, {"type": "chat", "time": 21104.538, "timestamp": "05:51:44", "author": "@Solar07910", "avatar": "https://yt4.ggpht.com/j5v2GtdHe5Mb397GDb3gC5IoevB6pG5og12wcUK7kXFCbhNgN7R_gyWKDv5Ctf9yda4r1JuD1w=s64-c-k-c0x00ffffff-no-rj", "message": "Yeah I saw it"}, {"type": "subtitle", "time": 21105.27, "timestamp": "05:51:45", "text": "ああ、神様。ついに、メンバーシップのロックを解除しました。"}, {"type": "subtitle", "time": 21107.75, "timestamp": "05:51:47", "text": "私はとても幸せです。"}, {"type": "subtitle", "time": 21116.948, "timestamp": "05:51:56", "text": "わかった。"}]
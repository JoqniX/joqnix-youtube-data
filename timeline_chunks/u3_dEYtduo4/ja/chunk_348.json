[{"type": "subtitle", "time": 20881.43, "timestamp": "05:48:01", "text": "どこかで立ち往生している。"}, {"type": "subtitle", "time": 20884.15, "timestamp": "05:48:04", "text": "だから、私はシフトを続けなければならない、"}, {"type": "subtitle", "time": 20887.19, "timestamp": "05:48:07", "text": "はぁ？うん。シフトしてそうしてください。そしてもしあなたが"}, {"type": "subtitle", "time": 20890.31, "timestamp": "05:48:10", "text": "ずっと下まで降りていきたい、えーと"}, {"type": "subtitle", "time": 20895.27, "timestamp": "05:48:15", "text": "コントロールキーを押し、左コントロールキーを押します。"}, {"type": "subtitle", "time": 20898.07, "timestamp": "05:48:18", "text": "みんなのためにウォータースライダーを作ったよ。おお、"}, {"type": "subtitle", "time": 20901.03, "timestamp": "05:48:21", "text": "本当に？何？"}, {"type": "subtitle", "time": 20903.99, "timestamp": "05:48:23", "text": "ああ、私の仲間が中に入っていく。 H"}, {"type": "subtitle", "time": 20912.708, "timestamp": "05:48:32", "text": "動けますか？"}, {"type": "subtitle", "time": 20916.47, "timestamp": "05:48:36", "text": "わあ、サーフィンしてる。"}, {"type": "subtitle", "time": 20918.868, "timestamp": "05:48:38", "text": "サーフィンはしない。あなたは私をからかっているだけでしょう。"}, {"type": "subtitle", "time": 20921.91, "timestamp": "05:48:41", "text": "黙れ。"}, {"type": "subtitle", "time": 20924.548, "timestamp": "05:48:44", "text": "これを見てください。元に戻す方法"}, {"type": "subtitle", "time": 20927.15, "timestamp": "05:48:47", "text": "一番上まで？それは"}, {"type": "subtitle", "time": 20929.83, "timestamp": "05:48:49", "text": "難しい。ああ、ここは凍りつくだろう"}, {"type": "subtitle", "time": 20934.23, "timestamp": "05:48:54", "text": "上へ。今は寒い。"}, {"type": "subtitle", "time": 20937.83, "timestamp": "05:48:57", "text": "Bで私に挑んでくるつもりですか？何てことだ。"}]
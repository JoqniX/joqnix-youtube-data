[{"type": "subtitle", "time": 22082.07, "timestamp": "06:08:02", "text": "お礼にチョコレートはいかがですか？"}, {"type": "subtitle", "time": 22088.868, "timestamp": "06:08:08", "text": "今。しかし、死んではいけない。私のクッキー。私の"}, {"type": "subtitle", "time": 22092.75, "timestamp": "06:08:12", "text": "クッキーがなくなりました。"}, {"type": "subtitle", "time": 22101.51, "timestamp": "06:08:21", "text": "いいえ、私が食べました。ああ、食べちゃったんですね。"}, {"type": "subtitle", "time": 22119.27, "timestamp": "06:08:39", "text": "デプロイできます。レースを展開できます。"}, {"type": "subtitle", "time": 22120.788, "timestamp": "06:08:40", "text": "わかった。"}, {"type": "subtitle", "time": 22126.99, "timestamp": "06:08:46", "text": "３、２、３、ゴー。ああ、なんてことだ。"}]
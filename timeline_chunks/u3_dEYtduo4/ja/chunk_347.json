[{"type": "subtitle", "time": 20834.15, "timestamp": "05:47:14", "text": "これは何ですか？何？何？それはズキの"}, {"type": "subtitle", "time": 20842.35, "timestamp": "05:47:22", "text": "ブーツをプレゼントする。ブーツ"}, {"type": "subtitle", "time": 20846.07, "timestamp": "05:47:26", "text": "あなた。オウム。それは何ですか？ブーツ。くそ、"}, {"type": "subtitle", "time": 20849.43, "timestamp": "05:47:29", "text": "これはすごくクールだ。あなたは死ぬことはないでしょう"}, {"type": "subtitle", "time": 20852.39, "timestamp": "05:47:32", "text": "落下によるダメージは今後発生します。そしてあなたは"}, {"type": "subtitle", "time": 20854.75, "timestamp": "05:47:34", "text": "コントロールを押してスーパージャンプすると、"}, {"type": "subtitle", "time": 20857.35, "timestamp": "05:47:37", "text": "外にはスペースがあるよね？飛び込んでもいいですよ"}, {"type": "subtitle", "time": 20860.47, "timestamp": "05:47:40", "text": "空気。待って、待って。押す必要がある"}, {"type": "subtitle", "time": 20863.35, "timestamp": "05:47:43", "text": "何？"}, {"type": "subtitle", "time": 20865.91, "timestamp": "05:47:45", "text": "しゃがむボタンを押してください。それは"}, {"type": "subtitle", "time": 20870.868, "timestamp": "05:47:50", "text": "シフト、ですよね？それから、押して、離します。"}, {"type": "subtitle", "time": 20872.948, "timestamp": "05:47:52", "text": "シフトして、うん、そこだ。はい、どうぞ。"}, {"type": "subtitle", "time": 20875.35, "timestamp": "05:47:55", "text": "ニース。"}, {"type": "subtitle", "time": 20877.11, "timestamp": "05:47:57", "text": "ああ、"}, {"type": "subtitle", "time": 20879.43, "timestamp": "05:47:59", "text": "ジャンプして登り返せば"}]
[{"type": "subtitle", "time": 20100.948, "timestamp": "05:35:00", "text": "より良いもののようなMODはありますか？"}, {"type": "subtitle", "time": 20103.51, "timestamp": "05:35:03", "text": "懐中電灯よりも良い照明"}, {"type": "subtitle", "time": 20105.99, "timestamp": "05:35:05", "text": "もしくは、モンスターが来ないようにする何か？いいえ。"}, {"type": "subtitle", "time": 20109.35, "timestamp": "05:35:09", "text": "右。わからない。やあ、お元気ですか"}, {"type": "subtitle", "time": 20112.868, "timestamp": "05:35:12", "text": "座っている？右クリックします。階段。右"}, {"type": "subtitle", "time": 20115.91, "timestamp": "05:35:15", "text": "階段をクリックしてください。うん。どうぞお座りください。あなた"}, {"type": "subtitle", "time": 20118.07, "timestamp": "05:35:18", "text": "待って。可愛いね。待って、私に"}, {"type": "subtitle", "time": 20121.03, "timestamp": "05:35:21", "text": "スクリーンショットを撮る。くそっ。"}, {"type": "subtitle", "time": 20123.51, "timestamp": "05:35:23", "text": "私は可愛い。"}, {"type": "subtitle", "time": 20130.548, "timestamp": "05:35:30", "text": "待って、私も階段の上にいるよ。どうすればいいですか？"}, {"type": "subtitle", "time": 20132.788, "timestamp": "05:35:32", "text": "右クリック、右クリック、右クリック"}, {"type": "subtitle", "time": 20136.07, "timestamp": "05:35:36", "text": "階段右クリック、マウス、右"}, {"type": "subtitle", "time": 20139.75, "timestamp": "05:35:39", "text": "クリック。そうそう、ピエロを忘れてた"}, {"type": "subtitle", "time": 20143.39, "timestamp": "05:35:43", "text": "サイト。私は理性を失った。ああ、私も"}, {"type": "subtitle", "time": 20146.548, "timestamp": "05:35:46", "text": "座っている。くそ。私に撮ってほしいですか？"}, {"type": "subtitle", "time": 20148.708, "timestamp": "05:35:48", "text": "スクリーンショット？"}, {"type": "subtitle", "time": 20151.47, "timestamp": "05:35:51", "text": "ジョーなら耐えられる。できる"}, {"type": "subtitle", "time": 20155.27, "timestamp": "05:35:55", "text": "F2。ちょっと待って。"}, {"type": "subtitle", "time": 20158.27, "timestamp": "05:35:58", "text": "とてもかわいい。君を見て"}]
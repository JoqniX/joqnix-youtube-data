[{"type": "subtitle", "time": 21840.23, "timestamp": "06:04:00", "text": "それを使ってください。"}, {"type": "subtitle", "time": 21842.19, "timestamp": "06:04:02", "text": "何てことだ。私"}, {"type": "subtitle", "time": 21845.75, "timestamp": "06:04:05", "text": "できる。やり方を教えてください。私"}, {"type": "subtitle", "time": 21848.23, "timestamp": "06:04:08", "text": "できる。わかった。できますか、できますか、できますか、できますか"}, {"type": "subtitle", "time": 21852.15, "timestamp": "06:04:12", "text": "彼女に指揮官の職を与えるのか？忘れた。"}, {"type": "subtitle", "time": 21853.868, "timestamp": "06:04:13", "text": "わかった。"}, {"type": "subtitle", "time": 21858.35, "timestamp": "06:04:18", "text": "えっと、入力してみます"}, {"type": "subtitle", "time": 21861.99, "timestamp": "06:04:21", "text": "チャット。大丈夫。"}, {"type": "subtitle", "time": 21866.47, "timestamp": "06:04:26", "text": "食事中、私は十分な"}, {"type": "subtitle", "time": 21869.35, "timestamp": "06:04:29", "text": "人生。"}, {"type": "subtitle", "time": 21872.07, "timestamp": "06:04:32", "text": "部屋がすごく暑くなってきたので、扇風機を焚いてください。する必要がある"}, {"type": "subtitle", "time": 21876.23, "timestamp": "06:04:36", "text": "機械の電源を入れてください。ああ、本当に、私は"}, {"type": "subtitle", "time": 21879.27, "timestamp": "06:04:39", "text": "なぜか扇風機を止めて座っている。"}, {"type": "subtitle", "time": 21882.708, "timestamp": "06:04:42", "text": "わからない。私のゲームルームは私のお気に入りです"}, {"type": "subtitle", "time": 21886.788, "timestamp": "06:04:46", "text": "今はすごく小さくて閉まっていて、私の"}, {"type": "subtitle", "time": 21891.75, "timestamp": "06:04:51", "text": "パソコンがすごく熱くなる。そうですね。"}]
[{"type": "subtitle", "time": 14580.55, "timestamp": "04:03:00", "text": "神。アストラ。何てことだ。見て。よし、みんな。"}, {"type": "subtitle", "time": 14582.15, "timestamp": "04:03:02", "text": "マインクラフトモードでプレイしよう。"}, {"type": "subtitle", "time": 14589.99, "timestamp": "04:03:09", "text": "[音楽]"}, {"type": "subtitle", "time": 14604.64, "timestamp": "04:03:24", "text": "私の鍵はドラゴンです"}]
[{"type": "subtitle", "time": 17460.07, "timestamp": "04:51:00", "text": "そして、必ずロックします。こんにちは。まるで私が"}, {"type": "subtitle", "time": 17463.03, "timestamp": "04:51:03", "text": "これ以上ストリーミングする予定はありません"}, {"type": "subtitle", "time": 17465.91, "timestamp": "04:51:05", "text": "本当に体が痛い。"}, {"type": "subtitle", "time": 17474.628, "timestamp": "04:51:14", "text": "ミツキが参加した時。全く分からない。彼女"}, {"type": "subtitle", "time": 17478.07, "timestamp": "04:51:18", "text": "今日は配信したかったのですが、サーバーが"}, {"type": "subtitle", "time": 17478.91, "timestamp": "04:51:18", "text": "だった"}, {"type": "subtitle", "time": 17496.868, "timestamp": "04:51:36", "text": "私がジャンプするたびに、誰かが"}, {"type": "subtitle", "time": 17500.47, "timestamp": "04:51:40", "text": "アプリにスパム行為をするようなものだ。誰かが使用しています"}, {"type": "subtitle", "time": 17503.43, "timestamp": "04:51:43", "text": "うるさいキーボードか何かで、"}, {"type": "subtitle", "time": 17506.23, "timestamp": "04:51:46", "text": "この弾むブーツでジャンプするんだ、そうだろ？それ"}, {"type": "subtitle", "time": 17512.868, "timestamp": "04:51:52", "text": "本当に"}, {"type": "subtitle", "time": 17515.19, "timestamp": "04:51:55", "text": "手に入れるべきだよ。 IO。"}, {"type": "subtitle", "time": 17518.948, "timestamp": "04:51:58", "text": "持っています。ああ、そうなんですか？"}]
[{"type": "subtitle", "time": 360.629, "timestamp": "00:06:00", "text": "私が必要とするお金の総額"}, {"type": "subtitle", "time": 363.909, "timestamp": "00:06:03", "text": "モデルデビューに関する話。そこで私はこう考えました。"}, {"type": "subtitle", "time": 366.27, "timestamp": "00:06:06", "text": "「ああ、そうだな。そうしよう」"}, {"type": "subtitle", "time": 369.029, "timestamp": "00:06:09", "text": "「でも、もし私がそれを失ってしまったら心配です。」"}, {"type": "subtitle", "time": 371.35, "timestamp": "00:06:11", "text": "会員登録と収益化"}, {"type": "subtitle", "time": 375.029, "timestamp": "00:06:15", "text": "えっと、7月に日本にいるとき、"}, {"type": "subtitle", "time": 378.23, "timestamp": "00:06:18", "text": "忙しくなるから、できるよ。私"}, {"type": "subtitle", "time": 380.83, "timestamp": "00:06:20", "text": "ストリーミングできるかどうかわからないし"}, {"type": "subtitle", "time": 383.189, "timestamp": "00:06:23", "text": "すべて。落ち着いて見てみよう"}, {"type": "subtitle", "time": 385.87, "timestamp": "00:06:25", "text": "もし私がこっそりストリーミングして"}, {"type": "subtitle", "time": 388.71, "timestamp": "00:06:28", "text": "すべて。ええ、そうですね。素晴らしい。私はしていません"}, {"type": "subtitle", "time": 390.87, "timestamp": "00:06:30", "text": "マイリングからずいぶん時間が経ちました"}, {"type": "subtitle", "time": 394.909, "timestamp": "00:06:34", "text": "軍隊式スタンディングスタート。ああ、それは"}, {"type": "subtitle", "time": 397.30899999999997, "timestamp": "00:06:37", "text": "わかった。必ずそうします"}, {"type": "subtitle", "time": 405.71, "timestamp": "00:06:45", "text": "最高。わかった。"}, {"type": "subtitle", "time": 416.59000000000003, "timestamp": "00:06:56", "text": "えっと、明日"}]
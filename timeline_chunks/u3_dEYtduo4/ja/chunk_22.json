[{"type": "subtitle", "time": 1321.99, "timestamp": "00:22:01", "text": "死んだ。でも、遊び場をそのままにしておこう"}, {"type": "subtitle", "time": 1324.669, "timestamp": "00:22:04", "text": "メンバーと遊ぶ、私は"}, {"type": "subtitle", "time": 1328.23, "timestamp": "00:22:08", "text": "推測。えーと、グッズストアは"}, {"type": "subtitle", "time": 1333.07, "timestamp": "00:22:13", "text": "アップ、私のグッズストアは"}, {"type": "subtitle", "time": 1336.63, "timestamp": "00:22:16", "text": "上。公式グッズストアのグッズは"}, {"type": "subtitle", "time": 1339.35, "timestamp": "00:22:19", "text": "上。公式グッズストアがオープンしました。あなたはできる"}, {"type": "subtitle", "time": 1343.47, "timestamp": "00:22:23", "text": "このコンテンツがあります。ああ、割引"}, {"type": "subtitle", "time": 1348.47, "timestamp": "00:22:28", "text": "ウェブサイトで割引価格"}, {"type": "subtitle", "time": 1353.149, "timestamp": "00:22:33", "text": "公式の監視下で"}, {"type": "subtitle", "time": 1355.39, "timestamp": "00:22:35", "text": "Webサイト。"}, {"type": "subtitle", "time": 1366.47, "timestamp": "00:22:46", "text": "神。ウェブサイトのほうが良いでしょう"}, {"type": "subtitle", "time": 1374.23, "timestamp": "00:22:54", "text": "君は私のものだ。待って、あなたは"}]
[{"type": "subtitle", "time": 1680.149, "timestamp": "00:28:00", "text": "ついに、ついにYouTubeになりました"}, {"type": "subtitle", "time": 1683.029, "timestamp": "00:28:03", "text": "パートナー。私は収益化できる。いいえ、できません"}, {"type": "subtitle", "time": 1685.029, "timestamp": "00:28:05", "text": "まだ収益化していない。でも私は"}, {"type": "subtitle", "time": 1687.99, "timestamp": "00:28:07", "text": "会員制とかスーパーチャットとか、そういうもの。"}, {"type": "subtitle", "time": 1691.43, "timestamp": "00:28:11", "text": "それでついにYouTubeにたどり着いた。何てことだ。"}, {"type": "subtitle", "time": 1693.83, "timestamp": "00:28:13", "text": "5年間懸命に働き、"}, {"type": "subtitle", "time": 1695.149, "timestamp": "00:28:15", "text": "決して与えない"}, {"type": "subtitle", "time": 1698.149, "timestamp": "00:28:18", "text": "上。ついにYouTubeだ。私の長期目標"}, {"type": "subtitle", "time": 1701.669, "timestamp": "00:28:21", "text": "今日は成功しました。今日。うん。私"}, {"type": "subtitle", "time": 1704.95, "timestamp": "00:28:24", "text": "信じられないよ。"}, {"type": "subtitle", "time": 1707.149, "timestamp": "00:28:27", "text": "まだ"}, {"type": "subtitle", "time": 1710.59, "timestamp": "00:28:30", "text": "ええと、まだそんな"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "そんなもの。そしてパパイヤはただ、ああ、私は"}, {"type": "subtitle", "time": 1718.149, "timestamp": "00:28:38", "text": "ごめん。とても疲れていた。私はできなかった"}, {"type": "subtitle", "time": 1720.95, "timestamp": "00:28:40", "text": "パパイヤジュースを飲むと、"}, {"type": "subtitle", "time": 1722.35, "timestamp": "00:28:42", "text": "行った"}, {"type": "subtitle", "time": 1725.669, "timestamp": "00:28:45", "text": "夕方まで放置していたので、良くなかったです。それで、"}, {"type": "subtitle", "time": 1729.59, "timestamp": "00:28:49", "text": "私のせいだ。ええ、わかっています。"}, {"type": "subtitle", "time": 1732.149, "timestamp": "00:28:52", "text": "プロフィールがあれば、表示してください"}, {"type": "subtitle", "time": 1734.149, "timestamp": "00:28:54", "text": "あなたのチャンネルページに彼らのプロフィールが表示されます。もし"}, {"type": "subtitle", "time": 1735.389, "timestamp": "00:28:55", "text": "ありがとうございます"}, {"type": "subtitle", "time": 1738.63, "timesta
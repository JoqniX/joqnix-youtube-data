[{"type": "subtitle", "time": 13380.44, "timestamp": "03:43:00", "text": "彼は言った"}, {"type": "subtitle", "time": 13396.91, "timestamp": "03:43:16", "text": "それ。いや、いや、いや。"}, {"type": "subtitle", "time": 13405.75, "timestamp": "03:43:25", "text": "ぬらさき、読み込みに時間がかかっています。私"}, {"type": "subtitle", "time": 13411.91, "timestamp": "03:43:31", "text": "彼女は私が作るべきだということが大好きです"}, {"type": "subtitle", "time": 13414.389, "timestamp": "03:43:34", "text": "サムネイルと、えーとこれ"}, {"type": "subtitle", "time": 13433.389, "timestamp": "03:43:53", "text": "[音楽]"}]
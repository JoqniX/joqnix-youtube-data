[{"type": "subtitle", "time": 19160.948, "timestamp": "05:19:20", "text": "星座 天体 有料。よし、これ"}, {"type": "subtitle", "time": 19173.35, "timestamp": "05:19:33", "text": "わかった。ベール、両生類、滑り台、弾む、"}, {"type": "subtitle", "time": 19180.55, "timestamp": "05:19:40", "text": "終わり。そして私は吐き出すことを頼まなければならない"}, {"type": "subtitle", "time": 19182.35, "timestamp": "05:19:42", "text": "個性的"}, {"type": "subtitle", "time": 19185.45, "timestamp": "05:19:45", "text": "武器は持っていないが、こいつは捕まえた。いいえ。"}, {"type": "subtitle", "time": 19188.43, "timestamp": "05:19:48", "text": "[音楽]"}]
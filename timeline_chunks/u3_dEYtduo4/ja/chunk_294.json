[{"type": "subtitle", "time": 17650.948, "timestamp": "04:54:10", "text": "グラインダー。待って、グラインド。停止。"}, {"type": "subtitle", "time": 17653.03, "timestamp": "04:54:13", "text": "だから私は"}, {"type": "subtitle", "time": 17670.47, "timestamp": "04:54:30", "text": "明日の予定は？"}, {"type": "subtitle", "time": 17672.708, "timestamp": "04:54:32", "text": "明日はMinecraftにいいねするか、"}, {"type": "subtitle", "time": 17674.31, "timestamp": "04:54:34", "text": "ストリーム？"}, {"type": "subtitle", "time": 17677.43, "timestamp": "04:54:37", "text": "ストリーム用。ああ、私たちは"}, {"type": "subtitle", "time": 17679.67, "timestamp": "04:54:39", "text": "これ。何をすればいいのかわからない"}, {"type": "subtitle", "time": 17681.75, "timestamp": "04:54:41", "text": "ストリーム。実際、私はただ"}, {"type": "subtitle", "time": 17684.708, "timestamp": "04:54:44", "text": "会員限定ストリーム。でも眠くなるだろう"}, {"type": "subtitle", "time": 17687.39, "timestamp": "04:54:47", "text": "だって、私は寝ていないから。"}, {"type": "subtitle", "time": 17689.948, "timestamp": "04:54:49", "text": "ああ、私は"}, {"type": "subtitle", "time": 17692.948, "timestamp": "04:54:52", "text": "寝る。これからどうなるかは分からない。私"}, {"type": "subtitle", "time": 17696.03, "timestamp": "04:54:56", "text": "すべてを適切に準備する必要があります。"}, {"type": "subtitle", "time": 17699.628, "timestamp": "04:54:59", "text": "男。私は怠けてしまった"}]
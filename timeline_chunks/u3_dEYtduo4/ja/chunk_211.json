[{"type": "subtitle", "time": 12678.11, "timestamp": "03:31:18", "text": "それは何ですか？取るに足らないグミの歌。ああ、"}, {"type": "subtitle", "time": 12680.429, "timestamp": "03:31:20", "text": "神。それで"}, {"type": "subtitle", "time": 12683.19, "timestamp": "03:31:23", "text": "良い。そうそう。えっと、私は歌えます"}, {"type": "subtitle", "time": 12685.75, "timestamp": "03:31:25", "text": "これ。これは私のお気に入りの曲の一つです。"}, {"type": "subtitle", "time": 12686.83, "timestamp": "03:31:26", "text": "人形"}, {"type": "subtitle", "time": 12695.57, "timestamp": "03:31:35", "text": "はい、わかりました"}, {"type": "subtitle", "time": 12702.469, "timestamp": "03:31:42", "text": "それ。これは私のプレイリストです、"}, {"type": "subtitle", "time": 12705.229, "timestamp": "03:31:45", "text": "右？なぜそうなるのか"}, {"type": "subtitle", "time": 12718.12, "timestamp": "03:31:58", "text": "与える"}]
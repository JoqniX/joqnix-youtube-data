[{"type": "subtitle", "time": 17340.39, "timestamp": "04:49:00", "text": "問題は、それが消えてしまったのは"}, {"type": "subtitle", "time": 17342.43, "timestamp": "04:49:02", "text": "問題"}, {"type": "subtitle", "time": 17345.35, "timestamp": "04:49:05", "text": "待って、どうやって手に入れたの？"}, {"type": "subtitle", "time": 17348.23, "timestamp": "04:49:08", "text": "与えた"}, {"type": "subtitle", "time": 17351.03, "timestamp": "04:49:11", "text": "また、地図に従う価値はありますか？"}, {"type": "subtitle", "time": 17366.15, "timestamp": "04:49:26", "text": "そしてタビンは、ほら、私が見つけたように"}, {"type": "subtitle", "time": 17369.03, "timestamp": "04:49:29", "text": "墓地の地図をたくさん持っていて、"}, {"type": "subtitle", "time": 17370.83, "timestamp": "04:49:30", "text": "たくさんのもの"}, {"type": "subtitle", "time": 17373.948, "timestamp": "04:49:33", "text": "胸。だから私はこう思った"}, {"type": "subtitle", "time": 17378.23, "timestamp": "04:49:38", "text": "宝物か何かかもしれない。私はそうは思わない"}, {"type": "subtitle", "time": 17380.55, "timestamp": "04:49:40", "text": "よくわからない。"}, {"type": "subtitle", "time": 17383.03, "timestamp": "04:49:43", "text": "ああ、見て。木々が消えつつある。"}, {"type": "subtitle", "time": 17386.19, "timestamp": "04:49:46", "text": "わあ、時間は"}, {"type": "subtitle", "time": 17388.948, "timestamp": "04:49:48", "text": "移動中。以前はそうではなかった。"}, {"type": "subtitle", "time": 17391.19, "timestamp": "04:49:51", "text": "今、"}, {"type": "subtitle", "time": 17393.91, "timestamp": "04:49:53", "text": "時間が進んでいるのは良いことだ"}, {"type": "subtitle", "time": 17396.67, "timestamp": "04:49:56", "text": "なぜならそれはとてもとても"}]
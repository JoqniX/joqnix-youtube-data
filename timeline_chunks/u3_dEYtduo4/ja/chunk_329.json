[{"type": "subtitle", "time": 19741.35, "timestamp": "05:29:01", "text": "なぜ？なぜ泣いたのですか？"}, {"type": "subtitle", "time": 19744.708, "timestamp": "05:29:04", "text": "私は全てを失った、D。"}, {"type": "subtitle", "time": 19746.39, "timestamp": "05:29:06", "text": "何てことだ。元に戻しましたか？待って、"}, {"type": "subtitle", "time": 19749.67, "timestamp": "05:29:09", "text": "確認してみます。はい、確認させてください。"}, {"type": "subtitle", "time": 19752.07, "timestamp": "05:29:12", "text": "私の荷物はどこにあるの？"}, {"type": "subtitle", "time": 19755.67, "timestamp": "05:29:15", "text": "ちょっと待って。どうすればこれを手に入れられるのですか？どうすればいいですか"}, {"type": "subtitle", "time": 19760.23, "timestamp": "05:29:20", "text": "この剣を持っているか？わからない。"}, {"type": "subtitle", "time": 19768.948, "timestamp": "05:29:28", "text": "アラが返してくれた。"}, {"type": "subtitle", "time": 19772.11, "timestamp": "05:29:32", "text": "ああ、なんてことだ、うちには植物がある。"}, {"type": "subtitle", "time": 19774.75, "timestamp": "05:29:34", "text": "はい。そして"}, {"type": "subtitle", "time": 19778.31, "timestamp": "05:29:38", "text": "えっと、私が渡さなければならないものがあります"}, {"type": "subtitle", "time": 19781.07, "timestamp": "05:29:41", "text": "バックパック"}, {"type": "subtitle", "time": 19794.15, "timestamp": "05:29:54", "text": "たぶんこの中にあると思う。どこですか？"}, {"type": "subtitle", "time": 19796.59, "timestamp": "05:29:56", "text": "ええ、これはあなたの"}, {"type": "subtitle", "time": 19799.35, "timestamp": "05:29:59", "text": "バックパック。装備してください。それはあなたの"}]
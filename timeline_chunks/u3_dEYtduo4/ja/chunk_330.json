[{"type": "subtitle", "time": 19802.47, "timestamp": "05:30:02", "text": "バックパック。もっと多くの商品を保管できます。"}, {"type": "subtitle", "time": 19806.31, "timestamp": "05:30:06", "text": "それを腕の防具の中に入れてください。の"}, {"type": "subtitle", "time": 19808.47, "timestamp": "05:30:08", "text": "胸当て。別の枠が設けられます。"}, {"type": "subtitle", "time": 19816.708, "timestamp": "05:30:16", "text": "そこには。届きましたか？"}, {"type": "subtitle", "time": 19820.708, "timestamp": "05:30:20", "text": "どうやって背中に背負えばいいですか？えっと、君"}, {"type": "subtitle", "time": 19823.43, "timestamp": "05:30:23", "text": "それを鎧に付けてください。 2つ目があります"}, {"type": "subtitle", "time": 19826.47, "timestamp": "05:30:26", "text": "鎧の胸当てにスロットがあります。おお、"}, {"type": "subtitle", "time": 19828.788, "timestamp": "05:30:28", "text": "わかった。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 19832.47, "timestamp": "05:30:32", "text": "うん。そして「はい」を押します。はい。"}, {"type": "subtitle", "time": 19835.51, "timestamp": "05:30:35", "text": "わーい。わかった。キーボードのBを押して"}, {"type": "subtitle", "time": 19838.708, "timestamp": "05:30:38", "text": "バックパックを取って。"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "ああ、なるほど。だから、ここに物を置けるんだ。"}, {"type": "subtitle", "time": 19850.99, "timestamp": "05:30:50", "text": "エストラはあなたの後ろにいます。うん。"}]
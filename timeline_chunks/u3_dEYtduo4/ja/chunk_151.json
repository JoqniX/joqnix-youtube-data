[{"type": "subtitle", "time": 9063.83, "timestamp": "02:31:03", "text": "それ。わかった。遺物、天才。わかった。どこで"}, {"type": "subtitle", "time": 9066.11, "timestamp": "02:31:06", "text": "並べ替える？"}, {"type": "subtitle", "time": 9069.63, "timestamp": "02:31:09", "text": "わかった。ええと、ナムールと私は"}, {"type": "subtitle", "time": 9073.59, "timestamp": "02:31:13", "text": "知識に関してはあまり得意ではない。大丈夫。私"}, {"type": "subtitle", "time": 9075.67, "timestamp": "02:31:15", "text": "それ以来、私はVuvaをプレイしていません"}, {"type": "subtitle", "time": 9079.27, "timestamp": "02:31:19", "text": "あの、ツインテールの女性が来た。その赤"}, {"type": "subtitle", "time": 9082.71, "timestamp": "02:31:22", "text": "頭は白、赤、白のツインテール"}, {"type": "subtitle", "time": 9084.63, "timestamp": "02:31:24", "text": "女性が来た。私はプレイしていません。後"}, {"type": "subtitle", "time": 9087.349, "timestamp": "02:31:27", "text": "海岸警備員を手に入れて、私は止まった"}, {"type": "subtitle", "time": 9089.15, "timestamp": "02:31:29", "text": "ゲームをプレイする、"}, {"type": "subtitle", "time": 9092.55, "timestamp": "02:31:32", "text": "男。私はショアキーパーが大好きです。彼女は"}]
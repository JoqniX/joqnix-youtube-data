[{"type": "subtitle", "time": 11291.67, "timestamp": "03:08:11", "text": "[音楽]"}, {"type": "subtitle", "time": 11292.83, "timestamp": "03:08:12", "text": "とても良い"}, {"type": "subtitle", "time": 11295.99, "timestamp": "03:08:15", "text": "歌。これらは私が"}, {"type": "subtitle", "time": 11298.99, "timestamp": "03:08:18", "text": "いつか歌いたいプレイリスト。しかし"}, {"type": "subtitle", "time": 11308.67, "timestamp": "03:08:28", "text": "去った。待って、これ知ってるよ。それは一滴ですか？"}, {"type": "subtitle", "time": 11313.01, "timestamp": "03:08:33", "text": "1つ？ああ、一滴だ。"}, {"type": "subtitle", "time": 11334.51, "timestamp": "03:08:54", "text": "ラバカンです"}]
[{"type": "subtitle", "time": 7142.43, "timestamp": "01:59:02", "text": "上。ああ、わかりました。はい、結構です。それは"}, {"type": "subtitle", "time": 7145.17, "timestamp": "01:59:05", "text": "良い。私はしくじった。"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "こんなに長い間練習してない"}, {"type": "subtitle", "time": 7160.95, "timestamp": "01:59:20", "text": "いいえ。いいえ。歌いたくないです。"}, {"type": "subtitle", "time": 7163.229, "timestamp": "01:59:23", "text": "これ。その"}, {"type": "subtitle", "time": 7171.669, "timestamp": "01:59:31", "text": "コシは曲作りが本当に難しいと思った。"}, {"type": "subtitle", "time": 7173.43, "timestamp": "01:59:33", "text": "彼女が自分の歌をどうやって歌うのか分からない"}, {"type": "subtitle", "time": 7176.07, "timestamp": "01:59:36", "text": "歌。それはすごくクールだね。"}, {"type": "subtitle", "time": 7178.59, "timestamp": "01:59:38", "text": "よし、やってみよう"}, {"type": "subtitle", "time": 7182.43, "timestamp": "01:59:42", "text": "[音楽]"}, {"type": "subtitle", "time": 7185.31, "timestamp": "01:59:45", "text": "これ。あのね？私がやります"}, {"type": "subtitle", "time": 7188.55, "timestamp": "01:59:48", "text": "曲を聴かずに。はい、では"}, {"type": "subtitle", "time": 7191.99, "timestamp": "01:59:51", "text": "歌詞を読んでください。私は読むことができます"}, {"type": "subtitle", "time": 7198.27, "timestamp": "01:59:58", "text": "日本語。"}]
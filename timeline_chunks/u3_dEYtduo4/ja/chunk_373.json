[{"type": "subtitle", "time": 22380.11, "timestamp": "06:13:00", "text": "我が神よ、"}, {"type": "subtitle", "time": 22384.31, "timestamp": "06:13:04", "text": "ジュラ。私は、あのねえ、知ってる？私"}, {"type": "subtitle", "time": 22385.99, "timestamp": "06:13:05", "text": "人気の使用をやめるべきだと思う"}, {"type": "subtitle", "time": 22391.59, "timestamp": "06:13:11", "text": "プレイ中に名前を置く"}, {"type": "subtitle", "time": 22395.27, "timestamp": "06:13:15", "text": "7月。あれは何ですか？わからない。うん、"}, {"type": "subtitle", "time": 22397.35, "timestamp": "06:13:17", "text": "それが理由です"}, {"type": "subtitle", "time": 22400.548, "timestamp": "06:13:20", "text": "ジュリーは最高だ。基本的には乗り物です。"}, {"type": "subtitle", "time": 22409.91, "timestamp": "06:13:29", "text": "何？"}, {"type": "subtitle", "time": 22413.51, "timestamp": "06:13:33", "text": "遊園地の名前は"}, {"type": "subtitle", "time": 22416.628, "timestamp": "06:13:36", "text": "男たちは何について話しているのか？"}, {"type": "subtitle", "time": 22421.03, "timestamp": "06:13:41", "text": "ポーランド。ああ、でもただ言ってみただけだよ。いいえ、私は"}, {"type": "subtitle", "time": 22423.99, "timestamp": "06:13:43", "text": "知る。知っている。私はそんなに馬鹿じゃない。しないで"}, {"type": "subtitle", "time": 22426.15, "timestamp": "06:13:46", "text": "心配。私がいつ君をバカだと言った？私"}]
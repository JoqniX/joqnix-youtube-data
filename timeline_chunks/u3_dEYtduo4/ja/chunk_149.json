[{"type": "subtitle", "time": 8940.71, "timestamp": "02:29:00", "text": "純粋に満足して演奏する"}, {"type": "subtitle", "time": 8944.15, "timestamp": "02:29:04", "text": "おもちゃを一緒に。"}, {"type": "subtitle", "time": 8945.99, "timestamp": "02:29:05", "text": "もしかしたら私は何千もの"}, {"type": "subtitle", "time": 8956.309, "timestamp": "02:29:16", "text": "Twitchでフォローしてくれてありがとう。こんにちは。"}, {"type": "subtitle", "time": 8957.83, "timestamp": "02:29:17", "text": "私たちは歌を覚えようとしています。私はしようとしています"}, {"type": "subtitle", "time": 8959.87, "timestamp": "02:29:19", "text": "歌う。ブー"}, {"type": "subtitle", "time": 8966.91, "timestamp": "02:29:26", "text": "ブー。待って、DJ。 DJをプレイする"}, {"type": "subtitle", "time": 8969.429, "timestamp": "02:29:29", "text": "えっと、あなたはウィザリング・ウェーブスをプレイしますよね？あなた"}, {"type": "subtitle", "time": 8971.15, "timestamp": "02:29:31", "text": "その曲を聴いたことがあるかもしれない"}, {"type": "subtitle", "time": 8974.309, "timestamp": "02:29:34", "text": "この女の子から。忘れた。"}, {"type": "subtitle", "time": 8978.59, "timestamp": "02:29:38", "text": "あの女の子が見えますか？金髪の少女。"}, {"type": "subtitle", "time": 8981.27, "timestamp": "02:29:41", "text": "ああ、そうだ、その曲だ。それは"}, {"type": "subtitle", "time": 8991.309, "timestamp": "02:29:51", "text": "推測。見てください"}, {"type": "subtitle", "time": 8994.389, "timestamp": "02:29:54", "text": "彼女。ええ、彼女の歌です。それは彼女のテーマです"}, {"type": "subtitle", "time": 8997.349, "timestamp": "02:29:57", "text": "歌かな、それとも何か別のものかな。それは"}, {"type": "subtitle", "time": 8999.19, "timestamp": "02:29:59", "text": "ゲームの中にあると思います。その"}]
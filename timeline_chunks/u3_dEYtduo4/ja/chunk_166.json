[{"type": "subtitle", "time": 9963.91, "timestamp": "02:46:03", "text": "これは本当に美味しい。ああ、これは私が"}, {"type": "subtitle", "time": 9970.71, "timestamp": "02:46:10", "text": "良い？でも、それは私が好きな曲の1つです"}, {"type": "subtitle", "time": 9973.91, "timestamp": "02:46:13", "text": "気に入った。そしてバッファー、バッファームーンは"}, {"type": "subtitle", "time": 9983.91, "timestamp": "02:46:23", "text": "それは未来、未来に基づいたもののようなもの"}, {"type": "subtitle", "time": 9986.03, "timestamp": "02:46:26", "text": "未来はいいえ"}, {"type": "subtitle", "time": 9989.67, "timestamp": "02:46:29", "text": "えっと、テンドラって何？フューチャーポップフューチャー"}, {"type": "subtitle", "time": 10018.28, "timestamp": "02:46:58", "text": "[笑い]"}]
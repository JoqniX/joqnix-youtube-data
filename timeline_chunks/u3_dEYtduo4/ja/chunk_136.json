[{"type": "subtitle", "time": 8161.79, "timestamp": "02:16:01", "text": "行く。難しいですね。難しいですね。"}, {"type": "subtitle", "time": 8165.95, "timestamp": "02:16:05", "text": "ああ、わかりました。でも、あなたにはこれが見えないんですよね？"}, {"type": "subtitle", "time": 8167.24, "timestamp": "02:16:07", "text": "え、何？"}, {"type": "subtitle", "time": 8168.75, "timestamp": "02:16:08", "text": "[音楽]"}, {"type": "subtitle", "time": 8179.75, "timestamp": "02:16:19", "text": "これをコピーしてここに貼り付けます。"}, {"type": "subtitle", "time": 8180.91, "timestamp": "02:16:20", "text": "私たちは"}, {"type": "subtitle", "time": 8183.79, "timestamp": "02:16:23", "text": "今はもう見えない。"}, {"type": "subtitle", "time": 8205.58, "timestamp": "02:16:45", "text": "えっと、私は"}, {"type": "subtitle", "time": 8208.27, "timestamp": "02:16:48", "text": "[音楽]"}, {"type": "subtitle", "time": 8211.15, "timestamp": "02:16:51", "text": "そのアート作品はとても"}, {"type": "subtitle", "time": 8214.709, "timestamp": "02:16:54", "text": "まるでヴヴァスのようにクールです。もちろん、"}]
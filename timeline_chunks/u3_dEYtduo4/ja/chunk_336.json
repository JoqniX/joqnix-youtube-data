[{"type": "subtitle", "time": 20161.75, "timestamp": "05:36:01", "text": "みんな。コメントできます。買います。"}, {"type": "subtitle", "time": 20164.628, "timestamp": "05:36:04", "text": "くそっ。くそっ。待って。どうすればここから出られますか？"}, {"type": "subtitle", "time": 20166.868, "timestamp": "05:36:06", "text": "コントロール。"}, {"type": "subtitle", "time": 20170.15, "timestamp": "05:36:10", "text": "うん。座る。仕事。座る。コントロールまたはC。了解。"}, {"type": "subtitle", "time": 20173.35, "timestamp": "05:36:13", "text": "うん。写真を撮ってください。待って。これは、えーと"}, {"type": "subtitle", "time": 20175.27, "timestamp": "05:36:15", "text": "私の。"}, {"type": "subtitle", "time": 20177.19, "timestamp": "05:36:17", "text": "うん。それでは、写真を撮らせていただきます。見て。"}, {"type": "subtitle", "time": 20180.788, "timestamp": "05:36:20", "text": "見て。まっすぐ私を見ないで。"}, {"type": "subtitle", "time": 20182.35, "timestamp": "05:36:22", "text": "あなた"}, {"type": "subtitle", "time": 20186.948, "timestamp": "05:36:26", "text": "写真を撮ることができます。できます。引き分けだ。"}, {"type": "subtitle", "time": 20207.11, "timestamp": "05:36:47", "text": "えっと、どんなアーマーみたいなものを装着したの？"}, {"type": "subtitle", "time": 20210.07, "timestamp": "05:36:50", "text": "その照明はあなたのものですか？"}, {"type": "subtitle", "time": 20212.628, "timestamp": "05:36:52", "text": "えっと、テンプレートみたいなものです。必要がある"}, {"type": "subtitle", "time": 20216.39, "timestamp": "05:36:56", "text": "そのドロップを見つけ出すとか、そういうこと。あなたができるなら"}, {"type": "subtitle", "time": 20219.59, "timestamp": "05:36:59", "text": "一つ見つけたら、それを複製する必要がある。"}]
[{"type": "subtitle", "time": 15780.349, "timestamp": "04:23:00", "text": "もの。ええ、それは"}, {"type": "subtitle", "time": 15784.63, "timestamp": "04:23:04", "text": "大丈夫。私が重要だと思う部分は、"}, {"type": "subtitle", "time": 15786.79, "timestamp": "04:23:06", "text": "私は思う。何だって？うん。だから何"}, {"type": "subtitle", "time": 15790.75, "timestamp": "04:23:10", "text": "量は十分でしたか？私はあげる"}, {"type": "subtitle", "time": 15794.469, "timestamp": "04:23:14", "text": "あなたは赤い回復薬を1つ持っています。"}, {"type": "subtitle", "time": 15797.11, "timestamp": "04:23:17", "text": "それから黄色いポーションを持っていたと思う"}, {"type": "subtitle", "time": 15798.87, "timestamp": "04:23:18", "text": "強さ。"}, {"type": "subtitle", "time": 15801.87, "timestamp": "04:23:21", "text": "すると茶色のポーションが"}, {"type": "subtitle", "time": 15804.99, "timestamp": "04:23:24", "text": "ハムです。"}, {"type": "subtitle", "time": 15808.75, "timestamp": "04:23:28", "text": "わかった。すると、"}, {"type": "subtitle", "time": 15813.59, "timestamp": "04:23:33", "text": "緑色の滑り台。いいえ。ええ。うん。私は与えています"}, {"type": "subtitle", "time": 15837.349, "timestamp": "04:23:57", "text": "あの地図は使えないですよね？ええと、"}, {"type": "subtitle", "time": 15839.91, "timestamp": "04:23:59", "text": "地図は入手できないんですよね？あなたは私が必要としている"}]
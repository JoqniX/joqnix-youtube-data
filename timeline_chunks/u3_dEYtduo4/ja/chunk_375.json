[{"type": "subtitle", "time": 22502.47, "timestamp": "06:15:02", "text": "あなたは眠る必要があります。"}, {"type": "subtitle", "time": 22504.868, "timestamp": "06:15:04", "text": "うん、"}, {"type": "subtitle", "time": 22506.31, "timestamp": "06:15:06", "text": "わからない。私は自分の"}, {"type": "subtitle", "time": 22512.23, "timestamp": "06:15:12", "text": "すると両親が私を起こしてくれる"}, {"type": "subtitle", "time": 22529.75, "timestamp": "06:15:29", "text": "[音楽]"}, {"type": "subtitle", "time": 22533.67, "timestamp": "06:15:33", "text": "懐中電灯はランタンよりも良い。"}, {"type": "subtitle", "time": 22535.75, "timestamp": "06:15:35", "text": "右？"}, {"type": "subtitle", "time": 22539.11, "timestamp": "06:15:39", "text": "まあ、そんな感じかな。それは美的感覚に近い"}, {"type": "subtitle", "time": 22541.03, "timestamp": "06:15:41", "text": "チーズ。"}, {"type": "subtitle", "time": 22543.51, "timestamp": "06:15:43", "text": "そして、光り輝く。あなたが望むなら。"}, {"type": "subtitle", "time": 22547.67, "timestamp": "06:15:47", "text": "うん、だいたい同じような茶色だね。ああ、私は"}, {"type": "subtitle", "time": 22549.35, "timestamp": "06:15:49", "text": "照明をアップデートしたと思った"}, {"type": "subtitle", "time": 22552.07, "timestamp": "06:15:52", "text": "このゲームの機能。"}, {"type": "subtitle", "time": 22557.67, "timestamp": "06:15:57", "text": "ああ、ランタンがあるよ。とった。ランタン。"}]
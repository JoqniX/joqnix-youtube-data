[{"type": "subtitle", "time": 18360.72, "timestamp": "05:06:00", "text": "ゆりかご。それはゆりかごではありません。それはベビーベッドです。"}, {"type": "subtitle", "time": 18362.948, "timestamp": "05:06:02", "text": "[音楽]"}, {"type": "subtitle", "time": 18365.91, "timestamp": "05:06:05", "text": "素晴らしい人形のようですね。赤ちゃんは"}, {"type": "subtitle", "time": 18369.27, "timestamp": "05:06:09", "text": "あなた。赤ちゃんは可愛い。"}, {"type": "subtitle", "time": 18372.628, "timestamp": "05:06:12", "text": "うん。また、この魔法には15冊の本が必要です"}, {"type": "subtitle", "time": 18377.19, "timestamp": "05:06:17", "text": "[音楽]"}, {"type": "subtitle", "time": 18379.91, "timestamp": "05:06:19", "text": "どうしたの？"}, {"type": "subtitle", "time": 18387.23, "timestamp": "05:06:27", "text": "[音楽]"}, {"type": "subtitle", "time": 18391.27, "timestamp": "05:06:31", "text": "いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。何？"}, {"type": "subtitle", "time": 18392.788, "timestamp": "05:06:32", "text": "発表？"}, {"type": "subtitle", "time": 18397.19, "timestamp": "05:06:37", "text": "いや、いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 18405.55, "timestamp": "05:06:45", "text": "発表、何が"}, {"type": "subtitle", "time": 18410.35, "timestamp": "05:06:50", "text": "ハプニング？カナ。何"}, {"type": "subtitle", "time": 18413.31, "timestamp": "05:06:53", "text": "何が起こったのか？見てください"}, {"type": "subtitle", "time": 18417.43, "timestamp": "05:06:57", "text": "この映画には重要な発表があります"}]
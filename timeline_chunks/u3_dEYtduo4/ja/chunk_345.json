[{"type": "subtitle", "time": 20701.868, "timestamp": "05:45:01", "text": "右？ベールをつけてあなたに"}, {"type": "subtitle", "time": 20704.75, "timestamp": "05:45:04", "text": "ヘルメット。これはマイニングに役立ちます。"}, {"type": "subtitle", "time": 20721.11, "timestamp": "05:45:21", "text": "これは何ですか？あなたは何者ですか"}, {"type": "subtitle", "time": 20724.43, "timestamp": "05:45:24", "text": "作っている？はい、これはあなたの"}, {"type": "subtitle", "time": 20726.708, "timestamp": "05:45:26", "text": "ヘルメット。それはあなたが"}, {"type": "subtitle", "time": 20730.27, "timestamp": "05:45:30", "text": "モンスターから守られている。彼らは見ないだろう"}, {"type": "subtitle", "time": 20733.75, "timestamp": "05:45:33", "text": "あなた。しゃがむようにしてもいいですよ。ええ、もしあなたが"}, {"type": "subtitle", "time": 20736.628, "timestamp": "05:45:36", "text": "しゃがむ。それの使い方は？使用方法"}, {"type": "subtitle", "time": 20738.19, "timestamp": "05:45:38", "text": "それ？のように"}, {"type": "subtitle", "time": 20741.59, "timestamp": "05:45:41", "text": "いや、いや、いや、いや。しゃがむときだけ"}, {"type": "subtitle", "time": 20755.27, "timestamp": "05:45:55", "text": "これでプレイヤーは、モンスターには見えないものを見ることができるようになった。"}, {"type": "subtitle", "time": 20758.19, "timestamp": "05:45:58", "text": "わかった。ねえ、何が何が"}]
[{"type": "subtitle", "time": 17167.75, "timestamp": "04:46:07", "text": "ええと、シルクタッチはシャベルに適しています。"}, {"type": "subtitle", "time": 17169.35, "timestamp": "04:46:09", "text": "右？"}, {"type": "subtitle", "time": 17171.75, "timestamp": "04:46:11", "text": "何？シルクタッチは"}, {"type": "subtitle", "time": 17173.99, "timestamp": "04:46:13", "text": "シャベルですよね？"}, {"type": "subtitle", "time": 17177.35, "timestamp": "04:46:17", "text": "何？何のために？シルクタッチは"}, {"type": "subtitle", "time": 17180.948, "timestamp": "04:46:20", "text": "シャベルのことですよね？シャベル。"}, {"type": "subtitle", "time": 17182.47, "timestamp": "04:46:22", "text": "いいえ。"}, {"type": "subtitle", "time": 17185.51, "timestamp": "04:46:25", "text": "ああ、なんてことだ。おお。あるいは、きっとそうでしょう。そして"}, {"type": "subtitle", "time": 17187.43, "timestamp": "04:46:27", "text": "そんなものはない"}, {"type": "subtitle", "time": 17190.868, "timestamp": "04:46:30", "text": "シャベル。しかし、つるはしの方が良いのは"}, {"type": "subtitle", "time": 17194.708, "timestamp": "04:46:34", "text": "溶けてるよね？その製錬能力。"}, {"type": "subtitle", "time": 17197.19, "timestamp": "04:46:37", "text": "何をお求めかによります。ほら、私たちは"}, {"type": "subtitle", "time": 17200.15, "timestamp": "04:46:40", "text": "これらを使って氷を作ることができます。見て"}, {"type": "subtitle", "time": 17216.07, "timestamp": "04:46:56", "text": "はい、あなたの後ろにいます。"}, {"type": "subtitle", "time": 17219.67, "timestamp": "04:46:59", "text": "さあ、家に帰りましょう。私は本当に負けたと思う"}]
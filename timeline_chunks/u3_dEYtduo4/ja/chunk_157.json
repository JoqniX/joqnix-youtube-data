[{"type": "subtitle", "time": 9427.87, "timestamp": "02:37:07", "text": "夜。今、私は温かい方法を知っている"}, {"type": "subtitle", "time": 9431.429, "timestamp": "02:37:11", "text": "遠くから、歌全体を口笛で吹いてもいいですか？"}, {"type": "subtitle", "time": 9434.07, "timestamp": "02:37:14", "text": "歌わずに？そうします。それは"}, {"type": "subtitle", "time": 9436.67, "timestamp": "02:37:16", "text": "より良い。私は"}, {"type": "subtitle", "time": 9448.63, "timestamp": "02:37:28", "text": "待たずに。オーケーはどこにある？"}, {"type": "subtitle", "time": 9450.03, "timestamp": "02:37:30", "text": "そこにいる"}, {"type": "subtitle", "time": 9452.03, "timestamp": "02:37:32", "text": "は。"}]
[{"type": "subtitle", "time": 6241.91, "timestamp": "01:44:01", "text": "[音楽]"}, {"type": "subtitle", "time": 6244.83, "timestamp": "01:44:04", "text": "歌うときは、これ"}, {"type": "subtitle", "time": 6247.79, "timestamp": "01:44:07", "text": "上。気にします"}, {"type": "subtitle", "time": 6250.709, "timestamp": "01:44:10", "text": "それ。読めるようにカットします"}, {"type": "subtitle", "time": 6255.31, "timestamp": "01:44:15", "text": "歌詞。私たちは一緒に学ぶことができます"}, {"type": "subtitle", "time": 6257.91, "timestamp": "01:44:17", "text": "光沢がある。あ、待って。入れたと思う"}, {"type": "subtitle", "time": 6260.59, "timestamp": "01:44:20", "text": "はるかに"}, {"type": "subtitle", "time": 6263.99, "timestamp": "01:44:23", "text": "より良い。概念はどこにあるのか？私は思う"}, {"type": "subtitle", "time": 6267.75, "timestamp": "01:44:27", "text": "練習中の曲を全部移植しました"}, {"type": "subtitle", "time": 6271.669, "timestamp": "01:44:31", "text": "思いついたことを歌う。私はそれをやったと思います。"}, {"type": "subtitle", "time": 6274.709, "timestamp": "01:44:34", "text": "私がそんなことしたの？やった、やった、やった、やった"}, {"type": "subtitle", "time": 6275.55, "timestamp": "01:44:35", "text": "する"}, {"type": "subtitle", "time": 6283.91, "timestamp": "01:44:43", "text": "それ。うわぁ。見つかりません。見つかりません"}]
[{"type": "subtitle", "time": 2645.109, "timestamp": "00:44:05", "text": "自分が何を歌っているのか、正直よくわからない。"}, {"type": "subtitle", "time": 2647.71, "timestamp": "00:44:07", "text": "それはただのランダムな出来事です。私は"}, {"type": "subtitle", "time": 2649.829, "timestamp": "00:44:09", "text": "自分が何をしているのか、本当にわからない"}, {"type": "subtitle", "time": 2665.13, "timestamp": "00:44:25", "text": "私は確信しています"}, {"type": "subtitle", "time": 2667.309, "timestamp": "00:44:27", "text": "[音楽]"}, {"type": "subtitle", "time": 2670.589, "timestamp": "00:44:30", "text": "また、"}, {"type": "subtitle", "time": 2673.95, "timestamp": "00:44:33", "text": "私は本当に必要としていない"}]
[{"type": "subtitle", "time": 18241.83, "timestamp": "05:04:01", "text": "胸に当てますか？"}, {"type": "subtitle", "time": 18245.27, "timestamp": "05:04:05", "text": "ベンダーシュタインと書いたように、でも私は"}, {"type": "subtitle", "time": 18268.03, "timestamp": "05:04:28", "text": "水陸両用がいいかな。"}, {"type": "subtitle", "time": 18271.708, "timestamp": "05:04:31", "text": "私は水陸両用を使いました。それは私に"}, {"type": "subtitle", "time": 18274.628, "timestamp": "05:04:34", "text": "つまり、水中撮影はまだやっていないということです。"}, {"type": "subtitle", "time": 18276.868, "timestamp": "05:04:36", "text": "探検ですよね？なぜそうしないのですか"}, {"type": "subtitle", "time": 18278.628, "timestamp": "05:04:38", "text": "それ？"}, {"type": "subtitle", "time": 18283.67, "timestamp": "05:04:43", "text": "うん、水中の方がずっと安全だよ。"}, {"type": "subtitle", "time": 18287.07, "timestamp": "05:04:47", "text": "うん。そして、ダイヤモンドがもっと手に入ります"}, {"type": "subtitle", "time": 18290.47, "timestamp": "05:04:50", "text": "また。くそ。うん、そうするべきだね。私たちは"}]
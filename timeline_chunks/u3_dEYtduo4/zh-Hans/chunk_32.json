[{"type": "subtitle", "time": 1923.43, "timestamp": "00:32:03", "text": "不。把你的W拿出来。你会怎么做？"}, {"type": "subtitle", "time": 1925.389, "timestamp": "00:32:05", "text": "上了"}, {"type": "subtitle", "time": 1928.149, "timestamp": "00:32:08", "text": "地图？好了，各位。比某些物品更多"}, {"type": "subtitle", "time": 1931.35, "timestamp": "00:32:11", "text": "你跟我提起最多的那些事。最多。"}, {"type": "subtitle", "time": 1933.75, "timestamp": "00:32:13", "text": "哦，不。我不记得我做了什么。"}, {"type": "subtitle", "time": 1936.47, "timestamp": "00:32:16", "text": "今天。我的意思是，我看过，但是……"}, {"type": "subtitle", "time": 1939.789, "timestamp": "00:32:19", "text": "看过可能更有价值"}, {"type": "subtitle", "time": 1942.59, "timestamp": "00:32:22", "text": "比我做的都多"}, {"type": "subtitle", "time": 1955.87, "timestamp": "00:32:35", "text": "呃，我算是把这个翻倍了。"}, {"type": "subtitle", "time": 1957.47, "timestamp": "00:32:37", "text": "光谱"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "再次。我想如果我发出警告的话"}, {"type": "subtitle", "time": 1979.35, "timestamp": "00:32:59", "text": "自动：是的，没问题。我的天啊。"}]
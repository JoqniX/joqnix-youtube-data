[{"type": "subtitle", "time": 2774.39, "timestamp": "00:46:14", "text": "晚上7点到12点，7点到10点。好的。所以我有"}, {"type": "subtitle", "time": 2781.349, "timestamp": "00:46:21", "text": "像日语课那样的课"}, {"type": "subtitle", "time": 2783.67, "timestamp": "00:46:23", "text": "那些想要拥有特殊待遇的学生"}, {"type": "subtitle", "time": 2785.589, "timestamp": "00:46:25", "text": "没错吧？"}, {"type": "subtitle", "time": 2789.27, "timestamp": "00:46:29", "text": "复习课。所以我不知道什么时候"}, {"type": "subtitle", "time": 2791.15, "timestamp": "00:46:31", "text": "日期是，但将会是"}, {"type": "subtitle", "time": 2793.79, "timestamp": "00:46:33", "text": "很快"}, {"type": "subtitle", "time": 2798.309, "timestamp": "00:46:38", "text": "嗯，上面写着7到10。所以大概我会"}, {"type": "subtitle", "time": 2799.069, "timestamp": "00:46:39", "text": "有"}, {"type": "subtitle", "time": 2801.71, "timestamp": "00:46:41", "text": "开始"}, {"type": "subtitle", "time": 2811.19, "timestamp": "00:46:51", "text": "我必须对此采取一些措施。"}, {"type": "subtitle", "time": 2812.829, "timestamp": "00:46:52", "text": "溪流"}, {"type": "subtitle", "time": 2816.39, "timestamp": "00:46:56", "text": "正确的做法或许会提前结束它，或者"}, {"type": "subtitle", "time": 2817.55, "timestamp": "00:46:57", "text": "或许"}]
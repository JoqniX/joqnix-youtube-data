[{"type": "subtitle", "time": 16442.349, "timestamp": "04:34:02", "text": "堵塞。水块。"}, {"type": "subtitle", "time": 16445.67, "timestamp": "04:34:05", "text": "哇。所以，时间是静止的还是静止的"}, {"type": "subtitle", "time": 16454.429, "timestamp": "04:34:14", "text": "知识？但我认为他解决了这个问题。"}, {"type": "subtitle", "time": 16458.15, "timestamp": "04:34:18", "text": "它。阿斯特拉想改变一些东西。"}, {"type": "subtitle", "time": 16466.629, "timestamp": "04:34:26", "text": "什么？什么？什么？阿斯特拉想要改变"}, {"type": "subtitle", "time": 16468.551, "timestamp": "04:34:28", "text": "就像当前的故事或背景设定一样"}, {"type": "subtitle", "time": 16470.269, "timestamp": "04:34:30", "text": "某物。事情不会像他预想的那样发展。"}, {"type": "subtitle", "time": 16474.15, "timestamp": "04:34:34", "text": "想要看到有人辱骂之类的。"}, {"type": "subtitle", "time": 16476.39, "timestamp": "04:34:36", "text": "人们怎么了？"}, {"type": "subtitle", "time": 16491.429, "timestamp": "04:34:51", "text": "土豆。顺便说一句，你应该使用"}, {"type": "subtitle", "time": 16495.59, "timestamp": "04:34:55", "text": "两种作物种在同一行。你放了小麦"}, {"type": "subtitle", "time": 16498.869, "timestamp": "04:34:58", "text": "作物一行你种土豆作物"}]
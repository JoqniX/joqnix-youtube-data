[{"type": "subtitle", "time": 3187.71, "timestamp": "00:53:07", "text": "每个人。各位晚上好。"}, {"type": "subtitle", "time": 3191.87, "timestamp": "00:53:11", "text": "你好。你们能听到我说话吗？"}, {"type": "subtitle", "time": 3203.549, "timestamp": "00:53:23", "text": "嗯，我只是"}, {"type": "subtitle", "time": 3206.27, "timestamp": "00:53:26", "text": "音乐"}, {"type": "subtitle", "time": 3208.75, "timestamp": "00:53:28", "text": "正确的。你好"}, {"type": "subtitle", "time": 3211.63, "timestamp": "00:53:31", "text": "川。希望你们一切都好"}, {"type": "subtitle", "time": 3215.43, "timestamp": "00:53:35", "text": "出色地。你好。"}, {"type": "subtitle", "time": 3218.27, "timestamp": "00:53:38", "text": "所以，今天我只想做一件事"}, {"type": "subtitle", "time": 3221.069, "timestamp": "00:53:41", "text": "快速流"}, {"type": "subtitle", "time": 3225.349, "timestamp": "00:53:45", "text": "呃，因为最近比较忙。"}, {"type": "subtitle", "time": 3229.549, "timestamp": "00:53:49", "text": "因为事情太多，我没能跟上进度。"}, {"type": "subtitle", "time": 3232.15, "timestamp": "00:53:52", "text": "每个人。但是，是的，希望你们所有人都……"}, {"type": "subtitle", "time": 3234.589, "timestamp": "00:53:54", "text": "小伙子们表现不错。"}, {"type": "subtitle", "time": 3237.39, "timestamp": "00:53:57", "text": "你好吗？"}]
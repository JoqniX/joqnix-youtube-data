[{"type": "subtitle", "time": 19647.948, "timestamp": "05:27:27", "text": "我也想用，但我感觉我不应该用"}, {"type": "subtitle", "time": 19651.51, "timestamp": "05:27:31", "text": "这。就像我应该喜欢我没有一个"}, {"type": "subtitle", "time": 19653.628, "timestamp": "05:27:33", "text": "好长啊，我的天哪，太长了"}, {"type": "subtitle", "time": 19656.23, "timestamp": "05:27:36", "text": "卡住。好吧，我没有很长的路要走。"}, {"type": "subtitle", "time": 19658.628, "timestamp": "05:27:38", "text": "现在有了远程武器。我可以把它用作"}, {"type": "subtitle", "time": 19660.19, "timestamp": "05:27:40", "text": "离开"}, {"type": "subtitle", "time": 19663.83, "timestamp": "05:27:43", "text": "是的，我不应该用它来"}, {"type": "subtitle", "time": 19666.59, "timestamp": "05:27:46", "text": "长以外的其他东西"}, {"type": "subtitle", "time": 19669.91, "timestamp": "05:27:49", "text": "距离就像搏斗一样，就像看到"}, {"type": "subtitle", "time": 19673.43, "timestamp": "05:27:53", "text": "移动技巧将是超级跳跃"}, {"type": "subtitle", "time": 19674.27, "timestamp": "05:27:54", "text": "喜欢"}, {"type": "subtitle", "time": 19678.39, "timestamp": "05:27:58", "text": "这个和右边那个滑动的，所以我得到了"}]
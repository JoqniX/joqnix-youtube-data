[{"type": "subtitle", "time": 20942.868, "timestamp": "05:49:02", "text": "好了，现在你们有水滑梯了。耶。我"}, {"type": "subtitle", "time": 20946.788, "timestamp": "05:49:06", "text": "去吧，我想去。"}, {"type": "subtitle", "time": 20949.67, "timestamp": "05:49:09", "text": "你不能就这么"}, {"type": "subtitle", "time": 20954.27, "timestamp": "05:49:14", "text": "我不能。好了。我"}, {"type": "subtitle", "time": 20959.59, "timestamp": "05:49:19", "text": "哦，我其实可以等。呃，给米茨基"}, {"type": "subtitle", "time": 20962.31, "timestamp": "05:49:22", "text": "现在，你觉得……怎么样？"}, {"type": "subtitle", "time": 20964.788, "timestamp": "05:49:24", "text": "紧身裤会更好一些，比如"}, {"type": "subtitle", "time": 20968.35, "timestamp": "05:49:28", "text": "像肾上腺素一样迷失方向"}, {"type": "subtitle", "time": 20971.91, "timestamp": "05:49:31", "text": "你觉得她适合做什么？"}, {"type": "subtitle", "time": 20974.23, "timestamp": "05:49:34", "text": "保护？"}, {"type": "subtitle", "time": 20976.868, "timestamp": "05:49:36", "text": "我认为任何喜欢任何东西的人都会"}, {"type": "subtitle", "time": 20977.628, "timestamp": "05:49:37", "text": "工作"}, {"type": "subtitle", "time": 20980.47, "timestamp": "05:49:40", "text": "好吧，然后她可能会死。"}, {"type": "subtitle", "time": 20982.788, "timestamp": "05:49:42", "text": "你知道"}, {"type": "subtitle", "time": 20986.07, "timestamp": "05:49:46", "text": "嘿，我能听到你说话。我能听到你说话。"}, {"type": "subtitle", "time": 20987.83, "timestamp": "05:49:47", "text": "我认为移动速度会更好。"}, {"type": "subtitle", "time": 20990.948, "timestamp": "05:49:50", "text": "所以她现在可以跑得更快了。但滑行是"}, {"type": "subtitle", "time": 20994.47, "timestamp": "05:49:54", "text": "好多了。是的，滑步更好。哦"}, {"type": "subtitle", "time": 20998.31, "timestamp": "05:49:58", "text": "天哪，拿你的幻灯片来。"}]
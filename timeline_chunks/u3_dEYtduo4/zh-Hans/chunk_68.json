[{"type": "subtitle", "time": 4080.63, "timestamp": "01:08:00", "text": "呃，不，和我保持稳定关系"}, {"type": "subtitle", "time": 4082.71, "timestamp": "01:08:02", "text": "潺潺溪流。不，我觉得是吹口哨"}, {"type": "subtitle", "time": 4086.51, "timestamp": "01:08:06", "text": "直播是采用新设备的那个，我"}, {"type": "subtitle", "time": 4089.43, "timestamp": "01:08:09", "text": "猜测。是的。一切都很顺利。然后"}, {"type": "subtitle", "time": 4092.39, "timestamp": "01:08:12", "text": "然后，不知为何，我突然想：等等"}, {"type": "subtitle", "time": 4095.27, "timestamp": "01:08:15", "text": "我每天都得来电脑前工作。"}, {"type": "subtitle", "time": 4098.229, "timestamp": "01:08:18", "text": "每天早上7点，就像这样开始"}, {"type": "subtitle", "time": 4100.63, "timestamp": "01:08:20", "text": "工作或做事并为……做准备"}, {"type": "subtitle", "time": 4102.55, "timestamp": "01:08:22", "text": "事情和练习。所以我就想"}, {"type": "subtitle", "time": 4104.709, "timestamp": "01:08:24", "text": "我会在里面设置一个自动唤醒功能。"}, {"type": "subtitle", "time": 4108.709, "timestamp": "01:08:28", "text": "B 在我的电脑上。所以我照做了。"}, {"type": "subtitle", "time": 4111.59, "timestamp": "01:08:31", "text": "第二天我醒来时，它还没醒。所以"}, {"type": "subtitle", "time": 4114.709, "timestamp": "01:08:34", "text": "我必须使用陆地上的唤醒功能。你知道，"}, {"type": "subtitle", "time": 4117.269, "timestamp": "01:08:37", "text": "你可以像发送一样，用你的手机发送"}, {"type": "subtitle", "time": 4120.229, "timestamp": "01:08:40", "text": "把电脑唤醒了吧？我做了。然后"}, {"type": "subtitle", "time": 4123.669, "timestamp": "01:08:43", "text": "我想我得出去一下。然后我就去了"}, {"type": "subtitle", "time": 4126.03, "timestamp": "01:08:46", "text": "出去等等。然后我"}, {"type": "subtitle", "time": 4130.07, "timestamp": "01:08:50", "text": "注意到音乐正在播放。"}, {"type": "subtitle", "time": 4132.59, "timestamp": "01:08:52", "text": "通过扬声器播放，但显示屏是"}, {"type": "subtitle", "time": 4136.149, "timestamp": "01:08:56", "text": "不知何故关机了。它是空白的。我"}, {"type": "subtitle", "time": 4139.229, "timestamp": "01:08:59", "text": "重启电脑后，问题就解决了。"}]
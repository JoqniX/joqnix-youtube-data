[{"type": "subtitle", "time": 15723.91, "timestamp": "04:22:03", "text": "滑动。还有钻石靴子，哦，是的。"}, {"type": "subtitle", "time": 15726.389, "timestamp": "04:22:06", "text": "你给了它弹性。所以，我会用那个。和"}, {"type": "subtitle", "time": 15729.349, "timestamp": "04:22:09", "text": "那些穿着金色靴子的人"}, {"type": "subtitle", "time": 15733.63, "timestamp": "04:22:13", "text": "一，它会是呃，一是浮标。"}, {"type": "subtitle", "time": 15737.309, "timestamp": "04:22:17", "text": "东西。另一个是"}, {"type": "subtitle", "time": 15743.03, "timestamp": "04:22:23", "text": "盖尔。如果你迷路了，请告诉我。"}, {"type": "subtitle", "time": 15746.269, "timestamp": "04:22:26", "text": "那简直……我的天哪，你竟然修改了"}, {"type": "subtitle", "time": 15750.469, "timestamp": "04:22:30", "text": "一切。好的，两栖滑道着火。"}, {"type": "subtitle", "time": 15752.95, "timestamp": "04:22:32", "text": "想要。好的。回去拿剑。"}, {"type": "subtitle", "time": 15754.75, "timestamp": "04:22:34", "text": "爆炸"}, {"type": "subtitle", "time": 15756.75, "timestamp": "04:22:36", "text": "弩"}, {"type": "subtitle", "time": 15759.91, "timestamp": "04:22:39", "text": "斧头。哦，是的。就是这个东西。哦，是的。"}, {"type": "subtitle", "time": 15763.429, "timestamp": "04:22:43", "text": "呃，至于主播，我本来打算……"}, {"type": "subtitle", "time": 15766.87, "timestamp": "04:22:46", "text": "做那件事。呃，但我认为"}, {"type": "subtitle", "time": 15770.55, "timestamp": "04:22:50", "text": "这算数吧？摇晃。"}, {"type": "subtitle", "time": 15773.83, "timestamp": "04:22:53", "text": "对了，呃，呃，我会给你"}, {"type": "subtitle", "time": 15775.51, "timestamp": "04:22:55", "text": "食品。你能买到，对吧？我"}, {"type": "subtitle", "time": 15776.79, "timestamp": "04:22:56", "text": "不需要把所有食物都给你"}, {"type": "subtitle", "time": 15778.55, "timestamp": "04:22:58", "text": "物品，对吧？我只给你鱼，"}]
[{"type": "subtitle", "time": 20644.23, "timestamp": "05:44:04", "text": "滑动。我有个主意。水滑梯。它"}, {"type": "subtitle", "time": 20646.708, "timestamp": "05:44:06", "text": "可能会毁掉一切。"}, {"type": "subtitle", "time": 20649.67, "timestamp": "05:44:09", "text": "不，它不会坏。好的。是的，"}, {"type": "subtitle", "time": 20653.27, "timestamp": "05:44:13", "text": "米茨基，我会给你做一套好盔甲。"}, {"type": "subtitle", "time": 20657.11, "timestamp": "05:44:17", "text": "这样你就能时刻受到保护。"}, {"type": "subtitle", "time": 20660.948, "timestamp": "05:44:20", "text": "哦，没关系。我可以 我不会 我不做"}, {"type": "subtitle", "time": 20663.75, "timestamp": "05:44:23", "text": "你，你想做吗？你想做什么？"}, {"type": "subtitle", "time": 20667.11, "timestamp": "05:44:27", "text": "你想自己做，还是"}, {"type": "subtitle", "time": 20670.31, "timestamp": "05:44:30", "text": "我喜欢，我只是想让你们都给我看看"}, {"type": "subtitle", "time": 20672.628, "timestamp": "05:44:32", "text": "我可以在那里采矿，因为"}, {"type": "subtitle", "time": 20675.43, "timestamp": "05:44:35", "text": "我不知道该去哪里挖矿。"}, {"type": "subtitle", "time": 20680.19, "timestamp": "05:44:40", "text": "矿业。呃，但你现在需要装备。"}, {"type": "subtitle", "time": 20698.11, "timestamp": "05:44:58", "text": "呃，好的。面纱，"}]
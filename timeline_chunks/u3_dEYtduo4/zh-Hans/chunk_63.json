[{"type": "subtitle", "time": 3781.51, "timestamp": "01:03:01", "text": "生日是8号。等等，是第8名还是第7名？"}, {"type": "subtitle", "time": 3782.91, "timestamp": "01:03:02", "text": "是的，当我"}, {"type": "subtitle", "time": 3787.109, "timestamp": "01:03:07", "text": "还是那么，哦，第 8 和第 7。啊，我当时"}, {"type": "subtitle", "time": 3789.549, "timestamp": "01:03:09", "text": "忙着那些想看直播的人。"}, {"type": "subtitle", "time": 3792.87, "timestamp": "01:03:12", "text": "啊，没关系。嗨，我们来做一件快乐的事吧。"}, {"type": "subtitle", "time": 3794.27, "timestamp": "01:03:14", "text": "生日"}, {"type": "subtitle", "time": 3797.67, "timestamp": "01:03:17", "text": "歌曲。等等，生日快乐怎么会是这样的？"}, {"type": "subtitle", "time": 3799.87, "timestamp": "01:03:19", "text": "歌曲进行中？"}, {"type": "subtitle", "time": 3802.95, "timestamp": "01:03:22", "text": "呃，我知道你唱的那首日语歌。"}, {"type": "subtitle", "time": 3805.069, "timestamp": "01:03:25", "text": "孩子们。我可以这样做吗？"}, {"type": "subtitle", "time": 3831.069, "timestamp": "01:03:51", "text": "祝你生日快乐。祝你生日快乐"}, {"type": "subtitle", "time": 3833.6, "timestamp": "01:03:53", "text": "你。生日快乐"}, {"type": "subtitle", "time": 3835.63, "timestamp": "01:03:55", "text": "[音乐]"}, {"type": "subtitle", "time": 3838.76, "timestamp": "01:03:58", "text": "祝你生日快乐"}]
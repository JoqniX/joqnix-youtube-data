[{"type": "subtitle", "time": 20834.15, "timestamp": "05:47:14", "text": "这是什么？什么？什么？那是祖基的"}, {"type": "subtitle", "time": 20842.35, "timestamp": "05:47:22", "text": "送一双靴子。靴子"}, {"type": "subtitle", "time": 20846.07, "timestamp": "05:47:26", "text": "你。鹦鹉。那是什么？靴子。该死，"}, {"type": "subtitle", "time": 20849.43, "timestamp": "05:47:29", "text": "太酷了！你不会因此而死"}, {"type": "subtitle", "time": 20852.39, "timestamp": "05:47:32", "text": "从现在开始，将受到坠落伤害。而且你可以"}, {"type": "subtitle", "time": 20854.75, "timestamp": "05:47:34", "text": "按下 Ctrl 键即可超级跳跃"}, {"type": "subtitle", "time": 20857.35, "timestamp": "05:47:37", "text": "外面的空间，对吧？你可以跳进去"}, {"type": "subtitle", "time": 20860.47, "timestamp": "05:47:40", "text": "空气。等等，等等。我需要按"}, {"type": "subtitle", "time": 20863.35, "timestamp": "05:47:43", "text": "什么？"}, {"type": "subtitle", "time": 20865.91, "timestamp": "05:47:45", "text": "按下下蹲键。我认为是"}, {"type": "subtitle", "time": 20870.868, "timestamp": "05:47:50", "text": "换挡，对吧？然后按下“呃”键，然后松手。"}, {"type": "subtitle", "time": 20872.948, "timestamp": "05:47:52", "text": "换挡，对，就是这样。好了。"}, {"type": "subtitle", "time": 20875.35, "timestamp": "05:47:55", "text": "好的。"}, {"type": "subtitle", "time": 20877.11, "timestamp": "05:47:57", "text": "啊，"}, {"type": "subtitle", "time": 20879.43, "timestamp": "05:47:59", "text": "如果你……你可以跳起来再爬回去。"}]
[{"type": "subtitle", "time": 18072.43, "timestamp": "05:01:12", "text": "[音乐]"}, {"type": "subtitle", "time": 18076.07, "timestamp": "05:01:16", "text": "反弹。不。你想要武士刀吗？"}, {"type": "subtitle", "time": 18078.47, "timestamp": "05:01:18", "text": "你想要一把武士刀吗？我有一个"}, {"type": "subtitle", "time": 18085.11, "timestamp": "05:01:25", "text": "武士刀。我找到了更好的东西。"}, {"type": "subtitle", "time": 18088.59, "timestamp": "05:01:28", "text": "尽管。我的天啊。我"}, {"type": "subtitle", "time": 18092.628, "timestamp": "05:01:32", "text": "哦，我送你的那把斧子呢？好的。"}, {"type": "subtitle", "time": 18094.39, "timestamp": "05:01:34", "text": "我的天啊。你依然是我成功了。我"}, {"type": "subtitle", "time": 18095.91, "timestamp": "05:01:35", "text": "成功了。你成功了。发生了什么事？"}, {"type": "subtitle", "time": 18097.99, "timestamp": "05:01:37", "text": "我的天啊，是啊。我把锤子给你了。"}, {"type": "subtitle", "time": 18099.59, "timestamp": "05:01:39", "text": "好的。"}, {"type": "subtitle", "time": 18109.91, "timestamp": "05:01:49", "text": "那么，有斧头吗？但你真的这么做了吗？"}, {"type": "subtitle", "time": 18112.35, "timestamp": "05:01:52", "text": "注意，如果你拿着这两个东西的话。"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "使用双手武器，你会失去……"}, {"type": "subtitle", "time": 18117.35, "timestamp": "05:01:57", "text": "物品？"}, {"type": "subtitle", "time": 18119.75, "timestamp": "05:01:59", "text": "物品在哪里？就像你把它放在那里一样"}]
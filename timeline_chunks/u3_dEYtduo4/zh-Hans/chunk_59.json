[{"type": "subtitle", "time": 3542.39, "timestamp": "00:59:02", "text": "嘘我自己，有点像150个标题"}, {"type": "subtitle", "time": 3545.75, "timestamp": "00:59:05", "text": "制作。哦是的。我正在考虑这样做"}, {"type": "subtitle", "time": 3548.19, "timestamp": "00:59:08", "text": "更多照片。"}, {"type": "subtitle", "time": 3550.75, "timestamp": "00:59:10", "text": "是的。我需要找到"}, {"type": "subtitle", "time": 3555.069, "timestamp": "00:59:15", "text": "时间。我就像上课、上课，然后……"}, {"type": "subtitle", "time": 3557.91, "timestamp": "00:59:17", "text": "工作。事情真多。我曾"}, {"type": "subtitle", "time": 3561.67, "timestamp": "00:59:21", "text": "练习以及做我的其他爱好"}, {"type": "subtitle", "time": 3563.349, "timestamp": "00:59:23", "text": "东西。这样我就没时间了。"}, {"type": "subtitle", "time": 3567.87, "timestamp": "00:59:27", "text": "流媒体和其他内容。所以我就想，"}, {"type": "subtitle", "time": 3571.19, "timestamp": "00:59:31", "text": "啊。是的，我应该尝试多做一些。"}, {"type": "subtitle", "time": 3572.99, "timestamp": "00:59:32", "text": "镜头。"}, {"type": "subtitle", "time": 3576.51, "timestamp": "00:59:36", "text": "是啊，学习更无聊。"}, {"type": "subtitle", "time": 3580.91, "timestamp": "00:59:40", "text": "是的，某种程度上是这样，但你必须……"}, {"type": "subtitle", "time": 3583.99, "timestamp": "00:59:43", "text": "令人遗憾。它要回来了。嗯，我正要去"}, {"type": "subtitle", "time": 3586.39, "timestamp": "00:59:46", "text": "开始查找……呃……Facebook"}, {"type": "subtitle", "time": 3588.71, "timestamp": "00:59:48", "text": "可供购买的市场。是的，那也是一个"}, {"type": "subtitle", "time": 3591.91, "timestamp": "00:59:51", "text": "不错的选择。不，事情并非如此。"}, {"type": "subtitle", "time": 3597.75, "timestamp": "00:59:57", "text": "我的游戏电脑搭载的 Ryzen 7 3800X 处理器一直用到那时。"}]
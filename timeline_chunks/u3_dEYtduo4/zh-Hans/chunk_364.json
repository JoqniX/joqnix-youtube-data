[{"type": "subtitle", "time": 21840.23, "timestamp": "06:04:00", "text": "用它。"}, {"type": "subtitle", "time": 21842.19, "timestamp": "06:04:02", "text": "我的天啊。我"}, {"type": "subtitle", "time": 21845.75, "timestamp": "06:04:05", "text": "能。你需要告诉我该怎么做。我"}, {"type": "subtitle", "time": 21848.23, "timestamp": "06:04:08", "text": "能。好的。你能给吗？你能给吗？你能给吗？你能给吗？"}, {"type": "subtitle", "time": 21852.15, "timestamp": "06:04:12", "text": "让她担任指挥官？我忘了。"}, {"type": "subtitle", "time": 21853.868, "timestamp": "06:04:13", "text": "好的。"}, {"type": "subtitle", "time": 21858.35, "timestamp": "06:04:18", "text": "嗯，我试试输入"}, {"type": "subtitle", "time": 21861.99, "timestamp": "06:04:21", "text": "聊天。没关系。"}, {"type": "subtitle", "time": 21866.47, "timestamp": "06:04:26", "text": "我吃饭的时候，总是吃不饱。"}, {"type": "subtitle", "time": 21869.35, "timestamp": "06:04:29", "text": "生命。"}, {"type": "subtitle", "time": 21872.07, "timestamp": "06:04:32", "text": "我的房间好热，风扇。我需要"}, {"type": "subtitle", "time": 21876.23, "timestamp": "06:04:36", "text": "启动机器。啊，说真的，我是"}, {"type": "subtitle", "time": 21879.27, "timestamp": "06:04:39", "text": "不知为何，我一直把风扇关着。"}, {"type": "subtitle", "time": 21882.708, "timestamp": "06:04:42", "text": "我不知道。我喜欢我的游戏室"}, {"type": "subtitle", "time": 21886.788, "timestamp": "06:04:46", "text": "现在它很小，而且关门了，我的"}, {"type": "subtitle", "time": 21891.75, "timestamp": "06:04:51", "text": "电脑发热很严重。没错。"}]
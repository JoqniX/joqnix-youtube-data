[{"type": "subtitle", "time": 22800.868, "timestamp": "06:20:00", "text": "是谁说的？谁想做？"}, {"type": "subtitle", "time": 22808.868, "timestamp": "06:20:08", "text": "我以为我以为钢管舞是"}, {"type": "subtitle", "time": 22811.51, "timestamp": "06:20:11", "text": "就像你认识的消防员那样。"}, {"type": "subtitle", "time": 22815.11, "timestamp": "06:20:15", "text": "不，他们从高处跳下来，就像这样"}, {"type": "subtitle", "time": 22817.51, "timestamp": "06:20:17", "text": "滑动杆子，对吧？我以为是"}, {"type": "subtitle", "time": 22820.628, "timestamp": "06:20:20", "text": "就像现实生活中的肢体病理学家之类的。然后"}, {"type": "subtitle", "time": 22823.43, "timestamp": "06:20:23", "text": "这些停止。别那样做。我知道你知道"}, {"type": "subtitle", "time": 22827.59, "timestamp": "06:20:27", "text": "你是什​​么意思。工作。你是什​​么意思？"}, {"type": "subtitle", "time": 22830.31, "timestamp": "06:20:30", "text": "你在撒谎。迪奥。"}, {"type": "subtitle", "time": 22833.11, "timestamp": "06:20:33", "text": "说谎。什么？迪奥。"}, {"type": "subtitle", "time": 22834.788, "timestamp": "06:20:34", "text": "你说你不想做，这是撒谎。"}, {"type": "subtitle", "time": 22838.23, "timestamp": "06:20:38", "text": "钢管舞。 D. 你是什么意思？我"}, {"type": "subtitle", "time": 22840.31, "timestamp": "06:20:40", "text": "我知道你想跳钢管舞。我"}]
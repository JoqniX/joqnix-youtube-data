[{"type": "subtitle", "time": 16800.628, "timestamp": "04:40:00", "text": "把它放进我的背包里。那么，你如何……"}, {"type": "subtitle", "time": 16802.628, "timestamp": "04:40:02", "text": "那你用它吗？"}, {"type": "subtitle", "time": 16804.11, "timestamp": "04:40:04", "text": "我不"}, {"type": "subtitle", "time": 16810.948, "timestamp": "04:40:10", "text": "凉爽的。我先把它放进背包里。"}, {"type": "subtitle", "time": 16813.23, "timestamp": "04:40:13", "text": "我会想办法的。"}, {"type": "subtitle", "time": 16825.91, "timestamp": "04:40:25", "text": "哦，我今天还有什么其他目标吗？"}, {"type": "subtitle", "time": 16828.39, "timestamp": "04:40:28", "text": "过来，乔伊。在我离开之前，我还有……"}, {"type": "subtitle", "time": 16831.75, "timestamp": "04:40:31", "text": "还有一样东西要展示。"}, {"type": "subtitle", "time": 16834.868, "timestamp": "04:40:34", "text": "过来。我们要去一个小型"}, {"type": "subtitle", "time": 16839.03, "timestamp": "04:40:39", "text": "冒险。现在就跟我走。是的。"}, {"type": "subtitle", "time": 16841.91, "timestamp": "04:40:41", "text": "哦，等等。我不是完全的小个子。好的。"}, {"type": "subtitle", "time": 16844.39, "timestamp": "04:40:44", "text": "小的。好的。"}]
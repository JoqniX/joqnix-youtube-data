[{"type": "subtitle", "time": 21483.83, "timestamp": "05:58:03", "text": "好了。"}, {"type": "subtitle", "time": 21487.27, "timestamp": "05:58:07", "text": "这是给你的礼物。"}, {"type": "subtitle", "time": 21490.39, "timestamp": "05:58:10", "text": "我的天哪。是的，你，你现在就是你。"}, {"type": "subtitle", "time": 21492.788, "timestamp": "05:58:12", "text": "更强。"}, {"type": "subtitle", "time": 21496.19, "timestamp": "05:58:16", "text": "是的。哦，我的天，就因为我们有"}, {"type": "subtitle", "time": 21498.548, "timestamp": "05:58:18", "text": "严格来说，这不算什么。我不想"}, {"type": "subtitle", "time": 21500.708, "timestamp": "05:58:20", "text": "讲个笑话。"}, {"type": "subtitle", "time": 21502.948, "timestamp": "05:58:22", "text": "此外，还有下界和末地。"}, {"type": "subtitle", "time": 21505.99, "timestamp": "05:58:25", "text": "所有地方都关门了吗？"}, {"type": "subtitle", "time": 21508.708, "timestamp": "05:58:28", "text": "是的，下界已关闭。我好的。还，"}, {"type": "subtitle", "time": 21510.23, "timestamp": "05:58:30", "text": "有些人拥有的下界矿石"}, {"type": "subtitle", "time": 21512.07, "timestamp": "05:58:32", "text": "对吧，下界合金？该如何处理它？"}, {"type": "subtitle", "time": 21514.23, "timestamp": "05:58:34", "text": "它容易碎吗？谁有下界矿石？ WHO"}, {"type": "subtitle", "time": 21516.628, "timestamp": "05:58:36", "text": "有下界合金吗？比如，哈比比不是吗？"}, {"type": "subtitle", "time": 21518.788, "timestamp": "05:58:38", "text": "与某些人交易下界合金或其他东西"}, {"type": "subtitle", "time": 21520.708, "timestamp": "05:58:40", "text": "某物？不，不，不。他无法给予"}, {"type": "subtitle", "time": 21524.15, "timestamp": "05:58:44", "text": "对任何人来说都是下界矿石。好的。"}, {"type": "subtitle", "time": 21526.948, "timestamp": "05:58:46", "text": "他有没有给过任何人下界矿石？我"}, {"type": "subtitle", "time": 21529.83, "timestamp": "05:58:49", "text": "我不知道。我从扎基那里听说了"}, {"type": "subtitle", "time": 21531.83, "timestamp": "05:58:51", "text": "有些人得到了某种权利之类的。"}, {"type": "subtitle", "time": 21535.11, "timestamp": "05:58:55", "text": "我当时就像"}, {"type": "subtitle", "time": 21538.868, "timestamp": "05:58:58", "text": "如果你给我，我会杀了你。"}]
[{"type": "subtitle", "time": 18336.708, "timestamp": "05:05:36", "text": "准备在上面写上“请勿触摸”。"}, {"type": "subtitle", "time": 18338.788, "timestamp": "05:05:38", "text": "不，我要挪动它。我会做"}, {"type": "subtitle", "time": 18348.27, "timestamp": "05:05:48", "text": "为什么我会"}, {"type": "subtitle", "time": 18350.51, "timestamp": "05:05:50", "text": "哦，我的"}, {"type": "subtitle", "time": 18354.47, "timestamp": "05:05:54", "text": "天哪，摇篮在这里。我很高兴。这"}, {"type": "subtitle", "time": 18356.59, "timestamp": "05:05:56", "text": "让我感到开心。这"}]
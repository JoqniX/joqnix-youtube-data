[{"type": "subtitle", "time": 18241.83, "timestamp": "05:04:01", "text": "放在胸前？"}, {"type": "subtitle", "time": 18245.27, "timestamp": "05:04:05", "text": "就像我写的Venderstein一样，但我想要"}, {"type": "subtitle", "time": 18268.03, "timestamp": "05:04:28", "text": "我觉得我可能会选择两栖的。"}, {"type": "subtitle", "time": 18271.708, "timestamp": "05:04:31", "text": "我使用了两栖的。它对我有帮助"}, {"type": "subtitle", "time": 18274.628, "timestamp": "05:04:34", "text": "我的意思是，我们还没有进行过水下作业。"}, {"type": "subtitle", "time": 18276.868, "timestamp": "05:04:36", "text": "探索，对吧？你为什么不做"}, {"type": "subtitle", "time": 18278.628, "timestamp": "05:04:38", "text": "那？"}, {"type": "subtitle", "time": 18283.67, "timestamp": "05:04:43", "text": "是啊，比在水下安全多了。"}, {"type": "subtitle", "time": 18287.07, "timestamp": "05:04:47", "text": "是的。而且你还能获得更多钻石。"}, {"type": "subtitle", "time": 18290.47, "timestamp": "05:04:50", "text": "还。该死。是的，我们应该这样做。我们"}]
[{"type": "subtitle", "time": 9841.75, "timestamp": "02:44:01", "text": "帕里莎。呃，我是卡瓦卡。卡瓦卡。"}, {"type": "subtitle", "time": 9843.349, "timestamp": "02:44:03", "text": "她是一名歌手。她懂英语，"}, {"type": "subtitle", "time": 9845.51, "timestamp": "02:44:05", "text": "日本人。所以她就是那个原因。"}, {"type": "subtitle", "time": 9847.67, "timestamp": "02:44:07", "text": "为什么MTL City的歌曲有英文版？"}, {"type": "subtitle", "time": 9849.99, "timestamp": "02:44:09", "text": "版本和日文版。那是"}, {"type": "subtitle", "time": 9852.71, "timestamp": "02:44:12", "text": "就像一个尚未开发的市场，可以提供"}, {"type": "subtitle", "time": 9855.11, "timestamp": "02:44:15", "text": "英文和日文版本之类的东西。"}, {"type": "subtitle", "time": 9864.61, "timestamp": "02:44:24", "text": "最喜欢的"}, {"type": "subtitle", "time": 9866.429, "timestamp": "02:44:26", "text": "[音乐]"}, {"type": "subtitle", "time": 9869.71, "timestamp": "02:44:29", "text": "愣。一秒钟。这是"}, {"type": "subtitle", "time": 9874.05, "timestamp": "02:44:34", "text": "歌曲。我从来没卖过这个。"}, {"type": "subtitle", "time": 9886.55, "timestamp": "02:44:46", "text": "[音乐]"}]
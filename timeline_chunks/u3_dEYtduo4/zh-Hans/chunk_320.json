[{"type": "subtitle", "time": 19220.868, "timestamp": "05:20:20", "text": "真正令人震惊的局面会有好处"}, {"type": "subtitle", "time": 19222.49, "timestamp": "05:20:22", "text": "实际上，是运动。"}, {"type": "subtitle", "time": 19233.8, "timestamp": "05:20:33", "text": "一。"}, {"type": "subtitle", "time": 19235.47, "timestamp": "05:20:35", "text": "[音乐]"}, {"type": "subtitle", "time": 19238.27, "timestamp": "05:20:38", "text": "呃，但是钻石"}, {"type": "subtitle", "time": 19241.11, "timestamp": "05:20:41", "text": "镐。我真的可以要求"}, {"type": "subtitle", "time": 19243.59, "timestamp": "05:20:43", "text": "莫尔顿。你们还记得我输了吗？"}, {"type": "subtitle", "time": 19245.91, "timestamp": "05:20:45", "text": "是钻石镐，对吧？痣"}, {"type": "subtitle", "time": 19247.948, "timestamp": "05:20:47", "text": "这个东西允许"}, {"type": "subtitle", "time": 19251.59, "timestamp": "05:20:51", "text": "那。好的。斧头、伐木工、铲子。"}, {"type": "subtitle", "time": 19253.708, "timestamp": "05:20:53", "text": "我当时是什么？"}]
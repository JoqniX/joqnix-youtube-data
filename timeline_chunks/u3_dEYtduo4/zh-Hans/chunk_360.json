[{"type": "subtitle", "time": 21600.628, "timestamp": "06:00:00", "text": "他给我们寄了类似的东西。"}, {"type": "subtitle", "time": 21602.708, "timestamp": "06:00:02", "text": "我不知道为什么。"}, {"type": "subtitle", "time": 21606.39, "timestamp": "06:00:06", "text": "等等，让我看看。他给了你什么？"}, {"type": "subtitle", "time": 21610.07, "timestamp": "06:00:10", "text": "他给了我们一个我忘了它在哪儿的东西，"}, {"type": "subtitle", "time": 21612.23, "timestamp": "06:00:12", "text": "没错，它就像一颗下界星。"}, {"type": "subtitle", "time": 21613.39, "timestamp": "06:00:13", "text": "或者"}, {"type": "subtitle", "time": 21615.99, "timestamp": "06:00:15", "text": "某物。都不是，对吧？等待。呃，"}, {"type": "subtitle", "time": 21617.868, "timestamp": "06:00:17", "text": "在哪里？"}, {"type": "subtitle", "time": 21620.91, "timestamp": "06:00:20", "text": "它？灵魂之星。灵魂"}, {"type": "subtitle", "time": 21629.11, "timestamp": "06:00:29", "text": "灵魂之星是做什么的？它会指引你。"}, {"type": "subtitle", "time": 21630.99, "timestamp": "06:00:30", "text": "就像到了尽头。它会引导你"}, {"type": "subtitle", "time": 21645.83, "timestamp": "06:00:45", "text": "这是您的邮箱。不，但是，但是"}, {"type": "subtitle", "time": 21649.67, "timestamp": "06:00:49", "text": "现在我想要个运动员。"}, {"type": "subtitle", "time": 21654.27, "timestamp": "06:00:54", "text": "你可以自己动手制作。啊，手工艺。"}, {"type": "subtitle", "time": 21658.628, "timestamp": "06:00:58", "text": "好的。我喜欢 Dragonos，因为它的邮件是……"}]
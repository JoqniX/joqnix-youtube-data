[{"type": "subtitle", "time": 4691.35, "timestamp": "01:18:11", "text": "下午我今天想唱歌，伙计。我想"}, {"type": "subtitle", "time": 4694.47, "timestamp": "01:18:14", "text": "唱歌。我今天可以唱歌吗？"}, {"type": "subtitle", "time": 4696.79, "timestamp": "01:18:16", "text": "我们不知道你睡着了。啊，"}, {"type": "subtitle", "time": 4701.99, "timestamp": "01:18:21", "text": "等待。呃，等等，它跑了"}, {"type": "subtitle", "time": 4706.39, "timestamp": "01:18:26", "text": "右侧雨刮器。是的。我无法说"}, {"type": "subtitle", "time": 4714.709, "timestamp": "01:18:34", "text": "你们在合作睡觉吗？"}, {"type": "subtitle", "time": 4733.59, "timestamp": "01:18:53", "text": "[音乐]"}, {"type": "subtitle", "time": 4738.03, "timestamp": "01:18:58", "text": "他当时在玩Apex英雄。哦，Apex。座位"}]
[{"type": "subtitle", "time": 22441.59, "timestamp": "06:14:01", "text": "呃，祖基来过这里。是的，祖基来过这里。"}, {"type": "subtitle", "time": 22450.47, "timestamp": "06:14:10", "text": "我懂了。所以你做了什么？做"}, {"type": "subtitle", "time": 22454.11, "timestamp": "06:14:14", "text": "呃，她教了我如何走得更远，呃，如何去做"}, {"type": "subtitle", "time": 22457.67, "timestamp": "06:14:17", "text": "农业。我的天啊。别走。别走。"}, {"type": "subtitle", "time": 22460.27, "timestamp": "06:14:20", "text": "那里有个爬行者。哦，我的"}, {"type": "subtitle", "time": 22462.67, "timestamp": "06:14:22", "text": "上帝。我的天哪。有一个"}, {"type": "subtitle", "time": 22467.31, "timestamp": "06:14:27", "text": "爬行者。当心。它结束了"}, {"type": "subtitle", "time": 22471.948, "timestamp": "06:14:31", "text": "那里。它不见了。它不见了。哦，我不能"}, {"type": "subtitle", "time": 22484.59, "timestamp": "06:14:44", "text": "不，不，不。等待。呃，我们可以"}, {"type": "subtitle", "time": 22488.548, "timestamp": "06:14:48", "text": "农场，但你说我们不能种庄稼。"}, {"type": "subtitle", "time": 22499.19, "timestamp": "06:14:59", "text": "哦，看来我开得太快了。"}]
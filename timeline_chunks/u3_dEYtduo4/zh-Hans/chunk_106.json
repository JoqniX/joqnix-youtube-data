[{"type": "subtitle", "time": 6362.109, "timestamp": "01:46:02", "text": "嗯，我们确实有。"}, {"type": "subtitle", "time": 6366.629, "timestamp": "01:46:06", "text": "就这样，我想事情就此结束了。"}, {"type": "subtitle", "time": 6371.149, "timestamp": "01:46:11", "text": "我们可以留下这个人"}, {"type": "subtitle", "time": 6375.99, "timestamp": "01:46:15", "text": "某处。你想让我……"}, {"type": "subtitle", "time": 6377.79, "timestamp": "01:46:17", "text": "像这样"}, {"type": "subtitle", "time": 6381.709, "timestamp": "01:46:21", "text": "或许？你想读吗？"}, {"type": "subtitle", "time": 6384.149, "timestamp": "01:46:24", "text": "歌词？你想看歌词吗？"}, {"type": "subtitle", "time": 6391.149, "timestamp": "01:46:31", "text": "呃"}, {"type": "subtitle", "time": 6394.149, "timestamp": "01:46:34", "text": "歌词？不，什么也没有。好的，"}, {"type": "subtitle", "time": 6396.07, "timestamp": "01:46:36", "text": "等待。我一定要买到它。我要去"}, {"type": "subtitle", "time": 6409.709, "timestamp": "01:46:49", "text": "[音乐]"}, {"type": "subtitle", "time": 6412.59, "timestamp": "01:46:52", "text": "女孩。怎么会？哦，等等。不，"}, {"type": "subtitle", "time": 6415.149, "timestamp": "01:46:55", "text": "等待。好了，就是这样。"}, {"type": "subtitle", "time": 6417.91, "timestamp": "01:46:57", "text": "去。罗姆人在哪里？我安装了"}]
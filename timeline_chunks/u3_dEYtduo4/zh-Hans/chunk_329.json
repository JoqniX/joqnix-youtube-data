[{"type": "subtitle", "time": 19741.35, "timestamp": "05:29:01", "text": "为什么？你为什么哭了？"}, {"type": "subtitle", "time": 19744.708, "timestamp": "05:29:04", "text": "D，我失去了一切。"}, {"type": "subtitle", "time": 19746.39, "timestamp": "05:29:06", "text": "我的天啊。你把它放回去了吗？等待，"}, {"type": "subtitle", "time": 19749.67, "timestamp": "05:29:09", "text": "让我查一下。嗯，让我查一下。"}, {"type": "subtitle", "time": 19752.07, "timestamp": "05:29:12", "text": "我的东西在哪儿？"}, {"type": "subtitle", "time": 19755.67, "timestamp": "05:29:15", "text": "嘿，等等。我该如何获得这个？我该怎么做？"}, {"type": "subtitle", "time": 19760.23, "timestamp": "05:29:20", "text": "你有这把剑吗？我不知道。"}, {"type": "subtitle", "time": 19768.948, "timestamp": "05:29:28", "text": "Ara把我还给了我。"}, {"type": "subtitle", "time": 19772.11, "timestamp": "05:29:32", "text": "我的天哪，我们家有植物。"}, {"type": "subtitle", "time": 19774.75, "timestamp": "05:29:34", "text": "是的。和"}, {"type": "subtitle", "time": 19778.31, "timestamp": "05:29:38", "text": "呃，还有一件事我应该说。"}, {"type": "subtitle", "time": 19781.07, "timestamp": "05:29:41", "text": "你需要一个背包"}, {"type": "subtitle", "time": 19794.15, "timestamp": "05:29:54", "text": "我觉得它就在里面。它在哪里？"}, {"type": "subtitle", "time": 19796.59, "timestamp": "05:29:56", "text": "是的，这是你的"}, {"type": "subtitle", "time": 19799.35, "timestamp": "05:29:59", "text": "背包。装备上它。那是你的"}]
[{"type": "subtitle", "time": 2880.95, "timestamp": "00:48:00", "text": "就像欢迎来到直播间一样。"}, {"type": "subtitle", "time": 2883.27, "timestamp": "00:48:03", "text": "一切。我们以前做过一次，对吧？我们"}, {"type": "subtitle", "time": 2885.95, "timestamp": "00:48:05", "text": "我以前做过一次。让我这么做"}, {"type": "subtitle", "time": 2890.03, "timestamp": "00:48:10", "text": "再次。是的，让我再做一次。那"}, {"type": "subtitle", "time": 2892.63, "timestamp": "00:48:12", "text": "狗屎，那将足够了。"}, {"type": "subtitle", "time": 2895.829, "timestamp": "00:48:15", "text": "足够了。下课后我可以"}, {"type": "subtitle", "time": 2898.87, "timestamp": "00:48:18", "text": "洗漱一下，洗洗脸什么的。"}, {"type": "subtitle", "time": 2900.109, "timestamp": "00:48:20", "text": "然后"}, {"type": "subtitle", "time": 2938.91, "timestamp": "00:48:58", "text": "[音乐]"}]
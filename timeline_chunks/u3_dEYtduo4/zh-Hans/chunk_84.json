[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "这方面已经实现了盈利，但现在我"}, {"type": "subtitle", "time": 5044.709, "timestamp": "01:24:04", "text": "我得小心我展示的东西之类的。"}, {"type": "subtitle", "time": 5047.35, "timestamp": "01:24:07", "text": "兄弟，我没办法像那样说，“哦，是的，我会……”"}, {"type": "subtitle", "time": 5049.83, "timestamp": "01:24:09", "text": "我想做什么就做什么。我是一名"}, {"type": "subtitle", "time": 5052.79, "timestamp": "01:24:12", "text": "立即合作。我必须……我必须"}, {"type": "subtitle", "time": 5055.87, "timestamp": "01:24:15", "text": "遵守规则之类的。"}, {"type": "subtitle", "time": 5059.229, "timestamp": "01:24:19", "text": "哇。你好，Sfish。好的"}, {"type": "subtitle", "time": 5062.11, "timestamp": "01:24:22", "text": "晚上。达玛怎么样了"}, {"type": "subtitle", "time": 5064.35, "timestamp": "01:24:24", "text": "正在做？你知道，"}, {"type": "subtitle", "time": 5066.39, "timestamp": "01:24:26", "text": "昨天，哦，天哪。你搞砸了"}, {"type": "subtitle", "time": 5069.75, "timestamp": "01:24:29", "text": "昨天。你睡着了。我完成了"}, {"type": "chat", "time": 5078.294, "timestamp": "01:24:38", "author": "@swordfish_0219", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kyKEfV4DpM3RY4S4kitmAih-V8pz1JPa4McVrz_xjPFpsG=s64-c-k-c0x00ffffff-no-rj", "message": "and lost it all as well"}, {"type": "subtitle", "time": 5080.87, "timestamp": "01:24:40", "text": "没有任何。我完成了整个任务。我当时"}, {"type": "subtitle", "time": 5083.51, "timestamp": "01:24:43", "text": "想回家。我的东西丢了。"}, {"type": "subtitle", "time": 5086.189, "timestamp": "01:24:46", "text": "因为那双手"}, {"type": "subtitle", "time": 5088.79, "timestamp": "01:24:48", "text": "东西。是的，我把这一切都失去了。"}, {"type": "subtitle", "time": 5092.03, "timestamp": "01:24:52", "text": "好吧，兄弟。就像，兄弟，"}, {"type": "subtitle", "time": 5095.99, "timestamp": "01:24:55", "text": "锚、钻石、牛奶桶。"}, {"type": "subtitle", "time": 5097.709, "timestamp": "01:24:57", "text": "我的天哪，"}]
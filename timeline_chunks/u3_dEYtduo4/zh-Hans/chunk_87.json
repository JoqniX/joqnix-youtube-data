[{"type": "subtitle", "time": 5226.31, "timestamp": "01:27:06", "text": "明天的替补队员。是的。呃，明天"}, {"type": "subtitle", "time": 5229.27, "timestamp": "01:27:09", "text": "将会是会员开放日"}, {"type": "subtitle", "time": 5231.75, "timestamp": "01:27:11", "text": "溪流。我真的想做这件事"}, {"type": "subtitle", "time": 5234.47, "timestamp": "01:27:14", "text": "当我发布模型时，会员资格或"}, {"type": "subtitle", "time": 5238.79, "timestamp": "01:27:18", "text": "就像做首秀一样，但我感觉"}, {"type": "subtitle", "time": 5240.79, "timestamp": "01:27:20", "text": "呃，我不应该等太久。"}, {"type": "subtitle", "time": 5242.629, "timestamp": "01:27:22", "text": "完美时刻。我只是，我只是"}, {"type": "subtitle", "time": 5246.149, "timestamp": "01:27:26", "text": "用它来计算该金额也将"}, {"type": "subtitle", "time": 5248.47, "timestamp": "01:27:28", "text": "数到巧克力那玩意儿就行了，对吧？"}, {"type": "subtitle", "time": 5251.91, "timestamp": "01:27:31", "text": "所以我可以用它来支付四月份的款项。"}, {"type": "subtitle", "time": 5255.629, "timestamp": "01:27:35", "text": "呃呃佣金"}, {"type": "subtitle", "time": 5258.95, "timestamp": "01:27:38", "text": "东西。已经完成了。太多事情让我心动了"}, {"type": "subtitle", "time": 5260.669, "timestamp": "01:27:40", "text": "希望一切顺利"}, {"type": "subtitle", "time": 5262.669, "timestamp": "01:27:42", "text": "出色地。"}]
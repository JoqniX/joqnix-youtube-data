[{"type": "subtitle", "time": 20100.948, "timestamp": "05:35:00", "text": "有没有什么更好的mod之类的？"}, {"type": "subtitle", "time": 20103.51, "timestamp": "05:35:03", "text": "照明效果比手电筒好得多"}, {"type": "subtitle", "time": 20105.99, "timestamp": "05:35:05", "text": "或者采取某种措施来阻止暴民前来？不。"}, {"type": "subtitle", "time": 20109.35, "timestamp": "05:35:09", "text": "正确的。我不知道。嘿，你怎么样"}, {"type": "subtitle", "time": 20112.868, "timestamp": "05:35:12", "text": "坐着？你点击右键。楼梯。正确的"}, {"type": "subtitle", "time": 20115.91, "timestamp": "05:35:15", "text": "点击楼梯。是的。过来坐。你"}, {"type": "subtitle", "time": 20118.07, "timestamp": "05:35:18", "text": "等待。你看起来很可爱。等等，让我……"}, {"type": "subtitle", "time": 20121.03, "timestamp": "05:35:21", "text": "截屏。拉屎。"}, {"type": "subtitle", "time": 20123.51, "timestamp": "05:35:23", "text": "我很可爱。"}, {"type": "subtitle", "time": 20130.548, "timestamp": "05:35:30", "text": "等等，我也在楼梯上。我该怎么做？是的。"}, {"type": "subtitle", "time": 20132.788, "timestamp": "05:35:32", "text": "右键单击，右键单击，右键单击"}, {"type": "subtitle", "time": 20136.07, "timestamp": "05:35:36", "text": "楼梯右键点击，鼠标右键"}, {"type": "subtitle", "time": 20139.75, "timestamp": "05:35:39", "text": "点击。对，我忘了小丑"}, {"type": "subtitle", "time": 20143.39, "timestamp": "05:35:43", "text": "地点。我把它弄丢了。我的天哪，我也是"}, {"type": "subtitle", "time": 20146.548, "timestamp": "05:35:46", "text": "坐着。该死。你想让我带走吗？"}, {"type": "subtitle", "time": 20148.708, "timestamp": "05:35:48", "text": "截屏？"}, {"type": "subtitle", "time": 20151.47, "timestamp": "05:35:51", "text": "乔能承受得住。能"}, {"type": "subtitle", "time": 20155.27, "timestamp": "05:35:55", "text": "F2。好的，等等。"}, {"type": "subtitle", "time": 20158.27, "timestamp": "05:35:58", "text": "好可爱。看看你"}]
[{"type": "subtitle", "time": 16560.709, "timestamp": "04:36:00", "text": "回收箱就在那里。耶。你可以"}, {"type": "subtitle", "time": 16563.91, "timestamp": "04:36:03", "text": "做一个小一点的。三月在那场事故中丧生。"}, {"type": "subtitle", "time": 16566.31, "timestamp": "04:36:06", "text": "一。"}, {"type": "subtitle", "time": 16569.99, "timestamp": "04:36:09", "text": "我会做点什么。跟我来。"}, {"type": "subtitle", "time": 16573.189, "timestamp": "04:36:13", "text": "你必须下线。"}, {"type": "subtitle", "time": 16578.39, "timestamp": "04:36:18", "text": "我很快就要走了。我不是"}, {"type": "subtitle", "time": 16580.869, "timestamp": "04:36:20", "text": "打算长期停留。我当时很专注。"}, {"type": "subtitle", "time": 16583.839, "timestamp": "04:36:23", "text": "我可以拥有它。"}, {"type": "subtitle", "time": 16586.23, "timestamp": "04:36:26", "text": "[音乐]"}, {"type": "subtitle", "time": 16589.109, "timestamp": "04:36:29", "text": "我很高兴楼梯还在。我"}, {"type": "subtitle", "time": 16601.67, "timestamp": "04:36:41", "text": "上帝。这看起来像龙的翅膀。哦，"}, {"type": "subtitle", "time": 16603.59, "timestamp": "04:36:43", "text": "这朵花。这朵大花是什么意思？"}, {"type": "subtitle", "time": 16605.269, "timestamp": "04:36:45", "text": "做？"}, {"type": "subtitle", "time": 16616.15, "timestamp": "04:36:56", "text": "哦，为什么我们的篝火会……"}, {"type": "subtitle", "time": 16618.47, "timestamp": "04:36:58", "text": "中间有障碍物吗？为什么？它的作用是什么？"}]
[{"type": "subtitle", "time": 19860.11, "timestamp": "05:31:00", "text": "我得到了"}, {"type": "subtitle", "time": 19870.11, "timestamp": "05:31:10", "text": "[音乐]"}, {"type": "subtitle", "time": 19872.59, "timestamp": "05:31:12", "text": "在。"}, {"type": "subtitle", "time": 19880.43, "timestamp": "05:31:20", "text": "好的。耶。"}, {"type": "subtitle", "time": 19883.91, "timestamp": "05:31:23", "text": "哈尔拉。是的。你需要什么？"}, {"type": "subtitle", "time": 19886.99, "timestamp": "05:31:26", "text": "哦，天哪，我忘了。"}, {"type": "subtitle", "time": 19890.948, "timestamp": "05:31:30", "text": "呃，我没看到我的钻石锄头。那"}, {"type": "subtitle", "time": 19900.31, "timestamp": "05:31:40", "text": "洞。你为什么戴着钻石？等等，你"}, {"type": "subtitle", "time": 19902.47, "timestamp": "05:31:42", "text": "不要以孔洞来评判钻石？哦，等等。"}, {"type": "subtitle", "time": 19907.19, "timestamp": "05:31:47", "text": "这是“别在乎谁？”"}, {"type": "subtitle", "time": 19909.67, "timestamp": "05:31:49", "text": "等等，是谁在杀人？谁在杀人？"}, {"type": "subtitle", "time": 19912.31, "timestamp": "05:31:52", "text": "等等，谁要死了？"}, {"type": "subtitle", "time": 19914.31, "timestamp": "05:31:54", "text": "那里聚集了一群暴徒。有暴徒"}]
[{"type": "subtitle", "time": 4321.11, "timestamp": "01:12:01", "text": "屏幕。三分钟后屏幕变黑了。"}, {"type": "subtitle", "time": 4323.229, "timestamp": "01:12:03", "text": "再次。黑屏"}, {"type": "subtitle", "time": 4325.91, "timestamp": "01:12:05", "text": "再次。然后我尝试了所有方法。然后"}, {"type": "subtitle", "time": 4329.59, "timestamp": "01:12:09", "text": "打扫的时候我不小心又放进去了"}, {"type": "subtitle", "time": 4333.27, "timestamp": "01:12:13", "text": "就是那根割伤我……的手指"}, {"type": "subtitle", "time": 4336.55, "timestamp": "01:12:16", "text": "我用风扇把它切开了"}, {"type": "subtitle", "time": 4339.11, "timestamp": "01:12:19", "text": "刀片之前就切过它，把它弄断了。"}, {"type": "subtitle", "time": 4341.59, "timestamp": "01:12:21", "text": "我弄断了两片风扇叶片。相同"}, {"type": "subtitle", "time": 4346.55, "timestamp": "01:12:26", "text": "我用手指不小心吹气时啊了"}, {"type": "subtitle", "time": 4349.11, "timestamp": "01:12:29", "text": "吹风扇。好的。为了摆脱"}, {"type": "subtitle", "time": 4352.07, "timestamp": "01:12:32", "text": "灰尘，我不小心把它压下去了"}, {"type": "subtitle", "time": 4355.11, "timestamp": "01:12:35", "text": "用拇指，然后再用第三个手指"}, {"type": "chat", "time": 4357.692, "timestamp": "01:12:37", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "okie ill be back in 2mins"}, {"type": "subtitle", "time": 4358.27, "timestamp": "01:12:38", "text": "风扇叶片断裂了"}, {"type": "subtitle", "time": 4361.189, "timestamp": "01:12:41", "text": "再次。啊，你想看照片吗？"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "我想我已经在 Discord 上发过图片了。"}, {"type": "chat", "time": 4372.333, "timestamp": "01:12:52", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "done with dinner"}]
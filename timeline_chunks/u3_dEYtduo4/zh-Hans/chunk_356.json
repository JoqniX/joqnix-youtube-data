[{"type": "subtitle", "time": 21361.75, "timestamp": "05:56:01", "text": "好的，明白了。嗯？完毕。完毕。完毕。"}, {"type": "subtitle", "time": 21363.868, "timestamp": "05:56:03", "text": "完毕。和"}, {"type": "subtitle", "time": 21372.948, "timestamp": "05:56:12", "text": "现在我可以了。好的。对不起。是的。但是它"}, {"type": "subtitle", "time": 21375.75, "timestamp": "05:56:15", "text": "只朝一个方向走。所以你有"}, {"type": "subtitle", "time": 21377.39, "timestamp": "05:56:17", "text": "采取"}, {"type": "subtitle", "time": 21388.47, "timestamp": "05:56:28", "text": "所以别迷路了。好的。是的。你是"}, {"type": "subtitle", "time": 21391.51, "timestamp": "05:56:31", "text": "快速地。你现在速度与激情四射。"}, {"type": "subtitle", "time": 21397.59, "timestamp": "05:56:37", "text": "上帝。但这真的太棒了。什么？我们开始吧"}, {"type": "subtitle", "time": 21406.31, "timestamp": "05:56:46", "text": "等等，你用什么来猛击？"}, {"type": "subtitle", "time": 21409.788, "timestamp": "05:56:49", "text": "你能控制什么？"}, {"type": "subtitle", "time": 21413.59, "timestamp": "05:56:53", "text": "好的。还有，呃，什么对……有好处？"}, {"type": "subtitle", "time": 21416.788, "timestamp": "05:56:56", "text": "胸平面？呃，典狱长精灵。有"}]
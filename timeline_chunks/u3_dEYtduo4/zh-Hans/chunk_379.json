[{"type": "subtitle", "time": 22740.07, "timestamp": "06:19:00", "text": "天哪，这背包也太好了吧。"}, {"type": "subtitle", "time": 22751.11, "timestamp": "06:19:11", "text": "如何使用软管？你可以吸东西。"}, {"type": "subtitle", "time": 22753.15, "timestamp": "06:19:13", "text": "哦，我的"}, {"type": "subtitle", "time": 22756.47, "timestamp": "06:19:16", "text": "上帝。按右键上传油箱"}, {"type": "subtitle", "time": 22759.35, "timestamp": "06:19:19", "text": "老鼠。好的。公交车指的是软管。我太"}, {"type": "subtitle", "time": 22762.548, "timestamp": "06:19:22", "text": "对不起，乔。我把你的钢管舞场地弄坏了。"}, {"type": "subtitle", "time": 22772.23, "timestamp": "06:19:32", "text": "感谢上帝。感谢上帝。再做一遍。不，"}, {"type": "subtitle", "time": 22774.868, "timestamp": "06:19:34", "text": "不要再做了。是的。让我来做"}, {"type": "subtitle", "time": 22778.23, "timestamp": "06:19:38", "text": "又来了。不。"}, {"type": "subtitle", "time": 22780.39, "timestamp": "06:19:40", "text": "没有。没有。没有。开玩笑。开玩笑。笑话想要"}, {"type": "subtitle", "time": 22782.948, "timestamp": "06:19:42", "text": "你拿着。我不知道他是什么样的人。"}, {"type": "subtitle", "time": 22785.99, "timestamp": "06:19:45", "text": "谈论。如何使用时钟。如何"}, {"type": "subtitle", "time": 22788.628, "timestamp": "06:19:48", "text": "使用时钟。你知道吗？只需放置"}, {"type": "subtitle", "time": 22795.59, "timestamp": "06:19:55", "text": "说真的，你"}, {"type": "subtitle", "time": 22798.31, "timestamp": "06:19:58", "text": "我不知道。我当时就想，我不知道。"}]
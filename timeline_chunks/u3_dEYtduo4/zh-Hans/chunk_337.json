[{"type": "subtitle", "time": 20222.07, "timestamp": "05:37:02", "text": "哦，镶着钻石。我们需要钻石"}, {"type": "subtitle", "time": 20229.75, "timestamp": "05:37:09", "text": "[音乐]"}, {"type": "subtitle", "time": 20232.47, "timestamp": "05:37:12", "text": "我该如何起床？看，控制。哦，"}, {"type": "subtitle", "time": 20239.27, "timestamp": "05:37:19", "text": "控制。是的，我只放了控制选项。"}, {"type": "subtitle", "time": 20243.35, "timestamp": "05:37:23", "text": "它不起作用。或许是C档。"}, {"type": "subtitle", "time": 20245.07, "timestamp": "05:37:25", "text": "控制左键"}, {"type": "subtitle", "time": 20248.948, "timestamp": "05:37:28", "text": "转移。啊，你做到了。我们走吧。蹲伏。"}, {"type": "subtitle", "time": 20253.75, "timestamp": "05:37:33", "text": "我的天哪。好的。那真不错。我可以"}, {"type": "subtitle", "time": 20256.03, "timestamp": "05:37:36", "text": "好好休息。"}, {"type": "subtitle", "time": 20259.51, "timestamp": "05:37:39", "text": "该死。哦，为什么这里有两张床？"}, {"type": "subtitle", "time": 20264.39, "timestamp": "05:37:44", "text": "那件事是什么时候发生的？我放了一个。"}, {"type": "subtitle", "time": 20266.59, "timestamp": "05:37:46", "text": "我的天啊。我有"}, {"type": "subtitle", "time": 20269.75, "timestamp": "05:37:49", "text": "没有什么。好的。"}, {"type": "subtitle", "time": 20273.43, "timestamp": "05:37:53", "text": "是的。我希望你至少有点脑子。"}, {"type": "subtitle", "time": 20276.43, "timestamp": "05:37:56", "text": "对不起。所以"}]
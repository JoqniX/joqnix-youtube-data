[{"type": "subtitle", "time": 22572.23, "timestamp": "06:16:12", "text": "等等，让我告诉你……哦，不。什么？"}, {"type": "subtitle", "time": 22576.39, "timestamp": "06:16:16", "text": "在哪里？它去哪儿了？嗯？你留着它"}, {"type": "subtitle", "time": 22579.35, "timestamp": "06:16:19", "text": "在她的包里。"}, {"type": "subtitle", "time": 22582.868, "timestamp": "06:16:22", "text": "她来了。她 她 我的天哪，你真"}, {"type": "subtitle", "time": 22586.07, "timestamp": "06:16:26", "text": "真可爱，兄弟。"}, {"type": "subtitle", "time": 22594.39, "timestamp": "06:16:34", "text": "这里有很多背包。龙"}, {"type": "subtitle", "time": 22598.23, "timestamp": "06:16:38", "text": "背包。爬行者。南瓜。瓜。猫的"}, {"type": "subtitle", "time": 22600.83, "timestamp": "06:16:40", "text": "蛋糕背包。哦，我的"}, {"type": "subtitle", "time": 22603.83, "timestamp": "06:16:43", "text": "上帝。末影人。这是什么背包？"}, {"type": "subtitle", "time": 22607.59, "timestamp": "06:16:47", "text": "节日？糟糕的包装。"}, {"type": "subtitle", "time": 22611.19, "timestamp": "06:16:51", "text": "什么？你在干什么？糟糕的背包。"}, {"type": "subtitle", "time": 22614.99, "timestamp": "06:16:54", "text": "蜘蛛背包。你为什么？你为什么？"}, {"type": "subtitle", "time": 22617.99, "timestamp": "06:16:57", "text": "飞行？你飞行情况如何？不飞。"}]
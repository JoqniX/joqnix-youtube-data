[{"type": "subtitle", "time": 21960.788, "timestamp": "06:06:00", "text": "你看到什么东西了吗？"}, {"type": "subtitle", "time": 21962.788, "timestamp": "06:06:02", "text": "是的。是的，我可以。是的，我明白了。那里"}, {"type": "subtitle", "time": 21965.27, "timestamp": "06:06:05", "text": "你去。现在，我有个问题。如何"}, {"type": "subtitle", "time": 21974.07, "timestamp": "06:06:14", "text": "呃，我不知道。你告诉我我说过"}, {"type": "subtitle", "time": 21977.35, "timestamp": "06:06:17", "text": "你，兄弟。她用不着它了。什么"}, {"type": "subtitle", "time": 21980.548, "timestamp": "06:06:20", "text": "我该如何处理这个号码？"}, {"type": "subtitle", "time": 21983.75, "timestamp": "06:06:23", "text": "呃，你基本上把它记下来了"}, {"type": "subtitle", "time": 21985.35, "timestamp": "06:06:25", "text": "这些是坐标"}, {"type": "subtitle", "time": 21988.07, "timestamp": "06:06:28", "text": "地点。所以，假设现在这些"}, {"type": "subtitle", "time": 21991.868, "timestamp": "06:06:31", "text": "数字代表位置，例如"}, {"type": "subtitle", "time": 21994.91, "timestamp": "06:06:34", "text": "谷歌搜索或者你得到"}, {"type": "subtitle", "time": 21996.868, "timestamp": "06:06:36", "text": "这些数字的位置是"}, {"type": "subtitle", "time": 21998.948, "timestamp": "06:06:38", "text": "对应的坐标。假设你"}, {"type": "subtitle", "time": 22001.91, "timestamp": "06:06:41", "text": "你保存了这个特定的号码，然后你"}, {"type": "subtitle", "time": 22004.868, "timestamp": "06:06:44", "text": "出门后迷路了。所以你可以"}, {"type": "subtitle", "time": 22007.11, "timestamp": "06:06:47", "text": "你知道，就是那种颜色搭配之类的东西。"}, {"type": "subtitle", "time": 22008.91, "timestamp": "06:06:48", "text": "当你移动数字时"}, {"type": "subtitle", "time": 22013.03, "timestamp": "06:06:53", "text": "改变。这样你就可以追踪你的行踪了。"}, {"type": "subtitle", "time": 22014.868, "timestamp": "06:06:54", "text": "如果能找到办法把它带回家的话"}, {"type": "subtitle", "time": 22017.83, "timestamp": "06:06:57", "text": "你们有这些数据。所以我需要我"}]
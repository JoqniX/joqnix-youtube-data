[{"type": "subtitle", "time": 16502.23, "timestamp": "04:35:02", "text": "让植物生长得更快，然后等待"}, {"type": "subtitle", "time": 16509.51, "timestamp": "04:35:09", "text": "我们现在土豆不够用。"}, {"type": "subtitle", "time": 16514.67, "timestamp": "04:35:14", "text": "我有一大堆土豆"}, {"type": "subtitle", "time": 16525.349, "timestamp": "04:35:25", "text": "我忘了问他为什么懒惰。"}, {"type": "subtitle", "time": 16529.109, "timestamp": "04:35:29", "text": "妖娆。我们没有，我有青金石"}, {"type": "subtitle", "time": 16533.15, "timestamp": "04:35:33", "text": "已经是青金石了。哦，是他送的。"}, {"type": "subtitle", "time": 16544.23, "timestamp": "04:35:44", "text": "伙计，那我得建个基地了。"}, {"type": "subtitle", "time": 16550.949, "timestamp": "04:35:50", "text": "你可以用我的。我不介意。"}, {"type": "subtitle", "time": 16553.99, "timestamp": "04:35:53", "text": "嘿，乔拉。"}, {"type": "subtitle", "time": 16557.269, "timestamp": "04:35:57", "text": "我很高兴熔岩又回来了。我们的废物"}]
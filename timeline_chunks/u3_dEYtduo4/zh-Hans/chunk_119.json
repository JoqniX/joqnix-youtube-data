[{"type": "subtitle", "time": 7142.43, "timestamp": "01:59:02", "text": "向上。哦好的。好的。那是"}, {"type": "subtitle", "time": 7145.17, "timestamp": "01:59:05", "text": "好的。我搞砸了。"}, {"type": "subtitle", "time": 7156.07, "timestamp": "01:59:16", "text": "我已经很久没有练习了。"}, {"type": "subtitle", "time": 7160.95, "timestamp": "01:59:20", "text": "不，不，我不想唱歌"}, {"type": "subtitle", "time": 7163.229, "timestamp": "01:59:23", "text": "这。它是"}, {"type": "subtitle", "time": 7171.669, "timestamp": "01:59:31", "text": "Koshi觉得歌曲真的很难写。"}, {"type": "subtitle", "time": 7173.43, "timestamp": "01:59:33", "text": "我不知道她是怎么唱自己的歌的。"}, {"type": "subtitle", "time": 7176.07, "timestamp": "01:59:36", "text": "歌曲。太酷了。"}, {"type": "subtitle", "time": 7178.59, "timestamp": "01:59:38", "text": "好的，我们试试看。"}, {"type": "subtitle", "time": 7182.43, "timestamp": "01:59:42", "text": "[音乐]"}, {"type": "subtitle", "time": 7185.31, "timestamp": "01:59:45", "text": "这。你知道吗？我会做"}, {"type": "subtitle", "time": 7188.55, "timestamp": "01:59:48", "text": "没听过这首歌。好的，让我"}, {"type": "subtitle", "time": 7191.99, "timestamp": "01:59:51", "text": "阅读歌词。我会，我会读"}, {"type": "subtitle", "time": 7198.27, "timestamp": "01:59:58", "text": "日本人。"}]
[{"type": "subtitle", "time": 3961.829, "timestamp": "01:06:01", "text": "密集，甚至在那条溪流中，呃"}, {"type": "subtitle", "time": 3963.23, "timestamp": "01:06:03", "text": "这"}, {"type": "subtitle", "time": 3968.39, "timestamp": "01:06:08", "text": "PC就像死了一样，它关机了六次。"}, {"type": "subtitle", "time": 3971.15, "timestamp": "01:06:11", "text": "在那一单曲中出现了七次"}, {"type": "subtitle", "time": 3975.029, "timestamp": "01:06:15", "text": "溪流。我当时，我当时，不知怎么的"}, {"type": "subtitle", "time": 3977.67, "timestamp": "01:06:17", "text": "挣扎了好久，直到我感觉“是啊，"}, {"type": "subtitle", "time": 3980.91, "timestamp": "01:06:20", "text": "我受够了。我们可以结束了。”然后猜猜看。"}, {"type": "subtitle", "time": 3984.069, "timestamp": "01:06:24", "text": "什么？几天后，它就消失了。它是"}, {"type": "subtitle", "time": 3985.39, "timestamp": "01:06:25", "text": "超过。"}, {"type": "subtitle", "time": 3989.349, "timestamp": "01:06:29", "text": "嗯，是执法记录仪。 6个月前，这款CPU"}, {"type": "subtitle", "time": 3993.349, "timestamp": "01:06:33", "text": "死了。自从我没碰过我的游戏之后，就一直没碰过我的游戏。"}, {"type": "subtitle", "time": 3998.069, "timestamp": "01:06:38", "text": "电脑配件，比如主板之类的所有东西。"}, {"type": "subtitle", "time": 4000.789, "timestamp": "01:06:40", "text": "我把它放在外面某个地方了。"}, {"type": "subtitle", "time": 4003.549, "timestamp": "01:06:43", "text": "存放起来，没动过。然后我"}, {"type": "subtitle", "time": 4006.789, "timestamp": "01:06:46", "text": "就像我还有我的游戏直播电脑一样。我"}, {"type": "subtitle", "time": 4008.71, "timestamp": "01:06:48", "text": "曾用它来替代……"}, {"type": "subtitle", "time": 4011.109, "timestamp": "01:06:51", "text": "一切。呃，然后就是我的新房间和"}, {"type": "subtitle", "time": 4013.549, "timestamp": "01:06:53", "text": "东西都建好了，"}, {"type": "subtitle", "time": 4015.47, "timestamp": "01:06:55", "text": "一切"}, {"type": "subtitle", "time": 4018.029, "timestamp": "01:06:58", "text": "是啊，我当时就想"}]
[{"type": "subtitle", "time": 4860.75, "timestamp": "01:21:00", "text": "夜晚我过去常常"}, {"type": "subtitle", "time": 4863.59, "timestamp": "01:21:03", "text": "唱歌。每天当你上直播的时候"}, {"type": "subtitle", "time": 4865.27, "timestamp": "01:21:05", "text": "YouTube，没人会看的。患病的"}, {"type": "subtitle", "time": 4867.83, "timestamp": "01:21:07", "text": "只是随意地嘟囔着，而不是"}, {"type": "subtitle", "time": 4870.229, "timestamp": "01:21:10", "text": "喃喃自语，自言自语，唱歌"}, {"type": "subtitle", "time": 4872.43, "timestamp": "01:21:12", "text": "和"}, {"type": "subtitle", "time": 4874.63, "timestamp": "01:21:14", "text": "练习。我以前就是这么做的。"}, {"type": "subtitle", "time": 4891.31, "timestamp": "01:21:31", "text": "呃，好的。我会尽力。一直以来"}, {"type": "subtitle", "time": 4894.47, "timestamp": "01:21:34", "text": "尽管。当然，我不能……呃……"}, {"type": "subtitle", "time": 4897.47, "timestamp": "01:21:37", "text": "音乐。不会有音乐。"}, {"type": "subtitle", "time": 4900.39, "timestamp": "01:21:40", "text": "那里。是的。现场不会有音乐。所以，"}, {"type": "subtitle", "time": 4903.68, "timestamp": "01:21:43", "text": "这是一件事。"}]
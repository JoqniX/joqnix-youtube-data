[{"type": "subtitle", "time": 15968.03, "timestamp": "04:26:08", "text": "现在我觉得我走对了路。"}, {"type": "subtitle", "time": 15972.189, "timestamp": "04:26:12", "text": "方向。我的铲子能做什么？"}, {"type": "subtitle", "time": 15976.309, "timestamp": "04:26:16", "text": "埋葬。对怪物使用。使用于"}, {"type": "subtitle", "time": 15979.349, "timestamp": "04:26:19", "text": "如果地面松软，暴民就会掩埋。"}, {"type": "subtitle", "time": 15981.55, "timestamp": "04:26:21", "text": "足够的。那是什么意思？"}, {"type": "subtitle", "time": 15984.389, "timestamp": "04:26:24", "text": "意思是？造成额外伤害并获得更多蓝色"}, {"type": "subtitle", "time": 15985.469, "timestamp": "04:26:25", "text": "滴。"}, {"type": "subtitle", "time": 15989.67, "timestamp": "04:26:29", "text": "什么工作？呃，你好。"}, {"type": "subtitle", "time": 15991.75, "timestamp": "04:26:31", "text": "我会教你如何真正地耕作"}, {"type": "subtitle", "time": 15995.269, "timestamp": "04:26:35", "text": "适当地。你创建的农场是V博士的农场。"}, {"type": "subtitle", "time": 15998.469, "timestamp": "04:26:38", "text": "V博士：什么？"}, {"type": "subtitle", "time": 16002.07, "timestamp": "04:26:42", "text": "什么？你说的是V博士。我当时就想，嘿，"}, {"type": "subtitle", "time": 16005.03, "timestamp": "04:26:45", "text": "V博士是做什么的？我听医生说我没有"}, {"type": "subtitle", "time": 16007.51, "timestamp": "04:26:47", "text": "你知道如何耕作，但你不知道如何耕作。"}, {"type": "subtitle", "time": 16011.269, "timestamp": "04:26:51", "text": "适当地。我不知道。我是一名农民。"}, {"type": "subtitle", "time": 16014.07, "timestamp": "04:26:54", "text": "所以，你可以点击这里，然后你"}, {"type": "subtitle", "time": 16017.349, "timestamp": "04:26:57", "text": "可以给自己发送东西。哦，"}]
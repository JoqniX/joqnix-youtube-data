[{"type": "subtitle", "time": 4141.99, "timestamp": "01:09:01", "text": "后退。但过了一段时间后，它确实会"}, {"type": "subtitle", "time": 4143.99, "timestamp": "01:09:03", "text": "同样的事情又发生了。你知道吗？那"}, {"type": "subtitle", "time": 4146.789, "timestamp": "01:09:06", "text": "这让我想起了那件事。"}, {"type": "subtitle", "time": 4151.349, "timestamp": "01:09:11", "text": "CPU chan 呃，之后的时间"}, {"type": "subtitle", "time": 4155.669, "timestamp": "01:09:15", "text": "当天直播执法记录仪视频"}, {"type": "subtitle", "time": 4158.309, "timestamp": "01:09:18", "text": "是六月还是五月六月？等等，什么时候的事？"}, {"type": "subtitle", "time": 4160.789, "timestamp": "01:09:20", "text": "我什么时候做的"}, {"type": "subtitle", "time": 4162.51, "timestamp": "01:09:22", "text": "呃，身体"}, {"type": "subtitle", "time": 4166.87, "timestamp": "01:09:26", "text": "又开始直播了？ 6月20日。对，就是那个。"}, {"type": "subtitle", "time": 4170.47, "timestamp": "01:09:30", "text": "每天都一样。我离开"}, {"type": "subtitle", "time": 4173.03, "timestamp": "01:09:33", "text": "个人电脑。要么关掉，要么不关。"}, {"type": "subtitle", "time": 4175.99, "timestamp": "01:09:35", "text": "屏幕显示正常或黑屏。我当时就想：哦"}, {"type": "subtitle", "time": 4184.269, "timestamp": "01:09:44", "text": "啊，所以你知道我做了什么。"}, {"type": "subtitle", "time": 4187.43, "timestamp": "01:09:47", "text": "我像往常一样尝试查找资料"}, {"type": "subtitle", "time": 4190.55, "timestamp": "01:09:50", "text": "教程讲解该怎么做，然后我和GPD聊天"}, {"type": "subtitle", "time": 4194.229, "timestamp": "01:09:54", "text": "然后，我重置了SEO。"}, {"type": "subtitle", "time": 4197.189, "timestamp": "01:09:57", "text": "主板所有部件都重置了，内存也重置了。"}, {"type": "subtitle", "time": 4199.669, "timestamp": "01:09:59", "text": "一切都真相大白了，我意识到罪魁祸首是谁。"}]
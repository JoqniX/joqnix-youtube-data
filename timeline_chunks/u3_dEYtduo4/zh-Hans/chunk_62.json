[{"type": "subtitle", "time": 3722.03, "timestamp": "01:02:02", "text": "生日是什么时候？祝你生日快乐"}, {"type": "subtitle", "time": 3725.51, "timestamp": "01:02:05", "text": "歌曲。我还能为你唱歌吗？"}, {"type": "subtitle", "time": 3728.15, "timestamp": "01:02:08", "text": "生日快乐歌？"}, {"type": "subtitle", "time": 3731.349, "timestamp": "01:02:11", "text": "粉色的。我们可以把今天当作你的生日吗？"}, {"type": "subtitle", "time": 3734.19, "timestamp": "01:02:14", "text": "今天？我很抱歉。我没有"}, {"type": "subtitle", "time": 3738.829, "timestamp": "01:02:18", "text": "知道。等等，你跟我说过你的事吗？"}, {"type": "subtitle", "time": 3741.789, "timestamp": "01:02:21", "text": "生日？"}, {"type": "subtitle", "time": 3744.789, "timestamp": "01:02:24", "text": "什么？如果你像我一样，我也会喜欢"}, {"type": "subtitle", "time": 3748.789, "timestamp": "01:02:28", "text": "把它放到 Discord 服务器上，就像这样"}, {"type": "subtitle", "time": 3751.27, "timestamp": "01:02:31", "text": "那个Discord服务器版块"}, {"type": "subtitle", "time": 3753.71, "timestamp": "01:02:33", "text": "这让我想起了大家的"}, {"type": "subtitle", "time": 3757.349, "timestamp": "01:02:37", "text": "生日，因为呃，要么我不知道，要么我"}, {"type": "subtitle", "time": 3760.15, "timestamp": "01:02:40", "text": "别把它记在日历里，我会忘记的。"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "当然，我会为你唱生日快乐歌。"}, {"type": "subtitle", "time": 3765.789, "timestamp": "01:02:45", "text": "如果你不喜欢这首歌，那也没关系。"}, {"type": "subtitle", "time": 3770.87, "timestamp": "01:02:50", "text": "好的，Alexa，请稍等片刻许愿"}, {"type": "subtitle", "time": 3772.549, "timestamp": "01:02:52", "text": "好儿子"}, {"type": "subtitle", "time": 3774.71, "timestamp": "01:02:54", "text": "嗯，那儿子的生日还有两天。"}, {"type": "subtitle", "time": 3777.109, "timestamp": "01:02:57", "text": "前。那可能意味着他的"}]
[{"type": "subtitle", "time": 5521.31, "timestamp": "01:32:01", "text": "每个拇指。我们有V"}, {"type": "subtitle", "time": 5523.91, "timestamp": "01:32:03", "text": "视频片段。你有你的直播流。三月"}, {"type": "subtitle", "time": 5526.79, "timestamp": "01:32:06", "text": "有她的直播内容。我们有V字形脚"}, {"type": "subtitle", "time": 5528.95, "timestamp": "01:32:08", "text": "视频片段。我们拿回了所有东西"}, {"type": "subtitle", "time": 5532.31, "timestamp": "01:32:12", "text": "迷路了。别太担心，迪奥。耻辱"}, {"type": "subtitle", "time": 5534.99, "timestamp": "01:32:14", "text": "与我一起。昨天我过得很好"}, {"type": "subtitle", "time": 5537.51, "timestamp": "01:32:17", "text": "原因。所以我可以要求他们回来"}, {"type": "subtitle", "time": 5545.91, "timestamp": "01:32:25", "text": "迪奥，我不会错过任何一首歌"}, {"type": "subtitle", "time": 5549.11, "timestamp": "01:32:29", "text": "物品。兄弟，就像迪奥本人一样。为什么是我"}, {"type": "subtitle", "time": 5552.55, "timestamp": "01:32:32", "text": "说Dio说得太多了吗？"}, {"type": "subtitle", "time": 5554.79, "timestamp": "01:32:34", "text": "我要把所有Nook都买下来。"}, {"type": "subtitle", "time": 5556.709, "timestamp": "01:32:36", "text": "我的库存角落和一些东西"}, {"type": "subtitle", "time": 5558.99, "timestamp": "01:32:38", "text": "我有，而我没有。"}, {"type": "subtitle", "time": 5562.709, "timestamp": "01:32:42", "text": "我有这部分，但是，是的，我的一切都在这里"}, {"type": "subtitle", "time": 5564.189, "timestamp": "01:32:44", "text": "胸部"}, {"type": "subtitle", "time": 5566.39, "timestamp": "01:32:46", "text": "我们必须交叉的所有东西"}, {"type": "subtitle", "time": 5568.41, "timestamp": "01:32:48", "text": "今天查看手表"}]
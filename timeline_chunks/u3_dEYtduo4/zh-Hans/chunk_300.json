[{"type": "subtitle", "time": 18002.948, "timestamp": "05:00:02", "text": "学习。我心情不好。此外，锅是"}, {"type": "subtitle", "time": 18004.47, "timestamp": "05:00:04", "text": "这里。我想去哪里？你想去哪里？"}, {"type": "subtitle", "time": 18009.67, "timestamp": "05:00:09", "text": "这里。港口。我安装了端口。我们开始吧"}, {"type": "subtitle", "time": 18012.07, "timestamp": "05:00:12", "text": "放在这里。"}, {"type": "subtitle", "time": 18013.51, "timestamp": "05:00:13", "text": "[音乐]"}, {"type": "subtitle", "time": 18016.47, "timestamp": "05:00:16", "text": "咱们继续保持。好的，我先开始。"}, {"type": "subtitle", "time": 18024.788, "timestamp": "05:00:24", "text": "哦，好困啊。"}, {"type": "subtitle", "time": 18025.868, "timestamp": "05:00:25", "text": "但"}, {"type": "subtitle", "time": 18031.27, "timestamp": "05:00:31", "text": "如果美月要加入，我希望"}, {"type": "subtitle", "time": 18034.23, "timestamp": "05:00:34", "text": "我的天哪，我好害怕。我的天啊，"}, {"type": "subtitle", "time": 18038.15, "timestamp": "05:00:38", "text": "你拥有所有这些好东西，现在在"}, {"type": "subtitle", "time": 18041.31, "timestamp": "05:00:41", "text": "开放。不，我只是要去工作。"}, {"type": "subtitle", "time": 18044.19, "timestamp": "05:00:44", "text": "它。好的，等等。火"}, {"type": "subtitle", "time": 18047.43, "timestamp": "05:00:47", "text": "方面。两栖伐木工。等等，我"}, {"type": "subtitle", "time": 18049.39, "timestamp": "05:00:49", "text": "实际上我全都有。"}]
[{"type": "subtitle", "time": 21420.07, "timestamp": "05:57:00", "text": "你用过吗？我胸口有扫射"}, {"type": "subtitle", "time": 21423.948, "timestamp": "05:57:03", "text": "地方。所以它给我的感觉就是这样"}, {"type": "subtitle", "time": 21426.788, "timestamp": "05:57:06", "text": "扫射。但只是一点点"}, {"type": "subtitle", "time": 21430.31, "timestamp": "05:57:10", "text": "少量。不，这不好。不值得，我"}, {"type": "subtitle", "time": 21434.23, "timestamp": "05:57:14", "text": "猜测。嗯，我稍后会修改。但"}, {"type": "subtitle", "time": 21445.99, "timestamp": "05:57:25", "text": "febuki。你怎么认为？我很女性化"}, {"type": "subtitle", "time": 21448.47, "timestamp": "05:57:28", "text": "现在好多了。我们可能会去我的水下"}, {"type": "subtitle", "time": 21451.03, "timestamp": "05:57:31", "text": "即将展开探索。"}, {"type": "subtitle", "time": 21455.07, "timestamp": "05:57:35", "text": "但是，呃，别给她一个"}, {"type": "subtitle", "time": 21459.59, "timestamp": "05:57:39", "text": "我们现在不行，因为首先她会"}, {"type": "subtitle", "time": 21466.868, "timestamp": "05:57:46", "text": "她是新手。"}, {"type": "subtitle", "time": 21469.99, "timestamp": "05:57:49", "text": "我的天啊。什么？所以是两栖动物。我应该吗？"}, {"type": "subtitle", "time": 21471.91, "timestamp": "05:57:51", "text": "不给？把盔甲给我。那是"}]
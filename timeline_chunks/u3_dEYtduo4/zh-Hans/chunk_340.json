[{"type": "subtitle", "time": 20400.07, "timestamp": "05:40:00", "text": "尽管。没关系。"}, {"type": "subtitle", "time": 20405.11, "timestamp": "05:40:05", "text": "我知道你一无所有。"}, {"type": "subtitle", "time": 20406.35, "timestamp": "05:40:06", "text": "再见。你吃了"}, {"type": "subtitle", "time": 20411.67, "timestamp": "05:40:11", "text": "我。我说错什么了吗？你做得不好。"}, {"type": "subtitle", "time": 20413.75, "timestamp": "05:40:13", "text": "我说你一无所有。是什么"}, {"type": "subtitle", "time": 20418.948, "timestamp": "05:40:18", "text": "这样有错吗？为什么你不能这么说？"}, {"type": "subtitle", "time": 20421.27, "timestamp": "05:40:21", "text": "但你刚才确实这么说了。"}, {"type": "subtitle", "time": 20422.67, "timestamp": "05:40:22", "text": "我"}, {"type": "subtitle", "time": 20427.19, "timestamp": "05:40:27", "text": "如果我的另一只眼睛里有一颗钻石就好了"}, {"type": "subtitle", "time": 20429.51, "timestamp": "05:40:29", "text": "地下室。"}, {"type": "subtitle", "time": 20432.23, "timestamp": "05:40:32", "text": "但那件事不发生在你身上，对吧？查看"}, {"type": "subtitle", "time": 20436.59, "timestamp": "05:40:36", "text": "它。不，它不在我这里。"}, {"type": "subtitle", "time": 20439.59, "timestamp": "05:40:39", "text": "好了，我们走吧。如何做到这一点？"}, {"type": "subtitle", "time": 20443.03, "timestamp": "05:40:43", "text": "你的紧身衣怎么了？"}, {"type": "subtitle", "time": 20445.47, "timestamp": "05:40:45", "text": "那是我的盔甲。我删除了我的"}, {"type": "subtitle", "time": 20448.47, "timestamp": "05:40:48", "text": "盔甲。这是我正常的皮肤状态。"}, {"type": "subtitle", "time": 20451.31, "timestamp": "05:40:51", "text": "这是我的盔甲。"}, {"type": "subtitle", "time": 20456.548, "timestamp": "05:40:56", "text": "哇。好的。钢铁侠。就像钢铁侠一样。"}, {"type": "subtitle", "time": 20459.67, "timestamp": "05:40:59", "text": "它是一款精致的背包吗？"}]
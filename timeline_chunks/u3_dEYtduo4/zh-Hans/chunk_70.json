[{"type": "subtitle", "time": 4201.07, "timestamp": "01:10:01", "text": "是"}, {"type": "subtitle", "time": 4206.229, "timestamp": "01:10:06", "text": "GPU，而且我已经移除了"}, {"type": "subtitle", "time": 4210.47, "timestamp": "01:10:10", "text": "直播电脑的GPU是1660 Super。我"}, {"type": "subtitle", "time": 4212.79, "timestamp": "01:10:12", "text": "当时他说道：“好的，我会用它测试一下……”"}, {"type": "subtitle", "time": 4216.149, "timestamp": "01:10:16", "text": "又是1660 Super。如果它对 30 有效"}, {"type": "subtitle", "time": 4219.59, "timestamp": "01:10:19", "text": "几分钟之内，就意味着2060年即将结束。"}, {"type": "subtitle", "time": 4222.95, "timestamp": "01:10:22", "text": "它正式走向消亡了。”你猜怎么着？"}, {"type": "subtitle", "time": 4226.47, "timestamp": "01:10:26", "text": "当我移除最初移除的部分时"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "2060年，我的手指被风扇夹住了。"}, {"type": "subtitle", "time": 4233.189, "timestamp": "01:10:33", "text": "在它运行时。我忘了转弯"}, {"type": "subtitle", "time": 4237.83, "timestamp": "01:10:37", "text": "离开 se 呃 就像 呃 看到 呃 转弯"}, {"type": "subtitle", "time": 4240.79, "timestamp": "01:10:40", "text": "在移除之前先从电脑上移除"}, {"type": "subtitle", "time": 4243.87, "timestamp": "01:10:43", "text": "成分。现在我忘了，我的"}, {"type": "subtitle", "time": 4248.229, "timestamp": "01:10:48", "text": "手指被切伤了。不是切片，而是切开。"}, {"type": "subtitle", "time": 4251.91, "timestamp": "01:10:51", "text": "没关系。它被剪掉了。加两个粉丝"}, {"type": "subtitle", "time": 4256.51, "timestamp": "01:10:56", "text": "两侧的刀片都伸了过来"}]
[{"type": "subtitle", "time": 3909.47, "timestamp": "01:05:09", "text": "耶。超好的。"}, {"type": "subtitle", "time": 3919.069, "timestamp": "01:05:19", "text": "语言。我只知道玛丽塔"}, {"type": "subtitle", "time": 3927.15, "timestamp": "01:05:27", "text": "是在马来西亚学到的。好的。"}, {"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "[音乐]"}, {"type": "subtitle", "time": 3932.63, "timestamp": "01:05:32", "text": "所以，我讲到故事的哪一部分了？"}, {"type": "subtitle", "time": 3936.069, "timestamp": "01:05:36", "text": "时间？是啊，都是些玩笑性质的政治正确的东西，对吧？"}, {"type": "subtitle", "time": 3942.789, "timestamp": "01:05:42", "text": "嗯，我的首席运营官去年去世了。"}, {"type": "subtitle", "time": 3947.91, "timestamp": "01:05:47", "text": "呃，我想大概是在我的直播间附近吧。"}, {"type": "subtitle", "time": 3951.549, "timestamp": "01:05:51", "text": "嗯，是的，然后第二天我就没做什么了。"}, {"type": "subtitle", "time": 3955.19, "timestamp": "01:05:55", "text": "那天我直播玩游戏"}, {"type": "subtitle", "time": 3958.23, "timestamp": "01:05:58", "text": "那个游戏里的摄像头，其实就是GPU。"}]
[{"type": "subtitle", "time": 18185.43, "timestamp": "05:03:05", "text": "好了，我现在要走了，因为我"}, {"type": "subtitle", "time": 18188.07, "timestamp": "05:03:08", "text": "开始想念美月了。呃，什么？"}, {"type": "subtitle", "time": 18190.07, "timestamp": "05:03:10", "text": "我应该把钻石送给她哪里？"}, {"type": "subtitle", "time": 18192.47, "timestamp": "05:03:12", "text": "她有钻石吗？"}, {"type": "subtitle", "time": 18195.83, "timestamp": "05:03:15", "text": "从这里给她一些就行了。"}, {"type": "subtitle", "time": 18197.39, "timestamp": "05:03:17", "text": "哦，"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "好的。我也想教她。我认为"}, {"type": "subtitle", "time": 18205.43, "timestamp": "05:03:25", "text": "面纱对她来说是一个非常好的附魔。"}, {"type": "subtitle", "time": 18208.628, "timestamp": "05:03:28", "text": "对，就是这个。"}, {"type": "subtitle", "time": 18211.19, "timestamp": "05:03:31", "text": "呃，你可以直接给我我的钻石头盔"}, {"type": "subtitle", "time": 18215.67, "timestamp": "05:03:35", "text": "对她来说。但你呢？"}, {"type": "subtitle", "time": 18218.11, "timestamp": "05:03:38", "text": "不，你拿你的。"}, {"type": "subtitle", "time": 18220.47, "timestamp": "05:03:40", "text": "好的，我会给她做一个。不"}, {"type": "subtitle", "time": 18222.23, "timestamp": "05:03:42", "text": "担心。"}, {"type": "subtitle", "time": 18224.628, "timestamp": "05:03:44", "text": "还"}, {"type": "subtitle", "time": 18227.11, "timestamp": "05:03:47", "text": "鲸鱼更好吗？"}, {"type": "subtitle", "time": 18234.83, "timestamp": "05:03:54", "text": "[音乐]"}, {"type": "subtitle", "time": 18237.75, "timestamp": "05:03:57", "text": "是的，面纱和两栖动物可能是"}, {"type": "subtitle", "time": 18239.43, "timestamp": "05:03:59", "text": "更好的。什么？什么？做什么？你做什么"}]
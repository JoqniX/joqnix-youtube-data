[{"type": "subtitle", "time": 15062.79, "timestamp": "04:11:02", "text": "即使在那时也是如此。你发送了吗？"}, {"type": "subtitle", "time": 15064.95, "timestamp": "04:11:04", "text": "给他清点物品？"}, {"type": "subtitle", "time": 15067.07, "timestamp": "04:11:07", "text": "是的，我做了。"}, {"type": "subtitle", "time": 15069.389, "timestamp": "04:11:09", "text": "呃，我的在哪里？"}, {"type": "subtitle", "time": 15073.189, "timestamp": "04:11:13", "text": "溪流？昨天是今天16号。好的。"}, {"type": "subtitle", "time": 15076.63, "timestamp": "04:11:16", "text": "15. 今天是拉屎日。"}, {"type": "subtitle", "time": 15080.07, "timestamp": "04:11:20", "text": "我哭泣的那天。不，是我怒退游戏的那天"}, {"type": "subtitle", "time": 15088.55, "timestamp": "04:11:28", "text": "昨天。老兄，你为什么怒退游戏？"}, {"type": "subtitle", "time": 15091.189, "timestamp": "04:11:31", "text": "昨天？那根愚蠢的柱子"}, {"type": "subtitle", "time": 15094.03, "timestamp": "04:11:34", "text": "斧头。我当时就想，我已经杀过人了。"}, {"type": "subtitle", "time": 15098.309, "timestamp": "04:11:38", "text": "56个村民，就像你知道的那样"}, {"type": "subtitle", "time": 15100.55, "timestamp": "04:11:40", "text": "像顶点那样的运动"}, {"type": "subtitle", "time": 15102.99, "timestamp": "04:11:42", "text": "那水龙头渴望着，就像滑溜溜的一样。"}, {"type": "subtitle", "time": 15112.75, "timestamp": "04:11:52", "text": "我不知道我是否做了那件事，呃……"}, {"type": "subtitle", "time": 15116.95, "timestamp": "04:11:56", "text": "一切都开始了"}]
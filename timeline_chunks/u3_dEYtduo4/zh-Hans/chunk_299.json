[{"type": "subtitle", "time": 17940.07, "timestamp": "04:59:00", "text": "谁制作了《我的世界》？但"}, {"type": "subtitle", "time": 17942.55, "timestamp": "04:59:02", "text": "是的，如何获得锻造模板"}, {"type": "subtitle", "time": 17950.31, "timestamp": "04:59:10", "text": "你可以从世界宝箱里找到它，就像我刚才说的那样。"}, {"type": "subtitle", "time": 17982.55, "timestamp": "04:59:42", "text": "啊，我也加入了。"}, {"type": "subtitle", "time": 17990.948, "timestamp": "04:59:50", "text": "你也在给她打电话。"}, {"type": "subtitle", "time": 17996.868, "timestamp": "04:59:56", "text": "哦，对不起。我的天啊。对不起。施我"}, {"type": "subtitle", "time": 17999.15, "timestamp": "04:59:59", "text": "必须"}]
[{"type": "subtitle", "time": 17167.75, "timestamp": "04:46:07", "text": "嗯，丝滑触感更适合铲子。"}, {"type": "subtitle", "time": 17169.35, "timestamp": "04:46:09", "text": "正确的？"}, {"type": "subtitle", "time": 17171.75, "timestamp": "04:46:11", "text": "什么？丝滑触感更适合"}, {"type": "subtitle", "time": 17173.99, "timestamp": "04:46:13", "text": "铲子，对吧？"}, {"type": "subtitle", "time": 17177.35, "timestamp": "04:46:17", "text": "什么？为了什么？丝滑触感更好"}, {"type": "subtitle", "time": 17180.948, "timestamp": "04:46:20", "text": "是铲子，对吧？铲。"}, {"type": "subtitle", "time": 17182.47, "timestamp": "04:46:22", "text": "不。"}, {"type": "subtitle", "time": 17185.51, "timestamp": "04:46:25", "text": "我的天哪。哦。或者，或者像我确信的那样。和"}, {"type": "subtitle", "time": 17187.43, "timestamp": "04:46:27", "text": "没有类似的情况"}, {"type": "subtitle", "time": 17190.868, "timestamp": "04:46:30", "text": "铲。但镐子更好的选择是"}, {"type": "subtitle", "time": 17194.708, "timestamp": "04:46:34", "text": "熔化的，对吧？那种冶炼能力。"}, {"type": "subtitle", "time": 17197.19, "timestamp": "04:46:37", "text": "这取决于你的需求。你知道，我们"}, {"type": "subtitle", "time": 17200.15, "timestamp": "04:46:40", "text": "可以用这些制冰。看看"}, {"type": "subtitle", "time": 17216.07, "timestamp": "04:46:56", "text": "是的，我支持你。"}, {"type": "subtitle", "time": 17219.67, "timestamp": "04:46:59", "text": "我们现在回家吧。我真的觉得我输了"}]
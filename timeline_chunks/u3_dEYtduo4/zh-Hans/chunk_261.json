[{"type": "subtitle", "time": 15660.429, "timestamp": "04:21:00", "text": "金剑。好的。狂暴。是的。"}, {"type": "subtitle", "time": 15663.75, "timestamp": "04:21:03", "text": "狂暴。我会用绅士的方式告诉你……"}, {"type": "subtitle", "time": 15667.91, "timestamp": "04:21:07", "text": "狂暴就是为了那把剑。然后"}, {"type": "subtitle", "time": 15670.429, "timestamp": "04:21:10", "text": "呃，弩有"}, {"type": "subtitle", "time": 15673.71, "timestamp": "04:21:13", "text": "爆炸物"}, {"type": "subtitle", "time": 15677.63, "timestamp": "04:21:17", "text": "一。然后呃，那个"}, {"type": "subtitle", "time": 15681.79, "timestamp": "04:21:21", "text": "斧头上有一根木棍，那是伐木工的。"}, {"type": "subtitle", "time": 15685.429, "timestamp": "04:21:25", "text": "一。然后铲子做了什么？"}, {"type": "subtitle", "time": 15688.79, "timestamp": "04:21:28", "text": "有铲子吗？呃，铲子干了什么？"}, {"type": "subtitle", "time": 15691.59, "timestamp": "04:21:31", "text": "有？上帝之铲。我想我没放"}, {"type": "subtitle", "time": 15695.229, "timestamp": "04:21:35", "text": "结束了。没关系。然后"}, {"type": "subtitle", "time": 15705.63, "timestamp": "04:21:45", "text": "小的。那还有什么呢？头盔是"}, {"type": "subtitle", "time": 15709.229, "timestamp": "04:21:49", "text": "面纱。钻石头盔"}, {"type": "subtitle", "time": 15715.07, "timestamp": "04:21:55", "text": "面纱。嗯，钻石胸甲是……"}, {"type": "subtitle", "time": 15719.87, "timestamp": "04:21:59", "text": "两栖动物。而钻石铅笔"}]
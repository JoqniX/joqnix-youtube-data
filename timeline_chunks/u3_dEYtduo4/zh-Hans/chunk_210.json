[{"type": "subtitle", "time": 12602.389, "timestamp": "03:30:02", "text": "好吧，我试过了。就像之后一样"}, {"type": "subtitle", "time": 12604.91, "timestamp": "03:30:04", "text": "大概六到八个月的时间里，我一直在唱歌"}, {"type": "subtitle", "time": 12608.15, "timestamp": "03:30:08", "text": "歌曲。我花了12个小时才拿到我的"}, {"type": "subtitle", "time": 12610.55, "timestamp": "03:30:10", "text": "喉咙痛得厉害，以至于我"}, {"type": "subtitle", "time": 12613.389, "timestamp": "03:30:13", "text": "无法说出那条溪流"}, {"type": "subtitle", "time": 12616.87, "timestamp": "03:30:16", "text": "我连续唱了12个小时这首歌"}, {"type": "subtitle", "time": 12618.79, "timestamp": "03:30:18", "text": "练习，练习，因为它很快"}, {"type": "subtitle", "time": 12634.87, "timestamp": "03:30:34", "text": "得知这是一首歌，但我不想……"}]
[{"type": "subtitle", "time": 22685.15, "timestamp": "06:18:05", "text": "热门VR，还有，呃，僵尸"}, {"type": "subtitle", "time": 22690.07, "timestamp": "06:18:10", "text": "等等，我有很多VR游戏"}, {"type": "subtitle", "time": 22692.27, "timestamp": "06:18:12", "text": "你知道的"}, {"type": "subtitle", "time": 22694.868, "timestamp": "06:18:14", "text": "是啊，但你知道你应该怎么做吗？"}, {"type": "subtitle", "time": 22699.19, "timestamp": "06:18:19", "text": "兄弟，总有一天应该加入VR排行榜。"}, {"type": "subtitle", "time": 22702.39, "timestamp": "06:18:22", "text": "VR聊天？嗯，等你有了电脑就去玩吧。"}, {"type": "subtitle", "time": 22705.03, "timestamp": "06:18:25", "text": "PC告诉我有很多好玩的东西"}, {"type": "subtitle", "time": 22707.27, "timestamp": "06:18:27", "text": "我可以向你证明，你这行为很可疑。"}, {"type": "subtitle", "time": 22709.75, "timestamp": "06:18:29", "text": "尽量选择试玩版。好的。"}, {"type": "subtitle", "time": 22711.39, "timestamp": "06:18:31", "text": "所以你不会"}, {"type": "subtitle", "time": 22715.83, "timestamp": "06:18:35", "text": "被窒息，我会说地方"}, {"type": "subtitle", "time": 22719.35, "timestamp": "06:18:39", "text": "你的电脑放在一个有空调的房间里。"}, {"type": "subtitle", "time": 22723.27, "timestamp": "06:18:43", "text": "相信我，天气会非常热。"}, {"type": "subtitle", "time": 22729.19, "timestamp": "06:18:49", "text": "我懂了。"}, {"type": "subtitle", "time": 22736.628, "timestamp": "06:18:56", "text": "辛辣的。哦，你可以放个睡袋。"}]
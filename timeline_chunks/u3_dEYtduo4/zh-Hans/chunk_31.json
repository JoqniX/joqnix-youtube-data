[{"type": "subtitle", "time": 1872.89, "timestamp": "00:31:12", "text": "那个呃"}, {"type": "subtitle", "time": 1890.029, "timestamp": "00:31:30", "text": "糟糕，服务器更新了"}, {"type": "subtitle", "time": 1901.35, "timestamp": "00:31:41", "text": "什么？哦，不。等等，我两周内做了什么？"}, {"type": "subtitle", "time": 1904.909, "timestamp": "00:31:44", "text": "天？我们得到了钻石，钻石盔甲，"}, {"type": "subtitle", "time": 1907.669, "timestamp": "00:31:47", "text": "一切。整套，对吧？两天。"}]
[{"type": "subtitle", "time": 22260.628, "timestamp": "06:11:00", "text": "你知道，我没说错什么。"}, {"type": "subtitle", "time": 22262.788, "timestamp": "06:11:02", "text": "好的。"}, {"type": "subtitle", "time": 22264.39, "timestamp": "06:11:04", "text": "我曾说过，这会让人不知所措。"}, {"type": "subtitle", "time": 22266.51, "timestamp": "06:11:06", "text": "如果我添加很多东西，你会怎么想？你会"}, {"type": "subtitle", "time": 22268.788, "timestamp": "06:11:08", "text": "你会感到困惑和烦躁，而且"}, {"type": "subtitle", "time": 22272.75, "timestamp": "06:11:12", "text": "你不会喜欢那样的。看？"}, {"type": "subtitle", "time": 22276.07, "timestamp": "06:11:16", "text": "是的。没错，没错，没错。"}, {"type": "subtitle", "time": 22285.75, "timestamp": "06:11:25", "text": "他长得像泰迪熊。等等，我可以"}, {"type": "subtitle", "time": 22299.15, "timestamp": "06:11:39", "text": "不要放"}, {"type": "subtitle", "time": 22301.628, "timestamp": "06:11:41", "text": "一个"}, {"type": "subtitle", "time": 22314.67, "timestamp": "06:11:54", "text": "[音乐]"}, {"type": "subtitle", "time": 22317.15, "timestamp": "06:11:57", "text": "那。我的天啊。"}]
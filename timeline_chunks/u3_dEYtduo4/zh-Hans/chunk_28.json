[{"type": "subtitle", "time": 1680.149, "timestamp": "00:28:00", "text": "终于，我们终于成为 YouTube 频道了"}, {"type": "subtitle", "time": 1683.029, "timestamp": "00:28:03", "text": "伙伴。我可以将其变现。不，我不能"}, {"type": "subtitle", "time": 1685.029, "timestamp": "00:28:05", "text": "尚未实现盈利。但我可以开一个"}, {"type": "subtitle", "time": 1687.99, "timestamp": "00:28:07", "text": "会员资格、超级留言等等。"}, {"type": "subtitle", "time": 1691.43, "timestamp": "00:28:11", "text": "所以，最后是 YouTube。我的天啊。"}, {"type": "subtitle", "time": 1693.83, "timestamp": "00:28:13", "text": "经过五年的努力工作和"}, {"type": "subtitle", "time": 1695.149, "timestamp": "00:28:15", "text": "永不放弃"}, {"type": "subtitle", "time": 1698.149, "timestamp": "00:28:18", "text": "向上。终于有了 YouTube。我的长期目标"}, {"type": "subtitle", "time": 1701.669, "timestamp": "00:28:21", "text": "今天成功了。今天。是的。我"}, {"type": "subtitle", "time": 1704.95, "timestamp": "00:28:24", "text": "简直难以置信。"}, {"type": "subtitle", "time": 1707.149, "timestamp": "00:28:27", "text": "它仍然是"}, {"type": "subtitle", "time": 1710.59, "timestamp": "00:28:30", "text": "呃，还是这样"}, {"type": "subtitle", "time": 1715.269, "timestamp": "00:28:35", "text": "确实有这样的东西。还有木瓜，哦，我"}, {"type": "subtitle", "time": 1718.149, "timestamp": "00:28:38", "text": "对不起。我当时非常累。我做不到"}, {"type": "subtitle", "time": 1720.95, "timestamp": "00:28:40", "text": "喝木瓜汁，感觉有点……"}, {"type": "subtitle", "time": 1722.35, "timestamp": "00:28:42", "text": "去"}, {"type": "subtitle", "time": 1725.669, "timestamp": "00:28:45", "text": "糟糕，因为我把它留到了晚上。所以，"}, {"type": "subtitle", "time": 1729.59, "timestamp": "00:28:49", "text": "都是我的错。是的，我知道。"}, {"type": "subtitle", "time": 1732.149, "timestamp": "00:28:52", "text": "我喜欢，如果你有个人资料的话，请展示一下。"}, {"type": "subtitle", "time": 1734.149, "timestamp": "00:28:54", "text": "他们在您的频道页面上的个人资料。如果"}, {"type": "subtitle", "time": 1735.389, "timestamp": "00:28:55", "text": "谢谢你。"}, {"type": "subtitle", "time": 1738.63, "timestamp": "00:28:58", "text": "在您的视频下方显示。哦，"}]
[{"type": "subtitle", "time": 20280.47, "timestamp": "05:38:00", "text": "对不起。你会吃点好吃的吗？"}, {"type": "subtitle", "time": 20283.708, "timestamp": "05:38:03", "text": "等等，镐子在哪儿？"}, {"type": "subtitle", "time": 20287.948, "timestamp": "05:38:07", "text": "呃，不知道。"}, {"type": "subtitle", "time": 20291.67, "timestamp": "05:38:11", "text": "嘿，什么什么什么什么"}, {"type": "subtitle", "time": 20293.27, "timestamp": "05:38:13", "text": "他妈的？"}, {"type": "subtitle", "time": 20296.27, "timestamp": "05:38:16", "text": "发生了什么？"}, {"type": "subtitle", "time": 20300.31, "timestamp": "05:38:20", "text": "没有什么。它出故障了。为什么？什么是"}, {"type": "subtitle", "time": 20302.47, "timestamp": "05:38:22", "text": "出现故障了吗？"}, {"type": "subtitle", "time": 20305.75, "timestamp": "05:38:25", "text": "是的，你可能已经这么做了。呃，回来"}, {"type": "subtitle", "time": 20309.75, "timestamp": "05:38:29", "text": "有时候，奶酪也能解决这个小故障。"}, {"type": "subtitle", "time": 20312.23, "timestamp": "05:38:32", "text": "背部奶酪。"}, {"type": "subtitle", "time": 20315.27, "timestamp": "05:38:35", "text": "是的。所以，基本上，你得到了阿森纳"}, {"type": "subtitle", "time": 20324.35, "timestamp": "05:38:44", "text": "为什么？这有什么问题吗？我不"}, {"type": "subtitle", "time": 20328.23, "timestamp": "05:38:48", "text": "知道。兵工厂。"}, {"type": "subtitle", "time": 20330.788, "timestamp": "05:38:50", "text": "是的。所以你知道你可以放置物品"}, {"type": "subtitle", "time": 20333.35, "timestamp": "05:38:53", "text": "在你的背景上。是的。不是背包"}, {"type": "subtitle", "time": 20336.07, "timestamp": "05:38:56", "text": "就像在背面一样。是的。所以它可能会出故障"}, {"type": "subtitle", "time": 20337.83, "timestamp": "05:38:57", "text": "有时是因为你穿着"}, {"type": "subtitle", "time": 20339.91, "timestamp": "05:38:59", "text": "背包。"}]
[{"type": "subtitle", "time": 21797.75, "timestamp": "06:03:17", "text": "呃，从连接器中提取。这一切"}, {"type": "subtitle", "time": 21816.948, "timestamp": "06:03:36", "text": "我当时"}, {"type": "subtitle", "time": 21820.708, "timestamp": "06:03:40", "text": "更让我高兴的是，你回来了。我不得不走了"}, {"type": "subtitle", "time": 21823.59, "timestamp": "06:03:43", "text": "进来了，兄弟。哦，是的。你告诉她怎么做了吗？"}, {"type": "subtitle", "time": 21827.35, "timestamp": "06:03:47", "text": "使用坐标？"}, {"type": "subtitle", "time": 21830.47, "timestamp": "06:03:50", "text": "哦，不。我忘了。"}, {"type": "subtitle", "time": 21837.91, "timestamp": "06:03:57", "text": "你知道吗？她将无法"}]
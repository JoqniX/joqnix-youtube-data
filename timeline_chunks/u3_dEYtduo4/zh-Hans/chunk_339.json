[{"type": "subtitle", "time": 20341.59, "timestamp": "05:39:01", "text": "哦，它应该在你的背上。"}, {"type": "subtitle", "time": 20344.31, "timestamp": "05:39:04", "text": "这不是我的背包里的东西。"}, {"type": "subtitle", "time": 20345.91, "timestamp": "05:39:05", "text": "它不在你的背包上。这取决于你"}, {"type": "subtitle", "time": 20347.628, "timestamp": "05:39:07", "text": "后退。喜欢"}, {"type": "subtitle", "time": 20350.948, "timestamp": "05:39:10", "text": "这里有个快捷键，"}, {"type": "subtitle", "time": 20353.91, "timestamp": "05:39:13", "text": "正确的？你可能有一个快捷键"}, {"type": "subtitle", "time": 20355.59, "timestamp": "05:39:15", "text": "那。"}, {"type": "subtitle", "time": 20357.51, "timestamp": "05:39:17", "text": "哦，明白了。知道了。是的。是的。是的。"}, {"type": "subtitle", "time": 20359.91, "timestamp": "05:39:19", "text": "是的。它能用吗？你看到了吗？"}, {"type": "subtitle", "time": 20362.548, "timestamp": "05:39:22", "text": "现在你的包里有两件物品。"}, {"type": "subtitle", "time": 20365.11, "timestamp": "05:39:25", "text": "所以它可能会出故障。"}, {"type": "subtitle", "time": 20367.19, "timestamp": "05:39:27", "text": "哦，我想说的是，当你穿着……"}, {"type": "subtitle", "time": 20369.19, "timestamp": "05:39:29", "text": "现在就背上背包。"}, {"type": "subtitle", "time": 20372.75, "timestamp": "05:39:32", "text": "所以不要用那个。得到"}, {"type": "subtitle", "time": 20375.35, "timestamp": "05:39:35", "text": "它。那仍然是那个故障。"}, {"type": "subtitle", "time": 20378.628, "timestamp": "05:39:38", "text": "那里。但没关系。"}, {"type": "subtitle", "time": 20382.15, "timestamp": "05:39:42", "text": "兄弟，我太累了。"}, {"type": "subtitle", "time": 20385.51, "timestamp": "05:39:45", "text": "走开。你很努力。你工作过"}, {"type": "subtitle", "time": 20387.91, "timestamp": "05:39:47", "text": "今天真难熬。现在睡觉吧。你给了吗？"}, {"type": "subtitle", "time": 20390.788, "timestamp": "05:39:50", "text": "物品要送给每个人吗？"}, {"type": "subtitle", "time": 20395.11, "timestamp": "05:39:55", "text": "我做了。我现在不想睡觉。"}, {"type": "subtitle", "time": 20397.91, "timestamp": "05:39:57", "text": "我有，我有，我说我们一无所有"}]
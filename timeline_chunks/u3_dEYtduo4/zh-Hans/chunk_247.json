[{"type": "subtitle", "time": 14820.15, "timestamp": "04:07:00", "text": "赔偿。"}, {"type": "subtitle", "time": 14823.469, "timestamp": "04:07:03", "text": "好的，拿着。我会得到吗？"}, {"type": "subtitle", "time": 14827.189, "timestamp": "04:07:07", "text": "我能收到我的物品吗？"}, {"type": "subtitle", "time": 14829.429, "timestamp": "04:07:09", "text": "是的。是的。什么？"}, {"type": "subtitle", "time": 14832.389, "timestamp": "04:07:12", "text": "我需要一些钻石，我已经有了。"}, {"type": "subtitle", "time": 14834.79, "timestamp": "04:07:14", "text": "补偿。顺便问一下，什么是"}, {"type": "subtitle", "time": 14839.429, "timestamp": "04:07:19", "text": "背包？我该如何装备它？呃，放"}, {"type": "subtitle", "time": 14841.389, "timestamp": "04:07:21", "text": "它"}, {"type": "subtitle", "time": 14845.389, "timestamp": "04:07:25", "text": "就像你的胸甲一样。是的，胸部"}, {"type": "subtitle", "time": 14847.269, "timestamp": "04:07:27", "text": "盘子。"}, {"type": "subtitle", "time": 14850.309, "timestamp": "04:07:30", "text": "你可以升级背包。是的，你可以"}, {"type": "subtitle", "time": 14851.95, "timestamp": "04:07:31", "text": "升级"}, {"type": "subtitle", "time": 14854.71, "timestamp": "04:07:34", "text": "它。你可以用铁和钻石来制作它。"}, {"type": "subtitle", "time": 14857.59, "timestamp": "04:07:37", "text": "还有黄金。等等，我怎么才能看到菜单？"}, {"type": "subtitle", "time": 14859.91, "timestamp": "04:07:39", "text": "不过，背包呢？这是什么？"}, {"type": "subtitle", "time": 14863.03, "timestamp": "04:07:43", "text": "男的？我的天哪，那是个邮箱。"}, {"type": "subtitle", "time": 14865.349, "timestamp": "04:07:45", "text": "是的。所以，从蓝色的那个，你可以"}, {"type": "subtitle", "time": 14867.83, "timestamp": "04:07:47", "text": "可以将任何物品发送到另一个邮箱。所以，"}, {"type": "subtitle", "time": 14869.83, "timestamp": "04:07:49", "text": "这是您的群组邮箱，例如"}, {"type": "subtitle", "time": 14872.95, "timestamp": "04:07:52", "text": "木制的那个。它将接收物品。"}, {"type": "subtitle", "time": 14875.67, "timestamp": "04:07:55", "text": "所以你可以踏上旅程，你会"}, {"type": "subtitle", "time": 14879.269, "timestamp": "04:07:59", "text": "把它寄回你家。我的天啊。"}]
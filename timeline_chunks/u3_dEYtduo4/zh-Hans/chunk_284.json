[{"type": "subtitle", "time": 17045.35, "timestamp": "04:44:05", "text": "真是你的霉运啊。"}, {"type": "subtitle", "time": 17048.67, "timestamp": "04:44:08", "text": "不，别闹了。哦，我的"}, {"type": "subtitle", "time": 17051.67, "timestamp": "04:44:11", "text": "上帝。我的天哪。怎么了"}, {"type": "subtitle", "time": 17054.31, "timestamp": "04:44:14", "text": "今天？"}, {"type": "subtitle", "time": 17057.83, "timestamp": "04:44:17", "text": "你今天行为举止非常奇怪。"}, {"type": "subtitle", "time": 17059.91, "timestamp": "04:44:19", "text": "确切地。我甚至不知道那是什么"}, {"type": "subtitle", "time": 17063.788, "timestamp": "04:44:23", "text": "发生在我身上的事。我喝醉了睡着了。"}, {"type": "subtitle", "time": 17067.11, "timestamp": "04:44:27", "text": "再次。我失去了什么？好的，你是"}, {"type": "subtitle", "time": 17071.07, "timestamp": "04:44:31", "text": "这里。你真是太……"}, {"type": "subtitle", "time": 17082.27, "timestamp": "04:44:42", "text": "不，我说的是一些可怕的事情。哦，我的"}, {"type": "subtitle", "time": 17085.75, "timestamp": "04:44:45", "text": "上帝。东西在哪儿？它不见了吗？"}, {"type": "subtitle", "time": 17089.75, "timestamp": "04:44:49", "text": "消失了。我觉得它已经没了。我懂了。我懂了。我"}, {"type": "subtitle", "time": 17092.31, "timestamp": "04:44:52", "text": "看。我懂了。我懂了。这边。直的"}, {"type": "subtitle", "time": 17094.39, "timestamp": "04:44:54", "text": "向下。看"}, {"type": "subtitle", "time": 17097.868, "timestamp": "04:44:57", "text": "这个？这个。这"}]
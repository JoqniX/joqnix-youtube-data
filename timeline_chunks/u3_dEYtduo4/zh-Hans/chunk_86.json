[{"type": "subtitle", "time": 5160.79, "timestamp": "01:26:00", "text": "糖 哦，是的，两天前。什么"}, {"type": "subtitle", "time": 5165.55, "timestamp": "01:26:05", "text": "我愿意？你给了我两把镰刀斧"}, {"type": "subtitle", "time": 5167.99, "timestamp": "01:26:07", "text": "东西，对吧？你给了我两个。我需要"}, {"type": "subtitle", "time": 5172.83, "timestamp": "01:26:12", "text": "那两个以前的，还有现在这个。男人，"}, {"type": "subtitle", "time": 5175.27, "timestamp": "01:26:15", "text": "除二以外的所有事物。我觉得你给了我"}, {"type": "subtitle", "time": 5177.709, "timestamp": "01:26:17", "text": "一个，对吧？不，等等。我不"}, {"type": "subtitle", "time": 5180.47, "timestamp": "01:26:20", "text": "记住。钻石盔甲套装"}, {"type": "subtitle", "time": 5184.39, "timestamp": "01:26:24", "text": "一切。那把星形斧头。星光"}, {"type": "subtitle", "time": 5189.35, "timestamp": "01:26:29", "text": "已经走了。而那颗小星星是"}, {"type": "subtitle", "time": 5194.75, "timestamp": "01:26:34", "text": "走了。猫 katan no"}, {"type": "subtitle", "time": 5197.629, "timestamp": "01:26:37", "text": "conalana 也消失了。这"}, {"type": "subtitle", "time": 5201.75, "timestamp": "01:26:41", "text": "武士刀横扫一切。"}]
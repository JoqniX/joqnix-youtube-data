[{"type": "subtitle", "time": 14943.03, "timestamp": "04:09:03", "text": "J，你今天过得怎么样？"}, {"type": "subtitle", "time": 14946.07, "timestamp": "04:09:06", "text": "我当时一切都很好。呃，我当时在唱歌。"}, {"type": "subtitle", "time": 14948.309, "timestamp": "04:09:08", "text": "很多。我的天哪，钻石背包"}, {"type": "subtitle", "time": 14951.59, "timestamp": "04:09:11", "text": "这件衣服很适合你。真的吗？我看不见"}, {"type": "subtitle", "time": 14955.83, "timestamp": "04:09:15", "text": "我自己承担责任。它是由钻石和红色组成的。"}, {"type": "subtitle", "time": 14958.55, "timestamp": "04:09:18", "text": "哦，对了，我们还得做出选择。我"}, {"type": "subtitle", "time": 14961.83, "timestamp": "04:09:21", "text": "忘了问阿斯特拉了。阿斯特拉在哪儿？"}, {"type": "subtitle", "time": 14964.95, "timestamp": "04:09:24", "text": "阿斯特拉走了吗？他会回来的。让我"}, {"type": "subtitle", "time": 14966.95, "timestamp": "04:09:26", "text": "让我截个图……"}, {"type": "subtitle", "time": 14975.229, "timestamp": "04:09:35", "text": "[音乐]"}, {"type": "subtitle", "time": 14979.189, "timestamp": "04:09:39", "text": "后退。查看。查看。好了，它运行正常。"}, {"type": "subtitle", "time": 14981.87, "timestamp": "04:09:41", "text": "你的任务物品也全部丢失了吗？"}, {"type": "subtitle", "time": 14985.67, "timestamp": "04:09:45", "text": "是的，就是这样，是的，"}, {"type": "subtitle", "time": 14988.389, "timestamp": "04:09:48", "text": "终极武器和所有那些牛奶"}, {"type": "subtitle", "time": 14991.429, "timestamp": "04:09:51", "text": "东西。 D 我从D那里得到了六颗五钻"}, {"type": "subtitle", "time": 14992.67, "timestamp": "04:09:52", "text": "那"}, {"type": "subtitle", "time": 14996.469, "timestamp": "04:09:56", "text": "胸部。一摞面包。是啊，太多了。"}]
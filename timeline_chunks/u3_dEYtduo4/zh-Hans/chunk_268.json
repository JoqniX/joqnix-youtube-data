[{"type": "subtitle", "time": 16080.149, "timestamp": "04:28:00", "text": "还不知道。好的。我会把它放进去"}, {"type": "subtitle", "time": 16083.03, "timestamp": "04:28:03", "text": "我会把它放进箱子里。不，不"}, {"type": "subtitle", "time": 16084.79, "timestamp": "04:28:04", "text": "不，不，不，不，不。别把它放进去。"}, {"type": "subtitle", "time": 16087.07, "timestamp": "04:28:07", "text": "胸部。好的。把它放在某个地方"}, {"type": "subtitle", "time": 16091.51, "timestamp": "04:28:11", "text": "别的。我得把我的东西做出来。好的。"}, {"type": "subtitle", "time": 16101.07, "timestamp": "04:28:21", "text": "这是我的秘密胸部区域。"}, {"type": "subtitle", "time": 16103.75, "timestamp": "04:28:23", "text": "哇。该死。好的。拿"}, {"type": "subtitle", "time": 16106.469, "timestamp": "04:28:26", "text": "顺便说一句，你需要钻石。拿"}, {"type": "subtitle", "time": 16108.79, "timestamp": "04:28:28", "text": "钻石的数量"}, {"type": "subtitle", "time": 16113.87, "timestamp": "04:28:33", "text": "需要。等等，你没事吧？"}, {"type": "subtitle", "time": 16117.269, "timestamp": "04:28:37", "text": "呃，多少钱？"}, {"type": "subtitle", "time": 16119.99, "timestamp": "04:28:39", "text": "一秒钟。我需要一个储物空间。做"}, {"type": "subtitle", "time": 16122.79, "timestamp": "04:28:42", "text": "你有箱子吗？三个胸部或类似"}, {"type": "subtitle", "time": 16124.55, "timestamp": "04:28:44", "text": "我会成功的。那是木头。我想我"}, {"type": "subtitle", "time": 16132.63, "timestamp": "04:28:52", "text": "认清你的“是”。是的。是的。不，我"}, {"type": "subtitle", "time": 16135.349, "timestamp": "04:28:55", "text": "库存已满。这就是原因。呃"}]
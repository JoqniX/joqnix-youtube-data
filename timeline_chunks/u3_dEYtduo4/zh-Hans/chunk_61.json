[{"type": "subtitle", "time": 3660.95, "timestamp": "01:01:00", "text": "主板还活着。呃，CPU坏了"}, {"type": "subtitle", "time": 3665.87, "timestamp": "01:01:05", "text": "现在。 GPU 坏了。然后是监视器"}, {"type": "subtitle", "time": 3669.549, "timestamp": "01:01:09", "text": "可以。啊，是显示器。啊，我该去哪里？"}, {"type": "subtitle", "time": 3673.589, "timestamp": "01:01:13", "text": "开始？我知道。我知道。下一个人"}, {"type": "subtitle", "time": 3674.91, "timestamp": "01:01:14", "text": "死"}, {"type": "subtitle", "time": 3681.99, "timestamp": "01:01:21", "text": "这真是一次难忘的经历。这真是"}, {"type": "subtitle", "time": 3684.19, "timestamp": "01:01:24", "text": "昂贵的"}, {"type": "subtitle", "time": 3687.91, "timestamp": "01:01:27", "text": "监视器。这是一个电子竞技版"}, {"type": "subtitle", "time": 3692.99, "timestamp": "01:01:32", "text": "比如 Ben Q uh 25 2456"}, {"type": "subtitle", "time": 3697.67, "timestamp": "01:01:37", "text": "特大号。是的，这是一台240Hz的电竞显示器。"}, {"type": "subtitle", "time": 3700.87, "timestamp": "01:01:40", "text": "我知道。我曾"}, {"type": "subtitle", "time": 3704.549, "timestamp": "01:01:44", "text": "呃，我已经换过三次了，现在"}, {"type": "subtitle", "time": 3706.87, "timestamp": "01:01:46", "text": "它已经过时了，它即将消亡"}, {"type": "subtitle", "time": 3710.71, "timestamp": "01:01:50", "text": "下一个。我知道。我不想让它消亡。"}, {"type": "subtitle", "time": 3712.829, "timestamp": "01:01:52", "text": "我是"}, {"type": "subtitle", "time": 3715.43, "timestamp": "01:01:55", "text": "害怕的。距离我去世已经过去两天了。"}, {"type": "subtitle", "time": 3717.63, "timestamp": "01:01:57", "text": "生日。等等，那是你"}]
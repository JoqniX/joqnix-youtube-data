[{"type": "subtitle", "time": 20161.75, "timestamp": "05:36:01", "text": "伙计们。您可以发表评论。我要买它。"}, {"type": "subtitle", "time": 20164.628, "timestamp": "05:36:04", "text": "拉屎。拉屎。等待。我该如何出去？"}, {"type": "subtitle", "time": 20166.868, "timestamp": "05:36:06", "text": "控制。"}, {"type": "subtitle", "time": 20170.15, "timestamp": "05:36:10", "text": "是的。坐。工作。坐。 Ctrl 或 C。好的。"}, {"type": "subtitle", "time": 20173.35, "timestamp": "05:36:13", "text": "是的。拍张照片。等待。这个呃"}, {"type": "subtitle", "time": 20175.27, "timestamp": "05:36:15", "text": "矿。"}, {"type": "subtitle", "time": 20177.19, "timestamp": "05:36:17", "text": "是的。现在，让我拍张照片。看。"}, {"type": "subtitle", "time": 20180.788, "timestamp": "05:36:20", "text": "看。别直视我。"}, {"type": "subtitle", "time": 20182.35, "timestamp": "05:36:22", "text": "你"}, {"type": "subtitle", "time": 20186.948, "timestamp": "05:36:26", "text": "可以拍照。我可以。平局。"}, {"type": "subtitle", "time": 20207.11, "timestamp": "05:36:47", "text": "你往里面塞了什么呃……盔甲之类的东西？"}, {"type": "subtitle", "time": 20210.07, "timestamp": "05:36:50", "text": "你的也想要那样的照明吗？"}, {"type": "subtitle", "time": 20212.628, "timestamp": "05:36:52", "text": "呃，那只是个模板之类的东西。你需要"}, {"type": "subtitle", "time": 20216.39, "timestamp": "05:36:56", "text": "找到那个掉落物之类的东西。如果你……的话，你可以。"}, {"type": "subtitle", "time": 20219.59, "timestamp": "05:36:59", "text": "找到一个，你需要复制它。"}]
[{"type": "subtitle", "time": 19982.548, "timestamp": "05:33:02", "text": "看看我有什么东西。所以，对于我的我"}, {"type": "subtitle", "time": 19986.15, "timestamp": "05:33:06", "text": "需要那个熔化的东西。呃，我有这个。"}, {"type": "subtitle", "time": 19989.03, "timestamp": "05:33:09", "text": "我有这个。你现在需要什么？这个摩尔"}, {"type": "subtitle", "time": 19991.67, "timestamp": "05:33:11", "text": "摩尔。 Jo，你可以，你可以，你可以存储"}, {"type": "subtitle", "time": 19994.868, "timestamp": "05:33:14", "text": "你身上有很多水、熔岩或牛奶"}, {"type": "subtitle", "time": 19998.39, "timestamp": "05:33:18", "text": "背包。但是水桶。如何……"}, {"type": "subtitle", "time": 20001.59, "timestamp": "05:33:21", "text": "升级工作正常吗？"}, {"type": "subtitle", "time": 20003.35, "timestamp": "05:33:23", "text": "呃，你得自己想办法。等等，你"}, {"type": "subtitle", "time": 20005.75, "timestamp": "05:33:25", "text": "需要摩尔。等等，你需要什么？莫尔顿。"}, {"type": "subtitle", "time": 20009.35, "timestamp": "05:33:29", "text": "莫尔顿。是的。等等，等等，"}, {"type": "subtitle", "time": 20012.628, "timestamp": "05:33:32", "text": "一秒钟。你为什么还没死？"}, {"type": "subtitle", "time": 20014.788, "timestamp": "05:33:34", "text": "那是一种威力巨大的武器。呃，你是"}, {"type": "subtitle", "time": 20018.83, "timestamp": "05:33:38", "text": "应该会成为蜘蛛侠的替身。"}, {"type": "subtitle", "time": 20029.03, "timestamp": "05:33:49", "text": "飞吧，兄弟。严重地。"}, {"type": "subtitle", "time": 20034.59, "timestamp": "05:33:54", "text": "严重地。和"}, {"type": "subtitle", "time": 20039.82, "timestamp": "05:33:59", "text": "献给上帝的麦芽和丝绸。谢谢。"}]
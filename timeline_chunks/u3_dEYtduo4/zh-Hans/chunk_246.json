[{"type": "subtitle", "time": 14767.91, "timestamp": "04:06:07", "text": "啊，等等。我还没准备。"}, {"type": "subtitle", "time": 14769.91, "timestamp": "04:06:09", "text": "你想让我把你送到铃木公司吗？"}, {"type": "subtitle", "time": 14772.79, "timestamp": "04:06:12", "text": "是的。"}, {"type": "subtitle", "time": 14780.389, "timestamp": "04:06:20", "text": "哦，你好。你好。嗨，乔。你是怎么来的"}, {"type": "subtitle", "time": 14784.15, "timestamp": "04:06:24", "text": "这里？哦，阿斯特拉。哦，你做了吗？"}, {"type": "subtitle", "time": 14787.11, "timestamp": "04:06:27", "text": "这一切都是你一个人做的吗？我的天啊。是的，"}, {"type": "subtitle", "time": 14790.389, "timestamp": "04:06:30", "text": "失去一切之后，这就是我"}, {"type": "subtitle", "time": 14793.03, "timestamp": "04:06:33", "text": "想出了办法。这可不是最好的。"}, {"type": "subtitle", "time": 14798.389, "timestamp": "04:06:38", "text": "史上最佳设计。它是构成建筑的基本元素。 H."}, {"type": "subtitle", "time": 14800.95, "timestamp": "04:06:40", "text": "好的。好的。"}, {"type": "subtitle", "time": 14805.11, "timestamp": "04:06:45", "text": "啊，一切都变了。是的，不会。"}, {"type": "subtitle", "time": 14807.99, "timestamp": "04:06:47", "text": "落后。我添加了一个邮箱。所以现在你可以"}, {"type": "subtitle", "time": 14810.15, "timestamp": "04:06:50", "text": "即使您不在家，也可以将物品寄到您家。"}, {"type": "subtitle", "time": 14813.67, "timestamp": "04:06:53", "text": "分开。我把背包给了铃木。"}, {"type": "subtitle", "time": 14815.59, "timestamp": "04:06:55", "text": "哦，我已经给了两叠"}, {"type": "subtitle", "time": 14818.15, "timestamp": "04:06:58", "text": "钻石和一堆铁"}]
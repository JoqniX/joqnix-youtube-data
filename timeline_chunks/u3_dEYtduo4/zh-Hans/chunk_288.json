[{"type": "subtitle", "time": 17283.03, "timestamp": "04:48:03", "text": "等等，他登录了吗？是的，他确实登录了。"}, {"type": "subtitle", "time": 17284.67, "timestamp": "04:48:04", "text": "他没有来"}, {"type": "subtitle", "time": 17288.47, "timestamp": "04:48:08", "text": "我。真没礼貌。"}, {"type": "subtitle", "time": 17291.51, "timestamp": "04:48:11", "text": "我想他会来的。"}, {"type": "subtitle", "time": 17294.07, "timestamp": "04:48:14", "text": "显然有八个人"}, {"type": "subtitle", "time": 17297.31, "timestamp": "04:48:17", "text": "应该是你"}, {"type": "subtitle", "time": 17307.19, "timestamp": "04:48:27", "text": "我不知道的事，算了，我不应该知道。"}, {"type": "subtitle", "time": 17309.99, "timestamp": "04:48:29", "text": "剧透"}, {"type": "subtitle", "time": 17319.03, "timestamp": "04:48:39", "text": "实际上，但我认为每个人都有"}, {"type": "subtitle", "time": 17320.43, "timestamp": "04:48:40", "text": "不同"}, {"type": "subtitle", "time": 17324.31, "timestamp": "04:48:44", "text": "除了其他八个人之外，还有一个人"}, {"type": "subtitle", "time": 17326.788, "timestamp": "04:48:46", "text": "我们确实有龙。"}, {"type": "subtitle", "time": 17329.75, "timestamp": "04:48:49", "text": "杀死"}, {"type": "subtitle", "time": 17334.708, "timestamp": "04:48:54", "text": "哈比比说，抓紧它，他就像……"}, {"type": "subtitle", "time": 17337.59, "timestamp": "04:48:57", "text": "我也有自己的任务，但是"}]
[{"type": "subtitle", "time": 17460.07, "timestamp": "04:51:00", "text": "我肯定会锁门的。你好。就像我"}, {"type": "subtitle", "time": 17463.03, "timestamp": "04:51:03", "text": "因为不打算再直播了。"}, {"type": "subtitle", "time": 17465.91, "timestamp": "04:51:05", "text": "我真的浑身都疼。"}, {"type": "subtitle", "time": 17474.628, "timestamp": "04:51:14", "text": "每当美月加入的时候。不知道。她"}, {"type": "subtitle", "time": 17478.07, "timestamp": "04:51:18", "text": "今天想直播，但是服务器……"}, {"type": "subtitle", "time": 17478.91, "timestamp": "04:51:18", "text": "曾是"}, {"type": "subtitle", "time": 17496.868, "timestamp": "04:51:36", "text": "每次我跳起来，都感觉好像有人在……"}, {"type": "subtitle", "time": 17500.47, "timestamp": "04:51:40", "text": "比如在应用内发送垃圾信息。有人正在使用"}, {"type": "subtitle", "time": 17503.43, "timestamp": "04:51:43", "text": "键盘声太大了，或者是什么其他原因，然后我"}, {"type": "subtitle", "time": 17506.23, "timestamp": "04:51:46", "text": "穿上这双弹力靴，跳起来，对吧？那"}, {"type": "subtitle", "time": 17512.868, "timestamp": "04:51:52", "text": "真的"}, {"type": "subtitle", "time": 17515.19, "timestamp": "04:51:55", "text": "你应该买一个。 IO。"}, {"type": "subtitle", "time": 17518.948, "timestamp": "04:51:58", "text": "我有。哦，真的吗？"}]
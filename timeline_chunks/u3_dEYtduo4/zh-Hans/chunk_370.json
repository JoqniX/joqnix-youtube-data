[{"type": "subtitle", "time": 22207.19, "timestamp": "06:10:07", "text": "第二季我们应该补充第二季"}, {"type": "subtitle", "time": 22209.03, "timestamp": "06:10:09", "text": "我们应该添加玩家自定义功能。"}, {"type": "subtitle", "time": 22212.948, "timestamp": "06:10:12", "text": "V2 的那些东西等等"}, {"type": "subtitle", "time": 22217.03, "timestamp": "06:10:17", "text": "呃，我会发给你的，第二季我拍的时候会发的。"}, {"type": "subtitle", "time": 22218.948, "timestamp": "06:10:18", "text": "我得先把自己的东西拿回来，不然我就不干了。"}, {"type": "subtitle", "time": 22226.708, "timestamp": "06:10:26", "text": "是的，我应该给你一些。"}, {"type": "subtitle", "time": 22230.15, "timestamp": "06:10:30", "text": "你应该会喜欢的视频"}, {"type": "subtitle", "time": 22232.948, "timestamp": "06:10:32", "text": "其他 YouTuber"}, {"type": "subtitle", "time": 22235.708, "timestamp": "06:10:35", "text": "你可以像尾巴一样……"}, {"type": "subtitle", "time": 22238.15, "timestamp": "06:10:38", "text": "Minecraft 里有龙尾巴之类的东西"}, {"type": "subtitle", "time": 22240.39, "timestamp": "06:10:40", "text": "比如什么"}, {"type": "subtitle", "time": 22242.47, "timestamp": "06:10:42", "text": "你可以拥有。好吧，问题是我可以"}, {"type": "subtitle", "time": 22245.59, "timestamp": "06:10:45", "text": "之前有很多东西。我当时"}, {"type": "subtitle", "time": 22247.27, "timestamp": "06:10:47", "text": "受限，因为很多人都是"}, {"type": "subtitle", "time": 22249.75, "timestamp": "06:10:49", "text": "和你一样，都是新人。所以这将非常"}, {"type": "subtitle", "time": 22255.19, "timestamp": "06:10:55", "text": "对她来说压力巨大。啊，没错。"}, {"type": "subtitle", "time": 22258.07, "timestamp": "06:10:58", "text": "我刚才说了，你是个新手。我"}]
[{"type": "subtitle", "time": 9427.87, "timestamp": "02:37:07", "text": "夜晚。现在我知道了一种温暖的方式"}, {"type": "subtitle", "time": 9431.429, "timestamp": "02:37:11", "text": "远方是我可以吹口哨唱完整首歌吗？"}, {"type": "subtitle", "time": 9434.07, "timestamp": "02:37:14", "text": "不唱歌？我会这么做。那是"}, {"type": "subtitle", "time": 9436.67, "timestamp": "02:37:16", "text": "更好的。我更喜欢"}, {"type": "subtitle", "time": 9448.63, "timestamp": "02:37:28", "text": "无需等待。好的，在哪里？"}, {"type": "subtitle", "time": 9450.03, "timestamp": "02:37:30", "text": "你在那儿"}, {"type": "subtitle", "time": 9452.03, "timestamp": "02:37:32", "text": "是。"}]
[{"type": "subtitle", "time": 21541.67, "timestamp": "05:59:01", "text": "其实我也不知道"}, {"type": "subtitle", "time": 21545.27, "timestamp": "05:59:05", "text": "那我就直接告诉我吧。我的天啊。不，"}, {"type": "subtitle", "time": 21547.51, "timestamp": "05:59:07", "text": "你会来救我的。把责任推给Yeah。"}, {"type": "subtitle", "time": 21550.99, "timestamp": "05:59:10", "text": "我会把责任都推到你身上，乔克。"}, {"type": "subtitle", "time": 21554.548, "timestamp": "05:59:14", "text": "为什么？我的天啊。"}, {"type": "subtitle", "time": 21557.91, "timestamp": "05:59:17", "text": "等等，等等，等等，等等，等等，等等。我"}, {"type": "subtitle", "time": 21559.43, "timestamp": "05:59:19", "text": "我有伐木工技能，所以我可以把它砍断。"}, {"type": "subtitle", "time": 21564.39, "timestamp": "05:59:24", "text": "一次。是的，我把任务搞砸了。"}, {"type": "subtitle", "time": 21567.11, "timestamp": "05:59:27", "text": "因为伐木工的缘故，这是个任务区域。我"}, {"type": "subtitle", "time": 21569.27, "timestamp": "05:59:29", "text": "感觉糟透了。"}, {"type": "subtitle", "time": 21572.948, "timestamp": "05:59:32", "text": "呃，猜猜怎么着？我弄坏了，我弄坏了，呃，德鲁的"}, {"type": "subtitle", "time": 21577.43, "timestamp": "05:59:37", "text": "根据。我的天啊。和"}, {"type": "subtitle", "time": 21580.31, "timestamp": "05:59:40", "text": "是的，然后我又召唤了一个新的。哇。"}, {"type": "subtitle", "time": 21582.31, "timestamp": "05:59:42", "text": "因为我们把它当作备用方案来使用。"}, {"type": "subtitle", "time": 21585.35, "timestamp": "05:59:45", "text": "版本。所以一切都好。是的。还，"}, {"type": "subtitle", "time": 21587.91, "timestamp": "05:59:47", "text": "下界星是什么？下界星"}, {"type": "subtitle", "time": 21591.83, "timestamp": "05:59:51", "text": "做？北极星之类的。所以，你就是。"}, {"type": "subtitle", "time": 21593.51, "timestamp": "05:59:53", "text": "好的。我告诉你。它会引导你"}, {"type": "subtitle", "time": 21597.11, "timestamp": "05:59:57", "text": "某处。查出。所以，这是件好事。"}]
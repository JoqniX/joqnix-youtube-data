[{"type": "subtitle", "time": 15180.75, "timestamp": "04:13:00", "text": "脊柱就是你必须要有的东西"}, {"type": "subtitle", "time": 15184.07, "timestamp": "04:13:04", "text": "攻击我。等等，等等，等等，等等。我们开始吧"}, {"type": "subtitle", "time": 15191.349, "timestamp": "04:13:11", "text": "一。等待。什么也没发生。我不是"}, {"type": "subtitle", "time": 15193.75, "timestamp": "04:13:13", "text": "瞎的。哦，我现在瞎了。哦，"}, {"type": "subtitle", "time": 15196.269, "timestamp": "04:13:16", "text": "四周一片漆黑。"}, {"type": "subtitle", "time": 15199.67, "timestamp": "04:13:19", "text": "黑暗。但我看不到你。我"}, {"type": "subtitle", "time": 15201.87, "timestamp": "04:13:21", "text": "虽然我看不见你。哦，"}, {"type": "subtitle", "time": 15232.75, "timestamp": "04:13:52", "text": "啊，我在哪里？"}]
[{"type": "subtitle", "time": 6241.91, "timestamp": "01:44:01", "text": "[音乐]"}, {"type": "subtitle", "time": 6244.83, "timestamp": "01:44:04", "text": "当我唱歌的时候，我会有这个"}, {"type": "subtitle", "time": 6247.79, "timestamp": "01:44:07", "text": "向上。我介意"}, {"type": "subtitle", "time": 6250.709, "timestamp": "01:44:10", "text": "它。我把它剪开，这样我就可以读了。"}, {"type": "subtitle", "time": 6255.31, "timestamp": "01:44:15", "text": "歌词。我们可以一起学习如何"}, {"type": "subtitle", "time": 6257.91, "timestamp": "01:44:17", "text": "闪亮的。哦，等等。我觉得我已经搞定了。"}, {"type": "subtitle", "time": 6260.59, "timestamp": "01:44:20", "text": "这个想法远比这更……"}, {"type": "subtitle", "time": 6263.99, "timestamp": "01:44:23", "text": "更好的。概念在哪里？我觉得我"}, {"type": "subtitle", "time": 6267.75, "timestamp": "01:44:27", "text": "我把所有正在学习的歌曲都移植过来了"}, {"type": "subtitle", "time": 6271.669, "timestamp": "01:44:31", "text": "为概念而歌唱。我相信我做到了。"}, {"type": "subtitle", "time": 6274.709, "timestamp": "01:44:34", "text": "我做过这件事吗？我做了吗？我做了吗？我做了吗？"}, {"type": "subtitle", "time": 6275.55, "timestamp": "01:44:35", "text": "做"}, {"type": "subtitle", "time": 6283.91, "timestamp": "01:44:43", "text": "它。钱币。我找不到它。我找不到"}]
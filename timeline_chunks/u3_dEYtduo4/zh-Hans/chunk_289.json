[{"type": "subtitle", "time": 17340.39, "timestamp": "04:49:00", "text": "问题是它消失了，因为"}, {"type": "subtitle", "time": 17342.43, "timestamp": "04:49:02", "text": "问题"}, {"type": "subtitle", "time": 17345.35, "timestamp": "04:49:05", "text": "等等，你是怎么弄到的？就像有人一样"}, {"type": "subtitle", "time": 17348.23, "timestamp": "04:49:08", "text": "给了它"}, {"type": "subtitle", "time": 17351.03, "timestamp": "04:49:11", "text": "另外，按照地图指示走是否值得？"}, {"type": "subtitle", "time": 17366.15, "timestamp": "04:49:26", "text": "还有塔宾，你知道，就像我发现的那种"}, {"type": "subtitle", "time": 17369.03, "timestamp": "04:49:29", "text": "很多墓地地图，就像……"}, {"type": "subtitle", "time": 17370.83, "timestamp": "04:49:30", "text": "很多东西都来自……"}, {"type": "subtitle", "time": 17373.948, "timestamp": "04:49:33", "text": "胸部。所以我就想"}, {"type": "subtitle", "time": 17378.23, "timestamp": "04:49:38", "text": "或许是宝藏之类的东西。我不"}, {"type": "subtitle", "time": 17380.55, "timestamp": "04:49:40", "text": "我不知道。"}, {"type": "subtitle", "time": 17383.03, "timestamp": "04:49:43", "text": "哦，瞧。树木正在消失。"}, {"type": "subtitle", "time": 17386.19, "timestamp": "04:49:46", "text": "哇，时间是……"}, {"type": "subtitle", "time": 17388.948, "timestamp": "04:49:48", "text": "移动。以前不会这样。"}, {"type": "subtitle", "time": 17391.19, "timestamp": "04:49:51", "text": "现在，"}, {"type": "subtitle", "time": 17393.91, "timestamp": "04:49:53", "text": "时间在流逝，这是件好事。"}, {"type": "subtitle", "time": 17396.67, "timestamp": "04:49:56", "text": "因为它非常非常"}]
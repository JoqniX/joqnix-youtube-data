[{"type": "subtitle", "time": 1741.549, "timestamp": "00:29:01", "text": "特别聊天。哦，不错。"}, {"type": "subtitle", "time": 1745.269, "timestamp": "00:29:05", "text": "好的。我得等他们。"}, {"type": "subtitle", "time": 1755.669, "timestamp": "00:29:15", "text": "呃，我得等等。是的，我点击了"}, {"type": "subtitle", "time": 1758.31, "timestamp": "00:29:18", "text": "按下启动按钮，它就启动了。"}, {"type": "subtitle", "time": 1766.71, "timestamp": "00:29:26", "text": "成员。他可以召集成千上万的人"}, {"type": "subtitle", "time": 1786.89, "timestamp": "00:29:46", "text": "有一笔款项。"}, {"type": "subtitle", "time": 1788.909, "timestamp": "00:29:48", "text": "[音乐]"}, {"type": "subtitle", "time": 1793.35, "timestamp": "00:29:53", "text": "临界点。所以支付门槛是100美元。"}, {"type": "subtitle", "time": 1794.83, "timestamp": "00:29:54", "text": "顺便一提。我"}, {"type": "subtitle", "time": 1798.389, "timestamp": "00:29:58", "text": "我觉得这个节目太棒了，看到这个我太高兴了。你"}]
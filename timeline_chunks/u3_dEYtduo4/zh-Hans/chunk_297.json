[{"type": "subtitle", "time": 17847.51, "timestamp": "04:57:27", "text": "你好。哦，你好。"}, {"type": "subtitle", "time": 17850.39, "timestamp": "04:57:30", "text": "是的，我在这里。我在这里。一秒钟。"}, {"type": "subtitle", "time": 17860.868, "timestamp": "04:57:40", "text": "什么？我不知道还可以升级。"}, {"type": "subtitle", "time": 17867.19, "timestamp": "04:57:47", "text": "好的。另外，你还有个铁匠铺"}, {"type": "subtitle", "time": 17875.51, "timestamp": "04:57:55", "text": "哦，那是和米特·米茨基的那个有关。"}, {"type": "subtitle", "time": 17878.628, "timestamp": "04:57:58", "text": "当时和米茨基的那个玩意儿在一起。所以，你把它说出来"}]
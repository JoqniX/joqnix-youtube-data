[{"type": "subtitle", "time": 666.74, "timestamp": "00:11:06", "text": "哑的。哦，我的"}, {"type": "subtitle", "time": 670.35, "timestamp": "00:11:10", "text": "[音乐]"}, {"type": "subtitle", "time": 673.55, "timestamp": "00:11:13", "text": "上帝。疼痛。我不能。"}, {"type": "subtitle", "time": 677.67, "timestamp": "00:11:17", "text": "哦，我们应该把它放在“我应该……”里。"}, {"type": "subtitle", "time": 679.43, "timestamp": "00:11:19", "text": "删除关卡 我应该删除这个关卡吗？"}, {"type": "subtitle", "time": 682.269, "timestamp": "00:11:22", "text": "我应该删除关卡然后重新开始吗？"}, {"type": "subtitle", "time": 684.389, "timestamp": "00:11:24", "text": "再次？我觉得我应该删除它"}, {"type": "subtitle", "time": 685.389, "timestamp": "00:11:25", "text": "等级。"}, {"type": "subtitle", "time": 688.069, "timestamp": "00:11:28", "text": "H，意思是表情符号，我们添加了"}, {"type": "subtitle", "time": 690.59, "timestamp": "00:11:30", "text": "一切。我得重做一遍。"}, {"type": "subtitle", "time": 693.949, "timestamp": "00:11:33", "text": "再次。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 703.99, "timestamp": "00:11:43", "text": "笨蛋。我的天哪。你个笨蛋。你个笨蛋"}, {"type": "subtitle", "time": 705.069, "timestamp": "00:11:45", "text": "[音乐]"}]
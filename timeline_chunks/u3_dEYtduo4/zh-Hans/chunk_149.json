[{"type": "subtitle", "time": 8940.71, "timestamp": "02:29:00", "text": "听起来纯粹是为了玩耍而感到满足。"}, {"type": "subtitle", "time": 8944.15, "timestamp": "02:29:04", "text": "把玩具放在一起。"}, {"type": "subtitle", "time": 8945.99, "timestamp": "02:29:05", "text": "也许我被成千上万的人刮过胡子"}, {"type": "subtitle", "time": 8956.309, "timestamp": "02:29:16", "text": "感谢您在Twitch上的关注。你好。"}, {"type": "subtitle", "time": 8957.83, "timestamp": "02:29:17", "text": "我们正在学一首歌。我想"}, {"type": "subtitle", "time": 8959.87, "timestamp": "02:29:19", "text": "唱歌。嘘"}, {"type": "subtitle", "time": 8966.91, "timestamp": "02:29:26", "text": "嘘。是等待，DJ。你扮演DJ"}, {"type": "subtitle", "time": 8969.429, "timestamp": "02:29:29", "text": "呃，你玩《凋零之浪》吧？你"}, {"type": "subtitle", "time": 8971.15, "timestamp": "02:29:31", "text": "可能看过这首歌"}, {"type": "subtitle", "time": 8974.309, "timestamp": "02:29:34", "text": "来自这个女孩。我忘了。"}, {"type": "subtitle", "time": 8978.59, "timestamp": "02:29:38", "text": "你能看到那个女孩吗？金发女孩。"}, {"type": "subtitle", "time": 8981.27, "timestamp": "02:29:41", "text": "嗯，对，就是那首歌。它在……"}, {"type": "subtitle", "time": 8991.309, "timestamp": "02:29:51", "text": "猜测。看看"}, {"type": "subtitle", "time": 8994.389, "timestamp": "02:29:54", "text": "她。对，这是她的歌。这是她的主题"}, {"type": "subtitle", "time": 8997.349, "timestamp": "02:29:57", "text": "我猜大概是首歌之类的吧。它在……"}, {"type": "subtitle", "time": 8999.19, "timestamp": "02:29:59", "text": "我相信游戏里有这个功能。它是"}]
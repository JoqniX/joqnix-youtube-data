[{"type": "subtitle", "time": 22082.07, "timestamp": "06:08:02", "text": "你想要一块巧克力作为奖励吗？"}, {"type": "subtitle", "time": 22088.868, "timestamp": "06:08:08", "text": "现在。但不要死。我的饼干。我的"}, {"type": "subtitle", "time": 22092.75, "timestamp": "06:08:12", "text": "饼干没了。"}, {"type": "subtitle", "time": 22101.51, "timestamp": "06:08:21", "text": "不，我吃了。哦，你把它吃了。"}, {"type": "subtitle", "time": 22119.27, "timestamp": "06:08:39", "text": "您可以部署。你可以部署一个竞赛。"}, {"type": "subtitle", "time": 22120.788, "timestamp": "06:08:40", "text": "好的。"}, {"type": "subtitle", "time": 22126.99, "timestamp": "06:08:46", "text": "三、二、三，开始。我的天哪。"}]
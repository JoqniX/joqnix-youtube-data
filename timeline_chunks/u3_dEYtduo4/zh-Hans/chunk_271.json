[{"type": "subtitle", "time": 16260.63, "timestamp": "04:31:00", "text": "我得去看看预告片。"}, {"type": "subtitle", "time": 16264.389, "timestamp": "04:31:04", "text": "再次。相同的。我想知道。看这里"}, {"type": "subtitle", "time": 16268.469, "timestamp": "04:31:08", "text": "这边那个人。什么？他做什么的？"}, {"type": "subtitle", "time": 16278.63, "timestamp": "04:31:18", "text": "你看，我车上有乘客。他好可爱。"}, {"type": "subtitle", "time": 16292.389, "timestamp": "04:31:32", "text": "先生，您是做什么的？"}, {"type": "subtitle", "time": 16295.03, "timestamp": "04:31:35", "text": "你看，你选了最没用的怪物。"}, {"type": "subtitle", "time": 16296.63, "timestamp": "04:31:36", "text": "曾经。"}, {"type": "subtitle", "time": 16298.79, "timestamp": "04:31:38", "text": "我的意思是，如果你想要牛，我就去绑架。"}, {"type": "subtitle", "time": 16299.87, "timestamp": "04:31:39", "text": "一个"}, {"type": "subtitle", "time": 16307.03, "timestamp": "04:31:47", "text": "不。啊，抱歉。但我速度很慢。我"}, {"type": "subtitle", "time": 16308.71, "timestamp": "04:31:48", "text": "不在乎。"}, {"type": "subtitle", "time": 16311.83, "timestamp": "04:31:51", "text": "我是在开玩笑。好的。另一个在哪儿？"}, {"type": "subtitle", "time": 16312.95, "timestamp": "04:31:52", "text": "另一个在哪儿？我们必须"}, {"type": "subtitle", "time": 16316.189, "timestamp": "04:31:56", "text": "保护我，保护我们珍贵的"}, {"type": "subtitle", "time": 16318.87, "timestamp": "04:31:58", "text": "客人。可爱的孩子们。这些还是孩子。"}]
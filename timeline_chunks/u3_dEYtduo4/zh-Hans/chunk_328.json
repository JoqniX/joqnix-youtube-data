[{"type": "subtitle", "time": 19680.628, "timestamp": "05:28:00", "text": "两种移动方式和滑动方式"}, {"type": "subtitle", "time": 19683.628, "timestamp": "05:28:03", "text": "也非常好，你看我"}, {"type": "subtitle", "time": 19689.31, "timestamp": "05:28:09", "text": "向右滑动，但如果我得到这个"}, {"type": "subtitle", "time": 19704.43, "timestamp": "05:28:24", "text": "好的。我是否已经有运动了"}, {"type": "subtitle", "time": 19707.11, "timestamp": "05:28:27", "text": "优势？我的意思是，当然，拥有"}, {"type": "subtitle", "time": 19719.43, "timestamp": "05:28:39", "text": "但有时我会遇到困难，"}, {"type": "subtitle", "time": 19724.15, "timestamp": "05:28:44", "text": "我听不见你说话。哦，你好。"}, {"type": "subtitle", "time": 19726.91, "timestamp": "05:28:46", "text": "嗨，乔。"}, {"type": "subtitle", "time": 19730.948, "timestamp": "05:28:50", "text": "你好。我很好。"}, {"type": "subtitle", "time": 19732.708, "timestamp": "05:28:52", "text": "你好吗？"}, {"type": "subtitle", "time": 19733.548, "timestamp": "05:28:53", "text": "我是"}, {"type": "subtitle", "time": 19737.83, "timestamp": "05:28:57", "text": "我昨天哭过，但我现在很开心。"}]
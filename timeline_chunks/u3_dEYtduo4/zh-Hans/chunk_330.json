[{"type": "subtitle", "time": 19802.47, "timestamp": "05:30:02", "text": "背包。您可以存放更多物品。"}, {"type": "subtitle", "time": 19806.31, "timestamp": "05:30:06", "text": "把它放进你的手臂护甲里。这"}, {"type": "subtitle", "time": 19808.47, "timestamp": "05:30:08", "text": "胸甲。还会有一个名额。"}, {"type": "subtitle", "time": 19816.708, "timestamp": "05:30:16", "text": "那里。你收到了吗？"}, {"type": "subtitle", "time": 19820.708, "timestamp": "05:30:20", "text": "我该怎么把它背在背上？呃，你"}, {"type": "subtitle", "time": 19823.43, "timestamp": "05:30:23", "text": "把它放在你的盔甲上。还有第二个"}, {"type": "subtitle", "time": 19826.47, "timestamp": "05:30:26", "text": "盔甲胸甲上的插槽。哦，"}, {"type": "subtitle", "time": 19828.788, "timestamp": "05:30:28", "text": "好的。好的。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 19832.47, "timestamp": "05:30:32", "text": "是的。然后你按下“是”。是的。"}, {"type": "subtitle", "time": 19835.51, "timestamp": "05:30:35", "text": "耶。好的。按键盘上的 B 键"}, {"type": "subtitle", "time": 19838.708, "timestamp": "05:30:38", "text": "把背包拿过来。"}, {"type": "subtitle", "time": 19842.15, "timestamp": "05:30:42", "text": "啊，我明白了。所以，我可以在这里放东西。"}, {"type": "subtitle", "time": 19850.99, "timestamp": "05:30:50", "text": "埃斯特拉就在你身后。是的。"}]
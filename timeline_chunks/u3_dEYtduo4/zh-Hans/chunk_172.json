[{"type": "subtitle", "time": 10322.51, "timestamp": "02:52:02", "text": "我的天啊。神椿依然是疯子"}, {"type": "subtitle", "time": 10349.07, "timestamp": "02:52:29", "text": "该死。这就像老派嘻哈音乐"}, {"type": "subtitle", "time": 10353.06, "timestamp": "02:52:33", "text": "类型，但日本嘻哈"}, {"type": "subtitle", "time": 10354.429, "timestamp": "02:52:34", "text": "[音乐]"}]
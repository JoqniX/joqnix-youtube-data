[{"type": "subtitle", "time": 14580.55, "timestamp": "04:03:00", "text": "上帝。阿斯特拉。我的天啊。看。好了，各位。"}, {"type": "subtitle", "time": 14582.15, "timestamp": "04:03:02", "text": "我们要进入我的世界模式。"}, {"type": "subtitle", "time": 14589.99, "timestamp": "04:03:09", "text": "[音乐]"}, {"type": "subtitle", "time": 14604.64, "timestamp": "04:03:24", "text": "我的钥匙是龙"}]
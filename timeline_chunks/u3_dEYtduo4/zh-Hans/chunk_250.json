[{"type": "subtitle", "time": 15001.51, "timestamp": "04:10:01", "text": "成堆的面包。顺便说一下，还有我我我"}, {"type": "subtitle", "time": 15004.389, "timestamp": "04:10:04", "text": "直播即将结束。你想要"}, {"type": "subtitle", "time": 15007.75, "timestamp": "04:10:07", "text": "溪流？我现在正在直播。"}, {"type": "subtitle", "time": 15010.15, "timestamp": "04:10:10", "text": "哦，等等。你现在正在观看流媒体吗？"}, {"type": "subtitle", "time": 15012.229, "timestamp": "04:10:12", "text": "是的。你不知道吗？不。你好。"}, {"type": "subtitle", "time": 15019.189, "timestamp": "04:10:19", "text": "扎克。我当时太专注于我的……"}, {"type": "subtitle", "time": 15022.11, "timestamp": "04:10:22", "text": "直播和唱歌"}, {"type": "subtitle", "time": 15025.429, "timestamp": "04:10:25", "text": "一切。没问题。我当时真是太"}, {"type": "subtitle", "time": 15028.469, "timestamp": "04:10:28", "text": "不过很高兴。我不知道为什么。最后"}, {"type": "subtitle", "time": 15031.349, "timestamp": "04:10:31", "text": "已获得会员资格。我当时就想，伙计，咱们走吧"}, {"type": "subtitle", "time": 15033.99, "timestamp": "04:10:33", "text": "去。还是没明白，但我很"}, {"type": "subtitle", "time": 15035.91, "timestamp": "04:10:35", "text": "很高兴你得到了，因为你努力了。"}, {"type": "subtitle", "time": 15037.87, "timestamp": "04:10:37", "text": "难的。"}, {"type": "subtitle", "time": 15049.99, "timestamp": "04:10:49", "text": "更新所有内容的方式是添加的"}, {"type": "subtitle", "time": 15052.309, "timestamp": "04:10:52", "text": "在服务器上，我就想，我不想……"}, {"type": "subtitle", "time": 15055.349, "timestamp": "04:10:55", "text": "睡眠时带IO。它太好了，以至于有"}, {"type": "subtitle", "time": 15059.51, "timestamp": "04:10:59", "text": "现在背上背包。我的天啊。我输了"}]
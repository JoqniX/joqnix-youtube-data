[{"type": "subtitle", "time": 15120.71, "timestamp": "04:12:00", "text": "但现在我们失去了一切，所以……"}, {"type": "subtitle", "time": 15122.55, "timestamp": "04:12:02", "text": "没意义。"}, {"type": "subtitle", "time": 15126.349, "timestamp": "04:12:06", "text": "是的，没错。那是"}, {"type": "subtitle", "time": 15133.269, "timestamp": "04:12:13", "text": "呃，我要问很多……"}, {"type": "subtitle", "time": 15136.87, "timestamp": "04:12:16", "text": "他提供的魔法书。什么？"}, {"type": "subtitle", "time": 15138.95, "timestamp": "04:12:18", "text": "因为我失去了很多附魔，"}, {"type": "subtitle", "time": 15144.63, "timestamp": "04:12:24", "text": "哦，等等。你也被迷住了"}, {"type": "subtitle", "time": 15147.51, "timestamp": "04:12:27", "text": "水平问题。"}, {"type": "subtitle", "time": 15150.389, "timestamp": "04:12:30", "text": "什么级别的问题？什么是液位问题？"}, {"type": "subtitle", "time": 15152.71, "timestamp": "04:12:32", "text": "是啊，你需要等级，对吧？哦，还有"}, {"type": "subtitle", "time": 15154.67, "timestamp": "04:12:34", "text": "某物。非常容易"}, {"type": "subtitle", "time": 15159.51, "timestamp": "04:12:39", "text": "建造。所以，尽管来攻击我吧。攻击"}, {"type": "subtitle", "time": 15162.15, "timestamp": "04:12:42", "text": "我。我想尝试一些新东西。嘿，让我"}, {"type": "subtitle", "time": 15168.469, "timestamp": "04:12:48", "text": "先生，您自己感觉有什么变化吗？"}, {"type": "subtitle", "time": 15171.55, "timestamp": "04:12:51", "text": "不，等等，让我拿把斧子。不，"}, {"type": "subtitle", "time": 15174.55, "timestamp": "04:12:54", "text": "铲。什么也没发生。"}, {"type": "subtitle", "time": 15178.63, "timestamp": "04:12:58", "text": "那么典狱长的脊椎就没用了。呃，典狱长"}]
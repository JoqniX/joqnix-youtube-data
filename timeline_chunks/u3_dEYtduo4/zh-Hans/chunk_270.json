[{"type": "subtitle", "time": 16200.469, "timestamp": "04:30:00", "text": "更好的选择。哦，我为什么没有"}, {"type": "subtitle", "time": 16203.11, "timestamp": "04:30:03", "text": "认真做？顺便一提，阿斯特拉不得不"}, {"type": "subtitle", "time": 16210.309, "timestamp": "04:30:10", "text": "嗯？什么？"}, {"type": "subtitle", "time": 16211.55, "timestamp": "04:30:11", "text": "给予"}, {"type": "subtitle", "time": 16215.59, "timestamp": "04:30:15", "text": "现在暴民来了。哦，他给了我们两个暴徒或"}, {"type": "subtitle", "time": 16217.99, "timestamp": "04:30:17", "text": "黏土傀儡中的某些东西"}, {"type": "subtitle", "time": 16219.83, "timestamp": "04:30:19", "text": "某物。"}, {"type": "subtitle", "time": 16222.95, "timestamp": "04:30:22", "text": "你想要哪一个？我认为我们应该"}, {"type": "subtitle", "time": 16227.59, "timestamp": "04:30:27", "text": "像牛一样去吧。什么牛？什么？"}, {"type": "subtitle", "time": 16231.429, "timestamp": "04:30:31", "text": "告诉我他说了什么？"}, {"type": "subtitle", "time": 16234.63, "timestamp": "04:30:34", "text": "魔像完全没用。铜魔像"}, {"type": "subtitle", "time": 16237.429, "timestamp": "04:30:37", "text": "毫无用处。咱们就跟着牛走吧，因为"}, {"type": "subtitle", "time": 16239.91, "timestamp": "04:30:39", "text": "你可以让母牛繁殖。"}, {"type": "subtitle", "time": 16243.11, "timestamp": "04:30:43", "text": "奶牛。我们这里牛比较多。铜"}, {"type": "subtitle", "time": 16245.59, "timestamp": "04:30:45", "text": "不过，魔像确实比怪物酷炫。我们有了"}, {"type": "subtitle", "time": 16248.229, "timestamp": "04:30:48", "text": "尽管。问题是它根本没用。"}, {"type": "subtitle", "time": 16250.51, "timestamp": "04:30:50", "text": "随它去。我们可以让人们参与进来"}, {"type": "subtitle", "time": 16258.55, "timestamp": "04:30:58", "text": "那是什么？东西在哪儿？"}]
[{"type": "subtitle", "time": 35764.07, "timestamp": "09:56:04", "text": "我已經很久沒有旅行了"}, {"type": "subtitle", "time": 35768.47, "timestamp": "09:56:08", "text": "。  等等，"}, {"type": "subtitle", "time": 35777.586, "timestamp": "09:56:17", "text": "我上次旅行是什麼時候？  我覺得"}, {"type": "subtitle", "time": 35780.63, "timestamp": "09:56:20", "text": "我旅行的次數不多。"}, {"type": "subtitle", "time": 35795.51, "timestamp": "09:56:35", "text": "我已經兩三年沒旅行了。所以，這將是我這麼多年來第一次和家人一起旅行。所以，我很興奮。所以，我將於24日清晨出發。是的"}, {"type": "subtitle", "time": 35803.83, "timestamp": "09:56:43", "text": "。  嗯"}, {"type": "subtitle", "time": 35809.746, "timestamp": "09:56:49", "text": "，我明天一早就出發，大概26號回來吧"}, {"type": "subtitle", "time": 35812.47, "timestamp": "09:56:52", "text": "。是的，26號。那我26號就回來了。  [音樂] 嗯"}]
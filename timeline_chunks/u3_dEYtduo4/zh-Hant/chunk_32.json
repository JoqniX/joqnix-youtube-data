[{"type": "subtitle", "time": 1931.35, "timestamp": "00:32:11", "text": "。但我必須小心。是的。你說得對。是的。是的。  是的。  是的。僅限會員線上聊天。"}, {"type": "subtitle", "time": 1933.75, "timestamp": "00:32:13", "text": "我不知道該怎麼辦。我想做"}, {"type": "subtitle", "time": 1936.47, "timestamp": "00:32:16", "text": "直播，但我覺得我"}, {"type": "subtitle", "time": 1939.789, "timestamp": "00:32:19", "text": "可能不會做。問題是，我並不認為我會搞會員專屬那一套。"}, {"type": "subtitle", "time": 1960.149, "timestamp": "00:32:40", "text": "我不知道現在該怎麼辦，這確實是個"}, {"type": "subtitle", "time": 1979.35, "timestamp": "00:32:59", "text": "問題。"}]
[{"type": "subtitle", "time": 26535.51, "timestamp": "07:22:15", "text": "。  好了，我累了。  你需要睡覺。為什麼醒著？  你該睡覺了。哦，是的。呃，睡覺。  我忘了鐮刀。不是鐮刀。那血流成河的景象。"}, {"type": "subtitle", "time": 26538.07, "timestamp": "07:22:18", "text": "那是我的獨特之處"}, {"type": "subtitle", "time": 26539.35, "timestamp": "07:22:19", "text": "。"}, {"type": "subtitle", "time": 26541.91, "timestamp": "07:22:21", "text": "我忘了"}, {"type": "chat", "time": 26576.951, "timestamp": "07:22:56", "author": "@myself_lostkid", "avatar": "https://yt4.ggpht.com/DutRWyzqfw4DHLMg2yazBW0gzopTU4iTKRzen-XCZ2cqt2Gfe0GhPOl1vG4yGNDQTNXhMVMm7w=s64-c-k-c0x00ffffff-no-rj", "message": "joq and his tales of finding a desert"}]
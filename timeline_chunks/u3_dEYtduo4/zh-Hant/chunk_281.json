[{"type": "subtitle", "time": 16888.948, "timestamp": "04:41:28", "text": "升級背包。搞什麼鬼？噓。加水和其他東西。好的。  阿斯特拉"}, {"type": "subtitle", "time": 16890.948, "timestamp": "04:41:30", "text": "走了嗎？"}, {"type": "subtitle", "time": 16894.15, "timestamp": "04:41:34", "text": "他會回來的"}, {"type": "subtitle", "time": 16896.868, "timestamp": "04:41:36", "text": "。"}, {"type": "subtitle", "time": 16903.83, "timestamp": "04:41:43", "text": "讓我截個圖，看看我的庫存情況。好的，我一會兒就回來（音樂）。"}]
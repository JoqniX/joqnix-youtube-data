[{"type": "subtitle", "time": 31024.99, "timestamp": "08:37:04", "text": "是的。你知道嗎？我"}, {"type": "subtitle", "time": 31030.67, "timestamp": "08:37:10", "text": "想我該睡覺了。是的。你現在急需一條輪胎。再見"}, {"type": "subtitle", "time": 31035.43, "timestamp": "08:37:15", "text": "，各位。你好。再見。晚安。再見。  我"}, {"type": "subtitle", "time": 31038.788, "timestamp": "08:37:18", "text": "現在要走了。我的天哪。晚安。再見。再見。你也應該睡覺。"}, {"type": "subtitle", "time": 31067.388, "timestamp": "08:37:47", "text": "好的。再見。再見。  再見。"}]
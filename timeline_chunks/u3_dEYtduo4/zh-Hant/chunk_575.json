[{"type": "subtitle", "time": 34508.07, "timestamp": "09:35:08", "text": "問題。是玩家延遲了。我的天啊。我是蜘蛛人。"}, {"type": "subtitle", "time": 34536.51, "timestamp": "09:35:36", "text": "哦，我去哪裡了？"}, {"type": "subtitle", "time": 34553.07, "timestamp": "09:35:53", "text": "我何時才能見到？但我只有一株"}, {"type": "subtitle", "time": 34554.67, "timestamp": "09:35:54", "text": "仙人掌而已。哦"}]
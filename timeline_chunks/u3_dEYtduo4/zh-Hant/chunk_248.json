[{"type": "subtitle", "time": 14891.349, "timestamp": "04:08:11", "text": "我稍後會加入。下載"}, {"type": "subtitle", "time": 14895.03, "timestamp": "04:08:15", "text": "電路板。  好的。呃，我和納穆爾都不太擅長學習。沒關係。自從那個雙馬尾女士出現後，我就再也沒玩過"}, {"type": "subtitle", "time": 14901.59, "timestamp": "04:08:21", "text": "Vuva了。那個紅頭髮、"}, {"type": "subtitle", "time": 14904.55, "timestamp": "04:08:24", "text": "呃，還有那個扎著紅白雙馬尾的女士來了。我沒玩過。拿到"}, {"type": "subtitle", "time": 14912.91, "timestamp": "04:08:32", "text": "海岸守護者之後，我就不玩這個遊戲了，真的。"}, {"type": "subtitle", "time": 14921.83, "timestamp": "04:08:41", "text": "我喜歡海岸守護者。她是"}, {"type": "subtitle", "time": 14924.55, "timestamp": "04:08:44", "text": "夏威夷。"}]
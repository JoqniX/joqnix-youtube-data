[{"type": "subtitle", "time": 36799.426, "timestamp": "10:13:19", "text": "？我在我的小號上發了推特。嗯，"}, {"type": "subtitle", "time": 36806.87, "timestamp": "10:13:26", "text": "我當時以為我的考試是在下午，所以"}, {"type": "subtitle", "time": 36810.03, "timestamp": "10:13:30", "text": "在准考證公開之前，或者說在我拿到准考證之前，我用了一個網站來預測考試日期和時間。"}, {"type": "subtitle", "time": 36816.906, "timestamp": "10:13:36", "text": "好吧。因為"}]
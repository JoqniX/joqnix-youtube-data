[{"type": "subtitle", "time": 34569.71, "timestamp": "09:36:09", "text": "，只有一棵仙人掌。哦，等等。末影人來了。  我應該直接殺了他，然後得到"}, {"type": "subtitle", "time": 34573.746, "timestamp": "09:36:13", "text": "我聽到的末影人聲音嗎？那個怪人。我想要"}, {"type": "subtitle", "time": 34579.63, "timestamp": "09:36:19", "text": "這顆珍珠，對吧？  用於升級。他在哪裡？"}, {"type": "subtitle", "time": 34587.266, "timestamp": "09:36:27", "text": "我剛才聽到他說話了。他在哪裡？"}]
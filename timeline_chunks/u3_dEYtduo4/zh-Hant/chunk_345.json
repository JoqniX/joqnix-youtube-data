[{"type": "subtitle", "time": 20704.75, "timestamp": "05:45:04", "text": "。測試錯了。哦，這"}, {"type": "subtitle", "time": 20721.11, "timestamp": "05:45:21", "text": "是什麼？擊退和真正的旋轉實際上對良好的移動很有幫助。 [音樂] 是的。好的，這是一個。 [音樂] 呃，但是鑽石鎬。我完全可以要熔岩。你們記得我丟了鑽石鎬，對吧"}, {"type": "subtitle", "time": 20724.43, "timestamp": "05:45:24", "text": "？熔岩可以做到這一點。好的。斧頭、伐木工、鏟子"}, {"type": "subtitle", "time": 20726.708, "timestamp": "05:45:26", "text": "。我有什麼"}, {"type": "subtitle", "time": 20738.19, "timestamp": "05:45:38", "text": "？舀更多。更多藍色水滴。我想呃，我其實應該去瞄準鏡"}]
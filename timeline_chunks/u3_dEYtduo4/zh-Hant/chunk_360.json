[{"type": "subtitle", "time": 21602.708, "timestamp": "06:00:02", "text": "我不知道。嘿，"}, {"type": "subtitle", "time": 21606.39, "timestamp": "06:00:06", "text": "你怎麼坐的？你右鍵點擊。樓梯。右鍵點擊樓梯。對。過來坐。你等等。你看起來很可愛。等等，讓我截圖"}, {"type": "subtitle", "time": 21645.83, "timestamp": "06:00:45", "text": "嗯，右鍵點擊，右鍵點擊，右鍵點擊樓梯，右鍵點擊，滑鼠，右鍵點擊。對了，我忘了"}, {"type": "subtitle", "time": 21658.628, "timestamp": "06:00:58", "text": "小丑網站了。我弄丟了。我的天啊，我也坐著。該死。你想讓我截"}]
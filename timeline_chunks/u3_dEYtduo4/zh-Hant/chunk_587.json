[{"type": "subtitle", "time": 35222.47, "timestamp": "09:47:02", "text": "響起"}, {"type": "subtitle", "time": 35232.51, "timestamp": "09:47:12", "text": "哦，好吧。  我的"}, {"type": "subtitle", "time": 35238.55, "timestamp": "09:47:18", "text": "天啊。我什麼時候才能看到這邊的狀況？哦，金色基礎劍。  這就是他們所說的沼澤嗎？我還沒看過仙人掌（音樂）死去。我"}, {"type": "subtitle", "time": 35242.07, "timestamp": "09:47:22", "text": "的手指"}, {"type": "subtitle", "time": 35257.99, "timestamp": "09:47:37", "text": "好痛，[音樂]人。"}]
[{"type": "subtitle", "time": 22441.59, "timestamp": "06:14:01", "text": "，拜託。"}, {"type": "subtitle", "time": 22450.47, "timestamp": "06:14:10", "text": "咱們做點正事吧。 [音樂] 哦，哇。什麼？什麼？什麼？什麼？那是什麼？那是謊言。那是謊言。是啊。"}, {"type": "subtitle", "time": 22460.27, "timestamp": "06:14:20", "text": "我的天。你們倆。 [音樂] 為什麼驢子在笑？"}, {"type": "subtitle", "time": 22471.948, "timestamp": "06:14:31", "text": "哦。"}]
[{"type": "subtitle", "time": 30301.868, "timestamp": "08:25:01", "text": "很好。我的天啊。這就是"}, {"type": "subtitle", "time": 30333.628, "timestamp": "08:25:33", "text": "我為什麼說你應該在這個遊戲中加入表情動作的原因。  我會查一下。我會查一下。  一定要堅持住。  一定。不。我的天哪。該死。"}, {"type": "subtitle", "time": 30339.19, "timestamp": "08:25:39", "text": "哦，我收到了鮮花。我喜歡字體。"}, {"type": "subtitle", "time": 30347.23, "timestamp": "08:25:47", "text": "我找不到。我想它應該在我的盒子裡。  嘿，你為什麼"}, {"type": "subtitle", "time": 30350.43, "timestamp": "08:25:50", "text": "停下來了？繼續。  我的天啊"}]
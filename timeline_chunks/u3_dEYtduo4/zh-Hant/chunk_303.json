[{"type": "subtitle", "time": 18188.07, "timestamp": "05:03:08", "text": "那是什麼？"}, {"type": "subtitle", "time": 18190.07, "timestamp": "05:03:10", "text": "東西在哪兒？  我得再去看一下預告片。相同的"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "。我想知道。看看這邊這個人。什麼？"}, {"type": "subtitle", "time": 18215.67, "timestamp": "05:03:35", "text": "他做什麼的？"}, {"type": "subtitle", "time": 18218.11, "timestamp": "05:03:38", "text": "沒有什麼。他已經給了我一個眼神，意思是“我這兒有乘客”"}, {"type": "subtitle", "time": 18220.47, "timestamp": "05:03:40", "text": "。他好可愛。"}]
[{"type": "subtitle", "time": 21430.31, "timestamp": "05:57:10", "text": "。我喜歡。他們現在重新整理了所有東西。看看我有什麼"}, {"type": "subtitle", "time": 21434.23, "timestamp": "05:57:14", "text": "。所以，我需要熔岩。呃"}, {"type": "subtitle", "time": 21445.99, "timestamp": "05:57:25", "text": "你"}, {"type": "subtitle", "time": 21448.47, "timestamp": "05:57:28", "text": "現在需要"}, {"type": "subtitle", "time": 21469.99, "timestamp": "05:57:49", "text": "什麼？這個熔岩。喬，你可以在背包裡儲存很多水、熔岩或牛奶。但是桶子。升級是怎麼運作的？呃，你得自己琢磨。等等，你需要熔岩。等等，你需要什麼"}, {"type": "subtitle", "time": 21471.91, "timestamp": "05:57:51", "text": "？熔岩。熔岩。對。等等，等等，等一下。你怎麼還沒死？那是捲軸武器。"}]
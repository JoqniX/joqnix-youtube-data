[{"type": "subtitle", "time": 18123.788, "timestamp": "05:02:03", "text": "，在那之前"}, {"type": "subtitle", "time": 18135.91, "timestamp": "05:02:15", "text": "你想做什麼都可以，我"}, {"type": "subtitle", "time": 18153.67, "timestamp": "05:02:33", "text": "我們應該像牛一樣。什麼牛？什麼？  告訴我他說了什麼"}, {"type": "subtitle", "time": 18157.27, "timestamp": "05:02:37", "text": "？  魔"}, {"type": "subtitle", "time": 18159.83, "timestamp": "05:02:39", "text": "像完全沒用。"}, {"type": "subtitle", "time": 18168.47, "timestamp": "05:02:48", "text": "多。銅魔像確實更酷。我們有。問題是它根本沒用。  隨它去。我們可以讓人們待在我們這裡，"}, {"type": "subtitle", "time": 18171.75, "timestamp": "05:02:51", "text": "並使用"}, {"type": "subtitle", "time": 18174.83, "timestamp": "05:02:54", "text": "電腦。"}]
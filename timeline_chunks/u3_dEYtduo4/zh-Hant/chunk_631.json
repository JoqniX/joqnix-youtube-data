[{"type": "subtitle", "time": 37895.31, "timestamp": "10:31:35", "text": "音樂]所以，是的"}, {"type": "subtitle", "time": 37899.11, "timestamp": "10:31:39", "text": "。的官方語言，例如日語、漢語和韓語"}, {"type": "subtitle", "time": 37903.586, "timestamp": "10:31:43", "text": "。利的話，我最終就能去那裡了。就是和我在學院裡跟其他日語學習的學生一起上的課。"}, {"type": "subtitle", "time": 37908.23, "timestamp": "10:31:48", "text": "飯，你們必須分享食物，必須融入其中"}, {"type": "subtitle", "time": 37913.99, "timestamp": "10:31:53", "text": "。下午1點午休。沒等任何人。 。等等"}]
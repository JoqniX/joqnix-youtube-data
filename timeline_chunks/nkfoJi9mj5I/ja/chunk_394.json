[{"type": "subtitle", "time": 23641.35, "timestamp": "06:34:01", "text": "ゲームって時々そういうものだよね。 はい。"}, {"type": "subtitle", "time": 23643.91, "timestamp": "06:34:03", "text": "そしてこのゲームに限って言えば、"}, {"type": "subtitle", "time": 23646.788, "timestamp": "06:34:06", "text": "時間が経つのを忘れてしまうほどだ"}, {"type": "subtitle", "time": 23673.03, "timestamp": "06:34:33", "text": "あのね？ 私は彼を殺します。 実は、"}, {"type": "subtitle", "time": 23678.708, "timestamp": "06:34:38", "text": "これが理由です。"}, {"type": "subtitle", "time": 23683.35, "timestamp": "06:34:43", "text": "よし、宝箱を手に入れたから、家に帰れる。"}, {"type": "subtitle", "time": 23689.51, "timestamp": "06:34:49", "text": "わあ。"}, {"type": "subtitle", "time": 23693.91, "timestamp": "06:34:53", "text": "バイバイ。 そうそう。 私はその授業の一つを受けました"}, {"type": "subtitle", "time": 23695.83, "timestamp": "06:34:55", "text": "。"}]
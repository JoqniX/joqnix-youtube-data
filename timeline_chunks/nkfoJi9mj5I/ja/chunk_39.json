[{"type": "subtitle", "time": 2352.47, "timestamp": "00:39:12", "text": "エンツォ。 実際、私は"}, {"type": "subtitle", "time": 2369.43, "timestamp": "00:39:29", "text": "箱まで戻ってください。"}, {"type": "subtitle", "time": 2371.91, "timestamp": "00:39:31", "text": "モンスターの山を開ける。 木の下にいる新しいモンスターを見つけよう"}, {"type": "subtitle", "time": 2375.51, "timestamp": "00:39:35", "text": "。 同じように。 新鮮な"}, {"type": "subtitle", "time": 2384.069, "timestamp": "00:39:44", "text": "木の下で。"}]
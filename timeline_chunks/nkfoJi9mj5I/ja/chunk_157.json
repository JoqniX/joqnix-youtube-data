[{"type": "subtitle", "time": 9453.11, "timestamp": "02:37:33", "text": "待って、彼はどこに行ったの？"}, {"type": "subtitle", "time": 9468.55, "timestamp": "02:37:48", "text": "兄弟。 クエストに失敗しました。"}, {"type": "subtitle", "time": 9474.469, "timestamp": "02:37:54", "text": "いや、だめ、だめ、だめ、だめ、だめ、だめ、だめ、だめ、だめ"}, {"type": "subtitle", "time": 9477.51, "timestamp": "02:37:57", "text": "、だめ、だめ。"}, {"type": "subtitle", "time": 9479.59, "timestamp": "02:37:59", "text": "くそっ。 あれは遭遇クエストだったんだよ、まったく"}]
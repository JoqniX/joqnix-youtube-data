[{"type": "subtitle", "time": 23700.868, "timestamp": "06:35:00", "text": "戦略、戦略、戦略、戦略、"}, {"type": "subtitle", "time": 23703.91, "timestamp": "06:35:03", "text": "戦略的な剣。 ああ、なんて"}, {"type": "subtitle", "time": 23706.948, "timestamp": "06:35:06", "text": "発音しにくいんだろう。 何てことだ。"}, {"type": "subtitle", "time": 23709.43, "timestamp": "06:35:09", "text": "Stra戦略。   何てことだ"}, {"type": "subtitle", "time": 23713.51, "timestamp": "06:35:13", "text": "。 それって何ていう名前でしたっけ？"}, {"type": "subtitle", "time": 23717.99, "timestamp": "06:35:17", "text": "str戦略の剣とは何ですか。   わかった"}, {"type": "subtitle", "time": 23719.83, "timestamp": "06:35:19", "text": "。"}, {"type": "subtitle", "time": 23731.19, "timestamp": "06:35:31", "text": "普段はこういうゲームはやらないんだ"}, {"type": "subtitle", "time": 23733.03, "timestamp": "06:35:33", "text": "けど、無料だから試してみたかったんだ。"}, {"type": "subtitle", "time": 23736.31, "timestamp": "06:35:36", "text": "はい、無料です。 原"}, {"type": "subtitle", "time": 23740.548, "timestamp": "06:35:40", "text": "神とかアサシンクリードとか、あと"}, {"type": "subtitle", "time": 23743.03, "timestamp": "06:35:43", "text": "エルダーリングとかみたいな感じですね。"}, {"type": "subtitle", "time": 23745.83, "timestamp": "06:35:45", "text": "これら全てのゲームは、まるで子供を産んだかのようだ。"}, {"type": "subtitle", "time": 23753.11, "timestamp": "06:35:53", "text": "しかも無料です。 信じられますか？ それと、"}, {"type": "subtitle", "time": 23755.99, "timestamp": "06:35:55", "text": "ガチャのやつ。"}, {"type": "subtitle", "time": 23759.83, "timestamp": "06:35:59", "text": "彼らが持っているのは化粧品だけだ。"}]
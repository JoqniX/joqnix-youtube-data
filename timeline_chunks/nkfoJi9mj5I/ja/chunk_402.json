[{"type": "subtitle", "time": 24121.75, "timestamp": "06:42:01", "text": "皆さん、はじめまして。"}, {"type": "subtitle", "time": 24124.572, "timestamp": "06:42:04", "text": "私たちはまだこのゲームを続けているんですよ"}, {"type": "subtitle", "time": 24125.19, "timestamp": "06:42:05", "text": "（笑）"}, {"type": "subtitle", "time": 24129.83, "timestamp": "06:42:09", "text": "。 そろそろ寝る時間だ。"}, {"type": "subtitle", "time": 24140.868, "timestamp": "06:42:20", "text": "パズルゲームか。"}, {"type": "subtitle", "time": 24155.67, "timestamp": "06:42:35", "text": "あなたはまだ共有しています。 私は"}, {"type": "subtitle", "time": 24158.708, "timestamp": "06:42:38", "text": "設計図をいじっていました。 ああ、あのゲーム、あのゲームには"}, {"type": "subtitle", "time": 24162.31, "timestamp": "06:42:42", "text": "パズルがたくさんあるね。 いくつか映像を見たことがあります"}, {"type": "subtitle", "time": 24164.868, "timestamp": "06:42:44", "text": "。"}, {"type": "subtitle", "time": 24168.708, "timestamp": "06:42:48", "text": "うん。 でも、それはそれでいいんです。 ミステリーゲーム"}, {"type": "subtitle", "time": 24170.868, "timestamp": "06:42:50", "text": "開始。"}, {"type": "subtitle", "time": 24174.628, "timestamp": "06:42:54", "text": "ダークネスさん、良い一日をお過ごしください。 はい、元気です"}, {"type": "subtitle", "time": 24178.07, "timestamp": "06:42:58", "text": "。   元気です"}]
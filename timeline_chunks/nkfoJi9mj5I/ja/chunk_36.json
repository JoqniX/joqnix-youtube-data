[{"type": "subtitle", "time": 2160.87, "timestamp": "00:36:00", "text": "デート相手を探したり、そういうことができます。 誰かを探すこともできる。それは"}, {"type": "subtitle", "time": 2185.43, "timestamp": "00:36:25", "text": "友達と遊ぶ回数が増えるほど、親密度が上がったり、ランクアップしたりするような親密さもあります"}, {"type": "subtitle", "time": 2210.63, "timestamp": "00:36:50", "text": "どこですか？ わかった。 もし私が眠ってしまったら、"}, {"type": "subtitle", "time": 2214.55, "timestamp": "00:36:54", "text": "いや、もし私がうーん"}, {"type": "subtitle", "time": 2216.47, "timestamp": "00:36:56", "text": "、ええ、"}, {"type": "subtitle", "time": 2219.67, "timestamp": "00:36:59", "text": "ゲームを起動したときにキャラクタークリエーターがありました。"}]
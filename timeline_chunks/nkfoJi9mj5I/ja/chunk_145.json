[{"type": "subtitle", "time": 8705.27, "timestamp": "02:25:05", "text": "駆除協同組合。"}, {"type": "subtitle", "time": 8707.51, "timestamp": "02:25:07", "text": "おお。"}, {"type": "subtitle", "time": 8709.59, "timestamp": "02:25:09", "text": "いいねを押してあげると、"}, {"type": "subtitle", "time": 8719.349, "timestamp": "02:25:19", "text": "。 ダメージブーストとDPS（ダメージパーセカンド）ができる人が必要です"}, {"type": "subtitle", "time": 8728.15, "timestamp": "02:25:28", "text": "。 来る。 やりましょう。"}, {"type": "subtitle", "time": 8730.87, "timestamp": "02:25:30", "text": "何とかやってみせる。 私はそのパターンを理解した"}, {"type": "subtitle", "time": 8732.63, "timestamp": "02:25:32", "text": "。"}, {"type": "subtitle", "time": 8735.11, "timestamp": "02:25:35", "text": "犬には近づかないでください。"}]
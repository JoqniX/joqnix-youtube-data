[{"type": "subtitle", "time": 24483.35, "timestamp": "06:48:03", "text": "、こいつらが"}, {"type": "subtitle", "time": 24492.07, "timestamp": "06:48:12", "text": "うん。ああ、いいね。ナイス処刑。なんてこった。"}, {"type": "subtitle", "time": 24504.07, "timestamp": "06:48:24", "text": "いいね。わかった。宝箱を手に入れた。 それが"}, {"type": "subtitle", "time": 24506.39, "timestamp": "06:48:26", "text": "私がここに来た理由です。ほら"}, {"type": "subtitle", "time": 24508.788, "timestamp": "06:48:28", "text": "、私がここにいるから"}, {"type": "subtitle", "time": 24510.628, "timestamp": "06:48:30", "text": "、この"}, {"type": "subtitle", "time": 24512.23, "timestamp": "06:48:32", "text": "エリアを全部片付けちゃおう。"}, {"type": "subtitle", "time": 24515.99, "timestamp": "06:48:35", "text": "彼らは何も悪いことをしていない。"}, {"type": "subtitle", "time": 24518.868, "timestamp": "06:48:38", "text": "わかってるけど、"}, {"type": "subtitle", "time": 24530.07, "timestamp": "06:48:50", "text": "ええ、宝"}]
[{"type": "subtitle", "time": 27842.708, "timestamp": "07:44:02", "text": "すごい。細部までこだわっている。見て、私は"}, {"type": "subtitle", "time": 27856.628, "timestamp": "07:44:16", "text": "。"}, {"type": "subtitle", "time": 27860.468, "timestamp": "07:44:20", "text": "旅人よ、立ち上がって渡せ。"}, {"type": "subtitle", "time": 27877.75, "timestamp": "07:44:37", "text": "ああ、彼はMPCではない。よし、彼はただ"}, {"type": "subtitle", "time": 27881.99, "timestamp": "07:44:41", "text": "吠えているだけだ。それだけだ。臆病者。"}, {"type": "subtitle", "time": 27890.388, "timestamp": "07:44:50", "text": "よし、もう片付けるよ、さもないと殺す。"}, {"type": "subtitle", "time": 27892.548, "timestamp": "07:44:52", "text": "よし、最後だ。よし、これをやって行く"}]
[{"type": "subtitle", "time": 25205.35, "timestamp": "07:00:05", "text": "私を助けないのは、あなたが私を妨げているからです。"}, {"type": "subtitle", "time": 25214.868, "timestamp": "07:00:14", "text": "ああ、彼はとても気が強い。なんてこと。"}, {"type": "subtitle", "time": 25217.75, "timestamp": "07:00:17", "text": "どうして？"}, {"type": "subtitle", "time": 25225.64, "timestamp": "07:00:25", "text": "彼は怒りをコントロールするんだ。[笑い]"}, {"type": "subtitle", "time": 25228.628, "timestamp": "07:00:28", "text": "[息を呑む] 怒りのコントロール。わかった。じゃあ"}, {"type": "subtitle", "time": 25244.07, "timestamp": "07:00:44", "text": "宝の地図をあげて手伝ってあげるよ。"}, {"type": "subtitle", "time": 25250.628, "timestamp": "07:00:50", "text": "？"}, {"type": "subtitle", "time": 25255.03, "timestamp": "07:00:55", "text": "いいじゃないか。"}, {"type": "subtitle", "time": 25257.51, "timestamp": "07:00:57", "text": "人を助けるのが好きなんだ。"}]
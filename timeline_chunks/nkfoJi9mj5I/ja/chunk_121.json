[{"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "待って。"}, {"type": "subtitle", "time": 7265.35, "timestamp": "02:01:05", "text": "私たちはこのゲームで16位です。"}, {"type": "subtitle", "time": 7267.91, "timestamp": "02:01:07", "text": "なぜ私たちは飲んでいるのか？"}, {"type": "subtitle", "time": 7270.629, "timestamp": "02:01:10", "text": "ああ、もう昔の話だよ。 ああ、それは"}, {"type": "subtitle", "time": 7280.47, "timestamp": "02:01:20", "text": "。 まあ、ここでは普通のことだと思うよ。"}, {"type": "subtitle", "time": 7286.47, "timestamp": "02:01:26", "text": "はい、画面が真っ暗です。 それは"}, {"type": "subtitle", "time": 7287.91, "timestamp": "02:01:27", "text": "何かが起こっているということだ。 彼らは"}, {"type": "subtitle", "time": 7292.31, "timestamp": "02:01:32", "text": "我々を略奪するつもりだ。 彼らは私たちを裏切るだろう。"}, {"type": "subtitle", "time": 7295.27, "timestamp": "02:01:35", "text": "彼らは私たちを地下牢のような奇妙な場所に放り込んだ。"}, {"type": "subtitle", "time": 7304.709, "timestamp": "02:01:44", "text": "何？ とんでもない。 私たちはスケープゴートにされた"}]
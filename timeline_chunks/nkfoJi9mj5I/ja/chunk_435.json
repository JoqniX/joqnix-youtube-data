[{"type": "subtitle", "time": 26120.15, "timestamp": "07:15:20", "text": "彼女にお金をあげたんだ。"}, {"type": "subtitle", "time": 26128.31, "timestamp": "07:15:28", "text": "どこ？どこに行けばいいんだ？なんてこった。"}, {"type": "subtitle", "time": 26140.468, "timestamp": "07:15:40", "text": "今からそこまで歩いて行かなきゃならない。だから"}, {"type": "subtitle", "time": 26145.51, "timestamp": "07:15:45", "text": "前にやっておけばよかったんだ。もういいや、戻ってこよう"}, {"type": "subtitle", "time": 26148.15, "timestamp": "07:15:48", "text": "。"}, {"type": "subtitle", "time": 26153.99, "timestamp": "07:15:53", "text": "えっと、"}]
[{"type": "subtitle", "time": 27000.15, "timestamp": "07:30:00", "text": "ここから手に入れたのか？ああ、そうだ。あと"}, {"type": "subtitle", "time": 27004.548, "timestamp": "07:30:04", "text": "、"}, {"type": "subtitle", "time": 27051.03, "timestamp": "07:30:51", "text": "蛇だ。なんてこった、蛇だ。蛇だ。"}, {"type": "subtitle", "time": 27053.04, "timestamp": "07:30:53", "text": "蛇だ。 ああ、待って。"}, {"type": "subtitle", "time": 27056.08, "timestamp": "07:30:56", "text": "ああ、待って。 蛇の家族って何？"}, {"type": "subtitle", "time": 27059.44, "timestamp": "07:30:59", "text": "蛇の家族って何？ 売ってるんだ、えっと、なんてこった。これ、なんてこった。なんてこった。なんてこった。なんてこった。いや。"}]
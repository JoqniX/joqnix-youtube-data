[{"type": "subtitle", "time": 27247.67, "timestamp": "07:34:07", "text": "ああ、もう7時間34分過ぎてる。"}, {"type": "subtitle", "time": 27248.868, "timestamp": "07:34:08", "text": "あ、待って、待って、待って。"}, {"type": "subtitle", "time": 27250.868, "timestamp": "07:34:10", "text": "配信を終了しなきゃいけなかったよね？"}, {"type": "subtitle", "time": 27254.948, "timestamp": "07:34:14", "text": "忘れちゃう。あ、ちょっと待って。ずっと"}, {"type": "subtitle", "time": 27261.51, "timestamp": "07:34:21", "text": "、とりあえずこれをマークしておいて、"}, {"type": "subtitle", "time": 27266.468, "timestamp": "07:34:26", "text": "後で戻ってきてやるよ。明日。"}, {"type": "subtitle", "time": 27268.07, "timestamp": "07:34:28", "text": "えっと、"}, {"type": "subtitle", "time": 27270.388, "timestamp": "07:34:30", "text": "配信時間を変えた方がいい気がする。午後"}, {"type": "subtitle", "time": 27279.99, "timestamp": "07:34:39", "text": "7時の日本語の授業の後に配信するのはやめて、"}, {"type": "subtitle", "time": 27282.948, "timestamp": "07:34:42", "text": "朝早くにやろう。"}, {"type": "subtitle", "time": 27285.51, "timestamp": "07:34:45", "text": "でも明日はプロトコルをやらなきゃいけない。"}, {"type": "subtitle", "time": 27288.31, "timestamp": "07:34:48", "text": "追いつかなきゃいけないし、"}]
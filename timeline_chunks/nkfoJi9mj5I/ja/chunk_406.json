[{"type": "subtitle", "time": 24362.788, "timestamp": "06:46:02", "text": "えっと、"}, {"type": "subtitle", "time": 24379.99, "timestamp": "06:46:19", "text": "あ。あ、ダブルだ マーカー。"}, {"type": "subtitle", "time": 24382.788, "timestamp": "06:46:22", "text": "あ、そこにある。目が見えない。目が見えない。"}, {"type": "subtitle", "time": 24384.788, "timestamp": "06:46:24", "text": "わはは。わかった"}, {"type": "subtitle", "time": 24387.27, "timestamp": "06:46:27", "text": "、わかった。どうもありがとう。わかった"}, {"type": "subtitle", "time": 24394.31, "timestamp": "06:46:34", "text": "、わかった。"}, {"type": "subtitle", "time": 24395.67, "timestamp": "06:46:35", "text": "試してみた？"}, {"type": "subtitle", "time": 24399.91, "timestamp": "06:46:39", "text": "君もMMOだよ。"}, {"type": "subtitle", "time": 24402.07, "timestamp": "06:46:42", "text": "今日、配信でちょっとMMOに切り替えたんだ。"}, {"type": "subtitle", "time": 24408.23, "timestamp": "06:46:48", "text": "刑務所に放り込まれて"}, {"type": "subtitle", "time": 24410.39, "timestamp": "06:46:50", "text": "歩かされている男にキャベツを投げつけた。"}, {"type": "subtitle", "time": 24412.468, "timestamp": "06:46:52", "text": "みんな野菜や"}, {"type": "subtitle", "time": 24414.788, "timestamp": "06:46:54", "text": "トマトやニンジンなどを投げつけていた。だから"}, {"type": "subtitle", "time": 24417.91, "timestamp": "06:46:57", "text": "「わかった、私もそうじゃない」と思ったんだ。今までやったのはそれだけだよ"}]
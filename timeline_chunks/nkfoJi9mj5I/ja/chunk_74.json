[{"type": "subtitle", "time": 4452.39, "timestamp": "01:14:12", "text": "なんてこった？   あの"}, {"type": "subtitle", "time": 4454.229, "timestamp": "01:14:14", "text": "ユーチューバーの言うことを信じてはいけない。"}, {"type": "subtitle", "time": 4463.189, "timestamp": "01:14:23", "text": "おお。 わかった。 このゲームを通してずっとこの人を見かけました。Matcha"}, {"type": "subtitle", "time": 4472.39, "timestamp": "01:14:32", "text": "Mara VT という人です。それで、"}, {"type": "subtitle", "time": 4473.99, "timestamp": "01:14:33", "text": "その人のチャンネルをチェックしました。 彼らはまるで"}, {"type": "subtitle", "time": 4476.229, "timestamp": "01:14:36", "text": "キュレーターのようだ。"}, {"type": "subtitle", "time": 4481.27, "timestamp": "01:14:41", "text": "親愛なる老人を。 ああ、残念だ。   私が"}, {"type": "subtitle", "time": 4489.75, "timestamp": "01:14:49", "text": "うん。"}, {"type": "subtitle", "time": 4491.669, "timestamp": "01:14:51", "text": "マツァマラ"}, {"type": "subtitle", "time": 4499.99, "timestamp": "01:14:59", "text": "彼らは生放送ですか？ いや、待って。 いいえ、それほど"}]
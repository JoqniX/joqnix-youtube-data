[{"type": "subtitle", "time": 26829.11, "timestamp": "07:27:09", "text": "チェスト？よし、チェストだ。"}, {"type": "subtitle", "time": 26842.23, "timestamp": "07:27:22", "text": "ステルスの時間だ。"}, {"type": "subtitle", "time": 26844.868, "timestamp": "07:27:24", "text": "投げつけるみたいに気をそらすことができればいいのに。 石か何かで、"}, {"type": "subtitle", "time": 26848.07, "timestamp": "07:27:28", "text": "彼らがそれをチェックしに来るので、"}, {"type": "subtitle", "time": 26851.75, "timestamp": "07:27:31", "text": "襟首か首をつかんで、タックルして気絶させるか、"}, {"type": "subtitle", "time": 26856.548, "timestamp": "07:27:36", "text": "殺す。それはとても"}]
[{"type": "subtitle", "time": 482.39, "timestamp": "00:08:02", "text": "１回目。 はい、"}, {"type": "subtitle", "time": 519.909, "timestamp": "00:08:39", "text": "、軽量版でプレイして、"}, {"type": "subtitle", "time": 522.07, "timestamp": "00:08:42", "text": "FPSとパフォーマンスがどうなるか見てみましょう"}, {"type": "subtitle", "time": 525.19, "timestamp": "00:08:45", "text": "。 よし、もしそれが"}, {"type": "subtitle", "time": 527.99, "timestamp": "00:08:47", "text": "良ければ、もしそれがもっと軽ければ、"}, {"type": "subtitle", "time": 530.23, "timestamp": "00:08:50", "text": "実際に"}, {"type": "subtitle", "time": 533.11, "timestamp": "00:08:53", "text": "Steamからこれに乗り換えることを検討するかもしれない。 でも、"}, {"type": "subtitle", "time": 536.63, "timestamp": "00:08:56", "text": "Steamでの平均的なプレイ時間を自慢したいんです。 それが"}]
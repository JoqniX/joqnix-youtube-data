[{"type": "subtitle", "time": 25921.43, "timestamp": "07:12:01", "text": "彼らは"}, {"type": "subtitle", "time": 25923.59, "timestamp": "07:12:03", "text": "マップのこの側に来ることさえ予想していなかった。"}, {"type": "subtitle", "time": 25925.844, "timestamp": "07:12:05", "text": "本当にクレイジーだ。"}, {"type": "subtitle", "time": 25927.51, "timestamp": "07:12:07", "text": "[笑い]"}, {"type": "subtitle", "time": 25933.19, "timestamp": "07:12:13", "text": "ここに来たくなかったのに、来た。もう43。いいね。"}, {"type": "subtitle", "time": 25940.948, "timestamp": "07:12:20", "text": "酔っ払い"}, {"type": "subtitle", "time": 25942.948, "timestamp": "07:12:22", "text": "チャレンジをやった。"}, {"type": "subtitle", "time": 25951.11, "timestamp": "07:12:31", "text": "実はワールドボスがいる。今すぐ"}, {"type": "subtitle", "time": 25953.99, "timestamp": "07:12:33", "text": "これをやるべきか？"}, {"type": "subtitle", "time": 25955.83, "timestamp": "07:12:35", "text": "でも、何度も死んでしまう。"}, {"type": "subtitle", "time": 25959.99, "timestamp": "07:12:39", "text": "アブドゥアナクはまだ試みている。"}, {"type": "subtitle", "time": 25975.51, "timestamp": "07:12:55", "text": "ああ、弱体化。ああ、世界を弱体化できる"}, {"type": "subtitle", "time": 25979.03, "timestamp": "07:12:59", "text": "。ああ、"}]
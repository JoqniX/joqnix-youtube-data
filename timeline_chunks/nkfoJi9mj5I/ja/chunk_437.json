[{"type": "subtitle", "time": 26226.23, "timestamp": "07:17:06", "text": "ああ、この岩の上で"}, {"type": "subtitle", "time": 26228.868, "timestamp": "07:17:08", "text": "ヨガか何かを練習する男がいる。少林寺か"}, {"type": "subtitle", "time": 26235.19, "timestamp": "07:17:15", "text": "待って、あの岩だよね？ああ、違う、違う、違う。"}, {"type": "subtitle", "time": 26254.708, "timestamp": "07:17:34", "text": "ああ、落下ダメージを回避した。よかった。"}, {"type": "subtitle", "time": 26257.19, "timestamp": "07:17:37", "text": "今回は足を折らなかった。よし。"}, {"type": "subtitle", "time": 26259.51, "timestamp": "07:17:39", "text": "ああ、"}, {"type": "subtitle", "time": 26263.59, "timestamp": "07:17:43", "text": "ここでヨガをする男がいると思う、両腕を上げて片足で"}]
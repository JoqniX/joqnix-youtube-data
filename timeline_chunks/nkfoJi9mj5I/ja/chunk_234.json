[{"type": "subtitle", "time": 14045.99, "timestamp": "03:54:05", "text": "やあ、スタック。"}, {"type": "subtitle", "time": 14052.07, "timestamp": "03:54:12", "text": "こんにちは、キシャさん。 ようこそ。"}, {"type": "subtitle", "time": 14053.67, "timestamp": "03:54:13", "text": "お名前の発音が合っているといいのですが"}, {"type": "subtitle", "time": 14055.59, "timestamp": "03:54:15", "text": "。"}, {"type": "subtitle", "time": 14058.229, "timestamp": "03:54:18", "text": "元気かい？ 元気です。 元気ですか"}, {"type": "subtitle", "time": 14060.55, "timestamp": "03:54:20", "text": "？ 今日はどうやって私を見つけたのですか？ 今日はどんな一日でしたか"}, {"type": "subtitle", "time": 14070.229, "timestamp": "03:54:30", "text": "ああ、私は正しく発音している。 わかった。"}, {"type": "subtitle", "time": 14072.309, "timestamp": "03:54:32", "text": "ニース。   それは"}, {"type": "subtitle", "time": 14075.349, "timestamp": "03:54:35", "text": "嬉しいですね。"}]
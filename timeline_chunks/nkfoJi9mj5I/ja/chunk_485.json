[{"type": "subtitle", "time": 29101.35, "timestamp": "08:05:01", "text": "。 たぶん（息を呑んで笑いながら）そう"}, {"type": "subtitle", "time": 29105.11, "timestamp": "08:05:05", "text": "思う。 寝て治るといいな。 もし私が寝て眠らなかったら"}, {"type": "subtitle", "time": 29107.83, "timestamp": "08:05:07", "text": "、あなたは私に会うことになるでしょう。"}, {"type": "subtitle", "time": 29111.59, "timestamp": "08:05:11", "text": "文字通り、私が午前8時か9時に配信しているのを目にするでしょう。まるで"}, {"type": "subtitle", "time": 29115.19, "timestamp": "08:05:15", "text": "眠れなかったかのように。   私はそれが"}, {"type": "subtitle", "time": 29120.15, "timestamp": "08:05:20", "text": "ええ。 そうならないことを願っています"}, {"type": "subtitle", "time": 29123.59, "timestamp": "08:05:23", "text": "。 はい、"}, {"type": "subtitle", "time": 29126.388, "timestamp": "08:05:26", "text": "こんにちは。 はい、今日はありがとうございました。 えっと、もう"}, {"type": "subtitle", "time": 29128.548, "timestamp": "08:05:28", "text": "8"}, {"type": "subtitle", "time": 29131.91, "timestamp": "08:05:31", "text": "時間以上配信しています。 こんにちは。 こんにちは。 こんにちは。 こんにちは。"}, {"type": "subtitle", "time": 29135.03, "timestamp": "08:05:35", "text": "これで終わりにします。 また明日ね。 今夜は恐らく"}, {"type": "subtitle", "time": 29137.35, "timestamp": "08:05:37", "text": "Blue Protocolかこのゲームの配信をするだろう"}, {"type": "subtitle", "time": 29140.868, "timestamp": "08:05:40", "text": "。 ええ、夜にね。 ええと、"}, {"type": "subtitle", "time": 29146.708, "timestamp": "08:05:46", "text": "今日はもう1日分の作業をやらなきゃいけないな。 こんにちは。 こんにちは。 ええ、"}, {"type": "subtitle", "time": 29151.03, "timestamp": "08:05:51", "text": "今日はありがとうございました。 皆さん、良い一日を。"}, {"type": "subtitle", "time": 29153.99, "timestamp": "08:05:53", "text": "それでは、さようなら。"}, {"type": "subtitle", "time": 29156.548, "timestamp": "08:05:56", "text": "良い一日を、そして良い夜をお過ごしください"}, {"type": "subtitle", "time": 29158.548, "timestamp": "08:05:58", "text": "。 水分補給を忘れないでください。 お"}]
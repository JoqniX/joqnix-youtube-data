[{"type": "subtitle", "time": 28451.99, "timestamp": "07:54:11", "text": "ああ、そうか。巡査。オーケー。オーケー。"}, {"type": "subtitle", "time": 28459.99, "timestamp": "07:54:19", "text": "かわいそうな男は"}, {"type": "subtitle", "time": 28478.868, "timestamp": "07:54:38", "text": "ほらね？ええ、モバイルアプリも"}, {"type": "subtitle", "time": 28485.99, "timestamp": "07:54:45", "text": "ブラウザアプリも。どちらも動作が遅いです。"}]
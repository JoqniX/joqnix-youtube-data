[{"type": "subtitle", "time": 3961.589, "timestamp": "01:06:01", "text": "つまり、この地下には地下都市があるってことですね"}, {"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "。 おお。 私は"}, {"type": "subtitle", "time": 3967.43, "timestamp": "01:06:07", "text": "このクエストをまだクリアしていません。"}, {"type": "subtitle", "time": 3975.91, "timestamp": "01:06:15", "text": "右下に胸があるね。"}, {"type": "subtitle", "time": 3985.109, "timestamp": "01:06:25", "text": "可能性はある。 おそらく。"}, {"type": "subtitle", "time": 3986.789, "timestamp": "01:06:26", "text": "待って、私はそうしなかった。ああ、そうだった。 私はもう一方のものを"}, {"type": "subtitle", "time": 3990.789, "timestamp": "01:06:30", "text": "ここから入手したわけではありません。"}, {"type": "subtitle", "time": 3995.19, "timestamp": "01:06:35", "text": "ああ、ああ、"}, {"type": "subtitle", "time": 3997.91, "timestamp": "01:06:37", "text": "いや、私の"}, {"type": "subtitle", "time": 4001.91, "timestamp": "01:06:41", "text": "捻挫。 足が折れた。 ああ、なんてことだ、"}, {"type": "subtitle", "time": 4005.029, "timestamp": "01:06:45", "text": "足が折れた。 ああ、捻挫だ。 はい、"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "はい、はい、はい。 しばらく休憩した後"}, {"type": "subtitle", "time": 4017.19, "timestamp": "01:06:57", "text": "待って、どうやって、"}]
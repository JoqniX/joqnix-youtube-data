[{"type": "subtitle", "time": 24962.39, "timestamp": "06:56:02", "text": "ああ。ああ、瞑想するのにいい場所だ。"}, {"type": "subtitle", "time": 24975.91, "timestamp": "06:56:15", "text": "瞑想。ああ、1つ。私は"}, {"type": "subtitle", "time": 24985.19, "timestamp": "06:56:25", "text": "わあ、頭に水が落ちてくる。"}, {"type": "subtitle", "time": 25007.27, "timestamp": "06:56:47", "text": "トークンが必要。H。"}, {"type": "subtitle", "time": 25010.548, "timestamp": "06:56:50", "text": "これは何？もっと人。"}, {"type": "subtitle", "time": 25013.35, "timestamp": "06:56:53", "text": "こんにちは。"}, {"type": "subtitle", "time": 25015.75, "timestamp": "06:56:55", "text": "彼らのカップルを禁止する。"}, {"type": "subtitle", "time": 25019.51, "timestamp": "06:56:59", "text": "もっと教えて。わかった。彼女にお金をあげる。私はもう"}]
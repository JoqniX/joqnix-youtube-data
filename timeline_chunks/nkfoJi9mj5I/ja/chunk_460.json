[{"type": "subtitle", "time": 27609.03, "timestamp": "07:40:09", "text": "うん、スマホの方がスムーズだ。わかった、"}, {"type": "subtitle", "time": 27613.43, "timestamp": "07:40:13", "text": "気にしないで。言ったことは撤回する。"}, {"type": "subtitle", "time": 27617.03, "timestamp": "07:40:17", "text": "スムーズで、速くて、"}, {"type": "subtitle", "time": 27619.19, "timestamp": "07:40:19", "text": "あらゆる面で優れている[笑]。"}, {"type": "subtitle", "time": 27655.43, "timestamp": "07:40:55", "text": "待って、ボスはどこ？"}, {"type": "subtitle", "time": 27659.19, "timestamp": "07:40:59", "text": "ああ、地下エリアがあると思う。"}]
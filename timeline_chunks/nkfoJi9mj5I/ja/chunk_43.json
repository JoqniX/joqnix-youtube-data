[{"type": "subtitle", "time": 2585.91, "timestamp": "00:43:05", "text": "不思議な部分を作ることができる。 だから、私は"}, {"type": "subtitle", "time": 2588.95, "timestamp": "00:43:08", "text": "これをやって毎週の報酬を得ています。 えっと、"}, {"type": "subtitle", "time": 2591.589, "timestamp": "00:43:11", "text": "明日やります。"}, {"type": "subtitle", "time": 2595.51, "timestamp": "00:43:15", "text": "ええ、午前 2 時になる前に。いや、"}, {"type": "subtitle", "time": 2601.19, "timestamp": "00:43:21", "text": "夜のアビスから始めて、"}, {"type": "subtitle", "time": 2631.43, "timestamp": "00:43:51", "text": "私はこれは何ですか？をしたいです。"}, {"type": "subtitle", "time": 2634.39, "timestamp": "00:43:54", "text": "よし、洞窟が現れた"}, {"type": "subtitle", "time": 2636.63, "timestamp": "00:43:56", "text": "。   まずは"}]
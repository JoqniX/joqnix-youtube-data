[{"type": "subtitle", "time": 2883.589, "timestamp": "00:48:03", "text": "ええと、まるで本格的なMMO RPG"}, {"type": "subtitle", "time": 2886.309, "timestamp": "00:48:06", "text": "体験のようです。 他の人と一緒に遊んだり、"}, {"type": "subtitle", "time": 2888.47, "timestamp": "00:48:08", "text": "一緒にゲームをしたり、一緒に戦ったり、"}, {"type": "subtitle", "time": 2890.71, "timestamp": "00:48:10", "text": "PvPやPEをしたり、"}, {"type": "subtitle", "time": 2892.87, "timestamp": "00:48:12", "text": "一緒にダンジョンやボスを倒したり、ギルド活動などをしたりします"}, {"type": "subtitle", "time": 2895.91, "timestamp": "00:48:15", "text": "。 ソロモードは、"}, {"type": "subtitle", "time": 2898.63, "timestamp": "00:48:18", "text": "ストーリー"}, {"type": "subtitle", "time": 2900.95, "timestamp": "00:48:20", "text": "、チャレンジ、その他諸々に焦点を当てています"}, {"type": "subtitle", "time": 2903.829, "timestamp": "00:48:23", "text": "。"}, {"type": "subtitle", "time": 2905.91, "timestamp": "00:48:25", "text": "つまり、彼らは隠蔽された状態で現れるということだ。"}, {"type": "subtitle", "time": 2909.03, "timestamp": "00:48:29", "text": "つまり、皆さん、私はよくわかりません。 まだ"}, {"type": "subtitle", "time": 2913.51, "timestamp": "00:48:33", "text": "確認していません。 その川の一部"}, {"type": "subtitle", "time": 2915.51, "timestamp": "00:48:35", "text": "。 よし。"}, {"type": "subtitle", "time": 2917.75, "timestamp": "00:48:37", "text": "Kick"}, {"type": "subtitle", "time": 2921.03, "timestamp": "00:48:41", "text": "Reaper Killer097さん、フォローアップありがとうございます。"}]
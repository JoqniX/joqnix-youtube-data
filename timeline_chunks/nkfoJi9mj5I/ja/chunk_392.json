[{"type": "subtitle", "time": 23521.11, "timestamp": "06:32:01", "text": "順調です。 えっと、配信はどうでしたか"}, {"type": "subtitle", "time": 23525.19, "timestamp": "06:32:05", "text": "？ こんにちは。 どうぞお入りください。"}, {"type": "subtitle", "time": 23528.23, "timestamp": "06:32:08", "text": "配信はいかがでしたか？"}, {"type": "subtitle", "time": 23532.548, "timestamp": "06:32:12", "text": "今日の配信は素晴らしいものだったでしょうか。"}, {"type": "subtitle", "time": 23538.548, "timestamp": "06:32:18", "text": "えっと、今日は何を配信したの？ 何を"}, {"type": "subtitle", "time": 23540.39, "timestamp": "06:32:20", "text": "配信しましたか？ ああ、あなたもミーティングの配信をしていたんですね"}, {"type": "subtitle", "time": 23544.31, "timestamp": "06:32:24", "text": "。 おお、いいね。"}, {"type": "subtitle", "time": 23548.15, "timestamp": "06:32:28", "text": "初めてです。 おお、いいね。 うまくいったことを願っています。   楽しんでいただけたなら幸いです"}, {"type": "subtitle", "time": 23551.2, "timestamp": "06:32:31", "text": "。   楽しんでいただけたなら幸いです 。"}, {"type": "subtitle", "time": 23558.628, "timestamp": "06:32:38", "text": "[笑い] 私は、えっと、"}, {"type": "subtitle", "time": 23560.708, "timestamp": "06:32:40", "text": "最近始めたばかりで、"}, {"type": "subtitle", "time": 23574.31, "timestamp": "06:32:54", "text": "あらゆるエリアの隅々まで探索してスキャンしてすべてを手に入れようとしています。[笑い]   それは多すぎる"}, {"type": "subtitle", "time": 23576.708, "timestamp": "06:32:56", "text": "。"}, {"type": "subtitle", "time": 23578.948, "timestamp": "06:32:58", "text": "このゲームには本当にたくさんの要素がある。"}, {"type": "subtitle", "time": 23579.67, "timestamp": "06:32:59", "text": "ああ（笑い声とため息）本当に"}]
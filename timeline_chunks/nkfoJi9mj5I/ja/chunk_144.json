[{"type": "subtitle", "time": 8641.349, "timestamp": "02:24:01", "text": "、それは良くない考えだと思いますし、"}, {"type": "subtitle", "time": 8644.469, "timestamp": "02:24:04", "text": "ボスのHPも"}, {"type": "subtitle", "time": 8646.87, "timestamp": "02:24:06", "text": "増えたと思います。"}, {"type": "subtitle", "time": 8650.469, "timestamp": "02:24:10", "text": "30までスピードランして参加してください。 こんにちは、"}, {"type": "subtitle", "time": 8652.309, "timestamp": "02:24:12", "text": "スピードランは必要ありません。 私はそれを打ち負かそうと努力します"}, {"type": "subtitle", "time": 8660.79, "timestamp": "02:24:20", "text": "こんにちは。 遅延の件だけど、"}, {"type": "subtitle", "time": 8664.15, "timestamp": "02:24:24", "text": "大丈夫だったらよかったんだけど、待つしかないね。 なぜ"}, {"type": "subtitle", "time": 8667.67, "timestamp": "02:24:27", "text": "遅延が発生しているのですか？"}, {"type": "subtitle", "time": 8693.59, "timestamp": "02:24:53", "text": "遅れるのは最悪だ"}, {"type": "subtitle", "time": 8695.83, "timestamp": "02:24:55", "text": "。  200。信じられない"}, {"type": "subtitle", "time": 8698.07, "timestamp": "02:24:58", "text": "。"}]
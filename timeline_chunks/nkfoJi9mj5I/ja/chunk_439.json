[{"type": "subtitle", "time": 26340.708, "timestamp": "07:19:00", "text": "あ、待って。遭遇戦は文字通り、"}, {"type": "subtitle", "time": 26344.15, "timestamp": "07:19:04", "text": "犯罪者とか、"}, {"type": "subtitle", "time": 26348.15, "timestamp": "07:19:08", "text": "盗みやスリをしている人を捕まえること。"}, {"type": "subtitle", "time": 26351.83, "timestamp": "07:19:11", "text": "彼らを無敵にするんだ。無敵じゃなくて、"}, {"type": "subtitle", "time": 26353.99, "timestamp": "07:19:13", "text": "動けなくするんだ。動けなくするやつをやって、現行犯で捕まえて、"}, {"type": "subtitle", "time": 26369.11, "timestamp": "07:19:29", "text": "ホースで背後から連れて行くんだ。"}, {"type": "subtitle", "time": 26371.83, "timestamp": "07:19:31", "text": "警察官とか、"}, {"type": "subtitle", "time": 26374.15, "timestamp": "07:19:34", "text": "判事とか、よくわからないけど、"}]
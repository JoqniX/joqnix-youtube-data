[{"type": "subtitle", "time": 14345.59, "timestamp": "03:59:05", "text": "彼女は一体どこへ行くのだろうか？"}, {"type": "subtitle", "time": 14353.11, "timestamp": "03:59:13", "text": "これで彼とドッキングできる。 でも待って、私は"}, {"type": "subtitle", "time": 14356.309, "timestamp": "03:59:16", "text": "彼がどこへ行くのか見たい"}, {"type": "subtitle", "time": 14366.07, "timestamp": "03:59:26", "text": "それはどこへ行くのですか？"}, {"type": "subtitle", "time": 14385.75, "timestamp": "03:59:45", "text": "あなたは本当に去っていくのですね。   ちょっと"}]
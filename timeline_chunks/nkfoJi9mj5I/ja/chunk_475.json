[{"type": "subtitle", "time": 28505.91, "timestamp": "07:55:05", "text": "うん、分かったと思う。"}, {"type": "subtitle", "time": 28509.35, "timestamp": "07:55:09", "text": "地図には載っていない。 うん、分かったみたいだ"}, {"type": "subtitle", "time": 28512.31, "timestamp": "07:55:12", "text": "。 わかった。"}, {"type": "subtitle", "time": 28514.628, "timestamp": "07:55:14", "text": "こんにちは。 せっかく来たので、ついでに商品"}, {"type": "subtitle", "time": 28516.948, "timestamp": "07:55:16", "text": "取引の手続きを済ませて、"}, {"type": "subtitle", "time": 28519.35, "timestamp": "07:55:19", "text": "今日の仕事はこれで終わりにします。"}, {"type": "subtitle", "time": 28535.43, "timestamp": "07:55:35", "text": "私たちはたくさん数えました。"}, {"type": "subtitle", "time": 28548.07, "timestamp": "07:55:48", "text": "待って。"}, {"type": "subtitle", "time": 28550.31, "timestamp": "07:55:50", "text": "そこは正しい場所ではありません。 ここがその"}]
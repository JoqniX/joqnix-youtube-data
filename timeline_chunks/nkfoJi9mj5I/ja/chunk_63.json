[{"type": "subtitle", "time": 3781.75, "timestamp": "01:03:01", "text": "えっと、"}, {"type": "subtitle", "time": 3785.03, "timestamp": "01:03:05", "text": "単語のセクションは翌日にチェックします。 ゼルダの伝説 神々のトライフォースのレースを"}, {"type": "subtitle", "time": 3787.27, "timestamp": "01:03:07", "text": "一緒にプレイしてくれる人を探しています"}, {"type": "subtitle", "time": 3790.309, "timestamp": "01:03:10", "text": "。 君は"}, {"type": "subtitle", "time": 3793.43, "timestamp": "01:03:13", "text": "それをプレイしたことある？ 過去の人種とは何ですか？   それは"}, {"type": "subtitle", "time": 3795.67, "timestamp": "01:03:15", "text": "どんなゲームですか？"}, {"type": "subtitle", "time": 3798.789, "timestamp": "01:03:18", "text": "過去のレース。   それは"}, {"type": "chat", "time": 3804.512, "timestamp": "01:03:24", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "I am not Bengali btw I was just playing around"}, {"type": "chat", "time": 3808.966, "timestamp": "01:03:28", "author": "@FEROCIOUS_Grrr", "avatar": "https://yt4.ggpht.com/b2fcSyaRaGAEUJaW8yBs5ibxfiDi-brp1G8cHHTYAXKaRusaeuWU68kOjIUNWz1gmVNNSGP5MQ=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/6_cfY8HJH8bV5QS5yYDYDg"}, {"type": "subtitle", "time": 3810.63, "timestamp": "01:03:30", "text": "ゲーム。"}, {"type": "subtitle", "time": 3812.95, "timestamp": "01:03:32", "text": "スーパーファミコン版『ゼルダの伝説』"}, {"type": "subtitle", "time": 3820.309, "timestamp": "01:03:40", "text": "私はNintendo Switchを持っていません。 そう、"}, {"type": "subtitle", "time": 3822.789, "timestamp": "01:03:42", "text": "本当に任天堂のゲームをプレイしたいんだよ"}, {"type": "subtitle", "time": 3824.63, "timestamp": "01:03:44", "text": "。"}, {"type": "subtitle", "time": 3828.309, "timestamp": "01:03:48", "text": "それらは本当に素敵ですね。"}, {"type": "subtitle", "time": 3830.15, "timestamp": "01:03:50", "text": "わあ、ホタル集めのレベルが上がったよ"}, {"type": "subtitle", "time": 3832.95, "timestamp": "01:03:52", "text": "。"}]
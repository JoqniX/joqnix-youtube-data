[{"type": "subtitle", "time": 24851.35, "timestamp": "06:54:11", "text": "これを「ありがとう」と書いた誰かに感謝します"}, {"type": "subtitle", "time": 24869.19, "timestamp": "06:54:29", "text": "モブと戦う。よし、モブを倒した。"}, {"type": "subtitle", "time": 24873.75, "timestamp": "06:54:33", "text": "えっと、次は、"}, {"type": "subtitle", "time": 24891.75, "timestamp": "06:54:51", "text": "別のMPC。待って、標識を確認する。"}, {"type": "subtitle", "time": 24893.99, "timestamp": "06:54:53", "text": "ここでリラックス。よし、実際に"}, {"type": "subtitle", "time": 24896.07, "timestamp": "06:54:56", "text": "ぶっつけ本番でやらなきゃ。"}, {"type": "subtitle", "time": 24897.99, "timestamp": "06:54:57", "text": "待って、その前にチェック"}]
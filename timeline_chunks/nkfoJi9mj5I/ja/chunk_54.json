[{"type": "subtitle", "time": 3256.79, "timestamp": "00:54:16", "text": "こいつら強すぎるぞ。"}, {"type": "subtitle", "time": 3259.75, "timestamp": "00:54:19", "text": "待って、なぜ赤いライオンなの？ 待って、私は"}, {"type": "subtitle", "time": 3262.549, "timestamp": "00:54:22", "text": "今32歳だ。"}, {"type": "subtitle", "time": 3265.589, "timestamp": "00:54:25", "text": "待って、なぜ彼らは私には強すぎるように見えるのだろう"}, {"type": "subtitle", "time": 3276.309, "timestamp": "00:54:36", "text": "そこに女神がいるよ、友よ。 それがこの"}]
[{"type": "subtitle", "time": 26043.35, "timestamp": "07:14:03", "text": "それが宝箱だった。わかった。これ、すごく"}, {"type": "subtitle", "time": 26048.868, "timestamp": "07:14:08", "text": "ラグい。"}, {"type": "subtitle", "time": 26050.788, "timestamp": "07:14:10", "text": "インタラクティブマップ、"}, {"type": "subtitle", "time": 26053.11, "timestamp": "07:14:13", "text": "グローバル版の公式インタラクティブマップを持ってきてほしい"}, {"type": "subtitle", "time": 26054.788, "timestamp": "07:14:14", "text": "。"}, {"type": "subtitle", "time": 26057.83, "timestamp": "07:14:17", "text": "中国語版はいいんだけど、"}, {"type": "subtitle", "time": 26062.15, "timestamp": "07:14:22", "text": "マーカーを全部オンにして、"}, {"type": "subtitle", "time": 26066.15, "timestamp": "07:14:26", "text": "一つずつ見つけたとマークしていくと"}, {"type": "subtitle", "time": 26068.788, "timestamp": "07:14:28", "text": "、すごくラグい。ラグがひどくなる"}, {"type": "subtitle", "time": 26072.564, "timestamp": "07:14:32", "text": "傾向がある。"}, {"type": "subtitle", "time": 26073.83, "timestamp": "07:14:33", "text": "[笑い]"}, {"type": "subtitle", "time": 26087.27, "timestamp": "07:14:47", "text": "クエストがある。わかった、"}, {"type": "subtitle", "time": 26089.03, "timestamp": "07:14:49", "text": "これを見てみよう。"}]
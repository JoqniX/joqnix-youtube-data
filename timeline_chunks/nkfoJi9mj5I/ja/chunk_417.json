[{"type": "subtitle", "time": 25021.19, "timestamp": "06:57:01", "text": "金持ちだ"}, {"type": "subtitle", "time": 25024.07, "timestamp": "06:57:04", "text": "。"}, {"type": "subtitle", "time": 25026.39, "timestamp": "06:57:06", "text": "その2つの場所を調査すべきだ。"}, {"type": "subtitle", "time": 25028.948, "timestamp": "06:57:08", "text": "ああ、いいね。でも、友達になってもいい"}, {"type": "subtitle", "time": 25031.11, "timestamp": "06:57:11", "text": "？"}, {"type": "subtitle", "time": 25034.628, "timestamp": "06:57:14", "text": "ああ、神様。わかった。彼に怒りを鎮めるように説得する"}, {"type": "subtitle", "time": 25037.99, "timestamp": "06:57:17", "text": "。ああ、神様。ああ"}, {"type": "subtitle", "time": 25043.67, "timestamp": "06:57:23", "text": "ごめん、"}, {"type": "subtitle", "time": 25056.468, "timestamp": "06:57:36", "text": "落ち着く必要がある。"}, {"type": "subtitle", "time": 25065.91, "timestamp": "06:57:45", "text": "怒るの？怒るの？"}, {"type": "subtitle", "time": 25072.07, "timestamp": "06:57:52", "text": "ああ、神様。[笑い] わかった、"}]
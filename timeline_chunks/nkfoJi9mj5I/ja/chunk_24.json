[{"type": "subtitle", "time": 1452.07, "timestamp": "00:24:12", "text": "本当に楽しかった。 雑談をする。"}, {"type": "subtitle", "time": 1456.23, "timestamp": "00:24:16", "text": "うん、彼はもう大きい子だよ。"}, {"type": "subtitle", "time": 1459.11, "timestamp": "00:24:19", "text": "内部。"}, {"type": "subtitle", "time": 1462.63, "timestamp": "00:24:22", "text": "ああ、あの山のことですね。ちょっと見てみましょう"}, {"type": "subtitle", "time": 1473.029, "timestamp": "00:24:33", "text": "君のレースでね。 なぜページが"}, {"type": "subtitle", "time": 1473.909, "timestamp": "00:24:33", "text": "欠落しているのですか？"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "ああ、それは私の責任です。 ただの"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "紙だと思った。 実は、旅先で胃の調子が悪くなって、"}, {"type": "subtitle", "time": 1484.149, "timestamp": "00:24:44", "text": "ワオ。"}, {"type": "subtitle", "time": 1486.549, "timestamp": "00:24:46", "text": "あれは紙だったのか？"}, {"type": "subtitle", "time": 1489.19, "timestamp": "00:24:49", "text": "これは私の所属するルーエン派の部隊からの記念品です"}]
[{"type": "subtitle", "time": 28149.19, "timestamp": "07:49:09", "text": "爆発はどう？すごくいい感じだよ"}, {"type": "subtitle", "time": 28151.19, "timestamp": "07:49:11", "text": "。えっと、すごくいい感じ"}, {"type": "subtitle", "time": 28154.23, "timestamp": "07:49:14", "text": "。たまたま"}, {"type": "subtitle", "time": 28161.27, "timestamp": "07:49:21", "text": "ベッドを右側の敵に投げつけて"}, {"type": "subtitle", "time": 28168.31, "timestamp": "07:49:28", "text": "。ただ彼らを殺さなきゃいけないだけ。それだけ"}, {"type": "subtitle", "time": 28171.91, "timestamp": "07:49:31", "text": "。うん、ずっと探索してたんだ。"}, {"type": "subtitle", "time": 28177.27, "timestamp": "07:49:37", "text": "全部わかったし、"}, {"type": "subtitle", "time": 28180.548, "timestamp": "07:49:40", "text": "遭遇クエストみたいなもので、"}, {"type": "subtitle", "time": 28185.11, "timestamp": "07:49:45", "text": "緑のクエストじゃなくて遭遇クエストで、結局"}, {"type": "subtitle", "time": 28192.824, "timestamp": "07:49:52", "text": "ここにいることになったんだ。"}]
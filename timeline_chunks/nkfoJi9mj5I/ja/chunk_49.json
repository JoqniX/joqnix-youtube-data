[{"type": "subtitle", "time": 2965.27, "timestamp": "00:49:25", "text": "みんな、火事だよ、すぐそこの追放所で"}, {"type": "subtitle", "time": 2968.39, "timestamp": "00:49:28", "text": "。 キノコは"}, {"type": "subtitle", "time": 2971.51, "timestamp": "00:49:31", "text": "ムーンビル・ピークの南にある。"}, {"type": "subtitle", "time": 2973.91, "timestamp": "00:49:33", "text": "フォローアラートはどこにあるの？ 明らかな"}, {"type": "subtitle", "time": 2976.63, "timestamp": "00:49:36", "text": "重ね合わせ。 そうそう。 ちなみに、"}, {"type": "subtitle", "time": 2979.67, "timestamp": "00:49:39", "text": "フォローアラートは設定していません。"}, {"type": "subtitle", "time": 2992.79, "timestamp": "00:49:52", "text": "わあ、全部揃ってる。   とんでも"}, {"type": "subtitle", "time": 2996.069, "timestamp": "00:49:56", "text": "ない。 全部手に入れたよ。"}]
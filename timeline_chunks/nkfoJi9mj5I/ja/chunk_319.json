[{"type": "subtitle", "time": 19140.55, "timestamp": "05:19:00", "text": "ここはどこですか？"}, {"type": "subtitle", "time": 19147.75, "timestamp": "05:19:07", "text": "？ 今まで見たことのないシンボルが見える"}, {"type": "subtitle", "time": 19155.75, "timestamp": "05:19:15", "text": "待って。 私がNPCに話しかけると、"}, {"type": "subtitle", "time": 19171.19, "timestamp": "05:19:31", "text": "知りませんでした。"}, {"type": "subtitle", "time": 19179.03, "timestamp": "05:19:39", "text": "。 モバイルアプリのみが表示されました。"}, {"type": "subtitle", "time": 19181.27, "timestamp": "05:19:41", "text": "あなたはそうしなかった。 何てことだ。 これは壊れています。"}, {"type": "subtitle", "time": 19199.75, "timestamp": "05:19:59", "text": "リンクをコピーするために試してみます。"}]
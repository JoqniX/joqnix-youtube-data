[{"type": "subtitle", "time": 23461.59, "timestamp": "06:31:01", "text": "ああ、我々は戦略的な剣を手に入れた。 ああ、なんてことだ"}, {"type": "subtitle", "time": 23465.03, "timestamp": "06:31:05", "text": "、戦略的な剣を手に入れたぞ。"}, {"type": "subtitle", "time": 23467.83, "timestamp": "06:31:07", "text": "秩序は計算という方法から生まれる"}, {"type": "subtitle", "time": 23469.75, "timestamp": "06:31:09", "text": "。"}, {"type": "subtitle", "time": 23471.75, "timestamp": "06:31:11", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 23474.468, "timestamp": "06:31:14", "text": "R六剣の"}, {"type": "subtitle", "time": 23499.83, "timestamp": "06:31:39", "text": "ああ、襲撃してくれてありがとう。 何てことだ。"}, {"type": "subtitle", "time": 23503.35, "timestamp": "06:31:43", "text": "襲撃してくれてありがとう、サックス。"}, {"type": "subtitle", "time": 23505.51, "timestamp": "06:31:45", "text": "えっと、ザフ、"}, {"type": "subtitle", "time": 23508.788, "timestamp": "06:31:48", "text": "襲撃してくれてありがとう。 サックス、こんにちは。"}, {"type": "subtitle", "time": 23511.43, "timestamp": "06:31:51", "text": "こんにちは。 あなたの名前を"}, {"type": "subtitle", "time": 23514.39, "timestamp": "06:31:54", "text": "正しく発音できたかどうかは分かりませんが、まあ、そういうことです。 こんにちは。 ようこそ、"}, {"type": "subtitle", "time": 23517.03, "timestamp": "06:31:57", "text": "レイディッシュ。"}, {"type": "subtitle", "time": 23518.868, "timestamp": "06:31:58", "text": "こんにちは。 こんにちは。"}]
[{"type": "subtitle", "time": 28802.628, "timestamp": "08:00:02", "text": "星座かな。 わかった、いいよ。 コンステレーションは"}, {"type": "subtitle", "time": 28806.566, "timestamp": "08:00:06", "text": "問題ありません。 装備できないままです。"}, {"type": "subtitle", "time": 28807.99, "timestamp": "08:00:07", "text": "[笑い]"}, {"type": "subtitle", "time": 28810.31, "timestamp": "08:00:10", "text": "でも、あまり物が入ってないんですよね。 私は"}, {"type": "subtitle", "time": 28813.35, "timestamp": "08:00:13", "text": "このロゴとかそういうのが欲しいんです。"}, {"type": "subtitle", "time": 28840.15, "timestamp": "08:00:40", "text": "試合時間は4日間です。 聖なる。"}]
[{"type": "subtitle", "time": 13382.389, "timestamp": "03:43:02", "text": "なんだか、ちょっと、すごく眠くなってきた。   そろそろ"}, {"type": "subtitle", "time": 13385.99, "timestamp": "03:43:05", "text": "寝た方が良さそうだ。"}, {"type": "subtitle", "time": 13389.91, "timestamp": "03:43:09", "text": "本当に少し眠いです。"}, {"type": "subtitle", "time": 13392.469, "timestamp": "03:43:12", "text": "今日だけ寝れば、"}, {"type": "subtitle", "time": 13394.469, "timestamp": "03:43:14", "text": "できるような気がする。"}, {"type": "subtitle", "time": 13396.15, "timestamp": "03:43:16", "text": "うん、今日早く寝れば、"}, {"type": "subtitle", "time": 13404.389, "timestamp": "03:43:24", "text": "明日こそはうまくいく気がする。 早起きしてやりなさい。   何か"}, {"type": "subtitle", "time": 13408.15, "timestamp": "03:43:28", "text": "プレイしてください。   ひたすら努力するしかない"}]
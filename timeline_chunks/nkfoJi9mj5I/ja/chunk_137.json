[{"type": "subtitle", "time": 8221.99, "timestamp": "02:17:01", "text": "大丈夫。 大丈夫。 大丈夫。 大丈夫、任せて"}, {"type": "subtitle", "time": 8231.19, "timestamp": "02:17:11", "text": "ラグが大きいようです。 ものすごい遅延。"}, {"type": "subtitle", "time": 8237.429, "timestamp": "02:17:17", "text": "そしてなぜ彼女は？ああ、あなたが私の"}, {"type": "subtitle", "time": 8264.309, "timestamp": "02:17:44", "text": "あなたはどこを離れたのですか？ ああ、私は死ぬ。 私は死ぬだろう。   私は"}, {"type": "subtitle", "time": 8277.83, "timestamp": "02:17:57", "text": "あ、待って。 なんてこった。"}]
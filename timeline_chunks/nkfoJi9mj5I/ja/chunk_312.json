[{"type": "subtitle", "time": 18731.51, "timestamp": "05:12:11", "text": "ない"}, {"type": "subtitle", "time": 18734.31, "timestamp": "05:12:14", "text": "。"}, {"type": "subtitle", "time": 18736.31, "timestamp": "05:12:16", "text": "メインマップに移動させてください。"}, {"type": "subtitle", "time": 18742.15, "timestamp": "05:12:22", "text": "メインマップはどこにありますか？ わかった。 私は今どこにいますか？"}, {"type": "subtitle", "time": 18745.03, "timestamp": "05:12:25", "text": "それと、なぜアプリでは開けるのに"}, {"type": "subtitle", "time": 18755.51, "timestamp": "05:12:35", "text": "よし、もしこっちの方が実際にスムーズなら、"}, {"type": "subtitle", "time": 18760.788, "timestamp": "05:12:40", "text": "正直に言ってこっちを使うべきだな。"}, {"type": "subtitle", "time": 18763.19, "timestamp": "05:12:43", "text": "ええ、私はこの村にいます。"}, {"type": "subtitle", "time": 18766.868, "timestamp": "05:12:46", "text": "他のマーカーはどうすれば入手できますか？ ああ、こんな感じ。"}, {"type": "subtitle", "time": 18769.83, "timestamp": "05:12:49", "text": "ああ、なんて滑らかなんだ。 ああ、"}, {"type": "subtitle", "time": 18776.55, "timestamp": "05:12:56", "text": "ああ、なんて滑らかなんだ。 ボタンを押すと、"}, {"type": "subtitle", "time": 18778.47, "timestamp": "05:12:58", "text": "すべて瞬時に反応します。 待って、"}]
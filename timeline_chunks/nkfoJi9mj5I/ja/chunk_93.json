[{"type": "subtitle", "time": 5592.629, "timestamp": "01:33:12", "text": "1つ。 わかった。 わかった。 二。"}, {"type": "subtitle", "time": 5609.43, "timestamp": "01:33:29", "text": "武道の腕を磨くのに本当に役立ってくれてありがとう。"}, {"type": "subtitle", "time": 5612.229, "timestamp": "01:33:32", "text": "これはちょっとした雑談として受け取ってください。 さあ行こう。 やったぞ"}, {"type": "subtitle", "time": 5614.07, "timestamp": "01:33:34", "text": "。"}, {"type": "subtitle", "time": 5616.39, "timestamp": "01:33:36", "text": "それでおしまい。 私たちはこの武術を習っていません"}, {"type": "subtitle", "time": 5623.03, "timestamp": "01:33:43", "text": "しかし、あなたは依然として同じ間違った"}, {"type": "subtitle", "time": 5625.51, "timestamp": "01:33:45", "text": "手順を繰り返しているのです。"}, {"type": "subtitle", "time": 5627.43, "timestamp": "01:33:47", "text": "彼らは"}, {"type": "subtitle", "time": 5629.99, "timestamp": "01:33:49", "text": "2秒間も持ちこたえられない。 えっと、３回"}, {"type": "subtitle", "time": 5631.83, "timestamp": "01:33:51", "text": "呼吸してください。"}]
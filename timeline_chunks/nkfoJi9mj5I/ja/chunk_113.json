[{"type": "subtitle", "time": 6793.189, "timestamp": "01:53:13", "text": "？ いいえ、そこには行きませんでした。 待って、"}, {"type": "subtitle", "time": 6796.47, "timestamp": "01:53:16", "text": "ここはどこ？"}, {"type": "subtitle", "time": 6804.709, "timestamp": "01:53:24", "text": "私は花を作りました。 いや、"}, {"type": "subtitle", "time": 6814.229, "timestamp": "01:53:34", "text": "、クリケットをやりました。"}, {"type": "subtitle", "time": 6816.709, "timestamp": "01:53:36", "text": "ネクロチャンのやつ、"}, {"type": "subtitle", "time": 6818.87, "timestamp": "01:53:38", "text": "ベル、"}, {"type": "subtitle", "time": 6821.75, "timestamp": "01:53:41", "text": "それから"}, {"type": "subtitle", "time": 6825.669, "timestamp": "01:53:45", "text": "ミニゲームで酔っ払いの鍋をやったよ。   わかった"}, {"type": "subtitle", "time": 6828.39, "timestamp": "01:53:48", "text": "。"}, {"type": "subtitle", "time": 6836.31, "timestamp": "01:53:56", "text": "探求がある。 私は"}]
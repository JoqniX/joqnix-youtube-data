[{"type": "subtitle", "time": 25144.548, "timestamp": "06:59:04", "text": "ええ、私が言ったのはそれです。あなたの"}, {"type": "subtitle", "time": 25155.27, "timestamp": "06:59:15", "text": "あなたを落ち着かせることができるか、という感じではない"}, {"type": "subtitle", "time": 25165.19, "timestamp": "06:59:25", "text": "上げるのをやめなさい。ああ、わかった。彼は暑い。私にはでき"}, {"type": "subtitle", "time": 25178.788, "timestamp": "06:59:38", "text": "わかった、道標がある。"}, {"type": "subtitle", "time": 25180.548, "timestamp": "06:59:40", "text": "彼の目標に集中しなさい。わかった、わかった、わかった、わかった"}, {"type": "subtitle", "time": 25193.03, "timestamp": "06:59:53", "text": "自分の目標に集中しなければならない。"}]
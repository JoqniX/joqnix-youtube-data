[{"type": "subtitle", "time": 25086.628, "timestamp": "06:58:06", "text": "でも、私たちは皆人間だ。わかった"}, {"type": "subtitle", "time": 25090.708, "timestamp": "06:58:10", "text": "。奴隷は本当に暗闇だ。こんにちは。おやすみなさい。"}, {"type": "subtitle", "time": 25098.628, "timestamp": "06:58:18", "text": "所属する。"}, {"type": "subtitle", "time": 25101.75, "timestamp": "06:58:21", "text": "素敵な夜を過ごしてください。"}, {"type": "subtitle", "time": 25103.99, "timestamp": "06:58:23", "text": "今夜、星があなたを祝福し、あなたを見守り、"}, {"type": "subtitle", "time": 25127.67, "timestamp": "06:58:47", "text": "宝物を手に入れたとしても、"}, {"type": "subtitle", "time": 25133.19, "timestamp": "06:58:53", "text": "自分の名を上げなさい。自分の"}]
[{"type": "subtitle", "time": 28261.03, "timestamp": "07:51:01", "text": "誰か、これ以上このゲームをプレイするのを止めてくれ"}, {"type": "subtitle", "time": 28282.548, "timestamp": "07:51:22", "text": "あの宝箱も終わった。"}, {"type": "subtitle", "time": 28284.15, "timestamp": "07:51:24", "text": "うん。"}, {"type": "subtitle", "time": 28287.43, "timestamp": "07:51:27", "text": "それで、これで何人死んだの？51"}, {"type": "subtitle", "time": 28290.15, "timestamp": "07:51:30", "text": "分前。どれくらい時間が経ったの？"}, {"type": "subtitle", "time": 28293.03, "timestamp": "07:51:33", "text": "プレイ中？えーと、もうすぐ8"}, {"type": "subtitle", "time": 28300.548, "timestamp": "07:51:40", "text": "うん、8時間プレイしてる。"}, {"type": "subtitle", "time": 28306.15, "timestamp": "07:51:46", "text": "もう午前6時だよ。なんてこった。"}, {"type": "subtitle", "time": 28308.468, "timestamp": "07:51:48", "text": "普段は午前10時頃に配信してるんだけど、こんなに"}, {"type": "subtitle", "time": 28312.868, "timestamp": "07:51:52", "text": "遅くまで起きてないんだ。"}, {"type": "subtitle", "time": 28316.31, "timestamp": "07:51:56", "text": "普段は自分の時間で朝の時間帯に配信してるん"}]
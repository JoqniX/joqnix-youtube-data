[{"type": "subtitle", "time": 5161.83, "timestamp": "01:26:01", "text": "待って、"}, {"type": "subtitle", "time": 5203.03, "timestamp": "01:26:43", "text": "はい。 はい。 ディオ、お前は死んだ。 ディオ、違う。 無理をしすぎないでください"}, {"type": "subtitle", "time": 5206.31, "timestamp": "01:26:46", "text": "。 起きる。 起きる。 起きる"}, {"type": "subtitle", "time": 5208.95, "timestamp": "01:26:48", "text": "。   わかった"}, {"type": "subtitle", "time": 5211.35, "timestamp": "01:26:51", "text": "。 何てことだ。  [息を呑む]"}, {"type": "subtitle", "time": 5213.83, "timestamp": "01:26:53", "text": "死ぬかと思った。"}, {"type": "subtitle", "time": 5217.669, "timestamp": "01:26:57", "text": "危うく失敗するところだった。 何てことだ。 彼は、私は"}]
[{"type": "subtitle", "time": 18486.07, "timestamp": "05:08:06", "text": "待って、一つだけ。 おお。 ああ、これはあなたがどれだけのことを成し遂げたかを示してくれる"}, {"type": "subtitle", "time": 18499.35, "timestamp": "05:08:19", "text": "ああ、お腹"}, {"type": "subtitle", "time": 18511.11, "timestamp": "05:08:31", "text": "おお。 わかった。 鐘楼の呼び出し装置を想像してみてください"}, {"type": "subtitle", "time": 18512.948, "timestamp": "05:08:32", "text": "。 鐘楼の"}, {"type": "subtitle", "time": 18515.75, "timestamp": "05:08:35", "text": "呼び出し装置があると思います。   よくわかりません"}, {"type": "subtitle", "time": 18520.47, "timestamp": "05:08:40", "text": "。 宝箱コレクション。"}]
[{"type": "subtitle", "time": 4845.189, "timestamp": "01:20:45", "text": "フィン斜面の南西にある崖の下にある洞窟に入ってください。"}, {"type": "subtitle", "time": 4846.87, "timestamp": "01:20:46", "text": "ああ、それは別の洞窟だ。 それは"}, {"type": "subtitle", "time": 4851.75, "timestamp": "01:20:51", "text": "後でやります。 あれはこっちです。"}, {"type": "subtitle", "time": 4854.709, "timestamp": "01:20:54", "text": "よし、じゃあ、やらなきゃいけないことは、そこに行くことだ。"}, {"type": "subtitle", "time": 4856.39, "timestamp": "01:20:56", "text": "よし、いいかい？ まるで"}, {"type": "subtitle", "time": 4858.55, "timestamp": "01:20:58", "text": "医者に行くみたいだ。"}]
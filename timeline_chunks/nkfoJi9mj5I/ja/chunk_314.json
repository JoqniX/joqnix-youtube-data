[{"type": "subtitle", "time": 18841.91, "timestamp": "05:14:01", "text": "これは詐欺です。"}, {"type": "subtitle", "time": 18850.07, "timestamp": "05:14:10", "text": "ああ、気にしないで。 実際、効果があります。 はい、"}, {"type": "subtitle", "time": 18853.83, "timestamp": "05:14:13", "text": "はい、はい、はい、はい。 えっと、"}, {"type": "subtitle", "time": 18855.35, "timestamp": "05:14:15", "text": "全部持って行ってください。"}, {"type": "subtitle", "time": 18857.67, "timestamp": "05:14:17", "text": "青、緑、黄色の蝶3匹、"}, {"type": "subtitle", "time": 18861.59, "timestamp": "05:14:21", "text": "ホース、神社、本、"}, {"type": "subtitle", "time": 18865.11, "timestamp": "05:14:25", "text": "えーと男、カップを持った変な男、そして"}, {"type": "subtitle", "time": 18877.35, "timestamp": "05:14:37", "text": "待って、私のアカウントと同期するはずなんだ"}, {"type": "subtitle", "time": 18880.55, "timestamp": "05:14:40", "text": "けど。   まるで"}, {"type": "subtitle", "time": 18883.35, "timestamp": "05:14:43", "text": "私が大したことをしていないかのように言うべきではない"}, {"type": "subtitle", "time": 18886.23, "timestamp": "05:14:46", "text": "。 同期するはずです"}, {"type": "subtitle", "time": 18889.11, "timestamp": "05:14:49", "text": "。"}, {"type": "subtitle", "time": 18892.39, "timestamp": "05:14:52", "text": "待って、ここは一体どこなの？ 私は今、ある"}, {"type": "subtitle", "time": 18899.75, "timestamp": "05:14:59", "text": "ここはどこ？"}]
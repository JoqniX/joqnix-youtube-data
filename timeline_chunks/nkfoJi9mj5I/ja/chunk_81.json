[{"type": "subtitle", "time": 4860.39, "timestamp": "01:21:00", "text": "えっと、ここから物を受け取ってから"}, {"type": "subtitle", "time": 4862.31, "timestamp": "01:21:02", "text": "医者に行って、また"}, {"type": "subtitle", "time": 4864.709, "timestamp": "01:21:04", "text": "ここに戻ってきます。 このサイド"}, {"type": "subtitle", "time": 4867.99, "timestamp": "01:21:07", "text": "クエストとワールドクエストをこなして、それから"}, {"type": "subtitle", "time": 4872.79, "timestamp": "01:21:12", "text": "この斜面も探索しよう。"}, {"type": "subtitle", "time": 4886.709, "timestamp": "01:21:26", "text": "それから、こうやって"}, {"type": "subtitle", "time": 4890.39, "timestamp": "01:21:30", "text": "ゆっくりこっちに来てください。"}, {"type": "subtitle", "time": 4893.189, "timestamp": "01:21:33", "text": "きっと。"}]
[{"type": "subtitle", "time": 8280.07, "timestamp": "02:18:00", "text": "いや。死なせてしまえ。"}, {"type": "subtitle", "time": 8281.589, "timestamp": "02:18:01", "text": "殺してやる。"}, {"type": "subtitle", "time": 8289.99, "timestamp": "02:18:09", "text": "何をするの？ 私に何ができる？"}, {"type": "subtitle", "time": 8292.629, "timestamp": "02:18:12", "text": "あ、待って。 私は回復した。 ああ、神様、あなたは"}, {"type": "subtitle", "time": 8302.95, "timestamp": "02:18:22", "text": "占い。"}, {"type": "subtitle", "time": 8318.389, "timestamp": "02:18:38", "text": "大きい人とは、決して会えないだろう。"}, {"type": "subtitle", "time": 8320.389, "timestamp": "02:18:40", "text": "どうやって？ 何？ 待って、本当に"}]
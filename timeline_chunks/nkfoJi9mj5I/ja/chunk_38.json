[{"type": "subtitle", "time": 2282.15, "timestamp": "00:38:02", "text": "ああ、F5は外観キーですね。 わかった。"}, {"type": "subtitle", "time": 2297.91, "timestamp": "00:38:17", "text": "一緒にジャンプしたいですか？   じゃあ、行きます"}, {"type": "subtitle", "time": 2306.39, "timestamp": "00:38:26", "text": "あなたはあのコリームゲームをプレイしましたか？"}, {"type": "subtitle", "time": 2310.71, "timestamp": "00:38:30", "text": "ああ、いや。 私はそのゲームをプレイしたことがありません。"}, {"type": "subtitle", "time": 2313.43, "timestamp": "00:38:33", "text": "名前を忘れてしまったのですが、えっと、何という"}, {"type": "subtitle", "time": 2330.15, "timestamp": "00:38:50", "text": "エンツォとかいう名前だったと思うんだけど、忘れちゃった。   でも値段が"}, {"type": "subtitle", "time": 2332.87, "timestamp": "00:38:52", "text": "高いですね。 無料ではありません。"}]
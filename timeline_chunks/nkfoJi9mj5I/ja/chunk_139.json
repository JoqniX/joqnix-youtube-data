[{"type": "subtitle", "time": 8342.95, "timestamp": "02:19:02", "text": "。 私は魔法の力でまだ生きている"}, {"type": "subtitle", "time": 8351.99, "timestamp": "02:19:11", "text": "待って、待って、待って。 私たちは実際に"}, {"type": "subtitle", "time": 8354.87, "timestamp": "02:19:14", "text": "これをグリッチさせることができます。"}, {"type": "subtitle", "time": 8357.669, "timestamp": "02:19:17", "text": "待って。 いいえ、あなたは中にいます。 私を"}, {"type": "subtitle", "time": 8371.429, "timestamp": "02:19:31", "text": "うん。 うん。 私は脇にいます。そうすれば彼が"}, {"type": "subtitle", "time": 8393.912, "timestamp": "02:19:53", "text": "いや。ただ"}, {"type": "subtitle", "time": 8394.15, "timestamp": "02:19:54", "text": "（鼻を鳴らして）"}, {"type": "subtitle", "time": 8396.07, "timestamp": "02:19:56", "text": "縮小させる力か"}, {"type": "subtitle", "time": 8399.03, "timestamp": "02:19:59", "text": "何かをくれればいいんだ。 私を癒してください。 待って、待って。 攻撃を試みて"}]
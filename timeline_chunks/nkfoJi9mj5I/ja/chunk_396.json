[{"type": "subtitle", "time": 23762.628, "timestamp": "06:36:02", "text": "どうやら新しいイベントが追加されたようです。"}, {"type": "subtitle", "time": 23766.31, "timestamp": "06:36:06", "text": "「おお、肌がタダだ」って感じだった。 でも、いや、あなたはそれをつかまなければならない"}, {"type": "subtitle", "time": 23774.628, "timestamp": "06:36:14", "text": "うん。 可愛いキャラクターとか、そういうのを全部見せてよ"}, {"type": "subtitle", "time": 23783.51, "timestamp": "06:36:23", "text": "潰れるのは良くない。 仏陀について、"}, {"type": "subtitle", "time": 23787.67, "timestamp": "06:36:27", "text": "よし、あと何日残っているかな"}, {"type": "subtitle", "time": 23796.07, "timestamp": "06:36:36", "text": "ああ、時間制限はありませんよ。 おお、いいね。"}, {"type": "subtitle", "time": 23800.39, "timestamp": "06:36:40", "text": "ええ、レベルパスもあるんですよ。 うん。"}, {"type": "subtitle", "time": 23807.83, "timestamp": "06:36:47", "text": "クレイジー。"}, {"type": "subtitle", "time": 23816.948, "timestamp": "06:36:56", "text": "DPS（ダメージパーセカンド）近接戦闘。"}]
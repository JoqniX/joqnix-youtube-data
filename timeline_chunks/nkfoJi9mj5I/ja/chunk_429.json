[{"type": "subtitle", "time": 25746.07, "timestamp": "07:09:06", "text": "ご"}, {"type": "subtitle", "time": 25764.07, "timestamp": "07:09:24", "text": "私も"}, {"type": "subtitle", "time": 25769.95, "timestamp": "07:09:29", "text": "先生のような偉大な剣豪になりたいです。ウインク。あ、いいね。"}, {"type": "subtitle", "time": 25771.19, "timestamp": "07:09:31", "text": "[笑い]"}, {"type": "subtitle", "time": 25773.35, "timestamp": "07:09:33", "text": "今日は絶好調だ。"}, {"type": "subtitle", "time": 25777.03, "timestamp": "07:09:37", "text": "こんなに早くこいつらを捕まえられるんだ。どうやって？信じられない"}, {"type": "subtitle", "time": 25779.35, "timestamp": "07:09:39", "text": "。すごい。いいね。"}, {"type": "subtitle", "time": 25798.23, "timestamp": "07:09:58", "text": "イーシャンは寝てる。寝ろ。遅い。"}]
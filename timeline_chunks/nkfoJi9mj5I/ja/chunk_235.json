[{"type": "subtitle", "time": 14133.59, "timestamp": "03:55:33", "text": "このゲームが大好きです。 ああ、あなたも"}, {"type": "subtitle", "time": 14135.59, "timestamp": "03:55:35", "text": "このゲームをプレイしているんですね。"}, {"type": "subtitle", "time": 14139.269, "timestamp": "03:55:39", "text": "これまでの試合の感想はいかがですか？"}, {"type": "subtitle", "time": 14141.83, "timestamp": "03:55:41", "text": "ええ、あなたは今、このゲームが大好きだと言いましたね。"}, {"type": "subtitle", "time": 14146.71, "timestamp": "03:55:46", "text": "探索要素は全て完了しましたか？"}, {"type": "subtitle", "time": 14148.87, "timestamp": "03:55:48", "text": "私は協力プレイ関連のコンテンツには"}, {"type": "subtitle", "time": 14152.15, "timestamp": "03:55:52", "text": "全く触れていません。 私はただ、ただ、ただ、落ちていくことをしてきただけです。"}]
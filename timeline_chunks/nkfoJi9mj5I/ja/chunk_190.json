[{"type": "subtitle", "time": 11401.83, "timestamp": "03:10:01", "text": "。 うっかり"}, {"type": "subtitle", "time": 11405.429, "timestamp": "03:10:05", "text": "別のものを受け入れてしまったのでしょうか。私は"}, {"type": "subtitle", "time": 11411.19, "timestamp": "03:10:11", "text": "十分なブランチがなかったので、試験のバーでした。 私は"}, {"type": "subtitle", "time": 11421.51, "timestamp": "03:10:21", "text": "待って。 何てことだ。 待って。 彼らは試験を受けたりするための"}, {"type": "subtitle", "time": 11424.95, "timestamp": "03:10:24", "text": "医療"}, {"type": "subtitle", "time": 11427.269, "timestamp": "03:10:27", "text": "証明書などを何も提示しなかった"}, {"type": "subtitle", "time": 11430.79, "timestamp": "03:10:30", "text": "。 待って、それは"}, {"type": "chat", "time": 11434.985, "timestamp": "03:10:34", "author": "@sappyissap", "avatar": "https://yt4.ggpht.com/L44QLCQGMU6SE1bCsql8PIfsFhAkVolvmYx9MCoDWwH4qtCvwblTh0CPSGcixecYRTl8tjPCwbo=s64-c-k-c0x00ffffff-no-rj", "message": "My name means 7 sages and 7 stars and I happen to have 7 personality "}, {"type": "subtitle", "time": 11445.51, "timestamp": "03:10:45", "text": "私の名前は「七賢人」と「七つの星」を意味し、"}, {"type": "subtitle", "time": 11447.51, "timestamp": "03:10:47", "text": "偶然にも私は"}, {"type": "subtitle", "time": 11450.309, "timestamp": "03:10:50", "text": "そこに七つの人格を持っているのです。 ああ、"}, {"type": "chat", "time": 11452.084, "timestamp": "03:10:52", "author": "@sappyissap", "avatar": "https://yt4.ggpht.com/L44QLCQGMU6SE1bCsql8PIfsFhAkVolvmYx9MCoDWwH4qtCvwblTh0CPSGcixecYRTl8tjPCwbo=s64-c-k-c0x00ffffff-no-rj", "message": "And the name sapp is the front section "}, {"type": "subtitle", "time": 11455.51, "timestamp": "03:10:55", "text": "次に、名前アプリは友達"}, {"type": "subtitle", "time": 11458.389, "timestamp": "03:10:58", "text": "セクションです。 ああ、"}]
[{"type": "subtitle", "time": 5880.629, "timestamp": "01:38:00", "text": "こんにちは、トランプさん。 いらっしゃいませ。"}, {"type": "subtitle", "time": 5884.79, "timestamp": "01:38:04", "text": "こんにちは。 こんにちは。 こんばんは。   私が仕事のためにテレビをつけた"}, {"type": "subtitle", "time": 5887.03, "timestamp": "01:38:07", "text": "時"}, {"type": "subtitle", "time": 5889.189, "timestamp": "01:38:09", "text": "、最初に目にするのが"}, {"type": "subtitle", "time": 5893.092, "timestamp": "01:38:13", "text": "あなたの配信だと思わないでください。 チョーク。 待って、何"}, {"type": "subtitle", "time": 5894.55, "timestamp": "01:38:14", "text": "[笑い]"}, {"type": "subtitle", "time": 5898.87, "timestamp": "01:38:18", "text": "も？ ニャーニャーが来たよ。   撫でてあげるよ"}, {"type": "subtitle", "time": 5901.91, "timestamp": "01:38:21", "text": "。"}, {"type": "subtitle", "time": 5903.99, "timestamp": "01:38:23", "text": "夕方。 ああ、それはちょうどいい。"}, {"type": "subtitle", "time": 5905.83, "timestamp": "01:38:25", "text": "あなたにとっては朝です。 こんにちは。 おはよう、"}, {"type": "subtitle", "time": 5908.79, "timestamp": "01:38:28", "text": "ディオ。"}, {"type": "subtitle", "time": 5935.75, "timestamp": "01:38:55", "text": "。 テレポート"}]
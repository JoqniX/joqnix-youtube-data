[{"type": "subtitle", "time": 10818.07, "timestamp": "03:00:18", "text": "全部揃いましたか？ 私はその"}, {"type": "subtitle", "time": 10828.07, "timestamp": "03:00:28", "text": "さあ、入っておいで、若者。"}, {"type": "subtitle", "time": 10829.59, "timestamp": "03:00:29", "text": "眠っているのだろうか。"}, {"type": "subtitle", "time": 10831.349, "timestamp": "03:00:31", "text": "そして、あなたは決して私たちの酒場の味を忘れることはないでしょう"}]
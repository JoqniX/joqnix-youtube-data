[{"type": "subtitle", "time": 17769.35, "timestamp": "04:56:09", "text": "洞窟の中にあります。 はい、"}, {"type": "subtitle", "time": 17788.55, "timestamp": "04:56:28", "text": "至福の隠れ家を作る若き達人を知っていますか"}, {"type": "subtitle", "time": 17791.35, "timestamp": "04:56:31", "text": "？ 彼らはあれこれやったと聞いている"}, {"type": "subtitle", "time": 17815.19, "timestamp": "04:56:55", "text": "ようこそ、若い旅人よ。 座る。 座る。 何になさいますか"}]
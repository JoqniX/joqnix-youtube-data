[{"type": "subtitle", "time": 2006.549, "timestamp": "00:33:26", "text": "ああ、こうやって飛行許可や"}, {"type": "subtitle", "time": 2016.71, "timestamp": "00:33:36", "text": "。 それは落下による損傷です。 いや、それは"}, {"type": "subtitle", "time": 2020.31, "timestamp": "00:33:40", "text": "転倒で怪我をした場合、足を"}, {"type": "subtitle", "time": 2022.789, "timestamp": "00:33:42", "text": "捻挫するのと同じようなものだ。 捻挫は、"}, {"type": "subtitle", "time": 2029.43, "timestamp": "00:33:49", "text": "治療せずに放置すると、骨折に発展する可能性があります"}, {"type": "subtitle", "time": 2031.43, "timestamp": "00:33:51", "text": "。 そして、そのせいであなたは"}, {"type": "subtitle", "time": 2035.029, "timestamp": "00:33:55", "text": "不自由になるでしょう。 そこから先は、ええと、そうですね"}]
[{"type": "subtitle", "time": 13812.389, "timestamp": "03:50:12", "text": "この釣り竿、一体どういうことなんだ"}, {"type": "subtitle", "time": 13815.11, "timestamp": "03:50:15", "text": "？"}, {"type": "subtitle", "time": 13830.79, "timestamp": "03:50:30", "text": "その男は私を追い越した。"}, {"type": "subtitle", "time": 13840.79, "timestamp": "03:50:40", "text": "いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 13852.469, "timestamp": "03:50:52", "text": "釣り竿です。 間違いなく"}, {"type": "subtitle", "time": 13854.55, "timestamp": "03:50:54", "text": "釣り竿のせいだ。   私ではありません"}]
[{"type": "subtitle", "time": 26643.59, "timestamp": "07:24:03", "text": "あ、待って。うっかりリセットしちゃった。"}, {"type": "subtitle", "time": 26646.628, "timestamp": "07:24:06", "text": "よし、これは毎週のこと。"}, {"type": "subtitle", "time": 26657.19, "timestamp": "07:24:17", "text": "他の人と知識を共有するために投稿してください。"}, {"type": "subtitle", "time": 26660.31, "timestamp": "07:24:20", "text": "すごい。よし。"}, {"type": "subtitle", "time": 26663.91, "timestamp": "07:24:23", "text": "鍛冶台に行こう。"}, {"type": "subtitle", "time": 26672.628, "timestamp": "07:24:32", "text": "ポーズを3回する。あ、"}, {"type": "subtitle", "time": 26675.11, "timestamp": "07:24:35", "text": "グループ修練を完了する。でも、これって"}, {"type": "subtitle", "time": 26677.59, "timestamp": "07:24:37", "text": "文字通りマルチプレイしろって言ってるじゃないか。SLに"}]
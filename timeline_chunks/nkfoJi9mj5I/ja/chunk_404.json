[{"type": "subtitle", "time": 24243.59, "timestamp": "06:44:03", "text": "隠れるのを思い出させてくれてありがとう。"}, {"type": "subtitle", "time": 24246.868, "timestamp": "06:44:06", "text": "水を飲もう。みんなも、"}, {"type": "subtitle", "time": 24261.91, "timestamp": "06:44:21", "text": "あぁ、水を飲みすぎてむせそうになった。ああ、"}, {"type": "subtitle", "time": 24268.548, "timestamp": "06:44:28", "text": "よし、戻ってきた。[咳払い]"}, {"type": "subtitle", "time": 24278.15, "timestamp": "06:44:38", "text": "えっと、どこまで話したっけ？ここはどこ？よし、こっちだ"}, {"type": "subtitle", "time": 24285.67, "timestamp": "06:44:45", "text": "ここに宝箱があった。マークしておこう"}, {"type": "subtitle", "time": 24293.59, "timestamp": "06:44:53", "text": "[咳払い] これもマーク。"}, {"type": "subtitle", "time": 24295.27, "timestamp": "06:44:55", "text": "あ、テレポートポイントがある。"}]
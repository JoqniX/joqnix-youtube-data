[{"type": "subtitle", "time": 28572.948, "timestamp": "07:56:12", "text": "こんにちは、音楽家の方。"}, {"type": "subtitle", "time": 28581.43, "timestamp": "07:56:21", "text": "。 あるいは、これ。"}, {"type": "subtitle", "time": 28585.27, "timestamp": "07:56:25", "text": "常にメインラインに従ってください。 私は16個持っています。"}, {"type": "subtitle", "time": 28588.468, "timestamp": "07:56:28", "text": "つまり、16個です。 ニース。"}, {"type": "subtitle", "time": 28591.19, "timestamp": "07:56:31", "text": "1つ。"}]
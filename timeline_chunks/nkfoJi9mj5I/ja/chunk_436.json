[{"type": "subtitle", "time": 26160.31, "timestamp": "07:16:00", "text": "どこは 男？"}, {"type": "subtitle", "time": 26168.15, "timestamp": "07:16:08", "text": "待って、ここにNPCがいる。違う。"}, {"type": "subtitle", "time": 26186.31, "timestamp": "07:16:26", "text": "これは何？"}, {"type": "subtitle", "time": 26188.39, "timestamp": "07:16:28", "text": "雨の日の海岸には、"}, {"type": "subtitle", "time": 26191.03, "timestamp": "07:16:31", "text": "毒蛇がいて、素早く傾いた"}, {"type": "subtitle", "time": 26193.27, "timestamp": "07:16:33", "text": "ハンガーの"}, {"type": "subtitle", "time": 26202.468, "timestamp": "07:16:42", "text": "これは何？"}, {"type": "subtitle", "time": 26212.31, "timestamp": "07:16:52", "text": "よし、"}, {"type": "subtitle", "time": 26216.07, "timestamp": "07:16:56", "text": "弓の男とロボットの男をやった。他には"}]
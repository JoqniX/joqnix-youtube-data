[{"type": "subtitle", "time": 25982.948, "timestamp": "07:13:02", "text": "面白い。よし。"}, {"type": "subtitle", "time": 25990.23, "timestamp": "07:13:10", "text": "鐘を鳴らす。ああ、どの"}, {"type": "subtitle", "time": 25992.15, "timestamp": "07:13:12", "text": "ボスとも戦える。"}, {"type": "subtitle", "time": 25994.948, "timestamp": "07:13:14", "text": "ああ、"}, {"type": "subtitle", "time": 26001.35, "timestamp": "07:13:21", "text": "よし。ここに遭遇クエストがある"}, {"type": "subtitle", "time": 26003.03, "timestamp": "07:13:23", "text": "。"}, {"type": "subtitle", "time": 26006.948, "timestamp": "07:13:26", "text": "遭遇クエストがある。ああ、"}, {"type": "subtitle", "time": 26026.31, "timestamp": "07:13:46", "text": "クエスト全体だ。ああ、待って。"}, {"type": "subtitle", "time": 26027.99, "timestamp": "07:13:47", "text": "気にしないで。 わかった。"}, {"type": "subtitle", "time": 26030.468, "timestamp": "07:13:50", "text": "クエストラインだと思ってた。"}, {"type": "subtitle", "time": 26033.83, "timestamp": "07:13:53", "text": "蝶はもう見つけた。わかった。"}]
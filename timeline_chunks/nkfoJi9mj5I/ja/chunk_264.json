[{"type": "subtitle", "time": 15846.309, "timestamp": "04:24:06", "text": "見張っておくように言っただろう。 私たちは"}, {"type": "subtitle", "time": 15846.95, "timestamp": "04:24:06", "text": "今、どうすべきでしょうか？"}, {"type": "subtitle", "time": 15849.189, "timestamp": "04:24:09", "text": "なぜ全て私のせいなの？"}, {"type": "subtitle", "time": 15873.67, "timestamp": "04:24:33", "text": "レディ。"}]
[{"type": "subtitle", "time": 2886.309, "timestamp": "00:48:06", "text": "人模式嗎？"}, {"type": "subtitle", "time": 2890.71, "timestamp": "00:48:10", "text": "呃，有兩種模式。"}, {"type": "subtitle", "time": 2895.91, "timestamp": "00:48:15", "text": "單人模式和線上模式。在線模式中並沒有任何類似「沒有boss」這樣的設定。我的意思是，沒有世界首領。  嗯，這就像是一款完整的MMORPG遊戲體驗。你們和其他人一起玩"}, {"type": "subtitle", "time": 2898.63, "timestamp": "00:48:18", "text": "，一起玩遊戲，一起"}, {"type": "subtitle", "time": 2900.95, "timestamp": "00:48:20", "text": "戰鬥，進行 PvP、PE 等遊戲，一起下副本、打 Boss，參與"}, {"type": "subtitle", "time": 2915.51, "timestamp": "00:48:35", "text": "公會活動等等。單人"}]
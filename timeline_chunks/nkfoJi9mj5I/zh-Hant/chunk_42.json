[{"type": "subtitle", "time": 2526.87, "timestamp": "00:42:06", "text": "所以D，它很漂亮。"}, {"type": "subtitle", "time": 2528.63, "timestamp": "00:42:08", "text": "他們是怎麼把這個資料傳到"}, {"type": "subtitle", "time": 2536.39, "timestamp": "00:42:16", "text": "我如何才能獲得更多的測速儀？我認為"}, {"type": "subtitle", "time": 2539.829, "timestamp": "00:42:19", "text": "有些人會花錢。"}, {"type": "subtitle", "time": 2542.63, "timestamp": "00:42:22", "text": "大概是這樣。"}, {"type": "subtitle", "time": 2546.309, "timestamp": "00:42:26", "text": "哦，你可以養隻鴨子。 [笑聲]"}, {"type": "subtitle", "time": 2549.19, "timestamp": "00:42:29", "text": "從這群笨蛋手中透過"}, {"type": "subtitle", "time": 2574.55, "timestamp": "00:42:54", "text": "感覺像是《上古卷軸4：魔戒》。這"}, {"type": "subtitle", "time": 2576.789, "timestamp": "00:42:56", "text": "東西"}, {"type": "subtitle", "time": 2577.444, "timestamp": "00:42:57", "text": "[笑聲]"}]
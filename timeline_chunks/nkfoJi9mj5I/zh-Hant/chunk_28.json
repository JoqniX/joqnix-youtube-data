[{"type": "subtitle", "time": 1684.389, "timestamp": "00:28:04", "text": "呃，"}, {"type": "subtitle", "time": 1686.63, "timestamp": "00:28:06", "text": "兌換金鑰。好的。好的。等待。我該去哪裡"}, {"type": "subtitle", "time": 1690.149, "timestamp": "00:28:10", "text": "？貝塞薩。"}, {"type": "subtitle", "time": 1692.47, "timestamp": "00:28:12", "text": "我現在需要註冊一個Bethesa帳號。我的天啊。等待。"}, {"type": "subtitle", "time": 1695.149, "timestamp": "00:28:15", "text": "他們沒有"}, {"type": "subtitle", "time": 1719.75, "timestamp": "00:28:39", "text": "哦，是的。是的。知道了。 《輻射4》"}, {"type": "subtitle", "time": 1735.43, "timestamp": "00:28:55", "text": "貼到這裡。"}, {"type": "subtitle", "time": 1737.51, "timestamp": "00:28:57", "text": "複製。"}, {"type": "subtitle", "time": 1739.909, "timestamp": "00:28:59", "text": "貼。  是的"}]
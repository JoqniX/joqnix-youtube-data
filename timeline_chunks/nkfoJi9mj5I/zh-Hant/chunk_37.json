[{"type": "subtitle", "time": 2223.91, "timestamp": "00:37:03", "text": "如果你願意的話，可以把自己的照片放上去。"}, {"type": "subtitle", "time": 2229.109, "timestamp": "00:37:09", "text": "或者你也可以用自己的聲音。"}, {"type": "subtitle", "time": 2231.109, "timestamp": "00:37:11", "text": "聽到自己的聲音成為"}, {"type": "subtitle", "time": 2235.349, "timestamp": "00:37:15", "text": "遊戲角色的聲音，感覺好尷尬好"}, {"type": "subtitle", "time": 2237.829, "timestamp": "00:37:17", "text": "奇怪。嗯，我就想，“好吧，我"}, {"type": "subtitle", "time": 2241.43, "timestamp": "00:37:21", "text": "決定用默認聲音。”"}, {"type": "subtitle", "time": 2244.15, "timestamp": "00:37:24", "text": "哦，是的。你可以上傳抖音舞蹈"}, {"type": "subtitle", "time": 2255.91, "timestamp": "00:37:35", "text": "有一種方法可以讓"}, {"type": "subtitle", "time": 2258.23, "timestamp": "00:37:38", "text": "你上傳"}, {"type": "subtitle", "time": 2261.67, "timestamp": "00:37:41", "text": "3D 動作捕捉視頻，然後"}]
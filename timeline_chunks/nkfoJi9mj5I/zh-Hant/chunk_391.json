[{"type": "subtitle", "time": 23467.83, "timestamp": "06:31:07", "text": "故鄉。  這些身穿黑衣的人。  他們是莊園新來的保全嗎"}, {"type": "subtitle", "time": 23499.83, "timestamp": "06:31:39", "text": "，我稍後會做。  蒙特內哥羅.  第二種黑色物質。  噸。  是的。"}, {"type": "subtitle", "time": 23505.51, "timestamp": "06:31:45", "text": "哦，黑貓首領。哦。  B，請你"}, {"type": "subtitle", "time": 23508.788, "timestamp": "06:31:48", "text": "省錢。好吧"}, {"type": "subtitle", "time": 23514.39, "timestamp": "06:31:54", "text": "，行"}, {"type": "subtitle", "time": 23517.03, "timestamp": "06:31:57", "text": "。"}]
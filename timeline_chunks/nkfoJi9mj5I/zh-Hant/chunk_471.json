[{"type": "subtitle", "time": 28282.548, "timestamp": "07:51:22", "text": "細節做得真好。看"}, {"type": "subtitle", "time": 28287.43, "timestamp": "07:51:27", "text": "，我真的在泥巴裡。哇。不錯。旅行者，站住，交付。把你的錢給我。哦"}, {"type": "subtitle", "time": 28293.03, "timestamp": "07:51:33", "text": "，他不是MPC。好的"}, {"type": "subtitle", "time": 28300.548, "timestamp": "07:51:40", "text": "，他只是在胡說八道。就是這樣。一隻"}, {"type": "subtitle", "time": 28306.15, "timestamp": "07:51:46", "text": "膽小鬼。好的。好的，我在這裡收尾。要嘛你上去，要嘛我就殺了你。好吧"}, {"type": "subtitle", "time": 28308.468, "timestamp": "07:51:48", "text": "，最後通牒。好吧，我這就做完就走。好的。"}]
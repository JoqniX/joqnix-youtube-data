[{"type": "subtitle", "time": 25990.23, "timestamp": "07:13:10", "text": "射箭時間。學習射箭。 2012年"}, {"type": "subtitle", "time": 26001.35, "timestamp": "07:13:21", "text": "過渡挑戰"}, {"type": "subtitle", "time": 26006.948, "timestamp": "07:13:26", "text": "。開始吧。 1 2 3 4 5 6 7 8。我即時表現很差勁。艾薩克即時表現很差勁。我更好了。我仍然更好。 ["}, {"type": "subtitle", "time": 26026.31, "timestamp": "07:13:46", "text": "哦，我實際上三個都做到了。你在幹什麼？你在這裡幹什麼？你在幹什麼？哦"}, {"type": "subtitle", "time": 26027.99, "timestamp": "07:13:47", "text": "。呃，武術大師教我前輩。謝謝老師。謝謝您的指導。您真"}]
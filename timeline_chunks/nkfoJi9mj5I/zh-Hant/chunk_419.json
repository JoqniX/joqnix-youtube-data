[{"type": "subtitle", "time": 25144.548, "timestamp": "06:59:04", "text": "嗯，哦，你在這兒。我到處大聲找你。"}, {"type": "subtitle", "time": 25149.59, "timestamp": "06:59:09", "text": "不。所以，我想"}, {"type": "subtitle", "time": 25165.19, "timestamp": "06:59:25", "text": "我都做對了。嗯，我拿到那個寶箱了。我拿到了那個寶箱。所以，接下來就是射箭。而且，呃，為什麼我感覺這條河裡有什麼東西？哦，可以走。"}, {"type": "subtitle", "time": 25180.548, "timestamp": "06:59:40", "text": "關鍵是瀑布後面有寶藏。這遊戲喜歡把寶藏放在瀑布後面。哦。哦"}]
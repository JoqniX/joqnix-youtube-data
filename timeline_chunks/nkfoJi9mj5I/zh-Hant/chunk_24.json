[{"type": "subtitle", "time": 1452.07, "timestamp": "00:24:12", "text": "那真是太有趣了。閒聊。"}, {"type": "subtitle", "time": 1456.23, "timestamp": "00:24:16", "text": "是啊，他是個大塊頭。"}, {"type": "subtitle", "time": 1459.11, "timestamp": "00:24:19", "text": "內部的。"}, {"type": "subtitle", "time": 1462.63, "timestamp": "00:24:22", "text": "哦，你是說那堆東西吧？我們來"}, {"type": "subtitle", "time": 1473.029, "timestamp": "00:24:33", "text": "在你的種族裡，夥計。為什麼頁面會"}, {"type": "subtitle", "time": 1473.909, "timestamp": "00:24:33", "text": "缺失？"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "呃，這都是我的錯。我以為那隻是一張"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "紙。問題是我"}, {"type": "subtitle", "time": 1481.51, "timestamp": "00:24:41", "text": "在路上胃不舒服，不得不……"}, {"type": "subtitle", "time": 1484.149, "timestamp": "00:24:44", "text": "哇。"}, {"type": "subtitle", "time": 1486.549, "timestamp": "00:24:46", "text": "那是紙嗎？"}, {"type": "subtitle", "time": 1489.19, "timestamp": "00:24:49", "text": "這是我所屬教派雷恩"}]
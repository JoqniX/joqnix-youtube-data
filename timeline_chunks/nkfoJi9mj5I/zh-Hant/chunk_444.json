[{"type": "subtitle", "time": 26643.59, "timestamp": "07:24:03", "text": "哦，等等。遭遇戰的意思是抓捕罪犯，或像那些偷竊、扒竊的人。"}, {"type": "subtitle", "time": 26663.91, "timestamp": "07:24:23", "text": "軟管把他們從背後帶走。把他們帶到……呃，比如警察……呃，我不知道，"}, {"type": "subtitle", "time": 26675.11, "timestamp": "07:24:35", "text": "治安官什麼的，我不知道，總之是一些重要人物，他們會"}, {"type": "subtitle", "time": 26677.59, "timestamp": "07:24:37", "text": "處理"}]
[{"type": "subtitle", "time": 24604.788, "timestamp": "06:50:04", "text": "。"}, {"type": "subtitle", "time": 24607.75, "timestamp": "06:50:07", "text": "哦，红色总是像一朵花。呃，"}, {"type": "subtitle", "time": 24611.27, "timestamp": "06:50:11", "text": "你现在得跟着这个。我的天。"}, {"type": "subtitle", "time": 24614.708, "timestamp": "06:50:14", "text": "红色的那个总是跟着。明白了。黄色的"}, {"type": "subtitle", "time": 24625.35, "timestamp": "06:50:25", "text": "告诉他他很漂亮，而且是个很棒的"}, {"type": "subtitle", "time": 24627.35, "timestamp": "06:50:27", "text": "剑士。好的，我这就去。我要"}, {"type": "subtitle", "time": 24657.99, "timestamp": "06:50:57", "text": "哦，又一个传送点。就是这儿。我"}]
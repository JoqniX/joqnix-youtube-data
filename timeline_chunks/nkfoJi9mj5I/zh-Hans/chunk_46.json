[{"type": "subtitle", "time": 2765.27, "timestamp": "00:46:05", "text": "67梗的核心在于它"}, {"type": "subtitle", "time": 2767.99, "timestamp": "00:46:07", "text": "故意毫无意义。"}, {"type": "subtitle", "time": 2770.23, "timestamp": "00:46:10", "text": "它的吸引力在于它的滑稽性，以及"}, {"type": "subtitle", "time": 2774.55, "timestamp": "00:46:14", "text": "它作为一种共享的荒谬代码的功能，"}, {"type": "subtitle", "time": 2778.55, "timestamp": "00:46:18", "text": "表明属于某个年轻人群体，"}, {"type": "subtitle", "time": 2783.03, "timestamp": "00:46:23", "text": "呃，引用一下，就是“明白这个"}, {"type": "subtitle", "time": 2786.55, "timestamp": "00:46:26", "text": "笑话”。 虽然有些人试图"}, {"type": "subtitle", "time": 2789.51, "timestamp": "00:46:29", "text": "赋予它某种含义，认为它意味着某某，"}, {"type": "subtitle", "time": 2805.91, "timestamp": "00:46:45", "text": "我不知道，伙计，我的"}]
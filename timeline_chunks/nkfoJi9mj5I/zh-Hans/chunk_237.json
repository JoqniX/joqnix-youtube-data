[{"type": "subtitle", "time": 14224.95, "timestamp": "03:57:04", "text": "那是只鸭子吗？"}, {"type": "subtitle", "time": 14227.91, "timestamp": "03:57:07", "text": "一个养鸭子的人。 我不用。 我只是四处"}, {"type": "subtitle", "time": 14229.59, "timestamp": "03:57:09", "text": "探索，看看能不能找到宝箱。"}, {"type": "subtitle", "time": 14231.91, "timestamp": "03:57:11", "text": "是的，看来这款"}, {"type": "subtitle", "time": 14235.189, "timestamp": "03:57:15", "text": "游戏的内容不只是找到宝箱而已。 就像"}, {"type": "subtitle", "time": 14237.59, "timestamp": "03:57:17", "text": "你看到的，我把这里所有的箱子都打开了"}, {"type": "subtitle", "time": 14242.389, "timestamp": "03:57:22", "text": "，但是还是只有 45 个。"}, {"type": "subtitle", "time": 14246.15, "timestamp": "03:57:26", "text": "所以你必须和 NPC 对话互动"}, {"type": "subtitle", "time": 14251.11, "timestamp": "03:57:31", "text": "。 所有NPC，"}, {"type": "subtitle", "time": 14253.11, "timestamp": "03:57:33", "text": "收集隐藏线索等等。   是的"}, {"type": "subtitle", "time": 14257.03, "timestamp": "03:57:37", "text": "。 这些人说话都显得很友好。"}, {"type": "subtitle", "time": 14259.429, "timestamp": "03:57:39", "text": "你必须做"}, {"type": "subtitle", "time": 14262.71, "timestamp": "03:57:42", "text": "Conver AI 聊天相关的工作，对吧？"}, {"type": "subtitle", "time": 14267.11, "timestamp": "03:57:47", "text": "去和每个人都成为朋友。"}, {"type": "subtitle", "time": 14271.91, "timestamp": "03:57:51", "text": "好多东西。 这太疯狂了。   太"}]
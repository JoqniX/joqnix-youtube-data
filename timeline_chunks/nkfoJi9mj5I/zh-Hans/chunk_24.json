[{"type": "subtitle", "time": 1452.07, "timestamp": "00:24:12", "text": "那真是太有趣了。 闲聊。"}, {"type": "subtitle", "time": 1456.23, "timestamp": "00:24:16", "text": "是啊，他是个大块头。"}, {"type": "subtitle", "time": 1459.11, "timestamp": "00:24:19", "text": "内部的。"}, {"type": "subtitle", "time": 1462.63, "timestamp": "00:24:22", "text": "哦，你是说那堆东西吧？"}, {"type": "subtitle", "time": 1473.029, "timestamp": "00:24:33", "text": "在你的种族里，伙计。 为什么页面会"}, {"type": "subtitle", "time": 1473.909, "timestamp": "00:24:33", "text": "缺失？"}, {"type": "subtitle", "time": 1476.87, "timestamp": "00:24:36", "text": "呃，这都是我的错。 我以为那只是一张"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "纸。 问题是我"}, {"type": "subtitle", "time": 1481.51, "timestamp": "00:24:41", "text": "在路上胃不舒服，不得不……"}, {"type": "subtitle", "time": 1484.149, "timestamp": "00:24:44", "text": "哇。"}, {"type": "subtitle", "time": 1486.549, "timestamp": "00:24:46", "text": "那是纸吗？"}, {"type": "subtitle", "time": 1489.19, "timestamp": "00:24:49", "text": "这是我所属教派雷恩"}]
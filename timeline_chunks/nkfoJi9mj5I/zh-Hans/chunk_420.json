[{"type": "subtitle", "time": 25205.35, "timestamp": "07:00:05", "text": "不要帮我，因为你在妨碍我。"}, {"type": "subtitle", "time": 25214.868, "timestamp": "07:00:14", "text": "哦，我的天哪，他太暴躁了。哦，我的天哪。"}, {"type": "subtitle", "time": 25217.75, "timestamp": "07:00:17", "text": "为什么？"}, {"type": "subtitle", "time": 25225.64, "timestamp": "07:00:25", "text": "他……你的愤怒[笑声]"}, {"type": "subtitle", "time": 25228.628, "timestamp": "07:00:28", "text": "[倒吸一口凉气] 控制情绪。"}, {"type": "subtitle", "time": 25241.83, "timestamp": "07:00:41", "text": "我会给你一张藏宝图来帮你"}, {"type": "subtitle", "time": 25244.07, "timestamp": "07:00:44", "text": "。"}, {"type": "subtitle", "time": 25250.628, "timestamp": "07:00:50", "text": "你有什么目的？"}, {"type": "subtitle", "time": 25255.03, "timestamp": "07:00:55", "text": "为什么不呢？我喜欢"}, {"type": "subtitle", "time": 25257.51, "timestamp": "07:00:57", "text": "帮助别人。"}]
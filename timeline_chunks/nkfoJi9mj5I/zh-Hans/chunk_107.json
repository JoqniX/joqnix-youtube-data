[{"type": "subtitle", "time": 6434.55, "timestamp": "01:47:14", "text": "你的课怎么样？ 嗯，还不错。"}, {"type": "subtitle", "time": 6437.43, "timestamp": "01:47:17", "text": "挺好的。"}, {"type": "subtitle", "time": 6440.87, "timestamp": "01:47:20", "text": "今天我学了六个汉字。 我"}, {"type": "subtitle", "time": 6443.35, "timestamp": "01:47:23", "text": "已经把它们忘了。 我的意思是，我记得"}, {"type": "subtitle", "time": 6457.03, "timestamp": "01:47:37", "text": "喝点水。"}, {"type": "subtitle", "time": 6459.59, "timestamp": "01:47:39", "text": "中午活动。 实际上那是一场夜间"}, {"type": "subtitle", "time": 6462.47, "timestamp": "01:47:42", "text": "活动，大概是晚上7点左右。"}, {"type": "subtitle", "time": 6471.51, "timestamp": "01:47:51", "text": "不知何故，时间又改回了晚上"}]
[{"type": "subtitle", "time": 7262.149, "timestamp": "02:01:02", "text": "等一下。"}, {"type": "subtitle", "time": 7265.35, "timestamp": "02:01:05", "text": "我们在这场比赛中排名第16。"}, {"type": "subtitle", "time": 7267.91, "timestamp": "02:01:07", "text": "我们为什么要喝酒？"}, {"type": "subtitle", "time": 7270.629, "timestamp": "02:01:10", "text": "哦，那已经是旧时代了。 好吧，那是"}, {"type": "subtitle", "time": 7280.47, "timestamp": "02:01:20", "text": "也许吧。 好吧，我觉得这里很正常。"}, {"type": "subtitle", "time": 7286.47, "timestamp": "02:01:26", "text": "好了，黑屏了。 这意味着有事情正在"}, {"type": "subtitle", "time": 7287.91, "timestamp": "02:01:27", "text": "发生。 他们要来"}, {"type": "subtitle", "time": 7292.31, "timestamp": "02:01:32", "text": "抢劫我们。 他们会背叛我们。"}, {"type": "subtitle", "time": 7295.27, "timestamp": "02:01:35", "text": "他们把我们扔进了一个奇怪的地方，像个地牢。"}, {"type": "subtitle", "time": 7304.709, "timestamp": "02:01:44", "text": "什么？ 决不。 我们被卷入了一场闹剧，成了替罪羊"}]
[{"type": "subtitle", "time": 2868.55, "timestamp": "00:47:48", "text": "这款游戏主要是单人模式吗？ 呃，"}, {"type": "subtitle", "time": 2871.589, "timestamp": "00:47:51", "text": "有两种模式。 单人模式和在线"}, {"type": "subtitle", "time": 2874.95, "timestamp": "00:47:54", "text": "模式。 在线模式中并没有任何"}, {"type": "subtitle", "time": 2879.03, "timestamp": "00:47:59", "text": "类似“没有boss”这样的设定。 我的意思是，没有世界首领。"}]
[{"type": "subtitle", "time": 27662.868, "timestamp": "07:41:02", "text": "难怪这边没有boss。"}, {"type": "subtitle", "time": 27666.868, "timestamp": "07:41:06", "text": "绿巨人，旅行者，站住，交付。"}, {"type": "subtitle", "time": 27669.99, "timestamp": "07:41:09", "text": "把你的钱给我。"}, {"type": "subtitle", "time": 27708.468, "timestamp": "07:41:48", "text": "好吧。"}]
[{"type": "subtitle", "time": 27062.468, "timestamp": "07:31:02", "text": "你卖呃……我的天哪。这个……我的天哪。我的天哪。我的天哪。我的天哪"}, {"type": "subtitle", "time": 27078.07, "timestamp": "07:31:18", "text": "使用天界技能。天界技能是什么"}, {"type": "subtitle", "time": 27080.948, "timestamp": "07:31:20", "text": "？"}, {"type": "subtitle", "time": 27097.59, "timestamp": "07:31:37", "text": "等等，如果我中毒了，"}, {"type": "subtitle", "time": 27115.19, "timestamp": "07:31:55", "text": "很蠢？咚咚咚咚咚咚咚咚咚咚。"}, {"type": "subtitle", "time": 27117.91, "timestamp": "07:31:57", "text": "我太蠢了。真是太蠢了。[笑声]"}]
[{"type": "subtitle", "time": 25445.83, "timestamp": "07:04:05", "text": "好吧，我也做到了。嗯，他居然能"}, {"type": "subtitle", "time": 25454.15, "timestamp": "07:04:14", "text": "哦，不。不，不，不，不，不，不，不，不，不"}, {"type": "subtitle", "time": 25460.07, "timestamp": "07:04:20", "text": "到底在哪里？好吧。好吧。好吧。加油。加油。加油。"}, {"type": "subtitle", "time": 25469.75, "timestamp": "07:04:29", "text": "哦，它好快。它居然能"}, {"type": "subtitle", "time": 25472.468, "timestamp": "07:04:32", "text": "跟上我。不。啊。"}, {"type": "subtitle", "time": 25479.51, "timestamp": "07:04:39", "text": "好吧，我拿到了150分。我的天哪。求你失败吧"}, {"type": "subtitle", "time": 25483.75, "timestamp": "07:04:43", "text": "。求你失败吧。求你失败吧。求你失败吧。求你"}, {"type": "subtitle", "time": 25490.23, "timestamp": "07:04:50", "text": "分。好吧。194分。不过我做得更好。我"}, {"type": "subtitle", "time": 25493.11, "timestamp": "07:04:53", "text": "做得更好。我做得更好。我做得更好。是的"}, {"type": "subtitle", "time": 25496.23, "timestamp": "07:04:56", "text": "。他失败了。他失败了。"}, {"type": "subtitle", "time": 25499.43, "timestamp": "07:04:59", "text": "等等。不。不。不。"}]
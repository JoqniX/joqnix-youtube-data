[{"type": "subtitle", "time": 2965.27, "timestamp": "00:49:25", "text": "伙计们，放逐之地就在前面不远处着火了"}, {"type": "subtitle", "time": 2968.39, "timestamp": "00:49:28", "text": "。 蘑菇位于"}, {"type": "subtitle", "time": 2971.51, "timestamp": "00:49:31", "text": "月亮峰南边。"}, {"type": "subtitle", "time": 2973.91, "timestamp": "00:49:33", "text": "关注提醒在哪里？ 明显的"}, {"type": "subtitle", "time": 2976.63, "timestamp": "00:49:36", "text": "叠加。 哦，是的。 有趣的是，我没有设置"}, {"type": "subtitle", "time": 2979.67, "timestamp": "00:49:39", "text": "关注提醒。   有趣的是"}, {"type": "subtitle", "time": 2992.79, "timestamp": "00:49:52", "text": "哇，我什么都有了。"}, {"type": "subtitle", "time": 2996.069, "timestamp": "00:49:56", "text": "决不。 我什么都拿到了。"}]
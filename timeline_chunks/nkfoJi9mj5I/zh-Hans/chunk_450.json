[{"type": "subtitle", "time": 27000.15, "timestamp": "07:30:00", "text": "我是从这里拿到的吗？哦，对。"}, {"type": "subtitle", "time": 27004.548, "timestamp": "07:30:04", "text": "还有，这边也有一个宝箱"}, {"type": "subtitle", "time": 27049.67, "timestamp": "07:30:49", "text": "天哪，那是条蛇。我的天哪，那是条蛇。"}, {"type": "subtitle", "time": 27051.03, "timestamp": "07:30:51", "text": "那是条蛇。那是条蛇。"}, {"type": "subtitle", "time": 27056.07, "timestamp": "07:30:56", "text": "啊，等等。"}, {"type": "subtitle", "time": 27059.43, "timestamp": "07:30:59", "text": "蛇是什么科的？"}]
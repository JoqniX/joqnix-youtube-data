[{"type": "subtitle", "time": 23521.11, "timestamp": "06:32:01", "text": "进展顺利。 呃，你的直播怎么样"}, {"type": "subtitle", "time": 23525.19, "timestamp": "06:32:05", "text": "？ 你好。 进来吧。"}, {"type": "subtitle", "time": 23528.23, "timestamp": "06:32:08", "text": "直播怎么样？"}, {"type": "subtitle", "time": 23532.548, "timestamp": "06:32:12", "text": "希望你今天的直播很顺利。"}, {"type": "subtitle", "time": 23538.548, "timestamp": "06:32:18", "text": "等等，你今天直播了什么？"}, {"type": "subtitle", "time": 23540.39, "timestamp": "06:32:20", "text": "你直播了什么？ 哦，你当时也在直播见面会"}, {"type": "subtitle", "time": 23544.31, "timestamp": "06:32:24", "text": "。 哦，不错。"}, {"type": "subtitle", "time": 23548.15, "timestamp": "06:32:28", "text": "第一次。 哦，不错。 希望一切顺利。"}, {"type": "subtitle", "time": 23551.19, "timestamp": "06:32:31", "text": "希望你玩得开心。"}, {"type": "subtitle", "time": 23558.628, "timestamp": "06:32:38", "text": "[笑声] 我，我"}, {"type": "subtitle", "time": 23560.708, "timestamp": "06:32:40", "text": "最近才开始玩，"}, {"type": "subtitle", "time": 23564.948, "timestamp": "06:32:44", "text": "我一直在努力探索，"}, {"type": "subtitle", "time": 23567.67, "timestamp": "06:32:47", "text": "探索，[笑声]"}, {"type": "subtitle", "time": 23570.468, "timestamp": "06:32:50", "text": "扫描并收集"}, {"type": "subtitle", "time": 23574.31, "timestamp": "06:32:54", "text": "每个区域的每个角落。"}, {"type": "subtitle", "time": 23576.708, "timestamp": "06:32:56", "text": "太过分了。"}, {"type": "subtitle", "time": 23578.948, "timestamp": "06:32:58", "text": "这款游戏里包含的东西太多了。"}, {"type": "subtitle", "time": 23579.67, "timestamp": "06:32:59", "text": "哦（笑声和惊叹声）是啊，这真是"}]
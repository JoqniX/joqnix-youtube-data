[{"type": "subtitle", "time": 10818.07, "timestamp": "03:00:18", "text": "我都拿到了吗？ 我会揭露这段"}, {"type": "subtitle", "time": 10828.07, "timestamp": "03:00:28", "text": "进来吧，年轻人。"}, {"type": "subtitle", "time": 10829.59, "timestamp": "03:00:29", "text": "我不知道她是不是睡着了。"}, {"type": "subtitle", "time": 10831.349, "timestamp": "03:00:31", "text": "你永远不会忘记我们"}]
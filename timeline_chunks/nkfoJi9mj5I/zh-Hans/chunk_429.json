[{"type": "subtitle", "time": 25746.07, "timestamp": "07:09:06", "text": "谢谢您的"}, {"type": "subtitle", "time": 25764.07, "timestamp": "07:09:24", "text": "我也想成为像"}, {"type": "subtitle", "time": 25769.95, "timestamp": "07:09:29", "text": "您一样伟大的剑术大师。眨眼。哦，不错。"}, {"type": "subtitle", "time": 25771.19, "timestamp": "07:09:31", "text": "[笑]"}, {"type": "subtitle", "time": 25773.35, "timestamp": "07:09:33", "text": "我今天状态真好。我能"}, {"type": "subtitle", "time": 25777.03, "timestamp": "07:09:37", "text": "这么快就搞定他们。怎么做到的？"}, {"type": "subtitle", "time": 25779.35, "timestamp": "07:09:39", "text": "太不可思议了。"}, {"type": "subtitle", "time": 25785.19, "timestamp": "07:09:45", "text": "不错。"}, {"type": "subtitle", "time": 25798.23, "timestamp": "07:09:58", "text": "易山在睡觉。睡觉。很晚了。"}]
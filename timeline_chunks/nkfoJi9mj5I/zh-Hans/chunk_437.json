[{"type": "subtitle", "time": 26226.23, "timestamp": "07:17:06", "text": "哦，有个家伙好像在"}, {"type": "subtitle", "time": 26228.868, "timestamp": "07:17:08", "text": "练瑜伽什么的。少林之类的，就在"}, {"type": "subtitle", "time": 26235.19, "timestamp": "07:17:15", "text": "等等，是那块石头，对吧？哦，不不不。是"}, {"type": "subtitle", "time": 26254.708, "timestamp": "07:17:34", "text": "哦，我刚刚躲过了摔伤。不错。"}, {"type": "subtitle", "time": 26257.19, "timestamp": "07:17:37", "text": "这次我没摔断腿。好吧。对，"}, {"type": "subtitle", "time": 26263.59, "timestamp": "07:17:43", "text": "这边好像有个家伙在练瑜伽，"}, {"type": "subtitle", "time": 26267.03, "timestamp": "07:17:47", "text": "就像把胳膊举起来，"}]
[{"type": "subtitle", "time": 28981.27, "timestamp": "08:03:01", "text": "明天能不能直播。"}, {"type": "subtitle", "time": 28984.388, "timestamp": "08:03:04", "text": "呃，我不知道明天会不会直播。"}, {"type": "subtitle", "time": 28986.548, "timestamp": "08:03:06", "text": "是的，我得直播了。 好的。 星期五。"}, {"type": "subtitle", "time": 28989.59, "timestamp": "08:03:09", "text": "不。是的。 所以，所以，所以，我总是"}, {"type": "subtitle", "time": 28992.388, "timestamp": "08:03:12", "text": "忘记。 嗨，哥们。 这款游戏内容非常丰富"}, {"type": "subtitle", "time": 28996.31, "timestamp": "08:03:16", "text": "。 真是太疯狂了（笑）。   是的"}, {"type": "subtitle", "time": 28999.67, "timestamp": "08:03:19", "text": "。 你好。 今天过得很开心。 我很喜欢"}, {"type": "subtitle", "time": 29003.03, "timestamp": "08:03:23", "text": "。  Aola也表现不错。"}, {"type": "subtitle", "time": 29005.35, "timestamp": "08:03:25", "text": "还有，一秒钟。"}, {"type": "subtitle", "time": 29008.868, "timestamp": "08:03:28", "text": "我只想念一下"}, {"type": "subtitle", "time": 29012.548, "timestamp": "08:03:32", "text": "今天来过的人以及发生的事件。"}, {"type": "subtitle", "time": 29018.23, "timestamp": "08:03:38", "text": "一秒钟。 呃，是在Twitch上直播的，对吧？"}, {"type": "subtitle", "time": 29022.31, "timestamp": "08:03:42", "text": "等等，我的YouTube直播还在进行吗？"}, {"type": "subtitle", "time": 29024.868, "timestamp": "08:03:44", "text": "希望我当时没有断线。"}, {"type": "subtitle", "time": 29026.948, "timestamp": "08:03:46", "text": "今天我的Twitch直播突然"}, {"type": "subtitle", "time": 29028.388, "timestamp": "08:03:48", "text": "莫名其妙地断线了。 我不知道为什么"}, {"type": "subtitle", "time": 29032.628, "timestamp": "08:03:52", "text": "多路流媒体播放器会连接上它，但确实如此。"}, {"type": "subtitle", "time": 29037.91, "timestamp": "08:03:57", "text": "你好，YouTube 可以正常运行。 你好。"}]
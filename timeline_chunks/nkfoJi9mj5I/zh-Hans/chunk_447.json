[{"type": "subtitle", "time": 26829.11, "timestamp": "07:27:09", "text": "胸甲吗？好的，是胸甲。"}, {"type": "subtitle", "time": 26832.07, "timestamp": "07:27:12", "text": "我要"}, {"type": "subtitle", "time": 26842.23, "timestamp": "07:27:22", "text": "潜行了。如果我能分散"}, {"type": "subtitle", "time": 26844.868, "timestamp": "07:27:24", "text": "他们的注意力，比如扔块石头什么的，让"}, {"type": "subtitle", "time": 26848.07, "timestamp": "07:27:28", "text": "他们过来查看，然后我抓住他们的"}, {"type": "subtitle", "time": 26851.75, "timestamp": "07:27:31", "text": "衣领或者脖子，然后扑倒他们，把"}, {"type": "subtitle", "time": 26854.07, "timestamp": "07:27:34", "text": "他们打晕"}, {"type": "subtitle", "time": 26856.548, "timestamp": "07:27:36", "text": "或者干掉他们。那该多好啊"}]
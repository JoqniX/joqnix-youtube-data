[{"type": "subtitle", "time": 18305.75, "timestamp": "05:05:05", "text": "太多事情了。 没完没了。"}, {"type": "subtitle", "time": 18308.628, "timestamp": "05:05:08", "text": "我应该点八杯拉面还是鸡蛋"}, {"type": "subtitle", "time": 18311.59, "timestamp": "05:05:11", "text": "三明治？ 无法选择。"}, {"type": "subtitle", "time": 18314.948, "timestamp": "05:05:14", "text": "等等，你是在点餐，还是"}, {"type": "subtitle", "time": 18332.47, "timestamp": "05:05:32", "text": "啊，是的。 好的。 你觉得什么"}, {"type": "subtitle", "time": 18336.15, "timestamp": "05:05:36", "text": "能让你感到饱腹"}, {"type": "subtitle", "time": 18341.35, "timestamp": "05:05:41", "text": "和满足？"}, {"type": "subtitle", "time": 18345.03, "timestamp": "05:05:45", "text": "鸡蛋三明治可以吗？ 这样"}, {"type": "subtitle", "time": 18352.47, "timestamp": "05:05:52", "text": "杯面。 杯杯公羊。 是杯面吗？"}, {"type": "subtitle", "time": 18354.868, "timestamp": "05:05:54", "text": "哦，对啊，如果是杯面的话，我的意思是，你一边"}, {"type": "subtitle", "time": 18359.83, "timestamp": "05:05:59", "text": "吸溜着"}]
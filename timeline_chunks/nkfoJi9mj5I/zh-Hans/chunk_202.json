[{"type": "subtitle", "time": 12135.11, "timestamp": "03:22:15", "text": "对不起。"}, {"type": "subtitle", "time": 12138.87, "timestamp": "03:22:18", "text": "好吧，我想我得走了。"}, {"type": "subtitle", "time": 12175.429, "timestamp": "03:22:55", "text": "糟了。"}, {"type": "subtitle", "time": 12178.15, "timestamp": "03:22:58", "text": "笨蛋，傻瓜，笨蛋，蠢货。 我的天啊。"}]
[{"type": "subtitle", "time": 17769.35, "timestamp": "04:56:09", "text": "位于洞穴内部。 好了，我已经这么做了"}, {"type": "subtitle", "time": 17788.55, "timestamp": "04:56:28", "text": "你认识那位隐居的青年大师吗"}, {"type": "subtitle", "time": 17791.35, "timestamp": "04:56:31", "text": "？ 我听说他们做了这个，"}, {"type": "subtitle", "time": 17815.19, "timestamp": "04:56:55", "text": "欢迎你，年轻的旅行者。 坐。 坐。 您"}]
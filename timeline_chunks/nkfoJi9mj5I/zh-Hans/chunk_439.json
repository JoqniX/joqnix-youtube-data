[{"type": "subtitle", "time": 26340.708, "timestamp": "07:19:00", "text": "哦，等等。遭遇战的意思是"}, {"type": "subtitle", "time": 26344.15, "timestamp": "07:19:04", "text": "抓捕罪犯，或者像那些"}, {"type": "subtitle", "time": 26348.15, "timestamp": "07:19:08", "text": "偷窃、扒窃的人。你要让"}, {"type": "subtitle", "time": 26351.83, "timestamp": "07:19:11", "text": "他们免疫。不是那种完全无法"}, {"type": "subtitle", "time": 26353.99, "timestamp": "07:19:13", "text": "移动的免疫。"}, {"type": "subtitle", "time": 26356.23, "timestamp": "07:19:16", "text": "用那种无法移动的技能，然后"}, {"type": "subtitle", "time": 26358.23, "timestamp": "07:19:18", "text": "当场抓住他们，"}, {"type": "subtitle", "time": 26363.19, "timestamp": "07:19:23", "text": "用软管把他们从背后带走"}, {"type": "subtitle", "time": 26369.11, "timestamp": "07:19:29", "text": "。把他们带到……呃，比如警察……"}, {"type": "subtitle", "time": 26374.15, "timestamp": "07:19:34", "text": "呃，我不知道，治安官什么的，"}, {"type": "subtitle", "time": 26378.31, "timestamp": "07:19:38", "text": "我不知道，总之是一些重要人物，他们会"}]
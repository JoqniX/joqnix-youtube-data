[{"type": "subtitle", "time": 23700.868, "timestamp": "06:35:00", "text": "战略 战略 战略 战略 战略之"}, {"type": "subtitle", "time": 23703.91, "timestamp": "06:35:03", "text": "剑。 我的天，这发音也太奇怪了吧"}, {"type": "subtitle", "time": 23706.948, "timestamp": "06:35:06", "text": "。 我的天啊。"}, {"type": "subtitle", "time": 23709.43, "timestamp": "06:35:09", "text": "战略性战略。"}, {"type": "subtitle", "time": 23713.51, "timestamp": "06:35:13", "text": "我的天啊。 它叫什么来着？"}, {"type": "subtitle", "time": 23717.99, "timestamp": "06:35:17", "text": "什么是战略战略之剑。"}, {"type": "subtitle", "time": 23719.83, "timestamp": "06:35:19", "text": "好的。"}, {"type": "subtitle", "time": 23729.67, "timestamp": "06:35:29", "text": "我明白了。 不，我没打开它。 我"}, {"type": "subtitle", "time": 23731.19, "timestamp": "06:35:31", "text": "通常不玩这类游戏，"}, {"type": "subtitle", "time": 23733.03, "timestamp": "06:35:33", "text": "但因为它是免费的，所以我想试试。   是的"}, {"type": "subtitle", "time": 23736.31, "timestamp": "06:35:36", "text": "，它是免费的。 它有点像《原"}, {"type": "subtitle", "time": 23740.548, "timestamp": "06:35:40", "text": "神》和《刺客信条》，"}, {"type": "subtitle", "time": 23743.03, "timestamp": "06:35:43", "text": "也有点像《上古环》之类的游戏。"}, {"type": "subtitle", "time": 23745.83, "timestamp": "06:35:45", "text": "这些游戏结合在一起，诞生了一个孩子。 你得到了"}, {"type": "subtitle", "time": 23753.11, "timestamp": "06:35:53", "text": "而且它是免费的。 你相信吗？ 还有"}, {"type": "subtitle", "time": 23755.99, "timestamp": "06:35:55", "text": "那个扭蛋游戏。"}, {"type": "subtitle", "time": 23759.83, "timestamp": "06:35:59", "text": "他们那里唯一有的东西就是化妆品了。"}]
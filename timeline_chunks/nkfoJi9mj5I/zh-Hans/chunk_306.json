[{"type": "subtitle", "time": 18361.99, "timestamp": "05:06:01", "text": "面条，一边喝水。 所以"}, {"type": "subtitle", "time": 18365.99, "timestamp": "05:06:05", "text": "我们可以喝这水。 你会"}, {"type": "subtitle", "time": 18370.23, "timestamp": "05:06:10", "text": "得到水分补充，而且[笑声]"}, {"type": "subtitle", "time": 18373.03, "timestamp": "05:06:13", "text": "晚上还有面包吃。 我的意思是，"}, {"type": "subtitle", "time": 18375.91, "timestamp": "05:06:15", "text": "只要能填饱肚子，什么方法都行"}, {"type": "subtitle", "time": 18379.51, "timestamp": "05:06:19", "text": "，"}, {"type": "subtitle", "time": 18382.23, "timestamp": "05:06:22", "text": "我觉得。 什么？ 你通常几点"}, {"type": "subtitle", "time": 18385.35, "timestamp": "05:06:25", "text": "吃晚饭？"}, {"type": "subtitle", "time": 18387.83, "timestamp": "05:06:27", "text": "你通常几点吃晚饭？"}, {"type": "subtitle", "time": 18390.948, "timestamp": "05:06:30", "text": "我现在饿了。 哇。"}, {"type": "subtitle", "time": 18408.628, "timestamp": "05:06:48", "text": "这只会导致迟到。 是啊，我也是。"}, {"type": "subtitle", "time": 18411.43, "timestamp": "05:06:51", "text": "我也想做点什么，比如"}]
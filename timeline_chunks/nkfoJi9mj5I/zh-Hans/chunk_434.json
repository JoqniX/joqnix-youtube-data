[{"type": "subtitle", "time": 26043.35, "timestamp": "07:14:03", "text": "那就是宝箱。好吧。"}, {"type": "subtitle", "time": 26048.868, "timestamp": "07:14:08", "text": "这玩意儿太卡了。我希望他们能把"}, {"type": "subtitle", "time": 26050.788, "timestamp": "07:14:10", "text": "互动地图，他们的"}, {"type": "subtitle", "time": 26053.11, "timestamp": "07:14:13", "text": "官方地图，也放上来。 全球互动地图"}, {"type": "subtitle", "time": 26054.788, "timestamp": "07:14:14", "text": "。"}, {"type": "subtitle", "time": 26057.83, "timestamp": "07:14:17", "text": "中文地图不错，但如果你把"}, {"type": "subtitle", "time": 26062.15, "timestamp": "07:14:22", "text": "所有标记都打开，"}, {"type": "subtitle", "time": 26066.15, "timestamp": "07:14:26", "text": "然后一个一个地标记"}, {"type": "subtitle", "time": 26068.788, "timestamp": "07:14:28", "text": "找到，就会卡顿。它很容易卡顿。"}, {"type": "subtitle", "time": 26073.83, "timestamp": "07:14:33", "text": "[笑]"}, {"type": "subtitle", "time": 26087.27, "timestamp": "07:14:47", "text": "好了，有个任务。好的，让我"}, {"type": "subtitle", "time": 26089.03, "timestamp": "07:14:49", "text": "看看。"}]
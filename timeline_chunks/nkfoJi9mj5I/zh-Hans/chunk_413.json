[{"type": "subtitle", "time": 24782.948, "timestamp": "06:53:02", "text": "很多无人认领的宝藏"}, {"type": "subtitle", "time": 24785.91, "timestamp": "06:53:05", "text": "计划要带他去。 好了。"}, {"type": "subtitle", "time": 24796.878, "timestamp": "06:53:16", "text": "。 你真厉害。"}, {"type": "subtitle", "time": 24807.35, "timestamp": "06:53:27", "text": "你真厉害。你应该成为一名"}, {"type": "subtitle", "time": 24818.468, "timestamp": "06:53:38", "text": "名声显赫，追随者众多。好的。是的"}, {"type": "subtitle", "time": 24828.05, "timestamp": "06:53:48", "text": "哦，我真的做到了。我的天哪。不错。"}, {"type": "subtitle", "time": 24829.27, "timestamp": "06:53:49", "text": "[笑声]"}, {"type": "subtitle", "time": 24833.03, "timestamp": "06:53:53", "text": "我把他加为好友了。走吧。好的。100"}, {"type": "subtitle", "time": 24836.628, "timestamp": "06:53:56", "text": "好感度。不错。"}, {"type": "subtitle", "time": 24838.868, "timestamp": "06:53:58", "text": "哦，不错。"}]
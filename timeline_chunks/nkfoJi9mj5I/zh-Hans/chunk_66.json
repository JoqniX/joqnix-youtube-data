[{"type": "subtitle", "time": 3961.589, "timestamp": "01:06:01", "text": "所以，这里下面就像有个地下城市"}, {"type": "subtitle", "time": 3965.029, "timestamp": "01:06:05", "text": "。 哇。 我还没"}, {"type": "subtitle", "time": 3967.43, "timestamp": "01:06:07", "text": "做过这个任务呢。"}, {"type": "subtitle", "time": 3975.91, "timestamp": "01:06:15", "text": "右下角有个箱子。"}, {"type": "subtitle", "time": 3985.109, "timestamp": "01:06:25", "text": "有可能。 大概。"}, {"type": "subtitle", "time": 3986.789, "timestamp": "01:06:26", "text": "等等，我没有。哦，是的。 我没有"}, {"type": "subtitle", "time": 3990.789, "timestamp": "01:06:30", "text": "从这里买到另一件。"}, {"type": "subtitle", "time": 3995.19, "timestamp": "01:06:35", "text": "哦，我……哦不，我的……"}, {"type": "subtitle", "time": 3997.91, "timestamp": "01:06:37", "text": "不，"}, {"type": "subtitle", "time": 4001.91, "timestamp": "01:06:41", "text": "我的扭伤了。 我的腿骨折了。 天哪，"}, {"type": "subtitle", "time": 4005.029, "timestamp": "01:06:45", "text": "我的腿断了。 哦，是扭伤了。 好的，"}, {"type": "subtitle", "time": 4007.51, "timestamp": "01:06:47", "text": "好的，好的，好的。 休息了一会儿之后"}, {"type": "subtitle", "time": 4017.19, "timestamp": "01:06:57", "text": "等等，我怎么会"}]
[{"type": "subtitle", "time": 11401.83, "timestamp": "03:10:01", "text": "我的天啊。 我刚才是不是不"}, {"type": "subtitle", "time": 11405.429, "timestamp": "03:10:05", "text": "小心接受了另一个？"}, {"type": "subtitle", "time": 11408.71, "timestamp": "03:10:08", "text": "呃，我当时正在参加一个考试，因为我"}, {"type": "subtitle", "time": 11411.19, "timestamp": "03:10:11", "text": "没有足够的分支。 我因为"}, {"type": "subtitle", "time": 11421.51, "timestamp": "03:10:21", "text": "等待。 我的天啊。 等待。 他们没有出示"}, {"type": "subtitle", "time": 11424.95, "timestamp": "03:10:24", "text": "任何医疗"}, {"type": "subtitle", "time": 11427.269, "timestamp": "03:10:27", "text": "证明之类的东西，所以你不能参加"}, {"type": "subtitle", "time": 11430.79, "timestamp": "03:10:30", "text": "考试什么的。 等等，这是"}, {"type": "subtitle", "time": 11434.87, "timestamp": "03:10:34", "text": "像高中十二年级考试那样非常重要的考试吗"}, {"type": "chat", "time": 11434.985, "timestamp": "03:10:34", "author": "@sappyissap", "avatar": "https://yt4.ggpht.com/L44QLCQGMU6SE1bCsql8PIfsFhAkVolvmYx9MCoDWwH4qtCvwblTh0CPSGcixecYRTl8tjPCwbo=s64-c-k-c0x00ffffff-no-rj", "message": "My name means 7 sages and 7 stars and I happen to have 7 personality "}, {"type": "subtitle", "time": 11445.51, "timestamp": "03:10:45", "text": "我的名字意思是七位圣贤和七颗"}, {"type": "subtitle", "time": 11447.51, "timestamp": "03:10:47", "text": "星辰，而我恰好拥有七种不同的"}, {"type": "subtitle", "time": 11450.309, "timestamp": "03:10:50", "text": "性格。 哦，"}, {"type": "chat", "time": 11452.084, "timestamp": "03:10:52", "author": "@sappyissap", "avatar": "https://yt4.ggpht.com/L44QLCQGMU6SE1bCsql8PIfsFhAkVolvmYx9MCoDWwH4qtCvwblTh0CPSGcixecYRTl8tjPCwbo=s64-c-k-c0x00ffffff-no-rj", "message": "And the name sapp is the front section "}, {"type": "subtitle", "time": 11455.51, "timestamp": "03:10:55", "text": "然后，名称应用就是好友"}, {"type": "subtitle", "time": 11458.389, "timestamp": "03:10:58", "text": "部分。 哦，"}]
[{"type": "subtitle", "time": 29101.35, "timestamp": "08:05:01", "text": "这款游戏的视频。 也许吧（倒吸一口凉气，然后大笑起来）我"}, {"type": "subtitle", "time": 29105.11, "timestamp": "08:05:05", "text": "想。 希望我能睡个好觉。 如果我不"}, {"type": "subtitle", "time": 29107.83, "timestamp": "08:05:07", "text": "睡着，你就会见到我。 你会看到"}, {"type": "subtitle", "time": 29111.59, "timestamp": "08:05:11", "text": "我早上八九点还在直播，说"}, {"type": "subtitle", "time": 29115.19, "timestamp": "08:05:15", "text": "我睡不着。"}, {"type": "subtitle", "time": 29120.15, "timestamp": "08:05:20", "text": "。 我希望事情不会发展到那种地步"}, {"type": "subtitle", "time": 29123.59, "timestamp": "08:05:23", "text": "。 是的，"}, {"type": "subtitle", "time": 29126.388, "timestamp": "08:05:26", "text": "你好。 是的，呃，谢谢你今天的时间。"}, {"type": "subtitle", "time": 29128.548, "timestamp": "08:05:28", "text": "我们已经直播超过8个"}, {"type": "subtitle", "time": 29131.91, "timestamp": "08:05:31", "text": "小时了。 你好。 你好。 你好。 你好。 我就说到"}, {"type": "subtitle", "time": 29135.03, "timestamp": "08:05:35", "text": "这里吧。 明天见。 我晚上可能会"}, {"type": "subtitle", "time": 29137.35, "timestamp": "08:05:37", "text": "直播《蓝色协议》或者这款游戏"}, {"type": "subtitle", "time": 29140.868, "timestamp": "08:05:40", "text": "。 是的，晚上。 好吧，我"}, {"type": "subtitle", "time": 29146.708, "timestamp": "08:05:46", "text": "今天得再做一次日常练习。 你好。 你好。 不过，还是要谢谢你"}, {"type": "subtitle", "time": 29151.03, "timestamp": "08:05:51", "text": "今天的时间。 祝大家一切顺利。"}, {"type": "subtitle", "time": 29153.99, "timestamp": "08:05:53", "text": "再见。   祝你一切"}, {"type": "subtitle", "time": 29156.548, "timestamp": "08:05:56", "text": "顺利，今晚好梦"}, {"type": "subtitle", "time": 29158.548, "timestamp": "08:05:58", "text": "。 别忘了补充水分。"}]
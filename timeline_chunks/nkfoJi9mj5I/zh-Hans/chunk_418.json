[{"type": "subtitle", "time": 25086.628, "timestamp": "06:58:06", "text": "但我们毕竟都是人。"}, {"type": "subtitle", "time": 25090.708, "timestamp": "06:58:10", "text": "好吧。奴隶真的在黑暗中。"}, {"type": "subtitle", "time": 25098.628, "timestamp": "06:58:18", "text": "晚安。属于。"}, {"type": "subtitle", "time": 25101.75, "timestamp": "06:58:21", "text": "祝你今晚愉快。愿星辰"}, {"type": "subtitle", "time": 25103.99, "timestamp": "06:58:23", "text": "今晚保佑你，守护你，"}, {"type": "subtitle", "time": 25125.35, "timestamp": "06:58:45", "text": "即使你"}, {"type": "subtitle", "time": 25127.67, "timestamp": "06:58:47", "text": "得到了"}, {"type": "subtitle", "time": 25133.19, "timestamp": "06:58:53", "text": "宝藏，也别忘了你的初心。"}]
[{"type": "subtitle", "time": 5880.629, "timestamp": "01:38:00", "text": "你好，特朗普。 欢迎。"}, {"type": "subtitle", "time": 5884.79, "timestamp": "01:38:04", "text": "你好。 你好。 晚上好。"}, {"type": "subtitle", "time": 5887.03, "timestamp": "01:38:07", "text": "别以为我打开电视"}, {"type": "subtitle", "time": 5889.189, "timestamp": "01:38:09", "text": "处理工作的时候，第一个看到的直播频道就是"}, {"type": "subtitle", "time": 5893.092, "timestamp": "01:38:13", "text": "你的。 粉笔。 等等，"}, {"type": "subtitle", "time": 5898.87, "timestamp": "01:38:18", "text": "还有什么？（笑声） 喵喵来了。"}, {"type": "subtitle", "time": 5901.91, "timestamp": "01:38:21", "text": "我要摸摸你。"}, {"type": "subtitle", "time": 5903.99, "timestamp": "01:38:23", "text": "晚上。 哦，这简直是扯平了。"}, {"type": "subtitle", "time": 5905.83, "timestamp": "01:38:25", "text": "你那边是早上。 嗨。 早上好，"}, {"type": "subtitle", "time": 5908.79, "timestamp": "01:38:28", "text": "迪奥。"}, {"type": "subtitle", "time": 5935.75, "timestamp": "01:38:55", "text": "哦，是的。 我将获得传送点"}]
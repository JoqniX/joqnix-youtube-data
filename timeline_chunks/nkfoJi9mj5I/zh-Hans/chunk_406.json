[{"type": "subtitle", "time": 24362.788, "timestamp": "06:46:02", "text": "呃，"}, {"type": "subtitle", "time": 24379.99, "timestamp": "06:46:19", "text": "哦。哦，这是个双重标记。”"}, {"type": "subtitle", "time": 24382.788, "timestamp": "06:46:22", "text": "哦，就在那儿。我瞎了。我瞎了。"}, {"type": "subtitle", "time": 24384.788, "timestamp": "06:46:24", "text": "哇哈。"}, {"type": "subtitle", "time": 24387.27, "timestamp": "06:46:27", "text": "好的，明白了。"}, {"type": "subtitle", "time": 24395.67, "timestamp": "06:46:35", "text": "你试过吗？"}, {"type": "subtitle", "time": 24399.91, "timestamp": "06:46:39", "text": "还有MMO。我"}, {"type": "subtitle", "time": 24402.07, "timestamp": "06:46:42", "text": "今天在直播里玩了一会儿MMO。我把"}, {"type": "subtitle", "time": 24405.75, "timestamp": "06:46:45", "text": "卷心菜扔到那个被扔进监狱游街示众的人身上"}, {"type": "subtitle", "time": 24410.39, "timestamp": "06:46:50", "text": "。"}, {"type": "subtitle", "time": 24412.468, "timestamp": "06:46:52", "text": "大家都在扔蔬菜、"}, {"type": "subtitle", "time": 24414.788, "timestamp": "06:46:54", "text": "西红柿、胡萝卜之类的东西。所以我"}, {"type": "subtitle", "time": 24417.91, "timestamp": "06:46:57", "text": "就想，“好吧，我也来凑热闹。”"}, {"type": "subtitle", "time": 24419.75, "timestamp": "06:46:59", "text": "这是我目前为止唯一玩过的MMO。是的，多人游戏方面"}]
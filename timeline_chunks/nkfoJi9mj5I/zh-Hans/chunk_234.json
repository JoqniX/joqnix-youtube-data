[{"type": "subtitle", "time": 14045.99, "timestamp": "03:54:05", "text": "嘿，堆栈。"}, {"type": "subtitle", "time": 14052.07, "timestamp": "03:54:12", "text": "你好，基莎。 欢迎光临。"}, {"type": "subtitle", "time": 14053.67, "timestamp": "03:54:13", "text": "希望我没有念错你的名字"}, {"type": "subtitle", "time": 14055.59, "timestamp": "03:54:15", "text": "。"}, {"type": "subtitle", "time": 14058.229, "timestamp": "03:54:18", "text": "你好吗？ 我一切都很好。"}, {"type": "subtitle", "time": 14060.55, "timestamp": "03:54:20", "text": "你好吗？ 今天你是怎么找到我的？"}, {"type": "subtitle", "time": 14070.229, "timestamp": "03:54:30", "text": "哦，我的发音没错。 好的。"}, {"type": "subtitle", "time": 14072.319, "timestamp": "03:54:32", "text": "好的。 很高兴听到这个消息。"}, {"type": "subtitle", "time": 14075.359, "timestamp": "03:54:35", "text": "很高兴听到这个消息。 铃声响起者。"}]
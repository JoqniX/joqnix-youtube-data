[{"type": "subtitle", "time": 963.749, "timestamp": "00:16:03", "text": "今日はどうやって私を見つけたのですか？"}, {"type": "subtitle", "time": 973.189, "timestamp": "00:16:13", "text": "待って、9日間。 つまり、あなたはしばらくの間、"}, {"type": "subtitle", "time": 979.43, "timestamp": "00:16:19", "text": "それを変更するのを待っていたということですね。"}, {"type": "subtitle", "time": 986.47, "timestamp": "00:16:26", "text": "そうですね、正直その気持ちはよく分かります。"}, {"type": "subtitle", "time": 989.11, "timestamp": "00:16:29", "text": "誤って名前を変更してしまったので、"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "元の名前に戻したいです。"}, {"type": "subtitle", "time": 995.59, "timestamp": "00:16:35", "text": "何ヶ月待ったんだろう？  90"}, {"type": "subtitle", "time": 999.67, "timestamp": "00:16:39", "text": "日、つまり3ヶ月くらいだったと思うけど、"}]
[{"type": "subtitle", "time": 6902.39, "timestamp": "01:55:02", "text": "木材が必要だと感じます。"}, {"type": "subtitle", "time": 6904.629, "timestamp": "01:55:04", "text": "今、木材に苦労しています。"}, {"type": "subtitle", "time": 6908.39, "timestamp": "01:55:08", "text": "そして、"}, {"type": "subtitle", "time": 6915.03, "timestamp": "01:55:15", "text": "製粉所などを建設する必要があると思います。"}, {"type": "subtitle", "time": 6919.43, "timestamp": "01:55:19", "text": "真ん中。木の板が必要です。"}, {"type": "subtitle", "time": 6923.75, "timestamp": "01:55:23", "text": "木の板と武器作業台も"}, {"type": "subtitle", "time": 6930.95, "timestamp": "01:55:30", "text": "それに取り組みます。わかりました"}, {"type": "subtitle", "time": 6953.99, "timestamp": "01:55:53", "text": "大きなフィードバックが必要です。巨大な"}]
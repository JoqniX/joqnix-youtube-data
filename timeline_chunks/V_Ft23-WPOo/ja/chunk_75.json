[{"type": "subtitle", "time": 4513.03, "timestamp": "01:15:13", "text": "よし、とりあえずしばらくしたら、何"}, {"type": "subtitle", "time": 4515.83, "timestamp": "01:15:15", "text": "時間もかかるよ。  [ため息]"}, {"type": "subtitle", "time": 4522.56, "timestamp": "01:15:22", "text": "[ため息] いや、いや、いや。寝るな。"}, {"type": "subtitle", "time": 4531.03, "timestamp": "01:15:31", "text": "できるだけ多くのオレサスを取るつもりだ。わかった。"}, {"type": "subtitle", "time": 4533.35, "timestamp": "01:15:33", "text": "そして、今のところ"}, {"type": "subtitle", "time": 4551.99, "timestamp": "01:15:51", "text": "ヘルファイアクローでターゲットの敵を攻撃する"}]
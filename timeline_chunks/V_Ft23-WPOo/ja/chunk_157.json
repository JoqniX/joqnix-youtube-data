[{"type": "subtitle", "time": 9431.03, "timestamp": "02:37:11", "text": "真ん中に。 わかった。 だから、"}, {"type": "subtitle", "time": 9435.03, "timestamp": "02:37:15", "text": "真ん中に置いたんです。 ええと、家具です。 これは"}, {"type": "subtitle", "time": 9458.389, "timestamp": "02:37:38", "text": "。"}, {"type": "subtitle", "time": 9461.75, "timestamp": "02:37:41", "text": "ありがとう、チャンス。私のためにそれを引き当ててくれて"}, {"type": "subtitle", "time": 9464.23, "timestamp": "02:37:44", "text": "。 ありがとう。"}, {"type": "subtitle", "time": 9475.19, "timestamp": "02:37:55", "text": "。 何？"}, {"type": "subtitle", "time": 9477.91, "timestamp": "02:37:57", "text": "どう言えばいいんだろう？ いや、"}]
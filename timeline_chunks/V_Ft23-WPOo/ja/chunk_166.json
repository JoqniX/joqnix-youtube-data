[{"type": "subtitle", "time": 9968.95, "timestamp": "02:46:08", "text": "私の中には、黒い首について語っている部分がある。 もう"}, {"type": "subtitle", "time": 9982.55, "timestamp": "02:46:22", "text": "もう一度やりたい気分だ。   やってみるよ"}, {"type": "subtitle", "time": 9986.0, "timestamp": "02:46:26", "text": "。   やってみるよ 。"}, {"type": "subtitle", "time": 10011.91, "timestamp": "02:46:51", "text": "あなたは"}, {"type": "subtitle", "time": 10016.23, "timestamp": "02:46:56", "text": "まだ自分自身を手に入れるべきではないと分かっている。 はい、どうぞ。"}]
[{"type": "subtitle", "time": 6301.35, "timestamp": "01:45:01", "text": "ここに鉄のチェストを1つ置くこと。"}, {"type": "subtitle", "time": 6320.709, "timestamp": "01:45:20", "text": "自分の持ち物も修理しないといけないかもしれない。じゃあ、"}, {"type": "subtitle", "time": 6323.91, "timestamp": "01:45:23", "text": "それを修理しよう。それを修理。"}, {"type": "subtitle", "time": 6326.87, "timestamp": "01:45:26", "text": "それを修理。そしてこのクロスボウも修理する"}, {"type": "subtitle", "time": 6339.35, "timestamp": "01:45:39", "text": "何だ？私か、それとも"}, {"type": "subtitle", "time": 6341.43, "timestamp": "01:45:41", "text": "修理されていないのか？何？"}, {"type": "subtitle", "time": 6353.03, "timestamp": "01:45:53", "text": "修理されていない。何が"}]
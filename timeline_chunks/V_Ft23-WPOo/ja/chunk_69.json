[{"type": "subtitle", "time": 4142.87, "timestamp": "01:09:02", "text": "ああ、高品質のパルオイル武器"}, {"type": "subtitle", "time": 4146.47, "timestamp": "01:09:06", "text": "ベンチマークを手に入れなきゃ。ああ、"}, {"type": "subtitle", "time": 4149.51, "timestamp": "01:09:09", "text": "彼女は何をするつもりだったの？"}, {"type": "subtitle", "time": 4153.51, "timestamp": "01:09:13", "text": "待って、これをしたい。あれをやる。"}, {"type": "subtitle", "time": 4156.95, "timestamp": "01:09:16", "text": "火薬。そう。マスケット銃。そう。弾薬。"}, {"type": "subtitle", "time": 4161.91, "timestamp": "01:09:21", "text": "そう。トマト農園。ああ、"}, {"type": "subtitle", "time": 4188.63, "timestamp": "01:09:48", "text": "ああ、私の計画は、たくさんの鉱石を注文することだ。"}, {"type": "subtitle", "time": 4198.95, "timestamp": "01:09:58", "text": "よし。そして、"}]
[{"type": "subtitle", "time": 12182.229, "timestamp": "03:23:02", "text": "木材栽培仲間がたくさんいる。"}, {"type": "subtitle", "time": 12185.59, "timestamp": "03:23:05", "text": "それはまるで卵を産む鹿のようだ。 いいえ、"}, {"type": "subtitle", "time": 12188.07, "timestamp": "03:23:08", "text": "卵を産む鹿が３匹です。"}, {"type": "subtitle", "time": 12194.389, "timestamp": "03:23:14", "text": "木製の容器に入れられると思う。   そうねぇ"}]
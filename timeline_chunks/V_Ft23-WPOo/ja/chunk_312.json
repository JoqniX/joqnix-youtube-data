[{"type": "subtitle", "time": 18723.91, "timestamp": "05:12:03", "text": "待って、あなたも培養もやっているの？"}, {"type": "subtitle", "time": 18728.62, "timestamp": "05:12:08", "text": "あなたはギガススピアを建造している。 何？"}, {"type": "subtitle", "time": 18734.948, "timestamp": "05:12:14", "text": "わかった。"}, {"type": "subtitle", "time": 18737.75, "timestamp": "05:12:17", "text": "ここ。 ここ。"}, {"type": "subtitle", "time": 18739.75, "timestamp": "05:12:19", "text": "でも、どうやってそんなにたくさんの卵を作っているんですか"}, {"type": "subtitle", "time": 18759.91, "timestamp": "05:12:39", "text": "おい。 こんにちは。 その卵は文字通り"}, {"type": "subtitle", "time": 18768.948, "timestamp": "05:12:48", "text": "さあ、行きなさい。   わかりました。では"}]
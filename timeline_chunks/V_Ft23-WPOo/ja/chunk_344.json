[{"type": "subtitle", "time": 20652.23, "timestamp": "05:44:12", "text": "インゴットファームが欲しかったから、といったことを考えているうちに、"}, {"type": "subtitle", "time": 20662.788, "timestamp": "05:44:22", "text": "他の人が来てプレイして"}, {"type": "subtitle", "time": 20665.83, "timestamp": "05:44:25", "text": "ファームを作ったりしたらどうなるんだろう、"}, {"type": "subtitle", "time": 20668.07, "timestamp": "05:44:28", "text": "もし私が既に人気のある"}, {"type": "subtitle", "time": 20672.39, "timestamp": "05:44:32", "text": "場所を占領していたらどうなるんだろう、という不安がよぎる。"}, {"type": "subtitle", "time": 20676.868, "timestamp": "05:44:36", "text": "アイテムなどを受け取るには、同じギルドに所属している必要があります。"}, {"type": "subtitle", "time": 20697.43, "timestamp": "05:44:57", "text": "ええ、今すぐに大きな容器を作ることができますよ"}]
[{"type": "subtitle", "time": 10926.23, "timestamp": "03:02:06", "text": "。"}, {"type": "subtitle", "time": 10932.71, "timestamp": "03:02:12", "text": "はい。"}, {"type": "subtitle", "time": 10936.469, "timestamp": "03:02:16", "text": "ああ、なんてことだ、私はとても賢い。   あれを見てください"}, {"type": "subtitle", "time": 10962.63, "timestamp": "03:02:42", "text": "、これだ。 そして、それをここにきちんと置きます"}, {"type": "subtitle", "time": 10975.67, "timestamp": "03:02:55", "text": "では、1、2、3、4、5、6、7。  7つ手に入れました。"}, {"type": "subtitle", "time": 10977.269, "timestamp": "03:02:57", "text": "聖なる"}]
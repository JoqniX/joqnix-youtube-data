[{"type": "subtitle", "time": 7291.91, "timestamp": "02:01:31", "text": "よし、じゃあ"}, {"type": "subtitle", "time": 7294.95, "timestamp": "02:01:34", "text": "ラグを探しに行こう。"}, {"type": "subtitle", "time": 7297.109, "timestamp": "02:01:37", "text": "待って、君は"}, {"type": "subtitle", "time": 7301.189, "timestamp": "02:01:41", "text": "ラグってるよ。"}, {"type": "subtitle", "time": 7305.75, "timestamp": "02:01:45", "text": "待って、どうして彼にラグってるの？"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "ほら、僕は日本にいるから、僕"}, {"type": "subtitle", "time": 7314.07, "timestamp": "02:01:54", "text": "にとっては盛り上がるはずなのに、どうして"}]
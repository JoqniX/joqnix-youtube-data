[{"type": "subtitle", "time": 18426.23, "timestamp": "05:07:06", "text": "少しご飯を取って、それから、ええ"}, {"type": "subtitle", "time": 18432.23, "timestamp": "05:07:12", "text": "、少しご飯を取りました。"}, {"type": "subtitle", "time": 18444.55, "timestamp": "05:07:24", "text": "うん。 オムレツ。"}, {"type": "subtitle", "time": 18449.83, "timestamp": "05:07:29", "text": "うん。 それから醤油とマヨネーズを入れて、"}, {"type": "subtitle", "time": 18455.75, "timestamp": "05:07:35", "text": "スライスした"}, {"type": "subtitle", "time": 18457.51, "timestamp": "05:07:37", "text": "キャベツとか、ミックス"}, {"type": "subtitle", "time": 18459.51, "timestamp": "05:07:39", "text": "野菜とか、そんな感じのものを買ってきました"}, {"type": "subtitle", "time": 18463.51, "timestamp": "05:07:43", "text": "。 それ。 それから"}, {"type": "subtitle", "time": 18469.99, "timestamp": "05:07:49", "text": "ニンニクペーストと、"}, {"type": "subtitle", "time": 18473.51, "timestamp": "05:07:53", "text": "たまたま見つけた適当なスパイス類を加えて、全部混ぜ合わせました"}, {"type": "subtitle", "time": 18475.67, "timestamp": "05:07:55", "text": "。 今まさに"}, {"type": "subtitle", "time": 18477.91, "timestamp": "05:07:57", "text": "それを食べています。"}]
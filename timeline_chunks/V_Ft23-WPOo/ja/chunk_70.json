[{"type": "subtitle", "time": 4201.35, "timestamp": "01:10:01", "text": "サーバーでプレイしている人たちに、"}, {"type": "subtitle", "time": 4204.63, "timestamp": "01:10:04", "text": "お金をくれるか、"}, {"type": "subtitle", "time": 4209.35, "timestamp": "01:10:09", "text": "良い資源をくれるように頼むつもりだ。"}, {"type": "subtitle", "time": 4213.51, "timestamp": "01:10:13", "text": "良いものと交換して。だって"}, {"type": "subtitle", "time": 4217.189, "timestamp": "01:10:17", "text": "ここはゲーム内で鉱石をファームするのに最適な場所の1つだから"}, {"type": "subtitle", "time": 4220.858, "timestamp": "01:10:20", "text": "。"}]
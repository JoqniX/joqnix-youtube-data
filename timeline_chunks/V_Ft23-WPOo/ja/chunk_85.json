[{"type": "subtitle", "time": 5122.149, "timestamp": "01:25:22", "text": "こんにちは、パネル用のベッドは十分あります。"}, {"type": "subtitle", "time": 5125.03, "timestamp": "01:25:25", "text": "でも木材が足りない。"}, {"type": "subtitle", "time": 5127.83, "timestamp": "01:25:27", "text": "ところで、木材が足りないよ。"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "よし、みんなよく眠ってね。"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "戻ってくるよ。よし、"}, {"type": "subtitle", "time": 5138.55, "timestamp": "01:25:38", "text": "彼らは戻ってくるよ。これが私の2番目の"}, {"type": "subtitle", "time": 5141.03, "timestamp": "01:25:41", "text": "基地だ。"}, {"type": "subtitle", "time": 5144.87, "timestamp": "01:25:44", "text": "このエリアは何？これは何？"}, {"type": "subtitle", "time": 5147.91, "timestamp": "01:25:47", "text": "トーレンか何かみたいだ。試している。"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "場所はダメだ。ええ、"}, {"type": "subtitle", "time": 5158.629, "timestamp": "01:25:58", "text": "これらの鉱石を全部集めて、持って帰って"}]
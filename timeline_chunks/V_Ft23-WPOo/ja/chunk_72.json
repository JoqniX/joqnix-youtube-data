[{"type": "subtitle", "time": 4326.229, "timestamp": "01:12:06", "text": "興味はないけど、まずは"}, {"type": "subtitle", "time": 4340.709, "timestamp": "01:12:20", "text": "プランテーション用品を置く必要があると思う"}, {"type": "subtitle", "time": 4346.07, "timestamp": "01:12:26", "text": "けど、トマトの種と"}, {"type": "subtitle", "time": 4348.55, "timestamp": "01:12:28", "text": "小麦はどこで手に入れるの？ 小麦の種とトマトの種がある"}, {"type": "subtitle", "time": 4361.83, "timestamp": "01:12:41", "text": "。ちょっと待って。"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "鉄が必要だ。火が必要だ。"}, {"type": "subtitle", "time": 4370.149, "timestamp": "01:12:50", "text": "何をしてるの？ 待って、精製装置を作る必要があると思う"}, {"type": "subtitle", "time": 4375.43, "timestamp": "01:12:55", "text": "。だから、石が必要だ。また炎の鉱石が必要だ"}, {"type": "subtitle", "time": 4377.75, "timestamp": "01:12:57", "text": "。"}]
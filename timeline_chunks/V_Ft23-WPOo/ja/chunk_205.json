[{"type": "subtitle", "time": 12300.71, "timestamp": "03:25:00", "text": "アルファ・ユニボスト。"}, {"type": "subtitle", "time": 12304.389, "timestamp": "03:25:04", "text": "えっと、エル・グルーヴ。"}, {"type": "subtitle", "time": 12307.67, "timestamp": "03:25:07", "text": "待って、さっきL字型の溝を見たんだけど。 アルファ"}, {"type": "subtitle", "time": 12309.51, "timestamp": "03:25:09", "text": "SB。"}, {"type": "subtitle", "time": 12319.269, "timestamp": "03:25:19", "text": "フェノールフラックス。 フェノロップ。"}, {"type": "subtitle", "time": 12323.67, "timestamp": "03:25:23", "text": "愛は変化する。 アルファフェノールフラックス。"}, {"type": "subtitle", "time": 12326.95, "timestamp": "03:25:26", "text": "アルファ次元アルファデノム茂みが"}, {"type": "subtitle", "time": 12331.349, "timestamp": "03:25:31", "text": "ノックされました。 待って、ブッシュがノックされるのを見たことがある。"}, {"type": "subtitle", "time": 12333.269, "timestamp": "03:25:33", "text": "茂った茂った"}, {"type": "subtitle", "time": 12337.91, "timestamp": "03:25:37", "text": "アルファの茂った茂ったが、"}, {"type": "subtitle", "time": 12350.15, "timestamp": "03:25:50", "text": "アルファ・スプラッタリーナ。"}, {"type": "subtitle", "time": 12352.389, "timestamp": "03:25:52", "text": "クレイジー。"}]
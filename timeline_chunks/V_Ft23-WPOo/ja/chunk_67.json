[{"type": "subtitle", "time": 4033.109, "timestamp": "01:07:13", "text": "それで、今これがあります。それで、"}, {"type": "subtitle", "time": 4036.39, "timestamp": "01:07:16", "text": "私の良い仲間は誰ですか？彼らをここに連れてくることができます。見てみましょう"}, {"type": "subtitle", "time": 4039.349, "timestamp": "01:07:19", "text": "。"}, {"type": "subtitle", "time": 4045.51, "timestamp": "01:07:25", "text": "採掘ができる人を探しています。"}, {"type": "subtitle", "time": 4052.87, "timestamp": "01:07:32", "text": "仕事ができます。わかった"}, {"type": "subtitle", "time": 4056.39, "timestamp": "01:07:36", "text": "。彼を"}, {"type": "subtitle", "time": 4059.19, "timestamp": "01:07:39", "text": "彼に置けます。  [咳払い]"}, {"type": "subtitle", "time": 4061.349, "timestamp": "01:07:41", "text": "1匹いるよ。"}]
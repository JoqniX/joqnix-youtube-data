[{"type": "subtitle", "time": 7741.75, "timestamp": "02:09:01", "text": "みんな元気？ どうしてる？ 元気？"}, {"type": "subtitle", "time": 7744.39, "timestamp": "02:09:04", "text": "生きてる？"}, {"type": "subtitle", "time": 7748.47, "timestamp": "02:09:08", "text": "なんで食べ物がないの？"}, {"type": "subtitle", "time": 7750.069, "timestamp": "02:09:10", "text": "こんにちは。"}, {"type": "subtitle", "time": 7753.91, "timestamp": "02:09:13", "text": "水をやったり、収穫したりしてるんだね。 わかった。"}, {"type": "subtitle", "time": 7768.229, "timestamp": "02:09:28", "text": "？ なんで硫黄を集めてるの？"}, {"type": "subtitle", "time": 7771.669, "timestamp": "02:09:31", "text": "なんで硫黄を集めてるの？ オアシスはどこ？"}, {"type": "subtitle", "time": 7774.069, "timestamp": "02:09:34", "text": "やあ、"}, {"type": "subtitle", "time": 7777.43, "timestamp": "02:09:37", "text": "相棒。 ママ、なんで硫黄を集めてるの？"}, {"type": "subtitle", "time": 7779.35, "timestamp": "02:09:39", "text": "オアシスはどこ？ じゃあ、なんでここは"}, {"type": "subtitle", "time": 7781.669, "timestamp": "02:09:41", "text": "手つかずなの？"}, {"type": "subtitle", "time": 7784.95, "timestamp": "02:09:44", "text": "すみません。 何？"}]
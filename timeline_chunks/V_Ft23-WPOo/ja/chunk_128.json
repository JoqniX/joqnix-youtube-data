[{"type": "subtitle", "time": 7701.669, "timestamp": "02:08:21", "text": "ない。ナイトウィングは持ってない。"}, {"type": "subtitle", "time": 7710.39, "timestamp": "02:08:30", "text": "何が入ってるんだろう？布とインゴット。"}, {"type": "subtitle", "time": 7712.47, "timestamp": "02:08:32", "text": "よし、"}, {"type": "subtitle", "time": 7716.87, "timestamp": "02:08:36", "text": "布はある。インゴットが15個必要だ。"}, {"type": "subtitle", "time": 7720.39, "timestamp": "02:08:40", "text": "チェストに入れたはず。ああ、"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "チェストが空っぽだ。何？よし、"}, {"type": "subtitle", "time": 7726.069, "timestamp": "02:08:46", "text": "それなら"}, {"type": "subtitle", "time": 7729.669, "timestamp": "02:08:49", "text": "別の拠点に切り替えて"}, {"type": "subtitle", "time": 7734.629, "timestamp": "02:08:54", "text": "鉱石を集め直さなきゃ。"}, {"type": "subtitle", "time": 7739.109, "timestamp": "02:08:59", "text": "この拠点も直さなきゃ。ああ、"}]
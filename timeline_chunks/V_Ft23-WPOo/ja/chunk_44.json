[{"type": "subtitle", "time": 2641.349, "timestamp": "00:44:01", "text": "、負けた、最後の"}, {"type": "subtitle", "time": 2644.87, "timestamp": "00:44:04", "text": "バーを投げた。 何てことだ。"}, {"type": "subtitle", "time": 2656.79, "timestamp": "00:44:16", "text": "持ち物をなくした時。"}, {"type": "subtitle", "time": 2659.99, "timestamp": "00:44:19", "text": "こんにちは、世界。ようこそ。"}, {"type": "subtitle", "time": 2677.99, "timestamp": "00:44:37", "text": "ちょっと、そこ。 私は行きます。 元気です。"}, {"type": "subtitle", "time": 2687.27, "timestamp": "00:44:47", "text": "馬を燃やす場所とかを探しているところです。"}, {"type": "subtitle", "time": 2695.589, "timestamp": "00:44:55", "text": "では、待ってください。 なぜあの胸の部分が赤く光っているのですか"}]
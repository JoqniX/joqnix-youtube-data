[{"type": "subtitle", "time": 3571.99, "timestamp": "00:59:31", "text": "オーケー、"}, {"type": "subtitle", "time": 3574.309, "timestamp": "00:59:34", "text": "誕生日を祝おう。あと、"}, {"type": "subtitle", "time": 3577.91, "timestamp": "00:59:37", "text": "火曜日が僕の誕生日だって知ってた？"}, {"type": "subtitle", "time": 3581.19, "timestamp": "00:59:41", "text": "今すぐ配信のスケジュールを立てなきゃ。"}, {"type": "subtitle", "time": 3586.789, "timestamp": "00:59:46", "text": "誕生日が近づいてるから、アナウンスとか色々やらなきゃ。"}, {"type": "subtitle", "time": 3596.39, "timestamp": "00:59:56", "text": "故郷のインド以外で日本で誕生日を祝うのは初めてだから、"}]
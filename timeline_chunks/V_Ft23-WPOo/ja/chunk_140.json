[{"type": "subtitle", "time": 8400.23, "timestamp": "02:20:00", "text": "第二基地を改修する必要があるよね？"}, {"type": "subtitle", "time": 8403.99, "timestamp": "02:20:03", "text": "積み重ね式の食料生産"}, {"type": "subtitle", "time": 8406.71, "timestamp": "02:20:06", "text": "設備を手に入れなければならない。"}, {"type": "subtitle", "time": 8413.51, "timestamp": "02:20:13", "text": "これらの"}, {"type": "subtitle", "time": 8417.83, "timestamp": "02:20:17", "text": "仲間たちのコピーを何度も入手して、彼らが"}, {"type": "subtitle", "time": 8420.79, "timestamp": "02:20:20", "text": "農業や水やり、"}, {"type": "subtitle", "time": 8424.63, "timestamp": "02:20:24", "text": "その他すべてのことを"}, {"type": "subtitle", "time": 8436.87, "timestamp": "02:20:36", "text": "インスタグラムでライブ配信してると思う。 すみません、今"}, {"type": "subtitle", "time": 8457.11, "timestamp": "02:20:57", "text": "彼は手伝ってくれますか？"}]
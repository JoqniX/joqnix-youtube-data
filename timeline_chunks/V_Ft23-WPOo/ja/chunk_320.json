[{"type": "subtitle", "time": 19200.31, "timestamp": "05:20:00", "text": "ああ、彼は私の物を全部壊したんだ。"}, {"type": "subtitle", "time": 19203.35, "timestamp": "05:20:03", "text": "私はここにいます。"}, {"type": "subtitle", "time": 19205.11, "timestamp": "05:20:05", "text": "彼らとは距離を置きなさい。 死ぬな。"}, {"type": "subtitle", "time": 19209.35, "timestamp": "05:20:09", "text": "えっと、彼らは逃げているんです。"}, {"type": "subtitle", "time": 19211.83, "timestamp": "05:20:11", "text": "停止。"}, {"type": "subtitle", "time": 19213.67, "timestamp": "05:20:13", "text": "彼らは逃げている。"}, {"type": "subtitle", "time": 19215.03, "timestamp": "05:20:15", "text": "いや、彼らは迷惑だ。"}, {"type": "subtitle", "time": 19222.07, "timestamp": "05:20:22", "text": "。 わかった。 お立ち寄りいただきありがとうございます"}, {"type": "subtitle", "time": 19248.55, "timestamp": "05:20:48", "text": "いいえ、私はああ"}, {"type": "subtitle", "time": 19251.59, "timestamp": "05:20:51", "text": "、彼は亡くなりました。"}, {"type": "subtitle", "time": 19254.07, "timestamp": "05:20:54", "text": "ああ、あなたはそれを捕まえようとしていたんですね。"}, {"type": "subtitle", "time": 19256.31, "timestamp": "05:20:56", "text": "はい。   教えてくれていたら"}]
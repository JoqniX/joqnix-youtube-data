[{"type": "subtitle", "time": 20781.35, "timestamp": "05:46:21", "text": "つまり、あなたもスポーン地点にいたわけですから、ええ、"}, {"type": "subtitle", "time": 20789.03, "timestamp": "05:46:29", "text": "それは、私がスポーツマンとして生きてきた人生で犯した、最も愚かな間違いだった"}, {"type": "subtitle", "time": 20792.39, "timestamp": "05:46:32", "text": "。"}, {"type": "subtitle", "time": 20794.868, "timestamp": "05:46:34", "text": "ああ、大変だ、尾行されている。"}, {"type": "subtitle", "time": 20797.67, "timestamp": "05:46:37", "text": "バルボックスを破壊したら、奴らが"}, {"type": "subtitle", "time": 20806.23, "timestamp": "05:46:46", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 20809.11, "timestamp": "05:46:49", "text": "おお。"}, {"type": "subtitle", "time": 20815.35, "timestamp": "05:46:55", "text": "くそ。"}, {"type": "subtitle", "time": 20818.47, "timestamp": "05:46:58", "text": "待って、君の仲間が君を殺しに来るよ。"}]
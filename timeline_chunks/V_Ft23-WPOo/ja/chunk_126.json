[{"type": "subtitle", "time": 7580.55, "timestamp": "02:06:20", "text": "もう一度チャージする。自分の基地をほとんど破壊しかけた。"}, {"type": "subtitle", "time": 7595.189, "timestamp": "02:06:35", "text": "自分の基地を破壊しているのか？"}, {"type": "subtitle", "time": 7608.31, "timestamp": "02:06:48", "text": "なぜ14なんだ？なぜみんな"}, {"type": "subtitle", "time": 7611.27, "timestamp": "02:06:51", "text": "それに取り組んでいないんだ？とにかく、"}, {"type": "subtitle", "time": 7614.31, "timestamp": "02:06:54", "text": "待て。これは石のチェストだ。違う。じゃあ、"}, {"type": "subtitle", "time": 7617.75, "timestamp": "02:06:57", "text": "石をここに置く。今"}]
[{"type": "subtitle", "time": 18602.07, "timestamp": "05:10:02", "text": "地図を使って、一番近い"}, {"type": "subtitle", "time": 18604.31, "timestamp": "05:10:04", "text": "テレポート地点を教えてください。   私もそう思います"}, {"type": "subtitle", "time": 18606.628, "timestamp": "05:10:06", "text": "。 うん。"}, {"type": "subtitle", "time": 18612.47, "timestamp": "05:10:12", "text": "あなたは自分の"}, {"type": "subtitle", "time": 18614.948, "timestamp": "05:10:14", "text": "第一塁を愛している。"}, {"type": "subtitle", "time": 18621.11, "timestamp": "05:10:21", "text": "ああ、わかりました"}, {"type": "subtitle", "time": 18633.91, "timestamp": "05:10:33", "text": "持続する。 私はあなたを訪ねていません。"}, {"type": "subtitle", "time": 18635.99, "timestamp": "05:10:35", "text": "ベースソングを変えようと思います。 ええ、"}, {"type": "subtitle", "time": 18647.44, "timestamp": "05:10:47", "text": "、 基地に着きました。"}]
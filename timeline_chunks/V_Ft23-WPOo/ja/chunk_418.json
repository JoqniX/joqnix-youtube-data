[{"type": "subtitle", "time": 25082.15, "timestamp": "06:58:02", "text": "？ あなたは車の中にいます。"}, {"type": "subtitle", "time": 25087.83, "timestamp": "06:58:07", "text": "ええと、何もないです。 いや、それは厄介なことだ。"}, {"type": "subtitle", "time": 25089.59, "timestamp": "06:58:09", "text": "はい、私には経歴があります。 だから私は"}, {"type": "subtitle", "time": 25092.948, "timestamp": "06:58:12", "text": "黙っていたのです。 皆さん、来てくれてありがとうございました"}, {"type": "subtitle", "time": 25095.19, "timestamp": "06:58:15", "text": "。 つまり、"}, {"type": "subtitle", "time": 25098.948, "timestamp": "06:58:18", "text": "君と遊ぶのは楽しかったよ。 まあ、私たちは自分たちのやり方でやっているけどね"}, {"type": "subtitle", "time": 25100.15, "timestamp": "06:58:20", "text": "。   じゃあね"}, {"type": "subtitle", "time": 25103.67, "timestamp": "06:58:23", "text": "、女の子たち。 良いですね。それだけだと思います"}, {"type": "subtitle", "time": 25104.788, "timestamp": "06:58:24", "text": "。"}, {"type": "subtitle", "time": 25111.03, "timestamp": "06:58:31", "text": "バイバイ。"}, {"type": "subtitle", "time": 25115.35, "timestamp": "06:58:35", "text": "7時間ぶっ通しで見てくださってありがとうございました。 こんにちは、"}]
[{"type": "subtitle", "time": 17121.11, "timestamp": "04:45:21", "text": "私は、えっと、こういうものを作ります。"}, {"type": "subtitle", "time": 17123.51, "timestamp": "04:45:23", "text": "あなたはこれをしましたか？"}, {"type": "subtitle", "time": 17124.788, "timestamp": "04:45:24", "text": "垂直型農場の設置。"}, {"type": "subtitle", "time": 17126.708, "timestamp": "04:45:26", "text": "垂直。"}, {"type": "subtitle", "time": 17129.59, "timestamp": "04:45:29", "text": "はぁ？ 垂直。"}, {"type": "subtitle", "time": 17129.91, "timestamp": "04:45:29", "text": "いいえ。こういうものを"}, {"type": "subtitle", "time": 17134.47, "timestamp": "04:45:34", "text": "積み重ねるんです。"}, {"type": "subtitle", "time": 17136.708, "timestamp": "04:45:36", "text": "いいえ、していません。"}, {"type": "subtitle", "time": 17137.67, "timestamp": "04:45:37", "text": "本当に良いです。"}, {"type": "subtitle", "time": 17140.39, "timestamp": "04:45:40", "text": "おお。 そんなことはできません。 おお。"}, {"type": "subtitle", "time": 17144.07, "timestamp": "04:45:44", "text": "うん。 木製のこの物で。 最上位の"}, {"type": "subtitle", "time": 17146.55, "timestamp": "04:45:46", "text": "テクノロジーから入手する必要があります"}, {"type": "subtitle", "time": 17151.35, "timestamp": "04:45:51", "text": "。 それは何ですか？ 木製のリビング"}, {"type": "subtitle", "time": 17155.11, "timestamp": "04:45:55", "text": "家具セットとベンチを手に入れよう。"}, {"type": "subtitle", "time": 17158.948, "timestamp": "04:45:58", "text": "真ん中に置く。"}]
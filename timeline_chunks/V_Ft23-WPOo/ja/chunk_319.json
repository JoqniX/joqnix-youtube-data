[{"type": "subtitle", "time": 19143.03, "timestamp": "05:19:03", "text": "どこにいますか？ わかりました、あなたは基地にいます。"}, {"type": "subtitle", "time": 19150.07, "timestamp": "05:19:10", "text": "。 わからない。 古い"}, {"type": "subtitle", "time": 19150.31, "timestamp": "05:19:10", "text": "方はどこにあるのですか？"}, {"type": "subtitle", "time": 19152.23, "timestamp": "05:19:12", "text": "新しい方です。 新しいやつ。 古い、または"}, {"type": "subtitle", "time": 19154.628, "timestamp": "05:19:14", "text": "1つ、"}, {"type": "subtitle", "time": 19174.39, "timestamp": "05:19:34", "text": "竹製の切符。 私たちが来た時にでも。"}, {"type": "subtitle", "time": 19178.788, "timestamp": "05:19:38", "text": "どうすればこれらの人たちがゴルフをするのを止められるでしょうか"}, {"type": "subtitle", "time": 19183.11, "timestamp": "05:19:43", "text": "？ 俺の彼女を殺したんだよ、兄弟。 君は今、"}, {"type": "subtitle", "time": 19187.91, "timestamp": "05:19:47", "text": "殺したのか。なんてことだ。 死ね、死ね、死ね、死ね、死ね、死ね、死ね、死ね、死ね、死ね"}, {"type": "subtitle", "time": 19193.91, "timestamp": "05:19:53", "text": "（笑い）"}]
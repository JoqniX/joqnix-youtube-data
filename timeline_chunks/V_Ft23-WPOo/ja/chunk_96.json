[{"type": "subtitle", "time": 5762.39, "timestamp": "01:36:02", "text": "ここには…"}, {"type": "subtitle", "time": 5778.55, "timestamp": "01:36:18", "text": "よし、スリル鹿の鞍だ。"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "これを手に入れれば、木材をもっと早く集められるよ"}, {"type": "subtitle", "time": 5785.51, "timestamp": "01:36:25", "text": "ね？それから、"}, {"type": "subtitle", "time": 5788.55, "timestamp": "01:36:28", "text": "木の板をもっと作る"}, {"type": "subtitle", "time": 5793.189, "timestamp": "01:36:33", "text": "。よし。それから、鉄の"}, {"type": "subtitle", "time": 5797.35, "timestamp": "01:36:37", "text": "斧と鉄のツルハシを作る。これは"}, {"type": "subtitle", "time": 5801.35, "timestamp": "01:36:41", "text": "本当に役に立つだろう。"}, {"type": "subtitle", "time": 5803.43, "timestamp": "01:36:43", "text": "鉄に変えるだけだ。待って。"}, {"type": "subtitle", "time": 5805.27, "timestamp": "01:36:45", "text": "止まれ。待って。どこに行ったんだ？お腹が空いたのか"}]
[{"type": "subtitle", "time": 17651.67, "timestamp": "04:54:11", "text": "収穫、収集、"}, {"type": "subtitle", "time": 17659.91, "timestamp": "04:54:19", "text": "何がまた集まっているのか？"}, {"type": "subtitle", "time": 17661.59, "timestamp": "04:54:21", "text": "私はその番組のことを考えていました。 うん、うん、"}, {"type": "subtitle", "time": 17673.67, "timestamp": "04:54:33", "text": "えっと、彼らはただ…"}, {"type": "subtitle", "time": 17678.15, "timestamp": "04:54:38", "text": "彼らはそんなことをしてはいけないんです。 アノは"}, {"type": "subtitle", "time": 17690.15, "timestamp": "04:54:50", "text": "水を撒くのに、男は一人だけで十分だと思う。   ああ"}, {"type": "subtitle", "time": 17692.868, "timestamp": "04:54:52", "text": "、スペースがない。"}, {"type": "subtitle", "time": 17695.75, "timestamp": "04:54:55", "text": "よし、チェーンみたいなものが必要だ。"}]
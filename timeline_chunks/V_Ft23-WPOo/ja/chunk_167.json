[{"type": "subtitle", "time": 10030.71, "timestamp": "02:47:10", "text": "、結構です。"}, {"type": "subtitle", "time": 10033.75, "timestamp": "02:47:13", "text": "さて、ここからが本題です。"}, {"type": "subtitle", "time": 10037.11, "timestamp": "02:47:17", "text": "ああ、そうだね。 ああ、そうだね。"}, {"type": "subtitle", "time": 10050.63, "timestamp": "02:47:30", "text": "ニース。 ニース。 ニース。 ニース。   さあさあさあ"}, {"type": "subtitle", "time": 10054.23, "timestamp": "02:47:34", "text": "。 作ってみよう。 作ってみよう。"}, {"type": "subtitle", "time": 10064.469, "timestamp": "02:47:44", "text": "よし、次は2つ目を作るぞ"}, {"type": "subtitle", "time": 10074.07, "timestamp": "02:47:54", "text": "作れないよ、兄弟。"}, {"type": "subtitle", "time": 10076.79, "timestamp": "02:47:56", "text": "騙されたんだよ、"}, {"type": "subtitle", "time": 10079.99, "timestamp": "02:47:59", "text": "兄弟。 私は詐欺に遭いました。"}]
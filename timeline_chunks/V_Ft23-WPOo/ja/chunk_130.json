[{"type": "subtitle", "time": 7810.149, "timestamp": "02:10:10", "text": "ああ、神様、"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "、わかった。戻るよ。"}, {"type": "subtitle", "time": 7822.79, "timestamp": "02:10:22", "text": "硫黄を箱に入れるよ。"}, {"type": "subtitle", "time": 7827.91, "timestamp": "02:10:27", "text": "この木材を持ってこよう。 この基地には今すぐ木材が必要だ"}, {"type": "subtitle", "time": 7834.31, "timestamp": "02:10:34", "text": "。 え？ ああ、ごめん。 はい。"}]
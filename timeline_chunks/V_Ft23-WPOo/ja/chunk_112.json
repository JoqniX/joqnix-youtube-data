[{"type": "subtitle", "time": 6733.27, "timestamp": "01:52:13", "text": "インベントリ内のアイテムは、"}, {"type": "subtitle", "time": 6737.91, "timestamp": "01:52:17", "text": "基地内の近くのチェストに保管されます。順番に保管されるアイテムのみ"}, {"type": "subtitle", "time": 6740.47, "timestamp": "01:52:20", "text": "。それ以外のアイテムは保管されません。"}, {"type": "subtitle", "time": 6760.149, "timestamp": "01:52:40", "text": "必要。これが必要。"}, {"type": "subtitle", "time": 6762.95, "timestamp": "01:52:42", "text": "これは"}, {"type": "subtitle", "time": 6766.149, "timestamp": "01:52:46", "text": "必要だ。ライフル。ライフル。"}, {"type": "subtitle", "time": 6768.87, "timestamp": "01:52:48", "text": "これこれこれ"}, {"type": "subtitle", "time": 6771.589, "timestamp": "01:52:51", "text": "原油。くそ。"}, {"type": "subtitle", "time": 6773.75, "timestamp": "01:52:53", "text": "硬材がたくさんある。何が"}]
[{"type": "subtitle", "time": 2298.71, "timestamp": "00:38:18", "text": "問題は、私は自分自身を見失いたくないのに、"}, {"type": "subtitle", "time": 2310.069, "timestamp": "00:38:30", "text": "私には一緒に飛行機に乗る仲間がいません。 私には一緒に"}, {"type": "subtitle", "time": 2316.23, "timestamp": "00:38:36", "text": "散歩する仲間がいません。 何もない。   私には自分の"}]
[{"type": "subtitle", "time": 7622.39, "timestamp": "02:07:02", "text": "投げたのか？これは何だ？"}, {"type": "subtitle", "time": 7633.91, "timestamp": "02:07:13", "text": "いくつかやらなきゃ いろいろ。よし。えっと、"}, {"type": "subtitle", "time": 7640.79, "timestamp": "02:07:20", "text": "仲間は手に入れたよね？じゃあ、"}, {"type": "subtitle", "time": 7644.069, "timestamp": "02:07:24", "text": "調整しよう。"}, {"type": "subtitle", "time": 7648.069, "timestamp": "02:07:28", "text": "攻撃チームで行くよ。1、2、3"}, {"type": "subtitle", "time": 7651.75, "timestamp": "02:07:31", "text": "。本当は"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "4人欲しかったんだけど、"}, {"type": "subtitle", "time": 7656.87, "timestamp": "02:07:36", "text": "うっかり殺しちゃったんだ。これで"}, {"type": "subtitle", "time": 7664.79, "timestamp": "02:07:44", "text": "オートタレットみたいな攻撃系のアイテムが増えるよね？"}, {"type": "subtitle", "time": 7670.069, "timestamp": "02:07:50", "text": "待機用に鹿がいる。"}, {"type": "subtitle", "time": 7677.109, "timestamp": "02:07:57", "text": "飛行する仲間と一緒に行けると思う。"}]
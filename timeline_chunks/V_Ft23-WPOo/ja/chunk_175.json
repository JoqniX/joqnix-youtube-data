[{"type": "subtitle", "time": 10505.99, "timestamp": "02:55:05", "text": "ああ、上の部分がちょっと"}, {"type": "subtitle", "time": 10508.79, "timestamp": "02:55:08", "text": "面倒なんだ。 しかし、下半分はもっと"}, {"type": "subtitle", "time": 10513.19, "timestamp": "02:55:13", "text": "簡単だろう。 だからこそ、私は"}, {"type": "subtitle", "time": 10527.349, "timestamp": "02:55:27", "text": "ああ、なるほど。 分かりますよ。 分かりますよ。 分かりますよ"}, {"type": "subtitle", "time": 10543.03, "timestamp": "02:55:43", "text": "だから皆さん、何をすべきかはもうお分かりでしょう"}, {"type": "subtitle", "time": 10544.95, "timestamp": "02:55:44", "text": "。"}, {"type": "subtitle", "time": 10547.83, "timestamp": "02:55:47", "text": "ただ使うだけ ただ"}, {"type": "subtitle", "time": 10550.309, "timestamp": "02:55:50", "text": "使うだけ"}, {"type": "subtitle", "time": 10552.95, "timestamp": "02:55:52", "text": "待って、なぜオフになっているの？"}, {"type": "subtitle", "time": 10557.429, "timestamp": "02:55:57", "text": "待てよ、それってちょっとおかしいぞ。  N"}]
[{"type": "subtitle", "time": 12001.67, "timestamp": "03:20:01", "text": "悪くないね。 機能はする"}, {"type": "subtitle", "time": 12019.349, "timestamp": "03:20:19", "text": "農場にとっては、今は"}, {"type": "subtitle", "time": 12022.469, "timestamp": "03:20:22", "text": "オールインワン型の農場をやっているような気がしますが"}, {"type": "subtitle", "time": 12025.67, "timestamp": "03:20:25", "text": "、それはあまり良くないと思います。 それが私の"}, {"type": "subtitle", "time": 12041.91, "timestamp": "03:20:41", "text": "正直に言うと、そうすべきではないと思うんです"}, {"type": "subtitle", "time": 12044.87, "timestamp": "03:20:44", "text": "。 一つの基地は"}, {"type": "subtitle", "time": 12048.389, "timestamp": "03:20:48", "text": "一つの任務に集中しなければならない、といった具合だ。 別の基地は、"}]
[{"type": "subtitle", "time": 851.11, "timestamp": "00:14:11", "text": "[鼻を鳴らす]"}, {"type": "subtitle", "time": 853.189, "timestamp": "00:14:13", "text": "私の主な変人は分かってるよ。 大丈夫。 別に"}, {"type": "subtitle", "time": 865.59, "timestamp": "00:14:25", "text": "別のコインが届く。  [音楽] あと"}, {"type": "subtitle", "time": 887.11, "timestamp": "00:14:47", "text": "チャンスを逃したね。"}, {"type": "subtitle", "time": 890.87, "timestamp": "00:14:50", "text": "でも、私はクリティカルヒットを得られなかった。"}, {"type": "subtitle", "time": 894.31, "timestamp": "00:14:54", "text": "ニース。 私たちは自分たちの像を手に入れた。"}]
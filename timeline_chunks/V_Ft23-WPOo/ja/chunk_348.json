[{"type": "subtitle", "time": 20888.548, "timestamp": "05:48:08", "text": "でも、私にはアイデアがあるんです。"}, {"type": "subtitle", "time": 20892.948, "timestamp": "05:48:12", "text": "私が作れるかもしれない、私が作れるかもしれないと。   よし"}, {"type": "subtitle", "time": 20894.548, "timestamp": "05:48:14", "text": "。"}, {"type": "subtitle", "time": 20897.03, "timestamp": "05:48:17", "text": "しかし、私には資金がありません。 私の考えは、上に積み上げて、さらに上に"}, {"type": "subtitle", "time": 20906.868, "timestamp": "05:48:26", "text": "積み上げて、この"}, {"type": "subtitle", "time": 20911.27, "timestamp": "05:48:31", "text": "下部を"}, {"type": "subtitle", "time": 20915.19, "timestamp": "05:48:35", "text": "採掘エリアにして、そんな感じにできる、というものでした。   そっちの方がずっと"}]
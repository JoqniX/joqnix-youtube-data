[{"type": "subtitle", "time": 190.309, "timestamp": "00:03:10", "text": "またパルワールドをプレイします。 今日、"}, {"type": "subtitle", "time": 192.869, "timestamp": "00:03:12", "text": "私はこのゲームにハマっています。"}, {"type": "subtitle", "time": 195.50900000000001, "timestamp": "00:03:15", "text": "昨日は配信外で少しゲームをしていたと思う。"}, {"type": "subtitle", "time": 197.67000000000002, "timestamp": "00:03:17", "text": "今日は、リソースの確保"}, {"type": "subtitle", "time": 201.03, "timestamp": "00:03:21", "text": "と音楽の探求に"}, {"type": "subtitle", "time": 205.03, "timestamp": "00:03:25", "text": "少し焦点を当てていきます。 ゾーイを倒したりとか。 そう、"}, {"type": "subtitle", "time": 206.869, "timestamp": "00:03:26", "text": "剣とかそういうもの全部作るよ。"}, {"type": "subtitle", "time": 233.67000000000002, "timestamp": "00:03:53", "text": "今日は"}, {"type": "subtitle", "time": 236.789, "timestamp": "00:03:56", "text": "どこまで話しましたっけ？ とりあえず"}, {"type": "subtitle", "time": 239.27, "timestamp": "00:03:59", "text": "ここから出させてください。   えっと"}]
[{"type": "subtitle", "time": 17341.83, "timestamp": "04:49:01", "text": "財団はどこにあるの？"}, {"type": "subtitle", "time": 17345.27, "timestamp": "04:49:05", "text": "ああ、水生植物の殻の断片。 水中"}, {"type": "subtitle", "time": 17352.948, "timestamp": "04:49:12", "text": "木炭と炎。 わかった。 その前に、"}, {"type": "subtitle", "time": 17356.868, "timestamp": "04:49:16", "text": "製粉機を作ってもいいですか？ これは重要です。"}, {"type": "subtitle", "time": 17367.83, "timestamp": "04:49:27", "text": "彼らに、過酷な"}, {"type": "subtitle", "time": 17369.51, "timestamp": "04:49:29", "text": "ハードワークとか、超ハードワークとか、"}, {"type": "subtitle", "time": 17376.15, "timestamp": "04:49:36", "text": "いいえ、まず"}, {"type": "subtitle", "time": 17379.43, "timestamp": "04:49:39", "text": "効率化してから、もちろんそうします"}, {"type": "subtitle", "time": 17384.47, "timestamp": "04:49:44", "text": "。"}, {"type": "subtitle", "time": 17387.59, "timestamp": "04:49:47", "text": "つまり、爪や細胞は"}, {"type": "subtitle", "time": 17396.948, "timestamp": "04:49:56", "text": "一人は胃潰瘍を患っていて、もう一人はうつ病を患っている。"}]
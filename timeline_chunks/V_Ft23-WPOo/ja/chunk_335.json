[{"type": "subtitle", "time": 20102.47, "timestamp": "05:35:02", "text": "アディアナ、私は"}, {"type": "subtitle", "time": 20109.43, "timestamp": "05:35:09", "text": "空っぽの部屋を手に入れて、ここに落ち着いたような感じなの。"}, {"type": "subtitle", "time": 20111.99, "timestamp": "05:35:11", "text": "こっちに来てみませんか？"}, {"type": "subtitle", "time": 20115.27, "timestamp": "05:35:15", "text": "ええ、もっと空き地があります。"}, {"type": "subtitle", "time": 20152.31, "timestamp": "05:35:52", "text": "椅子を積み重ねることは可能ですか"}, {"type": "subtitle", "time": 20153.91, "timestamp": "05:35:53", "text": "？   そう"}, {"type": "subtitle", "time": 20157.27, "timestamp": "05:35:57", "text": "思います。"}]
[{"type": "subtitle", "time": 13471.83, "timestamp": "03:44:31", "text": "うん、心配しないで。 君たちを手伝ってあげるよ"}, {"type": "subtitle", "time": 13479.429, "timestamp": "03:44:39", "text": "あ、待って。 これらの人たちは"}, {"type": "subtitle", "time": 13483.03, "timestamp": "03:44:43", "text": "行動不能です。 ああ、くそ。"}, {"type": "subtitle", "time": 13486.07, "timestamp": "03:44:46", "text": "彼らの潰瘍を治さなければならない。 何てことだ"}, {"type": "subtitle", "time": 13495.269, "timestamp": "03:44:55", "text": "ああ、これはまずい。 これは私が"}]
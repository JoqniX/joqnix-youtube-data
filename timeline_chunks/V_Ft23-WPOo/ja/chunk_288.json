[{"type": "subtitle", "time": 17291.19, "timestamp": "04:48:11", "text": "私がこの店に早めに注文したという事実自体が、"}, {"type": "subtitle", "time": 17295.67, "timestamp": "04:48:15", "text": "不気味だ。   そうそう"}, {"type": "subtitle", "time": 17297.51, "timestamp": "04:48:17", "text": "。 あなたは既に2つの拠点を持っています"}, {"type": "subtitle", "time": 17299.27, "timestamp": "04:48:19", "text": "。"}, {"type": "subtitle", "time": 17310.708, "timestamp": "04:48:30", "text": "私は完全に自分のものにしたかったのです。 どんな状況でも私の"}, {"type": "subtitle", "time": 17313.11, "timestamp": "04:48:33", "text": "鉱石を採掘してくれる労働者が2人必要です"}, {"type": "subtitle", "time": 17315.91, "timestamp": "04:48:35", "text": "。 正気度がゼロの場合、どうすれば正気度を与えることができますか"}, {"type": "subtitle", "time": 17320.47, "timestamp": "04:48:40", "text": "？ 何か心当たりはありますか？"}, {"type": "subtitle", "time": 17325.67, "timestamp": "04:48:45", "text": "えっと、えっと、オネンを作ったんですか？   そうそう"}, {"type": "subtitle", "time": 17339.91, "timestamp": "04:48:59", "text": "王寧"}]
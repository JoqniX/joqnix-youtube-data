[{"type": "subtitle", "time": 19261.19, "timestamp": "05:21:01", "text": "友達も連れて行ったのに。まあ、"}, {"type": "subtitle", "time": 19264.15, "timestamp": "05:21:04", "text": "いいんだけど。"}, {"type": "subtitle", "time": 19267.11, "timestamp": "05:21:07", "text": "なぜ彼らはあそこで戦っているのですか？"}, {"type": "subtitle", "time": 19269.59, "timestamp": "05:21:09", "text": "私は変わらなければならない。 ほら、これ全部見てよ"}, {"type": "subtitle", "time": 19272.788, "timestamp": "05:21:12", "text": "。 全員死亡した。 さて、この馬は誰の馬でしょうか"}, {"type": "subtitle", "time": 19282.39, "timestamp": "05:21:22", "text": "彼らを引っ張って、そう。"}, {"type": "subtitle", "time": 19285.99, "timestamp": "05:21:25", "text": "箱を開けて中身を取り出す。"}, {"type": "subtitle", "time": 19291.51, "timestamp": "05:21:31", "text": "さらにサポートが必要な場合はお知らせください。"}]
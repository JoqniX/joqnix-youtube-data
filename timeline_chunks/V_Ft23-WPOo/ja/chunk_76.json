[{"type": "subtitle", "time": 4563.27, "timestamp": "01:16:03", "text": "扱い、採掘、火、"}, {"type": "subtitle", "time": 4579.669, "timestamp": "01:16:19", "text": "私はただ、"}, {"type": "subtitle", "time": 4581.83, "timestamp": "01:16:21", "text": "これらの人々に"}, {"type": "subtitle", "time": 4585.11, "timestamp": "01:16:25", "text": "適切に餌を与えて、彼らが"}, {"type": "subtitle", "time": 4589.03, "timestamp": "01:16:29", "text": "空腹になって時間とともに死んだりしないようにするための資源が必要なだけだ。"}, {"type": "subtitle", "time": 4591.669, "timestamp": "01:16:31", "text": "今、撮影中だ。ああ。"}, {"type": "subtitle", "time": 4594.07, "timestamp": "01:16:34", "text": "さようなら。ここでさようなら。"}]
[{"type": "subtitle", "time": 7440.55, "timestamp": "02:04:00", "text": "男は死んだ。鉱石はどうだ？"}, {"type": "subtitle", "time": 7443.83, "timestamp": "02:04:03", "text": "鉱石にも同じことができる。クレイジーだな"}, {"type": "subtitle", "time": 7478.79, "timestamp": "02:04:38", "text": "。多すぎる。よし、"}, {"type": "subtitle", "time": 7482.229, "timestamp": "02:04:42", "text": "基地に戻って石の"}, {"type": "subtitle", "time": 7483.99, "timestamp": "02:04:43", "text": "ものを"}, {"type": "subtitle", "time": 7490.07, "timestamp": "02:04:50", "text": "あと、体も変えなきゃ。"}, {"type": "subtitle", "time": 7496.629, "timestamp": "02:04:56", "text": "基地で鉱山を作れると思う。ああ"}]
[{"type": "subtitle", "time": 5164.709, "timestamp": "01:26:04", "text": "基地に戻る必要がある。本拠地。よくやった。よくやった。よくやった。"}, {"type": "subtitle", "time": 5178.709, "timestamp": "01:26:18", "text": "拾えない。わあ。"}, {"type": "subtitle", "time": 5180.709, "timestamp": "01:26:20", "text": "よし。"}, {"type": "subtitle", "time": 5193.669, "timestamp": "01:26:33", "text": "いい仲間も本当に必要だ。よし、"}, {"type": "subtitle", "time": 5197.51, "timestamp": "01:26:37", "text": "ここでやらなきゃいけないことの1つは、"}, {"type": "subtitle", "time": 5200.07, "timestamp": "01:26:40", "text": "これらのインゴットを全部ここに置くことだ"}, {"type": "subtitle", "time": 5202.47, "timestamp": "01:26:42", "text": "。[鼻を鳴らす]"}, {"type": "subtitle", "time": 5204.87, "timestamp": "01:26:44", "text": "つまり、ここかここだ。それから、"}, {"type": "subtitle", "time": 5208.709, "timestamp": "01:26:48", "text": "640に増やすだけだ。うん。"}, {"type": "subtitle", "time": 5210.31, "timestamp": "01:26:50", "text": "生産開始。"}, {"type": "subtitle", "time": 5217.75, "timestamp": "01:26:57", "text": "それから私の考えは、"}]
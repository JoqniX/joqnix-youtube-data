[{"type": "subtitle", "time": 2882.47, "timestamp": "00:48:02", "text": "こんにちは、蘭石。 今、私の声が聞こえますか？"}, {"type": "subtitle", "time": 2886.309, "timestamp": "00:48:06", "text": "こんにちは。 こんにちは。 こんにちは。 ようこそ。"}, {"type": "subtitle", "time": 2893.27, "timestamp": "00:48:13", "text": "何？   わからない"}, {"type": "subtitle", "time": 2896.87, "timestamp": "00:48:16", "text": "。 まるでプールで泳いでいるような気分だ"}, {"type": "chat", "time": 2899.619, "timestamp": "00:48:19", "author": "@rengokukyojuro-yl2sv", "avatar": "https://yt4.ggpht.com/8VafSECy9HAmQZVPoSCyzH-vjcJrgjEiphznSh1p0pMY_fI0EAXPBz4hh6ovpjKxrhYA6ag7_Q=s64-c-k-c0x00ffffff-no-rj", "message": "it's me the good old rengoku"}, {"type": "subtitle", "time": 2906.15, "timestamp": "00:48:26", "text": "彼らは楽しんでいるよ。"}, {"type": "subtitle", "time": 2908.309, "timestamp": "00:48:28", "text": "蘭岳川へようこそ"}, {"type": "subtitle", "time": 2911.99, "timestamp": "00:48:31", "text": "。 お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 2914.549, "timestamp": "00:48:34", "text": "私だよ、あの蘭石さ。 はい、"}, {"type": "chat", "time": 2916.337, "timestamp": "00:48:36", "author": "@rengokukyojuro-yl2sv", "avatar": "https://yt4.ggpht.com/8VafSECy9HAmQZVPoSCyzH-vjcJrgjEiphznSh1p0pMY_fI0EAXPBz4hh6ovpjKxrhYA6ag7_Q=s64-c-k-c0x00ffffff-no-rj", "message": "so how have you been"}, {"type": "subtitle", "time": 2918.63, "timestamp": "00:48:38", "text": "覚えていますよ。 久しぶりですね。"}, {"type": "subtitle", "time": 2931.03, "timestamp": "00:48:51", "text": "？ 私は元気でした。 私は"}, {"type": "subtitle", "time": 2935.67, "timestamp": "00:48:55", "text": "現在、語学留学などで日本に滞在しています"}, {"type": "subtitle", "time": 2937.91, "timestamp": "00:48:57", "text": "。"}]
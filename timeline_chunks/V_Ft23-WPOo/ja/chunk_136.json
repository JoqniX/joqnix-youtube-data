[{"type": "subtitle", "time": 8162.39, "timestamp": "02:16:02", "text": "うん、グライダーを手に入れたよ。"}, {"type": "subtitle", "time": 8169.51, "timestamp": "02:16:09", "text": "古いものは分解できると思う。"}, {"type": "subtitle", "time": 8171.669, "timestamp": "02:16:11", "text": "うん。 そもそもなぜそれが必要なのか"}, {"type": "subtitle", "time": 8194.629, "timestamp": "02:16:34", "text": "これが必要だ。 古代文明の部品はどうすれば入手できますか"}]
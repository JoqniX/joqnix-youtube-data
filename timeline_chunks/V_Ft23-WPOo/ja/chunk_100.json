[{"type": "subtitle", "time": 6008.39, "timestamp": "01:40:08", "text": "原始炉って誰？"}, {"type": "subtitle", "time": 6011.189, "timestamp": "01:40:11", "text": "待って、粉砕機はない。"}, {"type": "subtitle", "time": 6015.189, "timestamp": "01:40:15", "text": "君にそうしてほしくないと思う。"}, {"type": "subtitle", "time": 6017.99, "timestamp": "01:40:17", "text": "ああ、これが私が探していたものだ。"}, {"type": "subtitle", "time": 6021.109, "timestamp": "01:40:21", "text": "彼に手仕事をさせよう。"}, {"type": "subtitle", "time": 6024.07, "timestamp": "01:40:24", "text": "伐採はない。"}, {"type": "subtitle", "time": 6027.43, "timestamp": "01:40:27", "text": "薬。いいだろう。"}, {"type": "subtitle", "time": 6030.07, "timestamp": "01:40:30", "text": "あれは？ ない。"}, {"type": "subtitle", "time": 6054.31, "timestamp": "01:40:54", "text": "ああ、彼は大丈夫だ。君のガールフレンドを渡せ。"}]
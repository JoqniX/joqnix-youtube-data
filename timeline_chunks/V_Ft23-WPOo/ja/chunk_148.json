[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "もっと炎を燃やせ。 ありがとう。"}, {"type": "subtitle", "time": 8892.15, "timestamp": "02:28:12", "text": "これ。 わからない。 なぜそうなっているのか、私には分かりません"}, {"type": "subtitle", "time": 8909.67, "timestamp": "02:28:29", "text": "ああ、彼らは復活するんだ。"}, {"type": "subtitle", "time": 8912.79, "timestamp": "02:28:32", "text": "ペンギュレットにはもっと多くの意味があります"}, {"type": "subtitle", "time": 8922.63, "timestamp": "02:28:42", "text": "私は彼らを殺した。 誤って殺してしまった。"}, {"type": "subtitle", "time": 8925.19, "timestamp": "02:28:45", "text": "ヒューッ。"}]
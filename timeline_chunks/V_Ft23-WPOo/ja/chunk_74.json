[{"type": "subtitle", "time": 4444.87, "timestamp": "01:14:04", "text": "よし、それはある。そして、キャンプファイヤー、"}, {"type": "subtitle", "time": 4451.189, "timestamp": "01:14:11", "text": "実際、クッキングボックスを置くだけでいい。"}, {"type": "subtitle", "time": 4453.51, "timestamp": "01:14:13", "text": "でも、この炎、あるいはまた、これはどうやって手に入れるの"}, {"type": "subtitle", "time": 4455.75, "timestamp": "01:14:15", "text": "？"}, {"type": "subtitle", "time": 4459.51, "timestamp": "01:14:19", "text": "炎や"}]
[{"type": "subtitle", "time": 5521.669, "timestamp": "01:32:01", "text": "クロスボウをもう一度用意する必要があるかもしれません。"}, {"type": "subtitle", "time": 5525.189, "timestamp": "01:32:05", "text": "ええ、そうします。それから"}, {"type": "subtitle", "time": 5527.11, "timestamp": "01:32:07", "text": "食事に行きます。誰が"}, {"type": "subtitle", "time": 5529.27, "timestamp": "01:32:09", "text": "来るかわかりません。"}, {"type": "subtitle", "time": 5532.149, "timestamp": "01:32:12", "text": "仲間がいるなら、"}, {"type": "subtitle", "time": 5538.709, "timestamp": "01:32:18", "text": "仲間を捕らえる準備をしなければならないかもしれません。"}, {"type": "subtitle", "time": 5545.99, "timestamp": "01:32:25", "text": "待って、これらはどこに持っていくのですか？ああ、"}, {"type": "subtitle", "time": 5549.35, "timestamp": "01:32:29", "text": "彼はそれをどこに入れているのですか？"}, {"type": "subtitle", "time": 5552.31, "timestamp": "01:32:32", "text": "宝箱の中ですか？"}, {"type": "subtitle", "time": 5559.99, "timestamp": "01:32:39", "text": "待って、それをどこに入れたのですか？"}, {"type": "subtitle", "time": 5569.669, "timestamp": "01:32:49", "text": "ええと、そこそこ強い仲間を手に入れることができます。"}, {"type": "subtitle", "time": 5572.07, "timestamp": "01:32:52", "text": "だからインゴットが必要です。インゴットが必要です。"}, {"type": "subtitle", "time": 5575.91, "timestamp": "01:32:55", "text": "よし。待って。今はもっとこれが必要です"}]
[{"type": "subtitle", "time": 6181.35, "timestamp": "01:43:01", "text": "わかった、じゃあそれを修理しなきゃ"}, {"type": "subtitle", "time": 6187.51, "timestamp": "01:43:07", "text": "それがまさにそれだ。わかった。Cは何をしましたか"}, {"type": "subtitle", "time": 6199.91, "timestamp": "01:43:19", "text": "ああ、終わるよ。手伝わせて。"}, {"type": "subtitle", "time": 6203.27, "timestamp": "01:43:23", "text": "ありがとう。"}, {"type": "subtitle", "time": 6206.79, "timestamp": "01:43:26", "text": "こんにちは。今、私が必要なのは"}, {"type": "subtitle", "time": 6209.43, "timestamp": "01:43:29", "text": "ナイトウィングです。ああ、服だけが必要なんだ。わかった"}, {"type": "subtitle", "time": 6227.35, "timestamp": "01:43:47", "text": "。ありがとう、相棒。"}]
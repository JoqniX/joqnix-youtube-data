[{"type": "subtitle", "time": 2824.39, "timestamp": "00:47:04", "text": "私のアパートのインターネット接続がこんなに悪いのか。   はい"}, {"type": "subtitle", "time": 2830.069, "timestamp": "00:47:10", "text": "私のアパートのインターネット接続は"}, {"type": "subtitle", "time": 2844.23, "timestamp": "00:47:24", "text": "想像してみてください。私は今とても"}, {"type": "subtitle", "time": 2851.27, "timestamp": "00:47:31", "text": "低レベルなのに、高レベルのゾーンエリアにいるんです"}, {"type": "subtitle", "time": 2855.19, "timestamp": "00:47:35", "text": "。 私はほとんど何も持っていない。   私には"}, {"type": "subtitle", "time": 2858.95, "timestamp": "00:47:38", "text": "親しい友人とかはいません。"}, {"type": "subtitle", "time": 2860.95, "timestamp": "00:47:40", "text": "そして私はここで探索を続け、"}, {"type": "subtitle", "time": 2864.23, "timestamp": "00:47:44", "text": "中級レベルの強力な"}, {"type": "subtitle", "time": 2865.91, "timestamp": "00:47:45", "text": "領域に到達しました。"}, {"type": "chat", "time": 2868.939, "timestamp": "00:47:48", "author": "@rengokukyojuro-yl2sv", "avatar": "https://yt4.ggpht.com/8VafSECy9HAmQZVPoSCyzH-vjcJrgjEiphznSh1p0pMY_fI0EAXPBz4hh6ovpjKxrhYA6ag7_Q=s64-c-k-c0x00ffffff-no-rj", "message": "yo"}, {"type": "subtitle", "time": 2869.27, "timestamp": "00:47:49", "text": "うん。 おい。"}]
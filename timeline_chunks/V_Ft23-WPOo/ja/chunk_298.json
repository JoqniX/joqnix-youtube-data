[{"type": "subtitle", "time": 17901.35, "timestamp": "04:58:21", "text": "アライ、ここから精製されているオルスを取っておいても大丈夫だと思いますよ"}, {"type": "subtitle", "time": 17907.99, "timestamp": "04:58:27", "text": "。 あなたが望むなら。 それなら"}, {"type": "subtitle", "time": 17911.67, "timestamp": "04:58:31", "text": "、地下室で。"}, {"type": "subtitle", "time": 17916.55, "timestamp": "04:58:36", "text": "待って、待って、彼は働いていないのは、"}, {"type": "subtitle", "time": 17919.51, "timestamp": "04:58:39", "text": "ええ。 えっと、夕食を作って食べてきます。それから戻ってきます"}]
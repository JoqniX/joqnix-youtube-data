[{"type": "subtitle", "time": 9000.63, "timestamp": "02:30:00", "text": "それはキツネの火花だ。"}, {"type": "subtitle", "time": 9003.349, "timestamp": "02:30:03", "text": "ああ、君のことは分かったよ。"}, {"type": "subtitle", "time": 9015.349, "timestamp": "02:30:15", "text": "この本箱は何ですか？"}, {"type": "subtitle", "time": 9019.19, "timestamp": "02:30:19", "text": "私はこれらの選手を持っていません。"}]
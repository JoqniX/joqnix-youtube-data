[{"type": "subtitle", "time": 20821.19, "timestamp": "05:47:01", "text": "いいえ、敵はあちらにいます。"}, {"type": "subtitle", "time": 20824.548, "timestamp": "05:47:04", "text": "あの地域。 ええ、パル"}, {"type": "subtitle", "time": 20826.07, "timestamp": "05:47:06", "text": "ボックスを置くと、"}, {"type": "subtitle", "time": 20829.19, "timestamp": "05:47:09", "text": "そのエリアは他の野生のパルが住めなくなる場所になります。"}, {"type": "subtitle", "time": 20843.67, "timestamp": "05:47:23", "text": "野生の"}]
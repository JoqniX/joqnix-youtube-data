[{"type": "subtitle", "time": 19621.59, "timestamp": "05:27:01", "text": "そうですね、こう言いましょう"}, {"type": "subtitle", "time": 19624.708, "timestamp": "05:27:04", "text": "。"}, {"type": "subtitle", "time": 19644.23, "timestamp": "05:27:24", "text": "このベースは文字通り"}, {"type": "subtitle", "time": 19654.47, "timestamp": "05:27:34", "text": "製油所を2つ持つことができるということだ。"}, {"type": "subtitle", "time": 19656.628, "timestamp": "05:27:36", "text": "でもよく考えてみれば、"}, {"type": "subtitle", "time": 19659.83, "timestamp": "05:27:39", "text": "電力や発電機などをアンロックすれば、"}, {"type": "subtitle", "time": 19667.83, "timestamp": "05:27:47", "text": "[咳払い]"}, {"type": "subtitle", "time": 19670.628, "timestamp": "05:27:50", "text": "ええ、発電機のロックを解除できたと思うんですが、"}, {"type": "subtitle", "time": 19677.75, "timestamp": "05:27:57", "text": "それと、あなたの友達は大丈夫ですか？ 彼らは全員"}, {"type": "subtitle", "time": 19679.35, "timestamp": "05:27:59", "text": "死んだ。"}]
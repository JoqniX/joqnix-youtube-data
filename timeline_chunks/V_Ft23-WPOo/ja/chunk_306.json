[{"type": "subtitle", "time": 18381.27, "timestamp": "05:06:21", "text": "あれらは野生だ。   はい"}, {"type": "subtitle", "time": 18383.27, "timestamp": "05:06:23", "text": "、戻ってきました。 戻ってきました。   わかった"}, {"type": "subtitle", "time": 18409.51, "timestamp": "05:06:49", "text": "つまり、最近"}, {"type": "subtitle", "time": 18412.39, "timestamp": "05:06:52", "text": "消化器系の調子が悪いんです"}, {"type": "subtitle", "time": 18418.31, "timestamp": "05:06:58", "text": "。 それで、"}]
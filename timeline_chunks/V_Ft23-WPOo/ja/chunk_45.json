[{"type": "subtitle", "time": 2703.03, "timestamp": "00:45:03", "text": "それは本当にクールな赤い胸ですか？ ああ、"}, {"type": "subtitle", "time": 2705.27, "timestamp": "00:45:05", "text": "銅製の鍵が必要だ。"}, {"type": "subtitle", "time": 2707.99, "timestamp": "00:45:07", "text": "あなたのことは知っていると思うのですが、"}, {"type": "subtitle", "time": 2710.79, "timestamp": "00:45:10", "text": "あなたのモデルは動きが止まっているように見えます。"}, {"type": "subtitle", "time": 2714.15, "timestamp": "00:45:14", "text": "現時点ではPNG形式です。"}, {"type": "subtitle", "time": 2720.47, "timestamp": "00:45:20", "text": "将来的には、それを改造するつもりだ。"}, {"type": "subtitle", "time": 2724.23, "timestamp": "00:45:24", "text": "だから、今はリギングが高額だし、"}, {"type": "subtitle", "time": 2727.51, "timestamp": "00:45:27", "text": "内部の問題や"}, {"type": "subtitle", "time": 2732.15, "timestamp": "00:45:32", "text": "金銭的な問題もあるので、"}, {"type": "subtitle", "time": 2735.19, "timestamp": "00:45:35", "text": "壊すことはできないんです。"}, {"type": "subtitle", "time": 2737.67, "timestamp": "00:45:37", "text": "イアン90を行うことによって。"}, {"type": "subtitle", "time": 2740.23, "timestamp": "00:45:40", "text": "これは何ですか？"}, {"type": "subtitle", "time": 2743.829, "timestamp": "00:45:43", "text": "この基地は何ですか？"}, {"type": "subtitle", "time": 2747.67, "timestamp": "00:45:47", "text": "いいね。 とにかく、えーと、"}, {"type": "subtitle", "time": 2749.829, "timestamp": "00:45:49", "text": "不運にも莫大な費用がかかります。 うん。"}, {"type": "subtitle", "time": 2753.51, "timestamp": "00:45:53", "text": "はい、そうです。 それで、当時、モデル"}]
[{"type": "subtitle", "time": 6061.27, "timestamp": "01:41:01", "text": "あ、彼が来た。"}, {"type": "subtitle", "time": 6066.07, "timestamp": "01:41:06", "text": "うん、君の方が速い。ありがとう。待って、"}, {"type": "subtitle", "time": 6073.75, "timestamp": "01:41:13", "text": "二人とも助けて。"}, {"type": "subtitle", "time": 6076.709, "timestamp": "01:41:16", "text": "待って、一人しか作業できないよ。"}, {"type": "subtitle", "time": 6086.79, "timestamp": "01:41:26", "text": "。わかった、一人がやらなきゃいけないと思う。わあ。"}, {"type": "subtitle", "time": 6094.39, "timestamp": "01:41:34", "text": "行為は終わった。やった。"}, {"type": "subtitle", "time": 6097.83, "timestamp": "01:41:37", "text": "これで"}, {"type": "subtitle", "time": 6107.75, "timestamp": "01:41:47", "text": "よし、そうなら彼に切り替えて"}, {"type": "subtitle", "time": 6119.75, "timestamp": "01:41:59", "text": "そんなに木が好きなの"}]
[{"type": "subtitle", "time": 19440.868, "timestamp": "05:24:00", "text": "えっと、彼女を何に利用していたんですか？"}, {"type": "subtitle", "time": 19444.31, "timestamp": "05:24:04", "text": "えっと、ライブ2Dのやつ。"}, {"type": "subtitle", "time": 19454.708, "timestamp": "05:24:14", "text": "。 クレジットをもっと追加する必要がある。"}, {"type": "subtitle", "time": 19458.23, "timestamp": "05:24:18", "text": "しかし、追加するか、料金を支払う必要があります。"}, {"type": "subtitle", "time": 19461.27, "timestamp": "05:24:21", "text": "私も同じことをしました。"}, {"type": "subtitle", "time": 19466.948, "timestamp": "05:24:26", "text": "。 私は既にいくら使ったのか？   見てみましょう"}, {"type": "subtitle", "time": 19472.15, "timestamp": "05:24:32", "text": "30."}, {"type": "subtitle", "time": 19474.628, "timestamp": "05:24:34", "text": "待って、どうすれば友達を"}, {"type": "subtitle", "time": 19499.27, "timestamp": "05:24:59", "text": "。"}]
[{"type": "subtitle", "time": 2641.349, "timestamp": "00:44:01", "text": "好吧，我输了，我扔掉了我最后一根能量"}, {"type": "subtitle", "time": 2644.87, "timestamp": "00:44:04", "text": "棒。 我的天啊。 你肯定是在"}, {"type": "subtitle", "time": 2656.79, "timestamp": "00:44:16", "text": "当我的东西丢失时。"}, {"type": "subtitle", "time": 2659.99, "timestamp": "00:44:19", "text": "你好世界，欢迎光临。"}, {"type": "subtitle", "time": 2677.99, "timestamp": "00:44:37", "text": "嘿。 我要去。 我一切都很好。"}, {"type": "subtitle", "time": 2680.23, "timestamp": "00:44:40", "text": "我们正在寻找一个可以"}, {"type": "subtitle", "time": 2687.27, "timestamp": "00:44:47", "text": "解救马匹之类的地方。"}, {"type": "subtitle", "time": 2695.589, "timestamp": "00:44:55", "text": "所以，等等。 为什么那个箱子上的红光会亮起来"}]
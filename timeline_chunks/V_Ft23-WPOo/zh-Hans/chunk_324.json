[{"type": "subtitle", "time": 19440.868, "timestamp": "05:24:00", "text": "呃，你利用她做什么？"}, {"type": "subtitle", "time": 19444.31, "timestamp": "05:24:04", "text": "呃，就是那个实时2D的东西。"}, {"type": "subtitle", "time": 19454.708, "timestamp": "05:24:14", "text": "我们走吧。 我需要添加更多学分。"}, {"type": "subtitle", "time": 19458.23, "timestamp": "05:24:18", "text": "但你需要添加内容，否则就要付费。"}, {"type": "subtitle", "time": 19461.27, "timestamp": "05:24:21", "text": "我也做了同样的事情。"}, {"type": "subtitle", "time": 19466.948, "timestamp": "05:24:26", "text": "我没钱了。 我已经花了多少钱？"}, {"type": "subtitle", "time": 19472.15, "timestamp": "05:24:32", "text": "30."}, {"type": "subtitle", "time": 19474.628, "timestamp": "05:24:34", "text": "等等，我该如何让朋友"}, {"type": "subtitle", "time": 19499.27, "timestamp": "05:24:59", "text": "好的。"}]
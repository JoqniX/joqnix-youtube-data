[{"type": "subtitle", "time": 17651.67, "timestamp": "04:54:11", "text": "收割、收集、"}, {"type": "subtitle", "time": 17659.91, "timestamp": "04:54:19", "text": "又是什么东西在聚集？"}, {"type": "subtitle", "time": 17661.59, "timestamp": "04:54:21", "text": "我当时在想那个节目。 是啊，是啊，是"}, {"type": "subtitle", "time": 17673.67, "timestamp": "04:54:33", "text": "嗯，这些人可以这么做。"}, {"type": "subtitle", "time": 17678.15, "timestamp": "04:54:38", "text": "他们不应该这么做。 阿诺是"}, {"type": "subtitle", "time": 17688.23, "timestamp": "04:54:48", "text": "我觉得只需要一个人来"}, {"type": "subtitle", "time": 17690.15, "timestamp": "04:54:50", "text": "浇水就行了。"}, {"type": "subtitle", "time": 17692.868, "timestamp": "04:54:52", "text": "天哪，我没地方放了。"}, {"type": "subtitle", "time": 17695.75, "timestamp": "04:54:55", "text": "好吧，我需要一条链子之类的东西。"}]
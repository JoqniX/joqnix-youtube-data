[{"type": "subtitle", "time": 6780.229, "timestamp": "01:53:00", "text": "抵抗线图。我把它放"}, {"type": "subtitle", "time": 6782.149, "timestamp": "01:53:02", "text": "这儿。"}, {"type": "subtitle", "time": 6785.83, "timestamp": "01:53:05", "text": "呃，浆果种子。"}, {"type": "subtitle", "time": 6799.35, "timestamp": "01:53:19", "text": "我在穹顶里。什么？"}, {"type": "subtitle", "time": 6822.229, "timestamp": "01:53:42", "text": "好吧。呃，弓。好吧。把这家伙放这儿。"}, {"type": "subtitle", "time": 6825.75, "timestamp": "01:53:45", "text": "我有点困惑为什么我没法……"}, {"type": "subtitle", "time": 6828.39, "timestamp": "01:53:48", "text": "修理我的"}, {"type": "subtitle", "time": 6838.31, "timestamp": "01:53:58", "text": "看看这些人。他……他们已经在"}]
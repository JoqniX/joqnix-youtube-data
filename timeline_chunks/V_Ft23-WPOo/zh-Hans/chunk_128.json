[{"type": "subtitle", "time": 7701.669, "timestamp": "02:08:21", "text": "我没有那个东西。我没有"}, {"type": "subtitle", "time": 7710.39, "timestamp": "02:08:30", "text": "它们在那儿吗？ 布料和锭。"}, {"type": "subtitle", "time": 7712.47, "timestamp": "02:08:32", "text": "好的，"}, {"type": "subtitle", "time": 7716.87, "timestamp": "02:08:36", "text": "我有布料了。我只需要15个锭。"}, {"type": "subtitle", "time": 7720.39, "timestamp": "02:08:40", "text": "我想我已经把箱子放好了。我的天，"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "箱子是空的。什么？"}, {"type": "subtitle", "time": 7726.069, "timestamp": "02:08:46", "text": "好吧，如果是这样的话，我们"}, {"type": "subtitle", "time": 7729.669, "timestamp": "02:08:49", "text": "就得换到另一个基地，"}, {"type": "subtitle", "time": 7734.629, "timestamp": "02:08:54", "text": "重新采集矿石了。我现在也得修好"}, {"type": "subtitle", "time": 7739.109, "timestamp": "02:08:59", "text": "这个基地了。哦不。"}]
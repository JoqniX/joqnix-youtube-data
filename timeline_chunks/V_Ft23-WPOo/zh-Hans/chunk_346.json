[{"type": "subtitle", "time": 20781.35, "timestamp": "05:46:21", "text": "我的意思是，你当时也在出生点，所以，是的，"}, {"type": "subtitle", "time": 20789.03, "timestamp": "05:46:29", "text": "那是我作为运动员的整个人生中犯过的最愚蠢的错误"}, {"type": "subtitle", "time": 20792.39, "timestamp": "05:46:32", "text": "。"}, {"type": "subtitle", "time": 20794.868, "timestamp": "05:46:34", "text": "我的天哪，我被人跟踪了。 我"}, {"type": "subtitle", "time": 20797.67, "timestamp": "05:46:37", "text": "摧毁了巴尔盒子，他们要来"}, {"type": "subtitle", "time": 20806.23, "timestamp": "05:46:46", "text": "我的天哪。"}, {"type": "subtitle", "time": 20809.11, "timestamp": "05:46:49", "text": "哇。"}, {"type": "subtitle", "time": 20815.35, "timestamp": "05:46:55", "text": "该死。"}, {"type": "subtitle", "time": 20815.83, "timestamp": "05:46:55", "text": "我听到“"}, {"type": "subtitle", "time": 20818.47, "timestamp": "05:46:58", "text": "等等，你的同伙要来杀你了”这句话。"}]
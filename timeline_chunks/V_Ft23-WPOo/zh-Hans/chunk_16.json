[{"type": "subtitle", "time": 963.749, "timestamp": "00:16:03", "text": "今天你是怎么找到我的？"}, {"type": "subtitle", "time": 973.189, "timestamp": "00:16:13", "text": "等九天。 所以这意味着你已经等了"}, {"type": "subtitle", "time": 979.43, "timestamp": "00:16:19", "text": "一段时间才想改变它。   是的，说实话，"}, {"type": "subtitle", "time": 986.47, "timestamp": "00:16:26", "text": "我懂那种感觉。"}, {"type": "subtitle", "time": 989.11, "timestamp": "00:16:29", "text": "我不小心改了名字，现在"}, {"type": "subtitle", "time": 993.35, "timestamp": "00:16:33", "text": "想改回原来的名字。 我等了多久？到底等了"}, {"type": "subtitle", "time": 995.59, "timestamp": "00:16:35", "text": "几个月？"}, {"type": "subtitle", "time": 999.67, "timestamp": "00:16:39", "text": "我想大概是90天或者3个月吧，"}]
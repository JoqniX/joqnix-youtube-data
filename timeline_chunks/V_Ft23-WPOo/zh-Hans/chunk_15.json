[{"type": "subtitle", "time": 900.389, "timestamp": "00:15:00", "text": "好的。 我为什么又来这里了？ 我需要"}, {"type": "subtitle", "time": 903.829, "timestamp": "00:15:03", "text": "找个地方耕种或者建立"}, {"type": "subtitle", "time": 910.55, "timestamp": "00:15:10", "text": "好的。"}, {"type": "subtitle", "time": 915.11, "timestamp": "00:15:15", "text": "服务器现在能赚多少钱？"}, {"type": "subtitle", "time": 925.99, "timestamp": "00:15:25", "text": "拜托。 快点。 快点。 我们只需要"}, {"type": "subtitle", "time": 941.67, "timestamp": "00:15:41", "text": "那么，灵子今天过得怎么样？"}, {"type": "subtitle", "time": 945.509, "timestamp": "00:15:45", "text": "你好吗？ 希望"}, {"type": "subtitle", "time": 948.069, "timestamp": "00:15:48", "text": "你一切安好。 周末总会"}, {"type": "subtitle", "time": 950.389, "timestamp": "00:15:50", "text": "到来的，对吧？"}, {"type": "subtitle", "time": 953.59, "timestamp": "00:15:53", "text": "明天就是星期五了。"}, {"type": "subtitle", "time": 955.509, "timestamp": "00:15:55", "text": "感谢您的关注。 今天你是怎么"}]
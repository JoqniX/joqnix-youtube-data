[{"type": "subtitle", "time": 7810.149, "timestamp": "02:10:10", "text": "，"}, {"type": "subtitle", "time": 7819.03, "timestamp": "02:10:19", "text": "好吧，没事。我回去。我把"}, {"type": "subtitle", "time": 7822.79, "timestamp": "02:10:22", "text": "硫磺放在箱子里。"}, {"type": "subtitle", "time": 7824.95, "timestamp": "02:10:24", "text": "我们把"}, {"type": "subtitle", "time": 7827.91, "timestamp": "02:10:27", "text": "这个木头……木头 这个基地"}, {"type": "subtitle", "time": 7834.31, "timestamp": "02:10:34", "text": "现在急需木头。嗯？哦，抱歉。给你。"}]
[{"type": "subtitle", "time": 5122.149, "timestamp": "01:25:22", "text": "嗨，我们有足够的床来做面板，"}, {"type": "subtitle", "time": 5125.03, "timestamp": "01:25:25", "text": "但是缺木头。"}, {"type": "subtitle", "time": 5127.83, "timestamp": "01:25:27", "text": "顺便说一句，你们缺木头。"}, {"type": "subtitle", "time": 5131.11, "timestamp": "01:25:31", "text": "好了，大家都睡个好觉。"}, {"type": "subtitle", "time": 5136.95, "timestamp": "01:25:36", "text": "我一会儿就回来。好的，"}, {"type": "subtitle", "time": 5138.55, "timestamp": "01:25:38", "text": "他们会回来的。这是我的第二个"}, {"type": "subtitle", "time": 5141.03, "timestamp": "01:25:41", "text": "基地。"}, {"type": "subtitle", "time": 5144.87, "timestamp": "01:25:44", "text": "这是什么地方？这些是什么？看起来"}, {"type": "subtitle", "time": 5147.91, "timestamp": "01:25:47", "text": "像…… 托伦之类的。试着……就像"}, {"type": "subtitle", "time": 5155.83, "timestamp": "01:25:55", "text": "屋不行。我们……嗯，我们需要"}, {"type": "subtitle", "time": 5158.629, "timestamp": "01:25:58", "text": "收集所有这些矿石。带上"}]
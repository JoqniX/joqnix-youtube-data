[{"type": "subtitle", "time": 18696.15, "timestamp": "05:11:36", "text": "你把猛犸象杀了。 我勒个去？"}, {"type": "subtitle", "time": 18700.15, "timestamp": "05:11:40", "text": "你们打算怎么打架？"}, {"type": "subtitle", "time": 18701.99, "timestamp": "05:11:41", "text": "你是怎么弄到这么多鸡蛋的？"}, {"type": "subtitle", "time": 18704.23, "timestamp": "05:11:44", "text": "在哪里？ 从哪里？"}, {"type": "subtitle", "time": 18707.03, "timestamp": "05:11:47", "text": "农场鸡蛋。"}, {"type": "subtitle", "time": 18715.51, "timestamp": "05:11:55", "text": "是另一个女孩的？ 哦，你在"}]
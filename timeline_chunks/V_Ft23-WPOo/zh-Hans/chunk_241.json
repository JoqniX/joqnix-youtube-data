[{"type": "subtitle", "time": 14490.389, "timestamp": "04:01:30", "text": "好了，我回来了。 嗯，我放了米饭来"}, {"type": "subtitle", "time": 14492.07, "timestamp": "04:01:32", "text": "煮饭。"}, {"type": "subtitle", "time": 14495.11, "timestamp": "04:01:35", "text": "我还是继续"}, {"type": "subtitle", "time": 14512.309, "timestamp": "04:01:52", "text": "你知道吗？我每次击球都能得到三个木杆。 但这真的"}, {"type": "subtitle", "time": 14515.11, "timestamp": "04:01:55", "text": "很好。"}, {"type": "subtitle", "time": 14518.389, "timestamp": "04:01:58", "text": "每次击球可获得三块木头。"}]
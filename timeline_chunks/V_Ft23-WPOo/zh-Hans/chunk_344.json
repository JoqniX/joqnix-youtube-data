[{"type": "subtitle", "time": 20646.31, "timestamp": "05:44:06", "text": "想，我为什么会在"}, {"type": "subtitle", "time": 20649.19, "timestamp": "05:44:09", "text": "这里，是因为我"}, {"type": "subtitle", "time": 20652.23, "timestamp": "05:44:12", "text": "想要一个锭农场，对吧？"}, {"type": "subtitle", "time": 20660.23, "timestamp": "05:44:20", "text": "然后我又会想，"}, {"type": "subtitle", "time": 20662.788, "timestamp": "05:44:22", "text": "如果其他人来玩，"}, {"type": "subtitle", "time": 20665.83, "timestamp": "05:44:25", "text": "建造他们的农场什么的，而"}, {"type": "subtitle", "time": 20668.07, "timestamp": "05:44:28", "text": "我已经占据了一个热门"}, {"type": "subtitle", "time": 20672.39, "timestamp": "05:44:32", "text": "位置，那他们会怎么样？他们会怎么样？"}, {"type": "subtitle", "time": 20674.23, "timestamp": "05:44:34", "text": "你必须加入同一个公会才能领取"}, {"type": "subtitle", "time": 20676.868, "timestamp": "05:44:36", "text": "物品和其他东西。"}, {"type": "subtitle", "time": 20697.43, "timestamp": "05:44:57", "text": "嗯，我现在就能做一个大"}]
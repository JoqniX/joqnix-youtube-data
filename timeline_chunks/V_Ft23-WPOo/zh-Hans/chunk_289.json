[{"type": "subtitle", "time": 17341.83, "timestamp": "04:49:01", "text": "基金会在哪里？"}, {"type": "subtitle", "time": 17345.27, "timestamp": "04:49:05", "text": "哦，水生帕利姆碎片。 水上"}, {"type": "subtitle", "time": 17352.948, "timestamp": "04:49:12", "text": "木炭和火焰。 好的。 在此之前，"}, {"type": "subtitle", "time": 17356.868, "timestamp": "04:49:16", "text": "我可以先把磨坊做出来吗？ 这很重要。"}, {"type": "subtitle", "time": 17367.83, "timestamp": "04:49:27", "text": "我想让他们去做一些非常"}, {"type": "subtitle", "time": 17369.51, "timestamp": "04:49:29", "text": "艰苦或极其艰苦的工作"}, {"type": "subtitle", "time": 17376.15, "timestamp": "04:49:36", "text": "不，就像我一样，我"}, {"type": "subtitle", "time": 17379.43, "timestamp": "04:49:39", "text": "首先要提高效率，"}, {"type": "subtitle", "time": 17382.708, "timestamp": "04:49:42", "text": "然后再去做那件事"}, {"type": "subtitle", "time": 17384.47, "timestamp": "04:49:44", "text": "。"}, {"type": "subtitle", "time": 17387.59, "timestamp": "04:49:47", "text": "所以，指甲和细胞是通过"}, {"type": "subtitle", "time": 17396.948, "timestamp": "04:49:56", "text": "有人得了胃溃疡，有人得了抑郁症。"}]
[{"type": "subtitle", "time": 4563.27, "timestamp": "01:16:03", "text": "但他可以搬运、采矿、生火，"}, {"type": "subtitle", "time": 4579.669, "timestamp": "01:16:19", "text": "我只需要有资源来好好喂养"}, {"type": "subtitle", "time": 4581.83, "timestamp": "01:16:21", "text": "这些家伙，"}, {"type": "subtitle", "time": 4585.11, "timestamp": "01:16:25", "text": "这样他们就不会"}, {"type": "subtitle", "time": 4589.03, "timestamp": "01:16:29", "text": "饿死之类的。"}, {"type": "subtitle", "time": 4591.669, "timestamp": "01:16:31", "text": "你知道我现在在拍摄。嗯。"}, {"type": "subtitle", "time": 4594.07, "timestamp": "01:16:34", "text": "再见。再见。"}]
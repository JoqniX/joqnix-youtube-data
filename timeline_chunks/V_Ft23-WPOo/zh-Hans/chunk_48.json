[{"type": "subtitle", "time": 2882.47, "timestamp": "00:48:02", "text": "你好，Rangoku。 现在你能听到我说话了吗？"}, {"type": "subtitle", "time": 2886.309, "timestamp": "00:48:06", "text": "你好。 你好。 你好。 欢迎进来。"}, {"type": "subtitle", "time": 2893.27, "timestamp": "00:48:13", "text": "什么？"}, {"type": "subtitle", "time": 2896.87, "timestamp": "00:48:16", "text": "我不知道。 他们就像在享受"}, {"type": "chat", "time": 2899.619, "timestamp": "00:48:19", "author": "@rengokukyojuro-yl2sv", "avatar": "https://yt4.ggpht.com/8VafSECy9HAmQZVPoSCyzH-vjcJrgjEiphznSh1p0pMY_fI0EAXPBz4hh6ovpjKxrhYA6ag7_Q=s64-c-k-c0x00ffffff-no-rj", "message": "it's me the good old rengoku"}, {"type": "subtitle", "time": 2906.15, "timestamp": "00:48:26", "text": "他们玩得很开心，你知道的。"}, {"type": "subtitle", "time": 2908.309, "timestamp": "00:48:28", "text": "欢迎来到"}, {"type": "subtitle", "time": 2911.99, "timestamp": "00:48:31", "text": "兰格库瓦。 希望你一切都好。"}, {"type": "subtitle", "time": 2914.549, "timestamp": "00:48:34", "text": "是我，老朋友兰戈库。 是的，我"}, {"type": "chat", "time": 2916.337, "timestamp": "00:48:36", "author": "@rengokukyojuro-yl2sv", "avatar": "https://yt4.ggpht.com/8VafSECy9HAmQZVPoSCyzH-vjcJrgjEiphznSh1p0pMY_fI0EAXPBz4hh6ovpjKxrhYA6ag7_Q=s64-c-k-c0x00ffffff-no-rj", "message": "so how have you been"}, {"type": "subtitle", "time": 2918.63, "timestamp": "00:48:38", "text": "记得你。 好久不见了，是吧？"}, {"type": "subtitle", "time": 2931.03, "timestamp": "00:48:51", "text": "你最近怎么样？ 我一直都表现得很好。 我"}, {"type": "subtitle", "time": 2935.67, "timestamp": "00:48:55", "text": "目前在日本学习语言之"}, {"type": "subtitle", "time": 2937.91, "timestamp": "00:48:57", "text": "类的。"}]
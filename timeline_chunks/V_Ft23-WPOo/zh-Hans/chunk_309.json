[{"type": "subtitle", "time": 18554.39, "timestamp": "05:09:14", "text": "我得努力刷钯碎片。"}, {"type": "subtitle", "time": 18556.31, "timestamp": "05:09:16", "text": "你本来可以告诉我，我有很多这样的东西"}, {"type": "subtitle", "time": 18558.15, "timestamp": "05:09:18", "text": "。"}, {"type": "subtitle", "time": 18560.282, "timestamp": "05:09:20", "text": "我刚才还在那儿。"}, {"type": "subtitle", "time": 18561.83, "timestamp": "05:09:21", "text": "[笑声]"}, {"type": "subtitle", "time": 18566.788, "timestamp": "05:09:26", "text": "哦，那你能借我一些吗？"}, {"type": "subtitle", "time": 18569.43, "timestamp": "05:09:29", "text": "好的，我这就去你那儿。"}, {"type": "subtitle", "time": 18571.51, "timestamp": "05:09:31", "text": "是的，你可以，你可以到达一"}, {"type": "subtitle", "time": 18574.55, "timestamp": "05:09:34", "text": "垒。 没关系。 不，我是指二垒。"}, {"type": "subtitle", "time": 18577.67, "timestamp": "05:09:37", "text": "我要去那里。"}, {"type": "subtitle", "time": 18578.628, "timestamp": "05:09:38", "text": "我需要石头。 哦，"}, {"type": "subtitle", "time": 18581.19, "timestamp": "05:09:41", "text": "你现在在哪里？ 我在那里。"}, {"type": "subtitle", "time": 18582.15, "timestamp": "05:09:42", "text": "我的主要基地。"}, {"type": "subtitle", "time": 18588.708, "timestamp": "05:09:48", "text": "哦，对"}, {"type": "subtitle", "time": 18591.83, "timestamp": "05:09:51", "text": "，就在你基地附近。"}]
[{"type": "subtitle", "time": 12076.87, "timestamp": "03:21:16", "text": "园的工作了"}, {"type": "subtitle", "time": 12082.79, "timestamp": "03:21:22", "text": "。"}, {"type": "subtitle", "time": 12085.83, "timestamp": "03:21:25", "text": "嗯，我们来看看能做什么菜。 我的天哪"}, {"type": "subtitle", "time": 12088.63, "timestamp": "03:21:28", "text": "，事情太多了。 蛋糕、"}, {"type": "subtitle", "time": 12092.229, "timestamp": "03:21:32", "text": "牛奶、鸡蛋、蜂蜜。"}, {"type": "subtitle", "time": 12094.79, "timestamp": "03:21:34", "text": "蔬菜蛋糕在哪儿？ 肉。"}, {"type": "subtitle", "time": 12098.95, "timestamp": "03:21:38", "text": "酥脆的肉。 猛犸象"}, {"type": "subtitle", "time": 12102.309, "timestamp": "03:21:42", "text": "奶。 那么，如何才能弄到牛奶呢？ 蛋。 浅色"}, {"type": "subtitle", "time": 12113.91, "timestamp": "03:21:53", "text": "哦，是的。 接下来我们要找的"}, {"type": "subtitle", "time": 12117.59, "timestamp": "03:21:57", "text": "是木板。"}]
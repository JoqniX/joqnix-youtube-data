[{"type": "subtitle", "time": 7291.91, "timestamp": "02:01:31", "text": "好的，现在我们去寻找卡顿的地方"}, {"type": "subtitle", "time": 7294.95, "timestamp": "02:01:34", "text": "。"}, {"type": "subtitle", "time": 7297.109, "timestamp": "02:01:37", "text": "等等，"}, {"type": "subtitle", "time": 7301.189, "timestamp": "02:01:41", "text": "你那边卡顿了。"}, {"type": "subtitle", "time": 7305.75, "timestamp": "02:01:45", "text": "等等，他怎么会卡顿？你"}, {"type": "subtitle", "time": 7308.79, "timestamp": "02:01:48", "text": "看，我是说，我在日本，所以"}, {"type": "subtitle", "time": 7314.07, "timestamp": "02:01:54", "text": "对我来说应该是很流畅的，但他怎么会卡顿"}]
[{"type": "subtitle", "time": 17291.19, "timestamp": "04:48:11", "text": "我居然提前订了这家店的餐"}, {"type": "subtitle", "time": 17293.11, "timestamp": "04:48:13", "text": "，"}, {"type": "subtitle", "time": 17295.67, "timestamp": "04:48:15", "text": "这感觉有点诡异。"}, {"type": "subtitle", "time": 17297.51, "timestamp": "04:48:17", "text": "哦，是的。 你现在已经有两个基地了"}, {"type": "subtitle", "time": 17299.27, "timestamp": "04:48:19", "text": "。   是的"}, {"type": "subtitle", "time": 17310.708, "timestamp": "04:48:30", "text": "我想完全掌控自己的命运。 我需要两名"}, {"type": "subtitle", "time": 17313.11, "timestamp": "04:48:33", "text": "无论如何都要去挖矿的工人"}, {"type": "subtitle", "time": 17315.91, "timestamp": "04:48:35", "text": "。 如果他们的理智值为零，我该如何让他们恢复理智"}, {"type": "subtitle", "time": 17320.47, "timestamp": "04:48:40", "text": "？ 你有什么想法吗？"}, {"type": "subtitle", "time": 17325.67, "timestamp": "04:48:45", "text": "呃，你做了那个呃 onen 吗？"}, {"type": "subtitle", "time": 17339.91, "timestamp": "04:48:59", "text": "御苑"}]
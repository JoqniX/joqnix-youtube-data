[{"type": "subtitle", "time": 6421.109, "timestamp": "01:47:01", "text": "掉下来了，对吧？"}, {"type": "subtitle", "time": 6426.39, "timestamp": "01:47:06", "text": "兄弟，你怎么在天上？"}, {"type": "subtitle", "time": 6434.55, "timestamp": "01:47:14", "text": "哦，他下来了。兄弟，你怎么能"}, {"type": "subtitle", "time": 6473.43, "timestamp": "01:47:53", "text": "这个箱子只装石头。"}, {"type": "subtitle", "time": 6475.59, "timestamp": "01:47:55", "text": "这样这些石头就可以运到"}]
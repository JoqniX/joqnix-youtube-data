[{"type": "subtitle", "time": 5280.87, "timestamp": "01:28:00", "text": "所以，我的想法是……哦，等等。我不需要"}, {"type": "subtitle", "time": 5288.07, "timestamp": "01:28:08", "text": "嗯？"}, {"type": "subtitle", "time": 5292.39, "timestamp": "01:28:12", "text": "嗯，我的想法是，我们要让"}, {"type": "subtitle", "time": 5295.43, "timestamp": "01:28:15", "text": "这些农场，这些食物农场可以堆叠。"}, {"type": "subtitle", "time": 5299.35, "timestamp": "01:28:19", "text": "所以我想我需要这个长凳，"}, {"type": "subtitle", "time": 5303.91, "timestamp": "01:28:23", "text": "对吧？客厅家具套装。是的。"}, {"type": "subtitle", "time": 5305.75, "timestamp": "01:28:25", "text": "所以我们不需要像这样的浪费空间"}, {"type": "subtitle", "time": 5307.669, "timestamp": "01:28:27", "text": "，对吧？我们会"}, {"type": "subtitle", "time": 5309.51, "timestamp": "01:28:29", "text": "垂直堆叠。是的。"}, {"type": "subtitle", "time": 5313.27, "timestamp": "01:28:33", "text": "垂直堆叠，不是水平堆叠。嗯。"}, {"type": "subtitle", "time": 5317.28, "timestamp": "01:28:37", "text": "嗯。 有人……"}, {"type": "subtitle", "time": 5322.79, "timestamp": "01:28:42", "text": "你是谁？"}, {"type": "subtitle", "time": 5325.27, "timestamp": "01:28:45", "text": "谈判员。"}, {"type": "subtitle", "time": 5337.75, "timestamp": "01:28:57", "text": "想打架吗，兄弟？"}]
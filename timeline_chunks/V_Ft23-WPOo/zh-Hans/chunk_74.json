[{"type": "subtitle", "time": 4444.87, "timestamp": "01:14:04", "text": "好吧，那个就在那里。还有一些篝火，"}, {"type": "subtitle", "time": 4451.189, "timestamp": "01:14:11", "text": "实际上，我可以放个烹饪箱。"}, {"type": "subtitle", "time": 4453.51, "timestamp": "01:14:13", "text": "但是这个火焰，或者说，我怎么才能得到"}, {"type": "subtitle", "time": 4455.75, "timestamp": "01:14:15", "text": "它？"}, {"type": "subtitle", "time": 4459.51, "timestamp": "01:14:19", "text": "怎么才能得到火焰或者"}]
[{"type": "subtitle", "time": 3600.23, "timestamp": "01:00:00", "text": "所以如果你们能"}, {"type": "subtitle", "time": 3607.03, "timestamp": "01:00:07", "text": "来陪我，我会非常高兴的，因为我 这样我就不会感到"}, {"type": "subtitle", "time": 3619.91, "timestamp": "01:00:19", "text": "好的。"}, {"type": "subtitle", "time": 3649.99, "timestamp": "01:00:49", "text": "嘿，又一座瞭望塔解锁了。"}, {"type": "subtitle", "time": 3652.069, "timestamp": "01:00:52", "text": "该死，看。"}, {"type": "subtitle", "time": 3654.71, "timestamp": "01:00:54", "text": "还有更多地方。你能想象"}, {"type": "subtitle", "time": 3657.589, "timestamp": "01:00:57", "text": "这个世界有多大吗？太"}]
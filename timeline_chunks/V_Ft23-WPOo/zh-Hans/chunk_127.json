[{"type": "subtitle", "time": 7622.39, "timestamp": "02:07:02", "text": "我刚才扔了吗？这些是什么？"}, {"type": "subtitle", "time": 7629.51, "timestamp": "02:07:09", "text": "我"}, {"type": "subtitle", "time": 7633.91, "timestamp": "02:07:13", "text": "得做点事。好吧。嗯，"}, {"type": "subtitle", "time": 7636.069, "timestamp": "02:07:16", "text": "我们有"}, {"type": "subtitle", "time": 7640.79, "timestamp": "02:07:20", "text": "伙伴了，对吧？那我"}, {"type": "subtitle", "time": 7644.069, "timestamp": "02:07:24", "text": "调整一下。我们用"}, {"type": "subtitle", "time": 7648.069, "timestamp": "02:07:28", "text": "攻击小队。一、"}, {"type": "subtitle", "time": 7649.83, "timestamp": "02:07:29", "text": "二、"}, {"type": "subtitle", "time": 7651.75, "timestamp": "02:07:31", "text": "三。"}, {"type": "subtitle", "time": 7654.95, "timestamp": "02:07:34", "text": "我本来想用第四个，但我"}, {"type": "subtitle", "time": 7656.87, "timestamp": "02:07:36", "text": "不小心把他们都杀了。这些"}, {"type": "subtitle", "time": 7660.149, "timestamp": "02:07:40", "text": "能给我更多攻击手段，"}, {"type": "subtitle", "time": 7664.79, "timestamp": "02:07:44", "text": "比如自动炮塔，对吧？我有一头鹿"}, {"type": "subtitle", "time": 7670.069, "timestamp": "02:07:50", "text": "等着。我想我可以……我想"}, {"type": "subtitle", "time": 7672.31, "timestamp": "02:07:52", "text": "我可以带"}, {"type": "subtitle", "time": 7677.109, "timestamp": "02:07:57", "text": "飞行伙伴去飞。"}]
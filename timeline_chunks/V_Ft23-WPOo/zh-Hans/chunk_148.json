[{"type": "subtitle", "time": 8881.03, "timestamp": "02:28:01", "text": "再次点燃火焰。 谢谢。"}, {"type": "subtitle", "time": 8892.15, "timestamp": "02:28:12", "text": "这。 我不知道。 我不知道为什么会这样"}, {"type": "subtitle", "time": 8909.67, "timestamp": "02:28:29", "text": "哦，它们会重生。"}, {"type": "subtitle", "time": 8912.79, "timestamp": "02:28:32", "text": "对于这些家伙来说，还有更多值得关注的地方，比如小企鹅们"}, {"type": "subtitle", "time": 8922.63, "timestamp": "02:28:42", "text": "我杀了他们。 不小心把它弄死了。"}, {"type": "subtitle", "time": 8925.19, "timestamp": "02:28:45", "text": "嗖。   砰"}]
[{"type": "subtitle", "time": 7440.55, "timestamp": "02:04:00", "text": "那家伙死了。矿石呢？"}, {"type": "subtitle", "time": 7443.83, "timestamp": "02:04:03", "text": "我也可以用这种方法刷矿石。太疯狂了，"}, {"type": "subtitle", "time": 7478.79, "timestamp": "02:04:38", "text": "。太多了。好的，我们"}, {"type": "subtitle", "time": 7482.229, "timestamp": "02:04:42", "text": "回基地把石头放"}, {"type": "subtitle", "time": 7490.07, "timestamp": "02:04:50", "text": "还有，我需要换个身体。"}, {"type": "subtitle", "time": 7496.629, "timestamp": "02:04:56", "text": "我想你可以在基地里挖矿。"}]
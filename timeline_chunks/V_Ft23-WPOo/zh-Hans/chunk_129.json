[{"type": "subtitle", "time": 7741.75, "timestamp": "02:09:01", "text": "大家好吗？生活怎么样？"}, {"type": "subtitle", "time": 7744.39, "timestamp": "02:09:04", "text": "你们还活着吗？"}, {"type": "subtitle", "time": 7748.47, "timestamp": "02:09:08", "text": "为什么没有食物？你好"}, {"type": "subtitle", "time": 7750.069, "timestamp": "02:09:10", "text": "。"}, {"type": "subtitle", "time": 7753.91, "timestamp": "02:09:13", "text": "你在浇水，在收割。好的。"}, {"type": "subtitle", "time": 7768.229, "timestamp": "02:09:28", "text": "为什么你们只收集硫磺？"}, {"type": "subtitle", "time": 7771.669, "timestamp": "02:09:31", "text": "它为什么要收集硫磺？绿洲在哪里？"}, {"type": "subtitle", "time": 7774.069, "timestamp": "02:09:34", "text": "你好，"}, {"type": "subtitle", "time": 7777.43, "timestamp": "02:09:37", "text": "伙计。妈，它为什么要收集硫磺？"}, {"type": "subtitle", "time": 7779.35, "timestamp": "02:09:39", "text": "绿洲在哪里？那为什么这里"}, {"type": "subtitle", "time": 7781.669, "timestamp": "02:09:41", "text": "没人动过？"}, {"type": "subtitle", "time": 7784.95, "timestamp": "02:09:44", "text": "打扰一下。什么？我想我"}]
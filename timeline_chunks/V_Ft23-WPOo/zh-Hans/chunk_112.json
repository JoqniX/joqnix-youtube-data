[{"type": "subtitle", "time": 6733.27, "timestamp": "01:52:13", "text": "简易储存。背包里的物品"}, {"type": "subtitle", "time": 6735.43, "timestamp": "01:52:15", "text": "将存储在基地内附近的箱子中"}, {"type": "subtitle", "time": 6737.91, "timestamp": "01:52:17", "text": "。只有按顺序排列的物品才会被"}, {"type": "subtitle", "time": 6740.47, "timestamp": "01:52:20", "text": "存储。例如，不按顺序排列的物品不会被存储"}, {"type": "subtitle", "time": 6743.35, "timestamp": "01:52:23", "text": "。"}, {"type": "subtitle", "time": 6760.149, "timestamp": "01:52:40", "text": "我需要这个。"}, {"type": "subtitle", "time": 6766.149, "timestamp": "01:52:46", "text": "是必需的。步枪。一把步枪。"}, {"type": "subtitle", "time": 6768.87, "timestamp": "01:52:48", "text": "这个，这个，"}, {"type": "subtitle", "time": 6771.589, "timestamp": "01:52:51", "text": "原油。该死。弄到了很多"}, {"type": "subtitle", "time": 6773.75, "timestamp": "01:52:53", "text": "硬木。还"}]
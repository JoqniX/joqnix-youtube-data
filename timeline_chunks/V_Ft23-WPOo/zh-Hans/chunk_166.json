[{"type": "subtitle", "time": 9968.95, "timestamp": "02:46:08", "text": "我的一部分在诉说着黝黑的脖颈。 为什么"}, {"type": "subtitle", "time": 9982.55, "timestamp": "02:46:22", "text": "我感觉我还想再做一次。"}, {"type": "subtitle", "time": 9985.99, "timestamp": "02:46:25", "text": "我决定放手一搏。"}, {"type": "subtitle", "time": 10011.91, "timestamp": "02:46:51", "text": "你知道你现在还不应该"}, {"type": "subtitle", "time": 10016.23, "timestamp": "02:46:56", "text": "得到你。 给你。"}]
[{"type": "subtitle", "time": 25082.15, "timestamp": "06:58:02", "text": "？ 你在车里。"}, {"type": "subtitle", "time": 25087.83, "timestamp": "06:58:07", "text": "呃，没什么。 不，这是麻烦。"}, {"type": "subtitle", "time": 25089.59, "timestamp": "06:58:09", "text": "好的，我有背景资料。 这就是我"}, {"type": "subtitle", "time": 25092.948, "timestamp": "06:58:12", "text": "保持沉默的原因。 不过，还是要谢谢大家的"}, {"type": "subtitle", "time": 25095.19, "timestamp": "06:58:15", "text": "光临。 我的意思是，"}, {"type": "subtitle", "time": 25098.948, "timestamp": "06:58:18", "text": "和你一起玩真的很有趣。 虽然，我们确实在"}, {"type": "subtitle", "time": 25100.15, "timestamp": "06:58:20", "text": "做我们自己的事情。"}, {"type": "subtitle", "time": 25103.67, "timestamp": "06:58:23", "text": "再见，女孩们。 还不错。我"}, {"type": "subtitle", "time": 25104.788, "timestamp": "06:58:24", "text": "想就这些了。"}, {"type": "subtitle", "time": 25111.03, "timestamp": "06:58:31", "text": "再见。 感谢大家"}, {"type": "subtitle", "time": 25115.35, "timestamp": "06:58:35", "text": "连续七个小时观看我的节目。"}]
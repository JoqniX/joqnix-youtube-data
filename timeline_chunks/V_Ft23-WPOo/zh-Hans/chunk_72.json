[{"type": "subtitle", "time": 4326.229, "timestamp": "01:12:06", "text": "他……他 没兴趣，但"}, {"type": "subtitle", "time": 4340.709, "timestamp": "01:12:20", "text": "首先得工作。我想我需要种些"}, {"type": "subtitle", "time": 4343.03, "timestamp": "01:12:23", "text": "东西，"}, {"type": "subtitle", "time": 4346.07, "timestamp": "01:12:26", "text": "但我去哪儿弄番茄种子和"}, {"type": "subtitle", "time": 4348.55, "timestamp": "01:12:28", "text": "小麦？我有小麦种子，还有"}, {"type": "subtitle", "time": 4361.83, "timestamp": "01:12:41", "text": "。等等。"}, {"type": "subtitle", "time": 4365.11, "timestamp": "01:12:45", "text": "我需要铁。我有……我需要火，"}, {"type": "subtitle", "time": 4370.149, "timestamp": "01:12:50", "text": "干嘛？等等，我想我们需要建个"}, {"type": "subtitle", "time": 4372.31, "timestamp": "01:12:52", "text": "精炼"}, {"type": "subtitle", "time": 4375.43, "timestamp": "01:12:55", "text": "装置。所以，我需要石头。我又需要火焰"}, {"type": "subtitle", "time": 4377.75, "timestamp": "01:12:57", "text": "矿石了。"}]
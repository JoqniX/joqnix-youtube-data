[{"type": "subtitle", "time": 16325.429, "timestamp": "04:32:05", "text": "我旁边好像有一头愚蠢的猛犸象之类的东西。"}, {"type": "subtitle", "time": 16328.149, "timestamp": "04:32:08", "text": "搞什么鬼？"}, {"type": "subtitle", "time": 16330.149, "timestamp": "04:32:10", "text": "它为什么会在这里？ 这些人为什么会在"}, {"type": "subtitle", "time": 16366.469, "timestamp": "04:32:46", "text": "好了，他们走了。   还有"}, {"type": "subtitle", "time": 16368.71, "timestamp": "04:32:48", "text": "谁？"}, {"type": "subtitle", "time": 16370.389, "timestamp": "04:32:50", "text": "这里没人。 好的。 好的。 好的。 好的。"}, {"type": "subtitle", "time": 16375.83, "timestamp": "04:32:55", "text": "我这就赶紧收拾东西开始"}]
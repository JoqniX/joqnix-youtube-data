[{"type": "subtitle", "time": 3571.99, "timestamp": "00:59:31", "text": "好吧，我可以做这个"}, {"type": "subtitle", "time": 3574.309, "timestamp": "00:59:34", "text": "生日。还有，你们知道"}, {"type": "subtitle", "time": 3577.91, "timestamp": "00:59:37", "text": "我周二过生日吗？我"}, {"type": "subtitle", "time": 3581.19, "timestamp": "00:59:41", "text": "现在得安排一下直播时间了。我"}, {"type": "subtitle", "time": 3583.03, "timestamp": "00:59:43", "text": "得做一些公告之"}, {"type": "subtitle", "time": 3586.789, "timestamp": "00:59:46", "text": "类的，因为我的生日快到了。"}, {"type": "subtitle", "time": 3588.789, "timestamp": "00:59:48", "text": "这将是我第一次"}, {"type": "subtitle", "time": 3591.51, "timestamp": "00:59:51", "text": "在日本庆祝生日，而"}, {"type": "subtitle", "time": 3596.39, "timestamp": "00:59:56", "text": "不是在我的祖国印度，"}]
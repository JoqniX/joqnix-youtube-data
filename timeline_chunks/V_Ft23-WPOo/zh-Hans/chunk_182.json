[{"type": "subtitle", "time": 10926.23, "timestamp": "03:02:06", "text": "快点。"}, {"type": "subtitle", "time": 10932.72, "timestamp": "03:02:12", "text": "。 我的天哪，我太聪明了。"}, {"type": "subtitle", "time": 10936.479, "timestamp": "03:02:16", "text": "我的天哪，我太聪明了。 瞧瞧。"}, {"type": "subtitle", "time": 10962.63, "timestamp": "03:02:42", "text": "，就是这个。 我们把它整齐地放在"}, {"type": "subtitle", "time": 10975.67, "timestamp": "03:02:55", "text": "所以，1 2 3 4 5 6 7。 我们得到了七个。"}, {"type": "subtitle", "time": 10977.269, "timestamp": "03:02:57", "text": "圣"}]
[{"type": "subtitle", "time": 6008.39, "timestamp": "01:40:08", "text": "原始熔炉？"}, {"type": "subtitle", "time": 6011.189, "timestamp": "01:40:11", "text": "等等，没有破碎机。"}, {"type": "subtitle", "time": 6015.189, "timestamp": "01:40:15", "text": "我想你不需要。"}, {"type": "subtitle", "time": 6017.99, "timestamp": "01:40:17", "text": "是的，这就是我要找的。我"}, {"type": "subtitle", "time": 6021.109, "timestamp": "01:40:21", "text": "会让他做些杂活。"}, {"type": "subtitle", "time": 6024.07, "timestamp": "01:40:24", "text": "不伐木。"}, {"type": "subtitle", "time": 6027.43, "timestamp": "01:40:27", "text": "药品。好的。"}, {"type": "subtitle", "time": 6030.07, "timestamp": "01:40:30", "text": "那个东西？不要。"}, {"type": "subtitle", "time": 6054.31, "timestamp": "01:40:54", "text": "把你女朋友交给我。"}]
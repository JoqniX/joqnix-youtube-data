[{"type": "subtitle", "time": 7748.47, "timestamp": "02:09:08", "text": "為什麼？你去哪兒？  B. 好吧，"}, {"type": "subtitle", "time": 7753.91, "timestamp": "02:09:13", "text": "我拿了一半的食物。好吧，我拿了一半的食物。  反复"}, {"type": "subtitle", "time": 7777.43, "timestamp": "02:09:37", "text": "獲取這些夥伴的副本，"}, {"type": "subtitle", "time": 7779.35, "timestamp": "02:09:39", "text": "這樣他們就可以耕種、澆水，做所有這些"}, {"type": "subtitle", "time": 7781.669, "timestamp": "02:09:41", "text": "該死的事情了。"}]
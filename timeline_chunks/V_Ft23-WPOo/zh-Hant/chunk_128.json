[{"type": "subtitle", "time": 7712.47, "timestamp": "02:08:32", "text": "嗯。  接下來我需要什麼？"}, {"type": "subtitle", "time": 7716.87, "timestamp": "02:08:36", "text": "我需要更多箭，對吧？我再去"}, {"type": "subtitle", "time": 7720.39, "timestamp": "02:08:40", "text": "弄些箭。  182分不錯。  是的，但是速度有點慢"}, {"type": "subtitle", "time": 7723.669, "timestamp": "02:08:43", "text": "。  把它帶到"}, {"type": "subtitle", "time": 7729.669, "timestamp": "02:08:49", "text": "第四處廢墟。等我拿到夜間擂台冠軍頭銜之後，我就去做"}, {"type": "subtitle", "time": 7734.629, "timestamp": "02:08:54", "text": "。我"}, {"type": "subtitle", "time": 7739.109, "timestamp": "02:08:59", "text": "現在感覺自己像會飛一樣。  那樣會更好。  哦，回來吧。"}]
[{"type": "subtitle", "time": 17291.19, "timestamp": "04:48:11", "text": "這輛車重疊了。  我的天哪，你知道我的情況，我的臉總是被人拍得"}, {"type": "subtitle", "time": 17295.67, "timestamp": "04:48:15", "text": "亂七八糟。  嘿，一、二、三。"}, {"type": "subtitle", "time": 17297.51, "timestamp": "04:48:17", "text": "哦，等等。我"}, {"type": "subtitle", "time": 17310.708, "timestamp": "04:48:30", "text": "全程都被靜音了。  我的天哪。哇。  好的，下一波。  嘿"}]
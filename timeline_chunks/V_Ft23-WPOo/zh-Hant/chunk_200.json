[{"type": "subtitle", "time": 12001.67, "timestamp": "03:20:01", "text": "不太好。我也是這麼想的。  所以，"}, {"type": "subtitle", "time": 12019.349, "timestamp": "03:20:19", "text": "我真心覺得"}, {"type": "subtitle", "time": 12022.469, "timestamp": "03:20:22", "text": "我不應該那樣做。就像一個基地必須專注於一項任務一樣。"}, {"type": "subtitle", "time": 12048.389, "timestamp": "03:20:48", "text": "另一個基地必須專注於這項任務。  好的。  好的。一旦烹飪用品到位，"}]
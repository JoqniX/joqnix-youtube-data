[{"type": "subtitle", "time": 18556.31, "timestamp": "05:09:16", "text": "你想再看一遍嗎？"}, {"type": "subtitle", "time": 18566.788, "timestamp": "05:09:26", "text": "給我打電話，我得吃飯了。  我打擾到您了嗎？"}, {"type": "subtitle", "time": 18571.51, "timestamp": "05:09:31", "text": "不，我當時在做什麼？  我也願意做"}, {"type": "subtitle", "time": 18574.55, "timestamp": "05:09:34", "text": "基地。  我也願意做基地。但問題在於這些敵人。我有一些煩人的敵人。  是的。"}, {"type": "subtitle", "time": 18588.708, "timestamp": "05:09:48", "text": "哦，是的"}]
[{"type": "subtitle", "time": 22989.15, "timestamp": "06:23:09", "text": "天哪，我打得好用力。  好的。  啊"}, {"type": "subtitle", "time": 22993.11, "timestamp": "06:23:13", "text": "，我真搞不懂他。  哇。  什麼？我差點就成功了。  哇。他把我幹掉了。  真不敢相信他竟然這樣暗中攻擊我。"}, {"type": "subtitle", "time": 23003.75, "timestamp": "06:23:23", "text": "什麼？"}, {"type": "subtitle", "time": 23005.39, "timestamp": "06:23:25", "text": "好球。  我正在嘗試使用"}, {"type": "subtitle", "time": 23008.788, "timestamp": "06:23:28", "text": "沙漠之鷹，但我狀態不好"}, {"type": "subtitle", "time": 23025.548, "timestamp": "06:23:45", "text": "哦，我居然用沙漠之鷹殺死了一個人。爆頭。我的天哪。又一張爆頭照。"}]
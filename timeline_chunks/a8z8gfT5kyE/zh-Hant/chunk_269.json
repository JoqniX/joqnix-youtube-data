[{"type": "subtitle", "time": 16148.51, "timestamp": "04:29:08", "text": "哦，沒事了"}, {"type": "subtitle", "time": 16150.189, "timestamp": "04:29:10", "text": "。我們"}, {"type": "subtitle", "time": 16159.83, "timestamp": "04:29:19", "text": "玩得越多，進步就越大。  好了，我們開始吧。  這是什麼"}, {"type": "subtitle", "time": 16185.83, "timestamp": "04:29:45", "text": "，不，我們玩的是國服版。它叫 Cali Bio。英文（呃，西方）名稱是 String Nova。標題裡已經寫了。無法透過標題查找。"}]
[{"type": "subtitle", "time": 25987.948, "timestamp": "07:13:07", "text": "[音樂] 但你知道，在這個遊戲中"}, {"type": "subtitle", "time": 25992.628, "timestamp": "07:13:12", "text": "補充水分是很困難的。好了，就是這樣。我的"}, {"type": "subtitle", "time": 25994.03, "timestamp": "07:13:14", "text": "身分證號碼。好了。哦，我用了我的"}, {"type": "subtitle", "time": 26007.51, "timestamp": "07:13:27", "text": "我忘了。哦，是的。我的蝦片已登入水卡。啊。  真是個好人。另外，我聽到的也是我自己的直播聲"}, {"type": "subtitle", "time": 26012.67, "timestamp": "07:13:32", "text": "。音頻是不是"}, {"type": "subtitle", "time": 26027.11, "timestamp": "07:13:47", "text": "不平衡？我需要"}, {"type": "subtitle", "time": 26034.948, "timestamp": "07:13:54", "text": "調低遊戲音樂音量嗎？等等，那是大師。這是音效。"}]
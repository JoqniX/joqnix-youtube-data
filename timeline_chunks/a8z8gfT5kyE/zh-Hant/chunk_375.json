[{"type": "subtitle", "time": 22503.19, "timestamp": "06:15:03", "text": "沒把他逼瘋嗎？哦。  哦，紙質手包。我的天，這球打得真好。不錯吧？她可以復活。"}, {"type": "subtitle", "time": 22512.11, "timestamp": "06:15:12", "text": "什麼？"}, {"type": "subtitle", "time": 22535.39, "timestamp": "06:15:35", "text": "我的「為什麼，兄弟？」好的，"}, {"type": "subtitle", "time": 22537.99, "timestamp": "06:15:37", "text": "我要走了"}, {"type": "subtitle", "time": 22540.628, "timestamp": "06:15:40", "text": "。  為什麼拿走了我的[音樂]設備？有人拿走了我的安慰。"}]
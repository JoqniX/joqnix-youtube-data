[{"type": "subtitle", "time": 16459.029, "timestamp": "04:34:19", "text": "是的。我們做到了。啊。"}, {"type": "subtitle", "time": 16461.869, "timestamp": "04:34:21", "text": "哦，天哪。  我的天哪，她真難殺。"}, {"type": "subtitle", "time": 16474.869, "timestamp": "04:34:34", "text": "啊，我忘了用沙鷹很奇怪，很麻煩。好了"}, {"type": "subtitle", "time": 16489.83, "timestamp": "04:34:49", "text": "，我們走吧。那真是一次不錯的練習。"}, {"type": "subtitle", "time": 16493.269, "timestamp": "04:34:53", "text": "嗯？我拿到了11個人頭。"}]
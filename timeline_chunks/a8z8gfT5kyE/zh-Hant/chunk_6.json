[{"type": "subtitle", "time": 360.749, "timestamp": "00:06:00", "text": "。天哪，天哪，天哪，天哪"}, {"type": "subtitle", "time": 370.83, "timestamp": "00:06:10", "text": "。  我還剩下負5分鐘"}, {"type": "subtitle", "time": 374.23, "timestamp": "00:06:14", "text": "。嗯嗯。我的天哪，她居然轉發了我朋友們的貼文"}, {"type": "subtitle", "time": 375.95, "timestamp": "00:06:15", "text": "。如何簽署這則推文？  我剛剛刪除了"}, {"type": "subtitle", "time": 390.55, "timestamp": "00:06:30", "text": "昨天發的那則推文。"}, {"type": "subtitle", "time": 404.71, "timestamp": "00:06:44", "text": "你看，我們都知道我剛剛取消了一則推文。我還提到露娜也在這裡。 Ra san Shivasan Ray Raan。我在那裡。我在那裡。我的天啊。她把我的照片放在那裡了。  謝謝。她精心"}]
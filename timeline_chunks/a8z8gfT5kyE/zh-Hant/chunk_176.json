[{"type": "subtitle", "time": 10564.389, "timestamp": "02:56:04", "text": "我明白了。哦，在那裡。嗨。嗨。嗨。呃呃。呃，我的天哪。等等。呃，我"}, {"type": "subtitle", "time": 10571.59, "timestamp": "02:56:11", "text": "還能讓你更"}, {"type": "subtitle", "time": 10577.67, "timestamp": "02:56:17", "text": "輕鬆一點嗎？為什麼不能裝瓶？太"}, {"type": "subtitle", "time": 10588.55, "timestamp": "02:56:28", "text": "酷了。嗨。嗨。嗨。所以，呃呃呃，就像把它帶上來。嗯？"}]
[{"type": "subtitle", "time": 19624.68, "timestamp": "05:27:04", "text": "你都玩哪些遊戲？明星男孩們，是"}, {"type": "subtitle", "time": 19640.31, "timestamp": "05:27:20", "text": "嗎？"}, {"type": "subtitle", "time": 19642.788, "timestamp": "05:27:22", "text": "你玩的是哪個老地方的……呃……"}, {"type": "subtitle", "time": 19655.31, "timestamp": "05:27:35", "text": "遊戲？  我是在一個沒有流行音樂的節目中提問的。  是的，我也遇到了這個問題，例如如果我用旋轉的環形選單打開，它不會"}, {"type": "subtitle", "time": 19658.51, "timestamp": "05:27:38", "text": "彈出"}]
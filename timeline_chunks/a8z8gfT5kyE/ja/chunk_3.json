[{"type": "subtitle", "time": 182.75, "timestamp": "00:03:02", "text": "そのうち74人くらいに連絡を取った"}, {"type": "subtitle", "time": 187.11, "timestamp": "00:03:07", "text": "えっと、30人くらいが準備できてるよ、誰？"}, {"type": "subtitle", "time": 189.03, "timestamp": "00:03:09", "text": "無料で参加でき、"}, {"type": "subtitle", "time": 190.869, "timestamp": "00:03:10", "text": "中に入って色々やってみて。だから、私は見つけなければならない"}, {"type": "subtitle", "time": 193.75, "timestamp": "00:03:13", "text": "全部手に入れる時間だ"}, {"type": "subtitle", "time": 197.19, "timestamp": "00:03:17", "text": "全部オンになってて、いろいろ。もし私ができないなら"}, {"type": "subtitle", "time": 199.50900000000001, "timestamp": "00:03:19", "text": "彼らと個別にコラボレーションを行い、"}, {"type": "subtitle", "time": 201.91, "timestamp": "00:03:21", "text": "それらをグループに追加します。"}, {"type": "subtitle", "time": 204.03, "timestamp": "00:03:24", "text": "グループ1が次に起こります"}, {"type": "subtitle", "time": 208.63, "timestamp": "00:03:28", "text": "週。ええ、そういうことです。でも私は"}, {"type": "subtitle", "time": 210.869, "timestamp": "00:03:30", "text": "すべてが終わって、落ち着いたら"}, {"type": "subtitle", "time": 214.47, "timestamp": "00:03:34", "text": "そして8月頃までには、"}, {"type": "subtitle", "time": 216.67000000000002, "timestamp": "00:03:36", "text": "ストリーミング配信を開始します"}, {"type": "subtitle", "time": 220.55, "timestamp": "00:03:40", "text": "また。その頃には暴力的な遊びもできる"}, {"type": "subtitle", "time": 222.71, "timestamp": "00:03:42", "text": "それに、1時間とか遅いとか"}, {"type": "subtitle", "time": 227.27, "timestamp": "00:03:47", "text": "または1日2時間の配信（最大1時間）"}, {"type": "subtitle", "time": 228.82999999999998, "timestamp": "00:03:48", "text": "最小I"}, {"type": "subtitle", "time": 231.11, "timestamp": "00:03:51", "text": "ストリーミング配信はできないと思う"}, {"type": "subtitle", "time": 234.11, "timestamp": "00:03:54", "text": "今まさにやっているように、仕事に行かなければならない"}, {"type": "subtitle", "time": 236.869, "timestamp": "00:03:56", "text": "パートタイムで、授業もすべて好きです。"}]
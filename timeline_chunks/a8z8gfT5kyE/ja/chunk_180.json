[{"type": "subtitle", "time": 10800.309, "timestamp": "03:00:00", "text": "今日は午後のコラボも"}, {"type": "subtitle", "time": 10801.469, "timestamp": "03:00:01", "text": "停電"}, {"type": "subtitle", "time": 10814.99, "timestamp": "03:00:14", "text": "そこで私は予想していなかった"}, {"type": "subtitle", "time": 10819.389, "timestamp": "03:00:19", "text": "起こるように"}, {"type": "subtitle", "time": 10845.349, "timestamp": "03:00:45", "text": "ショット。わかった。わかった。えっと、私に"}, {"type": "subtitle", "time": 10847.469, "timestamp": "03:00:47", "text": "何をすべきか決める。何をするか？何を"}, {"type": "subtitle", "time": 10853.94, "timestamp": "03:00:53", "text": "する？わかった。すべてのDMを参照させてください。えっと"}, {"type": "subtitle", "time": 10855.87, "timestamp": "03:00:55", "text": "[音楽]"}, {"type": "subtitle", "time": 10859.51, "timestamp": "03:00:59", "text": "えっと、待って、ジャスミンの息子が行くのを見て、私は"}]
[{"type": "subtitle", "time": 21885.51, "timestamp": "06:04:45", "text": "44. とてもきつい。すごく汗だくだ。その"}, {"type": "subtitle", "time": 21886.75, "timestamp": "06:04:46", "text": "それで"}, {"type": "subtitle", "time": 21895.03, "timestamp": "06:04:55", "text": "つまり、少なくともある意味ではこれは良いことだ"}, {"type": "subtitle", "time": 21898.548, "timestamp": "06:04:58", "text": "なぜなら、私がヴァレリンをプレイしていたら"}]
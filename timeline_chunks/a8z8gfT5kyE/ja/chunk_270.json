[{"type": "subtitle", "time": 16220.67, "timestamp": "04:30:20", "text": "今日はどれくらい遊ぶ予定ですか？"}, {"type": "subtitle", "time": 16225.349, "timestamp": "04:30:25", "text": "ええと、分かりません。おそらく、私たちが"}, {"type": "subtitle", "time": 16229.189, "timestamp": "04:30:29", "text": "始まったばかりです。いや、私はプレイするよ"}, {"type": "subtitle", "time": 16232.07, "timestamp": "04:30:32", "text": "最大6人までしかストリーミングできません"}, {"type": "subtitle", "time": 16233.95, "timestamp": "04:30:33", "text": "営業時間"}, {"type": "subtitle", "time": 16237.83, "timestamp": "04:30:37", "text": "ええ、1つの配信は6時間までしかできません"}, {"type": "subtitle", "time": 16241.269, "timestamp": "04:30:41", "text": "残念ながら数時間、そしてもし私が2つやったら"}, {"type": "subtitle", "time": 16244.309, "timestamp": "04:30:44", "text": "ストリームすると、私は"}, {"type": "subtitle", "time": 16247.389, "timestamp": "04:30:47", "text": "8時間以内である必要があります"}, {"type": "subtitle", "time": 16250.67, "timestamp": "04:30:50", "text": "マークは、私が"}, {"type": "subtitle", "time": 16255.67, "timestamp": "04:30:55", "text": "えっと、私は、自分に制限を設けて、"}, {"type": "subtitle", "time": 16259.91, "timestamp": "04:30:59", "text": "プロは毎日12時間の配信を好む。だから私は"}]
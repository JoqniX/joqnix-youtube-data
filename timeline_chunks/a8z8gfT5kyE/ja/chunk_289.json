[{"type": "subtitle", "time": 17351.07, "timestamp": "04:49:11", "text": "どこ？そうそう。えっと、銃のことですよね？は"}, {"type": "subtitle", "time": 17361.27, "timestamp": "04:49:21", "text": "男。だから、ロックを解除するのに十分なお金がある"}, {"type": "subtitle", "time": 17363.03, "timestamp": "04:49:23", "text": "キャラクター。そこが問題なんです。だから私は"}, {"type": "subtitle", "time": 17365.15, "timestamp": "04:49:25", "text": "例えば、私は"}, {"type": "subtitle", "time": 17369.43, "timestamp": "04:49:29", "text": "彼女と一緒に行くべきか、それとも私が一緒に行くべきか？"}, {"type": "subtitle", "time": 17372.39, "timestamp": "04:49:32", "text": "どちらもそれぞれに良いところがある。もし私が行きたいなら"}, {"type": "subtitle", "time": 17380.47, "timestamp": "04:49:40", "text": "彼女。彼女の能力を忘れてしまったと思う"}, {"type": "subtitle", "time": 17381.948, "timestamp": "04:49:41", "text": "だった、"}, {"type": "subtitle", "time": 17384.788, "timestamp": "04:49:44", "text": "でも、彼女は楽しい人でもあるんです。彼女は"}, {"type": "subtitle", "time": 17386.27, "timestamp": "04:49:46", "text": "積極的に"}, {"type": "subtitle", "time": 17389.27, "timestamp": "04:49:49", "text": "楽しい。彼女はショットガンの使い手だ。彼女は"}, {"type": "subtitle", "time": 17390.83, "timestamp": "04:49:50", "text": "積極的に"}, {"type": "subtitle", "time": 17393.75, "timestamp": "04:49:53", "text": "楽しい。ああ、あのね？私はまだこう言うだろう"}, {"type": "subtitle", "time": 17396.19, "timestamp": "04:49:56", "text": "貯金したい。私はしたくない"}]
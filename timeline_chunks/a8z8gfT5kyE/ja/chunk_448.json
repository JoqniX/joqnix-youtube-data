[{"type": "subtitle", "time": 26883.468, "timestamp": "07:28:03", "text": "いいえ。"}, {"type": "subtitle", "time": 26886.83, "timestamp": "07:28:06", "text": "おお。ああ。ありがとうございます"}, {"type": "subtitle", "time": 26888.19, "timestamp": "07:28:08", "text": "[音楽]"}, {"type": "subtitle", "time": 26892.31, "timestamp": "07:28:12", "text": "フォローする。待って、この名前を見たことがある"}, {"type": "subtitle", "time": 26893.83, "timestamp": "07:28:13", "text": "前に。"}, {"type": "subtitle", "time": 26901.35, "timestamp": "07:28:21", "text": "フォローする。待って、どう発音するの？行く"}, {"type": "subtitle", "time": 26904.91, "timestamp": "07:28:24", "text": "あなたの名前を間違って発音することによって。しかし"}, {"type": "subtitle", "time": 26932.83, "timestamp": "07:28:52", "text": "[音楽]"}]
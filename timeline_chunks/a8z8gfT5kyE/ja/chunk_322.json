[{"type": "subtitle", "time": 19320.59, "timestamp": "05:22:00", "text": "1つ。今あなた"}, {"type": "subtitle", "time": 19323.99, "timestamp": "05:22:03", "text": "押された。えっと、オーバーウォッチです。ああ、"}, {"type": "subtitle", "time": 19326.31, "timestamp": "05:22:06", "text": "うん。ペイロード。私はストリーミング配信をしたことがありません"}, {"type": "subtitle", "time": 19328.868, "timestamp": "05:22:08", "text": "そうそう。配信外でプレイしたけど、うん。"}, {"type": "subtitle", "time": 19333.51, "timestamp": "05:22:13", "text": "うん。うん。あ、待って。もしあなたが望むなら"}, {"type": "subtitle", "time": 19336.628, "timestamp": "05:22:16", "text": "待って、オンラインですか？それはオンラインですか？"}, {"type": "subtitle", "time": 19339.788, "timestamp": "05:22:19", "text": "どうすればあなたを招待できますか？"}, {"type": "subtitle", "time": 19343.708, "timestamp": "05:22:23", "text": "ええ、そうです。それは"}, {"type": "subtitle", "time": 19345.55, "timestamp": "05:22:25", "text": "観戦している。"}, {"type": "subtitle", "time": 19347.708, "timestamp": "05:22:27", "text": "えっと、"}, {"type": "subtitle", "time": 19360.788, "timestamp": "05:22:40", "text": "こんにちは。どうやってこれを解明するのですか？"}, {"type": "subtitle", "time": 19363.948, "timestamp": "05:22:43", "text": "これはメッセージングです。"}, {"type": "subtitle", "time": 19366.628, "timestamp": "05:22:46", "text": "わかった。これは何ですか？ああ、友達じゃないよ。"}, {"type": "subtitle", "time": 19369.35, "timestamp": "05:22:49", "text": "わかった。これは何ですか？これは"}, {"type": "subtitle", "time": 19371.67, "timestamp": "05:22:51", "text": "ブロックして友達解除するんだよね？いいえ。どうすればいいですか？"}, {"type": "subtitle", "time": 19372.99, "timestamp": "05:22:52", "text": "招待する"}, {"type": "subtitle", "time": 19377.39, "timestamp": "05:22:57", "text": "これについて。"}]
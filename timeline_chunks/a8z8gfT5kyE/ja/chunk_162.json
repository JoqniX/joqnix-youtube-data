[{"type": "subtitle", "time": 9722.11, "timestamp": "02:42:02", "text": "中国語を見たいですか"}, {"type": "subtitle", "time": 9725.19, "timestamp": "02:42:05", "text": "ストリーム、彼女の説明は"}, {"type": "subtitle", "time": 9727.429, "timestamp": "02:42:07", "text": "説明。 YouTube を利用している、または"}, {"type": "subtitle", "time": 9729.59, "timestamp": "02:42:09", "text": "Twitchにいるなら、ピン留めされている"}, {"type": "subtitle", "time": 9732.03, "timestamp": "02:42:12", "text": "コメント。わかった。"}, {"type": "subtitle", "time": 9736.07, "timestamp": "02:42:16", "text": "こんにちは。あなたはそれを観て応援しますか？"}, {"type": "subtitle", "time": 9739.03, "timestamp": "02:42:19", "text": "彼女のストリームで、あなたがどこから来たのか教えてください"}, {"type": "subtitle", "time": 9741.59, "timestamp": "02:42:21", "text": "ジョックの配信？彼女は"}, {"type": "subtitle", "time": 9749.63, "timestamp": "02:42:29", "text": "それで。彼女は楽しむでしょう"}, {"type": "subtitle", "time": 9753.91, "timestamp": "02:42:33", "text": "それ。将来彼女が"}, {"type": "subtitle", "time": 9756.63, "timestamp": "02:42:36", "text": "英語力も向上する。でも私は"}, {"type": "subtitle", "time": 9761.19, "timestamp": "02:42:41", "text": "まず日本語をきちんと準備します"}, {"type": "subtitle", "time": 9764.03, "timestamp": "02:42:44", "text": "そして日本語を習得する"}, {"type": "subtitle", "time": 9766.83, "timestamp": "02:42:46", "text": "より良い。それで"}, {"type": "subtitle", "time": 9772.59, "timestamp": "02:42:52", "text": "本当に"}, {"type": "subtitle", "time": 9775.63, "timestamp": "02:42:55", "text": "楽しい。本当に、本当に"}, {"type": "subtitle", "time": 9779.99, "timestamp": "02:42:59", "text": "楽しい。それで、今は午後8時頃なので。"}]
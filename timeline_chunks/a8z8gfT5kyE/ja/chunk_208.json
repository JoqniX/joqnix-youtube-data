[{"type": "subtitle", "time": 12487.44, "timestamp": "03:28:07", "text": "[音楽]"}, {"type": "subtitle", "time": 12504.309, "timestamp": "03:28:24", "text": "みんな。シャルさん、こんにちは。こんにちは。"}, {"type": "subtitle", "time": 12507.469, "timestamp": "03:28:27", "text": "皆さん、今日はどうお過ごしですか？"}, {"type": "subtitle", "time": 12510.309, "timestamp": "03:28:30", "text": "夕方？うん。こんにちは。どういたしまして、"}, {"type": "subtitle", "time": 12511.07, "timestamp": "03:28:31", "text": "いらっしゃいませ、"}, {"type": "subtitle", "time": 12512.349, "timestamp": "03:28:32", "text": "[音楽]"}, {"type": "subtitle", "time": 12514.59, "timestamp": "03:28:34", "text": "いらっしゃいませ。そうですね、"}, {"type": "subtitle", "time": 12517.91, "timestamp": "03:28:37", "text": "今日は、ああ、ああ、大変だ。私は、えーと"}, {"type": "subtitle", "time": 12520.389, "timestamp": "03:28:40", "text": "うん、今日も大変な一日だ"}, {"type": "subtitle", "time": 12524.309, "timestamp": "03:28:44", "text": "方法。そう、今日はある意味で"}, {"type": "subtitle", "time": 12526.309, "timestamp": "03:28:46", "text": "大変な一日だった。それで、どうやら"}, {"type": "subtitle", "time": 12530.07, "timestamp": "03:28:50", "text": "カリバヨでのイベントとこのスキン"}, {"type": "subtitle", "time": 12532.229, "timestamp": "03:28:52", "text": "えーと、そのキャラクターのスキンと衣装"}, {"type": "subtitle", "time": 12536.59, "timestamp": "03:28:56", "text": "などなど。それがすごく欲しい。したい"}, {"type": "subtitle", "time": 12538.83, "timestamp": "03:28:58", "text": "本当に"}]
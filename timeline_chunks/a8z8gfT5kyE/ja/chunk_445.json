[{"type": "subtitle", "time": 26718.868, "timestamp": "07:25:18", "text": "見逃してしまいました。マイクロはただのジョッキーだ。来る"}, {"type": "subtitle", "time": 26749.07, "timestamp": "07:25:49", "text": "わかった。最後に、私は"}, {"type": "subtitle", "time": 26752.67, "timestamp": "07:25:52", "text": "上達するには、良い成績を残さなければならない。"}, {"type": "subtitle", "time": 26754.35, "timestamp": "07:25:54", "text": "うん。"}, {"type": "subtitle", "time": 26757.67, "timestamp": "07:25:57", "text": "だから、自分のパフォーマンスはあまり良くないと思う。私"}]
[{"type": "subtitle", "time": 23050.83, "timestamp": "06:24:10", "text": "大きい。スクエアモードにした方がいいでしょうか？病気"}, {"type": "subtitle", "time": 23054.19, "timestamp": "06:24:14", "text": "行く。私は熱くなることができる。"}, {"type": "subtitle", "time": 23069.708, "timestamp": "06:24:29", "text": "それから。私はグラデーションになることができる。私は"}, {"type": "subtitle", "time": 23076.39, "timestamp": "06:24:36", "text": "忍者。"}, {"type": "subtitle", "time": 23077.868, "timestamp": "06:24:37", "text": "[音楽]"}, {"type": "subtitle", "time": 23081.11, "timestamp": "06:24:41", "text": "ああ、でも私はこう思うべきだ。ああ、これは"}, {"type": "subtitle", "time": 23083.75, "timestamp": "06:24:43", "text": "もっと涼しい。見て、グラデーションみたい。おお、"}, {"type": "subtitle", "time": 23086.67, "timestamp": "06:24:46", "text": "私はこれを持つべきだ。"}, {"type": "subtitle", "time": 23089.51, "timestamp": "06:24:49", "text": "ねえ、まるで浮いているみたい"}, {"type": "subtitle", "time": 23098.07, "timestamp": "06:24:58", "text": "すぐ。私はちゃんと作りたい"}]
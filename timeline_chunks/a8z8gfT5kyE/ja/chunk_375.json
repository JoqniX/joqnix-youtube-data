[{"type": "subtitle", "time": 22500.75, "timestamp": "06:15:00", "text": "スピードを上げて"}, {"type": "subtitle", "time": 22503.19, "timestamp": "06:15:03", "text": "行く。この曲は"}, {"type": "subtitle", "time": 22512.11, "timestamp": "06:15:12", "text": "仕事？どういう意味ですか"}, {"type": "subtitle", "time": 22516.868, "timestamp": "06:15:16", "text": "仕事？調べてみる必要があるかもしれません。"}, {"type": "subtitle", "time": 22522.11, "timestamp": "06:15:22", "text": "ただそう願うばかりです。もう希望は失った。ああ。おお"}, {"type": "subtitle", "time": 22530.67, "timestamp": "06:15:30", "text": "いいえ。"}, {"type": "subtitle", "time": 22535.39, "timestamp": "06:15:35", "text": "ポ。じゃあ、私はそれを受け取ります。"}, {"type": "subtitle", "time": 22537.99, "timestamp": "06:15:37", "text": "わかった。そして2つ目も調べてみます"}, {"type": "subtitle", "time": 22540.628, "timestamp": "06:15:40", "text": "もの。アラートも設定していません。"}, {"type": "subtitle", "time": 22544.39, "timestamp": "06:15:44", "text": "だから、私は知らないだろう。"}, {"type": "subtitle", "time": 22545.868, "timestamp": "06:15:45", "text": "それで"}, {"type": "subtitle", "time": 22548.75, "timestamp": "06:15:48", "text": "うん"}, {"type": "subtitle", "time": 22552.07, "timestamp": "06:15:52", "text": "えーと、もし他に誰か参加したい人がいたら、"}, {"type": "subtitle", "time": 22556.99, "timestamp": "06:15:56", "text": "どなたでも参加できます。"}, {"type": "subtitle", "time": 22559.15, "timestamp": "06:15:59", "text": "わかった。なれ"}]
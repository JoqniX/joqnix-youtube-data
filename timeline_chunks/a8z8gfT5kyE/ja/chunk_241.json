[{"type": "subtitle", "time": 14462.67, "timestamp": "04:01:02", "text": "ゲームのフォルダ。私は見ることができてよかった"}, {"type": "subtitle", "time": 14466.59, "timestamp": "04:01:06", "text": "カオス。どうしたの？"}, {"type": "subtitle", "time": 14471.03, "timestamp": "04:01:11", "text": "ああ、私は実際に作る必要がある"}, {"type": "subtitle", "time": 14474.87, "timestamp": "04:01:14", "text": "これらのもの用の新しいフォルダと、"}, {"type": "subtitle", "time": 14477.75, "timestamp": "04:01:17", "text": "やってみて。また、その話に関連して、えっと、"}, {"type": "subtitle", "time": 14481.189, "timestamp": "04:01:21", "text": "君たちは本当に、えっと、君たちは"}, {"type": "subtitle", "time": 14486.309, "timestamp": "04:01:26", "text": "えっと、皆さんはプリロードしましたか？"}, {"type": "subtitle", "time": 14498.99, "timestamp": "04:01:38", "text": "[音楽]"}, {"type": "subtitle", "time": 14500.57, "timestamp": "04:01:40", "text": "動く。"}, {"type": "subtitle", "time": 14502.51, "timestamp": "04:01:42", "text": "[音楽]"}, {"type": "subtitle", "time": 14510.87, "timestamp": "04:01:50", "text": "プリロードをダウンロードしていない"}, {"type": "subtitle", "time": 14514.55, "timestamp": "04:01:54", "text": "しかし、ランチャーをインストールしたinstのようなものによって"}]
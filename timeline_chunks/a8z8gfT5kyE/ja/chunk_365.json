[{"type": "subtitle", "time": 21901.27, "timestamp": "06:05:01", "text": "ムンバイのサーバーはみんなが罵倒するだろう"}, {"type": "subtitle", "time": 21903.788, "timestamp": "06:05:03", "text": "私に向かって、あるいは何か"}, {"type": "subtitle", "time": 21905.788, "timestamp": "06:05:05", "text": "うん"}, {"type": "subtitle", "time": 21909.83, "timestamp": "06:05:09", "text": "でも、ここで指摘されるかもしれないと思う"}, {"type": "subtitle", "time": 21912.868, "timestamp": "06:05:12", "text": "あるいは何かだけど、まあいいけど、それでも私は"}, {"type": "subtitle", "time": 21914.788, "timestamp": "06:05:14", "text": "言語がわからないので、"}, {"type": "subtitle", "time": 21917.23, "timestamp": "06:05:17", "text": "だから私は心を動かされないだろう"}, {"type": "subtitle", "time": 21921.91, "timestamp": "06:05:21", "text": "考える。うん、そこは良いところだね。"}, {"type": "subtitle", "time": 21923.43, "timestamp": "06:05:23", "text": "だから、私たちは何でもするつもりだけど、"}, {"type": "subtitle", "time": 21925.788, "timestamp": "06:05:25", "text": "通報されるかもしれない。 1つ目"}, {"type": "subtitle", "time": 21934.07, "timestamp": "06:05:34", "text": "自分。それはビデオゲームの世界ではよくあることだ。"}]
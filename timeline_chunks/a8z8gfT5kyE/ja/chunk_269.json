[{"type": "subtitle", "time": 16148.51, "timestamp": "04:29:08", "text": "悪い。おお、"}, {"type": "subtitle", "time": 16150.189, "timestamp": "04:29:10", "text": "ニース。"}, {"type": "subtitle", "time": 16159.83, "timestamp": "04:29:19", "text": "ああ、絶対に勝たなきゃ。ゆっくり演奏します。"}, {"type": "subtitle", "time": 16166.63, "timestamp": "04:29:26", "text": "よく考えてみると、私は"}, {"type": "subtitle", "time": 16169.469, "timestamp": "04:29:29", "text": "ファッションのための乱闘？私はそれを一度も使ったことがない"}, {"type": "subtitle", "time": 16178.309, "timestamp": "04:29:38", "text": "私は銃しか使いませんが、今は中古品を持っています"}, {"type": "subtitle", "time": 16185.83, "timestamp": "04:29:45", "text": "待って、私はこれをカメラで撮影するつもりはない。えっと、私は"}, {"type": "subtitle", "time": 16188.71, "timestamp": "04:29:48", "text": "前回亡くなった。私はここに行きます。"}]
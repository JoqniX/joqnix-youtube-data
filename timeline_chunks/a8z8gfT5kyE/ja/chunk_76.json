[{"type": "subtitle", "time": 4574.31, "timestamp": "01:16:14", "text": "これは競争ではありません。まだ"}, {"type": "subtitle", "time": 4576.55, "timestamp": "01:16:16", "text": "競争。オレンジが勝つだろう。"}, {"type": "subtitle", "time": 4597.83, "timestamp": "01:16:37", "text": "右。ああ、"}, {"type": "subtitle", "time": 4600.149, "timestamp": "01:16:40", "text": "何？このボタンは何ですか？ああ、これ"}, {"type": "subtitle", "time": 4605.43, "timestamp": "01:16:45", "text": "新しいボックスを作成するボタン。おお、"}, {"type": "subtitle", "time": 4614.34, "timestamp": "01:16:54", "text": "わかった。それら。"}]
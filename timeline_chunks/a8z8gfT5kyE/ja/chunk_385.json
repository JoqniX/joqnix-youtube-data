[{"type": "subtitle", "time": 23102.59, "timestamp": "06:25:02", "text": "ゲーム画面に重ねて表示する、ウェブカメラのフレームのようなオーバーレイ。私"}, {"type": "subtitle", "time": 23105.67, "timestamp": "06:25:05", "text": "つまり、私はそれを必要としていないのですが、私はこう思いました。"}, {"type": "subtitle", "time": 23107.23, "timestamp": "06:25:07", "text": "なぜ"}, {"type": "subtitle", "time": 23112.25, "timestamp": "06:25:12", "text": "ない？大丈夫。なぜだめですか？"}, {"type": "subtitle", "time": 23123.708, "timestamp": "06:25:23", "text": "[音楽]"}, {"type": "subtitle", "time": 23126.91, "timestamp": "06:25:26", "text": "ない？ああ、私は順応できます"}, {"type": "subtitle", "time": 23128.25, "timestamp": "06:25:28", "text": "これ"}, {"type": "subtitle", "time": 23129.548, "timestamp": "06:25:29", "text": "[音楽]"}, {"type": "subtitle", "time": 23131.868, "timestamp": "06:25:31", "text": "もの。"}, {"type": "subtitle", "time": 23133.868, "timestamp": "06:25:33", "text": "えっと、私は"}, {"type": "subtitle", "time": 23148.548, "timestamp": "06:25:48", "text": "[音楽]"}, {"type": "subtitle", "time": 23150.91, "timestamp": "06:25:50", "text": "それは良いことですか？それを回すべきでしょうか"}]
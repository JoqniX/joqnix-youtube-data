[{"type": "subtitle", "time": 26400.23, "timestamp": "07:20:00", "text": "全て。そもそもなぜ私はこれを持っているのだろう？つまり、私は"}, {"type": "subtitle", "time": 26402.91, "timestamp": "07:20:02", "text": "スタイル重視で。私"}, {"type": "subtitle", "time": 26406.83, "timestamp": "07:20:06", "text": "1回は近接攻撃を使う必要があると思う"}, {"type": "subtitle", "time": 26410.67, "timestamp": "07:20:10", "text": "その間。すごく間違っている気がする。"}, {"type": "subtitle", "time": 26414.15, "timestamp": "07:20:14", "text": "カタナはこう言うだろう、「なぜあなたは"}, {"type": "subtitle", "time": 26416.23, "timestamp": "07:20:16", "text": "私を利用する？"}, {"type": "subtitle", "time": 26419.35, "timestamp": "07:20:19", "text": "愛を与えるのをやめて、"}, {"type": "subtitle", "time": 26420.99, "timestamp": "07:20:20", "text": "農民"}, {"type": "subtitle", "time": 26426.35, "timestamp": "07:20:26", "text": "銃。私に愛をください。私も"}, {"type": "subtitle", "time": 26442.83, "timestamp": "07:20:42", "text": "ああ、"}, {"type": "subtitle", "time": 26458.11, "timestamp": "07:20:58", "text": "[音楽]"}]
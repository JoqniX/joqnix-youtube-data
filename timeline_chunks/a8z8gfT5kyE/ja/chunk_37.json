[{"type": "subtitle", "time": 2229.109, "timestamp": "00:37:09", "text": "えっと、あなたは、えっと、えっと、えっと、えっと"}, {"type": "subtitle", "time": 2236.95, "timestamp": "00:37:16", "text": "ええ、それは分かります。うん。うん。うん。"}, {"type": "subtitle", "time": 2252.99, "timestamp": "00:37:32", "text": "ウヒ。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 2258.03, "timestamp": "00:37:38", "text": "こんにちは。わかった。そんな感じ。開ける"}, {"type": "subtitle", "time": 2264.89, "timestamp": "00:37:44", "text": "右。"}]
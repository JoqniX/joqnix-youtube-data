[{"type": "subtitle", "time": 9482.75, "timestamp": "02:38:02", "text": "コラボ配信ありがとうございました。ありがとう"}, {"type": "subtitle", "time": 9486.389, "timestamp": "02:38:06", "text": "私の名前のために。"}, {"type": "subtitle", "time": 9488.71, "timestamp": "02:38:08", "text": "私の名前はジョクンです。"}, {"type": "subtitle", "time": 9508.469, "timestamp": "02:38:28", "text": "こんにちは。あれは、あ、待って。私にさせてください、私は"}, {"type": "subtitle", "time": 9513.55, "timestamp": "02:38:33", "text": "これは置いておいて。彼女は去った。こんにちは。それ"}, {"type": "subtitle", "time": 9516.71, "timestamp": "02:38:36", "text": "それは、ええと、楽しかった。それは本当に"}, {"type": "subtitle", "time": 9520.79, "timestamp": "02:38:40", "text": "楽しい。えっと、私、すごく失敗しちゃったよね？私"}, {"type": "subtitle", "time": 9524.23, "timestamp": "02:38:44", "text": "何度かひどく失敗したが、"}, {"type": "subtitle", "time": 9527.67, "timestamp": "02:38:47", "text": "それでも楽しかった。楽しかった。"}, {"type": "subtitle", "time": 9528.67, "timestamp": "02:38:48", "text": "それで"}, {"type": "subtitle", "time": 9532.95, "timestamp": "02:38:52", "text": "それから、えっと、それは本当に楽しかったです"}, {"type": "subtitle", "time": 9536.23, "timestamp": "02:38:56", "text": "ダニシャがいて、私が何をしているか"}]
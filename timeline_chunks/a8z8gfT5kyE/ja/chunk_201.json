[{"type": "subtitle", "time": 12060.389, "timestamp": "03:21:00", "text": "そういうことや、それが誰だったのかを言及することなど"}, {"type": "subtitle", "time": 12062.87, "timestamp": "03:21:02", "text": "その人、あるいは何か。私はただ彼らに願うだけです"}, {"type": "subtitle", "time": 12066.91, "timestamp": "03:21:06", "text": "幸運とすべての良いこと"}, {"type": "subtitle", "time": 12070.55, "timestamp": "03:21:10", "text": "そこには。ええ、彼らに最善を尽くさせてあげましょう"}, {"type": "subtitle", "time": 12113.429, "timestamp": "03:21:53", "text": "なぜ腹が立つのか分からない"}, {"type": "subtitle", "time": 12116.79, "timestamp": "03:21:56", "text": "それによって。理由は分からないよ、兄弟。私は好きです"}, {"type": "subtitle", "time": 12119.429, "timestamp": "03:21:59", "text": "そうですね、メインをブロックします"}]
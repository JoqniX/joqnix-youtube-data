[{"type": "subtitle", "time": 15795.389, "timestamp": "04:23:15", "text": "[音楽]"}, {"type": "subtitle", "time": 15803.55, "timestamp": "04:23:23", "text": "なんてこった、金と"}, {"type": "subtitle", "time": 15806.95, "timestamp": "04:23:26", "text": "銀と私のようなランクなし３人"}, {"type": "subtitle", "time": 15829.429, "timestamp": "04:23:49", "text": "そしてそのランクは、まるで彼らが"}, {"type": "subtitle", "time": 15831.55, "timestamp": "04:23:51", "text": "coms を使用します。それは"}, {"type": "subtitle", "time": 15834.71, "timestamp": "04:23:54", "text": "問題。私は中国語がわからないので"}, {"type": "subtitle", "time": 15837.389, "timestamp": "04:23:57", "text": "通信またはテキストを理解する"}, {"type": "subtitle", "time": 15839.91, "timestamp": "04:23:59", "text": "そういうことをして、私が"}]
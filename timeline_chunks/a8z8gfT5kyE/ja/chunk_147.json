[{"type": "subtitle", "time": 8837.59, "timestamp": "02:27:17", "text": "念のため言っておきますが、"}, {"type": "subtitle", "time": 8840.63, "timestamp": "02:27:20", "text": "このテストをクリアするには、粉砕する必要がある。"}, {"type": "subtitle", "time": 8858.27, "timestamp": "02:27:38", "text": "ああ、わかった。そうします"}, {"type": "subtitle", "time": 8869.83, "timestamp": "02:27:49", "text": "えっと、ポータル。"}]
[{"type": "subtitle", "time": 27313.35, "timestamp": "07:35:13", "text": "店。あのね？重いものが必要だ"}, {"type": "subtitle", "time": 27314.43, "timestamp": "07:35:14", "text": "重い"}, {"type": "subtitle", "time": 27317.67, "timestamp": "07:35:17", "text": "鎧。やめて、お願い、やめて、お願い、やめて"}, {"type": "subtitle", "time": 27319.91, "timestamp": "07:35:19", "text": "降伏。お願いします。ありがとう。もう一つ"}, {"type": "subtitle", "time": 27323.83, "timestamp": "07:35:23", "text": "投票する。お願いだから、死なないで。私"}, {"type": "subtitle", "time": 27329.27, "timestamp": "07:35:29", "text": "ランク。負けても構わない。いや、いや、いや。"}, {"type": "subtitle", "time": 27330.19, "timestamp": "07:35:30", "text": "そうではありません"}, {"type": "subtitle", "time": 27340.628, "timestamp": "07:35:40", "text": "難しい。ああ、これにはガチャもあるよ"}, {"type": "subtitle", "time": 27342.708, "timestamp": "07:35:42", "text": "ゲーム。ゲットチャはスキンとかそういうの用だよ"}, {"type": "subtitle", "time": 27345.67, "timestamp": "07:35:45", "text": "そして武器スキン。"}, {"type": "subtitle", "time": 27349.91, "timestamp": "07:35:49", "text": "それで、ゲンチン・インパチャも入れるんですね。"}, {"type": "subtitle", "time": 27351.628, "timestamp": "07:35:51", "text": "ループとして"}]
[{"type": "subtitle", "time": 11164.87, "timestamp": "03:06:04", "text": "えーっと、ちょっとこれをやらせてください"}, {"type": "subtitle", "time": 11167.23, "timestamp": "03:06:07", "text": "素早い。よし、みんな。えっと、"}, {"type": "subtitle", "time": 11195.99, "timestamp": "03:06:35", "text": "について。わかった。土曜日、クインソンで"}, {"type": "subtitle", "time": 11197.75, "timestamp": "03:06:37", "text": "学校の行事。確認しなければならない"}, {"type": "subtitle", "time": 11199.15, "timestamp": "03:06:39", "text": "ミステリーは"}, {"type": "subtitle", "time": 11202.71, "timestamp": "03:06:42", "text": "終わり。セレスティアとイシズマンは彼女が"}, {"type": "subtitle", "time": 11210.75, "timestamp": "03:06:50", "text": "去った。ウー・ミズと石泉サムのコラボ"}, {"type": "subtitle", "time": 11214.389, "timestamp": "03:06:54", "text": "彼女はキャンセルされなかった"}, {"type": "subtitle", "time": 11217.51, "timestamp": "03:06:57", "text": "彼女は暇ではないし、時間を作ることもできない。だからそれは"}, {"type": "subtitle", "time": 11219.8, "timestamp": "03:06:59", "text": "それは は。"}]
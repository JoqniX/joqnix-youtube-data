[{"type": "subtitle", "time": 20161.67, "timestamp": "05:36:01", "text": "音楽？待て、それは師匠だ。これは、"}, {"type": "subtitle", "time": 20163.39, "timestamp": "05:36:03", "text": "音"}, {"type": "subtitle", "time": 20189.15, "timestamp": "05:36:29", "text": "[音楽]"}, {"type": "subtitle", "time": 20192.11, "timestamp": "05:36:32", "text": "サイズ。"}, {"type": "subtitle", "time": 20195.03, "timestamp": "05:36:35", "text": "あの、あのね？私は作らなかった"}, {"type": "subtitle", "time": 20197.11, "timestamp": "05:36:37", "text": "はい、もし何か進展があったら教えてください。"}, {"type": "subtitle", "time": 20199.67, "timestamp": "05:36:39", "text": "参加する人なら誰でも。ああ、もしそれが"}, {"type": "subtitle", "time": 20201.91, "timestamp": "05:36:41", "text": "わかった。ただ遊んで遊んで、"}, {"type": "subtitle", "time": 20204.99, "timestamp": "05:36:44", "text": "イベントに参加して、皆さんが参加できるようにしましょう"}, {"type": "subtitle", "time": 20206.83, "timestamp": "05:36:46", "text": "で。"}, {"type": "subtitle", "time": 20210.948, "timestamp": "05:36:50", "text": "わかった。それがうまくいくかどうかは分かりません。私"}, {"type": "subtitle", "time": 20219.39, "timestamp": "05:36:59", "text": "試す。私はそれが"}]
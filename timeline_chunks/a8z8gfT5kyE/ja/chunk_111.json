[{"type": "subtitle", "time": 6660.07, "timestamp": "01:51:00", "text": "この線は"}, {"type": "subtitle", "time": 6670.229, "timestamp": "01:51:10", "text": "見えますか？ああ、ライオン。このセリフをもらった。"}, {"type": "subtitle", "time": 6674.709, "timestamp": "01:51:14", "text": "線と円。ここで長い円を描いて"}, {"type": "subtitle", "time": 6678.07, "timestamp": "01:51:18", "text": "短い円がここにあります。"}, {"type": "subtitle", "time": 6679.75, "timestamp": "01:51:19", "text": "H."}, {"type": "subtitle", "time": 6710.39, "timestamp": "01:51:50", "text": "[音楽]"}, {"type": "subtitle", "time": 6718.229, "timestamp": "01:51:58", "text": "そうそう。うん。変化。"}]
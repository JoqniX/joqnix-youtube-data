[{"type": "subtitle", "time": 22473.39, "timestamp": "06:14:33", "text": "ああ、私たちは二人とも死んでしまった。ニース。私たちは二人とも死んだ。"}, {"type": "subtitle", "time": 22486.03, "timestamp": "06:14:46", "text": "わーい。レベル15。"}, {"type": "subtitle", "time": 22494.15, "timestamp": "06:14:54", "text": "[音楽]"}, {"type": "subtitle", "time": 22498.788, "timestamp": "06:14:58", "text": "ニース。ニース。夕食を食べたい。それで、"}]
[{"type": "subtitle", "time": 1990.95, "timestamp": "00:33:10", "text": "えっと、どこですか？そうそう。あ、あ、ジャンプ。"}, {"type": "subtitle", "time": 1992.24, "timestamp": "00:33:12", "text": "わかった。"}, {"type": "subtitle", "time": 1994.35, "timestamp": "00:33:14", "text": "[音楽]"}, {"type": "subtitle", "time": 2006.35, "timestamp": "00:33:26", "text": "脚。待って。"}, {"type": "subtitle", "time": 2009.69, "timestamp": "00:33:29", "text": "待って。うん。うん。うん。"}, {"type": "subtitle", "time": 2016.389, "timestamp": "00:33:36", "text": "ついに。うん。"}, {"type": "subtitle", "time": 2018.71, "timestamp": "00:33:38", "text": "ニース。"}, {"type": "subtitle", "time": 2022.63, "timestamp": "00:33:42", "text": "各デバイスは2つ作成できる。"}, {"type": "subtitle", "time": 2024.95, "timestamp": "00:33:44", "text": "デバイスをテストするには、ポータルにアクセスしてください。"}]
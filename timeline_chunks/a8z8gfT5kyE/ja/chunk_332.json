[{"type": "subtitle", "time": 19922.19, "timestamp": "05:32:02", "text": "待て、それは殺すはずだ。だからもし私が到達したら"}, {"type": "subtitle", "time": 19925.35, "timestamp": "05:32:05", "text": "レベル20以降は、私は"}, {"type": "subtitle", "time": 19927.99, "timestamp": "05:32:07", "text": "この紙みたいなもの。どうすればまだ手に入れられるだろうか"}, {"type": "subtitle", "time": 19930.27, "timestamp": "05:32:10", "text": "それ"}, {"type": "subtitle", "time": 19932.79, "timestamp": "05:32:12", "text": "もの？どうすればこれを入手できますか"}, {"type": "subtitle", "time": 19938.35, "timestamp": "05:32:18", "text": "[音楽]"}, {"type": "subtitle", "time": 19942.36, "timestamp": "05:32:22", "text": "もの？どうすればこの商品を入手できますか？"}, {"type": "subtitle", "time": 19945.15, "timestamp": "05:32:25", "text": "[音楽]"}, {"type": "subtitle", "time": 19947.99, "timestamp": "05:32:27", "text": "けれど？では、私が教えてあげましょう。 1ゲーム"}, {"type": "subtitle", "time": 19950.75, "timestamp": "05:32:30", "text": "1つのゲームがあなたに与える"}, {"type": "subtitle", "time": 19953.628, "timestamp": "05:32:33", "text": "ああ、手に入れた"}, {"type": "subtitle", "time": 19956.11, "timestamp": "05:32:36", "text": "それ。ただ遊ぶだけ。"}, {"type": "subtitle", "time": 19967.03, "timestamp": "05:32:47", "text": "わかった。参加したい場合はお知らせください"}, {"type": "subtitle", "time": 19970.11, "timestamp": "05:32:50", "text": "[音楽]"}, {"type": "subtitle", "time": 19979.31, "timestamp": "05:32:59", "text": "えーと"}]
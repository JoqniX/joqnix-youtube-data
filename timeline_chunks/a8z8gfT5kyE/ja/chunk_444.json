[{"type": "subtitle", "time": 26640.468, "timestamp": "07:24:00", "text": "ああ、一晩中かかるかもしれない"}, {"type": "subtitle", "time": 26643.03, "timestamp": "07:24:03", "text": "このゲームにはグラインダーとかそういうものがある。はぁ？"}, {"type": "subtitle", "time": 26645.51, "timestamp": "07:24:05", "text": "北米出身のプレイヤーがプレイする場合"}, {"type": "subtitle", "time": 26648.27, "timestamp": "07:24:08", "text": "単に"}, {"type": "subtitle", "time": 26652.27, "timestamp": "07:24:12", "text": "一晩中起きているようなタイプ"}, {"type": "subtitle", "time": 26670.468, "timestamp": "07:24:30", "text": "[音楽]"}, {"type": "subtitle", "time": 26673.15, "timestamp": "07:24:33", "text": "それは"}]
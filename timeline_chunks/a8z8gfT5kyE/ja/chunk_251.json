[{"type": "subtitle", "time": 15061.67, "timestamp": "04:11:01", "text": "良い。皆さん、火曜日おめでとうございます。調子はどうですか？"}, {"type": "subtitle", "time": 15069.83, "timestamp": "04:11:09", "text": "みんな？くそっ、ジョー、君は短いのが好きなのは知ってるよ"}, {"type": "subtitle", "time": 15073.07, "timestamp": "04:11:13", "text": "髪の女性。しかし、これは一体何だろうか？"}, {"type": "subtitle", "time": 15075.55, "timestamp": "04:11:15", "text": "おい、これは何だ？の"}, {"type": "subtitle", "time": 15077.67, "timestamp": "04:11:17", "text": "なに。何？どういう意味ですか？何が"}, {"type": "subtitle", "time": 15092.36, "timestamp": "04:11:32", "text": "平均？"}, {"type": "subtitle", "time": 15094.75, "timestamp": "04:11:34", "text": "[音楽]"}, {"type": "subtitle", "time": 15103.229, "timestamp": "04:11:43", "text": "バッカ。なぜ私の翻訳はいつも"}, {"type": "subtitle", "time": 15111.07, "timestamp": "04:11:51", "text": "なぜいつもこうなのか"}, {"type": "subtitle", "time": 15113.48, "timestamp": "04:11:53", "text": "この翻訳は常に"}]
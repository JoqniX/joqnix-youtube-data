[{"type": "subtitle", "time": 24844.67, "timestamp": "06:54:04", "text": "難しい。 ch の主な課題はレベルアップすることです"}, {"type": "subtitle", "time": 24848.07, "timestamp": "06:54:08", "text": "ランクアップ。"}, {"type": "subtitle", "time": 24850.59, "timestamp": "06:54:10", "text": "自分がプレイしているなんて信じられない"}, {"type": "subtitle", "time": 24853.628, "timestamp": "06:54:13", "text": "ランクイン。私と誰か"}, {"type": "subtitle", "time": 24861.67, "timestamp": "06:54:21", "text": "ああ、それは私がしなければならないということですか？"}, {"type": "subtitle", "time": 24864.548, "timestamp": "06:54:24", "text": "つまり、私は遊ぶ必要があるということ"}, {"type": "subtitle", "time": 24866.59, "timestamp": "06:54:26", "text": "ヴァレリンとその他のゲーム"}, {"type": "subtitle", "time": 24870.99, "timestamp": "06:54:30", "text": "私の通常の活動に対するランキングは？"}, {"type": "subtitle", "time": 24875.43, "timestamp": "06:54:35", "text": "おお。私はしません 私はしません 私は良くありません"}, {"type": "subtitle", "time": 24879.27, "timestamp": "06:54:39", "text": "狙撃手に対して。でも、あなたは優秀ですよ。私は見た"}, {"type": "subtitle", "time": 24880.59, "timestamp": "06:54:40", "text": "あなたの"}, {"type": "subtitle", "time": 24893.35, "timestamp": "06:54:53", "text": "いいね。スナイパーをアンロックする必要がある"}, {"type": "subtitle", "time": 24896.35, "timestamp": "06:54:56", "text": "キャラクター。狙撃手役は誰ですか？"}]
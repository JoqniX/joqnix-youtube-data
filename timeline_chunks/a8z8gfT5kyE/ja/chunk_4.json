[{"type": "subtitle", "time": 240.509, "timestamp": "00:04:00", "text": "それは大変だろうから"}, {"type": "subtitle", "time": 261.99, "timestamp": "00:04:21", "text": "グラフィック。えっと、垂直同期を待ってください。"}, {"type": "subtitle", "time": 274.07, "timestamp": "00:04:34", "text": "これを気にしない人たち。だから、私はただ"}, {"type": "subtitle", "time": 282.27, "timestamp": "00:04:42", "text": "少し。聞こえますか？わかった、"}, {"type": "subtitle", "time": 283.95, "timestamp": "00:04:43", "text": "良い。"}, {"type": "subtitle", "time": 286.469, "timestamp": "00:04:46", "text": "こんにちは。とりあえず言ってみます。"}, {"type": "subtitle", "time": 288.469, "timestamp": "00:04:48", "text": "ええ、大丈夫です。心配ない。私は欲しい"}, {"type": "subtitle", "time": 291.43, "timestamp": "00:04:51", "text": "実際にプレイしたい"}, {"type": "subtitle", "time": 293.55, "timestamp": "00:04:53", "text": "ウランズ。とても楽しい"}, {"type": "chat", "time": 297.405, "timestamp": "00:04:57", "author": "@BRUCELEE-wt7hk", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kywKa6HSckNVxhER8qedLRRVkcGIqFFytjQHe-071HyMo=s64-c-k-c0x00ffffff-no-rj", "message": "hello joqnix"}]
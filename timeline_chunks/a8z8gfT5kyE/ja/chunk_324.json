[{"type": "subtitle", "time": 19442.31, "timestamp": "05:24:02", "text": "彼女。彼女をゲットするべきかな？しかし、"}, {"type": "subtitle", "time": 19445.27, "timestamp": "05:24:05", "text": "イベントバナーにこれが表示されるようになりました。だから私は"}, {"type": "subtitle", "time": 19449.47, "timestamp": "05:24:09", "text": "銃。私は"}, {"type": "subtitle", "time": 19454.31, "timestamp": "05:24:14", "text": "銃。うん。だから、えーと、"}, {"type": "subtitle", "time": 19456.55, "timestamp": "05:24:16", "text": "そう、アニメの男の子たち。そうそう。これがある"}, {"type": "subtitle", "time": 19462.47, "timestamp": "05:24:22", "text": "男とこの男とこの男。"}, {"type": "subtitle", "time": 19464.708, "timestamp": "05:24:24", "text": "えっと、どんな武器がお好みですか？えっと、"}, {"type": "subtitle", "time": 19468.55, "timestamp": "05:24:28", "text": "ピュンピュン銃。暴行のようなあらゆるタイプ"}, {"type": "subtitle", "time": 19472.35, "timestamp": "05:24:32", "text": "ライフル。うん、ピューピューピューピュー"}, {"type": "subtitle", "time": 19481.708, "timestamp": "05:24:41", "text": "セミオートスナイパーライフル。そこには"}, {"type": "subtitle", "time": 19483.23, "timestamp": "05:24:43", "text": "1つ"}, {"type": "subtitle", "time": 19490.31, "timestamp": "05:24:50", "text": "する。あ、待って。狙撃銃。私は悪い"}, {"type": "subtitle", "time": 19493.23, "timestamp": "05:24:53", "text": "それに関して。タップタップタップ"}, {"type": "subtitle", "time": 19497.55, "timestamp": "05:24:57", "text": "あれ。それは痛みだ。ちょっと待って。"}]
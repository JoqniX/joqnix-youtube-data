[{"type": "subtitle", "time": 2286.15, "timestamp": "00:38:06", "text": "こんにちは。開ける。"}, {"type": "subtitle", "time": 2288.589, "timestamp": "00:38:08", "text": "私にさせてください"}, {"type": "subtitle", "time": 2319.67, "timestamp": "00:38:39", "text": "加重キューブの校正済み。こんにちは。いいえ"}, {"type": "subtitle", "time": 2322.15, "timestamp": "00:38:42", "text": "差異が検出されました。あなたは"}, {"type": "subtitle", "time": 2325.109, "timestamp": "00:38:45", "text": "私と一緒に変化を起こしましょう。あなたにあげます"}, {"type": "subtitle", "time": 2327.75, "timestamp": "00:38:47", "text": "ポータル人間"}]
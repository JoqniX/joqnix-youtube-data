[{"type": "subtitle", "time": 20101.948, "timestamp": "05:35:01", "text": "[音楽]"}, {"type": "subtitle", "time": 20111.07, "timestamp": "05:35:11", "text": "えーと、私はラプラスを"}, {"type": "subtitle", "time": 20123.628, "timestamp": "05:35:23", "text": "しかし、このゲームでの水分補給は"}, {"type": "subtitle", "time": 20135.39, "timestamp": "05:35:35", "text": "ID。そこにいる"}, {"type": "subtitle", "time": 20139.15, "timestamp": "05:35:39", "text": "行く。あ、水道カードを使ったよ。私"}, {"type": "subtitle", "time": 20141.83, "timestamp": "05:35:41", "text": "忘れた。そうそう。私のエビのピースは"}, {"type": "subtitle", "time": 20150.628, "timestamp": "05:35:50", "text": "なんて親切な人でしょう。また、私が聞いているのは"}, {"type": "subtitle", "time": 20153.47, "timestamp": "05:35:53", "text": "自分のストリーム。音声はそうではない"}, {"type": "subtitle", "time": 20158.83, "timestamp": "05:35:58", "text": "バランスが取れている？ゲームの難易度を下げる必要がありますか？"}]
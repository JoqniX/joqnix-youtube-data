[{"type": "subtitle", "time": 17407.19, "timestamp": "04:50:07", "text": "だから、このレベルに達したらロックを解除する必要がある"}, {"type": "subtitle", "time": 17412.07, "timestamp": "04:50:12", "text": "16. わかりました。これはレベル18で、最後のものです。"}, {"type": "subtitle", "time": 17423.27, "timestamp": "04:50:23", "text": "それ。だから、もし誰かがプレイしたいなら"}, {"type": "subtitle", "time": 17425.43, "timestamp": "04:50:25", "text": "お知らせ下さい。君たちを連れて行くよ"}, {"type": "subtitle", "time": 17428.66, "timestamp": "04:50:28", "text": "次のやつ。わかった。"}, {"type": "subtitle", "time": 17430.628, "timestamp": "04:50:30", "text": "[音楽]"}, {"type": "subtitle", "time": 17433.83, "timestamp": "04:50:33", "text": "あ、これらの書類を閉じなきゃ。"}, {"type": "subtitle", "time": 17439.788, "timestamp": "04:50:39", "text": "[音楽]"}, {"type": "subtitle", "time": 17442.57, "timestamp": "04:50:42", "text": "秒接続を解除します。"}, {"type": "subtitle", "time": 17444.51, "timestamp": "04:50:44", "text": "[音楽]"}, {"type": "subtitle", "time": 17447.07, "timestamp": "04:50:47", "text": "再接続する。来る"}, {"type": "subtitle", "time": 17450.07, "timestamp": "04:50:50", "text": "の上。ああ、繋がってるんだ。うん。わかった。"}, {"type": "subtitle", "time": 17457.19, "timestamp": "04:50:57", "text": "ゲーム。そして私は手に入れるのにとても近い"}]
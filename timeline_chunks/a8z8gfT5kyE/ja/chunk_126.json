[{"type": "subtitle", "time": 7565.27, "timestamp": "02:06:05", "text": "複数人でプレイしても完璧です。私も創造された"}, {"type": "subtitle", "time": 7572.149, "timestamp": "02:06:12", "text": "未完了過去形。しかし、私は自分のハンディキャップを克服した。"}, {"type": "subtitle", "time": 7579.189, "timestamp": "02:06:19", "text": "おお、"}, {"type": "subtitle", "time": 7582.35, "timestamp": "02:06:22", "text": "あなたのブレは停止しました。"}, {"type": "subtitle", "time": 7596.95, "timestamp": "02:06:36", "text": "わかった。この地図を最後にするのはどうでしょうか？私は感じる"}, {"type": "subtitle", "time": 7600.51, "timestamp": "02:06:40", "text": "少しめまいがする。こんにちは。こんにちは。"}]
[{"type": "subtitle", "time": 15493.229, "timestamp": "04:18:13", "text": "上。"}, {"type": "subtitle", "time": 15501.67, "timestamp": "04:18:21", "text": "神。わーい。"}, {"type": "subtitle", "time": 15505.189, "timestamp": "04:18:25", "text": "遠距離攻撃をしますか？いいえ。ええと、普通です"}, {"type": "subtitle", "time": 15509.389, "timestamp": "04:18:29", "text": "パブ、パブ。私は決してプレイしません"}, {"type": "subtitle", "time": 15512.229, "timestamp": "04:18:32", "text": "範囲が広い。私は自分の称号を維持したい"}, {"type": "subtitle", "time": 15532.11, "timestamp": "04:18:52", "text": "その方が楽しい。それ"}, {"type": "subtitle", "time": 15537.59, "timestamp": "04:18:57", "text": "は。なぜ翻訳がこんなに間違っているのか？"}, {"type": "subtitle", "time": 15539.71, "timestamp": "04:18:59", "text": "誰の住所ですか？"}]
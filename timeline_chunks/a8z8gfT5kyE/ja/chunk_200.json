[{"type": "subtitle", "time": 12004.99, "timestamp": "03:20:04", "text": "そして"}, {"type": "subtitle", "time": 12007.51, "timestamp": "03:20:07", "text": "くそ、想像してみてよ、もし"}, {"type": "subtitle", "time": 12010.389, "timestamp": "03:20:10", "text": "実際に送ったらどうなるか"}, {"type": "subtitle", "time": 12012.309, "timestamp": "03:20:12", "text": "コラボ依頼のようなものです。もしあなたが"}, {"type": "subtitle", "time": 12016.55, "timestamp": "03:20:16", "text": "協力して、"}, {"type": "subtitle", "time": 12018.309, "timestamp": "03:20:18", "text": "お互いを知って一緒に過ごしたり、"}, {"type": "subtitle", "time": 12021.15, "timestamp": "03:20:21", "text": "何か"}, {"type": "subtitle", "time": 12023.75, "timestamp": "03:20:23", "text": "あれ。つまり、私は"}, {"type": "subtitle", "time": 12025.91, "timestamp": "03:20:25", "text": "話をした人たちの様子を確認する"}, {"type": "subtitle", "time": 12031.55, "timestamp": "03:20:31", "text": "過去に。わかった。だって、えっと"}, {"type": "subtitle", "time": 12035.389, "timestamp": "03:20:35", "text": "私に私に、もし私たちが"}, {"type": "subtitle", "time": 12039.67, "timestamp": "03:20:39", "text": "以前話したことのあるつながり"}, {"type": "subtitle", "time": 12042.309, "timestamp": "03:20:42", "text": "そして私たちは最近話していないので"}, {"type": "subtitle", "time": 12045.75, "timestamp": "03:20:45", "text": "再会したり話したりするのは構いません"}, {"type": "subtitle", "time": 12046.83, "timestamp": "03:20:46", "text": "また。"}, {"type": "subtitle", "time": 12050.67, "timestamp": "03:20:50", "text": "右。右。"}, {"type": "subtitle", "time": 12052.349, "timestamp": "03:20:52", "text": "それで"}, {"type": "subtitle", "time": 12055.91, "timestamp": "03:20:55", "text": "そうですね、でも、決してそうではありません"}, {"type": "subtitle", "time": 12057.75, "timestamp": "03:20:57", "text": "憎しみや"}]
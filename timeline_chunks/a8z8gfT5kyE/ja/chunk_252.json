[{"type": "subtitle", "time": 15120.349, "timestamp": "04:12:00", "text": "間違っている。うん。彼女を見て。彼女はとても"}, {"type": "subtitle", "time": 15123.67, "timestamp": "04:12:03", "text": "かわいい。あの肌。そしてオードリーは"}, {"type": "subtitle", "time": 15126.75, "timestamp": "04:12:06", "text": "かわいいですね。そして赤毛の女性も"}, {"type": "subtitle", "time": 15129.99, "timestamp": "04:12:09", "text": "かわいい。私は彼らを愛しています。すべてロックを解除したい"}, {"type": "subtitle", "time": 15133.63, "timestamp": "04:12:13", "text": "彼らのうちの。ドール、彼女の肌を見てごらん。"}, {"type": "subtitle", "time": 15137.189, "timestamp": "04:12:17", "text": "かわいい。どうすればロックを解除できますか？"}, {"type": "subtitle", "time": 15144.15, "timestamp": "04:12:24", "text": "難しい。こんにちは、ジョー。数年前に私たちは出会った。はい。"}, {"type": "subtitle", "time": 15146.87, "timestamp": "04:12:26", "text": "もうずいぶん経ちましたね。"}, {"type": "subtitle", "time": 15154.83, "timestamp": "04:12:34", "text": "[音楽]"}, {"type": "subtitle", "time": 15157.389, "timestamp": "04:12:37", "text": "された？"}, {"type": "subtitle", "time": 15174.91, "timestamp": "04:12:54", "text": "それは"}]
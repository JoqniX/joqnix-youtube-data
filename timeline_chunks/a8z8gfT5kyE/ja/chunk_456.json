[{"type": "subtitle", "time": 27375.788, "timestamp": "07:36:15", "text": "知っている。脱出まであと少しだった"}, {"type": "subtitle", "time": 27377.75, "timestamp": "07:36:17", "text": "お願い、お願い、お願い、お願い、"}, {"type": "subtitle", "time": 27380.59, "timestamp": "07:36:20", "text": "お願い、お願い。ああ、"}, {"type": "subtitle", "time": 27383.628, "timestamp": "07:36:23", "text": "神様、ありがとう"}, {"type": "subtitle", "time": 27399.91, "timestamp": "07:36:39", "text": "ニース。ああ、ブラッド、いくらになるの？"}, {"type": "subtitle", "time": 27401.51, "timestamp": "07:36:41", "text": "このゲームをプレイしますか？わからない。私は"}, {"type": "subtitle", "time": 27404.27, "timestamp": "07:36:44", "text": "中毒。いいえ、中毒ではありませんが、"}, {"type": "subtitle", "time": 27406.67, "timestamp": "07:36:46", "text": "楽しい。それはより優れている"}, {"type": "subtitle", "time": 27410.388, "timestamp": "07:36:50", "text": "ヴァレリン。うん。"}, {"type": "subtitle", "time": 27411.628, "timestamp": "07:36:51", "text": "それで、"}, {"type": "subtitle", "time": 27414.868, "timestamp": "07:36:54", "text": "うん。つまり、楽しいってことだよ。つまり、"}, {"type": "subtitle", "time": 27416.708, "timestamp": "07:36:56", "text": "いずれは休憩を取るつもりです"}, {"type": "subtitle", "time": 27419.03, "timestamp": "07:36:59", "text": "ああ、いやだ。私は日々の課題をこなします。"}]
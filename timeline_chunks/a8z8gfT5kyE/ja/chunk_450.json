[{"type": "subtitle", "time": 27001.868, "timestamp": "07:30:01", "text": "それは、それは"}, {"type": "subtitle", "time": 27004.63, "timestamp": "07:30:04", "text": "ダッシュ。"}, {"type": "subtitle", "time": 27017.07, "timestamp": "07:30:17", "text": "[音楽]"}, {"type": "subtitle", "time": 27021.31, "timestamp": "07:30:21", "text": "ハァ。次。こっそり。"}, {"type": "subtitle", "time": 27028.948, "timestamp": "07:30:28", "text": "次に別のものを見るのは良いことです、または"}, {"type": "subtitle", "time": 27045.788, "timestamp": "07:30:45", "text": "神。"}]
[{"type": "subtitle", "time": 27735.75, "timestamp": "07:42:15", "text": "ニース。いや。ああ、追いついてきていますよ。"}, {"type": "subtitle", "time": 27738.948, "timestamp": "07:42:18", "text": "彼らは追いついてきている。なんてこった。マッチです"}, {"type": "subtitle", "time": 27742.388, "timestamp": "07:42:22", "text": "ポイント。マッチポイントだ。なんてこった。なんてこった。"}, {"type": "subtitle", "time": 27748.31, "timestamp": "07:42:28", "text": "上。なんてこった。"}, {"type": "subtitle", "time": 27750.548, "timestamp": "07:42:30", "text": "ゆっくり演奏しなければならなかった。ああ、神様。私は"}, {"type": "subtitle", "time": 27752.75, "timestamp": "07:42:32", "text": "私の"}, {"type": "subtitle", "time": 27756.31, "timestamp": "07:42:36", "text": "チームメイト。これは恐ろしい。私は望んでいない"}, {"type": "subtitle", "time": 27758.788, "timestamp": "07:42:38", "text": "これを失うこと。"}, {"type": "subtitle", "time": 27761.23, "timestamp": "07:42:41", "text": "これはゲームです"}, {"type": "subtitle", "time": 27764.708, "timestamp": "07:42:44", "text": "ポイント。なぜ私の翻訳はこんなに間違っているのでしょうか？私"}, {"type": "subtitle", "time": 27766.628, "timestamp": "07:42:46", "text": "1秒見て、"}]
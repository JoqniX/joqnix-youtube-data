[{"type": "subtitle", "time": 15004.63, "timestamp": "04:10:04", "text": "ロックを解除しますか？彼女はクールだ。私は彼女を愛している。そして彼女は"}, {"type": "subtitle", "time": 15006.59, "timestamp": "04:10:06", "text": "また"}, {"type": "subtitle", "time": 15011.79, "timestamp": "04:10:11", "text": "いいね。私は何をしますか？傷跡Lまたはこれ"}, {"type": "subtitle", "time": 15015.11, "timestamp": "04:10:15", "text": "銃？私は何をしますか？でも私は彼女を愛している"}, {"type": "subtitle", "time": 15017.189, "timestamp": "04:10:17", "text": "もっと。つまり、つまり、私は彼女を愛しているんです。彼女は私の"}, {"type": "subtitle", "time": 15019.429, "timestamp": "04:10:19", "text": "ワイフだけど"}, {"type": "subtitle", "time": 15021.77, "timestamp": "04:10:21", "text": "彼女も上手だよ。"}, {"type": "subtitle", "time": 15023.59, "timestamp": "04:10:23", "text": "[音楽]"}, {"type": "subtitle", "time": 15024.99, "timestamp": "04:10:24", "text": "彼女はまた"}, {"type": "subtitle", "time": 15027.55, "timestamp": "04:10:27", "text": "良い。彼女も優秀で、"}, {"type": "subtitle", "time": 15030.75, "timestamp": "04:10:30", "text": "あまりにも。私は何をすればいいですか 私は何をすればいいですか"}, {"type": "subtitle", "time": 15033.91, "timestamp": "04:10:33", "text": "する？ああ、わかりました。あのね？私はただ"}, {"type": "subtitle", "time": 15036.429, "timestamp": "04:10:36", "text": "保存します、私は"}, {"type": "subtitle", "time": 15039.15, "timestamp": "04:10:39", "text": "推測。"}, {"type": "subtitle", "time": 15047.389, "timestamp": "04:10:47", "text": "彼女？わからない。私はただ続けるだけです"}, {"type": "subtitle", "time": 15051.67, "timestamp": "04:10:51", "text": "プレイ中。こんにちは、デア。いらっしゃいませ。"}, {"type": "subtitle", "time": 15054.389, "timestamp": "04:10:54", "text": "ストリームへようこそ、ようこそ、ようこそ。"}, {"type": "subtitle", "time": 15055.31, "timestamp": "04:10:55", "text": "お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 15058.03, "timestamp": "04:10:58", "text": "[音楽]"}]
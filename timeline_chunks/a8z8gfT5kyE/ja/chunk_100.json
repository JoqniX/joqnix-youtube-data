[{"type": "subtitle", "time": 6008.31, "timestamp": "01:40:08", "text": "こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 6022.629, "timestamp": "01:40:22", "text": "ニース。ええ、やりましたよ。"}, {"type": "subtitle", "time": 6039.03, "timestamp": "01:40:39", "text": "右。おお、いいね。天才。そうなる可能性はある。私はできる"}, {"type": "subtitle", "time": 6040.709, "timestamp": "01:40:40", "text": "飛ぶ。"}, {"type": "subtitle", "time": 6044.55, "timestamp": "01:40:44", "text": "そうなる可能性はある。私はその傷跡を焼き切ることができる。しかしその後"}, {"type": "subtitle", "time": 6048.39, "timestamp": "01:40:48", "text": "そこにいたんですね。杉菜中国語。"}, {"type": "subtitle", "time": 6051.83, "timestamp": "01:40:51", "text": "私は天才ですか？はい。天才。"}, {"type": "subtitle", "time": 6057.83, "timestamp": "01:40:57", "text": "信じられるよ。"}]
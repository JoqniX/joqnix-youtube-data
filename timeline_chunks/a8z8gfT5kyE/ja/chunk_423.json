[{"type": "subtitle", "time": 25400.91, "timestamp": "07:03:20", "text": "ニース。待って。誰かがリックをやった"}, {"type": "subtitle", "time": 25411.81, "timestamp": "07:03:31", "text": "何てことだ。あなたはできない"}, {"type": "subtitle", "time": 25413.548, "timestamp": "07:03:33", "text": "[音楽]"}, {"type": "subtitle", "time": 25417.788, "timestamp": "07:03:37", "text": "それ。誰かが到達した"}]
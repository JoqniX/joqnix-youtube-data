[{"type": "subtitle", "time": 5306.629, "timestamp": "01:28:26", "text": "おお。おお。銃を撃っていただけますか？"}, {"type": "subtitle", "time": 5309.07, "timestamp": "01:28:29", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。"}, {"type": "subtitle", "time": 5312.47, "timestamp": "01:28:32", "text": "なんてこった。いや、いや、いや、いや。動かなければならない"}, {"type": "subtitle", "time": 5314.629, "timestamp": "01:28:34", "text": "ここ。"}, {"type": "subtitle", "time": 5316.55, "timestamp": "01:28:36", "text": "さらに。待って、待って、待って、待って。しないで"}, {"type": "subtitle", "time": 5320.95, "timestamp": "01:28:40", "text": "ジャンプ。いや、いや、いや。移動させなければならない"}, {"type": "subtitle", "time": 5324.31, "timestamp": "01:28:44", "text": "ここでもあそこでも一緒に。"}, {"type": "subtitle", "time": 5326.31, "timestamp": "01:28:46", "text": "おお。おお。おお。"}, {"type": "subtitle", "time": 5328.07, "timestamp": "01:28:48", "text": "そして、ここ。"}, {"type": "subtitle", "time": 5330.709, "timestamp": "01:28:50", "text": "うん。うん。うん。うん。うん。私たちはしなければならない"}, {"type": "subtitle", "time": 5333.83, "timestamp": "01:28:53", "text": "ここに引っ越してきてください。"}]
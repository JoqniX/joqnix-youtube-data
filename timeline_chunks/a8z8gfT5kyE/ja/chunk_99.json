[{"type": "subtitle", "time": 5941.99, "timestamp": "01:39:01", "text": "何だって？二階に行くべきだった"}, {"type": "subtitle", "time": 5953.229, "timestamp": "01:39:13", "text": "ここ。いや、いや、いや。こちらへ移動してください。移動"}, {"type": "subtitle", "time": 5956.79, "timestamp": "01:39:16", "text": "私の隣にいる彼、うん。うん。そして撃つ"}, {"type": "subtitle", "time": 5966.149, "timestamp": "01:39:26", "text": "ええ、説明しましょう"}, {"type": "subtitle", "time": 5969.59, "timestamp": "01:39:29", "text": "右。ああ、わかった。わかった。そして私はジャンプして"}, {"type": "subtitle", "time": 5971.189, "timestamp": "01:39:31", "text": "ここ。"}, {"type": "subtitle", "time": 5977.109, "timestamp": "01:39:37", "text": "こんにちは、ジャンプしてパワーを手に入れます。あなた"}, {"type": "subtitle", "time": 5980.629, "timestamp": "01:39:40", "text": "ここまでもう一度撃たなければならない。"}, {"type": "subtitle", "time": 5983.83, "timestamp": "01:39:43", "text": "ああ、わかった。あなたが知っている。うん。"}, {"type": "subtitle", "time": 5987.43, "timestamp": "01:39:47", "text": "だから、もし私に力があれば、飛び越えることができる"}, {"type": "subtitle", "time": 5989.109, "timestamp": "01:39:49", "text": "そこには。"}, {"type": "subtitle", "time": 5992.47, "timestamp": "01:39:52", "text": "あ、こんにちは。分かるでしょう？"}]
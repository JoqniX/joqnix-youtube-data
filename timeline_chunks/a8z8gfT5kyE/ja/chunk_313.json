[{"type": "subtitle", "time": 18787.43, "timestamp": "05:13:07", "text": "みんな。私は星座が大好きです"}, {"type": "subtitle", "time": 18789.43, "timestamp": "05:13:09", "text": "彼女のドレス。"}, {"type": "subtitle", "time": 18789.96, "timestamp": "05:13:09", "text": "それで"}, {"type": "subtitle", "time": 18791.788, "timestamp": "05:13:11", "text": "[音楽]"}, {"type": "subtitle", "time": 18794.868, "timestamp": "05:13:14", "text": "かわいい。とても綺麗です。私は"}, {"type": "subtitle", "time": 18800.06, "timestamp": "05:13:20", "text": "時間。私は手に入れたい"}, {"type": "subtitle", "time": 18808.83, "timestamp": "05:13:28", "text": "[音楽]"}, {"type": "subtitle", "time": 18811.35, "timestamp": "05:13:31", "text": "全員に水分補給のための注射を。もしあなたが"}, {"type": "subtitle", "time": 18812.99, "timestamp": "05:13:32", "text": "まだ"}]
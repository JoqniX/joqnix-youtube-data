[{"type": "subtitle", "time": 22989.15, "timestamp": "06:23:09", "text": "知らせ。それと、私の頭に乗っているのは何ですか？"}, {"type": "subtitle", "time": 22993.11, "timestamp": "06:23:13", "text": "待って、今そこに「注意」って書いたよ。なぜ"}, {"type": "subtitle", "time": 22995.948, "timestamp": "06:23:15", "text": "私はその物を"}, {"type": "subtitle", "time": 22998.19, "timestamp": "06:23:18", "text": "頭？"}, {"type": "subtitle", "time": 23001.51, "timestamp": "06:23:21", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 23003.75, "timestamp": "06:23:23", "text": "それは何ですか"}, {"type": "subtitle", "time": 23005.39, "timestamp": "06:23:25", "text": "[音楽]"}, {"type": "subtitle", "time": 23008.788, "timestamp": "06:23:28", "text": "ライン？よし、今度は違う、ライオンは"}, {"type": "subtitle", "time": 23014.62, "timestamp": "06:23:34", "text": "そこには？それは"}, {"type": "subtitle", "time": 23015.788, "timestamp": "06:23:35", "text": "[音楽]"}, {"type": "subtitle", "time": 23025.548, "timestamp": "06:23:45", "text": "ああ、あれは何だ"}]
[{"type": "subtitle", "time": 19689.43, "timestamp": "05:28:09", "text": "これ？ええ、そういう時期がありますよね。"}, {"type": "subtitle", "time": 19691.99, "timestamp": "05:28:11", "text": "ああ、あなたは過去のシーズンを持っていると思います。"}, {"type": "subtitle", "time": 19693.94, "timestamp": "05:28:13", "text": "右？"}, {"type": "subtitle", "time": 19700.19, "timestamp": "05:28:20", "text": "うん。シーズン4。うん。最後"}, {"type": "subtitle", "time": 19704.948, "timestamp": "05:28:24", "text": "我々がプレーできないシーズン。ああ、大丈夫だよ。私"}, {"type": "subtitle", "time": 19706.51, "timestamp": "05:28:26", "text": "手に入れた"}, {"type": "subtitle", "time": 19712.19, "timestamp": "05:28:32", "text": "マスターランクみたいなものだ。ああ、神様。私は手に入れた"}, {"type": "subtitle", "time": 19715.788, "timestamp": "05:28:35", "text": "それ。マスター4。"}, {"type": "subtitle", "time": 19725.03, "timestamp": "05:28:45", "text": "おい、俺たち一緒にふざけ合うことはできないよ。私"}, {"type": "subtitle", "time": 19733.628, "timestamp": "05:28:53", "text": "に"}, {"type": "subtitle", "time": 19736.39, "timestamp": "05:28:56", "text": "えっと、ちょっとあなたの配置について。あなた"}, {"type": "subtitle", "time": 19739.31, "timestamp": "05:28:59", "text": "実際にプレイしてほしい"}]
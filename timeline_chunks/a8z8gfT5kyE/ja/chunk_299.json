[{"type": "subtitle", "time": 17950.11, "timestamp": "04:59:10", "text": "うん。私に"}, {"type": "subtitle", "time": 17961.35, "timestamp": "04:59:21", "text": "でも値段が高いですね。"}, {"type": "subtitle", "time": 17962.99, "timestamp": "04:59:22", "text": "だから私は"}, {"type": "subtitle", "time": 17967.36, "timestamp": "04:59:27", "text": "えーと、誰が一緒に遊ばないの？"}, {"type": "subtitle", "time": 17992.15, "timestamp": "04:59:52", "text": "わかった。私はただ技術の仕事をしているだけなのに、それがとても気に入っています。"}]
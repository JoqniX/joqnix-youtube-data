[{"type": "subtitle", "time": 20762.35, "timestamp": "05:46:02", "text": "[音楽]"}, {"type": "subtitle", "time": 20764.59, "timestamp": "05:46:04", "text": "ここ。"}, {"type": "subtitle", "time": 20766.788, "timestamp": "05:46:06", "text": "ハイライト。彼らに会ってみよう。つまり、今彼らは"}, {"type": "subtitle", "time": 20768.67, "timestamp": "05:46:08", "text": "リプレイを見る"}, {"type": "subtitle", "time": 20777.43, "timestamp": "05:46:17", "text": "読み込みを待ちましょう。ええ、リプレイがあります"}, {"type": "subtitle", "time": 20779.628, "timestamp": "05:46:19", "text": "システム。あなたはできる"}, {"type": "subtitle", "time": 20781.39, "timestamp": "05:46:21", "text": "のように"}, {"type": "subtitle", "time": 20790.31, "timestamp": "05:46:30", "text": "もの。すごくクールなゲームプレイ。ああ、それは"}, {"type": "subtitle", "time": 20792.51, "timestamp": "05:46:32", "text": "あなた"}, {"type": "subtitle", "time": 20819.07, "timestamp": "05:46:59", "text": "何てことだ。どうやって手に入れたの？"}]
[{"type": "subtitle", "time": 25864.708, "timestamp": "07:11:04", "text": "あれ？すべてロック解除。わかった。できれば"}, {"type": "subtitle", "time": 25867.35, "timestamp": "07:11:07", "text": "時間内にやってください、少ししか残っていないので"}, {"type": "subtitle", "time": 25869.948, "timestamp": "07:11:09", "text": "あと数日残っています。"}, {"type": "subtitle", "time": 25882.07, "timestamp": "07:11:22", "text": "何？このイベントは"}, {"type": "subtitle", "time": 25883.788, "timestamp": "07:11:23", "text": "ゲームは本当に"}, {"type": "subtitle", "time": 25894.82, "timestamp": "07:11:34", "text": "おお"}, {"type": "subtitle", "time": 25901.19, "timestamp": "07:11:41", "text": "男の子。店。さて、どんなアイテムがあるのか​​気になります。"}, {"type": "subtitle", "time": 25902.868, "timestamp": "07:11:42", "text": "そこにあります。私はこれがそこにあることを知っています、"}, {"type": "subtitle", "time": 25905.91, "timestamp": "07:11:45", "text": "でも、私にはわからない。ああ、私は"}, {"type": "subtitle", "time": 25907.75, "timestamp": "07:11:47", "text": "過ごす"}, {"type": "subtitle", "time": 25911.23, "timestamp": "07:11:51", "text": "えっと、1600個です。"}, {"type": "subtitle", "time": 25914.67, "timestamp": "07:11:54", "text": "2,000。ああ、それは"}, {"type": "subtitle", "time": 25917.83, "timestamp": "07:11:57", "text": "多く。おお。"}]
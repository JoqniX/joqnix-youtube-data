[{"type": "subtitle", "time": 15661.75, "timestamp": "04:21:01", "text": "死ぬのが怖い。あと1勝が必要だ"}, {"type": "subtitle", "time": 15663.91, "timestamp": "04:21:03", "text": "これを完了するために。これを完了するにはどうすればいいですか？"}, {"type": "subtitle", "time": 15668.229, "timestamp": "04:21:08", "text": "男？これだよ。完全にではないことがわかります"}, {"type": "subtitle", "time": 15670.03, "timestamp": "04:21:10", "text": "終了した。なぜ？なぜ私にはできないのか"}, {"type": "subtitle", "time": 15693.309, "timestamp": "04:21:33", "text": "これらがあります"}, {"type": "subtitle", "time": 15711.189, "timestamp": "04:21:51", "text": "[音楽]"}, {"type": "subtitle", "time": 15713.95, "timestamp": "04:21:53", "text": "ああ、このスキンは無料で手に入るよ。"}]
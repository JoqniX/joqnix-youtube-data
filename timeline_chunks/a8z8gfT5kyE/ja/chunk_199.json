[{"type": "subtitle", "time": 11959.67, "timestamp": "03:19:19", "text": "えっと、彼らは私に優しくしてくれたし、"}, {"type": "subtitle", "time": 11964.07, "timestamp": "03:19:24", "text": "過去2022年から、私が"}, {"type": "subtitle", "time": 11967.03, "timestamp": "03:19:27", "text": "いいえ、彼らは私のところに来ました。"}, {"type": "subtitle", "time": 11968.87, "timestamp": "03:19:28", "text": "私はインド人のユーチューバーで、"}, {"type": "subtitle", "time": 11969.95, "timestamp": "03:19:29", "text": "[音楽]"}, {"type": "subtitle", "time": 11970.98, "timestamp": "03:19:30", "text": "すべて"}, {"type": "subtitle", "time": 11973.79, "timestamp": "03:19:33", "text": "[音楽]"}, {"type": "subtitle", "time": 11979.51, "timestamp": "03:19:39", "text": "いろいろあるけど、ちょっと変な感じ。理由はわからないけど。"}, {"type": "subtitle", "time": 11981.87, "timestamp": "03:19:41", "text": "それはそういうことだ、私はただ"}, {"type": "subtitle", "time": 11986.229, "timestamp": "03:19:46", "text": "がっかりした。ちょっとがっかりしただけだ。"}, {"type": "subtitle", "time": 11990.469, "timestamp": "03:19:50", "text": "一般的に、このように学ぶと"}, {"type": "subtitle", "time": 11993.429, "timestamp": "03:19:53", "text": "話は、ただ招待したかっただけです"}, {"type": "subtitle", "time": 11996.95, "timestamp": "03:19:56", "text": "彼ら。だから、私はただ「こんにちは」と言っただけです。"}]
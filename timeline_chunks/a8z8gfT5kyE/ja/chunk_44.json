[{"type": "subtitle", "time": 2655.23, "timestamp": "00:44:15", "text": "変化。こんにちは、またお会いしましたね。初めてではない"}, {"type": "subtitle", "time": 2658.67, "timestamp": "00:44:18", "text": "人間のために作られた。それは強調する"}, {"type": "subtitle", "time": 2663.27, "timestamp": "00:44:23", "text": "チームワークは、私たち人間とは全く異なる。うわぁ、ブー"}, {"type": "subtitle", "time": 2665.109, "timestamp": "00:44:25", "text": "ここ。ここ。"}, {"type": "subtitle", "time": 2677.829, "timestamp": "00:44:37", "text": "押せ。押す。くそっ。そうそう。うん。"}]
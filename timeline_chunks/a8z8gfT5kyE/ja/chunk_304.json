[{"type": "subtitle", "time": 18240.708, "timestamp": "05:04:00", "text": "来るよ。今行ってる。今行ってる。神様、私は"}, {"type": "subtitle", "time": 18288.11, "timestamp": "05:04:48", "text": "選択。また、これは、赤い"}, {"type": "subtitle", "time": 18291.35, "timestamp": "05:04:51", "text": "このキャラクターの赤いフードのスキン。行く"}, {"type": "subtitle", "time": 18299.67, "timestamp": "05:04:59", "text": "このキャラクターは防御力が非常に高い。"}]
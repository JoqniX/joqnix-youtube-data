[{"type": "subtitle", "time": 7504.189, "timestamp": "02:05:04", "text": "そうそう。うん。それから、えーと1つ目"}, {"type": "subtitle", "time": 7510.91, "timestamp": "02:05:10", "text": "落ち着いて"}, {"type": "subtitle", "time": 7527.229, "timestamp": "02:05:27", "text": "誰だか知ってる？"}, {"type": "subtitle", "time": 7532.149, "timestamp": "02:05:32", "text": "ダンス？ああ、ちっちゃなやつ。人間、それは"}, {"type": "subtitle", "time": 7533.75, "timestamp": "02:05:33", "text": "今のあなたの姿。どこ"}, {"type": "subtitle", "time": 7546.33, "timestamp": "02:05:46", "text": "おお。真実だと思うのは"}]
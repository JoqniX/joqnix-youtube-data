[{"type": "subtitle", "time": 14041.55, "timestamp": "03:54:01", "text": "ピストルの方が良い"}, {"type": "subtitle", "time": 14056.07, "timestamp": "03:54:16", "text": "ここは私が一番嫌いなエリアです。"}, {"type": "subtitle", "time": 14057.63, "timestamp": "03:54:17", "text": "登ることができない"}, {"type": "subtitle", "time": 14060.79, "timestamp": "03:54:20", "text": "そこには。誰かに手伝ってもらう必要があります"}, {"type": "subtitle", "time": 14063.03, "timestamp": "03:54:23", "text": "風と共に。いくつか忘れてしまった"}, {"type": "subtitle", "time": 14065.189, "timestamp": "03:54:25", "text": "キャラクターは、"}, {"type": "subtitle", "time": 14068.269, "timestamp": "03:54:28", "text": "風のやつ。それが唯一の方法だ"}, {"type": "subtitle", "time": 14072.469, "timestamp": "03:54:32", "text": "上。私は壁をよじ登ることはできない。それで、"}, {"type": "subtitle", "time": 14074.71, "timestamp": "03:54:34", "text": "他に何か？"}, {"type": "subtitle", "time": 14076.469, "timestamp": "03:54:36", "text": "私は授業を受けます。さよなら。見る"}, {"type": "subtitle", "time": 14078.75, "timestamp": "03:54:38", "text": "あなた。良い配信を。こんにちは。感謝"}, {"type": "subtitle", "time": 14082.55, "timestamp": "03:54:42", "text": "あなた。 Dさん、お立ち寄りいただきありがとうございます。"}]
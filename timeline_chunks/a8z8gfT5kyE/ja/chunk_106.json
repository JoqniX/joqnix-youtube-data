[{"type": "subtitle", "time": 6361.83, "timestamp": "01:46:01", "text": "[音楽]"}, {"type": "subtitle", "time": 6370.31, "timestamp": "01:46:10", "text": "あ、あそこにジャンプして。私がキャッチします。"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "うん。ああ、そうだね。はい。はい。そうそう。うん。"}, {"type": "subtitle", "time": 6392.87, "timestamp": "01:46:32", "text": "やったね。"}, {"type": "subtitle", "time": 6395.35, "timestamp": "01:46:35", "text": "ナイスプレー。"}, {"type": "subtitle", "time": 6396.95, "timestamp": "01:46:36", "text": "ニース。"}, {"type": "subtitle", "time": 6408.03, "timestamp": "01:46:48", "text": "女の子。あなたはとても"}, {"type": "subtitle", "time": 6415.43, "timestamp": "01:46:55", "text": "私は薬を飲んでいるから強いんです。"}, {"type": "subtitle", "time": 6416.95, "timestamp": "01:46:56", "text": "私があなたに言ったことを覚えていますか、あなたは"}, {"type": "subtitle", "time": 6419.189, "timestamp": "01:46:59", "text": "校正に合格した唯一の被験者"}]
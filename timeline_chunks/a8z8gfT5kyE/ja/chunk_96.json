[{"type": "subtitle", "time": 5763.27, "timestamp": "01:36:03", "text": "行く。行く。うん。そして階下で撮影する"}, {"type": "subtitle", "time": 5765.35, "timestamp": "01:36:05", "text": "空のやつ。"}, {"type": "subtitle", "time": 5793.75, "timestamp": "01:36:33", "text": "ああ。来る。素晴らしい仕事ぶりです。セーフティキューブ"}, {"type": "subtitle", "time": 5797.38, "timestamp": "01:36:37", "text": "容器。あなたはそうするべきです"}, {"type": "subtitle", "time": 5798.709, "timestamp": "01:36:38", "text": "[音楽]"}, {"type": "subtitle", "time": 5801.669, "timestamp": "01:36:41", "text": "あなたは私を怒らせる。"}]
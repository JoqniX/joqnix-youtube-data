[{"type": "subtitle", "time": 15257.309, "timestamp": "04:14:17", "text": "こんにちは。私はこれを知りませんでした。いいえ"}, {"type": "subtitle", "time": 15260.51, "timestamp": "04:14:20", "text": "心配事。えっと、私は"}, {"type": "subtitle", "time": 15263.51, "timestamp": "04:14:23", "text": "行くよ。こんにちは。気をつけて。ありがとうございます"}, {"type": "subtitle", "time": 15264.51, "timestamp": "04:14:24", "text": "落とす"}, {"type": "subtitle", "time": 15268.03, "timestamp": "04:14:28", "text": "による。本当に嬉しい"}, {"type": "subtitle", "time": 15270.189, "timestamp": "04:14:30", "text": "あなたのまだ"}, {"type": "subtitle", "time": 15273.55, "timestamp": "04:14:33", "text": "覚えているよ、彼が来たんだ。感謝"}, {"type": "subtitle", "time": 15276.229, "timestamp": "04:14:36", "text": "あなたも、お元気で。きっと"}, {"type": "subtitle", "time": 15294.91, "timestamp": "04:14:54", "text": "それ？私は"}, {"type": "subtitle", "time": 15296.83, "timestamp": "04:14:56", "text": "来るよ。"}, {"type": "subtitle", "time": 15299.75, "timestamp": "04:14:59", "text": "ああ、もう少しキルが必要だ"}]
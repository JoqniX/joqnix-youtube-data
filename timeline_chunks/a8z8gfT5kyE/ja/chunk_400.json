[{"type": "subtitle", "time": 24009.43, "timestamp": "06:40:09", "text": "刀。彼らはあなたをその過程に導いてくれるでしょう"}, {"type": "subtitle", "time": 24025.99, "timestamp": "06:40:25", "text": "今気づいた。いや、違う。私は親切です"}, {"type": "subtitle", "time": 24047.91, "timestamp": "06:40:47", "text": "ピーピー。待って、何時"}, {"type": "subtitle", "time": 24050.468, "timestamp": "06:40:50", "text": "「ウィザリング・ガールズ」がまた出てくるの？私は"}, {"type": "subtitle", "time": 24053.35, "timestamp": "06:40:53", "text": "それをストリーミングする必要がある？私は何も作らなかった"}, {"type": "subtitle", "time": 24054.948, "timestamp": "06:40:54", "text": "サムネイルとか、そういうもの。まるで"}, {"type": "subtitle", "time": 24057.27, "timestamp": "06:40:57", "text": "真夜中ですよね？いいえ、午前7時です。ああ、そうです。"}, {"type": "subtitle", "time": 24058.43, "timestamp": "06:40:58", "text": "7時30分"}, {"type": "subtitle", "time": 24059.948, "timestamp": "06:40:59", "text": "午前。"}]
[{"type": "subtitle", "time": 27421.03, "timestamp": "07:37:01", "text": "それがイベントの課題です"}, {"type": "subtitle", "time": 27422.468, "timestamp": "07:37:02", "text": "ウィザリングホイールズは今そこにあります。それで、"}, {"type": "subtitle", "time": 27424.628, "timestamp": "07:37:04", "text": "明日私は枯れてしまうだろう"}, {"type": "subtitle", "time": 27426.59, "timestamp": "07:37:06", "text": "泣き叫ぶ。"}, {"type": "subtitle", "time": 27430.15, "timestamp": "07:37:10", "text": "ええ、そうですね。泣き叫んではいない。枯れる。うん。"}, {"type": "subtitle", "time": 27432.548, "timestamp": "07:37:12", "text": "萎縮したような手振り。"}, {"type": "subtitle", "time": 27449.43, "timestamp": "07:37:29", "text": "楽しい。ああ、このガキめ。どうやって起きたの？"}, {"type": "subtitle", "time": 27451.91, "timestamp": "07:37:31", "text": "どうやって起きたの？君をノックしたよ。どうやって"}, {"type": "subtitle", "time": 27454.11, "timestamp": "07:37:34", "text": "起きましたか？"}, {"type": "subtitle", "time": 27458.67, "timestamp": "07:37:38", "text": "何？どうやって起きたの？"}]
[{"type": "subtitle", "time": 13260.63, "timestamp": "03:41:00", "text": "このゲーム、この紙を手に入れた"}, {"type": "subtitle", "time": 13262.83, "timestamp": "03:41:02", "text": "こんな感じのもの。避けることができます"}, {"type": "subtitle", "time": 13265.75, "timestamp": "03:41:05", "text": "弾丸のように撃ちにくい"}, {"type": "subtitle", "time": 13269.19, "timestamp": "03:41:09", "text": "これを撃ってみてもいいけど、それでもこれは良い"}, {"type": "subtitle", "time": 13271.59, "timestamp": "03:41:11", "text": "位置調整ですが、私はこれを使用しません。私は"}, {"type": "subtitle", "time": 13276.03, "timestamp": "03:41:16", "text": "もっと知りたいのですが、どうすればいいですか？"}, {"type": "subtitle", "time": 13281.469, "timestamp": "03:41:21", "text": "そういう類のことです。えっと、何ですか"}, {"type": "subtitle", "time": 13289.03, "timestamp": "03:41:29", "text": "ああ、もうすっかり温まっているはずだ。私はプレイしました"}, {"type": "subtitle", "time": 13291.99, "timestamp": "03:41:31", "text": "午前中に。くそっ。ええ、プレイしました"}, {"type": "subtitle", "time": 13294.79, "timestamp": "03:41:34", "text": "午前中に。キャンセル。いいえ、キャンセルしないでください"}, {"type": "subtitle", "time": 13295.87, "timestamp": "03:41:35", "text": "自分。"}, {"type": "subtitle", "time": 13305.67, "timestamp": "03:41:45", "text": "いいえ。"}, {"type": "subtitle", "time": 13309.63, "timestamp": "03:41:49", "text": "私はスモークグレネードを頻繁に使うようになった"}, {"type": "subtitle", "time": 13313.269, "timestamp": "03:41:53", "text": "実は。そして時々、いや、時々私は"}, {"type": "subtitle", "time": 13316.67, "timestamp": "03:41:56", "text": "良いプレーを。時々、私はゴミみたいなプレイをする。"}]
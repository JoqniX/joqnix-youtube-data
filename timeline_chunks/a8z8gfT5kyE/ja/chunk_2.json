[{"type": "subtitle", "time": 121.19, "timestamp": "00:02:01", "text": "ジョス。いいえ、日本語で話します"}, {"type": "subtitle", "time": 123.749, "timestamp": "00:02:03", "text": "実は。そこで、Nihongo Josu は試してみます"}, {"type": "subtitle", "time": 126.63, "timestamp": "00:02:06", "text": "私たちの最善。彼女は私に日本語を教えてくれるでしょう"}, {"type": "subtitle", "time": 129.029, "timestamp": "00:02:09", "text": "韓国語も話せるので、私も最善を尽くします"}, {"type": "subtitle", "time": 132.11, "timestamp": "00:02:12", "text": "韓国語を少し話してください。私はGoogleから学ぶ"}, {"type": "subtitle", "time": 134.75, "timestamp": "00:02:14", "text": "翻訳もその他すべて。そう、私は"}, {"type": "subtitle", "time": 137.91, "timestamp": "00:02:17", "text": "興奮した。みんな、ワクワクしてるよ。さあ、やってみよう"}, {"type": "subtitle", "time": 140.15, "timestamp": "00:02:20", "text": "最高。"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "今週末、私はあなたとあなたの"}, {"type": "subtitle", "time": 144.22899999999998, "timestamp": "00:02:24", "text": "ご希望であれば、IOTAで友達を作りましょう。えっと、これ"}, {"type": "subtitle", "time": 146.55, "timestamp": "00:02:26", "text": "週末は予定がいっぱいだよ。えっと、今週末"}, {"type": "subtitle", "time": 149.67000000000002, "timestamp": "00:02:29", "text": "予約がいっぱいです。予約済みという意味で、"}, {"type": "subtitle", "time": 151.99, "timestamp": "00:02:31", "text": "他の人とコラボレーションする。問題は"}, {"type": "subtitle", "time": 155.27, "timestamp": "00:02:35", "text": "私はすべての人々と協力しようとしています"}, {"type": "subtitle", "time": 159.50900000000001, "timestamp": "00:02:39", "text": "私が出会ったYouTuberの友人やクリエイターたち"}, {"type": "subtitle", "time": 162.07, "timestamp": "00:02:42", "text": "5年間の旅の中で"}, {"type": "subtitle", "time": 164.63, "timestamp": "00:02:44", "text": "YouTuber。次に日本に行く前に"}, {"type": "subtitle", "time": 167.43, "timestamp": "00:02:47", "text": "来月、来々月、私はクリアしたい"}, {"type": "subtitle", "time": 170.63, "timestamp": "00:02:50", "text": "私がこれまで携わってきたコラボレーションの中で"}, {"type": "subtitle", "time": 173.82999999999998, "timestamp": "00:02:53", "text": "連絡を取って招待した"}, {"type": "subtitle", "time": 177.19, "timestamp": "00:02:57", "text": "人々が入ってくるように。それで私は外に出て、"}]
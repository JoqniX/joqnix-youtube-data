[{"type": "subtitle", "time": 16400.67, "timestamp": "04:33:20", "text": "うん。こんにちは、ソロSさん。いらっしゃいませ。"}, {"type": "subtitle", "time": 16403.269, "timestamp": "04:33:23", "text": "いらっしゃいませ。元気ですか？元気です。"}, {"type": "subtitle", "time": 16405.269, "timestamp": "04:33:25", "text": "お元気でお過ごしでしょうか。それは"}, {"type": "subtitle", "time": 16406.99, "timestamp": "04:33:26", "text": "その間。"}, {"type": "subtitle", "time": 16411.99, "timestamp": "04:33:31", "text": "お元気でお過ごしでしょうか。こんにちは。"}, {"type": "subtitle", "time": 16413.75, "timestamp": "04:33:33", "text": "後から参加してもいいですか？うん。ええ、もちろんです。"}, {"type": "subtitle", "time": 16416.029, "timestamp": "04:33:36", "text": "もちろん。あなたはできる。君たちも参加できるよ。"}, {"type": "subtitle", "time": 16419.709, "timestamp": "04:33:39", "text": "うん、パブパブで遊ぶことになると思うよ。"}, {"type": "subtitle", "time": 16422.709, "timestamp": "04:33:42", "text": "おそらくランク戦をプレイしたいのですが、"}, {"type": "subtitle", "time": 16425.83, "timestamp": "04:33:45", "text": "ランク戦はあまりやりたくないんです。"}, {"type": "subtitle", "time": 16429.429, "timestamp": "04:33:49", "text": "私は普段、ゲームをやり込むようなことはしません。私はただ遊ぶだけです"}, {"type": "subtitle", "time": 16432.949, "timestamp": "04:33:52", "text": "楽しむために。さて、もし私が本当に"}, {"type": "subtitle", "time": 16435.789, "timestamp": "04:33:55", "text": "grさん、私がやります。でも今は、"}, {"type": "subtitle", "time": 16439.91, "timestamp": "04:33:59", "text": "ただ好きなゲームをしてのんびりするだけ"}]
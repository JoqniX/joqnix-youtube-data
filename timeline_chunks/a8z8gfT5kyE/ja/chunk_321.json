[{"type": "subtitle", "time": 19274.708, "timestamp": "05:21:14", "text": "わかった。待って、やろうよ いや、私はまだ"}, {"type": "subtitle", "time": 19284.708, "timestamp": "05:21:24", "text": "えっと、待って。もっと頻繁に。あなたはああ、"}, {"type": "subtitle", "time": 19287.788, "timestamp": "05:21:27", "text": "待って、待って、待って。キャンセルするにはどうすればいいですか？"}, {"type": "subtitle", "time": 19290.39, "timestamp": "05:21:30", "text": "ああ、お願いです。お願いします。最後の一人。"}, {"type": "subtitle", "time": 19292.55, "timestamp": "05:21:32", "text": "入るな。絶対に、やめるな。しないで"}, {"type": "subtitle", "time": 19295.51, "timestamp": "05:21:35", "text": "やってみて。やめてください。やめてください。しないで"}, {"type": "subtitle", "time": 19297.99, "timestamp": "05:21:37", "text": "やってみて。やめてください。触らせてください。"}, {"type": "subtitle", "time": 19299.708, "timestamp": "05:21:39", "text": "しないでください"}, {"type": "subtitle", "time": 19303.07, "timestamp": "05:21:43", "text": "それ。やめてください。"}, {"type": "subtitle", "time": 19305.55, "timestamp": "05:21:45", "text": "完了していません。"}, {"type": "subtitle", "time": 19309.67, "timestamp": "05:21:49", "text": "はい。ああ。えーっと、１、２、３、４、"}, {"type": "subtitle", "time": 19311.07, "timestamp": "05:21:51", "text": "五。これ"}, {"type": "subtitle", "time": 19315.788, "timestamp": "05:21:55", "text": "1つ。何？ああ、順番待ちですね。"}, {"type": "subtitle", "time": 19317.55, "timestamp": "05:21:57", "text": "わかった。これ"}]
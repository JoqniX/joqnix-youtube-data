[{"type": "subtitle", "time": 5401.39, "timestamp": "01:30:01", "text": "[音楽]"}, {"type": "subtitle", "time": 5403.629, "timestamp": "01:30:03", "text": "知る。何"}, {"type": "subtitle", "time": 5418.47, "timestamp": "01:30:18", "text": "あ、こんにちは。"}, {"type": "subtitle", "time": 5426.55, "timestamp": "01:30:26", "text": "そして否定しなければならなかった。えっと。なんてこった。いや、いや、いや、"}, {"type": "subtitle", "time": 5429.87, "timestamp": "01:30:29", "text": "いいえ。おお、"}, {"type": "subtitle", "time": 5432.99, "timestamp": "01:30:32", "text": "なぜ？ああ、何だって。ああ、わかった。わかった。わかった。"}, {"type": "subtitle", "time": 5443.59, "timestamp": "01:30:43", "text": "彼は待った。あ、ちょっと待って。私"}]
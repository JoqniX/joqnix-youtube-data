[{"type": "subtitle", "time": 10625.95, "timestamp": "02:57:05", "text": "それ。えっと"}, {"type": "subtitle", "time": 10631.03, "timestamp": "02:57:11", "text": "うん。ああ、そして私は、私たちがもっと"}, {"type": "subtitle", "time": 10635.67, "timestamp": "02:57:15", "text": "私自身も話すことに夢中になっています"}, {"type": "subtitle", "time": 10637.99, "timestamp": "02:57:17", "text": "日本語、"}, {"type": "subtitle", "time": 10641.269, "timestamp": "02:57:21", "text": "ええと、私はもっと良くなれるでしょうし、"}, {"type": "subtitle", "time": 10644.309, "timestamp": "02:57:24", "text": "コラボできたらいいな"}, {"type": "subtitle", "time": 10648.71, "timestamp": "02:57:28", "text": "将来また中国語を勉強します"}, {"type": "subtitle", "time": 10653.349, "timestamp": "02:57:33", "text": "非ゴーモードのみを使用してください。英語なし 英語"}, {"type": "subtitle", "time": 10654.11, "timestamp": "02:57:34", "text": "だった"}, {"type": "subtitle", "time": 10658.349, "timestamp": "02:57:38", "text": "禁止されているもののみ。私は自分のためだけにそうします"}, {"type": "subtitle", "time": 10662.75, "timestamp": "02:57:42", "text": "側。うん、それが待ち遠しいよ"}, {"type": "subtitle", "time": 10666.51, "timestamp": "02:57:46", "text": "日。その日のために、私は勉強します"}, {"type": "subtitle", "time": 10670.71, "timestamp": "02:57:50", "text": "難しい。私は一生懸命勉強します。私は勉強します"}]
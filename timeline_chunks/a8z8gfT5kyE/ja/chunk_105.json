[{"type": "subtitle", "time": 6305.95, "timestamp": "01:45:05", "text": "どこ？"}, {"type": "subtitle", "time": 6333.04, "timestamp": "01:45:33", "text": "二。"}, {"type": "subtitle", "time": 6342.669, "timestamp": "01:45:42", "text": "普段は乗り物酔いを感じるのですが"}, {"type": "subtitle", "time": 6347.35, "timestamp": "01:45:47", "text": "時代を超越したジャンプ"}, {"type": "subtitle", "time": 6349.43, "timestamp": "01:45:49", "text": "しかし"}, {"type": "subtitle", "time": 6352.79, "timestamp": "01:45:52", "text": "薬を飲むことで、その感覚を味わえるんです。"}]
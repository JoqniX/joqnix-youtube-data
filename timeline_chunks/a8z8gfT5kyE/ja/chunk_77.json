[{"type": "subtitle", "time": 4624.47, "timestamp": "01:17:04", "text": "[音楽]"}, {"type": "subtitle", "time": 4628.229, "timestamp": "01:17:08", "text": "君のことを悪く言うことはできない。"}, {"type": "subtitle", "time": 4657.709, "timestamp": "01:17:37", "text": "ああ、わかりました。わかった。わかった。"}, {"type": "subtitle", "time": 4665.47, "timestamp": "01:17:45", "text": "ピカチュウ。こんにちは。それで、"}, {"type": "subtitle", "time": 4667.39, "timestamp": "01:17:47", "text": "そこには"}, {"type": "subtitle", "time": 4671.87, "timestamp": "01:17:51", "text": "さあ、ピカチュウ、行くよ。え、何？"}, {"type": "subtitle", "time": 4674.87, "timestamp": "01:17:54", "text": "水。いや、いや、いや。"}, {"type": "subtitle", "time": 4676.71, "timestamp": "01:17:56", "text": "あ、こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 4678.75, "timestamp": "01:17:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 6062.189, "timestamp": "01:41:02", "text": "おお。なぜなら私はできるから私はしなかった"}, {"type": "subtitle", "time": 6070.109, "timestamp": "01:41:10", "text": "[音楽]"}, {"type": "subtitle", "time": 6080.55, "timestamp": "01:41:20", "text": "私が一人で遊んでいた時は"}, {"type": "subtitle", "time": 6082.79, "timestamp": "01:41:22", "text": "楽しくない。どれだけ良くなったか見てください"}, {"type": "subtitle", "time": 6085.35, "timestamp": "01:41:25", "text": "あなたは"}, {"type": "subtitle", "time": 6098.229, "timestamp": "01:41:38", "text": "本当に？"}]
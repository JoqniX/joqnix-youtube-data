[{"type": "subtitle", "time": 13141.83, "timestamp": "03:39:01", "text": "彼女とプレイすると、エイミングの点で良いプレイができます"}, {"type": "subtitle", "time": 13146.15, "timestamp": "03:39:06", "text": "などなど。実は、時々そうするんです。"}, {"type": "subtitle", "time": 13149.07, "timestamp": "03:39:09", "text": "わかった。私は遊ぶ"}, {"type": "subtitle", "time": 13153.67, "timestamp": "03:39:13", "text": "良い。でも、あの女性のことね、つまり、えっと"}, {"type": "subtitle", "time": 13156.71, "timestamp": "03:39:16", "text": "ありがとう。えっと、待ってて。私はそれを"}, {"type": "subtitle", "time": 13160.07, "timestamp": "03:39:20", "text": "慰めてくれる女性。名前を忘れてしまった。 O"}, {"type": "subtitle", "time": 13161.75, "timestamp": "03:39:21", "text": "全く分からない。あ、待って。ありがとうございます"}, {"type": "subtitle", "time": 13163.63, "timestamp": "03:39:23", "text": "念のため。"}, {"type": "subtitle", "time": 13166.55, "timestamp": "03:39:26", "text": "ああ、思い出させてくれてありがとう。うん、そうだね"}, {"type": "subtitle", "time": 13169.269, "timestamp": "03:39:29", "text": "あなたが行く。"}, {"type": "subtitle", "time": 13173.19, "timestamp": "03:39:33", "text": "ついに音声が聞こえるかもしれません"}, {"type": "subtitle", "time": 13192.03, "timestamp": "03:39:52", "text": "ベーコン。"}, {"type": "subtitle", "time": 13198.03, "timestamp": "03:39:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 360.749, "timestamp": "00:06:00", "text": "ほら、私がツイートを取り消したことはみんな知ってるでしょ。私も"}, {"type": "subtitle", "time": 364.43, "timestamp": "00:06:04", "text": "ルナがここにいると述べられています。ラ"}, {"type": "subtitle", "time": 370.83, "timestamp": "00:06:10", "text": "ラーン。私は"}, {"type": "subtitle", "time": 374.23, "timestamp": "00:06:14", "text": "そこには。私はそこにいた。何てことだ。彼女は"}, {"type": "subtitle", "time": 375.95, "timestamp": "00:06:15", "text": "私の写真がそこにあります。"}, {"type": "subtitle", "time": 379.749, "timestamp": "00:06:19", "text": "ありがとうございます。彼女は実際に"}, {"type": "subtitle", "time": 382.15, "timestamp": "00:06:22", "text": "ストリームしてそこに画像を配置して"}, {"type": "subtitle", "time": 385.51, "timestamp": "00:06:25", "text": "私も「ああ、なんてことだ」と思いました。彼女はとても"}, {"type": "subtitle", "time": 387.95, "timestamp": "00:06:27", "text": "甘い。感謝"}, {"type": "subtitle", "time": 390.55, "timestamp": "00:06:30", "text": "あなた。昨日は楽しいコラボレーションでした。"}, {"type": "subtitle", "time": 393.83, "timestamp": "00:06:33", "text": "リーパー1。技術的にはハリソンは私の"}, {"type": "subtitle", "time": 397.029, "timestamp": "00:06:37", "text": "ある意味、日本とのコラボレーションは初めて"}, {"type": "subtitle", "time": 399.71, "timestamp": "00:06:39", "text": "だって本当に"}, {"type": "subtitle", "time": 401.30899999999997, "timestamp": "00:06:41", "text": "楽しい。"}, {"type": "subtitle", "time": 404.71, "timestamp": "00:06:44", "text": "こんにちは。ツイートを正しく投稿しないと。"}, {"type": "subtitle", "time": 411.39, "timestamp": "00:06:51", "text": "ああ、そうしてください。"}]
[{"type": "subtitle", "time": 3784.27, "timestamp": "01:03:04", "text": "何？遠くへ行かないでください。"}, {"type": "subtitle", "time": 3786.349, "timestamp": "01:03:06", "text": "うん。"}, {"type": "subtitle", "time": 3812.87, "timestamp": "01:03:32", "text": "ああ、ここにいるよ。おお。おお、いいね。押す。押す。"}, {"type": "subtitle", "time": 3820.789, "timestamp": "01:03:40", "text": "押す。おお。行く。行く。君は私を殺したんだ。あなた"}, {"type": "subtitle", "time": 3823.829, "timestamp": "01:03:43", "text": "殺された。"}, {"type": "subtitle", "time": 3825.95, "timestamp": "01:03:45", "text": "行く。行く。行く。"}, {"type": "subtitle", "time": 3839.75, "timestamp": "01:03:59", "text": "私は毎日泣くでしょう。なんてこった。何てことだ。"}]
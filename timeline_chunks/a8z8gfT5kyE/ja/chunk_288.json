[{"type": "subtitle", "time": 17282.59, "timestamp": "04:48:02", "text": "近い。うん。こんにちは、キサさん。いらっしゃいませ。"}, {"type": "subtitle", "time": 17291.43, "timestamp": "04:48:11", "text": "こんにちは。えっと、待って、降伏したの？それとも"}, {"type": "subtitle", "time": 17296.708, "timestamp": "04:48:16", "text": "それはどうなる？ああ、私たちは道に迷ってしまったのでしょうか？はい。もっと。"}, {"type": "subtitle", "time": 17303.868, "timestamp": "04:48:23", "text": "男。ああ、それは"}, {"type": "subtitle", "time": 17306.23, "timestamp": "04:48:26", "text": "わかった。少なくとも私のバトルパスは"}, {"type": "subtitle", "time": 17308.19, "timestamp": "04:48:28", "text": "レベリング"}, {"type": "subtitle", "time": 17311.15, "timestamp": "04:48:31", "text": "上。尊敬。"}, {"type": "subtitle", "time": 17323.11, "timestamp": "04:48:43", "text": "ふむ。なぜロックしたんだろう。ああ、ロックしたんだ。"}, {"type": "subtitle", "time": 17324.59, "timestamp": "04:48:44", "text": "おお、"}, {"type": "subtitle", "time": 17327.628, "timestamp": "04:48:47", "text": "ニース。ああ、大変だ。ニース。"}, {"type": "subtitle", "time": 17331.39, "timestamp": "04:48:51", "text": "ニース。レベル40。"}, {"type": "subtitle", "time": 17334.83, "timestamp": "04:48:54", "text": "はぁ。これとこれも買います"}]
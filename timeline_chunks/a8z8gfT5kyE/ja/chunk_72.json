[{"type": "subtitle", "time": 4323.99, "timestamp": "01:12:03", "text": "ジョエル。全て"}, {"type": "subtitle", "time": 4343.91, "timestamp": "01:12:23", "text": "あなたはそうしているけれど、私はあなたにそうしてほしくない"}, {"type": "subtitle", "time": 4347.43, "timestamp": "01:12:27", "text": "停止。わかった。わかった。あなたたち二人は"}, {"type": "subtitle", "time": 4350.149, "timestamp": "01:12:30", "text": "優れたパートナーシップを築きました"}, {"type": "subtitle", "time": 4352.79, "timestamp": "01:12:32", "text": "あなたが知的な課題に対処する"}, {"type": "subtitle", "time": 4354.63, "timestamp": "01:12:34", "text": "そしてもう一方"}, {"type": "subtitle", "time": 4355.95, "timestamp": "01:12:35", "text": "よちよち歩きで"}, {"type": "subtitle", "time": 4365.709, "timestamp": "01:12:45", "text": "M."}, {"type": "subtitle", "time": 4367.84, "timestamp": "01:12:47", "text": "えっと"}]
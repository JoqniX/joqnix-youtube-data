[{"type": "subtitle", "time": 4279.51, "timestamp": "01:11:19", "text": "最初から何から？待って。"}, {"type": "subtitle", "time": 4289.75, "timestamp": "01:11:29", "text": "まあ、本当に？ああ、ここからですね。コンピューター。"}, {"type": "subtitle", "time": 4292.149, "timestamp": "01:11:32", "text": "うん。うん。うん。始まりではない。"}, {"type": "subtitle", "time": 4293.55, "timestamp": "01:11:33", "text": "主題調査"}, {"type": "subtitle", "time": 4296.07, "timestamp": "01:11:36", "text": "中心。でも、みんなで同意すればいいじゃないか"}, {"type": "subtitle", "time": 4298.83, "timestamp": "01:11:38", "text": "そこをハブと呼ぶべきだろうか？続けて。保つ"}, {"type": "subtitle", "time": 4303.55, "timestamp": "01:11:43", "text": "行くよ。中心地。ここから先は"}, {"type": "subtitle", "time": 4307.5, "timestamp": "01:11:47", "text": "行くよ。ハァ。"}]
[{"type": "subtitle", "time": 27662.708, "timestamp": "07:41:02", "text": "ミンと遊んでるの？すごく楽しいよ。"}, {"type": "subtitle", "time": 27665.19, "timestamp": "07:41:05", "text": "まるで私のショットが当たっているかのようだ"}, {"type": "subtitle", "time": 27667.388, "timestamp": "07:41:07", "text": "私は射撃とかそういうことをしているわけではありません。私はしません"}, {"type": "subtitle", "time": 27670.948, "timestamp": "07:41:10", "text": "知る。そういう雰囲気を感じる。しかし"}]
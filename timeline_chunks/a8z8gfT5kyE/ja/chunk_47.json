[{"type": "subtitle", "time": 2846.63, "timestamp": "00:47:26", "text": "私たちは扉を見つけて新しいものを作らなければならない"}, {"type": "subtitle", "time": 2848.23, "timestamp": "00:47:28", "text": "写真。"}, {"type": "subtitle", "time": 2850.79, "timestamp": "00:47:30", "text": "新しいポータル。えっと"}, {"type": "subtitle", "time": 2854.19, "timestamp": "00:47:34", "text": "こちらを改造してください。うん。うん。ここ。"}, {"type": "subtitle", "time": 2856.91, "timestamp": "00:47:36", "text": "おお。おお。わかった。"}, {"type": "subtitle", "time": 2859.43, "timestamp": "00:47:39", "text": "わかった。待って。"}, {"type": "subtitle", "time": 2868.43, "timestamp": "00:47:48", "text": "うん。ああ、おいおい"}, {"type": "subtitle", "time": 2871.75, "timestamp": "00:47:51", "text": "さあ、君。"}, {"type": "subtitle", "time": 2873.829, "timestamp": "00:47:53", "text": "ああ。"}, {"type": "subtitle", "time": 2876.47, "timestamp": "00:47:56", "text": "素晴らしい。偉大な科学は"}]
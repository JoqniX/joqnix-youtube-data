[{"type": "subtitle", "time": 26052.67, "timestamp": "07:14:12", "text": "撤去用地。待って、6元"}, {"type": "subtitle", "time": 26056.15, "timestamp": "07:14:16", "text": "トヤ。いくらですか？ 70ルピーです。"}, {"type": "subtitle", "time": 26058.59, "timestamp": "07:14:18", "text": "でもそれはとても"}, {"type": "subtitle", "time": 26062.39, "timestamp": "07:14:22", "text": "けれど。私はたくさんの試合に負けた。 6ドルではありません。"}, {"type": "subtitle", "time": 26065.75, "timestamp": "07:14:25", "text": "わかった。ええ、70くらいですよ。本当ですか？私"}]
[{"type": "subtitle", "time": 12606.11, "timestamp": "03:30:06", "text": "こんにちは。ええ、そうですね。えっと、昨日"}, {"type": "subtitle", "time": 12609.83, "timestamp": "03:30:09", "text": "混乱していたね？昨日は、"}, {"type": "subtitle", "time": 12611.15, "timestamp": "03:30:11", "text": "混沌とした、"}, {"type": "subtitle", "time": 12614.309, "timestamp": "03:30:14", "text": "右？でも大丈夫。昨日は"}, {"type": "subtitle", "time": 12617.54, "timestamp": "03:30:17", "text": "混沌としているけれど、すべて順調だ。良い。"}, {"type": "subtitle", "time": 12620.389, "timestamp": "03:30:20", "text": "[音楽]"}, {"type": "subtitle", "time": 12623.59, "timestamp": "03:30:23", "text": "えっと、実は歯磨き粉は全部手に入れたんだけど、"}, {"type": "subtitle", "time": 12626.15, "timestamp": "03:30:26", "text": "水、体から完全に排出された。それで、"}, {"type": "subtitle", "time": 12630.19, "timestamp": "03:30:30", "text": "私は大丈夫です。私は大丈夫です。"}, {"type": "subtitle", "time": 12638.229, "timestamp": "03:30:38", "text": "うん。あ、待って。始めるのを忘れていました"}, {"type": "subtitle", "time": 12640.99, "timestamp": "03:30:40", "text": "録音中。おお、"}, {"type": "subtitle", "time": 12643.429, "timestamp": "03:30:43", "text": "いいえ。実は始めるのを忘れていました"}, {"type": "subtitle", "time": 12646.469, "timestamp": "03:30:46", "text": "配信を録画しています。ああ、だから、わからない。"}, {"type": "subtitle", "time": 12649.11, "timestamp": "03:30:49", "text": "気付いたなら、昨日投稿した"}, {"type": "subtitle", "time": 12653.349, "timestamp": "03:30:53", "text": "Twitter、Facebook、Discordは私のエースです"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "ヴァレランスのクリップ、えーとヴァレリン"}, {"type": "subtitle", "time": 12659.469, "timestamp": "03:30:59", "text": "昨日コラボしました。"}]
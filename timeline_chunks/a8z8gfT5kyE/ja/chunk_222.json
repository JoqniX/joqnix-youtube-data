[{"type": "subtitle", "time": 13326.389, "timestamp": "03:42:06", "text": "[音楽]"}, {"type": "subtitle", "time": 13328.79, "timestamp": "03:42:08", "text": "よし、これは良さそうだ。うん、1つ"}, {"type": "subtitle", "time": 13336.63, "timestamp": "03:42:16", "text": "良い。ああ、これは辛い。そうしなければならなかった"}, {"type": "subtitle", "time": 13346.75, "timestamp": "03:42:26", "text": "ああ、そして"}, {"type": "subtitle", "time": 13349.95, "timestamp": "03:42:29", "text": "それを入れて"}, {"type": "subtitle", "time": 13368.03, "timestamp": "03:42:48", "text": "はい。右に40度。ああ、私は"}, {"type": "subtitle", "time": 13378.15, "timestamp": "03:42:58", "text": "理由。うん、そろそろウォーミングアップしないといけないな。"}]
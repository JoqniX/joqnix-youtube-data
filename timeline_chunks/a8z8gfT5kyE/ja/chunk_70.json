[{"type": "subtitle", "time": 4206.55, "timestamp": "01:10:06", "text": "うん。試合を続けよう。ああ、"}, {"type": "subtitle", "time": 4211.91, "timestamp": "01:10:11", "text": "ゲーマーのデモモーション。ええ、おっしゃる通り、"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "ええと、大丈夫です。まだ。まだ大丈夫です。"}, {"type": "subtitle", "time": 4218.47, "timestamp": "01:10:18", "text": "うん。うん。うん。開ける。"}, {"type": "subtitle", "time": 4221.03, "timestamp": "01:10:21", "text": "[音楽]"}, {"type": "subtitle", "time": 4226.43, "timestamp": "01:10:26", "text": "たった1時間前に飲んだばかりです。それで"}, {"type": "subtitle", "time": 4230.149, "timestamp": "01:10:30", "text": "たぶん1時間か1時間と"}, {"type": "subtitle", "time": 4251.03, "timestamp": "01:10:51", "text": "[音楽]"}, {"type": "subtitle", "time": 4258.35, "timestamp": "01:10:58", "text": "ゲーム。ええと、どなたでもご招待します。あなたを招待します。"}]
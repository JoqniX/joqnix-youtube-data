[{"type": "subtitle", "time": 19505.43, "timestamp": "05:25:05", "text": "わかった、あのね？買うべきでしょうか"}, {"type": "subtitle", "time": 19506.91, "timestamp": "05:25:06", "text": "でも私は"}, {"type": "subtitle", "time": 19510.47, "timestamp": "05:25:10", "text": "好きだけど、彼女を見て。彼女"}, {"type": "subtitle", "time": 19513.67, "timestamp": "05:25:13", "text": "かわいい。彼女はショートヘアですが、"}, {"type": "subtitle", "time": 19521.83, "timestamp": "05:25:21", "text": "こんにちは、えーと、イア。あなたの名前を正しく発音できましたか？"}, {"type": "subtitle", "time": 19524.99, "timestamp": "05:25:24", "text": "右？配信へようこ​​そ。こんにちは。"}, {"type": "subtitle", "time": 19527.27, "timestamp": "05:25:27", "text": "こんにちは。今日はどうやって私を見つけたの？そしてどのように"}, {"type": "subtitle", "time": 19530.07, "timestamp": "05:25:30", "text": "あなたは？でも、サメの女の子は"}, {"type": "subtitle", "time": 19533.51, "timestamp": "05:25:33", "text": "一つずつ購入してください。うん。これは"}, {"type": "subtitle", "time": 19537.35, "timestamp": "05:25:37", "text": "傷跡 右の傷跡、そして私はこれを知りません"}, {"type": "subtitle", "time": 19544.948, "timestamp": "05:25:44", "text": "良い。 Uh Joは、"}, {"type": "subtitle", "time": 19547.83, "timestamp": "05:25:47", "text": "ミニガンをエアソフトマットに持ち込む"}, {"type": "subtitle", "time": 19552.15, "timestamp": "05:25:52", "text": "ハローキティのデカールが貼ってあって、"}, {"type": "subtitle", "time": 19555.35, "timestamp": "05:25:55", "text": "アニメのコスプレ衣装。ああ、それはピューだ"}, {"type": "subtitle", "time": 19557.628, "timestamp": "05:25:57", "text": "ピューピューピュー"}]
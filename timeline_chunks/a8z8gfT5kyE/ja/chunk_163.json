[{"type": "subtitle", "time": 9783.87, "timestamp": "02:43:03", "text": "それ、私は"}, {"type": "subtitle", "time": 9787.51, "timestamp": "02:43:07", "text": "本当はもう寝ます。ない"}, {"type": "subtitle", "time": 9789.55, "timestamp": "02:43:09", "text": "寝る。ええと、私たちは"}, {"type": "subtitle", "time": 9792.469, "timestamp": "02:43:12", "text": "現在、コランドとのコラボレーションが行われています。私は置きたい"}, {"type": "subtitle", "time": 9795.389, "timestamp": "02:43:15", "text": "ランダムに"}, {"type": "subtitle", "time": 9797.59, "timestamp": "02:43:17", "text": "コラボレーション。ランダムな"}, {"type": "subtitle", "time": 9799.349, "timestamp": "02:43:19", "text": "コラボレーション。えっと、誰に"}, {"type": "subtitle", "time": 9800.91, "timestamp": "02:43:20", "text": "連絡を取る"}, {"type": "subtitle", "time": 9803.04, "timestamp": "02:43:23", "text": "に。"}, {"type": "subtitle", "time": 9811.19, "timestamp": "02:43:31", "text": "えっと、どう思いますか？えっと、私は"}, {"type": "subtitle", "time": 9812.429, "timestamp": "02:43:32", "text": "のように"}, {"type": "subtitle", "time": 9815.77, "timestamp": "02:43:35", "text": "えっと、"}, {"type": "subtitle", "time": 9830.96, "timestamp": "02:43:50", "text": "感謝"}, {"type": "subtitle", "time": 9833.95, "timestamp": "02:43:53", "text": "[音楽]"}]
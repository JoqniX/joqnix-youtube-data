[{"type": "subtitle", "time": 17770.23, "timestamp": "04:56:10", "text": "どうすればいいのですか？ゲーム内"}, {"type": "subtitle", "time": 17773.19, "timestamp": "04:56:13", "text": "コミュニケーション関連。キーワードは何ですか"}, {"type": "subtitle", "time": 17780.11, "timestamp": "04:56:20", "text": "おお、"}, {"type": "subtitle", "time": 17790.628, "timestamp": "04:56:30", "text": "自分自身。ここに、えっと、何をプレイする人がいるか"}, {"type": "subtitle", "time": 17792.948, "timestamp": "04:56:32", "text": "それ？"}, {"type": "subtitle", "time": 17799.43, "timestamp": "04:56:39", "text": "ええと、ガザ。ゲイとは何ですか？ええと、ガザ。"}, {"type": "subtitle", "time": 17801.19, "timestamp": "04:56:41", "text": "エーテル・ガザ。それはゲームですか？どのようなタイプですか？"}, {"type": "subtitle", "time": 17809.11, "timestamp": "04:56:49", "text": "ほら、その一つは今私が"}, {"type": "subtitle", "time": 17811.23, "timestamp": "04:56:51", "text": "好きになりたかった"}, {"type": "subtitle", "time": 17816.15, "timestamp": "04:56:56", "text": "Valerin Cenを実際にプレイして、どのように試すか"}, {"type": "subtitle", "time": 17818.07, "timestamp": "04:56:58", "text": "つまり、"}]
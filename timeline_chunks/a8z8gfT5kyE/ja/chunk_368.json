[{"type": "subtitle", "time": 22085.99, "timestamp": "06:08:05", "text": "わかった。キャプテンの声賞から"}, {"type": "subtitle", "time": 22087.43, "timestamp": "06:08:07", "text": "セカンダリーに切り替えることを覚えておいてください"}, {"type": "subtitle", "time": 22090.628, "timestamp": "06:08:10", "text": "は、私のセカンダリーよりも常に速い"}, {"type": "subtitle", "time": 22099.67, "timestamp": "06:08:19", "text": "私の第二の理由は、呪われているということです。"}, {"type": "subtitle", "time": 22100.83, "timestamp": "06:08:20", "text": "何？"}, {"type": "subtitle", "time": 22102.99, "timestamp": "06:08:22", "text": "なぜ？誰が？"}, {"type": "subtitle", "time": 22107.67, "timestamp": "06:08:27", "text": "なぜ？なぜ？誰があなたに夢中なの？"}]
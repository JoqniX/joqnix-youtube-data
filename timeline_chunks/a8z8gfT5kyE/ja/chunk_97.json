[{"type": "subtitle", "time": 5824.39, "timestamp": "01:37:04", "text": "その通り。彼女は私を押している。あなたは見ましたか"}, {"type": "subtitle", "time": 5825.68, "timestamp": "01:37:05", "text": "それ？"}, {"type": "subtitle", "time": 5827.109, "timestamp": "01:37:07", "text": "[音楽]"}, {"type": "subtitle", "time": 5836.47, "timestamp": "01:37:16", "text": "私はこれらが好きです"}, {"type": "subtitle", "time": 5839.43, "timestamp": "01:37:19", "text": "私の毎日の日記に。あらゆる方法"}, {"type": "subtitle", "time": 5847.59, "timestamp": "01:37:27", "text": "完璧な結果と"}, {"type": "subtitle", "time": 5868.629, "timestamp": "01:37:48", "text": "[音楽]"}]
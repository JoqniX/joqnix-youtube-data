[{"type": "subtitle", "time": 918.4, "timestamp": "00:15:18", "text": "今はキャラクターが多すぎるので、"}, {"type": "subtitle", "time": 935.91, "timestamp": "00:15:35", "text": "ちょっと待って。カイ、君は"}, {"type": "subtitle", "time": 939.949, "timestamp": "00:15:39", "text": "そう言ったよね？それで出会った"}, {"type": "subtitle", "time": 944.67, "timestamp": "00:15:44", "text": "リサは助けを求めたりできる。"}, {"type": "subtitle", "time": 946.75, "timestamp": "00:15:46", "text": "彼らがお互いを知っていること、または"}, {"type": "subtitle", "time": 950.069, "timestamp": "00:15:50", "text": "何か。しかし、これは"}, {"type": "subtitle", "time": 951.629, "timestamp": "00:15:51", "text": "の一部"}]
[{"type": "subtitle", "time": 13020.83, "timestamp": "03:37:00", "text": "君たち、Apexをプレイしてる？何？"}, {"type": "subtitle", "time": 13025.03, "timestamp": "03:37:05", "text": "はぁ？はぁ？待って。待って。 Apex Legendsはプレイできますか？"}, {"type": "subtitle", "time": 13026.349, "timestamp": "03:37:06", "text": "え、何？"}, {"type": "subtitle", "time": 13029.19, "timestamp": "03:37:09", "text": "いつ？待って。そうそう。ああ、そうだね。あなた"}, {"type": "subtitle", "time": 13033.11, "timestamp": "03:37:13", "text": "最近始めた。そうそう。私は覚えています"}, {"type": "subtitle", "time": 13035.03, "timestamp": "03:37:15", "text": "ああ、そうだね。待って、私たちはプレイしましたか？"}, {"type": "subtitle", "time": 13037.03, "timestamp": "03:37:17", "text": "一緒に、それとも私の記憶、それとも私の"}, {"type": "subtitle", "time": 13040.91, "timestamp": "03:37:20", "text": "夢？待って、私たちはプレイしたの？"}, {"type": "subtitle", "time": 13050.349, "timestamp": "03:37:30", "text": "待って、私たちはやったよ。私は確信しています"}, {"type": "subtitle", "time": 13053.19, "timestamp": "03:37:33", "text": "メモリ。だから私は書き続けるんだ"}, {"type": "subtitle", "time": 13056.349, "timestamp": "03:37:36", "text": "忘れないようにどこかに保管する"}, {"type": "subtitle", "time": 13061.07, "timestamp": "03:37:41", "text": "D. ええと、これは、いいえ、行かないでください"}, {"type": "subtitle", "time": 13067.87, "timestamp": "03:37:47", "text": "大きな"}, {"type": "subtitle", "time": 13070.79, "timestamp": "03:37:50", "text": "バグ。大きな車も手に入れました"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "あれ。ガチャを引いて、"}, {"type": "subtitle", "time": 13074.75, "timestamp": "03:37:54", "text": "手に入れた"}]
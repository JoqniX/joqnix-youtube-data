[{"type": "subtitle", "time": 12180.67, "timestamp": "03:23:00", "text": "返信してくれた人たちは"}, {"type": "subtitle", "time": 12184.469, "timestamp": "03:23:04", "text": "参加に興味があります。えっと、全部手に入れることができる"}, {"type": "subtitle", "time": 12186.71, "timestamp": "03:23:06", "text": "それらを書き留めるように"}, {"type": "subtitle", "time": 12190.71, "timestamp": "03:23:10", "text": "リストと、私ができる人と一緒に進めます"}, {"type": "subtitle", "time": 12193.91, "timestamp": "03:23:13", "text": "連絡を取ったり、いろいろしたりする。"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "ええ、それを見て、そういう感じだった"}, {"type": "subtitle", "time": 12200.64, "timestamp": "03:23:20", "text": "すっかり気分が悪くなってしまった。"}]
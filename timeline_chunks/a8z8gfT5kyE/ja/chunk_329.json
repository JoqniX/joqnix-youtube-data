[{"type": "subtitle", "time": 19751.43, "timestamp": "05:29:11", "text": "ランク。何てことだ。ああ、汗が出てきた。"}, {"type": "subtitle", "time": 19754.07, "timestamp": "05:29:14", "text": "でも待って、えっと、使い方がわからない"}, {"type": "subtitle", "time": 19757.75, "timestamp": "05:29:17", "text": "ショックを受けた女性。練習させてください。私"}, {"type": "subtitle", "time": 19759.51, "timestamp": "05:29:19", "text": "彼女を連れて行くべきかどうか迷っている。"}, {"type": "subtitle", "time": 19763.51, "timestamp": "05:29:23", "text": "でも、彼女を連れて行くなら、知っておく必要がある"}, {"type": "subtitle", "time": 19765.708, "timestamp": "05:29:25", "text": "彼女"}, {"type": "subtitle", "time": 19779.91, "timestamp": "05:29:39", "text": "カエル。カエルが見えますよ。ああ、"}, {"type": "subtitle", "time": 19787.15, "timestamp": "05:29:47", "text": "かわいい。"}, {"type": "subtitle", "time": 19789.75, "timestamp": "05:29:49", "text": "カエル。では、この能力は何をするものなのでしょうか？"}]
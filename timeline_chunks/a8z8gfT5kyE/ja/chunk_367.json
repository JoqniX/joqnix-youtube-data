[{"type": "subtitle", "time": 22028.15, "timestamp": "06:07:08", "text": "彼らはどこから来るのだろうか？そして私の"}, {"type": "subtitle", "time": 22064.35, "timestamp": "06:07:44", "text": "神。私"}, {"type": "subtitle", "time": 22068.15, "timestamp": "06:07:48", "text": "私はきちんと祈らなかった。"}, {"type": "subtitle", "time": 22070.35, "timestamp": "06:07:50", "text": "何てことだ。そして私は"}, {"type": "subtitle", "time": 22073.628, "timestamp": "06:07:53", "text": "怖がった。実際にはちゃんとプレイしていなかった。"}]
[{"type": "subtitle", "time": 666.07, "timestamp": "00:11:06", "text": "スピーチの前に。"}, {"type": "subtitle", "time": 676.42, "timestamp": "00:11:16", "text": "全て"}, {"type": "subtitle", "time": 677.79, "timestamp": "00:11:17", "text": "[音楽]"}, {"type": "subtitle", "time": 680.35, "timestamp": "00:11:20", "text": "右。私は"}, {"type": "subtitle", "time": 683.55, "timestamp": "00:11:23", "text": "戻る。ええ、顔を洗ったばかりで"}, {"type": "subtitle", "time": 690.949, "timestamp": "00:11:30", "text": "戻る。ああ、なぜ私は押し続けるのかと自問した"}, {"type": "subtitle", "time": 709.71, "timestamp": "00:11:49", "text": "脳。でも、足が痛い"}, {"type": "subtitle", "time": 712.87, "timestamp": "00:11:52", "text": "たくさんだよ、わかるだろ。えっと、私は、"}, {"type": "subtitle", "time": 714.99, "timestamp": "00:11:54", "text": "1、2時間、私はただ"}, {"type": "subtitle", "time": 718.63, "timestamp": "00:11:58", "text": "えっと、爆弾か何かを仕掛けてみて。ない"}]
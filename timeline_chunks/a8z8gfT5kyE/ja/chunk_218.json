[{"type": "subtitle", "time": 13091.11, "timestamp": "03:38:11", "text": "バ。大丈夫。一緒に遊ぼうよ。えっと"}, {"type": "subtitle", "time": 13093.75, "timestamp": "03:38:13", "text": "うん、その時になったら連絡するよ"}, {"type": "subtitle", "time": 13096.79, "timestamp": "03:38:16", "text": "私の課題を終わらせてくれる人が必要です"}, {"type": "subtitle", "time": 13115.349, "timestamp": "03:38:35", "text": "少し。ねえ、この銃ってAG（アサルトライフル）だよね？"}, {"type": "subtitle", "time": 13118.79, "timestamp": "03:38:38", "text": "えっと、私はいつも上手くできるわけではないのですが"}, {"type": "subtitle", "time": 13122.07, "timestamp": "03:38:42", "text": "org、でももし私がキャラクターのようにプレイしているなら"}, {"type": "subtitle", "time": 13125.429, "timestamp": "03:38:45", "text": "ミンみたいに、彼女の名前はミンだと思うんだけど、"}, {"type": "subtitle", "time": 13130.389, "timestamp": "03:38:50", "text": "ヴァンダルがいる。よし、音を聞いてみよう。"}, {"type": "subtitle", "time": 13132.75, "timestamp": "03:38:52", "text": "それはまるでヴァンダルのようだ。ランドール、"}, {"type": "subtitle", "time": 13134.83, "timestamp": "03:38:54", "text": "右？"}, {"type": "subtitle", "time": 13138.469, "timestamp": "03:38:58", "text": "だから、私が気づいたときはいつでも"}]
[{"type": "subtitle", "time": 15745.189, "timestamp": "04:22:25", "text": "[音楽]"}, {"type": "subtitle", "time": 15757.189, "timestamp": "04:22:37", "text": "明日のアレッピーマンは鐘を鳴らす"}, {"type": "subtitle", "time": 15758.87, "timestamp": "04:22:38", "text": "来るよ。"}, {"type": "subtitle", "time": 15759.71, "timestamp": "04:22:39", "text": "私は"}, {"type": "subtitle", "time": 15762.07, "timestamp": "04:22:42", "text": "心配した。私は何も知りません。私"}, {"type": "subtitle", "time": 15765.03, "timestamp": "04:22:45", "text": "それに関する動画はあまり見かけない。私"}, {"type": "subtitle", "time": 15767.81, "timestamp": "04:22:47", "text": "生き残れることを願う"}, {"type": "subtitle", "time": 15770.429, "timestamp": "04:22:50", "text": "[音楽]"}, {"type": "subtitle", "time": 15773.75, "timestamp": "04:22:53", "text": "それ。えっと、ちょっと自分の持ち物を確認してみます。わかった、"}, {"type": "subtitle", "time": 15775.87, "timestamp": "04:22:55", "text": "すべて順調です。"}, {"type": "subtitle", "time": 15779.79, "timestamp": "04:22:59", "text": "右？それを閉じて"}]
[{"type": "subtitle", "time": 16940.51, "timestamp": "04:42:20", "text": "ああ、そう"}, {"type": "subtitle", "time": 16943.03, "timestamp": "04:42:23", "text": "近い。ああ、"}, {"type": "subtitle", "time": 16949.31, "timestamp": "04:42:29", "text": "いい"}, {"type": "subtitle", "time": 16952.23, "timestamp": "04:42:32", "text": "トライとQボールは禁止された。はい、できます"}, {"type": "subtitle", "time": 16954.948, "timestamp": "04:42:34", "text": "誰かに作ってもらうよう頼むことができます"}, {"type": "subtitle", "time": 16958.47, "timestamp": "04:42:38", "text": "アメリカ出身の人とか、そういう人が好きなんですね。もしあなたが"}, {"type": "subtitle", "time": 16960.39, "timestamp": "04:42:40", "text": "外国人の友達が好き"}, {"type": "subtitle", "time": 16962.67, "timestamp": "04:42:42", "text": "インド以外では、彼らに聞いてみてください"}, {"type": "subtitle", "time": 16966.35, "timestamp": "04:42:46", "text": "電話番号でアカウントを作成するため。"}, {"type": "subtitle", "time": 16969.67, "timestamp": "04:42:49", "text": "しかし、Vichaはインドの電話番号では動作しません。"}, {"type": "subtitle", "time": 16973.27, "timestamp": "04:42:53", "text": "今のところQはうまく機能している。 Qは機能した。しかし、"}, {"type": "subtitle", "time": 16976.99, "timestamp": "04:42:56", "text": "ヴィチャ、外国製の"}, {"type": "subtitle", "time": 16979.948, "timestamp": "04:42:59", "text": "電話番号、携帯電話番号。電話番号。"}]
[{"type": "subtitle", "time": 12960.269, "timestamp": "03:36:00", "text": "はい、そうあるべきです"}, {"type": "subtitle", "time": 12963.269, "timestamp": "03:36:03", "text": "ロードしました。ええと、ちょっと待ってください。信号なし。"}, {"type": "subtitle", "time": 12966.67, "timestamp": "03:36:06", "text": "来て。ポップアップ。"}, {"type": "subtitle", "time": 12968.349, "timestamp": "03:36:08", "text": "シャイ。"}, {"type": "subtitle", "time": 12971.19, "timestamp": "03:36:11", "text": "えっと、待って。画面がちらついた。待って。"}, {"type": "subtitle", "time": 12973.79, "timestamp": "03:36:13", "text": "なぜ気づかなかったのですか"}, {"type": "subtitle", "time": 12976.469, "timestamp": "03:36:16", "text": "画面？待って。ええ、もちろんです。ジョー。さようなら"}, {"type": "subtitle", "time": 12981.389, "timestamp": "03:36:21", "text": "そして友達も購読する。うんうん。そこには何もありませんでした。"}, {"type": "subtitle", "time": 12985.79, "timestamp": "03:36:25", "text": "そうそう。こんにちは。ようこそ"}, {"type": "subtitle", "time": 12988.229, "timestamp": "03:36:28", "text": "ストリーム。信号が届いたら教えてください"}, {"type": "subtitle", "time": 13009.99, "timestamp": "03:36:49", "text": "[音楽]"}, {"type": "subtitle", "time": 13017.03, "timestamp": "03:36:57", "text": "戻る。ああ、大変だ。でも、私はApex Legendsをプレイしています。待って、"}]
[{"type": "subtitle", "time": 26285.51, "timestamp": "07:18:05", "text": "ああ、それはトントントントンという音ですね。わかった。"}, {"type": "subtitle", "time": 26289.31, "timestamp": "07:18:09", "text": "ああ、忘れてた。ああ、それは"}, {"type": "subtitle", "time": 26292.83, "timestamp": "07:18:12", "text": "もの。もし私が望むなら、私は行くことができる"}, {"type": "subtitle", "time": 26295.75, "timestamp": "07:18:15", "text": "バーストしてタップのやり方を学ぶ"}, {"type": "subtitle", "time": 26298.91, "timestamp": "07:18:18", "text": "トントン。私はそうすべきでしょうか"}, {"type": "subtitle", "time": 26301.83, "timestamp": "07:18:21", "text": "それ？いいえ。いいえ。いいえ、いいえ、いいえ。オートマチックのままにしておいてください。私"}, {"type": "subtitle", "time": 26304.19, "timestamp": "07:18:24", "text": "私は"}, {"type": "subtitle", "time": 26307.43, "timestamp": "07:18:27", "text": "Valerantでも自動運転です。私も依存が好きです"}, {"type": "subtitle", "time": 26309.39, "timestamp": "07:18:29", "text": "多くは"}, {"type": "subtitle", "time": 26312.628, "timestamp": "07:18:32", "text": "スプレー。時々私は学ぶ必要がある"}, {"type": "subtitle", "time": 26313.788, "timestamp": "07:18:33", "text": "タップする"}, {"type": "subtitle", "time": 26316.708, "timestamp": "07:18:36", "text": "タップ。ああ、肩越しに狙うんだ。ああ、そうだ、"}]
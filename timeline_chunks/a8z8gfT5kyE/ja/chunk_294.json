[{"type": "subtitle", "time": 17642.91, "timestamp": "04:54:02", "text": "おお、"}, {"type": "subtitle", "time": 17647.07, "timestamp": "04:54:07", "text": "ニース。これはPC版エイリアンTVだ。ああ、手に入れた"}, {"type": "subtitle", "time": 17651.04, "timestamp": "04:54:11", "text": "それ。ああ、大変だ。"}, {"type": "subtitle", "time": 17659.35, "timestamp": "04:54:19", "text": "窓をチェックすると思います"}, {"type": "subtitle", "time": 17661.99, "timestamp": "04:54:21", "text": "窓は天候状況を示します。"}, {"type": "subtitle", "time": 17664.39, "timestamp": "04:54:24", "text": "何？いや、いや、いや。自分で個人情報を公開します。いいえ、"}, {"type": "subtitle", "time": 17665.31, "timestamp": "04:54:25", "text": "いいえ、いいえ、"}, {"type": "subtitle", "time": 17668.27, "timestamp": "04:54:28", "text": "いや、いや、いや。今日変更しました"}, {"type": "subtitle", "time": 17671.59, "timestamp": "04:54:31", "text": "昨日、PCを再起動したとき、"}, {"type": "subtitle", "time": 17674.39, "timestamp": "04:54:34", "text": "もう少しで見せるところだった。だから私は「うん、"}, {"type": "subtitle", "time": 17678.59, "timestamp": "04:54:38", "text": "日本か他の国に変更します"}, {"type": "subtitle", "time": 17682.868, "timestamp": "04:54:42", "text": "場所。自分の個人情報を晒したくない。"}, {"type": "subtitle", "time": 17686.03, "timestamp": "04:54:46", "text": "こういうことには気をつけなければならない。"}]
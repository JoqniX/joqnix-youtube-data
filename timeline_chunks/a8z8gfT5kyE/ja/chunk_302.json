[{"type": "subtitle", "time": 18120.19, "timestamp": "05:02:00", "text": "それを置く"}, {"type": "subtitle", "time": 18123.35, "timestamp": "05:02:03", "text": "戻る。わかった。私もオンにする必要があります"}, {"type": "subtitle", "time": 18125.75, "timestamp": "05:02:05", "text": "外の明かりが"}, {"type": "subtitle", "time": 18129.99, "timestamp": "05:02:09", "text": "家の外で。だから選んで、私は"}]
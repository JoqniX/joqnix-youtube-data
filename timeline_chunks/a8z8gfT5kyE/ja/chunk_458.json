[{"type": "subtitle", "time": 27483.99, "timestamp": "07:38:03", "text": "神。ああ、惜しかったね。それで、エジプトの女性"}, {"type": "subtitle", "time": 27486.948, "timestamp": "07:38:06", "text": "浮くことができる。ああ、彼女は水に浮くことができるんだ。そうするべきです。"}, {"type": "subtitle", "time": 27489.27, "timestamp": "07:38:09", "text": "次回は彼女を連れて行くつもりだ。ロックを解除します"}, {"type": "subtitle", "time": 27497.35, "timestamp": "07:38:17", "text": "ああ、それは私だ。待って、それって私だ。"}, {"type": "subtitle", "time": 27499.19, "timestamp": "07:38:19", "text": "おお、"}, {"type": "subtitle", "time": 27517.548, "timestamp": "07:38:37", "text": "えっと、私は"}, {"type": "subtitle", "time": 27537.23, "timestamp": "07:38:57", "text": "ああ、勝ったよ。おお、"}, {"type": "subtitle", "time": 27539.07, "timestamp": "07:38:59", "text": "ニース。私の"}]
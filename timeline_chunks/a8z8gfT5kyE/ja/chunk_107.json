[{"type": "subtitle", "time": 6423.35, "timestamp": "01:47:03", "text": "テスト？私は嘘をついた。 5000人います。"}, {"type": "subtitle", "time": 6426.31, "timestamp": "01:47:06", "text": "あなたとの競争とは何ですか？しかし"}, {"type": "subtitle", "time": 6428.109, "timestamp": "01:47:08", "text": "心配しないで、"}, {"type": "subtitle", "time": 6429.79, "timestamp": "01:47:09", "text": "は"}, {"type": "subtitle", "time": 6440.95, "timestamp": "01:47:20", "text": "ああ、パワーガードがここにいる。重力 重力"}, {"type": "subtitle", "time": 6443.83, "timestamp": "01:47:23", "text": "同じ"}, {"type": "subtitle", "time": 6452.87, "timestamp": "01:47:32", "text": "ジャンプして、ここで撃つよ。ええ、ええ、"}, {"type": "subtitle", "time": 6456.109, "timestamp": "01:47:36", "text": "はい、はい、はい、はい。全て"}, {"type": "subtitle", "time": 6460.79, "timestamp": "01:47:40", "text": "右。ジャンプ。ああ、いや、いや、いや、いや。"}]
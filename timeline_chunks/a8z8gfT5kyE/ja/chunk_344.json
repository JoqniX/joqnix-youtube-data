[{"type": "subtitle", "time": 20642.07, "timestamp": "05:44:02", "text": "えっと、私は時々好きじゃないんだけど"}, {"type": "subtitle", "time": 20644.35, "timestamp": "05:44:04", "text": "得意なこと"}, {"type": "subtitle", "time": 20646.67, "timestamp": "05:44:06", "text": "コンテンツフレンド"}, {"type": "subtitle", "time": 20661.27, "timestamp": "05:44:21", "text": "それはあなたですよね、わかりますよね"}, {"type": "subtitle", "time": 20664.548, "timestamp": "05:44:24", "text": "私が追加するのは、私が追加するものではありません"}, {"type": "subtitle", "time": 20666.91, "timestamp": "05:44:26", "text": "友達関係"}, {"type": "subtitle", "time": 20668.86, "timestamp": "05:44:28", "text": "わかった。"}, {"type": "subtitle", "time": 20670.11, "timestamp": "05:44:30", "text": "[音楽]"}, {"type": "subtitle", "time": 20671.41, "timestamp": "05:44:31", "text": "えっと"}, {"type": "subtitle", "time": 20672.67, "timestamp": "05:44:32", "text": "[音楽]"}, {"type": "subtitle", "time": 20674.43, "timestamp": "05:44:34", "text": "星"}, {"type": "subtitle", "time": 20679.59, "timestamp": "05:44:39", "text": "少年スターボーイ。ああ、sp を入れられない、待って"}, {"type": "subtitle", "time": 20680.67, "timestamp": "05:44:40", "text": "2番"}, {"type": "subtitle", "time": 20684.59, "timestamp": "05:44:44", "text": "アカウント。よし、じゃあ君の名前を言おう。"}, {"type": "subtitle", "time": 20695.548, "timestamp": "05:44:55", "text": "[音楽]"}, {"type": "subtitle", "time": 20698.13, "timestamp": "05:44:58", "text": "それからこれ"}, {"type": "subtitle", "time": 20699.948, "timestamp": "05:44:59", "text": "[音楽]"}]
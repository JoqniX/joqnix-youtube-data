[{"type": "subtitle", "time": 18072.39, "timestamp": "05:01:12", "text": "2つよし、その素敵な170をアンロックして、今必要なのは"}, {"type": "subtitle", "time": 18075.99, "timestamp": "05:01:15", "text": "もう少しで"}, {"type": "subtitle", "time": 18077.948, "timestamp": "05:01:17", "text": "壁紙"}, {"type": "subtitle", "time": 18080.788, "timestamp": "05:01:20", "text": "もの。明日は座らなければならないと思う"}, {"type": "subtitle", "time": 18083.83, "timestamp": "05:01:23", "text": "3時間ほどかけて、"}, {"type": "subtitle", "time": 18087.67, "timestamp": "05:01:27", "text": "毎日。それは役に立つでしょう。ほら、２つ"}, {"type": "subtitle", "time": 18090.15, "timestamp": "05:01:30", "text": "人々はデメリットや慰めを持っている"}, {"type": "subtitle", "time": 18094.27, "timestamp": "05:01:34", "text": "あれ。わあ、すごくかわいい。これが欲しい"}, {"type": "subtitle", "time": 18099.19, "timestamp": "05:01:39", "text": "ディオ。とてもかわいい。これ、すごく可愛い。"}, {"type": "subtitle", "time": 18101.67, "timestamp": "05:01:41", "text": "私がこのキャラクターを演じているのは"}, {"type": "subtitle", "time": 18103.55, "timestamp": "05:01:43", "text": "それは"}, {"type": "subtitle", "time": 18114.43, "timestamp": "05:01:54", "text": "だから、そう、だから私はただ遊んでいるだけなんです"}, {"type": "subtitle", "time": 18118.39, "timestamp": "05:01:58", "text": "彼女。喜び。こんにちは。私はボトルウォールを取り、"}]
[{"type": "subtitle", "time": 14951.63, "timestamp": "04:09:11", "text": "私は持っている"}, {"type": "subtitle", "time": 14955.349, "timestamp": "04:09:15", "text": "それ。かっこいいデザートイーグル。それは"}, {"type": "subtitle", "time": 14970.03, "timestamp": "04:09:30", "text": "ねえ、これは私の肌じゃないわ。"}, {"type": "subtitle", "time": 14972.309, "timestamp": "04:09:32", "text": "え、もしかして詐欺に遭ったの？待って、待って、"}, {"type": "subtitle", "time": 14980.63, "timestamp": "04:09:40", "text": "待って。装備していなかったのでしょうか？うん、そうだね"}, {"type": "subtitle", "time": 14981.71, "timestamp": "04:09:41", "text": "あなた"}, {"type": "subtitle", "time": 14985.03, "timestamp": "04:09:45", "text": "行く。どういう意味ですか？待って、できない"}, {"type": "subtitle", "time": 14991.87, "timestamp": "04:09:51", "text": "なぜ？ああ、だって私には彼女がいないから"}, {"type": "subtitle", "time": 14994.79, "timestamp": "04:09:54", "text": "ロック解除されました。何てことだ。そういうことってあるの？"}, {"type": "subtitle", "time": 14996.95, "timestamp": "04:09:56", "text": "あ、待って。ロックを解除するのに十分なお金があります"}, {"type": "subtitle", "time": 14999.79, "timestamp": "04:09:59", "text": "キャラクター。私は誰ですか"}]
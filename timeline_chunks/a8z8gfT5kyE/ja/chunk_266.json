[{"type": "subtitle", "time": 15968.07, "timestamp": "04:26:08", "text": "今行ってる。今行ってる。今行ってる。私は"}, {"type": "subtitle", "time": 15985.11, "timestamp": "04:26:25", "text": "待って、なんで私の体にこんな絵が描かれてるの？は"}, {"type": "subtitle", "time": 15994.389, "timestamp": "04:26:34", "text": "ツインテールの女性ですか？それはあなたのものですか？"}, {"type": "subtitle", "time": 16000.149, "timestamp": "04:26:40", "text": "[音楽]"}, {"type": "subtitle", "time": 16017.35, "timestamp": "04:26:57", "text": "もの。ねえ、ナイフで切ってくれない？"}]
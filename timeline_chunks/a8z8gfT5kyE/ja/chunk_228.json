[{"type": "subtitle", "time": 13694.59, "timestamp": "03:48:14", "text": "何てことだ。何てことだ。ああ、"}, {"type": "subtitle", "time": 13713.11, "timestamp": "03:48:33", "text": "最悪だ。おお。彼女がそれを仕組んだ。壁"}, {"type": "subtitle", "time": 13718.51, "timestamp": "03:48:38", "text": "上。ずる賢い、"}, {"type": "subtitle", "time": 13739.51, "timestamp": "03:48:59", "text": "けれど。見えない。"}]
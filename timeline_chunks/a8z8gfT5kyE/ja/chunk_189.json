[{"type": "subtitle", "time": 11345.75, "timestamp": "03:09:05", "text": "おい、こいつはダサいぞ。なぜみんな"}, {"type": "subtitle", "time": 11348.15, "timestamp": "03:09:08", "text": "彼に夢中なの？彼は監督です"}, {"type": "subtitle", "time": 11350.469, "timestamp": "03:09:10", "text": "そしてあなたのいとこ。あなたがすることはすべて"}, {"type": "subtitle", "time": 11355.429, "timestamp": "03:09:15", "text": "火。ええ、これは私の映画です。君を見たよ。見て"}, {"type": "subtitle", "time": 11358.15, "timestamp": "03:09:18", "text": "この男を見て。"}, {"type": "subtitle", "time": 11365.11, "timestamp": "03:09:25", "text": "そのお金は我々のものだ。"}]
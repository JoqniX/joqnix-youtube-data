[{"type": "subtitle", "time": 21737.628, "timestamp": "06:02:17", "text": "いいえ。"}, {"type": "subtitle", "time": 21746.868, "timestamp": "06:02:26", "text": "あなた？スナイパーの人がどれほどひどいかは"}, {"type": "subtitle", "time": 21748.27, "timestamp": "06:02:28", "text": "試してみます"}, {"type": "subtitle", "time": 21750.99, "timestamp": "06:02:30", "text": "難しい。彼は唯一の"}, {"type": "subtitle", "time": 21752.51, "timestamp": "06:02:32", "text": "生きている。"}, {"type": "subtitle", "time": 21756.11, "timestamp": "06:02:36", "text": "いつも。ああ、なんてことだ。する必要がある"}, {"type": "subtitle", "time": 21759.75, "timestamp": "06:02:39", "text": "自分のゲームを組み立てる。私は必要としています 私は必要としています"}]
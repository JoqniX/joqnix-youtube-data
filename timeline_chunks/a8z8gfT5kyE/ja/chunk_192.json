[{"type": "subtitle", "time": 11558.389, "timestamp": "03:12:38", "text": "でも問題は、誰に頼めばいいのかわからないことだ"}, {"type": "subtitle", "time": 11562.15, "timestamp": "03:12:42", "text": "今夜のために。いいえ、私は終わらせることができます"}, {"type": "subtitle", "time": 11563.71, "timestamp": "03:12:43", "text": "誰か"}, {"type": "subtitle", "time": 11566.15, "timestamp": "03:12:46", "text": "今日ですよね？私はそれを終わらせることができた"}, {"type": "subtitle", "time": 11568.51, "timestamp": "03:12:48", "text": "誰か"}, {"type": "subtitle", "time": 11572.63, "timestamp": "03:12:52", "text": "今日。わかった、ゼン、ゼンは答えた。私は持っていた"}]
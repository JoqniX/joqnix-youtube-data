[{"type": "subtitle", "time": 19983.23, "timestamp": "05:33:03", "text": "私のところでやりたいですか？"}, {"type": "subtitle", "time": 19985.75, "timestamp": "05:33:05", "text": "見せる？しかしそれは多すぎるように思える"}, {"type": "subtitle", "time": 19995.628, "timestamp": "05:33:15", "text": "知る。私は社交不安症ではない"}, {"type": "subtitle", "time": 19997.91, "timestamp": "05:33:17", "text": "一瞬。もし他の誰かが話して"}, {"type": "subtitle", "time": 19999.67, "timestamp": "05:33:19", "text": "誰かが変なことを言うと、私はこう言うだろう。"}, {"type": "subtitle", "time": 20002.07, "timestamp": "05:33:22", "text": "\"なんてこった。\""}, {"type": "subtitle", "time": 20004.19, "timestamp": "05:33:24", "text": "それは"}, {"type": "subtitle", "time": 20007.03, "timestamp": "05:33:27", "text": "右。アカウントを作成させてください。どうやって"}, {"type": "subtitle", "time": 20009.35, "timestamp": "05:33:29", "text": "アカウントを作成しますか？待って、あなたはあなたですか"}, {"type": "subtitle", "time": 20012.948, "timestamp": "05:33:32", "text": "プレイする人たちは、待って、プレイします"}, {"type": "subtitle", "time": 20015.35, "timestamp": "05:33:35", "text": "君は自分だけの勃起アカウントを作る"}, {"type": "subtitle", "time": 20018.15, "timestamp": "05:33:38", "text": "マルチプレイのようにプレイできますか？待って、私はチロを知っている"}, {"type": "subtitle", "time": 20020.23, "timestamp": "05:33:40", "text": "そうする。私は彼の両方と友達になりました"}, {"type": "subtitle", "time": 20023.99, "timestamp": "05:33:43", "text": "アカウント。これとこれ。しないで"}, {"type": "subtitle", "time": 20027.4, "timestamp": "05:33:47", "text": "例えばどんな感じか教えて？"}, {"type": "subtitle", "time": 20029.35, "timestamp": "05:33:49", "text": "[音楽]"}, {"type": "subtitle", "time": 20031.51, "timestamp": "05:33:51", "text": "そして私は混乱している。どうして"}, {"type": "subtitle", "time": 20033.35, "timestamp": "05:33:53", "text": "アカウントを作成しましたか？それはあなたが必要としているようなものです"}, {"type": "subtitle", "time": 20034.75, "timestamp": "05:33:54", "text": "別の電話"}, {"type": "subtitle", "time": 20036.91, "timestamp": "05:33:56", "text": "番号。わかった。"}, {"type": "subtitle", "time": 20038.52, "timestamp": "05:33:58", "text": "わかった。 なぜ？どのように"}]
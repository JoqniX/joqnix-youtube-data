[{"type": "subtitle", "time": 5044.629, "timestamp": "01:24:04", "text": "痛みを感じる。ああ、なんてことだ。医師に電話する、"}, {"type": "subtitle", "time": 5046.79, "timestamp": "01:24:06", "text": "お願いします。"}, {"type": "subtitle", "time": 5049.35, "timestamp": "01:24:09", "text": "なんてこった。"}, {"type": "subtitle", "time": 5052.31, "timestamp": "01:24:12", "text": "やめて。もしあなたがそんな風に固まってしまったらどうなるでしょう？"}, {"type": "subtitle", "time": 5053.75, "timestamp": "01:24:13", "text": "何かがおかしいに違いない"}, {"type": "subtitle", "time": 5091.03, "timestamp": "01:24:51", "text": "検査は屋外で行う必要がある場合もある"}, {"type": "subtitle", "time": 5093.59, "timestamp": "01:24:53", "text": "実験室の限られた空間。次のテスト"}, {"type": "subtitle", "time": 5097.11, "timestamp": "01:24:57", "text": "型破りすぎて、"}, {"type": "subtitle", "time": 5099.11, "timestamp": "01:24:59", "text": "ピカチュウ。あなたが探していたのは"}]
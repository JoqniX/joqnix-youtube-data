[{"type": "subtitle", "time": 20046.39, "timestamp": "05:34:06", "text": "でも、なぜアカウントが2つあるの？違う"}, {"type": "subtitle", "time": 20055.788, "timestamp": "05:34:15", "text": "十分？私は3つ持っています。何？"}, {"type": "subtitle", "time": 20059.708, "timestamp": "05:34:19", "text": "三つ？何？"}, {"type": "subtitle", "time": 20065.07, "timestamp": "05:34:25", "text": "なぜ？なぜ？はぁ？これはどうやって遊ぶの？"}, {"type": "subtitle", "time": 20067.67, "timestamp": "05:34:27", "text": "ゲーム？まるで３人いるみたい"}, {"type": "subtitle", "time": 20069.83, "timestamp": "05:34:29", "text": "原知アカウント、または他のゲームのように"}, {"type": "subtitle", "time": 20072.47, "timestamp": "05:34:32", "text": "アカウント。あなたがいつでも"}, {"type": "subtitle", "time": 20075.35, "timestamp": "05:34:35", "text": "無料なので、ただプレイするだけです。"}, {"type": "subtitle", "time": 20077.67, "timestamp": "05:34:37", "text": "そして、それを挽いたりするんです。しかし"}, {"type": "subtitle", "time": 20080.83, "timestamp": "05:34:40", "text": "それはまるで"}, {"type": "subtitle", "time": 20087.99, "timestamp": "05:34:47", "text": "おお。ゲームできるアカウントを手に入れました。わかった。"}, {"type": "subtitle", "time": 20090.708, "timestamp": "05:34:50", "text": "えっと、このIDに私を追加させてください。"}, {"type": "subtitle", "time": 20096.15, "timestamp": "05:34:56", "text": "チャット。よし。正しいタイピング方法"}, {"type": "subtitle", "time": 20098.05, "timestamp": "05:34:58", "text": "ああ、神様。使わなければならない"}]
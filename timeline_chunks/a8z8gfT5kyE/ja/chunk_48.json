[{"type": "subtitle", "time": 2880.15, "timestamp": "00:48:00", "text": "常に天才の産物。天才。"}, {"type": "subtitle", "time": 2882.069, "timestamp": "00:48:02", "text": "アルバート・アインシュタインと彼のいとこ"}, {"type": "subtitle", "time": 2883.55, "timestamp": "00:48:03", "text": "テリー、"}, {"type": "subtitle", "time": 2887.109, "timestamp": "00:48:07", "text": "歴史はあなた方の一人です。私は天才少女？"}, {"type": "subtitle", "time": 2888.589, "timestamp": "00:48:08", "text": "そうじゃない？"}, {"type": "subtitle", "time": 2892.309, "timestamp": "00:48:12", "text": "はい、たぶん"}, {"type": "subtitle", "time": 2899.27, "timestamp": "00:48:19", "text": "ごめんなさい。"}, {"type": "subtitle", "time": 2901.75, "timestamp": "00:48:21", "text": "人間が行うスポーツの中には、このようなものもあります。勝者は"}, {"type": "subtitle", "time": 2904.71, "timestamp": "00:48:24", "text": "最も少ない得点を獲得した人。私"}, {"type": "subtitle", "time": 2905.99, "timestamp": "00:48:25", "text": "もしかしたら見つかるかもしれないと思って"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "面白い。ほとんどの勝者はそうする。"}, {"type": "subtitle", "time": 2915.95, "timestamp": "00:48:35", "text": "これは汚い"}, {"type": "subtitle", "time": 2920.069, "timestamp": "00:48:40", "text": "水。受け取った場合"}, {"type": "subtitle", "time": 2925.549, "timestamp": "00:48:45", "text": "ここに飛び降りたら、死ぬぞ。"}, {"type": "subtitle", "time": 2930.47, "timestamp": "00:48:50", "text": "ああ、あなたは汚れた水を知っているんですね。"}]
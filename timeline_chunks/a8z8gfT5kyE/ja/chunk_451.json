[{"type": "subtitle", "time": 27064.31, "timestamp": "07:31:04", "text": "こんにちは。いいえ、"}, {"type": "subtitle", "time": 27069.59, "timestamp": "07:31:09", "text": "私はペーパーモードを使用しませんでした。おお、"}, {"type": "subtitle", "time": 27071.75, "timestamp": "07:31:11", "text": "私は、えーと、私の名前がなぜなのか尋ねているのですね"}, {"type": "subtitle", "time": 27074.388, "timestamp": "07:31:14", "text": "見慣れない感じがする。私はオーにいます、"}, {"type": "subtitle", "time": 27077.19, "timestamp": "07:31:17", "text": "うん。今、思い出した。ああ、ありがとう"}, {"type": "subtitle", "time": 27080.99, "timestamp": "07:31:20", "text": "思い出させてくれてありがとう。"}, {"type": "subtitle", "time": 27084.23, "timestamp": "07:31:24", "text": "ああ、ママはあまり活動的ではない"}, {"type": "subtitle", "time": 27100.03, "timestamp": "07:31:40", "text": "狩猟。ああ、彼は理解したんだ。"}, {"type": "subtitle", "time": 27103.99, "timestamp": "07:31:43", "text": "悪くない。"}, {"type": "subtitle", "time": 27106.388, "timestamp": "07:31:46", "text": "えっと、あなたも自分自身をさらけ出しています"}, {"type": "subtitle", "time": 27110.03, "timestamp": "07:31:50", "text": "多くの。角の陰に隠れてください。はい、"}, {"type": "subtitle", "time": 27113.11, "timestamp": "07:31:53", "text": "試す。紙に慣れる必要がある"}, {"type": "subtitle", "time": 27115.548, "timestamp": "07:31:55", "text": "モード。私はそれを使っていません"}, {"type": "subtitle", "time": 27119.19, "timestamp": "07:31:59", "text": "多くの。撮影後にこれをやるつもりはない"}, {"type": "subtitle", "time": 27119.948, "timestamp": "07:31:59", "text": "そして"}]
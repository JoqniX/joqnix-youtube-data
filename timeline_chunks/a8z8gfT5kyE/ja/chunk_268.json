[{"type": "subtitle", "time": 16088.07, "timestamp": "04:28:08", "text": "D. ああ。おお。こういう時はいつも"}, {"type": "subtitle", "time": 16090.67, "timestamp": "04:28:10", "text": "落書きはできない"}, {"type": "subtitle", "time": 16098.229, "timestamp": "04:28:18", "text": "効果は？このゲームは最低のゴミだ。作る"}, {"type": "subtitle", "time": 16120.229, "timestamp": "04:28:40", "text": "何をしているの？私は何をしていたんだろう？私は押した"}, {"type": "subtitle", "time": 16139.149, "timestamp": "04:28:59", "text": "いいえ、私は最初の勝利を勝ち取りたいのです"}]
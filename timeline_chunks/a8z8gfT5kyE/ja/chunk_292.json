[{"type": "subtitle", "time": 17522.39, "timestamp": "04:52:02", "text": "何？すみません。なぜあなたは"}, {"type": "subtitle", "time": 17524.51, "timestamp": "04:52:04", "text": "消えていく"}, {"type": "subtitle", "time": 17527.27, "timestamp": "04:52:07", "text": "自分？皆さん、あれ見ましたよね？あなた"}, {"type": "subtitle", "time": 17529.91, "timestamp": "04:52:09", "text": "みんな、それ見たよね？"}, {"type": "subtitle", "time": 17532.47, "timestamp": "04:52:12", "text": "君たち、あれ見たよね？それ"}, {"type": "subtitle", "time": 17541.47, "timestamp": "04:52:21", "text": "何もない。ああ、わかりました。それは消えた。"}, {"type": "subtitle", "time": 17546.11, "timestamp": "04:52:26", "text": "NはChromeを使用します。ああ、いや。これを使いたい"}, {"type": "subtitle", "time": 17566.99, "timestamp": "04:52:46", "text": "[音楽]"}, {"type": "subtitle", "time": 17569.23, "timestamp": "04:52:49", "text": "これ"}, {"type": "subtitle", "time": 17573.11, "timestamp": "04:52:53", "text": "ウィンドウ。もうあなたは尋ねないでしょう。今すぐ"}, {"type": "subtitle", "time": 17576.39, "timestamp": "04:52:56", "text": "読み込まれません。さあ行こう。ニース。私"}]
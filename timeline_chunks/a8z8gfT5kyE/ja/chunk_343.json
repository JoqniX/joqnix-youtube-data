[{"type": "subtitle", "time": 20621.19, "timestamp": "05:43:41", "text": "なぜこれらの広告に問題があるのか"}, {"type": "subtitle", "time": 20623.23, "timestamp": "05:43:43", "text": "右の彫刻"}, {"type": "subtitle", "time": 20628.15, "timestamp": "05:43:48", "text": "問題は、私は行き詰まる傾向があるということです"}, {"type": "subtitle", "time": 20632.39, "timestamp": "05:43:52", "text": "ある時点で微調整"}, {"type": "subtitle", "time": 20634.75, "timestamp": "05:43:54", "text": "そう、それが私が"}, {"type": "subtitle", "time": 20638.43, "timestamp": "05:43:58", "text": "どういうわけか時々吸い込む"}]
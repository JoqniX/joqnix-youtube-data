[{"type": "subtitle", "time": 26942.35, "timestamp": "07:29:02", "text": "ショット。"}, {"type": "subtitle", "time": 26949.91, "timestamp": "07:29:09", "text": "いらっしゃいませ。えっと、待って。ああ、なんてことだ。ああ、それは"}, {"type": "subtitle", "time": 26952.628, "timestamp": "07:29:12", "text": "私のものと似たようなもの、次のもの、"}, {"type": "subtitle", "time": 26955.788, "timestamp": "07:29:15", "text": "右？だから、n"}, {"type": "subtitle", "time": 26958.548, "timestamp": "07:29:18", "text": "そうですね、相関関係を教えてください。"}, {"type": "subtitle", "time": 26961.43, "timestamp": "07:29:21", "text": "方法。ええ、ようこそ。良い一日をお過ごしください"}, {"type": "subtitle", "time": 26963.8, "timestamp": "07:29:23", "text": "順調です。"}, {"type": "subtitle", "time": 26973.388, "timestamp": "07:29:33", "text": "[音楽]"}, {"type": "subtitle", "time": 26976.23, "timestamp": "07:29:36", "text": "こんにちは。彼は自分の仕事をやり遂げた。彼はそうしなかった"}, {"type": "subtitle", "time": 26978.468, "timestamp": "07:29:38", "text": "消える。彼は全力疾走した。"}, {"type": "subtitle", "time": 26981.468, "timestamp": "07:29:41", "text": "本当に速い。ああ、それは"}, {"type": "subtitle", "time": 26984.788, "timestamp": "07:29:44", "text": "なぜああ"}, {"type": "subtitle", "time": 26987.83, "timestamp": "07:29:47", "text": "えーと、あの緑のショットガンを持った背の低い男"}, {"type": "subtitle", "time": 26990.75, "timestamp": "07:29:50", "text": "グリーンショットガンの男たち全員を知ってるよ"}, {"type": "subtitle", "time": 26993.11, "timestamp": "07:29:53", "text": "必ずそのうちの1人と出会う"}, {"type": "subtitle", "time": 26996.07, "timestamp": "07:29:56", "text": "消える。私は「えっ？」って感じでした。その後"}, {"type": "subtitle", "time": 26998.468, "timestamp": "07:29:58", "text": "ああ、彼女がこう言っているのを聞いて、私は気づいた"}]
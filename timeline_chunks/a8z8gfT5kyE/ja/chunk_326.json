[{"type": "subtitle", "time": 19574.09, "timestamp": "05:26:14", "text": "選ぶ？"}, {"type": "subtitle", "time": 19576.35, "timestamp": "05:26:16", "text": "[音楽]"}, {"type": "subtitle", "time": 19579.11, "timestamp": "05:26:19", "text": "私は大丈夫です。元気です。元気です。私は私は"}, {"type": "subtitle", "time": 19580.948, "timestamp": "05:26:20", "text": "肌で何をするか、だって私には肌があるから。"}, {"type": "subtitle", "time": 19583.35, "timestamp": "05:26:23", "text": "私がやります。はぁ？大丈夫。病気"}, {"type": "subtitle", "time": 19591.67, "timestamp": "05:26:31", "text": "女性よ、なぜなら肌があるから。私は"}, {"type": "subtitle", "time": 19600.11, "timestamp": "05:26:40", "text": "彼女。でもイベントに参加して"}, {"type": "subtitle", "time": 19603.43, "timestamp": "05:26:43", "text": "どちらが皮膚でしたっけ？それは"}, {"type": "subtitle", "time": 19604.19, "timestamp": "05:26:44", "text": "ない"}, {"type": "subtitle", "time": 19606.708, "timestamp": "05:26:46", "text": "ここ？ここにあるはずですよね？それは"}, {"type": "subtitle", "time": 19609.51, "timestamp": "05:26:49", "text": "ここじゃないの？ええ、イベントに参加します。"}, {"type": "subtitle", "time": 19617.43, "timestamp": "05:26:57", "text": "ハナ作。カエルが見えますよ。ええ、私は"}]
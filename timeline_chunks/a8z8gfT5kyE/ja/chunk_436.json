[{"type": "subtitle", "time": 26162.708, "timestamp": "07:16:02", "text": "何を買うんですか？なぜあなたは、ああ、"}, {"type": "subtitle", "time": 26166.39, "timestamp": "07:16:06", "text": "あなたがどのように使うか知っていますか"}, {"type": "subtitle", "time": 26168.708, "timestamp": "07:16:08", "text": "60歳くらいで領事館に行くことになる"}, {"type": "subtitle", "time": 26171.99, "timestamp": "07:16:11", "text": "この星座柄のレディースドレス、または"}, {"type": "subtitle", "time": 26174.19, "timestamp": "07:16:14", "text": "充電のための無料アイテムまたは"}, {"type": "subtitle", "time": 26176.788, "timestamp": "07:16:16", "text": "何か。そう、それだ。なぜしないのか"}, {"type": "subtitle", "time": 26180.07, "timestamp": "07:16:20", "text": "彼らは他のキャラクターも試すのか？"}, {"type": "subtitle", "time": 26181.15, "timestamp": "07:16:21", "text": "私は"}, {"type": "subtitle", "time": 26185.11, "timestamp": "07:16:25", "text": "必要だ、やらなきゃいけない、ああ、もう一度試してみるよ"}, {"type": "subtitle", "time": 26186.75, "timestamp": "07:16:26", "text": "時間。私"}, {"type": "subtitle", "time": 26189.99, "timestamp": "07:16:29", "text": "私が思うに、他のゲームもできると思います"}, {"type": "subtitle", "time": 26194.35, "timestamp": "07:16:34", "text": "キャラクター。ただ、私は"}, {"type": "subtitle", "time": 26196.788, "timestamp": "07:16:36", "text": "もちろん。わからない。私は試してみるべきだ"}, {"type": "subtitle", "time": 26198.468, "timestamp": "07:16:38", "text": "他のキャラクターを演じているのか？つまり、"}, {"type": "subtitle", "time": 26200.868, "timestamp": "07:16:40", "text": "今はランキング入りしています。だから私はこう思う"}, {"type": "subtitle", "time": 26204.43, "timestamp": "07:16:44", "text": "得意なキャラクターを演じているので"}, {"type": "subtitle", "time": 26207.11, "timestamp": "07:16:47", "text": "ランクは"}, {"type": "subtitle", "time": 26209.59, "timestamp": "07:16:49", "text": "今は真剣な話だ。だから、私はこう思った、"}]
[{"type": "subtitle", "time": 13509.59, "timestamp": "03:45:09", "text": "そう、プレイすればするほど、"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "改善できる。"}, {"type": "subtitle", "time": 13515.349, "timestamp": "03:45:15", "text": "よし、始めよう。"}, {"type": "subtitle", "time": 13517.75, "timestamp": "03:45:17", "text": "それはどんなゲームですか？ええと、それは中国製です"}, {"type": "subtitle", "time": 13520.469, "timestamp": "03:45:20", "text": "ゲーム。いや、私たちは中国版をプレイしています"}, {"type": "subtitle", "time": 13522.79, "timestamp": "03:45:22", "text": "これについて。それはカリ・バイオと呼ばれています。の"}, {"type": "subtitle", "time": 13525.87, "timestamp": "03:45:25", "text": "英語の西洋名はStringです"}, {"type": "subtitle", "time": 13529.11, "timestamp": "03:45:29", "text": "ノヴァ。タイトルに書いてある通りです。見られない"}, {"type": "subtitle", "time": 13557.349, "timestamp": "03:45:57", "text": "良い。あれは翻訳機ですか？ええ、私たちは"}, {"type": "subtitle", "time": 13559.71, "timestamp": "03:45:59", "text": "画面上に翻訳機能があります"}]
[{"type": "subtitle", "time": 5004.79, "timestamp": "01:23:24", "text": "[音楽]"}, {"type": "subtitle", "time": 5008.149, "timestamp": "01:23:28", "text": "こんにちは。おめでとう。あなたはやり遂げました"}, {"type": "subtitle", "time": 5009.99, "timestamp": "01:23:29", "text": "この全く意味のない"}, {"type": "subtitle", "time": 5012.95, "timestamp": "01:23:32", "text": "テスト。ああ、危うく忘れるところだった。行くとき"}, {"type": "subtitle", "time": 5014.79, "timestamp": "01:23:34", "text": "テストコース以外では、"}, {"type": "subtitle", "time": 5016.79, "timestamp": "01:23:36", "text": "私があなたを返す方法は暴力的に"}, {"type": "subtitle", "time": 5019.51, "timestamp": "01:23:39", "text": "分解して、それから慎重に"}, {"type": "subtitle", "time": 5023.03, "timestamp": "01:23:43", "text": "あなたを再構築します。幸いなことに、"}, {"type": "subtitle", "time": 5026.149, "timestamp": "01:23:46", "text": "痛み。いずれにせよ、あなたはDon'tを持っていません"}, {"type": "subtitle", "time": 5028.87, "timestamp": "01:23:48", "text": "痛みを感じる。ええ、そう思います。私は考える"}, {"type": "subtitle", "time": 5031.59, "timestamp": "01:23:51", "text": "それ。"}, {"type": "subtitle", "time": 5033.95, "timestamp": "01:23:53", "text": "ああ、"}]
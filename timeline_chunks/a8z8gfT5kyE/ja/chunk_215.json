[{"type": "subtitle", "time": 12907.75, "timestamp": "03:35:07", "text": "ああ、なんてことだ、これは痛い。私は、えっと、私は自分の"}, {"type": "subtitle", "time": 12909.83, "timestamp": "03:35:09", "text": "えーっと、両方のピースをスリープモードにします"}, {"type": "subtitle", "time": 12912.79, "timestamp": "03:35:12", "text": "カリフォルニアで頑張っててすごく疲れたから"}, {"type": "subtitle", "time": 12915.429, "timestamp": "03:35:15", "text": "朝起きたとき少しの間"}, {"type": "subtitle", "time": 12918.71, "timestamp": "03:35:18", "text": "Apexイベントに接続しなければならなかったので"}, {"type": "subtitle", "time": 12920.71, "timestamp": "03:35:20", "text": "一緒に遊んでくれる友達がいない。だから私は"}, {"type": "subtitle", "time": 12922.79, "timestamp": "03:35:22", "text": "別のアカウントでプレイする必要がある。それで"}, {"type": "subtitle", "time": 12926.03, "timestamp": "03:35:26", "text": "両方とも私は両方で遊びます"}, {"type": "subtitle", "time": 12929.91, "timestamp": "03:35:29", "text": "PC と私の指は両方とも、"}, {"type": "subtitle", "time": 12933.91, "timestamp": "03:35:33", "text": "手を動かして、実際に私の"}, {"type": "subtitle", "time": 12934.99, "timestamp": "03:35:34", "text": "脚に"}, {"type": "subtitle", "time": 12940.59, "timestamp": "03:35:40", "text": "私のストリームを狙うストリームPCカー新しい"}, {"type": "subtitle", "time": 12943.67, "timestamp": "03:35:43", "text": "アカウント。ああ、あれは面白かった。しかし"}, {"type": "subtitle", "time": 12948.309, "timestamp": "03:35:48", "text": "ついにApexイベントをクリアしました"}, {"type": "subtitle", "time": 12958.55, "timestamp": "03:35:58", "text": "[音楽]"}]
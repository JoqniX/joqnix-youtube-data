[{"type": "subtitle", "time": 22900.11, "timestamp": "06:21:40", "text": "パターン。ああ、"}, {"type": "subtitle", "time": 22904.07, "timestamp": "06:21:44", "text": "神。両親は私にこう言った"}, {"type": "subtitle", "time": 22910.75, "timestamp": "06:21:50", "text": "だから私は"}, {"type": "subtitle", "time": 22913.43, "timestamp": "06:21:53", "text": "5分もかからなかったことを願う。私"}, {"type": "subtitle", "time": 22915.23, "timestamp": "06:21:55", "text": "切り替えるべきだった"}, {"type": "subtitle", "time": 22917.67, "timestamp": "06:21:57", "text": "シーン。うん、切り替えるべきだった"}, {"type": "subtitle", "time": 22919.03, "timestamp": "06:21:59", "text": "私のシーン。"}]
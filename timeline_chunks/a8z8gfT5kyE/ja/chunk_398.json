[{"type": "subtitle", "time": 23880.11, "timestamp": "06:38:00", "text": "行くよ。ああ、"}, {"type": "subtitle", "time": 23882.19, "timestamp": "06:38:02", "text": "神。いいえ、やめてください"}, {"type": "subtitle", "time": 23886.11, "timestamp": "06:38:06", "text": "死ぬ。何てことだ。"}, {"type": "subtitle", "time": 23897.31, "timestamp": "06:38:17", "text": "怖い。ああ、彼女は怖い。見てください"}, {"type": "subtitle", "time": 23901.628, "timestamp": "06:38:21", "text": "それ。おお、いいね。"}, {"type": "subtitle", "time": 23907.628, "timestamp": "06:38:27", "text": "それは"}, {"type": "subtitle", "time": 23917.83, "timestamp": "06:38:37", "text": "[音楽]"}, {"type": "subtitle", "time": 23920.67, "timestamp": "06:38:40", "text": "ミッドレーンをプレイするべきだ"}, {"type": "subtitle", "time": 23924.628, "timestamp": "06:38:44", "text": "実際には、ええと、私はそうすべきです"}]
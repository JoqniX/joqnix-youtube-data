[{"type": "subtitle", "time": 20942.75, "timestamp": "05:49:02", "text": "ランク戦はプレイしたことがないので"}, {"type": "subtitle", "time": 20946.07, "timestamp": "05:49:06", "text": "他に来る予定の友達を知っていますか？えっと"}, {"type": "subtitle", "time": 20947.548, "timestamp": "05:49:07", "text": "私はそうは思わない"}, {"type": "subtitle", "time": 20978.71, "timestamp": "05:49:38", "text": "位置。私"}, {"type": "subtitle", "time": 20996.07, "timestamp": "05:49:56", "text": "銅メダルがもらえるんでしょ？わかった。 H."}, {"type": "subtitle", "time": 20997.47, "timestamp": "05:49:57", "text": "大丈夫です"}]
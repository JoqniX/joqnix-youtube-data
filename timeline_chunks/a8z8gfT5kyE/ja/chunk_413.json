[{"type": "subtitle", "time": 24782.948, "timestamp": "06:53:02", "text": "だんだんゲームに慣れてきた。これ"}, {"type": "subtitle", "time": 24786.31, "timestamp": "06:53:06", "text": "えっと、4日目3回目って感じ"}, {"type": "subtitle", "time": 24788.75, "timestamp": "06:53:08", "text": "３日目か何かでプレイ中"}, {"type": "subtitle", "time": 24792.468, "timestamp": "06:53:12", "text": "それ。私の誕生日はいつですか？ああ、"}, {"type": "subtitle", "time": 24794.14, "timestamp": "06:53:14", "text": "神よ、"}, {"type": "subtitle", "time": 24795.39, "timestamp": "06:53:15", "text": "[音楽]"}, {"type": "subtitle", "time": 24812.788, "timestamp": "06:53:32", "text": "歌？あ、待って。これは、"}, {"type": "subtitle", "time": 24815.91, "timestamp": "06:53:35", "text": "そうそう。スターボーイの息子はオールスターだった"}, {"type": "subtitle", "time": 24817.868, "timestamp": "06:53:37", "text": "息子のアルタックは"}, {"type": "subtitle", "time": 24826.19, "timestamp": "06:53:46", "text": "それ。"}, {"type": "subtitle", "time": 24835.39, "timestamp": "06:53:55", "text": "[音楽]"}]
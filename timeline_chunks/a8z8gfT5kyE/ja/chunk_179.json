[{"type": "subtitle", "time": 10744.469, "timestamp": "02:59:04", "text": "再び恋をする。楽しかった。ジェニーの息子が"}, {"type": "subtitle", "time": 10747.38, "timestamp": "02:59:07", "text": "楽しんで"}, {"type": "subtitle", "time": 10765.99, "timestamp": "02:59:25", "text": "今日は本当にストレスが溜まっていたので"}, {"type": "subtitle", "time": 10770.19, "timestamp": "02:59:30", "text": "停電のせいで、"}, {"type": "subtitle", "time": 10774.269, "timestamp": "02:59:34", "text": "ああ、停電が起きた。それはまずい。"}, {"type": "subtitle", "time": 10778.63, "timestamp": "02:59:38", "text": "今。停電が"}, {"type": "subtitle", "time": 10782.15, "timestamp": "02:59:42", "text": "コラボパートナー側でハッカーとして"}, {"type": "subtitle", "time": 10785.99, "timestamp": "02:59:45", "text": "ドイオの瞬間のように、あなたは完全に一人ぼっちになる"}, {"type": "subtitle", "time": 10788.71, "timestamp": "02:59:48", "text": "今日、私とセナンにも同じことが起こりました。"}, {"type": "subtitle", "time": 10796.23, "timestamp": "02:59:56", "text": "今日みたいにカットして、ジャシマとのコラボも好きじゃない"}]
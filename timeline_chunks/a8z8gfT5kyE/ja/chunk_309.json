[{"type": "subtitle", "time": 18551.99, "timestamp": "05:09:11", "text": "ああ、紙製のクラッチバッグ。ああ、それは"}, {"type": "subtitle", "time": 18552.75, "timestamp": "05:09:12", "text": "良い"}, {"type": "subtitle", "time": 18557.51, "timestamp": "05:09:17", "text": "ショット。いい感じでしょ？彼女は戻って来られる"}, {"type": "subtitle", "time": 18558.99, "timestamp": "05:09:18", "text": "人生。"}, {"type": "subtitle", "time": 18560.34, "timestamp": "05:09:20", "text": "何？"}, {"type": "subtitle", "time": 18561.628, "timestamp": "05:09:21", "text": "[音楽]"}, {"type": "subtitle", "time": 18564.75, "timestamp": "05:09:24", "text": "何？彼女は生き返ることができる。"}, {"type": "subtitle", "time": 18568.708, "timestamp": "05:09:28", "text": "何？何？"}, {"type": "subtitle", "time": 18571.15, "timestamp": "05:09:31", "text": "誰かが"}, {"type": "subtitle", "time": 18573.47, "timestamp": "05:09:33", "text": "私の"}, {"type": "subtitle", "time": 18586.75, "timestamp": "05:09:46", "text": "[音楽]"}, {"type": "subtitle", "time": 18598.948, "timestamp": "05:09:58", "text": "そこが問題なんです。だから、もしあなたがそうでないなら"}]
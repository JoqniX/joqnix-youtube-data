[{"type": "subtitle", "time": 13200.63, "timestamp": "03:40:00", "text": "ゴウ。また、お気づきかどうかわかりませんが、"}, {"type": "subtitle", "time": 13203.429, "timestamp": "03:40:03", "text": "十字線を次のように作りました"}, {"type": "subtitle", "time": 13207.349, "timestamp": "03:40:07", "text": "ヴァレリンのクロスヘア。私は、必要だと思う"}, {"type": "subtitle", "time": 13209.55, "timestamp": "03:40:09", "text": "これを少し下げる"}, {"type": "subtitle", "time": 13212.71, "timestamp": "03:40:12", "text": "多分そうだろう。下げ方がわからない"}, {"type": "subtitle", "time": 13222.19, "timestamp": "03:40:22", "text": "これ？ああ、どうやって下げるの？"}, {"type": "subtitle", "time": 13224.87, "timestamp": "03:40:24", "text": "これ。ああ、そうやって下げるんだ"}, {"type": "subtitle", "time": 13226.83, "timestamp": "03:40:26", "text": "それ。わかった。"}, {"type": "subtitle", "time": 13230.429, "timestamp": "03:40:30", "text": "うん。今ならわかる"}, {"type": "subtitle", "time": 13233.79, "timestamp": "03:40:33", "text": "もの。十字線が小さいほど、"}, {"type": "subtitle", "time": 13240.95, "timestamp": "03:40:40", "text": "そして、機械工が"}, {"type": "subtitle", "time": 13243.11, "timestamp": "03:40:43", "text": "私が学ぶ必要があるゲームは実際に"}, {"type": "subtitle", "time": 13247.63, "timestamp": "03:40:47", "text": "ペーパーモードと実際にこれを使用して"}, {"type": "subtitle", "time": 13250.79, "timestamp": "03:40:50", "text": "アドバンテージ。私は紙を使っているあなたではありません"}, {"type": "subtitle", "time": 13255.67, "timestamp": "03:40:55", "text": "モード自体を一切使用しない。私はただ自分の狙いに頼っているだけです"}, {"type": "subtitle", "time": 13258.229, "timestamp": "03:40:58", "text": "そして、いろいろなことや配置換え。忘れた"}]
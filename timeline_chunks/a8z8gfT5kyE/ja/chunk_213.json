[{"type": "subtitle", "time": 12781.269, "timestamp": "03:33:01", "text": "アカウントは作っていないと思うけど、"}, {"type": "subtitle", "time": 12784.71, "timestamp": "03:33:04", "text": "私の友人のような人を見たのを覚えています。"}, {"type": "subtitle", "time": 12786.63, "timestamp": "03:33:06", "text": "まるで私が彼らの"}, {"type": "subtitle", "time": 12789.349, "timestamp": "03:33:09", "text": "プロフィール情報。彼らはVをやっているようだった"}, {"type": "subtitle", "time": 12791.91, "timestamp": "03:33:11", "text": "彼らは興味を持っていた"}, {"type": "subtitle", "time": 12793.429, "timestamp": "03:33:13", "text": "ストーリーとか、そういうものがあったんです。彼らは"}, {"type": "subtitle", "time": 12797.269, "timestamp": "03:33:17", "text": "VA関連のものが欲しかった。それで、彼らは投稿をしました"}, {"type": "subtitle", "time": 12799.91, "timestamp": "03:33:19", "text": "求人広告のようなもの、探しているようなもの"}, {"type": "subtitle", "time": 12801.67, "timestamp": "03:33:21", "text": "声優募集"}, {"type": "subtitle", "time": 12805.07, "timestamp": "03:33:25", "text": "何か投稿しました。それで私は「ああ、これは何だ」と思った"}, {"type": "subtitle", "time": 12807.99, "timestamp": "03:33:27", "text": "これ？私は興味をそそられた。"}, {"type": "subtitle", "time": 12809.91, "timestamp": "03:33:29", "text": "すべてにウェブサイトがある"}, {"type": "subtitle", "time": 12813.389, "timestamp": "03:33:33", "text": "こういうこと、君も知ってるよね。"}, {"type": "subtitle", "time": 12817.71, "timestamp": "03:33:37", "text": "うん。ええと、今日は"}, {"type": "subtitle", "time": 12821.75, "timestamp": "03:33:41", "text": "えーと、キャスティング、キャスティングコールクラブ。うん、それ"}, {"type": "subtitle", "time": 12825.15, "timestamp": "03:33:45", "text": "1つ。それが正解だと思う。"}, {"type": "subtitle", "time": 12827.79, "timestamp": "03:33:47", "text": "はい。もっと"}, {"type": "subtitle", "time": 12829.0, "timestamp": "03:33:49", "text": "もっと。"}, {"type": "subtitle", "time": 12830.99, "timestamp": "03:33:50", "text": "[音楽]"}, {"type": "subtitle", "time": 12834.07, "timestamp": "03:33:54", "text": "ええと、わかりました。それでは、ゲームを始めましょう。"}]
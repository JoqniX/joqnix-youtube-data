[{"type": "subtitle", "time": 14410.469, "timestamp": "04:00:10", "text": "男。ああ、またシャカの女性が"}, {"type": "subtitle", "time": 14419.03, "timestamp": "04:00:19", "text": "言っておくけど、傷跡は"}, {"type": "subtitle", "time": 14421.189, "timestamp": "04:00:21", "text": "傷跡を使うこのキャラクターは"}, {"type": "subtitle", "time": 14423.429, "timestamp": "04:00:23", "text": "実際、かっこいいですね。"}, {"type": "subtitle", "time": 14425.71, "timestamp": "04:00:25", "text": "そして、"}, {"type": "subtitle", "time": 14443.349, "timestamp": "04:00:43", "text": "ニース。ニース。ええ、私たちは手一杯​​なんです。"}, {"type": "subtitle", "time": 14456.469, "timestamp": "04:00:56", "text": "ちなみに、質問してくれてありがとう。どれくらい大きいか"}, {"type": "subtitle", "time": 14459.03, "timestamp": "04:00:59", "text": "チャノヴァですか？確認してよかった"}]
[{"type": "subtitle", "time": 27124.07, "timestamp": "07:32:04", "text": "スターボーイはどんな感じ？はぁ？私は"}, {"type": "subtitle", "time": 27133.75, "timestamp": "07:32:13", "text": "多くの。このゲームは面白そうだ。うん、"}, {"type": "subtitle", "time": 27140.548, "timestamp": "07:32:20", "text": "私の狙いはゴミだ。大丈夫。あなたの"}, {"type": "subtitle", "time": 27143.388, "timestamp": "07:32:23", "text": "とてもうまくいきました。その"}, {"type": "subtitle", "time": 27166.15, "timestamp": "07:32:46", "text": "何てことだ。今行ってる。今行ってる。私は"}, {"type": "subtitle", "time": 27168.51, "timestamp": "07:32:48", "text": "来るよ。今行ってる。近日公開。近日公開。"}]
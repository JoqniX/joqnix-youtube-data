[{"type": "subtitle", "time": 19624.68, "timestamp": "05:27:04", "text": "それ。見ることができます"}, {"type": "subtitle", "time": 19627.55, "timestamp": "05:27:07", "text": "[音楽]"}, {"type": "subtitle", "time": 19630.98, "timestamp": "05:27:10", "text": "カエル。カエル"}, {"type": "subtitle", "time": 19633.708, "timestamp": "05:27:13", "text": "[音楽]"}, {"type": "subtitle", "time": 19637.47, "timestamp": "05:27:17", "text": "ch.まあ、ストリームへようこそ。えっと、"}, {"type": "subtitle", "time": 19640.31, "timestamp": "05:27:20", "text": "ユビアさん、あなたの名前、正しく発音できましたか？"}, {"type": "subtitle", "time": 19642.788, "timestamp": "05:27:22", "text": "ええ、ようこそ。いらっしゃいませ。元気でいてくれるといいな"}, {"type": "subtitle", "time": 19648.11, "timestamp": "05:27:28", "text": "良い。ご覧ください"}, {"type": "subtitle", "time": 19651.19, "timestamp": "05:27:31", "text": "ランク。おお。そうそう。あなたはこう思う、何だって"}, {"type": "subtitle", "time": 19655.31, "timestamp": "05:27:35", "text": "これは電話ですか？えっと、どうやって"}, {"type": "subtitle", "time": 19658.51, "timestamp": "05:27:38", "text": "何かボタンを押しましたか？うん。"}, {"type": "subtitle", "time": 19660.83, "timestamp": "05:27:40", "text": "待って、これは違う。"}, {"type": "subtitle", "time": 19666.15, "timestamp": "05:27:46", "text": "ああ、すごいね。あなたは、ああ、"}, {"type": "subtitle", "time": 19669.11, "timestamp": "05:27:49", "text": "神。例えば、これがあなたの最終ランクです。"}, {"type": "subtitle", "time": 19671.75, "timestamp": "05:27:51", "text": "右？最高レベル。あなたは現在"}, {"type": "subtitle", "time": 19674.15, "timestamp": "05:27:54", "text": "この紫色のものみたいに。これはまるで"}, {"type": "subtitle", "time": 19676.51, "timestamp": "05:27:56", "text": "ダイヤモンド"}]
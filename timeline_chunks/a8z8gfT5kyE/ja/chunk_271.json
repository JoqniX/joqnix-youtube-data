[{"type": "subtitle", "time": 16261.83, "timestamp": "04:31:01", "text": "私は実際"}, {"type": "subtitle", "time": 16263.67, "timestamp": "04:31:03", "text": "えっと、なんて呼ぶんだっけ？ええ、昔は"}, {"type": "subtitle", "time": 16266.269, "timestamp": "04:31:06", "text": "12時間ごとにストリーム配信するのが好きです"}, {"type": "subtitle", "time": 16269.189, "timestamp": "04:31:09", "text": "毎日、本当に"}, {"type": "subtitle", "time": 16271.51, "timestamp": "04:31:11", "text": "病気とか色々。だから私はこう思った、"}, {"type": "subtitle", "time": 16273.51, "timestamp": "04:31:13", "text": "「ああ、知ってる？実は、"}, {"type": "subtitle", "time": 16275.389, "timestamp": "04:31:15", "text": "私の健康管理と"}, {"type": "subtitle", "time": 16276.91, "timestamp": "04:31:16", "text": "実は"}, {"type": "subtitle", "time": 16280.229, "timestamp": "04:31:20", "text": "ストリームレス。」だから、そう。だから、6時間または"}, {"type": "subtitle", "time": 16282.55, "timestamp": "04:31:22", "text": "たぶん、最大6時間くらいかな。だから、私は"}, {"type": "subtitle", "time": 16286.389, "timestamp": "04:31:26", "text": "知る。今日は最低でも3時間はかかるだろう。"}]
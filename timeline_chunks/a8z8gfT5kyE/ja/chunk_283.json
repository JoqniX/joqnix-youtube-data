[{"type": "subtitle", "time": 16982.51, "timestamp": "04:43:02", "text": "ええ、それは"}, {"type": "subtitle", "time": 16986.628, "timestamp": "04:43:06", "text": "問題。ユキさんのようにうまくいってよかったです。病気"}, {"type": "subtitle", "time": 17026.19, "timestamp": "04:43:46", "text": "私はそうすべきではなかった"}, {"type": "subtitle", "time": 17028.708, "timestamp": "04:43:48", "text": "それ。私には中国人の友人がいます。私"}, {"type": "subtitle", "time": 17030.39, "timestamp": "04:43:50", "text": "彼に聞いてみるかな。うん、できるよ"}]
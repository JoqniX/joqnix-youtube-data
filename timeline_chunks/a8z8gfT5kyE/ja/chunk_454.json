[{"type": "subtitle", "time": 27242.868, "timestamp": "07:34:02", "text": "イチロー。うん、このゲームはちょっと"}, {"type": "subtitle", "time": 27246.548, "timestamp": "07:34:06", "text": "ヴァレランエイペックスからの混合要素と"}, {"type": "subtitle", "time": 27249.91, "timestamp": "07:34:09", "text": "ある意味、オーバーウォッチのようなものだ。さらに、次のように書きます"}, {"type": "subtitle", "time": 27252.628, "timestamp": "07:34:12", "text": "本愛は友達のように影響を与え、"}, {"type": "subtitle", "time": 27254.99, "timestamp": "07:34:14", "text": "関係性 性格 関係性"}, {"type": "subtitle", "time": 27259.03, "timestamp": "07:34:19", "text": "システムとニックの電話でチャットする"}, {"type": "subtitle", "time": 27260.67, "timestamp": "07:34:20", "text": "文字のやつですよね？それ"}, {"type": "subtitle", "time": 27268.868, "timestamp": "07:34:28", "text": "ゲーム。なかなか面白いゲームだよ。願う"}, {"type": "subtitle", "time": 27272.948, "timestamp": "07:34:32", "text": "まもなくグローバル版がリリースされます。"}, {"type": "subtitle", "time": 27284.91, "timestamp": "07:34:44", "text": "低い。の"}, {"type": "subtitle", "time": 27295.75, "timestamp": "07:34:55", "text": "お手伝いに来ました。大丈夫。心配ない。"}, {"type": "subtitle", "time": 27297.23, "timestamp": "07:34:57", "text": "私"}, {"type": "subtitle", "time": 27299.788, "timestamp": "07:34:59", "text": "つまり、私たちはまだ"}]
[{"type": "subtitle", "time": 21001.19, "timestamp": "05:50:01", "text": "けれど。そもそも私はそんなに上手じゃないんです。だから私は"}, {"type": "subtitle", "time": 21015.51, "timestamp": "05:50:15", "text": "お腹がすいた。私もDeagleを使うべきですね。しかし"}, {"type": "subtitle", "time": 21017.868, "timestamp": "05:50:17", "text": "デザートイーグル、私は得意じゃないんです"}, {"type": "subtitle", "time": 21042.788, "timestamp": "05:50:42", "text": "まるで、私は好きになれない、どこ"}, {"type": "subtitle", "time": 21045.19, "timestamp": "05:50:45", "text": "え、誰？待って、忘れてた、えっと、忘れてた"}, {"type": "subtitle", "time": 21047.59, "timestamp": "05:50:47", "text": "名前を読んでください。"}, {"type": "subtitle", "time": 21050.788, "timestamp": "05:50:50", "text": "雌犬がまた男に戻った。"}, {"type": "subtitle", "time": 21052.51, "timestamp": "05:50:52", "text": "読書ができたらいいのに"}]
[{"type": "subtitle", "time": 19210.31, "timestamp": "05:20:10", "text": "鼻。しかし、我々は勝利している。あ、待って。私たちは"}, {"type": "subtitle", "time": 19212.708, "timestamp": "05:20:12", "text": "実際に勝っている。実際にプレイするべき"}, {"type": "subtitle", "time": 19253.868, "timestamp": "05:20:53", "text": "いいえ、それは"}, {"type": "subtitle", "time": 19257.03, "timestamp": "05:20:57", "text": "わかった。その"}]
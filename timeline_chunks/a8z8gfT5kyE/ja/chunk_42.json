[{"type": "subtitle", "time": 2521.51, "timestamp": "00:42:01", "text": "何だって？"}, {"type": "subtitle", "time": 2525.71, "timestamp": "00:42:05", "text": "彼女はどうやって"}, {"type": "subtitle", "time": 2527.95, "timestamp": "00:42:07", "text": "[音楽]"}, {"type": "subtitle", "time": 2531.75, "timestamp": "00:42:11", "text": "そこには？何てことだ。"}, {"type": "subtitle", "time": 2535.39, "timestamp": "00:42:15", "text": "ええ、いくつかあります"}, {"type": "subtitle", "time": 2552.069, "timestamp": "00:42:32", "text": "ここ。うん。うん。うん。そしてUber。"}, {"type": "subtitle", "time": 2559.43, "timestamp": "00:42:39", "text": "うん。今行ってる。"}, {"type": "subtitle", "time": 2561.43, "timestamp": "00:42:41", "text": "さあ、どうぞ。私はほとんど希望を失っていた"}, {"type": "subtitle", "time": 2564.87, "timestamp": "00:42:44", "text": "これまでで。私は天才少女なのよ、知ってるでしょ？はい。"}, {"type": "subtitle", "time": 2573.829, "timestamp": "00:42:53", "text": "このコースを修了すると、"}]
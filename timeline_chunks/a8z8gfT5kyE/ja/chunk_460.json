[{"type": "subtitle", "time": 27617.15, "timestamp": "07:40:17", "text": "これ。"}, {"type": "subtitle", "time": 27618.67, "timestamp": "07:40:18", "text": "おお、"}, {"type": "subtitle", "time": 27622.388, "timestamp": "07:40:22", "text": "ニース。ああ。"}, {"type": "subtitle", "time": 27635.19, "timestamp": "07:40:35", "text": "決して焦ってはいけません。彼女は本当にタフだ。"}, {"type": "subtitle", "time": 27637.948, "timestamp": "07:40:37", "text": "え、本当に？ああ、"}, {"type": "subtitle", "time": 27640.5, "timestamp": "07:40:40", "text": "神。君がプレイするのも当然だ"}, {"type": "subtitle", "time": 27649.43, "timestamp": "07:40:49", "text": "ミンゴ。何てことだ。うん、ミンはこんな感じ"}, {"type": "subtitle", "time": 27651.67, "timestamp": "07:40:51", "text": "もっと攻撃的になるのは、"}, {"type": "subtitle", "time": 27659.75, "timestamp": "07:40:59", "text": "だから、いつあなたが"}]
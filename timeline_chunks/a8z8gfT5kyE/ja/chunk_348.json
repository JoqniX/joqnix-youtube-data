[{"type": "subtitle", "time": 20882.19, "timestamp": "05:48:02", "text": "ニース。いいえ、私は"}, {"type": "subtitle", "time": 20885.43, "timestamp": "05:48:05", "text": "やめてください。えっと、ハクはまるで第二の人生のようなもので、"}, {"type": "subtitle", "time": 20888.39, "timestamp": "05:48:08", "text": "HPが低くなる。ああ、それはすごくクールだね。"}, {"type": "subtitle", "time": 20891.27, "timestamp": "05:48:11", "text": "それはあなたを元気にしてくれるでしょう。おお。低いみたい"}, {"type": "subtitle", "time": 20894.868, "timestamp": "05:48:14", "text": "ヴァレラントより。でも、それは"}, {"type": "subtitle", "time": 20897.948, "timestamp": "05:48:17", "text": "死後。いいえ、こちらです"}, {"type": "subtitle", "time": 20901.27, "timestamp": "05:48:21", "text": "例えば、HPが低い時など。低い。わかった。手に入れた"}, {"type": "subtitle", "time": 20902.52, "timestamp": "05:48:22", "text": "あなた。"}, {"type": "subtitle", "time": 20916.57, "timestamp": "05:48:36", "text": "男"}, {"type": "subtitle", "time": 20918.67, "timestamp": "05:48:38", "text": "[音楽]"}, {"type": "subtitle", "time": 20921.948, "timestamp": "05:48:41", "text": "ランクイン。これらはトップですか"}, {"type": "subtitle", "time": 20930.39, "timestamp": "05:48:50", "text": "神。私はおそらくこのように配置するでしょう"}, {"type": "subtitle", "time": 20932.47, "timestamp": "05:48:52", "text": "ランクとか、そういうもの。私はそうは思わない"}, {"type": "subtitle", "time": 20933.868, "timestamp": "05:48:53", "text": "場所"}, {"type": "subtitle", "time": 20936.23, "timestamp": "05:48:56", "text": "こういうランクとか、そういう感じ。私はしません"}, {"type": "subtitle", "time": 20939.43, "timestamp": "05:48:59", "text": "知る。ええと、見てみましょう。"}]
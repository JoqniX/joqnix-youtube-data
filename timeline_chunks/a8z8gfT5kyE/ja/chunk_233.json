[{"type": "subtitle", "time": 13987.309, "timestamp": "03:53:07", "text": "課題。"}, {"type": "subtitle", "time": 13998.15, "timestamp": "03:53:18", "text": "違う。わかった、私は"}, {"type": "subtitle", "time": 14005.349, "timestamp": "03:53:25", "text": "インストールしなければなりません。わかった、だって私は"}, {"type": "subtitle", "time": 14007.75, "timestamp": "03:53:27", "text": "誰か彼女を引き取ってほしい。私は"}, {"type": "subtitle", "time": 14009.91, "timestamp": "03:53:29", "text": "彼女を演じる。私は彼女をよくプレイしています。"}, {"type": "subtitle", "time": 14012.46, "timestamp": "03:53:32", "text": "まあ、そうですね。"}, {"type": "subtitle", "time": 14029.11, "timestamp": "03:53:49", "text": "中には、実際には使わない方が良いと思うものもある"}, {"type": "subtitle", "time": 14035.189, "timestamp": "03:53:55", "text": "刀、近接戦闘、なぜなら"}, {"type": "subtitle", "time": 14038.309, "timestamp": "03:53:58", "text": "それは何と呼ばれますか？ SMG が"}]
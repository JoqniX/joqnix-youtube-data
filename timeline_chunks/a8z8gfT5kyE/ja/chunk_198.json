[{"type": "subtitle", "time": 11880.07, "timestamp": "03:18:00", "text": "それ。ああ、両方のアカウントがブロックされた"}, {"type": "subtitle", "time": 11890.349, "timestamp": "03:18:10", "text": "えっと、でも一体どういう理由で？理解できない"}, {"type": "subtitle", "time": 11897.19, "timestamp": "03:18:17", "text": "えっと、実は私、何か間違ったことをしたのかな？"}, {"type": "subtitle", "time": 11902.11, "timestamp": "03:18:22", "text": "私は誰かを失望させてしまったのだろうか？私は"}, {"type": "subtitle", "time": 11913.71, "timestamp": "03:18:33", "text": "私は彼らとはほとんど交流がなかった。"}, {"type": "subtitle", "time": 11915.79, "timestamp": "03:18:35", "text": "それで"}, {"type": "subtitle", "time": 11922.19, "timestamp": "03:18:42", "text": "奇数。ええ、それは"}]
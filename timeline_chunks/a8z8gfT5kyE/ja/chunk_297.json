[{"type": "subtitle", "time": 17820.07, "timestamp": "04:57:00", "text": "でも私は、そう、枯れゆく車輪、いや"}, {"type": "subtitle", "time": 17821.83, "timestamp": "04:57:01", "text": "空間。"}, {"type": "subtitle", "time": 17824.55, "timestamp": "04:57:04", "text": "スペースを空けなくちゃ。"}, {"type": "subtitle", "time": 17827.15, "timestamp": "04:57:07", "text": "ああ、このショットガンは"}, {"type": "subtitle", "time": 17835.39, "timestamp": "04:57:15", "text": "[音楽]"}, {"type": "subtitle", "time": 17847.91, "timestamp": "04:57:27", "text": "ここ。それは、えーと、ハンガリーのようなモバイルゲームです"}]
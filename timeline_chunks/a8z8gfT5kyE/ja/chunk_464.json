[{"type": "subtitle", "time": 27850.708, "timestamp": "07:44:10", "text": "右。ああ、この試合は俺たちが勝つ。願っています"}, {"type": "subtitle", "time": 27879.91, "timestamp": "07:44:39", "text": "ああ、送れませんでした。 O."}, {"type": "subtitle", "time": 27889.07, "timestamp": "07:44:49", "text": "よし、ランクが上がるぞ。ブロンズ、"}, {"type": "subtitle", "time": 27892.11, "timestamp": "07:44:52", "text": "右？それは"}, {"type": "subtitle", "time": 27895.868, "timestamp": "07:44:55", "text": "ブロンズ？待って、これは何だ？"}, {"type": "subtitle", "time": 27898.35, "timestamp": "07:44:58", "text": "ブロンズ？それはブロンズです、"}]
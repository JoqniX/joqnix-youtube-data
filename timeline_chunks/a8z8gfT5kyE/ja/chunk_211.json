[{"type": "subtitle", "time": 12662.71, "timestamp": "03:31:02", "text": "うん。何てことだ。そして、あの人を知っているでしょう"}, {"type": "subtitle", "time": 12664.55, "timestamp": "03:31:04", "text": "私が知っている最初のことは"}, {"type": "subtitle", "time": 12667.15, "timestamp": "03:31:07", "text": "最初 最初 最初 最初 最初"}, {"type": "subtitle", "time": 12671.59, "timestamp": "03:31:11", "text": "実際に動画を投稿する時が来た"}, {"type": "subtitle", "time": 12673.91, "timestamp": "03:31:13", "text": "ハイライトか何かで、"}, {"type": "subtitle", "time": 12677.91, "timestamp": "03:31:17", "text": "あまりにも多くて、私はそうすべきではないと感じていました"}, {"type": "subtitle", "time": 12679.51, "timestamp": "03:31:19", "text": "そういうことをする。これはまるで"}, {"type": "subtitle", "time": 12682.55, "timestamp": "03:31:22", "text": "文字通り午前4時です。わかりました。だって私は"}, {"type": "subtitle", "time": 12685.19, "timestamp": "03:31:25", "text": "ちょっと疲れていた。そして私は「えーと」"}, {"type": "subtitle", "time": 12688.15, "timestamp": "03:31:28", "text": "のように"}, {"type": "subtitle", "time": 12692.309, "timestamp": "03:31:32", "text": "Vのダウンロードを待っています"}, {"type": "subtitle", "time": 12696.269, "timestamp": "03:31:36", "text": "などなど。だから私はこう思った"}, {"type": "subtitle", "time": 12699.11, "timestamp": "03:31:39", "text": "問題。品質が悪く、"}, {"type": "subtitle", "time": 12701.99, "timestamp": "03:31:41", "text": "すべて。アップロードすべきかと思った"}, {"type": "subtitle", "time": 12705.19, "timestamp": "03:31:45", "text": "人々はそれを好きか嫌いか？私は"}, {"type": "subtitle", "time": 12709.83, "timestamp": "03:31:49", "text": "とても心配そうに。ああ、でもそうだね。えっと、それで私は"}, {"type": "subtitle", "time": 12713.349, "timestamp": "03:31:53", "text": "私のPCが処理できるかどうか考えてみました。"}, {"type": "subtitle", "time": 12716.71, "timestamp": "03:31:56", "text": "録音してみます。でも問題は、私は"}]
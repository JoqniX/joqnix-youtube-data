[{"type": "subtitle", "time": 4745.229, "timestamp": "01:19:05", "text": "on Jumper. Nice."}, {"type": "subtitle", "time": 4754.07, "timestamp": "01:19:14", "text": "A concept in which two or more people"}, {"type": "subtitle", "time": 4754.83, "timestamp": "01:19:14", "text": "work"}, {"type": "subtitle", "time": 4757.55, "timestamp": "01:19:17", "text": "together with the goal of not failing."}, {"type": "subtitle", "time": 4789.189, "timestamp": "01:19:49", "text": "You will know it when you find it. Can I"}, {"type": "subtitle", "time": 4791.35, "timestamp": "01:19:51", "text": "jump to here?"}, {"type": "subtitle", "time": 4793.83, "timestamp": "01:19:53", "text": "No."}]
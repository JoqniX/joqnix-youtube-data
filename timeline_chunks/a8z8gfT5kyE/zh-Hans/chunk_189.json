[{"type": "subtitle", "time": 11345.75, "timestamp": "03:09:05", "text": "哟，这家伙真够逊的。为什么每个人"}, {"type": "subtitle", "time": 11348.15, "timestamp": "03:09:08", "text": "你是不是为他疯狂了？他是导演"}, {"type": "subtitle", "time": 11350.469, "timestamp": "03:09:10", "text": "还有你的表弟。你做的任何事情"}, {"type": "subtitle", "time": 11355.429, "timestamp": "03:09:15", "text": "火。是的，这是我的电影。看见你了。看"}, {"type": "subtitle", "time": 11358.15, "timestamp": "03:09:18", "text": "看看这家伙。"}, {"type": "subtitle", "time": 11365.11, "timestamp": "03:09:25", "text": "这笔钱是我们的。"}]
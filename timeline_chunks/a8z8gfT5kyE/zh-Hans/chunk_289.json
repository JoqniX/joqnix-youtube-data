[{"type": "subtitle", "time": 17351.07, "timestamp": "04:49:11", "text": "在哪里？哦，是的。呃，是枪，对吧？是"}, {"type": "subtitle", "time": 17361.27, "timestamp": "04:49:21", "text": "男。所以，我有足够的钱去解锁一个"}, {"type": "subtitle", "time": 17363.03, "timestamp": "04:49:23", "text": "特点。就是这样。所以，我是"}, {"type": "subtitle", "time": 17365.15, "timestamp": "04:49:25", "text": "比如，我应该选择"}, {"type": "subtitle", "time": 17369.43, "timestamp": "04:49:29", "text": "还是我跟她一起去？"}, {"type": "subtitle", "time": 17372.39, "timestamp": "04:49:32", "text": "两者各有千秋。如果我想去"}, {"type": "subtitle", "time": 17380.47, "timestamp": "04:49:40", "text": "她。我想我忘了她的能力是什么了。"}, {"type": "subtitle", "time": 17381.948, "timestamp": "04:49:41", "text": "曾是，"}, {"type": "subtitle", "time": 17384.788, "timestamp": "04:49:44", "text": "但她也很有趣。她是"}, {"type": "subtitle", "time": 17386.27, "timestamp": "04:49:46", "text": "咄咄逼人"}, {"type": "subtitle", "time": 17389.27, "timestamp": "04:49:49", "text": "乐趣。她用的是霰弹枪。她是"}, {"type": "subtitle", "time": 17390.83, "timestamp": "04:49:50", "text": "咄咄逼人"}, {"type": "subtitle", "time": 17393.75, "timestamp": "04:49:53", "text": "乐趣。啊，你知道吗？我还是会说我"}, {"type": "subtitle", "time": 17396.19, "timestamp": "04:49:56", "text": "我想存钱。我不想"}]
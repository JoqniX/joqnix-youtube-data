[{"type": "subtitle", "time": 2707.91, "timestamp": "00:45:07", "text": "获得五项科学合作"}, {"type": "subtitle", "time": 2719.03, "timestamp": "00:45:19", "text": "哈利·波特。我知道。我知道。不，不"}, {"type": "subtitle", "time": 2723.109, "timestamp": "00:45:23", "text": "不。我没有开门。哦，等等。"}, {"type": "subtitle", "time": 2725.27, "timestamp": "00:45:25", "text": "睁开你的眼睛。"}, {"type": "subtitle", "time": 2727.51, "timestamp": "00:45:27", "text": "呃，回去吧。"}, {"type": "subtitle", "time": 2735.15, "timestamp": "00:45:35", "text": "按钮。"}, {"type": "subtitle", "time": 2736.99, "timestamp": "00:45:36", "text": "呃，按钮"}, {"type": "subtitle", "time": 2738.51, "timestamp": "00:45:38", "text": "[音乐]"}, {"type": "subtitle", "time": 2741.71, "timestamp": "00:45:41", "text": "按钮。按钮。这边。超过"}, {"type": "subtitle", "time": 2743.57, "timestamp": "00:45:43", "text": "那里。"}, {"type": "subtitle", "time": 2745.15, "timestamp": "00:45:45", "text": "[音乐]"}]
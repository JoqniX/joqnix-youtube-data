[{"type": "subtitle", "time": 13694.59, "timestamp": "03:48:14", "text": "我的天啊。我的天啊。哦，我的"}, {"type": "subtitle", "time": 13713.11, "timestamp": "03:48:33", "text": "真烂。哦。她安排的。墙"}, {"type": "subtitle", "time": 13718.51, "timestamp": "03:48:38", "text": "向上。你这狡猾的家伙！"}, {"type": "subtitle", "time": 13739.51, "timestamp": "03:48:59", "text": "尽管。我看不见。"}]
[{"type": "subtitle", "time": 15120.349, "timestamp": "04:12:00", "text": "错误的。是的。看看她。她真是太"}, {"type": "subtitle", "time": 15123.67, "timestamp": "04:12:03", "text": "可爱。那层皮肤。还有奥黛丽"}, {"type": "subtitle", "time": 15126.75, "timestamp": "04:12:06", "text": "也很可爱。那位红发女士也是"}, {"type": "subtitle", "time": 15129.99, "timestamp": "04:12:09", "text": "可爱的。我喜欢它们。我想解锁所有"}, {"type": "subtitle", "time": 15133.63, "timestamp": "04:12:13", "text": "他们中的。多尔，看看她的皮肤。"}, {"type": "subtitle", "time": 15137.189, "timestamp": "04:12:17", "text": "可爱。我该如何解锁？"}, {"type": "subtitle", "time": 15144.15, "timestamp": "04:12:24", "text": "难的。嗨，乔。我们多年前相遇。是的。"}, {"type": "subtitle", "time": 15146.87, "timestamp": "04:12:26", "text": "已经过去一段时间了。"}, {"type": "subtitle", "time": 15154.83, "timestamp": "04:12:34", "text": "[音乐]"}, {"type": "subtitle", "time": 15157.389, "timestamp": "04:12:37", "text": "到过？"}, {"type": "subtitle", "time": 15174.91, "timestamp": "04:12:54", "text": "是吗？"}]
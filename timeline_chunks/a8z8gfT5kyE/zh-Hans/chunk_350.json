[{"type": "subtitle", "time": 21001.19, "timestamp": "05:50:01", "text": "尽管。我本来就没那么厉害。所以，我"}, {"type": "subtitle", "time": 21015.51, "timestamp": "05:50:15", "text": "饥饿的。我也应该用沙漠之鹰。但"}, {"type": "subtitle", "time": 21017.868, "timestamp": "05:50:17", "text": "沙鹰，我不擅长用它"}, {"type": "subtitle", "time": 21042.788, "timestamp": "05:50:42", "text": "就像我不能喜欢“哪里是……”"}, {"type": "subtitle", "time": 21045.19, "timestamp": "05:50:45", "text": "等等，是谁？等等，我忘了，呃，我忘了……"}, {"type": "subtitle", "time": 21047.59, "timestamp": "05:50:47", "text": "读出名字。"}, {"type": "subtitle", "time": 21050.788, "timestamp": "05:50:50", "text": "婊子又变回男孩了。"}, {"type": "subtitle", "time": 21052.51, "timestamp": "05:50:52", "text": "我希望我能读书"}]
[{"type": "subtitle", "time": 20101.948, "timestamp": "05:35:01", "text": "[音乐]"}, {"type": "subtitle", "time": 20111.07, "timestamp": "05:35:11", "text": "呃，我用拉普拉斯来"}, {"type": "subtitle", "time": 20123.628, "timestamp": "05:35:23", "text": "但在这个游戏中，补充水分至关重要。"}, {"type": "subtitle", "time": 20135.39, "timestamp": "05:35:35", "text": "ID。在那里"}, {"type": "subtitle", "time": 20139.15, "timestamp": "05:35:39", "text": "去。哦，我用了我的水卡。我"}, {"type": "subtitle", "time": 20141.83, "timestamp": "05:35:41", "text": "忘了。哦，是的。我的虾块是"}, {"type": "subtitle", "time": 20150.628, "timestamp": "05:35:50", "text": "真是个好人。还有，我听到我的"}, {"type": "subtitle", "time": 20153.47, "timestamp": "05:35:53", "text": "自己的流。音频听起来不像"}, {"type": "subtitle", "time": 20158.83, "timestamp": "05:35:58", "text": "均衡？我需要降低游戏难度吗？"}]
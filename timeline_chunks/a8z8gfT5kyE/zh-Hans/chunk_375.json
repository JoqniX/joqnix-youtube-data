[{"type": "subtitle", "time": 22500.75, "timestamp": "06:15:00", "text": "我会加速跑"}, {"type": "subtitle", "time": 22503.19, "timestamp": "06:15:03", "text": "去。这首歌在……中不起作用"}, {"type": "subtitle", "time": 22512.11, "timestamp": "06:15:12", "text": "工作？你的意思是“不”吗？"}, {"type": "subtitle", "time": 22516.868, "timestamp": "06:15:16", "text": "工作？我可能需要调查一下。"}, {"type": "subtitle", "time": 22522.11, "timestamp": "06:15:22", "text": "我只是希望如此。我彻底绝望了。啊。哦"}, {"type": "subtitle", "time": 22530.67, "timestamp": "06:15:30", "text": "不。"}, {"type": "subtitle", "time": 22535.39, "timestamp": "06:15:35", "text": "波。那我还是先去拿我的吧。"}, {"type": "subtitle", "time": 22537.99, "timestamp": "06:15:37", "text": "好的。我会调查第二个问题。"}, {"type": "subtitle", "time": 22540.628, "timestamp": "06:15:40", "text": "事物。我没有设置提醒功能。"}, {"type": "subtitle", "time": 22544.39, "timestamp": "06:15:44", "text": "所以我不知道，我甚至都不会知道。"}, {"type": "subtitle", "time": 22545.868, "timestamp": "06:15:45", "text": "所以"}, {"type": "subtitle", "time": 22548.75, "timestamp": "06:15:48", "text": "是的"}, {"type": "subtitle", "time": 22552.07, "timestamp": "06:15:52", "text": "呃，如果还有其他人想加入的话……"}, {"type": "subtitle", "time": 22556.99, "timestamp": "06:15:56", "text": "如果有人想加入的话。"}, {"type": "subtitle", "time": 22559.15, "timestamp": "06:15:59", "text": "好的。是"}]
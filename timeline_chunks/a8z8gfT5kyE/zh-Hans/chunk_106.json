[{"type": "subtitle", "time": 6361.83, "timestamp": "01:46:01", "text": "[音乐]"}, {"type": "subtitle", "time": 6370.31, "timestamp": "01:46:10", "text": "呃，跳到那里。我会接住的。"}, {"type": "subtitle", "time": 6377.75, "timestamp": "01:46:17", "text": "是的。哦是的。是的。是的。哦，是的。是的。"}, {"type": "subtitle", "time": 6392.87, "timestamp": "01:46:32", "text": "你做到了。"}, {"type": "subtitle", "time": 6395.35, "timestamp": "01:46:35", "text": "精彩的一次进攻。"}, {"type": "subtitle", "time": 6396.95, "timestamp": "01:46:36", "text": "好的。"}, {"type": "subtitle", "time": 6408.03, "timestamp": "01:46:48", "text": "女孩。你真是太"}, {"type": "subtitle", "time": 6415.43, "timestamp": "01:46:55", "text": "我身体强壮是因为我吃了药。"}, {"type": "subtitle", "time": 6416.95, "timestamp": "01:46:56", "text": "还记得我跟你说过你是"}, {"type": "subtitle", "time": 6419.189, "timestamp": "01:46:59", "text": "唯一通过校准的受试者"}]
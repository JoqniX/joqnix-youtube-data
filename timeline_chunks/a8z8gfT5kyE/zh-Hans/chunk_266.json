[{"type": "subtitle", "time": 15968.07, "timestamp": "04:26:08", "text": "我来了。我来了。我来了。我是"}, {"type": "subtitle", "time": 15985.11, "timestamp": "04:26:25", "text": "等等，我身上为什么会有这个画上去的东西？是"}, {"type": "subtitle", "time": 15994.389, "timestamp": "04:26:34", "text": "是那位扎着双马尾的女士吗？这是你的吗？"}, {"type": "subtitle", "time": 16000.149, "timestamp": "04:26:40", "text": "[音乐]"}, {"type": "subtitle", "time": 16017.35, "timestamp": "04:26:57", "text": "事物。嘿，你能用刀切开吗？"}]
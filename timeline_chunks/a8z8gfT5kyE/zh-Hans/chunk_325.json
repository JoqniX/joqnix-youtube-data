[{"type": "subtitle", "time": 19505.43, "timestamp": "05:25:05", "text": "好吧，你知道吗？我应该直接买一个吗？"}, {"type": "subtitle", "time": 19506.91, "timestamp": "05:25:06", "text": "但我也是"}, {"type": "subtitle", "time": 19510.47, "timestamp": "05:25:10", "text": "喜欢，但也要看看她。她"}, {"type": "subtitle", "time": 19513.67, "timestamp": "05:25:13", "text": "可爱。她留着短发，但她也是"}, {"type": "subtitle", "time": 19521.83, "timestamp": "05:25:21", "text": "你好，呃，Yia。我念对了吗？你的名字"}, {"type": "subtitle", "time": 19524.99, "timestamp": "05:25:24", "text": "正确的？欢迎来到直播间。你好。"}, {"type": "subtitle", "time": 19527.27, "timestamp": "05:25:27", "text": "你好。今天你是怎么找到我的？以及如何"}, {"type": "subtitle", "time": 19530.07, "timestamp": "05:25:30", "text": "你是？但是鲨鱼女孩呃"}, {"type": "subtitle", "time": 19533.51, "timestamp": "05:25:33", "text": "一件一件地买。是的。所以这就像是"}, {"type": "subtitle", "time": 19537.35, "timestamp": "05:25:37", "text": "右边有疤痕，我不知道这个"}, {"type": "subtitle", "time": 19544.948, "timestamp": "05:25:44", "text": "好的。 Uh Jo是那种人"}, {"type": "subtitle", "time": 19547.83, "timestamp": "05:25:47", "text": "带一把迷你机枪去玩气枪游戏"}, {"type": "subtitle", "time": 19552.15, "timestamp": "05:25:52", "text": "上面有Hello Kitty贴纸，还有战斗"}, {"type": "subtitle", "time": 19555.35, "timestamp": "05:25:55", "text": "动漫角色扮演服装。哦，对，那是皮尤。"}, {"type": "subtitle", "time": 19557.628, "timestamp": "05:25:57", "text": "砰砰砰"}]
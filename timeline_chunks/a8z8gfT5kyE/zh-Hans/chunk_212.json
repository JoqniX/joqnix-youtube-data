[{"type": "subtitle", "time": 12720.15, "timestamp": "03:32:00", "text": "多路直播和同时处理多项任务"}, {"type": "subtitle", "time": 12723.389, "timestamp": "03:32:03", "text": "一切。我不认为我能做到"}, {"type": "subtitle", "time": 12726.389, "timestamp": "03:32:06", "text": "实际上完成了一次本地录音"}, {"type": "subtitle", "time": 12729.19, "timestamp": "03:32:09", "text": "一边看视频一边听。是的，我会"}, {"type": "subtitle", "time": 12732.51, "timestamp": "03:32:12", "text": "我会尽力。患病的"}, {"type": "subtitle", "time": 12734.95, "timestamp": "03:32:14", "text": "尝试。在真人秀频道上，带我"}, {"type": "subtitle", "time": 12736.63, "timestamp": "03:32:16", "text": "年龄，找到能与之匹配的人"}, {"type": "subtitle", "time": 12739.03, "timestamp": "03:32:19", "text": "我想要的声音。所以我做了最理智的事。"}, {"type": "subtitle", "time": 12741.67, "timestamp": "03:32:21", "text": "事物。我发布了 Yoi 语音的广告"}, {"type": "subtitle", "time": 12743.429, "timestamp": "03:32:23", "text": "演员，我们终于找到了一个"}, {"type": "subtitle", "time": 12745.55, "timestamp": "03:32:25", "text": "可以跟着唱。"}, {"type": "subtitle", "time": 12751.67, "timestamp": "03:32:31", "text": "真好，太棒了。太酷了。"}, {"type": "subtitle", "time": 12754.469, "timestamp": "03:32:34", "text": "退伍军人事务部（VA）的招聘网站是什么来着？呃"}, {"type": "subtitle", "time": 12756.91, "timestamp": "03:32:36", "text": "那个平台，对吧？"}, {"type": "subtitle", "time": 12761.309, "timestamp": "03:32:41", "text": "嗯，我忘了。铸件。不，"}, {"type": "subtitle", "time": 12765.59, "timestamp": "03:32:45", "text": "某物。呃，我忘了它叫什么了。"}, {"type": "subtitle", "time": 12767.67, "timestamp": "03:32:47", "text": "呃，这里有一个平台，供那些……"}, {"type": "subtitle", "time": 12770.309, "timestamp": "03:32:50", "text": "也想要类似 VA 的声音。我想我看到了"}, {"type": "subtitle", "time": 12772.63, "timestamp": "03:32:52", "text": "Reality Studios 的简介"}, {"type": "subtitle", "time": 12773.95, "timestamp": "03:32:53", "text": "那里"}, {"type": "subtitle", "time": 12776.51, "timestamp": "03:32:56", "text": "出色地。嗯，我没有"}, {"type": "subtitle", "time": 12779.269, "timestamp": "03:32:59", "text": "知道。我好像注册过账号？我"}]
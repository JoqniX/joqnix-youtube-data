[{"type": "subtitle", "time": 27064.31, "timestamp": "07:31:04", "text": "你好。不，"}, {"type": "subtitle", "time": 27069.59, "timestamp": "07:31:09", "text": "我没有使用纸张模式。哦，"}, {"type": "subtitle", "time": 27071.75, "timestamp": "07:31:11", "text": "我在……呃……你问我为什么叫这个名字"}, {"type": "subtitle", "time": 27074.388, "timestamp": "07:31:14", "text": "感觉很陌生。我在哦，"}, {"type": "subtitle", "time": 27077.19, "timestamp": "07:31:17", "text": "是的。现在我想起来了。哦，谢谢"}, {"type": "subtitle", "time": 27080.99, "timestamp": "07:31:20", "text": "谢谢你提醒我。"}, {"type": "subtitle", "time": 27084.23, "timestamp": "07:31:24", "text": "啊，妈妈不太活跃。"}, {"type": "subtitle", "time": 27100.03, "timestamp": "07:31:40", "text": "打猎。啊，他明白了。"}, {"type": "subtitle", "time": 27103.99, "timestamp": "07:31:43", "text": "还不错。"}, {"type": "subtitle", "time": 27106.388, "timestamp": "07:31:46", "text": "呃，你也把自己暴露出来了。"}, {"type": "subtitle", "time": 27110.03, "timestamp": "07:31:50", "text": "很多。躲在角落里。好的，我会"}, {"type": "subtitle", "time": 27113.11, "timestamp": "07:31:53", "text": "尝试。我需要习惯纸张的使用。"}, {"type": "subtitle", "time": 27115.548, "timestamp": "07:31:55", "text": "模式。我没用它"}, {"type": "subtitle", "time": 27119.19, "timestamp": "07:31:59", "text": "很多。拍摄结束后我不会做这件事。"}, {"type": "subtitle", "time": 27119.948, "timestamp": "07:31:59", "text": "和"}]
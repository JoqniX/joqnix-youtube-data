[{"type": "subtitle", "time": 666.07, "timestamp": "00:11:06", "text": "演讲前。"}, {"type": "subtitle", "time": 676.42, "timestamp": "00:11:16", "text": "全部"}, {"type": "subtitle", "time": 677.79, "timestamp": "00:11:17", "text": "[音乐]"}, {"type": "subtitle", "time": 680.35, "timestamp": "00:11:20", "text": "正确的。我是"}, {"type": "subtitle", "time": 683.55, "timestamp": "00:11:23", "text": "后退。是的，我刚洗完脸。"}, {"type": "subtitle", "time": 690.949, "timestamp": "00:11:30", "text": "后退。我问自己，我为什么要推？"}, {"type": "subtitle", "time": 709.71, "timestamp": "00:11:49", "text": "脑。是啊，我的腿疼。"}, {"type": "subtitle", "time": 712.87, "timestamp": "00:11:52", "text": "很多，你知道的。呃，就像我想在……之后"}, {"type": "subtitle", "time": 714.99, "timestamp": "00:11:54", "text": "一两个小时后，我就……"}, {"type": "subtitle", "time": 718.63, "timestamp": "00:11:58", "text": "呃，放个炸弹什么的。不是"}]
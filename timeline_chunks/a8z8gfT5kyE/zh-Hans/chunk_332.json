[{"type": "subtitle", "time": 19922.19, "timestamp": "05:32:02", "text": "等等，它应该会致命。所以如果我达到"}, {"type": "subtitle", "time": 19925.35, "timestamp": "05:32:05", "text": "直到20级之后，我就拿不到了。"}, {"type": "subtitle", "time": 19927.99, "timestamp": "05:32:07", "text": "这个纸片。我该如何才能得到"}, {"type": "subtitle", "time": 19930.27, "timestamp": "05:32:10", "text": "那"}, {"type": "subtitle", "time": 19932.79, "timestamp": "05:32:12", "text": "东西？我该如何才能得到这个"}, {"type": "subtitle", "time": 19938.35, "timestamp": "05:32:18", "text": "[音乐]"}, {"type": "subtitle", "time": 19942.36, "timestamp": "05:32:22", "text": "东西？我该如何才能拿到这些东西？"}, {"type": "subtitle", "time": 19945.15, "timestamp": "05:32:25", "text": "[音乐]"}, {"type": "subtitle", "time": 19947.99, "timestamp": "05:32:27", "text": "尽管？好的，我来教你。一场比赛"}, {"type": "subtitle", "time": 19950.75, "timestamp": "05:32:30", "text": "给你一个游戏给你"}, {"type": "subtitle", "time": 19953.628, "timestamp": "05:32:33", "text": "哦，明白了"}, {"type": "subtitle", "time": 19956.11, "timestamp": "05:32:36", "text": "它。尽情玩吧。"}, {"type": "subtitle", "time": 19967.03, "timestamp": "05:32:47", "text": "好的。如果你想加入，请告诉我。"}, {"type": "subtitle", "time": 19970.11, "timestamp": "05:32:50", "text": "[音乐]"}, {"type": "subtitle", "time": 19979.31, "timestamp": "05:32:59", "text": "呃"}]
[{"type": "subtitle", "time": 4624.47, "timestamp": "01:17:04", "text": "[音乐]"}, {"type": "subtitle", "time": 4628.229, "timestamp": "01:17:08", "text": "我没资格说你坏话。"}, {"type": "subtitle", "time": 4657.709, "timestamp": "01:17:37", "text": "哦好的。好的。好的。"}, {"type": "subtitle", "time": 4665.47, "timestamp": "01:17:45", "text": "皮卡丘。你好。所以，"}, {"type": "subtitle", "time": 4667.39, "timestamp": "01:17:47", "text": "那里"}, {"type": "subtitle", "time": 4671.87, "timestamp": "01:17:51", "text": "皮卡丘，出发！哦，什么？"}, {"type": "subtitle", "time": 4674.87, "timestamp": "01:17:54", "text": "水。不，不，不。"}, {"type": "subtitle", "time": 4676.71, "timestamp": "01:17:56", "text": "哦，你好。你好。你好。你好。"}, {"type": "subtitle", "time": 4678.75, "timestamp": "01:17:58", "text": "[音乐]"}]
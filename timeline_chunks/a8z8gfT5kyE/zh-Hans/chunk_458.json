[{"type": "subtitle", "time": 27483.99, "timestamp": "07:38:03", "text": "上帝。啊，不错。所以，那位埃及女士"}, {"type": "subtitle", "time": 27486.948, "timestamp": "07:38:06", "text": "可以漂浮。哦，她会漂浮。我应该"}, {"type": "subtitle", "time": 27489.27, "timestamp": "07:38:09", "text": "下次带她去。我将解锁"}, {"type": "subtitle", "time": 27497.35, "timestamp": "07:38:17", "text": "哦，那是谁？是我。等等，那是我。"}, {"type": "subtitle", "time": 27499.19, "timestamp": "07:38:19", "text": "哦，"}, {"type": "subtitle", "time": 27517.548, "timestamp": "07:38:37", "text": "呃，我以为是"}, {"type": "subtitle", "time": 27537.23, "timestamp": "07:38:57", "text": "哦，我们赢了。哦，"}, {"type": "subtitle", "time": 27539.07, "timestamp": "07:38:59", "text": "好的。我的"}]
[{"type": "subtitle", "time": 16220.67, "timestamp": "04:30:20", "text": "你今天打算玩多久？"}, {"type": "subtitle", "time": 16225.349, "timestamp": "04:30:25", "text": "呃，我不知道。大概是因为我们"}, {"type": "subtitle", "time": 16229.189, "timestamp": "04:30:29", "text": "刚开始。不，我想我会玩。"}, {"type": "subtitle", "time": 16232.07, "timestamp": "04:30:32", "text": "我最多只能直播 6 分钟。"}, {"type": "subtitle", "time": 16233.95, "timestamp": "04:30:33", "text": "小时"}, {"type": "subtitle", "time": 16237.83, "timestamp": "04:30:37", "text": "嗯，是的，6 小时的直播只能是 6 小时。"}, {"type": "subtitle", "time": 16241.269, "timestamp": "04:30:41", "text": "可惜要花几个小时，而且如果我要做两件事的话。"}, {"type": "subtitle", "time": 16244.309, "timestamp": "04:30:44", "text": "然后我就可以上去观看直播了。"}, {"type": "subtitle", "time": 16247.389, "timestamp": "04:30:47", "text": "八小时，但必须在八小时内完成。"}, {"type": "subtitle", "time": 16250.67, "timestamp": "04:30:50", "text": "因为我就像"}, {"type": "subtitle", "time": 16255.67, "timestamp": "04:30:55", "text": "嗯，我感觉自己好像在限制自己不去做某件事。"}, {"type": "subtitle", "time": 16259.91, "timestamp": "04:30:59", "text": "像专业人士那样每天直播 12 小时。所以，我是"}]
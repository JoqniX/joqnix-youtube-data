[{"type": "subtitle", "time": 10560.63, "timestamp": "02:56:00", "text": "真的很有趣。如果你想的话"}, {"type": "subtitle", "time": 10564.389, "timestamp": "02:56:04", "text": "我知道为什么，我想说，我们俩都明白。"}, {"type": "subtitle", "time": 10567.71, "timestamp": "02:56:07", "text": "能够交流"}, {"type": "subtitle", "time": 10571.59, "timestamp": "02:56:11", "text": "用我那蹩脚的日语。我当时"}, {"type": "subtitle", "time": 10573.99, "timestamp": "02:56:13", "text": "能够与查尼萨交流。那"}, {"type": "subtitle", "time": 10574.99, "timestamp": "02:56:14", "text": "让我"}, {"type": "subtitle", "time": 10577.67, "timestamp": "02:56:17", "text": "开心吧？我们能够"}, {"type": "subtitle", "time": 10580.71, "timestamp": "02:56:20", "text": "我们互相理解，并努力做到最好。"}, {"type": "subtitle", "time": 10583.269, "timestamp": "02:56:23", "text": "即使是益智游戏，它也是最棒的"}, {"type": "subtitle", "time": 10588.55, "timestamp": "02:56:28", "text": "这很难。我们尽力了"}, {"type": "subtitle", "time": 10592.03, "timestamp": "02:56:32", "text": "而珍妮丝也是如此"}, {"type": "subtitle", "time": 10601.99, "timestamp": "02:56:41", "text": "嗯，她真的很聪明，而且她早就知道了。"}, {"type": "subtitle", "time": 10605.429, "timestamp": "02:56:45", "text": "如何做事。哦，那是我的第一次"}, {"type": "subtitle", "time": 10607.83, "timestamp": "02:56:47", "text": "这是我第一次玩传送门游戏。我"}, {"type": "subtitle", "time": 10611.91, "timestamp": "02:56:51", "text": "我看了那些油管博主，"}, {"type": "subtitle", "time": 10615.03, "timestamp": "02:56:55", "text": "YouTube上的主播们正在玩《传送门》游戏"}, {"type": "subtitle", "time": 10616.87, "timestamp": "02:56:56", "text": "Twitch，但我自己从来没玩过。"}]
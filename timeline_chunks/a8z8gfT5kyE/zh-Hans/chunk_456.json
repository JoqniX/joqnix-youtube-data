[{"type": "subtitle", "time": 27375.788, "timestamp": "07:36:15", "text": "我知道。我差点就逃脱了"}, {"type": "subtitle", "time": 27377.75, "timestamp": "07:36:17", "text": "请，请，请，请"}, {"type": "subtitle", "time": 27378.628, "timestamp": "07:36:18", "text": "求求你，求求你，求求你，求求你，求求你"}, {"type": "subtitle", "time": 27380.59, "timestamp": "07:36:20", "text": "求求你了。哦，我的"}, {"type": "subtitle", "time": 27383.628, "timestamp": "07:36:23", "text": "感谢上帝"}, {"type": "subtitle", "time": 27399.91, "timestamp": "07:36:39", "text": "好的。布拉德，你打算花多少钱？"}, {"type": "subtitle", "time": 27401.51, "timestamp": "07:36:41", "text": "玩这个游戏吗？我不知道。我是"}, {"type": "subtitle", "time": 27404.27, "timestamp": "07:36:44", "text": "上瘾了。不，我没有上瘾，但是……"}, {"type": "subtitle", "time": 27406.67, "timestamp": "07:36:46", "text": "乐趣。它比"}, {"type": "subtitle", "time": 27410.388, "timestamp": "07:36:50", "text": "瓦莱林。是的。"}, {"type": "subtitle", "time": 27411.628, "timestamp": "07:36:51", "text": "所以，"}, {"type": "subtitle", "time": 27414.868, "timestamp": "07:36:54", "text": "是的。我的意思是，这很有趣。我是说你，"}, {"type": "subtitle", "time": 27416.708, "timestamp": "07:36:56", "text": "我最终会休息一段时间。"}, {"type": "subtitle", "time": 27419.03, "timestamp": "07:36:59", "text": "来自《哦，不》。我会完成每日任务。"}]
[{"type": "subtitle", "time": 26820.07, "timestamp": "07:27:00", "text": "我没看见你。你这小鬼。快点。"}, {"type": "subtitle", "time": 26822.23, "timestamp": "07:27:02", "text": "什么？"}, {"type": "subtitle", "time": 26825.51, "timestamp": "07:27:05", "text": "不，我没看到她。我正在看"}, {"type": "subtitle", "time": 26837.948, "timestamp": "07:27:17", "text": "哦，等等。这家伙能"}, {"type": "subtitle", "time": 26863.15, "timestamp": "07:27:43", "text": "手榴弹？我正在打底。"}, {"type": "subtitle", "time": 26866.388, "timestamp": "07:27:46", "text": "哦，不。我被击落了。不，不"}, {"type": "subtitle", "time": 26869.43, "timestamp": "07:27:49", "text": "不，不，不，不，不，不，不。那很糟糕。"}]
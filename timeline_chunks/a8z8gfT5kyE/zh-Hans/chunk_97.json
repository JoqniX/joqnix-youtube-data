[{"type": "subtitle", "time": 5824.39, "timestamp": "01:37:04", "text": "确切地。她推我。你有没有看到"}, {"type": "subtitle", "time": 5825.68, "timestamp": "01:37:05", "text": "那？"}, {"type": "subtitle", "time": 5827.109, "timestamp": "01:37:07", "text": "[音乐]"}, {"type": "subtitle", "time": 5836.47, "timestamp": "01:37:16", "text": "我喜欢这些"}, {"type": "subtitle", "time": 5839.43, "timestamp": "01:37:19", "text": "在我的每日日记里。所有方式"}, {"type": "subtitle", "time": 5847.59, "timestamp": "01:37:27", "text": "那些完美的结果，没有"}, {"type": "subtitle", "time": 5868.629, "timestamp": "01:37:48", "text": "[音乐]"}]
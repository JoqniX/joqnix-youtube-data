[{"type": "subtitle", "time": 27421.03, "timestamp": "07:37:01", "text": "这就是活动挑战所在，因为"}, {"type": "subtitle", "time": 27422.468, "timestamp": "07:37:02", "text": "枯萎的车轮现在就在那里。所以，"}, {"type": "subtitle", "time": 27424.628, "timestamp": "07:37:04", "text": "明天我将枯萎凋零"}, {"type": "subtitle", "time": 27426.59, "timestamp": "07:37:06", "text": "哀嚎。"}, {"type": "subtitle", "time": 27430.15, "timestamp": "07:37:10", "text": "是的。没有哀嚎。枯萎。是的。"}, {"type": "subtitle", "time": 27432.548, "timestamp": "07:37:12", "text": "枯萎的摇曳。"}, {"type": "subtitle", "time": 27449.43, "timestamp": "07:37:29", "text": "乐趣。哦，你这小鬼。你是怎么起床的？"}, {"type": "subtitle", "time": 27451.91, "timestamp": "07:37:31", "text": "你是怎么起床的？我敲了你一下。如何"}, {"type": "subtitle", "time": 27454.11, "timestamp": "07:37:34", "text": "你起床了吗？"}, {"type": "subtitle", "time": 27458.67, "timestamp": "07:37:38", "text": "什么？你是怎么起床的？"}]
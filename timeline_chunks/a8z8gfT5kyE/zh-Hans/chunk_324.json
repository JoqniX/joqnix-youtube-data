[{"type": "subtitle", "time": 19442.31, "timestamp": "05:24:02", "text": "她。我该娶她吗？但还有"}, {"type": "subtitle", "time": 19445.27, "timestamp": "05:24:05", "text": "活动横幅现在有了。所以我可以……"}, {"type": "subtitle", "time": 19449.47, "timestamp": "05:24:09", "text": "枪。我可以使用"}, {"type": "subtitle", "time": 19454.31, "timestamp": "05:24:14", "text": "枪。是的。所以，我就想，呃，"}, {"type": "subtitle", "time": 19456.55, "timestamp": "05:24:16", "text": "对，动漫男孩。哦，是的。有这个"}, {"type": "subtitle", "time": 19462.47, "timestamp": "05:24:22", "text": "这个人，还有这个人，还有这个人。"}, {"type": "subtitle", "time": 19464.708, "timestamp": "05:24:24", "text": "呃，你喜欢哪种类型的武器？呃，"}, {"type": "subtitle", "time": 19468.55, "timestamp": "05:24:28", "text": "突突突的枪声。任何类型的袭击"}, {"type": "subtitle", "time": 19472.35, "timestamp": "05:24:32", "text": "步枪。对，砰砰砰砰"}, {"type": "subtitle", "time": 19481.708, "timestamp": "05:24:41", "text": "半自动狙击步枪。有"}, {"type": "subtitle", "time": 19483.23, "timestamp": "05:24:43", "text": "一"}, {"type": "subtitle", "time": 19490.31, "timestamp": "05:24:50", "text": "做。哦，等等。一支狙击步枪。我很糟糕"}, {"type": "subtitle", "time": 19493.23, "timestamp": "05:24:53", "text": "就是这样。那一下轻敲"}, {"type": "subtitle", "time": 19497.55, "timestamp": "05:24:57", "text": "东西。那很痛。稍等片刻。"}]
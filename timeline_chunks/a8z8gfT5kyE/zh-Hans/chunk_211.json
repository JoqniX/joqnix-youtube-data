[{"type": "subtitle", "time": 12662.71, "timestamp": "03:31:02", "text": "是的。我的天啊。你知道是哪一位。"}, {"type": "subtitle", "time": 12664.55, "timestamp": "03:31:04", "text": "你知道，那是第一件事"}, {"type": "subtitle", "time": 12667.15, "timestamp": "03:31:07", "text": "首先，首先，首先，首先"}, {"type": "subtitle", "time": 12671.59, "timestamp": "03:31:11", "text": "这次我终于要发布视频了"}, {"type": "subtitle", "time": 12673.91, "timestamp": "03:31:13", "text": "有点像高光时刻之类的，我当时……"}, {"type": "subtitle", "time": 12677.91, "timestamp": "03:31:17", "text": "太多了，我感觉我不应该"}, {"type": "subtitle", "time": 12679.51, "timestamp": "03:31:19", "text": "做那种事。这就像"}, {"type": "subtitle", "time": 12682.55, "timestamp": "03:31:22", "text": "凌晨4点。好的。因为我"}, {"type": "subtitle", "time": 12685.19, "timestamp": "03:31:25", "text": "有点累了。我当时就想，呃……"}, {"type": "subtitle", "time": 12688.15, "timestamp": "03:31:28", "text": "喜欢"}, {"type": "subtitle", "time": 12692.309, "timestamp": "03:31:32", "text": "呃，正在等待V下载完成"}, {"type": "subtitle", "time": 12696.269, "timestamp": "03:31:36", "text": "还有一些其他的东西。所以我就想，天哪，它有"}, {"type": "subtitle", "time": 12699.11, "timestamp": "03:31:39", "text": "问题。质量差，"}, {"type": "subtitle", "time": 12701.99, "timestamp": "03:31:41", "text": "一切。我当时在想，要不要上传呢？"}, {"type": "subtitle", "time": 12705.19, "timestamp": "03:31:45", "text": "喜欢它的人喜欢它，不喜欢它的人不喜欢它？我当时"}, {"type": "subtitle", "time": 12709.83, "timestamp": "03:31:49", "text": "看起来很担心。嗯，是的。嗯，所以……"}, {"type": "subtitle", "time": 12713.349, "timestamp": "03:31:53", "text": "我想如果我的电脑能运行的话，"}, {"type": "subtitle", "time": 12716.71, "timestamp": "03:31:56", "text": "我会尽量录制。但问题是，我是"}]
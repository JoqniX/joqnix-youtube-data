[{"type": "subtitle", "time": 12180.67, "timestamp": "03:23:00", "text": "那些已经回复的人是"}, {"type": "subtitle", "time": 12184.469, "timestamp": "03:23:04", "text": "有兴趣加入。嗯，我可以得到所有"}, {"type": "subtitle", "time": 12186.71, "timestamp": "03:23:06", "text": "把它们写下来。"}, {"type": "subtitle", "time": 12190.71, "timestamp": "03:23:10", "text": "列出并继续与我能联系的人一起进行。"}, {"type": "subtitle", "time": 12193.91, "timestamp": "03:23:13", "text": "联系等等。"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "是啊，然后我看到了，我就觉得……"}, {"type": "subtitle", "time": 12200.64, "timestamp": "03:23:20", "text": "这完全打乱了我的心情。"}]
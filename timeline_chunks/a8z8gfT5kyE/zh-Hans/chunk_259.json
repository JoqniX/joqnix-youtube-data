[{"type": "subtitle", "time": 15551.36, "timestamp": "04:19:11", "text": "[音乐]"}, {"type": "subtitle", "time": 15553.07, "timestamp": "04:19:13", "text": "[笑声]"}, {"type": "subtitle", "time": 15556.71, "timestamp": "04:19:16", "text": "什么？但爆炸声就等于严肃。现在"}, {"type": "subtitle", "time": 15558.95, "timestamp": "04:19:18", "text": "我不懂那些元数据之类的东西。"}, {"type": "subtitle", "time": 15563.07, "timestamp": "04:19:23", "text": "就像你知道什么有效什么无效一样"}, {"type": "subtitle", "time": 15567.87, "timestamp": "04:19:27", "text": "作品是否重要，比如阵容？"}, {"type": "subtitle", "time": 15571.269, "timestamp": "04:19:31", "text": "阵容就像设置阵容一样，是的，全部"}, {"type": "subtitle", "time": 15572.99, "timestamp": "04:19:32", "text": "那些东西"}, {"type": "subtitle", "time": 15577.11, "timestamp": "04:19:37", "text": "对吧？你不需要吗？我们需要一个“不是吗？”"}]
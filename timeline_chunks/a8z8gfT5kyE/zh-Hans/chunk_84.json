[{"type": "subtitle", "time": 5044.629, "timestamp": "01:24:04", "text": "我感到疼痛。我的天哪。打电话给医生"}, {"type": "subtitle", "time": 5046.79, "timestamp": "01:24:06", "text": "请。"}, {"type": "subtitle", "time": 5049.35, "timestamp": "01:24:09", "text": "哦，不。"}, {"type": "subtitle", "time": 5052.31, "timestamp": "01:24:12", "text": "住手。如果你当时被冻住了怎么办？"}, {"type": "subtitle", "time": 5053.75, "timestamp": "01:24:13", "text": "肯定有什么地方出了问题。"}, {"type": "subtitle", "time": 5091.03, "timestamp": "01:24:51", "text": "有时测试必须在室外进行。"}, {"type": "subtitle", "time": 5093.59, "timestamp": "01:24:53", "text": "实验室的局限性。下一次测试"}, {"type": "subtitle", "time": 5097.11, "timestamp": "01:24:57", "text": "太出乎意料了，我简直无法形容"}, {"type": "subtitle", "time": 5099.11, "timestamp": "01:24:59", "text": "皮卡丘。你一直在寻找的你会"}]
[{"type": "subtitle", "time": 19983.23, "timestamp": "05:33:03", "text": "你想在我家做吗？"}, {"type": "subtitle", "time": 19985.75, "timestamp": "05:33:05", "text": "展示？但那样就太多了"}, {"type": "subtitle", "time": 19995.628, "timestamp": "05:33:15", "text": "知道。我根本没有社交焦虑。"}, {"type": "subtitle", "time": 19997.91, "timestamp": "05:33:17", "text": "片刻。如果其他人说话，"}, {"type": "subtitle", "time": 19999.67, "timestamp": "05:33:19", "text": "有人说了些奇怪的话，我就会想，"}, {"type": "subtitle", "time": 20002.07, "timestamp": "05:33:22", "text": "“哦，不。”"}, {"type": "subtitle", "time": 20004.19, "timestamp": "05:33:24", "text": "那是"}, {"type": "subtitle", "time": 20007.03, "timestamp": "05:33:27", "text": "正确的。让我注册一个账号。你如何"}, {"type": "subtitle", "time": 20009.35, "timestamp": "05:33:29", "text": "注册账号？等等，你是……"}, {"type": "subtitle", "time": 20012.948, "timestamp": "05:33:32", "text": "玩“do”的家伙，你是不是会说“等等，do”？"}, {"type": "subtitle", "time": 20015.35, "timestamp": "05:33:35", "text": "你专门为你创建勃起账号"}, {"type": "subtitle", "time": 20018.15, "timestamp": "05:33:38", "text": "像多人游戏一样玩吗？等等，我认识奇罗"}, {"type": "subtitle", "time": 20020.23, "timestamp": "05:33:40", "text": "真的吗？我跟他俩都成了朋友。"}, {"type": "subtitle", "time": 20023.99, "timestamp": "05:33:43", "text": "账户。这个和这个。不"}, {"type": "subtitle", "time": 20027.4, "timestamp": "05:33:47", "text": "告诉我，比如什么？"}, {"type": "subtitle", "time": 20029.35, "timestamp": "05:33:49", "text": "[音乐]"}, {"type": "subtitle", "time": 20031.51, "timestamp": "05:33:51", "text": "我有点懵。它到底是怎么做到的？"}, {"type": "subtitle", "time": 20033.35, "timestamp": "05:33:53", "text": "创建了账号？那就像你需要的"}, {"type": "subtitle", "time": 20034.75, "timestamp": "05:33:54", "text": "另一部手机"}, {"type": "subtitle", "time": 20036.91, "timestamp": "05:33:56", "text": "数字。好的。"}, {"type": "subtitle", "time": 20038.52, "timestamp": "05:33:58", "text": "好的。 为什么？如何"}]
[{"type": "subtitle", "time": 26400.23, "timestamp": "07:20:00", "text": "全部。我为什么要吃这个？我的意思是，我"}, {"type": "subtitle", "time": 26402.91, "timestamp": "07:20:02", "text": "买它是为了追求时尚。我"}, {"type": "subtitle", "time": 26406.83, "timestamp": "07:20:06", "text": "看来我需要用一次近战攻击了。"}, {"type": "subtitle", "time": 26410.67, "timestamp": "07:20:10", "text": "尽管。感觉自己错得离谱。"}, {"type": "subtitle", "time": 26414.15, "timestamp": "07:20:14", "text": "武士刀会说：“你为什么不……”"}, {"type": "subtitle", "time": 26416.23, "timestamp": "07:20:16", "text": "利用我？"}, {"type": "subtitle", "time": 26419.35, "timestamp": "07:20:19", "text": "停止你给予爱或"}, {"type": "subtitle", "time": 26420.99, "timestamp": "07:20:20", "text": "农民的"}, {"type": "subtitle", "time": 26426.35, "timestamp": "07:20:26", "text": "枪。请给我爱。我也是"}, {"type": "subtitle", "time": 26442.83, "timestamp": "07:20:42", "text": "哦，我的"}, {"type": "subtitle", "time": 26458.11, "timestamp": "07:20:58", "text": "[音乐]"}]
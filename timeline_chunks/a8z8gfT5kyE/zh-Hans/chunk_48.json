[{"type": "subtitle", "time": 2880.15, "timestamp": "00:48:00", "text": "这始终是天才的杰作。天才。"}, {"type": "subtitle", "time": 2882.069, "timestamp": "00:48:02", "text": "就像阿尔伯特·爱因斯坦和他的表兄弟一样"}, {"type": "subtitle", "time": 2883.55, "timestamp": "00:48:03", "text": "特里，"}, {"type": "subtitle", "time": 2887.109, "timestamp": "00:48:07", "text": "历史是你们中的一个。我是天才少女吗？"}, {"type": "subtitle", "time": 2888.589, "timestamp": "00:48:08", "text": "难道不是吗？"}, {"type": "subtitle", "time": 2892.309, "timestamp": "00:48:12", "text": "是的，也许"}, {"type": "subtitle", "time": 2899.27, "timestamp": "00:48:19", "text": "对不起。"}, {"type": "subtitle", "time": 2901.75, "timestamp": "00:48:21", "text": "一些人类运动。获胜者就是那位"}, {"type": "subtitle", "time": 2904.71, "timestamp": "00:48:24", "text": "得分最低的人。我"}, {"type": "subtitle", "time": 2905.99, "timestamp": "00:48:25", "text": "只是觉得你可能会发现这一点。"}, {"type": "subtitle", "time": 2908.95, "timestamp": "00:48:28", "text": "有趣的。大多数赢家都会这样做。"}, {"type": "subtitle", "time": 2915.95, "timestamp": "00:48:35", "text": "这很肮脏"}, {"type": "subtitle", "time": 2920.069, "timestamp": "00:48:40", "text": "水。如果您收到"}, {"type": "subtitle", "time": 2925.549, "timestamp": "00:48:45", "text": "如果你跳到这里，你会死。"}, {"type": "subtitle", "time": 2930.47, "timestamp": "00:48:50", "text": "啊，原来你了解脏水啊。"}]
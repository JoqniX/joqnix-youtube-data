[{"type": "subtitle", "time": 21901.27, "timestamp": "06:05:01", "text": "孟买的服务器会让每个人都破口大骂"}, {"type": "subtitle", "time": 21903.788, "timestamp": "06:05:03", "text": "对我说或者类似的话"}, {"type": "subtitle", "time": 21905.788, "timestamp": "06:05:05", "text": "是的"}, {"type": "subtitle", "time": 21909.83, "timestamp": "06:05:09", "text": "但我感觉我可能会被人指出来。"}, {"type": "subtitle", "time": 21912.868, "timestamp": "06:05:12", "text": "或者别的什么，不过没关系，但我还是"}, {"type": "subtitle", "time": 21914.788, "timestamp": "06:05:14", "text": "我不懂这种语言，所以我不会知道"}, {"type": "subtitle", "time": 21917.23, "timestamp": "06:05:17", "text": "所以我不会把这放在心上。"}, {"type": "subtitle", "time": 21921.91, "timestamp": "06:05:21", "text": "思考。对，这确实是它的优点之一。"}, {"type": "subtitle", "time": 21923.43, "timestamp": "06:05:23", "text": "所以，我们打算做什么都行，但是……"}, {"type": "subtitle", "time": 21925.788, "timestamp": "06:05:25", "text": "可能会被举报。那是一个"}, {"type": "subtitle", "time": 21934.07, "timestamp": "06:05:34", "text": "我。这是电子游戏中的常见现象。"}]
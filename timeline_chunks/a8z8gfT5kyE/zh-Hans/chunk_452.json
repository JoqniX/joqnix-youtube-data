[{"type": "subtitle", "time": 27124.07, "timestamp": "07:32:04", "text": "比如，《星际男孩》现在怎么样了。嗯？我是"}, {"type": "subtitle", "time": 27133.75, "timestamp": "07:32:13", "text": "很多。这个游戏看起来很有意思。是的，"}, {"type": "subtitle", "time": 27140.548, "timestamp": "07:32:20", "text": "我的枪法太烂了。没关系。你正在做"}, {"type": "subtitle", "time": 27143.388, "timestamp": "07:32:23", "text": "太好了。它是"}, {"type": "subtitle", "time": 27166.15, "timestamp": "07:32:46", "text": "我的天啊。我来了。我来了。我是"}, {"type": "subtitle", "time": 27168.51, "timestamp": "07:32:48", "text": "未来。我来了。未来。未来。"}]
[{"type": "subtitle", "time": 12907.75, "timestamp": "03:35:07", "text": "我的天哪，好痛啊。我，呃，我把我的"}, {"type": "subtitle", "time": 12909.83, "timestamp": "03:35:09", "text": "呃，把两块都置于睡眠模式"}, {"type": "subtitle", "time": 12912.79, "timestamp": "03:35:12", "text": "因为在加州打工打到筋疲力尽。"}, {"type": "subtitle", "time": 12915.429, "timestamp": "03:35:15", "text": "早上醒来的时候，有那么一会儿"}, {"type": "subtitle", "time": 12918.71, "timestamp": "03:35:18", "text": "因为我必须连接Apex事件，因为"}, {"type": "subtitle", "time": 12920.71, "timestamp": "03:35:20", "text": "我没有朋友一起玩。所以，我"}, {"type": "subtitle", "time": 12922.79, "timestamp": "03:35:22", "text": "我得用另一个账号玩。所以"}, {"type": "subtitle", "time": 12926.03, "timestamp": "03:35:26", "text": "我和我两个都玩"}, {"type": "subtitle", "time": 12929.91, "timestamp": "03:35:29", "text": "我用我的手指操作电脑，我的"}, {"type": "subtitle", "time": 12933.91, "timestamp": "03:35:33", "text": "双手移动，我实际上用了我的"}, {"type": "subtitle", "time": 12934.99, "timestamp": "03:35:34", "text": "腿到"}, {"type": "subtitle", "time": 12940.59, "timestamp": "03:35:40", "text": "瞄准我的直播电脑车新"}, {"type": "subtitle", "time": 12943.67, "timestamp": "03:35:43", "text": "帐户。我的天哪，太搞笑了。但"}, {"type": "subtitle", "time": 12948.309, "timestamp": "03:35:48", "text": "我终于完成了Apex赛事"}, {"type": "subtitle", "time": 12958.55, "timestamp": "03:35:58", "text": "[音乐]"}]
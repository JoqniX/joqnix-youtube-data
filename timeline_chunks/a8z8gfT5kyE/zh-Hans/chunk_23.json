[{"type": "subtitle", "time": 1389.149, "timestamp": "00:23:09", "text": "开玩笑。耶。我是一名韩国YouTuber"}, {"type": "subtitle", "time": 1391.47, "timestamp": "00:23:11", "text": "一般来说，我"}, {"type": "subtitle", "time": 1395.39, "timestamp": "00:23:15", "text": "就像我编造谎言漂白剂，那个名字是"}, {"type": "subtitle", "time": 1398.27, "timestamp": "00:23:18", "text": "Koboni 和我都是头儿"}, {"type": "subtitle", "time": 1432.63, "timestamp": "00:23:52", "text": "虽然生病了，但没关系，因为我喝酒。"}, {"type": "subtitle", "time": 1434.09, "timestamp": "00:23:54", "text": "晕动病"}, {"type": "subtitle", "time": 1436.11, "timestamp": "00:23:56", "text": "[音乐]"}]
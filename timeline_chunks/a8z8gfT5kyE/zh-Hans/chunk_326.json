[{"type": "subtitle", "time": 19574.09, "timestamp": "05:26:14", "text": "挑选？"}, {"type": "subtitle", "time": 19576.35, "timestamp": "05:26:16", "text": "[音乐]"}, {"type": "subtitle", "time": 19579.11, "timestamp": "05:26:19", "text": "我没事。我很好。我很好。我会我会"}, {"type": "subtitle", "time": 19580.948, "timestamp": "05:26:20", "text": "因为我有皮肤，所以就用皮肤来处理。"}, {"type": "subtitle", "time": 19583.35, "timestamp": "05:26:23", "text": "我会去拿的。嗯？没关系。患病的"}, {"type": "subtitle", "time": 19591.67, "timestamp": "05:26:31", "text": "女士，因为皮肤就在那里。我是"}, {"type": "subtitle", "time": 19600.11, "timestamp": "05:26:40", "text": "她。但我需要参加这个活动并获得"}, {"type": "subtitle", "time": 19603.43, "timestamp": "05:26:43", "text": "哪个是皮肤来着？是吗？"}, {"type": "subtitle", "time": 19604.19, "timestamp": "05:26:44", "text": "不是"}, {"type": "subtitle", "time": 19606.708, "timestamp": "05:26:46", "text": "这里？它应该在这里，对吧？是吗？"}, {"type": "subtitle", "time": 19609.51, "timestamp": "05:26:49", "text": "不在吗？是的，我会参加这个活动。"}, {"type": "subtitle", "time": 19617.43, "timestamp": "05:26:57", "text": "作者：Hana。你可以看到青蛙。是的，我"}]
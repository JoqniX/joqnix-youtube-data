[{"type": "subtitle", "time": 27850.708, "timestamp": "07:44:10", "text": "正确的。是的，我们赢定了。我希望"}, {"type": "subtitle", "time": 27879.91, "timestamp": "07:44:39", "text": "哦，我发不出去。 O."}, {"type": "subtitle", "time": 27889.07, "timestamp": "07:44:49", "text": "好的，我要升个级了。青铜，"}, {"type": "subtitle", "time": 27892.11, "timestamp": "07:44:52", "text": "正确的？是吗？"}, {"type": "subtitle", "time": 27895.868, "timestamp": "07:44:55", "text": "青铜？等等，这是什么？"}, {"type": "subtitle", "time": 27898.35, "timestamp": "07:44:58", "text": "青铜？那是青铜。"}]
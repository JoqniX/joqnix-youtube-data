[{"type": "subtitle", "time": 5004.79, "timestamp": "01:23:24", "text": "[音乐]"}, {"type": "subtitle", "time": 5008.149, "timestamp": "01:23:28", "text": "你好。恭喜。你成功地"}, {"type": "subtitle", "time": 5009.99, "timestamp": "01:23:29", "text": "完成这项毫无意义的事情"}, {"type": "subtitle", "time": 5012.95, "timestamp": "01:23:32", "text": "测试。哦，我差点忘了。当你去"}, {"type": "subtitle", "time": 5014.79, "timestamp": "01:23:34", "text": "除了考试课程之外，只有"}, {"type": "subtitle", "time": 5016.79, "timestamp": "01:23:36", "text": "我报复你的方式就是暴力报复。"}, {"type": "subtitle", "time": 5019.51, "timestamp": "01:23:39", "text": "把你拆解开来，然后小心翼翼地"}, {"type": "subtitle", "time": 5023.03, "timestamp": "01:23:43", "text": "重新组装你。幸运的是，你没有这种感觉。"}, {"type": "subtitle", "time": 5026.149, "timestamp": "01:23:46", "text": "疼痛。总之，你没有“不要”这个选项。"}, {"type": "subtitle", "time": 5028.87, "timestamp": "01:23:48", "text": "感到疼痛。不，我也有这种感觉。我认为"}, {"type": "subtitle", "time": 5031.59, "timestamp": "01:23:51", "text": "那。"}, {"type": "subtitle", "time": 5033.95, "timestamp": "01:23:53", "text": "哦，我的"}]
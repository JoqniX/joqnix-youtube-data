[{"type": "subtitle", "time": 918.4, "timestamp": "00:15:18", "text": "现在角色太多了，"}, {"type": "subtitle", "time": 935.91, "timestamp": "00:15:35", "text": "等一下。凯，是你……"}, {"type": "subtitle", "time": 939.949, "timestamp": "00:15:39", "text": "没错吧？于是我"}, {"type": "subtitle", "time": 944.67, "timestamp": "00:15:44", "text": "丽莎可以寻求帮助什么的。"}, {"type": "subtitle", "time": 946.75, "timestamp": "00:15:46", "text": "他们彼此认识，或者"}, {"type": "subtitle", "time": 950.069, "timestamp": "00:15:50", "text": "某物。但这究竟是怎么回事呢？这是怎么回事？"}, {"type": "subtitle", "time": 951.629, "timestamp": "00:15:51", "text": "一部分"}]
[{"type": "subtitle", "time": 360.749, "timestamp": "00:06:00", "text": "你看，我们都知道我刚刚取消了一条推文。我也是"}, {"type": "subtitle", "time": 364.43, "timestamp": "00:06:04", "text": "提到露娜在这里。拉"}, {"type": "subtitle", "time": 370.83, "timestamp": "00:06:10", "text": "拉安。我当时"}, {"type": "subtitle", "time": 374.23, "timestamp": "00:06:14", "text": "那里。我在那里。我的天啊。她放"}, {"type": "subtitle", "time": 375.95, "timestamp": "00:06:15", "text": "我的照片在那里。"}, {"type": "subtitle", "time": 379.749, "timestamp": "00:06:19", "text": "谢谢。实际上，她精心制作了"}, {"type": "subtitle", "time": 382.15, "timestamp": "00:06:22", "text": "把图片放到直播流里，然后制作"}, {"type": "subtitle", "time": 385.51, "timestamp": "00:06:25", "text": "我的天哪。她真是个"}, {"type": "subtitle", "time": 387.95, "timestamp": "00:06:27", "text": "甜的。感谢"}, {"type": "subtitle", "time": 390.55, "timestamp": "00:06:30", "text": "你。昨天的合作非常愉快。"}, {"type": "subtitle", "time": 393.83, "timestamp": "00:06:33", "text": "死神一号。严格来说，哈里森得到了我的"}, {"type": "subtitle", "time": 397.029, "timestamp": "00:06:37", "text": "这是日本首次以某种方式进行合作。"}, {"type": "subtitle", "time": 399.71, "timestamp": "00:06:39", "text": "因为那真的"}, {"type": "subtitle", "time": 401.30899999999997, "timestamp": "00:06:41", "text": "乐趣。"}, {"type": "subtitle", "time": 404.71, "timestamp": "00:06:44", "text": "你好。我得赶紧把推文发好。"}, {"type": "subtitle", "time": 411.39, "timestamp": "00:06:51", "text": "呃，照做就行了。"}]
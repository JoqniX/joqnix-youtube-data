[{"type": "subtitle", "time": 121.19, "timestamp": "00:02:01", "text": "约苏。不，我们将用日语交谈。"}, {"type": "subtitle", "time": 123.749, "timestamp": "00:02:03", "text": "实际上。所以，Nihongo Josu 会尝试尝试"}, {"type": "subtitle", "time": 126.63, "timestamp": "00:02:06", "text": "我们尽力了。她会教我日语。"}, {"type": "subtitle", "time": 129.029, "timestamp": "00:02:09", "text": "韩语，我也会尽力而为"}, {"type": "subtitle", "time": 132.11, "timestamp": "00:02:12", "text": "会说一些韩语。我从谷歌学习"}, {"type": "subtitle", "time": 134.75, "timestamp": "00:02:14", "text": "翻译等等。是的，我是"}, {"type": "subtitle", "time": 137.91, "timestamp": "00:02:17", "text": "兴奋的。伙计们，我好兴奋！让我们开始吧"}, {"type": "subtitle", "time": 140.15, "timestamp": "00:02:20", "text": "最好的。"}, {"type": "subtitle", "time": 141.91, "timestamp": "00:02:21", "text": "这个周末我可以帮到你和你的"}, {"type": "subtitle", "time": 144.22899999999998, "timestamp": "00:02:24", "text": "如果你想的话，可以在iota上加我好友。呃，这个"}, {"type": "subtitle", "time": 146.55, "timestamp": "00:02:26", "text": "周末我都安排满了。嗯，这个周末"}, {"type": "subtitle", "time": 149.67000000000002, "timestamp": "00:02:29", "text": "我已经订满了。呃，已经预订了，就像我已经预订了一样。"}, {"type": "subtitle", "time": 151.99, "timestamp": "00:02:31", "text": "与其他人合作。问题是"}, {"type": "subtitle", "time": 155.27, "timestamp": "00:02:35", "text": "我正在努力与所有人合作"}, {"type": "subtitle", "time": 159.50900000000001, "timestamp": "00:02:39", "text": "我认识的 YouTuber 朋友和创作者们"}, {"type": "subtitle", "time": 162.07, "timestamp": "00:02:42", "text": "在我担任……的五年旅程中"}, {"type": "subtitle", "time": 164.63, "timestamp": "00:02:44", "text": "YouTuber。接下来去日本之前"}, {"type": "subtitle", "time": 167.43, "timestamp": "00:02:47", "text": "下个月，下下个月，我想清空"}, {"type": "subtitle", "time": 170.63, "timestamp": "00:02:50", "text": "在我所有的合作项目中，呃"}, {"type": "subtitle", "time": 173.82999999999998, "timestamp": "00:02:53", "text": "就像……伸出手邀请"}, {"type": "subtitle", "time": 177.19, "timestamp": "00:02:57", "text": "让人们进来。所以我出去了，我们"}]
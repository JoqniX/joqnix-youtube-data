[{"type": "subtitle", "time": 20882.19, "timestamp": "05:48:02", "text": "好的。不，我"}, {"type": "subtitle", "time": 20885.43, "timestamp": "05:48:05", "text": "不。呃，如果白龙是第二人生，那它就如同第二人生。"}, {"type": "subtitle", "time": 20888.39, "timestamp": "05:48:08", "text": "你的生命值变低了。哦，那太酷了。"}, {"type": "subtitle", "time": 20891.27, "timestamp": "05:48:11", "text": "它会让你恢复活力。哇。就像低"}, {"type": "subtitle", "time": 20894.868, "timestamp": "05:48:14", "text": "出自《Valerant》。但是，那就像是为了"}, {"type": "subtitle", "time": 20897.948, "timestamp": "05:48:17", "text": "死亡时。不，在这里。"}, {"type": "subtitle", "time": 20901.27, "timestamp": "05:48:21", "text": "比如当你的生命值很低的时候。低的。好的。得到"}, {"type": "subtitle", "time": 20902.52, "timestamp": "05:48:22", "text": "你。"}, {"type": "subtitle", "time": 20916.57, "timestamp": "05:48:36", "text": "男人"}, {"type": "subtitle", "time": 20918.67, "timestamp": "05:48:38", "text": "[音乐]"}, {"type": "subtitle", "time": 20921.948, "timestamp": "05:48:41", "text": "排名。这些是顶尖的吗？"}, {"type": "subtitle", "time": 20930.39, "timestamp": "05:48:50", "text": "上帝。我大概会这样安排。"}, {"type": "subtitle", "time": 20932.47, "timestamp": "05:48:52", "text": "排名之类的。我觉得我不会"}, {"type": "subtitle", "time": 20933.868, "timestamp": "05:48:53", "text": "地方"}, {"type": "subtitle", "time": 20936.23, "timestamp": "05:48:56", "text": "比如这个排名之类的。我不"}, {"type": "subtitle", "time": 20939.43, "timestamp": "05:48:59", "text": "知道。嗯，我们来看看。"}]
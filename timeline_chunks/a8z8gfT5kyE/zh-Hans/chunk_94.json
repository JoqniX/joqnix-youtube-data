[{"type": "subtitle", "time": 5655.43, "timestamp": "01:34:15", "text": "你逼我。我的天哪。"}, {"type": "subtitle", "time": 5685.149, "timestamp": "01:34:45", "text": "哦。你可以开枪，"}, {"type": "subtitle", "time": 5687.51, "timestamp": "01:34:47", "text": "楼下那边。不，不，不"}, {"type": "subtitle", "time": 5692.39, "timestamp": "01:34:52", "text": "不，不。哦，回去吧。回去。"}, {"type": "subtitle", "time": 5696.03, "timestamp": "01:34:56", "text": "可可和"}, {"type": "subtitle", "time": 5699.59, "timestamp": "01:34:59", "text": "然后，呃，楼下。开枪"}]
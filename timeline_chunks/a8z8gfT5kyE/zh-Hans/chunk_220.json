[{"type": "subtitle", "time": 13200.63, "timestamp": "03:40:00", "text": "咕。还有，我不知道你有没有注意到，"}, {"type": "subtitle", "time": 13203.429, "timestamp": "03:40:03", "text": "我制作的十字准星与……类似"}, {"type": "subtitle", "time": 13207.349, "timestamp": "03:40:07", "text": "瓦莱林十字准星。我觉得我需要"}, {"type": "subtitle", "time": 13209.55, "timestamp": "03:40:09", "text": "稍微降低一下这个值。"}, {"type": "subtitle", "time": 13212.71, "timestamp": "03:40:12", "text": "可能吧。我不知道如何降低"}, {"type": "subtitle", "time": 13222.19, "timestamp": "03:40:22", "text": "这？如何降低“哦，就像”"}, {"type": "subtitle", "time": 13224.87, "timestamp": "03:40:24", "text": "这。啊，原来是这样降低的。"}, {"type": "subtitle", "time": 13226.83, "timestamp": "03:40:26", "text": "它。好的。"}, {"type": "subtitle", "time": 13230.429, "timestamp": "03:40:30", "text": "是的。现在我能看到"}, {"type": "subtitle", "time": 13233.79, "timestamp": "03:40:33", "text": "东西。十字准星越小，"}, {"type": "subtitle", "time": 13240.95, "timestamp": "03:40:40", "text": "机械师们需要注意的一点是……"}, {"type": "subtitle", "time": 13243.11, "timestamp": "03:40:43", "text": "我需要学习的游戏实际上正在进行中"}, {"type": "subtitle", "time": 13247.63, "timestamp": "03:40:47", "text": "纸模模式，并且实际上用它来……"}, {"type": "subtitle", "time": 13250.79, "timestamp": "03:40:50", "text": "优势。我不是你，我用的不是纸"}, {"type": "subtitle", "time": 13255.67, "timestamp": "03:40:55", "text": "完全没有模式。我只是依靠我的瞄准能力。"}, {"type": "subtitle", "time": 13258.229, "timestamp": "03:40:58", "text": "以及填充和重新定位。我忘了"}]
[{"type": "subtitle", "time": 20642.07, "timestamp": "05:44:02", "text": "比如，我有时候不喜欢这样"}, {"type": "subtitle", "time": 20644.35, "timestamp": "05:44:04", "text": "擅长我的"}, {"type": "subtitle", "time": 20646.67, "timestamp": "05:44:06", "text": "满足的朋友"}, {"type": "subtitle", "time": 20661.27, "timestamp": "05:44:21", "text": "不行，那是你，对吧？好吧，你知道的。"}, {"type": "subtitle", "time": 20664.548, "timestamp": "05:44:24", "text": "我要补充的是，不是我要补充什么。"}, {"type": "subtitle", "time": 20666.91, "timestamp": "05:44:26", "text": "朋友的东西"}, {"type": "subtitle", "time": 20668.86, "timestamp": "05:44:28", "text": "好的。"}, {"type": "subtitle", "time": 20670.11, "timestamp": "05:44:30", "text": "[音乐]"}, {"type": "subtitle", "time": 20671.41, "timestamp": "05:44:31", "text": "呃"}, {"type": "subtitle", "time": 20672.67, "timestamp": "05:44:32", "text": "[音乐]"}, {"type": "subtitle", "time": 20674.43, "timestamp": "05:44:34", "text": "星星"}, {"type": "subtitle", "time": 20679.59, "timestamp": "05:44:39", "text": "男孩明星男孩。哦，我不能……呃……等等"}, {"type": "subtitle", "time": 20680.67, "timestamp": "05:44:40", "text": "第二"}, {"type": "subtitle", "time": 20684.59, "timestamp": "05:44:44", "text": "帐户。好，我就给你起这个名字吧。"}, {"type": "subtitle", "time": 20695.548, "timestamp": "05:44:55", "text": "[音乐]"}, {"type": "subtitle", "time": 20698.13, "timestamp": "05:44:58", "text": "然后是"}, {"type": "subtitle", "time": 20699.948, "timestamp": "05:44:59", "text": "[音乐]"}]
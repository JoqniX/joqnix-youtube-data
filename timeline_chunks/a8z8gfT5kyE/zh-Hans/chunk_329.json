[{"type": "subtitle", "time": 19751.43, "timestamp": "05:29:11", "text": "秩。我的天啊。天哪，我现在浑身冒汗。"}, {"type": "subtitle", "time": 19754.07, "timestamp": "05:29:14", "text": "等等，呃，我不知道怎么用"}, {"type": "subtitle", "time": 19757.75, "timestamp": "05:29:17", "text": "震惊女士。让我练习一下。我"}, {"type": "subtitle", "time": 19759.51, "timestamp": "05:29:19", "text": "我不知道该不该带她去。"}, {"type": "subtitle", "time": 19763.51, "timestamp": "05:29:23", "text": "但如果我要带她去，我需要知道"}, {"type": "subtitle", "time": 19765.708, "timestamp": "05:29:25", "text": "她"}, {"type": "subtitle", "time": 19779.91, "timestamp": "05:29:39", "text": "青蛙。你可以看到那只青蛙。哦，我的"}, {"type": "subtitle", "time": 19787.15, "timestamp": "05:29:47", "text": "可爱的。"}, {"type": "subtitle", "time": 19789.75, "timestamp": "05:29:49", "text": "青蛙。那么，这种能力有什么作用呢？"}]
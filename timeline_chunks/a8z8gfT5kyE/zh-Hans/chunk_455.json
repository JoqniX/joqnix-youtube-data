[{"type": "subtitle", "time": 27313.35, "timestamp": "07:35:13", "text": "店铺。你知道吗？我需要重的呃"}, {"type": "subtitle", "time": 27314.43, "timestamp": "07:35:14", "text": "重的"}, {"type": "subtitle", "time": 27317.67, "timestamp": "07:35:17", "text": "盔甲。别这样，求求你别这样，求求你别这样"}, {"type": "subtitle", "time": 27319.91, "timestamp": "07:35:19", "text": "投降。我，我恳求。谢谢。还有一个"}, {"type": "subtitle", "time": 27323.83, "timestamp": "07:35:23", "text": "投票。请不要死。我"}, {"type": "subtitle", "time": 27329.27, "timestamp": "07:35:29", "text": "秩。输了也没关系。不，不，不。"}, {"type": "subtitle", "time": 27330.19, "timestamp": "07:35:30", "text": "它不是"}, {"type": "subtitle", "time": 27340.628, "timestamp": "07:35:40", "text": "难的。哦对，这里面也有扭蛋元素。"}, {"type": "subtitle", "time": 27342.708, "timestamp": "07:35:42", "text": "游戏。 Gotcha 将会用于皮肤之类的东西"}, {"type": "subtitle", "time": 27345.67, "timestamp": "07:35:45", "text": "以及武器皮肤。"}, {"type": "subtitle", "time": 27349.91, "timestamp": "07:35:49", "text": "所以你也把根钦·伊姆帕查放进去了。"}, {"type": "subtitle", "time": 27351.628, "timestamp": "07:35:51", "text": "循环"}]
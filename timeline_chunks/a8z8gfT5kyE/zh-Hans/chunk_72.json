[{"type": "subtitle", "time": 4323.99, "timestamp": "01:12:03", "text": "乔尔。全部"}, {"type": "subtitle", "time": 4343.91, "timestamp": "01:12:23", "text": "你在做，但我不想让你这样做。"}, {"type": "subtitle", "time": 4347.43, "timestamp": "01:12:27", "text": "停止。好的。好的。你们两个有"}, {"type": "subtitle", "time": 4350.149, "timestamp": "01:12:30", "text": "与一家公司建立了良好的合作关系"}, {"type": "subtitle", "time": 4352.79, "timestamp": "01:12:32", "text": "你应对脑力挑战的能力"}, {"type": "subtitle", "time": 4354.63, "timestamp": "01:12:34", "text": "另一个则准备沉重地"}, {"type": "subtitle", "time": 4355.95, "timestamp": "01:12:35", "text": "摇摇摆摆地走进"}, {"type": "subtitle", "time": 4365.709, "timestamp": "01:12:45", "text": "M."}, {"type": "subtitle", "time": 4367.84, "timestamp": "01:12:47", "text": "嗯"}]
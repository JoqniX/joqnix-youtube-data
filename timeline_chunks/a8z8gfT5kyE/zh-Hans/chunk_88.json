[{"type": "subtitle", "time": 5306.629, "timestamp": "01:28:26", "text": "哦。哦。请你开枪好吗？"}, {"type": "subtitle", "time": 5309.07, "timestamp": "01:28:29", "text": "不，不，不，不，不，不，不，不。"}, {"type": "subtitle", "time": 5312.47, "timestamp": "01:28:32", "text": "哦，不。不，不，不，不。你必须搬家"}, {"type": "subtitle", "time": 5314.629, "timestamp": "01:28:34", "text": "这里。"}, {"type": "subtitle", "time": 5316.55, "timestamp": "01:28:36", "text": "越多越好。等等，等等，等等，等等。不"}, {"type": "subtitle", "time": 5320.95, "timestamp": "01:28:40", "text": "跳。不，不，不。我们必须把它搬走。"}, {"type": "subtitle", "time": 5324.31, "timestamp": "01:28:44", "text": "这里和那里都有。"}, {"type": "subtitle", "time": 5326.31, "timestamp": "01:28:46", "text": "哦。哦。哦。"}, {"type": "subtitle", "time": 5328.07, "timestamp": "01:28:48", "text": "还有这里。"}, {"type": "subtitle", "time": 5330.709, "timestamp": "01:28:50", "text": "是的。是的。是的。是的。是的。我们必须"}, {"type": "subtitle", "time": 5333.83, "timestamp": "01:28:53", "text": "搬到这里来。"}]
[{"type": "subtitle", "time": 12004.99, "timestamp": "03:20:04", "text": "和"}, {"type": "subtitle", "time": 12007.51, "timestamp": "03:20:07", "text": "该死，想想如果……会是什么样子"}, {"type": "subtitle", "time": 12010.389, "timestamp": "03:20:10", "text": "如果我只是发送实际内容会发生什么？"}, {"type": "subtitle", "time": 12012.309, "timestamp": "03:20:12", "text": "合作请求之类的。如果你会是"}, {"type": "subtitle", "time": 12016.55, "timestamp": "03:20:16", "text": "愿意加入合作，我们可以获得"}, {"type": "subtitle", "time": 12018.309, "timestamp": "03:20:18", "text": "互相认识并一起出去玩"}, {"type": "subtitle", "time": 12021.15, "timestamp": "03:20:21", "text": "某种程度上"}, {"type": "subtitle", "time": 12023.75, "timestamp": "03:20:23", "text": "东西。问题是我喜欢"}, {"type": "subtitle", "time": 12025.91, "timestamp": "03:20:25", "text": "跟我交谈过的人联系一下"}, {"type": "subtitle", "time": 12031.55, "timestamp": "03:20:31", "text": "过去曾有过。好的。因为嗯"}, {"type": "subtitle", "time": 12035.389, "timestamp": "03:20:35", "text": "如果我曾经……"}, {"type": "subtitle", "time": 12039.67, "timestamp": "03:20:39", "text": "就像我们之前聊过一样，我们之间有一种联系。"}, {"type": "subtitle", "time": 12042.309, "timestamp": "03:20:42", "text": "而我们最近并没有交谈。"}, {"type": "subtitle", "time": 12045.75, "timestamp": "03:20:45", "text": "重新联系或者聊聊天都没关系。"}, {"type": "subtitle", "time": 12046.83, "timestamp": "03:20:46", "text": "再次。"}, {"type": "subtitle", "time": 12050.67, "timestamp": "03:20:50", "text": "正确的。正确的。"}, {"type": "subtitle", "time": 12052.349, "timestamp": "03:20:52", "text": "所以"}, {"type": "subtitle", "time": 12055.91, "timestamp": "03:20:55", "text": "那好吧，不过，我绝对不会不这么做。"}, {"type": "subtitle", "time": 12057.75, "timestamp": "03:20:57", "text": "不想发送任何仇恨言论或"}]
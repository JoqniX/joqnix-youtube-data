[{"type": "subtitle", "time": 12781.269, "timestamp": "03:33:01", "text": "我不认为我注册过账号，但是"}, {"type": "subtitle", "time": 12784.71, "timestamp": "03:33:04", "text": "记得见过我一个朋友……"}, {"type": "subtitle", "time": 12786.63, "timestamp": "03:33:06", "text": "就像我当时在观察他们一样"}, {"type": "subtitle", "time": 12789.349, "timestamp": "03:33:09", "text": "个人资料信息。他们就像在做V呃"}, {"type": "subtitle", "time": 12791.91, "timestamp": "03:33:11", "text": "他们似乎对……很感兴趣"}, {"type": "subtitle", "time": 12793.429, "timestamp": "03:33:13", "text": "好像还有个故事情节什么的。他们"}, {"type": "subtitle", "time": 12797.269, "timestamp": "03:33:17", "text": "想要退伍军人事务部的东西。所以他们发了个帖子"}, {"type": "subtitle", "time": 12799.91, "timestamp": "03:33:19", "text": "就像招聘启事一样，有点像在看"}, {"type": "subtitle", "time": 12801.67, "timestamp": "03:33:21", "text": "招聘配音演员"}, {"type": "subtitle", "time": 12805.07, "timestamp": "03:33:25", "text": "发布了东西。所以我就想，哦，这是什么？"}, {"type": "subtitle", "time": 12807.99, "timestamp": "03:33:27", "text": "这？我当时就觉得这很吸引我。"}, {"type": "subtitle", "time": 12809.91, "timestamp": "03:33:29", "text": "好像有个网站专门介绍所有这些"}, {"type": "subtitle", "time": 12813.389, "timestamp": "03:33:33", "text": "你知道的，这些东西。"}, {"type": "subtitle", "time": 12817.71, "timestamp": "03:33:37", "text": "是的。嗯，是的，今天"}, {"type": "subtitle", "time": 12821.75, "timestamp": "03:33:41", "text": "呃，选角俱乐部。对，就是那个。"}, {"type": "subtitle", "time": 12825.15, "timestamp": "03:33:45", "text": "一。我想，我想就是它了。"}, {"type": "subtitle", "time": 12827.79, "timestamp": "03:33:47", "text": "是的。更多的"}, {"type": "subtitle", "time": 12829.0, "timestamp": "03:33:49", "text": "更多的。"}, {"type": "subtitle", "time": 12830.99, "timestamp": "03:33:50", "text": "[音乐]"}, {"type": "subtitle", "time": 12834.07, "timestamp": "03:33:54", "text": "嗯，好的。那么，让我们开始游戏吧。"}]
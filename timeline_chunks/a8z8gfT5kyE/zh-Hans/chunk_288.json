[{"type": "subtitle", "time": 17282.59, "timestamp": "04:48:02", "text": "关闭。是的。你好，Kisa。欢迎。"}, {"type": "subtitle", "time": 17291.43, "timestamp": "04:48:11", "text": "你好。呃，等等，我们是投降了吗？还是……"}, {"type": "subtitle", "time": 17296.708, "timestamp": "04:48:16", "text": "它走了吗？哦，我们迷路了吗？是的。更多的。"}, {"type": "subtitle", "time": 17303.868, "timestamp": "04:48:23", "text": "男人。哦，是的"}, {"type": "subtitle", "time": 17306.23, "timestamp": "04:48:26", "text": "好的。至少我的战斗通行证是"}, {"type": "subtitle", "time": 17308.19, "timestamp": "04:48:28", "text": "水平"}, {"type": "subtitle", "time": 17311.15, "timestamp": "04:48:31", "text": "向上。尊重。"}, {"type": "subtitle", "time": 17323.11, "timestamp": "04:48:43", "text": "哼。我为什么锁屏了？哦，我锁屏了。"}, {"type": "subtitle", "time": 17324.59, "timestamp": "04:48:44", "text": "哦，"}, {"type": "subtitle", "time": 17327.628, "timestamp": "04:48:47", "text": "好的。我的天哪。好的。"}, {"type": "subtitle", "time": 17331.39, "timestamp": "04:48:51", "text": "好的。 40级。"}, {"type": "subtitle", "time": 17334.83, "timestamp": "04:48:54", "text": "嗯。我要买这个和这个。"}]
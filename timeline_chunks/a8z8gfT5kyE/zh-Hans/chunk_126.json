[{"type": "subtitle", "time": 7565.27, "timestamp": "02:06:05", "text": "多人游戏完美。甚至连我也是被创造出来的。"}, {"type": "subtitle", "time": 7572.149, "timestamp": "02:06:12", "text": "不完美。但我克服了我的障碍。"}, {"type": "subtitle", "time": 7579.189, "timestamp": "02:06:19", "text": "哦，"}, {"type": "subtitle", "time": 7582.35, "timestamp": "02:06:22", "text": "你的呼吸已停止。"}, {"type": "subtitle", "time": 7596.95, "timestamp": "02:06:36", "text": "好的。这张地图是不是最后一张？我感觉"}, {"type": "subtitle", "time": 7600.51, "timestamp": "02:06:40", "text": "有点头晕。你好。你好。"}]
[{"type": "subtitle", "time": 19689.43, "timestamp": "05:28:09", "text": "这？是的，你们有这个季节。"}, {"type": "subtitle", "time": 19691.99, "timestamp": "05:28:11", "text": "哦，我想你们还有上个赛季的录像。"}, {"type": "subtitle", "time": 19693.94, "timestamp": "05:28:13", "text": "正确的？"}, {"type": "subtitle", "time": 19700.19, "timestamp": "05:28:20", "text": "是的。第四季。是的。最后"}, {"type": "subtitle", "time": 19704.948, "timestamp": "05:28:24", "text": "本赛季我们无法进行。哦，没关系。我"}, {"type": "subtitle", "time": 19706.51, "timestamp": "05:28:26", "text": "得到"}, {"type": "subtitle", "time": 19712.19, "timestamp": "05:28:32", "text": "这就像大师级水平一样。我的天哪。我得到了"}, {"type": "subtitle", "time": 19715.788, "timestamp": "05:28:35", "text": "它。大师四。"}, {"type": "subtitle", "time": 19725.03, "timestamp": "05:28:45", "text": "伙计，我们不能一起玩。我"}, {"type": "subtitle", "time": 19733.628, "timestamp": "05:28:53", "text": "到"}, {"type": "subtitle", "time": 19736.39, "timestamp": "05:28:56", "text": "呃，请您稍等片刻。你"}, {"type": "subtitle", "time": 19739.31, "timestamp": "05:28:59", "text": "想让我玩真人版"}]
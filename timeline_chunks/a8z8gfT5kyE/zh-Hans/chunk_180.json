[{"type": "subtitle", "time": 10800.309, "timestamp": "03:00:00", "text": "今天下午的合作也像这样"}, {"type": "subtitle", "time": 10801.469, "timestamp": "03:00:01", "text": "停电"}, {"type": "subtitle", "time": 10814.99, "timestamp": "03:00:14", "text": "我没想到会这样。"}, {"type": "subtitle", "time": 10819.389, "timestamp": "03:00:19", "text": "就像发生在"}, {"type": "subtitle", "time": 10845.349, "timestamp": "03:00:45", "text": "射击。好的。好的。呃，让我……让我"}, {"type": "subtitle", "time": 10847.469, "timestamp": "03:00:47", "text": "决定该怎么做。该怎么办？什么"}, {"type": "subtitle", "time": 10853.94, "timestamp": "03:00:53", "text": "做？好的。我会把所有私信都转达给你。呃"}, {"type": "subtitle", "time": 10855.87, "timestamp": "03:00:55", "text": "[音乐]"}, {"type": "subtitle", "time": 10859.51, "timestamp": "03:00:59", "text": "嗯，等等，我看到茉莉的儿子走了，我会的"}]
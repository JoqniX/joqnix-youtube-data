[{"type": "subtitle", "time": 23880.11, "timestamp": "06:38:00", "text": "去。哦，我的"}, {"type": "subtitle", "time": 23882.19, "timestamp": "06:38:02", "text": "上帝。不，不要"}, {"type": "subtitle", "time": 23886.11, "timestamp": "06:38:06", "text": "死。我的天啊。"}, {"type": "subtitle", "time": 23897.31, "timestamp": "06:38:17", "text": "可怕的。我的天哪，她好可怕。看看"}, {"type": "subtitle", "time": 23901.628, "timestamp": "06:38:21", "text": "它。哦，不错。"}, {"type": "subtitle", "time": 23907.628, "timestamp": "06:38:27", "text": "那是"}, {"type": "subtitle", "time": 23917.83, "timestamp": "06:38:37", "text": "[音乐]"}, {"type": "subtitle", "time": 23920.67, "timestamp": "06:38:40", "text": "我应该打中路"}, {"type": "subtitle", "time": 23924.628, "timestamp": "06:38:44", "text": "实际上，与其说是“嗯”，不如说我应该"}]
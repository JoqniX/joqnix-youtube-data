[{"type": "subtitle", "time": 12606.11, "timestamp": "03:30:06", "text": "你好。是的。嗯，昨天"}, {"type": "subtitle", "time": 12609.83, "timestamp": "03:30:09", "text": "真是混乱啊！昨天有点……"}, {"type": "subtitle", "time": 12611.15, "timestamp": "03:30:11", "text": "混乱的，"}, {"type": "subtitle", "time": 12614.309, "timestamp": "03:30:14", "text": "正确的？但没关系。昨天是"}, {"type": "subtitle", "time": 12617.54, "timestamp": "03:30:17", "text": "虽然有点混乱，但一切都好。好的。"}, {"type": "subtitle", "time": 12620.389, "timestamp": "03:30:20", "text": "[音乐]"}, {"type": "subtitle", "time": 12623.59, "timestamp": "03:30:23", "text": "我其实把牙膏都用完了。"}, {"type": "subtitle", "time": 12626.15, "timestamp": "03:30:26", "text": "水，把我体内的东西全部排出来了。所以，"}, {"type": "subtitle", "time": 12630.19, "timestamp": "03:30:30", "text": "我还可以。我很好。"}, {"type": "subtitle", "time": 12638.229, "timestamp": "03:30:38", "text": "是的。哦，等等。我忘了开始"}, {"type": "subtitle", "time": 12640.99, "timestamp": "03:30:40", "text": "记录。哦，"}, {"type": "subtitle", "time": 12643.429, "timestamp": "03:30:43", "text": "不。我竟然忘了开始"}, {"type": "subtitle", "time": 12646.469, "timestamp": "03:30:46", "text": "正在录制我的直播。哦，我不知道。"}, {"type": "subtitle", "time": 12649.11, "timestamp": "03:30:49", "text": "如果你注意到了，我昨天发帖了……"}, {"type": "subtitle", "time": 12653.349, "timestamp": "03:30:53", "text": "我的推特、脸书和Discord账号都是我的王牌"}, {"type": "subtitle", "time": 12657.11, "timestamp": "03:30:57", "text": "Valerance 在 Valerin 中的片段"}, {"type": "subtitle", "time": 12659.469, "timestamp": "03:30:59", "text": "昨天合作完成。"}]
[{"type": "subtitle", "time": 5763.27, "timestamp": "01:36:03", "text": "去。去。是的。然后把它射到楼下"}, {"type": "subtitle", "time": 5765.35, "timestamp": "01:36:05", "text": "天空那个。"}, {"type": "subtitle", "time": 5793.75, "timestamp": "01:36:33", "text": "啊。来。做得好。安全立方体"}, {"type": "subtitle", "time": 5797.38, "timestamp": "01:36:37", "text": "容器。你应该"}, {"type": "subtitle", "time": 5798.709, "timestamp": "01:36:38", "text": "[音乐]"}, {"type": "subtitle", "time": 5801.669, "timestamp": "01:36:41", "text": "你让我生气了。"}]
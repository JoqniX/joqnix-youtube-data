[{"type": "subtitle", "time": 2521.51, "timestamp": "00:42:01", "text": "什么？"}, {"type": "subtitle", "time": 2525.71, "timestamp": "00:42:05", "text": "她怎么能这样呢？"}, {"type": "subtitle", "time": 2527.95, "timestamp": "00:42:07", "text": "[音乐]"}, {"type": "subtitle", "time": 2531.75, "timestamp": "00:42:11", "text": "那里？我的天啊。"}, {"type": "subtitle", "time": 2535.39, "timestamp": "00:42:15", "text": "是的，那里有一些"}, {"type": "subtitle", "time": 2552.069, "timestamp": "00:42:32", "text": "这里。是的。是的。是的。还有优步。"}, {"type": "subtitle", "time": 2559.43, "timestamp": "00:42:39", "text": "是的。我来了。"}, {"type": "subtitle", "time": 2561.43, "timestamp": "00:42:41", "text": "那么，请继续。我几乎放弃了希望"}, {"type": "subtitle", "time": 2564.87, "timestamp": "00:42:44", "text": "永远。你知道，我是个天才女孩。是的。"}, {"type": "subtitle", "time": 2573.829, "timestamp": "00:42:53", "text": "完成本课程后，行为举止将如同"}]
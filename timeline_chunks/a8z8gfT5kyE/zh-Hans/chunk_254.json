[{"type": "subtitle", "time": 15257.309, "timestamp": "04:14:17", "text": "你好。我之前不知道这件事。不"}, {"type": "subtitle", "time": 15260.51, "timestamp": "04:14:20", "text": "担忧。呃，我是"}, {"type": "subtitle", "time": 15263.51, "timestamp": "04:14:23", "text": "去。你好。小心。谢谢"}, {"type": "subtitle", "time": 15264.51, "timestamp": "04:14:24", "text": "下降"}, {"type": "subtitle", "time": 15268.03, "timestamp": "04:14:28", "text": "经过。这让我非常高兴。"}, {"type": "subtitle", "time": 15270.189, "timestamp": "04:14:30", "text": "你仍然"}, {"type": "subtitle", "time": 15273.55, "timestamp": "04:14:33", "text": "记得来过。感谢"}, {"type": "subtitle", "time": 15276.229, "timestamp": "04:14:36", "text": "你和你的家人现在都要好好照顾自己。希望您能拥有"}, {"type": "subtitle", "time": 15294.91, "timestamp": "04:14:54", "text": "它？我是"}, {"type": "subtitle", "time": 15296.83, "timestamp": "04:14:56", "text": "未来。"}, {"type": "subtitle", "time": 15299.75, "timestamp": "04:14:59", "text": "啊，我还需要再多杀几人。"}]
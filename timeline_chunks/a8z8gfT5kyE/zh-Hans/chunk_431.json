[{"type": "subtitle", "time": 25864.708, "timestamp": "07:11:04", "text": "那玩意儿？全部解锁。好的。我希望我能"}, {"type": "subtitle", "time": 25867.35, "timestamp": "07:11:07", "text": "抓紧时间做，因为时间只剩一点点了。"}, {"type": "subtitle", "time": 25869.948, "timestamp": "07:11:09", "text": "还剩几天时间，"}, {"type": "subtitle", "time": 25882.07, "timestamp": "07:11:22", "text": "什么？似乎这些事件与此无关。"}, {"type": "subtitle", "time": 25883.788, "timestamp": "07:11:23", "text": "游戏真的就像……"}, {"type": "subtitle", "time": 25894.82, "timestamp": "07:11:34", "text": "哦"}, {"type": "subtitle", "time": 25901.19, "timestamp": "07:11:41", "text": "男生。店铺。现在我想知道所有物品都有哪些。"}, {"type": "subtitle", "time": 25902.868, "timestamp": "07:11:42", "text": "就在那里。我知道这东西在那里，"}, {"type": "subtitle", "time": 25905.91, "timestamp": "07:11:45", "text": "但我不知道。哦，我想我需要一个"}, {"type": "subtitle", "time": 25907.75, "timestamp": "07:11:47", "text": "花费"}, {"type": "subtitle", "time": 25911.23, "timestamp": "07:11:51", "text": "呃，这东西要1600美元。"}, {"type": "subtitle", "time": 25914.67, "timestamp": "07:11:54", "text": "2,000。我的天哪，那是一个"}, {"type": "subtitle", "time": 25917.83, "timestamp": "07:11:57", "text": "很多。哇。"}]
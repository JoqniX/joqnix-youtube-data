[{"type": "subtitle", "time": 14283.99, "timestamp": "03:58:03", "text": "不知怎么的。我的天哪，我立刻就尿出来了。"}, {"type": "subtitle", "time": 14286.469, "timestamp": "03:58:06", "text": "我的天哪，太酷了！那真是太……"}, {"type": "subtitle", "time": 14288.349, "timestamp": "03:58:08", "text": "好的。那真是太……"}, {"type": "subtitle", "time": 14293.83, "timestamp": "03:58:13", "text": "好的。我的天哪，太棒了！"}, {"type": "subtitle", "time": 14305.51, "timestamp": "03:58:25", "text": "我的天啊。为什么每次都是我？"}, {"type": "subtitle", "time": 14313.49, "timestamp": "03:58:33", "text": "兄弟，一起混。"}, {"type": "subtitle", "time": 14321.59, "timestamp": "03:58:41", "text": "是的，这就是皮肤。我想要这个"}, {"type": "subtitle", "time": 14324.87, "timestamp": "03:58:44", "text": "特点。我拿到枪了，但我需要"}, {"type": "subtitle", "time": 14328.51, "timestamp": "03:58:48", "text": "获得服装和横幅"}, {"type": "subtitle", "time": 14331.11, "timestamp": "03:58:51", "text": "一切。这是活动皮肤。"}]
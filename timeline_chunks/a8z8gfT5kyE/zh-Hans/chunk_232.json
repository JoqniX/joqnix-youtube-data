[{"type": "subtitle", "time": 13923.429, "timestamp": "03:52:03", "text": "更多的。所以，我成功获得了这款皮肤。"}, {"type": "subtitle", "time": 13925.71, "timestamp": "03:52:05", "text": "我需要获得这个角色"}, {"type": "subtitle", "time": 13929.91, "timestamp": "03:52:09", "text": "皮肤。所以为此我需要得到……"}, {"type": "subtitle", "time": 13931.99, "timestamp": "03:52:11", "text": "贴纸之类的东西。我得完成"}, {"type": "subtitle", "time": 13937.389, "timestamp": "03:52:17", "text": "这些东西，然后声称我"}, {"type": "subtitle", "time": 13940.87, "timestamp": "03:52:20", "text": "猜测。做完这件事之后，我想我"}, {"type": "subtitle", "time": 13944.03, "timestamp": "03:52:24", "text": "我觉得这件事还有隐情。我不"}, {"type": "subtitle", "time": 13947.429, "timestamp": "03:52:27", "text": "知道。我希望我能完成它。所以，我只"}, {"type": "subtitle", "time": 13952.51, "timestamp": "03:52:32", "text": "我有时间，直到我只剩下时间了，嗯"}, {"type": "subtitle", "time": 13955.429, "timestamp": "03:52:35", "text": "呃，六月，下个月是几号来着？六月"}, {"type": "subtitle", "time": 13959.75, "timestamp": "03:52:39", "text": "第三。是的，1963年6月3日。所以，是的。所以，"}, {"type": "subtitle", "time": 13961.83, "timestamp": "03:52:41", "text": "真是有点麻烦。好吧，那就这样吧。"}, {"type": "subtitle", "time": 13963.95, "timestamp": "03:52:43", "text": "演奏瓦莱林"}, {"type": "subtitle", "time": 13968.03, "timestamp": "03:52:48", "text": "匹配。让我们来玩瓦莱林·皮尤吧"}, {"type": "subtitle", "time": 13976.469, "timestamp": "03:52:56", "text": "是的，我的喉咙。"}]
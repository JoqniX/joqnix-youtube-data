[{"type": "subtitle", "time": 5941.99, "timestamp": "01:39:01", "text": "什么？你应该上楼去。"}, {"type": "subtitle", "time": 5953.229, "timestamp": "01:39:13", "text": "这里。不，不，不。搬到这里来。移至"}, {"type": "subtitle", "time": 5956.79, "timestamp": "01:39:16", "text": "他就在我旁边，是的。是的。然后射击"}, {"type": "subtitle", "time": 5966.149, "timestamp": "01:39:26", "text": "嗯，我会向你解释的。"}, {"type": "subtitle", "time": 5969.59, "timestamp": "01:39:29", "text": "正确的。哦好的。好的。我将跳到"}, {"type": "subtitle", "time": 5971.189, "timestamp": "01:39:31", "text": "这里。"}, {"type": "subtitle", "time": 5977.109, "timestamp": "01:39:37", "text": "嗨！我跳起来，获得了力量。你"}, {"type": "subtitle", "time": 5980.629, "timestamp": "01:39:40", "text": "还得再往前开一枪。"}, {"type": "subtitle", "time": 5983.83, "timestamp": "01:39:43", "text": "哦好的。你知道。是的。"}, {"type": "subtitle", "time": 5987.43, "timestamp": "01:39:47", "text": "所以如果我有能力，我就可以跳过去"}, {"type": "subtitle", "time": 5989.109, "timestamp": "01:39:49", "text": "那里。"}, {"type": "subtitle", "time": 5992.47, "timestamp": "01:39:52", "text": "哦，你好。你明白吗？"}]
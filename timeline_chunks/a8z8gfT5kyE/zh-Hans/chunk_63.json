[{"type": "subtitle", "time": 3784.27, "timestamp": "01:03:04", "text": "什么？不要走远。"}, {"type": "subtitle", "time": 3786.349, "timestamp": "01:03:06", "text": "嗯。"}, {"type": "subtitle", "time": 3812.87, "timestamp": "01:03:32", "text": "我在这里。哦。哦，不错。推。推。"}, {"type": "subtitle", "time": 3820.789, "timestamp": "01:03:40", "text": "推。哦。去。去。你杀了我。你"}, {"type": "subtitle", "time": 3823.829, "timestamp": "01:03:43", "text": "杀了我。"}, {"type": "subtitle", "time": 3825.95, "timestamp": "01:03:45", "text": "去。去。去。"}, {"type": "subtitle", "time": 3839.75, "timestamp": "01:03:59", "text": "我会每天都哭。哦，不。我的天啊。"}]
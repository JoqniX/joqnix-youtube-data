[{"type": "subtitle", "time": 14041.55, "timestamp": "03:54:01", "text": "手枪更好"}, {"type": "subtitle", "time": 14056.07, "timestamp": "03:54:16", "text": "这是我最不喜欢的地方，因为……"}, {"type": "subtitle", "time": 14057.63, "timestamp": "03:54:17", "text": "爬不上去"}, {"type": "subtitle", "time": 14060.79, "timestamp": "03:54:20", "text": "那里。你需要有人帮助你。"}, {"type": "subtitle", "time": 14063.03, "timestamp": "03:54:23", "text": "随风而行。有些我忘了是哪些。"}, {"type": "subtitle", "time": 14065.189, "timestamp": "03:54:25", "text": "角色让你获得"}, {"type": "subtitle", "time": 14068.269, "timestamp": "03:54:28", "text": "风的东西。这是唯一的办法"}, {"type": "subtitle", "time": 14072.469, "timestamp": "03:54:32", "text": "向上。我简直无法攀爬墙壁。所以，"}, {"type": "subtitle", "time": 14074.71, "timestamp": "03:54:34", "text": "还要别的吗？"}, {"type": "subtitle", "time": 14076.469, "timestamp": "03:54:36", "text": "我会去上课。再见。看"}, {"type": "subtitle", "time": 14078.75, "timestamp": "03:54:38", "text": "你。祝你直播顺利。你好。感谢"}, {"type": "subtitle", "time": 14082.55, "timestamp": "03:54:42", "text": "你。谢谢您光临，D. Do"}]
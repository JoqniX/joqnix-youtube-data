[{"type": "subtitle", "time": 13141.83, "timestamp": "03:39:01", "text": "玩她，我玩得不错，瞄准方面也很好。"}, {"type": "subtitle", "time": 13146.15, "timestamp": "03:39:06", "text": "还有一些其他的东西。我其实有时候会这么做。"}, {"type": "subtitle", "time": 13149.07, "timestamp": "03:39:09", "text": "好的。我玩"}, {"type": "subtitle", "time": 13153.67, "timestamp": "03:39:13", "text": "好的。但是对于那位女士，我的意思是呃"}, {"type": "subtitle", "time": 13156.71, "timestamp": "03:39:16", "text": "谢谢。呃，你等着瞧。我称之为"}, {"type": "subtitle", "time": 13160.07, "timestamp": "03:39:20", "text": "安慰女士。我忘了名字。哦"}, {"type": "subtitle", "time": 13161.75, "timestamp": "03:39:21", "text": "不知道。哦，等等。谢谢"}, {"type": "subtitle", "time": 13163.63, "timestamp": "03:39:23", "text": "提醒。"}, {"type": "subtitle", "time": 13166.55, "timestamp": "03:39:26", "text": "呃，谢谢提醒。是的，那里"}, {"type": "subtitle", "time": 13169.269, "timestamp": "03:39:29", "text": "你去。"}, {"type": "subtitle", "time": 13173.19, "timestamp": "03:39:33", "text": "你可能会听到类似“终于听到音频”的声音"}, {"type": "subtitle", "time": 13192.03, "timestamp": "03:39:52", "text": "熏肉。"}, {"type": "subtitle", "time": 13198.03, "timestamp": "03:39:58", "text": "[音乐]"}]
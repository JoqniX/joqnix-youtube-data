[{"type": "subtitle", "time": 19103.67, "timestamp": "05:18:23", "text": "楼主。她去了哪里？她在等什么？"}, {"type": "subtitle", "time": 19106.708, "timestamp": "05:18:26", "text": "我还是什么？等等，她消失了。"}, {"type": "subtitle", "time": 19109.07, "timestamp": "05:18:29", "text": "如何？什么时候？"}, {"type": "subtitle", "time": 19120.19, "timestamp": "05:18:40", "text": "什么？还有，那就像"}, {"type": "subtitle", "time": 19123.35, "timestamp": "05:18:43", "text": "咖啡拉花之类的？等待，"}]
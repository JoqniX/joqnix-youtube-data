[{"type": "subtitle", "time": 22085.99, "timestamp": "06:08:05", "text": "好的。来自船长奖品的声音"}, {"type": "subtitle", "time": 22087.43, "timestamp": "06:08:07", "text": "记住切换到备用电源"}, {"type": "subtitle", "time": 22090.628, "timestamp": "06:08:10", "text": "我的副武器总是比我的主武器快。"}, {"type": "subtitle", "time": 22099.67, "timestamp": "06:08:19", "text": "我的第二个问题是……我好像被诅咒了。"}, {"type": "subtitle", "time": 22100.83, "timestamp": "06:08:20", "text": "什么？"}, {"type": "subtitle", "time": 22102.99, "timestamp": "06:08:22", "text": "为什么？ WHO？"}, {"type": "subtitle", "time": 22107.67, "timestamp": "06:08:27", "text": "为什么？为什么？谁在暗恋你？"}]
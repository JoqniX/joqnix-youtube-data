[{"type": "subtitle", "time": 5160.91, "timestamp": "01:26:00", "text": "嗯？在哪裡？餘。"}, {"type": "subtitle", "time": 5162.149, "timestamp": "01:26:02", "text": "嗯？它去哪了？"}, {"type": "subtitle", "time": 5168.79, "timestamp": "01:26:08", "text": "向下。"}, {"type": "subtitle", "time": 5174.39, "timestamp": "01:26:14", "text": "等等，等等。我帶來了光明。"}, {"type": "subtitle", "time": 5175.669, "timestamp": "01:26:15", "text": "哦，他們在那兒。"}, {"type": "subtitle", "time": 5183.109, "timestamp": "01:26:23", "text": "天黑了。"}, {"type": "subtitle", "time": 5194.95, "timestamp": "01:26:34", "text": "出事了。"}, {"type": "subtitle", "time": 5196.819, "timestamp": "01:26:36", "text": "哦，我可以做到。再見物品。"}, {"type": "subtitle", "time": 5208.43, "timestamp": "01:26:48", "text": "好痛。好的。好痛。"}]
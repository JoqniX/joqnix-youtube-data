[{"type": "subtitle", "time": 6432.99, "timestamp": "01:47:12", "text": "啊，就是這裡。不掛。"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "在哪裡？酸甜汁。運動服。"}, {"type": "subtitle", "time": 6440.07, "timestamp": "01:47:20", "text": "哦，向上，向上，向上。"}, {"type": "subtitle", "time": 6442.35, "timestamp": "01:47:22", "text": "樓上？哦，不，不。有。"}, {"type": "subtitle", "time": 6443.35, "timestamp": "01:47:23", "text": "我要走了，我要走了。我們上去吧。"}, {"type": "subtitle", "time": 6451.589, "timestamp": "01:47:31", "text": "燈塔"}, {"type": "subtitle", "time": 6458.669, "timestamp": "01:47:38", "text": "是的。"}, {"type": "subtitle", "time": 6459.83, "timestamp": "01:47:39", "text": "那樣的話？"}, {"type": "subtitle", "time": 6465.39, "timestamp": "01:47:45", "text": "真的很遠。"}]
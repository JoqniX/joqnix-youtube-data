[{"type": "subtitle", "time": 4204.47, "timestamp": "01:10:04", "text": "呃，我該怎麼辦？"}, {"type": "subtitle", "time": 4205.709, "timestamp": "01:10:05", "text": "這是一個枕頭。"}, {"type": "subtitle", "time": 4218.07, "timestamp": "01:10:18", "text": "是的。是的。 O Park"}, {"type": "subtitle", "time": 4226.669, "timestamp": "01:10:26", "text": "某人"}, {"type": "subtitle", "time": 4237.55, "timestamp": "01:10:37", "text": "嗯？在哪裡？"}, {"type": "subtitle", "time": 4239.79, "timestamp": "01:10:39", "text": "你有嗎？"}, {"type": "subtitle", "time": 4246.35, "timestamp": "01:10:46", "text": "是的。是的。是的。是的。一個。"}, {"type": "subtitle", "time": 4248.43, "timestamp": "01:10:48", "text": "等等，等等。平良先生"}, {"type": "subtitle", "time": 4250.87, "timestamp": "01:10:50", "text": "請點擊此處。"}, {"type": "subtitle", "time": 4251.11, "timestamp": "01:10:51", "text": "是的。"}, {"type": "subtitle", "time": 4252.83, "timestamp": "01:10:52", "text": "在哪裡？在哪裡？在哪裡？"}, {"type": "subtitle", "time": 4255.31, "timestamp": "01:10:55", "text": "這個球"}, {"type": "subtitle", "time": 4255.709, "timestamp": "01:10:55", "text": "是的。"}, {"type": "subtitle", "time": 4258.27, "timestamp": "01:10:58", "text": "我可能就在這裡。"}]
[{"type": "subtitle", "time": 1863.509, "timestamp": "00:31:03", "text": "我同意。我，"}, {"type": "subtitle", "time": 1864.75, "timestamp": "00:31:04", "text": "你好。"}, {"type": "subtitle", "time": 1867.269, "timestamp": "00:31:07", "text": "我們看起來像餃子。"}, {"type": "subtitle", "time": 1867.669, "timestamp": "00:31:07", "text": "圖片，"}, {"type": "subtitle", "time": 1871.87, "timestamp": "00:31:11", "text": "[笑聲]"}, {"type": "subtitle", "time": 1878.149, "timestamp": "00:31:18", "text": "是的。"}, {"type": "subtitle", "time": 1880.83, "timestamp": "00:31:20", "text": "這是什麼？"}, {"type": "subtitle", "time": 1883.791, "timestamp": "00:31:23", "text": "哦，原來是排名。"}, {"type": "subtitle", "time": 1889.23, "timestamp": "00:31:29", "text": "我懂了。我親愛的。"}, {"type": "subtitle", "time": 1889.83, "timestamp": "00:31:29", "text": "是的。"}, {"type": "subtitle", "time": 1890.75, "timestamp": "00:31:30", "text": "我們走吧。"}, {"type": "subtitle", "time": 1890.99, "timestamp": "00:31:30", "text": "是的。"}, {"type": "subtitle", "time": 1892.75, "timestamp": "00:31:32", "text": "我們走吧。"}, {"type": "subtitle", "time": 1901.629, "timestamp": "00:31:41", "text": "團子兄弟。"}, {"type": "subtitle", "time": 1907.59, "timestamp": "00:31:47", "text": "是的。也許"}, {"type": "subtitle", "time": 1909.83, "timestamp": "00:31:49", "text": "這裡。"}, {"type": "subtitle", "time": 1910.75, "timestamp": "00:31:50", "text": "是的。"}, {"type": "subtitle", "time": 1912.99, "timestamp": "00:31:52", "text": "我可能會把它發到這裡。"}, {"type": "subtitle", "time": 1914.35, "timestamp": "00:31:54", "text": "好的。"}, {"type": "subtitle", "time": 1915.11, "timestamp": "00:31:55", "text": "是的。"}, {"type": "subtitle", "time": 1918.629, "timestamp": "00:31:58", "text": "帕茲納好像在那裡。"}, {"type": "subtitle", "time": 1919.71, "timestamp": "00:31:59", "text": "是的。"}]
[{"type": "subtitle", "time": 4264.229, "timestamp": "01:11:04", "text": "所以，我需要得到這個。"}, {"type": "subtitle", "time": 4266.03, "timestamp": "01:11:06", "text": "是的，是的，是的。"}, {"type": "subtitle", "time": 4267.03, "timestamp": "01:11:07", "text": "我懂了。我明白了"}, {"type": "subtitle", "time": 4275.31, "timestamp": "01:11:15", "text": "雨衣。"}, {"type": "subtitle", "time": 4278.07, "timestamp": "01:11:18", "text": "接住它。給您，女士。"}, {"type": "subtitle", "time": 4279.79, "timestamp": "01:11:19", "text": "我跑了。我想跑步"}, {"type": "subtitle", "time": 4298.229, "timestamp": "01:11:38", "text": "我應該這樣扔嗎？一會兒。"}, {"type": "subtitle", "time": 4300.31, "timestamp": "01:11:40", "text": "大概。"}, {"type": "subtitle", "time": 4300.91, "timestamp": "01:11:40", "text": "啊，"}, {"type": "subtitle", "time": 4303.83, "timestamp": "01:11:43", "text": "不是這樣。"}, {"type": "subtitle", "time": 4313.669, "timestamp": "01:11:53", "text": "他還有呼吸。在哪裡？"}]
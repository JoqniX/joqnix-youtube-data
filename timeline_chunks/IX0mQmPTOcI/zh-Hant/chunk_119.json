[{"type": "subtitle", "time": 7155.83, "timestamp": "01:59:15", "text": "哦，我們。"}, {"type": "subtitle", "time": 7160.589, "timestamp": "01:59:20", "text": "啊，"}, {"type": "subtitle", "time": 7163.149, "timestamp": "01:59:23", "text": "我當時正在做這件事。他們當時正在這樣做。"}, {"type": "subtitle", "time": 7185.27, "timestamp": "01:59:45", "text": "這不是黑塔。"}, {"type": "subtitle", "time": 7186.03, "timestamp": "01:59:46", "text": "啊，"}, {"type": "subtitle", "time": 7187.229, "timestamp": "01:59:47", "text": "不，不是那樣。"}, {"type": "subtitle", "time": 7193.43, "timestamp": "01:59:53", "text": "是的，它是綠色的。"}, {"type": "subtitle", "time": 7193.91, "timestamp": "01:59:53", "text": "是的。"}]
[{"type": "subtitle", "time": 4021.47, "timestamp": "01:07:01", "text": "啊，找到了。啊，不。"}, {"type": "subtitle", "time": 4032.99, "timestamp": "01:07:12", "text": "是的。就是這樣。"}, {"type": "subtitle", "time": 4034.95, "timestamp": "01:07:14", "text": "那我們就一起做吧。"}, {"type": "subtitle", "time": 4035.63, "timestamp": "01:07:15", "text": "啊。"}, {"type": "subtitle", "time": 4037.43, "timestamp": "01:07:17", "text": "是的。"}, {"type": "subtitle", "time": 4038.39, "timestamp": "01:07:18", "text": "不掛。"}, {"type": "subtitle", "time": 4047.069, "timestamp": "01:07:27", "text": "我要去"}, {"type": "subtitle", "time": 4048.15, "timestamp": "01:07:28", "text": "右側。"}, {"type": "subtitle", "time": 4053.549, "timestamp": "01:07:33", "text": "圓圈。哦。"}, {"type": "subtitle", "time": 4058.349, "timestamp": "01:07:38", "text": "弘。這裡。"}, {"type": "subtitle", "time": 4059.109, "timestamp": "01:07:39", "text": "嗯？在哪裡？在哪裡？在哪裡？"}, {"type": "subtitle", "time": 4063.91, "timestamp": "01:07:43", "text": "[笑聲]"}, {"type": "subtitle", "time": 4066.23, "timestamp": "01:07:46", "text": "沒關係。沒關係。"}, {"type": "subtitle", "time": 4068.896, "timestamp": "01:07:48", "text": "對不起。沒關係。沒關係。"}, {"type": "subtitle", "time": 4074.136, "timestamp": "01:07:54", "text": "不用擔心。"}, {"type": "subtitle", "time": 4074.39, "timestamp": "01:07:54", "text": "[笑聲]"}, {"type": "subtitle", "time": 4075.91, "timestamp": "01:07:55", "text": "是的。"}]
[{"type": "subtitle", "time": 3184.589, "timestamp": "00:53:04", "text": "啊，智和"}, {"type": "subtitle", "time": 3186.829, "timestamp": "00:53:06", "text": "哇，這是個揚聲器！"}, {"type": "subtitle", "time": 3187.829, "timestamp": "00:53:07", "text": "是的"}, {"type": "subtitle", "time": 3193.19, "timestamp": "00:53:13", "text": "嗯，旋轉起來真的"}, {"type": "subtitle", "time": 3196.71, "timestamp": "00:53:16", "text": "尋找我聽和遠"}, {"type": "subtitle", "time": 3200.43, "timestamp": "00:53:20", "text": "遠離不同的聲音"}, {"type": "subtitle", "time": 3200.829, "timestamp": "00:53:20", "text": "我同意。"}, {"type": "subtitle", "time": 3202.321, "timestamp": "00:53:22", "text": "聽起來有點不一樣。"}, {"type": "subtitle", "time": 3203.349, "timestamp": "00:53:23", "text": "[音樂]"}, {"type": "subtitle", "time": 3205.19, "timestamp": "00:53:25", "text": "是的，是的，是的"}, {"type": "subtitle", "time": 3206.19, "timestamp": "00:53:26", "text": "是的。"}, {"type": "subtitle", "time": 3209.789, "timestamp": "00:53:29", "text": "是的？"}, {"type": "subtitle", "time": 3211.87, "timestamp": "00:53:31", "text": "在哪裡？在哪裡？在哪裡？我們要去哪裡？"}, {"type": "subtitle", "time": 3214.19, "timestamp": "00:53:34", "text": "在哪裡？過來。"}, {"type": "subtitle", "time": 3215.43, "timestamp": "00:53:35", "text": "這裡。"}, {"type": "subtitle", "time": 3216.069, "timestamp": "00:53:36", "text": "是的。"}, {"type": "subtitle", "time": 3233.19, "timestamp": "00:53:53", "text": "比問"}, {"type": "subtitle", "time": 3236.549, "timestamp": "00:53:56", "text": "開始了。我們和 J 在一起。"}, {"type": "subtitle", "time": 3238.91, "timestamp": "00:53:58", "text": "我正在和 Jok 一起玩。"}]
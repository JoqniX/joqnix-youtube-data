[{"type": "subtitle", "time": 6780.75, "timestamp": "01:53:00", "text": "我不太好。"}, {"type": "subtitle", "time": 6783.229, "timestamp": "01:53:03", "text": "我可以動。"}, {"type": "subtitle", "time": 6785.83, "timestamp": "01:53:05", "text": "呃，我該怎麼辦？我該怎麼辦？"}, {"type": "subtitle", "time": 6788.35, "timestamp": "01:53:08", "text": "運動健將，運動健將，運動健將"}, {"type": "subtitle", "time": 6791.109, "timestamp": "01:53:11", "text": "是餘。"}, {"type": "subtitle", "time": 6791.39, "timestamp": "01:53:11", "text": "啊，"}, {"type": "subtitle", "time": 6802.069, "timestamp": "01:53:22", "text": "喬克不在。"}, {"type": "subtitle", "time": 6817.589, "timestamp": "01:53:37", "text": "嗯？在哪裡？"}, {"type": "subtitle", "time": 6818.109, "timestamp": "01:53:38", "text": "是的。"}, {"type": "subtitle", "time": 6820.03, "timestamp": "01:53:40", "text": "在哪裡？"}, {"type": "subtitle", "time": 6820.91, "timestamp": "01:53:40", "text": "你在嗎？"}, {"type": "subtitle", "time": 6822.629, "timestamp": "01:53:42", "text": "它在哪裡？它在哪裡？"}, {"type": "subtitle", "time": 6827.51, "timestamp": "01:53:47", "text": "H-這裡。"}, {"type": "subtitle", "time": 6838.87, "timestamp": "01:53:58", "text": "Yoisho 有 gajoku"}]
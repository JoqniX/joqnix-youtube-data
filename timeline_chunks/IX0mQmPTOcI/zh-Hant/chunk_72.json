[{"type": "subtitle", "time": 4320.79, "timestamp": "01:12:00", "text": "等等，什麼？"}, {"type": "subtitle", "time": 4323.669, "timestamp": "01:12:03", "text": "你看得出右邊的計時器嗎？"}, {"type": "subtitle", "time": 4328.669, "timestamp": "01:12:08", "text": "假名？"}, {"type": "subtitle", "time": 4328.95, "timestamp": "01:12:08", "text": "你看到了嗎？"}, {"type": "subtitle", "time": 4339.27, "timestamp": "01:12:19", "text": "球，球在球館。"}, {"type": "subtitle", "time": 4340.59, "timestamp": "01:12:20", "text": "是的。"}, {"type": "subtitle", "time": 4345.149, "timestamp": "01:12:25", "text": "哦，他在那兒。"}, {"type": "subtitle", "time": 4345.95, "timestamp": "01:12:25", "text": "一個，"}, {"type": "subtitle", "time": 4348.229, "timestamp": "01:12:28", "text": "一會兒。喬"}, {"type": "subtitle", "time": 4361.47, "timestamp": "01:12:41", "text": "哦，給你。"}, {"type": "subtitle", "time": 4361.709, "timestamp": "01:12:41", "text": "是的。"}, {"type": "subtitle", "time": 4363.65, "timestamp": "01:12:43", "text": "這裡是。這裡。我應該在這裡交給它嗎？"}, {"type": "subtitle", "time": 4364.83, "timestamp": "01:12:44", "text": "[笑聲]"}, {"type": "subtitle", "time": 4366.83, "timestamp": "01:12:46", "text": "我們到了。"}]
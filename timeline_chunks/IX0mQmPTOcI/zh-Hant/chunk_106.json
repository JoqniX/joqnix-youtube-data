[{"type": "subtitle", "time": 6362.229, "timestamp": "01:46:02", "text": "真的很遠。"}, {"type": "subtitle", "time": 6369.709, "timestamp": "01:46:09", "text": "這也是一座燈塔嗎？"}, {"type": "subtitle", "time": 6377.143, "timestamp": "01:46:17", "text": "是的，"}, {"type": "subtitle", "time": 6378.149, "timestamp": "01:46:18", "text": "[笑聲]"}, {"type": "subtitle", "time": 6384.55, "timestamp": "01:46:24", "text": "糟糕的。"}, {"type": "subtitle", "time": 6389.07, "timestamp": "01:46:29", "text": "假名？"}, {"type": "subtitle", "time": 6390.31, "timestamp": "01:46:30", "text": "我該放進去嗎？"}, {"type": "subtitle", "time": 6396.47, "timestamp": "01:46:36", "text": "開始了。是的。按下去。推。我要按下它。"}, {"type": "subtitle", "time": 6399.31, "timestamp": "01:46:39", "text": "是的。是的。謝謝。"}, {"type": "subtitle", "time": 6404.629, "timestamp": "01:46:44", "text": "任何？我們需要這樣做。"}, {"type": "subtitle", "time": 6405.83, "timestamp": "01:46:45", "text": "如何？"}, {"type": "subtitle", "time": 6410.75, "timestamp": "01:46:50", "text": "我們應該回去嗎？"}, {"type": "subtitle", "time": 6412.55, "timestamp": "01:46:52", "text": "是的。"}, {"type": "subtitle", "time": 6416.95, "timestamp": "01:46:56", "text": "回去沒問題。"}, {"type": "subtitle", "time": 6418.669, "timestamp": "01:46:58", "text": "這是正確的。"}]
[{"type": "subtitle", "time": 2820.03, "timestamp": "00:47:00", "text": "[笑聲]"}, {"type": "subtitle", "time": 2821.829, "timestamp": "00:47:01", "text": "她的腋窩太美了。"}, {"type": "subtitle", "time": 2823.51, "timestamp": "00:47:03", "text": "我們回去吧。"}, {"type": "subtitle", "time": 2825.23, "timestamp": "00:47:05", "text": "是的。"}, {"type": "subtitle", "time": 2826.71, "timestamp": "00:47:06", "text": "僅"}, {"type": "subtitle", "time": 2827.43, "timestamp": "00:47:07", "text": "假名？"}, {"type": "subtitle", "time": 2828.15, "timestamp": "00:47:08", "text": "是的。"}, {"type": "subtitle", "time": 2837.75, "timestamp": "00:47:17", "text": "我認為"}, {"type": "subtitle", "time": 2843.27, "timestamp": "00:47:23", "text": "一個，"}, {"type": "subtitle", "time": 2862.43, "timestamp": "00:47:42", "text": "藤瀨桑"}]
[{"type": "subtitle", "time": 4380.31, "timestamp": "01:13:00", "text": "是的。"}, {"type": "subtitle", "time": 4416.706, "timestamp": "01:13:36", "text": "我們能到達那裡嗎？從上方俯瞰。我懂了。我會盡力而為。"}, {"type": "subtitle", "time": 4417.95, "timestamp": "01:13:37", "text": "[笑聲]"}, {"type": "subtitle", "time": 4424.27, "timestamp": "01:13:44", "text": "假名。"}, {"type": "subtitle", "time": 4432.07, "timestamp": "01:13:52", "text": "thanforthanhowareyu"}, {"type": "subtitle", "time": 4432.629, "timestamp": "01:13:52", "text": "為了"}]
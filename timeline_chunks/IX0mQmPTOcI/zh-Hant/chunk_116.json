[{"type": "subtitle", "time": 6966.229, "timestamp": "01:56:06", "text": "嘿。"}, {"type": "subtitle", "time": 6976.83, "timestamp": "01:56:16", "text": "我們去紅塔吧。"}, {"type": "subtitle", "time": 6985.149, "timestamp": "01:56:25", "text": "是的，你可以用它。"}, {"type": "subtitle", "time": 6986.55, "timestamp": "01:56:26", "text": "哦嚯。"}, {"type": "subtitle", "time": 7000.83, "timestamp": "01:56:40", "text": "好的。啊。"}, {"type": "subtitle", "time": 7002.675, "timestamp": "01:56:42", "text": "他踢了它一腳。"}, {"type": "subtitle", "time": 7003.99, "timestamp": "01:56:43", "text": "[笑聲]"}, {"type": "subtitle", "time": 7005.31, "timestamp": "01:56:45", "text": "這很糟糕，這很糟糕。"}, {"type": "subtitle", "time": 7005.589, "timestamp": "01:56:45", "text": "是的。"}, {"type": "subtitle", "time": 7006.149, "timestamp": "01:56:46", "text": "好險。好險。"}, {"type": "subtitle", "time": 7019.51, "timestamp": "01:56:59", "text": "是的。那樣做。"}]
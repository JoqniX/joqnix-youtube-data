[{"type": "subtitle", "time": 8462.429, "timestamp": "02:21:02", "text": "第五條簡直瘋了。"}, {"type": "subtitle", "time": 8500.349, "timestamp": "02:21:40", "text": "這"}, {"type": "subtitle", "time": 8503.55, "timestamp": "02:21:43", "text": "我們有一面旗幟"}, {"type": "subtitle", "time": 8505.51, "timestamp": "02:21:45", "text": "當我們"}, {"type": "subtitle", "time": 8518.469, "timestamp": "02:21:58", "text": "牙齒"}]
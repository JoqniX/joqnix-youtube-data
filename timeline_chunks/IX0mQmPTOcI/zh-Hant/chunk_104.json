[{"type": "subtitle", "time": 6241.95, "timestamp": "01:44:01", "text": "我們應該。"}, {"type": "subtitle", "time": 6269.109, "timestamp": "01:44:29", "text": "它會在哪裡呢？"}, {"type": "subtitle", "time": 6273.91, "timestamp": "01:44:33", "text": "哦，那裡有什麼？"}, {"type": "subtitle", "time": 6275.27, "timestamp": "01:44:35", "text": "我也這麼認為。"}, {"type": "subtitle", "time": 6277.99, "timestamp": "01:44:37", "text": "哦，上面是什麼？"}, {"type": "subtitle", "time": 6279.55, "timestamp": "01:44:39", "text": "有件事發生了。"}, {"type": "subtitle", "time": 6279.79, "timestamp": "01:44:39", "text": "是的。"}, {"type": "subtitle", "time": 6281.07, "timestamp": "01:44:41", "text": "開始了。"}, {"type": "subtitle", "time": 6292.27, "timestamp": "01:44:52", "text": "什麼？那是什麼？"}, {"type": "subtitle", "time": 6298.149, "timestamp": "01:44:58", "text": "啊，洛普伊。"}, {"type": "subtitle", "time": 6298.87, "timestamp": "01:44:58", "text": "是的。"}, {"type": "subtitle", "time": 6299.51, "timestamp": "01:44:59", "text": "這是一條索道。"}]
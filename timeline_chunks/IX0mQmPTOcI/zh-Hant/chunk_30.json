[{"type": "subtitle", "time": 1800.63, "timestamp": "00:30:00", "text": "牙齒，"}, {"type": "subtitle", "time": 1802.59, "timestamp": "00:30:02", "text": "我是什麼？"}, {"type": "subtitle", "time": 1804.029, "timestamp": "00:30:04", "text": "你想要什麼？"}, {"type": "subtitle", "time": 1808.43, "timestamp": "00:30:08", "text": "是的。"}, {"type": "subtitle", "time": 1814.71, "timestamp": "00:30:14", "text": "白頭白。嘿。"}, {"type": "subtitle", "time": 1815.59, "timestamp": "00:30:15", "text": "是的。和"}, {"type": "subtitle", "time": 1817.269, "timestamp": "00:30:17", "text": "讓你的頭髮變白。"}, {"type": "subtitle", "time": 1822.95, "timestamp": "00:30:22", "text": "[笑聲]"}, {"type": "subtitle", "time": 1832.909, "timestamp": "00:30:32", "text": "粉紅色是"}, {"type": "subtitle", "time": 1837.75, "timestamp": "00:30:37", "text": "一個，"}, {"type": "subtitle", "time": 1840.669, "timestamp": "00:30:40", "text": "身體。這裡。身體。"}, {"type": "subtitle", "time": 1843.23, "timestamp": "00:30:43", "text": "那部分是謊言。"}, {"type": "subtitle", "time": 1847.269, "timestamp": "00:30:47", "text": "是的。這"}, {"type": "subtitle", "time": 1848.509, "timestamp": "00:30:48", "text": "這邊走"}, {"type": "subtitle", "time": 1849.549, "timestamp": "00:30:49", "text": "喲。"}, {"type": "subtitle", "time": 1850.07, "timestamp": "00:30:50", "text": "可口的。"}, {"type": "subtitle", "time": 1857.47, "timestamp": "00:30:57", "text": "對不起。"}]
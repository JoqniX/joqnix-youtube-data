[{"type": "subtitle", "time": 3663.23, "timestamp": "01:01:03", "text": "おおほ。"}, {"type": "subtitle", "time": 3669.67, "timestamp": "01:01:09", "text": "ターここ"}, {"type": "subtitle", "time": 3680.23, "timestamp": "01:01:20", "text": "あ、なるほど。あの奥のは何?"}, {"type": "subtitle", "time": 3680.76, "timestamp": "01:01:20", "text": "奥のは何? あの奥の?"}, {"type": "subtitle", "time": 3682.64, "timestamp": "01:01:22", "text": "あの奥の? あ、本当だ。こ"}, {"type": "subtitle", "time": 3684.0, "timestamp": "01:01:24", "text": "あ、本当だ。こ 見える?なんか青い"}, {"type": "subtitle", "time": 3685.599, "timestamp": "01:01:25", "text": "見える?なんか青い サークル。"}, {"type": "subtitle", "time": 3686.359, "timestamp": "01:01:26", "text": "サークル。 うん。"}, {"type": "subtitle", "time": 3687.72, "timestamp": "01:01:27", "text": "うん。 そうだね。"}, {"type": "subtitle", "time": 3689.24, "timestamp": "01:01:29", "text": "そうだね。 そうだよね。"}, {"type": "subtitle", "time": 3689.76, "timestamp": "01:01:29", "text": "そうだよね。 これも行かなきゃかな。"}, {"type": "subtitle", "time": 3691.92, "timestamp": "01:01:31", "text": "これも行かなきゃかな。 とりあえず近くの行ってみる。"}, {"type": "subtitle", "time": 3694.079, "timestamp": "01:01:34", "text": "とりあえず近くの行ってみる。 Weshouldgo。"}, {"type": "subtitle", "time": 3697.319, "timestamp": "01:01:37", "text": "Weshouldgo。 うん。うん。うん。"}, {"type": "subtitle", "time": 3699.72, "timestamp": "01:01:39", "text": "うん。うん。うん。 Idon'tneedthisoneや。"}, {"type": "subtitle", "time": 3703.52, "timestamp": "01:01:43", "text": "Idon'tneedthisoneや。 うん。うん。うん。"}, {"type": "subtitle", "time": 3705.16, "timestamp": "01:01:45", "text": "うん。うん。うん。 うん。緑に行きます。行こう。"}]
[{"type": "subtitle", "time": 4320.79, "timestamp": "01:12:00", "text": "え、待って。"}, {"type": "subtitle", "time": 4323.669, "timestamp": "01:12:03", "text": "そのタイマーる右側見えるか?"}, {"type": "subtitle", "time": 4328.669, "timestamp": "01:12:08", "text": "かな?"}, {"type": "subtitle", "time": 4328.95, "timestamp": "01:12:08", "text": "見えた?"}, {"type": "subtitle", "time": 4339.27, "timestamp": "01:12:19", "text": "ボールがボールがボールハウ。"}, {"type": "subtitle", "time": 4340.59, "timestamp": "01:12:20", "text": "うん。"}, {"type": "subtitle", "time": 4345.149, "timestamp": "01:12:25", "text": "お、ここにいる。"}, {"type": "subtitle", "time": 4345.95, "timestamp": "01:12:25", "text": "あ、"}, {"type": "subtitle", "time": 4348.229, "timestamp": "01:12:28", "text": "ちょっと待ってね。ジョ"}, {"type": "subtitle", "time": 4361.47, "timestamp": "01:12:41", "text": "おお、ここ。"}, {"type": "subtitle", "time": 4361.709, "timestamp": "01:12:41", "text": "はい。"}, {"type": "subtitle", "time": 4363.65, "timestamp": "01:12:43", "text": "ここや。ここで。ここで渡せばいいか。"}, {"type": "subtitle", "time": 4364.83, "timestamp": "01:12:44", "text": "[笑い]"}, {"type": "subtitle", "time": 4366.83, "timestamp": "01:12:46", "text": "weゲットヒア。"}]
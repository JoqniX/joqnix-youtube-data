[{"type": "subtitle", "time": 5700.109, "timestamp": "01:35:00", "text": "thanカ。コラボキューセンキュー"}, {"type": "subtitle", "time": 5713.43, "timestamp": "01:35:13", "text": "この場所どこだ?"}, {"type": "subtitle", "time": 5715.189, "timestamp": "01:35:15", "text": "どこだ?これ"}, {"type": "subtitle", "time": 5716.709, "timestamp": "01:35:16", "text": "ならもう1回。"}, {"type": "subtitle", "time": 5719.109, "timestamp": "01:35:19", "text": "あ、落ちた。もう"}, {"type": "subtitle", "time": 5719.87, "timestamp": "01:35:19", "text": "1回。"}, {"type": "subtitle", "time": 5721.27, "timestamp": "01:35:21", "text": "はい。"}, {"type": "subtitle", "time": 5723.31, "timestamp": "01:35:23", "text": "こっち行ってみる。"}, {"type": "subtitle", "time": 5725.27, "timestamp": "01:35:25", "text": "えた。"}, {"type": "subtitle", "time": 5733.629, "timestamp": "01:35:33", "text": "今になっ。"}, {"type": "subtitle", "time": 5748.95, "timestamp": "01:35:48", "text": "ああ、黄緑。"}, {"type": "subtitle", "time": 5751.91, "timestamp": "01:35:51", "text": "ラ、ライブ、ライブカラーズワン。"}, {"type": "subtitle", "time": 5753.79, "timestamp": "01:35:53", "text": "これ、これじゃないかな。"}, {"type": "subtitle", "time": 5756.43, "timestamp": "01:35:56", "text": "にいるっていうご愛心。よいしょいしょ。"}]
[{"type": "subtitle", "time": 841.43, "timestamp": "00:14:01", "text": "あ、留学生、日本学校で、あ、留学生だ"}, {"type": "subtitle", "time": 845.59, "timestamp": "00:14:05", "text": "です。今日日本語真面目に勉強してます。"}, {"type": "subtitle", "time": 847.99, "timestamp": "00:14:07", "text": "一緒に頑張りましょう。私は、あ、忘れ"}, {"type": "subtitle", "time": 851.67, "timestamp": "00:14:11", "text": "ちゃった。私はセイサーです。セイサー"}, {"type": "subtitle", "time": 854.23, "timestamp": "00:14:14", "text": "です。はい。"}, {"type": "subtitle", "time": 862.43, "timestamp": "00:14:22", "text": "as"}, {"type": "subtitle", "time": 894.43, "timestamp": "00:14:54", "text": "またやつ。"}, {"type": "subtitle", "time": 896.87, "timestamp": "00:14:56", "text": "あ、コンストレーションだよ。待って、待って。あ、"}, {"type": "subtitle", "time": 898.15, "timestamp": "00:14:58", "text": "Tで"}]
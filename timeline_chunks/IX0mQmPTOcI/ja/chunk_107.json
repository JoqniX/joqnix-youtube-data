[{"type": "subtitle", "time": 6432.99, "timestamp": "01:47:12", "text": "あ、ここだった。待って。"}, {"type": "subtitle", "time": 6439.109, "timestamp": "01:47:19", "text": "どこ?ジョイズウア。ジョクイズアップア。"}, {"type": "subtitle", "time": 6440.07, "timestamp": "01:47:20", "text": "あ、アップ、アップ、アップ。"}, {"type": "subtitle", "time": 6442.35, "timestamp": "01:47:22", "text": "上か?あ、いいや、いいや。あった。"}, {"type": "subtitle", "time": 6443.35, "timestamp": "01:47:23", "text": "行く、行く。上行こ。"}, {"type": "subtitle", "time": 6451.589, "timestamp": "01:47:31", "text": "ライトハウスが"}, {"type": "subtitle", "time": 6458.669, "timestamp": "01:47:38", "text": "はい。"}, {"type": "subtitle", "time": 6459.83, "timestamp": "01:47:39", "text": "あっちか。"}, {"type": "subtitle", "time": 6465.39, "timestamp": "01:47:45", "text": "めっちゃ遠い。"}]
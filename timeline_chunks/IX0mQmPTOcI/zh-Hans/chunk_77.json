[{"type": "subtitle", "time": 4620.03, "timestamp": "01:17:00", "text": "是的，是的，是的。"}, {"type": "subtitle", "time": 4626.99, "timestamp": "01:17:06", "text": "开始了，是的，是的。"}, {"type": "subtitle", "time": 4628.709, "timestamp": "01:17:08", "text": "是的，是的，是的。"}, {"type": "subtitle", "time": 4633.79, "timestamp": "01:17:13", "text": "是的。是的。是的。你把它带到哪里去了？"}, {"type": "subtitle", "time": 4640.87, "timestamp": "01:17:20", "text": "踢它。"}, {"type": "subtitle", "time": 4641.87, "timestamp": "01:17:21", "text": "是的，是的，是的。"}, {"type": "subtitle", "time": 4642.95, "timestamp": "01:17:22", "text": "没关系。"}, {"type": "subtitle", "time": 4650.189, "timestamp": "01:17:30", "text": "没关系，没关系。"}, {"type": "subtitle", "time": 4653.11, "timestamp": "01:17:33", "text": "我懂了。哦是的。已经"}, {"type": "subtitle", "time": 4654.669, "timestamp": "01:17:34", "text": "我只做一次。"}, {"type": "subtitle", "time": 4656.87, "timestamp": "01:17:36", "text": "我们走到这附近的时候把它扔掉好吗？"}, {"type": "subtitle", "time": 4658.629, "timestamp": "01:17:38", "text": "是的。是的。是的。是的。"}, {"type": "subtitle", "time": 4662.709, "timestamp": "01:17:42", "text": "就是这样。"}, {"type": "subtitle", "time": 4663.47, "timestamp": "01:17:43", "text": "是的。"}, {"type": "subtitle", "time": 4665.11, "timestamp": "01:17:45", "text": "我把它扔在这里。"}, {"type": "subtitle", "time": 4667.39, "timestamp": "01:17:47", "text": "是的。"}, {"type": "subtitle", "time": 4675.189, "timestamp": "01:17:55", "text": "我想是阿劳尼亚。哦"}, {"type": "subtitle", "time": 4675.629, "timestamp": "01:17:55", "text": "是的。"}, {"type": "subtitle", "time": 4676.91, "timestamp": "01:17:56", "text": "奥佳岩女士。"}]
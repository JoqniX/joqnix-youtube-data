[{"type": "subtitle", "time": 4143.43, "timestamp": "01:09:03", "text": "那很糟糕。是的。"}, {"type": "subtitle", "time": 4146.309, "timestamp": "01:09:06", "text": "惊喜。"}, {"type": "subtitle", "time": 4154.269, "timestamp": "01:09:14", "text": "Hiro，我来了。"}, {"type": "subtitle", "time": 4154.95, "timestamp": "01:09:14", "text": "嗯？在哪里？在哪里？"}, {"type": "subtitle", "time": 4157.07, "timestamp": "01:09:17", "text": "嘿，他过来了。"}, {"type": "subtitle", "time": 4158.149, "timestamp": "01:09:18", "text": "不挂断。"}, {"type": "subtitle", "time": 4177.349, "timestamp": "01:09:37", "text": "因为我们有两个人。"}, {"type": "subtitle", "time": 4183.51, "timestamp": "01:09:43", "text": "有很多。"}, {"type": "subtitle", "time": 4188.47, "timestamp": "01:09:48", "text": "难道不是吗？"}, {"type": "subtitle", "time": 4191.11, "timestamp": "01:09:51", "text": "哦。"}, {"type": "subtitle", "time": 4196.39, "timestamp": "01:09:56", "text": "图片，"}]
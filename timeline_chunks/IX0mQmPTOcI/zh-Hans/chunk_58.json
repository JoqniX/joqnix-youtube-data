[{"type": "subtitle", "time": 3485.51, "timestamp": "00:58:05", "text": "谢谢。拉紧。"}, {"type": "subtitle", "time": 3487.67, "timestamp": "00:58:07", "text": "是的。伸展运动。"}, {"type": "subtitle", "time": 3489.789, "timestamp": "00:58:09", "text": "拉紧。斯特雷。"}, {"type": "subtitle", "time": 3490.589, "timestamp": "00:58:10", "text": "是的。"}, {"type": "subtitle", "time": 3492.829, "timestamp": "00:58:12", "text": "犹太教仪式。"}, {"type": "subtitle", "time": 3493.63, "timestamp": "00:58:13", "text": "我会给。"}, {"type": "subtitle", "time": 3496.23, "timestamp": "00:58:16", "text": "哦。好的。好的。"}, {"type": "subtitle", "time": 3519.63, "timestamp": "00:58:39", "text": "我想吃点零食。"}, {"type": "subtitle", "time": 3526.109, "timestamp": "00:58:46", "text": "别拿。不。"}, {"type": "subtitle", "time": 3527.51, "timestamp": "00:58:47", "text": "你绝对不能拿。"}, {"type": "subtitle", "time": 3529.349, "timestamp": "00:58:49", "text": "不。是。"}]
[{"type": "subtitle", "time": 6730.51, "timestamp": "01:52:10", "text": "蓝色的那款？"}, {"type": "subtitle", "time": 6731.229, "timestamp": "01:52:11", "text": "嗯？在哪儿？"}, {"type": "subtitle", "time": 6733.149, "timestamp": "01:52:13", "text": "蓝色的那个。"}, {"type": "subtitle", "time": 6735.669, "timestamp": "01:52:15", "text": "是的。蓝色的那个。"}, {"type": "subtitle", "time": 6737.27, "timestamp": "01:52:17", "text": "蓝色在哪里？"}, {"type": "subtitle", "time": 6737.91, "timestamp": "01:52:17", "text": "嗯？在哪儿？"}, {"type": "subtitle", "time": 6745.669, "timestamp": "01:52:25", "text": "一个，"}, {"type": "subtitle", "time": 6748.31, "timestamp": "01:52:28", "text": "我回到了我那间浅绿色的房子。"}, {"type": "subtitle", "time": 6750.43, "timestamp": "01:52:30", "text": "等等，等等。已经"}, {"type": "subtitle", "time": 6754.069, "timestamp": "01:52:34", "text": "一次，再一次。在这座灯塔里，"}, {"type": "subtitle", "time": 6762.629, "timestamp": "01:52:42", "text": "我们与"}, {"type": "subtitle", "time": 6765.03, "timestamp": "01:52:45", "text": "每一个"}, {"type": "subtitle", "time": 6766.79, "timestamp": "01:52:46", "text": "这是便便吗？"}, {"type": "subtitle", "time": 6769.47, "timestamp": "01:52:49", "text": "他没有跳下去。"}, {"type": "subtitle", "time": 6772.35, "timestamp": "01:52:52", "text": "这个"}, {"type": "subtitle", "time": 6777.27, "timestamp": "01:52:57", "text": "我动不了"}, {"type": "subtitle", "time": 6779.189, "timestamp": "01:52:59", "text": "没关系，阿由"}]
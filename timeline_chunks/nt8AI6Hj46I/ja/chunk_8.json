[{"type": "subtitle", "time": 481.438, "timestamp": "00:08:01", "text": "コラボレーションはいつになるか分からなかったので"}, {"type": "subtitle", "time": 483.496, "timestamp": "00:08:03", "text": "それは花火会、"}, {"type": "subtitle", "time": 488.081, "timestamp": "00:08:08", "text": "花火。それは、それは8番目です"}, {"type": "subtitle", "time": 492.146, "timestamp": "00:08:12", "text": "8月。今回は6時頃になるだろう"}, {"type": "subtitle", "time": 494.662, "timestamp": "00:08:14", "text": "時間ですよね？この頃、"}, {"type": "subtitle", "time": 496.55, "timestamp": "00:08:16", "text": "展開の様子をお見せします"}, {"type": "subtitle", "time": 499.637, "timestamp": "00:08:19", "text": "8月8日に花火大会があります。それ"}, {"type": "subtitle", "time": 503.124, "timestamp": "00:08:23", "text": "今日は土曜日です。はい、8月8日です。"}, {"type": "subtitle", "time": 506.625, "timestamp": "00:08:26", "text": "土曜日。その時私の"}, {"type": "subtitle", "time": 508.387, "timestamp": "00:08:28", "text": "1週間の夏休み。"}, {"type": "subtitle", "time": 512.718, "timestamp": "00:08:32", "text": "たった1週間。だから私はこう思う"}, {"type": "subtitle", "time": 516.372, "timestamp": "00:08:36", "text": "それをVlogに記録する。私は"}, {"type": "subtitle", "time": 519.268, "timestamp": "00:08:39", "text": "それをこのようにVlogに記録する。このような。"}, {"type": "subtitle", "time": 525.919, "timestamp": "00:08:45", "text": "とても良い。私はこのように録音し、"}, {"type": "subtitle", "time": 527.695, "timestamp": "00:08:47", "text": "あなたと話すことで、"}, {"type": "subtitle", "time": 533.733, "timestamp": "00:08:53", "text": "それを見て、すべてを把握する。クリア。見せる。これは"}, {"type": "subtitle", "time": 535.797, "timestamp": "00:08:55", "text": "とても素敵です。私はただ歩いていて"}]
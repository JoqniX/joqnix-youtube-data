[{"type": "subtitle", "time": 3122.792, "timestamp": "00:52:02", "text": "分かりやすく説明してくれましたね。はい、ほとんどの 人々は単に自分の世話をする"}, {"type": "subtitle", "time": 3124.488, "timestamp": "00:52:04", "text": "人々は単に自分の世話をする 自分のビジネスとか、そういうこと全部。それが日本だ。"}, {"type": "subtitle", "time": 3129.652, "timestamp": "00:52:09", "text": "人は他人のことに首を突っ込まない。"}, {"type": "subtitle", "time": 3138.313, "timestamp": "00:52:18", "text": "はい。頼まない限り、頼まない限り"}, {"type": "subtitle", "time": 3141.094, "timestamp": "00:52:21", "text": "援助。だから、だから、だから"}, {"type": "subtitle", "time": 3145.391, "timestamp": "00:52:25", "text": "一方、もし私が"}, {"type": "subtitle", "time": 3147.304, "timestamp": "00:52:27", "text": "私は彼に何気なく尋ねた"}, {"type": "subtitle", "time": 3149.856, "timestamp": "00:52:29", "text": "方向とか全部、そう、それらは"}, {"type": "subtitle", "time": 3151.897, "timestamp": "00:52:31", "text": "彼らの持ち物と、私が彼らに助けを求め、そして"}, {"type": "subtitle", "time": 3157.575, "timestamp": "00:52:37", "text": "彼らは助けてくれるだろう。そういうこともある。はい。しかし、もう1つ"}, {"type": "subtitle", "time": 3159.666, "timestamp": "00:52:39", "text": "例えば、私はキャンパスについて話しました"}, {"type": "subtitle", "time": 3164.124, "timestamp": "00:52:44", "text": "開いてるよね？私はその学校に通っていました"}, {"type": "subtitle", "time": 3169.099, "timestamp": "00:52:49", "text": "オープンキャンパスの場合は15回。それぞれ"}, {"type": "subtitle", "time": 3171.493, "timestamp": "00:52:51", "text": "お金に余裕があるときはいつでも、私は旅行に出かけます"}, {"type": "subtitle", "time": 3173.827, "timestamp": "00:52:53", "text": "東京がキャンパスイベントに参加"}, {"type": "subtitle", "time": 3176.161, "timestamp": "00:52:56", "text": "音楽が好きだからオープン"}]
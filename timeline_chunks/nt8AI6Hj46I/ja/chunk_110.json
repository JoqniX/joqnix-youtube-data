[{"type": "subtitle", "time": 6600.161, "timestamp": "01:50:00", "text": "全て。はい、本当にたくさんのことがあります。おお。しかし"}, {"type": "subtitle", "time": 6602.724, "timestamp": "01:50:02", "text": "はい、もしあなたがまだここにいるなら、今日手紙を書きます。"}, {"type": "subtitle", "time": 6605.095, "timestamp": "01:50:05", "text": "申請書のメモでさえ、"}, {"type": "subtitle", "time": 6607.337, "timestamp": "01:50:07", "text": "問題やその他すべて、メモ"}, {"type": "subtitle", "time": 6609.9, "timestamp": "01:50:09", "text": "コメントがあれば、事前に送ります"}, {"type": "subtitle", "time": 6614.529, "timestamp": "01:50:14", "text": "それは忘れてしまった。少し忘れていました"}, {"type": "subtitle", "time": 6616.359, "timestamp": "01:50:16", "text": "昨日のメモで触れたかったことです"}, {"type": "subtitle", "time": 6617.9, "timestamp": "01:50:17", "text": "私の最新のコメント"}, {"type": "subtitle", "time": 6623.688, "timestamp": "01:50:23", "text": "伝染 ; 感染。ああ、最後のやつね"}, {"type": "subtitle", "time": 6625.879, "timestamp": "01:50:25", "text": "大きな通信障害が発生しました"}, {"type": "subtitle", "time": 6628.574, "timestamp": "01:50:28", "text": "接続が切れたからですよね？そうしなければならなかった"}, {"type": "subtitle", "time": 6630.366, "timestamp": "01:50:30", "text": "毎回再接続してください"}, {"type": "subtitle", "time": 6633.662, "timestamp": "01:50:33", "text": "インターネットの接続が悪かった。信号が送信されていませんでした"}, {"type": "subtitle", "time": 6636.199, "timestamp": "01:50:36", "text": "YouTube、Twitch、Kickなどといったプラットフォームへ。"}, {"type": "subtitle", "time": 6641.392, "timestamp": "01:50:41", "text": "ええ、まあ、それだけだと思います。それ以外にも すべて順調です。わかった。よし、行こう"}]
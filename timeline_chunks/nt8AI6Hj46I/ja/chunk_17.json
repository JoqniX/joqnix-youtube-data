[{"type": "subtitle", "time": 1022.879, "timestamp": "00:17:02", "text": "まるでそれが何であるかを説明しなければならないかのように"}, {"type": "subtitle", "time": 1030.319, "timestamp": "00:17:10", "text": "どちらかというと、別に気にしてない、という感じですね。"}, {"type": "subtitle", "time": 1032.784, "timestamp": "00:17:12", "text": "趣味をやりたいという気持ちみたいに"}, {"type": "subtitle", "time": 1034.87, "timestamp": "00:17:14", "text": "必死に"}, {"type": "subtitle", "time": 1037.335, "timestamp": "00:17:17", "text": "責任を果たす"}, {"type": "subtitle", "time": 1039.801, "timestamp": "00:17:19", "text": "仕事、学校など。家に帰って、"}, {"type": "subtitle", "time": 1042.266, "timestamp": "00:17:22", "text": "趣味をしたいけれど、"}, {"type": "subtitle", "time": 1044.605, "timestamp": "00:17:24", "text": "対処すべき責任が増え、"}, {"type": "subtitle", "time": 1052.352, "timestamp": "00:17:32", "text": "そしてあなたは「ああ、もう12時だ」と言う。"}, {"type": "subtitle", "time": 1057.94, "timestamp": "00:17:37", "text": "午前。本当に時間がない"}, {"type": "subtitle", "time": 1059.837, "timestamp": "00:17:39", "text": "夢を犠牲にして、"}, {"type": "subtitle", "time": 1064.094, "timestamp": "00:17:44", "text": "1時間の暇つぶし。しかし時間"}, {"type": "subtitle", "time": 1067.626, "timestamp": "00:17:47", "text": "彼は何事もなかったかのように飛ぶ。時が経つのは早い"}, {"type": "subtitle", "time": 1071.524, "timestamp": "00:17:51", "text": "過度に。そして、なぜなのかと疑問に思う。"}, {"type": "subtitle", "time": 1073.49, "timestamp": "00:17:53", "text": "時間が経つのが遅く感じるのは、"}, {"type": "subtitle", "time": 1077.378, "timestamp": "00:17:57", "text": "学校か職場か？なぜ？"}, {"type": "subtitle", "time": 1079.412, "timestamp": "00:17:59", "text": "物事の中では時間がとてもゆっくりと流れるので"}]
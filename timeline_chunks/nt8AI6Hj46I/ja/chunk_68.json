[{"type": "subtitle", "time": 4082.292, "timestamp": "01:08:02", "text": "まるでそうすべきであるかのように、まるでそうしたいかのように考えている"}, {"type": "subtitle", "time": 4084.848, "timestamp": "01:08:04", "text": "ネイティブの日本人、地元の人と話す、"}, {"type": "subtitle", "time": 4087.207, "timestamp": "01:08:07", "text": "同じことじゃないよ、超"}, {"type": "subtitle", "time": 4093.728, "timestamp": "01:08:13", "text": "正直。大丈夫。問題は、もし"}, {"type": "subtitle", "time": 4096.009, "timestamp": "01:08:16", "text": "私は女の子や女性に近づき、"}, {"type": "subtitle", "time": 4098.349, "timestamp": "01:08:18", "text": "彼らは街中でそんなことを考えるかもしれない。"}, {"type": "subtitle", "time": 4100.33, "timestamp": "01:08:20", "text": "私が悪意を持って近づいている"}, {"type": "subtitle", "time": 4104.631, "timestamp": "01:08:24", "text": "意図とか、そんな感じのこと。いいえ、私は自分自身を見ています"}, {"type": "subtitle", "time": 4107.919, "timestamp": "01:08:27", "text": "まるで子供のように。私は若く見えるので"}, {"type": "subtitle", "time": 4111.831, "timestamp": "01:08:31", "text": "大丈夫。私の年齢は、くそっ、"}, {"type": "subtitle", "time": 4117.347, "timestamp": "01:08:37", "text": "ああ、なんてことだ。悲しい。ええ、ええ、まさにそれです"}, {"type": "subtitle", "time": 4122.194, "timestamp": "01:08:42", "text": "それもまた存在する。あなたが望むように"}, {"type": "subtitle", "time": 4124.275, "timestamp": "01:08:44", "text": "良い会話を始めるが、"}, {"type": "subtitle", "time": 4126.191, "timestamp": "01:08:46", "text": "誤解されたり、意図が誤って解釈されたりする可能性があります。"}, {"type": "subtitle", "time": 4129.609, "timestamp": "01:08:49", "text": "別の見方をする。それは確かに意義のあることだ。"}]
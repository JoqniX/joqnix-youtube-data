[{"type": "subtitle", "time": 2281.957, "timestamp": "00:38:01", "text": "今のところはあまりない。良い。あの、何かありますか…？ それはぬいぐるみですか、それとも誰かの頭ですか？"}, {"type": "subtitle", "time": 2288.316, "timestamp": "00:38:08", "text": "それが誰かの頭なのか、それとも"}, {"type": "subtitle", "time": 2295.201, "timestamp": "00:38:15", "text": "テディベア。良い。あれが見えますか？あれが見えますか？ あれが見えますか？あれは誰かの頭ですか？または"}, {"type": "subtitle", "time": 2298.477, "timestamp": "00:38:18", "text": "あれが見えますか？あれは誰かの頭ですか？または それはぬいぐるみですか？一体どういうことだ？何"}, {"type": "subtitle", "time": 2301.548, "timestamp": "00:38:21", "text": "それはぬいぐるみですか？一体どういうことだ？何 あれは何だ？"}, {"type": "subtitle", "time": 2310.962, "timestamp": "00:38:30", "text": "あれは何だ？なんてこった"}, {"type": "subtitle", "time": 2314.452, "timestamp": "00:38:34", "text": "それだけですか？そしてその光は"}, {"type": "subtitle", "time": 2318.128, "timestamp": "00:38:38", "text": "恐ろしい狂気。誰が1つ置くのか"}, {"type": "subtitle", "time": 2320.266, "timestamp": "00:38:40", "text": "青い光の中で、まるで"}, {"type": "subtitle", "time": 2322.656, "timestamp": "00:38:42", "text": "精神病院、そう、まるで"}, {"type": "subtitle", "time": 2324.857, "timestamp": "00:38:44", "text": "バイオハザードとか、そういうゲームをプレイしたことがあるよね。"}, {"type": "subtitle", "time": 2327.372, "timestamp": "00:38:47", "text": "病院の照明が青い場所"}, {"type": "subtitle", "time": 2331.051, "timestamp": "00:38:51", "text": "そして、それは？それは何ですか？それは何ですか？"}, {"type": "subtitle", "time": 2335.074, "timestamp": "00:38:55", "text": "それは何だ、兄弟？それは何ですか？ああ、神様"}, {"type": "subtitle", "time": 2337.896, "timestamp": "00:38:57", "text": "私の。確かに怖いですね。そして夜になり、"}]
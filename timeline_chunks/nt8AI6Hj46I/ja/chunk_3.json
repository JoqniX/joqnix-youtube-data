[{"type": "subtitle", "time": 182.001, "timestamp": "00:03:02", "text": "私がそう望めばね、ダーリン。もし ええと、そうしたいのですが、大丈夫です。"}, {"type": "subtitle", "time": 204.223, "timestamp": "00:03:24", "text": "そう、私はただ"}, {"type": "subtitle", "time": 206.391, "timestamp": "00:03:26", "text": "直接的に言うと、俺にはできないんだよ。"}, {"type": "subtitle", "time": 209.706, "timestamp": "00:03:29", "text": "本当に本当に欲しい"}, {"type": "subtitle", "time": 216.744, "timestamp": "00:03:36", "text": "PCで配信者として毎日、"}, {"type": "subtitle", "time": 219.165, "timestamp": "00:03:39", "text": "配信したい、プレイしたい"}, {"type": "subtitle", "time": 226.084, "timestamp": "00:03:46", "text": "音楽など、挙げればきりがない。しかしそうではない"}, {"type": "subtitle", "time": 236.36599999999999, "timestamp": "00:03:56", "text": "私はそれを行うことができます。 「よし、出かけよう」と思った。"}]
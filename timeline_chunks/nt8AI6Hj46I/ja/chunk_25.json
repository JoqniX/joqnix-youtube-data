[{"type": "subtitle", "time": 1502.186, "timestamp": "00:25:02", "text": "車。彼は…知っている…つまり、そうだ、"}, {"type": "subtitle", "time": 1504.831, "timestamp": "00:25:04", "text": "彼らは小さな子供なので、はい、"}, {"type": "subtitle", "time": 1507.343, "timestamp": "00:25:07", "text": "もちろん、彼らは監視しなければならない...そう、"}, {"type": "subtitle", "time": 1511.749, "timestamp": "00:25:11", "text": "彼らの子供たち。はい、それです..."}, {"type": "subtitle", "time": 1518.034, "timestamp": "00:25:18", "text": "どこかで。わかりました。しかし、なぜ"}, {"type": "subtitle", "time": 1522.245, "timestamp": "00:25:22", "text": "何時まで？え、何？のように"}, {"type": "subtitle", "time": 1524.677, "timestamp": "00:25:24", "text": "プライマリ、セカンダリ、いいえ、"}, {"type": "subtitle", "time": 1527.457, "timestamp": "00:25:27", "text": "中学生、小学生、子供たち 彼らはそんな状態で家に帰るべきではない"}, {"type": "subtitle", "time": 1530.237, "timestamp": "00:25:30", "text": "彼らはそんな状態で家に帰るべきではない 午後7時30分おい？前回"}, {"type": "subtitle", "time": 1536.639, "timestamp": "00:25:36", "text": "午後7時30分おい？前回 私の知る限りでは、学校はだいたい"}, {"type": "subtitle", "time": 1539.42, "timestamp": "00:25:39", "text": "私の知る限りでは、学校はだいたい 午後3時か4時頃ですよね？たぶん10時頃。"}, {"type": "subtitle", "time": 1542.252, "timestamp": "00:25:42", "text": "午後3時か4時頃ですよね？たぶん10時頃。 知るか？または追加のクラブまたは"}, {"type": "subtitle", "time": 1545.969, "timestamp": "00:25:45", "text": "知るか？または追加のクラブまたは そんな感じ。しかしそれは"}, {"type": "subtitle", "time": 1548.21, "timestamp": "00:25:48", "text": "そんな感じ。しかしそれは 中学校以降。はい。それは正しい。"}, {"type": "subtitle", "time": 1550.949, "timestamp": "00:25:50", "text": "中学校以降。はい。それは正しい。 こんにちは、ソーラー。いらっしゃいませ。はい、そうです。"}, {"type": "subtitle", "time": 1555.44, "timestamp": "00:25:55", "text": "こんにちは、ソーラー。いらっしゃいませ。はい、そうです。 高校時代からだよね？神"}, {"type": "subtitle", "time": 1558.18, "timestamp": "00:25:58", "text": "高校時代からだよね？神 彼は知っているだろう。はい、"}]
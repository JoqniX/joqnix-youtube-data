[{"type": "subtitle", "time": 6544.23, "timestamp": "01:49:04", "text": "彼らは本当に素晴らしい。はい。調子はどう？"}, {"type": "subtitle", "time": 6546.989, "timestamp": "01:49:06", "text": "ハイキング？ええ、順調です。私たちはたくさん話しました 。家に帰るんだけど、遅刻しそうだ。私の"}, {"type": "subtitle", "time": 6552.474, "timestamp": "01:49:12", "text": "。家に帰るんだけど、遅刻しそうだ。私の ルームメイトに叱られそうだ。"}, {"type": "subtitle", "time": 6558.442, "timestamp": "01:49:18", "text": "彼は私に8時に戻ってくるように言ったので、私は"}, {"type": "subtitle", "time": 6562.122, "timestamp": "01:49:22", "text": "9時に戻ります。なので、1時間だけ出かけます。"}, {"type": "subtitle", "time": 6564.405, "timestamp": "01:49:24", "text": "遅くなったけど、大丈夫だよ。後で取り掛かります"}, {"type": "subtitle", "time": 6568.786, "timestamp": "01:49:28", "text": "私自身がクラスと一緒に過ごす日"}, {"type": "subtitle", "time": 6575.189, "timestamp": "01:49:35", "text": "私が見逃した部分。だから私はただ行くだけです"}, {"type": "subtitle", "time": 6577.507, "timestamp": "01:49:37", "text": "歩いて家に帰り、夕食などを済ませて、"}, {"type": "subtitle", "time": 6579.886, "timestamp": "01:49:39", "text": "追いついた後に寝る"}, {"type": "subtitle", "time": 6587.184, "timestamp": "01:49:47", "text": "授業とか、その他諸々。はい、そうです。"}]
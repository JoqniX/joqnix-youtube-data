[{"type": "subtitle", "time": 6904.805, "timestamp": "01:55:04", "text": "Solarさん、来てくれてありがとう。ハマリサン、"}, {"type": "subtitle", "time": 6908.872, "timestamp": "01:55:08", "text": "お越しいただきありがとうございます。こんにちは、以上です。"}, {"type": "subtitle", "time": 6913.624, "timestamp": "01:55:13", "text": "本日お越しいただいた皆様、ありがとうございました。"}, {"type": "subtitle", "time": 6918.311, "timestamp": "01:55:18", "text": "私の送信。それはとても意味があります、"}, {"type": "subtitle", "time": 6937.641, "timestamp": "01:55:37", "text": "真実。ボイスチャットに戻ります"}, {"type": "subtitle", "time": 6942.431, "timestamp": "01:55:42", "text": "その後。大丈夫。できる"}, {"type": "subtitle", "time": 6953.918, "timestamp": "01:55:53", "text": "しばらくの間、それを続けてください。ありがとうございました。"}]
[{"type": "subtitle", "time": 6268.274, "timestamp": "01:44:28", "text": "一体どういうことだ？待って、オーって何？"}, {"type": "subtitle", "time": 6275.876, "timestamp": "01:44:35", "text": "私はそうやってやるんです。待って、人がいる"}, {"type": "subtitle", "time": 6278.734, "timestamp": "01:44:38", "text": "ランブルで私を見る。私は知らなかった、"}, {"type": "subtitle", "time": 6295.86, "timestamp": "01:44:55", "text": "兄弟。それ？ちょっと待って。"}, {"type": "subtitle", "time": 6297.764, "timestamp": "01:44:57", "text": "私を監視している人がいるなんて知らなかった"}]
[{"type": "subtitle", "time": 1980.201, "timestamp": "00:33:00", "text": "11人だ。待って、私はここにいる、 兄弟。さっき、私はどれくらい歩いたんだろう？"}, {"type": "subtitle", "time": 1985.72, "timestamp": "00:33:05", "text": "何キロですか"}, {"type": "subtitle", "time": 1994.341, "timestamp": "00:33:14", "text": "私は今、歩いたのだろうか？おお。私にさせて"}, {"type": "subtitle", "time": 2011.621, "timestamp": "00:33:31", "text": "変化。おお。でも、"}, {"type": "subtitle", "time": 2014.292, "timestamp": "00:33:34", "text": "時々そういう歩き方をするなら、考えなければならない"}, {"type": "subtitle", "time": 2016.564, "timestamp": "00:33:36", "text": "はい、一昨日私は"}, {"type": "subtitle", "time": 2019.932, "timestamp": "00:33:39", "text": "東京の新宿。私は"}, {"type": "subtitle", "time": 2023.501, "timestamp": "00:33:43", "text": "クレイジー。私は歩き、歩き、歩き、そして"}, {"type": "subtitle", "time": 2030.085, "timestamp": "00:33:50", "text": "私は歩いた。はい。しかし、それだけではない。"}, {"type": "subtitle", "time": 2031.889, "timestamp": "00:33:51", "text": "立っていると足が痛む。"}, {"type": "subtitle", "time": 2036.464, "timestamp": "00:33:56", "text": "それが私が気づいたことです。として"}, {"type": "subtitle", "time": 2038.51, "timestamp": "00:33:58", "text": "じっとしていて仕事をしているときは、"}]
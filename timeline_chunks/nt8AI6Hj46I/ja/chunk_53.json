[{"type": "subtitle", "time": 3184.833, "timestamp": "00:53:04", "text": "食事とか、そういうことだよね？だから、それぞれ"}, {"type": "subtitle", "time": 3186.938, "timestamp": "00:53:06", "text": "私がそのコーヒーショップに行くたびに、"}, {"type": "subtitle", "time": 3188.868, "timestamp": "00:53:08", "text": "待合エリアにはたくさんの人がいます"}, {"type": "subtitle", "time": 3190.914, "timestamp": "00:53:10", "text": "日本人学生全員"}, {"type": "subtitle", "time": 3193.078, "timestamp": "00:53:13", "text": "席は空いていて、私のテーブルだけが空いています。"}, {"type": "subtitle", "time": 3198.903, "timestamp": "00:53:18", "text": "誰も私の隣に座りたがらないのは、"}, {"type": "subtitle", "time": 3204.275, "timestamp": "00:53:24", "text": "いわば、そういうことだ。誰も話したがらない"}, {"type": "subtitle", "time": 3206.671, "timestamp": "00:53:26", "text": "私と一緒に、メンバーでさえ"}, {"type": "subtitle", "time": 3208.941, "timestamp": "00:53:28", "text": "個人的なこと、ただし、それがあなたの"}, {"type": "subtitle", "time": 3211.274, "timestamp": "00:53:31", "text": "必ず記入してください"}, {"type": "subtitle", "time": 3213.797, "timestamp": "00:53:33", "text": "すべての書類とその他すべて。"}, {"type": "subtitle", "time": 3221.661, "timestamp": "00:53:41", "text": "そういう場合に限って彼らはやって来て、まあ、"}, {"type": "subtitle", "time": 3223.788, "timestamp": "00:53:43", "text": "彼らは私に話しかけてくる、あるいはもしかしたら"}, {"type": "subtitle", "time": 3226.367, "timestamp": "00:53:46", "text": "好奇心旺盛なスタッフ"}, {"type": "subtitle", "time": 3228.494, "timestamp": "00:53:48", "text": "外国人と話すと"}, {"type": "subtitle", "time": 3231.009, "timestamp": "00:53:51", "text": "私の調子はどうですか、または"}, {"type": "subtitle", "time": 3237.741, "timestamp": "00:53:57", "text": "インドとか、そういう類のことだ。そして学生もいます、"}, {"type": "subtitle", "time": 3239.443, "timestamp": "00:53:59", "text": "日本人学生、または"}]
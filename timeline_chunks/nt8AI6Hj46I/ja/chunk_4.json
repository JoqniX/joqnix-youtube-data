[{"type": "subtitle", "time": 250.622, "timestamp": "00:04:10", "text": "それが私たちがここにいる理由です。始めたばかりです"}, {"type": "subtitle", "time": 261.395, "timestamp": "00:04:21", "text": "歩き続けて、私はどこにいるのだろう？ これが見えますか？こんにちは。こんにちは。"}, {"type": "subtitle", "time": 278.305, "timestamp": "00:04:38", "text": "おやすみ。元気ですか？私は"}, {"type": "subtitle", "time": 282.839, "timestamp": "00:04:42", "text": "良い。元気です。えっと、私は"}, {"type": "subtitle", "time": 285.177, "timestamp": "00:04:45", "text": "デスクトップに直接表示されるので、"}, {"type": "subtitle", "time": 288.728, "timestamp": "00:04:48", "text": "外。ストリーム配信をしようと思ったのですが"}, {"type": "subtitle", "time": 294.606, "timestamp": "00:04:54", "text": "屋外。あなたはそれを証明した。そこで彼を見かけた"}, {"type": "subtitle", "time": 298.016, "timestamp": "00:04:58", "text": "下に。今、それを見せたところです。私はそれを見た"}]
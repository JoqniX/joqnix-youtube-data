[{"type": "subtitle", "time": 1681.561, "timestamp": "00:28:01", "text": "近隣地域、家々、通りを探索する"}, {"type": "subtitle", "time": 1685.932, "timestamp": "00:28:05", "text": "そして、独り言を言っていた。どのような"}, {"type": "subtitle", "time": 1692.335, "timestamp": "00:28:12", "text": "あることに気づいた。大丈夫。多くの家"}, {"type": "subtitle", "time": 1694.397, "timestamp": "00:28:14", "text": "日本人はとても静かだ。"}, {"type": "subtitle", "time": 1696.696, "timestamp": "00:28:16", "text": "午後7時開始まるで彼らの"}, {"type": "subtitle", "time": 1703.901, "timestamp": "00:28:23", "text": "家々には明かりがなかった。みんな"}, {"type": "subtitle", "time": 1706.044, "timestamp": "00:28:26", "text": "寝ているのか、それとも誰もいないのか"}, {"type": "subtitle", "time": 1711.431, "timestamp": "00:28:31", "text": "なぜ家はこんなに静かで"}, {"type": "subtitle", "time": 1713.734, "timestamp": "00:28:33", "text": "えっと、つまり…？"}, {"type": "subtitle", "time": 1723.174, "timestamp": "00:28:43", "text": "これらはいくつかの家です。照明なし。それなし"}, {"type": "subtitle", "time": 1726.358, "timestamp": "00:28:46", "text": "ライト。アパートには照明がある"}, {"type": "subtitle", "time": 1728.22, "timestamp": "00:28:48", "text": "なぜなら、それらには外灯が付いているからです。"}, {"type": "subtitle", "time": 1735.245, "timestamp": "00:28:55", "text": "はい。でも、私は本当に大変な状況に置かれているんです。"}, {"type": "subtitle", "time": 1737.801, "timestamp": "00:28:57", "text": "家。あそこの家は"}, {"type": "subtitle", "time": 1739.568, "timestamp": "00:28:59", "text": "完全に。ライトは"}]
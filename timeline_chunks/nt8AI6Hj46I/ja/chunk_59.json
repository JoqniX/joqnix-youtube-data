[{"type": "subtitle", "time": 3549.547, "timestamp": "00:59:09", "text": "このような場所では、2番目に。"}, {"type": "subtitle", "time": 3570.804, "timestamp": "00:59:30", "text": "一体どういうことだ。えっと、30分ください。"}, {"type": "subtitle", "time": 3577.258, "timestamp": "00:59:37", "text": "よし、そろそろ終わりにしよう。"}, {"type": "subtitle", "time": 3579.781, "timestamp": "00:59:39", "text": "追いつかなければならない"}, {"type": "subtitle", "time": 3582.773, "timestamp": "00:59:42", "text": "私の授業は、オンライン授業です。私の"}, {"type": "subtitle", "time": 3584.809, "timestamp": "00:59:44", "text": "ルームメイトが私に送ってきた"}, {"type": "subtitle", "time": 3586.689, "timestamp": "00:59:46", "text": "メッセージだったけど、今あなたが来るんだね。"}, {"type": "subtitle", "time": 3588.49, "timestamp": "00:59:48", "text": "追いつく必要がある"}, {"type": "subtitle", "time": 3590.63, "timestamp": "00:59:50", "text": "クラス。だから私は彼女に言った、あなたはそれらを見ることができる"}, {"type": "subtitle", "time": 3593.477, "timestamp": "00:59:53", "text": "初め。追いつきます。ああ、"}, {"type": "subtitle", "time": 3595.784, "timestamp": "00:59:55", "text": "はい、本題に戻りましょう。それで"}, {"type": "subtitle", "time": 3597.574, "timestamp": "00:59:57", "text": "はい、それが答えです"}]
[{"type": "subtitle", "time": 1625.429, "timestamp": "00:27:05", "text": "素晴らしい、他に類を見ないボットだ。しかし"}, {"type": "subtitle", "time": 1627.542, "timestamp": "00:27:07", "text": "多くの人がそれを使用しているので、はい、"}, {"type": "subtitle", "time": 1632.827, "timestamp": "00:27:12", "text": "機能やその他すべてが遅延するだろう。"}, {"type": "subtitle", "time": 1636.392, "timestamp": "00:27:16", "text": "時間はかかるだろうが、最善の結果を期待しよう。は"}, {"type": "subtitle", "time": 1639.09, "timestamp": "00:27:19", "text": "数ある良質なものの1つだ。私は願っています"}, {"type": "subtitle", "time": 1642.163, "timestamp": "00:27:22", "text": "台無しにしないで。よし、行こう。"}, {"type": "subtitle", "time": 1646.277, "timestamp": "00:27:26", "text": "この公園から離れよう。待って、  出口はどこですか？ああ、一つしかない"}, {"type": "subtitle", "time": 1650.06, "timestamp": "00:27:30", "text": "出口はどこですか？ああ、一つしかない 出口。ああ、あった。出口。"}, {"type": "subtitle", "time": 1655.236, "timestamp": "00:27:35", "text": "出口。ああ、あった。出口。 大丈夫。私はただ歩いているだけです。"}, {"type": "subtitle", "time": 1669.695, "timestamp": "00:27:49", "text": "自分がどこにいるのかさえ分からない。言う、"}, {"type": "subtitle", "time": 1672.874, "timestamp": "00:27:52", "text": "大まかな見当はついています。ああ、私は"}, {"type": "subtitle", "time": 1679.031, "timestamp": "00:27:59", "text": "ここ。良い。ただ歩き回っているだけです"}]
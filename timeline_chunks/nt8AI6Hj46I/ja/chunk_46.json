[{"type": "subtitle", "time": 2762.873, "timestamp": "00:46:02", "text": "終わったら、帰るときに、いろいろ言うんだ とても丁寧に頭を下げて、"}, {"type": "subtitle", "time": 2765.103, "timestamp": "00:46:05", "text": "とても丁寧に頭を下げて、 それは何という名前ですか？少し身を乗り出す"}, {"type": "subtitle", "time": 2768.438, "timestamp": "00:46:08", "text": "それは何という名前ですか？少し身を乗り出す ええと、40度の角度、または25度、"}, {"type": "subtitle", "time": 2772.999, "timestamp": "00:46:12", "text": "ええと、40度の角度、または25度、 あなたならできますよ。ええ、そうですね。"}, {"type": "subtitle", "time": 2776.144, "timestamp": "00:46:16", "text": "あなたならできますよ。ええ、そうですね。 それもすべて、敬意を払った態度で。"}, {"type": "subtitle", "time": 2783.359, "timestamp": "00:46:23", "text": "しかし、時々私は"}, {"type": "subtitle", "time": 2789.065, "timestamp": "00:46:29", "text": "彼らは私の存在には気づかないが、他の人には反応する。"}, {"type": "subtitle", "time": 2793.861, "timestamp": "00:46:33", "text": "はい、そうです。あの老人は話す"}, {"type": "subtitle", "time": 2797.009, "timestamp": "00:46:37", "text": "他の人々、他の人々、ええと、人々"}, {"type": "subtitle", "time": 2799.901, "timestamp": "00:46:39", "text": "年配で、話し方もとても上手です。"}, {"type": "subtitle", "time": 2803.586, "timestamp": "00:46:43", "text": "その他諸々。そして私と一緒なら、"}, {"type": "subtitle", "time": 2811.647, "timestamp": "00:46:51", "text": "えっと、なんで私なの？そしてどちらも"}, {"type": "subtitle", "time": 2813.953, "timestamp": "00:46:53", "text": "彼は私がトイレを使ったことさえ気に入らなかった"}, {"type": "subtitle", "time": 2816.197, "timestamp": "00:46:56", "text": "時間がすでに過ぎていたとき"}, {"type": "subtitle", "time": 2818.321, "timestamp": "00:46:58", "text": "休憩を取って、約3分後に到着しました。"}]
[{"type": "subtitle", "time": 1445.633, "timestamp": "00:24:05", "text": "待って。では、１、２、３。全て"}, {"type": "subtitle", "time": 1447.594, "timestamp": "00:24:07", "text": "私の目の前にあるこの３台の車は３台です"}, {"type": "subtitle", "time": 1449.606, "timestamp": "00:24:09", "text": "妊娠していた異なる両親"}, {"type": "subtitle", "time": 1454.409, "timestamp": "00:24:14", "text": "そうすれば子供たちは家に帰れるだろう。それ"}, {"type": "subtitle", "time": 1457.926, "timestamp": "00:24:17", "text": "興味深いですね。あなたにお見せしました... ...私はあなたにその車を見せることができましたが"}, {"type": "subtitle", "time": 1460.335, "timestamp": "00:24:20", "text": "...私はあなたにその車を見せることができましたが 彼は去って行った。お見せすることもできたのに。それ"}, {"type": "subtitle", "time": 1464.946, "timestamp": "00:24:24", "text": "彼は去って行った。お見せすることもできたのに。それ とても興味深いですね。そこに車があります。"}, {"type": "subtitle", "time": 1473.523, "timestamp": "00:24:33", "text": "おお。それは面白い。おお。彼の"}, {"type": "subtitle", "time": 1478.132, "timestamp": "00:24:38", "text": "家族はただ彼らを待っているだけだ。そして彼の"}, {"type": "subtitle", "time": 1488.756, "timestamp": "00:24:48", "text": "家族はただ彼らを待っているだけだ。ねえ、"}, {"type": "subtitle", "time": 1490.643, "timestamp": "00:24:50", "text": "家族はただ彼らを待っていた"}]
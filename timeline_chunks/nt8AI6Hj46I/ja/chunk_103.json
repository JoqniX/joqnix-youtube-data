[{"type": "subtitle", "time": 6181.961, "timestamp": "01:43:01", "text": "それは素晴らしいことです。 M、それはとても"}, {"type": "subtitle", "time": 6201.867, "timestamp": "01:43:21", "text": "ええ、正直に言うと。ごめん、私のせいだ。"}, {"type": "subtitle", "time": 6204.991, "timestamp": "01:43:24", "text": "私のミスです。私のミスです。私はクリックしました"}, {"type": "subtitle", "time": 6207.198, "timestamp": "01:43:27", "text": "ランブルではなくキック。オーケー、悪い"}, {"type": "subtitle", "time": 6220.428, "timestamp": "01:43:40", "text": "私の。この放送を見るにはどうすればいいですか？"}]
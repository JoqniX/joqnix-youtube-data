[{"type": "subtitle", "time": 1805.698, "timestamp": "00:30:05", "text": "はい。犯罪者または"}, {"type": "subtitle", "time": 1807.365, "timestamp": "00:30:07", "text": "従いたくない人々"}, {"type": "subtitle", "time": 1811.622, "timestamp": "00:30:11", "text": "ルール。彼らだけ、彼らはただ"}, {"type": "subtitle", "time": 1818.809, "timestamp": "00:30:18", "text": "まるで彼らが起きているかのように"}, {"type": "subtitle", "time": 1821.583, "timestamp": "00:30:21", "text": "夜の街は12時を迎える。ああ、そうだね。"}, {"type": "subtitle", "time": 1823.993, "timestamp": "00:30:23", "text": "はい。東京とかそういう場所。"}, {"type": "subtitle", "time": 1826.812, "timestamp": "00:30:26", "text": "はい。はい。はい。すべてが中心となる場所"}, {"type": "subtitle", "time": 1829.82, "timestamp": "00:30:29", "text": "ナイトライフとか、そういう類のことです。はい。はい。 。はい。そういう場所。神の"}, {"type": "subtitle", "time": 1843.76, "timestamp": "00:30:43", "text": "。はい。そういう場所。神の シーフード。こんにちは、配信へようこ​​そ。"}, {"type": "subtitle", "time": 1851.361, "timestamp": "00:30:51", "text": "意見交換ありがとうございました。ありがとう"}, {"type": "subtitle", "time": 1855.081, "timestamp": "00:30:55", "text": "それを交換する。大丈夫。こんにちは。"}]
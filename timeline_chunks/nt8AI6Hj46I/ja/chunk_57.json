[{"type": "subtitle", "time": 3420.011, "timestamp": "00:57:00", "text": "私は店の隣に座ってこう言うだろう 座った時に「こんにちは」と声をかけられた。わあ、あなたは"}, {"type": "subtitle", "time": 3422.076, "timestamp": "00:57:02", "text": "座った時に「こんにちは」と声をかけられた。わあ、あなたは 外向的なキャリー。あなたはまるで"}, {"type": "subtitle", "time": 3424.661, "timestamp": "00:57:04", "text": "外向的なキャリー。あなたはまるで 普通、普通、あるいは何でもいい。友よ、私は"}, {"type": "subtitle", "time": 3427.725, "timestamp": "00:57:07", "text": "普通、普通、あるいは何でもいい。友よ、私は とても内気。私は何も話さないつもりだ。"}, {"type": "subtitle", "time": 3434.73, "timestamp": "00:57:14", "text": "私としては、「直接話しかけてみればいい」と思うんです。行く"}, {"type": "subtitle", "time": 3437.084, "timestamp": "00:57:17", "text": "彼らと話をする。彼らと話してきなさい。あなたがしなければならない"}, {"type": "subtitle", "time": 3440.002, "timestamp": "00:57:20", "text": "話す。お見逃しなく。私の"}, {"type": "subtitle", "time": 3442.122, "timestamp": "00:57:22", "text": "私の脳と心はいつも私にこう言います"}, {"type": "subtitle", "time": 3444.189, "timestamp": "00:57:24", "text": "ねえ、友達を作らなきゃいけないし、"}, {"type": "subtitle", "time": 3447.874, "timestamp": "00:57:27", "text": "地元の人に話を聞いてみてください。でも、私にはできない。午前"}, {"type": "subtitle", "time": 3453.543, "timestamp": "00:57:33", "text": "恥ずかしがり屋すぎる。そしてその内気さは"}, {"type": "subtitle", "time": 3458.367, "timestamp": "00:57:38", "text": "それは私を苦しめる、あるいはそれに類するものです。いいえ"}, {"type": "subtitle", "time": 3475.347, "timestamp": "00:57:55", "text": "知っている。しかし、もし。いや、いや、でも"}]
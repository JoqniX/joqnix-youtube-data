[{"type": "subtitle", "time": 2820.687, "timestamp": "00:47:00", "text": "遅れて、まあいいや、おしゃべりを始めて"}, {"type": "subtitle", "time": 2825.586, "timestamp": "00:47:05", "text": "トイレを使っただけで怒鳴られた。"}, {"type": "subtitle", "time": 2833.013, "timestamp": "00:47:13", "text": "もしかしたら彼はあなたのことを気にかけているのかもしれない、まるで"}, {"type": "subtitle", "time": 2839.114, "timestamp": "00:47:19", "text": "それは事実だった。えっと。通常"}, {"type": "subtitle", "time": 2841.326, "timestamp": "00:47:21", "text": "おはようと言うと、彼らは、彼らは"}, {"type": "subtitle", "time": 2846.998, "timestamp": "00:47:26", "text": "「おはよう」とか、そういう返事をしてください。はい。そして"}, {"type": "subtitle", "time": 2849.477, "timestamp": "00:47:29", "text": "こんにちは、アラさん。ようこそ。いらっしゃいませ。 ？ 元気ですか？私はとても元気です。のみ"}, {"type": "subtitle", "time": 2851.188, "timestamp": "00:47:31", "text": "元気ですか？私はとても元気です。のみ 歩く。雨が降るよ…今は雨が降ってる"}, {"type": "subtitle", "time": 2853.139, "timestamp": "00:47:33", "text": "歩く。雨が降るよ…今は雨が降ってる 同じ。私は傘を持っていません。ええ、そうです。えっと。"}, {"type": "subtitle", "time": 2872.728, "timestamp": "00:47:52", "text": "本題に戻りましょう。えっと。問題は"}, {"type": "subtitle", "time": 2875.163, "timestamp": "00:47:55", "text": "知りたい、本当に知りたい"}, {"type": "subtitle", "time": 2877.327, "timestamp": "00:47:57", "text": "日本のティーンエイジャーと会う、"}, {"type": "subtitle", "time": 2879.964, "timestamp": "00:47:59", "text": "若者や大人と話をして、"}]
[{"type": "subtitle", "time": 3961.553, "timestamp": "01:06:01", "text": "そんな感じだと思う。「くそ、こうすればよかったのに」"}, {"type": "subtitle", "time": 3965.59, "timestamp": "01:06:05", "text": "「もっとそういう言い方をするんだ。」だから、そう、"}, {"type": "subtitle", "time": 3971.702, "timestamp": "01:06:11", "text": "それは私です。はい。でも、でも、でも、私は感じる"}, {"type": "subtitle", "time": 3974.582, "timestamp": "01:06:14", "text": "時間とともに、いや、時間とともに、"}, {"type": "subtitle", "time": 3979.378, "timestamp": "01:06:19", "text": "いいえ、私はこれが良くなると感じていますし、実際に良くなっています"}, {"type": "subtitle", "time": 3983.491, "timestamp": "01:06:23", "text": "改善が必要な点。私はただ"}, {"type": "subtitle", "time": 3985.335, "timestamp": "01:06:25", "text": "今後はほとんど何も行動を起こさない。"}, {"type": "subtitle", "time": 3988.339, "timestamp": "01:06:28", "text": "なぜそんなに悲しそうな顔をしているの？いやいや"}, {"type": "subtitle", "time": 3991.099, "timestamp": "01:06:31", "text": "私は悲しいです。これが私の悲しい顔です。"}, {"type": "subtitle", "time": 4012.934, "timestamp": "01:06:52", "text": "自然。それ？はい、良くなりますよ。 ？ これらの子供たちは"}, {"type": "subtitle", "time": 4014.478, "timestamp": "01:06:54", "text": "これらの子供たちは プール？これらの子供たちは出てくるのか"}, {"type": "subtitle", "time": 4018.854, "timestamp": "01:06:58", "text": "プール？これらの子供たちは出てくるのか プールから？彼らは家族と一緒に来ます"}]
[{"type": "subtitle", "time": 3902.957, "timestamp": "01:05:02", "text": "私はいつもそれらをとても大切に思っています。私はまだ話している"}, {"type": "subtitle", "time": 3909.363, "timestamp": "01:05:09", "text": "その人たちの輪の中だけで、"}, {"type": "subtitle", "time": 3911.127, "timestamp": "01:05:11", "text": "橋を渡って見つけたい"}, {"type": "subtitle", "time": 3919.17, "timestamp": "01:05:19", "text": "もっと友達が欲しいとか、そんな感じ。はい。でも、"}, {"type": "subtitle", "time": 3921.511, "timestamp": "01:05:21", "text": "ジョニックス、あなたは私を"}, {"type": "subtitle", "time": 3924.053, "timestamp": "01:05:24", "text": "コネクタなど。私は"}, {"type": "subtitle", "time": 3926.662, "timestamp": "01:05:26", "text": "私は多くのクリエイターとコラボレーションしました。"}, {"type": "subtitle", "time": 3930.526, "timestamp": "01:05:30", "text": "YouTuber、あれこれ。できる"}, {"type": "subtitle", "time": 3932.787, "timestamp": "01:05:32", "text": "私は外向的な人に見えるかもしれません。"}, {"type": "subtitle", "time": 3934.991, "timestamp": "01:05:34", "text": "つまり、社交的な人か何か"}, {"type": "subtitle", "time": 3937.2, "timestamp": "01:05:37", "text": "なれ。おそらく、私を見つめれば見つめるほど、"}, {"type": "subtitle", "time": 3939.194, "timestamp": "01:05:39", "text": "私がどれほど内向的な人間か、お分かりいただけるでしょう。"}, {"type": "subtitle", "time": 3944.228, "timestamp": "01:05:44", "text": "存在する。もしくは、私はただ話すのが好きなだけなんです"}, {"type": "subtitle", "time": 3946.692, "timestamp": "01:05:46", "text": "一人でいる時もそうだ。えっと、例えば"}, {"type": "subtitle", "time": 3948.827, "timestamp": "01:05:48", "text": "私が一人で放送するとき。しかし"}, {"type": "subtitle", "time": 3950.607, "timestamp": "01:05:50", "text": "グループ送信中、"}, {"type": "subtitle", "time": 3956.212, "timestamp": "01:05:56", "text": "お分かりになると思いますが、私はほとんど話しません。そしてその後"}, {"type": "subtitle", "time": 3958.916, "timestamp": "01:05:58", "text": "トランスミッションは、私が 1 つまたは 1 つまたは 1 つを実行すると、"}]
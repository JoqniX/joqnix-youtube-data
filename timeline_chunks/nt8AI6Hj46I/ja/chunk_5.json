[{"type": "subtitle", "time": 300.331, "timestamp": "00:05:00", "text": "前の場所。あなたはそれを証明した。やったよ。"}, {"type": "subtitle", "time": 305.49, "timestamp": "00:05:05", "text": "つまり、もしあなたが既にそれを見たことがあるなら、ということです。元気ですか"}, {"type": "subtitle", "time": 307.867, "timestamp": "00:05:07", "text": "日本？故郷が恋しいですか？まだ"}, {"type": "subtitle", "time": 311.102, "timestamp": "00:05:11", "text": "まるで日本にいないような気分だ。わからない"}, {"type": "subtitle", "time": 314.17, "timestamp": "00:05:14", "text": "どこ。私はまだ自分が"}, {"type": "subtitle", "time": 316.738, "timestamp": "00:05:16", "text": "日本。正直に言うと、私は"}, {"type": "subtitle", "time": 321.078, "timestamp": "00:05:21", "text": "旅行。はい、ここがその場所です。"}, {"type": "subtitle", "time": 324.385, "timestamp": "00:05:24", "text": "真っ直ぐ。あの公園だよ。公園"}, {"type": "subtitle", "time": 328.038, "timestamp": "00:05:28", "text": "大きい。今日は公園には行きません。のみ"}, {"type": "subtitle", "time": 330.444, "timestamp": "00:05:30", "text": "今日は散歩に出かけます。私はただ"}, {"type": "subtitle", "time": 333.858, "timestamp": "00:05:33", "text": "外。どこにいるの？私はただ"}, {"type": "subtitle", "time": 337.984, "timestamp": "00:05:37", "text": "今は歩いています。今から入っていきます。"}, {"type": "subtitle", "time": 340.028, "timestamp": "00:05:40", "text": "蚊がたくさんいる。一体どういうことだ？"}, {"type": "subtitle", "time": 342.192, "timestamp": "00:05:42", "text": "日本には蚊がいる。ご存知でしたか？"}, {"type": "subtitle", "time": 346.265, "timestamp": "00:05:46", "text": "インドに限ったことではない。私は"}, {"type": "subtitle", "time": 348.193, "timestamp": "00:05:48", "text": "蚊の問題を解消するだろう"}, {"type": "subtitle", "time": 352.007, "timestamp": "00:05:52", "text": "インドから他の国へ来るとき。しかし"}, {"type": "subtitle", "time": 355.731, "timestamp": "00:05:55", "text": "夏は悪夢だ。たくさんあります"}]
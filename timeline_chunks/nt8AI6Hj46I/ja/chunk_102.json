[{"type": "subtitle", "time": 6121.672, "timestamp": "01:42:01", "text": "ちくしょう、息子よ。良い。よし、いいぞ、いいぞ、"}, {"type": "subtitle", "time": 6128.378, "timestamp": "01:42:08", "text": "良い。ああ、それは素晴らしいですね。よし、何？"}, {"type": "subtitle", "time": 6130.204, "timestamp": "01:42:10", "text": "プレミアム会員になると、他にどんな特典が手に入ったの？"}, {"type": "subtitle", "time": 6139.778, "timestamp": "01:42:19", "text": "彼らは50個くらい持っていた、えっと、50個、50個くらい"}, {"type": "subtitle", "time": 6146.352, "timestamp": "01:42:26", "text": "最初の1ヶ月間は無料トライアル料金が適用されます。"}, {"type": "subtitle", "time": 6153.75, "timestamp": "01:42:33", "text": "だから、それを使っています。それで"}, {"type": "subtitle", "time": 6156.537, "timestamp": "01:42:36", "text": "Twitterを追加できます。追加できます"}, {"type": "subtitle", "time": 6158.995, "timestamp": "01:42:38", "text": "Twitterであなたをフォローできます。できる"}, {"type": "subtitle", "time": 6161.201, "timestamp": "01:42:41", "text": "ランブルとか、そういうものを追加してください。素晴らしい。"}]
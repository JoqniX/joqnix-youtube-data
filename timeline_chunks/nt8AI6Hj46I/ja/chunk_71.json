[{"type": "subtitle", "time": 4271.65, "timestamp": "01:11:11", "text": "はい。見てみましょう。何かある。はい、できます。 スマホをモードで持つにはどうすればいいですか？"}, {"type": "subtitle", "time": 4273.611, "timestamp": "01:11:13", "text": "スマホをモードで持つにはどうすればいいですか？ まるでスピーカーフォンで話しているみたいに？"}, {"type": "subtitle", "time": 4276.032, "timestamp": "01:11:16", "text": "まるでスピーカーフォンで話しているみたいに？ ええと、私はまるで"}, {"type": "subtitle", "time": 4278.268, "timestamp": "01:11:18", "text": "ええと、私はまるで スピーカー、まさにその通り。はい。それで、"}, {"type": "subtitle", "time": 4297.505, "timestamp": "01:11:37", "text": "問題は、私が自分の"}, {"type": "subtitle", "time": 4299.447, "timestamp": "01:11:39", "text": "私は常に外部マイクを持ち歩いているからです。"}, {"type": "subtitle", "time": 4301.097, "timestamp": "01:11:41", "text": "バッテリーに接続されている"}, {"type": "subtitle", "time": 4304.934, "timestamp": "01:11:44", "text": "ポータブル。それが問題なんです。の"}, {"type": "subtitle", "time": 4306.752, "timestamp": "01:11:46", "text": "それどころか、文字通り"}, {"type": "subtitle", "time": 4308.735, "timestamp": "01:11:48", "text": "外部マイクに接続または"}, {"type": "subtitle", "time": 4315.285, "timestamp": "01:11:55", "text": "そんな感じ。はい、なぜなら受信機は"}, {"type": "subtitle", "time": 4319.135, "timestamp": "01:11:59", "text": "受信機がどうあるべきか"}]
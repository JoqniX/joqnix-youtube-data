[{"type": "subtitle", "time": 1203.207, "timestamp": "00:20:03", "text": "私の携帯電話。だから、私が使ったのは 私の電力を充電するためのモバイルバンク"}, {"type": "subtitle", "time": 1205.506, "timestamp": "00:20:05", "text": "私の電力を充電するためのモバイルバンク 私の携帯電話を充電するメインバンク"}, {"type": "subtitle", "time": 1215.797, "timestamp": "00:20:15", "text": "そういう類のことです。しかし現実には、"}, {"type": "subtitle", "time": 1218.05, "timestamp": "00:20:18", "text": "スーパーチャージングの意味がよくわからない"}, {"type": "subtitle", "time": 1220.304, "timestamp": "00:20:20", "text": "そうすればすぐにスマホを操作できる。"}, {"type": "subtitle", "time": 1225.605, "timestamp": "00:20:25", "text": "さらに、私のメインのモバイルバッテリーは… …えっと、ちょっと止まるというか…悪化するんです。"}, {"type": "subtitle", "time": 1231.461, "timestamp": "00:20:31", "text": "神様、私は発音することさえできません"}, {"type": "subtitle", "time": 1236.376, "timestamp": "00:20:36", "text": "言葉。劣化する。耐用年数"}, {"type": "subtitle", "time": 1238.159, "timestamp": "00:20:38", "text": "バッテリーは経年劣化します。"}, {"type": "subtitle", "time": 1242.834, "timestamp": "00:20:42", "text": "時間ですよね？モバイルバッテリーを使う場合、"}, {"type": "subtitle", "time": 1245.592, "timestamp": "00:20:45", "text": "別のモバイルバッテリーを充電するためのPD対応モバイルバッテリー"}, {"type": "subtitle", "time": 1248.8220000000001, "timestamp": "00:20:48", "text": "銀行PD。それはまずいですね。"}, {"type": "subtitle", "time": 1253.765, "timestamp": "00:20:53", "text": "通常は、モバイルバッテリーを充電します。"}, {"type": "subtitle", "time": 1259.472, "timestamp": "00:20:59", "text": "電源アダプターから、 真実？壁のコンセントに差し込むと、"}]
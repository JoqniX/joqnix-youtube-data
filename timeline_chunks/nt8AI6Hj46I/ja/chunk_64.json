[{"type": "subtitle", "time": 3847.363, "timestamp": "01:04:07", "text": "それ。はい。しかし、確かに、 言語と、何を言うべきか、どう言うべきか分からない"}, {"type": "subtitle", "time": 3849.865, "timestamp": "01:04:09", "text": "言語と、何を言うべきか、どう言うべきか分からない 会話を始めるなど。"}, {"type": "subtitle", "time": 3855.176, "timestamp": "01:04:15", "text": "会話を始めるなど。 共通の利益など。非常に難しい。"}, {"type": "subtitle", "time": 3863.746, "timestamp": "01:04:23", "text": "でも、そう思うのは、"}, {"type": "subtitle", "time": 3865.889, "timestamp": "01:04:25", "text": "それは本当に難しいことだと私は思います。"}, {"type": "subtitle", "time": 3867.921, "timestamp": "01:04:27", "text": "彼にはほとんど人がいなかったから"}, {"type": "subtitle", "time": 3874.29, "timestamp": "01:04:34", "text": "家族以外とは話さない。えっと、例えば"}, {"type": "subtitle", "time": 3876.665, "timestamp": "01:04:36", "text": "成長していくこの数年間、"}, {"type": "subtitle", "time": 3878.554, "timestamp": "01:04:38", "text": "友人たちはそれぞれ別の道を歩んだ"}, {"type": "subtitle", "time": 3888.179, "timestamp": "01:04:48", "text": "違うし、そういうことだ。おそらくそれが理由でしょう"}, {"type": "subtitle", "time": 3890.399, "timestamp": "01:04:50", "text": "私は今でも人と会うときは人見知りです"}, {"type": "subtitle", "time": 3892.164, "timestamp": "01:04:52", "text": "そして人々と話をし、私は"}, {"type": "subtitle", "time": 3894.271, "timestamp": "01:04:54", "text": "人との密接なつながり"}, {"type": "subtitle", "time": 3896.435, "timestamp": "01:04:56", "text": "私が話をする人や、私のことを知っている人など。"}]
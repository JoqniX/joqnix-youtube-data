[{"type": "subtitle", "time": 5100.079, "timestamp": "01:25:00", "text": "ノイズキャンセリング。私は変わった"}, {"type": "subtitle", "time": 5104.887, "timestamp": "01:25:04", "text": "意見。何？要らないの？これ"}, {"type": "subtitle", "time": 5117.576, "timestamp": "01:25:17", "text": "良い。大丈夫。大丈夫。しかし、もし、"}, {"type": "subtitle", "time": 5119.998, "timestamp": "01:25:19", "text": "私は普段あまり声を出さないのですが"}, {"type": "subtitle", "time": 5122.42, "timestamp": "01:25:22", "text": "時々、話さなきゃいけない気がする"}, {"type": "subtitle", "time": 5124.969, "timestamp": "01:25:24", "text": "近く…私はこのように話さなければならない、"}, {"type": "subtitle", "time": 5127.518, "timestamp": "01:25:27", "text": "電話を口元に近づけたとき、または"}, {"type": "subtitle", "time": 5129.812, "timestamp": "01:25:29", "text": "私はもっ​​と静かに話しますが、よく理解されません。"}, {"type": "subtitle", "time": 5136.595, "timestamp": "01:25:36", "text": "そんな感じ。だから私はこう思うのです。「"}, {"type": "subtitle", "time": 5142.938, "timestamp": "01:25:42", "text": "わかりました、完全に電源を切ります。はい、"}, {"type": "subtitle", "time": 5147.121, "timestamp": "01:25:47", "text": "ノイズキャンセリングにより、"}, {"type": "subtitle", "time": 5149.318, "timestamp": "01:25:49", "text": "オフ。はい、セミの鳴き声は聞こえません。"}, {"type": "subtitle", "time": 5152.129, "timestamp": "01:25:52", "text": "雨が降っていたからです。いいえ、"}, {"type": "subtitle", "time": 5156.27, "timestamp": "01:25:56", "text": "セミたちは飛び去った。もし私が行くなら"}]
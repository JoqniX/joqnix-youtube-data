[{"type": "subtitle", "time": 2886.356, "timestamp": "00:48:06", "text": "それら。話題について話し、"}, {"type": "subtitle", "time": 2890.701, "timestamp": "00:48:10", "text": "友達。でも、"}, {"type": "subtitle", "time": 2892.805, "timestamp": "00:48:12", "text": "外国人、機会または"}, {"type": "subtitle", "time": 2894.909, "timestamp": "00:48:14", "text": "この状況は必須ではありませんが、"}, {"type": "subtitle", "time": 2897.396, "timestamp": "00:48:17", "text": "私がそう言う理由を説明します。"}, {"type": "subtitle", "time": 2899.947, "timestamp": "00:48:19", "text": "この状況は強制的なものか何かだ。"}, {"type": "subtitle", "time": 2904.869, "timestamp": "00:48:24", "text": "例えば、私がキャンパスに行ったとしましょう"}, {"type": "subtitle", "time": 2907.012, "timestamp": "00:48:27", "text": "東京で最初にオープンしました"}, {"type": "subtitle", "time": 2913.291, "timestamp": "00:48:33", "text": "それはいつ頃のことだったのでしょうか？その間、えーと、"}, {"type": "subtitle", "time": 2916.137, "timestamp": "00:48:36", "text": "4月29日、私はキャンパスをオープンしました"}, {"type": "subtitle", "time": 2918.69, "timestamp": "00:48:38", "text": "初めて東京に来たのですが、"}, {"type": "subtitle", "time": 2921.244, "timestamp": "00:48:41", "text": "初めて、私は自分の"}, {"type": "subtitle", "time": 2926.494, "timestamp": "00:48:46", "text": "住所。私の住所は"}, {"type": "subtitle", "time": 2928.758, "timestamp": "00:48:48", "text": "WhatsApp、こんにちはTweak、ようこそ"}, {"type": "subtitle", "time": 2930.83, "timestamp": "00:48:50", "text": "トランスミッション。戻るつもりですか？"}, {"type": "subtitle", "time": 2933.35, "timestamp": "00:48:53", "text": "家？いや、ただ歩き回っているだけです"}, {"type": "subtitle", "time": 2935.221, "timestamp": "00:48:55", "text": "そこには。雨が降っている。持っていません"}, {"type": "subtitle", "time": 2937.37, "timestamp": "00:48:57", "text": "今は傘が必要なので、もしかしたら"}, {"type": "subtitle", "time": 2939.517, "timestamp": "00:48:59", "text": "一時的なものか何かを買いました。いいえ"}]
[{"type": "subtitle", "time": 4443.461, "timestamp": "01:14:03", "text": "寝る。そう、私は行かなければならない"}, {"type": "subtitle", "time": 4452.522, "timestamp": "01:14:12", "text": "授業にはちゃんとついていけています。だからもし"}, {"type": "subtitle", "time": 4454.595, "timestamp": "01:14:14", "text": "私がそれを日本語で言ったら、彼らは"}, {"type": "subtitle", "time": 4459.536, "timestamp": "01:14:19", "text": "放送中です。もし...もし"}, {"type": "subtitle", "time": 4461.868, "timestamp": "01:14:21", "text": "先ほど私に挨拶してくれたスタッフ"}, {"type": "subtitle", "time": 4464.46, "timestamp": "01:14:24", "text": "その瞬間、通り過ぎる時の歓迎"}, {"type": "subtitle", "time": 4466.533, "timestamp": "01:14:26", "text": "もし私がそう言っていたら、"}, {"type": "subtitle", "time": 4468.801, "timestamp": "01:14:28", "text": "日本人はこう思うだろう。「ああ、これは"}, {"type": "subtitle", "time": 4482.859, "timestamp": "01:14:42", "text": "「その人は電波を発信している。」はい、"}]
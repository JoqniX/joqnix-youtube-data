[{"type": "subtitle", "time": 841.366, "timestamp": "00:14:01", "text": "学校、ただ私が望んでいたのは…私はここにいた"}, {"type": "subtitle", "time": 845.553, "timestamp": "00:14:05", "text": "トマチくんと話すためだけに"}, {"type": "subtitle", "time": 851.057, "timestamp": "00:14:11", "text": "私はここでくつろいでいました。待って、見てみよう"}, {"type": "subtitle", "time": 859.648, "timestamp": "00:14:19", "text": "それは公園を示しています。同じ公園"}, {"type": "subtitle", "time": 862.029, "timestamp": "00:14:22", "text": "私たちがこれをやった場所、えーと、ロープのやつ"}, {"type": "subtitle", "time": 866.174, "timestamp": "00:14:26", "text": "首を吊る。私たちはここでそれを"}, {"type": "subtitle", "time": 870.485, "timestamp": "00:14:30", "text": "手。片手で前にやった"}, {"type": "subtitle", "time": 872.424, "timestamp": "00:14:32", "text": "誰もが見ることができる公共の道路。"}, {"type": "subtitle", "time": 877.644, "timestamp": "00:14:37", "text": "それはそうだった、それはそうだった、ええと、"}, {"type": "subtitle", "time": 881.806, "timestamp": "00:14:41", "text": "恥ずべきことだ。私の方ではそうだったけど、やり遂げたよ。"}, {"type": "subtitle", "time": 887.749, "timestamp": "00:14:47", "text": "それが重要な点だ。だからこれは"}, {"type": "subtitle", "time": 891.515, "timestamp": "00:14:51", "text": "下り坂、この下り坂。これはとても良かった。 。正直に言うと、ええ、この辺りにいましたよ。"}, {"type": "subtitle", "time": 899.421, "timestamp": "00:14:59", "text": "。正直に言うと、ええ、この辺りにいましたよ。 今日。私はちょうどここで考えていた"}]
[{"type": "subtitle", "time": 3601.516, "timestamp": "01:00:01", "text": "彼は言った。 Dさん、彼らはちょうど到着しました"}, {"type": "subtitle", "time": 3604.332, "timestamp": "01:00:04", "text": "ここ。彼らは尋ねたいのですが、"}, {"type": "subtitle", "time": 3606.339, "timestamp": "01:00:06", "text": "思い切って飛び込むしかない。知ってるよ、誰だって"}, {"type": "subtitle", "time": 3607.959, "timestamp": "01:00:07", "text": "あなたが知っている？彼らは良い人になれるかもしれない"}, {"type": "subtitle", "time": 3609.448, "timestamp": "01:00:09", "text": "後で友達になる、特に"}, {"type": "subtitle", "time": 3610.859, "timestamp": "01:00:10", "text": "彼らはしばらくの間、一緒に座っていた。"}, {"type": "subtitle", "time": 3612.438, "timestamp": "01:00:12", "text": "彼らに何が起こっているのかについて話してもいいですよ。"}, {"type": "subtitle", "time": 3614.389, "timestamp": "01:00:14", "text": "彼らにどうやってここに来たのか、"}, {"type": "subtitle", "time": 3619.755, "timestamp": "01:00:19", "text": "彼らはやりたいのです。何てことだ。ありがとう"}, {"type": "subtitle", "time": 3622.053, "timestamp": "01:00:22", "text": "そのメッセージ、その反応のせいで、"}, {"type": "subtitle", "time": 3624.293, "timestamp": "01:00:24", "text": "私は、"}, {"type": "subtitle", "time": 3628.352, "timestamp": "01:00:28", "text": "学校もどちらも。私でさえも"}, {"type": "subtitle", "time": 3630.245, "timestamp": "01:00:30", "text": "私はクラスメートとコミュニケーションをとります。"}, {"type": "subtitle", "time": 3645.79, "timestamp": "01:00:45", "text": "そして今、2つ目のものがあります。今"}, {"type": "subtitle", "time": 3647.481, "timestamp": "01:00:47", "text": "そこに新しい生徒がいるみたいだ。"}, {"type": "subtitle", "time": 3654.143, "timestamp": "01:00:54", "text": "今度は新しい生徒が来た"}, {"type": "subtitle", "time": 3656.141, "timestamp": "01:00:56", "text": "そちら側。待って、私の声が聞こえますか？による"}, {"type": "subtitle", "time": 3658.122, "timestamp": "01:00:58", "text": "はい、タブを切り替えています。"}]
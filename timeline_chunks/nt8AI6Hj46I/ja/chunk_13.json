[{"type": "subtitle", "time": 790.079, "timestamp": "00:13:10", "text": "ここまで来たのか、兄弟？待って、どうやって"}, {"type": "subtitle", "time": 793.962, "timestamp": "00:13:13", "text": "私はここに到着したのですか？私は渡らなかったのか？"}, {"type": "subtitle", "time": 796.236, "timestamp": "00:13:16", "text": "通り、メインストリートなど ？ああ、そうだったよ。おい。ああ、わかりました。"}, {"type": "subtitle", "time": 802.735, "timestamp": "00:13:22", "text": "？ああ、そうだったよ。おい。ああ、わかりました。 こちらの道を進んでください。来て。今日。のみ"}, {"type": "subtitle", "time": 806.488, "timestamp": "00:13:26", "text": "こちらの道を進んでください。来て。今日。のみ 私は歩いています。私は歩いています。私は"}, {"type": "subtitle", "time": 808.765, "timestamp": "00:13:28", "text": "私は歩いています。私は歩いています。私は 歩く。私たちは本当にここまで来たのです。"}, {"type": "subtitle", "time": 815.853, "timestamp": "00:13:35", "text": "この場所を知っている。忘れて。"}, {"type": "subtitle", "time": 819.079, "timestamp": "00:13:39", "text": "忘れて。忘れて。待って。それは"}, {"type": "subtitle", "time": 823.095, "timestamp": "00:13:43", "text": "同じ？えっと、待って。少し"}, {"type": "subtitle", "time": 826.296, "timestamp": "00:13:46", "text": "違う。ああ、ここは同じ場所だ。"}, {"type": "subtitle", "time": 829.189, "timestamp": "00:13:49", "text": "ああ、そうだね。ああ、そうだね。はい。これは"}, {"type": "subtitle", "time": 831.965, "timestamp": "00:13:51", "text": "学校とか、そんな感じのところ。ああ、そうだね。ああ、そうだね。"}, {"type": "subtitle", "time": 834.929, "timestamp": "00:13:54", "text": "はい。はい。はい。私はここにもっといた"}, {"type": "subtitle", "time": 839.067, "timestamp": "00:13:59", "text": "今朝は放課後早く。で"}]
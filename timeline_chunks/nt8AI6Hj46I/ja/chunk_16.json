[{"type": "subtitle", "time": 968.839, "timestamp": "00:16:08", "text": "喉が渇いていた。ああ、神様。ああ、なんてことだ。それ 良い。だから、どれくらいかかるかはわかりません。"}, {"type": "subtitle", "time": 971.979, "timestamp": "00:16:11", "text": "良い。だから、どれくらいかかるかはわかりません。 今日は放送します。おそらく1時間か"}, {"type": "subtitle", "time": 974.153, "timestamp": "00:16:14", "text": "今日は放送します。おそらく1時間か 最大2時間。だから、彼らは"}, {"type": "subtitle", "time": 976.289, "timestamp": "00:16:16", "text": "最大2時間。だから、彼らは 現在時刻は7時21分です。それで、"}, {"type": "subtitle", "time": 980.466, "timestamp": "00:16:20", "text": "現在時刻は7時21分です。それで、 おそらく今日は8時か8時半まででしょう。"}, {"type": "subtitle", "time": 991.832, "timestamp": "00:16:31", "text": "そう、私は考えていた"}, {"type": "subtitle", "time": 1000.28, "timestamp": "00:16:40", "text": "最近は色々なことがあって、えっと、"}, {"type": "subtitle", "time": 1002.799, "timestamp": "00:16:42", "text": "問題は、今私がしたいのは"}, {"type": "subtitle", "time": 1005.606, "timestamp": "00:16:45", "text": "やりたいことはたくさんあるけど、時間がないから"}, {"type": "subtitle", "time": 1008.485, "timestamp": "00:16:48", "text": "すべてが私を、えっと、とても、とても どう言えばいいですか？時間がない"}, {"type": "subtitle", "time": 1014.507, "timestamp": "00:16:54", "text": "どう言えばいいですか？時間がない 現実は、えっと、心配な気持ちにさせる"}]
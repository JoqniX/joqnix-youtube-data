[{"type": "subtitle", "time": 3480.788, "timestamp": "00:58:00", "text": "心の奥底では、私はこう感じている…"}, {"type": "subtitle", "time": 3486.909, "timestamp": "00:58:06", "text": "時々、"}, {"type": "subtitle", "time": 3491.604, "timestamp": "00:58:11", "text": "外国人に対して。時には"}, {"type": "subtitle", "time": 3493.726, "timestamp": "00:58:13", "text": "外国人を受け入れる人々、"}, {"type": "subtitle", "time": 3497.714, "timestamp": "00:58:17", "text": "真実？東京のような場所は"}, {"type": "subtitle", "time": 3500.876, "timestamp": "00:58:20", "text": "外国人だらけ。あれらあれら"}, {"type": "subtitle", "time": 3503.333, "timestamp": "00:58:23", "text": "これらは人々が嫌う場所です"}, {"type": "subtitle", "time": 3505.855, "timestamp": "00:58:25", "text": "先住民は、地元の人々が嫌うだろう"}, {"type": "subtitle", "time": 3508.312, "timestamp": "00:58:28", "text": "外国人は"}, {"type": "subtitle", "time": 3510.381, "timestamp": "00:58:30", "text": "外国人が物事を台無しにしているのを見るのは…"}, {"type": "subtitle", "time": 3512.903, "timestamp": "00:58:32", "text": "ルール違反などなど。本当ですか？"}, {"type": "subtitle", "time": 3516.968, "timestamp": "00:58:36", "text": "ここのような場所では"}, {"type": "subtitle", "time": 3519.065, "timestamp": "00:58:39", "text": "外国人は非常に少なく、"}, {"type": "subtitle", "time": 3532.569, "timestamp": "00:58:52", "text": "私は推測する。だから私は水分補給をしました"}, {"type": "subtitle", "time": 3534.642, "timestamp": "00:58:54", "text": "水分補給のための飲み物"}, {"type": "subtitle", "time": 3539.548, "timestamp": "00:58:59", "text": "この水、この公園。それで"}]
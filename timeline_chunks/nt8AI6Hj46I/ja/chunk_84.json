[{"type": "subtitle", "time": 5045.714, "timestamp": "01:24:05", "text": "ノイズ。ノイズ抑制を有効にします"}, {"type": "subtitle", "time": 5051.255, "timestamp": "01:24:11", "text": "必要に応じて。ほとんどの場合そうはならない"}, {"type": "subtitle", "time": 5053.521, "timestamp": "01:24:13", "text": "彼らに与える方が良いと思うからそうする"}, {"type": "subtitle", "time": 5061.284, "timestamp": "01:24:21", "text": "自然なASMR。だから時々、"}, {"type": "subtitle", "time": 5066.808, "timestamp": "01:24:26", "text": "最初の機能の1つである"}, {"type": "subtitle", "time": 5068.409, "timestamp": "01:24:28", "text": "私が追加したのはノイズキャンセリング機能です。"}, {"type": "subtitle", "time": 5070.479, "timestamp": "01:24:30", "text": "はい。はい。はい。あなたは追加しました"}, {"type": "subtitle", "time": 5072.527, "timestamp": "01:24:32", "text": "まずノイズキャンセリングから。それで"}, {"type": "subtitle", "time": 5078.093, "timestamp": "01:24:38", "text": "はい、そうです。私がここにいるとき"}, {"type": "subtitle", "time": 5080.312, "timestamp": "01:24:40", "text": "シーンの種類と、"}, {"type": "subtitle", "time": 5082.475, "timestamp": "01:24:42", "text": "カメラを見せていないとき"}, {"type": "subtitle", "time": 5084.638, "timestamp": "01:24:44", "text": "カメラとか全部、起動できると思う"}, {"type": "subtitle", "time": 5098.32, "timestamp": "01:24:58", "text": "ノイズ抑制。はい、私は嫌いです"}]
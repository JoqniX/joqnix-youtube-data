[{"type": "subtitle", "time": 2886.356, "timestamp": "00:48:06", "text": "那些東西。談話題並做"}, {"type": "subtitle", "time": 2890.701, "timestamp": "00:48:10", "text": "朋友們。但當你像…"}, {"type": "subtitle", "time": 2892.805, "timestamp": "00:48:12", "text": "外國人，當場合或"}, {"type": "subtitle", "time": 2894.909, "timestamp": "00:48:14", "text": "這種情況並非強制性的，目前已經如此。"}, {"type": "subtitle", "time": 2897.396, "timestamp": "00:48:17", "text": "我會解釋我為什麼這麼說，好嗎？"}, {"type": "subtitle", "time": 2899.947, "timestamp": "00:48:19", "text": "這種情況是強制性的還是其他原因。"}, {"type": "subtitle", "time": 2904.869, "timestamp": "00:48:24", "text": "比如說，我去了一所大學校園。"}, {"type": "subtitle", "time": 2907.012, "timestamp": "00:48:27", "text": "第一家店在東京開業"}, {"type": "subtitle", "time": 2913.291, "timestamp": "00:48:33", "text": "當時是什麼時候？在，呃，"}, {"type": "subtitle", "time": 2916.137, "timestamp": "00:48:36", "text": "4月29日，我去了由…開放的校園。"}, {"type": "subtitle", "time": 2918.69, "timestamp": "00:48:38", "text": "第一次來東京，那是我的"}, {"type": "subtitle", "time": 2921.244, "timestamp": "00:48:41", "text": "這是我第一次寫不出東西。"}, {"type": "subtitle", "time": 2926.494, "timestamp": "00:48:46", "text": "地址。我的地址在我的"}, {"type": "subtitle", "time": 2928.758, "timestamp": "00:48:48", "text": "WhatsApp，但你好 Tweak，歡迎來到"}, {"type": "subtitle", "time": 2930.83, "timestamp": "00:48:50", "text": "變速器。你要回去嗎？"}, {"type": "subtitle", "time": 2933.35, "timestamp": "00:48:53", "text": "家？呃，不，我只是隨便逛逛。"}, {"type": "subtitle", "time": 2935.221, "timestamp": "00:48:55", "text": "那裡。下雨了。沒有"}, {"type": "subtitle", "time": 2937.37, "timestamp": "00:48:57", "text": "現在雨傘可能不太好找。"}, {"type": "subtitle", "time": 2939.517, "timestamp": "00:48:59", "text": "我買了個臨時用的之類的東西。不"}]
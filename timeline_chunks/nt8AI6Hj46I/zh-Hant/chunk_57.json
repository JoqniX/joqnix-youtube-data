[{"type": "subtitle", "time": 3420.011, "timestamp": "00:57:00", "text": "我會坐在商店旁邊說 我坐下時，你好。哇，你真是個…"}, {"type": "subtitle", "time": 3422.076, "timestamp": "00:57:02", "text": "我坐下時，你好。哇，你真是個… 個性外向的卡莉。你就像"}, {"type": "subtitle", "time": 3424.661, "timestamp": "00:57:04", "text": "個性外向的卡莉。你就像 正常，正常之類的。朋友，我是"}, {"type": "subtitle", "time": 3427.725, "timestamp": "00:57:07", "text": "正常，正常之類的。朋友，我是 好害羞。我根本不想說話。"}, {"type": "subtitle", "time": 3434.73, "timestamp": "00:57:14", "text": "我的想法是，去和他們談談。去"}, {"type": "subtitle", "time": 3437.084, "timestamp": "00:57:17", "text": "和他們談談。去和他們談談。你必須"}, {"type": "subtitle", "time": 3440.002, "timestamp": "00:57:20", "text": "講話。別錯過。我的"}, {"type": "subtitle", "time": 3442.122, "timestamp": "00:57:22", "text": "我的大腦和我的思維總是告訴我這一點。"}, {"type": "subtitle", "time": 3444.189, "timestamp": "00:57:24", "text": "嘿，你得交朋友，你得…"}, {"type": "subtitle", "time": 3447.874, "timestamp": "00:57:27", "text": "和當地人聊聊。但我做不到。是"}, {"type": "subtitle", "time": 3453.543, "timestamp": "00:57:33", "text": "太害羞了。而那份羞怯正是"}, {"type": "subtitle", "time": 3458.367, "timestamp": "00:57:38", "text": "那會讓我很痛苦，或者諸如此類。不"}, {"type": "subtitle", "time": 3475.347, "timestamp": "00:57:55", "text": "我知道。但是如果。不，那不行，但是"}]
[{"type": "subtitle", "time": 3601.516, "timestamp": "01:00:01", "text": "他說。所以D，他們剛到。"}, {"type": "subtitle", "time": 3604.332, "timestamp": "01:00:04", "text": "這裡。他們想問，但是"}, {"type": "subtitle", "time": 3606.339, "timestamp": "01:00:06", "text": "你必須放手一搏。你知道，是誰"}, {"type": "subtitle", "time": 3607.959, "timestamp": "01:00:07", "text": "你知道？他們有可能成為好人"}, {"type": "subtitle", "time": 3609.448, "timestamp": "01:00:09", "text": "朋友後來，尤其是如果"}, {"type": "subtitle", "time": 3610.859, "timestamp": "01:00:10", "text": "他們並肩坐了一會兒。"}, {"type": "subtitle", "time": 3612.438, "timestamp": "01:00:12", "text": "你可以和他們談談他們身上發生的事情。"}, {"type": "subtitle", "time": 3614.389, "timestamp": "01:00:14", "text": "問問他們是怎麼到這裡來的，他們"}, {"type": "subtitle", "time": 3619.755, "timestamp": "01:00:19", "text": "他們想做。我的天啊。謝謝"}, {"type": "subtitle", "time": 3622.053, "timestamp": "01:00:22", "text": "因為那條訊息，那份回應，因為"}, {"type": "subtitle", "time": 3624.293, "timestamp": "01:00:24", "text": "我覺得我甚至都沒做到那樣。"}, {"type": "subtitle", "time": 3628.352, "timestamp": "01:00:28", "text": "學校也一樣。連我都不行"}, {"type": "subtitle", "time": 3630.245, "timestamp": "01:00:30", "text": "我與同學交流。"}, {"type": "subtitle", "time": 3645.79, "timestamp": "01:00:45", "text": "現在好像又出現了第二個。現在"}, {"type": "subtitle", "time": 3647.481, "timestamp": "01:00:47", "text": "那裡好像來了一個新生。"}, {"type": "subtitle", "time": 3654.143, "timestamp": "01:00:54", "text": "現在好像來了個新學生"}, {"type": "subtitle", "time": 3656.141, "timestamp": "01:00:56", "text": "在那邊。等等，你聽得到我說話嗎？經過"}, {"type": "subtitle", "time": 3658.122, "timestamp": "01:00:58", "text": "是的，我正在切換標籤頁。"}]
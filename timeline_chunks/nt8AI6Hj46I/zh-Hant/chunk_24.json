[{"type": "subtitle", "time": 1445.633, "timestamp": "00:24:05", "text": "等待。一、二、三。全部"}, {"type": "subtitle", "time": 1447.594, "timestamp": "00:24:07", "text": "我前面這三輛車是三輛"}, {"type": "subtitle", "time": 1449.606, "timestamp": "00:24:09", "text": "不同的準父母"}, {"type": "subtitle", "time": 1454.409, "timestamp": "00:24:14", "text": "這樣孩子們就能回家了。那"}, {"type": "subtitle", "time": 1457.926, "timestamp": "00:24:17", "text": "很有意思。我已經給你們看過了… 我本來可以給你看那輛車的"}, {"type": "subtitle", "time": 1460.335, "timestamp": "00:24:20", "text": "我本來可以給你看那輛車的 他走了。我本來可以給你示範的。那"}, {"type": "subtitle", "time": 1464.946, "timestamp": "00:24:24", "text": "他走了。我本來可以給你示範的。那 真有趣。那裡停著一輛車。"}, {"type": "subtitle", "time": 1473.523, "timestamp": "00:24:33", "text": "哇。那很有意思。哇。他的"}, {"type": "subtitle", "time": 1478.132, "timestamp": "00:24:38", "text": "家人正在等他們。以及他的"}, {"type": "subtitle", "time": 1488.756, "timestamp": "00:24:48", "text": "家人正在等他們。嘿，"}, {"type": "subtitle", "time": 1490.643, "timestamp": "00:24:50", "text": "一家人就待在家裡等他們。"}]
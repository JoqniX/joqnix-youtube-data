[{"type": "subtitle", "time": 4980.005, "timestamp": "01:23:00", "text": "穿著。這就是問題所在。等待。 現在。等等，等等，等等"}, {"type": "subtitle", "time": 4982.721, "timestamp": "01:23:02", "text": "現在。等等，等等，等等 等待。我快到了，我快到了"}, {"type": "subtitle", "time": 4984.898, "timestamp": "01:23:04", "text": "等待。我快到了，我快到了 這輛車。好的。等待。好的。你聽著"}, {"type": "subtitle", "time": 4992.446, "timestamp": "01:23:12", "text": "這輛車。好的。等待。好的。你聽著 是關於那輛車的，對吧？你聽過…"}, {"type": "subtitle", "time": 4996.986, "timestamp": "01:23:16", "text": "是關於那輛車的，對吧？你聽過… 是車吧？好的。我將激活"}, {"type": "subtitle", "time": 5001.244, "timestamp": "01:23:21", "text": "是車吧？好的。我將激活 噪音抑制。是的。就這些嗎？"}, {"type": "subtitle", "time": 5004.927, "timestamp": "01:23:24", "text": "噪音抑制。是的。就這些嗎？ 更好的？你聽得到我嗎？如果有"}, {"type": "subtitle", "time": 5008.577, "timestamp": "01:23:28", "text": "更好的？你聽得到我嗎？如果有 巨響，也許不是我。"}, {"type": "subtitle", "time": 5010.253, "timestamp": "01:23:30", "text": "巨響，也許不是我。 仔細聽。但伴隨著細微的聲音"}, {"type": "subtitle", "time": 5014.442, "timestamp": "01:23:34", "text": "仔細聽。但伴隨著細微的聲音 這樣，你就能聽到我的車聲了。"}, {"type": "subtitle", "time": 5019.274, "timestamp": "01:23:39", "text": "這樣，你就能聽到我的車聲了。 這裡。這就是汽車音響所經歷的過程。"}, {"type": "subtitle", "time": 5027.453, "timestamp": "01:23:47", "text": "是的。目前存在壓制現象"}]
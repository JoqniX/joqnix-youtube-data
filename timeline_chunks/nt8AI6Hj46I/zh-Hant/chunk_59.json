[{"type": "subtitle", "time": 3549.547, "timestamp": "00:59:09", "text": "像這樣的地方，第二個。"}, {"type": "subtitle", "time": 3570.804, "timestamp": "00:59:30", "text": "真是見鬼了。呃，給我30分鐘。"}, {"type": "subtitle", "time": 3577.258, "timestamp": "00:59:37", "text": "好吧，也許我應該就此結束了。"}, {"type": "subtitle", "time": 3579.781, "timestamp": "00:59:39", "text": "我需要趕上進度"}, {"type": "subtitle", "time": 3582.773, "timestamp": "00:59:42", "text": "我的課程，網課。我的"}, {"type": "subtitle", "time": 3584.809, "timestamp": "00:59:44", "text": "我的室友剛寄給我"}, {"type": "subtitle", "time": 3586.689, "timestamp": "00:59:46", "text": "一則訊息，但現在你來了。"}, {"type": "subtitle", "time": 3588.49, "timestamp": "00:59:48", "text": "你需要趕上進度"}, {"type": "subtitle", "time": 3590.63, "timestamp": "00:59:50", "text": "課程。所以我告訴她，你可以看到它們"}, {"type": "subtitle", "time": 3593.477, "timestamp": "00:59:53", "text": "第一的。我會趕上的。啊，"}, {"type": "subtitle", "time": 3595.784, "timestamp": "00:59:55", "text": "是的，回到正題。所以"}, {"type": "subtitle", "time": 3597.574, "timestamp": "00:59:57", "text": "是的，這就是問題的答案。"}]
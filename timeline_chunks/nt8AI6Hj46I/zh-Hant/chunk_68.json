[{"type": "subtitle", "time": 4082.292, "timestamp": "01:08:02", "text": "想著我應該這樣做，想著我想要這樣做"}, {"type": "subtitle", "time": 4084.848, "timestamp": "01:08:04", "text": "與日本當地人交談，"}, {"type": "subtitle", "time": 4087.207, "timestamp": "01:08:07", "text": "這不一樣，我會非常激動。"}, {"type": "subtitle", "time": 4093.728, "timestamp": "01:08:13", "text": "誠實的。好吧。問題是，如果"}, {"type": "subtitle", "time": 4096.009, "timestamp": "01:08:16", "text": "我會接近一個女孩或女人，或者"}, {"type": "subtitle", "time": 4098.349, "timestamp": "01:08:18", "text": "他們在街上可能會這麼想。"}, {"type": "subtitle", "time": 4100.33, "timestamp": "01:08:20", "text": "我懷著不良意圖接近"}, {"type": "subtitle", "time": 4104.631, "timestamp": "01:08:24", "text": "意圖之類的。不，我看到了自己"}, {"type": "subtitle", "time": 4107.919, "timestamp": "01:08:27", "text": "像個孩子一樣。我看起來很年輕，所以"}, {"type": "subtitle", "time": 4111.831, "timestamp": "01:08:31", "text": "好吧。雖然我的年齡，該死的，"}, {"type": "subtitle", "time": 4117.347, "timestamp": "01:08:37", "text": "我的天哪。傷心。沒錯，就是這樣。"}, {"type": "subtitle", "time": 4122.194, "timestamp": "01:08:42", "text": "它也存在。就像你想要的那樣"}, {"type": "subtitle", "time": 4124.275, "timestamp": "01:08:44", "text": "開啟一段美好的對話，但是"}, {"type": "subtitle", "time": 4126.191, "timestamp": "01:08:46", "text": "你可能會被誤解或曲解。"}, {"type": "subtitle", "time": 4129.609, "timestamp": "01:08:49", "text": "換個角度來看。那可真是件了不起的事。"}]
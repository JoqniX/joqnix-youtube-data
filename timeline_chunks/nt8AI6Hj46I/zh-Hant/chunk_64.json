[{"type": "subtitle", "time": 3847.363, "timestamp": "01:04:07", "text": "那。是的。但是，是的，障礙 語言障礙以及不知道該說什麼或如何表達"}, {"type": "subtitle", "time": 3849.865, "timestamp": "01:04:09", "text": "語言障礙以及不知道該說什麼或如何表達 開始對話等等。尋找"}, {"type": "subtitle", "time": 3855.176, "timestamp": "01:04:15", "text": "開始對話等等。尋找 共同利益等等。這非常困難。"}, {"type": "subtitle", "time": 3863.746, "timestamp": "01:04:23", "text": "是的，也許我就是這麼覺得的。"}, {"type": "subtitle", "time": 3865.889, "timestamp": "01:04:25", "text": "我覺得這非常困難。"}, {"type": "subtitle", "time": 3867.921, "timestamp": "01:04:27", "text": "因為他幾乎沒有人手。"}, {"type": "subtitle", "time": 3874.29, "timestamp": "01:04:34", "text": "除了家人以外，我不會跟任何人說話。呃，就像"}, {"type": "subtitle", "time": 3876.665, "timestamp": "01:04:36", "text": "這些年來，你一直在成長。"}, {"type": "subtitle", "time": 3878.554, "timestamp": "01:04:38", "text": "朋友們，然後他們都各自散去了。"}, {"type": "subtitle", "time": 3888.179, "timestamp": "01:04:48", "text": "各不相同，等等。或許這就是原因"}, {"type": "subtitle", "time": 3890.399, "timestamp": "01:04:50", "text": "我見到別人時還是會害羞。"}, {"type": "subtitle", "time": 3892.164, "timestamp": "01:04:52", "text": "並與人交談，我保持"}, {"type": "subtitle", "time": 3894.271, "timestamp": "01:04:54", "text": "與人保持密切聯繫"}, {"type": "subtitle", "time": 3896.435, "timestamp": "01:04:56", "text": "我跟他們說話，認識我的人等等。"}]
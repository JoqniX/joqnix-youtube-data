[{"type": "subtitle", "time": 3480.788, "timestamp": "00:58:00", "text": "內心深處，我感覺…"}, {"type": "subtitle", "time": 3486.909, "timestamp": "00:58:06", "text": "有時候會有些人像這樣"}, {"type": "subtitle", "time": 3491.604, "timestamp": "00:58:11", "text": "反對外國人。有時會有"}, {"type": "subtitle", "time": 3493.726, "timestamp": "00:58:13", "text": "接納外國人的人"}, {"type": "subtitle", "time": 3497.714, "timestamp": "00:58:17", "text": "真的？像東京這樣的地方"}, {"type": "subtitle", "time": 3500.876, "timestamp": "00:58:20", "text": "裡面全是外國人。那些"}, {"type": "subtitle", "time": 3503.333, "timestamp": "00:58:23", "text": "這些地方人們都很討厭。"}, {"type": "subtitle", "time": 3505.855, "timestamp": "00:58:25", "text": "當地人，也就是本地人，會憎恨他們"}, {"type": "subtitle", "time": 3508.312, "timestamp": "00:58:28", "text": "外國人，因為他們厭倦了"}, {"type": "subtitle", "time": 3510.381, "timestamp": "00:58:30", "text": "看到外國人把事情搞砸了…"}, {"type": "subtitle", "time": 3512.903, "timestamp": "00:58:32", "text": "違反規則等等，真的嗎？"}, {"type": "subtitle", "time": 3516.968, "timestamp": "00:58:36", "text": "像這裡這樣的地方"}, {"type": "subtitle", "time": 3519.065, "timestamp": "00:58:39", "text": "外國人太少了，"}, {"type": "subtitle", "time": 3532.569, "timestamp": "00:58:52", "text": "我猜是吧。所以我喝了些水補充水分。"}, {"type": "subtitle", "time": 3534.642, "timestamp": "00:58:54", "text": "飲料，一種補水飲品"}, {"type": "subtitle", "time": 3539.548, "timestamp": "00:58:59", "text": "這片水域，這個公園。所以"}]
[{"type": "subtitle", "time": 3000.275, "timestamp": "00:50:00", "text": "很難區分它們。嗯。難的 區分。所以我真的"}, {"type": "subtitle", "time": 3005.672, "timestamp": "00:50:05", "text": "區分。所以我真的 她一邊看著，一邊告訴她的朋友。"}, {"type": "subtitle", "time": 3008.048, "timestamp": "00:50:08", "text": "她一邊看著，一邊告訴她的朋友。 或對某人說，嗯，可以"}, {"type": "subtitle", "time": 3010.068, "timestamp": "00:50:10", "text": "或對某人說，嗯，可以 我聽到他們說我不明白"}, {"type": "subtitle", "time": 3012.089, "timestamp": "00:50:12", "text": "我聽到他們說我不明白 日本人說話的時候就是這樣。嗯，所以"}, {"type": "subtitle", "time": 3017.418, "timestamp": "00:50:17", "text": "日本人說話的時候就是這樣。嗯，所以 他們說我已經盡力了。"}, {"type": "subtitle", "time": 3019.842, "timestamp": "00:50:19", "text": "他們說我已經盡力了。 我會寫漢字，但不會。"}, {"type": "subtitle", "time": 3022.205, "timestamp": "00:50:22", "text": "我會寫漢字，但不會。 我有能力把所有事情都寫下來等等。"}, {"type": "subtitle", "time": 3029.159, "timestamp": "00:50:29", "text": "我真希望我能幫他。而那個女人"}, {"type": "subtitle", "time": 3031.59, "timestamp": "00:50:31", "text": "我旁邊，我旁邊的女孩說道"}, {"type": "subtitle", "time": 3035.729, "timestamp": "00:50:35", "text": "你需要幫助嗎？我也是： ” 「是的。」我說：「好的，謝謝。」我說，"}, {"type": "subtitle", "time": 3042.292, "timestamp": "00:50:42", "text": "「是的。」我說：「好的，謝謝。」我說， 她幫了我。寫"}, {"type": "subtitle", "time": 3046.06, "timestamp": "00:50:46", "text": "她幫了我。寫 地址等等。所以，就是那件事"}, {"type": "subtitle", "time": 3055.293, "timestamp": "00:50:55", "text": "地址等等。所以，就是那件事 這是必須採取的措施，"}, {"type": "subtitle", "time": 3057.293, "timestamp": "00:50:57", "text": "這是必須採取的措施， 你身處在一個有外國人的環境中"}, {"type": "subtitle", "time": 3059.459, "timestamp": "00:50:59", "text": "你身處在一個有外國人的環境中 很多日本人也是，對吧？而不是"}]
[{"type": "subtitle", "time": 6544.23, "timestamp": "01:49:04", "text": "他們太棒了。是的。怎麼樣了？"}, {"type": "subtitle", "time": 6546.989, "timestamp": "01:49:06", "text": "遠足？嗯，一切進展順利。我們聊了很多。 。我要回家了，而且我遲到了。我的"}, {"type": "subtitle", "time": 6552.474, "timestamp": "01:49:12", "text": "。我要回家了，而且我遲到了。我的 我的室友要罵我了。"}, {"type": "subtitle", "time": 6558.442, "timestamp": "01:49:18", "text": "他要我8點回來，我會的。"}, {"type": "subtitle", "time": 6562.122, "timestamp": "01:49:22", "text": "我9點回來，所以我會待一個小時。"}, {"type": "subtitle", "time": 6564.405, "timestamp": "01:49:24", "text": "雖然晚了點，但沒關係。我會盡快處理的。"}, {"type": "subtitle", "time": 6568.786, "timestamp": "01:49:28", "text": "白天我自己和同學們一起上課"}, {"type": "subtitle", "time": 6575.189, "timestamp": "01:49:35", "text": "我漏掉了一部分。所以我這就走"}, {"type": "subtitle", "time": 6577.507, "timestamp": "01:49:37", "text": "步行回家，吃晚餐什麼的，然後去"}, {"type": "subtitle", "time": 6579.886, "timestamp": "01:49:39", "text": "補眠之後"}, {"type": "subtitle", "time": 6587.184, "timestamp": "01:49:47", "text": "課程和其他一切。是的，就是這樣。"}]
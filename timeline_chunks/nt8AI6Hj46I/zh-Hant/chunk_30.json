[{"type": "subtitle", "time": 1805.698, "timestamp": "00:30:05", "text": "是的。只有罪犯或"}, {"type": "subtitle", "time": 1807.365, "timestamp": "00:30:07", "text": "不想遵循的人"}, {"type": "subtitle", "time": 1811.622, "timestamp": "00:30:11", "text": "規則。只有他們，他們只是"}, {"type": "subtitle", "time": 1818.809, "timestamp": "00:30:18", "text": "彷彿他們會一直熬夜到"}, {"type": "subtitle", "time": 1821.583, "timestamp": "00:30:21", "text": "夜生活午夜12點。哦是的。"}, {"type": "subtitle", "time": 1823.993, "timestamp": "00:30:23", "text": "是的。像東京之類的地方。"}, {"type": "subtitle", "time": 1826.812, "timestamp": "00:30:26", "text": "是的。是的。是的。一切都圍繞著它運轉"}, {"type": "subtitle", "time": 1829.82, "timestamp": "00:30:29", "text": "夜生活等等。是的。是的。 。是的。類似的地方。神的"}, {"type": "subtitle", "time": 1843.76, "timestamp": "00:30:43", "text": "。是的。類似的地方。神的 海鮮。你好，歡迎來到直播間。"}, {"type": "subtitle", "time": 1851.361, "timestamp": "00:30:51", "text": "感謝交流。謝謝"}, {"type": "subtitle", "time": 1855.081, "timestamp": "00:30:55", "text": "交換一下。好吧。你好。"}]
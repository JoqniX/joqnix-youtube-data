[{"type": "subtitle", "time": 5100.079, "timestamp": "01:25:00", "text": "降噪功能。我改變了"}, {"type": "subtitle", "time": 5104.887, "timestamp": "01:25:04", "text": "觀點。什麼？你不想要嗎？這"}, {"type": "subtitle", "time": 5117.576, "timestamp": "01:25:17", "text": "好的。好吧。好吧。但是，"}, {"type": "subtitle", "time": 5119.998, "timestamp": "01:25:19", "text": "我平常很少用嗓子，因為"}, {"type": "subtitle", "time": 5122.42, "timestamp": "01:25:22", "text": "我覺得……有時候我必須說點什麼。"}, {"type": "subtitle", "time": 5124.969, "timestamp": "01:25:24", "text": "差不多……我得這樣說，放"}, {"type": "subtitle", "time": 5127.518, "timestamp": "01:25:27", "text": "電話就在我嘴邊，或者當"}, {"type": "subtitle", "time": 5129.812, "timestamp": "01:25:29", "text": "我說話聲音比較小，別人聽不太懂。"}, {"type": "subtitle", "time": 5136.595, "timestamp": "01:25:36", "text": "差不多就是這樣。所以我認為：“這是…”"}, {"type": "subtitle", "time": 5142.938, "timestamp": "01:25:42", "text": "好的，我會把它完全關掉。是的，"}, {"type": "subtitle", "time": 5147.121, "timestamp": "01:25:47", "text": "降噪功能使其聽起來很悅耳。"}, {"type": "subtitle", "time": 5149.318, "timestamp": "01:25:49", "text": "離開。是的，我沒聽到蟬鳴聲。"}, {"type": "subtitle", "time": 5152.129, "timestamp": "01:25:52", "text": "因為當時正在下雨。不，"}, {"type": "subtitle", "time": 5156.27, "timestamp": "01:25:56", "text": "蟬飛走了。如果我去"}]
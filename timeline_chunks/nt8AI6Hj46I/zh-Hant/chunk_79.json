[{"type": "subtitle", "time": 4744.932, "timestamp": "01:19:04", "text": "可以舉辦這些活動。 要能被聽見。是的，就像轉換一樣"}, {"type": "subtitle", "time": 4752.162, "timestamp": "01:19:12", "text": "要能被聽見。是的，就像轉換一樣 文字轉語音之類的功能。哦，等等"}, {"type": "subtitle", "time": 4754.623, "timestamp": "01:19:14", "text": "文字轉語音之類的功能。哦，等等 。是的。很高興你能來。"}, {"type": "subtitle", "time": 4765.713, "timestamp": "01:19:25", "text": "所以，卡利桑剛才提到了"}, {"type": "subtitle", "time": 4768.093, "timestamp": "01:19:28", "text": "我突然意識到這一點，就像"}, {"type": "subtitle", "time": 4770.409, "timestamp": "01:19:30", "text": "通常情況下，當某人"}, {"type": "subtitle", "time": 4772.601, "timestamp": "01:19:32", "text": "串流媒體，呃，當你看到"}, {"type": "subtitle", "time": 4775.043, "timestamp": "01:19:35", "text": "主播們，他們有轉換率"}, {"type": "subtitle", "time": 4777.422, "timestamp": "01:19:37", "text": "文字轉語音之類的功能，以及相關的提醒"}, {"type": "subtitle", "time": 4779.802, "timestamp": "01:19:39", "text": "透過電話可以聽到他們的聲音。"}, {"type": "subtitle", "time": 4785.802, "timestamp": "01:19:45", "text": "所以如果有人跟別人交易某樣東西"}, {"type": "subtitle", "time": 4787.85, "timestamp": "01:19:47", "text": "來自 Twitch 頻道的積分，或者如果"}, {"type": "subtitle", "time": 4790.332, "timestamp": "01:19:50", "text": "有人關注、訂閱或發送訊息嗎？"}, {"type": "subtitle", "time": 4792.813, "timestamp": "01:19:52", "text": "捐款，我沒有辦法收到嗎？"}, {"type": "subtitle", "time": 4795.295, "timestamp": "01:19:55", "text": "聲音通知，即"}, {"type": "subtitle", "time": 4799.265, "timestamp": "01:19:59", "text": "是聲音警報嗎？眼下"}]
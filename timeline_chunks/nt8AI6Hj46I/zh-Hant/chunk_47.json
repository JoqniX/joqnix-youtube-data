[{"type": "subtitle", "time": 2820.687, "timestamp": "00:47:00", "text": "遲到了，好吧，然後開始喋喋不休。"}, {"type": "subtitle", "time": 2825.586, "timestamp": "00:47:05", "text": "我只是去趟洗手間就被他大吼大叫。"}, {"type": "subtitle", "time": 2833.013, "timestamp": "00:47:13", "text": "或許他很在乎你，就好像…"}, {"type": "subtitle", "time": 2839.114, "timestamp": "00:47:19", "text": "情況確實如此。嗯。通常情況下"}, {"type": "subtitle", "time": 2841.326, "timestamp": "00:47:21", "text": "你說“哦哈約”，他們，他們應該"}, {"type": "subtitle", "time": 2846.998, "timestamp": "00:47:26", "text": "回答「哦哈約」之類的問題。是的。和"}, {"type": "subtitle", "time": 2849.477, "timestamp": "00:47:29", "text": "你好，阿拉。歡迎。歡迎。 ？ 你好嗎？我很好。僅有的"}, {"type": "subtitle", "time": 2851.188, "timestamp": "00:47:31", "text": "你好嗎？我很好。僅有的 步行。馬上就要下雨了…現在下雨了"}, {"type": "subtitle", "time": 2853.139, "timestamp": "00:47:33", "text": "步行。馬上就要下雨了…現在下雨了 相同的。我沒有傘。嗯，是的。嗯。"}, {"type": "subtitle", "time": 2872.728, "timestamp": "00:47:52", "text": "回到正題。嗯。問題在於…"}, {"type": "subtitle", "time": 2875.163, "timestamp": "00:47:55", "text": "我想知道，我真的想知道。"}, {"type": "subtitle", "time": 2877.327, "timestamp": "00:47:57", "text": "與日本青少年見面，"}, {"type": "subtitle", "time": 2879.964, "timestamp": "00:47:59", "text": "與年輕人、成年人交談"}]
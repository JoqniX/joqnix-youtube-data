[{"type": "subtitle", "time": 3122.792, "timestamp": "00:52:02", "text": "你解釋得很好。是的，大部分 人們只是照顧好自己"}, {"type": "subtitle", "time": 3124.488, "timestamp": "00:52:04", "text": "人們只是照顧好自己 擁有自己的事業等等。那是日本。"}, {"type": "subtitle", "time": 3129.652, "timestamp": "00:52:09", "text": "人們都管好自己的事。"}, {"type": "subtitle", "time": 3138.313, "timestamp": "00:52:18", "text": "是的。除非，除非你問他們"}, {"type": "subtitle", "time": 3141.094, "timestamp": "00:52:21", "text": "援助。所以，所以，所以"}, {"type": "subtitle", "time": 3145.391, "timestamp": "00:52:25", "text": "同時，如果我接近一個"}, {"type": "subtitle", "time": 3147.304, "timestamp": "00:52:27", "text": "我隨意地問了他"}, {"type": "subtitle", "time": 3149.856, "timestamp": "00:52:29", "text": "是的，方向等等都在裡面"}, {"type": "subtitle", "time": 3151.897, "timestamp": "00:52:31", "text": "他們的東西，我向他們求助，還有我"}, {"type": "subtitle", "time": 3157.575, "timestamp": "00:52:37", "text": "他們會幫忙的。這種情況時有發生。是的。但還有另一個"}, {"type": "subtitle", "time": 3159.666, "timestamp": "00:52:39", "text": "例如，我談到了校園。"}, {"type": "subtitle", "time": 3164.124, "timestamp": "00:52:44", "text": "開著吧？我上過那所學校"}, {"type": "subtitle", "time": 3169.099, "timestamp": "00:52:49", "text": "開放校園活動舉辦15次。每個"}, {"type": "subtitle", "time": 3171.493, "timestamp": "00:52:51", "text": "每當我有多餘的錢時，我都會去旅行。"}, {"type": "subtitle", "time": 3173.827, "timestamp": "00:52:53", "text": "東京將參加校園活動"}, {"type": "subtitle", "time": 3176.161, "timestamp": "00:52:56", "text": "因為我熱愛音樂而開放"}]
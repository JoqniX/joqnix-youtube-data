[{"type": "subtitle", "time": 5522.687, "timestamp": "01:32:02", "text": "評論。我聽到一個聲音。噴口 它目前還沒有應用程式。"}, {"type": "subtitle", "time": 5524.382, "timestamp": "01:32:04", "text": "它目前還沒有應用程式。 補充。是的。是的。是的。所以"}, {"type": "subtitle", "time": 5531.438, "timestamp": "01:32:11", "text": "我認為你的想法是，呃，做…"}, {"type": "subtitle", "time": 5534.109, "timestamp": "01:32:14", "text": "從你的手機串流並發送"}, {"type": "subtitle", "time": 5536.643, "timestamp": "01:32:16", "text": "透過 Spout 發送訊號，然後，呃，另一個"}, {"type": "subtitle", "time": 5539.315, "timestamp": "01:32:19", "text": "手機或 OBS 可以接收那個，呃，"}, {"type": "subtitle", "time": 5541.712, "timestamp": "01:32:21", "text": "透過工具發出訊號"}, {"type": "subtitle", "time": 5544.758, "timestamp": "01:32:24", "text": "補充。真的？所以你"}, {"type": "subtitle", "time": 5546.631, "timestamp": "01:32:26", "text": "主傳輸編碼器"}, {"type": "subtitle", "time": 5548.504, "timestamp": "01:32:28", "text": "這是你的手機，你仍然可以添加內容"}, {"type": "subtitle", "time": 5553.188, "timestamp": "01:32:33", "text": "呃，電腦裡的東西等等。真的嗎？"}, {"type": "subtitle", "time": 5557.267, "timestamp": "01:32:37", "text": "這與NDI類似。所以有"}, {"type": "subtitle", "time": 5564.937, "timestamp": "01:32:44", "text": "很多事情。但說實話，"}, {"type": "subtitle", "time": 5567.364, "timestamp": "01:32:47", "text": "各位，我的意思是，我必須給予…"}, {"type": "subtitle", "time": 5572.349, "timestamp": "01:32:52", "text": "感謝 Ursan，呃，嗯，例如，"}, {"type": "subtitle", "time": 5576.145, "timestamp": "01:32:56", "text": "感謝 Uricin 提交此申請。是的"}, {"type": "subtitle", "time": 5578.227, "timestamp": "01:32:58", "text": "他不會告訴我“我做了…”"}]
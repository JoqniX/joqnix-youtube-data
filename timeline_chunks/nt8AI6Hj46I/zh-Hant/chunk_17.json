[{"type": "subtitle", "time": 1022.879, "timestamp": "00:17:02", "text": "好像我必須解釋它是什麼似的。"}, {"type": "subtitle", "time": 1030.319, "timestamp": "00:17:10", "text": "更確切地說，我根本不在乎。"}, {"type": "subtitle", "time": 1032.784, "timestamp": "00:17:12", "text": "就像你想做自己喜歡的事一樣"}, {"type": "subtitle", "time": 1034.87, "timestamp": "00:17:14", "text": "如此迫切地"}, {"type": "subtitle", "time": 1037.335, "timestamp": "00:17:17", "text": "履行你的職責"}, {"type": "subtitle", "time": 1039.801, "timestamp": "00:17:19", "text": "工作、學習等等。你回到家，"}, {"type": "subtitle", "time": 1042.266, "timestamp": "00:17:22", "text": "你想做你的嗜好，但是你…"}, {"type": "subtitle", "time": 1044.605, "timestamp": "00:17:24", "text": "需要承擔更多責任，"}, {"type": "subtitle", "time": 1052.352, "timestamp": "00:17:32", "text": "然後你會說，哦，天哪，已經12點了。"}, {"type": "subtitle", "time": 1057.94, "timestamp": "00:17:37", "text": "是。根本沒有時間真正"}, {"type": "subtitle", "time": 1059.837, "timestamp": "00:17:39", "text": "犧牲你的夢想，去做你該做的事"}, {"type": "subtitle", "time": 1064.094, "timestamp": "00:17:44", "text": "消遣1小時。但時間"}, {"type": "subtitle", "time": 1067.626, "timestamp": "00:17:47", "text": "他飛得跟沒事人一樣。時光飛逝"}, {"type": "subtitle", "time": 1071.524, "timestamp": "00:17:51", "text": "太多了。這不禁讓人思考，為什麼？"}, {"type": "subtitle", "time": 1073.49, "timestamp": "00:17:53", "text": "當你……的時候，時間不會過得很快。"}, {"type": "subtitle", "time": 1077.378, "timestamp": "00:17:57", "text": "在學校還是在工作場所？為什麼？"}, {"type": "subtitle", "time": 1079.412, "timestamp": "00:17:59", "text": "時間在事物中流逝得如此緩慢…"}]
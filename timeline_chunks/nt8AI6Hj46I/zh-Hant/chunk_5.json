[{"type": "subtitle", "time": 300.331, "timestamp": "00:05:00", "text": "位於前面。你已經證明了。我做到了。"}, {"type": "subtitle", "time": 305.49, "timestamp": "00:05:05", "text": "我的意思是，如果你已經看過的話。你好嗎"}, {"type": "subtitle", "time": 307.867, "timestamp": "00:05:07", "text": "日本？你想家嗎？仍然"}, {"type": "subtitle", "time": 311.102, "timestamp": "00:05:11", "text": "我感覺自己不像在日本。我不知道"}, {"type": "subtitle", "time": 314.17, "timestamp": "00:05:14", "text": "在哪裡。我仍然感覺自己不在狀態。"}, {"type": "subtitle", "time": 316.738, "timestamp": "00:05:16", "text": "日本。說實話，我覺得我"}, {"type": "subtitle", "time": 321.078, "timestamp": "00:05:21", "text": "旅行。是的，就是這裡。"}, {"type": "subtitle", "time": 324.385, "timestamp": "00:05:24", "text": "直的。就是那個公園。公園"}, {"type": "subtitle", "time": 328.038, "timestamp": "00:05:28", "text": "大的。我今天不去公園。僅有的"}, {"type": "subtitle", "time": 330.444, "timestamp": "00:05:30", "text": "我今天打算出去散步。我只是想"}, {"type": "subtitle", "time": 333.858, "timestamp": "00:05:33", "text": "外部。你在哪裡？我只是"}, {"type": "subtitle", "time": 337.984, "timestamp": "00:05:37", "text": "現在正在行走。我正要進去。那裡有"}, {"type": "subtitle", "time": 340.028, "timestamp": "00:05:40", "text": "蚊子很多。這到底是怎麼回事？"}, {"type": "subtitle", "time": 342.192, "timestamp": "00:05:42", "text": "日本有蚊子。你知道嗎？"}, {"type": "subtitle", "time": 346.265, "timestamp": "00:05:46", "text": "這種情況並非只發生在印度。我以為我"}, {"type": "subtitle", "time": 348.193, "timestamp": "00:05:48", "text": "可以解決蚊子問題"}, {"type": "subtitle", "time": 352.007, "timestamp": "00:05:52", "text": "從印度來到另一個國家。但"}, {"type": "subtitle", "time": 355.731, "timestamp": "00:05:55", "text": "夏天簡直是惡夢。太多了。"}]
[{"type": "subtitle", "time": 1625.429, "timestamp": "00:27:05", "text": "太棒了，獨一無二的機器人。但"}, {"type": "subtitle", "time": 1627.542, "timestamp": "00:27:07", "text": "因為很多人都在用，所以，是的。"}, {"type": "subtitle", "time": 1632.827, "timestamp": "00:27:12", "text": "各項活動和事務將延期，"}, {"type": "subtitle", "time": 1636.392, "timestamp": "00:27:16", "text": "這需要時間，但讓我們抱持最好的希望。是"}, {"type": "subtitle", "time": 1639.09, "timestamp": "00:27:19", "text": "市面上比較好的一款。我希望"}, {"type": "subtitle", "time": 1642.163, "timestamp": "00:27:22", "text": "別搞砸了。好了，我們走吧。"}, {"type": "subtitle", "time": 1646.277, "timestamp": "00:27:26", "text": "我們離開這個公園吧。等待， 出口在哪裡？哦，只有一個。"}, {"type": "subtitle", "time": 1650.06, "timestamp": "00:27:30", "text": "出口在哪裡？哦，只有一個。 出口。哦，找到了。出口。"}, {"type": "subtitle", "time": 1655.236, "timestamp": "00:27:35", "text": "出口。哦，找到了。出口。 好吧。我只是在這裡走走。"}, {"type": "subtitle", "time": 1669.695, "timestamp": "00:27:49", "text": "我甚至不知道自己身在何處。說，"}, {"type": "subtitle", "time": 1672.874, "timestamp": "00:27:52", "text": "我大概知道。哦，我是"}, {"type": "subtitle", "time": 1679.031, "timestamp": "00:27:59", "text": "這裡。好的。我只是四處走走。"}]
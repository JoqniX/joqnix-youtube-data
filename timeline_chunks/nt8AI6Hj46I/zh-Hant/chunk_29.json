[{"type": "subtitle", "time": 1741.632, "timestamp": "00:29:01", "text": "已關閉。燈關了。"}, {"type": "subtitle", "time": 1744.785, "timestamp": "00:29:04", "text": "好的，那棟房子有電了。好了，就這些。"}, {"type": "subtitle", "time": 1749.749, "timestamp": "00:29:09", "text": "一個。這是其中之一。就一個。好的，就是那個。"}, {"type": "subtitle", "time": 1752.166, "timestamp": "00:29:12", "text": "我家對面那棟房子有小燈。"}, {"type": "subtitle", "time": 1754.645, "timestamp": "00:29:14", "text": "樓下，一樓。"}, {"type": "subtitle", "time": 1758.481, "timestamp": "00:29:18", "text": "這是一間公寓，所以沒有"}, {"type": "subtitle", "time": 1764.198, "timestamp": "00:29:24", "text": "這很重要。這裡好安靜。是 大家都在等嗎？他們回到家，"}, {"type": "subtitle", "time": 1766.99, "timestamp": "00:29:26", "text": "大家都在等嗎？他們回到家， 他們吃點東西，睡著，然後…"}, {"type": "subtitle", "time": 1769.237, "timestamp": "00:29:29", "text": "他們吃點東西，睡著，然後… 他們大約凌晨3點或4點醒來。"}, {"type": "subtitle", "time": 1771.894, "timestamp": "00:29:31", "text": "他們大約凌晨3點或4點醒來。 是。開始工作。是這樣嗎？"}, {"type": "subtitle", "time": 1776.43, "timestamp": "00:29:36", "text": "是。開始工作。是這樣嗎？ 文化？我覺得這讓你"}, {"type": "subtitle", "time": 1779.556, "timestamp": "00:29:39", "text": "文化？我覺得這讓你 現在提出質疑。我希望我能"}, {"type": "subtitle", "time": 1783.165, "timestamp": "00:29:43", "text": "現在提出質疑。我希望我能 問別人這個問題"}, {"type": "subtitle", "time": 1784.8220000000001, "timestamp": "00:29:44", "text": "問別人這個問題 日本人。那很有意思。如果這事發生在我身上"}, {"type": "subtitle", "time": 1789.166, "timestamp": "00:29:49", "text": "日本人。那很有意思。如果這事發生在我身上 你問我問題。真的，真的"}, {"type": "subtitle", "time": 1792.701, "timestamp": "00:29:52", "text": "你問我問題。真的，真的 說實話，挺有意思的。"}]
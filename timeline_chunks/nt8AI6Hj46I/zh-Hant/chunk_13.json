[{"type": "subtitle", "time": 790.079, "timestamp": "00:13:10", "text": "兄弟，我到這裡了嗎？等等，怎麼會這樣"}, {"type": "subtitle", "time": 793.962, "timestamp": "00:13:13", "text": "我到了這裡？我不是越界了嗎？"}, {"type": "subtitle", "time": 796.236, "timestamp": "00:13:16", "text": "街道、主要街道等等 ？哦，是的，我做了。嘿。哦好的。"}, {"type": "subtitle", "time": 802.735, "timestamp": "00:13:22", "text": "？哦，是的，我做了。嘿。哦好的。 我們可以走這條路。快點。今天。僅有的"}, {"type": "subtitle", "time": 806.488, "timestamp": "00:13:26", "text": "我們可以走這條路。快點。今天。僅有的 我在走路。我在走路。我是"}, {"type": "subtitle", "time": 808.765, "timestamp": "00:13:28", "text": "我在走路。我在走路。我是 步行。我們真的到達這裡了。"}, {"type": "subtitle", "time": 815.853, "timestamp": "00:13:35", "text": "我認識這個地方。忘了它。"}, {"type": "subtitle", "time": 819.079, "timestamp": "00:13:39", "text": "忘了它。忘了它。等待。是嗎？"}, {"type": "subtitle", "time": 823.095, "timestamp": "00:13:43", "text": "相同的？呃，等等。看起來有點"}, {"type": "subtitle", "time": 826.296, "timestamp": "00:13:46", "text": "不同的。啊，原來是同一個地方。"}, {"type": "subtitle", "time": 829.189, "timestamp": "00:13:49", "text": "哦是的。哦是的。是的。這是"}, {"type": "subtitle", "time": 831.965, "timestamp": "00:13:51", "text": "學校之類的。哦是的。哦是的。"}, {"type": "subtitle", "time": 834.929, "timestamp": "00:13:54", "text": "是的。是的。是的。我在這裡待的時間更長"}, {"type": "subtitle", "time": 839.067, "timestamp": "00:13:59", "text": "今天放學後很早就開始了。在"}]
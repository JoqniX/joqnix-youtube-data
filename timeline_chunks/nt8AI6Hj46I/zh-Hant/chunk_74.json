[{"type": "subtitle", "time": 4443.461, "timestamp": "01:14:03", "text": "睡覺。所以，是的，我得走了。"}, {"type": "subtitle", "time": 4452.522, "timestamp": "01:14:12", "text": "我上課沒跟上進度。所以如果"}, {"type": "subtitle", "time": 4454.595, "timestamp": "01:14:14", "text": "如果我用日語說，他們就會明白。"}, {"type": "subtitle", "time": 4459.536, "timestamp": "01:14:19", "text": "我正在直播。如果……如果"}, {"type": "subtitle", "time": 4461.868, "timestamp": "01:14:21", "text": "工作人員，就是剛才接待我的那位。"}, {"type": "subtitle", "time": 4464.46, "timestamp": "01:14:24", "text": "此刻，當你經過時，會受到歡迎。"}, {"type": "subtitle", "time": 4466.533, "timestamp": "01:14:26", "text": "他，如果我當時那樣說的話"}, {"type": "subtitle", "time": 4468.801, "timestamp": "01:14:28", "text": "他會想，日本人啊：“哦，這…”"}, {"type": "subtitle", "time": 4482.859, "timestamp": "01:14:42", "text": "「此人正在傳播病毒。」是的，"}]
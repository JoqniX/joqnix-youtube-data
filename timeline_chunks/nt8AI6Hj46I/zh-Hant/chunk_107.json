[{"type": "subtitle", "time": 6420.679, "timestamp": "01:47:00", "text": "也聽聽這個。哇。好的。你呢 我們回家吧。是的，我要去"}, {"type": "subtitle", "time": 6427.895, "timestamp": "01:47:07", "text": "我們回家吧。是的，我要去 9點整準時結束。所以"}, {"type": "subtitle", "time": 6432.014, "timestamp": "01:47:12", "text": "9點整準時結束。所以 我會走回家。好的，"}, {"type": "subtitle", "time": 6443.616, "timestamp": "01:47:23", "text": "結果我話很多。我沒想到"}, {"type": "subtitle", "time": 6449.16, "timestamp": "01:47:29", "text": "說實話，今天話真多。我我"}, {"type": "subtitle", "time": 6453.638, "timestamp": "01:47:33", "text": "我很好。我想保持"}, {"type": "subtitle", "time": 6456.653, "timestamp": "01:47:36", "text": "短途傳輸。就像在"}, {"type": "subtitle", "time": 6458.388, "timestamp": "01:47:38", "text": "我只是想表達一點。"}, {"type": "subtitle", "time": 6465.027, "timestamp": "01:47:45", "text": "隨著時間的推移，我達到了那個目標。呃，那"}, {"type": "subtitle", "time": 6467.426, "timestamp": "01:47:47", "text": "我說：“好吧，我會繼續下去，因為…”"}, {"type": "subtitle", "time": 6469.446, "timestamp": "01:47:49", "text": "我喜歡聊天之類的。"}, {"type": "subtitle", "time": 6474.83, "timestamp": "01:47:54", "text": "那些能看見我、聽見我的人，"}, {"type": "subtitle", "time": 6477.266, "timestamp": "01:47:57", "text": "聽我說，嗯，我會為他們做的。"}]
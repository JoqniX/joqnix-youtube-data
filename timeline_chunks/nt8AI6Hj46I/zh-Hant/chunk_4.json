[{"type": "subtitle", "time": 250.622, "timestamp": "00:04:10", "text": "這就是我們來這裡的原因。我剛開始"}, {"type": "subtitle", "time": 261.395, "timestamp": "00:04:21", "text": "走啊走，我這是在哪裡？ 你能看到嗎？你好。午安."}, {"type": "subtitle", "time": 278.305, "timestamp": "00:04:38", "text": "晚安。你好嗎？我是"}, {"type": "subtitle", "time": 282.839, "timestamp": "00:04:42", "text": "好的。我很好。嗯，我做不到"}, {"type": "subtitle", "time": 285.177, "timestamp": "00:04:45", "text": "直接在桌面上，所以我是"}, {"type": "subtitle", "time": 288.728, "timestamp": "00:04:48", "text": "外部。我考慮過直播"}, {"type": "subtitle", "time": 294.606, "timestamp": "00:04:54", "text": "戶外。你已經證明了。我在那裡看到了他。"}, {"type": "subtitle", "time": 298.016, "timestamp": "00:04:58", "text": "以下。我剛才已經展示過了。我見過這種情況。"}]
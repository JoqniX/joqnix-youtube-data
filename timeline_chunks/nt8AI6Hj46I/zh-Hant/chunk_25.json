[{"type": "subtitle", "time": 1502.186, "timestamp": "00:25:02", "text": "車。他……知道……我的意思是，是的，"}, {"type": "subtitle", "time": 1504.831, "timestamp": "00:25:04", "text": "他們是小孩子，所以，是的，因為"}, {"type": "subtitle", "time": 1507.343, "timestamp": "00:25:07", "text": "當然，他們必須…是的，密切注意…"}, {"type": "subtitle", "time": 1511.749, "timestamp": "00:25:11", "text": "他們的孩子。是的，就是這樣……那件事發生在"}, {"type": "subtitle", "time": 1518.034, "timestamp": "00:25:18", "text": "某處。好的。但為什麼"}, {"type": "subtitle", "time": 1522.245, "timestamp": "00:25:22", "text": "到多晚？是嗎？就像"}, {"type": "subtitle", "time": 1524.677, "timestamp": "00:25:24", "text": "主要的，次要的，不，不是"}, {"type": "subtitle", "time": 1527.457, "timestamp": "00:25:27", "text": "國中學生、小學生、孩子們 他們不應該那樣回家。"}, {"type": "subtitle", "time": 1530.237, "timestamp": "00:25:30", "text": "他們不應該那樣回家。 晚上7點30分嘿？上次"}, {"type": "subtitle", "time": 1536.639, "timestamp": "00:25:36", "text": "晚上7點30分嘿？上次 據我所知，學校大約在…結束。"}, {"type": "subtitle", "time": 1539.42, "timestamp": "00:25:39", "text": "據我所知，學校大約在…結束。 下午三、四點，對吧？大概十點吧。"}, {"type": "subtitle", "time": 1542.252, "timestamp": "00:25:42", "text": "下午三、四點，對吧？大概十點吧。 誰知道呢？或一些額外的俱樂部或"}, {"type": "subtitle", "time": 1545.969, "timestamp": "00:25:45", "text": "誰知道呢？或一些額外的俱樂部或 差不多就是這樣。但那是來自…"}, {"type": "subtitle", "time": 1548.21, "timestamp": "00:25:48", "text": "差不多就是這樣。但那是來自… 中學及以後。是的。這是正確的。"}, {"type": "subtitle", "time": 1550.949, "timestamp": "00:25:50", "text": "中學及以後。是的。這是正確的。 你好，太陽能。歡迎。對，就是這樣。"}, {"type": "subtitle", "time": 1555.44, "timestamp": "00:25:55", "text": "你好，太陽能。歡迎。對，就是這樣。 從高中開始，對吧？上帝"}, {"type": "subtitle", "time": 1558.18, "timestamp": "00:25:58", "text": "從高中開始，對吧？上帝 他會知道的。是的，有學生"}]
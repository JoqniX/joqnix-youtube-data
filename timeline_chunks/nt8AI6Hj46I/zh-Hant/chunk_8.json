[{"type": "subtitle", "time": 481.438, "timestamp": "00:08:01", "text": "合作是因為我不知道何時"}, {"type": "subtitle", "time": 483.496, "timestamp": "00:08:03", "text": "那是花火會，一個節日"}, {"type": "subtitle", "time": 488.081, "timestamp": "00:08:08", "text": "煙火.是的，是第八個"}, {"type": "subtitle", "time": 492.146, "timestamp": "00:08:12", "text": "八月。這次大概是六點左右。"}, {"type": "subtitle", "time": 494.662, "timestamp": "00:08:14", "text": "時間到了，對吧？大約在這個時候，"}, {"type": "subtitle", "time": 496.55, "timestamp": "00:08:16", "text": "我將展示部署過程"}, {"type": "subtitle", "time": 499.637, "timestamp": "00:08:19", "text": "8月8日燃放煙火。那"}, {"type": "subtitle", "time": 503.124, "timestamp": "00:08:23", "text": "今天是星期六。是的，8月8日。"}, {"type": "subtitle", "time": 506.625, "timestamp": "00:08:26", "text": "週六。就在那時，我的"}, {"type": "subtitle", "time": 508.387, "timestamp": "00:08:28", "text": "暑假一週。"}, {"type": "subtitle", "time": 512.718, "timestamp": "00:08:32", "text": "僅僅一周。所以我會像這樣"}, {"type": "subtitle", "time": 516.372, "timestamp": "00:08:36", "text": "用視訊部落格記錄下來。我將"}, {"type": "subtitle", "time": 519.268, "timestamp": "00:08:39", "text": "像這樣用視訊部落格的形式記錄下來。像這樣。"}, {"type": "subtitle", "time": 525.919, "timestamp": "00:08:45", "text": "非常好。我會這樣錄下來。"}, {"type": "subtitle", "time": 527.695, "timestamp": "00:08:47", "text": "跟你說話是為了讓你能夠"}, {"type": "subtitle", "time": 533.733, "timestamp": "00:08:53", "text": "看看吧，一切都看在眼裡。清除。展示。這是"}, {"type": "subtitle", "time": 535.797, "timestamp": "00:08:55", "text": "真好。我只是在走路而已。"}]
[{"type": "subtitle", "time": 3184.833, "timestamp": "00:53:04", "text": "吃吃喝喝什麼的，對吧？所以，每個"}, {"type": "subtitle", "time": 3186.938, "timestamp": "00:53:06", "text": "每次我去那家咖啡店，"}, {"type": "subtitle", "time": 3188.868, "timestamp": "00:53:08", "text": "候車區有很多"}, {"type": "subtitle", "time": 3190.914, "timestamp": "00:53:10", "text": "所有日本學生"}, {"type": "subtitle", "time": 3193.078, "timestamp": "00:53:13", "text": "座位都滿了，只有我的桌子是空的。"}, {"type": "subtitle", "time": 3198.903, "timestamp": "00:53:18", "text": "沒人願意坐在我旁邊，因為"}, {"type": "subtitle", "time": 3204.275, "timestamp": "00:53:24", "text": "可以說。沒人想說話"}, {"type": "subtitle", "time": 3206.671, "timestamp": "00:53:26", "text": "和我在一起，連成員們也不例外"}, {"type": "subtitle", "time": 3208.941, "timestamp": "00:53:28", "text": "個人的，除非，嗯，這是你的。"}, {"type": "subtitle", "time": 3211.274, "timestamp": "00:53:31", "text": "您必須確保已填寫完畢。"}, {"type": "subtitle", "time": 3213.797, "timestamp": "00:53:33", "text": "所有表格以及其他一切。"}, {"type": "subtitle", "time": 3221.661, "timestamp": "00:53:41", "text": "只有在這種情況下他們才會來，而且，嗯，"}, {"type": "subtitle", "time": 3223.788, "timestamp": "00:53:43", "text": "他們跟我說話，也許是某些人"}, {"type": "subtitle", "time": 3226.367, "timestamp": "00:53:46", "text": "好奇的員工想要"}, {"type": "subtitle", "time": 3228.494, "timestamp": "00:53:48", "text": "與外國人交談是自然而然的事。"}, {"type": "subtitle", "time": 3231.009, "timestamp": "00:53:51", "text": "問問我過得怎麼樣，或是問我什麼事"}, {"type": "subtitle", "time": 3237.741, "timestamp": "00:53:57", "text": "印度之類的。還有學生，"}, {"type": "subtitle", "time": 3239.443, "timestamp": "00:53:59", "text": "日本學生，或來自"}]
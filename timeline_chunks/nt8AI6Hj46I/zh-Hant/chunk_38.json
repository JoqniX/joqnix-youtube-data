[{"type": "subtitle", "time": 2281.957, "timestamp": "00:38:01", "text": "目前沒什麼特別的。好的。呃，有什麼事嗎…？ 這是絨毛玩具還是人的頭顱？"}, {"type": "subtitle", "time": 2288.316, "timestamp": "00:38:08", "text": "告訴我這是人的頭還是…"}, {"type": "subtitle", "time": 2295.201, "timestamp": "00:38:15", "text": "泰迪熊。好的。你看到了嗎？你看到了嗎？ 你看到了嗎？那是某人的頭嗎？或者"}, {"type": "subtitle", "time": 2298.477, "timestamp": "00:38:18", "text": "你看到了嗎？那是某人的頭嗎？或者 這是絨毛玩具嗎？搞什麼鬼？什麼"}, {"type": "subtitle", "time": 2301.548, "timestamp": "00:38:21", "text": "這是絨毛玩具嗎？搞什麼鬼？什麼 那到底是什麼東西？"}, {"type": "subtitle", "time": 2310.962, "timestamp": "00:38:30", "text": "那到底是什麼東西？我勒個去"}, {"type": "subtitle", "time": 2314.452, "timestamp": "00:38:34", "text": "就這些嗎？而那道光就像…"}, {"type": "subtitle", "time": 2318.128, "timestamp": "00:38:38", "text": "可怕的瘋狂。誰放了一個"}, {"type": "subtitle", "time": 2320.266, "timestamp": "00:38:40", "text": "藍光，就像你身處…"}, {"type": "subtitle", "time": 2322.656, "timestamp": "00:38:42", "text": "精神病院，是的，好像…"}, {"type": "subtitle", "time": 2324.857, "timestamp": "00:38:44", "text": "你玩過《生化危機》之類的遊戲嗎？"}, {"type": "subtitle", "time": 2327.372, "timestamp": "00:38:47", "text": "醫院燈光是藍色的"}, {"type": "subtitle", "time": 2331.051, "timestamp": "00:38:51", "text": "那又怎樣，兄弟？那是什麼？那是什麼？"}, {"type": "subtitle", "time": 2335.074, "timestamp": "00:38:55", "text": "兄弟，那是什麼？那是什麼？哦，上帝"}, {"type": "subtitle", "time": 2337.896, "timestamp": "00:38:57", "text": "礦。確實很可怕。夜幕降臨了。"}]
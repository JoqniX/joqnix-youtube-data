[{"type": "subtitle", "time": 1681.561, "timestamp": "00:28:01", "text": "探索街區、房屋和街道"}, {"type": "subtitle", "time": 1685.932, "timestamp": "00:28:05", "text": "自言自語。比如什麼"}, {"type": "subtitle", "time": 1692.335, "timestamp": "00:28:12", "text": "我注意到了一些事情。好吧。許多房屋"}, {"type": "subtitle", "time": 1694.397, "timestamp": "00:28:14", "text": "日本人非常安靜。"}, {"type": "subtitle", "time": 1696.696, "timestamp": "00:28:16", "text": "晚上7點開始好像他們的"}, {"type": "subtitle", "time": 1703.901, "timestamp": "00:28:23", "text": "房子裡沒有燈。每個人都"}, {"type": "subtitle", "time": 1706.044, "timestamp": "00:28:26", "text": "睡著了或什麼事，或根本沒人。"}, {"type": "subtitle", "time": 1711.431, "timestamp": "00:28:31", "text": "為什麼房子裡這麼安靜？"}, {"type": "subtitle", "time": 1713.734, "timestamp": "00:28:33", "text": "等等，你的意思是…？"}, {"type": "subtitle", "time": 1723.174, "timestamp": "00:28:43", "text": "這是一些房子。沒有燈光。沒有"}, {"type": "subtitle", "time": 1726.358, "timestamp": "00:28:46", "text": "燈。公寓裡有燈。"}, {"type": "subtitle", "time": 1728.22, "timestamp": "00:28:48", "text": "因為它們有外部照明燈。"}, {"type": "subtitle", "time": 1735.245, "timestamp": "00:28:55", "text": "是的。但我經歷太多了。"}, {"type": "subtitle", "time": 1737.801, "timestamp": "00:28:57", "text": "房屋。那邊那棟房子是"}, {"type": "subtitle", "time": 1739.568, "timestamp": "00:28:59", "text": "完全地。燈光是"}]
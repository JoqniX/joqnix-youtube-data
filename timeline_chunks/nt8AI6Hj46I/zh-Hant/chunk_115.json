[{"type": "subtitle", "time": 6904.805, "timestamp": "01:55:04", "text": "Solar，謝謝你的光臨。哈馬利桑，"}, {"type": "subtitle", "time": 6908.872, "timestamp": "01:55:08", "text": "謝謝你們的光臨。您好，就這些。"}, {"type": "subtitle", "time": 6913.624, "timestamp": "01:55:13", "text": "感謝今天到場的各位。"}, {"type": "subtitle", "time": 6918.311, "timestamp": "01:55:18", "text": "我的變速箱。這意義重大，來自"}, {"type": "subtitle", "time": 6937.641, "timestamp": "01:55:37", "text": "真的。你回到語音聊天"}, {"type": "subtitle", "time": 6942.431, "timestamp": "01:55:42", "text": "在那之後。好吧。能"}, {"type": "subtitle", "time": 6953.918, "timestamp": "01:55:53", "text": "做一段時間。所以，謝謝。"}]
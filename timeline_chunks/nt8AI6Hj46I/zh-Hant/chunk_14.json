[{"type": "subtitle", "time": 841.366, "timestamp": "00:14:01", "text": "學校，我只是想…我在這裡"}, {"type": "subtitle", "time": 845.553, "timestamp": "00:14:05", "text": "只是想和 Tomachikun 聊天"}, {"type": "subtitle", "time": 851.057, "timestamp": "00:14:11", "text": "我在這裡放鬆休息。等等，我們來看看"}, {"type": "subtitle", "time": 859.648, "timestamp": "00:14:19", "text": "照片顯示的是公園。同一個公園"}, {"type": "subtitle", "time": 862.029, "timestamp": "00:14:22", "text": "我們就是在那裡做的，呃，繩子那玩意兒"}, {"type": "subtitle", "time": 866.174, "timestamp": "00:14:26", "text": "上吊自殺。我們在這裡用…"}, {"type": "subtitle", "time": 870.485, "timestamp": "00:14:30", "text": "手。我用一隻手放在前面完成了這件事。"}, {"type": "subtitle", "time": 872.424, "timestamp": "00:14:32", "text": "公共街道，人人都能看到。"}, {"type": "subtitle", "time": 877.644, "timestamp": "00:14:37", "text": "那真是，那真是，呃，"}, {"type": "subtitle", "time": 881.806, "timestamp": "00:14:41", "text": "可恥。就我而言，我做到了。"}, {"type": "subtitle", "time": 887.749, "timestamp": "00:14:47", "text": "這才是最重要的。所以這個"}, {"type": "subtitle", "time": 891.515, "timestamp": "00:14:51", "text": "下坡路，這條下坡路。這非常好。 。說實話，是的，我當時就在附近。"}, {"type": "subtitle", "time": 899.421, "timestamp": "00:14:59", "text": "。說實話，是的，我當時就在附近。 今天。我剛才一直在想這件事"}]
[{"type": "subtitle", "time": 1863.051, "timestamp": "00:31:03", "text": "歡迎來到直播間。哪條路？"}, {"type": "subtitle", "time": 1868.64, "timestamp": "00:31:08", "text": "我是在走路嗎？或者我可以嗎？我應該嗎？"}, {"type": "subtitle", "time": 1870.223, "timestamp": "00:31:10", "text": "沿著主街走或"}, {"type": "subtitle", "time": 1877.2, "timestamp": "00:31:17", "text": "我可以走這邊嗎？嘿， 那不是我上的學校。"}, {"type": "subtitle", "time": 1879.347, "timestamp": "00:31:19", "text": "那不是我上的學校。 最近？等一下。是我感覺錯了嗎？"}, {"type": "subtitle", "time": 1884.891, "timestamp": "00:31:24", "text": "最近？等一下。是我感覺錯了嗎？ 那個標誌在閃爍嗎？他"}, {"type": "subtitle", "time": 1889.969, "timestamp": "00:31:29", "text": "那個標誌在閃爍嗎？他 我在這裡一年了，但你們的模式已經"}, {"type": "subtitle", "time": 1892.006, "timestamp": "00:31:32", "text": "我在這裡一年了，但你們的模式已經 變化很大。是的，這是新的。"}, {"type": "subtitle", "time": 1894.263, "timestamp": "00:31:34", "text": "變化很大。是的，這是新的。 模型，一款「黑脖子」的官方模型"}, {"type": "subtitle", "time": 1896.733, "timestamp": "00:31:36", "text": "模型，一款「黑脖子」的官方模型 “你好，歡迎。是我聽錯了嗎…”"}, {"type": "subtitle", "time": 1902.9279999999999, "timestamp": "00:31:42", "text": "“你好，歡迎。是我聽錯了嗎…” 標誌牌在閃爍嗎？是我嗎？"}, {"type": "subtitle", "time": 1910.309, "timestamp": "00:31:50", "text": "它在閃爍，對吧？那個人"}, {"type": "subtitle", "time": 1914.445, "timestamp": "00:31:54", "text": "它在閃爍。我沒有出現幻覺，"}, {"type": "subtitle", "time": 1917.763, "timestamp": "00:31:57", "text": "真的？這傢伙在眨眼。"}]
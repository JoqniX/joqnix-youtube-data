[{"type": "subtitle", "time": 6600.161, "timestamp": "01:50:00", "text": "全部。是的，還有很多事情。哇。但"}, {"type": "subtitle", "time": 6602.724, "timestamp": "01:50:02", "text": "是的，如果你還在的話，我今天會寫信給你。"}, {"type": "subtitle", "time": 6605.095, "timestamp": "01:50:05", "text": "甚至包括申請表上的備註，"}, {"type": "subtitle", "time": 6607.337, "timestamp": "01:50:07", "text": "問題以及所有的一切，筆記"}, {"type": "subtitle", "time": 6609.9, "timestamp": "01:50:09", "text": "評論我會在之前發給你。"}, {"type": "subtitle", "time": 6614.529, "timestamp": "01:50:14", "text": "我忘了。我有點忘了這件事了。"}, {"type": "subtitle", "time": 6616.359, "timestamp": "01:50:16", "text": "我昨天想在便條中提到這一點。"}, {"type": "subtitle", "time": 6617.9, "timestamp": "01:50:17", "text": "對我最新作品的評論"}, {"type": "subtitle", "time": 6623.688, "timestamp": "01:50:23", "text": "傳播。哦，對，在最後一個"}, {"type": "subtitle", "time": 6625.879, "timestamp": "01:50:25", "text": "我們遇到了嚴重的變速箱問題"}, {"type": "subtitle", "time": 6628.574, "timestamp": "01:50:28", "text": "斷線了，對吧？我不得不"}, {"type": "subtitle", "time": 6630.366, "timestamp": "01:50:30", "text": "每次都要重新連接"}, {"type": "subtitle", "time": 6633.662, "timestamp": "01:50:33", "text": "網路很糟糕。它沒有發送信號。"}, {"type": "subtitle", "time": 6636.199, "timestamp": "01:50:36", "text": "也會發佈到 YouTube、Twitch 和 Kick 之類的平台。"}, {"type": "subtitle", "time": 6641.392, "timestamp": "01:50:41", "text": "嗯，大概就這些了。除此之外 一切都好。好的。好的，我們走吧"}]
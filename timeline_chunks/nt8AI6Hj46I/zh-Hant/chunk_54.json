[{"type": "subtitle", "time": 3241.874, "timestamp": "00:54:01", "text": "高中生等見過我的人"}, {"type": "subtitle", "time": 3244.184, "timestamp": "00:54:04", "text": "在這15次場合中多次"}, {"type": "subtitle", "time": 3246.554, "timestamp": "00:54:06", "text": "我曾經參加過這些活動"}, {"type": "subtitle", "time": 3251.435, "timestamp": "00:54:11", "text": "門敞開著。好吧。什麼時候"}, {"type": "subtitle", "time": 3253.799, "timestamp": "00:54:13", "text": "我看到工作人員和"}, {"type": "subtitle", "time": 3256.101, "timestamp": "00:54:16", "text": "會議的其他學生"}, {"type": "subtitle", "time": 3258.092, "timestamp": "00:54:18", "text": "人們討論的是敞開大門，而且"}, {"type": "subtitle", "time": 3260.58, "timestamp": "00:54:20", "text": "他們太友善了，我好羨慕！"}, {"type": "subtitle", "time": 3265.942, "timestamp": "00:54:25", "text": "我心想：「哇。」我參加了這次活動。"}, {"type": "subtitle", "time": 3268.165, "timestamp": "00:54:28", "text": "敞開這所學校的大門"}, {"type": "subtitle", "time": 3270.635, "timestamp": "00:54:30", "text": "大約來了15次，都是從很遠的地方來的。"}, {"type": "subtitle", "time": 3272.673, "timestamp": "00:54:32", "text": "甚至去東京參加這些活動"}, {"type": "subtitle", "time": 3280.059, "timestamp": "00:54:40", "text": "幾天過去了，竟然沒有人……認識我，但是……"}, {"type": "subtitle", "time": 3284.688, "timestamp": "00:54:44", "text": "沒人跟我說話。我感到被排斥在外。 。我感到孤獨。為什麼是我"}, {"type": "subtitle", "time": 3288.72, "timestamp": "00:54:48", "text": "。我感到孤獨。為什麼是我 感到孤立嗎？他們為什麼要離開我？"}, {"type": "subtitle", "time": 3292.088, "timestamp": "00:54:52", "text": "感到孤立嗎？他們為什麼要離開我？ 邊？就是那種事。是的。還有一個"}, {"type": "subtitle", "time": 3298.268, "timestamp": "00:54:58", "text": "邊？就是那種事。是的。還有一個 類似的經驗也可以用以下情況來描述："}]
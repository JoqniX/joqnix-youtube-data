[{"type": "subtitle", "time": 1980.201, "timestamp": "00:33:00", "text": "那裡有十一人。等等，我到了。 兄弟。我剛才走了多遠？"}, {"type": "subtitle", "time": 1985.72, "timestamp": "00:33:05", "text": "多少公里？"}, {"type": "subtitle", "time": 1994.341, "timestamp": "00:33:14", "text": "我剛才走路了嗎？哇。讓我"}, {"type": "subtitle", "time": 2011.621, "timestamp": "00:33:31", "text": "改變。哇。但當……的時候，感覺真好。"}, {"type": "subtitle", "time": 2014.292, "timestamp": "00:33:34", "text": "你有時會走路那樣，需要好好想想。"}, {"type": "subtitle", "time": 2016.564, "timestamp": "00:33:36", "text": "是的，就像我前天一樣。"}, {"type": "subtitle", "time": 2019.932, "timestamp": "00:33:39", "text": "新宿，東京。我走路像個"}, {"type": "subtitle", "time": 2023.501, "timestamp": "00:33:43", "text": "瘋狂的。我走了又走又走"}, {"type": "subtitle", "time": 2030.085, "timestamp": "00:33:50", "text": "我是步行的。是的。但這遠不止於此。"}, {"type": "subtitle", "time": 2031.889, "timestamp": "00:33:51", "text": "我站著的時候腿會痛。"}, {"type": "subtitle", "time": 2036.464, "timestamp": "00:33:56", "text": "這就是我所領悟到的。作為"}, {"type": "subtitle", "time": 2038.51, "timestamp": "00:33:58", "text": "當我靜下心來工作時，我就會"}]
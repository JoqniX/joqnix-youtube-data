[{"type": "subtitle", "time": 5045.714, "timestamp": "01:24:05", "text": "噪音。我啟用降噪功能"}, {"type": "subtitle", "time": 5051.255, "timestamp": "01:24:11", "text": "必要時。幾乎總是不會"}, {"type": "subtitle", "time": 5053.521, "timestamp": "01:24:13", "text": "我這樣做是因為我覺得給他們更好。"}, {"type": "subtitle", "time": 5061.284, "timestamp": "01:24:21", "text": "天然的ASMR。所以有時候，例如"}, {"type": "subtitle", "time": 5066.808, "timestamp": "01:24:26", "text": "這是最早實現的功能之一"}, {"type": "subtitle", "time": 5068.409, "timestamp": "01:24:28", "text": "我加入的功能是降噪。"}, {"type": "subtitle", "time": 5070.479, "timestamp": "01:24:30", "text": "是的。是的。是的。你添加了"}, {"type": "subtitle", "time": 5072.527, "timestamp": "01:24:32", "text": "首先是降噪。所以"}, {"type": "subtitle", "time": 5078.093, "timestamp": "01:24:38", "text": "是的。當我身處這種狀態時"}, {"type": "subtitle", "time": 5080.312, "timestamp": "01:24:40", "text": "場景類型，我不會展示。"}, {"type": "subtitle", "time": 5082.475, "timestamp": "01:24:42", "text": "相機，當我不展示的時候"}, {"type": "subtitle", "time": 5084.638, "timestamp": "01:24:44", "text": "相機之類的東西，我想我可以啟動。"}, {"type": "subtitle", "time": 5098.32, "timestamp": "01:24:58", "text": "噪音抑制。是的，我討厭"}]
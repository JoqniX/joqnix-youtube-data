[{"type": "subtitle", "time": 660.067, "timestamp": "00:11:00", "text": "那。我只是在散步。我不知道 路径。我只是四处走走。"}, {"type": "subtitle", "time": 662.804, "timestamp": "00:11:02", "text": "路径。我只是四处走走。 每个社区并翻倍"}, {"type": "subtitle", "time": 664.403, "timestamp": "00:11:04", "text": "每个社区并翻倍 左右。你好，Chamakam。"}, {"type": "subtitle", "time": 669.819, "timestamp": "00:11:09", "text": "左右。你好，Chamakam。 希望你一切都好。所以我想"}, {"type": "subtitle", "time": 675.467, "timestamp": "00:11:15", "text": "希望你一切都好。所以我想 今天就聊聊天，散散步。"}, {"type": "subtitle", "time": 684.637, "timestamp": "00:11:24", "text": "所以我会减少使用那东西。"}, {"type": "subtitle", "time": 686.873, "timestamp": "00:11:26", "text": "今天拍照是因为没什么可看的。 除非发生什么有趣的事情。"}, {"type": "subtitle", "time": 694.74, "timestamp": "00:11:34", "text": "那边好像有只猫，但是……"}, {"type": "subtitle", "time": 697.43, "timestamp": "00:11:37", "text": "遛狗的男人。所以"}, {"type": "subtitle", "time": 701.2, "timestamp": "00:11:41", "text": "猫刚刚逃跑了。诸如此类的事情。"}, {"type": "subtitle", "time": 708.421, "timestamp": "00:11:48", "text": "是的，一切都好吗？"}, {"type": "subtitle", "time": 711.479, "timestamp": "00:11:51", "text": "世界？大家最近怎么样？怎么会，怎么会"}]
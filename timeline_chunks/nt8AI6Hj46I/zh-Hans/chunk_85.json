[{"type": "subtitle", "time": 5100.079, "timestamp": "01:25:00", "text": "降噪功能。我改变了"}, {"type": "subtitle", "time": 5104.887, "timestamp": "01:25:04", "text": "观点。什么？你不想要吗？这"}, {"type": "subtitle", "time": 5117.576, "timestamp": "01:25:17", "text": "好的。好吧。好吧。但是，"}, {"type": "subtitle", "time": 5119.998, "timestamp": "01:25:19", "text": "我平时很少用嗓子，因为"}, {"type": "subtitle", "time": 5122.42, "timestamp": "01:25:22", "text": "我觉得……有时候我必须说点什么。"}, {"type": "subtitle", "time": 5124.969, "timestamp": "01:25:24", "text": "差不多……我得这样说，放"}, {"type": "subtitle", "time": 5127.518, "timestamp": "01:25:27", "text": "电话就在我嘴边，或者当"}, {"type": "subtitle", "time": 5129.812, "timestamp": "01:25:29", "text": "我说话声音比较小，别人听不太懂。"}, {"type": "subtitle", "time": 5136.595, "timestamp": "01:25:36", "text": "差不多就是这样。所以我认为：“这是……”"}, {"type": "subtitle", "time": 5142.938, "timestamp": "01:25:42", "text": "好的，我会把它完全关掉。是的，"}, {"type": "subtitle", "time": 5147.121, "timestamp": "01:25:47", "text": "降噪功能使其听起来很悦耳。"}, {"type": "subtitle", "time": 5149.318, "timestamp": "01:25:49", "text": "离开。是的，我没听到蝉鸣声。"}, {"type": "subtitle", "time": 5152.129, "timestamp": "01:25:52", "text": "因为当时正在下雨。不，"}, {"type": "subtitle", "time": 5156.27, "timestamp": "01:25:56", "text": "蝉飞走了。如果我去"}]
[{"type": "subtitle", "time": 6544.23, "timestamp": "01:49:04", "text": "他们太棒了。是的。怎么样了？"}, {"type": "subtitle", "time": 6546.989, "timestamp": "01:49:06", "text": "远足？嗯，一切进展顺利。我们聊了很多。 。我要回家了，而且我迟到了。我的"}, {"type": "subtitle", "time": 6552.474, "timestamp": "01:49:12", "text": "。我要回家了，而且我迟到了。我的 我的室友要骂我了。"}, {"type": "subtitle", "time": 6558.442, "timestamp": "01:49:18", "text": "他让我8点回来，我会的。"}, {"type": "subtitle", "time": 6562.122, "timestamp": "01:49:22", "text": "我9点回来，所以我会待一个小时。"}, {"type": "subtitle", "time": 6564.405, "timestamp": "01:49:24", "text": "虽然晚了点，但没关系。我会尽快处理的。"}, {"type": "subtitle", "time": 6568.786, "timestamp": "01:49:28", "text": "白天我自己和同学们一起上课"}, {"type": "subtitle", "time": 6575.189, "timestamp": "01:49:35", "text": "我漏掉了一部分。所以我这就走"}, {"type": "subtitle", "time": 6577.507, "timestamp": "01:49:37", "text": "步行回家，吃晚饭什么的，然后去"}, {"type": "subtitle", "time": 6579.886, "timestamp": "01:49:39", "text": "补觉之后"}, {"type": "subtitle", "time": 6587.184, "timestamp": "01:49:47", "text": "课程和其他一切。是的，就是这样。"}]
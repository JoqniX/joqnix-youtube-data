[{"type": "subtitle", "time": 4082.292, "timestamp": "01:08:02", "text": "想着我应该这样做，想着我想要这样做"}, {"type": "subtitle", "time": 4084.848, "timestamp": "01:08:04", "text": "与日本当地人交谈，"}, {"type": "subtitle", "time": 4087.207, "timestamp": "01:08:07", "text": "这不一样，我会非常激动。"}, {"type": "subtitle", "time": 4093.728, "timestamp": "01:08:13", "text": "诚实的。好吧。问题是，如果"}, {"type": "subtitle", "time": 4096.009, "timestamp": "01:08:16", "text": "我会接近一个女孩或女人，或者"}, {"type": "subtitle", "time": 4098.349, "timestamp": "01:08:18", "text": "他们在街上可能会这么想。"}, {"type": "subtitle", "time": 4100.33, "timestamp": "01:08:20", "text": "我怀着不良意图接近"}, {"type": "subtitle", "time": 4104.631, "timestamp": "01:08:24", "text": "意图之类的。不，我看到了自己"}, {"type": "subtitle", "time": 4107.919, "timestamp": "01:08:27", "text": "像个孩子一样。我看起来很年轻，所以"}, {"type": "subtitle", "time": 4111.831, "timestamp": "01:08:31", "text": "好吧。虽然我的年龄，该死的，"}, {"type": "subtitle", "time": 4117.347, "timestamp": "01:08:37", "text": "我的天哪。伤心。没错，就是这样。"}, {"type": "subtitle", "time": 4122.194, "timestamp": "01:08:42", "text": "它也存在。就像你想要的那样"}, {"type": "subtitle", "time": 4124.275, "timestamp": "01:08:44", "text": "开启一段美好的对话，但是"}, {"type": "subtitle", "time": 4126.191, "timestamp": "01:08:46", "text": "你可能会被误解或曲解。"}, {"type": "subtitle", "time": 4129.609, "timestamp": "01:08:49", "text": "换个角度来看。那可真是件了不起的事。"}]
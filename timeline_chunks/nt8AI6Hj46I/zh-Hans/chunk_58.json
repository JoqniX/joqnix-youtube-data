[{"type": "subtitle", "time": 3480.788, "timestamp": "00:58:00", "text": "内心深处，我感觉……"}, {"type": "subtitle", "time": 3486.909, "timestamp": "00:58:06", "text": "有时候会有些人像这样"}, {"type": "subtitle", "time": 3491.604, "timestamp": "00:58:11", "text": "反对外国人。有时会有"}, {"type": "subtitle", "time": 3493.726, "timestamp": "00:58:13", "text": "接纳外国人的人"}, {"type": "subtitle", "time": 3497.714, "timestamp": "00:58:17", "text": "真的？像东京这样的地方"}, {"type": "subtitle", "time": 3500.876, "timestamp": "00:58:20", "text": "里面全是外国人。那些"}, {"type": "subtitle", "time": 3503.333, "timestamp": "00:58:23", "text": "这些地方人们都很讨厌。"}, {"type": "subtitle", "time": 3505.855, "timestamp": "00:58:25", "text": "当地人，也就是本地人，会憎恨他们"}, {"type": "subtitle", "time": 3508.312, "timestamp": "00:58:28", "text": "外国人，因为他们厌倦了"}, {"type": "subtitle", "time": 3510.381, "timestamp": "00:58:30", "text": "看到外国人把事情搞砸了……"}, {"type": "subtitle", "time": 3512.903, "timestamp": "00:58:32", "text": "违反规则等等，真的吗？"}, {"type": "subtitle", "time": 3516.968, "timestamp": "00:58:36", "text": "像这里这样的地方"}, {"type": "subtitle", "time": 3519.065, "timestamp": "00:58:39", "text": "外国人太少了，"}, {"type": "subtitle", "time": 3532.569, "timestamp": "00:58:52", "text": "我猜是吧。所以我喝了些水补充水分。"}, {"type": "subtitle", "time": 3534.642, "timestamp": "00:58:54", "text": "饮料，一种补水饮品"}, {"type": "subtitle", "time": 3539.548, "timestamp": "00:58:59", "text": "这片水域，这个公园。所以"}]
[{"type": "subtitle", "time": 3902.957, "timestamp": "01:05:02", "text": "我一直都很珍惜它们。我还在说话"}, {"type": "subtitle", "time": 3909.363, "timestamp": "01:05:09", "text": "仅限于那个圈子的人，而不是"}, {"type": "subtitle", "time": 3911.127, "timestamp": "01:05:11", "text": "我想过桥去寻找"}, {"type": "subtitle", "time": 3919.17, "timestamp": "01:05:19", "text": "交更多朋友之类的。是的。但是就像"}, {"type": "subtitle", "time": 3921.511, "timestamp": "01:05:21", "text": "Jonix，你可能认识我，我是……"}, {"type": "subtitle", "time": 3924.053, "timestamp": "01:05:24", "text": "连接器等。我与"}, {"type": "subtitle", "time": 3926.662, "timestamp": "01:05:26", "text": "我与许多创作者合作过。"}, {"type": "subtitle", "time": 3930.526, "timestamp": "01:05:30", "text": "YouTube 上的那些人。能"}, {"type": "subtitle", "time": 3932.787, "timestamp": "01:05:32", "text": "我可能看起来比较外向什么的。"}, {"type": "subtitle", "time": 3934.991, "timestamp": "01:05:34", "text": "所以，要么是个善于交际的人，要么就是其他什么人。"}, {"type": "subtitle", "time": 3937.2, "timestamp": "01:05:37", "text": "是。或许你越是注视我，"}, {"type": "subtitle", "time": 3939.194, "timestamp": "01:05:39", "text": "你会发现我有多么内向。"}, {"type": "subtitle", "time": 3944.228, "timestamp": "01:05:44", "text": "存在。或者我只是喜欢聊天。"}, {"type": "subtitle", "time": 3946.692, "timestamp": "01:05:46", "text": "无论是我独处的时候还是其他时候。呃，就像"}, {"type": "subtitle", "time": 3948.827, "timestamp": "01:05:48", "text": "当我进行个人直播时。但"}, {"type": "subtitle", "time": 3950.607, "timestamp": "01:05:50", "text": "在群体传播期间，"}, {"type": "subtitle", "time": 3956.212, "timestamp": "01:05:56", "text": "你会发现我几乎不说话。之后"}, {"type": "subtitle", "time": 3958.916, "timestamp": "01:05:58", "text": "变速箱，当我做一次或"}]
[{"type": "subtitle", "time": 3122.792, "timestamp": "00:52:02", "text": "你解释得很好。是的，大部分 人们只是照顾好自己"}, {"type": "subtitle", "time": 3124.488, "timestamp": "00:52:04", "text": "人们只是照顾好自己 拥有自己的事业等等。那是日本。"}, {"type": "subtitle", "time": 3129.652, "timestamp": "00:52:09", "text": "人们都管好自己的事。"}, {"type": "subtitle", "time": 3138.313, "timestamp": "00:52:18", "text": "是的。除非，除非你问他们"}, {"type": "subtitle", "time": 3141.094, "timestamp": "00:52:21", "text": "援助。所以，所以，所以"}, {"type": "subtitle", "time": 3145.391, "timestamp": "00:52:25", "text": "与此同时，如果我接近一个"}, {"type": "subtitle", "time": 3147.304, "timestamp": "00:52:27", "text": "我随意地问了他"}, {"type": "subtitle", "time": 3149.856, "timestamp": "00:52:29", "text": "是的，方向等等都在里面"}, {"type": "subtitle", "time": 3151.897, "timestamp": "00:52:31", "text": "他们的东西，我向他们求助，还有我"}, {"type": "subtitle", "time": 3157.575, "timestamp": "00:52:37", "text": "他们会帮忙的。这种情况时有发生。是的。但还有另一个"}, {"type": "subtitle", "time": 3159.666, "timestamp": "00:52:39", "text": "例如，我谈到了校园。"}, {"type": "subtitle", "time": 3164.124, "timestamp": "00:52:44", "text": "开着吧？我上过那所学校"}, {"type": "subtitle", "time": 3169.099, "timestamp": "00:52:49", "text": "开放校园活动举办15次。每个"}, {"type": "subtitle", "time": 3171.493, "timestamp": "00:52:51", "text": "每当我有多余的钱时，我都会去旅行。"}, {"type": "subtitle", "time": 3173.827, "timestamp": "00:52:53", "text": "东京将参加校园活动"}, {"type": "subtitle", "time": 3176.161, "timestamp": "00:52:56", "text": "因为我热爱音乐而开放"}]
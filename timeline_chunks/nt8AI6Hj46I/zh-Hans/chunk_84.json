[{"type": "subtitle", "time": 5045.714, "timestamp": "01:24:05", "text": "噪音。我启用降噪功能"}, {"type": "subtitle", "time": 5051.255, "timestamp": "01:24:11", "text": "必要时。几乎总是不会"}, {"type": "subtitle", "time": 5053.521, "timestamp": "01:24:13", "text": "我这样做是因为我觉得给他们更好。"}, {"type": "subtitle", "time": 5061.284, "timestamp": "01:24:21", "text": "天然的ASMR。所以有时候，比如"}, {"type": "subtitle", "time": 5066.808, "timestamp": "01:24:26", "text": "这是最先实现的功能之一"}, {"type": "subtitle", "time": 5068.409, "timestamp": "01:24:28", "text": "我添加的功能是降噪。"}, {"type": "subtitle", "time": 5070.479, "timestamp": "01:24:30", "text": "是的。是的。是的。你添加了"}, {"type": "subtitle", "time": 5072.527, "timestamp": "01:24:32", "text": "首先是降噪。所以"}, {"type": "subtitle", "time": 5078.093, "timestamp": "01:24:38", "text": "是的。当我身处这种状态时"}, {"type": "subtitle", "time": 5080.312, "timestamp": "01:24:40", "text": "场景类型，我不会展示。"}, {"type": "subtitle", "time": 5082.475, "timestamp": "01:24:42", "text": "相机，当我不展示的时候"}, {"type": "subtitle", "time": 5084.638, "timestamp": "01:24:44", "text": "相机之类的东西，我想我可以激活。"}, {"type": "subtitle", "time": 5098.32, "timestamp": "01:24:58", "text": "噪声抑制。是的，我讨厌"}]
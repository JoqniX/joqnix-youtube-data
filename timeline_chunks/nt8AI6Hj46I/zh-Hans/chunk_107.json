[{"type": "subtitle", "time": 6420.679, "timestamp": "01:47:00", "text": "也听听这个。哇。好的。你呢 我们回家吧。是的，我要去"}, {"type": "subtitle", "time": 6427.895, "timestamp": "01:47:07", "text": "我们回家吧。是的，我要去 9点整准时结束。所以"}, {"type": "subtitle", "time": 6432.014, "timestamp": "01:47:12", "text": "9点整准时结束。所以 我会走回家。好的，"}, {"type": "subtitle", "time": 6443.616, "timestamp": "01:47:23", "text": "结果我话很多。我没想到"}, {"type": "subtitle", "time": 6449.16, "timestamp": "01:47:29", "text": "说实话，今天话真多。我我"}, {"type": "subtitle", "time": 6453.638, "timestamp": "01:47:33", "text": "我很好。我想保持"}, {"type": "subtitle", "time": 6456.653, "timestamp": "01:47:36", "text": "短途传输。就像在"}, {"type": "subtitle", "time": 6458.388, "timestamp": "01:47:38", "text": "我只是想表达一点。"}, {"type": "subtitle", "time": 6465.027, "timestamp": "01:47:45", "text": "随着时间的推移，我达到了那个目标。呃，那"}, {"type": "subtitle", "time": 6467.426, "timestamp": "01:47:47", "text": "我说：“好吧，我会继续下去，因为……”"}, {"type": "subtitle", "time": 6469.446, "timestamp": "01:47:49", "text": "我喜欢聊天之类的。"}, {"type": "subtitle", "time": 6474.83, "timestamp": "01:47:54", "text": "那些能看见我、听见我的人，"}, {"type": "subtitle", "time": 6477.266, "timestamp": "01:47:57", "text": "听我说，嗯，我会为他们做的。"}]
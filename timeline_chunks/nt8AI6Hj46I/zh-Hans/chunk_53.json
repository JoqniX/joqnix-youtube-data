[{"type": "subtitle", "time": 3184.833, "timestamp": "00:53:04", "text": "吃吃喝喝什么的，对吧？所以，每个"}, {"type": "subtitle", "time": 3186.938, "timestamp": "00:53:06", "text": "每次我去那家咖啡店，"}, {"type": "subtitle", "time": 3188.868, "timestamp": "00:53:08", "text": "候车区有很多"}, {"type": "subtitle", "time": 3190.914, "timestamp": "00:53:10", "text": "所有日本学生"}, {"type": "subtitle", "time": 3193.078, "timestamp": "00:53:13", "text": "座位都满了，只有我的桌子是空的。"}, {"type": "subtitle", "time": 3198.903, "timestamp": "00:53:18", "text": "没人愿意坐在我旁边，因为"}, {"type": "subtitle", "time": 3204.275, "timestamp": "00:53:24", "text": "可以说。没人想说话"}, {"type": "subtitle", "time": 3206.671, "timestamp": "00:53:26", "text": "和我在一起，甚至连成员们也不例外"}, {"type": "subtitle", "time": 3208.941, "timestamp": "00:53:28", "text": "个人的，除非，嗯，这是你的。"}, {"type": "subtitle", "time": 3211.274, "timestamp": "00:53:31", "text": "您必须确保已填写完毕。"}, {"type": "subtitle", "time": 3213.797, "timestamp": "00:53:33", "text": "所有表格以及其他一切。"}, {"type": "subtitle", "time": 3221.661, "timestamp": "00:53:41", "text": "只有在这种情况下他们才会来，而且，嗯，"}, {"type": "subtitle", "time": 3223.788, "timestamp": "00:53:43", "text": "他们跟我说话，或者也许是某些人"}, {"type": "subtitle", "time": 3226.367, "timestamp": "00:53:46", "text": "好奇的员工想要"}, {"type": "subtitle", "time": 3228.494, "timestamp": "00:53:48", "text": "与外国人交谈是自然而然的事情。"}, {"type": "subtitle", "time": 3231.009, "timestamp": "00:53:51", "text": "问问我过得怎么样，或者问我什么事"}, {"type": "subtitle", "time": 3237.741, "timestamp": "00:53:57", "text": "印度之类的。还有学生，"}, {"type": "subtitle", "time": 3239.443, "timestamp": "00:53:59", "text": "日本学生，或来自"}]
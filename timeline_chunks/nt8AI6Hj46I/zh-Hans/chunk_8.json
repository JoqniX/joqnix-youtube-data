[{"type": "subtitle", "time": 481.438, "timestamp": "00:08:01", "text": "合作是因为我不知道何时"}, {"type": "subtitle", "time": 483.496, "timestamp": "00:08:03", "text": "那是花火会，一个节日"}, {"type": "subtitle", "time": 488.081, "timestamp": "00:08:08", "text": "烟花。是的，是第八个"}, {"type": "subtitle", "time": 492.146, "timestamp": "00:08:12", "text": "八月。这次大概是六点钟左右。"}, {"type": "subtitle", "time": 494.662, "timestamp": "00:08:14", "text": "时间到了，对吧？大约在这个时候，"}, {"type": "subtitle", "time": 496.55, "timestamp": "00:08:16", "text": "我将展示部署过程"}, {"type": "subtitle", "time": 499.637, "timestamp": "00:08:19", "text": "8月8日燃放烟花。那"}, {"type": "subtitle", "time": 503.124, "timestamp": "00:08:23", "text": "今天是星期六。是的，8月8日。"}, {"type": "subtitle", "time": 506.625, "timestamp": "00:08:26", "text": "周六。就在那时，我的"}, {"type": "subtitle", "time": 508.387, "timestamp": "00:08:28", "text": "暑假一周。"}, {"type": "subtitle", "time": 512.718, "timestamp": "00:08:32", "text": "仅仅一周。所以我会像这样"}, {"type": "subtitle", "time": 516.372, "timestamp": "00:08:36", "text": "用视频博客记录下来。我将"}, {"type": "subtitle", "time": 519.268, "timestamp": "00:08:39", "text": "像这样用视频博客的形式记录下来。像这样。"}, {"type": "subtitle", "time": 525.919, "timestamp": "00:08:45", "text": "非常好。我会这样录制下来。"}, {"type": "subtitle", "time": 527.695, "timestamp": "00:08:47", "text": "跟你说话是为了让你能够"}, {"type": "subtitle", "time": 533.733, "timestamp": "00:08:53", "text": "看看吧，一切都看在眼里。清除。展示。这是"}, {"type": "subtitle", "time": 535.797, "timestamp": "00:08:55", "text": "真好。我只是在走路而已。"}]
[{"type": "subtitle", "time": 1681.561, "timestamp": "00:28:01", "text": "探索街区、房屋和街道"}, {"type": "subtitle", "time": 1685.932, "timestamp": "00:28:05", "text": "自言自语。比如什么"}, {"type": "subtitle", "time": 1692.335, "timestamp": "00:28:12", "text": "我注意到了一些事情。好吧。许多房屋"}, {"type": "subtitle", "time": 1694.397, "timestamp": "00:28:14", "text": "日本人非常安静。"}, {"type": "subtitle", "time": 1696.696, "timestamp": "00:28:16", "text": "晚上7点开始就好像他们的"}, {"type": "subtitle", "time": 1703.901, "timestamp": "00:28:23", "text": "房子里没有灯。每个人都"}, {"type": "subtitle", "time": 1706.044, "timestamp": "00:28:26", "text": "睡着了或者什么事，或者根本没人。"}, {"type": "subtitle", "time": 1711.431, "timestamp": "00:28:31", "text": "为什么房子里这么安静？"}, {"type": "subtitle", "time": 1713.734, "timestamp": "00:28:33", "text": "等等，你的意思是……？"}, {"type": "subtitle", "time": 1723.174, "timestamp": "00:28:43", "text": "这是一些房子。没有灯光。没有"}, {"type": "subtitle", "time": 1726.358, "timestamp": "00:28:46", "text": "灯。公寓里有灯。"}, {"type": "subtitle", "time": 1728.22, "timestamp": "00:28:48", "text": "因为它们有外部照明灯。"}, {"type": "subtitle", "time": 1735.245, "timestamp": "00:28:55", "text": "是的。但我经历了太多。"}, {"type": "subtitle", "time": 1737.801, "timestamp": "00:28:57", "text": "房屋。那边那栋房子是"}, {"type": "subtitle", "time": 1739.568, "timestamp": "00:28:59", "text": "完全地。灯光是"}]
[{"type": "subtitle", "time": 3961.553, "timestamp": "01:06:01", "text": "我想大概是这样的：“该死，我应该……”"}, {"type": "subtitle", "time": 3965.59, "timestamp": "01:06:05", "text": "更像是那样说的。”所以，是的，就是这样。"}, {"type": "subtitle", "time": 3971.702, "timestamp": "01:06:11", "text": "这就是我。是的。但是，但是，但是我感觉"}, {"type": "subtitle", "time": 3974.582, "timestamp": "01:06:14", "text": "随着时间推移，不，随着时间推移，"}, {"type": "subtitle", "time": 3979.378, "timestamp": "01:06:19", "text": "不，我觉得情况会好转，而且确实如此。"}, {"type": "subtitle", "time": 3983.491, "timestamp": "01:06:23", "text": "需要改进的地方。我只需要拿一个"}, {"type": "subtitle", "time": 3985.335, "timestamp": "01:06:25", "text": "从现在开始，不会有什么大动作了。"}, {"type": "subtitle", "time": 3988.339, "timestamp": "01:06:28", "text": "为什么摆出一副悲伤的表情？不不"}, {"type": "subtitle", "time": 3991.099, "timestamp": "01:06:31", "text": "我很伤心。这是我难过的表情。"}, {"type": "subtitle", "time": 4012.934, "timestamp": "01:06:52", "text": "自然的。那？是的，情况会好转的。 ？ 这些孩子正从……"}, {"type": "subtitle", "time": 4014.478, "timestamp": "01:06:54", "text": "这些孩子正从…… 水池？这些孩子要出来了吗？"}, {"type": "subtitle", "time": 4018.854, "timestamp": "01:06:58", "text": "水池？这些孩子要出来了吗？ 从游泳池里？他们和家人一起来。"}]
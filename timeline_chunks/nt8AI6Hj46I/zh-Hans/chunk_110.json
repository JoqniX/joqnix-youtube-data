[{"type": "subtitle", "time": 6600.161, "timestamp": "01:50:00", "text": "全部。是的，还有很多事情。哇。但"}, {"type": "subtitle", "time": 6602.724, "timestamp": "01:50:02", "text": "是的，如果你还在的话，我今天会给你写信。"}, {"type": "subtitle", "time": 6605.095, "timestamp": "01:50:05", "text": "甚至包括申请表上的备注，"}, {"type": "subtitle", "time": 6607.337, "timestamp": "01:50:07", "text": "问题以及所有的一切，笔记"}, {"type": "subtitle", "time": 6609.9, "timestamp": "01:50:09", "text": "评论我会在之前发给你。"}, {"type": "subtitle", "time": 6614.529, "timestamp": "01:50:14", "text": "我忘了。我有点忘了这件事了。"}, {"type": "subtitle", "time": 6616.359, "timestamp": "01:50:16", "text": "我昨天想在便条中提到这一点。"}, {"type": "subtitle", "time": 6617.9, "timestamp": "01:50:17", "text": "对我最新作品的评论"}, {"type": "subtitle", "time": 6623.688, "timestamp": "01:50:23", "text": "传播。哦，对，在最后一个"}, {"type": "subtitle", "time": 6625.879, "timestamp": "01:50:25", "text": "我们遇到了严重的变速箱问题"}, {"type": "subtitle", "time": 6628.574, "timestamp": "01:50:28", "text": "断线了，对吧？我不得不"}, {"type": "subtitle", "time": 6630.366, "timestamp": "01:50:30", "text": "每次都要重新连接"}, {"type": "subtitle", "time": 6633.662, "timestamp": "01:50:33", "text": "网络很糟糕。它没有发送信号。"}, {"type": "subtitle", "time": 6636.199, "timestamp": "01:50:36", "text": "还会发布到 YouTube、Twitch 和 Kick 之类的平台。"}, {"type": "subtitle", "time": 6641.392, "timestamp": "01:50:41", "text": "嗯，大概就这些了。除此之外 一切都好。好的。好的，我们走吧"}]
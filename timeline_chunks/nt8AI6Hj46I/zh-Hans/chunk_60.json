[{"type": "subtitle", "time": 3601.516, "timestamp": "01:00:01", "text": "他说。所以D，他们刚到。"}, {"type": "subtitle", "time": 3604.332, "timestamp": "01:00:04", "text": "这里。他们想问，但是"}, {"type": "subtitle", "time": 3606.339, "timestamp": "01:00:06", "text": "你必须放手一搏。你知道，是谁"}, {"type": "subtitle", "time": 3607.959, "timestamp": "01:00:07", "text": "你知道？他们有可能成为好人"}, {"type": "subtitle", "time": 3609.448, "timestamp": "01:00:09", "text": "朋友后来，尤其是如果"}, {"type": "subtitle", "time": 3610.859, "timestamp": "01:00:10", "text": "他们并肩坐了一会儿。"}, {"type": "subtitle", "time": 3612.438, "timestamp": "01:00:12", "text": "你可以和他们谈谈他们身上发生的事情。"}, {"type": "subtitle", "time": 3614.389, "timestamp": "01:00:14", "text": "问问他们是怎么到这儿来的，他们"}, {"type": "subtitle", "time": 3619.755, "timestamp": "01:00:19", "text": "他们想做。我的天啊。谢谢"}, {"type": "subtitle", "time": 3622.053, "timestamp": "01:00:22", "text": "因为那条信息，那份回应，因为"}, {"type": "subtitle", "time": 3624.293, "timestamp": "01:00:24", "text": "我觉得我甚至都没做到那样。"}, {"type": "subtitle", "time": 3628.352, "timestamp": "01:00:28", "text": "学校也一样。连我都不行"}, {"type": "subtitle", "time": 3630.245, "timestamp": "01:00:30", "text": "我与同学交流。"}, {"type": "subtitle", "time": 3645.79, "timestamp": "01:00:45", "text": "现在好像又出现了第二个。现在"}, {"type": "subtitle", "time": 3647.481, "timestamp": "01:00:47", "text": "那里好像来了一个新生。"}, {"type": "subtitle", "time": 3654.143, "timestamp": "01:00:54", "text": "现在好像来了个新学生"}, {"type": "subtitle", "time": 3656.141, "timestamp": "01:00:56", "text": "在那边。等等，你能听到我说话吗？经过"}, {"type": "subtitle", "time": 3658.122, "timestamp": "01:00:58", "text": "是的，我正在切换标签页。"}]
[{"type": "subtitle", "time": 1980.201, "timestamp": "00:33:00", "text": "那里有十一人。等等，我到了。 兄弟。我刚才走了多远？"}, {"type": "subtitle", "time": 1985.72, "timestamp": "00:33:05", "text": "多少公里？"}, {"type": "subtitle", "time": 1994.341, "timestamp": "00:33:14", "text": "我刚才走路了吗？哇。让我"}, {"type": "subtitle", "time": 2011.621, "timestamp": "00:33:31", "text": "改变。哇。但当……的时候，感觉真好。"}, {"type": "subtitle", "time": 2014.292, "timestamp": "00:33:34", "text": "你有时走路那样，需要好好想想。"}, {"type": "subtitle", "time": 2016.564, "timestamp": "00:33:36", "text": "是的，就像我前天一样。"}, {"type": "subtitle", "time": 2019.932, "timestamp": "00:33:39", "text": "新宿，东京。我走路像个"}, {"type": "subtitle", "time": 2023.501, "timestamp": "00:33:43", "text": "疯狂的。我走了又走又走"}, {"type": "subtitle", "time": 2030.085, "timestamp": "00:33:50", "text": "我是步行的。是的。但这远不止于此。"}, {"type": "subtitle", "time": 2031.889, "timestamp": "00:33:51", "text": "我站着的时候腿会疼。"}, {"type": "subtitle", "time": 2036.464, "timestamp": "00:33:56", "text": "这就是我所领悟到的。作为"}, {"type": "subtitle", "time": 2038.51, "timestamp": "00:33:58", "text": "当我静下​​心来工作时，我就会"}]
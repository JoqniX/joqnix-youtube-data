[{"type": "subtitle", "time": 2762.873, "timestamp": "00:46:02", "text": "我做完事，离开的时候，我会说些话什么的。 礼貌地鞠躬，"}, {"type": "subtitle", "time": 2765.103, "timestamp": "00:46:05", "text": "礼貌地鞠躬， 它叫什么名字？微微前倾"}, {"type": "subtitle", "time": 2768.438, "timestamp": "00:46:08", "text": "它叫什么名字？微微前倾 呃，40度角，或者25度角。"}, {"type": "subtitle", "time": 2772.999, "timestamp": "00:46:12", "text": "呃，40度角，或者25度角。 你可以这样做。是的，呃，我的确如此。"}, {"type": "subtitle", "time": 2776.144, "timestamp": "00:46:16", "text": "你可以这样做。是的，呃，我的确如此。 这一切都是以尊重的方式进行的。"}, {"type": "subtitle", "time": 2783.359, "timestamp": "00:46:23", "text": "但有时我觉得有些"}, {"type": "subtitle", "time": 2789.065, "timestamp": "00:46:29", "text": "他们不注意到我，但会对其他人做出反应。"}, {"type": "subtitle", "time": 2793.861, "timestamp": "00:46:33", "text": "是的，他们确实会这样做。他，那个老人，开口说话了。"}, {"type": "subtitle", "time": 2797.009, "timestamp": "00:46:37", "text": "和其他人，其他人，呃，人们"}, {"type": "subtitle", "time": 2799.901, "timestamp": "00:46:39", "text": "虽然年纪大了，但说得很好。"}, {"type": "subtitle", "time": 2803.586, "timestamp": "00:46:43", "text": "等等，等等。只有我，"}, {"type": "subtitle", "time": 2811.647, "timestamp": "00:46:51", "text": "呃，比如，为什么是我？两者都不是"}, {"type": "subtitle", "time": 2813.953, "timestamp": "00:46:53", "text": "他甚至不喜欢我去洗手间。"}, {"type": "subtitle", "time": 2816.197, "timestamp": "00:46:56", "text": "当时间已经过去之后"}, {"type": "subtitle", "time": 2818.321, "timestamp": "00:46:58", "text": "我休息了一会儿，大约3分钟后就到了。"}]
[{"type": "subtitle", "time": 2820.687, "timestamp": "00:47:00", "text": "迟到了，好吧，然后开始喋喋不休。"}, {"type": "subtitle", "time": 2825.586, "timestamp": "00:47:05", "text": "我只是去趟洗手间就被他大吼大叫。"}, {"type": "subtitle", "time": 2833.013, "timestamp": "00:47:13", "text": "或许他很在乎你，就好像……"}, {"type": "subtitle", "time": 2839.114, "timestamp": "00:47:19", "text": "情况确实如此。嗯。通常情况下"}, {"type": "subtitle", "time": 2841.326, "timestamp": "00:47:21", "text": "你说“哦哈约”，他们，他们应该"}, {"type": "subtitle", "time": 2846.998, "timestamp": "00:47:26", "text": "回答“哦哈约”之类的问题。是的。和"}, {"type": "subtitle", "time": 2849.477, "timestamp": "00:47:29", "text": "你好，阿拉。欢迎。欢迎。 ？ 你好吗？我很好。仅有的"}, {"type": "subtitle", "time": 2851.188, "timestamp": "00:47:31", "text": "你好吗？我很好。仅有的 步行。马上就要下雨了……现在下雨了"}, {"type": "subtitle", "time": 2853.139, "timestamp": "00:47:33", "text": "步行。马上就要下雨了……现在下雨了 相同的。我没有伞。嗯，是的。嗯。"}, {"type": "subtitle", "time": 2872.728, "timestamp": "00:47:52", "text": "回到正题。嗯。问题在于……"}, {"type": "subtitle", "time": 2875.163, "timestamp": "00:47:55", "text": "我想知道，我真的想知道。"}, {"type": "subtitle", "time": 2877.327, "timestamp": "00:47:57", "text": "与日本青少年见面，"}, {"type": "subtitle", "time": 2879.964, "timestamp": "00:47:59", "text": "与年轻人、成年人交谈"}]
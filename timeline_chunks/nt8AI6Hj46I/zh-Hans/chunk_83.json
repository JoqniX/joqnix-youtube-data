[{"type": "subtitle", "time": 4980.005, "timestamp": "01:23:00", "text": "穿着。这就是问题所在。等待。 现在。等等，等等，等等"}, {"type": "subtitle", "time": 4982.721, "timestamp": "01:23:02", "text": "现在。等等，等等，等等 等待。我快到了，我快到了"}, {"type": "subtitle", "time": 4984.898, "timestamp": "01:23:04", "text": "等待。我快到了，我快到了 这辆车。好的。等待。好的。你听着"}, {"type": "subtitle", "time": 4992.446, "timestamp": "01:23:12", "text": "这辆车。好的。等待。好的。你听着 是关于那辆车的，对吧？你听说过……"}, {"type": "subtitle", "time": 4996.986, "timestamp": "01:23:16", "text": "是关于那辆车的，对吧？你听说过…… 是车吧？好的。我将激活"}, {"type": "subtitle", "time": 5001.244, "timestamp": "01:23:21", "text": "是车吧？好的。我将激活 噪声抑制。是的。就这些吗？"}, {"type": "subtitle", "time": 5004.927, "timestamp": "01:23:24", "text": "噪声抑制。是的。就这些吗？ 更好的？你能听到我吗？如果有"}, {"type": "subtitle", "time": 5008.577, "timestamp": "01:23:28", "text": "更好的？你能听到我吗？如果有 巨响，也许不是我。"}, {"type": "subtitle", "time": 5010.253, "timestamp": "01:23:30", "text": "巨响，也许不是我。 仔细听。但伴随着细微的声音"}, {"type": "subtitle", "time": 5014.442, "timestamp": "01:23:34", "text": "仔细听。但伴随着细微的声音 这样，你就能听到我的车声了。"}, {"type": "subtitle", "time": 5019.274, "timestamp": "01:23:39", "text": "这样，你就能听到我的车声了。 这里。这就是汽车音响所经历的过程。"}, {"type": "subtitle", "time": 5027.453, "timestamp": "01:23:47", "text": "是的。目前存在压制现象"}]
[{"type": "subtitle", "time": 1022.879, "timestamp": "00:17:02", "text": "好像我必须解释它是什么似的。"}, {"type": "subtitle", "time": 1030.319, "timestamp": "00:17:10", "text": "更确切地说，我根本不在乎。"}, {"type": "subtitle", "time": 1032.784, "timestamp": "00:17:12", "text": "就像你想做自己喜欢的事一样"}, {"type": "subtitle", "time": 1034.87, "timestamp": "00:17:14", "text": "如此迫切地"}, {"type": "subtitle", "time": 1037.335, "timestamp": "00:17:17", "text": "履行你的职责"}, {"type": "subtitle", "time": 1039.801, "timestamp": "00:17:19", "text": "工作、学习等等。你回到家，"}, {"type": "subtitle", "time": 1042.266, "timestamp": "00:17:22", "text": "你想做你的爱好，但是你……"}, {"type": "subtitle", "time": 1044.605, "timestamp": "00:17:24", "text": "需要承担更多责任，"}, {"type": "subtitle", "time": 1052.352, "timestamp": "00:17:32", "text": "然后你会说，哦，天哪，已经12点了。"}, {"type": "subtitle", "time": 1057.94, "timestamp": "00:17:37", "text": "是。根本没有时间真正"}, {"type": "subtitle", "time": 1059.837, "timestamp": "00:17:39", "text": "牺牲你的梦想，去做你该做的事"}, {"type": "subtitle", "time": 1064.094, "timestamp": "00:17:44", "text": "消遣1小时。但时间"}, {"type": "subtitle", "time": 1067.626, "timestamp": "00:17:47", "text": "他飞得跟没事人一样。时光飞逝"}, {"type": "subtitle", "time": 1071.524, "timestamp": "00:17:51", "text": "太多了。这不禁让人思考，为什么？"}, {"type": "subtitle", "time": 1073.49, "timestamp": "00:17:53", "text": "当你……的时候，时间不会过得很快。"}, {"type": "subtitle", "time": 1077.378, "timestamp": "00:17:57", "text": "在学校还是在工作场所？为什么？"}, {"type": "subtitle", "time": 1079.412, "timestamp": "00:17:59", "text": "时间在事物中流逝得如此缓慢……"}]
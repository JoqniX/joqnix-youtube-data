[{"type": "subtitle", "time": 425.172, "timestamp": "00:07:05", "text": "。我只盼着十二月快点到来。 男人。我要向……扔雪球"}, {"type": "subtitle", "time": 430.286, "timestamp": "00:07:10", "text": "男人。我要向……扔雪球 我看到的每个人。我要"}, {"type": "subtitle", "time": 433.887, "timestamp": "00:07:13", "text": "我看到的每个人。我要 到处扔雪球。"}, {"type": "subtitle", "time": 436.355, "timestamp": "00:07:16", "text": "到处扔雪球。 我要堆个雪人。我打算，"}, {"type": "subtitle", "time": 439.017, "timestamp": "00:07:19", "text": "我要堆个雪人。我打算， 我要躺在地板上做一件事"}, {"type": "subtitle", "time": 441.269, "timestamp": "00:07:21", "text": "我要躺在地板上做一件事 天使之类的东西。我要做很多"}, {"type": "subtitle", "time": 446.093, "timestamp": "00:07:26", "text": "天使之类的东西。我要做很多 事物。哇。我等不及了。但是如果"}, {"type": "subtitle", "time": 456.435, "timestamp": "00:07:36", "text": "事物。哇。我等不及了。但是如果 现在夏天来了，地震也随之而来。"}, {"type": "subtitle", "time": 458.906, "timestamp": "00:07:38", "text": "现在夏天来了，地震也随之而来。 台风，这里真像泰国。"}, {"type": "subtitle", "time": 472.743, "timestamp": "00:07:52", "text": "哦，对了，下个月我们有"}, {"type": "subtitle", "time": 476.779, "timestamp": "00:07:56", "text": "计划了很多事情。事实上，我有"}, {"type": "subtitle", "time": 479.079, "timestamp": "00:07:59", "text": "而不是为了……而重新安排会议。"}]
[{"type": "subtitle", "time": 1741.632, "timestamp": "00:29:01", "text": "已关闭。灯关了。"}, {"type": "subtitle", "time": 1744.785, "timestamp": "00:29:04", "text": "好的，那栋房子有电了。好了，就这些。"}, {"type": "subtitle", "time": 1749.749, "timestamp": "00:29:09", "text": "一个。这是其中之一。就一个。好的，就是那个。"}, {"type": "subtitle", "time": 1752.166, "timestamp": "00:29:12", "text": "我家对面那栋房子有一盏小灯。"}, {"type": "subtitle", "time": 1754.645, "timestamp": "00:29:14", "text": "楼下，一楼。"}, {"type": "subtitle", "time": 1758.481, "timestamp": "00:29:18", "text": "这是一套公寓，所以没有"}, {"type": "subtitle", "time": 1764.198, "timestamp": "00:29:24", "text": "这很重要。这里好安静。是  大家都在等吗？他们回到家，"}, {"type": "subtitle", "time": 1766.99, "timestamp": "00:29:26", "text": "大家都在等吗？他们回到家， 他们吃点东西，睡着，然后……"}, {"type": "subtitle", "time": 1769.237, "timestamp": "00:29:29", "text": "他们吃点东西，睡着，然后…… 他们大约凌晨3点或4点醒来。"}, {"type": "subtitle", "time": 1771.894, "timestamp": "00:29:31", "text": "他们大约凌晨3点或4点醒来。 是。开始工作。是这样吗？"}, {"type": "subtitle", "time": 1776.43, "timestamp": "00:29:36", "text": "是。开始工作。是这样吗？ 文化？我觉得这让你"}, {"type": "subtitle", "time": 1779.556, "timestamp": "00:29:39", "text": "文化？我觉得这让你 现在提出质疑。我希望我能"}, {"type": "subtitle", "time": 1783.165, "timestamp": "00:29:43", "text": "现在提出质疑。我希望我能 问别人这个问题"}, {"type": "subtitle", "time": 1784.8220000000001, "timestamp": "00:29:44", "text": "问别人这个问题 日本人。那很有意思。如果这事发生在我身上"}, {"type": "subtitle", "time": 1789.166, "timestamp": "00:29:49", "text": "日本人。那很有意思。如果这事发生在我身上 你问我问题。真的，真的"}, {"type": "subtitle", "time": 1792.701, "timestamp": "00:29:52", "text": "你问我问题。真的，真的 说实话，挺有意思的。"}]
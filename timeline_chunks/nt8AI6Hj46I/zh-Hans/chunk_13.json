[{"type": "subtitle", "time": 790.079, "timestamp": "00:13:10", "text": "兄弟，我到这儿了吗？等等，怎么会这样"}, {"type": "subtitle", "time": 793.962, "timestamp": "00:13:13", "text": "我到了这里？我不是越界了吗？"}, {"type": "subtitle", "time": 796.236, "timestamp": "00:13:16", "text": "街道、主要街道等等 ？哦，是的，我做了。嘿。哦好的。"}, {"type": "subtitle", "time": 802.735, "timestamp": "00:13:22", "text": "？哦，是的，我做了。嘿。哦好的。 我们可以走这条路。快点。今天。仅有的"}, {"type": "subtitle", "time": 806.488, "timestamp": "00:13:26", "text": "我们可以走这条路。快点。今天。仅有的 我在走路。我在走路。我是"}, {"type": "subtitle", "time": 808.765, "timestamp": "00:13:28", "text": "我在走路。我在走路。我是 步行。我们真的到达这里了。"}, {"type": "subtitle", "time": 815.853, "timestamp": "00:13:35", "text": "我认识这个地方。忘了它。"}, {"type": "subtitle", "time": 819.079, "timestamp": "00:13:39", "text": "忘了它。忘了它。等待。是吗？"}, {"type": "subtitle", "time": 823.095, "timestamp": "00:13:43", "text": "相同的？呃，等等。看起来有点"}, {"type": "subtitle", "time": 826.296, "timestamp": "00:13:46", "text": "不同的。啊，原来是同一个地方。"}, {"type": "subtitle", "time": 829.189, "timestamp": "00:13:49", "text": "哦是的。哦是的。是的。这是"}, {"type": "subtitle", "time": 831.965, "timestamp": "00:13:51", "text": "学校之类的。哦是的。哦是的。"}, {"type": "subtitle", "time": 834.929, "timestamp": "00:13:54", "text": "是的。是的。是的。我在这里待的时间更长"}, {"type": "subtitle", "time": 839.067, "timestamp": "00:13:59", "text": "今天放学后很早就开始了。在"}]
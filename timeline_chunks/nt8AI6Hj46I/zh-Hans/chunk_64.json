[{"type": "subtitle", "time": 3847.363, "timestamp": "01:04:07", "text": "那。是的。但是，是的，障碍 语言障碍以及不知道该说什么或如何表达"}, {"type": "subtitle", "time": 3849.865, "timestamp": "01:04:09", "text": "语言障碍以及不知道该说什么或如何表达 开始对话等等。查找"}, {"type": "subtitle", "time": 3855.176, "timestamp": "01:04:15", "text": "开始对话等等。查找 共同利益等等。这非常困难。"}, {"type": "subtitle", "time": 3863.746, "timestamp": "01:04:23", "text": "是的，也许我就是这么觉得的。"}, {"type": "subtitle", "time": 3865.889, "timestamp": "01:04:25", "text": "我觉得这非常困难。"}, {"type": "subtitle", "time": 3867.921, "timestamp": "01:04:27", "text": "因为他几乎没有人手。"}, {"type": "subtitle", "time": 3874.29, "timestamp": "01:04:34", "text": "除了家人以外，我不会跟任何人说话。呃，就像"}, {"type": "subtitle", "time": 3876.665, "timestamp": "01:04:36", "text": "这些年来，你一直在成长。"}, {"type": "subtitle", "time": 3878.554, "timestamp": "01:04:38", "text": "朋友们，然后他们都各自散去了。"}, {"type": "subtitle", "time": 3888.179, "timestamp": "01:04:48", "text": "各不相同，等等。或许这就是原因"}, {"type": "subtitle", "time": 3890.399, "timestamp": "01:04:50", "text": "我见到别人时还是会害羞。"}, {"type": "subtitle", "time": 3892.164, "timestamp": "01:04:52", "text": "并与人交谈，我保持"}, {"type": "subtitle", "time": 3894.271, "timestamp": "01:04:54", "text": "与人保持密切联系"}, {"type": "subtitle", "time": 3896.435, "timestamp": "01:04:56", "text": "我跟他们说话，认识我的人等等。"}]
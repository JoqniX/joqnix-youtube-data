[{"type": "subtitle", "time": 3420.011, "timestamp": "00:57:00", "text": "我会坐在商店旁边说 我坐下时，你好。哇，你真是个……"}, {"type": "subtitle", "time": 3422.076, "timestamp": "00:57:02", "text": "我坐下时，你好。哇，你真是个…… 性格外向的卡莉。你就像"}, {"type": "subtitle", "time": 3424.661, "timestamp": "00:57:04", "text": "性格外向的卡莉。你就像 正常，正常之类的。朋友，我是"}, {"type": "subtitle", "time": 3427.725, "timestamp": "00:57:07", "text": "正常，正常之类的。朋友，我是 好害羞。我根本不想说话。"}, {"type": "subtitle", "time": 3434.73, "timestamp": "00:57:14", "text": "我的想法是，去和他们谈谈。去"}, {"type": "subtitle", "time": 3437.084, "timestamp": "00:57:17", "text": "和他们谈谈。去和他们谈谈。你必须"}, {"type": "subtitle", "time": 3440.002, "timestamp": "00:57:20", "text": "讲话。别错过。我的"}, {"type": "subtitle", "time": 3442.122, "timestamp": "00:57:22", "text": "我的大脑和我的思维总是告诉我这一点。"}, {"type": "subtitle", "time": 3444.189, "timestamp": "00:57:24", "text": "嘿，你得交朋友，你得……"}, {"type": "subtitle", "time": 3447.874, "timestamp": "00:57:27", "text": "和当地人聊聊。但我做不到。是"}, {"type": "subtitle", "time": 3453.543, "timestamp": "00:57:33", "text": "太害羞了。而那种羞怯正是"}, {"type": "subtitle", "time": 3458.367, "timestamp": "00:57:38", "text": "那会让我很痛苦，或者诸如此类。不"}, {"type": "subtitle", "time": 3475.347, "timestamp": "00:57:55", "text": "我知道。但是如果。不，那不行，但是"}]
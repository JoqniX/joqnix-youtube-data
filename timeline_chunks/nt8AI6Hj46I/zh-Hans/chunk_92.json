[{"type": "subtitle", "time": 5522.687, "timestamp": "01:32:02", "text": "评论。我听到一个声音。喷口 它目前还没有应用程序。"}, {"type": "subtitle", "time": 5524.382, "timestamp": "01:32:04", "text": "它目前还没有应用程序。 补充。是的。是的。是的。所以"}, {"type": "subtitle", "time": 5531.438, "timestamp": "01:32:11", "text": "我认为你的想法是，呃，做……"}, {"type": "subtitle", "time": 5534.109, "timestamp": "01:32:14", "text": "从你的手机串流并发送"}, {"type": "subtitle", "time": 5536.643, "timestamp": "01:32:16", "text": "通过 Spout 发送信号，然后，呃，另一个"}, {"type": "subtitle", "time": 5539.315, "timestamp": "01:32:19", "text": "手机或 OBS 可以接收那个，呃，"}, {"type": "subtitle", "time": 5541.712, "timestamp": "01:32:21", "text": "通过工具发出信号"}, {"type": "subtitle", "time": 5544.758, "timestamp": "01:32:24", "text": "补充。真的？所以你"}, {"type": "subtitle", "time": 5546.631, "timestamp": "01:32:26", "text": "主传输编码器"}, {"type": "subtitle", "time": 5548.504, "timestamp": "01:32:28", "text": "这是你的手机，你仍然可以添加内容"}, {"type": "subtitle", "time": 5553.188, "timestamp": "01:32:33", "text": "呃，电脑里的东西等等。真的吗？"}, {"type": "subtitle", "time": 5557.267, "timestamp": "01:32:37", "text": "这与NDI类似。所以有"}, {"type": "subtitle", "time": 5564.937, "timestamp": "01:32:44", "text": "很多事情。但说实话，"}, {"type": "subtitle", "time": 5567.364, "timestamp": "01:32:47", "text": "各位，我的意思是，我必须给予……"}, {"type": "subtitle", "time": 5572.349, "timestamp": "01:32:52", "text": "感谢 Ursan，呃，嗯，比如，"}, {"type": "subtitle", "time": 5576.145, "timestamp": "01:32:56", "text": "感谢 Uricin 提交此申请。是的"}, {"type": "subtitle", "time": 5578.227, "timestamp": "01:32:58", "text": "他不会告诉我“我做了……”"}]
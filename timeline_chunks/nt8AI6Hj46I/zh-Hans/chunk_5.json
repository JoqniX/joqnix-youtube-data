[{"type": "subtitle", "time": 300.331, "timestamp": "00:05:00", "text": "位于前面。你已经证明了。我做到了。"}, {"type": "subtitle", "time": 305.49, "timestamp": "00:05:05", "text": "我的意思是，如果你已经看过的话。你好吗"}, {"type": "subtitle", "time": 307.867, "timestamp": "00:05:07", "text": "日本？你想家吗？仍然"}, {"type": "subtitle", "time": 311.102, "timestamp": "00:05:11", "text": "我感觉自己不像是在日本。我不知道"}, {"type": "subtitle", "time": 314.17, "timestamp": "00:05:14", "text": "在哪里。我仍然感觉自己不在状态。"}, {"type": "subtitle", "time": 316.738, "timestamp": "00:05:16", "text": "日本。说实话，我觉得我"}, {"type": "subtitle", "time": 321.078, "timestamp": "00:05:21", "text": "旅行。是的，就是这里。"}, {"type": "subtitle", "time": 324.385, "timestamp": "00:05:24", "text": "直的。就是那个公园。公园"}, {"type": "subtitle", "time": 328.038, "timestamp": "00:05:28", "text": "大的。我今天不去公园。仅有的"}, {"type": "subtitle", "time": 330.444, "timestamp": "00:05:30", "text": "我今天打算出去散步。我只是想"}, {"type": "subtitle", "time": 333.858, "timestamp": "00:05:33", "text": "外部。你在哪里？我只是"}, {"type": "subtitle", "time": 337.984, "timestamp": "00:05:37", "text": "现在正在行走。我正要进去。那里有"}, {"type": "subtitle", "time": 340.028, "timestamp": "00:05:40", "text": "蚊子很多。这到底是怎么回事？"}, {"type": "subtitle", "time": 342.192, "timestamp": "00:05:42", "text": "日本有蚊子。你知道吗？"}, {"type": "subtitle", "time": 346.265, "timestamp": "00:05:46", "text": "这种情况并非只发生在印度。我以为我"}, {"type": "subtitle", "time": 348.193, "timestamp": "00:05:48", "text": "可以解决蚊子问题"}, {"type": "subtitle", "time": 352.007, "timestamp": "00:05:52", "text": "从印度来到另一个国家。但"}, {"type": "subtitle", "time": 355.731, "timestamp": "00:05:55", "text": "夏天简直是噩梦。太多了。"}]
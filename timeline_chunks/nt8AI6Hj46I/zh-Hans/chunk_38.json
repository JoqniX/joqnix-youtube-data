[{"type": "subtitle", "time": 2281.957, "timestamp": "00:38:01", "text": "目前没什么特别的。好的。呃，有什么事吗……？ 这是毛绒玩具还是人的头颅？"}, {"type": "subtitle", "time": 2288.316, "timestamp": "00:38:08", "text": "告诉我这是人的头还是……"}, {"type": "subtitle", "time": 2295.201, "timestamp": "00:38:15", "text": "泰迪熊。好的。你看到了吗？你看到了吗？ 你看到了吗？那是某人的头吗？或者"}, {"type": "subtitle", "time": 2298.477, "timestamp": "00:38:18", "text": "你看到了吗？那是某人的头吗？或者 这是毛绒玩具吗？搞什么鬼？什么"}, {"type": "subtitle", "time": 2301.548, "timestamp": "00:38:21", "text": "这是毛绒玩具吗？搞什么鬼？什么 那到底是什么东西？"}, {"type": "subtitle", "time": 2310.962, "timestamp": "00:38:30", "text": "那到底是什么东西？我勒个去"}, {"type": "subtitle", "time": 2314.452, "timestamp": "00:38:34", "text": "就这些吗？而那道光就像……"}, {"type": "subtitle", "time": 2318.128, "timestamp": "00:38:38", "text": "可怕的疯狂。谁放了一个"}, {"type": "subtitle", "time": 2320.266, "timestamp": "00:38:40", "text": "蓝光，就像你身处……"}, {"type": "subtitle", "time": 2322.656, "timestamp": "00:38:42", "text": "精神病院，是的，好像……"}, {"type": "subtitle", "time": 2324.857, "timestamp": "00:38:44", "text": "你玩过《生化危机》之类的游戏吗？"}, {"type": "subtitle", "time": 2327.372, "timestamp": "00:38:47", "text": "医院灯光是蓝色的"}, {"type": "subtitle", "time": 2331.051, "timestamp": "00:38:51", "text": "那又怎样，兄弟？那是什么？那是什么？"}, {"type": "subtitle", "time": 2335.074, "timestamp": "00:38:55", "text": "兄弟，那是什么？那是什么？哦，上帝"}, {"type": "subtitle", "time": 2337.896, "timestamp": "00:38:57", "text": "矿。确实很可怕。夜幕降临了。"}]
[{"type": "subtitle", "time": 1743.51, "timestamp": "00:29:03", "text": "减少与他人的接触。"}, {"type": "subtitle", "time": 1753.909, "timestamp": "00:29:13", "text": "对，设为无限量，这样就行了。"}, {"type": "subtitle", "time": 1755.59, "timestamp": "00:29:15", "text": "有人真的很想……"}, {"type": "subtitle", "time": 1759.029, "timestamp": "00:29:19", "text": "他们必须主动联系才能建立联系"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "连接类型的官方方法"}, {"type": "subtitle", "time": 1763.75, "timestamp": "00:29:23", "text": "东西"}, {"type": "subtitle", "time": 1767.43, "timestamp": "00:29:27", "text": "因为如果我保持沟通渠道畅通的话。"}, {"type": "subtitle", "time": 1769.029, "timestamp": "00:29:29", "text": "打开"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "诡异的"}, {"type": "subtitle", "time": 1775.99, "timestamp": "00:29:35", "text": "卑鄙的人也会混进来。不，就像这些DFS（每日梦幻体育）一样。"}, {"type": "subtitle", "time": 1779.51, "timestamp": "00:29:39", "text": "机器人，甚至包括 Discord。"}, {"type": "subtitle", "time": 1782.789, "timestamp": "00:29:42", "text": "我不再添加好友的原因是"}, {"type": "subtitle", "time": 1784.71, "timestamp": "00:29:44", "text": "让我拉取消息给我 Discord"}, {"type": "subtitle", "time": 1799.19, "timestamp": "00:29:59", "text": "我发现我不知道什么方法有效。什么"}]
[{"type": "subtitle", "time": 17703.19, "timestamp": "04:55:03", "text": "耐心 病人 这件艺术品是"}, {"type": "subtitle", "time": 17706.948, "timestamp": "04:55:06", "text": "去年八月，在我生日那天完成的。"}, {"type": "subtitle", "time": 17709.75, "timestamp": "04:55:09", "text": "12号，呃，8月11日是我的生日。所以"}, {"type": "subtitle", "time": 17712.948, "timestamp": "04:55:12", "text": "我生日过后，收到了这个。而我是"}, {"type": "subtitle", "time": 17716.39, "timestamp": "04:55:16", "text": "超级开心，因为这简直太棒了"}, {"type": "subtitle", "time": 17719.83, "timestamp": "04:55:19", "text": "现在就可以买到生日礼物。就像我"}, {"type": "subtitle", "time": 17722.868, "timestamp": "04:55:22", "text": "我尽力融入了"}, {"type": "subtitle", "time": 17726.628, "timestamp": "04:55:26", "text": "Joex 的初始设计，并使其成型。"}, {"type": "subtitle", "time": 17728.788, "timestamp": "04:55:28", "text": "更具原创性，并且可以"}, {"type": "subtitle", "time": 17732.868, "timestamp": "04:55:32", "text": "适合，因为嗯，我的声音有些人"}, {"type": "subtitle", "time": 17735.51, "timestamp": "04:55:35", "text": "现在因为性别问题而感到困惑。"}, {"type": "subtitle", "time": 17738.07, "timestamp": "04:55:38", "text": "一切都结束了，我就想，是啊，我是"}, {"type": "subtitle", "time": 17740.55, "timestamp": "04:55:40", "text": "会让你更加困惑"}, {"type": "subtitle", "time": 17744.708, "timestamp": "04:55:44", "text": "模型外观可能会更加令人困惑。"}, {"type": "subtitle", "time": 17748.07, "timestamp": "04:55:48", "text": "完美的。我喜欢这种活力。"}, {"type": "subtitle", "time": 17750.788, "timestamp": "04:55:50", "text": "是的。所以，就像是，笑话就是一个"}, {"type": "subtitle", "time": 17754.23, "timestamp": "04:55:54", "text": "星座。所以，呃，就像谣言一样"}, {"type": "subtitle", "time": 17757.75, "timestamp": "04:55:57", "text": "暴风雪，一部以史莱姆为主题的动画。所以它可以"}]
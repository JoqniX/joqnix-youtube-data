[{"type": "subtitle", "time": 19500.788, "timestamp": "05:25:00", "text": "当时有个实习生来自"}, {"type": "subtitle", "time": 19503.67, "timestamp": "05:25:03", "text": "王位对……感兴趣。"}, {"type": "subtitle", "time": 19506.55, "timestamp": "05:25:06", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 19508.788, "timestamp": "05:25:08", "text": "那个人给了"}, {"type": "subtitle", "time": 19511.43, "timestamp": "05:25:11", "text": "联系某人"}, {"type": "subtitle", "time": 19514.788, "timestamp": "05:25:14", "text": "嗯，是的，我联系过那个人。"}, {"type": "subtitle", "time": 19517.43, "timestamp": "05:25:17", "text": "来自 Discord 的联系，他们仍然"}, {"type": "subtitle", "time": 19520.15, "timestamp": "05:25:20", "text": "对任何事情都没有回应。"}, {"type": "subtitle", "time": 19523.03, "timestamp": "05:25:23", "text": "因为我想添加一些画中的人物。"}, {"type": "subtitle", "time": 19525.59, "timestamp": "05:25:25", "text": "那里用的是印度卢比，所以更贵一些。"}, {"type": "subtitle", "time": 19528.708, "timestamp": "05:25:28", "text": "现在更容易了。那其实是我的"}, {"type": "subtitle", "time": 19530.788, "timestamp": "05:25:30", "text": "给他们的建议也像其中之一一样"}, {"type": "subtitle", "time": 19535.51, "timestamp": "05:25:35", "text": "比如印度货币，还有两个，呃……"}, {"type": "subtitle", "time": 19538.628, "timestamp": "05:25:38", "text": "是的，人们通过它添加了UPI"}, {"type": "subtitle", "time": 19541.75, "timestamp": "05:25:41", "text": "将会有一个非常好的市场"}, {"type": "subtitle", "time": 19543.91, "timestamp": "05:25:43", "text": "印度"}, {"type": "subtitle", "time": 19546.708, "timestamp": "05:25:46", "text": "因为我们有很多内容创作者"}, {"type": "subtitle", "time": 19549.67, "timestamp": "05:25:49", "text": "嗯，我觉得最大的问题是"}, {"type": "subtitle", "time": 19552.628, "timestamp": "05:25:52", "text": "王座附带的部分是……"}, {"type": "subtitle", "time": 19555.27, "timestamp": "05:25:55", "text": "他们目前不接受UPI付款。"}, {"type": "subtitle", "time": 19557.35, "timestamp": "05:25:57", "text": "是的，"}]
[{"type": "subtitle", "time": 14700.71, "timestamp": "04:05:00", "text": "谁性格外向，我不知道。"}, {"type": "subtitle", "time": 14703.59, "timestamp": "04:05:03", "text": "是的。"}, {"type": "subtitle", "time": 14708.95, "timestamp": "04:05:08", "text": "等等，你是外向型人吗？"}, {"type": "subtitle", "time": 14712.229, "timestamp": "04:05:12", "text": "像我这样的内向者？我性格比较内向。"}, {"type": "subtitle", "time": 14715.91, "timestamp": "04:05:15", "text": "我喜欢的东西，我能生存下来，呃，就像"}, {"type": "subtitle", "time": 14718.389, "timestamp": "04:05:18", "text": "我这就扮演另一个人的角色。"}, {"type": "subtitle", "time": 14720.79, "timestamp": "04:05:20", "text": "谁能……你知道的，把……交给……"}, {"type": "subtitle", "time": 14724.63, "timestamp": "04:05:24", "text": "社交互动等等，但……"}, {"type": "subtitle", "time": 14726.55, "timestamp": "04:05:26", "text": "最后，如果我能做到的话，我只会……"}, {"type": "subtitle", "time": 14731.83, "timestamp": "04:05:31", "text": "我尽量避免出门，我会看到的。"}, {"type": "subtitle", "time": 14735.11, "timestamp": "04:05:35", "text": "我的天啊，SP那边出问题了。"}, {"type": "subtitle", "time": 14737.03, "timestamp": "04:05:37", "text": "有时候，因为我知道我必须走了"}, {"type": "subtitle", "time": 14740.07, "timestamp": "04:05:40", "text": "出去做这件事，但回家后感觉很舒服"}, {"type": "subtitle", "time": 14742.309, "timestamp": "04:05:42", "text": "家。"}, {"type": "subtitle", "time": 14745.189, "timestamp": "04:05:45", "text": "就像他们说的，没有床是这样的"}, {"type": "subtitle", "time": 14747.99, "timestamp": "04:05:47", "text": "空腔。一旦睡着了，就很难……"}, {"type": "subtitle", "time": 14751.189, "timestamp": "04:05:51", "text": "起来吧，伙计。"}, {"type": "subtitle", "time": 14753.99, "timestamp": "04:05:53", "text": "这就是我。"}, {"type": "subtitle", "time": 14757.67, "timestamp": "04:05:57", "text": "我的天啊。这就是我。是的。好的。露娜"}]
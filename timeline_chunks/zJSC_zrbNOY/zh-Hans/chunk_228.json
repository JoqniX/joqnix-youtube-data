[{"type": "subtitle", "time": 13685.189, "timestamp": "03:48:05", "text": "呃"}, {"type": "subtitle", "time": 13687.75, "timestamp": "03:48:07", "text": "太多事情了。"}, {"type": "subtitle", "time": 13690.309, "timestamp": "03:48:10", "text": "我。你也是吗？你是什么时候开始的？"}, {"type": "subtitle", "time": 13692.79, "timestamp": "03:48:12", "text": "最初是流媒体播放吗？"}, {"type": "subtitle", "time": 13697.03, "timestamp": "03:48:17", "text": "嗯，我的好像是两年前吧。"}, {"type": "subtitle", "time": 13698.95, "timestamp": "03:48:18", "text": "是的。是的。一年前。两年"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "后退。我想应该是两年前吧。啊"}, {"type": "subtitle", "time": 13706.63, "timestamp": "03:48:26", "text": "好的。是什么让你开始从事直播的？"}, {"type": "subtitle", "time": 13710.229, "timestamp": "03:48:30", "text": "我认为不用，再等一年。"}, {"type": "subtitle", "time": 13712.229, "timestamp": "03:48:32", "text": "我现在都记不起来了。"}, {"type": "subtitle", "time": 13715.11, "timestamp": "03:48:35", "text": "没关系。哦。呃，"}, {"type": "subtitle", "time": 13717.11, "timestamp": "03:48:37", "text": "更像是我有了源源不断的……"}, {"type": "subtitle", "time": 13720.469, "timestamp": "03:48:40", "text": "我和朋友们经常会在聊天室里。"}, {"type": "subtitle", "time": 13722.95, "timestamp": "03:48:42", "text": "然后如果有人找到了它，他们就会……"}, {"type": "subtitle", "time": 13724.71, "timestamp": "03:48:44", "text": "有人开始暗示我或许应该试试"}, {"type": "subtitle", "time": 13726.309, "timestamp": "03:48:46", "text": "也。"}, {"type": "subtitle", "time": 13728.389, "timestamp": "03:48:48", "text": "一开始我就想，不行，我不去了。"}, {"type": "subtitle", "time": 13731.99, "timestamp": "03:48:51", "text": "这件事本来可能会发生，但后来我想，也许吧"}]
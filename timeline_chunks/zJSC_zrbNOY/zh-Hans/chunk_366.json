[{"type": "subtitle", "time": 21960.628, "timestamp": "06:06:00", "text": "一个"}, {"type": "subtitle", "time": 21963.83, "timestamp": "06:06:03", "text": "等等，你经常吃外面的食物吗？"}, {"type": "subtitle", "time": 21968.868, "timestamp": "06:06:08", "text": "喜欢家常菜吗？嗯，我的意思是……"}, {"type": "subtitle", "time": 21971.35, "timestamp": "06:06:11", "text": "嗯，最近我更多地在家吃饭了。"}, {"type": "subtitle", "time": 21973.03, "timestamp": "06:06:13", "text": "食物。我喜欢，或者，我只是……"}, {"type": "subtitle", "time": 21975.43, "timestamp": "06:06:15", "text": "烹饪一些我喜欢的东西"}, {"type": "subtitle", "time": 21980.31, "timestamp": "06:06:20", "text": "把自己吃掉。嗯。但是，呃，我觉得有点"}, {"type": "subtitle", "time": 21983.11, "timestamp": "06:06:23", "text": "前段时间我有很多……"}, {"type": "subtitle", "time": 21987.03, "timestamp": "06:06:27", "text": "嗯，垃圾食品，还有外面的那种，但是很友善"}, {"type": "subtitle", "time": 21989.19, "timestamp": "06:06:29", "text": "我感觉自己好像在往上戴那个东西，呃，我的"}, {"type": "subtitle", "time": 21991.19, "timestamp": "06:06:31", "text": "也上大学吧，因为我觉得你会去"}, {"type": "subtitle", "time": 21995.19, "timestamp": "06:06:35", "text": "为了我的课程，呃，会有这么多。"}, {"type": "subtitle", "time": 21998.47, "timestamp": "06:06:38", "text": "就像事情之间的时间间隔缩短了一样。所以"}, {"type": "subtitle", "time": 22001.75, "timestamp": "06:06:41", "text": "我有时会不吃午饭，或者"}, {"type": "subtitle", "time": 22003.51, "timestamp": "06:06:43", "text": "就吃有什么就吃什么吧。"}, {"type": "subtitle", "time": 22005.03, "timestamp": "06:06:45", "text": "食堂条件一般。这是"}, {"type": "subtitle", "time": 22014.868, "timestamp": "06:06:54", "text": "所以这种情况经常发生，然后……"}, {"type": "subtitle", "time": 22018.548, "timestamp": "06:06:58", "text": "一切"}]
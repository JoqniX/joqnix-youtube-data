[{"type": "subtitle", "time": 21603.35, "timestamp": "06:00:03", "text": "我的天哪，所以我就想，是啊，当我"}, {"type": "subtitle", "time": 21606.47, "timestamp": "06:00:06", "text": "我小时候就长大了，呃，就像我小时候那样"}, {"type": "subtitle", "time": 21609.43, "timestamp": "06:00:09", "text": "以前他会送我去学校，然后"}, {"type": "subtitle", "time": 21612.23, "timestamp": "06:00:12", "text": "东西。所以当我看到他这样做的时候"}, {"type": "subtitle", "time": 21616.628, "timestamp": "06:00:16", "text": "他无论去哪里都带着自行车，而且"}, {"type": "subtitle", "time": 21618.628, "timestamp": "06:00:18", "text": "他总是喜欢向人们挥手。"}, {"type": "subtitle", "time": 21620.47, "timestamp": "06:00:20", "text": "以及人们"}, {"type": "subtitle", "time": 21622.868, "timestamp": "06:00:22", "text": "很久以前之类的。我心想，到底有多少人？"}, {"type": "subtitle", "time": 21625.27, "timestamp": "06:00:25", "text": "你到处都有朋友吗？每一个"}, {"type": "subtitle", "time": 21629.11, "timestamp": "06:00:29", "text": "我们去的每一个地方，每个人都知道这条路。"}, {"type": "subtitle", "time": 21631.03, "timestamp": "06:00:31", "text": "你。所以，从那时起，我就一直想着："}, {"type": "subtitle", "time": 21634.07, "timestamp": "06:00:34", "text": "“是啊，我长大后想成为更优秀的人。”"}, {"type": "subtitle", "time": 21638.47, "timestamp": "06:00:38", "text": "我希望有一天能成为像我爸爸那样善于交际的人。"}, {"type": "subtitle", "time": 21640.948, "timestamp": "06:00:40", "text": "是的，我长大后，我就觉得"}, {"type": "subtitle", "time": 21644.07, "timestamp": "06:00:44", "text": "与他截然相反。我当时"}, {"type": "subtitle", "time": 21647.51, "timestamp": "06:00:47", "text": "内向，有点像沙泰因那种类型，"}, {"type": "subtitle", "time": 21654.788, "timestamp": "06:00:54", "text": "我的天啊。"}, {"type": "subtitle", "time": 21658.39, "timestamp": "06:00:58", "text": "是的。从那时起，哦，是的。呃，之后"}]
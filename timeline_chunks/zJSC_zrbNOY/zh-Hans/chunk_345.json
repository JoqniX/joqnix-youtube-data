[{"type": "subtitle", "time": 20701.11, "timestamp": "05:45:01", "text": "这是真的。"}, {"type": "subtitle", "time": 20704.07, "timestamp": "05:45:04", "text": "你"}, {"type": "subtitle", "time": 20706.868, "timestamp": "05:45:06", "text": "因为我呃去问我爸了，就像"}, {"type": "subtitle", "time": 20709.11, "timestamp": "05:45:09", "text": "像乞讨一样"}, {"type": "subtitle", "time": 20711.43, "timestamp": "05:45:11", "text": "最初在做运动员之前就像"}, {"type": "subtitle", "time": 20714.31, "timestamp": "05:45:14", "text": "成为一名 YouTuber 之前，我一直很喜欢音乐。"}, {"type": "subtitle", "time": 20716.23, "timestamp": "05:45:16", "text": "音乐制作相关的东西等等"}, {"type": "subtitle", "time": 20718.39, "timestamp": "05:45:18", "text": "这就是我创作《Jock Next》的原因，因为我想要"}, {"type": "subtitle", "time": 20721.43, "timestamp": "05:45:21", "text": "发行我的音乐并拥有一个"}, {"type": "subtitle", "time": 20723.75, "timestamp": "05:45:23", "text": "艺术家姓名以及所有与音乐相关的内容"}, {"type": "subtitle", "time": 20725.35, "timestamp": "05:45:25", "text": "让人们快乐，等等等等"}, {"type": "subtitle", "time": 20728.47, "timestamp": "05:45:28", "text": "我当时就像我以前经常翻看一样。"}, {"type": "subtitle", "time": 20730.788, "timestamp": "05:45:30", "text": "YouTube教程和学习，但我没能"}, {"type": "subtitle", "time": 20732.788, "timestamp": "05:45:32", "text": "比如创意博客、音乐博客之类的。"}, {"type": "subtitle", "time": 20735.35, "timestamp": "05:45:35", "text": "我当时就想，啊，我做不到。所以"}, {"type": "subtitle", "time": 20737.11, "timestamp": "05:45:37", "text": "我就是这样开始做YouTube的。"}, {"type": "subtitle", "time": 20740.39, "timestamp": "05:45:40", "text": "发现其他细分领域，比如……是什么"}, {"type": "subtitle", "time": 20743.51, "timestamp": "05:45:43", "text": "我擅长的一切都很好。"}, {"type": "subtitle", "time": 20747.91, "timestamp": "05:45:47", "text": "我当时就想，我在Instagram上看到了这个广告……"}, {"type": "subtitle", "time": 20749.51, "timestamp": "05:45:49", "text": "有人喜欢做音乐制作"}, {"type": "subtitle", "time": 20751.27, "timestamp": "05:45:51", "text": "课程和所有的一切。我试用了他们的"}, {"type": "subtitle", "time": 20753.67, "timestamp": "05:45:53", "text": "免费试用版，类似为期两天的入门课程"}, {"type": "subtitle", "time": 20755.99, "timestamp": "05:45:55", "text": "营。我当时就想，“哦，他们是什么？”"}, {"type": "subtitle", "time": 20758.868, "timestamp": "05:45:58", "text": "我学习过教书这门学科。"}]
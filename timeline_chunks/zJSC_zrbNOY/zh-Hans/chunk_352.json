[{"type": "subtitle", "time": 21121.83, "timestamp": "05:52:01", "text": "5月。是的，五月。现在已经是六月了，"}, {"type": "subtitle", "time": 21124.31, "timestamp": "05:52:04", "text": "正确的？所以我必须慢慢付钱给他们。"}, {"type": "subtitle", "time": 21127.99, "timestamp": "05:52:07", "text": "那。是的。但是课程很好。"}, {"type": "subtitle", "time": 21129.99, "timestamp": "05:52:09", "text": "但问题就在于……"}, {"type": "subtitle", "time": 21132.868, "timestamp": "05:52:12", "text": "这种事，你得让步。"}, {"type": "subtitle", "time": 21135.35, "timestamp": "05:52:15", "text": "至少一两个小时，对吧，到这些"}, {"type": "subtitle", "time": 21137.59, "timestamp": "05:52:17", "text": "在音乐、艺术等方面的爱好"}, {"type": "subtitle", "time": 21140.15, "timestamp": "05:52:20", "text": "任何事物。否则你就会输。"}, {"type": "subtitle", "time": 21142.39, "timestamp": "05:52:22", "text": "就是那种感觉，对吧？你会忘记该做什么"}, {"type": "subtitle", "time": 21145.27, "timestamp": "05:52:25", "text": "做那些事。这就是问题所在"}, {"type": "subtitle", "time": 21148.628, "timestamp": "05:52:28", "text": "我。呃，即使我当时正在参加 Joathon 活动"}, {"type": "subtitle", "time": 21150.31, "timestamp": "05:52:30", "text": "整整24小时，我都在……"}, {"type": "subtitle", "time": 21151.91, "timestamp": "05:52:31", "text": "直播和所有相关内容"}, {"type": "subtitle", "time": 21155.11, "timestamp": "05:52:35", "text": "凡事都有例外，有时我无法做到。"}, {"type": "subtitle", "time": 21157.59, "timestamp": "05:52:37", "text": "做音乐相关的事情。要么会是"}, {"type": "subtitle", "time": 21159.91, "timestamp": "05:52:39", "text": "合作或我参加的活动或"}, {"type": "subtitle", "time": 21162.628, "timestamp": "05:52:42", "text": "我的世界之类的东西，或者别的什么，或者"}, {"type": "subtitle", "time": 21165.03, "timestamp": "05:52:45", "text": "也许我会非常累。我会"}, {"type": "subtitle", "time": 21168.708, "timestamp": "05:52:48", "text": "我一直拖延着不做这件事，然后我就想，“啊，"}, {"type": "subtitle", "time": 21171.27, "timestamp": "05:52:51", "text": "对不起。我无法提交我的"}, {"type": "subtitle", "time": 21173.43, "timestamp": "05:52:53", "text": "家庭作业"}, {"type": "subtitle", "time": 21178.07, "timestamp": "05:52:58", "text": "就像那样。”但是，是的，我意识到……"}, {"type": "subtitle", "time": 21179.91, "timestamp": "05:52:59", "text": "是的，无论什么事，你"}]
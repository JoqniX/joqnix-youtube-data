[{"type": "subtitle", "time": 13801.67, "timestamp": "03:50:01", "text": "赋能、参与，希望你去做"}, {"type": "subtitle", "time": 13804.07, "timestamp": "03:50:04", "text": "你害怕去做某件事，就像……"}, {"type": "subtitle", "time": 13807.59, "timestamp": "03:50:07", "text": "轻轻推你一把，让你去做。喜欢"}, {"type": "subtitle", "time": 13810.469, "timestamp": "03:50:10", "text": "我已做好一切准备。我画了一个模型"}, {"type": "subtitle", "time": 13812.389, "timestamp": "03:50:12", "text": "以及所有的一切。"}, {"type": "subtitle", "time": 13814.55, "timestamp": "03:50:14", "text": "一个"}, {"type": "subtitle", "time": 13816.07, "timestamp": "03:50:16", "text": "然后我就一直坐在那里。"}, {"type": "subtitle", "time": 13829.349, "timestamp": "03:50:29", "text": "很有趣。这段时间很有趣。就像这样"}, {"type": "subtitle", "time": 13832.469, "timestamp": "03:50:32", "text": "很高兴能看一些直播，而且很喜欢。"}, {"type": "subtitle", "time": 13836.469, "timestamp": "03:50:36", "text": "大家就待在一起吧。有"}, {"type": "subtitle", "time": 13838.389, "timestamp": "03:50:38", "text": "有好日子也有坏日子，但没错，就是这样。"}, {"type": "subtitle", "time": 13840.71, "timestamp": "03:50:40", "text": "大部分时间都还不错。"}, {"type": "subtitle", "time": 13843.189, "timestamp": "03:50:43", "text": "你知道，这是一段旅程。"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "而且做起来也更有趣，你可以……"}, {"type": "subtitle", "time": 13855.429, "timestamp": "03:50:55", "text": "任何你想要的。你可以说话"}, {"type": "subtitle", "time": 13858.229, "timestamp": "03:50:58", "text": "倾尽所有。无论你进入你的什么"}]
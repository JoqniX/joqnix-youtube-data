[{"type": "subtitle", "time": 18060.788, "timestamp": "05:01:00", "text": "好吧，也许是时候开始了……"}, {"type": "subtitle", "time": 18064.23, "timestamp": "05:01:04", "text": "我定期练习绘画。我的天啊。"}, {"type": "subtitle", "time": 18065.99, "timestamp": "05:01:05", "text": "是的，"}, {"type": "subtitle", "time": 18071.59, "timestamp": "05:01:11", "text": "确实如此。我的天啊。我知道。"}, {"type": "subtitle", "time": 18073.43, "timestamp": "05:01:13", "text": "这就是为什么我注意到大多数人"}, {"type": "subtitle", "time": 18075.83, "timestamp": "05:01:15", "text": "印度现在一团糟，他们竭尽全力"}, {"type": "subtitle", "time": 18078.788, "timestamp": "05:01:18", "text": "比如学习画画，还有如果他们"}, {"type": "subtitle", "time": 18080.948, "timestamp": "05:01:20", "text": "已经是艺术家的人，很容易就能做到。"}, {"type": "subtitle", "time": 18083.03, "timestamp": "05:01:23", "text": "他们。不，他们只需要学习就行了。"}, {"type": "subtitle", "time": 18087.51, "timestamp": "05:01:27", "text": "2D，是的，去做吧。"}, {"type": "subtitle", "time": 18090.948, "timestamp": "05:01:30", "text": "是的。真是太疯狂了"}, {"type": "subtitle", "time": 18094.23, "timestamp": "05:01:34", "text": "它有多贵。就是这样。"}, {"type": "subtitle", "time": 18095.99, "timestamp": "05:01:35", "text": "我能理解他们的观点。"}, {"type": "subtitle", "time": 18097.75, "timestamp": "05:01:37", "text": "观点也如此，但同时也是"}, {"type": "subtitle", "time": 18099.99, "timestamp": "05:01:39", "text": "只是货币兑换太……"}, {"type": "subtitle", "time": 18102.868, "timestamp": "05:01:42", "text": "对我们来说很高。是的。"}, {"type": "subtitle", "time": 18106.868, "timestamp": "05:01:46", "text": "哎呀。是的。是的。现在是1美元"}, {"type": "subtitle", "time": 18110.23, "timestamp": "05:01:50", "text": "86. 以前是40或50或"}, {"type": "subtitle", "time": 18115.67, "timestamp": "05:01:55", "text": "60卢比。现在感觉真是太棒了。"}, {"type": "subtitle", "time": 18117.83, "timestamp": "05:01:57", "text": "想象一下，有一天它会变成100。"}]
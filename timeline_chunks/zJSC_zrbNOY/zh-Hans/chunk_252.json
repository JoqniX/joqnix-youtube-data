[{"type": "subtitle", "time": 15120.55, "timestamp": "04:12:00", "text": "我想，这大概就是探索吧。"}, {"type": "subtitle", "time": 15124.71, "timestamp": "04:12:04", "text": "然后，嗯，我第一次吃了拉面。"}, {"type": "subtitle", "time": 15128.389, "timestamp": "04:12:08", "text": "感觉就像有家餐厅一样"}, {"type": "subtitle", "time": 15130.63, "timestamp": "04:12:10", "text": "或者我一个朋友"}, {"type": "subtitle", "time": 15134.63, "timestamp": "04:12:14", "text": "把我拖到那儿，还有那玩意儿"}, {"type": "subtitle", "time": 15137.83, "timestamp": "04:12:17", "text": "然后，第一次在这家珍珠奶茶店"}, {"type": "subtitle", "time": 15140.79, "timestamp": "04:12:20", "text": "曾经。哦"}, {"type": "subtitle", "time": 15144.71, "timestamp": "04:12:24", "text": "那些花里胡哨的东西，还有，呃，什么？"}, {"type": "subtitle", "time": 15146.95, "timestamp": "04:12:26", "text": "别的？"}, {"type": "subtitle", "time": 15150.15, "timestamp": "04:12:30", "text": "那到底是什么来着？太多了。"}, {"type": "subtitle", "time": 15152.07, "timestamp": "04:12:32", "text": "北印度菜。我不知道"}, {"type": "subtitle", "time": 15154.71, "timestamp": "04:12:34", "text": "姓名。所以，是啊，那真是太酷了。我"}, {"type": "subtitle", "time": 15157.67, "timestamp": "04:12:37", "text": "当时我就想：“哇，这太棒了。”喜欢，"}, {"type": "subtitle", "time": 15160.15, "timestamp": "04:12:40", "text": "我不知道还可以这样。就像"}, {"type": "subtitle", "time": 15163.189, "timestamp": "04:12:43", "text": "像这样的脚，还有奶酪和"}, {"type": "subtitle", "time": 15165.99, "timestamp": "04:12:45", "text": "东西。哇。"}, {"type": "subtitle", "time": 15169.51, "timestamp": "04:12:49", "text": "你得去探索。"}, {"type": "subtitle", "time": 15171.429, "timestamp": "04:12:51", "text": "是的。"}, {"type": "subtitle", "time": 15173.91, "timestamp": "04:12:53", "text": "好的。"}, {"type": "subtitle", "time": 15178.229, "timestamp": "04:12:58", "text": "就像去年12月那样。怎么"}]
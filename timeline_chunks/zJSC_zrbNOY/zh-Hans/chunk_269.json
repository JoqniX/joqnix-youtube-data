[{"type": "subtitle", "time": 16141.83, "timestamp": "04:29:01", "text": "那些朋友，他们试图"}, {"type": "subtitle", "time": 16144.71, "timestamp": "04:29:04", "text": "也要询问客人，因为他们"}, {"type": "subtitle", "time": 16146.71, "timestamp": "04:29:06", "text": "我们是互关好友，然后问你为什么不……"}, {"type": "subtitle", "time": 16149.99, "timestamp": "04:29:09", "text": "他知道乔克很敏感，所以要保护他。乔克很敏感。"}, {"type": "subtitle", "time": 16153.83, "timestamp": "04:29:13", "text": "诸如此类的事情，嗯，诸如此类。"}, {"type": "subtitle", "time": 16157.349, "timestamp": "04:29:17", "text": "后来我不得不禁止那家伙进入。"}, {"type": "subtitle", "time": 16161.51, "timestamp": "04:29:21", "text": "Discord 和 Twitch，他当时就想：这是什么？"}, {"type": "subtitle", "time": 16164.149, "timestamp": "04:29:24", "text": "我做了吗？然后我给了他一个赞"}, {"type": "subtitle", "time": 16166.79, "timestamp": "04:29:26", "text": "用一段详细的文字描述你做了什么"}, {"type": "subtitle", "time": 16169.75, "timestamp": "04:29:29", "text": "诸如此类的事情。所以那就像……"}, {"type": "subtitle", "time": 16173.349, "timestamp": "04:29:33", "text": "糟糕的经历，从那以后我就一直这样"}, {"type": "subtitle", "time": 16175.99, "timestamp": "04:29:35", "text": "我真的很小心"}, {"type": "subtitle", "time": 16179.429, "timestamp": "04:29:39", "text": "呃，说到观众参与"}, {"type": "subtitle", "time": 16183.03, "timestamp": "04:29:43", "text": "像这样的直播，我现在开始喜欢了"}, {"type": "subtitle", "time": 16188.229, "timestamp": "04:29:48", "text": "别让那些我不喜欢的人……"}, {"type": "subtitle", "time": 16190.71, "timestamp": "04:29:50", "text": "在我的直播间里点赞或一起玩，或者关注我，我都会参与。"}, {"type": "subtitle", "time": 16192.87, "timestamp": "04:29:52", "text": "因为即使我让他们和我一起玩，我也会这么做。"}, {"type": "subtitle", "time": 16195.59, "timestamp": "04:29:55", "text": "游戏内将直接提供语音聊天功能。"}, {"type": "subtitle", "time": 16197.75, "timestamp": "04:29:57", "text": "事情就是这样发生的。他当时在……"}]
[{"type": "subtitle", "time": 13501.51, "timestamp": "03:45:01", "text": "是啊，所以大家都会惊叹：哇！"}, {"type": "subtitle", "time": 13504.71, "timestamp": "03:45:04", "text": "抽搐。所以，我不太确定。他们没有我"}, {"type": "subtitle", "time": 13506.229, "timestamp": "03:45:06", "text": "认为他们会妥善处理此事。"}, {"type": "subtitle", "time": 13510.55, "timestamp": "03:45:10", "text": "就此发布公告。所以，是啊，这很奇怪。"}, {"type": "subtitle", "time": 13513.51, "timestamp": "03:45:13", "text": "Twitch真棒。他们需要得到他们的"}, {"type": "subtitle", "time": 13522.469, "timestamp": "03:45:22", "text": "是的，这样下去最终只会……"}, {"type": "subtitle", "time": 13525.03, "timestamp": "03:45:25", "text": "令人困惑，因为我喜欢这样做"}, {"type": "subtitle", "time": 13527.91, "timestamp": "03:45:27", "text": "直到我看到……之后我才考虑使用YouTube。"}, {"type": "subtitle", "time": 13534.95, "timestamp": "03:45:34", "text": "现在这个"}, {"type": "subtitle", "time": 13537.349, "timestamp": "03:45:37", "text": "你想让我做什么？你做不到。"}, {"type": "subtitle", "time": 13540.55, "timestamp": "03:45:40", "text": "也喜欢看聊天，就像……嗯，以前我……"}, {"type": "subtitle", "time": 13543.51, "timestamp": "03:45:43", "text": "用来在屏幕上显示聊天记录"}, {"type": "subtitle", "time": 13546.389, "timestamp": "03:45:46", "text": "把它分开来看，Twitch 将会是"}, {"type": "subtitle", "time": 13547.99, "timestamp": "03:45:47", "text": "Twitch频道将独立于YouTube。"}, {"type": "subtitle", "time": 13550.229, "timestamp": "03:45:50", "text": "频道将独立设置。要么放"}, {"type": "subtitle", "time": 13553.75, "timestamp": "03:45:53", "text": "它们并排在一起，或者"}, {"type": "subtitle", "time": 13556.07, "timestamp": "03:45:56", "text": "就像左和右一样。"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "我的天哪。"}]
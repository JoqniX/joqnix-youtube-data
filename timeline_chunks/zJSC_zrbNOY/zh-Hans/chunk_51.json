[{"type": "subtitle", "time": 3060.23, "timestamp": "00:51:00", "text": "但也没什么不好。"}, {"type": "subtitle", "time": 3062.63, "timestamp": "00:51:02", "text": "我要在那里待一年。"}, {"type": "subtitle", "time": 3067.43, "timestamp": "00:51:07", "text": "我还能怎么做才对？我说的是实话。"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "相反，他却直接陈述了真相。"}, {"type": "subtitle", "time": 3073.51, "timestamp": "00:51:13", "text": "这事儿就这么发生了，我完全没想到。"}, {"type": "subtitle", "time": 3077.75, "timestamp": "00:51:17", "text": "东西。无论如何，我都会"}, {"type": "subtitle", "time": 3080.549, "timestamp": "00:51:20", "text": "像我一样速通所有崩溃关卡"}, {"type": "subtitle", "time": 3083.99, "timestamp": "00:51:23", "text": "以前做过，但我只做了一个月。"}, {"type": "subtitle", "time": 3085.67, "timestamp": "00:51:25", "text": "尽管。"}, {"type": "subtitle", "time": 3088.15, "timestamp": "00:51:28", "text": "这本身就是一件荒唐事。我感觉"}, {"type": "subtitle", "time": 3090.39, "timestamp": "00:51:30", "text": "喜欢"}, {"type": "subtitle", "time": 3110.549, "timestamp": "00:51:50", "text": "我满脑子想的都是……"}, {"type": "subtitle", "time": 3113.589, "timestamp": "00:51:53", "text": "现在，或者说现在，我满脑子想的都是这些。"}, {"type": "subtitle", "time": 3117.829, "timestamp": "00:51:57", "text": "我的问题是如何实现工作流程自动化。如何"}]
[{"type": "subtitle", "time": 19381.11, "timestamp": "05:23:01", "text": "他们那边也得到了一些帮助，以便能够……"}, {"type": "subtitle", "time": 19382.948, "timestamp": "05:23:02", "text": "听清楚了。"}, {"type": "subtitle", "time": 19385.03, "timestamp": "05:23:05", "text": "但现在比以前好多了，因为……"}, {"type": "subtitle", "time": 19387.35, "timestamp": "05:23:07", "text": "我看到了一些其他人的话语。"}, {"type": "subtitle", "time": 19389.43, "timestamp": "05:23:09", "text": "直播的时候我就想，你怎么能这样？"}, {"type": "subtitle", "time": 19391.59, "timestamp": "05:23:11", "text": "你们都明白我说的意思。"}, {"type": "subtitle", "time": 19401.99, "timestamp": "05:23:21", "text": "是的。"}, {"type": "subtitle", "time": 19411.27, "timestamp": "05:23:31", "text": "等等，那火是怎么回事？"}, {"type": "subtitle", "time": 19414.31, "timestamp": "05:23:34", "text": "就是……"}, {"type": "subtitle", "time": 19418.868, "timestamp": "05:23:38", "text": "有些人觉得，嗯，从背景故事来看，它就像是……"}, {"type": "subtitle", "time": 19421.99, "timestamp": "05:23:41", "text": "它一直都在我身边。"}, {"type": "subtitle", "time": 19423.99, "timestamp": "05:23:43", "text": "这就是法律，因为法律就是这样规定的。"}, {"type": "subtitle", "time": 19427.59, "timestamp": "05:23:47", "text": "我是一个健忘的人。我认为是"}, {"type": "subtitle", "time": 19429.27, "timestamp": "05:23:49", "text": "就在那儿。所以，我已经接受了"}, {"type": "subtitle", "time": 19431.03, "timestamp": "05:23:51", "text": "就像它就在那里一样，我确实很喜欢火。"}, {"type": "subtitle", "time": 19432.788, "timestamp": "05:23:52", "text": "很多。"}, {"type": "subtitle", "time": 19435.67, "timestamp": "05:23:55", "text": "所以，这挺有意思的，就是这样。"}, {"type": "subtitle", "time": 19438.788, "timestamp": "05:23:58", "text": "有趣的地方在于，我可以……"}]
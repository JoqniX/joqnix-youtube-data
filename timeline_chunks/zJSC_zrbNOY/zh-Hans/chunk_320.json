[{"type": "subtitle", "time": 19209.83, "timestamp": "05:20:09", "text": "目标即将到来，但我并不开心。"}, {"type": "subtitle", "time": 19212.948, "timestamp": "05:20:12", "text": "关于它。哦，你也很擅长这个吗？"}, {"type": "subtitle", "time": 19216.15, "timestamp": "05:20:16", "text": "恐怖？相同的。 D. 我也是。我不是那样的人。"}, {"type": "subtitle", "time": 19218.31, "timestamp": "05:20:18", "text": "非常适合恐怖片。是的，就是这样。"}, {"type": "subtitle", "time": 19221.27, "timestamp": "05:20:21", "text": "那里。我猜应该是169吧。"}, {"type": "subtitle", "time": 19224.47, "timestamp": "05:20:24", "text": "这是恐怖游戏的目标。"}, {"type": "subtitle", "time": 19227.51, "timestamp": "05:20:27", "text": "H 169 如"}, {"type": "subtitle", "time": 19231.83, "timestamp": "05:20:31", "text": "嗯，粉丝们。啊，好的好的。就是这样。"}, {"type": "subtitle", "time": 19238.788, "timestamp": "05:20:38", "text": "我的天啊"}, {"type": "subtitle", "time": 19243.27, "timestamp": "05:20:43", "text": "大家都让我拍恐怖片"}, {"type": "subtitle", "time": 19247.03, "timestamp": "05:20:47", "text": "乔森。我当时想，我必须这么做吗？我使用"}, {"type": "subtitle", "time": 19250.15, "timestamp": "05:20:50", "text": "就像绕圈跑一样"}, {"type": "subtitle", "time": 19253.91, "timestamp": "05:20:53", "text": "远离它，因为那不是我，我会"}, {"type": "subtitle", "time": 19257.35, "timestamp": "05:20:57", "text": "尖叫、哭泣，令人厌烦"}]
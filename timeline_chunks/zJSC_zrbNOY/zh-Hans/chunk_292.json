[{"type": "subtitle", "time": 17520.948, "timestamp": "04:52:00", "text": "观众，而这位观众后来成了一位好观众"}, {"type": "subtitle", "time": 17524.788, "timestamp": "04:52:04", "text": "我的一个朋友，随着时间的推移，她呃"}, {"type": "subtitle", "time": 17530.15, "timestamp": "04:52:10", "text": "就像2022年生日时送的那种礼物一样"}, {"type": "subtitle", "time": 17532.07, "timestamp": "04:52:12", "text": "这就是你现在看到的模型，对吧？"}, {"type": "subtitle", "time": 17536.788, "timestamp": "04:52:16", "text": "现在，是的，就像她一样。"}, {"type": "subtitle", "time": 17539.75, "timestamp": "04:52:19", "text": "呃，她也从巴布亚新几内亚做了同样的事情。"}, {"type": "subtitle", "time": 17541.03, "timestamp": "04:52:21", "text": "原始PNG"}, {"type": "subtitle", "time": 17544.948, "timestamp": "04:52:24", "text": "最初的设计，然后她尝试了"}, {"type": "subtitle", "time": 17548.47, "timestamp": "04:52:28", "text": "把它变成 2D 动态影像，然后这个"}, {"type": "subtitle", "time": 17554.07, "timestamp": "04:52:34", "text": "发生了。是啊，真漂亮。"}, {"type": "subtitle", "time": 17556.23, "timestamp": "04:52:36", "text": "然后新的就出现了。我觉得我"}, {"type": "subtitle", "time": 17559.19, "timestamp": "04:52:39", "text": "没错，我给你演示过了。那是"}, {"type": "subtitle", "time": 17563.51, "timestamp": "04:52:43", "text": "真漂亮。呃，还没公开呢，因为"}, {"type": "subtitle", "time": 17567.75, "timestamp": "04:52:47", "text": "呃，我必须……我必须为……而战"}, {"type": "subtitle", "time": 17570.788, "timestamp": "04:52:50", "text": "从法律上讲，这是可以公开的，所以我"}, {"type": "subtitle", "time": 17573.91, "timestamp": "04:52:53", "text": "我可以，嗯，我可以有驾照，所以我"}, {"type": "subtitle", "time": 17577.35, "timestamp": "04:52:57", "text": "可以分享之类的，因为我有"}]
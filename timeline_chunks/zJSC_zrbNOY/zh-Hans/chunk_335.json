[{"type": "subtitle", "time": 20102.788, "timestamp": "05:35:02", "text": "因为呃，就像，嗯，是的，我做了，所以他是"}, {"type": "subtitle", "time": 20105.67, "timestamp": "05:35:05", "text": "好到可以像……嗯……说话一样"}, {"type": "subtitle", "time": 20108.15, "timestamp": "05:35:08", "text": "就像我们去那样谈论它"}, {"type": "subtitle", "time": 20111.19, "timestamp": "05:35:11", "text": "他认识的某个人，就像一位热情的警官。"}, {"type": "subtitle", "time": 20114.31, "timestamp": "05:35:14", "text": "我走进他们的办公室，我想起了……"}, {"type": "subtitle", "time": 20117.19, "timestamp": "05:35:17", "text": "我的情况。所以我现在在做，我处于劣势"}, {"type": "subtitle", "time": 20119.83, "timestamp": "05:35:19", "text": "这种与钱有关的压力"}, {"type": "subtitle", "time": 20122.788, "timestamp": "05:35:22", "text": "我需要的东西。"}, {"type": "subtitle", "time": 20125.03, "timestamp": "05:35:25", "text": "因为他们不知道，所以解释了一下。"}, {"type": "subtitle", "time": 20126.868, "timestamp": "05:35:26", "text": "VTubing 之类的东西现在都在直播什么"}, {"type": "subtitle", "time": 20129.43, "timestamp": "05:35:29", "text": "以及所有的一切。我详细解释道："}, {"type": "subtitle", "time": 20132.948, "timestamp": "05:35:32", "text": "他们多少有点明白。嗯"}, {"type": "subtitle", "time": 20134.548, "timestamp": "05:35:34", "text": "我甚至还得出示合同。"}, {"type": "subtitle", "time": 20136.628, "timestamp": "05:35:36", "text": "所有的一切，我的所有东西"}, {"type": "subtitle", "time": 20140.788, "timestamp": "05:35:40", "text": "如果所有那些东西都在的话，嗯……"}, {"type": "subtitle", "time": 20145.19, "timestamp": "05:35:45", "text": "他们还建议说，呃，因为我有"}, {"type": "subtitle", "time": 20147.67, "timestamp": "05:35:47", "text": "我的联邦银行账户。有类似"}, {"type": "subtitle", "time": 20149.99, "timestamp": "05:35:49", "text": "我有很多银行账户，但联邦银行"}, {"type": "subtitle", "time": 20152.15, "timestamp": "05:35:52", "text": "那是我通常用来上网的。"}, {"type": "subtitle", "time": 20154.47, "timestamp": "05:35:54", "text": "东西。所以他们会说：“是的，你可以。”"}, {"type": "subtitle", "time": 20156.788, "timestamp": "05:35:56", "text": "在联邦银行开设一个活期账户"}]
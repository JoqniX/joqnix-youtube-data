[{"type": "subtitle", "time": 19981.83, "timestamp": "05:33:01", "text": "就像在你的名下有一个活期账户一样"}, {"type": "subtitle", "time": 19984.07, "timestamp": "05:33:04", "text": "频道名称。所以这也意味着"}, {"type": "subtitle", "time": 19986.868, "timestamp": "05:33:06", "text": "你必须注册为独奏者"}, {"type": "subtitle", "time": 19990.15, "timestamp": "05:33:10", "text": "个体经营。不，那是一个整体"}, {"type": "subtitle", "time": 19992.31, "timestamp": "05:33:12", "text": "呃，其他"}, {"type": "subtitle", "time": 19994.868, "timestamp": "05:33:14", "text": "是的，我能预见到这种情况的发生。"}, {"type": "subtitle", "time": 19997.59, "timestamp": "05:33:17", "text": "比如，如果我们想成为你知道的那样"}, {"type": "subtitle", "time": 19999.11, "timestamp": "05:33:19", "text": "实际上"}, {"type": "subtitle", "time": 20001.19, "timestamp": "05:33:21", "text": "非常认真负责"}, {"type": "subtitle", "time": 20003.19, "timestamp": "05:33:23", "text": "流媒体之类的东西，但我感觉很多"}, {"type": "subtitle", "time": 20006.628, "timestamp": "05:33:26", "text": "印度的 YouTuber 们，我们就像……嗯……"}, {"type": "subtitle", "time": 20008.788, "timestamp": "05:33:28", "text": "开始直播只是为了探索一下效果如何"}, {"type": "subtitle", "time": 20011.83, "timestamp": "05:33:31", "text": "我们之所以有这种感觉，是因为我们确知这一点。"}, {"type": "subtitle", "time": 20013.83, "timestamp": "05:33:33", "text": "我们不能就这么出柜。"}, {"type": "subtitle", "time": 20017.83, "timestamp": "05:33:37", "text": "家人，就像我希望自己忘记一样"}, {"type": "subtitle", "time": 20023.43, "timestamp": "05:33:43", "text": "被打。是的。我的天啊。特莱攻击"}, {"type": "subtitle", "time": 20026.788, "timestamp": "05:33:46", "text": "或者别的什么。我的天啊。攻击。我认为"}, {"type": "subtitle", "time": 20029.83, "timestamp": "05:33:49", "text": "我们只要能飞到我们这儿就行了。"}, {"type": "subtitle", "time": 20031.59, "timestamp": "05:33:51", "text": "他们可以获取的方式。"}, {"type": "subtitle", "time": 20033.91, "timestamp": "05:33:53", "text": "之后就跟之前一样了"}]
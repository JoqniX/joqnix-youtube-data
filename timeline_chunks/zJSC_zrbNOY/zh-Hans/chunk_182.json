[{"type": "subtitle", "time": 10936.309, "timestamp": "03:02:16", "text": "好了，我回来了。我回来了。我回来了。我"}, {"type": "subtitle", "time": 10943.59, "timestamp": "03:02:23", "text": "哦，天哪，我跑了。我跑了"}, {"type": "subtitle", "time": 10946.389, "timestamp": "03:02:26", "text": "和"}, {"type": "subtitle", "time": 10949.83, "timestamp": "03:02:29", "text": "我明白了"}, {"type": "subtitle", "time": 10957.349, "timestamp": "03:02:37", "text": "拿到麦克风了。"}, {"type": "subtitle", "time": 10959.59, "timestamp": "03:02:39", "text": "把这个放在这里。"}, {"type": "subtitle", "time": 10961.91, "timestamp": "03:02:41", "text": "把这家伙放在这里"}, {"type": "subtitle", "time": 10964.79, "timestamp": "03:02:44", "text": "可以充电。"}, {"type": "subtitle", "time": 10967.349, "timestamp": "03:02:47", "text": "关闭它。好的。"}, {"type": "subtitle", "time": 10970.55, "timestamp": "03:02:50", "text": "这家伙百分百正确。"}, {"type": "subtitle", "time": 10972.309, "timestamp": "03:02:52", "text": "不，不，不。不要再给麦克风充电了。"}]
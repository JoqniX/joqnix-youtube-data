[{"type": "subtitle", "time": 13383.83, "timestamp": "03:43:03", "text": "意识到我们还没有做到这一点。好的。"}, {"type": "subtitle", "time": 13385.51, "timestamp": "03:43:05", "text": "海拉，"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "一切顺利。"}, {"type": "subtitle", "time": 13408.87, "timestamp": "03:43:28", "text": "是的，"}, {"type": "subtitle", "time": 13412.229, "timestamp": "03:43:32", "text": "现在Twitch直播挺不错的。哦，是吗？"}, {"type": "subtitle", "time": 13415.83, "timestamp": "03:43:35", "text": "你听说过像 Twitch 这样的新平台吗？"}, {"type": "subtitle", "time": 13417.67, "timestamp": "03:43:37", "text": "就像追捕那些人一样"}, {"type": "subtitle", "time": 13420.55, "timestamp": "03:43:40", "text": "多平台直播，还有，嗯，他们是"}, {"type": "subtitle", "time": 13424.389, "timestamp": "03:43:44", "text": "制定、执行新规则等等"}, {"type": "subtitle", "time": 13428.71, "timestamp": "03:43:48", "text": "现在他们允许多路复现了。"}, {"type": "subtitle", "time": 13431.91, "timestamp": "03:43:51", "text": "是的。是的。所以其中一位创作者呃"}, {"type": "subtitle", "time": 13436.469, "timestamp": "03:43:56", "text": "叫Nutty，呃，他呃，过去常常做类似的事情"}]
[{"type": "subtitle", "time": 19323.91, "timestamp": "05:22:03", "text": "这太疯狂了。"}, {"type": "subtitle", "time": 19326.788, "timestamp": "05:22:06", "text": "是啊，因为我记得我当时就……"}, {"type": "subtitle", "time": 19329.27, "timestamp": "05:22:09", "text": "和朋友一起坐在视频会议里，他们"}, {"type": "subtitle", "time": 19333.27, "timestamp": "05:22:13", "text": "我们当时在玩恐怖游戏，"}, {"type": "subtitle", "time": 19336.39, "timestamp": "05:22:16", "text": "为数不多的几次，我有点……呃……"}, {"type": "subtitle", "time": 19341.19, "timestamp": "05:22:21", "text": "很高兴我的麦克风音质很差。"}, {"type": "subtitle", "time": 19344.07, "timestamp": "05:22:24", "text": "我尖叫起来，但没有人知道。"}, {"type": "subtitle", "time": 19350.948, "timestamp": "05:22:30", "text": "迪斯科噪音抑制。"}, {"type": "subtitle", "time": 19353.67, "timestamp": "05:22:33", "text": "是的。嗯，挺……挺……"}, {"type": "subtitle", "time": 19356.23, "timestamp": "05:22:36", "text": "最近那个麦克风的事"}, {"type": "subtitle", "time": 19359.75, "timestamp": "05:22:39", "text": "情况有所好转，嗯，嗯，我的朋友帮了我。"}, {"type": "subtitle", "time": 19362.948, "timestamp": "05:22:42", "text": "我喜欢经常修理它。"}, {"type": "subtitle", "time": 19365.43, "timestamp": "05:22:45", "text": "因为在此之前，情况就像是……"}, {"type": "subtitle", "time": 19368.39, "timestamp": "05:22:48", "text": "大家都会……我不知道该怎么形容我。"}, {"type": "subtitle", "time": 19370.47, "timestamp": "05:22:50", "text": "全力以赴，只希望他们"}, {"type": "subtitle", "time": 19374.708, "timestamp": "05:22:54", "text": "能听到我说话。嗯。但在 Discord 里是这样的"}, {"type": "subtitle", "time": 19377.43, "timestamp": "05:22:57", "text": "仍然有点像那样。"}, {"type": "subtitle", "time": 19379.03, "timestamp": "05:22:59", "text": "每个人都得给我一点……"}]
[{"type": "subtitle", "time": 14583.03, "timestamp": "04:03:03", "text": "比如简单的dal chav和番茄酸辣酱。"}, {"type": "subtitle", "time": 14591.349, "timestamp": "04:03:11", "text": "所以就是这样，嗯，是的。"}, {"type": "subtitle", "time": 14600.309, "timestamp": "04:03:20", "text": "我的回应，而不是我的头脑，几乎"}, {"type": "subtitle", "time": 14603.99, "timestamp": "04:03:23", "text": "变成了山头。啊，山"}, {"type": "subtitle", "time": 14610.15, "timestamp": "04:03:30", "text": "我不"}, {"type": "subtitle", "time": 14624.71, "timestamp": "04:03:44", "text": "嗯，等等"}, {"type": "subtitle", "time": 14626.63, "timestamp": "04:03:46", "text": "我不知道，气氛很轻松。"}, {"type": "subtitle", "time": 14629.59, "timestamp": "04:03:49", "text": "我当时就想，是啊，这太好了。"}, {"type": "subtitle", "time": 14631.59, "timestamp": "04:03:51", "text": "令人不寒而栗。"}, {"type": "subtitle", "time": 14633.83, "timestamp": "04:03:53", "text": "我的意思是，这就像……这很好，就像……"}, {"type": "subtitle", "time": 14635.99, "timestamp": "04:03:55", "text": "正因如此，我才没那么做。"}]
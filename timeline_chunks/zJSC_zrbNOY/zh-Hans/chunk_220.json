[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "看着Twitch，呃，我就想，呃，我"}, {"type": "subtitle", "time": 13204.389, "timestamp": "03:40:04", "text": "最初希望他们两个都能成长"}, {"type": "subtitle", "time": 13207.75, "timestamp": "03:40:07", "text": "他们在一起，但感觉就像其中一个是"}, {"type": "subtitle", "time": 13210.95, "timestamp": "03:40:10", "text": "就像遥遥领先，而我们之中有人偷懒"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "背后找到一些类似的东西"}, {"type": "subtitle", "time": 13218.87, "timestamp": "03:40:18", "text": "但随着多路复用技术的出现，它已经变成了一种"}, {"type": "subtitle", "time": 13221.59, "timestamp": "03:40:21", "text": "也就是说，任何喜欢 Twitch 的人都可以这样做。"}, {"type": "subtitle", "time": 13225.19, "timestamp": "03:40:25", "text": "他们仍然可以上 Twitch 直播，获得呃……"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "同样的经历，如果他们是"}, {"type": "subtitle", "time": 13231.51, "timestamp": "03:40:31", "text": "在 YouTube 上，他们可以……"}, {"type": "subtitle", "time": 13240.389, "timestamp": "03:40:40", "text": "简单来说，你用哪个平台？"}, {"type": "subtitle", "time": 13242.63, "timestamp": "03:40:42", "text": "更喜欢"}, {"type": "subtitle", "time": 13245.269, "timestamp": "03:40:45", "text": "已经上传到 YouTube 了吗？所以实际上我是"}, {"type": "subtitle", "time": 13247.75, "timestamp": "03:40:47", "text": "对此感到好奇。所以我一直都想……"}, {"type": "subtitle", "time": 13251.59, "timestamp": "03:40:51", "text": "正在研究多流媒体技术。"}, {"type": "subtitle", "time": 13255.67, "timestamp": "03:40:55", "text": "所以我可能会浅尝辄止地尝试一下。"}]
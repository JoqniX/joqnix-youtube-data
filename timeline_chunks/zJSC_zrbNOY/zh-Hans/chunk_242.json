[{"type": "subtitle", "time": 14522.63, "timestamp": "04:02:02", "text": "这件事最棒的地方就在于……"}, {"type": "subtitle", "time": 14524.15, "timestamp": "04:02:04", "text": "像我们这样的国家有很多"}, {"type": "subtitle", "time": 14526.07, "timestamp": "04:02:06", "text": "我们可以定居这座城市的人口"}, {"type": "subtitle", "time": 14535.51, "timestamp": "04:02:15", "text": "真的有人找到了你。"}, {"type": "subtitle", "time": 14543.349, "timestamp": "04:02:23", "text": "啊，"}, {"type": "subtitle", "time": 14545.59, "timestamp": "04:02:25", "text": "薄饼很好吃。"}, {"type": "subtitle", "time": 14548.389, "timestamp": "04:02:28", "text": "Dosa味道不错。"}, {"type": "subtitle", "time": 14551.03, "timestamp": "04:02:31", "text": "嗯。你最喜欢吃什么？"}, {"type": "subtitle", "time": 14553.99, "timestamp": "04:02:33", "text": "你喜欢吃什么？"}, {"type": "subtitle", "time": 14557.269, "timestamp": "04:02:37", "text": "我喜欢各种美食。但是后来"}, {"type": "subtitle", "time": 14560.71, "timestamp": "04:02:40", "text": "比如，嗯，情绪方面。所以就像你一样"}, {"type": "subtitle", "time": 14563.91, "timestamp": "04:02:43", "text": "对我来说，印度香饭就像我的慰藉。"}, {"type": "subtitle", "time": 14566.15, "timestamp": "04:02:46", "text": "食物。嗯。"}, {"type": "subtitle", "time": 14568.389, "timestamp": "04:02:48", "text": "所以，当我状态不好的时候……"}, {"type": "subtitle", "time": 14570.389, "timestamp": "04:02:50", "text": "如果当天心情不好或者有点沮丧，我会选择"}, {"type": "subtitle", "time": 14574.309, "timestamp": "04:02:54", "text": "印度香饭。如果有一种食物像我"}, {"type": "subtitle", "time": 14576.79, "timestamp": "04:02:56", "text": "无论如何都能吃得下"}, {"type": "subtitle", "time": 14578.309, "timestamp": "04:02:58", "text": "你制作的次数将是"}]
[{"type": "subtitle", "time": 18121.11, "timestamp": "05:02:01", "text": "一卢比。 100卢比。没有一个美元是"}, {"type": "subtitle", "time": 18126.07, "timestamp": "05:02:06", "text": "一。我的天啊。就像当……它……它是"}, {"type": "subtitle", "time": 18128.07, "timestamp": "05:02:08", "text": "轮到我拿佣金了，就像我是"}, {"type": "subtitle", "time": 18130.47, "timestamp": "05:02:10", "text": "受委托撰写剧本或"}, {"type": "subtitle", "time": 18134.39, "timestamp": "05:02:14", "text": "给某人写一些稿子，比如"}, {"type": "subtitle", "time": 18137.67, "timestamp": "05:02:17", "text": "背景故事之类的东西。那是"}, {"type": "subtitle", "time": 18139.51, "timestamp": "05:02:19", "text": "感觉真好，因为是我……"}, {"type": "subtitle", "time": 18143.03, "timestamp": "05:02:23", "text": "以美元支付。"}, {"type": "subtitle", "time": 18145.59, "timestamp": "05:02:25", "text": "说实话，我确实会损失一些。"}, {"type": "subtitle", "time": 18149.19, "timestamp": "05:02:29", "text": "金额与货币兑换有关，因为呃"}, {"type": "subtitle", "time": 18151.91, "timestamp": "05:02:31", "text": "PayPal有时候也很糟糕。"}, {"type": "subtitle", "time": 18160.31, "timestamp": "05:02:40", "text": "对我来说。不，我当时想的是，“哦，我"}, {"type": "subtitle", "time": 18162.31, "timestamp": "05:02:42", "text": "因为它很漂亮，而且各方面都很好，我"}, {"type": "subtitle", "time": 18165.83, "timestamp": "05:02:45", "text": "不能选择价格更低的钻井平台安装商。"}, {"type": "subtitle", "time": 18168.15, "timestamp": "05:02:48", "text": "我当时就想，“好吧，那我选……”"}, {"type": "subtitle", "time": 18170.948, "timestamp": "05:02:50", "text": "呃，这位艺术家就是索具工。"}, {"type": "subtitle", "time": 18173.19, "timestamp": "05:02:53", "text": "之所以这样建议，是因为这位艺术家也是"}, {"type": "subtitle", "time": 18175.51, "timestamp": "05:02:55", "text": "韩国。 “是韩语。”然后我就想……"}, {"type": "subtitle", "time": 18178.55, "timestamp": "05:02:58", "text": "好吧，我会找个韩国的索具工。"}]
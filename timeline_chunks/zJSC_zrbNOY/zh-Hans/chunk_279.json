[{"type": "subtitle", "time": 16740.551, "timestamp": "04:39:00", "text": "是的，没错。就像你一样，你也有"}, {"type": "subtitle", "time": 16743.029, "timestamp": "04:39:03", "text": "你就像闪闪发光一样，你必须"}, {"type": "subtitle", "time": 16747.109, "timestamp": "04:39:07", "text": "注意，你的其他人呢？"}, {"type": "subtitle", "time": 16749.67, "timestamp": "04:39:09", "text": "感到舒适或他们感觉"}, {"type": "subtitle", "time": 16753.109, "timestamp": "04:39:13", "text": "因为某个人而感到不自在。"}, {"type": "subtitle", "time": 16755.75, "timestamp": "04:39:15", "text": "你必须拥有你可以像音频一样"}, {"type": "subtitle", "time": 16759.189, "timestamp": "04:39:19", "text": "口头劝阻他们不要这样做。如果"}, {"type": "subtitle", "time": 16760.869, "timestamp": "04:39:20", "text": "他们违反了规定，你可以惩罚他们。"}, {"type": "subtitle", "time": 16762.709, "timestamp": "04:39:22", "text": "一切。正确的。"}, {"type": "subtitle", "time": 16764.789, "timestamp": "04:39:24", "text": "那感觉就像我仍然……"}, {"type": "subtitle", "time": 16767.349, "timestamp": "04:39:27", "text": "正在努力，因为你知道，就像……"}, {"type": "subtitle", "time": 16769.429, "timestamp": "04:39:29", "text": "拥有明确的界限，并且喜欢"}, {"type": "subtitle", "time": 16772.23, "timestamp": "04:39:32", "text": "当情况……时，强制执行该界限"}, {"type": "subtitle", "time": 16775.99, "timestamp": "04:39:35", "text": "被推搡。嗯。尖叫空间"}, {"type": "subtitle", "time": 16780.628, "timestamp": "04:39:40", "text": "因为我确实允许自由放养"}, {"type": "subtitle", "time": 16783.03, "timestamp": "04:39:43", "text": "他们可以讨论的人"}, {"type": "subtitle", "time": 16785.11, "timestamp": "04:39:45", "text": "关于各种事情，但同时"}, {"type": "subtitle", "time": 16788.07, "timestamp": "04:39:48", "text": "时间好像必须这样才行。"}, {"type": "subtitle", "time": 16790.948, "timestamp": "04:39:50", "text": "一条任何人都不应逾越的界限。"}, {"type": "subtitle", "time": 16792.69, "timestamp": "04:39:52", "text": "连我都不喜欢。有时。"}, {"type": "subtitle", "time": 16794.31, "timestamp": "04:39:54", "text": "[音乐]"}, {"type": "subtitle", "time": 16796.788, "timestamp": "04:39:56", "text": "是的，我也在学习"}, {"type": "subtitle", "time": 16799.83, "timestamp": "04:39:59", "text": "我正在尽力做到这一点。我的意思是，界限"}]
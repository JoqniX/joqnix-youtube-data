[{"type": "subtitle", "time": 14760.15, "timestamp": "04:06:00", "text": "正在问：“你好吗？”我正在做"}, {"type": "subtitle", "time": 14764.309, "timestamp": "04:06:04", "text": "伟大的。呃，我有点冷，因为天气有点……"}, {"type": "subtitle", "time": 14767.91, "timestamp": "04:06:07", "text": "因为下雨之类的原因，这里很冷。"}, {"type": "subtitle", "time": 14769.59, "timestamp": "04:06:09", "text": "是的。我只是流鼻涕而已。"}, {"type": "subtitle", "time": 14771.59, "timestamp": "04:06:11", "text": "今天。"}, {"type": "subtitle", "time": 14774.63, "timestamp": "04:06:14", "text": "但我一切都很好。希望你们一切顺利"}, {"type": "subtitle", "time": 14777.349, "timestamp": "04:06:17", "text": "一切顺利。"}, {"type": "subtitle", "time": 14780.309, "timestamp": "04:06:20", "text": "是的，"}, {"type": "subtitle", "time": 14783.51, "timestamp": "04:06:23", "text": "今天有点阴天，但是"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "没下雨。但是，是的，"}, {"type": "subtitle", "time": 14788.55, "timestamp": "04:06:28", "text": "温度突然波动"}, {"type": "subtitle", "time": 14792.15, "timestamp": "04:06:32", "text": "稍微给了我一个嗯"}, {"type": "subtitle", "time": 14794.79, "timestamp": "04:06:34", "text": "嗯。几乎就像过敏一样"}, {"type": "subtitle", "time": 14796.79, "timestamp": "04:06:36", "text": "反应。我当时正在打喷嚏"}, {"type": "subtitle", "time": 14798.87, "timestamp": "04:06:38", "text": "不停地，但过了一段时间后"}, {"type": "subtitle", "time": 14801.11, "timestamp": "04:06:41", "text": "就这么走了。哦，我不知道什么"}, {"type": "subtitle", "time": 14809.83, "timestamp": "04:06:49", "text": "希望你早日康复。冷智"}, {"type": "subtitle", "time": 14816.469, "timestamp": "04:06:56", "text": "我以前常做的事，现在我……"}, {"type": "subtitle", "time": 14819.51, "timestamp": "04:06:59", "text": "冷是……呃，我不知道你是不是也这样。"}]
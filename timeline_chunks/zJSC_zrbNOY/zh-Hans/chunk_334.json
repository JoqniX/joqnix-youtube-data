[{"type": "subtitle", "time": 20043.43, "timestamp": "05:34:03", "text": "是的。我的天啊。查普将是最不重要的"}, {"type": "subtitle", "time": 20045.59, "timestamp": "05:34:05", "text": "查普绝对是我们中最不重要的一个。"}, {"type": "subtitle", "time": 20049.11, "timestamp": "05:34:09", "text": "目前存在一些问题。就像小教堂一样"}, {"type": "subtitle", "time": 20052.948, "timestamp": "05:34:12", "text": "这可能是你能期待的最好结果了。"}, {"type": "subtitle", "time": 20056.47, "timestamp": "05:34:16", "text": "为了。你可以希望“好的”只是"}, {"type": "subtitle", "time": 20064.31, "timestamp": "05:34:24", "text": "我的天啊。因为我记得有一次，嗯，我妈妈"}, {"type": "subtitle", "time": 20068.07, "timestamp": "05:34:28", "text": "我朝他扔了个气球和擀面杖。"}, {"type": "subtitle", "time": 20071.27, "timestamp": "05:34:31", "text": "兄弟。他躲开了。贝利特坏了。"}, {"type": "subtitle", "time": 20073.43, "timestamp": "05:34:33", "text": "问题是，当时的B是他的。"}, {"type": "subtitle", "time": 20077.43, "timestamp": "05:34:37", "text": "故障点已损坏。"}, {"type": "subtitle", "time": 20084.47, "timestamp": "05:34:44", "text": "哇。"}, {"type": "subtitle", "time": 20091.43, "timestamp": "05:34:51", "text": "[音乐]"}, {"type": "subtitle", "time": 20093.35, "timestamp": "05:34:53", "text": "我的天啊。"}, {"type": "subtitle", "time": 20097.99, "timestamp": "05:34:57", "text": "所以，我把这件事告诉了我爸爸。"}]
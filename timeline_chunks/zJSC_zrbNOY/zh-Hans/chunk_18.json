[{"type": "subtitle", "time": 1083.75, "timestamp": "00:18:03", "text": "是的，我觉得这样挺好的。"}, {"type": "subtitle", "time": 1086.87, "timestamp": "00:18:06", "text": "我想做点什么，对吧？"}, {"type": "subtitle", "time": 1090.87, "timestamp": "00:18:10", "text": "想做点什么之类的。所以，我"}, {"type": "subtitle", "time": 1094.95, "timestamp": "00:18:14", "text": "我想，你知道吗？"}, {"type": "subtitle", "time": 1097.51, "timestamp": "00:18:17", "text": "我很喜欢这些问题。"}, {"type": "subtitle", "time": 1099.59, "timestamp": "00:18:19", "text": "Discord 服务器。这是其中一件事。"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "我"}, {"type": "subtitle", "time": 1105.029, "timestamp": "00:18:25", "text": "某种程度上的恨。嗯"}, {"type": "subtitle", "time": 1109.27, "timestamp": "00:18:29", "text": "嗯，我正在想办法……"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "我自己解决吧，因为我实在想不出办法。"}, {"type": "subtitle", "time": 1118.789, "timestamp": "00:18:38", "text": "呃，有没有办法解决这个问题？"}, {"type": "subtitle", "time": 1122.31, "timestamp": "00:18:42", "text": "呃，因为没有"}, {"type": "subtitle", "time": 1125.19, "timestamp": "00:18:45", "text": "专业呃呃机器人或其他类似的东西"}, {"type": "subtitle", "time": 1132.87, "timestamp": "00:18:52", "text": "我刚刚切换了场景，好的。好的。哦"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "上帝。我切换到“我在做什么？”"}, {"type": "subtitle", "time": 1139.909, "timestamp": "00:18:59", "text": "呃，好的。嗯，这或许能帮上忙。所以，"}]
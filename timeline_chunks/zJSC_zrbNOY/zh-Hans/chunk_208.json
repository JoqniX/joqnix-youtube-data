[{"type": "subtitle", "time": 12482.95, "timestamp": "03:28:02", "text": "我的……嗯，内容方面的作品。我"}, {"type": "subtitle", "time": 12486.07, "timestamp": "03:28:06", "text": "写作比艺术创作多得多。艺术是"}, {"type": "subtitle", "time": 12488.95, "timestamp": "03:28:08", "text": "有点像……呃，我……"}, {"type": "subtitle", "time": 12491.83, "timestamp": "03:28:11", "text": "还在努力，因为我能感觉到"}, {"type": "subtitle", "time": 12500.469, "timestamp": "03:28:20", "text": "等等，像写书一样写作，"}, {"type": "subtitle", "time": 12503.91, "timestamp": "03:28:23", "text": "漫画、剧本。"}, {"type": "subtitle", "time": 12509.11, "timestamp": "03:28:29", "text": "我写的剧本就像……你知道的……"}, {"type": "subtitle", "time": 12517.83, "timestamp": "03:28:37", "text": "那很有意思。我的天啊，"}, {"type": "subtitle", "time": 12521.19, "timestamp": "03:28:41", "text": "我编写ASMO脚本，而且我写作风格也类似。"}, {"type": "subtitle", "time": 12524.87, "timestamp": "03:28:44", "text": "摩擦力等等都很多"}, {"type": "subtitle", "time": 12528.63, "timestamp": "03:28:48", "text": "出色地。但是，嗯，上次我是说……"}, {"type": "subtitle", "time": 12531.429, "timestamp": "03:28:51", "text": "近几年来，人们更加关注……"}, {"type": "subtitle", "time": 12538.15, "timestamp": "03:28:58", "text": "可以问一下吗？你觉得怎么样？"}]
[{"type": "subtitle", "time": 19922.548, "timestamp": "05:32:02", "text": "那里或者类似的地方，对吧，Twitch是"}, {"type": "subtitle", "time": 19925.19, "timestamp": "05:32:05", "text": "Twitch 占据了很多资源"}, {"type": "subtitle", "time": 19928.23, "timestamp": "05:32:08", "text": "对，就像潜艇之类的东西一样"}, {"type": "subtitle", "time": 19930.47, "timestamp": "05:32:10", "text": "我知道，有时候我就是这样。"}, {"type": "subtitle", "time": 19932.708, "timestamp": "05:32:12", "text": "感觉很糟糕，就像……呃，因为字幕……"}, {"type": "subtitle", "time": 19936.31, "timestamp": "05:32:16", "text": "知道 Twitch 正在从类似的地方拿走一些东西"}, {"type": "subtitle", "time": 19938.31, "timestamp": "05:32:18", "text": "双方都认同这一点。"}, {"type": "subtitle", "time": 19942.31, "timestamp": "05:32:22", "text": "他们支付了很多钱，这是……"}, {"type": "subtitle", "time": 19944.548, "timestamp": "05:32:24", "text": "类似"}, {"type": "subtitle", "time": 19947.51, "timestamp": "05:32:27", "text": "它并没有交给他们想要的人。"}, {"type": "subtitle", "time": 19949.43, "timestamp": "05:32:29", "text": "到"}, {"type": "subtitle", "time": 19951.43, "timestamp": "05:32:31", "text": "收到"}, {"type": "subtitle", "time": 19955.11, "timestamp": "05:32:35", "text": "其中扣除了多少？是的。这"}, {"type": "subtitle", "time": 19959.35, "timestamp": "05:32:39", "text": "包括所有伤口等等。是啊，太疯狂了。"}, {"type": "subtitle", "time": 19961.99, "timestamp": "05:32:41", "text": "我为了我的宝宝看了100个小时的视频，但是"}, {"type": "subtitle", "time": 19964.39, "timestamp": "05:32:44", "text": "它们最好各不相同，而且更长。"}, {"type": "subtitle", "time": 19966.948, "timestamp": "05:32:46", "text": "不到10秒。"}, {"type": "subtitle", "time": 19970.15, "timestamp": "05:32:50", "text": "谢谢你，塔米。"}, {"type": "subtitle", "time": 19974.23, "timestamp": "05:32:54", "text": "然后我意识到，为了"}, {"type": "subtitle", "time": 19979.11, "timestamp": "05:32:59", "text": "我们这些YouTube用户直接使用的方式是"}]
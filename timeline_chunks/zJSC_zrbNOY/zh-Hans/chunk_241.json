[{"type": "subtitle", "time": 14460.229, "timestamp": "04:01:00", "text": "我从侧面到尖端"}, {"type": "subtitle", "time": 14464.15, "timestamp": "04:01:04", "text": "比如，你知道，当你必须做……的时候"}, {"type": "subtitle", "time": 14468.389, "timestamp": "04:01:08", "text": "将性别与非生物联系起来"}, {"type": "subtitle", "time": 14470.71, "timestamp": "04:01:10", "text": "性别相关的事情。所以你知道，它是"}, {"type": "subtitle", "time": 14475.349, "timestamp": "04:01:15", "text": "就像钥匙和汽车一样"}, {"type": "subtitle", "time": 14477.99, "timestamp": "04:01:17", "text": "像桌子这样没有生命的东西"}, {"type": "subtitle", "time": 14480.07, "timestamp": "04:01:20", "text": "或者诸如此类，我就是明白了。"}, {"type": "subtitle", "time": 14482.57, "timestamp": "04:01:22", "text": "有时会感到困惑。"}, {"type": "subtitle", "time": 14488.63, "timestamp": "04:01:28", "text": "Jo，你是印度人吗？你可以"}, {"type": "subtitle", "time": 14491.34, "timestamp": "04:01:31", "text": "就说我来自南方。"}, {"type": "subtitle", "time": 14501.269, "timestamp": "04:01:41", "text": "你告诉过你的直播间你在哪里吗？"}, {"type": "subtitle", "time": 14503.83, "timestamp": "04:01:43", "text": "从和东西，或者像你保留它一样"}, {"type": "subtitle", "time": 14508.309, "timestamp": "04:01:48", "text": "像北方那样的地区吗？呃，我只是"}, {"type": "subtitle", "time": 14510.309, "timestamp": "04:01:50", "text": "就像我一直保持着我住的地方一样"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "啊，所以我想，重点就像是……但是"}]
[{"type": "subtitle", "time": 3242.23, "timestamp": "00:54:02", "text": "知道你会动态变化"}, {"type": "subtitle", "time": 3245.67, "timestamp": "00:54:05", "text": "时间、缩略图等等。哦"}, {"type": "subtitle", "time": 3248.069, "timestamp": "00:54:08", "text": "我的上帝。我真的被吓了一跳"}, {"type": "subtitle", "time": 3252.069, "timestamp": "00:54:12", "text": "电源电路。哦，我的"}, {"type": "subtitle", "time": 3255.109, "timestamp": "00:54:15", "text": "我的天啊。"}, {"type": "subtitle", "time": 3275.349, "timestamp": "00:54:35", "text": "我当时就把腿放在桌子上。"}, {"type": "subtitle", "time": 3278.79, "timestamp": "00:54:38", "text": "我懒散地坐在椅子上。"}, {"type": "subtitle", "time": 3281.829, "timestamp": "00:54:41", "text": "足球也曾是其中的一部分。它有点开放"}, {"type": "subtitle", "time": 3283.51, "timestamp": "00:54:43", "text": "因为"}, {"type": "subtitle", "time": 3292.309, "timestamp": "00:54:52", "text": "袜子，呃，那个东西，那个插头"}, {"type": "subtitle", "time": 3295.75, "timestamp": "00:54:55", "text": "身体受伤了"}, {"type": "subtitle", "time": 3299.19, "timestamp": "00:54:59", "text": "它敞开着，里面的电线都露出来了。"}]
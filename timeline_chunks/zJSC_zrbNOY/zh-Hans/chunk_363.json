[{"type": "subtitle", "time": 21780.39, "timestamp": "06:03:00", "text": "对我而言，他给了我很多指导，我将要"}, {"type": "subtitle", "time": 21782.548, "timestamp": "06:03:02", "text": "把他们都带来，不管他们是否"}, {"type": "subtitle", "time": 21785.51, "timestamp": "06:03:05", "text": "YouTuber、I创作者或前YouTuber"}, {"type": "subtitle", "time": 21788.47, "timestamp": "06:03:08", "text": "或者创作者，甚至不直播"}, {"type": "subtitle", "time": 21791.03, "timestamp": "06:03:11", "text": "朋友们，我也会说，是啊，我要去了。"}, {"type": "subtitle", "time": 21794.15, "timestamp": "06:03:14", "text": "要记住每一个字，就像聊天一样。"}, {"type": "subtitle", "time": 21797.03, "timestamp": "06:03:17", "text": "临走前和他们聊聊。所以它就像一个"}, {"type": "subtitle", "time": 21800.628, "timestamp": "06:03:20", "text": "现在，这是与人们重新建立联系的一种方式，而你"}, {"type": "subtitle", "time": 21802.788, "timestamp": "06:03:22", "text": "是的。在你之前，你会创造回忆。"}, {"type": "subtitle", "time": 21805.75, "timestamp": "06:03:25", "text": "离开，对吧？就像我离开日本一样"}, {"type": "subtitle", "time": 21807.83, "timestamp": "06:03:27", "text": "这将如同人生新篇章，"}, {"type": "subtitle", "time": 21810.948, "timestamp": "06:03:30", "text": "正确的？独自一人，学习如何"}, {"type": "subtitle", "time": 21814.15, "timestamp": "06:03:34", "text": "独自一人在那里生存下去，就像……"}, {"type": "subtitle", "time": 21816.15, "timestamp": "06:03:36", "text": "就像我的独立故事线即将开始一样"}, {"type": "subtitle", "time": 21819.59, "timestamp": "06:03:39", "text": "那里。就像我这里，我是独生子女"}, {"type": "subtitle", "time": 21823.91, "timestamp": "06:03:43", "text": "我的家人像竹子一样保护我"}, {"type": "subtitle", "time": 21827.19, "timestamp": "06:03:47", "text": "很多，而且就像……喜欢做所有事"}, {"type": "subtitle", "time": 21830.31, "timestamp": "06:03:50", "text": "或者说，有人在那里引导我吗？"}, {"type": "subtitle", "time": 21833.35, "timestamp": "06:03:53", "text": "现在的东西，但到了那里就会像所有东西一样。"}, {"type": "subtitle", "time": 21838.868, "timestamp": "06:03:58", "text": "独自一人。我得自己做。"}]
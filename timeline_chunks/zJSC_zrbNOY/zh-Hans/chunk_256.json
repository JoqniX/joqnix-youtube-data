[{"type": "subtitle", "time": 15362.95, "timestamp": "04:16:02", "text": "反应。我的天啊。你有没有过这种感觉"}, {"type": "subtitle", "time": 15365.429, "timestamp": "04:16:05", "text": "就像你在网上看到你的照片时那样"}, {"type": "subtitle", "time": 15367.51, "timestamp": "04:16:07", "text": "当你遇到你的网友时，你就是朋友。"}, {"type": "subtitle", "time": 15370.55, "timestamp": "04:16:10", "text": "现实生活？我遇到了像我这样的人。"}, {"type": "subtitle", "time": 15372.309, "timestamp": "04:16:12", "text": "网络好友。所以这就像是一种方式"}, {"type": "subtitle", "time": 15375.269, "timestamp": "04:16:15", "text": "在我成为这位YouTuber之前，我只是"}, {"type": "subtitle", "time": 15377.03, "timestamp": "04:16:17", "text": "我认识一些人，当时我在孟买。所以"}, {"type": "subtitle", "time": 15380.07, "timestamp": "04:16:20", "text": "我决定见见其中一位。那是"}, {"type": "subtitle", "time": 15383.429, "timestamp": "04:16:23", "text": "有点超现实的感觉，就像好吧，你确实如此。"}, {"type": "subtitle", "time": 15386.63, "timestamp": "04:16:26", "text": "存在。是的。"}, {"type": "subtitle", "time": 15389.99, "timestamp": "04:16:29", "text": "我的天啊。你其实是个人类"}, {"type": "subtitle", "time": 15395.83, "timestamp": "04:16:35", "text": "是的。还有这个东西正在调音。"}, {"type": "subtitle", "time": 15398.07, "timestamp": "04:16:38", "text": "就像你告诉父母那样"}, {"type": "subtitle", "time": 15401.11, "timestamp": "04:16:41", "text": "他们会说，可能会有类似……"}, {"type": "subtitle", "time": 15403.75, "timestamp": "04:16:43", "text": "比如年纪大一些的人，像50岁或30岁的人"}, {"type": "subtitle", "time": 15407.51, "timestamp": "04:16:47", "text": "老年人什么的，对吧，但是"}, {"type": "subtitle", "time": 15410.389, "timestamp": "04:16:50", "text": "现实情况是，当你真正遇到它时，它并不是那样。"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "那。他们真实可靠，年龄也一样。"}, {"type": "subtitle", "time": 15417.83, "timestamp": "04:16:57", "text": "你或者其他什么人。我知道。就像一样"}]
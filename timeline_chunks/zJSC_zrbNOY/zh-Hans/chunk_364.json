[{"type": "subtitle", "time": 21841.11, "timestamp": "06:04:01", "text": "是的。"}, {"type": "subtitle", "time": 21842.708, "timestamp": "06:04:02", "text": "有太多东西我要学了。"}, {"type": "subtitle", "time": 21844.788, "timestamp": "06:04:04", "text": "烹饪方面也是如此。"}, {"type": "subtitle", "time": 21846.39, "timestamp": "06:04:06", "text": "哇。"}, {"type": "subtitle", "time": 21849.43, "timestamp": "06:04:09", "text": "哦，是的。太多事情了。是的，烹饪"}, {"type": "subtitle", "time": 21851.83, "timestamp": "06:04:11", "text": "很有趣。只是我喜欢把东西烧掉而已。"}, {"type": "subtitle", "time": 21855.35, "timestamp": "06:04:15", "text": "很多，而且会毁了东西。所以，我就想，我是"}, {"type": "subtitle", "time": 21858.548, "timestamp": "06:04:18", "text": "厨艺很差。不过，这很有趣……"}, {"type": "subtitle", "time": 21860.628, "timestamp": "06:04:20", "text": "给人们做饭什么的。不，越多"}, {"type": "subtitle", "time": 21864.23, "timestamp": "06:04:24", "text": "习惯了就觉得挺有意思的"}, {"type": "subtitle", "time": 21866.47, "timestamp": "06:04:26", "text": "事物。我感觉自己好像喜欢"}, {"type": "subtitle", "time": 21870.15, "timestamp": "06:04:30", "text": "经常为我的家人做饭"}, {"type": "subtitle", "time": 21874.868, "timestamp": "06:04:34", "text": "相比之下，我当时是一名职业人士。"}, {"type": "subtitle", "time": 21878.868, "timestamp": "06:04:38", "text": "厨房里待了大概几个星期吧。"}, {"type": "subtitle", "time": 21883.03, "timestamp": "06:04:43", "text": "想想一个月或一个月左右"}, {"type": "subtitle", "time": 21885.75, "timestamp": "06:04:45", "text": "商业厨房，我真的很喜欢那里。"}, {"type": "subtitle", "time": 21889.91, "timestamp": "06:04:49", "text": "我意识到这一点，就像，是的，我不喜欢"}, {"type": "subtitle", "time": 21896.628, "timestamp": "06:04:56", "text": "感觉我宁愿只为自己做饭。"}, {"type": "subtitle", "time": 21899.11, "timestamp": "06:04:59", "text": "就像我的族人一样，也只是为了我的家人，"}]
[{"type": "subtitle", "time": 16803.27, "timestamp": "04:40:03", "text": "设置场景可以像完成任务一样。它不是"}, {"type": "subtitle", "time": 16806.55, "timestamp": "04:40:06", "text": "很简单，你知道的。设定界限。我"}, {"type": "subtitle", "time": 16808.628, "timestamp": "04:40:08", "text": "不喜欢我开始直播的时候"}, {"type": "subtitle", "time": 16811.51, "timestamp": "04:40:11", "text": "就是在那时我才知道的……"}, {"type": "subtitle", "time": 16814.47, "timestamp": "04:40:14", "text": "在网上等等，就像和其他人一样"}, {"type": "subtitle", "time": 16817.19, "timestamp": "04:40:17", "text": "就像世界各地的人们一样，他们也有"}, {"type": "subtitle", "time": 16819.59, "timestamp": "04:40:19", "text": "当涉及到这个界限时"}, {"type": "subtitle", "time": 16823.03, "timestamp": "04:40:23", "text": "友谊就像熟人一样亲密"}, {"type": "subtitle", "time": 16826.948, "timestamp": "04:40:26", "text": "像最好的朋友之类的朋友"}, {"type": "subtitle", "time": 16829.83, "timestamp": "04:40:29", "text": "对我来说，这就像如果你是"}, {"type": "subtitle", "time": 16832.15, "timestamp": "04:40:32", "text": "朋友，你就像最好的朋友一样"}, {"type": "subtitle", "time": 16835.19, "timestamp": "04:40:35", "text": "还有一些东西，你没有任何分离。"}, {"type": "subtitle", "time": 16838.23, "timestamp": "04:40:38", "text": "或者像其他东西一样被束缚"}, {"type": "subtitle", "time": 16840.788, "timestamp": "04:40:40", "text": "那感觉很奇怪，就像……"}, {"type": "subtitle", "time": 16843.19, "timestamp": "04:40:43", "text": "学习就像哦，有acqu是什么"}, {"type": "subtitle", "time": 16845.59, "timestamp": "04:40:45", "text": "熟人"}, {"type": "subtitle", "time": 16849.11, "timestamp": "04:40:49", "text": "比如同事之类的，我能理解，但是，嗯。"}, {"type": "subtitle", "time": 16854.55, "timestamp": "04:40:54", "text": "好多事情都让我惊叹不已。"}]
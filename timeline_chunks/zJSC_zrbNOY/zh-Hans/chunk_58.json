[{"type": "subtitle", "time": 3487.03, "timestamp": "00:58:07", "text": "但如果我之后再做的话……"}, {"type": "subtitle", "time": 3490.789, "timestamp": "00:58:10", "text": "我可以感觉好些吗？"}, {"type": "subtitle", "time": 3493.75, "timestamp": "00:58:13", "text": "稳定且一切正常"}, {"type": "subtitle", "time": 3501.19, "timestamp": "00:58:21", "text": "客人"}, {"type": "subtitle", "time": 3505.99, "timestamp": "00:58:25", "text": "是一个紧紧包裹着东西的人"}, {"type": "subtitle", "time": 3509.109, "timestamp": "00:58:29", "text": "我无法改变今天发生的一切"}, {"type": "subtitle", "time": 3512.15, "timestamp": "00:58:32", "text": "客人感觉他们很灵活"}, {"type": "subtitle", "time": 3514.15, "timestamp": "00:58:34", "text": "任何一天"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "但重新安排时间也会让人感觉很糟糕。"}]
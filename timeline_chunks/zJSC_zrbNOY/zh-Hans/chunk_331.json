[{"type": "subtitle", "time": 19862.39, "timestamp": "05:31:02", "text": "很奇怪，所以法国广告就像在问“为什么？”"}, {"type": "subtitle", "time": 19864.47, "timestamp": "05:31:04", "text": "你给我看法国广告，然后就有了"}, {"type": "subtitle", "time": 19867.59, "timestamp": "05:31:07", "text": "有一段时间我会收到西班牙语广告。"}, {"type": "subtitle", "time": 19869.51, "timestamp": "05:31:09", "text": "我的天啊"}, {"type": "subtitle", "time": 19872.708, "timestamp": "05:31:12", "text": "我收到了好多西班牙语广告"}, {"type": "subtitle", "time": 19875.35, "timestamp": "05:31:15", "text": "太多次了，以至于有一次我"}, {"type": "subtitle", "time": 19877.03, "timestamp": "05:31:17", "text": "其实我考虑过也许我应该学习"}, {"type": "subtitle", "time": 19884.39, "timestamp": "05:31:24", "text": "我的天啊，"}, {"type": "subtitle", "time": 19887.67, "timestamp": "05:31:27", "text": "它们看起来像是未来科技产品。哦"}, {"type": "subtitle", "time": 19889.51, "timestamp": "05:31:29", "text": "是的，"}, {"type": "subtitle", "time": 19892.23, "timestamp": "05:31:32", "text": "因为我发现了很多问题"}, {"type": "subtitle", "time": 19896.47, "timestamp": "05:31:36", "text": "现在就是这样。我当时就想，哦，天哪，我当时就想"}, {"type": "subtitle", "time": 19900.628, "timestamp": "05:31:40", "text": "我已经受够了PayPal、Stripe之类的支付方式了。"}, {"type": "subtitle", "time": 19902.708, "timestamp": "05:31:42", "text": "所有功能都无法正常工作。我尝试了很多"}, {"type": "subtitle", "time": 19906.15, "timestamp": "05:31:46", "text": "其他平台都无法正常运行。"}, {"type": "subtitle", "time": 19907.83, "timestamp": "05:31:47", "text": "对于像国际人士来说，他们可以"}, {"type": "subtitle", "time": 19910.15, "timestamp": "05:31:50", "text": "我用PayPal，我当时正在为我们工作。"}, {"type": "subtitle", "time": 19913.59, "timestamp": "05:31:53", "text": "印度人觉得很痛苦，所以最终我……"}, {"type": "subtitle", "time": 19916.788, "timestamp": "05:31:56", "text": "诉诸于推动 YouTube 之类的手段"}, {"type": "subtitle", "time": 19919.51, "timestamp": "05:31:59", "text": "合作伙伴，这样他们至少可以捐款。"}]
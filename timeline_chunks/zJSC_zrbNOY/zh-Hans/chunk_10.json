[{"type": "subtitle", "time": 604.55, "timestamp": "00:10:04", "text": "我的模组好像不让我的声音听起来像那样"}, {"type": "subtitle", "time": 606.71, "timestamp": "00:10:06", "text": "想唱那句歌词。我不知道"}, {"type": "subtitle", "time": 611.19, "timestamp": "00:10:11", "text": "为什么。是因为太难了吗？"}, {"type": "subtitle", "time": 619.59, "timestamp": "00:10:19", "text": "很难。"}, {"type": "subtitle", "time": 622.31, "timestamp": "00:10:22", "text": "为什么这么难？我不想给。"}, {"type": "subtitle", "time": 624.79, "timestamp": "00:10:24", "text": "不想放弃。"}, {"type": "subtitle", "time": 627.03, "timestamp": "00:10:27", "text": "我又一次休息了一段时间。"}, {"type": "subtitle", "time": 628.55, "timestamp": "00:10:28", "text": "歌曲。"}, {"type": "subtitle", "time": 631.91, "timestamp": "00:10:31", "text": "不，等等。呃，让我来演示一下。嗯"}, {"type": "subtitle", "time": 635.509, "timestamp": "00:10:35", "text": "有一首节奏很快的歌。"}, {"type": "subtitle", "time": 637.829, "timestamp": "00:10:37", "text": "如果你听从芭芭雅嘎的话。我的天啊，"}, {"type": "subtitle", "time": 640.389, "timestamp": "00:10:40", "text": "速度真快。我甚至都不会唱歌"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "这。"}, {"type": "subtitle", "time": 644.71, "timestamp": "00:10:44", "text": "让我"}, {"type": "subtitle", "time": 647.99, "timestamp": "00:10:47", "text": "我需要登录。哦，等等。"}, {"type": "subtitle", "time": 650.31, "timestamp": "00:10:50", "text": "哦，我需要一个信号。我的天啊。我不"}, {"type": "subtitle", "time": 655.43, "timestamp": "00:10:55", "text": "想现在就做。呃，回去吧。"}]
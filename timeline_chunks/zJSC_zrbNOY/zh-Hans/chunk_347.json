[{"type": "subtitle", "time": 20821.35, "timestamp": "05:47:01", "text": "人们确实这样做了，如果我可以给你一个"}, {"type": "subtitle", "time": 20825.59, "timestamp": "05:47:05", "text": "如果您提供独家优惠，请填写"}, {"type": "subtitle", "time": 20827.83, "timestamp": "05:47:07", "text": "就像他要求的那种可担保金额"}, {"type": "subtitle", "time": 20831.35, "timestamp": "05:47:11", "text": "比如一千或两千个要寄给"}, {"type": "subtitle", "time": 20834.47, "timestamp": "05:47:14", "text": "他，呃，今天今晚，今晚，作为一个"}, {"type": "subtitle", "time": 20837.67, "timestamp": "05:47:17", "text": "保证那玩意儿，因为我从那里"}, {"type": "subtitle", "time": 20840.07, "timestamp": "05:47:20", "text": "我当时就想，哦，他有那么多观点。"}, {"type": "subtitle", "time": 20842.15, "timestamp": "05:47:22", "text": "来自印度各地的许多学生"}, {"type": "subtitle", "time": 20844.948, "timestamp": "05:47:24", "text": "想学习音乐的东西"}, {"type": "subtitle", "time": 20846.708, "timestamp": "05:47:26", "text": "就像那些转换的人一样。"}, {"type": "subtitle", "time": 20849.99, "timestamp": "05:47:29", "text": "从事音乐相关职业或成为歌手"}, {"type": "subtitle", "time": 20853.35, "timestamp": "05:47:33", "text": "一切。所以我就想，好吧，我可以试试。"}, {"type": "subtitle", "time": 20856.708, "timestamp": "05:47:36", "text": "然后，天哪，说服父母"}, {"type": "subtitle", "time": 20859.59, "timestamp": "05:47:39", "text": "我的天哪"}, {"type": "subtitle", "time": 20862.788, "timestamp": "05:47:42", "text": "我苦苦哀求，他却……"}, {"type": "subtitle", "time": 20865.99, "timestamp": "05:47:45", "text": "他当时就在那里，就像那样，他就在那里。"}, {"type": "subtitle", "time": 20868.868, "timestamp": "05:47:48", "text": "发送类似“教”之类的东西没问题"}, {"type": "subtitle", "time": 20871.43, "timestamp": "05:47:51", "text": "这让我有机会学习，但问题是我"}, {"type": "subtitle", "time": 20873.51, "timestamp": "05:47:53", "text": "日语课已经开始了。"}, {"type": "subtitle", "time": 20876.708, "timestamp": "05:47:56", "text": "在。这是去年12月期间发生的事情。"}, {"type": "subtitle", "time": 20879.35, "timestamp": "05:47:59", "text": "年。好的。是的。日本十二月"}]
[{"type": "subtitle", "time": 19261.27, "timestamp": "05:21:01", "text": "每个人。所以下一栋楼就像……"}, {"type": "subtitle", "time": 19264.15, "timestamp": "05:21:04", "text": "就像在我家前面，嗯，就在我家旁边"}, {"type": "subtitle", "time": 19270.15, "timestamp": "05:21:10", "text": "就像一家青年旅舍。所以他们曾经是什么？"}, {"type": "subtitle", "time": 19273.99, "timestamp": "05:21:13", "text": "尖叫声如此之大，以至于来自……的人们"}, {"type": "subtitle", "time": 19276.868, "timestamp": "05:21:16", "text": "他们喜欢的主人来到我家，"}, {"type": "subtitle", "time": 19280.07, "timestamp": "05:21:20", "text": "问问发生了什么事之类的。"}, {"type": "subtitle", "time": 19282.628, "timestamp": "05:21:22", "text": "真是太尴尬了。"}, {"type": "subtitle", "time": 19285.51, "timestamp": "05:21:25", "text": "我的天啊。因为这就是事情的本质。"}, {"type": "subtitle", "time": 19289.11, "timestamp": "05:21:29", "text": "呃，如果，呃，当我们达到目标时，我"}, {"type": "subtitle", "time": 19291.99, "timestamp": "05:21:31", "text": "必须非常谨慎地"}, {"type": "subtitle", "time": 19295.19, "timestamp": "05:21:35", "text": "通知我的家人我将要这样做"}, {"type": "subtitle", "time": 19298.23, "timestamp": "05:21:38", "text": "如果你听到我尖叫、喊叫，或者"}, {"type": "subtitle", "time": 19302.628, "timestamp": "05:21:42", "text": "别担心，我没事。"}, {"type": "subtitle", "time": 19304.47, "timestamp": "05:21:44", "text": "我只是想玩一款恐怖游戏。"}, {"type": "subtitle", "time": 19306.708, "timestamp": "05:21:46", "text": "或者我就等到……呃，大家"}, {"type": "subtitle", "time": 19309.03, "timestamp": "05:21:49", "text": "出城或者我像呃"}, {"type": "subtitle", "time": 19311.03, "timestamp": "05:21:51", "text": "大家都在忙着各自的户外活动。"}, {"type": "subtitle", "time": 19314.39, "timestamp": "05:21:54", "text": "他们的房子，我计划那天去那里……"}, {"type": "subtitle", "time": 19316.91, "timestamp": "05:21:56", "text": "是的，今天我要上场比赛。"}]
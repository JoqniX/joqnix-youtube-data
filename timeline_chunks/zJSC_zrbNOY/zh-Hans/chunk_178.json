[{"type": "subtitle", "time": 10680.309, "timestamp": "02:58:00", "text": "是我，但是"}, {"type": "subtitle", "time": 10693.91, "timestamp": "02:58:13", "text": "好的。嗯，我会回来的。我必须接受"}, {"type": "subtitle", "time": 10697.99, "timestamp": "02:58:17", "text": "拿着麦克风回来。"}, {"type": "subtitle", "time": 10701.03, "timestamp": "02:58:21", "text": "相信它就在房间里。"}, {"type": "subtitle", "time": 10704.389, "timestamp": "02:58:24", "text": "好的，请稍等片刻。"}, {"type": "subtitle", "time": 10714.63, "timestamp": "02:58:34", "text": "我再三确认一下"}, {"type": "subtitle", "time": 10720.71, "timestamp": "02:58:40", "text": "我的意思是，我必须这样做，我必须加倍。"}, {"type": "subtitle", "time": 10722.79, "timestamp": "02:58:42", "text": "检查是否"}]
[{"type": "subtitle", "time": 22260.15, "timestamp": "06:11:00", "text": "比如，如果我想吃辣的，我就会"}, {"type": "subtitle", "time": 22263.27, "timestamp": "06:11:03", "text": "把青辣椒一起吃掉就行了。"}, {"type": "subtitle", "time": 22268.548, "timestamp": "06:11:08", "text": "真有趣。"}, {"type": "subtitle", "time": 22271.19, "timestamp": "06:11:11", "text": "那很好。"}, {"type": "subtitle", "time": 22275.59, "timestamp": "06:11:15", "text": "我现在有11个，嗯，是的，嗯"}, {"type": "subtitle", "time": 22279.75, "timestamp": "06:11:19", "text": "四月份入学。所以，那意味着三月份。是的。"}, {"type": "subtitle", "time": 22282.07, "timestamp": "06:11:22", "text": "从三月到三月底，大概是这样的"}, {"type": "subtitle", "time": 22284.31, "timestamp": "06:11:24", "text": "这次。是的。时期。一样。"}, {"type": "subtitle", "time": 22286.548, "timestamp": "06:11:26", "text": "和六月份的格式一样。"}, {"type": "subtitle", "time": 22289.03, "timestamp": "06:11:29", "text": "正确的。大约就在这个时候。所以我还有一分钟"}, {"type": "subtitle", "time": 22292.07, "timestamp": "06:11:32", "text": "行进。所以我就想，是啊，我现在有"}, {"type": "subtitle", "time": 22294.948, "timestamp": "06:11:34", "text": "是时候好好照顾我了"}, {"type": "subtitle", "time": 22298.15, "timestamp": "06:11:38", "text": "健康等等，还要学习如何"}, {"type": "subtitle", "time": 22299.99, "timestamp": "06:11:39", "text": "烹饪和一切推广"}, {"type": "subtitle", "time": 22303.35, "timestamp": "06:11:43", "text": "已准备好，作为补偿。所以，我"}, {"type": "subtitle", "time": 22305.67, "timestamp": "06:11:45", "text": "我去了像当地学院那样的地方。"}, {"type": "subtitle", "time": 22307.99, "timestamp": "06:11:47", "text": "附近找找看有没有日本人。"}, {"type": "subtitle", "time": 22310.47, "timestamp": "06:11:50", "text": "共同语言"}]
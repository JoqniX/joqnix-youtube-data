[{"type": "subtitle", "time": 18781.43, "timestamp": "05:13:01", "text": "你可以用声音吓我一跳。"}, {"type": "subtitle", "time": 18785.27, "timestamp": "05:13:05", "text": "今晚你想收到多少提醒都行。"}, {"type": "subtitle", "time": 18789.91, "timestamp": "05:13:09", "text": "哦，你有对象了。好的。好的。是的。"}, {"type": "subtitle", "time": 18793.59, "timestamp": "05:13:13", "text": "他们经常突然吓我一跳。"}, {"type": "subtitle", "time": 18796.708, "timestamp": "05:13:16", "text": "我只会专注于登录一​​个……"}, {"type": "subtitle", "time": 18798.47, "timestamp": "05:13:18", "text": "某件特定的事，然后突然"}, {"type": "subtitle", "time": 18805.11, "timestamp": "05:13:25", "text": "稍微设置好麦克风之后"}, {"type": "subtitle", "time": 18807.59, "timestamp": "05:13:27", "text": "他们能听到我的喘息声，然后开始……"}, {"type": "subtitle", "time": 18810.55, "timestamp": "05:13:30", "text": "每当我受到惊吓时，我都会在之前"}, {"type": "subtitle", "time": 18812.788, "timestamp": "05:13:32", "text": "他们不知道我有……"}, {"type": "subtitle", "time": 18817.19, "timestamp": "05:13:37", "text": "就像小屏幕或者嘘……倒吸一口凉气，但是"}, {"type": "subtitle", "time": 18819.83, "timestamp": "05:13:39", "text": "现在他们确实这么做了，我想他们就是。"}, {"type": "subtitle", "time": 18823.03, "timestamp": "05:13:43", "text": "很享受这种感觉。"}, {"type": "subtitle", "time": 18829.11, "timestamp": "05:13:49", "text": "我从来没试过声音提醒，因为……"}, {"type": "subtitle", "time": 18832.47, "timestamp": "05:13:52", "text": "现在就像是两件事了。对，就是那个。"}, {"type": "subtitle", "time": 18835.67, "timestamp": "05:13:55", "text": "属实。真有趣"}, {"type": "subtitle", "time": 18838.39, "timestamp": "05:13:58", "text": "嗯，因为我的意思是，有些时候……"}]
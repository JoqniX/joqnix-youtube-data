[{"type": "subtitle", "time": 13322.309, "timestamp": "03:42:02", "text": "我是一个糟糕的Z世代。我觉得我"}, {"type": "subtitle", "time": 13326.87, "timestamp": "03:42:06", "text": "会让我同龄的Z世代失望的"}, {"type": "subtitle", "time": 13331.91, "timestamp": "03:42:11", "text": "我对这些新词汇感到多么难过"}, {"type": "subtitle", "time": 13333.429, "timestamp": "03:42:13", "text": "因为"}, {"type": "subtitle", "time": 13335.91, "timestamp": "03:42:15", "text": "我有一半时间都得去露天城市。"}, {"type": "subtitle", "time": 13338.389, "timestamp": "03:42:18", "text": "查字典，然后告诉我这是什么意思"}, {"type": "subtitle", "time": 13341.83, "timestamp": "03:42:21", "text": "请问这是什么意思？"}, {"type": "subtitle", "time": 13345.19, "timestamp": "03:42:25", "text": "我今年50岁。"}, {"type": "subtitle", "time": 13349.19, "timestamp": "03:42:29", "text": "相同的。我的天啊。"}, {"type": "subtitle", "time": 13352.229, "timestamp": "03:42:32", "text": "事情变得很疯狂，因为就像……当"}, {"type": "subtitle", "time": 13355.75, "timestamp": "03:42:35", "text": "你有朋友，还有……"}, {"type": "subtitle", "time": 13357.429, "timestamp": "03:42:37", "text": "你关注的其他主播"}, {"type": "subtitle", "time": 13359.59, "timestamp": "03:42:39", "text": "和那些不来自同一个地方的人"}, {"type": "subtitle", "time": 13362.55, "timestamp": "03:42:42", "text": "像印度这样的人口统计特征，以及当你"}, {"type": "subtitle", "time": 13364.15, "timestamp": "03:42:44", "text": "和他们合作或者只是和他们一起玩。只是"}, {"type": "subtitle", "time": 13366.71, "timestamp": "03:42:46", "text": "就像有些时候，我"}, {"type": "subtitle", "time": 13370.389, "timestamp": "03:42:50", "text": "我知道英语，但现在我"}, {"type": "subtitle", "time": 13379.269, "timestamp": "03:42:59", "text": "我会试试分享聊天功能。我只是"}]
[{"type": "subtitle", "time": 17049.51, "timestamp": "04:44:09", "text": "是的。麦克风相关的问题。哦，是的。你"}, {"type": "subtitle", "time": 17052.39, "timestamp": "04:44:12", "text": "戴上入耳式耳机之类的"}, {"type": "subtitle", "time": 17055.83, "timestamp": "04:44:15", "text": "开销？头顶上方。他们不会给你"}, {"type": "subtitle", "time": 17058.708, "timestamp": "04:44:18", "text": "头痛之类的？"}, {"type": "subtitle", "time": 17062.948, "timestamp": "04:44:22", "text": "嗯，通常不会。但还有一些"}, {"type": "subtitle", "time": 17064.708, "timestamp": "04:44:24", "text": "比如，当我感觉自己已经……的时候"}, {"type": "subtitle", "time": 17069.75, "timestamp": "04:44:29", "text": "筋疲力尽，而且状态不太好。"}, {"type": "subtitle", "time": 17072.628, "timestamp": "04:44:32", "text": "呃，形状。然后就出现了一对"}, {"type": "subtitle", "time": 17081.91, "timestamp": "04:44:41", "text": "因为，嗯，即使它是，它是它，它有点像"}, {"type": "subtitle", "time": 17083.91, "timestamp": "04:44:43", "text": "感觉有点重，因为就像……"}, {"type": "subtitle", "time": 17087.03, "timestamp": "04:44:47", "text": "有时候比我的头还大。我曾"}, {"type": "subtitle", "time": 17089.67, "timestamp": "04:44:49", "text": "比如打火机，蓝牙的那种……"}, {"type": "subtitle", "time": 17094.708, "timestamp": "04:44:54", "text": "头顶上，但是，嗯，我妈妈曾经决定"}, {"type": "subtitle", "time": 17097.19, "timestamp": "04:44:57", "text": "我出差期间请打扫房间。"}]
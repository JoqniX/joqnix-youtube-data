[{"type": "subtitle", "time": 14880.63, "timestamp": "04:08:00", "text": "我走到哪都带着疫苗接种器。和"}, {"type": "subtitle", "time": 14882.71, "timestamp": "04:08:02", "text": "就算我没感冒，我也不会"}, {"type": "subtitle", "time": 14886.389, "timestamp": "04:08:06", "text": "我知道为什么我会喜欢我即将要做的事"}, {"type": "subtitle", "time": 14888.79, "timestamp": "04:08:08", "text": "这。我要去……该怎么称呼它呢？"}, {"type": "subtitle", "time": 14891.99, "timestamp": "04:08:11", "text": "闻一闻。你管这叫什么？"}, {"type": "subtitle", "time": 14894.229, "timestamp": "04:08:14", "text": "当你像使用 Vixie 一样操作时"}, {"type": "subtitle", "time": 14896.229, "timestamp": "04:08:16", "text": "吸入器？"}, {"type": "subtitle", "time": 14900.95, "timestamp": "04:08:20", "text": "吸入。吸入H。是的。是的。吸入。"}, {"type": "subtitle", "time": 14903.51, "timestamp": "04:08:23", "text": "是的。"}, {"type": "subtitle", "time": 14905.269, "timestamp": "04:08:25", "text": "我一直都带着它。但是"}, {"type": "subtitle", "time": 14907.67, "timestamp": "04:08:27", "text": "其实我更像是妈妈那种角色。"}, {"type": "subtitle", "time": 14910.229, "timestamp": "04:08:30", "text": "团队中的朋友。"}, {"type": "subtitle", "time": 14914.309, "timestamp": "04:08:34", "text": "所以我可能会随身携带所有东西"}, {"type": "subtitle", "time": 14916.55, "timestamp": "04:08:36", "text": "如果场景"}, {"type": "subtitle", "time": 14921.83, "timestamp": "04:08:41", "text": "药品安全至关重要。是的，我知道"}, {"type": "subtitle", "time": 14925.349, "timestamp": "04:08:45", "text": "当然，这让我的包变得很重。"}, {"type": "subtitle", "time": 14929.51, "timestamp": "04:08:49", "text": "我累了，但是"}, {"type": "subtitle", "time": 14932.309, "timestamp": "04:08:52", "text": "我的意思是，准备得比……更好。"}, {"type": "subtitle", "time": 14935.67, "timestamp": "04:08:55", "text": "看来我准备不足。嗯。"}, {"type": "subtitle", "time": 14937.349, "timestamp": "04:08:57", "text": "我猜那时候我的身高是"}]
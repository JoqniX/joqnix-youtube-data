[{"type": "subtitle", "time": 16925.43, "timestamp": "04:42:05", "text": "嗯。好的。你问的是我忘记的事情"}, {"type": "subtitle", "time": 16928.39, "timestamp": "04:42:08", "text": "比如为什么麦克风不能用。哦"}, {"type": "subtitle", "time": 16931.91, "timestamp": "04:42:11", "text": "是的。是的。发生了什么？就像这辆车"}, {"type": "subtitle", "time": 16935.27, "timestamp": "04:42:15", "text": "断绝联系了，或者就像我觉得我喜欢你一样"}, {"type": "subtitle", "time": 16938.07, "timestamp": "04:42:18", "text": "因为我移动了，所以USB接口有点晃动。"}, {"type": "subtitle", "time": 16941.75, "timestamp": "04:42:21", "text": "一点。所以，呃……"}, {"type": "subtitle", "time": 16943.99, "timestamp": "04:42:23", "text": "是的，这种情况确实会发生。"}, {"type": "subtitle", "time": 16946.628, "timestamp": "04:42:26", "text": "我认为他们看到的只是瞬间。"}, {"type": "subtitle", "time": 16948.708, "timestamp": "04:42:28", "text": "那里。但你会在他们之前听到他们的声音"}, {"type": "subtitle", "time": 16953.27, "timestamp": "04:42:33", "text": "进入房间。那才是事实。"}, {"type": "subtitle", "time": 16955.99, "timestamp": "04:42:35", "text": "这就是导致个人信息被曝光的一种方式。"}, {"type": "subtitle", "time": 16958.55, "timestamp": "04:42:38", "text": "真实姓名或其他什么名字。"}, {"type": "subtitle", "time": 16961.83, "timestamp": "04:42:41", "text": "我知道，我的意思是，谢天谢地，我有一个"}, {"type": "subtitle", "time": 16964.708, "timestamp": "04:42:44", "text": "一个跟我完全不沾边的昵称"}, {"type": "subtitle", "time": 16967.67, "timestamp": "04:42:47", "text": "姓名。所以"}, {"type": "subtitle", "time": 16969.59, "timestamp": "04:42:49", "text": "那里有。"}, {"type": "subtitle", "time": 16971.75, "timestamp": "04:42:51", "text": "甚至那些我会告诉妈妈的话，“好吧，"}, {"type": "subtitle", "time": 16974.31, "timestamp": "04:42:54", "text": "妈妈，我会直播的。"}, {"type": "subtitle", "time": 16978.07, "timestamp": "04:42:58", "text": "然后她就会进来。"}]
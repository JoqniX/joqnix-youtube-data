[{"type": "subtitle", "time": 18721.35, "timestamp": "05:12:01", "text": "基本上，当我还是个……的时候"}, {"type": "subtitle", "time": 18722.868, "timestamp": "05:12:02", "text": "一对夫妇的幼儿园老师"}, {"type": "subtitle", "time": 18726.07, "timestamp": "05:12:06", "text": "年。这是班上发生的事情。"}, {"type": "subtitle", "time": 18729.27, "timestamp": "05:12:09", "text": "孩子们上课的时候会这样做"}, {"type": "subtitle", "time": 18730.788, "timestamp": "05:12:10", "text": "在巴士来接之前就结束了"}, {"type": "subtitle", "time": 18733.51, "timestamp": "05:12:13", "text": "他们会把它们捡起来，采摘鲜花。"}, {"type": "subtitle", "time": 18736.15, "timestamp": "05:12:16", "text": "那是在院子里，他们会"}, {"type": "subtitle", "time": 18739.51, "timestamp": "05:12:19", "text": "过来把那些东西放到我头发上。由"}, {"type": "subtitle", "time": 18742.39, "timestamp": "05:12:22", "text": "到头来，我的头发就只是……"}, {"type": "subtitle", "time": 18744.55, "timestamp": "05:12:24", "text": "里面装满了鲜花。"}, {"type": "subtitle", "time": 18749.43, "timestamp": "05:12:29", "text": "好可爱。但说实话，我就一直留着它。"}, {"type": "subtitle", "time": 18752.788, "timestamp": "05:12:32", "text": "很简单，比如，呃，我就是个健忘的人。"}, {"type": "subtitle", "time": 18760.31, "timestamp": "05:12:40", "text": "是的。我想，目标就是如此。"}, {"type": "subtitle", "time": 18762.708, "timestamp": "05:12:42", "text": "它给了我很大的自由。"}, {"type": "subtitle", "time": 18765.59, "timestamp": "05:12:45", "text": "健忘。我可以修改背景故事。"}, {"type": "subtitle", "time": 18768.788, "timestamp": "05:12:48", "text": "随时都可以。"}, {"type": "subtitle", "time": 18770.55, "timestamp": "05:12:50", "text": "嗯。"}, {"type": "subtitle", "time": 18773.75, "timestamp": "05:12:53", "text": "Rayu，你为什么要这样对我？"}, {"type": "subtitle", "time": 18777.27, "timestamp": "05:12:57", "text": "Rayu，生日快乐。我的天啊。"}, {"type": "subtitle", "time": 18779.59, "timestamp": "05:12:59", "text": "生日快乐。公平的。我收回刚才的话。"}]
[{"type": "subtitle", "time": 19020.868, "timestamp": "05:17:00", "text": "把显示屏翻转一下。哦，我的"}, {"type": "subtitle", "time": 19023.51, "timestamp": "05:17:03", "text": "上帝。我也这么做了。"}, {"type": "subtitle", "time": 19026.15, "timestamp": "05:17:06", "text": "一切都颠倒了。而此时"}, {"type": "subtitle", "time": 19028.39, "timestamp": "05:17:08", "text": "我的意思是，你为什么要让我……"}, {"type": "subtitle", "time": 19037.67, "timestamp": "05:17:17", "text": "相信我们，莉娜，我亲爱的火系双胞胎姐妹。"}, {"type": "subtitle", "time": 19039.99, "timestamp": "05:17:19", "text": "我确实信任你们，但同时"}, {"type": "subtitle", "time": 19047.59, "timestamp": "05:17:27", "text": "我的天啊，我以前有评论"}, {"type": "subtitle", "time": 19051.75, "timestamp": "05:17:31", "text": "向下。所以接下来会发生什么呢？"}, {"type": "subtitle", "time": 19054.628, "timestamp": "05:17:34", "text": "别戴眼镜了。所以会有"}, {"type": "subtitle", "time": 19058.15, "timestamp": "05:17:38", "text": "收到提示，表示已准备好同意"}, {"type": "subtitle", "time": 19060.47, "timestamp": "05:17:40", "text": "东西。所以我不得不把我的"}, {"type": "subtitle", "time": 19063.99, "timestamp": "05:17:43", "text": "上课后，按“是”或“否”按钮。"}, {"type": "subtitle", "time": 19066.948, "timestamp": "05:17:46", "text": "我可以启动并执行"}, {"type": "subtitle", "time": 19069.99, "timestamp": "05:17:49", "text": "倒计时什么的都有，但它确实有效。"}, {"type": "subtitle", "time": 19073.11, "timestamp": "05:17:53", "text": "我让旋转变得更加痛苦。"}, {"type": "subtitle", "time": 19075.99, "timestamp": "05:17:55", "text": "东西。正确的。所以我就想，“好吧，我……”"}, {"type": "subtitle", "time": 19077.91, "timestamp": "05:17:57", "text": "将会"}]
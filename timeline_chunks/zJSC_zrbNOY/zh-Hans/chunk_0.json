[{"type": "subtitle", "time": 7.51, "timestamp": "00:00:07", "text": "午夜"}, {"type": "subtitle", "time": 13.669, "timestamp": "00:00:13", "text": "顺便说一句，我觉得我还可以接受。"}, {"type": "subtitle", "time": 15.509, "timestamp": "00:00:15", "text": "午夜。我不知道这是不是真的。"}, {"type": "subtitle", "time": 19.75, "timestamp": "00:00:19", "text": "尽管。我打算试试午夜正餐。在哪里？"}, {"type": "subtitle", "time": 22.87, "timestamp": "00:00:22", "text": "午夜？正确的。呃"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "午夜。"}, {"type": "subtitle", "time": 27.589, "timestamp": "00:00:27", "text": "呃"}, {"type": "subtitle", "time": 29.429, "timestamp": "00:00:29", "text": "有一个。"}, {"type": "subtitle", "time": 32.15, "timestamp": "00:00:32", "text": "你好。就是它。等待。"}, {"type": "subtitle", "time": 42.069, "timestamp": "00:00:42", "text": "[音乐]"}, {"type": "subtitle", "time": 46.79, "timestamp": "00:00:46", "text": "你好。三，二，"}]
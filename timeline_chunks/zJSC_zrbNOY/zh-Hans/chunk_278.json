[{"type": "subtitle", "time": 16682.709, "timestamp": "04:38:02", "text": "有时在某种程度上"}, {"type": "subtitle", "time": 16684.629, "timestamp": "04:38:04", "text": "当然，有时候你会遇到糟糕的情况。"}, {"type": "subtitle", "time": 16687.59, "timestamp": "04:38:07", "text": "白天，呃，你大概能看出……"}, {"type": "subtitle", "time": 16690.789, "timestamp": "04:38:10", "text": "比如我指的是那种人，即使他们是"}, {"type": "subtitle", "time": 16692.31, "timestamp": "04:38:12", "text": "流媒体，你知道你有点"}, {"type": "subtitle", "time": 16695.349, "timestamp": "04:38:15", "text": "他们有这个，而且他们也接受。"}, {"type": "subtitle", "time": 16697.109, "timestamp": "04:38:17", "text": "如果他们没事的话，那是第一件事。"}, {"type": "subtitle", "time": 16699.99, "timestamp": "04:38:19", "text": "那东西"}, {"type": "subtitle", "time": 16701.91, "timestamp": "04:38:21", "text": "所以，虽然有所不同，但本质上是相同的"}, {"type": "subtitle", "time": 16703.83, "timestamp": "04:38:23", "text": "我觉得时间有点……"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "感觉很奇怪，就像你突然就来了一样。"}, {"type": "subtitle", "time": 16708.39, "timestamp": "04:38:28", "text": "进入别人的直播间，然后就闹出各种闹剧。"}, {"type": "subtitle", "time": 16711.91, "timestamp": "04:38:31", "text": "倾倒。是的。"}, {"type": "subtitle", "time": 16716.15, "timestamp": "04:38:36", "text": "真奇怪。比如为什么你不能做"}, {"type": "subtitle", "time": 16718.629, "timestamp": "04:38:38", "text": "那？"}, {"type": "subtitle", "time": 16720.789, "timestamp": "04:38:40", "text": "因为我们不知道。也许他们会说"}, {"type": "subtitle", "time": 16723.029, "timestamp": "04:38:43", "text": "可能会引发另一件事"}, {"type": "subtitle", "time": 16727.349, "timestamp": "04:38:47", "text": "我们直播流中的人。 M，我们没有"}, {"type": "subtitle", "time": 16730.15, "timestamp": "04:38:50", "text": "知道这一点的方法。所以就像"}]
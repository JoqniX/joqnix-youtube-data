[{"type": "subtitle", "time": 16201.75, "timestamp": "04:30:01", "text": "语音聊天，他说了所有这些话，"}, {"type": "subtitle", "time": 16204.07, "timestamp": "04:30:04", "text": "是的，自从我经历了那场创伤之后，就一直如此。"}, {"type": "subtitle", "time": 16205.91, "timestamp": "04:30:05", "text": "对抗创伤后应激障碍。"}, {"type": "subtitle", "time": 16208.87, "timestamp": "04:30:08", "text": "即使……我想还有另一个"}, {"type": "subtitle", "time": 16214.07, "timestamp": "04:30:14", "text": "带有 Discord 语音聊天功能的实例。我使用"}, {"type": "subtitle", "time": 16218.55, "timestamp": "04:30:18", "text": "呃，我会在我的Discord语音频道里活跃起来，我在那里"}, {"type": "subtitle", "time": 16221.75, "timestamp": "04:30:21", "text": "让大家都进来吧，因为 Discord 是一个"}, {"type": "subtitle", "time": 16223.67, "timestamp": "04:30:23", "text": "为你的社区提供一个聚会场所和"}, {"type": "subtitle", "time": 16226.71, "timestamp": "04:30:26", "text": "感觉不错，对吧？是的。"}, {"type": "subtitle", "time": 16230.389, "timestamp": "04:30:30", "text": "呃，我觉得2020年期间，呃，我的"}, {"type": "subtitle", "time": 16232.55, "timestamp": "04:30:32", "text": "Discord 当时很火爆，我猜每个人都在用。"}, {"type": "subtitle", "time": 16235.51, "timestamp": "04:30:35", "text": "聊天什么的，我以前……"}, {"type": "subtitle", "time": 16238.87, "timestamp": "04:30:38", "text": "帮助其他 YouTuber 的 Discord 服务器"}, {"type": "subtitle", "time": 16241.67, "timestamp": "04:30:41", "text": "呃，现在有个下士连队"}, {"type": "subtitle", "time": 16246.149, "timestamp": "04:30:46", "text": "对于 Taskscape 来说，所以在他们的 Discord 之前"}, {"type": "subtitle", "time": 16248.95, "timestamp": "04:30:48", "text": "服务器是我用过的。"}, {"type": "subtitle", "time": 16251.189, "timestamp": "04:30:51", "text": "以前经常在我的淋浴间里闲逛"}, {"type": "subtitle", "time": 16254.63, "timestamp": "04:30:54", "text": "一切都很顺利，而且很有趣，之后"}, {"type": "subtitle", "time": 16257.11, "timestamp": "04:30:57", "text": "虽然呃，人们过去常常这样做，当他们都"}, {"type": "subtitle", "time": 16259.91, "timestamp": "04:30:59", "text": "他们有自己的公共淋浴间，其他"}]
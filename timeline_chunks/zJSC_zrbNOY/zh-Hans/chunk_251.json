[{"type": "subtitle", "time": 15060.469, "timestamp": "04:11:00", "text": "我费了好大劲才说服我女朋友"}, {"type": "subtitle", "time": 15064.15, "timestamp": "04:11:04", "text": "我的家人让我走，因为……我当时"}, {"type": "subtitle", "time": 15066.79, "timestamp": "04:11:06", "text": "原计划下个月去日本。"}, {"type": "subtitle", "time": 15069.349, "timestamp": "04:11:09", "text": "所以很难说服他们，但"}, {"type": "subtitle", "time": 15072.15, "timestamp": "04:11:12", "text": "幸好附近有个油管博主。"}, {"type": "subtitle", "time": 15075.83, "timestamp": "04:11:15", "text": "在我看来，他住在附近。所以当时"}, {"type": "subtitle", "time": 15078.309, "timestamp": "04:11:18", "text": "比如，“哦，等等。我不知道你住在这里。”"}, {"type": "subtitle", "time": 15081.189, "timestamp": "04:11:21", "text": "你们住得很近，而且你们来自同一个州。"}, {"type": "subtitle", "time": 15085.03, "timestamp": "04:11:25", "text": "就像我一样。”然后，呃，我们，呃，是的，我想"}, {"type": "subtitle", "time": 15088.79, "timestamp": "04:11:28", "text": "我和他的家人谈过。"}, {"type": "subtitle", "time": 15090.63, "timestamp": "04:11:30", "text": "我和家人谈过了，他们同意了。"}, {"type": "subtitle", "time": 15093.75, "timestamp": "04:11:33", "text": "于是我们就去了，我就是这样认识他的。"}, {"type": "subtitle", "time": 15096.79, "timestamp": "04:11:36", "text": "每个人。几个路过的人"}, {"type": "subtitle", "time": 15100.79, "timestamp": "04:11:40", "text": "那里。这是一次非常愉快的经历。"}, {"type": "subtitle", "time": 15104.63, "timestamp": "04:11:44", "text": "试试像北方人那样，比如庞福德"}, {"type": "subtitle", "time": 15108.309, "timestamp": "04:11:48", "text": "还有北方的食物等等"}, {"type": "subtitle", "time": 15111.349, "timestamp": "04:11:51", "text": "我想我试过那玩意儿"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "叫什么教堂之类的"}]
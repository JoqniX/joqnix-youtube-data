[{"type": "subtitle", "time": 16443.189, "timestamp": "04:34:03", "text": "不会受伤，这是件好事，而且……"}, {"type": "subtitle", "time": 16446.709, "timestamp": "04:34:06", "text": "不知何时，他们开始对着……尖叫。"}, {"type": "subtitle", "time": 16448.949, "timestamp": "04:34:08", "text": "我和一些东西，只是为了说好话而已。"}, {"type": "subtitle", "time": 16451.349, "timestamp": "04:34:11", "text": "并仔细聆听。他们生气的时候"}, {"type": "subtitle", "time": 16453.83, "timestamp": "04:34:13", "text": "他们以前经常打我之类的。所以，我"}, {"type": "subtitle", "time": 16457.51, "timestamp": "04:34:17", "text": "当时我就想，“哇，我以前也见过它。”"}, {"type": "subtitle", "time": 16461.189, "timestamp": "04:34:21", "text": "也影响了我的精神状态。就像你一样。"}, {"type": "subtitle", "time": 16463.59, "timestamp": "04:34:23", "text": "那次直播的时候，他……"}, {"type": "subtitle", "time": 16466.47, "timestamp": "04:34:26", "text": "比如直播里出现自杀倾向之类的，我"}, {"type": "subtitle", "time": 16469.269, "timestamp": "04:34:29", "text": "我当场哭了起来，问他为什么这么说"}, {"type": "subtitle", "time": 16472.31, "timestamp": "04:34:32", "text": "比如我，呃，喜欢用强烈的措辞之类的。"}, {"type": "subtitle", "time": 16474.07, "timestamp": "04:34:34", "text": "就是这样。"}, {"type": "subtitle", "time": 16476.23, "timestamp": "04:34:36", "text": "发生了很多事。我当时就像"}, {"type": "subtitle", "time": 16479.189, "timestamp": "04:34:39", "text": "然后我周围的人都问：为什么？"}, {"type": "subtitle", "time": 16482.07, "timestamp": "04:34:42", "text": "你是不是在浪费时间在别人身上？"}, {"type": "subtitle", "time": 16484.949, "timestamp": "04:34:44", "text": "喜欢他们吗？以及所有的一切。而且一直"}, {"type": "subtitle", "time": 16487.83, "timestamp": "04:34:47", "text": "嗯，那是我第一次"}, {"type": "subtitle", "time": 16491.349, "timestamp": "04:34:51", "text": "我决定屏蔽某人。"}, {"type": "subtitle", "time": 16494.709, "timestamp": "04:34:54", "text": "一生。虽然很难，但我"}, {"type": "subtitle", "time": 16497.269, "timestamp": "04:34:57", "text": "我尽力了。后来我才知道，"}]
[{"type": "subtitle", "time": 2947.43, "timestamp": "00:49:07", "text": "当然，我可以重新安排合作时间。"}, {"type": "subtitle", "time": 2952.95, "timestamp": "00:49:12", "text": "但如果我注定要……，那这一切又有什么意义呢？"}, {"type": "subtitle", "time": 2956.069, "timestamp": "00:49:16", "text": "每天24小时都这样做"}, {"type": "subtitle", "time": 2958.87, "timestamp": "00:49:18", "text": "即使我本人不在那里"}, {"type": "subtitle", "time": 2961.829, "timestamp": "00:49:21", "text": "溪流，"}, {"type": "subtitle", "time": 2965.67, "timestamp": "00:49:25", "text": "我还会在那里。"}, {"type": "subtitle", "time": 2967.91, "timestamp": "00:49:27", "text": "正确的？"}, {"type": "subtitle", "time": 2971.51, "timestamp": "00:49:31", "text": "所以问题就变成了这样"}, {"type": "subtitle", "time": 2987.67, "timestamp": "00:49:47", "text": "兄弟，我这是怎么了？"}]
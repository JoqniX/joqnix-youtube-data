[{"type": "subtitle", "time": 18481.19, "timestamp": "05:08:01", "text": "观众们只是来这里闲逛的，而我"}, {"type": "subtitle", "time": 18485.91, "timestamp": "05:08:05", "text": "我真的很喜欢，因为我知道这有多重要"}, {"type": "subtitle", "time": 18489.99, "timestamp": "05:08:09", "text": "我在直播中创作的东西。"}, {"type": "subtitle", "time": 18494.47, "timestamp": "05:08:14", "text": "我的意思是，哦，问题是我真的有"}, {"type": "subtitle", "time": 18497.27, "timestamp": "05:08:17", "text": "罕见的、一切运转正常的流媒体"}, {"type": "subtitle", "time": 18500.628, "timestamp": "05:08:20", "text": "从第一点开始。"}, {"type": "subtitle", "time": 18502.708, "timestamp": "05:08:22", "text": "因为总是这样，就像纳美人一样"}, {"type": "subtitle", "time": 18504.31, "timestamp": "05:08:24", "text": "有人会加入进来，他们是"}, {"type": "subtitle", "time": 18508.15, "timestamp": "05:08:28", "text": "会说：“我们听不到你说话。”"}, {"type": "subtitle", "time": 18511.03, "timestamp": "05:08:31", "text": "然后我就会想，“哦，糟了，我一直……”"}, {"type": "subtitle", "time": 18513.35, "timestamp": "05:08:33", "text": "我一直在自言自语。”"}, {"type": "subtitle", "time": 18516.23, "timestamp": "05:08:36", "text": "然后总会有那么一些时刻，你会想起我的妈妈"}, {"type": "subtitle", "time": 18518.628, "timestamp": "05:08:38", "text": "或者有人会进来，然后我会"}, {"type": "subtitle", "time": 18520.39, "timestamp": "05:08:40", "text": "我先快速把自己静音，然后我"}, {"type": "subtitle", "time": 18522.628, "timestamp": "05:08:42", "text": "忘记取消静音，我就会……"}, {"type": "subtitle", "time": 18527.75, "timestamp": "05:08:47", "text": "Cuff是真的。嗯，我很高兴"}, {"type": "subtitle", "time": 18538.31, "timestamp": "05:08:58", "text": "是的，我在高峰期提供一些垃圾内容。"}]
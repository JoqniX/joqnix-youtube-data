[{"type": "subtitle", "time": 14161.349, "timestamp": "03:56:01", "text": "呃，我去过那里。有人跟我说了很多话。"}, {"type": "subtitle", "time": 14163.99, "timestamp": "03:56:03", "text": "明明说了其他事，却突然说我"}, {"type": "subtitle", "time": 14166.389, "timestamp": "03:56:06", "text": "我跟在你后面走了。"}, {"type": "subtitle", "time": 14170.15, "timestamp": "03:56:10", "text": "请回关我。哎呀。那是一个"}, {"type": "subtitle", "time": 14181.03, "timestamp": "03:56:21", "text": "对我来说，我安排了很多事情，比如"}, {"type": "subtitle", "time": 14182.71, "timestamp": "03:56:22", "text": "多种的"}, {"type": "subtitle", "time": 14186.389, "timestamp": "03:56:26", "text": "Discord 的机器人会做一些类似的事情。"}, {"type": "subtitle", "time": 14189.269, "timestamp": "03:56:29", "text": "验证装置，捕获装置，"}, {"type": "subtitle", "time": 14192.71, "timestamp": "03:56:32", "text": "一切。而且还有些小屁孩"}, {"type": "subtitle", "time": 14195.91, "timestamp": "03:56:35", "text": "谁就像某些人一样"}, {"type": "subtitle", "time": 14198.63, "timestamp": "03:56:38", "text": "捕捉那件事太难了，就像……"}, {"type": "subtitle", "time": 14200.229, "timestamp": "03:56:40", "text": "是不习惯这种状况的人"}, {"type": "subtitle", "time": 14202.79, "timestamp": "03:56:42", "text": "Discord 现已推出相关功能。所以我不得不喜欢"}, {"type": "subtitle", "time": 14205.59, "timestamp": "03:56:45", "text": "想想它们。所以我就想，好吧。"}, {"type": "subtitle", "time": 14208.79, "timestamp": "03:56:48", "text": "你可以通过这个渠道进行验证。"}, {"type": "subtitle", "time": 14211.269, "timestamp": "03:56:51", "text": "你只需要……是的，就是你。"}, {"type": "subtitle", "time": 14214.15, "timestamp": "03:56:54", "text": "重定向到那里并获取"}, {"type": "subtitle", "time": 14217.51, "timestamp": "03:56:57", "text": "反应作用。您将获得验证，"}]
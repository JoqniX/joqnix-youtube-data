[{"type": "subtitle", "time": 3013.91, "timestamp": "00:50:13", "text": "像这样看待这次合作"}, {"type": "subtitle", "time": 3022.069, "timestamp": "00:50:22", "text": "正确的？"}, {"type": "subtitle", "time": 3024.15, "timestamp": "00:50:24", "text": "有时我觉得也许是我做的"}, {"type": "subtitle", "time": 3027.109, "timestamp": "00:50:27", "text": "错误的。也许我不该说那些话"}, {"type": "subtitle", "time": 3029.109, "timestamp": "00:50:29", "text": "真相，"}, {"type": "subtitle", "time": 3031.91, "timestamp": "00:50:31", "text": "正确的？我身上发生的事情是……"}, {"type": "subtitle", "time": 3039.349, "timestamp": "00:50:39", "text": "入学申请被推迟，而不是"}, {"type": "subtitle", "time": 3049.91, "timestamp": "00:50:49", "text": "如果是因为，嗯，既然我提到了，但是就像"}, {"type": "subtitle", "time": 3053.349, "timestamp": "00:50:53", "text": "很多人取消了行程，改期了。"}, {"type": "subtitle", "time": 3056.25, "timestamp": "00:50:56", "text": "无处"}, {"type": "subtitle", "time": 3057.67, "timestamp": "00:50:57", "text": "[音乐]"}]
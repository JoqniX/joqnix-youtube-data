[{"type": "subtitle", "time": 15305.03, "timestamp": "04:15:05", "text": "我这就离开这里。感谢"}, {"type": "subtitle", "time": 15307.269, "timestamp": "04:15:07", "text": "非常感谢。没有。"}, {"type": "subtitle", "time": 15309.67, "timestamp": "04:15:09", "text": "你拿到拉面了吗？你"}, {"type": "subtitle", "time": 15313.59, "timestamp": "04:15:13", "text": "忘了？不，我没有。我确实考虑过"}, {"type": "subtitle", "time": 15315.11, "timestamp": "04:15:15", "text": "我回去拿，但后来我"}, {"type": "subtitle", "time": 15316.389, "timestamp": "04:15:16", "text": "算了，没什么。我不想去"}, {"type": "subtitle", "time": 15327.349, "timestamp": "04:15:27", "text": "当我在网上遇到那些油管博主时"}, {"type": "subtitle", "time": 15330.07, "timestamp": "04:15:30", "text": "呃，就像现在在浦那的真实生活一样，我当时"}, {"type": "subtitle", "time": 15332.229, "timestamp": "04:15:32", "text": "就像，“我的天哪，这些人是"}, {"type": "subtitle", "time": 15333.99, "timestamp": "04:15:33", "text": "真实的。”"}, {"type": "subtitle", "time": 15337.99, "timestamp": "04:15:37", "text": "我的第一反应就像是……"}, {"type": "subtitle", "time": 15339.91, "timestamp": "04:15:39", "text": "呃，我好像见过他们两三次。"}, {"type": "subtitle", "time": 15343.189, "timestamp": "04:15:43", "text": "几年前。我们在Discord上聊过，"}, {"type": "subtitle", "time": 15347.91, "timestamp": "04:15:47", "text": "通过 Discord 之类的平台或者 Twitter"}, {"type": "subtitle", "time": 15350.469, "timestamp": "04:15:50", "text": "亲眼见到他们，就像在现实生活中一样。"}, {"type": "subtitle", "time": 15353.75, "timestamp": "04:15:53", "text": "现实生活。我的天啊。我当时就想，“哦，我的天哪”"}, {"type": "subtitle", "time": 15356.55, "timestamp": "04:15:56", "text": "天哪，这太真实了。你是真人吗？真实的。"}, {"type": "subtitle", "time": 15359.429, "timestamp": "04:15:59", "text": "这不是假的。没错。那是我的"}]
[{"type": "subtitle", "time": 18181.03, "timestamp": "05:03:01", "text": "他们可以进行适当的沟通。"}, {"type": "subtitle", "time": 18182.55, "timestamp": "05:03:02", "text": "如今无需语言也能交流"}, {"type": "subtitle", "time": 18185.91, "timestamp": "05:03:05", "text": "障碍从来都不是问题。所以他们可能会"}, {"type": "subtitle", "time": 18187.67, "timestamp": "05:03:07", "text": "他们和我合作过，所以他们"}, {"type": "subtitle", "time": 18191.67, "timestamp": "05:03:11", "text": "他们建议得对，所以我采纳了。"}, {"type": "subtitle", "time": 18194.948, "timestamp": "05:03:14", "text": "然后，嗯，我途经雅加达。"}, {"type": "subtitle", "time": 18197.19, "timestamp": "05:03:17", "text": "应该像获得它一样揭示它"}, {"type": "subtitle", "time": 18199.51, "timestamp": "05:03:19", "text": "获得许可，然后像吊人胃口一样把它揭晓出来。"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "然后我注意到另一件事"}, {"type": "subtitle", "time": 18204.39, "timestamp": "05:03:24", "text": "出现了类似PSC文件那样的复杂情况"}, {"type": "subtitle", "time": 18207.91, "timestamp": "05:03:27", "text": "现在它有一些缺陷等等。"}, {"type": "subtitle", "time": 18211.03, "timestamp": "05:03:31", "text": "就像……它没有被正确分离一样。"}, {"type": "subtitle", "time": 18215.11, "timestamp": "05:03:35", "text": "这不是可以操纵的时刻，而且呃，因为"}, {"type": "subtitle", "time": 18217.99, "timestamp": "05:03:37", "text": "就像它有很多ho，而且它将要"}, {"type": "subtitle", "time": 18220.628, "timestamp": "05:03:40", "text": "这将是我的第一次，我的第一次"}, {"type": "subtitle", "time": 18223.35, "timestamp": "05:03:43", "text": "比如委托他人或喜欢做"}, {"type": "subtitle", "time": 18225.67, "timestamp": "05:03:45", "text": "其他人也会做这种事"}, {"type": "subtitle", "time": 18228.07, "timestamp": "05:03:48", "text": "正在做。所以我觉得这简直太不可思议了。"}, {"type": "subtitle", "time": 18231.11, "timestamp": "05:03:51", "text": "即使我买了这款型号，数量和专业性也一样。"}, {"type": "subtitle", "time": 18233.03, "timestamp": "05:03:53", "text": "我至少会用它"}, {"type": "subtitle", "time": 18236.07, "timestamp": "05:03:56", "text": "5到10年，因为它太贵了。我"}, {"type": "subtitle", "time": 18239.59, "timestamp": "05:03:59", "text": "我觉得我买不起这样的衣服"}]
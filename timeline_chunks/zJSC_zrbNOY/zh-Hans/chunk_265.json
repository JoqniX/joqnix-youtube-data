[{"type": "subtitle", "time": 15902.389, "timestamp": "04:25:02", "text": "只有他们会像拿走那玩意儿一样跟随。"}, {"type": "subtitle", "time": 15904.71, "timestamp": "04:25:04", "text": "点赞、关注、聊天"}, {"type": "subtitle", "time": 15907.349, "timestamp": "04:25:07", "text": "聊天，对吧？所以，他们会检查他们是否收到"}, {"type": "subtitle", "time": 15909.91, "timestamp": "04:25:09", "text": "去查看和所有东西"}, {"type": "subtitle", "time": 15911.51, "timestamp": "04:25:11", "text": "就是这样。"}, {"type": "subtitle", "time": 15914.229, "timestamp": "04:25:14", "text": "我感觉还行，就像……之后那样。"}, {"type": "subtitle", "time": 15916.87, "timestamp": "04:25:16", "text": "那个机器人事件发生了，嗯，我的朋友"}, {"type": "subtitle", "time": 15920.469, "timestamp": "04:25:20", "text": "建议我加入 Siri 机器人，但是"}, {"type": "subtitle", "time": 15922.79, "timestamp": "04:25:22", "text": "那之后就一直很平静，所以"}, {"type": "subtitle", "time": 15925.75, "timestamp": "04:25:25", "text": "我以前从未有过那种经历。"}, {"type": "subtitle", "time": 15929.03, "timestamp": "04:25:29", "text": "目前还没有发生什么事，我希望自己不会遇到。"}, {"type": "subtitle", "time": 15931.11, "timestamp": "04:25:31", "text": "我已经受够了。"}, {"type": "subtitle", "time": 15934.229, "timestamp": "04:25:34", "text": "是啊，雪莉酒真好喝。我很高兴"}, {"type": "subtitle", "time": 15936.229, "timestamp": "04:25:36", "text": "我已经做好了。"}, {"type": "subtitle", "time": 15939.189, "timestamp": "04:25:39", "text": "我无法给予足够的祝福和祝福。"}, {"type": "subtitle", "time": 15941.429, "timestamp": "04:25:41", "text": "向那个人致以美好的祝愿和祈祷。它是"}, {"type": "subtitle", "time": 15944.309, "timestamp": "04:25:44", "text": "就像你为我们做了很多事一样。"}, {"type": "subtitle", "time": 15946.35, "timestamp": "04:25:46", "text": "太感谢了。"}, {"type": "subtitle", "time": 15948.469, "timestamp": "04:25:48", "text": "[音乐]"}, {"type": "subtitle", "time": 15950.55, "timestamp": "04:25:50", "text": "真是个好孩子。我希望有这样的机会"}, {"type": "subtitle", "time": 15957.269, "timestamp": "04:25:57", "text": "你有没有遇到过什么奇怪的事情？"}, {"type": "subtitle", "time": 15959.67, "timestamp": "04:25:59", "text": "比如YouTube之类的？"}]
[{"type": "subtitle", "time": 17402.31, "timestamp": "04:50:02", "text": "就像他们第一次画画一样……"}, {"type": "subtitle", "time": 17407.27, "timestamp": "04:50:07", "text": "动漫类型人形呃呃角色人类"}, {"type": "subtitle", "time": 17409.99, "timestamp": "04:50:09", "text": "因为他们过去常常做抽象画。"}, {"type": "subtitle", "time": 17415.91, "timestamp": "04:50:15", "text": "怪物类型呃艺术更多。是的。和"}, {"type": "subtitle", "time": 17418.31, "timestamp": "04:50:18", "text": "问题来了，你想要什么？"}, {"type": "subtitle", "time": 17421.51, "timestamp": "04:50:21", "text": "想成为 YouTuber 吗？我当时就想，嗯，我是"}, {"type": "subtitle", "time": 17424.788, "timestamp": "04:50:24", "text": "好困惑。我该怎么办？然后我"}, {"type": "subtitle", "time": 17429.35, "timestamp": "04:50:29", "text": "我记得我以前很喜欢观星。"}, {"type": "subtitle", "time": 17432.708, "timestamp": "04:50:32", "text": "小时候。呃，晚上，我以前常去"}, {"type": "subtitle", "time": 17435.19, "timestamp": "04:50:35", "text": "在我家大门外看看"}, {"type": "subtitle", "time": 17438.788, "timestamp": "04:50:38", "text": "天上的星星，就像"}, {"type": "subtitle", "time": 17440.868, "timestamp": "04:50:40", "text": "过去常常用来数它们，或者许愿。"}, {"type": "subtitle", "time": 17443.35, "timestamp": "04:50:43", "text": "如果我看到像流星一样的东西，或者"}, {"type": "subtitle", "time": 17446.23, "timestamp": "04:50:46", "text": "某物。所以我真的很喜欢看到这一点。"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "星星。我以前可能偶尔会"}, {"type": "subtitle", "time": 17451.59, "timestamp": "04:50:51", "text": "将星形点连接成一个名字或"}, {"type": "subtitle", "time": 17455.03, "timestamp": "04:50:55", "text": "大概就是这样。很有趣。所以，我"}, {"type": "subtitle", "time": 17457.51, "timestamp": "04:50:57", "text": "我想，啊，也许我可以成为一个"}, {"type": "subtitle", "time": 17459.99, "timestamp": "04:50:59", "text": "星座或旋转的物体"}]
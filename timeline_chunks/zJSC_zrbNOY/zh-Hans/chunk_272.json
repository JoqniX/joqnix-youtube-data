[{"type": "subtitle", "time": 16321.83, "timestamp": "04:32:01", "text": "真是个变态。我当时"}, {"type": "subtitle", "time": 16325.51, "timestamp": "04:32:05", "text": "试图表现出同情心和同理心，或者我"}, {"type": "subtitle", "time": 16327.99, "timestamp": "04:32:07", "text": "不知道。是的，因为我知道这一点。"}, {"type": "subtitle", "time": 16332.149, "timestamp": "04:32:12", "text": "这就像，呃，他很成熟，但是"}, {"type": "subtitle", "time": 16335.189, "timestamp": "04:32:15", "text": "也不知道如何交朋友"}, {"type": "subtitle", "time": 16338.63, "timestamp": "04:32:18", "text": "但他处理这件事的方式是错误的。"}, {"type": "subtitle", "time": 16342.87, "timestamp": "04:32:22", "text": "因为他可能不知道，而我当时就想："}, {"type": "subtitle", "time": 16346.309, "timestamp": "04:32:26", "text": "是的，问题是他用了我的"}, {"type": "subtitle", "time": 16350.95, "timestamp": "04:32:30", "text": "他在社交媒体上的名字就像，嗯，是的，我的大"}, {"type": "subtitle", "time": 16355.03, "timestamp": "04:32:35", "text": "哥哥或姐姐是乔等等等等"}, {"type": "subtitle", "time": 16357.429, "timestamp": "04:32:37", "text": "因为其他受害者也是他的受害者。"}, {"type": "subtitle", "time": 16360.07, "timestamp": "04:32:40", "text": "他们看到自己会变成什么样，就像……"}, {"type": "subtitle", "time": 16362.389, "timestamp": "04:32:42", "text": "问，私信我，问，“Jock，为什么……”"}, {"type": "subtitle", "time": 16364.87, "timestamp": "04:32:44", "text": "你引用了这个人的东西？"}, {"type": "subtitle", "time": 16366.95, "timestamp": "04:32:46", "text": "甚至有人拉黑了。我当时就想，"}, {"type": "subtitle", "time": 16369.429, "timestamp": "04:32:49", "text": "“发生了什么事？出什么事了？”和"}, {"type": "subtitle", "time": 16371.59, "timestamp": "04:32:51", "text": "我联系了其中一位创作者，"}, {"type": "subtitle", "time": 16374.149, "timestamp": "04:32:54", "text": "他们说：“是啊，这个人真的很……”"}, {"type": "subtitle", "time": 16377.11, "timestamp": "04:32:57", "text": "粗鲁无礼，非常不礼貌，而且真的"}]
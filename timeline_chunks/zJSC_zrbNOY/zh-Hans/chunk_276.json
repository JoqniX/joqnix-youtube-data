[{"type": "subtitle", "time": 16561.109, "timestamp": "04:36:01", "text": "随着时间的推移，你会得到保护，你知道该怎么做。"}, {"type": "subtitle", "time": 16565.429, "timestamp": "04:36:05", "text": "应该做什么，不应该做什么等等。不。是的。"}, {"type": "subtitle", "time": 16568.47, "timestamp": "04:36:08", "text": "露丝说，我看起来像……"}, {"type": "subtitle", "time": 16571.029, "timestamp": "04:36:11", "text": "治疗师？"}, {"type": "subtitle", "time": 16573.75, "timestamp": "04:36:13", "text": "我甚至不能说我是R。"}, {"type": "subtitle", "time": 16575.51, "timestamp": "04:36:15", "text": "治疗师。"}, {"type": "subtitle", "time": 16577.029, "timestamp": "04:36:17", "text": "你是"}, {"type": "subtitle", "time": 16580.15, "timestamp": "04:36:20", "text": "是的。我的天啊。"}, {"type": "subtitle", "time": 16584.31, "timestamp": "04:36:24", "text": "我的天啊。哇。该死。"}, {"type": "subtitle", "time": 16586.31, "timestamp": "04:36:26", "text": "不过，话说回来，我也确实有一个"}, {"type": "subtitle", "time": 16589.269, "timestamp": "04:36:29", "text": "我不会参与的政策"}, {"type": "subtitle", "time": 16592.709, "timestamp": "04:36:32", "text": "在那种会议或谈话中"}, {"type": "subtitle", "time": 16596.949, "timestamp": "04:36:36", "text": "直播对我来说就像是一种疗愈。"}, {"type": "subtitle", "time": 16599.99, "timestamp": "04:36:39", "text": "就像……它需要某种类型的……"}, {"type": "subtitle", "time": 16602.789, "timestamp": "04:36:42", "text": "需要妥善处理的空间。我做不到"}, {"type": "subtitle", "time": 16605.269, "timestamp": "04:36:45", "text": "直播。"}, {"type": "subtitle", "time": 16607.349, "timestamp": "04:36:47", "text": "它不会是一个安全的地方"}, {"type": "subtitle", "time": 16610.23, "timestamp": "04:36:50", "text": "对我个人而言也是如此。是的，那里"}, {"type": "subtitle", "time": 16614.07, "timestamp": "04:36:54", "text": "这位创作者就是做这件事的那个人。呃"}, {"type": "subtitle", "time": 16615.75, "timestamp": "04:36:55", "text": "喜欢"}, {"type": "subtitle", "time": 16618.47, "timestamp": "04:36:58", "text": "好的，请便。是的，有点像"}]
[{"type": "subtitle", "time": 22081.35, "timestamp": "06:08:01", "text": "我不知道还可以在网上订餐。我"}, {"type": "subtitle", "time": 22084.39, "timestamp": "06:08:04", "text": "这让我很意外。"}, {"type": "subtitle", "time": 22087.91, "timestamp": "06:08:07", "text": "食物种类繁多。"}, {"type": "subtitle", "time": 22092.39, "timestamp": "06:08:12", "text": "您可以在线订购。我当时就懵了？你"}, {"type": "subtitle", "time": 22094.39, "timestamp": "06:08:14", "text": "可以买披萨之类的东西。你没有"}, {"type": "subtitle", "time": 22098.39, "timestamp": "06:08:18", "text": "我以前从来没吃过披萨。但"}, {"type": "subtitle", "time": 22101.27, "timestamp": "06:08:21", "text": "第一次，我……嗯……喜欢"}, {"type": "subtitle", "time": 22103.75, "timestamp": "06:08:23", "text": "是家人订的。我就是这样到达那里的。"}, {"type": "subtitle", "time": 22107.11, "timestamp": "06:08:27", "text": "试试看。我当时就想，“哇，这种类型"}, {"type": "subtitle", "time": 22109.75, "timestamp": "06:08:29", "text": "事情就像电影里演的那样，"}, {"type": "subtitle", "time": 22113.35, "timestamp": "06:08:33", "text": "互联网就像披萨一样。"}, {"type": "subtitle", "time": 22116.15, "timestamp": "06:08:36", "text": "我的意思是，在我成长的过程中，我大部分时间都……"}, {"type": "subtitle", "time": 22119.43, "timestamp": "06:08:39", "text": "像我大多数人一样喜欢家常菜"}, {"type": "subtitle", "time": 22121.83, "timestamp": "06:08:41", "text": "嗯，我从小就吃自家种的食物。"}, {"type": "subtitle", "time": 22124.788, "timestamp": "06:08:44", "text": "嗯。就像你在外面一样，这更像是最近的事。"}, {"type": "subtitle", "time": 22127.91, "timestamp": "06:08:47", "text": "食物摄入量增加。不过，是的，我有点"}, {"type": "subtitle", "time": 22130.708, "timestamp": "06:08:50", "text": "把很多精力放在……"}, {"type": "subtitle", "time": 22132.15, "timestamp": "06:08:52", "text": "大学那边的事，因为我们没有"}, {"type": "subtitle", "time": 22136.23, "timestamp": "06:08:56", "text": "有足够的时间……我的意思是，即使我"}, {"type": "subtitle", "time": 22138.708, "timestamp": "06:08:58", "text": "做个午餐，有时候呃，讲座"}]
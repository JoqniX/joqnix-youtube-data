[{"type": "subtitle", "time": 21301.11, "timestamp": "05:55:01", "text": "这就是原因，呃，我仍然"}, {"type": "subtitle", "time": 21303.51, "timestamp": "05:55:03", "text": "还没开始做2D动画之类的。"}, {"type": "subtitle", "time": 21308.39, "timestamp": "05:55:08", "text": "模型也是一种艺术，因为我知道你"}, {"type": "subtitle", "time": 21312.47, "timestamp": "05:55:12", "text": "需要做很多分层处理。"}, {"type": "subtitle", "time": 21314.23, "timestamp": "05:55:14", "text": "因为一切都必须不同"}, {"type": "subtitle", "time": 21316.948, "timestamp": "05:55:16", "text": "分层，嗯，你得把它放进去。"}, {"type": "subtitle", "time": 21318.628, "timestamp": "05:55:18", "text": "文件夹和其他所有东西。而我只是"}, {"type": "subtitle", "time": 21321.83, "timestamp": "05:55:21", "text": "让我先弄明白我能做什么"}, {"type": "subtitle", "time": 21326.23, "timestamp": "05:55:26", "text": "就像迈婴儿的步伐一样。"}, {"type": "subtitle", "time": 21329.19, "timestamp": "05:55:29", "text": "嗯。因为我制作表情包的方式就像……"}, {"type": "subtitle", "time": 21331.91, "timestamp": "05:55:31", "text": "我觉得两三层就差不多了"}, {"type": "subtitle", "time": 21335.43, "timestamp": "05:55:35", "text": "一切都在那里完成。"}, {"type": "subtitle", "time": 21337.11, "timestamp": "05:55:37", "text": "仍然"}, {"type": "subtitle", "time": 21338.628, "timestamp": "05:55:38", "text": "因为"}, {"type": "subtitle", "time": 21340.788, "timestamp": "05:55:40", "text": "就像层数太多了一样。"}, {"type": "subtitle", "time": 21343.91, "timestamp": "05:55:43", "text": "东西。我买了绘图板，然后"}, {"type": "subtitle", "time": 21345.83, "timestamp": "05:55:45", "text": "我渐渐意识到我一直在使用"}, {"type": "subtitle", "time": 21348.868, "timestamp": "05:55:48", "text": "我经常用手机画画。所以当时"}, {"type": "subtitle", "time": 21351.51, "timestamp": "05:55:51", "text": "以前，你知道，能看到我的一切"}, {"type": "subtitle", "time": 21354.708, "timestamp": "05:55:54", "text": "屏幕上会显示我的操作步骤。"}, {"type": "subtitle", "time": 21356.788, "timestamp": "05:55:56", "text": "药片。我不得不……我还在努力获取"}]
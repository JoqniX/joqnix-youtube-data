[{"type": "subtitle", "time": 13440.309, "timestamp": "03:44:00", "text": "为希望使用多台直播机的玩家提供的工具"}, {"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "像商品聊天室这样的多房间模式"}, {"type": "subtitle", "time": 13445.99, "timestamp": "03:44:05", "text": "一切都好。所以他过去常常宣传"}, {"type": "subtitle", "time": 13449.75, "timestamp": "03:44:09", "text": "那些东西等等。现在很多都是因为"}, {"type": "subtitle", "time": 13451.59, "timestamp": "03:44:11", "text": "大多数人，尤其是那些比较知名的主播，都像这样"}, {"type": "subtitle", "time": 13454.15, "timestamp": "03:44:14", "text": "移动踢球等等。现在他"}, {"type": "subtitle", "time": 13457.91, "timestamp": "03:44:17", "text": "他昨天好像被禁言了"}, {"type": "subtitle", "time": 13461.59, "timestamp": "03:44:21", "text": "最近。所以是因为它是"}, {"type": "subtitle", "time": 13464.309, "timestamp": "03:44:24", "text": "因为当时有个类似抖音（TikTok）的东西"}, {"type": "subtitle", "time": 13467.75, "timestamp": "03:44:27", "text": "捐款或直播中的其他提醒"}, {"type": "subtitle", "time": 13471.189, "timestamp": "03:44:31", "text": "然后，嗯，Twitch 就说，是的，你得到了"}, {"type": "subtitle", "time": 13475.269, "timestamp": "03:44:35", "text": "因模拟施法而被禁"}, {"type": "subtitle", "time": 13477.75, "timestamp": "03:44:37", "text": "就像打破小数铸造规则一样。"}, {"type": "subtitle", "time": 13480.63, "timestamp": "03:44:40", "text": "所以你不应该"}, {"type": "subtitle", "time": 13484.469, "timestamp": "03:44:44", "text": "展示或回应捐赠或其他任何事项"}, {"type": "subtitle", "time": 13488.15, "timestamp": "03:44:48", "text": "来自其他平台的某种警报"}, {"type": "subtitle", "time": 13491.03, "timestamp": "03:44:51", "text": "东西。所以，外部第三方的东西，"}, {"type": "subtitle", "time": 13493.59, "timestamp": "03:44:53", "text": "正确的？就像TikTok或者Streamlabs那样。"}, {"type": "subtitle", "time": 13497.83, "timestamp": "03:44:57", "text": "或者 Stream Elements 以及所有这些东西"}]
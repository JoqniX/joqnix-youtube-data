[{"type": "subtitle", "time": 18902.15, "timestamp": "05:15:02", "text": "或者每次我打开 OBS 时，它都显示 100%"}, {"type": "subtitle", "time": 18905.11, "timestamp": "05:15:05", "text": "即使没有流媒体播放，CPU 占用率也会因此而降低。"}, {"type": "subtitle", "time": 18907.67, "timestamp": "05:15:07", "text": "我有很多东西。所以我不得不喜欢"}, {"type": "subtitle", "time": 18910.55, "timestamp": "05:15:10", "text": "剥离、移除和清除大量"}, {"type": "subtitle", "time": 18912.868, "timestamp": "05:15:12", "text": "事物。我做了"}, {"type": "subtitle", "time": 18914.708, "timestamp": "05:15:14", "text": "很久以前，那里有一个水道点"}, {"type": "subtitle", "time": 18918.708, "timestamp": "05:15:18", "text": "人们可以在哪里关掉我的电脑。"}, {"type": "subtitle", "time": 18920.628, "timestamp": "05:15:20", "text": "哦"}, {"type": "subtitle", "time": 18924.31, "timestamp": "05:15:24", "text": "是啊，就像，而且它会……嗯，就像"}, {"type": "subtitle", "time": 18927.11, "timestamp": "05:15:27", "text": "人们觉得它超级棒"}, {"type": "subtitle", "time": 18929.11, "timestamp": "05:15:29", "text": "成本"}, {"type": "subtitle", "time": 18932.47, "timestamp": "05:15:32", "text": "它将带来一种新型的"}, {"type": "subtitle", "time": 18936.708, "timestamp": "05:15:36", "text": "类似倒计时的提示信息。呃，所以……"}, {"type": "subtitle", "time": 18939.03, "timestamp": "05:15:39", "text": "如果我必须保存什么东西，我就必须"}, {"type": "subtitle", "time": 18942.31, "timestamp": "05:15:42", "text": "在倒计时结束前保存它"}, {"type": "subtitle", "time": 18945.59, "timestamp": "05:15:45", "text": "零点之后，它将关闭，然后……"}, {"type": "subtitle", "time": 18948.708, "timestamp": "05:15:48", "text": "有时它会自动重启"}, {"type": "subtitle", "time": 18951.67, "timestamp": "05:15:51", "text": "再次启动并运行明显程序"}, {"type": "subtitle", "time": 18953.59, "timestamp": "05:15:53", "text": "一切都自动进行，就像开始一样"}, {"type": "subtitle", "time": 18956.708, "timestamp": "05:15:56", "text": "小溪又响了，他能听到我的声音。"}, {"type": "subtitle", "time": 18958.23, "timestamp": "05:15:58", "text": "失望的。"}]
[{"type": "subtitle", "time": 19682.628, "timestamp": "05:28:02", "text": "商业一。它就在那里。这样可以吗？"}, {"type": "subtitle", "time": 19687.11, "timestamp": "05:28:07", "text": "现在还是和以前一样吗？是呃……"}, {"type": "subtitle", "time": 19689.19, "timestamp": "05:28:09", "text": "比如，它不显示您的地址吗？"}, {"type": "subtitle", "time": 19691.27, "timestamp": "05:28:11", "text": "现在是什么？我的地址已不再是这里了"}, {"type": "subtitle", "time": 19692.548, "timestamp": "05:28:12", "text": "一切。就像展示我的"}, {"type": "subtitle", "time": 19695.75, "timestamp": "05:28:15", "text": "名字和一些其他信息。所以，没关系。美好的。哦，"}, {"type": "subtitle", "time": 19697.51, "timestamp": "05:28:17", "text": "那很好。"}, {"type": "subtitle", "time": 19699.99, "timestamp": "05:28:19", "text": "是的。我想，第二好的方法就是"}, {"type": "subtitle", "time": 19702.07, "timestamp": "05:28:22", "text": "变得就像，你可以直接去"}, {"type": "subtitle", "time": 19706.31, "timestamp": "05:28:26", "text": "喝杯咖啡，然后去那里。"}, {"type": "subtitle", "time": 19709.35, "timestamp": "05:28:29", "text": "但是等等，嗯，我在做这件事的时候注意到了什么"}, {"type": "subtitle", "time": 19712.788, "timestamp": "05:28:32", "text": "Joathon 现在面向印度公民开放，PayPal"}, {"type": "subtitle", "time": 19715.43, "timestamp": "05:28:35", "text": "不适用于本地交易"}, {"type": "subtitle", "time": 19719.35, "timestamp": "05:28:39", "text": "东西。然后我注意到有些人"}, {"type": "subtitle", "time": 19724.15, "timestamp": "05:28:44", "text": "无法通过 Kofi 咖啡完成，因为它"}, {"type": "subtitle", "time": 19727.03, "timestamp": "05:28:47", "text": "就像……呃……显示错误一样"}, {"type": "subtitle", "time": 19729.03, "timestamp": "05:28:49", "text": "我们在印度没有服务。"}, {"type": "subtitle", "time": 19731.67, "timestamp": "05:28:51", "text": "当他们试图做某事时，发生了一些事情"}, {"type": "subtitle", "time": 19734.23, "timestamp": "05:28:54", "text": "付款或其他什么的。我不知道为什么"}, {"type": "subtitle", "time": 19737.35, "timestamp": "05:28:57", "text": "之所以发生那样的事，是因为我以为哦，科菲是"}, {"type": "subtitle", "time": 19739.91, "timestamp": "05:28:59", "text": "就像我可以使用的替代方案，但是不行。"}]
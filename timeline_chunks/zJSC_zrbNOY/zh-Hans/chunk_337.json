[{"type": "subtitle", "time": 20222.07, "timestamp": "05:37:02", "text": "我当时的感觉就像……"}, {"type": "subtitle", "time": 20227.11, "timestamp": "05:37:07", "text": "忘了这件事吧，当这个……"}, {"type": "subtitle", "time": 20228.788, "timestamp": "05:37:08", "text": "印度和巴基斯坦之间发生了一些事情，"}, {"type": "subtitle", "time": 20231.19, "timestamp": "05:37:11", "text": "所有事情都改期到四月份了。"}, {"type": "subtitle", "time": 20235.91, "timestamp": "05:37:15", "text": "我当时的想法是，嗯。所以"}, {"type": "subtitle", "time": 20238.548, "timestamp": "05:37:18", "text": "呃，是的，他们现在也在Twitch上。"}, {"type": "subtitle", "time": 20242.15, "timestamp": "05:37:22", "text": "无法像我认为的那样验证我的身份"}, {"type": "subtitle", "time": 20244.708, "timestamp": "05:37:24", "text": "附属机构呃，那部分事情发生了，对吧？"}, {"type": "subtitle", "time": 20248.948, "timestamp": "05:37:28", "text": "那里。你得重做一遍。哦"}, {"type": "subtitle", "time": 20251.59, "timestamp": "05:37:31", "text": "是的。所以我不得不重做一遍。"}, {"type": "subtitle", "time": 20255.75, "timestamp": "05:37:35", "text": "出于某种奇怪的原因，嗯，他们可以……"}, {"type": "subtitle", "time": 20258.628, "timestamp": "05:37:38", "text": "不知道为什么我的验证没有通过"}, {"type": "subtitle", "time": 20260.39, "timestamp": "05:37:40", "text": "把文件放在脸上或其他什么地方。"}, {"type": "subtitle", "time": 20264.23, "timestamp": "05:37:44", "text": "我心想，为什么我会变成这样？我变了。"}, {"type": "subtitle", "time": 20266.868, "timestamp": "05:37:46", "text": "那么多？这只是一张旧照片"}, {"type": "subtitle", "time": 20270.47, "timestamp": "05:37:50", "text": "我的另一辆车。为什么？是的，我"}, {"type": "subtitle", "time": 20272.39, "timestamp": "05:37:52", "text": "无法核实。所以，我"}, {"type": "subtitle", "time": 20275.11, "timestamp": "05:37:55", "text": "无法更改，我想那里有一个"}, {"type": "subtitle", "time": 20276.948, "timestamp": "05:37:56", "text": "是支付款项那一套吧？就像他们"}, {"type": "subtitle", "time": 20279.03, "timestamp": "05:37:59", "text": "赚了50美元。"}]
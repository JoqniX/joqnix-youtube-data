[{"type": "subtitle", "time": 14345.83, "timestamp": "03:59:05", "text": "我通常会把所有事情都自动化，所以我"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "不用担心。请给我评分，"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "它过一会儿就会自动喊叫。"}, {"type": "subtitle", "time": 14354.229, "timestamp": "03:59:14", "text": "秒。我或许应该那样做。"}, {"type": "subtitle", "time": 14359.349, "timestamp": "03:59:19", "text": "因为太忙乱了。不，你会是"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "惊慌失措。哦，我忘了做这件事。哦"}, {"type": "subtitle", "time": 14363.67, "timestamp": "03:59:23", "text": "不，是这个那个。"}, {"type": "subtitle", "time": 14365.189, "timestamp": "03:59:25", "text": "我知道。而事情通常是这样的"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "当像我认识的某个人那样，把我所有东西都搜刮一空的时候"}, {"type": "subtitle", "time": 14369.75, "timestamp": "03:59:29", "text": "我再次看到这些话就激动不已。"}, {"type": "subtitle", "time": 14373.349, "timestamp": "03:59:33", "text": "他们。我好像忘了自己还要……"}, {"type": "subtitle", "time": 14375.75, "timestamp": "03:59:35", "text": "我的意思是大声喊出来，然后那样做。好的。露娜"}, {"type": "subtitle", "time": 14381.429, "timestamp": "03:59:41", "text": "还要求给朋友炸火。"}, {"type": "subtitle", "time": 14384.389, "timestamp": "03:59:44", "text": "你叫什么名字？啊，你可以"}, {"type": "subtitle", "time": 14387.99, "timestamp": "03:59:47", "text": "叫我的名字可以发音为乔克"}, {"type": "subtitle", "time": 14391.91, "timestamp": "03:59:51", "text": "下一个。所以你可以叫我运动健将。是的，伙计。"}, {"type": "subtitle", "time": 14393.429, "timestamp": "03:59:53", "text": "下一个。"}, {"type": "subtitle", "time": 14397.03, "timestamp": "03:59:57", "text": "就像两件事，两个词。哦，还有"}]
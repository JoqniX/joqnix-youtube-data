[{"type": "subtitle", "time": 13620.79, "timestamp": "03:47:00", "text": "不同人对颜色的权利可能有所不同。"}, {"type": "subtitle", "time": 13624.389, "timestamp": "03:47:04", "text": "不同的颜色聊天颜色对吧"}, {"type": "subtitle", "time": 13627.83, "timestamp": "03:47:07", "text": "对我来说，我把红色代表Twitch，而不是红色"}, {"type": "subtitle", "time": 13630.95, "timestamp": "03:47:10", "text": "YouTube 为紫色，Twitch 为绿色"}, {"type": "subtitle", "time": 13633.59, "timestamp": "03:47:13", "text": "踢，蓝色表示可信。"}, {"type": "subtitle", "time": 13636.87, "timestamp": "03:47:16", "text": "哦，是的。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "他们不会，他们不会注意到。我感觉"}, {"type": "subtitle", "time": 13641.59, "timestamp": "03:47:21", "text": "希望如此"}, {"type": "subtitle", "time": 13646.15, "timestamp": "03:47:26", "text": "我的意思是，但愿如此。是的。"}, {"type": "subtitle", "time": 13648.71, "timestamp": "03:47:28", "text": "因为我觉得 Twitch 有时可能会"}, {"type": "subtitle", "time": 13652.309, "timestamp": "03:47:32", "text": "对嗯真的毫不留情"}, {"type": "subtitle", "time": 13657.99, "timestamp": "03:47:37", "text": "YouTube 用户。嗯，是的，他们说得对。"}, {"type": "subtitle", "time": 13661.75, "timestamp": "03:47:41", "text": "我想我回来了。是去年的吗？"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "去年最后一次。那个热水浴缸和"}, {"type": "subtitle", "time": 13668.469, "timestamp": "03:47:48", "text": "着装指南"}, {"type": "subtitle", "time": 13673.189, "timestamp": "03:47:53", "text": "一切。我的天啊。我知道。"}]
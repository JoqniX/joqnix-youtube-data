[{"type": "subtitle", "time": 21420.548, "timestamp": "05:57:00", "text": "不用担心。"}, {"type": "subtitle", "time": 21422.39, "timestamp": "05:57:02", "text": "我的意思是，如果你……是的，但如果你确实……"}, {"type": "subtitle", "time": 21424.39, "timestamp": "05:57:04", "text": "就像你想休息一下，或者像"}, {"type": "subtitle", "time": 21427.19, "timestamp": "05:57:07", "text": "请打电话告诉我结果。你好。你好。"}, {"type": "subtitle", "time": 21429.35, "timestamp": "05:57:09", "text": "好的。"}, {"type": "subtitle", "time": 21433.03, "timestamp": "05:57:13", "text": "是的。一切都好。我们谈了很多，我们"}, {"type": "subtitle", "time": 21435.51, "timestamp": "05:57:15", "text": "学到了很多东西。挺好的。它不"}, {"type": "subtitle", "time": 21437.35, "timestamp": "05:57:17", "text": "感觉就像是第一次一样"}, {"type": "subtitle", "time": 21439.43, "timestamp": "05:57:19", "text": "某物。我不知道。我知道。我是"}, {"type": "subtitle", "time": 21442.628, "timestamp": "05:57:22", "text": "我也很惊讶，因为我当时想的是……"}, {"type": "subtitle", "time": 21445.19, "timestamp": "05:57:25", "text": "出发前我有点紧张。"}, {"type": "subtitle", "time": 21447.75, "timestamp": "05:57:27", "text": "通话中。我当时正在设置 OBS"}, {"type": "subtitle", "time": 21449.43, "timestamp": "05:57:29", "text": "一切都结束了，我当时正要开始"}, {"type": "subtitle", "time": 21450.788, "timestamp": "05:57:30", "text": "偶尔会有点紧张"}, {"type": "subtitle", "time": 21453.11, "timestamp": "05:57:33", "text": "比如，“好吧，如果我做点什么呢？”"}, {"type": "subtitle", "time": 21455.03, "timestamp": "05:57:35", "text": "如果我说了一些奇怪的话怎么办？我不"}, {"type": "subtitle", "time": 21462.708, "timestamp": "05:57:42", "text": "没关系。我不知道。就像我一样"}, {"type": "subtitle", "time": 21466.07, "timestamp": "05:57:46", "text": "像往常一样感到惊讶"}, {"type": "subtitle", "time": 21468.548, "timestamp": "05:57:48", "text": "非常害怕合作或"}, {"type": "subtitle", "time": 21473.03, "timestamp": "05:57:53", "text": "2019年的时候和像他这样的人聊过天"}, {"type": "subtitle", "time": 21475.75, "timestamp": "05:57:55", "text": "2020 年或 2020 年之前是的。"}]
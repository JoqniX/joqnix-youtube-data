[{"type": "subtitle", "time": 17160.708, "timestamp": "04:46:00", "text": "重的。天。然后我切换到“我发现”"}, {"type": "subtitle", "time": 17164.708, "timestamp": "04:46:04", "text": "耳朵里仿佛被宇宙之咬了一口"}, {"type": "subtitle", "time": 17167.35, "timestamp": "04:46:07", "text": "现在这里耳机就像普通耳机一样，但是"}, {"type": "subtitle", "time": 17169.67, "timestamp": "04:46:09", "text": "例如使用延长麦克风或"}, {"type": "subtitle", "time": 17172.47, "timestamp": "04:46:12", "text": "虽然我用的是某种东西，但我"}, {"type": "subtitle", "time": 17174.948, "timestamp": "04:46:14", "text": "不要仅仅为了“我”而使用麦克风。"}, {"type": "subtitle", "time": 17179.03, "timestamp": "04:46:19", "text": "就像这样使用耳塞耳机就行了"}, {"type": "subtitle", "time": 17182.15, "timestamp": "04:46:22", "text": "那。是的。然后我意识到还有这个"}, {"type": "subtitle", "time": 17185.91, "timestamp": "04:46:25", "text": "好像叫IBM或者IM之类的，"}, {"type": "subtitle", "time": 17190.47, "timestamp": "04:46:30", "text": "正确的？那种耳机，就像……"}, {"type": "subtitle", "time": 17192.788, "timestamp": "04:46:32", "text": "用耳模或其他什么东西做成的。你可以"}, {"type": "subtitle", "time": 17195.59, "timestamp": "04:46:35", "text": "定制一个之类的。我不"}, {"type": "subtitle", "time": 17197.83, "timestamp": "04:46:37", "text": "知道它叫什么吗？是的，我没有"}, {"type": "subtitle", "time": 17198.948, "timestamp": "04:46:38", "text": "是啊，我不知道它叫什么，但是"}, {"type": "subtitle", "time": 17202.15, "timestamp": "04:46:42", "text": "我知道你话里的意思。"}, {"type": "subtitle", "time": 17205.03, "timestamp": "04:46:45", "text": "我好像看过一段视频之类的。"}, {"type": "subtitle", "time": 17208.39, "timestamp": "04:46:48", "text": "是啊，太酷了。像好的一样好"}, {"type": "subtitle", "time": 17211.99, "timestamp": "04:46:51", "text": "音质等等一切都太棒了！"}, {"type": "subtitle", "time": 17215.03, "timestamp": "04:46:55", "text": "我知道，我想，是的，我想我一直都保持着"}, {"type": "subtitle", "time": 17218.31, "timestamp": "04:46:58", "text": "呃，我的麦克风和耳机的情况"}]
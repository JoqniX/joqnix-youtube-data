[{"type": "subtitle", "time": 21003.51, "timestamp": "05:50:03", "text": "事物。嗯。学习曲线。学习"}, {"type": "subtitle", "time": 21007.75, "timestamp": "05:50:07", "text": "曲线。是的，我仍然会参加。嗯，我呃"}, {"type": "subtitle", "time": 21010.07, "timestamp": "05:50:10", "text": "呃，我还是会去，因为我不"}, {"type": "subtitle", "time": 21012.628, "timestamp": "05:50:12", "text": "从一份工作中获得很多好处，即使工作量不大。"}, {"type": "subtitle", "time": 21014.948, "timestamp": "05:50:14", "text": "兼职之类的。所以，我确实喜欢科技。"}, {"type": "subtitle", "time": 21016.948, "timestamp": "05:50:16", "text": "支持像其他主播一样"}, {"type": "subtitle", "time": 21020.31, "timestamp": "05:50:20", "text": "一切。所以我做这个观测能拿到报酬。"}, {"type": "subtitle", "time": 21023.51, "timestamp": "05:50:23", "text": "以及所有的一切。所以，我通常就是这样。"}, {"type": "subtitle", "time": 21027.19, "timestamp": "05:50:27", "text": "我免费做这件事是因为我……"}, {"type": "subtitle", "time": 21029.51, "timestamp": "05:50:29", "text": "想帮助别人，因为你知道"}, {"type": "subtitle", "time": 21032.15, "timestamp": "05:50:32", "text": "很多技术方面的东西都令人沮丧。"}, {"type": "subtitle", "time": 21035.67, "timestamp": "05:50:35", "text": "现在，即使你问一些人……"}, {"type": "subtitle", "time": 21037.99, "timestamp": "05:50:37", "text": "Discord 服务器或支持服务器"}, {"type": "subtitle", "time": 21040.47, "timestamp": "05:50:40", "text": "人们可能会对你无礼，因为"}, {"type": "subtitle", "time": 21042.708, "timestamp": "05:50:42", "text": "你是印度人还是什么人，或者其他什么人"}, {"type": "subtitle", "time": 21045.11, "timestamp": "05:50:45", "text": "我现在面临的这些问题很多"}, {"type": "subtitle", "time": 21047.51, "timestamp": "05:50:47", "text": "事物。所以我就想，你知道吗，我会……"}, {"type": "subtitle", "time": 21050.788, "timestamp": "05:50:50", "text": "教你吧，因为我明白了很多。"}, {"type": "subtitle", "time": 21053.27, "timestamp": "05:50:53", "text": "根据我的经验，我理解了"}, {"type": "subtitle", "time": 21055.11, "timestamp": "05:50:55", "text": "就像显而易见的工作方式一样，很多都很好。"}, {"type": "subtitle", "time": 21057.27, "timestamp": "05:50:57", "text": "我会教你一切，以及所有的一切"}]
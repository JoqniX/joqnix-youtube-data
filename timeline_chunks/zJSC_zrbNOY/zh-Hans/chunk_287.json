[{"type": "subtitle", "time": 17220.55, "timestamp": "04:47:00", "text": "情况如同优先事项，需要更新"}, {"type": "subtitle", "time": 17221.57, "timestamp": "04:47:01", "text": "下一个"}, {"type": "subtitle", "time": 17222.868, "timestamp": "04:47:02", "text": "[音乐]"}, {"type": "subtitle", "time": 17226.15, "timestamp": "04:47:06", "text": "因为之后我确实想更新一下。"}, {"type": "subtitle", "time": 17230.23, "timestamp": "04:47:10", "text": "把笔记本电脑连接到台式机，这样我就可以玩游戏了"}, {"type": "subtitle", "time": 17233.03, "timestamp": "04:47:13", "text": "更重的游戏"}, {"type": "subtitle", "time": 17235.03, "timestamp": "04:47:15", "text": "目前我无法折磨我的"}, {"type": "subtitle", "time": 17237.51, "timestamp": "04:47:17", "text": "我用笔记本电脑……嗯，我确实会虐待我的笔记本电脑"}, {"type": "subtitle", "time": 17239.51, "timestamp": "04:47:19", "text": "很多。就像我确实会挑战极限一样"}, {"type": "subtitle", "time": 17244.628, "timestamp": "04:47:24", "text": "有时候会，但我尽量避免。"}, {"type": "subtitle", "time": 17246.23, "timestamp": "04:47:26", "text": "是的，"}, {"type": "subtitle", "time": 17247.91, "timestamp": "04:47:27", "text": "我真的很想做一个模型。我是说，"}, {"type": "subtitle", "time": 17250.15, "timestamp": "04:47:30", "text": "就像有一天也能做成二维模型一样，但是"}, {"type": "subtitle", "time": 17253.19, "timestamp": "04:47:33", "text": "更像是……"}, {"type": "subtitle", "time": 17256.47, "timestamp": "04:47:36", "text": "我可能会买很多东西。"}, {"type": "subtitle", "time": 17258.39, "timestamp": "04:47:38", "text": "我知道这就像很多事情一样"}, {"type": "subtitle", "time": 17262.31, "timestamp": "04:47:42", "text": "投资也是如此。嗯。"}, {"type": "subtitle", "time": 17264.788, "timestamp": "04:47:44", "text": "就像你必须把你的艺术作品分开一样"}, {"type": "subtitle", "time": 17267.83, "timestamp": "04:47:47", "text": "很多。这样你才能正确地进行装配，"}, {"type": "subtitle", "time": 17271.11, "timestamp": "04:47:51", "text": "正确的？我知道。这就是目前的情况。"}, {"type": "subtitle", "time": 17274.23, "timestamp": "04:47:54", "text": "试图学习，比如，我们如何才能打破"}, {"type": "subtitle", "time": 17276.868, "timestamp": "04:47:56", "text": "因为我一直在使用我的PNG文件。我"}]
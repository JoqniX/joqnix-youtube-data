[{"type": "subtitle", "time": 21722.15, "timestamp": "06:02:02", "text": "就像交易协作一样"}, {"type": "subtitle", "time": 21724.788, "timestamp": "06:02:04", "text": "担心能源问题，就像……"}, {"type": "subtitle", "time": 21726.31, "timestamp": "06:02:06", "text": "观众席上的一切，你有很多东西"}, {"type": "subtitle", "time": 21731.03, "timestamp": "06:02:11", "text": "你知道，得担心，是啊，所以……"}, {"type": "subtitle", "time": 21734.788, "timestamp": "06:02:14", "text": "我当时就想，我要邀请所有人！"}, {"type": "subtitle", "time": 21737.91, "timestamp": "06:02:17", "text": "我交谈过的人，以及那些……"}, {"type": "subtitle", "time": 21740.07, "timestamp": "06:02:20", "text": "在我的视频拍摄过程中，它一直帮助着我。"}, {"type": "subtitle", "time": 21742.708, "timestamp": "06:02:22", "text": "自从我开始直播以来，就是这样"}, {"type": "subtitle", "time": 21746.548, "timestamp": "06:02:26", "text": "感觉就像过了将近6年，比如2020年。"}, {"type": "subtitle", "time": 21749.75, "timestamp": "06:02:29", "text": "我于9月23日开始工作。我"}, {"type": "subtitle", "time": 21752.708, "timestamp": "06:02:32", "text": "别开玩笑了，我从未首发过。即使我"}, {"type": "subtitle", "time": 21755.11, "timestamp": "06:02:35", "text": "已经直播了六六年或五年了"}, {"type": "subtitle", "time": 21757.67, "timestamp": "06:02:37", "text": "多年来，我从未正式推出过它。但我呃"}, {"type": "subtitle", "time": 21761.27, "timestamp": "06:02:41", "text": "还记得我更改标题的那天吗？"}, {"type": "subtitle", "time": 21763.59, "timestamp": "06:02:43", "text": "喜欢有抱负的 YouTuber。就是这样。"}, {"type": "subtitle", "time": 21766.15, "timestamp": "06:02:46", "text": "我把我的周年纪念日日期定为"}, {"type": "subtitle", "time": 21769.99, "timestamp": "06:02:49", "text": "2020年9月23日等等。所以当时"}, {"type": "subtitle", "time": 21772.31, "timestamp": "06:02:52", "text": "是的，我通过这种方式认识的每个人"}, {"type": "subtitle", "time": 21775.59, "timestamp": "06:02:55", "text": "上帝推特Instagram上所有地方谁"}, {"type": "subtitle", "time": 21778.15, "timestamp": "06:02:58", "text": "他们帮了我很多，和我聊过天，他们人很好。"}]
[{"type": "subtitle", "time": 16261.51, "timestamp": "04:31:01", "text": "YouTuber们是如何建立起他们的社群的"}, {"type": "subtitle", "time": 16264.87, "timestamp": "04:31:04", "text": "服务器，它们都搬走了，而且都移走了。"}, {"type": "subtitle", "time": 16267.269, "timestamp": "04:31:07", "text": "那段时间我经常在风险投资公司工作。所以就是这样。"}, {"type": "subtitle", "time": 16270.95, "timestamp": "04:31:10", "text": "就像一些随机的、比较新的人一样"}, {"type": "subtitle", "time": 16274.229, "timestamp": "04:31:14", "text": "来自 YouTube 或 Twitch 的 Discord"}, {"type": "subtitle", "time": 16276.389, "timestamp": "04:31:16", "text": "我之前有过一次不太愉快的经历，他们……"}, {"type": "subtitle", "time": 16280.149, "timestamp": "04:31:20", "text": "我觉得他们是新来的。"}, {"type": "subtitle", "time": 16283.59, "timestamp": "04:31:23", "text": "开始倾诉创伤之类的，然后我"}, {"type": "subtitle", "time": 16286.149, "timestamp": "04:31:26", "text": "不知道这是什么创伤倾倒"}, {"type": "subtitle", "time": 16290.55, "timestamp": "04:31:30", "text": "还有其他一些事，然后我就觉得很糟糕。"}, {"type": "subtitle", "time": 16293.91, "timestamp": "04:31:33", "text": "我通过私信和他们聊了聊，他们就开始了。"}, {"type": "subtitle", "time": 16295.429, "timestamp": "04:31:35", "text": "到"}, {"type": "subtitle", "time": 16298.389, "timestamp": "04:31:38", "text": "呃，怎么说呢，怎么说呢，他们开始……"}, {"type": "subtitle", "time": 16300.55, "timestamp": "04:31:40", "text": "我当时就像在听一样。我从未评判过别人。"}, {"type": "subtitle", "time": 16302.229, "timestamp": "04:31:42", "text": "任何事物。我在听。他们是"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "弯曲。我当时建议说：“是啊，"}, {"type": "subtitle", "time": 16307.67, "timestamp": "04:31:47", "text": "是的，你可以做到。或许会"}, {"type": "subtitle", "time": 16310.95, "timestamp": "04:31:50", "text": "好好照顾自己。”他们得到了一些"}, {"type": "subtitle", "time": 16313.03, "timestamp": "04:31:53", "text": "比如戏剧或其他什么"}, {"type": "subtitle", "time": 16316.389, "timestamp": "04:31:56", "text": "创作者们都说这个人"}, {"type": "subtitle", "time": 16318.55, "timestamp": "04:31:58", "text": "他们都说这个人是"}]
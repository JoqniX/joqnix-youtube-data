[{"type": "subtitle", "time": 360.79, "timestamp": "00:06:00", "text": "我觉得我唱了一小段歌，但我并不"}, {"type": "subtitle", "time": 363.83, "timestamp": "00:06:03", "text": "知道。但我会进步的。"}, {"type": "subtitle", "time": 365.99, "timestamp": "00:06:05", "text": "但最重要的是，我当时"}, {"type": "subtitle", "time": 369.83, "timestamp": "00:06:09", "text": "能唱这首歌，但是"}, {"type": "subtitle", "time": 374.07, "timestamp": "00:06:14", "text": "比如犯了太多错误。这首很长的歌。"}, {"type": "subtitle", "time": 376.79, "timestamp": "00:06:16", "text": "那真是令人印象深刻。"}, {"type": "subtitle", "time": 379.029, "timestamp": "00:06:19", "text": "但节奏比较慢。我需要做"}, {"type": "subtitle", "time": 382.79, "timestamp": "00:06:22", "text": "这适用于篇幅较长、难度较高的歌曲。"}, {"type": "subtitle", "time": 386.71, "timestamp": "00:06:26", "text": "慢慢地，慢慢地，慢慢地"}]
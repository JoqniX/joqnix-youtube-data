[{"type": "subtitle", "time": 18601.75, "timestamp": "05:10:01", "text": "我正在直播聊天。"}, {"type": "subtitle", "time": 18604.23, "timestamp": "05:10:04", "text": "这是本频道第二次发布此类内容。我的"}, {"type": "subtitle", "time": 18606.15, "timestamp": "05:10:06", "text": "第一个就像我刚开始的时候一样"}, {"type": "subtitle", "time": 18609.19, "timestamp": "05:10:09", "text": "流媒体。嗯哼。我的天啊。我非常"}, {"type": "subtitle", "time": 18611.67, "timestamp": "05:10:11", "text": "第一次直播只是聊天，我"}, {"type": "subtitle", "time": 18613.59, "timestamp": "05:10:13", "text": "刚刚就这么做了，就像点击了一下，哦，我已经"}, {"type": "subtitle", "time": 18616.39, "timestamp": "05:10:16", "text": "我从来没有做过任何事，只是闲聊而已。"}, {"type": "subtitle", "time": 18619.27, "timestamp": "05:10:19", "text": "之后的流媒体。"}, {"type": "subtitle", "time": 18622.07, "timestamp": "05:10:22", "text": "哇。我们走吧。"}, {"type": "subtitle", "time": 18628.628, "timestamp": "05:10:28", "text": "边拉屎边聊天真的很有趣。"}, {"type": "subtitle", "time": 18632.55, "timestamp": "05:10:32", "text": "不，我知道。我呃，我从没想过会这样。"}, {"type": "subtitle", "time": 18634.15, "timestamp": "05:10:34", "text": "真好玩。所以，我确实有点想"}, {"type": "subtitle", "time": 18637.67, "timestamp": "05:10:37", "text": "应该多做这件事。但是，是的，我有点"}, {"type": "subtitle", "time": 18639.43, "timestamp": "05:10:39", "text": "刚才注意到这一点，就像，"}, {"type": "subtitle", "time": 18642.788, "timestamp": "05:10:42", "text": "好的，我可能想……修整一下"}, {"type": "subtitle", "time": 18645.27, "timestamp": "05:10:45", "text": "我的聊天屏幕也是这样，所以……"}, {"type": "subtitle", "time": 18648.07, "timestamp": "05:10:48", "text": "不仅仅是有点空白。"}, {"type": "subtitle", "time": 18650.23, "timestamp": "05:10:50", "text": "我希望他们拥有一些东西。"}, {"type": "subtitle", "time": 18654.23, "timestamp": "05:10:54", "text": "更漂亮，而不仅仅是……火。我"}, {"type": "subtitle", "time": 18657.43, "timestamp": "05:10:57", "text": "意思是，火是好的。我知道"}]
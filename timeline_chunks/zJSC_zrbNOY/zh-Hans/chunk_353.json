[{"type": "subtitle", "time": 21182.15, "timestamp": "05:53:02", "text": "至少要花点时间"}, {"type": "subtitle", "time": 21185.03, "timestamp": "05:53:05", "text": "一小时用于你热爱的爱好"}, {"type": "subtitle", "time": 21186.708, "timestamp": "05:53:06", "text": "一切。"}, {"type": "subtitle", "time": 21189.59, "timestamp": "05:53:09", "text": "是啊，因为我也想做类似的事情。"}, {"type": "subtitle", "time": 21193.91, "timestamp": "05:53:13", "text": "当然还有艺术，但那只是……"}, {"type": "subtitle", "time": 21196.548, "timestamp": "05:53:16", "text": "比如，我觉得我们没有……"}, {"type": "subtitle", "time": 21200.708, "timestamp": "05:53:20", "text": "好像……有什么东西"}, {"type": "subtitle", "time": 21203.83, "timestamp": "05:53:23", "text": "课程方面我都选好了，所以有点卡住了。"}, {"type": "subtitle", "time": 21207.43, "timestamp": "05:53:27", "text": "经常在 YouTube 上看视频，而且很喜欢。"}, {"type": "subtitle", "time": 21210.47, "timestamp": "05:53:30", "text": "直播主播们会有点……"}, {"type": "subtitle", "time": 21212.708, "timestamp": "05:53:32", "text": "就像他们的直播一样"}, {"type": "subtitle", "time": 21214.548, "timestamp": "05:53:34", "text": "他们将解释艺术是如何运作的。"}, {"type": "subtitle", "time": 21216.31, "timestamp": "05:53:36", "text": "东西能用。"}, {"type": "subtitle", "time": 21218.31, "timestamp": "05:53:38", "text": "是的，"}, {"type": "subtitle", "time": 21221.83, "timestamp": "05:53:41", "text": "因为我注意到我的情况就像……嗯……"}, {"type": "subtitle", "time": 21224.47, "timestamp": "05:53:44", "text": "挺搞笑的，因为你知道，就像在……"}, {"type": "subtitle", "time": 21226.15, "timestamp": "05:53:46", "text": "呃，推特上有很多……"}, {"type": "subtitle", "time": 21230.31, "timestamp": "05:53:50", "text": "某种程度上将人工智能艺术与……区分开来"}, {"type": "subtitle", "time": 21234.39, "timestamp": "05:53:54", "text": "艺术，真正的人类艺术。所以他们会很友善"}, {"type": "subtitle", "time": 21237.83, "timestamp": "05:53:57", "text": "挑剔某些方面，比如它如何"}, {"type": "subtitle", "time": 21239.91, "timestamp": "05:53:59", "text": "感觉像是全部画在了同一层上。"}]
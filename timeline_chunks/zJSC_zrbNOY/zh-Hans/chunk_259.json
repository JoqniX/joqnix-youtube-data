[{"type": "subtitle", "time": 15541.429, "timestamp": "04:19:01", "text": "之前从未接触过。所以，我"}, {"type": "subtitle", "time": 15544.63, "timestamp": "04:19:04", "text": "意识到，嗯，好像有一些"}, {"type": "subtitle", "time": 15548.79, "timestamp": "04:19:08", "text": "喜欢合作或不喜欢合作的人"}, {"type": "subtitle", "time": 15551.429, "timestamp": "04:19:11", "text": "合作？我把它看作是你们的聚会。"}, {"type": "subtitle", "time": 15554.469, "timestamp": "04:19:14", "text": "当你更了解这个人时，你就会明白。"}, {"type": "subtitle", "time": 15556.95, "timestamp": "04:19:16", "text": "比合作更好"}, {"type": "subtitle", "time": 15558.55, "timestamp": "04:19:18", "text": "你需要担心很多事情。"}, {"type": "subtitle", "time": 15561.75, "timestamp": "04:19:21", "text": "对，所以我注意到有"}, {"type": "subtitle", "time": 15565.11, "timestamp": "04:19:25", "text": "一些 YouTuber 或创作者，呃"}, {"type": "subtitle", "time": 15569.11, "timestamp": "04:19:29", "text": "我想知道，嗯，因为我不是"}, {"type": "subtitle", "time": 15572.149, "timestamp": "04:19:32", "text": "跟他们好好说话，对吧？"}, {"type": "subtitle", "time": 15573.91, "timestamp": "04:19:33", "text": "他们只与这些人合作"}, {"type": "subtitle", "time": 15576.229, "timestamp": "04:19:36", "text": "关系很亲密，等等。所以我就想，"}, {"type": "subtitle", "time": 15579.51, "timestamp": "04:19:39", "text": "“哦，原来有人会这么做啊？我可没这么做。”"}, {"type": "subtitle", "time": 15582.389, "timestamp": "04:19:42", "text": "知道。”而且有些人是开放的。"}, {"type": "subtitle", "time": 15586.229, "timestamp": "04:19:46", "text": "试试看，看看效果如何。"}, {"type": "subtitle", "time": 15588.79, "timestamp": "04:19:48", "text": "一切。有些人看到了"}, {"type": "subtitle", "time": 15591.269, "timestamp": "04:19:51", "text": "将其视为交易协作或"}, {"type": "subtitle", "time": 15593.269, "timestamp": "04:19:53", "text": "某物"}, {"type": "subtitle", "time": 15596.309, "timestamp": "04:19:56", "text": "类型。还有好多好多事情呢。它"}, {"type": "subtitle", "time": 15598.55, "timestamp": "04:19:58", "text": "就像……"}]
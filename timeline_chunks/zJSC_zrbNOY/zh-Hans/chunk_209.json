[{"type": "subtitle", "time": 12541.19, "timestamp": "03:29:01", "text": "英语文学和本地的东西"}, {"type": "subtitle", "time": 12542.79, "timestamp": "03:29:02", "text": "大学？"}, {"type": "subtitle", "time": 12546.15, "timestamp": "03:29:06", "text": "我做了。那就像我的……嗯……学士学位"}, {"type": "subtitle", "time": 12548.15, "timestamp": "03:29:08", "text": "主题。所以这有点像心理学，"}, {"type": "subtitle", "time": 12550.55, "timestamp": "03:29:10", "text": "社会学和英国文学。我是"}, {"type": "subtitle", "time": 12553.19, "timestamp": "03:29:13", "text": "这样做其实只是为了能写东西。"}, {"type": "subtitle", "time": 12555.67, "timestamp": "03:29:15", "text": "我自己的故事等等。所以我想"}, {"type": "subtitle", "time": 12557.99, "timestamp": "03:29:17", "text": "这是获得喜爱的一种简单方法。"}, {"type": "subtitle", "time": 12561.269, "timestamp": "03:29:21", "text": "程度。所以我选这个。哦，我的天哪"}, {"type": "subtitle", "time": 12563.99, "timestamp": "03:29:23", "text": "天哪，感觉就像在学历史一样。"}, {"type": "subtitle", "time": 12566.87, "timestamp": "03:29:26", "text": "因为那个该怎么称呼它"}, {"type": "subtitle", "time": 12568.87, "timestamp": "03:29:28", "text": "英国文学"}, {"type": "subtitle", "time": 12574.309, "timestamp": "03:29:34", "text": "16世纪、17世纪，真是太棒了！"}, {"type": "subtitle", "time": 12577.74, "timestamp": "03:29:37", "text": "呃，里面充满了那种东西。"}, {"type": "subtitle", "time": 12580.63, "timestamp": "03:29:40", "text": "[音乐]"}, {"type": "subtitle", "time": 12582.79, "timestamp": "03:29:42", "text": "好多东西"}, {"type": "subtitle", "time": 12585.349, "timestamp": "03:29:45", "text": "但它是否以某种方式帮助你了呢？"}, {"type": "subtitle", "time": 12588.07, "timestamp": "03:29:48", "text": "了解作家的思考方式和"}, {"type": "subtitle", "time": 12589.67, "timestamp": "03:29:49", "text": "一切"}, {"type": "subtitle", "time": 12593.99, "timestamp": "03:29:53", "text": "我的意思是，如果你有点……的话，它就很好用。"}, {"type": "subtitle", "time": 12596.309, "timestamp": "03:29:56", "text": "嗯"}, {"type": "subtitle", "time": 12599.03, "timestamp": "03:29:59", "text": "我会说"}]
[{"type": "subtitle", "time": 4985.91, "timestamp": "01:23:05", "text": "好的。我爸玩不了这游戏，真的。"}, {"type": "subtitle", "time": 4989.669, "timestamp": "01:23:09", "text": "呃，他给了我类似……"}, {"type": "subtitle", "time": 4997.03, "timestamp": "01:23:17", "text": "是的。是的。他给了我一个类似“嗯，该怎么做”的回答。"}, {"type": "subtitle", "time": 5000.149, "timestamp": "01:23:20", "text": "你管它叫什么？为什么说话这么难？他"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "好的，我关注了你的推特，我的意思是……"}]
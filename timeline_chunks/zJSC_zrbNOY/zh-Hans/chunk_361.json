[{"type": "subtitle", "time": 21661.43, "timestamp": "06:01:01", "text": "那次合作让我重拾信心"}, {"type": "subtitle", "time": 21664.39, "timestamp": "06:01:04", "text": "然后尝试了第二次和第三次合作"}, {"type": "subtitle", "time": 21667.75, "timestamp": "06:01:07", "text": "不知何时起，这件事变成了我……"}, {"type": "subtitle", "time": 21671.19, "timestamp": "06:01:11", "text": "感觉很舒服，所以我开始合作。"}, {"type": "subtitle", "time": 21673.91, "timestamp": "06:01:13", "text": "我觉得很多人都有过那样的时光"}, {"type": "subtitle", "time": 21676.628, "timestamp": "06:01:16", "text": "是啊，然后通过乔，我就觉得真的"}, {"type": "subtitle", "time": 21679.75, "timestamp": "06:01:19", "text": "惊讶得就像：我的天哪，我竟然在合作！"}, {"type": "subtitle", "time": 21682.548, "timestamp": "06:01:22", "text": "和那些我几乎没说过话的人在一起"}, {"type": "subtitle", "time": 21685.11, "timestamp": "06:01:25", "text": "我跟那些人谈过，他们是"}, {"type": "subtitle", "time": 21687.35, "timestamp": "06:01:27", "text": "好的，我可以轻松"}, {"type": "subtitle", "time": 21689.51, "timestamp": "06:01:29", "text": "知道他们的氛围如何，以及"}, {"type": "subtitle", "time": 21691.75, "timestamp": "06:01:31", "text": "除了像我从未见过的人之外的一切"}, {"type": "subtitle", "time": 21694.47, "timestamp": "06:01:34", "text": "这是我们第一次交谈和互动。"}, {"type": "subtitle", "time": 21697.03, "timestamp": "06:01:37", "text": "我不知道我该如何适应他们"}, {"type": "subtitle", "time": 21699.11, "timestamp": "06:01:39", "text": "精力水平，我什么都感觉不到，甚至"}, {"type": "subtitle", "time": 21701.99, "timestamp": "06:01:41", "text": "我知道我是否适应了，但我还是……"}, {"type": "subtitle", "time": 21704.31, "timestamp": "06:01:44", "text": "我们玩得很开心。"}, {"type": "subtitle", "time": 21707.19, "timestamp": "06:01:47", "text": "至少能说话就足够了。"}, {"type": "subtitle", "time": 21711.19, "timestamp": "06:01:51", "text": "因为，嗯，就像，只要我"}, {"type": "subtitle", "time": 21713.91, "timestamp": "06:01:53", "text": "可以重新联系并了解这个人"}, {"type": "subtitle", "time": 21717.03, "timestamp": "06:01:57", "text": "没关系，我不在乎。"}, {"type": "subtitle", "time": 21719.51, "timestamp": "06:01:59", "text": "其他事情，比如你应该怎么做"}]
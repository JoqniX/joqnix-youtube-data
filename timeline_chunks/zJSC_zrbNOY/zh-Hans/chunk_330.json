[{"type": "subtitle", "time": 19802.31, "timestamp": "05:30:02", "text": "我是不是被骗了？他们到达了吗？"}, {"type": "subtitle", "time": 19804.47, "timestamp": "05:30:04", "text": "被骗了吗？"}, {"type": "subtitle", "time": 19806.23, "timestamp": "05:30:06", "text": "什么？"}, {"type": "subtitle", "time": 19816.788, "timestamp": "05:30:16", "text": "你在干什么？"}, {"type": "subtitle", "time": 19822.23, "timestamp": "05:30:22", "text": "[音乐]"}, {"type": "subtitle", "time": 19825.27, "timestamp": "05:30:25", "text": "但是，呃，那些东西好吗，塔米？"}, {"type": "subtitle", "time": 19828.23, "timestamp": "05:30:28", "text": "你喜欢其中的哪些？他们是吗？"}, {"type": "subtitle", "time": 19830.47, "timestamp": "05:30:30", "text": "有帮助吗？"}, {"type": "subtitle", "time": 19834.628, "timestamp": "05:30:34", "text": "不知为何，我当时……嗯……"}, {"type": "subtitle", "time": 19837.35, "timestamp": "05:30:37", "text": "回来后收到很多国际消息。"}, {"type": "subtitle", "time": 19839.67, "timestamp": "05:30:39", "text": "广告。"}, {"type": "subtitle", "time": 19843.51, "timestamp": "05:30:43", "text": "所以是德国人什么的，对吧？是的。所以，我"}, {"type": "subtitle", "time": 19845.67, "timestamp": "05:30:45", "text": "就像在朋友的直播间里一样。"}, {"type": "subtitle", "time": 19847.43, "timestamp": "05:30:47", "text": "突然我看到一个广告，然后我就想，好吧"}, {"type": "subtitle", "time": 19851.03, "timestamp": "05:30:51", "text": "别担心，然后就像……"}, {"type": "subtitle", "time": 19852.948, "timestamp": "05:30:52", "text": "你不会说英语，而我只是"}, {"type": "subtitle", "time": 19855.59, "timestamp": "05:30:55", "text": "比如专注于“至少”这样的词语。"}, {"type": "subtitle", "time": 19857.99, "timestamp": "05:30:57", "text": "我会找到像我们这样的人。"}]
[{"type": "subtitle", "time": 14940.63, "timestamp": "04:09:00", "text": "现在情况不太好。那是个沉重的沙袋"}, {"type": "subtitle", "time": 14955.429, "timestamp": "04:09:15", "text": "你有没有在网上认识什么朋友？"}, {"type": "subtitle", "time": 14959.349, "timestamp": "04:09:19", "text": "比如油管博主或主播？"}, {"type": "subtitle", "time": 14965.03, "timestamp": "04:09:25", "text": "不，我没有。我已经连接上了"}, {"type": "subtitle", "time": 14969.11, "timestamp": "04:09:29", "text": "比如，呃，在我的现实生活中的账号上，有一些我的"}, {"type": "subtitle", "time": 14972.309, "timestamp": "04:09:32", "text": "选定了一些，但是呃，我一直没能……"}, {"type": "subtitle", "time": 14979.83, "timestamp": "04:09:39", "text": "但我猜我会更乐于接受。"}, {"type": "subtitle", "time": 14982.79, "timestamp": "04:09:42", "text": "现在，因为我不确定我是否会"}, {"type": "subtitle", "time": 14985.83, "timestamp": "04:09:45", "text": "我如此沉迷于流媒体的时候"}, {"type": "subtitle", "time": 14988.389, "timestamp": "04:09:48", "text": "最初开始了。更像是我"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "我会和朋友们一起玩游戏。"}, {"type": "subtitle", "time": 14993.269, "timestamp": "04:09:53", "text": "我可以拥有一个漂亮的角色"}, {"type": "subtitle", "time": 14995.11, "timestamp": "04:09:55", "text": "也一样。"}, {"type": "subtitle", "time": 14996.87, "timestamp": "04:09:56", "text": "M."}]
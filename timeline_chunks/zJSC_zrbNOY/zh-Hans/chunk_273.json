[{"type": "subtitle", "time": 16380.389, "timestamp": "04:33:00", "text": "他对我的态度很奇怪，令人毛骨悚然。希加"}, {"type": "subtitle", "time": 16382.55, "timestamp": "04:33:02", "text": "女孩油管博主之类的。我不"}, {"type": "subtitle", "time": 16386.23, "timestamp": "04:33:06", "text": "我之前对这些一无所知，我当时真是个傻瓜。"}, {"type": "subtitle", "time": 16389.83, "timestamp": "04:33:09", "text": "我当时真是蠢透了，我甚至还向他们道歉了。"}, {"type": "subtitle", "time": 16392.07, "timestamp": "04:33:12", "text": "虽然这不是我的错，而且我"}, {"type": "subtitle", "time": 16393.99, "timestamp": "04:33:13", "text": "是的，我和他们有联系。"}, {"type": "subtitle", "time": 16397.83, "timestamp": "04:33:17", "text": "尽量劝告这个人，不要这样做"}, {"type": "subtitle", "time": 16401.349, "timestamp": "04:33:21", "text": "再说一遍，给他们第二次机会"}, {"type": "subtitle", "time": 16404.23, "timestamp": "04:33:24", "text": "机会之类的，我说过我会尽力"}, {"type": "subtitle", "time": 16407.51, "timestamp": "04:33:27", "text": "你知道，试着看看他能不能改变，或者"}, {"type": "subtitle", "time": 16411.429, "timestamp": "04:33:31", "text": "不，所以我一直很有耐心，我试着……"}, {"type": "subtitle", "time": 16413.83, "timestamp": "04:33:33", "text": "诸如此类的东西，以及玩耍"}, {"type": "subtitle", "time": 16416.15, "timestamp": "04:33:36", "text": "让他们拥有良好的心态"}, {"type": "subtitle", "time": 16419.429, "timestamp": "04:33:39", "text": "一切都结束了，但最终感觉就像……"}, {"type": "subtitle", "time": 16421.83, "timestamp": "04:33:41", "text": "我当时正在对着墙说话，就在那时"}, {"type": "subtitle", "time": 16425.75, "timestamp": "04:33:45", "text": "意识到有些人"}, {"type": "subtitle", "time": 16428.15, "timestamp": "04:33:48", "text": "没变，他们还是做同样的事情。"}, {"type": "subtitle", "time": 16431.189, "timestamp": "04:33:51", "text": "一遍又一遍，从未改变"}, {"type": "subtitle", "time": 16434.31, "timestamp": "04:33:54", "text": "即使你尽力去做，"}, {"type": "subtitle", "time": 16436.949, "timestamp": "04:33:56", "text": "最好修改或提出建议。"}, {"type": "subtitle", "time": 16439.51, "timestamp": "04:33:59", "text": "事情要有所不同，这样他们"}]
[{"type": "subtitle", "time": 21480.31, "timestamp": "05:58:00", "text": "在 Vubing 期间。嗯，是……我们"}, {"type": "subtitle", "time": 21483.43, "timestamp": "05:58:03", "text": "另一个油管博主，呃，就像……"}, {"type": "subtitle", "time": 21486.23, "timestamp": "05:58:06", "text": "加入风投公司并进行交流就像我以前那样。"}, {"type": "subtitle", "time": 21489.19, "timestamp": "05:58:09", "text": "被静音至少需要30分钟"}, {"type": "subtitle", "time": 21491.27, "timestamp": "05:58:11", "text": "给我几分钟时间来调整我的身心。"}, {"type": "subtitle", "time": 21495.11, "timestamp": "05:58:15", "text": "灵魂就像你知道的，聊天打招呼"}, {"type": "subtitle", "time": 21498.788, "timestamp": "05:58:18", "text": "因为以前这真的超级难……"}, {"type": "subtitle", "time": 21502.07, "timestamp": "05:58:22", "text": "我可能是焦虑症或者社交障碍。"}, {"type": "subtitle", "time": 21505.83, "timestamp": "05:58:25", "text": "我不知道那玩意儿，然后慢慢地"}, {"type": "subtitle", "time": 21509.27, "timestamp": "05:58:29", "text": "我慢慢地交了个朋友，他说话很慢。"}, {"type": "subtitle", "time": 21512.07, "timestamp": "05:58:32", "text": "她觉得和她相处很舒服，而且她就像"}, {"type": "subtitle", "time": 21515.67, "timestamp": "05:58:35", "text": "嗯，你在说话，就像在说话一样"}, {"type": "subtitle", "time": 21517.83, "timestamp": "05:58:37", "text": "通常情况下我都能做到，所以没问题，你可以这么做。"}, {"type": "subtitle", "time": 21520.47, "timestamp": "05:58:40", "text": "现在我们合作了，她拉着我一起做"}, {"type": "subtitle", "time": 21523.27, "timestamp": "05:58:43", "text": "第一次合作，我超级兴奋"}, {"type": "subtitle", "time": 21528.23, "timestamp": "05:58:48", "text": "我当时很紧张，心想：哦，不"}, {"type": "subtitle", "time": 21531.83, "timestamp": "05:58:51", "text": "我该说什么呢？但是，呃，因为我当时就像……"}, {"type": "subtitle", "time": 21534.868, "timestamp": "05:58:54", "text": "因为就合作而言，"}, {"type": "subtitle", "time": 21537.11, "timestamp": "05:58:57", "text": "那段时间发生的事情，或者像谈论很多事情一样。"}]
[{"type": "subtitle", "time": 15841.189, "timestamp": "04:24:01", "text": "小子，这是在伤口上撒盐。是的。"}, {"type": "subtitle", "time": 15845.429, "timestamp": "04:24:05", "text": "是的。我的天啊。"}, {"type": "subtitle", "time": 15847.67, "timestamp": "04:24:07", "text": "我知道。等等，你不保留你的"}, {"type": "subtitle", "time": 15851.189, "timestamp": "04:24:11", "text": "整个粉丝列表不再是或点赞或"}, {"type": "subtitle", "time": 15854.389, "timestamp": "04:24:14", "text": "你一直开着吗？打开打开。它已开放。"}, {"type": "subtitle", "time": 15856.79, "timestamp": "04:24:16", "text": "所以关注我并不是因为我喜欢"}, {"type": "subtitle", "time": 15859.83, "timestamp": "04:24:19", "text": "我可能不太喜欢很多东西，我可能不会"}, {"type": "subtitle", "time": 15863.349, "timestamp": "04:24:23", "text": "每个人的氛围。"}, {"type": "subtitle", "time": 15867.03, "timestamp": "04:24:27", "text": "所以就好像他们看到……"}, {"type": "subtitle", "time": 15870.229, "timestamp": "04:24:30", "text": "比如我"}, {"type": "subtitle", "time": 15871.75, "timestamp": "04:24:31", "text": "玩他们喜欢的分类游戏。"}, {"type": "subtitle", "time": 15873.03, "timestamp": "04:24:33", "text": "所以，我只是想保留这个选项，如果你想的话。"}, {"type": "subtitle", "time": 15875.189, "timestamp": "04:24:35", "text": "来这里玩这场比赛，或者只是为了"}, {"type": "subtitle", "time": 15877.189, "timestamp": "04:24:37", "text": "这样没关系。你可以来玩。你"}, {"type": "subtitle", "time": 15880.149, "timestamp": "04:24:40", "text": "可以聊天。如果……则无需关注"}, {"type": "subtitle", "time": 15882.95, "timestamp": "04:24:42", "text": "你不想那样做。"}, {"type": "subtitle", "time": 15885.189, "timestamp": "04:24:45", "text": "哦，我没想到这一点。为了"}, {"type": "subtitle", "time": 15887.83, "timestamp": "04:24:47", "text": "我当时的想法是，哦，我还是留着我的吧。"}, {"type": "subtitle", "time": 15890.469, "timestamp": "04:24:50", "text": "仅限关注者，这样可以避免机器人。"}, {"type": "subtitle", "time": 15894.229, "timestamp": "04:24:54", "text": "还有其他一些东西。此外，你还可以看到和"}, {"type": "subtitle", "time": 15896.95, "timestamp": "04:24:56", "text": "如果您希望互动，请检查是否符合要求。"}, {"type": "subtitle", "time": 15899.59, "timestamp": "04:24:59", "text": "和我在一起，了解我的状态，以及所有的一切"}]
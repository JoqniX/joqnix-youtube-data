[{"type": "subtitle", "time": 8468.469, "timestamp": "02:21:08", "text": "我不知道。"}, {"type": "subtitle", "time": 8480.07, "timestamp": "02:21:20", "text": "我的天哪。世界各地，"}, {"type": "subtitle", "time": 8483.83, "timestamp": "02:21:23", "text": "它们无处不在。就像，"}, {"type": "subtitle", "time": 8517.83, "timestamp": "02:21:57", "text": "这是什么东西？让我像十字架一样"}]
[{"type": "subtitle", "time": 15180.309, "timestamp": "04:13:00", "text": "是吗？我当时在班加罗尔，为了我的"}, {"type": "subtitle", "time": 15181.91, "timestamp": "04:13:01", "text": "实习"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "我非常喜欢这碗拉面。我"}, {"type": "subtitle", "time": 15188.95, "timestamp": "04:13:08", "text": "我发誓它真的太好吃了。"}, {"type": "subtitle", "time": 15190.63, "timestamp": "04:13:10", "text": "一个"}, {"type": "subtitle", "time": 15194.469, "timestamp": "04:13:14", "text": "我当时就真的……嗯……其实"}, {"type": "subtitle", "time": 15197.429, "timestamp": "04:13:17", "text": "我在那里更充分地利用了时间……"}, {"type": "subtitle", "time": 15199.67, "timestamp": "04:13:19", "text": "探索美食。所以我就吃了玉米"}, {"type": "subtitle", "time": 15203.03, "timestamp": "04:13:23", "text": "狗和嗯"}, {"type": "subtitle", "time": 15207.269, "timestamp": "04:13:27", "text": "拉面，呃，我就会用……"}, {"type": "subtitle", "time": 15209.429, "timestamp": "04:13:29", "text": "以及其他食品配送应用程序"}, {"type": "subtitle", "time": 15211.91, "timestamp": "04:13:31", "text": "帮我拿东西。部分原因"}, {"type": "subtitle", "time": 15214.07, "timestamp": "04:13:34", "text": "也有点像那样，呃……"}, {"type": "subtitle", "time": 15217.11, "timestamp": "04:13:37", "text": "和我合住一个房间的人会"}, {"type": "subtitle", "time": 15220.149, "timestamp": "04:13:40", "text": "吃东西，比如吃很多东西，比如"}, {"type": "subtitle", "time": 15222.149, "timestamp": "04:13:42", "text": "比如开始吃点东西之类的"}, {"type": "subtitle", "time": 15224.87, "timestamp": "04:13:44", "text": "到了某个阶段之后，它就开始"}, {"type": "subtitle", "time": 15228.229, "timestamp": "04:13:48", "text": "感觉有点过头了。所以"}, {"type": "subtitle", "time": 15230.229, "timestamp": "04:13:50", "text": "那时我就​​开始下单了。"}, {"type": "subtitle", "time": 15232.149, "timestamp": "04:13:52", "text": "因为她是非素食者，所以她吃荤菜。"}]
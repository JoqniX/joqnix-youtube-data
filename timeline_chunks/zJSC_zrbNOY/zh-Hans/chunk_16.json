[{"type": "subtitle", "time": 964.71, "timestamp": "00:16:04", "text": "啊，麦克风在楼下。我以为我"}, {"type": "subtitle", "time": 967.67, "timestamp": "00:16:07", "text": "我没带麦克风。为什么？我"}, {"type": "subtitle", "time": 971.509, "timestamp": "00:16:11", "text": "我把它带到楼下了。"}, {"type": "subtitle", "time": 974.949, "timestamp": "00:16:14", "text": "好的，没关系。"}, {"type": "subtitle", "time": 981.43, "timestamp": "00:16:21", "text": "是的。嗯，"}, {"type": "subtitle", "time": 984.47, "timestamp": "00:16:24", "text": "首先，让我更新一些内容。你"}, {"type": "subtitle", "time": 987.829, "timestamp": "00:16:27", "text": "我知道，我当时在看一些……"}, {"type": "subtitle", "time": 990.629, "timestamp": "00:16:30", "text": "那个油管博主，我现在忘了他的名字了，或者"}, {"type": "subtitle", "time": 995.11, "timestamp": "00:16:35", "text": "对 PewDiePie 的最新视频做出反应，"}, {"type": "subtitle", "time": 998.71, "timestamp": "00:16:38", "text": "那是关于他的……嗯"}, {"type": "subtitle", "time": 1003.99, "timestamp": "00:16:43", "text": "那是关于他呃做……"}, {"type": "subtitle", "time": 1006.71, "timestamp": "00:16:46", "text": "呃，开发方面的东西，还有他那些事。"}, {"type": "subtitle", "time": 1008.47, "timestamp": "00:16:48", "text": "制成，"}, {"type": "subtitle", "time": 1011.509, "timestamp": "00:16:51", "text": "正确的？我觉得那真的很"}, {"type": "subtitle", "time": 1013.189, "timestamp": "00:16:53", "text": "凉爽的。"}, {"type": "subtitle", "time": 1017.269, "timestamp": "00:16:57", "text": "他这么做真是太好了。"}]
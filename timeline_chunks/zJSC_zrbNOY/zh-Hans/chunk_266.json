[{"type": "subtitle", "time": 15962.229, "timestamp": "04:26:02", "text": "H YouTube。呃，有一个我可以"}, {"type": "subtitle", "time": 15966.469, "timestamp": "04:26:06", "text": "其实记得有两个。嗯，其中一个"}, {"type": "subtitle", "time": 15969.59, "timestamp": "04:26:09", "text": "会是嗯，"}, {"type": "subtitle", "time": 15972.63, "timestamp": "04:26:12", "text": "其中一位就是……"}, {"type": "subtitle", "time": 15975.91, "timestamp": "04:26:15", "text": "碰巧有一位观众"}, {"type": "subtitle", "time": 15978.63, "timestamp": "04:26:18", "text": "一个孩子。我想他们大概15岁左右吧"}, {"type": "subtitle", "time": 15980.79, "timestamp": "04:26:20", "text": "某物。我当时想，是啊，他们"}, {"type": "subtitle", "time": 15983.67, "timestamp": "04:26:23", "text": "欢迎来我的直播间看看。它们就像"}, {"type": "subtitle", "time": 15985.75, "timestamp": "04:26:25", "text": "呃，他们一开始真的很友善，"}, {"type": "subtitle", "time": 15989.75, "timestamp": "04:26:29", "text": "一切都很好，但一开始确实不错。"}, {"type": "subtitle", "time": 15992.63, "timestamp": "04:26:32", "text": "一切都是，我想，是的，它们都是"}, {"type": "subtitle", "time": 15995.75, "timestamp": "04:26:35", "text": "好的，我可以玩，我可以让他们进来。"}, {"type": "subtitle", "time": 15998.469, "timestamp": "04:26:38", "text": "我可以和他们一起在直播中玩游戏。"}, {"type": "subtitle", "time": 16001.269, "timestamp": "04:26:41", "text": "所以那天我想我是在做一个合作项目。"}, {"type": "subtitle", "time": 16003.99, "timestamp": "04:26:43", "text": "很久以前就和客人一起来了。我认为这一点"}, {"type": "subtitle", "time": 16006.55, "timestamp": "04:26:46", "text": "是在2020年"}, {"type": "subtitle", "time": 16009.91, "timestamp": "04:26:49", "text": "呃，大概是2021年左右。"}, {"type": "subtitle", "time": 16012.469, "timestamp": "04:26:52", "text": "所以这是一条顶级流。我们当时在玩"}, {"type": "subtitle", "time": 16015.189, "timestamp": "04:26:55", "text": "我们还需要一个人。所以"}, {"type": "subtitle", "time": 16018.55, "timestamp": "04:26:58", "text": "客座工作就像我通常不会允许的那样"}]
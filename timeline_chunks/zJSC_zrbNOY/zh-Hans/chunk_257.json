[{"type": "subtitle", "time": 15420.229, "timestamp": "04:17:00", "text": "随着你的年龄增长。他们和其他人一样一无所知。"}, {"type": "subtitle", "time": 15422.55, "timestamp": "04:17:02", "text": "你是。"}, {"type": "subtitle", "time": 15424.79, "timestamp": "04:17:04", "text": "是的。"}, {"type": "subtitle", "time": 15427.349, "timestamp": "04:17:07", "text": "我的天啊。"}, {"type": "subtitle", "time": 15430.95, "timestamp": "04:17:10", "text": "那只是……嗯，但我真的很想……"}, {"type": "subtitle", "time": 15434.229, "timestamp": "04:17:14", "text": "见面时，我感觉自己好像有更多的人，然后……"}, {"type": "subtitle", "time": 15435.99, "timestamp": "04:17:15", "text": "就像我的好朋友一样"}, {"type": "subtitle", "time": 15438.79, "timestamp": "04:17:18", "text": "我只想加入的 YouTuber 社群"}, {"type": "subtitle", "time": 15442.229, "timestamp": "04:17:22", "text": "遭遇非常糟糕。"}, {"type": "subtitle", "time": 15451.269, "timestamp": "04:17:31", "text": "[音乐]"}, {"type": "subtitle", "time": 15453.99, "timestamp": "04:17:33", "text": "太棒了。不，你会创造更多回忆。"}, {"type": "subtitle", "time": 15456.07, "timestamp": "04:17:36", "text": "就像你拥有的那些记忆"}, {"type": "subtitle", "time": 15458.87, "timestamp": "04:17:38", "text": "在线上，你可以创造更多回忆"}, {"type": "subtitle", "time": 15462.469, "timestamp": "04:17:42", "text": "离线也一样。我知道。就像……"}, {"type": "subtitle", "time": 15466.95, "timestamp": "04:17:46", "text": "他们喜欢和你住在不同的国家。"}, {"type": "subtitle", "time": 15470.55, "timestamp": "04:17:50", "text": "就像你一样。这就好比问：你存在的意义是什么？"}, {"type": "subtitle", "time": 15474.149, "timestamp": "04:17:54", "text": "远在那么遥远的地方？"}]
[{"type": "subtitle", "time": 17580.23, "timestamp": "04:53:00", "text": "比如资助它的索具安装。甚至"}, {"type": "subtitle", "time": 17584.07, "timestamp": "04:53:04", "text": "虽然这幅画是由……创作的"}, {"type": "subtitle", "time": 17593.91, "timestamp": "04:53:13", "text": "因为我正在参加 Joathon 活动，所以我可以……"}, {"type": "subtitle", "time": 17596.39, "timestamp": "04:53:16", "text": "模型和所有东西。"}, {"type": "subtitle", "time": 17599.35, "timestamp": "04:53:19", "text": "耶。"}, {"type": "subtitle", "time": 17601.67, "timestamp": "04:53:21", "text": "我希望感觉良好，我们能成功。"}, {"type": "subtitle", "time": 17603.67, "timestamp": "04:53:23", "text": "模型即将推出。"}, {"type": "subtitle", "time": 17606.07, "timestamp": "04:53:26", "text": "是的。"}, {"type": "subtitle", "time": 17609.75, "timestamp": "04:53:29", "text": "因为现在感觉真的很奇怪"}, {"type": "subtitle", "time": 17613.59, "timestamp": "04:53:33", "text": "请大家点赞、支持"}, {"type": "subtitle", "time": 17616.39, "timestamp": "04:53:36", "text": "还有其他一些事，因为我就是那种会做这些事的人。"}, {"type": "subtitle", "time": 17618.788, "timestamp": "04:53:38", "text": "一切免费。我不，我不"}, {"type": "subtitle", "time": 17620.868, "timestamp": "04:53:40", "text": "想要别人的钱或其他任何东西。我只是"}, {"type": "subtitle", "time": 17623.03, "timestamp": "04:53:43", "text": "我想做自己喜欢的事，玩得开心。"}, {"type": "subtitle", "time": 17626.628, "timestamp": "04:53:46", "text": "现在就创造美好回忆吧。我一直都知道"}, {"type": "subtitle", "time": 17629.03, "timestamp": "04:53:49", "text": "D 有这种安息日文化，"}, {"type": "subtitle", "time": 17632.31, "timestamp": "04:53:52", "text": "什么都做过，但我很久以前从没做过。"}, {"type": "subtitle", "time": 17635.43, "timestamp": "04:53:55", "text": "回来也是因为我觉得，是的，如果我"}, {"type": "subtitle", "time": 17638.23, "timestamp": "04:53:58", "text": "如果我做这件事，那一定是为了慈善。"}]
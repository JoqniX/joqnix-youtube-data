[{"type": "subtitle", "time": 18964.15, "timestamp": "05:16:04", "text": "为什么你要那样关闭它？"}, {"type": "subtitle", "time": 18967.51, "timestamp": "05:16:07", "text": "我想我不想给"}, {"type": "subtitle", "time": 18971.19, "timestamp": "05:16:11", "text": "赋予我的观众如此强大的力量。"}, {"type": "subtitle", "time": 18976.07, "timestamp": "05:16:16", "text": "因为我知道，嗯，他们中的一些人会"}, {"type": "subtitle", "time": 18980.07, "timestamp": "05:16:20", "text": "能够获得那么多积分。"}, {"type": "subtitle", "time": 18983.75, "timestamp": "05:16:23", "text": "我有一个英文单词是"}, {"type": "subtitle", "time": 18986.948, "timestamp": "05:16:26", "text": "深受他们喜爱。所以我不能说话。"}, {"type": "subtitle", "time": 18988.788, "timestamp": "05:16:28", "text": "英语五分钟。我想要"}, {"type": "subtitle", "time": 18991.75, "timestamp": "05:16:31", "text": "缩短或增加所需时间"}, {"type": "subtitle", "time": 18993.27, "timestamp": "05:16:33", "text": "积分。"}, {"type": "subtitle", "time": 18994.948, "timestamp": "05:16:34", "text": "嗯。然后还有失去我的"}, {"type": "subtitle", "time": 18997.03, "timestamp": "05:16:37", "text": "眼镜。所以我不得不摘下眼镜。"}, {"type": "subtitle", "time": 19000.15, "timestamp": "05:16:40", "text": "播放我正在播放的任何内容。我曾经"}, {"type": "subtitle", "time": 19004.15, "timestamp": "05:16:44", "text": "照做。我的天啊。那真是太……"}, {"type": "subtitle", "time": 19007.27, "timestamp": "05:16:47", "text": "我知道。就像我瞎得像只蝙蝠一样"}, {"type": "subtitle", "time": 19010.15, "timestamp": "05:16:50", "text": "大概五分钟。是的。"}, {"type": "subtitle", "time": 19012.628, "timestamp": "05:16:52", "text": "是的。是的。是的。然后，嗯，反过来。"}, {"type": "subtitle", "time": 19016.15, "timestamp": "05:16:56", "text": "一。所以我的做法是，嗯，我去……"}]
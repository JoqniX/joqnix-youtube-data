[{"type": "subtitle", "time": 12904.63, "timestamp": "03:35:04", "text": "我认为"}, {"type": "subtitle", "time": 12911.349, "timestamp": "03:35:11", "text": "查德现在能听到我说话了。我希望如此。是的。"}, {"type": "subtitle", "time": 12913.83, "timestamp": "03:35:13", "text": "大家好。"}, {"type": "subtitle", "time": 12921.03, "timestamp": "03:35:21", "text": "我本想表达更多歉意，但你知道的"}, {"type": "subtitle", "time": 12922.63, "timestamp": "03:35:22", "text": "我可能也会做同样的事情。"}, {"type": "subtitle", "time": 12927.91, "timestamp": "03:35:27", "text": "下一个流。嗯。不用担心。"}, {"type": "subtitle", "time": 12931.429, "timestamp": "03:35:31", "text": "没关系。聊天室里的人已经习惯了。"}, {"type": "subtitle", "time": 12934.87, "timestamp": "03:35:34", "text": "这就是他们付费上网的目的。"}, {"type": "subtitle", "time": 12937.99, "timestamp": "03:35:37", "text": "不用担心。是的。真是太奇怪了"}, {"type": "subtitle", "time": 12940.469, "timestamp": "03:35:40", "text": "不过，你是如何添加搜索和音频功能的？"}, {"type": "subtitle", "time": 12943.429, "timestamp": "03:35:43", "text": "捕捉节目，但它甚至都没显示出来。"}, {"type": "subtitle", "time": 12945.75, "timestamp": "03:35:45", "text": "在音频混音器上调高音量。那真是"}, {"type": "subtitle", "time": 12948.229, "timestamp": "03:35:48", "text": "可疑的。"}, {"type": "subtitle", "time": 12952.469, "timestamp": "03:35:52", "text": "我不。你的OBS更新了吗？"}, {"type": "subtitle", "time": 12954.309, "timestamp": "03:35:54", "text": "是的。是的。通常就像每当它"}, {"type": "subtitle", "time": 12956.87, "timestamp": "03:35:56", "text": "给我显示更新内容，我就照做。是什么"}]
[{"type": "subtitle", "time": 19747.83, "timestamp": "05:29:07", "text": "是的。然后，条纹图案被邀请了。"}, {"type": "subtitle", "time": 19749.91, "timestamp": "05:29:09", "text": "条纹是另一种类型"}, {"type": "subtitle", "time": 19752.47, "timestamp": "05:29:12", "text": "头痛。所以"}, {"type": "subtitle", "time": 19756.948, "timestamp": "05:29:16", "text": "我有点喜欢，嗯，我看到了，好吧。"}, {"type": "subtitle", "time": 19758.708, "timestamp": "05:29:18", "text": "它有一些不错的特点，但同时"}, {"type": "subtitle", "time": 19761.03, "timestamp": "05:29:21", "text": "转移需要很长时间"}, {"type": "subtitle", "time": 19764.15, "timestamp": "05:29:24", "text": "钱。啊"}, {"type": "subtitle", "time": 19767.91, "timestamp": "05:29:27", "text": "因为嗯，每当我收到呃"}, {"type": "subtitle", "time": 19772.15, "timestamp": "05:29:32", "text": "手机付款"}, {"type": "subtitle", "time": 19774.15, "timestamp": "05:29:34", "text": "因为印度没有像"}, {"type": "subtitle", "time": 19776.39, "timestamp": "05:29:36", "text": "自动的那个，我们会在那里"}, {"type": "subtitle", "time": 19777.67, "timestamp": "05:29:37", "text": "直接收到我们收到的礼物"}, {"type": "subtitle", "time": 19780.948, "timestamp": "05:29:40", "text": "支付。啊，对对对对。"}, {"type": "subtitle", "time": 19788.23, "timestamp": "05:29:48", "text": "是的，我收到了，我当时就想，我收到了"}, {"type": "subtitle", "time": 19791.19, "timestamp": "05:29:51", "text": "付款已经完成，然后我就没收到款项了。"}, {"type": "subtitle", "time": 19794.31, "timestamp": "05:29:54", "text": "收到付款，比如……我"}, {"type": "subtitle", "time": 19795.83, "timestamp": "05:29:55", "text": "我想应该不止一个星期了，而且"}, {"type": "subtitle", "time": 19798.788, "timestamp": "05:29:58", "text": "开始恐慌"}]
[{"type": "subtitle", "time": 17823.27, "timestamp": "04:57:03", "text": "像这样。就像我一样，呃……"}, {"type": "subtitle", "time": 17825.75, "timestamp": "04:57:05", "text": "应该是他们的第一个孩子，VTuber"}, {"type": "subtitle", "time": 17829.43, "timestamp": "04:57:09", "text": "孩子，因为他们主要从事插画工作。"}, {"type": "subtitle", "time": 17831.83, "timestamp": "04:57:11", "text": "比如给那些更知名的创作者等等。"}, {"type": "subtitle", "time": 17834.47, "timestamp": "04:57:14", "text": "我将成为他们的第一个虚拟主播子女。"}, {"type": "subtitle", "time": 17836.15, "timestamp": "04:57:16", "text": "他们之所以收取佣金，是因为"}, {"type": "subtitle", "time": 17837.67, "timestamp": "04:57:17", "text": "他们说他们有这方面的经验"}, {"type": "subtitle", "time": 17842.628, "timestamp": "04:57:22", "text": "虚拟主播模特，凡人艺术。所以，但是他们"}, {"type": "subtitle", "time": 17844.948, "timestamp": "04:57:24", "text": "他们尽力了"}, {"type": "subtitle", "time": 17848.788, "timestamp": "04:57:28", "text": "做那个模特，她非常漂亮，"}, {"type": "subtitle", "time": 17851.59, "timestamp": "04:57:31", "text": "凯，一切都那么美好优雅。"}, {"type": "subtitle", "time": 17855.99, "timestamp": "04:57:35", "text": "我非常喜欢它，但这样做会很失礼。呃"}, {"type": "subtitle", "time": 17857.91, "timestamp": "04:57:37", "text": "你完成了委托，尽管"}, {"type": "subtitle", "time": 17860.708, "timestamp": "04:57:40", "text": "尽管有严格的截止日期，"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "他们没能按时完成任务，因为"}, {"type": "subtitle", "time": 17864.708, "timestamp": "04:57:44", "text": "其他委员会以及他们的一切"}, {"type": "subtitle", "time": 17867.67, "timestamp": "04:57:47", "text": "他们仍然尽力而为，并提供了服务。"}, {"type": "subtitle", "time": 17869.83, "timestamp": "04:57:49", "text": "把它完成并发送出去"}, {"type": "subtitle", "time": 17873.11, "timestamp": "04:57:53", "text": "对，已经过去八九个月了。"}, {"type": "subtitle", "time": 17876.23, "timestamp": "04:57:56", "text": "几个月过去了，他们将会……"}, {"type": "subtitle", "time": 17878.23, "timestamp": "04:57:58", "text": "现在想知道发生了什么事"}]
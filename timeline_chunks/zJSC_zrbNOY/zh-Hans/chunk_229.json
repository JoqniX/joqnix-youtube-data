[{"type": "subtitle", "time": 13743.269, "timestamp": "03:49:03", "text": "是的。那很好。"}, {"type": "subtitle", "time": 13745.429, "timestamp": "03:49:05", "text": "她很棒。"}, {"type": "subtitle", "time": 13748.07, "timestamp": "03:49:08", "text": "确实如此，因为呃，我的意思是，我必须……"}, {"type": "subtitle", "time": 13750.309, "timestamp": "03:49:10", "text": "我也很感谢我的朋友们，因为他们"}, {"type": "subtitle", "time": 13752.229, "timestamp": "03:49:12", "text": "我们也对此非常支持，因为"}, {"type": "subtitle", "time": 13755.11, "timestamp": "03:49:15", "text": "我记得当时我害怕得不敢按下按钮。"}, {"type": "subtitle", "time": 13758.55, "timestamp": "03:49:18", "text": "那个开始播放按钮。"}, {"type": "subtitle", "time": 13761.51, "timestamp": "03:49:21", "text": "我的鼠标就放在上面，"}, {"type": "subtitle", "time": 13764.229, "timestamp": "03:49:24", "text": "我当时就感觉……嗯，手离……很近。"}, {"type": "subtitle", "time": 13771.269, "timestamp": "03:49:31", "text": "而我哥哥毕竟是哥哥，他只是"}, {"type": "subtitle", "time": 13772.63, "timestamp": "03:49:32", "text": "他走过来，然后说：“你是做什么的？”"}, {"type": "subtitle", "time": 13774.469, "timestamp": "03:49:34", "text": "在干嘛？” 我心想，“呃，在想……”"}, {"type": "subtitle", "time": 13776.229, "timestamp": "03:49:36", "text": "直播的时候，他就有点像这样"}, {"type": "subtitle", "time": 13777.75, "timestamp": "03:49:37", "text": "他点击按钮，然后走开了。"}, {"type": "subtitle", "time": 13780.15, "timestamp": "03:49:40", "text": "然后我开始直播，我就想，"}, {"type": "subtitle", "time": 13784.95, "timestamp": "03:49:44", "text": "“好了，看来我们现在正式直播了。”"}, {"type": "subtitle", "time": 13788.309, "timestamp": "03:49:48", "text": "我的天哪，真不错。"}, {"type": "subtitle", "time": 13795.03, "timestamp": "03:49:55", "text": "现在有个人在身边真是太好了，嗯……"}, {"type": "subtitle", "time": 13799.429, "timestamp": "03:49:59", "text": "嗯……呃……你知道……该怎么说来着？"}]
[{"type": "subtitle", "time": 3605.19, "timestamp": "01:00:05", "text": "我洗了个澡，希望能重置一下我的状态。"}, {"type": "subtitle", "time": 3607.99, "timestamp": "01:00:07", "text": "全身都湿透了，我现在坐在椅子上。"}, {"type": "subtitle", "time": 3612.47, "timestamp": "01:00:12", "text": "又一次，我感觉精疲力竭。"}, {"type": "subtitle", "time": 3618.549, "timestamp": "01:00:18", "text": "精疲力竭，我心想：哇"}, {"type": "subtitle", "time": 3621.2, "timestamp": "01:00:21", "text": "哇 哇"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "我每秒钟都在打哈欠。"}, {"type": "subtitle", "time": 3640.549, "timestamp": "01:00:40", "text": "连坐都坐不稳。懒散地"}, {"type": "subtitle", "time": 3642.789, "timestamp": "01:00:42", "text": "椅子。"}, {"type": "subtitle", "time": 3646.789, "timestamp": "01:00:46", "text": "差点掉下去了。"}, {"type": "subtitle", "time": 3649.19, "timestamp": "01:00:49", "text": "现在是6点30分。我有30分钟"}, {"type": "subtitle", "time": 3651.75, "timestamp": "01:00:51", "text": "左边。"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "我还没玩过推特。到过"}, {"type": "subtitle", "time": 3656.87, "timestamp": "01:00:56", "text": "在推特上拖延时间"}]
[{"type": "subtitle", "time": 15720.79, "timestamp": "04:22:00", "text": "是啊，那件事挺奇怪的。其他怪事"}, {"type": "subtitle", "time": 15722.87, "timestamp": "04:22:02", "text": "我所经历的互动大概就像这样"}, {"type": "subtitle", "time": 15724.55, "timestamp": "04:22:04", "text": "存在"}, {"type": "subtitle", "time": 15727.349, "timestamp": "04:22:07", "text": "呃，不，我猜那个就是那个。"}, {"type": "subtitle", "time": 15730.389, "timestamp": "04:22:10", "text": "那件事最让我恐慌。但是呃"}, {"type": "subtitle", "time": 15733.51, "timestamp": "04:22:13", "text": "幸好我有我的模组和朋友。"}, {"type": "subtitle", "time": 15736.79, "timestamp": "04:22:16", "text": "呃，当时在聊天室里。做过"}, {"type": "subtitle", "time": 15740.95, "timestamp": "04:22:20", "text": "甘地也遵循这个原则吗？嗯，我不知道"}, {"type": "subtitle", "time": 15743.67, "timestamp": "04:22:23", "text": "鲁德拉。我只记得当时有"}, {"type": "subtitle", "time": 15745.83, "timestamp": "04:22:25", "text": "许多自由战士。有"}, {"type": "subtitle", "time": 15749.99, "timestamp": "04:22:29", "text": "拉妮·拉克什米也在里面。哇。"}, {"type": "subtitle", "time": 15763.349, "timestamp": "04:22:43", "text": "我不知道该说什么。哇！"}, {"type": "subtitle", "time": 15767.67, "timestamp": "04:22:47", "text": "呃，突袭板会是这样，就是这样。"}, {"type": "subtitle", "time": 15770.87, "timestamp": "04:22:50", "text": "比如，呃，随机的新账号垃圾邮件"}, {"type": "subtitle", "time": 15773.99, "timestamp": "04:22:53", "text": "你的聊天记录、点赞、关注和垃圾信息"}, {"type": "subtitle", "time": 15776.309, "timestamp": "04:22:56", "text": "诸如此类，对吧？"}, {"type": "subtitle", "time": 15778.95, "timestamp": "04:22:58", "text": "是的。我的意思是，就像一次关注一样。"}]
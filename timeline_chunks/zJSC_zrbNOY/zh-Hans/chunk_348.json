[{"type": "subtitle", "time": 20882.708, "timestamp": "05:48:02", "text": "课程正在进行中。我的考试是"}, {"type": "subtitle", "time": 20886.948, "timestamp": "05:48:06", "text": "就像我做 ODL IGNU 一样。所以我会这么做。"}, {"type": "subtitle", "time": 20890.708, "timestamp": "05:48:10", "text": "IGNU 呃，大学，所以是英语文学"}, {"type": "subtitle", "time": 20893.83, "timestamp": "05:48:13", "text": "荣誉。所以当时发生了这件事。然后"}, {"type": "subtitle", "time": 20897.35, "timestamp": "05:48:17", "text": "我得去日本那边看看。"}, {"type": "subtitle", "time": 20899.27, "timestamp": "05:48:19", "text": "我正在进行我的 Jokathon 直播，"}, {"type": "subtitle", "time": 20901.75, "timestamp": "05:48:21", "text": "一切以及很多事情都是"}, {"type": "subtitle", "time": 20903.59, "timestamp": "05:48:23", "text": "那里。所以我就想，所以他就那样说"}, {"type": "subtitle", "time": 20905.91, "timestamp": "05:48:25", "text": "担心自己能不能应付五个"}, {"type": "subtitle", "time": 20908.868, "timestamp": "05:48:28", "text": "所有事情都是我一个人做的吗？太多了"}, {"type": "subtitle", "time": 20912.628, "timestamp": "05:48:32", "text": "现在。于是我成功说服了对方。对你来说难以承受"}, {"type": "subtitle", "time": 20915.51, "timestamp": "05:48:35", "text": "也一样。是的。我说服了"}, {"type": "subtitle", "time": 20919.75, "timestamp": "05:48:39", "text": "说服我，他允许了，他还问了"}, {"type": "subtitle", "time": 20923.11, "timestamp": "05:48:43", "text": "就像他会为此说话一样"}, {"type": "subtitle", "time": 20925.91, "timestamp": "05:48:45", "text": "和他的朋友们一起确认这是否是"}, {"type": "subtitle", "time": 20928.548, "timestamp": "05:48:48", "text": "不管是好事还是坏事，他才会……"}, {"type": "subtitle", "time": 20930.788, "timestamp": "05:48:50", "text": "就像是“是的，你可以那样做”"}, {"type": "subtitle", "time": 20935.35, "timestamp": "05:48:55", "text": "事物。所以，是的，嗯，最后我终于得到了"}, {"type": "subtitle", "time": 20937.35, "timestamp": "05:48:57", "text": "那个东西，然后我就说，“是啊，我愿意。”"}]
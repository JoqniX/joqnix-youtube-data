[{"type": "subtitle", "time": 14221.83, "timestamp": "03:57:01", "text": "那些TFS机器人，我的天哪，它们"}, {"type": "subtitle", "time": 14226.389, "timestamp": "03:57:06", "text": "那方面我也进展顺利了。啊，我想我的"}, {"type": "subtitle", "time": 14228.469, "timestamp": "03:57:08", "text": "OBS还有另一个问题，因为它没有……"}, {"type": "subtitle", "time": 14230.87, "timestamp": "03:57:10", "text": "给我发送突袭警报。"}, {"type": "subtitle", "time": 14234.55, "timestamp": "03:57:14", "text": "哦，不。哦，不。非常感谢！"}, {"type": "subtitle", "time": 14238.07, "timestamp": "03:57:18", "text": "红色的。欢迎光临。"}, {"type": "subtitle", "time": 14264.95, "timestamp": "03:57:44", "text": "是啊，GFX移植真是太麻烦了。"}, {"type": "subtitle", "time": 14268.07, "timestamp": "03:57:48", "text": "我只听到了一个很小的警报。"}, {"type": "subtitle", "time": 14270.469, "timestamp": "03:57:50", "text": "第二。"}, {"type": "subtitle", "time": 14273.03, "timestamp": "03:57:53", "text": "你用的是哪一个？你不用……"}, {"type": "subtitle", "time": 14276.79, "timestamp": "03:57:56", "text": "抽搐？不，不，不，不。我使用"}]
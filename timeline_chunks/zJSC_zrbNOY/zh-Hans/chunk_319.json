[{"type": "subtitle", "time": 19141.83, "timestamp": "05:19:01", "text": "表情符号，然后你就可以兑换了。所以就像"}, {"type": "subtitle", "time": 19145.75, "timestamp": "05:19:05", "text": "好玩的事情很多。是的。"}, {"type": "subtitle", "time": 19147.99, "timestamp": "05:19:07", "text": "真不错。"}, {"type": "subtitle", "time": 19151.67, "timestamp": "05:19:11", "text": "我喜欢Twitch的聊天体验。"}, {"type": "subtitle", "time": 19154.31, "timestamp": "05:19:14", "text": "哪个？我想玩宾果游戏。"}, {"type": "subtitle", "time": 19157.75, "timestamp": "05:19:17", "text": "总有一天我会和你聊天。"}, {"type": "subtitle", "time": 19161.43, "timestamp": "05:19:21", "text": "宾果？我的天哪，那太好了。"}, {"type": "subtitle", "time": 19163.99, "timestamp": "05:19:23", "text": "事情是这样的，我有个想法，比如……"}, {"type": "subtitle", "time": 19166.47, "timestamp": "05:19:26", "text": "呃，我以前帮朋友做过mod……"}, {"type": "subtitle", "time": 19169.19, "timestamp": "05:19:29", "text": "矿。所以，这个想法基本上是这样的："}, {"type": "subtitle", "time": 19171.59, "timestamp": "05:19:31", "text": "只会给他们空白的宾果游戏卡。"}, {"type": "subtitle", "time": 19173.67, "timestamp": "05:19:33", "text": "他们可以把它装满我愿意的东西"}, {"type": "subtitle", "time": 19177.27, "timestamp": "05:19:37", "text": "可能会在直播中说或做。"}, {"type": "subtitle", "time": 19180.47, "timestamp": "05:19:40", "text": "他们只要勾选一下就可以了，嗯，一旦我"}, {"type": "subtitle", "time": 19183.51, "timestamp": "05:19:43", "text": "去做"}, {"type": "subtitle", "time": 19185.43, "timestamp": "05:19:45", "text": "我只想保留"}, {"type": "subtitle", "time": 19188.948, "timestamp": "05:19:48", "text": "规则是他们可以骗我。"}, {"type": "subtitle", "time": 19192.628, "timestamp": "05:19:52", "text": "也这样做。嗯。所以那将会是"}, {"type": "subtitle", "time": 19194.39, "timestamp": "05:19:54", "text": "他们觉得很有趣。但我可能还是会保留"}]
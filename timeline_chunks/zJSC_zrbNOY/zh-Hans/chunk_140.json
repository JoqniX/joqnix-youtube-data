[{"type": "subtitle", "time": 8413.95, "timestamp": "02:20:13", "text": "但是，呃，"}, {"type": "subtitle", "time": 8416.23, "timestamp": "02:20:16", "text": "[音乐]"}, {"type": "subtitle", "time": 8419.27, "timestamp": "02:20:19", "text": "你们觉得怎么样？"}, {"type": "subtitle", "time": 8421.19, "timestamp": "02:20:21", "text": "现在正在看的人，我是"}, {"type": "subtitle", "time": 8427.349, "timestamp": "02:20:27", "text": "你会用什么东西？"}, {"type": "subtitle", "time": 8430.63, "timestamp": "02:20:30", "text": "为了提升你的频道等等，即使"}, {"type": "subtitle", "time": 8434.15, "timestamp": "02:20:34", "text": "如果它承诺，如果它说它是天然的"}, {"type": "subtitle", "time": 8437.11, "timestamp": "02:20:37", "text": "有机的也好，其他什么都行。或者会"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "你会尽量避免做这类事情。"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "就"}, {"type": "subtitle", "time": 8445.11, "timestamp": "02:20:45", "text": "自然而然地、有机地去做"}, {"type": "subtitle", "time": 8449.27, "timestamp": "02:20:49", "text": "按你自己的节奏来？"}]
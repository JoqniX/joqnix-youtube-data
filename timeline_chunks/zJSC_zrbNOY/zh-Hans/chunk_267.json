[{"type": "subtitle", "time": 16021.429, "timestamp": "04:27:01", "text": "除非嘉宾也在场，否则观众不会在场。"}, {"type": "subtitle", "time": 16023.51, "timestamp": "04:27:03", "text": "没问题。他们对此感到自在"}, {"type": "subtitle", "time": 16028.229, "timestamp": "04:27:08", "text": "随机加入的人，还有这个"}, {"type": "subtitle", "time": 16032.63, "timestamp": "04:27:12", "text": "一位随机观众加入了进来。"}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": "嗯，我当时就想，哦，他们……聊天"}, {"type": "subtitle", "time": 16038.63, "timestamp": "04:27:18", "text": "他们大部分时间都在聊天，然后过来我的房间。"}, {"type": "subtitle", "time": 16040.63, "timestamp": "04:27:20", "text": "流媒体也是如此。所以他们会尊重你。"}, {"type": "subtitle", "time": 16043.11, "timestamp": "04:27:23", "text": "喜欢遵守我的规则的东西"}, {"type": "subtitle", "time": 16045.03, "timestamp": "04:27:25", "text": "一切。我还提到过这一点。"}, {"type": "subtitle", "time": 16048.389, "timestamp": "04:27:28", "text": "在让他们进来之前，他们就加入了。"}, {"type": "subtitle", "time": 16051.189, "timestamp": "04:27:31", "text": "进去之后我们就玩了，我不知道是什么"}, {"type": "subtitle", "time": 16054.95, "timestamp": "04:27:34", "text": "那家伙就遭遇了这种事。呃，那算糟糕吗？"}, {"type": "subtitle", "time": 16057.59, "timestamp": "04:27:37", "text": "是白天还是什么事？他真的"}, {"type": "subtitle", "time": 16061.75, "timestamp": "04:27:41", "text": "真的就说了，是啊，这很糟糕，而且"}, {"type": "subtitle", "time": 16065.269, "timestamp": "04:27:45", "text": "那。说了那么多侮辱性的话，那么多"}, {"type": "subtitle", "time": 16068.469, "timestamp": "04:27:48", "text": "事物。我一开始并没有意识到这一点。"}, {"type": "subtitle", "time": 16071.349, "timestamp": "04:27:51", "text": "因为这有点像间接的方式。我"}, {"type": "subtitle", "time": 16074.309, "timestamp": "04:27:54", "text": "我觉得客人注意到了。而且由于"}, {"type": "subtitle", "time": 16076.07, "timestamp": "04:27:56", "text": "客人"}, {"type": "subtitle", "time": 16077.91, "timestamp": "04:27:57", "text": "我注意到自己什么也没做，"}]
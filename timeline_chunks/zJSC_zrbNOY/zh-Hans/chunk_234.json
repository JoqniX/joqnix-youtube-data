[{"type": "subtitle", "time": 14041.67, "timestamp": "03:54:01", "text": "相互作用。所以你就表示“是啊”。"}, {"type": "subtitle", "time": 14045.83, "timestamp": "03:54:05", "text": "嗯。请在此处互动。我会关注。"}, {"type": "subtitle", "time": 14047.91, "timestamp": "03:54:07", "text": "但互粉真的很常见"}, {"type": "subtitle", "time": 14049.83, "timestamp": "03:54:09", "text": "就像以前那样。我们真的没有"}, {"type": "subtitle", "time": 14052.469, "timestamp": "03:54:12", "text": "现在就能看到前面的内容了。"}, {"type": "subtitle", "time": 14054.469, "timestamp": "03:54:14", "text": "最恐怖的是那些图像"}, {"type": "subtitle", "time": 14058.309, "timestamp": "03:54:18", "text": "设计师。对我来说，呃，现在感觉就像"}, {"type": "subtitle", "time": 14061.269, "timestamp": "03:54:21", "text": "呃，就像在我们做完之前……"}, {"type": "subtitle", "time": 14064.87, "timestamp": "03:54:24", "text": "直播合作。呃，我看到了一条私信"}, {"type": "subtitle", "time": 14068.79, "timestamp": "03:54:28", "text": "来自一位大创作者，我认为他们"}, {"type": "subtitle", "time": 14070.63, "timestamp": "03:54:30", "text": "就像Twitch上的合作伙伴之类的。"}, {"type": "subtitle", "time": 14074.07, "timestamp": "03:54:34", "text": "或者喜欢，也可以踢。我当时就想：嗯？"}, {"type": "subtitle", "time": 14076.71, "timestamp": "03:54:36", "text": "为什么像他们这样的大牌创作者会……"}, {"type": "subtitle", "time": 14079.03, "timestamp": "03:54:39", "text": "我说，他们通过我来帮助我"}, {"type": "subtitle", "time": 14081.67, "timestamp": "03:54:41", "text": "叽叽喳喳。我和他们交谈越多，他们"}, {"type": "subtitle", "time": 14084.309, "timestamp": "03:54:44", "text": "他们会说：“是啊，呃，我用这个东西。”"}, {"type": "subtitle", "time": 14087.83, "timestamp": "03:54:47", "text": "我遇到了一个人，他们给了我"}, {"type": "subtitle", "time": 14091.03, "timestamp": "03:54:51", "text": "比如这种服务或工具"}, {"type": "subtitle", "time": 14093.83, "timestamp": "03:54:53", "text": "比如获得更多粉丝或自然增长"}, {"type": "subtitle", "time": 14097.75, "timestamp": "03:54:57", "text": "就是那个东西，对吧？”然后我就想，“嘿，为什么？”"}, {"type": "subtitle", "time": 14099.99, "timestamp": "03:54:59", "text": "你会那样做吗？"}]
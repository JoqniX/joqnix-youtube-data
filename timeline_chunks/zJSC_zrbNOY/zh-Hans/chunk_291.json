[{"type": "subtitle", "time": 17463.35, "timestamp": "04:51:03", "text": "星座、星星和太空"}, {"type": "subtitle", "time": 17467.27, "timestamp": "04:51:07", "text": "另一个嘛，她也是一名 YouTuber。"}, {"type": "subtitle", "time": 17470.47, "timestamp": "04:51:10", "text": "她是一位来自波拉斯的企业 YouTuber，"}, {"type": "subtitle", "time": 17473.11, "timestamp": "04:51:13", "text": "她毕业了。是的，她的名字是"}, {"type": "subtitle", "time": 17477.67, "timestamp": "04:51:17", "text": "祖奇·阿泽尔。所以Zuchi，她呃画了"}, {"type": "subtitle", "time": 17481.19, "timestamp": "04:51:21", "text": "角色，而且她看起来也很漂亮"}, {"type": "subtitle", "time": 17484.23, "timestamp": "04:51:24", "text": "每一个关于我的一切，比如如何"}, {"type": "subtitle", "time": 17487.75, "timestamp": "04:51:27", "text": "我呃，就像她选择了柔和的风格。"}, {"type": "subtitle", "time": 17491.11, "timestamp": "04:51:31", "text": "调色板，嗯，呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 17495.43, "timestamp": "04:51:35", "text": "它？呃，我忘了名字了。我的天哪。"}, {"type": "subtitle", "time": 17498.628, "timestamp": "04:51:38", "text": "颜色采用柔和的粉彩色调。"}, {"type": "subtitle", "time": 17501.83, "timestamp": "04:51:41", "text": "一切。是的，就是这样。"}, {"type": "subtitle", "time": 17505.51, "timestamp": "04:51:45", "text": "模型"}, {"type": "subtitle", "time": 17508.31, "timestamp": "04:51:48", "text": "运动健将好像有某种设计或者像"}, {"type": "subtitle", "time": 17511.59, "timestamp": "04:51:51", "text": "从那时起，就一直保持着这个角色形象。进而"}, {"type": "subtitle", "time": 17515.91, "timestamp": "04:51:55", "text": "后来我收到了一张粉丝艺术作品，嗯……"}, {"type": "subtitle", "time": 17518.788, "timestamp": "04:51:58", "text": "真的很漂亮，而且东西也很多"}]
[{"type": "subtitle", "time": 20940.708, "timestamp": "05:49:00", "text": "我不想为此收你的钱。患病的"}, {"type": "subtitle", "time": 20943.35, "timestamp": "05:49:03", "text": "我做这个是为了兼职之类的。"}, {"type": "subtitle", "time": 20945.83, "timestamp": "05:49:05", "text": "我就是这样付的款。我说"}, {"type": "subtitle", "time": 20949.75, "timestamp": "05:49:09", "text": "比如，“是的，我……我得到20"}, {"type": "subtitle", "time": 20952.23, "timestamp": "05:49:12", "text": "兼职。所以我就付钱吧"}, {"type": "subtitle", "time": 20955.27, "timestamp": "05:49:15", "text": "分期付款金额大概是 16.4 之类的。"}, {"type": "subtitle", "time": 20957.67, "timestamp": "05:49:17", "text": "所以我只答对了一小部分。"}, {"type": "subtitle", "time": 20960.708, "timestamp": "05:49:20", "text": "那。我支付所需的订阅费用。"}, {"type": "subtitle", "time": 20963.43, "timestamp": "05:49:23", "text": "为了直播等等，还有类似的东西"}, {"type": "subtitle", "time": 20968.23, "timestamp": "05:49:28", "text": "照做。是的，事情就是这样。"}, {"type": "subtitle", "time": 20970.39, "timestamp": "05:49:30", "text": "我的天哪，就在那时……"}, {"type": "subtitle", "time": 20975.43, "timestamp": "05:49:35", "text": "意识到外面的人就像人一样"}, {"type": "subtitle", "time": 20978.23, "timestamp": "05:49:38", "text": "做了很多事，但我不知道该做什么"}, {"type": "subtitle", "time": 20987.75, "timestamp": "05:49:47", "text": "我想这就像上了一堂课，我明白了。"}, {"type": "subtitle", "time": 20990.15, "timestamp": "05:49:50", "text": "那里很难。"}, {"type": "subtitle", "time": 20996.23, "timestamp": "05:49:56", "text": "那很好，一切都很好。那很好。"}, {"type": "subtitle", "time": 20999.51, "timestamp": "05:49:59", "text": "不太好，但确实，就像……"}]
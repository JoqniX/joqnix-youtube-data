[{"type": "subtitle", "time": 18000.788, "timestamp": "05:00:00", "text": "非常昂贵。我，我的意思是，我只是……"}, {"type": "subtitle", "time": 18003.99, "timestamp": "05:00:03", "text": "像昨天那样寻找合适的模型"}, {"type": "subtitle", "time": 18007.59, "timestamp": "05:00:07", "text": "我看了价格，然后就惊呆了。"}, {"type": "subtitle", "time": 18014.15, "timestamp": "05:00:14", "text": "天色已黑。"}, {"type": "subtitle", "time": 18017.43, "timestamp": "05:00:17", "text": "是的。就像 V 一样，就像绑定一样。"}, {"type": "subtitle", "time": 18022.47, "timestamp": "05:00:22", "text": "比如，基本最低金额是 2000 美元。比如什么？"}, {"type": "subtitle", "time": 18027.67, "timestamp": "05:00:27", "text": "不。而且这么多漂亮女孩子，我的意思是，如果"}, {"type": "subtitle", "time": 18029.75, "timestamp": "05:00:29", "text": "你也想把艺术作品完成，"}, {"type": "subtitle", "time": 18032.868, "timestamp": "05:00:32", "text": "你想制作"}, {"type": "subtitle", "time": 18036.31, "timestamp": "05:00:36", "text": "完全按照您的意愿定制，它"}, {"type": "subtitle", "time": 18038.15, "timestamp": "05:00:38", "text": "费用会变得非常高。我记得就像"}, {"type": "subtitle", "time": 18042.31, "timestamp": "05:00:42", "text": "其中一位艺术家，我当时就想，我见过他。"}, {"type": "subtitle", "time": 18044.15, "timestamp": "05:00:44", "text": "感觉它们像是很可爱的艺术品。"}, {"type": "subtitle", "time": 18046.47, "timestamp": "05:00:46", "text": "东西，感觉就像它们会是"}, {"type": "subtitle", "time": 18049.27, "timestamp": "05:00:49", "text": "能够完美展现我的模特风格"}, {"type": "subtitle", "time": 18050.948, "timestamp": "05:00:50", "text": "我查了一下价格，这是"}, {"type": "subtitle", "time": 18053.51, "timestamp": "05:00:53", "text": "就像基础部分，呃，就像画一部分"}, {"type": "subtitle", "time": 18057.43, "timestamp": "05:00:57", "text": "大概就3万吧，我就想："}]
[{"type": "subtitle", "time": 21360.47, "timestamp": "05:56:00", "text": "习惯不低头就能画画"}, {"type": "subtitle", "time": 21361.91, "timestamp": "05:56:01", "text": "那。所以，因为一切都是"}, {"type": "subtitle", "time": 21363.43, "timestamp": "05:56:03", "text": "屏幕上正在发生什么，我必须"}, {"type": "subtitle", "time": 21365.91, "timestamp": "05:56:05", "text": "负责管理一切。屏幕"}, {"type": "subtitle", "time": 21369.91, "timestamp": "05:56:09", "text": "绘图板太贵了。我知道。"}, {"type": "subtitle", "time": 21373.59, "timestamp": "05:56:13", "text": "我买完之后，感觉就像……"}, {"type": "subtitle", "time": 21375.19, "timestamp": "05:56:15", "text": "图形方面，我感觉可能"}, {"type": "subtitle", "time": 21378.708, "timestamp": "05:56:18", "text": "我应该再等等，呃，就……"}, {"type": "subtitle", "time": 21382.15, "timestamp": "05:56:22", "text": "我攒钱买它，因为我当时正在……"}, {"type": "subtitle", "time": 21384.47, "timestamp": "05:56:24", "text": "还在努力适应这一切。"}, {"type": "subtitle", "time": 21388.47, "timestamp": "05:56:28", "text": "药片。但现在，我感觉，我"}, {"type": "subtitle", "time": 21391.51, "timestamp": "05:56:31", "text": "既然有了，不如就学学怎么做吧。"}, {"type": "subtitle", "time": 21393.83, "timestamp": "05:56:33", "text": "处理此事。"}, {"type": "subtitle", "time": 21399.03, "timestamp": "05:56:39", "text": "[音乐]"}, {"type": "subtitle", "time": 21402.47, "timestamp": "05:56:42", "text": "是的。太多事情了。另外，我是否保留"}, {"type": "subtitle", "time": 21404.47, "timestamp": "05:56:44", "text": "你待我太久了吗？比如，你怎么……"}, {"type": "subtitle", "time": 21407.11, "timestamp": "05:56:47", "text": "你通常直播多长时间？"}, {"type": "subtitle", "time": 21411.19, "timestamp": "05:56:51", "text": "嗯……那要看我是什么情况了。"}, {"type": "subtitle", "time": 21414.628, "timestamp": "05:56:54", "text": "正在做。感觉一切都还好。我"}, {"type": "subtitle", "time": 21417.83, "timestamp": "05:56:57", "text": "通常会持续直播更长时间，所以是"}]
[{"type": "subtitle", "time": 21540.47, "timestamp": "05:59:00", "text": "我不知何故激活了我对人的倾听"}, {"type": "subtitle", "time": 21543.03, "timestamp": "05:59:03", "text": "模式。所以我并不说话，而是倾听。"}, {"type": "subtitle", "time": 21546.07, "timestamp": "05:59:06", "text": "人们在说话。所以我这么做了。"}, {"type": "subtitle", "time": 21547.59, "timestamp": "05:59:07", "text": "不知不觉"}, {"type": "subtitle", "time": 21550.948, "timestamp": "05:59:10", "text": "然后我就想，是啊，听着呢。"}, {"type": "subtitle", "time": 21553.27, "timestamp": "05:59:13", "text": "她说的话以及她的回应方式。"}, {"type": "subtitle", "time": 21555.43, "timestamp": "05:59:15", "text": "我总是忘记，哦，我应该……"}, {"type": "subtitle", "time": 21558.15, "timestamp": "05:59:18", "text": "回应。好的。"}, {"type": "subtitle", "time": 21561.03, "timestamp": "05:59:21", "text": "就是这样。这可以理解。"}, {"type": "subtitle", "time": 21565.51, "timestamp": "05:59:25", "text": "慢慢地，慢慢地，嗯，那种恐惧"}, {"type": "subtitle", "time": 21569.35, "timestamp": "05:59:29", "text": "谈论和害怕，你知道，想要"}, {"type": "subtitle", "time": 21571.83, "timestamp": "05:59:31", "text": "认识人，就像我一直想做的那样"}, {"type": "subtitle", "time": 21575.19, "timestamp": "05:59:35", "text": "结识人之类的。我的天哪，我想"}, {"type": "subtitle", "time": 21577.67, "timestamp": "05:59:37", "text": "那就像是那方面的榜样。"}, {"type": "subtitle", "time": 21580.07, "timestamp": "05:59:40", "text": "我觉得是因为他就像每当他"}, {"type": "subtitle", "time": 21582.47, "timestamp": "05:59:42", "text": "去某个他不知道的地方，或者"}, {"type": "subtitle", "time": 21585.75, "timestamp": "05:59:45", "text": "像新的一样，但他完全是新的，他"}, {"type": "subtitle", "time": 21589.27, "timestamp": "05:59:49", "text": "很快就能和人们成为朋友"}, {"type": "subtitle", "time": 21593.03, "timestamp": "05:59:53", "text": "或者那里的人什么的，我就想，这怎么可能"}]
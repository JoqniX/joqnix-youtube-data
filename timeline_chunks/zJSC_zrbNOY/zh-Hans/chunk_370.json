[{"type": "subtitle", "time": 22201.27, "timestamp": "06:10:01", "text": "但我做过鱼咖喱，所以……"}, {"type": "subtitle", "time": 22204.07, "timestamp": "06:10:04", "text": "那里。鸡肉我可以很轻松地吃。"}, {"type": "subtitle", "time": 22207.51, "timestamp": "06:10:07", "text": "因为这样真的很难破坏。"}, {"type": "subtitle", "time": 22210.868, "timestamp": "06:10:10", "text": "鸡肉"}, {"type": "subtitle", "time": 22217.51, "timestamp": "06:10:17", "text": "现在种类繁多。"}, {"type": "subtitle", "time": 22220.47, "timestamp": "06:10:20", "text": "用玛萨拉粉做的鸡肉制品"}, {"type": "subtitle", "time": 22224.23, "timestamp": "06:10:24", "text": "东西。我知道它们就像你可以制作的那种。"}, {"type": "subtitle", "time": 22228.23, "timestamp": "06:10:28", "text": "简单的炖菜也能做出非常精致的玛萨拉风味。"}, {"type": "subtitle", "time": 22231.91, "timestamp": "06:10:31", "text": "不过我其实更喜欢少一点。"}, {"type": "subtitle", "time": 22235.03, "timestamp": "06:10:35", "text": "玛萨拉口味的有时候是这样的，因为它们就像……"}, {"type": "subtitle", "time": 22236.868, "timestamp": "06:10:36", "text": "对胃也比较温和，而且"}, {"type": "subtitle", "time": 22239.75, "timestamp": "06:10:39", "text": "嗯，就像我为每个人做的那样"}, {"type": "subtitle", "time": 22241.67, "timestamp": "06:10:41", "text": "家里也是。所以我必须小心谨慎。"}, {"type": "subtitle", "time": 22244.39, "timestamp": "06:10:44", "text": "以及他们的饮食限制"}, {"type": "subtitle", "time": 22247.43, "timestamp": "06:10:47", "text": "因为我家不吃那个。"}, {"type": "subtitle", "time": 22250.868, "timestamp": "06:10:50", "text": "很多辛辣食物。"}, {"type": "subtitle", "time": 22253.91, "timestamp": "06:10:53", "text": "所以我吃得很少，真的很少。"}, {"type": "subtitle", "time": 22255.75, "timestamp": "06:10:55", "text": "对他们来说很辣，而我只是继续……"}, {"type": "subtitle", "time": 22257.75, "timestamp": "06:10:57", "text": "给自己弄点青辣椒之类的。"}]
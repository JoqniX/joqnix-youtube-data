[{"type": "subtitle", "time": 18541.51, "timestamp": "05:09:01", "text": "等级。喜欢"}, {"type": "subtitle", "time": 18551.11, "timestamp": "05:09:11", "text": "我已经干了快两年了，而且"}, {"type": "subtitle", "time": 18553.67, "timestamp": "05:09:13", "text": "没有也没关系。我的意思是，那是"}, {"type": "subtitle", "time": 18556.07, "timestamp": "05:09:16", "text": "那个东西。我觉得没有像"}, {"type": "subtitle", "time": 18558.15, "timestamp": "05:09:18", "text": "嗯"}, {"type": "subtitle", "time": 18559.75, "timestamp": "05:09:19", "text": "你必须遵守以下规定："}, {"type": "subtitle", "time": 18562.628, "timestamp": "05:09:22", "text": "一些具体的事情，但有点像……"}, {"type": "subtitle", "time": 18565.75, "timestamp": "05:09:25", "text": "对我来说，就好像我想那样做一样。"}, {"type": "subtitle", "time": 18568.868, "timestamp": "05:09:28", "text": "你们。它就像是更少的钱，就像我"}, {"type": "subtitle", "time": 18571.19, "timestamp": "05:09:31", "text": "想做到完美。"}, {"type": "subtitle", "time": 18573.03, "timestamp": "05:09:33", "text": "更像是我想给你的那种感觉"}, {"type": "subtitle", "time": 18575.99, "timestamp": "05:09:35", "text": "这里提供的是完美的体验。喜欢"}, {"type": "subtitle", "time": 18579.27, "timestamp": "05:09:39", "text": "我希望你们像喜欢我一样喜欢我"}, {"type": "subtitle", "time": 18581.35, "timestamp": "05:09:41", "text": "内容方面也是如此。但与此同时，我"}, {"type": "subtitle", "time": 18582.628, "timestamp": "05:09:42", "text": "希望你们都漂亮"}, {"type": "subtitle", "time": 18587.19, "timestamp": "05:09:47", "text": "背景和漂亮的景物。"}, {"type": "subtitle", "time": 18590.628, "timestamp": "05:09:50", "text": "我们就是这么做的。你在哪里？"}, {"type": "subtitle", "time": 18594.39, "timestamp": "05:09:54", "text": "我们只是在闲聊。哦，我只是觉得"}, {"type": "subtitle", "time": 18598.23, "timestamp": "05:09:58", "text": "这是我第一次不，这真是我的天哪！"}]
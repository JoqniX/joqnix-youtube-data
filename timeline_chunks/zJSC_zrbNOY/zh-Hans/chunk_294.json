[{"type": "subtitle", "time": 17640.948, "timestamp": "04:54:00", "text": "比如为了正当的理由。不，"}, {"type": "subtitle", "time": 17644.788, "timestamp": "04:54:04", "text": "那比你自己的情况好得多。和"}, {"type": "subtitle", "time": 17648.55, "timestamp": "04:54:08", "text": "情况就像是，呃，我可以问我的我"}, {"type": "subtitle", "time": 17651.67, "timestamp": "04:54:11", "text": "没法问我家人，因为这事儿太大了。"}, {"type": "subtitle", "time": 17655.35, "timestamp": "04:54:15", "text": "家人和家人都在尽力而为"}, {"type": "subtitle", "time": 17658.708, "timestamp": "04:54:18", "text": "比如送我去日本。嗯"}, {"type": "subtitle", "time": 17662.708, "timestamp": "04:54:22", "text": "然后我就想，呃，我有一个"}, {"type": "subtitle", "time": 17666.708, "timestamp": "04:54:26", "text": "可以选择忘记它，或者喜欢它。"}, {"type": "subtitle", "time": 17669.27, "timestamp": "04:54:29", "text": "无论何时，等待6年或4年。"}, {"type": "subtitle", "time": 17671.99, "timestamp": "04:54:31", "text": "他们回来后重新启动了那东西。"}, {"type": "subtitle", "time": 17674.15, "timestamp": "04:54:34", "text": "他们正在履行对我的承诺，"}, {"type": "subtitle", "time": 17677.43, "timestamp": "04:54:37", "text": "随着人越来越多，一切都……"}, {"type": "subtitle", "time": 17679.91, "timestamp": "04:54:39", "text": "一切。如果一切顺利的话……"}, {"type": "subtitle", "time": 17682.788, "timestamp": "04:54:42", "text": "没关系，但我还是得像我以前那样。"}, {"type": "subtitle", "time": 17685.75, "timestamp": "04:54:45", "text": "承诺不会再有类似模型了。"}, {"type": "subtitle", "time": 17688.07, "timestamp": "04:54:48", "text": "我们会为你完成索具安装等工作，你"}, {"type": "subtitle", "time": 17690.07, "timestamp": "04:54:50", "text": "可以首发之类的，但那并没有"}, {"type": "subtitle", "time": 17693.43, "timestamp": "04:54:53", "text": "事情发生了，所以我就想，是啊，当……的时候"}, {"type": "subtitle", "time": 17697.11, "timestamp": "04:54:57", "text": "我当时就知道了其中的复杂之处。"}, {"type": "subtitle", "time": 17699.99, "timestamp": "04:54:59", "text": "当时那里正发生着什么事，但我却想："}]
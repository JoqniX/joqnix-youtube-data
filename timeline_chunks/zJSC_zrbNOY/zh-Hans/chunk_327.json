[{"type": "subtitle", "time": 19623.19, "timestamp": "05:27:03", "text": "关于王座，因为嗯，我记得我"}, {"type": "subtitle", "time": 19625.67, "timestamp": "05:27:05", "text": "首先，我设置了我的PayPal账户，我之前并不知道。"}, {"type": "subtitle", "time": 19628.39, "timestamp": "05:27:08", "text": "他们真的会发放"}, {"type": "subtitle", "time": 19630.708, "timestamp": "05:27:10", "text": "完整地址。"}, {"type": "subtitle", "time": 19634.31, "timestamp": "05:27:14", "text": "是的。你把那些商人都招进来了吗？"}, {"type": "subtitle", "time": 19637.51, "timestamp": "05:27:17", "text": "还是像往常一样？呃，那是在我之后"}, {"type": "subtitle", "time": 19639.27, "timestamp": "05:27:19", "text": "发现它会像这样释放出来"}, {"type": "subtitle", "time": 19641.83, "timestamp": "05:27:21", "text": "呃，如果我不保留的话，请提供完整地址"}, {"type": "subtitle", "time": 19646.39, "timestamp": "05:27:26", "text": "商业一。哦，是的，谢天谢地，第一个"}, {"type": "subtitle", "time": 19651.43, "timestamp": "05:27:31", "text": "呃，我跟那个人一起做了个委托……呃……"}, {"type": "subtitle", "time": 19653.83, "timestamp": "05:27:33", "text": "是谁？很棒的一餐。他们是"}, {"type": "subtitle", "time": 19656.548, "timestamp": "05:27:36", "text": "真棒。呃，我的意思是，但是我觉得"}, {"type": "subtitle", "time": 19659.35, "timestamp": "05:27:39", "text": "他们制作的大部分音频都不是"}, {"type": "subtitle", "time": 19663.67, "timestamp": "05:27:43", "text": "适合工作场合。所以我照做了，但是"}, {"type": "subtitle", "time": 19666.39, "timestamp": "05:27:46", "text": "他们很友善地告诉我了这件事。"}, {"type": "subtitle", "time": 19669.27, "timestamp": "05:27:49", "text": "我的PayPal账户好像出了问题。"}, {"type": "subtitle", "time": 19674.31, "timestamp": "05:27:54", "text": "我当时就说，太感谢你了。"}, {"type": "subtitle", "time": 19676.23, "timestamp": "05:27:56", "text": "哦，不。"}, {"type": "subtitle", "time": 19678.948, "timestamp": "05:27:58", "text": "我知道，但之后我把它改成了"}]
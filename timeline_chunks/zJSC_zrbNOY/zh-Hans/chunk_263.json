[{"type": "subtitle", "time": 15781.67, "timestamp": "04:23:01", "text": "而且是几条信息，因为就像"}, {"type": "subtitle", "time": 15783.51, "timestamp": "04:23:03", "text": "呃，我当时的第一反应是相当平静。"}, {"type": "subtitle", "time": 15786.389, "timestamp": "04:23:06", "text": "因为当时的情况，我对正在发生的事情感到困惑。"}, {"type": "subtitle", "time": 15788.07, "timestamp": "04:23:08", "text": "他们发来的一些信息。"}, {"type": "subtitle", "time": 15790.389, "timestamp": "04:23:10", "text": "旁边也一般会有人打招呼什么的"}, {"type": "subtitle", "time": 15794.07, "timestamp": "04:23:14", "text": "我当时真是百思不得其解，为什么……"}, {"type": "subtitle", "time": 15798.309, "timestamp": "04:23:18", "text": "bosi 在我的聊天室里打招呼"}, {"type": "subtitle", "time": 15806.63, "timestamp": "04:23:26", "text": "我的天啊。我当时只是有点困惑。"}, {"type": "subtitle", "time": 15809.67, "timestamp": "04:23:29", "text": "然后就好像，好吧，那就是B了，就像"}, {"type": "subtitle", "time": 15811.429, "timestamp": "04:23:31", "text": "我先开始，然后我的朋友也开始。"}, {"type": "subtitle", "time": 15815.11, "timestamp": "04:23:35", "text": "帮我解决这个问题。只是"}, {"type": "subtitle", "time": 15822.309, "timestamp": "04:23:42", "text": "当机器人在聊天中告诉我你的聊天"}, {"type": "subtitle", "time": 15824.309, "timestamp": "04:23:44", "text": "像幽灵一样，沉默不语。"}, {"type": "subtitle", "time": 15827.269, "timestamp": "04:23:47", "text": "还有其他一些东西。真是笑死我了。我知道。我"}, {"type": "subtitle", "time": 15829.75, "timestamp": "04:23:49", "text": "我看到很多机器人开始……"}, {"type": "subtitle", "time": 15831.91, "timestamp": "04:23:51", "text": "他们最近就是这样传递信息的"}, {"type": "subtitle", "time": 15834.63, "timestamp": "04:23:54", "text": "你的聊天记录好像一片寂静。"}, {"type": "subtitle", "time": 15837.67, "timestamp": "04:23:57", "text": "我的天啊。我当时就想，你不需要"}]
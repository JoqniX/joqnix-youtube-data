[{"type": "subtitle", "time": 21060.628, "timestamp": "05:51:00", "text": "我会帮助这样的人，而且我认为"}, {"type": "subtitle", "time": 21063.59, "timestamp": "05:51:03", "text": "我帮助过的人中，有一位是"}, {"type": "subtitle", "time": 21066.39, "timestamp": "05:51:06", "text": "他们就说，是啊，为什么不呢？"}, {"type": "subtitle", "time": 21069.35, "timestamp": "05:51:09", "text": "把它当作一份工作，那是我第一份工作。"}, {"type": "subtitle", "time": 21072.548, "timestamp": "05:51:12", "text": "我一生中每一次都像这样"}, {"type": "subtitle", "time": 21075.99, "timestamp": "05:51:15", "text": "找份工作什么的。我当时就像"}, {"type": "subtitle", "time": 21078.548, "timestamp": "05:51:18", "text": "因为现在很难，因为，呃，现实生活中你"}, {"type": "subtitle", "time": 21080.948, "timestamp": "05:51:20", "text": "然后就得出示证书之类的东西。"}, {"type": "subtitle", "time": 21084.23, "timestamp": "05:51:24", "text": "只有你才能得到这份工作，而这才是最重要的。"}, {"type": "subtitle", "time": 21087.75, "timestamp": "05:51:27", "text": "就像我做的事情一样，我是"}, {"type": "subtitle", "time": 21090.708, "timestamp": "05:51:30", "text": "我真的非常热衷于帮助别人，也喜欢帮助别人。"}, {"type": "subtitle", "time": 21093.59, "timestamp": "05:51:33", "text": "做一份工作之类的"}, {"type": "subtitle", "time": 21095.75, "timestamp": "05:51:35", "text": "这。这有点像另一种乐趣"}, {"type": "subtitle", "time": 21098.31, "timestamp": "05:51:38", "text": "经验。这是我的第一次"}, {"type": "subtitle", "time": 21101.99, "timestamp": "05:51:41", "text": "了解事物的来龙去脉等等"}, {"type": "subtitle", "time": 21104.948, "timestamp": "05:51:44", "text": "就是这样。所以我就说：“好的，我愿意。”"}, {"type": "subtitle", "time": 21108.31, "timestamp": "05:51:48", "text": "就是这样。”是啊，因为我没有"}, {"type": "subtitle", "time": 21110.47, "timestamp": "05:51:50", "text": "够了，我还要付最后一笔钱。"}, {"type": "subtitle", "time": 21113.83, "timestamp": "05:51:53", "text": "月。于是音乐课程开始了。"}, {"type": "subtitle", "time": 21117.67, "timestamp": "05:51:57", "text": "从一月份开始，然后就结束了。"}]
[{"type": "subtitle", "time": 2461.91, "timestamp": "00:41:01", "text": "最近，我一直感觉……"}, {"type": "subtitle", "time": 2476.63, "timestamp": "00:41:16", "text": "我最近感觉"}, {"type": "subtitle", "time": 2478.95, "timestamp": "00:41:18", "text": "嗯"}, {"type": "subtitle", "time": 2502.63, "timestamp": "00:41:42", "text": "正确的说法是什么？嗯，"}, {"type": "subtitle", "time": 2504.39, "timestamp": "00:41:44", "text": "我不想变成那样，就像……"}, {"type": "subtitle", "time": 2506.23, "timestamp": "00:41:46", "text": "那种不想起床的感觉"}, {"type": "subtitle", "time": 2508.23, "timestamp": "00:41:48", "text": "躺在床上。"}, {"type": "subtitle", "time": 2510.55, "timestamp": "00:41:50", "text": "或许是天气的原因。这是因为太"}, {"type": "subtitle", "time": 2518.71, "timestamp": "00:41:58", "text": "我一睡懒觉，我的身体就像"}]
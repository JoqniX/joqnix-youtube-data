[{"type": "subtitle", "time": 21540.47, "timestamp": "05:59:00", "text": "人々は、どういうわけか私のリスニングを活性化させます"}, {"type": "subtitle", "time": 21543.03, "timestamp": "05:59:03", "text": "モード。だから私は話さずに聞く"}, {"type": "subtitle", "time": 21546.07, "timestamp": "05:59:06", "text": "人々が話している。だから私はそうする"}, {"type": "subtitle", "time": 21547.59, "timestamp": "05:59:07", "text": "無意識のうちに"}, {"type": "subtitle", "time": 21550.948, "timestamp": "05:59:10", "text": "そして私は「うん、聴いてるよ」って感じだった"}, {"type": "subtitle", "time": 21553.27, "timestamp": "05:59:13", "text": "彼女が言っていたことと、それに対する反応"}, {"type": "subtitle", "time": 21555.43, "timestamp": "05:59:15", "text": "そして私はいつも忘れてしまう、ああ、私は"}, {"type": "subtitle", "time": 21558.15, "timestamp": "05:59:18", "text": "応答する。わかった。"}, {"type": "subtitle", "time": 21561.03, "timestamp": "05:59:21", "text": "そんな感じ。それは理解できます。"}, {"type": "subtitle", "time": 21565.51, "timestamp": "05:59:25", "text": "そしてゆっくりと、その恐怖は"}, {"type": "subtitle", "time": 21569.35, "timestamp": "05:59:29", "text": "話すことと、えっと、欲しいという恐怖"}, {"type": "subtitle", "time": 21571.83, "timestamp": "05:59:31", "text": "人々と知り合い、私がずっと望んでいたように"}, {"type": "subtitle", "time": 21575.19, "timestamp": "05:59:35", "text": "人と会ったり、いろいろなことをしたりするために。私の私の考え"}, {"type": "subtitle", "time": 21577.67, "timestamp": "05:59:37", "text": "それは、そのロールモデルのようなものだった"}, {"type": "subtitle", "time": 21580.07, "timestamp": "05:59:40", "text": "彼がいつも"}, {"type": "subtitle", "time": 21582.47, "timestamp": "05:59:42", "text": "知らない場所に行くか、"}, {"type": "subtitle", "time": 21585.75, "timestamp": "05:59:45", "text": "新品同様だけど、彼は全く新しい。"}, {"type": "subtitle", "time": 21589.27, "timestamp": "05:59:49", "text": "人々とすぐに仲良くなる"}, {"type": "subtitle", "time": 21593.03, "timestamp": "05:59:53", "text": "あるいはそこにいる人たちとか、どうして"}]
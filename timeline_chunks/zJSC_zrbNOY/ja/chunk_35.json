[{"type": "subtitle", "time": 2119.91, "timestamp": "00:35:19", "text": "えっと、それを言うべきでしょうか"}, {"type": "subtitle", "time": 2123.03, "timestamp": "00:35:23", "text": "私は2番目と3番目のアカウントです"}, {"type": "subtitle", "time": 2139.67, "timestamp": "00:35:39", "text": "それは全くやってはいけないことなの？私は"}, {"type": "subtitle", "time": 2141.99, "timestamp": "00:35:41", "text": "わからない"}, {"type": "subtitle", "time": 2159.75, "timestamp": "00:35:59", "text": "何をすべきかわかりません。"}]
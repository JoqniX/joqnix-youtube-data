[{"type": "subtitle", "time": 14880.63, "timestamp": "04:08:00", "text": "どこへ行くにもワクチン接種器を持ち歩いています。そして"}, {"type": "subtitle", "time": 14882.71, "timestamp": "04:08:02", "text": "風邪をひいていなくても、"}, {"type": "subtitle", "time": 14886.389, "timestamp": "04:08:06", "text": "私がこれからすることを好む理由を知ってください"}, {"type": "subtitle", "time": 14888.79, "timestamp": "04:08:08", "text": "これ。私は、何て言うんでしたっけ？"}, {"type": "subtitle", "time": 14891.99, "timestamp": "04:08:11", "text": "匂いを嗅いでみて。を何と呼びますか"}, {"type": "subtitle", "time": 14894.229, "timestamp": "04:08:14", "text": "Vixie を使用するときの動作"}, {"type": "subtitle", "time": 14896.229, "timestamp": "04:08:16", "text": "吸入器？"}, {"type": "subtitle", "time": 14900.95, "timestamp": "04:08:20", "text": "吸い込む。 H 吸入。うん。うん。吸い込む。"}, {"type": "subtitle", "time": 14903.51, "timestamp": "04:08:23", "text": "うん。"}, {"type": "subtitle", "time": 14905.269, "timestamp": "04:08:25", "text": "私はいつもそれを持ち歩いています。しかし、"}, {"type": "subtitle", "time": 14907.67, "timestamp": "04:08:27", "text": "問題は、私はどちらかというと母親のような感じなんです"}, {"type": "subtitle", "time": 14910.229, "timestamp": "04:08:30", "text": "グループの友人。"}, {"type": "subtitle", "time": 14914.309, "timestamp": "04:08:34", "text": "だから私はおそらくあらゆるものを持ち歩くでしょう"}, {"type": "subtitle", "time": 14916.55, "timestamp": "04:08:36", "text": "シナリオの場合"}, {"type": "subtitle", "time": 14921.83, "timestamp": "04:08:41", "text": "医薬品、あらゆる安全対策。うん、わかってるよ"}, {"type": "subtitle", "time": 14925.349, "timestamp": "04:08:45", "text": "もちろん、そのせいで私のバッグはとても重くなる。"}, {"type": "subtitle", "time": 14929.51, "timestamp": "04:08:49", "text": "そして私は疲れているが"}, {"type": "subtitle", "time": 14932.309, "timestamp": "04:08:52", "text": "準備しておくと良いという意味です"}, {"type": "subtitle", "time": 14935.67, "timestamp": "04:08:55", "text": "準備不足だったんだろうね。うん。"}, {"type": "subtitle", "time": 14937.349, "timestamp": "04:08:57", "text": "たぶんその時私の身長は"}]
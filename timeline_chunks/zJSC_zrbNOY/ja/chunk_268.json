[{"type": "subtitle", "time": 16080.63, "timestamp": "04:28:00", "text": "だから彼は私がこれらを許可したと思った"}, {"type": "subtitle", "time": 16083.59, "timestamp": "04:28:03", "text": "もの。しかし、私はそれを知らなかった。私は感じた"}, {"type": "subtitle", "time": 16085.429, "timestamp": "04:28:05", "text": "コラボレーションの後、私が"}, {"type": "subtitle", "time": 16088.95, "timestamp": "04:28:08", "text": "ストリーム、私は自分が感じていない何かを感じた"}, {"type": "subtitle", "time": 16090.95, "timestamp": "04:28:10", "text": "知る。通常、ストリームを行うと、"}, {"type": "subtitle", "time": 16092.389, "timestamp": "04:28:12", "text": "幸せを感じるはずの物事、"}, {"type": "subtitle", "time": 16094.229, "timestamp": "04:28:14", "text": "右？ああ、これは私がやったんです。私は"}, {"type": "subtitle", "time": 16096.63, "timestamp": "04:28:16", "text": "これくらい話せば十分だ。みんな親切だった。"}, {"type": "subtitle", "time": 16098.71, "timestamp": "04:28:18", "text": "右？でもその日は気分がすごく"}, {"type": "subtitle", "time": 16103.59, "timestamp": "04:28:23", "text": "悪い。私は泣き始めた"}, {"type": "subtitle", "time": 16109.03, "timestamp": "04:28:29", "text": "ストリーム終了ボタンを押した後のスポーツと"}, {"type": "subtitle", "time": 16112.149, "timestamp": "04:28:32", "text": "それから戻って誰かに話した"}, {"type": "subtitle", "time": 16114.79, "timestamp": "04:28:34", "text": "それについて。えっと、それは"}, {"type": "subtitle", "time": 16118.07, "timestamp": "04:28:38", "text": "サーバーが見えますね。私は泣いた。私は参加し、"}, {"type": "subtitle", "time": 16120.55, "timestamp": "04:28:40", "text": "「うん、悲しい気分だよ」って言った。私は泣いた"}, {"type": "subtitle", "time": 16123.67, "timestamp": "04:28:43", "text": "その場で何が起こったのかを彼らに話しました"}, {"type": "subtitle", "time": 16125.75, "timestamp": "04:28:45", "text": "そして彼らはボードをチェックし、"}, {"type": "subtitle", "time": 16129.59, "timestamp": "04:28:49", "text": "そう、あの人は冗談じゃなかった"}, {"type": "subtitle", "time": 16132.71, "timestamp": "04:28:52", "text": "視聴者は、その人が本当に"}, {"type": "subtitle", "time": 16136.149, "timestamp": "04:28:56", "text": "あなたに対して失礼で、悪い、そして、"}, {"type": "subtitle", "time": 16139.03, "timestamp": "04:28:59", "text": "このような行動は容認できず、"}]
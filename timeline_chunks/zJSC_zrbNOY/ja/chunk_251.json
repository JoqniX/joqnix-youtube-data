[{"type": "subtitle", "time": 15060.469, "timestamp": "04:11:00", "text": "私のfを説得するのに大変苦労しました"}, {"type": "subtitle", "time": 15064.15, "timestamp": "04:11:04", "text": "家族が私を行かせてくれたのは、えっと、私は"}, {"type": "subtitle", "time": 15066.79, "timestamp": "04:11:06", "text": "来月日本に行く予定で"}, {"type": "subtitle", "time": 15069.349, "timestamp": "04:11:09", "text": "だから彼らを説得するのは難しかったが"}, {"type": "subtitle", "time": 15072.15, "timestamp": "04:11:12", "text": "幸い近くにユーチューバーがいた"}, {"type": "subtitle", "time": 15075.83, "timestamp": "04:11:15", "text": "私の住んでいる地域では、彼は私の近くに住んでいます。だから私は"}, {"type": "subtitle", "time": 15078.309, "timestamp": "04:11:18", "text": "「あ、待って。あなたが住んでいるなんて知らなかった」"}, {"type": "subtitle", "time": 15081.189, "timestamp": "04:11:21", "text": "近くに住んでいて、あなたは私と同じ州出身なんですね"}, {"type": "subtitle", "time": 15085.03, "timestamp": "04:11:25", "text": "「私と同じように。」そして、ええ、そう思いました。"}, {"type": "subtitle", "time": 15088.79, "timestamp": "04:11:28", "text": "私は彼の家族と話をした。"}, {"type": "subtitle", "time": 15090.63, "timestamp": "04:11:30", "text": "家族と話したら、彼らも同意した"}, {"type": "subtitle", "time": 15093.75, "timestamp": "04:11:33", "text": "そして私たちは行き、そうして私は出会った"}, {"type": "subtitle", "time": 15096.79, "timestamp": "04:11:36", "text": "みんな。通りかかった数人が"}, {"type": "subtitle", "time": 15100.79, "timestamp": "04:11:40", "text": "そこには。とても素敵な経験でした"}, {"type": "subtitle", "time": 15104.63, "timestamp": "04:11:44", "text": "パンフォードのよ​​うな北部の地域を試してみて"}, {"type": "subtitle", "time": 15108.309, "timestamp": "04:11:48", "text": "北部の食べ物や物"}, {"type": "subtitle", "time": 15111.349, "timestamp": "04:11:51", "text": "そして私はそれを試してみたと思う"}, {"type": "subtitle", "time": 15113.91, "timestamp": "04:11:53", "text": "チャールとか何とかって呼ばれてるんだけど"}]
[{"type": "subtitle", "time": 21003.51, "timestamp": "05:50:03", "text": "もの。うん。学習曲線。学習"}, {"type": "subtitle", "time": 21007.75, "timestamp": "05:50:07", "text": "曲線。ええ、今でも参加していますよ。えっと、私は"}, {"type": "subtitle", "time": 21010.07, "timestamp": "05:50:10", "text": "えっと、私はまだ参加しています。"}, {"type": "subtitle", "time": 21012.628, "timestamp": "05:50:12", "text": "あまり仕事がないのにたくさん得られる"}, {"type": "subtitle", "time": 21014.948, "timestamp": "05:50:14", "text": "パートタイムの仕事。私はテクノロジーが好きなんです"}, {"type": "subtitle", "time": 21016.948, "timestamp": "05:50:16", "text": "他のストリーマーと同様にサポートし、"}, {"type": "subtitle", "time": 21020.31, "timestamp": "05:50:20", "text": "すべて。だから私はその観察に対して報酬をもらっている"}, {"type": "subtitle", "time": 21023.51, "timestamp": "05:50:23", "text": "そして全て。だから私はいつも"}, {"type": "subtitle", "time": 21027.19, "timestamp": "05:50:27", "text": "無料でやったのは、"}, {"type": "subtitle", "time": 21029.51, "timestamp": "05:50:29", "text": "人を助けたいと思ったのは、"}, {"type": "subtitle", "time": 21032.15, "timestamp": "05:50:32", "text": "技術的なことはイライラさせられることが多い"}, {"type": "subtitle", "time": 21035.67, "timestamp": "05:50:35", "text": "今、そしてたとえあなたが何人かの人に尋ねたとしても"}, {"type": "subtitle", "time": 21037.99, "timestamp": "05:50:37", "text": "Discordサーバーまたはサポートサーバー"}, {"type": "subtitle", "time": 21040.47, "timestamp": "05:50:40", "text": "人々があなたに失礼な態度をとる理由は"}, {"type": "subtitle", "time": 21042.708, "timestamp": "05:50:42", "text": "あなたはインド人か何か、あるいはその他大勢"}, {"type": "subtitle", "time": 21045.11, "timestamp": "05:50:45", "text": "今、私は多くの問題に直面しています"}, {"type": "subtitle", "time": 21047.51, "timestamp": "05:50:47", "text": "もの。だから私はこう思った"}, {"type": "subtitle", "time": 21050.788, "timestamp": "05:50:50", "text": "君に教えるよ、だって私はたくさん理解したから"}, {"type": "subtitle", "time": 21053.27, "timestamp": "05:50:53", "text": "私の経験から、そして私は理解しました"}, {"type": "subtitle", "time": 21055.11, "timestamp": "05:50:55", "text": "明らかに機能する方法とよく似ています。"}, {"type": "subtitle", "time": 21057.27, "timestamp": "05:50:57", "text": "私が教えることすべてと、"}]
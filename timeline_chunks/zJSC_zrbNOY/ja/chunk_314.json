[{"type": "subtitle", "time": 18841.51, "timestamp": "05:14:01", "text": "ファジをしたら死んで、それから"}, {"type": "subtitle", "time": 18844.948, "timestamp": "05:14:04", "text": "悲しい破裂音の警告が鳴り響く"}, {"type": "subtitle", "time": 18848.31, "timestamp": "05:14:08", "text": "バックグラウンドでオンになっている。うん。"}, {"type": "subtitle", "time": 18851.11, "timestamp": "05:14:11", "text": "愚かな死に方と、それから感情的な"}, {"type": "subtitle", "time": 18856.868, "timestamp": "05:14:16", "text": "カニ波の方が人気があるのは、"}, {"type": "subtitle", "time": 18859.27, "timestamp": "05:14:19", "text": "いつもちょっとびっくりするんだけど、"}, {"type": "subtitle", "time": 18862.708, "timestamp": "05:14:22", "text": "音を注意深く見守っているわけではない"}, {"type": "subtitle", "time": 18864.39, "timestamp": "05:14:24", "text": "進行中です。だから私は見ないつもりです"}, {"type": "subtitle", "time": 18867.35, "timestamp": "05:14:27", "text": "チャットで突然、"}, {"type": "subtitle", "time": 18875.99, "timestamp": "05:14:35", "text": "そうそう、"}, {"type": "subtitle", "time": 18878.788, "timestamp": "05:14:38", "text": "精神的なダメージ。"}, {"type": "subtitle", "time": 18887.43, "timestamp": "05:14:47", "text": "以前持っていたものもいくつかセットアップするべきだ"}, {"type": "subtitle", "time": 18890.07, "timestamp": "05:14:50", "text": "私の配信にはたくさんのものがありますが、"}, {"type": "subtitle", "time": 18893.67, "timestamp": "05:14:53", "text": "問題は、私が実装していたからでした。"}, {"type": "subtitle", "time": 18896.39, "timestamp": "05:14:56", "text": "私の配信のためにたくさんのものを用意しました。それは"}, {"type": "subtitle", "time": 18898.948, "timestamp": "05:14:58", "text": "OBSが頻繁にクラッシュしていたという点"}]
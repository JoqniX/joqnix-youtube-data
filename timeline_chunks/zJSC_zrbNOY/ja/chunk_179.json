[{"type": "subtitle", "time": 10773.91, "timestamp": "02:59:33", "text": "[音楽]"}, {"type": "subtitle", "time": 10777.19, "timestamp": "02:59:37", "text": "わかった。じゃあ、またすぐ戻ります"}, {"type": "subtitle", "time": 10780.23, "timestamp": "02:59:40", "text": "分。私は戻ってきます。私は持っていません"}, {"type": "subtitle", "time": 10782.07, "timestamp": "02:59:42", "text": "マイクは私と一緒にセットアップされています。私は戻ってきます。 1つ"}, {"type": "subtitle", "time": 10784.71, "timestamp": "02:59:44", "text": "2番。わかった。"}, {"type": "subtitle", "time": 10793.269, "timestamp": "02:59:53", "text": "えっと、"}, {"type": "subtitle", "time": 10795.59, "timestamp": "02:59:55", "text": "これを閉じてください。これを閉じてください。これを閉じてください。"}]
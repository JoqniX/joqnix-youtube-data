[{"type": "subtitle", "time": 18420.23, "timestamp": "05:07:00", "text": "だって、えっと、つい最近私が"}, {"type": "subtitle", "time": 18421.83, "timestamp": "05:07:01", "text": "今まで使っていたのに気づかなかった"}, {"type": "subtitle", "time": 18423.91, "timestamp": "05:07:03", "text": "これまで使用してきたオーバーレイと同じ"}, {"type": "subtitle", "time": 18428.23, "timestamp": "05:07:08", "text": "始めた。うん。そしてそれはある意味"}, {"type": "subtitle", "time": 18430.31, "timestamp": "05:07:10", "text": "その瞬間にはそうはならないだろう"}, {"type": "subtitle", "time": 18433.91, "timestamp": "05:07:13", "text": "それは私の焦点の多くとは似ていなかったので、"}, {"type": "subtitle", "time": 18437.11, "timestamp": "05:07:17", "text": "まるでそれがなかったかのように気づかなかった"}, {"type": "subtitle", "time": 18441.35, "timestamp": "05:07:21", "text": "えーと、それは、つまり、つながっているとか、えーと"}, {"type": "subtitle", "time": 18443.51, "timestamp": "05:07:23", "text": "他の美的感覚との流入"}, {"type": "subtitle", "time": 18447.35, "timestamp": "05:07:27", "text": "何かが起こっている。うん。でも今は、えーと"}, {"type": "subtitle", "time": 18450.868, "timestamp": "05:07:30", "text": "時々、ただ"}, {"type": "subtitle", "time": 18453.11, "timestamp": "05:07:33", "text": "そこにいて、ちらっと見るだけ"}, {"type": "subtitle", "time": 18457.75, "timestamp": "05:07:37", "text": "上に重ねると、h は場違いに見える。"}, {"type": "subtitle", "time": 18461.67, "timestamp": "05:07:41", "text": "うん。また視聴者は"}, {"type": "subtitle", "time": 18464.788, "timestamp": "05:07:44", "text": "ああ、私が今まで見てきたのと同じ景色だ"}, {"type": "subtitle", "time": 18467.03, "timestamp": "05:07:47", "text": "長年にわたり。何？なぜ"}, {"type": "subtitle", "time": 18469.75, "timestamp": "05:07:49", "text": "目新しいことは何もないの？"}, {"type": "subtitle", "time": 18472.628, "timestamp": "05:07:52", "text": "うん。私は、理解できるし、"}, {"type": "subtitle", "time": 18475.67, "timestamp": "05:07:55", "text": "本当に好きで、この時点では"}, {"type": "subtitle", "time": 18477.83, "timestamp": "05:07:57", "text": "なんだか、私は多くの"}]
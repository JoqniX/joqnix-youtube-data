[{"type": "subtitle", "time": 13801.67, "timestamp": "03:50:01", "text": "あなたに力を与え、関わり、あなたにやってもらいたい"}, {"type": "subtitle", "time": 13804.07, "timestamp": "03:50:04", "text": "恐れていることを"}, {"type": "subtitle", "time": 13807.59, "timestamp": "03:50:07", "text": "あなたがそれを実行するよう、ほんの少しだけ後押しします。のように"}, {"type": "subtitle", "time": 13810.469, "timestamp": "03:50:10", "text": "私はすべて準備万端だった。私はモデルを描きました"}, {"type": "subtitle", "time": 13812.389, "timestamp": "03:50:12", "text": "そして全て。"}, {"type": "subtitle", "time": 13814.55, "timestamp": "03:50:14", "text": "A"}, {"type": "subtitle", "time": 13816.07, "timestamp": "03:50:16", "text": "そして私はただ座って"}, {"type": "subtitle", "time": 13829.349, "timestamp": "03:50:29", "text": "楽しかった。楽しかったよ。まるで"}, {"type": "subtitle", "time": 13832.469, "timestamp": "03:50:32", "text": "ストリームが好きで、"}, {"type": "subtitle", "time": 13836.469, "timestamp": "03:50:36", "text": "みんな、ただ一緒に過ごすだけだよ。がある"}, {"type": "subtitle", "time": 13838.389, "timestamp": "03:50:38", "text": "良い日もあれば悪い日もあるけど、そう、"}, {"type": "subtitle", "time": 13840.71, "timestamp": "03:50:40", "text": "概ね良好です。"}, {"type": "subtitle", "time": 13843.189, "timestamp": "03:50:43", "text": "それは旅のようなものだよ。"}, {"type": "subtitle", "time": 13853.269, "timestamp": "03:50:53", "text": "そして、あなたができることをするのはもっと楽しいです"}, {"type": "subtitle", "time": 13855.429, "timestamp": "03:50:55", "text": "あなたが望むものは何でも。あなたは話すことができます"}, {"type": "subtitle", "time": 13858.229, "timestamp": "03:50:58", "text": "心の内をすべて吐き出す。あなたの"}]
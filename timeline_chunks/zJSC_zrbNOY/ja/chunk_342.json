[{"type": "subtitle", "time": 20523.59, "timestamp": "05:42:03", "text": "階下で、お茶を入れるとか。えっと"}, {"type": "subtitle", "time": 20525.51, "timestamp": "05:42:05", "text": "24時間配信をしているので、"}, {"type": "subtitle", "time": 20527.67, "timestamp": "05:42:07", "text": "それは進行中です。だから私は戦争をして"}, {"type": "subtitle", "time": 20530.47, "timestamp": "05:42:10", "text": "階下。この女性から電話がかかってきた"}, {"type": "subtitle", "time": 20532.628, "timestamp": "05:42:12", "text": "そう言って、あなたは登録しました"}, {"type": "subtitle", "time": 20535.19, "timestamp": "05:42:15", "text": "魂の所有権。これは私たちがこれです"}, {"type": "subtitle", "time": 20537.83, "timestamp": "05:42:17", "text": "それについても、私たちがお手伝いできます。"}, {"type": "subtitle", "time": 20541.51, "timestamp": "05:42:21", "text": "2,000か3,000か何か払って、"}, {"type": "subtitle", "time": 20544.07, "timestamp": "05:42:24", "text": "私たちがすべてお引き受けできます。それで"}, {"type": "subtitle", "time": 20546.628, "timestamp": "05:42:26", "text": "その人は北インド出身だったから"}, {"type": "subtitle", "time": 20548.15, "timestamp": "05:42:28", "text": "そして私は南インド出身で、"}, {"type": "subtitle", "time": 20550.548, "timestamp": "05:42:30", "text": "懐疑的な感じで、"}, {"type": "subtitle", "time": 20553.83, "timestamp": "05:42:33", "text": "物事は「そうだよ」という感じだった"}, {"type": "subtitle", "time": 20556.39, "timestamp": "05:42:36", "text": "グーみたいに、GPが私たちにお金を払ってくれる"}, {"type": "subtitle", "time": 20558.788, "timestamp": "05:42:38", "text": "今すぐやります、あなたは"}, {"type": "subtitle", "time": 20561.19, "timestamp": "05:42:41", "text": "あなただけのための特別なオファーです。"}, {"type": "subtitle", "time": 20564.948, "timestamp": "05:42:44", "text": "今話しているんだけど、えーっと"}, {"type": "subtitle", "time": 20567.67, "timestamp": "05:42:47", "text": "家族と話したいと伝えた"}, {"type": "subtitle", "time": 20569.51, "timestamp": "05:42:49", "text": "まず、でも、すべて、そして私は"}, {"type": "subtitle", "time": 20572.07, "timestamp": "05:42:52", "text": "手元にお金がある 手元にある"}, {"type": "subtitle", "time": 20573.83, "timestamp": "05:42:53", "text": "でも、それを私の銀行口座に追加して"}, {"type": "subtitle", "time": 20576.708, "timestamp": "05:42:56", "text": "すべて。彼らは「ああ、"}]
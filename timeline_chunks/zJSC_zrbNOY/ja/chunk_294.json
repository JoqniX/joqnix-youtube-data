[{"type": "subtitle", "time": 17640.948, "timestamp": "04:54:00", "text": "正当な理由のためのものなど。いいえ、"}, {"type": "subtitle", "time": 17644.788, "timestamp": "04:54:04", "text": "それはあなた自身のためよりもずっと良いことだ。そして"}, {"type": "subtitle", "time": 17648.55, "timestamp": "04:54:08", "text": "状況は、えっと、私は自分の"}, {"type": "subtitle", "time": 17651.67, "timestamp": "04:54:11", "text": "家族に聞けないよ、だってすごく大きなことだから"}, {"type": "subtitle", "time": 17655.35, "timestamp": "04:54:15", "text": "金額と家族は最善を尽くしています"}, {"type": "subtitle", "time": 17658.708, "timestamp": "04:54:18", "text": "私を日本に送ってほしい。えっと"}, {"type": "subtitle", "time": 17662.708, "timestamp": "04:54:22", "text": "そして、私は、えっと、私は"}, {"type": "subtitle", "time": 17666.708, "timestamp": "04:54:26", "text": "忘れるか好きになるかのどちらかを選ぶ"}, {"type": "subtitle", "time": 17669.27, "timestamp": "04:54:29", "text": "6年または4年待つ"}, {"type": "subtitle", "time": 17671.99, "timestamp": "04:54:31", "text": "彼らは戻ってきて、"}, {"type": "subtitle", "time": 17674.15, "timestamp": "04:54:34", "text": "約束されたことを実行していて、"}, {"type": "subtitle", "time": 17677.43, "timestamp": "04:54:37", "text": "すべて、より多くの人がいて、"}, {"type": "subtitle", "time": 17679.91, "timestamp": "04:54:39", "text": "すべて。それがうまくいけば"}, {"type": "subtitle", "time": 17682.788, "timestamp": "04:54:42", "text": "大丈夫だけど、それでも私は"}, {"type": "subtitle", "time": 17685.75, "timestamp": "04:54:45", "text": "同様のモデルは作成しないと約束しました"}, {"type": "subtitle", "time": 17688.07, "timestamp": "04:54:48", "text": "リギングなどはあなたのために行われます。"}, {"type": "subtitle", "time": 17690.07, "timestamp": "04:54:50", "text": "デビューさせることはできるけど、それは"}, {"type": "subtitle", "time": 17693.43, "timestamp": "04:54:53", "text": "そうなったので、私は「ああ、その時」と言いました。"}, {"type": "subtitle", "time": 17697.11, "timestamp": "04:54:57", "text": "合併症を知ったとき"}, {"type": "subtitle", "time": 17699.99, "timestamp": "04:54:59", "text": "その場所で起こっていることだけど、私は"}]
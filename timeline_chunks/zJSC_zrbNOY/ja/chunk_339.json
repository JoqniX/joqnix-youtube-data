[{"type": "subtitle", "time": 20340.708, "timestamp": "05:39:00", "text": "トランザクションはトランザクションのようなものでした"}, {"type": "subtitle", "time": 20343.19, "timestamp": "05:39:03", "text": "銀行口座のような基本的なもの"}, {"type": "subtitle", "time": 20345.43, "timestamp": "05:39:05", "text": "たとえそれが起こらなかったとしても、あるいは物事が起こったとしても、それは"}, {"type": "subtitle", "time": 20347.83, "timestamp": "05:39:07", "text": "確認済み。つまり、PayPalの"}, {"type": "subtitle", "time": 20349.91, "timestamp": "05:39:09", "text": "間違いですよね？"}, {"type": "subtitle", "time": 20352.07, "timestamp": "05:39:12", "text": "えっと、ダブルエックして送信しなかったため"}, {"type": "subtitle", "time": 20355.43, "timestamp": "05:39:15", "text": "そこで私はそのことを話しましたが、私はまだ"}, {"type": "subtitle", "time": 20359.35, "timestamp": "05:39:19", "text": "コフィからそのお金をもらったわけじゃない"}, {"type": "subtitle", "time": 20362.15, "timestamp": "05:39:22", "text": "そして今、すべてが"}, {"type": "subtitle", "time": 20365.43, "timestamp": "05:39:25", "text": "シフトして、そう、試してみよう"}, {"type": "subtitle", "time": 20367.83, "timestamp": "05:39:27", "text": "やってください、私が言ったように、いや"}, {"type": "subtitle", "time": 20370.07, "timestamp": "05:39:30", "text": "何が起ころうとも"}, {"type": "subtitle", "time": 20372.07, "timestamp": "05:39:32", "text": "私は、"}, {"type": "subtitle", "time": 20374.31, "timestamp": "05:39:34", "text": "私の銀行口座の最低残高"}, {"type": "subtitle", "time": 20377.99, "timestamp": "05:39:37", "text": "それは今では難しい、今は"}, {"type": "subtitle", "time": 20380.47, "timestamp": "05:39:40", "text": "5,000または4,000 そして昔は"}, {"type": "subtitle", "time": 20383.75, "timestamp": "05:39:43", "text": "これは1,000ルピーでしたか。うん。維持するために"}, {"type": "subtitle", "time": 20386.708, "timestamp": "05:39:46", "text": "小規模銀行のように"}, {"type": "subtitle", "time": 20389.83, "timestamp": "05:39:49", "text": "そんなに大きくはないけど、"}, {"type": "subtitle", "time": 20394.15, "timestamp": "05:39:54", "text": "少なくとも2,000人か3,000人。うん、"}, {"type": "subtitle", "time": 20397.03, "timestamp": "05:39:57", "text": "大丈夫です。そして私は「ああ、できない」と思った。"}, {"type": "subtitle", "time": 20399.19, "timestamp": "05:39:59", "text": "バランスを維持する。たとえ"}]
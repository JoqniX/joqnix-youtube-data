[{"type": "subtitle", "time": 964.71, "timestamp": "00:16:04", "text": "ああ、マイクは階下にあったんだ。私は思った"}, {"type": "subtitle", "time": 967.67, "timestamp": "00:16:07", "text": "マイクを持ってきませんでした。なぜ？私"}, {"type": "subtitle", "time": 971.509, "timestamp": "00:16:11", "text": "それを階下に持って行った。"}, {"type": "subtitle", "time": 974.949, "timestamp": "00:16:14", "text": "はい、大丈夫です。"}, {"type": "subtitle", "time": 981.43, "timestamp": "00:16:21", "text": "そうですね。えっと、"}, {"type": "subtitle", "time": 984.47, "timestamp": "00:16:24", "text": "まず、いくつか最新情報をお伝えします。あなた"}, {"type": "subtitle", "time": 987.829, "timestamp": "00:16:27", "text": "知ってるよ、私は見ていたんだ、えっと、"}, {"type": "subtitle", "time": 990.629, "timestamp": "00:16:30", "text": "YouTuber、名前は忘れたけど、"}, {"type": "subtitle", "time": 995.11, "timestamp": "00:16:35", "text": "PewDiePieの最新動画に反応する、"}, {"type": "subtitle", "time": 998.71, "timestamp": "00:16:38", "text": "それは彼についてです"}, {"type": "subtitle", "time": 1003.99, "timestamp": "00:16:43", "text": "それは彼が"}, {"type": "subtitle", "time": 1006.71, "timestamp": "00:16:46", "text": "えーと、開発とかそういう類の"}, {"type": "subtitle", "time": 1008.47, "timestamp": "00:16:48", "text": "作った、"}, {"type": "subtitle", "time": 1011.509, "timestamp": "00:16:51", "text": "右？そしてそれは本当に"}, {"type": "subtitle", "time": 1013.189, "timestamp": "00:16:53", "text": "いいね。"}, {"type": "subtitle", "time": 1017.269, "timestamp": "00:16:57", "text": "彼がそうしてくれたのは本当に素晴らしいことだった。"}]
[{"type": "subtitle", "time": 17402.31, "timestamp": "04:50:02", "text": "まるで初めて絵を描いたような感じだった"}, {"type": "subtitle", "time": 17407.27, "timestamp": "04:50:07", "text": "アニメタイプのヒューマノイド、えーと、キャラクター、人間"}, {"type": "subtitle", "time": 17409.99, "timestamp": "04:50:09", "text": "キャラクター、なぜなら彼らは以前は抽象的だったから"}, {"type": "subtitle", "time": 17415.91, "timestamp": "04:50:15", "text": "モンスタータイプ、アートなど。ええ、そうですね。そして"}, {"type": "subtitle", "time": 17418.31, "timestamp": "04:50:18", "text": "質問が出ました、"}, {"type": "subtitle", "time": 17421.51, "timestamp": "04:50:21", "text": "将来はYouTuberになる？そして私は、えっ、私は"}, {"type": "subtitle", "time": 17424.788, "timestamp": "04:50:24", "text": "とても混乱しています。私は何をしますか？それから私は"}, {"type": "subtitle", "time": 17429.35, "timestamp": "04:50:29", "text": "星空観察が大好きだったことを思い出した"}, {"type": "subtitle", "time": 17432.708, "timestamp": "04:50:32", "text": "子供の頃。夜になると、私は"}, {"type": "subtitle", "time": 17435.19, "timestamp": "04:50:35", "text": "家の門の外で、"}, {"type": "subtitle", "time": 17438.788, "timestamp": "04:50:38", "text": "星が空高く輝いていて、"}, {"type": "subtitle", "time": 17440.868, "timestamp": "04:50:40", "text": "数えたり、願い事をしたりするのに使われた"}, {"type": "subtitle", "time": 17443.35, "timestamp": "04:50:43", "text": "もし流れ星のようなものを見たら、"}, {"type": "subtitle", "time": 17446.23, "timestamp": "04:50:46", "text": "何か。だから私はそれを見るのが本当に好きなんです"}, {"type": "subtitle", "time": 17448.47, "timestamp": "04:50:48", "text": "星々。以前は時々"}, {"type": "subtitle", "time": 17451.59, "timestamp": "04:50:51", "text": "星の点をつなげて名前を作るか、"}, {"type": "subtitle", "time": 17455.03, "timestamp": "04:50:55", "text": "えっと、そんな感じ。楽しかった。だから私は"}, {"type": "subtitle", "time": 17457.51, "timestamp": "04:50:57", "text": "ああ、もしかしたら私は"}, {"type": "subtitle", "time": 17459.99, "timestamp": "04:50:59", "text": "星座か何か回転するもの"}]
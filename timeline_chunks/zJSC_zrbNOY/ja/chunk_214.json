[{"type": "subtitle", "time": 12842.95, "timestamp": "03:34:02", "text": "うん。そして全てを明らかにする。"}, {"type": "subtitle", "time": 12846.389, "timestamp": "03:34:06", "text": "次に、このコードを見つけてください。"}, {"type": "subtitle", "time": 12849.51, "timestamp": "03:34:09", "text": "ええと、そこにはありません。いいえ。なぜそうではないのですか？"}, {"type": "subtitle", "time": 12852.95, "timestamp": "03:34:12", "text": "そこには？それはデスクトップ上にあります。我々はできる"}, {"type": "subtitle", "time": 12855.269, "timestamp": "03:34:15", "text": "ただそれを実行すればいい。それなら対応できます。"}, {"type": "subtitle", "time": 12858.71, "timestamp": "03:34:18", "text": "はい。計画中"}, {"type": "subtitle", "time": 12861.11, "timestamp": "03:34:21", "text": "ああ、あなたは割り当てていません"}, {"type": "subtitle", "time": 12863.59, "timestamp": "03:34:23", "text": "何でも。ちょっと待って。えっと、あなたの"}, {"type": "subtitle", "time": 12867.269, "timestamp": "03:34:27", "text": "高度なオーディオプロパティ"}, {"type": "subtitle", "time": 12871.269, "timestamp": "03:34:31", "text": "ここ。えっと、アクティブをクリックしてテイク"}, {"type": "subtitle", "time": 12878.309, "timestamp": "03:34:38", "text": "うん。こちらのリンクからこのカードを探してください。うん。"}, {"type": "subtitle", "time": 12881.51, "timestamp": "03:34:41", "text": "そう、それだ。それはそこにある。はぁ？"}, {"type": "subtitle", "time": 12883.269, "timestamp": "03:34:43", "text": "非アクティブ。"}, {"type": "subtitle", "time": 12886.87, "timestamp": "03:34:46", "text": "それは奇妙だ。なぜ非アクティブになっているのですか？わかった。"}, {"type": "subtitle", "time": 12888.469, "timestamp": "03:34:48", "text": "えっと"}, {"type": "subtitle", "time": 12890.79, "timestamp": "03:34:50", "text": "今のところ、えっと、オーディオのものが見えます"}, {"type": "subtitle", "time": 12895.19, "timestamp": "03:34:55", "text": "アクティブ。トラック1にチェックを入れてください。"}, {"type": "subtitle", "time": 12897.03, "timestamp": "03:34:57", "text": "わかった。"}]
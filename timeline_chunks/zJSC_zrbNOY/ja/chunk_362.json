[{"type": "subtitle", "time": 21722.15, "timestamp": "06:02:02", "text": "取引型コラボレーションのような"}, {"type": "subtitle", "time": 21724.788, "timestamp": "06:02:04", "text": "エネルギーを心配し、"}, {"type": "subtitle", "time": 21726.31, "timestamp": "06:02:06", "text": "観客のすべて、たくさんのもの"}, {"type": "subtitle", "time": 21731.03, "timestamp": "06:02:11", "text": "心配しないといけないし、うん、そうだね"}, {"type": "subtitle", "time": 21734.788, "timestamp": "06:02:14", "text": "私は全員を招待すると言いました"}, {"type": "subtitle", "time": 21737.91, "timestamp": "06:02:17", "text": "私が話した人々、そして"}, {"type": "subtitle", "time": 21740.07, "timestamp": "06:02:20", "text": "私のビデオ制作の旅を通して助けてくれた"}, {"type": "subtitle", "time": 21742.708, "timestamp": "06:02:22", "text": "ストリーミングを始めて以来、"}, {"type": "subtitle", "time": 21746.548, "timestamp": "06:02:26", "text": "2020年からほぼ6年が経ちました。"}, {"type": "subtitle", "time": 21749.75, "timestamp": "06:02:29", "text": "私が始めたのは9月23日でした。私"}, {"type": "subtitle", "time": 21752.708, "timestamp": "06:02:32", "text": "私はそれをデビューさせたことがない。たとえ私が"}, {"type": "subtitle", "time": 21755.11, "timestamp": "06:02:35", "text": "6ヶ月か5ヶ月間ストリーミング配信している"}, {"type": "subtitle", "time": 21757.67, "timestamp": "06:02:37", "text": "何年も経ったが、私はそれを初披露しなかった。でも、えっと"}, {"type": "subtitle", "time": 21761.27, "timestamp": "06:02:41", "text": "タイトルを変更した日を覚えていますか？"}, {"type": "subtitle", "time": 21763.59, "timestamp": "06:02:43", "text": "将来有望なYouTuberを応援する。つまり、"}, {"type": "subtitle", "time": 21766.15, "timestamp": "06:02:46", "text": "記念日に設定した日付は"}, {"type": "subtitle", "time": 21769.99, "timestamp": "06:02:49", "text": "2020年9月23日とか。だから私は"}, {"type": "subtitle", "time": 21772.31, "timestamp": "06:02:52", "text": "そう、私が会った人はみんな"}, {"type": "subtitle", "time": 21775.59, "timestamp": "06:02:55", "text": "神 Twitter Instagram あらゆる場所で"}, {"type": "subtitle", "time": 21778.15, "timestamp": "06:02:58", "text": "助けてくれて、話もしてくれた、親切だった"}]
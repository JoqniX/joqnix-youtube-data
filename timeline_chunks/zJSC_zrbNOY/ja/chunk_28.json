[{"type": "subtitle", "time": 1684.149, "timestamp": "00:28:04", "text": "彼らは"}, {"type": "subtitle", "time": 1688.63, "timestamp": "00:28:08", "text": "詐欺か何かでしょう。"}, {"type": "subtitle", "time": 1706.07, "timestamp": "00:28:26", "text": "わからない。"}, {"type": "subtitle", "time": 1708.93, "timestamp": "00:28:28", "text": "正直に"}, {"type": "subtitle", "time": 1733.11, "timestamp": "00:28:53", "text": "でも、私の中には「そうだよ、犬さん」って思う部分もある"}, {"type": "subtitle", "time": 1738.789, "timestamp": "00:28:58", "text": "本当に良いことは何かを知る"}]
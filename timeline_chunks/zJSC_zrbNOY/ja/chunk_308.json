[{"type": "subtitle", "time": 18481.19, "timestamp": "05:08:01", "text": "視聴者はただここにいるだけで、私は"}, {"type": "subtitle", "time": 18485.91, "timestamp": "05:08:05", "text": "大好きだよ、だって、どれだけ"}, {"type": "subtitle", "time": 18489.99, "timestamp": "05:08:09", "text": "私が配信で作成しているもの。"}, {"type": "subtitle", "time": 18494.47, "timestamp": "05:08:14", "text": "つまり、ああ、実は私は本当に"}, {"type": "subtitle", "time": 18497.27, "timestamp": "05:08:17", "text": "すべてが正常に機能している珍しいストリーム"}, {"type": "subtitle", "time": 18500.628, "timestamp": "05:08:20", "text": "最初から同じように。"}, {"type": "subtitle", "time": 18502.708, "timestamp": "05:08:22", "text": "だっていつもこうなんだもん、例えばナヴィとか"}, {"type": "subtitle", "time": 18504.31, "timestamp": "05:08:24", "text": "誰かが参加するだろうし、彼らは"}, {"type": "subtitle", "time": 18508.15, "timestamp": "05:08:28", "text": "「聞こえません」って言われるだろうね。"}, {"type": "subtitle", "time": 18511.03, "timestamp": "05:08:31", "text": "そして私はこう思うだろう、「ああ、私は"}, {"type": "subtitle", "time": 18513.35, "timestamp": "05:08:33", "text": "「ずっと独り言を言っていたんだ。」そして"}, {"type": "subtitle", "time": 18516.23, "timestamp": "05:08:36", "text": "すると、母が"}, {"type": "subtitle", "time": 18518.628, "timestamp": "05:08:38", "text": "あるいは誰かが入ってきて、"}, {"type": "subtitle", "time": 18520.39, "timestamp": "05:08:40", "text": "すぐにミュートして、それから"}, {"type": "subtitle", "time": 18522.628, "timestamp": "05:08:42", "text": "ミュートを解除するのを忘れて、"}, {"type": "subtitle", "time": 18527.75, "timestamp": "05:08:47", "text": "カフこそ本物だ。よかった"}, {"type": "subtitle", "time": 18538.31, "timestamp": "05:08:58", "text": "ええ、私はピーク時に粗雑なコンテンツを提供します"}]
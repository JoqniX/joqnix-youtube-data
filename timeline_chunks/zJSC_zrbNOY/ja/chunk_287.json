[{"type": "subtitle", "time": 17220.55, "timestamp": "04:47:00", "text": "状況を更新することが優先事項である"}, {"type": "subtitle", "time": 17221.57, "timestamp": "04:47:01", "text": "次"}, {"type": "subtitle", "time": 17222.868, "timestamp": "04:47:02", "text": "[音楽]"}, {"type": "subtitle", "time": 17226.15, "timestamp": "04:47:06", "text": "後で更新したいので"}, {"type": "subtitle", "time": 17230.23, "timestamp": "04:47:10", "text": "ノートパソコンをデスクトップパソコンにアップグレードしてプレイできるように"}, {"type": "subtitle", "time": 17233.03, "timestamp": "04:47:13", "text": "より重いゲーム"}, {"type": "subtitle", "time": 17235.03, "timestamp": "04:47:15", "text": "現在、私は拷問することができません"}, {"type": "subtitle", "time": 17237.51, "timestamp": "04:47:17", "text": "ノートパソコンで、まあ、私はノートパソコンを酷使します"}, {"type": "subtitle", "time": 17239.51, "timestamp": "04:47:19", "text": "たくさん。限界に挑戦する"}, {"type": "subtitle", "time": 17244.628, "timestamp": "04:47:24", "text": "時々そうしてしまうこともありますが、できる限りそうしないようにしています。"}, {"type": "subtitle", "time": 17246.23, "timestamp": "04:47:26", "text": "うん、"}, {"type": "subtitle", "time": 17247.91, "timestamp": "04:47:27", "text": "私は本当に模型を作りたいんです。つまり、"}, {"type": "subtitle", "time": 17250.15, "timestamp": "04:47:30", "text": "いつかは2Dモデルも欲しいけど、"}, {"type": "subtitle", "time": 17253.19, "timestamp": "04:47:33", "text": "それはどちらかというと、"}, {"type": "subtitle", "time": 17256.47, "timestamp": "04:47:36", "text": "多分、たくさんの物を持っていくと思います。"}, {"type": "subtitle", "time": 17258.39, "timestamp": "04:47:38", "text": "それは多くの"}, {"type": "subtitle", "time": 17262.31, "timestamp": "04:47:42", "text": "投資も同様です。うん。"}, {"type": "subtitle", "time": 17264.788, "timestamp": "04:47:44", "text": "作品を分けなければならないので"}, {"type": "subtitle", "time": 17267.83, "timestamp": "04:47:47", "text": "多くの。適切にリギングできるように、"}, {"type": "subtitle", "time": 17271.11, "timestamp": "04:47:51", "text": "右？知っている。それが現在"}, {"type": "subtitle", "time": 17274.23, "timestamp": "04:47:54", "text": "どうやって壊せるか学ぼうとしている"}, {"type": "subtitle", "time": 17276.868, "timestamp": "04:47:56", "text": "だって、私はPNGを使っていたから。私"}]
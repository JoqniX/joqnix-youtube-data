[{"type": "subtitle", "time": 18781.43, "timestamp": "05:13:01", "text": "音でびっくりさせられるよ"}, {"type": "subtitle", "time": 18785.27, "timestamp": "05:13:05", "text": "今夜は、あなたが望むだけのアラートを受け取ることができます。"}, {"type": "subtitle", "time": 18789.91, "timestamp": "05:13:09", "text": "ああ、あなたには相手がいるんですね。わかった。わかった。うん。"}, {"type": "subtitle", "time": 18793.59, "timestamp": "05:13:13", "text": "彼らは私を驚かせるのが大好きなんです。"}, {"type": "subtitle", "time": 18796.708, "timestamp": "05:13:16", "text": "私はただ集中してログインするだけです"}, {"type": "subtitle", "time": 18798.47, "timestamp": "05:13:18", "text": "ある特定のもの、そして突然"}, {"type": "subtitle", "time": 18805.11, "timestamp": "05:13:25", "text": "マイクを少しセットアップした後"}, {"type": "subtitle", "time": 18807.59, "timestamp": "05:13:27", "text": "彼らは私の息を呑む音を聞いて、"}, {"type": "subtitle", "time": 18810.55, "timestamp": "05:13:30", "text": "以前は、私が驚いたことがあったのですが、"}, {"type": "subtitle", "time": 18812.788, "timestamp": "05:13:32", "text": "彼らは私が"}, {"type": "subtitle", "time": 18817.19, "timestamp": "05:13:37", "text": "小さな画面とか、あぁ、息を呑むけど"}, {"type": "subtitle", "time": 18819.83, "timestamp": "05:13:39", "text": "今では彼らはそうしているし、彼らはそうだと思う"}, {"type": "subtitle", "time": 18823.03, "timestamp": "05:13:43", "text": "それを楽しんでいます。"}, {"type": "subtitle", "time": 18829.11, "timestamp": "05:13:49", "text": "音によるアラートは試したことがありません。"}, {"type": "subtitle", "time": 18832.47, "timestamp": "05:13:52", "text": "それは今や2つのことのようだった。うん、それ"}, {"type": "subtitle", "time": 18835.67, "timestamp": "05:13:55", "text": "それは本当です。楽しい"}, {"type": "subtitle", "time": 18838.39, "timestamp": "05:13:58", "text": "えっと、つまり、そういう瞬間があるから"}]
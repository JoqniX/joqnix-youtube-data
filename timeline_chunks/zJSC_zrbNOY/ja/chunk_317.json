[{"type": "subtitle", "time": 19020.868, "timestamp": "05:17:00", "text": "ディスプレイをひっくり返してください。ああ、"}, {"type": "subtitle", "time": 19023.51, "timestamp": "05:17:03", "text": "神。私もそうしました。"}, {"type": "subtitle", "time": 19026.15, "timestamp": "05:17:06", "text": "全てがひっくり返ってしまった。そしてこの"}, {"type": "subtitle", "time": 19028.39, "timestamp": "05:17:08", "text": "要は、なぜ私にそんなことをさせるのか、ということです。"}, {"type": "subtitle", "time": 19037.67, "timestamp": "05:17:17", "text": "私たちを信じて、レナ、私の愛しい炎の双子よ。"}, {"type": "subtitle", "time": 19039.99, "timestamp": "05:17:19", "text": "あなたたちを信頼していますが、同時に"}, {"type": "subtitle", "time": 19047.59, "timestamp": "05:17:27", "text": "ああ、以前はコメントがあったのに"}, {"type": "subtitle", "time": 19051.75, "timestamp": "05:17:31", "text": "下。それで何が起こるかというと、"}, {"type": "subtitle", "time": 19054.628, "timestamp": "05:17:34", "text": "メガネを外してください。だから、"}, {"type": "subtitle", "time": 19058.15, "timestamp": "05:17:38", "text": "すぐに同意できるという警告"}, {"type": "subtitle", "time": 19060.47, "timestamp": "05:17:40", "text": "あれ。だから私は自分の"}, {"type": "subtitle", "time": 19063.99, "timestamp": "05:17:43", "text": "クラスで「はい」または「いいえ」ボタンを押してください。"}, {"type": "subtitle", "time": 19066.948, "timestamp": "05:17:46", "text": "私ができることは、"}, {"type": "subtitle", "time": 19069.99, "timestamp": "05:17:49", "text": "カウントダウンもすべて正常に動作します"}, {"type": "subtitle", "time": 19073.11, "timestamp": "05:17:53", "text": "そして回転の痛みをさらに増やした"}, {"type": "subtitle", "time": 19075.99, "timestamp": "05:17:55", "text": "あれ。右。だから私は「よし、私は"}, {"type": "subtitle", "time": 19077.91, "timestamp": "05:17:57", "text": "行く"}]
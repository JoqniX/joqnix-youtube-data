[{"type": "subtitle", "time": 15481.67, "timestamp": "04:18:01", "text": "それはいいことだけど。えっと、私は"}, {"type": "subtitle", "time": 15485.91, "timestamp": "04:18:05", "text": "幸運にも遭遇しなかった"}, {"type": "subtitle", "time": 15489.349, "timestamp": "04:18:09", "text": "何か悪いことがあったが、何もなかったかのように触れた。"}, {"type": "subtitle", "time": 15492.07, "timestamp": "04:18:12", "text": "それまでは特に悪い経験はなかった"}, {"type": "subtitle", "time": 15496.469, "timestamp": "04:18:16", "text": "今。うん。でも私はかなり"}, {"type": "subtitle", "time": 15500.149, "timestamp": "04:18:20", "text": "私の"}, {"type": "subtitle", "time": 15502.309, "timestamp": "04:18:22", "text": "コミュニティや周辺環境は安全だと推測します"}, {"type": "subtitle", "time": 15506.63, "timestamp": "04:18:26", "text": "良い。だから、私が知っている人だけが"}, {"type": "subtitle", "time": 15509.83, "timestamp": "04:18:29", "text": "普段は彼らとよく一緒に過ごしている。"}, {"type": "subtitle", "time": 15511.429, "timestamp": "04:18:31", "text": "うん。"}, {"type": "subtitle", "time": 15513.83, "timestamp": "04:18:33", "text": "つまり、明らかに私はあなたを"}, {"type": "subtitle", "time": 15515.59, "timestamp": "04:18:35", "text": "かなり長い時間が経ちました。だから私はこう思った"}, {"type": "subtitle", "time": 15520.71, "timestamp": "04:18:40", "text": "えっと、じゃあコラボしましょう。"}, {"type": "subtitle", "time": 15523.67, "timestamp": "04:18:43", "text": "えっと、私は気づいたのですが、"}, {"type": "subtitle", "time": 15526.71, "timestamp": "04:18:46", "text": "今連絡を取った人たちは"}, {"type": "subtitle", "time": 15529.03, "timestamp": "04:18:49", "text": "私が連絡を取ったJookataイベント"}, {"type": "subtitle", "time": 15531.189, "timestamp": "04:18:51", "text": "私が会って話した人は少なくとも"}, {"type": "subtitle", "time": 15534.07, "timestamp": "04:18:54", "text": "かつては、そして新しい人々もいた"}, {"type": "subtitle", "time": 15536.63, "timestamp": "04:18:56", "text": "あまりにも。そうだ、変化を起こそうと思った"}, {"type": "subtitle", "time": 15539.189, "timestamp": "04:18:59", "text": "ペースも良く、新しい人たちも"}]
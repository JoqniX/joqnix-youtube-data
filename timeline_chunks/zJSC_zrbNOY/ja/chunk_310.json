[{"type": "subtitle", "time": 18601.75, "timestamp": "05:10:01", "text": "私はただの雑談配信をしています"}, {"type": "subtitle", "time": 18604.23, "timestamp": "05:10:04", "text": "このチャンネルでは2回目です。私の"}, {"type": "subtitle", "time": 18606.15, "timestamp": "05:10:06", "text": "最初のは私が始めた頃のことでした"}, {"type": "subtitle", "time": 18609.19, "timestamp": "05:10:09", "text": "ストリーミング配信。うんうん。何てことだ。私のとても"}, {"type": "subtitle", "time": 18611.67, "timestamp": "05:10:11", "text": "最初の配信はただのチャットで、"}, {"type": "subtitle", "time": 18613.59, "timestamp": "05:10:13", "text": "今これをやったばかりで、クリックしたら、ああ、"}, {"type": "subtitle", "time": 18616.39, "timestamp": "05:10:16", "text": "一度もやったことはありません。ただおしゃべりしただけです。"}, {"type": "subtitle", "time": 18619.27, "timestamp": "05:10:19", "text": "その後、ストリーム配信が続きます。"}, {"type": "subtitle", "time": 18622.07, "timestamp": "05:10:22", "text": "おお。さあ行こう。"}, {"type": "subtitle", "time": 18628.628, "timestamp": "05:10:28", "text": "ただうんこをしながら話すのは本当に楽しい。"}, {"type": "subtitle", "time": 18632.55, "timestamp": "05:10:32", "text": "いいえ、わかっています。えっと、私はそれが"}, {"type": "subtitle", "time": 18634.15, "timestamp": "05:10:34", "text": "それほど楽しいということだ。だから、私は、"}, {"type": "subtitle", "time": 18637.67, "timestamp": "05:10:37", "text": "それをさらに進める。でも、まあ、"}, {"type": "subtitle", "time": 18639.43, "timestamp": "05:10:39", "text": "この時点で、"}, {"type": "subtitle", "time": 18642.788, "timestamp": "05:10:42", "text": "わかった、たぶん直したいんだけど"}, {"type": "subtitle", "time": 18645.27, "timestamp": "05:10:45", "text": "私のチャット画面もそうなので、"}, {"type": "subtitle", "time": 18648.07, "timestamp": "05:10:48", "text": "少し空白というレベルではない。"}, {"type": "subtitle", "time": 18650.23, "timestamp": "05:10:50", "text": "彼らに何かを持たせたい"}, {"type": "subtitle", "time": 18654.23, "timestamp": "05:10:54", "text": "もっと綺麗で、ただの炎じゃない。私"}, {"type": "subtitle", "time": 18657.43, "timestamp": "05:10:57", "text": "つまり、火は良いものだ。知っている"}]
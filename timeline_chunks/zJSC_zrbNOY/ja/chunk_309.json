[{"type": "subtitle", "time": 18541.51, "timestamp": "05:09:01", "text": "レベル。のように"}, {"type": "subtitle", "time": 18551.11, "timestamp": "05:09:11", "text": "私はほぼ2年間そうしてきましたし、"}, {"type": "subtitle", "time": 18553.67, "timestamp": "05:09:13", "text": "いいえ、大丈夫です。つまりそれは"}, {"type": "subtitle", "time": 18556.07, "timestamp": "05:09:16", "text": "その物。私には、"}, {"type": "subtitle", "time": 18558.15, "timestamp": "05:09:18", "text": "えっと"}, {"type": "subtitle", "time": 18559.75, "timestamp": "05:09:19", "text": "これらを必ず持っていなければならないというルール"}, {"type": "subtitle", "time": 18562.628, "timestamp": "05:09:22", "text": "特定の事柄ですが、それはまるで"}, {"type": "subtitle", "time": 18565.75, "timestamp": "05:09:25", "text": "私にとってそれは、"}, {"type": "subtitle", "time": 18568.868, "timestamp": "05:09:28", "text": "君たち。それは、私が"}, {"type": "subtitle", "time": 18571.19, "timestamp": "05:09:31", "text": "これを完璧にしたい。"}, {"type": "subtitle", "time": 18573.03, "timestamp": "05:09:33", "text": "それは私があなたにあげたいもの"}, {"type": "subtitle", "time": 18575.99, "timestamp": "05:09:35", "text": "こちらでは最高の体験ができます。のように"}, {"type": "subtitle", "time": 18579.27, "timestamp": "05:09:39", "text": "みんなに私のように楽しんでほしい"}, {"type": "subtitle", "time": 18581.35, "timestamp": "05:09:41", "text": "コンテンツも同様です。しかし同時に、私は"}, {"type": "subtitle", "time": 18582.628, "timestamp": "05:09:42", "text": "君たちには、とても"}, {"type": "subtitle", "time": 18587.19, "timestamp": "05:09:47", "text": "背景や、見ていて楽しいもの。"}, {"type": "subtitle", "time": 18590.628, "timestamp": "05:09:50", "text": "私たちはそういうやり方でやっています。どこにいるの？"}, {"type": "subtitle", "time": 18594.39, "timestamp": "05:09:54", "text": "私たちはただ雑談しているだけです。ああ、ただ思うんだけど"}, {"type": "subtitle", "time": 18598.23, "timestamp": "05:09:58", "text": "これは私の最初のいいえ、これはああ神様、"}]
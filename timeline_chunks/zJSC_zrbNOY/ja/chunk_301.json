[{"type": "subtitle", "time": 18060.788, "timestamp": "05:01:00", "text": "よし、そろそろ始めようかな"}, {"type": "subtitle", "time": 18064.23, "timestamp": "05:01:04", "text": "私は定期的に芸術の練習をしています。何てことだ。"}, {"type": "subtitle", "time": 18065.99, "timestamp": "05:01:05", "text": "うん、"}, {"type": "subtitle", "time": 18071.59, "timestamp": "05:01:11", "text": "それはそういうことだ。何てことだ。知っている。"}, {"type": "subtitle", "time": 18073.43, "timestamp": "05:01:13", "text": "だから私は、"}, {"type": "subtitle", "time": 18075.83, "timestamp": "05:01:15", "text": "インド人は今最善を尽くして"}, {"type": "subtitle", "time": 18078.788, "timestamp": "05:01:18", "text": "絵を描くことを学ぶように、また、"}, {"type": "subtitle", "time": 18080.948, "timestamp": "05:01:20", "text": "すでにアーティストである彼らは簡単に"}, {"type": "subtitle", "time": 18083.03, "timestamp": "05:01:23", "text": "彼ら。いいえ、彼らはただ学ぶ必要があるのです"}, {"type": "subtitle", "time": 18087.51, "timestamp": "05:01:27", "text": "2Dで、そう、やってみて。"}, {"type": "subtitle", "time": 18090.948, "timestamp": "05:01:30", "text": "うん。信じられない"}, {"type": "subtitle", "time": 18094.23, "timestamp": "05:01:34", "text": "どれほど高価なのか。それは、そして"}, {"type": "subtitle", "time": 18095.99, "timestamp": "05:01:35", "text": "彼らの視点からすれば理解できる"}, {"type": "subtitle", "time": 18097.75, "timestamp": "05:01:37", "text": "眺めも同様だが同時に"}, {"type": "subtitle", "time": 18099.99, "timestamp": "05:01:39", "text": "ただ、為替レートが"}, {"type": "subtitle", "time": 18102.868, "timestamp": "05:01:42", "text": "私たちにとっては高い。はい。"}, {"type": "subtitle", "time": 18106.868, "timestamp": "05:01:46", "text": "うわぁ。うん。うん。今は1米ドルは"}, {"type": "subtitle", "time": 18110.23, "timestamp": "05:01:50", "text": "86. 昔は40か50か"}, {"type": "subtitle", "time": 18115.67, "timestamp": "05:01:55", "text": "60ルピー。今はもう、すごいって感じ。"}, {"type": "subtitle", "time": 18117.83, "timestamp": "05:01:57", "text": "いつかそれが100になる日を想像してみてください。"}]
[{"type": "subtitle", "time": 15120.55, "timestamp": "04:12:00", "text": "探検してみる、かな。"}, {"type": "subtitle", "time": 15124.71, "timestamp": "04:12:04", "text": "それから、えっと、初めてラーメンを食べました"}, {"type": "subtitle", "time": 15128.389, "timestamp": "04:12:08", "text": "まるでレストランがあったかのような時間"}, {"type": "subtitle", "time": 15130.63, "timestamp": "04:12:10", "text": "あるいは私の友人が"}, {"type": "subtitle", "time": 15134.63, "timestamp": "04:12:14", "text": "私をそこへ連れて行ったんだけど、そう、あの"}, {"type": "subtitle", "time": 15137.83, "timestamp": "04:12:17", "text": "そしてこのボバで初めて"}, {"type": "subtitle", "time": 15140.79, "timestamp": "04:12:20", "text": "これまで。おお"}, {"type": "subtitle", "time": 15144.71, "timestamp": "04:12:24", "text": "ああいう派手なもの全部、えっと、何"}, {"type": "subtitle", "time": 15146.95, "timestamp": "04:12:26", "text": "それ以外？"}, {"type": "subtitle", "time": 15150.15, "timestamp": "04:12:30", "text": "それで、えっと、それは何だったんですか？たくさんあります"}, {"type": "subtitle", "time": 15152.07, "timestamp": "04:12:32", "text": "北インド料理。私は知らない"}, {"type": "subtitle", "time": 15154.71, "timestamp": "04:12:34", "text": "名前。ええ、でも、あれは本当に素晴らしかったです。私"}, {"type": "subtitle", "time": 15157.67, "timestamp": "04:12:37", "text": "「わあ、これは本当に素晴らしい」という感じでした。のように、"}, {"type": "subtitle", "time": 15160.15, "timestamp": "04:12:40", "text": "そんなことできるなんて知らなかった。まるで"}, {"type": "subtitle", "time": 15163.189, "timestamp": "04:12:43", "text": "足はこんな感じで、パニールがあって"}, {"type": "subtitle", "time": 15165.99, "timestamp": "04:12:45", "text": "もの。おお。"}, {"type": "subtitle", "time": 15169.51, "timestamp": "04:12:49", "text": "探検しなくてはならない。"}, {"type": "subtitle", "time": 15171.429, "timestamp": "04:12:51", "text": "うん。"}, {"type": "subtitle", "time": 15173.91, "timestamp": "04:12:53", "text": "ニース。"}, {"type": "subtitle", "time": 15178.229, "timestamp": "04:12:58", "text": "例えば、去年の12月とか。 H どのように"}]
[{"type": "subtitle", "time": 18964.15, "timestamp": "05:16:04", "text": "なぜ、なぜ、そんな風に閉鎖したのですか？"}, {"type": "subtitle", "time": 18967.51, "timestamp": "05:16:07", "text": "私は、与えたくないと思う"}, {"type": "subtitle", "time": 18971.19, "timestamp": "05:16:11", "text": "視聴者にそれだけの力を与える"}, {"type": "subtitle", "time": 18976.07, "timestamp": "05:16:16", "text": "だって、彼らの何人かは"}, {"type": "subtitle", "time": 18980.07, "timestamp": "05:16:20", "text": "それだけのポイントを獲得できる。"}, {"type": "subtitle", "time": 18983.75, "timestamp": "05:16:23", "text": "私は英語のbeonを1つ持っていますが、"}, {"type": "subtitle", "time": 18986.948, "timestamp": "05:16:26", "text": "彼らに人気がある。だから私は話せない"}, {"type": "subtitle", "time": 18988.788, "timestamp": "05:16:28", "text": "英語で5分間話してください。したい"}, {"type": "subtitle", "time": 18991.75, "timestamp": "05:16:31", "text": "時間を短縮するか、"}, {"type": "subtitle", "time": 18993.27, "timestamp": "05:16:33", "text": "ポイント。"}, {"type": "subtitle", "time": 18994.948, "timestamp": "05:16:34", "text": "うん。そして、私の"}, {"type": "subtitle", "time": 18997.03, "timestamp": "05:16:37", "text": "眼鏡。だから私は眼鏡を外さなければならない"}, {"type": "subtitle", "time": 19000.15, "timestamp": "05:16:40", "text": "そして、私がやっていることを何でも再生する。以前はよく＿＿していた"}, {"type": "subtitle", "time": 19004.15, "timestamp": "05:16:44", "text": "そうしてください。何てことだ。それはとても"}, {"type": "subtitle", "time": 19007.27, "timestamp": "05:16:47", "text": "知っている。だから私はコウモリのように目が見えない"}, {"type": "subtitle", "time": 19010.15, "timestamp": "05:16:50", "text": "5分くらい。うん。"}, {"type": "subtitle", "time": 19012.628, "timestamp": "05:16:52", "text": "うん。うん。うん。そして、逆の方向へ"}, {"type": "subtitle", "time": 19016.15, "timestamp": "05:16:56", "text": "1つ。だから私がすることは、えっと、私は"}]
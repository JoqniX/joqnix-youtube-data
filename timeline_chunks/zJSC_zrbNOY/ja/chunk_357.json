[{"type": "subtitle", "time": 21420.548, "timestamp": "05:57:00", "text": "心配いりません。"}, {"type": "subtitle", "time": 21422.39, "timestamp": "05:57:02", "text": "つまり、そうですね、でももしあなたがそう感じるなら"}, {"type": "subtitle", "time": 21424.39, "timestamp": "05:57:04", "text": "休憩したいとき、"}, {"type": "subtitle", "time": 21427.19, "timestamp": "05:57:07", "text": "呼び方を教えてください。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 21429.35, "timestamp": "05:57:09", "text": "わかった。"}, {"type": "subtitle", "time": 21433.03, "timestamp": "05:57:13", "text": "うん。すべて順調です。私たちはたくさん話しました"}, {"type": "subtitle", "time": 21435.51, "timestamp": "05:57:15", "text": "たくさんのことを学んだ。良かったよ。そうではない"}, {"type": "subtitle", "time": 21437.35, "timestamp": "05:57:17", "text": "初めてのような気分です"}, {"type": "subtitle", "time": 21439.43, "timestamp": "05:57:19", "text": "何か。わからない。知っている。私は"}, {"type": "subtitle", "time": 21442.628, "timestamp": "05:57:22", "text": "私もかなり驚きました。"}, {"type": "subtitle", "time": 21445.19, "timestamp": "05:57:25", "text": "到着する前に少し緊張しました"}, {"type": "subtitle", "time": 21447.75, "timestamp": "05:57:27", "text": "電話会議中。 OBSをセットアップしていた"}, {"type": "subtitle", "time": 21449.43, "timestamp": "05:57:29", "text": "そして全てが、私はちょうど"}, {"type": "subtitle", "time": 21450.788, "timestamp": "05:57:30", "text": "時々少し緊張する"}, {"type": "subtitle", "time": 21453.11, "timestamp": "05:57:33", "text": "例えば、「よし、私が何かをしたらどうなるだろう？」"}, {"type": "subtitle", "time": 21455.03, "timestamp": "05:57:35", "text": "もし私が何か変なことを言ってしまったらどうしよう？私はしません"}, {"type": "subtitle", "time": 21462.708, "timestamp": "05:57:42", "text": "大丈夫。わからない。まるで私は"}, {"type": "subtitle", "time": 21466.07, "timestamp": "05:57:46", "text": "普段は驚いているのに"}, {"type": "subtitle", "time": 21468.548, "timestamp": "05:57:48", "text": "コラボをするのが本当に怖い、"}, {"type": "subtitle", "time": 21473.03, "timestamp": "05:57:53", "text": "2019年に、えーと話すような人たちと"}, {"type": "subtitle", "time": 21475.75, "timestamp": "05:57:55", "text": "期間、または2020年以前の期間。はい。"}]
[{"type": "subtitle", "time": 2461.91, "timestamp": "00:41:01", "text": "最近は、"}, {"type": "subtitle", "time": 2476.63, "timestamp": "00:41:16", "text": "最近、"}, {"type": "subtitle", "time": 2478.95, "timestamp": "00:41:18", "text": "えっと"}, {"type": "subtitle", "time": 2502.63, "timestamp": "00:41:42", "text": "正しい言い方は何ですか？えっと、"}, {"type": "subtitle", "time": 2504.39, "timestamp": "00:41:44", "text": "まるで、私は、まるで"}, {"type": "subtitle", "time": 2506.23, "timestamp": "00:41:46", "text": "起き上がりたくないという気持ち"}, {"type": "subtitle", "time": 2508.23, "timestamp": "00:41:48", "text": "ベッドから。"}, {"type": "subtitle", "time": 2510.55, "timestamp": "00:41:50", "text": "天気のせいかもしれない。なぜなら"}, {"type": "subtitle", "time": 2518.71, "timestamp": "00:41:58", "text": "寝坊した瞬間、私の体は"}]
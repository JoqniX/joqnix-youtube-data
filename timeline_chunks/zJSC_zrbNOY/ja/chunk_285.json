[{"type": "subtitle", "time": 17101.11, "timestamp": "04:45:01", "text": "私の仕事のために、そして彼女は掃除をしてくれました"}, {"type": "subtitle", "time": 17103.67, "timestamp": "04:45:03", "text": "とても良いので、もう見つけることができません"}, {"type": "subtitle", "time": 17106.55, "timestamp": "04:45:06", "text": "Bluetooth用のコネクタ"}, {"type": "subtitle", "time": 17108.788, "timestamp": "04:45:08", "text": "ヘッドホン。"}, {"type": "subtitle", "time": 17110.708, "timestamp": "04:45:10", "text": "それで、私はヘッドホンを持っています。私は"}, {"type": "subtitle", "time": 17113.75, "timestamp": "04:45:13", "text": "それは、えーっと"}, {"type": "subtitle", "time": 17116.708, "timestamp": "04:45:16", "text": "ケーブルを接続しますが、私は持っていません"}, {"type": "subtitle", "time": 17119.51, "timestamp": "04:45:19", "text": "Bluetoothコネクタ。だから、それはただ"}, {"type": "subtitle", "time": 17122.948, "timestamp": "04:45:22", "text": "動作しなくなりました。"}, {"type": "subtitle", "time": 17127.27, "timestamp": "04:45:27", "text": "いや。ああ、いやだ。なんてこった。"}, {"type": "subtitle", "time": 17131.43, "timestamp": "04:45:31", "text": "うん。以前はこれらの安いものを買っていたが、今は"}, {"type": "subtitle", "time": 17134.31, "timestamp": "04:45:34", "text": "Amazonで見かけるオーバーヘッド"}, {"type": "subtitle", "time": 17136.07, "timestamp": "04:45:36", "text": "そして"}, {"type": "subtitle", "time": 17140.868, "timestamp": "04:45:40", "text": "えっと、私がそれを私の"}, {"type": "subtitle", "time": 17144.07, "timestamp": "04:45:44", "text": "頭を長時間使用したり、"}, {"type": "subtitle", "time": 17147.43, "timestamp": "04:45:47", "text": "1時間以上前に"}, {"type": "subtitle", "time": 17150.23, "timestamp": "04:45:50", "text": "耳は汗ばむような感じで、"}, {"type": "subtitle", "time": 17153.19, "timestamp": "04:45:53", "text": "頭が以前は何かのように感じていた"}, {"type": "subtitle", "time": 17156.628, "timestamp": "04:45:56", "text": "息苦しい感じが徐々に"}]
[{"type": "subtitle", "time": 19141.83, "timestamp": "05:19:01", "text": "絵文字を使ってから、引き換えます。つまり、"}, {"type": "subtitle", "time": 19145.75, "timestamp": "05:19:05", "text": "楽しいことがたくさん起こっている。うん。"}, {"type": "subtitle", "time": 19147.99, "timestamp": "05:19:07", "text": "本当に素晴らしい。"}, {"type": "subtitle", "time": 19151.67, "timestamp": "05:19:11", "text": "Twitchのチャット体験が好きです。"}, {"type": "subtitle", "time": 19154.31, "timestamp": "05:19:14", "text": "どれ？ビンゴみたいなことをしたい"}, {"type": "subtitle", "time": 19157.75, "timestamp": "05:19:17", "text": "いつか私のチャットで。"}, {"type": "subtitle", "time": 19161.43, "timestamp": "05:19:21", "text": "ビンゴ？ああ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 19163.99, "timestamp": "05:19:23", "text": "実は、私にはこんなアイデアがあったんです"}, {"type": "subtitle", "time": 19166.47, "timestamp": "05:19:26", "text": "えーと、友達のためにモデレーターをしていた頃"}, {"type": "subtitle", "time": 19169.19, "timestamp": "05:19:29", "text": "私の。つまり、アイデアは基本的にこうだった"}, {"type": "subtitle", "time": 19171.59, "timestamp": "05:19:31", "text": "彼らに白紙のビンゴシートを渡すだけ"}, {"type": "subtitle", "time": 19173.67, "timestamp": "05:19:33", "text": "そして彼らは私が"}, {"type": "subtitle", "time": 19177.27, "timestamp": "05:19:37", "text": "おそらく配信中に言ったり、したりするだろう。"}, {"type": "subtitle", "time": 19180.47, "timestamp": "05:19:40", "text": "そして、一度チェックすれば"}, {"type": "subtitle", "time": 19183.51, "timestamp": "05:19:43", "text": "やってください"}, {"type": "subtitle", "time": 19185.43, "timestamp": "05:19:45", "text": "そして私はただそれを維持したい"}, {"type": "subtitle", "time": 19188.948, "timestamp": "05:19:48", "text": "彼らが私を騙すことができるルール"}, {"type": "subtitle", "time": 19192.628, "timestamp": "05:19:52", "text": "それも同様に行っています。うん。それは"}, {"type": "subtitle", "time": 19194.39, "timestamp": "05:19:54", "text": "彼らにとっては楽しいことだった。でもたぶん"}]
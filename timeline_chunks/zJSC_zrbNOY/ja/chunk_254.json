[{"type": "subtitle", "time": 15240.95, "timestamp": "04:14:00", "text": "そうだったけど、それもまたかなり楽しかった。"}, {"type": "subtitle", "time": 15249.91, "timestamp": "04:14:09", "text": "あれはすごく大きなラーメンだったと思う。"}, {"type": "subtitle", "time": 15253.349, "timestamp": "04:14:13", "text": "全部読み終えることすらできなかった"}, {"type": "subtitle", "time": 15256.07, "timestamp": "04:14:16", "text": "そして、私はそれを持ち帰ることができた。まるで私が"}, {"type": "subtitle", "time": 15257.83, "timestamp": "04:14:17", "text": "つまり、私はそれを自分に渡すだけです。病気"}, {"type": "subtitle", "time": 15259.99, "timestamp": "04:14:19", "text": "ただ"}, {"type": "subtitle", "time": 15262.469, "timestamp": "04:14:22", "text": "家で麺を茹でて残りを食べる"}, {"type": "subtitle", "time": 15265.91, "timestamp": "04:14:25", "text": "再びスープ。"}, {"type": "subtitle", "time": 15269.83, "timestamp": "04:14:29", "text": "そしてその後に起こったことはさらにひどいものだった。"}, {"type": "subtitle", "time": 15272.07, "timestamp": "04:14:32", "text": "だって、私たちはただ歩き回っていただけだったから"}, {"type": "subtitle", "time": 15275.189, "timestamp": "04:14:35", "text": "市場エリアで、いくつか見かけました"}, {"type": "subtitle", "time": 15277.349, "timestamp": "04:14:37", "text": "私がつけていたイヤリングはとても綺麗に見えました。"}, {"type": "subtitle", "time": 15279.51, "timestamp": "04:14:39", "text": "それで私たちは店に行って、"}, {"type": "subtitle", "time": 15283.429, "timestamp": "04:14:43", "text": "店主が見ていると"}, {"type": "subtitle", "time": 15285.59, "timestamp": "04:14:45", "text": "変で色っぽくて、私は"}, {"type": "subtitle", "time": 15288.07, "timestamp": "04:14:48", "text": "自分が持っていたことを忘れていたことに不快感を覚えた"}, {"type": "subtitle", "time": 15291.03, "timestamp": "04:14:51", "text": "ラーメンのテイクアウトボックスを下に置いた"}, {"type": "subtitle", "time": 15293.51, "timestamp": "04:14:53", "text": "そこには。そしてその時私はこう思った"}, {"type": "subtitle", "time": 15295.59, "timestamp": "04:14:55", "text": "えっと、このイヤリングを取って"}, {"type": "subtitle", "time": 15298.389, "timestamp": "04:14:58", "text": "行く。うん。さよなら。私は値引き交渉すらしなかった"}]
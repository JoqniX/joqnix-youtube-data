[{"type": "subtitle", "time": 17940.948, "timestamp": "04:59:00", "text": "安い方の機材、だってほら、"}, {"type": "subtitle", "time": 17943.75, "timestamp": "04:59:03", "text": "そう、これらのVTuberの依頼アーティスト"}, {"type": "subtitle", "time": 17946.39, "timestamp": "04:59:06", "text": "今は米ドル価格なので"}, {"type": "subtitle", "time": 17949.35, "timestamp": "04:59:09", "text": "インドの通貨で言えば高価"}, {"type": "subtitle", "time": 17953.43, "timestamp": "04:59:13", "text": "そして、とても高価で、"}, {"type": "subtitle", "time": 17957.35, "timestamp": "04:59:17", "text": "インド人フレンドリーなアタスまたはヴィタルス"}, {"type": "subtitle", "time": 17961.27, "timestamp": "04:59:21", "text": "あるいはそこにいるアタスは、とても面倒なので、私は"}, {"type": "subtitle", "time": 17963.67, "timestamp": "04:59:23", "text": "それが私がそうしたい理由です"}, {"type": "subtitle", "time": 17966.47, "timestamp": "04:59:26", "text": "これを学ぶ方法、なぜなら私は"}, {"type": "subtitle", "time": 17969.19, "timestamp": "04:59:29", "text": "もちろん、その価格は"}, {"type": "subtitle", "time": 17973.11, "timestamp": "04:59:33", "text": "尋ねているのは、えっと、彼らの"}, {"type": "subtitle", "time": 17975.91, "timestamp": "04:59:35", "text": "経験があり、芸術レベルが好きですが、"}, {"type": "subtitle", "time": 17978.07, "timestamp": "04:59:38", "text": "同時に、私はただ"}, {"type": "subtitle", "time": 17980.47, "timestamp": "04:59:40", "text": "きちんと学びたいので、少なくとも"}, {"type": "subtitle", "time": 17982.788, "timestamp": "04:59:42", "text": "少しだけ選択肢を広げる"}, {"type": "subtitle", "time": 17985.83, "timestamp": "04:59:45", "text": "インドのユーチューバーコミュニティは"}, {"type": "subtitle", "time": 17987.27, "timestamp": "04:59:47", "text": "もちろん、多くのことが必要になることは分かっています。"}, {"type": "subtitle", "time": 17989.51, "timestamp": "04:59:49", "text": "時間があるけど、たとえ私がそれを"}, {"type": "subtitle", "time": 17993.91, "timestamp": "04:59:53", "text": "彼らにとっては少し安くなる。"}, {"type": "subtitle", "time": 17996.31, "timestamp": "04:59:56", "text": "うん。うん、"}, {"type": "subtitle", "time": 17997.83, "timestamp": "04:59:57", "text": "それは"}]
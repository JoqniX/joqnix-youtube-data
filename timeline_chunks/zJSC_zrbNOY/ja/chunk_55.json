[{"type": "subtitle", "time": 3303.75, "timestamp": "00:55:03", "text": "などなど、私は文字通り自分の"}, {"type": "subtitle", "time": 3307.03, "timestamp": "00:55:07", "text": "親指はつま先のように親指はつま先のように"}, {"type": "subtitle", "time": 3310.069, "timestamp": "00:55:10", "text": "文字通り側面をいじくり回す"}, {"type": "subtitle", "time": 3311.589, "timestamp": "00:55:11", "text": "の"}, {"type": "subtitle", "time": 3314.79, "timestamp": "00:55:14", "text": "私は足を使って触ろうとします"}, {"type": "subtitle", "time": 3317.91, "timestamp": "00:55:17", "text": "ソケット。コンセントの上ではありません。コンセントがありません。の上"}, {"type": "subtitle", "time": 3326.47, "timestamp": "00:55:26", "text": "ええ、そうですね。壁のスロットみたいなやつ。"}, {"type": "subtitle", "time": 3329.19, "timestamp": "00:55:29", "text": "自分が触れるとは思っていなかった"}, {"type": "subtitle", "time": 3333.43, "timestamp": "00:55:33", "text": "もの。それに触れてみてください。そして"}, {"type": "subtitle", "time": 3336.23, "timestamp": "00:55:36", "text": "なんてこった、私は"}, {"type": "subtitle", "time": 3340.069, "timestamp": "00:55:40", "text": "軽いショックのような感じ。"}, {"type": "subtitle", "time": 3351.51, "timestamp": "00:55:51", "text": "いいえ、私が気づいたことの1つは、"}]
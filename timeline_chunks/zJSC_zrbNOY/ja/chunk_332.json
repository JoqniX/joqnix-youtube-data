[{"type": "subtitle", "time": 19922.548, "timestamp": "05:32:02", "text": "そこに何か正しいTwitchがあった"}, {"type": "subtitle", "time": 19925.19, "timestamp": "05:32:05", "text": "Twitchは多くのことを学ぶ"}, {"type": "subtitle", "time": 19928.23, "timestamp": "05:32:08", "text": "そう、サブとか全部そう"}, {"type": "subtitle", "time": 19930.47, "timestamp": "05:32:10", "text": "私が知っているのは、時々私は"}, {"type": "subtitle", "time": 19932.708, "timestamp": "05:32:12", "text": "サブのせいで気分が悪いです"}, {"type": "subtitle", "time": 19936.31, "timestamp": "05:32:16", "text": "Twitchは、"}, {"type": "subtitle", "time": 19938.31, "timestamp": "05:32:18", "text": "両当事者からのこの点"}, {"type": "subtitle", "time": 19942.31, "timestamp": "05:32:22", "text": "彼らはたくさん払っている、そしてそれは"}, {"type": "subtitle", "time": 19944.548, "timestamp": "05:32:24", "text": "次のような"}, {"type": "subtitle", "time": 19947.51, "timestamp": "05:32:27", "text": "彼らが望んでいた人に渡っていない"}, {"type": "subtitle", "time": 19949.43, "timestamp": "05:32:29", "text": "に"}, {"type": "subtitle", "time": 19951.43, "timestamp": "05:32:31", "text": "受け取る"}, {"type": "subtitle", "time": 19955.11, "timestamp": "05:32:35", "text": "そのうちいくらが差し引かれるのか。はい。の"}, {"type": "subtitle", "time": 19959.35, "timestamp": "05:32:39", "text": "切り傷とか、その他諸々。ああ、信じられないよ。"}, {"type": "subtitle", "time": 19961.99, "timestamp": "05:32:41", "text": "私は赤ちゃんのために100時間それを見ますが、"}, {"type": "subtitle", "time": 19964.39, "timestamp": "05:32:44", "text": "それらはすべて異なっていて、より長い方が良い"}, {"type": "subtitle", "time": 19966.948, "timestamp": "05:32:46", "text": "10秒未満。"}, {"type": "subtitle", "time": 19970.15, "timestamp": "05:32:50", "text": "ありがとう、タミー。"}, {"type": "subtitle", "time": 19974.23, "timestamp": "05:32:54", "text": "そして私は気づいた、つまり"}, {"type": "subtitle", "time": 19979.11, "timestamp": "05:32:59", "text": "私たちユーチューバーが直接使い切るのは"}]
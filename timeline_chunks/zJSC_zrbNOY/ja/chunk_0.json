[{"type": "subtitle", "time": 7.51, "timestamp": "00:00:07", "text": "真夜中"}, {"type": "subtitle", "time": 13.669, "timestamp": "00:00:13", "text": "ちなみに私は大丈夫だと思う"}, {"type": "subtitle", "time": 15.509, "timestamp": "00:00:15", "text": "夜中。それが本当かどうかはわかりません"}, {"type": "subtitle", "time": 19.75, "timestamp": "00:00:19", "text": "けれど。ミッドナイトライトを試してみます。どこ"}, {"type": "subtitle", "time": 22.87, "timestamp": "00:00:22", "text": "夜中？右。えっと"}, {"type": "subtitle", "time": 24.87, "timestamp": "00:00:24", "text": "夜中。"}, {"type": "subtitle", "time": 27.589, "timestamp": "00:00:27", "text": "えっと"}, {"type": "subtitle", "time": 29.429, "timestamp": "00:00:29", "text": "1つあります。"}, {"type": "subtitle", "time": 32.15, "timestamp": "00:00:32", "text": "こんにちは。それだ。待って。"}, {"type": "subtitle", "time": 42.069, "timestamp": "00:00:42", "text": "[音楽]"}, {"type": "subtitle", "time": 46.79, "timestamp": "00:00:46", "text": "こんにちは。 ３、２、"}]
[{"type": "subtitle", "time": 18300.39, "timestamp": "05:05:00", "text": "聖人やより大きなユーチューバー向けのリグ、"}, {"type": "subtitle", "time": 18303.03, "timestamp": "05:05:03", "text": "右？本当に素晴らしい品質で"}, {"type": "subtitle", "time": 18305.91, "timestamp": "05:05:05", "text": "すべて。それで、そのうちの1人が"}, {"type": "subtitle", "time": 18308.07, "timestamp": "05:05:08", "text": "しかし、ストリームを視聴すると"}, {"type": "subtitle", "time": 18310.15, "timestamp": "05:05:10", "text": "アラートやその他の情報があります"}, {"type": "subtitle", "time": 18314.868, "timestamp": "05:05:14", "text": "えっと、普通の、うん、普通の廃棄物"}, {"type": "subtitle", "time": 18317.51, "timestamp": "05:05:17", "text": "モデルの品質に見合っていない。"}, {"type": "subtitle", "time": 18320.708, "timestamp": "05:05:20", "text": "いいえ。それで、私が"}, {"type": "subtitle", "time": 18322.708, "timestamp": "05:05:22", "text": "見てみると、新しい人たちが何人かいた。"}, {"type": "subtitle", "time": 18325.59, "timestamp": "05:05:25", "text": "話す、言う、それを声に出して言う"}, {"type": "subtitle", "time": 18329.35, "timestamp": "05:05:29", "text": "それについても、品質など"}, {"type": "subtitle", "time": 18332.39, "timestamp": "05:05:32", "text": "他のスタイルアセットは適合しません"}, {"type": "subtitle", "time": 18335.11, "timestamp": "05:05:35", "text": "モデルの美学とすべてが正しいので"}, {"type": "subtitle", "time": 18337.19, "timestamp": "05:05:37", "text": "だから、ある意味でそれは"}, {"type": "subtitle", "time": 18339.91, "timestamp": "05:05:39", "text": "私が直面することになるものだと気づいた"}, {"type": "subtitle", "time": 18342.15, "timestamp": "05:05:42", "text": "品質が良いモデルであっても"}, {"type": "subtitle", "time": 18344.15, "timestamp": "05:05:44", "text": "品質は良いです。資産や物"}, {"type": "subtitle", "time": 18347.99, "timestamp": "05:05:47", "text": "今は問題ないから、私は大丈夫、私は"}, {"type": "subtitle", "time": 18351.67, "timestamp": "05:05:51", "text": "小さなシュレア、たとえ私が行かなければならないとしても"}, {"type": "subtitle", "time": 18355.51, "timestamp": "05:05:55", "text": "その段階を乗り越えれば大丈夫です"}, {"type": "subtitle", "time": 18359.43, "timestamp": "05:05:59", "text": "時間があれば、いずれは物を買う余裕もできる"}]
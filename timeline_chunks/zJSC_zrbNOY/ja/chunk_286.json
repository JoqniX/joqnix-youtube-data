[{"type": "subtitle", "time": 17160.708, "timestamp": "04:46:00", "text": "重い。日。それから私は"}, {"type": "subtitle", "time": 17164.708, "timestamp": "04:46:04", "text": "耳に宇宙的な噛み傷があった"}, {"type": "subtitle", "time": 17167.35, "timestamp": "04:46:07", "text": "ヘッドホンは今ここに普通にありますが"}, {"type": "subtitle", "time": 17169.67, "timestamp": "04:46:09", "text": "拡張マイクなどを使用する場合"}, {"type": "subtitle", "time": 17172.47, "timestamp": "04:46:12", "text": "何かがあって、それを使ってるんだけど"}, {"type": "subtitle", "time": 17174.948, "timestamp": "04:46:14", "text": "マイクをIのためだけに使うな"}, {"type": "subtitle", "time": 17179.03, "timestamp": "04:46:19", "text": "イヤホンをこのように使うだけです"}, {"type": "subtitle", "time": 17182.15, "timestamp": "04:46:22", "text": "それ。うん。そして私は気づいた、これがある"}, {"type": "subtitle", "time": 17185.91, "timestamp": "04:46:25", "text": "IBMとかIMとかいうやつ、"}, {"type": "subtitle", "time": 17190.47, "timestamp": "04:46:30", "text": "右？イヤホンは"}, {"type": "subtitle", "time": 17192.788, "timestamp": "04:46:32", "text": "耳の形に合わせて成形するとか、そういう感じ。あなたはできる"}, {"type": "subtitle", "time": 17195.59, "timestamp": "04:46:35", "text": "特注品でも作ってもらうといいよ。私はしません"}, {"type": "subtitle", "time": 17197.83, "timestamp": "04:46:37", "text": "その名前を知っていますか？ええ、そうは思いません"}, {"type": "subtitle", "time": 17198.948, "timestamp": "04:46:38", "text": "ええ、何て言うのかは知らないけど、"}, {"type": "subtitle", "time": 17202.15, "timestamp": "04:46:42", "text": "あなたが何をほのめかしているのか、わかってるよ。"}, {"type": "subtitle", "time": 17205.03, "timestamp": "04:46:45", "text": "動画か何かで見たことがあるんです。"}, {"type": "subtitle", "time": 17208.39, "timestamp": "04:46:48", "text": "うん、それはすごくクールだね。良い、良い"}, {"type": "subtitle", "time": 17211.99, "timestamp": "04:46:51", "text": "音質も何もかもすごい"}, {"type": "subtitle", "time": 17215.03, "timestamp": "04:46:55", "text": "知ってるよ、うん、私は"}, {"type": "subtitle", "time": 17218.31, "timestamp": "04:46:58", "text": "えっと、マイクとヘッドホンの状況"}]
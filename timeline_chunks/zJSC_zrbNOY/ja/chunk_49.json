[{"type": "subtitle", "time": 2947.43, "timestamp": "00:49:07", "text": "もちろん、コラボレーションのスケジュール変更は可能です。"}, {"type": "subtitle", "time": 2952.95, "timestamp": "00:49:12", "text": "でも、もし私が"}, {"type": "subtitle", "time": 2956.069, "timestamp": "00:49:16", "text": "これを毎日24時間続ける"}, {"type": "subtitle", "time": 2958.87, "timestamp": "00:49:18", "text": "そして、たとえ私が積極的にそこにいなくても"}, {"type": "subtitle", "time": 2961.829, "timestamp": "00:49:21", "text": "ストリーム、"}, {"type": "subtitle", "time": 2965.67, "timestamp": "00:49:25", "text": "私はそれでもそこにいるだろう。"}, {"type": "subtitle", "time": 2967.91, "timestamp": "00:49:27", "text": "右？"}, {"type": "subtitle", "time": 2971.51, "timestamp": "00:49:31", "text": "そこで、次のような疑問が生じます。"}, {"type": "subtitle", "time": 2987.67, "timestamp": "00:49:47", "text": "俺に何が起こったんだ、兄弟？"}]
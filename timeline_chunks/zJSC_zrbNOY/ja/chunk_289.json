[{"type": "subtitle", "time": 17340.628, "timestamp": "04:49:00", "text": "「よし、YouTubeに来たぞ。」それから私は"}, {"type": "subtitle", "time": 17342.31, "timestamp": "04:49:02", "text": "気がついた"}, {"type": "subtitle", "time": 17347.19, "timestamp": "04:49:07", "text": "えっと、PNG じゃなくて Picu の"}, {"type": "subtitle", "time": 17350.788, "timestamp": "04:49:10", "text": "私は非営利目的で使用しました"}, {"type": "subtitle", "time": 17352.55, "timestamp": "04:49:12", "text": "商業的なことは許可されていません"}, {"type": "subtitle", "time": 17354.868, "timestamp": "04:49:14", "text": "Twitchのアフィリエイトだったから、"}, {"type": "subtitle", "time": 17356.868, "timestamp": "04:49:16", "text": "右？それはまるで私が稼いでいるようなものです"}, {"type": "subtitle", "time": 17359.51, "timestamp": "04:49:19", "text": "あれこれと。それは、"}, {"type": "subtitle", "time": 17364.07, "timestamp": "04:49:24", "text": "彼らにはリスクがある、例えば"}, {"type": "subtitle", "time": 17366.31, "timestamp": "04:49:26", "text": "将来、私の作品を見て、"}, {"type": "subtitle", "time": 17368.39, "timestamp": "04:49:28", "text": "「ああ、それはできないよ。"}, {"type": "subtitle", "time": 17369.91, "timestamp": "04:49:29", "text": "コンテンツを下げるか、"}, {"type": "subtitle", "time": 17372.47, "timestamp": "04:49:32", "text": "もしそんな可能性が現実になったら、私は"}, {"type": "subtitle", "time": 17375.51, "timestamp": "04:49:35", "text": "私は、あー、タフな"}, {"type": "subtitle", "time": 17378.708, "timestamp": "04:49:38", "text": "位置。いいえ。それで、私は"}, {"type": "subtitle", "time": 17381.35, "timestamp": "04:49:41", "text": "私の友人が、ああ、私は何を"}, {"type": "subtitle", "time": 17383.83, "timestamp": "04:49:43", "text": "する？オリジナルのPNGを作成する必要があります。"}, {"type": "subtitle", "time": 17388.23, "timestamp": "04:49:48", "text": "ジョーエックスのための何か。そして私はこう思う"}, {"type": "subtitle", "time": 17390.07, "timestamp": "04:49:50", "text": "絵の描き方がわからない。やり方がわからない"}, {"type": "subtitle", "time": 17392.39, "timestamp": "04:49:52", "text": "絵を描いたり、その他いろいろ。私はこう思った"}, {"type": "subtitle", "time": 17394.948, "timestamp": "04:49:54", "text": "混乱して心配して、彼らは"}, {"type": "subtitle", "time": 17398.628, "timestamp": "04:49:58", "text": "心配しないで、私が描いてあげるよ。そしてそれは"}]
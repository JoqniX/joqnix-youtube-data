[{"type": "subtitle", "time": 16321.83, "timestamp": "04:32:01", "text": "すごく気持ち悪い奴でね。私は"}, {"type": "subtitle", "time": 16325.51, "timestamp": "04:32:05", "text": "同情しようとしたり、共感しようとしたり、"}, {"type": "subtitle", "time": 16327.99, "timestamp": "04:32:07", "text": "わからない。そう、だって知ってたから。"}, {"type": "subtitle", "time": 16332.149, "timestamp": "04:32:12", "text": "これは、えっと、彼は成熟しているけど"}, {"type": "subtitle", "time": 16335.189, "timestamp": "04:32:15", "text": "また、友達の作り方を知らないことも問題です。"}, {"type": "subtitle", "time": 16338.63, "timestamp": "04:32:18", "text": "しかし、彼のやり方は間違っている"}, {"type": "subtitle", "time": 16342.87, "timestamp": "04:32:22", "text": "だって彼は知らないかもしれないし、私はこう思った"}, {"type": "subtitle", "time": 16346.309, "timestamp": "04:32:26", "text": "ええ、問題は彼が私の"}, {"type": "subtitle", "time": 16350.95, "timestamp": "04:32:30", "text": "彼のSNSの名前は、ああ、私のビッグ"}, {"type": "subtitle", "time": 16355.03, "timestamp": "04:32:35", "text": "兄か姉はジョーなどなど"}, {"type": "subtitle", "time": 16357.429, "timestamp": "04:32:37", "text": "なぜなら彼の被害者である他の人々"}, {"type": "subtitle", "time": 16360.07, "timestamp": "04:32:40", "text": "物事、彼らはこう思うだろう"}, {"type": "subtitle", "time": 16362.389, "timestamp": "04:32:42", "text": "私にDMを送ってきて、「ジョック、なぜ"}, {"type": "subtitle", "time": 16364.87, "timestamp": "04:32:44", "text": "「この人のものを引用しているの？」"}, {"type": "subtitle", "time": 16366.95, "timestamp": "04:32:46", "text": "人々はブロックさえした。そして私はこう思った。"}, {"type": "subtitle", "time": 16369.429, "timestamp": "04:32:49", "text": "「一体何が起こっているんだ？何が起きているんだ？」そして"}, {"type": "subtitle", "time": 16371.59, "timestamp": "04:32:51", "text": "私は制作者の1人に連絡を取り、"}, {"type": "subtitle", "time": 16374.149, "timestamp": "04:32:54", "text": "彼らは言った、「ええ、この人は本当に"}, {"type": "subtitle", "time": 16377.11, "timestamp": "04:32:57", "text": "失礼で本当に無礼で本当に"}]
[{"type": "subtitle", "time": 20940.708, "timestamp": "05:49:00", "text": "この件であなたに金銭を要求したくありません。病気"}, {"type": "subtitle", "time": 20943.35, "timestamp": "05:49:03", "text": "アルバイトとかのためにやってるんだよ。"}, {"type": "subtitle", "time": 20945.83, "timestamp": "05:49:05", "text": "そうやって私は代金を支払ったのです。私は言った"}, {"type": "subtitle", "time": 20949.75, "timestamp": "05:49:09", "text": "「うん、20 を得るよ"}, {"type": "subtitle", "time": 20952.23, "timestamp": "05:49:12", "text": "パートタイム。だから私はただ支払うだけです"}, {"type": "subtitle", "time": 20955.27, "timestamp": "05:49:15", "text": "分割払いは16.4とかだったかな。"}, {"type": "subtitle", "time": 20957.67, "timestamp": "05:49:17", "text": "だから私は少ししか正しく理解できない"}, {"type": "subtitle", "time": 20960.708, "timestamp": "05:49:20", "text": "それ。必要な購読料を支払います"}, {"type": "subtitle", "time": 20963.43, "timestamp": "05:49:23", "text": "ストリームとか全部とか"}, {"type": "subtitle", "time": 20968.23, "timestamp": "05:49:28", "text": "そうしてください。そう、そういうことだったんです。"}, {"type": "subtitle", "time": 20970.39, "timestamp": "05:49:30", "text": "ああ、なんてことだ、そしてその時私は"}, {"type": "subtitle", "time": 20975.43, "timestamp": "05:49:35", "text": "外の人々は、人々が"}, {"type": "subtitle", "time": 20978.23, "timestamp": "05:49:38", "text": "たくさんのことをしたけど、何をすればいいのかわからなかった"}, {"type": "subtitle", "time": 20987.75, "timestamp": "05:49:47", "text": "それは教訓のようなものだったと思う。私は理解した。"}, {"type": "subtitle", "time": 20990.15, "timestamp": "05:49:50", "text": "そこが難しいところだ。"}, {"type": "subtitle", "time": 20996.23, "timestamp": "05:49:56", "text": "それは素晴らしいですね。それはすばらしい。"}, {"type": "subtitle", "time": 20999.51, "timestamp": "05:49:59", "text": "いいことではないけど、そう、"}]
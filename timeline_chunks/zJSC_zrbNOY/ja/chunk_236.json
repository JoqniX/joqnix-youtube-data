[{"type": "subtitle", "time": 14161.349, "timestamp": "03:56:01", "text": "ああ、経験済みだよ。誰かがたくさん言ってくれた"}, {"type": "subtitle", "time": 14163.99, "timestamp": "03:56:03", "text": "他のことについて突然言う"}, {"type": "subtitle", "time": 14166.389, "timestamp": "03:56:06", "text": "先に進んであなたについて行ったので"}, {"type": "subtitle", "time": 14170.15, "timestamp": "03:56:10", "text": "フォローバックしてください。うわぁ。それは"}, {"type": "subtitle", "time": 14181.03, "timestamp": "03:56:21", "text": "私の場合、たくさんのことを設定しました。"}, {"type": "subtitle", "time": 14182.71, "timestamp": "03:56:22", "text": "複数"}, {"type": "subtitle", "time": 14186.389, "timestamp": "03:56:26", "text": "Discordのボットは、"}, {"type": "subtitle", "time": 14189.269, "timestamp": "03:56:29", "text": "検証のこと、キャプチャのこと、"}, {"type": "subtitle", "time": 14192.71, "timestamp": "03:56:32", "text": "すべて。それでもまだガキがいる"}, {"type": "subtitle", "time": 14195.91, "timestamp": "03:56:35", "text": "ある人にとっては"}, {"type": "subtitle", "time": 14198.63, "timestamp": "03:56:38", "text": "キャプチャするのはとても難しかったです。"}, {"type": "subtitle", "time": 14200.229, "timestamp": "03:56:40", "text": "慣れていない人々は"}, {"type": "subtitle", "time": 14202.79, "timestamp": "03:56:42", "text": "Discordの機能が追加されました。だから私は"}, {"type": "subtitle", "time": 14205.59, "timestamp": "03:56:45", "text": "それらについて考えてみてください。それで私は「わかった」って感じだった"}, {"type": "subtitle", "time": 14208.79, "timestamp": "03:56:48", "text": "このチャンネルで認証を受けることができます。"}, {"type": "subtitle", "time": 14211.269, "timestamp": "03:56:51", "text": "そうしなければならない、そう、それはあなただ"}, {"type": "subtitle", "time": 14214.15, "timestamp": "03:56:54", "text": "そこにリダイレクトして、"}, {"type": "subtitle", "time": 14217.51, "timestamp": "03:56:57", "text": "反応的な役割。認証され、"}]
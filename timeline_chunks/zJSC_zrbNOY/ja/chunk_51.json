[{"type": "subtitle", "time": 3060.23, "timestamp": "00:51:00", "text": "でも、それでいいんです"}, {"type": "subtitle", "time": 3062.63, "timestamp": "00:51:02", "text": "私はそこに1年間滞在する予定です。"}, {"type": "subtitle", "time": 3067.43, "timestamp": "00:51:07", "text": "他にどうすればいいの？私は真実を言っているだけよ"}, {"type": "subtitle", "time": 3071.27, "timestamp": "00:51:11", "text": "真実を述べる代わりに"}, {"type": "subtitle", "time": 3073.51, "timestamp": "00:51:13", "text": "予想外の出来事だった"}, {"type": "subtitle", "time": 3077.75, "timestamp": "00:51:17", "text": "もの。どちらにしても、私は"}, {"type": "subtitle", "time": 3080.549, "timestamp": "00:51:20", "text": "私がしたように、すべての崩壊をスピードランする"}, {"type": "subtitle", "time": 3083.99, "timestamp": "00:51:23", "text": "以前はやっていたけど、1ヶ月間だけやった"}, {"type": "subtitle", "time": 3085.67, "timestamp": "00:51:25", "text": "けれど。"}, {"type": "subtitle", "time": 3088.15, "timestamp": "00:51:28", "text": "それ自体が狂気の沙汰だ。私は感じる"}, {"type": "subtitle", "time": 3090.39, "timestamp": "00:51:30", "text": "のように"}, {"type": "subtitle", "time": 3110.549, "timestamp": "00:51:50", "text": "私が考えられるのは"}, {"type": "subtitle", "time": 3113.589, "timestamp": "00:51:53", "text": "今、あるいは今でさえ、私が考えているのは"}, {"type": "subtitle", "time": 3117.829, "timestamp": "00:51:57", "text": "質問は、自分の作業を自動化するにはどうすればいいかということです。どうやって"}]
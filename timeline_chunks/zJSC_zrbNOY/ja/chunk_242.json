[{"type": "subtitle", "time": 14522.63, "timestamp": "04:02:02", "text": "一番いいところは"}, {"type": "subtitle", "time": 14524.15, "timestamp": "04:02:04", "text": "私たちのような国には"}, {"type": "subtitle", "time": 14526.07, "timestamp": "04:02:06", "text": "私たちが都市を建設できる人口"}, {"type": "subtitle", "time": 14535.51, "timestamp": "04:02:15", "text": "実際にあなたを見つけてくれる人。"}, {"type": "subtitle", "time": 14543.349, "timestamp": "04:02:23", "text": "ああ、"}, {"type": "subtitle", "time": 14545.59, "timestamp": "04:02:25", "text": "ドーサはおいしい。"}, {"type": "subtitle", "time": 14548.389, "timestamp": "04:02:28", "text": "ドーサはかなり美味しい。"}, {"type": "subtitle", "time": 14551.03, "timestamp": "04:02:31", "text": "うん。あなたの好きな食べ物は何ですか？"}, {"type": "subtitle", "time": 14553.99, "timestamp": "04:02:33", "text": "あなたはどんな食べ物が好きですか？"}, {"type": "subtitle", "time": 14557.269, "timestamp": "04:02:37", "text": "私は食べ物全般が好きです。しかしその後"}, {"type": "subtitle", "time": 14560.71, "timestamp": "04:02:40", "text": "気分的に言えば、そういう感じですね。だから君みたいに"}, {"type": "subtitle", "time": 14563.91, "timestamp": "04:02:43", "text": "私にとってビリヤニは、私の心の安らぎのようなものです"}, {"type": "subtitle", "time": 14566.15, "timestamp": "04:02:46", "text": "食べ物。うん。"}, {"type": "subtitle", "time": 14568.389, "timestamp": "04:02:48", "text": "だから、私が良い気分じゃないとき"}, {"type": "subtitle", "time": 14570.389, "timestamp": "04:02:50", "text": "日中や少し動揺しているときは、"}, {"type": "subtitle", "time": 14574.309, "timestamp": "04:02:54", "text": "ビリヤニ。そしてもし私のような食べ物があれば"}, {"type": "subtitle", "time": 14576.79, "timestamp": "04:02:56", "text": "どんなに食べても"}, {"type": "subtitle", "time": 14578.309, "timestamp": "04:02:58", "text": "何回作るか"}]
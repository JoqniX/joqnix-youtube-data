[{"type": "subtitle", "time": 604.55, "timestamp": "00:10:04", "text": "私のモッドは私のボーカルが好きではありません"}, {"type": "subtitle", "time": 606.71, "timestamp": "00:10:06", "text": "その歌詞を歌いたい。わからない"}, {"type": "subtitle", "time": 611.19, "timestamp": "00:10:11", "text": "なぜ。難しいからですか？"}, {"type": "subtitle", "time": 619.59, "timestamp": "00:10:19", "text": "難しい。"}, {"type": "subtitle", "time": 622.31, "timestamp": "00:10:22", "text": "なぜ難しいのか？私は与えたくない"}, {"type": "subtitle", "time": 624.79, "timestamp": "00:10:24", "text": "諦めたくない。"}, {"type": "subtitle", "time": 627.03, "timestamp": "00:10:27", "text": "また、私はこれを一時中断した"}, {"type": "subtitle", "time": 628.55, "timestamp": "00:10:28", "text": "歌。"}, {"type": "subtitle", "time": 631.91, "timestamp": "00:10:31", "text": "いや、待って。ええと、それをお見せしましょう。えっと"}, {"type": "subtitle", "time": 635.509, "timestamp": "00:10:35", "text": "すごくテンポの速い曲があったんです。"}, {"type": "subtitle", "time": 637.829, "timestamp": "00:10:37", "text": "ババ・ヤーガの話を聞けば。何てことだ、"}, {"type": "subtitle", "time": 640.389, "timestamp": "00:10:40", "text": "本当に速い。私は歌も歌えない"}, {"type": "subtitle", "time": 642.389, "timestamp": "00:10:42", "text": "これ。"}, {"type": "subtitle", "time": 644.71, "timestamp": "00:10:44", "text": "私にさせて"}, {"type": "subtitle", "time": 647.99, "timestamp": "00:10:47", "text": "ログインする必要があります。あ、待ってください。"}, {"type": "subtitle", "time": 650.31, "timestamp": "00:10:50", "text": "ああ、何か兆候が必要だ。何てことだ。私はしません"}, {"type": "subtitle", "time": 655.43, "timestamp": "00:10:55", "text": "今すぐやりたい。ああ、戻って。"}]
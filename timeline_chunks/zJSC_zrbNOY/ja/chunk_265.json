[{"type": "subtitle", "time": 15902.389, "timestamp": "04:25:02", "text": "彼らだけが「これを受け取れ」のように従うだろう"}, {"type": "subtitle", "time": 15904.71, "timestamp": "04:25:04", "text": "いいね、フォロー、チャットをする瞬間"}, {"type": "subtitle", "time": 15907.349, "timestamp": "04:25:07", "text": "チャットですよね？だから、彼らは手に入れるのを確認する"}, {"type": "subtitle", "time": 15909.91, "timestamp": "04:25:09", "text": "チェックしてすべて"}, {"type": "subtitle", "time": 15911.51, "timestamp": "04:25:11", "text": "そんな感じ。"}, {"type": "subtitle", "time": 15914.229, "timestamp": "04:25:14", "text": "私はまあ、その後は大丈夫かな"}, {"type": "subtitle", "time": 15916.87, "timestamp": "04:25:16", "text": "あのボットの件が起こったんだけど、えっと、私の友達"}, {"type": "subtitle", "time": 15920.469, "timestamp": "04:25:20", "text": "Siriボットを含めるように提案されましたが"}, {"type": "subtitle", "time": 15922.79, "timestamp": "04:25:22", "text": "その後はかなり穏やかだったので"}, {"type": "subtitle", "time": 15925.75, "timestamp": "04:25:25", "text": "私はそういう経験がない"}, {"type": "subtitle", "time": 15929.03, "timestamp": "04:25:29", "text": "まだ事件は起きていないし、対処したくない"}, {"type": "subtitle", "time": 15931.11, "timestamp": "04:25:31", "text": "もうそれについては何も言えない。"}, {"type": "subtitle", "time": 15934.229, "timestamp": "04:25:34", "text": "うん、シェリーは本当に美味しいよ。私はそれが嬉しい"}, {"type": "subtitle", "time": 15936.229, "timestamp": "04:25:36", "text": "私が作ったものです。"}, {"type": "subtitle", "time": 15939.189, "timestamp": "04:25:39", "text": "祝福はいくらでも贈れますし、"}, {"type": "subtitle", "time": 15941.429, "timestamp": "04:25:41", "text": "その方に祝福と祈りを捧げます。その"}, {"type": "subtitle", "time": 15944.309, "timestamp": "04:25:44", "text": "あなたも私たちのためにたくさんのことをしてくれているように。"}, {"type": "subtitle", "time": 15946.35, "timestamp": "04:25:46", "text": "どうもありがとう。"}, {"type": "subtitle", "time": 15948.469, "timestamp": "04:25:48", "text": "[音楽]"}, {"type": "subtitle", "time": 15950.55, "timestamp": "04:25:50", "text": "本当にいい子だ。あればいいのに"}, {"type": "subtitle", "time": 15957.269, "timestamp": "04:25:57", "text": "奇妙な相互作用がありましたか"}, {"type": "subtitle", "time": 15959.67, "timestamp": "04:25:59", "text": "YouTubeとかそういうの？"}]
[{"type": "subtitle", "time": 18000.788, "timestamp": "05:00:00", "text": "非常に高価です。つまり、私はただ"}, {"type": "subtitle", "time": 18003.99, "timestamp": "05:00:03", "text": "昨日のようなモデルを探して"}, {"type": "subtitle", "time": 18007.59, "timestamp": "05:00:07", "text": "値段を見たら、あぁ、"}, {"type": "subtitle", "time": 18014.15, "timestamp": "05:00:14", "text": "辺りは暗かった。"}, {"type": "subtitle", "time": 18017.43, "timestamp": "05:00:17", "text": "うん。 V のようなリギングは"}, {"type": "subtitle", "time": 18022.47, "timestamp": "05:00:22", "text": "例えば、最低基本給は2,000ドルです。どのような？"}, {"type": "subtitle", "time": 18027.67, "timestamp": "05:00:27", "text": "いいえ。そしてとても美しい見た目の、つまりもし"}, {"type": "subtitle", "time": 18029.75, "timestamp": "05:00:29", "text": "アート作品も完成させたいし、"}, {"type": "subtitle", "time": 18032.868, "timestamp": "05:00:32", "text": "あなたが作りたかったもの"}, {"type": "subtitle", "time": 18036.31, "timestamp": "05:00:36", "text": "カスタマイズして、あなたの望むとおりに、"}, {"type": "subtitle", "time": 18038.15, "timestamp": "05:00:38", "text": "とても高額になる可能性がある。覚えているよ、"}, {"type": "subtitle", "time": 18042.31, "timestamp": "05:00:42", "text": "私が見たアーティストの一人は"}, {"type": "subtitle", "time": 18044.15, "timestamp": "05:00:44", "text": "それらはちょっとかわいいアートで、"}, {"type": "subtitle", "time": 18046.47, "timestamp": "05:00:46", "text": "物や、彼らが"}, {"type": "subtitle", "time": 18049.27, "timestamp": "05:00:49", "text": "私のモデルスタイルにふさわしい演技ができ、"}, {"type": "subtitle", "time": 18050.948, "timestamp": "05:00:50", "text": "価格を調べてみたところ、"}, {"type": "subtitle", "time": 18053.51, "timestamp": "05:00:53", "text": "ベースみたいな、ただの描画部分みたいな"}, {"type": "subtitle", "time": 18057.43, "timestamp": "05:00:57", "text": "30,000ドルくらいになるだろうし、私は"}]
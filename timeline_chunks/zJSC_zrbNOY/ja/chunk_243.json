[{"type": "subtitle", "time": 14583.03, "timestamp": "04:03:03", "text": "シンプルなダルチャブやトマトチャツネなど。"}, {"type": "subtitle", "time": 14591.349, "timestamp": "04:03:11", "text": "だから、それはただ、ええと、"}, {"type": "subtitle", "time": 14600.309, "timestamp": "04:03:20", "text": "私の頭というよりはむしろ私の反応"}, {"type": "subtitle", "time": 14603.99, "timestamp": "04:03:23", "text": "山頂に変わった。ああ、マウント"}, {"type": "subtitle", "time": 14610.15, "timestamp": "04:03:30", "text": "私はしません"}, {"type": "subtitle", "time": 14624.71, "timestamp": "04:03:44", "text": "えっと、ちょっと待って"}, {"type": "subtitle", "time": 14626.63, "timestamp": "04:03:46", "text": "雰囲気がすごく落ち着いていて、何とも言えない。"}, {"type": "subtitle", "time": 14629.59, "timestamp": "04:03:49", "text": "私は「うん、これはとてもいい」と思う。"}, {"type": "subtitle", "time": 14631.59, "timestamp": "04:03:51", "text": "ぞっとする。"}, {"type": "subtitle", "time": 14633.83, "timestamp": "04:03:53", "text": "つまり、それは良いことなんです"}, {"type": "subtitle", "time": 14635.99, "timestamp": "04:03:55", "text": "だから私はあまり好きではなかった"}]
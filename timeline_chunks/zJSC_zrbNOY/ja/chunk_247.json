[{"type": "subtitle", "time": 14823.83, "timestamp": "04:07:03", "text": "混合吸入器​​と同じものですよね？"}, {"type": "subtitle", "time": 14829.03, "timestamp": "04:07:09", "text": "うん。中毒性がある。何てことだ。"}, {"type": "subtitle", "time": 14832.389, "timestamp": "04:07:12", "text": "多くの人がそうする。ええ、私は普段そうしています"}, {"type": "subtitle", "time": 14835.03, "timestamp": "04:07:15", "text": "まるで「ノー」があまりにも"}, {"type": "subtitle", "time": 14838.63, "timestamp": "04:07:18", "text": "ゆるい。ええ、それは本当です。えっと、"}, {"type": "subtitle", "time": 14841.99, "timestamp": "04:07:21", "text": "私の、つまり友達は友達全員と"}, {"type": "subtitle", "time": 14844.15, "timestamp": "04:07:24", "text": "私の祖父も同じことをするだろう"}, {"type": "subtitle", "time": 14846.309, "timestamp": "04:07:26", "text": "彼は私がくしゃみをたくさんしていることに気づくだろう"}, {"type": "subtitle", "time": 14849.51, "timestamp": "04:07:29", "text": "くしゃみをしても寒くないような感じ。"}, {"type": "subtitle", "time": 14853.03, "timestamp": "04:07:33", "text": "どちらかというとアレルギー系の症状に近いですね。"}, {"type": "subtitle", "time": 14854.87, "timestamp": "04:07:34", "text": "アレルギー。だから彼は「ああ、"}, {"type": "subtitle", "time": 14857.91, "timestamp": "04:07:37", "text": "「これを吸い込んで。」そして私は「わかった、"}, {"type": "subtitle", "time": 14864.469, "timestamp": "04:07:44", "text": "今、頭痛がするんです。"}, {"type": "subtitle", "time": 14866.55, "timestamp": "04:07:46", "text": "「おそらく気温の変化でしょう。」ああ、いやだ。"}, {"type": "subtitle", "time": 14876.71, "timestamp": "04:07:56", "text": "後退する。うん。私にとっては、えっと、以前は"}]
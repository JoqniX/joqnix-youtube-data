[{"type": "subtitle", "time": 20701.11, "timestamp": "05:45:01", "text": "これは事実だ。"}, {"type": "subtitle", "time": 20704.07, "timestamp": "05:45:04", "text": "あなた"}, {"type": "subtitle", "time": 20706.868, "timestamp": "05:45:06", "text": "だって、えっと、父にこう尋ねたんだ"}, {"type": "subtitle", "time": 20709.11, "timestamp": "05:45:09", "text": "物乞いのように"}, {"type": "subtitle", "time": 20711.43, "timestamp": "05:45:11", "text": "最初はジョックのようなことをする前に"}, {"type": "subtitle", "time": 20714.31, "timestamp": "05:45:14", "text": "YouTuberになるにあたって、私は音楽が好きでした"}, {"type": "subtitle", "time": 20716.23, "timestamp": "05:45:16", "text": "音楽制作関連のものすべて"}, {"type": "subtitle", "time": 20718.39, "timestamp": "05:45:18", "text": "だから次にジョックを作ったんだ、なぜなら"}, {"type": "subtitle", "time": 20721.43, "timestamp": "05:45:21", "text": "自分の音楽をリリースして"}, {"type": "subtitle", "time": 20723.75, "timestamp": "05:45:23", "text": "アーティスト名と音楽を作るすべて"}, {"type": "subtitle", "time": 20725.35, "timestamp": "05:45:25", "text": "そして人々を幸せにし、すべてを行う"}, {"type": "subtitle", "time": 20728.47, "timestamp": "05:45:28", "text": "私は、以前は、"}, {"type": "subtitle", "time": 20730.788, "timestamp": "05:45:30", "text": "YouTubeのチュートリアルを見て学んだけど、"}, {"type": "subtitle", "time": 20732.788, "timestamp": "05:45:32", "text": "クリエイティブなブログ、音楽ブログのようなものですね。"}, {"type": "subtitle", "time": 20735.35, "timestamp": "05:45:35", "text": "そして私は「ああ、これは無理だ」と思った。それで"}, {"type": "subtitle", "time": 20737.11, "timestamp": "05:45:37", "text": "それが私がYouTubeを始めたきっかけで、"}, {"type": "subtitle", "time": 20740.39, "timestamp": "05:45:40", "text": "他のニッチ市場を発見する、えっと、それは"}, {"type": "subtitle", "time": 20743.51, "timestamp": "05:45:43", "text": "私が得意なことと、その他すべてと"}, {"type": "subtitle", "time": 20747.91, "timestamp": "05:45:47", "text": "私はインスタグラムの広告を見たのですが、"}, {"type": "subtitle", "time": 20749.51, "timestamp": "05:45:49", "text": "音楽制作をするのが好きな人"}, {"type": "subtitle", "time": 20751.27, "timestamp": "05:45:51", "text": "もちろん、すべてにおいて。私は彼らの"}, {"type": "subtitle", "time": 20753.67, "timestamp": "05:45:53", "text": "無料トライアルみたいな2日間のブート"}, {"type": "subtitle", "time": 20755.99, "timestamp": "05:45:55", "text": "キャンプ。私は「ああ、彼らは"}, {"type": "subtitle", "time": 20758.868, "timestamp": "05:45:58", "text": "教えることは私が学んだことだ"}]
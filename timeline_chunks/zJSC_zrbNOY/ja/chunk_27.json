[{"type": "subtitle", "time": 1646.47, "timestamp": "00:27:26", "text": "どちらが真実なのか私には分かりません。誰が"}, {"type": "subtitle", "time": 1649.43, "timestamp": "00:27:29", "text": "右？実在したのは誰だったのか？誰が本物なのか？"}, {"type": "subtitle", "time": 1651.35, "timestamp": "00:27:31", "text": "本物。"}, {"type": "subtitle", "time": 1655.43, "timestamp": "00:27:35", "text": "これは本当に難しい"}, {"type": "subtitle", "time": 1659.75, "timestamp": "00:27:39", "text": "だって最近は"}, {"type": "subtitle", "time": 1661.99, "timestamp": "00:27:41", "text": "たとえ誰かが本当に望んでいても"}, {"type": "subtitle", "time": 1664.39, "timestamp": "00:27:44", "text": "何かをする、"}]
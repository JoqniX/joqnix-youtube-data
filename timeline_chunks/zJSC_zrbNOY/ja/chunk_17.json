[{"type": "subtitle", "time": 1020.069, "timestamp": "00:17:00", "text": "そして"}, {"type": "subtitle", "time": 1023.03, "timestamp": "00:17:03", "text": "私はこう考えていました。「ああ、"}, {"type": "subtitle", "time": 1026.549, "timestamp": "00:17:06", "text": "私も何かしたいんです"}, {"type": "subtitle", "time": 1029.99, "timestamp": "00:17:09", "text": "そういうところがクールだね。まるで私がそうではなかったかのように、私は"}, {"type": "subtitle", "time": 1033.59, "timestamp": "00:17:13", "text": "知らない人のような"}, {"type": "subtitle", "time": 1035.189, "timestamp": "00:17:15", "text": "コーディング"}, {"type": "subtitle", "time": 1039.029, "timestamp": "00:17:19", "text": "しかし、それは私が"}, {"type": "subtitle", "time": 1042.47, "timestamp": "00:17:22", "text": "物事を学び、物事をしたいという気持ち"}, {"type": "subtitle", "time": 1045.829, "timestamp": "00:17:25", "text": "ずっとやりたかったこと"}, {"type": "subtitle", "time": 1048.549, "timestamp": "00:17:28", "text": "右と"}, {"type": "subtitle", "time": 1051.669, "timestamp": "00:17:31", "text": "私の"}, {"type": "subtitle", "time": 1054.07, "timestamp": "00:17:34", "text": "物事を理解する時間"}, {"type": "subtitle", "time": 1057.029, "timestamp": "00:17:37", "text": "コーディング関連ですが、私は知りません"}, {"type": "subtitle", "time": 1058.789, "timestamp": "00:17:38", "text": "何でも"}, {"type": "subtitle", "time": 1062.07, "timestamp": "00:17:42", "text": "とても良かった。だから、ほら、"}, {"type": "subtitle", "time": 1065.19, "timestamp": "00:17:45", "text": "何がより良いか、そして何よりずっと良いか"}, {"type": "subtitle", "time": 1067.19, "timestamp": "00:17:47", "text": "実は"}, {"type": "subtitle", "time": 1071.669, "timestamp": "00:17:51", "text": "様子を見てみよう。私も"}, {"type": "subtitle", "time": 1075.99, "timestamp": "00:17:55", "text": "革新的なことをたくさんやりたい。それで、"}, {"type": "subtitle", "time": 1079.59, "timestamp": "00:17:59", "text": "私はずっとそれをやりたかった"}]
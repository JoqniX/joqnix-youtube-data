[{"type": "subtitle", "time": 14700.71, "timestamp": "04:05:00", "text": "外向的な人なのか、私にはわからない。"}, {"type": "subtitle", "time": 14703.59, "timestamp": "04:05:03", "text": "うん。"}, {"type": "subtitle", "time": 14708.95, "timestamp": "04:05:08", "text": "待って、あなたは外向的なの？"}, {"type": "subtitle", "time": 14712.229, "timestamp": "04:05:12", "text": "私と同じように内向的な人ですか？私はかなり内向的な性格です。"}, {"type": "subtitle", "time": 14715.91, "timestamp": "04:05:15", "text": "私が好きなものは、私は生き残ることができます。"}, {"type": "subtitle", "time": 14718.389, "timestamp": "04:05:18", "text": "私はただ誰かのペルソナを演じるだけです"}, {"type": "subtitle", "time": 14720.79, "timestamp": "04:05:20", "text": "誰が、あの、手渡すことができるのか"}, {"type": "subtitle", "time": 14724.63, "timestamp": "04:05:24", "text": "社会的交流やその他すべてだが、"}, {"type": "subtitle", "time": 14726.55, "timestamp": "04:05:26", "text": "一日の終わりには、もし私ができるなら"}, {"type": "subtitle", "time": 14731.83, "timestamp": "04:05:31", "text": "家から出ないようにするよ"}, {"type": "subtitle", "time": 14735.11, "timestamp": "04:05:35", "text": "ああ、SPで問題が発生しました"}, {"type": "subtitle", "time": 14737.03, "timestamp": "04:05:37", "text": "いつかは、だって私は行かなきゃいけないって分かってるから"}, {"type": "subtitle", "time": 14740.07, "timestamp": "04:05:40", "text": "外に出てこれをやるけど、家は快適"}, {"type": "subtitle", "time": 14742.309, "timestamp": "04:05:42", "text": "家。"}, {"type": "subtitle", "time": 14745.189, "timestamp": "04:05:45", "text": "ベッドがないと、"}, {"type": "subtitle", "time": 14747.99, "timestamp": "04:05:47", "text": "虫歯。一度眠ってしまうと、"}, {"type": "subtitle", "time": 14751.189, "timestamp": "04:05:51", "text": "起き上がるためのもの。"}, {"type": "subtitle", "time": 14753.99, "timestamp": "04:05:53", "text": "それは私です。"}, {"type": "subtitle", "time": 14757.67, "timestamp": "04:05:57", "text": "何てことだ。それは私です。うん。わかった。ルナ"}]
[{"type": "subtitle", "time": 18902.15, "timestamp": "05:15:02", "text": "またはOBSを開くと、100%"}, {"type": "subtitle", "time": 18905.11, "timestamp": "05:15:05", "text": "ストリーミングなしでもCPUは"}, {"type": "subtitle", "time": 18907.67, "timestamp": "05:15:07", "text": "私はたくさんのものを持っていた。だから私は"}, {"type": "subtitle", "time": 18910.55, "timestamp": "05:15:10", "text": "分解して、取り除いて、たくさん"}, {"type": "subtitle", "time": 18912.868, "timestamp": "05:15:12", "text": "もの。私はそうしました"}, {"type": "subtitle", "time": 18914.708, "timestamp": "05:15:14", "text": "ずっと昔、水路の地点があった"}, {"type": "subtitle", "time": 18918.708, "timestamp": "05:15:18", "text": "人々が私のPCをシャットダウンできる場所。"}, {"type": "subtitle", "time": 18920.628, "timestamp": "05:15:20", "text": "おお"}, {"type": "subtitle", "time": 18924.31, "timestamp": "05:15:24", "text": "うん、そう、それは、"}, {"type": "subtitle", "time": 18927.11, "timestamp": "05:15:27", "text": "人々はとてもハイだった"}, {"type": "subtitle", "time": 18929.11, "timestamp": "05:15:29", "text": "料金"}, {"type": "subtitle", "time": 18932.47, "timestamp": "05:15:32", "text": "そしてそれは新しいタイプの"}, {"type": "subtitle", "time": 18936.708, "timestamp": "05:15:36", "text": "カウントダウンみたいなアラートみたいなもの。えっと、それで私は"}, {"type": "subtitle", "time": 18939.03, "timestamp": "05:15:39", "text": "もし何かを保存しなければならないとしたら、"}, {"type": "subtitle", "time": 18942.31, "timestamp": "05:15:42", "text": "カウントダウンが始まる前に保存してください"}, {"type": "subtitle", "time": 18945.59, "timestamp": "05:15:45", "text": "ゼロになり、シャットダウンします。"}, {"type": "subtitle", "time": 18948.708, "timestamp": "05:15:48", "text": "時々自動的に再起動します"}, {"type": "subtitle", "time": 18951.67, "timestamp": "05:15:51", "text": "再び起動して起動する"}, {"type": "subtitle", "time": 18953.59, "timestamp": "05:15:53", "text": "すべて自動的に開始されます"}, {"type": "subtitle", "time": 18956.708, "timestamp": "05:15:56", "text": "再び流れが聞こえ、彼は私の声を聞くことができる"}, {"type": "subtitle", "time": 18958.23, "timestamp": "05:15:58", "text": "残念だった。"}]
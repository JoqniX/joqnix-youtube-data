[{"type": "subtitle", "time": 17760.628, "timestamp": "04:56:00", "text": "それは、あなたがどのように見たいかに基づいているようなものです"}, {"type": "subtitle", "time": 17763.91, "timestamp": "04:56:03", "text": "それ。ジョーは男性でもあり、ジョーは"}, {"type": "subtitle", "time": 17766.39, "timestamp": "04:56:06", "text": "女性、まあ、性別みたいなものだから"}, {"type": "subtitle", "time": 17768.31, "timestamp": "04:56:08", "text": "中立的なものですよね？だから私はこう思った"}, {"type": "subtitle", "time": 17772.788, "timestamp": "04:56:12", "text": "それを目指している。そう、そして私は"}, {"type": "subtitle", "time": 17776.15, "timestamp": "04:56:16", "text": "モデルで、私はかつて尋ねていました"}, {"type": "subtitle", "time": 17780.788, "timestamp": "04:56:20", "text": "リギングの予算はいくらですか？えっと"}, {"type": "subtitle", "time": 17783.67, "timestamp": "04:56:23", "text": "予算はいくらですか？どうして私が"}, {"type": "subtitle", "time": 17786.07, "timestamp": "04:56:26", "text": "今すぐ誰かを見つける必要がある"}, {"type": "subtitle", "time": 17788.47, "timestamp": "04:56:28", "text": "予算を組んで委託し、"}, {"type": "subtitle", "time": 17792.628, "timestamp": "04:56:32", "text": "すべて、そしてそう"}, {"type": "subtitle", "time": 17795.59, "timestamp": "04:56:35", "text": "彼らは、何かが起こっているので待つようにと言った"}, {"type": "subtitle", "time": 17798.55, "timestamp": "04:56:38", "text": "えっと、それで私は2月まで待ったんです"}, {"type": "subtitle", "time": 17801.35, "timestamp": "04:56:41", "text": "今年の"}, {"type": "subtitle", "time": 17805.67, "timestamp": "04:56:45", "text": "勇気を出して聞いてみたら、いや、いや、"}, {"type": "subtitle", "time": 17807.51, "timestamp": "04:56:47", "text": "このことはうまくいかなかった。"}, {"type": "subtitle", "time": 17810.948, "timestamp": "04:56:50", "text": "主要な業務に集中する。だから私はこう思った、"}, {"type": "subtitle", "time": 17814.39, "timestamp": "04:56:54", "text": "「ああ、どうしよう？」そして、それは"}, {"type": "subtitle", "time": 17817.19, "timestamp": "04:56:57", "text": "これからは失礼な態度をとるだろう。たぶん私は"}, {"type": "subtitle", "time": 17819.83, "timestamp": "04:56:59", "text": "感情的なタイプ、たぶん私はそれを考えた"}]
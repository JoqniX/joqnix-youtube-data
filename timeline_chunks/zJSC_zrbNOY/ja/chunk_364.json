[{"type": "subtitle", "time": 21841.11, "timestamp": "06:04:01", "text": "うん。"}, {"type": "subtitle", "time": 21842.708, "timestamp": "06:04:02", "text": "学ぶべきことがたくさんある"}, {"type": "subtitle", "time": 21844.788, "timestamp": "06:04:04", "text": "料理もね。"}, {"type": "subtitle", "time": 21846.39, "timestamp": "06:04:06", "text": "おお。"}, {"type": "subtitle", "time": 21849.43, "timestamp": "06:04:09", "text": "そうそう。たくさんのこと。ええ、料理"}, {"type": "subtitle", "time": 21851.83, "timestamp": "06:04:11", "text": "楽しいです。ただ、私は物を燃やすのが好きで"}, {"type": "subtitle", "time": 21855.35, "timestamp": "06:04:15", "text": "たくさんあって、物事を台無しにする。だから私はこう思う、私は"}, {"type": "subtitle", "time": 21858.548, "timestamp": "06:04:18", "text": "料理が苦手です。でも楽しいよ"}, {"type": "subtitle", "time": 21860.628, "timestamp": "06:04:20", "text": "人々のために料理をしたり、いろいろなものを作ったりする。いいえ、"}, {"type": "subtitle", "time": 21864.23, "timestamp": "06:04:24", "text": "慣れると本当に楽しい"}, {"type": "subtitle", "time": 21866.47, "timestamp": "06:04:26", "text": "もの。私は好きだと思う"}, {"type": "subtitle", "time": 21870.15, "timestamp": "06:04:30", "text": "私の家族のために料理をするのが大好きです"}, {"type": "subtitle", "time": 21874.868, "timestamp": "06:04:34", "text": "私がプロフェッショナルだった頃と比べて"}, {"type": "subtitle", "time": 21878.868, "timestamp": "06:04:38", "text": "数週間キッチンで"}, {"type": "subtitle", "time": 21883.03, "timestamp": "06:04:43", "text": "1ヶ月かほぼ1ヶ月を考えてみて"}, {"type": "subtitle", "time": 21885.75, "timestamp": "06:04:45", "text": "業務用キッチンで、私は本当に"}, {"type": "subtitle", "time": 21889.91, "timestamp": "06:04:49", "text": "ああ、私は好きじゃないって気づいた"}, {"type": "subtitle", "time": 21896.628, "timestamp": "06:04:56", "text": "料理をするのは"}, {"type": "subtitle", "time": 21899.11, "timestamp": "06:04:59", "text": "私の仲間たちと私の家族のために、"}]
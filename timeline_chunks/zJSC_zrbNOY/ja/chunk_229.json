[{"type": "subtitle", "time": 13743.269, "timestamp": "03:49:03", "text": "うん。それはすばらしい。"}, {"type": "subtitle", "time": 13745.429, "timestamp": "03:49:05", "text": "彼女は素晴らしかった。"}, {"type": "subtitle", "time": 13748.07, "timestamp": "03:49:08", "text": "それは本当です、だって、私はそうしなければならないからです"}, {"type": "subtitle", "time": 13750.309, "timestamp": "03:49:10", "text": "友達にも感謝しているよ、だって彼らは"}, {"type": "subtitle", "time": 13752.229, "timestamp": "03:49:12", "text": "彼らもそれを本当に支持していたので"}, {"type": "subtitle", "time": 13755.11, "timestamp": "03:49:15", "text": "ボタンを押すのがとても怖かったのを覚えています"}, {"type": "subtitle", "time": 13758.55, "timestamp": "03:49:18", "text": "ストリーミング開始ボタン。"}, {"type": "subtitle", "time": 13761.51, "timestamp": "03:49:21", "text": "その上にマウスを置いていたんだけど"}, {"type": "subtitle", "time": 13764.229, "timestamp": "03:49:24", "text": "私はただ、手を離して"}, {"type": "subtitle", "time": 13771.269, "timestamp": "03:49:31", "text": "そして兄は兄らしく、"}, {"type": "subtitle", "time": 13772.63, "timestamp": "03:49:32", "text": "やって来て、彼はこう言った。「君は"}, {"type": "subtitle", "time": 13774.469, "timestamp": "03:49:34", "text": "「何をしているの？」と聞かれたので、「えっと、考えているのは…」と答えた。"}, {"type": "subtitle", "time": 13776.229, "timestamp": "03:49:36", "text": "ストリーミング配信して、彼はただ"}, {"type": "subtitle", "time": 13777.75, "timestamp": "03:49:37", "text": "ボタンをクリックして立ち去った。"}, {"type": "subtitle", "time": 13780.15, "timestamp": "03:49:40", "text": "それからストリーミングを始めたんだけど、"}, {"type": "subtitle", "time": 13784.95, "timestamp": "03:49:44", "text": "「よし、これで生放送開始だね。」"}, {"type": "subtitle", "time": 13788.309, "timestamp": "03:49:48", "text": "ああ、それは素晴らしいですね。"}, {"type": "subtitle", "time": 13795.03, "timestamp": "03:49:55", "text": "それはいいですね、"}, {"type": "subtitle", "time": 13799.429, "timestamp": "03:49:59", "text": "えっと、何て言うんだっけ？"}]
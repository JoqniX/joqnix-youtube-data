[{"type": "subtitle", "time": 21909.51, "timestamp": "06:05:09", "text": "うん、それはいいね。"}, {"type": "subtitle", "time": 21911.99, "timestamp": "06:05:11", "text": "家族や友人のために料理をする、"}, {"type": "subtitle", "time": 21915.51, "timestamp": "06:05:15", "text": "テーブルを囲んで一緒に食事をする。"}, {"type": "subtitle", "time": 21918.47, "timestamp": "06:05:18", "text": "楽しいよ。えっと、彼らは"}, {"type": "subtitle", "time": 21920.548, "timestamp": "06:05:20", "text": "彼らが欲しいものを教えてくれる"}, {"type": "subtitle", "time": 21923.75, "timestamp": "06:05:23", "text": "または、ご覧ください。えっと、彼らは私が何かを試みるのを見ています"}, {"type": "subtitle", "time": 21925.35, "timestamp": "06:05:25", "text": "そして私はただ「わかった、私はただ"}, {"type": "subtitle", "time": 21927.35, "timestamp": "06:05:27", "text": "やってみます。もしそうならなかったら"}, {"type": "subtitle", "time": 21929.27, "timestamp": "06:05:29", "text": "それは素晴らしいので、食べなければなりません"}, {"type": "subtitle", "time": 21931.83, "timestamp": "06:05:31", "text": "そうだね。"}, {"type": "subtitle", "time": 21935.35, "timestamp": "06:05:35", "text": "だから、ありがたいことに、"}, {"type": "subtitle", "time": 21937.83, "timestamp": "06:05:37", "text": "失敗だった、だってたとえ"}, {"type": "subtitle", "time": 21941.27, "timestamp": "06:05:41", "text": "想像していたのと違って、期待していたのと違っていた"}, {"type": "subtitle", "time": 21944.62, "timestamp": "06:05:44", "text": "しかし、それはなぜか受け入れやすかった。"}, {"type": "subtitle", "time": 21946.23, "timestamp": "06:05:46", "text": "[音楽]"}, {"type": "subtitle", "time": 21949.27, "timestamp": "06:05:49", "text": "私はMacで実験していたのを覚えています"}, {"type": "subtitle", "time": 21951.03, "timestamp": "06:05:51", "text": "弟が欲しがっていたので、チーズもあげました。"}, {"type": "subtitle", "time": 21953.27, "timestamp": "06:05:53", "text": "試してみたら、今まで一度も"}, {"type": "subtitle", "time": 21955.99, "timestamp": "06:05:55", "text": "できたけど、まあ、ぶっつけ本番でやるよ"}, {"type": "subtitle", "time": 21958.39, "timestamp": "06:05:58", "text": "それ。"}]
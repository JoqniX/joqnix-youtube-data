[{"type": "subtitle", "time": 360.79, "timestamp": "00:06:00", "text": "少し歌ったと思うけど、"}, {"type": "subtitle", "time": 363.83, "timestamp": "00:06:03", "text": "知る。でも、私は必ず上達します。"}, {"type": "subtitle", "time": 365.99, "timestamp": "00:06:05", "text": "でも一番大切なのは、私が"}, {"type": "subtitle", "time": 369.83, "timestamp": "00:06:09", "text": "歌うことはできるが、"}, {"type": "subtitle", "time": 374.07, "timestamp": "00:06:14", "text": "まるで間違いが多すぎるみたいだ。この長い歌。"}, {"type": "subtitle", "time": 376.79, "timestamp": "00:06:16", "text": "それは素晴らしいですね。"}, {"type": "subtitle", "time": 379.029, "timestamp": "00:06:19", "text": "しかし、ペースは遅い。私はしなければならない"}, {"type": "subtitle", "time": 382.79, "timestamp": "00:06:22", "text": "これは、難易度の高い長めの曲向けです。"}, {"type": "subtitle", "time": 386.71, "timestamp": "00:06:26", "text": "ゆっくりゆっくりゆっくり"}]
[{"type": "subtitle", "time": 19261.27, "timestamp": "05:21:01", "text": "みんな。それで、次の建物は、えーと"}, {"type": "subtitle", "time": 19264.15, "timestamp": "05:21:04", "text": "私の家の前、えっと、隣に"}, {"type": "subtitle", "time": 19270.15, "timestamp": "05:21:10", "text": "ホステルのような感じだ。だから彼らは私がかつて何をしたか"}, {"type": "subtitle", "time": 19273.99, "timestamp": "05:21:13", "text": "人々はとても叫んだ"}, {"type": "subtitle", "time": 19276.868, "timestamp": "05:21:16", "text": "ホストが私の家に来て、"}, {"type": "subtitle", "time": 19280.07, "timestamp": "05:21:20", "text": "何が起こったのかとか、そういうことを聞いている。"}, {"type": "subtitle", "time": 19282.628, "timestamp": "05:21:22", "text": "あれは本当に恥ずかしかった。"}, {"type": "subtitle", "time": 19285.51, "timestamp": "05:21:25", "text": "何てことだ。なぜならそれは"}, {"type": "subtitle", "time": 19289.11, "timestamp": "05:21:29", "text": "えーと、もし、もし、そして私たちが目標を達成したら、私は"}, {"type": "subtitle", "time": 19291.99, "timestamp": "05:21:31", "text": "非常に慎重に"}, {"type": "subtitle", "time": 19295.19, "timestamp": "05:21:35", "text": "家族にこれをやるつもりだと伝えてください"}, {"type": "subtitle", "time": 19298.23, "timestamp": "05:21:38", "text": "そして、もしあなたが私の叫び声や怒鳴り声を聞いたら、"}, {"type": "subtitle", "time": 19302.628, "timestamp": "05:21:42", "text": "何でもいいから、心配しないで、私は大丈夫。"}, {"type": "subtitle", "time": 19304.47, "timestamp": "05:21:44", "text": "ホラーゲームをプレイするだけです"}, {"type": "subtitle", "time": 19306.708, "timestamp": "05:21:46", "text": "もしくは、みんなが"}, {"type": "subtitle", "time": 19309.03, "timestamp": "05:21:49", "text": "町を出る、もしくは私は、えーと"}, {"type": "subtitle", "time": 19311.03, "timestamp": "05:21:51", "text": "みんな外で一日を過ごすのに忙しい"}, {"type": "subtitle", "time": 19314.39, "timestamp": "05:21:54", "text": "彼らの家で、その日を計画する"}, {"type": "subtitle", "time": 19316.91, "timestamp": "05:21:56", "text": "うん、今日はプレイする日だ。"}]
[{"type": "subtitle", "time": 10680.309, "timestamp": "02:58:00", "text": "私だけど、"}, {"type": "subtitle", "time": 10693.91, "timestamp": "02:58:13", "text": "わかった。えっと、また戻ってきます。私は取らなければならない"}, {"type": "subtitle", "time": 10697.99, "timestamp": "02:58:17", "text": "マイクを私と一緒に持って、またオンにしてください。"}, {"type": "subtitle", "time": 10701.03, "timestamp": "02:58:21", "text": "それは部屋の中にあると信じてください。"}, {"type": "subtitle", "time": 10704.389, "timestamp": "02:58:24", "text": "はい、少々お待ちください。"}, {"type": "subtitle", "time": 10714.63, "timestamp": "02:58:34", "text": "もう一度確認します"}, {"type": "subtitle", "time": 10720.71, "timestamp": "02:58:40", "text": "つまり、私は倍にしなければならない"}, {"type": "subtitle", "time": 10722.79, "timestamp": "02:58:42", "text": "チェックする"}]
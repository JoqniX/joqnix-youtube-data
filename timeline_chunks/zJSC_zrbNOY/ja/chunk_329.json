[{"type": "subtitle", "time": 19747.83, "timestamp": "05:29:07", "text": "うん。次にストライプが招待されます。"}, {"type": "subtitle", "time": 19749.91, "timestamp": "05:29:09", "text": "ストライプは別のタイプの"}, {"type": "subtitle", "time": 19752.47, "timestamp": "05:29:12", "text": "頭痛。それで"}, {"type": "subtitle", "time": 19756.948, "timestamp": "05:29:16", "text": "えっと、なるほど、そういうことですね"}, {"type": "subtitle", "time": 19758.708, "timestamp": "05:29:18", "text": "良い機能も備えているが、同時に"}, {"type": "subtitle", "time": 19761.03, "timestamp": "05:29:21", "text": "転送に時間がかかる"}, {"type": "subtitle", "time": 19764.15, "timestamp": "05:29:24", "text": "お金。ああ"}, {"type": "subtitle", "time": 19767.91, "timestamp": "05:29:27", "text": "だって、えーと、私が受け取った時はいつでも"}, {"type": "subtitle", "time": 19772.15, "timestamp": "05:29:32", "text": "電話料金の支払い"}, {"type": "subtitle", "time": 19774.15, "timestamp": "05:29:34", "text": "だって、インドにはそういうのがないから"}, {"type": "subtitle", "time": 19776.39, "timestamp": "05:29:36", "text": "自動の、ええと、私たちが"}, {"type": "subtitle", "time": 19777.67, "timestamp": "05:29:37", "text": "直接ギフトを受け取る"}, {"type": "subtitle", "time": 19780.948, "timestamp": "05:29:40", "text": "支払い。ああ、そうそうそうそう。"}, {"type": "subtitle", "time": 19788.23, "timestamp": "05:29:48", "text": "うん、受け取ったよ、大丈夫、受け取ったよ"}, {"type": "subtitle", "time": 19791.19, "timestamp": "05:29:51", "text": "支払いは完了したが、私は"}, {"type": "subtitle", "time": 19794.31, "timestamp": "05:29:54", "text": "支払いを受け取ります。"}, {"type": "subtitle", "time": 19795.83, "timestamp": "05:29:55", "text": "1週間以上経ったと思うし、"}, {"type": "subtitle", "time": 19798.788, "timestamp": "05:29:58", "text": "パニックになり始めた"}]
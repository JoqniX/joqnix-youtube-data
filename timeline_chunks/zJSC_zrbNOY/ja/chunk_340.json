[{"type": "subtitle", "time": 20402.23, "timestamp": "05:40:02", "text": "お金が入ってくる、収入が入ってくる、"}, {"type": "subtitle", "time": 20404.788, "timestamp": "05:40:04", "text": "すでに控除されているのは"}, {"type": "subtitle", "time": 20407.11, "timestamp": "05:40:07", "text": "メンテナンス不足またはバランス不良"}, {"type": "subtitle", "time": 20410.07, "timestamp": "05:40:10", "text": "あれ。だから私は「うん、手に入れたよ」って言ったんだ"}, {"type": "subtitle", "time": 20413.67, "timestamp": "05:40:13", "text": "今日、Twitchで稼いだお金。ええ、私が取ります。"}, {"type": "subtitle", "time": 20415.67, "timestamp": "05:40:15", "text": "PayPalは2日かかるから、"}, {"type": "subtitle", "time": 20418.868, "timestamp": "05:40:18", "text": "それを私たちの銀行に送ってください。ええ、私は"}, {"type": "subtitle", "time": 20420.948, "timestamp": "05:40:20", "text": "「うん、私がもらうよ」って感じで言った。だから何"}, {"type": "subtitle", "time": 20422.628, "timestamp": "05:40:22", "text": "私はすぐにそうするつもりです"}, {"type": "subtitle", "time": 20424.708, "timestamp": "05:40:24", "text": "引き出して手元に保管し、"}, {"type": "subtitle", "time": 20428.788, "timestamp": "05:40:28", "text": "それを持ち上げる。そして可能であれば、えっと、"}, {"type": "subtitle", "time": 20430.628, "timestamp": "05:40:30", "text": "現在の銀行口座の手続きをしてください。それで"}, {"type": "subtitle", "time": 20433.35, "timestamp": "05:40:33", "text": "そうすれば銀行口座を維持できる"}, {"type": "subtitle", "time": 20436.23, "timestamp": "05:40:36", "text": "ジョックの首の物、ジョックニックの物、"}, {"type": "subtitle", "time": 20439.43, "timestamp": "05:40:39", "text": "いや、そう、私がどんなお金を手に入れようとも"}, {"type": "subtitle", "time": 20441.59, "timestamp": "05:40:41", "text": "そこに置いておいて触らないでもいいですか？"}, {"type": "subtitle", "time": 20444.47, "timestamp": "05:40:44", "text": "今。だから私はしないよ、なぜなら私は"}, {"type": "subtitle", "time": 20446.788, "timestamp": "05:40:46", "text": "サブスクリプションとかその他いろいろ"}, {"type": "subtitle", "time": 20448.548, "timestamp": "05:40:48", "text": "これは私のメインバンクから引き落として、"}, {"type": "subtitle", "time": 20451.51, "timestamp": "05:40:51", "text": "すべて。だから、私にはわからない"}, {"type": "subtitle", "time": 20455.03, "timestamp": "05:40:55", "text": "すべてを持ち去る。たとえ私が"}, {"type": "subtitle", "time": 20458.23, "timestamp": "05:40:58", "text": "貯金袋を用意しておこう、何かが起こるかもしれない"}]
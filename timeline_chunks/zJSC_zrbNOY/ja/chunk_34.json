[{"type": "subtitle", "time": 2077.99, "timestamp": "00:34:37", "text": "待って。複数の会計処理を希望しますが、プロを優先します"}, {"type": "subtitle", "time": 2080.79, "timestamp": "00:34:40", "text": "真正性において協調することを禁止または"}, {"type": "subtitle", "time": 2086.23, "timestamp": "00:34:46", "text": "会話やサブXを明確に表現する。"}, {"type": "subtitle", "time": 2088.71, "timestamp": "00:34:48", "text": "私たちはコメディパーティーが大好きです"}, {"type": "subtitle", "time": 2093.109, "timestamp": "00:34:53", "text": "これは、あなたが見つけることができると私たちが信じていることです"}]
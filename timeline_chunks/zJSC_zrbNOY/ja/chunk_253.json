[{"type": "subtitle", "time": 15180.309, "timestamp": "04:13:00", "text": "そうだったのか？私はバンガロールにいました"}, {"type": "subtitle", "time": 15181.91, "timestamp": "04:13:01", "text": "インターンシップ"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "そして、私はそのラーメンにとても満足しました。私"}, {"type": "subtitle", "time": 15188.95, "timestamp": "04:13:08", "text": "本当に美味しかったよ。"}, {"type": "subtitle", "time": 15190.63, "timestamp": "04:13:10", "text": "A"}, {"type": "subtitle", "time": 15194.469, "timestamp": "04:13:14", "text": "私は本当に、えっと、実は"}, {"type": "subtitle", "time": 15197.429, "timestamp": "04:13:17", "text": "私はそこで時間をより有効に活用し、"}, {"type": "subtitle", "time": 15199.67, "timestamp": "04:13:19", "text": "食に関する探求。それで私はトウモロコシを持っていた"}, {"type": "subtitle", "time": 15203.03, "timestamp": "04:13:23", "text": "犬と、えっと"}, {"type": "subtitle", "time": 15207.269, "timestamp": "04:13:27", "text": "ラーメン、えっと、私はただそれを使うだけです"}, {"type": "subtitle", "time": 15209.429, "timestamp": "04:13:29", "text": "物質やその他の食品配達アプリ"}, {"type": "subtitle", "time": 15211.91, "timestamp": "04:13:31", "text": "何か買ってきてくれよ。理由のいくつか"}, {"type": "subtitle", "time": 15214.07, "timestamp": "04:13:34", "text": "それも、"}, {"type": "subtitle", "time": 15217.11, "timestamp": "04:13:37", "text": "私がルームシェアしていた人は"}, {"type": "subtitle", "time": 15220.149, "timestamp": "04:13:40", "text": "食べ物をたくさん食べて、"}, {"type": "subtitle", "time": 15222.149, "timestamp": "04:13:42", "text": "少しずつかじり始めて"}, {"type": "subtitle", "time": 15224.87, "timestamp": "04:13:44", "text": "ある時点を過ぎると、"}, {"type": "subtitle", "time": 15228.229, "timestamp": "04:13:48", "text": "もう限界だと感じる。それで"}, {"type": "subtitle", "time": 15230.229, "timestamp": "04:13:50", "text": "その時点で私は注文し始めました"}, {"type": "subtitle", "time": 15232.149, "timestamp": "04:13:52", "text": "彼女は非ベジタリアン料理だったから"}]
[{"type": "subtitle", "time": 20580.31, "timestamp": "05:43:00", "text": "「これを長引かせることはできない」など。"}, {"type": "subtitle", "time": 20582.15, "timestamp": "05:43:02", "text": "マネージャーか何かに渡したらしい。"}, {"type": "subtitle", "time": 20584.07, "timestamp": "05:43:04", "text": "マネージャーが話をした。私は"}, {"type": "subtitle", "time": 20586.548, "timestamp": "05:43:06", "text": "「わかった、じゃあ送るよ」"}, {"type": "subtitle", "time": 20588.39, "timestamp": "05:43:08", "text": "数時間後、銀行に行く"}, {"type": "subtitle", "time": 20590.788, "timestamp": "05:43:10", "text": "そしてそれをする。」そして彼らは"}, {"type": "subtitle", "time": 20593.59, "timestamp": "05:43:13", "text": "私に支払いを迫る。いいえ、それは"}, {"type": "subtitle", "time": 20596.548, "timestamp": "05:43:16", "text": "いいね！そして、これを配信で共有しました。私"}, {"type": "subtitle", "time": 20598.23, "timestamp": "05:43:18", "text": "これを配信で共有しました。みんな"}, {"type": "subtitle", "time": 20601.83, "timestamp": "05:43:21", "text": "「ジャーク、電話や会話をやめて」"}, {"type": "subtitle", "time": 20604.23, "timestamp": "05:43:24", "text": "彼らと共に。それは危険信号だ。そして私は"}, {"type": "subtitle", "time": 20614.39, "timestamp": "05:43:34", "text": "何てことだ。そして私はこう思った、"}, {"type": "subtitle", "time": 20617.67, "timestamp": "05:43:37", "text": "何かできることがあるから、私は"}, {"type": "subtitle", "time": 20620.548, "timestamp": "05:43:40", "text": "すべての人が"}, {"type": "subtitle", "time": 20622.948, "timestamp": "05:43:42", "text": "たとえそれが小さなものであっても、サポート"}, {"type": "subtitle", "time": 20625.11, "timestamp": "05:43:45", "text": "金額は、問題ありません。私はただこう思った、"}, {"type": "subtitle", "time": 20627.43, "timestamp": "05:43:47", "text": "これがうまくいけば、"}, {"type": "subtitle", "time": 20630.15, "timestamp": "05:43:50", "text": "将来的に役立つかもしれない。いいえ、私は"}, {"type": "subtitle", "time": 20632.868, "timestamp": "05:43:52", "text": "グッズなどを販売できるかもしれない"}, {"type": "subtitle", "time": 20635.19, "timestamp": "05:43:55", "text": "将来、誰かが私を助けてくれたら"}, {"type": "subtitle", "time": 20637.51, "timestamp": "05:43:57", "text": "会社とかそういうもの、あるいは"}]
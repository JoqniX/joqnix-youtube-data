[{"type": "subtitle", "time": 21360.47, "timestamp": "05:56:00", "text": "下を見ずに絵を描くことに慣れている"}, {"type": "subtitle", "time": 21361.91, "timestamp": "05:56:01", "text": "それ。だから、すべてが"}, {"type": "subtitle", "time": 21363.43, "timestamp": "05:56:03", "text": "画面上で起こっていること、そして私は"}, {"type": "subtitle", "time": 21365.91, "timestamp": "05:56:05", "text": "全てを管理するだけです。スクリーン"}, {"type": "subtitle", "time": 21369.91, "timestamp": "05:56:09", "text": "ペンタブレットはとても高価だ。知っている。"}, {"type": "subtitle", "time": 21373.59, "timestamp": "05:56:13", "text": "えっと、私が買った後"}, {"type": "subtitle", "time": 21375.19, "timestamp": "05:56:15", "text": "グラフィック1つ目、私はたぶん"}, {"type": "subtitle", "time": 21378.708, "timestamp": "05:56:18", "text": "もっと長く待っていればよかったのに。"}, {"type": "subtitle", "time": 21382.15, "timestamp": "05:56:22", "text": "貯金してたから、私は"}, {"type": "subtitle", "time": 21384.47, "timestamp": "05:56:24", "text": "まだ慣れようとしているところです"}, {"type": "subtitle", "time": 21388.47, "timestamp": "05:56:28", "text": "錠剤。でもこの時点で私はこう思う、"}, {"type": "subtitle", "time": 21391.51, "timestamp": "05:56:31", "text": "それを持っているなら、やり方を学ぶのもいいだろう"}, {"type": "subtitle", "time": 21393.83, "timestamp": "05:56:33", "text": "これに対処するために。"}, {"type": "subtitle", "time": 21399.03, "timestamp": "05:56:39", "text": "[音楽]"}, {"type": "subtitle", "time": 21402.47, "timestamp": "05:56:42", "text": "うん。たくさんのこと。また、私は保管しています"}, {"type": "subtitle", "time": 21404.47, "timestamp": "05:56:44", "text": "あなたにとって長すぎますか？どうやって"}, {"type": "subtitle", "time": 21407.11, "timestamp": "05:56:47", "text": "あなたは通常、どれくらいの時間配信しますか？"}, {"type": "subtitle", "time": 21411.19, "timestamp": "05:56:51", "text": "えっと、それは私が何をしているかによります"}, {"type": "subtitle", "time": 21414.628, "timestamp": "05:56:54", "text": "実行中。大丈夫だよ。私"}, {"type": "subtitle", "time": 21417.83, "timestamp": "05:56:57", "text": "通常はもっと長く配信するので、"}]
[{"type": "subtitle", "time": 15962.229, "timestamp": "04:26:02", "text": "H YouTube。えっと、一つだけあったんだけど"}, {"type": "subtitle", "time": 15966.469, "timestamp": "04:26:06", "text": "実際には2つ覚えている。えっと、そのうちの1つ"}, {"type": "subtitle", "time": 15969.59, "timestamp": "04:26:09", "text": "ええと、"}, {"type": "subtitle", "time": 15972.63, "timestamp": "04:26:12", "text": "そのうちの1つは、"}, {"type": "subtitle", "time": 15975.91, "timestamp": "04:26:15", "text": "たまたま視聴者がいて"}, {"type": "subtitle", "time": 15978.63, "timestamp": "04:26:18", "text": "子供。彼らは15歳か"}, {"type": "subtitle", "time": 15980.79, "timestamp": "04:26:20", "text": "何か。私はそう思った、彼らは"}, {"type": "subtitle", "time": 15983.67, "timestamp": "04:26:23", "text": "私の配信に遊びに来てください。そして彼らは"}, {"type": "subtitle", "time": 15985.75, "timestamp": "04:26:25", "text": "最初は本当に親切だったんだけど"}, {"type": "subtitle", "time": 15989.75, "timestamp": "04:26:29", "text": "すべて、でも最初は良かった"}, {"type": "subtitle", "time": 15992.63, "timestamp": "04:26:32", "text": "すべて、そして私はそう思った"}, {"type": "subtitle", "time": 15995.75, "timestamp": "04:26:35", "text": "はい、プレイできます。彼らを入れることができます。"}, {"type": "subtitle", "time": 15998.469, "timestamp": "04:26:38", "text": "そして、私は彼らと配信で一緒に遊ぶことができます。"}, {"type": "subtitle", "time": 16001.269, "timestamp": "04:26:41", "text": "その日はコラボをしていたと思う"}, {"type": "subtitle", "time": 16003.99, "timestamp": "04:26:43", "text": "ゲストはずっと後ろにいた。私はこう思う"}, {"type": "subtitle", "time": 16006.55, "timestamp": "04:26:46", "text": "2020年"}, {"type": "subtitle", "time": 16009.91, "timestamp": "04:26:49", "text": "えっと、2021年頃かな。"}, {"type": "subtitle", "time": 16012.469, "timestamp": "04:26:52", "text": "それはまさに頂点の流れだった。私たちは遊んでいました"}, {"type": "subtitle", "time": 16015.189, "timestamp": "04:26:55", "text": "そして、あと一人必要だった。だから"}, {"type": "subtitle", "time": 16018.55, "timestamp": "04:26:58", "text": "ゲストワークは、普段はしないような"}]
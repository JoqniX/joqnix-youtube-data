[{"type": "subtitle", "time": 18362.788, "timestamp": "05:06:02", "text": "今はもっと良いものが手に入る。そうそう、私は"}, {"type": "subtitle", "time": 18365.75, "timestamp": "05:06:05", "text": "つまり、ゆっくりと構築すればいいということです"}, {"type": "subtitle", "time": 18367.91, "timestamp": "05:06:07", "text": "段階的に。"}, {"type": "subtitle", "time": 18370.708, "timestamp": "05:06:10", "text": "そう、だから私は"}, {"type": "subtitle", "time": 18373.11, "timestamp": "05:06:13", "text": "新しいユーチューバーが来るたびに"}, {"type": "subtitle", "time": 18375.27, "timestamp": "05:06:15", "text": "私のチャットに参加するか、アドバイスを求めてください。"}, {"type": "subtitle", "time": 18378.788, "timestamp": "05:06:18", "text": "いつもこう思う"}, {"type": "subtitle", "time": 18382.55, "timestamp": "05:06:22", "text": "無料モデルが多数存在します。私の"}, {"type": "subtitle", "time": 18385.67, "timestamp": "05:06:25", "text": "私がしたことをしたり、好きになったりしても、"}, {"type": "subtitle", "time": 18387.75, "timestamp": "05:06:27", "text": "誰かがあなたに連絡を取ったり、"}, {"type": "subtitle", "time": 18390.868, "timestamp": "05:06:30", "text": "スカウトとか何とか。うん。"}, {"type": "subtitle", "time": 18393.19, "timestamp": "05:06:33", "text": "物事がうまくいかない時もあることを覚えておいてください"}, {"type": "subtitle", "time": 18395.91, "timestamp": "05:06:35", "text": "まあ、思った通りだったね。"}, {"type": "subtitle", "time": 18398.628, "timestamp": "05:06:38", "text": "時として、それは五分五分ですよね？時々"}, {"type": "subtitle", "time": 18400.788, "timestamp": "05:06:40", "text": "うまくいくこともあれば、失敗することもあるし、うまくいかないこともある。"}, {"type": "subtitle", "time": 18405.67, "timestamp": "05:06:45", "text": "運動とか、その他いろいろ。うん。"}, {"type": "subtitle", "time": 18407.59, "timestamp": "05:06:47", "text": "そして主なことは、そうです。ルナ、君の言う通りだ。"}, {"type": "subtitle", "time": 18410.31, "timestamp": "05:06:50", "text": "えっと、一番大切なのは楽しむことですね。"}, {"type": "subtitle", "time": 18413.99, "timestamp": "05:06:53", "text": "はい、その通りです。"}, {"type": "subtitle", "time": 18416.15, "timestamp": "05:06:56", "text": "つまり、それが私の基本的な焦点だったんです"}]
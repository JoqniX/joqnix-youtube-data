[{"type": "subtitle", "time": 22021.59, "timestamp": "06:07:01", "text": "ちょっと医療関係で"}, {"type": "subtitle", "time": 22023.75, "timestamp": "06:07:03", "text": "問題、例えば体重増加など。"}, {"type": "subtitle", "time": 22026.628, "timestamp": "06:07:06", "text": "だから私は「よし、じゃあ、"}, {"type": "subtitle", "time": 22030.39, "timestamp": "06:07:10", "text": "もう少し注意した方がいいですよ。"}, {"type": "subtitle", "time": 22031.91, "timestamp": "06:07:11", "text": "えっと、"}, {"type": "subtitle", "time": 22036.07, "timestamp": "06:07:16", "text": "だから今は、えっと、私は"}, {"type": "subtitle", "time": 22039.43, "timestamp": "06:07:19", "text": "できるだけ家庭料理を食べるようにしていますが、"}, {"type": "subtitle", "time": 22042.39, "timestamp": "06:07:22", "text": "時々、気が向いた時に、"}, {"type": "subtitle", "time": 22045.51, "timestamp": "06:07:25", "text": "外部から何か欲しい場合は"}, {"type": "subtitle", "time": 22050.07, "timestamp": "06:07:30", "text": "何か食べなさい。 H 私はそれが方法だと理解しています"}, {"type": "subtitle", "time": 22052.15, "timestamp": "06:07:32", "text": "この決定よりも維持しやすい"}, {"type": "subtitle", "time": 22054.628, "timestamp": "06:07:34", "text": "よし、もう外食はしないぞ"}, {"type": "subtitle", "time": 22056.708, "timestamp": "06:07:36", "text": "食べ物、そうすればあなたはただ食べたくなるでしょう"}, {"type": "subtitle", "time": 22058.23, "timestamp": "06:07:38", "text": "もっと。"}, {"type": "subtitle", "time": 22067.43, "timestamp": "06:07:47", "text": "あなたはただ、自分の力を試したいだけなのです"}, {"type": "subtitle", "time": 22068.7, "timestamp": "06:07:48", "text": "この点"}, {"type": "subtitle", "time": 22070.788, "timestamp": "06:07:50", "text": "[音楽]"}, {"type": "subtitle", "time": 22075.19, "timestamp": "06:07:55", "text": "私にとっては、えっと、私は成長してきました"}, {"type": "subtitle", "time": 22078.948, "timestamp": "06:07:58", "text": "まるで手作りの料理を食べているような気分になる。だから私は"}]
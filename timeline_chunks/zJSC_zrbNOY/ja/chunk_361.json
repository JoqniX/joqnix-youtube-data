[{"type": "subtitle", "time": 21661.43, "timestamp": "06:01:01", "text": "そのコラボで自信がついたから"}, {"type": "subtitle", "time": 21664.39, "timestamp": "06:01:04", "text": "2回目と3回目のコラボレーションを試した後、"}, {"type": "subtitle", "time": 21667.75, "timestamp": "06:01:07", "text": "ある時点で私は"}, {"type": "subtitle", "time": 21671.19, "timestamp": "06:01:11", "text": "快適に過ごせるので、コラボレーションを始めました"}, {"type": "subtitle", "time": 21673.91, "timestamp": "06:01:13", "text": "多くの人々と共に、あの時"}, {"type": "subtitle", "time": 21676.628, "timestamp": "06:01:16", "text": "そう、それからジョーを通して私は本当に"}, {"type": "subtitle", "time": 21679.75, "timestamp": "06:01:19", "text": "驚いたことに、私はコラボしている"}, {"type": "subtitle", "time": 21682.548, "timestamp": "06:01:22", "text": "ほとんど話したことのない人たちと"}, {"type": "subtitle", "time": 21685.11, "timestamp": "06:01:25", "text": "私が話した人たちは"}, {"type": "subtitle", "time": 21687.35, "timestamp": "06:01:27", "text": "大丈夫、簡単にできます"}, {"type": "subtitle", "time": 21689.51, "timestamp": "06:01:29", "text": "彼らの雰囲気を知っていて、"}, {"type": "subtitle", "time": 21691.75, "timestamp": "06:01:31", "text": "すべてですが、私は決して"}, {"type": "subtitle", "time": 21694.47, "timestamp": "06:01:34", "text": "話した最初のやり取り"}, {"type": "subtitle", "time": 21697.03, "timestamp": "06:01:37", "text": "彼らのやり方にどう適応すればいいのかわからない"}, {"type": "subtitle", "time": 21699.11, "timestamp": "06:01:39", "text": "エネルギーレベルすべて私は"}, {"type": "subtitle", "time": 21701.99, "timestamp": "06:01:41", "text": "適応しているかどうかはわかりませんが、それでも"}, {"type": "subtitle", "time": 21704.31, "timestamp": "06:01:44", "text": "私たちは楽しんでいます"}, {"type": "subtitle", "time": 21707.19, "timestamp": "06:01:47", "text": "少なくとも話すことは十分です"}, {"type": "subtitle", "time": 21711.19, "timestamp": "06:01:51", "text": "だって、そう、私は、私が"}, {"type": "subtitle", "time": 21713.91, "timestamp": "06:01:53", "text": "再会してその人を知ることができる"}, {"type": "subtitle", "time": 21717.03, "timestamp": "06:01:57", "text": "まあいいよ、私は気にしないから"}, {"type": "subtitle", "time": 21719.51, "timestamp": "06:01:59", "text": "その他、どのようにすべきかなど"}]
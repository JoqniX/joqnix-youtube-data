[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "Twitchを見て、えっと、私は"}, {"type": "subtitle", "time": 13204.389, "timestamp": "03:40:04", "text": "当初は両方とも成長させたかった"}, {"type": "subtitle", "time": 13207.75, "timestamp": "03:40:07", "text": "一緒にいるけど、そのうちの1人は"}, {"type": "subtitle", "time": 13210.95, "timestamp": "03:40:10", "text": "ずっと先を行っていて、私たちの一人がサボっている"}, {"type": "subtitle", "time": 13214.469, "timestamp": "03:40:14", "text": "後ろで見つける"}, {"type": "subtitle", "time": 13218.87, "timestamp": "03:40:18", "text": "しかし、マルチリーミングでは"}, {"type": "subtitle", "time": 13221.59, "timestamp": "03:40:21", "text": "Twitchを好む人なら誰でも"}, {"type": "subtitle", "time": 13225.19, "timestamp": "03:40:25", "text": "彼らはTwitchに来てもまだ"}, {"type": "subtitle", "time": 13228.95, "timestamp": "03:40:28", "text": "同じ経験、そしてもし彼らが"}, {"type": "subtitle", "time": 13231.51, "timestamp": "03:40:31", "text": "YouTube に来て、彼らは、彼らは"}, {"type": "subtitle", "time": 13240.389, "timestamp": "03:40:40", "text": "単純に、どのプラットフォームで"}, {"type": "subtitle", "time": 13242.63, "timestamp": "03:40:42", "text": "好む"}, {"type": "subtitle", "time": 13245.269, "timestamp": "03:40:45", "text": "YouTubeにはもう行った？だから私は実際には"}, {"type": "subtitle", "time": 13247.75, "timestamp": "03:40:47", "text": "それについて興味がある。だから私はこう思っていました。"}, {"type": "subtitle", "time": 13251.59, "timestamp": "03:40:51", "text": "マルチストリーミングについて調べています。"}, {"type": "subtitle", "time": 13255.67, "timestamp": "03:40:55", "text": "だから、おそらく少しだけ試してみるつもりです"}]
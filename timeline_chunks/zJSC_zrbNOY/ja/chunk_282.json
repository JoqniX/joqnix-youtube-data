[{"type": "subtitle", "time": 16925.43, "timestamp": "04:42:05", "text": "うん。わかった。何か聞きたいことがあるんだけど、忘れちゃった。"}, {"type": "subtitle", "time": 16928.39, "timestamp": "04:42:08", "text": "例えば、マイクが動作しないのはなぜか。おお"}, {"type": "subtitle", "time": 16931.91, "timestamp": "04:42:11", "text": "うん。うん。どうしたの？この車が好きです"}, {"type": "subtitle", "time": 16935.27, "timestamp": "04:42:15", "text": "切り離されたか、あるいは私が思うように、あなたのように"}, {"type": "subtitle", "time": 16938.07, "timestamp": "04:42:18", "text": "USBが揺れたのは、私が動いたから"}, {"type": "subtitle", "time": 16941.75, "timestamp": "04:42:21", "text": "少し。それで、えーっと"}, {"type": "subtitle", "time": 16943.99, "timestamp": "04:42:23", "text": "ああ、そういうこともあるよね。"}, {"type": "subtitle", "time": 16946.628, "timestamp": "04:42:26", "text": "彼らは瞬間的なものが常に"}, {"type": "subtitle", "time": 16948.708, "timestamp": "04:42:28", "text": "そこには。でも、彼らが"}, {"type": "subtitle", "time": 16953.27, "timestamp": "04:42:33", "text": "部屋に入ってください。それは真実だ"}, {"type": "subtitle", "time": 16955.99, "timestamp": "04:42:35", "text": "そしてそれはあなたの個人情報が漏洩する一つの方法です"}, {"type": "subtitle", "time": 16958.55, "timestamp": "04:42:38", "text": "実名とか、そういう感じの名前。"}, {"type": "subtitle", "time": 16961.83, "timestamp": "04:42:41", "text": "分かってるよ、ありがたいことに、私は"}, {"type": "subtitle", "time": 16964.708, "timestamp": "04:42:44", "text": "私のニックネームとは全く似ていない"}, {"type": "subtitle", "time": 16967.67, "timestamp": "04:42:47", "text": "名前。それで"}, {"type": "subtitle", "time": 16969.59, "timestamp": "04:42:49", "text": "それはそこにある。"}, {"type": "subtitle", "time": 16971.75, "timestamp": "04:42:51", "text": "たとえ私が母に「わかった、"}, {"type": "subtitle", "time": 16974.31, "timestamp": "04:42:54", "text": "ママ、私、配信するね。"}, {"type": "subtitle", "time": 16978.07, "timestamp": "04:42:58", "text": "そして、彼女はただ入るだけです"}]
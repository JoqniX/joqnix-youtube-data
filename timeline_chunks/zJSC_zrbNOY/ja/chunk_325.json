[{"type": "subtitle", "time": 19500.788, "timestamp": "05:25:00", "text": "その時、インターン生が"}, {"type": "subtitle", "time": 19503.67, "timestamp": "05:25:03", "text": "王位に興味を持っていた人物。"}, {"type": "subtitle", "time": 19506.55, "timestamp": "05:25:06", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 19508.788, "timestamp": "05:25:08", "text": "その人が与えた"}, {"type": "subtitle", "time": 19511.43, "timestamp": "05:25:11", "text": "誰かの連絡先と"}, {"type": "subtitle", "time": 19514.788, "timestamp": "05:25:14", "text": "ええ、私はその件について連絡を取りました"}, {"type": "subtitle", "time": 19517.43, "timestamp": "05:25:17", "text": "Discord からの連絡で、それでも彼らは"}, {"type": "subtitle", "time": 19520.15, "timestamp": "05:25:20", "text": "何も返答しなかった"}, {"type": "subtitle", "time": 19523.03, "timestamp": "05:25:23", "text": "描いた人物を追加したかったから"}, {"type": "subtitle", "time": 19525.59, "timestamp": "05:25:25", "text": "インド通貨なので、"}, {"type": "subtitle", "time": 19528.708, "timestamp": "05:25:28", "text": "今はもっと楽になった。それは実際には私の"}, {"type": "subtitle", "time": 19530.788, "timestamp": "05:25:30", "text": "彼らにも提案したように、"}, {"type": "subtitle", "time": 19535.51, "timestamp": "05:25:35", "text": "インドの通貨と2つの、えーと"}, {"type": "subtitle", "time": 19538.628, "timestamp": "05:25:38", "text": "人々はそれを通してUPIを追加する"}, {"type": "subtitle", "time": 19541.75, "timestamp": "05:25:41", "text": "非常に良い市場になるでしょう"}, {"type": "subtitle", "time": 19543.91, "timestamp": "05:25:43", "text": "インド"}, {"type": "subtitle", "time": 19546.708, "timestamp": "05:25:46", "text": "なぜなら、私たちはたくさんのコンテンツクリエイターを抱えているからです"}, {"type": "subtitle", "time": 19549.67, "timestamp": "05:25:49", "text": "そして、一番の問題は"}, {"type": "subtitle", "time": 19552.628, "timestamp": "05:25:52", "text": "玉座には、その部分が付属しています。"}, {"type": "subtitle", "time": 19555.27, "timestamp": "05:25:55", "text": "現在、UPIは受け付けていません。"}, {"type": "subtitle", "time": 19557.35, "timestamp": "05:25:57", "text": "うん、"}]
[{"type": "subtitle", "time": 16380.389, "timestamp": "04:33:00", "text": "私に対して奇妙で不気味な態度をとる。ヒーガのみ"}, {"type": "subtitle", "time": 16382.55, "timestamp": "04:33:02", "text": "女の子のユーチューバーとか。私はそうは思わない"}, {"type": "subtitle", "time": 16386.23, "timestamp": "04:33:06", "text": "私はこれらすべてを知らなかったし、私は愚か者なので"}, {"type": "subtitle", "time": 16389.83, "timestamp": "04:33:09", "text": "バカなことに、私は彼らに謝罪した"}, {"type": "subtitle", "time": 16392.07, "timestamp": "04:33:12", "text": "それは私のせいではなかったし、私は"}, {"type": "subtitle", "time": 16393.99, "timestamp": "04:33:13", "text": "ええ、彼らとは連絡を取っています。"}, {"type": "subtitle", "time": 16397.83, "timestamp": "04:33:17", "text": "この人にアドバイスして、"}, {"type": "subtitle", "time": 16401.349, "timestamp": "04:33:21", "text": "もう一度それとその他諸々、彼らに少し時間を与えてください"}, {"type": "subtitle", "time": 16404.23, "timestamp": "04:33:24", "text": "チャンスとか色々あるから、やってみるよって言ったんだ"}, {"type": "subtitle", "time": 16407.51, "timestamp": "04:33:27", "text": "彼が変われるかどうか試してみますか、"}, {"type": "subtitle", "time": 16411.429, "timestamp": "04:33:31", "text": "そうではなく、私は忍耐強く、"}, {"type": "subtitle", "time": 16413.83, "timestamp": "04:33:33", "text": "そういうものや物を詰めて遊ぶ"}, {"type": "subtitle", "time": 16416.15, "timestamp": "04:33:36", "text": "彼らが良い考え方を持てるように"}, {"type": "subtitle", "time": 16419.429, "timestamp": "04:33:39", "text": "すべてだったが、最後には"}, {"type": "subtitle", "time": 16421.83, "timestamp": "04:33:41", "text": "壁に向かって話していたとき、"}, {"type": "subtitle", "time": 16425.75, "timestamp": "04:33:45", "text": "気づいた人は"}, {"type": "subtitle", "time": 16428.15, "timestamp": "04:33:48", "text": "変わらない、彼らは同じことをする"}, {"type": "subtitle", "time": 16431.189, "timestamp": "04:33:51", "text": "何度も何度も繰り返し、決して変わらない"}, {"type": "subtitle", "time": 16434.31, "timestamp": "04:33:54", "text": "たとえあなたがどれだけ努力しても"}, {"type": "subtitle", "time": 16436.949, "timestamp": "04:33:56", "text": "変更するか提案するのが最善です"}, {"type": "subtitle", "time": 16439.51, "timestamp": "04:33:59", "text": "物事が異なるように"}]
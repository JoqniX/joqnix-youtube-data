[{"type": "subtitle", "time": 15362.95, "timestamp": "04:16:02", "text": "反応。何てことだ。これまでに感じたことはありますか"}, {"type": "subtitle", "time": 15365.429, "timestamp": "04:16:05", "text": "オンラインで見たときのように"}, {"type": "subtitle", "time": 15367.51, "timestamp": "04:16:07", "text": "オンラインで友達に会ったとき"}, {"type": "subtitle", "time": 15370.55, "timestamp": "04:16:10", "text": "現実の生活？私は私の"}, {"type": "subtitle", "time": 15372.309, "timestamp": "04:16:12", "text": "オンライン上の友人たち。だからこれは"}, {"type": "subtitle", "time": 15375.269, "timestamp": "04:16:15", "text": "このユーチューバーは、私が"}, {"type": "subtitle", "time": 15377.03, "timestamp": "04:16:17", "text": "知り合いが何人かいて、私はムンバイにいました。それで"}, {"type": "subtitle", "time": 15380.07, "timestamp": "04:16:20", "text": "私はそのうちの一人に会うことにした。そうだった"}, {"type": "subtitle", "time": 15383.429, "timestamp": "04:16:23", "text": "ちょっとシュールな感じだけど、まあ、そうだね"}, {"type": "subtitle", "time": 15386.63, "timestamp": "04:16:26", "text": "存在する。うん。"}, {"type": "subtitle", "time": 15389.99, "timestamp": "04:16:29", "text": "何てことだ。あなたは実は人間です"}, {"type": "subtitle", "time": 15395.83, "timestamp": "04:16:35", "text": "うん。そして、チューニング中のものがある"}, {"type": "subtitle", "time": 15398.07, "timestamp": "04:16:38", "text": "両親に話すとしたら"}, {"type": "subtitle", "time": 15401.11, "timestamp": "04:16:41", "text": "彼らはこう言うだろう、"}, {"type": "subtitle", "time": 15403.75, "timestamp": "04:16:43", "text": "50歳くらいの年配者や30歳くらいの人"}, {"type": "subtitle", "time": 15407.51, "timestamp": "04:16:47", "text": "高齢者とかそういうのだけど"}, {"type": "subtitle", "time": 15410.389, "timestamp": "04:16:50", "text": "実際に会ってみると、"}, {"type": "subtitle", "time": 15413.83, "timestamp": "04:16:53", "text": "それ。彼らは本物で、同い年です"}, {"type": "subtitle", "time": 15417.83, "timestamp": "04:16:57", "text": "あなたか何か。知っている。同じようなものです"}]
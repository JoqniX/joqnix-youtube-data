[{"type": "subtitle", "time": 19381.11, "timestamp": "05:23:01", "text": "彼ら側からのちょっとした後押しで"}, {"type": "subtitle", "time": 19382.948, "timestamp": "05:23:02", "text": "きちんと聞き取れます。"}, {"type": "subtitle", "time": 19385.03, "timestamp": "05:23:05", "text": "でも前よりずっといいよ、だって"}, {"type": "subtitle", "time": 19387.35, "timestamp": "05:23:07", "text": "他の言葉をいくつか見ました"}, {"type": "subtitle", "time": 19389.43, "timestamp": "05:23:09", "text": "ストリームして、どうやって"}, {"type": "subtitle", "time": 19391.59, "timestamp": "05:23:11", "text": "みんな、私が言っていたことを理解したよ"}, {"type": "subtitle", "time": 19401.99, "timestamp": "05:23:21", "text": "うん。"}, {"type": "subtitle", "time": 19411.27, "timestamp": "05:23:31", "text": "えっと、火って何？"}, {"type": "subtitle", "time": 19414.31, "timestamp": "05:23:34", "text": "それはただ、"}, {"type": "subtitle", "time": 19418.868, "timestamp": "05:23:38", "text": "伝承的には、それは"}, {"type": "subtitle", "time": 19421.99, "timestamp": "05:23:41", "text": "それはいつも私のそばにあったものだ。"}, {"type": "subtitle", "time": 19423.99, "timestamp": "05:23:43", "text": "それが法律だから、法律はそういうもの"}, {"type": "subtitle", "time": 19427.59, "timestamp": "05:23:47", "text": "私は物忘れのひどい人間です。それは"}, {"type": "subtitle", "time": 19429.27, "timestamp": "05:23:49", "text": "ちょうどそこです。だから、私は受け入れるようになった"}, {"type": "subtitle", "time": 19431.03, "timestamp": "05:23:51", "text": "まるでそこに火があるみたいで、私は火が大好きなんです"}, {"type": "subtitle", "time": 19432.788, "timestamp": "05:23:52", "text": "多く。"}, {"type": "subtitle", "time": 19435.67, "timestamp": "05:23:55", "text": "だから、それはちょっと面白いし、"}, {"type": "subtitle", "time": 19438.788, "timestamp": "05:23:58", "text": "楽しい部分ですね、だって私はただ"}]
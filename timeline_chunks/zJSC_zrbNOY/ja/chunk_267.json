[{"type": "subtitle", "time": 16021.429, "timestamp": "04:27:01", "text": "ゲストも視聴者は"}, {"type": "subtitle", "time": 16023.51, "timestamp": "04:27:03", "text": "それで構いません。彼らは快適に"}, {"type": "subtitle", "time": 16028.229, "timestamp": "04:27:08", "text": "ランダムな人が参加して、そして、これ"}, {"type": "subtitle", "time": 16032.63, "timestamp": "04:27:12", "text": "ランダムな視聴者が参加し、"}, {"type": "subtitle", "time": 16035.83, "timestamp": "04:27:15", "text": "ええ、私は彼らがチャットしているのを見ました"}, {"type": "subtitle", "time": 16038.63, "timestamp": "04:27:18", "text": "彼らはほとんどの時間話​​しています、私のところに来ます"}, {"type": "subtitle", "time": 16040.63, "timestamp": "04:27:20", "text": "ストリームも。だから彼らは敬意を払うだろう"}, {"type": "subtitle", "time": 16043.11, "timestamp": "04:27:23", "text": "私のルールに従うことと"}, {"type": "subtitle", "time": 16045.03, "timestamp": "04:27:25", "text": "すべて。私も言及しましたが"}, {"type": "subtitle", "time": 16048.389, "timestamp": "04:27:28", "text": "彼らを中に入れる前に、彼らは参加しました"}, {"type": "subtitle", "time": 16051.189, "timestamp": "04:27:31", "text": "中に入って、私たちは遊んだんだけど、何が"}, {"type": "subtitle", "time": 16054.95, "timestamp": "04:27:34", "text": "その男にも同じことが起こった。えっと、それは悪い"}, {"type": "subtitle", "time": 16057.59, "timestamp": "04:27:37", "text": "あれだったかな、それとも何か別のことだったかな？彼は文字通り"}, {"type": "subtitle", "time": 16061.75, "timestamp": "04:27:41", "text": "文字通り「うん、これは悪いし、これは悪い」と言って、"}, {"type": "subtitle", "time": 16065.269, "timestamp": "04:27:45", "text": "それ。たくさんの中傷を言った、たくさんの"}, {"type": "subtitle", "time": 16068.469, "timestamp": "04:27:48", "text": "もの。最初は気づかなかった"}, {"type": "subtitle", "time": 16071.349, "timestamp": "04:27:51", "text": "だって、それはちょっと間接的だったから。私"}, {"type": "subtitle", "time": 16074.309, "timestamp": "04:27:54", "text": "ゲストはそれに気づいたと思う。そしてそれ以来"}, {"type": "subtitle", "time": 16076.07, "timestamp": "04:27:56", "text": "ゲスト"}, {"type": "subtitle", "time": 16077.91, "timestamp": "04:27:57", "text": "何もしていないことに気付いた、"}]
[{"type": "subtitle", "time": 20282.31, "timestamp": "05:38:02", "text": "うん。うん。私は彼らに"}, {"type": "subtitle", "time": 20286.23, "timestamp": "05:38:06", "text": "お金、そして残念ながら、私は彼らに"}, {"type": "subtitle", "time": 20289.03, "timestamp": "05:38:09", "text": "私のPayPalアカウントに送金してください。そして"}, {"type": "subtitle", "time": 20290.868, "timestamp": "05:38:10", "text": "1つの問題が発生しました"}, {"type": "subtitle", "time": 20294.628, "timestamp": "05:38:14", "text": "PayPalも。どうやら私はうっかり"}, {"type": "subtitle", "time": 20298.07, "timestamp": "05:38:18", "text": "口座番号を間違えた"}, {"type": "subtitle", "time": 20300.628, "timestamp": "05:38:20", "text": "PayPalの銀行口座を2番目に追加しました"}, {"type": "subtitle", "time": 20303.35, "timestamp": "05:38:23", "text": "銀行口座。"}, {"type": "subtitle", "time": 20306.23, "timestamp": "05:38:26", "text": "コフィからの寄付金のうちの1つは"}, {"type": "subtitle", "time": 20310.39, "timestamp": "05:38:30", "text": "その銀行口座番号に、私は"}, {"type": "subtitle", "time": 20313.91, "timestamp": "05:38:33", "text": "それを得る。たった1桁の数字が"}, {"type": "subtitle", "time": 20317.75, "timestamp": "05:38:37", "text": "変更しました。 nの代わりに、えっと、"}, {"type": "subtitle", "time": 20321.75, "timestamp": "05:38:41", "text": "ゼロと"}, {"type": "subtitle", "time": 20325.35, "timestamp": "05:38:45", "text": "私は、メールを書いたように報告しました。"}, {"type": "subtitle", "time": 20329.27, "timestamp": "05:38:49", "text": "私の状況と何が起こったのかを説明してください"}, {"type": "subtitle", "time": 20332.23, "timestamp": "05:38:52", "text": "PayPalなどすべてと、"}, {"type": "subtitle", "time": 20334.868, "timestamp": "05:38:54", "text": "PayPalはそれを確認しなかったが"}, {"type": "subtitle", "time": 20337.43, "timestamp": "05:38:57", "text": "銀行はまだお金を送金したので、"}]
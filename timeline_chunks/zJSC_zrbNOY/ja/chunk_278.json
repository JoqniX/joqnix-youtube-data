[{"type": "subtitle", "time": 16682.709, "timestamp": "04:38:02", "text": "時にはある程度"}, {"type": "subtitle", "time": 16684.629, "timestamp": "04:38:04", "text": "もちろん、時には悪いこともある"}, {"type": "subtitle", "time": 16687.59, "timestamp": "04:38:07", "text": "日と、えっと、あなたはこう思う"}, {"type": "subtitle", "time": 16690.789, "timestamp": "04:38:10", "text": "つまり、たとえ彼らが"}, {"type": "subtitle", "time": 16692.31, "timestamp": "04:38:12", "text": "ストリーミング配信をしていると、"}, {"type": "subtitle", "time": 16695.349, "timestamp": "04:38:15", "text": "彼らはそれを持っていて、それで構わないと思っている"}, {"type": "subtitle", "time": 16697.109, "timestamp": "04:38:17", "text": "彼らが大丈夫かどうかはまず第一に考えます"}, {"type": "subtitle", "time": 16699.99, "timestamp": "04:38:19", "text": "あれで"}, {"type": "subtitle", "time": 16701.91, "timestamp": "04:38:21", "text": "だからそれは違うけど、同じ"}, {"type": "subtitle", "time": 16703.83, "timestamp": "04:38:23", "text": "時間、私はなんだか、うーん、なんだか"}, {"type": "subtitle", "time": 16706.15, "timestamp": "04:38:26", "text": "変な感じになるよ、ただ来て"}, {"type": "subtitle", "time": 16708.39, "timestamp": "04:38:28", "text": "誰かの配信に入って、ただのドラマ"}, {"type": "subtitle", "time": 16711.91, "timestamp": "04:38:31", "text": "ごみ。うん。"}, {"type": "subtitle", "time": 16716.15, "timestamp": "04:38:36", "text": "すごく変だ。なぜできないのか"}, {"type": "subtitle", "time": 16718.629, "timestamp": "04:38:38", "text": "それ？"}, {"type": "subtitle", "time": 16720.789, "timestamp": "04:38:40", "text": "だって、私たちには分からないから。もしかしたら彼らはこう言うかもしれない"}, {"type": "subtitle", "time": 16723.029, "timestamp": "04:38:43", "text": "別の何かを引き起こす可能性のあるもの"}, {"type": "subtitle", "time": 16727.349, "timestamp": "04:38:47", "text": "私たちのストリームにいる人。 M と私たちには"}, {"type": "subtitle", "time": 16730.15, "timestamp": "04:38:50", "text": "それを知る方法。だからそれはまるで"}]
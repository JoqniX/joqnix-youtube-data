[{"type": "subtitle", "time": 18181.03, "timestamp": "05:03:01", "text": "彼らは適切なコミュニケーションをとることができる"}, {"type": "subtitle", "time": 18182.55, "timestamp": "05:03:02", "text": "言語を介さないコミュニケーション"}, {"type": "subtitle", "time": 18185.91, "timestamp": "05:03:05", "text": "障壁は決して存在しない。だから彼らは"}, {"type": "subtitle", "time": 18187.67, "timestamp": "05:03:07", "text": "彼らと仕事をしたことがあるから、彼らは"}, {"type": "subtitle", "time": 18191.67, "timestamp": "05:03:11", "text": "彼らが正しいと提案したので、それに従いました。"}, {"type": "subtitle", "time": 18194.948, "timestamp": "05:03:14", "text": "ええ、それからジャカルタを経由して"}, {"type": "subtitle", "time": 18197.19, "timestamp": "05:03:17", "text": "明らかにするはずだった"}, {"type": "subtitle", "time": 18199.51, "timestamp": "05:03:19", "text": "ライセンスを取得して、それをからかうように公開して、"}, {"type": "subtitle", "time": 18201.99, "timestamp": "05:03:21", "text": "何かを見て、それから別のことに気づいた"}, {"type": "subtitle", "time": 18204.39, "timestamp": "05:03:24", "text": "PSCファイルのような合併症が発生しました"}, {"type": "subtitle", "time": 18207.91, "timestamp": "05:03:27", "text": "いくつか欠陥があって、"}, {"type": "subtitle", "time": 18211.03, "timestamp": "05:03:31", "text": "えっと、ちゃんと分離されていなかったので"}, {"type": "subtitle", "time": 18215.11, "timestamp": "05:03:35", "text": "それは不正操作の瞬間ではない。そして、"}, {"type": "subtitle", "time": 18217.99, "timestamp": "05:03:37", "text": "まるで、とても売春婦で、"}, {"type": "subtitle", "time": 18220.628, "timestamp": "05:03:40", "text": "私にとって初めてのこと"}, {"type": "subtitle", "time": 18223.35, "timestamp": "05:03:43", "text": "人に仕事を依頼したり、"}, {"type": "subtitle", "time": 18225.67, "timestamp": "05:03:45", "text": "他の人が"}, {"type": "subtitle", "time": 18228.07, "timestamp": "05:03:48", "text": "やっている。だから私はこう思う、これは大きな"}, {"type": "subtitle", "time": 18231.11, "timestamp": "05:03:51", "text": "このモデルを入手したとしても、金額とプロ"}, {"type": "subtitle", "time": 18233.03, "timestamp": "05:03:53", "text": "少なくとも"}, {"type": "subtitle", "time": 18236.07, "timestamp": "05:03:56", "text": "5年から10年かかるだろう。それくらい高額だからだ。私"}, {"type": "subtitle", "time": 18239.59, "timestamp": "05:03:59", "text": "服を買う余裕はないと思う"}]
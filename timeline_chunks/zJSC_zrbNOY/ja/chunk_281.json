[{"type": "subtitle", "time": 16894.708, "timestamp": "04:41:34", "text": "何？待って、これってインターネットなの？うん、"}, {"type": "subtitle", "time": 16899.19, "timestamp": "04:41:39", "text": "しかし、平均的な反復回数を待ちましょう。は"}, {"type": "subtitle", "time": 16903.35, "timestamp": "04:41:43", "text": "今は正常に動作していますか？うん。ええ、音声のことですね。"}, {"type": "subtitle", "time": 16908.47, "timestamp": "04:41:48", "text": "うん、母が来たと思う。いいえ、"}, {"type": "subtitle", "time": 16911.67, "timestamp": "04:41:51", "text": "知っている。もし母が来たら、あなたたちは"}, {"type": "subtitle", "time": 16913.43, "timestamp": "04:41:53", "text": "ミュートする前に知っておく。だから、"}, {"type": "subtitle", "time": 16914.948, "timestamp": "04:41:54", "text": "心配。"}]
[{"type": "subtitle", "time": 14940.63, "timestamp": "04:09:00", "text": "今はそれほど良くない。それはヘビーバッグだった"}, {"type": "subtitle", "time": 14955.429, "timestamp": "04:09:15", "text": "オンラインで友達を作ったり、"}, {"type": "subtitle", "time": 14959.349, "timestamp": "04:09:19", "text": "YouTuberやストリーマーのような？"}, {"type": "subtitle", "time": 14965.03, "timestamp": "04:09:25", "text": "いいえ、していません。私は、えっと、接続しました"}, {"type": "subtitle", "time": 14969.11, "timestamp": "04:09:29", "text": "私のIRLアカウントに私の数人の写真と一緒に"}, {"type": "subtitle", "time": 14972.309, "timestamp": "04:09:32", "text": "選ばれたものですが、私はまだできていません"}, {"type": "subtitle", "time": 14979.83, "timestamp": "04:09:39", "text": "でも、私はもっと受け入れるだろうと思う"}, {"type": "subtitle", "time": 14982.79, "timestamp": "04:09:42", "text": "なぜなら私は自分が"}, {"type": "subtitle", "time": 14985.83, "timestamp": "04:09:45", "text": "ストリーミングにこれほど夢中になったとき"}, {"type": "subtitle", "time": 14988.389, "timestamp": "04:09:48", "text": "最初に開始されました。それはむしろ"}, {"type": "subtitle", "time": 14990.71, "timestamp": "04:09:50", "text": "友達とゲームをして"}, {"type": "subtitle", "time": 14993.269, "timestamp": "04:09:53", "text": "私はかなり個性的になれる"}, {"type": "subtitle", "time": 14995.11, "timestamp": "04:09:55", "text": "同じように。"}, {"type": "subtitle", "time": 14996.87, "timestamp": "04:09:56", "text": "M."}]
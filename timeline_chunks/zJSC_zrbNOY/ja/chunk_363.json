[{"type": "subtitle", "time": 21780.39, "timestamp": "06:03:00", "text": "私に多くのことを教えてくれたので、"}, {"type": "subtitle", "time": 21782.548, "timestamp": "06:03:02", "text": "彼らが"}, {"type": "subtitle", "time": 21785.51, "timestamp": "06:03:05", "text": "YouTuber、クリエイター、元YouTuber"}, {"type": "subtitle", "time": 21788.47, "timestamp": "06:03:08", "text": "またはクリエイター、あるいはストリーミングしていないIl"}, {"type": "subtitle", "time": 21791.03, "timestamp": "06:03:11", "text": "友達もそうだよ、うん、行くよ"}, {"type": "subtitle", "time": 21794.15, "timestamp": "06:03:14", "text": "すべての言葉と会話を理解する"}, {"type": "subtitle", "time": 21797.03, "timestamp": "06:03:17", "text": "出発前に彼らと会っておく。だからそれは"}, {"type": "subtitle", "time": 21800.628, "timestamp": "06:03:20", "text": "今、人々と再びつながる方法と"}, {"type": "subtitle", "time": 21802.788, "timestamp": "06:03:22", "text": "うん。そしてあなたは、あなたの前に思い出を作る"}, {"type": "subtitle", "time": 21805.75, "timestamp": "06:03:25", "text": "去るんだよね？私が日本を離れる時のように"}, {"type": "subtitle", "time": 21807.83, "timestamp": "06:03:27", "text": "人生の新たな章のようなものになるでしょう。"}, {"type": "subtitle", "time": 21810.948, "timestamp": "06:03:30", "text": "右？完全に一人ぼっちで、"}, {"type": "subtitle", "time": 21814.15, "timestamp": "06:03:34", "text": "そこで一人で生き残ることは、"}, {"type": "subtitle", "time": 21816.15, "timestamp": "06:03:36", "text": "私の独立した物語が始まるように"}, {"type": "subtitle", "time": 21819.59, "timestamp": "06:03:39", "text": "そこには。一人っ子としてここにいるように"}, {"type": "subtitle", "time": 21823.91, "timestamp": "06:03:43", "text": "私の家族は竹のように私を守ってくれます"}, {"type": "subtitle", "time": 21827.19, "timestamp": "06:03:47", "text": "たくさん、そして、すべてをするのが好きです"}, {"type": "subtitle", "time": 21830.31, "timestamp": "06:03:50", "text": "私を導いてくれるような人がいる"}, {"type": "subtitle", "time": 21833.35, "timestamp": "06:03:53", "text": "今は色々あるけど、そこは全部同じになる"}, {"type": "subtitle", "time": 21838.868, "timestamp": "06:03:58", "text": "一人で。自分でやらなければならない。"}]
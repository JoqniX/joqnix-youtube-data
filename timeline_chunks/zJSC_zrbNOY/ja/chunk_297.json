[{"type": "subtitle", "time": 17823.27, "timestamp": "04:57:03", "text": "このような。アーティストのように、私は"}, {"type": "subtitle", "time": 17825.75, "timestamp": "04:57:05", "text": "彼らの第一子とされるVTuber"}, {"type": "subtitle", "time": 17829.43, "timestamp": "04:57:09", "text": "子供、主にイラストを描いているから"}, {"type": "subtitle", "time": 17831.83, "timestamp": "04:57:11", "text": "もっと大きなクリエイターとか、そういう人たちのために。"}, {"type": "subtitle", "time": 17834.47, "timestamp": "04:57:14", "text": "そして私は、彼らの最初のVTuberの子供になるんです。"}, {"type": "subtitle", "time": 17836.15, "timestamp": "04:57:16", "text": "そして彼らは手数料を受け取ったのは"}, {"type": "subtitle", "time": 17837.67, "timestamp": "04:57:17", "text": "彼らは経験があると言った"}, {"type": "subtitle", "time": 17842.628, "timestamp": "04:57:22", "text": "VTuberモデル、人間離れした芸術。だから、でも彼らは"}, {"type": "subtitle", "time": 17844.948, "timestamp": "04:57:24", "text": "最善を尽くした"}, {"type": "subtitle", "time": 17848.788, "timestamp": "04:57:28", "text": "そのモデルはとても綺麗で"}, {"type": "subtitle", "time": 17851.59, "timestamp": "04:57:31", "text": "カイも素晴らしくて、すべてがとてもエレガントでした。"}, {"type": "subtitle", "time": 17855.99, "timestamp": "04:57:35", "text": "とても気に入っているのですが、失礼になるかもしれません。えーと"}, {"type": "subtitle", "time": 17857.91, "timestamp": "04:57:37", "text": "依頼を完了したにもかかわらず"}, {"type": "subtitle", "time": 17860.708, "timestamp": "04:57:40", "text": "厳しい締め切りがあったにもかかわらず"}, {"type": "subtitle", "time": 17862.23, "timestamp": "04:57:42", "text": "締め切りに間に合わなかった理由は"}, {"type": "subtitle", "time": 17864.708, "timestamp": "04:57:44", "text": "他の委員会やその他すべての"}, {"type": "subtitle", "time": 17867.67, "timestamp": "04:57:47", "text": "それでも彼らは最善を尽くし、"}, {"type": "subtitle", "time": 17869.83, "timestamp": "04:57:49", "text": "仕上げて送りました"}, {"type": "subtitle", "time": 17873.11, "timestamp": "04:57:53", "text": "そう、もう8ヶ月か9ヶ月経つね"}, {"type": "subtitle", "time": 17876.23, "timestamp": "04:57:56", "text": "それ以来数ヶ月が経ち、彼らは"}, {"type": "subtitle", "time": 17878.23, "timestamp": "04:57:58", "text": "今、何が起こったのか疑問に思っています"}]
[{"type": "subtitle", "time": 2911.51, "timestamp": "00:48:31", "text": "しかし、私はできないと分かっています"}, {"type": "subtitle", "time": 2914.309, "timestamp": "00:48:34", "text": "私の中にはダナを好きになりたい部分もあるけど、"}, {"type": "subtitle", "time": 2916.87, "timestamp": "00:48:36", "text": "やってみて。"}, {"type": "subtitle", "time": 2929.75, "timestamp": "00:48:49", "text": "えっと、私は"}, {"type": "subtitle", "time": 2939.349, "timestamp": "00:48:59", "text": "問題はこれです。"}]
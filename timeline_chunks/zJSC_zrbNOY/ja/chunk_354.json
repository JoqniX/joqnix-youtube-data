[{"type": "subtitle", "time": 21242.788, "timestamp": "05:54:02", "text": "などなど。そして私はただ、えーと"}, {"type": "subtitle", "time": 21245.43, "timestamp": "05:54:05", "text": "絵を描くようにコメントを読んでいる"}, {"type": "subtitle", "time": 21247.27, "timestamp": "05:54:07", "text": "すべてを1つのレイヤーにまとめるのは、"}, {"type": "subtitle", "time": 21250.788, "timestamp": "05:54:10", "text": "レイヤーについて怠惰で混乱していて、"}, {"type": "subtitle", "time": 21252.92, "timestamp": "05:54:12", "text": "フィルターとか全部。"}, {"type": "subtitle", "time": 21254.868, "timestamp": "05:54:14", "text": "[音楽]"}, {"type": "subtitle", "time": 21257.03, "timestamp": "05:54:17", "text": "「うん、たぶんそうするべきだ」と思った。"}, {"type": "subtitle", "time": 21260.548, "timestamp": "05:54:20", "text": "物事がどのように機能するのかを学び始める。"}, {"type": "subtitle", "time": 21263.59, "timestamp": "05:54:23", "text": "安全だった。絵を受け取ったとき"}, {"type": "subtitle", "time": 21267.19, "timestamp": "05:54:27", "text": "タブレットで、私が描こうとしたように"}, {"type": "subtitle", "time": 21270.07, "timestamp": "05:54:30", "text": "初めて、私はすべてを"}, {"type": "subtitle", "time": 21272.868, "timestamp": "05:54:32", "text": "一層。その時初めて気づいたんだ、ああ、"}, {"type": "subtitle", "time": 21276.23, "timestamp": "05:54:36", "text": "レイヤー2を作成する必要があります。"}, {"type": "subtitle", "time": 21280.868, "timestamp": "05:54:40", "text": "いいえ、ただ「ああ、それはできますよ」と言うだけです。うん。"}, {"type": "subtitle", "time": 21282.948, "timestamp": "05:54:42", "text": "何てことだ。"}, {"type": "subtitle", "time": 21285.27, "timestamp": "05:54:45", "text": "その時、他の人が"}, {"type": "subtitle", "time": 21288.708, "timestamp": "05:54:48", "text": "人々はそうする。線画とかそういうもの。あなた"}, {"type": "subtitle", "time": 21290.948, "timestamp": "05:54:50", "text": "1 つのレイヤーでスケッチしてから、"}, {"type": "subtitle", "time": 21293.75, "timestamp": "05:54:53", "text": "線画、あなたがクリーンアップなど全て、"}, {"type": "subtitle", "time": 21295.83, "timestamp": "05:54:55", "text": "次に、異なるレイヤーで色を塗り、"}, {"type": "subtitle", "time": 21298.868, "timestamp": "05:54:58", "text": "すべて。うわぁ、って感じ。"}]
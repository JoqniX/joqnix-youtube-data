[{"type": "subtitle", "time": 13685.189, "timestamp": "03:48:05", "text": "えっと"}, {"type": "subtitle", "time": 13687.75, "timestamp": "03:48:07", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 13690.309, "timestamp": "03:48:10", "text": "自分。それで、いつ始めたのですか？"}, {"type": "subtitle", "time": 13692.79, "timestamp": "03:48:12", "text": "最初はストリーミング配信ですか？"}, {"type": "subtitle", "time": 13697.03, "timestamp": "03:48:17", "text": "えっと、私の場合は確か2年前だったと思います。"}, {"type": "subtitle", "time": 13698.95, "timestamp": "03:48:18", "text": "うん。うん。 1年前のこと。 2年"}, {"type": "subtitle", "time": 13703.349, "timestamp": "03:48:23", "text": "戻る。確か2年前だったと思います。ああ"}, {"type": "subtitle", "time": 13706.63, "timestamp": "03:48:26", "text": "ニース。ストリーミングを始めたきっかけは何ですか？"}, {"type": "subtitle", "time": 13710.229, "timestamp": "03:48:30", "text": "1年待つべきではないと思います。"}, {"type": "subtitle", "time": 13712.229, "timestamp": "03:48:32", "text": "今となってはもう覚えていない。"}, {"type": "subtitle", "time": 13715.11, "timestamp": "03:48:35", "text": "どうでも。おお。えっと、"}, {"type": "subtitle", "time": 13717.11, "timestamp": "03:48:37", "text": "それはまるで私が"}, {"type": "subtitle", "time": 13720.469, "timestamp": "03:48:40", "text": "友達と私はよくチャットに参加していました"}, {"type": "subtitle", "time": 13722.95, "timestamp": "03:48:42", "text": "そしてそれを見つけたら、"}, {"type": "subtitle", "time": 13724.71, "timestamp": "03:48:44", "text": "試してみるべきだと提案し始めた"}, {"type": "subtitle", "time": 13726.309, "timestamp": "03:48:46", "text": "あまりにも。"}, {"type": "subtitle", "time": 13728.389, "timestamp": "03:48:48", "text": "最初は「いや、行かない」って感じだった"}, {"type": "subtitle", "time": 13731.99, "timestamp": "03:48:51", "text": "起こるかもしれないと思ったけど、もしかしたら"}]
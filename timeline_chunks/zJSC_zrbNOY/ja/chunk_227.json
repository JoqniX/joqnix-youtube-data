[{"type": "subtitle", "time": 13620.79, "timestamp": "03:47:00", "text": "さまざまな人が持つことができる色の権利"}, {"type": "subtitle", "time": 13624.389, "timestamp": "03:47:04", "text": "異なる色のチャットカラーですね"}, {"type": "subtitle", "time": 13627.83, "timestamp": "03:47:07", "text": "私の場合、Twitchには赤を付けますが、赤は付けません。"}, {"type": "subtitle", "time": 13630.95, "timestamp": "03:47:10", "text": "YouTube 用紫色、Twitch 用緑"}, {"type": "subtitle", "time": 13633.59, "timestamp": "03:47:13", "text": "キック、ブルーは信憑性を表す。"}, {"type": "subtitle", "time": 13636.87, "timestamp": "03:47:16", "text": "そう、そうだね。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "彼らは気づかないだろう。私は感じる"}, {"type": "subtitle", "time": 13641.59, "timestamp": "03:47:21", "text": "願わくば"}, {"type": "subtitle", "time": 13646.15, "timestamp": "03:47:26", "text": "まあ、そう願っています。うん。"}, {"type": "subtitle", "time": 13648.71, "timestamp": "03:47:28", "text": "だって、Twitchは時々"}, {"type": "subtitle", "time": 13652.309, "timestamp": "03:47:32", "text": "えーと本当に容赦しない"}, {"type": "subtitle", "time": 13657.99, "timestamp": "03:47:37", "text": "YouTuber。ええ、彼らの言う通りです。"}, {"type": "subtitle", "time": 13661.75, "timestamp": "03:47:41", "text": "戻ってきたと思う。それは去年のものだったのですか？"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "昨年のことです。ホットタブと"}, {"type": "subtitle", "time": 13668.469, "timestamp": "03:47:48", "text": "服装規定"}, {"type": "subtitle", "time": 13673.189, "timestamp": "03:47:53", "text": "すべて。何てことだ。知っている。"}]
[{"type": "subtitle", "time": 20460.628, "timestamp": "05:41:00", "text": "そして私はそこからそれを取らなければならないかもしれない"}, {"type": "subtitle", "time": 20462.47, "timestamp": "05:41:02", "text": "そして全て。慌ただしくなるだろう、"}, {"type": "subtitle", "time": 20465.35, "timestamp": "05:41:05", "text": "右？それで私はなんとか説得して"}, {"type": "subtitle", "time": 20471.11, "timestamp": "05:41:11", "text": "彼は何人かの人に尋ねて"}, {"type": "subtitle", "time": 20474.23, "timestamp": "05:41:14", "text": "形式やその他すべて、"}, {"type": "subtitle", "time": 20476.628, "timestamp": "05:41:16", "text": "物事にはたくさんの良い点があります"}, {"type": "subtitle", "time": 20479.67, "timestamp": "05:41:19", "text": "オフィスがないので、"}, {"type": "subtitle", "time": 20483.35, "timestamp": "05:41:23", "text": "私の家を使わなければならないのですが、こんな感じです"}, {"type": "subtitle", "time": 20486.628, "timestamp": "05:41:26", "text": "たくさんの切手や紙類などですね。"}, {"type": "subtitle", "time": 20490.47, "timestamp": "05:41:30", "text": "そうですね、そういうことです。その前には"}, {"type": "subtitle", "time": 20494.15, "timestamp": "05:41:34", "text": "私はカミソリの給料を試してみました。なぜなら、ああ、"}, {"type": "subtitle", "time": 20496.788, "timestamp": "05:41:36", "text": "Razer Payが役に立つかもしれない"}, {"type": "subtitle", "time": 20500.23, "timestamp": "05:41:40", "text": "えっと、3月頃かな。何てことだ、"}, {"type": "subtitle", "time": 20503.03, "timestamp": "05:41:43", "text": "それはまた別の話だ。ああ、そうだったんだ"}, {"type": "subtitle", "time": 20505.51, "timestamp": "05:41:45", "text": "そして、太陽光発電が必要だと気づきました"}, {"type": "subtitle", "time": 20508.39, "timestamp": "05:41:48", "text": "個人事業主みたいなもの。だから彼らは"}, {"type": "subtitle", "time": 20511.27, "timestamp": "05:41:51", "text": "リクエストにいいねするオプションと、"}, {"type": "subtitle", "time": 20513.51, "timestamp": "05:41:53", "text": "まるでビジネスオーナーのように"}, {"type": "subtitle", "time": 20516.628, "timestamp": "05:41:56", "text": "reg で登録済み。それで私は自分の電話番号を教えた"}, {"type": "subtitle", "time": 20519.75, "timestamp": "05:41:59", "text": "などなど。数時間後、私は"}]
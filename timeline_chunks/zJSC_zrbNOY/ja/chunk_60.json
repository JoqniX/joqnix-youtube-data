[{"type": "subtitle", "time": 3605.19, "timestamp": "01:00:05", "text": "リセットできることを期待してお風呂に入った"}, {"type": "subtitle", "time": 3607.99, "timestamp": "01:00:07", "text": "全身が、そして私はここに椅子に座っている"}, {"type": "subtitle", "time": 3612.47, "timestamp": "01:00:12", "text": "またしても、私はとても疲れている。"}, {"type": "subtitle", "time": 3618.549, "timestamp": "01:00:18", "text": "疲れ果てて、私は「うわあ」って感じ"}, {"type": "subtitle", "time": 3621.19, "timestamp": "01:00:21", "text": "おお"}, {"type": "subtitle", "time": 3637.589, "timestamp": "01:00:37", "text": "私は毎秒あくびをしている。"}, {"type": "subtitle", "time": 3640.549, "timestamp": "01:00:40", "text": "まともに座ることすらできない。だらりと座り込む"}, {"type": "subtitle", "time": 3642.789, "timestamp": "01:00:42", "text": "椅子。"}, {"type": "subtitle", "time": 3646.789, "timestamp": "01:00:46", "text": "もう少しで落ちそうだった。"}, {"type": "subtitle", "time": 3649.19, "timestamp": "01:00:49", "text": "6時30分になります。 30分あります"}, {"type": "subtitle", "time": 3651.75, "timestamp": "01:00:51", "text": "左。"}, {"type": "subtitle", "time": 3653.91, "timestamp": "01:00:53", "text": "Twitter関連のことはまだやっていません。された"}, {"type": "subtitle", "time": 3656.87, "timestamp": "01:00:56", "text": "Twitterで先延ばしにする"}]
[{"type": "subtitle", "time": 7096.95, "timestamp": "01:58:16", "text": "えっと、始めなきゃいけない気がする"}, {"type": "subtitle", "time": 7100.07, "timestamp": "01:58:20", "text": "自分自身への挑戦やその他"}, {"type": "subtitle", "time": 7104.07, "timestamp": "01:58:24", "text": "そうすることで、私自身も挑戦する機会を得られるのです。"}, {"type": "subtitle", "time": 7107.189, "timestamp": "01:58:27", "text": "優先順位リストを作成してください。"}, {"type": "subtitle", "time": 7110.229, "timestamp": "01:58:30", "text": "ストリームの種類ごとに私がしていることをリストアップします"}]
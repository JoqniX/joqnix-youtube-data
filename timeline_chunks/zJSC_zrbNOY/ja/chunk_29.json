[{"type": "subtitle", "time": 1743.51, "timestamp": "00:29:03", "text": "人との交流を制限する。"}, {"type": "subtitle", "time": 1753.909, "timestamp": "00:29:13", "text": "うん、無制限にすればいいよ。"}, {"type": "subtitle", "time": 1755.59, "timestamp": "00:29:15", "text": "誰かが本当に望んでいた"}, {"type": "subtitle", "time": 1759.029, "timestamp": "00:29:19", "text": "接続するには、わざわざ遠回りしなければならない"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "接続方法の公式な方法"}, {"type": "subtitle", "time": 1763.75, "timestamp": "00:29:23", "text": "あれ"}, {"type": "subtitle", "time": 1767.43, "timestamp": "00:29:27", "text": "なぜなら、もし私がコミュニケーションラインを開いたままにしておけば"}, {"type": "subtitle", "time": 1769.029, "timestamp": "00:29:29", "text": "開ける"}, {"type": "subtitle", "time": 1771.909, "timestamp": "00:29:31", "text": "奇妙な"}, {"type": "subtitle", "time": 1775.99, "timestamp": "00:29:35", "text": "卑劣な連中が入り込む。いや、DFSみたいな連中だ。"}, {"type": "subtitle", "time": 1779.51, "timestamp": "00:29:39", "text": "ボット、Discordも例外ではない。"}, {"type": "subtitle", "time": 1782.789, "timestamp": "00:29:42", "text": "私が人を追加するのをやめた理由は、"}, {"type": "subtitle", "time": 1784.71, "timestamp": "00:29:44", "text": "Discordでメッセージを送ってください。"}, {"type": "subtitle", "time": 1799.19, "timestamp": "00:29:59", "text": "何が効果的なのか、自分には分からないことに気づいた。何"}]
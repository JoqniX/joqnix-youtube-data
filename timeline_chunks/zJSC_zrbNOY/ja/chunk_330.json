[{"type": "subtitle", "time": 19802.31, "timestamp": "05:30:02", "text": "だって、私、騙されたの？彼らは手に入れたのか"}, {"type": "subtitle", "time": 19804.47, "timestamp": "05:30:04", "text": "詐欺に遭った？"}, {"type": "subtitle", "time": 19806.23, "timestamp": "05:30:06", "text": "何？"}, {"type": "subtitle", "time": 19816.788, "timestamp": "05:30:16", "text": "何してるの？"}, {"type": "subtitle", "time": 19822.23, "timestamp": "05:30:22", "text": "[音楽]"}, {"type": "subtitle", "time": 19825.27, "timestamp": "05:30:25", "text": "でも、タミー、それらは何か良かったの？"}, {"type": "subtitle", "time": 19828.23, "timestamp": "05:30:28", "text": "何か気に入ったものはありましたか？彼らは"}, {"type": "subtitle", "time": 19830.47, "timestamp": "05:30:30", "text": "役立つ？"}, {"type": "subtitle", "time": 19834.628, "timestamp": "05:30:34", "text": "どういうわけか、私は、えっと、時々"}, {"type": "subtitle", "time": 19837.35, "timestamp": "05:30:37", "text": "国際的なものをたくさん手に入れる"}, {"type": "subtitle", "time": 19839.67, "timestamp": "05:30:39", "text": "広告。"}, {"type": "subtitle", "time": 19843.51, "timestamp": "05:30:43", "text": "ドイツ人とか、そういう人たちのことですよね？うん。だから私は"}, {"type": "subtitle", "time": 19845.67, "timestamp": "05:30:45", "text": "友達の配信みたいで"}, {"type": "subtitle", "time": 19847.43, "timestamp": "05:30:47", "text": "突然広告が目に入って、"}, {"type": "subtitle", "time": 19851.03, "timestamp": "05:30:51", "text": "心配ないよ、それから、えっと"}, {"type": "subtitle", "time": 19852.948, "timestamp": "05:30:52", "text": "あなたは英語を話していないし、私はただ"}, {"type": "subtitle", "time": 19855.59, "timestamp": "05:30:55", "text": "少なくとも、といった言葉に焦点を当てる"}, {"type": "subtitle", "time": 19857.99, "timestamp": "05:30:57", "text": "誰かを特定します。私たちの"}]
[{"type": "subtitle", "time": 10985.75, "timestamp": "03:03:05", "text": "時にはその活動はうまくいき、"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "ボタンが重なるようにした方がいいと思う"}, {"type": "subtitle", "time": 11004.87, "timestamp": "03:03:24", "text": "あれ"}, {"type": "subtitle", "time": 11009.03, "timestamp": "03:03:29", "text": "そのため、簡単にステータスが変わります"}, {"type": "subtitle", "time": 11011.19, "timestamp": "03:03:31", "text": "ええと、州"}, {"type": "subtitle", "time": 11014.309, "timestamp": "03:03:34", "text": "そして州を建設する"}, {"type": "subtitle", "time": 11016.469, "timestamp": "03:03:36", "text": "すべて。"}, {"type": "subtitle", "time": 11018.79, "timestamp": "03:03:38", "text": "それが正しいやり方かどうかはわかりません"}, {"type": "subtitle", "time": 11021.269, "timestamp": "03:03:41", "text": "物事は、しかし私はそうしたい"}, {"type": "subtitle", "time": 11023.75, "timestamp": "03:03:43", "text": "やってみて。"}]
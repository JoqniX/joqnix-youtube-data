[{"type": "subtitle", "time": 16201.75, "timestamp": "04:30:01", "text": "ボイスチャットでこれらすべてを言って、"}, {"type": "subtitle", "time": 16204.07, "timestamp": "04:30:04", "text": "ええ、あのトラウマを負って以来"}, {"type": "subtitle", "time": 16205.91, "timestamp": "04:30:05", "text": "PTSD（心的外傷後ストレス障害）に対抗する。"}, {"type": "subtitle", "time": 16208.87, "timestamp": "04:30:08", "text": "えっと、他にもあったと思うんだけど"}, {"type": "subtitle", "time": 16214.07, "timestamp": "04:30:14", "text": "Discordのボイスチャット機能を使ったインスタンス。私は"}, {"type": "subtitle", "time": 16218.55, "timestamp": "04:30:18", "text": "私のDiscord VCでアクティブに活動するために、"}, {"type": "subtitle", "time": 16221.75, "timestamp": "04:30:21", "text": "みんな入れてあげよう、Discordは"}, {"type": "subtitle", "time": 16223.67, "timestamp": "04:30:23", "text": "コミュニティの人々が集まる方法と"}, {"type": "subtitle", "time": 16226.71, "timestamp": "04:30:26", "text": "雰囲気、わかるでしょ？ええ、そうですね。"}, {"type": "subtitle", "time": 16230.389, "timestamp": "04:30:30", "text": "えーと、2020年の期間だと思うんだけど、"}, {"type": "subtitle", "time": 16232.55, "timestamp": "04:30:32", "text": "Discordは大盛況だったと思う。みんな"}, {"type": "subtitle", "time": 16235.51, "timestamp": "04:30:35", "text": "チャットとか色々して、私は"}, {"type": "subtitle", "time": 16238.87, "timestamp": "04:30:38", "text": "他のYouTuberのDiscordサーバーを支援する"}, {"type": "subtitle", "time": 16241.67, "timestamp": "04:30:41", "text": "えーと、伍長中隊があったんだけど"}, {"type": "subtitle", "time": 16246.149, "timestamp": "04:30:46", "text": "Taskscape の場合、Discord の前に"}, {"type": "subtitle", "time": 16248.95, "timestamp": "04:30:48", "text": "サーバーが作られました。私はそれらすべてに使用しました。"}, {"type": "subtitle", "time": 16251.189, "timestamp": "04:30:51", "text": "以前はシャワー室で過ごしていて"}, {"type": "subtitle", "time": 16254.63, "timestamp": "04:30:54", "text": "すべて楽しかったし、その後"}, {"type": "subtitle", "time": 16257.11, "timestamp": "04:30:57", "text": "かつてはみんな"}, {"type": "subtitle", "time": 16259.91, "timestamp": "04:30:59", "text": "共同シャワーがあり、"}]
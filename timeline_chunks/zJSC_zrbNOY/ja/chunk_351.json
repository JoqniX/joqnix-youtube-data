[{"type": "subtitle", "time": 21060.628, "timestamp": "05:51:00", "text": "そして私はそういう人たちを助けていると思う"}, {"type": "subtitle", "time": 21063.59, "timestamp": "05:51:03", "text": "私が助けた人たちのうちの一人は"}, {"type": "subtitle", "time": 21066.39, "timestamp": "05:51:06", "text": "それで彼らは「うん、やらないのはどう？」って感じだった"}, {"type": "subtitle", "time": 21069.35, "timestamp": "05:51:09", "text": "それは仕事であり、それが私の最初の仕事でした"}, {"type": "subtitle", "time": 21072.548, "timestamp": "05:51:12", "text": "私の人生で一度も"}, {"type": "subtitle", "time": 21075.99, "timestamp": "05:51:15", "text": "仕事みたいなものを手に入れる。私はこう思った"}, {"type": "subtitle", "time": 21078.548, "timestamp": "05:51:18", "text": "なぜなら今は難しいから、えーと、現実世界では"}, {"type": "subtitle", "time": 21080.948, "timestamp": "05:51:20", "text": "証明書などを提示する必要がある"}, {"type": "subtitle", "time": 21084.23, "timestamp": "05:51:24", "text": "あなただけが仕事を得て、そしてこれがこれ"}, {"type": "subtitle", "time": 21087.75, "timestamp": "05:51:27", "text": "それは私が何かをしているようなものです"}, {"type": "subtitle", "time": 21090.708, "timestamp": "05:51:30", "text": "本当に情熱を持っていて、人を助けるのが好きです"}, {"type": "subtitle", "time": 21093.59, "timestamp": "05:51:33", "text": "仕事をしているとか、何か"}, {"type": "subtitle", "time": 21095.75, "timestamp": "05:51:35", "text": "これ。ちょっと違う感じが楽しい"}, {"type": "subtitle", "time": 21098.31, "timestamp": "05:51:38", "text": "経験。だから、私にとっては初めてだった"}, {"type": "subtitle", "time": 21101.99, "timestamp": "05:51:41", "text": "物事がどうなっているのかを学ぶことなど"}, {"type": "subtitle", "time": 21104.948, "timestamp": "05:51:44", "text": "そんな感じ。だから私は「うん、やるよ」って言ったんだ"}, {"type": "subtitle", "time": 21108.31, "timestamp": "05:51:48", "text": "「そうね」そして、私は持っていなかったので"}, {"type": "subtitle", "time": 21110.47, "timestamp": "05:51:50", "text": "十分だ、まだ最後の分を支払わなければならない"}, {"type": "subtitle", "time": 21113.83, "timestamp": "05:51:53", "text": "月。こうして音楽コースが始まった"}, {"type": "subtitle", "time": 21117.67, "timestamp": "05:51:57", "text": "1月から始まり、そして終わりを迎える"}]
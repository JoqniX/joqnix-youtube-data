[{"type": "subtitle", "time": 12904.63, "timestamp": "03:35:04", "text": "私は思う"}, {"type": "subtitle", "time": 12911.349, "timestamp": "03:35:11", "text": "チャドは今、私の声を聞いている。そうだといい。うん。"}, {"type": "subtitle", "time": 12913.83, "timestamp": "03:35:13", "text": "こんにちは、みんな。"}, {"type": "subtitle", "time": 12921.03, "timestamp": "03:35:21", "text": "もっと謝罪したいところだけど、ほらね"}, {"type": "subtitle", "time": 12922.63, "timestamp": "03:35:22", "text": "私もおそらく同じことをするでしょう"}, {"type": "subtitle", "time": 12927.91, "timestamp": "03:35:27", "text": "次のストリーム。うん。心配ない。"}, {"type": "subtitle", "time": 12931.429, "timestamp": "03:35:31", "text": "大丈夫。チャットではもう慣れているよ。"}, {"type": "subtitle", "time": 12934.87, "timestamp": "03:35:34", "text": "これが、彼らがインターネットにお金を払っている理由だ。"}, {"type": "subtitle", "time": 12937.99, "timestamp": "03:35:37", "text": "心配ない。うん。それはとても奇妙だ"}, {"type": "subtitle", "time": 12940.469, "timestamp": "03:35:40", "text": "ただし、検索や音声を追加した方法は"}, {"type": "subtitle", "time": 12943.429, "timestamp": "03:35:43", "text": "キャプチャショーが表示されず、"}, {"type": "subtitle", "time": 12945.75, "timestamp": "03:35:45", "text": "オーディオミキサーにセットする。それは本当に"}, {"type": "subtitle", "time": 12948.229, "timestamp": "03:35:48", "text": "サス。"}, {"type": "subtitle", "time": 12952.469, "timestamp": "03:35:52", "text": "私はしません。 OBSをアップデートしましたか？"}, {"type": "subtitle", "time": 12954.309, "timestamp": "03:35:54", "text": "うん。うん。通常はいつでも"}, {"type": "subtitle", "time": 12956.87, "timestamp": "03:35:56", "text": "アップデートを見せてくれたら、それを実行します。何ですか"}]
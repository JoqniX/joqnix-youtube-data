[{"type": "subtitle", "time": 20882.708, "timestamp": "05:48:02", "text": "授業が行われていた。私の試験は"}, {"type": "subtitle", "time": 20886.948, "timestamp": "05:48:06", "text": "ODL IGNU と同じように続けています。だから私はそうする"}, {"type": "subtitle", "time": 20890.708, "timestamp": "05:48:10", "text": "IGNU、大学、英語文学"}, {"type": "subtitle", "time": 20893.83, "timestamp": "05:48:13", "text": "栄誉。そういうことが起きていたんです。それから"}, {"type": "subtitle", "time": 20897.35, "timestamp": "05:48:17", "text": "私は日本に行かなければならないし、"}, {"type": "subtitle", "time": 20899.27, "timestamp": "05:48:19", "text": "私はJokathonのストリーミングをしていて、"}, {"type": "subtitle", "time": 20901.75, "timestamp": "05:48:21", "text": "すべて、そして多くのことが"}, {"type": "subtitle", "time": 20903.59, "timestamp": "05:48:23", "text": "そこには。だから私はこう思った、それで彼はこう言った"}, {"type": "subtitle", "time": 20905.91, "timestamp": "05:48:25", "text": "5人までこなせるだろうかと心配になる"}, {"type": "subtitle", "time": 20908.868, "timestamp": "05:48:28", "text": "すべてを一人でやる？多すぎた"}, {"type": "subtitle", "time": 20912.628, "timestamp": "05:48:32", "text": "今。だから私は説得する。あなたにとって圧倒される"}, {"type": "subtitle", "time": 20915.51, "timestamp": "05:48:35", "text": "同じように。うん。そして私は説得し、"}, {"type": "subtitle", "time": 20919.75, "timestamp": "05:48:39", "text": "説得して、彼は許可して、彼は尋ねた"}, {"type": "subtitle", "time": 20923.11, "timestamp": "05:48:43", "text": "そういうことなら彼は話すだろう"}, {"type": "subtitle", "time": 20925.91, "timestamp": "05:48:45", "text": "友人たちと確認して、これが"}, {"type": "subtitle", "time": 20928.548, "timestamp": "05:48:48", "text": "良いことかそうでないかは、その時だけ彼は"}, {"type": "subtitle", "time": 20930.788, "timestamp": "05:48:50", "text": "「うん、君ならできるよ」みたいな感じ"}, {"type": "subtitle", "time": 20935.35, "timestamp": "05:48:55", "text": "もの。ええ、それで、ついに手に入れました"}, {"type": "subtitle", "time": 20937.35, "timestamp": "05:48:57", "text": "それで私は「うん、そうするよ」って言ったんだ"}]
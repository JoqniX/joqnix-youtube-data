[{"type": "subtitle", "time": 13560.229, "timestamp": "03:46:00", "text": "ええ、彼らはあなたが見せるのが好きです"}, {"type": "subtitle", "time": 13563.91, "timestamp": "03:46:03", "text": "プラットフォームのアイコンとか、そういうやつですよね？えっと、それ"}, {"type": "subtitle", "time": 13566.55, "timestamp": "03:46:06", "text": "それは、"}, {"type": "subtitle", "time": 13568.71, "timestamp": "03:46:08", "text": "Twitch の人々は、ああ、"}, {"type": "subtitle", "time": 13571.75, "timestamp": "03:46:11", "text": "チャットを共有したり、統合したりしていますか？"}, {"type": "subtitle", "time": 13573.349, "timestamp": "03:46:13", "text": "何か。"}, {"type": "subtitle", "time": 13575.349, "timestamp": "03:46:15", "text": "うん。"}, {"type": "subtitle", "time": 13577.91, "timestamp": "03:46:17", "text": "でも、確かに痛みはあります。現在、私は"}, {"type": "subtitle", "time": 13582.309, "timestamp": "03:46:22", "text": "えっと、この日本語を見つけたんだけど"}, {"type": "subtitle", "time": 13585.59, "timestamp": "03:46:25", "text": "「One K」とかいう名前のアプリ。"}, {"type": "subtitle", "time": 13588.389, "timestamp": "03:46:28", "text": "YouTube、Twitch、"}, {"type": "subtitle", "time": 13591.75, "timestamp": "03:46:31", "text": "キック、ビリー、あのプラットフォーム全部"}, {"type": "subtitle", "time": 13595.51, "timestamp": "03:46:35", "text": "そうですね、チャットを統合できます。でも私は"}, {"type": "subtitle", "time": 13598.95, "timestamp": "03:46:38", "text": "水平になるようにした"}, {"type": "subtitle", "time": 13602.15, "timestamp": "03:46:42", "text": "一番下の方。うん。つまり、"}, {"type": "subtitle", "time": 13604.389, "timestamp": "03:46:44", "text": "えーと、プラットフォームが表示されないので"}, {"type": "subtitle", "time": 13609.269, "timestamp": "03:46:49", "text": "えっと、Twitchはありえないと思ったんだけど"}, {"type": "subtitle", "time": 13612.469, "timestamp": "03:46:52", "text": "理解してくれるでしょう"}, {"type": "subtitle", "time": 13614.79, "timestamp": "03:46:54", "text": "チャットの統合"}, {"type": "subtitle", "time": 13618.309, "timestamp": "03:46:58", "text": "だって、Twitchにはユーザーがいるから"}]
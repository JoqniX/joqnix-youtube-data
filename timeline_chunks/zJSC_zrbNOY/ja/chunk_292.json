[{"type": "subtitle", "time": 17520.948, "timestamp": "04:52:00", "text": "視聴者とその視聴者は良い視聴者になった"}, {"type": "subtitle", "time": 17524.788, "timestamp": "04:52:04", "text": "私の友人で、そして時が経つにつれて彼女は"}, {"type": "subtitle", "time": 17530.15, "timestamp": "04:52:10", "text": "2022年に誕生日プレゼントを贈った"}, {"type": "subtitle", "time": 17532.07, "timestamp": "04:52:12", "text": "そして、それが今ご覧になっているモデルです。"}, {"type": "subtitle", "time": 17536.788, "timestamp": "04:52:16", "text": "今は、そう、それは彼女と同じようなものです"}, {"type": "subtitle", "time": 17539.75, "timestamp": "04:52:19", "text": "彼女はPNGからも同じことをした"}, {"type": "subtitle", "time": 17541.03, "timestamp": "04:52:21", "text": "オリジナルPNG"}, {"type": "subtitle", "time": 17544.948, "timestamp": "04:52:24", "text": "最初のデザイン、そして彼女は"}, {"type": "subtitle", "time": 17548.47, "timestamp": "04:52:28", "text": "それをライブ2Dにして、"}, {"type": "subtitle", "time": 17554.07, "timestamp": "04:52:34", "text": "起こった。ええ、それは素敵ですね。"}, {"type": "subtitle", "time": 17556.23, "timestamp": "04:52:36", "text": "そして、新しいものがそこにある。私は思う"}, {"type": "subtitle", "time": 17559.19, "timestamp": "04:52:39", "text": "見せたよ。ああ、君に正しく見せたよ。それは"}, {"type": "subtitle", "time": 17563.51, "timestamp": "04:52:43", "text": "とても綺麗。えっと、まだ公開されてないのは"}, {"type": "subtitle", "time": 17567.75, "timestamp": "04:52:47", "text": "えーと、私は戦わなければならない"}, {"type": "subtitle", "time": 17570.788, "timestamp": "04:52:50", "text": "それを公開することは法的に問題ないので、"}, {"type": "subtitle", "time": 17573.91, "timestamp": "04:52:53", "text": "えっと、私は免許を持っているので、"}, {"type": "subtitle", "time": 17577.35, "timestamp": "04:52:57", "text": "シェアできます。"}]
[{"type": "subtitle", "time": 15305.03, "timestamp": "04:15:05", "text": "私はここから出て行きます。感謝"}, {"type": "subtitle", "time": 15307.269, "timestamp": "04:15:07", "text": "どういたしまして。いいえ。"}, {"type": "subtitle", "time": 15309.67, "timestamp": "04:15:09", "text": "ラーメンは手に入れましたか？あなた"}, {"type": "subtitle", "time": 15313.59, "timestamp": "04:15:13", "text": "忘れたの？いいえ、していません。私は考えました"}, {"type": "subtitle", "time": 15315.11, "timestamp": "04:15:15", "text": "それを取りに戻ろうとしたのですが、その時私は"}, {"type": "subtitle", "time": 15316.389, "timestamp": "04:15:16", "text": "まあ、いいや。行きたくない"}, {"type": "subtitle", "time": 15327.349, "timestamp": "04:15:27", "text": "そして、私がオンラインでユーチューバーたちに会ったとき"}, {"type": "subtitle", "time": 15330.07, "timestamp": "04:15:30", "text": "えーっと、プネーでの現実の生活は、"}, {"type": "subtitle", "time": 15332.229, "timestamp": "04:15:32", "text": "「ああ、この人たちは"}, {"type": "subtitle", "time": 15333.99, "timestamp": "04:15:33", "text": "本物。\""}, {"type": "subtitle", "time": 15337.99, "timestamp": "04:15:37", "text": "それが私の最初の反応でした"}, {"type": "subtitle", "time": 15339.91, "timestamp": "04:15:39", "text": "えっと、2、3回会ったかな"}, {"type": "subtitle", "time": 15343.189, "timestamp": "04:15:43", "text": "数年前。私たちはDiscordで話しました"}, {"type": "subtitle", "time": 15347.91, "timestamp": "04:15:47", "text": "DiscordやTwitterなどを通じて"}, {"type": "subtitle", "time": 15350.469, "timestamp": "04:15:50", "text": "まるで生身の人間を目の当たりにしているような感覚。"}, {"type": "subtitle", "time": 15353.75, "timestamp": "04:15:53", "text": "現実の生活。何てことだ。私は「ああ、"}, {"type": "subtitle", "time": 15356.55, "timestamp": "04:15:56", "text": "ああ、本当にリアルだ。あなたは実在するのですか？本物。"}, {"type": "subtitle", "time": 15359.429, "timestamp": "04:15:59", "text": "「偽物じゃないよ。」そう。それが私の"}]
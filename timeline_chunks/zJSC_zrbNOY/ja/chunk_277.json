[{"type": "subtitle", "time": 16621.349, "timestamp": "04:37:01", "text": "つまり、私はそういう人たちを何人か知っています"}, {"type": "subtitle", "time": 16623.83, "timestamp": "04:37:03", "text": "そうするけど、同時に"}, {"type": "subtitle", "time": 16628.23, "timestamp": "04:37:08", "text": "私にとって夢を見ることは"}, {"type": "subtitle", "time": 16631.189, "timestamp": "04:37:11", "text": "時々、私があなたに"}, {"type": "subtitle", "time": 16634.709, "timestamp": "04:37:14", "text": "少しばかげていることを知ってください、少しではなく"}, {"type": "subtitle", "time": 16636.629, "timestamp": "04:37:16", "text": "ちょっとばかげてる、すごくばかげてる、そして私はそう思わない"}, {"type": "subtitle", "time": 16639.99, "timestamp": "04:37:19", "text": "あまり深く考えすぎなくていいんだよ"}, {"type": "subtitle", "time": 16642.15, "timestamp": "04:37:22", "text": "えっと、私の振る舞い方とか、私がどんな人間かとか"}, {"type": "subtitle", "time": 16644.47, "timestamp": "04:37:24", "text": "言う"}, {"type": "subtitle", "time": 16647.51, "timestamp": "04:37:27", "text": "だからここは私がいられる空間です"}, {"type": "subtitle", "time": 16649.51, "timestamp": "04:37:29", "text": "そういうタイプの人と、それから"}, {"type": "subtitle", "time": 16652.869, "timestamp": "04:37:32", "text": "実生活の脚本があるのは"}, {"type": "subtitle", "time": 16657.109, "timestamp": "04:37:37", "text": "セラピーとか学習とか"}, {"type": "subtitle", "time": 16659.269, "timestamp": "04:37:39", "text": "そして私はこれらのことをたくさんすることができません"}, {"type": "subtitle", "time": 16661.109, "timestamp": "04:37:41", "text": "物事を言い、私がしていることをたくさん言う"}, {"type": "subtitle", "time": 16667.189, "timestamp": "04:37:47", "text": "うん"}, {"type": "subtitle", "time": 16669.83, "timestamp": "04:37:49", "text": "ずっとそうだったけど、まあ、そうだね"}, {"type": "subtitle", "time": 16671.59, "timestamp": "04:37:51", "text": "だから私はある意味、"}, {"type": "subtitle", "time": 16675.59, "timestamp": "04:37:55", "text": "ここは愚痴をこぼす場所ではありません"}, {"type": "subtitle", "time": 16679.189, "timestamp": "04:37:59", "text": "うん、もっと愚痴を。理解できます"}]
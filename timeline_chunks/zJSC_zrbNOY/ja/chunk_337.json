[{"type": "subtitle", "time": 20222.07, "timestamp": "05:37:02", "text": "私は、"}, {"type": "subtitle", "time": 20227.11, "timestamp": "05:37:07", "text": "それを忘れて、このえっと、"}, {"type": "subtitle", "time": 20228.788, "timestamp": "05:37:08", "text": "インドとパキスタンの出来事が起こり、"}, {"type": "subtitle", "time": 20231.19, "timestamp": "05:37:11", "text": "全てが4月に延期されました"}, {"type": "subtitle", "time": 20235.91, "timestamp": "05:37:15", "text": "摂取した時、私は「うん」と思った。それで"}, {"type": "subtitle", "time": 20238.548, "timestamp": "05:37:18", "text": "ええ、私もTwitchで"}, {"type": "subtitle", "time": 20242.15, "timestamp": "05:37:22", "text": "私を検証できなかったと思います"}, {"type": "subtitle", "time": 20244.708, "timestamp": "05:37:24", "text": "アフィリエイトパートの件が起こったんですよね"}, {"type": "subtitle", "time": 20248.948, "timestamp": "05:37:28", "text": "そこには。やり直さなければならなかった。おお"}, {"type": "subtitle", "time": 20251.59, "timestamp": "05:37:31", "text": "うん。だから私はそれをもう一度やり直さなければならなかった"}, {"type": "subtitle", "time": 20255.75, "timestamp": "05:37:35", "text": "何らかの奇妙な理由で、そして私は彼らが"}, {"type": "subtitle", "time": 20258.628, "timestamp": "05:37:38", "text": "なぜ私の"}, {"type": "subtitle", "time": 20260.39, "timestamp": "05:37:40", "text": "書類と一緒に顔か何か。"}, {"type": "subtitle", "time": 20264.23, "timestamp": "05:37:44", "text": "私は、なぜ自分がこんなに変わってしまったのかと思う。"}, {"type": "subtitle", "time": 20266.868, "timestamp": "05:37:46", "text": "そんなに？それはただの古い写真です"}, {"type": "subtitle", "time": 20270.47, "timestamp": "05:37:50", "text": "私のもう一台の車。えっと、なぜ？ええ、私も"}, {"type": "subtitle", "time": 20272.39, "timestamp": "05:37:52", "text": "その情報は確認できませんでした。だから私は"}, {"type": "subtitle", "time": 20275.11, "timestamp": "05:37:55", "text": "変更できませんでした。"}, {"type": "subtitle", "time": 20276.948, "timestamp": "05:37:56", "text": "支払いのことですよね？彼らが"}, {"type": "subtitle", "time": 20279.03, "timestamp": "05:37:59", "text": "50ドルにした。"}]
[{"type": "subtitle", "time": 19623.19, "timestamp": "05:27:03", "text": "王位について、えっと、私が覚えているのは、"}, {"type": "subtitle", "time": 19625.67, "timestamp": "05:27:05", "text": "まず、PayPalを設定しました。"}, {"type": "subtitle", "time": 19628.39, "timestamp": "05:27:08", "text": "彼らは文字通り"}, {"type": "subtitle", "time": 19630.708, "timestamp": "05:27:10", "text": "住所全文。"}, {"type": "subtitle", "time": 19634.31, "timestamp": "05:27:14", "text": "うん。ビジネスマンの皆さん、あなたはそれを作りましたか？"}, {"type": "subtitle", "time": 19637.51, "timestamp": "05:27:17", "text": "それとも通常通り？えっと、それは私が"}, {"type": "subtitle", "time": 19639.27, "timestamp": "05:27:19", "text": "それが、"}, {"type": "subtitle", "time": 19641.83, "timestamp": "05:27:21", "text": "b ええと、もし私がそれを保管しない場合は、完全な住所"}, {"type": "subtitle", "time": 19646.39, "timestamp": "05:27:26", "text": "ビジネス1。ああ、ありがたいことに最初の"}, {"type": "subtitle", "time": 19651.43, "timestamp": "05:27:31", "text": "えーと、私が依頼した人、えーと"}, {"type": "subtitle", "time": 19653.83, "timestamp": "05:27:33", "text": "それは誰だったのか？クールなフィード。彼らです"}, {"type": "subtitle", "time": 19656.548, "timestamp": "05:27:36", "text": "本当に素晴らしい。えっと、つまり、でも私は思う"}, {"type": "subtitle", "time": 19659.35, "timestamp": "05:27:39", "text": "彼らのオーディオのほとんどは"}, {"type": "subtitle", "time": 19663.67, "timestamp": "05:27:43", "text": "職場でも安全に使用できます。だから私は彼らと一緒にやったが"}, {"type": "subtitle", "time": 19666.39, "timestamp": "05:27:46", "text": "彼らは親切にも私に知らせてくれた"}, {"type": "subtitle", "time": 19669.27, "timestamp": "05:27:49", "text": "私のPayPalで起こっていることです"}, {"type": "subtitle", "time": 19674.31, "timestamp": "05:27:54", "text": "そして私は「本当にありがとうございました」と言いました。"}, {"type": "subtitle", "time": 19676.23, "timestamp": "05:27:56", "text": "なんてこった。"}, {"type": "subtitle", "time": 19678.948, "timestamp": "05:27:58", "text": "わかってるけど、その後、"}]
[{"type": "subtitle", "time": 22141.51, "timestamp": "06:09:01", "text": "ペアは、"}, {"type": "subtitle", "time": 22145.19, "timestamp": "06:09:05", "text": "その他、そして、それははるかに悪いと感じました"}, {"type": "subtitle", "time": 22147.27, "timestamp": "06:09:07", "text": "お弁当を作って持ってきてください"}, {"type": "subtitle", "time": 22149.43, "timestamp": "06:09:09", "text": "そうすると、食事をする時間さえなくなる"}, {"type": "subtitle", "time": 22152.31, "timestamp": "06:09:12", "text": "そしてあなたが家に帰る頃には"}, {"type": "subtitle", "time": 22155.67, "timestamp": "06:09:15", "text": "えっと、時々腐ってしまうので"}, {"type": "subtitle", "time": 22160.07, "timestamp": "06:09:20", "text": "一日中とても暑くなるだろう。うん。"}, {"type": "subtitle", "time": 22162.628, "timestamp": "06:09:22", "text": "それで、私は途中で止めました"}, {"type": "subtitle", "time": 22165.27, "timestamp": "06:09:25", "text": "料理を作るのが好きだったのですが、最近は"}, {"type": "subtitle", "time": 22167.11, "timestamp": "06:09:27", "text": "また物作りを始めた。だからそれは"}, {"type": "subtitle", "time": 22170.07, "timestamp": "06:09:30", "text": "ニース。"}, {"type": "subtitle", "time": 22171.91, "timestamp": "06:09:31", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 22178.788, "timestamp": "06:09:38", "text": "料理を作るのは楽しい。クッキーを作る"}, {"type": "subtitle", "time": 22182.628, "timestamp": "06:09:42", "text": "いつかは。ああ、クッキー。待って、"}, {"type": "subtitle", "time": 22185.19, "timestamp": "06:09:45", "text": "中くらいのものを作ったり、"}, {"type": "subtitle", "time": 22188.15, "timestamp": "06:09:48", "text": "重いもの、例えば魚みたいな"}, {"type": "subtitle", "time": 22191.35, "timestamp": "06:09:51", "text": "カレーとか、チキンとか、そういう類のもの？"}, {"type": "subtitle", "time": 22194.15, "timestamp": "06:09:54", "text": "ええ、それも作れますよ。おお、"}, {"type": "subtitle", "time": 22195.99, "timestamp": "06:09:55", "text": "ニース。"}, {"type": "subtitle", "time": 22199.03, "timestamp": "06:09:59", "text": "まだ羊肉は食べたことがないんです。"}]
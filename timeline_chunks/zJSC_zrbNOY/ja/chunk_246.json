[{"type": "subtitle", "time": 14760.15, "timestamp": "04:06:00", "text": "「お元気ですか？」と尋ねています。私は"}, {"type": "subtitle", "time": 14764.309, "timestamp": "04:06:04", "text": "素晴らしい。えっと、風邪を引いたのは、"}, {"type": "subtitle", "time": 14767.91, "timestamp": "04:06:07", "text": "雨とかのせいで、ここは寒いです。"}, {"type": "subtitle", "time": 14769.59, "timestamp": "04:06:09", "text": "うん。鼻水が出ているだけです"}, {"type": "subtitle", "time": 14771.59, "timestamp": "04:06:11", "text": "今日。"}, {"type": "subtitle", "time": 14774.63, "timestamp": "04:06:14", "text": "でも、私は元気です。皆さんが"}, {"type": "subtitle", "time": 14777.349, "timestamp": "04:06:17", "text": "順調です。"}, {"type": "subtitle", "time": 14780.309, "timestamp": "04:06:20", "text": "うん、"}, {"type": "subtitle", "time": 14783.51, "timestamp": "04:06:23", "text": "今日は少し曇り空だったけど、"}, {"type": "subtitle", "time": 14785.99, "timestamp": "04:06:25", "text": "雨は降らなかった。でも、"}, {"type": "subtitle", "time": 14788.55, "timestamp": "04:06:28", "text": "気温の急激な変動は"}, {"type": "subtitle", "time": 14792.15, "timestamp": "04:06:32", "text": "少しだけ私に"}, {"type": "subtitle", "time": 14794.79, "timestamp": "04:06:34", "text": "うん。まるでアレルギーのような"}, {"type": "subtitle", "time": 14796.79, "timestamp": "04:06:36", "text": "反応。それで、私はくしゃみをしたんです"}, {"type": "subtitle", "time": 14798.87, "timestamp": "04:06:38", "text": "ノンストップだが、しばらくすると"}, {"type": "subtitle", "time": 14801.11, "timestamp": "04:06:41", "text": "突然いなくなってしまった。ああ、何なのかわからない"}, {"type": "subtitle", "time": 14809.83, "timestamp": "04:06:49", "text": "早く良くなることを願っています。コールドワイズ、"}, {"type": "subtitle", "time": 14816.469, "timestamp": "04:06:56", "text": "以前は私がしていたこと"}, {"type": "subtitle", "time": 14819.51, "timestamp": "04:06:59", "text": "寒かったですね、あなたもそうなのか分かりませんが"}]
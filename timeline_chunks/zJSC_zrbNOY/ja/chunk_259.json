[{"type": "subtitle", "time": 15541.429, "timestamp": "04:19:01", "text": "これまで一度も交流したことがない。だから私は"}, {"type": "subtitle", "time": 15544.63, "timestamp": "04:19:04", "text": "気づいたんだけど、"}, {"type": "subtitle", "time": 15548.79, "timestamp": "04:19:08", "text": "コラボレーションを好む人、またはコラボレーションを好まない人"}, {"type": "subtitle", "time": 15551.429, "timestamp": "04:19:11", "text": "コラボ I 私はそれをハングアウトのように見ていました"}, {"type": "subtitle", "time": 15554.469, "timestamp": "04:19:14", "text": "相手のことをもっとよく知ることができるとわかる"}, {"type": "subtitle", "time": 15556.95, "timestamp": "04:19:16", "text": "コラボよりもコラボの方が良い"}, {"type": "subtitle", "time": 15558.55, "timestamp": "04:19:18", "text": "たくさんのことを心配しなければならない"}, {"type": "subtitle", "time": 15561.75, "timestamp": "04:19:21", "text": "そう、それで私は気づいたのですが、"}, {"type": "subtitle", "time": 15565.11, "timestamp": "04:19:25", "text": "一部のユーチューバーやクリエイターは、"}, {"type": "subtitle", "time": 15569.11, "timestamp": "04:19:29", "text": "えっと、私はそうではなかったので、"}, {"type": "subtitle", "time": 15572.149, "timestamp": "04:19:32", "text": "彼らと話す際に、適切な対応をすべきですよね？"}, {"type": "subtitle", "time": 15573.91, "timestamp": "04:19:33", "text": "彼らは自分たちとしかコラボレーションしない"}, {"type": "subtitle", "time": 15576.229, "timestamp": "04:19:36", "text": "親しいとかそういう関係です。だから私はこう思った、"}, {"type": "subtitle", "time": 15579.51, "timestamp": "04:19:39", "text": "「ああ、そういう人もいるんだね？私はしなかったけど。」"}, {"type": "subtitle", "time": 15582.389, "timestamp": "04:19:42", "text": "知っている。」そして、オープンな人もいる。"}, {"type": "subtitle", "time": 15586.229, "timestamp": "04:19:46", "text": "試してみて、どうなるか見てみよう"}, {"type": "subtitle", "time": 15588.79, "timestamp": "04:19:48", "text": "すべて。そして、それを見る人もいます"}, {"type": "subtitle", "time": 15591.269, "timestamp": "04:19:51", "text": "取引的なコラボレーションとして、または"}, {"type": "subtitle", "time": 15593.269, "timestamp": "04:19:53", "text": "何か"}, {"type": "subtitle", "time": 15596.309, "timestamp": "04:19:56", "text": "タイプ。そして、本当にたくさんのことがあるんです。それ"}, {"type": "subtitle", "time": 15598.55, "timestamp": "04:19:58", "text": "は"}]
[{"type": "subtitle", "time": 12960.55, "timestamp": "03:36:00", "text": "タイトルバーに表示されている現在のバージョン"}, {"type": "subtitle", "time": 12962.309, "timestamp": "03:36:02", "text": "トップ？"}, {"type": "subtitle", "time": 12969.11, "timestamp": "03:36:09", "text": "ああ、わかりました。私は自分が何に取り組んでいるのか忘れてしまった"}, {"type": "subtitle", "time": 12971.03, "timestamp": "03:36:11", "text": "ベータ版なので、"}, {"type": "subtitle", "time": 12975.269, "timestamp": "03:36:15", "text": "最新の情報です。それは、"}, {"type": "subtitle", "time": 12978.389, "timestamp": "03:36:18", "text": "同じ。私は推測する"}, {"type": "subtitle", "time": 12980.71, "timestamp": "03:36:20", "text": "おそらく、03。ああ、そうだ。あなたは"}, {"type": "subtitle", "time": 12983.91, "timestamp": "03:36:23", "text": "最新版。では、なぜ？はい、それは"}, {"type": "subtitle", "time": 12985.51, "timestamp": "03:36:25", "text": "奇妙な。"}, {"type": "subtitle", "time": 12988.63, "timestamp": "03:36:28", "text": "ああ、突然Discordがここに現れた。"}, {"type": "subtitle", "time": 12990.63, "timestamp": "03:36:30", "text": "一体どういうことだ？"}, {"type": "subtitle", "time": 12997.67, "timestamp": "03:36:37", "text": "ああ、神様。えっと、チャットはいい感じ"}, {"type": "subtitle", "time": 13001.19, "timestamp": "03:36:41", "text": "えーと、人々。うん、性別はそのままにしておこう"}, {"type": "subtitle", "time": 13004.15, "timestamp": "03:36:44", "text": "中性。えっと、聞こえるかどうか教えてください"}, {"type": "subtitle", "time": 13007.349, "timestamp": "03:36:47", "text": "私の友人はここにいます。こんにちは。こんにちは"}, {"type": "subtitle", "time": 13011.429, "timestamp": "03:36:51", "text": "Script Sonsのメンバー全員。チャット、いいよ"}, {"type": "subtitle", "time": 13018.15, "timestamp": "03:36:58", "text": "こんにちは。"}]
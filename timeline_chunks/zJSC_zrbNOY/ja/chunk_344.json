[{"type": "subtitle", "time": 20641.11, "timestamp": "05:44:01", "text": "十分な数字があれば、"}, {"type": "subtitle", "time": 20643.43, "timestamp": "05:44:03", "text": "人々が企業に見るもの"}, {"type": "subtitle", "time": 20646.31, "timestamp": "05:44:06", "text": "数字とかそういうもの全部。だから私は"}, {"type": "subtitle", "time": 20648.948, "timestamp": "05:44:08", "text": "うん、でも良いところがたくさんある"}, {"type": "subtitle", "time": 20651.43, "timestamp": "05:44:11", "text": "良いことも悪いことも。だから私はこう思った"}, {"type": "subtitle", "time": 20653.91, "timestamp": "05:44:13", "text": "うまくいくかもしれないと思ったら、"}, {"type": "subtitle", "time": 20656.31, "timestamp": "05:44:16", "text": "申し訳なさそうに「ごめんなさい、できません」"}, {"type": "subtitle", "time": 20659.67, "timestamp": "05:44:19", "text": "私は銀行に行って、人々と"}, {"type": "subtitle", "time": 20661.67, "timestamp": "05:44:21", "text": "私は「よし、共有しよう」と思った"}, {"type": "subtitle", "time": 20665.35, "timestamp": "05:44:25", "text": "音声通話で、まるで私の声が聞こえるかのようです"}, {"type": "subtitle", "time": 20667.83, "timestamp": "05:44:27", "text": "とその他諸々、そして他のマネージャーが"}, {"type": "subtitle", "time": 20670.15, "timestamp": "05:44:30", "text": "彼らはスポーツマンのようなことを言っていた"}, {"type": "subtitle", "time": 20673.27, "timestamp": "05:44:33", "text": "うん、それは詐欺だよ。やらないで、やらないで。"}, {"type": "subtitle", "time": 20676.47, "timestamp": "05:44:36", "text": "私も謝らなきゃいけないのに、"}, {"type": "subtitle", "time": 20678.788, "timestamp": "05:44:38", "text": "こういうことは起こりうるということを知っておいてください。"}, {"type": "subtitle", "time": 20681.51, "timestamp": "05:44:41", "text": "「聞いたことはあるけど、何？」って感じでした。のように"}, {"type": "subtitle", "time": 20683.83, "timestamp": "05:44:43", "text": "実際に体験してみると、私はこう思う。"}, {"type": "subtitle", "time": 20687.75, "timestamp": "05:44:47", "text": "おお。そして私はそれを父に話しました。何てことだ。"}, {"type": "subtitle", "time": 20691.19, "timestamp": "05:44:51", "text": "彼は怒っているようで、同時に喜んでいるようだった。"}, {"type": "subtitle", "time": 20696.31, "timestamp": "05:44:56", "text": "私はそれに賛同しなかった。うん。何てことだ。私"}, {"type": "subtitle", "time": 20698.788, "timestamp": "05:44:58", "text": "「うわあ、"}]
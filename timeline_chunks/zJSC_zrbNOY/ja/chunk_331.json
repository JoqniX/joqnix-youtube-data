[{"type": "subtitle", "time": 19862.39, "timestamp": "05:31:02", "text": "変だからフランスの広告は「なぜ"}, {"type": "subtitle", "time": 19864.47, "timestamp": "05:31:04", "text": "フランス語の広告を見せてくれたら、"}, {"type": "subtitle", "time": 19867.59, "timestamp": "05:31:07", "text": "スペイン語の広告が表示される期間"}, {"type": "subtitle", "time": 19869.51, "timestamp": "05:31:09", "text": "何てことだ"}, {"type": "subtitle", "time": 19872.708, "timestamp": "05:31:12", "text": "スペイン語の広告がたくさん届いていた"}, {"type": "subtitle", "time": 19875.35, "timestamp": "05:31:15", "text": "何度も何度も、ある時点で私は"}, {"type": "subtitle", "time": 19877.03, "timestamp": "05:31:17", "text": "実際に、私は学ぶべきかもしれないと考えました"}, {"type": "subtitle", "time": 19884.39, "timestamp": "05:31:24", "text": "何てことだ、"}, {"type": "subtitle", "time": 19887.67, "timestamp": "05:31:27", "text": "それらは未来的なもののように見える。おお"}, {"type": "subtitle", "time": 19889.51, "timestamp": "05:31:29", "text": "うん、"}, {"type": "subtitle", "time": 19892.23, "timestamp": "05:31:32", "text": "だって、たくさんの問題がわかったから"}, {"type": "subtitle", "time": 19896.47, "timestamp": "05:31:36", "text": "今すぐ。私は「ああ神様」って感じだった"}, {"type": "subtitle", "time": 19900.628, "timestamp": "05:31:40", "text": "だからPayPalやStripeはもう終わり"}, {"type": "subtitle", "time": 19902.708, "timestamp": "05:31:42", "text": "何もかもが機能していない。たくさん試しました"}, {"type": "subtitle", "time": 19906.15, "timestamp": "05:31:46", "text": "他のプラットフォームでは動作しなかった"}, {"type": "subtitle", "time": 19907.83, "timestamp": "05:31:47", "text": "国際的な人々にとって彼らは"}, {"type": "subtitle", "time": 19910.15, "timestamp": "05:31:50", "text": "PayPal を使用しました。私たちはまさにそのように働いていました。"}, {"type": "subtitle", "time": 19913.59, "timestamp": "05:31:53", "text": "インド人は痛みを感じたので、最終的に私は"}, {"type": "subtitle", "time": 19916.788, "timestamp": "05:31:56", "text": "YouTube を推進するなどの手段に訴える"}, {"type": "subtitle", "time": 19919.51, "timestamp": "05:31:59", "text": "パートナーは少なくとも寄付することができる"}]
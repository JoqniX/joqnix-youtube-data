[{"type": "subtitle", "time": 3013.91, "timestamp": "00:50:13", "text": "コラボ企画をこんな風に見てみると"}, {"type": "subtitle", "time": 3022.069, "timestamp": "00:50:22", "text": "右？"}, {"type": "subtitle", "time": 3024.15, "timestamp": "00:50:24", "text": "時々、自分がやったんじゃないかと思うことがある"}, {"type": "subtitle", "time": 3027.109, "timestamp": "00:50:27", "text": "間違っている。もしかしたら、私は言うべきではなかったのかもしれない。"}, {"type": "subtitle", "time": 3029.109, "timestamp": "00:50:29", "text": "真実、"}, {"type": "subtitle", "time": 3031.91, "timestamp": "00:50:31", "text": "右？私に起こったことは、"}, {"type": "subtitle", "time": 3039.349, "timestamp": "00:50:39", "text": "入学が延期され、"}, {"type": "subtitle", "time": 3049.91, "timestamp": "00:50:49", "text": "だって、えっと、私が言ったからだけど、"}, {"type": "subtitle", "time": 3053.349, "timestamp": "00:50:53", "text": "多くの人が予定を変更した"}, {"type": "subtitle", "time": 3056.25, "timestamp": "00:50:56", "text": "どこにもない"}, {"type": "subtitle", "time": 3057.67, "timestamp": "00:50:57", "text": "[音楽]"}]
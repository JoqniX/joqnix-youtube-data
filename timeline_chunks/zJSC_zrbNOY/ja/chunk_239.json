[{"type": "subtitle", "time": 14345.83, "timestamp": "03:59:05", "text": "私は通常すべてを自動化するので"}, {"type": "subtitle", "time": 14349.11, "timestamp": "03:59:09", "text": "心配する必要はありません。私を評価してください、"}, {"type": "subtitle", "time": 14351.429, "timestamp": "03:59:11", "text": "数秒後に自動的に叫びます"}, {"type": "subtitle", "time": 14354.229, "timestamp": "03:59:14", "text": "秒。私はおそらくそうすべきです"}, {"type": "subtitle", "time": 14359.349, "timestamp": "03:59:19", "text": "だって、すごく忙しいんだもん。いいえ、あなたは"}, {"type": "subtitle", "time": 14361.59, "timestamp": "03:59:21", "text": "パニック状態。ああ、これをやるのが忘れてた。おお"}, {"type": "subtitle", "time": 14363.67, "timestamp": "03:59:23", "text": "いいえ、これです、あれです。"}, {"type": "subtitle", "time": 14365.189, "timestamp": "03:59:25", "text": "知っている。そして、通常はこうなります"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "知り合いが私を襲撃するとき"}, {"type": "subtitle", "time": 14369.75, "timestamp": "03:59:29", "text": "また、私はただ見ているだけでとても興奮します"}, {"type": "subtitle", "time": 14373.349, "timestamp": "03:59:33", "text": "彼ら。まるで、私が忘れていたように"}, {"type": "subtitle", "time": 14375.75, "timestamp": "03:59:35", "text": "つまり、大声で叫んでそうするってことだよ。わかった。ルナ"}, {"type": "subtitle", "time": 14381.429, "timestamp": "03:59:41", "text": "友人に火を揚げるように頼んでいる。"}, {"type": "subtitle", "time": 14384.389, "timestamp": "03:59:44", "text": "あなたの名前は何て言いますか？ああ、できるよ"}, {"type": "subtitle", "time": 14387.99, "timestamp": "03:59:47", "text": "私の名前はジョックと発音できます"}, {"type": "subtitle", "time": 14391.91, "timestamp": "03:59:51", "text": "次。だから、僕のことをスポーツマンと呼んでくれて構わないよ。ああ、スポーツマン"}, {"type": "subtitle", "time": 14393.429, "timestamp": "03:59:53", "text": "次。"}, {"type": "subtitle", "time": 14397.03, "timestamp": "03:59:57", "text": "つまり、2つのこと、2つの言葉ですね。ああ、それから"}]
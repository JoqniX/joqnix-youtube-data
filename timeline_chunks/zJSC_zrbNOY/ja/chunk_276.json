[{"type": "subtitle", "time": 16561.109, "timestamp": "04:36:01", "text": "時間が経つにつれてシールドが効き、何をすべきか分かる"}, {"type": "subtitle", "time": 16565.429, "timestamp": "04:36:05", "text": "やるべきこと、やってはいけないことなど。いいえ。ええ。"}, {"type": "subtitle", "time": 16568.47, "timestamp": "04:36:08", "text": "ルースは、私が"}, {"type": "subtitle", "time": 16571.029, "timestamp": "04:36:11", "text": "セラピスト？"}, {"type": "subtitle", "time": 16573.75, "timestamp": "04:36:13", "text": "R. とさえ言えません。私は"}, {"type": "subtitle", "time": 16575.51, "timestamp": "04:36:15", "text": "セラピスト。"}, {"type": "subtitle", "time": 16577.029, "timestamp": "04:36:17", "text": "あなたは"}, {"type": "subtitle", "time": 16580.15, "timestamp": "04:36:20", "text": "うん。何てことだ。"}, {"type": "subtitle", "time": 16584.31, "timestamp": "04:36:24", "text": "何てことだ。おお。くそ。"}, {"type": "subtitle", "time": 16586.31, "timestamp": "04:36:26", "text": "でも、そう、私も"}, {"type": "subtitle", "time": 16589.269, "timestamp": "04:36:29", "text": "私は関与しない方針です"}, {"type": "subtitle", "time": 16592.709, "timestamp": "04:36:32", "text": "そういうセッションやトークでは"}, {"type": "subtitle", "time": 16596.949, "timestamp": "04:36:36", "text": "ストリーミング配信は、私にとってセラピーみたいなものなんです"}, {"type": "subtitle", "time": 16599.99, "timestamp": "04:36:39", "text": "それは、ある種の"}, {"type": "subtitle", "time": 16602.789, "timestamp": "04:36:42", "text": "きちんと整備するためのスペースが必要です。私はできません"}, {"type": "subtitle", "time": 16605.269, "timestamp": "04:36:45", "text": "ライブ配信で配信されるもの。"}, {"type": "subtitle", "time": 16607.349, "timestamp": "04:36:47", "text": "それは安全な場所ではないだろう"}, {"type": "subtitle", "time": 16610.23, "timestamp": "04:36:50", "text": "それは私にとってだけでなく、その人にとっても。うん、そうだね"}, {"type": "subtitle", "time": 16614.07, "timestamp": "04:36:54", "text": "これは、そういうことをするクリエイターだったのでしょうか。えっと"}, {"type": "subtitle", "time": 16615.75, "timestamp": "04:36:55", "text": "のように"}, {"type": "subtitle", "time": 16618.47, "timestamp": "04:36:58", "text": "ああ、どうぞ。うん、それはまるで"}]
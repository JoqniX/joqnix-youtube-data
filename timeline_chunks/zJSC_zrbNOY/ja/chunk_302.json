[{"type": "subtitle", "time": 18121.11, "timestamp": "05:02:01", "text": "1ルピー。 100ルピー。米ドルは"}, {"type": "subtitle", "time": 18126.07, "timestamp": "05:02:06", "text": "1つ。何てことだ。例えば、それが"}, {"type": "subtitle", "time": 18128.07, "timestamp": "05:02:08", "text": "委員会の番は私です"}, {"type": "subtitle", "time": 18130.47, "timestamp": "05:02:10", "text": "脚本を書くよう依頼されたり、"}, {"type": "subtitle", "time": 18134.39, "timestamp": "05:02:14", "text": "誰かのためのライティング作業"}, {"type": "subtitle", "time": 18137.67, "timestamp": "05:02:17", "text": "伝承とかそういう類のこと。それは"}, {"type": "subtitle", "time": 18139.51, "timestamp": "05:02:19", "text": "それは気持ちいい、なぜなら私が"}, {"type": "subtitle", "time": 18143.03, "timestamp": "05:02:23", "text": "米ドルで支払われる。"}, {"type": "subtitle", "time": 18145.59, "timestamp": "05:02:25", "text": "正直に言うと、私は少し失うことがあります"}, {"type": "subtitle", "time": 18149.19, "timestamp": "05:02:29", "text": "通貨交換の金額、なぜなら"}, {"type": "subtitle", "time": 18151.91, "timestamp": "05:02:31", "text": "PayPalも時々ひどい。"}, {"type": "subtitle", "time": 18160.31, "timestamp": "05:02:40", "text": "私のために。いや、私は「ああ、私は"}, {"type": "subtitle", "time": 18162.31, "timestamp": "05:02:42", "text": "きれいだし、私も"}, {"type": "subtitle", "time": 18165.83, "timestamp": "05:02:45", "text": "安いリギング業者ではダメだ。"}, {"type": "subtitle", "time": 18168.15, "timestamp": "05:02:48", "text": "そして私は「よし、"}, {"type": "subtitle", "time": 18170.948, "timestamp": "05:02:50", "text": "アーティストが"}, {"type": "subtitle", "time": 18173.19, "timestamp": "05:02:53", "text": "アーティストも提案されているので"}, {"type": "subtitle", "time": 18175.51, "timestamp": "05:02:55", "text": "韓国。 「韓国語だよ。」それで私はこう思った"}, {"type": "subtitle", "time": 18178.55, "timestamp": "05:02:58", "text": "わかった、韓国人のリガーを雇って"}]
[{"type": "subtitle", "time": 17049.51, "timestamp": "04:44:09", "text": "うん。マイク関連のこと。そうそう。あなたは"}, {"type": "subtitle", "time": 17052.39, "timestamp": "04:44:12", "text": "インイヤーヘッドホンを着けるか、"}, {"type": "subtitle", "time": 17055.83, "timestamp": "04:44:15", "text": "オーバーヘッド？オーバーヘッド。彼らはあなたに"}, {"type": "subtitle", "time": 17058.708, "timestamp": "04:44:18", "text": "頭痛とか？"}, {"type": "subtitle", "time": 17062.948, "timestamp": "04:44:22", "text": "ええと、通常は違います。しかし、"}, {"type": "subtitle", "time": 17064.708, "timestamp": "04:44:24", "text": "こんな日にはもう"}, {"type": "subtitle", "time": 17069.75, "timestamp": "04:44:29", "text": "疲れていて、あまり調子が良くないです。"}, {"type": "subtitle", "time": 17072.628, "timestamp": "04:44:32", "text": "えーと形。それから、いくつか"}, {"type": "subtitle", "time": 17081.91, "timestamp": "04:44:41", "text": "だって、たとえそうであっても、それはある意味"}, {"type": "subtitle", "time": 17083.91, "timestamp": "04:44:43", "text": "少し重く感じるのは、"}, {"type": "subtitle", "time": 17087.03, "timestamp": "04:44:47", "text": "時々、自分の頭よりも大きく見えることがある。 M 私は持っていた"}, {"type": "subtitle", "time": 17089.67, "timestamp": "04:44:49", "text": "ライターみたいなやつ、Bluetoothのやつ"}, {"type": "subtitle", "time": 17094.708, "timestamp": "04:44:54", "text": "オーバーヘッドですが、母はかつて"}, {"type": "subtitle", "time": 17097.19, "timestamp": "04:44:57", "text": "私が留守中に部屋を掃除してください"}]
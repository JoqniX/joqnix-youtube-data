[{"type": "subtitle", "time": 19560.15, "timestamp": "05:26:00", "text": "しかし、彼らがそうすると、私は彼らを見ることができる"}, {"type": "subtitle", "time": 19566.39, "timestamp": "05:26:06", "text": "うん。 VTuberコミュニティだけでなく、"}, {"type": "subtitle", "time": 19568.708, "timestamp": "05:26:08", "text": "えーと、人々が、ほら、"}, {"type": "subtitle", "time": 19570.628, "timestamp": "05:26:10", "text": "こういうものが存在するという認識"}, {"type": "subtitle", "time": 19574.948, "timestamp": "05:26:14", "text": "彼らはここで素晴らしい活躍をするだろう。うん。"}, {"type": "subtitle", "time": 19578.07, "timestamp": "05:26:18", "text": "でも、もしあなたがストリーマーで、"}, {"type": "subtitle", "time": 19580.47, "timestamp": "05:26:20", "text": "UPI を使うと、VTER とは違って、私は UPI を使います"}, {"type": "subtitle", "time": 19584.47, "timestamp": "05:26:24", "text": "あなたの荷物はすぐに届きますが、"}, {"type": "subtitle", "time": 19587.43, "timestamp": "05:26:27", "text": "同時に、私たちはただ"}, {"type": "subtitle", "time": 19590.948, "timestamp": "05:26:30", "text": "我々から王位への支払いなので、"}, {"type": "subtitle", "time": 19593.27, "timestamp": "05:26:33", "text": "私たちも期待しているように"}, {"type": "subtitle", "time": 19595.67, "timestamp": "05:26:35", "text": "彼らは私たちと同じように両陣営の安全を守るだろう"}, {"type": "subtitle", "time": 19599.99, "timestamp": "05:26:39", "text": "ストリーマーとして、しかし視聴者として、あるいは"}, {"type": "subtitle", "time": 19604.39, "timestamp": "05:26:44", "text": "贈り主。うん。だって、今でも"}, {"type": "subtitle", "time": 19607.03, "timestamp": "05:26:47", "text": "贈り物を受け取ったときは、"}, {"type": "subtitle", "time": 19609.51, "timestamp": "05:26:49", "text": "見つけました、ギフトを受け取りました"}, {"type": "subtitle", "time": 19611.91, "timestamp": "05:26:51", "text": "これらの多くの日が現れ、"}, {"type": "subtitle", "time": 19614.31, "timestamp": "05:26:54", "text": "それだけで、他の詳細は何も見えません"}, {"type": "subtitle", "time": 19618.07, "timestamp": "05:26:58", "text": "彼らの側から。うん。うん。私はそれが好きです"}]
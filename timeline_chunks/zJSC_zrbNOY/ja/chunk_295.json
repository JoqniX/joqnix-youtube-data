[{"type": "subtitle", "time": 17703.19, "timestamp": "04:55:03", "text": "患者患者この芸術作品は"}, {"type": "subtitle", "time": 17706.948, "timestamp": "04:55:06", "text": "昨年8月の私の誕生日に完成しました"}, {"type": "subtitle", "time": 17709.75, "timestamp": "04:55:09", "text": "12日、えっと、8月11日が私の誕生日です。それで"}, {"type": "subtitle", "time": 17712.948, "timestamp": "04:55:12", "text": "誕生日が終わった後、私はこれを受け取った。そして私は"}, {"type": "subtitle", "time": 17716.39, "timestamp": "04:55:16", "text": "最高だからすごく嬉しい"}, {"type": "subtitle", "time": 17719.83, "timestamp": "04:55:19", "text": "今すぐ手に入れられる誕生日プレゼント。まるで私が"}, {"type": "subtitle", "time": 17722.868, "timestamp": "04:55:22", "text": "できる限り取り入れようと努力しました"}, {"type": "subtitle", "time": 17726.628, "timestamp": "04:55:26", "text": "Joex の初期設計と、"}, {"type": "subtitle", "time": 17728.788, "timestamp": "04:55:28", "text": "より独創的で、"}, {"type": "subtitle", "time": 17732.868, "timestamp": "04:55:32", "text": "フィットフィット、だって私の声で何人かの人が"}, {"type": "subtitle", "time": 17735.51, "timestamp": "04:55:35", "text": "性別のせいで混乱する"}, {"type": "subtitle", "time": 17738.07, "timestamp": "04:55:38", "text": "そして全て、私は「うん、私は"}, {"type": "subtitle", "time": 17740.55, "timestamp": "04:55:40", "text": "あなたをさらに混乱させるでしょう"}, {"type": "subtitle", "time": 17744.708, "timestamp": "04:55:44", "text": "モデルの外見がさらに混乱を招く可能性がある。"}, {"type": "subtitle", "time": 17748.07, "timestamp": "04:55:48", "text": "完璧。そのエネルギーが大好きです。"}, {"type": "subtitle", "time": 17750.788, "timestamp": "04:55:50", "text": "うん。だから、ジョークは"}, {"type": "subtitle", "time": 17754.23, "timestamp": "04:55:54", "text": "星座。それで、噂みたいなもの"}, {"type": "subtitle", "time": 17757.75, "timestamp": "04:55:57", "text": "テンペストはアニメのスライムアニメです。だから"}]
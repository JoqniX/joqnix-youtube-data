[{"type": "subtitle", "time": 12482.95, "timestamp": "03:28:02", "text": "私の、えーと、コンテンツ面での仕事。私"}, {"type": "subtitle", "time": 12486.07, "timestamp": "03:28:06", "text": "絵を描くよりも文章を書くことが多い。アートとは"}, {"type": "subtitle", "time": 12488.95, "timestamp": "03:28:08", "text": "えっと、何か私が"}, {"type": "subtitle", "time": 12491.83, "timestamp": "03:28:11", "text": "まだ作業中ですが、できると感じています"}, {"type": "subtitle", "time": 12500.469, "timestamp": "03:28:20", "text": "待って、本を書くように書いて、"}, {"type": "subtitle", "time": 12503.91, "timestamp": "03:28:23", "text": "漫画、脚本。"}, {"type": "subtitle", "time": 12509.11, "timestamp": "03:28:29", "text": "私が書く脚本は、えっと、あの"}, {"type": "subtitle", "time": 12517.83, "timestamp": "03:28:37", "text": "それは興味深いですね。何てことだ、"}, {"type": "subtitle", "time": 12521.19, "timestamp": "03:28:41", "text": "私はASMOスクリプトを書いていて、"}, {"type": "subtitle", "time": 12524.87, "timestamp": "03:28:44", "text": "摩擦とその他多くのもの"}, {"type": "subtitle", "time": 12528.63, "timestamp": "03:28:48", "text": "良い。でも、ええ、しばらくは、つまり"}, {"type": "subtitle", "time": 12531.429, "timestamp": "03:28:51", "text": "ここ数年はより重点的に"}, {"type": "subtitle", "time": 12538.15, "timestamp": "03:28:58", "text": "聞いても差し支えなければ。どうですか"}]
[{"type": "subtitle", "time": 16261.51, "timestamp": "04:31:01", "text": "YouTuberがコミュニティを獲得したとき"}, {"type": "subtitle", "time": 16264.87, "timestamp": "04:31:04", "text": "サーバーはすべて移動し、"}, {"type": "subtitle", "time": 16267.269, "timestamp": "04:31:07", "text": "私はVCによく参加していました。だからそこに"}, {"type": "subtitle", "time": 16270.95, "timestamp": "04:31:10", "text": "ランダムな新しい人たちが"}, {"type": "subtitle", "time": 16274.229, "timestamp": "04:31:14", "text": "YouTube または Twitch から Discord へ"}, {"type": "subtitle", "time": 16276.389, "timestamp": "04:31:16", "text": "そして私は彼らが"}, {"type": "subtitle", "time": 16280.149, "timestamp": "04:31:20", "text": "たぶん新しく入ってきたものだと思う"}, {"type": "subtitle", "time": 16283.59, "timestamp": "04:31:23", "text": "トラウマを吐き出し始めたんだけど、"}, {"type": "subtitle", "time": 16286.149, "timestamp": "04:31:26", "text": "これがトラウマの吐露なのか分からなかった"}, {"type": "subtitle", "time": 16290.55, "timestamp": "04:31:30", "text": "それで私は気分が悪くなって、それから"}, {"type": "subtitle", "time": 16293.91, "timestamp": "04:31:33", "text": "DMで彼らと話したら、彼らは"}, {"type": "subtitle", "time": 16295.429, "timestamp": "04:31:35", "text": "に"}, {"type": "subtitle", "time": 16298.389, "timestamp": "04:31:38", "text": "えっと、どう言いますか、彼らは始めた"}, {"type": "subtitle", "time": 16300.55, "timestamp": "04:31:40", "text": "私は聞いているような感じだった。私は決して人を裁かなかった"}, {"type": "subtitle", "time": 16302.229, "timestamp": "04:31:42", "text": "何でも。私は聞いていた。彼らはいた"}, {"type": "subtitle", "time": 16304.149, "timestamp": "04:31:44", "text": "曲げ。私は「うん、"}, {"type": "subtitle", "time": 16307.67, "timestamp": "04:31:47", "text": "うん、君ならできるよ。もしかしたら、"}, {"type": "subtitle", "time": 16310.95, "timestamp": "04:31:50", "text": "「自分のことをもっと大切にしなさい。」彼らは"}, {"type": "subtitle", "time": 16313.03, "timestamp": "04:31:53", "text": "ドラマとか他の何か"}, {"type": "subtitle", "time": 16316.389, "timestamp": "04:31:56", "text": "クリエイターたちは皆この男について語った"}, {"type": "subtitle", "time": 16318.55, "timestamp": "04:31:58", "text": "彼らは皆、この人物は"}]
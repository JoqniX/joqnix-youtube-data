[{"type": "subtitle", "time": 13140.07, "timestamp": "03:39:00", "text": "えっと、Twitchに戻って、私はこう言った"}, {"type": "subtitle", "time": 13142.87, "timestamp": "03:39:02", "text": "えっと、私が考えていたとき"}, {"type": "subtitle", "time": 13145.269, "timestamp": "03:39:05", "text": "マルチリーミングと、私が昔"}, {"type": "subtitle", "time": 13147.91, "timestamp": "03:39:07", "text": "Twitchの配信などのコンテンツを分離する"}, {"type": "subtitle", "time": 13149.99, "timestamp": "03:39:09", "text": "このようなコンテンツと"}, {"type": "subtitle", "time": 13152.15, "timestamp": "03:39:12", "text": "その時はYouTubeは通常通り動作するでしょう。だった"}, {"type": "subtitle", "time": 13154.469, "timestamp": "03:39:14", "text": "集中しているように"}, {"type": "subtitle", "time": 13157.19, "timestamp": "03:39:17", "text": "えっと、YouTubeパートナーの資格を取得する"}, {"type": "subtitle", "time": 13159.269, "timestamp": "03:39:19", "text": "そうすれば、私は以下の機能を取得できます。"}, {"type": "subtitle", "time": 13162.469, "timestamp": "03:39:22", "text": "YouTubeパートナーの背後にロックされています"}, {"type": "subtitle", "time": 13164.79, "timestamp": "03:39:24", "text": "チャットルールとかそういうのがまさにそれだ"}, {"type": "subtitle", "time": 13167.429, "timestamp": "03:39:27", "text": "Twitchでチャットに入力すると、"}, {"type": "subtitle", "time": 13170.71, "timestamp": "03:39:30", "text": "ルールは自動的にポップアップします"}, {"type": "subtitle", "time": 13174.309, "timestamp": "03:39:34", "text": "YouTubeのメンバーシップでロックされています"}, {"type": "subtitle", "time": 13177.19, "timestamp": "03:39:37", "text": "あれを見て、すごいと思ったけど、できない"}, {"type": "subtitle", "time": 13180.229, "timestamp": "03:39:40", "text": "レイドでさえ、"}, {"type": "subtitle", "time": 13182.55, "timestamp": "03:39:42", "text": "会員制とか、千個くらい"}, {"type": "subtitle", "time": 13186.07, "timestamp": "03:39:46", "text": "フォロワー、購読者、たくさん"}, {"type": "subtitle", "time": 13188.15, "timestamp": "03:39:48", "text": "良い機能はそこにロックされているようなので"}, {"type": "subtitle", "time": 13191.11, "timestamp": "03:39:51", "text": "わあ、それを目指していたんだ"}, {"type": "subtitle", "time": 13195.19, "timestamp": "03:39:55", "text": "ある意味、えっと、私は、"}, {"type": "subtitle", "time": 13197.99, "timestamp": "03:39:57", "text": "YouTube が成長していくにつれて、とても悲しくなりました"}]
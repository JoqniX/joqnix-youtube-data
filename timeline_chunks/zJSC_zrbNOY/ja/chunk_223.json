[{"type": "subtitle", "time": 13383.83, "timestamp": "03:43:03", "text": "私たちはそれをやっていないことに気づいた。わかった。"}, {"type": "subtitle", "time": 13385.51, "timestamp": "03:43:05", "text": "ヘイラ、"}, {"type": "subtitle", "time": 13395.269, "timestamp": "03:43:15", "text": "順調です。"}, {"type": "subtitle", "time": 13408.87, "timestamp": "03:43:28", "text": "うん、"}, {"type": "subtitle", "time": 13412.229, "timestamp": "03:43:32", "text": "Twitchでの配信は今では良いですね。ああ、そうだった"}, {"type": "subtitle", "time": 13415.83, "timestamp": "03:43:35", "text": "新しいTwitchについて聞きましたか？"}, {"type": "subtitle", "time": 13417.67, "timestamp": "03:43:37", "text": "人々を追い詰めるような"}, {"type": "subtitle", "time": 13420.55, "timestamp": "03:43:40", "text": "マルチストリーミングで、えっと、彼らは"}, {"type": "subtitle", "time": 13424.389, "timestamp": "03:43:44", "text": "新しいルールを制定したり施行したりする"}, {"type": "subtitle", "time": 13428.71, "timestamp": "03:43:48", "text": "マルチリーミングが許可された後、"}, {"type": "subtitle", "time": 13431.91, "timestamp": "03:43:51", "text": "うん。うん。それで、クリエイターの一人が"}, {"type": "subtitle", "time": 13436.469, "timestamp": "03:43:56", "text": "ナッティと呼ばれていた彼は、"}]
[{"type": "subtitle", "time": 15000.309, "timestamp": "04:10:00", "text": "だから私は"}, {"type": "subtitle", "time": 15003.429, "timestamp": "04:10:03", "text": "おそらく楽しみにしているでしょう"}, {"type": "subtitle", "time": 15005.59, "timestamp": "04:10:05", "text": "もし他の人と会う機会があれば、"}, {"type": "subtitle", "time": 15008.79, "timestamp": "04:10:08", "text": "意思。うん。"}, {"type": "subtitle", "time": 15012.95, "timestamp": "04:10:12", "text": "非常に素晴らしい。うん。つまり、もし"}, {"type": "subtitle", "time": 15017.03, "timestamp": "04:10:17", "text": "コミコンみたいなイベントがここかその近辺で開催されているか"}, {"type": "subtitle", "time": 15020.229, "timestamp": "04:10:20", "text": "私は確信が持てないと思う。なぜなら私は知っているから"}, {"type": "subtitle", "time": 15022.469, "timestamp": "04:10:22", "text": "それは通常ムンバイのような場所で起こります。"}, {"type": "subtitle", "time": 15026.229, "timestamp": "04:10:26", "text": "デリー。うん。大都市。仰るとおり"}, {"type": "subtitle", "time": 15028.55, "timestamp": "04:10:28", "text": "真実。"}, {"type": "subtitle", "time": 15030.71, "timestamp": "04:10:30", "text": "Fire Twinが配信を始めたのは嬉しいです。"}, {"type": "subtitle", "time": 15033.67, "timestamp": "04:10:33", "text": "お礼を言って嬉しいです。たくさんの人に会った"}, {"type": "subtitle", "time": 15040.71, "timestamp": "04:10:40", "text": "ええ、3月に私が"}, {"type": "subtitle", "time": 15044.15, "timestamp": "04:10:44", "text": "プネー・コミコンに史上初参加。"}, {"type": "subtitle", "time": 15046.55, "timestamp": "04:10:46", "text": "生まれて初めて外に出たのは"}, {"type": "subtitle", "time": 15048.469, "timestamp": "04:10:48", "text": "私の州。"}, {"type": "subtitle", "time": 15051.59, "timestamp": "04:10:51", "text": "楽しかったですか？うん。"}, {"type": "subtitle", "time": 15054.389, "timestamp": "04:10:54", "text": "うん。うん。私は他の人と会うことができました"}, {"type": "subtitle", "time": 15057.189, "timestamp": "04:10:57", "text": "そこに来たインド人ユーチューバーたち。"}]
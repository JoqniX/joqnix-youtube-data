[{"type": "subtitle", "time": 1440.39, "timestamp": "00:24:00", "text": "必要であれば、引き続きアクセスできます。"}, {"type": "subtitle", "time": 1443.75, "timestamp": "00:24:03", "text": "おお。なるほど、興味深い。"}, {"type": "subtitle", "time": 1449.029, "timestamp": "00:24:09", "text": "Twitterのアカウントを変更しようと思っていたのですが"}, {"type": "subtitle", "time": 1451.669, "timestamp": "00:24:11", "text": "アカウントum"}, {"type": "subtitle", "time": 1454.07, "timestamp": "00:24:14", "text": "確認のためのメッセージリクエスト"}, {"type": "subtitle", "time": 1456.789, "timestamp": "00:24:16", "text": "ユーザー名。"}, {"type": "subtitle", "time": 1458.789, "timestamp": "00:24:18", "text": "えっと"}, {"type": "subtitle", "time": 1461.43, "timestamp": "00:24:21", "text": "人々がそれを望むなら、彼らは"}, {"type": "subtitle", "time": 1467.51, "timestamp": "00:24:27", "text": "まだ能力がある"}, {"type": "subtitle", "time": 1473.11, "timestamp": "00:24:33", "text": "以前のアカウントから私にダイレクトメッセージを送る機能。"}, {"type": "subtitle", "time": 1475.11, "timestamp": "00:24:35", "text": "もし彼らが本当に私と連絡を取る必要があるなら"}, {"type": "subtitle", "time": 1478.07, "timestamp": "00:24:38", "text": "そして彼らはすべてのアカウントを探す場所を知っている"}]
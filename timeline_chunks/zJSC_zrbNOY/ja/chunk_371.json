[{"type": "subtitle", "time": 22260.15, "timestamp": "06:11:00", "text": "例えば、辛いのが好みなら"}, {"type": "subtitle", "time": 22263.27, "timestamp": "06:11:03", "text": "青唐辛子も一緒に食べてください。"}, {"type": "subtitle", "time": 22268.548, "timestamp": "06:11:08", "text": "それは楽しいですね。"}, {"type": "subtitle", "time": 22271.19, "timestamp": "06:11:11", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 22275.59, "timestamp": "06:11:15", "text": "今、私は11歳です。ええ、そうですね。"}, {"type": "subtitle", "time": 22279.75, "timestamp": "06:11:19", "text": "4月入学。つまり、3月ということだ。うん。"}, {"type": "subtitle", "time": 22282.07, "timestamp": "06:11:22", "text": "3月から3月末頃"}, {"type": "subtitle", "time": 22284.31, "timestamp": "06:11:24", "text": "この時。うん。期間。同じことだ。"}, {"type": "subtitle", "time": 22286.548, "timestamp": "06:11:26", "text": "6月と同じ形式で行っています。"}, {"type": "subtitle", "time": 22289.03, "timestamp": "06:11:29", "text": "右。この頃。だから私は"}, {"type": "subtitle", "time": 22292.07, "timestamp": "06:11:32", "text": "行進。だから私は「ああ、今私は"}, {"type": "subtitle", "time": 22294.948, "timestamp": "06:11:34", "text": "そろそろちゃんと世話をする時間だ"}, {"type": "subtitle", "time": 22298.15, "timestamp": "06:11:38", "text": "健康とその他すべてを学び、"}, {"type": "subtitle", "time": 22299.99, "timestamp": "06:11:39", "text": "料理やその他すべてが宣伝される"}, {"type": "subtitle", "time": 22303.35, "timestamp": "06:11:43", "text": "準備して、報酬として受け取ります。だから私は"}, {"type": "subtitle", "time": 22305.67, "timestamp": "06:11:45", "text": "地元の学校に通った"}, {"type": "subtitle", "time": 22307.99, "timestamp": "06:11:47", "text": "近くに日本人がいないか探した"}, {"type": "subtitle", "time": 22310.47, "timestamp": "06:11:50", "text": "共言語"}]
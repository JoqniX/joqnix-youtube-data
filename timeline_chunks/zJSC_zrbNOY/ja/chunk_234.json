[{"type": "subtitle", "time": 14041.67, "timestamp": "03:54:01", "text": "交流。だから、あなたはただ「うん」って感じ。"}, {"type": "subtitle", "time": 14045.83, "timestamp": "03:54:05", "text": "うん。ここで交流しましょう。私もついていきます。"}, {"type": "subtitle", "time": 14047.91, "timestamp": "03:54:07", "text": "しかし、フォロー・フォー・フォローは実に一般的だった。"}, {"type": "subtitle", "time": 14049.83, "timestamp": "03:54:09", "text": "昔のように。私たちは本当にそう思っていません"}, {"type": "subtitle", "time": 14052.469, "timestamp": "03:54:12", "text": "それを今すぐ正面から見てください。"}, {"type": "subtitle", "time": 14054.469, "timestamp": "03:54:14", "text": "最も怖いのは、"}, {"type": "subtitle", "time": 14058.309, "timestamp": "03:54:18", "text": "デザイナー。今は私にとって、えっと、今は"}, {"type": "subtitle", "time": 14061.269, "timestamp": "03:54:21", "text": "えーっと、その直前に、私たちは"}, {"type": "subtitle", "time": 14064.87, "timestamp": "03:54:24", "text": "配信コラボ。えっと、DMを見たんだけど"}, {"type": "subtitle", "time": 14068.79, "timestamp": "03:54:28", "text": "大手クリエイターから、彼らは"}, {"type": "subtitle", "time": 14070.63, "timestamp": "03:54:30", "text": "Twitchのパートナーみたいな感じ"}, {"type": "subtitle", "time": 14074.07, "timestamp": "03:54:34", "text": "または、好きで、かつ蹴る。私は「えっ？」と思った。"}, {"type": "subtitle", "time": 14076.71, "timestamp": "03:54:36", "text": "なぜ彼らのような大物クリエイターが"}, {"type": "subtitle", "time": 14079.03, "timestamp": "03:54:39", "text": "私に、そして彼らは私のために"}, {"type": "subtitle", "time": 14081.67, "timestamp": "03:54:41", "text": "ツイッター。彼らと話せば話すほど、"}, {"type": "subtitle", "time": 14084.309, "timestamp": "03:54:44", "text": "「ああ、えっと、私はこれを使ってるよ」"}, {"type": "subtitle", "time": 14087.83, "timestamp": "03:54:47", "text": "そして私はある人に会って、彼らは"}, {"type": "subtitle", "time": 14091.03, "timestamp": "03:54:51", "text": "このようなサービスやツールを好む"}, {"type": "subtitle", "time": 14093.83, "timestamp": "03:54:53", "text": "フォロワーを増やす、または自然な方法で"}, {"type": "subtitle", "time": 14097.75, "timestamp": "03:54:57", "text": "「あれだよね？」って感じで、「ねえ、なんで"}, {"type": "subtitle", "time": 14099.99, "timestamp": "03:54:59", "text": "あなたならそうしますか？"}]
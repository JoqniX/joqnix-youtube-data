[{"type": "subtitle", "time": 20043.43, "timestamp": "05:34:03", "text": "うん。何てことだ。チャップは最も"}, {"type": "subtitle", "time": 20045.59, "timestamp": "05:34:05", "text": "チャップはまさに私たちの"}, {"type": "subtitle", "time": 20049.11, "timestamp": "05:34:09", "text": "現時点で懸念事項があります。礼拝堂のように"}, {"type": "subtitle", "time": 20052.948, "timestamp": "05:34:12", "text": "おそらくあなたが期待できる最良の選択肢"}, {"type": "subtitle", "time": 20056.47, "timestamp": "05:34:16", "text": "のために。大丈夫だと期待できます"}, {"type": "subtitle", "time": 20064.31, "timestamp": "05:34:24", "text": "何てことだ。だって、一度覚えてるんだけど、えっと、私の母が"}, {"type": "subtitle", "time": 20068.07, "timestamp": "05:34:28", "text": "風船を投げて麺棒を私のほうに投げた"}, {"type": "subtitle", "time": 20071.27, "timestamp": "05:34:31", "text": "兄弟。彼はそれをかわした。バイエが壊れた。"}, {"type": "subtitle", "time": 20073.43, "timestamp": "05:34:33", "text": "そして問題は、Bは彼のものだったということだ"}, {"type": "subtitle", "time": 20077.43, "timestamp": "05:34:37", "text": "故障の原因となったもの。"}, {"type": "subtitle", "time": 20084.47, "timestamp": "05:34:44", "text": "おお。"}, {"type": "subtitle", "time": 20091.43, "timestamp": "05:34:51", "text": "[音楽]"}, {"type": "subtitle", "time": 20093.35, "timestamp": "05:34:53", "text": "何てことだ。"}, {"type": "subtitle", "time": 20097.99, "timestamp": "05:34:57", "text": "それで、父にそのことを話しました"}]
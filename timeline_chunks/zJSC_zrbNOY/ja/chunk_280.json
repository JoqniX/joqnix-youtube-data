[{"type": "subtitle", "time": 16803.27, "timestamp": "04:40:03", "text": "設定はタスクのようなものだと言える。そうではありません"}, {"type": "subtitle", "time": 16806.55, "timestamp": "04:40:06", "text": "簡単だよ、わかるだろ。境界設定。私"}, {"type": "subtitle", "time": 16808.628, "timestamp": "04:40:08", "text": "ストリーミングを始めたとき、私は好きではありませんでした。"}, {"type": "subtitle", "time": 16811.51, "timestamp": "04:40:11", "text": "そういうことがあって、その時に知ったんだけど"}, {"type": "subtitle", "time": 16814.47, "timestamp": "04:40:14", "text": "オンラインやその他諸々で、他の人たちと同じように"}, {"type": "subtitle", "time": 16817.19, "timestamp": "04:40:17", "text": "世界中の人々と同じように、"}, {"type": "subtitle", "time": 16819.59, "timestamp": "04:40:19", "text": "この境界線は"}, {"type": "subtitle", "time": 16823.03, "timestamp": "04:40:23", "text": "友情は知り合いのようなもの、親密な関係"}, {"type": "subtitle", "time": 16826.948, "timestamp": "04:40:26", "text": "親友のような友達など、そういう感じの友達"}, {"type": "subtitle", "time": 16829.83, "timestamp": "04:40:29", "text": "私にとってそれはまるで"}, {"type": "subtitle", "time": 16832.15, "timestamp": "04:40:32", "text": "友達、友達、君たちは親友みたいだね"}, {"type": "subtitle", "time": 16835.19, "timestamp": "04:40:35", "text": "そして、分離のない物"}, {"type": "subtitle", "time": 16838.23, "timestamp": "04:40:38", "text": "または、別の何かに縛られている"}, {"type": "subtitle", "time": 16840.788, "timestamp": "04:40:40", "text": "それに、すごく変な感じだった"}, {"type": "subtitle", "time": 16843.19, "timestamp": "04:40:43", "text": "ああ、学ぶ、何があるか"}, {"type": "subtitle", "time": 16845.59, "timestamp": "04:40:45", "text": "知り合いと呼ばれるもの"}, {"type": "subtitle", "time": 16849.11, "timestamp": "04:40:49", "text": "同僚みたいな感じですね、分かりますが、"}, {"type": "subtitle", "time": 16854.55, "timestamp": "04:40:54", "text": "たくさんのことに「わあ」って思った"}]
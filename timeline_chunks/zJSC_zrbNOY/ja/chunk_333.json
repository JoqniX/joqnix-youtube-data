[{"type": "subtitle", "time": 19981.83, "timestamp": "05:33:01", "text": "あなたの普通預金口座のようなもの"}, {"type": "subtitle", "time": 19984.07, "timestamp": "05:33:04", "text": "チャンネル名。つまり、それはまた、"}, {"type": "subtitle", "time": 19986.868, "timestamp": "05:33:06", "text": "個人事業主として登録する必要があります"}, {"type": "subtitle", "time": 19990.15, "timestamp": "05:33:10", "text": "個人事業主。いいえ、それは"}, {"type": "subtitle", "time": 19992.31, "timestamp": "05:33:12", "text": "えーと、その他"}, {"type": "subtitle", "time": 19994.868, "timestamp": "05:33:14", "text": "うん、そういうことも起こり得ると思うよ"}, {"type": "subtitle", "time": 19997.59, "timestamp": "05:33:17", "text": "例えば、私たちがこうなりたいとしたら、"}, {"type": "subtitle", "time": 19999.11, "timestamp": "05:33:19", "text": "実は"}, {"type": "subtitle", "time": 20001.19, "timestamp": "05:33:21", "text": "非常に真剣で献身的"}, {"type": "subtitle", "time": 20003.19, "timestamp": "05:33:23", "text": "ストリーミングのことだけど、私は"}, {"type": "subtitle", "time": 20006.628, "timestamp": "05:33:26", "text": "インドのユーチューバーは、えっと、ただ"}, {"type": "subtitle", "time": 20008.788, "timestamp": "05:33:28", "text": "ストリーミングを開始して、どのように"}, {"type": "subtitle", "time": 20011.83, "timestamp": "05:33:31", "text": "私たちはそれを事実として知っているからそう感じるのです"}, {"type": "subtitle", "time": 20013.83, "timestamp": "05:33:33", "text": "私たちはただカミングアウトすることはできません"}, {"type": "subtitle", "time": 20017.83, "timestamp": "05:33:37", "text": "家族と、忘れたい"}, {"type": "subtitle", "time": 20023.43, "timestamp": "05:33:43", "text": "殴られる。はい。何てことだ。 tleアタック"}, {"type": "subtitle", "time": 20026.788, "timestamp": "05:33:46", "text": "あるいは、そんな感じ。何てことだ。攻撃。私は思う"}, {"type": "subtitle", "time": 20029.83, "timestamp": "05:33:49", "text": "飛行中のものなら何でも手に入れます"}, {"type": "subtitle", "time": 20031.59, "timestamp": "05:33:51", "text": "彼らが手に入れることができる方法。"}, {"type": "subtitle", "time": 20033.91, "timestamp": "05:33:53", "text": "それはただ、"}]
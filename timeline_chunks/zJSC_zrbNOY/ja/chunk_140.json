[{"type": "subtitle", "time": 8413.95, "timestamp": "02:20:13", "text": "でも、"}, {"type": "subtitle", "time": 8416.23, "timestamp": "02:20:16", "text": "[音楽]"}, {"type": "subtitle", "time": 8419.27, "timestamp": "02:20:19", "text": "皆さんはどう思いますか？"}, {"type": "subtitle", "time": 8421.19, "timestamp": "02:20:21", "text": "今探している人たち"}, {"type": "subtitle", "time": 8427.349, "timestamp": "02:20:27", "text": "何かを使いますか？"}, {"type": "subtitle", "time": 8430.63, "timestamp": "02:20:30", "text": "チャンネルをブーストするなど、たとえ"}, {"type": "subtitle", "time": 8434.15, "timestamp": "02:20:34", "text": "それがプロムなら、それが自然だと書いてあるなら"}, {"type": "subtitle", "time": 8437.11, "timestamp": "02:20:37", "text": "オーガニックとか、何でもいいけど。それとも"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "そういうことは避けようとする"}, {"type": "subtitle", "time": 8442.07, "timestamp": "02:20:42", "text": "そしてちょうど"}, {"type": "subtitle", "time": 8445.11, "timestamp": "02:20:45", "text": "自然に、オーガニックに"}, {"type": "subtitle", "time": 8449.27, "timestamp": "02:20:49", "text": "自分のペースで、いろいろと？"}]
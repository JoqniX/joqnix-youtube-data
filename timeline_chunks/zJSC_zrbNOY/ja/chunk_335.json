[{"type": "subtitle", "time": 20102.788, "timestamp": "05:35:02", "text": "だって、えーっと、うん、そうだったから彼は"}, {"type": "subtitle", "time": 20105.67, "timestamp": "05:35:05", "text": "話すのに十分良い"}, {"type": "subtitle", "time": 20108.15, "timestamp": "05:35:08", "text": "それについて話すと、私たちは行ったように"}, {"type": "subtitle", "time": 20111.19, "timestamp": "05:35:11", "text": "彼が知っている誰か、白熱した警官のように"}, {"type": "subtitle", "time": 20114.31, "timestamp": "05:35:14", "text": "彼らのオフィスに入って、私は考えた"}, {"type": "subtitle", "time": 20117.19, "timestamp": "05:35:17", "text": "私の状況。だから私は、私は"}, {"type": "subtitle", "time": 20119.83, "timestamp": "05:35:19", "text": "このお金に関するストレス"}, {"type": "subtitle", "time": 20122.788, "timestamp": "05:35:22", "text": "私が自分の仕事に必要なもの。"}, {"type": "subtitle", "time": 20125.03, "timestamp": "05:35:25", "text": "知らないので説明しました"}, {"type": "subtitle", "time": 20126.868, "timestamp": "05:35:26", "text": "VTubingとかが今ストリーミング配信してるもの"}, {"type": "subtitle", "time": 20129.43, "timestamp": "05:35:29", "text": "そして全て。私は詳しく説明しました。"}, {"type": "subtitle", "time": 20132.948, "timestamp": "05:35:32", "text": "彼らはある程度理解していた。えっと"}, {"type": "subtitle", "time": 20134.548, "timestamp": "05:35:34", "text": "契約書を見せなければならなかったし"}, {"type": "subtitle", "time": 20136.628, "timestamp": "05:35:36", "text": "私の"}, {"type": "subtitle", "time": 20140.788, "timestamp": "05:35:40", "text": "そういうもの全部あったの？"}, {"type": "subtitle", "time": 20145.19, "timestamp": "05:35:45", "text": "また、彼らは私が持っているので、"}, {"type": "subtitle", "time": 20147.67, "timestamp": "05:35:47", "text": "私の連邦銀行のやつ。のような"}, {"type": "subtitle", "time": 20149.99, "timestamp": "05:35:49", "text": "私は複数の銀行を持っていますが、連邦銀行"}, {"type": "subtitle", "time": 20152.15, "timestamp": "05:35:52", "text": "私が普段オンラインで使用しているものです"}, {"type": "subtitle", "time": 20154.47, "timestamp": "05:35:54", "text": "もの。だから彼らは「うん、できるよ」って言うんだ"}, {"type": "subtitle", "time": 20156.788, "timestamp": "05:35:56", "text": "連邦政府の口座を開設する"}]
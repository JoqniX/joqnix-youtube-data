[{"type": "subtitle", "time": 13981.91, "timestamp": "03:53:01", "text": "または、ガイドやハウツーなど"}, {"type": "subtitle", "time": 13984.71, "timestamp": "03:53:04", "text": "Twitchの配信者向け倫理規定など"}, {"type": "subtitle", "time": 13988.07, "timestamp": "03:53:08", "text": "何をすべきかとか、そういうこと。そしてその時私は"}, {"type": "subtitle", "time": 13991.189, "timestamp": "03:53:11", "text": "学んだ、そう、すべてが"}, {"type": "subtitle", "time": 13993.59, "timestamp": "03:53:13", "text": "これ。維持するためには、これをしなければなりません"}, {"type": "subtitle", "time": 13996.15, "timestamp": "03:53:16", "text": "話すことと、ずっと黙っていること"}, {"type": "subtitle", "time": 13999.349, "timestamp": "03:53:19", "text": "時間。幸運な人もいるだろう。そして戻る"}, {"type": "subtitle", "time": 14001.67, "timestamp": "03:53:21", "text": "その時、私はフォローが何なのか知りませんでした"}, {"type": "subtitle", "time": 14004.55, "timestamp": "03:53:24", "text": "そして、それがどれほど悪いことか。"}, {"type": "subtitle", "time": 14007.269, "timestamp": "03:53:27", "text": "そういうこともあったし、いろいろあった。私はしません"}, {"type": "subtitle", "time": 14009.11, "timestamp": "03:53:29", "text": "それが起こっているのを見てください"}, {"type": "subtitle", "time": 14010.79, "timestamp": "03:53:30", "text": "最近では。"}, {"type": "subtitle", "time": 14012.95, "timestamp": "03:53:32", "text": "昔はそういうものだった。"}, {"type": "subtitle", "time": 14014.79, "timestamp": "03:53:34", "text": "みんなは以前は次のことをしていた"}, {"type": "subtitle", "time": 14019.269, "timestamp": "03:53:39", "text": "フォローして、うん、何度も"}, {"type": "subtitle", "time": 14023.349, "timestamp": "03:53:43", "text": "何かがもっと"}, {"type": "subtitle", "time": 14027.59, "timestamp": "03:53:47", "text": "直接的ではない、私はこう言うだろう"}, {"type": "subtitle", "time": 14029.51, "timestamp": "03:53:49", "text": "ええと、それはより間接的になりました"}, {"type": "subtitle", "time": 14032.63, "timestamp": "03:53:52", "text": "ツイッターの投稿は、えーっと、エンガみたいな感じ"}, {"type": "subtitle", "time": 14036.55, "timestamp": "03:53:56", "text": "カバーで覆われているような"}, {"type": "subtitle", "time": 14038.87, "timestamp": "03:53:58", "text": "エンゲージメントとか、"}]
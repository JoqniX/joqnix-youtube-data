[{"type": "subtitle", "time": 16740.551, "timestamp": "04:39:00", "text": "ええ、それは本当です。あなたも"}, {"type": "subtitle", "time": 16743.029, "timestamp": "04:39:03", "text": "あなたはきらめきのようにあなたがしなければならない"}, {"type": "subtitle", "time": 16747.109, "timestamp": "04:39:07", "text": "他の人もそうであることに注意してください"}, {"type": "subtitle", "time": 16749.67, "timestamp": "04:39:09", "text": "快適だと感じている、または"}, {"type": "subtitle", "time": 16753.109, "timestamp": "04:39:13", "text": "ある特定の人物のせいで、居心地が悪いと感じる。"}, {"type": "subtitle", "time": 16755.75, "timestamp": "04:39:15", "text": "オーディオのような"}, {"type": "subtitle", "time": 16759.189, "timestamp": "04:39:19", "text": "声に出して、そうしないように忠告する。もし"}, {"type": "subtitle", "time": 16760.869, "timestamp": "04:39:20", "text": "彼らがそれを破ると、罰を与えることができ、"}, {"type": "subtitle", "time": 16762.709, "timestamp": "04:39:22", "text": "すべて。右。"}, {"type": "subtitle", "time": 16764.789, "timestamp": "04:39:24", "text": "それは私がまだ"}, {"type": "subtitle", "time": 16767.349, "timestamp": "04:39:27", "text": "作業中なんだけど、えっと、ほら、"}, {"type": "subtitle", "time": 16769.429, "timestamp": "04:39:29", "text": "しっかりとした境界線があって、"}, {"type": "subtitle", "time": 16772.23, "timestamp": "04:39:32", "text": "その境界線を強制するのは、"}, {"type": "subtitle", "time": 16775.99, "timestamp": "04:39:35", "text": "押されている。うん。叫ぶ宇宙として"}, {"type": "subtitle", "time": 16780.628, "timestamp": "04:39:40", "text": "まあ、私が自由に放任するのと同じように"}, {"type": "subtitle", "time": 16783.03, "timestamp": "04:39:43", "text": "彼らが話し合えるような人々"}, {"type": "subtitle", "time": 16785.11, "timestamp": "04:39:45", "text": "物事についてですが、同時に"}, {"type": "subtitle", "time": 16788.07, "timestamp": "04:39:48", "text": "時間には、ある意味、こうでなければならないような"}, {"type": "subtitle", "time": 16790.948, "timestamp": "04:39:50", "text": "誰も越えてはならない境界線"}, {"type": "subtitle", "time": 16792.69, "timestamp": "04:39:52", "text": "私ですらそうは思わない。時々。"}, {"type": "subtitle", "time": 16794.31, "timestamp": "04:39:54", "text": "[音楽]"}, {"type": "subtitle", "time": 16796.788, "timestamp": "04:39:56", "text": "ええ、私も学んでいます"}, {"type": "subtitle", "time": 16799.83, "timestamp": "04:39:59", "text": "最善を尽くしてそうしています。つまり、境界線"}]
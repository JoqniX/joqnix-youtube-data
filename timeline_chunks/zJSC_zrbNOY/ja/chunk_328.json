[{"type": "subtitle", "time": 19682.628, "timestamp": "05:28:02", "text": "ビジネス1。それは確かにそこにあった。オカですか？"}, {"type": "subtitle", "time": 19687.11, "timestamp": "05:28:07", "text": "今も昔も変わらないの？それはえっと"}, {"type": "subtitle", "time": 19689.19, "timestamp": "05:28:09", "text": "住所が表示されていないということですか？"}, {"type": "subtitle", "time": 19691.27, "timestamp": "05:28:11", "text": "今はそんなものなの？もはや私の住所ではなく、"}, {"type": "subtitle", "time": 19692.548, "timestamp": "05:28:12", "text": "すべて。それはまるで私の"}, {"type": "subtitle", "time": 19695.75, "timestamp": "05:28:15", "text": "名前とかそういうもの。だから、大丈夫だよ。大丈夫。おお、"}, {"type": "subtitle", "time": 19697.51, "timestamp": "05:28:17", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 19699.99, "timestamp": "05:28:19", "text": "うん。そして、次善の策は"}, {"type": "subtitle", "time": 19702.07, "timestamp": "05:28:22", "text": "えっと、ただ行くだけで"}, {"type": "subtitle", "time": 19706.31, "timestamp": "05:28:26", "text": "コーヒーを飲んで、そこを通り抜ける。"}, {"type": "subtitle", "time": 19709.35, "timestamp": "05:28:29", "text": "でも待って、えっと、私がやっている間に気づいたことは"}, {"type": "subtitle", "time": 19712.788, "timestamp": "05:28:32", "text": "Joathon はインド国民向けに PayPal も提供開始"}, {"type": "subtitle", "time": 19715.43, "timestamp": "05:28:35", "text": "ローカル取引では機能しません"}, {"type": "subtitle", "time": 19719.35, "timestamp": "05:28:39", "text": "もの。それから何人かの人に気付いた"}, {"type": "subtitle", "time": 19724.15, "timestamp": "05:28:44", "text": "Kofiコーヒーではできませんでした。"}, {"type": "subtitle", "time": 19727.03, "timestamp": "05:28:47", "text": "エラーが表示されたと言った"}, {"type": "subtitle", "time": 19729.03, "timestamp": "05:28:49", "text": "インドでは利用できません。"}, {"type": "subtitle", "time": 19731.67, "timestamp": "05:28:51", "text": "彼らがやろうとしたとき"}, {"type": "subtitle", "time": 19734.23, "timestamp": "05:28:54", "text": "支払いか何か。理由がわからない"}, {"type": "subtitle", "time": 19737.35, "timestamp": "05:28:57", "text": "それは、私が「ああ、コフィは"}, {"type": "subtitle", "time": 19739.91, "timestamp": "05:28:59", "text": "代替案として使えるものだけど、そうではない。"}]
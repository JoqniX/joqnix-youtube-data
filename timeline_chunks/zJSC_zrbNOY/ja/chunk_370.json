[{"type": "subtitle", "time": 22201.27, "timestamp": "06:10:01", "text": "でも私は魚のカレーを作ったことがあるので、"}, {"type": "subtitle", "time": 22204.07, "timestamp": "06:10:04", "text": "そこには。そして鶏肉は"}, {"type": "subtitle", "time": 22207.51, "timestamp": "06:10:07", "text": "壊すのは本当に難しいから"}, {"type": "subtitle", "time": 22210.868, "timestamp": "06:10:10", "text": "鶏肉"}, {"type": "subtitle", "time": 22217.51, "timestamp": "06:10:17", "text": "今ではたくさんの種類があります"}, {"type": "subtitle", "time": 22220.47, "timestamp": "06:10:20", "text": "マサラパウダーとチキンの具材"}, {"type": "subtitle", "time": 22224.23, "timestamp": "06:10:24", "text": "もの。作れるって知ってるよ"}, {"type": "subtitle", "time": 22228.23, "timestamp": "06:10:28", "text": "シンプルなシチューから、とても凝ったマサラまで"}, {"type": "subtitle", "time": 22231.91, "timestamp": "06:10:31", "text": "でも、私はあまり"}, {"type": "subtitle", "time": 22235.03, "timestamp": "06:10:35", "text": "マサラ味のものは、時々、"}, {"type": "subtitle", "time": 22236.868, "timestamp": "06:10:36", "text": "胃にも優しいし、"}, {"type": "subtitle", "time": 22239.75, "timestamp": "06:10:39", "text": "まあ、私がみんなのために作るように"}, {"type": "subtitle", "time": 22241.67, "timestamp": "06:10:41", "text": "自宅も同様です。だから気をつけなければならない"}, {"type": "subtitle", "time": 22244.39, "timestamp": "06:10:44", "text": "食事制限により"}, {"type": "subtitle", "time": 22247.43, "timestamp": "06:10:47", "text": "えっと、だって私の家族はそれを食べないから"}, {"type": "subtitle", "time": 22250.868, "timestamp": "06:10:50", "text": "辛い食べ物がたくさん。"}, {"type": "subtitle", "time": 22253.91, "timestamp": "06:10:53", "text": "だから私は食べる量を本当に少なくするようにしています"}, {"type": "subtitle", "time": 22255.75, "timestamp": "06:10:55", "text": "彼らにとっては辛いので、私はただこうし続けます"}, {"type": "subtitle", "time": 22257.75, "timestamp": "06:10:57", "text": "青唐辛子か何か、自分用に"}]
[{"type": "subtitle", "time": 663.269, "timestamp": "00:11:03", "text": "ババ・ヤーガ。ババ・ヤーガはどこにいる？私"}, {"type": "subtitle", "time": 666.069, "timestamp": "00:11:06", "text": "不思議に思った。"}, {"type": "subtitle", "time": 668.71, "timestamp": "00:11:08", "text": "ああ、それはどこにあるのでしょう？私には必要なの、あのね？"}, {"type": "subtitle", "time": 675.03, "timestamp": "00:11:15", "text": "これです。これはボーカロイドの曲なので、"}, {"type": "subtitle", "time": 678.47, "timestamp": "00:11:18", "text": "それがどれほど大変なことか、よく分かっています。"}, {"type": "subtitle", "time": 680.88, "timestamp": "00:11:20", "text": "私が試してみます。わかった。"}, {"type": "subtitle", "time": 683.59, "timestamp": "00:11:23", "text": "[音楽]"}, {"type": "subtitle", "time": 687.11, "timestamp": "00:11:27", "text": "これは難しいだろう。"}]
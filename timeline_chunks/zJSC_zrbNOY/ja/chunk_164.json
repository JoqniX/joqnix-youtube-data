[{"type": "subtitle", "time": 9863.83, "timestamp": "02:44:23", "text": "もしあなたが私のものなら"}, {"type": "subtitle", "time": 9874.23, "timestamp": "02:44:34", "text": "グループリンクに参加している場合は、無視してください。"}, {"type": "subtitle", "time": 9878.87, "timestamp": "02:44:38", "text": "そして、私はそのリンクにアクセスしなければなりません。"}, {"type": "subtitle", "time": 9881.51, "timestamp": "02:44:41", "text": "えっと、これが"}, {"type": "subtitle", "time": 9883.19, "timestamp": "02:44:43", "text": "マルチ"}, {"type": "subtitle", "time": 9886.389, "timestamp": "02:44:46", "text": "視聴リンク。"}, {"type": "subtitle", "time": 9889.99, "timestamp": "02:44:49", "text": "Twitchで配信することもできます。"}, {"type": "subtitle", "time": 9892.309, "timestamp": "02:44:52", "text": "突風。"}, {"type": "subtitle", "time": 9896.389, "timestamp": "02:44:56", "text": "Twitchもそれに該当します。"}, {"type": "subtitle", "time": 9898.389, "timestamp": "02:44:58", "text": "Twitch"}]
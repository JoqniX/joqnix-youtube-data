[{"type": "subtitle", "time": 16980.55, "timestamp": "04:43:00", "text": "部屋で話したり、何かを言ったりする"}, {"type": "subtitle", "time": 16982.628, "timestamp": "04:43:02", "text": "その時はただパニックになるだけだろう"}, {"type": "subtitle", "time": 16986.788, "timestamp": "04:43:06", "text": "ミュートのように。ミュートはどこにありますか？"}, {"type": "subtitle", "time": 16992.628, "timestamp": "04:43:12", "text": "だから私は"}, {"type": "subtitle", "time": 16994.628, "timestamp": "04:43:14", "text": "タッチでミュートできるマイク"}, {"type": "subtitle", "time": 16997.43, "timestamp": "04:43:17", "text": "あれ。簡単な"}, {"type": "subtitle", "time": 17000.07, "timestamp": "04:43:20", "text": "OBSやWindowsのようなソフトを使うのではなく"}, {"type": "subtitle", "time": 17003.19, "timestamp": "04:43:23", "text": "ミュートボタンはどこ？パニック"}, {"type": "subtitle", "time": 17006.948, "timestamp": "04:43:26", "text": "だって、私は勢いをつけていたから"}, {"type": "subtitle", "time": 17009.03, "timestamp": "04:43:29", "text": "慌ただしい。"}, {"type": "subtitle", "time": 17012.788, "timestamp": "04:43:32", "text": "私は現在ヘッドセットを持っていますが、"}, {"type": "subtitle", "time": 17014.55, "timestamp": "04:43:34", "text": "マイクを買うために貯金しているんだけど、"}, {"type": "subtitle", "time": 17017.27, "timestamp": "04:43:37", "text": "おそらく1つを選ぶでしょう"}, {"type": "subtitle", "time": 17019.91, "timestamp": "04:43:39", "text": "でも、今はヘッドセットがあるので"}, {"type": "subtitle", "time": 17021.75, "timestamp": "04:43:41", "text": "私たちはそれに取り組んでいます。私は気にしない"}, {"type": "subtitle", "time": 17023.51, "timestamp": "04:43:43", "text": "ヘッドセットのマイクも、まさにそれです"}, {"type": "subtitle", "time": 17025.35, "timestamp": "04:43:45", "text": "特にこの人は"}, {"type": "subtitle", "time": 17028.23, "timestamp": "04:43:48", "text": "私にとっては重すぎる。"}, {"type": "subtitle", "time": 17030.47, "timestamp": "04:43:50", "text": "だから長時間"}, {"type": "subtitle", "time": 17034.31, "timestamp": "04:43:54", "text": "ストリーミングすると、まるで"}, {"type": "subtitle", "time": 17037.75, "timestamp": "04:43:57", "text": "頭が重くて、"}]
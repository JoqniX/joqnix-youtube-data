[{"type": "subtitle", "time": 21121.83, "timestamp": "05:52:01", "text": "5月に。そう、5月だ。今は6月です。"}, {"type": "subtitle", "time": 21124.31, "timestamp": "05:52:04", "text": "右？だから私は彼らにゆっくりと支払わなければならない"}, {"type": "subtitle", "time": 21127.99, "timestamp": "05:52:07", "text": "それ。うん。でも授業は良かったよ。"}, {"type": "subtitle", "time": 21129.99, "timestamp": "05:52:09", "text": "でも、"}, {"type": "subtitle", "time": 21132.868, "timestamp": "05:52:12", "text": "こういうことは、"}, {"type": "subtitle", "time": 21135.35, "timestamp": "05:52:15", "text": "少なくとも1、2時間はかかるだろう、そう、これら"}, {"type": "subtitle", "time": 21137.59, "timestamp": "05:52:17", "text": "音楽や芸術に関する趣味や"}, {"type": "subtitle", "time": 21140.15, "timestamp": "05:52:20", "text": "何でも。さもないと負けることになる"}, {"type": "subtitle", "time": 21142.39, "timestamp": "05:52:22", "text": "あの流れ、だよね？何をすべきか忘れてしまうでしょう"}, {"type": "subtitle", "time": 21145.27, "timestamp": "05:52:25", "text": "やること、そういうこと。それが問題なんです"}, {"type": "subtitle", "time": 21148.628, "timestamp": "05:52:28", "text": "自分。ええと、私はジョアソンをやっていましたが"}, {"type": "subtitle", "time": 21150.31, "timestamp": "05:52:30", "text": "24時間ずっと、私は"}, {"type": "subtitle", "time": 21151.91, "timestamp": "05:52:31", "text": "ストリームやその他諸々"}, {"type": "subtitle", "time": 21155.11, "timestamp": "05:52:35", "text": "すべてにおいて、私にはできない時があった"}, {"type": "subtitle", "time": 21157.59, "timestamp": "05:52:37", "text": "音楽関係のことをする。どちらか"}, {"type": "subtitle", "time": 21159.91, "timestamp": "05:52:39", "text": "コラボレーション、または私が参加するイベント、または"}, {"type": "subtitle", "time": 21162.628, "timestamp": "05:52:42", "text": "マインクラフトとか何とか、あるいは"}, {"type": "subtitle", "time": 21165.03, "timestamp": "05:52:45", "text": "すごく疲れているかもしれない。私は"}, {"type": "subtitle", "time": 21168.708, "timestamp": "05:52:48", "text": "先延ばしにしてて、「ああ、"}, {"type": "subtitle", "time": 21171.27, "timestamp": "05:52:51", "text": "ごめんなさい。サブ投稿できませんでした"}, {"type": "subtitle", "time": 21173.43, "timestamp": "05:52:53", "text": "宿題"}, {"type": "subtitle", "time": 21178.07, "timestamp": "05:52:58", "text": "「そんな感じ。」でも、ええ、私は気づきました。"}, {"type": "subtitle", "time": 21179.91, "timestamp": "05:52:59", "text": "ええ、何事においても、"}]
[{"type": "subtitle", "time": 20161.91, "timestamp": "05:36:01", "text": "銀行やGST関連のものについては、"}, {"type": "subtitle", "time": 20164.628, "timestamp": "05:36:04", "text": "毎年それをnullか何かに設定してください"}, {"type": "subtitle", "time": 20166.948, "timestamp": "05:36:06", "text": "または毎月、"}, {"type": "subtitle", "time": 20169.43, "timestamp": "05:36:09", "text": "「起こるんだ」と彼らは言った。「わかった、"}, {"type": "subtitle", "time": 20172.07, "timestamp": "05:36:12", "text": "それは私が代わりにできます。心配しないで、私は"}, {"type": "subtitle", "time": 20173.59, "timestamp": "05:36:13", "text": "3つか4つも稼げないだろう"}, {"type": "subtitle", "time": 20175.19, "timestamp": "05:36:15", "text": "数十万ルピーくらいですよね？まるで"}, {"type": "subtitle", "time": 20178.31, "timestamp": "05:36:18", "text": "実際のビジネス。それは不可能だ、"}, {"type": "subtitle", "time": 20180.868, "timestamp": "05:36:20", "text": "そうだよね？だから彼らは「うん、できるよ」って感じなんだ"}, {"type": "subtitle", "time": 20185.35, "timestamp": "05:36:25", "text": "nullのようなものを与えるが、私の"}, {"type": "subtitle", "time": 20187.75, "timestamp": "05:36:27", "text": "私は今日本に行く予定なので"}, {"type": "subtitle", "time": 20190.548, "timestamp": "05:36:30", "text": "研究やその他諸々、とてもたくさんありました"}, {"type": "subtitle", "time": 20193.03, "timestamp": "05:36:33", "text": "その他の合併症を変換する必要がある"}, {"type": "subtitle", "time": 20196.39, "timestamp": "05:36:36", "text": "IGST または何か別のものに変更する"}, {"type": "subtitle", "time": 20200.708, "timestamp": "05:36:40", "text": "いろいろなことがあって、それで私はこう思った"}, {"type": "subtitle", "time": 20203.11, "timestamp": "05:36:43", "text": "そして、少なくとも10,000個か"}, {"type": "subtitle", "time": 20207.51, "timestamp": "05:36:47", "text": "カルナカンの最低残高を開くには 5,000"}, {"type": "subtitle", "time": 20209.51, "timestamp": "05:36:49", "text": "それは正気の沙汰じゃない。"}, {"type": "subtitle", "time": 20214.868, "timestamp": "05:36:54", "text": "私たちはただの学生だということは分かっています。うん。そして"}, {"type": "subtitle", "time": 20219.11, "timestamp": "05:36:59", "text": "それはとんでもない量で、"}]
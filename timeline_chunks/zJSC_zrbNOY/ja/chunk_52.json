[{"type": "subtitle", "time": 3120.71, "timestamp": "00:52:00", "text": "私はうまく機能するように物を作ります"}, {"type": "subtitle", "time": 3122.95, "timestamp": "00:52:02", "text": "ストリームとか全部？"}, {"type": "subtitle", "time": 3127.349, "timestamp": "00:52:07", "text": "今はそれしか考えられない。"}, {"type": "subtitle", "time": 3129.109, "timestamp": "00:52:09", "text": "自分の精神状態が正しいかどうかわからないが、"}, {"type": "subtitle", "time": 3131.43, "timestamp": "00:52:11", "text": "しかし彼らは"}, {"type": "subtitle", "time": 3133.51, "timestamp": "00:52:13", "text": "試験のことで悩んでいる。それが私の"}, {"type": "subtitle", "time": 3135.67, "timestamp": "00:52:15", "text": "考えている。"}, {"type": "subtitle", "time": 3137.75, "timestamp": "00:52:17", "text": "それは普通のことですか？それはそうは思わない"}, {"type": "subtitle", "time": 3165.03, "timestamp": "00:52:45", "text": "また、今日の配信、朝の配信は"}, {"type": "subtitle", "time": 3170.069, "timestamp": "00:52:50", "text": "パートストリームは3時に完了しました"}]
[{"type": "subtitle", "time": 15781.67, "timestamp": "04:23:01", "text": "そしてそれは数通のメッセージだった、なぜなら"}, {"type": "subtitle", "time": 15783.51, "timestamp": "04:23:03", "text": "えーと、まず最初に私が思ったのは"}, {"type": "subtitle", "time": 15786.389, "timestamp": "04:23:06", "text": "何が起こっているのか混乱していたので"}, {"type": "subtitle", "time": 15788.07, "timestamp": "04:23:08", "text": "彼らからのメッセージは少し"}, {"type": "subtitle", "time": 15790.389, "timestamp": "04:23:10", "text": "横側も一般的にはこんにちはとかそういう感じ"}, {"type": "subtitle", "time": 15794.07, "timestamp": "04:23:14", "text": "そして私は、なぜ"}, {"type": "subtitle", "time": 15798.309, "timestamp": "04:23:18", "text": "bosi が私のチャットでこんにちはと言っています"}, {"type": "subtitle", "time": 15806.63, "timestamp": "04:23:26", "text": "何てことだ。私はただ混乱していて"}, {"type": "subtitle", "time": 15809.67, "timestamp": "04:23:29", "text": "それで、ああ、それがBだ、という感じだった。"}, {"type": "subtitle", "time": 15811.429, "timestamp": "04:23:31", "text": "私が始めたら、友達が始めた"}, {"type": "subtitle", "time": 15815.11, "timestamp": "04:23:35", "text": "それについて手伝ってくれる。それはただ"}, {"type": "subtitle", "time": 15822.309, "timestamp": "04:23:42", "text": "ボットがチャットで私にあなたのチャットを教えてくれるとき"}, {"type": "subtitle", "time": 15824.309, "timestamp": "04:23:44", "text": "まるで幽霊のように沈黙している"}, {"type": "subtitle", "time": 15827.269, "timestamp": "04:23:47", "text": "などなど。めちゃくちゃ面白いよ。知っている。私"}, {"type": "subtitle", "time": 15829.75, "timestamp": "04:23:49", "text": "多くのボットが"}, {"type": "subtitle", "time": 15831.91, "timestamp": "04:23:51", "text": "最近の彼らのメッセージは、"}, {"type": "subtitle", "time": 15834.63, "timestamp": "04:23:54", "text": "チャットがすごく静かですね。"}, {"type": "subtitle", "time": 15837.67, "timestamp": "04:23:57", "text": "何てことだ。そして私は「必要ない」と言いました"}]
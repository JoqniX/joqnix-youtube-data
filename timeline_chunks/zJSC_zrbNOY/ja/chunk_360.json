[{"type": "subtitle", "time": 21603.35, "timestamp": "06:00:03", "text": "ああ、それで私はこう思った。「うん、私が"}, {"type": "subtitle", "time": 21606.47, "timestamp": "06:00:06", "text": "私が小さかった頃、成長した。"}, {"type": "subtitle", "time": 21609.43, "timestamp": "06:00:09", "text": "以前は、学校に送ってもらって、"}, {"type": "subtitle", "time": 21612.23, "timestamp": "06:00:12", "text": "もの。だから彼がこれをしているのを見ると"}, {"type": "subtitle", "time": 21616.628, "timestamp": "06:00:16", "text": "彼はどこへ行くにも自転車を持って行き、"}, {"type": "subtitle", "time": 21618.628, "timestamp": "06:00:18", "text": "彼はいつも人々に手を振っていた"}, {"type": "subtitle", "time": 21620.47, "timestamp": "06:00:20", "text": "そして人々"}, {"type": "subtitle", "time": 21622.868, "timestamp": "06:00:22", "text": "ずっと昔の話とか。私は何人いるか"}, {"type": "subtitle", "time": 21625.27, "timestamp": "06:00:25", "text": "友達はどこにでもいるの？毎"}, {"type": "subtitle", "time": 21629.11, "timestamp": "06:00:29", "text": "どこへ行ってもみんな知っている道"}, {"type": "subtitle", "time": 21631.03, "timestamp": "06:00:31", "text": "あなた。だから、それ以来ずっと、"}, {"type": "subtitle", "time": 21634.07, "timestamp": "06:00:34", "text": "「うん、大人になったらもっと"}, {"type": "subtitle", "time": 21638.47, "timestamp": "06:00:38", "text": "「いつか父のような社交的な人間になりたい。」"}, {"type": "subtitle", "time": 21640.948, "timestamp": "06:00:40", "text": "そう、私が成長したとき、私はこうでした"}, {"type": "subtitle", "time": 21644.07, "timestamp": "06:00:44", "text": "彼とは正反対の人物。私は"}, {"type": "subtitle", "time": 21647.51, "timestamp": "06:00:47", "text": "内向的でシャテインタイプが好きで、"}, {"type": "subtitle", "time": 21654.788, "timestamp": "06:00:54", "text": "何てことだ。"}, {"type": "subtitle", "time": 21658.39, "timestamp": "06:00:58", "text": "うん。そしてそれ以来ずっと、ああ、そうだ。えーと、その後"}]
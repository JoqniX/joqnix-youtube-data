[{"type": "subtitle", "time": 17580.23, "timestamp": "04:53:00", "text": "そのための設備費用を負担する。平"}, {"type": "subtitle", "time": 17584.07, "timestamp": "04:53:04", "text": "アートは、ええと、"}, {"type": "subtitle", "time": 17593.91, "timestamp": "04:53:13", "text": "ジョアソンに参加しているので、"}, {"type": "subtitle", "time": 17596.39, "timestamp": "04:53:16", "text": "モデルも何もかも。"}, {"type": "subtitle", "time": 17599.35, "timestamp": "04:53:19", "text": "わーい。"}, {"type": "subtitle", "time": 17601.67, "timestamp": "04:53:21", "text": "気持ちよく感じて、"}, {"type": "subtitle", "time": 17603.67, "timestamp": "04:53:23", "text": "モデルは近日公開予定です。"}, {"type": "subtitle", "time": 17606.07, "timestamp": "04:53:26", "text": "うん。"}, {"type": "subtitle", "time": 17609.75, "timestamp": "04:53:29", "text": "だって、今は本当に変な感じだから"}, {"type": "subtitle", "time": 17613.59, "timestamp": "04:53:33", "text": "人々にサポートをお願いする"}, {"type": "subtitle", "time": 17616.39, "timestamp": "04:53:36", "text": "そういうの、だって私はそういうのが好きなタイプだから"}, {"type": "subtitle", "time": 17618.788, "timestamp": "04:53:38", "text": "すべて無料。私はそうは思わない 私はそうは思わない"}, {"type": "subtitle", "time": 17620.868, "timestamp": "04:53:40", "text": "人のお金やその他何でも欲しい。私はただ"}, {"type": "subtitle", "time": 17623.03, "timestamp": "04:53:43", "text": "自分のやりたいことをして楽しみたい"}, {"type": "subtitle", "time": 17626.628, "timestamp": "04:53:46", "text": "今、思い出を作ろう。そして私はいつも知っていた"}, {"type": "subtitle", "time": 17629.03, "timestamp": "04:53:49", "text": "D には安息日と"}, {"type": "subtitle", "time": 17632.31, "timestamp": "04:53:52", "text": "すべてだったが、長い間それをやらなかった"}, {"type": "subtitle", "time": 17635.43, "timestamp": "04:53:55", "text": "戻ってきたのは、もし私が"}, {"type": "subtitle", "time": 17638.23, "timestamp": "04:53:58", "text": "それをやる時は慈善のためであり、"}]
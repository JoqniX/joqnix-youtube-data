[{"type": "subtitle", "time": 5761.75, "timestamp": "01:36:01", "text": "ああ、いいよ。ああ、液体状だ。ああ。"}, {"type": "subtitle", "time": 5768.709, "timestamp": "01:36:08", "text": "問題は今"}, {"type": "subtitle", "time": 5770.47, "timestamp": "01:36:10", "text": "私"}, {"type": "subtitle", "time": 5773.75, "timestamp": "01:36:13", "text": "普段は食べない"}, {"type": "subtitle", "time": 5776.709, "timestamp": "01:36:16", "text": "食べ物"}, {"type": "subtitle", "time": 5780.07, "timestamp": "01:36:20", "text": "私もそうしたいです。"}, {"type": "subtitle", "time": 5783.51, "timestamp": "01:36:23", "text": "私はどちらかというと手作り好きの変わり者なのかもしれません。私"}, {"type": "subtitle", "time": 5790.55, "timestamp": "01:36:30", "text": "こういうのを見ると、うわぁって思う。"}, {"type": "subtitle", "time": 5818.229, "timestamp": "01:36:58", "text": "ああ、それはタマネギだ。よし、食べさせてくれ"}]
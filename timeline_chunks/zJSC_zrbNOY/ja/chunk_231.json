[{"type": "subtitle", "time": 13861.429, "timestamp": "03:51:01", "text": "心。行く予定だった人たちがいます"}, {"type": "subtitle", "time": 13864.55, "timestamp": "03:51:04", "text": "あなたと交流し、あなたと話す"}, {"type": "subtitle", "time": 13866.229, "timestamp": "03:51:06", "text": "そしてチャットする"}, {"type": "subtitle", "time": 13868.71, "timestamp": "03:51:08", "text": "そして会話。"}, {"type": "subtitle", "time": 13872.229, "timestamp": "03:51:12", "text": "彼らから新しいことを学ぶことができる。何でも"}, {"type": "subtitle", "time": 13874.15, "timestamp": "03:51:14", "text": "学んだことを、あなたの"}, {"type": "subtitle", "time": 13875.83, "timestamp": "03:51:15", "text": "観客。"}, {"type": "subtitle", "time": 13878.71, "timestamp": "03:51:18", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 13882.95, "timestamp": "03:51:22", "text": "とても楽しい体験が今、ストリーミング配信されています。"}, {"type": "subtitle", "time": 13886.229, "timestamp": "03:51:26", "text": "えっと、悪い日って何ですか？"}, {"type": "subtitle", "time": 13889.99, "timestamp": "03:51:29", "text": "あなたにとって、どんな日が辛かったですか？"}, {"type": "subtitle", "time": 13892.87, "timestamp": "03:51:32", "text": "はぁ？私にとって、もしずっと昔に遡るなら"}, {"type": "subtitle", "time": 13895.67, "timestamp": "03:51:35", "text": "私が始めたのは、"}, {"type": "subtitle", "time": 13901.91, "timestamp": "03:51:41", "text": "2019年頃だったかな。最悪な日が1日。"}, {"type": "subtitle", "time": 13905.189, "timestamp": "03:51:45", "text": "うん。 29"}, {"type": "subtitle", "time": 13906.95, "timestamp": "03:51:46", "text": "誰も私を見張っていなかったんだよ。"}, {"type": "subtitle", "time": 13909.91, "timestamp": "03:51:49", "text": "だから私は完全に一人ぼっちだったんです。私はこう思った"}, {"type": "subtitle", "time": 13913.67, "timestamp": "03:51:53", "text": "Twitchのあのストリーマーたち"}, {"type": "subtitle", "time": 13918.87, "timestamp": "03:51:58", "text": "ゼロ人か1人くらいの人がいて、"}]
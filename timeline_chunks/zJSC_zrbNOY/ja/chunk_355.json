[{"type": "subtitle", "time": 21301.11, "timestamp": "05:55:01", "text": "それが理由です。"}, {"type": "subtitle", "time": 21303.51, "timestamp": "05:55:03", "text": "2Dの作業はまだ始めていない"}, {"type": "subtitle", "time": 21308.39, "timestamp": "05:55:08", "text": "モデルみたいなアート、だって、知ってるよ"}, {"type": "subtitle", "time": 21312.47, "timestamp": "05:55:12", "text": "レイヤーをたくさん重ねる必要がある"}, {"type": "subtitle", "time": 21314.23, "timestamp": "05:55:14", "text": "なぜなら、すべては異なる"}, {"type": "subtitle", "time": 21316.948, "timestamp": "05:55:16", "text": "レイヤーと、えっと、ある程度は"}, {"type": "subtitle", "time": 21318.628, "timestamp": "05:55:18", "text": "フォルダも全部入っています。そして私はただ"}, {"type": "subtitle", "time": 21321.83, "timestamp": "05:55:21", "text": "理解したいのですが"}, {"type": "subtitle", "time": 21326.23, "timestamp": "05:55:26", "text": "まるで赤ちゃんの一歩のように。"}, {"type": "subtitle", "time": 21329.19, "timestamp": "05:55:29", "text": "うん。だって、私が絵文字を作るときって、"}, {"type": "subtitle", "time": 21331.91, "timestamp": "05:55:31", "text": "2、3層はちょうど"}, {"type": "subtitle", "time": 21335.43, "timestamp": "05:55:35", "text": "すべてはそこで行われる"}, {"type": "subtitle", "time": 21337.11, "timestamp": "05:55:37", "text": "まだ"}, {"type": "subtitle", "time": 21338.628, "timestamp": "05:55:38", "text": "なぜなら"}, {"type": "subtitle", "time": 21340.788, "timestamp": "05:55:40", "text": "レイヤーが多すぎて"}, {"type": "subtitle", "time": 21343.91, "timestamp": "05:55:43", "text": "もの。私はペンタブレットを手に入れ、それから"}, {"type": "subtitle", "time": 21345.83, "timestamp": "05:55:45", "text": "私は自分が使っていることに気づいた"}, {"type": "subtitle", "time": 21348.868, "timestamp": "05:55:48", "text": "私のスマホは絵を描くのにとても役立ちます。だから私は"}, {"type": "subtitle", "time": 21351.51, "timestamp": "05:55:51", "text": "慣れているよ、ほら、私が"}, {"type": "subtitle", "time": 21354.708, "timestamp": "05:55:54", "text": "私がやるように、画面上でもやってみてください。"}, {"type": "subtitle", "time": 21356.788, "timestamp": "05:55:56", "text": "錠剤。私はそうしなければならなかった、私はまだ手に入れようとしている"}]
[{"type": "subtitle", "time": 17463.35, "timestamp": "04:51:03", "text": "星座と星と宇宙"}, {"type": "subtitle", "time": 17467.27, "timestamp": "04:51:07", "text": "そしてもう一人は、ええと、彼女もYouTuberです。"}, {"type": "subtitle", "time": 17470.47, "timestamp": "04:51:10", "text": "彼女はポラス出身の企業系ユーチューバーで、"}, {"type": "subtitle", "time": 17473.11, "timestamp": "04:51:13", "text": "彼女は卒業した。でも、彼女の名前は"}, {"type": "subtitle", "time": 17477.67, "timestamp": "04:51:17", "text": "ズチ・アザー。それでズチは、彼女は"}, {"type": "subtitle", "time": 17481.19, "timestamp": "04:51:21", "text": "性格と、彼女はまた"}, {"type": "subtitle", "time": 17484.23, "timestamp": "04:51:24", "text": "あらゆるポで私についてすべてが"}, {"type": "subtitle", "time": 17487.75, "timestamp": "04:51:27", "text": "えっと、彼女は柔らかい方を選んだんです"}, {"type": "subtitle", "time": 17491.11, "timestamp": "04:51:31", "text": "パレットって、えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 17495.43, "timestamp": "04:51:35", "text": "それ？えっと、名前を忘れました。ああ、神様。"}, {"type": "subtitle", "time": 17498.628, "timestamp": "04:51:38", "text": "色にはパステル調で、"}, {"type": "subtitle", "time": 17501.83, "timestamp": "04:51:41", "text": "すべて。そう、それが"}, {"type": "subtitle", "time": 17505.51, "timestamp": "04:51:45", "text": "モデル"}, {"type": "subtitle", "time": 17508.31, "timestamp": "04:51:48", "text": "jocknik はデザインか何かを持っている"}, {"type": "subtitle", "time": 17511.59, "timestamp": "04:51:51", "text": "それ以来、その人物像は変わっていません。その後"}, {"type": "subtitle", "time": 17515.91, "timestamp": "04:51:55", "text": "その後、ファンアートのようなものを手に入れました。"}, {"type": "subtitle", "time": 17518.788, "timestamp": "04:51:58", "text": "とてもきれいで、"}]
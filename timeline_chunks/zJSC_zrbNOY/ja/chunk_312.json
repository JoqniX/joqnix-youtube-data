[{"type": "subtitle", "time": 18721.35, "timestamp": "05:12:01", "text": "基本的に私が以前は"}, {"type": "subtitle", "time": 18722.868, "timestamp": "05:12:02", "text": "幼稚園の先生として数年"}, {"type": "subtitle", "time": 18726.07, "timestamp": "05:12:06", "text": "年。そしてこれはクラスが"}, {"type": "subtitle", "time": 18729.27, "timestamp": "05:12:09", "text": "子供たちは授業中にそうする"}, {"type": "subtitle", "time": 18730.788, "timestamp": "05:12:10", "text": "バスが迎えに来る前に終わる"}, {"type": "subtitle", "time": 18733.51, "timestamp": "05:12:13", "text": "それらを拾い上げ、花を摘むだろう"}, {"type": "subtitle", "time": 18736.15, "timestamp": "05:12:16", "text": "それは中庭にあり、彼らは"}, {"type": "subtitle", "time": 18739.51, "timestamp": "05:12:19", "text": "来て、それを私の髪につけてください。による"}, {"type": "subtitle", "time": 18742.39, "timestamp": "05:12:22", "text": "結局、私の髪は"}, {"type": "subtitle", "time": 18744.55, "timestamp": "05:12:24", "text": "花でいっぱい。"}, {"type": "subtitle", "time": 18749.43, "timestamp": "05:12:29", "text": "とてもかわいい。でも、低レベルなので、そのままにしておきました"}, {"type": "subtitle", "time": 18752.788, "timestamp": "05:12:32", "text": "単純に、えっと、私はただ忘れっぽいだけです"}, {"type": "subtitle", "time": 18760.31, "timestamp": "05:12:40", "text": "うん。そして、目的はまさに"}, {"type": "subtitle", "time": 18762.708, "timestamp": "05:12:42", "text": "それは私に多くの自由を与えてくれます"}, {"type": "subtitle", "time": 18765.59, "timestamp": "05:12:45", "text": "物忘れがひどい。私は伝承を変えることができます"}, {"type": "subtitle", "time": 18768.788, "timestamp": "05:12:48", "text": "私が望む時にいつでも。"}, {"type": "subtitle", "time": 18770.55, "timestamp": "05:12:50", "text": "うん。"}, {"type": "subtitle", "time": 18773.75, "timestamp": "05:12:53", "text": "レイユ、どうして私にそんなことをするの？"}, {"type": "subtitle", "time": 18777.27, "timestamp": "05:12:57", "text": "誕生日おめでとう、ラユ。何てことだ。"}, {"type": "subtitle", "time": 18779.59, "timestamp": "05:12:59", "text": "お誕生日おめでとう。公平。今の発言は撤回します。"}]
[{"type": "subtitle", "time": 13440.309, "timestamp": "03:44:00", "text": "複数のuhストリーマー向けのuツール"}, {"type": "subtitle", "time": 13442.95, "timestamp": "03:44:02", "text": "グッズチャットのようにマルチリームして"}, {"type": "subtitle", "time": 13445.99, "timestamp": "03:44:05", "text": "すべて順調です。だから彼は宣伝していた"}, {"type": "subtitle", "time": 13449.75, "timestamp": "03:44:09", "text": "そういうことなど。そして今はたくさん"}, {"type": "subtitle", "time": 13451.59, "timestamp": "03:44:11", "text": "ほとんどの人は、より大きなストリーマーは"}, {"type": "subtitle", "time": 13454.15, "timestamp": "03:44:14", "text": "キックする動きとか、そういうこと全部。今彼は"}, {"type": "subtitle", "time": 13457.91, "timestamp": "03:44:17", "text": "彼は昨日か何かでBANされたらしい"}, {"type": "subtitle", "time": 13461.59, "timestamp": "03:44:21", "text": "最近。それは"}, {"type": "subtitle", "time": 13464.309, "timestamp": "03:44:24", "text": "なぜなら、TikTokのようなものがあったから"}, {"type": "subtitle", "time": 13467.75, "timestamp": "03:44:27", "text": "寄付またはストリーム上の何らかのアラート"}, {"type": "subtitle", "time": 13471.189, "timestamp": "03:44:31", "text": "そして、Twitch は「うん、君は"}, {"type": "subtitle", "time": 13475.269, "timestamp": "03:44:35", "text": "同時配信のため禁止されました。"}, {"type": "subtitle", "time": 13477.75, "timestamp": "03:44:37", "text": "まるで、単純なキャスティング規則を破るようなものだ。"}, {"type": "subtitle", "time": 13480.63, "timestamp": "03:44:40", "text": "だから、あなたはそうすべきではない"}, {"type": "subtitle", "time": 13484.469, "timestamp": "03:44:44", "text": "寄付やその他に関する表示や反応"}, {"type": "subtitle", "time": 13488.15, "timestamp": "03:44:48", "text": "他のプラットフォームからのアラートのようなものと"}, {"type": "subtitle", "time": 13491.03, "timestamp": "03:44:51", "text": "もの。つまり、外部の第三者のもの、"}, {"type": "subtitle", "time": 13493.59, "timestamp": "03:44:53", "text": "右？ TikTokやStreamlabsのように"}, {"type": "subtitle", "time": 13497.83, "timestamp": "03:44:57", "text": "またはStreamElements、それらすべてのもの"}]
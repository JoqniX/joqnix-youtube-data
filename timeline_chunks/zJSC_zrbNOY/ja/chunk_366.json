[{"type": "subtitle", "time": 21960.628, "timestamp": "06:06:00", "text": "A"}, {"type": "subtitle", "time": 21963.83, "timestamp": "06:06:03", "text": "待って、あなたは外食をよくするの？"}, {"type": "subtitle", "time": 21968.868, "timestamp": "06:06:08", "text": "手作りの料理がお好みですか？えっと、つまり"}, {"type": "subtitle", "time": 21971.35, "timestamp": "06:06:11", "text": "えっと、最近は家で食べることが増えました"}, {"type": "subtitle", "time": 21973.03, "timestamp": "06:06:13", "text": "食べ物。私は好きです、あるいは私はただ"}, {"type": "subtitle", "time": 21975.43, "timestamp": "06:06:15", "text": "料理をするのは、私がしたいものなどです"}, {"type": "subtitle", "time": 21980.31, "timestamp": "06:06:20", "text": "自分自身を食べる。うん。でも、ちょっと思うんだけど"}, {"type": "subtitle", "time": 21983.11, "timestamp": "06:06:23", "text": "少し前に私は"}, {"type": "subtitle", "time": 21987.03, "timestamp": "06:06:27", "text": "えっと、ジャンクフードとか外みたいな感じだけど、ちょっと"}, {"type": "subtitle", "time": 21989.19, "timestamp": "06:06:29", "text": "私はそれを着けている、えっと、私の"}, {"type": "subtitle", "time": 21991.19, "timestamp": "06:06:31", "text": "大学もね、だって君も行くだろうから"}, {"type": "subtitle", "time": 21995.19, "timestamp": "06:06:35", "text": "私の授業のために、そして、"}, {"type": "subtitle", "time": 21998.47, "timestamp": "06:06:38", "text": "物事の間隔が短くなるのとよく似ています。それで"}, {"type": "subtitle", "time": 22001.75, "timestamp": "06:06:41", "text": "私は時々昼食を抜いたり、"}, {"type": "subtitle", "time": 22003.51, "timestamp": "06:06:43", "text": "手に入るものは何でも食べる"}, {"type": "subtitle", "time": 22005.03, "timestamp": "06:06:45", "text": "食堂はたいしたものではなかった。これは"}, {"type": "subtitle", "time": 22014.868, "timestamp": "06:06:54", "text": "それで、そういうことがよく起こって、それから"}, {"type": "subtitle", "time": 22018.548, "timestamp": "06:06:58", "text": "すべてと共に"}]
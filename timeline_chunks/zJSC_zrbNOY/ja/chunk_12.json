[{"type": "subtitle", "time": 720.069, "timestamp": "00:12:00", "text": "どこですか？"}, {"type": "subtitle", "time": 724.069, "timestamp": "00:12:04", "text": "えっと、この人に話しかけてください。"}, {"type": "subtitle", "time": 726.949, "timestamp": "00:12:06", "text": "うん、ちょっと高いね。待って、"}, {"type": "subtitle", "time": 730.069, "timestamp": "00:12:10", "text": "配信でプレイしても問題ないと思う。私"}, {"type": "subtitle", "time": 731.75, "timestamp": "00:12:11", "text": "大丈夫じゃないのはわかってるけど、"}, {"type": "subtitle", "time": 734.79, "timestamp": "00:12:14", "text": "ご自身で聞いてみてください。わかった。どうやって"}, {"type": "subtitle", "time": 737.67, "timestamp": "00:12:17", "text": "これは深く、そして困難な問題だ。はい、では"}, {"type": "subtitle", "time": 740.55, "timestamp": "00:12:20", "text": "これを私のストリームにルーティングします"}, {"type": "subtitle", "time": 776.15, "timestamp": "00:12:56", "text": "すごく速い。"}, {"type": "subtitle", "time": 778.949, "timestamp": "00:12:58", "text": "難しいですね。速い。"}]
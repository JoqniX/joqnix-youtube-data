[{"type": "subtitle", "time": 1083.75, "timestamp": "00:18:03", "text": "ええ、そしてそれは良いことだと思います"}, {"type": "subtitle", "time": 1086.87, "timestamp": "00:18:06", "text": "何かしたいと思ってるんだよね？"}, {"type": "subtitle", "time": 1090.87, "timestamp": "00:18:10", "text": "何かをしたいとか、そういうこと。だから私は"}, {"type": "subtitle", "time": 1094.95, "timestamp": "00:18:14", "text": "思ったんだけど、ねえ、知ってる？"}, {"type": "subtitle", "time": 1097.51, "timestamp": "00:18:17", "text": "私は、"}, {"type": "subtitle", "time": 1099.59, "timestamp": "00:18:19", "text": "Discordサーバー。それは"}, {"type": "subtitle", "time": 1101.83, "timestamp": "00:18:21", "text": "私"}, {"type": "subtitle", "time": 1105.029, "timestamp": "00:18:25", "text": "ある種の憎しみ。えっと"}, {"type": "subtitle", "time": 1109.27, "timestamp": "00:18:29", "text": "えっと、私は、えっと、方法を見つけようと考えていました"}, {"type": "subtitle", "time": 1112.71, "timestamp": "00:18:32", "text": "自分で解決するしかない、だって方法が見当たらないんだもん"}, {"type": "subtitle", "time": 1118.789, "timestamp": "00:18:38", "text": "解決できる方法について"}, {"type": "subtitle", "time": 1122.31, "timestamp": "00:18:42", "text": "なぜなら、"}, {"type": "subtitle", "time": 1125.19, "timestamp": "00:18:45", "text": "プロのボットとか、そういうのはどうでもいいよ"}, {"type": "subtitle", "time": 1132.87, "timestamp": "00:18:52", "text": "シーンを切り替えました。わかった。おお"}, {"type": "subtitle", "time": 1136.23, "timestamp": "00:18:56", "text": "神。私は何をしているのか？"}, {"type": "subtitle", "time": 1139.909, "timestamp": "00:18:59", "text": "ああ、わかった。ええと、それはそれを解決するのに役立つかもしれません。それで、"}]
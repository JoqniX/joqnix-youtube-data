[{"type": "subtitle", "time": 14102.389, "timestamp": "03:55:02", "text": "なぜ私にこのことを話すのですか？私は"}, {"type": "subtitle", "time": 14104.55, "timestamp": "03:55:04", "text": "「必要だ」と思った。「ああ、"}, {"type": "subtitle", "time": 14107.51, "timestamp": "03:55:07", "text": "ランダムな配信者がメタ配信者と出会った。"}, {"type": "subtitle", "time": 14109.429, "timestamp": "03:55:09", "text": "だから彼らはネットワークを作ったり、"}, {"type": "subtitle", "time": 14111.83, "timestamp": "03:55:11", "text": "私を知るためとか、そういうこと。"}, {"type": "subtitle", "time": 14114.87, "timestamp": "03:55:14", "text": "でも、GFXボールはたくさんあって"}, {"type": "subtitle", "time": 14117.11, "timestamp": "03:55:17", "text": "Discordで。たとえあなたが"}, {"type": "subtitle", "time": 14120.07, "timestamp": "03:55:20", "text": "TwitchのDiscord、"}, {"type": "subtitle", "time": 14123.349, "timestamp": "03:55:23", "text": "私が受け取る友達リクエストの半分は"}, {"type": "subtitle", "time": 14126.15, "timestamp": "03:55:26", "text": "現時点では、そうなっている。ええ、私は"}, {"type": "subtitle", "time": 14129.429, "timestamp": "03:55:29", "text": "プライバシー設定をオンにする必要がありました"}, {"type": "subtitle", "time": 14132.309, "timestamp": "03:55:32", "text": "私のDiscordアカウントでは、"}, {"type": "subtitle", "time": 14135.11, "timestamp": "03:55:35", "text": "DMを送っていただいても構いません。私もそうしたかったのですが"}, {"type": "subtitle", "time": 14137.59, "timestamp": "03:55:37", "text": "脚本執筆の問題点は"}, {"type": "subtitle", "time": 14140.15, "timestamp": "03:55:40", "text": "そして、私が書く他の創作作品と同じように"}, {"type": "subtitle", "time": 14142.309, "timestamp": "03:55:42", "text": "私は、"}, {"type": "subtitle", "time": 14144.79, "timestamp": "03:55:44", "text": "連絡も取ります。ああ、だから私は"}, {"type": "subtitle", "time": 14146.79, "timestamp": "03:55:46", "text": "オープン"}, {"type": "subtitle", "time": 14150.469, "timestamp": "03:55:50", "text": "なぜなら、もし私がTwitterや"}, {"type": "subtitle", "time": 14152.95, "timestamp": "03:55:52", "text": "Redditでは、私が"}, {"type": "subtitle", "time": 14157.83, "timestamp": "03:55:57", "text": "間に合わないかもしれない。うん。つまり"}]
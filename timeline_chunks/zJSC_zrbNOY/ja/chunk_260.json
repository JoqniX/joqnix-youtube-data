[{"type": "subtitle", "time": 15601.11, "timestamp": "04:20:01", "text": "経験、ということでしょうか。ええ、そういう意味です"}, {"type": "subtitle", "time": 15602.87, "timestamp": "04:20:02", "text": "それは理解できます。"}, {"type": "subtitle", "time": 15606.07, "timestamp": "04:20:06", "text": "誰もが異なる期待を持っている"}, {"type": "subtitle", "time": 15610.07, "timestamp": "04:20:10", "text": "ストリーミングや一般的な"}, {"type": "subtitle", "time": 15613.51, "timestamp": "04:20:13", "text": "オンラインでの活動も、私は"}, {"type": "subtitle", "time": 15615.349, "timestamp": "04:20:15", "text": "例えば"}, {"type": "subtitle", "time": 15617.51, "timestamp": "04:20:17", "text": "えっと、さまざまな経験があり、私は好きです"}, {"type": "subtitle", "time": 15619.99, "timestamp": "04:20:19", "text": "とても楽しんでいますが、同時に"}, {"type": "subtitle", "time": 15622.149, "timestamp": "04:20:22", "text": "なんだか自分の義務のように感じます"}, {"type": "subtitle", "time": 15623.83, "timestamp": "04:20:23", "text": "私のコミュニティが"}, {"type": "subtitle", "time": 15639.269, "timestamp": "04:20:39", "text": "知ってるよ、私はもっと、えっと"}, {"type": "subtitle", "time": 15641.429, "timestamp": "04:20:41", "text": "アクティブで、より多くの人々と交流することを好む"}, {"type": "subtitle", "time": 15642.95, "timestamp": "04:20:42", "text": "人々は、しかし同時に私はただ"}, {"type": "subtitle", "time": 15645.51, "timestamp": "04:20:45", "text": "まあ、ちょっと気をつけて"}, {"type": "subtitle", "time": 15647.63, "timestamp": "04:20:47", "text": "私がどのようにそれを行うか。"}, {"type": "subtitle", "time": 15654.55, "timestamp": "04:20:54", "text": "「あぁ、つまずいちゃった」って感じになったことありますか？"}, {"type": "subtitle", "time": 15658.229, "timestamp": "04:20:58", "text": "私の言葉を信じてください。今まで何かありましたか？"}]
[{"type": "subtitle", "time": 12541.19, "timestamp": "03:29:01", "text": "英語文学と地元のもの"}, {"type": "subtitle", "time": 12542.79, "timestamp": "03:29:02", "text": "大学？"}, {"type": "subtitle", "time": 12546.15, "timestamp": "03:29:06", "text": "はい、そうしました。それは私の学士号のようなものでした"}, {"type": "subtitle", "time": 12548.15, "timestamp": "03:29:08", "text": "主題。それは心理学のようなもので、"}, {"type": "subtitle", "time": 12550.55, "timestamp": "03:29:10", "text": "社会学と英文学。私は"}, {"type": "subtitle", "time": 12553.19, "timestamp": "03:29:13", "text": "実際にそうするのは、私が書くためです"}, {"type": "subtitle", "time": 12555.67, "timestamp": "03:29:15", "text": "私自身の物語とか、そういうもの。だから私は思った"}, {"type": "subtitle", "time": 12557.99, "timestamp": "03:29:17", "text": "それは簡単に手に入れる方法の一つです"}, {"type": "subtitle", "time": 12561.269, "timestamp": "03:29:21", "text": "程度。では、これでいきます。ああ、なんてことだ"}, {"type": "subtitle", "time": 12563.99, "timestamp": "03:29:23", "text": "ああ、まるで歴史を勉強しているみたいだ"}, {"type": "subtitle", "time": 12566.87, "timestamp": "03:29:26", "text": "何て言うんだっけ"}, {"type": "subtitle", "time": 12568.87, "timestamp": "03:29:28", "text": "イギリス文学"}, {"type": "subtitle", "time": 12574.309, "timestamp": "03:29:34", "text": "16世紀、17世紀、まさにその通り"}, {"type": "subtitle", "time": 12577.74, "timestamp": "03:29:37", "text": "ええ、それはそれでいっぱいです"}, {"type": "subtitle", "time": 12580.63, "timestamp": "03:29:40", "text": "[音楽]"}, {"type": "subtitle", "time": 12582.79, "timestamp": "03:29:42", "text": "たくさんの物"}, {"type": "subtitle", "time": 12585.349, "timestamp": "03:29:45", "text": "でも、それはあなたにとって次のような意味で役立ちましたか？"}, {"type": "subtitle", "time": 12588.07, "timestamp": "03:29:48", "text": "作家がどのように考え、"}, {"type": "subtitle", "time": 12589.67, "timestamp": "03:29:49", "text": "すべて"}, {"type": "subtitle", "time": 12593.99, "timestamp": "03:29:53", "text": "つまり、もしあなたが"}, {"type": "subtitle", "time": 12596.309, "timestamp": "03:29:56", "text": "えっと"}, {"type": "subtitle", "time": 12599.03, "timestamp": "03:29:59", "text": "そうですね"}]
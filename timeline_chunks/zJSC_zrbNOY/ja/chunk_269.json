[{"type": "subtitle", "time": 16141.83, "timestamp": "04:29:01", "text": "彼らが試みた友人たち"}, {"type": "subtitle", "time": 16144.71, "timestamp": "04:29:04", "text": "ゲストにも質問してください。"}, {"type": "subtitle", "time": 16146.71, "timestamp": "04:29:06", "text": "相互フォローで、なぜそうしなかったのかと尋ねた"}, {"type": "subtitle", "time": 16149.99, "timestamp": "04:29:09", "text": "ジョックを守れ、彼はジョックが繊細だと知っていた。"}, {"type": "subtitle", "time": 16153.83, "timestamp": "04:29:13", "text": "こういうこととか、ああいうこととか。"}, {"type": "subtitle", "time": 16157.349, "timestamp": "04:29:17", "text": "そして後になって私はその男を追放しなければならなかった"}, {"type": "subtitle", "time": 16161.51, "timestamp": "04:29:21", "text": "DiscordとTwitchで彼はこう言った"}, {"type": "subtitle", "time": 16164.149, "timestamp": "04:29:24", "text": "私がやったの？それから私は彼に"}, {"type": "subtitle", "time": 16166.79, "timestamp": "04:29:26", "text": "あなたが何をしたかについての詳細な段落"}, {"type": "subtitle", "time": 16169.75, "timestamp": "04:29:29", "text": "などなど。それはまるで"}, {"type": "subtitle", "time": 16173.349, "timestamp": "04:29:33", "text": "悪い経験だったし、それ以来私は"}, {"type": "subtitle", "time": 16175.99, "timestamp": "04:29:35", "text": "私は本当に慎重です"}, {"type": "subtitle", "time": 16179.429, "timestamp": "04:29:39", "text": "ええと、視聴者参加型となると"}, {"type": "subtitle", "time": 16183.03, "timestamp": "04:29:43", "text": "ストリームは今、私は好きになり始めました"}, {"type": "subtitle", "time": 16188.229, "timestamp": "04:29:48", "text": "嫌いな人たちを"}, {"type": "subtitle", "time": 16190.71, "timestamp": "04:29:50", "text": "私のストリームで知って、いいねしたり、一緒に遊んだりしましょう"}, {"type": "subtitle", "time": 16192.87, "timestamp": "04:29:52", "text": "たとえ私が彼らに私と遊ばせたとしても"}, {"type": "subtitle", "time": 16195.59, "timestamp": "04:29:55", "text": "ゲーム内にボイスチャット機能が搭載されます"}, {"type": "subtitle", "time": 16197.75, "timestamp": "04:29:57", "text": "そして、まさにそれが起こったのです。彼は"}]
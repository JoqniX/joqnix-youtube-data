[{"type": "subtitle", "time": 3242.23, "timestamp": "00:54:02", "text": "ダイナミックに変化することを知ってください"}, {"type": "subtitle", "time": 3245.67, "timestamp": "00:54:05", "text": "時間やサムネイルなど、そういう感じです。おお"}, {"type": "subtitle", "time": 3248.069, "timestamp": "00:54:08", "text": "我が神よ。私は文字通りショックを受けました"}, {"type": "subtitle", "time": 3252.069, "timestamp": "00:54:12", "text": "電源回路。ああ、"}, {"type": "subtitle", "time": 3255.109, "timestamp": "00:54:15", "text": "何てことだ。"}, {"type": "subtitle", "time": 3275.349, "timestamp": "00:54:35", "text": "私は足をテーブルの上に置いた。"}, {"type": "subtitle", "time": 3278.79, "timestamp": "00:54:38", "text": "私は椅子にだらりと座っていた。"}, {"type": "subtitle", "time": 3281.829, "timestamp": "00:54:41", "text": "サッカーはそこにあった。開放的な感じ"}, {"type": "subtitle", "time": 3283.51, "timestamp": "00:54:43", "text": "なぜなら"}, {"type": "subtitle", "time": 3292.309, "timestamp": "00:54:52", "text": "靴下、えっと、プラグみたいなやつ"}, {"type": "subtitle", "time": 3295.75, "timestamp": "00:54:55", "text": "体が壊れた"}, {"type": "subtitle", "time": 3299.19, "timestamp": "00:54:59", "text": "そしてそれは開いていて、内部の配線がむき出しになっていた。"}]
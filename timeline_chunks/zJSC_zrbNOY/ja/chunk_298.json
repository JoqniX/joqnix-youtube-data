[{"type": "subtitle", "time": 17880.55, "timestamp": "04:58:00", "text": "私が描いたYouTuberの子供に力を注ぎました"}, {"type": "subtitle", "time": 17883.19, "timestamp": "04:58:03", "text": "給料をもらったのに、何もかもがうまくいかなかった"}, {"type": "subtitle", "time": 17885.27, "timestamp": "04:58:05", "text": "彼らに何が起こったのか、そして"}, {"type": "subtitle", "time": 17887.83, "timestamp": "04:58:07", "text": "何が起こったのか調べて"}, {"type": "subtitle", "time": 17890.708, "timestamp": "04:58:10", "text": "たとえそれが後であっても、たとえそれが後であっても、"}, {"type": "subtitle", "time": 17893.43, "timestamp": "04:58:13", "text": "年とか話せないこと"}, {"type": "subtitle", "time": 17896.07, "timestamp": "04:58:16", "text": "その期間を通してアーティストと共に"}, {"type": "subtitle", "time": 17898.708, "timestamp": "04:58:18", "text": "多くの制限があったので"}, {"type": "subtitle", "time": 17902.55, "timestamp": "04:58:22", "text": "私は「ああ、もし私が"}, {"type": "subtitle", "time": 17905.11, "timestamp": "04:58:25", "text": "2年後に彼らが戻ってくるのを待つか、"}, {"type": "subtitle", "time": 17907.75, "timestamp": "04:58:27", "text": "3年くらい経つと、もちろん私は"}, {"type": "subtitle", "time": 17910.868, "timestamp": "04:58:30", "text": "そのオプション、または忘れるオプション、または"}, {"type": "subtitle", "time": 17914.47, "timestamp": "04:58:34", "text": "もう一つの選択肢は"}, {"type": "subtitle", "time": 17917.99, "timestamp": "04:58:37", "text": "頑固に学び、そのために戦う"}, {"type": "subtitle", "time": 17920.07, "timestamp": "04:58:40", "text": "自分でやるのではなく、"}, {"type": "subtitle", "time": 17922.708, "timestamp": "04:58:42", "text": "その他。えっと、彼らはあなたにアートを与えました、あなたは"}, {"type": "subtitle", "time": 17924.948, "timestamp": "04:58:44", "text": "美術品代は返済するべきですよね？"}, {"type": "subtitle", "time": 17926.708, "timestamp": "04:58:46", "text": "そして、すべてのリギングが完了する"}, {"type": "subtitle", "time": 17929.51, "timestamp": "04:58:49", "text": "あなたとすべて"}, {"type": "subtitle", "time": 17933.35, "timestamp": "04:58:53", "text": "そんな感じ。そして私はアートが"}, {"type": "subtitle", "time": 17936.628, "timestamp": "04:58:56", "text": "とても良い。だから、"}]
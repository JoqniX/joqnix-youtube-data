[{"type": "subtitle", "time": 14460.229, "timestamp": "04:01:00", "text": "そして私は、"}, {"type": "subtitle", "time": 14464.15, "timestamp": "04:01:04", "text": "えっと、あなたがやらなきゃいけない時って、"}, {"type": "subtitle", "time": 14468.389, "timestamp": "04:01:08", "text": "非生物に関する性別"}, {"type": "subtitle", "time": 14470.71, "timestamp": "04:01:10", "text": "性別に関する事柄。だから、ご存知のように"}, {"type": "subtitle", "time": 14475.349, "timestamp": "04:01:15", "text": "えっと、鍵と車のようなもの"}, {"type": "subtitle", "time": 14477.99, "timestamp": "04:01:17", "text": "テーブルのような、生命を持たないもの"}, {"type": "subtitle", "time": 14480.07, "timestamp": "04:01:20", "text": "あるいは何か、そして私はただそれを得るだけです"}, {"type": "subtitle", "time": 14482.57, "timestamp": "04:01:22", "text": "時々混乱する。"}, {"type": "subtitle", "time": 14488.63, "timestamp": "04:01:28", "text": "ジョーさん、あなたはインドのどの地域出身ですか？あなたはできる"}, {"type": "subtitle", "time": 14491.34, "timestamp": "04:01:31", "text": "私は南部出身だと言ってください。"}, {"type": "subtitle", "time": 14501.269, "timestamp": "04:01:41", "text": "あなたは自分の配信者に自分がどこにいるか伝えましたか？"}, {"type": "subtitle", "time": 14503.83, "timestamp": "04:01:43", "text": "や、物、あるいはそれを保管するようなものですか？"}, {"type": "subtitle", "time": 14508.309, "timestamp": "04:01:48", "text": "北部のような地域ですか？えっと、ただ"}, {"type": "subtitle", "time": 14510.309, "timestamp": "04:01:50", "text": "まるで私が住んでいる場所のように"}, {"type": "subtitle", "time": 14519.189, "timestamp": "04:01:59", "text": "ああ、つまり、えっと、要点は、えっと、でも"}]
[{"type": "subtitle", "time": 16501.349, "timestamp": "04:35:01", "text": "ええ、こういう人たちが"}, {"type": "subtitle", "time": 16504.869, "timestamp": "04:35:04", "text": "注目を集めようとする人、"}, {"type": "subtitle", "time": 16507.75, "timestamp": "04:35:07", "text": "準社会的。私が学んだすべての用語"}, {"type": "subtitle", "time": 16511.029, "timestamp": "04:35:11", "text": "ストリーミングなどを通じて学ばなければならなかった"}, {"type": "subtitle", "time": 16515.429, "timestamp": "04:35:15", "text": "まるで私がこんなことがあったなんて知らなかったみたいに。"}, {"type": "subtitle", "time": 16519.75, "timestamp": "04:35:19", "text": "うん。私が～をやめて以来"}, {"type": "subtitle", "time": 16522.39, "timestamp": "04:35:22", "text": "私のサーバー上で。私は時々"}, {"type": "subtitle", "time": 16525.429, "timestamp": "04:35:25", "text": "そこにいるけど、私は決して近づこうとはしない"}, {"type": "subtitle", "time": 16529.349, "timestamp": "04:35:29", "text": "誰かと一緒に、あるいは彼らと話して、"}, {"type": "subtitle", "time": 16533.269, "timestamp": "04:35:33", "text": "DMとか色々、だってこれは"}, {"type": "subtitle", "time": 16537.029, "timestamp": "04:35:37", "text": "目を見開かされるような出来事であり、トラウマでもあると思う。"}, {"type": "subtitle", "time": 16539.99, "timestamp": "04:35:39", "text": "そう、今は安全でなければならない、私の精神"}, {"type": "subtitle", "time": 16542.31, "timestamp": "04:35:42", "text": "健康も重要だ"}, {"type": "subtitle", "time": 16544.869, "timestamp": "04:35:44", "text": "その多くは対処しなければならない"}, {"type": "subtitle", "time": 16551.429, "timestamp": "04:35:51", "text": "まるで旅のようだ。あなた、あなた"}, {"type": "subtitle", "time": 16554.551, "timestamp": "04:35:54", "text": "厳しい苦難を経験し、また"}, {"type": "subtitle", "time": 16557.99, "timestamp": "04:35:57", "text": "そこから強い精神力を身につける"}]
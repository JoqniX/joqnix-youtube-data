[{"type": "subtitle", "time": 841.67, "timestamp": "00:14:01", "text": "皆さん、お元気ですか？こんにちは。"}, {"type": "subtitle", "time": 848.79, "timestamp": "00:14:08", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 858.629, "timestamp": "00:14:18", "text": "最近の生活はどうですか？"}, {"type": "subtitle", "time": 862.389, "timestamp": "00:14:22", "text": "えっと、今来たばかりだと思います。"}, {"type": "subtitle", "time": 864.47, "timestamp": "00:14:24", "text": "えっと"}, {"type": "subtitle", "time": 869.75, "timestamp": "00:14:29", "text": "私は眠ってしまった。現在は"}, {"type": "subtitle", "time": 874.629, "timestamp": "00:14:34", "text": "今は、えっと"}, {"type": "subtitle", "time": 883.11, "timestamp": "00:14:43", "text": "今は5時半くらいですよね？"}, {"type": "subtitle", "time": 886.47, "timestamp": "00:14:46", "text": "7でのコラボレーション"}, {"type": "subtitle", "time": 889.35, "timestamp": "00:14:49", "text": "だから、1時間2時間、いや1時間30分くらいあるんだ"}, {"type": "subtitle", "time": 898.31, "timestamp": "00:14:58", "text": "えっと、ほんの少しの時間"}]
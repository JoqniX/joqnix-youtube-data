[{"type": "subtitle", "time": 20761.03, "timestamp": "05:46:01", "text": "ずっと昔のことだ。そして私は"}, {"type": "subtitle", "time": 20763.51, "timestamp": "05:46:03", "text": "懐かしい気分に浸れるもの"}, {"type": "subtitle", "time": 20766.15, "timestamp": "05:46:06", "text": "知ってはいたが、それを言葉で表現する方法を教えられる"}, {"type": "subtitle", "time": 20768.868, "timestamp": "05:46:08", "text": "その理由がわかるので、ずっと良いです"}, {"type": "subtitle", "time": 20771.27, "timestamp": "05:46:11", "text": "これと、その他すべて。だから私は、もしかしたら"}, {"type": "subtitle", "time": 20775.75, "timestamp": "05:46:15", "text": "試してみます。もしかしたら役に立つかも"}, {"type": "subtitle", "time": 20778.47, "timestamp": "05:46:18", "text": "私が日本にいる時にも役立つでしょう。"}, {"type": "subtitle", "time": 20781.51, "timestamp": "05:46:21", "text": "例えば、言語を終えた後"}, {"type": "subtitle", "time": 20784.548, "timestamp": "05:46:24", "text": "コースとその他応募できるものすべて"}, {"type": "subtitle", "time": 20786.548, "timestamp": "05:46:26", "text": "もし私が何もなかったら"}, {"type": "subtitle", "time": 20789.51, "timestamp": "05:46:29", "text": "音楽を追求して原因を作ったり、"}, {"type": "subtitle", "time": 20791.91, "timestamp": "05:46:31", "text": "何かあったよね、それで私は"}, {"type": "subtitle", "time": 20794.788, "timestamp": "05:46:34", "text": "これに挑戦して、彼らと話しました"}, {"type": "subtitle", "time": 20797.03, "timestamp": "05:46:37", "text": "ズームとか全部、うん"}, {"type": "subtitle", "time": 20799.51, "timestamp": "05:46:39", "text": "費用は65,000ドルで、すべて"}, {"type": "subtitle", "time": 20803.59, "timestamp": "05:46:43", "text": "私は「なんてこった、そんなこと知らなかった」と思いました。"}, {"type": "subtitle", "time": 20807.75, "timestamp": "05:46:47", "text": "これは高価なもの"}, {"type": "subtitle", "time": 20811.51, "timestamp": "05:46:51", "text": "えっと、それで私は「できますか？」と尋ねました"}, {"type": "subtitle", "time": 20814.23, "timestamp": "05:46:54", "text": "分割払いとその他すべて1ヶ月分"}, {"type": "subtitle", "time": 20816.15, "timestamp": "05:46:56", "text": "分割払い？彼らは同意した。彼らはまるで"}, {"type": "subtitle", "time": 20819.27, "timestamp": "05:46:59", "text": "もしあなたが同じことをするなら、"}]
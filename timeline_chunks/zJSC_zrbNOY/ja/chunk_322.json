[{"type": "subtitle", "time": 19323.91, "timestamp": "05:22:03", "text": "これは本当に信じられない。"}, {"type": "subtitle", "time": 19326.788, "timestamp": "05:22:06", "text": "うん、だって覚えてるよ、えっと"}, {"type": "subtitle", "time": 19329.27, "timestamp": "05:22:09", "text": "友人と一緒にビデオ会議に参加している"}, {"type": "subtitle", "time": 19333.27, "timestamp": "05:22:13", "text": "ホラーゲームをプレイしていて"}, {"type": "subtitle", "time": 19336.39, "timestamp": "05:22:16", "text": "私がちょっと、えっと、"}, {"type": "subtitle", "time": 19341.19, "timestamp": "05:22:21", "text": "マイクの音質が悪くてよかった。"}, {"type": "subtitle", "time": 19344.07, "timestamp": "05:22:24", "text": "私は叫んだが、誰も私が叫んだことを知らなかった"}, {"type": "subtitle", "time": 19350.948, "timestamp": "05:22:30", "text": "ディスコの騒音抑制。"}, {"type": "subtitle", "time": 19353.67, "timestamp": "05:22:33", "text": "うん。そしてそれはとてもとても"}, {"type": "subtitle", "time": 19356.23, "timestamp": "05:22:36", "text": "最近、あのマイクみたいなやつ"}, {"type": "subtitle", "time": 19359.75, "timestamp": "05:22:39", "text": "うーん、うーん、私の友達が手伝ってくれたように改善しました"}, {"type": "subtitle", "time": 19362.948, "timestamp": "05:22:42", "text": "私はそれを直すのが大好き"}, {"type": "subtitle", "time": 19365.43, "timestamp": "05:22:45", "text": "だって、その前はこんな感じだったんだ"}, {"type": "subtitle", "time": 19368.39, "timestamp": "05:22:48", "text": "みんなが私を"}, {"type": "subtitle", "time": 19370.47, "timestamp": "05:22:50", "text": "全開で、ただ彼らが"}, {"type": "subtitle", "time": 19374.708, "timestamp": "05:22:54", "text": "私の声が聞こえるはずだ。うん。でも、Discordでは"}, {"type": "subtitle", "time": 19377.43, "timestamp": "05:22:57", "text": "それでも、それは"}, {"type": "subtitle", "time": 19379.03, "timestamp": "05:22:59", "text": "みんな私に少し譲って"}]
[{"type": "subtitle", "time": 14400.87, "timestamp": "04:00:00", "text": "ルドラやジョーは"}, {"type": "subtitle", "time": 14404.07, "timestamp": "04:00:04", "text": "また、インド人ユーチューバーでもあるので、もしあなたが知らなかったら"}, {"type": "subtitle", "time": 14407.189, "timestamp": "04:00:07", "text": "既に知っている。こんにちは。"}, {"type": "subtitle", "time": 14419.59, "timestamp": "04:00:19", "text": "これについて。ああ、俺のことをジョックって呼んでくれてもいいよ"}, {"type": "subtitle", "time": 14422.95, "timestamp": "04:00:22", "text": "お好きなようにどうぞ。みんなは僕のことをジョックと呼ぶ"}, {"type": "subtitle", "time": 14428.71, "timestamp": "04:00:28", "text": "騎手のジョー。他に何か忘れていることはあるだろうか？"}, {"type": "subtitle", "time": 14430.79, "timestamp": "04:00:30", "text": "この時点では、どんな名前でも構いません"}, {"type": "subtitle", "time": 14437.03, "timestamp": "04:00:37", "text": "うん。"}, {"type": "subtitle", "time": 14446.63, "timestamp": "04:00:46", "text": "待って、あなたはヒンディー語が得意なの？待って、私は"}, {"type": "subtitle", "time": 14449.75, "timestamp": "04:00:49", "text": "あなたはヒンディー語が得意だと思っているでしょう？"}, {"type": "subtitle", "time": 14454.309, "timestamp": "04:00:54", "text": "うん。えっと、私はヒンディー語が上手に話せます。おお。"}, {"type": "subtitle", "time": 14456.469, "timestamp": "04:00:56", "text": "ヒンディー語の比較"}]
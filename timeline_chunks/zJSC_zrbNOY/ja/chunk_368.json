[{"type": "subtitle", "time": 22081.35, "timestamp": "06:08:01", "text": "オンラインで食べ物を注文できるなんて知らなかった。私"}, {"type": "subtitle", "time": 22084.39, "timestamp": "06:08:04", "text": "それは私にとって驚きでした。"}, {"type": "subtitle", "time": 22087.91, "timestamp": "06:08:07", "text": "食べ物の種類が本当にたくさんある。"}, {"type": "subtitle", "time": 22092.39, "timestamp": "06:08:12", "text": "オンラインで注文できます。私は「えっ？」って感じでした。あなた"}, {"type": "subtitle", "time": 22094.39, "timestamp": "06:08:14", "text": "ピザとか買えるよ。あなたはしない"}, {"type": "subtitle", "time": 22098.39, "timestamp": "06:08:18", "text": "ピザを食べたことがないんです。しかし"}, {"type": "subtitle", "time": 22101.27, "timestamp": "06:08:21", "text": "初めて、えっと、"}, {"type": "subtitle", "time": 22103.75, "timestamp": "06:08:23", "text": "家族が注文したんです。そうやって私は"}, {"type": "subtitle", "time": 22107.11, "timestamp": "06:08:27", "text": "試してみてください。 「うわあ、この"}, {"type": "subtitle", "time": 22109.75, "timestamp": "06:08:29", "text": "映画みたいに"}, {"type": "subtitle", "time": 22113.35, "timestamp": "06:08:33", "text": "インターネットはピザのようなものだ。"}, {"type": "subtitle", "time": 22116.15, "timestamp": "06:08:36", "text": "つまり、子供の頃は、"}, {"type": "subtitle", "time": 22119.43, "timestamp": "06:08:39", "text": "私の好きなものの大部分は家庭料理です"}, {"type": "subtitle", "time": 22121.83, "timestamp": "06:08:41", "text": "子供の頃は、自家栽培の食べ物をよく食べていました。"}, {"type": "subtitle", "time": 22124.788, "timestamp": "06:08:44", "text": "うん。それはもっと最近のことだった、君が外にいるように"}, {"type": "subtitle", "time": 22127.91, "timestamp": "06:08:47", "text": "食物摂取量が増加する。でもまあ、"}, {"type": "subtitle", "time": 22130.708, "timestamp": "06:08:50", "text": "それをたくさん"}, {"type": "subtitle", "time": 22132.15, "timestamp": "06:08:52", "text": "大学のことだったけど、私たちにはなかった"}, {"type": "subtitle", "time": 22136.23, "timestamp": "06:08:56", "text": "十分な時間がある、つまり、たとえ私が"}, {"type": "subtitle", "time": 22138.708, "timestamp": "06:08:58", "text": "ティフィンを作る、時々講義"}]
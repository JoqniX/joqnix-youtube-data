[{"type": "subtitle", "time": 19209.83, "timestamp": "05:20:09", "text": "目標がもうすぐ来るけど、私は嬉しくない"}, {"type": "subtitle", "time": 19212.948, "timestamp": "05:20:12", "text": "それについて。ああ、あなたも下手なの？"}, {"type": "subtitle", "time": 19216.15, "timestamp": "05:20:16", "text": "ホラー？同じ。 D. 私もです。私はそうではない"}, {"type": "subtitle", "time": 19218.31, "timestamp": "05:20:18", "text": "ホラー作品に非常に優れている。ええ、そうです"}, {"type": "subtitle", "time": 19221.27, "timestamp": "05:20:21", "text": "そこには。たぶん169くらいだと思う"}, {"type": "subtitle", "time": 19224.47, "timestamp": "05:20:24", "text": "ホラーゲームの目標はこれだ。"}, {"type": "subtitle", "time": 19227.51, "timestamp": "05:20:27", "text": "H 169 のように"}, {"type": "subtitle", "time": 19231.83, "timestamp": "05:20:31", "text": "フォロワー数。ああ、わかったわかった。つまり"}, {"type": "subtitle", "time": 19238.788, "timestamp": "05:20:38", "text": "何てことだ"}, {"type": "subtitle", "time": 19243.27, "timestamp": "05:20:43", "text": "みんなが私にホラーをやるように言った"}, {"type": "subtitle", "time": 19247.03, "timestamp": "05:20:47", "text": "ジョアトン。私は「やらなきゃいけないの？」と思いました。私は"}, {"type": "subtitle", "time": 19250.15, "timestamp": "05:20:50", "text": "ぐるっと回って、走る"}, {"type": "subtitle", "time": 19253.91, "timestamp": "05:20:53", "text": "そこから離れて、だってそれは私じゃないから、私は"}, {"type": "subtitle", "time": 19257.35, "timestamp": "05:20:57", "text": "叫んだり泣いたり迷惑をかけたり"}]
[{"type": "subtitle", "time": 2402.069, "timestamp": "00:40:02", "text": "彼らは次にいつ来たのですか？うん。"}, {"type": "subtitle", "time": 2411.109, "timestamp": "00:40:11", "text": "おお。"}, {"type": "subtitle", "time": 2413.349, "timestamp": "00:40:13", "text": "いくつかの疑惑は本当だよ、兄弟。何"}, {"type": "subtitle", "time": 2429.27, "timestamp": "00:40:29", "text": "タイトルだけ変更して、"}, {"type": "subtitle", "time": 2430.87, "timestamp": "00:40:30", "text": "私の好きなもの。"}, {"type": "subtitle", "time": 2433.589, "timestamp": "00:40:33", "text": "今日は99日目です。明日は"}, {"type": "subtitle", "time": 2437.829, "timestamp": "00:40:37", "text": "100. 信じられますか？"}, {"type": "subtitle", "time": 2447.109, "timestamp": "00:40:47", "text": "何かについて"}]
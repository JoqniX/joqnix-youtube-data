[{"type": "subtitle", "time": 15661.91, "timestamp": "04:21:01", "text": "ストリーミング時の悪い経験"}, {"type": "subtitle", "time": 15665.03, "timestamp": "04:21:05", "text": "または、変な気味の悪い人や"}, {"type": "subtitle", "time": 15666.79, "timestamp": "04:21:06", "text": "コラボレーション中、またはあなたが"}, {"type": "subtitle", "time": 15669.189, "timestamp": "04:21:09", "text": "ストリーミングまたはVersでプレイ"}, {"type": "subtitle", "time": 15672.229, "timestamp": "04:21:12", "text": "悪い経験に遭遇する"}, {"type": "subtitle", "time": 15676.229, "timestamp": "04:21:16", "text": "そんな感じ？まだそこまでではない。私はただの"}, {"type": "subtitle", "time": 15678.55, "timestamp": "04:21:18", "text": "まるでボットがいたみたいだった"}, {"type": "subtitle", "time": 15683.189, "timestamp": "04:21:23", "text": "私にとっては襲撃だ。なんてこった。うん。そしてそれは"}, {"type": "subtitle", "time": 15685.91, "timestamp": "04:21:25", "text": "すべてのボットは、私たちの"}, {"type": "subtitle", "time": 15689.429, "timestamp": "04:21:29", "text": "インドの自由の戦士たち。"}, {"type": "subtitle", "time": 15694.79, "timestamp": "04:21:34", "text": "わかった。おお。そう、それは変な感じだった"}, {"type": "subtitle", "time": 15698.149, "timestamp": "04:21:38", "text": "君に会って、セバスチャンを知らない"}, {"type": "subtitle", "time": 15707.91, "timestamp": "04:21:47", "text": "ひどかった。"}, {"type": "subtitle", "time": 15711.91, "timestamp": "04:21:51", "text": "その後、私は行かなければならなかった"}, {"type": "subtitle", "time": 15717.75, "timestamp": "04:21:57", "text": "行って、彼らを追放してください。何てことだ。"}]
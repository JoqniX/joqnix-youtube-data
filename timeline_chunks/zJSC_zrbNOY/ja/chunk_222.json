[{"type": "subtitle", "time": 13322.309, "timestamp": "03:42:02", "text": "私はひどいZ世代です。"}, {"type": "subtitle", "time": 13326.87, "timestamp": "03:42:06", "text": "うーん、私の同世代のZ世代を失望させるだろう"}, {"type": "subtitle", "time": 13331.91, "timestamp": "03:42:11", "text": "新しいスラングにとても悲しく思います"}, {"type": "subtitle", "time": 13333.429, "timestamp": "03:42:13", "text": "なぜなら"}, {"type": "subtitle", "time": 13335.91, "timestamp": "03:42:15", "text": "半分くらいの確率で、私はオープンな都市に出なければならない"}, {"type": "subtitle", "time": 13338.389, "timestamp": "03:42:18", "text": "辞書をつけて、"}, {"type": "subtitle", "time": 13341.83, "timestamp": "03:42:21", "text": "これはどういう意味ですか？"}, {"type": "subtitle", "time": 13345.19, "timestamp": "03:42:25", "text": "私は50歳です。"}, {"type": "subtitle", "time": 13349.19, "timestamp": "03:42:29", "text": "同じ。何てことだ。"}, {"type": "subtitle", "time": 13352.229, "timestamp": "03:42:32", "text": "そして、それは本当にクレイジーになるんです。だって、えっと、"}, {"type": "subtitle", "time": 13355.75, "timestamp": "03:42:35", "text": "友達がいて、"}, {"type": "subtitle", "time": 13357.429, "timestamp": "03:42:37", "text": "あなたが繋がっている他の配信者"}, {"type": "subtitle", "time": 13359.59, "timestamp": "03:42:39", "text": "同じ出身ではない人たちと"}, {"type": "subtitle", "time": 13362.55, "timestamp": "03:42:42", "text": "インドのような人口統計と"}, {"type": "subtitle", "time": 13364.15, "timestamp": "03:42:44", "text": "コラボレーションしたり、ただ一緒に遊んだりする。ただ"}, {"type": "subtitle", "time": 13366.71, "timestamp": "03:42:46", "text": "まるで、私が"}, {"type": "subtitle", "time": 13370.389, "timestamp": "03:42:50", "text": "私は英語を知っているが、今は"}, {"type": "subtitle", "time": 13379.269, "timestamp": "03:42:59", "text": "チャット共有機能を使ってみます。私はただ"}]
[{"type": "subtitle", "time": 16443.189, "timestamp": "04:34:03", "text": "怪我をしないし、良いことだし、"}, {"type": "subtitle", "time": 16446.709, "timestamp": "04:34:06", "text": "ある時点で彼らは叫び始めた"}, {"type": "subtitle", "time": 16448.949, "timestamp": "04:34:08", "text": "私とか、良いことを言うだけで"}, {"type": "subtitle", "time": 16451.349, "timestamp": "04:34:11", "text": "そして、耳を傾ける。彼らが怒ったとき"}, {"type": "subtitle", "time": 16453.83, "timestamp": "04:34:13", "text": "彼らはよく私に暴力を振るったりしたものだ。だから私は"}, {"type": "subtitle", "time": 16457.51, "timestamp": "04:34:17", "text": "「うわあ、私は昔はそうだったのに"}, {"type": "subtitle", "time": 16461.189, "timestamp": "04:34:21", "text": "「精神的にも影響を受けるよ。」君みたいにね"}, {"type": "subtitle", "time": 16463.59, "timestamp": "04:34:23", "text": "これはストリームで彼が"}, {"type": "subtitle", "time": 16466.47, "timestamp": "04:34:26", "text": "ストリームで自殺とかそういうのをやって、"}, {"type": "subtitle", "time": 16469.269, "timestamp": "04:34:29", "text": "その場で泣き出した、なぜそんなことを言うの？"}, {"type": "subtitle", "time": 16472.31, "timestamp": "04:34:32", "text": "そういう私、強い言葉とかそういうのが好きなんです"}, {"type": "subtitle", "time": 16474.07, "timestamp": "04:34:34", "text": "そんな感じ。"}, {"type": "subtitle", "time": 16476.23, "timestamp": "04:34:36", "text": "いろいろなことが起こった。私はこう思った"}, {"type": "subtitle", "time": 16479.189, "timestamp": "04:34:39", "text": "すると周りの人たちが「ジョック、なんで？」って言った"}, {"type": "subtitle", "time": 16482.07, "timestamp": "04:34:42", "text": "あなたは人に時間を費やしているのですか"}, {"type": "subtitle", "time": 16484.949, "timestamp": "04:34:44", "text": "彼らのように？そして全て。そしていつも"}, {"type": "subtitle", "time": 16487.83, "timestamp": "04:34:47", "text": "ええ、それが初めてだったんです"}, {"type": "subtitle", "time": 16491.349, "timestamp": "04:34:51", "text": "誰かをブロックすることに決めたとき"}, {"type": "subtitle", "time": 16494.709, "timestamp": "04:34:54", "text": "生涯を通して。大変だったけれど、"}, {"type": "subtitle", "time": 16497.269, "timestamp": "04:34:57", "text": "私は最善を尽くしました。それから私は学んだ、"}]
[{"type": "subtitle", "time": 10936.309, "timestamp": "03:02:16", "text": "はい、戻ってきました。戻ってきました。戻ってきました。私"}, {"type": "subtitle", "time": 10943.59, "timestamp": "03:02:23", "text": "「ああ、神様、私は逃げた」という結果になった。私は走った"}, {"type": "subtitle", "time": 10946.389, "timestamp": "03:02:26", "text": "そして"}, {"type": "subtitle", "time": 10949.83, "timestamp": "03:02:29", "text": "私は、えっと"}, {"type": "subtitle", "time": 10957.349, "timestamp": "03:02:37", "text": "マイクを手に入れた。"}, {"type": "subtitle", "time": 10959.59, "timestamp": "03:02:39", "text": "ここに置いてください。"}, {"type": "subtitle", "time": 10961.91, "timestamp": "03:02:41", "text": "この男をここに置いて"}, {"type": "subtitle", "time": 10964.79, "timestamp": "03:02:44", "text": "充電できるもの。"}, {"type": "subtitle", "time": 10967.349, "timestamp": "03:02:47", "text": "閉じてください。わかった。"}, {"type": "subtitle", "time": 10970.55, "timestamp": "03:02:50", "text": "この人は100％そうだ。"}, {"type": "subtitle", "time": 10972.309, "timestamp": "03:02:52", "text": "いや、いや、いや。マイクを再度充電しないでください。"}]
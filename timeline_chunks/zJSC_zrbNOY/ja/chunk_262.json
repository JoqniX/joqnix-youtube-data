[{"type": "subtitle", "time": 15720.79, "timestamp": "04:22:00", "text": "うん、あれは奇妙な出来事だったね。その他の奇妙な"}, {"type": "subtitle", "time": 15722.87, "timestamp": "04:22:02", "text": "私が経験したであろう交流は、"}, {"type": "subtitle", "time": 15724.55, "timestamp": "04:22:04", "text": "いる"}, {"type": "subtitle", "time": 15727.349, "timestamp": "04:22:07", "text": "いや、あれはたぶんあれだったと思う"}, {"type": "subtitle", "time": 15730.389, "timestamp": "04:22:10", "text": "それが一番私をパニックに陥れた。でも、"}, {"type": "subtitle", "time": 15733.51, "timestamp": "04:22:13", "text": "幸いにも、モッズや友達がいた"}, {"type": "subtitle", "time": 15736.79, "timestamp": "04:22:16", "text": "ええと、その時のチャットで。した"}, {"type": "subtitle", "time": 15740.95, "timestamp": "04:22:20", "text": "ガンジーもそれを実践していたのか？うーん、わからない"}, {"type": "subtitle", "time": 15743.67, "timestamp": "04:22:23", "text": "ルドラ。覚えているのは、"}, {"type": "subtitle", "time": 15745.83, "timestamp": "04:22:25", "text": "多くの自由の戦士たち。あった"}, {"type": "subtitle", "time": 15749.99, "timestamp": "04:22:29", "text": "ラニ・ラクシュミもそこにいる。おお。"}, {"type": "subtitle", "time": 15763.349, "timestamp": "04:22:43", "text": "何と言っていいかわからない。すごいですね。"}, {"type": "subtitle", "time": 15767.67, "timestamp": "04:22:47", "text": "えーと、ボードレイドは、だから、これです"}, {"type": "subtitle", "time": 15770.87, "timestamp": "04:22:50", "text": "ランダムな新しいアカウントのスパムのように"}, {"type": "subtitle", "time": 15773.99, "timestamp": "04:22:53", "text": "あなたのチャットやいいね、フォロー、スパム"}, {"type": "subtitle", "time": 15776.309, "timestamp": "04:22:56", "text": "そういうことですよね？"}, {"type": "subtitle", "time": 15778.95, "timestamp": "04:22:58", "text": "うん。つまり、それはたった1回のフォローだった"}]
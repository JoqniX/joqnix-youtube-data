[{"type": "subtitle", "time": 19081.27, "timestamp": "05:18:01", "text": "Windowsで、"}, {"type": "subtitle", "time": 19083.99, "timestamp": "05:18:03", "text": "そうですね、風景は"}, {"type": "subtitle", "time": 19087.43, "timestamp": "05:18:07", "text": "「切り取ったりしたよね？」だからそうしたんだ。"}, {"type": "subtitle", "time": 19090.23, "timestamp": "05:18:10", "text": "だって、あの時は回転できなかったから"}, {"type": "subtitle", "time": 19092.31, "timestamp": "05:18:12", "text": "モニター。だから私は「よし、行くよ」と思った"}, {"type": "subtitle", "time": 19096.15, "timestamp": "05:18:16", "text": "風景を反転させる"}, {"type": "subtitle", "time": 19100.39, "timestamp": "05:18:20", "text": "「あれ」それから、キーボード"}, {"type": "subtitle", "time": 19103.35, "timestamp": "05:18:23", "text": "そして、それをひっくり返さなければならない。それはとても"}, {"type": "subtitle", "time": 19105.83, "timestamp": "05:18:25", "text": "難しいですよね？そして私は椅子をひっくり返した"}, {"type": "subtitle", "time": 19109.35, "timestamp": "05:18:29", "text": "あまりにも。だから、立っていなければならなかったんです。ああ、"}, {"type": "subtitle", "time": 19111.67, "timestamp": "05:18:31", "text": "ああ、あれは本当に大変な出来事だった。そして私は"}, {"type": "subtitle", "time": 19114.07, "timestamp": "05:18:34", "text": "それをやめた。申し訳ありません。恋しい"}, {"type": "subtitle", "time": 19118.55, "timestamp": "05:18:38", "text": "回転するようなやつ。おお。あなたは与えた"}, {"type": "subtitle", "time": 19125.99, "timestamp": "05:18:45", "text": "しかし、それは互いに"}, {"type": "subtitle", "time": 19127.99, "timestamp": "05:18:47", "text": "私もTwitchが大好きです"}, {"type": "subtitle", "time": 19131.51, "timestamp": "05:18:51", "text": "なぜなら、そこにはたくさんの相互作用があるから"}, {"type": "subtitle", "time": 19133.67, "timestamp": "05:18:53", "text": "それはチャットとは別に実行できます"}, {"type": "subtitle", "time": 19136.55, "timestamp": "05:18:56", "text": "ただおしゃべりしているだけなのに、うーん、音が"}, {"type": "subtitle", "time": 19138.31, "timestamp": "05:18:58", "text": "アラートがあり、そして"}]
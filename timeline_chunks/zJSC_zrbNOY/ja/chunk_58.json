[{"type": "subtitle", "time": 3487.03, "timestamp": "00:58:07", "text": "でも、後でやるなら"}, {"type": "subtitle", "time": 3490.789, "timestamp": "00:58:10", "text": "気分が良くなるでしょうか"}, {"type": "subtitle", "time": 3493.75, "timestamp": "00:58:13", "text": "安定していて全てが"}, {"type": "subtitle", "time": 3501.19, "timestamp": "00:58:21", "text": "ゲストへ"}, {"type": "subtitle", "time": 3505.99, "timestamp": "00:58:25", "text": "ぎっしり詰まった人"}, {"type": "subtitle", "time": 3509.109, "timestamp": "00:58:29", "text": "今日、私が変えられないことは"}, {"type": "subtitle", "time": 3512.15, "timestamp": "00:58:32", "text": "ゲストは柔軟に対応できると感じています"}, {"type": "subtitle", "time": 3514.15, "timestamp": "00:58:34", "text": "どんな日でも"}, {"type": "subtitle", "time": 3517.19, "timestamp": "00:58:37", "text": "しかし、それを延期するのは辛いだろう"}]
[{"type": "subtitle", "time": 6199.27, "timestamp": "01:43:19", "text": "わかった、"}, {"type": "subtitle", "time": 6202.629, "timestamp": "01:43:22", "text": "私がやらなければならないことの一つ"}, {"type": "subtitle", "time": 6214.07, "timestamp": "01:43:34", "text": "だから、夜間照射機能付きの製品が欲しかったんです。それから"}, {"type": "subtitle", "time": 6216.79, "timestamp": "01:43:36", "text": "私は、えっと、"}, {"type": "subtitle", "time": 6223.91, "timestamp": "01:43:43", "text": "お金が足りない時にお金を使う"}]
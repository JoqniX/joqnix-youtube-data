[{"type": "subtitle", "time": 13501.51, "timestamp": "03:45:01", "text": "そう、みんな「うわー」って感じ"}, {"type": "subtitle", "time": 13504.71, "timestamp": "03:45:04", "text": "トゥイッチ。だから、よくわからないんです。彼らは私は"}, {"type": "subtitle", "time": 13506.229, "timestamp": "03:45:06", "text": "彼らは適切なことをすると思う"}, {"type": "subtitle", "time": 13510.55, "timestamp": "03:45:10", "text": "それに関する発表。うん、変だよね"}, {"type": "subtitle", "time": 13513.51, "timestamp": "03:45:13", "text": "Twitch最高！彼らは手に入れる必要がある"}, {"type": "subtitle", "time": 13522.469, "timestamp": "03:45:22", "text": "ああ、これは結局"}, {"type": "subtitle", "time": 13525.03, "timestamp": "03:45:25", "text": "混乱させているのは、私が好きだからです"}, {"type": "subtitle", "time": 13527.91, "timestamp": "03:45:27", "text": "YouTube を検討したのは、"}, {"type": "subtitle", "time": 13534.95, "timestamp": "03:45:34", "text": "今これ"}, {"type": "subtitle", "time": 13537.349, "timestamp": "03:45:37", "text": "何をしてほしいの？できないよ"}, {"type": "subtitle", "time": 13540.55, "timestamp": "03:45:40", "text": "チャットも見て、えっと、私が昔"}, {"type": "subtitle", "time": 13543.51, "timestamp": "03:45:43", "text": "チャットを画面に表示するために使用しました"}, {"type": "subtitle", "time": 13546.389, "timestamp": "03:45:46", "text": "それを分離するために、Twitchは"}, {"type": "subtitle", "time": 13547.99, "timestamp": "03:45:47", "text": "Twitchチャンネルは別になります、YouTube"}, {"type": "subtitle", "time": 13550.229, "timestamp": "03:45:50", "text": "チャンネルは別になります。どちらかの場所に"}, {"type": "subtitle", "time": 13553.75, "timestamp": "03:45:53", "text": "それらを一緒に、横に並べて、"}, {"type": "subtitle", "time": 13556.07, "timestamp": "03:45:56", "text": "左と右のように。"}, {"type": "subtitle", "time": 13557.91, "timestamp": "03:45:57", "text": "ああ、神様。"}]
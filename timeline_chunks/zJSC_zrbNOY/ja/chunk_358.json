[{"type": "subtitle", "time": 21480.31, "timestamp": "05:58:00", "text": "Vubingの時間中。えっと、それは、私たちは"}, {"type": "subtitle", "time": 21483.43, "timestamp": "05:58:03", "text": "別のユーチューバーは、えーっと、"}, {"type": "subtitle", "time": 21486.23, "timestamp": "05:58:06", "text": "VCに参加して話すのは、"}, {"type": "subtitle", "time": 21489.19, "timestamp": "05:58:09", "text": "ミュートにするには少なくとも30秒かかります"}, {"type": "subtitle", "time": 21491.27, "timestamp": "05:58:11", "text": "心と精神を整える時間"}, {"type": "subtitle", "time": 21495.11, "timestamp": "05:58:15", "text": "魂が、えっと、話したり挨拶したりするような感じ"}, {"type": "subtitle", "time": 21498.788, "timestamp": "05:58:18", "text": "だって昔はすごく大変だったから"}, {"type": "subtitle", "time": 21502.07, "timestamp": "05:58:22", "text": "私の場合、不安や社会的なもの"}, {"type": "subtitle", "time": 21505.83, "timestamp": "05:58:25", "text": "わからないもの、それからゆっくりと"}, {"type": "subtitle", "time": 21509.27, "timestamp": "05:58:29", "text": "ゆっくりと、ゆっくりと話す友達ができた"}, {"type": "subtitle", "time": 21512.07, "timestamp": "05:58:32", "text": "彼女は心地よく感じていて、"}, {"type": "subtitle", "time": 21515.67, "timestamp": "05:58:35", "text": "うん、えっと、話しているように"}, {"type": "subtitle", "time": 21517.83, "timestamp": "05:58:37", "text": "普段は私と一緒なので大丈夫です"}, {"type": "subtitle", "time": 21520.47, "timestamp": "05:58:40", "text": "コラボが始まったので、彼女は私を引っ張って"}, {"type": "subtitle", "time": 21523.27, "timestamp": "05:58:43", "text": "初めてのコラボで、私はとても"}, {"type": "subtitle", "time": 21528.23, "timestamp": "05:58:48", "text": "緊張していた、緊張していた、ああ、まずいと思った"}, {"type": "subtitle", "time": 21531.83, "timestamp": "05:58:51", "text": "何て言えばいいんだろう、でも、私は"}, {"type": "subtitle", "time": 21534.868, "timestamp": "05:58:54", "text": "コラボレーションに関しては、"}, {"type": "subtitle", "time": 21537.11, "timestamp": "05:58:57", "text": "その時の物や、たくさん話すのが好きな物"}]
[{"type": "subtitle", "time": 20821.35, "timestamp": "05:47:01", "text": "人々は、私があなたに"}, {"type": "subtitle", "time": 20825.59, "timestamp": "05:47:05", "text": "限定オファー"}, {"type": "subtitle", "time": 20827.83, "timestamp": "05:47:07", "text": "担保可能な金額、彼が要求したように"}, {"type": "subtitle", "time": 20831.35, "timestamp": "05:47:11", "text": "千ドルか2千ドルくらい送る"}, {"type": "subtitle", "time": 20834.47, "timestamp": "05:47:14", "text": "彼に今日、今夜、今夜までに"}, {"type": "subtitle", "time": 20837.67, "timestamp": "05:47:17", "text": "保証のこと、だって私は"}, {"type": "subtitle", "time": 20840.07, "timestamp": "05:47:20", "text": "彼の立場からすると、ああ彼はとても"}, {"type": "subtitle", "time": 20842.15, "timestamp": "05:47:22", "text": "インド全土から多くの学生が集まり、"}, {"type": "subtitle", "time": 20844.948, "timestamp": "05:47:24", "text": "音楽を学びたい人や"}, {"type": "subtitle", "time": 20846.708, "timestamp": "05:47:26", "text": "切り替えた人たちのようなすべて"}, {"type": "subtitle", "time": 20849.99, "timestamp": "05:47:29", "text": "音楽関係の仕事や歌手の仕事"}, {"type": "subtitle", "time": 20853.35, "timestamp": "05:47:33", "text": "すべて。だから私は「よし、やってみよう」と思った。"}, {"type": "subtitle", "time": 20856.708, "timestamp": "05:47:36", "text": "そして、ああ、両親を説得する"}, {"type": "subtitle", "time": 20859.59, "timestamp": "05:47:39", "text": "なんてことだ"}, {"type": "subtitle", "time": 20862.788, "timestamp": "05:47:42", "text": "私は何度も何度も懇願したが、彼は"}, {"type": "subtitle", "time": 20865.99, "timestamp": "05:47:45", "text": "そこにいて、まるで彼が"}, {"type": "subtitle", "time": 20868.868, "timestamp": "05:47:48", "text": "送って教えるのは問題ない"}, {"type": "subtitle", "time": 20871.43, "timestamp": "05:47:51", "text": "私に学ばせてくれたが、問題は私が"}, {"type": "subtitle", "time": 20873.51, "timestamp": "05:47:53", "text": "日本語の授業はすでに始まっていた"}, {"type": "subtitle", "time": 20876.708, "timestamp": "05:47:56", "text": "の上。これは昨年の12月のことでした"}, {"type": "subtitle", "time": 20879.35, "timestamp": "05:47:59", "text": "年。わかった。うん。 12月 日本語"}]
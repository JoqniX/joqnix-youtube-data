[{"type": "subtitle", "time": 1229.75, "timestamp": "00:20:29", "text": "我以前就像一個不懂程式設計的人，但這並沒有阻止我想要學習和做我想做的事情，"}, {"type": "subtitle", "time": 1232.47, "timestamp": "00:20:32", "text": "我一直都想做對的事情。能夠花時間去理解事物真的很好，無論是與程式設計相關的事物，"}, {"type": "subtitle", "time": 1239.59, "timestamp": "00:20:39", "text": "即使我什麼都不懂，"}]
[{"type": "subtitle", "time": 27877.27, "timestamp": "07:44:37", "text": "你所見，最上面的那顆星星是我"}, {"type": "subtitle", "time": 27882.948, "timestamp": "07:44:42", "text": "。呃，稍等一下。稍等一下。稍等一下。你好。 呃，讓"}, {"type": "subtitle", "time": 27886.548, "timestamp": "07:44:46", "text": "我快速完成這件事。所以，呃，我在想，呃，你們"}, {"type": "subtitle", "time": 27889.11, "timestamp": "07:44:49", "text": "今年也想這樣待在樹上嗎"}, {"type": "subtitle", "time": 27891.99, "timestamp": "07:44:51", "text": "？和那些過來的人，"}, {"type": "subtitle", "time": 27894.468, "timestamp": "07:44:54", "text": "我"}, {"type": "subtitle", "time": 27895.75, "timestamp": "07:44:55", "text": "覺得我可以把每個人都加進來，Ash，我覺得，我不太確定，真的不太確定，但我覺得我"}]
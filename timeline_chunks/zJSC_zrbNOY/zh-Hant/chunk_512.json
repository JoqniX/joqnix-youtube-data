[{"type": "subtitle", "time": 30743.59, "timestamp": "08:32:23", "text": "黑客小子郵箱。唉，我"}, {"type": "subtitle", "time": 30745.67, "timestamp": "08:32:25", "text": "不"}, {"type": "subtitle", "time": 30763.03, "timestamp": "08:32:43", "text": "知道為什麼所有這些 g，幾乎每個客服都在仔細分析郵件，就像兄弟，直接把整封郵件都顯示出來不就好了嗎"}, {"type": "subtitle", "time": 30764.788, "timestamp": "08:32:44", "text": "？太麻煩了。看來我"}, {"type": "subtitle", "time": 30775.19, "timestamp": "08:32:55", "text": "彩虹六號：圍攻》了。不再是了。"}]
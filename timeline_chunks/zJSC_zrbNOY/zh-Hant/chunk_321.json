[{"type": "subtitle", "time": 19261.27, "timestamp": "05:21:01", "text": "自己。這"}, {"type": "subtitle", "time": 19270.15, "timestamp": "05:21:10", "text": "就像一段旅程。你會經歷艱難困苦，也會從中逐漸培養出強大的心理素質，就像一層保護罩，你知道"}, {"type": "subtitle", "time": 19280.07, "timestamp": "05:21:20", "text": "該做什麼，不該做什麼等等。不。是的。露絲問我，我看起來像個心理諮商師嗎？"}, {"type": "subtitle", "time": 19289.11, "timestamp": "05:21:29", "text": "我甚至不能這麼說，露絲。我是個"}, {"type": "subtitle", "time": 19291.99, "timestamp": "05:21:31", "text": "心理"}, {"type": "subtitle", "time": 19295.19, "timestamp": "05:21:35", "text": "諮商師。"}, {"type": "subtitle", "time": 19298.23, "timestamp": "05:21:38", "text": "你是。是的。我的天哪。"}, {"type": "subtitle", "time": 19302.628, "timestamp": "05:21:42", "text": "我的天哪。哇。該死。但是，是的，我也有一個原則，那就是"}, {"type": "subtitle", "time": 19304.47, "timestamp": "05:21:44", "text": "我不會在直播中進行那種諮商"}, {"type": "subtitle", "time": 19306.708, "timestamp": "05:21:46", "text": "或談話，因為對我來說，"}]
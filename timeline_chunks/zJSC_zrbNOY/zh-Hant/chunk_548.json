[{"type": "subtitle", "time": 32902.388, "timestamp": "09:08:22", "text": "11點到12點，呃，不，呃，在11點之前，呃，收拾好，然後我們做"}, {"type": "subtitle", "time": 32913.908, "timestamp": "09:08:33", "text": "聖誕樹的事情。好的。嗨，呃，免費功能有限。"}, {"type": "subtitle", "time": 32917.908, "timestamp": "09:08:37", "text": "哦好的。我喜歡它不願相信微軟能做到什麼？  我的天哪[音樂]"}, {"type": "subtitle", "time": 32921.03, "timestamp": "09:08:41", "text": "我還能說什麼呢"}, {"type": "subtitle", "time": 32926.868, "timestamp": "09:08:46", "text": "？ 我的延遲是78毫秒。帶上你的"}, {"type": "subtitle", "time": 32930.548, "timestamp": "09:08:50", "text": "水泵。  我"}]
[{"type": "subtitle", "time": 13633.59, "timestamp": "03:47:13", "text": "確切地。但這太酷了，嗯，讓我展示一下，他們有綁定器，"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "沒有藝術家，呃，這"}, {"type": "subtitle", "time": 13664.469, "timestamp": "03:47:44", "text": "和"}, {"type": "subtitle", "time": 13668.469, "timestamp": "03:47:48", "text": "藝術風格相似，呃，我想是同一個媽媽，呃，Salantki，還有一些太空連接器，讓我"}]
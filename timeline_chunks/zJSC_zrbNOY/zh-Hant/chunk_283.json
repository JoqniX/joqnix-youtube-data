[{"type": "subtitle", "time": 16986.788, "timestamp": "04:43:06", "text": "對吧？  是的"}, {"type": "subtitle", "time": 16992.628, "timestamp": "04:43:12", "text": "我通常會"}, {"type": "subtitle", "time": 17000.07, "timestamp": "04:43:20", "text": "在答案太籠統的時候這樣做。是的，確實如此。例如，我的朋友們，還有我的爺爺，"}, {"type": "subtitle", "time": 17003.19, "timestamp": "04:43:23", "text": "當他注意到我常常打噴嚏，而且打噴嚏的時候並不覺得冷的時候，他"}, {"type": "subtitle", "time": 17023.51, "timestamp": "04:43:43", "text": "也會這樣做"}, {"type": "subtitle", "time": 17028.23, "timestamp": "04:43:48", "text": "。  更像是過敏性過敏。"}, {"type": "subtitle", "time": 17030.47, "timestamp": "04:43:50", "text": "所以他會說：「對，吸進去。」我當時就想，「好了，走了。我現在頭痛。可能是溫度變化引起的。」哦，"}]
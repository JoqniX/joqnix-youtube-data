[{"type": "subtitle", "time": 31878.15, "timestamp": "08:51:18", "text": "我"}, {"type": "subtitle", "time": 31894.548, "timestamp": "08:51:34", "text": "認為這是件"}, {"type": "subtitle", "time": 31901.67, "timestamp": "08:51:41", "text": "爸爸都打了耳洞。所以他們說，哦，難道你不需要維護它嗎？一旦你打了"}, {"type": "subtitle", "time": 31907.19, "timestamp": "08:51:47", "text": "耳洞，你就得一直戴耳環之類的東西"}, {"type": "subtitle", "time": 31910.468, "timestamp": "08:51:50", "text": "。  他知道。  我的天啊。"}, {"type": "subtitle", "time": 31912.628, "timestamp": "08:51:52", "text": "哦。"}, {"type": "subtitle", "time": 31915.99, "timestamp": "08:51:55", "text": "附近。是的，你得一直把"}]
[{"type": "subtitle", "time": 12546.15, "timestamp": "03:29:06", "text": "這真的感覺像是對一個較小的"}, {"type": "subtitle", "time": 12548.15, "timestamp": "03:29:08", "text": "頻道來說不可能"}, {"type": "subtitle", "time": 12553.19, "timestamp": "03:29:13", "text": "做到的，我的意思是，"}, {"type": "subtitle", "time": 12561.269, "timestamp": "03:29:21", "text": "呃[音樂]，所以，是的，我不知道。有人……呃，我不知道。我不知道該怎麼形容它有多響。  我必須遵守平台規則。所以我沒有大聲說出來。我覺得最後我"}, {"type": "subtitle", "time": 12563.99, "timestamp": "03:29:23", "text": "感覺不到我過去在現實中是如何使用的。該死。"}, {"type": "subtitle", "time": 12580.63, "timestamp": "03:29:40", "text": "[音樂] 我只想做自己喜歡的事，享受樂趣。  這就是我開始做這件事的原因。  是的"}]
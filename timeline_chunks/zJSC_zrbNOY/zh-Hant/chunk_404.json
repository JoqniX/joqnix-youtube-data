[{"type": "subtitle", "time": 24247.59, "timestamp": "06:44:07", "text": "所以我當時有點懷疑。他們"}, {"type": "subtitle", "time": 24264.948, "timestamp": "06:44:24", "text": "說話的語氣就像是「是啊，趕緊付錢給我們，我們馬上就辦，這是專門給"}, {"type": "subtitle", "time": 24267.91, "timestamp": "06:44:27", "text": "你的獨家優惠」之類的。"}, {"type": "subtitle", "time": 24274.468, "timestamp": "06:44:34", "text": "我就想，嗯？我告訴他們我想先跟家人商量一下，而且我手頭沒有錢，雖然錢在我手裡，但"}, {"type": "subtitle", "time": 24289.59, "timestamp": "06:44:49", "text": "我得先存到銀行帳戶裡。他們說：「是"}]
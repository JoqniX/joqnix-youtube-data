[{"type": "subtitle", "time": 21078.548, "timestamp": "05:51:18", "text": "太貴了。我記得"}, {"type": "subtitle", "time": 21098.31, "timestamp": "05:51:38", "text": "我之前"}, {"type": "subtitle", "time": 21101.99, "timestamp": "05:51:41", "text": "看過一個畫師，畫風挺可愛的，感覺他們能駕馭我的模型風格，然後我就查了價格，結果光是畫圖就要30000美元，我就想，"}, {"type": "subtitle", "time": 21104.948, "timestamp": "05:51:44", "text": "好吧，也許是時候"}, {"type": "subtitle", "time": 21113.83, "timestamp": "05:51:53", "text": "開始定期練習畫畫了。我的"}, {"type": "subtitle", "time": 21117.67, "timestamp": "05:51:57", "text": "天哪。是"}]
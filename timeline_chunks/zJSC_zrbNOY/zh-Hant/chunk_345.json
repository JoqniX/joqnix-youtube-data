[{"type": "subtitle", "time": 20701.11, "timestamp": "05:45:01", "text": "這簡直是你能收到的最好的生日禮物。"}, {"type": "subtitle", "time": 20714.31, "timestamp": "05:45:14", "text": "我盡力把Joex的最初設計融入其中，同時讓它更具"}, {"type": "subtitle", "time": 20732.788, "timestamp": "05:45:32", "text": "原創性，更貼合我的想法，因為，嗯，我的聲音讓一些人對性別感到困惑，我就想，是啊，我要讓你們更困惑，讓模型的外觀更令人困惑。完美。"}, {"type": "subtitle", "time": 20735.35, "timestamp": "05:45:35", "text": "我喜歡這種感覺。是啊。所以，Joke就像"}, {"type": "subtitle", "time": 20740.39, "timestamp": "05:45:40", "text": "星座。它就像《謠言風暴》"}, {"type": "subtitle", "time": 20747.91, "timestamp": "05:45:47", "text": "這部動畫裡的史萊姆"}, {"type": "subtitle", "time": 20751.27, "timestamp": "05:45:51", "text": "。所以，這取決於你怎麼看待它。 Jo可以是男性，Jaw可以是女性，隨便吧，因為這就像是"}]
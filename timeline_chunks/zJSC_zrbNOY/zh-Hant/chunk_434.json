[{"type": "subtitle", "time": 26050.948, "timestamp": "07:14:10", "text": "有這些流程都在這裡。 我當時想，"}, {"type": "subtitle", "time": 26052.628, "timestamp": "07:14:12", "text": "我這輩子都沒面試過"}, {"type": "subtitle", "time": 26055.91, "timestamp": "07:14:15", "text": "。式服裝。 所以"}, {"type": "subtitle", "time": 26074.628, "timestamp": "07:14:34", "text": "我覺得那次面試意義非凡"}, {"type": "subtitle", "time": 26076.788, "timestamp": "07:14:36", "text": "。"}, {"type": "subtitle", "time": 26081.03, "timestamp": "07:14:41", "text": "換一件再來。 「或是那些穿T恤衫之類的人，他們不喜歡。必須是白襯衫之類的。"}, {"type": "subtitle", "time": 26083.83, "timestamp": "07:14:43", "text": "我當時用的是爸爸的嬰兒床，包括床單、睡袋等等所有東西。我想爸爸的表弟來過印度，他把那套西裝之類的東西送給了我爸爸。"}, {"type": "subtitle", "time": 26092.868, "timestamp": "07:14:52", "text": "所以即使他的包"}, {"type": "subtitle", "time": 26095.59, "timestamp": "07:14:55", "text": "尺寸偏大，我也一直在用"}]
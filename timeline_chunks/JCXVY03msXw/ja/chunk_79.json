[{"type": "subtitle", "time": 4744.39, "timestamp": "01:19:04", "text": "私がモナを追加したのはいつですか？ ああ、くそ。   何てことだ"}, {"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "。 私はバカだ。 私は"}, {"type": "subtitle", "time": 4750.39, "timestamp": "01:19:10", "text": "他の誰かとして何かを選ぶこともできたが、ああ、"}, {"type": "subtitle", "time": 4753.75, "timestamp": "01:19:13", "text": "変人。"}, {"type": "subtitle", "time": 4756.55, "timestamp": "01:19:16", "text": "大丈夫です。"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "覚えているよ。 たまたま"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "原神を開いて星5"}, {"type": "subtitle", "time": 4766.709, "timestamp": "01:19:26", "text": "セレクターを引いたのですが、モナを既に持っているかどうかすら確認されずに、モナを選びました"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "ラン。   あれは"}]
[{"type": "subtitle", "time": 1093.99, "timestamp": "00:18:13", "text": "グールは一体誰だ？ このゲームにはグールが登場します。"}, {"type": "subtitle", "time": 1098.07, "timestamp": "00:18:18", "text": "このゲームは状況を一変させた。"}, {"type": "subtitle", "time": 1099.27, "timestamp": "00:18:19", "text": "欺瞞は終わる。"}, {"type": "subtitle", "time": 1103.43, "timestamp": "00:18:23", "text": "私は原始の宝石を1つ手に入れた。"}, {"type": "subtitle", "time": 1125.27, "timestamp": "00:18:45", "text": "[うめき声]"}, {"type": "subtitle", "time": 1126.71, "timestamp": "00:18:46", "text": "真実は隠せない。"}]
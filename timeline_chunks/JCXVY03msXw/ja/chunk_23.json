[{"type": "subtitle", "time": 1380.789, "timestamp": "00:23:00", "text": "この世界の最後の残骸を発見した。"}, {"type": "subtitle", "time": 1382.71, "timestamp": "00:23:02", "text": "これら2つの端末はかつて、"}, {"type": "subtitle", "time": 1384.47, "timestamp": "00:23:04", "text": "夢見る者たちが外界と繋がるための手段（音楽）だった"}, {"type": "subtitle", "time": 1385.35, "timestamp": "00:23:05", "text": "。"}, {"type": "subtitle", "time": 1386.149, "timestamp": "00:23:06", "text": "夢想家。"}, {"type": "subtitle", "time": 1388.31, "timestamp": "00:23:08", "text": "今ではそれらは雑誌の[音楽]コレクションの一部となっている"}, {"type": "subtitle", "time": 1389.83, "timestamp": "00:23:09", "text": "。"}, {"type": "subtitle", "time": 1392.31, "timestamp": "00:23:12", "text": "その魔術師はかつて、自身の"}, {"type": "subtitle", "time": 1393.846, "timestamp": "00:23:13", "text": "多岐にわたる"}, {"type": "subtitle", "time": 1396.23, "timestamp": "00:23:16", "text": "音楽体験から得たものをもとに、一つの世界を創造しようと試みたことがある。 しかし、冷静な"}, {"type": "subtitle", "time": 1398.87, "timestamp": "00:23:18", "text": "観察者である彼女は、"}, {"type": "subtitle", "time": 1400.63, "timestamp": "00:23:20", "text": "すべてを一つにまとめるようなインスピレーションの火花（音楽）を見つけることは決してなかった"}, {"type": "subtitle", "time": 1403.59, "timestamp": "00:23:23", "text": "。 運命が放浪の魔術師に追いつく前に"}, {"type": "subtitle", "time": 1406.549, "timestamp": "00:23:26", "text": "、彼女は"}, {"type": "subtitle", "time": 1409.99, "timestamp": "00:23:29", "text": "音楽に精通した知識豊富な友人たちをもう一度訪ねた。"}, {"type": "subtitle", "time": 1411.75, "timestamp": "00:23:31", "text": "彼女は彼らと過ごした時間の中で多くのことを学んだ"}, {"type": "subtitle", "time": 1414.31, "timestamp": "00:23:34", "text": "。 そして、彼女は答えを見つけることはできなかったものの"}, {"type": "subtitle", "time": 1417.75, "timestamp": "00:23:37", "text": "、孤独感は"}, {"type": "subtitle", "time": 1419.029, "timestamp": "00:23:39", "text": "時とともに薄れていった。"}, {"type": "subtitle", "time": 1421.11, "timestamp": "00:23:41", "text": "その魔法使いは綺麗だ。 しかし、彼女と"}, {"type": "subtitle", "time": 1423.35, "timestamp": "00:23:43", "text": "友人たちが一緒に他の素晴らしい"}, {"type": "subtitle", "time": 1426.31, "timestamp": "00:23:46", "text": "世界を作り上げていくうちに、彼女はついに、"}, {"type": "subtitle", "time": 1428.47, "timestamp": "00:23:48", "text": "自分が夢見ていた世界に欠けているピースに気づいた"}, {"type": "subtitle", "time": 1431.11, "timestamp": "00:23:51", "text": "。"}, {"type": "subtitle", "time": 1439.35, "timestamp": "00:23:59", "text": "その輝かしい旅人と、彼らの（音楽の）完璧な"}]
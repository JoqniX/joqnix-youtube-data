[{"type": "subtitle", "time": 1142.0, "timestamp": "00:19:02", "text": "。 永遠の森のための反逆者たち。 森には"}, {"type": "subtitle", "time": 1145.2, "timestamp": "00:19:05", "text": "永遠の森のための反逆者たち。 森には ヒーラーがいない。"}, {"type": "subtitle", "time": 1146.96, "timestamp": "00:19:06", "text": "ヒーラーがいない。 私は死んで、浮遊は終わった。"}, {"type": "subtitle", "time": 1156.23, "timestamp": "00:19:16", "text": "あ、待って。 私にはヒーラーがいた。 ああ、"}, {"type": "subtitle", "time": 1173.35, "timestamp": "00:19:33", "text": "ランドクルーザー。 これは何ですか？"}, {"type": "subtitle", "time": 1178.87, "timestamp": "00:19:38", "text": "カキカキスペシャル。 はぁ？"}, {"type": "subtitle", "time": 1181.35, "timestamp": "00:19:41", "text": "マックスがいたよ。ああ、"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "もう嘘はつかない。 すべては終わりを迎える。"}, {"type": "subtitle", "time": 1195.11, "timestamp": "00:19:55", "text": "面白い。"}, {"type": "subtitle", "time": 1197.029, "timestamp": "00:19:57", "text": "もう愛はない。"}]
[{"type": "subtitle", "time": 4985.11, "timestamp": "01:23:05", "text": "明日またプレイします。 今日はゆっくり休むことにします。"}, {"type": "subtitle", "time": 4987.43, "timestamp": "01:23:07", "text": "ああ、"}, {"type": "subtitle", "time": 4990.629, "timestamp": "01:23:10", "text": "ちょっと眠いな。"}, {"type": "subtitle", "time": 4993.03, "timestamp": "01:23:13", "text": "今日は長い一日だったので、ゆっくり休みます。"}, {"type": "subtitle", "time": 4998.87, "timestamp": "01:23:18", "text": "本日はお越しいただきありがとうございました。 それは本当に本当に大きな"}, {"type": "subtitle", "time": 5001.91, "timestamp": "01:23:21", "text": "意味がありました。 えっと、"}, {"type": "subtitle", "time": 5007.27, "timestamp": "01:23:27", "text": "夜みたいなこの時間帯には配信しないんだけど、すごく疲れてるから。 それでも、立ち寄ってくださって"}, {"type": "subtitle", "time": 5009.51, "timestamp": "01:23:29", "text": "ありがとうございます。 それは"}, {"type": "subtitle", "time": 5011.03, "timestamp": "01:23:31", "text": "本当に大きな意味があります。"}, {"type": "subtitle", "time": 5016.31, "timestamp": "01:23:36", "text": "不思議の国のアリスみたいなところを探検したり、いろいろなものを"}, {"type": "subtitle", "time": 5022.55, "timestamp": "01:23:42", "text": "使ったりするのは楽しかったです。 それは良かった。"}, {"type": "subtitle", "time": 5026.39, "timestamp": "01:23:46", "text": "ええ、ゲンジンは大きく変わりましたね。 信じられない"}, {"type": "subtitle", "time": 5028.709, "timestamp": "01:23:48", "text": "。   まあ"}, {"type": "subtitle", "time": 5030.629, "timestamp": "01:23:50", "text": "、とにかく"}, {"type": "subtitle", "time": 5033.03, "timestamp": "01:23:53", "text": "皆さん、今日はありがとうございました。   それでは、次回お"}]
[{"type": "subtitle", "time": 1141.99, "timestamp": "00:19:01", "text": "我不明白。"}, {"type": "subtitle", "time": 1145.19, "timestamp": "00:19:05", "text": "為永恆森林而戰的叛逆者。森林"}, {"type": "subtitle", "time": 1146.95, "timestamp": "00:19:06", "text": "裡沒有治療師。"}, {"type": "subtitle", "time": 1156.23, "timestamp": "00:19:16", "text": "哦，等等。我曾有過一位治療師。達，"}, {"type": "subtitle", "time": 1173.35, "timestamp": "00:19:33", "text": "陸地巡洋艦。這是什麼？"}, {"type": "subtitle", "time": 1178.87, "timestamp": "00:19:38", "text": "Kaki Kaki 特別款。嗯？"}, {"type": "subtitle", "time": 1181.35, "timestamp": "00:19:41", "text": "裡面有我，Max。喔對，"}, {"type": "subtitle", "time": 1188.87, "timestamp": "00:19:48", "text": "不再說謊。一切都會有結束的時候。"}, {"type": "subtitle", "time": 1195.11, "timestamp": "00:19:55", "text": "有趣的。"}, {"type": "subtitle", "time": 1197.029, "timestamp": "00:19:57", "text": "不再有愛。"}]
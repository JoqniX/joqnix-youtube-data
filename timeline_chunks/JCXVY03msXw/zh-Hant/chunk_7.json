[{"type": "subtitle", "time": 422.71, "timestamp": "00:07:02", "text": "應該關閉藍色協議。"}, {"type": "subtitle", "time": 426.95, "timestamp": "00:07:06", "text": "讓我把這一個東西"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "和"}, {"type": "subtitle", "time": 431.029, "timestamp": "00:07:11", "text": "所有四個都挖出來。"}, {"type": "subtitle", "time": 436.71, "timestamp": "00:07:16", "text": "你看到比賽了嗎？不，你看不到"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "比賽。為什麼？"}, {"type": "subtitle", "time": 441.43, "timestamp": "00:07:21", "text": "詭異的。嗯，"}, {"type": "subtitle", "time": 443.27, "timestamp": "00:07:23", "text": "你為什麼這麼說？你不"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "原神在哪裡？為什麼我抓不到"}, {"type": "subtitle", "time": 452.79, "timestamp": "00:07:32", "text": "肯？原神。什麼？"}, {"type": "subtitle", "time": 459.99, "timestamp": "00:07:39", "text": "這咳嗽讓我想起了"}, {"type": "subtitle", "time": 473.67, "timestamp": "00:07:53", "text": "梅麗莎·梅拉斯特拉在《仙境》中解鎖的另一個人。"}, {"type": "subtitle", "time": 475.909, "timestamp": "00:07:55", "text": "怎麼了？等等，我該如何更換"}]
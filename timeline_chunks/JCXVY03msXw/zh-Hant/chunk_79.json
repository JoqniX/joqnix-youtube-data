[{"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "我能提供的就是更好的武器。  我的天啊。  我的天啊。  哇。  等等，什麼？看看。  嘿，我已經有莫娜了。  搞什麼鬼？什麼？"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "我當時浪費了我的"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "角色"}, {"type": "subtitle", "time": 4766.709, "timestamp": "01:19:26", "text": "道具。  決不。  我什麼時候加入的莫娜"}]
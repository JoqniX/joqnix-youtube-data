[{"type": "subtitle", "time": 618.389, "timestamp": "00:10:18", "text": "我要把這東西弄壞。等待。"}, {"type": "subtitle", "time": 636.63, "timestamp": "00:10:36", "text": "它能用嗎？"}, {"type": "subtitle", "time": 640.389, "timestamp": "00:10:40", "text": "好的。呃，從那以後我就再也沒碰過這個遊戲了"}, {"type": "subtitle", "time": 642.79, "timestamp": "00:10:42", "text": "。呃，我查一下郵件。"}, {"type": "subtitle", "time": 645.509, "timestamp": "00:10:45", "text": "我收到生日獎勵了嗎？"}, {"type": "subtitle", "time": 650.47, "timestamp": "00:10:50", "text": "聖主啊。這是什麼？哦，表情。"}, {"type": "subtitle", "time": 654.15, "timestamp": "00:10:54", "text": "等等，什麼是表達式？"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "呃，"}]
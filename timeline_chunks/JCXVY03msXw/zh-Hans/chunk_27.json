[{"type": "subtitle", "time": 1654.149, "timestamp": "00:27:34", "text": "我挺喜欢默认设置的。 是吗？"}, {"type": "subtitle", "time": 1657.029, "timestamp": "00:27:37", "text": "我不知道。"}, {"type": "subtitle", "time": 1666.23, "timestamp": "00:27:46", "text": "我也不知道为什么喜欢那样。   致以最"}, {"type": "subtitle", "time": 1668.07, "timestamp": "00:27:48", "text": "诚挚的问候，旅行者。   致以最"}, {"type": "subtitle", "time": 1671.43, "timestamp": "00:27:51", "text": "诚挚的问候，旅行者。"}]
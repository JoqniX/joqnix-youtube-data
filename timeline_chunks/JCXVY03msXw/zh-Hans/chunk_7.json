[{"type": "subtitle", "time": 422.71, "timestamp": "00:07:02", "text": "应该关闭蓝色协议。"}, {"type": "subtitle", "time": 426.95, "timestamp": "00:07:06", "text": "让我把这一个东西"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "和"}, {"type": "subtitle", "time": 431.029, "timestamp": "00:07:11", "text": "所有四个都挖出来。"}, {"type": "subtitle", "time": 436.71, "timestamp": "00:07:16", "text": "你看到比赛了吗？ 不，你看不到"}, {"type": "subtitle", "time": 439.189, "timestamp": "00:07:19", "text": "比赛。 为什么？"}, {"type": "subtitle", "time": 441.43, "timestamp": "00:07:21", "text": "诡异的。 嗯，"}, {"type": "subtitle", "time": 443.27, "timestamp": "00:07:23", "text": "你为什么这么说？ 你不"}, {"type": "subtitle", "time": 450.07, "timestamp": "00:07:30", "text": "原神在哪里？ 为什么我抓不到"}, {"type": "subtitle", "time": 452.79, "timestamp": "00:07:32", "text": "肯？ 原神。 什么？"}, {"type": "subtitle", "time": 459.99, "timestamp": "00:07:39", "text": "这咳嗽让我想起了"}, {"type": "subtitle", "time": 473.67, "timestamp": "00:07:53", "text": "梅丽莎·梅拉斯特拉在《仙境》中解锁的另一个人。"}, {"type": "subtitle", "time": 475.909, "timestamp": "00:07:55", "text": "怎么了？ 等等，我该如何更换"}]
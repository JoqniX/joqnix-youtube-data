[{"type": "subtitle", "time": 2303.27, "timestamp": "00:38:23", "text": "你最近在忙些什么？ 你好，Swag Sugar。"}, {"type": "subtitle", "time": 2306.55, "timestamp": "00:38:26", "text": "欢迎。 欢迎来到迪奥。"}, {"type": "subtitle", "time": 2309.349, "timestamp": "00:38:29", "text": "好久不见。 就像你两天前最后一次来看"}, {"type": "subtitle", "time": 2311.91, "timestamp": "00:38:31", "text": "直播一样"}, {"type": "subtitle", "time": 2327.99, "timestamp": "00:38:47", "text": "我……你忘了它"}, {"type": "subtitle", "time": 2335.91, "timestamp": "00:38:55", "text": "两天前（21号）来过吗？"}]
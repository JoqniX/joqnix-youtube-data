[{"type": "subtitle", "time": 1320.549, "timestamp": "00:22:00", "text": "嗯，哦，"}, {"type": "subtitle", "time": 1323.909, "timestamp": "00:22:03", "text": "对了，Alex，"}, {"type": "subtitle", "time": 1325.83, "timestamp": "00:22:05", "text": "完成神秘任务帕里斯姆后，你就会再次……"}, {"type": "subtitle", "time": 1334.87, "timestamp": "00:22:14", "text": "想象一下，如果你相信的话，"}, {"type": "subtitle", "time": 1337.909, "timestamp": "00:22:17", "text": "在这个宇宙中还存在着一个完全不同的世界。"}, {"type": "subtitle", "time": 1339.27, "timestamp": "00:22:19", "text": "我打算花一整天时间。 小心。"}, {"type": "subtitle", "time": 1341.35, "timestamp": "00:22:21", "text": "你好。 小心。 感谢您的光临，祝您"}, {"type": "subtitle", "time": 1343.59, "timestamp": "00:22:23", "text": "工作顺利。 极乐[音乐]，如同"}, {"type": "subtitle", "time": 1346.07, "timestamp": "00:22:26", "text": "清醒"}, {"type": "subtitle", "time": 1347.669, "timestamp": "00:22:27", "text": "梦境一般。"}, {"type": "subtitle", "time": 1350.31, "timestamp": "00:22:30", "text": "现实变得模糊不清，"}, {"type": "subtitle", "time": 1353.83, "timestamp": "00:22:33", "text": "或者说，被重新定义了。"}, {"type": "subtitle", "time": 1355.59, "timestamp": "00:22:35", "text": "但是，在他们完美无瑕的"}, {"type": "subtitle", "time": 1358.63, "timestamp": "00:22:38", "text": "现实世界之外，物质世界的问题依然"}, {"type": "subtitle", "time": 1361.35, "timestamp": "00:22:41", "text": "存在。"}, {"type": "subtitle", "time": 1364.549, "timestamp": "00:22:44", "text": "最终，他们逃离的"}, {"type": "subtitle", "time": 1367.75, "timestamp": "00:22:47", "text": "现实世界中，残酷的真相还是追上了他们"}, {"type": "subtitle", "time": 1370.71, "timestamp": "00:22:50", "text": "。"}, {"type": "subtitle", "time": 1371.43, "timestamp": "00:22:51", "text": "嗯。"}, {"type": "subtitle", "time": 1374.39, "timestamp": "00:22:54", "text": "在黑暗的废墟深处，另一个"}, {"type": "subtitle", "time": 1376.16, "timestamp": "00:22:56", "text": "逃离毁灭的灵魂发现了"}]
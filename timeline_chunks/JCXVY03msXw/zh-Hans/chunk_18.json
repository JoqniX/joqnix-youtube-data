[{"type": "subtitle", "time": 1093.99, "timestamp": "00:18:13", "text": "？ 这个游戏里有食尸鬼。"}, {"type": "subtitle", "time": 1098.07, "timestamp": "00:18:18", "text": "这款游戏改变了格局。"}, {"type": "subtitle", "time": 1099.27, "timestamp": "00:18:19", "text": "骗局结束了。"}, {"type": "subtitle", "time": 1103.43, "timestamp": "00:18:23", "text": "我获得了一颗原始宝石。"}, {"type": "subtitle", "time": 1125.27, "timestamp": "00:18:45", "text": "[呻吟]"}, {"type": "subtitle", "time": 1126.71, "timestamp": "00:18:46", "text": "真相是藏不住的。"}]
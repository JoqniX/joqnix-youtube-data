[{"type": "subtitle", "time": 4744.39, "timestamp": "01:19:04", "text": "我什么时候添加的莫娜？ 妈的。"}, {"type": "subtitle", "time": 4746.79, "timestamp": "01:19:06", "text": "我的天啊。 我真笨。 我本来可以像"}, {"type": "subtitle", "time": 4750.39, "timestamp": "01:19:10", "text": "其他人一样选择一些东西，但我"}, {"type": "subtitle", "time": 4753.75, "timestamp": "01:19:13", "text": "真是个怪胎。"}, {"type": "subtitle", "time": 4756.55, "timestamp": "01:19:16", "text": "没关系。"}, {"type": "subtitle", "time": 4760.31, "timestamp": "01:19:20", "text": "我记得这件事。 我随意打开了"}, {"type": "subtitle", "time": 4762.95, "timestamp": "01:19:22", "text": "原神，只是想抽五星角色，结果"}, {"type": "subtitle", "time": 4768.709, "timestamp": "01:19:28", "text": "在他们都没检查我"}, {"type": "subtitle", "time": 4797.35, "timestamp": "01:19:57", "text": "兰。   那"}]
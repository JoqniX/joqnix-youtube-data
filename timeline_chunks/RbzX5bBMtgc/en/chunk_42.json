[{"type": "subtitle", "time": 2535.109, "timestamp": "00:42:15", "text": "[Music]"}, {"type": "subtitle", "time": 2538.23, "timestamp": "00:42:18", "text": "Hey, Chief. We've been hiding in the"}, {"type": "subtitle", "time": 2541.47, "timestamp": "00:42:21", "text": "vents all day. Our legs are still"}, {"type": "subtitle", "time": 2544.309, "timestamp": "00:42:24", "text": "asleep. Even livestock have it easier"}, {"type": "subtitle", "time": 2546.71, "timestamp": "00:42:26", "text": "than this. Can't you show some drive for"}, {"type": "subtitle", "time": 2549.51, "timestamp": "00:42:29", "text": "once?"}, {"type": "subtitle", "time": 2559.43, "timestamp": "00:42:39", "text": "I can't take it anymore. I haven't slept"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "properly in days. Even the doctor told"}, {"type": "subtitle", "time": 2564.71, "timestamp": "00:42:44", "text": "me to rest. Stop whining and get to"}, {"type": "subtitle", "time": 2567.87, "timestamp": "00:42:47", "text": "work. The boss will be here any"}]
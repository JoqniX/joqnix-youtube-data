[{"type": "subtitle", "time": 15904.03, "timestamp": "04:25:04", "text": "Thanks. The young orphan girl carried"}, {"type": "subtitle", "time": 15908.189, "timestamp": "04:25:08", "text": "on. Everywhere she looked, tragedies"}, {"type": "subtitle", "time": 15912.469, "timestamp": "04:25:12", "text": "rampant as lament engulfed the globe. A"}, {"type": "subtitle", "time": 15915.429, "timestamp": "04:25:15", "text": "world torn by monsters filled with"}, {"type": "subtitle", "time": 15918.87, "timestamp": "04:25:18", "text": "homeless souls. With her own blood as"}, {"type": "subtitle", "time": 15921.52, "timestamp": "04:25:21", "text": "fire, she drove away the"}, {"type": "subtitle", "time": 15923.469, "timestamp": "04:25:23", "text": "[Music]"}, {"type": "subtitle", "time": 15927.269, "timestamp": "04:25:27", "text": "cold. And her master said, \"In this"}, {"type": "subtitle", "time": 15930.229, "timestamp": "04:25:30", "text": "tumultuous world, lives are fragile as"}, {"type": "subtitle", "time": 15931.469, "timestamp": "04:25:31", "text": "may"}, {"type": "subtitle", "time": 15934.79, "timestamp": "04:25:34", "text": "flies. She couldn't exhaust herself to"}, {"type": "subtitle", "time": 15937.75, "timestamp": "04:25:37", "text": "save those before her."}, {"type": "subtitle", "time": 15939.389, "timestamp": "04:25:39", "text": "But she must"}, {"type": "subtitle", "time": 15950.87, "timestamp": "04:25:50", "text": "A she wielded her wits to evade harm,"}, {"type": "subtitle", "time": 15955.03, "timestamp": "04:25:55", "text": "treading on knives with care. Alone yet"}, {"type": "subtitle", "time": 15956.58, "timestamp": "04:25:56", "text": "maturing through"}, {"type": "subtitle", "time": 15957.95, "timestamp": "04:25:57", "text": "[Music]"}]
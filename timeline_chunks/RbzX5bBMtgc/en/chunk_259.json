[{"type": "subtitle", "time": 15541.51, "timestamp": "04:19:01", "text": "Don't worry, Rover. We are only having a"}, {"type": "subtitle", "time": 15545.189, "timestamp": "04:19:05", "text": "casual conversation today. Besides, you"}, {"type": "subtitle", "time": 15549.229, "timestamp": "04:19:09", "text": "only agreed to join me here for more."}, {"type": "subtitle", "time": 15554.309, "timestamp": "04:19:14", "text": "Oh, sure. Ask away. I'm h it all started"}, {"type": "subtitle", "time": 15555.63, "timestamp": "04:19:15", "text": "a century"}, {"type": "subtitle", "time": 15559.59, "timestamp": "04:19:19", "text": "ago. During a TD outbreak, my master was"}, {"type": "subtitle", "time": 15563.189, "timestamp": "04:19:23", "text": "rescued by that individual. She exuded a"}, {"type": "subtitle", "time": 15567.03, "timestamp": "04:19:27", "text": "unique energy and was always elusive."}, {"type": "subtitle", "time": 15569.75, "timestamp": "04:19:29", "text": "My master dug through after searching"}, {"type": "subtitle", "time": 15572.79, "timestamp": "04:19:32", "text": "for several years. He finally met that"}, {"type": "subtitle", "time": 15576.309, "timestamp": "04:19:36", "text": "person on Mount Ferment again. Okay."}, {"type": "subtitle", "time": 15578.55, "timestamp": "04:19:38", "text": "First, I thought my master meant the"}, {"type": "subtitle", "time": 15581.03, "timestamp": "04:19:41", "text": "game record held actual information"}, {"type": "subtitle", "time": 15584.07, "timestamp": "04:19:44", "text": "about the time crisis, but that was just"}, {"type": "subtitle", "time": 15584.83, "timestamp": "04:19:44", "text": "a"}, {"type": "subtitle", "time": 15588.229, "timestamp": "04:19:48", "text": "clue. And lastly, the secret of"}, {"type": "subtitle", "time": 15590.149, "timestamp": "04:19:50", "text": "immortality."}, {"type": "subtitle", "time": 15593.309, "timestamp": "04:19:53", "text": "There's a wood cut there. It's not"}]
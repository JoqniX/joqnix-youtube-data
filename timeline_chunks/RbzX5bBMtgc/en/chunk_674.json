[{"type": "subtitle", "time": 40444.51, "timestamp": "11:14:04", "text": "then this one"}, {"type": "subtitle", "time": 40457.55, "timestamp": "11:14:17", "text": "monkey."}, {"type": "subtitle", "time": 40461.9, "timestamp": "11:14:21", "text": "Only wanted to bring my children."}, {"type": "subtitle", "time": 40484.95, "timestamp": "11:14:44", "text": "I shall deliver a generous compliment to"}, {"type": "subtitle", "time": 40486.85, "timestamp": "11:14:46", "text": "our captain."}]
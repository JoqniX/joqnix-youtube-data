[{"type": "subtitle", "time": 10441.269, "timestamp": "02:54:01", "text": "shocked to see how much time had passed."}, {"type": "subtitle", "time": 10442.95, "timestamp": "02:54:02", "text": "\"It couldn't have been more than 2"}, {"type": "subtitle", "time": 10444.59, "timestamp": "02:54:04", "text": "hours,\" he thought in"}, {"type": "subtitle", "time": 10447.11, "timestamp": "02:54:07", "text": "disbelief. Feeling apologetic, he"}, {"type": "subtitle", "time": 10449.99, "timestamp": "02:54:09", "text": "prepared to leave. Worried that the guru"}, {"type": "subtitle", "time": 10453.03, "timestamp": "02:54:13", "text": "would be annoyed with him."}, {"type": "subtitle", "time": 10455.23, "timestamp": "02:54:15", "text": "[Music]"}, {"type": "subtitle", "time": 10457.19, "timestamp": "02:54:17", "text": "Huh?"}, {"type": "subtitle", "time": 10459.51, "timestamp": "02:54:19", "text": "But when the wood cutter turned around,"}, {"type": "subtitle", "time": 10463.19, "timestamp": "02:54:23", "text": "he nearly jumped out of his skin. The"}, {"type": "subtitle", "time": 10465.91, "timestamp": "02:54:25", "text": "hermit guru who had been playing wchi"}, {"type": "subtitle", "time": 10468.67, "timestamp": "02:54:28", "text": "and drinking wine was now"}, {"type": "subtitle", "time": 10472.07, "timestamp": "02:54:32", "text": "gone. In his place lay a shattered wichi"}, {"type": "subtitle", "time": 10475.71, "timestamp": "02:54:35", "text": "board and a heap of decaying"}, {"type": "subtitle", "time": 10478.469, "timestamp": "02:54:38", "text": "bones. The wood cutter was so scared"}, {"type": "subtitle", "time": 10480.55, "timestamp": "02:54:40", "text": "that he dropped his bamboo basket and"}, {"type": "subtitle", "time": 10482.55, "timestamp": "02:54:42", "text": "ran down the mountain without even"}, {"type": "subtitle", "time": 10485.59, "timestamp": "02:54:45", "text": "looking back."}, {"type": "subtitle", "time": 10488.23, "timestamp": "02:54:48", "text": "As he reached the mountains base, he was"}, {"type": "subtitle", "time": 10490.59, "timestamp": "02:54:50", "text": "hit with a stark"}, {"type": "subtitle", "time": 10492.79, "timestamp": "02:54:52", "text": "realization. The quaint village he"}, {"type": "subtitle", "time": 10495.51, "timestamp": "02:54:55", "text": "remembered had bloomed into a bustling"}, {"type": "subtitle", "time": 10498.87, "timestamp": "02:54:58", "text": "town with sturdy brick houses replacing"}]
[{"type": "subtitle", "time": 12125.87, "timestamp": "03:22:05", "text": "現在屬於你了。"}, {"type": "subtitle", "time": 12135.469, "timestamp": "03:22:15", "text": "目標。讓我們抹去戰爭的痕跡。  與時間的戰爭。"}, {"type": "subtitle", "time": 12146.07, "timestamp": "03:22:26", "text": "戰爭中無所不用其極。  哦，拜託。  是時候結束了"}, {"type": "subtitle", "time": 12176.229, "timestamp": "03:22:56", "text": "。苦難隨之而來。  Target 允許活狗參與戰爭。  我的專業領域。  別眨眼"}]
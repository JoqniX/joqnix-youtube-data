[{"type": "subtitle", "time": 27063.708, "timestamp": "07:31:03", "text": "我覺得老虎莫那邊就只剩下一個區域了。 下一個區域在電影院後面，就像個假的。我在做任務。"}, {"type": "subtitle", "time": 27073.91, "timestamp": "07:31:13", "text": "哦，有個戰鬥事件。我意識到我其實可以"}, {"type": "subtitle", "time": 27085.11, "timestamp": "07:31:25", "text": "抽卡，但"}, {"type": "subtitle", "time": 27096.27, "timestamp": "07:31:36", "text": "我還需要一些星石。 ……呃……老鼠女士。沒問題。看我的模特兒和她的。當"}, {"type": "subtitle", "time": 27111.59, "timestamp": "07:31:51", "text": "們拿到女孩的模型時，我就可以發布模特兒設計了。己決定這只是為了炫耀"}]
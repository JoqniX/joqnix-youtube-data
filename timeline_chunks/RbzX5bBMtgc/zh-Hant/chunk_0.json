[{"type": "subtitle", "time": 6.71, "timestamp": "00:00:06", "text": "歡迎大家收看 Jakathon 第 52 天"}, {"type": "subtitle", "time": 12.509, "timestamp": "00:00:12", "text": "直播。歡迎"}, {"type": "subtitle", "time": 20.87, "timestamp": "00:00:20", "text": "活著嗎？我正在直播。你好。歡迎來到"}, {"type": "subtitle", "time": 23.91, "timestamp": "00:00:23", "text": "Joathon 第 52 天第二部分直播。"}, {"type": "subtitle", "time": 27.91, "timestamp": "00:00:27", "text": "夜溪。今晚我們將"}, {"type": "subtitle", "time": 30.23, "timestamp": "00:00:30", "text": "演奏《枯萎的飛躍》。"}, {"type": "subtitle", "time": 32.51, "timestamp": "00:00:32", "text": "最後我們打算一起待一會兒，"}, {"type": "subtitle", "time": 34.79, "timestamp": "00:00:34", "text": "好嗎？我要早點睡，"}, {"type": "subtitle", "time": 37.35, "timestamp": "00:00:37", "text": "因為明天是合作日。我們獲得了"}, {"type": "subtitle", "time": 39.83, "timestamp": "00:00:39", "text": "兩個合作機會。我們和我們一起進行了地獄"}, {"type": "subtitle", "time": 42.47, "timestamp": "00:00:42", "text": "潛水，地獄潛水員與 ve 合作，我們也"}, {"type": "subtitle", "time": 44.709, "timestamp": "00:00:44", "text": "和許多"}, {"type": "subtitle", "time": 48.029, "timestamp": "00:00:48", "text": "朋友一起進行了森林合作。所以我對此感到很興奮"}, {"type": "subtitle", "time": 51.95, "timestamp": "00:00:51", "text": "。讓我們"}]
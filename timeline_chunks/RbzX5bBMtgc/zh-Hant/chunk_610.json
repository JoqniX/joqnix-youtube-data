[{"type": "subtitle", "time": 36647.63, "timestamp": "10:10:47", "text": "一道火花在黑暗的虛空中蕩漾開來，如同淚珠濺入泥濘的池塘"}, {"type": "subtitle", "time": 36651.35, "timestamp": "10:10:51", "text": "。遠處的光亮中似乎有人在呼喚她。"}, {"type": "subtitle", "time": 36653.426, "timestamp": "10:10:53", "text": "這聲音既陌生又熟悉。羅尼亞伸手去夠燈。就是那個問號。她看到燈光微微"}, {"type": "subtitle", "time": 36657.83, "timestamp": "10:10:57", "text": "閃爍了一下。"}, {"type": "subtitle", "time": 36659.99, "timestamp": "10:10:59", "text": "光芒越來越強，"}]
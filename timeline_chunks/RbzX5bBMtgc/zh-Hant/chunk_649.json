[{"type": "subtitle", "time": 38943.906, "timestamp": "10:49:03", "text": "。  睡眠戰利品"}, {"type": "subtitle", "time": 38947.35, "timestamp": "10:49:07", "text": "也已經升級到 50 級了。  還有 40。"}, {"type": "subtitle", "time": 38978.95, "timestamp": "10:49:38", "text": "需要等待嗎？不需要。是的。是的。 40是上限。  你呢？這是什麼？好了，我們"}, {"type": "subtitle", "time": 38987.11, "timestamp": "10:49:47", "text": "小便嗎？"}]
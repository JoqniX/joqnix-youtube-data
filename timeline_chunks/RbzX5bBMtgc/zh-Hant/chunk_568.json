[{"type": "subtitle", "time": 34081.67, "timestamp": "09:28:01", "text": "我的天哪！（掌聲）不，她會死的。她要死了"}, {"type": "subtitle", "time": 34083.23, "timestamp": "09:28:03", "text": "。"}, {"type": "subtitle", "time": 34092.11, "timestamp": "09:28:12", "text": "她要死了。不，不，不，不，不。這很糟糕。這很糟糕。這很糟糕。 “返回”功能在這裡不起作用。我的天啊。為什麼現在這裡無法工作"}]
[{"type": "subtitle", "time": 5000.07, "timestamp": "01:23:20", "text": "等等"}, {"type": "subtitle", "time": 5003.189, "timestamp": "01:23:23", "text": "，她為什麼這麼酷？就是這樣。我難道不能對抗更多敵人嗎？挺酷的。"}, {"type": "subtitle", "time": 5008.149, "timestamp": "01:23:28", "text": "我帶她來只是因為我最喜歡的樂團音樂二人組 MTL City 為 Withering Waves 創作了音樂，他們也為"}, {"type": "subtitle", "time": 5010.87, "timestamp": "01:23:30", "text": "Fobi 創作了原聲帶。所以這就是為什麼"}, {"type": "subtitle", "time": 5012.31, "timestamp": "01:23:32", "text": "我一直想著我必須得到福比。"}, {"type": "subtitle", "time": 5018.55, "timestamp": "01:23:38", "text": "一定要得到她。哦，停在第三位就行了。好的，明白了。太好了。"}, {"type": "subtitle", "time": 5024.149, "timestamp": "01:23:44", "text": "我或許真的能追到她。我或許真的能追到她。我不知道。等等，"}, {"type": "subtitle", "time": 5027.35, "timestamp": "01:23:47", "text": "我想確認一下"}]
[{"type": "subtitle", "time": 15247.91, "timestamp": "04:14:07", "text": "海浪。  我的天啊。哦，"}, {"type": "subtitle", "time": 15263.83, "timestamp": "04:14:23", "text": "謝謝你送我這個東西。"}, {"type": "subtitle", "time": 15268.03, "timestamp": "04:14:28", "text": "哦，謝謝。謝謝。謝謝。謝謝。謝謝。我這就把它置頂。"}, {"type": "subtitle", "time": 15273.03, "timestamp": "04:14:33", "text": "好的。如何把它釘起來？"}, {"type": "subtitle", "time": 15288.57, "timestamp": "04:14:48", "text": "哇。這就是世界。"}]
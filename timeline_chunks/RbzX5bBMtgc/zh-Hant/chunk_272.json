[{"type": "subtitle", "time": 16324.0, "timestamp": "04:32:04", "text": "蓬勃發展。因為我為了參加活動而創作了這幅畫，所以它和可愛（kawai）現在能夠共存"}, {"type": "subtitle", "time": 16365.98, "timestamp": "04:32:45", "text": "。等等，是哪個活動？"}, {"type": "subtitle", "time": 16368.87, "timestamp": "04:32:48", "text": "主播活動。"}, {"type": "subtitle", "time": 16371.0, "timestamp": "04:32:51", "text": "哦，對，確實有這回事。我忘了。"}]
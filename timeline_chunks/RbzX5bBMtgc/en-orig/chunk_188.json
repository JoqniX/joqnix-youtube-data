[{"type": "subtitle", "time": 11295.19, "timestamp": "03:08:15", "text": "I was just going to try to get the"}, {"type": "subtitle", "time": 11305.15, "timestamp": "03:08:25", "text": "lord."}, {"type": "subtitle", "time": 11315.59, "timestamp": "03:08:35", "text": "Hopefully we'll make time for another"}, {"type": "subtitle", "time": 11318.79, "timestamp": "03:08:38", "text": "adventure. I see my way clear. I'll do"}, {"type": "subtitle", "time": 11333.59, "timestamp": "03:08:53", "text": "Understood. I am here to serve your"}, {"type": "subtitle", "time": 11335.79, "timestamp": "03:08:55", "text": "will. I should try to smile more. You"}, {"type": "subtitle", "time": 11339.51, "timestamp": "03:08:59", "text": "say like this."}]
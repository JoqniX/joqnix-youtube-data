[{"type": "subtitle", "time": 33906.03, "timestamp": "09:25:06", "text": "this? She just"}, {"type": "subtitle", "time": 33914.55, "timestamp": "09:25:14", "text": "The fluttering blue waterfall settled on"}, {"type": "subtitle", "time": 33916.906, "timestamp": "09:25:16", "text": "Bona's"}, {"type": "subtitle", "time": 33919.266, "timestamp": "09:25:19", "text": "fingertips. Wow. She supported her"}, {"type": "subtitle", "time": 33921.99, "timestamp": "09:25:21", "text": "broken body and wedged towards the"}, {"type": "subtitle", "time": 33923.39, "timestamp": "09:25:23", "text": "harsher"}, {"type": "subtitle", "time": 33927.426, "timestamp": "09:25:27", "text": "core. Her core sea flurred with images"}, {"type": "subtitle", "time": 33930.07, "timestamp": "09:25:30", "text": "from the multiple bubble universes as"}, {"type": "subtitle", "time": 33933.0, "timestamp": "09:25:33", "text": "though she traveled across them."}, {"type": "subtitle", "time": 33934.83, "timestamp": "09:25:34", "text": "[Music]"}, {"type": "subtitle", "time": 33942.91, "timestamp": "09:25:42", "text": "Everything was really real at some"}, {"type": "subtitle", "time": 33945.79, "timestamp": "09:25:45", "text": "[Music]"}, {"type": "subtitle", "time": 33951.31, "timestamp": "09:25:51", "text": "point. Her steps became more and more"}, {"type": "subtitle", "time": 33954.23, "timestamp": "09:25:54", "text": "labored, but she will continue to trudge"}]
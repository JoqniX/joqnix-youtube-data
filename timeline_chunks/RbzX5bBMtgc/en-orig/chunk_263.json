[{"type": "subtitle", "time": 15781.59, "timestamp": "04:23:01", "text": "itself."}, {"type": "subtitle", "time": 15785.95, "timestamp": "04:23:05", "text": "A moment of companionship and"}, {"type": "subtitle", "time": 15790.95, "timestamp": "04:23:10", "text": "protection meant everything to me."}, {"type": "subtitle", "time": 15792.189, "timestamp": "04:23:12", "text": "What a"}, {"type": "subtitle", "time": 15795.79, "timestamp": "04:23:15", "text": "cry. What a cry. Sense your unspoken"}, {"type": "subtitle", "time": 15798.95, "timestamp": "04:23:18", "text": "question. Did I sacrifice my life when I"}, {"type": "subtitle", "time": 15800.189, "timestamp": "04:23:20", "text": "burned down the"}, {"type": "subtitle", "time": 15803.389, "timestamp": "04:23:23", "text": "Sonarosphere like when I was a"}, {"type": "subtitle", "time": 15806.95, "timestamp": "04:23:26", "text": "child? What I told you there was true,"}, {"type": "subtitle", "time": 15809.349, "timestamp": "04:23:29", "text": "but I've grown and gained control over"}, {"type": "subtitle", "time": 15813.269, "timestamp": "04:23:33", "text": "my powers. Using my forte now won't harm"}, {"type": "subtitle", "time": 15816.149, "timestamp": "04:23:36", "text": "me in any way. Of that you can rest"}, {"type": "subtitle", "time": 15818.469, "timestamp": "04:23:38", "text": "assured."}, {"type": "subtitle", "time": 15820.59, "timestamp": "04:23:40", "text": "Oh god."}, {"type": "subtitle", "time": 15823.99, "timestamp": "04:23:43", "text": "Also, if you really are the legendary"}, {"type": "subtitle", "time": 15826.429, "timestamp": "04:23:46", "text": "person who changed the course of"}, {"type": "subtitle", "time": 15829.269, "timestamp": "04:23:49", "text": "history, then you are perhaps the"}, {"type": "subtitle", "time": 15830.51, "timestamp": "04:23:50", "text": "closest to"}, {"type": "subtitle", "time": 15834.389, "timestamp": "04:23:54", "text": "immortality aside from our sentinel."}, {"type": "subtitle", "time": 15838.149, "timestamp": "04:23:58", "text": "Oh, we mortals come and go. Our lives"}]
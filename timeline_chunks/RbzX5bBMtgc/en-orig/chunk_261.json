[{"type": "subtitle", "time": 15660.149, "timestamp": "04:21:00", "text": "Ah, precisely. The only way to escape"}, {"type": "subtitle", "time": 15663.11, "timestamp": "04:21:03", "text": "was by burning the Sonorosphere without"}, {"type": "subtitle", "time": 15665.429, "timestamp": "04:21:05", "text": "hurting anyone inside."}, {"type": "subtitle", "time": 15669.75, "timestamp": "04:21:09", "text": "It required masterful control of Forte."}, {"type": "subtitle", "time": 15673.189, "timestamp": "04:21:13", "text": "Thinking back, it was probably his"}, {"type": "subtitle", "time": 15680.469, "timestamp": "04:21:20", "text": "That was his first goal with this"}, {"type": "subtitle", "time": 15682.79, "timestamp": "04:21:22", "text": "Sonorosphere."}, {"type": "subtitle", "time": 15685.349, "timestamp": "04:21:25", "text": "Second one."}, {"type": "subtitle", "time": 15688.389, "timestamp": "04:21:28", "text": "Before leaving, master entrusted me with"}, {"type": "subtitle", "time": 15692.469, "timestamp": "04:21:32", "text": "a mission to find that individual. The"}, {"type": "subtitle", "time": 15695.269, "timestamp": "04:21:35", "text": "one who played Wii with him. The one who"}, {"type": "subtitle", "time": 15699.349, "timestamp": "04:21:39", "text": "left behind that game record. came."}, {"type": "subtitle", "time": 15702.149, "timestamp": "04:21:42", "text": "After my master's passing, she would be"}, {"type": "subtitle", "time": 15704.75, "timestamp": "04:21:44", "text": "the only one who could control the"}, {"type": "subtitle", "time": 15707.99, "timestamp": "04:21:47", "text": "Sonarosphere. By now, you should know"}, {"type": "subtitle", "time": 15711.55, "timestamp": "04:21:51", "text": "who she is. That is"}, {"type": "subtitle", "time": 15715.189, "timestamp": "04:21:55", "text": "me. Is it me?"}]
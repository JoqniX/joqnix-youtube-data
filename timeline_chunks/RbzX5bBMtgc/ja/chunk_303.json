[{"type": "subtitle", "time": 18180.47, "timestamp": "05:03:00", "text": "何か。そして、それはある意味、"}, {"type": "subtitle", "time": 18183.67, "timestamp": "05:03:03", "text": "私の新しい非人間に似ているように見える、"}, {"type": "subtitle", "time": 18186.07, "timestamp": "05:03:06", "text": "そうでしょう？若干。流れるような"}, {"type": "chat", "time": 18190.398, "timestamp": "05:03:10", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "phoebe reminds me of noelani"}, {"type": "chat", "time": 18193.317, "timestamp": "05:03:13", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "lol"}, {"type": "subtitle", "time": 18197.75, "timestamp": "05:03:17", "text": "自分自身。そう、流れるような流れるような模様"}, {"type": "subtitle", "time": 18206.11, "timestamp": "05:03:26", "text": "自分自身。"}, {"type": "chat", "time": 18207.64, "timestamp": "05:03:27", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "you just missed the cantarella banner"}, {"type": "subtitle", "time": 18209.99, "timestamp": "05:03:29", "text": "ええ、私のモデルと"}, {"type": "subtitle", "time": 18213.03, "timestamp": "05:03:33", "text": "彼女 ええ、色があります"}, {"type": "subtitle", "time": 18214.948, "timestamp": "05:03:34", "text": "違い。"}, {"type": "chat", "time": 18215.589, "timestamp": "05:03:35", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "god knows when it'll be back"}, {"type": "subtitle", "time": 18217.59, "timestamp": "05:03:37", "text": "私のは紫色に近い"}, {"type": "subtitle", "time": 18222.27, "timestamp": "05:03:42", "text": "ピンクがかった面。その間、"}, {"type": "subtitle", "time": 18226.55, "timestamp": "05:03:46", "text": "カンタレラは青みがかった色合いです。それ"}, {"type": "subtitle", "time": 18230.27, "timestamp": "05:03:50", "text": "ジョックの最初の移植のように見える"}, {"type": "subtitle", "time": 18233.91, "timestamp": "05:03:53", "text": "モデル。最初の草稿は青色だった。そこには"}, {"type": "subtitle", "time": 18236.628, "timestamp": "05:03:56", "text": "青色バージョンと紫色バージョン。私"}]
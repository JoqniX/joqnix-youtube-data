[{"type": "subtitle", "time": 27481.75, "timestamp": "07:38:01", "text": "使用。彼女は私にとって最高の存在だろうか？彼女は私の"}, {"type": "subtitle", "time": 27486.83, "timestamp": "07:38:06", "text": "最高。よし、これをこれに交換しよう"}, {"type": "subtitle", "time": 27488.83, "timestamp": "07:38:08", "text": "男。"}, {"type": "subtitle", "time": 27492.83, "timestamp": "07:38:12", "text": "シグマ。良いものを置けるかどうか見てみましょう"}, {"type": "subtitle", "time": 27495.868, "timestamp": "07:38:15", "text": "1つ。そして私はこれで良いと思う。"}, {"type": "subtitle", "time": 27500.388, "timestamp": "07:38:20", "text": "右？うん。そして彼女も。"}, {"type": "subtitle", "time": 27502.59, "timestamp": "07:38:22", "text": "わかった。彼女のは"}, {"type": "subtitle", "time": 27508.15, "timestamp": "07:38:28", "text": "良い。 60 60 70。了解。彼女はどうなの？私"}, {"type": "subtitle", "time": 27511.59, "timestamp": "07:38:31", "text": "彼女の武器は50点取ったと思う。うん。良い、"}, {"type": "subtitle", "time": 27514.03, "timestamp": "07:38:34", "text": "よかった、よかった。彼女は"}, {"type": "subtitle", "time": 27516.43, "timestamp": "07:38:36", "text": "強力だ。では"}, {"type": "subtitle", "time": 27520.03, "timestamp": "07:38:40", "text": "彼女？ 24. 拳が必要だ"}, {"type": "subtitle", "time": 27523.75, "timestamp": "07:38:43", "text": "もの。あなたは飛行機に乗るんですね。交換したい"}, {"type": "subtitle", "time": 27524.91, "timestamp": "07:38:44", "text": "それ"}, {"type": "subtitle", "time": 27527.43, "timestamp": "07:38:47", "text": "これ。それは役に立つだろうか？わかりました、交換します"}, {"type": "subtitle", "time": 27531.67, "timestamp": "07:38:51", "text": "それに対して。よし、行こう。立つ。さあ"}]
[{"type": "subtitle", "time": 27401.35, "timestamp": "07:36:41", "text": "[音楽]"}, {"type": "subtitle", "time": 27404.07, "timestamp": "07:36:44", "text": "はい、戻ってきました。戻ってきました。戻ってきたぜ、坊や。"}, {"type": "subtitle", "time": 27410.708, "timestamp": "07:36:50", "text": "ストリーム。温かいお湯を沸かした。私は"}, {"type": "subtitle", "time": 27412.49, "timestamp": "07:36:52", "text": "隠蔽"}]
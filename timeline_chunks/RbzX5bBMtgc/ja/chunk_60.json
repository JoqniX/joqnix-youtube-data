[{"type": "subtitle", "time": 3617.27, "timestamp": "01:00:17", "text": "最後に私たちが一緒にいたのはいつだったかな"}, {"type": "subtitle", "time": 3621.03, "timestamp": "01:00:21", "text": "あの赤毛のツインテールの女性が来たの？"}, {"type": "subtitle", "time": 3626.91, "timestamp": "01:00:26", "text": "[音楽]"}, {"type": "subtitle", "time": 3630.63, "timestamp": "01:00:30", "text": "えっと、その前に"}, {"type": "subtitle", "time": 3632.39, "timestamp": "01:00:32", "text": "神は未来を予見するかもしれない"}, {"type": "subtitle", "time": 3634.47, "timestamp": "01:00:34", "text": "私たちの"}, {"type": "subtitle", "time": 3638.349, "timestamp": "01:00:38", "text": "明日人々が演奏する曲"}, {"type": "subtitle", "time": 3641.589, "timestamp": "01:00:41", "text": "チャメレイアが来る前に。うん。あなたなら"}, {"type": "subtitle", "time": 3644.309, "timestamp": "01:00:44", "text": "理解されたような？私はプレイしました"}, {"type": "subtitle", "time": 3645.63, "timestamp": "01:00:45", "text": "海岸監視員"}, {"type": "subtitle", "time": 3648.39, "timestamp": "01:00:48", "text": "あれ。配信中だったのか、それとも配信外だったのか？"}, {"type": "subtitle", "time": 3656.91, "timestamp": "01:00:56", "text": "私は遊びたかった。彼女は赤毛だ。私"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "明日、どんな人が演奏するのか楽しみだ。私"}]
[{"type": "subtitle", "time": 15243.59, "timestamp": "04:14:03", "text": "気前よく、私に恩返しをしたいと思ったら、"}, {"type": "subtitle", "time": 15245.67, "timestamp": "04:14:05", "text": "フーリングの次の作品を見られることを願っています"}, {"type": "subtitle", "time": 15247.91, "timestamp": "04:14:07", "text": "ハンロンの芸術家たちの特集号。"}, {"type": "subtitle", "time": 15249.99, "timestamp": "04:14:09", "text": "みんなが会えなくて寂しい思いをしていた"}, {"type": "subtitle", "time": 15252.87, "timestamp": "04:14:12", "text": "お気に入りの風景画家たち。あなたは"}, {"type": "subtitle", "time": 15258.389, "timestamp": "04:14:18", "text": "状況が"}, {"type": "subtitle", "time": 15261.429, "timestamp": "04:14:21", "text": "解決しましたので、洪城に戻ってください。"}, {"type": "subtitle", "time": 15263.83, "timestamp": "04:14:23", "text": "あなたはゆっくり休む資格があります。"}, {"type": "subtitle", "time": 15268.03, "timestamp": "04:14:28", "text": "うん。うん。これまで経験してきたことを踏まえて"}, {"type": "subtitle", "time": 15273.03, "timestamp": "04:14:33", "text": "まさに私だ。ええと、シン・イー夫人は"}, {"type": "subtitle", "time": 15275.189, "timestamp": "04:14:35", "text": "対処する際に追加の支援が必要になる"}, {"type": "subtitle", "time": 15283.99, "timestamp": "04:14:43", "text": "素晴らしい。もう遅い時間だ。たぶん私たちは"}, {"type": "subtitle", "time": 15285.83, "timestamp": "04:14:45", "text": "戻ってから話し合うべきだ"}, {"type": "subtitle", "time": 15288.57, "timestamp": "04:14:48", "text": "他に何か。うん。"}, {"type": "subtitle", "time": 15295.51, "timestamp": "04:14:55", "text": "モモ、この国にはやることがたくさんあるよ"}, {"type": "subtitle", "time": 15299.51, "timestamp": "04:14:59", "text": "ゲーム。私は今これをやっているだけです"}]
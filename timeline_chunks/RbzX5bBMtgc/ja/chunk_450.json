[{"type": "subtitle", "time": 27001.83, "timestamp": "07:30:01", "text": "これらの世界はX章です"}, {"type": "subtitle", "time": 27004.628, "timestamp": "07:30:04", "text": "世界3。私たちはこれをしていません。私たちはある意味"}, {"type": "subtitle", "time": 27006.468, "timestamp": "07:30:06", "text": "最後の配信は完全にスキップした"}, {"type": "subtitle", "time": 27007.388, "timestamp": "07:30:07", "text": "最後"}, {"type": "subtitle", "time": 27011.19, "timestamp": "07:30:11", "text": "ホンキー。今日の私の計画は"}, {"type": "subtitle", "time": 27014.628, "timestamp": "07:30:14", "text": "3つの世界のことをすべて終わらせて"}, {"type": "subtitle", "time": 27017.75, "timestamp": "07:30:17", "text": "第11章を終えて、次の章を始めます"}, {"type": "subtitle", "time": 27019.388, "timestamp": "07:30:19", "text": "11例"}, {"type": "subtitle", "time": 27023.59, "timestamp": "07:30:23", "text": "章。そうすれば、あなたは分かると思います"}, {"type": "subtitle", "time": 27025.91, "timestamp": "07:30:25", "text": "第12章も、それを終えた後に読みます。"}, {"type": "subtitle", "time": 27028.708, "timestamp": "07:30:28", "text": "では、まず第〇章に進む必要があります。"}, {"type": "subtitle", "time": 27032.31, "timestamp": "07:30:32", "text": "今日13日、今日までに、どんな方法でも、"}, {"type": "subtitle", "time": 27036.23, "timestamp": "07:30:36", "text": "どういうわけか第13章でどれだけかかるか、"}, {"type": "subtitle", "time": 27039.99, "timestamp": "07:30:39", "text": "少なくとも第12章は目標として"}, {"type": "subtitle", "time": 27042.548, "timestamp": "07:30:42", "text": "今日。そしてもう一つの目標は"}, {"type": "subtitle", "time": 27047.35, "timestamp": "07:30:47", "text": "チャップ、キャプテンレベル15、15じゃないよ。"}, {"type": "subtitle", "time": 27050.868, "timestamp": "07:30:50", "text": "50をゼロで割って、えーと"}, {"type": "subtitle", "time": 27054.03, "timestamp": "07:30:54", "text": "チップスペース"}, {"type": "subtitle", "time": 27056.628, "timestamp": "07:30:56", "text": "イベント。うん。そうすれば"}, {"type": "subtitle", "time": 27059.948, "timestamp": "07:30:59", "text": "チップはイベントに直面する。えっと、それは表示されますか？"}]
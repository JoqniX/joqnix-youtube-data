[{"type": "subtitle", "time": 4575.669, "timestamp": "01:16:15", "text": "[音楽]"}, {"type": "subtitle", "time": 4578.07, "timestamp": "01:16:18", "text": "多波効果。これはつまり"}, {"type": "subtitle", "time": 4580.95, "timestamp": "01:16:20", "text": "シャコナはフィービーにとって必需品です"}, {"type": "subtitle", "time": 4582.709, "timestamp": "01:16:22", "text": "フィービーをプレイしようとしているメインプレイヤー"}, {"type": "subtitle", "time": 4585.59, "timestamp": "01:16:25", "text": "すすり泣く荒野の中で、これは"}, {"type": "subtitle", "time": 4587.189, "timestamp": "01:16:27", "text": "最初にできるキャラクター"}, {"type": "subtitle", "time": 4589.43, "timestamp": "01:16:29", "text": "マルチウェーブでスペクトルフラズルを適用します。そして"}, {"type": "subtitle", "time": 4592.07, "timestamp": "01:16:32", "text": "それがフィービーの一番の問題だった。"}, {"type": "subtitle", "time": 4594.709, "timestamp": "01:16:34", "text": "マルチウェーブコンテンツに対応できない"}, {"type": "subtitle", "time": 4596.47, "timestamp": "01:16:36", "text": "だって、実際には"}, {"type": "subtitle", "time": 4598.31, "timestamp": "01:16:38", "text": "Frazzil を再塗布してください。"}, {"type": "subtitle", "time": 4599.75, "timestamp": "01:16:39", "text": "彼女と"}, {"type": "subtitle", "time": 4602.47, "timestamp": "01:16:42", "text": "ローバー。そして、そう、彼女はとても"}, {"type": "subtitle", "time": 4604.87, "timestamp": "01:16:44", "text": "かわいい。シャカコタはこの問題を解決します"}, {"type": "subtitle", "time": 4607.51, "timestamp": "01:16:47", "text": "完全に、しかもまだ巨大な"}, {"type": "subtitle", "time": 4610.709, "timestamp": "01:16:50", "text": "将来のエラー侵食チームに対する強化。"}, {"type": "subtitle", "time": 4613.11, "timestamp": "01:16:53", "text": "これはまた、カルダが"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "シコナにとって大きなチームメイトになるだろう。"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "そしてシャコナは"}]
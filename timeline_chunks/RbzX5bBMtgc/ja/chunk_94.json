[{"type": "subtitle", "time": 5640.99, "timestamp": "01:34:00", "text": "くそ。ええ、わかってます。ズームを解除しました"}, {"type": "subtitle", "time": 5643.31, "timestamp": "01:34:03", "text": "それ。こんにちは"}, {"type": "subtitle", "time": 5652.709, "timestamp": "01:34:12", "text": "こんにちは、ザニさん。 PBショットキーパー。それはOPですね。"}, {"type": "subtitle", "time": 5655.16, "timestamp": "01:34:15", "text": "最高のコンパス"}, {"type": "subtitle", "time": 5656.35, "timestamp": "01:34:16", "text": "[音楽]"}, {"type": "subtitle", "time": 5660.82, "timestamp": "01:34:20", "text": "これ。私は何をしますか？買うべきでしょうか"}, {"type": "subtitle", "time": 5663.39, "timestamp": "01:34:23", "text": "[音楽]"}, {"type": "subtitle", "time": 5667.59, "timestamp": "01:34:27", "text": "ザニ、兄弟？これは何の広告ですか？停止。私"}, {"type": "subtitle", "time": 5674.99, "timestamp": "01:34:34", "text": "[音楽]"}, {"type": "subtitle", "time": 5679.03, "timestamp": "01:34:39", "text": "追加。表示すらされない。これ"}, {"type": "subtitle", "time": 5681.79, "timestamp": "01:34:41", "text": "Ublockエンジンが起動すらしない"}, {"type": "subtitle", "time": 5685.189, "timestamp": "01:34:45", "text": "上。どうしたの？誰に傷つけられたの？"}, {"type": "subtitle", "time": 5687.229, "timestamp": "01:34:47", "text": "あなた"}, {"type": "subtitle", "time": 5690.629, "timestamp": "01:34:50", "text": "ブロック。私のプラグ延長はどれも"}, {"type": "subtitle", "time": 5692.59, "timestamp": "01:34:52", "text": "ポップアップ、"}]
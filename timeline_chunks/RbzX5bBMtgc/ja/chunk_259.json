[{"type": "subtitle", "time": 15541.51, "timestamp": "04:19:01", "text": "心配しないで、ローバー。私たちはただ"}, {"type": "subtitle", "time": 15545.189, "timestamp": "04:19:05", "text": "今日の何気ない会話。それに、"}, {"type": "subtitle", "time": 15549.229, "timestamp": "04:19:09", "text": "もっと多くのことを求めて、私と一緒にここに来ることに同意しただけだ。"}, {"type": "subtitle", "time": 15554.309, "timestamp": "04:19:14", "text": "ああ、もちろんです。何でも聞いてください。すべてはここから始まった"}, {"type": "subtitle", "time": 15555.63, "timestamp": "04:19:15", "text": "1世紀"}, {"type": "subtitle", "time": 15559.59, "timestamp": "04:19:19", "text": "前。 TDの発生中、私の主人は"}, {"type": "subtitle", "time": 15563.189, "timestamp": "04:19:23", "text": "その人物によって救助された。彼女は"}, {"type": "subtitle", "time": 15567.03, "timestamp": "04:19:27", "text": "独特のエネルギーを持ち、常に捉えどころのない存在だった。"}, {"type": "subtitle", "time": 15569.75, "timestamp": "04:19:29", "text": "私の主人は探した後掘り下げた"}, {"type": "subtitle", "time": 15572.79, "timestamp": "04:19:32", "text": "数年間。彼はついに"}, {"type": "subtitle", "time": 15576.309, "timestamp": "04:19:36", "text": "再び発酵山にいる人物。わかった。"}, {"type": "subtitle", "time": 15578.55, "timestamp": "04:19:38", "text": "最初は、師匠が"}, {"type": "subtitle", "time": 15581.03, "timestamp": "04:19:41", "text": "ゲーム記録は実際の情報を保持しています"}, {"type": "subtitle", "time": 15584.07, "timestamp": "04:19:44", "text": "時間危機についてですが、それはただ"}, {"type": "subtitle", "time": 15584.83, "timestamp": "04:19:44", "text": "1"}, {"type": "subtitle", "time": 15588.229, "timestamp": "04:19:48", "text": "手がかり。そして最後に、"}, {"type": "subtitle", "time": 15590.149, "timestamp": "04:19:50", "text": "不死。"}, {"type": "subtitle", "time": 15593.309, "timestamp": "04:19:53", "text": "そこに木彫りの彫刻がある。そうではありません"}]
[{"type": "subtitle", "time": 13983.95, "timestamp": "03:53:03", "text": "ありがとう。私はなりたい"}, {"type": "subtitle", "time": 13992.07, "timestamp": "03:53:12", "text": "なんて奇妙な場所だろう。"}, {"type": "subtitle", "time": 13995.03, "timestamp": "03:53:15", "text": "見覚えがあるように見えるはずだが、"}, {"type": "subtitle", "time": 13997.83, "timestamp": "03:53:17", "text": "見たことのないものがたくさんあります"}, {"type": "subtitle", "time": 14003.67, "timestamp": "03:53:23", "text": "前に。ああ、このドア。ウィジャ盤"}, {"type": "subtitle", "time": 14006.71, "timestamp": "03:53:26", "text": "チェス盤。理由はわからないけど、"}, {"type": "subtitle", "time": 14008.469, "timestamp": "03:53:28", "text": "ずっと"}, {"type": "subtitle", "time": 14009.55, "timestamp": "03:53:29", "text": "ここ"}, {"type": "subtitle", "time": 14016.71, "timestamp": "03:53:36", "text": "周りを見渡してみましょう。もしかしたら見つかるかも"}]
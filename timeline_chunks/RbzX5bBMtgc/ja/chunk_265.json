[{"type": "subtitle", "time": 15904.03, "timestamp": "04:25:04", "text": "ありがとう。若い孤児の少女は"}, {"type": "subtitle", "time": 15908.189, "timestamp": "04:25:08", "text": "の上。彼女が見渡す限り、悲劇が"}, {"type": "subtitle", "time": 15912.469, "timestamp": "04:25:12", "text": "嘆きが世界中に広がるにつれ、それは蔓延した。 A"}, {"type": "subtitle", "time": 15915.429, "timestamp": "04:25:15", "text": "モンスターで引き裂かれた世界"}, {"type": "subtitle", "time": 15918.87, "timestamp": "04:25:18", "text": "ホームレスの人々。彼女自身の血で"}, {"type": "subtitle", "time": 15921.52, "timestamp": "04:25:21", "text": "火事、彼女は追い払った"}, {"type": "subtitle", "time": 15923.469, "timestamp": "04:25:23", "text": "[音楽]"}, {"type": "subtitle", "time": 15927.269, "timestamp": "04:25:27", "text": "寒い。そして彼女の主人は言った、「この"}, {"type": "subtitle", "time": 15930.229, "timestamp": "04:25:30", "text": "激動の世界では、命は脆い"}, {"type": "subtitle", "time": 15931.469, "timestamp": "04:25:31", "text": "5月"}, {"type": "subtitle", "time": 15934.79, "timestamp": "04:25:34", "text": "ハエ。彼女は疲れ果てて"}, {"type": "subtitle", "time": 15937.75, "timestamp": "04:25:37", "text": "彼女の前にいた人々を救った。"}, {"type": "subtitle", "time": 15939.389, "timestamp": "04:25:39", "text": "しかし彼女はそうしなければならない"}, {"type": "subtitle", "time": 15950.87, "timestamp": "04:25:50", "text": "彼女は知恵を絞って危害を回避し、"}, {"type": "subtitle", "time": 15955.03, "timestamp": "04:25:55", "text": "ナイフの上を慎重に歩く。一人きりなのに"}, {"type": "subtitle", "time": 15956.58, "timestamp": "04:25:56", "text": "成熟していく"}, {"type": "subtitle", "time": 15957.95, "timestamp": "04:25:57", "text": "[音楽]"}]
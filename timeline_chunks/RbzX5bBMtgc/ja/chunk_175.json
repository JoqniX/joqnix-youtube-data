[{"type": "subtitle", "time": 10501.15, "timestamp": "02:55:01", "text": "質素な茅葺き屋根"}, {"type": "subtitle", "time": 10504.63, "timestamp": "02:55:04", "text": "コテージ。そして彼の家がかつて建っていた場所に、"}, {"type": "subtitle", "time": 10508.75, "timestamp": "02:55:08", "text": "ただの荒涼とした不毛の地"}, {"type": "subtitle", "time": 10511.03, "timestamp": "02:55:11", "text": "残った。彼は日付に気づいた"}, {"type": "subtitle", "time": 10513.59, "timestamp": "02:55:13", "text": "彼がこれまで見たことのないカレンダーだった。"}, {"type": "subtitle", "time": 10516.07, "timestamp": "02:55:16", "text": "ショックを受けた彼は、通りすがりの人をつかみ、"}, {"type": "subtitle", "time": 10518.95, "timestamp": "02:55:18", "text": "緊急に尋ねた、「すみません、教えていただけますか」"}, {"type": "subtitle", "time": 10522.15, "timestamp": "02:55:22", "text": "「現在の日時を教えてください」"}, {"type": "subtitle", "time": 10525.51, "timestamp": "02:55:25", "text": "日時。彼が答えを聞いたとき、"}, {"type": "subtitle", "time": 10526.83, "timestamp": "02:55:26", "text": "彼の足は"}, {"type": "subtitle", "time": 10529.63, "timestamp": "02:55:29", "text": "弱い。すべては"}, {"type": "subtitle", "time": 10533.269, "timestamp": "02:55:33", "text": "変更しました。時が経ち、彼の愛する人は"}, {"type": "subtitle", "time": 10535.309, "timestamp": "02:55:35", "text": "1つは"}, {"type": "subtitle", "time": 10543.83, "timestamp": "02:55:43", "text": "それで、木こりはマウントを去った"}, {"type": "subtitle", "time": 10546.55, "timestamp": "02:55:46", "text": "天空、しかし彼はまだ生きているのか"}, {"type": "subtitle", "time": 10549.03, "timestamp": "02:55:49", "text": "100年分の"}, {"type": "subtitle", "time": 10551.63, "timestamp": "02:55:51", "text": "彼の体内で何が起こるのか？すべきではない"}, {"type": "subtitle", "time": 10555.91, "timestamp": "02:55:55", "text": "彼？あなたの話は、少し無理が​​ある。"}, {"type": "subtitle", "time": 10558.95, "timestamp": "02:55:58", "text": "そう思いませんか？つまり、もし私が"}]
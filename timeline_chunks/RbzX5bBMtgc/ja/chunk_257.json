[{"type": "subtitle", "time": 15421.349, "timestamp": "04:17:01", "text": "少し休んで"}, {"type": "subtitle", "time": 15423.189, "timestamp": "04:17:03", "text": "回復する。"}, {"type": "subtitle", "time": 15425.83, "timestamp": "04:17:05", "text": "チャンギはあなたが"}, {"type": "subtitle", "time": 15428.149, "timestamp": "04:17:08", "text": "心配した。パビリオンで彼女に会おう"}, {"type": "subtitle", "time": 15431.91, "timestamp": "04:17:11", "text": "マウント。彼女はまたこう言った。"}, {"type": "subtitle", "time": 15435.75, "timestamp": "04:17:15", "text": "「もう二度とそんなことはしない。」わかった。"}, {"type": "subtitle", "time": 15458.71, "timestamp": "04:17:38", "text": "[音楽]"}, {"type": "subtitle", "time": 15461.42, "timestamp": "04:17:41", "text": "力。"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "[音楽]"}]
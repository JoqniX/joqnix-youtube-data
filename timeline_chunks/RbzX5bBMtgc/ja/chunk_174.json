[{"type": "subtitle", "time": 10441.269, "timestamp": "02:54:01", "text": "どれだけの時間が経ったのかを知ってショックを受けた。"}, {"type": "subtitle", "time": 10442.95, "timestamp": "02:54:02", "text": "「2人以上ではなかったはずだ」"}, {"type": "subtitle", "time": 10444.59, "timestamp": "02:54:04", "text": "「数時間」彼はそう考えた"}, {"type": "subtitle", "time": 10447.11, "timestamp": "02:54:07", "text": "信じられない。申し訳なさそうに彼は"}, {"type": "subtitle", "time": 10449.99, "timestamp": "02:54:09", "text": "出発の準備をしました。グルが心配している"}, {"type": "subtitle", "time": 10453.03, "timestamp": "02:54:13", "text": "彼に腹を立てるだろう。"}, {"type": "subtitle", "time": 10455.23, "timestamp": "02:54:15", "text": "[音楽]"}, {"type": "subtitle", "time": 10457.19, "timestamp": "02:54:17", "text": "はぁ？"}, {"type": "subtitle", "time": 10459.51, "timestamp": "02:54:19", "text": "しかし、木こりが振り向いたとき、"}, {"type": "subtitle", "time": 10463.19, "timestamp": "02:54:23", "text": "彼は飛び上がるほど驚いた。の"}, {"type": "subtitle", "time": 10465.91, "timestamp": "02:54:25", "text": "隠遁の導師は、"}, {"type": "subtitle", "time": 10468.67, "timestamp": "02:54:28", "text": "そしてワインを飲むことは"}, {"type": "subtitle", "time": 10472.07, "timestamp": "02:54:32", "text": "去った。彼の代わりに、壊れた魔女が横たわっていた。"}, {"type": "subtitle", "time": 10475.71, "timestamp": "02:54:35", "text": "板と腐ったものの山"}, {"type": "subtitle", "time": 10478.469, "timestamp": "02:54:38", "text": "骨。木こりはとても怖がっていた"}, {"type": "subtitle", "time": 10480.55, "timestamp": "02:54:40", "text": "彼は竹かごを落とし、"}, {"type": "subtitle", "time": 10482.55, "timestamp": "02:54:42", "text": "山を駆け下りても、"}, {"type": "subtitle", "time": 10485.59, "timestamp": "02:54:45", "text": "振り返ってみると。"}, {"type": "subtitle", "time": 10488.23, "timestamp": "02:54:48", "text": "山麓に到着した時、彼は"}, {"type": "subtitle", "time": 10490.59, "timestamp": "02:54:50", "text": "強烈な衝撃を受けた"}, {"type": "subtitle", "time": 10492.79, "timestamp": "02:54:52", "text": "実現。彼が"}, {"type": "subtitle", "time": 10495.51, "timestamp": "02:54:55", "text": "思い出すと、賑やかな街へと発展していた"}, {"type": "subtitle", "time": 10498.87, "timestamp": "02:54:58", "text": "頑丈なレンガ造りの家々が町に取って代わった"}]
[{"type": "subtitle", "time": 12843.349, "timestamp": "03:34:03", "text": "[音楽]"}, {"type": "subtitle", "time": 12846.229, "timestamp": "03:34:06", "text": "私たちは遠すぎる。彼は耳が聞こえない。彼"}, {"type": "subtitle", "time": 12849.349, "timestamp": "03:34:09", "text": "私たちの声が聞こえない。わかった。酸性の"}, {"type": "subtitle", "time": 12851.91, "timestamp": "03:34:11", "text": "休眠期の分野。この間"}, {"type": "subtitle", "time": 12856.15, "timestamp": "03:34:16", "text": "その時間帯は比較的安全です。わかった。その間"}, {"type": "subtitle", "time": 12857.91, "timestamp": "03:34:17", "text": "今回は疑問符の休眠期間"}, {"type": "subtitle", "time": 12860.07, "timestamp": "03:34:20", "text": "酸性フィールドの"}, {"type": "subtitle", "time": 12863.03, "timestamp": "03:34:23", "text": "形成時間。形成時間。わかった。"}, {"type": "subtitle", "time": 12866.229, "timestamp": "03:34:26", "text": "形成期間とは休眠期間のことである。"}, {"type": "subtitle", "time": 12868.79, "timestamp": "03:34:28", "text": "しかし、休眠期間が長くなると、"}, {"type": "subtitle", "time": 12870.87, "timestamp": "03:34:30", "text": "内部で生まれた沈黙の不和は"}, {"type": "subtitle", "time": 12874.229, "timestamp": "03:34:34", "text": "通常はより強い。通常はより強い。おお、"}, {"type": "subtitle", "time": 12876.71, "timestamp": "03:34:36", "text": "静寂領域がより速く形成されるほど。の"}, {"type": "subtitle", "time": 12879.429, "timestamp": "03:34:39", "text": "休眠期間が長くなるほど。ああ、私は"}, {"type": "subtitle", "time": 12891.99, "timestamp": "03:34:51", "text": "グライダーは無理だろうけど、きっと大丈夫だろう。"}, {"type": "subtitle", "time": 12894.389, "timestamp": "03:34:54", "text": "それでは、行きます。それに、私はただ"}, {"type": "subtitle", "time": 12896.95, "timestamp": "03:34:56", "text": "戦い。降りていかなければならない。ください"}, {"type": "subtitle", "time": 12899.75, "timestamp": "03:34:59", "text": "戦闘中のベスト。"}]
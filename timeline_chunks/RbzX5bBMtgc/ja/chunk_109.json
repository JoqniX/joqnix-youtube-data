[{"type": "subtitle", "time": 6544.07, "timestamp": "01:49:04", "text": "神に誓って。待って、なぜこの人たちは"}, {"type": "subtitle", "time": 6555.669, "timestamp": "01:49:15", "text": "黄色？おい、こいつらのベッドは黄色だぜ"}, {"type": "subtitle", "time": 6575.189, "timestamp": "01:49:35", "text": "いいえ。コロナサインは起動に使用できます"}, {"type": "subtitle", "time": 6577.83, "timestamp": "01:49:37", "text": "クロノ。"}, {"type": "subtitle", "time": 6581.03, "timestamp": "01:49:41", "text": "クロナル記号を使用してレンダリングできます"}, {"type": "subtitle", "time": 6584.149, "timestamp": "01:49:44", "text": "敵のメカニズムが再び射程圏内に入った。"}]
[{"type": "subtitle", "time": 11887.55, "timestamp": "03:18:07", "text": "なぜ？なぜ手放すのか？なぜ最後なのか"}, {"type": "subtitle", "time": 11898.95, "timestamp": "03:18:18", "text": "いや、波だよ。"}, {"type": "subtitle", "time": 11902.07, "timestamp": "03:18:22", "text": "何てことだ。ああ、これをありがとう"}, {"type": "subtitle", "time": 11903.03, "timestamp": "03:18:23", "text": "もの。ああ、ありがとうございます。ありがとう。感謝"}, {"type": "subtitle", "time": 11905.03, "timestamp": "03:18:25", "text": "あなた。ありがとう。ありがとう。私はただ"}, {"type": "subtitle", "time": 11925.04, "timestamp": "03:18:45", "text": "おお。世界はそういうものだ。"}, {"type": "subtitle", "time": 11932.71, "timestamp": "03:18:52", "text": "外傷性呼吸の異常な兆候。させて"}, {"type": "subtitle", "time": 11935.19, "timestamp": "03:18:55", "text": "私は携帯電話を取り出す。これは"}, {"type": "subtitle", "time": 11937.01, "timestamp": "03:18:57", "text": "悪い。"}]
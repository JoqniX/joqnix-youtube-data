[{"type": "subtitle", "time": 20523.27, "timestamp": "05:42:03", "text": "神。吐きたい。吐きたい。"}, {"type": "subtitle", "time": 20528.11, "timestamp": "05:42:08", "text": "このリンゴには文字通り虫がいます。"}, {"type": "subtitle", "time": 20538.23, "timestamp": "05:42:18", "text": "えっ？うっかり全部食べちゃった。"}, {"type": "subtitle", "time": 20542.23, "timestamp": "05:42:22", "text": "神様、そうしなくてよかった 神様、そうしなくてよかった"}, {"type": "subtitle", "time": 20545.99, "timestamp": "05:42:25", "text": "一気に飲み干せ。お茶がまずいのかもしれない。おお"}, {"type": "subtitle", "time": 20547.15, "timestamp": "05:42:27", "text": "私の。私にさせて"}, {"type": "subtitle", "time": 20551.43, "timestamp": "05:42:31", "text": "行く。待って。私は、私は、私は、私は、が必要です。待って"}, {"type": "subtitle", "time": 20556.35, "timestamp": "05:42:36", "text": "1秒。私は戻ってきます。ああ、"}, {"type": "chat", "time": 20559.854, "timestamp": "05:42:39", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "Joq's Activity State is AFK"}]
[{"type": "subtitle", "time": 22561.628, "timestamp": "06:16:01", "text": "[音楽]"}, {"type": "subtitle", "time": 22564.75, "timestamp": "06:16:04", "text": "1つ。やったよ。私はそうしました"}, {"type": "subtitle", "time": 22568.07, "timestamp": "06:16:08", "text": "それ。俺は頭がいいんだよ、兄弟。私は頭がいい。ああ、"}, {"type": "subtitle", "time": 22603.75, "timestamp": "06:16:43", "text": "良い。無駄にできる時間はない。時計"}, {"type": "subtitle", "time": 22605.99, "timestamp": "06:16:45", "text": "そして学ぶ。"}]
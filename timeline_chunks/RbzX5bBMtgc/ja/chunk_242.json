[{"type": "subtitle", "time": 14523.309, "timestamp": "04:02:03", "text": "なんてこった。この男は私の「はい」になる運命にある。"}, {"type": "subtitle", "time": 14526.71, "timestamp": "04:02:06", "text": "私が教えたことを覚えておいてください。なんてこった、"}, {"type": "subtitle", "time": 14531.229, "timestamp": "04:02:11", "text": "彼女の寿命は短い。プラン"}, {"type": "subtitle", "time": 14534.75, "timestamp": "04:02:14", "text": "細心の注意を払い、身を守りましょう"}, {"type": "subtitle", "time": 14537.83, "timestamp": "04:02:17", "text": "あなたが成長した時に賢明に"}, {"type": "subtitle", "time": 14540.95, "timestamp": "04:02:20", "text": "あなたがなりたいと願う人物像。"}, {"type": "subtitle", "time": 14542.87, "timestamp": "04:02:22", "text": "[ __ ]・リーはあなたの教えを忘れないでしょう"}, {"type": "subtitle", "time": 14546.87, "timestamp": "04:02:26", "text": "暗記して。マスターマスター、"}, {"type": "subtitle", "time": 14549.309, "timestamp": "04:02:29", "text": "その時"}, {"type": "subtitle", "time": 14553.59, "timestamp": "04:02:33", "text": "来る、あなたは自分のものを使うだけでいい 彼女は"}, {"type": "subtitle", "time": 14559.189, "timestamp": "04:02:39", "text": "この方法で真に変化を起こせるのは、ただ一人だけだ。"}, {"type": "subtitle", "time": 14563.71, "timestamp": "04:02:43", "text": "私はこれを見つけたと思います"}, {"type": "subtitle", "time": 14575.229, "timestamp": "04:02:55", "text": "ああ、ここが私たちのいる場所だ。私は手に入れている"}, {"type": "subtitle", "time": 14578.469, "timestamp": "04:02:58", "text": "鳥肌が立った。走る。これはまた別の"}]
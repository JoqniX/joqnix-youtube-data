[{"type": "subtitle", "time": 15781.59, "timestamp": "04:23:01", "text": "自体。"}, {"type": "subtitle", "time": 15785.95, "timestamp": "04:23:05", "text": "友情のひとときと"}, {"type": "subtitle", "time": 15790.95, "timestamp": "04:23:10", "text": "私にとって、身を守ることは何よりも重要だった。"}, {"type": "subtitle", "time": 15792.189, "timestamp": "04:23:12", "text": "なんてことだ"}, {"type": "subtitle", "time": 15795.79, "timestamp": "04:23:15", "text": "泣く。なんて悲鳴だ。あなたの言葉にならない"}, {"type": "subtitle", "time": 15798.95, "timestamp": "04:23:18", "text": "質問。私は自分の命を犠牲にしたのだろうか"}, {"type": "subtitle", "time": 15800.189, "timestamp": "04:23:20", "text": "焼き尽くした"}, {"type": "subtitle", "time": 15803.389, "timestamp": "04:23:23", "text": "ソナロスフィアは私が子供の頃のような"}, {"type": "subtitle", "time": 15806.95, "timestamp": "04:23:26", "text": "子供？私がそこであなたに言ったことは本当です。"}, {"type": "subtitle", "time": 15809.349, "timestamp": "04:23:29", "text": "しかし私は成長し、コントロールできるようになりました"}, {"type": "subtitle", "time": 15813.269, "timestamp": "04:23:33", "text": "私の力。今自分の得意分野を使うことは害にはならない"}, {"type": "subtitle", "time": 15816.149, "timestamp": "04:23:36", "text": "私にとって、どんな形であれ。その点については安心してください"}, {"type": "subtitle", "time": 15818.469, "timestamp": "04:23:38", "text": "確信しています。"}, {"type": "subtitle", "time": 15820.59, "timestamp": "04:23:40", "text": "ああ、神様。"}, {"type": "subtitle", "time": 15823.99, "timestamp": "04:23:43", "text": "また、もしあなたが本当に伝説の"}, {"type": "subtitle", "time": 15826.429, "timestamp": "04:23:46", "text": "流れを変えた人物"}, {"type": "subtitle", "time": 15829.269, "timestamp": "04:23:49", "text": "歴史を語るなら、あなたは恐らく"}, {"type": "subtitle", "time": 15830.51, "timestamp": "04:23:50", "text": "最も近い"}, {"type": "subtitle", "time": 15834.389, "timestamp": "04:23:54", "text": "我々の番人とは別に、不死身である。"}, {"type": "subtitle", "time": 15838.149, "timestamp": "04:23:58", "text": "ああ、我々人間は生まれては消えていく。私たちの生活"}]
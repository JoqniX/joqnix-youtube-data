[{"type": "subtitle", "time": 5162.51, "timestamp": "01:26:02", "text": "えっと、私の"}, {"type": "subtitle", "time": 5169.669, "timestamp": "01:26:09", "text": "ローバーバン、今のところは、私の理解が正しければ"}, {"type": "subtitle", "time": 5172.709, "timestamp": "01:26:12", "text": "私ができることは"}, {"type": "subtitle", "time": 5177.91, "timestamp": "01:26:17", "text": "シェパーはOPヒーラーです。あなたの意志で、私は"}, {"type": "subtitle", "time": 5182.669, "timestamp": "01:26:22", "text": "できることは、私が持っているものが少なかったので"}, {"type": "subtitle", "time": 5190.27, "timestamp": "01:26:30", "text": "それなら、私が"}, {"type": "subtitle", "time": 5192.99, "timestamp": "01:26:32", "text": "えっと、キャラクターの名前は何ですか？"}, {"type": "subtitle", "time": 5195.07, "timestamp": "01:26:35", "text": "また？"}, {"type": "subtitle", "time": 5199.07, "timestamp": "01:26:39", "text": "ゼイン。ゼインとかいう名前だったかな？彼女のことを忘れた"}, {"type": "subtitle", "time": 5202.95, "timestamp": "01:26:42", "text": "名前。右。戦術的に見て、その方が良いのではないでしょうか？"}, {"type": "subtitle", "time": 5208.91, "timestamp": "01:26:48", "text": "[音楽]"}, {"type": "subtitle", "time": 5212.149, "timestamp": "01:26:52", "text": "キャラクター？皆さんはどう思いますか？"}]
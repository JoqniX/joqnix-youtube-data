[{"type": "subtitle", "time": 18961.09, "timestamp": "05:16:01", "text": "良い。無駄にできる時間はない。"}, {"type": "subtitle", "time": 18977.15, "timestamp": "05:16:17", "text": "えっと、私は何をすればいいの？"}, {"type": "subtitle", "time": 18980.07, "timestamp": "05:16:20", "text": "写真を撮る"}, {"type": "subtitle", "time": 19002.39, "timestamp": "05:16:42", "text": "ああ、でも問題は、今は私は独身だから"}, {"type": "subtitle", "time": 19005.27, "timestamp": "05:16:45", "text": "今は独身者か学生のような状態であるべきだ。それ"}, {"type": "subtitle", "time": 19006.788, "timestamp": "05:16:46", "text": "良いものを手に入れるのは難しいだろう"}, {"type": "subtitle", "time": 19008.51, "timestamp": "05:16:48", "text": "私のインターネット"}, {"type": "subtitle", "time": 19012.07, "timestamp": "05:16:52", "text": "キャンパスは、"}, {"type": "subtitle", "time": 19016.19, "timestamp": "05:16:56", "text": "インターネットは日本国内に限定される可能性がある"}]
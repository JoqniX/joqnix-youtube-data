[{"type": "subtitle", "time": 1871.909, "timestamp": "00:31:11", "text": "はぁ？表示するかどうかを選択する必要があります"}, {"type": "subtitle", "time": 1875.51, "timestamp": "00:31:15", "text": "変換。選択できます"}, {"type": "subtitle", "time": 1890.31, "timestamp": "00:31:30", "text": "彼はかっこいい。私は自分のような人間をほとんど欲しくない。感じる"}, {"type": "subtitle", "time": 1911.87, "timestamp": "00:31:51", "text": "[音楽]"}]
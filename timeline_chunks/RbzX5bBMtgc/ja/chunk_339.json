[{"type": "subtitle", "time": 20340.83, "timestamp": "05:39:00", "text": "もの。私は行かなければならない、"}, {"type": "subtitle", "time": 20345.43, "timestamp": "05:39:05", "text": "兄弟。なあ、もう行かなきゃ。あなたは"}, {"type": "subtitle", "time": 20347.91, "timestamp": "05:39:07", "text": "冗談でしょ？私は持っている"}, {"type": "subtitle", "time": 20349.99, "timestamp": "05:39:09", "text": "新しい地域まで行くために"}, {"type": "subtitle", "time": 20351.628, "timestamp": "05:39:11", "text": "する"}, {"type": "subtitle", "time": 20353.948, "timestamp": "05:39:13", "text": "番号"}, {"type": "subtitle", "time": 20357.47, "timestamp": "05:39:17", "text": "いや、タイガー。私はスキップします"}, {"type": "subtitle", "time": 20360.47, "timestamp": "05:39:20", "text": "あなた。わかりました、"}, {"type": "subtitle", "time": 20363.548, "timestamp": "05:39:23", "text": "[音楽]"}, {"type": "subtitle", "time": 20367.28, "timestamp": "05:39:27", "text": "スキップ。タイガー・マーは飛ばすかもしれない。"}]
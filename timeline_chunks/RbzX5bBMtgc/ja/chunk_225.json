[{"type": "subtitle", "time": 13505.269, "timestamp": "03:45:05", "text": "わかった。それぞれが片側ずつ担当しましょう。病気"}, {"type": "subtitle", "time": 13522.71, "timestamp": "03:45:22", "text": "それは使えません。わかりました、それは使えません"}, {"type": "subtitle", "time": 13525.63, "timestamp": "03:45:25", "text": "ここ。よし、ここから出たら"}, {"type": "subtitle", "time": 13528.469, "timestamp": "03:45:28", "text": "ここ。この場所は少し違うようだ"}, {"type": "subtitle", "time": 13531.67, "timestamp": "03:45:31", "text": "私の記憶では。"}]
[{"type": "subtitle", "time": 26042.628, "timestamp": "07:14:02", "text": "急ぐ必要はありません。せっかちな者は倒れるだろう"}, {"type": "subtitle", "time": 26046.03, "timestamp": "07:14:06", "text": "まさに私たちの膝の上に。"}, {"type": "subtitle", "time": 26048.708, "timestamp": "07:14:08", "text": "理解した。私はあなたのためにここにいます"}, {"type": "subtitle", "time": 26051.15, "timestamp": "07:14:11", "text": "意思。"}, {"type": "subtitle", "time": 26054.15, "timestamp": "07:14:14", "text": "[音楽]"}, {"type": "subtitle", "time": 26058.31, "timestamp": "07:14:18", "text": "今日は良い天気になりそうです。"}, {"type": "subtitle", "time": 26061.03, "timestamp": "07:14:21", "text": "進むべき道がはっきりと見えた。うまくいけば、"}, {"type": "subtitle", "time": 26090.31, "timestamp": "07:14:50", "text": "[音楽]"}, {"type": "subtitle", "time": 26097.99, "timestamp": "07:14:57", "text": "本当に良いものがない"}]
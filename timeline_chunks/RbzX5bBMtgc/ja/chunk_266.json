[{"type": "subtitle", "time": 15961.03, "timestamp": "04:26:01", "text": "つまずく。その後、彼女は"}, {"type": "subtitle", "time": 15963.75, "timestamp": "04:26:03", "text": "他の先生。"}, {"type": "subtitle", "time": 15967.03, "timestamp": "04:26:07", "text": "彼女は未来のリーダーにこれを教えた"}, {"type": "subtitle", "time": 15969.429, "timestamp": "04:26:09", "text": "良心を導き、繁栄を確保する"}, {"type": "subtitle", "time": 15973.189, "timestamp": "04:26:13", "text": "人々が過去の教えを失うために"}, {"type": "subtitle", "time": 15977.51, "timestamp": "04:26:17", "text": "賢者たちが物語を確立する。"}, {"type": "subtitle", "time": 15980.55, "timestamp": "04:26:20", "text": "何てことだ。松明を掲げる者となるだろう。のために"}, {"type": "subtitle", "time": 15983.189, "timestamp": "04:26:23", "text": "一人の人間が世界の混沌を取り除くことはできない"}, {"type": "subtitle", "time": 15985.83, "timestamp": "04:26:25", "text": "一人で。"}, {"type": "subtitle", "time": 15989.11, "timestamp": "04:26:29", "text": "いつか繁栄の未来が訪れ、"}, {"type": "subtitle", "time": 16004.429, "timestamp": "04:26:44", "text": "[音楽]"}, {"type": "subtitle", "time": 16015.07, "timestamp": "04:26:55", "text": "良い。やったー、終わったよ。"}]
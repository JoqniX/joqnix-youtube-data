[{"type": "subtitle", "time": 13143.71, "timestamp": "03:39:03", "text": "予測不可能。私の氏族は、しかしあなたは、私の"}, {"type": "subtitle", "time": 13146.55, "timestamp": "03:39:06", "text": "友人はゲームに参加することを選んだ"}, {"type": "subtitle", "time": 13148.389, "timestamp": "03:39:08", "text": "あなた自身。"}, {"type": "subtitle", "time": 13150.95, "timestamp": "03:39:10", "text": "それは危険だ。今は、"}, {"type": "subtitle", "time": 13155.51, "timestamp": "03:39:15", "text": "私にとっては悲しいことだ。私が死ぬとしたら、それは"}, {"type": "subtitle", "time": 13159.269, "timestamp": "03:39:19", "text": "その時が来る。終わらせる者"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "このゲームのやり方。しかし私にとっては"}, {"type": "subtitle", "time": 13166.469, "timestamp": "03:39:26", "text": "懸念する必要がある。彼女の知性"}, {"type": "subtitle", "time": 13169.91, "timestamp": "03:39:29", "text": "そして彼女は素早く考え、結果を出すだろう"}, {"type": "subtitle", "time": 13173.99, "timestamp": "03:39:33", "text": "この試合の結果が決まるだろう。前途"}, {"type": "subtitle", "time": 13177.11, "timestamp": "03:39:37", "text": "長いです。"}]
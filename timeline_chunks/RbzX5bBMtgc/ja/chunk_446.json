[{"type": "subtitle", "time": 26761.27, "timestamp": "07:26:01", "text": "ストリームは、2つのストリームと同じように"}, {"type": "subtitle", "time": 26763.75, "timestamp": "07:26:03", "text": "まさに偶然にこうなった。だから私は"}, {"type": "subtitle", "time": 26766.708, "timestamp": "07:26:06", "text": "その後、もう一方のチャンネルでライブ配信します"}, {"type": "subtitle", "time": 26768.468, "timestamp": "07:26:08", "text": "本日の配信はこれで終了です。"}, {"type": "subtitle", "time": 26770.788, "timestamp": "07:26:10", "text": "よし、今日の配信はちょっと"}, {"type": "subtitle", "time": 26773.59, "timestamp": "07:26:13", "text": "長すぎるか、短すぎるか。場合によります。でも私は"}, {"type": "subtitle", "time": 26776.708, "timestamp": "07:26:16", "text": "ああ、そうしたい。私はちょっと"}, {"type": "subtitle", "time": 26778.27, "timestamp": "07:26:18", "text": "したかった"}, {"type": "subtitle", "time": 26782.708, "timestamp": "07:26:22", "text": "ええ、私は本当にそうしたかったんです"}, {"type": "subtitle", "time": 26785.868, "timestamp": "07:26:25", "text": "少なくとも6時間または3時間の配信を行う"}, {"type": "subtitle", "time": 26788.19, "timestamp": "07:26:28", "text": "ストリーム。わからない。"}, {"type": "subtitle", "time": 26792.468, "timestamp": "07:26:32", "text": "ああ、神様、私は判断している。何てことだ。"}, {"type": "subtitle", "time": 26796.31, "timestamp": "07:26:36", "text": "私の計画は午前3時まで配信することです。"}, {"type": "subtitle", "time": 26799.11, "timestamp": "07:26:39", "text": "配信を終えて、寝て、起きる"}, {"type": "subtitle", "time": 26803.548, "timestamp": "07:26:43", "text": "朝、また崩壊、崩壊"}, {"type": "subtitle", "time": 26807.35, "timestamp": "07:26:47", "text": "また、そう、そして繰り返し。はい。そして私たちは"}, {"type": "subtitle", "time": 26809.35, "timestamp": "07:26:49", "text": "えーと、今日、えーと、明日私たちは"}, {"type": "subtitle", "time": 26813.03, "timestamp": "07:26:53", "text": "私が正しく理解しているなら、私たちは"}, {"type": "subtitle", "time": 26815.24, "timestamp": "07:26:55", "text": "私たちは えっと、私たちは人生に酔いしれています。だから私は"}, {"type": "subtitle", "time": 26818.638, "timestamp": "07:26:58", "text": "えっと、私たちは人生に酔いしれています。だから私は 私もそれを楽しみにしています。それでは、"}]
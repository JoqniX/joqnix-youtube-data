[{"type": "subtitle", "time": 2948.23, "timestamp": "00:49:08", "text": "おお、"}, {"type": "subtitle", "time": 2949.829, "timestamp": "00:49:09", "text": "私の孫のためにここにいるの？"}, {"type": "subtitle", "time": 2952.95, "timestamp": "00:49:12", "text": "なるほど。でも、もしかしたら私の祖父かもしれない。ニース。"}, {"type": "subtitle", "time": 2954.87, "timestamp": "00:49:14", "text": "正しい。わかりました。 6つやります"}, {"type": "subtitle", "time": 2957.349, "timestamp": "00:49:17", "text": "連続してスピンする。つまり、感謝します。"}, {"type": "subtitle", "time": 2961.109, "timestamp": "00:49:21", "text": "つまり、私はサイドクエストをやっているということでしょうか？終わり。今、"}, {"type": "subtitle", "time": 2963.51, "timestamp": "00:49:23", "text": "次へ。"}, {"type": "subtitle", "time": 2965.43, "timestamp": "00:49:25", "text": "パイオニア協会へようこそ"}, {"type": "subtitle", "time": 2968.15, "timestamp": "00:49:28", "text": "店。あなたの"}]
[{"type": "subtitle", "time": 17461.65, "timestamp": "04:51:01", "text": "いらっしゃいませ。なぜこれが"}, {"type": "subtitle", "time": 17464.708, "timestamp": "04:51:04", "text": "[音楽]"}, {"type": "subtitle", "time": 17467.708, "timestamp": "04:51:07", "text": "ああ、私は自分の"}, {"type": "subtitle", "time": 17471.31, "timestamp": "04:51:11", "text": "イヤホン。ふざけるな。神様、見つけてくれてありがとう"}, {"type": "subtitle", "time": 17475.11, "timestamp": "04:51:15", "text": "それ。まだよく分かりません。どうやって"}, {"type": "subtitle", "time": 17476.11, "timestamp": "04:51:16", "text": "のように"}, {"type": "subtitle", "time": 17480.11, "timestamp": "04:51:20", "text": "私の左側まで遠くへ行く"}, {"type": "subtitle", "time": 17482.51, "timestamp": "04:51:22", "text": "テーブルのように"}, {"type": "subtitle", "time": 17493.46, "timestamp": "04:51:33", "text": "あなたはどのサーバーに所属していますか？えーとSCA、もし私が"}]
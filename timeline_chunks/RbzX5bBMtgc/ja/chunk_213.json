[{"type": "subtitle", "time": 12782.51, "timestamp": "03:33:02", "text": "ここ。彼女はどこにいるの？"}, {"type": "subtitle", "time": 12784.5, "timestamp": "03:33:04", "text": "バイ。ああ、誰"}, {"type": "subtitle", "time": 12785.95, "timestamp": "03:33:05", "text": "[音楽]"}, {"type": "subtitle", "time": 12788.429, "timestamp": "03:33:08", "text": "バイ？ビシって誰？"}, {"type": "subtitle", "time": 12791.51, "timestamp": "03:33:11", "text": "キャラクターの名前を知らないので、"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "トバリック海。酸性場。酸性場。"}, {"type": "subtitle", "time": 12805.07, "timestamp": "03:33:25", "text": "何が"}, {"type": "subtitle", "time": 12807.83, "timestamp": "03:33:27", "text": "ハプニング？ああ、星とは何ですか。"}, {"type": "subtitle", "time": 12811.349, "timestamp": "03:33:31", "text": "それはスターだ。エコースター。ここにはなかった"}, {"type": "subtitle", "time": 12813.59, "timestamp": "03:33:33", "text": "私たちがここに着いたばかりの頃、私は"}, {"type": "subtitle", "time": 12816.75, "timestamp": "03:33:36", "text": "酸性のフィールドの気配を感じる"}, {"type": "subtitle", "time": 12819.19, "timestamp": "03:33:39", "text": "面前。それで、私たちが"}, {"type": "subtitle", "time": 12821.83, "timestamp": "03:33:41", "text": "見ていなかった。点滅して"}, {"type": "subtitle", "time": 12825.269, "timestamp": "03:33:45", "text": "目。ああ、もしかしたらエーテルの海が教えてくれるかもしれない"}, {"type": "subtitle", "time": 12827.83, "timestamp": "03:33:47", "text": "私たちが今いる場所。倫理的な海は続いています"}, {"type": "subtitle", "time": 12832.15, "timestamp": "03:33:52", "text": "私たち。戦術フィールドの中心。"}, {"type": "subtitle", "time": 12834.349, "timestamp": "03:33:54", "text": "何かが"}, {"type": "subtitle", "time": 12838.35, "timestamp": "03:33:58", "text": "そこには。おお"}]
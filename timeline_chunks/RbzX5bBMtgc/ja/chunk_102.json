[{"type": "subtitle", "time": 6124.27, "timestamp": "01:42:04", "text": "わーい。もうお腹いっぱいです。お腹がいっぱいです"}, {"type": "subtitle", "time": 6138.79, "timestamp": "01:42:18", "text": "また？ 42. 私は今、高いレベルにいますか？"}, {"type": "subtitle", "time": 6141.669, "timestamp": "01:42:21", "text": "理解した。いいえ、レベル60まで上げたいです"}, {"type": "subtitle", "time": 6145.109, "timestamp": "01:42:25", "text": "えっと、50歳ですよね？もしくは45歳ですよね？するために"}, {"type": "subtitle", "time": 6147.55, "timestamp": "01:42:27", "text": "次の"}, {"type": "subtitle", "time": 6150.87, "timestamp": "01:42:30", "text": "もの。 VBはどうでしょうか？理解した。これ"}, {"type": "subtitle", "time": 6154.87, "timestamp": "01:42:34", "text": "うまくいけば、新たな発見があるでしょう。"}, {"type": "subtitle", "time": 6171.43, "timestamp": "01:42:51", "text": "あなたは高レベルではありません。ええ、私は違います"}, {"type": "subtitle", "time": 6173.91, "timestamp": "01:42:53", "text": "高レベル。私には必要な資質があるだろうか"}, {"type": "subtitle", "time": 6176.79, "timestamp": "01:42:56", "text": "闇の勢力と戦うのか？はい、あなた"}, {"type": "subtitle", "time": 6178.91, "timestamp": "01:42:58", "text": "する。だって君は可愛いから。私は"}]
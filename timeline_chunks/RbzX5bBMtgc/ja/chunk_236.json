[{"type": "subtitle", "time": 14172.75, "timestamp": "03:56:12", "text": "これ"}, {"type": "subtitle", "time": 14176.99, "timestamp": "03:56:16", "text": "場所、見覚えがある、"}, {"type": "subtitle", "time": 14180.469, "timestamp": "03:56:20", "text": "あまりにも。これらは再現された私の記憶です"}, {"type": "subtitle", "time": 14188.469, "timestamp": "03:56:28", "text": "私が中に入ると、ローバーと"}, {"type": "subtitle", "time": 14191.309, "timestamp": "03:56:31", "text": "フライダスは薄暗い中に消えた"}, {"type": "subtitle", "time": 14195.63, "timestamp": "03:56:35", "text": "空気。周波数は常に"}, {"type": "subtitle", "time": 14199.189, "timestamp": "03:56:39", "text": "変化。シナリオ領域が影響を受ける"}, {"type": "subtitle", "time": 14200.429, "timestamp": "03:56:40", "text": "時間的"}, {"type": "subtitle", "time": 14204.03, "timestamp": "03:56:44", "text": "混乱。彼は人を欺くためにこんなことをしたのか？"}, {"type": "subtitle", "time": 14207.51, "timestamp": "03:56:47", "text": "自分？気をつけなければ。どんな"}, {"type": "subtitle", "time": 14211.67, "timestamp": "03:56:51", "text": "場合。え、彼女としてプレイするんですか？"}, {"type": "subtitle", "time": 14214.13, "timestamp": "03:56:54", "text": "おお。"}]
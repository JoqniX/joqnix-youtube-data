[{"type": "subtitle", "time": 5831.27, "timestamp": "01:37:11", "text": "ループ。レベル90の人もいます。"}, {"type": "subtitle", "time": 5835.03, "timestamp": "01:37:15", "text": "最初は、えーと"}, {"type": "subtitle", "time": 5839.669, "timestamp": "01:37:19", "text": "レベル上限だけど、このゲームは"}, {"type": "subtitle", "time": 5841.91, "timestamp": "01:37:21", "text": "レベル45になると報酬がもらえます"}, {"type": "subtitle", "time": 5843.83, "timestamp": "01:37:23", "text": "などなど。それが私が"}, {"type": "subtitle", "time": 5846.43, "timestamp": "01:37:26", "text": "レベルアップしてゴールドを獲得しよう"}, {"type": "subtitle", "time": 5848.629, "timestamp": "01:37:28", "text": "兵器。ほかに何か？私はそれをやります"}, {"type": "subtitle", "time": 5850.629, "timestamp": "01:37:30", "text": "原神の時と同じように。私はまだ"}, {"type": "subtitle", "time": 5853.31, "timestamp": "01:37:33", "text": "レベル49で詰まっています。AR"}, {"type": "subtitle", "time": 5856.55, "timestamp": "01:37:36", "text": "49. 経験値を数えるなら、私は"}, {"type": "subtitle", "time": 5861.99, "timestamp": "01:37:41", "text": "今頃はAR56か57か58になっているはずだ。私は"}, {"type": "subtitle", "time": 5866.709, "timestamp": "01:37:46", "text": "レベル上限45を4年間または3年間"}, {"type": "subtitle", "time": 5868.59, "timestamp": "01:37:48", "text": "今。ああ、"}]
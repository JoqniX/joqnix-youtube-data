[{"type": "subtitle", "time": 27121.11, "timestamp": "07:32:01", "text": "完了するか、少なくともこれを取得する"}, {"type": "subtitle", "time": 27123.91, "timestamp": "07:32:03", "text": "えっと、第33章パート3。私たちはする必要があります"}, {"type": "subtitle", "time": 27125.19, "timestamp": "07:32:05", "text": "それを終わらせてください。これで終わりです"}, {"type": "subtitle", "time": 27127.67, "timestamp": "07:32:07", "text": "実際には章です。私は自分が"}, {"type": "subtitle", "time": 27130.948, "timestamp": "07:32:10", "text": "そこまで到達できるが、"}, {"type": "subtitle", "time": 27135.31, "timestamp": "07:32:15", "text": "試す。やってみます。だから私たちは"}, {"type": "subtitle", "time": 27137.91, "timestamp": "07:32:17", "text": "試す。よし、かくれんぼをするぞ"}, {"type": "subtitle", "time": 27140.19, "timestamp": "07:32:20", "text": "行われるイベントも"}, {"type": "subtitle", "time": 27142.628, "timestamp": "07:32:22", "text": "進捗。ええと、この機能ゾーンは、"}, {"type": "subtitle", "time": 27146.628, "timestamp": "07:32:26", "text": "我々が必要としていたチップ関連のイベントも実現した。だから期待している"}, {"type": "subtitle", "time": 27149.11, "timestamp": "07:32:29", "text": "今日は物事がうまくいくでしょう。私達はします"}, {"type": "subtitle", "time": 27151.19, "timestamp": "07:32:31", "text": "えっと、2つのスペースをアンロックできるといいな"}, {"type": "subtitle", "time": 27155.11, "timestamp": "07:32:35", "text": "イベント。うん。そして、救済"}, {"type": "subtitle", "time": 27159.11, "timestamp": "07:32:39", "text": "作戦は、えっと、私は、えっと、好きです"}, {"type": "subtitle", "time": 27161.868, "timestamp": "07:32:41", "text": "ヴァレリンのストリームを終了した後、"}, {"type": "subtitle", "time": 27164.35, "timestamp": "07:32:44", "text": "夕方、私はプレイしました"}, {"type": "subtitle", "time": 27167.59, "timestamp": "07:32:47", "text": "ハンカイ。君たちはきっと見たはずだ"}, {"type": "subtitle", "time": 27170.07, "timestamp": "07:32:50", "text": "ストリームを終了している間に終了したから"}, {"type": "subtitle", "time": 27172.468, "timestamp": "07:32:52", "text": "誤ってハンガイを開いてしまいました"}, {"type": "subtitle", "time": 27176.548, "timestamp": "07:32:56", "text": "ヴァレリン川。そう、私たちはそれをやって、"}, {"type": "subtitle", "time": 27178.99, "timestamp": "07:32:58", "text": "私は現在"}]
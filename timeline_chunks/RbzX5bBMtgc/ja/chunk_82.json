[{"type": "subtitle", "time": 4921.11, "timestamp": "01:22:01", "text": "一部のチームでは交代要員だが、"}, {"type": "subtitle", "time": 4923.03, "timestamp": "01:22:03", "text": "絶対にそうではない、なぜならチャムリーは"}, {"type": "subtitle", "time": 4924.95, "timestamp": "01:22:04", "text": "彼女はローテーションに関してより柔軟に対応できるようになった。"}, {"type": "subtitle", "time": 4927.27, "timestamp": "01:22:07", "text": "しかし、ブラントは、"}, {"type": "subtitle", "time": 4929.03, "timestamp": "01:22:09", "text": "[ __ ]との相乗効果に注目し始めよう"}, {"type": "subtitle", "time": 4931.35, "timestamp": "01:22:11", "text": "リー、クイックスワップするかどうか"}, {"type": "subtitle", "time": 4933.27, "timestamp": "01:22:13", "text": "または、ブランドを使用して[ __ ]を磨きます"}, {"type": "subtitle", "time": 4935.43, "timestamp": "01:22:15", "text": "リー、君はクリアすることになる"}, {"type": "subtitle", "time": 4938.47, "timestamp": "01:22:18", "text": "コンテンツは非常に速く作られるので"}, {"type": "subtitle", "time": 4940.87, "timestamp": "01:22:20", "text": "お互いのために。ブランドとシャン・リーは"}, {"type": "subtitle", "time": 4943.27, "timestamp": "01:22:23", "text": "どちらも優れたクイックスワップキャラクターであり、"}, {"type": "subtitle", "time": 4945.27, "timestamp": "01:22:25", "text": "ブラントは、"}, {"type": "subtitle", "time": 4947.51, "timestamp": "01:22:27", "text": "[ __ ]・リーの強化について。だから、"}, {"type": "subtitle", "time": 4949.51, "timestamp": "01:22:29", "text": "正直言って、本当に良い組み合わせです"}, {"type": "subtitle", "time": 4951.99, "timestamp": "01:22:31", "text": "文字数。そして、もしあなたが"}, {"type": "subtitle", "time": 4955.03, "timestamp": "01:22:35", "text": "[ __ ]・リー、ブラントのメインDPSは"}, {"type": "subtitle", "time": 4957.59, "timestamp": "01:22:37", "text": "これもかなり良い。それはよりずっと良い"}, {"type": "subtitle", "time": 4960.95, "timestamp": "01:22:40", "text": "ほとんどのサブDPSがメインDPSチームになるのは"}, {"type": "subtitle", "time": 4962.709, "timestamp": "01:22:42", "text": "ブランは、"}, {"type": "subtitle", "time": 4964.709, "timestamp": "01:22:44", "text": "他のサブDPSキャラクターも同様に"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "完璧な緩衝材として"}, {"type": "subtitle", "time": 4969.43, "timestamp": "01:22:49", "text": "ソノア。ええ、このキャラクターがまた戻ってきました。"}, {"type": "subtitle", "time": 4972.149, "timestamp": "01:22:52", "text": "スアはそれほど素晴らしいのだ。つまり、ブランドは"}, {"type": "subtitle", "time": 4975.03, "timestamp": "01:22:55", "text": "たくさん。しかしグラントには大きなものが一つある"}, {"type": "subtitle", "time": 4977.11, "timestamp": "01:22:57", "text": "デメリットは、"}, {"type": "subtitle", "time": 4979.99, "timestamp": "01:22:59", "text": "トレードマークとなる武器は必須です。"}]
[{"type": "subtitle", "time": 10692.23, "timestamp": "02:58:12", "text": "[音楽]"}, {"type": "subtitle", "time": 10695.67, "timestamp": "02:58:15", "text": "一体何騒いでるんだ？はぁ？あれは何でしょう"}, {"type": "subtitle", "time": 10701.91, "timestamp": "02:58:21", "text": "[音楽]"}, {"type": "subtitle", "time": 10705.83, "timestamp": "02:58:25", "text": "Hung Xen 全体をご覧ください。"}, {"type": "subtitle", "time": 10710.71, "timestamp": "02:58:30", "text": "指輪とぶら下がり。ああ、なるほど。なるほど。"}, {"type": "subtitle", "time": 10713.429, "timestamp": "02:58:33", "text": "全く見当もつきません。彼は私みたいだ"}, {"type": "subtitle", "time": 10716.55, "timestamp": "02:58:36", "text": "ポケモンが大好きです。最後の部分だけは理解できます"}, {"type": "subtitle", "time": 10717.23, "timestamp": "02:58:37", "text": "の"}, {"type": "subtitle", "time": 10720.269, "timestamp": "02:58:40", "text": "リー。そして今これ"}, {"type": "subtitle", "time": 10723.11, "timestamp": "02:58:43", "text": "次。どうやってそれらすべてを手に入れたのですか？"}, {"type": "subtitle", "time": 10725.429, "timestamp": "02:58:45", "text": "隠された意味？"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "私は会話シーンを飛ばします。できました"}]
[{"type": "subtitle", "time": 7747.589, "timestamp": "02:09:07", "text": "私の専門分野。"}, {"type": "subtitle", "time": 7749.75, "timestamp": "02:09:09", "text": "瞬きするな。"}, {"type": "subtitle", "time": 7773.03, "timestamp": "02:09:33", "text": "ファンを解き放て。"}, {"type": "subtitle", "time": 7775.109, "timestamp": "02:09:35", "text": "絶滅させる、"}, {"type": "subtitle", "time": 7777.51, "timestamp": "02:09:37", "text": "兄弟。これは大変だった。手が痛い。"}]
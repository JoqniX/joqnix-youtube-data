[{"type": "subtitle", "time": 11295.19, "timestamp": "03:08:15", "text": "私はただ"}, {"type": "subtitle", "time": 11305.15, "timestamp": "03:08:25", "text": "主。"}, {"type": "subtitle", "time": 11315.59, "timestamp": "03:08:35", "text": "できればまた時間を作って"}, {"type": "subtitle", "time": 11318.79, "timestamp": "03:08:38", "text": "アドベンチャー。進むべき道がはっきりと見えた。そうします"}, {"type": "subtitle", "time": 11333.59, "timestamp": "03:08:53", "text": "理解した。私はあなたのためにここにいます"}, {"type": "subtitle", "time": 11335.79, "timestamp": "03:08:55", "text": "意思。もっと笑顔を心がけるべきだな。あなた"}, {"type": "subtitle", "time": 11339.51, "timestamp": "03:08:59", "text": "こう言ってください。"}]
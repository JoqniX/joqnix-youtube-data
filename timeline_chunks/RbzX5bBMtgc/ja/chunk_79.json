[{"type": "subtitle", "time": 4740.95, "timestamp": "01:19:00", "text": "ゲーム、もしかしたら最高傑作かもしれない。私は"}, {"type": "subtitle", "time": 4743.03, "timestamp": "01:19:03", "text": "コラダには9点満点を与えなければならない"}, {"type": "subtitle", "time": 4745.669, "timestamp": "01:19:05", "text": "10. 正直言って、素晴らしい人物だ"}, {"type": "subtitle", "time": 4747.669, "timestamp": "01:19:07", "text": "あまり悪いとは言えない"}, {"type": "subtitle", "time": 4749.75, "timestamp": "01:19:09", "text": "について。次に話すキャラクター"}, {"type": "subtitle", "time": 4752.59, "timestamp": "01:19:12", "text": "はロチアについてです。誰"}, {"type": "subtitle", "time": 4756.79, "timestamp": "01:19:16", "text": "ロイア？何？ああ、なんて馬鹿げた"}, {"type": "subtitle", "time": 4759.55, "timestamp": "01:19:19", "text": "もの。このブラウザは本当に使いづらい。"}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "トリュフ・ブラッドウィック、お前の神を正せ。修理"}, {"type": "subtitle", "time": 4772.91, "timestamp": "01:19:32", "text": "兄弟。バグが多すぎる。アルファ版だとは分かっているけど"}, {"type": "subtitle", "time": 4781.51, "timestamp": "01:19:41", "text": "ロイア。彼女は、"}, {"type": "subtitle", "time": 4783.51, "timestamp": "01:19:43", "text": "発売はそれほど多くの"}, {"type": "subtitle", "time": 4785.75, "timestamp": "01:19:45", "text": "価値。ほら、彼女は献身的な"}, {"type": "subtitle", "time": 4788.149, "timestamp": "01:19:48", "text": "チャメリアへの支援、彼女の五つ星"}, {"type": "subtitle", "time": 4790.27, "timestamp": "01:19:50", "text": "サポート、"}, {"type": "subtitle", "time": 4793.11, "timestamp": "01:19:53", "text": "しかし既に"}, {"type": "subtitle", "time": 4796.87, "timestamp": "01:19:56", "text": "なぜなら、スアはそれほど素晴らしいからだ。ロチア"}, {"type": "subtitle", "time": 4799.59, "timestamp": "01:19:59", "text": "非常に残念な課題を抱えている"}]
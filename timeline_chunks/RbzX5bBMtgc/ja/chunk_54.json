[{"type": "subtitle", "time": 3267.589, "timestamp": "00:54:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3269.51, "timestamp": "00:54:29", "text": "やらなければならないことがたくさんありますよね？私たちは"}, {"type": "subtitle", "time": 3271.27, "timestamp": "00:54:31", "text": "探索は後でできます。私たちは"}, {"type": "subtitle", "time": 3293.15, "timestamp": "00:54:53", "text": "ええと、私たちはどちらでもできます。ええと、チャンと"}, {"type": "subtitle", "time": 3296.43, "timestamp": "00:54:56", "text": "キア。我々はできる"}, {"type": "subtitle", "time": 3299.79, "timestamp": "00:54:59", "text": "イベントをすべきでしょうか"}]
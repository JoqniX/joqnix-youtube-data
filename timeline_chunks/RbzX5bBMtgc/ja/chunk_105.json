[{"type": "subtitle", "time": 6306.47, "timestamp": "01:45:06", "text": "クエスト。 PhmスキンはEcho用です。わかった。の"}, {"type": "subtitle", "time": 6309.51, "timestamp": "01:45:09", "text": "問題は、えっと、私はまだこれらを持っているということです"}, {"type": "subtitle", "time": 6313.03, "timestamp": "01:45:13", "text": "探索クエストとか色々やってるから、"}, {"type": "subtitle", "time": 6315.43, "timestamp": "01:45:15", "text": "まるで、終わらせるべきかどうか迷っているような感じ。何が"}, {"type": "subtitle", "time": 6317.43, "timestamp": "01:45:17", "text": "今、私がすべきだと思うことは？新しい"}, {"type": "subtitle", "time": 6319.189, "timestamp": "01:45:19", "text": "私が探検しなければならない地域。私はすべきでしょうか"}, {"type": "subtitle", "time": 6321.27, "timestamp": "01:45:21", "text": "現在の地域の探索を終え、"}, {"type": "subtitle", "time": 6327.79, "timestamp": "01:45:27", "text": "そこには？それは"}, {"type": "subtitle", "time": 6331.07, "timestamp": "01:45:31", "text": "より良い？私は89歳以上です"}, {"type": "subtitle", "time": 6335.91, "timestamp": "01:45:35", "text": "ここ。 168 78。これらの場所だけ"}, {"type": "subtitle", "time": 6339.51, "timestamp": "01:45:39", "text": "私は必要なものをすべて手に入れる必要がある。私は思う"}, {"type": "subtitle", "time": 6341.75, "timestamp": "01:45:41", "text": "それでおしまい。それ以外は全て100です。"}, {"type": "subtitle", "time": 6346.31, "timestamp": "01:45:46", "text": "北部の男爵たちも同様だ。それでおしまい。"}]
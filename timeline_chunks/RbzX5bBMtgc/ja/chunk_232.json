[{"type": "subtitle", "time": 13932.79, "timestamp": "03:52:12", "text": "ごま。ちょっと怖いかもしれないけど、"}, {"type": "subtitle", "time": 13935.67, "timestamp": "03:52:15", "text": "もちろん、これ以上明るく暖かいものはない"}, {"type": "subtitle", "time": 13937.59, "timestamp": "03:52:17", "text": "火よりも。"}, {"type": "subtitle", "time": 13939.83, "timestamp": "03:52:19", "text": "それは、教えた共鳴器が"}, {"type": "subtitle", "time": 13941.99, "timestamp": "03:52:21", "text": "私にも、彼らはたくさんのことを言った"}, {"type": "subtitle", "time": 13945.189, "timestamp": "03:52:25", "text": "理解できなかった。しかし、もし私が使わないなら"}, {"type": "subtitle", "time": 13947.99, "timestamp": "03:52:27", "text": "私の得意分野は、"}, {"type": "subtitle", "time": 13950.87, "timestamp": "03:52:30", "text": "より長く生きる？私は生きたい。欲しい"}, {"type": "subtitle", "time": 13953.269, "timestamp": "03:52:33", "text": "自分の力をうまく制御し、"}, {"type": "subtitle", "time": 13955.51, "timestamp": "03:52:35", "text": "私を守ってくれた人々を守れ。そして"}, {"type": "subtitle", "time": 13963.269, "timestamp": "03:52:43", "text": "はい、村の先生によると、"}, {"type": "subtitle", "time": 13965.429, "timestamp": "03:52:45", "text": "これらの子供たち、私はまだ"}, {"type": "subtitle", "time": 13966.99, "timestamp": "03:52:46", "text": "学ぶ。"}, {"type": "subtitle", "time": 13969.67, "timestamp": "03:52:49", "text": "だから、本当に"}]
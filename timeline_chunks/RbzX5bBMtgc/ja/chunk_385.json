[{"type": "subtitle", "time": 23123.43, "timestamp": "06:25:23", "text": "連れて行ってあげましょう。進むべき道がはっきりと見えた。いいえ"}, {"type": "subtitle", "time": 23126.15, "timestamp": "06:25:26", "text": "急ぐ。せっかちな人はすぐに落ちるだろう"}, {"type": "subtitle", "time": 23128.03, "timestamp": "06:25:28", "text": "私たちの膝の上に。"}, {"type": "subtitle", "time": 23148.75, "timestamp": "06:25:48", "text": "よし、それでは話がまとまった。ない"}, {"type": "subtitle", "time": 23152.628, "timestamp": "06:25:52", "text": "悪い。今は良くなった。良い。ない"}, {"type": "subtitle", "time": 23155.83, "timestamp": "06:25:55", "text": "無駄にする時間。"}]
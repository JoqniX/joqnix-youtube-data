[{"type": "subtitle", "time": 15660.149, "timestamp": "04:21:00", "text": "ああ、まさにその通りです。脱出する唯一の方法"}, {"type": "subtitle", "time": 15663.11, "timestamp": "04:21:03", "text": "ソノロスフィアを燃やすことによって"}, {"type": "subtitle", "time": 15665.429, "timestamp": "04:21:05", "text": "中にいる人に危害を加える。"}, {"type": "subtitle", "time": 15669.75, "timestamp": "04:21:09", "text": "フォルテの巧みなコントロールが必要だった。"}, {"type": "subtitle", "time": 15673.189, "timestamp": "04:21:13", "text": "今思えば、それはおそらく彼の"}, {"type": "subtitle", "time": 15680.469, "timestamp": "04:21:20", "text": "それが彼の最初の目標だった"}, {"type": "subtitle", "time": 15682.79, "timestamp": "04:21:22", "text": "ソノロスフィア。"}, {"type": "subtitle", "time": 15685.349, "timestamp": "04:21:25", "text": "2つ目。"}, {"type": "subtitle", "time": 15688.389, "timestamp": "04:21:28", "text": "出発前に、師匠は私に"}, {"type": "subtitle", "time": 15692.469, "timestamp": "04:21:32", "text": "その人物を見つけ出すための任務。の"}, {"type": "subtitle", "time": 15695.269, "timestamp": "04:21:35", "text": "彼と一緒にWiiで遊んだことのある人。その人は"}, {"type": "subtitle", "time": 15699.349, "timestamp": "04:21:39", "text": "その試合記録は彼の手から離れていた。来た。"}, {"type": "subtitle", "time": 15702.149, "timestamp": "04:21:42", "text": "私の師匠が亡くなった後、彼女は"}, {"type": "subtitle", "time": 15704.75, "timestamp": "04:21:44", "text": "制御できる唯一の人"}, {"type": "subtitle", "time": 15707.99, "timestamp": "04:21:47", "text": "ソナロスフィア。今頃はもうご存知のはずです"}, {"type": "subtitle", "time": 15711.55, "timestamp": "04:21:51", "text": "彼女が誰なのか。それは"}, {"type": "subtitle", "time": 15715.189, "timestamp": "04:21:55", "text": "自分。私でしょうか？"}]
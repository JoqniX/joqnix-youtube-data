[{"type": "subtitle", "time": 20856.27, "timestamp": "05:47:36", "text": "人生は"}, {"type": "subtitle", "time": 20858.83, "timestamp": "05:47:38", "text": "悪い。人生は"}, {"type": "subtitle", "time": 20861.91, "timestamp": "05:47:41", "text": "悪い。リンゴに虫がいるなんてあり得るだろうか"}, {"type": "subtitle", "time": 20865.51, "timestamp": "05:47:45", "text": "その中は？そしてなぜ私の背中は"}, {"type": "subtitle", "time": 20868.47, "timestamp": "05:47:48", "text": "ドアに鍵がかかっていますか？なぜ私の家族は私を閉じ込めたのか"}, {"type": "subtitle", "time": 20870.83, "timestamp": "05:47:50", "text": "外？私は使わなければならなかった"}, {"type": "subtitle", "time": 20874.23, "timestamp": "05:47:54", "text": "屋外トイレ。神に感謝、彼らは建てた"}]
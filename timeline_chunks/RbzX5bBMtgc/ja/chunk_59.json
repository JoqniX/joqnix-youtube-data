[{"type": "subtitle", "time": 3550.069, "timestamp": "00:59:10", "text": "ああ、これをプレイするのは久しぶりだ"}, {"type": "subtitle", "time": 3560.23, "timestamp": "00:59:20", "text": "戦闘システムはあまり変わっていません。"}, {"type": "subtitle", "time": 3572.51, "timestamp": "00:59:32", "text": "こんにちは、"}, {"type": "subtitle", "time": 3575.069, "timestamp": "00:59:35", "text": "バカ。お元気ですか？"}, {"type": "subtitle", "time": 3577.67, "timestamp": "00:59:37", "text": "良い。風化波を設置しました"}]
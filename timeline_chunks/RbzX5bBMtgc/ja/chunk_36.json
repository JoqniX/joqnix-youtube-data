[{"type": "subtitle", "time": 2160.95, "timestamp": "00:36:00", "text": "世界の未来を予測するが、"}, {"type": "subtitle", "time": 2165.75, "timestamp": "00:36:05", "text": "どの曲が人々にとって。彼女を手に入れることはできないのでしょうか？"}, {"type": "subtitle", "time": 2168.95, "timestamp": "00:36:08", "text": "何かお手伝いできることはありますか？何が"}, {"type": "subtitle", "time": 2170.87, "timestamp": "00:36:10", "text": "これらのキャラクター？これらはすべてとても"}, {"type": "subtitle", "time": 2173.79, "timestamp": "00:36:13", "text": "かわいい。"}, {"type": "subtitle", "time": 2176.55, "timestamp": "00:36:16", "text": "理解した。私はあなたのためにここにいます"}, {"type": "subtitle", "time": 2184.79, "timestamp": "00:36:24", "text": "何か具体的なことを祈ってもいいですか？の"}, {"type": "subtitle", "time": 2188.07, "timestamp": "00:36:28", "text": "戦場。実験が始まる。"}, {"type": "subtitle", "time": 2192.55, "timestamp": "00:36:32", "text": "[音楽]"}, {"type": "subtitle", "time": 2194.87, "timestamp": "00:36:34", "text": "それが"}, {"type": "subtitle", "time": 2197.829, "timestamp": "00:36:37", "text": "見せびらかすため、あるいは戦闘のため。私一人で決める"}, {"type": "subtitle", "time": 2208.23, "timestamp": "00:36:48", "text": "ランド・H。人生はどの段階へと導くのか"}, {"type": "subtitle", "time": 2210.51, "timestamp": "00:36:50", "text": "次は私たちですか？"}, {"type": "subtitle", "time": 2214.34, "timestamp": "00:36:54", "text": "何かお手伝いできることはありますか？"}, {"type": "subtitle", "time": 2216.31, "timestamp": "00:36:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4983.11, "timestamp": "01:23:03", "text": "基本的に、それを持たないことは"}, {"type": "subtitle", "time": 4985.75, "timestamp": "01:23:05", "text": "損害率20％。そしてそれは仮定の話です"}, {"type": "subtitle", "time": 4988.229, "timestamp": "01:23:08", "text": "あなたはスロットマシンで2番目に良いものを持っています。彼は"}, {"type": "subtitle", "time": 4990.55, "timestamp": "01:23:10", "text": "圧倒的に署名に依存している"}, {"type": "subtitle", "time": 4993.189, "timestamp": "01:23:13", "text": "ゲーム全体を通してのキャラクター。そして私は"}, {"type": "subtitle", "time": 4995.189, "timestamp": "01:23:15", "text": "陰ランド以外の誰も"}, {"type": "subtitle", "time": 4997.75, "timestamp": "01:23:17", "text": "この点では、かなり近いと言える。しかし、"}, {"type": "subtitle", "time": 5000.07, "timestamp": "01:23:20", "text": "それにもかかわらず、ブラントは良いと思う"}, {"type": "subtitle", "time": 5003.189, "timestamp": "01:23:23", "text": "10点満点中7.5点の評価。それで、あなたは誰ですか？"}, {"type": "subtitle", "time": 5005.03, "timestamp": "01:23:25", "text": "後半は引っ張ることになるだろう"}, {"type": "subtitle", "time": 5008.149, "timestamp": "01:23:28", "text": "ウィザリング・ウェーブ2.3？私は目を持っています"}, {"type": "subtitle", "time": 5010.87, "timestamp": "01:23:30", "text": "私はフィービーメインなのでチコナで。全て"}, {"type": "subtitle", "time": 5012.31, "timestamp": "01:23:32", "text": "他のキャラクターは既に持っています、"}, {"type": "subtitle", "time": 5013.83, "timestamp": "01:23:33", "text": "ロチアを除いては、"}, {"type": "subtitle", "time": 5015.59, "timestamp": "01:23:35", "text": "興味があります。"}, {"type": "subtitle", "time": 5017.11, "timestamp": "01:23:37", "text": "以下のコメント欄をご覧ください。そして、落ち込んでいる間に"}, {"type": "subtitle", "time": 5018.55, "timestamp": "01:23:38", "text": "そこで、必ずビデオに「いいね」をして"}, {"type": "subtitle", "time": 5020.31, "timestamp": "01:23:40", "text": "チャンネル登録してください。もしあなたが"}, {"type": "subtitle", "time": 5022.31, "timestamp": "01:23:42", "text": "質問があれば、ぜひ私の"}, {"type": "subtitle", "time": 5024.149, "timestamp": "01:23:44", "text": "不和。私はそこでかなり活発に活動しているので、"}, {"type": "subtitle", "time": 5025.75, "timestamp": "01:23:45", "text": "質問をすれば、"}, {"type": "subtitle", "time": 5027.35, "timestamp": "01:23:47", "text": "返信する可能性はかなり高いです。"}]
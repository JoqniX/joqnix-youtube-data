[{"type": "subtitle", "time": 23583.75, "timestamp": "06:33:03", "text": "起こったことはすべて興味深い"}, {"type": "subtitle", "time": 23586.23, "timestamp": "06:33:06", "text": "今日。"}, {"type": "subtitle", "time": 23588.31, "timestamp": "06:33:08", "text": "目的地はどこですか？私はパニックになっていた"}, {"type": "subtitle", "time": 23600.51, "timestamp": "06:33:20", "text": "私は自分の"}, {"type": "subtitle", "time": 23603.39, "timestamp": "06:33:23", "text": "イヤホン。えっと、私が外したとき"}, {"type": "subtitle", "time": 23607.99, "timestamp": "06:33:27", "text": "ヘッドホン、イヤホンがなぜかなくなっていた。それ"}, {"type": "subtitle", "time": 23612.868, "timestamp": "06:33:32", "text": "左隅に向かって飛んでいった"}, {"type": "subtitle", "time": 23614.03, "timestamp": "06:33:34", "text": "何と呼ぶか"}, {"type": "subtitle", "time": 23617.75, "timestamp": "06:33:37", "text": "それ？左側の角。そしてそれが"}, {"type": "subtitle", "time": 23622.54, "timestamp": "06:33:42", "text": "多く。"}, {"type": "chat", "time": 23624.518, "timestamp": "06:33:44", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "where was it found??"}, {"type": "subtitle", "time": 23625.31, "timestamp": "06:33:45", "text": "[音楽]"}, {"type": "subtitle", "time": 23629.27, "timestamp": "06:33:49", "text": "ケンザー。それは興味深いですね。"}, {"type": "subtitle", "time": 23632.31, "timestamp": "06:33:52", "text": "それから、その直前に食べたリンゴ"}, {"type": "subtitle", "time": 23634.51, "timestamp": "06:33:54", "text": "ちょうど1時間前"}]
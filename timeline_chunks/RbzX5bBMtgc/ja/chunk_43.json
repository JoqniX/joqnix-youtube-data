[{"type": "subtitle", "time": 2585.51, "timestamp": "00:43:05", "text": "ここは観光客が来る場所ではない。"}, {"type": "subtitle", "time": 2588.23, "timestamp": "00:43:08", "text": "ああ、彼は"}, {"type": "subtitle", "time": 2591.19, "timestamp": "00:43:11", "text": "さあ、続けて。また私なの？ああ、君"}, {"type": "subtitle", "time": 2603.79, "timestamp": "00:43:23", "text": "仕事。貧しい"}, {"type": "subtitle", "time": 2617.829, "timestamp": "00:43:37", "text": "上司を巡る争いに仕事が山積みになった。"}, {"type": "subtitle", "time": 2621.26, "timestamp": "00:43:41", "text": "心を開いて、五感を解き放ちましょう。"}, {"type": "subtitle", "time": 2634.27, "timestamp": "00:43:54", "text": "実行する"}, {"type": "subtitle", "time": 2636.39, "timestamp": "00:43:56", "text": "工事。すべてのターゲットは"}]
[{"type": "subtitle", "time": 15720.95, "timestamp": "04:22:00", "text": "全く覚えていない。だからあなたは"}, {"type": "subtitle", "time": 15723.95, "timestamp": "04:22:03", "text": "君は私を道案内役として必要としていたんだね。"}, {"type": "subtitle", "time": 15730.87, "timestamp": "04:22:10", "text": "そしてあなたが到着した瞬間から"}, {"type": "subtitle", "time": 15733.67, "timestamp": "04:22:13", "text": "ジンジョ、私はあなたの"}, {"type": "subtitle", "time": 15734.59, "timestamp": "04:22:14", "text": "真実"}, {"type": "subtitle", "time": 15737.189, "timestamp": "04:22:17", "text": "身元。天空山への旅"}, {"type": "subtitle", "time": 15739.71, "timestamp": "04:22:19", "text": "私の信念を確固たるものにした。"}, {"type": "subtitle", "time": 15744.269, "timestamp": "04:22:24", "text": "ああ、最後に、あの道案内板"}, {"type": "subtitle", "time": 15748.07, "timestamp": "04:22:28", "text": "ソノロスフィアは私にとって真実を確固たるものにしてくれた。私"}, {"type": "subtitle", "time": 15752.149, "timestamp": "04:22:32", "text": "わかった。もちろん、何でも聞いてください。喜んで"}, {"type": "subtitle", "time": 15756.63, "timestamp": "04:22:36", "text": "それらに答えてください。確かに、それらの記憶は"}, {"type": "subtitle", "time": 15765.309, "timestamp": "04:22:45", "text": "[音楽]"}, {"type": "subtitle", "time": 15766.83, "timestamp": "04:22:46", "text": "本物。"}, {"type": "subtitle", "time": 15770.469, "timestamp": "04:22:50", "text": "はい、それはすべて過去のことです。ただ"}, {"type": "subtitle", "time": 15773.59, "timestamp": "04:22:53", "text": "名前のない、小さなホームレスの少女。私"}, {"type": "subtitle", "time": 15775.51, "timestamp": "04:22:55", "text": "新しい思い出を作れるなんて思ってもみなかった"}, {"type": "subtitle", "time": 15776.349, "timestamp": "04:22:56", "text": "で"}, {"type": "subtitle", "time": 15778.95, "timestamp": "04:22:58", "text": "過去だけが繰り返される音響空間"}]
[{"type": "subtitle", "time": 27663.31, "timestamp": "07:41:03", "text": "楽しむ？ああ、アインシュタインバンド45。"}, {"type": "subtitle", "time": 27669.548, "timestamp": "07:41:09", "text": "親切？私たちが"}, {"type": "subtitle", "time": 27672.15, "timestamp": "07:41:12", "text": "行く前に、調整する必要がある"}, {"type": "subtitle", "time": 27674.07, "timestamp": "07:41:14", "text": "音量。ちょっとうるさいですね。そうでしょう"}, {"type": "subtitle", "time": 27675.468, "timestamp": "07:41:15", "text": "考える"}, {"type": "subtitle", "time": 27677.83, "timestamp": "07:41:17", "text": "それで？そう思いませんか？それはある意味"}, {"type": "subtitle", "time": 27692.24, "timestamp": "07:41:32", "text": "すべてのポップはうるさすぎない"}, {"type": "subtitle", "time": 27698.21, "timestamp": "07:41:38", "text": "今。よし、"}, {"type": "subtitle", "time": 27700.19, "timestamp": "07:41:40", "text": "[音楽]"}, {"type": "subtitle", "time": 27703.51, "timestamp": "07:41:43", "text": "行く。つまり、たとえあなたが口がきけなくても、"}, {"type": "subtitle", "time": 27706.31, "timestamp": "07:41:46", "text": "話さないで、せめて「えーと」とか言って"}, {"type": "subtitle", "time": 27708.788, "timestamp": "07:41:48", "text": "マイクなしチャットを使用して、"}, {"type": "subtitle", "time": 27712.31, "timestamp": "07:41:52", "text": "会話ですよね？つまり、ある意味では"}, {"type": "subtitle", "time": 27715.59, "timestamp": "07:41:55", "text": "まあ、いいんだけどね。ご心配なく。うん。"}]
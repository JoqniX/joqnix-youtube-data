[{"type": "subtitle", "time": 16680.75, "timestamp": "04:38:00", "text": "[音楽]"}, {"type": "subtitle", "time": 16686.23, "timestamp": "04:38:06", "text": "今？なぜ今なのか？すべての日の神。"}, {"type": "subtitle", "time": 16700.189, "timestamp": "04:38:20", "text": "離れて？私は"}, {"type": "subtitle", "time": 16703.709, "timestamp": "04:38:23", "text": "文字通り私のすべてを散らかします"}, {"type": "subtitle", "time": 16720.07, "timestamp": "04:38:40", "text": "明日は神に誓って"}, {"type": "subtitle", "time": 16723.99, "timestamp": "04:38:43", "text": "予想もしなかった場所にそれを見つけた"}, {"type": "subtitle", "time": 16728.54, "timestamp": "04:38:48", "text": "そうなるべきだし、私はそうなるだろう"}, {"type": "subtitle", "time": 16739.31, "timestamp": "04:38:59", "text": "[音楽]"}]
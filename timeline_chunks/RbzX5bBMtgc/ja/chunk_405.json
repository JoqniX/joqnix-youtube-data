[{"type": "subtitle", "time": 24303.23, "timestamp": "06:45:03", "text": "その"}, {"type": "subtitle", "time": 24306.468, "timestamp": "06:45:06", "text": "時間。その場に留まってください。"}, {"type": "subtitle", "time": 24332.15, "timestamp": "06:45:32", "text": "根絶せよ。"}, {"type": "subtitle", "time": 24335.35, "timestamp": "06:45:35", "text": "私に任せてください。"}, {"type": "subtitle", "time": 24338.788, "timestamp": "06:45:38", "text": "戦争においては、あらゆる手段が許される。"}, {"type": "subtitle", "time": 24352.31, "timestamp": "06:45:52", "text": "その時が来た。待って、あなたは私を殺せない。私"}]
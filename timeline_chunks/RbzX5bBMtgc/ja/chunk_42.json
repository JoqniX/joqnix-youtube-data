[{"type": "subtitle", "time": 2535.109, "timestamp": "00:42:15", "text": "[音楽]"}, {"type": "subtitle", "time": 2538.23, "timestamp": "00:42:18", "text": "やあ、署長。私たちは隠れていました"}, {"type": "subtitle", "time": 2541.47, "timestamp": "00:42:21", "text": "一日中換気扇を回す。私たちの足はまだ"}, {"type": "subtitle", "time": 2544.309, "timestamp": "00:42:24", "text": "眠っている。家畜の方が楽だ"}, {"type": "subtitle", "time": 2546.71, "timestamp": "00:42:26", "text": "これよりも。もう少しやる気を見せてくれないか"}, {"type": "subtitle", "time": 2549.51, "timestamp": "00:42:29", "text": "一度？"}, {"type": "subtitle", "time": 2559.43, "timestamp": "00:42:39", "text": "もう我慢できない。私は眠っていない"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "数日で適切に処理されます。医者でさえ"}, {"type": "subtitle", "time": 2564.71, "timestamp": "00:42:44", "text": "私に休ませるために。文句を言うのはやめて、"}, {"type": "subtitle", "time": 2567.87, "timestamp": "00:42:47", "text": "仕事。ボスはいつでもここにいます"}]
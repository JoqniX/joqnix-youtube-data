[{"type": "subtitle", "time": 11834.67, "timestamp": "03:17:14", "text": "いいえ。これは誰ですか？"}, {"type": "subtitle", "time": 11837.91, "timestamp": "03:17:17", "text": "レディ？何してるの？"}, {"type": "subtitle", "time": 11840.67, "timestamp": "03:17:20", "text": "私たちに力を与えてくれますか？"}, {"type": "subtitle", "time": 11843.67, "timestamp": "03:17:23", "text": "生き残る？生きる力を与えてくれる"}, {"type": "subtitle", "time": 11854.75, "timestamp": "03:17:34", "text": "[音楽]"}, {"type": "subtitle", "time": 11857.71, "timestamp": "03:17:37", "text": "の"}, {"type": "subtitle", "time": 11865.63, "timestamp": "03:17:45", "text": "笑顔。そして彼女はあなたに許す"}, {"type": "subtitle", "time": 11869.389, "timestamp": "03:17:49", "text": "ブラックホールに突入する。"}, {"type": "subtitle", "time": 11872.429, "timestamp": "03:17:52", "text": "なぜ？皆さんは"}, {"type": "subtitle", "time": 11876.389, "timestamp": "03:17:56", "text": "自分。待って、何が起こっているのか"}, {"type": "subtitle", "time": 11878.99, "timestamp": "03:17:58", "text": "彼女？彼女は"}]
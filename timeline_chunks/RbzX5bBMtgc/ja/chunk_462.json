[{"type": "subtitle", "time": 27722.99, "timestamp": "07:42:02", "text": "今日？ハシャマはどのように"}, {"type": "subtitle", "time": 27725.75, "timestamp": "07:42:05", "text": "何をしているの？そして、私は配信すると言いましたよね。そして"}, {"type": "subtitle", "time": 27741.43, "timestamp": "07:42:21", "text": "午前。それが一つ目です。"}, {"type": "subtitle", "time": 27754.388, "timestamp": "07:42:34", "text": "痛みを避ける。私はそれを避けたい。欲しい"}, {"type": "subtitle", "time": 27778.31, "timestamp": "07:42:58", "text": "[音楽]"}]
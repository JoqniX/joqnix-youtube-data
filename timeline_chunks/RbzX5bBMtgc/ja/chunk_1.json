[{"type": "subtitle", "time": 63.63, "timestamp": "00:01:03", "text": "こんにちは。すごく疲れた、"}, {"type": "subtitle", "time": 66.75, "timestamp": "00:01:06", "text": "男。私が"}, {"type": "subtitle", "time": 73.59, "timestamp": "00:01:13", "text": "私が食べたのは"}, {"type": "subtitle", "time": 75.83, "timestamp": "00:01:15", "text": "カップ麺を食べたら、すごく眠くなってきた。"}, {"type": "subtitle", "time": 77.55, "timestamp": "00:01:17", "text": "右"}, {"type": "subtitle", "time": 80.39, "timestamp": "00:01:20", "text": "今。でも夜は寝るべきなのに、"}]
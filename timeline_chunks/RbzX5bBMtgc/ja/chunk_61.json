[{"type": "subtitle", "time": 3662.03, "timestamp": "01:01:02", "text": "不思議。彼女は赤毛だ。彼女はなぜそんなに"}, {"type": "subtitle", "time": 3665.19, "timestamp": "01:01:05", "text": "かわいい？そしてこの女性は、なぜ彼女は"}, {"type": "subtitle", "time": 3667.99, "timestamp": "01:01:07", "text": "かわいい？潮の流れがあなたのことをささやいています"}, {"type": "subtitle", "time": 3669.51, "timestamp": "01:01:09", "text": "到着。"}, {"type": "subtitle", "time": 3673.19, "timestamp": "01:01:13", "text": "彼女はなぜこんなに綺麗なの？"}, {"type": "subtitle", "time": 3675.589, "timestamp": "01:01:15", "text": "潮の流れがあなたのことをささやいています"}, {"type": "subtitle", "time": 3679.99, "timestamp": "01:01:19", "text": "到着。彼女はなぜこんなに綺麗なの？"}, {"type": "subtitle", "time": 3682.95, "timestamp": "01:01:22", "text": "彼女は私の新しいモデルにそっくりだ。ない"}, {"type": "subtitle", "time": 3686.39, "timestamp": "01:01:26", "text": "まさにその通りですが、ある意味では似ています。"}, {"type": "subtitle", "time": 3688.549, "timestamp": "01:01:28", "text": "流れるような流動性は、"}, {"type": "subtitle", "time": 3689.95, "timestamp": "01:01:29", "text": "私の新しい"}, {"type": "subtitle", "time": 3691.789, "timestamp": "01:01:31", "text": "モデル。"}, {"type": "subtitle", "time": 3694.789, "timestamp": "01:01:34", "text": "おお。配色が似ている"}, {"type": "subtitle", "time": 3696.67, "timestamp": "01:01:36", "text": "に"}, {"type": "subtitle", "time": 3699.71, "timestamp": "01:01:39", "text": "私の好み"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "いいね。くそ。彼女が欲しい。彼はもう行ってしまったのか？"}, {"type": "subtitle", "time": 3706.589, "timestamp": "01:01:46", "text": "消えた。私もそうかな"}, {"type": "subtitle", "time": 3709.39, "timestamp": "01:01:49", "text": "遅い？もう遅すぎる。ではない"}]
[{"type": "subtitle", "time": 26942.32, "timestamp": "07:29:02", "text": "水を飲んで戻ってきてください。ええ、そうですね。こんにちは。 こんにちは。今日は元気ですか？お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 26945.04, "timestamp": "07:29:05", "text": "こんにちは。今日は元気ですか？お元気でお過ごしでしょうか 良い。どうやって私を見つけたの？"}, {"type": "subtitle", "time": 26947.958, "timestamp": "07:29:07", "text": "良い。どうやって私を見つけたの？ 今日？ K. これは初めてですか？"}, {"type": "subtitle", "time": 26951.398, "timestamp": "07:29:11", "text": "今日？ K. これは初めてですか？ 時間？えっと、ちょっと待って。今回が初めてですか？"}, {"type": "subtitle", "time": 26960.51, "timestamp": "07:29:20", "text": "うん。私は"}, {"type": "subtitle", "time": 26962.1, "timestamp": "07:29:22", "text": "ベトナム"}, {"type": "subtitle", "time": 26966.99, "timestamp": "07:29:26", "text": "[音楽]"}, {"type": "subtitle", "time": 26968.99, "timestamp": "07:29:28", "text": "ベトナム語。待って"}, {"type": "subtitle", "time": 26972.23, "timestamp": "07:29:32", "text": "2番。これを済ませたら、失礼します。わかった。"}, {"type": "subtitle", "time": 26974.31, "timestamp": "07:29:34", "text": "こんにちは。それでは、少ししたら戻ってきます。"}, {"type": "subtitle", "time": 26977.67, "timestamp": "07:29:37", "text": "今日の目標は"}, {"type": "subtitle", "time": 26982.07, "timestamp": "07:29:42", "text": "最後のえーと、ホンガイの配信。私たちは待っています"}, {"type": "subtitle", "time": 26984.07, "timestamp": "07:29:44", "text": "VRを取り外して、これをお見せします。それで"}, {"type": "subtitle", "time": 26987.31, "timestamp": "07:29:47", "text": "私たちはここにたどり着きました 11章 11"}, {"type": "subtitle", "time": 26989.15, "timestamp": "07:29:49", "text": "16. だから"}, {"type": "subtitle", "time": 26992.628, "timestamp": "07:29:52", "text": "えっと、第11章は何て呼ぶんだっけ？"}, {"type": "subtitle", "time": 26995.67, "timestamp": "07:29:55", "text": "第16話と言えるでしょう。うん。それで"}, {"type": "subtitle", "time": 26998.15, "timestamp": "07:29:58", "text": "70に到達するにはクリアする必要があります"}]
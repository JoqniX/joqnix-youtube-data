[{"type": "subtitle", "time": 6600.55, "timestamp": "01:50:00", "text": "理解する。ああ、時間を止めてくれ。わかった。誰"}, {"type": "subtitle", "time": 6626.95, "timestamp": "01:50:26", "text": "ダタンはもうすぐ20歳です。私は21歳になる必要があります。"}, {"type": "subtitle", "time": 6642.109, "timestamp": "01:50:42", "text": "新しいモンスターが追加されました。"}, {"type": "subtitle", "time": 6645.51, "timestamp": "01:50:45", "text": "だから、そのタンは20だと思う。うん、必要"}, {"type": "subtitle", "time": 6649.51, "timestamp": "01:50:49", "text": "それを にするために、彼らは 25 を追加しました。"}, {"type": "subtitle", "time": 6657.27, "timestamp": "01:50:57", "text": "25. 狂気。つまり、私はそれができる"}]
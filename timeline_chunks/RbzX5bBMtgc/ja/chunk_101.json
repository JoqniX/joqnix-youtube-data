[{"type": "subtitle", "time": 6098.99, "timestamp": "01:41:38", "text": "何か。ユダヤ人を2人捕まえた。わーい。うん、"}, {"type": "subtitle", "time": 6101.51, "timestamp": "01:41:41", "text": "ニース。私はまだ彼に近づくことができます"}, {"type": "subtitle", "time": 6104.55, "timestamp": "01:41:44", "text": "彼がその場所にいるかどうか、彼は掴みかかっていた。はい、"}, {"type": "subtitle", "time": 6116.47, "timestamp": "01:41:56", "text": "理解した。私はあなたのためにここにいます"}]
[{"type": "subtitle", "time": 10563.83, "timestamp": "02:56:03", "text": "Hzenから聞いた話なら、私も騙されたかもしれない。"}, {"type": "subtitle", "time": 10567.269, "timestamp": "02:56:07", "text": "ええ、それがまさにポイントなんです。真実"}, {"type": "subtitle", "time": 10570.15, "timestamp": "02:56:10", "text": "それは小説よりも奇妙なことだ、友よ。"}, {"type": "subtitle", "time": 10572.79, "timestamp": "02:56:12", "text": "その物語のすべての詳細は、"}, {"type": "subtitle", "time": 10578.389, "timestamp": "02:56:18", "text": "イベント。他のことを共有させてください"}, {"type": "subtitle", "time": 10581.349, "timestamp": "02:56:21", "text": "天空の山の伝説。深い"}, {"type": "subtitle", "time": 10584.03, "timestamp": "02:56:24", "text": "その神聖な峰々の中には強力な"}, {"type": "subtitle", "time": 10595.03, "timestamp": "02:56:35", "text": "私たちは皆、マウント・ファーマメントが"}, {"type": "subtitle", "time": 10598.389, "timestamp": "02:56:38", "text": "番人の住処、集会"}, {"type": "subtitle", "time": 10601.19, "timestamp": "02:56:41", "text": "天と地からの霊的なエネルギー"}, {"type": "subtitle", "time": 10603.91, "timestamp": "02:56:43", "text": "数えきれないほどの長い年月。"}, {"type": "subtitle", "time": 10607.11, "timestamp": "02:56:47", "text": "時が経つにつれ、山自体も"}, {"type": "subtitle", "time": 10609.91, "timestamp": "02:56:49", "text": "私たちの雄大な姿をとって"}, {"type": "chat", "time": 10614.468, "timestamp": "02:56:54", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "goooo eat dinna dayoooo"}, {"type": "subtitle", "time": 10615.75, "timestamp": "02:56:55", "text": "山に長く住んでいる"}, {"type": "subtitle", "time": 10619.03, "timestamp": "02:56:59", "text": "新鮮な空気に囲まれた長い時間"}]
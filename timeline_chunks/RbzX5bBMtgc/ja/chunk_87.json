[{"type": "subtitle", "time": 5220.35, "timestamp": "01:27:00", "text": "あれ。波が"}, {"type": "subtitle", "time": 5229.07, "timestamp": "01:27:09", "text": "[音楽]"}, {"type": "subtitle", "time": 5232.79, "timestamp": "01:27:12", "text": "来る。奇抜だ。うん、奇抜だね。ありがとう。"}, {"type": "subtitle", "time": 5234.87, "timestamp": "01:27:14", "text": "ええ、私もそう思っていました。そうじゃない"}, {"type": "subtitle", "time": 5236.59, "timestamp": "01:27:16", "text": "手に入れた方が良い"}, {"type": "subtitle", "time": 5242.07, "timestamp": "01:27:22", "text": "ザニPBiと、えーと、ショーキーパー？"}, {"type": "subtitle", "time": 5245.669, "timestamp": "01:27:25", "text": "それは、3太陽エネルギーに相当します。えっと"}, {"type": "subtitle", "time": 5247.629, "timestamp": "01:27:27", "text": "忘れた。えっと"}, {"type": "subtitle", "time": 5250.43, "timestamp": "01:27:30", "text": "スペクター。それは何と呼ばれているのですか？"}, {"type": "subtitle", "time": 5253.229, "timestamp": "01:27:33", "text": "また？何か"}, {"type": "subtitle", "time": 5257.31, "timestamp": "01:27:37", "text": "何か。ああ、時間がかかりすぎる"}, {"type": "subtitle", "time": 5260.47, "timestamp": "01:27:40", "text": "負荷。私は地獄をダウンロードすらしていません"}, {"type": "subtitle", "time": 5262.47, "timestamp": "01:27:42", "text": "ダイバー。明日、コラボ企画があります。私"}, {"type": "subtitle", "time": 5272.43, "timestamp": "01:27:52", "text": "Arcで開くべきだと思う、"}, {"type": "subtitle", "time": 5274.91, "timestamp": "01:27:54", "text": "男。取"}]
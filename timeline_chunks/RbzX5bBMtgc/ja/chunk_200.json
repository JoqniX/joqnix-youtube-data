[{"type": "subtitle", "time": 12002.71, "timestamp": "03:20:02", "text": "私たちは最高の気分です。それは"}, {"type": "subtitle", "time": 12005.75, "timestamp": "03:20:05", "text": "ジェン・ジョアン・ロン。"}, {"type": "subtitle", "time": 12008.71, "timestamp": "03:20:08", "text": "あなたの服装は地元の人らしくないですね。あなたは"}, {"type": "subtitle", "time": 12011.75, "timestamp": "03:20:11", "text": "放浪の旅人？旅好きですか？"}, {"type": "subtitle", "time": 12015.59, "timestamp": "03:20:15", "text": "誰かが家に帰る。"}, {"type": "subtitle", "time": 12018.65, "timestamp": "03:20:18", "text": "ええと、覚えていません。"}, {"type": "subtitle", "time": 12022.15, "timestamp": "03:20:22", "text": "[音楽]"}, {"type": "subtitle", "time": 12025.67, "timestamp": "03:20:25", "text": "だから、なぜ自分がここにいるのか分からない、"}, {"type": "subtitle", "time": 12030.59, "timestamp": "03:20:30", "text": "あなたはどこ出身ですか、それともあなたが誰ですか？"}, {"type": "subtitle", "time": 12033.75, "timestamp": "03:20:33", "text": "うん。だから、"}, {"type": "subtitle", "time": 12037.229, "timestamp": "03:20:37", "text": "目覚めた後のこれらの後遺症"}, {"type": "subtitle", "time": 12041.27, "timestamp": "03:20:41", "text": "上。ふむ。"}, {"type": "subtitle", "time": 12043.429, "timestamp": "03:20:43", "text": "[音楽]"}, {"type": "subtitle", "time": 12046.07, "timestamp": "03:20:46", "text": "風が警告をもたらした。の"}, {"type": "subtitle", "time": 12048.87, "timestamp": "03:20:48", "text": "電気の海が収束している。新しい"}, {"type": "subtitle", "time": 12050.71, "timestamp": "03:20:50", "text": "酸性土壌が形成されつつある。とは"}, {"type": "subtitle", "time": 12054.309, "timestamp": "03:20:54", "text": "酸性のフィールド？また、これは私の初見プレイです"}, {"type": "subtitle", "time": 12056.229, "timestamp": "03:20:56", "text": "を通して。ちなみに、私は一度も見たことがありませんでした"}, {"type": "subtitle", "time": 12057.07, "timestamp": "03:20:57", "text": "どれでも"}, {"type": "subtitle", "time": 12059.83, "timestamp": "03:20:59", "text": "動画。そうそう、言い忘れてたんだけど"}]
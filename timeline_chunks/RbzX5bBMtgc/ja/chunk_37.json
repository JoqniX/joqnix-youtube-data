[{"type": "subtitle", "time": 2220.31, "timestamp": "00:37:00", "text": "何かお手伝いできることはありますか？"}, {"type": "subtitle", "time": 2222.069, "timestamp": "00:37:02", "text": "彼女は可愛い。彼女は私の新しい"}, {"type": "subtitle", "time": 2229.109, "timestamp": "00:37:09", "text": "なぜ彼女は私の新しいモデルに似ているのだろう？"}, {"type": "subtitle", "time": 2230.95, "timestamp": "00:37:10", "text": "あなたの到着をささやき伝えました。ほとんど"}, {"type": "subtitle", "time": 2232.99, "timestamp": "00:37:12", "text": "私の近くに"}, {"type": "subtitle", "time": 2235.51, "timestamp": "00:37:15", "text": "モデル。私はできた 私はできた"}, {"type": "subtitle", "time": 2239.72, "timestamp": "00:37:19", "text": "実際に彼女を捕まえた。"}, {"type": "subtitle", "time": 2253.109, "timestamp": "00:37:33", "text": "わからない。楽しいゲームのように"}, {"type": "subtitle", "time": 2256.39, "timestamp": "00:37:36", "text": "今日は良い天気になりそうです。今日は"}, {"type": "subtitle", "time": 2261.47, "timestamp": "00:37:41", "text": "いい天気だ。私は"}, {"type": "subtitle", "time": 2268.95, "timestamp": "00:37:48", "text": "もの。新しいマップか何かだと思う"}, {"type": "subtitle", "time": 2270.9, "timestamp": "00:37:50", "text": "うまくいった。"}, {"type": "subtitle", "time": 2272.27, "timestamp": "00:37:52", "text": "[音楽]"}, {"type": "subtitle", "time": 2275.43, "timestamp": "00:37:55", "text": "待って、新しい地図はどこ？の"}]
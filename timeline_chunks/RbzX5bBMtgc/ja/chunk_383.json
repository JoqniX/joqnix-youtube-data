[{"type": "subtitle", "time": 22987.43, "timestamp": "06:23:07", "text": "目を離さないでください。私はこう思う"}, {"type": "subtitle", "time": 22996.788, "timestamp": "06:23:16", "text": "クエスト。最後までやり遂げる必要があると思う"}, {"type": "subtitle", "time": 23021.27, "timestamp": "06:23:41", "text": "あ、待って。瞬時に合成できます"}, {"type": "subtitle", "time": 23026.15, "timestamp": "06:23:46", "text": "ここに来る代わりに、他のことをする。何てことだ。"}, {"type": "subtitle", "time": 23029.28, "timestamp": "06:23:49", "text": "待って、それはとても簡単だ"}]
[{"type": "subtitle", "time": 13260.71, "timestamp": "03:41:00", "text": "家。火。"}, {"type": "subtitle", "time": 13269.269, "timestamp": "03:41:09", "text": "私たちは、あの未完成のゲーム以上のことを知っている。"}, {"type": "subtitle", "time": 13271.87, "timestamp": "03:41:11", "text": "私たちは"}, {"type": "subtitle", "time": 13275.19, "timestamp": "03:41:15", "text": "価格。あなたは、"}, {"type": "subtitle", "time": 13280.15, "timestamp": "03:41:20", "text": "あなたのロープ。何？あなたの無意識の足跡"}, {"type": "subtitle", "time": 13308.55, "timestamp": "03:41:48", "text": "共に打ち勝つ。縮小する"}, {"type": "subtitle", "time": 13318.15, "timestamp": "03:41:58", "text": "くそ。早くやってください。彼女は強すぎる。"}]
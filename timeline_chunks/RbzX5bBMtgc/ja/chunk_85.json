[{"type": "subtitle", "time": 5103.189, "timestamp": "01:25:03", "text": "などなど、彼女は風のような"}, {"type": "subtitle", "time": 5105.07, "timestamp": "01:25:05", "text": "風"}, {"type": "subtitle", "time": 5108.22, "timestamp": "01:25:08", "text": "要素と"}, {"type": "subtitle", "time": 5110.59, "timestamp": "01:25:10", "text": "[音楽]"}, {"type": "subtitle", "time": 5112.95, "timestamp": "01:25:12", "text": "すべてをもう一度。全部プレイさせてください"}, {"type": "subtitle", "time": 5124.95, "timestamp": "01:25:24", "text": "戦術的に言えば、私は"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "フィオリ。クリア。"}, {"type": "subtitle", "time": 5129.55, "timestamp": "01:25:29", "text": "どこ"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "彼女？今日はいい日になりそうだね？レベルアップしたら"}, {"type": "subtitle", "time": 5136.99, "timestamp": "01:25:36", "text": "彼女を"}, {"type": "subtitle", "time": 5141.59, "timestamp": "01:25:41", "text": "コアは、彼女に私の現在の姿を見てもらいたいと思っています"}, {"type": "subtitle", "time": 5147.39, "timestamp": "01:25:47", "text": "今のチームはメインチームです"}, {"type": "subtitle", "time": 5151.11, "timestamp": "01:25:51", "text": "カラとショーのキーパーは正しいです。私はここにいます"}, {"type": "subtitle", "time": 5153.03, "timestamp": "01:25:53", "text": "あなたの意志に従え。私には2つ目の時間がない"}, {"type": "subtitle", "time": 5155.27, "timestamp": "01:25:55", "text": "まだチームに所属していません。"}, {"type": "subtitle", "time": 5159.83, "timestamp": "01:25:59", "text": "セカンドチームは、ただ使っているだけです"}]
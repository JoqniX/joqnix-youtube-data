[{"type": "subtitle", "time": 840.87, "timestamp": "00:14:00", "text": "[音楽]"}, {"type": "subtitle", "time": 843.73, "timestamp": "00:14:03", "text": "私は終わった。"}, {"type": "subtitle", "time": 864.069, "timestamp": "00:14:24", "text": "[音楽]"}, {"type": "subtitle", "time": 866.62, "timestamp": "00:14:26", "text": "時間がかかっています。かなり"}, {"type": "subtitle", "time": 875.31, "timestamp": "00:14:35", "text": "その間。コンパイル"}, {"type": "subtitle", "time": 878.389, "timestamp": "00:14:38", "text": "ここ。私の音楽が扱えるのはそれだけです"}, {"type": "subtitle", "time": 883.66, "timestamp": "00:14:43", "text": "私にはそれがわかる。"}, {"type": "subtitle", "time": 891.31, "timestamp": "00:14:51", "text": "[音楽]"}]
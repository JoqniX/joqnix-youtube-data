[{"type": "subtitle", "time": 4263.709, "timestamp": "01:11:03", "text": "彼女はなぜそんなに"}, {"type": "subtitle", "time": 4266.709, "timestamp": "01:11:06", "text": "かわいい？待って、なんで彼女はこんなにクールなの？のように"}, {"type": "subtitle", "time": 4280.07, "timestamp": "01:11:20", "text": "敵？なかなかいい感じだ。私はただ"}, {"type": "subtitle", "time": 4283.35, "timestamp": "01:11:23", "text": "彼女は私の大好きなバンドの音楽デュオだから"}, {"type": "subtitle", "time": 4286.07, "timestamp": "01:11:26", "text": "MTL CityはWithering Wavesの音楽を制作した。"}, {"type": "subtitle", "time": 4290.47, "timestamp": "01:11:30", "text": "そして彼らはFobiのオリジナルサウンドトラックを作った。それで"}, {"type": "subtitle", "time": 4293.189, "timestamp": "01:11:33", "text": "だから私はこう思う、私は手に入れなければならない、私は手に入れる"}, {"type": "subtitle", "time": 4308.63, "timestamp": "01:11:48", "text": "それ。それは素晴らしいですね。実際に"}, {"type": "subtitle", "time": 4310.27, "timestamp": "01:11:50", "text": "得る"}, {"type": "subtitle", "time": 4314.07, "timestamp": "01:11:54", "text": "彼女。もしかしたら、本当に彼女をゲットできるかもしれない。私はしません"}, {"type": "subtitle", "time": 4319.189, "timestamp": "01:11:59", "text": "知る。でも待って、確認したい。"}]
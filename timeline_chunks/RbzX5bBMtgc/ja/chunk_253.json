[{"type": "subtitle", "time": 15181.51, "timestamp": "04:13:01", "text": "初めてです。私はそれについて話しました"}, {"type": "subtitle", "time": 15188.55, "timestamp": "04:13:08", "text": "私がもう耐えられなくなる日まで"}, {"type": "subtitle", "time": 15191.67, "timestamp": "04:13:11", "text": "ペン。私はすでに彼らと話しました"}, {"type": "subtitle", "time": 15195.71, "timestamp": "04:13:15", "text": "出版社で。私の最終的な"}, {"type": "subtitle", "time": 15197.71, "timestamp": "04:13:17", "text": "出発は"}, {"type": "chat", "time": 15198.545, "timestamp": "04:13:18", "author": "@Her_escapes", "avatar": "https://yt4.ggpht.com/k5qSeiW9HuWS-yTlvFtkJFgjFQNzT4clVmOKs1PPP76ezfBidoUedboWgIi3wJy0ffSGpxX2Gy8=s64-c-k-c0x00ffffff-no-rj", "message": "T_T"}, {"type": "subtitle", "time": 15201.93, "timestamp": "04:13:21", "text": "避けられないことだが、私はそれを与えたい。"}, {"type": "subtitle", "time": 15205.99, "timestamp": "04:13:25", "text": "[音楽]"}, {"type": "subtitle", "time": 15207.71, "timestamp": "04:13:27", "text": "すでに見てきたことは知っています"}, {"type": "subtitle", "time": 15211.83, "timestamp": "04:13:31", "text": "死、しかし覚えておいて"}, {"type": "subtitle", "time": 15214.63, "timestamp": "04:13:34", "text": "人々はあなたのことを気にかけています。はい、私は"}, {"type": "subtitle", "time": 15216.55, "timestamp": "04:13:36", "text": "理解する。"}, {"type": "subtitle", "time": 15219.149, "timestamp": "04:13:39", "text": "時々私は"}, {"type": "subtitle", "time": 15222.429, "timestamp": "04:13:42", "text": "もう少し一緒にいられたらいいのに"}, {"type": "subtitle", "time": 15227.269, "timestamp": "04:13:47", "text": "もう少し長く、たとえほんの少しの間でも。"}, {"type": "subtitle", "time": 15231.03, "timestamp": "04:13:51", "text": "もちろん、フー、まだその時ではない。私は"}, {"type": "subtitle", "time": 15233.269, "timestamp": "04:13:53", "text": "著名な医師のリストをまとめた"}, {"type": "subtitle", "time": 15235.91, "timestamp": "04:13:55", "text": "ホン・ラン。彼らは非常に熟練しており、"}, {"type": "subtitle", "time": 15239.99, "timestamp": "04:13:59", "text": "[ __ ]・リー夫人に。必要なし。もしあなたが"}]
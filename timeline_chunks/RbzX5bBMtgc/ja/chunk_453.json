[{"type": "subtitle", "time": 27185.03, "timestamp": "07:33:05", "text": "63%で、継続するためには"}, {"type": "subtitle", "time": 27188.23, "timestamp": "07:33:08", "text": "引き続きこれを入手してください。私は"}, {"type": "subtitle", "time": 27192.548, "timestamp": "07:33:12", "text": "AI部分とチャン部分が必要です"}, {"type": "subtitle", "time": 27195.75, "timestamp": "07:33:15", "text": "これに関しては、あなただけが"}, {"type": "subtitle", "time": 27197.99, "timestamp": "07:33:17", "text": "これは毎日のログインか何かから得た情報です"}, {"type": "subtitle", "time": 27201.468, "timestamp": "07:33:21", "text": "明らかに悲しそうだった。"}, {"type": "subtitle", "time": 27205.35, "timestamp": "07:33:25", "text": "おい、ちょっと待つ必要があるかもしれない。私 私"}, {"type": "subtitle", "time": 27208.788, "timestamp": "07:33:28", "text": "もう少し待つ必要があるかもしれない"}, {"type": "subtitle", "time": 27210.51, "timestamp": "07:33:30", "text": "できる"}, {"type": "subtitle", "time": 27213.388, "timestamp": "07:33:33", "text": "それを手に入れるために。私"}, {"type": "subtitle", "time": 27216.388, "timestamp": "07:33:36", "text": "知らないと思う。ちょうど終わったところです"}, {"type": "subtitle", "time": 27220.388, "timestamp": "07:33:40", "text": "ここ。 1つで考えると、"}, {"type": "subtitle", "time": 27222.788, "timestamp": "07:33:42", "text": "薬ならここで手に入るよ。そして私はみんな"}, {"type": "subtitle", "time": 27224.628, "timestamp": "07:33:44", "text": "私がやらなければならないことは、このデータを処理するだけです"}, {"type": "subtitle", "time": 27228.07, "timestamp": "07:33:48", "text": "回復してこの修復に供給する"}, {"type": "subtitle", "time": 27232.07, "timestamp": "07:33:52", "text": "これを解除して、キャスパーのキャップを被せよう"}, {"type": "subtitle", "time": 27234.07, "timestamp": "07:33:54", "text": "モジュールを実行し、キャプチャモジュールを完了します。"}, {"type": "subtitle", "time": 27234.99, "timestamp": "07:33:54", "text": "それは"}, {"type": "subtitle", "time": 27237.75, "timestamp": "07:33:57", "text": "それ。うん。うん。そしてカプセルを完成させる"}]
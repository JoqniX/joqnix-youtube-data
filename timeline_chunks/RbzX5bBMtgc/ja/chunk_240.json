[{"type": "subtitle", "time": 14400.309, "timestamp": "04:00:00", "text": "私を助けてくれる師匠。できますか？したい"}, {"type": "subtitle", "time": 14403.429, "timestamp": "04:00:03", "text": "ライブ。自分の力を制御することを学び、"}, {"type": "subtitle", "time": 14404.67, "timestamp": "04:00:04", "text": "なる"}, {"type": "subtitle", "time": 14407.67, "timestamp": "04:00:07", "text": "より強く、平和と平和を見ることはできない"}, {"type": "subtitle", "time": 14409.99, "timestamp": "04:00:09", "text": "繁栄した世界。"}, {"type": "subtitle", "time": 14414.71, "timestamp": "04:00:14", "text": "平和と平和を定義するものは何か知っていますか？"}, {"type": "subtitle", "time": 14421.72, "timestamp": "04:00:21", "text": "私は思う"}, {"type": "subtitle", "time": 14427.389, "timestamp": "04:00:27", "text": "[音楽]"}, {"type": "subtitle", "time": 14431.11, "timestamp": "04:00:31", "text": "バン！刃が！"}, {"type": "subtitle", "time": 14435.469, "timestamp": "04:00:35", "text": "なんと強大な力だろう。使用しない場合"}, {"type": "subtitle", "time": 14438.95, "timestamp": "04:00:38", "text": "賢明に、私はあなたに制御する方法を教えることができます"}, {"type": "subtitle", "time": 14442.309, "timestamp": "04:00:42", "text": "あなたの力。しかし、この浮き沈みの世界では"}, {"type": "subtitle", "time": 14445.11, "timestamp": "04:00:45", "text": "ダウン、力任せに頼る"}, {"type": "subtitle", "time": 14452.229, "timestamp": "04:00:52", "text": "平和で"}, {"type": "subtitle", "time": 14454.95, "timestamp": "04:00:54", "text": "繁栄した世界では、"}, {"type": "subtitle", "time": 14458.309, "timestamp": "04:00:58", "text": "自分の知性で選択する。やって来る、"}]
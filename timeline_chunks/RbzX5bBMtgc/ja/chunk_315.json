[{"type": "subtitle", "time": 18902.43, "timestamp": "05:15:02", "text": "日本は速いか、"}, {"type": "subtitle", "time": 18905.35, "timestamp": "05:15:05", "text": "悪い？はぁ？"}, {"type": "subtitle", "time": 18907.07, "timestamp": "05:15:07", "text": "日本のスピードはご存知でしょう"}, {"type": "subtitle", "time": 18910.51, "timestamp": "05:15:10", "text": "速さで世界記録を達成するスピード"}, {"type": "subtitle", "time": 18913.23, "timestamp": "05:15:13", "text": "合格。はぁ？どういう意味ですか"}, {"type": "subtitle", "time": 18917.03, "timestamp": "05:15:17", "text": "それ？ 1台あたり4.02テラバイト"}, {"type": "subtitle", "time": 18921.23, "timestamp": "05:15:21", "text": "インドとは異なり、2番目のインターネット速度"}, {"type": "subtitle", "time": 18924.59, "timestamp": "05:15:24", "text": "ミラーテレビ"}, {"type": "subtitle", "time": 18931.23, "timestamp": "05:15:31", "text": "[音楽]"}]
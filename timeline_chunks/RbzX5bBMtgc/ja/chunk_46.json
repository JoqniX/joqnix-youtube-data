[{"type": "subtitle", "time": 2764.15, "timestamp": "00:46:04", "text": "緊急事態が発生しました。入手できますか？"}, {"type": "subtitle", "time": 2766.069, "timestamp": "00:46:06", "text": "すぐにオフィスへ？知ってる？"}, {"type": "subtitle", "time": 2769.589, "timestamp": "00:46:09", "text": "時間はどうですか？あなたがいなければ、私たちはそれを成し遂げることはできません。"}, {"type": "subtitle", "time": 2770.75, "timestamp": "00:46:10", "text": "全て"}, {"type": "subtitle", "time": 2773.109, "timestamp": "00:46:13", "text": "右。彼女は魅力的な人物だ。私はしません"}, {"type": "subtitle", "time": 2774.55, "timestamp": "00:46:14", "text": "彼女を応援すべきかどうか知りたい。私はしません"}, {"type": "subtitle", "time": 2776.71, "timestamp": "00:46:16", "text": "十分なお金を持っている。"}, {"type": "subtitle", "time": 2792.309, "timestamp": "00:46:32", "text": "[音楽]"}]
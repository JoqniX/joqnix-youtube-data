[{"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "おお、いいね。彼は戦い方を覚えているだろう"}, {"type": "subtitle", "time": 12317.11, "timestamp": "03:25:17", "text": "すべてを忘れてしまったにもかかわらず。"}, {"type": "subtitle", "time": 12320.87, "timestamp": "03:25:20", "text": "おお。次回は私が先頭に立って先陣を切るのを見ていてください。"}, {"type": "subtitle", "time": 12323.19, "timestamp": "03:25:23", "text": "あれはウサギです。私はウサギを殺した。私"}, {"type": "subtitle", "time": 12326.55, "timestamp": "03:25:26", "text": "つまり、チシャ、"}, {"type": "subtitle", "time": 12330.429, "timestamp": "03:25:30", "text": "これは楽しい。サンディ"}]
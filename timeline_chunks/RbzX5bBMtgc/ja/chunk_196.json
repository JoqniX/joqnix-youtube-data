[{"type": "subtitle", "time": 11777.19, "timestamp": "03:16:17", "text": "みんな。こんにちは。女性を選びます"}, {"type": "subtitle", "time": 11780.95, "timestamp": "03:16:20", "text": "キャラクター。わかった。私はEpicを使っています。私は"}, {"type": "subtitle", "time": 11784.429, "timestamp": "03:16:24", "text": "夕食から戻った。わかった。ああ、"}, {"type": "subtitle", "time": 11785.85, "timestamp": "03:16:25", "text": "神。"}, {"type": "subtitle", "time": 11806.349, "timestamp": "03:16:46", "text": "それ。さあ行こう。さあ行こう。さあ"}, {"type": "subtitle", "time": 11809.91, "timestamp": "03:16:49", "text": "行く。誇大広告。誇大広告。誇大宣伝、誇大宣伝、誇大宣伝、誇大宣伝、"}]
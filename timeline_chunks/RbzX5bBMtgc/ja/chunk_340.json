[{"type": "subtitle", "time": 20401.98, "timestamp": "05:40:01", "text": "1"}, {"type": "subtitle", "time": 20410.39, "timestamp": "05:40:10", "text": "観客。腹ペコだよ。私"}, {"type": "subtitle", "time": 20434.23, "timestamp": "05:40:34", "text": "急ぐ必要はありません。せっかちな者は倒れるだろう"}, {"type": "subtitle", "time": 20437.27, "timestamp": "05:40:37", "text": "まさに私たちの膝の上に。"}]
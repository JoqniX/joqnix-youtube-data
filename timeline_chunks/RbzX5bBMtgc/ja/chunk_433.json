[{"type": "subtitle", "time": 25988.548, "timestamp": "07:13:08", "text": "出発前に、ちょっと農業をしたいな"}, {"type": "subtitle", "time": 25991.19, "timestamp": "07:13:11", "text": "いくつか。そうすべきだった"}, {"type": "subtitle", "time": 25994.91, "timestamp": "07:13:14", "text": "初期の頃。"}, {"type": "subtitle", "time": 25997.51, "timestamp": "07:13:17", "text": "ああ、でも大丈夫だよ。そうすべきだった"}, {"type": "subtitle", "time": 26031.19, "timestamp": "07:13:51", "text": "私の昇天準備資料はどんな感じですか？"}, {"type": "subtitle", "time": 26032.468, "timestamp": "07:13:52", "text": "[音楽]"}, {"type": "subtitle", "time": 26037.61, "timestamp": "07:13:57", "text": "轟音の響く砂漠の片隅が必要だ。"}, {"type": "subtitle", "time": 26039.83, "timestamp": "07:13:59", "text": "[音楽]"}]
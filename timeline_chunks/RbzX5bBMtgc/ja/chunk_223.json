[{"type": "subtitle", "time": 13401.189, "timestamp": "03:43:21", "text": "私は大丈夫です。それは私の得意分野です。私は慣れています"}, {"type": "subtitle", "time": 13403.87, "timestamp": "03:43:23", "text": "それ。"}, {"type": "subtitle", "time": 13406.79, "timestamp": "03:43:26", "text": "私に近づかないで、さもないと"}, {"type": "subtitle", "time": 13413.189, "timestamp": "03:43:33", "text": "[音楽]"}, {"type": "subtitle", "time": 13415.349, "timestamp": "03:43:35", "text": "この村はタキトディスに襲撃された。"}, {"type": "subtitle", "time": 13416.67, "timestamp": "03:43:36", "text": "なぜ来たのですか？"}, {"type": "subtitle", "time": 13419.349, "timestamp": "03:43:39", "text": "ここ？亡命者以外には誰も望んでいない"}, {"type": "subtitle", "time": 13424.07, "timestamp": "03:43:44", "text": "今はここに留まる。あなたはここにいるべきではない。"}, {"type": "subtitle", "time": 13426.87, "timestamp": "03:43:46", "text": "あなたは悪い人ですか？"}, {"type": "subtitle", "time": 13430.429, "timestamp": "03:43:50", "text": "それがあなたが探しているものです"}, {"type": "subtitle", "time": 13433.99, "timestamp": "03:43:53", "text": "のために。私がここにいるときは誰も恐れない"}, {"type": "subtitle", "time": 13437.03, "timestamp": "03:43:57", "text": "自分。とにかく、急いで"}, {"type": "subtitle", "time": 13438.83, "timestamp": "03:43:58", "text": "離れる。そうではありません"}]
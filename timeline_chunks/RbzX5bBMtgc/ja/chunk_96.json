[{"type": "subtitle", "time": 5765.75, "timestamp": "01:36:05", "text": "男。私は最大レベルですか？私は思う"}, {"type": "subtitle", "time": 5776.189, "timestamp": "01:36:16", "text": "すべて。うん、それをやらなきゃいけないんだ"}, {"type": "subtitle", "time": 5780.11, "timestamp": "01:36:20", "text": "彼女。ええ、彼女だけです"}, {"type": "subtitle", "time": 5782.59, "timestamp": "01:36:22", "text": "左。これ"}, {"type": "subtitle", "time": 5796.95, "timestamp": "01:36:36", "text": "今？彼女を最大限まで追い込むことができる。実際、私は"}, {"type": "subtitle", "time": 5799.95, "timestamp": "01:36:39", "text": "実際にやってみます"}, {"type": "subtitle", "time": 5809.31, "timestamp": "01:36:49", "text": "それ。戦う時が来た"}]
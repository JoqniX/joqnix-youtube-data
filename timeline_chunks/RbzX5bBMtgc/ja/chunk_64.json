[{"type": "subtitle", "time": 3841.75, "timestamp": "01:04:01", "text": "魔法使いのかわいいものなどはなし。えっと、ああ"}, {"type": "subtitle", "time": 3845.029, "timestamp": "01:04:05", "text": "ええ、カメレイアの50/50で負けました"}, {"type": "subtitle", "time": 3847.43, "timestamp": "01:04:07", "text": "実は。ああ、覚えてるよ。その代わり"}, {"type": "subtitle", "time": 3851.27, "timestamp": "01:04:11", "text": "チャメリアの、私は彼女を手に入れた。この女性。する"}, {"type": "subtitle", "time": 3855.15, "timestamp": "01:04:15", "text": "私の最高、少林寺"}, {"type": "subtitle", "time": 3857.789, "timestamp": "01:04:17", "text": "レディ。そして私は"}, {"type": "subtitle", "time": 3862.19, "timestamp": "01:04:22", "text": "残りのことは彼女を"}, {"type": "subtitle", "time": 3865.75, "timestamp": "01:04:25", "text": "店舗から店舗へ。いいえ、新しい"}, {"type": "subtitle", "time": 3867.43, "timestamp": "01:04:27", "text": "キャラクター。当時彼らは"}, {"type": "subtitle", "time": 3870.549, "timestamp": "01:04:30", "text": "彼女を"}, {"type": "subtitle", "time": 3873.43, "timestamp": "01:04:33", "text": "限定料金か何かでこちらで購入できます。それで"}, {"type": "subtitle", "time": 3897.23, "timestamp": "01:04:57", "text": "なぜ彼女は可愛いのですか？引っ張るべきでしょうか？私は"}]
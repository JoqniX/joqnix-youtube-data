[{"type": "subtitle", "time": 27062.548, "timestamp": "07:31:02", "text": "ここ？上に表示されるかどうかはわかりません"}, {"type": "subtitle", "time": 27063.708, "timestamp": "07:31:03", "text": "ここ。私はしません"}, {"type": "subtitle", "time": 27067.91, "timestamp": "07:31:07", "text": "知る。待って、表示されるの？"}, {"type": "subtitle", "time": 27070.868, "timestamp": "07:31:10", "text": "えっと、チップスペースのイベントのことですか？いいえ、そうです"}, {"type": "subtitle", "time": 27073.91, "timestamp": "07:31:13", "text": "ない。 H でも、そうですね、"}, {"type": "subtitle", "time": 27077.03, "timestamp": "07:31:17", "text": "チップ宇宙イベント。そして、"}, {"type": "subtitle", "time": 27079.91, "timestamp": "07:31:19", "text": "これは待って、これは待って、どれ"}, {"type": "subtitle", "time": 27082.388, "timestamp": "07:31:22", "text": "またか？うん。だから"}, {"type": "subtitle", "time": 27085.11, "timestamp": "07:31:25", "text": "ロック解除チップ チップ スペース イベント、私たちは必要としています"}, {"type": "subtitle", "time": 27089.67, "timestamp": "07:31:29", "text": "キャプテンレベル50に到達。そう、メイン"}, {"type": "subtitle", "time": 27092.388, "timestamp": "07:31:32", "text": "目標は、これは私が"}, {"type": "subtitle", "time": 27096.27, "timestamp": "07:31:36", "text": "正しい方ですか？ああ、彼女を降ろさなきゃ"}, {"type": "subtitle", "time": 27099.11, "timestamp": "07:31:39", "text": "その出来事から雷鳴が轟いた。だから私たちは"}, {"type": "subtitle", "time": 27100.868, "timestamp": "07:31:40", "text": "ストーリーをスピードランしていて、"}, {"type": "subtitle", "time": 27104.468, "timestamp": "07:31:44", "text": "1月12日以前のすべて。だから私は"}, {"type": "subtitle", "time": 27106.07, "timestamp": "07:31:46", "text": "ホンカイの配信をたくさんやっていて"}, {"type": "subtitle", "time": 27108.15, "timestamp": "07:31:48", "text": "スピードランでクリアする。最善を尽くして"}, {"type": "subtitle", "time": 27111.59, "timestamp": "07:31:51", "text": "それ。うん。うん。これまでのところ、私たちは"}, {"type": "subtitle", "time": 27114.788, "timestamp": "07:31:54", "text": "えっと、可能であれば、わからない"}, {"type": "subtitle", "time": 27117.51, "timestamp": "07:31:57", "text": "もし可能であれば、本当にそうしたいのですが"}]
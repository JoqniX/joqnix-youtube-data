[{"type": "subtitle", "time": 17282.03, "timestamp": "04:48:02", "text": "私は手に入れた"}, {"type": "subtitle", "time": 17285.23, "timestamp": "04:48:05", "text": "それ。それは左へ飛んでいった"}, {"type": "subtitle", "time": 17287.708, "timestamp": "04:48:07", "text": "側。兄弟、私は"}, {"type": "subtitle", "time": 17289.948, "timestamp": "04:48:09", "text": "パニック状態。文字通り"}, {"type": "subtitle", "time": 17292.91, "timestamp": "04:48:12", "text": "パニック状態。私は文字通り"}, {"type": "subtitle", "time": 17296.91, "timestamp": "04:48:16", "text": "まるで人生が終わるかのようにパニックになるか、"}, {"type": "subtitle", "time": 17301.62, "timestamp": "04:48:21", "text": "私"}, {"type": "subtitle", "time": 17328.19, "timestamp": "04:48:48", "text": "[音楽]"}, {"type": "subtitle", "time": 17329.43, "timestamp": "04:48:49", "text": "平均、"}]
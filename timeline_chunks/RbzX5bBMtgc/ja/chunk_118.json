[{"type": "subtitle", "time": 7080.51, "timestamp": "01:58:00", "text": "見ている"}, {"type": "subtitle", "time": 7083.99, "timestamp": "01:58:03", "text": "物"}, {"type": "subtitle", "time": 7088.79, "timestamp": "01:58:08", "text": "ターゲット。戦争という名の犬どもを分断しよう。"}, {"type": "subtitle", "time": 7099.31, "timestamp": "01:58:19", "text": "任せてください"}, {"type": "subtitle", "time": 7117.91, "timestamp": "01:58:37", "text": "我々が見つけた戦利品は、私の報酬には含まれません。"}, {"type": "subtitle", "time": 7136.83, "timestamp": "01:58:56", "text": "私たちはどのようなクエストを正しく行っているのか"}, {"type": "subtitle", "time": 7139.99, "timestamp": "01:58:59", "text": "今？再生時間はどれくらいですか？わからない。"}]
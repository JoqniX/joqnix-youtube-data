[{"type": "subtitle", "time": 12243.229, "timestamp": "03:24:03", "text": "盛り上がっている。ああ、"}, {"type": "subtitle", "time": 12246.19, "timestamp": "03:24:06", "text": "ああ、戦闘システムを見てください。おお、"}, {"type": "subtitle", "time": 12254.469, "timestamp": "03:24:14", "text": "いいね。携帯電話の電源を入れようとしたのですが"}, {"type": "subtitle", "time": 12264.79, "timestamp": "03:24:24", "text": "種がたくさん。すべては良いことのように見えるかもしれないし、"}, {"type": "subtitle", "time": 12267.349, "timestamp": "03:24:27", "text": "今はここは静かだけど、いつ何が起こるかわからない"}, {"type": "subtitle", "time": 12269.83, "timestamp": "03:24:29", "text": "酸っぱい不和が突然現れるかもしれない"}, {"type": "subtitle", "time": 12289.429, "timestamp": "03:24:49", "text": "ああ、これは楽しい。ああ、これは楽しい。"}, {"type": "subtitle", "time": 12291.349, "timestamp": "03:24:51", "text": "ノートパソコンで入手するにはどうすればいいですか？えっと、ただ"}, {"type": "subtitle", "time": 12293.349, "timestamp": "03:24:53", "text": "公式ランチャーまたはEpicをダウンロードしてください"}]
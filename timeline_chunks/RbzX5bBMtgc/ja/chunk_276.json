[{"type": "subtitle", "time": 16571.91, "timestamp": "04:36:11", "text": "[音楽]"}, {"type": "subtitle", "time": 16573.15, "timestamp": "04:36:13", "text": "どこ"}, {"type": "subtitle", "time": 16576.269, "timestamp": "04:36:16", "text": "それ？どうやって、どこで"}, {"type": "subtitle", "time": 16580.551, "timestamp": "04:36:20", "text": "行く？なあ、どうだったんだ？"}, {"type": "subtitle", "time": 16588.189, "timestamp": "04:36:28", "text": "ない"}, {"type": "subtitle", "time": 16591.67, "timestamp": "04:36:31", "text": "ここ。覚えているのは、ただそれを削除したということだけです。"}, {"type": "subtitle", "time": 16593.23, "timestamp": "04:36:33", "text": "私の"}, {"type": "subtitle", "time": 16596.91, "timestamp": "04:36:36", "text": "耳。どうしてただ飛ぶことができるのか"}, {"type": "subtitle", "time": 16604.91, "timestamp": "04:36:44", "text": "はぁ？落ち着いて、私の"}, {"type": "subtitle", "time": 16609.26, "timestamp": "04:36:49", "text": "くそっ。ゆっくり見てください。"}]
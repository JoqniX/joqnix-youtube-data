[{"type": "subtitle", "time": 4023.109, "timestamp": "01:07:03", "text": "インランドと、もう一人の、えーと、ピアノを弾く女性。"}, {"type": "subtitle", "time": 4028.63, "timestamp": "01:07:08", "text": "えっと、彼女の名前を忘れちゃった。ああ、それとフォビもね。"}, {"type": "subtitle", "time": 4031.39, "timestamp": "01:07:11", "text": "私は彼らを育てなければならない"}, {"type": "subtitle", "time": 4033.47, "timestamp": "01:07:13", "text": "今。ああ、"}, {"type": "subtitle", "time": 4037.109, "timestamp": "01:07:17", "text": "ああ、奇抜だ。彼女はどれくらい優秀なのですか？私は決して"}, {"type": "subtitle", "time": 4047.63, "timestamp": "01:07:27", "text": "うん、カロYを手に入れたよ。うん。うん、手に入れたよ"}, {"type": "subtitle", "time": 4052.51, "timestamp": "01:07:32", "text": "彼女。ヤン。うん。うん。うん。手に入れました"}, {"type": "subtitle", "time": 4056.589, "timestamp": "01:07:36", "text": "両方。それは本当に素晴らしいですね。私"}, {"type": "subtitle", "time": 4059.029, "timestamp": "01:07:39", "text": "見る。次はどれか知っていますか？"}, {"type": "subtitle", "time": 4063.47, "timestamp": "01:07:43", "text": "キャラクターが登場しますか？進むべき道がはっきりと見えた。"}]
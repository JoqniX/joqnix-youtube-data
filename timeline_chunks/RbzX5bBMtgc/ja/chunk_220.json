[{"type": "subtitle", "time": 13224.59, "timestamp": "03:40:24", "text": "ああ、彼女の目が変わった"}, {"type": "subtitle", "time": 13227.46, "timestamp": "03:40:27", "text": "光るものに変わる。"}, {"type": "subtitle", "time": 13238.469, "timestamp": "03:40:38", "text": "おお。何てことだ。"}, {"type": "subtitle", "time": 13240.79, "timestamp": "03:40:40", "text": "ここまで来て、私たちについてきてくれた"}, {"type": "subtitle", "time": 13243.51, "timestamp": "03:40:43", "text": "ここ。常に"}, {"type": "subtitle", "time": 13251.59, "timestamp": "03:40:51", "text": "私たちの和やかな会話はこれで終わりです。そろそろ"}]
[{"type": "subtitle", "time": 12480.389, "timestamp": "03:28:00", "text": "面談中のチャンス"}, {"type": "subtitle", "time": 12483.03, "timestamp": "03:28:03", "text": "式典 任命式 あなたの"}, {"type": "subtitle", "time": 12486.389, "timestamp": "03:28:06", "text": "説明 あなたはかなり近くに立っていた だけ"}, {"type": "subtitle", "time": 12488.71, "timestamp": "03:28:08", "text": "センチネルの任命された共鳴器は"}, {"type": "subtitle", "time": 12491.83, "timestamp": "03:28:11", "text": "その近辺での使用が許可されている。今のところ、"}, {"type": "subtitle", "time": 12495.11, "timestamp": "03:28:15", "text": "その人物はジェン・ジョエルの治安判事である。"}, {"type": "subtitle", "time": 12498.389, "timestamp": "03:28:18", "text": "デノの行政官は誰ですか？"}, {"type": "subtitle", "time": 12503.11, "timestamp": "03:28:23", "text": "ああ、残念。それはきっとエリート層に違いない。"}, {"type": "subtitle", "time": 12505.99, "timestamp": "03:28:25", "text": "ああ、何が起こっているの？"}, {"type": "subtitle", "time": 12508.229, "timestamp": "03:28:28", "text": "ジェシアは危険な状況にあるかもしれない。ロボット、"}, {"type": "subtitle", "time": 12511.87, "timestamp": "03:28:31", "text": "お願いします。お願いします。さあ、行こう。戦い"}, {"type": "subtitle", "time": 12516.229, "timestamp": "03:28:36", "text": "戦闘時間。さあ行こう。"}, {"type": "subtitle", "time": 12527.389, "timestamp": "03:28:47", "text": "共鳴の瞬間。共振。ああ、"}, {"type": "subtitle", "time": 12529.229, "timestamp": "03:28:49", "text": "神。"}, {"type": "subtitle", "time": 12532.63, "timestamp": "03:28:52", "text": "ワ。ダメージを与えている。敵を倒すか"}, {"type": "subtitle", "time": 12534.95, "timestamp": "03:28:54", "text": "回避行動を実行すると共鳴が生じる"}, {"type": "subtitle", "time": 12538.07, "timestamp": "03:28:58", "text": "エネルギー。共鳴エネルギーが低下すると、"}]
[{"type": "subtitle", "time": 13441.189, "timestamp": "03:44:01", "text": "ミラは保持できないはずだ"}, {"type": "subtitle", "time": 13444.03, "timestamp": "03:44:04", "text": "このような会話。"}, {"type": "subtitle", "time": 13446.59, "timestamp": "03:44:06", "text": "はぁ？なぜやめたのですか？"}, {"type": "subtitle", "time": 13449.95, "timestamp": "03:44:09", "text": "話している？道に迷いましたか？ちょっと途方に暮れています。"}, {"type": "subtitle", "time": 13453.99, "timestamp": "03:44:13", "text": "安全な場所へお連れできます。"}, {"type": "subtitle", "time": 13468.1, "timestamp": "03:44:28", "text": "村。おお、"}, {"type": "subtitle", "time": 13472.63, "timestamp": "03:44:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13488.55, "timestamp": "03:44:48", "text": "えっと、ここにこれみたいなものがあったっけ？"}, {"type": "subtitle", "time": 13490.95, "timestamp": "03:44:50", "text": "前に？"}, {"type": "subtitle", "time": 13492.189, "timestamp": "03:44:52", "text": "これら"}, {"type": "subtitle", "time": 13494.389, "timestamp": "03:44:54", "text": "メカニズム。ロックを解除する必要がある"}, {"type": "subtitle", "time": 13496.92, "timestamp": "03:44:56", "text": "両側から同時に。"}]
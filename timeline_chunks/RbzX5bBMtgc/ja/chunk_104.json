[{"type": "subtitle", "time": 6240.229, "timestamp": "01:44:00", "text": "実際、毎日2つの組合レベルで"}, {"type": "subtitle", "time": 6251.229, "timestamp": "01:44:11", "text": "はぁ？スキル"}, {"type": "subtitle", "time": 6253.149, "timestamp": "01:44:13", "text": "トレーニング。"}, {"type": "subtitle", "time": 6261.189, "timestamp": "01:44:21", "text": "この金色の悪夢を完成させるもの"}, {"type": "subtitle", "time": 6263.35, "timestamp": "01:44:23", "text": "ナイトマーケットトークンを獲得すると、"}, {"type": "subtitle", "time": 6267.07, "timestamp": "01:44:27", "text": "オーケーと交換しました。これは"}, {"type": "subtitle", "time": 6269.95, "timestamp": "01:44:29", "text": "武器？これは"}, {"type": "subtitle", "time": 6272.75, "timestamp": "01:44:32", "text": "武器？これらは"}, {"type": "subtitle", "time": 6274.51, "timestamp": "01:44:34", "text": "兵器？"}, {"type": "subtitle", "time": 6279.709, "timestamp": "01:44:39", "text": "ファントム・ロレーナ・ロレアル。ロレアルではない。"}, {"type": "subtitle", "time": 6288.229, "timestamp": "01:44:48", "text": "ロレアル。わかった。わかった。うんうん。えっと、私たちは"}, {"type": "subtitle", "time": 6292.75, "timestamp": "01:44:52", "text": "クエスト。それは武器のスキンです。"}, {"type": "subtitle", "time": 6297.91, "timestamp": "01:44:57", "text": "ああ、クエストがたくさんある。探求。探求。"}]
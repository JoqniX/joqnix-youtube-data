[{"type": "subtitle", "time": 5412.229, "timestamp": "01:30:12", "text": "チェック。以前使っていたウェブサイトがありました"}, {"type": "subtitle", "time": 5426.27, "timestamp": "01:30:26", "text": "波。ああ、枯れていく"}, {"type": "subtitle", "time": 5427.46, "timestamp": "01:30:27", "text": "波。"}, {"type": "subtitle", "time": 5437.669, "timestamp": "01:30:37", "text": "えっと、以前はウェブサイトがあって、"}, {"type": "subtitle", "time": 5440.709, "timestamp": "01:30:40", "text": "気に入った。名前を忘れてしまった。ゴア"}, {"type": "subtitle", "time": 5444.43, "timestamp": "01:30:44", "text": "実験室これは知りません。私はしません"}, {"type": "subtitle", "time": 5448.11, "timestamp": "01:30:48", "text": "知る。 Genshin.gg私はしません"}, {"type": "subtitle", "time": 5451.59, "timestamp": "01:30:51", "text": "そのウェブサイトが何だったか知っていますか？ああ、そう思う"}, {"type": "subtitle", "time": 5453.11, "timestamp": "01:30:53", "text": "これだ。そう、これだ。"}, {"type": "subtitle", "time": 5455.189, "timestamp": "01:30:55", "text": "うん。うん。うん。これは私が"}]
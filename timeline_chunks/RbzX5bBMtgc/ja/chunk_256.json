[{"type": "subtitle", "time": 15393.91, "timestamp": "04:16:33", "text": "挨拶。対処がほぼ完了しました"}, {"type": "subtitle", "time": 15396.79, "timestamp": "04:16:36", "text": "前回の事件の余波、"}, {"type": "subtitle", "time": 15398.79, "timestamp": "04:16:38", "text": "しかし彼らは手に入れたかった"}, {"type": "subtitle", "time": 15401.03, "timestamp": "04:16:41", "text": "伝説からの時間プログラム"}, {"type": "subtitle", "time": 15403.99, "timestamp": "04:16:43", "text": "意図を持ってゲームを行う"}, {"type": "subtitle", "time": 15407.03, "timestamp": "04:16:47", "text": "チャンギで大混乱を引き起こしたと語られた"}, {"type": "subtitle", "time": 15409.83, "timestamp": "04:16:49", "text": "私たちに、フライダス監督者が入ったと告げた"}, {"type": "subtitle", "time": 15413.189, "timestamp": "04:16:53", "text": "ソノラの槍で攻撃され、負傷した。私は"}, {"type": "subtitle", "time": 15415.03, "timestamp": "04:16:55", "text": "市のために詳細な報告書を作成する"}, {"type": "subtitle", "time": 15417.67, "timestamp": "04:16:57", "text": "ホール。我々は強化する。私たちは2度別れた"}, {"type": "subtitle", "time": 15419.75, "timestamp": "04:16:59", "text": "数日前、海岸で。おそらく彼女は"}]
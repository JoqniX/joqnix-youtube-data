[{"type": "subtitle", "time": 12600.309, "timestamp": "03:30:00", "text": "共鳴器はコンサートエネルギーを蓄えることができる"}, {"type": "subtitle", "time": 12602.67, "timestamp": "03:30:02", "text": "ダメージを与えたり、回避行動をとったりする"}, {"type": "subtitle", "time": 12605.51, "timestamp": "03:30:05", "text": "戦闘。コンセルトのエネルギーが満ち溢れるとき、"}, {"type": "subtitle", "time": 12607.429, "timestamp": "03:30:07", "text": "他の共鳴器アイコンも光ります。"}, {"type": "subtitle", "time": 12610.07, "timestamp": "03:30:10", "text": "はい、わかりました。つまり、香港みたいなものですね"}, {"type": "subtitle", "time": 12612.51, "timestamp": "03:30:12", "text": "第三のシステムみたいなもの。手に入れた"}, {"type": "subtitle", "time": 12615.83, "timestamp": "03:30:15", "text": "それ。つまり、あなたのエネルギーは引き起こすのに十分だ"}, {"type": "subtitle", "time": 12617.83, "timestamp": "03:30:17", "text": "既存の共鳴器アウトロスキルと"}, {"type": "subtitle", "time": 12619.99, "timestamp": "03:30:19", "text": "すべての概念エネルギーを消費して"}, {"type": "subtitle", "time": 12621.75, "timestamp": "03:30:21", "text": "着信共鳴器のイントロをトリガーする"}, {"type": "subtitle", "time": 12624.55, "timestamp": "03:30:24", "text": "スキル。各共鳴器には独自のエンディングがある"}, {"type": "subtitle", "time": 12626.429, "timestamp": "03:30:26", "text": "そして入門スキル。"}, {"type": "subtitle", "time": 12633.349, "timestamp": "03:30:33", "text": "素敵なVA、ラグがひどい、待って、Twitterは"}, {"type": "subtitle", "time": 12635.429, "timestamp": "03:30:35", "text": "サーバーが過負荷状態になっているか、非常に動作が遅いのでしょうか？"}, {"type": "subtitle", "time": 12638.229, "timestamp": "03:30:38", "text": "全員の配信。君が戦ったんだ"}, {"type": "subtitle", "time": 12640.87, "timestamp": "03:30:40", "text": "良い。待って、Twitchすら入手してないよ"}, {"type": "subtitle", "time": 12643.269, "timestamp": "03:30:43", "text": "ストリームがカクカクしています。ヤンは駆け寄ってきた"}, {"type": "subtitle", "time": 12644.91, "timestamp": "03:30:44", "text": "あなたを守るために"}, {"type": "subtitle", "time": 12648.389, "timestamp": "03:30:48", "text": "とにかく、ヤンヤンは"}, {"type": "subtitle", "time": 12651.269, "timestamp": "03:30:51", "text": "あなた、そしてバン、テッサのディスコードは"}, {"type": "subtitle", "time": 12653.03, "timestamp": "03:30:53", "text": "彼が良いものを手に入れる前に世話をされた"}, {"type": "subtitle", "time": 12654.33, "timestamp": "03:30:54", "text": "見て。"}, {"type": "subtitle", "time": 12657.75, "timestamp": "03:30:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 11945.429, "timestamp": "03:19:05", "text": "あなたは目を覚ましました。こんにちは。そうねぇ。誰が"}, {"type": "subtitle", "time": 11948.07, "timestamp": "03:19:08", "text": "これ？この二人の人物は誰ですか？または"}, {"type": "subtitle", "time": 11950.87, "timestamp": "03:19:10", "text": "最後の切り札を試してみるしかない。"}, {"type": "subtitle", "time": 11953.55, "timestamp": "03:19:13", "text": "若手パトロール隊員のための緊急時対応スキル。"}, {"type": "subtitle", "time": 11955.19, "timestamp": "03:19:15", "text": "心肺蘇生法。"}, {"type": "subtitle", "time": 11960.79, "timestamp": "03:19:20", "text": "[音楽]"}, {"type": "subtitle", "time": 11964.51, "timestamp": "03:19:24", "text": "生きている人間に対しては、決してやったことがない。"}, {"type": "subtitle", "time": 11967.51, "timestamp": "03:19:27", "text": "ジェシア、ごめんね。ごめん。あなたは今目を覚ました"}, {"type": "subtitle", "time": 11971.51, "timestamp": "03:19:31", "text": "そして私は今、ものすごい勢いでおしゃべりをしている。"}, {"type": "subtitle", "time": 11974.469, "timestamp": "03:19:34", "text": "やったー。"}, {"type": "subtitle", "time": 11980.15, "timestamp": "03:19:40", "text": "大丈夫ですか？何てことだ。快適。"}, {"type": "subtitle", "time": 11982.71, "timestamp": "03:19:42", "text": "何か違和感を感じますか？さあ、行こう。あなた"}, {"type": "subtitle", "time": 11985.51, "timestamp": "03:19:45", "text": "は。私のことはトリシャと呼んでください。チシャ。"}, {"type": "subtitle", "time": 11988.469, "timestamp": "03:19:48", "text": "彼女はヤンです。ヤンヤン。こんにちは、ヤンヤン。"}]
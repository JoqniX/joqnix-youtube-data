[{"type": "subtitle", "time": 27240.548, "timestamp": "07:34:00", "text": "モーターを手に入れて、私は"}, {"type": "subtitle", "time": 27241.708, "timestamp": "07:34:01", "text": "取得するため"}, {"type": "subtitle", "time": 27244.23, "timestamp": "07:34:04", "text": "それは何て言うんだっけ？殴る"}, {"type": "subtitle", "time": 27246.23, "timestamp": "07:34:06", "text": "雷。ああ、手に入れることができるだろう"}, {"type": "subtitle", "time": 27248.708, "timestamp": "07:34:08", "text": "これを終わらせろ。これで2人目だ"}, {"type": "subtitle", "time": 27252.388, "timestamp": "07:34:12", "text": "完了しました。Cもこちらも同様です。"}, {"type": "subtitle", "time": 27254.868, "timestamp": "07:34:14", "text": "ストーリーをスピードランして"}, {"type": "subtitle", "time": 27258.628, "timestamp": "07:34:18", "text": "33まで、もしくはキャプテンレベル50に到達します"}, {"type": "subtitle", "time": 27261.51, "timestamp": "07:34:21", "text": "そして、イベントチップスペースを作成します。つまり"}, {"type": "subtitle", "time": 27263.75, "timestamp": "07:34:23", "text": "私の唯一のもの。だから私はこう思う"}, {"type": "subtitle", "time": 27265.43, "timestamp": "07:34:25", "text": "スピードランニングが好きで、たくさんやっています"}, {"type": "subtitle", "time": 27267.83, "timestamp": "07:34:27", "text": "ホークアイ艦の。わかった。じゃあBBに行こう"}, {"type": "subtitle", "time": 27270.31, "timestamp": "07:34:30", "text": "それから、水を補充してください。じゃあまた戻ってくるよ"}, {"type": "subtitle", "time": 27273.91, "timestamp": "07:34:33", "text": "もう少ししたら。わかった。少ししたら戻ってきます。"}, {"type": "subtitle", "time": 27275.15, "timestamp": "07:34:35", "text": "だから私たちは"}, {"type": "subtitle", "time": 27279.19, "timestamp": "07:34:39", "text": "大きくて可愛い子、家族へようこそ。"}, {"type": "subtitle", "time": 27282.07, "timestamp": "07:34:42", "text": "素敵な一日をお過ごしください。ありがとう"}, {"type": "subtitle", "time": 27284.788, "timestamp": "07:34:44", "text": "私のチャンネルを見つけてくれてありがとう。なんてこった。私にさせてください"}, {"type": "subtitle", "time": 27287.23, "timestamp": "07:34:47", "text": "どうやって私のことを見つけたのか"}]
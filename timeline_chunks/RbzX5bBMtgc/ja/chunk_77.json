[{"type": "subtitle", "time": 4620.709, "timestamp": "01:17:00", "text": "中央共振器と相乗効果を発揮し、"}, {"type": "subtitle", "time": 4622.95, "timestamp": "01:17:02", "text": "彼女は素晴らしいナンパだと思う"}, {"type": "subtitle", "time": 4625.03, "timestamp": "01:17:05", "text": "フィービーと共に現在の価値を持つだけでなく"}, {"type": "subtitle", "time": 4627.63, "timestamp": "01:17:07", "text": "そして、ザニも可能性としてはあり得る。の"}, {"type": "subtitle", "time": 4631.43, "timestamp": "01:17:11", "text": "ギターはとても綺麗で、空気の侵食"}, {"type": "subtitle", "time": 4634.229, "timestamp": "01:17:14", "text": "チーム。彼女には8.5点をつけるよ"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "これについては10点満点中10点です。次はギンシです。"}, {"type": "subtitle", "time": 4638.99, "timestamp": "01:17:18", "text": "センチネルといえば"}, {"type": "subtitle", "time": 4641.91, "timestamp": "01:17:21", "text": "共鳴器、私は王冠を欲しくない"}, {"type": "subtitle", "time": 4643.31, "timestamp": "01:17:23", "text": "彼女は"}, {"type": "subtitle", "time": 4645.75, "timestamp": "01:17:25", "text": "メタ。実際には挑戦を受けていない"}, {"type": "subtitle", "time": 4653.63, "timestamp": "01:17:33", "text": "誰についてですか？"}, {"type": "subtitle", "time": 4658.07, "timestamp": "01:17:38", "text": "クラロタですか？クラロタは最高のものの1つです"}, {"type": "subtitle", "time": 4661.189, "timestamp": "01:17:41", "text": "ゲーム全体におけるDPS。みんな"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "が来たとき、"}, {"type": "subtitle", "time": 4665.83, "timestamp": "01:17:45", "text": "クリアリングタワーへ、こちらがあなたのガールフレンドです。"}, {"type": "subtitle", "time": 4668.63, "timestamp": "01:17:48", "text": "誰かに絶対に"}, {"type": "subtitle", "time": 4671.669, "timestamp": "01:17:51", "text": "ボスを叩きのめすなら、コラダに電話するんだ。"}, {"type": "subtitle", "time": 4674.149, "timestamp": "01:17:54", "text": "彼女は、"}, {"type": "subtitle", "time": 4676.79, "timestamp": "01:17:56", "text": "ゲーム全体。特にプレイ中"}, {"type": "subtitle", "time": 4679.669, "timestamp": "01:17:59", "text": "彼女のトレードマークの武器と"}]
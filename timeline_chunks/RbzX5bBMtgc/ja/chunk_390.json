[{"type": "subtitle", "time": 23432.07, "timestamp": "06:30:32", "text": "私に従ってください。最後の宝箱はここにあります。"}, {"type": "subtitle", "time": 23435.11, "timestamp": "06:30:35", "text": "獲物は誰だ？"}, {"type": "subtitle", "time": 23438.788, "timestamp": "06:30:38", "text": "ええ、睡眠サイクルですね。ええ、わかっています。私"}, {"type": "subtitle", "time": 23440.708, "timestamp": "06:30:40", "text": "文字通り、これを望んでいなかった"}, {"type": "subtitle", "time": 23443.35, "timestamp": "06:30:43", "text": "起こることは起こるが、衰えゆく波は消え去る。私は責める"}, {"type": "subtitle", "time": 23444.51, "timestamp": "06:30:44", "text": "これ"}, {"type": "subtitle", "time": 23456.03, "timestamp": "06:30:56", "text": "ゲーム。ゲームのせいだと思う。の"}]
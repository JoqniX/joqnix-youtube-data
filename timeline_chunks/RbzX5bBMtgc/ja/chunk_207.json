[{"type": "subtitle", "time": 12421.75, "timestamp": "03:27:01", "text": "あなた。何てことだ。何てことだ。ありがとう"}, {"type": "subtitle", "time": 12426.63, "timestamp": "03:27:06", "text": "贈呈された購読者向け。何てことだ。"}, {"type": "subtitle", "time": 12429.03, "timestamp": "03:27:09", "text": "何てことだ。バカ、そんなことしなくてもよかったのに。"}, {"type": "subtitle", "time": 12431.55, "timestamp": "03:27:11", "text": "ありがとう。ああ、"}, {"type": "subtitle", "time": 12434.99, "timestamp": "03:27:14", "text": "神。何てことだ。"}, {"type": "subtitle", "time": 12439.269, "timestamp": "03:27:19", "text": "何？何？本当にありがとうございました。"}, {"type": "subtitle", "time": 12441.95, "timestamp": "03:27:21", "text": "繁栄する。抽選と"}, {"type": "subtitle", "time": 12446.229, "timestamp": "03:27:26", "text": "カワイは現在共存している"}, {"type": "subtitle", "time": 12448.55, "timestamp": "03:27:28", "text": "イベントのためにやったからです。待って、"}, {"type": "subtitle", "time": 12451.03, "timestamp": "03:27:31", "text": "どのイベントですか？配信者向けイベント。おお"}, {"type": "subtitle", "time": 12454.63, "timestamp": "03:27:34", "text": "うん、そういうこともあるよね。忘れた。"}, {"type": "subtitle", "time": 12462.87, "timestamp": "03:27:42", "text": "ハンゴンの一部は自然に"}, {"type": "subtitle", "time": 12465.91, "timestamp": "03:27:45", "text": "他の地域でも見られるが、それに比べると少ない。"}, {"type": "subtitle", "time": 12467.99, "timestamp": "03:27:47", "text": "に"}, {"type": "subtitle", "time": 12471.269, "timestamp": "03:27:51", "text": "大金持ちだが"}, {"type": "subtitle", "time": 12473.71, "timestamp": "03:27:53", "text": "あなたは私たちの"}, {"type": "subtitle", "time": 12476.229, "timestamp": "03:27:56", "text": "番兵は私たちの番兵をほとんど見ることができません"}, {"type": "subtitle", "time": 12479.03, "timestamp": "03:27:59", "text": "自分の目で見たほとんどの人は"}]
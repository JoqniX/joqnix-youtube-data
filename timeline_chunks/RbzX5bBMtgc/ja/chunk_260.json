[{"type": "subtitle", "time": 15600.55, "timestamp": "04:20:00", "text": "もちろん、何でも聞いてください。喜んでお答えします"}, {"type": "subtitle", "time": 15603.75, "timestamp": "04:20:03", "text": "私の力の限りを尽くします。私の主人と"}, {"type": "subtitle", "time": 15606.389, "timestamp": "04:20:06", "text": "謎の訪問者は罠を仕掛けていた"}, {"type": "subtitle", "time": 15609.03, "timestamp": "04:20:09", "text": "ウィチを使用したソナロスフィア"}, {"type": "subtitle", "time": 15611.67, "timestamp": "04:20:11", "text": "ゲームは偽装に過ぎない。ああ、彼らはそれを隠した"}, {"type": "subtitle", "time": 15612.67, "timestamp": "04:20:12", "text": "裁判所"}, {"type": "subtitle", "time": 15615.349, "timestamp": "04:20:15", "text": "乾杯。センチネルとマウントにもかかわらず"}, {"type": "subtitle", "time": 15618.389, "timestamp": "04:20:18", "text": "天空が救われたら、フライダスは"}, {"type": "subtitle", "time": 15620.87, "timestamp": "04:20:20", "text": "簡単に諦めるつもりはない。"}, {"type": "subtitle", "time": 15623.99, "timestamp": "04:20:23", "text": "それらは純粋な偶然か、"}, {"type": "subtitle", "time": 15627.349, "timestamp": "04:20:27", "text": "フレイダスの計算された動作。の"}, {"type": "subtitle", "time": 15630.469, "timestamp": "04:20:30", "text": "探検家はウィチの掲示板に偶然出くわし、"}, {"type": "subtitle", "time": 15633.75, "timestamp": "04:20:33", "text": "防御機構が作動する。"}, {"type": "subtitle", "time": 15635.91, "timestamp": "04:20:35", "text": "監視員は既に損傷を受けていた"}, {"type": "subtitle", "time": 15638.71, "timestamp": "04:20:38", "text": "ここに到着しました。私の師匠は"}, {"type": "subtitle", "time": 15640.429, "timestamp": "04:20:40", "text": "マウントに降りかかるであろう災害"}, {"type": "subtitle", "time": 15643.03, "timestamp": "04:20:43", "text": "天空、それで彼はこの仕組みを作り出した"}, {"type": "subtitle", "time": 15645.51, "timestamp": "04:20:45", "text": "予防措置として。の"}, {"type": "subtitle", "time": 15647.75, "timestamp": "04:20:47", "text": "ソノロスフィアは、"}, {"type": "subtitle", "time": 15651.59, "timestamp": "04:20:51", "text": "彼らが知らない限り、入ろうとした"}]
[{"type": "subtitle", "time": 3781.91, "timestamp": "01:03:01", "text": "原神。ああ、よかった。私は手に入れて手に入れました"}, {"type": "subtitle", "time": 3789.19, "timestamp": "01:03:09", "text": "ああ、見て。とてもかわいい。これは何ですか"}, {"type": "subtitle", "time": 3792.97, "timestamp": "01:03:12", "text": "私をブロックしてるの？"}, {"type": "subtitle", "time": 3805.15, "timestamp": "01:03:25", "text": "[音楽]"}, {"type": "subtitle", "time": 3808.589, "timestamp": "01:03:28", "text": "Zingを狙うならサイコロを振ろう。私はしません"}, {"type": "subtitle", "time": 3813.309, "timestamp": "01:03:33", "text": "知る。 Zyを買うべきでしょうか？私は"}, {"type": "subtitle", "time": 3816.63, "timestamp": "01:03:36", "text": "次にどのキャラクターが登場するかを知る。"}, {"type": "subtitle", "time": 3819.029, "timestamp": "01:03:39", "text": "私は保存すべきだと思う"}, {"type": "subtitle", "time": 3823.71, "timestamp": "01:03:43", "text": "ああ神様、"}]
[{"type": "subtitle", "time": 6362.709, "timestamp": "01:46:02", "text": "難しい。ええと、ビーコンとエリアが1つあります"}, {"type": "subtitle", "time": 6365.35, "timestamp": "01:46:05", "text": "クエストとバグのために"}, {"type": "subtitle", "time": 6367.07, "timestamp": "01:46:07", "text": "[音楽]"}, {"type": "subtitle", "time": 6370.03, "timestamp": "01:46:10", "text": "虫を捕獲する。私はすべて手に入れました"}, {"type": "subtitle", "time": 6372.709, "timestamp": "01:46:12", "text": "胸。共鳴ビーコン。どこにある"}, {"type": "subtitle", "time": 6380.87, "timestamp": "01:46:20", "text": "いいえ、前のエリアでは、なぜなら"}, {"type": "subtitle", "time": 6390.07, "timestamp": "01:46:30", "text": "わかった。わかった。まず最初に、えっと、私はどこにいるの？"}, {"type": "subtitle", "time": 6392.47, "timestamp": "01:46:32", "text": "私？私はここにいるよね？フィラメント村。"}]
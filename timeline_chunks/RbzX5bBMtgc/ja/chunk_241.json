[{"type": "subtitle", "time": 14464.469, "timestamp": "04:01:04", "text": "ああ、だから彼女はとても賢くなり、"}, {"type": "subtitle", "time": 14472.59, "timestamp": "04:01:12", "text": "あなたは炎の力を宿している"}, {"type": "subtitle", "time": 14476.67, "timestamp": "04:01:16", "text": "操作。フェニックスは"}, {"type": "subtitle", "time": 14479.75, "timestamp": "04:01:19", "text": "火。この地に平和をもたらすもの"}, {"type": "subtitle", "time": 14481.269, "timestamp": "04:01:21", "text": "世界。"}, {"type": "subtitle", "time": 14483.5, "timestamp": "04:01:23", "text": "おお、"}, {"type": "subtitle", "time": 14484.79, "timestamp": "04:01:24", "text": "[音楽]"}, {"type": "subtitle", "time": 14486.349, "timestamp": "04:01:26", "text": "今日から"}, {"type": "subtitle", "time": 14491.51, "timestamp": "04:01:31", "text": "今後は、あなたの名前は[ __ ]・リーになります。[ __ ]"}, {"type": "subtitle", "time": 14499.11, "timestamp": "04:01:39", "text": "永遠の炎。行かなければならないのですか、"}, {"type": "subtitle", "time": 14501.11, "timestamp": "04:01:41", "text": "マスター？"}, {"type": "subtitle", "time": 14505.99, "timestamp": "04:01:45", "text": "私がこれに関わった時間。あなたは行くのですか？"}, {"type": "subtitle", "time": 14509.71, "timestamp": "04:01:49", "text": "まだそこへ行く番ではない、"}, {"type": "subtitle", "time": 14512.95, "timestamp": "04:01:52", "text": "チャングリー。しかし、その代償は"}, {"type": "subtitle", "time": 14515.83, "timestamp": "04:01:55", "text": "自分の得意分野を積極的に活用することで"}, {"type": "subtitle", "time": 14519.269, "timestamp": "04:01:59", "text": "決して消し去られることはない。"}]
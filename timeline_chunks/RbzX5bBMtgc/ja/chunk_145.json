[{"type": "subtitle", "time": 8701.67, "timestamp": "02:25:01", "text": "まばたきする。"}, {"type": "subtitle", "time": 8719.67, "timestamp": "02:25:19", "text": "わかった。うちの家に蚊が多すぎるんだよ。"}, {"type": "subtitle", "time": 8720.55, "timestamp": "02:25:20", "text": "何"}, {"type": "subtitle", "time": 8724.51, "timestamp": "02:25:24", "text": "[音楽]"}, {"type": "subtitle", "time": 8727.21, "timestamp": "02:25:27", "text": "えっ？ああ、あれは何？"}, {"type": "subtitle", "time": 8738.75, "timestamp": "02:25:38", "text": "ああ、タロンと"}, {"type": "subtitle", "time": 8743.23, "timestamp": "02:25:43", "text": "その楽器はダンスゲームには向いていない。"}]
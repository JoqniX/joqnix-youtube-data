[{"type": "subtitle", "time": 3737.75, "timestamp": "01:02:17", "text": "なぜ私は見知らぬ人たちと戦っているのだろうか？"}, {"type": "subtitle", "time": 3740.87, "timestamp": "01:02:20", "text": "まったく新しい領域、つまり領域ではない領域があります"}, {"type": "subtitle", "time": 3744.349, "timestamp": "01:02:24", "text": "まったく新しい全体"}, {"type": "subtitle", "time": 3748.27, "timestamp": "01:02:28", "text": "この新しい国を探検しなければならない"}, {"type": "subtitle", "time": 3750.95, "timestamp": "01:02:30", "text": "ゲーム。やらなきゃいけないことの量"}, {"type": "subtitle", "time": 3752.17, "timestamp": "01:02:32", "text": "は"}, {"type": "subtitle", "time": 3756.43, "timestamp": "01:02:36", "text": "[音楽]"}, {"type": "subtitle", "time": 3758.75, "timestamp": "01:02:38", "text": "非常識な。おお"}, {"type": "subtitle", "time": 3778.51, "timestamp": "01:02:58", "text": "[音楽]"}]
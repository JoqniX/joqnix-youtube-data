[{"type": "subtitle", "time": 6009.25, "timestamp": "01:40:09", "text": "私は新しいものを接ぎ木する。"}, {"type": "subtitle", "time": 6018.47, "timestamp": "01:40:18", "text": "来て。来て。ターゲットスリップドット"}, {"type": "subtitle", "time": 6023.51, "timestamp": "01:40:23", "text": "戦争。その時が来た。"}, {"type": "subtitle", "time": 6042.31, "timestamp": "01:40:42", "text": "ピース。なぜ黄色なのですか？わかったよ。私は愛する"}, {"type": "subtitle", "time": 6044.629, "timestamp": "01:40:44", "text": "このボスとの戦い方を忘れちゃったよ。私"}, {"type": "subtitle", "time": 6048.07, "timestamp": "01:40:48", "text": "以前はこれをスピードランしたかった"}, {"type": "subtitle", "time": 6050.07, "timestamp": "01:40:50", "text": "私が農業のためにひたすら努力していた間"}, {"type": "subtitle", "time": 6051.91, "timestamp": "01:40:51", "text": "材料について。"}]
[{"type": "subtitle", "time": 27429.628, "timestamp": "07:37:09", "text": "はい、メインのほとんどをアップグレードしました"}, {"type": "subtitle", "time": 27434.868, "timestamp": "07:37:14", "text": "3つも同様です。アップグレードしました。私はしませんでした"}, {"type": "subtitle", "time": 27437.91, "timestamp": "07:37:17", "text": "ええ、アップグレードしました"}, {"type": "subtitle", "time": 27439.708, "timestamp": "07:37:19", "text": "最大限"}, {"type": "subtitle", "time": 27442.23, "timestamp": "07:37:22", "text": "行く。ええ、私が行ける最大は"}, {"type": "subtitle", "time": 27445.15, "timestamp": "07:37:25", "text": "キャプテンレベルですよね？"}, {"type": "subtitle", "time": 27449.468, "timestamp": "07:37:29", "text": "うん。さあ、行こう。私たちはする必要があります"}, {"type": "subtitle", "time": 27452.35, "timestamp": "07:37:32", "text": "世界を"}, {"type": "subtitle", "time": 27457.11, "timestamp": "07:37:37", "text": "1つ。これは106個あります。だから、"}, {"type": "subtitle", "time": 27458.67, "timestamp": "07:37:38", "text": "つまり私は"}, {"type": "subtitle", "time": 27463.27, "timestamp": "07:37:43", "text": "かなり多くのものが上昇する。わかった。クリア"}, {"type": "subtitle", "time": 27466.868, "timestamp": "07:37:46", "text": "300 のステージで、300 の中にトリックがあります"}, {"type": "subtitle", "time": 27469.388, "timestamp": "07:37:49", "text": "少なくとも３回は飛行スキルを習得する。さあ"}, {"type": "subtitle", "time": 27473.43, "timestamp": "07:37:53", "text": "行く。この待ち時間には新しい"}]
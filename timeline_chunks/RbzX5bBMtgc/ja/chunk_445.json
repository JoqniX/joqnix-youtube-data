[{"type": "subtitle", "time": 26701.27, "timestamp": "07:25:01", "text": "それは今、えーと、ストリームは"}, {"type": "subtitle", "time": 26703.67, "timestamp": "07:25:03", "text": "ストリームの計画を2つ立てた"}, {"type": "subtitle", "time": 26705.35, "timestamp": "07:25:05", "text": "数分前。"}, {"type": "subtitle", "time": 26706.468, "timestamp": "07:25:06", "text": "そして私は「ああ、そうだね」と思った。"}, {"type": "subtitle", "time": 26710.27, "timestamp": "07:25:10", "text": "9時30分です。ジョック、ライブ配信してよ。ただ手に入れるだけ"}, {"type": "subtitle", "time": 26713.75, "timestamp": "07:25:13", "text": "彼。」うん。うん。それで、今日は、えーと、"}, {"type": "subtitle", "time": 26714.75, "timestamp": "07:25:14", "text": "行く"}, {"type": "subtitle", "time": 26717.91, "timestamp": "07:25:17", "text": "我々が持っているもの、我々がこれからすることを行う"}, {"type": "subtitle", "time": 26718.67, "timestamp": "07:25:18", "text": "する"}, {"type": "subtitle", "time": 26722.948, "timestamp": "07:25:22", "text": "私たちは、イベントを開催します。"}, {"type": "subtitle", "time": 26725.83, "timestamp": "07:25:25", "text": "イベント、最短のもの。私は元気です"}, {"type": "subtitle", "time": 26728.23, "timestamp": "07:25:28", "text": "夜。そのため、このようなストリームを目にするかもしれません。"}, {"type": "subtitle", "time": 26732.31, "timestamp": "07:25:32", "text": "ちょっと出入りを2、3回。それで、"}, {"type": "subtitle", "time": 26734.59, "timestamp": "07:25:34", "text": "また、"}, {"type": "subtitle", "time": 26738.51, "timestamp": "07:25:38", "text": "マナのようなものですが、私たちは最善を尽くします"}, {"type": "subtitle", "time": 26742.31, "timestamp": "07:25:42", "text": "これ。だから、私たちは最善を尽くします。"}, {"type": "subtitle", "time": 26745.43, "timestamp": "07:25:45", "text": "「ああ、私たちはこれに対して最善を尽くします」という感じです。"}, {"type": "subtitle", "time": 26749.27, "timestamp": "07:25:49", "text": "よし。それで、私はちょっと偶然に"}, {"type": "subtitle", "time": 26752.39, "timestamp": "07:25:52", "text": "誤って3、2、"}, {"type": "subtitle", "time": 26753.788, "timestamp": "07:25:53", "text": "2つの"}, {"type": "subtitle", "time": 26758.468, "timestamp": "07:25:58", "text": "同じ2つのうちの2つ、同じ2つのうちの2つ、これ"}]
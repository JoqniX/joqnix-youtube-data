[{"type": "subtitle", "time": 17885.87, "timestamp": "04:58:05", "text": "非常識な。おい"}, {"type": "subtitle", "time": 17903.51, "timestamp": "04:58:23", "text": "私は探求の途上にいる。私は"}, {"type": "subtitle", "time": 17932.67, "timestamp": "04:58:52", "text": "これは過去の独特な尺度である"}, {"type": "subtitle", "time": 17935.43, "timestamp": "04:58:55", "text": "あれ。私はたくさん手に入れるはず"}, {"type": "subtitle", "time": 17939.51, "timestamp": "04:58:59", "text": "これらは最高級の宝石を手に入れるためだけのものです。つまり、"}]
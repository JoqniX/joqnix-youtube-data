[{"type": "subtitle", "time": 12062.62, "timestamp": "03:21:02", "text": "それ。まもなくここは危険になります。"}, {"type": "subtitle", "time": 12069.429, "timestamp": "03:21:09", "text": "私はそれを知っていた。私たちのひょうたんは使用できません"}, {"type": "subtitle", "time": 12071.59, "timestamp": "03:21:11", "text": "エーテル体の影響による。"}, {"type": "subtitle", "time": 12073.67, "timestamp": "03:21:13", "text": "メッセージの送受信ができません"}, {"type": "subtitle", "time": 12075.91, "timestamp": "03:21:15", "text": "今すぐ助けてください。急いだ方がいいよ。何が"}, {"type": "subtitle", "time": 12078.95, "timestamp": "03:21:18", "text": "神？集結地点の発見。それは何ですか"}, {"type": "subtitle", "time": 12081.349, "timestamp": "03:21:21", "text": "システム？本当に思い出せないのでしょうね"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "もの。でも、心配しないでください。神様、もしあなたが"}, {"type": "subtitle", "time": 12086.87, "timestamp": "03:21:26", "text": "何か質問があれば、移動しながら話しましょう。"}, {"type": "subtitle", "time": 12089.03, "timestamp": "03:21:29", "text": "私とインが、すべてを詳しくお伝えします。"}, {"type": "subtitle", "time": 12091.03, "timestamp": "03:21:31", "text": "最初からあらゆる細部に至るまで。"}, {"type": "subtitle", "time": 12094.389, "timestamp": "03:21:34", "text": "こんにちは。わかった。ローバー。あの、お電話してもいいですか？"}, {"type": "subtitle", "time": 12096.79, "timestamp": "03:21:36", "text": "今は、思い出す前に"}, {"type": "subtitle", "time": 12099.71, "timestamp": "03:21:39", "text": "本名？ああ、私は自分の"}, {"type": "subtitle", "time": 12102.55, "timestamp": "03:21:42", "text": "名前。待って、"}, {"type": "subtitle", "time": 12104.229, "timestamp": "03:21:44", "text": "そう思います。あ、待って。彼らは"}, {"type": "subtitle", "time": 12107.269, "timestamp": "03:21:47", "text": "私のことはロアと呼んでください。私たちはここに留まるべきではない。しかし"}, {"type": "subtitle", "time": 12110.63, "timestamp": "03:21:50", "text": "私の名前はチャックンです。私は名前をつけた。それは"}]
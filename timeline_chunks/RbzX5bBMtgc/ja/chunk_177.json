[{"type": "subtitle", "time": 10621.429, "timestamp": "02:57:01", "text": "空気を吸い、自然そのものを飲む"}, {"type": "subtitle", "time": 10631.269, "timestamp": "02:57:11", "text": "寿命。すべてはその試合から始まった"}, {"type": "subtitle", "time": 10632.03, "timestamp": "02:57:12", "text": "の"}, {"type": "subtitle", "time": 10635.79, "timestamp": "02:57:15", "text": "Wii。木こりがつまずいた"}, {"type": "subtitle", "time": 10639.19, "timestamp": "02:57:19", "text": "その上。残念ながら、それらの秘密は"}, {"type": "subtitle", "time": 10641.99, "timestamp": "02:57:21", "text": "長い間忘れ去られていた。集まってください。私はすべきでしょうか"}, {"type": "subtitle", "time": 10645.51, "timestamp": "02:57:25", "text": "それらはそうでしょうか？あなたは"}, {"type": "subtitle", "time": 10648.349, "timestamp": "02:57:28", "text": "一生。私"}, {"type": "subtitle", "time": 10651.79, "timestamp": "02:57:31", "text": "つまり、大丈夫、"}, {"type": "subtitle", "time": 10655.11, "timestamp": "02:57:35", "text": "右？全部飛ばしてもいいって分かってる。おお、"}, {"type": "subtitle", "time": 10656.99, "timestamp": "02:57:36", "text": "シャン。そうそう。私たちは"}, {"type": "chat", "time": 10658.51, "timestamp": "02:57:38", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "if u wanna"}, {"type": "subtitle", "time": 10658.59, "timestamp": "02:57:38", "text": "シャングリ。"}, {"type": "subtitle", "time": 10660.269, "timestamp": "02:57:40", "text": "上陵"}, {"type": "subtitle", "time": 10662.269, "timestamp": "02:57:42", "text": "クエスト。話"}]
[{"type": "subtitle", "time": 12360.83, "timestamp": "03:26:00", "text": "[音楽]"}, {"type": "subtitle", "time": 12363.75, "timestamp": "03:26:03", "text": "行く。彼女はちょっと可愛い。ああ、それは"}, {"type": "subtitle", "time": 12367.229, "timestamp": "03:26:07", "text": "大きなドラゴンの頭。"}, {"type": "subtitle", "time": 12369.349, "timestamp": "03:26:09", "text": "おお。ああ、あなたは"}, {"type": "subtitle", "time": 12371.67, "timestamp": "03:26:11", "text": "回想シーン。"}, {"type": "subtitle", "time": 12383.51, "timestamp": "03:26:23", "text": "これ？どうしたの？あなたは怪我をしましたか？"}, {"type": "subtitle", "time": 12386.59, "timestamp": "03:26:26", "text": "戦い？"}, {"type": "subtitle", "time": 12391.75, "timestamp": "03:26:31", "text": "ねえ、私、何か思い出した気がするの。"}, {"type": "subtitle", "time": 12396.309, "timestamp": "03:26:36", "text": "あなたは記憶の中で、私たちの番人の姿を見たのでしょう。"}, {"type": "subtitle", "time": 12398.63, "timestamp": "03:26:38", "text": "センチネル？"}, {"type": "subtitle", "time": 12402.389, "timestamp": "03:26:42", "text": "はい。私たちがこの像を建てたのは、"}, {"type": "subtitle", "time": 12405.99, "timestamp": "03:26:45", "text": "Jen Joe の Oracle Engine Sentinel。"}, {"type": "subtitle", "time": 12409.75, "timestamp": "03:26:49", "text": "ああ、Oracle Engine。香港の6都市"}, {"type": "subtitle", "time": 12414.229, "timestamp": "03:26:54", "text": "各都市にはそれぞれ独自の番人が配置されている。"}, {"type": "subtitle", "time": 12416.99, "timestamp": "03:26:56", "text": "何てことだ。感謝"}]
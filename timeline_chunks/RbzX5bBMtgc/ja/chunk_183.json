[{"type": "subtitle", "time": 10983.429, "timestamp": "03:03:03", "text": "何か。私はこの女性が欲しかった。カネラ"}, {"type": "subtitle", "time": 10987.07, "timestamp": "03:03:07", "text": "あなたの到着をささやき合っていました。彼女は"}, {"type": "subtitle", "time": 11023.59, "timestamp": "03:03:43", "text": "[音楽]"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "俺は本当にレベルが低いんだよ。レベルが必要です"}, {"type": "subtitle", "time": 11029.95, "timestamp": "03:03:49", "text": "上。私はとても落ち込んでいます"}, {"type": "subtitle", "time": 11033.64, "timestamp": "03:03:53", "text": "レベル。いつレベルアップしますか"}, {"type": "subtitle", "time": 11035.79, "timestamp": "03:03:55", "text": "[音楽]"}]
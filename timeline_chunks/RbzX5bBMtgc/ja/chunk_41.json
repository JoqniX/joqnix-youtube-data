[{"type": "subtitle", "time": 2460.43, "timestamp": "00:41:00", "text": "周年"}, {"type": "subtitle", "time": 2485.63, "timestamp": "00:41:25", "text": "[音楽]"}, {"type": "subtitle", "time": 2498.63, "timestamp": "00:41:38", "text": "何てことだ。私は中国人を演じています"}, {"type": "subtitle", "time": 2513.51, "timestamp": "00:41:53", "text": "わかった。ああ、サニさん、これは緊急事態です。私たちは"}, {"type": "subtitle", "time": 2515.27, "timestamp": "00:41:55", "text": "手がかりを得た。美術品泥棒が襲撃する"}]
[{"type": "subtitle", "time": 26405.43, "timestamp": "07:20:05", "text": "待って。待って。保証は"}, {"type": "subtitle", "time": 26428.27, "timestamp": "07:20:28", "text": "待って、ゲイリー・インディアは"}, {"type": "subtitle", "time": 26431.59, "timestamp": "07:20:31", "text": "すべてのバナー。イファはこれで終わりではない"}, {"type": "subtitle", "time": 26434.06, "timestamp": "07:20:34", "text": "態度。"}, {"type": "subtitle", "time": 26444.03, "timestamp": "07:20:44", "text": "一度五つ星を獲得し、"}, {"type": "subtitle", "time": 26447.83, "timestamp": "07:20:47", "text": "再供給されました。おお。なんてこった。それはつまり"}]
[{"type": "subtitle", "time": 12733.63, "timestamp": "03:32:13", "text": "ニース。もうすぐ美しい場所に着きます"}, {"type": "subtitle", "time": 12736.389, "timestamp": "03:32:16", "text": "入り口。下り坂はあるだろうが、"}, {"type": "subtitle", "time": 12738.83, "timestamp": "03:32:18", "text": "もしあなたが私のアラームが"}, {"type": "subtitle", "time": 12741.91, "timestamp": "03:32:21", "text": "鳴った。午前7時アラーム。一度外に出ると"}, {"type": "subtitle", "time": 12744.229, "timestamp": "03:32:24", "text": "渓谷へは、歩いてすぐです。"}, {"type": "subtitle", "time": 12753.269, "timestamp": "03:32:33", "text": "ジンジョは最も安全な場所です。さあ行こう。"}, {"type": "subtitle", "time": 12755.67, "timestamp": "03:32:35", "text": "共鳴の接点はカバレッジを提供する。"}, {"type": "subtitle", "time": 12758.15, "timestamp": "03:32:38", "text": "これが新しいGinchinのアップデートです。 A"}, {"type": "subtitle", "time": 12760.389, "timestamp": "03:32:40", "text": "保護バリアとして強力です。"}, {"type": "subtitle", "time": 12763.91, "timestamp": "03:32:43", "text": "原神2.0。"}, {"type": "subtitle", "time": 12766.389, "timestamp": "03:32:46", "text": "うん。"}, {"type": "subtitle", "time": 12768.79, "timestamp": "03:32:48", "text": "ジンジョは砂漠の高地と砂漠の高地の間に位置している。"}, {"type": "subtitle", "time": 12771.269, "timestamp": "03:32:51", "text": "そして、ノーラルの荒地。それは"}, {"type": "subtitle", "time": 12773.91, "timestamp": "03:32:53", "text": "都市であり、要塞でもある。それは非常に重要である"}, {"type": "subtitle", "time": 12776.55, "timestamp": "03:32:56", "text": "安全のために"}, {"type": "subtitle", "time": 12779.349, "timestamp": "03:32:59", "text": "はぁ？私たちはバイと会うことに同意しました"}]
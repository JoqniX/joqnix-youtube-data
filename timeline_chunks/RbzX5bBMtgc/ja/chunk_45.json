[{"type": "subtitle", "time": 2719.27, "timestamp": "00:45:19", "text": "スパイダー。おお。くそ。"}, {"type": "subtitle", "time": 2733.589, "timestamp": "00:45:33", "text": "君が遅れをとっていたのは当然だ。"}, {"type": "subtitle", "time": 2735.51, "timestamp": "00:45:35", "text": "これが我々の限界だ。私たちは戻ってきます"}, {"type": "subtitle", "time": 2746.47, "timestamp": "00:45:46", "text": "彼女は本当にクールだ。"}, {"type": "subtitle", "time": 2755.75, "timestamp": "00:45:55", "text": "速報。美術品泥棒は"}, {"type": "subtitle", "time": 2757.589, "timestamp": "00:45:57", "text": "裁きを受けた。すべての商品は"}, {"type": "subtitle", "time": 2759.51, "timestamp": "00:45:59", "text": "戻ってきた。"}]
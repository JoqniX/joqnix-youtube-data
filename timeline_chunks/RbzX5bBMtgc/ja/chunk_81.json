[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "コンボ。作る方法はたくさんあります"}, {"type": "subtitle", "time": 4864.149, "timestamp": "01:21:04", "text": "ゴキブリは関係ない。だから、私は本当にできません"}, {"type": "subtitle", "time": 4866.229, "timestamp": "01:21:06", "text": "彼女に6点以上を与えることを正当化する"}, {"type": "subtitle", "time": 4868.47, "timestamp": "01:21:08", "text": "10点満点中。そして最後のキャラクター"}, {"type": "subtitle", "time": 4870.87, "timestamp": "01:21:10", "text": "これから話すのは、私たちの兄弟のことです"}, {"type": "subtitle", "time": 4873.27, "timestamp": "01:21:13", "text": "ブラントは、"}, {"type": "subtitle", "time": 4875.43, "timestamp": "01:21:15", "text": "ゲーム全体で一番面白いキャラクター。"}, {"type": "subtitle", "time": 4878.149, "timestamp": "01:21:18", "text": "もしあなたが私に同意しないなら、あなたは間違っています。"}, {"type": "subtitle", "time": 4879.99, "timestamp": "01:21:19", "text": "さて、ブラントは信じられないほど面白い"}, {"type": "subtitle", "time": 4881.99, "timestamp": "01:21:21", "text": "キャラクターは多くの人が"}, {"type": "subtitle", "time": 4883.75, "timestamp": "01:21:23", "text": "膨大な量ゆえに、彼の価値は"}, {"type": "subtitle", "time": 4886.149, "timestamp": "01:21:26", "text": "彼がすることについて。ああ、見て"}, {"type": "subtitle", "time": 4888.709, "timestamp": "01:21:28", "text": "彼。真実。ブラントは"}, {"type": "subtitle", "time": 4891.43, "timestamp": "01:21:31", "text": "メインDPSであること。彼は緩衝材になることができる"}, {"type": "subtitle", "time": 4894.07, "timestamp": "01:21:34", "text": "融合か、それともスキルか。うわー、彼はドラゴンを持っているか"}, {"type": "subtitle", "time": 4895.75, "timestamp": "01:21:35", "text": "何か。パーティーメンバーを回復させ、シールドで守る"}, {"type": "subtitle", "time": 4904.39, "timestamp": "01:21:44", "text": "彼が飛ぶ様子を見てごらん。"}, {"type": "subtitle", "time": 4906.59, "timestamp": "01:21:46", "text": "しかし"}, {"type": "subtitle", "time": 4909.83, "timestamp": "01:21:49", "text": "バージョン2.0。 2 つのフュージョン DPS、そのうちの 1 つは"}, {"type": "subtitle", "time": 4912.79, "timestamp": "01:21:52", "text": "サヌアを運営することを好む。私を誤解しないでください"}, {"type": "subtitle", "time": 4915.27, "timestamp": "01:21:55", "text": "間違いです、ブレントは間違いなく素晴らしい"}, {"type": "subtitle", "time": 4916.87, "timestamp": "01:21:56", "text": "彼をプレイしているときのキャラクター"}, {"type": "subtitle", "time": 4919.27, "timestamp": "01:21:59", "text": "チャムリ。そして彼はチャムリーにもなれる"}]
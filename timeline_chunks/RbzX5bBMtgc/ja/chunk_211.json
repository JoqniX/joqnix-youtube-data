[{"type": "subtitle", "time": 12660.95, "timestamp": "03:31:00", "text": "自分の排泄物を見るのは自分の役目だ。そういえば、"}, {"type": "subtitle", "time": 12663.349, "timestamp": "03:31:03", "text": "もうすぐだ。宝箱がある。"}, {"type": "subtitle", "time": 12665.67, "timestamp": "03:31:05", "text": "Baと会うと言った。彼女は"}, {"type": "subtitle", "time": 12667.99, "timestamp": "03:31:07", "text": "共振器。すべての植物を集めてください。なぜ"}, {"type": "subtitle", "time": 12669.59, "timestamp": "03:31:09", "text": "ない？私は彼女の共鳴に対処できる"}, {"type": "subtitle", "time": 12671.83, "timestamp": "03:31:11", "text": "能力と私たちは一緒にあなたを見つけました"}, {"type": "subtitle", "time": 12674.309, "timestamp": "03:31:14", "text": "峡谷の底。白は最初に"}, {"type": "subtitle", "time": 12677.429, "timestamp": "03:31:17", "text": "あなたへの支援。あなたは溺れたようですね。"}, {"type": "subtitle", "time": 12680.79, "timestamp": "03:31:20", "text": "しかし、気道は確保されていました。ほら、"}, {"type": "subtitle", "time": 12683.99, "timestamp": "03:31:23", "text": "あそこに共鳴ビーコンがある。あなたが"}, {"type": "subtitle", "time": 12686.15, "timestamp": "03:31:26", "text": "ビーコンを見かけたら、必ず登録して"}, {"type": "subtitle", "time": 12688.63, "timestamp": "03:31:28", "text": "有効化してください。通常は安全です。"}, {"type": "subtitle", "time": 12690.95, "timestamp": "03:31:30", "text": "ここに宝箱があります。ビーコン。それ"}, {"type": "subtitle", "time": 12693.11, "timestamp": "03:31:33", "text": "時には危険からあなたを守ってくれるかもしれません。"}, {"type": "subtitle", "time": 12695.269, "timestamp": "03:31:35", "text": "ボバーさん、端末を渡していただけますか？"}, {"type": "subtitle", "time": 12696.75, "timestamp": "03:31:36", "text": "のために"}, {"type": "subtitle", "time": 12700.229, "timestamp": "03:31:40", "text": "一瞬？終わり。その設計とシステム"}, {"type": "subtitle", "time": 12702.87, "timestamp": "03:31:42", "text": "バージョンは私たちのものとは異なりますが、"}, {"type": "subtitle", "time": 12704.87, "timestamp": "03:31:44", "text": "端末にはまだデータが残っています"}, {"type": "subtitle", "time": 12713.63, "timestamp": "03:31:53", "text": "ターミナル。ああ、これがテレポートですか"}, {"type": "subtitle", "time": 12719.89, "timestamp": "03:31:59", "text": "わかった。いいね、いいね、いいね、いいね、"}]
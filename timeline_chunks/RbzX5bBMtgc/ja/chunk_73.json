[{"type": "subtitle", "time": 4401.75, "timestamp": "01:13:21", "text": "2番。はい、ただいま。私の父"}, {"type": "subtitle", "time": 4404.79, "timestamp": "01:13:24", "text": "電話がかかってきた。彼は家の中で激怒している。私はbが欲しい"}, {"type": "subtitle", "time": 4406.95, "timestamp": "01:13:26", "text": "吟遊詩人の女性が欲しい。赤が好きだから。"}, {"type": "subtitle", "time": 4409.07, "timestamp": "01:13:29", "text": "主要キャラクター。"}, {"type": "subtitle", "time": 4412.669, "timestamp": "01:13:32", "text": "私の弱点は赤毛の女性です。"}, {"type": "subtitle", "time": 4417.07, "timestamp": "01:13:37", "text": "だから私は彼女を"}, {"type": "subtitle", "time": 4419.95, "timestamp": "01:13:39", "text": "良い。"}, {"type": "subtitle", "time": 4423.189, "timestamp": "01:13:43", "text": "アハナ、私、すごく混乱してるの。何をすべきか"}, {"type": "subtitle", "time": 4434.84, "timestamp": "01:13:54", "text": "何をすべきか する？私は貯金できる"}]
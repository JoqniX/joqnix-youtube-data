[{"type": "subtitle", "time": 21001.91, "timestamp": "05:50:01", "text": "あなたが配信を始めた時からですよね？彼は戻ってきた"}, {"type": "subtitle", "time": 21004.628, "timestamp": "05:50:04", "text": "ストリーミング配信へ。それで、それで、あなたの"}, {"type": "subtitle", "time": 21013.51, "timestamp": "05:50:13", "text": "良い。無駄にできる時間はない。"}, {"type": "subtitle", "time": 21015.52, "timestamp": "05:50:15", "text": "楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 21024.31, "timestamp": "05:50:24", "text": "[音楽]"}, {"type": "subtitle", "time": 21028.07, "timestamp": "05:50:28", "text": "良い。無駄にできる時間はない。"}, {"type": "subtitle", "time": 21049.868, "timestamp": "05:50:49", "text": "私はスキップします"}, {"type": "subtitle", "time": 21051.708, "timestamp": "05:50:51", "text": "ボタン留め"}, {"type": "subtitle", "time": 21054.43, "timestamp": "05:50:54", "text": "すべて。無駄にしたくない"}, {"type": "subtitle", "time": 21057.59, "timestamp": "05:50:57", "text": "時間。眠る必要がある。目を覚まさなきゃ"}]
[{"type": "subtitle", "time": 27841.628, "timestamp": "07:44:01", "text": "ショット。私たちは彼らを殺すことができる"}, {"type": "subtitle", "time": 27851.91, "timestamp": "07:44:11", "text": "良い。すべての物語が終わったら、"}, {"type": "subtitle", "time": 27853.83, "timestamp": "07:44:13", "text": "右？それから私はすべての"}, {"type": "subtitle", "time": 27856.468, "timestamp": "07:44:16", "text": "これらと、その他すべてに星3つ。わかった。私"}, {"type": "subtitle", "time": 27859.35, "timestamp": "07:44:19", "text": "できないものもあることは分かっています"}, {"type": "subtitle", "time": 27861.75, "timestamp": "07:44:21", "text": "この3つ星のようなものと、"}, {"type": "subtitle", "time": 27863.388, "timestamp": "07:44:23", "text": "物語。そうします"}]
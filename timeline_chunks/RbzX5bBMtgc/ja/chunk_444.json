[{"type": "subtitle", "time": 26640.708, "timestamp": "07:24:00", "text": "今日は何日でしたっけ？ええ、ただ"}, {"type": "subtitle", "time": 26644.75, "timestamp": "07:24:04", "text": "終了した。私はBを持っていた"}, {"type": "subtitle", "time": 26647.51, "timestamp": "07:24:07", "text": "ストリーム。また配信を始めました。何てことだ。"}, {"type": "subtitle", "time": 26662.23, "timestamp": "07:24:22", "text": "信じる？ああ、またやるよ。だから私は"}, {"type": "subtitle", "time": 26665.19, "timestamp": "07:24:25", "text": "香港でイベント関係の仕事をしていました。それで、"}, {"type": "subtitle", "time": 26666.948, "timestamp": "07:24:26", "text": "今日はホンをプレイします"}, {"type": "subtitle", "time": 26668.11, "timestamp": "07:24:28", "text": "コングパック"}, {"type": "subtitle", "time": 26671.51, "timestamp": "07:24:31", "text": "3 そしてタイトルで気づいたのですが"}, {"type": "subtitle", "time": 26674.31, "timestamp": "07:24:34", "text": "名前をホンガイパッドに更新するのを忘れていました"}, {"type": "subtitle", "time": 26678.07, "timestamp": "07:24:38", "text": "3. それで、私は今それを直しました"}, {"type": "subtitle", "time": 26681.23, "timestamp": "07:24:41", "text": "また、プレイリスト名も"}, {"type": "subtitle", "time": 26685.07, "timestamp": "07:24:45", "text": "良い。バカバカしいミスがあった"}, {"type": "subtitle", "time": 26691.23, "timestamp": "07:24:51", "text": "でも、今直したよ"}, {"type": "subtitle", "time": 26696.27, "timestamp": "07:24:56", "text": "はい、わかりました。こんにちは、そして私は確認しました"}]
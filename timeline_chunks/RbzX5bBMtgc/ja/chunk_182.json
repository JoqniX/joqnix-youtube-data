[{"type": "subtitle", "time": 10931.309, "timestamp": "03:02:11", "text": "私はそれを食べなければならなかった"}, {"type": "subtitle", "time": 10937.2, "timestamp": "03:02:17", "text": "ガム。シャングリークエストをクリアする必要がある。"}, {"type": "subtitle", "time": 10969.429, "timestamp": "03:02:49", "text": "あの美しい女性を見て。"}, {"type": "subtitle", "time": 10970.75, "timestamp": "03:02:50", "text": "私は欲しい"}, {"type": "subtitle", "time": 10974.99, "timestamp": "03:02:54", "text": "見せる。私は"}, {"type": "subtitle", "time": 10977.63, "timestamp": "03:02:57", "text": "の"}]
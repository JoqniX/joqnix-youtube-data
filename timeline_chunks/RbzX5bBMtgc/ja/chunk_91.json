[{"type": "subtitle", "time": 5470.83, "timestamp": "01:31:10", "text": "広告。わかった。 PBSは調整されます"}, {"type": "subtitle", "time": 5476.59, "timestamp": "01:31:16", "text": "SS、兄弟。広告の量。私のPCは"}, {"type": "subtitle", "time": 5479.35, "timestamp": "01:31:19", "text": "もがく。なぜそれがPALなのか"}, {"type": "subtitle", "time": 5490.83, "timestamp": "01:31:30", "text": "すでに知っていた"}, {"type": "subtitle", "time": 5494.31, "timestamp": "01:31:34", "text": "SSランクのキャラクターを1体入手しました。あれはショークだ"}, {"type": "subtitle", "time": 5495.34, "timestamp": "01:31:35", "text": "キーパーは"}, {"type": "subtitle", "time": 5498.59, "timestamp": "01:31:38", "text": "[音楽]"}, {"type": "subtitle", "time": 5506.75, "timestamp": "01:31:46", "text": "Sの？"}, {"type": "subtitle", "time": 5512.189, "timestamp": "01:31:52", "text": "A なぜ Yin Yin は SS として使われていたのですか？なぜ"}]
[{"type": "subtitle", "time": 10801.63, "timestamp": "03:00:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10804.99, "timestamp": "03:00:04", "text": "もの。アリーナ シッタ。これ"}, {"type": "subtitle", "time": 10808.63, "timestamp": "03:00:08", "text": "その一部を置く。たくさん見てください"}, {"type": "subtitle", "time": 10811.51, "timestamp": "03:00:11", "text": "探査。俺は死ぬんだ、兄弟。私は"}, {"type": "subtitle", "time": 10815.71, "timestamp": "03:00:15", "text": "死ぬだろう。私は"}, {"type": "subtitle", "time": 10819.19, "timestamp": "03:00:19", "text": "死ぬ。探検したら死ぬだろう"}, {"type": "subtitle", "time": 10820.75, "timestamp": "03:00:20", "text": "全体"}, {"type": "subtitle", "time": 10823.51, "timestamp": "03:00:23", "text": "地図。だから、探索して"}, {"type": "subtitle", "time": 10829.15, "timestamp": "03:00:29", "text": "全てを終わらせる。 100％の数字と"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "もの。他に何か？この薄暗い森"}, {"type": "subtitle", "time": 10836.79, "timestamp": "03:00:36", "text": "などなど、そうですよね？これらのエリアの100％"}]
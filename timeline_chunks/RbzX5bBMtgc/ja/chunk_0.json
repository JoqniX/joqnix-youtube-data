[{"type": "subtitle", "time": 6.71, "timestamp": "00:00:06", "text": "ジャカソン52日目へようこそ！"}, {"type": "subtitle", "time": 12.509, "timestamp": "00:00:12", "text": "ストリーム。いらっしゃいませ"}, {"type": "subtitle", "time": 20.87, "timestamp": "00:00:20", "text": "生きている？ライブ配信中です。こんにちは。ようこそ"}, {"type": "subtitle", "time": 23.91, "timestamp": "00:00:23", "text": "ジョアトン52日目パート2の配信。の"}, {"type": "subtitle", "time": 27.91, "timestamp": "00:00:27", "text": "夜の小川。今夜私たちは"}, {"type": "subtitle", "time": 30.23, "timestamp": "00:00:30", "text": "ウィザリング・リープスをプレイ中。そして私たちはただ"}, {"type": "subtitle", "time": 32.51, "timestamp": "00:00:32", "text": "最後の方に少し時間を過ごそうと思っています。"}, {"type": "subtitle", "time": 34.79, "timestamp": "00:00:34", "text": "わかった？そして私は早く寝るつもりです"}, {"type": "subtitle", "time": 37.35, "timestamp": "00:00:37", "text": "明日はコラボデーだから。私たちは"}, {"type": "subtitle", "time": 39.83, "timestamp": "00:00:39", "text": "2つのコラボレーション。俺たちは地獄を手に入れた"}, {"type": "subtitle", "time": 42.47, "timestamp": "00:00:42", "text": "ダイビングヘルダイバーズがveとweとコラボレーション"}, {"type": "subtitle", "time": 44.709, "timestamp": "00:00:44", "text": "森のコラボでたくさんのカップルとコラボしました"}, {"type": "subtitle", "time": 48.029, "timestamp": "00:00:48", "text": "友人たち。だから私はワクワクしています"}, {"type": "subtitle", "time": 51.95, "timestamp": "00:00:51", "text": "それ。私たちに"}]
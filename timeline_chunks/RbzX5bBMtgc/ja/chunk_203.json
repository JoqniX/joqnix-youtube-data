[{"type": "subtitle", "time": 12180.91, "timestamp": "03:23:00", "text": "モーションブラー。ところで、それは"}, {"type": "subtitle", "time": 12185.03, "timestamp": "03:23:05", "text": "それ。水平方向の図。えっと、私のテキストボックスは"}, {"type": "subtitle", "time": 12188.83, "timestamp": "03:23:08", "text": "英語。ああ、言語を変更できますか？"}, {"type": "subtitle", "time": 12193.269, "timestamp": "03:23:13", "text": "中国人？待って、ダウンロードしないといけない。"}, {"type": "subtitle", "time": 12199.71, "timestamp": "03:23:19", "text": "ダウンロードする必要がある"}, {"type": "subtitle", "time": 12202.11, "timestamp": "03:23:22", "text": "332.24メガピクセル。"}, {"type": "subtitle", "time": 12211.229, "timestamp": "03:23:31", "text": "ああ、ドナルドのために今すぐ置いておけますよ。"}, {"type": "subtitle", "time": 12217.469, "timestamp": "03:23:37", "text": "おお。"}, {"type": "subtitle", "time": 12221.91, "timestamp": "03:23:41", "text": "ダウンロードですか？いいえ、私は"}, {"type": "subtitle", "time": 12224.55, "timestamp": "03:23:44", "text": "メニューが開きました。でも大丈夫。演奏します"}, {"type": "subtitle", "time": 12228.26, "timestamp": "03:23:48", "text": "今のところは英語で。わかった。"}]
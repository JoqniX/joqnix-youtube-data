[{"type": "subtitle", "time": 13744.11, "timestamp": "03:49:04", "text": "村"}, {"type": "subtitle", "time": 13749.08, "timestamp": "03:49:09", "text": "いいえ、私はどこかへ行かなければなりません。"}, {"type": "subtitle", "time": 13752.269, "timestamp": "03:49:12", "text": "[音楽]"}, {"type": "subtitle", "time": 13755.59, "timestamp": "03:49:15", "text": "わかった。どうぞお持ちください。彼らがそうしてくれることを願います"}, {"type": "subtitle", "time": 13757.15, "timestamp": "03:49:17", "text": "証明する"}, {"type": "subtitle", "time": 13761.67, "timestamp": "03:49:21", "text": "役に立つ。そこには"}, {"type": "subtitle", "time": 13764.229, "timestamp": "03:49:24", "text": "読んだ後、携帯電話に入れました"}, {"type": "subtitle", "time": 13779.55, "timestamp": "03:49:39", "text": "[音楽]"}, {"type": "subtitle", "time": 13783.349, "timestamp": "03:49:43", "text": "早く、これは何ですか？"}, {"type": "subtitle", "time": 13785.91, "timestamp": "03:49:45", "text": "うわぁ。何か見つかりましたか？私は見つけた"}, {"type": "subtitle", "time": 13787.15, "timestamp": "03:49:47", "text": "一部乾燥"}, {"type": "subtitle", "time": 13791.429, "timestamp": "03:49:51", "text": "配給品。手入れが行き届いているようだ。ああ、それは"}, {"type": "subtitle", "time": 13794.389, "timestamp": "03:49:54", "text": "ビット あなたはこれらを手に入れることができます。感謝"}, {"type": "subtitle", "time": 13797.58, "timestamp": "03:49:57", "text": "あなた。何も食べない"}]
[{"type": "subtitle", "time": 1561.789, "timestamp": "00:26:01", "text": "ブレット。あれを見てください。彼女のキットは"}, {"type": "subtitle", "time": 1571.99, "timestamp": "00:26:11", "text": "いいね。ああ、これは私が"}, {"type": "subtitle", "time": 1573.95, "timestamp": "00:26:13", "text": "欲しい？ゼリーを押し出す"}, {"type": "subtitle", "time": 1577.23, "timestamp": "00:26:17", "text": "レディ。彼女が"}, {"type": "subtitle", "time": 1579.95, "timestamp": "00:26:19", "text": "遊ぶ。これは誰ですか"}, {"type": "subtitle", "time": 1585.149, "timestamp": "00:26:25", "text": "男？たくさんの新しいキャラクターが登場しました。"}, {"type": "subtitle", "time": 1588.64, "timestamp": "00:26:28", "text": "ああ、返送品だ。"}, {"type": "subtitle", "time": 1594.23, "timestamp": "00:26:34", "text": "[音楽]"}, {"type": "subtitle", "time": 1595.99, "timestamp": "00:26:35", "text": "もっと笑顔を心がけるべきだな。そこには"}, {"type": "subtitle", "time": 1601.19, "timestamp": "00:26:41", "text": "何か具体的なことを祈ってもいいですか？おお。"}, {"type": "subtitle", "time": 1602.37, "timestamp": "00:26:42", "text": "足があります"}, {"type": "subtitle", "time": 1604.99, "timestamp": "00:26:44", "text": "[音楽]"}, {"type": "subtitle", "time": 1606.45, "timestamp": "00:26:46", "text": "彼女。"}, {"type": "subtitle", "time": 1611.19, "timestamp": "00:26:51", "text": "えっと"}]
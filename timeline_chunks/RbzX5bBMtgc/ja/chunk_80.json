[{"type": "subtitle", "time": 4801.99, "timestamp": "01:20:01", "text": "スアと競争しようとしている。そしてその間"}, {"type": "subtitle", "time": 4804.63, "timestamp": "01:20:04", "text": "カメリアチーム、彼女は勝つ、あなたは"}, {"type": "subtitle", "time": 4808.149, "timestamp": "01:20:08", "text": "70本のポールを使う予定"}, {"type": "subtitle", "time": 4810.709, "timestamp": "01:20:10", "text": "5%のダメージアップグレードを取得するには"}, {"type": "subtitle", "time": 4812.79, "timestamp": "01:20:12", "text": "チャメリア？そしてそれはあなたの"}, {"type": "subtitle", "time": 4815.59, "timestamp": "01:20:15", "text": "ローチアは彼女の得意武器を使っている。それで"}, {"type": "subtitle", "time": 4817.669, "timestamp": "01:20:17", "text": "良い。それは価値がないと思う"}, {"type": "subtitle", "time": 4820.229, "timestamp": "01:20:20", "text": "全て。だから正直に言うと、ロチアは"}, {"type": "subtitle", "time": 4823.59, "timestamp": "01:20:23", "text": "彼女を見て。私は、私は利点が欲しいと思います"}, {"type": "subtitle", "time": 4825.59, "timestamp": "01:20:25", "text": "アカウントに確実にローチがいるように"}, {"type": "subtitle", "time": 4827.99, "timestamp": "01:20:27", "text": "彼女が泣き言を言うのは"}, {"type": "subtitle", "time": 4831.03, "timestamp": "01:20:31", "text": "全くの冗談だ。泣き叫ぶ荒野は"}, {"type": "subtitle", "time": 4832.55, "timestamp": "01:20:32", "text": "多くの人が苦戦するゲームモード"}, {"type": "subtitle", "time": 4834.149, "timestamp": "01:20:34", "text": "なぜなら、彼らは"}, {"type": "subtitle", "time": 4836.709, "timestamp": "01:20:36", "text": "範囲攻撃。しかしロキアは最高のグループ分けをしている"}, {"type": "subtitle", "time": 4838.87, "timestamp": "01:20:38", "text": "ゲーム全体を通して、すすり泣きが"}, {"type": "subtitle", "time": 4841.51, "timestamp": "01:20:41", "text": "彼女の最大の活用事例を無駄にしている。私はただ"}, {"type": "subtitle", "time": 4843.83, "timestamp": "01:20:43", "text": "この件の主な問題はあなただと思います"}, {"type": "subtitle", "time": 4846.39, "timestamp": "01:20:46", "text": "代わりにカメリアを引くこともできる"}, {"type": "subtitle", "time": 4849.35, "timestamp": "01:20:49", "text": "ロアチアのAoEを完全に殲滅する"}, {"type": "subtitle", "time": 4851.43, "timestamp": "01:20:51", "text": "コンテンツ。そして、すでに持っている場合は"}, {"type": "subtitle", "time": 4853.99, "timestamp": "01:20:53", "text": "チャメリア、GN を引っ張れば"}, {"type": "subtitle", "time": 4855.669, "timestamp": "01:20:55", "text": "完全に破壊するだろう"}, {"type": "subtitle", "time": 4858.31, "timestamp": "01:20:58", "text": "泣き言を言うか、[ __ ]・グラントを手に入れる"}]
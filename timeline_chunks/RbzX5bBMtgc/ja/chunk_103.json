[{"type": "subtitle", "time": 6186.36, "timestamp": "01:43:06", "text": "組合に加入する60。"}, {"type": "subtitle", "time": 6198.87, "timestamp": "01:43:18", "text": "聖なる。変わった花と"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "私は、私は演奏しなければならないような気がします"}, {"type": "subtitle", "time": 6215.91, "timestamp": "01:43:35", "text": "このゲームは今ではとても"}, {"type": "subtitle", "time": 6218.149, "timestamp": "01:43:38", "text": "やるべきことが山積みだ。だから、たくさん期待できます"}, {"type": "subtitle", "time": 6220.709, "timestamp": "01:43:40", "text": "私から枯れゆく波の流れが流れ出る、わかった、"}, {"type": "subtitle", "time": 6222.59, "timestamp": "01:43:42", "text": "のために"}, {"type": "subtitle", "time": 6226.31, "timestamp": "01:43:46", "text": "週。くそ。つまり、私は24時間ストリーミング配信しているんです"}, {"type": "subtitle", "time": 6233.629, "timestamp": "01:43:53", "text": "明日の朝は"}]
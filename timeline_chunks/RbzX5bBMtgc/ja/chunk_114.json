[{"type": "subtitle", "time": 6850.87, "timestamp": "01:54:10", "text": "今、獲物は誰だ？"}, {"type": "subtitle", "time": 6853.83, "timestamp": "01:54:13", "text": "牙を解き放て。根絶せよ。そのままにしておいて"}, {"type": "subtitle", "time": 6868.55, "timestamp": "01:54:28", "text": "ロード中。ザニ。ザニではない。つまり、えっと"}, {"type": "subtitle", "time": 6874.55, "timestamp": "01:54:34", "text": "良い。無駄にできる時間はない。カニ。私"}, {"type": "subtitle", "time": 6877.109, "timestamp": "01:54:37", "text": "これを見るのは初めてだと思う。"}, {"type": "subtitle", "time": 6879.109, "timestamp": "01:54:39", "text": "ああ、ダイヤモンド版はもう手に入れました。"}, {"type": "subtitle", "time": 6896.79, "timestamp": "01:54:56", "text": "私はこれらの課題をすべて終わらせるべきだ"}]
[{"type": "subtitle", "time": 4983.11, "timestamp": "01:23:03", "text": "基本上，没有它比……更糟糕。"}, {"type": "subtitle", "time": 4985.75, "timestamp": "01:23:05", "text": "损失20%的伤害。而且这是假设"}, {"type": "subtitle", "time": 4988.229, "timestamp": "01:23:08", "text": "你的老虎机性能排名第二。他是"}, {"type": "subtitle", "time": 4990.55, "timestamp": "01:23:10", "text": "迄今为止最依赖签名的"}, {"type": "subtitle", "time": 4993.189, "timestamp": "01:23:13", "text": "贯穿整个游戏的角色。我"}, {"type": "subtitle", "time": 4995.189, "timestamp": "01:23:15", "text": "别以为除了阴国以外还有谁会这么想。"}, {"type": "subtitle", "time": 4997.75, "timestamp": "01:23:17", "text": "在这方面，他非常接近。但即便"}, {"type": "subtitle", "time": 5000.07, "timestamp": "01:23:20", "text": "尽管如此，我认为布兰特是个好人。"}, {"type": "subtitle", "time": 5003.189, "timestamp": "01:23:23", "text": "民意调查结果为7.5分（满分10分）。那么，你是谁？"}, {"type": "subtitle", "time": 5005.03, "timestamp": "01:23:25", "text": "下半场会拉开差距"}, {"type": "subtitle", "time": 5008.149, "timestamp": "01:23:28", "text": "《凋零之波》2.3？我的眼睛"}, {"type": "subtitle", "time": 5010.87, "timestamp": "01:23:30", "text": "在 Chicona 上，因为我是 Phoebe 主菜。全部"}, {"type": "subtitle", "time": 5012.31, "timestamp": "01:23:32", "text": "我已有的其他角色，"}, {"type": "subtitle", "time": 5013.83, "timestamp": "01:23:33", "text": "除了罗阿奇亚，她其实并不怎么……"}, {"type": "subtitle", "time": 5015.59, "timestamp": "01:23:35", "text": "我对此感兴趣，但请告诉我。"}, {"type": "subtitle", "time": 5017.11, "timestamp": "01:23:37", "text": "请在下方留言。当你情绪低落的时候"}, {"type": "subtitle", "time": 5018.55, "timestamp": "01:23:38", "text": "别忘了点赞视频哦！"}, {"type": "subtitle", "time": 5020.31, "timestamp": "01:23:40", "text": "订阅频道。如果你有"}, {"type": "subtitle", "time": 5022.31, "timestamp": "01:23:42", "text": "如有任何疑问，请务必加入我的群组。"}, {"type": "subtitle", "time": 5024.149, "timestamp": "01:23:44", "text": "Discord。我在那里相当活跃，所以"}, {"type": "subtitle", "time": 5025.75, "timestamp": "01:23:45", "text": "如果你提出你的问题，就会有……"}, {"type": "subtitle", "time": 5027.35, "timestamp": "01:23:47", "text": "我很有可能会回复。"}]
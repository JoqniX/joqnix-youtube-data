[{"type": "subtitle", "time": 23640.03, "timestamp": "06:34:00", "text": "里面有虫子，我差点就吃了。"}, {"type": "subtitle", "time": 23649.27, "timestamp": "06:34:09", "text": "是的。生活不是泰国的工作。生活"}, {"type": "subtitle", "time": 23655.51, "timestamp": "06:34:15", "text": "全部。我在哪里被发现的？它离……很近"}, {"type": "subtitle", "time": 23667.83, "timestamp": "06:34:27", "text": "嗯……它叫什么？无处可藏。"}, {"type": "subtitle", "time": 23683.51, "timestamp": "06:34:43", "text": "事物。我很抱歉。我当时有点分心。"}, {"type": "subtitle", "time": 23687.59, "timestamp": "06:34:47", "text": "我的天哪。好的。那是我呃……"}, {"type": "subtitle", "time": 23690.39, "timestamp": "06:34:50", "text": "我有一张L型桌子。好的。"}, {"type": "subtitle", "time": 23695.19, "timestamp": "06:34:55", "text": "它真的是L。所以它真的是在……"}, {"type": "subtitle", "time": 23698.43, "timestamp": "06:34:58", "text": "在延长线和"}]
[{"type": "subtitle", "time": 6240.229, "timestamp": "01:44:00", "text": "实际上每天都有两个工会级别"}, {"type": "subtitle", "time": 6251.229, "timestamp": "01:44:11", "text": "嗯？技能"}, {"type": "subtitle", "time": 6253.149, "timestamp": "01:44:13", "text": "训练。"}, {"type": "subtitle", "time": 6261.189, "timestamp": "01:44:21", "text": "这场镀金噩梦究竟完成了什么"}, {"type": "subtitle", "time": 6263.35, "timestamp": "01:44:23", "text": "赚取夜市代币，这些代币将是"}, {"type": "subtitle", "time": 6267.07, "timestamp": "01:44:27", "text": "换成了“好的”。这是"}, {"type": "subtitle", "time": 6269.95, "timestamp": "01:44:29", "text": "武器？这是"}, {"type": "subtitle", "time": 6272.75, "timestamp": "01:44:32", "text": "武器？这些是类似的吗？"}, {"type": "subtitle", "time": 6274.51, "timestamp": "01:44:34", "text": "武器？"}, {"type": "subtitle", "time": 6279.709, "timestamp": "01:44:39", "text": "幻影洛雷娜欧莱雅。不是欧莱雅。"}, {"type": "subtitle", "time": 6288.229, "timestamp": "01:44:48", "text": "欧莱雅。好的。好的。嗯哼。呃，我们需要"}, {"type": "subtitle", "time": 6292.75, "timestamp": "01:44:52", "text": "一次探险。那是一款武器皮肤。"}, {"type": "subtitle", "time": 6297.91, "timestamp": "01:44:57", "text": "啊，好多任务啊。探索。探索。"}]
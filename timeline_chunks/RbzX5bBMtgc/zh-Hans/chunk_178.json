[{"type": "subtitle", "time": 10692.23, "timestamp": "02:58:12", "text": "[音乐]"}, {"type": "subtitle", "time": 10695.67, "timestamp": "02:58:15", "text": "发生了什么事？嗯？那是什么？"}, {"type": "subtitle", "time": 10701.91, "timestamp": "02:58:21", "text": "[音乐]"}, {"type": "subtitle", "time": 10705.83, "timestamp": "02:58:25", "text": "请看洪森的完整照片，就在旁边"}, {"type": "subtitle", "time": 10710.71, "timestamp": "02:58:30", "text": "一枚戒指和一串项链。我懂了。我明白了。"}, {"type": "subtitle", "time": 10713.429, "timestamp": "02:58:33", "text": "我一点头绪都没有。他就像我"}, {"type": "subtitle", "time": 10716.55, "timestamp": "02:58:36", "text": "我喜欢宝可梦。我明白最后一部分的意思。"}, {"type": "subtitle", "time": 10717.23, "timestamp": "02:58:37", "text": "的"}, {"type": "subtitle", "time": 10720.269, "timestamp": "02:58:40", "text": "李。而现在……"}, {"type": "subtitle", "time": 10723.11, "timestamp": "02:58:43", "text": "下一个。你是怎么得到所有这些的？"}, {"type": "subtitle", "time": 10725.429, "timestamp": "02:58:45", "text": "隐藏含义？"}, {"type": "subtitle", "time": 10734.309, "timestamp": "02:58:54", "text": "我跳过了对话部分。我可以"}]
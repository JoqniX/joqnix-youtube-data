[{"type": "subtitle", "time": 15961.03, "timestamp": "04:26:01", "text": "踉跄了一下。后来，她成了某人"}, {"type": "subtitle", "time": 15963.75, "timestamp": "04:26:03", "text": "别人的老师。"}, {"type": "subtitle", "time": 15967.03, "timestamp": "04:26:07", "text": "她把这一点传授给了未来的领导者。"}, {"type": "subtitle", "time": 15969.429, "timestamp": "04:26:09", "text": "引导良知，保障繁荣"}, {"type": "subtitle", "time": 15973.189, "timestamp": "04:26:13", "text": "为了让人们能够了解过去遗失的教义。"}, {"type": "subtitle", "time": 15977.51, "timestamp": "04:26:17", "text": "智者们讲述并确立故事。"}, {"type": "subtitle", "time": 15980.55, "timestamp": "04:26:20", "text": "我的天啊。将成为火炬手。为了"}, {"type": "subtitle", "time": 15983.189, "timestamp": "04:26:23", "text": "一个人无法消除世界上的混乱。"}, {"type": "subtitle", "time": 15985.83, "timestamp": "04:26:25", "text": "独自的。"}, {"type": "subtitle", "time": 15989.11, "timestamp": "04:26:29", "text": "总有一天，我们会迎来繁荣的未来。"}, {"type": "subtitle", "time": 16004.429, "timestamp": "04:26:44", "text": "[音乐]"}, {"type": "subtitle", "time": 16015.07, "timestamp": "04:26:55", "text": "好的。耶，我们完成了。"}]
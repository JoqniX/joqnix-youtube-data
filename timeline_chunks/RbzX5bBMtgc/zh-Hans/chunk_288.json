[{"type": "subtitle", "time": 17282.03, "timestamp": "04:48:02", "text": "我得到了"}, {"type": "subtitle", "time": 17285.23, "timestamp": "04:48:05", "text": "它。它向左飞去"}, {"type": "subtitle", "time": 17287.708, "timestamp": "04:48:07", "text": "边。兄弟，我当时"}, {"type": "subtitle", "time": 17289.948, "timestamp": "04:48:09", "text": "惊慌失措。字面上地"}, {"type": "subtitle", "time": 17292.91, "timestamp": "04:48:12", "text": "惊慌失措。我当时真的"}, {"type": "subtitle", "time": 17296.91, "timestamp": "04:48:16", "text": "恐慌得好像我的生命即将结束一样"}, {"type": "subtitle", "time": 17301.62, "timestamp": "04:48:21", "text": "我"}, {"type": "subtitle", "time": 17328.19, "timestamp": "04:48:48", "text": "[音乐]"}, {"type": "subtitle", "time": 17329.43, "timestamp": "04:48:49", "text": "意思是，"}]
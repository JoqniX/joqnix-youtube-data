[{"type": "subtitle", "time": 16081.469, "timestamp": "04:28:01", "text": "什么？它们为什么这么可爱"}, {"type": "subtitle", "time": 16083.87, "timestamp": "04:28:03", "text": "尽管？"}, {"type": "subtitle", "time": 16088.429, "timestamp": "04:28:08", "text": "所有人都到齐了。尚是"}, {"type": "subtitle", "time": 16108.43, "timestamp": "04:28:28", "text": "[音乐]"}, {"type": "subtitle", "time": 16110.47, "timestamp": "04:28:30", "text": "[掌声]"}, {"type": "subtitle", "time": 16117.71, "timestamp": "04:28:37", "text": "[音乐]"}, {"type": "subtitle", "time": 16120.83, "timestamp": "04:28:40", "text": "该死。是的，我们做得太棒了。"}, {"type": "subtitle", "time": 16129.56, "timestamp": "04:28:49", "text": "我有点"}]
[{"type": "subtitle", "time": 4801.99, "timestamp": "01:20:01", "text": "试图与 Sua 竞争。而当"}, {"type": "subtitle", "time": 4804.63, "timestamp": "01:20:04", "text": "如果是 Chamellia 队，她确实赢了，是吗？"}, {"type": "subtitle", "time": 4808.149, "timestamp": "01:20:08", "text": "真的打算用70根杆子"}, {"type": "subtitle", "time": 4810.709, "timestamp": "01:20:10", "text": "获得 5% 的伤害提升"}, {"type": "subtitle", "time": 4812.79, "timestamp": "01:20:12", "text": "查梅利亚？而且这还是假设你的"}, {"type": "subtitle", "time": 4815.59, "timestamp": "01:20:15", "text": "罗奇亚正在使用她的标志性武器。所以"}, {"type": "subtitle", "time": 4817.669, "timestamp": "01:20:17", "text": "好的。我觉得不值得。"}, {"type": "subtitle", "time": 4820.229, "timestamp": "01:20:20", "text": "全部。所以说实话，罗奇亚变成了"}, {"type": "subtitle", "time": 4823.59, "timestamp": "01:20:23", "text": "看看她。我想知道优势"}, {"type": "subtitle", "time": 4825.59, "timestamp": "01:20:25", "text": "肯定会在你的账户里有Roach。"}, {"type": "subtitle", "time": 4827.99, "timestamp": "01:20:27", "text": "她把呜咽声变成了浪费"}, {"type": "subtitle", "time": 4831.03, "timestamp": "01:20:31", "text": "简直是个笑话。 《呜咽的荒原》是一部"}, {"type": "subtitle", "time": 4832.55, "timestamp": "01:20:32", "text": "很多人都觉得这个游戏模式很难。"}, {"type": "subtitle", "time": 4834.149, "timestamp": "01:20:34", "text": "因为他们根本没有"}, {"type": "subtitle", "time": 4836.709, "timestamp": "01:20:36", "text": "范围攻击。但罗基亚拥有最好的分组"}, {"type": "subtitle", "time": 4838.87, "timestamp": "01:20:38", "text": "整个游戏，这让人呜咽"}, {"type": "subtitle", "time": 4841.51, "timestamp": "01:20:41", "text": "浪费了她最重要的用途。我只是"}, {"type": "subtitle", "time": 4843.83, "timestamp": "01:20:43", "text": "我认为主要问题在于你"}, {"type": "subtitle", "time": 4846.39, "timestamp": "01:20:46", "text": "也可以直接效仿夏梅莉亚的做法"}, {"type": "subtitle", "time": 4849.35, "timestamp": "01:20:49", "text": "罗奇亚彻底消灭范围攻击"}, {"type": "subtitle", "time": 4851.43, "timestamp": "01:20:51", "text": "内容。如果你已经拥有一个"}, {"type": "subtitle", "time": 4853.99, "timestamp": "01:20:53", "text": "Chamelia，你可以直接拉个GN（游戏角色）"}, {"type": "subtitle", "time": 4855.669, "timestamp": "01:20:55", "text": "也将彻底摧毁"}, {"type": "subtitle", "time": 4858.31, "timestamp": "01:20:58", "text": "哀嚎的废物，或者获得 Chong Grant"}]
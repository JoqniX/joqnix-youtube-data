[{"type": "subtitle", "time": 11834.67, "timestamp": "03:17:14", "text": "不。这是谁？"}, {"type": "subtitle", "time": 11837.91, "timestamp": "03:17:17", "text": "女士？你在干什么？"}, {"type": "subtitle", "time": 11840.67, "timestamp": "03:17:20", "text": "你是否赋予我们这种权力"}, {"type": "subtitle", "time": 11843.67, "timestamp": "03:17:23", "text": "存活？赋予我们生存的力量"}, {"type": "subtitle", "time": 11854.75, "timestamp": "03:17:34", "text": "[音乐]"}, {"type": "subtitle", "time": 11857.71, "timestamp": "03:17:37", "text": "这"}, {"type": "subtitle", "time": 11865.63, "timestamp": "03:17:45", "text": "微笑。她让你……让你"}, {"type": "subtitle", "time": 11869.389, "timestamp": "03:17:49", "text": "进入黑洞。"}, {"type": "subtitle", "time": 11872.429, "timestamp": "03:17:52", "text": "为什么？我以为你们都喜欢"}, {"type": "subtitle", "time": 11876.389, "timestamp": "03:17:56", "text": "我。我心想：等等，这是怎么回事？"}, {"type": "subtitle", "time": 11878.99, "timestamp": "03:17:58", "text": "她？她正在获得"}]
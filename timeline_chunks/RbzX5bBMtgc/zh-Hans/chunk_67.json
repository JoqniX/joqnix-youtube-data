[{"type": "subtitle", "time": 4023.109, "timestamp": "01:07:03", "text": "Yinland 和另一位，嗯，钢琴女士。"}, {"type": "subtitle", "time": 4028.63, "timestamp": "01:07:08", "text": "呃，我忘了她叫什么名字了。嗯，还有福比。"}, {"type": "subtitle", "time": 4031.39, "timestamp": "01:07:11", "text": "我必须鼓励这些人。"}, {"type": "subtitle", "time": 4033.47, "timestamp": "01:07:13", "text": "现在。哦，我的"}, {"type": "subtitle", "time": 4037.109, "timestamp": "01:07:17", "text": "天哪，真滑稽。她水平如何？我从未"}, {"type": "subtitle", "time": 4047.63, "timestamp": "01:07:27", "text": "是的，我得到了Karo Y。是的。是的，我得到了"}, {"type": "subtitle", "time": 4052.51, "timestamp": "01:07:32", "text": "她。严。是的。是的。是的。我拿到了"}, {"type": "subtitle", "time": 4056.589, "timestamp": "01:07:36", "text": "两个都。那真是太好了。我"}, {"type": "subtitle", "time": 4059.029, "timestamp": "01:07:39", "text": "看。你知道下一个是什么吗？"}, {"type": "subtitle", "time": 4063.47, "timestamp": "01:07:43", "text": "角色会登场吗？我看到了清晰的路。"}]
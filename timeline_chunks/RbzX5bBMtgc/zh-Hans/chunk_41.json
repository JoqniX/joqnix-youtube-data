[{"type": "subtitle", "time": 2460.43, "timestamp": "00:41:00", "text": "周年纪念日"}, {"type": "subtitle", "time": 2485.63, "timestamp": "00:41:25", "text": "[音乐]"}, {"type": "subtitle", "time": 2498.63, "timestamp": "00:41:38", "text": "我的天啊。我正在玩中国棋。"}, {"type": "subtitle", "time": 2513.51, "timestamp": "00:41:53", "text": "好的。哦，萨尼小姐，这很紧急。我们"}, {"type": "subtitle", "time": 2515.27, "timestamp": "00:41:55", "text": "取得领先。艺术窃贼将出手"}]
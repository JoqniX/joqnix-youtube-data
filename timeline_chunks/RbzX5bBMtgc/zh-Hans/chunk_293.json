[{"type": "subtitle", "time": 17586.628, "timestamp": "04:53:06", "text": "夜晚。晚安。 M星指引你"}, {"type": "subtitle", "time": 17588.948, "timestamp": "04:53:08", "text": "今晚祝你美梦。"}, {"type": "subtitle", "time": 17592.31, "timestamp": "04:53:12", "text": "好了，时间到了。"}, {"type": "subtitle", "time": 17610.868, "timestamp": "04:53:30", "text": "我刚刚发现我的网络延迟有 65 毫秒。"}, {"type": "subtitle", "time": 17614.83, "timestamp": "04:53:34", "text": "新加坡服务器。当我搬到日本的时候，"}, {"type": "subtitle", "time": 17618.27, "timestamp": "04:53:38", "text": "现在这个数字将会增加。"}, {"type": "subtitle", "time": 17622.23, "timestamp": "04:53:42", "text": "对吧，兄弟？原神之类的游戏也是一样。"}, {"type": "subtitle", "time": 17623.91, "timestamp": "04:53:43", "text": "也。"}, {"type": "subtitle", "time": 17625.628, "timestamp": "04:53:45", "text": "我会更高"}]
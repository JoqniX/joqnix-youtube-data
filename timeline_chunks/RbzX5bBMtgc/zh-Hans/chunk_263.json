[{"type": "subtitle", "time": 15781.59, "timestamp": "04:23:01", "text": "本身。"}, {"type": "subtitle", "time": 15785.95, "timestamp": "04:23:05", "text": "一段陪伴的时光"}, {"type": "subtitle", "time": 15790.95, "timestamp": "04:23:10", "text": "对我来说，安全感至关重要。"}, {"type": "subtitle", "time": 15792.189, "timestamp": "04:23:12", "text": "真是"}, {"type": "subtitle", "time": 15795.79, "timestamp": "04:23:15", "text": "哭。真是哭得好伤心。感受你未说出口的话"}, {"type": "subtitle", "time": 15798.95, "timestamp": "04:23:18", "text": "问题。我牺牲生命的时候……"}, {"type": "subtitle", "time": 15800.189, "timestamp": "04:23:20", "text": "烧毁了"}, {"type": "subtitle", "time": 15803.389, "timestamp": "04:23:23", "text": "就像我小时候那样的Sonarosphere"}, {"type": "subtitle", "time": 15806.95, "timestamp": "04:23:26", "text": "孩子？我当时告诉你的都是真的。"}, {"type": "subtitle", "time": 15809.349, "timestamp": "04:23:29", "text": "但我已经成长并掌握了控制权"}, {"type": "subtitle", "time": 15813.269, "timestamp": "04:23:33", "text": "我的力量。现在发挥我的特长并无坏处。"}, {"type": "subtitle", "time": 15816.149, "timestamp": "04:23:36", "text": "无论如何，我都一样。对此你可以休息了"}, {"type": "subtitle", "time": 15818.469, "timestamp": "04:23:38", "text": "保证。"}, {"type": "subtitle", "time": 15820.59, "timestamp": "04:23:40", "text": "我的天哪。"}, {"type": "subtitle", "time": 15823.99, "timestamp": "04:23:43", "text": "此外，如果你真的是那位传奇人物的话。"}, {"type": "subtitle", "time": 15826.429, "timestamp": "04:23:46", "text": "改变历史进程的人"}, {"type": "subtitle", "time": 15829.269, "timestamp": "04:23:49", "text": "如果你了解历史，那么你或许就是历史学家。"}, {"type": "subtitle", "time": 15830.51, "timestamp": "04:23:50", "text": "最靠近"}, {"type": "subtitle", "time": 15834.389, "timestamp": "04:23:54", "text": "除了我们的哨兵之外，无人能获得永生。"}, {"type": "subtitle", "time": 15838.149, "timestamp": "04:23:58", "text": "哦，我们凡人来来往往。我们的生活"}]
[{"type": "subtitle", "time": 5529.07, "timestamp": "01:32:09", "text": "咕噜作响的伤害"}, {"type": "subtitle", "time": 5533.629, "timestamp": "01:32:13", "text": "在接下来的阶段，再次在平底锅中达到 10。"}, {"type": "subtitle", "time": 5546.83, "timestamp": "01:32:26", "text": "嗯，扎尼"}, {"type": "subtitle", "time": 5564.95, "timestamp": "01:32:44", "text": "坎德拉。是的。扎尼·菲奥里·肖担任守门员。"}, {"type": "subtitle", "time": 5577.39, "timestamp": "01:32:57", "text": "漫游车。"}]
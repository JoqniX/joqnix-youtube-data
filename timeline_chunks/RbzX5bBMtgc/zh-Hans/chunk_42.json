[{"type": "subtitle", "time": 2535.109, "timestamp": "00:42:15", "text": "[音乐]"}, {"type": "subtitle", "time": 2538.23, "timestamp": "00:42:18", "text": "嘿，老大。我们一直躲藏在……"}, {"type": "subtitle", "time": 2541.47, "timestamp": "00:42:21", "text": "整天都在通风。我们的腿仍然"}, {"type": "subtitle", "time": 2544.309, "timestamp": "00:42:24", "text": "睡着了。就连牲畜的日子都好过得多。"}, {"type": "subtitle", "time": 2546.71, "timestamp": "00:42:26", "text": "比这更糟。你就不能表现出点干劲吗？"}, {"type": "subtitle", "time": 2549.51, "timestamp": "00:42:29", "text": "一次？"}, {"type": "subtitle", "time": 2559.43, "timestamp": "00:42:39", "text": "我再也受不了了。我没睡。"}, {"type": "subtitle", "time": 2562.47, "timestamp": "00:42:42", "text": "几天内就能妥善解决。就连医生也这么说"}, {"type": "subtitle", "time": 2564.71, "timestamp": "00:42:44", "text": "让我休息一下。别抱怨了，赶紧行动起来"}, {"type": "subtitle", "time": 2567.87, "timestamp": "00:42:47", "text": "工作。老板随时都会来。"}]
[{"type": "subtitle", "time": 3841.75, "timestamp": "01:04:01", "text": "没有魔法师可爱之类的东西。我想嗯……哦"}, {"type": "subtitle", "time": 3845.029, "timestamp": "01:04:05", "text": "是的，我输掉了关于查梅利亚的50/50抽奖。"}, {"type": "subtitle", "time": 3847.43, "timestamp": "01:04:07", "text": "实际上。哦，对，我记得。反而"}, {"type": "subtitle", "time": 3851.27, "timestamp": "01:04:11", "text": "我得到了Chamellia。这位女士。做"}, {"type": "subtitle", "time": 3855.15, "timestamp": "01:04:15", "text": "我最好的，少林"}, {"type": "subtitle", "time": 3857.789, "timestamp": "01:04:17", "text": "女士。我使用"}, {"type": "subtitle", "time": 3862.19, "timestamp": "01:04:22", "text": "剩下的事情就是把她从……"}, {"type": "subtitle", "time": 3865.75, "timestamp": "01:04:25", "text": "从商店购买。不，我有一个新的"}, {"type": "subtitle", "time": 3867.43, "timestamp": "01:04:27", "text": "特点。我认为当时他们"}, {"type": "subtitle", "time": 3870.549, "timestamp": "01:04:30", "text": "这样做是为了让你能从……得到她"}, {"type": "subtitle", "time": 3873.43, "timestamp": "01:04:33", "text": "这里只需支付少量费用即可。所以"}, {"type": "subtitle", "time": 3897.23, "timestamp": "01:04:57", "text": "她为什么可爱？我该拉吗？我是"}]
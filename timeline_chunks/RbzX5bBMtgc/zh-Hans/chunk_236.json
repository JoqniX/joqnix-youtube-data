[{"type": "subtitle", "time": 14172.75, "timestamp": "03:56:12", "text": "这"}, {"type": "subtitle", "time": 14180.469, "timestamp": "03:56:20", "text": "也。这些是我重现的记忆"}, {"type": "subtitle", "time": 14188.469, "timestamp": "03:56:28", "text": "当我踏入车内时，火星探测车和……"}, {"type": "subtitle", "time": 14191.309, "timestamp": "03:56:31", "text": "弗雷杜斯消失在了薄薄的……"}, {"type": "subtitle", "time": 14195.63, "timestamp": "03:56:35", "text": "空气。频率是不断变化的"}, {"type": "subtitle", "time": 14199.189, "timestamp": "03:56:39", "text": "变化。受以下因素影响的场景领域"}, {"type": "subtitle", "time": 14200.429, "timestamp": "03:56:40", "text": "颞"}, {"type": "subtitle", "time": 14204.03, "timestamp": "03:56:44", "text": "干扰。他这样做是为了误导吗？"}, {"type": "subtitle", "time": 14207.51, "timestamp": "03:56:47", "text": "我？我应该小心点。无论如何"}, {"type": "subtitle", "time": 14211.67, "timestamp": "03:56:51", "text": "案件。哦，我们要扮演她吗？"}, {"type": "subtitle", "time": 14214.13, "timestamp": "03:56:54", "text": "哦。"}]
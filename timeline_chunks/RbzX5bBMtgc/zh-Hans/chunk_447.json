[{"type": "subtitle", "time": 26820.388, "timestamp": "07:27:00", "text": "我也很期待。那么，我们开始吧"}, {"type": "subtitle", "time": 26822.51, "timestamp": "07:27:02", "text": "我们也会尽全力。好的。你好。你好。"}, {"type": "subtitle", "time": 26826.31, "timestamp": "07:27:06", "text": "你好。你好。我觉得我快完成了"}, {"type": "subtitle", "time": 26830.548, "timestamp": "07:27:10", "text": "大部分东西。我认为我的判断是正确的。你好。"}, {"type": "subtitle", "time": 26833.59, "timestamp": "07:27:13", "text": "你好。所以，这个直播的目标是达到"}, {"type": "subtitle", "time": 26836.548, "timestamp": "07:27:16", "text": "船长等级达到50级即可获得权限"}, {"type": "subtitle", "time": 26837.788, "timestamp": "07:27:17", "text": "首席空间"}, {"type": "subtitle", "time": 26841.27, "timestamp": "07:27:21", "text": "事件。我们砰砰地开枪，尽力而为"}, {"type": "subtitle", "time": 26843.31, "timestamp": "07:27:23", "text": "事件发生后立即"}, {"type": "subtitle", "time": 26847.43, "timestamp": "07:27:27", "text": "尽可能多地。和"}, {"type": "subtitle", "time": 26850.468, "timestamp": "07:27:30", "text": "不知怎么的，不知怎么的"}, {"type": "subtitle", "time": 26853.75, "timestamp": "07:27:33", "text": "呃，不知怎么的，就像，该怎么称呼呢？"}, {"type": "subtitle", "time": 26858.468, "timestamp": "07:27:38", "text": "它？是的。想方设法到达目的地"}, {"type": "subtitle", "time": 26861.948, "timestamp": "07:27:41", "text": "坚持到最后。但那是"}, {"type": "subtitle", "time": 26863.868, "timestamp": "07:27:43", "text": "功能失调的东西"}, {"type": "subtitle", "time": 26867.03, "timestamp": "07:27:47", "text": "某种功能失调的东西，呃，是什么来着？"}, {"type": "subtitle", "time": 26871.99, "timestamp": "07:27:51", "text": "再次？我的天啊。是的。呃呃，在哪儿？"}, {"type": "subtitle", "time": 26874.468, "timestamp": "07:27:54", "text": "它？"}, {"type": "subtitle", "time": 26877.51, "timestamp": "07:27:57", "text": "此功能区域 33。是的。是的。主意"}]
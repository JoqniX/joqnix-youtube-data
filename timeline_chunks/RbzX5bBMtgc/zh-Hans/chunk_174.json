[{"type": "subtitle", "time": 10441.269, "timestamp": "02:54:01", "text": "震惊于时间竟然过去了这么久。"}, {"type": "subtitle", "time": 10442.95, "timestamp": "02:54:02", "text": "“不可能超过2"}, {"type": "subtitle", "time": 10444.59, "timestamp": "02:54:04", "text": "“几个小时，”他想。"}, {"type": "subtitle", "time": 10447.11, "timestamp": "02:54:07", "text": "怀疑。他感到很抱歉。"}, {"type": "subtitle", "time": 10449.99, "timestamp": "02:54:09", "text": "准备离开。担心大师"}, {"type": "subtitle", "time": 10453.03, "timestamp": "02:54:13", "text": "会对他感到恼火。"}, {"type": "subtitle", "time": 10455.23, "timestamp": "02:54:15", "text": "[音乐]"}, {"type": "subtitle", "time": 10457.19, "timestamp": "02:54:17", "text": "嗯？"}, {"type": "subtitle", "time": 10459.51, "timestamp": "02:54:19", "text": "但当伐木工转过身来时，"}, {"type": "subtitle", "time": 10463.19, "timestamp": "02:54:23", "text": "他差点吓得魂飞魄散。这"}, {"type": "subtitle", "time": 10465.91, "timestamp": "02:54:25", "text": "隐士大师一直在玩 wchi"}, {"type": "subtitle", "time": 10468.67, "timestamp": "02:54:28", "text": "而现在，饮酒也成为了一种潮流。"}, {"type": "subtitle", "time": 10472.07, "timestamp": "02:54:32", "text": "走了。取而代之的是一把破碎的巫师"}, {"type": "subtitle", "time": 10475.71, "timestamp": "02:54:35", "text": "木板和一堆腐烂的东西"}, {"type": "subtitle", "time": 10478.469, "timestamp": "02:54:38", "text": "骨头。伐木工吓坏了。"}, {"type": "subtitle", "time": 10480.55, "timestamp": "02:54:40", "text": "他手中的竹篮掉在了地上。"}, {"type": "subtitle", "time": 10482.55, "timestamp": "02:54:42", "text": "他甚至都没来得及跑下山，就跑下了山。"}, {"type": "subtitle", "time": 10485.59, "timestamp": "02:54:45", "text": "回首往事。"}, {"type": "subtitle", "time": 10488.23, "timestamp": "02:54:48", "text": "当他到达山脚时，他"}, {"type": "subtitle", "time": 10490.59, "timestamp": "02:54:50", "text": "遭受重创"}, {"type": "subtitle", "time": 10492.79, "timestamp": "02:54:52", "text": "实现。他所在的那个古朴的小村庄"}, {"type": "subtitle", "time": 10495.51, "timestamp": "02:54:55", "text": "记忆中已发展成一片繁华景象"}, {"type": "subtitle", "time": 10498.87, "timestamp": "02:54:58", "text": "小镇上到处都是坚固的砖房，取而代之的是其他房屋。"}]
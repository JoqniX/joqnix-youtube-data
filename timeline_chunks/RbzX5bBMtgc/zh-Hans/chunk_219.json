[{"type": "subtitle", "time": 13143.71, "timestamp": "03:39:03", "text": "难以预测。我的族人是，但是你，我的"}, {"type": "subtitle", "time": 13146.55, "timestamp": "03:39:06", "text": "朋友，选择进入游戏"}, {"type": "subtitle", "time": 13148.389, "timestamp": "03:39:08", "text": "你自己。"}, {"type": "subtitle", "time": 13150.95, "timestamp": "03:39:10", "text": "这是危险的。现在，请不要觉得"}, {"type": "subtitle", "time": 13155.51, "timestamp": "03:39:15", "text": "我感到难过。如果我死了，那将会是在……"}, {"type": "subtitle", "time": 13159.269, "timestamp": "03:39:19", "text": "时机终会到来。完成这一切的人"}, {"type": "subtitle", "time": 13163.11, "timestamp": "03:39:23", "text": "这种游戏方式。但对我来说，没有"}, {"type": "subtitle", "time": 13166.469, "timestamp": "03:39:26", "text": "无需担忧。凭借她的智慧"}, {"type": "subtitle", "time": 13169.91, "timestamp": "03:39:29", "text": "她思维敏捷，会取得好结果。"}, {"type": "subtitle", "time": 13173.99, "timestamp": "03:39:33", "text": "这场比赛的胜负将决定一切。前路漫漫"}, {"type": "subtitle", "time": 13177.11, "timestamp": "03:39:37", "text": "很长。"}]
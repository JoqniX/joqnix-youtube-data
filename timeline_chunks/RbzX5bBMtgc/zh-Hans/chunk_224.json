[{"type": "subtitle", "time": 13441.189, "timestamp": "03:44:01", "text": "米拉不应该能够持有"}, {"type": "subtitle", "time": 13444.03, "timestamp": "03:44:04", "text": "像这样的对话。"}, {"type": "subtitle", "time": 13446.59, "timestamp": "03:44:06", "text": "嗯？你为什么停下来了？"}, {"type": "subtitle", "time": 13449.95, "timestamp": "03:44:09", "text": "说？你迷路了吗？我有点迷茫。"}, {"type": "subtitle", "time": 13453.99, "timestamp": "03:44:13", "text": "我可以带你去安全的地方。"}, {"type": "subtitle", "time": 13468.1, "timestamp": "03:44:28", "text": "村庄。哦，"}, {"type": "subtitle", "time": 13472.63, "timestamp": "03:44:32", "text": "[音乐]"}, {"type": "subtitle", "time": 13488.55, "timestamp": "03:44:48", "text": "呃，这里以前有过类似的事情吗？"}, {"type": "subtitle", "time": 13490.95, "timestamp": "03:44:50", "text": "前？"}, {"type": "subtitle", "time": 13492.189, "timestamp": "03:44:52", "text": "这些"}, {"type": "subtitle", "time": 13494.389, "timestamp": "03:44:54", "text": "机制。它们需要被解锁。"}, {"type": "subtitle", "time": 13496.92, "timestamp": "03:44:56", "text": "同时来自双方。"}]
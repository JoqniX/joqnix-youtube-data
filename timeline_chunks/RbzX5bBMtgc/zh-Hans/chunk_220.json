[{"type": "subtitle", "time": 13224.59, "timestamp": "03:40:24", "text": "哦，她的眼神变了"}, {"type": "subtitle", "time": 13227.46, "timestamp": "03:40:27", "text": "变成一个发光的东西。"}, {"type": "subtitle", "time": 13238.469, "timestamp": "03:40:38", "text": "哦。我的天啊。"}, {"type": "subtitle", "time": 13240.79, "timestamp": "03:40:40", "text": "你已经走到这一步，并一路关注着我们。"}, {"type": "subtitle", "time": 13243.51, "timestamp": "03:40:43", "text": "这里。不要以为你会一直处于……"}, {"type": "subtitle", "time": 13251.59, "timestamp": "03:40:51", "text": "我们的友好聊天结束了。是时候了"}]
[{"type": "subtitle", "time": 13260.71, "timestamp": "03:41:00", "text": "家。火。"}, {"type": "subtitle", "time": 13269.269, "timestamp": "03:41:09", "text": "我们知道的远不止那场未完成的游戏。"}, {"type": "subtitle", "time": 13271.87, "timestamp": "03:41:11", "text": "我们非常清楚"}, {"type": "subtitle", "time": 13275.19, "timestamp": "03:41:15", "text": "价格。你悬在末端"}, {"type": "subtitle", "time": 13280.15, "timestamp": "03:41:20", "text": "你的绳子。什么？你无意间的踪迹"}, {"type": "subtitle", "time": 13308.55, "timestamp": "03:41:48", "text": "我们齐心协力，终将胜利。沦落到"}, {"type": "subtitle", "time": 13318.15, "timestamp": "03:41:58", "text": "该死。快点。她太强了。"}]
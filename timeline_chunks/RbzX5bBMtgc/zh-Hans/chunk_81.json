[{"type": "subtitle", "time": 4861.59, "timestamp": "01:21:01", "text": "组合。制作方法实在太多了。"}, {"type": "subtitle", "time": 4864.149, "timestamp": "01:21:04", "text": "蟑螂无关紧要。所以，我真的不能"}, {"type": "subtitle", "time": 4866.229, "timestamp": "01:21:06", "text": "证明给她六分以上是合理的。"}, {"type": "subtitle", "time": 4868.47, "timestamp": "01:21:08", "text": "满分10分。然后是最后一个角色"}, {"type": "subtitle", "time": 4870.87, "timestamp": "01:21:10", "text": "我们要谈论的将是我们的兄弟"}, {"type": "subtitle", "time": 4873.27, "timestamp": "01:21:13", "text": "布兰特，也被称为迄今为止"}, {"type": "subtitle", "time": 4875.43, "timestamp": "01:21:15", "text": "游戏中最好笑的角色。"}, {"type": "subtitle", "time": 4878.149, "timestamp": "01:21:18", "text": "如果你不同意我的观点，那你就错了。"}, {"type": "subtitle", "time": 4879.99, "timestamp": "01:21:19", "text": "布兰特是个非常幽默的人"}, {"type": "subtitle", "time": 4881.99, "timestamp": "01:21:21", "text": "因为很多人都看得出这个角色。"}, {"type": "subtitle", "time": 4883.75, "timestamp": "01:21:23", "text": "他的价值在于其数量之多。"}, {"type": "subtitle", "time": 4886.149, "timestamp": "01:21:26", "text": "他所做的事情。我的天哪，看看"}, {"type": "subtitle", "time": 4888.709, "timestamp": "01:21:28", "text": "他。真的。你看，布兰特有能力"}, {"type": "subtitle", "time": 4891.43, "timestamp": "01:21:31", "text": "担任主输出角色。他可以起到缓冲作用"}, {"type": "subtitle", "time": 4894.07, "timestamp": "01:21:34", "text": "融合或技巧。哇，他有条龙！"}, {"type": "subtitle", "time": 4895.75, "timestamp": "01:21:35", "text": "某物。治疗并保护你的队伍"}, {"type": "subtitle", "time": 4904.39, "timestamp": "01:21:44", "text": "看他飞得多快！"}, {"type": "subtitle", "time": 4906.59, "timestamp": "01:21:46", "text": "这是一个但是"}, {"type": "subtitle", "time": 4909.83, "timestamp": "01:21:49", "text": "2.0 版本。两个融合输出职业，其中一个"}, {"type": "subtitle", "time": 4912.79, "timestamp": "01:21:52", "text": "它更倾向于运行 Sanua。别误会我"}, {"type": "subtitle", "time": 4915.27, "timestamp": "01:21:55", "text": "错了，布伦特绝对是一位了不起的人物。"}, {"type": "subtitle", "time": 4916.87, "timestamp": "01:21:56", "text": "当你扮演他时，他的角色"}, {"type": "subtitle", "time": 4919.27, "timestamp": "01:21:59", "text": "查姆利。他也可以是个查姆利"}]
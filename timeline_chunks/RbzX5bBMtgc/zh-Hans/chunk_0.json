[{"type": "subtitle", "time": 6.71, "timestamp": "00:00:06", "text": "欢迎大家来到 Jakathon 第 52 天"}, {"type": "subtitle", "time": 12.509, "timestamp": "00:00:12", "text": "溪流。欢迎"}, {"type": "subtitle", "time": 20.87, "timestamp": "00:00:20", "text": "活？我正在直播。你好。欢迎来到"}, {"type": "subtitle", "time": 23.91, "timestamp": "00:00:23", "text": "Joathon 第 52 天第二部分直播。这"}, {"type": "subtitle", "time": 27.91, "timestamp": "00:00:27", "text": "夜间直播。今晚我们将……"}, {"type": "subtitle", "time": 30.23, "timestamp": "00:00:30", "text": "演奏《枯萎的跳跃》。我们只是"}, {"type": "subtitle", "time": 32.51, "timestamp": "00:00:32", "text": "最后打算出去玩玩，呃，"}, {"type": "subtitle", "time": 34.79, "timestamp": "00:00:34", "text": "好的？我要早点睡觉了。"}, {"type": "subtitle", "time": 37.35, "timestamp": "00:00:37", "text": "因为明天是合作日。我们得到了"}, {"type": "subtitle", "time": 39.83, "timestamp": "00:00:39", "text": "两项合作。我们一起经历了地狱"}, {"type": "subtitle", "time": 42.47, "timestamp": "00:00:42", "text": "潜水地狱潜水员与 ve 和我们合作"}, {"type": "subtitle", "time": 44.709, "timestamp": "00:00:44", "text": "和很多情侣一起做了森林主题的合作"}, {"type": "subtitle", "time": 48.029, "timestamp": "00:00:48", "text": "朋友们。所以我很兴奋"}, {"type": "subtitle", "time": 51.95, "timestamp": "00:00:51", "text": "那。让我们做我们的"}]
[{"type": "subtitle", "time": 6098.99, "timestamp": "01:41:38", "text": "某物。我们弄到了两个犹太人。耶。是的，"}, {"type": "subtitle", "time": 6101.51, "timestamp": "01:41:41", "text": "好的。我仍然可以靠近他"}, {"type": "subtitle", "time": 6104.55, "timestamp": "01:41:44", "text": "如果他发现，就抓住他。好的，我们会"}, {"type": "subtitle", "time": 6116.47, "timestamp": "01:41:56", "text": "明白了。我来为您服务"}]
[{"type": "subtitle", "time": 3617.27, "timestamp": "01:00:17", "text": "我们上一次……之前是什么时候？"}, {"type": "subtitle", "time": 3621.03, "timestamp": "01:00:21", "text": "那个红头发双马尾的女士来了？"}, {"type": "subtitle", "time": 3626.91, "timestamp": "01:00:26", "text": "[音乐]"}, {"type": "subtitle", "time": 3630.63, "timestamp": "01:00:30", "text": "呃，之前"}, {"type": "subtitle", "time": 3632.39, "timestamp": "01:00:32", "text": "神灵或许能够预见未来"}, {"type": "subtitle", "time": 3634.47, "timestamp": "01:00:34", "text": "但我们怀疑我们能否预测哪个"}, {"type": "subtitle", "time": 3638.349, "timestamp": "01:00:38", "text": "人们明天要演奏的歌曲"}, {"type": "subtitle", "time": 3641.589, "timestamp": "01:00:41", "text": "在查米拉到来之前。是的。你愿意吗？"}, {"type": "subtitle", "time": 3644.309, "timestamp": "01:00:44", "text": "就像一种心照不宣的默契？我玩过"}, {"type": "subtitle", "time": 3645.63, "timestamp": "01:00:45", "text": "海岸守护者"}, {"type": "subtitle", "time": 3648.39, "timestamp": "01:00:48", "text": "东西。是在直播中还是直播外？"}, {"type": "subtitle", "time": 3656.91, "timestamp": "01:00:56", "text": "我想玩。她有一头红发。我"}, {"type": "subtitle", "time": 3659.589, "timestamp": "01:00:59", "text": "不知道明天会有谁来玩。我"}]
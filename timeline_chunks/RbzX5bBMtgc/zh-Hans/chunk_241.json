[{"type": "subtitle", "time": 14464.469, "timestamp": "04:01:04", "text": "哦，这就是她变得如此睿智的原因。"}, {"type": "subtitle", "time": 14472.59, "timestamp": "04:01:12", "text": "你拥有火焰的力量"}, {"type": "subtitle", "time": 14476.67, "timestamp": "04:01:16", "text": "操纵。一只浴火重生的凤凰"}, {"type": "subtitle", "time": 14479.75, "timestamp": "04:01:19", "text": "火。一个能给这里带来和平的人"}, {"type": "subtitle", "time": 14481.269, "timestamp": "04:01:21", "text": "世界。"}, {"type": "subtitle", "time": 14483.5, "timestamp": "04:01:23", "text": "哦，"}, {"type": "subtitle", "time": 14484.79, "timestamp": "04:01:24", "text": "[音乐]"}, {"type": "subtitle", "time": 14486.349, "timestamp": "04:01:26", "text": "从这一天起"}, {"type": "subtitle", "time": 14491.51, "timestamp": "04:01:31", "text": "从今以后，你的名字将是 Chung Lee。钟"}, {"type": "subtitle", "time": 14499.11, "timestamp": "04:01:39", "text": "永恒之火。你一定要走吗？"}, {"type": "subtitle", "time": 14501.11, "timestamp": "04:01:41", "text": "掌握？"}, {"type": "subtitle", "time": 14505.99, "timestamp": "04:01:45", "text": "我参与其中的时间。你要去吗？"}, {"type": "subtitle", "time": 14509.71, "timestamp": "04:01:49", "text": "还没到你去那里的时候。"}, {"type": "subtitle", "time": 14512.95, "timestamp": "04:01:52", "text": "钟利。但你为此付出的代价"}, {"type": "subtitle", "time": 14515.83, "timestamp": "04:01:55", "text": "强力运用你的强项可以"}, {"type": "subtitle", "time": 14519.269, "timestamp": "04:01:59", "text": "永不被抹去。"}]
[{"type": "subtitle", "time": 27121.11, "timestamp": "07:32:01", "text": "完成或者至少得到这个，那就是"}, {"type": "subtitle", "time": 27123.91, "timestamp": "07:32:03", "text": "呃，第33章第三部分。我们需要"}, {"type": "subtitle", "time": 27125.19, "timestamp": "07:32:05", "text": "完成这件事。故事到此结束。"}, {"type": "subtitle", "time": 27127.67, "timestamp": "07:32:07", "text": "实际上，这是章节。我不知道我是不是"}, {"type": "subtitle", "time": 27130.948, "timestamp": "07:32:10", "text": "能够达到那个程度，但我们可以"}, {"type": "subtitle", "time": 27135.31, "timestamp": "07:32:15", "text": "尝试。我们可以试试。所以我们可以"}, {"type": "subtitle", "time": 27137.91, "timestamp": "07:32:17", "text": "尝试。好的，我在玩捉迷藏。"}, {"type": "subtitle", "time": 27140.19, "timestamp": "07:32:20", "text": "已完成的事件也包含在内"}, {"type": "subtitle", "time": 27142.628, "timestamp": "07:32:22", "text": "进步。呃，这个功能区，这是"}, {"type": "subtitle", "time": 27146.628, "timestamp": "07:32:26", "text": "我们也需要这样的芯片活动。所以希望"}, {"type": "subtitle", "time": 27149.11, "timestamp": "07:32:29", "text": "今天一切都会顺利的。我们将"}, {"type": "subtitle", "time": 27151.19, "timestamp": "07:32:31", "text": "呃，我希望我能解锁两个空间"}, {"type": "subtitle", "time": 27155.11, "timestamp": "07:32:35", "text": "事件。是的。以及救赎"}, {"type": "subtitle", "time": 27159.11, "timestamp": "07:32:39", "text": "手术我算是做了，呃，我呃喜欢"}, {"type": "subtitle", "time": 27161.868, "timestamp": "07:32:41", "text": "在结束了 Valerin 流之后"}, {"type": "subtitle", "time": 27164.35, "timestamp": "07:32:44", "text": "晚上，我玩了。"}, {"type": "subtitle", "time": 27167.59, "timestamp": "07:32:47", "text": "汉凯。你们肯定都看到了。"}, {"type": "subtitle", "time": 27170.07, "timestamp": "07:32:50", "text": "因为我当时正在结束直播。"}, {"type": "subtitle", "time": 27172.468, "timestamp": "07:32:52", "text": "我不小心在 Hungai 上打开了"}, {"type": "subtitle", "time": 27176.548, "timestamp": "07:32:56", "text": "瓦莱林流。是的，我们确实这么做了。"}, {"type": "subtitle", "time": 27178.99, "timestamp": "07:32:58", "text": "我觉得我目前"}]
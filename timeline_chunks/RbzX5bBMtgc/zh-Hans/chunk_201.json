[{"type": "subtitle", "time": 12062.62, "timestamp": "03:21:02", "text": "那。这里很快就会变得危险。"}, {"type": "subtitle", "time": 12069.429, "timestamp": "03:21:09", "text": "我就知道。我们的葫芦已停止服务"}, {"type": "subtitle", "time": 12071.59, "timestamp": "03:21:11", "text": "因为以太体的影响。"}, {"type": "subtitle", "time": 12073.67, "timestamp": "03:21:13", "text": "我们无法发送或接收消息"}, {"type": "subtitle", "time": 12075.91, "timestamp": "03:21:15", "text": "立即提供帮助。我们最好快点过去。什么是"}, {"type": "subtitle", "time": 12078.95, "timestamp": "03:21:18", "text": "神？聚集观察。那是什么？"}, {"type": "subtitle", "time": 12081.349, "timestamp": "03:21:21", "text": "系统？看来你真的记不起来了。"}, {"type": "subtitle", "time": 12084.309, "timestamp": "03:21:24", "text": "事物。但别担心。上帝啊，如果你有"}, {"type": "subtitle", "time": 12086.87, "timestamp": "03:21:26", "text": "有任何问题，我们可以边走边问。"}, {"type": "subtitle", "time": 12089.03, "timestamp": "03:21:29", "text": "我和颖会把全部情况都告诉你。"}, {"type": "subtitle", "time": 12091.03, "timestamp": "03:21:31", "text": "从一开始就注重每一个细节。"}, {"type": "subtitle", "time": 12094.389, "timestamp": "03:21:34", "text": "你好。知道了。路虎。呃，我们可以叫你吗？"}, {"type": "subtitle", "time": 12096.79, "timestamp": "03:21:36", "text": "现在，在你想起你的之前，先这样吧"}, {"type": "subtitle", "time": 12099.71, "timestamp": "03:21:39", "text": "真名？哦，我知道我的"}, {"type": "subtitle", "time": 12102.55, "timestamp": "03:21:42", "text": "姓名。等待，"}, {"type": "subtitle", "time": 12104.229, "timestamp": "03:21:44", "text": "我相信是这样。哦，等等。他们将要"}, {"type": "subtitle", "time": 12107.269, "timestamp": "03:21:47", "text": "叫我罗阿就好。我们不应该留在这里。但"}, {"type": "subtitle", "time": 12110.63, "timestamp": "03:21:50", "text": "我的名字是查克恩。我给出了一个名字。那是"}]
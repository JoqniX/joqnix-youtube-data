[{"type": "subtitle", "time": 12360.83, "timestamp": "03:26:00", "text": "[音乐]"}, {"type": "subtitle", "time": 12363.75, "timestamp": "03:26:03", "text": "去。她挺可爱的。哦，那是一个"}, {"type": "subtitle", "time": 12367.229, "timestamp": "03:26:07", "text": "巨大的龙头。"}, {"type": "subtitle", "time": 12369.349, "timestamp": "03:26:09", "text": "哇。哦，你一直收到……"}, {"type": "subtitle", "time": 12371.67, "timestamp": "03:26:11", "text": "倒叙。"}, {"type": "subtitle", "time": 12383.51, "timestamp": "03:26:23", "text": "这？怎么了？你受伤了吗？"}, {"type": "subtitle", "time": 12386.59, "timestamp": "03:26:26", "text": "打架？"}, {"type": "subtitle", "time": 12391.75, "timestamp": "03:26:31", "text": "亲爱的，我想我记起一件事了。"}, {"type": "subtitle", "time": 12396.309, "timestamp": "03:26:36", "text": "你在记忆中看到了我们的哨兵。"}, {"type": "subtitle", "time": 12398.63, "timestamp": "03:26:38", "text": "哨兵？"}, {"type": "subtitle", "time": 12402.389, "timestamp": "03:26:42", "text": "是的。我们为他/她建造了这座雕像。"}, {"type": "subtitle", "time": 12405.99, "timestamp": "03:26:45", "text": "Jen Joe 中的 Oracle Engine Sentinel。"}, {"type": "subtitle", "time": 12409.75, "timestamp": "03:26:49", "text": "啊，Oracle引擎。香港的六个城市"}, {"type": "subtitle", "time": 12414.229, "timestamp": "03:26:54", "text": "每个城市都有自己的哨兵。"}, {"type": "subtitle", "time": 12416.99, "timestamp": "03:26:56", "text": "我的天啊。感谢"}]
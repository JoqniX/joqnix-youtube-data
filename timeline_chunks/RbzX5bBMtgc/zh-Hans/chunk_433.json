[{"type": "subtitle", "time": 25988.548, "timestamp": "07:13:08", "text": "临走前，我有点想去务农。"}, {"type": "subtitle", "time": 25991.19, "timestamp": "07:13:11", "text": "一些东西。应该那样做的"}, {"type": "subtitle", "time": 25994.91, "timestamp": "07:13:14", "text": "在最初阶段。"}, {"type": "subtitle", "time": 25997.51, "timestamp": "07:13:17", "text": "哦，不过没关系。我本应该那样做"}, {"type": "subtitle", "time": 26031.19, "timestamp": "07:13:51", "text": "我的扬升材料看起来怎么样？"}, {"type": "subtitle", "time": 26032.468, "timestamp": "07:13:52", "text": "[音乐]"}, {"type": "subtitle", "time": 26037.61, "timestamp": "07:13:57", "text": "我需要雷鸣般的沙漠角落。"}, {"type": "subtitle", "time": 26039.83, "timestamp": "07:13:59", "text": "[音乐]"}]
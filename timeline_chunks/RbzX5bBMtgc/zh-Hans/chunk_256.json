[{"type": "subtitle", "time": 15393.91, "timestamp": "04:16:33", "text": "你好。我们几乎完成了对……的处理"}, {"type": "subtitle", "time": 15396.79, "timestamp": "04:16:36", "text": "前一次事件的后果，"}, {"type": "subtitle", "time": 15398.79, "timestamp": "04:16:38", "text": "但他们想要得到"}, {"type": "subtitle", "time": 15401.03, "timestamp": "04:16:41", "text": "传说中的时间程序"}, {"type": "subtitle", "time": 15403.99, "timestamp": "04:16:43", "text": "以这种方式玩游戏的目的是"}, {"type": "subtitle", "time": 15407.03, "timestamp": "04:16:47", "text": "樟宜机场发生的混乱事件被描述为"}, {"type": "subtitle", "time": 15409.83, "timestamp": "04:16:49", "text": "我们得知，一个害怕的监工已经进来了。"}, {"type": "subtitle", "time": 15413.189, "timestamp": "04:16:53", "text": "索诺拉长矛刺伤了他。我已经"}, {"type": "subtitle", "time": 15415.03, "timestamp": "04:16:55", "text": "为市政府撰写了一份详尽的报告"}, {"type": "subtitle", "time": 15417.67, "timestamp": "04:16:57", "text": "大厅。我们将变得更加强大。我们分两部分"}, {"type": "subtitle", "time": 15419.75, "timestamp": "04:16:59", "text": "几天前在海边。或许她是"}]
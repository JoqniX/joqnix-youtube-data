[{"type": "subtitle", "time": 15421.349, "timestamp": "04:17:01", "text": "只是抽出点时间休息一下。"}, {"type": "subtitle", "time": 15423.189, "timestamp": "04:17:03", "text": "恢复。"}, {"type": "subtitle", "time": 15425.83, "timestamp": "04:17:05", "text": "樟宜机场肯定知道你会来。"}, {"type": "subtitle", "time": 15428.149, "timestamp": "04:17:08", "text": "担心。在凉亭与她见面"}, {"type": "subtitle", "time": 15431.91, "timestamp": "04:17:11", "text": "山。她还说，"}, {"type": "subtitle", "time": 15435.75, "timestamp": "04:17:15", "text": "“不再有这种事了。”好的。"}, {"type": "subtitle", "time": 15458.71, "timestamp": "04:17:38", "text": "[音乐]"}, {"type": "subtitle", "time": 15461.42, "timestamp": "04:17:41", "text": "力量。"}, {"type": "subtitle", "time": 15475.51, "timestamp": "04:17:55", "text": "[音乐]"}]
[{"type": "subtitle", "time": 13401.189, "timestamp": "03:43:21", "text": "我没事。这是我的强项。我已经习惯了"}, {"type": "subtitle", "time": 13403.87, "timestamp": "03:43:23", "text": "它。"}, {"type": "subtitle", "time": 13406.79, "timestamp": "03:43:26", "text": "你离我远点，否则你会……"}, {"type": "subtitle", "time": 13413.189, "timestamp": "03:43:33", "text": "[音乐]"}, {"type": "subtitle", "time": 13415.349, "timestamp": "03:43:35", "text": "这个村庄遭到了塔西提·迪斯的袭击。"}, {"type": "subtitle", "time": 13416.67, "timestamp": "03:43:36", "text": "你为什么来"}, {"type": "subtitle", "time": 13419.349, "timestamp": "03:43:39", "text": "这里？除了流亡者之外，没有人愿意"}, {"type": "subtitle", "time": 13424.07, "timestamp": "03:43:44", "text": "现在就留在这里吧。你不应该在这里。"}, {"type": "subtitle", "time": 13426.87, "timestamp": "03:43:46", "text": "你是坏人吗？"}, {"type": "subtitle", "time": 13430.429, "timestamp": "03:43:50", "text": "无论你在寻找什么，那就是它。"}, {"type": "subtitle", "time": 13433.99, "timestamp": "03:43:53", "text": "为了。我在这里的时候，没人会害怕。"}, {"type": "subtitle", "time": 13437.03, "timestamp": "03:43:57", "text": "我。总之，你应该快点。"}, {"type": "subtitle", "time": 13438.83, "timestamp": "03:43:58", "text": "离开。它不是"}]
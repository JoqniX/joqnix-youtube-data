[{"type": "subtitle", "time": 23432.07, "timestamp": "06:30:32", "text": "跟我来。最后一个宝箱在这里。"}, {"type": "subtitle", "time": 23435.11, "timestamp": "06:30:35", "text": "谁是猎物？"}, {"type": "subtitle", "time": 23438.788, "timestamp": "06:30:38", "text": "是的，睡眠周期。是的，我知道。我"}, {"type": "subtitle", "time": 23440.708, "timestamp": "06:30:40", "text": "我真的不想这样。"}, {"type": "subtitle", "time": 23443.35, "timestamp": "06:30:43", "text": "会发生，但凋零的浪潮终将消逝。我责怪"}, {"type": "subtitle", "time": 23444.51, "timestamp": "06:30:44", "text": "这"}, {"type": "subtitle", "time": 23456.03, "timestamp": "06:30:56", "text": "游戏。都怪游戏。这"}]
[{"type": "subtitle", "time": 4401.75, "timestamp": "01:13:21", "text": "第二。好了，我回来了。我的爸爸"}, {"type": "subtitle", "time": 4404.79, "timestamp": "01:13:24", "text": "打电话。他是个愤怒的家庭主妇。我想要一个 b 我"}, {"type": "subtitle", "time": 4406.95, "timestamp": "01:13:26", "text": "我想要吟游诗人女，因为我喜欢红色"}, {"type": "subtitle", "time": 4409.07, "timestamp": "01:13:29", "text": "主要角色。"}, {"type": "subtitle", "time": 4412.669, "timestamp": "01:13:32", "text": "所以，我的弱点是红发。"}, {"type": "subtitle", "time": 4417.07, "timestamp": "01:13:37", "text": "所以我想让她成为"}, {"type": "subtitle", "time": 4419.95, "timestamp": "01:13:39", "text": "出色地。"}, {"type": "subtitle", "time": 4423.189, "timestamp": "01:13:43", "text": "阿哈娜，我真的好困惑。应该"}, {"type": "subtitle", "time": 4434.83, "timestamp": "01:13:54", "text": "我应该怎么做？"}]
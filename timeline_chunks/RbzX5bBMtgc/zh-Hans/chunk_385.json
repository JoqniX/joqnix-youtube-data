[{"type": "subtitle", "time": 23123.43, "timestamp": "06:25:23", "text": "我带你走吧。我看到了清晰的路。不"}, {"type": "subtitle", "time": 23126.15, "timestamp": "06:25:26", "text": "匆忙。那些性急的人会失败。"}, {"type": "subtitle", "time": 23128.03, "timestamp": "06:25:28", "text": "落入我们怀里。"}, {"type": "subtitle", "time": 23148.75, "timestamp": "06:25:48", "text": "好了，现在我们才说到点子上了。不是"}, {"type": "subtitle", "time": 23152.628, "timestamp": "06:25:52", "text": "坏的。现在好多了。好的。没有"}, {"type": "subtitle", "time": 23155.83, "timestamp": "06:25:55", "text": "浪费时间。"}]
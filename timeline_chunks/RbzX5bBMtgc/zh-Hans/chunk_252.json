[{"type": "subtitle", "time": 15121.83, "timestamp": "04:12:01", "text": "索诺拉球体。"}, {"type": "subtitle", "time": 15124.309, "timestamp": "04:12:04", "text": "这让我想到，我从未想过这个解决方案。"}, {"type": "subtitle", "time": 15126.63, "timestamp": "04:12:06", "text": "那将是烧毁整个你"}, {"type": "subtitle", "time": 15130.71, "timestamp": "04:12:10", "text": "樟宜，你们走得太远了。"}, {"type": "subtitle", "time": 15132.89, "timestamp": "04:12:12", "text": "我知道我的"}, {"type": "subtitle", "time": 15139.71, "timestamp": "04:12:19", "text": "[音乐]"}, {"type": "subtitle", "time": 15144.71, "timestamp": "04:12:24", "text": "限制。罗孚，钟夫人，李没事"}, {"type": "subtitle", "time": 15147.91, "timestamp": "04:12:27", "text": "现在，多亏了医生的帮助。至于"}, {"type": "subtitle", "time": 15151.349, "timestamp": "04:12:31", "text": "至于我嘛，至少我还能走路。"}, {"type": "subtitle", "time": 15155.269, "timestamp": "04:12:35", "text": "毕竟。已经过去快5天了。我"}, {"type": "subtitle", "time": 15157.269, "timestamp": "04:12:37", "text": "我一直没好好感谢你带来的"}, {"type": "subtitle", "time": 15160.07, "timestamp": "04:12:40", "text": "我回到洪森。"}, {"type": "subtitle", "time": 15162.95, "timestamp": "04:12:42", "text": "没必要那样。弗雷杜斯家族有他们的"}, {"type": "subtitle", "time": 15165.349, "timestamp": "04:12:45", "text": "我们关注的都是同一件事。他们有"}, {"type": "subtitle", "time": 15167.429, "timestamp": "04:12:47", "text": "一直在计划买个功放。我们永远不会"}, {"type": "subtitle", "time": 15171.269, "timestamp": "04:12:51", "text": "忘记你是如何救了我们吧。"}, {"type": "subtitle", "time": 15174.63, "timestamp": "04:12:54", "text": "至于所谓“我”背后的真相"}, {"type": "subtitle", "time": 15176.63, "timestamp": "04:12:56", "text": "我有一种预感，结果会是这样。"}, {"type": "subtitle", "time": 15179.349, "timestamp": "04:12:59", "text": "可能会令人失望，但这并非……"}]
[{"type": "subtitle", "time": 4681.99, "timestamp": "01:18:01", "text": "你无法阻止这个女人"}, {"type": "subtitle", "time": 4684.149, "timestamp": "01:18:04", "text": "单个目标。所以，你会认为"}, {"type": "subtitle", "time": 4685.99, "timestamp": "01:18:05", "text": "因为她的单体攻击力非常高"}, {"type": "subtitle", "time": 4688.229, "timestamp": "01:18:08", "text": "如果输出不够，她会彻底崩溃。"}, {"type": "subtitle", "time": 4691.75, "timestamp": "01:18:11", "text": "柳条。哦，哭泣。那根本不是事实。"}, {"type": "subtitle", "time": 4694.63, "timestamp": "01:18:14", "text": "你看，卡拉拥有相当多的范围攻击技能。"}, {"type": "subtitle", "time": 4696.95, "timestamp": "01:18:16", "text": "她擅长的技能，尤其是她的强项。"}, {"type": "subtitle", "time": 4699.07, "timestamp": "01:18:19", "text": "重创与她的解放"}, {"type": "subtitle", "time": 4701.91, "timestamp": "01:18:21", "text": "激活。其余的都会直接开火。"}, {"type": "subtitle", "time": 4703.83, "timestamp": "01:18:23", "text": "直线，这意味着你"}, {"type": "subtitle", "time": 4707.189, "timestamp": "01:18:27", "text": "仍然拥有相当可观的范围伤害能力"}, {"type": "subtitle", "time": 4708.79, "timestamp": "01:18:28", "text": "只要你找准位置"}, {"type": "subtitle", "time": 4711.11, "timestamp": "01:18:31", "text": "正确。卡拉娜真的不可能是"}, {"type": "subtitle", "time": 4713.27, "timestamp": "01:18:33", "text": "如果你知道自己在做什么，就停下来。"}, {"type": "subtitle", "time": 4715.51, "timestamp": "01:18:35", "text": "彻底禁用的唯一真正方法是"}, {"type": "subtitle", "time": 4718.07, "timestamp": "01:18:38", "text": "她面临着巨大的冰川阻力。"}, {"type": "subtitle", "time": 4720.229, "timestamp": "01:18:40", "text": "但如果你有任何塔式逆向思维，我"}, {"type": "subtitle", "time": 4722.149, "timestamp": "01:18:42", "text": "认识一些刚刚完全……的人"}, {"type": "subtitle", "time": 4725.27, "timestamp": "01:18:45", "text": "还是硬着头皮上了。卡拉达只是"}, {"type": "subtitle", "time": 4728.149, "timestamp": "01:18:48", "text": "就输出伤害而言，这个角色很弱。和"}, {"type": "subtitle", "time": 4729.51, "timestamp": "01:18:49", "text": "如果你也遇到同样的问题"}, {"type": "subtitle", "time": 4732.709, "timestamp": "01:18:52", "text": "你猜是什么？全息影像！卡拉是最棒的"}, {"type": "subtitle", "time": 4735.43, "timestamp": "01:18:55", "text": "选项。这绝对是一个有力的竞争者"}, {"type": "subtitle", "time": 4737.669, "timestamp": "01:18:57", "text": "整个游戏中最优秀的DPS之一"}]
[{"type": "subtitle", "time": 5765.75, "timestamp": "01:36:05", "text": "男人。我等级达到最高了吗？我觉得我"}, {"type": "subtitle", "time": 5776.189, "timestamp": "01:36:16", "text": "一切。是的，我需要这样做。"}, {"type": "subtitle", "time": 5780.11, "timestamp": "01:36:20", "text": "她。是的，只有她一个人。"}, {"type": "subtitle", "time": 5782.59, "timestamp": "01:36:22", "text": "左边。这"}, {"type": "subtitle", "time": 5796.95, "timestamp": "01:36:36", "text": "现在？我们可以让她发挥到极致。实际上，我"}, {"type": "subtitle", "time": 5799.95, "timestamp": "01:36:39", "text": "我真的会去做的事"}, {"type": "subtitle", "time": 5809.31, "timestamp": "01:36:49", "text": "那。是时候战斗了"}]
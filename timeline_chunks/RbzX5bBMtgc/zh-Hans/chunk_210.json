[{"type": "subtitle", "time": 12600.309, "timestamp": "03:30:00", "text": "谐振器可以释放音乐会的能量"}, {"type": "subtitle", "time": 12602.67, "timestamp": "03:30:02", "text": "在战斗中造成伤害或进行闪避"}, {"type": "subtitle", "time": 12605.51, "timestamp": "03:30:05", "text": "战斗。当协奏曲的能量达到饱和时，"}, {"type": "subtitle", "time": 12607.429, "timestamp": "03:30:07", "text": "其他谐振器图标会亮起。"}, {"type": "subtitle", "time": 12610.07, "timestamp": "03:30:10", "text": "好的，明白了。所以，它就像香港一样。"}, {"type": "subtitle", "time": 12612.51, "timestamp": "03:30:12", "text": "第三种系统之类的东西。得到"}, {"type": "subtitle", "time": 12615.83, "timestamp": "03:30:15", "text": "它。所以，你的能量已经充满，可以触发"}, {"type": "subtitle", "time": 12617.83, "timestamp": "03:30:17", "text": "退出谐振器结尾技巧和"}, {"type": "subtitle", "time": 12619.99, "timestamp": "03:30:19", "text": "消耗所有概念能量"}, {"type": "subtitle", "time": 12621.75, "timestamp": "03:30:21", "text": "触发传入谐振器的引入"}, {"type": "subtitle", "time": 12624.55, "timestamp": "03:30:24", "text": "技能。每个谐振器都有独特的结尾。"}, {"type": "subtitle", "time": 12626.429, "timestamp": "03:30:26", "text": "以及入门技能。"}, {"type": "subtitle", "time": 12633.349, "timestamp": "03:30:33", "text": "不错的配音演员，但是推特有点卡顿。等等，这是推特吗？"}, {"type": "subtitle", "time": 12635.429, "timestamp": "03:30:35", "text": "服务器是不是不堪重负导致卡顿？"}, {"type": "subtitle", "time": 12638.229, "timestamp": "03:30:38", "text": "所有人的直播。是你奋力拼搏。"}, {"type": "subtitle", "time": 12640.87, "timestamp": "03:30:40", "text": "出色地。等等，我甚至都没注册Twitch。"}, {"type": "subtitle", "time": 12643.269, "timestamp": "03:30:43", "text": "视频流卡顿。杨就这么冲了过去。"}, {"type": "subtitle", "time": 12644.91, "timestamp": "03:30:44", "text": "像保护你一样"}, {"type": "subtitle", "time": 12648.389, "timestamp": "03:30:48", "text": "总之，杨杨当时正在试图掩护"}, {"type": "subtitle", "time": 12651.269, "timestamp": "03:30:51", "text": "你，然后砰的一声，Tessa Discord 就出现了。"}, {"type": "subtitle", "time": 12653.03, "timestamp": "03:30:53", "text": "在他能好好休息之前就被处理掉了"}, {"type": "subtitle", "time": 12654.33, "timestamp": "03:30:54", "text": "看。"}, {"type": "subtitle", "time": 12657.75, "timestamp": "03:30:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 6600.55, "timestamp": "01:50:00", "text": "理解。啊，时间停止了。知道了。谁的"}, {"type": "subtitle", "time": 6626.95, "timestamp": "01:50:26", "text": "大唐快20岁了。我需要做21。"}, {"type": "subtitle", "time": 6642.109, "timestamp": "01:50:42", "text": "他们现在添加了新的怪物。"}, {"type": "subtitle", "time": 6645.51, "timestamp": "01:50:45", "text": "所以，那个唐牌的含量应该是20。是的，我需要"}, {"type": "subtitle", "time": 6649.51, "timestamp": "01:50:49", "text": "为了达到目标，他们增加了25。回到"}, {"type": "subtitle", "time": 6657.27, "timestamp": "01:50:57", "text": "25. 疯了。我的意思是，我可以做到。"}]
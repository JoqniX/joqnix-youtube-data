[{"type": "subtitle", "time": 4575.669, "timestamp": "01:16:15", "text": "[音乐]"}, {"type": "subtitle", "time": 4578.07, "timestamp": "01:16:18", "text": "多波效应。这意味着"}, {"type": "subtitle", "time": 4580.95, "timestamp": "01:16:20", "text": "Shakona是每个Phoebe必备的单品"}, {"type": "subtitle", "time": 4582.709, "timestamp": "01:16:22", "text": "想玩菲比的玩家"}, {"type": "subtitle", "time": 4585.59, "timestamp": "01:16:25", "text": "在呜咽的荒芜之中，因为这是"}, {"type": "subtitle", "time": 4587.189, "timestamp": "01:16:27", "text": "第一个能够……的角色"}, {"type": "subtitle", "time": 4589.43, "timestamp": "01:16:29", "text": "在多波段应用频谱干扰。和"}, {"type": "subtitle", "time": 4592.07, "timestamp": "01:16:32", "text": "那是菲比最关心的问题，她的"}, {"type": "subtitle", "time": 4594.709, "timestamp": "01:16:34", "text": "无法处理多波内容"}, {"type": "subtitle", "time": 4596.47, "timestamp": "01:16:36", "text": "因为，嗯，你根本就做不到。"}, {"type": "subtitle", "time": 4598.31, "timestamp": "01:16:38", "text": "除非你重新涂抹了Frazzil，否则请重新涂抹。"}, {"type": "subtitle", "time": 4599.75, "timestamp": "01:16:39", "text": "她和"}, {"type": "subtitle", "time": 4602.47, "timestamp": "01:16:42", "text": "路虎。即便如此，是的，她还是那么……"}, {"type": "subtitle", "time": 4604.87, "timestamp": "01:16:44", "text": "漂亮的。 Shakakota解决了这个问题"}, {"type": "subtitle", "time": 4607.51, "timestamp": "01:16:47", "text": "同时还拥有巨大的"}, {"type": "subtitle", "time": 4610.709, "timestamp": "01:16:50", "text": "对未来任何减少失误的队伍都有好处。"}, {"type": "subtitle", "time": 4613.11, "timestamp": "01:16:53", "text": "这让我觉得卡尔达是"}, {"type": "subtitle", "time": 4616.229, "timestamp": "01:16:56", "text": "将会是Shikona的好队友。"}, {"type": "subtitle", "time": 4618.31, "timestamp": "01:16:58", "text": "因为沙科纳将会是"}]
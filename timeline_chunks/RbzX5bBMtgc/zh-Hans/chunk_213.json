[{"type": "subtitle", "time": 12782.51, "timestamp": "03:33:02", "text": "这里。她在哪儿？"}, {"type": "subtitle", "time": 12784.5, "timestamp": "03:33:04", "text": "白。哦，是谁？"}, {"type": "subtitle", "time": 12785.95, "timestamp": "03:33:05", "text": "[音乐]"}, {"type": "subtitle", "time": 12788.429, "timestamp": "03:33:08", "text": "白？ Bishi是谁？"}, {"type": "subtitle", "time": 12791.51, "timestamp": "03:33:11", "text": "我不知道这个角色的名字，"}, {"type": "subtitle", "time": 12804.07, "timestamp": "03:33:24", "text": "托巴里克海。酸性场。酸性场。"}, {"type": "subtitle", "time": 12805.07, "timestamp": "03:33:25", "text": "什么是"}, {"type": "subtitle", "time": 12807.83, "timestamp": "03:33:27", "text": "正在发生？哦，那是什么？哦，星星。"}, {"type": "subtitle", "time": 12811.349, "timestamp": "03:33:31", "text": "那是一颗星星。回声星。它不在这里"}, {"type": "subtitle", "time": 12813.59, "timestamp": "03:33:33", "text": "我们刚到这里的时候，但我没有"}, {"type": "subtitle", "time": 12816.75, "timestamp": "03:33:36", "text": "隐约感觉到一丝酸性场的气息"}, {"type": "subtitle", "time": 12819.19, "timestamp": "03:33:39", "text": "在场。所以，它在我们……的时候出现了"}, {"type": "subtitle", "time": 12821.83, "timestamp": "03:33:41", "text": "当时没在看。准备眨眼关掉"}, {"type": "subtitle", "time": 12825.269, "timestamp": "03:33:45", "text": "眼睛。哦，或许以太之海能告诉我们"}, {"type": "subtitle", "time": 12827.83, "timestamp": "03:33:47", "text": "我们所在的地方。以太海正在跟随"}, {"type": "subtitle", "time": 12832.15, "timestamp": "03:33:52", "text": "我们。战术场的中心。"}, {"type": "subtitle", "time": 12834.349, "timestamp": "03:33:54", "text": "某物是"}, {"type": "subtitle", "time": 12838.35, "timestamp": "03:33:58", "text": "那里。哦"}]
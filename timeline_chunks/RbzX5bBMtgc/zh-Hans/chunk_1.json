[{"type": "subtitle", "time": 63.63, "timestamp": "00:01:03", "text": "你好。这么累，"}, {"type": "subtitle", "time": 66.75, "timestamp": "00:01:06", "text": "男人。是因为我"}, {"type": "subtitle", "time": 73.59, "timestamp": "00:01:13", "text": "我觉得是因为我吃了"}, {"type": "subtitle", "time": 75.83, "timestamp": "00:01:15", "text": "吃了杯方便面，我感觉好困。"}, {"type": "subtitle", "time": 77.55, "timestamp": "00:01:17", "text": "正确的"}, {"type": "subtitle", "time": 80.39, "timestamp": "00:01:20", "text": "现在。但我晚上应该睡觉，而不是"}]
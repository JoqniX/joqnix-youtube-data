[{"type": "subtitle", "time": 1561.789, "timestamp": "00:26:01", "text": "布莱茨。瞧瞧。就像她的工具包一样"}, {"type": "subtitle", "time": 1571.99, "timestamp": "00:26:11", "text": "凉爽的。哦，这不是我扮演的角色吗？"}, {"type": "subtitle", "time": 1573.95, "timestamp": "00:26:13", "text": "想？那果冻推"}, {"type": "subtitle", "time": 1577.23, "timestamp": "00:26:17", "text": "女士。我不认为她有可能"}, {"type": "subtitle", "time": 1579.95, "timestamp": "00:26:19", "text": "玩。这是谁？"}, {"type": "subtitle", "time": 1585.149, "timestamp": "00:26:25", "text": "男的？出现了好多新角色。"}, {"type": "subtitle", "time": 1588.64, "timestamp": "00:26:28", "text": "哦，退货包裹。"}, {"type": "subtitle", "time": 1594.23, "timestamp": "00:26:34", "text": "[音乐]"}, {"type": "subtitle", "time": 1595.99, "timestamp": "00:26:35", "text": "我应该多笑笑。有一个"}, {"type": "subtitle", "time": 1601.19, "timestamp": "00:26:41", "text": "我可以祈求什么具体的事情吗？哇。"}, {"type": "subtitle", "time": 1602.37, "timestamp": "00:26:42", "text": "有一只脚"}, {"type": "subtitle", "time": 1604.99, "timestamp": "00:26:44", "text": "[音乐]"}, {"type": "subtitle", "time": 1606.45, "timestamp": "00:26:46", "text": "她。"}, {"type": "subtitle", "time": 1611.19, "timestamp": "00:26:51", "text": "呃"}]
[{"type": "subtitle", "time": 11295.19, "timestamp": "03:08:15", "text": "我只是想试试能不能拿到"}, {"type": "subtitle", "time": 11305.15, "timestamp": "03:08:25", "text": "主。"}, {"type": "subtitle", "time": 11315.59, "timestamp": "03:08:35", "text": "希望我们能抽出时间再去一次。"}, {"type": "subtitle", "time": 11318.79, "timestamp": "03:08:38", "text": "冒险。我看到了清晰的路。我会的"}, {"type": "subtitle", "time": 11333.59, "timestamp": "03:08:53", "text": "明白了。我来为您服务"}, {"type": "subtitle", "time": 11335.79, "timestamp": "03:08:55", "text": "将要。我应该多笑笑。你"}, {"type": "subtitle", "time": 11339.51, "timestamp": "03:08:59", "text": "像这样说。"}]
[{"type": "subtitle", "time": 14523.309, "timestamp": "04:02:03", "text": "哦，不。这个人注定会成为我的真命天子。"}, {"type": "subtitle", "time": 14526.71, "timestamp": "04:02:06", "text": "记住我教过你的。哦不，"}, {"type": "subtitle", "time": 14531.229, "timestamp": "04:02:11", "text": "她的寿命很短。计划"}, {"type": "subtitle", "time": 14534.75, "timestamp": "04:02:14", "text": "仔细保护自己"}, {"type": "subtitle", "time": 14537.83, "timestamp": "04:02:17", "text": "明智地为将来成长做好准备"}, {"type": "subtitle", "time": 14540.95, "timestamp": "04:02:20", "text": "你渴望成为的那种人。"}, {"type": "subtitle", "time": 14542.87, "timestamp": "04:02:22", "text": "钟李会记住你的教诲。"}, {"type": "subtitle", "time": 14546.87, "timestamp": "04:02:26", "text": "牢记于心。师父，师父"}, {"type": "subtitle", "time": 14549.309, "timestamp": "04:02:29", "text": "当……的时候"}, {"type": "subtitle", "time": 14553.59, "timestamp": "04:02:33", "text": "来了，你只需要用你的她就是"}, {"type": "subtitle", "time": 14559.189, "timestamp": "04:02:39", "text": "只有他才能真正改变这一切。"}, {"type": "subtitle", "time": 14563.71, "timestamp": "04:02:43", "text": "我相信我已经找到了这个"}, {"type": "subtitle", "time": 14575.229, "timestamp": "04:02:55", "text": "哦，我们到这儿了。我正在获得"}, {"type": "subtitle", "time": 14578.469, "timestamp": "04:02:58", "text": "起了鸡皮疙瘩。跑步。我想这是另一个"}]
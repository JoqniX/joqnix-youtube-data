[{"type": "subtitle", "time": 13505.269, "timestamp": "03:45:05", "text": "好的。我们一人负责一边。患病的"}, {"type": "subtitle", "time": 13522.71, "timestamp": "03:45:22", "text": "我不能用那个。好吧，我不能用那个。"}, {"type": "subtitle", "time": 13525.63, "timestamp": "03:45:25", "text": "这里。好的，一旦我们离开"}, {"type": "subtitle", "time": 13528.469, "timestamp": "03:45:28", "text": "这里。这个地方似乎有点不一样。"}, {"type": "subtitle", "time": 13531.67, "timestamp": "03:45:31", "text": "我记得是这样。"}]
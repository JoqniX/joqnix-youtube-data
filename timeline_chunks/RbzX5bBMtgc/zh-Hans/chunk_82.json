[{"type": "subtitle", "time": 4921.11, "timestamp": "01:22:01", "text": "虽然在某些球队中担任替补，"}, {"type": "subtitle", "time": 4923.03, "timestamp": "01:22:03", "text": "当然不全是因为查姆利"}, {"type": "subtitle", "time": 4924.95, "timestamp": "01:22:04", "text": "只是她的轮换更加灵活了。"}, {"type": "subtitle", "time": 4927.27, "timestamp": "01:22:07", "text": "然而，当……时，布兰特就开始展现他的才华。"}, {"type": "subtitle", "time": 4929.03, "timestamp": "01:22:09", "text": "开始研究他与钟的协同效应。"}, {"type": "subtitle", "time": 4931.35, "timestamp": "01:22:11", "text": "李，因为无论你是否快速交换它们"}, {"type": "subtitle", "time": 4933.27, "timestamp": "01:22:13", "text": "或者你可以用你的品牌来提升你的 Chong。"}, {"type": "subtitle", "time": 4935.43, "timestamp": "01:22:15", "text": "李，你要清理"}, {"type": "subtitle", "time": 4938.47, "timestamp": "01:22:18", "text": "内容更新速度很快，因为它们是制作出来的。"}, {"type": "subtitle", "time": 4940.87, "timestamp": "01:22:20", "text": "彼此相爱。布兰德和尚李是"}, {"type": "subtitle", "time": 4943.27, "timestamp": "01:22:23", "text": "两个角色都能快速切换，而且"}, {"type": "subtitle", "time": 4945.27, "timestamp": "01:22:25", "text": "布兰特的结尾技巧堪称完美。"}, {"type": "subtitle", "time": 4947.51, "timestamp": "01:22:27", "text": "来到了给 Chong Lee 打磨的地方。所以，就是这样。"}, {"type": "subtitle", "time": 4949.51, "timestamp": "01:22:29", "text": "说实话，这真是一个非常好的组合"}, {"type": "subtitle", "time": 4951.99, "timestamp": "01:22:31", "text": "角色。如果你没有"}, {"type": "subtitle", "time": 4955.03, "timestamp": "01:22:35", "text": "Chong Lee，嗯，Brandt 的主要输出是"}, {"type": "subtitle", "time": 4957.59, "timestamp": "01:22:37", "text": "也相当不错。比"}, {"type": "subtitle", "time": 4960.95, "timestamp": "01:22:40", "text": "大多数副输出会转而成为主输出队伍，因为"}, {"type": "subtitle", "time": 4962.709, "timestamp": "01:22:42", "text": "布兰的破坏力比其他人的要大。"}, {"type": "subtitle", "time": 4964.709, "timestamp": "01:22:44", "text": "其他副输出角色以及"}, {"type": "subtitle", "time": 4967.03, "timestamp": "01:22:47", "text": "拥有一个完美的缓冲层，其形式为"}, {"type": "subtitle", "time": 4969.43, "timestamp": "01:22:49", "text": "索诺亚。没错，这个角色又回来了。"}, {"type": "subtitle", "time": 4972.149, "timestamp": "01:22:52", "text": "Sua就是这么优秀。所以，品牌可以做到"}, {"type": "subtitle", "time": 4975.03, "timestamp": "01:22:55", "text": "很多。但格兰特确实有一个主要问题。"}, {"type": "subtitle", "time": 4977.11, "timestamp": "01:22:57", "text": "缺点在于，他的"}, {"type": "subtitle", "time": 4979.99, "timestamp": "01:22:59", "text": "标志性武器是必备条件。"}]
[{"type": "subtitle", "time": 6009.25, "timestamp": "01:40:09", "text": "我嫁接新的。"}, {"type": "subtitle", "time": 6018.47, "timestamp": "01:40:18", "text": "快点。快点。瞄准点"}, {"type": "subtitle", "time": 6023.51, "timestamp": "01:40:23", "text": "战争。时候到了。"}, {"type": "subtitle", "time": 6042.31, "timestamp": "01:40:42", "text": "件。为什么是黄色？好吧，伙计。我爱"}, {"type": "subtitle", "time": 6044.629, "timestamp": "01:40:44", "text": "我忘了怎么打这个boss了，老兄。我"}, {"type": "subtitle", "time": 6048.07, "timestamp": "01:40:48", "text": "以前想 我以前速通这个"}, {"type": "subtitle", "time": 6050.07, "timestamp": "01:40:50", "text": "我当时正在努力刷资源。"}, {"type": "subtitle", "time": 6051.91, "timestamp": "01:40:51", "text": "用于材料。"}]
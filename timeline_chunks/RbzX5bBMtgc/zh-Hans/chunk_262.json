[{"type": "subtitle", "time": 15720.95, "timestamp": "04:22:00", "text": "我完全不记得了。这就是你"}, {"type": "subtitle", "time": 15723.95, "timestamp": "04:22:03", "text": "你们需要我做你们的引路人。"}, {"type": "subtitle", "time": 15730.87, "timestamp": "04:22:10", "text": "从你抵达的那一刻起"}, {"type": "subtitle", "time": 15733.67, "timestamp": "04:22:13", "text": "晶乔，我对你一直有所怀疑。"}, {"type": "subtitle", "time": 15734.59, "timestamp": "04:22:14", "text": "真的"}, {"type": "subtitle", "time": 15737.189, "timestamp": "04:22:17", "text": "身份。我们前往苍穹山的旅程"}, {"type": "subtitle", "time": 15739.71, "timestamp": "04:22:19", "text": "更加坚定了我的信念。"}, {"type": "subtitle", "time": 15744.269, "timestamp": "04:22:24", "text": "哦，最后，还有那块木板。"}, {"type": "subtitle", "time": 15748.07, "timestamp": "04:22:28", "text": "Sonorosphere 让我确信了真相。我"}, {"type": "subtitle", "time": 15752.149, "timestamp": "04:22:32", "text": "知道了。当然可以，尽管问。我很乐意"}, {"type": "subtitle", "time": 15756.63, "timestamp": "04:22:36", "text": "回答他们。的确，那些记忆"}, {"type": "subtitle", "time": 15765.309, "timestamp": "04:22:45", "text": "[音乐]"}, {"type": "subtitle", "time": 15766.83, "timestamp": "04:22:46", "text": "真实的。"}, {"type": "subtitle", "time": 15770.469, "timestamp": "04:22:50", "text": "是的，那都过去了。只是一个"}, {"type": "subtitle", "time": 15773.59, "timestamp": "04:22:53", "text": "没有名字的小女孩，无家可归。我"}, {"type": "subtitle", "time": 15775.51, "timestamp": "04:22:55", "text": "从未想过我们还能创造新的回忆"}, {"type": "subtitle", "time": 15776.349, "timestamp": "04:22:56", "text": "在"}, {"type": "subtitle", "time": 15778.95, "timestamp": "04:22:58", "text": "声波领域，唯有过去重演"}]
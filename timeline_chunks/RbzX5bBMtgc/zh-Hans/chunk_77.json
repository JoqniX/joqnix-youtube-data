[{"type": "subtitle", "time": 4620.709, "timestamp": "01:17:00", "text": "与中央谐振器协同作用，我"}, {"type": "subtitle", "time": 4622.95, "timestamp": "01:17:02", "text": "我觉得她是个很棒的约会对象，因为她"}, {"type": "subtitle", "time": 4625.03, "timestamp": "01:17:05", "text": "不仅目前对菲比有价值"}, {"type": "subtitle", "time": 4627.63, "timestamp": "01:17:07", "text": "然后，扎尼也可能参与其中。这"}, {"type": "subtitle", "time": 4631.43, "timestamp": "01:17:11", "text": "吉他真漂亮，空气侵蚀"}, {"type": "subtitle", "time": 4634.229, "timestamp": "01:17:14", "text": "团队。我给她打8.5分。"}, {"type": "subtitle", "time": 4637.189, "timestamp": "01:17:17", "text": "满分10分。接下来是银石。"}, {"type": "subtitle", "time": 4638.99, "timestamp": "01:17:18", "text": "说到哨兵"}, {"type": "subtitle", "time": 4641.91, "timestamp": "01:17:21", "text": "谐振器，我不想把它加盖起来"}, {"type": "subtitle", "time": 4643.31, "timestamp": "01:17:23", "text": "我知道她是"}, {"type": "subtitle", "time": 4645.75, "timestamp": "01:17:25", "text": "元。并没有真正受到挑战"}, {"type": "subtitle", "time": 4653.63, "timestamp": "01:17:33", "text": "那么谁呢？"}, {"type": "subtitle", "time": 4658.07, "timestamp": "01:17:38", "text": "是克拉罗塔吗？克拉罗塔是最好的之一"}, {"type": "subtitle", "time": 4661.189, "timestamp": "01:17:41", "text": "全场输出。我觉得每个人"}, {"type": "subtitle", "time": 4663.03, "timestamp": "01:17:43", "text": "他意识到，当……的时候"}, {"type": "subtitle", "time": 4665.83, "timestamp": "01:17:45", "text": "致清障塔：这就是你们的女孩。"}, {"type": "subtitle", "time": 4668.63, "timestamp": "01:17:48", "text": "当你需要有人绝对"}, {"type": "subtitle", "time": 4671.669, "timestamp": "01:17:51", "text": "想痛扁老板？那就打电话给科拉达。"}, {"type": "subtitle", "time": 4674.149, "timestamp": "01:17:54", "text": "她的单体输出最高"}, {"type": "subtitle", "time": 4676.79, "timestamp": "01:17:56", "text": "整个游戏。尤其是在玩游戏的时候"}, {"type": "subtitle", "time": 4679.669, "timestamp": "01:17:59", "text": "她带着她的标志性武器，"}]
[{"type": "subtitle", "time": 15600.55, "timestamp": "04:20:00", "text": "当然可以，尽管问。我很乐意回答这些问题。"}, {"type": "subtitle", "time": 15603.75, "timestamp": "04:20:03", "text": "尽我所能。我的主人和"}, {"type": "subtitle", "time": 15606.389, "timestamp": "04:20:06", "text": "这位神秘访客设下了陷阱。"}, {"type": "subtitle", "time": 15609.03, "timestamp": "04:20:09", "text": "使用 Wichi 的 Sonarosphere"}, {"type": "subtitle", "time": 15611.67, "timestamp": "04:20:11", "text": "游戏伪装。哦，他们把它藏起来了"}, {"type": "subtitle", "time": 15612.67, "timestamp": "04:20:12", "text": "法院"}, {"type": "subtitle", "time": 15615.349, "timestamp": "04:20:15", "text": "桑特。尽管有哨兵和山"}, {"type": "subtitle", "time": 15618.389, "timestamp": "04:20:18", "text": "如果苍穹得以保存，弗雷杜斯就会"}, {"type": "subtitle", "time": 15620.87, "timestamp": "04:20:20", "text": "绝不束手就擒。"}, {"type": "subtitle", "time": 15623.99, "timestamp": "04:20:23", "text": "它们纯属巧合，或者"}, {"type": "subtitle", "time": 15627.349, "timestamp": "04:20:27", "text": "弗雷杜斯的计算运作。这"}, {"type": "subtitle", "time": 15630.469, "timestamp": "04:20:30", "text": "探险家偶然发现了 Wichi 板，"}, {"type": "subtitle", "time": 15633.75, "timestamp": "04:20:33", "text": "触发其防御机制。"}, {"type": "subtitle", "time": 15635.91, "timestamp": "04:20:35", "text": "哨兵在……时就已经受损了。"}, {"type": "subtitle", "time": 15638.71, "timestamp": "04:20:38", "text": "到达这里。我的主人预见到了这一点。"}, {"type": "subtitle", "time": 15640.429, "timestamp": "04:20:40", "text": "将会降临在山上的灾难"}, {"type": "subtitle", "time": 15643.03, "timestamp": "04:20:43", "text": "苍穹，所以他创造了这种机制"}, {"type": "subtitle", "time": 15645.51, "timestamp": "04:20:45", "text": "作为一项预防措施。这"}, {"type": "subtitle", "time": 15647.75, "timestamp": "04:20:47", "text": "索诺罗斯菲尔会吞噬所有"}, {"type": "subtitle", "time": 15651.59, "timestamp": "04:20:51", "text": "除非他们知道，否则试图进入的人不会……"}]
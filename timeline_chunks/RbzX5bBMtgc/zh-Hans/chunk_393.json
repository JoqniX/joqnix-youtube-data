[{"type": "subtitle", "time": 23583.75, "timestamp": "06:33:03", "text": "发生的一切都很有趣。"}, {"type": "subtitle", "time": 23586.23, "timestamp": "06:33:06", "text": "今天。"}, {"type": "subtitle", "time": 23588.31, "timestamp": "06:33:08", "text": "目的地是哪里？我当时很恐慌。"}, {"type": "subtitle", "time": 23600.51, "timestamp": "06:33:20", "text": "我当时很恐慌，因为我弄丢了我的"}, {"type": "subtitle", "time": 23603.39, "timestamp": "06:33:23", "text": "耳塞。呃，当我取下我的"}, {"type": "subtitle", "time": 23607.99, "timestamp": "06:33:27", "text": "耳机、耳塞不知怎么不见了。它"}, {"type": "subtitle", "time": 23612.868, "timestamp": "06:33:32", "text": "有点像飞到了左边的角落"}, {"type": "subtitle", "time": 23614.03, "timestamp": "06:33:34", "text": "你管它叫什么？"}, {"type": "subtitle", "time": 23617.75, "timestamp": "06:33:37", "text": "它？左侧角落。而那"}, {"type": "subtitle", "time": 23622.54, "timestamp": "06:33:42", "text": "很多。"}, {"type": "chat", "time": 23624.518, "timestamp": "06:33:44", "author": "@KosmikZethar", "avatar": "https://yt4.ggpht.com/b_m56i87DkQCWoSLK8J6eGPlt0w4dJQYTlT9PaGPCOWZzEZaUiSe6Q-t3xsz9BESFJqhLP1oHg=s64-c-k-c0x00ffffff-no-rj", "message": "where was it found??"}, {"type": "subtitle", "time": 23625.31, "timestamp": "06:33:45", "text": "[音乐]"}, {"type": "subtitle", "time": 23629.27, "timestamp": "06:33:49", "text": "肯泽尔。那很有意思。"}, {"type": "subtitle", "time": 23632.31, "timestamp": "06:33:52", "text": "然后，呃，我之前吃的那个苹果"}, {"type": "subtitle", "time": 23634.51, "timestamp": "06:33:54", "text": "就像一小时前"}]
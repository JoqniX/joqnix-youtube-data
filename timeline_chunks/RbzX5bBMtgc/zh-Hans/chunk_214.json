[{"type": "subtitle", "time": 12843.349, "timestamp": "03:34:03", "text": "[音乐]"}, {"type": "subtitle", "time": 12846.229, "timestamp": "03:34:06", "text": "我们离得太远了。他听不见。他"}, {"type": "subtitle", "time": 12849.349, "timestamp": "03:34:09", "text": "听不到我们说话。好的。形成的酸"}, {"type": "subtitle", "time": 12851.91, "timestamp": "03:34:11", "text": "处于休眠期的田野。在此期间"}, {"type": "subtitle", "time": 12856.15, "timestamp": "03:34:16", "text": "现在相对安全。好的。期间"}, {"type": "subtitle", "time": 12857.91, "timestamp": "03:34:17", "text": "这段时间是问号休眠期"}, {"type": "subtitle", "time": 12860.07, "timestamp": "03:34:20", "text": "酸场的性质取决于其"}, {"type": "subtitle", "time": 12863.03, "timestamp": "03:34:23", "text": "形成时间。形成时间。知道了。"}, {"type": "subtitle", "time": 12866.229, "timestamp": "03:34:26", "text": "形成时间即休眠期。"}, {"type": "subtitle", "time": 12868.79, "timestamp": "03:34:28", "text": "然而，如果休眠期更长，"}, {"type": "subtitle", "time": 12870.87, "timestamp": "03:34:30", "text": "内在产生的静默不和谐是"}, {"type": "subtitle", "time": 12874.229, "timestamp": "03:34:34", "text": "通常更强劲。通常更强劲。哦，"}, {"type": "subtitle", "time": 12876.71, "timestamp": "03:34:36", "text": "静默场形成速度越快。这"}, {"type": "subtitle", "time": 12879.429, "timestamp": "03:34:39", "text": "休眠期越长。哦，我没有"}, {"type": "subtitle", "time": 12891.99, "timestamp": "03:34:51", "text": "滑翔机不行，希望我没事。"}, {"type": "subtitle", "time": 12894.389, "timestamp": "03:34:54", "text": "那我走了。此外，我只是想"}, {"type": "subtitle", "time": 12896.95, "timestamp": "03:34:56", "text": "斗争。我们得下去。给我"}, {"type": "subtitle", "time": 12899.75, "timestamp": "03:34:59", "text": "一些战斗。"}]
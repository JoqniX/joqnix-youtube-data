[{"type": "subtitle", "time": 27240.548, "timestamp": "07:34:00", "text": "电机，我会拿到……呃，我会能够"}, {"type": "subtitle", "time": 27241.708, "timestamp": "07:34:01", "text": "要得到"}, {"type": "subtitle", "time": 27244.23, "timestamp": "07:34:04", "text": "那它叫什么来着？殴打"}, {"type": "subtitle", "time": 27246.23, "timestamp": "07:34:06", "text": "雷。嗯，是的，我能拿到"}, {"type": "subtitle", "time": 27248.708, "timestamp": "07:34:08", "text": "完成这个。这样就有两个了。"}, {"type": "subtitle", "time": 27252.388, "timestamp": "07:34:12", "text": "完成了，C 也完成了。"}, {"type": "subtitle", "time": 27254.868, "timestamp": "07:34:14", "text": "要么我们速通剧情，然后……"}, {"type": "subtitle", "time": 27258.628, "timestamp": "07:34:18", "text": "到33级，或者我们达到50级船长。"}, {"type": "subtitle", "time": 27261.51, "timestamp": "07:34:21", "text": "并进行事件芯片空间设置。就是这样。"}, {"type": "subtitle", "time": 27263.75, "timestamp": "07:34:23", "text": "我唯一拥有的。所以这就是我为什么会这样想的原因"}, {"type": "subtitle", "time": 27265.43, "timestamp": "07:34:25", "text": "速度飞快，而且喜欢做很多事。"}, {"type": "subtitle", "time": 27267.83, "timestamp": "07:34:27", "text": "鹰眼战舰。好的。所以我选BB。"}, {"type": "subtitle", "time": 27270.31, "timestamp": "07:34:30", "text": "呃，帮我把水添满。所以我会回来的"}, {"type": "subtitle", "time": 27273.91, "timestamp": "07:34:33", "text": "稍等片刻。好的。我一会儿就回来。"}, {"type": "subtitle", "time": 27275.15, "timestamp": "07:34:35", "text": "所以我们是"}, {"type": "subtitle", "time": 27279.19, "timestamp": "07:34:39", "text": "热烈欢迎加入这个家庭！"}, {"type": "subtitle", "time": 27282.07, "timestamp": "07:34:42", "text": "祝你今天过得愉快。谢谢"}, {"type": "subtitle", "time": 27284.788, "timestamp": "07:34:44", "text": "感谢您找到我的频道。哦，不。请让我"}, {"type": "subtitle", "time": 27287.23, "timestamp": "07:34:47", "text": "你知道你是怎么找到我的吗？"}]
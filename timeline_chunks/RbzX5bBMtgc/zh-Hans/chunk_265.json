[{"type": "subtitle", "time": 15904.03, "timestamp": "04:25:04", "text": "谢谢。年轻的孤女抱着"}, {"type": "subtitle", "time": 15908.189, "timestamp": "04:25:08", "text": "在。她所到之处，皆是悲剧。"}, {"type": "subtitle", "time": 15912.469, "timestamp": "04:25:12", "text": "哀悼之情席卷全球，蔓延开来。一个"}, {"type": "subtitle", "time": 15915.429, "timestamp": "04:25:15", "text": "世界被充满怪物的怪物撕裂"}, {"type": "subtitle", "time": 15918.87, "timestamp": "04:25:18", "text": "无家可归的灵魂。用她自己的血"}, {"type": "subtitle", "time": 15921.52, "timestamp": "04:25:21", "text": "火势蔓延，她驾车逃离"}, {"type": "subtitle", "time": 15923.469, "timestamp": "04:25:23", "text": "[音乐]"}, {"type": "subtitle", "time": 15927.269, "timestamp": "04:25:27", "text": "寒冷的。她的主人说：“在这……”"}, {"type": "subtitle", "time": 15930.229, "timestamp": "04:25:30", "text": "动荡的世界，生命脆弱不堪。"}, {"type": "subtitle", "time": 15931.469, "timestamp": "04:25:31", "text": "可能"}, {"type": "subtitle", "time": 15934.79, "timestamp": "04:25:34", "text": "苍蝇。她无法让自己筋疲力尽"}, {"type": "subtitle", "time": 15937.75, "timestamp": "04:25:37", "text": "先救那些在她前面的人。"}, {"type": "subtitle", "time": 15939.389, "timestamp": "04:25:39", "text": "但她必须"}, {"type": "subtitle", "time": 15950.87, "timestamp": "04:25:50", "text": "她运用智慧躲过了伤害。"}, {"type": "subtitle", "time": 15955.03, "timestamp": "04:25:55", "text": "小心翼翼地踩在刀刃上。独自一人"}, {"type": "subtitle", "time": 15956.58, "timestamp": "04:25:56", "text": "通过成熟"}, {"type": "subtitle", "time": 15957.95, "timestamp": "04:25:57", "text": "[音乐]"}]
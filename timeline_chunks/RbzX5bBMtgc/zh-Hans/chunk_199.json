[{"type": "subtitle", "time": 11945.429, "timestamp": "03:19:05", "text": "你醒了。你好。让我看看。谁是"}, {"type": "subtitle", "time": 11948.07, "timestamp": "03:19:08", "text": "这？这两个人是谁？或者"}, {"type": "subtitle", "time": 11950.87, "timestamp": "03:19:10", "text": "我得试试我最后的止痒妙招了。"}, {"type": "subtitle", "time": 11953.55, "timestamp": "03:19:13", "text": "初级巡逻员的应急技能。"}, {"type": "subtitle", "time": 11955.19, "timestamp": "03:19:15", "text": "心肺复苏术。"}, {"type": "subtitle", "time": 11960.79, "timestamp": "03:19:20", "text": "[音乐]"}, {"type": "subtitle", "time": 11964.51, "timestamp": "03:19:24", "text": "从未在任何活人身上这样做过。"}, {"type": "subtitle", "time": 11967.51, "timestamp": "03:19:27", "text": "杰西娅，对不起。对不起。你刚醒"}, {"type": "subtitle", "time": 11971.51, "timestamp": "03:19:31", "text": "而我却在这里滔滔不绝地聊个不停。"}, {"type": "subtitle", "time": 11974.469, "timestamp": "03:19:34", "text": "耶！"}, {"type": "subtitle", "time": 11980.15, "timestamp": "03:19:40", "text": "你还好吗？我的天啊。舒适。"}, {"type": "subtitle", "time": 11982.71, "timestamp": "03:19:42", "text": "你感觉不舒服吗？哦，我们走吧。你"}, {"type": "subtitle", "time": 11985.51, "timestamp": "03:19:45", "text": "是。你可以叫我特里莎。赤煞。"}, {"type": "subtitle", "time": 11988.469, "timestamp": "03:19:48", "text": "她是杨。阳阳。你好，阳阳。"}]
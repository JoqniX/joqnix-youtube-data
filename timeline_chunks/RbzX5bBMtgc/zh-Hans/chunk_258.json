[{"type": "subtitle", "time": 15524.99, "timestamp": "04:18:44", "text": "哦，她买了那么大"}, {"type": "subtitle", "time": 15527.91, "timestamp": "04:18:47", "text": "平板电脑棋盘。你感觉怎么样？"}, {"type": "subtitle", "time": 15530.51, "timestamp": "04:18:50", "text": "漫游者？出色地"}, {"type": "subtitle", "time": 15534.149, "timestamp": "04:18:54", "text": "休息好了。难道你看不出来我一切都很好吗？"}, {"type": "subtitle", "time": 15538.469, "timestamp": "04:18:58", "text": "就坐在你前面。"}]
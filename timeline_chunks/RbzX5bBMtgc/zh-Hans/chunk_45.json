[{"type": "subtitle", "time": 2719.27, "timestamp": "00:45:19", "text": "蜘蛛。哦。该死。"}, {"type": "subtitle", "time": 2733.589, "timestamp": "00:45:33", "text": "你落后了。"}, {"type": "subtitle", "time": 2735.51, "timestamp": "00:45:35", "text": "我们就到此为止了。我们会回来的"}, {"type": "subtitle", "time": 2746.47, "timestamp": "00:45:46", "text": "她太酷了。"}, {"type": "subtitle", "time": 2755.75, "timestamp": "00:45:55", "text": "突发新闻。这位艺术品窃贼已经……"}, {"type": "subtitle", "time": 2757.589, "timestamp": "00:45:57", "text": "被绳之以法。所有货物均已"}, {"type": "subtitle", "time": 2759.51, "timestamp": "00:45:59", "text": "已返回。"}]
[{"type": "subtitle", "time": 4740.95, "timestamp": "01:19:00", "text": "游戏，或许是绝对最好的。我是"}, {"type": "subtitle", "time": 4743.03, "timestamp": "01:19:03", "text": "我得给科拉达打九分（满分九分）。"}, {"type": "subtitle", "time": 4745.669, "timestamp": "01:19:05", "text": "10. 说实话，他是个了不起的角色"}, {"type": "subtitle", "time": 4747.669, "timestamp": "01:19:07", "text": "我真的说不出有什么不好的地方。"}, {"type": "subtitle", "time": 4749.75, "timestamp": "01:19:09", "text": "关于……的事情。下一个说话的角色"}, {"type": "subtitle", "time": 4752.59, "timestamp": "01:19:12", "text": "关于 Roachia。谁的"}, {"type": "subtitle", "time": 4756.79, "timestamp": "01:19:16", "text": "罗伊亚？什么？我的天啊，这太蠢了"}, {"type": "subtitle", "time": 4759.55, "timestamp": "01:19:19", "text": "事物。这个浏览器真是太难用了。"}, {"type": "subtitle", "time": 4763.35, "timestamp": "01:19:23", "text": "特鲁弗·布拉德维克，修好你的神。使固定"}, {"type": "subtitle", "time": 4772.91, "timestamp": "01:19:32", "text": "兄弟。虫子真多。我知道它还是alpha版本，但是"}, {"type": "subtitle", "time": 4781.51, "timestamp": "01:19:41", "text": "罗伊亚。她是一个性格鲜明的角色，因为她"}, {"type": "subtitle", "time": 4783.51, "timestamp": "01:19:43", "text": "发布会并没有取得太多进展。"}, {"type": "subtitle", "time": 4785.75, "timestamp": "01:19:45", "text": "价值。你看，她是一位尽职尽责的人"}, {"type": "subtitle", "time": 4788.149, "timestamp": "01:19:48", "text": "支持 Chamellia，她的五星级"}, {"type": "subtitle", "time": 4790.27, "timestamp": "01:19:50", "text": "支持，"}, {"type": "subtitle", "time": 4793.11, "timestamp": "01:19:53", "text": "但已经"}, {"type": "subtitle", "time": 4796.87, "timestamp": "01:19:56", "text": "因为 Sua 就是那么优秀。罗阿奇亚"}, {"type": "subtitle", "time": 4799.59, "timestamp": "01:19:59", "text": "面临着非常不幸的挑战："}]
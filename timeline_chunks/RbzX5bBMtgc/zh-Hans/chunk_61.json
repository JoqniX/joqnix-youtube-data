[{"type": "subtitle", "time": 3662.03, "timestamp": "01:01:02", "text": "想知道。她有一头红发。她为什么这么……"}, {"type": "subtitle", "time": 3665.19, "timestamp": "01:01:05", "text": "可爱的？这位女士，她为什么如此"}, {"type": "subtitle", "time": 3667.99, "timestamp": "01:01:07", "text": "漂亮的？潮水低语着你的身影。"}, {"type": "subtitle", "time": 3669.51, "timestamp": "01:01:09", "text": "到达。"}, {"type": "subtitle", "time": 3673.19, "timestamp": "01:01:13", "text": "她为什么这么漂亮？"}, {"type": "subtitle", "time": 3675.589, "timestamp": "01:01:15", "text": "潮水低语着你的身影。"}, {"type": "subtitle", "time": 3679.99, "timestamp": "01:01:19", "text": "到达。她为什么这么漂亮？"}, {"type": "subtitle", "time": 3682.95, "timestamp": "01:01:22", "text": "她长得和我新买的模特一模一样。不是"}, {"type": "subtitle", "time": 3686.39, "timestamp": "01:01:26", "text": "没错，但某种程度上又有点类似。"}, {"type": "subtitle", "time": 3688.549, "timestamp": "01:01:28", "text": "那种飘逸的飘逸感，看起来像"}, {"type": "subtitle", "time": 3689.95, "timestamp": "01:01:29", "text": "我的新"}, {"type": "subtitle", "time": 3691.789, "timestamp": "01:01:31", "text": "模型。"}, {"type": "subtitle", "time": 3694.789, "timestamp": "01:01:34", "text": "哇。配色方案有点相似。"}, {"type": "subtitle", "time": 3696.67, "timestamp": "01:01:36", "text": "到"}, {"type": "subtitle", "time": 3699.71, "timestamp": "01:01:39", "text": "我喜欢的那种"}, {"type": "subtitle", "time": 3703.349, "timestamp": "01:01:43", "text": "凉爽的。该死。我想要她。他走了吗？"}, {"type": "subtitle", "time": 3706.589, "timestamp": "01:01:46", "text": "消失了。我也是吗？"}, {"type": "subtitle", "time": 3709.39, "timestamp": "01:01:49", "text": "晚的？我来晚了。不是"}]
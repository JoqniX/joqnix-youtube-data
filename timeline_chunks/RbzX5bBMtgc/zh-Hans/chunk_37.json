[{"type": "subtitle", "time": 2220.31, "timestamp": "00:37:00", "text": "有什么我可以帮到你的吗？"}, {"type": "subtitle", "time": 2222.069, "timestamp": "00:37:02", "text": "她很漂亮。她看起来像我的新"}, {"type": "subtitle", "time": 2229.109, "timestamp": "00:37:09", "text": "她为什么长得像我的新模特？"}, {"type": "subtitle", "time": 2230.95, "timestamp": "00:37:10", "text": "已悄悄告知大家你的到来。几乎"}, {"type": "subtitle", "time": 2232.99, "timestamp": "00:37:12", "text": "靠近我"}, {"type": "subtitle", "time": 2235.51, "timestamp": "00:37:15", "text": "模型。我本可以，我本可以"}, {"type": "subtitle", "time": 2239.72, "timestamp": "00:37:19", "text": "真的抓住她了。"}, {"type": "subtitle", "time": 2253.109, "timestamp": "00:37:33", "text": "我不知道。就像一场有趣的游戏"}, {"type": "subtitle", "time": 2256.39, "timestamp": "00:37:36", "text": "今天会是晴朗的一天。今天将是"}, {"type": "subtitle", "time": 2261.47, "timestamp": "00:37:41", "text": "天气晴朗。我想拿"}, {"type": "subtitle", "time": 2268.95, "timestamp": "00:37:48", "text": "事物。我觉得需要一张新地图之类的。"}, {"type": "subtitle", "time": 2270.9, "timestamp": "00:37:50", "text": "没错。"}, {"type": "subtitle", "time": 2272.27, "timestamp": "00:37:52", "text": "[音乐]"}, {"type": "subtitle", "time": 2275.43, "timestamp": "00:37:55", "text": "别等了，新地图在哪儿？这"}]
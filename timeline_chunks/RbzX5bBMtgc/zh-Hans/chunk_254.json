[{"type": "subtitle", "time": 15243.59, "timestamp": "04:14:03", "text": "我心存感激，想要报答你，所以我"}, {"type": "subtitle", "time": 15245.67, "timestamp": "04:14:05", "text": "希望能在下一部作品中看到Fooling的创作"}, {"type": "subtitle", "time": 15247.91, "timestamp": "04:14:07", "text": "杭龙艺术家特刊。"}, {"type": "subtitle", "time": 15249.99, "timestamp": "04:14:09", "text": "大家都非常想念他们。"}, {"type": "subtitle", "time": 15252.87, "timestamp": "04:14:12", "text": "我最喜欢的风景画家。你是"}, {"type": "subtitle", "time": 15258.389, "timestamp": "04:14:18", "text": "现在情况已经……"}, {"type": "subtitle", "time": 15261.429, "timestamp": "04:14:21", "text": "问题已解决，你应该返回洪辰。"}, {"type": "subtitle", "time": 15263.83, "timestamp": "04:14:23", "text": "你应该好好休息一下。"}, {"type": "subtitle", "time": 15268.03, "timestamp": "04:14:28", "text": "是的。是的。经历了这一切之后"}, {"type": "subtitle", "time": 15273.03, "timestamp": "04:14:33", "text": "很像我。嗯，我觉得辛娥夫人"}, {"type": "subtitle", "time": 15275.189, "timestamp": "04:14:35", "text": "在处理以下事情时可能需要额外的帮助："}, {"type": "subtitle", "time": 15283.99, "timestamp": "04:14:43", "text": "灿烂。天色已晚。或许我们"}, {"type": "subtitle", "time": 15285.83, "timestamp": "04:14:45", "text": "应该等我们回去再讨论。"}, {"type": "subtitle", "time": 15288.57, "timestamp": "04:14:48", "text": "还要别的吗。嗯。"}, {"type": "subtitle", "time": 15295.51, "timestamp": "04:14:55", "text": "Momo，这里有很多事情要做。"}, {"type": "subtitle", "time": 15299.51, "timestamp": "04:14:59", "text": "游戏。我现在才这样做。"}]
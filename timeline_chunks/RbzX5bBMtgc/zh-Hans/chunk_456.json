[{"type": "subtitle", "time": 27401.35, "timestamp": "07:36:41", "text": "[音乐]"}, {"type": "subtitle", "time": 27404.07, "timestamp": "07:36:44", "text": "好了，我回来了。我回来了。我回来了，小子。"}, {"type": "subtitle", "time": 27410.708, "timestamp": "07:36:50", "text": "溪流。弄了些热水。我是"}, {"type": "subtitle", "time": 27412.49, "timestamp": "07:36:52", "text": "隐藏"}]
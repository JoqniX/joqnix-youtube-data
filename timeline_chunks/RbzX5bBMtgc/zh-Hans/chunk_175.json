[{"type": "subtitle", "time": 10501.15, "timestamp": "02:55:01", "text": "简陋的茅草屋"}, {"type": "subtitle", "time": 10504.63, "timestamp": "02:55:04", "text": "小屋。而他曾经的家，"}, {"type": "subtitle", "time": 10508.75, "timestamp": "02:55:08", "text": "只有一片空旷的荒地"}, {"type": "subtitle", "time": 10511.03, "timestamp": "02:55:11", "text": "仍然留了下来。他注意到上面有个日期。"}, {"type": "subtitle", "time": 10513.59, "timestamp": "02:55:13", "text": "这是他从未见过的日历。"}, {"type": "subtitle", "time": 10516.07, "timestamp": "02:55:16", "text": "惊恐之下，他抓住了一名路人，"}, {"type": "subtitle", "time": 10518.95, "timestamp": "02:55:18", "text": "他急切地问道：“打扰一下，你能告诉我吗？”"}, {"type": "subtitle", "time": 10522.15, "timestamp": "02:55:22", "text": "请告诉我当前的日期和时间？我不知道"}, {"type": "subtitle", "time": 10525.51, "timestamp": "02:55:25", "text": "日期和时间。当他听到答案时，"}, {"type": "subtitle", "time": 10526.83, "timestamp": "02:55:26", "text": "他的腿动了"}, {"type": "subtitle", "time": 10529.63, "timestamp": "02:55:29", "text": "虚弱的。一切都曾拥有"}, {"type": "subtitle", "time": 10533.269, "timestamp": "02:55:33", "text": "改变了。时光流逝，他所爱的人"}, {"type": "subtitle", "time": 10535.309, "timestamp": "02:55:35", "text": "其中一个是"}, {"type": "subtitle", "time": 10543.83, "timestamp": "02:55:43", "text": "于是，伐木工离开了芒特。"}, {"type": "subtitle", "time": 10546.55, "timestamp": "02:55:46", "text": "苍穹之下，他为何还活着？"}, {"type": "subtitle", "time": 10549.03, "timestamp": "02:55:49", "text": "带着百年历史的活力"}, {"type": "subtitle", "time": 10551.63, "timestamp": "02:55:51", "text": "他体内的时间？不应该"}, {"type": "subtitle", "time": 10555.91, "timestamp": "02:55:55", "text": "他？你的故事有点离谱。"}, {"type": "subtitle", "time": 10558.95, "timestamp": "02:55:58", "text": "你不觉得吗？我的意思是，如果我不是"}]
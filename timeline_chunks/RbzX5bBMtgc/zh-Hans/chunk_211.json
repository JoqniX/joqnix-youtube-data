[{"type": "subtitle", "time": 12660.95, "timestamp": "03:31:00", "text": "让我看看我自己的片子。说到这个，"}, {"type": "subtitle", "time": 12663.349, "timestamp": "03:31:03", "text": "我们快到了。这里有个箱子。"}, {"type": "subtitle", "time": 12665.67, "timestamp": "03:31:05", "text": "说过我们会和巴见面。她是"}, {"type": "subtitle", "time": 12667.99, "timestamp": "03:31:07", "text": "谐振器。收集所有植物。为什么"}, {"type": "subtitle", "time": 12669.59, "timestamp": "03:31:09", "text": "不是？我能应付她的共鸣"}, {"type": "subtitle", "time": 12671.83, "timestamp": "03:31:11", "text": "我们的能力让我们找到了彼此。"}, {"type": "subtitle", "time": 12674.309, "timestamp": "03:31:14", "text": "峡谷底部。白做了一些初步的工作。"}, {"type": "subtitle", "time": 12677.429, "timestamp": "03:31:17", "text": "为您提供帮助。你好像溺水了。"}, {"type": "subtitle", "time": 12680.79, "timestamp": "03:31:20", "text": "但你的呼吸道是畅通的。你看，这里有"}, {"type": "subtitle", "time": 12683.99, "timestamp": "03:31:23", "text": "那边有个共振信标。当你"}, {"type": "subtitle", "time": 12686.15, "timestamp": "03:31:26", "text": "看到信标，请务必注册并"}, {"type": "subtitle", "time": 12688.63, "timestamp": "03:31:28", "text": "激活它。通常情况下，和Oh在一起是安全的，"}, {"type": "subtitle", "time": 12690.95, "timestamp": "03:31:30", "text": "这边有个箱子。灯塔。它"}, {"type": "subtitle", "time": 12693.11, "timestamp": "03:31:33", "text": "有时可以保护你免受危险。"}, {"type": "subtitle", "time": 12695.269, "timestamp": "03:31:35", "text": "博弗，你能把你的终端递给我吗？"}, {"type": "subtitle", "time": 12696.75, "timestamp": "03:31:36", "text": "为"}, {"type": "subtitle", "time": 12700.229, "timestamp": "03:31:40", "text": "片刻？完毕。它的设计和系统"}, {"type": "subtitle", "time": 12702.87, "timestamp": "03:31:42", "text": "版本与我们的版本不同，但是"}, {"type": "subtitle", "time": 12704.87, "timestamp": "03:31:44", "text": "你的终端仍然保留着数据。"}, {"type": "subtitle", "time": 12713.63, "timestamp": "03:31:53", "text": "终端。哦，这是传送门吗？"}, {"type": "subtitle", "time": 12719.89, "timestamp": "03:31:59", "text": "好的。好，好，好，好"}]
[{"type": "subtitle", "time": 10983.429, "timestamp": "03:03:03", "text": "某物。我想要的就是这个女人。卡内拉"}, {"type": "subtitle", "time": 10987.07, "timestamp": "03:03:07", "text": "有人低声议论你的到来。她看起来"}, {"type": "subtitle", "time": 11023.59, "timestamp": "03:03:43", "text": "[音乐]"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "我水平太差了，老兄。我需要一个级别"}, {"type": "subtitle", "time": 11029.95, "timestamp": "03:03:49", "text": "向上。我情绪低落"}, {"type": "subtitle", "time": 11033.64, "timestamp": "03:03:53", "text": "等级。我什么时候才能达到水平"}, {"type": "subtitle", "time": 11035.79, "timestamp": "03:03:55", "text": "[音乐]"}]
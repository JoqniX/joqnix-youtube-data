[{"type": "subtitle", "time": 8581.11, "timestamp": "02:23:01", "text": "[音乐]"}, {"type": "subtitle", "time": 8583.11, "timestamp": "02:23:03", "text": "殄。"}, {"type": "subtitle", "time": 8585.07, "timestamp": "02:23:05", "text": "我刚刚意识到"}, {"type": "subtitle", "time": 8588.15, "timestamp": "02:23:08", "text": "某物。每个怪物的出现原因都是"}, {"type": "subtitle", "time": 8591.51, "timestamp": "02:23:11", "text": "真的是因为我是黄色的，所以才这么黄。"}, {"type": "subtitle", "time": 8592.99, "timestamp": "02:23:12", "text": "等级"}, {"type": "subtitle", "time": 8599.59, "timestamp": "02:23:19", "text": "70级，而且所有怪物的等级都在70级以上。"}, {"type": "subtitle", "time": 8603.83, "timestamp": "02:23:23", "text": "我现在等级太低了。"}, {"type": "subtitle", "time": 8607.04, "timestamp": "02:23:27", "text": "睁大眼睛。"}, {"type": "subtitle", "time": 8608.23, "timestamp": "02:23:28", "text": "[音乐]"}, {"type": "subtitle", "time": 8637.67, "timestamp": "02:23:57", "text": "重新装弹。"}]
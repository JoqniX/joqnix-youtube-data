[{"type": "subtitle", "time": 5103.189, "timestamp": "01:25:03", "text": "还有其他一些东西，她就像一阵风。"}, {"type": "subtitle", "time": 5105.07, "timestamp": "01:25:05", "text": "风"}, {"type": "subtitle", "time": 5108.22, "timestamp": "01:25:08", "text": "元素和"}, {"type": "subtitle", "time": 5110.59, "timestamp": "01:25:10", "text": "[音乐]"}, {"type": "subtitle", "time": 5112.95, "timestamp": "01:25:12", "text": "一切又重新开始了。让我玩所有游戏"}, {"type": "subtitle", "time": 5124.95, "timestamp": "01:25:24", "text": "从战术角度来说，我得到了"}, {"type": "subtitle", "time": 5128.31, "timestamp": "01:25:28", "text": "菲奥里。清除。"}, {"type": "subtitle", "time": 5129.55, "timestamp": "01:25:29", "text": "在哪里？"}, {"type": "subtitle", "time": 5134.87, "timestamp": "01:25:34", "text": "她？我今天过得不错，对吧？如果我达到"}, {"type": "subtitle", "time": 5136.99, "timestamp": "01:25:36", "text": "她一直到"}, {"type": "subtitle", "time": 5141.59, "timestamp": "01:25:41", "text": "核心是让她看到我目前的状况"}, {"type": "subtitle", "time": 5147.39, "timestamp": "01:25:47", "text": "现在的主力队就是"}, {"type": "subtitle", "time": 5151.11, "timestamp": "01:25:51", "text": "卡拉和肖守门员，我在这里"}, {"type": "subtitle", "time": 5153.03, "timestamp": "01:25:53", "text": "遵从你的意愿。我没有第二个"}, {"type": "subtitle", "time": 5155.27, "timestamp": "01:25:55", "text": "团队尚未组建。"}, {"type": "subtitle", "time": 5159.83, "timestamp": "01:25:59", "text": "第二队我只是在用“像”这个词。"}]
[{"type": "subtitle", "time": 18240.31, "timestamp": "05:04:00", "text": "我说我想把它们更好地融合在一起。"}, {"type": "subtitle", "time": 18242.868, "timestamp": "05:04:02", "text": "因此，我得到了我当前的版本。"}, {"type": "subtitle", "time": 18246.15, "timestamp": "05:04:06", "text": "呃，等我们找到那个女孩，我就可以……"}, {"type": "subtitle", "time": 18249.19, "timestamp": "05:04:09", "text": "发布模型设计。是的，"}, {"type": "subtitle", "time": 18251.27, "timestamp": "05:04:11", "text": "最初我想要两种不同的"}, {"type": "subtitle", "time": 18254.07, "timestamp": "05:04:14", "text": "版本。蓝色版本，粉色呃紫色"}, {"type": "subtitle", "time": 18257.99, "timestamp": "05:04:17", "text": "版本，紫色靛蓝版本，但是那个"}, {"type": "subtitle", "time": 18260.59, "timestamp": "05:04:20", "text": "那需要额外付费。"}, {"type": "subtitle", "time": 18263.31, "timestamp": "05:04:23", "text": "不，它会"}, {"type": "subtitle", "time": 18267.99, "timestamp": "05:04:27", "text": "所以，我没办法开口问我姨妈的妈妈"}, {"type": "subtitle", "time": 18275.51, "timestamp": "05:04:35", "text": "只有我才能决定这是否像是……"}, {"type": "subtitle", "time": 18278.628, "timestamp": "05:04:38", "text": "太强了。我听说最终将由我一人决定。"}, {"type": "chat", "time": 18288.271, "timestamp": "05:04:48", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "yeah carlotta is good"}, {"type": "chat", "time": 18296.642, "timestamp": "05:04:56", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "i use her on my main team rn"}]
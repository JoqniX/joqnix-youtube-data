[{"type": "subtitle", "time": 12122.87, "timestamp": "03:22:02", "text": "我看见你。哦，他们俩放在一起真不错。"}, {"type": "subtitle", "time": 12125.87, "timestamp": "03:22:05", "text": "现在对其他人来说……"}, {"type": "subtitle", "time": 12132.429, "timestamp": "03:22:12", "text": "[音乐]"}, {"type": "subtitle", "time": 12135.469, "timestamp": "03:22:15", "text": "出色地。第一章，第一幕"}, {"type": "subtitle", "time": 12140.15, "timestamp": "03:22:20", "text": "一。上帝啊，每一次都是如此。我的天啊。"}, {"type": "subtitle", "time": 12142.429, "timestamp": "03:22:22", "text": "但有一件事……"}, {"type": "subtitle", "time": 12146.07, "timestamp": "03:22:26", "text": "游戏100%确定。我的天啊。看看"}, {"type": "subtitle", "time": 12154.55, "timestamp": "03:22:34", "text": "我的天哪！哦，它卡在60了。"}, {"type": "subtitle", "time": 12163.309, "timestamp": "03:22:43", "text": "啊，我们需要120帧。它是"}, {"type": "subtitle", "time": 12169.55, "timestamp": "03:22:49", "text": "在。我的电脑运行情况如何"}, {"type": "subtitle", "time": 12173.11, "timestamp": "03:22:53", "text": "这？糟糕。它实际上正在处理"}, {"type": "subtitle", "time": 12176.229, "timestamp": "03:22:56", "text": "实际上，还不错。哇。我会玩"}, {"type": "subtitle", "time": 12178.389, "timestamp": "03:22:58", "text": "全部设置。好的，我会关掉"}]
[{"type": "subtitle", "time": 12314.87, "timestamp": "03:25:14", "text": "哦，不错。他会记得如何战斗"}, {"type": "subtitle", "time": 12317.11, "timestamp": "03:25:17", "text": "尽管他已经忘记了一切。"}, {"type": "subtitle", "time": 12320.87, "timestamp": "03:25:20", "text": "哇。下次等着瞧我冲锋陷阵吧。"}, {"type": "subtitle", "time": 12323.19, "timestamp": "03:25:23", "text": "那是一只兔子。我杀了一只兔子。我"}, {"type": "subtitle", "time": 12326.55, "timestamp": "03:25:26", "text": "意思是，奇莎，"}, {"type": "subtitle", "time": 12330.429, "timestamp": "03:25:30", "text": "这很有趣。桑迪"}]
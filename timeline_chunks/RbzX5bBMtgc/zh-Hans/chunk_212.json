[{"type": "subtitle", "time": 12733.63, "timestamp": "03:32:13", "text": "好的。我们快要到达美丽的"}, {"type": "subtitle", "time": 12736.389, "timestamp": "03:32:16", "text": "入口。会有一段下降期，但是"}, {"type": "subtitle", "time": 12738.83, "timestamp": "03:32:18", "text": "如果你是我的闹钟"}, {"type": "subtitle", "time": 12741.91, "timestamp": "03:32:21", "text": "响了。早上7点闹钟。一旦你离开"}, {"type": "subtitle", "time": 12744.229, "timestamp": "03:32:24", "text": "从峡谷到那里，只需步行很短一段路即可。"}, {"type": "subtitle", "time": 12753.269, "timestamp": "03:32:33", "text": "京州是最安全的地方。我们走吧。"}, {"type": "subtitle", "time": 12755.67, "timestamp": "03:32:35", "text": "共振连接提供覆盖范围。"}, {"type": "subtitle", "time": 12758.15, "timestamp": "03:32:38", "text": "这是 Ginchin 的最新更新。一个"}, {"type": "subtitle", "time": 12760.389, "timestamp": "03:32:40", "text": "是的，它具有保护屏障，而且很坚固。"}, {"type": "subtitle", "time": 12763.91, "timestamp": "03:32:43", "text": "原神2.0。"}, {"type": "subtitle", "time": 12766.389, "timestamp": "03:32:46", "text": "是的。"}, {"type": "subtitle", "time": 12768.79, "timestamp": "03:32:48", "text": "京州位于沙漠高地之间"}, {"type": "subtitle", "time": 12771.269, "timestamp": "03:32:51", "text": "以及普通的荒地。它在一艘船上"}, {"type": "subtitle", "time": 12773.91, "timestamp": "03:32:53", "text": "城市和堡垒。这非常关键"}, {"type": "subtitle", "time": 12776.55, "timestamp": "03:32:56", "text": "为了安全"}, {"type": "subtitle", "time": 12779.349, "timestamp": "03:32:59", "text": "嗯？我们已同意与白见面。"}]
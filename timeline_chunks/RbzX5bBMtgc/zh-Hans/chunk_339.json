[{"type": "subtitle", "time": 20340.83, "timestamp": "05:39:00", "text": "东西。我得走了，"}, {"type": "subtitle", "time": 20345.43, "timestamp": "05:39:05", "text": "兄弟。兄弟，我得走了。你是吗？你是"}, {"type": "subtitle", "time": 20347.91, "timestamp": "05:39:07", "text": "你现在是在跟我开玩笑吧？我有"}, {"type": "subtitle", "time": 20349.99, "timestamp": "05:39:09", "text": "一路前往新地区"}, {"type": "subtitle", "time": 20351.628, "timestamp": "05:39:11", "text": "要做"}, {"type": "subtitle", "time": 20353.948, "timestamp": "05:39:13", "text": "编号。"}, {"type": "subtitle", "time": 20357.47, "timestamp": "05:39:17", "text": "不，老虎。我打算跳过"}, {"type": "subtitle", "time": 20360.47, "timestamp": "05:39:20", "text": "你。好的，我要……"}, {"type": "subtitle", "time": 20363.548, "timestamp": "05:39:23", "text": "[音乐]"}, {"type": "subtitle", "time": 20367.28, "timestamp": "05:39:27", "text": "跳过。我可能真的会跳过马虎。"}]
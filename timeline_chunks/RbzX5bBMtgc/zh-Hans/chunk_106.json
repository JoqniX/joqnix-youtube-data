[{"type": "subtitle", "time": 6362.709, "timestamp": "01:46:02", "text": "难的。呃，那里有一个信标和一个区域"}, {"type": "subtitle", "time": 6365.35, "timestamp": "01:46:05", "text": "任务和漏洞"}, {"type": "subtitle", "time": 6367.07, "timestamp": "01:46:07", "text": "[音乐]"}, {"type": "subtitle", "time": 6370.03, "timestamp": "01:46:10", "text": "收集虫子。我全部都拿到了"}, {"type": "subtitle", "time": 6372.709, "timestamp": "01:46:12", "text": "胸部。共振信标。在哪里？"}, {"type": "subtitle", "time": 6380.87, "timestamp": "01:46:20", "text": "不，在前一个区域，因为因为"}, {"type": "subtitle", "time": 6390.07, "timestamp": "01:46:30", "text": "好的。好的。我们先来……嗯……我在哪儿？"}, {"type": "subtitle", "time": 6392.47, "timestamp": "01:46:32", "text": "我？我在这里，对吧？灯丝村。"}]
[{"type": "subtitle", "time": 15660.149, "timestamp": "04:21:00", "text": "啊，正是如此。唯一的逃脱方法"}, {"type": "subtitle", "time": 15663.11, "timestamp": "04:21:03", "text": "是通过燃烧声层来实现的，而没有"}, {"type": "subtitle", "time": 15665.429, "timestamp": "04:21:05", "text": "伤害屋内任何人。"}, {"type": "subtitle", "time": 15669.75, "timestamp": "04:21:09", "text": "这需要对Forte有精湛的掌控力。"}, {"type": "subtitle", "time": 15673.189, "timestamp": "04:21:13", "text": "回想起来，那很可能是他的。"}, {"type": "subtitle", "time": 15680.469, "timestamp": "04:21:20", "text": "那是他的第一个进球。"}, {"type": "subtitle", "time": 15682.79, "timestamp": "04:21:22", "text": "声波层。"}, {"type": "subtitle", "time": 15685.349, "timestamp": "04:21:25", "text": "第二个。"}, {"type": "subtitle", "time": 15688.389, "timestamp": "04:21:28", "text": "临行前，师父嘱咐我……"}, {"type": "subtitle", "time": 15692.469, "timestamp": "04:21:32", "text": "一项寻找此人的任务。这"}, {"type": "subtitle", "time": 15695.269, "timestamp": "04:21:35", "text": "和他一起玩 Wii 游戏机的人。那个人"}, {"type": "subtitle", "time": 15699.349, "timestamp": "04:21:39", "text": "留下了那项比赛纪录。来了。"}, {"type": "subtitle", "time": 15702.149, "timestamp": "04:21:42", "text": "师父去世后，她就会……"}, {"type": "subtitle", "time": 15704.75, "timestamp": "04:21:44", "text": "唯一能控制的人"}, {"type": "subtitle", "time": 15707.99, "timestamp": "04:21:47", "text": "声波球。到现在，你应该知道"}, {"type": "subtitle", "time": 15711.55, "timestamp": "04:21:51", "text": "她是谁？那是"}, {"type": "subtitle", "time": 15715.189, "timestamp": "04:21:55", "text": "我。是我吗？"}]
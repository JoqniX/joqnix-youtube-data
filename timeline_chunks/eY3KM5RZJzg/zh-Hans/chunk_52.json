[{"type": "subtitle", "time": 3124.95, "timestamp": "00:52:04", "text": "我不认识那里的人，好吧，反正没关系。"}, {"type": "subtitle", "time": 3135.99, "timestamp": "00:52:15", "text": "我死了，但我肩负着保护你的使命。"}, {"type": "subtitle", "time": 3137.87, "timestamp": "00:52:17", "text": "必须这样做"}, {"type": "subtitle", "time": 3141.27, "timestamp": "00:52:21", "text": "我必须这么做"}, {"type": "subtitle", "time": 3143.87, "timestamp": "00:52:23", "text": "这就是我为什么没和你在一起的原因。"}, {"type": "subtitle", "time": 3151.87, "timestamp": "00:52:31", "text": "因为我在我的表弟"}]
[{"type": "subtitle", "time": 14581.03, "timestamp": "04:03:01", "text": "任务别告诉他你们你们"}, {"type": "subtitle", "time": 14583.95, "timestamp": "04:03:03", "text": "听不到我的声音"}, {"type": "subtitle", "time": 14586.91, "timestamp": "04:03:06", "text": "喂喂，我们能听到你们的声音，我们开始吧"}, {"type": "subtitle", "time": 14591.91, "timestamp": "04:03:11", "text": "对了，我们需要食物。"}, {"type": "subtitle", "time": 14594.389, "timestamp": "04:03:14", "text": "死去，这样我就再也听不到声音了。"}, {"type": "subtitle", "time": 14596.79, "timestamp": "04:03:16", "text": "你们知道，这样更好。"}, {"type": "subtitle", "time": 14600.11, "timestamp": "04:03:20", "text": "就像向右走一样"}, {"type": "subtitle", "time": 14604.71, "timestamp": "04:03:24", "text": "现在，她说了什么？你能……？"}, {"type": "subtitle", "time": 14616.87, "timestamp": "04:03:36", "text": "哦，对了，我很快就要买新的了。"}, {"type": "subtitle", "time": 14618.79, "timestamp": "04:03:38", "text": "没错，我"}, {"type": "subtitle", "time": 14623.03, "timestamp": "04:03:43", "text": "你打算玩什么游戏？"}, {"type": "subtitle", "time": 14625.67, "timestamp": "04:03:45", "text": "伙计们，你们有吗？"}, {"type": "subtitle", "time": 14628.51, "timestamp": "04:03:48", "text": "床，你为什么想要床？呃，我们需要一张"}, {"type": "subtitle", "time": 14630.87, "timestamp": "04:03:50", "text": "在我们挖矿的时候设置检查点"}, {"type": "subtitle", "time": 14633.55, "timestamp": "04:03:53", "text": "我们没想到的是，如果我们打破了"}, {"type": "subtitle", "time": 14637.269, "timestamp": "04:03:57", "text": "这张床会将我们送回原点"}]
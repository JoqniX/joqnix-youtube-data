[{"type": "subtitle", "time": 10381.99, "timestamp": "02:53:01", "text": "我的天啊，这个地方是"}, {"type": "subtitle", "time": 10384.02, "timestamp": "02:53:04", "text": "痛苦的生活并非"}, {"type": "subtitle", "time": 10420.91, "timestamp": "02:53:40", "text": "推杆也，守护天使在哪里？"}, {"type": "subtitle", "time": 10424.389, "timestamp": "02:53:44", "text": "剑哦耶耶呃，我们去吧"}, {"type": "subtitle", "time": 10427.15, "timestamp": "02:53:47", "text": "我记得那个豪宅，没有"}, {"type": "subtitle", "time": 10430.95, "timestamp": "02:53:50", "text": "不不不，别提了，呃，我当时在想的那件事"}, {"type": "subtitle", "time": 10435.15, "timestamp": "02:53:55", "text": "向您展示它就在附近"}, {"type": "subtitle", "time": 10436.59, "timestamp": "02:53:56", "text": "这"}, {"type": "subtitle", "time": 10438.19, "timestamp": "02:53:58", "text": "房子"}]
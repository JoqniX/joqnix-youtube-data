[{"type": "subtitle", "time": 13261.11, "timestamp": "03:41:01", "text": "不是她给什么我就给你什么。"}, {"type": "subtitle", "time": 13265.71, "timestamp": "03:41:05", "text": "我的天啊，我不想，我只是"}, {"type": "subtitle", "time": 13268.87, "timestamp": "03:41:08", "text": "想说的是，我们来做点什么吧"}, {"type": "subtitle", "time": 13271.349, "timestamp": "03:41:11", "text": "一个团队是的击杀"}, {"type": "subtitle", "time": 13275.71, "timestamp": "03:41:15", "text": "德拉格干掉德拉格，我们走吧"}, {"type": "subtitle", "time": 13277.59, "timestamp": "03:41:17", "text": "那就是"}, {"type": "subtitle", "time": 13282.51, "timestamp": "03:41:22", "text": "任务我我谁谁谁的诊断玩家"}, {"type": "subtitle", "time": 13285.309, "timestamp": "03:41:25", "text": "你看，事情是这样的，他说……"}, {"type": "subtitle", "time": 13288.87, "timestamp": "03:41:28", "text": "我们将获得丰厚的回报"}, {"type": "subtitle", "time": 13292.63, "timestamp": "03:41:32", "text": "我们整个团队都提交了一份报告，我当时就像……"}, {"type": "subtitle", "time": 13295.429, "timestamp": "03:41:35", "text": "哦，这是奖励，所以我们应该这样做。"}, {"type": "subtitle", "time": 13299.349, "timestamp": "03:41:39", "text": "但是，你们在谈论的就是它。"}, {"type": "subtitle", "time": 13303.51, "timestamp": "03:41:43", "text": "几乎没有类似的材料"}, {"type": "subtitle", "time": 13307.95, "timestamp": "03:41:47", "text": "虽然是的，接受这个方案"}, {"type": "subtitle", "time": 13311.55, "timestamp": "03:41:51", "text": "这个乔可不是你的垃圾场。"}, {"type": "subtitle", "time": 13314.469, "timestamp": "03:41:54", "text": "等等，我还没收到"}, {"type": "subtitle", "time": 13318.149, "timestamp": "03:41:58", "text": "没关系，你想让我单挑他吗？"}]
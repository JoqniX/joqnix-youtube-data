[{"type": "subtitle", "time": 1442.47, "timestamp": "00:24:02", "text": "做说"}, {"type": "subtitle", "time": 1447.029, "timestamp": "00:24:07", "text": "关于我无法演示的内容，我有一个任务。"}, {"type": "subtitle", "time": 1456.669, "timestamp": "00:24:16", "text": "我必须小心谨慎"}, {"type": "subtitle", "time": 1460.23, "timestamp": "00:24:20", "text": "滑动滑动"}, {"type": "subtitle", "time": 1476.63, "timestamp": "00:24:36", "text": "一个番茄，不是番茄，呃呃，我能理解为什么"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "它刚才是不是说了番茄？什么？什么？"}, {"type": "subtitle", "time": 1483.029, "timestamp": "00:24:43", "text": "见鬼，它为什么突然说“番茄你好”？"}, {"type": "subtitle", "time": 1484.389, "timestamp": "00:24:44", "text": "那是一个"}, {"type": "subtitle", "time": 1492.07, "timestamp": "00:24:52", "text": "今晚我的大脑一片空白"}]
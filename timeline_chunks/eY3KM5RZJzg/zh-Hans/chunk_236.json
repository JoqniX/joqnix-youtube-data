[{"type": "subtitle", "time": 14172.349, "timestamp": "03:56:12", "text": "我正在拿我的东西，我正在拿"}, {"type": "subtitle", "time": 14175.429, "timestamp": "03:56:15", "text": "我丢了东西，你知道我为此哭过吗？"}, {"type": "subtitle", "time": 14178.07, "timestamp": "03:56:18", "text": "我想要回我的 Tap St，我"}, {"type": "subtitle", "time": 14181.51, "timestamp": "03:56:21", "text": "他玩Apex的时候哭了"}, {"type": "subtitle", "time": 14185.309, "timestamp": "03:56:25", "text": "当时我哭了，是的，我和他"}, {"type": "subtitle", "time": 14189.59, "timestamp": "03:56:29", "text": "对，他在直播里哭了。"}, {"type": "subtitle", "time": 14194.95, "timestamp": "03:56:34", "text": "我死了，你知道，我真的死了，伙计，死在我的东西上。"}, {"type": "subtitle", "time": 14199.349, "timestamp": "03:56:39", "text": "这一切如此不公，你是谁？"}, {"type": "subtitle", "time": 14209.87, "timestamp": "03:56:49", "text": "等等，祖基，祖基，我该怎么办？呃，我想……"}, {"type": "subtitle", "time": 14211.269, "timestamp": "03:56:51", "text": "有"}, {"type": "subtitle", "time": 14215.59, "timestamp": "03:56:55", "text": "紫色头盔，所以如果我呃放一个"}, {"type": "subtitle", "time": 14218.79, "timestamp": "03:56:58", "text": "附魔效果，但皮革是+1。"}]
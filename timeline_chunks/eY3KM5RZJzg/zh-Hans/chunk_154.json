[{"type": "subtitle", "time": 9248.75, "timestamp": "02:34:08", "text": "没关系，事情就是这样，对吧？"}, {"type": "subtitle", "time": 9251.71, "timestamp": "02:34:11", "text": "事情是这样的，拖拽诺尔非常非常"}, {"type": "subtitle", "time": 9254.349, "timestamp": "02:34:14", "text": "如果你杀了他，他现在就像被强化了一样。"}, {"type": "subtitle", "time": 9255.79, "timestamp": "02:34:15", "text": "这对你有好处，你可以留住他"}, {"type": "subtitle", "time": 9258.87, "timestamp": "02:34:18", "text": "东西没问题，但是我需要我的呃"}, {"type": "subtitle", "time": 9261.55, "timestamp": "02:34:21", "text": "虽然我的主要武器已经给了你"}, {"type": "subtitle", "time": 9263.23, "timestamp": "02:34:23", "text": "我给了你一件不错的武器，对吧？"}, {"type": "subtitle", "time": 9264.95, "timestamp": "02:34:24", "text": "不够，你没明白。"}, {"type": "subtitle", "time": 9267.389, "timestamp": "02:34:27", "text": "我没收到这个，不，我收到了，我重置了。"}, {"type": "subtitle", "time": 9270.51, "timestamp": "02:34:30", "text": "服务器重置时，库存被清空了。"}, {"type": "subtitle", "time": 9273.51, "timestamp": "02:34:33", "text": "把那东西弄坏了，实际上我"}, {"type": "subtitle", "time": 9277.55, "timestamp": "02:34:37", "text": "我发现我的目标是我的"}, {"type": "subtitle", "time": 9281.59, "timestamp": "02:34:41", "text": "首先，目的到底是什么？"}, {"type": "subtitle", "time": 9282.51, "timestamp": "02:34:42", "text": "这"}, {"type": "subtitle", "time": 9285.309, "timestamp": "02:34:45", "text": "操，那种地方真够呛，等等，你想要什么？"}, {"type": "subtitle", "time": 9287.309, "timestamp": "02:34:47", "text": "虽然我还是会选择其中一个或普通的那个。"}, {"type": "subtitle", "time": 9289.269, "timestamp": "02:34:49", "text": "想要一个好的，就给那个真正的。"}, {"type": "subtitle", "time": 9290.15, "timestamp": "02:34:50", "text": "这"}, {"type": "subtitle", "time": 9294.11, "timestamp": "02:34:54", "text": "是啊，等等，等等，你给了吗？"}, {"type": "subtitle", "time": 9298.87, "timestamp": "02:34:58", "text": "回到三月，我们的礼物"}]
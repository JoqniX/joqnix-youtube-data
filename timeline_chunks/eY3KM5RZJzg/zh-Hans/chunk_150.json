[{"type": "subtitle", "time": 9000.99, "timestamp": "02:30:00", "text": "伙计们，真的吗？我能收到我的Quest吗？"}, {"type": "subtitle", "time": 9003.51, "timestamp": "02:30:03", "text": "我还有事要办。"}, {"type": "subtitle", "time": 9007.07, "timestamp": "02:30:07", "text": "呃，你知道吗，乔，直接私信我吧。"}, {"type": "subtitle", "time": 9008.67, "timestamp": "02:30:08", "text": "我会马上给你这些东西。"}, {"type": "subtitle", "time": 9012.03, "timestamp": "02:30:12", "text": "现在因为 L，而且可能由于"}, {"type": "subtitle", "time": 9014.269, "timestamp": "02:30:14", "text": "周三我会把它修好，因为我不得不这么做。"}, {"type": "subtitle", "time": 9017.309, "timestamp": "02:30:17", "text": "今天做，但我明天要考试，所以我"}, {"type": "subtitle", "time": 9018.51, "timestamp": "02:30:18", "text": "有点像"}, {"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "顺便说一句，我很忙。嗯，呃，我有"}, {"type": "subtitle", "time": 9024.389, "timestamp": "02:30:24", "text": "对你来说，这是另一笔交易，非常"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "现在你知道这可是有利可图的交易了。"}, {"type": "subtitle", "time": 9029.59, "timestamp": "02:30:29", "text": "发送给鱼的鱼已经损失了很多"}, {"type": "subtitle", "time": 9031.71, "timestamp": "02:30:31", "text": "你能给他的东西吗？哦，是的，我有"}, {"type": "subtitle", "time": 9034.83, "timestamp": "02:30:34", "text": "他得到了工具，但魔法却……"}, {"type": "subtitle", "time": 9037.389, "timestamp": "02:30:37", "text": "不在上面，嗯，就给他吧"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "附魔桌就像附魔一样，你可以做一个"}, {"type": "subtitle", "time": 9043.83, "timestamp": "02:30:43", "text": "给我点东西，比如私信我或者发给我。"}, {"type": "subtitle", "time": 9047.19, "timestamp": "02:30:47", "text": "在 Discord 的消息区，我会"}, {"type": "subtitle", "time": 9048.95, "timestamp": "02:30:48", "text": "明天之前送到你那儿，好吗？"}, {"type": "subtitle", "time": 9052.23, "timestamp": "02:30:52", "text": "明天能不能给你？我也不知道。"}, {"type": "subtitle", "time": 9055.03, "timestamp": "02:30:55", "text": "我看到一张幻灯片，那是谁的赃物？我可以吗？"}, {"type": "subtitle", "time": 9058.429, "timestamp": "02:30:58", "text": "拿去吧，拿去吧，就在那里。"}]
[{"type": "subtitle", "time": 4503.83, "timestamp": "01:15:03", "text": "本来应该藏一些的，但是……"}, {"type": "subtitle", "time": 4509.629, "timestamp": "01:15:09", "text": "发生了什么事，哦，我的天哪"}, {"type": "subtitle", "time": 4516.39, "timestamp": "01:15:16", "text": "天哪，服务器卡顿得要命，我当时在冰上"}, {"type": "subtitle", "time": 4520.27, "timestamp": "01:15:20", "text": "与北极熊家族一起成长"}, {"type": "subtitle", "time": 4525.07, "timestamp": "01:15:25", "text": "从昨天开始，在路上，还有"}, {"type": "subtitle", "time": 4530.189, "timestamp": "01:15:30", "text": "我死了，伙计，怎么会这样，我死了。"}, {"type": "subtitle", "time": 4533.59, "timestamp": "01:15:33", "text": "我当时是在嘲笑水龙头里的水吗？"}, {"type": "subtitle", "time": 4536.79, "timestamp": "01:15:36", "text": "没有木板就跳过水面，我做到了。"}, {"type": "subtitle", "time": 4539.709, "timestamp": "01:15:39", "text": "很多次都非常完美，而且"}, {"type": "subtitle", "time": 4541.79, "timestamp": "01:15:41", "text": "意外，我不知道发生了什么。"}, {"type": "subtitle", "time": 4543.629, "timestamp": "01:15:43", "text": "好像有冰之类的东西……"}, {"type": "subtitle", "time": 4547.43, "timestamp": "01:15:47", "text": "挡住了，所以我一直在摔倒"}, {"type": "subtitle", "time": 4549.31, "timestamp": "01:15:49", "text": "服务器在中间出现了延迟"}, {"type": "subtitle", "time": 4552.669, "timestamp": "01:15:52", "text": "处理我试图向上移动时，我卡住了，而且"}, {"type": "subtitle", "time": 4555.27, "timestamp": "01:15:55", "text": "系统卡顿，我被困在冰里了。"}, {"type": "subtitle", "time": 4557.189, "timestamp": "01:15:57", "text": "然后当服务器"}, {"type": "subtitle", "time": 4559.59, "timestamp": "01:15:59", "text": "重新连接后，我又动不了了。"}]
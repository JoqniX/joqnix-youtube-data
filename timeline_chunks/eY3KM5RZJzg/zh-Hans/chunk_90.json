[{"type": "subtitle", "time": 5408.629, "timestamp": "01:30:08", "text": "找到这个，它不在这里，我的天哪"}, {"type": "subtitle", "time": 5410.87, "timestamp": "01:30:10", "text": "在哪里？"}, {"type": "subtitle", "time": 5413.75, "timestamp": "01:30:13", "text": "那"}, {"type": "subtitle", "time": 5422.91, "timestamp": "01:30:22", "text": "绝对不行，呃，如果我回到我发现的地方……"}, {"type": "subtitle", "time": 5425.39, "timestamp": "01:30:25", "text": "胸部动作或许会有帮助哦"}, {"type": "subtitle", "time": 5428.39, "timestamp": "01:30:28", "text": "是啊是啊是啊，不错，我的想法很好。"}, {"type": "subtitle", "time": 5443.39, "timestamp": "01:30:43", "text": "你要找的就是头盔。"}, {"type": "subtitle", "time": 5449.59, "timestamp": "01:30:49", "text": "头盔没问题，这次我没有戴头盔。"}, {"type": "subtitle", "time": 5451.47, "timestamp": "01:30:51", "text": "头盔好了好了好了，我在里面"}, {"type": "subtitle", "time": 5458.91, "timestamp": "01:30:58", "text": "它从哪里来？"}]
[{"type": "subtitle", "time": 10159.67, "timestamp": "02:49:19", "text": "嗯，只是一个"}, {"type": "subtitle", "time": 10161.75, "timestamp": "02:49:21", "text": "有些ORS（例如，如果你打破）"}, {"type": "subtitle", "time": 10164.91, "timestamp": "02:49:24", "text": "他们会给你带来经验。"}, {"type": "subtitle", "time": 10167.91, "timestamp": "02:49:27", "text": "嗯，比如说"}, {"type": "subtitle", "time": 10174.19, "timestamp": "02:49:34", "text": "煤炭？如果你现在打破一块煤块的话。"}, {"type": "subtitle", "time": 10177.87, "timestamp": "02:49:37", "text": "你可以从中获得经验，比如"}, {"type": "subtitle", "time": 10180.95, "timestamp": "02:49:40", "text": "试着把这两个人分开"}, {"type": "subtitle", "time": 10184.87, "timestamp": "02:49:44", "text": "嗯哼，看来你正在积累经验。"}, {"type": "chat", "time": 10187.282, "timestamp": "02:49:47", "author": "@Taki_Senpai_BR546", "avatar": "https://yt4.ggpht.com/ThfnGS21LkQSrfzFCJRIzIANI4k_WsI4LLRu8hjRC8neJ5g4y2guLDsccLV9KWybxhCVcJ3yrQ=s64-c-k-c0x00ffffff-no-rj", "message": "i will have to leave. My phone is charging now. i see you another day."}, {"type": "subtitle", "time": 10189.269, "timestamp": "02:49:49", "text": "那些叮叮当当的声音，那是经验"}, {"type": "subtitle", "time": 10192.79, "timestamp": "02:49:52", "text": "现在试着打破这个，呃，就给"}]
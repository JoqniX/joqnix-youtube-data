[{"type": "subtitle", "time": 13868.03, "timestamp": "03:51:08", "text": "乔，我需要请他给我"}, {"type": "subtitle", "time": 13873.11, "timestamp": "03:51:13", "text": "岩浆给了我足够的火把。"}, {"type": "subtitle", "time": 13875.03, "timestamp": "03:51:15", "text": "哦，真不错"}, {"type": "subtitle", "time": 13878.229, "timestamp": "03:51:18", "text": "我还看到了一些有趣的东西。"}, {"type": "subtitle", "time": 13881.269, "timestamp": "03:51:21", "text": "我和苏琪相遇的那个山洞是"}, {"type": "subtitle", "time": 13889.429, "timestamp": "03:51:29", "text": "哦，昨天那个山洞里有什么？"}, {"type": "subtitle", "time": 13892.269, "timestamp": "03:51:32", "text": "和你那个东西的结构类似"}, {"type": "subtitle", "time": 13896.469, "timestamp": "03:51:36", "text": "今天大家都在里面，M 哦，对了，Jo，什么？"}, {"type": "subtitle", "time": 13901.389, "timestamp": "03:51:41", "text": "否则，增加采矿量还可以吗？"}, {"type": "subtitle", "time": 13903.51, "timestamp": "03:51:43", "text": "走吧，实际上我们增长非常快"}, {"type": "subtitle", "time": 13914.269, "timestamp": "03:51:54", "text": "挖矿不行，我的IR也丢了，呃，试试看。"}, {"type": "subtitle", "time": 13916.229, "timestamp": "03:51:56", "text": "那是什么来着？呃，增加采矿去了"}, {"type": "subtitle", "time": 13918.67, "timestamp": "03:51:58", "text": "大厅，我很抱歉我没有"}, {"type": "subtitle", "time": 13919.81, "timestamp": "03:51:59", "text": "来"}]
[{"type": "subtitle", "time": 1634.389, "timestamp": "00:27:14", "text": "啊，我的天哪，我的天哪，我的天哪，我的天哪"}, {"type": "subtitle", "time": 1644.99, "timestamp": "00:27:24", "text": "上帝啊，不要那样做，不要那样做。"}, {"type": "subtitle", "time": 1650.75, "timestamp": "00:27:30", "text": "别那样做，笨蛋，别那样做，好吗？不，别那样做"}, {"type": "subtitle", "time": 1655.669, "timestamp": "00:27:35", "text": "别那样做，我的天哪，小心点！"}, {"type": "subtitle", "time": 1659.23, "timestamp": "00:27:39", "text": "人生只有一次，你会失去你。"}, {"type": "subtitle", "time": 1661.509, "timestamp": "00:27:41", "text": "死了你就会明白啊你甚至都不知道"}, {"type": "subtitle", "time": 1665.549, "timestamp": "00:27:45", "text": "坟墓，这东西，是的，不要死"}, {"type": "subtitle", "time": 1667.63, "timestamp": "00:27:47", "text": "这是一个"}, {"type": "subtitle", "time": 1669.909, "timestamp": "00:27:49", "text": "我一直专注于我的任务"}, {"type": "subtitle", "time": 1671.31, "timestamp": "00:27:51", "text": "事物"}, {"type": "subtitle", "time": 1674.549, "timestamp": "00:27:54", "text": "嗨，祝你好运，希望你一切顺利。"}]
[{"type": "subtitle", "time": 9600.03, "timestamp": "02:40:00", "text": "嫉妒的祖琪完全有权利努力奋斗。"}, {"type": "subtitle", "time": 9601.15, "timestamp": "02:40:01", "text": "可研磨"}, {"type": "subtitle", "time": 9603.349, "timestamp": "02:40:03", "text": "然而，无论她在哪里"}, {"type": "subtitle", "time": 9605.79, "timestamp": "02:40:05", "text": "希望你们两个能一起听完这个故事"}, {"type": "subtitle", "time": 9608.99, "timestamp": "02:40:08", "text": "现在我们来聊聊这个故事吧。"}, {"type": "subtitle", "time": 9612.67, "timestamp": "02:40:12", "text": "是啊，我的天哪，我是"}, {"type": "subtitle", "time": 9615.99, "timestamp": "02:40:15", "text": "吓坏了，我都能听到她手指的声音了。"}, {"type": "subtitle", "time": 9618.91, "timestamp": "02:40:18", "text": "该死的查德，她就是这样"}, {"type": "subtitle", "time": 9622.07, "timestamp": "02:40:22", "text": "聊天聊天拯救我们聊天#"}, {"type": "subtitle", "time": 9625.03, "timestamp": "02:40:25", "text": "剑鱼无辜"}, {"type": "subtitle", "time": 9629.83, "timestamp": "02:40:29", "text": "聊天哦天哪等等我有这些材料"}, {"type": "subtitle", "time": 9632.55, "timestamp": "02:40:32", "text": "谁是谁？这是谁的作品？这是……"}, {"type": "subtitle", "time": 9634.99, "timestamp": "02:40:34", "text": "不行，拉皮斯，等等，我来教你怎么做。"}, {"type": "subtitle", "time": 9637.79, "timestamp": "02:40:37", "text": "哦等等，对，这是我的，我收集的。"}, {"type": "subtitle", "time": 9640.71, "timestamp": "02:40:40", "text": "好的，我会给你演示一下它是怎么运作的。"}, {"type": "subtitle", "time": 9655.71, "timestamp": "02:40:55", "text": "好的，稍等一下，呃，那个东西"}]
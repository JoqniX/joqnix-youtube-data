[{"type": "subtitle", "time": 15786.229, "timestamp": "04:23:06", "text": "是啊，乔，呃，卡斯皮安杀了我，不是吗？"}, {"type": "subtitle", "time": 15790.07, "timestamp": "04:23:10", "text": "没有英国指南针"}, {"type": "subtitle", "time": 15792.109, "timestamp": "04:23:12", "text": "在任何事情发生之前，我"}, {"type": "subtitle", "time": 15796.149, "timestamp": "04:23:16", "text": "实际上把尤金罗盘给了她"}, {"type": "subtitle", "time": 15803.149, "timestamp": "04:23:23", "text": "不，我的天哪，你为什么这么做，阿斯特拉"}, {"type": "subtitle", "time": 15808.269, "timestamp": "04:23:28", "text": "为什么？你做了什么？"}, {"type": "subtitle", "time": 15810.99, "timestamp": "04:23:30", "text": "哦，我的天哪"}, {"type": "subtitle", "time": 15814.79, "timestamp": "04:23:34", "text": "天哪，但她就在附近，是啊是啊"}, {"type": "subtitle", "time": 15818.03, "timestamp": "04:23:38", "text": "务必妥善保管指南针"}, {"type": "subtitle", "time": 15822.87, "timestamp": "04:23:42", "text": "哦，是的，是的"}, {"type": "subtitle", "time": 15825.55, "timestamp": "04:23:45", "text": "不，我没有，它在她那儿。"}, {"type": "subtitle", "time": 15827.109, "timestamp": "04:23:47", "text": "是的，你得告诉她留着它。"}, {"type": "subtitle", "time": 15830.03, "timestamp": "04:23:50", "text": "如果泄露出去，那地方很安全，是她的。"}, {"type": "subtitle", "time": 15836.87, "timestamp": "04:23:56", "text": "走了，好的，等等，呃，让我"}]
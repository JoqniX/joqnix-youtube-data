[{"type": "subtitle", "time": 12304.11, "timestamp": "03:25:04", "text": "Uki 呃 英国下一个 不 对不起 团队 对不起"}, {"type": "subtitle", "time": 12308.75, "timestamp": "03:25:08", "text": "团队里有人说我们必须杀了他并带走他"}, {"type": "subtitle", "time": 12311.99, "timestamp": "03:25:11", "text": "他的胸甲"}, {"type": "subtitle", "time": 12315.03, "timestamp": "03:25:15", "text": "我们需要拿什么胸甲？"}, {"type": "subtitle", "time": 12317.63, "timestamp": "03:25:17", "text": "他的胸甲是谁告诉你的"}, {"type": "subtitle", "time": 12320.309, "timestamp": "03:25:20", "text": "这些任务"}, {"type": "subtitle", "time": 12322.75, "timestamp": "03:25:22", "text": "呃，哈比比"}, {"type": "subtitle", "time": 12326.83, "timestamp": "03:25:26", "text": "我遇到的那个人，他什么也没给我。"}, {"type": "subtitle", "time": 12330.71, "timestamp": "03:25:30", "text": "我从他那里得到了两个任务，没有"}, {"type": "subtitle", "time": 12333.83, "timestamp": "03:25:33", "text": "一个任务，我想我不知道，我不知道"}, {"type": "subtitle", "time": 12335.67, "timestamp": "03:25:35", "text": "登录一天"}, {"type": "subtitle", "time": 12345.83, "timestamp": "03:25:45", "text": "变了，不过嗯，Happ就像在睡觉一样。"}, {"type": "subtitle", "time": 12347.07, "timestamp": "03:25:47", "text": "不是"}, {"type": "subtitle", "time": 12350.07, "timestamp": "03:25:50", "text": "那里"}, {"type": "subtitle", "time": 12352.349, "timestamp": "03:25:52", "text": "他还在睡觉，但他明天会来。"}, {"type": "subtitle", "time": 12354.79, "timestamp": "03:25:54", "text": "得给他弄一堆烂的"}, {"type": "subtitle", "time": 12358.189, "timestamp": "03:25:58", "text": "血肉之躯，所以，呃，请随意杀人。"}]
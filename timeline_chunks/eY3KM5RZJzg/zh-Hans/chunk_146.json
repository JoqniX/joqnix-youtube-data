[{"type": "subtitle", "time": 8761.309, "timestamp": "02:26:01", "text": "我不知道它什么时候会到。"}, {"type": "subtitle", "time": 8763.389, "timestamp": "02:26:03", "text": "我的麦克风离我很远。"}, {"type": "subtitle", "time": 8768.23, "timestamp": "02:26:08", "text": "直播进行得怎么样了？进行得很顺利。"}, {"type": "subtitle", "time": 8771.59, "timestamp": "02:26:11", "text": "很好，我们丢失了很多东西，我死了"}, {"type": "subtitle", "time": 8775.63, "timestamp": "02:26:15", "text": "我失去了目标，我曾经是你。"}, {"type": "subtitle", "time": 8785.95, "timestamp": "02:26:25", "text": "我还能说什么呢？我把这一切都归咎于……"}, {"type": "subtitle", "time": 8787.63, "timestamp": "02:26:27", "text": "男人"}, {"type": "subtitle", "time": 8790.03, "timestamp": "02:26:30", "text": "延迟"}, {"type": "subtitle", "time": 8792.99, "timestamp": "02:26:32", "text": "抱歉，我弄丢了"}, {"type": "subtitle", "time": 8796.75, "timestamp": "02:26:36", "text": "由于啤酒，事情进展缓慢。"}, {"type": "subtitle", "time": 8800.11, "timestamp": "02:26:40", "text": "因为你的延迟而死。"}, {"type": "subtitle", "time": 8802.91, "timestamp": "02:26:42", "text": "我本来可以救自己的，你呢？"}, {"type": "subtitle", "time": 8806.99, "timestamp": "02:26:46", "text": "输了告诉我，我会给你"}, {"type": "subtitle", "time": 8810.71, "timestamp": "02:26:50", "text": "清单给你"}, {"type": "subtitle", "time": 8813.63, "timestamp": "02:26:53", "text": "好的，怎么了？"}, {"type": "subtitle", "time": 8816.469, "timestamp": "02:26:56", "text": "伙计们"}, {"type": "subtitle", "time": 8819.63, "timestamp": "02:26:59", "text": "你刚才用什么打我了？"}]
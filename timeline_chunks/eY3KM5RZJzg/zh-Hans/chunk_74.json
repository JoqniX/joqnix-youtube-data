[{"type": "subtitle", "time": 4449.59, "timestamp": "01:14:09", "text": "不，我想让自己像无人机一样嗡嗡作响。"}, {"type": "subtitle", "time": 4452.59, "timestamp": "01:14:12", "text": "我不知道的事，伙计。"}, {"type": "subtitle", "time": 4455.87, "timestamp": "01:14:15", "text": "你做了什么"}, {"type": "subtitle", "time": 4460.47, "timestamp": "01:14:20", "text": "丢了很多东西，我丢了面包。"}, {"type": "subtitle", "time": 4462.55, "timestamp": "01:14:22", "text": "婴儿床"}, {"type": "subtitle", "time": 4466.03, "timestamp": "01:14:26", "text": "丢了，但我甚至丢了，我丢了东西。"}, {"type": "subtitle", "time": 4467.83, "timestamp": "01:14:27", "text": "这对他来说弥足珍贵"}, {"type": "subtitle", "time": 4470.11, "timestamp": "01:14:30", "text": "我为了我的"}, {"type": "subtitle", "time": 4472.83, "timestamp": "01:14:32", "text": "为了我所处的那个光荣目标而踏上旅程"}, {"type": "subtitle", "time": 4476.709, "timestamp": "01:14:36", "text": "应该一路开到那里。"}, {"type": "subtitle", "time": 4478.95, "timestamp": "01:14:38", "text": "虽然不应该这样，但我还是"}, {"type": "subtitle", "time": 4480.51, "timestamp": "01:14:40", "text": "我一直把它带在身边。"}, {"type": "subtitle", "time": 4483.669, "timestamp": "01:14:43", "text": "因为你永远无法预料这世界会不会出人意料。"}, {"type": "subtitle", "time": 4488.35, "timestamp": "01:14:48", "text": "你回到后面，等等，让我"}, {"type": "subtitle", "time": 4490.91, "timestamp": "01:14:50", "text": "记住，你永远不知道什么时候会遇到 V"}, {"type": "subtitle", "time": 4493.95, "timestamp": "01:14:53", "text": "可能会反噬自身，这就是……"}, {"type": "subtitle", "time": 4496.669, "timestamp": "01:14:56", "text": "发生"}, {"type": "subtitle", "time": 4499.07, "timestamp": "01:14:59", "text": "我并没有把它藏在秘密的地方。"}]
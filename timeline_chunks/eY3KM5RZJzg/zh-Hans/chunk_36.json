[{"type": "subtitle", "time": 2161.829, "timestamp": "00:36:01", "text": "她不知道我肩负着一项使命。"}, {"type": "subtitle", "time": 2163.2, "timestamp": "00:36:03", "text": "复仇就在这里"}, {"type": "subtitle", "time": 2172.19, "timestamp": "00:36:12", "text": "世界啊，我的天哪，我该怎么办？我希望她"}, {"type": "subtitle", "time": 2174.23, "timestamp": "00:36:14", "text": "他没看到我是"}, {"type": "subtitle", "time": 2177.309, "timestamp": "00:36:17", "text": "在线或其他什么方式，我不知道。"}, {"type": "subtitle", "time": 2179.75, "timestamp": "00:36:19", "text": "我知道我可以想象他们是什么样子"}, {"type": "subtitle", "time": 2183.39, "timestamp": "00:36:23", "text": "让我像瓦尔旁边的黑暗一样，或者像"}, {"type": "subtitle", "time": 2186.67, "timestamp": "00:36:26", "text": "在游戏《黑暗》中，你旁边就是瓦尔，我就像……"}, {"type": "subtitle", "time": 2188.51, "timestamp": "00:36:28", "text": "我正在执行一项任务。"}]
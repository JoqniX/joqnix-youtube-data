[{"type": "subtitle", "time": 962.35, "timestamp": "00:16:02", "text": "学习如何更好地进行直线敲击"}, {"type": "subtitle", "time": 963.629, "timestamp": "00:16:03", "text": "我不想"}, {"type": "subtitle", "time": 968.91, "timestamp": "00:16:08", "text": "死吧，我不想死，但我应该死。"}, {"type": "subtitle", "time": 972.79, "timestamp": "00:16:12", "text": "保护，我应该复仇"}, {"type": "subtitle", "time": 974.949, "timestamp": "00:16:14", "text": "就像，哦我的天哪，我要死了，我应该……"}, {"type": "subtitle", "time": 978.43, "timestamp": "00:16:18", "text": "我要报复那个毁了那东西的人！"}, {"type": "subtitle", "time": 986.03, "timestamp": "00:16:26", "text": "不一样，没人碰我的东西，谢谢。"}, {"type": "subtitle", "time": 988.47, "timestamp": "00:16:28", "text": "上帝啊，因为我会立刻知道是否"}, {"type": "subtitle", "time": 993.11, "timestamp": "00:16:33", "text": "有人死了，他是"}, {"type": "subtitle", "time": 997.949, "timestamp": "00:16:37", "text": "最好的，但今天我们有一个使命"}, {"type": "subtitle", "time": 999.99, "timestamp": "00:16:39", "text": "我们有一个"}, {"type": "subtitle", "time": 1007.309, "timestamp": "00:16:47", "text": "哦等等，Mitsuki要直播了。"}, {"type": "subtitle", "time": 1009.87, "timestamp": "00:16:49", "text": "一会儿见，我的天哪"}, {"type": "subtitle", "time": 1012.629, "timestamp": "00:16:52", "text": "呃，怎么办？怎么办？伙计们，呃，有什么办法吗？"}, {"type": "chat", "time": 1013.029, "timestamp": "00:16:53", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "yes misson"}, {"type": "subtitle", "time": 1016.03, "timestamp": "00:16:56", "text": "哦天哪，我有个想法！"}, {"type": "subtitle", "time": 1019.749, "timestamp": "00:16:59", "text": "任务：我想去那里"}, {"type": "chat", "time": 1019.792, "timestamp": "00:16:59", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "mission"}]
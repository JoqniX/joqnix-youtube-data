[{"type": "subtitle", "time": 8044.51, "timestamp": "02:14:04", "text": "是的，我问的是他有没有给你。"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "你的东西还给我"}, {"type": "subtitle", "time": 8048.35, "timestamp": "02:14:08", "text": "丢失的"}, {"type": "subtitle", "time": 8052.43, "timestamp": "02:14:12", "text": "呃，我觉得剑鱼是想帮忙。"}, {"type": "chat", "time": 8054.675, "timestamp": "02:14:14", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "if u have an enchanting table u can have it"}, {"type": "subtitle", "time": 8056.109, "timestamp": "02:14:16", "text": "对我来说，但问题是这些物品是"}, {"type": "subtitle", "time": 8059.31, "timestamp": "02:14:19", "text": "我收到了他给我的武器。"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "那玩意儿，呃，那东西又丢了。"}, {"type": "subtitle", "time": 8064.27, "timestamp": "02:14:24", "text": "服务器"}, {"type": "subtitle", "time": 8066.83, "timestamp": "02:14:26", "text": "崩溃了，所以你现在给了他什么？"}, {"type": "subtitle", "time": 8068.87, "timestamp": "02:14:28", "text": "那颗祖母绿，你却什么也没得到。"}, {"type": "subtitle", "time": 8070.549, "timestamp": "02:14:30", "text": "不，不，他会回来的，他说过。"}, {"type": "subtitle", "time": 8071.83, "timestamp": "02:14:31", "text": "偶然"}, {"type": "subtitle", "time": 8074.95, "timestamp": "02:14:34", "text": "他被传送走了，他会回到我身边的。"}, {"type": "subtitle", "time": 8084.549, "timestamp": "02:14:44", "text": "所以，你发现了什么？我的天哪"}, {"type": "subtitle", "time": 8086.189, "timestamp": "02:14:46", "text": "那是一个整体"}, {"type": "subtitle", "time": 8091.95, "timestamp": "02:14:51", "text": "大大，来吧，好吗？跟我来，我的天哪"}, {"type": "subtitle", "time": 8093.75, "timestamp": "02:14:53", "text": "问题是我不记得它在哪里了"}, {"type": "subtitle", "time": 8096.99, "timestamp": "02:14:56", "text": "那个地方，哦，这边有扇门。"}]
[{"type": "subtitle", "time": 7201.189, "timestamp": "02:00:01", "text": "第二个，好的，我看到一头牛过来了"}, {"type": "subtitle", "time": 7203.189, "timestamp": "02:00:03", "text": "来"}, {"type": "subtitle", "time": 7205.79, "timestamp": "02:00:05", "text": "哦，那是鸡，好的，在哪儿？"}, {"type": "subtitle", "time": 7207.39, "timestamp": "02:00:07", "text": "是"}, {"type": "subtitle", "time": 7210.75, "timestamp": "02:00:10", "text": "我的旅人，牛在哪里？"}, {"type": "subtitle", "time": 7214.069, "timestamp": "02:00:14", "text": "这里这里这里这里所有"}, {"type": "subtitle", "time": 7217.27, "timestamp": "02:00:17", "text": "没错，牛在这边三号。"}, {"type": "subtitle", "time": 7219.75, "timestamp": "02:00:19", "text": "牛看着"}, {"type": "subtitle", "time": 7224.27, "timestamp": "02:00:24", "text": "我的天哪，真不错，我喜欢！"}, {"type": "subtitle", "time": 7225.069, "timestamp": "02:00:25", "text": "那就是"}, {"type": "subtitle", "time": 7227.83, "timestamp": "02:00:27", "text": "太棒了，现在你必须炸掉你的"}, {"type": "subtitle", "time": 7229.629, "timestamp": "02:00:29", "text": "房子"}, {"type": "subtitle", "time": 7232.31, "timestamp": "02:00:32", "text": "哇哦，找到了，你有一块燧石。"}, {"type": "subtitle", "time": 7234.35, "timestamp": "02:00:34", "text": "钢"}, {"type": "subtitle", "time": 7238.43, "timestamp": "02:00:38", "text": "不，哇，你真穷，我也很穷。"}, {"type": "subtitle", "time": 7241.39, "timestamp": "02:00:41", "text": "我失去了一切"}, {"type": "subtitle", "time": 7244.629, "timestamp": "02:00:44", "text": "现在的生活是"}, {"type": "subtitle", "time": 7247.51, "timestamp": "02:00:47", "text": "痛苦的人，他们真的需要这么做。"}, {"type": "subtitle", "time": 7249.35, "timestamp": "02:00:49", "text": "好像是关于坟墓之类的。"}, {"type": "subtitle", "time": 7252.109, "timestamp": "02:00:52", "text": "或者清点库存之类的，我知道的。"}, {"type": "subtitle", "time": 7254.91, "timestamp": "02:00:54", "text": "这太糟糕了，你知道我当时是，我是"}, {"type": "subtitle", "time": 7256.629, "timestamp": "02:00:56", "text": "我像往常一样来到你的基地，我已经……"}, {"type": "subtitle", "time": 7259.229, "timestamp": "02:00:59", "text": "已经旅行了一个小时，感觉……"}]
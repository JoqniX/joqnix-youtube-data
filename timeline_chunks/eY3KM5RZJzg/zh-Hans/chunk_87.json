[{"type": "subtitle", "time": 5221.95, "timestamp": "01:27:01", "text": "那把武器随后解锁了"}, {"type": "subtitle", "time": 5225.35, "timestamp": "01:27:05", "text": "武器没问题，那时剑鱼也行。"}, {"type": "subtitle", "time": 5231.07, "timestamp": "01:27:11", "text": "把我传送走了，好吧好吧好吧好吧好吧"}, {"type": "subtitle", "time": 5232.99, "timestamp": "01:27:12", "text": "呃"}, {"type": "subtitle", "time": 5237.83, "timestamp": "01:27:17", "text": "等等，快到了，我把那东西给了我"}, {"type": "subtitle", "time": 5240.83, "timestamp": "01:27:20", "text": "把那两把剑给了"}, {"type": "subtitle", "time": 5244.87, "timestamp": "01:27:24", "text": "请他们看看你的头盔"}, {"type": "subtitle", "time": 5248.59, "timestamp": "01:27:28", "text": "求求你，求求你，快点快点"}, {"type": "subtitle", "time": 5250.79, "timestamp": "01:27:30", "text": "来吧来吧"}, {"type": "subtitle", "time": 5255.189, "timestamp": "01:27:35", "text": "几乎"}, {"type": "subtitle", "time": 5259.43, "timestamp": "01:27:39", "text": "呃，是V，不是VT"}, {"type": "subtitle", "time": 5261.07, "timestamp": "01:27:41", "text": "D"}, {"type": "subtitle", "time": 5265.43, "timestamp": "01:27:45", "text": "好的，啊，我错过了，我错过了，回去吧"}, {"type": "subtitle", "time": 5266.669, "timestamp": "01:27:46", "text": "框架"}, {"type": "subtitle", "time": 5274.79, "timestamp": "01:27:54", "text": "回来，回来，好的，好的，等等"}, {"type": "subtitle", "time": 5277.229, "timestamp": "01:27:57", "text": "好的，金铲子丝绸"}]
[{"type": "subtitle", "time": 15960.07, "timestamp": "04:26:00", "text": "说话还行，嗯，等等，呃，那是正常的"}, {"type": "subtitle", "time": 15961.91, "timestamp": "04:26:01", "text": "长矛刺杀"}, {"type": "subtitle", "time": 15964.109, "timestamp": "04:26:04", "text": "等等，这是什么？"}, {"type": "subtitle", "time": 15967.99, "timestamp": "04:26:07", "text": "好的，试试把它们穿上"}, {"type": "subtitle", "time": 15978.309, "timestamp": "04:26:18", "text": "小丑哦，普通的小丑，等等，等等，是"}, {"type": "subtitle", "time": 15980.55, "timestamp": "04:26:20", "text": "像魔法一样小便"}, {"type": "subtitle", "time": 15983.229, "timestamp": "04:26:23", "text": "是的，这是一本书。"}, {"type": "subtitle", "time": 15986.309, "timestamp": "04:26:26", "text": "既然附魔了，为什么不能叠加呢？"}, {"type": "subtitle", "time": 15988.07, "timestamp": "04:26:28", "text": "那些本应是……的附魔"}, {"type": "subtitle", "time": 15990.269, "timestamp": "04:26:30", "text": "可能的"}, {"type": "subtitle", "time": 15993.429, "timestamp": "04:26:33", "text": "虽然我不认识你，等等，你怎么……"}, {"type": "subtitle", "time": 15994.63, "timestamp": "04:26:34", "text": "堆"}, {"type": "subtitle", "time": 15997.189, "timestamp": "04:26:37", "text": "诸如此类的魔法"}, {"type": "subtitle", "time": 16000.95, "timestamp": "04:26:40", "text": "你等等，怎么等？这真是个好问题。"}, {"type": "subtitle", "time": 16003.109, "timestamp": "04:26:43", "text": "哦，对，你放了一本书"}, {"type": "subtitle", "time": 16005.67, "timestamp": "04:26:45", "text": "书，嗯，就像一本魔法书。"}, {"type": "subtitle", "time": 16008.149, "timestamp": "04:26:48", "text": "然后你又施加了一个附魔。"}, {"type": "subtitle", "time": 16012.109, "timestamp": "04:26:52", "text": "买一本书，然后你就能得到两本叠在一起的。"}, {"type": "subtitle", "time": 16015.189, "timestamp": "04:26:55", "text": "试试看能不能拿到这个"}, {"type": "subtitle", "time": 16017.469, "timestamp": "04:26:57", "text": "呕吐是正常的，这是……"}]
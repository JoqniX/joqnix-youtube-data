[{"type": "subtitle", "time": 10746.03, "timestamp": "02:59:06", "text": "明白了，嗯，好的，所以我两个都有。"}, {"type": "subtitle", "time": 10750.469, "timestamp": "02:59:10", "text": "这里我们有一些好东西。"}, {"type": "subtitle", "time": 10753.63, "timestamp": "02:59:13", "text": "为了确保哈比比先生"}, {"type": "subtitle", "time": 10757.87, "timestamp": "02:59:17", "text": "范德林那家伙没看到这个地方"}, {"type": "subtitle", "time": 10770.75, "timestamp": "02:59:30", "text": "甚至她的聊天记录也只有少数人观看"}, {"type": "subtitle", "time": 10779.389, "timestamp": "02:59:39", "text": "抱歉，查德，你知道，问题是……"}, {"type": "subtitle", "time": 10784.269, "timestamp": "02:59:44", "text": "这有点像，哦我的天哪，互动，我是"}, {"type": "subtitle", "time": 10790.03, "timestamp": "02:59:50", "text": "非常抱歉，好吧，对不起，发生了什么事？"}, {"type": "subtitle", "time": 10793.349, "timestamp": "02:59:53", "text": "我的聊天对象很不高兴，因为我不在。"}, {"type": "subtitle", "time": 10797.309, "timestamp": "02:59:57", "text": "吸引、互动"}]
[{"type": "subtitle", "time": 7500.99, "timestamp": "02:05:00", "text": "它接受了，感谢上帝，哦，这笔交易已经……"}, {"type": "subtitle", "time": 7504.31, "timestamp": "02:05:04", "text": "我们所给予的，早已被创造出来。"}, {"type": "subtitle", "time": 7506.149, "timestamp": "02:05:06", "text": "这"}, {"type": "subtitle", "time": 7507.75, "timestamp": "02:05:07", "text": "后退"}, {"type": "subtitle", "time": 7510.629, "timestamp": "02:05:10", "text": "好了，这里这里这里这里这里，这是……"}, {"type": "subtitle", "time": 7514.069, "timestamp": "02:05:14", "text": "付款是什么？发生了什么？"}, {"type": "subtitle", "time": 7517.109, "timestamp": "02:05:17", "text": "你需要告诉我，我会告诉你。"}, {"type": "subtitle", "time": 7520.75, "timestamp": "02:05:20", "text": "你知道，他做了一笔交易，来这里。"}, {"type": "subtitle", "time": 7541.589, "timestamp": "02:05:41", "text": "Godot 我忘了我在直播哦我的天"}, {"type": "subtitle", "time": 7544.27, "timestamp": "02:05:44", "text": "听我说，听我说"}, {"type": "subtitle", "time": 7548.51, "timestamp": "02:05:48", "text": "听我说，我的天哪，听我说"}, {"type": "subtitle", "time": 7549.75, "timestamp": "02:05:49", "text": "对我来说，你拿起了其中一个"}, {"type": "subtitle", "time": 7551.43, "timestamp": "02:05:51", "text": "祖母绿，这是交易的一部分，这是其中的一部分"}, {"type": "subtitle", "time": 7553.589, "timestamp": "02:05:53", "text": "你知道，这笔交易我需要16颗祖母绿。"}, {"type": "subtitle", "time": 7557.31, "timestamp": "02:05:57", "text": "想要一把好剑？先告诉我，告诉我。"}]
[{"type": "subtitle", "time": 2288.51, "timestamp": "00:38:08", "text": "《黑客帝国》让我进去，这是……"}, {"type": "subtitle", "time": 2291.43, "timestamp": "00:38:11", "text": "上帝的作为就是神的作为"}, {"type": "subtitle", "time": 2294.829, "timestamp": "00:38:14", "text": "他知道吗？他知道我落后了吗？"}, {"type": "subtitle", "time": 2296.349, "timestamp": "00:38:16", "text": "喜欢"}, {"type": "subtitle", "time": 2297.99, "timestamp": "00:38:17", "text": "嗯"}, {"type": "subtitle", "time": 2300.15, "timestamp": "00:38:20", "text": "什么"}, {"type": "subtitle", "time": 2332.55, "timestamp": "00:38:52", "text": "现在连上帝都帮不了我们了"}]
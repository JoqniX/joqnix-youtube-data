[{"type": "subtitle", "time": 6842.709, "timestamp": "01:54:02", "text": "不，我开玩笑的，我开玩笑的，我开玩笑的。"}, {"type": "subtitle", "time": 6844.99, "timestamp": "01:54:04", "text": "我觉得它在别的地方，我SP设置了一个"}, {"type": "subtitle", "time": 6846.91, "timestamp": "01:54:06", "text": "出生在村庄或"}, {"type": "subtitle", "time": 6849.83, "timestamp": "01:54:09", "text": "你知道该去哪里吗？"}, {"type": "subtitle", "time": 6854.189, "timestamp": "01:54:14", "text": "至少，不，我失去了一切，我的目标。"}, {"type": "subtitle", "time": 6856.109, "timestamp": "01:54:16", "text": "人生就是"}, {"type": "subtitle", "time": 6859.79, "timestamp": "01:54:19", "text": "走了，哦，天哪，好吧，好吧，现在"}, {"type": "subtitle", "time": 6861.95, "timestamp": "01:54:21", "text": "你知道我为什么这么做吗？"}, {"type": "subtitle", "time": 6863.39, "timestamp": "01:54:23", "text": "我来到这里是为了你"}, {"type": "subtitle", "time": 6868.589, "timestamp": "01:54:28", "text": "今天呃，像控制台一样"}, {"type": "subtitle", "time": 6871.79, "timestamp": "01:54:31", "text": "我，然后说，没关系，士兵，过来"}, {"type": "subtitle", "time": 6875.55, "timestamp": "01:54:35", "text": "我来这里其实是为了折磨你，我的天哪"}, {"type": "subtitle", "time": 6878.189, "timestamp": "01:54:38", "text": "哦，你看到这个了"}, {"type": "subtitle", "time": 6882.189, "timestamp": "01:54:42", "text": "我现在手里拿着的这把武士刀"}, {"type": "subtitle", "time": 6884.35, "timestamp": "01:54:44", "text": "一、这个会帮助你获得"}, {"type": "subtitle", "time": 6885.95, "timestamp": "01:54:45", "text": "很可能是因为这是一个"}, {"type": "subtitle", "time": 6887.589, "timestamp": "01:54:47", "text": "这把武士刀威力强大，还能燃烧。"}, {"type": "subtitle", "time": 6891.709, "timestamp": "01:54:51", "text": "它的一面是……钻石武士刀，带火"}, {"type": "subtitle", "time": 6892.99, "timestamp": "01:54:52", "text": "方面"}, {"type": "subtitle", "time": 6895.99, "timestamp": "01:54:55", "text": "哦，你想要这样的吗？我想要。"}, {"type": "subtitle", "time": 6897.83, "timestamp": "01:54:57", "text": "希望"}]
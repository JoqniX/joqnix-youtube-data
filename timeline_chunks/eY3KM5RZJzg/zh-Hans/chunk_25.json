[{"type": "subtitle", "time": 1501.59, "timestamp": "00:25:01", "text": "好的，我们有一些猪，是吗？"}, {"type": "subtitle", "time": 1503.07, "timestamp": "00:25:03", "text": "发生的事情"}, {"type": "subtitle", "time": 1506.07, "timestamp": "00:25:06", "text": "世界还好，免费食物，因为它是火焰"}, {"type": "subtitle", "time": 1508.43, "timestamp": "00:25:08", "text": "你会免费获得一把剑"}, {"type": "subtitle", "time": 1512.11, "timestamp": "00:25:12", "text": "烤制的食物，所以我们不需要呃"}, {"type": "subtitle", "time": 1522.43, "timestamp": "00:25:22", "text": "这些在哪里？"}, {"type": "subtitle", "time": 1534.99, "timestamp": "00:25:34", "text": "问题是我不能丢失我的物品。"}, {"type": "subtitle", "time": 1537.909, "timestamp": "00:25:37", "text": "伙计们，我不能失去我的"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "物品并非公司所有，绝无此事。"}, {"type": "subtitle", "time": 1544.87, "timestamp": "00:25:44", "text": "格雷夫斯"}, {"type": "subtitle", "time": 1547.389, "timestamp": "00:25:47", "text": "安装原因：我的连接"}]
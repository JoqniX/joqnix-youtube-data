[{"type": "subtitle", "time": 12960.349, "timestamp": "03:36:00", "text": "你看到的这些是什么？"}, {"type": "subtitle", "time": 12964.229, "timestamp": "03:36:04", "text": "同意，所以即使你死了你"}, {"type": "subtitle", "time": 12966.59, "timestamp": "03:36:06", "text": "仍然会拥有那个工具。"}, {"type": "subtitle", "time": 12967.83, "timestamp": "03:36:07", "text": "你的"}, {"type": "subtitle", "time": 12972.91, "timestamp": "03:36:12", "text": "回来，哦，那太酷了，是啊，现在"}, {"type": "subtitle", "time": 12974.389, "timestamp": "03:36:14", "text": "那将是一颗钻石，现在它将"}, {"type": "subtitle", "time": 12976.11, "timestamp": "03:36:16", "text": "成为一颗钻石"}, {"type": "subtitle", "time": 12980.11, "timestamp": "03:36:20", "text": "那是什么？inf4 是一颗钻石，哦，拜托！"}, {"type": "subtitle", "time": 12982.349, "timestamp": "03:36:22", "text": "我没有。"}, {"type": "subtitle", "time": 12985.79, "timestamp": "03:36:25", "text": "钻石哼着歌说你这个喷子，你到底是什么？"}, {"type": "subtitle", "time": 12987.79, "timestamp": "03:36:27", "text": "你扭来扭去"}, {"type": "subtitle", "time": 12990.67, "timestamp": "03:36:30", "text": "嗯，你知道的，我认识他。"}, {"type": "subtitle", "time": 12994.63, "timestamp": "03:36:34", "text": "四年了，所以我简直就是什么？"}, {"type": "subtitle", "time": 12997.309, "timestamp": "03:36:37", "text": "你是说我见过你，我见过你三个人吗？"}, {"type": "subtitle", "time": 13000.59, "timestamp": "03:36:40", "text": "几天前，在这个"}, {"type": "subtitle", "time": 13006.269, "timestamp": "03:36:46", "text": "我真是撒谎了，明目张胆地撒谎！"}, {"type": "subtitle", "time": 13008.87, "timestamp": "03:36:48", "text": "老兄，我跟你说，我都忘了我们还要扮演角色了。"}, {"type": "subtitle", "time": 13012.269, "timestamp": "03:36:52", "text": "玩我忘了乔伊"}]
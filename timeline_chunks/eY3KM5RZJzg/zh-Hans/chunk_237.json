[{"type": "subtitle", "time": 14222.55, "timestamp": "03:57:02", "text": "我想要更好的盔甲，你为什么用"}, {"type": "subtitle", "time": 14225.149, "timestamp": "03:57:05", "text": "你为什么不把它放在这里呢？把它放在这里"}, {"type": "subtitle", "time": 14228.55, "timestamp": "03:57:08", "text": "铁头盔，铁质的，多少钱？"}, {"type": "subtitle", "time": 14230.87, "timestamp": "03:57:10", "text": "盔甲，不不不不不不不不不不，你"}, {"type": "subtitle", "time": 14234.349, "timestamp": "03:57:14", "text": "知道该如何保存"}, {"type": "subtitle", "time": 14238.229, "timestamp": "03:57:18", "text": "弄点钻石，然后留着它们吧。"}, {"type": "subtitle", "time": 14240.99, "timestamp": "03:57:20", "text": "安全，我们会把它放在钻石上。"}, {"type": "subtitle", "time": 14244.189, "timestamp": "03:57:24", "text": "头盔是怎么回事？我能弄到吗？"}, {"type": "subtitle", "time": 14247.03, "timestamp": "03:57:27", "text": "一件钻石胸甲和裤子"}, {"type": "subtitle", "time": 14252.349, "timestamp": "03:57:32", "text": "靴子眨眼眨眼眨眼你可以但是你"}, {"type": "subtitle", "time": 14256.83, "timestamp": "03:57:36", "text": "不要把附魔浪费在低等级物品上。"}, {"type": "subtitle", "time": 14262.149, "timestamp": "03:57:42", "text": "H档，好的，我有个主意，所以我会"}, {"type": "subtitle", "time": 14264.389, "timestamp": "03:57:44", "text": "保留这些，我的末影箱不是"}, {"type": "subtitle", "time": 14267.67, "timestamp": "03:57:47", "text": "目前这个版本没有这个功能。"}, {"type": "subtitle", "time": 14269.149, "timestamp": "03:57:49", "text": "赛季即将开始"}, {"type": "subtitle", "time": 14272.349, "timestamp": "03:57:52", "text": "第三季第三集，我告诉你我不会"}, {"type": "subtitle", "time": 14274.149, "timestamp": "03:57:54", "text": "再玩一次"}, {"type": "subtitle", "time": 14276.51, "timestamp": "03:57:56", "text": "季节"}, {"type": "subtitle", "time": 14279.91, "timestamp": "03:57:59", "text": "不，我不想再玩了。"}]
[{"type": "subtitle", "time": 13081.189, "timestamp": "03:38:01", "text": "你为什么要这样做？你为什么要这样做？"}, {"type": "subtitle", "time": 13083.11, "timestamp": "03:38:03", "text": "那"}, {"type": "subtitle", "time": 13085.87, "timestamp": "03:38:05", "text": "对，就像把里海带来一样。"}, {"type": "subtitle", "time": 13088.59, "timestamp": "03:38:08", "text": "卡斯潘，是的，现在把他带回来，我会的。"}, {"type": "subtitle", "time": 13090.51, "timestamp": "03:38:10", "text": "对，就是用头撞他。"}, {"type": "subtitle", "time": 13094.67, "timestamp": "03:38:14", "text": "她说，哦，天哪，你们真是……"}, {"type": "subtitle", "time": 13096.469, "timestamp": "03:38:16", "text": "真的"}, {"type": "subtitle", "time": 13099.83, "timestamp": "03:38:19", "text": "昨天你好 Suuki，我是 Jock"}, {"type": "subtitle", "time": 13102.429, "timestamp": "03:38:22", "text": "闭嘴"}, {"type": "subtitle", "time": 13105.189, "timestamp": "03:38:25", "text": "你再说一遍，你不是乔，你又不是乔"}, {"type": "subtitle", "time": 13110.07, "timestamp": "03:38:30", "text": "你真是个喷子，我的天哪"}, {"type": "subtitle", "time": 13111.95, "timestamp": "03:38:31", "text": "巨魔哦"}, {"type": "subtitle", "time": 13117.269, "timestamp": "03:38:37", "text": "我的天哪，你这个喷子，尼克，你这个喷子，哦我的天哪"}, {"type": "subtitle", "time": 13120.429, "timestamp": "03:38:40", "text": "上帝啊，我刚才说的是，我认识J很久了。"}, {"type": "subtitle", "time": 13123.83, "timestamp": "03:38:43", "text": "减去4年，我有一种感觉……"}, {"type": "subtitle", "time": 13126.75, "timestamp": "03:38:46", "text": "我认识J已经4年了，即使……"}, {"type": "subtitle", "time": 13132.189, "timestamp": "03:38:52", "text": "天哪"}]
[{"type": "subtitle", "time": 9364.71, "timestamp": "02:36:04", "text": "好的，哦，你好，所以呃，铃声是呃"}, {"type": "subtitle", "time": 9368.03, "timestamp": "02:36:08", "text": "我送给她一份礼物"}, {"type": "subtitle", "time": 9370.59, "timestamp": "02:36:10", "text": "把礼物送给美月，把锚还回去"}, {"type": "subtitle", "time": 9371.99, "timestamp": "02:36:11", "text": "我给你的一个，我还会给你另一个"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "铃"}, {"type": "subtitle", "time": 9378.349, "timestamp": "02:36:18", "text": "我说：“让我先冷静一下。”"}, {"type": "subtitle", "time": 9380.55, "timestamp": "02:36:20", "text": "做一件事，我马上回来。"}, {"type": "subtitle", "time": 9382.23, "timestamp": "02:36:22", "text": "马上回来，其实我得走了。"}, {"type": "subtitle", "time": 9385.91, "timestamp": "02:36:25", "text": "现在要睡觉了，哦嗨，哦等等，我的"}, {"type": "subtitle", "time": 9389.11, "timestamp": "02:36:29", "text": "任务完成了，没事了，没事了"}, {"type": "subtitle", "time": 9390.79, "timestamp": "02:36:30", "text": "明天、明天、明天做"}, {"type": "subtitle", "time": 9393.87, "timestamp": "02:36:33", "text": "明天 明天 好的 好的 是的，这是一个"}, {"type": "subtitle", "time": 9395.389, "timestamp": "02:36:35", "text": "很棒的任务，你们可以杀了他"}, {"type": "subtitle", "time": 9396.99, "timestamp": "02:36:36", "text": "你们可以把你们的破事儿都带走，把他的破事儿也带走。"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "妈的，你知道这肯定会很美好"}, {"type": "subtitle", "time": 9401.469, "timestamp": "02:36:41", "text": "他在哪儿？他在哪儿？呃，我会告诉你。"}, {"type": "subtitle", "time": 9402.99, "timestamp": "02:36:42", "text": "我会把这个指南针给你。"}, {"type": "subtitle", "time": 9405.23, "timestamp": "02:36:45", "text": "指向他的基地，这样你就可以建立一个"}, {"type": "subtitle", "time": 9407.349, "timestamp": "02:36:47", "text": "趁他不在的时候，在他基地设下埋伏。"}, {"type": "subtitle", "time": 9409.23, "timestamp": "02:36:49", "text": "知道类似的事情，让K知道那些是"}, {"type": "subtitle", "time": 9412.63, "timestamp": "02:36:52", "text": "因为下面这些，你"}, {"type": "subtitle", "time": 9414.309, "timestamp": "02:36:54", "text": "如果你帮我买，我会给你一个价格。"}, {"type": "subtitle", "time": 9415.63, "timestamp": "02:36:55", "text": "价格太便宜了，我买定了。"}, {"type": "subtitle", "time": 9419.07, "timestamp": "02:36:59", "text": "腐肉，甚至腐肉一堆"}]
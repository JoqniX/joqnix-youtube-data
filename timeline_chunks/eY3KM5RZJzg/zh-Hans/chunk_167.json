[{"type": "subtitle", "time": 10032.51, "timestamp": "02:47:12", "text": "水就像偶尔需要喝水一样。"}, {"type": "subtitle", "time": 10035.389, "timestamp": "02:47:15", "text": "最终会出来，但不会像以前那样频繁。"}, {"type": "subtitle", "time": 10042.95, "timestamp": "02:47:22", "text": "现在你也可以用你的……做同样的事情"}, {"type": "subtitle", "time": 10045.429, "timestamp": "02:47:25", "text": "裤子"}, {"type": "subtitle", "time": 10054.389, "timestamp": "02:47:34", "text": "磨合好了，我得走了"}, {"type": "subtitle", "time": 10057.71, "timestamp": "02:47:37", "text": "现在你可以潜入水下了。"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "你不必像你一样经常出来。"}, {"type": "subtitle", "time": 10063.309, "timestamp": "02:47:43", "text": "我不得不像乔一样，你能解释一下吗？"}, {"type": "subtitle", "time": 10065.87, "timestamp": "02:47:45", "text": "对她来说，哦等等，别误会，我可以"}, {"type": "subtitle", "time": 10069.11, "timestamp": "02:47:49", "text": "给你，那里已经有金色的了"}, {"type": "subtitle", "time": 10072.87, "timestamp": "02:47:52", "text": "两栖动物玩意儿？不，她已经得到了。"}, {"type": "subtitle", "time": 10076.51, "timestamp": "02:47:56", "text": "哦，她明白了。好的，乔，你有铁吗？"}, {"type": "subtitle", "time": 10079.349, "timestamp": "02:47:59", "text": "你有 I I"}]
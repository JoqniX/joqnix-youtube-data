[{"type": "subtitle", "time": 12720.469, "timestamp": "03:32:00", "text": "我就是这么说的，要么拖着他走，要么杀了他。"}, {"type": "subtitle", "time": 12722.95, "timestamp": "03:32:02", "text": "得到一个人"}, {"type": "subtitle", "time": 12725.51, "timestamp": "03:32:05", "text": "是什么？"}, {"type": "subtitle", "time": 12728.07, "timestamp": "03:32:08", "text": "寻求"}, {"type": "subtitle", "time": 12731.63, "timestamp": "03:32:11", "text": "我觉得乔的行为非常可疑"}, {"type": "subtitle", "time": 12734.03, "timestamp": "03:32:14", "text": "这里"}, {"type": "subtitle", "time": 12737.59, "timestamp": "03:32:17", "text": "嗯，其实我们要去磨练。"}, {"type": "subtitle", "time": 12740.83, "timestamp": "03:32:20", "text": "今天只有今天，然后我们就可以开始磨合了"}, {"type": "subtitle", "time": 12748.79, "timestamp": "03:32:28", "text": "今天我没多少时间，我在"}, {"type": "subtitle", "time": 12749.71, "timestamp": "03:32:29", "text": "实际上"}, {"type": "subtitle", "time": 12754.229, "timestamp": "03:32:34", "text": "困得慌，因为我一整天都没睡。"}, {"type": "subtitle", "time": 12756.99, "timestamp": "03:32:36", "text": "不，我的计划只是做一点小事。"}, {"type": "subtitle", "time": 12757.95, "timestamp": "03:32:37", "text": "一点点"}, {"type": "subtitle", "time": 12762.87, "timestamp": "03:32:42", "text": "挖矿，所以我知道今天是在挖钻石。"}, {"type": "subtitle", "time": 12766.229, "timestamp": "03:32:46", "text": "她努力奋斗，她做了闵，她做了这样的事"}, {"type": "subtitle", "time": 12769.389, "timestamp": "03:32:49", "text": "她今天工作做得很好，你知道的。"}, {"type": "subtitle", "time": 12773.63, "timestamp": "03:32:53", "text": "发现你不喜欢这个，我的天哪！"}, {"type": "subtitle", "time": 12776.83, "timestamp": "03:32:56", "text": "甚至还扮演了乔，你其实是"}]
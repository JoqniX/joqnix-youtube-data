[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "我怎么能那样做，我亲爱的"}, {"type": "subtitle", "time": 13144.309, "timestamp": "03:39:04", "text": "箱子里有东西，我该怎么办？"}, {"type": "subtitle", "time": 13147.07, "timestamp": "03:39:07", "text": "这样做，我们对你来说并不珍贵。"}, {"type": "subtitle", "time": 13152.429, "timestamp": "03:39:12", "text": "不，我不再是你们了，你们都是笨蛋，为什么"}, {"type": "subtitle", "time": 13156.07, "timestamp": "03:39:16", "text": "我冒了这个险，你今天怎么敢？"}, {"type": "subtitle", "time": 13157.349, "timestamp": "03:39:17", "text": "H"}, {"type": "subtitle", "time": 13161.87, "timestamp": "03:39:21", "text": "呃，我很怀疑，我无法接受。"}, {"type": "subtitle", "time": 13165.07, "timestamp": "03:39:25", "text": "和这种可疑的人在一起，我会付出代价。"}, {"type": "subtitle", "time": 13166.229, "timestamp": "03:39:26", "text": "这"}, {"type": "subtitle", "time": 13170.07, "timestamp": "03:39:30", "text": "相信我，我会重新赢得这份信任，就像……"}, {"type": "subtitle", "time": 13172.91, "timestamp": "03:39:32", "text": "到底是什么？"}, {"type": "subtitle", "time": 13175.87, "timestamp": "03:39:35", "text": "就像我刚才问他一个将军一样"}, {"type": "subtitle", "time": 13179.389, "timestamp": "03:39:39", "text": "问题，感觉他像是在演戏，那是什么？"}, {"type": "subtitle", "time": 13181.91, "timestamp": "03:39:41", "text": "我的问题是什么？我当时的问题是什么？"}, {"type": "subtitle", "time": 13185.75, "timestamp": "03:39:45", "text": "比如，为什么你只有一个问题？"}, {"type": "subtitle", "time": 13189.07, "timestamp": "03:39:49", "text": "我们俩都没有，然后我们开始……"}, {"type": "subtitle", "time": 13192.389, "timestamp": "03:39:52", "text": "用一种非常奇怪的声音说话，很奇怪"}, {"type": "subtitle", "time": 13193.389, "timestamp": "03:39:53", "text": "嗓音"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "我觉得你的声音很奇怪，而且我是"}]
[{"type": "subtitle", "time": 9061.83, "timestamp": "02:31:01", "text": "没错，布斯，不过我就假装吧。"}, {"type": "subtitle", "time": 9064.19, "timestamp": "02:31:04", "text": "我假装……我假装"}, {"type": "subtitle", "time": 9067.51, "timestamp": "02:31:07", "text": "我从我的"}, {"type": "subtitle", "time": 9069.91, "timestamp": "02:31:09", "text": "胸部你不应该"}, {"type": "subtitle", "time": 9072.429, "timestamp": "02:31:12", "text": "好的"}, {"type": "subtitle", "time": 9074.95, "timestamp": "02:31:14", "text": "很好，这个也行。"}, {"type": "subtitle", "time": 9077.71, "timestamp": "02:31:17", "text": "伙计，我觉得这东西应该是……"}, {"type": "subtitle", "time": 9080.429, "timestamp": "02:31:20", "text": "是你，我相信你，是"}, {"type": "subtitle", "time": 9082.03, "timestamp": "02:31:22", "text": "请问您能把那个给我吗？"}, {"type": "subtitle", "time": 9091.389, "timestamp": "02:31:31", "text": "锚点和不，它在麻省理工学院的mitsuki's"}, {"type": "subtitle", "time": 9094.71, "timestamp": "02:31:34", "text": "那玩意儿什么？哦等等，是啊，伊鲁玛给了"}, {"type": "subtitle", "time": 9097.349, "timestamp": "02:31:37", "text": "她收到了一份礼物，是的，我记得，哦哦，是的，哦"}, {"type": "subtitle", "time": 9100.87, "timestamp": "02:31:40", "text": "哦，好吧好吧好吧，然后给"}, {"type": "subtitle", "time": 9103.11, "timestamp": "02:31:43", "text": "我会把它还给她。"}, {"type": "subtitle", "time": 9105.59, "timestamp": "02:31:45", "text": "抱着她发明的东西，只是给予，只是给予"}, {"type": "subtitle", "time": 9108.389, "timestamp": "02:31:48", "text": "我等一下，哦等等，那是下界合金靴子"}, {"type": "subtitle", "time": 9111.87, "timestamp": "02:31:51", "text": "是她的吗？哦等等，哦哦等等，是她的。"}, {"type": "subtitle", "time": 9114.15, "timestamp": "02:31:54", "text": "问问她这东西是不是她的。"}]
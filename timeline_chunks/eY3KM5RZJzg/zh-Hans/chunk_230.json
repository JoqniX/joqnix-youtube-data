[{"type": "subtitle", "time": 13801.469, "timestamp": "03:50:01", "text": "为什么？我马上回来。"}, {"type": "subtitle", "time": 13805.11, "timestamp": "03:50:05", "text": "我不知道，我太……"}, {"type": "subtitle", "time": 13808.87, "timestamp": "03:50:08", "text": "对不起，我太"}, {"type": "subtitle", "time": 13812.469, "timestamp": "03:50:12", "text": "受伤了，那里发生的事情是一个油管博主"}, {"type": "subtitle", "time": 13815.269, "timestamp": "03:50:15", "text": "称为 maturi"}, {"type": "subtitle", "time": 13822.229, "timestamp": "03:50:22", "text": "生活发生了什么，你不能就这么算了。"}, {"type": "subtitle", "time": 13824.07, "timestamp": "03:50:24", "text": "称呼"}, {"type": "subtitle", "time": 13829.07, "timestamp": "03:50:29", "text": "我的大脑一直在运转"}, {"type": "subtitle", "time": 13834.429, "timestamp": "03:50:34", "text": "好的，我有64个。"}, {"type": "subtitle", "time": 13839.269, "timestamp": "03:50:39", "text": "我有64盏灯，还有其他东西，所以，我"}, {"type": "subtitle", "time": 13841.51, "timestamp": "03:50:41", "text": "我觉得我们应该多造一些手电筒"}, {"type": "subtitle", "time": 13845.189, "timestamp": "03:50:45", "text": "老实说，我会弄到一些资源。"}, {"type": "subtitle", "time": 13849.99, "timestamp": "03:50:49", "text": "B 不，呃，相信我，我有42个"}, {"type": "subtitle", "time": 13851.95, "timestamp": "03:50:51", "text": "我有很多胡说八道"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "东西，哦，你已经有煤了，我应该吗？"}]
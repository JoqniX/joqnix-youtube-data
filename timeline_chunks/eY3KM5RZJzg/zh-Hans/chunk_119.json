[{"type": "subtitle", "time": 7145.709, "timestamp": "01:59:05", "text": "字幕真他妈的，我的天啊，这堵墙怎么这么……"}, {"type": "subtitle", "time": 7147.31, "timestamp": "01:59:07", "text": "残忍的"}, {"type": "subtitle", "time": 7149.55, "timestamp": "01:59:09", "text": "乌龟，没办法被烤熟。"}, {"type": "subtitle", "time": 7151.43, "timestamp": "01:59:11", "text": "这只乌龟"}, {"type": "subtitle", "time": 7155.189, "timestamp": "01:59:15", "text": "游戏，没错，没错，好吧，什么？"}, {"type": "subtitle", "time": 7157.79, "timestamp": "01:59:17", "text": "哦等等，那是头牛吗？哦，那里有个C"}, {"type": "subtitle", "time": 7159.75, "timestamp": "01:59:19", "text": "等等，那些是马，马不会……"}, {"type": "subtitle", "time": 7163.069, "timestamp": "01:59:23", "text": "烤熟了，它们会被烤熟吗？"}, {"type": "subtitle", "time": 7165.87, "timestamp": "01:59:25", "text": "不，他们不会，他们不会，好吧，如果我"}, {"type": "subtitle", "time": 7167.589, "timestamp": "01:59:27", "text": "给你武士刀，但你一拿到就……"}, {"type": "subtitle", "time": 7169.75, "timestamp": "01:59:29", "text": "回家后你什么也没说"}, {"type": "subtitle", "time": 7171.189, "timestamp": "01:59:31", "text": "你的团队成员以及第一件事"}, {"type": "subtitle", "time": 7174.51, "timestamp": "01:59:34", "text": "你能杀死他们，而我却杀不死他们。"}, {"type": "subtitle", "time": 7176.47, "timestamp": "01:59:36", "text": "我应该保护他们"}, {"type": "subtitle", "time": 7179.87, "timestamp": "01:59:39", "text": "我的意思是，这是为了武士刀，你知道的。"}, {"type": "subtitle", "time": 7181.79, "timestamp": "01:59:41", "text": "不不不走"}, {"type": "subtitle", "time": 7184.55, "timestamp": "01:59:44", "text": "回来后我会做TNT炸药"}, {"type": "subtitle", "time": 7187.87, "timestamp": "01:59:47", "text": "那个TNT玩意儿，好吧，"}, {"type": "subtitle", "time": 7190.55, "timestamp": "01:59:50", "text": "给你点TNT，你就完蛋了。"}, {"type": "subtitle", "time": 7193.31, "timestamp": "01:59:53", "text": "不得不把它炸掉"}, {"type": "subtitle", "time": 7194.99, "timestamp": "01:59:54", "text": "在你自己的家里，我们要去卫生纸"}, {"type": "subtitle", "time": 7197.709, "timestamp": "01:59:57", "text": "你们都好吗？"}]
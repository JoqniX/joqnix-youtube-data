[{"type": "subtitle", "time": 16633.189, "timestamp": "04:37:13", "text": "呃，我知道我一直很沉默，你们……"}, {"type": "subtitle", "time": 16640.709, "timestamp": "04:37:20", "text": "[音乐]"}, {"type": "subtitle", "time": 16643.47, "timestamp": "04:37:23", "text": "说实话，我挺喜欢火这个元素的。"}, {"type": "subtitle", "time": 16646.59, "timestamp": "04:37:26", "text": "必需品"}, {"type": "subtitle", "time": 16650.349, "timestamp": "04:37:30", "text": "我的意思是，不，黑色SP更……"}, {"type": "subtitle", "time": 16652.39, "timestamp": "04:37:32", "text": "强大的"}, {"type": "subtitle", "time": 16655.349, "timestamp": "04:37:35", "text": "但火属性方面唯一的好处是"}, {"type": "subtitle", "time": 16664.709, "timestamp": "04:37:44", "text": "简单的食物，不需要烘烤。"}, {"type": "subtitle", "time": 16666.75, "timestamp": "04:37:46", "text": "它看起来一切都像燧石一样好用。"}, {"type": "subtitle", "time": 16668.99, "timestamp": "04:37:48", "text": "钢铁"}]
[{"type": "subtitle", "time": 14530.95, "timestamp": "04:02:10", "text": "吃吧，我们走吧，我的，我有我的星星"}, {"type": "subtitle", "time": 14534.229, "timestamp": "04:02:14", "text": "破冰者，看，这是个明星破冰者布里尔"}, {"type": "subtitle", "time": 14544.229, "timestamp": "04:02:24", "text": "采矿业发展壮大了吗？"}, {"type": "subtitle", "time": 14547.349, "timestamp": "04:02:27", "text": "挖矿，呃，我看到有些人用"}, {"type": "subtitle", "time": 14549.389, "timestamp": "04:02:29", "text": "创意在哪里"}, {"type": "subtitle", "time": 14553.11, "timestamp": "04:02:33", "text": "你把它放在铁镐上，但是又"}, {"type": "subtitle", "time": 14557.51, "timestamp": "04:02:37", "text": "你看，问题是我非常，而且我实际上"}, {"type": "subtitle", "time": 14561.79, "timestamp": "04:02:41", "text": "需要它，所以我认为他没死，等等"}, {"type": "subtitle", "time": 14564.51, "timestamp": "04:02:44", "text": "把我的X还给我"}, {"type": "subtitle", "time": 14573.469, "timestamp": "04:02:53", "text": "挖矿等等，想知道为什么你只能得到"}, {"type": "subtitle", "time": 14577.87, "timestamp": "04:02:57", "text": "任务不是我，每个人都得到了"}]
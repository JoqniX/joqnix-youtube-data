[{"type": "subtitle", "time": 11342.389, "timestamp": "03:09:02", "text": "就像今天发生的那件令人绝望的事一样"}, {"type": "subtitle", "time": 11345.75, "timestamp": "03:09:05", "text": "你想要我哭，伙计"}, {"type": "subtitle", "time": 11350.469, "timestamp": "03:09:10", "text": "真的，哦不，没开通"}, {"type": "subtitle", "time": 11353.349, "timestamp": "03:09:13", "text": "什么是燧石？你用的是什么燧石？"}, {"type": "subtitle", "time": 11356.389, "timestamp": "03:09:16", "text": "如果你用它来生火的话，就用燧石。"}, {"type": "subtitle", "time": 11359.07, "timestamp": "03:09:19", "text": "呃，做一件事，你有一个"}, {"type": "subtitle", "time": 11360.55, "timestamp": "03:09:20", "text": "妖娆"}, {"type": "subtitle", "time": 11375.19, "timestamp": "03:09:35", "text": "别走，我会私信你。"}, {"type": "subtitle", "time": 11377.91, "timestamp": "03:09:37", "text": "你能帮我做这件事吗？哦"}, {"type": "subtitle", "time": 11386.03, "timestamp": "03:09:46", "text": "当然我不能，我跳不起来，为什么要用你的"}, {"type": "subtitle", "time": 11388.309, "timestamp": "03:09:48", "text": "使用锚点"}, {"type": "subtitle", "time": 11390.79, "timestamp": "03:09:50", "text": "不，哦不，她是"}, {"type": "subtitle", "time": 11395.91, "timestamp": "03:09:55", "text": "她她她她漂浮着帮助"}, {"type": "subtitle", "time": 11397.75, "timestamp": "03:09:57", "text": "哦"}]
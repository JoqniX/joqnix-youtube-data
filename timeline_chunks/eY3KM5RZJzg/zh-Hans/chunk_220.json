[{"type": "subtitle", "time": 13200.03, "timestamp": "03:40:00", "text": "不知道啊，我的天哪，我只是"}, {"type": "subtitle", "time": 13203.79, "timestamp": "03:40:03", "text": "你觉得我用自己的声音会怎么样？"}, {"type": "subtitle", "time": 13205.67, "timestamp": "03:40:05", "text": "能"}, {"type": "subtitle", "time": 13208.91, "timestamp": "03:40:08", "text": "通常是因为今天我哭了吗？"}, {"type": "subtitle", "time": 13212.15, "timestamp": "03:40:12", "text": "因为我看了太多关于这家伙的屏幕"}, {"type": "subtitle", "time": 13214.309, "timestamp": "03:40:14", "text": "我害怕"}, {"type": "subtitle", "time": 13218.11, "timestamp": "03:40:18", "text": "你现在听起来很正常，但是当"}, {"type": "subtitle", "time": 13220.229, "timestamp": "03:40:20", "text": "你当时说了一些话"}, {"type": "subtitle", "time": 13222.75, "timestamp": "03:40:22", "text": "听起来很可疑，那是我试图……"}, {"type": "subtitle", "time": 13224.07, "timestamp": "03:40:24", "text": "角色"}, {"type": "subtitle", "time": 13227.95, "timestamp": "03:40:27", "text": "玩角色扮演游戏，你以为我不会说话吗？"}, {"type": "subtitle", "time": 13230.83, "timestamp": "03:40:30", "text": "我正在学习"}, {"type": "subtitle", "time": 13234.229, "timestamp": "03:40:34", "text": "她用煤气灯照射你，她"}, {"type": "subtitle", "time": 13237.429, "timestamp": "03:40:37", "text": "为什么是煤气灯效应？拜托，老兄，你"}, {"type": "subtitle", "time": 13239.429, "timestamp": "03:40:39", "text": "不知道什么是煤气灯"}, {"type": "subtitle", "time": 13242.189, "timestamp": "03:40:42", "text": "没关系，你们别再拉扯了。"}, {"type": "subtitle", "time": 13245.67, "timestamp": "03:40:45", "text": "够了，别再说了。"}, {"type": "subtitle", "time": 13248.51, "timestamp": "03:40:48", "text": "欺负你们这些欺负别人的人"}, {"type": "subtitle", "time": 13252.15, "timestamp": "03:40:52", "text": "意思是，你什么时候欺负过我？你欺负过我"}, {"type": "subtitle", "time": 13255.91, "timestamp": "03:40:55", "text": "我给你报价，我的天哪"}, {"type": "subtitle", "time": 13258.95, "timestamp": "03:40:58", "text": "你越来越像哈比比了，哦不，我是"}]
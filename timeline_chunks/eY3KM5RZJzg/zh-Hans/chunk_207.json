[{"type": "subtitle", "time": 12423.389, "timestamp": "03:27:03", "text": "我的天哪，我也是"}, {"type": "subtitle", "time": 12426.75, "timestamp": "03:27:06", "text": "我说，我就像不不不，我就像一个我"}, {"type": "subtitle", "time": 12431.389, "timestamp": "03:27:11", "text": "像超级英雄一样，我不能，我不能成为"}, {"type": "subtitle", "time": 12434.55, "timestamp": "03:27:14", "text": "我一直都在那里。"}, {"type": "subtitle", "time": 12437.95, "timestamp": "03:27:17", "text": "他行为举止真的很奇怪，我的天哪"}, {"type": "subtitle", "time": 12442.55, "timestamp": "03:27:22", "text": "天哪，我现在非常可疑，别这样"}, {"type": "subtitle", "time": 12446.11, "timestamp": "03:27:26", "text": "别担心，我的光荣目标是……"}, {"type": "subtitle", "time": 12447.429, "timestamp": "03:27:27", "text": "保护"}, {"type": "subtitle", "time": 12455.87, "timestamp": "03:27:35", "text": "荣耀，你知道他正要烧毁我们"}, {"type": "subtitle", "time": 12460.03, "timestamp": "03:27:40", "text": "地方不不，让我解释一下"}, {"type": "subtitle", "time": 12464.469, "timestamp": "03:27:44", "text": "让哈比比们责怪哈比比们，我们，我们"}, {"type": "subtitle", "time": 12466.71, "timestamp": "03:27:46", "text": "逃离这一切是为了这个"}, {"type": "subtitle", "time": 12469.99, "timestamp": "03:27:49", "text": "顺便一提，他用的是武士刀。"}, {"type": "subtitle", "time": 12473.99, "timestamp": "03:27:53", "text": "提议我们逃跑，因为我来了"}, {"type": "subtitle", "time": 12476.79, "timestamp": "03:27:56", "text": "我当时就在现场，所以我们才逃脱了。"}, {"type": "subtitle", "time": 12479.389, "timestamp": "03:27:59", "text": "他本来要把它烧掉的，不，不，不"}]
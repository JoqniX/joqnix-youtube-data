[{"type": "subtitle", "time": 6962.149, "timestamp": "01:56:02", "text": "你待会儿会明白的，嗯，我是说，我"}, {"type": "subtitle", "time": 6964.109, "timestamp": "01:56:04", "text": "我保证我会来。"}, {"type": "subtitle", "time": 6968.27, "timestamp": "01:56:08", "text": "那把武士刀，那把武士刀是为我准备的，因为我"}, {"type": "subtitle", "time": 6969.189, "timestamp": "01:56:09", "text": "我喜欢"}, {"type": "subtitle", "time": 6971.79, "timestamp": "01:56:11", "text": "它就像交易，不像"}, {"type": "subtitle", "time": 6976.39, "timestamp": "01:56:16", "text": "委托制作一个我们模型，拜托，哦我的天"}, {"type": "subtitle", "time": 6979.47, "timestamp": "01:56:19", "text": "天哪，等等，我们能找到点事做吗？"}, {"type": "subtitle", "time": 6980.91, "timestamp": "01:56:20", "text": "这是你居住的村庄，对吧？"}, {"type": "subtitle", "time": 6984.47, "timestamp": "01:56:24", "text": "现在我不知道了，我只是……"}, {"type": "subtitle", "time": 6987.51, "timestamp": "01:56:27", "text": "一路哭着，我失去了我的"}, {"type": "subtitle", "time": 6990.43, "timestamp": "01:56:30", "text": "我的天啊，好吧，你知道的。"}, {"type": "subtitle", "time": 6993.229, "timestamp": "01:56:33", "text": "我想看看你里面有什么"}, {"type": "subtitle", "time": 6997.91, "timestamp": "01:56:37", "text": "清点所有东西，哦等等，我"}, {"type": "subtitle", "time": 7000.79, "timestamp": "01:56:40", "text": "我拿到了，我拿到了一件胸甲，但是它是"}, {"type": "subtitle", "time": 7003.39, "timestamp": "01:56:43", "text": "不是我之前那件胸甲。"}, {"type": "subtitle", "time": 7007.109, "timestamp": "01:56:47", "text": "你身上有任何值钱的东西吗？"}, {"type": "subtitle", "time": 7009.95, "timestamp": "01:56:49", "text": "一把珍贵的铲子，这些都是黄金"}, {"type": "subtitle", "time": 7013.39, "timestamp": "01:56:53", "text": "铲子、锄头之类的东西"}, {"type": "subtitle", "time": 7014.83, "timestamp": "01:56:54", "text": "不，那样做没有任何用，好吗？"}, {"type": "subtitle", "time": 7017.47, "timestamp": "01:56:57", "text": "如果我给你一些火药呢？"}]
[{"type": "subtitle", "time": 7381.83, "timestamp": "02:03:01", "text": "你好乔，你好，我给你四个"}, {"type": "subtitle", "time": 7383.79, "timestamp": "02:03:03", "text": "五件"}, {"type": "subtitle", "time": 7385.83, "timestamp": "02:03:05", "text": "TNT"}, {"type": "subtitle", "time": 7388.709, "timestamp": "02:03:08", "text": "你好，Jo 做了一笔交易，jock 也做了一笔交易。"}, {"type": "subtitle", "time": 7392.709, "timestamp": "02:03:12", "text": "交易好的，等等，好的，你好，我正在给"}, {"type": "subtitle", "time": 7395.629, "timestamp": "02:03:15", "text": "你们有四块TNT炸药，他们需要"}, {"type": "subtitle", "time": 7398.39, "timestamp": "02:03:18", "text": "上去，狗在哪里？狗在哪里？他们"}, {"type": "subtitle", "time": 7402.03, "timestamp": "02:03:22", "text": "需要去你家附近转转。"}, {"type": "subtitle", "time": 7405.35, "timestamp": "02:03:25", "text": "他们需要损坏你的房子，而不是"}, {"type": "subtitle", "time": 7415.189, "timestamp": "02:03:35", "text": "没关系，只要把它实现就行了。"}, {"type": "subtitle", "time": 7418.91, "timestamp": "02:03:38", "text": "就让它发生吧，快点把它做出来！"}, {"type": "subtitle", "time": 7422.149, "timestamp": "02:03:42", "text": "等等，你指引我去哪里"}, {"type": "subtitle", "time": 7425.87, "timestamp": "02:03:45", "text": "放进去，但我只想放进去，不，不"}, {"type": "subtitle", "time": 7428.75, "timestamp": "02:03:48", "text": "不远，图标在哪里？"}, {"type": "subtitle", "time": 7432.189, "timestamp": "02:03:52", "text": "不，我就是，我就是，我就是，先生，这就是全部。"}, {"type": "subtitle", "time": 7434.75, "timestamp": "02:03:54", "text": "我的房子里，我想杀死那个女巫"}, {"type": "subtitle", "time": 7437.069, "timestamp": "02:03:57", "text": "不过在这里，不，它需要靠近。"}, {"type": "subtitle", "time": 7439.51, "timestamp": "02:03:59", "text": "到你家来，CH，听我说，CH"}]
[{"type": "subtitle", "time": 6540.75, "timestamp": "01:49:00", "text": "那为什么它没有"}, {"type": "subtitle", "time": 6543.589, "timestamp": "01:49:03", "text": "发送"}, {"type": "subtitle", "time": 6550.95, "timestamp": "01:49:10", "text": "并非世人所憎恨"}, {"type": "subtitle", "time": 6555.95, "timestamp": "01:49:15", "text": "全世界都恨我，全世界都恨我。"}, {"type": "subtitle", "time": 6559.109, "timestamp": "01:49:19", "text": "我的世界"}, {"type": "subtitle", "time": 6563.229, "timestamp": "01:49:23", "text": "这个世界伤害我，因为这个世界伤害我"}, {"type": "subtitle", "time": 6579.31, "timestamp": "01:49:39", "text": "失败？好吧，让我再打一遍。"}, {"type": "subtitle", "time": 6587.35, "timestamp": "01:49:47", "text": "最后，它终于发送了。"}, {"type": "subtitle", "time": 6597.189, "timestamp": "01:49:57", "text": "我的天啊，我忘了加昏迷符号了，等等"}]
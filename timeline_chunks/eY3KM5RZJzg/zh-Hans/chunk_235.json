[{"type": "subtitle", "time": 14101.03, "timestamp": "03:55:01", "text": "[音乐]"}, {"type": "subtitle", "time": 14117.79, "timestamp": "03:55:17", "text": "紧闭的面纱"}, {"type": "subtitle", "time": 14120.67, "timestamp": "03:55:20", "text": "上帝啊，我太喜欢我把我的"}, {"type": "subtitle", "time": 14130.189, "timestamp": "03:55:30", "text": "这里，但必须是黄金，没关系。"}, {"type": "subtitle", "time": 14132.67, "timestamp": "03:55:32", "text": "有紫色的东西吗？"}, {"type": "subtitle", "time": 14136.99, "timestamp": "03:55:36", "text": "哦，下界合金是紫色的，不，你可以"}, {"type": "subtitle", "time": 14139.07, "timestamp": "03:55:39", "text": "穿上棕色裤子，给他们施个魔法"}, {"type": "subtitle", "time": 14140.51, "timestamp": "03:55:40", "text": "看"}, {"type": "subtitle", "time": 14145.269, "timestamp": "03:55:45", "text": "紫棕色头盔"}, {"type": "subtitle", "time": 14150.309, "timestamp": "03:55:50", "text": "是的，但是护甲现在+2了，是的"}, {"type": "subtitle", "time": 14152.51, "timestamp": "03:55:52", "text": "等等，是加二吗？"}, {"type": "subtitle", "time": 14154.67, "timestamp": "03:55:54", "text": "皮革兄弟，赶紧给你"}, {"type": "subtitle", "time": 14157.63, "timestamp": "03:55:57", "text": "这里已经附魔了，好的，等等，给我"}]
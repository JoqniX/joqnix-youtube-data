[{"type": "subtitle", "time": 2461.349, "timestamp": "00:41:01", "text": "上帝啊，这世界真可怕，但是"}, {"type": "subtitle", "time": 2464.069, "timestamp": "00:41:04", "text": "广阔的视野，那里有樱花，是吗？"}, {"type": "subtitle", "time": 2467.349, "timestamp": "00:41:07", "text": "回到我自己的地方，我是否又回到了……"}, {"type": "subtitle", "time": 2470.43, "timestamp": "00:41:10", "text": "我自己的地区，还是某个新土地？"}, {"type": "subtitle", "time": 2475.03, "timestamp": "00:41:15", "text": "我发现或者偶然发现了"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "我真的不穿越"}, {"type": "subtitle", "time": 2481.03, "timestamp": "00:41:21", "text": "我知道我看到切尔绽放了，尽管她们"}, {"type": "subtitle", "time": 2484.109, "timestamp": "00:41:24", "text": "让我想起了我的家"}, {"type": "subtitle", "time": 2487.43, "timestamp": "00:41:27", "text": "我来自的地方"}, {"type": "subtitle", "time": 2490.109, "timestamp": "00:41:30", "text": "当我来自雪莉花丛时"}, {"type": "subtitle", "time": 2496.19, "timestamp": "00:41:36", "text": "雪，但我能看到这片土地。"}, {"type": "subtitle", "time": 2502.069, "timestamp": "00:41:42", "text": "这里更像是春天，或者更像春天。"}, {"type": "subtitle", "time": 2506.55, "timestamp": "00:41:46", "text": "更狂野，因为我看到了血管，或者像树叶一样。"}, {"type": "subtitle", "time": 2516.109, "timestamp": "00:41:56", "text": "树，但是，是的，我们冒险越多"}, {"type": "subtitle", "time": 2518.55, "timestamp": "00:41:58", "text": "跨越海洋"}]
[{"type": "subtitle", "time": 8701.469, "timestamp": "02:25:01", "text": "另一个“我的天哪，你们有吃的吗？”"}, {"type": "subtitle", "time": 8704.11, "timestamp": "02:25:04", "text": "这里的蘑菇我可以吃哦，我的天哪"}, {"type": "subtitle", "time": 8707.03, "timestamp": "02:25:07", "text": "我的天啊，我死定了，哦不不不不，别这样"}, {"type": "subtitle", "time": 8709.83, "timestamp": "02:25:09", "text": "别别别哦不不不不不不"}, {"type": "subtitle", "time": 8713.95, "timestamp": "02:25:13", "text": "不，我吃吃吃吃"}, {"type": "subtitle", "time": 8716.349, "timestamp": "02:25:16", "text": "吃吃吃，快要了我的命，我在吃，我在吃"}, {"type": "subtitle", "time": 8717.95, "timestamp": "02:25:17", "text": "我没有食物，我没有食物。"}, {"type": "subtitle", "time": 8738.269, "timestamp": "02:25:38", "text": "今天杀人是不吉利的。"}, {"type": "subtitle", "time": 8742.389, "timestamp": "02:25:42", "text": "我的麦克风坏了"}, {"type": "subtitle", "time": 8745.59, "timestamp": "02:25:45", "text": "兄弟，我不知道他是怎么搞定的。"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "伙计，你有什么F？"}, {"type": "subtitle", "time": 8751.469, "timestamp": "02:25:51", "text": "发生了什么事？你的……"}, {"type": "subtitle", "time": 8756.67, "timestamp": "02:25:56", "text": "呃，我的麦克风坏了，哦，我的天哪"}, {"type": "subtitle", "time": 8759.55, "timestamp": "02:25:59", "text": "上帝啊，所以我得订购一个新的吊臂。"}]
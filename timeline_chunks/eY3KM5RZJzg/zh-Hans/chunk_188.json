[{"type": "subtitle", "time": 11284.59, "timestamp": "03:08:04", "text": "上帝啊，我希望我的卢让我看看哦我"}, {"type": "subtitle", "time": 11289.229, "timestamp": "03:08:09", "text": "你想做什么？你在干什么？汽油？你在干什么？"}, {"type": "subtitle", "time": 11294.15, "timestamp": "03:08:14", "text": "我儿子在游戏里嚼口香糖，然后跳了进去。"}, {"type": "subtitle", "time": 11298.89, "timestamp": "03:08:18", "text": "游戏里她把我变成了奴隶，兄弟"}, {"type": "subtitle", "time": 11302.15, "timestamp": "03:08:22", "text": "[音乐]"}, {"type": "subtitle", "time": 11304.83, "timestamp": "03:08:24", "text": "什么"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "好吧，等等，呃，我想保留我的东西。"}, {"type": "subtitle", "time": 11312.309, "timestamp": "03:08:32", "text": "所以如果我死了，就像我的东西一样。"}, {"type": "subtitle", "time": 11317.429, "timestamp": "03:08:37", "text": "呃呃呃，鱼，为什么要保留库存？"}, {"type": "subtitle", "time": 11322.469, "timestamp": "03:08:42", "text": "有可能，因为那样它就消除了"}, {"type": "subtitle", "time": 11323.75, "timestamp": "03:08:43", "text": "元素"}, {"type": "subtitle", "time": 11326.63, "timestamp": "03:08:46", "text": "奋斗，我们，我们，繁荣，我们"}, {"type": "subtitle", "time": 11328.83, "timestamp": "03:08:48", "text": "很高兴见到你们"}, {"type": "subtitle", "time": 11332.59, "timestamp": "03:08:52", "text": "像我一样挣扎"}, {"type": "subtitle", "time": 11335.67, "timestamp": "03:08:55", "text": "我，你刚才说的话是什么意思？"}, {"type": "subtitle", "time": 11339.67, "timestamp": "03:08:59", "text": "就像你说的，哦我的天哪，是的，我是，我是"}]
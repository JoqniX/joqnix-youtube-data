[{"type": "subtitle", "time": 12600.79, "timestamp": "03:30:00", "text": "当时正在外面砍柴，一个神秘的人"}, {"type": "subtitle", "time": 12603.59, "timestamp": "03:30:03", "text": "红衣主教走过来对我说，我有一个"}, {"type": "subtitle", "time": 12605.349, "timestamp": "03:30:05", "text": "问题"}, {"type": "subtitle", "time": 12614.389, "timestamp": "03:30:14", "text": "[音乐]"}, {"type": "subtitle", "time": 12618.59, "timestamp": "03:30:18", "text": "天哪，真的就是这样，相信我。"}, {"type": "subtitle", "time": 12621.99, "timestamp": "03:30:21", "text": "我等等，守护天使在哪儿？"}, {"type": "subtitle", "time": 12623.75, "timestamp": "03:30:23", "text": "是"}, {"type": "subtitle", "time": 12628.03, "timestamp": "03:30:28", "text": "他是守护天使，如果守护天使"}, {"type": "subtitle", "time": 12631.269, "timestamp": "03:30:31", "text": "守护天使就在你身边"}, {"type": "subtitle", "time": 12634.469, "timestamp": "03:30:34", "text": "它本应是这个世界的守护者。"}, {"type": "subtitle", "time": 12636.55, "timestamp": "03:30:36", "text": "顺便一提，他是守护天使，他被允许这样做。"}, {"type": "subtitle", "time": 12640.429, "timestamp": "03:30:40", "text": "他要杀我们，也要杀我，当……"}, {"type": "subtitle", "time": 12643.95, "timestamp": "03:30:43", "text": "他不是天使，等等，他不是天使。"}, {"type": "subtitle", "time": 12646.55, "timestamp": "03:30:46", "text": "红衣主教，我想我是唯一一个……"}, {"type": "subtitle", "time": 12648.51, "timestamp": "03:30:48", "text": "称其为天使骗局"}, {"type": "subtitle", "time": 12651.429, "timestamp": "03:30:51", "text": "安慰守护者，我猜是什么？"}, {"type": "subtitle", "time": 12652.429, "timestamp": "03:30:52", "text": "去"}, {"type": "subtitle", "time": 12657.99, "timestamp": "03:30:57", "text": "我完全不知道，我没有"}]
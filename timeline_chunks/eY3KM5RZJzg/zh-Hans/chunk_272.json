[{"type": "subtitle", "time": 16326.149, "timestamp": "04:32:06", "text": "伙计，哦不，那些家伙快死了！"}, {"type": "subtitle", "time": 16339.72, "timestamp": "04:32:19", "text": "你好"}, {"type": "subtitle", "time": 16342.189, "timestamp": "04:32:22", "text": "[音乐]"}, {"type": "subtitle", "time": 16345.229, "timestamp": "04:32:25", "text": "M，它奏效了吗？我们开始吧。"}, {"type": "subtitle", "time": 16349.189, "timestamp": "04:32:29", "text": "你看他春天不是"}, {"type": "subtitle", "time": 16351.67, "timestamp": "04:32:31", "text": "还有什么时间？我们试试吧。"}, {"type": "subtitle", "time": 16361.269, "timestamp": "04:32:41", "text": "我看不见心形图案里的血，为什么没有血？"}, {"type": "subtitle", "time": 16363.59, "timestamp": "04:32:43", "text": "血"}, {"type": "subtitle", "time": 16364.79, "timestamp": "04:32:44", "text": "哦，我的天"}, {"type": "subtitle", "time": 16367.75, "timestamp": "04:32:47", "text": "天哪，我当时就想，能不能把呕吐物放进去？"}, {"type": "subtitle", "time": 16370.75, "timestamp": "04:32:50", "text": "那把武士刀就像血一样。"}, {"type": "subtitle", "time": 16374.109, "timestamp": "04:32:54", "text": "像魂系游戏那样的武士刀，不是那种。"}, {"type": "subtitle", "time": 16376.59, "timestamp": "04:32:56", "text": "魂系游戏，那是什么游戏来着？"}]
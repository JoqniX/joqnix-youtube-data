[{"type": "subtitle", "time": 1141.19, "timestamp": "00:19:01", "text": "CA 我没死，无论付出什么代价你都会听到"}, {"type": "subtitle", "time": 1143.149, "timestamp": "00:19:03", "text": "你"}, {"type": "subtitle", "time": 1151.63, "timestamp": "00:19:11", "text": "小鬼，他为什么？"}, {"type": "subtitle", "time": 1153.59, "timestamp": "00:19:13", "text": "他为什么还活着"}, {"type": "subtitle", "time": 1161.789, "timestamp": "00:19:21", "text": "兄弟，我的天啊，为什么会有暴徒？"}, {"type": "subtitle", "time": 1165.51, "timestamp": "00:19:25", "text": "现在这里是白天，为什么会有暴徒？"}, {"type": "subtitle", "time": 1167.51, "timestamp": "00:19:27", "text": "那里有什么"}, {"type": "subtitle", "time": 1176.149, "timestamp": "00:19:36", "text": "发生了什么？哦不，为什么会有女士？哦等等"}, {"type": "subtitle", "time": 1179.59, "timestamp": "00:19:39", "text": "我的弹弓在哪儿？我需要我的长弹弓。"}, {"type": "subtitle", "time": 1181.83, "timestamp": "00:19:41", "text": "范围在哪里"}, {"type": "subtitle", "time": 1184.87, "timestamp": "00:19:44", "text": "弹弓，哦哦，我把它留下了，我把它留下了，哦"}, {"type": "subtitle", "time": 1189.35, "timestamp": "00:19:49", "text": "我们必须制作一个弹弓，所以"}]
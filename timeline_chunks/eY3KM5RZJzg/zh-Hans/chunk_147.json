[{"type": "subtitle", "time": 8824.59, "timestamp": "02:27:04", "text": "然后我的生命力啊，我的天啊，我的天啊"}, {"type": "subtitle", "time": 8828.15, "timestamp": "02:27:08", "text": "他回来了，好的，呃，你好，你……你……"}, {"type": "subtitle", "time": 8830.79, "timestamp": "02:27:10", "text": "拿到你的呃"}, {"type": "subtitle", "time": 8833.83, "timestamp": "02:27:13", "text": "剑，哪把剑？铁剑SW，哦耶"}, {"type": "subtitle", "time": 8835.55, "timestamp": "02:27:15", "text": "那把剑不见了。"}, {"type": "subtitle", "time": 8839.19, "timestamp": "02:27:19", "text": "答应过你，不，不，我没全部拿到。"}, {"type": "subtitle", "time": 8840.95, "timestamp": "02:27:20", "text": "好的，好的，嗯"}, {"type": "subtitle", "time": 8843.469, "timestamp": "02:27:23", "text": "我好像还漏掉了两三个，不，是三个。"}, {"type": "subtitle", "time": 8845.87, "timestamp": "02:27:25", "text": "祖母绿，因为"}, {"type": "subtitle", "time": 8849.11, "timestamp": "02:27:29", "text": "我没事，好吧，你说什么？"}, {"type": "subtitle", "time": 8853.63, "timestamp": "02:27:33", "text": "好吧，我只能用我唯一的方式攻击你。"}, {"type": "subtitle", "time": 8856.99, "timestamp": "02:27:36", "text": "告诉我你造成了多少伤害……"}, {"type": "subtitle", "time": 8858.469, "timestamp": "02:27:38", "text": "再来一次，保持"}, {"type": "subtitle", "time": 8861.07, "timestamp": "02:27:41", "text": "两点半或一点半"}, {"type": "subtitle", "time": 8862.83, "timestamp": "02:27:42", "text": "觉得是啊，一个半，一个半"}, {"type": "subtitle", "time": 8865.99, "timestamp": "02:27:45", "text": "就R我的手好吗，嗯，哦，你是"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "顺便问一下，为什么需要强大的全套盔甲？"}, {"type": "subtitle", "time": 8871.03, "timestamp": "02:27:51", "text": "你为什么感觉像个鳍状物？（停顿）"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "患病的"}]
[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "我的天哪，太酷了，我们给你一个"}, {"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "任务 Muki，我们给你们一个"}, {"type": "subtitle", "time": 9307.63, "timestamp": "02:35:07", "text": "任务是什么？是什么任务？所以有……"}, {"type": "subtitle", "time": 9309.63, "timestamp": "02:35:09", "text": "如果你能找到另一个名叫Drager的玩家的话"}, {"type": "subtitle", "time": 9312.269, "timestamp": "02:35:12", "text": "杀了他，你会大赚一笔。"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "实际上，这背后还有一些东西。"}, {"type": "subtitle", "time": 9320.349, "timestamp": "02:35:20", "text": "啊，我的天哪"}, {"type": "subtitle", "time": 9324.15, "timestamp": "02:35:24", "text": "我死了，我就是一切"}, {"type": "subtitle", "time": 9334.55, "timestamp": "02:35:34", "text": "制表"}, {"type": "subtitle", "time": 9344.269, "timestamp": "02:35:44", "text": "第二"}, {"type": "subtitle", "time": 9350.07, "timestamp": "02:35:50", "text": "[音乐]"}]
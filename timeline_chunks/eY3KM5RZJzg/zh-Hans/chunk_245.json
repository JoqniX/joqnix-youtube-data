[{"type": "subtitle", "time": 14702.55, "timestamp": "04:05:02", "text": "那让我知道我就可以免费获得了。"}, {"type": "subtitle", "time": 14705.149, "timestamp": "04:05:05", "text": "给我们提供食物"}, {"type": "subtitle", "time": 14709.99, "timestamp": "04:05:09", "text": "吃苏来来下来下来快乐"}, {"type": "subtitle", "time": 14718.83, "timestamp": "04:05:18", "text": "食物 我 我 我会弄些吃的，别担心"}, {"type": "subtitle", "time": 14721.189, "timestamp": "04:05:21", "text": "我会弄点吃的，别担心，我有"}, {"type": "subtitle", "time": 14729.11, "timestamp": "04:05:29", "text": "你吃的食物，你不知道快乐"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "是乔克的……宠物"}, {"type": "subtitle", "time": 14733.55, "timestamp": "04:05:33", "text": "姓名"}, {"type": "subtitle", "time": 14737.55, "timestamp": "04:05:37", "text": "乔·乔基是他的宠物"}, {"type": "subtitle", "time": 14740.469, "timestamp": "04:05:40", "text": "名字好，等等，你有吃的吗？我也有"}, {"type": "subtitle", "time": 14744.469, "timestamp": "04:05:44", "text": "需要一些……呃，我没有那么多，好吧。"}, {"type": "subtitle", "time": 14756.45, "timestamp": "04:05:56", "text": "上帝啊，你明白吗？"}, {"type": "subtitle", "time": 14758.59, "timestamp": "04:05:58", "text": "[音乐]"}]
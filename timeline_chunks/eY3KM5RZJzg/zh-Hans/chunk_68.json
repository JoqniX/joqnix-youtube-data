[{"type": "subtitle", "time": 4088.95, "timestamp": "01:08:08", "text": "傻瓜看花是"}, {"type": "subtitle", "time": 4091.87, "timestamp": "01:08:11", "text": "飞翔的花朵在飞翔，这是什么？"}, {"type": "subtitle", "time": 4095.43, "timestamp": "01:08:15", "text": "这个世界，什么是梯子？苍蝇为什么会飞？"}, {"type": "subtitle", "time": 4104.57, "timestamp": "01:08:24", "text": "坐飞机时你病得很重"}, {"type": "subtitle", "time": 4132.559, "timestamp": "01:08:52", "text": "不不"}, {"type": "subtitle", "time": 4137.99, "timestamp": "01:08:57", "text": "我"}]
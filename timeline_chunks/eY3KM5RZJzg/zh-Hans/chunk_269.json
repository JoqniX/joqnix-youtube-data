[{"type": "subtitle", "time": 16140.95, "timestamp": "04:29:00", "text": "和他们"}, {"type": "subtitle", "time": 16144.75, "timestamp": "04:29:04", "text": "现在 Astra 杀死了 Mituki Zuki，我把它给了"}, {"type": "subtitle", "time": 16147.389, "timestamp": "04:29:07", "text": "祖基祖基把它给了它的"}, {"type": "subtitle", "time": 16152.269, "timestamp": "04:29:12", "text": "好的，地图就在那里，呃，你"}, {"type": "subtitle", "time": 16155.87, "timestamp": "04:29:15", "text": "我眼前所见，对吧，哦，就是那个"}, {"type": "subtitle", "time": 16164.269, "timestamp": "04:29:24", "text": "其中一个，不是这个，地图。"}, {"type": "subtitle", "time": 16166.87, "timestamp": "04:29:26", "text": "你在某处找到了一张地图。"}, {"type": "subtitle", "time": 16170.91, "timestamp": "04:29:30", "text": "对，哦，宝藏之地，哦耶"}, {"type": "subtitle", "time": 16174.349, "timestamp": "04:29:34", "text": "我忘了那个地方在哪儿"}, {"type": "subtitle", "time": 16176.429, "timestamp": "04:29:36", "text": "它"}, {"type": "subtitle", "time": 16179.469, "timestamp": "04:29:39", "text": "老兄，我真没想到你会……"}, {"type": "subtitle", "time": 16189.51, "timestamp": "04:29:49", "text": "结构就像一个宝藏"}, {"type": "subtitle", "time": 16192.07, "timestamp": "04:29:52", "text": "我甚至不记得那是什么地方了"}, {"type": "subtitle", "time": 16192.88, "timestamp": "04:29:52", "text": "我的方向"}]
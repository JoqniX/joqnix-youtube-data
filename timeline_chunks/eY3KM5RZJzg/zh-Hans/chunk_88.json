[{"type": "subtitle", "time": 5280.39, "timestamp": "01:28:00", "text": "摸一下，我就记下来，但是……"}, {"type": "subtitle", "time": 5287.03, "timestamp": "01:28:07", "text": "呃，你怎么做？"}, {"type": "subtitle", "time": 5291.709, "timestamp": "01:28:11", "text": "打开啊，我根本打不开，好吧，呃……"}, {"type": "subtitle", "time": 5294.149, "timestamp": "01:28:14", "text": "那么请看一下，请看一下"}, {"type": "subtitle", "time": 5295.91, "timestamp": "01:28:15", "text": "你需要的那把剑"}, {"type": "subtitle", "time": 5299.709, "timestamp": "01:28:19", "text": "剑 bua bua bua 你呢，笨蛋"}, {"type": "subtitle", "time": 5302.91, "timestamp": "01:28:22", "text": "莫尤"}, {"type": "subtitle", "time": 5307.35, "timestamp": "01:28:27", "text": "笨蛋，拜托，不是伟大的"}, {"type": "subtitle", "time": 5310.629, "timestamp": "01:28:30", "text": "剑，所有这些东西都在基地里。"}, {"type": "subtitle", "time": 5312.109, "timestamp": "01:28:32", "text": "鼠标悬停在"}, {"type": "subtitle", "time": 5313.91, "timestamp": "01:28:33", "text": "我得到了"}, {"type": "subtitle", "time": 5317.91, "timestamp": "01:28:37", "text": "那就是洞，洞回去"}, {"type": "subtitle", "time": 5319.95, "timestamp": "01:28:39", "text": "返回 返回 返回"}, {"type": "subtitle", "time": 5323.229, "timestamp": "01:28:43", "text": "好的，呃，黄金效率"}, {"type": "subtitle", "time": 5327.109, "timestamp": "01:28:47", "text": "增加采矿，好吧，我的意思是那个。"}, {"type": "subtitle", "time": 5329.43, "timestamp": "01:28:49", "text": "没错，那就是宝藏里的重量。"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "不，好吧，请继续，你这个笨蛋"}, {"type": "subtitle", "time": 5336.47, "timestamp": "01:28:56", "text": "点击那把剑，就是那个东西。"}, {"type": "subtitle", "time": 5336.85, "timestamp": "01:28:56", "text": "你"}]
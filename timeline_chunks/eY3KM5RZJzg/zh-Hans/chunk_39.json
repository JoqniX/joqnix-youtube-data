[{"type": "subtitle", "time": 2351.23, "timestamp": "00:39:11", "text": "所以这不是坟墓SC崩溃"}, {"type": "subtitle", "time": 2351.49, "timestamp": "00:39:11", "text": "这"}, {"type": "subtitle", "time": 2369.51, "timestamp": "00:39:29", "text": "服务器必须小心，我也必须"}, {"type": "subtitle", "time": 2371.71, "timestamp": "00:39:31", "text": "确保我这样做"}, {"type": "subtitle", "time": 2374.91, "timestamp": "00:39:34", "text": "按……你叫什么？"}, {"type": "subtitle", "time": 2379.589, "timestamp": "00:39:39", "text": "它按下控制键就会摔倒并猛击"}, {"type": "subtitle", "time": 2391.71, "timestamp": "00:39:51", "text": "一片辉煌的土地"}, {"type": "subtitle", "time": 2394.829, "timestamp": "00:39:54", "text": "目的是为了荣耀"}]
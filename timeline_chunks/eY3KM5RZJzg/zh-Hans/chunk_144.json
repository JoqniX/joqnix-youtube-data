[{"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "它，哦，发生了什么？我把它杀了，我把它杀了"}, {"type": "subtitle", "time": 8656.469, "timestamp": "02:24:16", "text": "我杀了它，我杀了骷髅我们"}, {"type": "subtitle", "time": 8658.07, "timestamp": "02:24:18", "text": "需要点亮这个"}, {"type": "subtitle", "time": 8661.309, "timestamp": "02:24:21", "text": "我的天啊"}, {"type": "subtitle", "time": 8664.67, "timestamp": "02:24:24", "text": "好吧，呃，那座豪宅在哪儿？我们弄丢了。"}, {"type": "subtitle", "time": 8669.469, "timestamp": "02:24:29", "text": "这边走对吧？等等，我给你看看。"}, {"type": "subtitle", "time": 8671.95, "timestamp": "02:24:31", "text": "其实我想给你看点东西。"}, {"type": "subtitle", "time": 8675.11, "timestamp": "02:24:35", "text": "呃"}, {"type": "subtitle", "time": 8679.75, "timestamp": "02:24:39", "text": "它现在活了过来"}, {"type": "subtitle", "time": 8684.429, "timestamp": "02:24:44", "text": "就在这附近。"}, {"type": "subtitle", "time": 8692.389, "timestamp": "02:24:52", "text": "我的天啊，我要死了，我要死了，我要死了"}, {"type": "subtitle", "time": 8694.429, "timestamp": "02:24:54", "text": "我要死了 我要死了 我要死了 我要死了"}, {"type": "subtitle", "time": 8697.79, "timestamp": "02:24:57", "text": "谢谢你，我的天哪，还有……"}]
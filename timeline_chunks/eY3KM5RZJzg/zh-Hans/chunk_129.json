[{"type": "subtitle", "time": 7740.83, "timestamp": "02:09:00", "text": "到处都说不定他付了款。他付了款吗？"}, {"type": "subtitle", "time": 7742.149, "timestamp": "02:09:02", "text": "纯粹的骗局"}, {"type": "subtitle", "time": 7745.79, "timestamp": "02:09:05", "text": "我还是什么"}, {"type": "subtitle", "time": 7748.35, "timestamp": "02:09:08", "text": "CH，你得告诉我发生了什么"}, {"type": "subtitle", "time": 7750.229, "timestamp": "02:09:10", "text": "事情确实发生了，但我还是不明白。"}, {"type": "subtitle", "time": 7751.549, "timestamp": "02:09:11", "text": "发生了什么事，好吧好吧好吧"}, {"type": "subtitle", "time": 7753.549, "timestamp": "02:09:13", "text": "好吧，所以发生了什么事？"}, {"type": "subtitle", "time": 7757.31, "timestamp": "02:09:17", "text": "我失去了所有的一切"}, {"type": "subtitle", "time": 7761.47, "timestamp": "02:09:21", "text": "物品？是的，因为我死了，那是什么？"}, {"type": "subtitle", "time": 7763.109, "timestamp": "02:09:23", "text": "物品是什么？告诉我是什么。"}, {"type": "subtitle", "time": 7765.03, "timestamp": "02:09:25", "text": "你昨天看到的那些东西"}, {"type": "subtitle", "time": 7768.95, "timestamp": "02:09:28", "text": "金色的，OP的东西，金色的"}, {"type": "subtitle", "time": 7770.109, "timestamp": "02:09:30", "text": "胸部"}, {"type": "subtitle", "time": 7774.91, "timestamp": "02:09:34", "text": "盘子，呃，它可以让我滑动，还有"}, {"type": "subtitle", "time": 7777.39, "timestamp": "02:09:37", "text": "裤子让我可以点击"}, {"type": "subtitle", "time": 7780.99, "timestamp": "02:09:40", "text": "stve 呃，那层面纱让我得以停留"}, {"type": "subtitle", "time": 7783.109, "timestamp": "02:09:43", "text": "隐藏起来了"}, {"type": "subtitle", "time": 7785.87, "timestamp": "02:09:45", "text": "然后我遇到了很多怪物，我当时有一把超强的剑。"}, {"type": "subtitle", "time": 7789.229, "timestamp": "02:09:49", "text": "它有火力，所以我可以免费进入。"}, {"type": "subtitle", "time": 7793.069, "timestamp": "02:09:53", "text": "宰杀鸡、牛等获得的食物"}, {"type": "subtitle", "time": 7796.51, "timestamp": "02:09:56", "text": "好吧，告诉我，告诉我，那个"}, {"type": "subtitle", "time": 7798.87, "timestamp": "02:09:58", "text": "他达成的交易是祖母绿"}]
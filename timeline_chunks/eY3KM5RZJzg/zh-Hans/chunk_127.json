[{"type": "subtitle", "time": 7620.31, "timestamp": "02:07:00", "text": "我的是什么？什么？什么？什么？关于"}, {"type": "subtitle", "time": 7622.589, "timestamp": "02:07:02", "text": "烧毁你的房子？那是什么？哦"}, {"type": "subtitle", "time": 7625.87, "timestamp": "02:07:05", "text": "当时的情况是，他给出了两个选择。"}, {"type": "subtitle", "time": 7628.149, "timestamp": "02:07:08", "text": "呃，我本来想付首付的。"}, {"type": "subtitle", "time": 7631.31, "timestamp": "02:07:11", "text": "因为我手里拿着两颗祖母绿，所以他"}, {"type": "subtitle", "time": 7635.39, "timestamp": "02:07:15", "text": "他一开始好像要了16个。"}, {"type": "subtitle", "time": 7639.109, "timestamp": "02:07:19", "text": "剑上的翡翠，我的天哪，我"}, {"type": "subtitle", "time": 7642.83, "timestamp": "02:07:22", "text": "我拥有过"}, {"type": "subtitle", "time": 7646.189, "timestamp": "02:07:26", "text": "但我没得TPD，所以他"}, {"type": "subtitle", "time": 7649.709, "timestamp": "02:07:29", "text": "建议比如，如果你能找到你的"}, {"type": "subtitle", "time": 7653.069, "timestamp": "02:07:33", "text": "他说基地最初是B，因为"}, {"type": "subtitle", "time": 7655.43, "timestamp": "02:07:35", "text": "我们没有合适的基地，洞穴是"}, {"type": "subtitle", "time": 7658.229, "timestamp": "02:07:38", "text": "我们的基地右我最初想要它你"}, {"type": "subtitle", "time": 7660.589, "timestamp": "02:07:40", "text": "试过了，你知道你知道的"}, {"type": "subtitle", "time": 7664.709, "timestamp": "02:07:44", "text": "想耍花招骗我？不，我没有。"}, {"type": "subtitle", "time": 7668.229, "timestamp": "02:07:48", "text": "等等，不，我并没有比你聪明，让我……"}, {"type": "subtitle", "time": 7672.43, "timestamp": "02:07:52", "text": "让我结束，让我结束"}, {"type": "subtitle", "time": 7674.51, "timestamp": "02:07:54", "text": "拉屎"}, {"type": "subtitle", "time": 7676.83, "timestamp": "02:07:56", "text": "你在干什么？你在做什么？"}]
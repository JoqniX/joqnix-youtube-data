[{"type": "subtitle", "time": 3007.99, "timestamp": "00:50:07", "text": "安慰，是的，是的，是的"}, {"type": "subtitle", "time": 3009.15, "timestamp": "00:50:09", "text": "旅行"}, {"type": "subtitle", "time": 3017.589, "timestamp": "00:50:17", "text": "从某种意义上说，我认为他是我的敌人。"}, {"type": "subtitle", "time": 3026.99, "timestamp": "00:50:26", "text": "然而，在他们之中"}, {"type": "subtitle", "time": 3029.67, "timestamp": "00:50:29", "text": "我的天啊，他们居然在取得进展，为什么？"}, {"type": "subtitle", "time": 3031.75, "timestamp": "00:50:31", "text": "我想知道为什么每个人都在进步。"}, {"type": "subtitle", "time": 3035.47, "timestamp": "00:50:35", "text": "我需要找到面对现实的方法"}, {"type": "subtitle", "time": 3048.95, "timestamp": "00:50:48", "text": "想要"}, {"type": "subtitle", "time": 3052.309, "timestamp": "00:50:52", "text": "结构没问题，我们需要它们，呃，"}, {"type": "subtitle", "time": 3054.829, "timestamp": "00:50:54", "text": "就像我们需要去海洋一样"}, {"type": "subtitle", "time": 3058.349, "timestamp": "00:50:58", "text": "探索一下，嗯，总有一天"}]
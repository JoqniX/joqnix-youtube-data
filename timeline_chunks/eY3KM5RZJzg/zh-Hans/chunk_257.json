[{"type": "subtitle", "time": 15422.469, "timestamp": "04:17:02", "text": "等等，我可以把这两个结合起来，所以"}, {"type": "subtitle", "time": 15426.55, "timestamp": "04:17:06", "text": "像弹跳和侧移那样把人推开"}, {"type": "subtitle", "time": 15428.71, "timestamp": "04:17:08", "text": "等待"}, {"type": "subtitle", "time": 15435.269, "timestamp": "04:17:15", "text": "你得到了一个"}, {"type": "subtitle", "time": 15437.99, "timestamp": "04:17:17", "text": "盾牌就是他"}, {"type": "subtitle", "time": 15440.99, "timestamp": "04:17:20", "text": "游泳？是的，先生，你在做什么？"}, {"type": "subtitle", "time": 15442.189, "timestamp": "04:17:22", "text": "能"}, {"type": "subtitle", "time": 15444.03, "timestamp": "04:17:24", "text": "游泳？是啊。"}, {"type": "subtitle", "time": 15454.03, "timestamp": "04:17:34", "text": "好了，等等，我能听到自己的声音了。"}, {"type": "subtitle", "time": 15456.55, "timestamp": "04:17:36", "text": "是的，因为"}, {"type": "subtitle", "time": 15459.149, "timestamp": "04:17:39", "text": "我是"}, {"type": "subtitle", "time": 15461.469, "timestamp": "04:17:41", "text": "我的"}, {"type": "subtitle", "time": 15465.429, "timestamp": "04:17:45", "text": "我记得我见过这片区域"}, {"type": "subtitle", "time": 15468.389, "timestamp": "04:17:48", "text": "不不，不是这个，它就像……"}, {"type": "subtitle", "time": 15471.87, "timestamp": "04:17:51", "text": "就像樱花盛开的地方，嗯……"}, {"type": "subtitle", "time": 15474.59, "timestamp": "04:17:54", "text": "我的天哪，我想知道樱花在哪里盛开。"}, {"type": "subtitle", "time": 15476.67, "timestamp": "04:17:56", "text": "我的天哪"}]
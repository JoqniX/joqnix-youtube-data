[{"type": "subtitle", "time": 12120.349, "timestamp": "03:22:00", "text": "砾石，这是砾石，这东西"}, {"type": "subtitle", "time": 12123.59, "timestamp": "03:22:03", "text": "阻止此操作"}, {"type": "subtitle", "time": 12130.429, "timestamp": "03:22:10", "text": "好的"}, {"type": "subtitle", "time": 12134.79, "timestamp": "03:22:14", "text": "哇，我有很多很棒的橡木制品。"}, {"type": "subtitle", "time": 12142.67, "timestamp": "03:22:22", "text": "哦，对了，我还有《Splash》的夜晚部分。"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "隐身术，哦耶，保留那些"}, {"type": "subtitle", "time": 12157.99, "timestamp": "03:22:37", "text": "安全，我们需要真正地……"}, {"type": "subtitle", "time": 12161.67, "timestamp": "03:22:41", "text": "秘密的，呃，秘密的检查站位置在里面"}, {"type": "subtitle", "time": 12163.87, "timestamp": "03:22:43", "text": "这"}, {"type": "subtitle", "time": 12167.189, "timestamp": "03:22:47", "text": "像这样的洞穴可以被袭击。"}, {"type": "subtitle", "time": 12169.229, "timestamp": "03:22:49", "text": "你永远不知道会发生什么"}, {"type": "subtitle", "time": 12173.51, "timestamp": "03:22:53", "text": "发生吧，我的天哪，是的，我们会的，当我们"}, {"type": "subtitle", "time": 12175.429, "timestamp": "03:22:55", "text": "在我们的探险之后还有时间"}, {"type": "subtitle", "time": 12178.91, "timestamp": "03:22:58", "text": "我们能做的一切都喜欢，嗯，是的，一旦我们"}]
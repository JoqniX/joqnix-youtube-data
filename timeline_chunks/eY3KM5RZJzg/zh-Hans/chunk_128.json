[{"type": "subtitle", "time": 7681.27, "timestamp": "02:08:01", "text": "你在干什么？你是谁？我的天哪"}, {"type": "subtitle", "time": 7683.47, "timestamp": "02:08:03", "text": "你可能有什么？好吧，你是什么？"}, {"type": "subtitle", "time": 7687.47, "timestamp": "02:08:07", "text": "我的天啊，至少把那婊子干掉了"}, {"type": "subtitle", "time": 7691.95, "timestamp": "02:08:11", "text": "请她活着，为我求求你。"}, {"type": "subtitle", "time": 7694.79, "timestamp": "02:08:14", "text": "附近哪里"}, {"type": "subtitle", "time": 7698.91, "timestamp": "02:08:18", "text": "他在哪里？他在哪里？他在哪里？"}, {"type": "subtitle", "time": 7702.5, "timestamp": "02:08:22", "text": "他，我们回去吧。"}, {"type": "subtitle", "time": 7704.069, "timestamp": "02:08:24", "text": "[音乐]"}, {"type": "subtitle", "time": 7707.47, "timestamp": "02:08:27", "text": "我甚至都不知道"}, {"type": "subtitle", "time": 7713.069, "timestamp": "02:08:33", "text": "知道为什么会有“哦，我的天哪，什么什么”"}, {"type": "subtitle", "time": 7717.96, "timestamp": "02:08:37", "text": "我的天哪"}, {"type": "subtitle", "time": 7731.83, "timestamp": "02:08:51", "text": "哇，好的"}, {"type": "subtitle", "time": 7734.149, "timestamp": "02:08:54", "text": "人生充满痛苦，等等，他去哪儿了？"}, {"type": "subtitle", "time": 7736.99, "timestamp": "02:08:56", "text": "他是不是就这么消失了？他是不是就这么走了？"}, {"type": "subtitle", "time": 7738.149, "timestamp": "02:08:58", "text": "轰炸"}]
[{"type": "subtitle", "time": 8162.27, "timestamp": "02:16:02", "text": "电动汽车终将衰落，邪恶终将衰落，那是一个漫长的过程。"}, {"type": "subtitle", "time": 8167.35, "timestamp": "02:16:07", "text": "掉下去，那是我的，向下，我的，向下，我的"}, {"type": "subtitle", "time": 8170.47, "timestamp": "02:16:10", "text": "往下看，就像真的往下看一样。"}, {"type": "subtitle", "time": 8173.069, "timestamp": "02:16:13", "text": "我的不不不不，回去回去回去回去"}, {"type": "subtitle", "time": 8176.31, "timestamp": "02:16:16", "text": "反向查看所有"}, {"type": "subtitle", "time": 8179.91, "timestamp": "02:16:19", "text": "一路向下，用你的镐子向左。"}, {"type": "subtitle", "time": 8182.35, "timestamp": "02:16:22", "text": "点击左侧"}, {"type": "subtitle", "time": 8192.429, "timestamp": "02:16:32", "text": "往后摔，那可是个很高的落差，你会摔死的。"}, {"type": "subtitle", "time": 8194.509, "timestamp": "02:16:34", "text": "你会知道的一切都会到来"}, {"type": "subtitle", "time": 8199.83, "timestamp": "02:16:39", "text": "我没有镐，嗯，是的"}, {"type": "subtitle", "time": 8202.549, "timestamp": "02:16:42", "text": "就这么做吧，等等，不行，这也太可怕了。"}, {"type": "subtitle", "time": 8204.429, "timestamp": "02:16:44", "text": "呃，我们需要"}, {"type": "subtitle", "time": 8207.19, "timestamp": "02:16:47", "text": "不，你需要，你需要镐。"}, {"type": "subtitle", "time": 8211.03, "timestamp": "02:16:51", "text": "需要一把镐，你有备用的吗？"}, {"type": "subtitle", "time": 8214.99, "timestamp": "02:16:54", "text": "等等，让我想想，我好像没有。"}, {"type": "subtitle", "time": 8217.27, "timestamp": "02:16:57", "text": "没关系，就这样"}]
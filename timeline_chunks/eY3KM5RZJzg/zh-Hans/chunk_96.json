[{"type": "subtitle", "time": 5760.79, "timestamp": "01:36:00", "text": "想"}, {"type": "subtitle", "time": 5768.27, "timestamp": "01:36:08", "text": "接下来，我什么时候测试这个东西？"}, {"type": "subtitle", "time": 5770.91, "timestamp": "01:36:10", "text": "我去找这个测试对象"}, {"type": "subtitle", "time": 5772.59, "timestamp": "01:36:12", "text": "对，对，对，这就是我"}, {"type": "subtitle", "time": 5775.27, "timestamp": "01:36:15", "text": "测试一下，好的，等等，我在这里测试"}, {"type": "subtitle", "time": 5777.83, "timestamp": "01:36:17", "text": "我就是在这里测试的"}, {"type": "subtitle", "time": 5780.79, "timestamp": "01:36:20", "text": "枯萎了，好吧，就是这样，就是这样。"}, {"type": "subtitle", "time": 5784.51, "timestamp": "01:36:24", "text": "知道枯萎是如何发生的，然后我"}, {"type": "subtitle", "time": 5788.83, "timestamp": "01:36:28", "text": "开关是的，开火了，这个型号的模型"}, {"type": "subtitle", "time": 5791.37, "timestamp": "01:36:31", "text": "我的天啊，这个模特"}, {"type": "subtitle", "time": 5792.55, "timestamp": "01:36:32", "text": "[音乐]"}, {"type": "subtitle", "time": 5795.229, "timestamp": "01:36:35", "text": "不，道德"}, {"type": "subtitle", "time": 5798.35, "timestamp": "01:36:38", "text": "啊，千万别，那是把枯萎之剑，不！"}, {"type": "subtitle", "time": 5800.35, "timestamp": "01:36:40", "text": "你应该去找火焰哦"}, {"type": "subtitle", "time": 5801.91, "timestamp": "01:36:41", "text": "等等，我想是名字，名字是"}, {"type": "subtitle", "time": 5803.39, "timestamp": "01:36:43", "text": "火焰剑"}, {"type": "subtitle", "time": 5805.629, "timestamp": "01:36:45", "text": "也许吧，哦等等，我几乎能看到它了"}, {"type": "subtitle", "time": 5807.629, "timestamp": "01:36:47", "text": "我真的能看见"}, {"type": "subtitle", "time": 5810.87, "timestamp": "01:36:50", "text": "哦等等，火焰，好的，等等，帧"}, {"type": "subtitle", "time": 5812.27, "timestamp": "01:36:52", "text": "一帧一帧地画"}, {"type": "subtitle", "time": 5819.669, "timestamp": "01:36:59", "text": "好的，火元素，好的，火元素，我等着"}]
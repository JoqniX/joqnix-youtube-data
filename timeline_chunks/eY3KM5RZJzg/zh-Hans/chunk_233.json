[{"type": "subtitle", "time": 13997.71, "timestamp": "03:53:17", "text": "继续，好的，呃，我忘了问，嗯……"}, {"type": "subtitle", "time": 14001.189, "timestamp": "03:53:21", "text": "我没拿到铁"}, {"type": "subtitle", "time": 14006.55, "timestamp": "03:53:26", "text": "镐子，等等，哦，我把那些都弄丢了"}, {"type": "subtitle", "time": 14006.88, "timestamp": "03:53:26", "text": "正确的"}, {"type": "subtitle", "time": 14008.469, "timestamp": "03:53:28", "text": "[音乐]"}, {"type": "subtitle", "time": 14015.229, "timestamp": "03:53:35", "text": "嗯，好的"}, {"type": "subtitle", "time": 14017.71, "timestamp": "03:53:37", "text": "哦，对了，谢谢你，我是镐子你"}, {"type": "subtitle", "time": 14020.349, "timestamp": "03:53:40", "text": "明白了，谢谢。呃，所以，面纱去哪儿了？"}, {"type": "subtitle", "time": 14023.55, "timestamp": "03:53:43", "text": "头盔滑落到胸前哦"}, {"type": "subtitle", "time": 14026.83, "timestamp": "03:53:46", "text": "是的，你觉得呢？我觉得你明白我的意思，哦，是的。"}, {"type": "subtitle", "time": 14029.229, "timestamp": "03:53:49", "text": "苦力怕死了，现在正在探索它哦"}, {"type": "subtitle", "time": 14031.95, "timestamp": "03:53:51", "text": "天哪，那些东西都没了，所以，呃，黄金。"}, {"type": "subtitle", "time": 14035.67, "timestamp": "03:53:55", "text": "金胸甲、金裤子和金"}, {"type": "subtitle", "time": 14038.91, "timestamp": "03:53:58", "text": "木板，呃，金色的胸甲，对吧，呃，就这些"}]
[{"type": "subtitle", "time": 15240.429, "timestamp": "04:14:00", "text": "发生了什么事？我会过来解释清楚。"}, {"type": "subtitle", "time": 15243.79, "timestamp": "04:14:03", "text": "把东西给你，我去吃饭了，呃，因为"}, {"type": "subtitle", "time": 15247.349, "timestamp": "04:14:07", "text": "我爸爸把东西都放在外面。"}, {"type": "subtitle", "time": 15250.269, "timestamp": "04:14:10", "text": "你知道，得往里面加水。"}, {"type": "subtitle", "time": 15251.389, "timestamp": "04:14:11", "text": "大米和"}, {"type": "subtitle", "time": 15254.79, "timestamp": "04:14:14", "text": "除了明天之外的一切"}, {"type": "subtitle", "time": 15259.71, "timestamp": "04:14:19", "text": "是的，家在哪里？我在哪里？"}, {"type": "subtitle", "time": 15264.59, "timestamp": "04:14:24", "text": "为什么是三？为什么是三？"}, {"type": "subtitle", "time": 15280.349, "timestamp": "04:14:40", "text": "[音乐]"}, {"type": "subtitle", "time": 15288.55, "timestamp": "04:14:48", "text": "H 卡斯潘已结束"}, {"type": "subtitle", "time": 15295.269, "timestamp": "04:14:55", "text": "这里是羊的栖息地"}, {"type": "subtitle", "time": 15297.469, "timestamp": "04:14:57", "text": "谢谢"}]
[{"type": "subtitle", "time": 1386.13, "timestamp": "00:23:06", "text": "为了"}, {"type": "subtitle", "time": 1388.35, "timestamp": "00:23:08", "text": "[音乐]"}, {"type": "subtitle", "time": 1392.59, "timestamp": "00:23:12", "text": "呃，问题是，如果米茨基来了……"}, {"type": "subtitle", "time": 1394.99, "timestamp": "00:23:14", "text": "她会问乔乔"}, {"type": "subtitle", "time": 1399.83, "timestamp": "00:23:19", "text": "你好啊，Jock，你在哪儿？"}, {"type": "subtitle", "time": 1401.19, "timestamp": "00:23:21", "text": "还有那件事"}, {"type": "subtitle", "time": 1404.99, "timestamp": "00:23:24", "text": "在这种情况下我该怎么办？如何制作"}, {"type": "subtitle", "time": 1408.99, "timestamp": "00:23:28", "text": "又是一艘船，等等，怎么造船？"}, {"type": "subtitle", "time": 1416.029, "timestamp": "00:23:36", "text": "好吧，我该怎么办？她正在直播"}, {"type": "subtitle", "time": 1431.63, "timestamp": "00:23:51", "text": "[音乐]"}, {"type": "subtitle", "time": 1434.669, "timestamp": "00:23:54", "text": "明智的是，我说的不是游戏里的事。"}, {"type": "subtitle", "time": 1436.43, "timestamp": "00:23:56", "text": "得想想"}]
[{"type": "subtitle", "time": 11940.269, "timestamp": "03:19:00", "text": "能量哦，我屏蔽了，哦，顺便说一句"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "是的，你知道，阿斯拉给了我这个。"}, {"type": "subtitle", "time": 11948.03, "timestamp": "03:19:08", "text": "呃，看看我的"}, {"type": "subtitle", "time": 11953.189, "timestamp": "03:19:13", "text": "胸口，呃，一块紫水晶"}, {"type": "subtitle", "time": 11956.75, "timestamp": "03:19:16", "text": "哦，紫水晶，H 紫水晶，是的"}, {"type": "subtitle", "time": 11958.91, "timestamp": "03:19:18", "text": "是啊是啊是啊，水晶"}, {"type": "subtitle", "time": 11962.269, "timestamp": "03:19:22", "text": "你知道，就是那个会发出声音的东西"}, {"type": "subtitle", "time": 11964.469, "timestamp": "03:19:24", "text": "是啊，你知道我们做了什么。"}, {"type": "subtitle", "time": 11967.269, "timestamp": "03:19:27", "text": "昨天他上台了。"}, {"type": "subtitle", "time": 11970.349, "timestamp": "03:19:30", "text": "对我来说，这东西就像我表现的那样。"}, {"type": "subtitle", "time": 11979.389, "timestamp": "03:19:39", "text": "好可爱！我好想念它啊！"}, {"type": "chat", "time": 11982.308, "timestamp": "03:19:42", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "\"The way you make a family is not family friendly\""}, {"type": "subtitle", "time": 11982.99, "timestamp": "03:19:42", "text": "好的，没关系，我们等等吧。"}, {"type": "subtitle", "time": 11985.49, "timestamp": "03:19:45", "text": "那样我们就可以再来一次了。"}, {"type": "chat", "time": 11985.637, "timestamp": "03:19:45", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "till we meet again"}, {"type": "subtitle", "time": 11988.309, "timestamp": "03:19:48", "text": "[音乐]"}, {"type": "subtitle", "time": 11990.75, "timestamp": "03:19:50", "text": "好的，稍等，我马上回来，好的，我需要……"}, {"type": "subtitle", "time": 11996.07, "timestamp": "03:19:56", "text": "水，你组建家庭的方式，不是"}, {"type": "subtitle", "time": 11999.63, "timestamp": "03:19:59", "text": "祝大家家庭愉快，下次再见！"}]
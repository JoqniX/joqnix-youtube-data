[{"type": "subtitle", "time": 5462.47, "timestamp": "01:31:02", "text": "你什么时候开始敲击"}, {"type": "subtitle", "time": 5465.83, "timestamp": "01:31:05", "text": "努力啊，下次我必须这么做了，如果我"}, {"type": "subtitle", "time": 5468.07, "timestamp": "01:31:08", "text": "得到任何好东西 L 我要写"}, {"type": "subtitle", "time": 5469.59, "timestamp": "01:31:09", "text": "把它放进一个"}, {"type": "subtitle", "time": 5472.75, "timestamp": "01:31:12", "text": "笔记本或"}, {"type": "subtitle", "time": 5482.07, "timestamp": "01:31:22", "text": "啊"}, {"type": "subtitle", "time": 5484.51, "timestamp": "01:31:24", "text": "呃，我先来"}, {"type": "subtitle", "time": 5486.629, "timestamp": "01:31:26", "text": "哦等等等等等等哦三月"}, {"type": "subtitle", "time": 5488.669, "timestamp": "01:31:28", "text": "有人问我为什么乔，你看起来这么……"}, {"type": "subtitle", "time": 5491.55, "timestamp": "01:31:31", "text": "或许不一样，这或许是个线索，等等，在哪儿？"}, {"type": "subtitle", "time": 5494.629, "timestamp": "01:31:34", "text": "mituki mixi 是不是就在那边看到我了？"}, {"type": "subtitle", "time": 5496.59, "timestamp": "01:31:36", "text": "她问我：“乔，你为什么看起来这么……”"}, {"type": "subtitle", "time": 5500.189, "timestamp": "01:31:40", "text": "不一样，嗯，是的，几乎"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "请将鼠标悬停在那里。"}, {"type": "subtitle", "time": 5506.83, "timestamp": "01:31:46", "text": "是啊，她一边看着我一边问我。"}, {"type": "subtitle", "time": 5512.95, "timestamp": "01:31:52", "text": "然后看着我，哦，离我那么近，你真是太棒了"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "我需要的是舵。"}, {"type": "subtitle", "time": 5517.31, "timestamp": "01:31:57", "text": "它的名字会隐藏我。"}, {"type": "subtitle", "time": 5519.27, "timestamp": "01:31:59", "text": "来自怪物和其他一切以及姓名牌"}]
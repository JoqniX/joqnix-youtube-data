[{"type": "subtitle", "time": 9540.479, "timestamp": "02:39:00", "text": "把它举起来，我会给它，把它放下 她在那里，你"}, {"type": "subtitle", "time": 9542.6, "timestamp": "02:39:02", "text": "她在那里，你 去吧，那是你的了。"}, {"type": "subtitle", "time": 9553.15, "timestamp": "02:39:13", "text": "你也可以在我这边。"}, {"type": "subtitle", "time": 9557.51, "timestamp": "02:39:17", "text": "没错，那不是哦，是的"}, {"type": "subtitle", "time": 9561.55, "timestamp": "02:39:21", "text": "我想那是我的网站，你可以在那里"}, {"type": "subtitle", "time": 9563.87, "timestamp": "02:39:23", "text": "你可以给她看。"}, {"type": "subtitle", "time": 9565.55, "timestamp": "02:39:25", "text": "该网站与"}, {"type": "subtitle", "time": 9568.75, "timestamp": "02:39:28", "text": "她的美月给了那一边"}, {"type": "subtitle", "time": 9573.55, "timestamp": "02:39:33", "text": "把这武器还回来，这血"}, {"type": "subtitle", "time": 9577.63, "timestamp": "02:39:37", "text": "等等，等等，她，她，是的，是的，拿"}, {"type": "subtitle", "time": 9579.71, "timestamp": "02:39:39", "text": "别担心，时间到了，该死的。"}, {"type": "subtitle", "time": 9583.07, "timestamp": "02:39:43", "text": "以为你消失了"}, {"type": "subtitle", "time": 9585.469, "timestamp": "02:39:45", "text": "一些"}, {"type": "subtitle", "time": 9593.63, "timestamp": "02:39:53", "text": "哇，我们俩都有独特的武器，祖基"}, {"type": "subtitle", "time": 9596.349, "timestamp": "02:39:56", "text": "会是这样。"}]
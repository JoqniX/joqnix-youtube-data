[{"type": "subtitle", "time": 13023.09, "timestamp": "03:37:03", "text": "离开巴卡"}, {"type": "subtitle", "time": 13030.309, "timestamp": "03:37:10", "text": "她杀了你，她不仅杀了你"}, {"type": "subtitle", "time": 13033.269, "timestamp": "03:37:13", "text": "甚至连她从击杀中获得的经验值也拿走了"}, {"type": "subtitle", "time": 13043.95, "timestamp": "03:37:23", "text": "我认识你才三年而已"}, {"type": "subtitle", "time": 13046.63, "timestamp": "03:37:26", "text": "减去年数减去四年"}, {"type": "subtitle", "time": 13048.55, "timestamp": "03:37:28", "text": "多年来"}, {"type": "subtitle", "time": 13051.63, "timestamp": "03:37:31", "text": "我不知道为什么，但我感觉我好像……"}, {"type": "subtitle", "time": 13053.83, "timestamp": "03:37:33", "text": "认识你四年了，即使是"}, {"type": "subtitle", "time": 13056.91, "timestamp": "03:37:36", "text": "才过了三天，Zuki，是这样吗？"}, {"type": "subtitle", "time": 13058.309, "timestamp": "03:37:38", "text": "等等，她是什么人？"}, {"type": "subtitle", "time": 13061.75, "timestamp": "03:37:41", "text": "假设我说“是的，已经是这样了”，如果我"}, {"type": "subtitle", "time": 13063.429, "timestamp": "03:37:43", "text": "比如把卡斯叫过来，他想……"}, {"type": "subtitle", "time": 13065.55, "timestamp": "03:37:45", "text": "见到你们啦"}, {"type": "subtitle", "time": 13068.91, "timestamp": "03:37:48", "text": "不，我们不允许陌生人进来。"}, {"type": "subtitle", "time": 13071.63, "timestamp": "03:37:51", "text": "对，我把他带过来，不不"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "那太疯狂了，我们不想这样"}]
[{"type": "subtitle", "time": 12181.229, "timestamp": "03:23:01", "text": "从任务中获得更强大的武器"}, {"type": "subtitle", "time": 12184.55, "timestamp": "03:23:04", "text": "一切都要妥善保管，我们才能……"}, {"type": "subtitle", "time": 12188.87, "timestamp": "03:23:08", "text": "当我们有空闲时间时，重建这个地方。"}, {"type": "subtitle", "time": 12193.15, "timestamp": "03:23:13", "text": "我做这个的时候，我把栅栏做成了……"}, {"type": "subtitle", "time": 12201.95, "timestamp": "03:23:21", "text": "我的天哪，我忘了喝水了！等等"}, {"type": "subtitle", "time": 12238.07, "timestamp": "03:23:58", "text": "你好哦"}]
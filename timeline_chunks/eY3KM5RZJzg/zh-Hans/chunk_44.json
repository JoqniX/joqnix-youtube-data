[{"type": "subtitle", "time": 2641.87, "timestamp": "00:44:01", "text": "H 祭祀应该是"}, {"type": "subtitle", "time": 2646.589, "timestamp": "00:44:06", "text": "所以我决定杀了他们所有人，为了我的我"}, {"type": "chat", "time": 2648.719, "timestamp": "00:44:08", "author": "@オニオン田中", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mfuIF27RMwX6DcAuf18U_0UBTsU2g7DgpNKYestnxkWZ4=s64-c-k-c0x00ffffff-no-rj", "message": "Hi.Thank you for today."}, {"type": "subtitle", "time": 2648.75, "timestamp": "00:44:08", "text": "不会因为你拥有"}, {"type": "subtitle", "time": 2652.349, "timestamp": "00:44:12", "text": "家人，我并不残忍，我是个……我……"}, {"type": "subtitle", "time": 2654.79, "timestamp": "00:44:14", "text": "我是一个安慰者，后来变成了"}, {"type": "subtitle", "time": 2661.71, "timestamp": "00:44:21", "text": "进入我是一个安慰谁"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "转而投向了血腥的一面，而非黑暗面。"}, {"type": "subtitle", "time": 2668.069, "timestamp": "00:44:28", "text": "虽然我们是保护者"}, {"type": "subtitle", "time": 2669.75, "timestamp": "00:44:29", "text": "现在我们应该报复……"}, {"type": "subtitle", "time": 2672.99, "timestamp": "00:44:32", "text": "背叛我们的假神"}, {"type": "subtitle", "time": 2674.47, "timestamp": "00:44:34", "text": "这就是我们，这就是我们拥有它的原因"}, {"type": "subtitle", "time": 2677.75, "timestamp": "00:44:37", "text": "小丑网站终极版"}, {"type": "subtitle", "time": 2680.47, "timestamp": "00:44:40", "text": "向神复仇的武器"}, {"type": "subtitle", "time": 2683.03, "timestamp": "00:44:43", "text": "这个世界"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "嗨，但是，是的，我们不能让其他人进来。"}, {"type": "subtitle", "time": 2689.75, "timestamp": "00:44:49", "text": "你看，不过，因为这是我们的秘密。"}]
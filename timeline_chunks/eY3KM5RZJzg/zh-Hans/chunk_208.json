[{"type": "subtitle", "time": 12483.07, "timestamp": "03:28:03", "text": "不，让我解释一下任务一。"}, {"type": "subtitle", "time": 12487.15, "timestamp": "03:28:07", "text": "他最初同意用16颗钻石购买吗？"}, {"type": "subtitle", "time": 12489.59, "timestamp": "03:28:09", "text": "如果我没记错的话，是的，我只有两个。"}, {"type": "subtitle", "time": 12492.429, "timestamp": "03:28:12", "text": "他想付首付，他就像"}, {"type": "subtitle", "time": 12494.71, "timestamp": "03:28:14", "text": "嗯，让我想想吧。"}, {"type": "subtitle", "time": 12497.71, "timestamp": "03:28:17", "text": "他建议我们可以炸毁……"}, {"type": "subtitle", "time": 12500.429, "timestamp": "03:28:20", "text": "洞穴或者其他类似的地方，这就是我们的"}, {"type": "subtitle", "time": 12503.11, "timestamp": "03:28:23", "text": "临时住所，所以所有部分"}, {"type": "subtitle", "time": 12507.63, "timestamp": "03:28:27", "text": "把洞穴当作家，对吧？所以我喜欢"}, {"type": "subtitle", "time": 12511.229, "timestamp": "03:28:31", "text": "呃，有点像SM那样，而我想要"}, {"type": "subtitle", "time": 12514.67, "timestamp": "03:28:34", "text": "用TNT炸药炸死VCH，而不是"}, {"type": "subtitle", "time": 12518.269, "timestamp": "03:28:38", "text": "呃，把它放在我们基地附近，所以他"}, {"type": "subtitle", "time": 12522.03, "timestamp": "03:28:42", "text": "他明白了，然后说不。"}, {"type": "subtitle", "time": 12524.269, "timestamp": "03:28:44", "text": "幸好他只是把它放在那里而已"}, {"type": "subtitle", "time": 12526.83, "timestamp": "03:28:46", "text": "再走一点，我们就……"}, {"type": "subtitle", "time": 12530.51, "timestamp": "03:28:50", "text": "你知道，乔，如果你是，这一点很明显。"}, {"type": "subtitle", "time": 12534.07, "timestamp": "03:28:54", "text": "顺便一提，他试图扮演邪恶的角色，因为"}, {"type": "subtitle", "time": 12534.99, "timestamp": "03:28:54", "text": "你"}, {"type": "subtitle", "time": 12539.07, "timestamp": "03:28:59", "text": "嗯，你很容易读懂，我是"}]
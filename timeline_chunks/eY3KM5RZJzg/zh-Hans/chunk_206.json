[{"type": "subtitle", "time": 12362.95, "timestamp": "03:26:02", "text": "意思是今天要杀掉怪物，所以"}, {"type": "subtitle", "time": 12375.55, "timestamp": "03:26:15", "text": "狩猎资源，嗨嗨，你们好吗？"}, {"type": "subtitle", "time": 12378.79, "timestamp": "03:26:18", "text": "带上你需要帮忙的东西"}, {"type": "subtitle", "time": 12384.11, "timestamp": "03:26:24", "text": "我嗨 Zuki 我想知道你好你好"}, {"type": "subtitle", "time": 12387.429, "timestamp": "03:26:27", "text": "你是不是暗地里是个坏人？所以才这样。"}, {"type": "subtitle", "time": 12389.15, "timestamp": "03:26:29", "text": "你什么都没告诉我"}, {"type": "subtitle", "time": 12391.309, "timestamp": "03:26:31", "text": "直接说不，我应该……"}, {"type": "subtitle", "time": 12394.429, "timestamp": "03:26:34", "text": "保护你们，因为我爱你们。"}, {"type": "subtitle", "time": 12397.59, "timestamp": "03:26:37", "text": "你是我的，你没有帮到我，你是"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "我很可疑，我像蜘蛛侠一样，我有一个"}, {"type": "subtitle", "time": 12403.15, "timestamp": "03:26:43", "text": "秘密任务哦哇等等，我刚才为什么会这样"}, {"type": "subtitle", "time": 12407.309, "timestamp": "03:26:47", "text": "他说，请你再给我发一下什么？"}, {"type": "subtitle", "time": 12410.389, "timestamp": "03:26:50", "text": "他说了什么？他说了什么？蜘蛛侠"}, {"type": "subtitle", "time": 12412.83, "timestamp": "03:26:52", "text": "蜘蛛侠，蜘蛛侠，他就是蜘蛛侠。"}, {"type": "subtitle", "time": 12414.75, "timestamp": "03:26:54", "text": "你说你曾经是"}, {"type": "subtitle", "time": 12419.91, "timestamp": "03:26:59", "text": "SPID 不是间谍，我就像我就像那个"}]
[{"type": "subtitle", "time": 10517.15, "timestamp": "02:55:17", "text": "你好，那个爬行者爆炸了"}, {"type": "subtitle", "time": 10523.349, "timestamp": "02:55:23", "text": "不，我的天哪，我和我在一起，我想"}, {"type": "subtitle", "time": 10526.75, "timestamp": "02:55:26", "text": "它在这里，跟我来，不，我们要走了。"}, {"type": "subtitle", "time": 10530.03, "timestamp": "02:55:30", "text": "宝贝，以前是这样的"}, {"type": "subtitle", "time": 10534.269, "timestamp": "02:55:34", "text": "我看到你身后有火炬"}, {"type": "subtitle", "time": 10535.91, "timestamp": "02:55:35", "text": "光"}, {"type": "subtitle", "time": 10540.469, "timestamp": "02:55:40", "text": "来来来，哦，快来"}]
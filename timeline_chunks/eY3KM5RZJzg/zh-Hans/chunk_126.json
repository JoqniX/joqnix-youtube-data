[{"type": "subtitle", "time": 7560.79, "timestamp": "02:06:00", "text": "乔，告诉我到底是怎么回事，到底是怎么回事？"}, {"type": "subtitle", "time": 7563.709, "timestamp": "02:06:03", "text": "我失去了我辛辛苦苦挣来的一切。"}, {"type": "subtitle", "time": 7566.87, "timestamp": "02:06:06", "text": "昨天所有的旅程"}, {"type": "subtitle", "time": 7568.709, "timestamp": "02:06:08", "text": "每个赛季以及我失去的一切"}, {"type": "subtitle", "time": 7571.35, "timestamp": "02:06:11", "text": "我今天死去的一切都是因为"}, {"type": "subtitle", "time": 7575.35, "timestamp": "02:06:15", "text": "服务器故障，服务器把我杀死了（现实中）。"}, {"type": "subtitle", "time": 7578.229, "timestamp": "02:06:18", "text": "是啊，实际上我当时非常沮丧"}, {"type": "subtitle", "time": 7579.03, "timestamp": "02:06:19", "text": "和"}, {"type": "subtitle", "time": 7582.149, "timestamp": "02:06:22", "text": "很难过，因为我失去了任务，而且我当时的想法是……"}, {"type": "subtitle", "time": 7583.35, "timestamp": "02:06:23", "text": "鉴于我的"}, {"type": "subtitle", "time": 7586.47, "timestamp": "02:06:26", "text": "目的是为了保护你和扎基。"}, {"type": "subtitle", "time": 7589.39, "timestamp": "02:06:29", "text": "一切都让我感到孤独，我感到……"}, {"type": "subtitle", "time": 7591.109, "timestamp": "02:06:31", "text": "四处闲逛"}, {"type": "subtitle", "time": 7593.79, "timestamp": "02:06:33", "text": "到处都在哭，因为我输了"}, {"type": "subtitle", "time": 7596.549, "timestamp": "02:06:36", "text": "一切都来了，这个人是来做交易的。"}, {"type": "subtitle", "time": 7600.27, "timestamp": "02:06:40", "text": "他说我可以回去，我可以得到"}, {"type": "subtitle", "time": 7604.35, "timestamp": "02:06:44", "text": "就像一把非常好的剑，一把超强的剑"}, {"type": "subtitle", "time": 7607.87, "timestamp": "02:06:47", "text": "你知道，这很好，而且它的方式"}, {"type": "subtitle", "time": 7609.75, "timestamp": "02:06:49", "text": "比我丢失的剑更好的东西给我"}, {"type": "subtitle", "time": 7610.91, "timestamp": "02:06:50", "text": "你收取了部分款项"}, {"type": "subtitle", "time": 7612.31, "timestamp": "02:06:52", "text": "祖母绿"}, {"type": "subtitle", "time": 7614.75, "timestamp": "02:06:54", "text": "我不会还你任何东西，除了你"}, {"type": "subtitle", "time": 7616.79, "timestamp": "02:06:56", "text": "拿走了那些祖母绿"}]
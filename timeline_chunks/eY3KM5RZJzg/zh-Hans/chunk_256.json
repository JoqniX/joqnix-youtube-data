[{"type": "subtitle", "time": 15360.87, "timestamp": "04:16:00", "text": "我的天啊，我找到那个家伙了！不不不，是谁干的！"}, {"type": "subtitle", "time": 15363.63, "timestamp": "04:16:03", "text": "谁干的？为什么？"}, {"type": "subtitle", "time": 15369.469, "timestamp": "04:16:09", "text": "兄弟，为什么，为什么我会掉进宝藏里？"}, {"type": "subtitle", "time": 15375.109, "timestamp": "04:16:15", "text": "把我放"}, {"type": "subtitle", "time": 15386.99, "timestamp": "04:16:26", "text": "等等，我想起来你在哪儿了，我这就去拿卫生纸。"}, {"type": "subtitle", "time": 15389.229, "timestamp": "04:16:29", "text": "我记得你，谢谢你。"}, {"type": "subtitle", "time": 15390.309, "timestamp": "04:16:30", "text": "一个"}, {"type": "subtitle", "time": 15397.71, "timestamp": "04:16:37", "text": "宝藏啊，三月在哪里？"}, {"type": "subtitle", "time": 15406.87, "timestamp": "04:16:46", "text": "你好你好卡斯潘，你没跟我打招呼吗？"}, {"type": "subtitle", "time": 15419.71, "timestamp": "04:16:59", "text": "B 哦，你得到了"}]
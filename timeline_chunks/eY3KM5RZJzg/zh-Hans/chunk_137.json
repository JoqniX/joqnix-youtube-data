[{"type": "subtitle", "time": 8220.509, "timestamp": "02:17:00", "text": "好吧，但我没事，废话，我没有。"}, {"type": "subtitle", "time": 8222.83, "timestamp": "02:17:02", "text": "连红外线都没有，我的天哪，没关系"}, {"type": "subtitle", "time": 8226.87, "timestamp": "02:17:06", "text": "没关系，没关系，我们在一起，我们需要"}, {"type": "subtitle", "time": 8231.03, "timestamp": "02:17:11", "text": "为了获救，不要走到前面。"}, {"type": "subtitle", "time": 8234.15, "timestamp": "02:17:14", "text": "那个洞，好的"}, {"type": "subtitle", "time": 8239.509, "timestamp": "02:17:19", "text": "天哪，我们该怎么办？哦，我的天哪，我想我们"}, {"type": "subtitle", "time": 8242.629, "timestamp": "02:17:22", "text": "可以尝试"}, {"type": "subtitle", "time": 8245.589, "timestamp": "02:17:25", "text": "用你的镐子过来，我"}, {"type": "subtitle", "time": 8253.19, "timestamp": "02:17:33", "text": "你能看到这个吗？等等，呃，让我先挖一下。"}, {"type": "subtitle", "time": 8253.95, "timestamp": "02:17:33", "text": "这"}, {"type": "subtitle", "time": 8258.03, "timestamp": "02:17:38", "text": "阻止此块，这样我就可以"}, {"type": "subtitle", "time": 8260.629, "timestamp": "02:17:40", "text": "看"}, {"type": "subtitle", "time": 8264.429, "timestamp": "02:17:44", "text": "好的，你在做什么？嗯……我来自"}, {"type": "subtitle", "time": 8266.27, "timestamp": "02:17:46", "text": "这里"}, {"type": "subtitle", "time": 8269.83, "timestamp": "02:17:49", "text": "对，别去那里，别跳，你会……"}, {"type": "subtitle", "time": 8273.429, "timestamp": "02:17:53", "text": "我觉得我可以做到，让你死吧"}, {"type": "subtitle", "time": 8276.429, "timestamp": "02:17:56", "text": "你会"}]
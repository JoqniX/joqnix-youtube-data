[{"type": "subtitle", "time": 14461.63, "timestamp": "04:01:01", "text": "不知道我是什么，我的真实身份是什么"}, {"type": "subtitle", "time": 14464.99, "timestamp": "04:01:04", "text": "YouTuber名字哦我的天"}, {"type": "subtitle", "time": 14469.99, "timestamp": "04:01:09", "text": "真的吗？那她是怎么认识我的？"}, {"type": "subtitle", "time": 14474.63, "timestamp": "04:01:14", "text": "我不知道她是不是喜欢广告之类的。"}, {"type": "subtitle", "time": 14483.429, "timestamp": "04:01:23", "text": "好的，嗯，我为你感到骄傲，小可爱。"}, {"type": "subtitle", "time": 14485.309, "timestamp": "04:01:25", "text": "馅饼谢谢"}, {"type": "subtitle", "time": 14487.83, "timestamp": "04:01:27", "text": "我为你感到骄傲"}, {"type": "subtitle", "time": 14489.95, "timestamp": "04:01:29", "text": "太感谢了"}, {"type": "subtitle", "time": 14493.91, "timestamp": "04:01:33", "text": "J，你做得很好，你非常努力。"}, {"type": "subtitle", "time": 14497.269, "timestamp": "04:01:37", "text": "对不起，对不起，在角色扮演中我不得不……"}, {"type": "subtitle", "time": 14499.95, "timestamp": "04:01:39", "text": "稍微刻薄一点，哦等等，那是角色扮演"}, {"type": "subtitle", "time": 14504.229, "timestamp": "04:01:44", "text": "我的天哪，我真是太蠢了，竟然还会道歉。"}, {"type": "subtitle", "time": 14505.51, "timestamp": "04:01:45", "text": "认识我"}, {"type": "subtitle", "time": 14509.83, "timestamp": "04:01:49", "text": "我希望西南地区的鱼不要产卵。"}, {"type": "subtitle", "time": 14513.67, "timestamp": "04:01:53", "text": "我没在正确扮演角色"}]
[{"type": "subtitle", "time": 6181.35, "timestamp": "01:43:01", "text": "金色滑梯"}, {"type": "subtitle", "time": 6183.83, "timestamp": "01:43:03", "text": "绑腿"}, {"type": "subtitle", "time": 6187.47, "timestamp": "01:43:07", "text": "滑行成功了，你是怎么做到的？"}, {"type": "subtitle", "time": 6192.07, "timestamp": "01:43:12", "text": "死，说来话长。"}, {"type": "subtitle", "time": 6195.39, "timestamp": "01:43:15", "text": "迪奥，所以我没有靴子，对吧？"}, {"type": "subtitle", "time": 6196.87, "timestamp": "01:43:16", "text": "没有"}, {"type": "subtitle", "time": 6199.47, "timestamp": "01:43:19", "text": "靴子好了，就这些了，对吧？"}, {"type": "subtitle", "time": 6201.27, "timestamp": "01:43:21", "text": "我们曾经拥有的"}, {"type": "chat", "time": 6204.222, "timestamp": "01:43:24", "author": "@ronovashusband", "avatar": "https://yt4.ggpht.com/uK8lB4A6_f133TZS17Hpa6To2730bM8Ma6DhNXNdLRfP23sONHIQYBzDxv-OH9IpNlt_wxSlv8k=s64-c-k-c0x00ffffff-no-rj", "message": "FRAME BY FRAMEEEE"}, {"type": "subtitle", "time": 6204.589, "timestamp": "01:43:24", "text": "今天我收到了一些重要的东西。"}, {"type": "subtitle", "time": 6206.87, "timestamp": "01:43:26", "text": "它 SEL"}, {"type": "subtitle", "time": 6210.31, "timestamp": "01:43:30", "text": "触摸，嗯，是的，然后是两个"}, {"type": "subtitle", "time": 6213.669, "timestamp": "01:43:33", "text": "指南针没问题，所以我觉得我们可以"}, {"type": "subtitle", "time": 6215.669, "timestamp": "01:43:35", "text": "回到我们当前的直播流。"}, {"type": "subtitle", "time": 6219.189, "timestamp": "01:43:39", "text": "嗨，我是Jock，正在回顾旧内容"}, {"type": "subtitle", "time": 6222.79, "timestamp": "01:43:42", "text": "我记得我是个运动员"}, {"type": "subtitle", "time": 6224.43, "timestamp": "01:43:44", "text": "显示"}, {"type": "subtitle", "time": 6227.75, "timestamp": "01:43:47", "text": "呃，我死的地方，对，就是这里。"}, {"type": "subtitle", "time": 6229.99, "timestamp": "01:43:49", "text": "我当时在哪里"}, {"type": "subtitle", "time": 6234.589, "timestamp": "01:43:54", "text": "旅行途中我查了一下这个之类的东西"}, {"type": "subtitle", "time": 6236.39, "timestamp": "01:43:56", "text": "请检查您的库存。"}]
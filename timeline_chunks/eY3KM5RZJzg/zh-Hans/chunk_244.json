[{"type": "subtitle", "time": 14642.389, "timestamp": "04:04:02", "text": "生成啊，好的好的，你们有护甲吗？"}, {"type": "subtitle", "time": 14643.83, "timestamp": "04:04:03", "text": "我不"}, {"type": "subtitle", "time": 14647.59, "timestamp": "04:04:07", "text": "好吧，你的武器确实不错哦。"}, {"type": "subtitle", "time": 14650.03, "timestamp": "04:04:10", "text": "武士刀可以做到任何事"}, {"type": "subtitle", "time": 14654.229, "timestamp": "04:04:14", "text": "盔甲，我是说，我当时有合适的……哦，等等"}, {"type": "subtitle", "time": 14657.51, "timestamp": "04:04:17", "text": "让我，让我做，让我做，等等"}, {"type": "subtitle", "time": 14660.03, "timestamp": "04:04:20", "text": "大家好，你们好，不好意思，不好意思"}, {"type": "subtitle", "time": 14662.83, "timestamp": "04:04:22", "text": "抱歉，你们现在能听到我说话吗？是的，我们"}, {"type": "subtitle", "time": 14664.03, "timestamp": "04:04:24", "text": "能听到"}, {"type": "subtitle", "time": 14668.79, "timestamp": "04:04:28", "text": "是的，我在跟我说话。"}, {"type": "subtitle", "time": 14671.51, "timestamp": "04:04:31", "text": "人们似乎听不见"}, {"type": "subtitle", "time": 14673.51, "timestamp": "04:04:33", "text": "我"}, {"type": "subtitle", "time": 14677.189, "timestamp": "04:04:37", "text": "呃，好的好的，对不起对不起，我们走吧。"}, {"type": "subtitle", "time": 14678.71, "timestamp": "04:04:38", "text": "走吧"}, {"type": "subtitle", "time": 14681.309, "timestamp": "04:04:41", "text": "你在谈论那些声音吗？"}, {"type": "subtitle", "time": 14682.11, "timestamp": "04:04:42", "text": "你的"}, {"type": "subtitle", "time": 14686.03, "timestamp": "04:04:46", "text": "我脑海中的声音"}, {"type": "subtitle", "time": 14688.95, "timestamp": "04:04:48", "text": "[音乐]"}, {"type": "subtitle", "time": 14693.309, "timestamp": "04:04:53", "text": "真正的C，你现在需要睡觉了"}, {"type": "subtitle", "time": 14695.79, "timestamp": "04:04:55", "text": "你是做什么的"}, {"type": "subtitle", "time": 14699.75, "timestamp": "04:04:59", "text": "如果看到任何动物，就去做。"}]
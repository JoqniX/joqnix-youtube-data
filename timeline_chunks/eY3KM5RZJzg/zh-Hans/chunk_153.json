[{"type": "subtitle", "time": 9181.67, "timestamp": "02:33:01", "text": "谢谢你们的收藏"}, {"type": "subtitle", "time": 9185.19, "timestamp": "02:33:05", "text": "我的东西，我哭是因为我丢了。"}, {"type": "subtitle", "time": 9188.07, "timestamp": "02:33:08", "text": "所有东西都是下界合金靴子"}, {"type": "subtitle", "time": 9191.79, "timestamp": "02:33:11", "text": "你的，是的，一切都是我的，好吗？"}, {"type": "subtitle", "time": 9195.83, "timestamp": "02:33:15", "text": "听着，乔乔，是的，如果你能杀人"}, {"type": "subtitle", "time": 9198.75, "timestamp": "02:33:18", "text": "dragn，别听他的，他在骗人。"}, {"type": "subtitle", "time": 9207.95, "timestamp": "02:33:27", "text": "谁必须摧毁世界"}, {"type": "subtitle", "time": 9215.19, "timestamp": "02:33:35", "text": "是啊，不知道你能不能做到。"}, {"type": "subtitle", "time": 9218.87, "timestamp": "02:33:38", "text": "杀了德雷格，我会给你，我会"}, {"type": "subtitle", "time": 9220.309, "timestamp": "02:33:40", "text": "亲自给你奖励"}, {"type": "subtitle", "time": 9222.03, "timestamp": "02:33:42", "text": "给你一个奖励，告诉我。"}, {"type": "subtitle", "time": 9224.19, "timestamp": "02:33:44", "text": "你知道如果你杀了人，奖励是什么吗？"}, {"type": "subtitle", "time": 9226.51, "timestamp": "02:33:46", "text": "拖拽后你可以保留他的胸甲"}, {"type": "subtitle", "time": 9229.19, "timestamp": "02:33:49", "text": "你可以看到他的胸甲很漂亮，它是一件"}, {"type": "subtitle", "time": 9230.83, "timestamp": "02:33:50", "text": "钻石游戏"}, {"type": "subtitle", "time": 9234.349, "timestamp": "02:33:54", "text": "其中一位诊断者正在佩戴"}, {"type": "subtitle", "time": 9238.23, "timestamp": "02:33:58", "text": "对，那是什么？它在说什么？"}]
[{"type": "subtitle", "time": 4987.11, "timestamp": "01:23:07", "text": "就像想象一下我们曾有过一场轰动一时的悲剧"}, {"type": "subtitle", "time": 4990.47, "timestamp": "01:23:10", "text": "我本来可以找到它，我会去的。"}, {"type": "subtitle", "time": 4993.229, "timestamp": "01:23:13", "text": "所以，我本来可以做很多事……"}, {"type": "subtitle", "time": 4994.27, "timestamp": "01:23:14", "text": "得到"}, {"type": "subtitle", "time": 5001.189, "timestamp": "01:23:21", "text": "格雷夫斯发生了一些意想不到的事情"}, {"type": "subtitle", "time": 5003.43, "timestamp": "01:23:23", "text": "意想不到的时刻到了"}, {"type": "subtitle", "time": 5007.149, "timestamp": "01:23:27", "text": "就像上帝知道他是什么时间一样"}, {"type": "subtitle", "time": 5011.55, "timestamp": "01:23:31", "text": "这样做就像是静观其变，等等看。"}, {"type": "subtitle", "time": 5013.229, "timestamp": "01:23:33", "text": "看"}, {"type": "subtitle", "time": 5016.51, "timestamp": "01:23:36", "text": "CH事情发生"}, {"type": "subtitle", "time": 5019.149, "timestamp": "01:23:39", "text": "原因或许是为了……"}, {"type": "subtitle", "time": 5024.79, "timestamp": "01:23:44", "text": "我的天哪"}, {"type": "subtitle", "time": 5035.11, "timestamp": "01:23:55", "text": "SC 把它藏起来，不让公众知道。"}, {"type": "subtitle", "time": 5036.07, "timestamp": "01:23:56", "text": "锯"}]
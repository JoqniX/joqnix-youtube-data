[{"type": "subtitle", "time": 2520.51, "timestamp": "00:42:00", "text": "我们看到的事物越多，就越有……"}, {"type": "subtitle", "time": 2523.15, "timestamp": "00:42:03", "text": "我看到的一栋房子"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "在此，我希望"}, {"type": "subtitle", "time": 2548.589, "timestamp": "00:42:28", "text": "除此之外，我别无他求，但我有一个光荣的使命。"}, {"type": "subtitle", "time": 2550.99, "timestamp": "00:42:30", "text": "我有一个目的威胁"}, {"type": "subtitle", "time": 2559.069, "timestamp": "00:42:39", "text": "是的，我们有尝试的目的。"}, {"type": "subtitle", "time": 2562.79, "timestamp": "00:42:42", "text": "所以我们会这样做"}, {"type": "subtitle", "time": 2566.589, "timestamp": "00:42:46", "text": "我希望能够完成"}, {"type": "subtitle", "time": 2569.069, "timestamp": "00:42:49", "text": "探索"}, {"type": "subtitle", "time": 2572.39, "timestamp": "00:42:52", "text": "一小时后，我可以和……见面"}, {"type": "subtitle", "time": 2575.79, "timestamp": "00:42:55", "text": "三井三井不是三井"}, {"type": "subtitle", "time": 2578.829, "timestamp": "00:42:58", "text": "抱歉抱歉，那不是我的名字。"}]
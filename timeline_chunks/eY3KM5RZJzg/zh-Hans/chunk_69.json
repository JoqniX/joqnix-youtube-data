[{"type": "subtitle", "time": 4141.51, "timestamp": "01:09:01", "text": "失败了，到底是怎么回事？我为什么要去？"}, {"type": "subtitle", "time": 4145.349, "timestamp": "01:09:05", "text": "需要我"}, {"type": "subtitle", "time": 4148.99, "timestamp": "01:09:08", "text": "兄弟，你太厉害了，不，我没那么厉害。"}, {"type": "subtitle", "time": 4156.349, "timestamp": "01:09:16", "text": "[音乐]"}, {"type": "subtitle", "time": 4160.63, "timestamp": "01:09:20", "text": "我的守护天使在哪里？"}, {"type": "subtitle", "time": 4162.519, "timestamp": "01:09:22", "text": "不是那样的"}, {"type": "subtitle", "time": 4164.349, "timestamp": "01:09:24", "text": "[音乐]"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "我的天哪，我的花"}, {"type": "subtitle", "time": 4181.149, "timestamp": "01:09:41", "text": "物品等待呃卡片天使隐形"}, {"type": "subtitle", "time": 4183.63, "timestamp": "01:09:43", "text": "卡片知道你知道我死在哪里吗？"}, {"type": "subtitle", "time": 4188.03, "timestamp": "01:09:48", "text": "你检查一下S日志之类的。"}]
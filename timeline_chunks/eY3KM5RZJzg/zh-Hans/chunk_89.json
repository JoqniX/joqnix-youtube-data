[{"type": "subtitle", "time": 5342.79, "timestamp": "01:29:02", "text": "想要哦我的"}, {"type": "subtitle", "time": 5349.669, "timestamp": "01:29:09", "text": "[音乐]"}, {"type": "subtitle", "time": 5359.83, "timestamp": "01:29:19", "text": "继续，我只是……嗯，是的，乔尔，记得，是的"}, {"type": "subtitle", "time": 5366.95, "timestamp": "01:29:26", "text": "请，请"}, {"type": "subtitle", "time": 5370.189, "timestamp": "01:29:30", "text": "那个剑士，那个剑，我只是"}, {"type": "subtitle", "time": 5372.35, "timestamp": "01:29:32", "text": "请你看看《剑与》"}, {"type": "subtitle", "time": 5376.91, "timestamp": "01:29:36", "text": "头盔，仅此而已，仅此而已。"}, {"type": "subtitle", "time": 5381.149, "timestamp": "01:29:41", "text": "头盔，你为什么这样？"}, {"type": "subtitle", "time": 5385.149, "timestamp": "01:29:45", "text": "下一个黑暗的下一个来自"}, {"type": "subtitle", "time": 5387.709, "timestamp": "01:29:47", "text": "昨天你为什么会想到这一点？"}, {"type": "subtitle", "time": 5391.79, "timestamp": "01:29:51", "text": "你今天可能就会死在这里。"}, {"type": "subtitle", "time": 5395.59, "timestamp": "01:29:55", "text": "未来为何"}, {"type": "subtitle", "time": 5398.39, "timestamp": "01:29:58", "text": "我的天啊，我为什么这么笨？"}]
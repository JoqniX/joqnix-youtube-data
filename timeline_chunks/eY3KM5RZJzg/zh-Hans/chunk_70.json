[{"type": "subtitle", "time": 4202.35, "timestamp": "01:10:02", "text": "演示嗯，还有，呃，恩典已逝。"}, {"type": "subtitle", "time": 4211.39, "timestamp": "01:10:11", "text": "所以，但是服务器正在运行，我们只有"}, {"type": "subtitle", "time": 4214.31, "timestamp": "01:10:14", "text": "还剩15分钟，不少于15分钟"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "大概十分钟吧，我不知道"}, {"type": "subtitle", "time": 4216.49, "timestamp": "01:10:16", "text": "如何"}, {"type": "subtitle", "time": 4221.189, "timestamp": "01:10:21", "text": "[笑声]"}, {"type": "subtitle", "time": 4224.229, "timestamp": "01:10:24", "text": "我当时想，哦耶，哦，那是你。"}, {"type": "subtitle", "time": 4234.59, "timestamp": "01:10:34", "text": "上帝创造了你的pH值"}, {"type": "subtitle", "time": 4236.35, "timestamp": "01:10:36", "text": "东西"}, {"type": "subtitle", "time": 4239.189, "timestamp": "01:10:39", "text": "他怎么可能"}, {"type": "subtitle", "time": 4242.55, "timestamp": "01:10:42", "text": "想知道他怎么才能找到我的东西，我当时在"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "中间"}, {"type": "subtitle", "time": 4246.229, "timestamp": "01:10:46", "text": "我当时身处荒郊野外。"}, {"type": "subtitle", "time": 4249.189, "timestamp": "01:10:49", "text": "就像冰河时代的誓言一样，或者"}, {"type": "subtitle", "time": 4257.99, "timestamp": "01:10:57", "text": "为什么我如此……"}]
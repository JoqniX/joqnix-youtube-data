[{"type": "subtitle", "time": 13500.75, "timestamp": "03:45:00", "text": "需要是哦等等等等，拿到你的"}, {"type": "subtitle", "time": 13502.91, "timestamp": "03:45:02", "text": "顺便说一下，你需要用镐子杀死"}, {"type": "subtitle", "time": 13505.59, "timestamp": "03:45:05", "text": "你的僵尸"}, {"type": "subtitle", "time": 13510.469, "timestamp": "03:45:10", "text": "剑你好，是的，是的，我在这儿，所以是的"}, {"type": "subtitle", "time": 13513.79, "timestamp": "03:45:13", "text": "你们需要你们，你们需要杀戮"}, {"type": "subtitle", "time": 13515.83, "timestamp": "03:45:15", "text": "僵尸，还有它，以及所有的一切，所以你"}, {"type": "subtitle", "time": 13518.87, "timestamp": "03:45:18", "text": "伙计们需要剑和"}, {"type": "subtitle", "time": 13521.83, "timestamp": "03:45:21", "text": "有人拿走了我的铁镐吗？"}, {"type": "subtitle", "time": 13534.99, "timestamp": "03:45:34", "text": "熨斗为什么你的裤子冷"}, {"type": "subtitle", "time": 13538.07, "timestamp": "03:45:38", "text": "你看起来像"}, {"type": "subtitle", "time": 13541.75, "timestamp": "03:45:41", "text": "我找到的小丑"}, {"type": "subtitle", "time": 13544.229, "timestamp": "03:45:44", "text": "真的没事，等等，呃，什么？你……"}, {"type": "subtitle", "time": 13546.429, "timestamp": "03:45:46", "text": "需要铁吗？我可以给你铁，我有。"}, {"type": "subtitle", "time": 13549.75, "timestamp": "03:45:49", "text": "我有24个铁，等等，让我给你"}, {"type": "subtitle", "time": 13552.469, "timestamp": "03:45:52", "text": "把它拿走，你知道会怎么样"}, {"type": "subtitle", "time": 13554.229, "timestamp": "03:45:54", "text": "看起来不错"}, {"type": "subtitle", "time": 13557.87, "timestamp": "03:45:57", "text": "Zuki金胸甲和钻石裤"}]
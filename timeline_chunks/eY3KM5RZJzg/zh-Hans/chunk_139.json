[{"type": "subtitle", "time": 8341.79, "timestamp": "02:19:01", "text": "我不能下去，哦，天哪，我死了，我死了"}, {"type": "subtitle", "time": 8344.669, "timestamp": "02:19:04", "text": "我在这里，别死，我倒下了，求你了"}, {"type": "subtitle", "time": 8348.509, "timestamp": "02:19:08", "text": "好的，我在这里，我在这里，等等，让我"}, {"type": "subtitle", "time": 8351.429, "timestamp": "02:19:11", "text": "那肯定是一段很长的坠落，好吧。"}, {"type": "subtitle", "time": 8354.469, "timestamp": "02:19:14", "text": "我会慢慢来，因为我没有"}, {"type": "subtitle", "time": 8355.87, "timestamp": "02:19:15", "text": "一个"}, {"type": "subtitle", "time": 8359.469, "timestamp": "02:19:19", "text": "挡住，是的。"}, {"type": "subtitle", "time": 8364.19, "timestamp": "02:19:24", "text": "太好了，哦，我的天哪，这真不错"}, {"type": "subtitle", "time": 8381.19, "timestamp": "02:19:41", "text": "哦，我好害怕，我希望我不会发现"}, {"type": "subtitle", "time": 8384.669, "timestamp": "02:19:44", "text": "僵尸们，请不要来找我"}, {"type": "subtitle", "time": 8387.15, "timestamp": "02:19:47", "text": "僵尸，哦，就把这里点亮吧，这样你"}]
[{"type": "subtitle", "time": 11220.269, "timestamp": "03:07:00", "text": "它就像一艘可以航行的船。"}, {"type": "subtitle", "time": 11223.55, "timestamp": "03:07:03", "text": "穿过星海或"}, {"type": "subtitle", "time": 11226.63, "timestamp": "03:07:06", "text": "想象一下我们身处太空"}, {"type": "subtitle", "time": 11229.15, "timestamp": "03:07:09", "text": "手电筒？我身上没有手电筒，什么？"}, {"type": "subtitle", "time": 11231.19, "timestamp": "03:07:11", "text": "哦，我的天哪"}, {"type": "subtitle", "time": 11234.389, "timestamp": "03:07:14", "text": "不，我的天哪，我们得把这个地方记下来。"}, {"type": "subtitle", "time": 11245.87, "timestamp": "03:07:25", "text": "是啊，等等，你知道吗，我会把东西留着。"}, {"type": "subtitle", "time": 11249.95, "timestamp": "03:07:29", "text": "我之所以在这里寻求答案，是因为我害怕……"}, {"type": "subtitle", "time": 11250.53, "timestamp": "03:07:30", "text": "可能"}, {"type": "subtitle", "time": 11252.67, "timestamp": "03:07:32", "text": "[音乐]"}, {"type": "subtitle", "time": 11255.349, "timestamp": "03:07:35", "text": "伙计们，看看我发现了什么！"}, {"type": "subtitle", "time": 11262.429, "timestamp": "03:07:42", "text": "找到什么"}, {"type": "subtitle", "time": 11267.07, "timestamp": "03:07:47", "text": "那是什么？那是什么？火的东西？"}, {"type": "subtitle", "time": 11269.63, "timestamp": "03:07:49", "text": "火球龙，熊熊烈火，或"}, {"type": "subtitle", "time": 11273.79, "timestamp": "03:07:53", "text": "对吧，呃，开火充电了，就这么简单"}, {"type": "subtitle", "time": 11276.63, "timestamp": "03:07:56", "text": "它对它有好处，它对它有好处"}, {"type": "subtitle", "time": 11279.03, "timestamp": "03:07:59", "text": "好长啊我的天"}]
[{"type": "subtitle", "time": 7441.669, "timestamp": "02:04:01", "text": "听我的，别听这个人的。"}, {"type": "subtitle", "time": 7444.589, "timestamp": "02:04:04", "text": "你在做什么？你在做什么？"}, {"type": "subtitle", "time": 7445.91, "timestamp": "02:04:05", "text": "丢失的"}, {"type": "subtitle", "time": 7449.51, "timestamp": "02:04:09", "text": "他做了一笔交易，包括所有的一切。"}, {"type": "subtitle", "time": 7451.669, "timestamp": "02:04:11", "text": "他做了一笔交易，你现在阻止不了了。"}, {"type": "subtitle", "time": 7457.149, "timestamp": "02:04:17", "text": "对不起，嘿，他做了笔交易，乔"}, {"type": "subtitle", "time": 7461.99, "timestamp": "02:04:21", "text": "交易员乔，请放下TNT炸药。"}, {"type": "subtitle", "time": 7465.27, "timestamp": "02:04:25", "text": "乔乔，请你下来，过来。"}, {"type": "subtitle", "time": 7469.43, "timestamp": "02:04:29", "text": "来，在我动手之前做，乔。"}, {"type": "subtitle", "time": 7473.149, "timestamp": "02:04:33", "text": "等等等等等等，听我说"}, {"type": "subtitle", "time": 7479.069, "timestamp": "02:04:39", "text": "我：嗨，你干嘛？你干嘛？你干嘛？"}, {"type": "subtitle", "time": 7482.27, "timestamp": "02:04:42", "text": "输了告诉我我有东西，不，我"}, {"type": "subtitle", "time": 7489.069, "timestamp": "02:04:49", "text": "哦等等等等等等，我忘了……"}, {"type": "subtitle", "time": 7492.83, "timestamp": "02:04:52", "text": "可以给你16颗祖母绿，共两颗。"}, {"type": "subtitle", "time": 7494.95, "timestamp": "02:04:54", "text": "我不够，哦，我有，我有"}, {"type": "subtitle", "time": 7498.149, "timestamp": "02:04:58", "text": "不是吗？哦，是的，我有它，拿走它，拿走"}]
[{"type": "subtitle", "time": 7021.109, "timestamp": "01:57:01", "text": "火力过滤器的作用是什么？"}, {"type": "subtitle", "time": 7024.109, "timestamp": "01:57:04", "text": "如果我坚持下去，我已经有了。"}, {"type": "subtitle", "time": 7026.27, "timestamp": "01:57:06", "text": "如果你接受，我就把这把武士刀给你"}, {"type": "subtitle", "time": 7028.55, "timestamp": "01:57:08", "text": "用一些TNT炸药炸掉你的一部分。"}, {"type": "subtitle", "time": 7031.709, "timestamp": "01:57:11", "text": "房子旁边还有一栋房子，我们有"}, {"type": "subtitle", "time": 7034.47, "timestamp": "01:57:14", "text": "房子？不，我们没有房子，只有一个山洞。"}, {"type": "subtitle", "time": 7038.75, "timestamp": "01:57:18", "text": "你可以炸掉你洞穴的一部分"}, {"type": "subtitle", "time": 7041.31, "timestamp": "01:57:21", "text": "对，我可以做到，我知道"}, {"type": "subtitle", "time": 7044.31, "timestamp": "01:57:24", "text": "确切的代表地点在哪里"}, {"type": "subtitle", "time": 7049.03, "timestamp": "01:57:29", "text": "真的吗？是的，我会杀了它"}, {"type": "subtitle", "time": 7053.35, "timestamp": "01:57:33", "text": "V 在你家，是的"}, {"type": "subtitle", "time": 7055.99, "timestamp": "01:57:35", "text": "里面有个VCH"}, {"type": "subtitle", "time": 7059.55, "timestamp": "01:57:39", "text": "我看到一个洞穴，里面很富，只要我在附近就行。"}, {"type": "subtitle", "time": 7068.91, "timestamp": "01:57:48", "text": "疼痛可以，我的意思是，如果我们能用卫生纸包住你，我们就可以。"}, {"type": "subtitle", "time": 7070.75, "timestamp": "01:57:50", "text": "我想我们可以用TP把你传送回去，然后"}, {"type": "subtitle", "time": 7072.79, "timestamp": "01:57:52", "text": "你知道，你可以实时完成。"}, {"type": "subtitle", "time": 7078.51, "timestamp": "01:57:58", "text": "武士刀，但武士刀比……更好吗？"}]
[{"type": "subtitle", "time": 6362.31, "timestamp": "01:46:02", "text": "等等，等等，它之后"}, {"type": "subtitle", "time": 6365.149, "timestamp": "01:46:05", "text": "这是在滑动之后，就像这样"}, {"type": "subtitle", "time": 6368.669, "timestamp": "01:46:08", "text": "是的，母亲和家人，母亲和儿子"}, {"type": "subtitle", "time": 6378.07, "timestamp": "01:46:18", "text": "我在这里说过话，是的，我在这里死了"}, {"type": "subtitle", "time": 6381.589, "timestamp": "01:46:21", "text": "不小心按到了你的右下角"}, {"type": "subtitle", "time": 6383.669, "timestamp": "01:46:23", "text": "不小心按了“是”，我不小心"}, {"type": "subtitle", "time": 6386.189, "timestamp": "01:46:26", "text": "我被压住，当时我几乎惊慌失措。"}, {"type": "subtitle", "time": 6388.99, "timestamp": "01:46:28", "text": "哦不，我该去哪儿？我该去哪儿？"}, {"type": "subtitle", "time": 6391.149, "timestamp": "01:46:31", "text": "然后S开始出现故障，我无法……"}, {"type": "subtitle", "time": 6394.87, "timestamp": "01:46:34", "text": "动不了，你看，我做不到。"}, {"type": "subtitle", "time": 6397.43, "timestamp": "01:46:37", "text": "我开始打破玻璃"}, {"type": "subtitle", "time": 6399.229, "timestamp": "01:46:39", "text": "不"}, {"type": "subtitle", "time": 6407.75, "timestamp": "01:46:47", "text": "我慌了，因为慌乱而断开了连接。"}, {"type": "subtitle", "time": 6410.43, "timestamp": "01:46:50", "text": "Wasa 出故障了，我断开了连接。"}, {"type": "subtitle", "time": 6413.87, "timestamp": "01:46:53", "text": "惊慌失措的人"}, {"type": "subtitle", "time": 6416.91, "timestamp": "01:46:56", "text": "我开始恐慌，我开始……"}, {"type": "subtitle", "time": 6418.99, "timestamp": "01:46:58", "text": "然后我恐慌了"}]
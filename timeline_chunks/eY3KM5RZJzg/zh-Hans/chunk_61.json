[{"type": "subtitle", "time": 3663.71, "timestamp": "01:01:03", "text": "极地，我是你的星座"}, {"type": "subtitle", "time": 3666.67, "timestamp": "01:01:06", "text": "啊，小心点"}, {"type": "subtitle", "time": 3697.27, "timestamp": "01:01:37", "text": "哦，我知道这些"}, {"type": "subtitle", "time": 3700.95, "timestamp": "01:01:40", "text": "我昨天之前在我的房间里见过这些孩子。"}, {"type": "subtitle", "time": 3704.87, "timestamp": "01:01:44", "text": "寻找我的使命之旅"}, {"type": "subtitle", "time": 3712.63, "timestamp": "01:01:52", "text": "给定"}, {"type": "subtitle", "time": 3717.829, "timestamp": "01:01:57", "text": "不不不不"}]
[{"type": "subtitle", "time": 13681.95, "timestamp": "03:48:01", "text": "是的，别弄丢了铁锤，那就是"}, {"type": "subtitle", "time": 13683.95, "timestamp": "03:48:03", "text": "我送给你们俩的珍贵礼物——铁"}, {"type": "subtitle", "time": 13687.07, "timestamp": "03:48:07", "text": "锤子和斧头，我努力工作"}, {"type": "subtitle", "time": 13690.99, "timestamp": "03:48:10", "text": "七海，等等，等等，先等等"}, {"type": "subtitle", "time": 13692.75, "timestamp": "03:48:12", "text": "听我说，听我说，等等，如果你们"}, {"type": "subtitle", "time": 13694.83, "timestamp": "03:48:14", "text": "拥有任何像非常珍贵的东西"}, {"type": "subtitle", "time": 13697.309, "timestamp": "03:48:17", "text": "把它放在这里，因为我们要走了"}, {"type": "subtitle", "time": 13699.11, "timestamp": "03:48:19", "text": "某个地方有僵尸，所以……"}, {"type": "subtitle", "time": 13701.03, "timestamp": "03:48:21", "text": "我们有可能死亡，所以最好"}, {"type": "subtitle", "time": 13703.189, "timestamp": "03:48:23", "text": "顺便说一句，顺便说一句"}, {"type": "subtitle", "time": 13706.189, "timestamp": "03:48:26", "text": "剑鱼告诉我，如果你保持你的"}, {"type": "subtitle", "time": 13709.429, "timestamp": "03:48:29", "text": "呃，价格所有权在背面，是的。"}, {"type": "subtitle", "time": 13712.349, "timestamp": "03:48:32", "text": "难道不是吗？它不会走，是啊是啊是啊"}, {"type": "subtitle", "time": 13716.269, "timestamp": "03:48:36", "text": "是的，所以我觉得我应该保留……"}, {"type": "subtitle", "time": 13720.189, "timestamp": "03:48:40", "text": "钻石，呃，武士刀，我努力工作过。"}, {"type": "subtitle", "time": 13723.229, "timestamp": "03:48:43", "text": "我告诉他的时候，他的裤子就像……"}, {"type": "subtitle", "time": 13730.95, "timestamp": "03:48:50", "text": "什么什么什么，卡辛生气了"}, {"type": "subtitle", "time": 13732.95, "timestamp": "03:48:52", "text": "我告诉他你的时候，他气喘吁吁。"}, {"type": "subtitle", "time": 13734.99, "timestamp": "03:48:54", "text": "准备好了，带着魔法"}, {"type": "subtitle", "time": 13737.229, "timestamp": "03:48:57", "text": "剑哦我的"}]
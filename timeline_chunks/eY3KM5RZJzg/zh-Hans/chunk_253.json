[{"type": "subtitle", "time": 15189.349, "timestamp": "04:13:09", "text": "我跟他说嗨，你是这些东西吗？"}, {"type": "subtitle", "time": 15192.269, "timestamp": "04:13:12", "text": "我正在猎杀动物，想给你……"}, {"type": "subtitle", "time": 15197.349, "timestamp": "04:13:17", "text": "食物加上呃，我迷路了，想找人帮忙。"}, {"type": "subtitle", "time": 15201.51, "timestamp": "04:13:21", "text": "找到家，我找到了我们的GPS位置"}, {"type": "subtitle", "time": 15204.469, "timestamp": "04:13:24", "text": "我和美雪找到了新家"}, {"type": "subtitle", "time": 15206.79, "timestamp": "04:13:26", "text": "你看到的那个船状物体"}, {"type": "subtitle", "time": 15210.63, "timestamp": "04:13:30", "text": "溪流像指南针一样指引方向，我也应该如此。"}, {"type": "subtitle", "time": 15212.429, "timestamp": "04:13:32", "text": "带着"}, {"type": "subtitle", "time": 15215.349, "timestamp": "04:13:35", "text": "指南针，是的，我感觉就像是的"}, {"type": "subtitle", "time": 15220.149, "timestamp": "04:13:40", "text": "三月在她的船上"}, {"type": "subtitle", "time": 15221.79, "timestamp": "04:13:41", "text": "屋"}, {"type": "subtitle", "time": 15224.03, "timestamp": "04:13:44", "text": "哦是的"}, {"type": "subtitle", "time": 15227.269, "timestamp": "04:13:47", "text": "嗨，是的，马上就来"}, {"type": "subtitle", "time": 15230.109, "timestamp": "04:13:50", "text": "D，我也会过来给你送货。"}, {"type": "subtitle", "time": 15233.03, "timestamp": "04:13:53", "text": "我会亲自把货物送到你那里。"}, {"type": "subtitle", "time": 15237.269, "timestamp": "04:13:57", "text": "我的天哪，这都是什么？"}]
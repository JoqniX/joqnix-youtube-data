[{"type": "subtitle", "time": 9660.95, "timestamp": "02:41:00", "text": "狗是吗？是的，就像你摆放书籍一样。"}, {"type": "subtitle", "time": 9663.75, "timestamp": "02:41:03", "text": "这样可以。"}, {"type": "subtitle", "time": 9668.03, "timestamp": "02:41:08", "text": "然后你把它放上去。"}, {"type": "subtitle", "time": 9671.67, "timestamp": "02:41:11", "text": "你这里有一套盔甲"}, {"type": "subtitle", "time": 9675.11, "timestamp": "02:41:15", "text": "你……你有什么盔甲？铁制的吗？"}, {"type": "subtitle", "time": 9676.63, "timestamp": "02:41:16", "text": "胸甲"}, {"type": "subtitle", "time": 9681.75, "timestamp": "02:41:21", "text": "是的，我在这里右键点击。"}, {"type": "subtitle", "time": 9684.63, "timestamp": "02:41:24", "text": "不不不不不，把盔甲脱掉"}, {"type": "subtitle", "time": 9688.269, "timestamp": "02:41:28", "text": "卸下盔甲，把它放在你的……"}, {"type": "subtitle", "time": 9691.07, "timestamp": "02:41:31", "text": "库存 右键点击"}, {"type": "subtitle", "time": 9694.349, "timestamp": "02:41:34", "text": "现在你可以看到一个小插槽"}, {"type": "subtitle", "time": 9701.309, "timestamp": "02:41:41", "text": "把你的铁盔甲放好"}, {"type": "subtitle", "time": 9705.79, "timestamp": "02:41:45", "text": "把它放在旁边，然后把蓝色青金石也放在旁边。"}, {"type": "subtitle", "time": 9708.87, "timestamp": "02:41:48", "text": "我需要拿回我的东西，你呢？"}, {"type": "subtitle", "time": 9712.07, "timestamp": "02:41:52", "text": "能够看到一些魔法效果"}, {"type": "subtitle", "time": 9714.95, "timestamp": "02:41:54", "text": "右侧像矩形"}]
[{"type": "subtitle", "time": 13744.269, "timestamp": "03:49:04", "text": "ああ、マイクを通して聞こえたよ、すごい"}, {"type": "subtitle", "time": 13749.67, "timestamp": "03:49:09", "text": "わかったよ、ジョー、何を食べたの？わかった、読んでみるよ"}, {"type": "subtitle", "time": 13754.349, "timestamp": "03:49:14", "text": "ベールゴールドヘルメットベール、私は"}, {"type": "subtitle", "time": 13755.67, "timestamp": "03:49:15", "text": "聞く"}, {"type": "subtitle", "time": 13757.91, "timestamp": "03:49:17", "text": "ああ、それはできないよ"}, {"type": "subtitle", "time": 13760.429, "timestamp": "03:49:20", "text": "浮気だから、そう、私は"}, {"type": "subtitle", "time": 13763.71, "timestamp": "03:49:23", "text": "色が違う、ああ、ありがとう、それは"}, {"type": "subtitle", "time": 13768.149, "timestamp": "03:49:28", "text": "クジラよ、クジラよ、それから横移動もして"}, {"type": "subtitle", "time": 13771.229, "timestamp": "03:49:31", "text": "スライド たくさん必要 たくさん必要"}, {"type": "subtitle", "time": 13774.03, "timestamp": "03:49:34", "text": "トーチズキ、持ってる？"}, {"type": "subtitle", "time": 13777.189, "timestamp": "03:49:37", "text": "たいまつが必要だ"}, {"type": "subtitle", "time": 13781.189, "timestamp": "03:49:41", "text": "竹があります。竹があります。"}, {"type": "subtitle", "time": 13783.149, "timestamp": "03:49:43", "text": "ちょっと待って、もう一方のスペルを教えて"}, {"type": "subtitle", "time": 13787.91, "timestamp": "03:49:47", "text": "ジョス・ストラフェストを見かける"}, {"type": "subtitle", "time": 13791.91, "timestamp": "03:49:51", "text": "r a f e ところで、これを受け取って"}, {"type": "subtitle", "time": 13793.03, "timestamp": "03:49:53", "text": "電話"}, {"type": "subtitle", "time": 13794.14, "timestamp": "03:49:54", "text": "自分"}, {"type": "subtitle", "time": 13795.63, "timestamp": "03:49:55", "text": "[音楽]"}, {"type": "subtitle", "time": 13797.429, "timestamp": "03:49:57", "text": "それから"}]
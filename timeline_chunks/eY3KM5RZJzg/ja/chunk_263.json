[{"type": "subtitle", "time": 15786.229, "timestamp": "04:23:06", "text": "うん、ジョー、キャスピアが私を殺したんだよね？"}, {"type": "subtitle", "time": 15790.07, "timestamp": "04:23:10", "text": "ウキンコンパスを持っていません"}, {"type": "subtitle", "time": 15792.109, "timestamp": "04:23:12", "text": "何かが起こる前に"}, {"type": "subtitle", "time": 15796.149, "timestamp": "04:23:16", "text": "実際にウキンコンパスを彼女に渡す"}, {"type": "subtitle", "time": 15803.149, "timestamp": "04:23:23", "text": "いや、なんてことだ、なぜアストラは"}, {"type": "subtitle", "time": 15808.269, "timestamp": "04:23:28", "text": "何をしたのですか？"}, {"type": "subtitle", "time": 15810.99, "timestamp": "04:23:30", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 15814.79, "timestamp": "04:23:34", "text": "神様、でも彼女はすぐ近くにいたんだ、うんうん"}, {"type": "subtitle", "time": 15818.03, "timestamp": "04:23:38", "text": "コンパスを安全に保管してください"}, {"type": "subtitle", "time": 15822.87, "timestamp": "04:23:42", "text": "お願いします、ああ、それは"}, {"type": "subtitle", "time": 15825.55, "timestamp": "04:23:45", "text": "いいえ、持っていません。彼女が持っています。"}, {"type": "subtitle", "time": 15827.109, "timestamp": "04:23:47", "text": "うん、彼女にそれを保管するように言わないといけないよ"}, {"type": "subtitle", "time": 15830.03, "timestamp": "04:23:50", "text": "安全だ、彼女の場所だから、もし漏洩しても問題ない"}, {"type": "subtitle", "time": 15836.87, "timestamp": "04:23:56", "text": "行っちゃったよ、待って、えっと、"}]
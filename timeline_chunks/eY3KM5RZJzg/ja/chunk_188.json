[{"type": "subtitle", "time": 11284.59, "timestamp": "03:08:04", "text": "神様、私のルーが見てくれるといいな。"}, {"type": "subtitle", "time": 11289.229, "timestamp": "03:08:09", "text": "何をしているの？ガスは何？"}, {"type": "subtitle", "time": 11294.15, "timestamp": "03:08:14", "text": "ゲームでガムを噛むと、息子が飛び込む"}, {"type": "subtitle", "time": 11298.89, "timestamp": "03:08:18", "text": "ゲームで彼女は私を奴隷にしたんだ"}, {"type": "subtitle", "time": 11302.15, "timestamp": "03:08:22", "text": "[音楽]"}, {"type": "subtitle", "time": 11304.83, "timestamp": "03:08:24", "text": "何何"}, {"type": "subtitle", "time": 11309.03, "timestamp": "03:08:29", "text": "えっと、ちょっと待って、自分の荷物はそのままにしておきたいんです"}, {"type": "subtitle", "time": 11312.309, "timestamp": "03:08:32", "text": "だから、もし私が死んだら、私の持ち物も"}, {"type": "subtitle", "time": 11317.429, "timestamp": "03:08:37", "text": "えーっと、えーっと、魚です。なぜ在庫を保持するのですか？"}, {"type": "subtitle", "time": 11322.469, "timestamp": "03:08:42", "text": "可能になるのは、"}, {"type": "subtitle", "time": 11323.75, "timestamp": "03:08:43", "text": "要素"}, {"type": "subtitle", "time": 11326.63, "timestamp": "03:08:46", "text": "苦闘し、そして私たちは繁栄し、そして私たちは"}, {"type": "subtitle", "time": 11328.83, "timestamp": "03:08:48", "text": "君たちに会えるのが楽しみだよ"}, {"type": "subtitle", "time": 11332.59, "timestamp": "03:08:52", "text": "私のように苦労する"}, {"type": "subtitle", "time": 11335.67, "timestamp": "03:08:55", "text": "私に何？あなたが言ったことはどういう意味ですか？"}, {"type": "subtitle", "time": 11339.67, "timestamp": "03:08:59", "text": "私と同じように、あなたは「ああ、神様」と言いました。"}]
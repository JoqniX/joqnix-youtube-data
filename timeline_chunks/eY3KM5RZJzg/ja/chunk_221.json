[{"type": "subtitle", "time": 13261.11, "timestamp": "03:41:01", "text": "彼女がくれるものは何でもあなたにあげる、というわけではない"}, {"type": "subtitle", "time": 13265.71, "timestamp": "03:41:05", "text": "ダブルオーマイゴッド私はしたくないただ"}, {"type": "subtitle", "time": 13268.87, "timestamp": "03:41:08", "text": "何かをしよう、と言いたい"}, {"type": "subtitle", "time": 13271.349, "timestamp": "03:41:11", "text": "チーム、はい、殺します"}, {"type": "subtitle", "time": 13275.71, "timestamp": "03:41:15", "text": "ドラガーを​​殺せ、ドラガーを​​殺せ、さあ行こう"}, {"type": "subtitle", "time": 13277.59, "timestamp": "03:41:17", "text": "それは"}, {"type": "subtitle", "time": 13282.51, "timestamp": "03:41:22", "text": "クエスト 私 私 誰 診断者 プレイヤー"}, {"type": "subtitle", "time": 13285.309, "timestamp": "03:41:25", "text": "ほら、問題は、彼が言った"}, {"type": "subtitle", "time": 13288.87, "timestamp": "03:41:28", "text": "大きな報酬がもらえる"}, {"type": "subtitle", "time": 13292.63, "timestamp": "03:41:32", "text": "チーム全員で報告したのですが、私はこう思いました"}, {"type": "subtitle", "time": 13295.429, "timestamp": "03:41:35", "text": "おお、報酬だから私たちは"}, {"type": "subtitle", "time": 13299.349, "timestamp": "03:41:39", "text": "でも、でも、あなたたちが話しているのは"}, {"type": "subtitle", "time": 13303.51, "timestamp": "03:41:43", "text": "似たような素材を全く持っていない"}, {"type": "subtitle", "time": 13307.95, "timestamp": "03:41:47", "text": "はい、これを受け取ってください"}, {"type": "subtitle", "time": 13311.55, "timestamp": "03:41:51", "text": "このジョーはあなたのゴミ捨て場ではありません"}, {"type": "subtitle", "time": 13314.469, "timestamp": "03:41:54", "text": "待ってるけど、手に入らない"}, {"type": "subtitle", "time": 13318.149, "timestamp": "03:41:58", "text": "大丈夫だよ、君が僕に彼を単独で殺してほしいなら。"}]
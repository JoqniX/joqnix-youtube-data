[{"type": "subtitle", "time": 12720.469, "timestamp": "03:32:00", "text": "私が言ったのは、彼を引きずるか殺すということだ"}, {"type": "subtitle", "time": 12722.95, "timestamp": "03:32:02", "text": "個人"}, {"type": "subtitle", "time": 12725.51, "timestamp": "03:32:05", "text": "クエスト 何 何"}, {"type": "subtitle", "time": 12728.07, "timestamp": "03:32:08", "text": "クエスト"}, {"type": "subtitle", "time": 12731.63, "timestamp": "03:32:11", "text": "私はジョーがすごく怪しい行動をとっている"}, {"type": "subtitle", "time": 12734.03, "timestamp": "03:32:14", "text": "ここ"}, {"type": "subtitle", "time": 12737.59, "timestamp": "03:32:17", "text": "ええと、実は私たちはグラインドするつもりです"}, {"type": "subtitle", "time": 12740.83, "timestamp": "03:32:20", "text": "今日だけなら、グラインドしてグラインドできます"}, {"type": "subtitle", "time": 12748.79, "timestamp": "03:32:28", "text": "今日はあまり時間がないのですが"}, {"type": "subtitle", "time": 12749.71, "timestamp": "03:32:29", "text": "実は"}, {"type": "subtitle", "time": 12754.229, "timestamp": "03:32:34", "text": "一日中寝てなかったから眠いよ"}, {"type": "subtitle", "time": 12756.99, "timestamp": "03:32:36", "text": "いいえ、でも私の計画はちょっとだけ"}, {"type": "subtitle", "time": 12757.95, "timestamp": "03:32:37", "text": "少し"}, {"type": "subtitle", "time": 12762.87, "timestamp": "03:32:42", "text": "採掘なので、今日はダイヤモンドが対象です"}, {"type": "subtitle", "time": 12766.229, "timestamp": "03:32:46", "text": "彼女は挽いた、彼女はミンした、彼女はそうした"}, {"type": "subtitle", "time": 12769.389, "timestamp": "03:32:49", "text": "今日はいい仕事だったね、彼女は"}, {"type": "subtitle", "time": 12773.63, "timestamp": "03:32:53", "text": "あなたがこれを好きではないことがわかった、ああ神様"}, {"type": "subtitle", "time": 12776.83, "timestamp": "03:32:56", "text": "ジョー、ロールプレイもできるよ、君は実際"}]
[{"type": "subtitle", "time": 8281.429, "timestamp": "02:18:01", "text": "はい、あなたの話を聞きます。こんにちは、私は聞きます。"}, {"type": "subtitle", "time": 8285.11, "timestamp": "02:18:05", "text": "あなたはただ私のもの、ただ私のもの"}, {"type": "subtitle", "time": 8289.07, "timestamp": "02:18:09", "text": "下ではなく前へ、ただ前へ、上へ"}, {"type": "subtitle", "time": 8292.03, "timestamp": "02:18:12", "text": "階段か何かを作って、そうしよう"}, {"type": "subtitle", "time": 8299.75, "timestamp": "02:18:19", "text": "階段待って、置いておきたいですか？"}, {"type": "subtitle", "time": 8301.349, "timestamp": "02:18:21", "text": "ライトができない"}, {"type": "subtitle", "time": 8304.07, "timestamp": "02:18:24", "text": "いや、大丈夫だよ。それもそうだね。"}, {"type": "subtitle", "time": 8308.429, "timestamp": "02:18:28", "text": "うまくいった、ああ、神様、そうだ、行ってみて"}, {"type": "subtitle", "time": 8310.99, "timestamp": "02:18:30", "text": "上向きに進んでいますが、下向きの動きになっています。"}, {"type": "subtitle", "time": 8316.19, "timestamp": "02:18:36", "text": "右に上向きに、そうしないで、うん"}, {"type": "subtitle", "time": 8318.549, "timestamp": "02:18:38", "text": "そんな風に階段でキスをするんだ、うんうん"}, {"type": "subtitle", "time": 8321.03, "timestamp": "02:18:41", "text": "そう、そんな感じでどんどん上がっていく"}, {"type": "subtitle", "time": 8323.429, "timestamp": "02:18:43", "text": "なぜ私たちは上に行く必要があるのか​​私たちは行く必要がある"}, {"type": "subtitle", "time": 8325.629, "timestamp": "02:18:45", "text": "下に、何か見せたいものがあるんだけど、いいかな？"}, {"type": "subtitle", "time": 8327.669, "timestamp": "02:18:47", "text": "行く"}, {"type": "subtitle", "time": 8331.91, "timestamp": "02:18:51", "text": "下へ、うん、下へ行こう"}, {"type": "subtitle", "time": 8332.79, "timestamp": "02:18:52", "text": "なれ"}, {"type": "subtitle", "time": 8336.99, "timestamp": "02:18:56", "text": "気をつけて、あ、待って、ああ、降りていいよ"}]
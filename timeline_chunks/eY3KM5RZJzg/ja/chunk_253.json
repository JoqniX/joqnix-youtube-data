[{"type": "subtitle", "time": 15189.349, "timestamp": "04:13:09", "text": "彼にこんにちはと言ったので、私は"}, {"type": "subtitle", "time": 15192.269, "timestamp": "04:13:12", "text": "動物を狩って、あなたにあげます"}, {"type": "subtitle", "time": 15197.349, "timestamp": "04:13:17", "text": "食べ物プラスえっと、迷子になって"}, {"type": "subtitle", "time": 15201.51, "timestamp": "04:13:21", "text": "家を見つけて、GPSで位置情報を確認しました"}, {"type": "subtitle", "time": 15204.469, "timestamp": "04:13:24", "text": "新しい家を見つけた私とミウキ"}, {"type": "subtitle", "time": 15206.79, "timestamp": "04:13:26", "text": "あなたが見た船のようなもの"}, {"type": "subtitle", "time": 15210.63, "timestamp": "04:13:30", "text": "流れは羅針盤のように進むので、私もそうすべきでしょうか"}, {"type": "subtitle", "time": 15212.429, "timestamp": "04:13:32", "text": "あなたに"}, {"type": "subtitle", "time": 15215.349, "timestamp": "04:13:35", "text": "コンパス、うん、私はイナンみたい、うん"}, {"type": "subtitle", "time": 15220.149, "timestamp": "04:13:40", "text": "ミツキは彼女の船に乗っている"}, {"type": "subtitle", "time": 15221.79, "timestamp": "04:13:41", "text": "家"}, {"type": "subtitle", "time": 15224.03, "timestamp": "04:13:44", "text": "ああ、そうだ"}, {"type": "subtitle", "time": 15227.269, "timestamp": "04:13:47", "text": "はい、来ます"}, {"type": "subtitle", "time": 15230.109, "timestamp": "04:13:50", "text": "Dも、私が配達に行きます"}, {"type": "subtitle", "time": 15233.03, "timestamp": "04:13:53", "text": "商品をお届けに伺います"}, {"type": "subtitle", "time": 15237.269, "timestamp": "04:13:57", "text": "商品は、ああ神様、これは一体何だ"}]
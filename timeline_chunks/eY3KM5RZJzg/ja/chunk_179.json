[{"type": "subtitle", "time": 10746.03, "timestamp": "02:59:06", "text": "手に入れた、そして、オーケー、私は両方持っている、"}, {"type": "subtitle", "time": 10750.469, "timestamp": "02:59:10", "text": "ここには良いものがあります"}, {"type": "subtitle", "time": 10753.63, "timestamp": "02:59:13", "text": "ハビビの男が"}, {"type": "subtitle", "time": 10757.87, "timestamp": "02:59:17", "text": "バンディングの男はここが見えない"}, {"type": "subtitle", "time": 10770.75, "timestamp": "02:59:30", "text": "彼女のチャットには、数人の視聴者がいた。"}, {"type": "subtitle", "time": 10779.389, "timestamp": "02:59:39", "text": "ごめんね、チャド、問題は"}, {"type": "subtitle", "time": 10784.269, "timestamp": "02:59:44", "text": "それは、ああ神様、私は交流します"}, {"type": "subtitle", "time": 10790.03, "timestamp": "02:59:50", "text": "本当にごめんなさい、何があったの？"}, {"type": "subtitle", "time": 10793.349, "timestamp": "02:59:53", "text": "えっと、チャットが怒ってるんだけど、私は"}, {"type": "subtitle", "time": 10797.309, "timestamp": "02:59:57", "text": "引き付ける、引き付ける、相互作用する"}]
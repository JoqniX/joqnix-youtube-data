[{"type": "subtitle", "time": 15122.389, "timestamp": "04:12:02", "text": "背後からの攻撃を1、2回"}, {"type": "subtitle", "time": 15126.429, "timestamp": "04:12:06", "text": "これはクエスト2ですが"}, {"type": "subtitle", "time": 15130.229, "timestamp": "04:12:10", "text": "バックスタブか、2番目のクエストを与える"}, {"type": "subtitle", "time": 15133.79, "timestamp": "04:12:13", "text": "それを見つける旅に出ていたが"}, {"type": "subtitle", "time": 15134.67, "timestamp": "04:12:14", "text": "それ"}, {"type": "subtitle", "time": 15136.71, "timestamp": "04:12:16", "text": "は"}, {"type": "subtitle", "time": 15140.51, "timestamp": "04:12:20", "text": "コンパスには2番がありますが、あなたは"}, {"type": "subtitle", "time": 15148.229, "timestamp": "04:12:28", "text": "ああ、君はやったんだね、わかったよ、まるで私が"}, {"type": "subtitle", "time": 15151.189, "timestamp": "04:12:31", "text": "当時私はただテッドを自分で手に入れた"}, {"type": "subtitle", "time": 15155.429, "timestamp": "04:12:35", "text": "ああ、わかった、わかった、わかった、わかった、わかった"}, {"type": "subtitle", "time": 15160.63, "timestamp": "04:12:40", "text": "あと、あと、行く前に直してください"}, {"type": "subtitle", "time": 15163.229, "timestamp": "04:12:43", "text": "えっと"}, {"type": "subtitle", "time": 15166.63, "timestamp": "04:12:46", "text": "君とあの小さな家を思い出すよ"}, {"type": "subtitle", "time": 15168.51, "timestamp": "04:12:48", "text": "はいはいはい"}, {"type": "subtitle", "time": 15172.03, "timestamp": "04:12:52", "text": "はい、ありがとうございます。"}]
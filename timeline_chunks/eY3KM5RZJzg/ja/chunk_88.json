[{"type": "subtitle", "time": 5280.39, "timestamp": "01:28:00", "text": "触って、書き留めるけど、"}, {"type": "subtitle", "time": 5287.03, "timestamp": "01:28:07", "text": "えっと、どうやって"}, {"type": "subtitle", "time": 5291.709, "timestamp": "01:28:11", "text": "開ける、あぁ、開けることすらできないよ、えっと、それ"}, {"type": "subtitle", "time": 5294.149, "timestamp": "01:28:14", "text": "それでは、ご覧ください。"}, {"type": "subtitle", "time": 5295.91, "timestamp": "01:28:15", "text": "必要な剣"}, {"type": "subtitle", "time": 5299.709, "timestamp": "01:28:19", "text": "剣、ブア、ブア、ブア、お前はどうだ、バカ"}, {"type": "subtitle", "time": 5302.91, "timestamp": "01:28:22", "text": "もっとあなた"}, {"type": "subtitle", "time": 5307.35, "timestamp": "01:28:27", "text": "バカ、おいおい、偉大な人じゃないよ"}, {"type": "subtitle", "time": 5310.629, "timestamp": "01:28:30", "text": "剣、それら全てはベースにあります"}, {"type": "subtitle", "time": 5312.109, "timestamp": "01:28:32", "text": "カーソルを合わせる"}, {"type": "subtitle", "time": 5313.91, "timestamp": "01:28:33", "text": "私が手に入れたもの"}, {"type": "subtitle", "time": 5317.91, "timestamp": "01:28:37", "text": "それは穴です、穴に戻ります"}, {"type": "subtitle", "time": 5319.95, "timestamp": "01:28:39", "text": "戻る 戻る 戻る 戻る"}, {"type": "subtitle", "time": 5323.229, "timestamp": "01:28:43", "text": "戻るよ、ああ、ゴールデンホー効率"}, {"type": "subtitle", "time": 5327.109, "timestamp": "01:28:47", "text": "採掘を増やす、それはいいよ、つまり"}, {"type": "subtitle", "time": 5329.43, "timestamp": "01:28:49", "text": "ああ、それは宝物からの荷物だった"}, {"type": "subtitle", "time": 5333.59, "timestamp": "01:28:53", "text": "いや、いいよ、続けて、バカ。"}, {"type": "subtitle", "time": 5336.47, "timestamp": "01:28:56", "text": "剣をクリックしてください、それがポイントです"}, {"type": "subtitle", "time": 5336.85, "timestamp": "01:28:56", "text": "あなた"}]
[{"type": "subtitle", "time": 7620.31, "timestamp": "02:07:00", "text": "私の何何何何何について"}, {"type": "subtitle", "time": 7622.589, "timestamp": "02:07:02", "text": "家を燃やすって何？"}, {"type": "subtitle", "time": 7625.87, "timestamp": "02:07:05", "text": "それは、彼が2つの選択肢を与えたようなものだった"}, {"type": "subtitle", "time": 7628.149, "timestamp": "02:07:08", "text": "頭金を払いたかったのですが"}, {"type": "subtitle", "time": 7631.31, "timestamp": "02:07:11", "text": "だって私は手にエメラルドを2つ持っていたから"}, {"type": "subtitle", "time": 7635.39, "timestamp": "02:07:15", "text": "彼は最初は16を要求した"}, {"type": "subtitle", "time": 7639.109, "timestamp": "02:07:19", "text": "剣のためのエメラルド、ああ神様、私は"}, {"type": "subtitle", "time": 7642.83, "timestamp": "02:07:22", "text": "私は持っていた"}, {"type": "subtitle", "time": 7646.189, "timestamp": "02:07:26", "text": "でも私はTPDを手に入れなかったから、それから彼は"}, {"type": "subtitle", "time": 7649.709, "timestamp": "02:07:29", "text": "提案されたように、もしあなたがあなたの"}, {"type": "subtitle", "time": 7653.069, "timestamp": "02:07:33", "text": "ベースは、最初はBと言っていました。"}, {"type": "subtitle", "time": 7655.43, "timestamp": "02:07:35", "text": "私たちにはちゃんとした拠点がない洞窟は"}, {"type": "subtitle", "time": 7658.229, "timestamp": "02:07:38", "text": "私たちの基本権 私は最初はそれをあなたに"}, {"type": "subtitle", "time": 7660.589, "timestamp": "02:07:40", "text": "試してみた、君が知ってること試してみた"}, {"type": "subtitle", "time": 7664.709, "timestamp": "02:07:44", "text": "私を出し抜こうとした、いや、私はそんなことはしていない、いや、"}, {"type": "subtitle", "time": 7668.229, "timestamp": "02:07:48", "text": "待って、いや、私はあなたを出し抜いたわけじゃない、私に"}, {"type": "subtitle", "time": 7672.43, "timestamp": "02:07:52", "text": "終わらせて、終わらせて、"}, {"type": "subtitle", "time": 7674.51, "timestamp": "02:07:54", "text": "クソ"}, {"type": "subtitle", "time": 7676.83, "timestamp": "02:07:56", "text": "何？何をしているの？"}]
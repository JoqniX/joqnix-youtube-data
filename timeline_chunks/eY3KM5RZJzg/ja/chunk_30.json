[{"type": "subtitle", "time": 1811.389, "timestamp": "00:30:11", "text": "[音楽]"}, {"type": "subtitle", "time": 1826.63, "timestamp": "00:30:26", "text": "数秒、それはちょっとばかげた"}, {"type": "subtitle", "time": 1838.789, "timestamp": "00:30:38", "text": "ああ、だめだめだめだ、水中に滑り込まないで"}, {"type": "subtitle", "time": 1842.549, "timestamp": "00:30:42", "text": "死ぬよ、いやいやいやいや"}, {"type": "subtitle", "time": 1845.63, "timestamp": "00:30:45", "text": "いや、待て、私は飢えさせなければならない"}, {"type": "subtitle", "time": 1847.23, "timestamp": "00:30:47", "text": "今、これは"}, {"type": "subtitle", "time": 1848.37, "timestamp": "00:30:48", "text": "緊張"}]
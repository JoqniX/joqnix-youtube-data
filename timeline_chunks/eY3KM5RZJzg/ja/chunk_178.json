[{"type": "subtitle", "time": 10685.71, "timestamp": "02:58:05", "text": "大丈夫、私が作ります"}, {"type": "subtitle", "time": 10689.309, "timestamp": "02:58:09", "text": "階段、えっと、待って"}, {"type": "subtitle", "time": 10706.83, "timestamp": "02:58:26", "text": "私にとってここはいい家だ。ああ、本もある。"}, {"type": "subtitle", "time": 10708.07, "timestamp": "02:58:28", "text": "ここ"}, {"type": "subtitle", "time": 10710.71, "timestamp": "02:58:30", "text": "ミッシー、そうそうそうそうこれは"}, {"type": "subtitle", "time": 10714.51, "timestamp": "02:58:34", "text": "私があなたに見せたかった場所は"}, {"type": "subtitle", "time": 10718.07, "timestamp": "02:58:38", "text": "私が集めたものはここにあります。待って"}, {"type": "subtitle", "time": 10722.11, "timestamp": "02:58:42", "text": "見せてあげるよ、こっちに来て、M、"}, {"type": "subtitle", "time": 10724.95, "timestamp": "02:58:44", "text": "寝ないで、寝ないで、こっちに来て、こっちに来て"}, {"type": "subtitle", "time": 10728.59, "timestamp": "02:58:48", "text": "さあ、SLEがやってくる"}, {"type": "subtitle", "time": 10729.87, "timestamp": "02:58:49", "text": "良い"}, {"type": "subtitle", "time": 10733.07, "timestamp": "02:58:53", "text": "朝にクロスボウ"}, {"type": "subtitle", "time": 10735.07, "timestamp": "02:58:55", "text": "ああ、2つ"}, {"type": "subtitle", "time": 10739.95, "timestamp": "02:58:59", "text": "ダイヤモンド、ああ金のダイヤモンド、さあ行こう、そして私は"}]
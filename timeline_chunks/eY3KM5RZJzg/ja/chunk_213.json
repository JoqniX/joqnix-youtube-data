[{"type": "subtitle", "time": 12780.309, "timestamp": "03:33:00", "text": "君の行動は実際怪しい"}, {"type": "subtitle", "time": 12783.63, "timestamp": "03:33:03", "text": "神様、あなたはこんな風に振る舞わない"}, {"type": "subtitle", "time": 12788.83, "timestamp": "03:33:08", "text": "今日は声がとても不気味で、"}, {"type": "subtitle", "time": 12796.229, "timestamp": "03:33:16", "text": "ごめん、分かってる、彼が話してる理由も分かってる"}, {"type": "subtitle", "time": 12798.63, "timestamp": "03:33:18", "text": "そういう時、あなたはそこにいない"}, {"type": "subtitle", "time": 12803.349, "timestamp": "03:33:23", "text": "まさにこの男、この男、この男が起こった"}, {"type": "subtitle", "time": 12806.15, "timestamp": "03:33:26", "text": "これは、この男が取引をした"}, {"type": "subtitle", "time": 12809.15, "timestamp": "03:33:29", "text": "ハビビのようなジャウは"}, {"type": "subtitle", "time": 12810.59, "timestamp": "03:33:30", "text": "爆発する"}, {"type": "subtitle", "time": 12820.63, "timestamp": "03:33:40", "text": "B 私は彼を出し抜いた、わかった、私は彼を出し抜いた"}]
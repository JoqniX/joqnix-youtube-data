[{"type": "subtitle", "time": 2641.87, "timestamp": "00:44:01", "text": "H犠牲は"}, {"type": "subtitle", "time": 2646.589, "timestamp": "00:44:06", "text": "作ったので、私は彼らを全員殺します"}, {"type": "chat", "time": 2648.719, "timestamp": "00:44:08", "author": "@オニオン田中", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mfuIF27RMwX6DcAuf18U_0UBTsU2g7DgpNKYestnxkWZ4=s64-c-k-c0x00ffffff-no-rj", "message": "Hi.Thank you for today."}, {"type": "subtitle", "time": 2648.75, "timestamp": "00:44:08", "text": "君は"}, {"type": "subtitle", "time": 2652.349, "timestamp": "00:44:12", "text": "家族 私はあまり残酷ではない 私は私は 私は"}, {"type": "subtitle", "time": 2654.79, "timestamp": "00:44:14", "text": "私は慰めであり、"}, {"type": "subtitle", "time": 2661.71, "timestamp": "00:44:21", "text": "私は慰めです"}, {"type": "subtitle", "time": 2665.43, "timestamp": "00:44:25", "text": "闇ではなく血の側に転向した"}, {"type": "subtitle", "time": 2668.069, "timestamp": "00:44:28", "text": "我々は守護者であるが、"}, {"type": "subtitle", "time": 2669.75, "timestamp": "00:44:29", "text": "今度は私たちが復讐しなければならない"}, {"type": "subtitle", "time": 2672.99, "timestamp": "00:44:32", "text": "私たちを裏切った偽りの神"}, {"type": "subtitle", "time": 2674.47, "timestamp": "00:44:34", "text": "それが私たちです、それが私たちに"}, {"type": "subtitle", "time": 2677.75, "timestamp": "00:44:37", "text": "ピエロサイト究極の"}, {"type": "subtitle", "time": 2680.47, "timestamp": "00:44:40", "text": "神に復讐するための武器"}, {"type": "subtitle", "time": 2683.03, "timestamp": "00:44:43", "text": "この世界"}, {"type": "subtitle", "time": 2686.95, "timestamp": "00:44:46", "text": "こんにちは、でも、他の誰にもさせません"}, {"type": "subtitle", "time": 2689.75, "timestamp": "00:44:49", "text": "分かるよ、でもそれは私たちの秘密だから"}]
[{"type": "subtitle", "time": 8761.309, "timestamp": "02:26:01", "text": "いつ届くかわかりません"}, {"type": "subtitle", "time": 8763.389, "timestamp": "02:26:03", "text": "マイクは私からとても遠いところにあります"}, {"type": "subtitle", "time": 8768.23, "timestamp": "02:26:08", "text": "ストリームの調子はどうですか？"}, {"type": "subtitle", "time": 8771.59, "timestamp": "02:26:11", "text": "よかった、私たちはたくさんのアイテムを失いました、私は死にました"}, {"type": "subtitle", "time": 8775.63, "timestamp": "02:26:15", "text": "目的 私は目的を失った 私はとても"}, {"type": "subtitle", "time": 8785.95, "timestamp": "02:26:25", "text": "何と言えばいいのか、私はこれを責める"}, {"type": "subtitle", "time": 8787.63, "timestamp": "02:26:27", "text": "男"}, {"type": "subtitle", "time": 8790.03, "timestamp": "02:26:30", "text": "ラグ"}, {"type": "subtitle", "time": 8792.99, "timestamp": "02:26:32", "text": "申し訳ありませんが、"}, {"type": "subtitle", "time": 8796.75, "timestamp": "02:26:36", "text": "物事は、ラグのために進歩したラグです"}, {"type": "subtitle", "time": 8800.11, "timestamp": "02:26:40", "text": "ラグのせいで死んだ"}, {"type": "subtitle", "time": 8802.91, "timestamp": "02:26:42", "text": "自分を救えたはずなのに、あなたはどうしたの？"}, {"type": "subtitle", "time": 8806.99, "timestamp": "02:26:46", "text": "負けるなら教えてあげる"}, {"type": "subtitle", "time": 8810.71, "timestamp": "02:26:50", "text": "リストはあなたに"}, {"type": "subtitle", "time": 8813.63, "timestamp": "02:26:53", "text": "オーケー、どうしたの？"}, {"type": "subtitle", "time": 8816.469, "timestamp": "02:26:56", "text": "みんな"}, {"type": "subtitle", "time": 8819.63, "timestamp": "02:26:59", "text": "一体何で私を殴ったの？"}]
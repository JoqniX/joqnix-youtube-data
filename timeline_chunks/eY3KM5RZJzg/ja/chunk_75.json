[{"type": "subtitle", "time": 4503.83, "timestamp": "01:15:03", "text": "隠し場所を作るはずだったけど、"}, {"type": "subtitle", "time": 4509.629, "timestamp": "01:15:09", "text": "何が起こったのか、ああ"}, {"type": "subtitle", "time": 4516.39, "timestamp": "01:15:16", "text": "ああ、サーバーがラグって、アイスにいたよ"}, {"type": "subtitle", "time": 4520.27, "timestamp": "01:15:20", "text": "ホッキョクグマの家族と一緒に過ごす時間"}, {"type": "subtitle", "time": 4525.07, "timestamp": "01:15:25", "text": "昨日から途中で、そして"}, {"type": "subtitle", "time": 4530.189, "timestamp": "01:15:30", "text": "死んだんだ、どうやって"}, {"type": "subtitle", "time": 4533.59, "timestamp": "01:15:33", "text": "私は水道の蛇口を恥じていた"}, {"type": "subtitle", "time": 4536.79, "timestamp": "01:15:36", "text": "ボードなしで水面をスキップしたので、"}, {"type": "subtitle", "time": 4539.709, "timestamp": "01:15:39", "text": "何度も完璧に"}, {"type": "subtitle", "time": 4541.79, "timestamp": "01:15:41", "text": "偶然、何が起こったのかわかりません"}, {"type": "subtitle", "time": 4543.629, "timestamp": "01:15:43", "text": "氷か何かがあった"}, {"type": "subtitle", "time": 4547.43, "timestamp": "01:15:47", "text": "ブロックしたので、私は何度も落ちました。"}, {"type": "subtitle", "time": 4549.31, "timestamp": "01:15:49", "text": "サーバーは途中でラグを起こしました"}, {"type": "subtitle", "time": 4552.669, "timestamp": "01:15:52", "text": "プロセスを進めようとしたらラグが発生しました"}, {"type": "subtitle", "time": 4555.27, "timestamp": "01:15:55", "text": "ラグが発生して、氷の中に閉じ込められてしまった"}, {"type": "subtitle", "time": 4557.189, "timestamp": "01:15:57", "text": "そしてサーバーが"}, {"type": "subtitle", "time": 4559.59, "timestamp": "01:15:59", "text": "再接続したが、また動けなくなった"}]
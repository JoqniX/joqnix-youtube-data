[{"type": "subtitle", "time": 13868.03, "timestamp": "03:51:08", "text": "ジョー、彼に頼まなくちゃいけないの"}, {"type": "subtitle", "time": 13873.11, "timestamp": "03:51:13", "text": "マグマは、私も十分なトーチを持っている"}, {"type": "subtitle", "time": 13875.03, "timestamp": "03:51:15", "text": "おお、いいね"}, {"type": "subtitle", "time": 13878.229, "timestamp": "03:51:18", "text": "また、"}, {"type": "subtitle", "time": 13881.269, "timestamp": "03:51:21", "text": "スーキと私が出会った洞窟は"}, {"type": "subtitle", "time": 13889.429, "timestamp": "03:51:29", "text": "ああ、昨日のあの洞窟は、"}, {"type": "subtitle", "time": 13892.269, "timestamp": "03:51:32", "text": "あなたが持っているものと似た構造"}, {"type": "subtitle", "time": 13896.469, "timestamp": "03:51:36", "text": "今日は男たちが中にいたよ M ああ、そうだよ ジョー 何"}, {"type": "subtitle", "time": 13901.389, "timestamp": "03:51:41", "text": "他には大丈夫だったのか、採掘を増やすことは？"}, {"type": "subtitle", "time": 13903.51, "timestamp": "03:51:43", "text": "さあ行こう、実際私たちはとても増加している"}, {"type": "subtitle", "time": 13914.269, "timestamp": "03:51:54", "text": "マイニングはしないし、IRを失った。"}, {"type": "subtitle", "time": 13916.229, "timestamp": "03:51:56", "text": "それは何だったか、えっと、採掘の増加は"}, {"type": "subtitle", "time": 13918.67, "timestamp": "03:51:58", "text": "ホールで、私はとても申し訳なく思っています"}, {"type": "subtitle", "time": 13919.81, "timestamp": "03:51:59", "text": "来る"}]
[{"type": "subtitle", "time": 12304.11, "timestamp": "03:25:04", "text": "ウキ、イギリス、次はごめんね、チーム、ごめんね"}, {"type": "subtitle", "time": 12308.75, "timestamp": "03:25:08", "text": "彼を殺して連れ去らなければならないチーム"}, {"type": "subtitle", "time": 12311.99, "timestamp": "03:25:11", "text": "彼の胸当ての胸"}, {"type": "subtitle", "time": 12315.03, "timestamp": "03:25:15", "text": "プレート、どの胸当てを取らなければならないか"}, {"type": "subtitle", "time": 12317.63, "timestamp": "03:25:17", "text": "彼の胸当ては誰があなたに全部話しているの？"}, {"type": "subtitle", "time": 12320.309, "timestamp": "03:25:20", "text": "これらのクエスト"}, {"type": "subtitle", "time": 12322.75, "timestamp": "03:25:22", "text": "えーと、ハビビ"}, {"type": "subtitle", "time": 12326.83, "timestamp": "03:25:26", "text": "男は私に何もくれなかった"}, {"type": "subtitle", "time": 12330.71, "timestamp": "03:25:30", "text": "クエスト 彼から2つのクエストを受け取ったが、"}, {"type": "subtitle", "time": 12333.83, "timestamp": "03:25:33", "text": "クエスト1つ、私は知らないと思う、知らない"}, {"type": "subtitle", "time": 12335.67, "timestamp": "03:25:35", "text": "1日ログインする"}, {"type": "subtitle", "time": 12345.83, "timestamp": "03:25:45", "text": "変わったけど、うん、ハップは眠っているみたい"}, {"type": "subtitle", "time": 12347.07, "timestamp": "03:25:47", "text": "ではない"}, {"type": "subtitle", "time": 12350.07, "timestamp": "03:25:50", "text": "そこには"}, {"type": "subtitle", "time": 12352.349, "timestamp": "03:25:52", "text": "寝ているが、明日彼は来るだろう"}, {"type": "subtitle", "time": 12354.79, "timestamp": "03:25:54", "text": "腐ったものを山ほど彼にあげなきゃ"}, {"type": "subtitle", "time": 12358.189, "timestamp": "03:25:58", "text": "肉体だから、自由に人を殺してください"}]
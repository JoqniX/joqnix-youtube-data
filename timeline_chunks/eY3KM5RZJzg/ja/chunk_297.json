[{"type": "subtitle", "time": 17820.15, "timestamp": "04:57:00", "text": "それはまずいですね。私はいつも忘れてしまいます。"}, {"type": "subtitle", "time": 17821.628, "timestamp": "04:57:01", "text": "私のツイート"}, {"type": "subtitle", "time": 17824.27, "timestamp": "04:57:04", "text": "ライブ配信するときはいつも忘れてしまう"}, {"type": "subtitle", "time": 17826.31, "timestamp": "04:57:06", "text": "今日もまた"}, {"type": "subtitle", "time": 17828.51, "timestamp": "04:57:08", "text": "また忙しい"}, {"type": "subtitle", "time": 17831.39, "timestamp": "04:57:11", "text": "日中、私はこういうことが起こるたびに嫌だった"}, {"type": "subtitle", "time": 17835.19, "timestamp": "04:57:15", "text": "忙しい一日はいつもあなたを"}, {"type": "subtitle", "time": 17838.27, "timestamp": "04:57:18", "text": "疲れたと思うけど、わからない"}, {"type": "subtitle", "time": 17841.83, "timestamp": "04:57:21", "text": "正直言って、疲れた一日だった。"}, {"type": "subtitle", "time": 17845.67, "timestamp": "04:57:25", "text": "本当に疲れた一日だったよ、わかるでしょ"}, {"type": "subtitle", "time": 17851.31, "timestamp": "04:57:31", "text": "だから私はとてもとても忙しかったので、いつ"}, {"type": "subtitle", "time": 17854.39, "timestamp": "04:57:34", "text": "私は配信しているので、正直に言うと最近は"}, {"type": "subtitle", "time": 17856.47, "timestamp": "04:57:36", "text": "よく言ってるよね、"}, {"type": "subtitle", "time": 17858.31, "timestamp": "04:57:38", "text": "私は彼らの"}, {"type": "subtitle", "time": 17863.23, "timestamp": "04:57:43", "text": "ストリーム配信したいと思ってたんだけど"}, {"type": "subtitle", "time": 17866.15, "timestamp": "04:57:46", "text": "できるときは、などなどなど、しかし私は"}, {"type": "subtitle", "time": 17867.868, "timestamp": "04:57:47", "text": "ストリーミングできなくなっていたのは"}, {"type": "subtitle", "time": 17870.27, "timestamp": "04:57:50", "text": "仕事に再び忙しくなり、"}, {"type": "subtitle", "time": 17873.91, "timestamp": "04:57:53", "text": "すべて大丈夫なので、ええと、"}, {"type": "subtitle", "time": 17876.99, "timestamp": "04:57:56", "text": "チュートリアルをプレイしたいですか？はい、プレイしましょう"}]
[{"type": "subtitle", "time": 15240.429, "timestamp": "04:14:00", "text": "何が起こったのか、私が来て配達します"}, {"type": "subtitle", "time": 15243.79, "timestamp": "04:14:03", "text": "商品をあなたに渡したら、私は食べに行くよ。"}, {"type": "subtitle", "time": 15247.349, "timestamp": "04:14:07", "text": "父は物を出しっぱなしにしていた"}, {"type": "subtitle", "time": 15250.269, "timestamp": "04:14:10", "text": "水を入れる必要がある"}, {"type": "subtitle", "time": 15251.389, "timestamp": "04:14:11", "text": "米と"}, {"type": "subtitle", "time": 15254.79, "timestamp": "04:14:14", "text": "明日以外のすべて"}, {"type": "subtitle", "time": 15259.71, "timestamp": "04:14:19", "text": "ええ、私の家はどこですか、私はどこにいますか"}, {"type": "subtitle", "time": 15264.59, "timestamp": "04:14:24", "text": "なぜこれが３なのかなぜ３なのか"}, {"type": "subtitle", "time": 15280.349, "timestamp": "04:14:40", "text": "[音楽]"}, {"type": "subtitle", "time": 15288.55, "timestamp": "04:14:48", "text": "H カスパンは終わりました"}, {"type": "subtitle", "time": 15295.269, "timestamp": "04:14:55", "text": "ここは羊が"}, {"type": "subtitle", "time": 15297.469, "timestamp": "04:14:57", "text": "死ぬほど感謝します"}]
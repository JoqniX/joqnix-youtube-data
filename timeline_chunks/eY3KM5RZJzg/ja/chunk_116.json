[{"type": "subtitle", "time": 6962.149, "timestamp": "01:56:02", "text": "後で分かるよ、うん、つまり私は"}, {"type": "subtitle", "time": 6964.109, "timestamp": "01:56:04", "text": "必ず来ます"}, {"type": "subtitle", "time": 6968.27, "timestamp": "01:56:08", "text": "あの刀は私のための刀です"}, {"type": "subtitle", "time": 6969.189, "timestamp": "01:56:09", "text": "私は好きです"}, {"type": "subtitle", "time": 6971.79, "timestamp": "01:56:11", "text": "それは取引です、それは"}, {"type": "subtitle", "time": 6976.39, "timestamp": "01:56:16", "text": "モデルの依頼をお願いします。ああ、なんてことだ"}, {"type": "subtitle", "time": 6979.47, "timestamp": "01:56:19", "text": "神様待って、何かできることを見つけよう"}, {"type": "subtitle", "time": 6980.91, "timestamp": "01:56:20", "text": "ここはあなたが住んでいる村です"}, {"type": "subtitle", "time": 6984.47, "timestamp": "01:56:24", "text": "今はわからないけど、ただハをshblしただけ"}, {"type": "subtitle", "time": 6987.51, "timestamp": "01:56:27", "text": "泣きながら、"}, {"type": "subtitle", "time": 6990.43, "timestamp": "01:56:30", "text": "ああ、ああ、神様、わかったよ"}, {"type": "subtitle", "time": 6993.229, "timestamp": "01:56:33", "text": "私が見たいのはあなたの"}, {"type": "subtitle", "time": 6997.91, "timestamp": "01:56:37", "text": "在庫すべて、あ、待って"}, {"type": "subtitle", "time": 7000.79, "timestamp": "01:56:40", "text": "胸当てみたいなのを手に入れたけど、"}, {"type": "subtitle", "time": 7003.39, "timestamp": "01:56:43", "text": "以前持っていた胸当てではない"}, {"type": "subtitle", "time": 7007.109, "timestamp": "01:56:47", "text": "何か貴重なものをお持ちですか？"}, {"type": "subtitle", "time": 7009.95, "timestamp": "01:56:49", "text": "貴重なシャベル、これらはすべて金です"}, {"type": "subtitle", "time": 7013.39, "timestamp": "01:56:53", "text": "シャベルや鍬など"}, {"type": "subtitle", "time": 7014.83, "timestamp": "01:56:54", "text": "いや、それは何の役にも立たないよ"}, {"type": "subtitle", "time": 7017.47, "timestamp": "01:56:57", "text": "もし私があなたに火の粉をいくつか与えたらどうしますか？"}]
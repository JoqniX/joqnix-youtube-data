[{"type": "subtitle", "time": 18062.59, "timestamp": "05:01:02", "text": "こんにちは、鍵は何ですか、ああ"}, {"type": "subtitle", "time": 18066.07, "timestamp": "05:01:06", "text": "神よ、私は何から来たのか"}, {"type": "subtitle", "time": 18078.99, "timestamp": "05:01:18", "text": "ああ、公式サーバーは閉鎖される"}, {"type": "subtitle", "time": 18082.43, "timestamp": "05:01:22", "text": "17位ダウン"}, {"type": "subtitle", "time": 18084.19, "timestamp": "05:01:24", "text": "12月"}, {"type": "subtitle", "time": 18087.51, "timestamp": "05:01:27", "text": "どんな言い訳？"}, {"type": "subtitle", "time": 18090.31, "timestamp": "05:01:30", "text": "自分"}, {"type": "subtitle", "time": 18098.83, "timestamp": "05:01:38", "text": "ゲーム"}, {"type": "subtitle", "time": 18101.628, "timestamp": "05:01:41", "text": "え、私騙されたの？"}, {"type": "subtitle", "time": 18104.948, "timestamp": "05:01:44", "text": "今日はああ神様"}, {"type": "subtitle", "time": 18118.23, "timestamp": "05:01:58", "text": "まさかこんなことが起こるとは思ってもみなかった"}]
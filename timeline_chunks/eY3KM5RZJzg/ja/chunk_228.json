[{"type": "subtitle", "time": 13681.95, "timestamp": "03:48:01", "text": "ああ、鉄のハンマーをなくさないでくれ"}, {"type": "subtitle", "time": 13683.95, "timestamp": "03:48:03", "text": "あなたたち二人への私の大切な贈り物、鉄"}, {"type": "subtitle", "time": 13687.07, "timestamp": "03:48:07", "text": "ハンマーと手斧を一生懸命働いた"}, {"type": "subtitle", "time": 13690.99, "timestamp": "03:48:10", "text": "七つの海と待って待ってまず最初に"}, {"type": "subtitle", "time": 13692.75, "timestamp": "03:48:12", "text": "聞いて、聞いて、待って、もし君たちが"}, {"type": "subtitle", "time": 13694.83, "timestamp": "03:48:14", "text": "非常に貴重なもののようなもの"}, {"type": "subtitle", "time": 13697.309, "timestamp": "03:48:17", "text": "ここに置いておくと、私たちは行く"}, {"type": "subtitle", "time": 13699.11, "timestamp": "03:48:19", "text": "どこかにゾンビがいるから"}, {"type": "subtitle", "time": 13701.03, "timestamp": "03:48:21", "text": "死ぬ可能性もあるので、"}, {"type": "subtitle", "time": 13703.189, "timestamp": "03:48:23", "text": "ところで、ところで"}, {"type": "subtitle", "time": 13706.189, "timestamp": "03:48:26", "text": "ソードフィッシュは、"}, {"type": "subtitle", "time": 13709.429, "timestamp": "03:48:29", "text": "ええと、価格の所有権は背面にあります。"}, {"type": "subtitle", "time": 13712.349, "timestamp": "03:48:32", "text": "行かないよね、行かないよね、うんうんうん"}, {"type": "subtitle", "time": 13716.269, "timestamp": "03:48:36", "text": "ええ、だから私は、"}, {"type": "subtitle", "time": 13720.189, "timestamp": "03:48:40", "text": "ダイヤモンド、カタナ、私は一生懸命働いた"}, {"type": "subtitle", "time": 13723.229, "timestamp": "03:48:43", "text": "彼のパンツのために、私が彼に言った瞬間"}, {"type": "subtitle", "time": 13730.95, "timestamp": "03:48:50", "text": "何何何、ああカシンは怒った"}, {"type": "subtitle", "time": 13732.95, "timestamp": "03:48:52", "text": "私が彼にあなたが"}, {"type": "subtitle", "time": 13734.99, "timestamp": "03:48:54", "text": "魔法の準備ができています"}, {"type": "subtitle", "time": 13737.229, "timestamp": "03:48:57", "text": "剣よ、ああ"}]
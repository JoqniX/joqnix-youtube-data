[{"type": "subtitle", "time": 4202.35, "timestamp": "01:10:02", "text": "デモ えーと、恵みが失われた"}, {"type": "subtitle", "time": 4211.39, "timestamp": "01:10:11", "text": "しかし、Ser は実行されていますが、"}, {"type": "subtitle", "time": 4214.31, "timestamp": "01:10:14", "text": "残り15分、15分以上"}, {"type": "subtitle", "time": 4215.83, "timestamp": "01:10:15", "text": "10分くらいかな、わからない。"}, {"type": "subtitle", "time": 4216.49, "timestamp": "01:10:16", "text": "どうやって"}, {"type": "subtitle", "time": 4221.189, "timestamp": "01:10:21", "text": "[笑い]"}, {"type": "subtitle", "time": 4224.229, "timestamp": "01:10:24", "text": "私が「ああ、そうだった、君だった」と言った時"}, {"type": "subtitle", "time": 4234.59, "timestamp": "01:10:34", "text": "神はあなたのpHを創造しました"}, {"type": "subtitle", "time": 4236.35, "timestamp": "01:10:36", "text": "もの"}, {"type": "subtitle", "time": 4239.189, "timestamp": "01:10:39", "text": "彼ができない"}, {"type": "subtitle", "time": 4242.55, "timestamp": "01:10:42", "text": "彼が私の物を見つける方法を見つける方法を見つける"}, {"type": "subtitle", "time": 4243.83, "timestamp": "01:10:43", "text": "真ん中"}, {"type": "subtitle", "time": 4246.229, "timestamp": "01:10:46", "text": "私は人里離れた場所にいた"}, {"type": "subtitle", "time": 4249.189, "timestamp": "01:10:49", "text": "氷河期の誓いのように、"}, {"type": "subtitle", "time": 4257.99, "timestamp": "01:10:57", "text": "なぜ私はこんなに"}]
[{"type": "subtitle", "time": 1320.35, "timestamp": "00:22:00", "text": "来て、私は良い弓使いが必要です"}, {"type": "subtitle", "time": 1323.35, "timestamp": "00:22:03", "text": "良い弓が必要だ。良い引き弓が必要だ。"}, {"type": "subtitle", "time": 1326.95, "timestamp": "00:22:06", "text": "奴らを殺せ、あれは何だったんだ、あれは"}, {"type": "subtitle", "time": 1328.909, "timestamp": "00:22:08", "text": "恥ずかしい"}, {"type": "subtitle", "time": 1331.149, "timestamp": "00:22:11", "text": "でもこんにちは"}, {"type": "subtitle", "time": 1335.149, "timestamp": "00:22:15", "text": "本日のバックスター第2号"}, {"type": "subtitle", "time": 1339.51, "timestamp": "00:22:19", "text": "クエスト、さあ行こう、準備は万端だ"}, {"type": "subtitle", "time": 1344.75, "timestamp": "00:22:24", "text": "転がる、ああ神様、私は死ぬところだった、とにかく"}, {"type": "subtitle", "time": 1347.549, "timestamp": "00:22:27", "text": "まっすぐ進む必要がある 私は"}, {"type": "subtitle", "time": 1349.63, "timestamp": "00:22:29", "text": "ボートが必要です"}, {"type": "subtitle", "time": 1351.99, "timestamp": "00:22:31", "text": "ボートを作る必要がある"}, {"type": "subtitle", "time": 1355.51, "timestamp": "00:22:35", "text": "木材を手に入れる"}, {"type": "subtitle", "time": 1359.35, "timestamp": "00:22:39", "text": "時間が止まったように感じる"}, {"type": "subtitle", "time": 1361.549, "timestamp": "00:22:41", "text": "何が起こっているのか分からない場所"}, {"type": "subtitle", "time": 1362.75, "timestamp": "00:22:42", "text": "これ"}, {"type": "chat", "time": 1363.754, "timestamp": "00:22:43", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "Minecraft"}, {"type": "subtitle", "time": 1365.71, "timestamp": "00:22:45", "text": "世界で、もしかしたら彼女の答えが見つかるかもしれない"}, {"type": "subtitle", "time": 1369.11, "timestamp": "00:22:49", "text": "SC を増やせば増やすほど"}]
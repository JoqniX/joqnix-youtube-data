[{"type": "subtitle", "time": 10517.15, "timestamp": "02:55:17", "text": "こんにちは、あのクリーパーは爆発しました"}, {"type": "subtitle", "time": 10523.349, "timestamp": "02:55:23", "text": "私、いや、ああ神様、私は私と一緒にいると思います"}, {"type": "subtitle", "time": 10526.75, "timestamp": "02:55:26", "text": "ここです、私と一緒に来てください、いいえ、私たちは"}, {"type": "subtitle", "time": 10530.03, "timestamp": "02:55:30", "text": "ウェイベイビー、以前はこうだったのに"}, {"type": "subtitle", "time": 10534.269, "timestamp": "02:55:34", "text": "あなたのすぐ後ろに懐中電灯が見える"}, {"type": "subtitle", "time": 10535.91, "timestamp": "02:55:35", "text": "ライト"}, {"type": "subtitle", "time": 10540.469, "timestamp": "02:55:40", "text": "おいおいおいおいおい"}]
[{"type": "subtitle", "time": 4449.59, "timestamp": "01:14:09", "text": "いいえ、私は自分自身をドローンで撮影したいのです。"}, {"type": "subtitle", "time": 4452.59, "timestamp": "01:14:12", "text": "わからないよ"}, {"type": "subtitle", "time": 4455.87, "timestamp": "01:14:15", "text": "あなたは何について"}, {"type": "subtitle", "time": 4460.47, "timestamp": "01:14:20", "text": "たくさんのものを失った パンを失った"}, {"type": "subtitle", "time": 4462.55, "timestamp": "01:14:22", "text": "ベビーベッド I"}, {"type": "subtitle", "time": 4466.03, "timestamp": "01:14:26", "text": "失ったけど、私は何かを失った"}, {"type": "subtitle", "time": 4467.83, "timestamp": "01:14:27", "text": "それは貴重だった"}, {"type": "subtitle", "time": 4470.11, "timestamp": "01:14:30", "text": "私のために"}, {"type": "subtitle", "time": 4472.83, "timestamp": "01:14:32", "text": "輝かしい目的のために旅をする私は"}, {"type": "subtitle", "time": 4476.709, "timestamp": "01:14:36", "text": "最後まで持っていくはずだったのに"}, {"type": "subtitle", "time": 4478.95, "timestamp": "01:14:38", "text": "本当はそうするつもりじゃなかったけど、それでも私は"}, {"type": "subtitle", "time": 4480.51, "timestamp": "01:14:40", "text": "それを私と一緒に持っていた"}, {"type": "subtitle", "time": 4483.669, "timestamp": "01:14:43", "text": "だって、この世界はいつ何が起こるかわからないから"}, {"type": "subtitle", "time": 4488.35, "timestamp": "01:14:48", "text": "君は後ろにいる、後ろにいる、待って、私に"}, {"type": "subtitle", "time": 4490.91, "timestamp": "01:14:50", "text": "V がいつになるかわからないのでリフレッシュしてください"}, {"type": "subtitle", "time": 4493.95, "timestamp": "01:14:53", "text": "反撃してくる可能性がある、それが"}, {"type": "subtitle", "time": 4496.669, "timestamp": "01:14:56", "text": "起こった"}, {"type": "subtitle", "time": 4499.07, "timestamp": "01:14:59", "text": "それを秘密の隠し場所に保管していたわけではありません。"}]
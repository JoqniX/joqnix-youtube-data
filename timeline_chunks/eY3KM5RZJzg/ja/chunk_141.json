[{"type": "subtitle", "time": 8462.46, "timestamp": "02:21:02", "text": "チャットでこんにちは、コン、何ですか"}, {"type": "subtitle", "time": 8471.15, "timestamp": "02:21:11", "text": "アップコン、ああ神様、これは怖い、これは"}, {"type": "subtitle", "time": 8486.07, "timestamp": "02:21:26", "text": "おお"}, {"type": "subtitle", "time": 8489.83, "timestamp": "02:21:29", "text": "ああ、死なないで"}, {"type": "subtitle", "time": 8492.71, "timestamp": "02:21:32", "text": "はいはい、私は私は"}, {"type": "subtitle", "time": 8497.469, "timestamp": "02:21:37", "text": "はい、はい、行き詰まっていますか、あなたの色"}, {"type": "subtitle", "time": 8499.75, "timestamp": "02:21:39", "text": "アイテム、どこにいるの？見えるよ、君は"}, {"type": "subtitle", "time": 8502.389, "timestamp": "02:21:42", "text": "ストリーミング"}, {"type": "subtitle", "time": 8505.309, "timestamp": "02:21:45", "text": "うん、Tするよ"}, {"type": "subtitle", "time": 8508.429, "timestamp": "02:21:48", "text": "見えないカーディアンがどこにあるか"}, {"type": "subtitle", "time": 8512.71, "timestamp": "02:21:52", "text": "エンジェルカードは、実際に行き詰まっていました"}, {"type": "subtitle", "time": 8515.23, "timestamp": "02:21:55", "text": "当時もああ、それは"}, {"type": "subtitle", "time": 8518.309, "timestamp": "02:21:58", "text": "これは豪邸だ、なんてことだ、私たちは見つけた"}]
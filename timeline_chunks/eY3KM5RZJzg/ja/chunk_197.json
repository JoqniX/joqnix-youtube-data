[{"type": "subtitle", "time": 11822.67, "timestamp": "03:17:02", "text": "彼がそうしないように気をつけなければならない"}, {"type": "subtitle", "time": 11826.189, "timestamp": "03:17:06", "text": "邪悪なこと、例えば基地を爆破すること、そして"}, {"type": "subtitle", "time": 11829.309, "timestamp": "03:17:09", "text": "私たちのアイテムがなくなるか何か"}, {"type": "subtitle", "time": 11831.03, "timestamp": "03:17:11", "text": "地下組織を作る必要があると思う"}, {"type": "subtitle", "time": 11833.87, "timestamp": "03:17:13", "text": "秘密のトンネルみたいなもの、もしくは見たい"}, {"type": "subtitle", "time": 11837.189, "timestamp": "03:17:17", "text": "えーっと、私たちの物を安全に保つために、本当に"}, {"type": "subtitle", "time": 11840.67, "timestamp": "03:17:20", "text": "重要なこと"}, {"type": "subtitle", "time": 11849.95, "timestamp": "03:17:29", "text": "今日は、まあ、56くらいあったんだけど"}, {"type": "subtitle", "time": 11853.07, "timestamp": "03:17:33", "text": "いいね、そしてそれはすべて、それは消えてしまった"}, {"type": "subtitle", "time": 11856.63, "timestamp": "03:17:36", "text": "すべてが過ぎ去ってしまった、ああ"}, {"type": "subtitle", "time": 11861.71, "timestamp": "03:17:41", "text": "神様、アメリカに伝えよう、魚に伝えよう"}, {"type": "subtitle", "time": 11865.469, "timestamp": "03:17:45", "text": "うん、ここから受け取るよ。"}, {"type": "subtitle", "time": 11870.15, "timestamp": "03:17:50", "text": "優しく、オーケー、では"}, {"type": "subtitle", "time": 11873.11, "timestamp": "03:17:53", "text": "この場所から出て行け Hはどこにいる"}]
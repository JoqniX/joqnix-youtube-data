[{"type": "subtitle", "time": 8824.59, "timestamp": "02:27:04", "text": "そして私の生命力、ああ神様、ああ神様"}, {"type": "subtitle", "time": 8828.15, "timestamp": "02:27:08", "text": "彼が戻ってきたよ、オーケー、えっと、こんにちは、あなたは、あなたは"}, {"type": "subtitle", "time": 8830.79, "timestamp": "02:27:10", "text": "えーと"}, {"type": "subtitle", "time": 8833.83, "timestamp": "02:27:13", "text": "剣、どの剣、鉄の剣、SW、ああそうだ"}, {"type": "subtitle", "time": 8835.55, "timestamp": "02:27:15", "text": "その剣には剣が欠けている"}, {"type": "subtitle", "time": 8839.19, "timestamp": "02:27:19", "text": "約束したけど、全部は手に入らなかった"}, {"type": "subtitle", "time": 8840.95, "timestamp": "02:27:20", "text": "はい、はい、えっと"}, {"type": "subtitle", "time": 8843.469, "timestamp": "02:27:23", "text": "あと2、いや3つ足りない"}, {"type": "subtitle", "time": 8845.87, "timestamp": "02:27:25", "text": "エメラルドは"}, {"type": "subtitle", "time": 8849.11, "timestamp": "02:27:29", "text": "私に右、オーケー、何、何"}, {"type": "subtitle", "time": 8853.63, "timestamp": "02:27:33", "text": "大丈夫、私は唯一の"}, {"type": "subtitle", "time": 8856.99, "timestamp": "02:27:36", "text": "手でどれくらいのダメージを与えたか教えてください"}, {"type": "subtitle", "time": 8858.469, "timestamp": "02:27:38", "text": "もう一度やってみて、そのまま"}, {"type": "subtitle", "time": 8861.07, "timestamp": "02:27:41", "text": "2.5または1.5で"}, {"type": "subtitle", "time": 8862.83, "timestamp": "02:27:42", "text": "うん、1.5、1.5だと思う"}, {"type": "subtitle", "time": 8865.99, "timestamp": "02:27:45", "text": "手をRするだけ、うん、ああ、君は"}, {"type": "subtitle", "time": 8868.07, "timestamp": "02:27:48", "text": "強力なフルアーマー、ところでなぜ"}, {"type": "subtitle", "time": 8871.03, "timestamp": "02:27:51", "text": "なぜフィンポーズのように感じるのか"}, {"type": "subtitle", "time": 8878.71, "timestamp": "02:27:58", "text": "病気"}]
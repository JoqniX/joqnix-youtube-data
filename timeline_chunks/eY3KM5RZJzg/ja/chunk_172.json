[{"type": "subtitle", "time": 10320.51, "timestamp": "02:52:00", "text": "図書館、または砂糖から作ることができます"}, {"type": "subtitle", "time": 10322.99, "timestamp": "02:52:02", "text": "杖は正しい、いや待って"}, {"type": "subtitle", "time": 10325.63, "timestamp": "02:52:05", "text": "ページを忘れて"}, {"type": "subtitle", "time": 10327.74, "timestamp": "02:52:07", "text": "革のページまたは"}, {"type": "subtitle", "time": 10329.03, "timestamp": "02:52:09", "text": "[音楽]"}, {"type": "subtitle", "time": 10332.99, "timestamp": "02:52:12", "text": "革、ああ、待つ必要がある、あなたは"}, {"type": "subtitle", "time": 10335.469, "timestamp": "02:52:15", "text": "私についてきて。何かを見せていたんだ。"}, {"type": "subtitle", "time": 10339.03, "timestamp": "02:52:19", "text": "そして私は忘れた"}, {"type": "subtitle", "time": 10341.469, "timestamp": "02:52:21", "text": "それは正しい方法ではないと思います。飛び降りないでください。"}, {"type": "subtitle", "time": 10344.91, "timestamp": "02:52:24", "text": "それは違う、そう、私たちは通過した、私たちは"}, {"type": "subtitle", "time": 10346.59, "timestamp": "02:52:26", "text": "私はそこを通り過ぎた"}, {"type": "subtitle", "time": 10349.309, "timestamp": "02:52:29", "text": "そうですね、それは間違いなく"}, {"type": "subtitle", "time": 10352.469, "timestamp": "02:52:32", "text": "魚はどこにいるの？食べ物はある？"}, {"type": "subtitle", "time": 10354.67, "timestamp": "02:52:34", "text": "ああ、まただ"}, {"type": "subtitle", "time": 10357.469, "timestamp": "02:52:37", "text": "敵とは？"}, {"type": "subtitle", "time": 10359.51, "timestamp": "02:52:39", "text": "敵"}, {"type": "subtitle", "time": 10366.469, "timestamp": "02:52:46", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 10375.11, "timestamp": "02:52:55", "text": "おお"}]
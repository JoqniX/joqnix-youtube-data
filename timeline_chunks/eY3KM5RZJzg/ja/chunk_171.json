[{"type": "subtitle", "time": 10272.87, "timestamp": "02:51:12", "text": "はい、私はスカーにいます"}, {"type": "subtitle", "time": 10294.71, "timestamp": "02:51:34", "text": "しまった、この私を忘れてた"}, {"type": "subtitle", "time": 10298.469, "timestamp": "02:51:38", "text": "ジョーを忘れた"}, {"type": "subtitle", "time": 10306.269, "timestamp": "02:51:46", "text": "来る"}, {"type": "subtitle", "time": 10310.03, "timestamp": "02:51:50", "text": "はい、本を集めるにはどうすればいいですか？"}, {"type": "subtitle", "time": 10314.87, "timestamp": "02:51:54", "text": "本は、本を持っていた。"}, {"type": "subtitle", "time": 10316.71, "timestamp": "02:51:56", "text": "見つける"}]
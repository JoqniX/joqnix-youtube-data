[{"type": "subtitle", "time": 8100.189, "timestamp": "02:15:00", "text": "ああ、そうそう、そこは私の場所だ"}, {"type": "subtitle", "time": 8103.47, "timestamp": "02:15:03", "text": "ああ、こっちに来て、こっちに来て、こっちに来て"}, {"type": "subtitle", "time": 8106.47, "timestamp": "02:15:06", "text": "ここであなたはすべてを作った"}, {"type": "subtitle", "time": 8109.75, "timestamp": "02:15:09", "text": "うん、そうだね"}, {"type": "subtitle", "time": 8113.35, "timestamp": "02:15:13", "text": "たくさん学んだし、たくさん見たよ"}, {"type": "subtitle", "time": 8117.31, "timestamp": "02:15:17", "text": "この動画を見ると、"}, {"type": "subtitle", "time": 8119.109, "timestamp": "02:15:19", "text": "で"}, {"type": "subtitle", "time": 8122.549, "timestamp": "02:15:22", "text": "これは、これは空っぽです。私たちは、"}, {"type": "subtitle", "time": 8124.79, "timestamp": "02:15:24", "text": "行かなければならない"}, {"type": "subtitle", "time": 8127.709, "timestamp": "02:15:27", "text": "問題は、どうすればいいのかわからないということです"}, {"type": "subtitle", "time": 8130.75, "timestamp": "02:15:30", "text": "どうやって上るか 私は下に行くことはできますが、"}, {"type": "subtitle", "time": 8134.83, "timestamp": "02:15:34", "text": "ゾンビがいるよ M こんにちは はい はい はい"}, {"type": "subtitle", "time": 8136.88, "timestamp": "02:15:36", "text": "ええ、ゾンビがいます"}, {"type": "subtitle", "time": 8138.629, "timestamp": "02:15:38", "text": "[音楽]"}, {"type": "subtitle", "time": 8143.589, "timestamp": "02:15:43", "text": "そう、注意する必要がある"}, {"type": "subtitle", "time": 8147.31, "timestamp": "02:15:47", "text": "ああ、私が守ってあげる"}, {"type": "subtitle", "time": 8152.31, "timestamp": "02:15:52", "text": "ああ、ああ、いやいや、死なないで、食べて"}, {"type": "subtitle", "time": 8154.99, "timestamp": "02:15:54", "text": "食べて食べて食べて食べてジャンプしないで"}, {"type": "subtitle", "time": 8159.39, "timestamp": "02:15:59", "text": "ジャンプして下へ降りて戻る 戻る 戻る 戻る"}]
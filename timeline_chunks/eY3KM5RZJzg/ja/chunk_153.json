[{"type": "subtitle", "time": 9181.67, "timestamp": "02:33:01", "text": "2 ありがとう 収集してくれてありがとう"}, {"type": "subtitle", "time": 9185.19, "timestamp": "02:33:05", "text": "失くしたので泣いていました"}, {"type": "subtitle", "time": 9188.07, "timestamp": "02:33:08", "text": "すべてはネザライトブーツだった"}, {"type": "subtitle", "time": 9191.79, "timestamp": "02:33:11", "text": "君のものだった、うん、全部私のものだったよ、わかった"}, {"type": "subtitle", "time": 9195.83, "timestamp": "02:33:15", "text": "聞いて、ジョジョ、そう、殺せるなら"}, {"type": "subtitle", "time": 9198.75, "timestamp": "02:33:18", "text": "ドラグンは彼の言うことを聞かないで、彼は騙している"}, {"type": "subtitle", "time": 9207.95, "timestamp": "02:33:27", "text": "破壊しなければならない世界"}, {"type": "subtitle", "time": 9215.19, "timestamp": "02:33:35", "text": "うん、できるかどうかわからないけど、できるかどうか"}, {"type": "subtitle", "time": 9218.87, "timestamp": "02:33:38", "text": "ドラガーを​​殺せば、君にあげるよ"}, {"type": "subtitle", "time": 9220.309, "timestamp": "02:33:40", "text": "個人的に報酬をあげます"}, {"type": "subtitle", "time": 9222.03, "timestamp": "02:33:42", "text": "報酬は何ですか？教えてください"}, {"type": "subtitle", "time": 9224.19, "timestamp": "02:33:44", "text": "報酬は、殺せばどうなるか分かるよね"}, {"type": "subtitle", "time": 9226.51, "timestamp": "02:33:46", "text": "ドラッグすると彼の胸当てを保持できます"}, {"type": "subtitle", "time": 9229.19, "timestamp": "02:33:49", "text": "彼の胸当ては素敵ですね"}, {"type": "subtitle", "time": 9230.83, "timestamp": "02:33:50", "text": "ダイヤモンドがプレイ"}, {"type": "subtitle", "time": 9234.349, "timestamp": "02:33:54", "text": "診断担当者が着用している"}, {"type": "subtitle", "time": 9238.23, "timestamp": "02:33:58", "text": "えっと、それは何？何て言ってるの？"}]
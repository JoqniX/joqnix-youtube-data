[{"type": "subtitle", "time": 7381.83, "timestamp": "02:03:01", "text": "こんにちは、ジョー、こんにちは、私はあなたに4つあげます"}, {"type": "subtitle", "time": 7383.79, "timestamp": "02:03:03", "text": "5つのピース"}, {"type": "subtitle", "time": 7385.83, "timestamp": "02:03:05", "text": "TNT"}, {"type": "subtitle", "time": 7388.709, "timestamp": "02:03:08", "text": "こんにちは、ジョーが取引をしました、ジョックが取引をしました"}, {"type": "subtitle", "time": 7392.709, "timestamp": "02:03:12", "text": "トレードOK待ってOKこんにちは私は"}, {"type": "subtitle", "time": 7395.629, "timestamp": "02:03:15", "text": "TNT 4 個と、"}, {"type": "subtitle", "time": 7398.39, "timestamp": "02:03:18", "text": "犬はどこにいるか、犬はどこにいるか、そして彼らは"}, {"type": "subtitle", "time": 7402.03, "timestamp": "02:03:22", "text": "家の周りをうろうろする必要がある"}, {"type": "subtitle", "time": 7405.35, "timestamp": "02:03:25", "text": "家を傷つける必要はありません"}, {"type": "subtitle", "time": 7415.189, "timestamp": "02:03:35", "text": "ここでは大丈夫、ただ実現させればいい"}, {"type": "subtitle", "time": 7418.91, "timestamp": "02:03:38", "text": "とにかく実現させて、さあ、やってみて"}, {"type": "subtitle", "time": 7422.149, "timestamp": "02:03:42", "text": "待って、どこに案内すればいいの？"}, {"type": "subtitle", "time": 7425.87, "timestamp": "02:03:45", "text": "入れたけど入れたかったんだけど、いやいや"}, {"type": "subtitle", "time": 7428.75, "timestamp": "02:03:48", "text": "そんなに遠くないよ、アイコンはどこ？"}, {"type": "subtitle", "time": 7432.189, "timestamp": "02:03:52", "text": "いいえ、私はあなたです、それは全体です"}, {"type": "subtitle", "time": 7434.75, "timestamp": "02:03:54", "text": "私の家では魔女を殺したかった"}, {"type": "subtitle", "time": 7437.069, "timestamp": "02:03:57", "text": "しかし、こちらでは、近い方が良い"}, {"type": "subtitle", "time": 7439.51, "timestamp": "02:03:59", "text": "あなたの家へ、さあCH、私の話を聞いてCH"}]
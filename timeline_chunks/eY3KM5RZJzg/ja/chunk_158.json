[{"type": "subtitle", "time": 9485.15, "timestamp": "02:38:05", "text": "他に何があったか"}, {"type": "subtitle", "time": 9487.83, "timestamp": "02:38:07", "text": "何が起こったのか、これも"}, {"type": "subtitle", "time": 9491.389, "timestamp": "02:38:11", "text": "君のミツキ、あのアンカーをくれ"}, {"type": "subtitle", "time": 9493.51, "timestamp": "02:38:13", "text": "ブレードバック、ラインを渡します"}, {"type": "subtitle", "time": 9496.91, "timestamp": "02:38:16", "text": "あなたが私にくれるもの、あなたが持っているもの"}, {"type": "subtitle", "time": 9500.269, "timestamp": "02:38:20", "text": "錨の刃があなたに"}, {"type": "subtitle", "time": 9501.79, "timestamp": "02:38:21", "text": "うん"}, {"type": "subtitle", "time": 9506.63, "timestamp": "02:38:26", "text": "待って、兄弟、彼らは私のものより本当に少ないです、いいえ、それは"}, {"type": "subtitle", "time": 9510.51, "timestamp": "02:38:30", "text": "どこへ行ったの？いや、ここにあるよ"}, {"type": "subtitle", "time": 9513.51, "timestamp": "02:38:33", "text": "これは、はい、返してください。"}, {"type": "subtitle", "time": 9522.51, "timestamp": "02:38:42", "text": "鉄、あ、ごめん"}, {"type": "subtitle", "time": 9524.04, "timestamp": "02:38:44", "text": "ごめん 偶然にOK"}, {"type": "subtitle", "time": 9525.92, "timestamp": "02:38:45", "text": "偶然にOK あー、次はこれだよ、取りに行って"}, {"type": "subtitle", "time": 9530.76, "timestamp": "02:38:50", "text": "あー、次はこれだよ、取りに行って オーケー、ラピスラズリは私の物じゃない、"}, {"type": "subtitle", "time": 9535.16, "timestamp": "02:38:55", "text": "オーケー、ラピスラズリは私の物じゃない、 あなたのものかな、わかった、待って、私が選ぶよ"}, {"type": "subtitle", "time": 9538.279, "timestamp": "02:38:58", "text": "あなたのものかな、わかった、待って、私が選ぶよ それを上げて、それを落とす"}]
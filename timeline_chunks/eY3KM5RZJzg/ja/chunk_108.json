[{"type": "subtitle", "time": 6494.149, "timestamp": "01:48:14", "text": "メッセージは食事に行く限界です"}, {"type": "subtitle", "time": 6498.669, "timestamp": "01:48:18", "text": "夕食H、どうすれば平和に食事ができるだろうか"}, {"type": "subtitle", "time": 6500.149, "timestamp": "01:48:20", "text": "この時点で夕食を抜きたい"}, {"type": "subtitle", "time": 6505.109, "timestamp": "01:48:25", "text": "それ"}, {"type": "subtitle", "time": 6507.79, "timestamp": "01:48:27", "text": "人生最悪"}, {"type": "subtitle", "time": 6512.39, "timestamp": "01:48:32", "text": "最悪だ、いい感じなのに、私はすべてを失った、いい感じ"}]
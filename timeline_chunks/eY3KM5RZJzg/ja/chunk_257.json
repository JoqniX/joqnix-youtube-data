[{"type": "subtitle", "time": 15422.469, "timestamp": "04:17:02", "text": "バウンスして待って、2つを組み合わせることができるので"}, {"type": "subtitle", "time": 15426.55, "timestamp": "04:17:06", "text": "跳ね返りや横移動で人を押し出す"}, {"type": "subtitle", "time": 15428.71, "timestamp": "04:17:08", "text": "待って"}, {"type": "subtitle", "time": 15435.269, "timestamp": "04:17:15", "text": "あなたは"}, {"type": "subtitle", "time": 15437.99, "timestamp": "04:17:17", "text": "シールドは彼です"}, {"type": "subtitle", "time": 15440.99, "timestamp": "04:17:20", "text": "泳いでいます。はい、何をしていますか？"}, {"type": "subtitle", "time": 15442.189, "timestamp": "04:17:22", "text": "できる"}, {"type": "subtitle", "time": 15444.03, "timestamp": "04:17:24", "text": "泳ぐ、うん、それは"}, {"type": "subtitle", "time": 15454.03, "timestamp": "04:17:34", "text": "わかった、ちょっと待って、自分の声が聞こえる"}, {"type": "subtitle", "time": 15456.55, "timestamp": "04:17:36", "text": "そうですね、なぜなら"}, {"type": "subtitle", "time": 15459.149, "timestamp": "04:17:39", "text": "私は"}, {"type": "subtitle", "time": 15461.469, "timestamp": "04:17:41", "text": "私の"}, {"type": "subtitle", "time": 15465.429, "timestamp": "04:17:45", "text": "ほら、この辺りを見たの覚えてるよ"}, {"type": "subtitle", "time": 15468.389, "timestamp": "04:17:48", "text": "いやいや、これは違う、それは"}, {"type": "subtitle", "time": 15471.87, "timestamp": "04:17:51", "text": "桜の場所みたいに、えーと"}, {"type": "subtitle", "time": 15474.59, "timestamp": "04:17:54", "text": "ああ、桜はどこにあるんだろう"}, {"type": "subtitle", "time": 15476.67, "timestamp": "04:17:56", "text": "ああ、なんてことだ"}]
[{"type": "subtitle", "time": 4563.55, "timestamp": "01:16:03", "text": "最初は遅れていて、そうそう"}, {"type": "subtitle", "time": 4570.629, "timestamp": "01:16:10", "text": "Oは、あなたがどの方向にいたかです。"}, {"type": "subtitle", "time": 4573.07, "timestamp": "01:16:13", "text": "わからない、私が知っているのは、それはまるで"}, {"type": "subtitle", "time": 4574.83, "timestamp": "01:16:14", "text": "氷のバイオームまたは"}, {"type": "subtitle", "time": 4577.47, "timestamp": "01:16:17", "text": "シロクマとかが描かれたもの"}, {"type": "subtitle", "time": 4581.59, "timestamp": "01:16:21", "text": "昨日の最初の"}, {"type": "subtitle", "time": 4584.51, "timestamp": "01:16:24", "text": "ミッションでは、子供が一人いるはずです。"}, {"type": "subtitle", "time": 4585.79, "timestamp": "01:16:25", "text": "クマと"}, {"type": "subtitle", "time": 4602.07, "timestamp": "01:16:42", "text": "すでに"}, {"type": "subtitle", "time": 4618.55, "timestamp": "01:16:58", "text": "でも、サーバーがラグってるみたい"}]
[{"type": "subtitle", "time": 13560.55, "timestamp": "03:46:00", "text": "そっちの方が見栄えがいいよ、いや、私は"}, {"type": "subtitle", "time": 13563.75, "timestamp": "03:46:03", "text": "何かありますか？あ、待って、ダイヤモンド"}, {"type": "subtitle", "time": 13566.149, "timestamp": "03:46:06", "text": "青い鎧はあなたを癒します"}, {"type": "subtitle", "time": 13568.87, "timestamp": "03:46:08", "text": "髪待って、私は追加の鎧を持っています"}, {"type": "subtitle", "time": 13570.469, "timestamp": "03:46:10", "text": "ズボン待って、あげる"}, {"type": "subtitle", "time": 13573.95, "timestamp": "03:46:13", "text": "あなた、魚さん、手伝ってくれますか？"}, {"type": "subtitle", "time": 13575.71, "timestamp": "03:46:15", "text": "私の失われた"}, {"type": "subtitle", "time": 13579.309, "timestamp": "03:46:19", "text": "ああ、それを終わらせて、私は食事に行けるよ"}, {"type": "subtitle", "time": 13582.0, "timestamp": "03:46:22", "text": "夕食を急いで済ませていない"}, {"type": "subtitle", "time": 13583.79, "timestamp": "03:46:23", "text": "[音楽]"}, {"type": "subtitle", "time": 13588.03, "timestamp": "03:46:28", "text": "しかし、今日はお腹が痛くて何も食べられません"}, {"type": "subtitle", "time": 13590.51, "timestamp": "03:46:30", "text": "今回私が思うINDは"}, {"type": "subtitle", "time": 13593.83, "timestamp": "03:46:33", "text": "再び強くなった、オーケー、みんなが何をしたか"}, {"type": "subtitle", "time": 13598.309, "timestamp": "03:46:38", "text": "今日はそんな感じだったよね"}, {"type": "subtitle", "time": 13601.269, "timestamp": "03:46:41", "text": "魔法さえも、ああ魔法さえも、私は送る"}, {"type": "subtitle", "time": 13606.389, "timestamp": "03:46:46", "text": "DMグループでチームチーム"}, {"type": "subtitle", "time": 13610.55, "timestamp": "03:46:50", "text": "ユキン、いや、そこにはないよ。送ったよ。"}, {"type": "subtitle", "time": 13613.269, "timestamp": "03:46:53", "text": "サーバーではないのはなぜですか？"}, {"type": "subtitle", "time": 13616.149, "timestamp": "03:46:56", "text": "グループの中に DM が 1 人いて、"}, {"type": "subtitle", "time": 13619.07, "timestamp": "03:46:59", "text": "あなたが送ったと想像してください。いいえ、私が送りました"}]
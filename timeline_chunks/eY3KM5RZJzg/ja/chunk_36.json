[{"type": "subtitle", "time": 2161.829, "timestamp": "00:36:01", "text": "彼女は私が任務を遂行することを知らない"}, {"type": "subtitle", "time": 2163.2, "timestamp": "00:36:03", "text": "この復讐"}, {"type": "subtitle", "time": 2172.19, "timestamp": "00:36:12", "text": "世界よ、ああ神様、私は何をすればいいの？彼女が"}, {"type": "subtitle", "time": 2174.23, "timestamp": "00:36:14", "text": "私が"}, {"type": "subtitle", "time": 2177.309, "timestamp": "00:36:17", "text": "オンラインか何かで、私は"}, {"type": "subtitle", "time": 2179.75, "timestamp": "00:36:19", "text": "彼らがどんな感じか想像できるよ"}, {"type": "subtitle", "time": 2183.39, "timestamp": "00:36:23", "text": "私を暗闇のようにして、ヴァル、あなた、または"}, {"type": "subtitle", "time": 2186.67, "timestamp": "00:36:26", "text": "ゲーム内でダーク、次はヴァル、君と私はこんな感じ"}, {"type": "subtitle", "time": 2188.51, "timestamp": "00:36:28", "text": "私は任務中だ"}]
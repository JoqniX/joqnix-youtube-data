[{"type": "subtitle", "time": 13500.75, "timestamp": "03:45:00", "text": "必要だ、あ、待って待って、あなたの"}, {"type": "subtitle", "time": 13502.91, "timestamp": "03:45:02", "text": "ところで、ツルハシを倒す必要がある"}, {"type": "subtitle", "time": 13505.59, "timestamp": "03:45:05", "text": "ゾンビ"}, {"type": "subtitle", "time": 13510.469, "timestamp": "03:45:10", "text": "剣、こんにちは、ええ、ええ、私はここにいます、ええ"}, {"type": "subtitle", "time": 13513.79, "timestamp": "03:45:13", "text": "君たちは君たちを必要としている、君たちは殺さなければならない"}, {"type": "subtitle", "time": 13515.83, "timestamp": "03:45:15", "text": "ゾンビと、そしてすべてが"}, {"type": "subtitle", "time": 13518.87, "timestamp": "03:45:18", "text": "男たちは剣と"}, {"type": "subtitle", "time": 13521.83, "timestamp": "03:45:21", "text": "つるはし、誰かが私の鉄を盗んだ"}, {"type": "subtitle", "time": 13534.99, "timestamp": "03:45:34", "text": "アイロンをかけると、ズボンが冷たくなります。"}, {"type": "subtitle", "time": 13538.07, "timestamp": "03:45:38", "text": "そしてあなたは"}, {"type": "subtitle", "time": 13541.75, "timestamp": "03:45:41", "text": "ジョーカーを見つけた"}, {"type": "subtitle", "time": 13544.229, "timestamp": "03:45:44", "text": "大丈夫、待って、えっと、何、何を"}, {"type": "subtitle", "time": 13546.429, "timestamp": "03:45:46", "text": "鉄が必要なら、鉄をあげられるよ。"}, {"type": "subtitle", "time": 13549.75, "timestamp": "03:45:49", "text": "鉄24個あります。ちょっと待ってください。"}, {"type": "subtitle", "time": 13552.469, "timestamp": "03:45:52", "text": "ほら、これを受け取って、何が起こるか分かるでしょ"}, {"type": "subtitle", "time": 13554.229, "timestamp": "03:45:54", "text": "見た目がいいですね"}, {"type": "subtitle", "time": 13557.87, "timestamp": "03:45:57", "text": "ズキの金の胸当てとダイヤモンドのズボン"}]
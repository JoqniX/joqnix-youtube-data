[{"type": "subtitle", "time": 7560.79, "timestamp": "02:06:00", "text": "ジョー、取引内容を教えてくれ。取引内容は？"}, {"type": "subtitle", "time": 7563.709, "timestamp": "02:06:03", "text": "私は苦労して築き上げてきた全てを失った"}, {"type": "subtitle", "time": 7566.87, "timestamp": "02:06:06", "text": "昨日の旅のすべて"}, {"type": "subtitle", "time": 7568.709, "timestamp": "02:06:08", "text": "毎シーズン、そして私が失ったものすべて"}, {"type": "subtitle", "time": 7571.35, "timestamp": "02:06:11", "text": "今日私が死んだのは、"}, {"type": "subtitle", "time": 7575.35, "timestamp": "02:06:15", "text": "サーバーの不具合でサーバーが私を殺した"}, {"type": "subtitle", "time": 7578.229, "timestamp": "02:06:18", "text": "ええ、実際はそうだったので、私はとても落ち込んでいました"}, {"type": "subtitle", "time": 7579.03, "timestamp": "02:06:19", "text": "そして"}, {"type": "subtitle", "time": 7582.149, "timestamp": "02:06:22", "text": "クエストを失って悲しい"}, {"type": "subtitle", "time": 7583.35, "timestamp": "02:06:23", "text": "私の"}, {"type": "subtitle", "time": 7586.47, "timestamp": "02:06:26", "text": "あなたとザキを守る目的で"}, {"type": "subtitle", "time": 7589.39, "timestamp": "02:06:29", "text": "すべて、そして私は孤独で、私は"}, {"type": "subtitle", "time": 7591.109, "timestamp": "02:06:31", "text": "歩き回る"}, {"type": "subtitle", "time": 7593.79, "timestamp": "02:06:33", "text": "どこに行っても泣いてる、だって負けたから"}, {"type": "subtitle", "time": 7596.549, "timestamp": "02:06:36", "text": "すべて、そしてこの男は取引のためにやってきた"}, {"type": "subtitle", "time": 7600.27, "timestamp": "02:06:40", "text": "そして、私は戻ることができると言いました。"}, {"type": "subtitle", "time": 7604.35, "timestamp": "02:06:44", "text": "良い剣、OP剣のようなもの"}, {"type": "subtitle", "time": 7607.87, "timestamp": "02:06:47", "text": "それはいいことだよ、うん、そしてそれは"}, {"type": "subtitle", "time": 7609.75, "timestamp": "02:06:49", "text": "私が失くした剣よりも良いものをください"}, {"type": "subtitle", "time": 7610.91, "timestamp": "02:06:50", "text": "支払金の一部"}, {"type": "subtitle", "time": 7612.31, "timestamp": "02:06:52", "text": "エメラルド"}, {"type": "subtitle", "time": 7614.75, "timestamp": "02:06:54", "text": "あなたには何も返さないけれど、"}, {"type": "subtitle", "time": 7616.79, "timestamp": "02:06:56", "text": "エメラルドを取った"}]
[{"type": "subtitle", "time": 13997.71, "timestamp": "03:53:17", "text": "続けてください。わかりました。あの、聞き忘れていました。"}, {"type": "subtitle", "time": 14001.189, "timestamp": "03:53:21", "text": "私はアイロンを手に入れませんでした"}, {"type": "subtitle", "time": 14006.55, "timestamp": "03:53:26", "text": "つるはしと待って、ああ、それらを失くした"}, {"type": "subtitle", "time": 14006.88, "timestamp": "03:53:26", "text": "右"}, {"type": "subtitle", "time": 14008.469, "timestamp": "03:53:28", "text": "[音楽]"}, {"type": "subtitle", "time": 14015.229, "timestamp": "03:53:35", "text": "ああ、わかった"}, {"type": "subtitle", "time": 14017.71, "timestamp": "03:53:37", "text": "ああ、ありがとう、私はつるはしです"}, {"type": "subtitle", "time": 14020.349, "timestamp": "03:53:40", "text": "了解しました、ありがとうございます。えっと、それで、ベールは"}, {"type": "subtitle", "time": 14023.55, "timestamp": "03:53:43", "text": "ヘルメットのスライドが胸に当たる"}, {"type": "subtitle", "time": 14026.83, "timestamp": "03:53:46", "text": "うん、そう思うよ。ああ、そうだね。"}, {"type": "subtitle", "time": 14029.229, "timestamp": "03:53:49", "text": "クリーパーは死んで、今それを探索した。"}, {"type": "subtitle", "time": 14031.95, "timestamp": "03:53:51", "text": "ああ、それらのアイテムはなくなってしまったので、ええ、ゴールド"}, {"type": "subtitle", "time": 14035.67, "timestamp": "03:53:55", "text": "胸当て金色のズボンと金色の"}, {"type": "subtitle", "time": 14038.91, "timestamp": "03:53:58", "text": "ボード、金の胸当て、ちょうど"}]
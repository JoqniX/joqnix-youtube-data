[{"type": "subtitle", "time": 4692.47, "timestamp": "01:18:12", "text": "私自身も時々それが辛い"}, {"type": "subtitle", "time": 4696.07, "timestamp": "01:18:16", "text": "君だけど、理解する必要があるんだ"}, {"type": "subtitle", "time": 4698.87, "timestamp": "01:18:18", "text": "私たちみんなが間違いを犯すように、これは"}, {"type": "subtitle", "time": 4701.51, "timestamp": "01:18:21", "text": "愚かな間違いだった、それは私のものでさえなかった"}, {"type": "subtitle", "time": 4705.27, "timestamp": "01:18:25", "text": "私の側が文字通りタップしたのが間違いでした"}, {"type": "subtitle", "time": 4709.43, "timestamp": "01:18:29", "text": "エイペックスのように水に苦労している"}, {"type": "subtitle", "time": 4713.55, "timestamp": "01:18:33", "text": "バカ、私は周りでもとても注意していたのに"}, {"type": "subtitle", "time": 4716.55, "timestamp": "01:18:36", "text": "こういう場所では、真っ直ぐに罠を仕掛けるだけだ"}, {"type": "subtitle", "time": 4720.27, "timestamp": "01:18:40", "text": "こういう場所"}, {"type": "subtitle", "time": 4722.51, "timestamp": "01:18:42", "text": "草原で遊ぶはずだった"}, {"type": "subtitle", "time": 4725.83, "timestamp": "01:18:45", "text": "今は安全だとわかっているので、絶対にタップしないでください。"}, {"type": "subtitle", "time": 4728.43, "timestamp": "01:18:48", "text": "絶対にタップしないでください"}, {"type": "subtitle", "time": 4737.35, "timestamp": "01:18:57", "text": "私はズームのスピードで動いていた"}, {"type": "subtitle", "time": 4738.709, "timestamp": "01:18:58", "text": "フラッシュ"}]
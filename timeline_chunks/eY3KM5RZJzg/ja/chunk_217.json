[{"type": "subtitle", "time": 13023.09, "timestamp": "03:37:03", "text": "バカを去る"}, {"type": "subtitle", "time": 13030.309, "timestamp": "03:37:10", "text": "彼女はあなたを殺しただけでなく、"}, {"type": "subtitle", "time": 13033.269, "timestamp": "03:37:13", "text": "キルで得た経験値も奪った"}, {"type": "subtitle", "time": 13043.95, "timestamp": "03:37:23", "text": "あなたを知ってからまだ3年しか経っていないのに"}, {"type": "subtitle", "time": 13046.63, "timestamp": "03:37:26", "text": "マイナス年マイナス4"}, {"type": "subtitle", "time": 13048.55, "timestamp": "03:37:28", "text": "数年"}, {"type": "subtitle", "time": 13051.63, "timestamp": "03:37:31", "text": "なぜかわからないけど、"}, {"type": "subtitle", "time": 13053.83, "timestamp": "03:37:33", "text": "たとえそれが4年間あなたを知っていても"}, {"type": "subtitle", "time": 13056.91, "timestamp": "03:37:36", "text": "ズキはまだ３日しか経ってないけど、それはそれなの？"}, {"type": "subtitle", "time": 13058.309, "timestamp": "03:37:38", "text": "待って、彼女は何者？"}, {"type": "subtitle", "time": 13061.75, "timestamp": "03:37:41", "text": "「ああ、もうそうなってるよ」って言ったら、"}, {"type": "subtitle", "time": 13063.429, "timestamp": "03:37:43", "text": "キャスをここに呼び寄せたい"}, {"type": "subtitle", "time": 13065.55, "timestamp": "03:37:45", "text": "皆さんにお会いしましょう"}, {"type": "subtitle", "time": 13068.91, "timestamp": "03:37:48", "text": "いいえ、私たちはここには見知らぬ人を入れません"}, {"type": "subtitle", "time": 13071.63, "timestamp": "03:37:51", "text": "そうだ、彼をここに連れてくるよ、いやいや"}, {"type": "subtitle", "time": 13074.07, "timestamp": "03:37:54", "text": "それは狂ってる、私たちは望んでいない"}]
[{"type": "subtitle", "time": 9000.99, "timestamp": "02:30:00", "text": "みんな、はいはい、クエストを受け取れるかな？"}, {"type": "subtitle", "time": 9003.51, "timestamp": "02:30:03", "text": "戻る まだ終わらせなければならない"}, {"type": "subtitle", "time": 9007.07, "timestamp": "02:30:07", "text": "えっと、あのね、ジョー、DMして"}, {"type": "subtitle", "time": 9008.67, "timestamp": "02:30:08", "text": "アイテムをすぐにお渡しします"}, {"type": "subtitle", "time": 9012.03, "timestamp": "02:30:12", "text": "L のせいで、おそらく"}, {"type": "subtitle", "time": 9014.269, "timestamp": "02:30:14", "text": "水曜日に直します。"}, {"type": "subtitle", "time": 9017.309, "timestamp": "02:30:17", "text": "今日やるけど、明日は試験だから"}, {"type": "subtitle", "time": 9018.51, "timestamp": "02:30:18", "text": "一種の"}, {"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "ところで忙しいところで、ええ、私は"}, {"type": "subtitle", "time": 9024.389, "timestamp": "02:30:24", "text": "あなたにとって別の取引は非常に"}, {"type": "subtitle", "time": 9026.23, "timestamp": "02:30:26", "text": "儲かる商売、今あなたはそれが何であるかを知っている"}, {"type": "subtitle", "time": 9029.59, "timestamp": "02:30:29", "text": "魚に送ると多くのものを失いました"}, {"type": "subtitle", "time": 9031.71, "timestamp": "02:30:31", "text": "彼にあげられるアイテム、ああ、私は"}, {"type": "subtitle", "time": 9034.83, "timestamp": "02:30:34", "text": "彼に道具を与えたが、魔法は"}, {"type": "subtitle", "time": 9037.389, "timestamp": "02:30:37", "text": "いや、ただ彼に"}, {"type": "subtitle", "time": 9040.63, "timestamp": "02:30:40", "text": "エンチャントテーブルのようにエンチャントします。"}, {"type": "subtitle", "time": 9043.83, "timestamp": "02:30:43", "text": "何か、DM で送って、または、"}, {"type": "subtitle", "time": 9047.19, "timestamp": "02:30:47", "text": "Discordのメッセージセクションで"}, {"type": "subtitle", "time": 9048.95, "timestamp": "02:30:48", "text": "明日までに届けますよ、いいですか？"}, {"type": "subtitle", "time": 9052.23, "timestamp": "02:30:52", "text": "明日も手に入れるよ、私もわからない"}, {"type": "subtitle", "time": 9055.03, "timestamp": "02:30:55", "text": "誰の戦利品だったのか、スライドが見える、"}, {"type": "subtitle", "time": 9058.429, "timestamp": "02:30:58", "text": "取って、そう、取って、それは"}]
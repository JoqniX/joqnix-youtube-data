[{"type": "subtitle", "time": 7441.669, "timestamp": "02:04:01", "text": "私の言うことを聞いて、この男の言うことは聞かないで"}, {"type": "subtitle", "time": 7444.589, "timestamp": "02:04:04", "text": "何をしているの？何をしているの？"}, {"type": "subtitle", "time": 7445.91, "timestamp": "02:04:05", "text": "失った"}, {"type": "subtitle", "time": 7449.51, "timestamp": "02:04:09", "text": "彼が行った取引のすべて"}, {"type": "subtitle", "time": 7451.669, "timestamp": "02:04:11", "text": "彼は取引をしたので、もう止めることはできない"}, {"type": "subtitle", "time": 7457.149, "timestamp": "02:04:17", "text": "ごめん、彼はトレードをしたんだ、ジョー"}, {"type": "subtitle", "time": 7461.99, "timestamp": "02:04:21", "text": "ジョーさん、TNTを置いてください。"}, {"type": "subtitle", "time": 7465.27, "timestamp": "02:04:25", "text": "ジョック、こっちに来て。ジョジョ、来て。"}, {"type": "subtitle", "time": 7469.43, "timestamp": "02:04:29", "text": "ほら、私がやる前にやってよ、ジョー、来て"}, {"type": "subtitle", "time": 7473.149, "timestamp": "02:04:33", "text": "ジョー、ちょっと待って、聞いてみて。"}, {"type": "subtitle", "time": 7479.069, "timestamp": "02:04:39", "text": "私、こんにちは、何をしたの、何をしたの？"}, {"type": "subtitle", "time": 7482.27, "timestamp": "02:04:42", "text": "失う、私に物があると言って、いいえ私は"}, {"type": "subtitle", "time": 7489.069, "timestamp": "02:04:49", "text": "あ、待って待って待って、忘れてた"}, {"type": "subtitle", "time": 7492.83, "timestamp": "02:04:52", "text": "16個のエメラルドを2つお渡しできます"}, {"type": "subtitle", "time": 7494.95, "timestamp": "02:04:54", "text": "足りないよ、あ、持ってるよ、持ってるよ"}, {"type": "subtitle", "time": 7498.149, "timestamp": "02:04:58", "text": "いや、そうだ、持ってるよ、取って、取って"}]
[{"type": "subtitle", "time": 15663.389, "timestamp": "04:21:03", "text": "神聖"}, {"type": "subtitle", "time": 15666.87, "timestamp": "04:21:06", "text": "主よ、でもおおよその時間はどれくらいですか？"}, {"type": "subtitle", "time": 15671.389, "timestamp": "04:21:11", "text": "墓とか何かのために"}, {"type": "subtitle", "time": 15674.389, "timestamp": "04:21:14", "text": "アスラが何をすべきか修正してください"}, {"type": "subtitle", "time": 15677.59, "timestamp": "04:21:17", "text": "彼は変わってるのかな、アスラ"}, {"type": "subtitle", "time": 15679.95, "timestamp": "04:21:19", "text": "クリーパー、クリーパー、クリーパーを探している"}, {"type": "subtitle", "time": 15688.55, "timestamp": "04:21:28", "text": "大丈夫 IR アスラ イルム アスラ 調べています"}, {"type": "subtitle", "time": 15691.79, "timestamp": "04:21:31", "text": "だから私はそれが何なのか知らない"}, {"type": "subtitle", "time": 15693.95, "timestamp": "04:21:33", "text": "計画は立てましたが、あなたのメッセージは送信済みです"}, {"type": "subtitle", "time": 15696.95, "timestamp": "04:21:36", "text": "私の友人が私に教えてくれたような改造について"}, {"type": "subtitle", "time": 15699.95, "timestamp": "04:21:39", "text": "これはバニラ版マインクラフトの中にあります"}, {"type": "subtitle", "time": 15701.309, "timestamp": "04:21:41", "text": "それでは"}, {"type": "subtitle", "time": 15712.91, "timestamp": "04:21:52", "text": "視覚を使えることは分かっていますよね"}, {"type": "subtitle", "time": 15717.03, "timestamp": "04:21:57", "text": "待って、でもそれを自分の中に留めておくと、私は"}]
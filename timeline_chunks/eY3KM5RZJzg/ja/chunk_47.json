[{"type": "subtitle", "time": 2826.23, "timestamp": "00:47:06", "text": "こんにちは、えっと、私は何でしたっけ"}, {"type": "subtitle", "time": 2830.309, "timestamp": "00:47:10", "text": "栄光の使命を果たす"}, {"type": "subtitle", "time": 2833.75, "timestamp": "00:47:13", "text": "目的 私は滑空している"}, {"type": "subtitle", "time": 2836.549, "timestamp": "00:47:16", "text": "狂人だけど、気をつけないと"}, {"type": "subtitle", "time": 2840.27, "timestamp": "00:47:20", "text": "いや、やらないで、ジンクスに陥らないで、いや、いや"}, {"type": "subtitle", "time": 2848.39, "timestamp": "00:47:28", "text": "こんにちは、海の時間はありません"}, {"type": "subtitle", "time": 2852.109, "timestamp": "00:47:32", "text": "海賊船が見つかれば、"}, {"type": "subtitle", "time": 2854.87, "timestamp": "00:47:34", "text": "海賊エリアを探索したり、"}, {"type": "subtitle", "time": 2876.67, "timestamp": "00:47:56", "text": "ああ、他にもたくさんのV INDオンライン"}, {"type": "subtitle", "time": 2879.27, "timestamp": "00:47:59", "text": "Chunがロードされていません。ロードされました。"}]
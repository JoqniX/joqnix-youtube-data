[{"type": "subtitle", "time": 9600.03, "timestamp": "02:40:00", "text": "嫉妬深いズキには、彼女を磨く権利がある"}, {"type": "subtitle", "time": 9601.15, "timestamp": "02:40:01", "text": "挽くことができる"}, {"type": "subtitle", "time": 9603.349, "timestamp": "02:40:03", "text": "しかし彼女はどこにいても"}, {"type": "subtitle", "time": 9605.79, "timestamp": "02:40:05", "text": "あなたたち二人は物語を追わなければならない"}, {"type": "subtitle", "time": 9608.99, "timestamp": "02:40:08", "text": "さあ、物語ができました"}, {"type": "subtitle", "time": 9612.67, "timestamp": "02:40:12", "text": "ライン ああ、なんてことだ 私は"}, {"type": "subtitle", "time": 9615.99, "timestamp": "02:40:15", "text": "怖がってるDN、もう彼女が指を鳴らす音が聞こえる"}, {"type": "subtitle", "time": 9618.91, "timestamp": "02:40:18", "text": "くそっ、チャド、これが彼女のやり方だ"}, {"type": "subtitle", "time": 9622.07, "timestamp": "02:40:22", "text": "おやつチャットチャット保存チャット#"}, {"type": "subtitle", "time": 9625.03, "timestamp": "02:40:25", "text": "メカジキは無邪気です"}, {"type": "subtitle", "time": 9629.83, "timestamp": "02:40:29", "text": "チャットああ神様待って、この素材がある"}, {"type": "subtitle", "time": 9632.55, "timestamp": "02:40:32", "text": "誰が誰の素材なのかこれは"}, {"type": "subtitle", "time": 9634.99, "timestamp": "02:40:34", "text": "ダメだよ、ラピス、待って、やり方を教えてあげる"}, {"type": "subtitle", "time": 9637.79, "timestamp": "02:40:37", "text": "うまくいった、あ、待って、これは私のものだ、私が集めたものだ"}, {"type": "subtitle", "time": 9640.71, "timestamp": "02:40:40", "text": "ええ、その仕組みをお見せします"}, {"type": "subtitle", "time": 9655.71, "timestamp": "02:40:55", "text": "ええ、ちょっと待ってください。あの"}]
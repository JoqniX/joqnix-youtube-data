[{"type": "subtitle", "time": 12661.87, "timestamp": "03:31:01", "text": "アイデアは、私が一日中病気だったとき、"}, {"type": "subtitle", "time": 12666.15, "timestamp": "03:31:06", "text": "戻ってきたら何か悪いことが分かった"}, {"type": "subtitle", "time": 12673.67, "timestamp": "03:31:13", "text": "私は落ちた 私はあなたを信用できない兄弟 なぜ"}, {"type": "subtitle", "time": 12677.87, "timestamp": "03:31:17", "text": "なんで、ああ神様、なんでこのポスターみたいなの"}, {"type": "subtitle", "time": 12679.67, "timestamp": "03:31:19", "text": "私は対処しています"}, {"type": "subtitle", "time": 12682.91, "timestamp": "03:31:22", "text": "今日は一日中落ち込んでいたんだ"}, {"type": "subtitle", "time": 12685.91, "timestamp": "03:31:25", "text": "いいえ、このゲームでは私は落ち込んでいました。"}, {"type": "subtitle", "time": 12689.15, "timestamp": "03:31:29", "text": "今日何が起こったのか私は"}, {"type": "subtitle", "time": 12692.15, "timestamp": "03:31:32", "text": "私のクエストを終えてミツキのところへ行き、"}, {"type": "subtitle", "time": 12694.229, "timestamp": "03:31:34", "text": "彼女の採掘やその他すべてを手伝ってあげて"}, {"type": "subtitle", "time": 12696.189, "timestamp": "03:31:36", "text": "クエストは"}, {"type": "subtitle", "time": 12698.469, "timestamp": "03:31:38", "text": "方法"}, {"type": "subtitle", "time": 12702.67, "timestamp": "03:31:42", "text": "クエストは何について話しているのか"}, {"type": "subtitle", "time": 12705.95, "timestamp": "03:31:45", "text": "誰もが目的と使命を持っている"}, {"type": "subtitle", "time": 12710.15, "timestamp": "03:31:50", "text": "いいえ、私は何も持っていません、私は何も持っていません、なぜ"}, {"type": "subtitle", "time": 12714.189, "timestamp": "03:31:54", "text": "私たち二人ともクエストをもらったんじゃないの？"}, {"type": "subtitle", "time": 12717.55, "timestamp": "03:31:57", "text": "それで、クエストが始まりました。"}]
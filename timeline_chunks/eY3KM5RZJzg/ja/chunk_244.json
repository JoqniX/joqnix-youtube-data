[{"type": "subtitle", "time": 14642.389, "timestamp": "04:04:02", "text": "スポーン ああ、わかった、わかった。君たちはアーマーを持っている"}, {"type": "subtitle", "time": 14643.83, "timestamp": "04:04:03", "text": "私はしません"}, {"type": "subtitle", "time": 14647.59, "timestamp": "04:04:07", "text": "いい武器を持ってるね"}, {"type": "subtitle", "time": 14650.03, "timestamp": "04:04:10", "text": "カタナはどんな"}, {"type": "subtitle", "time": 14654.229, "timestamp": "04:04:14", "text": "鎧、つまり私はちゃんと持っていた、あ、待って"}, {"type": "subtitle", "time": 14657.51, "timestamp": "04:04:17", "text": "待たせてください"}, {"type": "subtitle", "time": 14660.03, "timestamp": "04:04:20", "text": "こんにちは、こんにちは、皆さん、すみません、すみません"}, {"type": "subtitle", "time": 14662.83, "timestamp": "04:04:22", "text": "すみません、皆さん聞こえますか？はい、"}, {"type": "subtitle", "time": 14664.03, "timestamp": "04:04:24", "text": "聞こえる"}, {"type": "subtitle", "time": 14668.79, "timestamp": "04:04:28", "text": "ええ、私は自分の"}, {"type": "subtitle", "time": 14671.51, "timestamp": "04:04:31", "text": "人々はどうやら耳が聞こえないようだ"}, {"type": "subtitle", "time": 14673.51, "timestamp": "04:04:33", "text": "自分"}, {"type": "subtitle", "time": 14677.189, "timestamp": "04:04:37", "text": "えっと、わかった、わかった、ごめん、ごめん、行こう、行こう"}, {"type": "subtitle", "time": 14678.71, "timestamp": "04:04:38", "text": "さあ行こう"}, {"type": "subtitle", "time": 14681.309, "timestamp": "04:04:41", "text": "声について話している"}, {"type": "subtitle", "time": 14682.11, "timestamp": "04:04:42", "text": "あなたの"}, {"type": "subtitle", "time": 14686.03, "timestamp": "04:04:46", "text": "私の頭の中の声"}, {"type": "subtitle", "time": 14688.95, "timestamp": "04:04:48", "text": "[音楽]"}, {"type": "subtitle", "time": 14693.309, "timestamp": "04:04:53", "text": "頭が正しい C 今すぐ寝る必要がある"}, {"type": "subtitle", "time": 14695.79, "timestamp": "04:04:55", "text": "あなたは何者ですか"}, {"type": "subtitle", "time": 14699.75, "timestamp": "04:04:59", "text": "動物が見えるかどうか確認する"}]
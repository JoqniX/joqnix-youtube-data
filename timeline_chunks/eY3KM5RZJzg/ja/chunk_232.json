[{"type": "subtitle", "time": 13921.11, "timestamp": "03:52:01", "text": "[音楽]"}, {"type": "subtitle", "time": 13924.79, "timestamp": "03:52:04", "text": "えっと、私が送ったノートを送ります"}, {"type": "subtitle", "time": 13927.91, "timestamp": "03:52:07", "text": "その物には、そこには何もない"}, {"type": "subtitle", "time": 13930.99, "timestamp": "03:52:10", "text": "採掘量を増やすようなことはしない"}, {"type": "subtitle", "time": 13933.95, "timestamp": "03:52:13", "text": "効率性、そうそうそう効率性"}, {"type": "subtitle", "time": 13935.59, "timestamp": "03:52:15", "text": "うん、わかってるよ"}, {"type": "subtitle", "time": 13940.349, "timestamp": "03:52:20", "text": "あ、ごめんなさい、私が作ったのはこれです"}, {"type": "subtitle", "time": 13942.91, "timestamp": "03:52:22", "text": "効率"}, {"type": "subtitle", "time": 13945.349, "timestamp": "03:52:25", "text": "ああああ"}, {"type": "subtitle", "time": 13949.03, "timestamp": "03:52:29", "text": "効率性とシルクタッチ"}, {"type": "subtitle", "time": 13952.55, "timestamp": "03:52:32", "text": "このシルクタッチを正しく"}, {"type": "subtitle", "time": 13954.67, "timestamp": "03:52:34", "text": "もの"}, {"type": "subtitle", "time": 13957.51, "timestamp": "03:52:37", "text": "シャベル ジョー 私はベッドの上でジャンプしています"}, {"type": "subtitle", "time": 13960.63, "timestamp": "03:52:40", "text": "靴を履いていないのに靴を履いている"}, {"type": "subtitle", "time": 13969.389, "timestamp": "03:52:49", "text": "ああ、ああ、ああ、ああ"}, {"type": "subtitle", "time": 13974.79, "timestamp": "03:52:54", "text": "神様、私の荷物を届けてください、みんな"}]
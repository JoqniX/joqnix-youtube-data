[{"type": "subtitle", "time": 10861.71, "timestamp": "03:01:01", "text": "そして健康を取り戻すか、"}, {"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "何か"}, {"type": "subtitle", "time": 10865.63, "timestamp": "03:01:05", "text": "いいえ、あなたの"}, {"type": "subtitle", "time": 10867.95, "timestamp": "03:01:07", "text": "健康を取り戻したように、軽い気持ちで入らずに"}, {"type": "subtitle", "time": 10869.75, "timestamp": "03:01:09", "text": "だから食べ物を食べたり寝たりすると"}, {"type": "subtitle", "time": 10873.349, "timestamp": "03:01:13", "text": "寝る時間を思い出させる時間ではなく"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "クエストを完了する必要がある"}, {"type": "subtitle", "time": 10878.67, "timestamp": "03:01:18", "text": "今日はクエストの日だった"}, {"type": "subtitle", "time": 10881.83, "timestamp": "03:01:21", "text": "明日行くよ、何か持ってるから"}, {"type": "subtitle", "time": 10883.469, "timestamp": "03:01:23", "text": "手に持っているのですが、使い方がわかりません"}, {"type": "subtitle", "time": 10886.15, "timestamp": "03:01:26", "text": "それはダイヤモンドブロックです"}, {"type": "subtitle", "time": 10888.229, "timestamp": "03:01:28", "text": "ダイヤモンドブロックは鉄と一緒に採掘されます"}, {"type": "subtitle", "time": 10890.83, "timestamp": "03:01:30", "text": "つるはし 鉄のつるはし 持っていません"}, {"type": "subtitle", "time": 10892.07, "timestamp": "03:01:32", "text": "アイロン"}, {"type": "subtitle", "time": 10895.309, "timestamp": "03:01:35", "text": "つるはし、そうするけど、できないけど、"}, {"type": "subtitle", "time": 10905.55, "timestamp": "03:01:45", "text": "これはダメ、今は私のもの、今は私のもの"}, {"type": "subtitle", "time": 10908.79, "timestamp": "03:01:48", "text": "はい、どうぞ"}, {"type": "subtitle", "time": 10909.63, "timestamp": "03:01:49", "text": "私は手に入れた"}, {"type": "subtitle", "time": 10914.229, "timestamp": "03:01:54", "text": "待って、あなたはそれを手に入れた、私のダイヤモンドをちょうだい"}]
[{"type": "subtitle", "time": 15721.95, "timestamp": "04:22:01", "text": "ただし、背中に背負っていれば"}, {"type": "subtitle", "time": 15723.67, "timestamp": "04:22:03", "text": "失くしたくないけど、失くしたくない"}, {"type": "subtitle", "time": 15727.309, "timestamp": "04:22:07", "text": "私のダイヤモンドの刀は私に与えることができます、または私は"}, {"type": "subtitle", "time": 15729.03, "timestamp": "04:22:09", "text": "私に武器を与えてくれるものが必要"}, {"type": "subtitle", "time": 15733.429, "timestamp": "04:22:13", "text": "無料の食べ物、火の効果か何か"}, {"type": "subtitle", "time": 15736.59, "timestamp": "04:22:16", "text": "君ならできるよ、待って、えっと、できる？"}, {"type": "subtitle", "time": 15740.03, "timestamp": "04:22:20", "text": "火事でサイトをアップグレードできますか"}, {"type": "subtitle", "time": 15743.389, "timestamp": "04:22:23", "text": "あなたと一緒に試せる要素"}, {"type": "subtitle", "time": 15745.91, "timestamp": "04:22:25", "text": "追加すると、今すぐ追加して待つことができます"}, {"type": "subtitle", "time": 15749.189, "timestamp": "04:22:29", "text": "魔法は本当にそうであるべきだ"}, {"type": "subtitle", "time": 15752.429, "timestamp": "04:22:32", "text": "試してみよう"}, {"type": "subtitle", "time": 15756.59, "timestamp": "04:22:36", "text": "はい、私のサイトは私のサイトは"}, {"type": "subtitle", "time": 15760.309, "timestamp": "04:22:40", "text": "ホーム ああ、なんてことだ、わかった、待って、私は"}, {"type": "subtitle", "time": 15764.03, "timestamp": "04:22:44", "text": "いくつか"}, {"type": "subtitle", "time": 15767.229, "timestamp": "04:22:47", "text": "私のサイトで試してみましょう"}, {"type": "subtitle", "time": 15772.67, "timestamp": "04:22:52", "text": "えーと"}]
[{"type": "subtitle", "time": 9125.15, "timestamp": "02:32:05", "text": "さあ行こう、それは君たちの心を奪った、そう、それは"}, {"type": "subtitle", "time": 9127.95, "timestamp": "02:32:07", "text": "私の心を奪った、それはとてもクールだ、ああそうだ"}, {"type": "subtitle", "time": 9131.469, "timestamp": "02:32:11", "text": "ジョック ジョック はい、私はとても R トレードを持っています"}, {"type": "subtitle", "time": 9133.11, "timestamp": "02:32:13", "text": "これは座標だと思った"}, {"type": "subtitle", "time": 9135.23, "timestamp": "02:32:15", "text": "診断ベース それはむしろ"}, {"type": "subtitle", "time": 9137.389, "timestamp": "02:32:17", "text": "どちらかというと、何て言うんだっけ、えーと、コンパスみたいな感じかな。"}, {"type": "subtitle", "time": 9140.07, "timestamp": "02:32:20", "text": "よし、これを君にあげるよ"}, {"type": "subtitle", "time": 9141.349, "timestamp": "02:32:21", "text": "とても安い価格です。いくら払えますか？"}, {"type": "subtitle", "time": 9144.269, "timestamp": "02:32:24", "text": "腐った肉、何をするの？"}, {"type": "subtitle", "time": 9148.11, "timestamp": "02:32:28", "text": "腐った肉を持っているが、"}, {"type": "subtitle", "time": 9150.87, "timestamp": "02:32:30", "text": "問題は、私は持っているはずなのに"}, {"type": "subtitle", "time": 9153.75, "timestamp": "02:32:33", "text": "クエスト保留中 私はそうではありません"}, {"type": "subtitle", "time": 9155.99, "timestamp": "02:32:35", "text": "とされるもの"}, {"type": "subtitle", "time": 9157.83, "timestamp": "02:32:37", "text": "2番"}, {"type": "subtitle", "time": 9162.59, "timestamp": "02:32:42", "text": "うん、私は持ってる、私は持ってる"}, {"type": "subtitle", "time": 9164.71, "timestamp": "02:32:44", "text": "私の"}, {"type": "subtitle", "time": 9170.87, "timestamp": "02:32:50", "text": "持っています"}, {"type": "subtitle", "time": 9172.83, "timestamp": "02:32:52", "text": "聞いて、聞いて、わかった、もう一度あげるよ"}, {"type": "subtitle", "time": 9174.71, "timestamp": "02:32:54", "text": "クエスト、もう一つ出題します"}, {"type": "subtitle", "time": 9178.03, "timestamp": "02:32:58", "text": "2番目 2番目"}]
[{"type": "subtitle", "time": 8880.79, "timestamp": "02:28:00", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 8883.75, "timestamp": "02:28:03", "text": "神よ、いや"}, {"type": "subtitle", "time": 8886.75, "timestamp": "02:28:06", "text": "彼女はどこにいたのか"}, {"type": "subtitle", "time": 8890.389, "timestamp": "02:28:10", "text": "彼女はどこで死んだのか、どこで死んだのか"}, {"type": "subtitle", "time": 8892.63, "timestamp": "02:28:12", "text": "死ね、それを1つくらいもらえますか？"}, {"type": "subtitle", "time": 8895.15, "timestamp": "02:28:15", "text": "2番目に試してみたいのですが、"}, {"type": "subtitle", "time": 8897.95, "timestamp": "02:28:17", "text": "あなたの心、そう、あなたの心は"}, {"type": "subtitle", "time": 8900.71, "timestamp": "02:28:20", "text": "多くの心が再生する"}, {"type": "subtitle", "time": 8903.15, "timestamp": "02:28:23", "text": "ああ、神様、私を殺そうとするなんて"}, {"type": "subtitle", "time": 8906.71, "timestamp": "02:28:26", "text": "どうやって手に入れるか"}, {"type": "subtitle", "time": 8911.23, "timestamp": "02:28:31", "text": "再生って、ああ、なんてことだ"}, {"type": "subtitle", "time": 8928.23, "timestamp": "02:28:48", "text": "いいえ、アイテムはなくなりました。"}, {"type": "subtitle", "time": 8931.07, "timestamp": "02:28:51", "text": "下には、ああ、わかった、わかった、いいよ、ここにいる"}, {"type": "subtitle", "time": 8933.71, "timestamp": "02:28:53", "text": "わかった、できる限り私を殺してみろ"}, {"type": "subtitle", "time": 8937.349, "timestamp": "02:28:57", "text": "近寄らないでね、じゃあね、どこ？"}]
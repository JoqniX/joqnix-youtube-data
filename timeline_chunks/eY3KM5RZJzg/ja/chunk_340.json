[{"type": "subtitle", "time": 20419.39, "timestamp": "05:40:19", "text": "ホーム そこから何が得られますか"}, {"type": "subtitle", "time": 20421.788, "timestamp": "05:40:21", "text": "殺すよ、いい革、私は"}, {"type": "subtitle", "time": 20442.51, "timestamp": "05:40:42", "text": "今、時間があるので"}, {"type": "subtitle", "time": 20445.67, "timestamp": "05:40:45", "text": "文字通りクエストを正しく行う"}, {"type": "subtitle", "time": 20454.468, "timestamp": "05:40:54", "text": "文字通り、私は"}, {"type": "subtitle", "time": 20457.14, "timestamp": "05:40:57", "text": "今すぐクエスト"}]
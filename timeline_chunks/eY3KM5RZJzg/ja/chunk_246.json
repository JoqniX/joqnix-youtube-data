[{"type": "subtitle", "time": 14768.87, "timestamp": "04:06:08", "text": "怖がった"}, {"type": "subtitle", "time": 14776.67, "timestamp": "04:06:16", "text": "待って、実はどうやって手に入れるか分からない"}, {"type": "subtitle", "time": 14784.03, "timestamp": "04:06:24", "text": "死んでしまった、どうやって降りるんだ、これはまるで"}, {"type": "subtitle", "time": 14786.189, "timestamp": "04:06:26", "text": "水桶を持ってきましょうか"}, {"type": "subtitle", "time": 14789.389, "timestamp": "04:06:29", "text": "水バケツ あ、待って、取りに行こう"}, {"type": "subtitle", "time": 14792.189, "timestamp": "04:06:32", "text": "それを食べて食べ物を手に入れよう"}, {"type": "subtitle", "time": 14797.83, "timestamp": "04:06:37", "text": "食べ物も大丈夫、えっと、私のものは私の"}, {"type": "subtitle", "time": 14800.349, "timestamp": "04:06:40", "text": "本能がジャンプしろと告げているが、"}]
[{"type": "subtitle", "time": 11940.269, "timestamp": "03:19:00", "text": "エネルギーああ、ブロックしたよ、ところで"}, {"type": "subtitle", "time": 11946.229, "timestamp": "03:19:06", "text": "犬、そう、アスラがこれをくれたんだ、さあ"}, {"type": "subtitle", "time": 11948.03, "timestamp": "03:19:08", "text": "えっと、私の"}, {"type": "subtitle", "time": 11953.189, "timestamp": "03:19:13", "text": "胸部、アメジストのブロック"}, {"type": "subtitle", "time": 11956.75, "timestamp": "03:19:16", "text": "何か、ああ、アメジストH、アメジスト、うん"}, {"type": "subtitle", "time": 11958.91, "timestamp": "03:19:18", "text": "うんうんうんクリスタル"}, {"type": "subtitle", "time": 11962.269, "timestamp": "03:19:22", "text": "音を出すやつだよ、わかるだろ？"}, {"type": "subtitle", "time": 11964.469, "timestamp": "03:19:24", "text": "ええ、私たちが何をしたかはご存知でしょう"}, {"type": "subtitle", "time": 11967.269, "timestamp": "03:19:27", "text": "昨日彼はステージを作った"}, {"type": "subtitle", "time": 11970.349, "timestamp": "03:19:30", "text": "私にとってはそういうことで、私は"}, {"type": "subtitle", "time": 11979.389, "timestamp": "03:19:39", "text": "かわいい、見逃したよ、それは"}, {"type": "chat", "time": 11982.308, "timestamp": "03:19:42", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "\"The way you make a family is not family friendly\""}, {"type": "subtitle", "time": 11982.99, "timestamp": "03:19:42", "text": "わかった、わかった、待ってみよう"}, {"type": "subtitle", "time": 11985.49, "timestamp": "03:19:45", "text": "そうすればまたできる"}, {"type": "chat", "time": 11985.637, "timestamp": "03:19:45", "author": "@Roku-rin", "avatar": "https://yt4.ggpht.com/8LlS_C2IirDMfA5r2V0q5G1kudp8dmG6RQvz_jCAUT3H-esyEgTNPDwrfCXiyX7Undc9UmHNgw=s64-c-k-c0x00ffffff-no-rj", "message": "till we meet again"}, {"type": "subtitle", "time": 11988.309, "timestamp": "03:19:48", "text": "[音楽]"}, {"type": "subtitle", "time": 11990.75, "timestamp": "03:19:50", "text": "わかった、待ってて、すぐ戻るから、わかった、私は"}, {"type": "subtitle", "time": 11996.07, "timestamp": "03:19:56", "text": "家族を作る方法は水ではありません"}, {"type": "subtitle", "time": 11999.63, "timestamp": "03:19:59", "text": "家族向けです。また会う日までね。"}]
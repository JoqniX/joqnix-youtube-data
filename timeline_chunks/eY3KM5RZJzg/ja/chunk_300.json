[{"type": "subtitle", "time": 18023.628, "timestamp": "05:00:23", "text": "1990年代、これは興味深いけど、待って"}, {"type": "subtitle", "time": 18026.628, "timestamp": "05:00:26", "text": "どうやってプレイするの？"}, {"type": "subtitle", "time": 18051.35, "timestamp": "05:00:51", "text": "これを終了するにはどうすればいいですか？"}, {"type": "subtitle", "time": 18053.708, "timestamp": "05:00:53", "text": "待って、私は好きじゃない"}, {"type": "subtitle", "time": 18058.07, "timestamp": "05:00:58", "text": "私はゲームをプレイしたい"}]
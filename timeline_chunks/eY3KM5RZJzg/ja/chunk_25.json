[{"type": "subtitle", "time": 1501.59, "timestamp": "00:25:01", "text": "オーケー、豚が何匹かいるよ。"}, {"type": "subtitle", "time": 1503.07, "timestamp": "00:25:03", "text": "に起こっている"}, {"type": "subtitle", "time": 1506.07, "timestamp": "00:25:06", "text": "世界よ、無料の食べ物よ、だってそれは炎だから"}, {"type": "subtitle", "time": 1508.43, "timestamp": "00:25:08", "text": "無料で手に入る剣"}, {"type": "subtitle", "time": 1512.11, "timestamp": "00:25:12", "text": "食べ物を焼いた食べ物なので、私たちは、えーと"}, {"type": "subtitle", "time": 1522.43, "timestamp": "00:25:22", "text": "さて、これらはどこにあるのでしょうか？"}, {"type": "subtitle", "time": 1534.99, "timestamp": "00:25:34", "text": "問題は、私は自分の持ち物をなくすことができないということです。"}, {"type": "subtitle", "time": 1537.909, "timestamp": "00:25:37", "text": "みんな、私は失うことはできない"}, {"type": "subtitle", "time": 1542.47, "timestamp": "00:25:42", "text": "いいえ、いいえ、いいえ"}, {"type": "subtitle", "time": 1544.87, "timestamp": "00:25:44", "text": "グレイブス"}, {"type": "subtitle", "time": 1547.389, "timestamp": "00:25:47", "text": "インストール済み なぜ私の接続は"}]
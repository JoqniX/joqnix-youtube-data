[{"type": "subtitle", "time": 11102.59, "timestamp": "03:05:02", "text": "調整して、移動してここに来てください"}, {"type": "subtitle", "time": 11105.87, "timestamp": "03:05:05", "text": "X Y を監視しなければならないように、"}, {"type": "subtitle", "time": 11108.99, "timestamp": "03:05:08", "text": "Zはちょっと難しい"}, {"type": "subtitle", "time": 11122.07, "timestamp": "03:05:22", "text": "ゲームで石炭を採掘してるよ、だって私は"}, {"type": "subtitle", "time": 11124.91, "timestamp": "03:05:24", "text": "他に何をすべきか、他に何をすべきか"}, {"type": "subtitle", "time": 11127.91, "timestamp": "03:05:27", "text": "他に何をすればいいの？まだ待ってるよ"}, {"type": "subtitle", "time": 11129.39, "timestamp": "03:05:29", "text": "私の戦利品のために"}, {"type": "subtitle", "time": 11132.07, "timestamp": "03:05:32", "text": "[音楽]"}, {"type": "subtitle", "time": 11141.95, "timestamp": "03:05:41", "text": "ああ、子供は私たちに加わらなかった、私たちは"}, {"type": "subtitle", "time": 11143.349, "timestamp": "03:05:43", "text": "ない"}, {"type": "subtitle", "time": 11146.71, "timestamp": "03:05:46", "text": "彼女は、体調が良くないと言っていました。"}, {"type": "subtitle", "time": 11148.87, "timestamp": "03:05:48", "text": "だから彼女は参加できない"}]
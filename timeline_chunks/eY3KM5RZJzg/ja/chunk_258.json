[{"type": "subtitle", "time": 15480.07, "timestamp": "04:18:00", "text": "オレンジの木のような神様"}, {"type": "subtitle", "time": 15481.99, "timestamp": "04:18:01", "text": "赤い木々とか、あの場所は"}, {"type": "subtitle", "time": 15485.67, "timestamp": "04:18:05", "text": "ああ、それは、それは、それは、"}, {"type": "subtitle", "time": 15487.469, "timestamp": "04:18:07", "text": "建物"}, {"type": "subtitle", "time": 15497.67, "timestamp": "04:18:17", "text": "赤い桜の木はもう終わりました"}, {"type": "subtitle", "time": 15501.55, "timestamp": "04:18:21", "text": "ここではなく、これは、それは"}, {"type": "subtitle", "time": 15510.03, "timestamp": "04:18:30", "text": "どこにあったのか分からないもの"}, {"type": "subtitle", "time": 15512.63, "timestamp": "04:18:32", "text": "大丈夫、私が見つけるから"}, {"type": "subtitle", "time": 15517.07, "timestamp": "04:18:37", "text": "WSと一緒に桜が咲いている、うん、これ"}, {"type": "subtitle", "time": 15519.469, "timestamp": "04:18:39", "text": "これは私のいつものルートでした"}, {"type": "subtitle", "time": 15521.189, "timestamp": "04:18:41", "text": "クエストではない"}, {"type": "subtitle", "time": 15525.469, "timestamp": "04:18:45", "text": "これは私が知らない場所だった"}, {"type": "subtitle", "time": 15528.469, "timestamp": "04:18:48", "text": "うん、こんな感じだった"}, {"type": "subtitle", "time": 15531.189, "timestamp": "04:18:51", "text": "まるで"}]
[{"type": "subtitle", "time": 604.35, "timestamp": "00:10:04", "text": "では、今すぐ始めましょうか、それとも"}, {"type": "subtitle", "time": 608.11, "timestamp": "00:10:08", "text": "体をリラックスさせて、"}, {"type": "subtitle", "time": 610.389, "timestamp": "00:10:10", "text": "戻って、顔を洗ってから来るよ"}, {"type": "subtitle", "time": 618.59, "timestamp": "00:10:18", "text": "はい、水分補給が必要です"}, {"type": "subtitle", "time": 622.069, "timestamp": "00:10:22", "text": "ストレッチはすべきではない"}, {"type": "subtitle", "time": 624.75, "timestamp": "00:10:24", "text": "過労してはいけない"}, {"type": "subtitle", "time": 628.35, "timestamp": "00:10:28", "text": "私自身は幸せで音楽を楽しんでいます"}]
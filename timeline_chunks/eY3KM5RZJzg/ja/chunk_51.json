[{"type": "subtitle", "time": 3079.309, "timestamp": "00:51:19", "text": "探検には注意が必要です"}, {"type": "subtitle", "time": 3081.87, "timestamp": "00:51:21", "text": "ジョッキー、あれは何？あれは何？"}, {"type": "subtitle", "time": 3085.109, "timestamp": "00:51:25", "text": "私たちとは"}, {"type": "subtitle", "time": 3088.309, "timestamp": "00:51:28", "text": "これは何ですか"}, {"type": "subtitle", "time": 3089.549, "timestamp": "00:51:29", "text": "1"}, {"type": "subtitle", "time": 3092.19, "timestamp": "00:51:32", "text": "何かがあるかもしれない場所"}, {"type": "subtitle", "time": 3103.71, "timestamp": "00:51:43", "text": "何もない"}, {"type": "subtitle", "time": 3106.23, "timestamp": "00:51:46", "text": "何"}, {"type": "subtitle", "time": 3116.829, "timestamp": "00:51:56", "text": "ここには何もないかもしれない、なぜ"}]
[{"type": "subtitle", "time": 6362.31, "timestamp": "01:46:02", "text": "待って、待って、それは後です"}, {"type": "subtitle", "time": 6365.149, "timestamp": "01:46:05", "text": "これは、スライドした後です"}, {"type": "subtitle", "time": 6368.669, "timestamp": "01:46:08", "text": "そう、母と家族、母と息子"}, {"type": "subtitle", "time": 6378.07, "timestamp": "01:46:18", "text": "ここで私は話した、ああここで私は死んだ"}, {"type": "subtitle", "time": 6381.589, "timestamp": "01:46:21", "text": "誤って右を押し下げた"}, {"type": "subtitle", "time": 6383.669, "timestamp": "01:46:23", "text": "誤って押しました。誤って"}, {"type": "subtitle", "time": 6386.189, "timestamp": "01:46:26", "text": "押し下げられて、私はパニックになっていました"}, {"type": "subtitle", "time": 6388.99, "timestamp": "01:46:28", "text": "ああ、どこに行けばいいの？どこに行けばいいの？"}, {"type": "subtitle", "time": 6391.149, "timestamp": "01:46:31", "text": "そしてSがグリッチを起こし始めたので、"}, {"type": "subtitle", "time": 6394.87, "timestamp": "01:46:34", "text": "動けないよ、私には無理だった"}, {"type": "subtitle", "time": 6397.43, "timestamp": "01:46:37", "text": "動かすと、ガラスを割り始めた"}, {"type": "subtitle", "time": 6399.229, "timestamp": "01:46:39", "text": "しない"}, {"type": "subtitle", "time": 6407.75, "timestamp": "01:46:47", "text": "パニック パニックで切断した"}, {"type": "subtitle", "time": 6410.43, "timestamp": "01:46:50", "text": "Wasaに不具合が発生し、接続が切断されました。"}, {"type": "subtitle", "time": 6413.87, "timestamp": "01:46:53", "text": "パニックから抜け出した男"}, {"type": "subtitle", "time": 6416.91, "timestamp": "01:46:56", "text": "そして私はパニックになり始めた"}, {"type": "subtitle", "time": 6418.99, "timestamp": "01:46:58", "text": "パニックになって、それから"}]
[{"type": "subtitle", "time": 1021.11, "timestamp": "00:17:01", "text": "私は行ってみたい"}, {"type": "subtitle", "time": 1024.87, "timestamp": "00:17:04", "text": "そこにいるけど、ズキがいるかどうかはわからない"}, {"type": "subtitle", "time": 1028.63, "timestamp": "00:17:08", "text": "今日参加します。そこに行きたいです。"}, {"type": "subtitle", "time": 1031.309, "timestamp": "00:17:11", "text": "2番目のバックに会う"}, {"type": "subtitle", "time": 1033.59, "timestamp": "00:17:13", "text": "スタバー"}, {"type": "subtitle", "time": 1036.789, "timestamp": "00:17:16", "text": "だから私はこの世界で復讐したい"}, {"type": "subtitle", "time": 1038.59, "timestamp": "00:17:18", "text": "私は自分の"}, {"type": "subtitle", "time": 1041.069, "timestamp": "00:17:21", "text": "チームメイトを守りたい、私は小さな"}, {"type": "subtitle", "time": 1042.789, "timestamp": "00:17:22", "text": "私の"}, {"type": "subtitle", "time": 1046.23, "timestamp": "00:17:26", "text": "図鑑 U sh sh"}, {"type": "subtitle", "time": 1048.549, "timestamp": "00:17:28", "text": "ああ、私は彼らをこのことから守りたい"}, {"type": "subtitle", "time": 1051.31, "timestamp": "00:17:31", "text": "壁とこれらの邪悪な"}, {"type": "subtitle", "time": 1054.87, "timestamp": "00:17:34", "text": "人々と神自身を連れて行きます"}, {"type": "subtitle", "time": 1058.07, "timestamp": "00:17:38", "text": "私のものを取り戻す、私は見ている"}, {"type": "subtitle", "time": 1062.43, "timestamp": "00:17:42", "text": "神が私たちを連れて行ったので、私たちを連れて行ったのではない"}, {"type": "subtitle", "time": 1065.63, "timestamp": "00:17:45", "text": "彼は私たちからすべてを奪った"}, {"type": "subtitle", "time": 1069.35, "timestamp": "00:17:49", "text": "裏切って嘘をついたので"}, {"type": "subtitle", "time": 1071.15, "timestamp": "00:17:51", "text": "うん、そうだね"}, {"type": "subtitle", "time": 1073.15, "timestamp": "00:17:53", "text": "昨日私は"}, {"type": "subtitle", "time": 1076.75, "timestamp": "00:17:56", "text": "これは間違っている、誰がこんなことを気にしたのか"}, {"type": "subtitle", "time": 1078.549, "timestamp": "00:17:58", "text": "これはこんなことじゃなかった、えーと"}, {"type": "chat", "time": 1078.922, "timestamp": "00:17:58", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.co
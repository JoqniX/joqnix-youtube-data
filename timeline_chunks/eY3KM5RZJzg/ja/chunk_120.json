[{"type": "subtitle", "time": 7201.189, "timestamp": "02:00:01", "text": "2つ目よし、牛が見える、おいおい"}, {"type": "subtitle", "time": 7203.189, "timestamp": "02:00:03", "text": "来る"}, {"type": "subtitle", "time": 7205.79, "timestamp": "02:00:05", "text": "おいおい、あれは鶏だ、どこだ"}, {"type": "subtitle", "time": 7207.39, "timestamp": "02:00:07", "text": "は"}, {"type": "subtitle", "time": 7210.75, "timestamp": "02:00:10", "text": "旅人よ、牛はどこにいる？"}, {"type": "subtitle", "time": 7214.069, "timestamp": "02:00:14", "text": "こっち、こっち、こっち、全部"}, {"type": "subtitle", "time": 7217.27, "timestamp": "02:00:17", "text": "牛はここにいる、３つ"}, {"type": "subtitle", "time": 7219.75, "timestamp": "02:00:19", "text": "牛は見る"}, {"type": "subtitle", "time": 7224.27, "timestamp": "02:00:24", "text": "これはすごい、いいですね、気に入りました"}, {"type": "subtitle", "time": 7225.069, "timestamp": "02:00:25", "text": "それは"}, {"type": "subtitle", "time": 7227.83, "timestamp": "02:00:27", "text": "すごいですね。それで、今度はあなたの"}, {"type": "subtitle", "time": 7229.629, "timestamp": "02:00:29", "text": "家"}, {"type": "subtitle", "time": 7232.31, "timestamp": "02:00:32", "text": "わあ、ほら、火打ち石があるよ"}, {"type": "subtitle", "time": 7234.35, "timestamp": "02:00:34", "text": "鋼鉄"}, {"type": "subtitle", "time": 7238.43, "timestamp": "02:00:38", "text": "いや、すごい、あなたはとても貧乏ですね。私は貧乏です。"}, {"type": "subtitle", "time": 7241.39, "timestamp": "02:00:41", "text": "全てを失った"}, {"type": "subtitle", "time": 7244.629, "timestamp": "02:00:44", "text": "人生は"}, {"type": "subtitle", "time": 7247.51, "timestamp": "02:00:47", "text": "痛み男、彼らは実際にやらなければならない"}, {"type": "subtitle", "time": 7249.35, "timestamp": "02:00:49", "text": "墓のことか何か"}, {"type": "subtitle", "time": 7252.109, "timestamp": "02:00:52", "text": "在庫を保管するなど、私が知っていることは"}, {"type": "subtitle", "time": 7254.91, "timestamp": "02:00:54", "text": "最悪だよ、知ってるでしょ、私は"}, {"type": "subtitle", "time": 7256.629, "timestamp": "02:00:56", "text": "私があなたの基地に来たとき、"}, {"type": "subtitle", "time": 7259.229, "timestamp": "02:00:59", "text": "1時間旅行していて、"}]
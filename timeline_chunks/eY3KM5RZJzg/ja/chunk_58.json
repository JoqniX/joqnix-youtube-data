[{"type": "subtitle", "time": 3481.09, "timestamp": "00:58:01", "text": "彼女、私は戻ってくる"}, {"type": "subtitle", "time": 3491.95, "timestamp": "00:58:11", "text": "もうすぐ、大切な人のためにそれをします"}, {"type": "subtitle", "time": 3496.349, "timestamp": "00:58:16", "text": "チームメイト、私の仲間、私は彼らを大切にしています"}, {"type": "subtitle", "time": 3500.589, "timestamp": "00:58:20", "text": "ほとんどそうなので、私はそれを行っています"}, {"type": "subtitle", "time": 3503.029, "timestamp": "00:58:23", "text": "彼らを守るために"}, {"type": "subtitle", "time": 3521.029, "timestamp": "00:58:41", "text": "ああ、なぜできないんだ、ああ、虚無には"}, {"type": "subtitle", "time": 3524.75, "timestamp": "00:58:44", "text": "虚無がまた私を嫌っているのは、私が"}, {"type": "subtitle", "time": 3526.15, "timestamp": "00:58:46", "text": "私の"}, {"type": "subtitle", "time": 3529.51, "timestamp": "00:58:49", "text": "一番いいのは、私が立場を変えているからだ"}, {"type": "subtitle", "time": 3537.67, "timestamp": "00:58:57", "text": "彼自身がSerマンであり、サーバーの問題は"}, {"type": "chat", "time": 3538.052, "timestamp": "00:58:58", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "hello"}]
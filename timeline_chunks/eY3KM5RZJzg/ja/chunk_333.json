[{"type": "subtitle", "time": 20011.39, "timestamp": "05:33:31", "text": "男の子、いい感じのものはないと思うよ"}, {"type": "subtitle", "time": 20019.708, "timestamp": "05:33:39", "text": "えっと"}, {"type": "subtitle", "time": 20023.628, "timestamp": "05:33:43", "text": "うーん、良いものはないと思う"}, {"type": "subtitle", "time": 20026.98, "timestamp": "05:33:46", "text": "サーバーのように、それは"}, {"type": "subtitle", "time": 20031.948, "timestamp": "05:33:51", "text": "[音楽]"}, {"type": "subtitle", "time": 20036.23, "timestamp": "05:33:56", "text": "問題です。これを切断したいのですが、"}]
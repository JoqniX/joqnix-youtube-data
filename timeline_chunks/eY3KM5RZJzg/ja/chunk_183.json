[{"type": "subtitle", "time": 10981.83, "timestamp": "03:03:01", "text": "これはチームの新しい拠点になり得る"}, {"type": "subtitle", "time": 10984.75, "timestamp": "03:03:04", "text": "そう、君たちは"}, {"type": "subtitle", "time": 10986.389, "timestamp": "03:03:06", "text": "右に燃えた"}, {"type": "subtitle", "time": 10989.95, "timestamp": "03:03:09", "text": "そう、逃げなきゃいけないよ、チェリーを飛ばせ"}, {"type": "subtitle", "time": 10992.309, "timestamp": "03:03:12", "text": "桜の花が咲くことを願って"}, {"type": "subtitle", "time": 10994.79, "timestamp": "03:03:14", "text": "私はその男がこれを見ないことを願わない"}, {"type": "subtitle", "time": 10997.79, "timestamp": "03:03:17", "text": "この船がなくなってほしくない"}, {"type": "subtitle", "time": 11000.389, "timestamp": "03:03:20", "text": "殺して、ヴィングを追撃する"}, {"type": "subtitle", "time": 11003.469, "timestamp": "03:03:23", "text": "旅行者、いいえ、私は彼がそうすると信じています、私たちはそうしません"}, {"type": "subtitle", "time": 11005.75, "timestamp": "03:03:25", "text": "こっちに来て、秘密にしてあげる"}, {"type": "subtitle", "time": 11008.71, "timestamp": "03:03:28", "text": "彼が私たちの配信を見ないことを願います"}, {"type": "subtitle", "time": 11010.75, "timestamp": "03:03:30", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 11014.19, "timestamp": "03:03:34", "text": "神様、でも彼をここに連れてきてはいけません"}, {"type": "subtitle", "time": 11017.71, "timestamp": "03:03:37", "text": "隠れて、一時的な基地を作るか"}, {"type": "subtitle", "time": 11021.8, "timestamp": "03:03:41", "text": "何かをこっそりここに置いておきましょう"}, {"type": "subtitle", "time": 11023.07, "timestamp": "03:03:43", "text": "[音楽]"}, {"type": "subtitle", "time": 11026.469, "timestamp": "03:03:46", "text": "まあまあだけど、問題は私が"}, {"type": "subtitle", "time": 11028.99, "timestamp": "03:03:48", "text": "ここからどうやって脱出するか知っている"}, {"type": "subtitle", "time": 11034.55, "timestamp": "03:03:54", "text": "場所がひどいですね、ええ、私たちは"}, {"type": "subtitle", "time": 11037.67, "timestamp": "03:03:57", "text": "梯子を建てる必要があると思う"}]
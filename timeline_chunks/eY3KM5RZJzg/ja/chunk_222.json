[{"type": "subtitle", "time": 13321.67, "timestamp": "03:42:01", "text": "君たちのためにやるよ、私は自分の"}, {"type": "subtitle", "time": 13323.95, "timestamp": "03:42:03", "text": "君たちへの忠誠心、俺は一人で彼を殺します"}, {"type": "subtitle", "time": 13327.71, "timestamp": "03:42:07", "text": "死なずに私はFPSプロゲーマー"}, {"type": "subtitle", "time": 13330.229, "timestamp": "03:42:10", "text": "スキル 私はそうは思わない 私はそうは思わない"}, {"type": "subtitle", "time": 13333.51, "timestamp": "03:42:13", "text": "彼と一人で戦うべきだ"}, {"type": "subtitle", "time": 13336.51, "timestamp": "03:42:16", "text": "1対3ではうまくいかない"}, {"type": "subtitle", "time": 13341.149, "timestamp": "03:42:21", "text": "ええ、いいえ、それは一人の男です。私は"}, {"type": "subtitle", "time": 13343.469, "timestamp": "03:42:23", "text": "彼らが隠れなければならないなら、私は待つと思う"}, {"type": "subtitle", "time": 13347.07, "timestamp": "03:42:27", "text": "グループが来る、ああ、ああ、ああ、いや、それは"}, {"type": "subtitle", "time": 13349.63, "timestamp": "03:42:29", "text": "まるで戦闘戦略のようだ"}, {"type": "subtitle", "time": 13352.149, "timestamp": "03:42:32", "text": "神様、私はとても"}, {"type": "subtitle", "time": 13356.03, "timestamp": "03:42:36", "text": "待って、でも待って、CH、地図はある？"}, {"type": "subtitle", "time": 13358.469, "timestamp": "03:42:38", "text": "地図はありますか？いいえ、彼はくれませんでした"}, {"type": "subtitle", "time": 13361.03, "timestamp": "03:42:41", "text": "私に、でも彼は寝たみたいだった、いや私は"}, {"type": "subtitle", "time": 13364.11, "timestamp": "03:42:44", "text": "支払いは"}, {"type": "subtitle", "time": 13366.55, "timestamp": "03:42:46", "text": "明日ここに来てここに来てここに来て"}, {"type": "subtitle", "time": 13372.389, "timestamp": "03:42:52", "text": "ランダムマップを入手した場合の質問"}, {"type": "subtitle", "time": 13374.349, "timestamp": "03:42:54", "text": "宝箱のようなものから、それはあなたの"}, {"type": "subtitle", "time": 13376.79, "timestamp": "03:42:56", "text": "宝探しの旅"}, {"type": "subtitle", "time": 13379.389, "timestamp": "03:42:59", "text": "胸、えっと、これを見て、何なのかわからない"}]
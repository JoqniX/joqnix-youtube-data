[{"type": "subtitle", "time": 7740.83, "timestamp": "02:09:00", "text": "支払いはどうなったのか"}, {"type": "subtitle", "time": 7742.149, "timestamp": "02:09:02", "text": "ただの詐欺"}, {"type": "subtitle", "time": 7745.79, "timestamp": "02:09:05", "text": "私か何か"}, {"type": "subtitle", "time": 7748.35, "timestamp": "02:09:08", "text": "CH、何が起こるか教えてください"}, {"type": "subtitle", "time": 7750.229, "timestamp": "02:09:10", "text": "実際起こったことはまだ理解できていない"}, {"type": "subtitle", "time": 7751.549, "timestamp": "02:09:11", "text": "何かあったの？わかったわかったわかったわかった"}, {"type": "subtitle", "time": 7753.549, "timestamp": "02:09:13", "text": "それで、何が起こったの？"}, {"type": "subtitle", "time": 7757.31, "timestamp": "02:09:17", "text": "私はすべてを失った"}, {"type": "subtitle", "time": 7761.47, "timestamp": "02:09:21", "text": "アイテム はい、私が死んだからです それは何でしたか 何"}, {"type": "subtitle", "time": 7763.109, "timestamp": "02:09:23", "text": "品物は何でしたか？教えてください。"}, {"type": "subtitle", "time": 7765.03, "timestamp": "02:09:25", "text": "昨日見たもの"}, {"type": "subtitle", "time": 7768.95, "timestamp": "02:09:28", "text": "黄金の、OPなもの、黄金"}, {"type": "subtitle", "time": 7770.109, "timestamp": "02:09:30", "text": "胸"}, {"type": "subtitle", "time": 7774.91, "timestamp": "02:09:34", "text": "プレート、つまりスライドさせて"}, {"type": "subtitle", "time": 7777.39, "timestamp": "02:09:37", "text": "タップできるパンツ"}, {"type": "subtitle", "time": 7780.99, "timestamp": "02:09:40", "text": "stve uh 私を留まらせるベール"}, {"type": "subtitle", "time": 7783.109, "timestamp": "02:09:43", "text": "隠されている"}, {"type": "subtitle", "time": 7785.87, "timestamp": "02:09:45", "text": "モンスターがいて、私は強力な剣を持っていた"}, {"type": "subtitle", "time": 7789.229, "timestamp": "02:09:49", "text": "火力があるから無料で入れる"}, {"type": "subtitle", "time": 7793.069, "timestamp": "02:09:53", "text": "鶏や牛などを殺して作った食べ物"}, {"type": "subtitle", "time": 7796.51, "timestamp": "02:09:56", "text": "じゃあ、教えて、教えて、"}, {"type": "subtitle", "time": 7798.87, "timestamp": "02:09:58", "text": "彼はエメラルドを取引した"}]
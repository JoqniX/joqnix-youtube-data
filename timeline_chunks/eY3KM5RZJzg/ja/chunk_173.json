[{"type": "subtitle", "time": 10381.99, "timestamp": "02:53:01", "text": "私の、ここは"}, {"type": "subtitle", "time": 10384.02, "timestamp": "02:53:04", "text": "人生の痛みは"}, {"type": "subtitle", "time": 10420.91, "timestamp": "02:53:40", "text": "パット、守護天使はどこにいる？"}, {"type": "subtitle", "time": 10424.389, "timestamp": "02:53:44", "text": "剣、ああ、そうだ、ああ、行こう"}, {"type": "subtitle", "time": 10427.15, "timestamp": "02:53:47", "text": "大邸宅のやつ、覚えてるよ、あのやり方は違う"}, {"type": "subtitle", "time": 10430.95, "timestamp": "02:53:50", "text": "いやいや、言及しないで、私が"}, {"type": "subtitle", "time": 10435.15, "timestamp": "02:53:55", "text": "それはどこかにあることをお見せします"}, {"type": "subtitle", "time": 10436.59, "timestamp": "02:53:56", "text": "の"}, {"type": "subtitle", "time": 10438.19, "timestamp": "02:53:58", "text": "家"}]
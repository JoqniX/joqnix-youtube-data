[{"type": "subtitle", "time": 5760.79, "timestamp": "01:36:00", "text": "欲しい"}, {"type": "subtitle", "time": 5768.27, "timestamp": "01:36:08", "text": "いつテストすればいいですか？"}, {"type": "subtitle", "time": 5770.91, "timestamp": "01:36:10", "text": "さあ、この実験対象を探しに行こう"}, {"type": "subtitle", "time": 5772.59, "timestamp": "01:36:12", "text": "そうそうそう、ここが"}, {"type": "subtitle", "time": 5775.27, "timestamp": "01:36:15", "text": "テストしてみます。待ってください、ここでテストします。"}, {"type": "subtitle", "time": 5777.83, "timestamp": "01:36:17", "text": "ここでテストしました"}, {"type": "subtitle", "time": 5780.79, "timestamp": "01:36:20", "text": "枯れていく、わかった、そういうこと、そういうこと"}, {"type": "subtitle", "time": 5784.51, "timestamp": "01:36:24", "text": "萎凋の仕組みがわかれば"}, {"type": "subtitle", "time": 5788.83, "timestamp": "01:36:28", "text": "スイッチ はい 火 このモデル モデル"}, {"type": "subtitle", "time": 5791.37, "timestamp": "01:36:31", "text": "ああ、なんてモデルなんだ"}, {"type": "subtitle", "time": 5792.55, "timestamp": "01:36:32", "text": "[音楽]"}, {"type": "subtitle", "time": 5795.229, "timestamp": "01:36:35", "text": "道徳"}, {"type": "subtitle", "time": 5798.35, "timestamp": "01:36:38", "text": "ああ、お願い、それは枯れゆく剣だ、いや"}, {"type": "subtitle", "time": 5800.35, "timestamp": "01:36:40", "text": "炎を探すべきだ"}, {"type": "subtitle", "time": 5801.91, "timestamp": "01:36:41", "text": "待って、名前だと思う、名前は"}, {"type": "subtitle", "time": 5803.39, "timestamp": "01:36:43", "text": "炎の剣"}, {"type": "subtitle", "time": 5805.629, "timestamp": "01:36:45", "text": "たぶん、あ、待って、ほとんど見える"}, {"type": "subtitle", "time": 5807.629, "timestamp": "01:36:47", "text": "ほら、文字通り見えるよ"}, {"type": "subtitle", "time": 5810.87, "timestamp": "01:36:50", "text": "ああ、待って、炎、よし、待って、フレーム"}, {"type": "subtitle", "time": 5812.27, "timestamp": "01:36:52", "text": "フレーム フレーム フレーム フレーム"}, {"type": "subtitle", "time": 5819.669, "timestamp": "01:36:59", "text": "よし、火の側面よし、火の側面よ、待つ"}]
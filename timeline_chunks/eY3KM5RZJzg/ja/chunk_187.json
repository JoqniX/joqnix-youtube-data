[{"type": "subtitle", "time": 11220.269, "timestamp": "03:07:00", "text": "それは航海できる船のようなものだ"}, {"type": "subtitle", "time": 11223.55, "timestamp": "03:07:03", "text": "星の海を通って、あるいは"}, {"type": "subtitle", "time": 11226.63, "timestamp": "03:07:06", "text": "宇宙空間にいると想像してみてください"}, {"type": "subtitle", "time": 11229.15, "timestamp": "03:07:09", "text": "懐中電灯 懐中電灯は持っていません"}, {"type": "subtitle", "time": 11231.19, "timestamp": "03:07:11", "text": "なんてこった"}, {"type": "subtitle", "time": 11234.389, "timestamp": "03:07:14", "text": "いや、ここはメモしておかないと"}, {"type": "subtitle", "time": 11245.87, "timestamp": "03:07:25", "text": "うん、待って、あの、私は物を取っておくよ"}, {"type": "subtitle", "time": 11249.95, "timestamp": "03:07:29", "text": "このクエストでは、私は恐れている"}, {"type": "subtitle", "time": 11250.53, "timestamp": "03:07:30", "text": "かもしれない"}, {"type": "subtitle", "time": 11252.67, "timestamp": "03:07:32", "text": "[音楽]"}, {"type": "subtitle", "time": 11255.349, "timestamp": "03:07:35", "text": "みんな、みんな、僕が見つけたものを見て"}, {"type": "subtitle", "time": 11262.429, "timestamp": "03:07:42", "text": "何を見つけるか"}, {"type": "subtitle", "time": 11267.07, "timestamp": "03:07:47", "text": "それは火事か何かですか？"}, {"type": "subtitle", "time": 11269.63, "timestamp": "03:07:49", "text": "ドラゴン、火の玉、燃え盛る炎、または"}, {"type": "subtitle", "time": 11273.79, "timestamp": "03:07:53", "text": "何か正しい、えっと、火をつけて、ただ"}, {"type": "subtitle", "time": 11276.63, "timestamp": "03:07:56", "text": "それは良いことです それは良いことです"}, {"type": "subtitle", "time": 11279.03, "timestamp": "03:07:59", "text": "長い、ああ"}]
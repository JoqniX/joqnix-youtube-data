[{"type": "subtitle", "time": 2461.349, "timestamp": "00:41:01", "text": "主よ、世界は恐ろしいですが"}, {"type": "subtitle", "time": 2464.069, "timestamp": "00:41:04", "text": "広大な景色、桜が咲いている、私は"}, {"type": "subtitle", "time": 2467.349, "timestamp": "00:41:07", "text": "自分の場所に戻った私は"}, {"type": "subtitle", "time": 2470.43, "timestamp": "00:41:10", "text": "私の地域なのか、それとも新しい土地なのか？"}, {"type": "subtitle", "time": 2475.03, "timestamp": "00:41:15", "text": "私は発見した、あるいは偶然見つけた"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "十字架 私は本当にそうは思わない"}, {"type": "subtitle", "time": 2481.03, "timestamp": "00:41:21", "text": "チェルの花が咲いているのが見えるけど、"}, {"type": "subtitle", "time": 2484.109, "timestamp": "00:41:24", "text": "自分の家を思い出させる"}, {"type": "subtitle", "time": 2487.43, "timestamp": "00:41:27", "text": "私が生まれ育った土地"}, {"type": "subtitle", "time": 2490.109, "timestamp": "00:41:30", "text": "私がシャーの花から来たとき"}, {"type": "subtitle", "time": 2496.19, "timestamp": "00:41:36", "text": "雪が降っているが、この土地は私が見渡せる"}, {"type": "subtitle", "time": 2502.069, "timestamp": "00:41:42", "text": "ここは春かそれ以上の気候です"}, {"type": "subtitle", "time": 2506.55, "timestamp": "00:41:46", "text": "ワイルドだね、だって葉脈とか葉っぱみたいなのが見えるから"}, {"type": "subtitle", "time": 2516.109, "timestamp": "00:41:56", "text": "木だけど、そう、冒険すればするほど"}, {"type": "subtitle", "time": 2518.55, "timestamp": "00:41:58", "text": "海を越えて"}]
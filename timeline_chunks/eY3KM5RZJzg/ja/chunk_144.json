[{"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "ああ、何が起こったんだ、私はそれを殺した、私はそれを殺した"}, {"type": "subtitle", "time": 8656.469, "timestamp": "02:24:16", "text": "私はそれを殺した、私は骸骨を殺した"}, {"type": "subtitle", "time": 8658.07, "timestamp": "02:24:18", "text": "これを点灯する必要がある"}, {"type": "subtitle", "time": 8661.309, "timestamp": "02:24:21", "text": "なんてことだ"}, {"type": "subtitle", "time": 8664.67, "timestamp": "02:24:24", "text": "えっと、あの、マンションはどこにあるの？迷子になっちゃった。"}, {"type": "subtitle", "time": 8669.469, "timestamp": "02:24:29", "text": "こっちだよ、待って、見せてあげるよ"}, {"type": "subtitle", "time": 8671.95, "timestamp": "02:24:31", "text": "実はあなたに見せたいものがあったんです"}, {"type": "subtitle", "time": 8675.11, "timestamp": "02:24:35", "text": "そして、えーと"}, {"type": "subtitle", "time": 8679.75, "timestamp": "02:24:39", "text": "さあ、今、生き返ったぞ"}, {"type": "subtitle", "time": 8684.429, "timestamp": "02:24:44", "text": "ここは、この辺りのどこかです"}, {"type": "subtitle", "time": 8692.389, "timestamp": "02:24:52", "text": "ああ、神様、私は死ぬ、私は死ぬ、私は死ぬ"}, {"type": "subtitle", "time": 8694.429, "timestamp": "02:24:54", "text": "死ぬ、死ぬ、死ぬ、殺される"}, {"type": "subtitle", "time": 8697.79, "timestamp": "02:24:57", "text": "ありがとう、ああ神様、"}]
[{"type": "subtitle", "time": 8520.15, "timestamp": "02:22:00", "text": "新しい"}, {"type": "subtitle", "time": 8523.03, "timestamp": "02:22:03", "text": "私があなたに見せたいのは家です"}, {"type": "subtitle", "time": 8526.15, "timestamp": "02:22:06", "text": "さあ、さあ、ああ神様、私と一緒に、でも"}, {"type": "subtitle", "time": 8528.11, "timestamp": "02:22:08", "text": "気をつけて、でも気をつけて、あそこ"}, {"type": "subtitle", "time": 8532.67, "timestamp": "02:22:12", "text": "ゾンビには気をつけなければならない"}, {"type": "subtitle", "time": 8535.83, "timestamp": "02:22:15", "text": "ああ、ああ、クリーパークリーパーだ"}, {"type": "subtitle", "time": 8537.51, "timestamp": "02:22:17", "text": "クリーパー クリーパー クリーパー 走れ走れ走れ"}, {"type": "subtitle", "time": 8541.67, "timestamp": "02:22:21", "text": "走れ、走れ、走れ、走れ、走れ、走れ、走れ、行け"}, {"type": "subtitle", "time": 8544.03, "timestamp": "02:22:24", "text": "ああ、なんてことだ、待って、私は、私は、私は守る"}, {"type": "subtitle", "time": 8546.87, "timestamp": "02:22:26", "text": "君を守る"}, {"type": "subtitle", "time": 8550.83, "timestamp": "02:22:30", "text": "心配しないで、私は死んでないから、心配しないで"}, {"type": "subtitle", "time": 8553.27, "timestamp": "02:22:33", "text": "ゴーゴーゴーゴーゴー、ああ、登らなきゃ"}, {"type": "subtitle", "time": 8558.349, "timestamp": "02:22:38", "text": "もっとああ"}, {"type": "subtitle", "time": 8563.15, "timestamp": "02:22:43", "text": "ああ、神様、弓兵が来ます、来ます、ああ、"}, {"type": "subtitle", "time": 8565.55, "timestamp": "02:22:45", "text": "ああ神様、私は死にそうです、私は死にそうです"}, {"type": "subtitle", "time": 8567.63, "timestamp": "02:22:47", "text": "私は間違いなく死にかけている 私は間違いなく"}]
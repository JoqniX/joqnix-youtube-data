[{"type": "subtitle", "time": 5161.51, "timestamp": "01:26:01", "text": "取り除くもの"}, {"type": "subtitle", "time": 5181.39, "timestamp": "01:26:21", "text": "ああ、神様って名前だったの？なんでバカなの？"}, {"type": "subtitle", "time": 5183.39, "timestamp": "01:26:23", "text": "すべてを見るべきだ"}, {"type": "subtitle", "time": 5185.39, "timestamp": "01:26:25", "text": "そして"}, {"type": "subtitle", "time": 5187.95, "timestamp": "01:26:27", "text": "ああ、それを教えてくれるモッドは一つだけだった"}, {"type": "subtitle", "time": 5190.99, "timestamp": "01:26:30", "text": "私にとってそれは"}, {"type": "subtitle", "time": 5197.39, "timestamp": "01:26:37", "text": "もっといいクソだから覚えているのは"}, {"type": "subtitle", "time": 5201.47, "timestamp": "01:26:41", "text": "えっと、私って大丈夫に見えない？私が作ったのよ"}, {"type": "subtitle", "time": 5205.189, "timestamp": "01:26:45", "text": "昨日は安定していたが、問題は"}, {"type": "subtitle", "time": 5208.03, "timestamp": "01:26:48", "text": "昨日のこのバカはなぜ"}, {"type": "subtitle", "time": 5211.03, "timestamp": "01:26:51", "text": "私もそれを見た記憶がありますが、"}, {"type": "subtitle", "time": 5213.07, "timestamp": "01:26:53", "text": "タイムスタンプ"}, {"type": "subtitle", "time": 5217.51, "timestamp": "01:26:57", "text": "わかった、わかった、ユニークを手に入れたとき"}]
[{"type": "subtitle", "time": 4818.03, "timestamp": "01:20:18", "text": "BG それはshです"}, {"type": "subtitle", "time": 4821.709, "timestamp": "01:20:21", "text": "スタイルはshです"}, {"type": "subtitle", "time": 4825.189, "timestamp": "01:20:25", "text": "スタイル 聞く 聞く いいえ"}, {"type": "subtitle", "time": 4831.07, "timestamp": "01:20:31", "text": "ほら、旅行しようとしてたんだよ"}, {"type": "subtitle", "time": 4833.99, "timestamp": "01:20:33", "text": "ええ、聞いてくれてありがとう。でも私は"}, {"type": "subtitle", "time": 4838.03, "timestamp": "01:20:38", "text": "私が宣教活動のために旅行しようとしている"}, {"type": "subtitle", "time": 4841.91, "timestamp": "01:20:41", "text": "私は選ばれた者と割り当てられた"}, {"type": "subtitle", "time": 4844.27, "timestamp": "01:20:44", "text": "あなた方全員を守るという使命を与えられた"}, {"type": "subtitle", "time": 4846.03, "timestamp": "01:20:46", "text": "あなたが"}, {"type": "subtitle", "time": 4849.149, "timestamp": "01:20:49", "text": "ある意味、それは貯蓄のようなものだと知っている"}, {"type": "subtitle", "time": 4852.07, "timestamp": "01:20:52", "text": "世界か何か、それが彼らが"}, {"type": "subtitle", "time": 4853.51, "timestamp": "01:20:53", "text": "私の"}, {"type": "subtitle", "time": 4859.55, "timestamp": "01:20:59", "text": "世界だけど、でも、でも、知ってるでしょ、私は"}]
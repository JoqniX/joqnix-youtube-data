[{"type": "subtitle", "time": 8162.27, "timestamp": "02:16:02", "text": "EVは悪が滅びる、それは長い"}, {"type": "subtitle", "time": 8167.35, "timestamp": "02:16:07", "text": "落ちる それは私のもの 下へ 私の 下へ 私の"}, {"type": "subtitle", "time": 8170.47, "timestamp": "02:16:10", "text": "下へ、えーっと、文字通り下を見て、"}, {"type": "subtitle", "time": 8173.069, "timestamp": "02:16:13", "text": "私の、いやいやいやいや、戻って戻って戻って"}, {"type": "subtitle", "time": 8176.31, "timestamp": "02:16:16", "text": "バックバックバックバックリバースルックすべて"}, {"type": "subtitle", "time": 8179.91, "timestamp": "02:16:19", "text": "つるはしを使って下へ左へ"}, {"type": "subtitle", "time": 8182.35, "timestamp": "02:16:22", "text": "左をクリック"}, {"type": "subtitle", "time": 8192.429, "timestamp": "02:16:32", "text": "下がって、それはかなり高いところからの落下だ、死ぬぞ"}, {"type": "subtitle", "time": 8194.509, "timestamp": "02:16:34", "text": "あなたが知っているすべてのこと、何が来るか"}, {"type": "subtitle", "time": 8199.83, "timestamp": "02:16:39", "text": "戻って、つるはしがないんだ。"}, {"type": "subtitle", "time": 8202.549, "timestamp": "02:16:42", "text": "これをやるだけ、いや、これも怖い"}, {"type": "subtitle", "time": 8204.429, "timestamp": "02:16:44", "text": "えーと、私たちは"}, {"type": "subtitle", "time": 8207.19, "timestamp": "02:16:47", "text": "ああ、つるはしが必要だ"}, {"type": "subtitle", "time": 8211.03, "timestamp": "02:16:51", "text": "つるはしが必要なんだけど、予備持ってる？"}, {"type": "subtitle", "time": 8214.99, "timestamp": "02:16:54", "text": "ちょっと待って、見てみます。持っていないと思います。"}, {"type": "subtitle", "time": 8217.27, "timestamp": "02:16:57", "text": "大丈夫です"}]
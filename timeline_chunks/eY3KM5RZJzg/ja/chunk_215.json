[{"type": "subtitle", "time": 12901.75, "timestamp": "03:35:01", "text": "人生は"}, {"type": "subtitle", "time": 12905.189, "timestamp": "03:35:05", "text": "[音楽]"}, {"type": "subtitle", "time": 12908.63, "timestamp": "03:35:08", "text": "f ジョー、ごめんなさい、ただ愛情を込めて"}, {"type": "subtitle", "time": 12910.269, "timestamp": "03:35:10", "text": "あなたに"}, {"type": "subtitle", "time": 12913.15, "timestamp": "03:35:13", "text": "鼓動するハミング、君は知っている、君は知っている"}, {"type": "subtitle", "time": 12918.469, "timestamp": "03:35:18", "text": "えっと、何、何、私たちはただの王様だった"}, {"type": "subtitle", "time": 12920.91, "timestamp": "03:35:20", "text": "そうですね"}, {"type": "subtitle", "time": 12923.63, "timestamp": "03:35:23", "text": "スウキプレス"}, {"type": "subtitle", "time": 12927.229, "timestamp": "03:35:27", "text": "G ああ、ハンマーを押しっぱなしにしたんですね"}, {"type": "subtitle", "time": 12930.03, "timestamp": "03:35:30", "text": "手を押して"}, {"type": "subtitle", "time": 12938.79, "timestamp": "03:35:38", "text": "えっと、これって何をするの？あ、待って"}, {"type": "subtitle", "time": 12942.63, "timestamp": "03:35:42", "text": "見せてあげるよ、これ見て、いい？"}, {"type": "subtitle", "time": 12955.309, "timestamp": "03:35:55", "text": "変化ですね、えっと、もしそうなら、ええ、"}, {"type": "subtitle", "time": 12957.83, "timestamp": "03:35:57", "text": "切り替えることができる"}]
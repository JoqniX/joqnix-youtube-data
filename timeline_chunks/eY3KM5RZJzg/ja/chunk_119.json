[{"type": "subtitle", "time": 7145.709, "timestamp": "01:59:05", "text": "サブスファックオーマイゴッドなぜこの壁は"}, {"type": "subtitle", "time": 7147.31, "timestamp": "01:59:07", "text": "残酷な"}, {"type": "subtitle", "time": 7149.55, "timestamp": "01:59:09", "text": "カメは焼かれることはない"}, {"type": "subtitle", "time": 7151.43, "timestamp": "01:59:11", "text": "このカメ"}, {"type": "subtitle", "time": 7155.189, "timestamp": "01:59:15", "text": "ゲーム、それは本当、それは本当、わかった、何"}, {"type": "subtitle", "time": 7157.79, "timestamp": "01:59:17", "text": "ああ、待って、あれは牛？ああ、そこに牛がいる"}, {"type": "subtitle", "time": 7159.75, "timestamp": "01:59:19", "text": "待って、あれは馬だよ、馬は"}, {"type": "subtitle", "time": 7163.069, "timestamp": "01:59:23", "text": "ローストされた彼らはローストされることができるのか"}, {"type": "subtitle", "time": 7165.87, "timestamp": "01:59:25", "text": "いいえ、彼らはそうしません、彼らはそうしません、わかりました、もし私が"}, {"type": "subtitle", "time": 7167.589, "timestamp": "01:59:27", "text": "刀を渡すが、"}, {"type": "subtitle", "time": 7169.75, "timestamp": "01:59:29", "text": "家に帰って、何も言わないで"}, {"type": "subtitle", "time": 7171.189, "timestamp": "01:59:31", "text": "チームメンバーと最初の"}, {"type": "subtitle", "time": 7174.51, "timestamp": "01:59:34", "text": "君がやることは、私が殺せないものを殺すことだ"}, {"type": "subtitle", "time": 7176.47, "timestamp": "01:59:36", "text": "私が守るべき人たち"}, {"type": "subtitle", "time": 7179.87, "timestamp": "01:59:39", "text": "つまり、それは刀のためだよ。"}, {"type": "subtitle", "time": 7181.79, "timestamp": "01:59:41", "text": "いやいやいや、ダメだ"}, {"type": "subtitle", "time": 7184.55, "timestamp": "01:59:44", "text": "戻ってTNTをやるよ"}, {"type": "subtitle", "time": 7187.87, "timestamp": "01:59:47", "text": "TNTみたいなやつ、よし、全部"}, {"type": "subtitle", "time": 7190.55, "timestamp": "01:59:50", "text": "そうだ、TNTをくれれば、"}, {"type": "subtitle", "time": 7193.31, "timestamp": "01:59:53", "text": "爆破しなければならない"}, {"type": "subtitle", "time": 7194.99, "timestamp": "01:59:54", "text": "自分の家で、トイレットペーパーを"}, {"type": "subtitle", "time": 7197.709, "timestamp": "01:59:57", "text": "君は大丈夫だよ"}]
[{"type": "subtitle", "time": 2941.75, "timestamp": "00:49:01", "text": "それをクランクアップできるので、ソリディア"}, {"type": "subtitle", "time": 2945.03, "timestamp": "00:49:05", "text": "ソリディアにそれをクランクするように指示して"}, {"type": "subtitle", "time": 2947.71, "timestamp": "00:49:07", "text": "ソルジャって何？"}, {"type": "subtitle", "time": 2957.47, "timestamp": "00:49:17", "text": "少年、兵士とは何か"}, {"type": "subtitle", "time": 2959.91, "timestamp": "00:49:19", "text": "男の子"}, {"type": "subtitle", "time": 2961.01, "timestamp": "00:49:21", "text": "おい"}, {"type": "chat", "time": 2963.749, "timestamp": "00:49:23", "author": "@Back2005", "avatar": "https://yt4.ggpht.com/TUs_4eRxRjlVzlXUYnX60TXdeAhcF6DoQ2WfJraVpgcKoWcXvMAWUx0pU_9A7UkQz99bCYkx5w=s64-c-k-c0x00ffffff-no-rj", "message": "i dont know either"}, {"type": "subtitle", "time": 2968.349, "timestamp": "00:49:28", "text": "ソウル・ソー・ソジャ"}, {"type": "subtitle", "time": 2976.67, "timestamp": "00:49:36", "text": "知っているけど、私が知っているのは"}, {"type": "subtitle", "time": 2978.87, "timestamp": "00:49:38", "text": "私が知っているのはそれだけです"}, {"type": "subtitle", "time": 2982.069, "timestamp": "00:49:42", "text": "旅行者は"}, {"type": "subtitle", "time": 2986.349, "timestamp": "00:49:46", "text": "ビルダー ビルダー ああ、ビルダーを建てる"}, {"type": "subtitle", "time": 2991.829, "timestamp": "00:49:51", "text": "えっと、エラー時代ではないけど、彼は"}, {"type": "subtitle", "time": 2993.99, "timestamp": "00:49:53", "text": "読んだ本のレベルの低さを忘れてしまった"}, {"type": "subtitle", "time": 2995.51, "timestamp": "00:49:55", "text": "昨日、なぜ私は短いダウンタイムを経験しましたか？"}]
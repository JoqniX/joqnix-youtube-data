[{"type": "subtitle", "time": 12242.189, "timestamp": "03:24:02", "text": "ズキ"}, {"type": "subtitle", "time": 12245.95, "timestamp": "03:24:05", "text": "こんにちは、ようこそ。では、これから作業を進めていきます。"}, {"type": "subtitle", "time": 12249.429, "timestamp": "03:24:09", "text": "リソースを入手しました"}, {"type": "subtitle", "time": 12251.83, "timestamp": "03:24:11", "text": "必要ですか"}, {"type": "subtitle", "time": 12254.87, "timestamp": "03:24:14", "text": "クエストってどういう意味？私のクエスト、私はとても"}, {"type": "subtitle", "time": 12257.309, "timestamp": "03:24:17", "text": "混乱している"}, {"type": "subtitle", "time": 12260.15, "timestamp": "03:24:20", "text": "クエストって何？クエスト何ももらえなかったんだけど"}, {"type": "subtitle", "time": 12262.91, "timestamp": "03:24:22", "text": "世界を探索するクエスト"}, {"type": "subtitle", "time": 12265.87, "timestamp": "03:24:25", "text": "自分で手に入れる"}, {"type": "subtitle", "time": 12269.87, "timestamp": "03:24:29", "text": "クエスト 私たち３人全員"}, {"type": "subtitle", "time": 12273.91, "timestamp": "03:24:33", "text": "クエストでは、チームとして行動する必要があります"}, {"type": "subtitle", "time": 12277.11, "timestamp": "03:24:37", "text": "プラス個別のクエスト"}, {"type": "subtitle", "time": 12279.87, "timestamp": "03:24:39", "text": "冒険的、ああ、そうそう、探求の話といえば"}, {"type": "subtitle", "time": 12282.229, "timestamp": "03:24:42", "text": "チームクエストがあるんだけど、知ってる？"}, {"type": "subtitle", "time": 12286.91, "timestamp": "03:24:46", "text": "えーと"}, {"type": "subtitle", "time": 12289.309, "timestamp": "03:24:49", "text": "君は何を知っているんだ？"}, {"type": "subtitle", "time": 12292.79, "timestamp": "03:24:52", "text": "ドラゴナは、えーと、プレイヤーの名前です"}, {"type": "subtitle", "time": 12296.309, "timestamp": "03:24:56", "text": "ドラゴナは現在、多くの点でOPです"}, {"type": "subtitle", "time": 12298.99, "timestamp": "03:24:58", "text": "物事が起こり、私たちのチームにはクエストが与えられました"}, {"type": "subtitle", "time": 12299.83, "timestamp": "03:24:59", "text": "チーム"}]
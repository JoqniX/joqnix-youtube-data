[{"type": "subtitle", "time": 7263.43, "timestamp": "02:01:03", "text": "サーバーを一度リセットして、それからえーっと"}, {"type": "subtitle", "time": 7266.31, "timestamp": "02:01:06", "text": "これはまさに私を"}, {"type": "subtitle", "time": 7269.03, "timestamp": "02:01:09", "text": "1ブロックか2000ブロックのところで私は"}, {"type": "subtitle", "time": 7270.79, "timestamp": "02:01:10", "text": "全く異なるバイオームで、私は"}, {"type": "subtitle", "time": 7272.95, "timestamp": "02:01:12", "text": "マジで、こんなのやってられないよ"}, {"type": "subtitle", "time": 7275.39, "timestamp": "02:01:15", "text": "これも私に起こったことなので"}, {"type": "subtitle", "time": 7277.95, "timestamp": "02:01:17", "text": "何度も、そしてそれが起こったらいいのにと思います"}, {"type": "subtitle", "time": 7280.75, "timestamp": "02:01:20", "text": "私が一番必要としていたのは、私が死んだ時だった"}, {"type": "subtitle", "time": 7283.27, "timestamp": "02:01:23", "text": "ラグが発生したとき"}, {"type": "subtitle", "time": 7291.15, "timestamp": "02:01:31", "text": "しなかった"}, {"type": "subtitle", "time": 7292.55, "timestamp": "02:01:32", "text": "[音楽]"}, {"type": "subtitle", "time": 7298.149, "timestamp": "02:01:38", "text": "俺も武器をなくしちゃったよ"}, {"type": "subtitle", "time": 7302.109, "timestamp": "02:01:42", "text": "まあ、時には対処しなければならないこともある"}, {"type": "subtitle", "time": 7304.069, "timestamp": "02:01:44", "text": "これで私たちは"}, {"type": "subtitle", "time": 7306.149, "timestamp": "02:01:46", "text": "もうすぐテレポートするから、待っててね"}, {"type": "subtitle", "time": 7309.55, "timestamp": "02:01:49", "text": "魔法が起こるのを待って"}, {"type": "subtitle", "time": 7311.55, "timestamp": "02:01:51", "text": "その間、私はあなたにこれをやってもらいたいだけです"}, {"type": "subtitle", "time": 7312.99, "timestamp": "02:01:52", "text": "知る"}, {"type": "subtitle", "time": 7315.149, "timestamp": "02:01:55", "text": "ああ、彼は"}]
[{"type": "subtitle", "time": 1684.95, "timestamp": "00:28:04", "text": "えっと、水中を滑ることはできないんです。"}, {"type": "subtitle", "time": 1687.549, "timestamp": "00:28:07", "text": "それは最悪だ"}, {"type": "subtitle", "time": 1690.99, "timestamp": "00:28:10", "text": "最悪だ、タップできない、あ、タップできるよ、スプレー"}, {"type": "subtitle", "time": 1692.35, "timestamp": "00:28:12", "text": "待って"}, {"type": "subtitle", "time": 1696.59, "timestamp": "00:28:16", "text": "できない、タップスプレーできない、できる"}, {"type": "subtitle", "time": 1707.11, "timestamp": "00:28:27", "text": "あなた、私はできる"}, {"type": "subtitle", "time": 1710.23, "timestamp": "00:28:30", "text": "stve ああ、なんてことだ"}]
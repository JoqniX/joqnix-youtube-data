[{"type": "subtitle", "time": 6842.709, "timestamp": "01:54:02", "text": "冗談だよ、冗談だよ、冗談だよ"}, {"type": "subtitle", "time": 6844.99, "timestamp": "01:54:04", "text": "それは別の場所にあると思います。私はSPを設定しました"}, {"type": "subtitle", "time": 6846.91, "timestamp": "01:54:06", "text": "村にスポーンするか、"}, {"type": "subtitle", "time": 6849.83, "timestamp": "01:54:09", "text": "何か知っていること、どこへ行くべきか"}, {"type": "subtitle", "time": 6854.189, "timestamp": "01:54:14", "text": "少なくとも、私は目的をすべて失った"}, {"type": "subtitle", "time": 6856.109, "timestamp": "01:54:16", "text": "人生において"}, {"type": "subtitle", "time": 6859.79, "timestamp": "01:54:19", "text": "行ってしまった、ああ、わかった、わかった、今"}, {"type": "subtitle", "time": 6861.95, "timestamp": "01:54:21", "text": "私がやっていることは、なぜ私が"}, {"type": "subtitle", "time": 6863.39, "timestamp": "01:54:23", "text": "あなたのもとへやって来ました"}, {"type": "subtitle", "time": 6868.589, "timestamp": "01:54:28", "text": "今日はコンソールのように"}, {"type": "subtitle", "time": 6871.79, "timestamp": "01:54:31", "text": "私に「大丈夫だよ、兵士が来て」と言いましょう"}, {"type": "subtitle", "time": 6875.55, "timestamp": "01:54:35", "text": "あなたを拷問するためにここに来たのよ、ああ、なんてことだ"}, {"type": "subtitle", "time": 6878.189, "timestamp": "01:54:38", "text": "ああ、これを見て"}, {"type": "subtitle", "time": 6882.189, "timestamp": "01:54:42", "text": "今私の手にある刀はこれです"}, {"type": "subtitle", "time": 6884.35, "timestamp": "01:54:44", "text": "1つ目、これはあなたが手に入れるのに役立ちます"}, {"type": "subtitle", "time": 6885.95, "timestamp": "01:54:45", "text": "おそらくこれは"}, {"type": "subtitle", "time": 6887.589, "timestamp": "01:54:47", "text": "かなり強力な刀で、炎を放つ"}, {"type": "subtitle", "time": 6891.709, "timestamp": "01:54:51", "text": "その側面は、炎をまとったダイヤモンドカタナです。"}, {"type": "subtitle", "time": 6892.99, "timestamp": "01:54:52", "text": "側面"}, {"type": "subtitle", "time": 6895.99, "timestamp": "01:54:55", "text": "ああ、あなたはこういうのが欲しいんですね。私も欲しいです。"}, {"type": "subtitle", "time": 6897.83, "timestamp": "01:54:57", "text": "願い"}]
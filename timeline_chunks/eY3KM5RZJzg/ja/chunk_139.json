[{"type": "subtitle", "time": 8341.79, "timestamp": "02:19:01", "text": "下がれないよ、やばい、俺は死んだ、俺は"}, {"type": "subtitle", "time": 8344.669, "timestamp": "02:19:04", "text": "私はここにいる、死なないで、お願い"}, {"type": "subtitle", "time": 8348.509, "timestamp": "02:19:08", "text": "はい、私はここにいます、私はここにいます、待ってください"}, {"type": "subtitle", "time": 8351.429, "timestamp": "02:19:11", "text": "確かにそれは長い落下だ、わかった。"}, {"type": "subtitle", "time": 8354.469, "timestamp": "02:19:14", "text": "時間はたっぷりあるから、"}, {"type": "subtitle", "time": 8355.87, "timestamp": "02:19:15", "text": "1"}, {"type": "subtitle", "time": 8359.469, "timestamp": "02:19:19", "text": "ブロック、そう、それは"}, {"type": "subtitle", "time": 8364.19, "timestamp": "02:19:24", "text": "いいよ、ああ、なんてことだ、これは素晴らしい"}, {"type": "subtitle", "time": 8381.19, "timestamp": "02:19:41", "text": "ああ、怖い。見つからないことを願う。"}, {"type": "subtitle", "time": 8384.669, "timestamp": "02:19:44", "text": "ゾンビよ、どうか私のところに来ないでくれ"}, {"type": "subtitle", "time": 8387.15, "timestamp": "02:19:47", "text": "ゾンビ、ただ場所を明るくして"}]
[{"type": "subtitle", "time": 17761.47, "timestamp": "04:56:01", "text": "今日は皆さん、どんな一日でしたか？"}, {"type": "subtitle", "time": 17765.11, "timestamp": "04:56:05", "text": "人生はどうだったか、物事はどうだったか"}, {"type": "subtitle", "time": 17768.51, "timestamp": "04:56:08", "text": "皆さん、お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 17772.03, "timestamp": "04:56:12", "text": "それで、まあ、"}, {"type": "subtitle", "time": 17775.868, "timestamp": "04:56:15", "text": "まさにその通りだと思います。"}, {"type": "subtitle", "time": 17779.788, "timestamp": "04:56:19", "text": "完了 M"}, {"type": "subtitle", "time": 17784.23, "timestamp": "04:56:24", "text": "スチュ、ええ、ちょっと何かさせてください"}, {"type": "subtitle", "time": 17786.55, "timestamp": "04:56:26", "text": "すぐに"}, {"type": "subtitle", "time": 17815.35, "timestamp": "04:56:55", "text": "[音楽]"}]
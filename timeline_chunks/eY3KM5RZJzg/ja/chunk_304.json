[{"type": "subtitle", "time": 18240.51, "timestamp": "05:04:00", "text": "競争力"}, {"type": "subtitle", "time": 18244.27, "timestamp": "05:04:04", "text": "はい、チームプレイモードです。それで、私は"}, {"type": "subtitle", "time": 18257.548, "timestamp": "05:04:17", "text": "インストール"}, {"type": "subtitle", "time": 18265.75, "timestamp": "05:04:25", "text": "私が好きなゲームは、あなたが育てる場所です。"}, {"type": "subtitle", "time": 18297.548, "timestamp": "05:04:57", "text": "手に入れた、手に入れた、手に入れた、手に入れた"}]
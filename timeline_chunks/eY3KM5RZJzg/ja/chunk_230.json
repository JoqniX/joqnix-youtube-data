[{"type": "subtitle", "time": 13801.469, "timestamp": "03:50:01", "text": "なぜですか？すぐ戻ります"}, {"type": "subtitle", "time": 13805.11, "timestamp": "03:50:05", "text": "わからない、私はとても"}, {"type": "subtitle", "time": 13808.87, "timestamp": "03:50:08", "text": "ごめんなさい、私はとても"}, {"type": "subtitle", "time": 13812.469, "timestamp": "03:50:12", "text": "何が起こったのか傷ついたのはユーチューバーだ"}, {"type": "subtitle", "time": 13815.269, "timestamp": "03:50:15", "text": "マトゥリと呼ばれる"}, {"type": "subtitle", "time": 13822.229, "timestamp": "03:50:22", "text": "人生、何が起こったのか、あなたはただ"}, {"type": "subtitle", "time": 13824.07, "timestamp": "03:50:24", "text": "電話"}, {"type": "subtitle", "time": 13829.07, "timestamp": "03:50:29", "text": "メイ、私の脳は常に"}, {"type": "subtitle", "time": 13834.429, "timestamp": "03:50:34", "text": "大丈夫、私は64を持っています"}, {"type": "subtitle", "time": 13839.269, "timestamp": "03:50:39", "text": "ライトが64個もあるので、私も"}, {"type": "subtitle", "time": 13841.51, "timestamp": "03:50:41", "text": "もっとトーチを作るべきだと思う"}, {"type": "subtitle", "time": 13845.189, "timestamp": "03:50:45", "text": "正直に言うと、私はいくつかのリソースを入手します"}, {"type": "subtitle", "time": 13849.99, "timestamp": "03:50:49", "text": "B いや、私を信じて。私は42歳です"}, {"type": "subtitle", "time": 13851.95, "timestamp": "03:50:51", "text": "BS 私はたくさん持っています"}, {"type": "subtitle", "time": 13855.11, "timestamp": "03:50:55", "text": "物 ああ、あなたはすでに石炭を持っていますか 私は"}]
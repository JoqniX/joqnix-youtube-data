[{"type": "subtitle", "time": 9841.59, "timestamp": "02:44:01", "text": "以下にあなたの"}, {"type": "subtitle", "time": 9844.349, "timestamp": "02:44:04", "text": "心臓 それらの数はいくつですか"}, {"type": "subtitle", "time": 9848.99, "timestamp": "02:44:08", "text": "緑色の数字があります。"}, {"type": "subtitle", "time": 9850.79, "timestamp": "02:44:10", "text": "それ"}, {"type": "subtitle", "time": 9853.51, "timestamp": "02:44:13", "text": "何もないよ、待って、待って、君のに飛び乗るよ"}, {"type": "subtitle", "time": 9856.59, "timestamp": "02:44:16", "text": "ちょっとだけストリーミング"}, {"type": "subtitle", "time": 9867.23, "timestamp": "02:44:27", "text": "ただ私に"}, {"type": "subtitle", "time": 9869.79, "timestamp": "02:44:29", "text": "大丈夫ですか、何も持っていないのですか"}, {"type": "subtitle", "time": 9877.11, "timestamp": "02:44:37", "text": "何も持っていないのに待って"}, {"type": "subtitle", "time": 9881.63, "timestamp": "02:44:41", "text": "ジョー、少し動いて、動いて、AIT、わかった、わかった"}, {"type": "subtitle", "time": 9883.83, "timestamp": "02:44:43", "text": "わかりました、それは"}, {"type": "subtitle", "time": 9887.99, "timestamp": "02:44:47", "text": "つまり、レベルが必要なのです。"}, {"type": "subtitle", "time": 9890.23, "timestamp": "02:44:50", "text": "君は、君が見たかもしれない"}, {"type": "subtitle", "time": 9893.07, "timestamp": "02:44:53", "text": "ゾンビを殺したとき、彼らは"}, {"type": "subtitle", "time": 9895.429, "timestamp": "02:44:55", "text": "緑のボールをいくつかドロップします。緑のドット"}, {"type": "subtitle", "time": 9898.03, "timestamp": "02:44:58", "text": "ボール、そう、あれは経験だ"}]
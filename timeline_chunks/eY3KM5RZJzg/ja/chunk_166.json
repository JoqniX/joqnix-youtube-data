[{"type": "subtitle", "time": 9968.87, "timestamp": "02:46:08", "text": "えっと、経験値コストは6と書いてあります"}, {"type": "subtitle", "time": 9972.03, "timestamp": "02:46:12", "text": "レベルの材料費6周はLですが"}, {"type": "subtitle", "time": 9975.389, "timestamp": "02:46:15", "text": "材料費6鉄は赤なので"}, {"type": "subtitle", "time": 9987.389, "timestamp": "02:46:27", "text": "[音楽]"}, {"type": "subtitle", "time": 9991.59, "timestamp": "02:46:31", "text": "どこへ行ったの？どこにあるの？ああ、トップに立つ"}, {"type": "subtitle", "time": 9994.429, "timestamp": "02:46:34", "text": "私はここにいます 私はここにいます"}, {"type": "subtitle", "time": 9998.469, "timestamp": "02:46:38", "text": "待って、じゃあ彼らはこれをやったんだと思う"}, {"type": "subtitle", "time": 10002.11, "timestamp": "02:46:42", "text": "R 彼らはコストを変更しました。これを受け取ってください"}, {"type": "subtitle", "time": 10006.67, "timestamp": "02:46:46", "text": "そして、この魔法のついたものを手に入れよう"}, {"type": "subtitle", "time": 10010.07, "timestamp": "02:46:50", "text": "私は大丈夫"}]
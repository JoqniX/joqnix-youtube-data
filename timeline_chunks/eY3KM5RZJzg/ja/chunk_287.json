[{"type": "subtitle", "time": 17230.59, "timestamp": "04:47:10", "text": "いいですね、だから、あぁ、あぁ、待って"}, {"type": "subtitle", "time": 17234.23, "timestamp": "04:47:14", "text": "行く前に普通の武器は"}, {"type": "subtitle", "time": 17237.03, "timestamp": "04:47:17", "text": "スタック ノーマル エンチャント"}, {"type": "subtitle", "time": 17240.35, "timestamp": "04:47:20", "text": "通常のMinecraftではエンチャントは1つだけです"}, {"type": "subtitle", "time": 17241.35, "timestamp": "04:47:21", "text": "1つ"}, {"type": "subtitle", "time": 17243.59, "timestamp": "04:47:23", "text": "武器"}, {"type": "subtitle", "time": 17246.39, "timestamp": "04:47:26", "text": "わあ、二刀流はどうですか？"}, {"type": "subtitle", "time": 17249.67, "timestamp": "04:47:29", "text": "バックパックシステムアイテムはどうでしょうか"}, {"type": "subtitle", "time": 17254.47, "timestamp": "04:47:34", "text": "スポナーマジックバックパック、ああ神様"}, {"type": "subtitle", "time": 17256.868, "timestamp": "04:47:36", "text": "洗濯しすぎ"}, {"type": "subtitle", "time": 17259.708, "timestamp": "04:47:39", "text": "さあ、おやすみなさい、バカ、こんにちは、おやすみなさい"}, {"type": "subtitle", "time": 17264.75, "timestamp": "04:47:44", "text": "ズキ、食べに行こう、実は食べてないんだ"}]
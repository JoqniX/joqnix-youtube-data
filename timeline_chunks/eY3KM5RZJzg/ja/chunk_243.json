[{"type": "subtitle", "time": 14581.03, "timestamp": "04:03:01", "text": "クエスト、君たちには言わないで、君たち"}, {"type": "subtitle", "time": 14583.95, "timestamp": "04:03:03", "text": "自分の声が聞こえない"}, {"type": "subtitle", "time": 14586.91, "timestamp": "04:03:06", "text": "こんにちは、こんにちは、聞こえますよ、"}, {"type": "subtitle", "time": 14591.91, "timestamp": "04:03:11", "text": "ところで、食べ物が必要なんです"}, {"type": "subtitle", "time": 14594.389, "timestamp": "04:03:14", "text": "死ぬと、聞くことができなくなる"}, {"type": "subtitle", "time": 14596.79, "timestamp": "04:03:16", "text": "君たち、そうだね、知っておく方がいいよ"}, {"type": "subtitle", "time": 14600.11, "timestamp": "04:03:20", "text": "右に進むように"}, {"type": "subtitle", "time": 14604.71, "timestamp": "04:03:24", "text": "さあ、彼女は何て言ったの？"}, {"type": "subtitle", "time": 14616.87, "timestamp": "04:03:36", "text": "あ、そういえばもうすぐ新しいの"}, {"type": "subtitle", "time": 14618.79, "timestamp": "04:03:38", "text": "そうですね"}, {"type": "subtitle", "time": 14623.03, "timestamp": "04:03:43", "text": "どんなゲームをプレイする予定ですか？"}, {"type": "subtitle", "time": 14625.67, "timestamp": "04:03:45", "text": "みんな、"}, {"type": "subtitle", "time": 14628.51, "timestamp": "04:03:48", "text": "ベッド なぜベッドが欲しいのですか ええと、私たちはベッドが必要です"}, {"type": "subtitle", "time": 14630.87, "timestamp": "04:03:50", "text": "採掘中または採掘中にチェックポイント"}, {"type": "subtitle", "time": 14633.55, "timestamp": "04:03:53", "text": "私たちが考えていないこと"}, {"type": "subtitle", "time": 14637.269, "timestamp": "04:03:57", "text": "ベッドは元の場所に送られます"}]
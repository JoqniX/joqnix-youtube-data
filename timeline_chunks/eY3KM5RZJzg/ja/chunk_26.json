[{"type": "subtitle", "time": 1565.95, "timestamp": "00:26:05", "text": "我々が探求していることに関して"}, {"type": "subtitle", "time": 1567.789, "timestamp": "00:26:07", "text": "素晴らしい"}, {"type": "subtitle", "time": 1587.389, "timestamp": "00:26:27", "text": "何が起こっているのか、ゲームはどうなのか、私たちはただ"}, {"type": "subtitle", "time": 1589.389, "timestamp": "00:26:29", "text": "音楽を作り始めた"}, {"type": "subtitle", "time": 1593.83, "timestamp": "00:26:33", "text": "以前のサウンドデザインなどは"}, {"type": "subtitle", "time": 1600.99, "timestamp": "00:26:40", "text": "ビートについては、取り組んでみます。"}, {"type": "subtitle", "time": 1603.789, "timestamp": "00:26:43", "text": "明日、たくさん必要だから"}, {"type": "subtitle", "time": 1606.99, "timestamp": "00:26:46", "text": "時間、私も保存できなかったのは"}, {"type": "subtitle", "time": 1609.35, "timestamp": "00:26:49", "text": "無料トライアル版を使っています。"}, {"type": "subtitle", "time": 1612.35, "timestamp": "00:26:52", "text": "Ailton Lifeの購読を再開する"}, {"type": "subtitle", "time": 1614.47, "timestamp": "00:26:54", "text": "でも今、マインクラフトを始めると"}, {"type": "subtitle", "time": 1617.31, "timestamp": "00:26:57", "text": "今のところ順調です。私たちにはやるべきクエストがあります。"}]
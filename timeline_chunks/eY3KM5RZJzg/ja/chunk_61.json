[{"type": "subtitle", "time": 3663.71, "timestamp": "01:01:03", "text": "極地　私はあなたの星座"}, {"type": "subtitle", "time": 3666.67, "timestamp": "01:01:06", "text": "気をつけて"}, {"type": "subtitle", "time": 3697.27, "timestamp": "01:01:37", "text": "ああ、これ知ってるよ"}, {"type": "subtitle", "time": 3700.95, "timestamp": "01:01:40", "text": "子供たち、昨日私の"}, {"type": "subtitle", "time": 3704.87, "timestamp": "01:01:44", "text": "旅を通して自分の使命を見つける"}, {"type": "subtitle", "time": 3712.63, "timestamp": "01:01:52", "text": "与えられた"}, {"type": "subtitle", "time": 3717.829, "timestamp": "01:01:57", "text": "いやいやいやいや"}]
[{"type": "subtitle", "time": 11881.389, "timestamp": "03:18:01", "text": "魚、ああ、ああ、完全に忘れてた"}, {"type": "subtitle", "time": 11884.03, "timestamp": "03:18:04", "text": "ああ、神様、12時になるよ、ああ"}, {"type": "subtitle", "time": 11887.59, "timestamp": "03:18:07", "text": "神様、そして私はまだストリーミングしています"}, {"type": "subtitle", "time": 11890.95, "timestamp": "03:18:10", "text": "いいえ、チャットで水を飲むように言われています"}, {"type": "subtitle", "time": 11892.95, "timestamp": "03:18:12", "text": "なぜなら、今気づいたのですが、私はお酒を飲んでいません"}, {"type": "subtitle", "time": 11895.63, "timestamp": "03:18:15", "text": "水、ああ、水を飲まなくちゃ。ありがとう。"}, {"type": "subtitle", "time": 11897.469, "timestamp": "03:18:17", "text": "思い出させてくれてありがとう。私も飲むのを忘れてた。"}, {"type": "subtitle", "time": 11898.99, "timestamp": "03:18:18", "text": "6人分の水"}, {"type": "subtitle", "time": 11909.429, "timestamp": "03:18:29", "text": "ああ、"}, {"type": "subtitle", "time": 11920.349, "timestamp": "03:18:40", "text": "tped おお、わあ、わかった、いいね、行こう"}, {"type": "subtitle", "time": 11924.189, "timestamp": "03:18:44", "text": "いすきずきはまだここにいません"}, {"type": "subtitle", "time": 11927.63, "timestamp": "03:18:47", "text": "彼女は少ししたら来るでしょう"}, {"type": "subtitle", "time": 11931.269, "timestamp": "03:18:51", "text": "じゃあ、水を飲ませてください。"}, {"type": "subtitle", "time": 11933.87, "timestamp": "03:18:53", "text": "飲料水"}, {"type": "subtitle", "time": 11936.83, "timestamp": "03:18:56", "text": "私はとても少ない"}]
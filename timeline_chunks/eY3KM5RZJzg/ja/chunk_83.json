[{"type": "subtitle", "time": 4987.11, "timestamp": "01:23:07", "text": "まるで私たちが墓場にいたと想像してみてください"}, {"type": "subtitle", "time": 4990.47, "timestamp": "01:23:10", "text": "見つけられただろうし、行っただろう"}, {"type": "subtitle", "time": 4993.229, "timestamp": "01:23:13", "text": "だから私はたくさんのことをしただろう"}, {"type": "subtitle", "time": 4994.27, "timestamp": "01:23:14", "text": "得る"}, {"type": "subtitle", "time": 5001.189, "timestamp": "01:23:21", "text": "グレイブスでは予期せぬことが起こる"}, {"type": "subtitle", "time": 5003.43, "timestamp": "01:23:23", "text": "予期せぬ時間"}, {"type": "subtitle", "time": 5007.149, "timestamp": "01:23:27", "text": "神様が何を知っているか知っている時のように"}, {"type": "subtitle", "time": 5011.55, "timestamp": "01:23:31", "text": "やってみるのは、様子を見て待つようなものだ"}, {"type": "subtitle", "time": 5013.229, "timestamp": "01:23:33", "text": "見る"}, {"type": "subtitle", "time": 5016.51, "timestamp": "01:23:36", "text": "CH 物事は起こる"}, {"type": "subtitle", "time": 5019.149, "timestamp": "01:23:39", "text": "理由は、おそらく"}, {"type": "subtitle", "time": 5024.79, "timestamp": "01:23:44", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 5035.11, "timestamp": "01:23:55", "text": "SCはそれを一般の人々から隠します"}, {"type": "subtitle", "time": 5036.07, "timestamp": "01:23:56", "text": "見た"}]
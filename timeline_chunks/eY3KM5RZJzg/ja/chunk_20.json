[{"type": "subtitle", "time": 1203.549, "timestamp": "00:20:03", "text": "そして、この男を連れて行きます"}, {"type": "subtitle", "time": 1226.909, "timestamp": "00:20:26", "text": "Hじゃないよ、モブがたくさんいるんだ、俺は"}, {"type": "subtitle", "time": 1237.75, "timestamp": "00:20:37", "text": "[音楽]"}, {"type": "subtitle", "time": 1240.029, "timestamp": "00:20:40", "text": "もしそうなら、私は"}, {"type": "subtitle", "time": 1241.35, "timestamp": "00:20:41", "text": "すべき"}, {"type": "subtitle", "time": 1249.789, "timestamp": "00:20:49", "text": "何か、だって無限にあるんだもん"}]
[{"type": "subtitle", "time": 12483.07, "timestamp": "03:28:03", "text": "いいえ、タスク1について説明させてください"}, {"type": "subtitle", "time": 12487.15, "timestamp": "03:28:07", "text": "彼は最初に16個のダイヤモンドに同意したのですか？"}, {"type": "subtitle", "time": 12489.59, "timestamp": "03:28:09", "text": "もし私の記憶が正しければ、私は2つしか持っていませんでした"}, {"type": "subtitle", "time": 12492.429, "timestamp": "03:28:12", "text": "頭金を払いたいと言ったら、彼はこう言った"}, {"type": "subtitle", "time": 12494.71, "timestamp": "03:28:14", "text": "えっと、ちょっと考えさせてください。"}, {"type": "subtitle", "time": 12497.71, "timestamp": "03:28:17", "text": "彼は、爆破できると提案した。"}, {"type": "subtitle", "time": 12500.429, "timestamp": "03:28:20", "text": "洞窟か何か、これは私たちの"}, {"type": "subtitle", "time": 12503.11, "timestamp": "03:28:23", "text": "一時的な住居権なので、すべての部分が"}, {"type": "subtitle", "time": 12507.63, "timestamp": "03:28:27", "text": "洞窟を家と考える権利があるので、私は"}, {"type": "subtitle", "time": 12511.229, "timestamp": "03:28:31", "text": "えっと、SMっぽい演技をしすぎて、"}, {"type": "subtitle", "time": 12514.67, "timestamp": "03:28:34", "text": "VCHをTNTで殺す代わりに"}, {"type": "subtitle", "time": 12518.269, "timestamp": "03:28:38", "text": "えっと、それを私たちの基地の近くに置くので、"}, {"type": "subtitle", "time": 12522.03, "timestamp": "03:28:42", "text": "気づいて、彼は「いや」と言った。"}, {"type": "subtitle", "time": 12524.269, "timestamp": "03:28:44", "text": "ありがたいことに彼はそれを"}, {"type": "subtitle", "time": 12526.83, "timestamp": "03:28:46", "text": "もう少し先なので、"}, {"type": "subtitle", "time": 12530.51, "timestamp": "03:28:50", "text": "ジョー、あなたが"}, {"type": "subtitle", "time": 12534.07, "timestamp": "03:28:54", "text": "ちなみに悪役を演じようとしているのは"}, {"type": "subtitle", "time": 12534.99, "timestamp": "03:28:54", "text": "あなた"}, {"type": "subtitle", "time": 12539.07, "timestamp": "03:28:59", "text": "えっと、あなたはとても読みやすいですね。"}]
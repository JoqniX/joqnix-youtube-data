[{"type": "subtitle", "time": 2520.51, "timestamp": "00:42:00", "text": "見れば見るほど、そして"}, {"type": "subtitle", "time": 2523.15, "timestamp": "00:42:03", "text": "私が見える家"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "ここで私は"}, {"type": "subtitle", "time": 2548.589, "timestamp": "00:42:28", "text": "私には輝かしい目的がある。"}, {"type": "subtitle", "time": 2550.99, "timestamp": "00:42:30", "text": "私は脅迫された目的を持っています"}, {"type": "subtitle", "time": 2559.069, "timestamp": "00:42:39", "text": "ええ、私たちには試みる目的があります"}, {"type": "subtitle", "time": 2562.79, "timestamp": "00:42:42", "text": "そうすれば私たちは"}, {"type": "subtitle", "time": 2566.589, "timestamp": "00:42:46", "text": "私が手に入れたいもの、私が終わらせたいもの"}, {"type": "subtitle", "time": 2569.069, "timestamp": "00:42:49", "text": "内なる探求"}, {"type": "subtitle", "time": 2572.39, "timestamp": "00:42:52", "text": "1時間で会えるので"}, {"type": "subtitle", "time": 2575.79, "timestamp": "00:42:55", "text": "三井みつき 三井ではない"}, {"type": "subtitle", "time": 2578.829, "timestamp": "00:42:58", "text": "ごめんなさい、それは名前ではありませんでした"}]
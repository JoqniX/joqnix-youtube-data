[{"type": "subtitle", "time": 7802.39, "timestamp": "02:10:02", "text": "簡単に集められるものの一つは"}, {"type": "subtitle", "time": 7805.31, "timestamp": "02:10:05", "text": "それは、ああ、できるよ、みたいな感じ？"}, {"type": "subtitle", "time": 7808.229, "timestamp": "02:10:08", "text": "うんうん、そうしないといけないんだ"}, {"type": "subtitle", "time": 7810.99, "timestamp": "02:10:10", "text": "本当に探求するよ、君のためにそうするよ"}, {"type": "subtitle", "time": 7812.95, "timestamp": "02:10:12", "text": "心配しないで、私が行くから"}, {"type": "subtitle", "time": 7815.47, "timestamp": "02:10:15", "text": "探検するなんて、いやいや、なぜそんなことをするんだ？"}, {"type": "subtitle", "time": 7818.149, "timestamp": "02:10:18", "text": "私にはあなたに必要なものがある"}, {"type": "subtitle", "time": 7822.669, "timestamp": "02:10:22", "text": "お見せします、オーケー、オーケー、それで、えっと、どこ"}, {"type": "subtitle", "time": 7827.189, "timestamp": "02:10:27", "text": "彼は最初に行ったのか、彼はどこへ行ったのか"}, {"type": "subtitle", "time": 7829.629, "timestamp": "02:10:29", "text": "どこ"}, {"type": "subtitle", "time": 7831.35, "timestamp": "02:10:31", "text": "えーと"}, {"type": "subtitle", "time": 7834.709, "timestamp": "02:10:34", "text": "わあ、彼は"}, {"type": "subtitle", "time": 7837.31, "timestamp": "02:10:37", "text": "Ser TNT は"}, {"type": "subtitle", "time": 7841.51, "timestamp": "02:10:41", "text": "TNTは私が持っているTのうちの1つです"}, {"type": "subtitle", "time": 7845.109, "timestamp": "02:10:45", "text": "ああ神様、何が起こるか分かるでしょう、こっちに来て"}, {"type": "subtitle", "time": 7846.35, "timestamp": "02:10:46", "text": "さあ来る"}, {"type": "subtitle", "time": 7849.669, "timestamp": "02:10:49", "text": "こっちに来て、そう、見て"}, {"type": "subtitle", "time": 7854.31, "timestamp": "02:10:54", "text": "これを見て、私は3つ持っています"}, {"type": "subtitle", "time": 7857.51, "timestamp": "02:10:57", "text": "エメラル、それはあなたの"}]
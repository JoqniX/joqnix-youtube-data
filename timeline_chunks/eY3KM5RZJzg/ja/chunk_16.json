[{"type": "subtitle", "time": 962.35, "timestamp": "00:16:02", "text": "よりまっすぐにタップする方法を学ぶ"}, {"type": "subtitle", "time": 963.629, "timestamp": "00:16:03", "text": "私はしたくない"}, {"type": "subtitle", "time": 965.829, "timestamp": "00:16:05", "text": "死にたくない"}, {"type": "subtitle", "time": 972.79, "timestamp": "00:16:12", "text": "守る、復讐するはず"}, {"type": "subtitle", "time": 974.949, "timestamp": "00:16:14", "text": "ああ、神様、私は死ぬはず"}, {"type": "subtitle", "time": 978.43, "timestamp": "00:16:18", "text": "物を破壊した者に復讐する"}, {"type": "subtitle", "time": 986.03, "timestamp": "00:16:26", "text": "誰も私の物に触れていないので、ありがとう"}, {"type": "subtitle", "time": 988.47, "timestamp": "00:16:28", "text": "神様、すぐにわかるから"}, {"type": "subtitle", "time": 993.11, "timestamp": "00:16:33", "text": "誰かが死んだ、彼はオイアだ"}, {"type": "subtitle", "time": 997.949, "timestamp": "00:16:37", "text": "最高だが、今日は使命がある"}, {"type": "subtitle", "time": 999.99, "timestamp": "00:16:39", "text": "私たちは"}, {"type": "subtitle", "time": 1005.35, "timestamp": "00:16:45", "text": "ミッション 我々にはミッションがある"}, {"type": "subtitle", "time": 1007.309, "timestamp": "00:16:47", "text": "あ、待って、ミツキがライブ配信するよ"}, {"type": "subtitle", "time": 1009.87, "timestamp": "00:16:49", "text": "もう少しで、ああ神様"}, {"type": "subtitle", "time": 1012.629, "timestamp": "00:16:52", "text": "えっと、どうすればいいの？みんな、どうすればいいの？"}, {"type": "chat", "time": 1013.029, "timestamp": "00:16:53", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "yes misson"}, {"type": "subtitle", "time": 1016.03, "timestamp": "00:16:56", "text": "アイデア、ああ神様、ああ私は"}, {"type": "subtitle", "time": 1019.749, "timestamp": "00:16:59", "text": "ミッション 私はそこに行きたい"}, {"type": "chat", "time": 1019.792, "timestamp": "00:16:59", "author": "@Hero_338", "avatar": "https://yt4.ggpht.com/0uNlIhqsigPTN5hDlTHiX6E1xHNJL_TKrsEvxszwXL5t9cJLNqnfZ0L6Wz1pkyw3Fb-F_l4e=s64-c-k-c0x00ffffff-no-rj", "message": "mission"}]
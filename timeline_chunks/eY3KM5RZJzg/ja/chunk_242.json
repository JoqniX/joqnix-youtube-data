[{"type": "subtitle", "time": 14530.95, "timestamp": "04:02:10", "text": "食べるよ、さあ行こう、私の、私は私の星を持っている"}, {"type": "subtitle", "time": 14534.229, "timestamp": "04:02:14", "text": "ブレーカー、見て、それはスターブレーカーだ、ブリーア"}, {"type": "subtitle", "time": 14544.229, "timestamp": "04:02:24", "text": "鉱業は良いことですか、増加しています"}, {"type": "subtitle", "time": 14547.349, "timestamp": "04:02:27", "text": "マイニング ええと、何人かの人が使っているのを見ました"}, {"type": "subtitle", "time": 14549.389, "timestamp": "04:02:29", "text": "クリエイティブな場所"}, {"type": "subtitle", "time": 14553.11, "timestamp": "04:02:33", "text": "鉄のつるはしに付けたけど、また"}, {"type": "subtitle", "time": 14557.51, "timestamp": "04:02:37", "text": "ほら、私はとても、そして実際に"}, {"type": "subtitle", "time": 14561.79, "timestamp": "04:02:41", "text": "必要なので、死んでいないと思います。待って"}, {"type": "subtitle", "time": 14564.51, "timestamp": "04:02:44", "text": "このXを返してくれ"}, {"type": "subtitle", "time": 14573.469, "timestamp": "04:02:53", "text": "マイニングを待って、なぜあなたが"}, {"type": "subtitle", "time": 14577.87, "timestamp": "04:02:57", "text": "クエストは私ではなく、誰もが手に入れます"}]
[{"type": "subtitle", "time": 12120.349, "timestamp": "03:22:00", "text": "砂利 これは砂利です この物 これ"}, {"type": "subtitle", "time": 12123.59, "timestamp": "03:22:03", "text": "これをブロックする"}, {"type": "subtitle", "time": 12130.429, "timestamp": "03:22:10", "text": "わかった"}, {"type": "subtitle", "time": 12134.79, "timestamp": "03:22:14", "text": "うーん、すごい、私はオークのとても美しいものを持っている"}, {"type": "subtitle", "time": 12142.67, "timestamp": "03:22:22", "text": "ああ、私は夜のスプラッシュ部分を持っている"}, {"type": "subtitle", "time": 12154.07, "timestamp": "03:22:34", "text": "透明化、ああ、それを維持する"}, {"type": "subtitle", "time": 12157.99, "timestamp": "03:22:37", "text": "安全で、文字通り作る必要がある"}, {"type": "subtitle", "time": 12161.67, "timestamp": "03:22:41", "text": "秘密のチェックポイントの場所"}, {"type": "subtitle", "time": 12163.87, "timestamp": "03:22:43", "text": "これ"}, {"type": "subtitle", "time": 12167.189, "timestamp": "03:22:47", "text": "このような洞窟は襲撃される可能性がある"}, {"type": "subtitle", "time": 12169.229, "timestamp": "03:22:49", "text": "何が起こっても分からない"}, {"type": "subtitle", "time": 12173.51, "timestamp": "03:22:53", "text": "起こる、ああ神様、そうだ、私たちが"}, {"type": "subtitle", "time": 12175.429, "timestamp": "03:22:55", "text": "クエストの後には時間があり、"}, {"type": "subtitle", "time": 12178.91, "timestamp": "03:22:58", "text": "私たちができることはすべて、ええ、一度"}]
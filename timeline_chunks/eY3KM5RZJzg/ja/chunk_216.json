[{"type": "subtitle", "time": 12960.349, "timestamp": "03:36:00", "text": "あなたが見ているのはこれらです"}, {"type": "subtitle", "time": 12964.229, "timestamp": "03:36:04", "text": "これは同意です。だから、たとえ死んでも"}, {"type": "subtitle", "time": 12966.59, "timestamp": "03:36:06", "text": "依然としてそのツールが1つあります"}, {"type": "subtitle", "time": 12967.83, "timestamp": "03:36:07", "text": "あなたの"}, {"type": "subtitle", "time": 12972.91, "timestamp": "03:36:12", "text": "戻る、ああ、それはとてもクールだ、そう、今"}, {"type": "subtitle", "time": 12974.389, "timestamp": "03:36:14", "text": "それは今やダイヤモンド1つになる"}, {"type": "subtitle", "time": 12976.11, "timestamp": "03:36:16", "text": "ダイヤモンド1つ"}, {"type": "subtitle", "time": 12980.11, "timestamp": "03:36:20", "text": "そのinf4はダイヤモンド1つです、おいおい"}, {"type": "subtitle", "time": 12982.349, "timestamp": "03:36:22", "text": "私は持っていません"}, {"type": "subtitle", "time": 12985.79, "timestamp": "03:36:25", "text": "ダイヤモンドがあなたについてハミングしているトロールは何を"}, {"type": "subtitle", "time": 12987.79, "timestamp": "03:36:27", "text": "腰を振って"}, {"type": "subtitle", "time": 12990.67, "timestamp": "03:36:30", "text": "え、知ってるでしょ、私は彼を知ってるの"}, {"type": "subtitle", "time": 12994.63, "timestamp": "03:36:34", "text": "4年間、私は文字通り何"}, {"type": "subtitle", "time": 12997.309, "timestamp": "03:36:37", "text": "つまり、私はあなたに会ったということですか？私はあなたたち３人に会ったということですか？"}, {"type": "subtitle", "time": 13000.59, "timestamp": "03:36:40", "text": "数日前、この"}, {"type": "subtitle", "time": 13006.269, "timestamp": "03:36:46", "text": "まったく、私たちの目の前で嘘をついている"}, {"type": "subtitle", "time": 13008.87, "timestamp": "03:36:48", "text": "おい、俺たちはロールしなきゃいけなかったのを忘れてたよ"}, {"type": "subtitle", "time": 13012.269, "timestamp": "03:36:52", "text": "ジョイを忘れて遊んで"}]
[{"type": "subtitle", "time": 7500.99, "timestamp": "02:05:00", "text": "それを受け入れてください、感謝します、ああ神様、貿易は"}, {"type": "subtitle", "time": 7504.31, "timestamp": "02:05:04", "text": "私たちが与えるものを通して既に作られている"}, {"type": "subtitle", "time": 7506.149, "timestamp": "02:05:06", "text": "の"}, {"type": "subtitle", "time": 7507.75, "timestamp": "02:05:07", "text": "戻る"}, {"type": "subtitle", "time": 7510.629, "timestamp": "02:05:10", "text": "はい、ここです、ここです、ここです、ここです"}, {"type": "subtitle", "time": 7514.069, "timestamp": "02:05:14", "text": "支払いとはどういうことですか？何が起こっているのですか？"}, {"type": "subtitle", "time": 7517.109, "timestamp": "02:05:17", "text": "あなたが私に言う必要があるなら、私はあなたにそれを伝えます"}, {"type": "subtitle", "time": 7520.75, "timestamp": "02:05:20", "text": "トレードしたって知ってるだろ、トレードしたんだ、こっちへ来いよ"}, {"type": "subtitle", "time": 7541.589, "timestamp": "02:05:41", "text": "ゴドー、ストリーミング配信してること忘れてた、なんてこった"}, {"type": "subtitle", "time": 7544.27, "timestamp": "02:05:44", "text": "私の言うことを聞いて"}, {"type": "subtitle", "time": 7548.51, "timestamp": "02:05:48", "text": "私に聞いて、私の話を聞いて、ああ神様、聞いて"}, {"type": "subtitle", "time": 7549.75, "timestamp": "02:05:49", "text": "私にとってあなたは"}, {"type": "subtitle", "time": 7551.43, "timestamp": "02:05:51", "text": "エメラルドは取引の一部です。"}, {"type": "subtitle", "time": 7553.589, "timestamp": "02:05:53", "text": "取引の条件として、エメラルドが16個必要だということは分かっているだろう。"}, {"type": "subtitle", "time": 7557.31, "timestamp": "02:05:57", "text": "素敵な剣のために、まず教えてください"}]
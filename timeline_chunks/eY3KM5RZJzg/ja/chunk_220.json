[{"type": "subtitle", "time": 13200.03, "timestamp": "03:40:00", "text": "知らないよ、えー、なんてこった、私はただ"}, {"type": "subtitle", "time": 13203.79, "timestamp": "03:40:03", "text": "自分の声で、"}, {"type": "subtitle", "time": 13205.67, "timestamp": "03:40:05", "text": "できる"}, {"type": "subtitle", "time": 13208.91, "timestamp": "03:40:08", "text": "普段は、今日泣いたから"}, {"type": "subtitle", "time": 13212.15, "timestamp": "03:40:12", "text": "なぜなら、この男のスクリーンをとてもたくさん見たからです"}, {"type": "subtitle", "time": 13214.309, "timestamp": "03:40:14", "text": "怖い"}, {"type": "subtitle", "time": 13218.11, "timestamp": "03:40:18", "text": "今は普通に聞こえるけど、"}, {"type": "subtitle", "time": 13220.229, "timestamp": "03:40:20", "text": "あなたはいくつかの発言をしていました"}, {"type": "subtitle", "time": 13222.75, "timestamp": "03:40:22", "text": "すごく怪しい音だったけど、それは私が"}, {"type": "subtitle", "time": 13224.07, "timestamp": "03:40:24", "text": "役割"}, {"type": "subtitle", "time": 13227.95, "timestamp": "03:40:27", "text": "ロールプレイングをする、君は私が声を出せないと思っている"}, {"type": "subtitle", "time": 13230.83, "timestamp": "03:40:30", "text": "私が学んでいること"}, {"type": "subtitle", "time": 13234.229, "timestamp": "03:40:34", "text": "あなたにガスを吹きかけ、ガス照明を当てる彼女は"}, {"type": "subtitle", "time": 13237.429, "timestamp": "03:40:37", "text": "ガス照明はなぜですか、おいおい、"}, {"type": "subtitle", "time": 13239.429, "timestamp": "03:40:39", "text": "ガス照明が何なのかわかりません"}, {"type": "subtitle", "time": 13242.189, "timestamp": "03:40:42", "text": "大丈夫だよ、君たちは引っ張るのをやめる必要がある"}, {"type": "subtitle", "time": 13245.67, "timestamp": "03:40:45", "text": "もう十分話した"}, {"type": "subtitle", "time": 13248.51, "timestamp": "03:40:48", "text": "いじめっ子たち"}, {"type": "subtitle", "time": 13252.15, "timestamp": "03:40:52", "text": "いつ私をいじめたの？"}, {"type": "subtitle", "time": 13255.91, "timestamp": "03:40:55", "text": "私にオファーをあげます、ああ神様"}, {"type": "subtitle", "time": 13258.95, "timestamp": "03:40:58", "text": "君はハビビの男になりつつある、ああ、私は"}]
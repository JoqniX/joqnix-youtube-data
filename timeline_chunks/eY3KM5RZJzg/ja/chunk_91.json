[{"type": "subtitle", "time": 5462.47, "timestamp": "01:31:02", "text": "タップを始めたのはいつですか？"}, {"type": "subtitle", "time": 5465.83, "timestamp": "01:31:05", "text": "頑張らなきゃ ああ、今なら、もし私が"}, {"type": "subtitle", "time": 5468.07, "timestamp": "01:31:08", "text": "何か良いものを手に入れよう L 私は書くつもりです"}, {"type": "subtitle", "time": 5469.59, "timestamp": "01:31:09", "text": "それを下に"}, {"type": "subtitle", "time": 5472.75, "timestamp": "01:31:12", "text": "ノートまたは"}, {"type": "subtitle", "time": 5482.07, "timestamp": "01:31:22", "text": "ああ"}, {"type": "subtitle", "time": 5484.51, "timestamp": "01:31:24", "text": "えっと、私が最初に来る"}, {"type": "subtitle", "time": 5486.629, "timestamp": "01:31:26", "text": "あぁ待って待って待って待ってあぁミツキ"}, {"type": "subtitle", "time": 5488.669, "timestamp": "01:31:28", "text": "ジョー、なぜそんなに見つめているのかと聞かれた"}, {"type": "subtitle", "time": 5491.55, "timestamp": "01:31:31", "text": "違う、もしかしたらそれが手がかりかも、待って、どこ"}, {"type": "subtitle", "time": 5494.629, "timestamp": "01:31:34", "text": "ミツキミキシはあそこにいる私を見ている"}, {"type": "subtitle", "time": 5496.59, "timestamp": "01:31:36", "text": "そして彼女は私に「ジョー、どうしてそんなに"}, {"type": "subtitle", "time": 5500.189, "timestamp": "01:31:40", "text": "違うし、うん、お願い、うん、ほとんど"}, {"type": "subtitle", "time": 5504.229, "timestamp": "01:31:44", "text": "マウスをほぼその位置に置いてください"}, {"type": "subtitle", "time": 5506.83, "timestamp": "01:31:46", "text": "そこにいる、彼女は私に尋ねている、見ている"}, {"type": "subtitle", "time": 5512.95, "timestamp": "01:31:52", "text": "それから私を見て、ああ、とてもとても近い、テレビすべて"}, {"type": "subtitle", "time": 5514.79, "timestamp": "01:31:54", "text": "私が必要としているのは舵輪です"}, {"type": "subtitle", "time": 5517.31, "timestamp": "01:31:57", "text": "名前は私を隠してくれるもの"}, {"type": "subtitle", "time": 5519.27, "timestamp": "01:31:59", "text": "群衆やその他すべて、そしてネームプレート"}]
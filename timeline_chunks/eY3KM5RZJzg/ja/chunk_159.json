[{"type": "subtitle", "time": 9540.479, "timestamp": "02:39:00", "text": "それを上げて、それを落とす 彼女はそこにいる"}, {"type": "subtitle", "time": 9542.6, "timestamp": "02:39:02", "text": "彼女はそこにいる 行け、それは君のものだ"}, {"type": "subtitle", "time": 9553.15, "timestamp": "02:39:13", "text": "私の側も"}, {"type": "subtitle", "time": 9557.51, "timestamp": "02:39:17", "text": "それは正しい、それは違う、ああそうだ"}, {"type": "subtitle", "time": 9561.55, "timestamp": "02:39:21", "text": "それは私のものだと思います、そのサイトは"}, {"type": "subtitle", "time": 9563.87, "timestamp": "02:39:23", "text": "彼女に見せてあげて、彼女に見せてあげて"}, {"type": "subtitle", "time": 9565.55, "timestamp": "02:39:25", "text": "サイトは"}, {"type": "subtitle", "time": 9568.75, "timestamp": "02:39:28", "text": "彼女のミツキはそちらの側を与える"}, {"type": "subtitle", "time": 9573.55, "timestamp": "02:39:33", "text": "この武器を返せ、この血を返せ"}, {"type": "subtitle", "time": 9577.63, "timestamp": "02:39:37", "text": "あれ、待って、待って、彼女、彼女、うんうん、取って"}, {"type": "subtitle", "time": 9579.71, "timestamp": "02:39:39", "text": "君の時間、心配ないよ、くそっ"}, {"type": "subtitle", "time": 9583.07, "timestamp": "02:39:43", "text": "君が消えたと思ったよ"}, {"type": "subtitle", "time": 9585.469, "timestamp": "02:39:45", "text": "いくつかは"}, {"type": "subtitle", "time": 9593.63, "timestamp": "02:39:53", "text": "わあ、私たち二人ともユニークな武器を持っているね、ズキ"}, {"type": "subtitle", "time": 9596.349, "timestamp": "02:39:56", "text": "こんな感じになるでしょう"}]
[{"type": "subtitle", "time": 13141.75, "timestamp": "03:39:01", "text": "そんなことできるわけないでしょ、私の大切な人"}, {"type": "subtitle", "time": 13144.309, "timestamp": "03:39:04", "text": "箱の中に物が入っているのですが、どうすればいいでしょうか"}, {"type": "subtitle", "time": 13147.07, "timestamp": "03:39:07", "text": "私たちはあなたにとって大切な存在ではないのです"}, {"type": "subtitle", "time": 13152.429, "timestamp": "03:39:12", "text": "もういいえ、私はあなたたちバカです なぜ"}, {"type": "subtitle", "time": 13156.07, "timestamp": "03:39:16", "text": "私はリスクを冒したのに、よくも今日は"}, {"type": "subtitle", "time": 13157.349, "timestamp": "03:39:17", "text": "H"}, {"type": "subtitle", "time": 13161.87, "timestamp": "03:39:21", "text": "えっと、私はとても疑わしいです。"}, {"type": "subtitle", "time": 13165.07, "timestamp": "03:39:25", "text": "そんな怪しい人物の周りでは、私は取り戻します"}, {"type": "subtitle", "time": 13166.229, "timestamp": "03:39:26", "text": "の"}, {"type": "subtitle", "time": 13170.07, "timestamp": "03:39:30", "text": "信頼を取り戻す方法とは？"}, {"type": "subtitle", "time": 13172.91, "timestamp": "03:39:32", "text": "それはまさに"}, {"type": "subtitle", "time": 13175.87, "timestamp": "03:39:35", "text": "まるで私が彼に将軍に尋ねたかのよう"}, {"type": "subtitle", "time": 13179.389, "timestamp": "03:39:39", "text": "質問して、彼が演技しているように、"}, {"type": "subtitle", "time": 13181.91, "timestamp": "03:39:41", "text": "質問は、私が尋ねた質問は何でしたか"}, {"type": "subtitle", "time": 13185.75, "timestamp": "03:39:45", "text": "えっと、なんで質問しかないの？"}, {"type": "subtitle", "time": 13189.07, "timestamp": "03:39:49", "text": "そして私たち二人ともそうではなく、それから私たちは"}, {"type": "subtitle", "time": 13192.389, "timestamp": "03:39:52", "text": "とても奇妙な声で話す 奇妙"}, {"type": "subtitle", "time": 13193.389, "timestamp": "03:39:53", "text": "声"}, {"type": "subtitle", "time": 13196.15, "timestamp": "03:39:56", "text": "君は変な声をしているし、私は"}]
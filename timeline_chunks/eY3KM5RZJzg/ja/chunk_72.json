[{"type": "subtitle", "time": 4322.79, "timestamp": "01:12:02", "text": "そこに宝箱を置いてください。私はただ旅をするだけです"}, {"type": "subtitle", "time": 4324.99, "timestamp": "01:12:04", "text": "道を進めて宝箱を集めるか、"}, {"type": "subtitle", "time": 4327.669, "timestamp": "01:12:07", "text": "その場所、それが私にできるすべてです"}, {"type": "subtitle", "time": 4330.31, "timestamp": "01:12:10", "text": "それが私の望み、それが私のできることすべて"}, {"type": "subtitle", "time": 4333.189, "timestamp": "01:12:13", "text": "それが私ができること、つまり"}, {"type": "subtitle", "time": 4337.27, "timestamp": "01:12:17", "text": "ご存知の通り、贖罪への旅です。"}, {"type": "subtitle", "time": 4340.27, "timestamp": "01:12:20", "text": "おそらく神は見守って与えている"}, {"type": "subtitle", "time": 4343.59, "timestamp": "01:12:23", "text": "私に二度目のチャンスを与えて、私が何ができるか見てみよう"}, {"type": "subtitle", "time": 4352.229, "timestamp": "01:12:32", "text": "天界でさえ"}, {"type": "subtitle", "time": 4354.31, "timestamp": "01:12:34", "text": "豆と不滅の豆は"}, {"type": "subtitle", "time": 4363.149, "timestamp": "01:12:43", "text": "それはそういうものだ、それはそういうものだ"}, {"type": "subtitle", "time": 4369.149, "timestamp": "01:12:49", "text": "1"}, {"type": "subtitle", "time": 4372.35, "timestamp": "01:12:52", "text": "痛みに会うはずだった"}, {"type": "subtitle", "time": 4375.669, "timestamp": "01:12:55", "text": "私の優しい心 性別"}]
[{"type": "subtitle", "time": 9660.95, "timestamp": "02:41:00", "text": "犬は、あなたが本をセットアップしたように、"}, {"type": "subtitle", "time": 9663.75, "timestamp": "02:41:03", "text": "これは大丈夫"}, {"type": "subtitle", "time": 9668.03, "timestamp": "02:41:08", "text": "そうすると、これを上に置く"}, {"type": "subtitle", "time": 9671.67, "timestamp": "02:41:11", "text": "ここに鎧があります"}, {"type": "subtitle", "time": 9675.11, "timestamp": "02:41:15", "text": "えっと、どんな防具を持ってるの？鉄の防具？"}, {"type": "subtitle", "time": 9676.63, "timestamp": "02:41:16", "text": "胸当て装着"}, {"type": "subtitle", "time": 9681.75, "timestamp": "02:41:21", "text": "うん、ここで右クリックして"}, {"type": "subtitle", "time": 9684.63, "timestamp": "02:41:24", "text": "これはダメダメダメ鎧を外せ"}, {"type": "subtitle", "time": 9688.269, "timestamp": "02:41:28", "text": "鎧を外して保管してください"}, {"type": "subtitle", "time": 9691.07, "timestamp": "02:41:31", "text": "インベントリを右クリック"}, {"type": "subtitle", "time": 9694.349, "timestamp": "02:41:34", "text": "これで小さなスロットが1つ見えるようになりました"}, {"type": "subtitle", "time": 9701.309, "timestamp": "02:41:41", "text": "鉄の鎧を置いてください"}, {"type": "subtitle", "time": 9705.79, "timestamp": "02:41:45", "text": "それを置いて青いラピスラズリを横に置く"}, {"type": "subtitle", "time": 9708.87, "timestamp": "02:41:48", "text": "私の荷物を取り戻す必要があるのですが、あなたは"}, {"type": "subtitle", "time": 9712.07, "timestamp": "02:41:52", "text": "エンチャントがいくつか見られます"}, {"type": "subtitle", "time": 9714.95, "timestamp": "02:41:54", "text": "右側は長方形"}]
[{"type": "subtitle", "time": 12423.389, "timestamp": "03:27:03", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 12426.75, "timestamp": "03:27:06", "text": "「いやいやいや、私はこう言った」"}, {"type": "subtitle", "time": 12431.389, "timestamp": "03:27:11", "text": "スーパーヒーローのように、私はなれない、私はなれない"}, {"type": "subtitle", "time": 12434.55, "timestamp": "03:27:14", "text": "いつもそこにいる"}, {"type": "subtitle", "time": 12437.95, "timestamp": "03:27:17", "text": "目的 彼は本当に変な行動をしている、ああ"}, {"type": "subtitle", "time": 12442.55, "timestamp": "03:27:22", "text": "神様、私は今とても怪しいです、やめてください"}, {"type": "subtitle", "time": 12446.11, "timestamp": "03:27:26", "text": "心配しないで、私の輝かしい目的は"}, {"type": "subtitle", "time": 12447.429, "timestamp": "03:27:27", "text": "守る"}, {"type": "subtitle", "time": 12455.87, "timestamp": "03:27:35", "text": "グロル、君は彼が私たちの"}, {"type": "subtitle", "time": 12460.03, "timestamp": "03:27:40", "text": "いいえ、いいえ、説明させてください"}, {"type": "subtitle", "time": 12464.469, "timestamp": "03:27:44", "text": "ハビビにハビビを責めさせよう、私たちは、私たちは"}, {"type": "subtitle", "time": 12466.71, "timestamp": "03:27:46", "text": "そこから逃れるために、これは"}, {"type": "subtitle", "time": 12469.99, "timestamp": "03:27:49", "text": "ちなみにカタナは"}, {"type": "subtitle", "time": 12473.99, "timestamp": "03:27:53", "text": "私たちが提案したのは、私が来たから逃げたからです"}, {"type": "subtitle", "time": 12476.79, "timestamp": "03:27:56", "text": "私はそこにいたからこそ、私たちは逃げ出したのです"}, {"type": "subtitle", "time": 12479.389, "timestamp": "03:27:59", "text": "彼はそれを燃やそうとしていた、いやいやいや"}]
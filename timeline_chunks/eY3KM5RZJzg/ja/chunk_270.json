[{"type": "subtitle", "time": 16200.309, "timestamp": "04:30:00", "text": "選んだよ、そう思う"}, {"type": "subtitle", "time": 16203.75, "timestamp": "04:30:03", "text": "ああ、そうだ、そうだ、私が思っていたのは"}, {"type": "subtitle", "time": 16206.07, "timestamp": "04:30:06", "text": "このように竹に続いて"}, {"type": "subtitle", "time": 16209.109, "timestamp": "04:30:09", "text": "あれを見て、それからそれを見た"}, {"type": "subtitle", "time": 16246.87, "timestamp": "04:30:46", "text": "いいえ、見つけました。"}, {"type": "subtitle", "time": 16257.109, "timestamp": "04:30:57", "text": "地図 なぜ地図を取っているのですか 私は見つけた"}]
[{"type": "subtitle", "time": 12362.95, "timestamp": "03:26:02", "text": "つまり、殺す、殺す、モンスター、今日だから"}, {"type": "subtitle", "time": 12375.55, "timestamp": "03:26:15", "text": "狩猟資源 こんにちは、皆さんはどうでしたか"}, {"type": "subtitle", "time": 12378.79, "timestamp": "03:26:18", "text": "必要なものを手に入れて"}, {"type": "subtitle", "time": 12384.11, "timestamp": "03:26:24", "text": "私、こんにちは、Zuki、迷っています、こんにちは、こんにちは。"}, {"type": "subtitle", "time": 12387.429, "timestamp": "03:26:27", "text": "あなたは実は邪悪なのですか？"}, {"type": "subtitle", "time": 12389.15, "timestamp": "03:26:29", "text": "あなたは何も教えてくれない"}, {"type": "subtitle", "time": 12391.309, "timestamp": "03:26:31", "text": "率直に言って、私はそうすべきです"}, {"type": "subtitle", "time": 12394.429, "timestamp": "03:26:34", "text": "君たちを守るよ、だって君たちを愛してるから"}, {"type": "subtitle", "time": 12397.59, "timestamp": "03:26:37", "text": "あなたは私の あなたは私を助けていない あなたは"}, {"type": "subtitle", "time": 12400.95, "timestamp": "03:26:40", "text": "怪しいからスパイダーマンになってるんだ"}, {"type": "subtitle", "time": 12403.15, "timestamp": "03:26:43", "text": "秘密任務 ああ、待って、なんで私は今"}, {"type": "subtitle", "time": 12407.309, "timestamp": "03:26:47", "text": "私に何を返してくれるかと尋ねました"}, {"type": "subtitle", "time": 12410.389, "timestamp": "03:26:50", "text": "彼は私に何て言ったの？スパイダーマンって"}, {"type": "subtitle", "time": 12412.83, "timestamp": "03:26:52", "text": "スパイダーマン スパイダーマン 彼はスパイダーマンです"}, {"type": "subtitle", "time": 12414.75, "timestamp": "03:26:54", "text": "あなたは、"}, {"type": "subtitle", "time": 12419.91, "timestamp": "03:26:59", "text": "SPID スパイじゃない、私はまるで、私はまるで、"}]
[{"type": "subtitle", "time": 7681.27, "timestamp": "02:08:01", "text": "何をしているの？何をしているの？ああ、なんてことだ"}, {"type": "subtitle", "time": 7683.47, "timestamp": "02:08:03", "text": "あなたが持っているかもしれないものは何ですか、あなたは"}, {"type": "subtitle", "time": 7687.47, "timestamp": "02:08:07", "text": "ああ、神様、少なくともあの[ __ ]を殺した"}, {"type": "subtitle", "time": 7691.95, "timestamp": "02:08:11", "text": "私のためにお願いします、彼女は生きています"}, {"type": "subtitle", "time": 7694.79, "timestamp": "02:08:14", "text": "近くには"}, {"type": "subtitle", "time": 7698.91, "timestamp": "02:08:18", "text": "彼はどこにいる 彼はどこにいる 彼はどこにいる"}, {"type": "subtitle", "time": 7702.5, "timestamp": "02:08:22", "text": "彼は戻ろう"}, {"type": "subtitle", "time": 7704.069, "timestamp": "02:08:24", "text": "[音楽]"}, {"type": "subtitle", "time": 7707.47, "timestamp": "02:08:27", "text": "私が知らないこと"}, {"type": "subtitle", "time": 7713.069, "timestamp": "02:08:33", "text": "なぜなのか知っていますか、ああ、何、何、何"}, {"type": "subtitle", "time": 7717.96, "timestamp": "02:08:37", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 7731.83, "timestamp": "02:08:51", "text": "わあ、わかった"}, {"type": "subtitle", "time": 7734.149, "timestamp": "02:08:54", "text": "人生は苦痛だ、待って、彼はどこに行ったんだ、でも"}, {"type": "subtitle", "time": 7736.99, "timestamp": "02:08:56", "text": "彼は消えたのか、彼はただ"}, {"type": "subtitle", "time": 7738.149, "timestamp": "02:08:58", "text": "爆撃"}]
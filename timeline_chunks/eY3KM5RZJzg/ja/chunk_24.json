[{"type": "subtitle", "time": 1442.47, "timestamp": "00:24:02", "text": "ドゥは言った"}, {"type": "subtitle", "time": 1447.029, "timestamp": "00:24:07", "text": "デモできないものについて、クエストがあります"}, {"type": "subtitle", "time": 1456.669, "timestamp": "00:24:16", "text": "私は注意しなければならない"}, {"type": "subtitle", "time": 1460.23, "timestamp": "00:24:20", "text": "スライド スライド"}, {"type": "subtitle", "time": 1476.63, "timestamp": "00:24:36", "text": "トマトじゃないトマト、うーん、なぜ"}, {"type": "subtitle", "time": 1479.59, "timestamp": "00:24:39", "text": "今トマトって言ったの？何それ何それ"}, {"type": "subtitle", "time": 1483.029, "timestamp": "00:24:43", "text": "えっ、なんでトマトこんにちはって言ったの？"}, {"type": "subtitle", "time": 1484.389, "timestamp": "00:24:44", "text": "それは"}, {"type": "subtitle", "time": 1492.07, "timestamp": "00:24:52", "text": "今夜は脳が働かない"}]
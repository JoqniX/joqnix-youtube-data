[{"type": "subtitle", "time": 1386.13, "timestamp": "00:23:06", "text": "のために"}, {"type": "subtitle", "time": 1388.35, "timestamp": "00:23:08", "text": "[音楽]"}, {"type": "subtitle", "time": 1392.59, "timestamp": "00:23:12", "text": "えーと、ミツキーが来たら"}, {"type": "subtitle", "time": 1394.99, "timestamp": "00:23:14", "text": "彼女はジョジョに尋ねるだろう"}, {"type": "subtitle", "time": 1399.83, "timestamp": "00:23:19", "text": "ジョック、元気？どこにいるの？"}, {"type": "subtitle", "time": 1401.19, "timestamp": "00:23:21", "text": "そしてその"}, {"type": "subtitle", "time": 1404.99, "timestamp": "00:23:24", "text": "その場合、私はどうすればいいですか？"}, {"type": "subtitle", "time": 1408.99, "timestamp": "00:23:28", "text": "ボートをもう一度待って、ボートの作り方"}, {"type": "subtitle", "time": 1416.029, "timestamp": "00:23:36", "text": "えっと、どうすればいいの？彼女は配信中"}, {"type": "subtitle", "time": 1431.63, "timestamp": "00:23:51", "text": "[音楽]"}, {"type": "subtitle", "time": 1434.669, "timestamp": "00:23:54", "text": "賢明にも、私はゲーム内で話しているわけではありません"}, {"type": "subtitle", "time": 1436.43, "timestamp": "00:23:56", "text": "考えなければならない"}]
[{"type": "subtitle", "time": 15960.07, "timestamp": "04:26:00", "text": "スピンは大丈夫、待って、それは普通です"}, {"type": "subtitle", "time": 15961.91, "timestamp": "04:26:01", "text": "槍で突く"}, {"type": "subtitle", "time": 15964.109, "timestamp": "04:26:04", "text": "待って、何"}, {"type": "subtitle", "time": 15967.99, "timestamp": "04:26:07", "text": "これと、よし、試しに着けてみよう"}, {"type": "subtitle", "time": 15978.309, "timestamp": "04:26:18", "text": "ピエロ、普通のピエロ、待って、待って、それは"}, {"type": "subtitle", "time": 15980.55, "timestamp": "04:26:20", "text": "魔法のように小便をする"}, {"type": "subtitle", "time": 15983.229, "timestamp": "04:26:23", "text": "本です、そうです"}, {"type": "subtitle", "time": 15986.309, "timestamp": "04:26:26", "text": "エンチャントなのに、なぜスタックできないのか"}, {"type": "subtitle", "time": 15988.07, "timestamp": "04:26:28", "text": "本来は"}, {"type": "subtitle", "time": 15990.269, "timestamp": "04:26:30", "text": "可能"}, {"type": "subtitle", "time": 15993.429, "timestamp": "04:26:33", "text": "知らないけど、どうやって"}, {"type": "subtitle", "time": 15994.63, "timestamp": "04:26:34", "text": "スタック"}, {"type": "subtitle", "time": 15997.189, "timestamp": "04:26:37", "text": "魔法のような"}, {"type": "subtitle", "time": 16000.95, "timestamp": "04:26:40", "text": "待って、どうやって待つの？それはいい質問だね"}, {"type": "subtitle", "time": 16003.109, "timestamp": "04:26:43", "text": "ああ、本を置いたんだね"}, {"type": "subtitle", "time": 16005.67, "timestamp": "04:26:45", "text": "本、そう、魔法の本みたいなやつ。"}, {"type": "subtitle", "time": 16008.149, "timestamp": "04:26:48", "text": "そして、別の魔法をかける"}, {"type": "subtitle", "time": 16012.109, "timestamp": "04:26:52", "text": "本を買うと、2冊重ねて手に入ります"}, {"type": "subtitle", "time": 16015.189, "timestamp": "04:26:55", "text": "それを試してこれを手に入れて"}, {"type": "subtitle", "time": 16017.469, "timestamp": "04:26:57", "text": "吐くのは普通のことです"}]
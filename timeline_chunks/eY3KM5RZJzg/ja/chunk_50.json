[{"type": "subtitle", "time": 3007.99, "timestamp": "00:50:07", "text": "慰め、そう、その、その"}, {"type": "subtitle", "time": 3009.15, "timestamp": "00:50:09", "text": "旅行"}, {"type": "subtitle", "time": 3017.589, "timestamp": "00:50:17", "text": "ある意味で彼は私の敵だと私は信じている"}, {"type": "subtitle", "time": 3026.99, "timestamp": "00:50:26", "text": "しかし、彼らの"}, {"type": "subtitle", "time": 3029.67, "timestamp": "00:50:29", "text": "ああ、彼らは進歩している、なぜ"}, {"type": "subtitle", "time": 3031.75, "timestamp": "00:50:31", "text": "みんな進歩している理由を知りたい"}, {"type": "subtitle", "time": 3035.47, "timestamp": "00:50:35", "text": "向き合うためには、見つける必要がある"}, {"type": "subtitle", "time": 3048.95, "timestamp": "00:50:48", "text": "ファンシー"}, {"type": "subtitle", "time": 3052.309, "timestamp": "00:50:52", "text": "構造は大丈夫、私たちはそれらが必要だった、そして"}, {"type": "subtitle", "time": 3054.829, "timestamp": "00:50:54", "text": "まるでオーシャンが必要だったかのように"}, {"type": "subtitle", "time": 3058.349, "timestamp": "00:50:58", "text": "いつか探検してみたい"}]
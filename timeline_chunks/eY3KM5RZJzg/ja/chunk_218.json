[{"type": "subtitle", "time": 13081.189, "timestamp": "03:38:01", "text": "行ってしまった なぜそんなことをするんだ なぜそんなことをするんだ"}, {"type": "subtitle", "time": 13083.11, "timestamp": "03:38:03", "text": "それ"}, {"type": "subtitle", "time": 13085.87, "timestamp": "03:38:05", "text": "そうですね、カスピアンを連れてきて"}, {"type": "subtitle", "time": 13088.59, "timestamp": "03:38:08", "text": "キャスパン、そうだ、今彼を連れてきて、連れ戻す"}, {"type": "subtitle", "time": 13090.51, "timestamp": "03:38:10", "text": "彼の頭をぶつけた、そう、それが"}, {"type": "subtitle", "time": 13094.67, "timestamp": "03:38:14", "text": "彼女は「ああ神様、あなたたちは"}, {"type": "subtitle", "time": 13096.469, "timestamp": "03:38:16", "text": "本当に"}, {"type": "subtitle", "time": 13099.83, "timestamp": "03:38:19", "text": "昨日こんにちはスーキ、僕はジョックです"}, {"type": "subtitle", "time": 13102.429, "timestamp": "03:38:22", "text": "ニ、黙れ"}, {"type": "subtitle", "time": 13105.189, "timestamp": "03:38:25", "text": "もう一度口でケツを舐めろ、お前はジョーじゃない"}, {"type": "subtitle", "time": 13110.07, "timestamp": "03:38:30", "text": "お前は荒らしだ、なんてこった"}, {"type": "subtitle", "time": 13111.95, "timestamp": "03:38:31", "text": "トロール"}, {"type": "subtitle", "time": 13117.269, "timestamp": "03:38:37", "text": "私のトロール、あなたはトロールのニック、ああ、"}, {"type": "subtitle", "time": 13120.429, "timestamp": "03:38:40", "text": "神様、私はJを知ってから"}, {"type": "subtitle", "time": 13123.83, "timestamp": "03:38:43", "text": "マイナス4年、ただそんな気がする"}, {"type": "subtitle", "time": 13126.75, "timestamp": "03:38:46", "text": "Jとは4年間知り合いですが、"}, {"type": "subtitle", "time": 13132.189, "timestamp": "03:38:52", "text": "ああ、なんて日だ"}, {"type": "subtitle", "time": 13138.07, "timestamp": "03:38:58", "text": "神様、あなたを殴りたいです、ああ、なぜ、なぜ"}]
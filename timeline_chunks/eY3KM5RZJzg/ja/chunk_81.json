[{"type": "subtitle", "time": 4863.83, "timestamp": "01:21:03", "text": "私が持っていたもの全てを失った方法"}, {"type": "subtitle", "time": 4865.99, "timestamp": "01:21:05", "text": "私のお金"}, {"type": "subtitle", "time": 4869.87, "timestamp": "01:21:09", "text": "食べ物、武器、荷物、すべて"}, {"type": "subtitle", "time": 4871.629, "timestamp": "01:21:11", "text": "これを引き受けた"}, {"type": "subtitle", "time": 4874.39, "timestamp": "01:21:14", "text": "旅は、それがどういうものかご存知でしょう"}, {"type": "subtitle", "time": 4877.07, "timestamp": "01:21:17", "text": "痛いよ、つまり、いつもこの状況に陥っているんだ"}, {"type": "subtitle", "time": 4879.669, "timestamp": "01:21:19", "text": "外で冒険しない場所"}, {"type": "subtitle", "time": 4881.39, "timestamp": "01:21:21", "text": "私のことを知りたい"}, {"type": "subtitle", "time": 4886.11, "timestamp": "01:21:26", "text": "痛いけど、痛いよ、ここから出てきなよ"}, {"type": "subtitle", "time": 4897.55, "timestamp": "01:21:37", "text": "無料だよ、いつでも来ていいよ"}, {"type": "subtitle", "time": 4898.669, "timestamp": "01:21:38", "text": "右"}, {"type": "subtitle", "time": 4901.75, "timestamp": "01:21:41", "text": "実際には"}, {"type": "subtitle", "time": 4905.35, "timestamp": "01:21:45", "text": "ええ、私のV缶を聞いてくれてありがとう"}, {"type": "subtitle", "time": 4907.47, "timestamp": "01:21:47", "text": "あなたに"}, {"type": "subtitle", "time": 4911.75, "timestamp": "01:21:51", "text": "花、ああ、あなた、ああ、あなた、高価なBR"}, {"type": "subtitle", "time": 4916.51, "timestamp": "01:21:56", "text": "君はこだわりが強すぎるね。まあいいけど、これらは"}]
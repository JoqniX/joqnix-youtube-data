[{"type": "subtitle", "time": 16140.95, "timestamp": "04:29:00", "text": "彼らと一緒に"}, {"type": "subtitle", "time": 16144.75, "timestamp": "04:29:04", "text": "アストラがミツキ・ズキを殺した。私はそれを渡した。"}, {"type": "subtitle", "time": 16147.389, "timestamp": "04:29:07", "text": "ズキズキはそれを"}, {"type": "subtitle", "time": 16152.269, "timestamp": "04:29:12", "text": "はい、そこに地図があります、その地図は"}, {"type": "subtitle", "time": 16155.87, "timestamp": "04:29:15", "text": "見てるよ、君の言う通りだ、ああ、あれだ"}, {"type": "subtitle", "time": 16164.269, "timestamp": "04:29:24", "text": "この地図ではないもの"}, {"type": "subtitle", "time": 16166.87, "timestamp": "04:29:26", "text": "どこかで地図を見つけた"}, {"type": "subtitle", "time": 16170.91, "timestamp": "04:29:30", "text": "そう、宝の場所だよ、そうだね"}, {"type": "subtitle", "time": 16174.349, "timestamp": "04:29:34", "text": "私がその場所を忘れた場所は"}, {"type": "subtitle", "time": 16176.429, "timestamp": "04:29:36", "text": "それ"}, {"type": "subtitle", "time": 16179.469, "timestamp": "04:29:39", "text": "まさか君が"}, {"type": "subtitle", "time": 16189.51, "timestamp": "04:29:49", "text": "構造は宝物のように"}, {"type": "subtitle", "time": 16192.07, "timestamp": "04:29:52", "text": "場所、何だったか覚えていない"}, {"type": "subtitle", "time": 16192.88, "timestamp": "04:29:52", "text": "方向I"}]
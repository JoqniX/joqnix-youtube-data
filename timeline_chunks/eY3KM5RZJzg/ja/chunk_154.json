[{"type": "subtitle", "time": 9248.75, "timestamp": "02:34:08", "text": "大丈夫だよ、だから、こういうことなんだ。"}, {"type": "subtitle", "time": 9251.71, "timestamp": "02:34:11", "text": "ここで、ドラッグ・ノエルはとてもとても"}, {"type": "subtitle", "time": 9254.349, "timestamp": "02:34:14", "text": "彼を倒せば、今まさに強化されているようなものだ"}, {"type": "subtitle", "time": 9255.79, "timestamp": "02:34:15", "text": "君にとっては良いことだ、彼の"}, {"type": "subtitle", "time": 9258.87, "timestamp": "02:34:18", "text": "いいものだけど、でも私は私の"}, {"type": "subtitle", "time": 9261.55, "timestamp": "02:34:21", "text": "武器だが、私のメイン武器は君にあげた"}, {"type": "subtitle", "time": 9263.23, "timestamp": "02:34:23", "text": "いい武器をあげたよね"}, {"type": "subtitle", "time": 9264.95, "timestamp": "02:34:24", "text": "十分じゃない、君はこれを手に入れなかった"}, {"type": "subtitle", "time": 9267.389, "timestamp": "02:34:27", "text": "受け取ってない、受け取ってる、リセットされた"}, {"type": "subtitle", "time": 9270.51, "timestamp": "02:34:30", "text": "サーバーが停止した際に在庫がリセットされました"}, {"type": "subtitle", "time": 9273.51, "timestamp": "02:34:33", "text": "クラッシュした、実際私は"}, {"type": "subtitle", "time": 9277.55, "timestamp": "02:34:37", "text": "私の目的がわかった"}, {"type": "subtitle", "time": 9281.59, "timestamp": "02:34:41", "text": "そもそも何のために？"}, {"type": "subtitle", "time": 9282.51, "timestamp": "02:34:42", "text": "の"}, {"type": "subtitle", "time": 9285.309, "timestamp": "02:34:45", "text": "そんな場所なんてクソくらえ、待って、君は"}, {"type": "subtitle", "time": 9287.309, "timestamp": "02:34:47", "text": "1つまたは通常のものを引き出すと、"}, {"type": "subtitle", "time": 9289.269, "timestamp": "02:34:49", "text": "良いものが欲しいなら、本当のものを与えてください"}, {"type": "subtitle", "time": 9290.15, "timestamp": "02:34:50", "text": "これ"}, {"type": "subtitle", "time": 9294.11, "timestamp": "02:34:54", "text": "うん、待って待って、あげた？"}, {"type": "subtitle", "time": 9298.87, "timestamp": "02:34:58", "text": "さあ、ミツキさん、私たちの贈り物へ戻りましょう。"}]
[{"type": "subtitle", "time": 13443.63, "timestamp": "03:44:03", "text": "DM えーと DM グループ 船の場所"}, {"type": "subtitle", "time": 13446.67, "timestamp": "03:44:06", "text": "先ほど私たちがいた場所"}, {"type": "subtitle", "time": 13451.07, "timestamp": "03:44:11", "text": "ミツキフォント船船船えっと"}, {"type": "subtitle", "time": 13453.51, "timestamp": "03:44:13", "text": "あなたが置いた場所に置く"}, {"type": "subtitle", "time": 13456.71, "timestamp": "03:44:16", "text": "ダイヤモンドとかその他"}, {"type": "subtitle", "time": 13458.95, "timestamp": "03:44:18", "text": "私たちが死んだ地下の場所"}, {"type": "subtitle", "time": 13462.11, "timestamp": "03:44:22", "text": "そう、あの場所で私たちは"}, {"type": "subtitle", "time": 13464.07, "timestamp": "03:44:24", "text": "それは私が置いた場所にありますか"}, {"type": "subtitle", "time": 13466.469, "timestamp": "03:44:26", "text": "DMグループの座標は"}, {"type": "subtitle", "time": 13469.55, "timestamp": "03:44:29", "text": "それを見つける 私は違う 私は違う 私は知っている 私は知っている"}, {"type": "subtitle", "time": 13473.83, "timestamp": "03:44:33", "text": "あの場所、いやいや、あの場所は知ってるけど"}, {"type": "subtitle", "time": 13476.59, "timestamp": "03:44:36", "text": "うん、遠いけど、どうすればいいのかわからない"}, {"type": "subtitle", "time": 13478.87, "timestamp": "03:44:38", "text": "それはただ、どうすればいいのかわからない"}, {"type": "subtitle", "time": 13480.87, "timestamp": "03:44:40", "text": "ところで、構造物Iがありました"}, {"type": "subtitle", "time": 13485.03, "timestamp": "03:44:45", "text": "私たちの洞窟自体で見つかりました。"}, {"type": "subtitle", "time": 13488.51, "timestamp": "03:44:48", "text": "私をフォローしてください。皆さんも私をフォローできますか。"}, {"type": "subtitle", "time": 13490.99, "timestamp": "03:44:50", "text": "私はできる、あなたたちを連れて行けると信じています"}, {"type": "subtitle", "time": 13493.389, "timestamp": "03:44:53", "text": "そこで私は見せたかった"}, {"type": "subtitle", "time": 13495.83, "timestamp": "03:44:55", "text": "別の休暇"}, {"type": "subtitle", "time": 13498.95, "timestamp": "03:44:58", "text": "まず、これを見てみましょう。でも、"}]
[{"type": "subtitle", "time": 8044.51, "timestamp": "02:14:04", "text": "ええ、彼があなたにくれたかどうか聞いているんです"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "あなたの荷物を返してください"}, {"type": "subtitle", "time": 8048.35, "timestamp": "02:14:08", "text": "失った"}, {"type": "subtitle", "time": 8052.43, "timestamp": "02:14:12", "text": "えっと、ソードフィッシュは助けようとしていたと思う"}, {"type": "chat", "time": 8054.675, "timestamp": "02:14:14", "author": "@OtakuArceus", "avatar": "https://yt4.ggpht.com/VSZC0x7e02-tCAnte525GcpFOF0YcSpYQWplJkdg1RARvkQA3ETFxFaiYVshpLrqHFKUMz4VmA=s64-c-k-c0x00ffffff-no-rj", "message": "if u have an enchanting table u can have it"}, {"type": "subtitle", "time": 8056.109, "timestamp": "02:14:16", "text": "私にとっては、アイテムは"}, {"type": "subtitle", "time": 8059.31, "timestamp": "02:14:19", "text": "彼が私にくれた武器のように受け取った"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "あれ、あの物、また紛失しちゃったんだけど"}, {"type": "subtitle", "time": 8064.27, "timestamp": "02:14:24", "text": "サーバー"}, {"type": "subtitle", "time": 8066.83, "timestamp": "02:14:26", "text": "クラッシュしたから、今度はどうする？彼に渡したばかりなのに。"}, {"type": "subtitle", "time": 8068.87, "timestamp": "02:14:28", "text": "エメラルドと、あなたはノーノーノーノーを手に入れました"}, {"type": "subtitle", "time": 8070.549, "timestamp": "02:14:30", "text": "いやいや、彼は戻ってくるよ、と彼は言った"}, {"type": "subtitle", "time": 8071.83, "timestamp": "02:14:31", "text": "偶然に"}, {"type": "subtitle", "time": 8074.95, "timestamp": "02:14:34", "text": "テレポートした彼は私のところに戻ってくるだろう"}, {"type": "subtitle", "time": 8084.549, "timestamp": "02:14:44", "text": "それで、何を見つけたの？ああ、なんてことだ"}, {"type": "subtitle", "time": 8086.189, "timestamp": "02:14:46", "text": "それは全体"}, {"type": "subtitle", "time": 8091.95, "timestamp": "02:14:51", "text": "ビッグビッグ、オーケー、私についてきて、オーマイゴッド"}, {"type": "subtitle", "time": 8093.75, "timestamp": "02:14:53", "text": "問題は、どこにあるのか覚えていないということです"}, {"type": "subtitle", "time": 8096.99, "timestamp": "02:14:56", "text": "あの場所、あ、あそこにドアがある"}]
[{"type": "subtitle", "time": 16264.83, "timestamp": "04:31:04", "text": "[音楽]"}, {"type": "subtitle", "time": 16268.71, "timestamp": "04:31:08", "text": "君だけど、胸はどこにあるの？私は知らないけど"}, {"type": "subtitle", "time": 16272.149, "timestamp": "04:31:12", "text": "知ってるでしょ、私はあなたと一緒にここに来ただけなの"}, {"type": "subtitle", "time": 16277.95, "timestamp": "04:31:17", "text": "[音楽]"}, {"type": "subtitle", "time": 16294.95, "timestamp": "04:31:34", "text": "私はここにいます、吐くことはできますか"}, {"type": "subtitle", "time": 16298.109, "timestamp": "04:31:38", "text": "通常の武器"}, {"type": "subtitle", "time": 16302.109, "timestamp": "04:31:42", "text": "少なくとも試してみよう、神様、試してみよう"}, {"type": "subtitle", "time": 16304.91, "timestamp": "04:31:44", "text": "普通の剣か何かで試してみて"}, {"type": "subtitle", "time": 16307.95, "timestamp": "04:31:47", "text": "ただ火を追加するだけで、"}, {"type": "subtitle", "time": 16310.75, "timestamp": "04:31:50", "text": "通常の毛並み"}]
[{"type": "subtitle", "time": 14101.03, "timestamp": "03:55:01", "text": "[音楽]"}, {"type": "subtitle", "time": 14117.79, "timestamp": "03:55:17", "text": "クローズコンスティルベールヴィー"}, {"type": "subtitle", "time": 14120.67, "timestamp": "03:55:20", "text": "ああ、私は自分の"}, {"type": "subtitle", "time": 14130.189, "timestamp": "03:55:30", "text": "ここだけど金でなければならなかった、大丈夫"}, {"type": "subtitle", "time": 14132.67, "timestamp": "03:55:32", "text": "紫色のもの"}, {"type": "subtitle", "time": 14136.99, "timestamp": "03:55:36", "text": "色はネザライトは紫色です。いいえ、できます。"}, {"type": "subtitle", "time": 14139.07, "timestamp": "03:55:39", "text": "茶色のズボンを取って魔法をかけると"}, {"type": "subtitle", "time": 14140.51, "timestamp": "03:55:40", "text": "見て"}, {"type": "subtitle", "time": 14145.269, "timestamp": "03:55:45", "text": "紫がかった茶色のヘルメットも"}, {"type": "subtitle", "time": 14150.309, "timestamp": "03:55:50", "text": "はい、でも防具は今はプラス2ですが、はい"}, {"type": "subtitle", "time": 14152.51, "timestamp": "03:55:52", "text": "待って、プラス２"}, {"type": "subtitle", "time": 14154.67, "timestamp": "03:55:54", "text": "革の兄弟、ただあなたの"}, {"type": "subtitle", "time": 14157.63, "timestamp": "03:55:57", "text": "ここで魔法をかけました。よし、待って、私に"}]
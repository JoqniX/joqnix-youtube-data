[{"type": "subtitle", "time": 17465.47, "timestamp": "04:51:05", "text": "ゲームありがとう"}, {"type": "subtitle", "time": 17469.83, "timestamp": "04:51:09", "text": "体育の授業を受けて、家に帰って、"}, {"type": "subtitle", "time": 17471.868, "timestamp": "04:51:11", "text": "私のものを集める"}, {"type": "subtitle", "time": 17474.83, "timestamp": "04:51:14", "text": "家に帰らせてくれ、もう終わったんだ"}, {"type": "subtitle", "time": 17478.35, "timestamp": "04:51:18", "text": "今日は息苦しくて苦しかったのですが、"}, {"type": "subtitle", "time": 17512.75, "timestamp": "04:51:52", "text": "私はただ建てるだけです"}, {"type": "subtitle", "time": 17514.51, "timestamp": "04:51:54", "text": "それは"}, {"type": "subtitle", "time": 17516.91, "timestamp": "04:51:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 13624.07, "timestamp": "03:47:04", "text": "DMグループでバカがここに連れてくる"}, {"type": "subtitle", "time": 13626.59, "timestamp": "03:47:06", "text": "彼をここに連れてきてほしいの？"}, {"type": "subtitle", "time": 13635.389, "timestamp": "03:47:15", "text": "サーバーが来た、オーマイゴッド、キャスプはこんな感じ"}, {"type": "subtitle", "time": 13638.309, "timestamp": "03:47:18", "text": "君たちに会いたいんだけど、どこにいるの？"}, {"type": "subtitle", "time": 13642.229, "timestamp": "03:47:22", "text": "知ってるでしょ、でも彼の父親のことは"}, {"type": "subtitle", "time": 13644.55, "timestamp": "03:47:24", "text": "いや、あの、彼が"}, {"type": "subtitle", "time": 13651.91, "timestamp": "03:47:31", "text": "Cに来てほしい理由は何ですか？"}, {"type": "subtitle", "time": 13653.309, "timestamp": "03:47:33", "text": "ここ"}, {"type": "subtitle", "time": 13656.63, "timestamp": "03:47:36", "text": "彼はチームにすら所属していないが"}, {"type": "subtitle", "time": 13660.429, "timestamp": "03:47:40", "text": "メンバーの皆さん、私たちはただミートアップをしているだけです"}, {"type": "subtitle", "time": 13664.349, "timestamp": "03:47:44", "text": "怪しい出会いだ、ああ神様、来い"}, {"type": "subtitle", "time": 13667.389, "timestamp": "03:47:47", "text": "私をフォローする必要があります 私をフォローする必要があります"}, {"type": "subtitle", "time": 13671.469, "timestamp": "03:47:51", "text": "おい、なぜ招待しないんだ"}, {"type": "subtitle", "time": 13675.309, "timestamp": "03:47:55", "text": "私は、ああ、待って、あなたは持っていますか"}, {"type": "subtitle", "time": 13679.189, "timestamp": "03:47:59", "text": "SW、この鉄のハムラーを手に入れたよ、うまくいったよ。"}]
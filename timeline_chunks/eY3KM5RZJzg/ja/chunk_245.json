[{"type": "subtitle", "time": 14702.55, "timestamp": "04:05:02", "text": "それは私がただ無料で手に入れることができることを知らせてくれました"}, {"type": "subtitle", "time": 14705.149, "timestamp": "04:05:05", "text": "私たちにとっての食べ物"}, {"type": "subtitle", "time": 14709.99, "timestamp": "04:05:09", "text": "食べる スー 来て来て来て来て来てジョイ"}, {"type": "subtitle", "time": 14718.83, "timestamp": "04:05:18", "text": "食べ物、食べ物は私が用意しますのでご心配なく"}, {"type": "subtitle", "time": 14721.189, "timestamp": "04:05:21", "text": "食べ物を買ってきますのでご心配なく"}, {"type": "subtitle", "time": 14729.11, "timestamp": "04:05:29", "text": "あなたが持っている食べ物、あなたは知らないジョイ"}, {"type": "subtitle", "time": 14731.91, "timestamp": "04:05:31", "text": "ジョックのペット"}, {"type": "subtitle", "time": 14733.55, "timestamp": "04:05:33", "text": "名前"}, {"type": "subtitle", "time": 14737.55, "timestamp": "04:05:37", "text": "ジョッキーは彼のペットですか"}, {"type": "subtitle", "time": 14740.469, "timestamp": "04:05:40", "text": "名前はオーケー待って食べ物ありますか私も"}, {"type": "subtitle", "time": 14744.469, "timestamp": "04:05:44", "text": "ちょっと必要なんだけど、そんなに持ってないんだ。"}, {"type": "subtitle", "time": 14756.45, "timestamp": "04:05:56", "text": "神様、あなたは"}, {"type": "subtitle", "time": 14758.59, "timestamp": "04:05:58", "text": "[音楽]"}]
[{"type": "subtitle", "time": 4141.51, "timestamp": "01:09:01", "text": "失敗した、一体なぜ私は行ったのか"}, {"type": "subtitle", "time": 4145.349, "timestamp": "01:09:05", "text": "必要に応じて"}, {"type": "subtitle", "time": 4148.99, "timestamp": "01:09:08", "text": "兄弟、君は素晴らしすぎるよ。いや、私は素晴らしすぎるよ。"}, {"type": "subtitle", "time": 4156.349, "timestamp": "01:09:16", "text": "[音楽]"}, {"type": "subtitle", "time": 4160.63, "timestamp": "01:09:20", "text": "私の守護天使はどこにいるの？"}, {"type": "subtitle", "time": 4162.519, "timestamp": "01:09:22", "text": "それは"}, {"type": "subtitle", "time": 4164.349, "timestamp": "01:09:24", "text": "[音楽]"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "花よ、ああ神様、私の"}, {"type": "subtitle", "time": 4181.149, "timestamp": "01:09:41", "text": "アイテムはカードエンジェルを待っています"}, {"type": "subtitle", "time": 4183.63, "timestamp": "01:09:43", "text": "カードは私がどこで死んだか知っていますか"}, {"type": "subtitle", "time": 4188.03, "timestamp": "01:09:48", "text": "Sログなどを確認する"}]
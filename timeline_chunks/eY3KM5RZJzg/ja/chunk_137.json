[{"type": "subtitle", "time": 8220.509, "timestamp": "02:17:00", "text": "大丈夫だけど、私は持っていない"}, {"type": "subtitle", "time": 8222.83, "timestamp": "02:17:02", "text": "IRすら搭載していないなんて、なんてことだ、大丈夫だよ"}, {"type": "subtitle", "time": 8226.87, "timestamp": "02:17:06", "text": "大丈夫、大丈夫、私たちはここにいる、私たちは必要としている"}, {"type": "subtitle", "time": 8231.03, "timestamp": "02:17:11", "text": "救助を受けるには、"}, {"type": "subtitle", "time": 8234.15, "timestamp": "02:17:14", "text": "その穴は大丈夫"}, {"type": "subtitle", "time": 8239.509, "timestamp": "02:17:19", "text": "神様、私たちはどうすればいいの？ああ神様、私たちは"}, {"type": "subtitle", "time": 8242.629, "timestamp": "02:17:22", "text": "試すことができます"}, {"type": "subtitle", "time": 8245.589, "timestamp": "02:17:25", "text": "ここでツルハシを使って、こっちに来て"}, {"type": "subtitle", "time": 8253.19, "timestamp": "02:17:33", "text": "これ、見える？待って、えっと、私のもの"}, {"type": "subtitle", "time": 8253.95, "timestamp": "02:17:33", "text": "これ"}, {"type": "subtitle", "time": 8258.03, "timestamp": "02:17:38", "text": "このブロックを壊さないようにブロックを壊すと、"}, {"type": "subtitle", "time": 8260.629, "timestamp": "02:17:40", "text": "見る"}, {"type": "subtitle", "time": 8264.429, "timestamp": "02:17:44", "text": "えっと、何をしているの？私は"}, {"type": "subtitle", "time": 8266.27, "timestamp": "02:17:46", "text": "ここ"}, {"type": "subtitle", "time": 8269.83, "timestamp": "02:17:49", "text": "ああ、そこへ行かないで、飛び降りないで、"}, {"type": "subtitle", "time": 8273.429, "timestamp": "02:17:53", "text": "死ぬよ、私はできると思う"}, {"type": "subtitle", "time": 8276.429, "timestamp": "02:17:56", "text": "それはあなたが"}, {"type": "subtitle", "time": 8278.15, "timestamp": "02:17:58", "text": "あなたは"}]
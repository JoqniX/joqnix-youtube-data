[{"type": "subtitle", "time": 1634.389, "timestamp": "00:27:14", "text": "ああ、なんてことだ、なんてことだ、なんてことだ、なんてことだ、なんてことだ"}, {"type": "subtitle", "time": 1644.99, "timestamp": "00:27:24", "text": "神様、そんなことしないで、そんなことしないで"}, {"type": "subtitle", "time": 1650.75, "timestamp": "00:27:30", "text": "そんなことしないで、バカ、ダメだよ、ダメだよ"}, {"type": "subtitle", "time": 1655.669, "timestamp": "00:27:35", "text": "そんなことはしないで、ああ神様、気をつけて"}, {"type": "subtitle", "time": 1659.23, "timestamp": "00:27:39", "text": "人生は一度きり。失ったら"}, {"type": "subtitle", "time": 1661.509, "timestamp": "00:27:41", "text": "死ぬ、君は手に入れる、ああ、君は知らない"}, {"type": "subtitle", "time": 1665.549, "timestamp": "00:27:45", "text": "墓場、これは死なない"}, {"type": "subtitle", "time": 1667.63, "timestamp": "00:27:47", "text": "それは"}, {"type": "subtitle", "time": 1669.909, "timestamp": "00:27:49", "text": "私が自分のためにロックしているミッション"}, {"type": "subtitle", "time": 1671.31, "timestamp": "00:27:51", "text": "もの"}, {"type": "subtitle", "time": 1674.549, "timestamp": "00:27:54", "text": "こんにちは、幸運を祈ります。"}]
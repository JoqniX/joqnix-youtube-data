[{"type": "subtitle", "time": 13381.63, "timestamp": "03:43:01", "text": "これはそれを"}, {"type": "subtitle", "time": 13384.63, "timestamp": "03:43:04", "text": "食事は紙を使って拡張できます"}, {"type": "subtitle", "time": 13385.389, "timestamp": "03:43:05", "text": "の"}, {"type": "subtitle", "time": 13388.71, "timestamp": "03:43:08", "text": "えっと、ジョー、これ見れる？私は見ない"}, {"type": "subtitle", "time": 13390.59, "timestamp": "03:43:10", "text": "何が"}, {"type": "subtitle", "time": 13395.309, "timestamp": "03:43:15", "text": "これは、ああ、これは私たちのベースマップです"}, {"type": "subtitle", "time": 13398.149, "timestamp": "03:43:18", "text": "ああ、基本的には、"}, {"type": "subtitle", "time": 13400.229, "timestamp": "03:43:20", "text": "私たちの周りのすべては"}, {"type": "subtitle", "time": 13402.91, "timestamp": "03:43:22", "text": "これだが、地図製作者がいない"}, {"type": "subtitle", "time": 13405.469, "timestamp": "03:43:25", "text": "マップを拡張するためのテーブルを今すぐ"}, {"type": "subtitle", "time": 13407.79, "timestamp": "03:43:27", "text": "そのままここに置いておきましょう"}, {"type": "subtitle", "time": 13415.469, "timestamp": "03:43:35", "text": "何か欲しいと思う？"}, {"type": "subtitle", "time": 13417.91, "timestamp": "03:43:37", "text": "ダイヤモンドが欲しいですか？"}, {"type": "subtitle", "time": 13421.229, "timestamp": "03:43:41", "text": "ダイヤモンド、そう、実際はこれです"}, {"type": "subtitle", "time": 13423.07, "timestamp": "03:43:43", "text": "安全に保管しなければならないもの"}, {"type": "subtitle", "time": 13430.469, "timestamp": "03:43:50", "text": "すごく混乱してるんだけど"}, {"type": "subtitle", "time": 13434.75, "timestamp": "03:43:54", "text": "さて、ジョー、そうね、ズキに見せてあげましょうか"}, {"type": "subtitle", "time": 13435.91, "timestamp": "03:43:55", "text": "の"}, {"type": "subtitle", "time": 13439.55, "timestamp": "03:43:59", "text": "場所、えっと、待って、ズキ、私はそれを送ります"}]
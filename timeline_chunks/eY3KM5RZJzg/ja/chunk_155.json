[{"type": "subtitle", "time": 9301.83, "timestamp": "02:35:01", "text": "ああ、それはとてもクールですね。私たちはあなたに"}, {"type": "subtitle", "time": 9304.309, "timestamp": "02:35:04", "text": "クエスト ムキ、君たちに"}, {"type": "subtitle", "time": 9307.63, "timestamp": "02:35:07", "text": "クエストって何？クエストって何？だから"}, {"type": "subtitle", "time": 9309.63, "timestamp": "02:35:09", "text": "ドラガーという名前の別のプレイヤーがいます。"}, {"type": "subtitle", "time": 9312.269, "timestamp": "02:35:12", "text": "彼を殺せば、あなたは大きな利益を得るでしょう"}, {"type": "subtitle", "time": 9314.55, "timestamp": "02:35:14", "text": "実際にはその裏には"}, {"type": "subtitle", "time": 9320.349, "timestamp": "02:35:20", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 9324.15, "timestamp": "02:35:24", "text": "死ぬんだ、私は"}, {"type": "subtitle", "time": 9334.55, "timestamp": "02:35:34", "text": "タブ操作"}, {"type": "subtitle", "time": 9344.269, "timestamp": "02:35:44", "text": "2番"}, {"type": "subtitle", "time": 9350.07, "timestamp": "02:35:50", "text": "[音楽]"}]
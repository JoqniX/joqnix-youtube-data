[{"type": "subtitle", "time": 11790.389, "timestamp": "03:16:30", "text": "ああ、ここはどこだ"}, {"type": "subtitle", "time": 11792.71, "timestamp": "03:16:32", "text": "よし、これだ"}, {"type": "subtitle", "time": 11796.95, "timestamp": "03:16:36", "text": "私はここにいます、私は戻ってきました"}, {"type": "subtitle", "time": 11801.469, "timestamp": "03:16:41", "text": "サーバーマンO、そう、えっと、私は保存します"}, {"type": "subtitle", "time": 11803.87, "timestamp": "03:16:43", "text": "座標は後で戻って来られます"}, {"type": "subtitle", "time": 11805.75, "timestamp": "03:16:45", "text": "何かご希望があれば"}, {"type": "subtitle", "time": 11807.389, "timestamp": "03:16:47", "text": "今すぐ受け取ってください"}, {"type": "subtitle", "time": 11814.67, "timestamp": "03:16:54", "text": "チェスト、私の荷物は保管しておいてほしいですか？"}, {"type": "subtitle", "time": 11819.189, "timestamp": "03:16:59", "text": "あのクレイジーな男が来るところで、"}]
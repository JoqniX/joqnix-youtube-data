[{"type": "subtitle", "time": 5221.95, "timestamp": "01:27:01", "text": "その時武器がロック解除されました"}, {"type": "subtitle", "time": 5225.35, "timestamp": "01:27:05", "text": "武器よし、その時はメカジキよ"}, {"type": "subtitle", "time": 5231.07, "timestamp": "01:27:11", "text": "テレポートしたよ、わかった"}, {"type": "subtitle", "time": 5232.99, "timestamp": "01:27:12", "text": "えーと"}, {"type": "subtitle", "time": 5237.83, "timestamp": "01:27:17", "text": "もうすぐ着くから、あの物を渡したんだ"}, {"type": "subtitle", "time": 5240.83, "timestamp": "01:27:20", "text": "その2本の剣を"}, {"type": "subtitle", "time": 5244.87, "timestamp": "01:27:24", "text": "ヘルメットを見てください"}, {"type": "subtitle", "time": 5248.59, "timestamp": "01:27:28", "text": "お願い、お願い、D D D D D 来て来て"}, {"type": "subtitle", "time": 5250.79, "timestamp": "01:27:30", "text": "さあさあさあ"}, {"type": "subtitle", "time": 5255.189, "timestamp": "01:27:35", "text": "ほぼ"}, {"type": "subtitle", "time": 5259.43, "timestamp": "01:27:39", "text": "えっと、VじゃなくてVTです"}, {"type": "subtitle", "time": 5261.07, "timestamp": "01:27:41", "text": "D"}, {"type": "subtitle", "time": 5265.43, "timestamp": "01:27:45", "text": "ああ、見逃した、見逃した、戻る"}, {"type": "subtitle", "time": 5266.669, "timestamp": "01:27:46", "text": "フレーム"}, {"type": "subtitle", "time": 5274.79, "timestamp": "01:27:54", "text": "戻って、戻って、わかった、わかった、待って"}, {"type": "subtitle", "time": 5277.229, "timestamp": "01:27:57", "text": "オーケー、ゴールデンシャベル、シルク"}]
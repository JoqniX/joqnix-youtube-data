[{"type": "subtitle", "time": 10800.59, "timestamp": "03:00:00", "text": "ゲームに集中しながら、インタラクションを楽しんでください。"}, {"type": "subtitle", "time": 10812.87, "timestamp": "03:00:12", "text": "学習して、彼女に学ばせましょう"}, {"type": "subtitle", "time": 10816.11, "timestamp": "03:00:16", "text": "みんな来て"}, {"type": "subtitle", "time": 10819.59, "timestamp": "03:00:19", "text": "大丈夫、何もないよ、ああ神様"}, {"type": "subtitle", "time": 10826.469, "timestamp": "03:00:26", "text": "知る"}, {"type": "subtitle", "time": 10829.429, "timestamp": "03:00:29", "text": "はい、ここがその場所でした"}, {"type": "subtitle", "time": 10834.15, "timestamp": "03:00:34", "text": "降りてきて、おっと、私の間違いです。また、魚は"}, {"type": "subtitle", "time": 10837.79, "timestamp": "03:00:37", "text": "地域によっては"}, {"type": "subtitle", "time": 10841.15, "timestamp": "03:00:41", "text": "アイテムワールドそのようなものは存在しないそのようなものは存在しない"}, {"type": "subtitle", "time": 10843.11, "timestamp": "03:00:43", "text": "物領域"}, {"type": "subtitle", "time": 10846.07, "timestamp": "03:00:46", "text": "アイテムアイテムは村人であり、村人たちは"}, {"type": "subtitle", "time": 10849.11, "timestamp": "03:00:49", "text": "奴隷ではない、私は健康が好きです"}, {"type": "subtitle", "time": 10851.269, "timestamp": "03:00:51", "text": "生命力を奪う地域"}, {"type": "subtitle", "time": 10855.67, "timestamp": "03:00:55", "text": "武器は今ある。吸血鬼はいるのか？"}, {"type": "subtitle", "time": 10858.59, "timestamp": "03:00:58", "text": "日中に出かけられるようなもの"}]
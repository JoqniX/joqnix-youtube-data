[{"type": "subtitle", "time": 12181.229, "timestamp": "03:23:01", "text": "クエストからより強力な武器を入手し、"}, {"type": "subtitle", "time": 12184.55, "timestamp": "03:23:04", "text": "すべてを安全に保管すれば、"}, {"type": "subtitle", "time": 12188.87, "timestamp": "03:23:08", "text": "時間ができたらこの場所を再建しよう"}, {"type": "subtitle", "time": 12193.15, "timestamp": "03:23:13", "text": "これを作ったとき、フェンスを作りました"}, {"type": "subtitle", "time": 12201.95, "timestamp": "03:23:21", "text": "ああ、水を飲むのを忘れてた。待って。"}, {"type": "subtitle", "time": 12238.07, "timestamp": "03:23:58", "text": "こんにちは"}]
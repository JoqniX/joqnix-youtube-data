[{"type": "subtitle", "time": 61.229, "timestamp": "00:01:01", "text": "Minecraftの世界にいるので"}, {"type": "subtitle", "time": 62.31, "timestamp": "00:01:02", "text": "台無しにする"}, {"type": "subtitle", "time": 66.149, "timestamp": "00:01:06", "text": "しかし私たちは最善を尽くします"}, {"type": "subtitle", "time": 68.07, "timestamp": "00:01:08", "text": "星座の中で"}, {"type": "subtitle", "time": 70.51, "timestamp": "00:01:10", "text": "旅、それが私"}, {"type": "subtitle", "time": 73.19, "timestamp": "00:01:13", "text": "ヌールの世界ではジャンキーだが、"}, {"type": "subtitle", "time": 75.55, "timestamp": "00:01:15", "text": "ベストを尽くして、"}, {"type": "subtitle", "time": 77.789, "timestamp": "00:01:17", "text": "チームメイトやその他すべてが多くのことを成し遂げました"}, {"type": "subtitle", "time": 79.63, "timestamp": "00:01:19", "text": "今日のもの"}, {"type": "subtitle", "time": 82.71000000000001, "timestamp": "00:01:22", "text": "その前に、"}, {"type": "subtitle", "time": 84.83, "timestamp": "00:01:24", "text": "少し短め"}, {"type": "subtitle", "time": 92.789, "timestamp": "00:01:32", "text": "うん、体が疲れてるよ。うん、そうするよ。"}, {"type": "subtitle", "time": 94.71000000000001, "timestamp": "00:01:34", "text": "今日は11時までに早く寝る：もしくは何か"}, {"type": "subtitle", "time": 105.87, "timestamp": "00:01:45", "text": "心配する私は本当に"}, {"type": "subtitle", "time": 111.27000000000001, "timestamp": "00:01:51", "text": "寝るよ、うんうんうん、実際に"}, {"type": "subtitle", "time": 115.029, "timestamp": "00:01:55", "text": "眠らなければならないだろう、眠らなければならないだろう"}, {"type": "subtitle", "time": 117.709, "timestamp": "00:01:57", "text": "ああ、できない、できない"}]
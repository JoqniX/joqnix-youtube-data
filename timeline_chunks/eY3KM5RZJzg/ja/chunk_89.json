[{"type": "subtitle", "time": 5342.79, "timestamp": "01:29:02", "text": "欲しい、ああ"}, {"type": "subtitle", "time": 5349.669, "timestamp": "01:29:09", "text": "[音楽]"}, {"type": "subtitle", "time": 5359.83, "timestamp": "01:29:19", "text": "オンゴー、ただ、ええ、ジョー、覚えてるよ、はい"}, {"type": "subtitle", "time": 5366.95, "timestamp": "01:29:26", "text": "お願いします"}, {"type": "subtitle", "time": 5370.189, "timestamp": "01:29:30", "text": "剣士の剣はただ"}, {"type": "subtitle", "time": 5372.35, "timestamp": "01:29:32", "text": "剣と"}, {"type": "subtitle", "time": 5376.91, "timestamp": "01:29:36", "text": "ヘルメット、それだけ、それだけ"}, {"type": "subtitle", "time": 5381.149, "timestamp": "01:29:41", "text": "ヘルメット なぜあなたはこうなのですか"}, {"type": "subtitle", "time": 5385.149, "timestamp": "01:29:45", "text": "次の暗い次の"}, {"type": "subtitle", "time": 5387.709, "timestamp": "01:29:47", "text": "昨日、なぜあなたは"}, {"type": "subtitle", "time": 5391.79, "timestamp": "01:29:51", "text": "あなたは今日死ぬかもしれない"}, {"type": "subtitle", "time": 5395.59, "timestamp": "01:29:55", "text": "未来の理由"}, {"type": "subtitle", "time": 5398.39, "timestamp": "01:29:58", "text": "お願い、ああ神様、どうして私はこんなにバカなの"}]
[{"type": "subtitle", "time": 17102.39, "timestamp": "04:45:02", "text": "もっと大丈夫だからジャマ、ああこれはああ"}, {"type": "subtitle", "time": 17104.67, "timestamp": "04:45:04", "text": "神様、それは私が持っていないからだと思います"}, {"type": "subtitle", "time": 17121.948, "timestamp": "04:45:21", "text": "よかった、どこに帰ればいいの？"}, {"type": "subtitle", "time": 17125.708, "timestamp": "04:45:25", "text": "私の死ぬあなた、死ぬあなた、バク死ぬあなた、バク"}, {"type": "subtitle", "time": 17150.948, "timestamp": "04:45:50", "text": "いいえ"}, {"type": "subtitle", "time": 17155.43, "timestamp": "04:45:55", "text": "こんにちは、元気ですか？よくわかりませんが、私は"}]
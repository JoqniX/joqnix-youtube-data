[{"type": "subtitle", "time": 4088.95, "timestamp": "01:08:08", "text": "ダミーは花を見る"}, {"type": "subtitle", "time": 4091.87, "timestamp": "01:08:11", "text": "飛んでいる花が飛んでいる、何が起こっているのか"}, {"type": "subtitle", "time": 4095.43, "timestamp": "01:08:15", "text": "この世界では、はしごはなぜ飛ぶのか"}, {"type": "subtitle", "time": 4104.57, "timestamp": "01:08:24", "text": "飛行機に乗るととても気分が悪くなります"}, {"type": "subtitle", "time": 4132.559, "timestamp": "01:08:52", "text": "いやいや"}, {"type": "subtitle", "time": 4137.99, "timestamp": "01:08:57", "text": "私"}]
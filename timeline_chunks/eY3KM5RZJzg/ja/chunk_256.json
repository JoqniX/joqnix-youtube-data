[{"type": "subtitle", "time": 15360.87, "timestamp": "04:16:00", "text": "ああ神様、私はクを見つけた、いやいや、誰がそれをやったんだ"}, {"type": "subtitle", "time": 15363.63, "timestamp": "04:16:03", "text": "誰が、なぜそんなことをしたのか"}, {"type": "subtitle", "time": 15369.469, "timestamp": "04:16:09", "text": "兄弟、なぜ宝物が落ちたのか"}, {"type": "subtitle", "time": 15375.109, "timestamp": "04:16:15", "text": "私を置いて"}, {"type": "subtitle", "time": 15386.99, "timestamp": "04:16:26", "text": "待って、君がどこにいるか覚えてるよ、トイレットペーパーで拭いてあげる"}, {"type": "subtitle", "time": 15389.229, "timestamp": "04:16:29", "text": "そこにいたあなた、覚えています、ありがとう、あれは"}, {"type": "subtitle", "time": 15390.309, "timestamp": "04:16:30", "text": "1"}, {"type": "subtitle", "time": 15397.71, "timestamp": "04:16:37", "text": "宝物、ミツキはどこ？"}, {"type": "subtitle", "time": 15406.87, "timestamp": "04:16:46", "text": "こんにちは、こんにちは、キャスパン、あなたは挨拶しなかった"}, {"type": "subtitle", "time": 15419.71, "timestamp": "04:16:59", "text": "B ああ、君は"}]
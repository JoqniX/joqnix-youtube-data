[{"type": "subtitle", "time": 14222.55, "timestamp": "03:57:02", "text": "鎧 もっと良い鎧が欲しい なぜそれを使うのか"}, {"type": "subtitle", "time": 14225.149, "timestamp": "03:57:05", "text": "これを着けたらどうですか？"}, {"type": "subtitle", "time": 14228.55, "timestamp": "03:57:08", "text": "鉄製のヘルメットはいくらですか"}, {"type": "subtitle", "time": 14230.87, "timestamp": "03:57:10", "text": "鎧 いや"}, {"type": "subtitle", "time": 14234.349, "timestamp": "03:57:14", "text": "保存しておくといいですよ"}, {"type": "subtitle", "time": 14238.229, "timestamp": "03:57:18", "text": "ダイヤモンドを手に入れて、それを保管しておきましょう"}, {"type": "subtitle", "time": 14240.99, "timestamp": "03:57:20", "text": "安全です、ダイヤモンドに付けます"}, {"type": "subtitle", "time": 14244.189, "timestamp": "03:57:24", "text": "ヘルメットはどうやってそれを手に入れるのか、でも、"}, {"type": "subtitle", "time": 14247.03, "timestamp": "03:57:27", "text": "ダイヤモンドの胸当てとズボンと"}, {"type": "subtitle", "time": 14252.349, "timestamp": "03:57:32", "text": "ブーツ ウインク ウインク ウインク できるけど、"}, {"type": "subtitle", "time": 14256.83, "timestamp": "03:57:36", "text": "低レベルにエンチャントを無駄にしないでください"}, {"type": "subtitle", "time": 14262.149, "timestamp": "03:57:42", "text": "ギアH わかった、それではアイデアが浮かんだので"}, {"type": "subtitle", "time": 14264.389, "timestamp": "03:57:44", "text": "これらを保管してください。私のエンダーチェストは"}, {"type": "subtitle", "time": 14267.67, "timestamp": "03:57:47", "text": "このバージョンでは利用可能ではなく、"}, {"type": "subtitle", "time": 14269.149, "timestamp": "03:57:49", "text": "シーズンになります"}, {"type": "subtitle", "time": 14272.349, "timestamp": "03:57:52", "text": "シーズン3 3 私は言わないよ"}, {"type": "subtitle", "time": 14274.149, "timestamp": "03:57:54", "text": "別のゲームをプレイする"}, {"type": "subtitle", "time": 14276.51, "timestamp": "03:57:56", "text": "季節"}, {"type": "subtitle", "time": 14279.91, "timestamp": "03:57:59", "text": "いや、もうプレイしたくない"}]
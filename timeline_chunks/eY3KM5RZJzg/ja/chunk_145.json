[{"type": "subtitle", "time": 8701.469, "timestamp": "02:25:01", "text": "ああ、なんてことだ、食べ物があるの？待って"}, {"type": "subtitle", "time": 8704.11, "timestamp": "02:25:04", "text": "ここのキノコは食べられるよ、ああ"}, {"type": "subtitle", "time": 8707.03, "timestamp": "02:25:07", "text": "くそ、俺は死んだ、いやいやいやいや、やめて"}, {"type": "subtitle", "time": 8709.83, "timestamp": "02:25:09", "text": "やめて、やめて、やめて、ああ、いやいやいやいやいや"}, {"type": "subtitle", "time": 8713.95, "timestamp": "02:25:13", "text": "いいえ、私は、私は、私は、私は、私は、食べる、食べる、食べる、食べる"}, {"type": "subtitle", "time": 8716.349, "timestamp": "02:25:16", "text": "食べて食べて殺す、食べてる、食べてる、食べてる"}, {"type": "subtitle", "time": 8717.95, "timestamp": "02:25:17", "text": "食べ物がない 食べ物がない"}, {"type": "subtitle", "time": 8738.269, "timestamp": "02:25:38", "text": "今日人を殺すのは不吉だ"}, {"type": "subtitle", "time": 8742.389, "timestamp": "02:25:42", "text": "私のマイクが壊れてしまいました"}, {"type": "subtitle", "time": 8745.59, "timestamp": "02:25:45", "text": "兄弟、どうにかしてやってるよ、わからないけど"}, {"type": "subtitle", "time": 8748.389, "timestamp": "02:25:48", "text": "男はどうだ、Fを持っているのか"}, {"type": "subtitle", "time": 8751.469, "timestamp": "02:25:51", "text": "何が起こったのか"}, {"type": "subtitle", "time": 8756.67, "timestamp": "02:25:56", "text": "ああ、マイクが壊れてるよ。"}, {"type": "subtitle", "time": 8759.55, "timestamp": "02:25:59", "text": "ゴドムなので新しいブームを注文しなければなりません"}]
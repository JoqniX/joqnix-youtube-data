[{"type": "subtitle", "time": 2761.39, "timestamp": "00:46:01", "text": "あなたに願っています 私は願っています ああ、いいえ"}, {"type": "subtitle", "time": 2764.63, "timestamp": "00:46:04", "text": "ボは嫌い"}, {"type": "subtitle", "time": 2768.15, "timestamp": "00:46:08", "text": "よし、ロールプレイを中断しよう"}, {"type": "subtitle", "time": 2771.109, "timestamp": "00:46:11", "text": "2番目に、あなたが持っていることを願っています。"}, {"type": "subtitle", "time": 2773.75, "timestamp": "00:46:13", "text": "あなたが手に入れることを願っている"}, {"type": "subtitle", "time": 2783.67, "timestamp": "00:46:23", "text": "こんにちは、私たちは24時間365日ライブ配信しています"}, {"type": "chat", "time": 2785.276, "timestamp": "00:46:25", "author": "@オニオン田中", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mfuIF27RMwX6DcAuf18U_0UBTsU2g7DgpNKYestnxkWZ4=s64-c-k-c0x00ffffff-no-rj", "message": "arigato !"}, {"type": "subtitle", "time": 2786.91, "timestamp": "00:46:26", "text": "7月に日本に行く前に、6月まで待っています"}, {"type": "subtitle", "time": 2789.67, "timestamp": "00:46:29", "text": "だから、新しい"}, {"type": "subtitle", "time": 2791.109, "timestamp": "00:46:31", "text": "自分"}, {"type": "subtitle", "time": 2794.51, "timestamp": "00:46:34", "text": "モデル、ええ、そのために私は働いています"}, {"type": "subtitle", "time": 2797.75, "timestamp": "00:46:37", "text": "現在の限界を超えるのはより困難だ"}, {"type": "subtitle", "time": 2800.71, "timestamp": "00:46:40", "text": "そして現在の制限は"}, {"type": "subtitle", "time": 2804.349, "timestamp": "00:46:44", "text": "そうですね、とても"}, {"type": "subtitle", "time": 2806.829, "timestamp": "00:46:46", "text": "ああ、私はどこにいたんだろう"}, {"type": "subtitle", "time": 2815.03, "timestamp": "00:46:55", "text": "場所"}]
[{"type": "subtitle", "time": 10032.51, "timestamp": "02:47:12", "text": "時々水を飲む必要がある"}, {"type": "subtitle", "time": 10035.389, "timestamp": "02:47:15", "text": "いずれは出てくるが、それほど頻繁ではない"}, {"type": "subtitle", "time": 10042.95, "timestamp": "02:47:22", "text": "これであなたも同じことができます"}, {"type": "subtitle", "time": 10045.429, "timestamp": "02:47:25", "text": "パンツとして"}, {"type": "subtitle", "time": 10054.389, "timestamp": "02:47:34", "text": "グラインドするよ、だから行かなきゃいけないんだ"}, {"type": "subtitle", "time": 10057.71, "timestamp": "02:47:37", "text": "水中では、水中に潜ることができ、"}, {"type": "subtitle", "time": 10060.389, "timestamp": "02:47:40", "text": "あなたほど頻繁に出かける必要はありません"}, {"type": "subtitle", "time": 10063.309, "timestamp": "02:47:43", "text": "ジョーが好きにならざるを得なかったのですが、説明していただけますか？"}, {"type": "subtitle", "time": 10065.87, "timestamp": "02:47:45", "text": "彼女にこれを渡す、ああ待って、それは理解できない、私はできる"}, {"type": "subtitle", "time": 10069.11, "timestamp": "02:47:49", "text": "あなたにはすでに黄金の"}, {"type": "subtitle", "time": 10072.87, "timestamp": "02:47:52", "text": "両生類みたいなやつ、いや、彼女はもうそれを手に入れたよ"}, {"type": "subtitle", "time": 10076.51, "timestamp": "02:47:56", "text": "ああ、彼女はそれを受け取ったよ。ジョー、鉄分はある？"}, {"type": "subtitle", "time": 10079.349, "timestamp": "02:47:59", "text": "私は持っていますか"}]
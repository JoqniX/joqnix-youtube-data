[{"type": "subtitle", "time": 12541.11, "timestamp": "03:29:01", "text": "行くよ、私は"}, {"type": "subtitle", "time": 12544.229, "timestamp": "03:29:04", "text": "正直言って、あなたの周りはちょっと…"}, {"type": "subtitle", "time": 12546.99, "timestamp": "03:29:06", "text": "私のチームよ、君たちは私がチェリーを作ったことを忘れている"}, {"type": "subtitle", "time": 12549.309, "timestamp": "03:29:09", "text": "ブロッサムと階段、そして私たちはそれをすべてやった"}, {"type": "subtitle", "time": 12552.55, "timestamp": "03:29:12", "text": "武器をくれました クエスト 新しい いいえ、いいえ、何"}, {"type": "subtitle", "time": 12555.389, "timestamp": "03:29:15", "text": "新しいクエストがまだ動作しない場合"}, {"type": "subtitle", "time": 12556.63, "timestamp": "03:29:16", "text": "私たち"}, {"type": "subtitle", "time": 12559.189, "timestamp": "03:29:19", "text": "私はそれを受け入れません"}, {"type": "subtitle", "time": 12563.389, "timestamp": "03:29:23", "text": "もちろん私はクエストではない"}, {"type": "subtitle", "time": 12566.63, "timestamp": "03:29:26", "text": "約束するよ、私のダイヤモンドをあげる"}, {"type": "subtitle", "time": 12568.99, "timestamp": "03:29:28", "text": "ダイヤモンドの剣なら、あなたはノーノーであるべきです"}, {"type": "subtitle", "time": 12572.79, "timestamp": "03:29:32", "text": "いいえ、それなら削除できるはずです"}, {"type": "subtitle", "time": 12574.51, "timestamp": "03:29:34", "text": "そうすれば、どこで"}, {"type": "subtitle", "time": 12577.189, "timestamp": "03:29:37", "text": "あなたはどこから物を手に入れたのですか？そして私を助けてください"}, {"type": "subtitle", "time": 12579.67, "timestamp": "03:29:39", "text": "見逃しが多すぎて少し残念です"}, {"type": "subtitle", "time": 12583.11, "timestamp": "03:29:43", "text": "だって私は、ああ、あなたは"}, {"type": "subtitle", "time": 12586.79, "timestamp": "03:29:46", "text": "プレイしてプレイして進歩する"}, {"type": "subtitle", "time": 12591.309, "timestamp": "03:29:51", "text": "やるべきことをやらなければ、"}, {"type": "subtitle", "time": 12594.07, "timestamp": "03:29:54", "text": "助ける、いやいやいや、文字通りそれは"}, {"type": "subtitle", "time": 12596.83, "timestamp": "03:29:56", "text": "私がやったことは、文字通り私がやったことです"}]
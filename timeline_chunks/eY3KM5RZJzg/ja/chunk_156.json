[{"type": "subtitle", "time": 9364.71, "timestamp": "02:36:04", "text": "はい、こんにちは。それで、あの、ラインは"}, {"type": "subtitle", "time": 9368.03, "timestamp": "02:36:08", "text": "彼女への贈り物"}, {"type": "subtitle", "time": 9370.59, "timestamp": "02:36:10", "text": "ギフトミツキにアンカーを返す"}, {"type": "subtitle", "time": 9371.99, "timestamp": "02:36:11", "text": "私があなたにあげたものと、私があなたにあげるもの"}, {"type": "subtitle", "time": 9374.389, "timestamp": "02:36:14", "text": "レイン"}, {"type": "subtitle", "time": 9378.349, "timestamp": "02:36:18", "text": "まず、気持ちを落ち着かせてください、と私は言いました。"}, {"type": "subtitle", "time": 9380.55, "timestamp": "02:36:20", "text": "1分後に1つだけやります"}, {"type": "subtitle", "time": 9382.23, "timestamp": "02:36:22", "text": "すぐ戻ります。実は今出かけているんです。"}, {"type": "subtitle", "time": 9385.91, "timestamp": "02:36:25", "text": "もう寝るから、あ、こんにちは、あ、待って、私の"}, {"type": "subtitle", "time": 9389.11, "timestamp": "02:36:29", "text": "クエスト、大丈夫、問題ない、問題ない"}, {"type": "subtitle", "time": 9390.79, "timestamp": "02:36:30", "text": "明日明日明日明日やる"}, {"type": "subtitle", "time": 9393.87, "timestamp": "02:36:33", "text": "明日、明日、わかった、わかった、うん、それは"}, {"type": "subtitle", "time": 9395.389, "timestamp": "02:36:35", "text": "本当に素晴らしいクエストだ、君たちは彼を倒せる"}, {"type": "subtitle", "time": 9396.99, "timestamp": "02:36:36", "text": "お前らは自分の物を持って行け、彼の物を持って行け"}, {"type": "subtitle", "time": 9399.11, "timestamp": "02:36:39", "text": "くそ、いい感じになるってわかってるよ"}, {"type": "subtitle", "time": 9401.469, "timestamp": "02:36:41", "text": "彼はどこにいる？彼はどこにいる？ええと、あなたに"}, {"type": "subtitle", "time": 9402.99, "timestamp": "02:36:42", "text": "このコンパスをあげよう"}, {"type": "subtitle", "time": 9405.23, "timestamp": "02:36:45", "text": "彼の基地を指し示すので、"}, {"type": "subtitle", "time": 9407.349, "timestamp": "02:36:47", "text": "彼が留守の間に彼の基地で待ち伏せする"}, {"type": "subtitle", "time": 9409.23, "timestamp": "02:36:49", "text": "そういうのを知ってる？Kに教えてあげて、それらは"}, {"type": "subtitle", "time": 9412.63, "timestamp": "02:36:52", "text": "下のもののおかげで"}, {"type": "subtitle", "time": 9414.309, "timestamp": "02:36:54", "text": "それを買ってくれるなら、"}, {"type": "subtitle", "time": 9415.63, "timestamp": "02:36:55", "text": "本当に安い値段で買います"}, {"type": "subtitle", "time": 9419.07, "timestamp": "02:36:59", "text": "腐った肉、さらに腐った肉の山"}]
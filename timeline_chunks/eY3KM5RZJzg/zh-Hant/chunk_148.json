[{"type": "subtitle", "time": 8892.63, "timestamp": "02:28:12", "text": "我不能跳，為什麼用"}, {"type": "subtitle", "time": 8897.95, "timestamp": "02:28:17", "text": "你的錨，用你的錨，不，哦不，她，她，她，她，她"}, {"type": "subtitle", "time": 8900.71, "timestamp": "02:28:20", "text": "漂浮著，救救她，哦，等等，好的，好的，好的，來，來，來，來，"}, {"type": "subtitle", "time": 8911.23, "timestamp": "02:28:31", "text": "你看到你的"}]
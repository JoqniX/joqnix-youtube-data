[{"type": "subtitle", "time": 41047.15, "timestamp": "11:24:07", "text": "酷了，這不是一樣的東西嗎？我以為"}, {"type": "subtitle", "time": 41057.586, "timestamp": "11:24:17", "text": "[掌聲]"}, {"type": "subtitle", "time": 41060.83, "timestamp": "11:24:20", "text": "這些皮膚一樣嗎？這是"}, {"type": "subtitle", "time": 41065.03, "timestamp": "11:24:25", "text": "登入"}, {"type": "subtitle", "time": 41079.426, "timestamp": "11:24:39", "text": "就像我知道"}, {"type": "subtitle", "time": 41081.47, "timestamp": "11:24:41", "text": "堡壘之夜一樣，會有時間"}, {"type": "subtitle", "time": 41084.35, "timestamp": "11:24:44", "text": "限制，對吧，會有時間限制，"}, {"type": "subtitle", "time": 41086.23, "timestamp": "11:24:46", "text": "對吧，"}, {"type": "subtitle", "time": 41093.266, "timestamp": "11:24:53", "text": "[音樂]"}]
[{"type": "subtitle", "time": 15840.349, "timestamp": "04:24:00", "text": "我會把"}, {"type": "subtitle", "time": 15854.87, "timestamp": "04:24:14", "text": "卡片給你。請讓她睡。"}, {"type": "subtitle", "time": 15856.83, "timestamp": "04:24:16", "text": "請讓她睡。不要讓她哭。今天是，今天是大家一起上車的日子。 [音樂]今天她需要甜蜜的慰藉。請不要回來。"}, {"type": "subtitle", "time": 15868.79, "timestamp": "04:24:28", "text": "我會沒事的，別擔心。我"}, {"type": "subtitle", "time": 15883.51, "timestamp": "04:24:43", "text": "今天殺了差不多37頭牛和好多羊。"}, {"type": "subtitle", "time": 15887.91, "timestamp": "04:24:47", "text": "哦，我的天哪，你好。我差點尖叫。"}]
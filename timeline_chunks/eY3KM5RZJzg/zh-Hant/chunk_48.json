[{"type": "chat", "time": 2910.982, "timestamp": "00:48:30", "author": "@Back2005", "avatar": "https://yt4.ggpht.com/TUs_4eRxRjlVzlXUYnX60TXdeAhcF6DoQ2WfJraVpgcKoWcXvMAWUx0pU_9A7UkQz99bCYkx5w=s64-c-k-c0x00ffffff-no-rj", "message": "jazzuma asked id you can crank that soldia boi"}, {"type": "subtitle", "time": 2930.91, "timestamp": "00:48:50", "text": "還是我偶然發現的某個地方？我真的不知道。我看到了櫻花，它們讓我想起了我的家鄉。在我家鄉，櫻花盛開的時候"}, {"type": "subtitle", "time": 2933.39, "timestamp": "00:48:53", "text": "通常會下雪，但我看到的土地更像是春天，或者更狂野一些，因為我看到樹葉垂掛在樹上。是的，我們越是冒險穿越海洋，看到的景象就越多。我看到這邊有一棟房子，我想看看是誰住的。那是一棟草坪房子，很長，裡面什麼都沒有。但"}, {"type": "chat", "time": 2934.538, "timestamp": "00:48:54", "author": "@Back2005", "avatar": "https://yt4.ggpht.com/TUs_4eRxRjlVzlXUYnX60TXdeAhcF6DoQ2WfJraVpgcKoWcXvMAWUx0pU_9A7UkQz99bCYkx5w=s64-c-k-c0x00ffffff-no-rj", "message": "ok"}]
[{"type": "subtitle", "time": 10325.63, "timestamp": "02:52:05", "text": "等等，"}, {"type": "subtitle", "time": 10327.74, "timestamp": "02:52:07", "text": "呃，什麼？你"}, {"type": "subtitle", "time": 10332.99, "timestamp": "02:52:12", "text": "需要鐵嗎？我可以給你鐵，我有鐵，我有24個鐵。等等，讓我"}, {"type": "subtitle", "time": 10335.469, "timestamp": "02:52:15", "text": "給你。拿著。你知道什麼看起來不錯嗎？祖基金胸甲和鑽石褲子，那樣看起來比較好。來吧，我什麼都沒有。"}, {"type": "subtitle", "time": 10349.309, "timestamp": "02:52:29", "text": "喔等等，去……鑽石盔甲怎麼樣？因為"}, {"type": "subtitle", "time": 10352.469, "timestamp": "02:52:32", "text": "你有藍頭髮。等等，我有多餘的"}]
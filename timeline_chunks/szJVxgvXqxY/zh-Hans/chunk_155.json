[{"type": "subtitle", "time": 9313.75, "timestamp": "02:35:13", "text": "那。会有一些下滑。"}, {"type": "subtitle", "time": 9331.349, "timestamp": "02:35:31", "text": "呃，好的。我弄到了一些桦木，但我没有"}, {"type": "subtitle", "time": 9333.75, "timestamp": "02:35:33", "text": "现在就跑回去。否则，我"}, {"type": "subtitle", "time": 9335.83, "timestamp": "02:35:35", "text": "这里所有人都要来挠我痒痒了"}, {"type": "subtitle", "time": 9340.229, "timestamp": "02:35:40", "text": "我的天，已经有人了。"}, {"type": "subtitle", "time": 9342.87, "timestamp": "02:35:42", "text": "关注我。好吧，我觉得更热"}, {"type": "subtitle", "time": 9346.03, "timestamp": "02:35:46", "text": "会有东西生成。躲藏者杀人"}, {"type": "subtitle", "time": 9349.95, "timestamp": "02:35:49", "text": "东西。我的天，有boss！"}, {"type": "subtitle", "time": 9353.67, "timestamp": "02:35:53", "text": "这里。好吧，我可能需要帮助。嗯"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "糟糕，我被人群包围了。我们是否应该"}, {"type": "subtitle", "time": 9357.19, "timestamp": "02:35:57", "text": "这里还有吃的吗？我们没有"}, {"type": "subtitle", "time": 9359.11, "timestamp": "02:35:59", "text": "这里有食物。是的，我真的"}]
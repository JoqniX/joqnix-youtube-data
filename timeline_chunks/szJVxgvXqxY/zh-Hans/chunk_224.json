[{"type": "subtitle", "time": 13447.15, "timestamp": "03:44:07", "text": "哇。畜牧业"}, {"type": "subtitle", "time": 13449.31, "timestamp": "03:44:09", "text": "采矿航行"}, {"type": "subtitle", "time": 13453.51, "timestamp": "03:44:13", "text": "占星术。我可以用占星术吗？不。"}, {"type": "subtitle", "time": 13461.31, "timestamp": "03:44:21", "text": "现在。"}, {"type": "subtitle", "time": 13469.67, "timestamp": "03:44:29", "text": "哦。哦，这些都是伟大的人，或者"}, {"type": "subtitle", "time": 13471.99, "timestamp": "03:44:31", "text": "某物。我不知道。"}, {"type": "subtitle", "time": 13474.708, "timestamp": "03:44:34", "text": "呃，音乐家、作家、伟大的科学家，"}, {"type": "subtitle", "time": 13477.59, "timestamp": "03:44:37", "text": "伟大的诗人，伟大的工程师，伟大的"}, {"type": "subtitle", "time": 13480.03, "timestamp": "03:44:40", "text": "海军上将，伟大的"}, {"type": "subtitle", "time": 13485.708, "timestamp": "03:44:45", "text": "一般而言，采矿业。呃，yahalaka"}, {"type": "subtitle", "time": 13490.75, "timestamp": "03:44:50", "text": "waka 无人认领的领土。什么？什么？"}, {"type": "subtitle", "time": 13493.91, "timestamp": "03:44:53", "text": "嗯？他们是战士。我可以做"}, {"type": "subtitle", "time": 13497.03, "timestamp": "03:44:57", "text": "他们从事农业工作吗？哦，等等。"}]
[{"type": "subtitle", "time": 9061.19, "timestamp": "02:31:01", "text": "这里有四个魔像。"}, {"type": "subtitle", "time": 9062.95, "timestamp": "02:31:02", "text": "是啊，我真的不想死在这里。"}, {"type": "subtitle", "time": 9069.99, "timestamp": "02:31:09", "text": "我现在只想赶紧跑。目前。"}, {"type": "subtitle", "time": 9071.75, "timestamp": "02:31:11", "text": "我只想尽快完成这件事"}, {"type": "subtitle", "time": 9072.87, "timestamp": "02:31:12", "text": "死。好了，他死了。他死了。他是"}, {"type": "subtitle", "time": 9075.75, "timestamp": "02:31:15", "text": "死的。他死了。集中注意力。集中注意力"}, {"type": "subtitle", "time": 9077.269, "timestamp": "02:31:17", "text": "一个。专注于任何一项"}, {"type": "subtitle", "time": 9084.229, "timestamp": "02:31:24", "text": "好的，又来一个。"}, {"type": "subtitle", "time": 9086.79, "timestamp": "02:31:26", "text": "好的。好了。我们正在制作"}, {"type": "subtitle", "time": 9089.03, "timestamp": "02:31:29", "text": "进步。我是一半。但你只是"}, {"type": "subtitle", "time": 9090.55, "timestamp": "02:31:30", "text": "好的，我只需轻轻一点。我只需轻轻一点。我是"}, {"type": "subtitle", "time": 9091.95, "timestamp": "02:31:31", "text": "准备离家出走"}, {"type": "subtitle", "time": 9102.469, "timestamp": "02:31:42", "text": "嗯，我先去吃点东西。哦"}, {"type": "subtitle", "time": 9104.349, "timestamp": "02:31:44", "text": "嘘"}, {"type": "subtitle", "time": 9107.19, "timestamp": "02:31:47", "text": "死了。我还活着。应该没问题。做"}, {"type": "chat", "time": 9108.845, "timestamp": "02:31:48", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "Azura lapis!"}, {"type": "subtitle", "time": 9109.99, "timestamp": "02:31:49", "text": "你的金币够用吗？"}, {"type": "subtitle", "time": 9113.19, "timestamp": "02:31:53", "text": "我也这么认为。前往复活代币处。呃，"}, {"type": "subtitle", "time": 9117.269, "timestamp": "02:31:57", "text": "我想，该轮到“过来”了。能"}]
[{"type": "subtitle", "time": 11460.229, "timestamp": "03:11:00", "text": "推迟到四月或其他什么时间"}, {"type": "subtitle", "time": 11462.55, "timestamp": "03:11:02", "text": "年。"}, {"type": "subtitle", "time": 11465.189, "timestamp": "03:11:05", "text": "我有点担心。想象一下我做了这一切"}, {"type": "subtitle", "time": 11469.11, "timestamp": "03:11:09", "text": "现在这个 Joathon，我，我，我，我"}, {"type": "subtitle", "time": 11471.91, "timestamp": "03:11:11", "text": "就好像我没打算去日本一样"}, {"type": "subtitle", "time": 11475.75, "timestamp": "03:11:15", "text": "今年七月。我要走了，我只能走了"}, {"type": "subtitle", "time": 11480.229, "timestamp": "03:11:20", "text": "到四月份吧，兄弟。"}, {"type": "subtitle", "time": 11484.229, "timestamp": "03:11:24", "text": "我的意思是，我不介意下一个上去。我，我是"}, {"type": "subtitle", "time": 11487.91, "timestamp": "03:11:27", "text": "本来应该像这样，嗯，我和一些人"}, {"type": "subtitle", "time": 11489.67, "timestamp": "03:11:29", "text": "同学们应该去。所以他们"}, {"type": "subtitle", "time": 11494.07, "timestamp": "03:11:34", "text": "打电话叫我们所有人去那里"}, {"type": "subtitle", "time": 11497.349, "timestamp": "03:11:37", "text": "呃，去学院和他们谈谈"}, {"type": "subtitle", "time": 11501.189, "timestamp": "03:11:41", "text": "明天的人们就像早晨一样。"}, {"type": "subtitle", "time": 11503.59, "timestamp": "03:11:43", "text": "幸好我身边没有人。"}, {"type": "subtitle", "time": 11505.349, "timestamp": "03:11:45", "text": "明天早上，否则我就会……"}, {"type": "subtitle", "time": 11508.87, "timestamp": "03:11:48", "text": "不得不取消预订。是的。不，我不能"}, {"type": "subtitle", "time": 11510.95, "timestamp": "03:11:50", "text": "取消它们。是的。是的。我邀请的客人"}, {"type": "subtitle", "time": 11514.389, "timestamp": "03:11:54", "text": "现在必须重新安排时间了。所以，就是这样。"}, {"type": "subtitle", "time": 11518.389, "timestamp": "03:11:58", "text": "已经排名第九了吧？有人告诉我这一点"}]
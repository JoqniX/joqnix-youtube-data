[{"type": "subtitle", "time": 9746.15, "timestamp": "02:42:26", "text": "有很多boss战，但我"}, {"type": "subtitle", "time": 9773.349, "timestamp": "02:42:53", "text": "木头。我以为我开局不错。"}, {"type": "subtitle", "time": 9775.269, "timestamp": "02:42:55", "text": "因为我看到了黄金，但我甚至都无法……"}, {"type": "subtitle", "time": 9777.349, "timestamp": "02:42:57", "text": "打破它。所以，这真是太糟糕了。"}, {"type": "subtitle", "time": 9779.51, "timestamp": "02:42:59", "text": "现在就开始。"}]
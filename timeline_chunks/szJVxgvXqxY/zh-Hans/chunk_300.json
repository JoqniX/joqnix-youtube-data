[{"type": "subtitle", "time": 18002.15, "timestamp": "05:00:02", "text": "去。愿你"}, {"type": "subtitle", "time": 18005.03, "timestamp": "05:00:05", "text": "我支持你。是的，你就在我身后。"}, {"type": "subtitle", "time": 18022.83, "timestamp": "05:00:22", "text": "一个"}, {"type": "subtitle", "time": 18025.91, "timestamp": "05:00:25", "text": "不。是的。灵盒。呃，它显示了"}, {"type": "subtitle", "time": 18040.868, "timestamp": "05:00:40", "text": "我的天哪，它在地下室。哦，不。"}, {"type": "subtitle", "time": 18042.948, "timestamp": "05:00:42", "text": "是在地下室吗？还是在其他地方？"}, {"type": "subtitle", "time": 18047.51, "timestamp": "05:00:47", "text": "楼梯上方？"}, {"type": "subtitle", "time": 18050.628, "timestamp": "05:00:50", "text": "我不知道。我需要核实一下。我希望"}, {"type": "subtitle", "time": 18052.788, "timestamp": "05:00:52", "text": "不是地下室。我应该放一个"}, {"type": "subtitle", "time": 18054.31, "timestamp": "05:00:54", "text": "相机？"}]
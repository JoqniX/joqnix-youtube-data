[{"type": "subtitle", "time": 11711.03, "timestamp": "03:15:11", "text": "哦好的。好球。别再让我这样了。"}, {"type": "subtitle", "time": 11721.83, "timestamp": "03:15:21", "text": "太棒了。那真是太好了"}, {"type": "subtitle", "time": 11724.87, "timestamp": "03:15:24", "text": "兄弟，开枪了。"}, {"type": "subtitle", "time": 11737.309, "timestamp": "03:15:37", "text": "需要一个"}, {"type": "subtitle", "time": 11740.71, "timestamp": "03:15:40", "text": "降低。需要滴一滴。"}, {"type": "subtitle", "time": 11743.429, "timestamp": "03:15:43", "text": "谢谢。好了，我回来了。我回来了。"}, {"type": "subtitle", "time": 11746.309, "timestamp": "03:15:46", "text": "欢迎回来，兄弟。你看到我投篮了吗？"}, {"type": "subtitle", "time": 11749.83, "timestamp": "03:15:49", "text": "是啊，太棒了！"}]
[{"type": "subtitle", "time": 14523.27, "timestamp": "04:02:03", "text": "贸易。嗯？呃，参战了。等待，"}, {"type": "subtitle", "time": 14526.75, "timestamp": "04:02:06", "text": "建立针对目标的联合战争"}, {"type": "subtitle", "time": 14529.11, "timestamp": "04:02:09", "text": "文明。交易者会遇到交易者。"}, {"type": "subtitle", "time": 14531.51, "timestamp": "04:02:11", "text": "好的，我们就用外国贸易商这个词吧。"}, {"type": "subtitle", "time": 14533.55, "timestamp": "04:02:13", "text": "让我们选择生产方式。"}, {"type": "subtitle", "time": 14537.31, "timestamp": "04:02:17", "text": "嗯，我走吧"}, {"type": "subtitle", "time": 14540.39, "timestamp": "04:02:20", "text": "所以我们需要更多的城市等等。"}, {"type": "subtitle", "time": 14543.31, "timestamp": "04:02:23", "text": "正确的？所以，我们就这么定了。"}, {"type": "subtitle", "time": 14551.15, "timestamp": "04:02:31", "text": "这里。"}, {"type": "subtitle", "time": 14556.31, "timestamp": "04:02:36", "text": "呃，下一个。放了他。"}, {"type": "subtitle", "time": 14558.628, "timestamp": "04:02:38", "text": "正如我们的公民对您充满信心一样"}, {"type": "subtitle", "time": 14560.628, "timestamp": "04:02:40", "text": "领导层，所以他们开始……"}, {"type": "subtitle", "time": 14562.23, "timestamp": "04:02:42", "text": "要信仰更高的力量。我认为"}, {"type": "subtitle", "time": 14565.47, "timestamp": "04:02:45", "text": "他的声音旨在培养这种新的方式"}, {"type": "subtitle", "time": 14567.75, "timestamp": "04:02:47", "text": "认为这样做有一些好处，好吧，"}, {"type": "subtitle", "time": 14570.31, "timestamp": "04:02:50", "text": "请告诉我更多细节。信仰是流通的货币"}, {"type": "subtitle", "time": 14572.948, "timestamp": "04:02:52", "text": "宗教信仰可以通过梵德获得。"}, {"type": "subtitle", "time": 14575.91, "timestamp": "04:02:55", "text": "奇迹、政策、领导能力"}, {"type": "subtitle", "time": 14578.708, "timestamp": "04:02:58", "text": "自然奇观、城邦、信仰"}]
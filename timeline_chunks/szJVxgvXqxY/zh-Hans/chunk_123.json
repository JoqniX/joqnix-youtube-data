[{"type": "subtitle", "time": 7390.87, "timestamp": "02:03:10", "text": "玩家外卡。"}, {"type": "subtitle", "time": 7401.95, "timestamp": "02:03:21", "text": "是的，我做了一个工艺品"}, {"type": "subtitle", "time": 7404.95, "timestamp": "02:03:24", "text": "桌子。咱们就……呃，咱们就用……"}, {"type": "subtitle", "time": 7406.79, "timestamp": "02:03:26", "text": "其中一间棚屋。哦，有一个"}, {"type": "subtitle", "time": 7410.59, "timestamp": "02:03:30", "text": "工作台已经在这里了。"}, {"type": "subtitle", "time": 7413.429, "timestamp": "02:03:33", "text": "哦，我还从某个地方弄到了铁条……"}, {"type": "subtitle", "time": 7415.99, "timestamp": "02:03:35", "text": "铁匠铺。"}, {"type": "subtitle", "time": 7418.55, "timestamp": "02:03:38", "text": "哦，不错。"}, {"type": "subtitle", "time": 7423.11, "timestamp": "02:03:43", "text": "我弄到了一把斧子，但它就像……"}, {"type": "subtitle", "time": 7437.309, "timestamp": "02:03:57", "text": "别忘了买煤。我们将制作一个"}]
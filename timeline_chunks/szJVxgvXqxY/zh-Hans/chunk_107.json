[{"type": "subtitle", "time": 6423.389, "timestamp": "01:47:03", "text": "牛、莫娜，还有我们要杀的"}, {"type": "subtitle", "time": 6425.63, "timestamp": "01:47:05", "text": "你。我会得到"}, {"type": "subtitle", "time": 6428.309, "timestamp": "01:47:08", "text": "这。我喜欢它，它不像那样逃跑。"}, {"type": "subtitle", "time": 6430.23, "timestamp": "01:47:10", "text": "我的世界。"}, {"type": "subtitle", "time": 6433.99, "timestamp": "01:47:13", "text": "它会一直待在那里，承受所有的……"}, {"type": "subtitle", "time": 6448.63, "timestamp": "01:47:28", "text": "好的。哦，那是生肉。哦，我们需要"}, {"type": "subtitle", "time": 6450.19, "timestamp": "01:47:30", "text": "我认为"}, {"type": "subtitle", "time": 6453.19, "timestamp": "01:47:33", "text": "嗯，把它煮熟。"}]
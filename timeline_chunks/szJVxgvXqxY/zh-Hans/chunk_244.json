[{"type": "subtitle", "time": 14641.51, "timestamp": "04:04:01", "text": "挖掘。就像大富翁游戏，但更好玩。"}, {"type": "subtitle", "time": 14644.19, "timestamp": "04:04:04", "text": "等待。垄断。什么？哦，是的。你好"}, {"type": "subtitle", "time": 14647.708, "timestamp": "04:04:07", "text": "凯。政治与经济。"}, {"type": "subtitle", "time": 14651.43, "timestamp": "04:04:11", "text": "是的。政治与经济。现在是"}, {"type": "subtitle", "time": 14653.41, "timestamp": "04:04:13", "text": "骑师该学习了"}, {"type": "subtitle", "time": 14662.39, "timestamp": "04:04:22", "text": "历史。我的天哪。奶茶是茶"}, {"type": "subtitle", "time": 14663.47, "timestamp": "04:04:23", "text": "所以"}, {"type": "subtitle", "time": 14666.75, "timestamp": "04:04:26", "text": "好的。等待。不加奶茶。那是牛奶。"}, {"type": "subtitle", "time": 14670.27, "timestamp": "04:04:30", "text": "是的。你好。所以，我们解锁了"}, {"type": "subtitle", "time": 14676.03, "timestamp": "04:04:36", "text": "嗯，我们解锁了采矿，还有动物。"}, {"type": "subtitle", "time": 14683.708, "timestamp": "04:04:43", "text": "我们是否需要一个"}, {"type": "subtitle", "time": 14686.47, "timestamp": "04:04:46", "text": "制作。哦，等等。我可以扎多少根刺？"}, {"type": "subtitle", "time": 14689.47, "timestamp": "04:04:49", "text": "更容易获得？我们来看第三部分。"}, {"type": "subtitle", "time": 14693.91, "timestamp": "04:04:53", "text": "接下来，请前往此处。最好使用"}, {"type": "subtitle", "time": 14695.91, "timestamp": "04:04:55", "text": "靠近敌人时要小心"}, {"type": "subtitle", "time": 14697.67, "timestamp": "04:04:57", "text": "单位。"}, {"type": "subtitle", "time": 14699.59, "timestamp": "04:04:59", "text": "通常会迫使该装置处于……状态"}]
[{"type": "subtitle", "time": 1878.149, "timestamp": "00:31:18", "text": "我们走吧。我的天啊。好的。"}, {"type": "subtitle", "time": 1881.189, "timestamp": "00:31:21", "text": "我当时想"}, {"type": "subtitle", "time": 1901.31, "timestamp": "00:31:41", "text": "哦，我吃饱了。"}, {"type": "subtitle", "time": 1915.75, "timestamp": "00:31:55", "text": "我总是忘记生活。圆圈"}, {"type": "subtitle", "time": 1918.229, "timestamp": "00:31:58", "text": "生活。"}]
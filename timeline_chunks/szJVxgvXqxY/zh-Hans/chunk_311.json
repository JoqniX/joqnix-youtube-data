[{"type": "subtitle", "time": 18667.15, "timestamp": "05:11:07", "text": "哦，"}, {"type": "subtitle", "time": 18671.51, "timestamp": "05:11:11", "text": "指纹。指纹冻结。"}, {"type": "subtitle", "time": 18673.548, "timestamp": "05:11:13", "text": "呃"}, {"type": "subtitle", "time": 18677.43, "timestamp": "05:11:17", "text": "指纹缺失。糟糕。我没有"}, {"type": "subtitle", "time": 18697.628, "timestamp": "05:11:37", "text": "未来。跑步。"}, {"type": "subtitle", "time": 18700.15, "timestamp": "05:11:40", "text": "跑步。好的。好的。好的。没关系。是"}, {"type": "subtitle", "time": 18703.11, "timestamp": "05:11:43", "text": "是否存在交互作用？我的天啊。"}, {"type": "subtitle", "time": 18704.868, "timestamp": "05:11:44", "text": "什么？"}, {"type": "subtitle", "time": 18707.91, "timestamp": "05:11:47", "text": "比如交互。交互。"}, {"type": "subtitle", "time": 18710.548, "timestamp": "05:11:50", "text": "我明白了吗？可怕，可怕，可怕"}, {"type": "subtitle", "time": 18712.788, "timestamp": "05:11:52", "text": "可怕的。抓住机会。我还是没做到。"}]
[{"type": "subtitle", "time": 10081.11, "timestamp": "02:48:01", "text": "不。"}, {"type": "subtitle", "time": 10083.269, "timestamp": "02:48:03", "text": "好的。所以他就像是《我的世界》的 YouTuber"}, {"type": "subtitle", "time": 10084.87, "timestamp": "02:48:04", "text": "他基本上就是我的全部。"}, {"type": "subtitle", "time": 10087.11, "timestamp": "02:48:07", "text": "童年。我以前经常看他比赛。所以"}, {"type": "subtitle", "time": 10089.51, "timestamp": "02:48:09", "text": "他的全名是丹·钻石"}, {"type": "subtitle", "time": 10093.03, "timestamp": "02:48:13", "text": "矿车，还有你知道的钻石，"}, {"type": "subtitle", "time": 10094.87, "timestamp": "02:48:14", "text": "矿车，所有这些都像"}, {"type": "subtitle", "time": 10096.95, "timestamp": "02:48:16", "text": "我的世界术语。于是我受到了启发"}, {"type": "subtitle", "time": 10098.87, "timestamp": "02:48:18", "text": "那件事，还有我原来的名字是"}, {"type": "subtitle", "time": 10101.349, "timestamp": "02:48:21", "text": "它原本是一个被施了魔法的图腾，但后来却像是一个"}, {"type": "subtitle", "time": 10104.03, "timestamp": "02:48:24", "text": "有点太长了，穿起来不太方便。"}, {"type": "subtitle", "time": 10115.269, "timestamp": "02:48:35", "text": "第二节大家好。欢迎光临。您好。"}, {"type": "subtitle", "time": 10117.269, "timestamp": "02:48:37", "text": "你好。好的。对不起。我妈妈走了进来"}, {"type": "subtitle", "time": 10119.269, "timestamp": "02:48:39", "text": "再次。不用担心。不用担心。不"}, {"type": "subtitle", "time": 10122.389, "timestamp": "02:48:42", "text": "担忧。好的。嗯，是的，就像"}, {"type": "subtitle", "time": 10124.63, "timestamp": "02:48:44", "text": "太长了，但如果我缩短一下，"}, {"type": "subtitle", "time": 10126.55, "timestamp": "02:48:46", "text": "那就像……那样。"}, {"type": "subtitle", "time": 10128.469, "timestamp": "02:48:48", "text": "就像一个很糟糕的名字。所以我就"}, {"type": "subtitle", "time": 10130.87, "timestamp": "02:48:50", "text": "改成只用图腾，但后来"}, {"type": "subtitle", "time": 10133.11, "timestamp": "02:48:53", "text": "图腾不可用。所以我刚刚又加了"}, {"type": "subtitle", "time": 10134.79, "timestamp": "02:48:54", "text": "就像最后顺便提一下。所以就是这样"}]
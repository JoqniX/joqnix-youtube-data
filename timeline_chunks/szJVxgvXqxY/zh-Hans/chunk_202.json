[{"type": "subtitle", "time": 12121.469, "timestamp": "03:22:01", "text": "我们必须包装"}, {"type": "subtitle", "time": 12125.83, "timestamp": "03:22:05", "text": "向上看。嗨。总之，祝大家玩得开心。"}, {"type": "subtitle", "time": 12127.99, "timestamp": "03:22:07", "text": "祝你一切顺利。我会回来的。患病的"}, {"type": "subtitle", "time": 12129.75, "timestamp": "03:22:09", "text": "稍等片刻再来。我去吃点东西"}, {"type": "subtitle", "time": 12131.59, "timestamp": "03:22:11", "text": "做点什么，然后回来。好的。你好。"}, {"type": "subtitle", "time": 12132.83, "timestamp": "03:22:12", "text": "享受。享受。"}, {"type": "subtitle", "time": 12135.91, "timestamp": "03:22:15", "text": "再见。我可能会寻求W，这样我们就可以喜欢"}, {"type": "subtitle", "time": 12137.07, "timestamp": "03:22:17", "text": "手表"}, {"type": "subtitle", "time": 12140.309, "timestamp": "03:22:20", "text": "它。你好。享受。好好欣赏这位老运动员吧。患病的"}, {"type": "subtitle", "time": 12142.149, "timestamp": "03:22:22", "text": "稍后回来。"}, {"type": "subtitle", "time": 12146.469, "timestamp": "03:22:26", "text": "让我先把这些NDI相关的问题解决一下。"}, {"type": "subtitle", "time": 12150.55, "timestamp": "03:22:30", "text": "我可以展示一下，我可以……你知道的"}, {"type": "subtitle", "time": 12157.83, "timestamp": "03:22:37", "text": "出去。我的天哪，它不起作用。哦，我的"}, {"type": "subtitle", "time": 12166.189, "timestamp": "03:22:46", "text": "[音乐]"}, {"type": "subtitle", "time": 12169.429, "timestamp": "03:22:49", "text": "Odet硬件加速"}, {"type": "subtitle", "time": 12171.349, "timestamp": "03:22:51", "text": "这。"}, {"type": "subtitle", "time": 12173.79, "timestamp": "03:22:53", "text": "它不起作用。我的天哪，这不是"}]
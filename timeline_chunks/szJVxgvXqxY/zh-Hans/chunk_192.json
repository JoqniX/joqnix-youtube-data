[{"type": "subtitle", "time": 11520.87, "timestamp": "03:12:00", "text": "6月10日，我会得到他们会得到的"}, {"type": "subtitle", "time": 11524.469, "timestamp": "03:12:04", "text": "已拿到COE。"}, {"type": "subtitle", "time": 11525.99, "timestamp": "03:12:05", "text": "重新装弹。"}, {"type": "subtitle", "time": 11530.03, "timestamp": "03:12:10", "text": "CO就像是……的证书"}, {"type": "subtitle", "time": 11533.67, "timestamp": "03:12:13", "text": "从学院入学。不。"}, {"type": "subtitle", "time": 11536.469, "timestamp": "03:12:16", "text": "哦，来自日本。"}, {"type": "subtitle", "time": 11538.389, "timestamp": "03:12:18", "text": "你是去那里学习吗？"}, {"type": "subtitle", "time": 11540.71, "timestamp": "03:12:20", "text": "学习？对，学习。你要去哪儿？"}, {"type": "subtitle", "time": 11542.63, "timestamp": "03:12:22", "text": "学习？比如什么？我将学习"}, {"type": "subtitle", "time": 11545.99, "timestamp": "03:12:25", "text": "当时的日本人。是的，这是第一学年"}, {"type": "subtitle", "time": 11547.99, "timestamp": "03:12:27", "text": "学习这门语言。学习之后"}, {"type": "subtitle", "time": 11549.99, "timestamp": "03:12:29", "text": "只有掌握了这门语言，我才能申请。"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "工作之类的，对吧？因为你需要喜欢"}, {"type": "subtitle", "time": 11555.189, "timestamp": "03:12:35", "text": "流利程度"}, {"type": "subtitle", "time": 11557.83, "timestamp": "03:12:37", "text": "一切都对吧？我需要得到"}, {"type": "subtitle", "time": 11561.07, "timestamp": "03:12:41", "text": "最低 N2 水平"}, {"type": "subtitle", "time": 11563.15, "timestamp": "03:12:43", "text": "到"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "兄弟，我刚才被骗得太惨了。总之，"}, {"type": "subtitle", "time": 11571.03, "timestamp": "03:12:51", "text": "继续。是的，我需要N2级才能达到"}, {"type": "subtitle", "time": 11574.469, "timestamp": "03:12:54", "text": "至少"}]
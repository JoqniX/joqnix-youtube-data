[{"type": "subtitle", "time": 7620.07, "timestamp": "02:07:00", "text": "哦，他们没有，他们没有帮忙。"}, {"type": "subtitle", "time": 7630.79, "timestamp": "02:07:10", "text": "不是。我的天啊。"}, {"type": "subtitle", "time": 7634.309, "timestamp": "02:07:14", "text": "如何获得暴击？"}, {"type": "subtitle", "time": 7637.11, "timestamp": "02:07:17", "text": "我觉得我们今天没吃到东西。"}, {"type": "subtitle", "time": 7643.11, "timestamp": "02:07:23", "text": "糟糕。坚持，稍等。我在吃饭。你可能"}, {"type": "subtitle", "time": 7644.71, "timestamp": "02:07:24", "text": "想逃走一会儿，直到我"}, {"type": "subtitle", "time": 7650.87, "timestamp": "02:07:30", "text": "好的。"}, {"type": "subtitle", "time": 7654.15, "timestamp": "02:07:34", "text": "我的生命值很低。"}, {"type": "subtitle", "time": 7656.79, "timestamp": "02:07:36", "text": "别死。别死。别死。吃"}, {"type": "subtitle", "time": 7657.75, "timestamp": "02:07:37", "text": "食物。吃东西。快的。快的。快的。"}, {"type": "subtitle", "time": 7659.59, "timestamp": "02:07:39", "text": "快的。快的。快的。快的。快的。我愿意"}, {"type": "subtitle", "time": 7662.469, "timestamp": "02:07:42", "text": "没有食物。哦，不。"}, {"type": "subtitle", "time": 7664.87, "timestamp": "02:07:44", "text": "嗯，就试着弄些苹果之类的东西吧。"}, {"type": "subtitle", "time": 7666.07, "timestamp": "02:07:46", "text": "某物。可能有一些"}, {"type": "subtitle", "time": 7669.15, "timestamp": "02:07:49", "text": "如果你喜欢砍伐的话，可以清点库存。"}, {"type": "subtitle", "time": 7671.63, "timestamp": "02:07:51", "text": "木头。"}]
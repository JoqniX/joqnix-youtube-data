[{"type": "subtitle", "time": 8162.95, "timestamp": "02:16:02", "text": "现在正在生成吗？什么？什么？如何？"}, {"type": "subtitle", "time": 8167.349, "timestamp": "02:16:07", "text": "它们现在还不应该生成。我的天啊。"}, {"type": "subtitle", "time": 8190.15, "timestamp": "02:16:30", "text": "我们仍然不知道如何制作"}, {"type": "subtitle", "time": 8208.389, "timestamp": "02:16:48", "text": "哦，他们打败我了。我的天啊。我"}, {"type": "subtitle", "time": 8209.51, "timestamp": "02:16:49", "text": "什么也没做。我没做"}, {"type": "subtitle", "time": 8211.19, "timestamp": "02:16:51", "text": "任何事物。哦，他们打我了。好的，"}, {"type": "subtitle", "time": 8213.19, "timestamp": "02:16:53", "text": "我们需要逃跑。"}]
[{"type": "subtitle", "time": 6481.75, "timestamp": "01:48:01", "text": "岩石。我的天哪，我连一半都掰不开"}, {"type": "subtitle", "time": 6489.83, "timestamp": "01:48:09", "text": "没有耐用性是件好事。"}, {"type": "subtitle", "time": 6492.95, "timestamp": "01:48:12", "text": "武器。是的。"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "对了，现在快到晚上了。"}, {"type": "subtitle", "time": 6501.91, "timestamp": "01:48:21", "text": "哦，是的。是的。我们应该建造一个"}, {"type": "subtitle", "time": 6504.63, "timestamp": "01:48:24", "text": "有木头的房子？是的，我也这么认为。"}, {"type": "subtitle", "time": 6506.55, "timestamp": "01:48:26", "text": "但我没有多少木材。我有点"}, {"type": "subtitle", "time": 6509.349, "timestamp": "01:48:29", "text": "比如全部用来制作一把斧头和一个"}, {"type": "subtitle", "time": 6511.51, "timestamp": "01:48:31", "text": "工作台。"}, {"type": "subtitle", "time": 6513.15, "timestamp": "01:48:33", "text": "好的。呃，让我"}, {"type": "subtitle", "time": 6516.55, "timestamp": "01:48:36", "text": "看。所以我们需要木材。呃，我有31个。"}, {"type": "subtitle", "time": 6518.91, "timestamp": "01:48:38", "text": "我们可以制造"}, {"type": "subtitle", "time": 6527.63, "timestamp": "01:48:47", "text": "墙。呃，你想放在哪里？"}, {"type": "subtitle", "time": 6531.95, "timestamp": "01:48:51", "text": "它？哦，已经有东西在生成了。"}, {"type": "subtitle", "time": 6535.429, "timestamp": "01:48:55", "text": "嗯，就把它放在我们附近吧。"}]
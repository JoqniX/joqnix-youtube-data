[{"type": "subtitle", "time": 2223.55, "timestamp": "00:37:03", "text": "正确的。我不知道哪里"}, {"type": "subtitle", "time": 2230.47, "timestamp": "00:37:10", "text": "热滴。"}, {"type": "subtitle", "time": 2232.55, "timestamp": "00:37:12", "text": "什么滴？在哪里？你知道那"}, {"type": "subtitle", "time": 2235.91, "timestamp": "00:37:15", "text": "热点地区。哦，是的。是的。那"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "战利品不错吧？我觉得会显示出来"}, {"type": "subtitle", "time": 2240.75, "timestamp": "00:37:20", "text": "在我们……的时候"}, {"type": "subtitle", "time": 2244.47, "timestamp": "00:37:24", "text": "登陆。你现在被驱逐出场。"}, {"type": "subtitle", "time": 2246.95, "timestamp": "00:37:26", "text": "哦，那里有人。"}, {"type": "subtitle", "time": 2254.189, "timestamp": "00:37:34", "text": "那里。好的，我们可以走了"}, {"type": "subtitle", "time": 2256.95, "timestamp": "00:37:36", "text": "这里。冲锋枪。"}, {"type": "subtitle", "time": 2276.629, "timestamp": "00:37:56", "text": "[音乐]"}, {"type": "subtitle", "time": 2279.03, "timestamp": "00:37:59", "text": "我们已经准备好了，我们要去搜刮物资，做好准备。"}]
[{"type": "subtitle", "time": 4561.95, "timestamp": "01:16:01", "text": "啊，我为什么要这么做？"}, {"type": "subtitle", "time": 4574.109, "timestamp": "01:16:14", "text": "霰弹枪。"}, {"type": "subtitle", "time": 4578.03, "timestamp": "01:16:18", "text": "呃，霰弹枪子弹在哪儿？"}, {"type": "subtitle", "time": 4580.229, "timestamp": "01:16:20", "text": "霰弹枪。这是哪一个？霰弹枪"}, {"type": "subtitle", "time": 4582.99, "timestamp": "01:16:22", "text": "又有弹药了。呃，霰弹枪看起来像……"}, {"type": "subtitle", "time": 4586.629, "timestamp": "01:16:26", "text": "像这样的棕色。没错，没错。这里。这里"}, {"type": "subtitle", "time": 4593.23, "timestamp": "01:16:33", "text": "几乎没有"}, {"type": "subtitle", "time": 4597.99, "timestamp": "01:16:37", "text": "螃蟹。哇。太可爱了。"}, {"type": "subtitle", "time": 4600.389, "timestamp": "01:16:40", "text": "蟹黄，"}, {"type": "subtitle", "time": 4605.589, "timestamp": "01:16:45", "text": "我们需要向左走。是的。"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "这是做什么用的？"}, {"type": "subtitle", "time": 4611.11, "timestamp": "01:16:51", "text": "哦。哦，我想就是它给你的"}, {"type": "subtitle", "time": 4614.07, "timestamp": "01:16:54", "text": "移动速度之类的。哦，是你吗？"}, {"type": "subtitle", "time": 4615.66, "timestamp": "01:16:55", "text": "进行升级"}]
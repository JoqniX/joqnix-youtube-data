[{"type": "subtitle", "time": 11640.07, "timestamp": "03:14:00", "text": "四月份的话，时间就足够了。"}, {"type": "subtitle", "time": 11643.269, "timestamp": "03:14:03", "text": "实际上，我并不需要一个非常……我的意思是……"}, {"type": "subtitle", "time": 11645.99, "timestamp": "03:14:05", "text": "我不介意这一年"}, {"type": "subtitle", "time": 11649.75, "timestamp": "03:14:09", "text": "乔森喜欢这样。我的天啊。"}, {"type": "subtitle", "time": 11652.95, "timestamp": "03:14:12", "text": "我知道。为什么我的家人现在打电话给我？"}, {"type": "subtitle", "time": 11656.389, "timestamp": "03:14:16", "text": "今天大家都怎么了？好的。一"}, {"type": "subtitle", "time": 11658.149, "timestamp": "03:14:18", "text": "第二。"}, {"type": "subtitle", "time": 11663.67, "timestamp": "03:14:23", "text": "你好，娜特。只有你和我"}, {"type": "subtitle", "time": 11672.389, "timestamp": "03:14:32", "text": "玩笑结束了。你死定了。是的，兄弟。为什么"}, {"type": "subtitle", "time": 11674.189, "timestamp": "03:14:34", "text": "他们要去吗？"}, {"type": "subtitle", "time": 11676.95, "timestamp": "03:14:36", "text": "走吗？"}, {"type": "subtitle", "time": 11689.91, "timestamp": "03:14:49", "text": "把那些东西还给我。"}, {"type": "subtitle", "time": 11692.71, "timestamp": "03:14:52", "text": "已种下穗。"}, {"type": "subtitle", "time": 11694.69, "timestamp": "03:14:54", "text": "还剩一个敌人。"}, {"type": "subtitle", "time": 11696.87, "timestamp": "03:14:56", "text": "[掌声]"}, {"type": "subtitle", "time": 11699.67, "timestamp": "03:14:59", "text": "哦。"}]
[{"type": "subtitle", "time": 10863.03, "timestamp": "03:01:03", "text": "现在有人在给我打电话，因为"}, {"type": "subtitle", "time": 10865.67, "timestamp": "03:01:05", "text": "明天好像有个聚会。"}, {"type": "subtitle", "time": 10867.309, "timestamp": "03:01:07", "text": "学院。每一个"}, {"type": "subtitle", "time": 10869.99, "timestamp": "03:01:09", "text": "同学好像真的在给我打电话"}, {"type": "subtitle", "time": 10872.87, "timestamp": "03:01:12", "text": "比如，“兄弟，为什么我是副总裁/VIP？”"}, {"type": "subtitle", "time": 10878.309, "timestamp": "03:01:18", "text": "大家都喜欢跟你说话，你"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "哦。哦。我们怎么会输呢？"}, {"type": "subtitle", "time": 10904.309, "timestamp": "03:01:44", "text": "这就像是4打5，兄弟。如果它不是"}, {"type": "subtitle", "time": 10907.349, "timestamp": "03:01:47", "text": "我觉得我们4对5的时候本来可以赢的。"}, {"type": "subtitle", "time": 10913.11, "timestamp": "03:01:53", "text": "我的天啊。玩笑结束了。你死定了。"}, {"type": "subtitle", "time": 10915.67, "timestamp": "03:01:55", "text": "什么？"}, {"type": "subtitle", "time": 10918.55, "timestamp": "03:01:58", "text": "好吧，我们被重生点杀得很惨。"}]
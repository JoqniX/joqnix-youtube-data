[{"type": "subtitle", "time": 11367.91, "timestamp": "03:09:27", "text": "重新装弹。"}, {"type": "subtitle", "time": 11378.63, "timestamp": "03:09:38", "text": "玩笑结束了。你死定了。"}, {"type": "subtitle", "time": 11381.11, "timestamp": "03:09:41", "text": "我还在触摸。妈的，兄弟。有利于"}, {"type": "subtitle", "time": 11383.269, "timestamp": "03:09:43", "text": "你，伙计。我现在玩这个游戏很菜。我是"}, {"type": "subtitle", "time": 11389.51, "timestamp": "03:09:49", "text": "洗干净了。"}, {"type": "subtitle", "time": 11397.51, "timestamp": "03:09:57", "text": "敌方侦察兵。"}]
[{"type": "subtitle", "time": 14582.07, "timestamp": "04:03:02", "text": "贸易路线和公司，当然还有"}, {"type": "subtitle", "time": 14584.07, "timestamp": "04:03:04", "text": "圣地区域及其建筑。"}, {"type": "subtitle", "time": 14588.47, "timestamp": "04:03:08", "text": "查阅民用百科全书以查找"}, {"type": "subtitle", "time": 14592.51, "timestamp": "04:03:12", "text": "等等，这是什么？"}, {"type": "subtitle", "time": 14595.67, "timestamp": "04:03:15", "text": "民用医学是什么？民用医学是什么？"}, {"type": "subtitle", "time": 14602.03, "timestamp": "04:03:22", "text": "呃，怎么做"}, {"type": "subtitle", "time": 14606.09, "timestamp": "04:03:26", "text": "我该如何管理公民"}, {"type": "subtitle", "time": 14608.75, "timestamp": "04:03:28", "text": "[音乐]"}, {"type": "subtitle", "time": 14613.75, "timestamp": "04:03:33", "text": "呃，我该如何控制这个？我该怎么做？"}, {"type": "subtitle", "time": 14616.788, "timestamp": "04:03:36", "text": "耕耘和喜欢建造更多房屋"}, {"type": "subtitle", "time": 14620.708, "timestamp": "04:03:40", "text": "为了我的族人，为了这件事。哦，单位"}, {"type": "subtitle", "time": 14623.19, "timestamp": "04:03:43", "text": "需要订单。好的，等等。我来了"}, {"type": "subtitle", "time": 14625.47, "timestamp": "04:03:45", "text": "现在轮到你了。走，走，"}, {"type": "subtitle", "time": 14630.55, "timestamp": "04:03:50", "text": "去。为什么？你为什么停下来了？为什么？"}, {"type": "subtitle", "time": 14634.23, "timestamp": "04:03:54", "text": "啊，巴卡。好了，他走了。当你"}, {"type": "subtitle", "time": 14636.708, "timestamp": "04:03:56", "text": "找到矿场，我们走吧。别再挖了。"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "当你发现自己陷入困境时，就退出。"}]
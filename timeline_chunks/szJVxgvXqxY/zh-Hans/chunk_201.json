[{"type": "subtitle", "time": 12060.11, "timestamp": "03:21:00", "text": "有点忘了"}, {"type": "subtitle", "time": 12063.389, "timestamp": "03:21:03", "text": "忘了带一些东西。所以"}, {"type": "subtitle", "time": 12067.91, "timestamp": "03:21:07", "text": "是的。嗯，你好。下一位嘉宾是乔布斯特"}, {"type": "subtitle", "time": 12070.469, "timestamp": "03:21:10", "text": "边。时间是下午6点。 IST。所以"}, {"type": "subtitle", "time": 12073.67, "timestamp": "03:21:13", "text": "我有一个小时的时间来调整自己。"}, {"type": "subtitle", "time": 12076.71, "timestamp": "03:21:16", "text": "比如放松一下之类的。那我走了"}, {"type": "subtitle", "time": 12079.75, "timestamp": "03:21:19", "text": "休息一下，让我完成……"}, {"type": "subtitle", "time": 12081.429, "timestamp": "03:21:21", "text": "打破常规，像吃东西一样吃东西"}, {"type": "subtitle", "time": 12084.389, "timestamp": "03:21:24", "text": "一切。另外，我还需要给一些人打电话。"}, {"type": "subtitle", "time": 12086.469, "timestamp": "03:21:26", "text": "人们会问发生了什么事，因为"}, {"type": "subtitle", "time": 12088.99, "timestamp": "03:21:28", "text": "明天要做的事"}, {"type": "subtitle", "time": 12092.95, "timestamp": "03:21:32", "text": "担心。我很高兴，就像……"}, {"type": "subtitle", "time": 12096.03, "timestamp": "03:21:36", "text": "这样看就像这样"}, {"type": "subtitle", "time": 12102.75, "timestamp": "03:21:42", "text": "如果我六月份去不了的话"}, {"type": "subtitle", "time": 12105.83, "timestamp": "03:21:45", "text": "7月，Jockathon还将有更多精彩内容。"}, {"type": "subtitle", "time": 12107.99, "timestamp": "03:21:47", "text": "整整一年。别担心，我会的。"}, {"type": "subtitle", "time": 12111.11, "timestamp": "03:21:51", "text": "那。我不介意参加 Jockathon 比赛"}, {"type": "subtitle", "time": 12113.389, "timestamp": "03:21:53", "text": "全年如此。"}, {"type": "subtitle", "time": 12118.87, "timestamp": "03:21:58", "text": "嗯，如果不行，我会的。是的，如果不行的话"}]
[{"type": "subtitle", "time": 13206.27, "timestamp": "03:40:06", "text": "去。迫不及待想知道事情会如何发展。"}, {"type": "subtitle", "time": 13208.35, "timestamp": "03:40:08", "text": "继续。哦"}, {"type": "subtitle", "time": 13210.51, "timestamp": "03:40:10", "text": "男生。哦"}, {"type": "subtitle", "time": 13215.19, "timestamp": "03:40:15", "text": "男生。好的，我全部同意。所以，呃，我的确如此。"}, {"type": "subtitle", "time": 13217.23, "timestamp": "03:40:17", "text": "不知道多人游戏是什么"}, {"type": "subtitle", "time": 13220.47, "timestamp": "03:40:20", "text": "是。通过云互联网网络进行游戏"}, {"type": "subtitle", "time": 13223.11, "timestamp": "03:40:23", "text": "可以设置好，哦，这样其他人就可以"}, {"type": "subtitle", "time": 13225.51, "timestamp": "03:40:25", "text": "加入我。"}, {"type": "subtitle", "time": 13227.75, "timestamp": "03:40:27", "text": "玩多人游戏。播放"}, {"type": "subtitle", "time": 13230.19, "timestamp": "03:40:30", "text": "[音乐]"}, {"type": "subtitle", "time": 13233.83, "timestamp": "03:40:33", "text": "云。这是一场大逃杀。什么？"}, {"type": "subtitle", "time": 13236.59, "timestamp": "03:40:36", "text": "有一款海盗游戏。"}, {"type": "subtitle", "time": 13239.868, "timestamp": "03:40:39", "text": "什么？你知道吗？我更喜欢"}, {"type": "subtitle", "time": 13244.27, "timestamp": "03:40:44", "text": "单人游戏。等等，我没有"}, {"type": "subtitle", "time": 13245.788, "timestamp": "03:40:45", "text": "知道。"}, {"type": "subtitle", "time": 13249.75, "timestamp": "03:40:49", "text": "嗯，世界构建者。好的，我们走吧……"}, {"type": "subtitle", "time": 13257.03, "timestamp": "03:40:57", "text": "[音乐]"}]
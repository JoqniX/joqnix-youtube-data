[{"type": "subtitle", "time": 11580.149, "timestamp": "03:13:00", "text": "还剩一个敌人。申请这份工作。呃"}, {"type": "subtitle", "time": 11588.229, "timestamp": "03:13:08", "text": "啊，我走了。"}, {"type": "subtitle", "time": 11590.309, "timestamp": "03:13:10", "text": "那真是令人兴奋。又一个月过去了"}, {"type": "subtitle", "time": 11594.71, "timestamp": "03:13:14", "text": "乔森，兄弟。啊，Jakad 将会是"}, {"type": "subtitle", "time": 11601.59, "timestamp": "03:13:21", "text": "你看到了吗？"}, {"type": "subtitle", "time": 11604.149, "timestamp": "03:13:24", "text": "我的天啊。你还活着。"}, {"type": "subtitle", "time": 11606.87, "timestamp": "03:13:26", "text": "那可真是件了不起的事。"}, {"type": "subtitle", "time": 11611.149, "timestamp": "03:13:31", "text": "发生了什么？何树倒了"}, {"type": "subtitle", "time": 11613.91, "timestamp": "03:13:33", "text": "离开。他一边看着一边跳了下去。"}, {"type": "subtitle", "time": 11616.149, "timestamp": "03:13:36", "text": "侧身。他当时正在尝试刷灵气，"}, {"type": "subtitle", "time": 11619.11, "timestamp": "03:13:39", "text": "但他只是"}, {"type": "subtitle", "time": 11621.11, "timestamp": "03:13:41", "text": "谢谢。他当时就是那样做的"}, {"type": "subtitle", "time": 11625.269, "timestamp": "03:13:45", "text": "他当时很兴奋，但突然就摔倒了。"}, {"type": "subtitle", "time": 11627.83, "timestamp": "03:13:47", "text": "我的天啊。"}, {"type": "subtitle", "time": 11630.229, "timestamp": "03:13:50", "text": "说实话，兄弟，我真不知道你是怎么做到的。"}, {"type": "subtitle", "time": 11632.07, "timestamp": "03:13:52", "text": "我好像永远都无法为此进行直播了。"}, {"type": "subtitle", "time": 11634.55, "timestamp": "03:13:54", "text": "长的。"}, {"type": "subtitle", "time": 11637.67, "timestamp": "03:13:57", "text": "如果是下一个，我倒也不介意。"}]
[{"type": "subtitle", "time": 18723.75, "timestamp": "05:12:03", "text": "牺牲。我的天啊。为什么会这样？"}, {"type": "subtitle", "time": 18735.43, "timestamp": "05:12:15", "text": "哦，糟糕。"}, {"type": "subtitle", "time": 18746.708, "timestamp": "05:12:26", "text": "哦，到底打不打？拥有或有"}, {"type": "subtitle", "time": 18748.23, "timestamp": "05:12:28", "text": "在哪里？"}, {"type": "subtitle", "time": 18751.03, "timestamp": "05:12:31", "text": "在地板上。在地板上。"}, {"type": "subtitle", "time": 18753.51, "timestamp": "05:12:33", "text": "水。好的。"}, {"type": "subtitle", "time": 18755.99, "timestamp": "05:12:35", "text": "不，不，不。它像鬼魂吗？"}, {"type": "subtitle", "time": 18759.03, "timestamp": "05:12:39", "text": "代笔？哦，不。做出头部。"}, {"type": "subtitle", "time": 18761.43, "timestamp": "05:12:41", "text": "那里没有鬼。好的。出去。得到"}, {"type": "subtitle", "time": 18772.23, "timestamp": "05:12:52", "text": "[音乐]"}, {"type": "subtitle", "time": 18775.83, "timestamp": "05:12:55", "text": "鬼魂。你看到了吗？是的。你看？"}, {"type": "subtitle", "time": 18779.11, "timestamp": "05:12:59", "text": "你想看看幽灵行动吗？"}]
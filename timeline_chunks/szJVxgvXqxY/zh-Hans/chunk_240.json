[{"type": "subtitle", "time": 14402.39, "timestamp": "04:00:02", "text": "正常水平的25%。一座城市可以"}, {"type": "subtitle", "time": 14405.67, "timestamp": "04:00:05", "text": "最多可容纳五名公民"}, {"type": "subtitle", "time": 14408.31, "timestamp": "04:00:08", "text": "住房限额。照这个速度，它将"}, {"type": "subtitle", "time": 14410.03, "timestamp": "04:00:10", "text": "然后停止生长"}, {"type": "subtitle", "time": 14412.948, "timestamp": "04:00:12", "text": "完全。一座城市将会停滞不前，而不是"}, {"type": "subtitle", "time": 14415.91, "timestamp": "04:00:15", "text": "如果没有剩余，就不要增长。"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "呃，食物。如果它成功，它就会成功"}, {"type": "subtitle", "time": 14420.47, "timestamp": "04:00:20", "text": "那时食物就更少了。好的。有点明白了。"}, {"type": "subtitle", "time": 14423.19, "timestamp": "04:00:23", "text": "不太明白。我的天啊。而这"}, {"type": "subtitle", "time": 14426.47, "timestamp": "04:00:26", "text": "是二级。这里有两个人。不。"}, {"type": "subtitle", "time": 14428.03, "timestamp": "04:00:28", "text": "多少"}, {"type": "subtitle", "time": 14431.39, "timestamp": "04:00:31", "text": "公民？好的。我不知道。"}, {"type": "subtitle", "time": 14434.75, "timestamp": "04:00:34", "text": "H. Hutch是谁？"}, {"type": "subtitle", "time": 14446.07, "timestamp": "04:00:46", "text": "下一轮。"}, {"type": "subtitle", "time": 14448.07, "timestamp": "04:00:48", "text": "这是我们的一些新政策。"}, {"type": "subtitle", "time": 14449.59, "timestamp": "04:00:49", "text": "政府可以升级。有一个"}, {"type": "subtitle", "time": 14451.67, "timestamp": "04:00:51", "text": "政府政策。人们期待着"}, {"type": "subtitle", "time": 14454.15, "timestamp": "04:00:54", "text": "你的法令。"}, {"type": "subtitle", "time": 14456.708, "timestamp": "04:00:56", "text": "政策，嗯，好的。我需要，我需要"}, {"type": "subtitle", "time": 14458.628, "timestamp": "04:00:58", "text": "提高城市产量"}]
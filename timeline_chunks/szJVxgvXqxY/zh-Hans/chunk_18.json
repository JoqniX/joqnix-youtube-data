[{"type": "subtitle", "time": 1081.189, "timestamp": "00:18:01", "text": "是的。然后，然后我觉得我"}, {"type": "subtitle", "time": 1084.149, "timestamp": "00:18:04", "text": "我玩游戏会感到内疚吗？"}, {"type": "subtitle", "time": 1087.11, "timestamp": "00:18:07", "text": "我知道，因为我觉得我还有事要做。"}, {"type": "subtitle", "time": 1090.47, "timestamp": "00:18:10", "text": "为了我的大学，但我同时也想玩。"}, {"type": "subtitle", "time": 1093.75, "timestamp": "00:18:13", "text": "游戏。所以，我一直在想我能做什么"}, {"type": "subtitle", "time": 1097.47, "timestamp": "00:18:17", "text": "这样做是为了增加玩游戏的乐趣"}, {"type": "subtitle", "time": 1106.03, "timestamp": "00:18:26", "text": "那真不错。"}, {"type": "subtitle", "time": 1109.03, "timestamp": "00:18:29", "text": "呃，你还玩我的世界（Minecraft）之类的游戏。我"}, {"type": "subtitle", "time": 1111.75, "timestamp": "00:18:31", "text": "注意到是你玩Minecraft"}, {"type": "subtitle", "time": 1114.709, "timestamp": "00:18:34", "text": "佣金，对吧？哇。是的。是的。"}, {"type": "subtitle", "time": 1117.83, "timestamp": "00:18:37", "text": "是的。是的。我做了。如何？如何？你怎么做？"}, {"type": "subtitle", "time": 1120.87, "timestamp": "00:18:40", "text": "那些东西？太难了。我做不到"}, {"type": "subtitle", "time": 1122.95, "timestamp": "00:18:42", "text": "我自己的皮肤或其他任何东西。太难了。"}, {"type": "subtitle", "time": 1125.669, "timestamp": "00:18:45", "text": "你是怎么做到的？"}, {"type": "subtitle", "time": 1129.59, "timestamp": "00:18:49", "text": "呃，我还有另一个Fuber朋友。我 我"}, {"type": "subtitle", "time": 1134.07, "timestamp": "00:18:54", "text": "看到他制作了这个 Minecraft 皮肤"}, {"type": "subtitle", "time": 1136.709, "timestamp": "00:18:56", "text": "佣金流之类的东西。我当时就像……"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "我问他：“哦，你是怎么做到的？”和"}]
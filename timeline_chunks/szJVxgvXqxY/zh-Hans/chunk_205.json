[{"type": "subtitle", "time": 12300.67, "timestamp": "03:25:00", "text": "好的，"}, {"type": "subtitle", "time": 12304.07, "timestamp": "03:25:04", "text": "好的。这样应该就没问题了。随时都可以。"}, {"type": "subtitle", "time": 12305.309, "timestamp": "03:25:05", "text": "好的，好的。"}, {"type": "subtitle", "time": 12309.03, "timestamp": "03:25:09", "text": "好的。呃，你能给我一些那个吗？"}, {"type": "subtitle", "time": 12312.07, "timestamp": "03:25:12", "text": "隔离期间通过 YouTube 消磨时间？我的穹顶"}, {"type": "subtitle", "time": 12314.75, "timestamp": "03:25:14", "text": "感觉就像身处地狱之火。哦，我的"}, {"type": "subtitle", "time": 12318.389, "timestamp": "03:25:18", "text": "上帝。好的，再见。等等，你正生活在一个"}, {"type": "subtitle", "time": 12320.83, "timestamp": "03:25:20", "text": "等等，你住在一个"}, {"type": "subtitle", "time": 12324.11, "timestamp": "03:25:24", "text": "圆顶。哇。如何"}, {"type": "subtitle", "time": 12333.75, "timestamp": "03:25:33", "text": "圆顶？除了天气以外，其他因素也很重要。"}, {"type": "subtitle", "time": 12337.149, "timestamp": "03:25:37", "text": "诸如“这怎么可能”之类的问题"}, {"type": "subtitle", "time": 12340.469, "timestamp": "03:25:40", "text": "事物？我可能有一天会不得不这么做。"}, {"type": "subtitle", "time": 12343.03, "timestamp": "03:25:43", "text": "搬到宿舍去住。我不知道。我是否"}, {"type": "subtitle", "time": 12345.149, "timestamp": "03:25:45", "text": "吃"}, {"type": "subtitle", "time": 12354.87, "timestamp": "03:25:54", "text": "今天我们要做的，呃，我们是什么？"}, {"type": "subtitle", "time": 12359.149, "timestamp": "03:25:59", "text": "再来一次？我们将进行席德·梅耶斯（Sid Mayers）的演出"}]
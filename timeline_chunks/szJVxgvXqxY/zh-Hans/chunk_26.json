[{"type": "subtitle", "time": 1562.47, "timestamp": "00:26:02", "text": "东西。哦，不。哦。哦，不。好的。我是"}, {"type": "subtitle", "time": 1563.669, "timestamp": "00:26:03", "text": "未来。我来了。我来了。我是"}, {"type": "subtitle", "time": 1568.75, "timestamp": "00:26:08", "text": "抓到他了。抓到他了。我要去"}, {"type": "subtitle", "time": 1570.35, "timestamp": "00:26:10", "text": "到"}, {"type": "subtitle", "time": 1573.91, "timestamp": "00:26:13", "text": "呃，我在这里唤醒你。"}, {"type": "subtitle", "time": 1575.39, "timestamp": "00:26:15", "text": "我将会"}, {"type": "subtitle", "time": 1586.55, "timestamp": "00:26:26", "text": "不，我没拿到枪。"}, {"type": "subtitle", "time": 1589.31, "timestamp": "00:26:29", "text": "不。你好。我们开始吧"}, {"type": "subtitle", "time": 1592.55, "timestamp": "00:26:32", "text": "再来一次。哦。那么，你如何掠夺？"}, {"type": "subtitle", "time": 1596.87, "timestamp": "00:26:36", "text": "再次？呃，按 E 键可以搜刮战利品。哦，"}, {"type": "subtitle", "time": 1599.83, "timestamp": "00:26:39", "text": "好的。"}, {"type": "subtitle", "time": 1601.149, "timestamp": "00:26:41", "text": "按 E 键"}, {"type": "subtitle", "time": 1603.669, "timestamp": "00:26:43", "text": "抢劫。和"}, {"type": "subtitle", "time": 1606.229, "timestamp": "00:26:46", "text": "这里有辆车。"}, {"type": "subtitle", "time": 1610.55, "timestamp": "00:26:50", "text": "嗯哼。他可以继续前进。是的。 E 跳跃"}, {"type": "subtitle", "time": 1613.189, "timestamp": "00:26:53", "text": "空间。"}]
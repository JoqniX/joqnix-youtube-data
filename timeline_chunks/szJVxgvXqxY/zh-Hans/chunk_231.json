[{"type": "subtitle", "time": 13860.91, "timestamp": "03:51:00", "text": "我该怎么做"}, {"type": "subtitle", "time": 13863.83, "timestamp": "03:51:03", "text": "人们？这就是我的问题。由……"}, {"type": "subtitle", "time": 13875.868, "timestamp": "03:51:15", "text": "公民。"}, {"type": "subtitle", "time": 13879.67, "timestamp": "03:51:19", "text": "呃，我也需要黄金。我该如何制作"}, {"type": "subtitle", "time": 13893.628, "timestamp": "03:51:33", "text": "糟糕。他会……"}, {"type": "subtitle", "time": 13897.39, "timestamp": "03:51:37", "text": "杀？他要杀人吗？"}, {"type": "subtitle", "time": 13906.708, "timestamp": "03:51:46", "text": "去？等等，你说的“其他”是什么意思？"}, {"type": "subtitle", "time": 13909.11, "timestamp": "03:51:49", "text": "人们轮流进行吗？有没有"}, {"type": "subtitle", "time": 13911.91, "timestamp": "03:51:51", "text": "像世界上其他人一样吗？我"}, {"type": "subtitle", "time": 13913.23, "timestamp": "03:51:53", "text": "以为只是"}, {"type": "subtitle", "time": 13916.708, "timestamp": "03:51:56", "text": "主啊，我。就像吉尔伽美什王一样。那是"}]
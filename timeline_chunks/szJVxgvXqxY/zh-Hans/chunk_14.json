[{"type": "subtitle", "time": 842.63, "timestamp": "00:14:02", "text": "我很紧张。"}, {"type": "subtitle", "time": 845.27, "timestamp": "00:14:05", "text": "非常荣幸能邀请您参加。"}, {"type": "subtitle", "time": 847.59, "timestamp": "00:14:07", "text": "溪流。"}, {"type": "subtitle", "time": 852.03, "timestamp": "00:14:12", "text": "谢谢。我也是。"}, {"type": "subtitle", "time": 856.07, "timestamp": "00:14:16", "text": "是的。这是我们第一次互动"}, {"type": "subtitle", "time": 858.709, "timestamp": "00:14:18", "text": "很久很久，对吧？"}, {"type": "subtitle", "time": 861.11, "timestamp": "00:14:21", "text": "是的。"}, {"type": "subtitle", "time": 862.27, "timestamp": "00:14:22", "text": "哦，我的"}, {"type": "subtitle", "time": 865.91, "timestamp": "00:14:25", "text": "上帝。说实话，呃，在寻找"}, {"type": "subtitle", "time": 869.59, "timestamp": "00:14:29", "text": "像现在这样邀请别人吧，我当时是"}, {"type": "subtitle", "time": 871.99, "timestamp": "00:14:31", "text": "查看我的私信和好友列表"}, {"type": "subtitle", "time": 874.31, "timestamp": "00:14:34", "text": "对于我可能与之交谈过的人来说"}, {"type": "subtitle", "time": 875.99, "timestamp": "00:14:35", "text": "东西，然后我看到了你。我当时就想，“哦”"}, {"type": "subtitle", "time": 879.35, "timestamp": "00:14:39", "text": "是的，我记得阿佐拉。我们谈到了"}, {"type": "subtitle", "time": 881.91, "timestamp": "00:14:41", "text": "音乐之类的，我想我遇见了你。"}, {"type": "subtitle", "time": 885.83, "timestamp": "00:14:45", "text": "来自 DSG 之类的。我记得很久以前"}, {"type": "subtitle", "time": 888.39, "timestamp": "00:14:48", "text": "后退。”"}, {"type": "subtitle", "time": 890.47, "timestamp": "00:14:50", "text": "是的。你问的是如何制作"}, {"type": "subtitle", "time": 892.95, "timestamp": "00:14:52", "text": "封面之类的东西。"}, {"type": "subtitle", "time": 895.75, "timestamp": "00:14:55", "text": "是的，因为我看了你的频道。"}]
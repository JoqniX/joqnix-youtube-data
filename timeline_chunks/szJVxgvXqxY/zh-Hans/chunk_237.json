[{"type": "subtitle", "time": 14223.948, "timestamp": "03:57:03", "text": "呃，我们接下来回这里吧。"}, {"type": "subtitle", "time": 14227.31, "timestamp": "03:57:07", "text": "转动。哦，这些人是"}, {"type": "subtitle", "time": 14238.788, "timestamp": "03:57:18", "text": "那里。等等，游戏里说我"}, {"type": "subtitle", "time": 14241.27, "timestamp": "03:57:21", "text": "应该击败并杀死野蛮人，"}, {"type": "subtitle", "time": 14247.39, "timestamp": "03:57:27", "text": "所以我相信"}, {"type": "subtitle", "time": 14248.91, "timestamp": "03:57:28", "text": "它。"}, {"type": "subtitle", "time": 14256.59, "timestamp": "03:57:36", "text": "他们。又一个。什么是"}, {"type": "subtitle", "time": 14265.23, "timestamp": "03:57:45", "text": "哦，"}, {"type": "subtitle", "time": 14272.708, "timestamp": "03:57:52", "text": "钼。他们去了那边。这家伙"}, {"type": "subtitle", "time": 14275.27, "timestamp": "03:57:55", "text": "去了那边。天堂里没有狗。"}, {"type": "subtitle", "time": 14278.07, "timestamp": "03:57:58", "text": "解锁畜牧业。我想去"}]
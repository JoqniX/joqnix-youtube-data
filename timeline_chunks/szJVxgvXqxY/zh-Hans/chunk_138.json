[{"type": "subtitle", "time": 8287.59, "timestamp": "02:18:07", "text": "我不认为他们会像友军误伤那样。"}, {"type": "subtitle", "time": 8289.429, "timestamp": "02:18:09", "text": "已开启。"}, {"type": "subtitle", "time": 8292.349, "timestamp": "02:18:12", "text": "是的，并非如此。它是"}, {"type": "subtitle", "time": 8312.63, "timestamp": "02:18:32", "text": "准备停止。"}, {"type": "subtitle", "time": 8328.75, "timestamp": "02:18:48", "text": "顶部。我希望他不会试图杀人。"}, {"type": "subtitle", "time": 8330.99, "timestamp": "02:18:50", "text": "我们。那里我们"}, {"type": "subtitle", "time": 8335.229, "timestamp": "02:18:55", "text": "去。好吧，我有一些……"}, {"type": "subtitle", "time": 8338.309, "timestamp": "02:18:58", "text": "硬币。准备去开稀有宝箱"}]
[{"type": "subtitle", "time": 15900.39, "timestamp": "04:25:00", "text": "呃，转了八圈。这是什么？三"}, {"type": "subtitle", "time": 15901.628, "timestamp": "04:25:01", "text": "转弯。"}, {"type": "subtitle", "time": 15908.868, "timestamp": "04:25:08", "text": "我向空中射出一箭。射箭。"}, {"type": "subtitle", "time": 15911.91, "timestamp": "04:25:11", "text": "我们走吧。地球。我们现在可以练射箭了。"}, {"type": "subtitle", "time": 15916.55, "timestamp": "04:25:16", "text": "我们走吧。接下来我需要"}, {"type": "subtitle", "time": 15926.47, "timestamp": "04:25:26", "text": "这位好奇者"}, {"type": "subtitle", "time": 15929.15, "timestamp": "04:25:29", "text": "呃，神社建筑。好的。"}, {"type": "subtitle", "time": 15934.99, "timestamp": "04:25:34", "text": "好的。所以，写作轮航海大师"}, {"type": "subtitle", "time": 15937.35, "timestamp": "04:25:37", "text": "灌溉。我们来做点什么吧"}, {"type": "subtitle", "time": 15941.27, "timestamp": "04:25:41", "text": "可以很容易地减少转弯次数。"}, {"type": "subtitle", "time": 15944.23, "timestamp": "04:25:44", "text": "七。我们可以选择占星术，或者我们"}, {"type": "subtitle", "time": 15946.31, "timestamp": "04:25:46", "text": "可以用于写作。我们来吧"}, {"type": "subtitle", "time": 15948.75, "timestamp": "04:25:48", "text": "占星术"}, {"type": "subtitle", "time": 15951.07, "timestamp": "04:25:51", "text": "现在。单位需求"}, {"type": "subtitle", "time": 15953.868, "timestamp": "04:25:53", "text": "订购、睡眠、"}, {"type": "subtitle", "time": 15957.51, "timestamp": "04:25:57", "text": "移动。他们是建筑工人，对吧？什么"}]
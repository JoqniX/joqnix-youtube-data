[{"type": "subtitle", "time": 19447.99, "timestamp": "05:24:07", "text": "闪电。好了，走吧，走吧。跑，跑，跑！"}, {"type": "subtitle", "time": 19450.07, "timestamp": "05:24:10", "text": "跑，跑，跑。"}, {"type": "subtitle", "time": 19453.27, "timestamp": "05:24:13", "text": "跑，跑，跑，跑，跑，跑。"}, {"type": "subtitle", "time": 19455.948, "timestamp": "05:24:15", "text": "它跟在后面"}, {"type": "subtitle", "time": 19458.11, "timestamp": "05:24:18", "text": "我。哦"}, {"type": "subtitle", "time": 19463.27, "timestamp": "05:24:23", "text": "上帝。我的天啊。我的天啊。好的，所以呃，我"}, {"type": "subtitle", "time": 19467.35, "timestamp": "05:24:27", "text": "想想看，好吧，恶魔就是恶魔。"}, {"type": "subtitle", "time": 19471.91, "timestamp": "05:24:31", "text": "我的天啊。很多次"}, {"type": "subtitle", "time": 19477.19, "timestamp": "05:24:37", "text": "呃，是五点。我没有核实。"}, {"type": "subtitle", "time": 19479.19, "timestamp": "05:24:39", "text": "你想让我检查一下吗？不。"}, {"type": "subtitle", "time": 19482.03, "timestamp": "05:24:42", "text": "不，不，最好不要。最好不要。更好的"}, {"type": "subtitle", "time": 19484.91, "timestamp": "05:24:44", "text": "不是。但你是"}, {"type": "subtitle", "time": 19486.91, "timestamp": "05:24:46", "text": "独自的。不。"}, {"type": "subtitle", "time": 19490.548, "timestamp": "05:24:50", "text": "不，不，恶魔。恶魔。恶魔。恶魔。去。"}, {"type": "subtitle", "time": 19493.11, "timestamp": "05:24:53", "text": "有恶魔吗？正确的。好的。是的。"}, {"type": "subtitle", "time": 19495.43, "timestamp": "05:24:55", "text": "恶魔。恶魔。恶魔。有斑点吗？"}, {"type": "subtitle", "time": 19498.628, "timestamp": "05:24:58", "text": "投影？我认为没有点，"}]
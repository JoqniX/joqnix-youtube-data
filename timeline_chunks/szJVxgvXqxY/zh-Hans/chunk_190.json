[{"type": "subtitle", "time": 11448.15, "timestamp": "03:10:48", "text": "我回来了。我回来了。对不起。"}, {"type": "subtitle", "time": 11450.79, "timestamp": "03:10:50", "text": "欢迎回来。显然，其中之一"}, {"type": "subtitle", "time": 11454.03, "timestamp": "03:10:54", "text": "同学们打电话过来……"}, {"type": "subtitle", "time": 11457.07, "timestamp": "03:10:57", "text": "你说你七月份的入学资料收到了"}]
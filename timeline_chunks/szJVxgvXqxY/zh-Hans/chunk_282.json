[{"type": "subtitle", "time": 16920.15, "timestamp": "04:42:00", "text": "不，不，不，不，不，不。"}, {"type": "subtitle", "time": 16922.628, "timestamp": "04:42:02", "text": "什么是设备管理？快速加载"}, {"type": "subtitle", "time": 16924.99, "timestamp": "04:42:04", "text": "出去。"}, {"type": "subtitle", "time": 16928.31, "timestamp": "04:42:08", "text": "哇。我不明白人们是如何努力奋斗的。"}, {"type": "subtitle", "time": 16932.948, "timestamp": "04:42:12", "text": "这场比赛对帕特里克来说意义非凡。我不明白。"}, {"type": "subtitle", "time": 16935.43, "timestamp": "04:42:15", "text": "有些人能立刻看到鬼魂。"}, {"type": "subtitle", "time": 16937.83, "timestamp": "04:42:17", "text": "然后会说，“是的，就是这个。”"}, {"type": "subtitle", "time": 16940.23, "timestamp": "04:42:20", "text": "鬼魂的类型。来就像走一样。"}, {"type": "subtitle", "time": 16942.35, "timestamp": "04:42:22", "text": "不行，我不能。决不。"}, {"type": "subtitle", "time": 16946.548, "timestamp": "04:42:26", "text": "如何？我的天啊。魔法。魔法。"}, {"type": "subtitle", "time": 16949.11, "timestamp": "04:42:29", "text": "他们玩得太多了。"}, {"type": "subtitle", "time": 16952.15, "timestamp": "04:42:32", "text": "是的。他们玩得太多了。玩得太多了。"}, {"type": "subtitle", "time": 16954.708, "timestamp": "04:42:34", "text": "你想玩哪张地图？任何"}, {"type": "subtitle", "time": 16958.548, "timestamp": "04:42:38", "text": "你想玩哪张地图？呃，除了什么都行"}, {"type": "subtitle", "time": 16961.03, "timestamp": "04:42:41", "text": "阳光灿烂的奖牌。阳光奖牌数量有限。"}, {"type": "subtitle", "time": 16964.19, "timestamp": "04:42:44", "text": "布朗高中。呃，"}, {"type": "subtitle", "time": 16968.23, "timestamp": "04:42:48", "text": "M 小地图。小地图。当我"}, {"type": "subtitle", "time": 16972.23, "timestamp": "04:42:52", "text": "赫菲尔德、米奇菲尔德、克拉夫顿、威洛"}, {"type": "subtitle", "time": 16975.19, "timestamp": "04:42:55", "text": "街道。我很好。我想去 Tangle"}]
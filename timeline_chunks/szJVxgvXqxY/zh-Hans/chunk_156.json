[{"type": "subtitle", "time": 9365.83, "timestamp": "02:36:05", "text": "我得到了一把剑。我做了一把剑。好的。"}, {"type": "subtitle", "time": 9367.51, "timestamp": "02:36:07", "text": "好的。但是，哦，我已经死了。我死了。我是"}, {"type": "subtitle", "time": 9381.83, "timestamp": "02:36:21", "text": "你死了吗？不，不，不，不。我还活着。"}, {"type": "subtitle", "time": 9385.59, "timestamp": "02:36:25", "text": "但我随时都可能死去。"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "你还活着吗？是的，我还活着。我是"}, {"type": "subtitle", "time": 9391.51, "timestamp": "02:36:31", "text": "准备做某事。"}, {"type": "subtitle", "time": 9393.67, "timestamp": "02:36:33", "text": "我的天啊。我死了。我死了。我是"}, {"type": "subtitle", "time": 9395.349, "timestamp": "02:36:35", "text": "已经死了。我只需轻轻一点。就像"}, {"type": "subtitle", "time": 9397.67, "timestamp": "02:36:37", "text": "10人。我死了。我看你快要死了。"}, {"type": "subtitle", "time": 9398.95, "timestamp": "02:36:38", "text": "我相信你。你可以做到。你"}, {"type": "subtitle", "time": 9405.99, "timestamp": "02:36:45", "text": "我的天啊。为什么这游戏这么难？"}]
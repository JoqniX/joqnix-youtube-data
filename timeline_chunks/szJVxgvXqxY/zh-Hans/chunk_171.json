[{"type": "subtitle", "time": 10284.55, "timestamp": "02:51:24", "text": "你最喜欢的游戏是什么？"}, {"type": "subtitle", "time": 10287.79, "timestamp": "02:51:27", "text": "我最喜欢的游戏是"}, {"type": "subtitle", "time": 10292.309, "timestamp": "02:51:32", "text": "我猜是《我的世界》吧，因为"}, {"type": "subtitle", "time": 10295.11, "timestamp": "02:51:35", "text": "呃，我的意思是，我的确也喜欢其他一些东西。"}, {"type": "subtitle", "time": 10298.229, "timestamp": "02:51:38", "text": "游戏就像介于两者之间，但感觉就像"}, {"type": "subtitle", "time": 10305.349, "timestamp": "02:51:45", "text": "你玩了多久了？"}, {"type": "subtitle", "time": 10310.67, "timestamp": "02:51:50", "text": "我的世界？自从我……以来"}, {"type": "subtitle", "time": 10314.55, "timestamp": "02:51:54", "text": "想想四年级的水平。嗯，那是多久以前的事了？"}, {"type": "subtitle", "time": 10318.229, "timestamp": "02:51:58", "text": "那？呃，真糟糕。那可是很多年啊，"}]
[{"type": "subtitle", "time": 7681.15, "timestamp": "02:08:01", "text": "你。你这古老的祖先是什么？"}, {"type": "subtitle", "time": 7684.309, "timestamp": "02:08:04", "text": "明白了吗？我完全没有头绪。我的天啊。"}, {"type": "subtitle", "time": 7686.429, "timestamp": "02:08:06", "text": "不"}, {"type": "subtitle", "time": 7688.389, "timestamp": "02:08:08", "text": "死。时间。别死。别死。不"}, {"type": "subtitle", "time": 7694.389, "timestamp": "02:08:14", "text": "好吧，我出局一半了，但我猜我还能行。"}, {"type": "subtitle", "time": 7707.99, "timestamp": "02:08:27", "text": "这些人有点没用，兄弟。"}, {"type": "subtitle", "time": 7710.67, "timestamp": "02:08:30", "text": "他们没有帮助我们。"}, {"type": "subtitle", "time": 7713.349, "timestamp": "02:08:33", "text": "全部。好吧，但我可以买到钢材。"}, {"type": "subtitle", "time": 7722.07, "timestamp": "02:08:42", "text": "哎呀，这家伙是怎么起来的？"}, {"type": "subtitle", "time": 7728.59, "timestamp": "02:08:48", "text": "是的，我居然拿到了暴击。"}, {"type": "subtitle", "time": 7732.87, "timestamp": "02:08:52", "text": "好的，七个硬币。"}, {"type": "subtitle", "time": 7735.59, "timestamp": "02:08:55", "text": "找到东西了。用土地激发活力"}, {"type": "subtitle", "time": 7737.67, "timestamp": "02:08:57", "text": "落地时被暴击。我想应该是一样的。"}]
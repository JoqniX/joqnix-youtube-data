[{"type": "subtitle", "time": 15370.55, "timestamp": "04:16:10", "text": "呃，我该怎么做？"}, {"type": "subtitle", "time": 15373.31, "timestamp": "04:16:13", "text": "[音乐]"}, {"type": "subtitle", "time": 15382.07, "timestamp": "04:16:22", "text": "单位。您的土地单元无法进入"}, {"type": "subtitle", "time": 15383.948, "timestamp": "04:16:23", "text": "任何水道。然而，你的发射"}, {"type": "subtitle", "time": 15388.59, "timestamp": "04:16:28", "text": "先失败后"}, {"type": "subtitle", "time": 15392.23, "timestamp": "04:16:32", "text": "土地。继续执行移动操作是"}, {"type": "subtitle", "time": 15398.31, "timestamp": "04:16:38", "text": "必须什么？不，我想了解和学习"}, {"type": "subtitle", "time": 15400.51, "timestamp": "04:16:40", "text": "如何"}, {"type": "subtitle", "time": 15410.31, "timestamp": "04:16:50", "text": "单位领导者建设单位。好的。"}, {"type": "subtitle", "time": 15412.99, "timestamp": "04:16:52", "text": "平民地面战斗"}, {"type": "subtitle", "time": 15415.83, "timestamp": "04:16:55", "text": "射手。我该如何创造这些人？"}, {"type": "subtitle", "time": 15418.708, "timestamp": "04:16:58", "text": "八。"}]
[{"type": "subtitle", "time": 9002.469, "timestamp": "02:30:02", "text": "我。我对我不造成多大的损害"}, {"type": "subtitle", "time": 9005.59, "timestamp": "02:30:05", "text": "别对他造成任何伤害。我被煮熟了。"}, {"type": "subtitle", "time": 9008.55, "timestamp": "02:30:08", "text": "我这里已经完全煮熟了。我的天啊。如何"}, {"type": "subtitle", "time": 9011.99, "timestamp": "02:30:11", "text": "如何使用泥土包？"}, {"type": "subtitle", "time": 9013.91, "timestamp": "02:30:13", "text": "嗯，就像你跳得更高一样。"}, {"type": "subtitle", "time": 9015.03, "timestamp": "02:30:15", "text": "不多。我的天哪，他"}, {"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "你无法对魔像造成太大伤害。"}, {"type": "subtitle", "time": 9029.349, "timestamp": "02:30:29", "text": "损害。他身体很健康。哦，我的"}, {"type": "subtitle", "time": 9032.229, "timestamp": "02:30:32", "text": "上帝。为什么难度越来越大？我"}, {"type": "subtitle", "time": 9042.309, "timestamp": "02:30:42", "text": "天。没关系。我正在击败"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "魔像。是的。好的，我明白了"}, {"type": "subtitle", "time": 9047.269, "timestamp": "02:30:47", "text": "其他人。我的天哪，有……"}, {"type": "subtitle", "time": 9049.51, "timestamp": "02:30:49", "text": "另一个魔像。这里有三个魔像。"}, {"type": "subtitle", "time": 9051.59, "timestamp": "02:30:51", "text": "这到底是怎么回事？"}, {"type": "subtitle", "time": 9053.429, "timestamp": "02:30:53", "text": "世界？现在应该是白天了。"}]
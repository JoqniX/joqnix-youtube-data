[{"type": "subtitle", "time": 9810.229, "timestamp": "02:43:30", "text": "我觉得你应该试试。"}, {"type": "subtitle", "time": 9813.51, "timestamp": "02:43:33", "text": "挑战游戏。"}, {"type": "subtitle", "time": 9815.51, "timestamp": "02:43:35", "text": "战斗开始。开始战斗。是的，"}, {"type": "subtitle", "time": 9819.269, "timestamp": "02:43:39", "text": "你得到一些物品。"}, {"type": "subtitle", "time": 9823.59, "timestamp": "02:43:43", "text": "是很难吗？"}, {"type": "subtitle", "time": 9826.07, "timestamp": "02:43:46", "text": "呃，就三只暴徒，三条狗会"}, {"type": "subtitle", "time": 9827.75, "timestamp": "02:43:47", "text": "生成。你只需要杀了他们。哦，"}, {"type": "subtitle", "time": 9830.51, "timestamp": "02:43:50", "text": "这很简单。"}, {"type": "subtitle", "time": 9833.75, "timestamp": "02:43:53", "text": "是的，我好像被爆破了或者类似的东西"}, {"type": "subtitle", "time": 9835.07, "timestamp": "02:43:55", "text": "传奇"}, {"type": "subtitle", "time": 9838.59, "timestamp": "02:43:58", "text": "物品，而且很容易……"}]
[{"type": "subtitle", "time": 6060.15, "timestamp": "01:41:00", "text": "我错过了夏树的出道，当时我正……"}, {"type": "subtitle", "time": 6062.389, "timestamp": "01:41:02", "text": "正在经历出道那件事。哦，我的"}, {"type": "subtitle", "time": 6065.83, "timestamp": "01:41:05", "text": "天哪，他的模型太酷了。"}, {"type": "subtitle", "time": 6068.23, "timestamp": "01:41:08", "text": "对，你应该看看他的出道视频。"}, {"type": "subtitle", "time": 6070.389, "timestamp": "01:41:10", "text": "之后会发视频，因为感觉就像我花了……"}, {"type": "subtitle", "time": 6072.79, "timestamp": "01:41:12", "text": "感觉花了很多时间在上面。整整一天"}, {"type": "subtitle", "time": 6075.11, "timestamp": "01:41:15", "text": "昨天，我正在剪辑他的视频。"}, {"type": "subtitle", "time": 6078.23, "timestamp": "01:41:18", "text": "我的天哪，你编辑了他。"}, {"type": "subtitle", "time": 6081.469, "timestamp": "01:41:21", "text": "为他编辑的。我的天啊。"}, {"type": "subtitle", "time": 6083.59, "timestamp": "01:41:23", "text": "好的。那很好。我忘了"}, {"type": "subtitle", "time": 6086.469, "timestamp": "01:41:26", "text": "缩略图。"}, {"type": "subtitle", "time": 6090.87, "timestamp": "01:41:30", "text": "基本上，这是我的频道，亲爱的。"}, {"type": "subtitle", "time": 6094.309, "timestamp": "01:41:34", "text": "我的天啊。好的。"}, {"type": "subtitle", "time": 6096.79, "timestamp": "01:41:36", "text": "我喜欢他的审美风格。鲨鱼"}, {"type": "subtitle", "time": 6099.51, "timestamp": "01:41:39", "text": "东西。太棒了。叠加层和"}, {"type": "subtitle", "time": 6108.23, "timestamp": "01:41:48", "text": "我能想象夏树像……鲨鱼一样。"}, {"type": "subtitle", "time": 6110.63, "timestamp": "01:41:50", "text": "有一天会穿连体衣。"}, {"type": "subtitle", "time": 6112.87, "timestamp": "01:41:52", "text": "是的。他其实是想买一个。"}, {"type": "subtitle", "time": 6115.03, "timestamp": "01:41:55", "text": "几天前，但他当时还没有那个。"}, {"type": "subtitle", "time": 6117.11, "timestamp": "01:41:57", "text": "钱。他当时说：“哦，别买。”"}, {"type": "subtitle", "time": 6118.63, "timestamp": "01:41:58", "text": "对我来说。” 我心想，“兄弟，我穷死了。”"}]
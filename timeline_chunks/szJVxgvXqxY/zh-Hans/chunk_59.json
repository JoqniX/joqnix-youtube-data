[{"type": "subtitle", "time": 3544.55, "timestamp": "00:59:04", "text": "我知道最后一个是蓝色的。是的。"}, {"type": "subtitle", "time": 3547.47, "timestamp": "00:59:07", "text": "你好。"}, {"type": "subtitle", "time": 3554.39, "timestamp": "00:59:14", "text": "Apex Pro 的专业人士。阿祖拉·拉皮斯。"}, {"type": "subtitle", "time": 3556.55, "timestamp": "00:59:16", "text": "等等，你玩Apex英雄？"}, {"type": "subtitle", "time": 3558.669, "timestamp": "00:59:18", "text": "哦，是的。我做了。"}, {"type": "subtitle", "time": 3578.669, "timestamp": "00:59:38", "text": "一、二、二"}, {"type": "subtitle", "time": 3589.629, "timestamp": "00:59:49", "text": "是的。好的。可以接受。然后我们去杀人"}, {"type": "subtitle", "time": 3595.87, "timestamp": "00:59:55", "text": "他。我喜欢我第一个死去的方式。我的天啊。"}]
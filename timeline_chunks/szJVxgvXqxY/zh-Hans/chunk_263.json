[{"type": "subtitle", "time": 15788.75, "timestamp": "04:23:08", "text": "我的天哪，这可真不少。"}, {"type": "subtitle", "time": 15791.53, "timestamp": "04:23:11", "text": "侦察兵"}, {"type": "subtitle", "time": 15800.27, "timestamp": "04:23:20", "text": "[音乐]"}, {"type": "subtitle", "time": 15809.27, "timestamp": "04:23:29", "text": "东西。三吨，而这是六吨。"}, {"type": "subtitle", "time": 15810.46, "timestamp": "04:23:30", "text": "好的。"}, {"type": "subtitle", "time": 15824.59, "timestamp": "04:23:44", "text": "这是什么？这是什么？"}, {"type": "subtitle", "time": 15828.27, "timestamp": "04:23:48", "text": "有趣的。那就像克苏鲁一样，或者"}, {"type": "subtitle", "time": 15836.35, "timestamp": "04:23:56", "text": "离开。好的，再来一轮。我会得到"}, {"type": "subtitle", "time": 15839.19, "timestamp": "04:23:59", "text": "这。非常好。把探索的任务留给别人吧。"}]
[{"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "不，这游戏看起来像是25金币开宝箱。"}, {"type": "subtitle", "time": 6273.349, "timestamp": "01:44:33", "text": "但是你不能打开箱子之类的东西。"}, {"type": "subtitle", "time": 6275.429, "timestamp": "01:44:35", "text": "我也打不开。我认为"}, {"type": "subtitle", "time": 6277.429, "timestamp": "01:44:37", "text": "你应该用类似……的方式打破它"}, {"type": "subtitle", "time": 6280.55, "timestamp": "01:44:40", "text": "或许是镐。哦，别告诉我这个"}, {"type": "subtitle", "time": 6282.309, "timestamp": "01:44:42", "text": "游戏就像 Rust。你必须得到一个"}, {"type": "subtitle", "time": 6284.11, "timestamp": "01:44:44", "text": "摇滚，然后用它"}, {"type": "subtitle", "time": 6286.51, "timestamp": "01:44:46", "text": "打破"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "哦。"}, {"type": "subtitle", "time": 6291.75, "timestamp": "01:44:51", "text": "它是Rust。"}, {"type": "subtitle", "time": 6293.59, "timestamp": "01:44:53", "text": "我的天啊。我觉得它之前就出来了。"}, {"type": "subtitle", "time": 6296.87, "timestamp": "01:44:56", "text": "锈。确实如此。"}, {"type": "subtitle", "time": 6299.429, "timestamp": "01:44:59", "text": "这部电影大概是2018年上映的。"}]
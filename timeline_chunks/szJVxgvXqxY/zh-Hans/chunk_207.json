[{"type": "subtitle", "time": 12422.0, "timestamp": "03:27:02", "text": "上午糟透了。我本不该是 搬家了。哦不"}, {"type": "subtitle", "time": 12428.67, "timestamp": "03:27:08", "text": "更多其他部分"}, {"type": "subtitle", "time": 12435.79, "timestamp": "03:27:15", "text": "再见。等等，怎么会这样"}, {"type": "subtitle", "time": 12438.75, "timestamp": "03:27:18", "text": "长的？等等，我想你正在通话中。"}, {"type": "subtitle", "time": 12441.309, "timestamp": "03:27:21", "text": "就像两个或"}, {"type": "subtitle", "time": 12443.75, "timestamp": "03:27:23", "text": "三次电话之类的，"}, {"type": "subtitle", "time": 12445.55, "timestamp": "03:27:25", "text": "[音乐]"}, {"type": "subtitle", "time": 12448.03, "timestamp": "03:27:28", "text": "正确的？是的。我"}, {"type": "subtitle", "time": 12453.7, "timestamp": "03:27:33", "text": "希望这一切尽快结束，因为啊……"}, {"type": "subtitle", "time": 12455.71, "timestamp": "03:27:35", "text": "[音乐]"}, {"type": "subtitle", "time": 12458.95, "timestamp": "03:27:38", "text": "疼痛。好吧，我忘了做这件事。呃"}, {"type": "subtitle", "time": 12460.71, "timestamp": "03:27:40", "text": "等等，等等，等等，等等，等等。让我……"}, {"type": "subtitle", "time": 12469.11, "timestamp": "03:27:49", "text": "游戏。好的。电影院是六。好的。我们开始吧"}, {"type": "subtitle", "time": 12471.189, "timestamp": "03:27:51", "text": "去。另外，让我打开聊天窗口。哦"}, {"type": "subtitle", "time": 12473.63, "timestamp": "03:27:53", "text": "我的上帝。我回来了"}]
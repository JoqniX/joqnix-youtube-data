[{"type": "subtitle", "time": 2701.709, "timestamp": "00:45:01", "text": "真是太"}, {"type": "subtitle", "time": 2705.35, "timestamp": "00:45:05", "text": "有趣的。这是一个……这是一个……这是一个蛋"}, {"type": "subtitle", "time": 2707.629, "timestamp": "00:45:07", "text": "投掷"}, {"type": "subtitle", "time": 2710.95, "timestamp": "00:45:10", "text": "枪。鸡蛋到哦，是个鸡蛋。哦，那个"}, {"type": "subtitle", "time": 2713.55, "timestamp": "00:45:13", "text": "一。"}, {"type": "subtitle", "time": 2728.91, "timestamp": "00:45:28", "text": "迪格尔。"}, {"type": "subtitle", "time": 2746.75, "timestamp": "00:45:46", "text": "一？嘿，我们走吧。我们开始吧"}, {"type": "subtitle", "time": 2750.59, "timestamp": "00:45:50", "text": "去。我们应该去哪里？"}, {"type": "subtitle", "time": 2754.07, "timestamp": "00:45:54", "text": "去？这里。"}]
[{"type": "subtitle", "time": 13381.99, "timestamp": "03:43:01", "text": "你运动越多，你就越……"}, {"type": "subtitle", "time": 13386.11, "timestamp": "03:43:06", "text": "移动，它发现的区域就越多。"}, {"type": "subtitle", "time": 13388.35, "timestamp": "03:43:08", "text": "什么？"}, {"type": "subtitle", "time": 13391.15, "timestamp": "03:43:11", "text": "该死。好的。好的。"}, {"type": "subtitle", "time": 13394.628, "timestamp": "03:43:14", "text": "好的。好的。好的。好的。我很兴奋。"}, {"type": "subtitle", "time": 13397.39, "timestamp": "03:43:17", "text": "这是什么？撒玛利亚"}, {"type": "subtitle", "time": 13400.628, "timestamp": "03:43:20", "text": "勇士，我可以移动你吗？我动不了"}, {"type": "subtitle", "time": 13408.948, "timestamp": "03:43:28", "text": "去。一。等等，我该怎么办？我是什么？"}, {"type": "subtitle", "time": 13419.75, "timestamp": "03:43:39", "text": "吨。你的意思是结束你的“这是一个”吗？"}, {"type": "subtitle", "time": 13422.67, "timestamp": "03:43:42", "text": "基于吨位的游戏。"}, {"type": "subtitle", "time": 13429.91, "timestamp": "03:43:49", "text": "顾问称淡水资源"}, {"type": "subtitle", "time": 13431.788, "timestamp": "03:43:51", "text": "区域产量"}, {"type": "subtitle", "time": 13437.27, "timestamp": "03:43:57", "text": "新城。嗯。选择研究。嗯，打开"}, {"type": "subtitle", "time": 13438.99, "timestamp": "03:43:58", "text": "科技树。"}]
[{"type": "subtitle", "time": 7080.23, "timestamp": "01:58:00", "text": "正确的？并非没有类似的门。"}, {"type": "subtitle", "time": 7091.23, "timestamp": "01:58:11", "text": "嗯，但这可能有点过头了。"}, {"type": "subtitle", "time": 7093.87, "timestamp": "01:58:13", "text": "我们。他们"}, {"type": "subtitle", "time": 7096.349, "timestamp": "01:58:16", "text": "可能会走"}, {"type": "subtitle", "time": 7099.15, "timestamp": "01:58:19", "text": "没关系。我们可以防守，我"}, {"type": "subtitle", "time": 7101.91, "timestamp": "01:58:21", "text": "猜测。是的。哦，如果你把东西扔向"}, {"type": "subtitle", "time": 7105.59, "timestamp": "01:58:25", "text": "地面，哦，"}, {"type": "subtitle", "time": 7107.91, "timestamp": "01:58:27", "text": "好的。没关系。我觉得如果当"}, {"type": "subtitle", "time": 7111.75, "timestamp": "01:58:31", "text": "你把东西扔到地上，不。呃或"}, {"type": "subtitle", "time": 7116.07, "timestamp": "01:58:36", "text": "我觉得，有些东西，你会失去它。不是"}, {"type": "subtitle", "time": 7125.75, "timestamp": "01:58:45", "text": "看？另外，我们还得找到小麦，我"}, {"type": "subtitle", "time": 7127.75, "timestamp": "01:58:47", "text": "思考。因为用小麦，你可以制作"}, {"type": "subtitle", "time": 7130.55, "timestamp": "01:58:50", "text": "绳索。我认为我们需要绳子来制作"}, {"type": "chat", "time": 7131.631, "timestamp": "01:58:51", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "ain't no way, it's the blue lazuli!"}, {"type": "subtitle", "time": 7134.55, "timestamp": "01:58:54", "text": "工具。哦，我有小麦"}, {"type": "subtitle", "time": 7137.349, "timestamp": "01:58:57", "text": "五麦子和我一起。好的，试试看。"}]
[{"type": "subtitle", "time": 17525.27, "timestamp": "04:52:05", "text": "我的上帝。一个全身通红的男人。我的天啊。"}, {"type": "subtitle", "time": 17527.99, "timestamp": "04:52:07", "text": "你好。"}, {"type": "subtitle", "time": 17529.91, "timestamp": "04:52:09", "text": "老鼠。"}, {"type": "subtitle", "time": 17530.91, "timestamp": "04:52:10", "text": "哦，我的"}, {"type": "subtitle", "time": 17556.868, "timestamp": "04:52:36", "text": "你可以出来了。你可以上来。能"}, {"type": "subtitle", "time": 17557.628, "timestamp": "04:52:37", "text": "来"}, {"type": "subtitle", "time": 17559.708, "timestamp": "04:52:39", "text": "出去。哦，"}, {"type": "subtitle", "time": 17563.83, "timestamp": "04:52:43", "text": "好的。好的。快点。过来。我该如何做？"}, {"type": "subtitle", "time": 17566.948, "timestamp": "04:52:46", "text": "是的。好的。是的。好的。如何打开"}, {"type": "subtitle", "time": 17569.27, "timestamp": "04:52:49", "text": "好了，就是这样。如何打开"}]
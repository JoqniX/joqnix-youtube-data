[{"type": "subtitle", "time": 18541.11, "timestamp": "05:09:01", "text": "就在这里。在那儿等着。是的。是的。"}, {"type": "subtitle", "time": 18544.39, "timestamp": "05:09:04", "text": "可能是那些女孩"}, {"type": "subtitle", "time": 18551.51, "timestamp": "05:09:11", "text": "嗯，就像……它喜欢那个人"}, {"type": "subtitle", "time": 18554.07, "timestamp": "05:09:14", "text": "独自一人，像猎人一样猎杀他们。不是"}, {"type": "subtitle", "time": 18556.868, "timestamp": "05:09:16", "text": "擅长团队合作。是的。我也这么认为。我"}, {"type": "subtitle", "time": 18558.11, "timestamp": "05:09:18", "text": "思考"}, {"type": "subtitle", "time": 18570.47, "timestamp": "05:09:30", "text": "你有没有听到类似门响之类的声音？"}, {"type": "subtitle", "time": 18573.59, "timestamp": "05:09:33", "text": "比如在行动中？"}, {"type": "subtitle", "time": 18576.35, "timestamp": "05:09:36", "text": "没有。不。"}, {"type": "subtitle", "time": 18579.11, "timestamp": "05:09:39", "text": "不，只有嗡嗡声。那是"}, {"type": "subtitle", "time": 18581.03, "timestamp": "05:09:41", "text": "它。"}, {"type": "subtitle", "time": 18584.27, "timestamp": "05:09:44", "text": "试着上楼。去"}, {"type": "subtitle", "time": 18588.11, "timestamp": "05:09:48", "text": "向上。跨场或"}, {"type": "subtitle", "time": 18597.03, "timestamp": "05:09:57", "text": "楼上那边有一只鞋。"}]
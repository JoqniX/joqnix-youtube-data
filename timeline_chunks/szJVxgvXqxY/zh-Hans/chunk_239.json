[{"type": "subtitle", "time": 14342.15, "timestamp": "03:59:02", "text": "第二节回来。但我们可以拥有财富"}, {"type": "subtitle", "time": 14346.39, "timestamp": "03:59:06", "text": "研究资料。所以，我希望下一个是"}, {"type": "subtitle", "time": 14348.948, "timestamp": "03:59:08", "text": "挖矿，因为我需要挖矿，因为我"}, {"type": "subtitle", "time": 14351.55, "timestamp": "03:59:11", "text": "需要赚钱，"}, {"type": "subtitle", "time": 14354.23, "timestamp": "03:59:14", "text": "正确的？哦，这家伙，这些游骑兵是"}, {"type": "subtitle", "time": 14357.788, "timestamp": "03:59:17", "text": "这里。城市持续繁荣发展。"}, {"type": "subtitle", "time": 14361.99, "timestamp": "03:59:21", "text": "敲门声，我们的人口就增长了。告诉我"}, {"type": "subtitle", "time": 14365.19, "timestamp": "03:59:25", "text": "更多的。你的城市将会发展壮大，并增加更多"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "拥有剩余食物的公民和任何"}, {"type": "subtitle", "time": 14369.51, "timestamp": "03:59:29", "text": "超过热门食物的数量"}, {"type": "subtitle", "time": 14372.07, "timestamp": "03:59:32", "text": "城市居民的消费。"}, {"type": "subtitle", "time": 14374.948, "timestamp": "03:59:34", "text": "Tuper 被视为剩余物并添加"}, {"type": "subtitle", "time": 14378.31, "timestamp": "03:59:38", "text": "这是迈向新公民的进步过程。一个"}, {"type": "subtitle", "time": 14381.75, "timestamp": "03:59:41", "text": "城市将把剩余粮食用于其增长。"}, {"type": "subtitle", "time": 14385.11, "timestamp": "03:59:45", "text": "如果其当前人口为两个或两个以上"}, {"type": "subtitle", "time": 14387.67, "timestamp": "03:59:47", "text": "低于该市的住房限额。如果"}, {"type": "subtitle", "time": 14389.91, "timestamp": "03:59:49", "text": "城市是其中之一，人口低于其"}, {"type": "subtitle", "time": 14392.99, "timestamp": "03:59:52", "text": "住房限制，其增长速度将会放缓。"}, {"type": "subtitle", "time": 14396.55, "timestamp": "03:59:56", "text": "50%。当人口数量确定时"}, {"type": "subtitle", "time": 14399.07, "timestamp": "03:59:59", "text": "住房限额，它只会增长。"}]
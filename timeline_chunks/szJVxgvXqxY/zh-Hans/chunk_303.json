[{"type": "subtitle", "time": 18184.59, "timestamp": "05:03:04", "text": "你有"}, {"type": "subtitle", "time": 18195.59, "timestamp": "05:03:15", "text": "等待。我来拿相机。加热一下。"}, {"type": "subtitle", "time": 18197.61, "timestamp": "05:03:17", "text": "天气非常暖和。"}, {"type": "subtitle", "time": 18205.27, "timestamp": "05:03:25", "text": "等等，你要去哪里？我选我自己。"}, {"type": "subtitle", "time": 18207.35, "timestamp": "05:03:27", "text": "我来拿相机。我在这里。我是"}, {"type": "subtitle", "time": 18209.43, "timestamp": "05:03:29", "text": "这里。"}, {"type": "subtitle", "time": 18212.868, "timestamp": "05:03:32", "text": "我也会量一下体温。好的。"}, {"type": "subtitle", "time": 18225.03, "timestamp": "05:03:45", "text": "哦，气温正在升高。"}, {"type": "subtitle", "time": 18228.39, "timestamp": "05:03:48", "text": "到15点了。你想去"}]
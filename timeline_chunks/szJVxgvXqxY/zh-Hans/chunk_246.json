[{"type": "subtitle", "time": 14760.708, "timestamp": "04:06:00", "text": "刺。好吧，我不知道你"}, {"type": "subtitle", "time": 14771.03, "timestamp": "04:06:11", "text": "亲爱的。呃，为什么人们想要统治某些事情？"}, {"type": "subtitle", "time": 14774.27, "timestamp": "04:06:14", "text": "只是疼痛而已。我不知道了"}, {"type": "subtitle", "time": 14776.708, "timestamp": "04:06:16", "text": "更多的。等等，我不知道你是这样的人。"}, {"type": "subtitle", "time": 14779.19, "timestamp": "04:06:19", "text": "游戏类型，但是，呃，不，我有点……"}, {"type": "subtitle", "time": 14781.75, "timestamp": "04:06:21", "text": "我是第一次玩这类游戏。我正在尝试"}, {"type": "subtitle", "time": 14784.07, "timestamp": "04:06:24", "text": "不同，我正在探索新的类型"}, {"type": "subtitle", "time": 14786.51, "timestamp": "04:06:26", "text": "我从未尝试过的游戏"}, {"type": "subtitle", "time": 14789.31, "timestamp": "04:06:29", "text": "前。所以对我来说，我是否……并不重要。"}, {"type": "subtitle", "time": 14791.75, "timestamp": "04:06:31", "text": "就算我不喜欢也没关系"}, {"type": "subtitle", "time": 14794.948, "timestamp": "04:06:34", "text": "无论是否属于某种类型。呃，重要的是我。"}, {"type": "subtitle", "time": 14798.07, "timestamp": "04:06:38", "text": "尝试一下，然后再回来"}, {"type": "subtitle", "time": 14800.948, "timestamp": "04:06:40", "text": "我喜欢也好，不喜欢也罢。所以我一直"}, {"type": "subtitle", "time": 14804.23, "timestamp": "04:06:44", "text": "玩所有FPS游戏，也喜欢RPG游戏。"}, {"type": "subtitle", "time": 14806.628, "timestamp": "04:06:46", "text": "就像大型多人在线角色扮演游戏（MMORPG）那样，对吧？所以，我想"}]
[{"type": "subtitle", "time": 15841.75, "timestamp": "04:24:01", "text": "我。您已安顿好。是说要等吗？"}, {"type": "subtitle", "time": 15844.31, "timestamp": "04:24:04", "text": "您已满足"}, {"type": "subtitle", "time": 15847.868, "timestamp": "04:24:07", "text": "呃，汤姆斯，探险家特工。再见。"}, {"type": "subtitle", "time": 15857.788, "timestamp": "04:24:17", "text": "好的，我现在找到建筑商了。我们开始吧"}, {"type": "subtitle", "time": 15861.39, "timestamp": "04:24:21", "text": "去。陈建工，你会去"}, {"type": "subtitle", "time": 15869.11, "timestamp": "04:24:29", "text": "这里。选择生产。好了，现在我明白了"}, {"type": "subtitle", "time": 15872.59, "timestamp": "04:24:32", "text": "现在我已经找到了建筑商，接下来我需要一个"}, {"type": "subtitle", "time": 15877.27, "timestamp": "04:24:37", "text": "交易员将与阿姆斯特丹进行交易。我等待着，"}, {"type": "subtitle", "time": 15878.35, "timestamp": "04:24:38", "text": "那是吗？"}, {"type": "subtitle", "time": 15887.75, "timestamp": "04:24:47", "text": "试试推荐器。等待。欢迎来改进我的。"}, {"type": "subtitle", "time": 15889.47, "timestamp": "04:24:49", "text": "我没有"}, {"type": "subtitle", "time": 15896.35, "timestamp": "04:24:56", "text": "矿。"}]
[{"type": "subtitle", "time": 5404.03, "timestamp": "01:30:04", "text": "你说他想你了？"}, {"type": "subtitle", "time": 5412.07, "timestamp": "01:30:12", "text": "所以，呃，你还会回来吗？"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "未来会有流媒体吗？你想"}, {"type": "subtitle", "time": 5417.11, "timestamp": "01:30:17", "text": "回来吗？"}, {"type": "subtitle", "time": 5419.23, "timestamp": "01:30:19", "text": "嗯，有点"}, {"type": "subtitle", "time": 5422.79, "timestamp": "01:30:22", "text": "很难，因为我住在别的地方"}, {"type": "subtitle", "time": 5426.469, "timestamp": "01:30:26", "text": "我正在工作，我的流媒体设备是"}, {"type": "subtitle", "time": 5428.07, "timestamp": "01:30:28", "text": "家。"}, {"type": "subtitle", "time": 5429.91, "timestamp": "01:30:29", "text": "是的。是的，你跟我说过这件事。是的。"}, {"type": "subtitle", "time": 5436.309, "timestamp": "01:30:36", "text": "是的。我以为你会像……一样回家。"}, {"type": "subtitle", "time": 5438.87, "timestamp": "01:30:38", "text": "周末。"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "今天是不是有点过度了？"}, {"type": "subtitle", "time": 5444.349, "timestamp": "01:30:44", "text": "哦，今天是假日。"}, {"type": "subtitle", "time": 5448.07, "timestamp": "01:30:48", "text": "啊，没关系。"}, {"type": "subtitle", "time": 5451.349, "timestamp": "01:30:51", "text": "是的，所以今天是假日。"}, {"type": "subtitle", "time": 5456.78, "timestamp": "01:30:56", "text": "好的。"}, {"type": "subtitle", "time": 5459.51, "timestamp": "01:30:59", "text": "[音乐]"}]
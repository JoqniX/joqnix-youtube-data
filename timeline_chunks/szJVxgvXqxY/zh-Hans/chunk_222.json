[{"type": "subtitle", "time": 13320.39, "timestamp": "03:42:00", "text": "好的。发生了什么？好了，就是这样。"}, {"type": "subtitle", "time": 13323.35, "timestamp": "03:42:03", "text": "你好。游戏开始。等待。特征"}, {"type": "subtitle", "time": 13326.15, "timestamp": "03:42:06", "text": "能力。呃，可能会向任何人宣战"}, {"type": "subtitle", "time": 13329.43, "timestamp": "03:42:09", "text": "对任何人。等待。任何与……交战的人"}, {"type": "subtitle", "time": 13333.07, "timestamp": "03:42:13", "text": "他们的盟友没有发动战争 摩根"}, {"type": "subtitle", "time": 13337.07, "timestamp": "03:42:17", "text": "盟友也会受到同样的惩罚吗？"}, {"type": "subtitle", "time": 13340.628, "timestamp": "03:42:20", "text": "嗯？史诗般的冒险。当你俘获野蛮人时"}, {"type": "subtitle", "time": 13343.43, "timestamp": "03:42:23", "text": "蛮族前哨站，获得一个部落"}, {"type": "subtitle", "time": 13346.55, "timestamp": "03:42:26", "text": "除了通常的奖励外，村庄还会给予奖励。"}, {"type": "subtitle", "time": 13348.27, "timestamp": "03:42:28", "text": "金子。玩"}, {"type": "subtitle", "time": 13351.11, "timestamp": "03:42:31", "text": "一半人支付通常费用的一半"}, {"type": "subtitle", "time": 13353.19, "timestamp": "03:42:33", "text": "劳动所得工资。好吧，我没有"}, {"type": "subtitle", "time": 13355.35, "timestamp": "03:42:35", "text": "我明白这一点，但我们走吧。"}, {"type": "subtitle", "time": 13358.23, "timestamp": "03:42:38", "text": "您好，我的牵绳顾问。个人的"}, {"type": "subtitle", "time": 13360.948, "timestamp": "03:42:40", "text": "顾问。我有资格在以下方面为您提供帮助："}, {"type": "subtitle", "time": 13362.628, "timestamp": "03:42:42", "text": "与统治我们的事项有关"}, {"type": "subtitle", "time": 13365.91, "timestamp": "03:42:45", "text": "文明。我随时为您效劳。我是"}, {"type": "subtitle", "time": 13370.23, "timestamp": "03:42:50", "text": "初来乍到，未曾接触过文明世界。是的。"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "这？哦，你可以哦。哦，哇。这"}]
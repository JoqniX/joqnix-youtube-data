[{"type": "subtitle", "time": 8522.389, "timestamp": "02:22:02", "text": "BL。呃，你们有煤吗？你能得到"}, {"type": "subtitle", "time": 8525.75, "timestamp": "02:22:05", "text": "一些煤？我身上有三块煤。"}, {"type": "subtitle", "time": 8528.71, "timestamp": "02:22:08", "text": "好的，我去弄些煤来。哦，还有"}, {"type": "subtitle", "time": 8531.59, "timestamp": "02:22:11", "text": "降低。我把我的……呃……把所有的肉都放进去了"}, {"type": "subtitle", "time": 8532.67, "timestamp": "02:22:12", "text": "拥有"}, {"type": "subtitle", "time": 8536.67, "timestamp": "02:22:16", "text": "坩埚。"}, {"type": "subtitle", "time": 8539.83, "timestamp": "02:22:19", "text": "是的。是的。呃，你知道吗？对此"}, {"type": "chat", "time": 8564.623, "timestamp": "02:22:44", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "the what guy?"}, {"type": "subtitle", "time": 8575.03, "timestamp": "02:22:55", "text": "并得到了"}]
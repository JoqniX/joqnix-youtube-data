[{"type": "subtitle", "time": 3850.229, "timestamp": "01:04:10", "text": "正确的。我的天啊。让我们尽力而为"}, {"type": "subtitle", "time": 3860.189, "timestamp": "01:04:20", "text": "一。在哪里？"}, {"type": "subtitle", "time": 3876.83, "timestamp": "01:04:36", "text": "损害？我觉得我得下去了。"}, {"type": "subtitle", "time": 3879.149, "timestamp": "01:04:39", "text": "[音乐]"}, {"type": "subtitle", "time": 3881.99, "timestamp": "01:04:41", "text": "是的，某处发生了打斗。非常"}, {"type": "subtitle", "time": 3897.55, "timestamp": "01:04:57", "text": "其余的。还有另一套蓝色盔甲"}]
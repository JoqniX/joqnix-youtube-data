[{"type": "subtitle", "time": 16860.868, "timestamp": "04:41:00", "text": "创建私密房间"}, {"type": "subtitle", "time": 16864.948, "timestamp": "04:41:04", "text": "并布置好房间。你好。好的。拿到了"}, {"type": "subtitle", "time": 16867.03, "timestamp": "04:41:07", "text": "邀请码。我会把它寄给你。"}, {"type": "subtitle", "time": 16868.788, "timestamp": "04:41:08", "text": "Discord。"}, {"type": "subtitle", "time": 16880.31, "timestamp": "04:41:20", "text": "耶。耶。"}, {"type": "subtitle", "time": 16882.948, "timestamp": "04:41:22", "text": "我们走吧。你在这里。"}, {"type": "subtitle", "time": 16884.948, "timestamp": "04:41:24", "text": "你好。"}, {"type": "subtitle", "time": 16889.11, "timestamp": "04:41:29", "text": "哦，等等。我们去推狗吧。糟糕。"}, {"type": "subtitle", "time": 16893.59, "timestamp": "04:41:33", "text": "好的。好的。呃，你好。准备好了。"}, {"type": "subtitle", "time": 16895.75, "timestamp": "04:41:35", "text": "呃，"}, {"type": "subtitle", "time": 16897.67, "timestamp": "04:41:37", "text": "我需要做任何更改吗？你是"}, {"type": "subtitle", "time": 16901.27, "timestamp": "04:41:41", "text": "这款游戏的高手？不，但我有很好的"}, {"type": "subtitle", "time": 16904.23, "timestamp": "04:41:44", "text": "设备很好，所以更好。"}, {"type": "subtitle", "time": 16906.548, "timestamp": "04:41:46", "text": "设备不错，但不太好。"}, {"type": "subtitle", "time": 16909.03, "timestamp": "04:41:49", "text": "哇，你已经42级了。真厉害。是的，我是"}, {"type": "subtitle", "time": 16911.27, "timestamp": "04:41:51", "text": "42级。好久没玩了。"}, {"type": "subtitle", "time": 16913.59, "timestamp": "04:41:53", "text": "玩过。"}, {"type": "subtitle", "time": 16916.788, "timestamp": "04:41:56", "text": "你玩了很多游戏啊？好的。不，不，不"}]
[{"type": "subtitle", "time": 19861.11, "timestamp": "05:31:01", "text": "回来再说吧。我去拿一个"}, {"type": "subtitle", "time": 19863.11, "timestamp": "05:31:03", "text": "休息。我感觉自己状态超级好"}, {"type": "subtitle", "time": 19865.99, "timestamp": "05:31:05", "text": "我现在精疲力竭，我真的不想……"}, {"type": "subtitle", "time": 19869.27, "timestamp": "05:31:09", "text": "想要那个。所以，我要休息一下。所以，"}, {"type": "subtitle", "time": 19876.35, "timestamp": "05:31:16", "text": "[音乐]"}, {"type": "subtitle", "time": 19887.11, "timestamp": "05:31:27", "text": "周六。好的。其中一位客人来自"}, {"type": "subtitle", "time": 19891.468, "timestamp": "05:31:31", "text": "奇马明天已经重新开始了"}, {"type": "subtitle", "time": 19894.708, "timestamp": "05:31:34", "text": "呃，不，不是明天。哦，对，明天我"}, {"type": "subtitle", "time": 19897.03, "timestamp": "05:31:37", "text": "忘了跟各位说了，明天在……"}, {"type": "subtitle", "time": 19900.03, "timestamp": "05:31:40", "text": "上午11点之前，我要去我的"}, {"type": "subtitle", "time": 19902.628, "timestamp": "05:31:42", "text": "学院，日本的学院那玩意儿"}, {"type": "subtitle", "time": 19905.19, "timestamp": "05:31:45", "text": "当地的。所以他们打电话给我和我的家人。"}, {"type": "subtitle", "time": 19907.27, "timestamp": "05:31:47", "text": "那里。我和我爸爸要离开了，"}, {"type": "subtitle", "time": 19909.75, "timestamp": "05:31:49", "text": "所有七月份要去的学生"}, {"type": "subtitle", "time": 19913.19, "timestamp": "05:31:53", "text": "新一批学员明天也将出发。"}, {"type": "subtitle", "time": 19917.19, "timestamp": "05:31:57", "text": "就像他们告诉我们来这里一样。所以，我"}]
[{"type": "subtitle", "time": 6781.19, "timestamp": "01:53:01", "text": "糟糕，我们有钱了。哦，等等。随着"}, {"type": "subtitle", "time": 6784.99, "timestamp": "01:53:04", "text": "只要有硬币，我们就能打开宝箱。"}, {"type": "subtitle", "time": 6788.309, "timestamp": "01:53:08", "text": "哦。哦，我还以为会有20个金币呢。"}, {"type": "subtitle", "time": 6790.23, "timestamp": "01:53:10", "text": "哦，那是好事吗？"}, {"type": "subtitle", "time": 6793.19, "timestamp": "01:53:13", "text": "坏事吗？小猪，我今天想这么做。"}, {"type": "subtitle", "time": 6795.389, "timestamp": "01:53:15", "text": "是时候独占所有"}, {"type": "subtitle", "time": 6798.95, "timestamp": "01:53:18", "text": "抢劫。那是一种能力吗？"}, {"type": "subtitle", "time": 6810.15, "timestamp": "01:53:30", "text": "我猜我跳得更高。或许"}, {"type": "subtitle", "time": 6811.51, "timestamp": "01:53:31", "text": "[音乐]"}, {"type": "subtitle", "time": 6813.51, "timestamp": "01:53:33", "text": "我把所有战利品都拿走了。"}, {"type": "subtitle", "time": 6817.67, "timestamp": "01:53:37", "text": "有趣的。还有，别忘了吃肉。"}, {"type": "subtitle", "time": 6824.07, "timestamp": "01:53:44", "text": "好了。我已经吃饱了。好的，我会的。"}, {"type": "subtitle", "time": 6827.269, "timestamp": "01:53:47", "text": "砍柴。"}, {"type": "subtitle", "time": 6832.309, "timestamp": "01:53:52", "text": "我再从这里拿些吃的。好的。"}, {"type": "subtitle", "time": 6834.23, "timestamp": "01:53:54", "text": "哦，又要天黑了。"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "现在。哦，这里有个小木屋，就像……"}, {"type": "subtitle", "time": 6839.269, "timestamp": "01:53:59", "text": "对面。我们或许会说，哦，"}]
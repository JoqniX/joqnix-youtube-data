[{"type": "subtitle", "time": 16682.43, "timestamp": "04:38:02", "text": "你以前经常在之后过来。"}, {"type": "subtitle", "time": 16684.948, "timestamp": "04:38:04", "text": "冒险。我们和猫玩耍，"}, {"type": "subtitle", "time": 16688.51, "timestamp": "04:38:08", "text": "东西。我不知道为什么我会记得"}, {"type": "subtitle", "time": 16691.628, "timestamp": "04:38:11", "text": "那些。这么长"}, {"type": "subtitle", "time": 16693.99, "timestamp": "04:38:13", "text": "时间。你好，芒果。欢迎来到"}, {"type": "subtitle", "time": 16701.99, "timestamp": "04:38:21", "text": "太多事情了。"}, {"type": "subtitle", "time": 16705.11, "timestamp": "04:38:25", "text": "你好吗？"}, {"type": "subtitle", "time": 16709.19, "timestamp": "04:38:29", "text": "我很好。你好吗？我做得很好。"}, {"type": "subtitle", "time": 16712.31, "timestamp": "04:38:32", "text": "惊人的。我突然莫名其妙地觉得冷，所以"}, {"type": "subtitle", "time": 16714.628, "timestamp": "04:38:34", "text": "我有点流鼻涕，但其他方面没有。"}, {"type": "subtitle", "time": 16717.43, "timestamp": "04:38:37", "text": "除此之外，我就没问题了。是的，我确实有一个"}, {"type": "subtitle", "time": 16722.03, "timestamp": "04:38:42", "text": "今天流鼻涕。哦，不。快点好起来。"}, {"type": "subtitle", "time": 16725.788, "timestamp": "04:38:45", "text": "除此之外，我一切都很好。"}, {"type": "subtitle", "time": 16729.75, "timestamp": "04:38:49", "text": "嗯。很好，我们……我们……"}, {"type": "subtitle", "time": 16732.548, "timestamp": "04:38:52", "text": "能够重新连接并再次交谈。和"}, {"type": "subtitle", "time": 16734.708, "timestamp": "04:38:54", "text": "谢谢你们的光临。真正意味着"}, {"type": "subtitle", "time": 16738.31, "timestamp": "04:38:58", "text": "很多。谢谢。谢谢邀请。"}]
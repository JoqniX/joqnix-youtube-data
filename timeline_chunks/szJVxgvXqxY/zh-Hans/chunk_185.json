[{"type": "subtitle", "time": 11101.91, "timestamp": "03:05:01", "text": "最多？我不知道。我喜欢第一人称射击游戏。"}, {"type": "subtitle", "time": 11104.79, "timestamp": "03:05:04", "text": "东西。这些很有趣。快速的，快节奏的"}, {"type": "subtitle", "time": 11107.59, "timestamp": "03:05:07", "text": "游戏。"}, {"type": "subtitle", "time": 11111.59, "timestamp": "03:05:11", "text": "我不介意角色扮演游戏（RPG）或大型多人在线角色扮演游戏（MMORPG）。"}, {"type": "subtitle", "time": 11114.91, "timestamp": "03:05:14", "text": "也很有趣。少量"}, {"type": "subtitle", "time": 11117.469, "timestamp": "03:05:17", "text": "磨砺。嗯，是的。"}, {"type": "subtitle", "time": 11120.15, "timestamp": "03:05:20", "text": "只要我玩得开心，我就没事。"}, {"type": "subtitle", "time": 11122.389, "timestamp": "03:05:22", "text": "适用于任何游戏。实际上，我没有"}, {"type": "subtitle", "time": 11129.11, "timestamp": "03:05:29", "text": "你最喜欢的故事类型是什么？"}, {"type": "subtitle", "time": 11130.87, "timestamp": "03:05:30", "text": "游戏？"}, {"type": "subtitle", "time": 11133.63, "timestamp": "03:05:33", "text": "故事时间"}, {"type": "subtitle", "time": 11137.349, "timestamp": "03:05:37", "text": "游戏？嗯？故事。我的意思是，原神和"}, {"type": "subtitle", "time": 11140.189, "timestamp": "03:05:40", "text": "所有这些扭蛋游戏都有优点"}, {"type": "subtitle", "time": 11143.51, "timestamp": "03:05:43", "text": "故事。兄弟，我只想玩一个游戏"}, {"type": "subtitle", "time": 11146.309, "timestamp": "03:05:46", "text": "今天是《底特律：成长为男人》。哦，我"}, {"type": "subtitle", "time": 11148.63, "timestamp": "03:05:48", "text": "真的玩过。那就像……"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "我开始直播的时候，我得到了"}]
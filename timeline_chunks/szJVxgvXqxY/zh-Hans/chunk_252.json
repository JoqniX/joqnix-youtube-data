[{"type": "subtitle", "time": 15120.19, "timestamp": "04:12:00", "text": "走了。好吧，绝不"}, {"type": "subtitle", "time": 15128.67, "timestamp": "04:12:08", "text": "我只是"}, {"type": "subtitle", "time": 15131.83, "timestamp": "04:12:11", "text": "停止。我的天啊，你也有"}, {"type": "subtitle", "time": 15134.55, "timestamp": "04:12:14", "text": "问题。 XD，这也是旅程的一部分。"}, {"type": "subtitle", "time": 15137.03, "timestamp": "04:12:17", "text": "这是游戏的一部分。当你尝试的时候"}, {"type": "subtitle", "time": 15140.67, "timestamp": "04:12:20", "text": "玩新游戏，你会遇到问题。"}, {"type": "subtitle", "time": 15142.788, "timestamp": "04:12:22", "text": "是的。如果你还没看过任何一部"}, {"type": "subtitle", "time": 15144.39, "timestamp": "04:12:24", "text": "教程之类的东西，就是这个。"}, {"type": "subtitle", "time": 15146.628, "timestamp": "04:12:26", "text": "事情发生了。但同时，我也不想让自己变成这样。"}, {"type": "subtitle", "time": 15148.75, "timestamp": "04:12:28", "text": "被宠坏。所以，就是这样。"}, {"type": "subtitle", "time": 15150.91, "timestamp": "04:12:30", "text": "美好的。宣布"}, {"type": "subtitle", "time": 15152.948, "timestamp": "04:12:32", "text": "友谊。我会接受你的"}, {"type": "subtitle", "time": 15156.708, "timestamp": "04:12:36", "text": "友谊。但他没有辜负我的信任。"}, {"type": "subtitle", "time": 15159.07, "timestamp": "04:12:39", "text": "你好，"}, {"type": "subtitle", "time": 15162.43, "timestamp": "04:12:42", "text": "再见。呃，发送"}, {"type": "subtitle", "time": 15165.19, "timestamp": "04:12:45", "text": "宣言。您的申报文件已送达​​。"}, {"type": "subtitle", "time": 15167.43, "timestamp": "04:12:47", "text": "向皇后献上你的贡品。这是"}, {"type": "subtitle", "time": 15171.19, "timestamp": "04:12:51", "text": "非常感谢。好的，现在我们开始吧"}, {"type": "subtitle", "time": 15177.51, "timestamp": "04:12:57", "text": "交易。我的报价，他们的报价。哦，我是"}]
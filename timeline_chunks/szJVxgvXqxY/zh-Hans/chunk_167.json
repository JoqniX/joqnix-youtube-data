[{"type": "subtitle", "time": 10022.55, "timestamp": "02:47:02", "text": "团队。什么？"}, {"type": "subtitle", "time": 10024.95, "timestamp": "02:47:04", "text": "对，我们就去参加比赛了。"}, {"type": "subtitle", "time": 10027.269, "timestamp": "02:47:07", "text": "像其他大学一样，如果他们主办的话"}, {"type": "subtitle", "time": 10029.309, "timestamp": "02:47:09", "text": "事件。我们去了"}, {"type": "subtitle", "time": 10032.469, "timestamp": "02:47:12", "text": "我们去看比赛了，然后我"}, {"type": "subtitle", "time": 10034.87, "timestamp": "02:47:14", "text": "这意味着我们一场大战都没赢。"}, {"type": "subtitle", "time": 10038.07, "timestamp": "02:47:18", "text": "但我们确实赢了几场，但那并不是一场胜利。"}, {"type": "subtitle", "time": 10040.29, "timestamp": "02:47:20", "text": "我们其实没那么厉害。"}, {"type": "subtitle", "time": 10048.87, "timestamp": "02:47:28", "text": "好的，我到了。我需要把我的"}, {"type": "subtitle", "time": 10050.87, "timestamp": "02:47:30", "text": "身份证，你知道的。"}, {"type": "subtitle", "time": 10052.87, "timestamp": "02:47:32", "text": "是的，实际上，我认为你应该加上"}, {"type": "subtitle", "time": 10055.67, "timestamp": "02:47:35", "text": "因为我的事情还需要一段时间。"}, {"type": "subtitle", "time": 10062.15, "timestamp": "02:47:42", "text": "是的。嗨，汤姆。哦，是的。请告诉我关于"}, {"type": "subtitle", "time": 10065.03, "timestamp": "02:47:45", "text": "你的名字。你是如何找到你的"}, {"type": "subtitle", "time": 10067.99, "timestamp": "02:47:47", "text": "姓名？汤姆，你是怎么得名的？"}, {"type": "subtitle", "time": 10071.189, "timestamp": "02:47:51", "text": "是的。是什么启发你创作了汤姆"}, {"type": "subtitle", "time": 10075.11, "timestamp": "02:47:55", "text": "还有你的个人形象等等？"}, {"type": "subtitle", "time": 10077.349, "timestamp": "02:47:57", "text": "所以，你认识那位 YouTuber 吗？"}, {"type": "subtitle", "time": 10079.51, "timestamp": "02:47:59", "text": "Dan TDM？"}]
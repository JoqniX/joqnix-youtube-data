[{"type": "subtitle", "time": 1323.03, "timestamp": "00:22:03", "text": "创建你自己的头像。皮克罗，"}, {"type": "subtitle", "time": 1326.709, "timestamp": "00:22:06", "text": "嗯？啊，普鲁。是的。是的。那个，呃，"}, {"type": "subtitle", "time": 1329.229, "timestamp": "00:22:09", "text": "然后你就可以拥有"}, {"type": "subtitle", "time": 1333.189, "timestamp": "00:22:13", "text": "就像上半身像的半身照"}, {"type": "subtitle", "time": 1337.35, "timestamp": "00:22:17", "text": "你创建的个人头像。"}, {"type": "subtitle", "time": 1340.95, "timestamp": "00:22:20", "text": "然后，呃，我在寻找那个人"}, {"type": "subtitle", "time": 1347.189, "timestamp": "00:22:27", "text": "有 CC0 或其他类似的东西，你可以使用它"}, {"type": "subtitle", "time": 1351.189, "timestamp": "00:22:31", "text": "然后我问了那个那个那个"}, {"type": "subtitle", "time": 1353.51, "timestamp": "00:22:33", "text": "艺术家，如果我能把它用在我的 Fit Super 上就好了"}, {"type": "subtitle", "time": 1356.47, "timestamp": "00:22:36", "text": "模型，然后艺术家说哦，是的"}, {"type": "subtitle", "time": 1358.07, "timestamp": "00:22:38", "text": "当然，只要你愿意，你就能做到。"}, {"type": "subtitle", "time": 1360.39, "timestamp": "00:22:40", "text": "只要不用来卖东西就没问题。"}, {"type": "subtitle", "time": 1363.03, "timestamp": "00:22:43", "text": "所以我使用了身体的上半部分。"}, {"type": "subtitle", "time": 1366.709, "timestamp": "00:22:46", "text": "然后我画了底部"}, {"type": "subtitle", "time": 1371.99, "timestamp": "00:22:51", "text": "然后我还……我还……呃，操纵了它……"}]
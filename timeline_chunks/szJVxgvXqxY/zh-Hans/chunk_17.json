[{"type": "subtitle", "time": 1021.99, "timestamp": "00:17:01", "text": "我觉得2020年就到此为止了。"}, {"type": "subtitle", "time": 1024.87, "timestamp": "00:17:04", "text": "我开始安装管道了，我想我开始了"}, {"type": "subtitle", "time": 1029.75, "timestamp": "00:17:09", "text": "2019 年首次在 Twitch 上直播"}, {"type": "subtitle", "time": 1032.79, "timestamp": "00:17:12", "text": "呃，就像一个有抱负的 YouTuber，"}, {"type": "subtitle", "time": 1037.43, "timestamp": "00:17:17", "text": "就像PNG之类的东西一样。呃，2020年"}, {"type": "subtitle", "time": 1039.43, "timestamp": "00:17:19", "text": "九月。是的，9月20日。是的。"}, {"type": "subtitle", "time": 1042.709, "timestamp": "00:17:22", "text": "2020年9月大概就是这样。"}, {"type": "subtitle", "time": 1045.83, "timestamp": "00:17:25", "text": "那些日子是我第一次像开始一样。"}, {"type": "subtitle", "time": 1048.79, "timestamp": "00:17:28", "text": "像这样插到这个管子里。后退"}, {"type": "subtitle", "time": 1050.59, "timestamp": "00:17:30", "text": "那时我还不知道"}, {"type": "subtitle", "time": 1053.55, "timestamp": "00:17:33", "text": "任何人。是的，"}, {"type": "subtitle", "time": 1055.63, "timestamp": "00:17:35", "text": "相同的。"}, {"type": "subtitle", "time": 1058.39, "timestamp": "00:17:38", "text": "所以，调音很有趣。现在，该怎么办？"}, {"type": "subtitle", "time": 1059.95, "timestamp": "00:17:39", "text": "您认为？你吃得怎么样？"}, {"type": "subtitle", "time": 1063.39, "timestamp": "00:17:43", "text": "目前为止的体验如何？"}, {"type": "subtitle", "time": 1066.87, "timestamp": "00:17:46", "text": "呃，不过真的很有趣。是的，我"}, {"type": "subtitle", "time": 1070.75, "timestamp": "00:17:50", "text": "好好享受。那是在某个时候"}, {"type": "subtitle", "time": 1073.35, "timestamp": "00:17:53", "text": "我不知道该怎么办，因为"}, {"type": "subtitle", "time": 1076.709, "timestamp": "00:17:56", "text": "是冷的。"}]
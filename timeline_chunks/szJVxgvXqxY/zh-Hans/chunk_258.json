[{"type": "subtitle", "time": 15481.75, "timestamp": "04:18:01", "text": "食物？"}, {"type": "subtitle", "time": 15484.07, "timestamp": "04:18:04", "text": "哦，不。有机会发展"}, {"type": "subtitle", "time": 15486.23, "timestamp": "04:18:06", "text": "两座城市之间有正式的贸易路线。一个"}, {"type": "subtitle", "time": 15488.788, "timestamp": "04:18:08", "text": "需要交易单元。需要"}, {"type": "subtitle", "time": 15491.03, "timestamp": "04:18:11", "text": "建立这样一条路线，该路线将是"}, {"type": "subtitle", "time": 15494.91, "timestamp": "04:18:14", "text": "每个国家都遵循"}, {"type": "subtitle", "time": 15508.29, "timestamp": "04:18:28", "text": "后退。来"}, {"type": "subtitle", "time": 15526.91, "timestamp": "04:18:46", "text": "什么？"}, {"type": "subtitle", "time": 15529.51, "timestamp": "04:18:49", "text": "军事开放边界。好的，我们走吧"}, {"type": "subtitle", "time": 15535.03, "timestamp": "04:18:55", "text": "我的天啊，我需要对付的敌人也太多了吧。"}]
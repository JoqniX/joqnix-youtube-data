[{"type": "subtitle", "time": 3014.03, "timestamp": "00:50:14", "text": "底部还有另一个人。"}, {"type": "subtitle", "time": 3018.149, "timestamp": "00:50:18", "text": "天哪，我离目标就差一步了。"}, {"type": "subtitle", "time": 3020.149, "timestamp": "00:50:20", "text": "嘿，你的车。"}, {"type": "subtitle", "time": 3040.91, "timestamp": "00:50:40", "text": "还想再体验一次枪林弹雨吗？"}, {"type": "subtitle", "time": 3043.86, "timestamp": "00:50:43", "text": "是的。敌人来了。"}, {"type": "subtitle", "time": 3053.91, "timestamp": "00:50:53", "text": "我上次用的是什么？哦，太多了。"}, {"type": "subtitle", "time": 3056.07, "timestamp": "00:50:56", "text": "许多武器。"}, {"type": "subtitle", "time": 3058.31, "timestamp": "00:50:58", "text": "是霰弹枪。"}]
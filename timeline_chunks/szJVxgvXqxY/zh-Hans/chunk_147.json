[{"type": "subtitle", "time": 8820.309, "timestamp": "02:27:00", "text": "向上。"}, {"type": "subtitle", "time": 8822.469, "timestamp": "02:27:02", "text": "哦，是的，我有。好吧，我只需要杀人"}, {"type": "subtitle", "time": 8825.11, "timestamp": "02:27:05", "text": "然后会有很多事，我会说："}, {"type": "subtitle", "time": 8828.309, "timestamp": "02:27:08", "text": "基本上无敌。"}, {"type": "subtitle", "time": 8832.349, "timestamp": "02:27:12", "text": "你现在已经获得了很多强化道具。"}, {"type": "subtitle", "time": 8835.99, "timestamp": "02:27:15", "text": "是的，那里好像有200个"}, {"type": "subtitle", "time": 8838.87, "timestamp": "02:27:18", "text": "那里还有个金币箱。如果我们能喜欢"}, {"type": "subtitle", "time": 8840.79, "timestamp": "02:27:20", "text": "攒个两三天吧，我觉得"}, {"type": "subtitle", "time": 8844.469, "timestamp": "02:27:24", "text": "我们可以弄一个。"}, {"type": "subtitle", "time": 8848.309, "timestamp": "02:27:28", "text": "好的。呃，好的。我们拿到了金条。呃，"}, {"type": "subtitle", "time": 8851.59, "timestamp": "02:27:31", "text": "你做过任何金制品吗？"}, {"type": "subtitle", "time": 8854.469, "timestamp": "02:27:34", "text": "你能成功吗？我会成功的。"}, {"type": "subtitle", "time": 8855.63, "timestamp": "02:27:35", "text": "好的。"}, {"type": "subtitle", "time": 8859.269, "timestamp": "02:27:39", "text": "镐还是斧子？因为我会做出"}, {"type": "subtitle", "time": 8862.469, "timestamp": "02:27:42", "text": "另一个。这两个都是我自己做的。"}, {"type": "subtitle", "time": 8865.349, "timestamp": "02:27:45", "text": "哦好的。好的。你想分享一下吗？"}, {"type": "subtitle", "time": 8867.429, "timestamp": "02:27:47", "text": "你够了吗？"}, {"type": "subtitle", "time": 8869.59, "timestamp": "02:27:49", "text": "不，我其实还需要一个。"}, {"type": "subtitle", "time": 8873.349, "timestamp": "02:27:53", "text": "我还有很多椅子。"}]
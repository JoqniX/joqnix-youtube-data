[{"type": "subtitle", "time": 14280.788, "timestamp": "03:58:00", "text": "他们去了哪里。"}, {"type": "subtitle", "time": 14284.91, "timestamp": "03:58:04", "text": "这是威尔·罗杰斯说的。好的。我"}, {"type": "subtitle", "time": 14289.03, "timestamp": "03:58:09", "text": "已解锁的牧场营地。允许收割"}, {"type": "subtitle", "time": 14291.99, "timestamp": "03:58:11", "text": "牛、羊和鹿。好的。是"}, {"type": "subtitle", "time": 14294.75, "timestamp": "03:58:14", "text": "那里有羊或鹿吗？比赛结束了"}, {"type": "subtitle", "time": 14298.99, "timestamp": "03:58:18", "text": "这里。哦，我得去那边看看。"}, {"type": "subtitle", "time": 14303.11, "timestamp": "03:58:23", "text": "霍莉有点好奇我是否应该"}, {"type": "subtitle", "time": 14306.07, "timestamp": "03:58:26", "text": "与辛迪亚开战。是的。谁是"}, {"type": "subtitle", "time": 14313.47, "timestamp": "03:58:33", "text": "知道。我是"}, {"type": "subtitle", "time": 14318.03, "timestamp": "03:58:38", "text": "害怕的。安雅，呃，我们走吧"}, {"type": "subtitle", "time": 14319.55, "timestamp": "03:58:39", "text": "到"}, {"type": "subtitle", "time": 14321.4, "timestamp": "03:58:41", "text": "这里"}, {"type": "subtitle", "time": 14322.91, "timestamp": "03:58:42", "text": "[音乐]"}, {"type": "subtitle", "time": 14327.11, "timestamp": "03:58:47", "text": "地方。走开。选择研究。好的。"}, {"type": "subtitle", "time": 14330.55, "timestamp": "03:58:50", "text": "我们可以开展一些新的研究工作。所以，"}]
[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "从这边过来。抓住"}, {"type": "subtitle", "time": 6903.51, "timestamp": "01:55:03", "text": "在。坚持，稍等。让我杀了这家伙。我是"}, {"type": "subtitle", "time": 6908.469, "timestamp": "01:55:08", "text": "1马力。我的天哪。但我用的是惠普电脑。"}, {"type": "subtitle", "time": 6910.71, "timestamp": "01:55:10", "text": "我参加。我参加。我参加。哦，等等。他们"}, {"type": "subtitle", "time": 6912.15, "timestamp": "01:55:12", "text": "可以打破 他们可以 他们可以打破"}, {"type": "subtitle", "time": 6915.75, "timestamp": "01:55:15", "text": "墙壁。什么？"}, {"type": "subtitle", "time": 6919.03, "timestamp": "01:55:19", "text": "是的，他们在破坏墙壁。"}, {"type": "subtitle", "time": 6926.23, "timestamp": "01:55:26", "text": "上帝。糟糕。哦，这下糟了。这是"}, {"type": "subtitle", "time": 6928.389, "timestamp": "01:55:28", "text": "坏的。这很糟糕。哦，吃掉那些东西"}, {"type": "subtitle", "time": 6929.349, "timestamp": "01:55:29", "text": "坩埚。你死定了。"}, {"type": "subtitle", "time": 6930.07, "timestamp": "01:55:30", "text": "你死定了。你要去"}, {"type": "subtitle", "time": 6936.23, "timestamp": "01:55:36", "text": "我身上什么东西都没带。它是"}, {"type": "subtitle", "time": 6937.67, "timestamp": "01:55:37", "text": "它在里面，里面有东西"}, {"type": "subtitle", "time": 6947.11, "timestamp": "01:55:47", "text": "哦，等等。我们是不是用完了“好的，我是……”"}, {"type": "subtitle", "time": 6949.269, "timestamp": "01:55:49", "text": "准备再做点东西。你可以"}, {"type": "subtitle", "time": 6951.59, "timestamp": "01:55:51", "text": "把它拿出来，呃，把肉拿出来。"}]
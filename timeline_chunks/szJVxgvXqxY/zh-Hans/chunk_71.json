[{"type": "subtitle", "time": 4264.87, "timestamp": "01:11:04", "text": "不是为了治愈。"}, {"type": "subtitle", "time": 4274.31, "timestamp": "01:11:14", "text": "你有果汁吗？呃，真的很低，但我会"}, {"type": "subtitle", "time": 4281.229, "timestamp": "01:11:21", "text": "我可以给你果汁吗？哦，等等。这"}, {"type": "subtitle", "time": 4284.39, "timestamp": "01:11:24", "text": "篝火会治愈我们。"}, {"type": "subtitle", "time": 4286.629, "timestamp": "01:11:26", "text": "哦，那里有人。这里有人。"}, {"type": "subtitle", "time": 4289.91, "timestamp": "01:11:29", "text": "糟糕。"}, {"type": "subtitle", "time": 4292.51, "timestamp": "01:11:32", "text": "人很多"}, {"type": "subtitle", "time": 4308.149, "timestamp": "01:11:48", "text": "在我之上的人。我来了。我死了。"}, {"type": "subtitle", "time": 4318.95, "timestamp": "01:11:58", "text": "好的。他在做什么？"}]
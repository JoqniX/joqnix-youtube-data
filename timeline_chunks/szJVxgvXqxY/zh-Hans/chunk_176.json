[{"type": "subtitle", "time": 10561.83, "timestamp": "02:56:01", "text": "我当时就想，我为什么要这么努力呢？"}, {"type": "subtitle", "time": 10563.429, "timestamp": "02:56:03", "text": "很多？"}, {"type": "subtitle", "time": 10566.229, "timestamp": "02:56:06", "text": "让子弹飞吧。"}, {"type": "subtitle", "time": 10568.389, "timestamp": "02:56:08", "text": "我有点希望我更喜欢……"}, {"type": "subtitle", "time": 10569.91, "timestamp": "02:56:09", "text": "YouTube上的东西，而不是像"}, {"type": "subtitle", "time": 10572.51, "timestamp": "02:56:12", "text": "竞争方面"}, {"type": "subtitle", "time": 10576.07, "timestamp": "02:56:16", "text": "瓦尔。我以前玩游戏的时候没直播过。"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "因为我的笔记本电脑真的太糟糕了。"}, {"type": "subtitle", "time": 10581.59, "timestamp": "02:56:21", "text": "那时候。我最近刚买了一个新的"}, {"type": "subtitle", "time": 10583.51, "timestamp": "02:56:23", "text": "笔记本电脑，这就是我开始喜欢它的原因。"}, {"type": "subtitle", "time": 10614.95, "timestamp": "02:56:54", "text": "我走了。"}, {"type": "subtitle", "time": 10617.83, "timestamp": "02:56:57", "text": "我意识到我不是霓虹灯。"}, {"type": "subtitle", "time": 10619.75, "timestamp": "02:56:59", "text": "令人耳目一新。"}]
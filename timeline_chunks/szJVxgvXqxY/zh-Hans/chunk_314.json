[{"type": "subtitle", "time": 18843.11, "timestamp": "05:14:03", "text": "是的，紫外线冷冻。人工智能和鬼魂"}, {"type": "subtitle", "time": 18845.75, "timestamp": "05:14:05", "text": "右上角？三。是的。然后上升。"}, {"type": "subtitle", "time": 18849.56, "timestamp": "05:14:09", "text": "是的。我该去吗？"}, {"type": "subtitle", "time": 18852.35, "timestamp": "05:14:12", "text": "[音乐]"}, {"type": "subtitle", "time": 18858.39, "timestamp": "05:14:18", "text": "嗯，不。"}, {"type": "subtitle", "time": 18862.51, "timestamp": "05:14:22", "text": "哦，不。好的。不，不值得。不是"}, {"type": "subtitle", "time": 18867.67, "timestamp": "05:14:27", "text": "值得。我觉得他又换房间了。"}, {"type": "subtitle", "time": 18870.548, "timestamp": "05:14:30", "text": "哦，不。没关系。他还在。哦，"}, {"type": "subtitle", "time": 18872.548, "timestamp": "05:14:32", "text": "你见过他。"}, {"type": "subtitle", "time": 18885.75, "timestamp": "05:14:45", "text": "移动到。我们走吧。圆圈。是的。是的。我"}, {"type": "subtitle", "time": 18892.708, "timestamp": "05:14:52", "text": "希望它不是仿制品。希望如此。"}, {"type": "subtitle", "time": 18895.27, "timestamp": "05:14:55", "text": "不是模仿者。请不要这样做"}, {"type": "subtitle", "time": 18897.11, "timestamp": "05:14:57", "text": "模仿。"}]
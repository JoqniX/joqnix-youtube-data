[{"type": "subtitle", "time": 18301.91, "timestamp": "05:05:01", "text": "哈。我想应该没有冰冻温度。"}, {"type": "subtitle", "time": 18304.07, "timestamp": "05:05:04", "text": "我们能等一段时间吗？我们等待着"}, {"type": "subtitle", "time": 18327.91, "timestamp": "05:05:27", "text": "那里什么也没有。"}, {"type": "subtitle", "time": 18329.83, "timestamp": "05:05:29", "text": "没有什么。"}, {"type": "subtitle", "time": 18334.51, "timestamp": "05:05:34", "text": "所以是高温造成的，对吧？"}, {"type": "subtitle", "time": 18338.91, "timestamp": "05:05:38", "text": "高温高。温度高。"}, {"type": "subtitle", "time": 18341.75, "timestamp": "05:05:41", "text": "所以天气并不冷。冷冻。是的。"}, {"type": "subtitle", "time": 18354.548, "timestamp": "05:05:54", "text": "切好的肉。"}]
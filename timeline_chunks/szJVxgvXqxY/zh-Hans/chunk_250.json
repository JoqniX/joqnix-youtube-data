[{"type": "subtitle", "time": 15001.708, "timestamp": "04:10:01", "text": "我再也无法凝视那美景了"}, {"type": "subtitle", "time": 15004.55, "timestamp": "04:10:04", "text": "喷溅湖，并享受它们作为"}, {"type": "subtitle", "time": 15007.59, "timestamp": "04:10:07", "text": "我见过的最棒的东西。火山口"}, {"type": "subtitle", "time": 15011.948, "timestamp": "04:10:11", "text": "湖泊凌驾于一切之上。杰克·伦敦。"}, {"type": "subtitle", "time": 15026.07, "timestamp": "04:10:26", "text": "哦，他们在打架。我的一名士兵"}, {"type": "subtitle", "time": 15027.99, "timestamp": "04:10:27", "text": "死了。"}, {"type": "subtitle", "time": 15033.868, "timestamp": "04:10:33", "text": "[音乐]"}, {"type": "subtitle", "time": 15037.03, "timestamp": "04:10:37", "text": "等待。忠诚本身就是一种回报。你"}, {"type": "subtitle", "time": 15040.07, "timestamp": "04:10:40", "text": "不知道？等等，什么？我是否树敌了？"}, {"type": "subtitle", "time": 15041.42, "timestamp": "04:10:41", "text": "她的？哦"}, {"type": "subtitle", "time": 15044.83, "timestamp": "04:10:44", "text": "[音乐]"}, {"type": "subtitle", "time": 15053.19, "timestamp": "04:10:53", "text": "什么？哦，不。不，不，不，不，不，不。"}, {"type": "subtitle", "time": 15055.75, "timestamp": "04:10:55", "text": "不，不，不，不，不，不，不，不，你的"}, {"type": "subtitle", "time": 15057.67, "timestamp": "04:10:57", "text": "占星家的知识进步"}]
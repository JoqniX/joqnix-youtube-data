[{"type": "subtitle", "time": 16200.11, "timestamp": "04:30:00", "text": "三轮车。下一个"}, {"type": "subtitle", "time": 16202.868, "timestamp": "04:30:02", "text": "转身去打架。哦，我杀了我"}, {"type": "subtitle", "time": 16205.27, "timestamp": "04:30:05", "text": "也把它杀了。"}, {"type": "subtitle", "time": 16207.11, "timestamp": "04:30:07", "text": "我们最近获得了先进的"}, {"type": "subtitle", "time": 16209.27, "timestamp": "04:30:09", "text": "城市规划方面的知识。好的。"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "在我们的城市中创建区域可以"}, {"type": "subtitle", "time": 16214.548, "timestamp": "04:30:14", "text": "比……更强大、更有利可图"}, {"type": "subtitle", "time": 16216.788, "timestamp": "04:30:16", "text": "简单的改进措施，例如农场和"}, {"type": "subtitle", "time": 16224.15, "timestamp": "04:30:24", "text": "一座城市必须先扩大其人口规模。"}, {"type": "subtitle", "time": 16227.23, "timestamp": "04:30:27", "text": "它可以构建多个"}, {"type": "subtitle", "time": 16236.07, "timestamp": "04:30:36", "text": "好的。点击区域并构建"}, {"type": "subtitle", "time": 16237.75, "timestamp": "04:30:37", "text": "放置。好的。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 16240.23, "timestamp": "04:30:40", "text": "知道了。占星术。我们走吧。我们得到了"}, {"type": "subtitle", "time": 16243.47, "timestamp": "04:30:43", "text": "占星学研究。接下来会"}, {"type": "subtitle", "time": 16250.23, "timestamp": "04:30:50", "text": "写作。好的。对，就是这个人。什么会"}, {"type": "subtitle", "time": 16251.948, "timestamp": "04:30:51", "text": "我愿意"}, {"type": "subtitle", "time": 16254.83, "timestamp": "04:30:54", "text": "你？如果我"}, {"type": "subtitle", "time": 16257.948, "timestamp": "04:30:57", "text": "[音乐]"}]
[{"type": "subtitle", "time": 1771.43, "timestamp": "00:29:31", "text": "寻求。那是什么？招财猫矿。哦，"}, {"type": "subtitle", "time": 1774.55, "timestamp": "00:29:34", "text": "那就像一颗近程地雷。是的。"}, {"type": "subtitle", "time": 1786.91, "timestamp": "00:29:46", "text": "我找到车了。"}, {"type": "subtitle", "time": 1797.03, "timestamp": "00:29:57", "text": "你已经有盔甲了吗？我确实有盔甲。"}]
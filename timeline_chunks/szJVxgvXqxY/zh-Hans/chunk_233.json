[{"type": "subtitle", "time": 13980.19, "timestamp": "03:53:00", "text": "到。等等，这些人是谁？"}, {"type": "subtitle", "time": 13986.03, "timestamp": "03:53:06", "text": "重播"}, {"type": "subtitle", "time": 13988.788, "timestamp": "03:53:08", "text": "你真是个好朋友。他们将拥有"}, {"type": "subtitle", "time": 13993.91, "timestamp": "03:53:13", "text": "哦，还得等等。有"}, {"type": "subtitle", "time": 13996.948, "timestamp": "03:53:16", "text": "本游戏中的对话。什么？你会"}, {"type": "subtitle", "time": 14005.43, "timestamp": "03:53:25", "text": "非常好。"}, {"type": "subtitle", "time": 14007.35, "timestamp": "03:53:27", "text": "再见。"}, {"type": "subtitle", "time": 14009.11, "timestamp": "03:53:29", "text": "看来我们终于追踪到了。"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "肆虐这些地区的蛮族劫掠者"}, {"type": "subtitle", "time": 14014.31, "timestamp": "03:53:34", "text": "土地回到它们的源头。我们必须摧毁"}, {"type": "subtitle", "time": 14018.07, "timestamp": "03:53:38", "text": "坚守据点，否则将面临未来遭受攻击的风险。"}, {"type": "subtitle", "time": 14020.51, "timestamp": "03:53:40", "text": "请详细说说。"}, {"type": "subtitle", "time": 14022.788, "timestamp": "03:53:42", "text": "野蛮人来自前哨站，这可能"}, {"type": "subtitle", "time": 14024.788, "timestamp": "03:53:44", "text": "随机出现在任何图块中"}, {"type": "subtitle", "time": 14026.948, "timestamp": "03:53:46", "text": "可能在任何单元中看到。每个野蛮人单位"}, {"type": "subtitle", "time": 14029.43, "timestamp": "03:53:49", "text": "属于家园哨站。共有三个"}]
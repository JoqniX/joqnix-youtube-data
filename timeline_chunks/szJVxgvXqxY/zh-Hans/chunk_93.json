[{"type": "subtitle", "time": 5583.349, "timestamp": "01:33:03", "text": "在 YouTube、Twitch 等平台上关注她。"}, {"type": "subtitle", "time": 5584.429, "timestamp": "01:33:04", "text": "还"}, {"type": "subtitle", "time": 5586.83, "timestamp": "01:33:06", "text": "Instagram 和"}, {"type": "subtitle", "time": 5590.07, "timestamp": "01:33:10", "text": "她会浏览推特，然后去上班。"}, {"type": "subtitle", "time": 5596.91, "timestamp": "01:33:16", "text": "谢谢你今天抽出时间。我玩得很开心。"}, {"type": "subtitle", "time": 5600.87, "timestamp": "01:33:20", "text": "哦，你好。呃，请给我一分钟时间。呃，让"}, {"type": "subtitle", "time": 5603.99, "timestamp": "01:33:23", "text": "我只是，呃，更新一下缩略图。我"}, {"type": "subtitle", "time": 5607.67, "timestamp": "01:33:27", "text": "忘记放第三位嘉宾的缩略图了。"}, {"type": "subtitle", "time": 5610.75, "timestamp": "01:33:30", "text": "呃，接下来是……"}, {"type": "subtitle", "time": 5613.59, "timestamp": "01:33:33", "text": "托图姆。我们将演奏《Muk》。呃，之前"}, {"type": "subtitle", "time": 5615.99, "timestamp": "01:33:35", "text": "我把托图姆叫进来，让我更新一下情况。"}, {"type": "subtitle", "time": 5619.19, "timestamp": "01:33:39", "text": "快速制作YouTube缩略图。"}, {"type": "subtitle", "time": 5621.83, "timestamp": "01:33:41", "text": "我昨天睡过头了，把这事忘了。"}, {"type": "subtitle", "time": 5623.83, "timestamp": "01:33:43", "text": "总结最后三期"}, {"type": "subtitle", "time": 5626.07, "timestamp": "01:33:46", "text": "天。所以，我今天得这样写。"}, {"type": "subtitle", "time": 5629.87, "timestamp": "01:33:49", "text": "出色地。所以是四。哦，是的。好的。让"}, {"type": "subtitle", "time": 5633.51, "timestamp": "01:33:53", "text": "我把他们放进去了。你好。我会给你打电话。"}, {"type": "subtitle", "time": 5635.67, "timestamp": "01:33:55", "text": "稍等片刻。一秒钟。我们将从……开始"}]
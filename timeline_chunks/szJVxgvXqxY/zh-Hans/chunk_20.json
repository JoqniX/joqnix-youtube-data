[{"type": "subtitle", "time": 1200.709, "timestamp": "00:20:00", "text": "是版主吧？不。是的，模组类型"}, {"type": "subtitle", "time": 1203.11, "timestamp": "00:20:03", "text": "化身。"}, {"type": "subtitle", "time": 1205.35, "timestamp": "00:20:05", "text": "太酷了！人们是怎么做到的？"}, {"type": "subtitle", "time": 1212.51, "timestamp": "00:20:12", "text": "我不知道。"}, {"type": "subtitle", "time": 1215.79, "timestamp": "00:20:15", "text": "哦，是啊，太酷了。"}, {"type": "subtitle", "time": 1220.55, "timestamp": "00:20:20", "text": "现在我也对你的模型很感兴趣。"}, {"type": "subtitle", "time": 1223.189, "timestamp": "00:20:23", "text": "既然你会画画，那这幅画就是你自己画的。"}, {"type": "subtitle", "time": 1225.51, "timestamp": "00:20:25", "text": "画画之类的。"}, {"type": "subtitle", "time": 1229.189, "timestamp": "00:20:29", "text": "哦，是的，我做了。我做了。你的主题是什么？"}, {"type": "subtitle", "time": 1232.229, "timestamp": "00:20:32", "text": "尽管？我没有，我没有正确地"}, {"type": "subtitle", "time": 1235.43, "timestamp": "00:20:35", "text": "已确认。我"}, {"type": "subtitle", "time": 1239.59, "timestamp": "00:20:39", "text": "呃，嗯，我是一块石头。"}, {"type": "subtitle", "time": 1242.07, "timestamp": "00:20:42", "text": "受到女神的祝福，然后我转身"}, {"type": "subtitle", "time": 1246.39, "timestamp": "00:20:46", "text": "变成一个人类女孩。一个"}, {"type": "subtitle", "time": 1250.229, "timestamp": "00:20:50", "text": "因为因为呃，还有阿祖拉的名字"}, {"type": "subtitle", "time": 1254.11, "timestamp": "00:20:54", "text": "Lapis Azura 的意思是像蓝色"}, {"type": "subtitle", "time": 1257.669, "timestamp": "00:20:57", "text": "而且，而且，而且青金石是石头。所以就像"}]
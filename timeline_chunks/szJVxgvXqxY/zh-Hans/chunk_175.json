[{"type": "subtitle", "time": 10500.63, "timestamp": "02:55:00", "text": "秒。真是太烦人了。就像它"}, {"type": "subtitle", "time": 10502.15, "timestamp": "02:55:02", "text": "以前的比赛总是持续一整场比赛。"}, {"type": "subtitle", "time": 10503.99, "timestamp": "02:55:03", "text": "小时。比如一小时一场比赛或一个"}, {"type": "subtitle", "time": 10511.75, "timestamp": "02:55:11", "text": "是的。所以我感觉自己对工作筋疲力尽了。"}, {"type": "subtitle", "time": 10514.87, "timestamp": "02:55:14", "text": "停止播放了。"}, {"type": "subtitle", "time": 10522.469, "timestamp": "02:55:22", "text": "我也开始变得像个小矮人"}, {"type": "subtitle", "time": 10524.469, "timestamp": "02:55:24", "text": "也有点毒性。所以我就说：“不，"}, {"type": "subtitle", "time": 10526.15, "timestamp": "02:55:26", "text": "就这些了。我不想这样"}, {"type": "subtitle", "time": 10536.07, "timestamp": "02:55:36", "text": "嗯。这些游戏就像你……"}, {"type": "subtitle", "time": 10543.83, "timestamp": "02:55:43", "text": "是的，有时候它会影响你的心理健康。"}, {"type": "subtitle", "time": 10546.229, "timestamp": "02:55:46", "text": "它功能很多。"}, {"type": "subtitle", "time": 10549.349, "timestamp": "02:55:49", "text": "这也是我不玩的原因。"}, {"type": "subtitle", "time": 10551.75, "timestamp": "02:55:51", "text": "竞争非常激烈。我过去常常"}, {"type": "subtitle", "time": 10554.03, "timestamp": "02:55:54", "text": "Fortnite之类的东西拿走吧"}, {"type": "subtitle", "time": 10556.95, "timestamp": "02:55:56", "text": "认真对待那些单人现金上限和"}, {"type": "subtitle", "time": 10558.87, "timestamp": "02:55:58", "text": "所有那些东西"}]
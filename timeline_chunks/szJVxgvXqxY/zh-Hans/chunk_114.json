[{"type": "subtitle", "time": 6841.91, "timestamp": "01:54:01", "text": "我们应该直接来这里。我们没有"}, {"type": "subtitle", "time": 6849.19, "timestamp": "01:54:09", "text": "哦，不。"}, {"type": "subtitle", "time": 6851.67, "timestamp": "01:54:11", "text": "我真希望我能和他们一起住这些小木屋"}, {"type": "subtitle", "time": 6855.91, "timestamp": "01:54:15", "text": "我。不，不是小木屋，是墙壁。"}, {"type": "subtitle", "time": 6858.07, "timestamp": "01:54:18", "text": "是的。"}, {"type": "subtitle", "time": 6863.4, "timestamp": "01:54:23", "text": "令人遗憾。"}, {"type": "subtitle", "time": 6872.309, "timestamp": "01:54:32", "text": "是的。好的。啊，我当时为什么要那样做？巴卡"}, {"type": "subtitle", "time": 6873.83, "timestamp": "01:54:33", "text": "笨蛋 笨蛋。我的天啊。没关系。它是"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "我觉得会有东西出现。"}, {"type": "subtitle", "time": 6884.389, "timestamp": "01:54:44", "text": "是的。"}, {"type": "subtitle", "time": 6887.91, "timestamp": "01:54:47", "text": "你身后。你身后。你身后。"}, {"type": "subtitle", "time": 6888.83, "timestamp": "01:54:48", "text": "在后面"}, {"type": "subtitle", "time": 6898.309, "timestamp": "01:54:58", "text": "我觉得他把我锁在外面了。嗯。哦，不。"}]
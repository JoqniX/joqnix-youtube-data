[{"type": "subtitle", "time": 11887.67, "timestamp": "03:18:07", "text": "无人机坠毁了。快要出来了。那里"}, {"type": "subtitle", "time": 11905.189, "timestamp": "03:18:25", "text": "120 凤凰城。他可能已经痊愈了。一"}, {"type": "subtitle", "time": 11928.71, "timestamp": "03:18:48", "text": "重新装弹。"}, {"type": "subtitle", "time": 11931.189, "timestamp": "03:18:51", "text": "为什么尤达会GG？等等，他们要去吗？"}, {"type": "subtitle", "time": 11933.429, "timestamp": "03:18:53", "text": "会死吗？等等，他拿走了吗？"}, {"type": "subtitle", "time": 11936.63, "timestamp": "03:18:56", "text": "破碎的？因为他觉得……"}, {"type": "subtitle", "time": 11938.469, "timestamp": "03:18:58", "text": "他们要输了。他必须来。"}]
[{"type": "subtitle", "time": 12181.91, "timestamp": "03:23:01", "text": "你好。我的天哪。什么？我现在该怎么办？"}, {"type": "subtitle", "time": 12183.83, "timestamp": "03:23:03", "text": "我不知道为什么会有轻量级的二维效果"}, {"type": "subtitle", "time": 12184.34, "timestamp": "03:23:04", "text": "不"}, {"type": "subtitle", "time": 12186.67, "timestamp": "03:23:06", "text": "[音乐]"}, {"type": "subtitle", "time": 12189.59, "timestamp": "03:23:09", "text": "工作。我还能做些什么？我还能做些什么？"}, {"type": "subtitle", "time": 12193.429, "timestamp": "03:23:13", "text": "要不要提起这件事？嗯，其实我不知道。"}, {"type": "subtitle", "time": 12196.149, "timestamp": "03:23:16", "text": "但问题是，它确实会显现出来。"}, {"type": "subtitle", "time": 12198.71, "timestamp": "03:23:18", "text": "屏幕。比如，如果我进入过滤器，它"}, {"type": "subtitle", "time": 12201.99, "timestamp": "03:23:21", "text": "确实显示它在那里。但事实并非如此"}, {"type": "subtitle", "time": 12204.71, "timestamp": "03:23:24", "text": "看起来像"}, {"type": "subtitle", "time": 12207.75, "timestamp": "03:23:27", "text": "呃，似乎没有出现在场景中。我"}, {"type": "subtitle", "time": 12210.389, "timestamp": "03:23:30", "text": "不知道为什么。冷吗？天气热吗？"}, {"type": "subtitle", "time": 12212.63, "timestamp": "03:23:32", "text": "你那里冷吗？天气冷。是的，它"}, {"type": "subtitle", "time": 12213.95, "timestamp": "03:23:33", "text": "是"}, {"type": "subtitle", "time": 12217.71, "timestamp": "03:23:37", "text": "寒冷的。天气冷。一直在下雨。"}, {"type": "subtitle", "time": 12222.51, "timestamp": "03:23:42", "text": "最近情况严重。天气一直很冷。"}, {"type": "subtitle", "time": 12224.99, "timestamp": "03:23:44", "text": "寒冷的？"}, {"type": "subtitle", "time": 12228.389, "timestamp": "03:23:48", "text": "是的。是啊，天气很冷。寒冷的。"}, {"type": "subtitle", "time": 12230.71, "timestamp": "03:23:50", "text": "好了。现在它出现了。好的，"}, {"type": "subtitle", "time": 12234.63, "timestamp": "03:23:54", "text": "好，好，好。让我把他叫上来。"}, {"type": "subtitle", "time": 12235.79, "timestamp": "03:23:55", "text": "在那里"}, {"type": "subtitle", "time": 12238.429, "timestamp": "03:23:58", "text": "去。圣哉上帝。"}]
[{"type": "subtitle", "time": 6540.15, "timestamp": "01:49:00", "text": "工作台。小心点。知道了。"}, {"type": "subtitle", "time": 6542.389, "timestamp": "01:49:02", "text": "哦，好像有个小妖精正朝我们走过来。"}, {"type": "subtitle", "time": 6544.429, "timestamp": "01:49:04", "text": "我。有两个"}, {"type": "subtitle", "time": 6548.07, "timestamp": "01:49:08", "text": "他们。哦，等等。它会朝我发射东西。"}, {"type": "subtitle", "time": 6561.03, "timestamp": "01:49:21", "text": "我把大楼搞砸了。"}, {"type": "subtitle", "time": 6571.03, "timestamp": "01:49:31", "text": "没关系。没关系。"}, {"type": "subtitle", "time": 6573.55, "timestamp": "01:49:33", "text": "我的天啊。又生成了一个。是"}, {"type": "subtitle", "time": 6578.23, "timestamp": "01:49:38", "text": "小心。我会保护你。"}, {"type": "subtitle", "time": 6584.309, "timestamp": "01:49:44", "text": "哦，原来是你啊。好的。好的。好的。为什么"}, {"type": "subtitle", "time": 6598.75, "timestamp": "01:49:58", "text": "好的。将会是"}]
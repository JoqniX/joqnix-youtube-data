[{"type": "subtitle", "time": 13023.51, "timestamp": "03:37:03", "text": "我该怎么做？我该怎么做？哦，好的。结束了"}, {"type": "subtitle", "time": 13026.709, "timestamp": "03:37:06", "text": "这里。隐私。不，不，不，不。这一切都是"}, {"type": "subtitle", "time": 13029.15, "timestamp": "03:37:09", "text": "不是这边。我的天啊。"}, {"type": "subtitle", "time": 13032.59, "timestamp": "03:37:12", "text": "呃，关于微软"}, {"type": "subtitle", "time": 13035.67, "timestamp": "03:37:15", "text": "边缘。如何将 Microsoft Edge 设置为我的浏览器？"}, {"type": "subtitle", "time": 13038.07, "timestamp": "03:37:18", "text": "默认？我有点喜欢 H 默认浏览器。"}, {"type": "subtitle", "time": 13039.91, "timestamp": "03:37:19", "text": "知道了。知道了。知道了。知道了。知道了。"}, {"type": "subtitle", "time": 13044.15, "timestamp": "03:37:24", "text": "设为默认值。好了，现在我关闭游戏。"}, {"type": "subtitle", "time": 13045.789, "timestamp": "03:37:25", "text": "并尝试重新启动"}, {"type": "subtitle", "time": 13049.949, "timestamp": "03:37:29", "text": "它。希望如此。"}, {"type": "subtitle", "time": 13053.67, "timestamp": "03:37:33", "text": "工作。这就是为什么人们可能知道你这样做的原因。"}, {"type": "subtitle", "time": 13058.23, "timestamp": "03:37:38", "text": "不要安装 Brave 测试版"}, {"type": "subtitle", "time": 13060.91, "timestamp": "03:37:40", "text": "浏览器。它永远不会"}, {"type": "subtitle", "time": 13065.029, "timestamp": "03:37:45", "text": "工作。好了。成功了。交换"}, {"type": "subtitle", "time": 13069.83, "timestamp": "03:37:49", "text": "制作，呃，制作 Epic Games，我的不制作"}, {"type": "subtitle", "time": 13073.59, "timestamp": "03:37:53", "text": "呃，这个东西正在制作……呃，微软Edge浏览器"}, {"type": "subtitle", "time": 13076.51, "timestamp": "03:37:56", "text": "我的默认浏览器可以正常工作。哦，我的"}, {"type": "subtitle", "time": 13079.07, "timestamp": "03:37:59", "text": "上帝，"}]
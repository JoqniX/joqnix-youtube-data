[{"type": "subtitle", "time": 3189.189, "timestamp": "00:53:09", "text": "哦，那些人已经着陆了。是的，"}, {"type": "subtitle", "time": 3195.669, "timestamp": "00:53:15", "text": "当心。还有一个队"}, {"type": "subtitle", "time": 3204.39, "timestamp": "00:53:24", "text": "是的，有一套蓝色盔甲。我没有"}, {"type": "subtitle", "time": 3205.47, "timestamp": "00:53:25", "text": "枪支"}, {"type": "subtitle", "time": 3210.149, "timestamp": "00:53:30", "text": "尽管。我该如何进去？哦，给你。"}, {"type": "subtitle", "time": 3232.87, "timestamp": "00:53:52", "text": "哦，有人。我的天啊。有 有"}, {"type": "subtitle", "time": 3234.189, "timestamp": "00:53:54", "text": "三分之一"}, {"type": "subtitle", "time": 3236.229, "timestamp": "00:53:56", "text": "派对。躲起来。躲起来。我只是"}, {"type": "subtitle", "time": 3237.99, "timestamp": "00:53:57", "text": "隐藏。这边有人在疗伤。"}]
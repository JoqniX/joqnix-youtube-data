[{"type": "subtitle", "time": 10623.429, "timestamp": "02:57:03", "text": "我正努力奔跑，然后我就想，"}, {"type": "subtitle", "time": 10627.59, "timestamp": "02:57:07", "text": "有三个人正在朝我开枪。"}, {"type": "subtitle", "time": 10629.91, "timestamp": "02:57:09", "text": "你在说什么？我正在尝试运行"}, {"type": "subtitle", "time": 10642.71, "timestamp": "02:57:22", "text": "不收取任何费用。"}, {"type": "subtitle", "time": 10679.429, "timestamp": "02:57:59", "text": "我的天啊。我玩这个游戏超级菜"}]
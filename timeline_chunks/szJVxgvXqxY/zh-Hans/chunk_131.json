[{"type": "subtitle", "time": 7862.87, "timestamp": "02:11:02", "text": "等等，这个不能用来做汤。"}, {"type": "subtitle", "time": 7865.19, "timestamp": "02:11:05", "text": "什么？"}, {"type": "subtitle", "time": 7869.429, "timestamp": "02:11:09", "text": "我的天啊。呃，炉子。你在哪里？"}, {"type": "subtitle", "time": 7873.19, "timestamp": "02:11:13", "text": "哦，你成功了。是的。如何出售？"}, {"type": "subtitle", "time": 7875.87, "timestamp": "02:11:15", "text": "我的天哪。"}, {"type": "subtitle", "time": 7879.63, "timestamp": "02:11:19", "text": "好的。燃料蘑菇。"}, {"type": "subtitle", "time": 7886.5, "timestamp": "02:11:26", "text": "上帝。我会做一个"}, {"type": "subtitle", "time": 7888.67, "timestamp": "02:11:28", "text": "[音乐]"}, {"type": "subtitle", "time": 7892.03, "timestamp": "02:11:32", "text": "鸽子。什么？你甚至都不能"}, {"type": "subtitle", "time": 7894.469, "timestamp": "02:11:34", "text": "好的。你可以用它制作一些东西"}, {"type": "subtitle", "time": 7898.349, "timestamp": "02:11:38", "text": "这里。好的。但你不能。"}, {"type": "subtitle", "time": 7901.19, "timestamp": "02:11:41", "text": "好的。什么？"}, {"type": "subtitle", "time": 7903.91, "timestamp": "02:11:43", "text": "什么？ WHO？ WHO？我的天啊。不，我打中了"}, {"type": "subtitle", "time": 7905.67, "timestamp": "02:11:45", "text": "村民们。我袭击了村民。他们"}, {"type": "subtitle", "time": 7909.11, "timestamp": "02:11:49", "text": "夹在中间。哦，不。"}, {"type": "subtitle", "time": 7911.269, "timestamp": "02:11:51", "text": "哦，如果我杀了你，我可以让你复活。"}, {"type": "subtitle", "time": 7913.59, "timestamp": "02:11:53", "text": "这几个家伙。"}, {"type": "subtitle", "time": 7915.67, "timestamp": "02:11:55", "text": "我觉得我做不到。我死了。"}, {"type": "subtitle", "time": 7918.309, "timestamp": "02:11:58", "text": "我想念你，兄弟。他们出现在前面，就像……"}]
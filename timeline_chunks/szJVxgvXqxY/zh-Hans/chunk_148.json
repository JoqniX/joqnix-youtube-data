[{"type": "subtitle", "time": 8881.83, "timestamp": "02:28:01", "text": "金子。哦，金色的头盔和裤子"}, {"type": "subtitle", "time": 8893.03, "timestamp": "02:28:13", "text": "是的。呃，你还需要一根金条吗？"}, {"type": "subtitle", "time": 8894.63, "timestamp": "02:28:14", "text": "或者您需要什么？我需要一个"}, {"type": "subtitle", "time": 8899.71, "timestamp": "02:28:19", "text": "更多金条。呃，拿"}, {"type": "subtitle", "time": 8916.59, "timestamp": "02:28:36", "text": "我们需要"}, {"type": "subtitle", "time": 8919.83, "timestamp": "02:28:39", "text": "是啊，我会给我们做一些箱子。"}, {"type": "subtitle", "time": 8925.83, "timestamp": "02:28:45", "text": "是的。嗯，已经有一个箱子了。"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "我希望他们不能摧毁宝箱，因为那样……"}, {"type": "subtitle", "time": 8939.75, "timestamp": "02:28:59", "text": "会非常烦人。"}]
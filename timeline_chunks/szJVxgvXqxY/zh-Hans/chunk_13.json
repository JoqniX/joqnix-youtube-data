[{"type": "subtitle", "time": 814.95, "timestamp": "00:13:34", "text": "好的。大家好。欢迎来到"}, {"type": "subtitle", "time": 819.27, "timestamp": "00:13:39", "text": "Joathon 第 90 天。所以我们从……开始。"}, {"type": "subtitle", "time": 823.55, "timestamp": "00:13:43", "text": "我们的第一位客人。我们有阿祖兰。"}, {"type": "subtitle", "time": 826.189, "timestamp": "00:13:46", "text": "阿祖拉。"}, {"type": "subtitle", "time": 830.03, "timestamp": "00:13:50", "text": "你好。你好，库拉。"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "卡祖尔。你好。你好。我的名字叫阿祖尔。"}, {"type": "subtitle", "time": 836.79, "timestamp": "00:13:56", "text": "我已经很久没上线了"}]
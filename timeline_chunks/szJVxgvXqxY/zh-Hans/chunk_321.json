[{"type": "subtitle", "time": 19265.27, "timestamp": "05:21:05", "text": "天气冷极了。"}, {"type": "subtitle", "time": 19269.67, "timestamp": "05:21:09", "text": "哦，是的。冷冻。我能看到你的呼吸。"}, {"type": "subtitle", "time": 19296.23, "timestamp": "05:21:36", "text": "H. 没有，没有，没有信号。在哪里？"}, {"type": "subtitle", "time": 19302.75, "timestamp": "05:21:42", "text": "不，没有绝育箱。"}]
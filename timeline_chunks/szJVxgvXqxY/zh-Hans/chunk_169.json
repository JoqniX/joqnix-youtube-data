[{"type": "subtitle", "time": 10146.15, "timestamp": "02:49:06", "text": "[音乐]"}, {"type": "subtitle", "time": 10148.79, "timestamp": "02:49:08", "text": "好的，你什么时候上车告诉我一声。"}, {"type": "subtitle", "time": 10155.51, "timestamp": "02:49:15", "text": "完成了。好的，稍等一下。为什么是我"}, {"type": "subtitle", "time": 10157.229, "timestamp": "02:49:17", "text": "我没收到你的消息"}, {"type": "subtitle", "time": 10160.309, "timestamp": "02:49:20", "text": "耳机？好的。您能再说一遍吗？"}, {"type": "subtitle", "time": 10165.389, "timestamp": "02:49:25", "text": "你好。是的。好的，继续说。"}, {"type": "subtitle", "time": 10168.07, "timestamp": "02:49:28", "text": "嗯，你好。你好吗？我的天啊。哦"}, {"type": "subtitle", "time": 10191.59, "timestamp": "02:49:51", "text": "我的天哪，娜特在指责我，因为"}, {"type": "subtitle", "time": 10193.189, "timestamp": "02:49:53", "text": "我告诉他我永远不会玩。"}, {"type": "subtitle", "time": 10195.429, "timestamp": "02:49:55", "text": "我又在玩《Valerant》了。"}]
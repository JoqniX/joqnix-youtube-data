[{"type": "subtitle", "time": 7260.319, "timestamp": "02:01:00", "text": "外部。我死了。我的天哪，我要走了 到"}, {"type": "subtitle", "time": 7267.429, "timestamp": "02:01:07", "text": "死。他们可以朝你扔东西。我"}, {"type": "subtitle", "time": 7275.67, "timestamp": "02:01:15", "text": "没有手提袋放下。不，不，不。我的“为什么”是什么？"}, {"type": "subtitle", "time": 7278.63, "timestamp": "02:01:18", "text": "我的弓箭射不出去吗？"}, {"type": "subtitle", "time": 7282.07, "timestamp": "02:01:22", "text": "你做了一个弓。是的，我尝试过了"}, {"type": "subtitle", "time": 7283.83, "timestamp": "02:01:23", "text": "赚钱，但似乎并非如此"}, {"type": "subtitle", "time": 7291.11, "timestamp": "02:01:31", "text": "凭借神明的力量，我们能得到"}, {"type": "subtitle", "time": 7293.51, "timestamp": "02:01:33", "text": "重生？是吗？"}, {"type": "subtitle", "time": 7294.87, "timestamp": "02:01:34", "text": "我不认为，我不认为有"}, {"type": "subtitle", "time": 7296.23, "timestamp": "02:01:36", "text": "重生。我们必须开始整个"}, {"type": "subtitle", "time": 7297.41, "timestamp": "02:01:37", "text": "又是这件事。"}, {"type": "subtitle", "time": 7298.75, "timestamp": "02:01:38", "text": "[音乐]"}, {"type": "subtitle", "time": 7303.51, "timestamp": "02:01:43", "text": "哇。这简直太硬核了。我认为"}, {"type": "subtitle", "time": 7307.269, "timestamp": "02:01:47", "text": "这是。我会把大厅密码给你。"}, {"type": "subtitle", "time": 7309.429, "timestamp": "02:01:49", "text": "再次。"}, {"type": "subtitle", "time": 7312.11, "timestamp": "02:01:52", "text": "好的。"}, {"type": "subtitle", "time": 7314.51, "timestamp": "02:01:54", "text": "有趣的。"}]
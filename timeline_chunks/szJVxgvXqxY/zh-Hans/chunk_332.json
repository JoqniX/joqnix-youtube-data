[{"type": "subtitle", "time": 19921.708, "timestamp": "05:32:01", "text": "我希望……我有点担心……"}, {"type": "subtitle", "time": 19925.59, "timestamp": "05:32:05", "text": "因为其中一个同学"}, {"type": "subtitle", "time": 19928.23, "timestamp": "05:32:08", "text": "应该是同批次的同学"}, {"type": "subtitle", "time": 19930.548, "timestamp": "05:32:10", "text": "应该和我一起去"}, {"type": "subtitle", "time": 19934.708, "timestamp": "05:32:14", "text": "他们说，下个月对他们来说就像……"}, {"type": "subtitle", "time": 19937.91, "timestamp": "05:32:17", "text": "一些拥车证（COE）因此被推迟了。"}, {"type": "subtitle", "time": 19942.39, "timestamp": "05:32:22", "text": "对他来说，他们到七月份就走不了了。"}, {"type": "subtitle", "time": 19945.67, "timestamp": "05:32:25", "text": "他们会是吗？他只能是"}, {"type": "subtitle", "time": 19948.868, "timestamp": "05:32:28", "text": "明年四月之前去日本上学"}, {"type": "subtitle", "time": 19953.43, "timestamp": "05:32:33", "text": "年。所以，我有点担心如果"}, {"type": "subtitle", "time": 19956.23, "timestamp": "05:32:36", "text": "呃，如果这一切都毫无意义的话"}, {"type": "subtitle", "time": 19958.548, "timestamp": "05:32:38", "text": "在此刻。就像我以为我是"}, {"type": "subtitle", "time": 19960.788, "timestamp": "05:32:40", "text": "计划七月份入学。所以，这就是我的原因。"}, {"type": "subtitle", "time": 19964.15, "timestamp": "05:32:44", "text": "参加了 Jockathon 之类的活动。我很好"}, {"type": "subtitle", "time": 19966.868, "timestamp": "05:32:46", "text": "再做一年Joathon挑战赛"}, {"type": "subtitle", "time": 19969.43, "timestamp": "05:32:49", "text": "直到四月。我对此没意见，因为"}, {"type": "subtitle", "time": 19971.51, "timestamp": "05:32:51", "text": "再说一遍，我能直播的日子越多越好。"}]
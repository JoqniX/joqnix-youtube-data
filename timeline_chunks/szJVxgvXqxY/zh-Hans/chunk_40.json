[{"type": "subtitle", "time": 2400.83, "timestamp": "00:40:00", "text": "聊天。那可把我吓坏了。哦，我的"}, {"type": "subtitle", "time": 2405.709, "timestamp": "00:40:05", "text": "上帝。是的，我们没有，我们没有"}, {"type": "subtitle", "time": 2410.189, "timestamp": "00:40:10", "text": "意识到我不知道"}, {"type": "subtitle", "time": 2413.51, "timestamp": "00:40:13", "text": "哦，原来上面那个东西在那里。极好的"}, {"type": "subtitle", "time": 2425.149, "timestamp": "00:40:25", "text": "什么是"}, {"type": "subtitle", "time": 2428.91, "timestamp": "00:40:28", "text": "这？迪格尔"}, {"type": "subtitle", "time": 2430.91, "timestamp": "00:40:30", "text": "H. 小心。"}, {"type": "subtitle", "time": 2442.83, "timestamp": "00:40:42", "text": "在哪里？"}, {"type": "subtitle", "time": 2446.229, "timestamp": "00:40:46", "text": "大家的？我觉得我"}, {"type": "subtitle", "time": 2449.59, "timestamp": "00:40:49", "text": "我必须向上走。呃，这个"}, {"type": "subtitle", "time": 2451.109, "timestamp": "00:40:51", "text": "事物。"}, {"type": "subtitle", "time": 2453.99, "timestamp": "00:40:53", "text": "这是什么？什么是"}, {"type": "subtitle", "time": 2456.149, "timestamp": "00:40:56", "text": "我听到有人说话？我不知道。把它做出来"}]
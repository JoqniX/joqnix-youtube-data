[{"type": "subtitle", "time": 10380.309, "timestamp": "02:53:00", "text": "不，我是钻石一号。你是什​​么"}, {"type": "subtitle", "time": 10383.429, "timestamp": "02:53:03", "text": "意思是？上面写着PL。哦，哦，对不起，对不起。"}, {"type": "subtitle", "time": 10384.63, "timestamp": "02:53:04", "text": "对不起。那是另一个人。对不起，"}, {"type": "subtitle", "time": 10389.75, "timestamp": "02:53:09", "text": "对不起，对不起。钻石一号。那可真不少。"}, {"type": "subtitle", "time": 10392.229, "timestamp": "02:53:12", "text": "我之前感觉自己像升华了一样，但后来我"}, {"type": "subtitle", "time": 10394.95, "timestamp": "02:53:14", "text": "没怎么玩，所以我就回去了"}, {"type": "subtitle", "time": 10407.59, "timestamp": "02:53:27", "text": "哦，有人选中了我的里昂。"}, {"type": "subtitle", "time": 10411.11, "timestamp": "02:53:31", "text": "我有的是时间。"}, {"type": "subtitle", "time": 10413.469, "timestamp": "02:53:33", "text": "你指的是哪个角色？"}, {"type": "subtitle", "time": 10417.51, "timestamp": "02:53:37", "text": "最多？嗯，就我大学球队而言，我以前……"}, {"type": "subtitle", "time": 10420.95, "timestamp": "02:53:40", "text": "像操作手柄一样玩。就像我会那样"}, {"type": "subtitle", "time": 10423.429, "timestamp": "02:53:43", "text": "玩法类似 Omen、Viper，或者任何类似的东西"}, {"type": "subtitle", "time": 10425.67, "timestamp": "02:53:45", "text": "团队需求。但就像在比赛中一样，我只是"}, {"type": "subtitle", "time": 10427.83, "timestamp": "02:53:47", "text": "我想玩什么就玩什么。就像更多"}, {"type": "subtitle", "time": 10430.389, "timestamp": "02:53:50", "text": "我扮演的角色越出色。喜欢"}, {"type": "subtitle", "time": 10431.99, "timestamp": "02:53:51", "text": "如果我坚持塑造一个角色，我就会有点……"}, {"type": "subtitle", "time": 10435.11, "timestamp": "02:53:55", "text": "感觉筋疲力尽，然后我就……我喜欢"}, {"type": "subtitle", "time": 10437.75, "timestamp": "02:53:57", "text": "开始打得很烂。我只是随便选一个"}, {"type": "subtitle", "time": 10439.59, "timestamp": "02:53:59", "text": "每局游戏随机角色，或者我"}]
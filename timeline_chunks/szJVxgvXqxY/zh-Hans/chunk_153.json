[{"type": "subtitle", "time": 9180.55, "timestamp": "02:33:00", "text": "击中，呃，击中，处理厚重的东西"}, {"type": "chat", "time": 9180.558, "timestamp": "02:33:00", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "and she gone to the abyss"}, {"type": "subtitle", "time": 9188.229, "timestamp": "02:33:08", "text": "你拿到金子了吗？"}, {"type": "subtitle", "time": 9193.75, "timestamp": "02:33:13", "text": "我有一根金条。哦。呃，你"}, {"type": "subtitle", "time": 9195.91, "timestamp": "02:33:15", "text": "你买镐了吗？还是你买了什么？"}, {"type": "subtitle", "time": 9197.91, "timestamp": "02:33:17", "text": "买？这边有黄金。我只能"}, {"type": "subtitle", "time": 9201.11, "timestamp": "02:33:21", "text": "把它种下去。我既有镐也有金子"}, {"type": "subtitle", "time": 9203.11, "timestamp": "02:33:23", "text": "斧头。"}, {"type": "subtitle", "time": 9204.95, "timestamp": "02:33:24", "text": "金斧。好的。好的。我会带"}, {"type": "subtitle", "time": 9208.349, "timestamp": "02:33:28", "text": "给你和我们一些黄金"}, {"type": "subtitle", "time": 9211.75, "timestamp": "02:33:31", "text": "他们能否尽可能多地获取煤炭？"}, {"type": "subtitle", "time": 9212.83, "timestamp": "02:33:32", "text": "我们"}, {"type": "subtitle", "time": 9216.59, "timestamp": "02:33:36", "text": "能。把它放进伪造品里吧"}, {"type": "subtitle", "time": 9221.11, "timestamp": "02:33:41", "text": "炉子。我会收集很多呃"}, {"type": "subtitle", "time": 9224.469, "timestamp": "02:33:44", "text": "我们需要金子来为所有人打造盔甲。"}, {"type": "chat", "time": 9225.909, "timestamp": "02:33:45", "author": "@Totembtw", "avatar": "https://yt4.ggpht.com/hioaXnlAE2bO9zkq1LR7obAzNHeT2CyJQVDqLyLs1xpQtflZ50pJJfeodntXZC_QCm0VDoyEgA=s64-c-k-c0x00ffffff-no-rj", "message": "ello"}, {"type": "subtitle", "time": 9227.91, "timestamp": "02:33:47", "text": "我们中的一些人。好的。我认为我们不应该"}, {"type": "subtitle", "time": 9229.349, "timestamp": "02:33:49", "text": "直接跳过金甲部分就好。或许"}, {"type": "subtitle", "time": 9232.389, "timestamp": "02:33:52", "text": "或许直接去钢铁厂吧。我们能得到"}, {"type": "subtitle", "time": 9234.71, "timestamp": "02:33:54", "text": "那里有钢材吗？哦，是的。我们如何获得"}, {"type": "subtitle", "time": 9236.63, "timestamp": "02:33:56", "text": "又是钢铁？"}, {"type": "subtitle", "time": 9239.349, "timestamp": "02:33:59", "text": "我觉得是铁质的缘故。呃，让我……我快烧起来了。"}]
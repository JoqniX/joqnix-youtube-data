[{"type": "subtitle", "time": 9602.229, "timestamp": "02:40:02", "text": "是的，我也这么认为。"}, {"type": "subtitle", "time": 9606.229, "timestamp": "02:40:06", "text": "我处境很糟糕。没有合适的"}, {"type": "subtitle", "time": 9611.75, "timestamp": "02:40:11", "text": "这里。我的天，暴徒们已经来了"}, {"type": "subtitle", "time": 9623.71, "timestamp": "02:40:23", "text": "地狱？我做了个嘘声"}, {"type": "subtitle", "time": 9627.91, "timestamp": "02:40:27", "text": "嘘。我挑起了一场战斗。最终Boss战。"}, {"type": "subtitle", "time": 9650.63, "timestamp": "02:40:50", "text": "现在。你知道吗？我不能"}, {"type": "subtitle", "time": 9652.71, "timestamp": "02:40:52", "text": "呃，我正在努力获得黄金，但是没有。"}]
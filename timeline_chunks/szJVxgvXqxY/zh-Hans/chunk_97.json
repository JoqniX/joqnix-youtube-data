[{"type": "subtitle", "time": 5820.87, "timestamp": "01:37:00", "text": "[音乐]"}, {"type": "subtitle", "time": 5823.389, "timestamp": "01:37:03", "text": "你好。"}, {"type": "subtitle", "time": 5827.51, "timestamp": "01:37:07", "text": "哈拉姆。你好吗？我的天啊。"}, {"type": "subtitle", "time": 5830.27, "timestamp": "01:37:10", "text": "我很好。你好吗？我正在做"}, {"type": "subtitle", "time": 5834.63, "timestamp": "01:37:14", "text": "伟大的。 Tatam的儿子今天过得怎么样？"}, {"type": "subtitle", "time": 5839.27, "timestamp": "01:37:19", "text": "我真的很累。我之前有份工作，比如"}, {"type": "subtitle", "time": 5840.87, "timestamp": "01:37:20", "text": "我早上还要上班，所以……"}, {"type": "subtitle", "time": 5842.63, "timestamp": "01:37:22", "text": "开完会后我就睡觉了。"}, {"type": "subtitle", "time": 5845.349, "timestamp": "01:37:25", "text": "我又醒了，现在才刚起床。我"}, {"type": "subtitle", "time": 5848.87, "timestamp": "01:37:28", "text": "知道。我希望你像生锈的木头人一样。"}, {"type": "subtitle", "time": 5851.429, "timestamp": "01:37:31", "text": "如果有人告诉我我可能已经喜欢上了"}, {"type": "subtitle", "time": 5853.83, "timestamp": "01:37:33", "text": "调整了时间。你本可以说"}, {"type": "subtitle", "time": 5856.79, "timestamp": "01:37:36", "text": "那。没关系。没关系。我不应该"}, {"type": "subtitle", "time": 5859.03, "timestamp": "01:37:39", "text": "比如睡太久，因为我的睡眠"}, {"type": "subtitle", "time": 5861.429, "timestamp": "01:37:41", "text": "日程安排又要被打乱了。"}, {"type": "subtitle", "time": 5865.51, "timestamp": "01:37:45", "text": "我注意到你睡得很晚。"}, {"type": "subtitle", "time": 5867.11, "timestamp": "01:37:47", "text": "哇。"}, {"type": "subtitle", "time": 5870.389, "timestamp": "01:37:50", "text": "我大概凌晨四五点才睡。"}, {"type": "subtitle", "time": 5872.63, "timestamp": "01:37:52", "text": "昨天。"}, {"type": "subtitle", "time": 5875.309, "timestamp": "01:37:55", "text": "是的。再见。那是"}, {"type": "subtitle", "time": 5877.87, "timestamp": "01:37:57", "text": "疯狂的。哦，我的"}]
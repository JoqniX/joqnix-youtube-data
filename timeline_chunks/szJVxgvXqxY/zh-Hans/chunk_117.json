[{"type": "subtitle", "time": 7021.67, "timestamp": "01:57:01", "text": "木制工具不好用。"}, {"type": "subtitle", "time": 7027.269, "timestamp": "01:57:07", "text": "我认为你可能需要直接前往"}, {"type": "subtitle", "time": 7033.74, "timestamp": "01:57:13", "text": "呃，可能是金属乐吧。我不知道。"}, {"type": "subtitle", "time": 7039.19, "timestamp": "01:57:19", "text": "那真是太蠢了，他们居然喜欢我"}, {"type": "subtitle", "time": 7042.23, "timestamp": "01:57:22", "text": "像这样把两堵墙并排砌起来。"}, {"type": "subtitle", "time": 7044.79, "timestamp": "01:57:24", "text": "橱柜在哪里？"}, {"type": "subtitle", "time": 7058.389, "timestamp": "01:57:38", "text": "你得好好养伤。你情绪很低落。"}, {"type": "subtitle", "time": 7060.71, "timestamp": "01:57:40", "text": "是的。"}, {"type": "subtitle", "time": 7064.309, "timestamp": "01:57:44", "text": "我再做点吃的。不。关闭"}, {"type": "subtitle", "time": 7066.79, "timestamp": "01:57:46", "text": "关掉。"}, {"type": "subtitle", "time": 7069.19, "timestamp": "01:57:49", "text": "我们需要做一扇门才能进去。"}, {"type": "subtitle", "time": 7071.19, "timestamp": "01:57:51", "text": "然后出去。"}, {"type": "subtitle", "time": 7077.23, "timestamp": "01:57:57", "text": "让我看看。门门，"}]
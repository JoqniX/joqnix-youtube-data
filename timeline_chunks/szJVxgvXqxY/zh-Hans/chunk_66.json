[{"type": "subtitle", "time": 3964.709, "timestamp": "01:06:04", "text": "哦，我摔倒了。我下去了。不。不。"}, {"type": "subtitle", "time": 3967.99, "timestamp": "01:06:07", "text": "哦，是利伊河的那些狐狸。那些"}, {"type": "subtitle", "time": 3969.91, "timestamp": "01:06:09", "text": "出汗。"}, {"type": "subtitle", "time": 3977.03, "timestamp": "01:06:17", "text": "不，"}, {"type": "subtitle", "time": 3979.55, "timestamp": "01:06:19", "text": "我们收获颇丰。三级"}, {"type": "subtitle", "time": 3984.31, "timestamp": "01:06:24", "text": "盔甲。是的，我当然受到了伤害。"}, {"type": "subtitle", "time": 3985.31, "timestamp": "01:06:25", "text": "经过"}, {"type": "subtitle", "time": 3986.83, "timestamp": "01:06:26", "text": "其他"}, {"type": "subtitle", "time": 3999.669, "timestamp": "01:06:39", "text": "香蕉。香蕉。"}, {"type": "subtitle", "time": 4017.99, "timestamp": "01:06:57", "text": "那么，你这一轮的策略是什么？"}, {"type": "subtitle", "time": 4019.91, "timestamp": "01:06:59", "text": "你想在哪里降落？你可以"}]
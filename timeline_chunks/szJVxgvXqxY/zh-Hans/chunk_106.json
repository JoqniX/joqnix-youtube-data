[{"type": "subtitle", "time": 6363.349, "timestamp": "01:46:03", "text": "我不种这棵树吗？哦，"}, {"type": "subtitle", "time": 6364.83, "timestamp": "01:46:04", "text": "欢迎"}, {"type": "subtitle", "time": 6401.429, "timestamp": "01:46:41", "text": "哦，我现在得发传真了。啊，我们得做一件事"}, {"type": "subtitle", "time": 6404.71, "timestamp": "01:46:44", "text": "现在发生了很多事。天哪，为什么会这样？"}, {"type": "subtitle", "time": 6409.83, "timestamp": "01:46:49", "text": "哦，这里有能量棒。我没有"}, {"type": "subtitle", "time": 6412.95, "timestamp": "01:46:52", "text": "意识到。嗯，我们挂断了。哦，是的。"}, {"type": "subtitle", "time": 6417.03, "timestamp": "01:46:57", "text": "哦，是时候消灭那些家伙了。"}, {"type": "subtitle", "time": 6418.83, "timestamp": "01:46:58", "text": "牛。"}]
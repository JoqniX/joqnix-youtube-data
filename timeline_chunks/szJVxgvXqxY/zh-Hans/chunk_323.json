[{"type": "subtitle", "time": 19394.788, "timestamp": "05:23:14", "text": "去。你在哪里？我的天啊。不旋转。"}, {"type": "subtitle", "time": 19397.43, "timestamp": "05:23:17", "text": "没有光球。"}, {"type": "subtitle", "time": 19401.67, "timestamp": "05:23:21", "text": "我们应该追求极致吗？"}, {"type": "subtitle", "time": 19404.07, "timestamp": "05:23:24", "text": "是的，我已经放进去了。这"}, {"type": "subtitle", "time": 19425.51, "timestamp": "05:23:45", "text": "你在楼上等。"}, {"type": "subtitle", "time": 19428.23, "timestamp": "05:23:48", "text": "是的。好的。等我。等我。"}, {"type": "subtitle", "time": 19431.75, "timestamp": "05:23:51", "text": "停留。停留。待在那儿。待在那儿。"}, {"type": "subtitle", "time": 19434.23, "timestamp": "05:23:54", "text": "它发出哔哔声。它发出哔哔声。"}, {"type": "subtitle", "time": 19438.788, "timestamp": "05:23:58", "text": "什么哔哔声？是三、四还是五？"}]
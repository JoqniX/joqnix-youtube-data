[{"type": "subtitle", "time": 4527.51, "timestamp": "01:15:27", "text": "哦，该死的混蛋。太远了。"}, {"type": "subtitle", "time": 4530.069, "timestamp": "01:15:30", "text": "是的。"}, {"type": "subtitle", "time": 4531.589, "timestamp": "01:15:31", "text": "哦。"}, {"type": "subtitle", "time": 4534.79, "timestamp": "01:15:34", "text": "哦，原来是你想要的。我该怎么走？不，不"}, {"type": "subtitle", "time": 4545.47, "timestamp": "01:15:45", "text": "那里有。那是一个"}, {"type": "subtitle", "time": 4548.55, "timestamp": "01:15:48", "text": "马格南。嘿，这里有个关卡"}]
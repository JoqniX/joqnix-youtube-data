[{"type": "subtitle", "time": 14820.788, "timestamp": "04:07:00", "text": "普通淋浴间……等等，别这样"}, {"type": "subtitle", "time": 14822.948, "timestamp": "04:07:02", "text": "它们就像是在洗涤自己。"}, {"type": "subtitle", "time": 14826.948, "timestamp": "04:07:06", "text": "河流偶尔会流淌吗？我认为他们会的。"}, {"type": "subtitle", "time": 14829.51, "timestamp": "04:07:09", "text": "正确的？我想他们等等，他们真的会吗？"}, {"type": "subtitle", "time": 14830.67, "timestamp": "04:07:10", "text": "做，"}, {"type": "subtitle", "time": 14841.23, "timestamp": "04:07:21", "text": "那我该怎么办？"}, {"type": "subtitle", "time": 14843.868, "timestamp": "04:07:23", "text": "尽管？使困惑"}, {"type": "subtitle", "time": 14847.07, "timestamp": "04:07:27", "text": "噪音。购买"}, {"type": "subtitle", "time": 14856.39, "timestamp": "04:07:36", "text": "选择？单位需求。你知道吗？美好的。"}, {"type": "chat", "time": 14864.568, "timestamp": "04:07:44", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "doxx him harder"}, {"type": "subtitle", "time": 14869.43, "timestamp": "04:07:49", "text": "哦，这位是谁？我们发现了一个"}, {"type": "subtitle", "time": 14871.91, "timestamp": "04:07:51", "text": "城邦。城市国家。建立"}, {"type": "subtitle", "time": 14874.23, "timestamp": "04:07:54", "text": "与他们的外交关系将"}, {"type": "subtitle", "time": 14877.11, "timestamp": "04:07:57", "text": "这肯定对我们的帝国有利。"}, {"type": "subtitle", "time": 14878.868, "timestamp": "04:07:58", "text": "或许我们应该派个使者过去。"}]
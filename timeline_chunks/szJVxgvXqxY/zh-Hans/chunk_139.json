[{"type": "subtitle", "time": 8345.51, "timestamp": "02:19:05", "text": "多少钱？呃，试着弄到呃，用……"}, {"type": "subtitle", "time": 8354.79, "timestamp": "02:19:14", "text": "好的。牛奶。我不知道。它的作用是什么？"}, {"type": "subtitle", "time": 8356.269, "timestamp": "02:19:16", "text": "做？强的"}, {"type": "subtitle", "time": 8360.389, "timestamp": "02:19:20", "text": "骨头。什么？哦，是啊。有一个"}, {"type": "subtitle", "time": 8363.269, "timestamp": "02:19:23", "text": "暴击几率。如果你按下 Tab 键，"}, {"type": "subtitle", "time": 8365.03, "timestamp": "02:19:25", "text": "目前我们有10%的概率。"}, {"type": "subtitle", "time": 8366.71, "timestamp": "02:19:26", "text": "我想你可以通过以下方式改进它："}, {"type": "subtitle", "time": 8385.75, "timestamp": "02:19:45", "text": "哦，饥饿条真让人痛苦。"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "我不明白我们如何才能变得更好。"}, {"type": "subtitle", "time": 8396.11, "timestamp": "02:19:56", "text": "你有木头吗？"}, {"type": "subtitle", "time": 8399.59, "timestamp": "02:19:59", "text": "我……哦，没关系。我得到了一份日志"}]
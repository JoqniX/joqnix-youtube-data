[{"type": "subtitle", "time": 9429.269, "timestamp": "02:37:09", "text": "发生了。哦好的。我希望我不会输"}, {"type": "subtitle", "time": 9431.51, "timestamp": "02:37:11", "text": "我的东西。我的天哪，我觉得他们"}, {"type": "subtitle", "time": 9432.51, "timestamp": "02:37:12", "text": "打破"}, {"type": "subtitle", "time": 9436.11, "timestamp": "02:37:16", "text": "我的天哪，后面有人！"}, {"type": "subtitle", "time": 9438.55, "timestamp": "02:37:18", "text": "这里。我不会失去我的能力，但我"}, {"type": "subtitle", "time": 9443.03, "timestamp": "02:37:23", "text": "我猜我的东西都丢了。"}, {"type": "subtitle", "time": 9446.269, "timestamp": "02:37:26", "text": "我失去了一切。哦，我死了。我是"}, {"type": "subtitle", "time": 9453.11, "timestamp": "02:37:33", "text": "存活。存活。存活。生存"}, {"type": "subtitle", "time": 9455.75, "timestamp": "02:37:35", "text": "你可以。"}, {"type": "subtitle", "time": 9458.309, "timestamp": "02:37:38", "text": "我的天啊，旁边居然有个魔像！"}, {"type": "subtitle", "time": 9462.309, "timestamp": "02:37:42", "text": "我们。就像对吧"}, {"type": "subtitle", "time": 9464.95, "timestamp": "02:37:44", "text": "活下去就好。只要能活下去就行了。"}, {"type": "subtitle", "time": 9467.91, "timestamp": "02:37:47", "text": "你可以。慢慢来。是的。如果我可以"}, {"type": "subtitle", "time": 9469.99, "timestamp": "02:37:49", "text": "把那些血量低的家伙都干掉。"}, {"type": "subtitle", "time": 9473.67, "timestamp": "02:37:53", "text": "那样我就能获得更多HP了。"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "好的。呃，稳妥为上。稳妥为上。"}]
[{"type": "subtitle", "time": 5880.63, "timestamp": "01:38:00", "text": "上帝。我甚至不记得我是什么时候开始的了"}, {"type": "subtitle", "time": 5885.79, "timestamp": "01:38:05", "text": "昨天。大概就在那时。我"}, {"type": "subtitle", "time": 5890.15, "timestamp": "01:38:10", "text": "我猜我当时就像在尝试……"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "安排他人的日程安排"}, {"type": "subtitle", "time": 5895.51, "timestamp": "01:38:15", "text": "然后我就拍手叫走了。"}, {"type": "subtitle", "time": 5898.429, "timestamp": "01:38:18", "text": "大约就在那时，我在 I 上看到了你"}, {"type": "subtitle", "time": 5901.59, "timestamp": "01:38:21", "text": "相信。你昨天收到我的私信了吗？"}, {"type": "subtitle", "time": 5905.03, "timestamp": "01:38:25", "text": "夜晚？是吗？我忘了。呃，我没有"}, {"type": "subtitle", "time": 5907.11, "timestamp": "01:38:27", "text": "我也这么认为。不，我没有。我没有。好的。"}, {"type": "subtitle", "time": 5910.309, "timestamp": "01:38:30", "text": "好的。但我确实看见你了，我确实看见你了"}, {"type": "subtitle", "time": 5912.67, "timestamp": "01:38:32", "text": "是"}, {"type": "subtitle", "time": 5916.87, "timestamp": "01:38:36", "text": "我的天哪。我们没有交互器。我们"}, {"type": "subtitle", "time": 5918.95, "timestamp": "01:38:38", "text": "自从那以后，我们就再也没有互动过。"}, {"type": "subtitle", "time": 5922.55, "timestamp": "01:38:42", "text": "是动漫展吧？是的。"}, {"type": "subtitle", "time": 5925.11, "timestamp": "01:38:45", "text": "很高兴见到你。审判"}, {"type": "subtitle", "time": 5928.95, "timestamp": "01:38:48", "text": "男人。感觉不错。"}, {"type": "subtitle", "time": 5930.95, "timestamp": "01:38:50", "text": "是的。我可能会去孟买之类的地方。"}, {"type": "subtitle", "time": 5934.79, "timestamp": "01:38:54", "text": "明年再见，就像之前的漫展一样。啊，其实"}, {"type": "subtitle", "time": 5937.429, "timestamp": "01:38:57", "text": "孟买动漫展。好的。好的。那是"}, {"type": "subtitle", "time": 5939.83, "timestamp": "01:38:59", "text": "好的。那挺好的。"}]
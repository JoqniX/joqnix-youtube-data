[{"type": "subtitle", "time": 11948.71, "timestamp": "03:19:08", "text": "但他并不抱有期望。"}, {"type": "subtitle", "time": 11950.95, "timestamp": "03:19:10", "text": "我的终极技能已经准备好了。哦，刚刚被杀了"}, {"type": "subtitle", "time": 11953.37, "timestamp": "03:19:13", "text": "他自己。"}, {"type": "subtitle", "time": 11954.95, "timestamp": "03:19:14", "text": "[音乐]"}, {"type": "subtitle", "time": 11957.99, "timestamp": "03:19:17", "text": "我的天啊。好的。妈妈，他是在大喊大叫吗？"}, {"type": "subtitle", "time": 11960.469, "timestamp": "03:19:20", "text": "问我要不要吃？是的。是的。是的。你可以"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "我们可以到此为止了。是的。对不起。"}, {"type": "subtitle", "time": 11966.469, "timestamp": "03:19:26", "text": "不用担心。不用担心。再次感谢。"}, {"type": "subtitle", "time": 11969.03, "timestamp": "03:19:29", "text": "今天就到这里。我很高兴有你陪伴。"}, {"type": "subtitle", "time": 11971.349, "timestamp": "03:19:31", "text": "在这里，这是我们第一次合作。"}, {"type": "subtitle", "time": 11974.71, "timestamp": "03:19:34", "text": "没错吧？谢谢。谢谢。感谢"}, {"type": "subtitle", "time": 11976.87, "timestamp": "03:19:36", "text": "谢谢你邀请我。你有"}, {"type": "subtitle", "time": 11978.309, "timestamp": "03:19:38", "text": "在你之前你想说的任何事情"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "离开？呃，订阅讨论并点赞"}, {"type": "subtitle", "time": 11984.07, "timestamp": "03:19:44", "text": "溪流。"}, {"type": "subtitle", "time": 11987.91, "timestamp": "03:19:47", "text": "大家快去订阅他们吧。谢谢。"}, {"type": "subtitle", "time": 11990.55, "timestamp": "03:19:50", "text": "再见。你好。再见。小心。拿"}, {"type": "subtitle", "time": 11993.03, "timestamp": "03:19:53", "text": "关心。祝你一切顺利。好好吃饭。拿"}, {"type": "subtitle", "time": 11994.71, "timestamp": "03:19:54", "text": "关心。"}, {"type": "subtitle", "time": 11997.95, "timestamp": "03:19:57", "text": "再见。再见。再见。你好。"}]
[{"type": "subtitle", "time": 6302.32, "timestamp": "01:45:02", "text": "2019年。"}, {"type": "subtitle", "time": 6304.87, "timestamp": "01:45:04", "text": "[音乐]"}, {"type": "subtitle", "time": 6315.349, "timestamp": "01:45:15", "text": "我记得，这有点难。"}, {"type": "subtitle", "time": 6318.75, "timestamp": "01:45:18", "text": "其实我挺喜欢夜晚的。"}, {"type": "subtitle", "time": 6322.309, "timestamp": "01:45:22", "text": "啊，会有丧尸之类的东西吗？"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "是的，我想"}, {"type": "subtitle", "time": 6328.07, "timestamp": "01:45:28", "text": "就像《我的世界》的生存模式一样。必须"}, {"type": "subtitle", "time": 6332.349, "timestamp": "01:45:32", "text": "逐个建造。不。呃，就像……"}, {"type": "subtitle", "time": 6335.75, "timestamp": "01:45:35", "text": "房子，然后去做。你好，娜蒂基。欢迎"}, {"type": "subtitle", "time": 6337.429, "timestamp": "01:45:37", "text": "在。"}, {"type": "subtitle", "time": 6343.99, "timestamp": "01:45:43", "text": "我做了一张工作台。我是说"}, {"type": "subtitle", "time": 6346.55, "timestamp": "01:45:46", "text": "游戏中的工作台。"}, {"type": "subtitle", "time": 6357.99, "timestamp": "01:45:57", "text": "我猜它们是跟着棕榈树走的。为什么可以"}]
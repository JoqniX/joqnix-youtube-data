[{"type": "subtitle", "time": 4929.11, "timestamp": "01:22:09", "text": "今天我们差点赢了一场，我们"}, {"type": "subtitle", "time": 4933.11, "timestamp": "01:22:13", "text": "差点就进前五了，大概四五名吧。"}, {"type": "subtitle", "time": 4936.469, "timestamp": "01:22:16", "text": "次数。是的。是的。是的。"}, {"type": "subtitle", "time": 4941.03, "timestamp": "01:22:21", "text": "然后我们被一枚手榴弹炸死了。"}, {"type": "subtitle", "time": 4957.59, "timestamp": "01:22:37", "text": "更多的。哦，卖玉米棒棒糖的家伙来了。"}, {"type": "subtitle", "time": 4975.27, "timestamp": "01:22:55", "text": "棒棒糖玉米。看，是卖鸡的。"}, {"type": "subtitle", "time": 4978.67, "timestamp": "01:22:58", "text": "那真是太可爱了"}]
[{"type": "subtitle", "time": 14107.39, "timestamp": "03:55:07", "text": "[音乐]"}, {"type": "subtitle", "time": 14113.27, "timestamp": "03:55:13", "text": "呃，下一轮。他们要去哪里？ H，"}, {"type": "subtitle", "time": 14115.91, "timestamp": "03:55:15", "text": "我已寄给你一份列车申报单。呃，"}, {"type": "subtitle", "time": 14120.43, "timestamp": "03:55:20", "text": "建造一个装饰好的。呃，你有……"}, {"type": "subtitle", "time": 14124.35, "timestamp": "03:55:24", "text": "弓？你确实有一把弓。"}, {"type": "subtitle", "time": 14127.11, "timestamp": "03:55:27", "text": "是的。呃，你的装饰最"}, {"type": "subtitle", "time": 14130.15, "timestamp": "03:55:30", "text": "欢迎。出色的。我会让她……"}, {"type": "subtitle", "time": 14133.11, "timestamp": "03:55:33", "text": "醒来后，我一定会让她成为我的朋友。"}, {"type": "subtitle", "time": 14139.99, "timestamp": "03:55:39", "text": "我害怕杀人。哦，她们等等，她"}, {"type": "subtitle", "time": 14142.91, "timestamp": "03:55:42", "text": "信使离开了。"}, {"type": "subtitle", "time": 14145.31, "timestamp": "03:55:45", "text": "什么？好吧，他们"}, {"type": "subtitle", "time": 14148.628, "timestamp": "03:55:48", "text": "左边。你好，乔。你能去吗？你能吗？"}, {"type": "subtitle", "time": 14153.35, "timestamp": "03:55:53", "text": "可以叫你乔吗？开玩笑？什么？是"}, {"type": "subtitle", "time": 14155.07, "timestamp": "03:55:55", "text": "那是乔妈妈"}, {"type": "subtitle", "time": 14159.35, "timestamp": "03:55:59", "text": "开玩笑？我的天啊。我的天啊。"}]
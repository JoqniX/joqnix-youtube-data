[{"type": "subtitle", "time": 8041.349, "timestamp": "02:14:01", "text": "我。哇。我觉得你可以这样做"}, {"type": "subtitle", "time": 8044.55, "timestamp": "02:14:04", "text": "它来自任何地方。但是，嗯，当你去世的时候，"}, {"type": "subtitle", "time": 8046.79, "timestamp": "02:14:06", "text": "上面说我可以走近你，"}, {"type": "subtitle", "time": 8050.229, "timestamp": "02:14:10", "text": "然后重生。我喜欢……呃，让你复活。哦，"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "我不知道在这个游戏里怎么打出暴击。"}, {"type": "subtitle", "time": 8065.429, "timestamp": "02:14:25", "text": "有时如果你注意到了，你确实会进行批评。"}, {"type": "subtitle", "time": 8068.229, "timestamp": "02:14:28", "text": "我的世界暴击。我觉得可能是"}, {"type": "subtitle", "time": 8071.269, "timestamp": "02:14:31", "text": "比如，你可能打出了一个暴击"}, {"type": "subtitle", "time": 8074.16, "timestamp": "02:14:34", "text": "可能有暴击几率。"}, {"type": "subtitle", "time": 8076.63, "timestamp": "02:14:36", "text": "[音乐]"}, {"type": "subtitle", "time": 8085.59, "timestamp": "02:14:45", "text": "案件。好的。还差得远呢"}, {"type": "subtitle", "time": 8088.269, "timestamp": "02:14:48", "text": "夜间，所以这很好"}, {"type": "subtitle", "time": 8090.87, "timestamp": "02:14:50", "text": "至少。哦，那里有个村庄。"}, {"type": "subtitle", "time": 8092.229, "timestamp": "02:14:52", "text": "对面。我们不要建造"}, {"type": "subtitle", "time": 8094.55, "timestamp": "02:14:54", "text": "这里什么都有。是的。是的，我们可以走了"}]
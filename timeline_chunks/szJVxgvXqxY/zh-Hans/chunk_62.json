[{"type": "subtitle", "time": 3720.87, "timestamp": "01:02:00", "text": "你在上面。"}, {"type": "subtitle", "time": 3722.39, "timestamp": "01:02:02", "text": "好的，这里有一件二级护甲。"}, {"type": "subtitle", "time": 3749.95, "timestamp": "01:02:29", "text": "你好。我遇见了你。好的。"}, {"type": "subtitle", "time": 3752.189, "timestamp": "01:02:32", "text": "你好。"}, {"type": "subtitle", "time": 3762.109, "timestamp": "01:02:42", "text": "在右侧"}, {"type": "subtitle", "time": 3766.149, "timestamp": "01:02:46", "text": "我们。我说得对。"}, {"type": "subtitle", "time": 3768.95, "timestamp": "01:02:48", "text": "正确的。哦，是那个中枪的家伙。我的天啊。哦"}, {"type": "subtitle", "time": 3771.589, "timestamp": "01:02:51", "text": "我的上帝。我打算选一个，我希望……"}]
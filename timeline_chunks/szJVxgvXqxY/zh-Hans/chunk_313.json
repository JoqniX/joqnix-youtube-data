[{"type": "subtitle", "time": 18781.51, "timestamp": "05:13:01", "text": "等等，鬼魂在哪儿？好的，所以你"}, {"type": "subtitle", "time": 18785.35, "timestamp": "05:13:05", "text": "关掉手电筒。好的。然后你"}, {"type": "subtitle", "time": 18787.27, "timestamp": "05:13:07", "text": "需要仔细观察，因为有时"}, {"type": "subtitle", "time": 18789.67, "timestamp": "05:13:09", "text": "它会出现的。"}, {"type": "subtitle", "time": 18791.27, "timestamp": "05:13:11", "text": "是的。是的。有时它会出现，"}, {"type": "subtitle", "time": 18804.548, "timestamp": "05:13:24", "text": "呃，你们又要换房间吗？"}, {"type": "subtitle", "time": 18812.868, "timestamp": "05:13:32", "text": "哦，你可以旋转摄像头。真酷。"}, {"type": "subtitle", "time": 18820.47, "timestamp": "05:13:40", "text": "没有头发。好吧，没事了。没关系。"}, {"type": "subtitle", "time": 18824.23, "timestamp": "05:13:44", "text": "这是一场狩猎。"}, {"type": "subtitle", "time": 18826.67, "timestamp": "05:13:46", "text": "哦，"}, {"type": "subtitle", "time": 18829.548, "timestamp": "05:13:49", "text": "打猎。我希望不是这样。"}, {"type": "subtitle", "time": 18834.12, "timestamp": "05:13:54", "text": "呃，我希望它不是模仿者。"}, {"type": "subtitle", "time": 18836.628, "timestamp": "05:13:56", "text": "[音乐]"}, {"type": "subtitle", "time": 18839.75, "timestamp": "05:13:59", "text": "这不是紫外线。"}]
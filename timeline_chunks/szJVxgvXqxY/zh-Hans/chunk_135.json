[{"type": "subtitle", "time": 8100.91, "timestamp": "02:15:00", "text": "最好还是去"}, {"type": "subtitle", "time": 8103.19, "timestamp": "02:15:03", "text": "那里。真是太烦人了。我们不能就这么"}, {"type": "subtitle", "time": 8106.87, "timestamp": "02:15:06", "text": "把工作台搬走。"}, {"type": "subtitle", "time": 8109.429, "timestamp": "02:15:09", "text": "嗯。哦，稍等一下。一秒钟。哦，你"}, {"type": "subtitle", "time": 8110.71, "timestamp": "02:15:10", "text": "两个都。好的，没问题。没关系。它是"}, {"type": "subtitle", "time": 8113.15, "timestamp": "02:15:13", "text": "美好的。我"}, {"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "所以，这里只有一种购物车类型。"}, {"type": "subtitle", "time": 8125.269, "timestamp": "02:15:25", "text": "左边的东西。咱们去看看那个吧。"}, {"type": "subtitle", "time": 8137.83, "timestamp": "02:15:37", "text": "嘿，这里有两个箱子。我会我会"}, {"type": "subtitle", "time": 8140.309, "timestamp": "02:15:40", "text": "拿一个，你也拿一个。得到一个"}, {"type": "subtitle", "time": 8144.55, "timestamp": "02:15:44", "text": "船舶地图。船只地图。这是什么？我"}, {"type": "subtitle", "time": 8147.59, "timestamp": "02:15:47", "text": "感觉就像个宝箱。"}, {"type": "subtitle", "time": 8150.349, "timestamp": "02:15:50", "text": "哦，是的。这是一个"}, {"type": "subtitle", "time": 8153.75, "timestamp": "02:15:53", "text": "我想，大概是宝藏吧。尽量弄明白"}, {"type": "subtitle", "time": 8158.07, "timestamp": "02:15:58", "text": "离这很远。哦，那些……哦，它们怎么样了？"}]
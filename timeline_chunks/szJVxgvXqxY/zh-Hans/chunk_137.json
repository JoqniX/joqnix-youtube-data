[{"type": "subtitle", "time": 8222.63, "timestamp": "02:17:02", "text": "我觉得我能打败他们。"}, {"type": "subtitle", "time": 8229.51, "timestamp": "02:17:09", "text": "难道我不觉得我真的可以打败他们吗？"}, {"type": "subtitle", "time": 8232.07, "timestamp": "02:17:12", "text": "坚持，稍等。哟，我打败他们了。我打败了他们。"}, {"type": "subtitle", "time": 8233.429, "timestamp": "02:17:13", "text": "我打败了他们。只有一个人。好的，"}, {"type": "subtitle", "time": 8251.349, "timestamp": "02:17:31", "text": "哦，天黑了。"}, {"type": "subtitle", "time": 8252.95, "timestamp": "02:17:32", "text": "我的天啊。不，我已经开始收到了。"}, {"type": "subtitle", "time": 8266.07, "timestamp": "02:17:46", "text": "我想如果我们像这样打开箱子的话……"}, {"type": "subtitle", "time": 8269.15, "timestamp": "02:17:49", "text": "在他们面前，他们好像会生气。"}, {"type": "subtitle", "time": 8279.59, "timestamp": "02:17:59", "text": "是的。哦，对不起。我的天哪，你害怕了"}]
[{"type": "subtitle", "time": 5521.75, "timestamp": "01:32:01", "text": "让我慢跑。所以挺有趣的。真是"}, {"type": "subtitle", "time": 5525.67, "timestamp": "01:32:05", "text": "乐趣。真的很有趣。是的。我们将玩游戏"}, {"type": "subtitle", "time": 5530.469, "timestamp": "01:32:10", "text": "稍后再说。我们应该，我们应该，是的"}, {"type": "subtitle", "time": 5532.63, "timestamp": "01:32:12", "text": "下次我们玩的时候我可能也会在。"}, {"type": "subtitle", "time": 5535.27, "timestamp": "01:32:15", "text": "因为我在日本，所以我会处于GST时区。"}, {"type": "subtitle", "time": 5539.51, "timestamp": "01:32:19", "text": "但我仍然会抽出时间陪你。"}, {"type": "subtitle", "time": 5541.349, "timestamp": "01:32:21", "text": "好的。"}, {"type": "subtitle", "time": 5545.11, "timestamp": "01:32:25", "text": "你好。谢谢你今天抽出时间。我会和……谈谈"}, {"type": "subtitle", "time": 5547.429, "timestamp": "01:32:27", "text": "今天就交给你了。"}, {"type": "subtitle", "time": 5549.15, "timestamp": "01:32:29", "text": "是的。"}, {"type": "subtitle", "time": 5552.71, "timestamp": "01:32:32", "text": "你好。我先挂断电话了。祝你一切顺利"}, {"type": "subtitle", "time": 5555.309, "timestamp": "01:32:35", "text": "美好的一天即将到来。祝你有美好的一天。你"}, {"type": "subtitle", "time": 5560.23, "timestamp": "01:32:40", "text": "也。你也是。你好。再见。再见。大家都说"}, {"type": "subtitle", "time": 5563.429, "timestamp": "01:32:43", "text": "再见"}, {"type": "subtitle", "time": 5576.469, "timestamp": "01:32:56", "text": "现在。那是阿佐拉·丽莎。如果你喜欢"}, {"type": "subtitle", "time": 5579.99, "timestamp": "01:32:59", "text": "今天，欢迎光临阿泽尔科学公司"}]
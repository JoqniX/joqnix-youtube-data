[{"type": "subtitle", "time": 16509.39, "timestamp": "04:35:09", "text": "这？"}, {"type": "subtitle", "time": 16517.23, "timestamp": "04:35:17", "text": "这里。商"}, {"type": "subtitle", "time": 16519.788, "timestamp": "04:35:19", "text": "下一个。哦"}, {"type": "subtitle", "time": 16522.99, "timestamp": "04:35:22", "text": "不，等等"}, {"type": "subtitle", "time": 16526.47, "timestamp": "04:35:26", "text": "他们是在攻击我吗？等等，等等，"}, {"type": "subtitle", "time": 16529.59, "timestamp": "04:35:29", "text": "等等，等等，等等。他们偷了我的东西吗？"}, {"type": "subtitle", "time": 16531.07, "timestamp": "04:35:31", "text": "还是别的什么？"}, {"type": "subtitle", "time": 16534.548, "timestamp": "04:35:34", "text": "等待。决不。正确的。等待。那可以"}, {"type": "subtitle", "time": 16536.41, "timestamp": "04:35:36", "text": "发生"}, {"type": "subtitle", "time": 16542.19, "timestamp": "04:35:42", "text": "[音乐]"}, {"type": "subtitle", "time": 16543.9, "timestamp": "04:35:43", "text": "尽管。哦，我的"}, {"type": "subtitle", "time": 16546.83, "timestamp": "04:35:46", "text": "[音乐]"}, {"type": "subtitle", "time": 16550.67, "timestamp": "04:35:50", "text": "上帝。好的。你为什么跟在后面？"}, {"type": "subtitle", "time": 16555.15, "timestamp": "04:35:55", "text": "等等，他们杀了叛徒。"}, {"type": "subtitle", "time": 16557.948, "timestamp": "04:35:57", "text": "圣洁的你。"}]
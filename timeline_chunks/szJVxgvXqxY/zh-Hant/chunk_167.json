[{"type": "subtitle", "time": 10022.55, "timestamp": "02:47:02", "text": "好的，又來一個。  好的。好了。"}, {"type": "subtitle", "time": 10029.309, "timestamp": "02:47:09", "text": "我們正在取得進展。我是一半。"}, {"type": "subtitle", "time": 10038.07, "timestamp": "02:47:18", "text": "但你只需輕輕一點。我只需輕輕一點。我先離開一會兒。我也"}, {"type": "subtitle", "time": 10048.87, "timestamp": "02:47:28", "text": "需要逃跑。"}, {"type": "subtitle", "time": 10052.87, "timestamp": "02:47:32", "text": "嗯，我先去吃點東西"}, {"type": "subtitle", "time": 10062.15, "timestamp": "02:47:42", "text": "哦，天哪，我死了。我還活著。應該沒問題。你的"}, {"type": "subtitle", "time": 10067.99, "timestamp": "02:47:47", "text": "硬幣夠用嗎？  我也這麼認為。前往復活代幣處。"}, {"type": "subtitle", "time": 10071.189, "timestamp": "02:47:51", "text": "呃，我想，該輪到「過來」了。哦，我得等等。 12秒內即可完成。我的天啊。好的"}, {"type": "subtitle", "time": 10077.349, "timestamp": "02:47:57", "text": "，請稍等。  稍等片刻。稍等片刻。  我們有吃的嗎？"}]
[{"type": "subtitle", "time": 842.63, "timestamp": "00:14:02", "text": "我很緊張。  非常"}, {"type": "subtitle", "time": 845.27, "timestamp": "00:14:05", "text": "榮幸你能來"}, {"type": "subtitle", "time": 847.59, "timestamp": "00:14:07", "text": "直播。"}, {"type": "subtitle", "time": 852.03, "timestamp": "00:14:12", "text": "謝謝。我也是。  是的"}, {"type": "subtitle", "time": 856.07, "timestamp": "00:14:16", "text": "。這是我們很久以來的第一次互動"}, {"type": "subtitle", "time": 858.709, "timestamp": "00:14:18", "text": "，對吧？  是的"}, {"type": "subtitle", "time": 861.11, "timestamp": "00:14:21", "text": "。"}, {"type": "subtitle", "time": 862.27, "timestamp": "00:14:22", "text": "我的"}, {"type": "subtitle", "time": 865.91, "timestamp": "00:14:25", "text": "天啊。說實話，呃，我當時在找"}, {"type": "subtitle", "time": 869.59, "timestamp": "00:14:29", "text": "人邀請的時候，"}, {"type": "subtitle", "time": 871.99, "timestamp": "00:14:31", "text": "翻看了我的私訊和好友列表，看看有沒有人"}, {"type": "subtitle", "time": 874.31, "timestamp": "00:14:34", "text": "跟我聊過天，"}, {"type": "subtitle", "time": 875.99, "timestamp": "00:14:35", "text": "然後我就看到了你。我當時就說：「哦，"}, {"type": "subtitle", "time": 879.35, "timestamp": "00:14:39", "text": "對，我記得Azora。我們聊過"}, {"type": "subtitle", "time": 881.91, "timestamp": "00:14:41", "text": "音樂什麼的，我想我是"}, {"type": "subtitle", "time": 885.83, "timestamp": "00:14:45", "text": "在DSG之類的組織裡認識你的。我記得很久"}, {"type": "subtitle", "time": 888.39, "timestamp": "00:14:48", "text": "以前的事了。」是"}]
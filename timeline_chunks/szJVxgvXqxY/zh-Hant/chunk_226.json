[{"type": "subtitle", "time": 13572.55, "timestamp": "03:46:12", "text": "把他叫上來。  好了。"}, {"type": "subtitle", "time": 13573.948, "timestamp": "03:46:13", "text": "聖哉"}, {"type": "subtitle", "time": 13576.59, "timestamp": "03:46:16", "text": "上帝。  終於，終於，終於。我的天啊。  最後。一個新的"}, {"type": "subtitle", "time": 13589.72, "timestamp": "03:46:29", "text": "叫賣者。你為什麼不工作？我先把你移除，然後再把你加回去。  呃"}, {"type": "subtitle", "time": 13604.07, "timestamp": "03:46:44", "text": "，好的。我再加你一次。好了"}, {"type": "subtitle", "time": 13610.23, "timestamp": "03:46:50", "text": "，就是這樣。你終於成功了。我的天，終於成功了！我很想念你。"}, {"type": "subtitle", "time": 13615.868, "timestamp": "03:46:55", "text": "我的天哪。我的天哪。好的，"}, {"type": "subtitle", "time": 13619.27, "timestamp": "03:46:59", "text": "我把這個拉下來取消選擇。回到工作室"}]
[{"type": "subtitle", "time": 31754.47, "timestamp": "08:49:14", "text": "哦，我的天哪。我必須建造嗎？我必須建造那個。你在開玩笑嗎？我必須建造它。我，我必須。現在"}, {"type": "subtitle", "time": 31771.99, "timestamp": "08:49:31", "text": "怎麼辦？"}, {"type": "subtitle", "time": 31779.19, "timestamp": "08:49:39", "text": "等等。我有。哦。哦，是他們不會殺人，當他們說「哦，天哪。」我得創造一個建造者。 「"}, {"type": "subtitle", "time": 31781.35, "timestamp": "08:49:41", "text": "我的天哪。我得造一個建造者。遠古白色。哦，"}, {"type": "subtitle", "time": 31795.03, "timestamp": "08:49:55", "text": "它……哦，它告訴我該"}]
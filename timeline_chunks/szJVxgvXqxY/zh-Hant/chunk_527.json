[{"type": "subtitle", "time": 31626.07, "timestamp": "08:47:06", "text": "我終於能聽到"}, {"type": "subtitle", "time": 31628.79, "timestamp": "08:47:08", "text": "節拍了。"}, {"type": "subtitle", "time": 31639.586, "timestamp": "08:47:19", "text": "所以是10，對吧？我想，好的。這是什麼？飛航模式。這"}, {"type": "subtitle", "time": 31649.11, "timestamp": "08:47:29", "text": "是誰"}, {"type": "subtitle", "time": 31658.31, "timestamp": "08:47:38", "text": "？等等。你會想念我的"}, {"type": "subtitle", "time": 31675.67, "timestamp": "08:47:55", "text": "菜單。我的天哪。你有控制權。看，我在飛。所以它就像樂高版的我的世界。"}]
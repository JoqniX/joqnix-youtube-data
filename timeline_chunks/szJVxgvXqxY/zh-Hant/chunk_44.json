[{"type": "subtitle", "time": 2640.27, "timestamp": "00:44:00", "text": "[音樂]級"}, {"type": "subtitle", "time": 2645.03, "timestamp": "00:44:05", "text": "二。"}, {"type": "subtitle", "time": 2652.47, "timestamp": "00:44:12", "text": "哦，你已經有盔甲了。"}, {"type": "subtitle", "time": 2660.39, "timestamp": "00:44:20", "text": "好的。  是的。  喔不，我們沒看到。  我們出去吧。  我的天啊。我們沒有看到這一點。  哦。"}]
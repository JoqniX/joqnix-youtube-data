[{"type": "subtitle", "time": 3700.31, "timestamp": "01:01:40", "text": "進去？哦，給你。  還有這一點。  哦，有人。我的天啊。有第三方介入。躲起來。躲起來。我"}, {"type": "subtitle", "time": 3704.47, "timestamp": "01:01:44", "text": "只能躲起來。這邊有人在療傷。  殺了他。殺了他。好的"}, {"type": "subtitle", "time": 3709.95, "timestamp": "01:01:49", "text": "。我可以解決他"}, {"type": "subtitle", "time": 3718.95, "timestamp": "01:01:58", "text": "我會在裡面。哦，等等。  謝謝。有人來了。好的。好的。好的。"}]
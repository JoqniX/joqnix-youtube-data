[{"type": "subtitle", "time": 10561.83, "timestamp": "02:56:01", "text": "我覺得我已經受夠了。"}, {"type": "subtitle", "time": 10566.229, "timestamp": "02:56:06", "text": "天哪，不。我當時在"}, {"type": "subtitle", "time": 10576.07, "timestamp": "02:56:16", "text": "查看庫存，所以沒注意到。我沒有。我的天哪。哇。哦好的。至少我們現在知道如何製作…我們知道"}, {"type": "subtitle", "time": 10581.59, "timestamp": "02:56:21", "text": "現在必須製作黃金工具了。沒錯，黃金工具。這款遊戲中似乎"}, {"type": "subtitle", "time": 10617.83, "timestamp": "02:56:57", "text": "沒有石器工具。  是的。  瘋狂的。我（音樂）什麼是對位？  哦，我覺得我們就像贏了一樣。我們贏了。"}]
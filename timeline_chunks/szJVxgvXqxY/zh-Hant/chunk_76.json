[{"type": "subtitle", "time": 4561.95, "timestamp": "01:16:01", "text": "我把他[音樂]弄到手了。他死了。好的。  只要我們不加入我們的團隊。那邊某個地方有人。"}, {"type": "subtitle", "time": 4582.99, "timestamp": "01:16:22", "text": "哦，對了，我們"}, {"type": "subtitle", "time": 4605.589, "timestamp": "01:16:45", "text": "得去下一個區域。  好的。"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "什麼是配送商城？  那是哦，人們。人們。"}, {"type": "subtitle", "time": 4611.11, "timestamp": "01:16:51", "text": "哦，我摔倒了。我下去了。"}]
[{"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "哦，這裡原本就有一張工作台。"}, {"type": "subtitle", "time": 8137.83, "timestamp": "02:15:37", "text": "哦，我還從鐵匠鋪弄到了鐵條。  哦，不錯。  我"}, {"type": "subtitle", "time": 8140.309, "timestamp": "02:15:40", "text": "弄到了一把斧子，但它好像是從一些"}, {"type": "subtitle", "time": 8147.59, "timestamp": "02:15:47", "text": "隨機礦石上砍下來的。  別忘了買煤。我們會為耶建一個熔爐。為了這件事。"}, {"type": "subtitle", "time": 8150.349, "timestamp": "02:15:50", "text": "哦，是"}, {"type": "subtitle", "time": 8153.75, "timestamp": "02:15:53", "text": "鐵，對吧？是的。  哦，那裡有鐵礦石"}]
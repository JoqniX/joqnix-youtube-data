[{"type": "subtitle", "time": 21569.11, "timestamp": "05:59:29", "text": "沒有。  哦，是你嗎？是的。哦，門開了。  好的。哦。  [音樂] 真可怕。我馬上回來。  哦，給你。找到了。"}, {"type": "subtitle", "time": 21574.468, "timestamp": "05:59:34", "text": "哦，在樓上。樓上。  哦"}, {"type": "subtitle", "time": 21577.83, "timestamp": "05:59:37", "text": "好的。好的。一秒鐘。你帶"}, {"type": "subtitle", "time": 21592.15, "timestamp": "05:59:52", "text": "相機了嗎？是的。  小心。協助。  好的，我來安裝運動感應器。好的。哦，找到了。在哪裡？"}]
[{"type": "subtitle", "time": 10287.79, "timestamp": "02:51:27", "text": "我想我們現在可以用"}, {"type": "subtitle", "time": 10292.309, "timestamp": "02:51:32", "text": "金斧砍樺樹了。  解鎖鋼板。  哦，解鎖的鋼斧。"}, {"type": "subtitle", "time": 10295.11, "timestamp": "02:51:35", "text": "我們還需要宰殺牛隻和其他"}, {"type": "subtitle", "time": 10298.229, "timestamp": "02:51:38", "text": "牲畜。"}, {"type": "subtitle", "time": 10310.67, "timestamp": "02:51:50", "text": "我被人攔住了"}, {"type": "subtitle", "time": 10314.55, "timestamp": "02:51:54", "text": "。抱歉。是的。  別擔心。不用擔心。不用擔心。一切都好。  明白了。很快就會有一些故障發生。"}]
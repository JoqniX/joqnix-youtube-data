[{"type": "subtitle", "time": 11533.67, "timestamp": "03:12:13", "text": "館。  我想那是希拉。這就像一個梗。"}, {"type": "subtitle", "time": 11538.389, "timestamp": "03:12:18", "text": "你有一個表情包。我的希拉。如果你知道的話，就不會有人覺得我有點太沉迷於"}, {"type": "subtitle", "time": 11545.99, "timestamp": "03:12:25", "text": "網路了。"}, {"type": "subtitle", "time": 11557.83, "timestamp": "03:12:37", "text": "我知道每一次會議的內容。"}, {"type": "subtitle", "time": 11566.95, "timestamp": "03:12:46", "text": "我的天啊。兄弟，這怎麼還沒打開？沒關係。"}, {"type": "subtitle", "time": 11571.03, "timestamp": "03:12:51", "text": "哦，好了。並且開放。停止洩漏我們的私訊。你是什​​麼意思？  我只說了一句話。  你最喜歡的遊戲是什麼？  我最喜歡的遊戲應該是《我的世界》，因為，嗯，我的意思是，我偶爾也會玩其他喜歡的"}]
[{"type": "subtitle", "time": 814.95, "timestamp": "00:13:34", "text": "好的。大家好。歡迎來到"}, {"type": "subtitle", "time": 819.27, "timestamp": "00:13:39", "text": "Joathon 第 90 天。那麼，我們首先要介紹的是"}, {"type": "subtitle", "time": 823.55, "timestamp": "00:13:43", "text": "我們的第一位嘉賓。我們有阿祖蘭。  阿祖拉"}, {"type": "subtitle", "time": 826.189, "timestamp": "00:13:46", "text": "。"}, {"type": "subtitle", "time": 830.03, "timestamp": "00:13:50", "text": "你好。你好，庫拉。"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "卡祖爾。你好。你好。我的名字叫阿祖爾。"}, {"type": "subtitle", "time": 836.79, "timestamp": "00:13:56", "text": "我已經很久沒"}]
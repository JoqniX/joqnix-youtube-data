[{"type": "subtitle", "time": 18961.03, "timestamp": "05:16:01", "text": "這位阿姆斯特丹戰士是誰"}, {"type": "subtitle", "time": 18964.628, "timestamp": "05:16:04", "text": "？好吧，阿姆斯特丹人簡直要瘋了。  [音樂] 好的"}, {"type": "subtitle", "time": 18967.75, "timestamp": "05:16:07", "text": "，教練。"}, {"type": "subtitle", "time": 18976.708, "timestamp": "05:16:16", "text": "？你好。寫作意味著分享。  好的。分享"}, {"type": "subtitle", "time": 18993.59, "timestamp": "05:16:33", "text": "是人類天性的一部分。圖書館和校園都已關閉。  好的。選擇研究"}]
[{"type": "subtitle", "time": 27002.19, "timestamp": "07:30:02", "text": "安裝這個客製化的"}, {"type": "subtitle", "time": 27005.15, "timestamp": "07:30:05", "text": "東西，我可以試試。"}, {"type": "subtitle", "time": 27014.27, "timestamp": "07:30:14", "text": "哦，真好真好"}, {"type": "subtitle", "time": 27017.59, "timestamp": "07:30:17", "text": "。是的，最終比數是11，Roco漂亮地撲救成功。你又不是玩《"}, {"type": "subtitle", "time": 27021.868, "timestamp": "07:30:21", "text": "要塞英雄》的小孩。不，我不是玩《"}, {"type": "subtitle", "time": 27035.388, "timestamp": "07:30:35", "text": "要塞英雄》的小孩。我只是個普通的騎師。你是什​​麼意思？  你很有深度"}, {"type": "subtitle", "time": 27042.75, "timestamp": "07:30:42", "text": "。我的天啊。  好了，我們走吧。選擇地圖，對吧？我想要傾斜的。一，二。哦，人多了。人更多了。  我忘了我還有這麼多。"}]
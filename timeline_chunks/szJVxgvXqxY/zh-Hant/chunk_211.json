[{"type": "subtitle", "time": 12683.429, "timestamp": "03:31:23", "text": "我不介意下一個上去"}, {"type": "subtitle", "time": 12686.87, "timestamp": "03:31:26", "text": "。我"}, {"type": "subtitle", "time": 12688.51, "timestamp": "03:31:28", "text": "應該去，嗯，我和一些同學應該去。所以他們打電話叫我們所有人去那裡，呃，去呃，"}, {"type": "subtitle", "time": 12694.229, "timestamp": "03:31:34", "text": "學院，明天早上和那裡的人談談，幸好我明天早上沒有其他人，"}, {"type": "subtitle", "time": 12702.229, "timestamp": "03:31:42", "text": "否則"}, {"type": "subtitle", "time": 12704.229, "timestamp": "03:31:44", "text": "我就不得不取消他們的行程了"}, {"type": "subtitle", "time": 12719.309, "timestamp": "03:31:59", "text": "我不能取消訂單。是的。是的。"}]
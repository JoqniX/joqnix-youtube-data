[{"type": "subtitle", "time": 2779.39, "timestamp": "00:46:19", "text": "。  哦"}, {"type": "subtitle", "time": 2783.109, "timestamp": "00:46:23", "text": "，又發生了嗎？哦。是的。  這是"}, {"type": "subtitle", "time": 2797.109, "timestamp": "00:46:37", "text": "什麼？迪格爾 H. 小心。  小心。我們走吧。  是的。未來。  大家的呢？我覺得我得"}, {"type": "subtitle", "time": 2803.27, "timestamp": "00:46:43", "text": "往上爬。有個東西叫…… 這是什麼？我聽到人們在說什麼？"}, {"type": "subtitle", "time": 2813.47, "timestamp": "00:46:53", "text": "我不知道。換成第三方人員。他為什麼還沒死？  我的"}, {"type": "subtitle", "time": 2816.07, "timestamp": "00:46:56", "text": "天啊。  好的。呃"}]
[{"type": "subtitle", "time": 18900.788, "timestamp": "05:15:00", "text": "公民。"}, {"type": "subtitle", "time": 18903.11, "timestamp": "05:15:03", "text": "呃，"}, {"type": "subtitle", "time": 18906.788, "timestamp": "05:15:06", "text": "我從這三個地方一共能得到三個金幣、一個生產力點數和一個食物點數。  哦，我得"}, {"type": "subtitle", "time": 18910.23, "timestamp": "05:15:10", "text": "點擊它們之類的。  好的。嗯？  [音樂] 嗯，"}, {"type": "subtitle", "time": 18943.43, "timestamp": "05:15:43", "text": "他最精彩的困惑聲。我的天啊。這是什麼呢？  呃，15次。你是什​​麼意思？哦，是它的 eo"}, {"type": "subtitle", "time": 18950.548, "timestamp": "05:15:50", "text": "或增長。好的，明白了。知道了。知道了。知道了。哦，他們是自殺的。我的天啊"}, {"type": "subtitle", "time": 18954.15, "timestamp": "05:15:54", "text": "。苔原。等等，"}]
[{"type": "subtitle", "time": 7401.95, "timestamp": "02:03:21", "text": "烹調"}, {"type": "subtitle", "time": 7404.95, "timestamp": "02:03:24", "text": "肉類。我要兩份。你拿走兩塊肉，我再去拿些吃的。我這就把他們幹掉。我花"}, {"type": "subtitle", "time": 7406.79, "timestamp": "02:03:26", "text": "一分鐘。  你可以接受我往裡面放煤。  糟糕，我們有錢了。哦，"}, {"type": "subtitle", "time": 7418.55, "timestamp": "02:03:38", "text": "等等。"}, {"type": "subtitle", "time": 7423.11, "timestamp": "02:03:43", "text": "有了這枚硬幣，"}, {"type": "subtitle", "time": 7437.309, "timestamp": "02:03:57", "text": "我們就能打開"}]
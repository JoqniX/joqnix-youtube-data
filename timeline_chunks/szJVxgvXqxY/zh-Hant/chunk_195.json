[{"type": "subtitle", "time": 11711.03, "timestamp": "03:15:11", "text": "哦，哦，對不起，對不起，對不起。那是另一個人。對不起，對不起，對不起。鑽石一號。"}, {"type": "subtitle", "time": 11721.83, "timestamp": "03:15:21", "text": "那可真不少。  我之前都到過飛升段位了，但後來"}, {"type": "subtitle", "time": 11743.429, "timestamp": "03:15:43", "text": "我有的是時間。"}, {"type": "subtitle", "time": 11746.309, "timestamp": "03:15:46", "text": "你最欣賞哪個角色？"}, {"type": "subtitle", "time": 11749.83, "timestamp": "03:15:49", "text": "嗯，在我的大學球隊裡，我以前是用手把玩遊戲的"}]
[{"type": "subtitle", "time": 16285.07, "timestamp": "04:31:25", "text": "のように"}, {"type": "subtitle", "time": 16289.628, "timestamp": "04:31:29", "text": "おお。ああ、強化するのを忘れてた"}, {"type": "subtitle", "time": 16291.23, "timestamp": "04:31:31", "text": "彼ら。"}, {"type": "subtitle", "time": 16299.23, "timestamp": "04:31:39", "text": "[音楽]"}, {"type": "subtitle", "time": 16302.35, "timestamp": "04:31:42", "text": "聖なる。よし、戦争だ"}, {"type": "subtitle", "time": 16313.35, "timestamp": "04:31:53", "text": "わかった。ええと、このことからこのことへのメリット"}, {"type": "subtitle", "time": 16315.43, "timestamp": "04:31:55", "text": "ルートを開始します。もたらすことに加えて"}, {"type": "subtitle", "time": 16317.23, "timestamp": "04:31:57", "text": "富を私たちに"}, {"type": "subtitle", "time": 16319.19, "timestamp": "04:31:59", "text": "文明の道は徐々に"}]
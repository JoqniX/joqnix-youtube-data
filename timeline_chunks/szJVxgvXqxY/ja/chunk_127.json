[{"type": "subtitle", "time": 7620.07, "timestamp": "02:07:00", "text": "ああ、彼らは助けていない。"}, {"type": "subtitle", "time": 7630.79, "timestamp": "02:07:10", "text": "ない。何てことだ。"}, {"type": "subtitle", "time": 7634.309, "timestamp": "02:07:14", "text": "クリティカルヒットを出すにはどうすればいいですか？"}, {"type": "subtitle", "time": 7637.11, "timestamp": "02:07:17", "text": "今日は食べ物がなかったと思う。"}, {"type": "subtitle", "time": 7643.11, "timestamp": "02:07:23", "text": "最悪だ。持続する。私は食事をしています。あなたはそうするかもしれない"}, {"type": "subtitle", "time": 7644.71, "timestamp": "02:07:24", "text": "一瞬逃げ出したい"}, {"type": "subtitle", "time": 7650.87, "timestamp": "02:07:30", "text": "わかった。"}, {"type": "subtitle", "time": 7654.15, "timestamp": "02:07:34", "text": "HPが低い。"}, {"type": "subtitle", "time": 7656.79, "timestamp": "02:07:36", "text": "死ぬな。死ぬな。死ぬな。食べる"}, {"type": "subtitle", "time": 7657.75, "timestamp": "02:07:37", "text": "食べ物。食事を摂る。素早い。素早い。素早い。"}, {"type": "subtitle", "time": 7659.59, "timestamp": "02:07:39", "text": "素早い。素早い。素早い。素早い。素早い。私はします"}, {"type": "subtitle", "time": 7662.469, "timestamp": "02:07:42", "text": "食べ物がない。なんてこった。"}, {"type": "subtitle", "time": 7664.87, "timestamp": "02:07:44", "text": "えっと、リンゴとか"}, {"type": "subtitle", "time": 7666.07, "timestamp": "02:07:46", "text": "何か。いくつかあるかもしれない"}, {"type": "subtitle", "time": 7669.15, "timestamp": "02:07:49", "text": "在庫を整理する"}, {"type": "subtitle", "time": 7671.63, "timestamp": "02:07:51", "text": "木材。"}]
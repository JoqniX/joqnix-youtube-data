[{"type": "subtitle", "time": 7862.87, "timestamp": "02:11:02", "text": "待って、これではスープは作れないよ。"}, {"type": "subtitle", "time": 7865.19, "timestamp": "02:11:05", "text": "何？"}, {"type": "subtitle", "time": 7869.429, "timestamp": "02:11:09", "text": "何てことだ。ええと、炉。どこにいるの？"}, {"type": "subtitle", "time": 7873.19, "timestamp": "02:11:13", "text": "ああ、よくやったね。うん。どうやって売ればいいのか？"}, {"type": "subtitle", "time": 7875.87, "timestamp": "02:11:15", "text": "ああ、神様。"}, {"type": "subtitle", "time": 7879.63, "timestamp": "02:11:19", "text": "わかった。燃料キノコ。"}, {"type": "subtitle", "time": 7886.5, "timestamp": "02:11:26", "text": "神。私は作ります"}, {"type": "subtitle", "time": 7888.67, "timestamp": "02:11:28", "text": "[音楽]"}, {"type": "subtitle", "time": 7892.03, "timestamp": "02:11:32", "text": "鳩。何？君は"}, {"type": "subtitle", "time": 7894.469, "timestamp": "02:11:34", "text": "了解しました。何かを作ることができます"}, {"type": "subtitle", "time": 7898.349, "timestamp": "02:11:38", "text": "ここ。わかった。しかし、それは不可能だ。"}, {"type": "subtitle", "time": 7901.19, "timestamp": "02:11:41", "text": "わかった。何？"}, {"type": "subtitle", "time": 7903.91, "timestamp": "02:11:43", "text": "何？誰が？誰が？何てことだ。いいえ。"}, {"type": "subtitle", "time": 7905.67, "timestamp": "02:11:45", "text": "村人たち。私は村人たちを殴った。彼らは"}, {"type": "subtitle", "time": 7909.11, "timestamp": "02:11:49", "text": "間に挟まった。なんてこった。"}, {"type": "subtitle", "time": 7911.269, "timestamp": "02:11:51", "text": "ああ、もし私があなたを殺したら、私はあなたを蘇らせることができます"}, {"type": "subtitle", "time": 7913.59, "timestamp": "02:11:53", "text": "こいつらだ。"}, {"type": "subtitle", "time": 7915.67, "timestamp": "02:11:55", "text": "私には無理だと思います。私は死んだ。"}, {"type": "subtitle", "time": 7918.309, "timestamp": "02:11:58", "text": "寂しいよ、兄弟。彼らはまるで"}]
[{"type": "subtitle", "time": 2479.189, "timestamp": "00:41:19", "text": "ニース。えっと、"}, {"type": "subtitle", "time": 2481.75, "timestamp": "00:41:21", "text": "もっと多くの人。もっと多くの人。"}, {"type": "subtitle", "time": 2483.669, "timestamp": "00:41:23", "text": "注意深い。注意深い。行け、行け、行け、行け、行け、"}, {"type": "subtitle", "time": 2495.75, "timestamp": "00:41:35", "text": "何てことだ。水。"}, {"type": "subtitle", "time": 2497.99, "timestamp": "00:41:37", "text": "水。ああ、これは通過できない。ああ、私たちは"}, {"type": "subtitle", "time": 2500.79, "timestamp": "00:41:40", "text": "これは通過できない。なんてこった。なんてこった。待って。"}, {"type": "subtitle", "time": 2503.27, "timestamp": "00:41:43", "text": "地図。地図を開く。よし、"}, {"type": "subtitle", "time": 2511.75, "timestamp": "00:41:51", "text": "被害は甚大だ。"}]
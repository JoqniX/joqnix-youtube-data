[{"type": "subtitle", "time": 13561.23, "timestamp": "03:46:01", "text": "[音楽]"}, {"type": "subtitle", "time": 13564.11, "timestamp": "03:46:04", "text": "生産。何"}, {"type": "subtitle", "time": 13566.83, "timestamp": "03:46:06", "text": "生産？"}, {"type": "subtitle", "time": 13569.47, "timestamp": "03:46:09", "text": "えっと"}, {"type": "subtitle", "time": 13572.55, "timestamp": "03:46:12", "text": "記念碑。ああ、私は記念碑を建てます"}, {"type": "subtitle", "time": 13573.948, "timestamp": "03:46:13", "text": "どこにもない。ああ、"}, {"type": "subtitle", "time": 13576.59, "timestamp": "03:46:16", "text": "神。"}, {"type": "subtitle", "time": 13579.868, "timestamp": "03:46:19", "text": "えっと、次は？えっと、これ"}, {"type": "subtitle", "time": 13582.67, "timestamp": "03:46:22", "text": "1つ。どこに行きたいですか？"}, {"type": "subtitle", "time": 13589.72, "timestamp": "03:46:29", "text": "彼らこそ戦士である。彼らはそうすべきだ"}, {"type": "subtitle", "time": 13592.948, "timestamp": "03:46:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13604.07, "timestamp": "03:46:44", "text": "えっと、45。いや、銀があるよ。私のえっと"}, {"type": "subtitle", "time": 13605.708, "timestamp": "03:46:45", "text": "しばらくお待ちください。"}, {"type": "subtitle", "time": 13610.23, "timestamp": "03:46:50", "text": "こんにちは、公民の木。えっと、これは何ですか？神、"}, {"type": "subtitle", "time": 13612.788, "timestamp": "03:46:52", "text": "すごく混乱しています。私の指導教官はどこですか？"}, {"type": "subtitle", "time": 13615.868, "timestamp": "03:46:55", "text": "なぜ私の指導教官なのか？どこに"}, {"type": "subtitle", "time": 13619.27, "timestamp": "03:46:59", "text": "あなた？これらすべてを学ぶ必要があるのでしょうか？"}]
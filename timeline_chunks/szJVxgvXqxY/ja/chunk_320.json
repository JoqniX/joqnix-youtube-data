[{"type": "subtitle", "time": 19205.51, "timestamp": "05:20:05", "text": "スピリットボックスを持ってきてください。うん、"}, {"type": "subtitle", "time": 19207.19, "timestamp": "05:20:07", "text": "さあ行こう。"}, {"type": "subtitle", "time": 19225.59, "timestamp": "05:20:25", "text": "奴を捕まえに行くぞ。"}, {"type": "subtitle", "time": 19227.43, "timestamp": "05:20:27", "text": "うん、"}, {"type": "subtitle", "time": 19231.11, "timestamp": "05:20:31", "text": "それは正しい。わかった。ここは隠れ場所だ。"}, {"type": "subtitle", "time": 19250.11, "timestamp": "05:20:50", "text": "おお。こんにちは。幽霊みたい。"}, {"type": "subtitle", "time": 19253.548, "timestamp": "05:20:53", "text": "近い。近い。"}, {"type": "subtitle", "time": 19255.948, "timestamp": "05:20:55", "text": "こんにちは。"}]
[{"type": "subtitle", "time": 8462.55, "timestamp": "02:21:02", "text": "スタミナ。わかりました、炉があります"}, {"type": "subtitle", "time": 8465.03, "timestamp": "02:21:05", "text": "ここ。私たちは"}, {"type": "subtitle", "time": 8474.15, "timestamp": "02:21:14", "text": "良い。よし、これでいい。私はまだ"}, {"type": "subtitle", "time": 8477.349, "timestamp": "02:21:17", "text": "理解する"}, {"type": "subtitle", "time": 8480.229, "timestamp": "02:21:20", "text": "えっと、道具を火にする方法。"}, {"type": "subtitle", "time": 8484.75, "timestamp": "02:21:24", "text": "わかった。これをここに置いて、"}, {"type": "subtitle", "time": 8488.309, "timestamp": "02:21:28", "text": "そして、ここから下へ。"}, {"type": "subtitle", "time": 8491.75, "timestamp": "02:21:31", "text": "ああ、さあ、始めよう。我々はできる"}, {"type": "subtitle", "time": 8500.95, "timestamp": "02:21:40", "text": "ここ。樹皮と白樺材。はい、私たちは"}, {"type": "subtitle", "time": 8502.79, "timestamp": "02:21:42", "text": "白樺材は道具を作るのに使われる。えっと、それは"}, {"type": "subtitle", "time": 8504.55, "timestamp": "02:21:44", "text": "そうやって鋼鉄製の工具を作るんだ。あなた"}, {"type": "subtitle", "time": 8506.79, "timestamp": "02:21:46", "text": "白樺材が必要です。何てことだ。どこ"}, {"type": "subtitle", "time": 8519.389, "timestamp": "02:21:59", "text": "今。おお。そうそう。何てことだ。"}]
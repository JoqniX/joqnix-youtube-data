[{"type": "subtitle", "time": 10845.11, "timestamp": "03:00:45", "text": "一体どういうことだ？やあみんな、それはそれは"}, {"type": "subtitle", "time": 10846.63, "timestamp": "03:00:46", "text": "4対5。"}, {"type": "subtitle", "time": 10848.389, "timestamp": "03:00:48", "text": "それが私たちが買うものです。何？彼らはただ"}, {"type": "subtitle", "time": 10856.229, "timestamp": "03:00:56", "text": "私の必殺技が完成しました。"}, {"type": "subtitle", "time": 10859.429, "timestamp": "03:00:59", "text": "私は、すべてのすべての"}]
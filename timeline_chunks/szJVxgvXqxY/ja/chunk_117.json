[{"type": "subtitle", "time": 7021.67, "timestamp": "01:57:01", "text": "木製の道具はうまく機能していない。"}, {"type": "subtitle", "time": 7027.269, "timestamp": "01:57:07", "text": "直接行く必要があると思います"}, {"type": "subtitle", "time": 7033.74, "timestamp": "01:57:13", "text": "うーん、メタルかな。よくわからない。"}, {"type": "subtitle", "time": 7039.19, "timestamp": "01:57:19", "text": "それはとても愚かで、私を遠ざけました"}, {"type": "subtitle", "time": 7042.23, "timestamp": "01:57:22", "text": "このように2つの壁を一緒に建ててください。"}, {"type": "subtitle", "time": 7044.79, "timestamp": "01:57:24", "text": "キャビネットはどこにありましたか？"}, {"type": "subtitle", "time": 7058.389, "timestamp": "01:57:38", "text": "傷を治さなきゃ。あなたは本当に落ち込んでいますね。"}, {"type": "subtitle", "time": 7060.71, "timestamp": "01:57:40", "text": "うん。"}, {"type": "subtitle", "time": 7064.309, "timestamp": "01:57:44", "text": "もっと料理を作ろう。いいえ。閉じる"}, {"type": "subtitle", "time": 7066.79, "timestamp": "01:57:46", "text": "これを外す。"}, {"type": "subtitle", "time": 7069.19, "timestamp": "01:57:49", "text": "中に入るためにドアを作る必要がある"}, {"type": "subtitle", "time": 7071.19, "timestamp": "01:57:51", "text": "そして出て行った。"}, {"type": "subtitle", "time": 7077.23, "timestamp": "01:57:57", "text": "そうねぇ。ドア、ドア、"}]
[{"type": "subtitle", "time": 9602.229, "timestamp": "02:40:02", "text": "ええ、そう思います。"}, {"type": "subtitle", "time": 9606.229, "timestamp": "02:40:06", "text": "私は窮地に立たされている。適切な"}, {"type": "subtitle", "time": 9611.75, "timestamp": "02:40:11", "text": "ここ。ああ、もう、暴徒が"}, {"type": "subtitle", "time": 9623.71, "timestamp": "02:40:23", "text": "地獄？私はブーをしました"}, {"type": "subtitle", "time": 9627.91, "timestamp": "02:40:27", "text": "ブー。私は戦いを始めた。ボス戦。"}, {"type": "subtitle", "time": 9650.63, "timestamp": "02:40:50", "text": "今。あのね？私はできません"}, {"type": "subtitle", "time": 9652.71, "timestamp": "02:40:52", "text": "えっと、ゴールドを手に入れようとしているんだけど、"}]
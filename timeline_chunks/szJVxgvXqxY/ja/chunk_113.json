[{"type": "subtitle", "time": 6781.19, "timestamp": "01:53:01", "text": "おっと、コインが入った。あ、待って。と共に"}, {"type": "subtitle", "time": 6784.99, "timestamp": "01:53:04", "text": "コインがあれば、宝箱を開けることはできます。"}, {"type": "subtitle", "time": 6788.309, "timestamp": "01:53:08", "text": "おお。ああ、20ゴールドあると思ったのに"}, {"type": "subtitle", "time": 6790.23, "timestamp": "01:53:10", "text": "ああ、それは良いことですか、それとも"}, {"type": "subtitle", "time": 6793.19, "timestamp": "01:53:13", "text": "悪いこと？ピギー、その気になったわ。"}, {"type": "subtitle", "time": 6795.389, "timestamp": "01:53:15", "text": "すべてを独り占めする時間"}, {"type": "subtitle", "time": 6798.95, "timestamp": "01:53:18", "text": "戦利品。それは能力ですか？"}, {"type": "subtitle", "time": 6810.15, "timestamp": "01:53:30", "text": "私はもっ​​と高くジャンプできると思う。多分"}, {"type": "subtitle", "time": 6811.51, "timestamp": "01:53:31", "text": "[音楽]"}, {"type": "subtitle", "time": 6813.51, "timestamp": "01:53:33", "text": "戦利品は全部私が手に入れる、みたいな感じ。"}, {"type": "subtitle", "time": 6817.67, "timestamp": "01:53:37", "text": "面白い。それから、肉も食べましょう。"}, {"type": "subtitle", "time": 6824.07, "timestamp": "01:53:44", "text": "よし、これでいい。もうお腹いっぱいです。はい、そうします"}, {"type": "subtitle", "time": 6827.269, "timestamp": "01:53:47", "text": "薪割り作業。"}, {"type": "subtitle", "time": 6832.309, "timestamp": "01:53:52", "text": "ここでもう少し食べ物を買ってきます。わかった。"}, {"type": "subtitle", "time": 6834.23, "timestamp": "01:53:54", "text": "ああ、もうすぐ夜になる。"}, {"type": "subtitle", "time": 6837.03, "timestamp": "01:53:57", "text": "今。ああ、ここに小屋があるよ、"}, {"type": "subtitle", "time": 6839.269, "timestamp": "01:53:59", "text": "反対側。ああ、"}]
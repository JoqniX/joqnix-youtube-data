[{"type": "subtitle", "time": 18600.47, "timestamp": "05:10:00", "text": "誰が？誰かが靴を投げた。うん。おお、"}, {"type": "subtitle", "time": 18603.99, "timestamp": "05:10:03", "text": "彼は二階にいる。彼は二階にいる。そこには"}, {"type": "subtitle", "time": 18611.35, "timestamp": "05:10:11", "text": "えっと"}, {"type": "subtitle", "time": 18615.83, "timestamp": "05:10:15", "text": "ああ、あの場所は私たちが作ったんだ。"}, {"type": "subtitle", "time": 18619.43, "timestamp": "05:10:19", "text": "大丈夫です。私はそれを手に入れようとします"}, {"type": "subtitle", "time": 18623.03, "timestamp": "05:10:23", "text": "ああ、凍えるようなお風呂が見えますね。"}]
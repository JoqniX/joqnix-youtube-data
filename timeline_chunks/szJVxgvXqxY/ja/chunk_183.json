[{"type": "subtitle", "time": 10994.309, "timestamp": "03:03:14", "text": "兄弟。私が最後の一人だった。来て。何"}, {"type": "subtitle", "time": 10996.34, "timestamp": "03:03:16", "text": "の"}, {"type": "subtitle", "time": 11002.75, "timestamp": "03:03:22", "text": "えっ？えっと"}, {"type": "subtitle", "time": 11005.67, "timestamp": "03:03:25", "text": "あと、1つか2つくらいならプレイできるかな"}, {"type": "subtitle", "time": 11007.59, "timestamp": "03:03:27", "text": "素早いプレー。それから私は行かなければならない"}, {"type": "subtitle", "time": 11010.55, "timestamp": "03:03:30", "text": "だって食べてないんだもん。ああ、食べてないんだね。"}, {"type": "subtitle", "time": 11012.469, "timestamp": "03:03:32", "text": "昼食。"}, {"type": "subtitle", "time": 11015.83, "timestamp": "03:03:35", "text": "私はまだ朝食を食べていません。何てことだ。"}, {"type": "subtitle", "time": 11017.91, "timestamp": "03:03:37", "text": "うん。さよなら。"}, {"type": "subtitle", "time": 11020.63, "timestamp": "03:03:40", "text": "いつ目が覚めましたか？"}, {"type": "subtitle", "time": 11023.03, "timestamp": "03:03:43", "text": "あなたは、朝起きて"}, {"type": "subtitle", "time": 11026.229, "timestamp": "03:03:46", "text": "2時頃だったかな？うん。しかし"}, {"type": "subtitle", "time": 11029.11, "timestamp": "03:03:49", "text": "その前に私は起きなければならなかった"}, {"type": "subtitle", "time": 11032.95, "timestamp": "03:03:52", "text": "8時半に会議があって、それから終わった"}, {"type": "subtitle", "time": 11036.15, "timestamp": "03:03:56", "text": "午前10時。それでまた10時半に寝て"}]
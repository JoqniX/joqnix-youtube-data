[{"type": "subtitle", "time": 7681.15, "timestamp": "02:08:01", "text": "あなた。これは古代に生まれたものですか"}, {"type": "subtitle", "time": 7684.309, "timestamp": "02:08:04", "text": "入手？全く見当もつきません。何てことだ。"}, {"type": "subtitle", "time": 7686.429, "timestamp": "02:08:06", "text": "しないで"}, {"type": "subtitle", "time": 7688.389, "timestamp": "02:08:08", "text": "死ぬ。時間。死ぬな。死ぬな。しないで"}, {"type": "subtitle", "time": 7694.389, "timestamp": "02:08:14", "text": "よし、半分は終わったけど、まあ、できると思う"}, {"type": "subtitle", "time": 7707.99, "timestamp": "02:08:27", "text": "こいつら、ちょっと役に立たないんだよ、兄弟。"}, {"type": "subtitle", "time": 7710.67, "timestamp": "02:08:30", "text": "彼らは私たちを助けてくれなかった"}, {"type": "subtitle", "time": 7713.349, "timestamp": "02:08:33", "text": "全て。わかりました、でも私は鉄を買うことができます"}, {"type": "subtitle", "time": 7722.07, "timestamp": "02:08:42", "text": "おっと、この男はどうやって立ち上がったんだ"}, {"type": "subtitle", "time": 7728.59, "timestamp": "02:08:48", "text": "ええ、どういうわけかクリティカルヒットが出ました。"}, {"type": "subtitle", "time": 7732.87, "timestamp": "02:08:52", "text": "はい、7枚のコインです。"}, {"type": "subtitle", "time": 7735.59, "timestamp": "02:08:55", "text": "何か手に入れた。土地でエネルギーをチャージしよう"}, {"type": "subtitle", "time": 7737.67, "timestamp": "02:08:57", "text": "着陸時にクリティカルヒットが発生しました。同じだと思う"}]
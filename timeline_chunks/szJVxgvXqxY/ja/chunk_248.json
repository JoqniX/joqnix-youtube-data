[{"type": "chat", "time": 14880.174, "timestamp": "04:08:00", "author": "@natsukisouta", "avatar": "https://yt4.ggpht.com/DoWHfl2un-x9C1FjOZkls_H2TTeAipp9__JetXpYAJhuduFn6-Pn9_VXt5jORITV_b2weavr=s64-c-k-c0x00ffffff-no-rj", "message": "@Lord HeadAss STOP"}, {"type": "subtitle", "time": 14882.47, "timestamp": "04:08:02", "text": "特使？どうやって？いくつか異なる"}, {"type": "subtitle", "time": 14885.35, "timestamp": "04:08:05", "text": "都市国家の種類、そしてそれぞれが"}, {"type": "subtitle", "time": 14887.27, "timestamp": "04:08:07", "text": "さまざまなメリットを提供する"}, {"type": "chat", "time": 14887.414, "timestamp": "04:08:07", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "nuh uh"}, {"type": "subtitle", "time": 14890.07, "timestamp": "04:08:10", "text": "私たちの友情。わかった。私たちの政府"}, {"type": "subtitle", "time": 14893.03, "timestamp": "04:08:13", "text": "時間が経つにつれて、特使を獲得できるようになります"}, {"type": "subtitle", "time": 14895.35, "timestamp": "04:08:15", "text": "これらの関係を発展させるため。"}, {"type": "subtitle", "time": 14897.23, "timestamp": "04:08:17", "text": "ああ、わかりました。教えて"}, {"type": "subtitle", "time": 14900.55, "timestamp": "04:08:20", "text": "もっと。それはあなた次第です。わかった。あなたは"}, {"type": "subtitle", "time": 14903.11, "timestamp": "04:08:23", "text": "友人の州、都市、州を獲得し、"}, {"type": "subtitle", "time": 14905.35, "timestamp": "04:08:25", "text": "数多くの重要な利点。あなたはできる"}, {"type": "subtitle", "time": 14907.35, "timestamp": "04:08:27", "text": "それらを無視して、より大きなことに集中する"}, {"type": "subtitle", "time": 14909.67, "timestamp": "04:08:29", "text": "そしてさらに重要なこと。わかった。わかった。しかし、"}, {"type": "subtitle", "time": 14912.59, "timestamp": "04:08:32", "text": "問題は、私が心配しているのは"}, {"type": "subtitle", "time": 14914.83, "timestamp": "04:08:34", "text": "現時点での彼の。"}, {"type": "subtitle", "time": 14917.51, "timestamp": "04:08:37", "text": "ギルガメシュは、"}, {"type": "subtitle", "time": 14920.948, "timestamp": "04:08:40", "text": "彼に反対する者と戦争をするか、"}, {"type": "subtitle", "time": 14923.15, "timestamp": "04:08:43", "text": "何か、だって私は"}, {"type": "subtitle", "time": 14928.43, "timestamp": "04:08:48", "text": "心配した。そして私たちはトムと同盟を結びました"}, {"type": "subtitle", "time": 14931.23, "timestamp": "04:08:51", "text": "スカティアンのリアス"}, {"type": "subtitle", "time": 14937.19, "timestamp": "04:08:57", "text": "帝国。そう、スカティア帝国。"}]
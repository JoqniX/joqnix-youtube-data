[{"type": "subtitle", "time": 960.229, "timestamp": "00:16:00", "text": "それで"}, {"type": "subtitle", "time": 963.39, "timestamp": "00:16:03", "text": "えーっと、もし私の理解が正しければ"}, {"type": "subtitle", "time": 968.55, "timestamp": "00:16:08", "text": "えっと、あなたはインドネシア出身のユーチューバーですよね。"}, {"type": "subtitle", "time": 971.27, "timestamp": "00:16:11", "text": "あ、待って。えっと、インドネシアって何？"}, {"type": "subtitle", "time": 973.99, "timestamp": "00:16:13", "text": "わかった。うん。うん。わかった。わかった。こんにちは。"}, {"type": "subtitle", "time": 988.59, "timestamp": "00:16:28", "text": "ええ、12月でした"}, {"type": "subtitle", "time": 994.11, "timestamp": "00:16:34", "text": "2020年。2020年12月。2020年。ああ、"}, {"type": "subtitle", "time": 996.63, "timestamp": "00:16:36", "text": "うん。うん。そして私はとても活動的でした"}, {"type": "subtitle", "time": 999.11, "timestamp": "00:16:39", "text": "2021年には、"}, {"type": "subtitle", "time": 1002.07, "timestamp": "00:16:42", "text": "でも、人生にはいろいろなことが起こるものだ。それで、"}, {"type": "subtitle", "time": 1004.91, "timestamp": "00:16:44", "text": "うん。私は時々"}, {"type": "subtitle", "time": 1008.79, "timestamp": "00:16:48", "text": "2022年と2023年のようにストリーミング配信して、それから"}, {"type": "subtitle", "time": 1010.11, "timestamp": "00:16:50", "text": "その後"}]
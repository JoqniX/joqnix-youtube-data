[{"type": "subtitle", "time": 16743.67, "timestamp": "04:39:03", "text": "こんにちは、ゲームにご招待させてください。はい、"}, {"type": "subtitle", "time": 16746.23, "timestamp": "04:39:06", "text": "招待する。招待する。"}, {"type": "subtitle", "time": 16749.99, "timestamp": "04:39:09", "text": "君が速くプレーしているようには見えない"}, {"type": "subtitle", "time": 16753.35, "timestamp": "04:39:13", "text": "自分。そこにはない。あなたたちは友達ですか？うん。"}, {"type": "subtitle", "time": 16756.628, "timestamp": "04:39:16", "text": "うん。うん。私たちは友達ですよね？そして"}, {"type": "subtitle", "time": 16757.47, "timestamp": "04:39:17", "text": "うん。"}, {"type": "subtitle", "time": 16762.23, "timestamp": "04:39:22", "text": "ああ、待って。私は、"}, {"type": "subtitle", "time": 16764.31, "timestamp": "04:39:24", "text": "まずはロビーへ。うん、そうしないといけないと思うよ"}, {"type": "subtitle", "time": 16766.83, "timestamp": "04:39:26", "text": "まずはロビーを作る。ああ神様、1つ"}, {"type": "subtitle", "time": 16770.35, "timestamp": "04:39:30", "text": "2番。だから私はプレイします"}, {"type": "subtitle", "time": 16772.59, "timestamp": "04:39:32", "text": "ファスモフォビア"}, {"type": "subtitle", "time": 16775.43, "timestamp": "04:39:35", "text": "そしてそれは珍しいゲームで、"}, {"type": "subtitle", "time": 16777.868, "timestamp": "04:39:37", "text": "私は下手なので、プレイすることはめったにありません"}, {"type": "subtitle", "time": 16783.868, "timestamp": "04:39:43", "text": "ホラー。私は泣き叫ぶ"}, {"type": "subtitle", "time": 16788.628, "timestamp": "04:39:48", "text": "もっと。私の音量が少しおかしいです。"}, {"type": "subtitle", "time": 16793.47, "timestamp": "04:39:53", "text": "ゆっくりしてください。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 16797.27, "timestamp": "04:39:57", "text": "わかった。よし、もう一度挨拶しよう。こんにちは。こんにちは。"}]
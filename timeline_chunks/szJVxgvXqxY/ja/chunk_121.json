[{"type": "subtitle", "time": 7260.319, "timestamp": "02:01:00", "text": "外。私は死んだ。ああ、私は行く に"}, {"type": "subtitle", "time": 7267.429, "timestamp": "02:01:07", "text": "死ぬ。彼らは物を投げつけてくるかもしれない。私"}, {"type": "subtitle", "time": 7275.67, "timestamp": "02:01:15", "text": "トートバッグはなし。いや、いや、いや。なぜ私の"}, {"type": "subtitle", "time": 7278.63, "timestamp": "02:01:18", "text": "私の弓は発射できないのでしょうか？"}, {"type": "subtitle", "time": 7282.07, "timestamp": "02:01:22", "text": "あなたは弓を作りました。うん、私は作った、私は試した"}, {"type": "subtitle", "time": 7283.83, "timestamp": "02:01:23", "text": "お金を稼ぐが、そうではないようだ"}, {"type": "subtitle", "time": 7291.11, "timestamp": "02:01:31", "text": "神様の力で、"}, {"type": "subtitle", "time": 7293.51, "timestamp": "02:01:33", "text": "リスポーン？そうだったっけ？"}, {"type": "subtitle", "time": 7294.87, "timestamp": "02:01:34", "text": "私はそうは思わない、そうは思わない"}, {"type": "subtitle", "time": 7296.23, "timestamp": "02:01:36", "text": "リスポーン。全体を始めなければならない"}, {"type": "subtitle", "time": 7297.41, "timestamp": "02:01:37", "text": "もう一度考えてみよう。"}, {"type": "subtitle", "time": 7298.75, "timestamp": "02:01:38", "text": "[音楽]"}, {"type": "subtitle", "time": 7303.51, "timestamp": "02:01:43", "text": "おお。それはハードコアのようなものだ。私は思う"}, {"type": "subtitle", "time": 7307.269, "timestamp": "02:01:47", "text": "そうです。ロビーコードをお教えします"}, {"type": "subtitle", "time": 7309.429, "timestamp": "02:01:49", "text": "また。"}, {"type": "subtitle", "time": 7312.11, "timestamp": "02:01:52", "text": "わかった。"}, {"type": "subtitle", "time": 7314.51, "timestamp": "02:01:54", "text": "面白い。"}]
[{"type": "subtitle", "time": 4561.95, "timestamp": "01:16:01", "text": "ああ、なぜ私は"}, {"type": "subtitle", "time": 4574.109, "timestamp": "01:16:14", "text": "ショットガン。"}, {"type": "subtitle", "time": 4578.03, "timestamp": "01:16:18", "text": "えっと、ショットガンの弾薬はどこにあるんですか？"}, {"type": "subtitle", "time": 4580.229, "timestamp": "01:16:20", "text": "ショットガン。これはどれですか？ショットガン"}, {"type": "subtitle", "time": 4582.99, "timestamp": "01:16:22", "text": "再び弾薬を。えーと、ショットガンは"}, {"type": "subtitle", "time": 4586.629, "timestamp": "01:16:26", "text": "こんな感じの茶色。はい、はい。ここ。ここ"}, {"type": "subtitle", "time": 4593.23, "timestamp": "01:16:33", "text": "ほとんどない"}, {"type": "subtitle", "time": 4597.99, "timestamp": "01:16:37", "text": "気難しい。おお。とてもかわいい。"}, {"type": "subtitle", "time": 4600.389, "timestamp": "01:16:40", "text": "カニ、"}, {"type": "subtitle", "time": 4605.589, "timestamp": "01:16:45", "text": "左へ進む必要がある。はい。"}, {"type": "subtitle", "time": 4608.95, "timestamp": "01:16:48", "text": "これは何をするものですか？"}, {"type": "subtitle", "time": 4611.11, "timestamp": "01:16:51", "text": "おお。ああ、それはあなたに与えるものだと思います"}, {"type": "subtitle", "time": 4614.07, "timestamp": "01:16:54", "text": "移動速度とか、そういうこと。ああ、あなたは"}, {"type": "subtitle", "time": 4615.66, "timestamp": "01:16:55", "text": "アップグレードを受ける"}]
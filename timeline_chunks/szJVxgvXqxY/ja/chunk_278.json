[{"type": "subtitle", "time": 16682.43, "timestamp": "04:38:02", "text": "そしてあなたは後にやって来た"}, {"type": "subtitle", "time": 16684.948, "timestamp": "04:38:04", "text": "冒険。私たちは猫と遊んで"}, {"type": "subtitle", "time": 16688.51, "timestamp": "04:38:08", "text": "もの。なぜ覚えているのかわからない"}, {"type": "subtitle", "time": 16691.628, "timestamp": "04:38:11", "text": "それらの。こんなに長い"}, {"type": "subtitle", "time": 16693.99, "timestamp": "04:38:13", "text": "時間。こんにちは、マンゴー。ようこそ"}, {"type": "subtitle", "time": 16701.99, "timestamp": "04:38:21", "text": "たくさんのこと。"}, {"type": "subtitle", "time": 16705.11, "timestamp": "04:38:25", "text": "で、あなたは元気ですか？"}, {"type": "subtitle", "time": 16709.19, "timestamp": "04:38:29", "text": "私は大丈夫です。元気ですか？私は順調にやっている。"}, {"type": "subtitle", "time": 16712.31, "timestamp": "04:38:32", "text": "素晴らしい。突然寒くなったので"}, {"type": "subtitle", "time": 16714.628, "timestamp": "04:38:34", "text": "鼻水が出てるんだけど、他の"}, {"type": "subtitle", "time": 16717.43, "timestamp": "04:38:37", "text": "それ以上なら、私は大丈夫です。ええ、私は持っています"}, {"type": "subtitle", "time": 16722.03, "timestamp": "04:38:42", "text": "今日は鼻水が出ている。なんてこった。お早い回復を願っております。"}, {"type": "subtitle", "time": 16725.788, "timestamp": "04:38:45", "text": "ええ、それ以外は順調です。"}, {"type": "subtitle", "time": 16729.75, "timestamp": "04:38:49", "text": "うん。それは良いことです、私たちは"}, {"type": "subtitle", "time": 16732.548, "timestamp": "04:38:52", "text": "再び連絡を取り合って話せるようになった。そして"}, {"type": "subtitle", "time": 16734.708, "timestamp": "04:38:54", "text": "お越しいただきありがとうございます。本当は"}, {"type": "subtitle", "time": 16738.31, "timestamp": "04:38:58", "text": "多く。ありがとう。お招きいただきありがとうございます。"}]
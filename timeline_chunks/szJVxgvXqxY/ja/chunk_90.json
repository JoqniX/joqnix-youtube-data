[{"type": "subtitle", "time": 5404.03, "timestamp": "01:30:04", "text": "彼があなたを恋しがっていると言いましたか？"}, {"type": "subtitle", "time": 5412.07, "timestamp": "01:30:12", "text": "それで、また戻ってきますか？"}, {"type": "subtitle", "time": 5414.87, "timestamp": "01:30:14", "text": "将来的にストリーミング配信されるのでしょうか？ご希望ですか？"}, {"type": "subtitle", "time": 5417.11, "timestamp": "01:30:17", "text": "戻ってくる？"}, {"type": "subtitle", "time": 5419.23, "timestamp": "01:30:19", "text": "えっと、ちょっと"}, {"type": "subtitle", "time": 5422.79, "timestamp": "01:30:22", "text": "私は別の場所に住んでいるので難しいです"}, {"type": "subtitle", "time": 5426.469, "timestamp": "01:30:26", "text": "私は仕事をしていて、私のストリーミング設定は"}, {"type": "subtitle", "time": 5428.07, "timestamp": "01:30:28", "text": "家。"}, {"type": "subtitle", "time": 5429.91, "timestamp": "01:30:29", "text": "うん。ええ、その話は聞きましたよ。はい。"}, {"type": "subtitle", "time": 5436.309, "timestamp": "01:30:36", "text": "うん。君は家に帰ると思ったよ"}, {"type": "subtitle", "time": 5438.87, "timestamp": "01:30:38", "text": "週末。"}, {"type": "subtitle", "time": 5441.75, "timestamp": "01:30:41", "text": "今日はまるで過剰反応の日だったかのようだった。"}, {"type": "subtitle", "time": 5444.349, "timestamp": "01:30:44", "text": "ああ、今日は祝日だ。"}, {"type": "subtitle", "time": 5448.07, "timestamp": "01:30:48", "text": "ああ、大丈夫です。"}, {"type": "subtitle", "time": 5451.349, "timestamp": "01:30:51", "text": "ええ、だから今日は祝日なので"}, {"type": "subtitle", "time": 5456.78, "timestamp": "01:30:56", "text": "ニース。"}, {"type": "subtitle", "time": 5459.51, "timestamp": "01:30:59", "text": "[音楽]"}]
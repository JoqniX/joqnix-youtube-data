[{"type": "subtitle", "time": 18184.59, "timestamp": "05:03:04", "text": "持っていますか"}, {"type": "subtitle", "time": 18195.59, "timestamp": "05:03:15", "text": "待って。カメラは私が持っていきます。温めてください。"}, {"type": "subtitle", "time": 18197.61, "timestamp": "05:03:17", "text": "すごく暖かい。"}, {"type": "subtitle", "time": 18205.27, "timestamp": "05:03:25", "text": "待って、あなたはどこへ行くの？私は私を選びます。"}, {"type": "subtitle", "time": 18207.35, "timestamp": "05:03:27", "text": "カメラは私が持っていきます。私はここにいます。私は"}, {"type": "subtitle", "time": 18209.43, "timestamp": "05:03:29", "text": "ここ。"}, {"type": "subtitle", "time": 18212.868, "timestamp": "05:03:32", "text": "体温も測っておきましょう。わかった。"}, {"type": "subtitle", "time": 18225.03, "timestamp": "05:03:45", "text": "ああ、気温が上がってきている。"}, {"type": "subtitle", "time": 18228.39, "timestamp": "05:03:48", "text": "15まで行くよ。行きたいんだね"}]
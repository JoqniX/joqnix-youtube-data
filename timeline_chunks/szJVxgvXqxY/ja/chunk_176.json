[{"type": "subtitle", "time": 10561.83, "timestamp": "02:56:01", "text": "そして私は、なぜ私はこんなに頑張っているのかと思った"}, {"type": "subtitle", "time": 10563.429, "timestamp": "02:56:03", "text": "多くの？"}, {"type": "subtitle", "time": 10566.229, "timestamp": "02:56:06", "text": "銃弾を撃ちまくれ。"}, {"type": "subtitle", "time": 10568.389, "timestamp": "02:56:08", "text": "もっと"}, {"type": "subtitle", "time": 10569.91, "timestamp": "02:56:09", "text": "YouTube のコンテンツではなく、"}, {"type": "subtitle", "time": 10572.51, "timestamp": "02:56:12", "text": "競争的なもの"}, {"type": "subtitle", "time": 10576.07, "timestamp": "02:56:16", "text": "ヴァル。プレイしていた当時は配信していませんでした"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "私のノートパソコンが本当にひどかったから"}, {"type": "subtitle", "time": 10581.59, "timestamp": "02:56:21", "text": "当時。最近新しいものを手に入れました"}, {"type": "subtitle", "time": 10583.51, "timestamp": "02:56:23", "text": "ラップトップ、だから私は始めたんだ"}, {"type": "subtitle", "time": 10614.95, "timestamp": "02:56:54", "text": "私はここから出て行く。"}, {"type": "subtitle", "time": 10617.83, "timestamp": "02:56:57", "text": "私は自分がネオンカラーではないことを自覚している。"}, {"type": "subtitle", "time": 10619.75, "timestamp": "02:56:59", "text": "爽快だ。"}]
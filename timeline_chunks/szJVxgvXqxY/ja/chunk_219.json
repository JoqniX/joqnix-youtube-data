[{"type": "subtitle", "time": 13143.42, "timestamp": "03:39:03", "text": "右。それでは、テキスト通りに進めましょう。"}, {"type": "subtitle", "time": 13144.551, "timestamp": "03:39:04", "text": "[音楽]"}, {"type": "subtitle", "time": 13147.189, "timestamp": "03:39:07", "text": "だから、今回初めてローンチして"}, {"type": "subtitle", "time": 13149.59, "timestamp": "03:39:09", "text": "まだ何も設定していない"}, {"type": "subtitle", "time": 13153.109, "timestamp": "03:39:13", "text": "何でもいい。さあ、最善を尽くしましょう。"}, {"type": "subtitle", "time": 13154.75, "timestamp": "03:39:14", "text": "来る"}, {"type": "subtitle", "time": 13157.23, "timestamp": "03:39:17", "text": "の上。なぜ私は"}, {"type": "subtitle", "time": 13160.709, "timestamp": "03:39:20", "text": "あ、待って。キャプチャカードは、ああ、"}, {"type": "subtitle", "time": 13180.75, "timestamp": "03:39:40", "text": "行く。これで接続されたはずです。"}, {"type": "subtitle", "time": 13183.31, "timestamp": "03:39:43", "text": "スイッチ。全て"}, {"type": "subtitle", "time": 13186.91, "timestamp": "03:39:46", "text": "よし、行こう。シド・マイヤーズ市民"}, {"type": "subtitle", "time": 13188.59, "timestamp": "03:39:48", "text": "文明"}, {"type": "subtitle", "time": 13194.15, "timestamp": "03:39:54", "text": "6. 私が初めてプレイした戦略ゲーム。私の最初のえーと"}, {"type": "subtitle", "time": 13196.31, "timestamp": "03:39:56", "text": "世界構築戦略ゲーム。私は"}, {"type": "subtitle", "time": 13198.59, "timestamp": "03:39:58", "text": "初めて配信でプレイ"}]
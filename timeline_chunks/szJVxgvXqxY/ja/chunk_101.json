[{"type": "subtitle", "time": 6060.15, "timestamp": "01:41:00", "text": "ナツキのデビューを見逃してしまって、私はただ"}, {"type": "subtitle", "time": 6062.389, "timestamp": "01:41:02", "text": "デビューに向けて準備を進めているところだ。ああ、"}, {"type": "subtitle", "time": 6065.83, "timestamp": "01:41:05", "text": "ああ、彼のモデルは本当にカッコいい。"}, {"type": "subtitle", "time": 6068.23, "timestamp": "01:41:08", "text": "うん、彼のデビュー作は見るべきだよ"}, {"type": "subtitle", "time": 6070.389, "timestamp": "01:41:10", "text": "後でビデオを撮ったのは、まるで私が"}, {"type": "subtitle", "time": 6072.79, "timestamp": "01:41:12", "text": "まるでそれに膨大な時間を費やしたかのようだ。一日中"}, {"type": "subtitle", "time": 6075.11, "timestamp": "01:41:15", "text": "昨日、私は彼のビデオを編集していたところだった。"}, {"type": "subtitle", "time": 6078.23, "timestamp": "01:41:18", "text": "ああ、なんてことだ、あなたは彼を編集した。"}, {"type": "subtitle", "time": 6081.469, "timestamp": "01:41:21", "text": "彼のために編集しました。何てことだ。"}, {"type": "subtitle", "time": 6083.59, "timestamp": "01:41:23", "text": "ニース。それはすばらしい。私は忘れました"}, {"type": "subtitle", "time": 6086.469, "timestamp": "01:41:26", "text": "サムネイル。"}, {"type": "subtitle", "time": 6090.87, "timestamp": "01:41:30", "text": "基本的には、これは私のチャンネルです、愛しい人。"}, {"type": "subtitle", "time": 6094.309, "timestamp": "01:41:34", "text": "何てことだ。ニース。"}, {"type": "subtitle", "time": 6096.79, "timestamp": "01:41:36", "text": "彼の美的センスが大好きです。サメ"}, {"type": "subtitle", "time": 6099.51, "timestamp": "01:41:39", "text": "あれ。とても美味しいです。オーバーレイと"}, {"type": "subtitle", "time": 6108.23, "timestamp": "01:41:48", "text": "ナツキがサメみたいなのを想像できる"}, {"type": "subtitle", "time": 6110.63, "timestamp": "01:41:50", "text": "いつかロンパースを着る日が来るだろう。"}, {"type": "subtitle", "time": 6112.87, "timestamp": "01:41:52", "text": "うん。彼は実際にそれを買おうとしていた"}, {"type": "subtitle", "time": 6115.03, "timestamp": "01:41:55", "text": "数日前、彼はそれを持っていなかった"}, {"type": "subtitle", "time": 6117.11, "timestamp": "01:41:57", "text": "お金。彼は「ああ、買わないで」と言った。"}, {"type": "subtitle", "time": 6118.63, "timestamp": "01:41:58", "text": "「俺にとってはね」って感じ。「なあ、俺は金欠なんだ」って感じ。"}]
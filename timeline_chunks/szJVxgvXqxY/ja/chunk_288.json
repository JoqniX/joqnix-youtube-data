[{"type": "subtitle", "time": 17309.23, "timestamp": "04:48:29", "text": "はい、私は"}, {"type": "subtitle", "time": 17311.91, "timestamp": "04:48:31", "text": "これを載せるべきだと思う"}, {"type": "subtitle", "time": 17328.788, "timestamp": "04:48:48", "text": "それ。私が知っているのは、電磁波（EMF）が存在するということだけです。いいえ"}, {"type": "subtitle", "time": 17331.27, "timestamp": "04:48:51", "text": "凍えるほど寒いけどね。"}, {"type": "subtitle", "time": 17335.35, "timestamp": "04:48:55", "text": "それがファイルです。なんてこった。何てことだ。"}]
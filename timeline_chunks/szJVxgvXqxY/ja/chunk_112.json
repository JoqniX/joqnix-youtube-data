[{"type": "subtitle", "time": 6721.75, "timestamp": "01:52:01", "text": "できる。ああ、これもダメだ。おお、"}, {"type": "subtitle", "time": 6724.63, "timestamp": "01:52:04", "text": "一度に1つしか設置できません。なんてこった"}, {"type": "subtitle", "time": 6727.79, "timestamp": "01:52:07", "text": "男。はい、使ってみました"}, {"type": "subtitle", "time": 6730.469, "timestamp": "01:52:10", "text": "間違っている。今は正常に動作しています。私たちは料理できます"}, {"type": "subtitle", "time": 6733.269, "timestamp": "01:52:13", "text": "肉。 2つください。あなたも2つ取ります"}, {"type": "subtitle", "time": 6735.349, "timestamp": "01:52:15", "text": "肉の"}, {"type": "subtitle", "time": 6738.23, "timestamp": "01:52:18", "text": "そして、もっと食料を調達します。私はただ殺すだけです"}, {"type": "subtitle", "time": 6769.63, "timestamp": "01:52:49", "text": "取ることができます"}, {"type": "subtitle", "time": 6772.429, "timestamp": "01:52:52", "text": "石炭を入れています"}]
[{"type": "subtitle", "time": 6900.79, "timestamp": "01:55:00", "text": "向こう側からこちらへ来てください。所有"}, {"type": "subtitle", "time": 6903.51, "timestamp": "01:55:03", "text": "の上。持続する。こいつを殺させてくれ。私は"}, {"type": "subtitle", "time": 6908.469, "timestamp": "01:55:08", "text": "1馬力。なんてこった。でも私はHPユーザーです。"}, {"type": "subtitle", "time": 6910.71, "timestamp": "01:55:10", "text": "参加します。参加します。参加します。あ、待って。彼らは"}, {"type": "subtitle", "time": 6912.15, "timestamp": "01:55:12", "text": "壊すことができる 彼らは壊すことができる 彼らは壊すことができる"}, {"type": "subtitle", "time": 6915.75, "timestamp": "01:55:15", "text": "壁。何？"}, {"type": "subtitle", "time": 6919.03, "timestamp": "01:55:19", "text": "ええ、彼らは壁を傷つけています。"}, {"type": "subtitle", "time": 6926.23, "timestamp": "01:55:26", "text": "神。あらら。ああ、これはまずい。これは"}, {"type": "subtitle", "time": 6928.389, "timestamp": "01:55:28", "text": "悪い。これはまずい。ああ、"}, {"type": "subtitle", "time": 6929.349, "timestamp": "01:55:29", "text": "大釜。君は死ぬだろう。"}, {"type": "subtitle", "time": 6930.07, "timestamp": "01:55:30", "text": "君は死ぬだろう。あなたは"}, {"type": "subtitle", "time": 6936.23, "timestamp": "01:55:36", "text": "何も持っていません。その"}, {"type": "subtitle", "time": 6937.67, "timestamp": "01:55:37", "text": "それは、"}, {"type": "subtitle", "time": 6947.11, "timestamp": "01:55:47", "text": "あ、待って。在庫がなくなったの？"}, {"type": "subtitle", "time": 6949.269, "timestamp": "01:55:49", "text": "もう少し料理をしようと思う。あなたはできる"}, {"type": "subtitle", "time": 6951.59, "timestamp": "01:55:51", "text": "肉を取り出す"}]
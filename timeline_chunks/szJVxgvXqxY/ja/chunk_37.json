[{"type": "subtitle", "time": 2223.55, "timestamp": "00:37:03", "text": "右。どこが"}, {"type": "subtitle", "time": 2230.47, "timestamp": "00:37:10", "text": "急速なドロップ。"}, {"type": "subtitle", "time": 2232.55, "timestamp": "00:37:12", "text": "何の滴？どこ？知ってるでしょ、"}, {"type": "subtitle", "time": 2235.91, "timestamp": "00:37:15", "text": "ホットゾーン。そうそう。うん。そのその"}, {"type": "subtitle", "time": 2237.91, "timestamp": "00:37:17", "text": "いい戦利品だろ？きっとわかると思います"}, {"type": "subtitle", "time": 2240.75, "timestamp": "00:37:20", "text": "起きている間に、えーと"}, {"type": "subtitle", "time": 2244.47, "timestamp": "00:37:24", "text": "着陸した。あなたは今すぐ退場させられます。"}, {"type": "subtitle", "time": 2246.95, "timestamp": "00:37:26", "text": "ああ、そこに人々がいる。"}, {"type": "subtitle", "time": 2254.189, "timestamp": "00:37:34", "text": "そこには。よし、行こう"}, {"type": "subtitle", "time": 2256.95, "timestamp": "00:37:36", "text": "ここ。短機関銃。"}, {"type": "subtitle", "time": 2276.629, "timestamp": "00:37:56", "text": "[音楽]"}, {"type": "subtitle", "time": 2279.03, "timestamp": "00:37:59", "text": "略奪して準備を整えるつもりだ"}]
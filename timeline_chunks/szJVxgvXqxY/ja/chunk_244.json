[{"type": "subtitle", "time": 14641.51, "timestamp": "04:04:01", "text": "掘る。モノポリーに似ているが、もっと良い。"}, {"type": "subtitle", "time": 14644.19, "timestamp": "04:04:04", "text": "待って。独占。何？そうそう。こんにちは"}, {"type": "subtitle", "time": 14647.708, "timestamp": "04:04:07", "text": "カイ。政治と経済。"}, {"type": "subtitle", "time": 14651.43, "timestamp": "04:04:11", "text": "はい。政治と経済。今は"}, {"type": "subtitle", "time": 14653.41, "timestamp": "04:04:13", "text": "ジョッキーが学ぶ時が来た"}, {"type": "subtitle", "time": 14662.39, "timestamp": "04:04:22", "text": "歴史。ああ、大変だ。ミルクティーは"}, {"type": "subtitle", "time": 14663.47, "timestamp": "04:04:23", "text": "それで"}, {"type": "subtitle", "time": 14666.75, "timestamp": "04:04:26", "text": "良い。待って。ミルクティーはありません。それは牛乳だった。"}, {"type": "subtitle", "time": 14670.27, "timestamp": "04:04:30", "text": "うん。こんにちは。そこで、私たちはロックを解除しました"}, {"type": "subtitle", "time": 14676.03, "timestamp": "04:04:36", "text": "えっと、採掘と動物をアンロックしました"}, {"type": "subtitle", "time": 14683.708, "timestamp": "04:04:43", "text": "私たちには"}, {"type": "subtitle", "time": 14686.47, "timestamp": "04:04:46", "text": "作る。あ、待って。棘は何本あるだろうか"}, {"type": "subtitle", "time": 14689.47, "timestamp": "04:04:49", "text": "より簡単に手に入れるには？パート3に進みましょう"}, {"type": "subtitle", "time": 14693.91, "timestamp": "04:04:53", "text": "次に、ここへ進んでください。使用するのが最適です"}, {"type": "subtitle", "time": 14695.91, "timestamp": "04:04:55", "text": "敵に接近する際は注意が必要"}, {"type": "subtitle", "time": 14697.67, "timestamp": "04:04:57", "text": "単位。"}, {"type": "subtitle", "time": 14699.59, "timestamp": "04:04:59", "text": "ユニットを強制的に"}]
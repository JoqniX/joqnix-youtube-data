[{"type": "subtitle", "time": 7322.55, "timestamp": "02:02:02", "text": "神。それらは異なる種を持ち、"}, {"type": "subtitle", "time": 7329.5, "timestamp": "02:02:09", "text": "おお。よし、もう一度やり直すよ。"}, {"type": "subtitle", "time": 7330.95, "timestamp": "02:02:10", "text": "[音楽]"}, {"type": "subtitle", "time": 7332.469, "timestamp": "02:02:12", "text": "よし、少なくとも私たちはやり方を知っている"}, {"type": "subtitle", "time": 7334.79, "timestamp": "02:02:14", "text": "今回は早く始めよう。はい、そうです"}, {"type": "subtitle", "time": 7337.75, "timestamp": "02:02:17", "text": "前回はかろうじて運が良かった。私たちは"}, {"type": "subtitle", "time": 7374.15, "timestamp": "02:02:54", "text": "もっと木材を。ああ、なるほど、もっとよく見えました。それは"}, {"type": "subtitle", "time": 7376.469, "timestamp": "02:02:56", "text": "選手？選手のように見える。私"}, {"type": "subtitle", "time": 7377.83, "timestamp": "02:02:57", "text": "あれらは村人たちだと思う"}]
[{"type": "subtitle", "time": 14460.788, "timestamp": "04:01:00", "text": "他者の富を増やす。"}, {"type": "subtitle", "time": 14463.628, "timestamp": "04:01:03", "text": "聖なる。何てことだ。裁判所"}, {"type": "subtitle", "time": 14466.788, "timestamp": "04:01:06", "text": "法律と市民生活はあなたの人々と共に完了しました"}, {"type": "subtitle", "time": 14468.868, "timestamp": "04:01:08", "text": "法廷で裁判を経験することに興味がある。"}, {"type": "subtitle", "time": 14472.07, "timestamp": "04:01:12", "text": "政府の変更は無料です"}, {"type": "subtitle", "time": 14474.15, "timestamp": "04:01:14", "text": "市民の規律によって解錠される。"}, {"type": "subtitle", "time": 14476.868, "timestamp": "04:01:16", "text": "軍事調査。軍事神王。"}, {"type": "subtitle", "time": 14482.51, "timestamp": "04:01:22", "text": "経済的な都市計画。わかった。変化"}, {"type": "subtitle", "time": 14485.51, "timestamp": "04:01:25", "text": "方針。戦闘力が必要なのは"}, {"type": "subtitle", "time": 14488.55, "timestamp": "04:01:28", "text": "野蛮人と戦う。わかった。それが必要だ"}, {"type": "subtitle", "time": 14492.31, "timestamp": "04:01:32", "text": "今のところは戦うつもりだから"}, {"type": "subtitle", "time": 14495.628, "timestamp": "04:01:35", "text": "信仰と金"}, {"type": "subtitle", "time": 14498.59, "timestamp": "04:01:38", "text": "資本。これ"}, {"type": "subtitle", "time": 14508.96, "timestamp": "04:01:48", "text": "実際、これが我々の政策課題です。"}, {"type": "subtitle", "time": 14511.23, "timestamp": "04:01:51", "text": "[音楽]"}, {"type": "subtitle", "time": 14516.19, "timestamp": "04:01:56", "text": "はい。市民の手仕事を選びましょう"}, {"type": "subtitle", "time": 14519.15, "timestamp": "04:01:59", "text": "外国の職人技"}]
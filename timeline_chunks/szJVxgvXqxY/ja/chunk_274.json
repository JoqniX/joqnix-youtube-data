[{"type": "subtitle", "time": 16443.11, "timestamp": "04:34:03", "text": "ええと、15回です。どういう意味ですか？ああ、"}, {"type": "subtitle", "time": 16446.07, "timestamp": "04:34:06", "text": "そのEO、あるいはその成長。わかった、"}, {"type": "subtitle", "time": 16458.39, "timestamp": "04:34:18", "text": "神。ツンドラ。待って、アムステルダムって誰？"}, {"type": "subtitle", "time": 16462.75, "timestamp": "04:34:22", "text": "戦士？アムステルダムの人々は"}, {"type": "subtitle", "time": 16466.89, "timestamp": "04:34:26", "text": "まるで私たちに猛烈に攻撃を仕掛けてくるみたいだ。"}, {"type": "subtitle", "time": 16468.51, "timestamp": "04:34:28", "text": "[音楽]"}, {"type": "subtitle", "time": 16470.19, "timestamp": "04:34:30", "text": "わかった、"}, {"type": "subtitle", "time": 16472.548, "timestamp": "04:34:32", "text": "トレーナー。わかった。なぜあなたは私の"}, {"type": "subtitle", "time": 16475.75, "timestamp": "04:34:35", "text": "地域？こんにちは。書くことは共有することだ。"}, {"type": "subtitle", "time": 16477.99, "timestamp": "04:34:37", "text": "わかった。それは人間の宿命の一部だ"}, {"type": "subtitle", "time": 16480.628, "timestamp": "04:34:40", "text": "共有したいと思う。そして鍵のかかった図書館と"}, {"type": "subtitle", "time": 16482.03, "timestamp": "04:34:42", "text": "キャンパス。"}, {"type": "subtitle", "time": 16486.87, "timestamp": "04:34:46", "text": "わかった。研究を選びなさい。えっと、次は"}, {"type": "subtitle", "time": 16489.868, "timestamp": "04:34:49", "text": "[音楽]"}, {"type": "subtitle", "time": 16493.23, "timestamp": "04:34:53", "text": "次は"}, {"type": "subtitle", "time": 16495.2, "timestamp": "04:34:55", "text": "えーと"}, {"type": "subtitle", "time": 16498.35, "timestamp": "04:34:58", "text": "[音楽]"}]
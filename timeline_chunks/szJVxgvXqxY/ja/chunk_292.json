[{"type": "subtitle", "time": 17525.27, "timestamp": "04:52:05", "text": "我が神よ。全身真っ赤な男。何てことだ。"}, {"type": "subtitle", "time": 17527.99, "timestamp": "04:52:07", "text": "こんにちは。"}, {"type": "subtitle", "time": 17529.91, "timestamp": "04:52:09", "text": "ネズミ。"}, {"type": "subtitle", "time": 17530.91, "timestamp": "04:52:10", "text": "ああ、"}, {"type": "subtitle", "time": 17556.868, "timestamp": "04:52:36", "text": "出てきてもいいですよ。来てもいいですよ。できる"}, {"type": "subtitle", "time": 17557.628, "timestamp": "04:52:37", "text": "来る"}, {"type": "subtitle", "time": 17559.708, "timestamp": "04:52:39", "text": "外。おお、"}, {"type": "subtitle", "time": 17563.83, "timestamp": "04:52:43", "text": "わかった。わかった。来て。やってくる。どうすれば"}, {"type": "subtitle", "time": 17566.948, "timestamp": "04:52:46", "text": "うん。わかった。うん。わかった。開け方"}, {"type": "subtitle", "time": 17569.27, "timestamp": "04:52:49", "text": "はい、どうぞ。開け方"}]
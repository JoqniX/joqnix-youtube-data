[{"type": "subtitle", "time": 19149.75, "timestamp": "05:19:09", "text": "おお。 2階に上がったら右に曲がり、それから曲がってください"}, {"type": "subtitle", "time": 19154.67, "timestamp": "05:19:14", "text": "ここ"}, {"type": "subtitle", "time": 19165.59, "timestamp": "05:19:25", "text": "わかった。クルー効果をここに記載すべきでしょうか？"}, {"type": "subtitle", "time": 19167.83, "timestamp": "05:19:27", "text": "はい。はい。はい。部屋に置いてください。で"}, {"type": "subtitle", "time": 19194.39, "timestamp": "05:19:54", "text": "ああ、点線はあなたがつけたんですよね？うん。うん。"}]
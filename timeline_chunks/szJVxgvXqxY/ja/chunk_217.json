[{"type": "subtitle", "time": 13023.51, "timestamp": "03:37:03", "text": "どうすればいいですか どうすればいいですか ああ、わかりました。終わりました"}, {"type": "subtitle", "time": 13026.709, "timestamp": "03:37:06", "text": "ここ。プライバシー。いや、いや、いや、いや。すべて"}, {"type": "subtitle", "time": 13029.15, "timestamp": "03:37:09", "text": "こちらではダメです。何てことだ。"}, {"type": "subtitle", "time": 13032.59, "timestamp": "03:37:12", "text": "マイクロソフトについて"}, {"type": "subtitle", "time": 13035.67, "timestamp": "03:37:15", "text": "角。 Microsoft Edgeをメインブラウザに設定するにはどうすればよいですか？"}, {"type": "subtitle", "time": 13038.07, "timestamp": "03:37:18", "text": "デフォルト？私はHのデフォルトブラウザが好きです。"}, {"type": "subtitle", "time": 13039.91, "timestamp": "03:37:19", "text": "わかった。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 13044.15, "timestamp": "03:37:24", "text": "デフォルトにする。よし、これでゲームを終了しよう"}, {"type": "subtitle", "time": 13045.789, "timestamp": "03:37:25", "text": "そして再起動を試みる"}, {"type": "subtitle", "time": 13049.949, "timestamp": "03:37:29", "text": "それ。それが実現することを願っています"}, {"type": "subtitle", "time": 13053.67, "timestamp": "03:37:33", "text": "仕事。これが、人々があなたが"}, {"type": "subtitle", "time": 13058.23, "timestamp": "03:37:38", "text": "Braveのベータ版をインストールしないでください"}, {"type": "subtitle", "time": 13060.91, "timestamp": "03:37:40", "text": "ブラウザ。それは決して"}, {"type": "subtitle", "time": 13065.029, "timestamp": "03:37:45", "text": "仕事。よし、これでいい。うまくいった。切り替え"}, {"type": "subtitle", "time": 13069.83, "timestamp": "03:37:49", "text": "Epic Games を作る、私の 作らない"}, {"type": "subtitle", "time": 13073.59, "timestamp": "03:37:53", "text": "えーと、これはMicrosoft Edgeを作っている"}, {"type": "subtitle", "time": 13076.51, "timestamp": "03:37:56", "text": "デフォルトブラウザで問題なく動作しました。ああ、"}, {"type": "subtitle", "time": 13079.07, "timestamp": "03:37:59", "text": "神、"}]
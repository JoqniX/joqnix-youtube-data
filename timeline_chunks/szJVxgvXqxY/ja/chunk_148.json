[{"type": "subtitle", "time": 8881.83, "timestamp": "02:28:01", "text": "金。ああ、金のヘルメットとズボンと"}, {"type": "subtitle", "time": 8893.03, "timestamp": "02:28:13", "text": "うん。えっと、金塊がもう1つ必要ですか？"}, {"type": "subtitle", "time": 8894.63, "timestamp": "02:28:14", "text": "あるいは、何が必要ですか？ 1つ必要です"}, {"type": "subtitle", "time": 8899.71, "timestamp": "02:28:19", "text": "もっと金塊を。えっと、取って"}, {"type": "subtitle", "time": 8916.59, "timestamp": "02:28:36", "text": "私たちには必要だ"}, {"type": "subtitle", "time": 8919.83, "timestamp": "02:28:39", "text": "ああ、僕たちのためにチェストを作って、"}, {"type": "subtitle", "time": 8925.83, "timestamp": "02:28:45", "text": "うん。ええと、すでに宝箱が1つあります"}, {"type": "subtitle", "time": 8937.67, "timestamp": "02:28:57", "text": "彼らが胸を破壊できないことを願います。"}, {"type": "subtitle", "time": 8939.75, "timestamp": "02:28:59", "text": "すごく迷惑だろうな。"}]
[{"type": "subtitle", "time": 8645.83, "timestamp": "02:24:05", "text": "拾えると思います、"}, {"type": "subtitle", "time": 8648.309, "timestamp": "02:24:08", "text": "右？前回と同じように確認しました"}, {"type": "subtitle", "time": 8651.11, "timestamp": "02:24:11", "text": "クリックして、破壊されないようにしてください。"}, {"type": "subtitle", "time": 8653.309, "timestamp": "02:24:13", "text": "最後のことをすれば、それを拾い上げることができます"}, {"type": "subtitle", "time": 8656.469, "timestamp": "02:24:16", "text": "クリック。何てことだ。よし、止まれ"}, {"type": "subtitle", "time": 8671.91, "timestamp": "02:24:31", "text": "私は死にかけている。"}, {"type": "subtitle", "time": 8673.429, "timestamp": "02:24:33", "text": "死ぬ。いいえ。こちらへ来てください。ここに来て。来て"}, {"type": "subtitle", "time": 8675.59, "timestamp": "02:24:35", "text": "自分。うちにおいで。フェイントをかけて来ればいい。"}, {"type": "subtitle", "time": 8679.11, "timestamp": "02:24:39", "text": "ああ、君はもうダメかもしれないね。"}, {"type": "subtitle", "time": 8688.229, "timestamp": "02:24:48", "text": "もうすぐ時間です。必要なのは"}, {"type": "subtitle", "time": 8691.83, "timestamp": "02:24:51", "text": "あと数秒。ああ、これでいい。"}, {"type": "subtitle", "time": 8693.429, "timestamp": "02:24:53", "text": "何てことだ。まだ破壊しようとしている"}]
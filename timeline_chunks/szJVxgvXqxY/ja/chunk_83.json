[{"type": "subtitle", "time": 4981.91, "timestamp": "01:23:01", "text": "キャラクター。あれは何でしょう？それは"}, {"type": "subtitle", "time": 4983.83, "timestamp": "01:23:03", "text": "ハムスター？"}, {"type": "subtitle", "time": 5000.469, "timestamp": "01:23:20", "text": "身元不明。尻尾。私たちはそれを作る"}, {"type": "subtitle", "time": 5004.469, "timestamp": "01:23:24", "text": "魚のように見える。"}, {"type": "subtitle", "time": 5010.469, "timestamp": "01:23:30", "text": "よし。"}, {"type": "subtitle", "time": 5021.79, "timestamp": "01:23:41", "text": "えっと、"}, {"type": "subtitle", "time": 5023.71, "timestamp": "01:23:43", "text": "行く"}, {"type": "subtitle", "time": 5028.55, "timestamp": "01:23:48", "text": "ここ？そこはすごく奇妙な場所だった。もちろん。うん。"}, {"type": "subtitle", "time": 5030.07, "timestamp": "01:23:50", "text": "わかった。"}, {"type": "subtitle", "time": 5032.71, "timestamp": "01:23:52", "text": "ジャンプできると思う。うん。ええ、できますよ"}]
[{"type": "subtitle", "time": 9061.19, "timestamp": "02:31:01", "text": "ゴーレムは4体いる。"}, {"type": "subtitle", "time": 9062.95, "timestamp": "02:31:02", "text": "ああ、本当にここで死にたくないんだ。"}, {"type": "subtitle", "time": 9069.99, "timestamp": "02:31:09", "text": "今はただ走るだけでいい。今のところ。"}, {"type": "subtitle", "time": 9071.75, "timestamp": "02:31:11", "text": "私はただこれを手に入れたいだけです"}, {"type": "subtitle", "time": 9072.87, "timestamp": "02:31:12", "text": "死ぬ。ああ、彼は死んだんだ。彼は死んだ。彼は"}, {"type": "subtitle", "time": 9075.75, "timestamp": "02:31:15", "text": "死んだ。彼は死んだ。集中するんだ。集中する"}, {"type": "subtitle", "time": 9077.269, "timestamp": "02:31:17", "text": "1つに。どちらに焦点を当てるかは"}, {"type": "subtitle", "time": 9084.229, "timestamp": "02:31:24", "text": "よし、もう一人。"}, {"type": "subtitle", "time": 9086.79, "timestamp": "02:31:26", "text": "ニース。よし、これでいい。私たちは作っています"}, {"type": "subtitle", "time": 9089.03, "timestamp": "02:31:29", "text": "進捗。私は半分です。でもあなたはただ"}, {"type": "subtitle", "time": 9090.55, "timestamp": "02:31:30", "text": "はい、ワンタップです。私はワンタップです。私は"}, {"type": "subtitle", "time": 9091.95, "timestamp": "02:31:31", "text": "逃げ出すつもりだ"}, {"type": "subtitle", "time": 9102.469, "timestamp": "02:31:42", "text": "うん、ちょっと食事をするね。おお"}, {"type": "subtitle", "time": 9104.349, "timestamp": "02:31:44", "text": "しーい"}, {"type": "subtitle", "time": 9107.19, "timestamp": "02:31:47", "text": "亡くなった。私は生きている。大丈夫でしょう。する"}, {"type": "chat", "time": 9108.845, "timestamp": "02:31:48", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "Azura lapis!"}, {"type": "subtitle", "time": 9109.99, "timestamp": "02:31:49", "text": "コインは十分ありますか？"}, {"type": "subtitle", "time": 9113.19, "timestamp": "02:31:53", "text": "そう思います。復活トークンのところへ行ってください。えっと、"}, {"type": "subtitle", "time": 9117.269, "timestamp": "02:31:57", "text": "次はこっちへ来てください、だと思います。できる"}]
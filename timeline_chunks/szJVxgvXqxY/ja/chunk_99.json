[{"type": "subtitle", "time": 5941.51, "timestamp": "01:39:01", "text": "うん。私はナットに無理やり行かせるつもりだ"}, {"type": "subtitle", "time": 5943.11, "timestamp": "01:39:03", "text": "自分。"}, {"type": "subtitle", "time": 5946.469, "timestamp": "01:39:06", "text": "待って、ナツキ？うん、ナツキ。うん、"}, {"type": "subtitle", "time": 5955.27, "timestamp": "01:39:15", "text": "うん、そうだね、あぁ、君は彼を手に入れたんだね。"}, {"type": "subtitle", "time": 5957.63, "timestamp": "01:39:17", "text": "彼ならできるかもしれないと思う。"}, {"type": "subtitle", "time": 5961.19, "timestamp": "01:39:21", "text": "うん。だから、彼は10分くらい離れたところに"}, {"type": "subtitle", "time": 5969.469, "timestamp": "01:39:29", "text": "良い。ニース。"}, {"type": "subtitle", "time": 5972.79, "timestamp": "01:39:32", "text": "サナ。 Vubingの調子はどうですか？"}, {"type": "subtitle", "time": 5974.95, "timestamp": "01:39:34", "text": "デビューする予定だったと思いますか、"}, {"type": "subtitle", "time": 5978.469, "timestamp": "01:39:38", "text": "何かあるよね？いや、私は手伝っていたんです"}, {"type": "subtitle", "time": 5980.55, "timestamp": "01:39:40", "text": "あれがデビュー作だったんです。彼のデビューは"}, {"type": "subtitle", "time": 5983.75, "timestamp": "01:39:43", "text": "えっと、2日前くらいに彼を助けたんだ"}, {"type": "subtitle", "time": 5985.51, "timestamp": "01:39:45", "text": "プレゼンテーションをしたり、"}, {"type": "subtitle", "time": 5989.67, "timestamp": "01:39:49", "text": "彼のためにビデオを編集した。ああ、"}, {"type": "subtitle", "time": 5992.309, "timestamp": "01:39:52", "text": "そして私はただのパプアニューギニアのイモ職人です。私は持っていません"}, {"type": "subtitle", "time": 5995.07, "timestamp": "01:39:55", "text": "VTuberモデル。だから、私は実際には行かない"}, {"type": "subtitle", "time": 5999.27, "timestamp": "01:39:59", "text": "近いうちにデビューする予定はない。たぶんたぶん"}]
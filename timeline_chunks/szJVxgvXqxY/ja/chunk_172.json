[{"type": "subtitle", "time": 10321.57, "timestamp": "02:52:01", "text": "男。確か11年くらいだったと思う。"}, {"type": "subtitle", "time": 10331.51, "timestamp": "02:52:11", "text": "うわあ、これは砂糖だ。それはすごくクールだね。"}, {"type": "subtitle", "time": 10334.71, "timestamp": "02:52:14", "text": "以前は携帯電話で遊んでいて"}, {"type": "subtitle", "time": 10339.469, "timestamp": "02:52:19", "text": "その後、中に入って"}, {"type": "subtitle", "time": 10350.79, "timestamp": "02:52:30", "text": "2020年。追加しましたか？ ええ、追加しました。"}, {"type": "subtitle", "time": 10353.03, "timestamp": "02:52:33", "text": "リクエストを送信します。わかった。わかった。ああ、私は"}, {"type": "subtitle", "time": 10361.189, "timestamp": "02:52:41", "text": "それ。よし。さあ行こう。"}, {"type": "subtitle", "time": 10363.03, "timestamp": "02:52:43", "text": "しばらくプレイしていないので、"}, {"type": "subtitle", "time": 10366.15, "timestamp": "02:52:46", "text": "私はかなり下手かもしれない。"}, {"type": "subtitle", "time": 10366.91, "timestamp": "02:52:46", "text": "いいえ"}, {"type": "subtitle", "time": 10369.03, "timestamp": "02:52:49", "text": "心配事。チームデスマッチをやろう"}, {"type": "subtitle", "time": 10378.389, "timestamp": "02:52:58", "text": "はい。あなたはプラチナ1位です。何？"}]
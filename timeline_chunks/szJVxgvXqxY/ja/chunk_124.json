[{"type": "subtitle", "time": 7452.469, "timestamp": "02:04:12", "text": "ああ、そこには鉄鉱石がある。だから私たちは"}, {"type": "subtitle", "time": 7458.87, "timestamp": "02:04:18", "text": "ここには宝箱がたくさんある。あなたがすべき"}, {"type": "subtitle", "time": 7470.55, "timestamp": "02:04:30", "text": "「戦闘開始」と表示されます。いいえ、私はやりません"}, {"type": "subtitle", "time": 7474.03, "timestamp": "02:04:34", "text": "それ。それはメタルだ。"}, {"type": "subtitle", "time": 7493.59, "timestamp": "02:04:53", "text": "私たちが"}, {"type": "subtitle", "time": 7495.59, "timestamp": "02:04:55", "text": "彼らを攻撃せよ。"}, {"type": "subtitle", "time": 7499.59, "timestamp": "02:04:59", "text": "みんながあなたを攻撃するわけではありません"}]
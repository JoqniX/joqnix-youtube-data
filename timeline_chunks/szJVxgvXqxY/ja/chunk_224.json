[{"type": "subtitle", "time": 13447.15, "timestamp": "03:44:07", "text": "おお。ええと、畜産"}, {"type": "subtitle", "time": 13449.31, "timestamp": "03:44:09", "text": "採掘、航海"}, {"type": "subtitle", "time": 13453.51, "timestamp": "03:44:13", "text": "占星術。占星術を使ってもいいですか？いいえ。"}, {"type": "subtitle", "time": 13461.31, "timestamp": "03:44:21", "text": "今。"}, {"type": "subtitle", "time": 13469.67, "timestamp": "03:44:29", "text": "おお。ああ、これらは偉大な人々、あるいは"}, {"type": "subtitle", "time": 13471.99, "timestamp": "03:44:31", "text": "何か。わからない。"}, {"type": "subtitle", "time": 13474.708, "timestamp": "03:44:34", "text": "ええと、ミュージシャン、作家、偉大な科学者、"}, {"type": "subtitle", "time": 13477.59, "timestamp": "03:44:37", "text": "偉大な詩人、偉大なエンジニア、偉大な"}, {"type": "subtitle", "time": 13480.03, "timestamp": "03:44:40", "text": "提督、偉大な"}, {"type": "subtitle", "time": 13485.708, "timestamp": "03:44:45", "text": "一般的に、鉱業。ああ、ヤハラカ"}, {"type": "subtitle", "time": 13490.75, "timestamp": "03:44:50", "text": "未開拓の領土。何？何？"}, {"type": "subtitle", "time": 13493.91, "timestamp": "03:44:53", "text": "はぁ？彼らは戦士だ。彼らは私が作ることができます"}, {"type": "subtitle", "time": 13497.03, "timestamp": "03:44:57", "text": "彼らは農業の仕事をしているのか？あ、待って。"}]
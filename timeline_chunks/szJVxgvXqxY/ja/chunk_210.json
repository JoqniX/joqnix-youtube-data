[{"type": "subtitle", "time": 12600.07, "timestamp": "03:30:00", "text": "次のメールアドレス。わかった。わかった。私は必要としています"}, {"type": "subtitle", "time": 12602.63, "timestamp": "03:30:02", "text": "これを実行するため。何てことだ。"}, {"type": "subtitle", "time": 12605.91, "timestamp": "03:30:05", "text": "なぜこれらのゲームでは、"}, {"type": "subtitle", "time": 12614.11, "timestamp": "03:30:14", "text": "なぜ"}, {"type": "subtitle", "time": 12630.309, "timestamp": "03:30:30", "text": "11. ああ、そうだね。日付について話す"}, {"type": "subtitle", "time": 12632.79, "timestamp": "03:30:32", "text": "出産ですよね？"}, {"type": "subtitle", "time": 12633.95, "timestamp": "03:30:33", "text": "それで"}, {"type": "subtitle", "time": 12636.87, "timestamp": "03:30:36", "text": "えーと、家族の誰かがこれを尋ねた"}, {"type": "subtitle", "time": 12640.309, "timestamp": "03:30:40", "text": "最近。えっと、ジョック、前回は、えっと、前回"}, {"type": "subtitle", "time": 12644.229, "timestamp": "03:30:44", "text": "誕生日だったね、彼は言った、それは"}, {"type": "subtitle", "time": 12647.91, "timestamp": "03:30:47", "text": "えーと、あなたは、えーと、あなたは"}, {"type": "subtitle", "time": 12652.229, "timestamp": "03:30:52", "text": "何？あなたは20歳で、この誕生日を迎えます"}, {"type": "subtitle", "time": 12653.83, "timestamp": "03:30:53", "text": "80歳に戻るんですね。"}, {"type": "subtitle", "time": 12655.91, "timestamp": "03:30:55", "text": "ハプニング？"}]
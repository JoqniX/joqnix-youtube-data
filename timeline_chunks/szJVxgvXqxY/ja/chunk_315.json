[{"type": "subtitle", "time": 18900.788, "timestamp": "05:15:00", "text": "何てことだ。そうです。"}, {"type": "subtitle", "time": 18903.11, "timestamp": "05:15:03", "text": "いいえ、"}, {"type": "subtitle", "time": 18906.788, "timestamp": "05:15:06", "text": "私は物真似をする人が嫌いだ。"}, {"type": "subtitle", "time": 18910.23, "timestamp": "05:15:10", "text": "もう一人の幽霊を真似る、ですよね？"}, {"type": "subtitle", "time": 18919.83, "timestamp": "05:15:19", "text": "もう1つ挑戦してみよう。ええ、まだあります"}, {"type": "subtitle", "time": 18925.27, "timestamp": "05:15:25", "text": "時間。うん。次は私たちがやれる。"}, {"type": "subtitle", "time": 18929.43, "timestamp": "05:15:29", "text": "どれ？リバーストリートコートまたは"}, {"type": "subtitle", "time": 18933.43, "timestamp": "05:15:33", "text": "えっと、魚。ええ、魚ですね。はい。行く。さあ"}, {"type": "subtitle", "time": 18938.59, "timestamp": "05:15:38", "text": "行く。"}, {"type": "subtitle", "time": 18943.43, "timestamp": "05:15:43", "text": "怖い。怖い。これ。うん。ありがたいことに、私たちは"}, {"type": "subtitle", "time": 18947.59, "timestamp": "05:15:47", "text": "幽霊の頭と対峙するのは好きではなかった"}, {"type": "subtitle", "time": 18950.548, "timestamp": "05:15:50", "text": "まだオンになっていないと、私は叫んでいたでしょう"}, {"type": "subtitle", "time": 18954.15, "timestamp": "05:15:54", "text": "今すぐ。気をつけて。そしてそれはまるで"}, {"type": "subtitle", "time": 18955.99, "timestamp": "05:15:55", "text": "のように"}, {"type": "subtitle", "time": 18957.15, "timestamp": "05:15:57", "text": "そして"}]
[{"type": "subtitle", "time": 14760.708, "timestamp": "04:06:00", "text": "毒針。わかった、あなたが何を言っているのかわからない"}, {"type": "subtitle", "time": 14771.03, "timestamp": "04:06:11", "text": "親愛なる。えっと、なぜ人は物事を支配したがるのでしょうか？"}, {"type": "subtitle", "time": 14774.27, "timestamp": "04:06:14", "text": "ただの痛みだ。私にはもうわからない"}, {"type": "subtitle", "time": 14776.708, "timestamp": "04:06:16", "text": "もっと。待って、君がこんなの好きだったなんて知らなかったよ"}, {"type": "subtitle", "time": 14779.19, "timestamp": "04:06:19", "text": "ゲームの種類ですが、いや、私はどちらかというと"}, {"type": "subtitle", "time": 14781.75, "timestamp": "04:06:21", "text": "このタイプのゲームは初めてです。私は試しています"}, {"type": "subtitle", "time": 14784.07, "timestamp": "04:06:24", "text": "異なる新しいジャンルを探求しています"}, {"type": "subtitle", "time": 14786.51, "timestamp": "04:06:26", "text": "今までプレイしたことのないゲーム"}, {"type": "subtitle", "time": 14789.31, "timestamp": "04:06:29", "text": "前に。だから私にとっては、"}, {"type": "subtitle", "time": 14791.75, "timestamp": "04:06:31", "text": "私が好きでなくても構わない"}, {"type": "subtitle", "time": 14794.948, "timestamp": "04:06:34", "text": "ジャンルに関係なく。えっと、重要なのは私です"}, {"type": "subtitle", "time": 14798.07, "timestamp": "04:06:38", "text": "試してみて、その後戻ってきて"}, {"type": "subtitle", "time": 14800.948, "timestamp": "04:06:40", "text": "好きか嫌いかは別として。だから私は"}, {"type": "subtitle", "time": 14804.23, "timestamp": "04:06:44", "text": "FPSやRPGを全部プレイして、"}, {"type": "subtitle", "time": 14806.628, "timestamp": "04:06:46", "text": "MMO RPGみたいな感じですよね？だから私は"}]
[{"type": "subtitle", "time": 15841.75, "timestamp": "04:24:01", "text": "自分。あなたは決着をつけました。 「待て」と書いてありますか？"}, {"type": "subtitle", "time": 15844.31, "timestamp": "04:24:04", "text": "あなたは満足しました"}, {"type": "subtitle", "time": 15847.868, "timestamp": "04:24:07", "text": "えーと、トムス・エージェント・ザ・エクスプローラー。さようなら。"}, {"type": "subtitle", "time": 15857.788, "timestamp": "04:24:17", "text": "ああ、建築業者を見つけたよ。さあ"}, {"type": "subtitle", "time": 15861.39, "timestamp": "04:24:21", "text": "行く。ビルダーちゃん、行くよ"}, {"type": "subtitle", "time": 15869.11, "timestamp": "04:24:29", "text": "ここ。生産を選択してください。よし、今私は"}, {"type": "subtitle", "time": 15872.59, "timestamp": "04:24:32", "text": "建築業者を見つけたので、"}, {"type": "subtitle", "time": 15877.27, "timestamp": "04:24:37", "text": "アムステルダムと取引するトレーダー。私は待つ、"}, {"type": "subtitle", "time": 15878.35, "timestamp": "04:24:38", "text": "それは"}, {"type": "subtitle", "time": 15887.75, "timestamp": "04:24:47", "text": "レコメンダーを試してみてください。待って。私のものを改善してください。"}, {"type": "subtitle", "time": 15889.47, "timestamp": "04:24:49", "text": "私は持っていません"}, {"type": "subtitle", "time": 15896.35, "timestamp": "04:24:56", "text": "私の。"}]
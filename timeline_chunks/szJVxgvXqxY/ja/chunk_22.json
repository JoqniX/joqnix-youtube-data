[{"type": "subtitle", "time": 1323.03, "timestamp": "00:22:03", "text": "自分のアバターを作成する。ピクロ、"}, {"type": "subtitle", "time": 1326.709, "timestamp": "00:22:06", "text": "はぁ？ああ、プル。うん。うん。えっと、そして"}, {"type": "subtitle", "time": 1329.229, "timestamp": "00:22:09", "text": "そうすれば"}, {"type": "subtitle", "time": 1333.189, "timestamp": "00:22:13", "text": "上半身半身ショットのような"}, {"type": "subtitle", "time": 1337.35, "timestamp": "00:22:17", "text": "あなた自身が作成したアバターのことです。"}, {"type": "subtitle", "time": 1340.95, "timestamp": "00:22:20", "text": "そして、私はその一つを探していました"}, {"type": "subtitle", "time": 1347.189, "timestamp": "00:22:27", "text": "CC0 または使用できるもの"}, {"type": "subtitle", "time": 1351.189, "timestamp": "00:22:31", "text": "そして私は尋ねた"}, {"type": "subtitle", "time": 1353.51, "timestamp": "00:22:33", "text": "アーティスト、私のフィットスーパーに使えるなら"}, {"type": "subtitle", "time": 1356.47, "timestamp": "00:22:36", "text": "モデル、そしてアーティストは「ああ、そうだ」と言う"}, {"type": "subtitle", "time": 1358.07, "timestamp": "00:22:38", "text": "もちろん、あなたが"}, {"type": "subtitle", "time": 1360.39, "timestamp": "00:22:40", "text": "何も売らないならそれでいい。"}, {"type": "subtitle", "time": 1363.03, "timestamp": "00:22:43", "text": "そこで、私は上半身を使いました"}, {"type": "subtitle", "time": 1366.709, "timestamp": "00:22:46", "text": "そして私は底を描きました"}, {"type": "subtitle", "time": 1371.99, "timestamp": "00:22:51", "text": "そして私もそれを仕掛けて"}]
[{"type": "subtitle", "time": 15963.788, "timestamp": "04:26:03", "text": "[音楽]"}, {"type": "subtitle", "time": 15973.43, "timestamp": "04:26:13", "text": "あ、待って。あなたの鉱山事業は"}, {"type": "subtitle", "time": 15975.27, "timestamp": "04:26:15", "text": "車軸を作成する能力が与えられています。"}, {"type": "subtitle", "time": 15978.03, "timestamp": "04:26:18", "text": "ウィル・ウィル・ザ・ホイール"}, {"type": "subtitle", "time": 15985.07, "timestamp": "04:26:25", "text": "何？"}, {"type": "subtitle", "time": 15991.708, "timestamp": "04:26:31", "text": "[音楽]"}, {"type": "subtitle", "time": 15994.15, "timestamp": "04:26:34", "text": "アクシル。誰が来るの？誰かが話しているのが聞こえる"}, {"type": "subtitle", "time": 15995.91, "timestamp": "04:26:35", "text": "来るよ。ああ、カードですね。ああ、それは"}, {"type": "subtitle", "time": 16000.99, "timestamp": "04:26:40", "text": "シンディアのコード。はい、彼女のSCです。待って、"}, {"type": "subtitle", "time": 16005.628, "timestamp": "04:26:45", "text": "SC。よし、私はそれをシンディアと呼ぶことにしよう。ああ、"}, {"type": "subtitle", "time": 16009.15, "timestamp": "04:26:49", "text": "神。わかった。えっと"}, {"type": "subtitle", "time": 16012.59, "timestamp": "04:26:52", "text": "次のユニットがやって来ます"}]
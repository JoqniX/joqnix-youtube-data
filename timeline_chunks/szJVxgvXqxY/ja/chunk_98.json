[{"type": "subtitle", "time": 5880.63, "timestamp": "01:38:00", "text": "神。いつ私が"}, {"type": "subtitle", "time": 5885.79, "timestamp": "01:38:05", "text": "昨日。おそらくその頃でしょう。私"}, {"type": "subtitle", "time": 5890.15, "timestamp": "01:38:10", "text": "たぶん私は、えーと、試していたんだと思う"}, {"type": "subtitle", "time": 5893.03, "timestamp": "01:38:13", "text": "他の人のスケジュールを調整し、"}, {"type": "subtitle", "time": 5895.51, "timestamp": "01:38:15", "text": "それから、たぶん私は手を叩いたんだと思う。"}, {"type": "subtitle", "time": 5898.429, "timestamp": "01:38:18", "text": "その頃、私はあなたをIで見かけました"}, {"type": "subtitle", "time": 5901.59, "timestamp": "01:38:21", "text": "信じる。昨日、私があなたにDMを送りましたか？"}, {"type": "subtitle", "time": 5905.03, "timestamp": "01:38:25", "text": "夜？そうだったっけ？忘れていました。いや、私は"}, {"type": "subtitle", "time": 5907.11, "timestamp": "01:38:27", "text": "そう思う。いいえ、していません。私はしませんでした。わかった。"}, {"type": "subtitle", "time": 5910.309, "timestamp": "01:38:30", "text": "わかった。でも、私はあなたを見た、私はあなたを見た"}, {"type": "subtitle", "time": 5912.67, "timestamp": "01:38:32", "text": "だった"}, {"type": "subtitle", "time": 5916.87, "timestamp": "01:38:36", "text": "ああ、なんてことだ。相互にやり取りしていません。私たちは"}, {"type": "subtitle", "time": 5918.95, "timestamp": "01:38:38", "text": "それ以来、私たちはインターラクターで話していません"}, {"type": "subtitle", "time": 5922.55, "timestamp": "01:38:42", "text": "コミコンのことですよね？うん。"}, {"type": "subtitle", "time": 5925.11, "timestamp": "01:38:45", "text": "お会いできて光栄でした。トライアル"}, {"type": "subtitle", "time": 5928.95, "timestamp": "01:38:48", "text": "男。それは良かった。"}, {"type": "subtitle", "time": 5930.95, "timestamp": "01:38:50", "text": "うん。ムンバイに行くかもしれない"}, {"type": "subtitle", "time": 5934.79, "timestamp": "01:38:54", "text": "来年のコミコンとか。ああ、実際"}, {"type": "subtitle", "time": 5937.429, "timestamp": "01:38:57", "text": "ムンバイ・コミコン。ニース。ニース。それは"}, {"type": "subtitle", "time": 5939.83, "timestamp": "01:38:59", "text": "良い。それは良い。"}]
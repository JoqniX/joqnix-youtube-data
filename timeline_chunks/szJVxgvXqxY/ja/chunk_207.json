[{"type": "subtitle", "time": 12422.0, "timestamp": "03:27:02", "text": "午前中は最悪だ。私は決してそうあるべきではなかった 移動しました。なんてこった"}, {"type": "subtitle", "time": 12428.67, "timestamp": "03:27:08", "text": "さらに別の部分"}, {"type": "subtitle", "time": 12435.79, "timestamp": "03:27:15", "text": "さようなら。待って、どうやって"}, {"type": "subtitle", "time": 12438.75, "timestamp": "03:27:18", "text": "長さ？ちょっと待って、電話中だと思うんだけど"}, {"type": "subtitle", "time": 12441.309, "timestamp": "03:27:21", "text": "2つか"}, {"type": "subtitle", "time": 12443.75, "timestamp": "03:27:23", "text": "３回か何かの電話、"}, {"type": "subtitle", "time": 12445.55, "timestamp": "03:27:25", "text": "[音楽]"}, {"type": "subtitle", "time": 12448.03, "timestamp": "03:27:28", "text": "右？うん。私"}, {"type": "subtitle", "time": 12453.7, "timestamp": "03:27:33", "text": "早く終わってほしい、だってああ"}, {"type": "subtitle", "time": 12455.71, "timestamp": "03:27:35", "text": "[音楽]"}, {"type": "subtitle", "time": 12458.95, "timestamp": "03:27:38", "text": "痛み。ああ、これをやるのが忘れてた。えっと"}, {"type": "subtitle", "time": 12460.71, "timestamp": "03:27:40", "text": "待って、待って、待って、待って、待って。えっと"}, {"type": "subtitle", "time": 12469.11, "timestamp": "03:27:49", "text": "ゲーム。わかった。映画館は6です。わかった。さあ"}, {"type": "subtitle", "time": 12471.189, "timestamp": "03:27:51", "text": "行く。それと、チャットも始めさせてください。おお"}, {"type": "subtitle", "time": 12473.63, "timestamp": "03:27:53", "text": "我が神よ。私も同じです"}]
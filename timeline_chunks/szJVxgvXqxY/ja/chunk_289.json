[{"type": "subtitle", "time": 17345.19, "timestamp": "04:49:05", "text": "私はそれを消しました。そして消しました。"}, {"type": "subtitle", "time": 17365.83, "timestamp": "04:49:25", "text": "ゴースト作戦はなし。なんてこった。私は合図しなかった"}, {"type": "subtitle", "time": 17368.548, "timestamp": "04:49:28", "text": "検出器は正常に動作しました。チェックマークがあります"}, {"type": "subtitle", "time": 17371.35, "timestamp": "04:49:31", "text": "目的。"}, {"type": "subtitle", "time": 17375.47, "timestamp": "04:49:35", "text": "はい、そうしました。中に点を入れました。"}, {"type": "subtitle", "time": 17378.31, "timestamp": "04:49:38", "text": "ええ、一番上に写っているやつです。それは"}, {"type": "subtitle", "time": 17381.91, "timestamp": "04:49:41", "text": "の上？ああ、始まったよ。それは素晴らしい"}, {"type": "subtitle", "time": 17385.59, "timestamp": "04:49:45", "text": "赤信号。赤いレーザー。"}, {"type": "subtitle", "time": 17388.788, "timestamp": "04:49:48", "text": "おい。そう、これだよ。そうなんですか？"}, {"type": "subtitle", "time": 17390.708, "timestamp": "04:49:50", "text": "これはどうでしょう？私はこれを使う"}, {"type": "subtitle", "time": 17393.91, "timestamp": "04:49:53", "text": "そういう類のもの。いいえ、これはいいえ、いいえ、いいえ、"}, {"type": "subtitle", "time": 17395.27, "timestamp": "04:49:55", "text": "いいえ。あ、待って。"}, {"type": "subtitle", "time": 17398.39, "timestamp": "04:49:58", "text": "ここです。なんてこった。"}]
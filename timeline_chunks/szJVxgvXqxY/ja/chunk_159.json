[{"type": "subtitle", "time": 9544.229, "timestamp": "02:39:04", "text": "何てことだ。おお。ああ、わかりました。少なくとも"}, {"type": "subtitle", "time": 9547.51, "timestamp": "02:39:07", "text": "少なくとも私たちは、私たちが"}, {"type": "subtitle", "time": 9549.03, "timestamp": "02:39:09", "text": "金の道具を作らなければならないことを知っている"}, {"type": "subtitle", "time": 9551.429, "timestamp": "02:39:11", "text": "今。そう、金の道具だ。石器なし"}, {"type": "subtitle", "time": 9553.79, "timestamp": "02:39:13", "text": "どうやらこのゲームでは。"}, {"type": "subtitle", "time": 9567.19, "timestamp": "02:39:27", "text": "[音楽]"}, {"type": "subtitle", "time": 9569.91, "timestamp": "02:39:29", "text": "対比とは何ですか？"}, {"type": "subtitle", "time": 9571.75, "timestamp": "02:39:31", "text": "ああ、それはまるで私たちが勝ったようなものだと思う。私たちは勝った。"}, {"type": "subtitle", "time": 9574.95, "timestamp": "02:39:34", "text": "それを試してみたいですか？ええ、もちろんです。わかった。"}, {"type": "subtitle", "time": 9578.229, "timestamp": "02:39:38", "text": "それは何ですか？"}, {"type": "subtitle", "time": 9585.349, "timestamp": "02:39:45", "text": "わかった。ああ、私たちは遠く離れた場所にスポーンするんだと思う"}, {"type": "subtitle", "time": 9588.79, "timestamp": "02:39:48", "text": "お互いから離れて。"}, {"type": "subtitle", "time": 9591.03, "timestamp": "02:39:51", "text": "えっと、私たちは互いに競い合っていると思います"}, {"type": "subtitle", "time": 9593.11, "timestamp": "02:39:53", "text": "他の可能性もある。"}, {"type": "subtitle", "time": 9594.87, "timestamp": "02:39:54", "text": "ああ、それはスピードランのようなもので、誰が"}, {"type": "subtitle", "time": 9598.71, "timestamp": "02:39:58", "text": "もっと良いツールを手に入れたいですか？"}]
[{"type": "subtitle", "time": 17054.47, "timestamp": "04:44:14", "text": "その場所を浄化してください。さあ行こう。ああ、避けろ。"}, {"type": "subtitle", "time": 17056.15, "timestamp": "04:44:16", "text": "トーチ。"}, {"type": "subtitle", "time": 17058.948, "timestamp": "04:44:18", "text": "えっと、"}, {"type": "subtitle", "time": 17062.07, "timestamp": "04:44:22", "text": "目的を見ましたか？はい、"}, {"type": "subtitle", "time": 17064.39, "timestamp": "04:44:24", "text": "読み上げてください。"}, {"type": "subtitle", "time": 17069.23, "timestamp": "04:44:29", "text": "さあ、行こう。さあ、行こう。わかった、行って。ただ"}]
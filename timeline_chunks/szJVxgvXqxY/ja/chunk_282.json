[{"type": "subtitle", "time": 16920.15, "timestamp": "04:42:00", "text": "いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 16922.628, "timestamp": "04:42:02", "text": "機器管理とは何ですか？クイックロード"}, {"type": "subtitle", "time": 16924.99, "timestamp": "04:42:04", "text": "外。"}, {"type": "subtitle", "time": 16928.31, "timestamp": "04:42:08", "text": "おお。どうやってみんな頑張っているのか理解できない"}, {"type": "subtitle", "time": 16932.948, "timestamp": "04:42:12", "text": "これはパトリックのためのゲームです。理解できません。"}, {"type": "subtitle", "time": 16935.43, "timestamp": "04:42:15", "text": "幽霊を瞬時に見ることができる人もいる"}, {"type": "subtitle", "time": 16937.83, "timestamp": "04:42:17", "text": "そして、「ああ、これは確かに"}, {"type": "subtitle", "time": 16940.23, "timestamp": "04:42:20", "text": "幽霊の種類。 「来るように去る。」"}, {"type": "subtitle", "time": 16942.35, "timestamp": "04:42:22", "text": "できません。できません。とんでもない。"}, {"type": "subtitle", "time": 16946.548, "timestamp": "04:42:26", "text": "どうやって？何てことだ。魔法。魔法。"}, {"type": "subtitle", "time": 16949.11, "timestamp": "04:42:29", "text": "彼らは遊びすぎだ。"}, {"type": "subtitle", "time": 16952.15, "timestamp": "04:42:32", "text": "うん。彼らは遊びすぎだ。遊びすぎ。"}, {"type": "subtitle", "time": 16954.708, "timestamp": "04:42:34", "text": "プレイしたいマップはありますか？どれでも"}, {"type": "subtitle", "time": 16958.548, "timestamp": "04:42:38", "text": "プレイしたいマップは？えーと、"}, {"type": "subtitle", "time": 16961.03, "timestamp": "04:42:41", "text": "晴れやかなメダル。晴天時のメダルは制限されます。"}, {"type": "subtitle", "time": 16964.19, "timestamp": "04:42:44", "text": "ブラウン高校。えっと、"}, {"type": "subtitle", "time": 16968.23, "timestamp": "04:42:48", "text": "Mは小さな地図です。小型地図。私が"}, {"type": "subtitle", "time": 16972.23, "timestamp": "04:42:52", "text": "Hfield、Mitchfield、Craftton、Willow"}, {"type": "subtitle", "time": 16975.19, "timestamp": "04:42:55", "text": "通り。私は大丈夫です。タングルに行きたい"}]
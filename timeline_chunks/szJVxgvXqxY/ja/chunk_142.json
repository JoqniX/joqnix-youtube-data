[{"type": "subtitle", "time": 8522.389, "timestamp": "02:22:02", "text": "BL。あの、石炭はありますか？入手できますか？"}, {"type": "subtitle", "time": 8525.75, "timestamp": "02:22:05", "text": "石炭？私は石炭を３つ持っています。"}, {"type": "subtitle", "time": 8528.71, "timestamp": "02:22:08", "text": "よし、石炭を取りに行ってくるよ。ああ、それから"}, {"type": "subtitle", "time": 8531.59, "timestamp": "02:22:11", "text": "落とす。私は肉を全部入れた"}, {"type": "subtitle", "time": 8532.67, "timestamp": "02:22:12", "text": "持っている"}, {"type": "subtitle", "time": 8536.67, "timestamp": "02:22:16", "text": "大釜。"}, {"type": "subtitle", "time": 8539.83, "timestamp": "02:22:19", "text": "うん。うん。あの、あのね？この"}, {"type": "chat", "time": 8564.623, "timestamp": "02:22:44", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "the what guy?"}, {"type": "subtitle", "time": 8575.03, "timestamp": "02:22:55", "text": "そして手に入れた"}]
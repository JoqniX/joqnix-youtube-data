[{"type": "subtitle", "time": 16322.39, "timestamp": "04:32:02", "text": "私たちの都市間を結ぶ道路を整備する。道路"}, {"type": "subtitle", "time": 16324.948, "timestamp": "04:32:04", "text": "我々の部隊がこれ以上損なわれないようにする"}, {"type": "subtitle", "time": 16326.788, "timestamp": "04:32:06", "text": "険しい地形を抜けて"}, {"type": "subtitle", "time": 16328.35, "timestamp": "04:32:08", "text": "彼らは合格する。はい。"}, {"type": "subtitle", "time": 16336.51, "timestamp": "04:32:16", "text": "スメア"}, {"type": "subtitle", "time": 16339.91, "timestamp": "04:32:19", "text": "裏切り者、わかるかい？あなたは動くべきです、"}, {"type": "subtitle", "time": 16344.5, "timestamp": "04:32:24", "text": "子供の場合、"}, {"type": "subtitle", "time": 16374.91, "timestamp": "04:32:54", "text": "苦痛の市民たち。"}, {"type": "subtitle", "time": 16377.59, "timestamp": "04:32:57", "text": "わかった。待って、待って、待って。こちらでは、"}]
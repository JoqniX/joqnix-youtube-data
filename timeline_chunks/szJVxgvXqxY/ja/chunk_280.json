[{"type": "subtitle", "time": 16800.788, "timestamp": "04:40:00", "text": "こんにちは。よし、ずっと良くなった。"}, {"type": "subtitle", "time": 16806.708, "timestamp": "04:40:06", "text": "わかった。こんにちは。ええと、参加してください。ああ、あのコードね。"}, {"type": "subtitle", "time": 16808.868, "timestamp": "04:40:08", "text": "1秒。"}, {"type": "subtitle", "time": 16811.51, "timestamp": "04:40:11", "text": "どのサーバーですか？どのサーバーですか？私は"}, {"type": "subtitle", "time": 16814.07, "timestamp": "04:40:14", "text": "アジア。あなたはアジアにいるんですよね？はい。はい。"}, {"type": "subtitle", "time": 16816.548, "timestamp": "04:40:16", "text": "アジア。"}, {"type": "subtitle", "time": 16823.788, "timestamp": "04:40:23", "text": "えっと、待って。どうやって"}, {"type": "subtitle", "time": 16828.59, "timestamp": "04:40:28", "text": "あの、コードをもう一度入手するにはどうすればいいですか？ああ、"}, {"type": "subtitle", "time": 16832.31, "timestamp": "04:40:32", "text": "神。ロビーを作りました。スペースを作る。"}, {"type": "subtitle", "time": 16833.67, "timestamp": "04:40:33", "text": "うん、スペースを空けよう。するとコードが手に入ります"}, {"type": "subtitle", "time": 16836.548, "timestamp": "04:40:36", "text": "これから。"}, {"type": "subtitle", "time": 16839.67, "timestamp": "04:40:39", "text": "待って。あ、待って。あ、待って。私は持っていると思います"}, {"type": "subtitle", "time": 16842.628, "timestamp": "04:40:42", "text": "個人的なものを作る。ランダムな"}, {"type": "subtitle", "time": 16846.31, "timestamp": "04:40:46", "text": "人々が参加しました。何てことだ。えっと、これは私の"}, {"type": "subtitle", "time": 16849.11, "timestamp": "04:40:49", "text": "これをするのは初めてです。"}, {"type": "subtitle", "time": 16851.35, "timestamp": "04:40:51", "text": "普段は他の人が私を招待して、私は"}, {"type": "subtitle", "time": 16857.43, "timestamp": "04:40:57", "text": "私に部屋を作ってほしいのですか？わかった。"}]
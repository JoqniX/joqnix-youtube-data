[{"type": "subtitle", "time": 16565.83, "timestamp": "04:36:05", "text": "ああ、ヨーロッパのあなたの鉱山は災難に見舞われている"}, {"type": "subtitle", "time": 16571.67, "timestamp": "04:36:11", "text": "野蛮人によって。あ、待って。君は粗野だ。"}, {"type": "subtitle", "time": 16578.31, "timestamp": "04:36:18", "text": "ああ、なんてことだ。それを修正するにはビルドが必要です。"}, {"type": "subtitle", "time": 16586.708, "timestamp": "04:36:26", "text": "あなた。それらはまるでサラウンドのようだ。ああ、あなたは"}, {"type": "subtitle", "time": 16589.99, "timestamp": "04:36:29", "text": "範囲ではない。あなたはできないでしょう"}, {"type": "subtitle", "time": 16593.03, "timestamp": "04:36:33", "text": "遠距離から敵を攻撃する。あなたはそうしないでしょう"}, {"type": "subtitle", "time": 16597.19, "timestamp": "04:36:37", "text": "私の銅鉱山を苦しめる。ああ、それで、私は2つ手に入れました"}, {"type": "subtitle", "time": 16612.47, "timestamp": "04:36:52", "text": "わかった。こんにちは、みんな。では、始めましょう"}, {"type": "subtitle", "time": 16616.788, "timestamp": "04:36:56", "text": "本日3人目のゲストをお迎えします。我々は持っています"}, {"type": "subtitle", "time": 16618.948, "timestamp": "04:36:58", "text": "ジョブソン。"}]
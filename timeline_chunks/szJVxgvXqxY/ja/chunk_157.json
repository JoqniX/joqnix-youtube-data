[{"type": "subtitle", "time": 9429.269, "timestamp": "02:37:09", "text": "起こった。ああ、わかりました。負けたくない"}, {"type": "subtitle", "time": 9431.51, "timestamp": "02:37:11", "text": "私の持ち物。ああ、彼らは、私は彼らが"}, {"type": "subtitle", "time": 9432.51, "timestamp": "02:37:12", "text": "壊れた"}, {"type": "subtitle", "time": 9436.11, "timestamp": "02:37:16", "text": "ああ、後ろに人がいる"}, {"type": "subtitle", "time": 9438.55, "timestamp": "02:37:18", "text": "ここ。私は自分の能力を失うわけではないが、"}, {"type": "subtitle", "time": 9443.03, "timestamp": "02:37:23", "text": "アイテムを紛失したみたいですね。"}, {"type": "subtitle", "time": 9446.269, "timestamp": "02:37:26", "text": "私はすべてを失った。ああ、私は死んだ。私は"}, {"type": "subtitle", "time": 9453.11, "timestamp": "02:37:33", "text": "生き残る。生き残る。生き残る。生き残るには"}, {"type": "subtitle", "time": 9455.75, "timestamp": "02:37:35", "text": "あなたはできる。"}, {"type": "subtitle", "time": 9458.309, "timestamp": "02:37:38", "text": "ああ、すぐ隣にゴーレムがいる"}, {"type": "subtitle", "time": 9462.309, "timestamp": "02:37:42", "text": "私たち。まさにその通り"}, {"type": "subtitle", "time": 9464.95, "timestamp": "02:37:44", "text": "ただ生き延びるだけ。できるだけ生き延びてください"}, {"type": "subtitle", "time": 9467.91, "timestamp": "02:37:47", "text": "あなたはできる。ゆっくり進めてください。うん。もし私ができるなら"}, {"type": "subtitle", "time": 9469.99, "timestamp": "02:37:49", "text": "体力が減った奴らを殺せばいい、"}, {"type": "subtitle", "time": 9473.67, "timestamp": "02:37:53", "text": "そうすればもっとHPを稼げる。"}, {"type": "subtitle", "time": 9475.67, "timestamp": "02:37:55", "text": "ニース。ええと、安全策を取りましょう。安全策をとろう。"}]
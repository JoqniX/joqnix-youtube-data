[{"type": "subtitle", "time": 6602.71, "timestamp": "01:50:02", "text": "もう少し日光を浴びてください。"}, {"type": "subtitle", "time": 6606.55, "timestamp": "01:50:06", "text": "ああ、やばい、私は死ぬんだ。"}, {"type": "subtitle", "time": 6609.11, "timestamp": "01:50:09", "text": "ああ、彼はただ走り回っているだけだよ。私は推測する"}, {"type": "subtitle", "time": 6612.15, "timestamp": "01:50:12", "text": "もしかしたら彼は発射物のようなものを持っているのかもしれない"}, {"type": "subtitle", "time": 6613.75, "timestamp": "01:50:13", "text": "けれど。彼は骨のように投げることができる"}, {"type": "subtitle", "time": 6638.95, "timestamp": "01:50:38", "text": "ああ、わかった。リンゴを1個食べます。私たちはする必要があります"}, {"type": "subtitle", "time": 6641.75, "timestamp": "01:50:41", "text": "炉を作るんだ、だろ？大釜"}, {"type": "subtitle", "time": 6644.91, "timestamp": "01:50:44", "text": "炉。わかりました、"}, {"type": "subtitle", "time": 6655.91, "timestamp": "01:50:55", "text": "ここ。そして最後にX。"}, {"type": "subtitle", "time": 6659.03, "timestamp": "01:50:59", "text": "待って、これは変更できないよ。ああ、私たちは"}]
[{"type": "subtitle", "time": 17465.43, "timestamp": "04:51:05", "text": "サニタリーボックス？"}, {"type": "subtitle", "time": 17469.708, "timestamp": "04:51:09", "text": "H型スピリットボックス。こんにちは。ついに来た。さあ"}, {"type": "subtitle", "time": 17478.15, "timestamp": "04:51:18", "text": "入って。入って。わかった。入れ。入れ。そうだ。"}, {"type": "subtitle", "time": 17501.19, "timestamp": "04:51:41", "text": "それは彼らを凍らせた。凍り始めている。ああ、"}, {"type": "subtitle", "time": 17502.788, "timestamp": "04:51:42", "text": "神。何てことだ。何てことだ。何てことだ。"}, {"type": "subtitle", "time": 17511.99, "timestamp": "04:51:51", "text": "うん。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 17514.75, "timestamp": "04:51:54", "text": "何てことだ。何てことだ、"}, {"type": "subtitle", "time": 17518.708, "timestamp": "04:51:58", "text": "兄弟。少年が死んでいる。いいえ、それはああ"}]
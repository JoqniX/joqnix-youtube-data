[{"type": "subtitle", "time": 13860.91, "timestamp": "03:51:00", "text": "私は作りますか"}, {"type": "subtitle", "time": 13863.83, "timestamp": "03:51:03", "text": "人々？それが私の疑問です。作業者"}, {"type": "subtitle", "time": 13875.868, "timestamp": "03:51:15", "text": "市民。"}, {"type": "subtitle", "time": 13879.67, "timestamp": "03:51:19", "text": "えっと、私も金が必要なんです。どうやって作るの？"}, {"type": "subtitle", "time": 13893.628, "timestamp": "03:51:33", "text": "あらら。彼は"}, {"type": "subtitle", "time": 13897.39, "timestamp": "03:51:37", "text": "殺す？彼は殺人をするつもりなのか？"}, {"type": "subtitle", "time": 13906.708, "timestamp": "03:51:46", "text": "行くの？待って、他のってどういう意味？"}, {"type": "subtitle", "time": 13909.11, "timestamp": "03:51:49", "text": "人々は順番に利用しているのですか？ありますか"}, {"type": "subtitle", "time": 13911.91, "timestamp": "03:51:51", "text": "この世界の他の人々と同じように？私"}, {"type": "subtitle", "time": 13913.23, "timestamp": "03:51:53", "text": "たったそれだけだと思った"}, {"type": "subtitle", "time": 13916.708, "timestamp": "03:51:56", "text": "主よ、私を。ギルガメシュ王のように。それは"}]
[{"type": "subtitle", "time": 5583.349, "timestamp": "01:33:03", "text": "YouTube、Twitch、えーと、彼女をフォローしてください。"}, {"type": "subtitle", "time": 5584.429, "timestamp": "01:33:04", "text": "また"}, {"type": "subtitle", "time": 5586.83, "timestamp": "01:33:06", "text": "インスタグラムと"}, {"type": "subtitle", "time": 5590.07, "timestamp": "01:33:10", "text": "ツイッターと、彼女がオフィスに行くこと。"}, {"type": "subtitle", "time": 5596.91, "timestamp": "01:33:16", "text": "本日はありがとうございました。本当に楽しかったです。"}, {"type": "subtitle", "time": 5600.87, "timestamp": "01:33:20", "text": "あ、こんにちは。えっと、ちょっと待ってください。えっと、"}, {"type": "subtitle", "time": 5603.99, "timestamp": "01:33:23", "text": "えっと、サムネイルを更新しただけです。私"}, {"type": "subtitle", "time": 5607.67, "timestamp": "01:33:27", "text": "3人目のゲストのサムネイルを載せるのを忘れていました。"}, {"type": "subtitle", "time": 5610.75, "timestamp": "01:33:30", "text": "えーと、次は"}, {"type": "subtitle", "time": 5613.59, "timestamp": "01:33:33", "text": "トットム。私たちはムクと対戦します。えっと、その前に"}, {"type": "subtitle", "time": 5615.99, "timestamp": "01:33:35", "text": "トットゥムを連れてきました。ちょっとアップデートさせてください。"}, {"type": "subtitle", "time": 5619.19, "timestamp": "01:33:39", "text": "YouTubeのサムネイルをさっと作ります。"}, {"type": "subtitle", "time": 5621.83, "timestamp": "01:33:41", "text": "そして昨日寝てしまって忘れてしまった"}, {"type": "subtitle", "time": 5623.83, "timestamp": "01:33:43", "text": "最後の３つの要約を載せる"}, {"type": "subtitle", "time": 5626.07, "timestamp": "01:33:46", "text": "日。だから私は今日のことを書かなければならない"}, {"type": "subtitle", "time": 5629.87, "timestamp": "01:33:49", "text": "良い。つまり4つ。そうそう。わかった。させて"}, {"type": "subtitle", "time": 5633.51, "timestamp": "01:33:53", "text": "私が彼らを配置した。こんにちは。電話します"}, {"type": "subtitle", "time": 5635.67, "timestamp": "01:33:55", "text": "もう少ししたら。 1秒。まずは"}]
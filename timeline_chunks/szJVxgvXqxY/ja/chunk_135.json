[{"type": "subtitle", "time": 8100.91, "timestamp": "02:15:00", "text": "行くのが一番良いでしょう"}, {"type": "subtitle", "time": 8103.19, "timestamp": "02:15:03", "text": "そこには。本当にイライラする。私たちはただ"}, {"type": "subtitle", "time": 8106.87, "timestamp": "02:15:06", "text": "作業台を持ち上げろ。"}, {"type": "subtitle", "time": 8109.429, "timestamp": "02:15:09", "text": "うん。あ、ちょっと待ってください。 1秒。ああ、君"}, {"type": "subtitle", "time": 8110.71, "timestamp": "02:15:10", "text": "両方。はい、大丈夫です。大丈夫です。その"}, {"type": "subtitle", "time": 8113.15, "timestamp": "02:15:13", "text": "大丈夫。私"}, {"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "つまり、こういうタイプのカートがあるんです。"}, {"type": "subtitle", "time": 8125.269, "timestamp": "02:15:25", "text": "左側のもの。そこへ行こう"}, {"type": "subtitle", "time": 8137.83, "timestamp": "02:15:37", "text": "おい、ここに宝箱が2つあるぞ。私は私は"}, {"type": "subtitle", "time": 8140.309, "timestamp": "02:15:40", "text": "1つ取れば、あなたも1つ取れます。手に入れた"}, {"type": "subtitle", "time": 8144.55, "timestamp": "02:15:44", "text": "ボートマップ。ボートマップ。これは何ですか？私"}, {"type": "subtitle", "time": 8147.59, "timestamp": "02:15:47", "text": "宝箱みたいなものかな。"}, {"type": "subtitle", "time": 8150.349, "timestamp": "02:15:50", "text": "そうそう。それは"}, {"type": "subtitle", "time": 8153.75, "timestamp": "02:15:53", "text": "宝物、かな。本当に"}, {"type": "subtitle", "time": 8158.07, "timestamp": "02:15:58", "text": "遠く離れた。ああ、あれらは、ああ、どうですか"}]
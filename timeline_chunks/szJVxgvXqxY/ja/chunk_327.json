[{"type": "subtitle", "time": 19620.23, "timestamp": "05:27:00", "text": "疲れた。眠くて疲れていると思う"}, {"type": "subtitle", "time": 19623.868, "timestamp": "05:27:03", "text": "今。はい。そして、ええ、気をつけて"}, {"type": "subtitle", "time": 19629.03, "timestamp": "05:27:09", "text": "あなた自身。もっと水。はい。はい。はい。"}, {"type": "subtitle", "time": 19632.23, "timestamp": "05:27:12", "text": "こんにちは。そして、それについてありがとうございました。そしてあなたは"}, {"type": "subtitle", "time": 19634.788, "timestamp": "05:27:14", "text": "今後、再びストリーミング配信を行う予定ですか？はい。"}, {"type": "subtitle", "time": 19639.59, "timestamp": "05:27:19", "text": "はい。ほとんどの場合。はい。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 19641.11, "timestamp": "05:27:21", "text": "お帰りになる前に、何か"}, {"type": "subtitle", "time": 19643.43, "timestamp": "05:27:23", "text": "メッセージやその他何か"}, {"type": "subtitle", "time": 19645.83, "timestamp": "05:27:25", "text": "何か発表とか？ありがとうございます"}, {"type": "subtitle", "time": 19648.788, "timestamp": "05:27:28", "text": "私を連れて行く。とても楽しかった。たとえそれが"}, {"type": "subtitle", "time": 19652.708, "timestamp": "05:27:32", "text": "ほんの数試合だった。うん。次回"}, {"type": "subtitle", "time": 19655.03, "timestamp": "05:27:35", "text": "多分またマインクラフトをプレイするだろう。はい。はい。"}, {"type": "subtitle", "time": 19656.788, "timestamp": "05:27:36", "text": "はい。私たちはマインクラフトをプレイするべきだ"}, {"type": "subtitle", "time": 19658.99, "timestamp": "05:27:38", "text": "また。"}, {"type": "subtitle", "time": 19662.15, "timestamp": "05:27:42", "text": "次は日本に行きたいな"}, {"type": "subtitle", "time": 19665.03, "timestamp": "05:27:45", "text": "あるいは、おそらく何か別のことだろう。それで"}, {"type": "subtitle", "time": 19667.83, "timestamp": "05:27:47", "text": "私は日本のどの地域が好きですか"}, {"type": "subtitle", "time": 19671.468, "timestamp": "05:27:51", "text": "大阪、東京？ GMAに出演します。"}, {"type": "subtitle", "time": 19673.99, "timestamp": "05:27:53", "text": "GMA GMA。"}, {"type": "subtitle", "time": 19679.11, "timestamp": "05:27:59", "text": "G：聞いたことがない。 GMAは「うーん」って感じ"}]
[{"type": "subtitle", "time": 7920.63, "timestamp": "02:12:00", "text": "私は私であり、彼らは"}, {"type": "subtitle", "time": 7923.19, "timestamp": "02:12:03", "text": "私の前に現れた。何てことだ。ああ、"}, {"type": "subtitle", "time": 7924.79, "timestamp": "02:12:04", "text": "神。"}, {"type": "subtitle", "time": 7927.469, "timestamp": "02:12:07", "text": "大丈夫。それ"}, {"type": "subtitle", "time": 7930.75, "timestamp": "02:12:10", "text": "起こる。始めましょう"}, {"type": "subtitle", "time": 7935.95, "timestamp": "02:12:15", "text": "また。私たちも非常に良いスタートを切った。"}, {"type": "subtitle", "time": 7942.469, "timestamp": "02:12:22", "text": "私はコードを理解しています。はい、ありがとうございます。"}, {"type": "subtitle", "time": 7944.55, "timestamp": "02:12:24", "text": "新しいコードを書くのは本当に面倒くさい"}, {"type": "subtitle", "time": 7947.19, "timestamp": "02:12:27", "text": "時間。"}, {"type": "subtitle", "time": 7949.349, "timestamp": "02:12:29", "text": "難易度をイージーにした方が良いでしょうか？だから、"}, {"type": "subtitle", "time": 7964.71, "timestamp": "02:12:44", "text": "それで、デビューする予定はありますか？"}, {"type": "subtitle", "time": 7966.469, "timestamp": "02:12:46", "text": "とかそういうの？"}, {"type": "subtitle", "time": 7969.91, "timestamp": "02:12:49", "text": "えっと、今はいいえ、だって私は"}, {"type": "subtitle", "time": 7972.23, "timestamp": "02:12:52", "text": "VTuberモデルを持っていて、私が試したように"}, {"type": "subtitle", "time": 7974.79, "timestamp": "02:12:54", "text": "手早く作ってやり直すような感じだけど、"}, {"type": "subtitle", "time": 7976.63, "timestamp": "02:12:56", "text": "時間がかかりすぎることに気づいた"}]
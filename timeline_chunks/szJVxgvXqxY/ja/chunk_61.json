[{"type": "subtitle", "time": 3662.95, "timestamp": "01:01:02", "text": "彼に手榴弾を投げさせなかった"}, {"type": "subtitle", "time": 3681.19, "timestamp": "01:01:21", "text": "完了"}, {"type": "subtitle", "time": 3694.35, "timestamp": "01:01:34", "text": "手榴弾。よし。"}, {"type": "subtitle", "time": 3697.47, "timestamp": "01:01:37", "text": "H. どこで"}, {"type": "subtitle", "time": 3700.31, "timestamp": "01:01:40", "text": "行く？これ。ああ、おそらく多くの人が"}, {"type": "subtitle", "time": 3704.47, "timestamp": "01:01:44", "text": "けれど。あなたが望むならそこへ行ってもいいですが"}, {"type": "subtitle", "time": 3707.07, "timestamp": "01:01:47", "text": "さあ行こう。よし、行こう。"}, {"type": "subtitle", "time": 3709.95, "timestamp": "01:01:49", "text": "いいえ。わかりました。"}, {"type": "subtitle", "time": 3718.95, "timestamp": "01:01:58", "text": "ああ、レベル３か。わかった、会おう"}]
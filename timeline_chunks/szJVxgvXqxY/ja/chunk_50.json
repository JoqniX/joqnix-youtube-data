[{"type": "subtitle", "time": 3014.03, "timestamp": "00:50:14", "text": "一番下に別の誰かがいる。"}, {"type": "subtitle", "time": 3018.149, "timestamp": "00:50:18", "text": "ああ、あと少しだ。"}, {"type": "subtitle", "time": 3020.149, "timestamp": "00:50:20", "text": "おい、君の車だ。"}, {"type": "subtitle", "time": 3040.91, "timestamp": "00:50:40", "text": "もう一度、銃撃の狂乱状態に戻りたいですか？"}, {"type": "subtitle", "time": 3043.86, "timestamp": "00:50:43", "text": "うん。敵が来る。"}, {"type": "subtitle", "time": 3053.91, "timestamp": "00:50:53", "text": "前回は何を使ったっけ？ああ、とても"}, {"type": "subtitle", "time": 3056.07, "timestamp": "00:50:56", "text": "多くの武器。"}, {"type": "subtitle", "time": 3058.31, "timestamp": "00:50:58", "text": "それはショットガンだ。"}]
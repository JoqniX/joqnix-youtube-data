[{"type": "subtitle", "time": 9002.469, "timestamp": "02:30:02", "text": "自分。どれくらいのダメージを与えたら"}, {"type": "subtitle", "time": 9005.59, "timestamp": "02:30:05", "text": "彼に危害を加えるな。私はここで料理されてしまった。"}, {"type": "subtitle", "time": 9008.55, "timestamp": "02:30:08", "text": "もう完全に疲れ果てた。何てことだ。どうやって"}, {"type": "subtitle", "time": 9011.99, "timestamp": "02:30:11", "text": "土パックの使い方は？"}, {"type": "subtitle", "time": 9013.91, "timestamp": "02:30:13", "text": "えーっと、もっと高くジャンプして"}, {"type": "subtitle", "time": 9015.03, "timestamp": "02:30:15", "text": "大したことはない。ああ、なんてことだ、彼は"}, {"type": "subtitle", "time": 9022.71, "timestamp": "02:30:22", "text": "ゴーレムにはあまりダメージを与えられません。"}, {"type": "subtitle", "time": 9029.349, "timestamp": "02:30:29", "text": "ダメージ。彼はとても健康だ。ああ、"}, {"type": "subtitle", "time": 9032.229, "timestamp": "02:30:32", "text": "神。なぜこんなに難しくなっているのか？私"}, {"type": "subtitle", "time": 9042.309, "timestamp": "02:30:42", "text": "日。大丈夫。私は"}, {"type": "subtitle", "time": 9045.99, "timestamp": "02:30:45", "text": "ゴーレム。はい。わかった、全部"}, {"type": "subtitle", "time": 9047.269, "timestamp": "02:30:47", "text": "他の連中。ああ、なんてことだ、"}, {"type": "subtitle", "time": 9049.51, "timestamp": "02:30:49", "text": "別のゴーレム。ゴーレムが３体いる。"}, {"type": "subtitle", "time": 9051.59, "timestamp": "02:30:51", "text": "一体これはどういうことなんだ"}, {"type": "subtitle", "time": 9053.429, "timestamp": "02:30:53", "text": "世界？今は昼間のはずなのに、"}]
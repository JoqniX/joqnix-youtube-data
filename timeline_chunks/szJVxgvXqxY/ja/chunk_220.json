[{"type": "subtitle", "time": 13206.27, "timestamp": "03:40:06", "text": "行く。これがどうなるか、待ちきれない。"}, {"type": "subtitle", "time": 13208.35, "timestamp": "03:40:08", "text": "続く。おお"}, {"type": "subtitle", "time": 13210.51, "timestamp": "03:40:10", "text": "男の子。おお"}, {"type": "subtitle", "time": 13215.19, "timestamp": "03:40:15", "text": "男の子。はい、すべて同意します。ええと、私は"}, {"type": "subtitle", "time": 13217.23, "timestamp": "03:40:17", "text": "マルチプレイヤーが何なのか分からない"}, {"type": "subtitle", "time": 13220.47, "timestamp": "03:40:20", "text": "は。クラウドインターネットネットワークでプレイできます"}, {"type": "subtitle", "time": 13223.11, "timestamp": "03:40:23", "text": "設定して、ああ、他の人が"}, {"type": "subtitle", "time": 13225.51, "timestamp": "03:40:25", "text": "私と一緒に来てください。"}, {"type": "subtitle", "time": 13227.75, "timestamp": "03:40:27", "text": "マルチプレイヤーでプレイする。プレイ"}, {"type": "subtitle", "time": 13230.19, "timestamp": "03:40:30", "text": "[音楽]"}, {"type": "subtitle", "time": 13233.83, "timestamp": "03:40:33", "text": "雲。バトルロイヤルが始まった。何？"}, {"type": "subtitle", "time": 13236.59, "timestamp": "03:40:36", "text": "海賊ゲームがある。"}, {"type": "subtitle", "time": 13239.868, "timestamp": "03:40:39", "text": "何？あのね？私は"}, {"type": "subtitle", "time": 13244.27, "timestamp": "03:40:44", "text": "シングルプレイヤーモードでプレイします。待って、私は"}, {"type": "subtitle", "time": 13245.788, "timestamp": "03:40:45", "text": "知る。"}, {"type": "subtitle", "time": 13249.75, "timestamp": "03:40:49", "text": "えっと、ワールドビルダー。よし、じゃあ行こう"}, {"type": "subtitle", "time": 13257.03, "timestamp": "03:40:57", "text": "[音楽]"}]
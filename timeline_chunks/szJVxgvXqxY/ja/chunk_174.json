[{"type": "subtitle", "time": 10441.74, "timestamp": "02:54:01", "text": "チームに加わるだけでいい。"}, {"type": "subtitle", "time": 10443.99, "timestamp": "02:54:03", "text": "[音楽]"}, {"type": "subtitle", "time": 10447.03, "timestamp": "02:54:07", "text": "好きなキャラクターは誰ですか？私は好きです"}, {"type": "subtitle", "time": 10449.469, "timestamp": "02:54:09", "text": "ネオン。つまり"}, {"type": "subtitle", "time": 10452.55, "timestamp": "02:54:12", "text": "ネオンは、このゲームが"}, {"type": "subtitle", "time": 10454.469, "timestamp": "02:54:14", "text": "遅すぎず、まるで"}, {"type": "subtitle", "time": 10462.469, "timestamp": "02:54:22", "text": "だから私は少しゆっくり演奏するのです"}, {"type": "subtitle", "time": 10464.229, "timestamp": "02:54:24", "text": "時々。"}, {"type": "subtitle", "time": 10467.99, "timestamp": "02:54:27", "text": "だから私はネオンが好きなんです。だから私は走れる"}, {"type": "subtitle", "time": 10478.309, "timestamp": "02:54:38", "text": "ああ、競争的な側面が好きだったらいいのに"}, {"type": "subtitle", "time": 10480.309, "timestamp": "02:54:40", "text": "また、ペースが速いでしょう。"}, {"type": "subtitle", "time": 10482.15, "timestamp": "02:54:42", "text": "かつて私たちがトーナメントに参加していた頃は"}, {"type": "subtitle", "time": 10484.55, "timestamp": "02:54:44", "text": "いつも最後みたいにしないといけない"}, {"type": "subtitle", "time": 10486.469, "timestamp": "02:54:46", "text": "最後の20秒のように2番目"}, {"type": "subtitle", "time": 10488.469, "timestamp": "02:54:48", "text": "その時全てが起こるが"}, {"type": "subtitle", "time": 10490.71, "timestamp": "02:54:50", "text": "なぜなら、その前は大抵ああ"}, {"type": "subtitle", "time": 10493.349, "timestamp": "02:54:53", "text": "我々は、中盤を偵察しようとしたり、"}, {"type": "subtitle", "time": 10495.189, "timestamp": "02:54:55", "text": "人々がどこにいるかを調べます"}, {"type": "subtitle", "time": 10497.91, "timestamp": "02:54:57", "text": "そして最後の20サイトに到達しました"}]
[{"type": "subtitle", "time": 18723.75, "timestamp": "05:12:03", "text": "犠牲。何てことだ。なぜそうなるのか"}, {"type": "subtitle", "time": 18735.43, "timestamp": "05:12:15", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 18746.708, "timestamp": "05:12:26", "text": "ああ、戦うのか、戦わないのか？持つ、または持つ"}, {"type": "subtitle", "time": 18748.23, "timestamp": "05:12:28", "text": "どこ？"}, {"type": "subtitle", "time": 18751.03, "timestamp": "05:12:31", "text": "床の上。床の上。"}, {"type": "subtitle", "time": 18753.51, "timestamp": "05:12:33", "text": "水。わかった。"}, {"type": "subtitle", "time": 18755.99, "timestamp": "05:12:35", "text": "いや、いや、いや。幽霊みたいな感じ？"}, {"type": "subtitle", "time": 18759.03, "timestamp": "05:12:39", "text": "ゴーストライター？なんてこった。頭を作る。"}, {"type": "subtitle", "time": 18761.43, "timestamp": "05:12:41", "text": "そこに幽霊はいないよ。わかった。出て行け。得る"}, {"type": "subtitle", "time": 18772.23, "timestamp": "05:12:52", "text": "[音楽]"}, {"type": "subtitle", "time": 18775.83, "timestamp": "05:12:55", "text": "幽霊。これが見えますか？うん。分かりますか？"}, {"type": "subtitle", "time": 18779.11, "timestamp": "05:12:59", "text": "ゴースト作戦を見たいですか？"}]
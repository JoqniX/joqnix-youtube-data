[{"type": "subtitle", "time": 8820.309, "timestamp": "02:27:00", "text": "上。"}, {"type": "subtitle", "time": 8822.469, "timestamp": "02:27:02", "text": "ああ、そうだよ。よし、殺す必要がある"}, {"type": "subtitle", "time": 8825.11, "timestamp": "02:27:05", "text": "たくさんのものがあって、私はこう思う"}, {"type": "subtitle", "time": 8828.309, "timestamp": "02:27:08", "text": "基本的に無敵。"}, {"type": "subtitle", "time": 8832.349, "timestamp": "02:27:12", "text": "あなたは既にたくさんのパワーアップアイテムを手に入れていますね。"}, {"type": "subtitle", "time": 8835.99, "timestamp": "02:27:15", "text": "ええ、そこには200くらいあります"}, {"type": "subtitle", "time": 8838.87, "timestamp": "02:27:18", "text": "そこにもコイン入れがあります。もし私たちが"}, {"type": "subtitle", "time": 8840.79, "timestamp": "02:27:20", "text": "2、3日くらい貯金しておこうと思う"}, {"type": "subtitle", "time": 8844.469, "timestamp": "02:27:24", "text": "ええと、それの1つを手に入れることができます。"}, {"type": "subtitle", "time": 8848.309, "timestamp": "02:27:28", "text": "わかった。ああ、わかった。金塊を手に入れた。えっと、"}, {"type": "subtitle", "time": 8851.59, "timestamp": "02:27:31", "text": "金のものを作ったのか、それとも"}, {"type": "subtitle", "time": 8854.469, "timestamp": "02:27:34", "text": "成功するだろうか？必ずやり遂げる。"}, {"type": "subtitle", "time": 8855.63, "timestamp": "02:27:35", "text": "わかった。"}, {"type": "subtitle", "time": 8859.269, "timestamp": "02:27:39", "text": "つるはしか、それとも斧か？だって私は"}, {"type": "subtitle", "time": 8862.469, "timestamp": "02:27:42", "text": "それなら、もう一方を。両方とも自分用に作りました。"}, {"type": "subtitle", "time": 8865.349, "timestamp": "02:27:45", "text": "ああ、わかりました。わかった。シェアが欲しいですか、それとも"}, {"type": "subtitle", "time": 8867.429, "timestamp": "02:27:47", "text": "十分ありますか？"}, {"type": "subtitle", "time": 8869.59, "timestamp": "02:27:49", "text": "いいえ、実はもう1つ必要なんです。"}, {"type": "subtitle", "time": 8873.349, "timestamp": "02:27:53", "text": "椅子も十分あります。"}]
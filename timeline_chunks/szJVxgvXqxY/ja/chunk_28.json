[{"type": "subtitle", "time": 1680.31, "timestamp": "00:28:00", "text": "もしかしたらここかも。うん。うん。ピクセル。あなたは欲しい"}, {"type": "subtitle", "time": 1689.55, "timestamp": "00:28:09", "text": "ああ、誰もいない。実際、彼は"}, {"type": "subtitle", "time": 1710.59, "timestamp": "00:28:30", "text": "うん。ようこそ。"}, {"type": "subtitle", "time": 1723.95, "timestamp": "00:28:43", "text": "ニース。"}, {"type": "subtitle", "time": 1736.03, "timestamp": "00:28:56", "text": "[音楽]"}]
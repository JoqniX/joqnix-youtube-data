[{"type": "subtitle", "time": 16022.51, "timestamp": "04:27:02", "text": "はい。そして"}, {"type": "subtitle", "time": 16025.59, "timestamp": "04:27:05", "text": "次はジッガラットだ。それは何ですか？わかった。"}, {"type": "subtitle", "time": 16034.83, "timestamp": "04:27:14", "text": "銅。私たちは手に入れることができる"}, {"type": "subtitle", "time": 16038.67, "timestamp": "04:27:18", "text": "ここから銅を少し、"}, {"type": "subtitle", "time": 16041.99, "timestamp": "04:27:21", "text": "右？ああ、私のものを手に入れたよ。はい、結構です。"}, {"type": "subtitle", "time": 16044.628, "timestamp": "04:27:24", "text": "だから、今、私は戦争が必要だ。私は戦士を手に入れた。"}, {"type": "subtitle", "time": 16047.51, "timestamp": "04:27:27", "text": "だから、弓兵が必要なんだ。そして戦士たち"}, {"type": "subtitle", "time": 16049.83, "timestamp": "04:27:29", "text": "来る"}, {"type": "subtitle", "time": 16051.548, "timestamp": "04:27:31", "text": "[音楽]"}, {"type": "subtitle", "time": 16054.23, "timestamp": "04:27:34", "text": "ええと、戦士たちは待つでしょう、分かりますよね"}, {"type": "subtitle", "time": 16057.11, "timestamp": "04:27:37", "text": "何？自動探索。やってください"}, {"type": "subtitle", "time": 16070.35, "timestamp": "04:27:50", "text": "えっと、彼らはできない"}, {"type": "subtitle", "time": 16074.59, "timestamp": "04:27:54", "text": "ああ、制作はできますよ。"}, {"type": "subtitle", "time": 16076.67, "timestamp": "04:27:56", "text": "わかった、"}, {"type": "subtitle", "time": 16079.51, "timestamp": "04:27:59", "text": "良い。良い。原材料。たくさん手に入れました"}]
[{"type": "subtitle", "time": 3607.52, "timestamp": "01:00:07", "text": "私たちはそのゲームをスピードランでクリアした。"}, {"type": "subtitle", "time": 3609.95, "timestamp": "01:00:09", "text": "[音楽]"}, {"type": "subtitle", "time": 3622.03, "timestamp": "01:00:22", "text": "くそ。そしてあなたは"}, {"type": "subtitle", "time": 3625.51, "timestamp": "01:00:25", "text": "死ぬ。うん。"}, {"type": "subtitle", "time": 3631.87, "timestamp": "01:00:31", "text": "神。これは戦いにおいて何なのか"}, {"type": "subtitle", "time": 3634.75, "timestamp": "01:00:34", "text": "ピュー？皆さん、"}, {"type": "subtitle", "time": 3638.43, "timestamp": "01:00:38", "text": "これ？これらのオレンジ色のキツネ、またはあなたの黄色いキツネ"}, {"type": "subtitle", "time": 3642.39, "timestamp": "01:00:42", "text": "キツネ、トラ、君が何であれ。それは"}, {"type": "subtitle", "time": 3658.229, "timestamp": "01:00:58", "text": "本当に危なかった。予想していなかった"}]
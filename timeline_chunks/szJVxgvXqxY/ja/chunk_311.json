[{"type": "subtitle", "time": 18667.15, "timestamp": "05:11:07", "text": "おお、"}, {"type": "subtitle", "time": 18671.51, "timestamp": "05:11:11", "text": "指紋。指紋が凍りつく。"}, {"type": "subtitle", "time": 18673.548, "timestamp": "05:11:13", "text": "えっと"}, {"type": "subtitle", "time": 18677.43, "timestamp": "05:11:17", "text": "指紋が欠落している。あらら。私はそうは思わない"}, {"type": "subtitle", "time": 18697.628, "timestamp": "05:11:37", "text": "来るよ。走る。"}, {"type": "subtitle", "time": 18700.15, "timestamp": "05:11:40", "text": "走る。わかった。わかった。わかった。大丈夫。は"}, {"type": "subtitle", "time": 18703.11, "timestamp": "05:11:43", "text": "相互作用はありますか？何てことだ。"}, {"type": "subtitle", "time": 18704.868, "timestamp": "05:11:44", "text": "何？"}, {"type": "subtitle", "time": 18707.91, "timestamp": "05:11:47", "text": "インターセプトと言ってください。相互作用。"}, {"type": "subtitle", "time": 18710.548, "timestamp": "05:11:50", "text": "理解できましたか？怖い、怖い、怖い、"}, {"type": "subtitle", "time": 18712.788, "timestamp": "05:11:52", "text": "怖い。動きを捉えよう。私はまだ"}]
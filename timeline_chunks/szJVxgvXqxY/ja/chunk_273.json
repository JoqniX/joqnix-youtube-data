[{"type": "subtitle", "time": 16381.868, "timestamp": "04:33:01", "text": "市民。"}, {"type": "subtitle", "time": 16384.868, "timestamp": "04:33:04", "text": "えっと、金貨３枚と金貨１枚を手に入れます"}, {"type": "subtitle", "time": 16388.39, "timestamp": "04:33:08", "text": "生産、そして3つすべての食品から1つずつ"}, {"type": "subtitle", "time": 16423.868, "timestamp": "04:33:43", "text": "[音楽]"}, {"type": "subtitle", "time": 16427.03, "timestamp": "04:33:47", "text": "ええと、彼らしい困惑した声ですね。おお"}, {"type": "subtitle", "time": 16438.59, "timestamp": "04:33:58", "text": "神。これは一体何だろう？"}]
[{"type": "subtitle", "time": 2701.709, "timestamp": "00:45:01", "text": "それはとても"}, {"type": "subtitle", "time": 2705.35, "timestamp": "00:45:05", "text": "面白い。それは卵です それは卵です"}, {"type": "subtitle", "time": 2707.629, "timestamp": "00:45:07", "text": "投げる"}, {"type": "subtitle", "time": 2710.95, "timestamp": "00:45:10", "text": "銃。卵から、ああ、卵だ。ああ、それ"}, {"type": "subtitle", "time": 2713.55, "timestamp": "00:45:13", "text": "1つ。"}, {"type": "subtitle", "time": 2728.91, "timestamp": "00:45:28", "text": "ディーグル。"}, {"type": "subtitle", "time": 2746.75, "timestamp": "00:45:46", "text": "1つ？さあ、行こう。さあ"}, {"type": "subtitle", "time": 2750.59, "timestamp": "00:45:50", "text": "行く。どこに行けばいいでしょうか"}, {"type": "subtitle", "time": 2754.07, "timestamp": "00:45:54", "text": "行く？ここ。"}]
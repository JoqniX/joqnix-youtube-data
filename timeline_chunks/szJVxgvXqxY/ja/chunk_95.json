[{"type": "subtitle", "time": 5701.83, "timestamp": "01:35:01", "text": "今は外向的だ。新しい人たちと話しています"}, {"type": "subtitle", "time": 5703.91, "timestamp": "01:35:03", "text": "初めてだったので、とても"}, {"type": "subtitle", "time": 5706.19, "timestamp": "01:35:06", "text": "良い時間"}, {"type": "subtitle", "time": 5709.03, "timestamp": "01:35:09", "text": "持っていた。こんにちは、サムネイルが更新されました。私は"}, {"type": "subtitle", "time": 5711.55, "timestamp": "01:35:11", "text": "仕事のストレスが原因だ。それでは次は"}, {"type": "subtitle", "time": 5715.67, "timestamp": "01:35:15", "text": "タムサ、そしてジョアサ"}, {"type": "subtitle", "time": 5719.03, "timestamp": "01:35:19", "text": "えーと、午後6時に、私は、えーと作ります"}, {"type": "subtitle", "time": 5721.349, "timestamp": "01:35:21", "text": "第二部へと切り替えます"}, {"type": "subtitle", "time": 5725.349, "timestamp": "01:35:25", "text": "2つは、umとのコラボレーションです"}, {"type": "subtitle", "time": 5729.59, "timestamp": "01:35:29", "text": "デイビスの息子と、午前0時2時に私たちは"}, {"type": "subtitle", "time": 5733.27, "timestamp": "01:35:33", "text": "アヴィサンさん、アヴィスさんもいらっしゃいます。良い"}, {"type": "subtitle", "time": 5735.27, "timestamp": "01:35:35", "text": "アビスをプレイする。ええと、私たちは演奏します"}, {"type": "subtitle", "time": 5738.71, "timestamp": "01:35:38", "text": "リーパーとアビサンをデイビサンに。私"}, {"type": "subtitle", "time": 5740.389, "timestamp": "01:35:40", "text": "ゲームはまだ確定していませんが、"}, {"type": "subtitle", "time": 5743.03, "timestamp": "01:35:43", "text": "絵を描いたり、アートの周りで落書きをしたりしているかもしれません"}, {"type": "subtitle", "time": 5744.59, "timestamp": "01:35:44", "text": "何らかのストリーム"}, {"type": "subtitle", "time": 5747.51, "timestamp": "01:35:47", "text": "あれ。そういうことだ。そして、えーと"}, {"type": "subtitle", "time": 5749.91, "timestamp": "01:35:49", "text": "次のゲストはタタムサです。"}, {"type": "subtitle", "time": 5753.11, "timestamp": "01:35:53", "text": "ムクとジョサン。私は確認していません"}, {"type": "subtitle", "time": 5754.63, "timestamp": "01:35:54", "text": "まだゲームはやってないけど、何かプレイするつもり"}, {"type": "subtitle", "time": 5756.76, "timestamp": "01:35:56", "text": "ヴァレラントか"}, {"type": "subtitle", "time": 5757.87, "timestamp": "01:35:57", "text": "[音楽]"}]
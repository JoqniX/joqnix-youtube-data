[{"type": "subtitle", "time": 11367.91, "timestamp": "03:09:27", "text": "再装填中。"}, {"type": "subtitle", "time": 11378.63, "timestamp": "03:09:38", "text": "冗談はもう終わりだ。お前は死んだ。"}, {"type": "subtitle", "time": 11381.11, "timestamp": "03:09:41", "text": "私はまだ触れています。くそ、兄弟。良い"}, {"type": "subtitle", "time": 11383.269, "timestamp": "03:09:43", "text": "君だよ。私はこのゲームが下手になってしまった。私は"}, {"type": "subtitle", "time": 11389.51, "timestamp": "03:09:49", "text": "これで洗った。"}, {"type": "subtitle", "time": 11397.51, "timestamp": "03:09:57", "text": "敵を発見。"}]
[{"type": "subtitle", "time": 15001.708, "timestamp": "04:10:01", "text": "二度とあの美しさを目にすることはできない"}, {"type": "subtitle", "time": 15004.55, "timestamp": "04:10:04", "text": "スパター湖でそれらを楽しんでください"}, {"type": "subtitle", "time": 15007.59, "timestamp": "04:10:07", "text": "今まで見た中で最高のものだ。クレーター"}, {"type": "subtitle", "time": 15011.948, "timestamp": "04:10:11", "text": "湖はそれらすべてよりも上位に位置する。ジャック・ロンドン。"}, {"type": "subtitle", "time": 15026.07, "timestamp": "04:10:26", "text": "ああ、彼らは喧嘩している。私の部隊の一人"}, {"type": "subtitle", "time": 15027.99, "timestamp": "04:10:27", "text": "亡くなった。"}, {"type": "subtitle", "time": 15033.868, "timestamp": "04:10:33", "text": "[音楽]"}, {"type": "subtitle", "time": 15037.03, "timestamp": "04:10:37", "text": "待って。忠誠心そのものが報いとなる。あなたは"}, {"type": "subtitle", "time": 15040.07, "timestamp": "04:10:40", "text": "知らないの？え、何？私は敵を作ってしまったのだろうか？"}, {"type": "subtitle", "time": 15041.42, "timestamp": "04:10:41", "text": "彼女の？おお"}, {"type": "subtitle", "time": 15044.83, "timestamp": "04:10:44", "text": "[音楽]"}, {"type": "subtitle", "time": 15053.19, "timestamp": "04:10:53", "text": "何？なんてこった。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 15055.75, "timestamp": "04:10:55", "text": "いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。あなたの"}, {"type": "subtitle", "time": 15057.67, "timestamp": "04:10:57", "text": "占星術師の知識の進歩"}]
[{"type": "subtitle", "time": 16083.31, "timestamp": "04:28:03", "text": "原材料の。私はどういうわけか信じている"}, {"type": "subtitle", "time": 16086.31, "timestamp": "04:28:06", "text": "どういうわけか、馬が動いているのが見える"}, {"type": "subtitle", "time": 16088.19, "timestamp": "04:28:08", "text": "これ。"}, {"type": "subtitle", "time": 16089.35, "timestamp": "04:28:09", "text": "わかった。"}, {"type": "subtitle", "time": 16091.07, "timestamp": "04:28:11", "text": "[音楽]"}, {"type": "subtitle", "time": 16093.868, "timestamp": "04:28:13", "text": "ああ、わかった。所有。わかった。"}, {"type": "subtitle", "time": 16097.708, "timestamp": "04:28:17", "text": "わかった。えっと、何ですか"}, {"type": "subtitle", "time": 16100.75, "timestamp": "04:28:20", "text": "次？ああ、誰"}, {"type": "subtitle", "time": 16102.75, "timestamp": "04:28:22", "text": "それ？誰が"}, {"type": "subtitle", "time": 16106.708, "timestamp": "04:28:26", "text": "それ？野蛮人ピアマン。何てことだ。誰が"}, {"type": "subtitle", "time": 16108.628, "timestamp": "04:28:28", "text": "あれは？"}, {"type": "subtitle", "time": 16123.67, "timestamp": "04:28:43", "text": "なんてこった。それは空気のような贅沢品だった"}, {"type": "subtitle", "time": 16125.51, "timestamp": "04:28:45", "text": "ローマを滅ぼした条件"}, {"type": "chat", "time": 16126.105, "timestamp": "04:28:46", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "yo what up"}, {"type": "subtitle", "time": 16128.708, "timestamp": "04:28:48", "text": "私の完成品です。わかった。国境開放。私はできる"}, {"type": "subtitle", "time": 16131.16, "timestamp": "04:28:51", "text": "方針を変更する。"}, {"type": "chat", "time": 16137.44, "timestamp": "04:28:57", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "today's the 3rd day of no electricity"}]
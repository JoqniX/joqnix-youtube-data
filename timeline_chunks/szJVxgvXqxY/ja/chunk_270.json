[{"type": "subtitle", "time": 16200.11, "timestamp": "04:30:00", "text": "三輪車。次"}, {"type": "subtitle", "time": 16202.868, "timestamp": "04:30:02", "text": "さあ、戦いに行こう。ああ、私は殺した"}, {"type": "subtitle", "time": 16205.27, "timestamp": "04:30:05", "text": "それも台無しにした。"}, {"type": "subtitle", "time": 16207.11, "timestamp": "04:30:07", "text": "私たちは最近、高度な"}, {"type": "subtitle", "time": 16209.27, "timestamp": "04:30:09", "text": "都市計画に関する知識。わかった。"}, {"type": "subtitle", "time": 16212.07, "timestamp": "04:30:12", "text": "都市に地区を作ることは"}, {"type": "subtitle", "time": 16214.548, "timestamp": "04:30:14", "text": "より強力で収益性が高い"}, {"type": "subtitle", "time": 16216.788, "timestamp": "04:30:16", "text": "農場や"}, {"type": "subtitle", "time": 16224.15, "timestamp": "04:30:24", "text": "都市は人口を増やす必要がある"}, {"type": "subtitle", "time": 16227.23, "timestamp": "04:30:27", "text": "複数のものを構築できます"}, {"type": "subtitle", "time": 16236.07, "timestamp": "04:30:36", "text": "わかった。地区をクリックして構築します"}, {"type": "subtitle", "time": 16237.75, "timestamp": "04:30:37", "text": "配置。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 16240.23, "timestamp": "04:30:40", "text": "わかった。占星術。さあ行こう。私たちは"}, {"type": "subtitle", "time": 16243.47, "timestamp": "04:30:43", "text": "占星術の研究。次に"}, {"type": "subtitle", "time": 16250.23, "timestamp": "04:30:50", "text": "書き込み。わかった。そう、この人だよ。何が"}, {"type": "subtitle", "time": 16251.948, "timestamp": "04:30:51", "text": "私は"}, {"type": "subtitle", "time": 16254.83, "timestamp": "04:30:54", "text": "あなた？もし私が"}, {"type": "subtitle", "time": 16257.948, "timestamp": "04:30:57", "text": "[音楽]"}]
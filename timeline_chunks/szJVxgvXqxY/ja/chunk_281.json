[{"type": "subtitle", "time": 16860.868, "timestamp": "04:41:00", "text": "部屋をプライベートにして"}, {"type": "subtitle", "time": 16864.948, "timestamp": "04:41:04", "text": "そして部屋を作る。こんにちは。わかった。手に入れた"}, {"type": "subtitle", "time": 16867.03, "timestamp": "04:41:07", "text": "招待コード。あなたに送ります"}, {"type": "subtitle", "time": 16868.788, "timestamp": "04:41:08", "text": "不和。"}, {"type": "subtitle", "time": 16880.31, "timestamp": "04:41:20", "text": "わーい。わーい。"}, {"type": "subtitle", "time": 16882.948, "timestamp": "04:41:22", "text": "さあ行こう。あなたはここにいます。"}, {"type": "subtitle", "time": 16884.948, "timestamp": "04:41:24", "text": "こんにちは。"}, {"type": "subtitle", "time": 16889.11, "timestamp": "04:41:29", "text": "あ、待って。犬を押そう。おっと。"}, {"type": "subtitle", "time": 16893.59, "timestamp": "04:41:33", "text": "わかった。わかった。あ、こんにちは。準備完了。"}, {"type": "subtitle", "time": 16895.75, "timestamp": "04:41:35", "text": "えっと、"}, {"type": "subtitle", "time": 16897.67, "timestamp": "04:41:37", "text": "何か変更する必要はありますか？あなたは"}, {"type": "subtitle", "time": 16901.27, "timestamp": "04:41:41", "text": "このゲームのプロですか？いいえ、でも私は良い"}, {"type": "subtitle", "time": 16904.23, "timestamp": "04:41:44", "text": "良い設備なので、より良い"}, {"type": "subtitle", "time": 16906.548, "timestamp": "04:41:46", "text": "装備は揃っているが、それほど良いものではない。"}, {"type": "subtitle", "time": 16909.03, "timestamp": "04:41:49", "text": "うわ、君はレベル42か。すごいな。ええ、私は"}, {"type": "subtitle", "time": 16911.27, "timestamp": "04:41:51", "text": "レベル42。"}, {"type": "subtitle", "time": 16913.59, "timestamp": "04:41:53", "text": "プレイしました。"}, {"type": "subtitle", "time": 16916.788, "timestamp": "04:41:56", "text": "たくさんプレイしたんですね？ニース。いや、いや、いや、"}]
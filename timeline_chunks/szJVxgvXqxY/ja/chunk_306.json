[{"type": "subtitle", "time": 18360.31, "timestamp": "05:06:00", "text": "うん。とても怖い。ああ、もしこれが私たちだったら"}, {"type": "subtitle", "time": 18362.31, "timestamp": "05:06:02", "text": "ゴーストライターに本の執筆を依頼する？あなたは"}, {"type": "subtitle", "time": 18365.868, "timestamp": "05:06:05", "text": "本を置く？ええ、本を置きました。私は"}, {"type": "subtitle", "time": 18369.51, "timestamp": "05:06:09", "text": "本。でも、まだ執筆はしていません。まだ。"}, {"type": "subtitle", "time": 18394.31, "timestamp": "05:06:34", "text": "つまり、あなたはストリーミング配信をしていないということですね？"}, {"type": "subtitle", "time": 18398.628, "timestamp": "05:06:38", "text": "いいえ、違います。"}, {"type": "subtitle", "time": 18401.35, "timestamp": "05:06:41", "text": "人生には色々なことが起こるものですよね？"}, {"type": "subtitle", "time": 18412.628, "timestamp": "05:06:52", "text": "えっと、キャンドルや線香、"}, {"type": "subtitle", "time": 18414.948, "timestamp": "05:06:54", "text": "塩？そうそう。塩を入れたんだよね？"}]
[{"type": "subtitle", "time": 10623.429, "timestamp": "02:57:03", "text": "走ろうとしているんだけど、"}, {"type": "subtitle", "time": 10627.59, "timestamp": "02:57:07", "text": "３人が私を撃っている。"}, {"type": "subtitle", "time": 10629.91, "timestamp": "02:57:09", "text": "何を言っている？走ろうとしている"}, {"type": "subtitle", "time": 10642.71, "timestamp": "02:57:22", "text": "料金はかかりません。"}, {"type": "subtitle", "time": 10679.429, "timestamp": "02:57:59", "text": "何てことだ。私はこのゲームが本当に下手です"}]
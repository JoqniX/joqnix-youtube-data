[{"type": "subtitle", "time": 18123.03, "timestamp": "05:02:03", "text": "それ。何てことだ。もう耐えられない。"}, {"type": "subtitle", "time": 18125.51, "timestamp": "05:02:05", "text": "よし、できた。やったよ。やったよ。の"}, {"type": "subtitle", "time": 18139.83, "timestamp": "05:02:19", "text": "私はそれを捉えなければならない"}, {"type": "subtitle", "time": 18141.83, "timestamp": "05:02:21", "text": "いや、いや、いや、いや、いや、いや。君が"}, {"type": "subtitle", "time": 18159.83, "timestamp": "05:02:39", "text": "それ。音センサー。"}, {"type": "subtitle", "time": 18162.948, "timestamp": "05:02:42", "text": "それで、毎ラウンド、私たちは"}, {"type": "subtitle", "time": 18165.75, "timestamp": "05:02:45", "text": "あらゆる機器を世界中から購入しています"}, {"type": "subtitle", "time": 18169.35, "timestamp": "05:02:49", "text": "もう一度、それとも私たちが使ったものだけですか？のみ"}, {"type": "subtitle", "time": 18171.67, "timestamp": "05:02:51", "text": "私たちが使ったものの一つ。"}, {"type": "subtitle", "time": 18173.788, "timestamp": "05:02:53", "text": "ああ"}]
[{"type": "subtitle", "time": 9180.55, "timestamp": "02:33:00", "text": "ヒットして、えーとヒットして、チャンキーをゲットする"}, {"type": "chat", "time": 9180.558, "timestamp": "02:33:00", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "and she gone to the abyss"}, {"type": "subtitle", "time": 9188.229, "timestamp": "02:33:08", "text": "金は手に入りましたか？"}, {"type": "subtitle", "time": 9193.75, "timestamp": "02:33:13", "text": "私は金塊を1つ持っています。おお。えっと、あなたは"}, {"type": "subtitle", "time": 9195.91, "timestamp": "02:33:15", "text": "つるはしを買ったのか、それとも"}, {"type": "subtitle", "time": 9197.91, "timestamp": "02:33:17", "text": "買う？ここに金がある。私はただ"}, {"type": "subtitle", "time": 9201.11, "timestamp": "02:33:21", "text": "それを耕作する。私はツルハシと金の両方を持っています"}, {"type": "subtitle", "time": 9203.11, "timestamp": "02:33:23", "text": "斧。"}, {"type": "subtitle", "time": 9204.95, "timestamp": "02:33:24", "text": "金の斧。わかった。わかった。私は持ってきます"}, {"type": "subtitle", "time": 9208.349, "timestamp": "02:33:28", "text": "あなたに金を、そして私たちは"}, {"type": "subtitle", "time": 9211.75, "timestamp": "02:33:31", "text": "石炭をできるだけ多く手に入れることができるでしょうか"}, {"type": "subtitle", "time": 9212.83, "timestamp": "02:33:32", "text": "私たちが"}, {"type": "subtitle", "time": 9216.59, "timestamp": "02:33:36", "text": "できる。偽造品の中に入れろ"}, {"type": "subtitle", "time": 9221.11, "timestamp": "02:33:41", "text": "炉。私はたくさんのものを集めます"}, {"type": "subtitle", "time": 9224.469, "timestamp": "02:33:44", "text": "金があれば、みんなに鎧を作れる"}, {"type": "chat", "time": 9225.909, "timestamp": "02:33:45", "author": "@Totembtw", "avatar": "https://yt4.ggpht.com/hioaXnlAE2bO9zkq1LR7obAzNHeT2CyJQVDqLyLs1xpQtflZ50pJJfeodntXZC_QCm0VDoyEgA=s64-c-k-c0x00ffffff-no-rj", "message": "ello"}, {"type": "subtitle", "time": 9227.91, "timestamp": "02:33:47", "text": "私たちの。わかった。私たちはそうすべきではないと思います"}, {"type": "subtitle", "time": 9229.349, "timestamp": "02:33:49", "text": "金色の防具は無視した方がいいでしょう。多分"}, {"type": "subtitle", "time": 9232.389, "timestamp": "02:33:52", "text": "直接鉄鋼業に進出する可能性もある。手に入れることができますか？"}, {"type": "subtitle", "time": 9234.71, "timestamp": "02:33:54", "text": "そこに鋼鉄があるのか​​？そうそう。どうすれば"}, {"type": "subtitle", "time": 9236.63, "timestamp": "02:33:56", "text": "また鉄鋼か？"}, {"type": "subtitle", "time": 9239.349, "timestamp": "02:33:59", "text": "鉄からできていると思う。ああ、燃えている"}]
[{"type": "subtitle", "time": 9365.83, "timestamp": "02:36:05", "text": "私は剣を手に入れた。私は剣を作った。ニース。"}, {"type": "subtitle", "time": 9367.51, "timestamp": "02:36:07", "text": "ニース。でも、ああ、私は死んでしまった。私は死んだ。私は"}, {"type": "subtitle", "time": 9381.83, "timestamp": "02:36:21", "text": "あなたは死んだのですか？いや、いや、いや、いや。私は生きている。"}, {"type": "subtitle", "time": 9385.59, "timestamp": "02:36:25", "text": "しかし、私は今にも死にそうだ。"}, {"type": "subtitle", "time": 9388.55, "timestamp": "02:36:28", "text": "あなたは生きていますか？ええ、生きてますよ。私は"}, {"type": "subtitle", "time": 9391.51, "timestamp": "02:36:31", "text": "何か行動を起こすつもりだ。"}, {"type": "subtitle", "time": 9393.67, "timestamp": "02:36:33", "text": "何てことだ。私は死んだ。私は死んだ。私は"}, {"type": "subtitle", "time": 9395.349, "timestamp": "02:36:35", "text": "実際には死んでいた。私はワンタップです。まるで"}, {"type": "subtitle", "time": 9397.67, "timestamp": "02:36:37", "text": "10人。私は死んだ。あなたは死にかけているようですね。"}, {"type": "subtitle", "time": 9398.95, "timestamp": "02:36:38", "text": "あなたを信頼しています。君ならできる。あなた"}, {"type": "subtitle", "time": 9405.99, "timestamp": "02:36:45", "text": "何てことだ。なぜこのゲームはこんなに難しいのか"}]
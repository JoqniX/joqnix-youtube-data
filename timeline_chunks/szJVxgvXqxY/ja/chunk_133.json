[{"type": "subtitle", "time": 7980.63, "timestamp": "02:13:00", "text": "そして現在私は、"}, {"type": "subtitle", "time": 7982.79, "timestamp": "02:13:02", "text": "編集をきちんと学ぶ方法"}, {"type": "subtitle", "time": 7984.95, "timestamp": "02:13:04", "text": "ちゃんとした動画を作るために。だから私は作った"}, {"type": "subtitle", "time": 7986.389, "timestamp": "02:13:06", "text": "ナット用に1つ、そして私は1つ作るつもりです"}, {"type": "subtitle", "time": 7988.15, "timestamp": "02:13:08", "text": "私のためにいくつか作って"}, {"type": "subtitle", "time": 7990.469, "timestamp": "02:13:10", "text": "自分自身。 YouTube を頑張って、"}, {"type": "subtitle", "time": 7993.269, "timestamp": "02:13:13", "text": "そうすれば、例えば1000人の登録者数に達したら"}, {"type": "subtitle", "time": 8001.51, "timestamp": "02:13:21", "text": "あまり早くデビューしたくないのは、"}, {"type": "subtitle", "time": 8003.51, "timestamp": "02:13:23", "text": "人々は私のところに来ないと思う"}, {"type": "subtitle", "time": 8006.79, "timestamp": "02:13:26", "text": "ゆっくり進めればストリーミング配信できます。つまり、あなたは"}, {"type": "subtitle", "time": 8008.63, "timestamp": "02:13:28", "text": "必ずストリーミングを開始してください。つまりあなたは"}, {"type": "subtitle", "time": 8026.03, "timestamp": "02:13:46", "text": "これは何ですか"}, {"type": "subtitle", "time": 8029.269, "timestamp": "02:13:49", "text": "像？仲間たちを蘇らせろ。復活させる"}, {"type": "subtitle", "time": 8031.91, "timestamp": "02:13:51", "text": "あなたの全体 ああ、それはリスポーンです。わかった。"}, {"type": "subtitle", "time": 8034.469, "timestamp": "02:13:54", "text": "わかった。私が死んだら、ここに来て"}, {"type": "subtitle", "time": 8037.71, "timestamp": "02:13:57", "text": "20コイン使って復活する"}]
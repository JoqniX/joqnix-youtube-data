[{"type": "subtitle", "time": 12121.469, "timestamp": "03:22:01", "text": "包まなければならない"}, {"type": "subtitle", "time": 12125.83, "timestamp": "03:22:05", "text": "これを上げます。こんにちは。それでは皆さん、楽しんでください。"}, {"type": "subtitle", "time": 12127.99, "timestamp": "03:22:07", "text": "良い一日を。また戻ってきます。病気"}, {"type": "subtitle", "time": 12129.75, "timestamp": "03:22:09", "text": "少し後で戻ってきます。食べに行こう"}, {"type": "subtitle", "time": 12131.59, "timestamp": "03:22:11", "text": "何かして戻ってきてください。わかった。こんにちは。"}, {"type": "subtitle", "time": 12132.83, "timestamp": "03:22:12", "text": "楽しむ。楽しむ。"}, {"type": "subtitle", "time": 12135.91, "timestamp": "03:22:15", "text": "バイバイ。私はWを求めるかもしれないので、私たちは"}, {"type": "subtitle", "time": 12137.07, "timestamp": "03:22:17", "text": "時計"}, {"type": "subtitle", "time": 12140.309, "timestamp": "03:22:20", "text": "それ。こんにちは。楽しむ。老練なスポーツマンを楽しもう。病気"}, {"type": "subtitle", "time": 12142.149, "timestamp": "03:22:22", "text": "戻ってきます。"}, {"type": "subtitle", "time": 12146.469, "timestamp": "03:22:26", "text": "このNDI関連の問題を解決させてください。"}, {"type": "subtitle", "time": 12150.55, "timestamp": "03:22:30", "text": "見せられるよ、えっと、わかるでしょ"}, {"type": "subtitle", "time": 12157.83, "timestamp": "03:22:37", "text": "外。ああ、なんてことだ、うまくいかない。ああ、"}, {"type": "subtitle", "time": 12166.189, "timestamp": "03:22:46", "text": "[音楽]"}, {"type": "subtitle", "time": 12169.429, "timestamp": "03:22:49", "text": "Odet ハードウェア アクセラレーションと"}, {"type": "subtitle", "time": 12171.349, "timestamp": "03:22:51", "text": "これ。"}, {"type": "subtitle", "time": 12173.79, "timestamp": "03:22:53", "text": "うまくいかない。ああ、そうじゃない"}]
[{"type": "subtitle", "time": 3063.47, "timestamp": "00:51:03", "text": "ああ、それは卵のやつですね。うん。"}, {"type": "subtitle", "time": 3092.87, "timestamp": "00:51:32", "text": "右。待って、もしかしてプレイ"}, {"type": "subtitle", "time": 3095.27, "timestamp": "00:51:35", "text": "フォートナイト？"}, {"type": "subtitle", "time": 3101.589, "timestamp": "00:51:41", "text": "あなたの好きなゲームは何ですか？"}, {"type": "subtitle", "time": 3102.91, "timestamp": "00:51:42", "text": "けれど？"}, {"type": "subtitle", "time": 3105.91, "timestamp": "00:51:45", "text": "はぁ？えっと"}, {"type": "subtitle", "time": 3109.91, "timestamp": "00:51:49", "text": "マインクラフトはその一つだと知っています。"}, {"type": "subtitle", "time": 3111.669, "timestamp": "00:51:51", "text": "うん。ええと、私はそれをプレイしていません"}, {"type": "subtitle", "time": 3114.149, "timestamp": "00:51:54", "text": "長い間。しかし、ゲームは"}, {"type": "subtitle", "time": 3117.27, "timestamp": "00:51:57", "text": "最近私がプレイしているのは"}]
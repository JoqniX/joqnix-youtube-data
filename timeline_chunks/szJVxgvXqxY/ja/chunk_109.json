[{"type": "subtitle", "time": 6540.15, "timestamp": "01:49:00", "text": "作業台。そして、気をつけてください。わかった。"}, {"type": "subtitle", "time": 6542.389, "timestamp": "01:49:02", "text": "ああ、まるでゴブリンがこちらに向かってくる"}, {"type": "subtitle", "time": 6544.429, "timestamp": "01:49:04", "text": "自分。 2つあります"}, {"type": "subtitle", "time": 6548.07, "timestamp": "01:49:08", "text": "彼ら。あ、待って。それは私に向かって何かを撃ってくる。"}, {"type": "subtitle", "time": 6561.03, "timestamp": "01:49:21", "text": "私は建物をめちゃくちゃにしてしまった。"}, {"type": "subtitle", "time": 6571.03, "timestamp": "01:49:31", "text": "大丈夫。大丈夫。"}, {"type": "subtitle", "time": 6573.55, "timestamp": "01:49:33", "text": "何てことだ。また一つ出現した。なれ"}, {"type": "subtitle", "time": 6578.23, "timestamp": "01:49:38", "text": "注意深い。私があなたを守る。"}, {"type": "subtitle", "time": 6584.309, "timestamp": "01:49:44", "text": "ああ、それはあなただったんですね。わかった。わかった。わかった。なぜ"}, {"type": "subtitle", "time": 6598.75, "timestamp": "01:49:58", "text": "わかった。それは"}]
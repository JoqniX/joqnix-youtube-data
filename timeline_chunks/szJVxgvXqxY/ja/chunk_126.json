[{"type": "subtitle", "time": 7563.03, "timestamp": "02:06:03", "text": "敵を殺そうと試みることができます。"}, {"type": "subtitle", "time": 7565.83, "timestamp": "02:06:05", "text": "右？そして鋼鉄の斧を手に入れよう"}, {"type": "subtitle", "time": 7569.55, "timestamp": "02:06:09", "text": "木こりまたは"}, {"type": "subtitle", "time": 7572.83, "timestamp": "02:06:12", "text": "NPC。すると私たちは"}, {"type": "subtitle", "time": 7574.51, "timestamp": "02:06:14", "text": "グッチ。"}, {"type": "subtitle", "time": 7578.389, "timestamp": "02:06:18", "text": "うん。わかった。これを置かせてください。できる"}, {"type": "subtitle", "time": 7580.19, "timestamp": "02:06:20", "text": "私"}, {"type": "subtitle", "time": 7589.429, "timestamp": "02:06:29", "text": "炉。どうすればいいのか分かりません"}, {"type": "subtitle", "time": 7590.99, "timestamp": "02:06:30", "text": "もっと作る"}, {"type": "subtitle", "time": 7596.75, "timestamp": "02:06:36", "text": "ツール。まるで鉄格子を身につけているみたいだけど、"}, {"type": "subtitle", "time": 7599.91, "timestamp": "02:06:39", "text": "ああ、夜間停車だと思います。おお、"}, {"type": "subtitle", "time": 7600.95, "timestamp": "02:06:40", "text": "どうでも。これらは単なる"}, {"type": "subtitle", "time": 7610.71, "timestamp": "02:06:50", "text": "よし、戦闘の準備をしろ。ええ、そうですね。"}, {"type": "subtitle", "time": 7618.71, "timestamp": "02:06:58", "text": "私たちのNPCに手伝ってもらいたいですか？"}]
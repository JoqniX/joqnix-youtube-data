[{"type": "subtitle", "time": 7080.23, "timestamp": "01:58:00", "text": "右？似たようなドアがないわけではない。"}, {"type": "subtitle", "time": 7091.23, "timestamp": "01:58:11", "text": "うーん、でもこれは多すぎるかもしれない"}, {"type": "subtitle", "time": 7093.87, "timestamp": "01:58:13", "text": "私たち。彼らは"}, {"type": "subtitle", "time": 7096.349, "timestamp": "01:58:16", "text": "歩くかもしれない"}, {"type": "subtitle", "time": 7099.15, "timestamp": "01:58:19", "text": "大丈夫です。私たちは防御できます、私は"}, {"type": "subtitle", "time": 7101.91, "timestamp": "01:58:21", "text": "推測。うん。ああ、もしあなたが物を投げたら"}, {"type": "subtitle", "time": 7105.59, "timestamp": "01:58:25", "text": "地面、ああ、"}, {"type": "subtitle", "time": 7107.91, "timestamp": "01:58:27", "text": "わかった。どうでも。もし"}, {"type": "subtitle", "time": 7111.75, "timestamp": "01:58:31", "text": "物を地面に投げつけるのはダメです。えっと、または"}, {"type": "subtitle", "time": 7116.07, "timestamp": "01:58:36", "text": "何かを失ってしまうんだと思う。ない"}, {"type": "subtitle", "time": 7125.75, "timestamp": "01:58:45", "text": "見る？また、小麦も見つけなければなりませんでした。"}, {"type": "subtitle", "time": 7127.75, "timestamp": "01:58:47", "text": "考える。小麦を使えば、"}, {"type": "subtitle", "time": 7130.55, "timestamp": "01:58:50", "text": "ロープ。そして、ロープを作るにはロープが必要だと思う"}, {"type": "chat", "time": 7131.631, "timestamp": "01:58:51", "author": "@WillowMeow", "avatar": "https://yt4.ggpht.com/ledegGiZwa3HFYt0ZFxlKcuXydowMH-HoIoxjWR0PO646v8un4idX8EqahV74ULDlABJ2yE-rA=s64-c-k-c0x00ffffff-no-rj", "message": "ain't no way, it's the blue lazuli!"}, {"type": "subtitle", "time": 7134.55, "timestamp": "01:58:54", "text": "ツール。ああ、私は小麦を持っています"}, {"type": "subtitle", "time": 7137.349, "timestamp": "01:58:57", "text": "私と一緒に小麦を5つ持ってきてください。よし、試してみよう"}]
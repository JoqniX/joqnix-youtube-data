[{"type": "subtitle", "time": 6423.389, "timestamp": "01:47:03", "text": "牛、モナ、そして私たちは殺すつもりです"}, {"type": "subtitle", "time": 6425.63, "timestamp": "01:47:05", "text": "あなた。手に入れます"}, {"type": "subtitle", "time": 6428.309, "timestamp": "01:47:08", "text": "これ。大好きです。逃げるのではなく"}, {"type": "subtitle", "time": 6430.23, "timestamp": "01:47:10", "text": "マインクラフト。"}, {"type": "subtitle", "time": 6433.99, "timestamp": "01:47:13", "text": "それはそこに座って、"}, {"type": "subtitle", "time": 6448.63, "timestamp": "01:47:28", "text": "ニース。ああ、生肉だ。ああ、私たちは"}, {"type": "subtitle", "time": 6450.19, "timestamp": "01:47:30", "text": "私は思う"}, {"type": "subtitle", "time": 6453.19, "timestamp": "01:47:33", "text": "えっと、調理してください。"}]
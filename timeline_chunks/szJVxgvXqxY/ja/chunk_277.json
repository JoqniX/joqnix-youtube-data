[{"type": "subtitle", "time": 16622.47, "timestamp": "04:37:02", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 16625.67, "timestamp": "04:37:05", "text": "こんにちは、ジョブスターさん。"}, {"type": "subtitle", "time": 16629.43, "timestamp": "04:37:09", "text": "うん。こんにちは。うん。こんにちは。それは"}, {"type": "subtitle", "time": 16633.35, "timestamp": "04:37:13", "text": "しばらくしてから。はい。それは、それは"}, {"type": "subtitle", "time": 16636.868, "timestamp": "04:37:16", "text": "かなり長い時間。はい。ええ、"}, {"type": "subtitle", "time": 16639.43, "timestamp": "04:37:19", "text": "かなり長い時間。私はストリーミングしていません"}, {"type": "subtitle", "time": 16643.43, "timestamp": "04:37:23", "text": "長い時間でもない。のように、"}, {"type": "subtitle", "time": 16645.03, "timestamp": "04:37:25", "text": "うん、"}, {"type": "subtitle", "time": 16647.868, "timestamp": "04:37:27", "text": "本当に長い道のりだった。私"}, {"type": "subtitle", "time": 16650.548, "timestamp": "04:37:30", "text": "君とマインクラフトで遊んだことを覚えてるよ。"}, {"type": "subtitle", "time": 16653.99, "timestamp": "04:37:33", "text": "一度。そうそう。何てことだ。その１つ、"}, {"type": "subtitle", "time": 16655.91, "timestamp": "04:37:35", "text": "右？覚えていますか？はい。はい。"}, {"type": "subtitle", "time": 16657.91, "timestamp": "04:37:37", "text": "はい。私は今でもマインクラフトをプレイしていますが、はい。"}, {"type": "subtitle", "time": 16660.868, "timestamp": "04:37:40", "text": "はい。本当に久しぶりですね。その"}, {"type": "subtitle", "time": 16665.03, "timestamp": "04:37:45", "text": "本当に久しぶりだ。うん、"}, {"type": "subtitle", "time": 16668.548, "timestamp": "04:37:48", "text": "楽しかったよ。前回は楽しかったです。"}, {"type": "subtitle", "time": 16670.708, "timestamp": "04:37:50", "text": "ええ、私も楽しかったです。私はたくさん"}, {"type": "subtitle", "time": 16674.23, "timestamp": "04:37:54", "text": "楽しい。うん。うん、楽しかったよ。私は思う"}, {"type": "subtitle", "time": 16676.708, "timestamp": "04:37:56", "text": "私の氷の村の世話をしていた、あるいは"}, {"type": "subtitle", "time": 16679.67, "timestamp": "04:37:59", "text": "その日に何か。私の作物とか色々。"}]
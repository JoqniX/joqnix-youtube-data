[{"type": "subtitle", "time": 12904.59, "timestamp": "03:35:04", "text": "ブラウザ。はぁ？何をすべきか"}, {"type": "subtitle", "time": 12909.31, "timestamp": "03:35:09", "text": "する？待って。えっと、オープンゲットをプレイするとき"}, {"type": "subtitle", "time": 12912.429, "timestamp": "03:35:12", "text": "誰か経験した人はいますか"}, {"type": "subtitle", "time": 12915.269, "timestamp": "03:35:15", "text": "これ？ブラウザに新しいタブが開きます。"}, {"type": "subtitle", "time": 12917.75, "timestamp": "03:35:17", "text": "Epic Games または画面の損失によるアクセス"}, {"type": "subtitle", "time": 12919.109, "timestamp": "03:35:19", "text": "プロフィール。ログインしている場合は、"}, {"type": "subtitle", "time": 12922.269, "timestamp": "03:35:22", "text": "許可をクリックする必要がありますか、"}, {"type": "subtitle", "time": 12925.51, "timestamp": "03:35:25", "text": "えっと、Epic Gamesからサインアウトすると表示されます"}, {"type": "subtitle", "time": 12927.99, "timestamp": "03:35:27", "text": "ブラウザを開いて"}, {"type": "subtitle", "time": 12929.869, "timestamp": "03:35:29", "text": "えーと"}, {"type": "subtitle", "time": 12933.189, "timestamp": "03:35:33", "text": "待って。どちらにしても、ブラウザは"}, {"type": "subtitle", "time": 12936.83, "timestamp": "03:35:36", "text": "Civic 6 を開けようとすると開きます。"}, {"type": "subtitle", "time": 12939.269, "timestamp": "03:35:39", "text": "Civilizer は、あなたが"}, {"type": "subtitle", "time": 12947.869, "timestamp": "03:35:47", "text": "ハァ。"}, {"type": "subtitle", "time": 12951.189, "timestamp": "03:35:51", "text": "えーと、どのブラウザを使用しているか確認してください"}, {"type": "subtitle", "time": 12954.709, "timestamp": "03:35:54", "text": "デフォルト。ランチャーを実行しようとしています"}, {"type": "subtitle", "time": 12956.789, "timestamp": "03:35:56", "text": "デフォルト設定で切り替えた"}, {"type": "subtitle", "time": 12959.109, "timestamp": "03:35:59", "text": "クロム。ああ、だから私は切り替える必要がある"}]
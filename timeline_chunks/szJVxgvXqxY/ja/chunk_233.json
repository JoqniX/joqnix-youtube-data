[{"type": "subtitle", "time": 13980.19, "timestamp": "03:53:00", "text": "に。待って、これは誰？"}, {"type": "subtitle", "time": 13986.03, "timestamp": "03:53:06", "text": "リプレイ"}, {"type": "subtitle", "time": 13988.788, "timestamp": "03:53:08", "text": "あなたは真の友人です。彼らは"}, {"type": "subtitle", "time": 13993.91, "timestamp": "03:53:13", "text": "ああ、それは待つ必要がある。そこには"}, {"type": "subtitle", "time": 13996.948, "timestamp": "03:53:16", "text": "このゲームの会話。何？あなたは"}, {"type": "subtitle", "time": 14005.43, "timestamp": "03:53:25", "text": "とても良い。"}, {"type": "subtitle", "time": 14007.35, "timestamp": "03:53:27", "text": "さようなら。"}, {"type": "subtitle", "time": 14009.11, "timestamp": "03:53:29", "text": "ついに追跡できたようだ"}, {"type": "subtitle", "time": 14011.11, "timestamp": "03:53:31", "text": "これらの地域を悩ませている蛮族の襲撃者たち"}, {"type": "subtitle", "time": 14014.31, "timestamp": "03:53:34", "text": "土地をその源泉へ。我々は破壊しなければならない"}, {"type": "subtitle", "time": 14018.07, "timestamp": "03:53:38", "text": "拠点を守らなければ、将来の攻撃の危険にさらされる。"}, {"type": "subtitle", "time": 14020.51, "timestamp": "03:53:40", "text": "もっと詳しく教えてください。"}, {"type": "subtitle", "time": 14022.788, "timestamp": "03:53:42", "text": "野蛮人は前哨基地​​からやって来るかもしれない"}, {"type": "subtitle", "time": 14024.788, "timestamp": "03:53:44", "text": "任意のタイルにランダムに現れる"}, {"type": "subtitle", "time": 14026.948, "timestamp": "03:53:46", "text": "どのユニットでも見ることができます。各バーバーユニット"}, {"type": "subtitle", "time": 14029.43, "timestamp": "03:53:49", "text": "本拠地の前哨基地に属する。 3つあります"}]
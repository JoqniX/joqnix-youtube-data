[{"type": "subtitle", "time": 19682.07, "timestamp": "05:28:02", "text": "温泉で有名な場所のように"}, {"type": "subtitle", "time": 19685.75, "timestamp": "05:28:05", "text": "ワンネン、ああ、それは山でもある"}, {"type": "subtitle", "time": 19689.27, "timestamp": "05:28:09", "text": "最初のレーシングマウンテンをご覧ください。"}, {"type": "subtitle", "time": 19708.15, "timestamp": "05:28:28", "text": "とても楽しい場所です。だから、私は"}, {"type": "subtitle", "time": 19712.23, "timestamp": "05:28:32", "text": "そこへ行くことができる。はい。うん。"}, {"type": "subtitle", "time": 19714.39, "timestamp": "05:28:34", "text": "本日はありがとうございました。次回は"}, {"type": "subtitle", "time": 19716.468, "timestamp": "05:28:36", "text": "もっと遊ぶべきだ。ええ、そうすべきですね。"}, {"type": "subtitle", "time": 19720.07, "timestamp": "05:28:40", "text": "もっとプレイしよう。もっとプレイしよう。絶対に。うん。"}, {"type": "subtitle", "time": 19727.23, "timestamp": "05:28:47", "text": "バイバイ。"}, {"type": "subtitle", "time": 19735.03, "timestamp": "05:28:55", "text": "というわけで、皆さん、ジョブ・ササンでした。私たちは"}, {"type": "subtitle", "time": 19738.708, "timestamp": "05:28:58", "text": "ササンはたった1時間しか仕事をしていない"}]
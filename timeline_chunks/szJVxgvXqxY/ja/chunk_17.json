[{"type": "subtitle", "time": 1021.99, "timestamp": "00:17:01", "text": "2020年を止めます。そのくらいだと思います。"}, {"type": "subtitle", "time": 1024.87, "timestamp": "00:17:04", "text": "チューブを始めたと思います"}, {"type": "subtitle", "time": 1029.75, "timestamp": "00:17:09", "text": "Twitchでのストリーミング配信は2019年初頭から始まった。"}, {"type": "subtitle", "time": 1032.79, "timestamp": "00:17:12", "text": "えーと、YouTuberを目指していた人が"}, {"type": "subtitle", "time": 1037.43, "timestamp": "00:17:17", "text": "PNGとかそういうのと同じように。えーと、2020年"}, {"type": "subtitle", "time": 1039.43, "timestamp": "00:17:19", "text": "9月。ええ、9月20日。ええ、"}, {"type": "subtitle", "time": 1042.709, "timestamp": "00:17:22", "text": "2020年9月はだいたいそんな感じだった"}, {"type": "subtitle", "time": 1045.83, "timestamp": "00:17:25", "text": "初めて始めた頃"}, {"type": "subtitle", "time": 1048.79, "timestamp": "00:17:28", "text": "ああいう風にこのチューブみたいなものに差し込むんだ。戻る"}, {"type": "subtitle", "time": 1050.59, "timestamp": "00:17:30", "text": "その時は知らなかった"}, {"type": "subtitle", "time": 1053.55, "timestamp": "00:17:33", "text": "誰でも。うん、"}, {"type": "subtitle", "time": 1055.63, "timestamp": "00:17:35", "text": "同じ。"}, {"type": "subtitle", "time": 1058.39, "timestamp": "00:17:38", "text": "でも、チューニングは楽しいんです。さて、"}, {"type": "subtitle", "time": 1059.95, "timestamp": "00:17:39", "text": "あなたは思う？食事はどうでしたか？"}, {"type": "subtitle", "time": 1063.39, "timestamp": "00:17:43", "text": "これまでの経験は？"}, {"type": "subtitle", "time": 1066.87, "timestamp": "00:17:46", "text": "ああ、でもすごく楽しかったよ。うん、そうだよ"}, {"type": "subtitle", "time": 1070.75, "timestamp": "00:17:50", "text": "楽しめ。それは、"}, {"type": "subtitle", "time": 1073.35, "timestamp": "00:17:53", "text": "何をすればいいのかわからない"}, {"type": "subtitle", "time": 1076.709, "timestamp": "00:17:56", "text": "寒いです。"}]
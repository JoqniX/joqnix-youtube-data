[{"type": "subtitle", "time": 17582.47, "timestamp": "04:53:02", "text": "点線を入れたのはあなたですか？あなたは"}, {"type": "subtitle", "time": 17586.39, "timestamp": "04:53:06", "text": "点を打つ。待って。ドット。ドット"}, {"type": "subtitle", "time": 17588.43, "timestamp": "04:53:08", "text": "一緒に"}, {"type": "subtitle", "time": 17591.75, "timestamp": "04:53:11", "text": "あなた。なるほど。"}, {"type": "subtitle", "time": 17594.39, "timestamp": "04:53:14", "text": "ちょっと待って。もう一度行く必要がある。私たちには必要だ"}, {"type": "subtitle", "time": 17597.27, "timestamp": "04:53:17", "text": "もう一度挑戦する。大丈夫。ああ、どうやって"}, {"type": "subtitle", "time": 17600.15, "timestamp": "04:53:20", "text": "それ。私はこれが好きです。はぁ？わかりました、それをいただきます。"}, {"type": "subtitle", "time": 17602.708, "timestamp": "04:53:22", "text": "私がやります。買います。うん。"}, {"type": "subtitle", "time": 17605.03, "timestamp": "04:53:25", "text": "私は犠牲になります。"}, {"type": "subtitle", "time": 17626.23, "timestamp": "04:53:46", "text": "どうやって電源を入れるのですか？すでに電源が入っていた。"}, {"type": "subtitle", "time": 17629.548, "timestamp": "04:53:49", "text": "ドット画面が表示されません"}]
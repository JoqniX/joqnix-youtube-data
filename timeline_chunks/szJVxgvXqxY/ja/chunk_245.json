[{"type": "subtitle", "time": 14703.67, "timestamp": "04:05:03", "text": "敵の支配地域。"}, {"type": "subtitle", "time": 14705.99, "timestamp": "04:05:05", "text": "多くの戦闘部隊は、"}, {"type": "subtitle", "time": 14708.628, "timestamp": "04:05:08", "text": "コントロール。タイルに対する影響は、Zなのか、それともZなのか？"}, {"type": "subtitle", "time": 14711.59, "timestamp": "04:05:11", "text": "彼らの周りで？戦闘部隊が"}, {"type": "subtitle", "time": 14714.788, "timestamp": "04:05:14", "text": "空気は狙いに関係なく止まらなければならない"}, {"type": "subtitle", "time": 14717.51, "timestamp": "04:05:17", "text": "一瞬。ユニットは停止しました"}, {"type": "subtitle", "time": 14719.75, "timestamp": "04:05:19", "text": "敵は必要な時に攻撃する"}, {"type": "subtitle", "time": 14723.19, "timestamp": "04:05:23", "text": "そうするために。遠距離攻撃クラスと砲撃クラス"}, {"type": "subtitle", "time": 14725.07, "timestamp": "04:05:25", "text": "ユニットは"}, {"type": "subtitle", "time": 14729.03, "timestamp": "04:05:29", "text": "正確でもある。 Nライダーユニット、ユニット"}, {"type": "subtitle", "time": 14731.23, "timestamp": "04:05:31", "text": "能力を持つ"}, {"type": "subtitle", "time": 14734.47, "timestamp": "04:05:34", "text": "支配領域を無視する。わかった。逆行する"}, {"type": "subtitle", "time": 14736.31, "timestamp": "04:05:36", "text": "全ての部隊から制御区域を遮断する。"}, {"type": "subtitle", "time": 14739.07, "timestamp": "04:05:39", "text": "わかった。では、私たちは戦うのか、それとも"}, {"type": "subtitle", "time": 14742.83, "timestamp": "04:05:42", "text": "ない？二人とも生意気だね"}, {"type": "subtitle", "time": 14750.35, "timestamp": "04:05:50", "text": "えっと、"}, {"type": "subtitle", "time": 14753.99, "timestamp": "04:05:53", "text": "次。わかった。彼はあそこで立ち往生している。わかった。"}, {"type": "subtitle", "time": 14756.55, "timestamp": "04:05:56", "text": "ああ、またか。この男は誰だ？"}, {"type": "subtitle", "time": 14758.51, "timestamp": "04:05:58", "text": "野蛮人"}]
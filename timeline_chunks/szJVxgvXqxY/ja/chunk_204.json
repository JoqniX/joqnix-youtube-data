[{"type": "subtitle", "time": 12240.189, "timestamp": "03:24:00", "text": "ついに、"}, {"type": "subtitle", "time": 12243.309, "timestamp": "03:24:03", "text": "やっと、やっと。ああ、"}, {"type": "subtitle", "time": 12245.95, "timestamp": "03:24:05", "text": "神。"}, {"type": "subtitle", "time": 12249.59, "timestamp": "03:24:09", "text": "ついに。新しい呼び込み係。なぜそうしないのか"}, {"type": "subtitle", "time": 12252.11, "timestamp": "03:24:12", "text": "働く？あなたを排除します"}, {"type": "subtitle", "time": 12255.55, "timestamp": "03:24:15", "text": "まず、あなたを追加します"}, {"type": "subtitle", "time": 12257.149, "timestamp": "03:24:17", "text": "また。"}, {"type": "subtitle", "time": 12259.99, "timestamp": "03:24:19", "text": "ああ、わかった。もう一度あなたを追加します。わかった、"}, {"type": "subtitle", "time": 12262.429, "timestamp": "03:24:22", "text": "はい、どうぞ。最後に、"}, {"type": "subtitle", "time": 12265.229, "timestamp": "03:24:25", "text": "うまくいった。ああ、ついに"}, {"type": "subtitle", "time": 12267.87, "timestamp": "03:24:27", "text": "うまくいったよ。あなたに会いたかった。ああ、神様。おお"}, {"type": "subtitle", "time": 12271.189, "timestamp": "03:24:31", "text": "神。よし、これをここから引き下げよう"}, {"type": "subtitle", "time": 12274.91, "timestamp": "03:24:34", "text": "そして、その選択を解除してください。スタジオに戻る"}, {"type": "subtitle", "time": 12279.51, "timestamp": "03:24:39", "text": "モードと、そして、私のこのものはどこにあるの？"}, {"type": "subtitle", "time": 12281.269, "timestamp": "03:24:41", "text": "気にしないで、Chto。久しぶりですね"}, {"type": "subtitle", "time": 12284.229, "timestamp": "03:24:44", "text": "ストリーミング配信をしているので、技術的な"}, {"type": "subtitle", "time": 12286.95, "timestamp": "03:24:46", "text": "このような困難は起こりうる。道場"}, {"type": "subtitle", "time": 12295.429, "timestamp": "03:24:55", "text": "はい、どうぞ。修理完了です。"}, {"type": "subtitle", "time": 12297.79, "timestamp": "03:24:57", "text": "最後に、"}, {"type": "subtitle", "time": 12299.83, "timestamp": "03:24:59", "text": "修理済み。よし、いいぞ、いいぞ、いいぞ、いいぞ、"}]
[{"type": "subtitle", "time": 5462.07, "timestamp": "01:31:02", "text": "今日は本当に楽しかった。とても楽しかった"}, {"type": "subtitle", "time": 5463.99, "timestamp": "01:31:03", "text": "そして初めてあなたと話すことができました"}, {"type": "subtitle", "time": 5467.99, "timestamp": "01:31:07", "text": "久しぶりにきちんと時間を取る。うん。"}, {"type": "subtitle", "time": 5470.19, "timestamp": "01:31:10", "text": "うん。私は"}, {"type": "subtitle", "time": 5474.469, "timestamp": "01:31:14", "text": "ハッピー。楽しんでいただければ幸いです。楽しめ。そうだった"}, {"type": "subtitle", "time": 5476.67, "timestamp": "01:31:16", "text": "楽しい。うん。"}, {"type": "subtitle", "time": 5479.83, "timestamp": "01:31:19", "text": "うん。将来、もし私たちが吊るす必要があるなら"}, {"type": "subtitle", "time": 5482.03, "timestamp": "01:31:22", "text": "外出したりゲームをしたりする"}, {"type": "subtitle", "time": 5484.63, "timestamp": "01:31:24", "text": "一緒に。あなたがApexをプレイしていることを知っているので、"}, {"type": "subtitle", "time": 5488.469, "timestamp": "01:31:28", "text": "日曜日はApexをプレイするべきだ。"}, {"type": "subtitle", "time": 5492.15, "timestamp": "01:31:32", "text": "わかった。うん。"}, {"type": "subtitle", "time": 5495.67, "timestamp": "01:31:35", "text": "こんにちは。こんにちは。お招きいただきありがとうございます。する"}, {"type": "subtitle", "time": 5497.75, "timestamp": "01:31:37", "text": "何か言いたいことはありますか？"}, {"type": "subtitle", "time": 5499.99, "timestamp": "01:31:39", "text": "出発前に？どれも同じように"}, {"type": "subtitle", "time": 5502.23, "timestamp": "01:31:42", "text": "メッセージやアナウンス、その他"}, {"type": "subtitle", "time": 5504.91, "timestamp": "01:31:44", "text": "共有したいですか？"}, {"type": "subtitle", "time": 5507.99, "timestamp": "01:31:47", "text": "えーと、実際にはないんだけど、えーと"}, {"type": "subtitle", "time": 5512.07, "timestamp": "01:31:52", "text": "皆さん、来てくれてありがとう"}, {"type": "subtitle", "time": 5515.59, "timestamp": "01:31:55", "text": "このストリームを見て、私を見ている"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "ジョーです。招待してくれてありがとう。"}]
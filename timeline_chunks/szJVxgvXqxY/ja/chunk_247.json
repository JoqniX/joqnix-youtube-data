[{"type": "subtitle", "time": 14820.788, "timestamp": "04:07:00", "text": "ジェネラルシャワーからえーっと待って、やめて"}, {"type": "subtitle", "time": 14822.948, "timestamp": "04:07:02", "text": "彼らは自分自身を浄化する"}, {"type": "subtitle", "time": 14826.948, "timestamp": "04:07:06", "text": "時々川に行く？私はそう思います、"}, {"type": "subtitle", "time": 14829.51, "timestamp": "04:07:09", "text": "右？彼らは、待って、彼らは"}, {"type": "subtitle", "time": 14830.67, "timestamp": "04:07:10", "text": "する、"}, {"type": "subtitle", "time": 14841.23, "timestamp": "04:07:21", "text": "では、私はどうすればいいのでしょうか？"}, {"type": "subtitle", "time": 14843.868, "timestamp": "04:07:23", "text": "けれど？混乱した"}, {"type": "subtitle", "time": 14847.07, "timestamp": "04:07:27", "text": "騒音。購入する"}, {"type": "subtitle", "time": 14856.39, "timestamp": "04:07:36", "text": "選ぶ？部隊のニーズ。あのね？大丈夫。"}, {"type": "chat", "time": 14864.568, "timestamp": "04:07:44", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "doxx him harder"}, {"type": "subtitle", "time": 14869.43, "timestamp": "04:07:49", "text": "ああ、この方はどなたですか？私たちは発見しました"}, {"type": "subtitle", "time": 14871.91, "timestamp": "04:07:51", "text": "都市国家。都市国家。設立"}, {"type": "subtitle", "time": 14874.23, "timestamp": "04:07:54", "text": "彼らとの外交関係は"}, {"type": "subtitle", "time": 14877.11, "timestamp": "04:07:57", "text": "それは間違いなく我々の帝国にとって有益だろう。"}, {"type": "subtitle", "time": 14878.868, "timestamp": "04:07:58", "text": "使者を派遣すべきかもしれない。"}]
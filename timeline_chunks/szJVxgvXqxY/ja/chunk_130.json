[{"type": "subtitle", "time": 7834.15, "timestamp": "02:10:34", "text": "戻ってきました。それで、どうやら私は行かなければならないようです"}, {"type": "subtitle", "time": 7837.03, "timestamp": "02:10:37", "text": "明日アカデミーに行く。えーと、"}, {"type": "subtitle", "time": 7841.59, "timestamp": "02:10:41", "text": "次の段階に進む、うん"}, {"type": "subtitle", "time": 7843.51, "timestamp": "02:10:43", "text": "来月、日本に行く予定です。それで"}, {"type": "subtitle", "time": 7846.71, "timestamp": "02:10:46", "text": "7月入学の人は来なければならない"}, {"type": "subtitle", "time": 7848.87, "timestamp": "02:10:48", "text": "明日、会議があります。"}, {"type": "subtitle", "time": 7851.99, "timestamp": "02:10:51", "text": "何てことだ。ありがたいことに私は"}, {"type": "subtitle", "time": 7855.11, "timestamp": "02:10:55", "text": "ありがたいことに、私の持ち物のほとんどは"}, {"type": "subtitle", "time": 7858.87, "timestamp": "02:10:58", "text": "例えば明日、えっと、なんて言うんだっけ？えっと"}]
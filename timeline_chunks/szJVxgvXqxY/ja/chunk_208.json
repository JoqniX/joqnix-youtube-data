[{"type": "subtitle", "time": 12488.429, "timestamp": "03:28:08", "text": "ミス"}, {"type": "subtitle", "time": 12493.59, "timestamp": "03:28:13", "text": "えっと、ストリーミングは本当に恋しくなかった"}, {"type": "subtitle", "time": 12503.99, "timestamp": "03:28:23", "text": "ああ、それから、もしもチャットだったら"}, {"type": "subtitle", "time": 12510.59, "timestamp": "03:28:30", "text": "いずれにせよ、もしあなたが私が行くのを見たら"}, {"type": "subtitle", "time": 12514.83, "timestamp": "03:28:34", "text": "えっと、私がヤイって言ってるのが見えたら、私を叩いて"}, {"type": "subtitle", "time": 12517.75, "timestamp": "03:28:37", "text": "わかった、だって最近手に入れたんだ"}, {"type": "subtitle", "time": 12519.99, "timestamp": "03:28:39", "text": "心配している、心配していない、そして不安に思っている"}, {"type": "subtitle", "time": 12522.349, "timestamp": "03:28:42", "text": "それについて"}, {"type": "subtitle", "time": 12523.95, "timestamp": "03:28:43", "text": "実は。"}, {"type": "subtitle", "time": 12528.149, "timestamp": "03:28:48", "text": "ええ、そう言えるかもしれませんね。これは何ですか？"}, {"type": "subtitle", "time": 12530.87, "timestamp": "03:28:50", "text": "開いているブラウザ（Webブラウザ）を探してください。"}, {"type": "subtitle", "time": 12532.99, "timestamp": "03:28:52", "text": "そして指示に従ってください。"}, {"type": "subtitle", "time": 12537.67, "timestamp": "03:28:57", "text": "何？ 「何も開かなかったわ」とマヤは言った。何"}]
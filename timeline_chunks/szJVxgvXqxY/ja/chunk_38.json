[{"type": "subtitle", "time": 2281.27, "timestamp": "00:38:01", "text": "何に対しても。そこには"}, {"type": "subtitle", "time": 2284.47, "timestamp": "00:38:04", "text": "紫色の物体がある。"}, {"type": "subtitle", "time": 2286.95, "timestamp": "00:38:06", "text": "ああ、紫色の銃がある。ピストル。あなたが持っている"}, {"type": "subtitle", "time": 2291.43, "timestamp": "00:38:11", "text": "銃。ここに拳銃があります。"}, {"type": "subtitle", "time": 2293.75, "timestamp": "00:38:13", "text": "ざまあみろ。ああ、その上に箱がある"}, {"type": "subtitle", "time": 2303.43, "timestamp": "00:38:23", "text": "配送方法。ああ、こっちだよ。"}, {"type": "subtitle", "time": 2305.59, "timestamp": "00:38:25", "text": "AKです。"}, {"type": "subtitle", "time": 2315.109, "timestamp": "00:38:35", "text": "こちらにも別のチームがあるはずだ。"}]
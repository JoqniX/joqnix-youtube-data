[{"type": "subtitle", "time": 12181.91, "timestamp": "03:23:01", "text": "こんにちは。ああ、神様。何？これからどうすればいいんだろう？"}, {"type": "subtitle", "time": 12183.83, "timestamp": "03:23:03", "text": "なぜライト2Dのものが"}, {"type": "subtitle", "time": 12184.34, "timestamp": "03:23:04", "text": "しないで"}, {"type": "subtitle", "time": 12186.67, "timestamp": "03:23:06", "text": "[音楽]"}, {"type": "subtitle", "time": 12189.59, "timestamp": "03:23:09", "text": "仕事。他に何ができるだろうか"}, {"type": "subtitle", "time": 12193.429, "timestamp": "03:23:13", "text": "話題に出してみないか？えっと、実はよくわからないんです。"}, {"type": "subtitle", "time": 12196.149, "timestamp": "03:23:16", "text": "しかし、問題はそれが表示されるということです"}, {"type": "subtitle", "time": 12198.71, "timestamp": "03:23:18", "text": "画面。例えば、フィルターに入ると、"}, {"type": "subtitle", "time": 12201.99, "timestamp": "03:23:21", "text": "そこにあることは分かる。しかし、そうではない"}, {"type": "subtitle", "time": 12204.71, "timestamp": "03:23:24", "text": "のように表示される"}, {"type": "subtitle", "time": 12207.75, "timestamp": "03:23:27", "text": "えっと、そのシーンには登場しません。私"}, {"type": "subtitle", "time": 12210.389, "timestamp": "03:23:30", "text": "理由はわからない。寒いですか？暑いですか、それとも"}, {"type": "subtitle", "time": 12212.63, "timestamp": "03:23:32", "text": "そちらは寒いですか？寒い。はい、"}, {"type": "subtitle", "time": 12213.95, "timestamp": "03:23:33", "text": "は"}, {"type": "subtitle", "time": 12217.71, "timestamp": "03:23:37", "text": "寒い。寒い。雨が降っている"}, {"type": "subtitle", "time": 12222.51, "timestamp": "03:23:42", "text": "最近は特にそうだ。というわけで、寒い日が続いています。"}, {"type": "subtitle", "time": 12224.99, "timestamp": "03:23:44", "text": "寒い？"}, {"type": "subtitle", "time": 12228.389, "timestamp": "03:23:48", "text": "うん。ええ、寒かったです。寒い。"}, {"type": "subtitle", "time": 12230.71, "timestamp": "03:23:50", "text": "はい、どうぞ。今、それは現れた。わかった、"}, {"type": "subtitle", "time": 12234.63, "timestamp": "03:23:54", "text": "いいぞ、いいぞ、いいぞ。彼を呼んでみましょう。"}, {"type": "subtitle", "time": 12235.79, "timestamp": "03:23:55", "text": "そこにいる"}, {"type": "subtitle", "time": 12238.429, "timestamp": "03:23:58", "text": "行く。聖なる神よ。"}]
[{"type": "subtitle", "time": 14223.948, "timestamp": "03:57:03", "text": "じゃあ次はここに戻りましょう"}, {"type": "subtitle", "time": 14227.31, "timestamp": "03:57:07", "text": "振り向く。ああ、この人たちは"}, {"type": "subtitle", "time": 14238.788, "timestamp": "03:57:18", "text": "そこには。でも待って、ゲームが言ったんだけど"}, {"type": "subtitle", "time": 14241.27, "timestamp": "03:57:21", "text": "野蛮人を倒して殺すべきだ、"}, {"type": "subtitle", "time": 14247.39, "timestamp": "03:57:27", "text": "だから私は信じています"}, {"type": "subtitle", "time": 14248.91, "timestamp": "03:57:28", "text": "それ。"}, {"type": "subtitle", "time": 14256.59, "timestamp": "03:57:36", "text": "彼ら。また一人。何が"}, {"type": "subtitle", "time": 14265.23, "timestamp": "03:57:45", "text": "おお、"}, {"type": "subtitle", "time": 14272.708, "timestamp": "03:57:52", "text": "モリー。彼らはそちら側へ行った。この男"}, {"type": "subtitle", "time": 14275.27, "timestamp": "03:57:55", "text": "そちら側へ行った。天国には犬はいない。"}, {"type": "subtitle", "time": 14278.07, "timestamp": "03:57:58", "text": "解き放たれた畜産。私は行ってみたい"}]
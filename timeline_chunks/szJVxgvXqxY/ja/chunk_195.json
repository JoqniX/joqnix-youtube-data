[{"type": "subtitle", "time": 11711.03, "timestamp": "03:15:11", "text": "ああ、わかりました。ナイスショット。もう二度と私を呼ばないで。"}, {"type": "subtitle", "time": 11721.83, "timestamp": "03:15:21", "text": "あれは本当に美味しかった。それはとても良い"}, {"type": "subtitle", "time": 11724.87, "timestamp": "03:15:24", "text": "撃ったよ、兄弟。"}, {"type": "subtitle", "time": 11737.309, "timestamp": "03:15:37", "text": "必要"}, {"type": "subtitle", "time": 11740.71, "timestamp": "03:15:40", "text": "落とす。少しだけ必要だ。"}, {"type": "subtitle", "time": 11743.429, "timestamp": "03:15:43", "text": "ありがとう。はい、戻ってきました。戻ってきました。"}, {"type": "subtitle", "time": 11746.309, "timestamp": "03:15:46", "text": "おかえり、兄弟。私のシュート、見ましたか？"}, {"type": "subtitle", "time": 11749.83, "timestamp": "03:15:49", "text": "うん、素晴らしかったよ。"}]
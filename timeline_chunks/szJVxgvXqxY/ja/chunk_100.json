[{"type": "subtitle", "time": 6000.95, "timestamp": "01:40:00", "text": "将来的にはそうなるかもしれないが、すぐにはそうならないだろう"}, {"type": "subtitle", "time": 6006.469, "timestamp": "01:40:06", "text": "お元気ですか？調子はどうですか？"}, {"type": "subtitle", "time": 6009.51, "timestamp": "01:40:09", "text": "行くの？順調だよ。私はスピードです"}, {"type": "subtitle", "time": 6011.59, "timestamp": "01:40:11", "text": "現在、コラボレーション企画を実施中です。招待します"}, {"type": "subtitle", "time": 6014.07, "timestamp": "01:40:14", "text": "うっかり招待しすぎた"}, {"type": "subtitle", "time": 6017.349, "timestamp": "01:40:17", "text": "この時点で、私は「ああ、そうしないといけない」と思う"}, {"type": "subtitle", "time": 6021.429, "timestamp": "01:40:21", "text": "えーと、人を招待したので、えーと、"}, {"type": "subtitle", "time": 6028.55, "timestamp": "01:40:28", "text": "だから、あなたが"}, {"type": "subtitle", "time": 6031.51, "timestamp": "01:40:31", "text": "たくさんの人。"}, {"type": "subtitle", "time": 6033.15, "timestamp": "01:40:33", "text": "となることによって"}, {"type": "subtitle", "time": 6037.99, "timestamp": "01:40:37", "text": "うん、本当に楽しいよ。"}, {"type": "subtitle", "time": 6040.71, "timestamp": "01:40:40", "text": "えーと、人々と知り合うため、そして主に"}, {"type": "subtitle", "time": 6042.469, "timestamp": "01:40:42", "text": "かつて私が関わっていた人々と再び繋がるために"}, {"type": "subtitle", "time": 6045.349, "timestamp": "01:40:45", "text": "以前にやり取りしたが、やり取りできなかった"}, {"type": "subtitle", "time": 6048.469, "timestamp": "01:40:48", "text": "長い間、そして今私は"}, {"type": "subtitle", "time": 6050.469, "timestamp": "01:40:50", "text": "彼らと交流し、それはとても"}, {"type": "subtitle", "time": 6057.83, "timestamp": "01:40:57", "text": "ええ、まさにその通りです。"}]
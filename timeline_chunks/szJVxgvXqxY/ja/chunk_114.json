[{"type": "subtitle", "time": 6841.91, "timestamp": "01:54:01", "text": "最初からここに来ればよかった。私たちはそうしなかった"}, {"type": "subtitle", "time": 6849.19, "timestamp": "01:54:09", "text": "なんてこった。"}, {"type": "subtitle", "time": 6851.67, "timestamp": "01:54:11", "text": "これらのキャビンを一緒に持っていけたらいいのに"}, {"type": "subtitle", "time": 6855.91, "timestamp": "01:54:15", "text": "自分。いいえ、小屋ではなく、壁のことです。"}, {"type": "subtitle", "time": 6858.07, "timestamp": "01:54:18", "text": "うん。"}, {"type": "subtitle", "time": 6863.4, "timestamp": "01:54:23", "text": "残念ながら。"}, {"type": "subtitle", "time": 6872.309, "timestamp": "01:54:32", "text": "うん。わかった。ああ、なぜあんなことをしてしまったんだろう？バカ"}, {"type": "subtitle", "time": 6873.83, "timestamp": "01:54:33", "text": "バカバカ。何てことだ。大丈夫。その"}, {"type": "subtitle", "time": 6882.87, "timestamp": "01:54:42", "text": "何かが出現しそうな予感がする。"}, {"type": "subtitle", "time": 6884.389, "timestamp": "01:54:44", "text": "うん。"}, {"type": "subtitle", "time": 6886.79, "timestamp": "01:54:46", "text": "はい。彼らはスポーンし始めた"}, {"type": "subtitle", "time": 6887.91, "timestamp": "01:54:47", "text": "あなたの後ろに。あなたの後ろに。あなたの後ろに。"}, {"type": "subtitle", "time": 6888.83, "timestamp": "01:54:48", "text": "後ろに"}, {"type": "subtitle", "time": 6898.309, "timestamp": "01:54:58", "text": "彼は私を締め出したんだと思う。えっと。なんてこった。"}]
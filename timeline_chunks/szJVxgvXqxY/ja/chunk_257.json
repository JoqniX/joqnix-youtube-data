[{"type": "subtitle", "time": 15425.788, "timestamp": "04:17:05", "text": "つまり、2つあります"}, {"type": "subtitle", "time": 15435.67, "timestamp": "04:17:15", "text": "市民？研究を選びなさい。わかった。私は必要としている"}, {"type": "subtitle", "time": 15445.43, "timestamp": "04:17:25", "text": "時間。野蛮人がこちらにいます。私はしません"}, {"type": "subtitle", "time": 15448.67, "timestamp": "04:17:28", "text": "単位の作り方を知っている。"}, {"type": "subtitle", "time": 15453.31, "timestamp": "04:17:33", "text": "ええと、街には食料が必要です。おお"}, {"type": "subtitle", "time": 15457.31, "timestamp": "04:17:37", "text": "いいえ。なんてこった。どうやって彼らに渡せばいいですか"}, {"type": "subtitle", "time": 15460.75, "timestamp": "04:17:40", "text": "食べ物？私は持っていません"}, {"type": "subtitle", "time": 15473.35, "timestamp": "04:17:53", "text": "する？都市住民の食への関心を高める。"}, {"type": "subtitle", "time": 15479.83, "timestamp": "04:17:59", "text": "作業している人を見ることはできませんか"}]
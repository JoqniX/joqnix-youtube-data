[{"type": "subtitle", "time": 8402.15, "timestamp": "02:20:02", "text": "こちらです。ああ、たくさん手に入れたよ"}, {"type": "subtitle", "time": 8405.19, "timestamp": "02:20:05", "text": "木材の。私は69本の木材を持っています。おお、"}, {"type": "subtitle", "time": 8421.429, "timestamp": "02:20:21", "text": "パワーアップ。私を殺すのを忘れないで"}, {"type": "subtitle", "time": 8423.269, "timestamp": "02:20:23", "text": "の"}, {"type": "subtitle", "time": 8427.269, "timestamp": "02:20:27", "text": "牛を買って肉を手に入れよう。"}, {"type": "subtitle", "time": 8430.07, "timestamp": "02:20:30", "text": "パワーアップアイテムはいくつ入手しましたか？私は持っている"}, {"type": "subtitle", "time": 8431.91, "timestamp": "02:20:31", "text": "何もない。"}, {"type": "subtitle", "time": 8433.59, "timestamp": "02:20:33", "text": "そうそう。ああ、宝箱を開けるんですね。"}, {"type": "subtitle", "time": 8435.19, "timestamp": "02:20:35", "text": "わかった。わかった。あなたは宝箱を開けています。"}, {"type": "subtitle", "time": 8437.11, "timestamp": "02:20:37", "text": "わかった。わかった。"}, {"type": "subtitle", "time": 8440.07, "timestamp": "02:20:40", "text": "コインを全部使い切ってしまいました。"}]
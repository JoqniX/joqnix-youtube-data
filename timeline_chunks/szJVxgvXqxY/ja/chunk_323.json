[{"type": "subtitle", "time": 19394.788, "timestamp": "05:23:14", "text": "行く。どこにいるの？何てことだ。誇張なし。"}, {"type": "subtitle", "time": 19397.43, "timestamp": "05:23:17", "text": "オーブはなし。"}, {"type": "subtitle", "time": 19401.67, "timestamp": "05:23:21", "text": "超クールな見た目にするべきでしょうか？"}, {"type": "subtitle", "time": 19404.07, "timestamp": "05:23:24", "text": "ええ、もう中に入れてありますよ。の"}, {"type": "subtitle", "time": 19425.51, "timestamp": "05:23:45", "text": "あなたは上の階で待っています。"}, {"type": "subtitle", "time": 19428.23, "timestamp": "05:23:48", "text": "うん。わかった。私を待っててください。私を待っててください。"}, {"type": "subtitle", "time": 19431.75, "timestamp": "05:23:51", "text": "滞在する。滞在する。そこにいてください。そこにいてください。"}, {"type": "subtitle", "time": 19434.23, "timestamp": "05:23:54", "text": "ビープ音が鳴っています。ビープ音が鳴っています。"}, {"type": "subtitle", "time": 19438.788, "timestamp": "05:23:58", "text": "何のビープ音？ ３つ、４つ、５つですか？"}]
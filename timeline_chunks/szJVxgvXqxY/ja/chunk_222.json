[{"type": "subtitle", "time": 13320.39, "timestamp": "03:42:00", "text": "わかった。どうしたの？はい、どうぞ。"}, {"type": "subtitle", "time": 13323.35, "timestamp": "03:42:03", "text": "こんにちは。ゲームを開始します。待って。特徴"}, {"type": "subtitle", "time": 13326.15, "timestamp": "03:42:06", "text": "能力。ええと、誰に対しても宣戦布告する可能性がある"}, {"type": "subtitle", "time": 13329.43, "timestamp": "03:42:09", "text": "誰に対しても。待って。戦争中の人"}, {"type": "subtitle", "time": 13333.07, "timestamp": "03:42:13", "text": "戦争なしの同盟国モーガン"}, {"type": "subtitle", "time": 13337.07, "timestamp": "03:42:17", "text": "同盟国によくある罰則？"}, {"type": "subtitle", "time": 13340.628, "timestamp": "03:42:20", "text": "はぁ？壮大な冒険。バーバーを捕獲したとき"}, {"type": "subtitle", "time": 13343.43, "timestamp": "03:42:23", "text": "野蛮人の前哨基地、部族の"}, {"type": "subtitle", "time": 13346.55, "timestamp": "03:42:26", "text": "通常の村の報酬に加えて"}, {"type": "subtitle", "time": 13348.27, "timestamp": "03:42:28", "text": "金。遊ぶ"}, {"type": "subtitle", "time": 13351.11, "timestamp": "03:42:31", "text": "半数が通常の費用の半額を支払う"}, {"type": "subtitle", "time": 13353.19, "timestamp": "03:42:33", "text": "給与労働。はい、私は"}, {"type": "subtitle", "time": 13355.35, "timestamp": "03:42:35", "text": "これを理解したら、さあ行こう。"}, {"type": "subtitle", "time": 13358.23, "timestamp": "03:42:38", "text": "こんにちは、リードアドバイザーさん。個人的"}, {"type": "subtitle", "time": 13360.948, "timestamp": "03:42:40", "text": "アドバイザー私は、"}, {"type": "subtitle", "time": 13362.628, "timestamp": "03:42:42", "text": "我々の統治に関連する事柄"}, {"type": "subtitle", "time": 13365.91, "timestamp": "03:42:45", "text": "文明。何かご用がありましたら、お気軽にお申し付けください。私は"}, {"type": "subtitle", "time": 13370.23, "timestamp": "03:42:50", "text": "文明社会に不慣れな。はい。"}, {"type": "subtitle", "time": 13379.11, "timestamp": "03:42:59", "text": "これ？ああ、できますよ。わあ、すごい。その その"}]
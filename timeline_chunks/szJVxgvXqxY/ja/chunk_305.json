[{"type": "subtitle", "time": 18301.91, "timestamp": "05:05:01", "text": "ハァ。氷点下にはならないだろうね。"}, {"type": "subtitle", "time": 18304.07, "timestamp": "05:05:04", "text": "少し待ってもらえませんか？私たちは"}, {"type": "subtitle", "time": 18327.91, "timestamp": "05:05:27", "text": "何もなかった。"}, {"type": "subtitle", "time": 18329.83, "timestamp": "05:05:29", "text": "何もない。"}, {"type": "subtitle", "time": 18334.51, "timestamp": "05:05:34", "text": "つまり、高温のことですよね？"}, {"type": "subtitle", "time": 18338.91, "timestamp": "05:05:38", "text": "高温。気温が高い。"}, {"type": "subtitle", "time": 18341.75, "timestamp": "05:05:41", "text": "だから、凍えるほど寒くはないんです。凍りつく。うん。"}, {"type": "subtitle", "time": 18354.548, "timestamp": "05:05:54", "text": "肉を切る。"}]
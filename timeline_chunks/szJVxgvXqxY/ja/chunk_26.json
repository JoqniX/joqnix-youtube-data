[{"type": "subtitle", "time": 1562.47, "timestamp": "00:26:02", "text": "もの。なんてこった。おお。なんてこった。わかった。私は"}, {"type": "subtitle", "time": 1563.669, "timestamp": "00:26:03", "text": "来るよ。今行ってる。今行ってる。私は"}, {"type": "subtitle", "time": 1568.75, "timestamp": "00:26:08", "text": "捕まえたぞ。捕まえたぞ。私は行きます"}, {"type": "subtitle", "time": 1570.35, "timestamp": "00:26:10", "text": "に"}, {"type": "subtitle", "time": 1573.91, "timestamp": "00:26:13", "text": "えっと、ここであなたを応援しています。"}, {"type": "subtitle", "time": 1575.39, "timestamp": "00:26:15", "text": "私は"}, {"type": "subtitle", "time": 1586.55, "timestamp": "00:26:26", "text": "いいえ。私は銃をもらっていません。"}, {"type": "subtitle", "time": 1589.31, "timestamp": "00:26:29", "text": "いいえ。こんにちは。始めましょう"}, {"type": "subtitle", "time": 1592.55, "timestamp": "00:26:32", "text": "さらに。おお。では、どのように略奪するのですか"}, {"type": "subtitle", "time": 1596.87, "timestamp": "00:26:36", "text": "また？えっと、アイテムを拾うにはEキーを押します。おお、"}, {"type": "subtitle", "time": 1599.83, "timestamp": "00:26:39", "text": "わかった。"}, {"type": "subtitle", "time": 1601.149, "timestamp": "00:26:41", "text": "E を押して"}, {"type": "subtitle", "time": 1603.669, "timestamp": "00:26:43", "text": "略奪。そして"}, {"type": "subtitle", "time": 1606.229, "timestamp": "00:26:46", "text": "そこにこの車がある。"}, {"type": "subtitle", "time": 1610.55, "timestamp": "00:26:50", "text": "うんうん。彼は乗り越えられる。うん。 Eジャンプは"}, {"type": "subtitle", "time": 1613.189, "timestamp": "00:26:53", "text": "空間。"}]
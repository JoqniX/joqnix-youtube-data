[{"type": "subtitle", "time": 18843.11, "timestamp": "05:14:03", "text": "はい、紫外線冷凍です。アルとゴースト"}, {"type": "subtitle", "time": 18845.75, "timestamp": "05:14:05", "text": "一番上ですよね？三つ。うん。そして上昇する。"}, {"type": "subtitle", "time": 18849.56, "timestamp": "05:14:09", "text": "はい。行くべきかな？"}, {"type": "subtitle", "time": 18852.35, "timestamp": "05:14:12", "text": "[音楽]"}, {"type": "subtitle", "time": 18858.39, "timestamp": "05:14:18", "text": "いえ、違います。"}, {"type": "subtitle", "time": 18862.51, "timestamp": "05:14:22", "text": "なんてこった。わかった。いいえ。それだけの価値はありません。ない"}, {"type": "subtitle", "time": 18867.67, "timestamp": "05:14:27", "text": "価値。彼はまた部屋を変えたと思う。"}, {"type": "subtitle", "time": 18870.548, "timestamp": "05:14:30", "text": "なんてこった。どうでも。彼はまだここにいる。おお、"}, {"type": "subtitle", "time": 18872.548, "timestamp": "05:14:32", "text": "あなたは彼を見た。"}, {"type": "subtitle", "time": 18885.75, "timestamp": "05:14:45", "text": "移動する。さあ行こう。丸。うん。うん。私"}, {"type": "subtitle", "time": 18892.708, "timestamp": "05:14:52", "text": "模倣犯でないことを願います。それが"}, {"type": "subtitle", "time": 18895.27, "timestamp": "05:14:55", "text": "模倣者ではない。やめてください、"}, {"type": "subtitle", "time": 18897.11, "timestamp": "05:14:57", "text": "模倣する。"}]
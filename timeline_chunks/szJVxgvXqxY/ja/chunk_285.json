[{"type": "subtitle", "time": 17138.23, "timestamp": "04:45:38", "text": "あぁ、ゲームを持っていたことに今気づいた"}, {"type": "subtitle", "time": 17139.788, "timestamp": "04:45:39", "text": "ボリューム"}, {"type": "subtitle", "time": 17148.548, "timestamp": "04:45:48", "text": "神。わかった。ゲーム内で話しているのですか、それとも"}, {"type": "subtitle", "time": 17150.59, "timestamp": "04:45:50", "text": "待って、今の聞こえた？誰かが"}, {"type": "subtitle", "time": 17153.59, "timestamp": "04:45:53", "text": "叫び声。いいえ。"}, {"type": "subtitle", "time": 17154.75, "timestamp": "04:45:54", "text": "おお、"}, {"type": "subtitle", "time": 17158.788, "timestamp": "04:45:58", "text": "ごめん。五。私は聞こうとしています"}]
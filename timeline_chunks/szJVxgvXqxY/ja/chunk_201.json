[{"type": "subtitle", "time": 12060.11, "timestamp": "03:21:00", "text": "忘れたような"}, {"type": "subtitle", "time": 12063.389, "timestamp": "03:21:03", "text": "いくつか忘れ物があった。それで"}, {"type": "subtitle", "time": 12067.91, "timestamp": "03:21:07", "text": "うん。えっと、こんにちは。次のゲストはジョブスターです"}, {"type": "subtitle", "time": 12070.469, "timestamp": "03:21:10", "text": "側。それは午後6時になります。 IST。それで"}, {"type": "subtitle", "time": 12073.67, "timestamp": "03:21:13", "text": "1時間で自分をリセットして"}, {"type": "subtitle", "time": 12076.71, "timestamp": "03:21:16", "text": "えっと、リラックスとかそういう感じ。じゃあ、私は行くよ"}, {"type": "subtitle", "time": 12079.75, "timestamp": "03:21:19", "text": "休憩を取って、"}, {"type": "subtitle", "time": 12081.429, "timestamp": "03:21:21", "text": "壊して、食べ物を食べて、"}, {"type": "subtitle", "time": 12084.389, "timestamp": "03:21:24", "text": "すべて。それに、何人かに電話する必要がある"}, {"type": "subtitle", "time": 12086.469, "timestamp": "03:21:26", "text": "人々と「どうしたの？」と尋ねる"}, {"type": "subtitle", "time": 12088.99, "timestamp": "03:21:28", "text": "明日のことは"}, {"type": "subtitle", "time": 12092.95, "timestamp": "03:21:32", "text": "心配した。私は幸せです、例えば"}, {"type": "subtitle", "time": 12096.03, "timestamp": "03:21:36", "text": "これは、このように見てください"}, {"type": "subtitle", "time": 12102.75, "timestamp": "03:21:42", "text": "もし私が6月に行けないなら"}, {"type": "subtitle", "time": 12105.83, "timestamp": "03:21:45", "text": "7月にはジョッカソンの続きが行われます"}, {"type": "subtitle", "time": 12107.99, "timestamp": "03:21:47", "text": "一年中。心配しないで、私がやります"}, {"type": "subtitle", "time": 12111.11, "timestamp": "03:21:51", "text": "それ。ジョッカソンに参加しても構わない"}, {"type": "subtitle", "time": 12113.389, "timestamp": "03:21:53", "text": "一年を通して。"}, {"type": "subtitle", "time": 12118.87, "timestamp": "03:21:58", "text": "えっと、そうでない場合は、そうします。そうでない場合は、"}]
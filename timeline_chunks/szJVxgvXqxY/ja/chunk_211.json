[{"type": "subtitle", "time": 12660.229, "timestamp": "03:31:00", "text": "ええ、そうですね、それは関連しています"}, {"type": "subtitle", "time": 12664.229, "timestamp": "03:31:04", "text": "私の現実世界のもの、現実世界の私とジョーの両方"}, {"type": "subtitle", "time": 12665.67, "timestamp": "03:31:05", "text": "次の誕生日が同じなので"}, {"type": "subtitle", "time": 12667.87, "timestamp": "03:31:07", "text": "誤って開始"}, {"type": "subtitle", "time": 12671.59, "timestamp": "03:31:11", "text": "20だけど、うん、実際には私は"}, {"type": "subtitle", "time": 12674.59, "timestamp": "03:31:14", "text": "それ以来、私は21歳になりました。"}, {"type": "subtitle", "time": 12679.59, "timestamp": "03:31:19", "text": "うん。それで、えっと、でも私はジョーを残しておきたかったんです"}, {"type": "subtitle", "time": 12683.429, "timestamp": "03:31:23", "text": "まるで永遠の18歳みたい。えっと、私は自分が"}, {"type": "subtitle", "time": 12686.87, "timestamp": "03:31:26", "text": "前回はすっかり忘れていた。あなた"}, {"type": "subtitle", "time": 12688.51, "timestamp": "03:31:28", "text": "こう言えるだろう、"}, {"type": "subtitle", "time": 12694.229, "timestamp": "03:31:34", "text": "えっと、それで私は、痛みの袋、忘れてるよ"}, {"type": "subtitle", "time": 12697.95, "timestamp": "03:31:37", "text": "ジョーク18を作る必要がある、"}, {"type": "subtitle", "time": 12702.229, "timestamp": "03:31:42", "text": "私じゃないよ。ああ、去年のことをすっかり忘れてたよ"}, {"type": "subtitle", "time": 12704.229, "timestamp": "03:31:44", "text": "そして今年は実際にそれを成し遂げました"}, {"type": "subtitle", "time": 12719.309, "timestamp": "03:31:59", "text": "おい。わかった。だから、私は"}]
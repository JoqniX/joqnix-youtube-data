[{"type": "subtitle", "time": 10022.55, "timestamp": "02:47:02", "text": "チーム。えっと、何？"}, {"type": "subtitle", "time": 10024.95, "timestamp": "02:47:04", "text": "ええ、私たちはトーナメントに出場するためにそこへ行ったんです。"}, {"type": "subtitle", "time": 10027.269, "timestamp": "02:47:07", "text": "他の大学が主催する場合、"}, {"type": "subtitle", "time": 10029.309, "timestamp": "02:47:09", "text": "イベント。私たちは"}, {"type": "subtitle", "time": 10032.469, "timestamp": "02:47:12", "text": "私たちは試合を見に行き、それから私は"}, {"type": "subtitle", "time": 10034.87, "timestamp": "02:47:14", "text": "つまり、大きな試合には勝てなかったということだ。"}, {"type": "subtitle", "time": 10038.07, "timestamp": "02:47:18", "text": "しかし、私たちはいくつか勝ちましたが、"}, {"type": "subtitle", "time": 10040.29, "timestamp": "02:47:20", "text": "私たちはそれほど優秀ではなかった。"}, {"type": "subtitle", "time": 10048.87, "timestamp": "02:47:28", "text": "はい、ここにいます。あなたに私の"}, {"type": "subtitle", "time": 10050.87, "timestamp": "02:47:30", "text": "IDのことだよ。"}, {"type": "subtitle", "time": 10052.87, "timestamp": "02:47:32", "text": "ええ、実際、追加した方がいいと思います"}, {"type": "subtitle", "time": 10055.67, "timestamp": "02:47:35", "text": "私の場合は、もう1つ"}, {"type": "subtitle", "time": 10062.15, "timestamp": "02:47:42", "text": "うん。こんにちは、トム。そうそう。教えてください"}, {"type": "subtitle", "time": 10065.03, "timestamp": "02:47:45", "text": "あなたの名前。どうやって見つけたの？"}, {"type": "subtitle", "time": 10067.99, "timestamp": "02:47:47", "text": "名前？トムという名前はどのようにして付けられたのですか？"}, {"type": "subtitle", "time": 10071.189, "timestamp": "02:47:51", "text": "うん。トムを制作するきっかけは何でしたか？"}, {"type": "subtitle", "time": 10075.11, "timestamp": "02:47:55", "text": "そしてあなたの人格とか、その他すべては？"}, {"type": "subtitle", "time": 10077.349, "timestamp": "02:47:57", "text": "つまり、あなたはあのユーチューバーを知っていますか？"}, {"type": "subtitle", "time": 10079.51, "timestamp": "02:47:59", "text": "ダンTDM？"}]
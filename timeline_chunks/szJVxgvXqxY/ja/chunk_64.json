[{"type": "subtitle", "time": 3850.229, "timestamp": "01:04:10", "text": "右。何てことだ。最善を尽くしましょう"}, {"type": "subtitle", "time": 3860.189, "timestamp": "01:04:20", "text": "1つ。どこに"}, {"type": "subtitle", "time": 3876.83, "timestamp": "01:04:36", "text": "ダメージ？降りる必要があると思う。"}, {"type": "subtitle", "time": 3879.149, "timestamp": "01:04:39", "text": "[音楽]"}, {"type": "subtitle", "time": 3881.99, "timestamp": "01:04:41", "text": "ああ、どこかで喧嘩が起きてるよ。とても"}, {"type": "subtitle", "time": 3897.55, "timestamp": "01:04:57", "text": "残り。もう一つ青い鎧がある"}]
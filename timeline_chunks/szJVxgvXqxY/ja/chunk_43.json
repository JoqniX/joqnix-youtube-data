[{"type": "subtitle", "time": 2583.669, "timestamp": "00:43:03", "text": "いいえ。銃は発砲していなかった。何てことだ。"}, {"type": "subtitle", "time": 2589.51, "timestamp": "00:43:09", "text": "いいえ。"}, {"type": "subtitle", "time": 2592.39, "timestamp": "00:43:12", "text": "いやあ、よかった。"}, {"type": "subtitle", "time": 2595.35, "timestamp": "00:43:15", "text": "トップ3。それは良かった。私たちは"}, {"type": "subtitle", "time": 2611.39, "timestamp": "00:43:31", "text": "略奪。誰も窒息しない"}, {"type": "subtitle", "time": 2614.149, "timestamp": "00:43:34", "text": "上。私は発砲したい"}, {"type": "subtitle", "time": 2617.189, "timestamp": "00:43:37", "text": "範囲。どこ？配線範囲はどこですか？"}, {"type": "subtitle", "time": 2623.95, "timestamp": "00:43:43", "text": "範囲はどこかを超える可能性がある"}, {"type": "subtitle", "time": 2625.709, "timestamp": "00:43:45", "text": "[音楽]"}, {"type": "subtitle", "time": 2627.229, "timestamp": "00:43:47", "text": "ここ。"}, {"type": "subtitle", "time": 2630.16, "timestamp": "00:43:50", "text": "えっと、"}]
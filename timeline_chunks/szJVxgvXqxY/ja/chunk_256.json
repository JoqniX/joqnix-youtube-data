[{"type": "subtitle", "time": 15370.55, "timestamp": "04:16:10", "text": "えっと、どうすれば"}, {"type": "subtitle", "time": 15373.31, "timestamp": "04:16:13", "text": "[音楽]"}, {"type": "subtitle", "time": 15382.07, "timestamp": "04:16:22", "text": "単位。あなたの土地ユニットは入ることができません"}, {"type": "subtitle", "time": 15383.948, "timestamp": "04:16:23", "text": "あらゆる水路。しかし、あなたのローンチ"}, {"type": "subtitle", "time": 15388.59, "timestamp": "04:16:28", "text": "最初に失敗すると次に"}, {"type": "subtitle", "time": 15392.23, "timestamp": "04:16:32", "text": "土地。移動アクションに移る"}, {"type": "subtitle", "time": 15398.31, "timestamp": "04:16:38", "text": "何が必要だというのか？いいえ、私は知りたいし学びたいのです"}, {"type": "subtitle", "time": 15400.51, "timestamp": "04:16:40", "text": "方法"}, {"type": "subtitle", "time": 15410.31, "timestamp": "04:16:50", "text": "部隊のリーダーが部隊を編成する。わかった。"}, {"type": "subtitle", "time": 15412.99, "timestamp": "04:16:52", "text": "民間人地上戦闘"}, {"type": "subtitle", "time": 15415.83, "timestamp": "04:16:55", "text": "射手。これらの人物はどうやって作ればいいですか？"}, {"type": "subtitle", "time": 15418.708, "timestamp": "04:16:58", "text": "八。"}]
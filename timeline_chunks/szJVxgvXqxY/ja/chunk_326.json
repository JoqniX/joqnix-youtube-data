[{"type": "subtitle", "time": 19562.708, "timestamp": "05:26:02", "text": "怖い。ええ、とても怖いですね。しかし非常に"}, {"type": "subtitle", "time": 19567.19, "timestamp": "05:26:07", "text": "人が多ければ多いほど楽しいから、楽しいんだよ。うん、"}, {"type": "subtitle", "time": 19569.43, "timestamp": "05:26:09", "text": "人数が多い場合は、彼らに運ばせます"}, {"type": "subtitle", "time": 19571.43, "timestamp": "05:26:11", "text": "自分。私は「うん、私は座るよ」って感じ"}, {"type": "subtitle", "time": 19573.99, "timestamp": "05:26:13", "text": "隅っこでくつろぐのが好き。君たちは"}, {"type": "subtitle", "time": 19577.03, "timestamp": "05:26:17", "text": "あなたの持ち物、仕事関係の物。"}, {"type": "subtitle", "time": 19579.19, "timestamp": "05:26:19", "text": "とても怖い。何てことだ。そして幸運なことに"}, {"type": "subtitle", "time": 19581.83, "timestamp": "05:26:21", "text": "アマチュア。アマチュアは5分間の準備時間を得た"}, {"type": "subtitle", "time": 19586.47, "timestamp": "05:26:26", "text": "時間。ああ。えっと、もしそれがもっと高いレベルだったら、"}, {"type": "subtitle", "time": 19590.15, "timestamp": "05:26:30", "text": "それはほんの少しだけ"}, {"type": "subtitle", "time": 19592.868, "timestamp": "05:26:32", "text": "セットアップ時間ですよね？うん。たった2分"}, {"type": "subtitle", "time": 19595.83, "timestamp": "05:26:35", "text": "0分でなければ、"}, {"type": "subtitle", "time": 19598.39, "timestamp": "05:26:38", "text": "すぐに狩りをして、それからまっすぐ"}, {"type": "subtitle", "time": 19604.23, "timestamp": "05:26:44", "text": "死んでしまう。何てことだ。あなたは亡くなる。"}, {"type": "subtitle", "time": 19606.39, "timestamp": "05:26:46", "text": "なんてこった。"}, {"type": "subtitle", "time": 19608.788, "timestamp": "05:26:48", "text": "とても怖い。でも、とても楽しかったよ。感謝"}, {"type": "subtitle", "time": 19611.27, "timestamp": "05:26:51", "text": "招待してくれてありがとう。うん。うん。うん。"}, {"type": "subtitle", "time": 19613.75, "timestamp": "05:26:53", "text": "本日はありがとうございました。とても楽しかったです。"}, {"type": "subtitle", "time": 19617.59, "timestamp": "05:26:57", "text": "自分のことは自分で管理してください。うん。あなた、私"}]
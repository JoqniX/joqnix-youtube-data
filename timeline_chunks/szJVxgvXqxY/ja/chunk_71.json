[{"type": "subtitle", "time": 4264.87, "timestamp": "01:11:04", "text": "治癒しない。"}, {"type": "subtitle", "time": 4274.31, "timestamp": "01:11:14", "text": "ジュースありますか？えーと、すごく低いけど、"}, {"type": "subtitle", "time": 4281.229, "timestamp": "01:11:21", "text": "ジュースを差し上げましょうか？あ、待って。の"}, {"type": "subtitle", "time": 4284.39, "timestamp": "01:11:24", "text": "焚き火は私たちを癒してくれる。"}, {"type": "subtitle", "time": 4286.629, "timestamp": "01:11:26", "text": "ああ、人がいる。ここには人がいる。"}, {"type": "subtitle", "time": 4289.91, "timestamp": "01:11:29", "text": "ああ、しまった。"}, {"type": "subtitle", "time": 4292.51, "timestamp": "01:11:32", "text": "たくさんの人がいる"}, {"type": "subtitle", "time": 4308.149, "timestamp": "01:11:48", "text": "私の上の誰か。今行ってる。私は死んだ。"}, {"type": "subtitle", "time": 4318.95, "timestamp": "01:11:58", "text": "ニース。彼は何をしているのですか？"}]
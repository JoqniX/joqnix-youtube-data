[{"type": "subtitle", "time": 17884.15, "timestamp": "04:58:04", "text": "離れて。行きたくない。もうない。"}, {"type": "subtitle", "time": 17886.788, "timestamp": "04:58:06", "text": "うん。もうない。終わり。わかった。そこで私たちは"}, {"type": "subtitle", "time": 17889.91, "timestamp": "04:58:09", "text": "行く。別の。"}, {"type": "subtitle", "time": 17894.23, "timestamp": "04:58:14", "text": "やったぞ！さあ、行こう。"}, {"type": "subtitle", "time": 17897.67, "timestamp": "04:58:17", "text": "どうして双子だと分かったの？えっと、それで"}, {"type": "subtitle", "time": 17900.23, "timestamp": "04:58:20", "text": "作戦はありません。幽霊はいない"}, {"type": "subtitle", "time": 17902.948, "timestamp": "04:58:22", "text": "書き込み。凍えるほど寒かった。"}, {"type": "subtitle", "time": 17906.628, "timestamp": "04:58:26", "text": "それから、EMF5。"}, {"type": "subtitle", "time": 17909.83, "timestamp": "04:58:29", "text": "それから、スイッチが入ったんだけど、"}, {"type": "subtitle", "time": 17912.07, "timestamp": "04:58:32", "text": "指紋は残っていなかった。だからいいえ"}, {"type": "subtitle", "time": 17913.59, "timestamp": "04:58:33", "text": "指紋。"}, {"type": "subtitle", "time": 17916.868, "timestamp": "04:58:36", "text": "ああ。そして、あなたはまさにその時見たのです"}, {"type": "subtitle", "time": 17918.708, "timestamp": "04:58:38", "text": "えーと、ゲーム開始時はこんな感じ"}, {"type": "subtitle", "time": 17922.11, "timestamp": "04:58:42", "text": "超アクティブ"}, {"type": "subtitle", "time": 17925.43, "timestamp": "04:58:45", "text": "えっと、また行った時は、"}, {"type": "subtitle", "time": 17930.07, "timestamp": "04:58:50", "text": "静かな。うん。うん。つまり、2つの異なる"}]
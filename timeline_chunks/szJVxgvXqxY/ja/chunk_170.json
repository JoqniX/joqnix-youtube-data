[{"type": "subtitle", "time": 10217.189, "timestamp": "02:50:17", "text": "だからここは私のシャラ（ヨガ教室）なんです。"}, {"type": "subtitle", "time": 10221.99, "timestamp": "02:50:21", "text": "あれはシーラだと思う。まるでミームみたいだ。"}, {"type": "subtitle", "time": 10226.389, "timestamp": "02:50:26", "text": "ミームがありますね。ああ、私のシーラ。誰も"}, {"type": "subtitle", "time": 10228.71, "timestamp": "02:50:28", "text": "知ってるでしょ、私はちょっとやりすぎだと思う"}, {"type": "subtitle", "time": 10230.469, "timestamp": "02:50:30", "text": "慢性的にオンライン状態。私はすべての"}, {"type": "subtitle", "time": 10237.67, "timestamp": "02:50:37", "text": "何てことだ。なぜこんなに時間がかかるのか"}, {"type": "subtitle", "time": 10252.87, "timestamp": "02:50:52", "text": "開ける。私たちのDMを晒すのはやめてください。あなたは何を"}, {"type": "subtitle", "time": 10255.349, "timestamp": "02:50:55", "text": "平均？"}]
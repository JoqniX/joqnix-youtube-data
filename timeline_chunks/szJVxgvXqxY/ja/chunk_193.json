[{"type": "subtitle", "time": 11580.159, "timestamp": "03:13:00", "text": "敵はあと一体残っている。求人に応募する。えっと 仕事に応募したり、その他諸々。"}, {"type": "subtitle", "time": 11588.229, "timestamp": "03:13:08", "text": "ああ、もうここを出ます。"}, {"type": "subtitle", "time": 11590.309, "timestamp": "03:13:10", "text": "それはワクワクしますね。もう1か月"}, {"type": "subtitle", "time": 11594.71, "timestamp": "03:13:14", "text": "ジョアソン、兄弟。ああ、ジャカドは"}, {"type": "subtitle", "time": 11601.59, "timestamp": "03:13:21", "text": "それは「見た？」です。"}, {"type": "subtitle", "time": 11604.149, "timestamp": "03:13:24", "text": "何てことだ。あなたは生きている。"}, {"type": "subtitle", "time": 11606.87, "timestamp": "03:13:26", "text": "あれはすごいことだった。"}, {"type": "subtitle", "time": 11611.149, "timestamp": "03:13:31", "text": "どうしたの？彼は木が倒れた"}, {"type": "subtitle", "time": 11613.91, "timestamp": "03:13:33", "text": "オフ。彼はただ見ながら飛び降りた"}, {"type": "subtitle", "time": 11616.149, "timestamp": "03:13:36", "text": "横向きに。彼はオーラファームをしようとしていた。"}, {"type": "subtitle", "time": 11619.11, "timestamp": "03:13:39", "text": "しかし彼はただ"}, {"type": "subtitle", "time": 11621.11, "timestamp": "03:13:41", "text": "ありがとう。彼は、彼がそれをしているように"}, {"type": "subtitle", "time": 11625.269, "timestamp": "03:13:45", "text": "ジェット機だったが、そのまま倒れてしまった。"}, {"type": "subtitle", "time": 11627.83, "timestamp": "03:13:47", "text": "何てことだ。"}, {"type": "subtitle", "time": 11630.229, "timestamp": "03:13:50", "text": "正直、どうやってやってるのか分からないよ、兄弟。"}, {"type": "subtitle", "time": 11632.07, "timestamp": "03:13:52", "text": "こんなことのために配信することなんて絶対にできない"}, {"type": "subtitle", "time": 11634.55, "timestamp": "03:13:54", "text": "長さ。"}, {"type": "subtitle", "time": 11637.67, "timestamp": "03:13:57", "text": "もしそれが次のものなら構わない"}]
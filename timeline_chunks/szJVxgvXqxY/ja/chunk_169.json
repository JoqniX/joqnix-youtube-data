[{"type": "subtitle", "time": 10146.15, "timestamp": "02:49:06", "text": "[音楽]"}, {"type": "subtitle", "time": 10148.79, "timestamp": "02:49:08", "text": "うん、君が参加する時は教えてね"}, {"type": "subtitle", "time": 10155.51, "timestamp": "02:49:15", "text": "完了しました。はい、少々お待ちください。なぜ私は"}, {"type": "subtitle", "time": 10157.229, "timestamp": "02:49:17", "text": "あなたから聞こえない"}, {"type": "subtitle", "time": 10160.309, "timestamp": "02:49:20", "text": "ヘッドホン？わかった。もう一度お話いただけますか？"}, {"type": "subtitle", "time": 10165.389, "timestamp": "02:49:25", "text": "こんにちは。うん。ええ、話し続けてください。"}, {"type": "subtitle", "time": 10168.07, "timestamp": "02:49:28", "text": "えっと、こんにちは。元気かい？何てことだ。おお"}, {"type": "subtitle", "time": 10191.59, "timestamp": "02:49:51", "text": "ああ、ナットが私を呼んでいるのは"}, {"type": "subtitle", "time": 10193.189, "timestamp": "02:49:53", "text": "私は彼に、絶対にプレーしないと伝えた。"}, {"type": "subtitle", "time": 10195.429, "timestamp": "02:49:55", "text": "再びヴァレラントをプレイしています。"}]
[{"type": "subtitle", "time": 6481.75, "timestamp": "01:48:01", "text": "ロック。ああ、半分も壊せない"}, {"type": "subtitle", "time": 6489.83, "timestamp": "01:48:09", "text": "耐久性がないのは良いことです"}, {"type": "subtitle", "time": 6492.95, "timestamp": "01:48:12", "text": "兵器。うん。"}, {"type": "subtitle", "time": 6499.99, "timestamp": "01:48:19", "text": "ちなみに、もうすぐ夜になりますよ。"}, {"type": "subtitle", "time": 6501.91, "timestamp": "01:48:21", "text": "そうそう。うん。私たちは、"}, {"type": "subtitle", "time": 6504.63, "timestamp": "01:48:24", "text": "木造の家？ええ、そう思います。"}, {"type": "subtitle", "time": 6506.55, "timestamp": "01:48:26", "text": "でも、木材があまりないんです。私はちょっと"}, {"type": "subtitle", "time": 6509.349, "timestamp": "01:48:29", "text": "斧を作るのに全部使うように"}, {"type": "subtitle", "time": 6511.51, "timestamp": "01:48:31", "text": "作業台。"}, {"type": "subtitle", "time": 6513.15, "timestamp": "01:48:33", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 6516.55, "timestamp": "01:48:36", "text": "見る。だから木材が必要なんだ。えっと、31個あります。"}, {"type": "subtitle", "time": 6518.91, "timestamp": "01:48:38", "text": "私たちは作ることができます"}, {"type": "subtitle", "time": 6527.63, "timestamp": "01:48:47", "text": "壁。えっと、どこに置きたいですか？"}, {"type": "subtitle", "time": 6531.95, "timestamp": "01:48:51", "text": "それ？ああ、もう何かが出現している。"}, {"type": "subtitle", "time": 6535.429, "timestamp": "01:48:55", "text": "えっと、私たちの周りに置いてください"}]
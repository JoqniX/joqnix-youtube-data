[{"type": "subtitle", "time": 15120.19, "timestamp": "04:12:00", "text": "去って行った。わかった、絶対にない"}, {"type": "subtitle", "time": 15128.67, "timestamp": "04:12:08", "text": "私はただ"}, {"type": "subtitle", "time": 15131.83, "timestamp": "04:12:11", "text": "停止。神よ、あなたも"}, {"type": "subtitle", "time": 15134.55, "timestamp": "04:12:14", "text": "問題。 XD、それは旅の一部です。"}, {"type": "subtitle", "time": 15137.03, "timestamp": "04:12:17", "text": "それはゲームの一部だ。試すとき"}, {"type": "subtitle", "time": 15140.67, "timestamp": "04:12:20", "text": "新しいゲームでは、問題が発生するでしょう。"}, {"type": "subtitle", "time": 15142.788, "timestamp": "04:12:22", "text": "はい。もしあなたがまだ見たことがないなら"}, {"type": "subtitle", "time": 15144.39, "timestamp": "04:12:24", "text": "チュートリアルとかそういうのは"}, {"type": "subtitle", "time": 15146.628, "timestamp": "04:12:26", "text": "起こる。でも、私は自分自身が"}, {"type": "subtitle", "time": 15148.75, "timestamp": "04:12:28", "text": "甘やかされる。だから、"}, {"type": "subtitle", "time": 15150.91, "timestamp": "04:12:30", "text": "大丈夫。宣言する"}, {"type": "subtitle", "time": 15152.948, "timestamp": "04:12:32", "text": "友情。私はあなたの"}, {"type": "subtitle", "time": 15156.708, "timestamp": "04:12:36", "text": "友情。しかし、私の信頼を裏切ることはなかった。"}, {"type": "subtitle", "time": 15159.07, "timestamp": "04:12:39", "text": "こんにちは、"}, {"type": "subtitle", "time": 15162.43, "timestamp": "04:12:42", "text": "さようなら。えっと、送る"}, {"type": "subtitle", "time": 15165.19, "timestamp": "04:12:45", "text": "宣言。あなたの申告書が届きました。"}, {"type": "subtitle", "time": 15167.43, "timestamp": "04:12:47", "text": "皇后陛下への貢ぎ物を携えて。それは"}, {"type": "subtitle", "time": 15171.19, "timestamp": "04:12:51", "text": "大変感謝いたします。よし、では"}, {"type": "subtitle", "time": 15177.51, "timestamp": "04:12:57", "text": "取引。私の提案、彼らの提案。ああ、私は"}]
[{"type": "subtitle", "time": 8582.95, "timestamp": "02:23:02", "text": "これ。楽しいゲームだけど、難しく感じる。"}, {"type": "subtitle", "time": 8589.51, "timestamp": "02:23:09", "text": "あ、待って。石器は存在しない。"}, {"type": "subtitle", "time": 8591.11, "timestamp": "02:23:11", "text": "木の斧があって、それから"}, {"type": "subtitle", "time": 8592.95, "timestamp": "02:23:12", "text": "金の斧。"}, {"type": "subtitle", "time": 8600.15, "timestamp": "02:23:20", "text": "金もあるし、鉄もあるし"}, {"type": "subtitle", "time": 8603.389, "timestamp": "02:23:23", "text": "それから金属があって、それから"}, {"type": "subtitle", "time": 8606.309, "timestamp": "02:23:26", "text": "アダム派。どう綴ればいいのか分かりません。"}, {"type": "subtitle", "time": 8609.229, "timestamp": "02:23:29", "text": "ああ、アダム派よ。ああ、神様。"}, {"type": "chat", "time": 8611.753, "timestamp": "02:23:31", "author": "@ValikValik-b2u", "avatar": "https://yt4.ggpht.com/C1JlkVEJDh0gzPP-LdyE6_0Cuq4eR-MdZKt5LYRqiusVebnNifrMX_s9qVS2ETVv0k1Wm_QHKg=s64-c-k-c0x00ffffff-no-rj", "message": "ку чтоооооооооооо"}, {"type": "subtitle", "time": 8613.67, "timestamp": "02:23:33", "text": "うん。ねえ、それ必要だと思うよ。ああ、"}, {"type": "chat", "time": 8615.386, "timestamp": "02:23:35", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Valik_EPlSOD21~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 8616.229, "timestamp": "02:23:36", "text": "神。これは一体何だ？それは新しい"}, {"type": "subtitle", "time": 8631.19, "timestamp": "02:23:51", "text": "彼らはまるで私たちの持ち物を破壊しているかのようだ。"}]
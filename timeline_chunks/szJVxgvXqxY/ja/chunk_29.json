[{"type": "subtitle", "time": 1771.43, "timestamp": "00:29:31", "text": "クエスト。それは何ですか？私の猫はラッキーキャットです。おお、"}, {"type": "subtitle", "time": 1774.55, "timestamp": "00:29:34", "text": "それは近接信管地雷のようなものだ。うん。"}, {"type": "subtitle", "time": 1786.91, "timestamp": "00:29:46", "text": "私はその車両を見つけました。"}, {"type": "subtitle", "time": 1797.03, "timestamp": "00:29:57", "text": "もう鎧は手に入れたの？私は鎧を持っています。"}]
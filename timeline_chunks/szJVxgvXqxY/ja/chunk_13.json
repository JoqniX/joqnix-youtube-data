[{"type": "subtitle", "time": 814.95, "timestamp": "00:13:34", "text": "わかった。こんにちは、みんな。ようこそ"}, {"type": "subtitle", "time": 819.27, "timestamp": "00:13:39", "text": "ジョアトン90日目。では、まずは"}, {"type": "subtitle", "time": 823.55, "timestamp": "00:13:43", "text": "最初のゲストをお迎えしました。アズランがいます。"}, {"type": "subtitle", "time": 826.189, "timestamp": "00:13:46", "text": "アズラ。"}, {"type": "subtitle", "time": 830.03, "timestamp": "00:13:50", "text": "こんにちは。こんにちは、クラ。"}, {"type": "subtitle", "time": 833.91, "timestamp": "00:13:53", "text": "カズル。こんにちは。こんにちは。私の名前はアズールです。"}, {"type": "subtitle", "time": 836.79, "timestamp": "00:13:56", "text": "最後にログインしてからずいぶん経ちました"}]
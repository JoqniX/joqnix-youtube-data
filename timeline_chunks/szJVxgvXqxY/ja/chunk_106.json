[{"type": "subtitle", "time": 6363.349, "timestamp": "01:46:03", "text": "この木は作らない方がいいですか？おお、"}, {"type": "subtitle", "time": 6364.83, "timestamp": "01:46:04", "text": "いらっしゃいませ"}, {"type": "subtitle", "time": 6401.429, "timestamp": "01:46:41", "text": "あぁ、今ファックスを送らなきゃ。ああ、私たちは"}, {"type": "subtitle", "time": 6404.71, "timestamp": "01:46:44", "text": "今は色々なことがある。おい、なぜこれが"}, {"type": "subtitle", "time": 6409.83, "timestamp": "01:46:49", "text": "ああ、空腹度ゲージがある。私はしませんでした"}, {"type": "subtitle", "time": 6412.95, "timestamp": "01:46:52", "text": "気づく。ええと、ハングがあります。ああ、そうです。"}, {"type": "subtitle", "time": 6417.03, "timestamp": "01:46:57", "text": "ああ、奴らを殺す時が来た"}, {"type": "subtitle", "time": 6418.83, "timestamp": "01:46:58", "text": "牛。"}]
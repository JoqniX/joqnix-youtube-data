[{"type": "subtitle", "time": 15481.75, "timestamp": "04:18:01", "text": "食べ物？"}, {"type": "subtitle", "time": 15484.07, "timestamp": "04:18:04", "text": "なんてこった。開発する機会を得る"}, {"type": "subtitle", "time": 15486.23, "timestamp": "04:18:06", "text": "二つの都市を結ぶ正式な交易路。 A"}, {"type": "subtitle", "time": 15488.788, "timestamp": "04:18:08", "text": "トレーダーユニットが必要です。必要とされる"}, {"type": "subtitle", "time": 15491.03, "timestamp": "04:18:11", "text": "このようなルートを確立すると、"}, {"type": "subtitle", "time": 15494.91, "timestamp": "04:18:14", "text": "ほとんどすべての国が"}, {"type": "subtitle", "time": 15508.29, "timestamp": "04:18:28", "text": "戻る。来る"}, {"type": "subtitle", "time": 15526.91, "timestamp": "04:18:46", "text": "何？"}, {"type": "subtitle", "time": 15529.51, "timestamp": "04:18:49", "text": "軍事的な国境開放。よし、行こう"}, {"type": "subtitle", "time": 15535.03, "timestamp": "04:18:55", "text": "なんてこった、私には必要な敵が多すぎる"}]
[{"type": "subtitle", "time": 13081.23, "timestamp": "03:38:01", "text": "ついに。"}, {"type": "subtitle", "time": 13082.75, "timestamp": "03:38:02", "text": "おお、"}, {"type": "subtitle", "time": 13087.789, "timestamp": "03:38:07", "text": "シヴィライゼーション6には、4つのDLCがあります。ああ、"}, {"type": "subtitle", "time": 13090.51, "timestamp": "03:38:10", "text": "神。"}, {"type": "subtitle", "time": 13093.269, "timestamp": "03:38:13", "text": "はい、セール開催中です。わかった。では、"}, {"type": "subtitle", "time": 13095.91, "timestamp": "03:38:15", "text": "プレイするべきでしょうか？ ATX1か、それともこの12インチみたいなやつ？"}, {"type": "subtitle", "time": 13098.789, "timestamp": "03:38:18", "text": "私のPCが私のことを好きにならないことは分かっています"}, {"type": "subtitle", "time": 13102.07, "timestamp": "03:38:22", "text": "グラフィックカードがXX12に対応していないため"}, {"type": "subtitle", "time": 13105.109, "timestamp": "03:38:25", "text": "RTX 2060は"}, {"type": "subtitle", "time": 13109.349, "timestamp": "03:38:29", "text": "うーん、それほど多くはやらない。確かにそうですが"}, {"type": "subtitle", "time": 13111.51, "timestamp": "03:38:31", "text": "たくさんある、たくさんあるだろう"}, {"type": "subtitle", "time": 13115.75, "timestamp": "03:38:35", "text": "フレームの問題とか色々。えっと、ほとんど"}, {"type": "subtitle", "time": 13117.789, "timestamp": "03:38:37", "text": "私が"}, {"type": "subtitle", "time": 13121.789, "timestamp": "03:38:41", "text": "DirectXの使用を推奨します"}, {"type": "subtitle", "time": 13125.789, "timestamp": "03:38:45", "text": "11ですが、"}, {"type": "subtitle", "time": 13128.869, "timestamp": "03:38:48", "text": "痛みはあるけど、こんにちは、今チャットがあります"}, {"type": "subtitle", "time": 13132.39, "timestamp": "03:38:52", "text": "ああ、ついにチャット機能が実装された。"}, {"type": "subtitle", "time": 13135.349, "timestamp": "03:38:55", "text": "こんにちは、私が切り替えて、"}, {"type": "subtitle", "time": 13136.189, "timestamp": "03:38:56", "text": "ゲーム"}, {"type": "subtitle", "time": 13139.15, "timestamp": "03:38:59", "text": "ついに。えっと、これを取ってきます"}]
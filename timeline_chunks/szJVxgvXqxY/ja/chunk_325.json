[{"type": "subtitle", "time": 19503.27, "timestamp": "05:25:03", "text": "幽霊はいない。わかった。 EMF5ですよね？いや、私は違う"}, {"type": "subtitle", "time": 19505.43, "timestamp": "05:25:05", "text": "EMF5については確信しています。"}, {"type": "subtitle", "time": 19508.628, "timestamp": "05:25:08", "text": "私は悪魔をクリックしました。"}, {"type": "subtitle", "time": 19512.788, "timestamp": "05:25:12", "text": "うん。ああ、もう準備はできていましたよ。はい。"}, {"type": "subtitle", "time": 19515.11, "timestamp": "05:25:15", "text": "さあ行こう。彼は狩りを始めるのが早すぎたからだ。彼らは"}, {"type": "subtitle", "time": 19520.31, "timestamp": "05:25:20", "text": "もうクソみたいな狩りをしすぎた。"}, {"type": "subtitle", "time": 19525.07, "timestamp": "05:25:25", "text": "悪魔は、狩りをするのでとても怖いです"}, {"type": "subtitle", "time": 19529.83, "timestamp": "05:25:29", "text": "ええ、とてもとても頻繁に。非常に頻繁に。ああ"}, {"type": "subtitle", "time": 19531.59, "timestamp": "05:25:31", "text": "うん。"}, {"type": "subtitle", "time": 19543.67, "timestamp": "05:25:43", "text": "ゲーム。 2試合。はい。 2つですよね？だった"}, {"type": "subtitle", "time": 19546.868, "timestamp": "05:25:46", "text": "それ2つ？どれ？ 3試合。私たちは"}, {"type": "subtitle", "time": 19548.948, "timestamp": "05:25:48", "text": "三つ。ええ、3つやったと思います"}, {"type": "subtitle", "time": 19551.59, "timestamp": "05:25:51", "text": "ゲーム。はい、"}, {"type": "subtitle", "time": 19553.75, "timestamp": "05:25:53", "text": "うん、"}, {"type": "subtitle", "time": 19556.548, "timestamp": "05:25:56", "text": "楽しかった。私は普段はプレイしません"}, {"type": "subtitle", "time": 19559.43, "timestamp": "05:25:59", "text": "ファストフォビア、だってそれはあまりにも"}]
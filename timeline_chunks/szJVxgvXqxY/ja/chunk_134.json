[{"type": "subtitle", "time": 8041.349, "timestamp": "02:14:01", "text": "自分。おお。それはあなたができることだと思います"}, {"type": "subtitle", "time": 8044.55, "timestamp": "02:14:04", "text": "どこからでも入手できます。でも、あなたが亡くなった時、"}, {"type": "subtitle", "time": 8046.79, "timestamp": "02:14:06", "text": "まるで私があなたのところへ行って"}, {"type": "subtitle", "time": 8050.229, "timestamp": "02:14:10", "text": "その後、リスポーンする。あなたを蘇らせたい。おお、"}, {"type": "subtitle", "time": 8062.229, "timestamp": "02:14:22", "text": "このゲームでクリティカルヒットを出す方法が分からなかった。"}, {"type": "subtitle", "time": 8065.429, "timestamp": "02:14:25", "text": "気づいた時には、批判することもある。"}, {"type": "subtitle", "time": 8068.229, "timestamp": "02:14:28", "text": "マインクラフトのクリティカルヒット。可能性はあると思う"}, {"type": "subtitle", "time": 8071.269, "timestamp": "02:14:31", "text": "例えば、クリティカルヒットが出たら"}, {"type": "subtitle", "time": 8074.16, "timestamp": "02:14:34", "text": "クリティカルヒットの可能性があるかもしれません。"}, {"type": "subtitle", "time": 8076.63, "timestamp": "02:14:36", "text": "[音楽]"}, {"type": "subtitle", "time": 8085.59, "timestamp": "02:14:45", "text": "場合。わかった。それは全然違う"}, {"type": "subtitle", "time": 8088.269, "timestamp": "02:14:48", "text": "夜間なので、"}, {"type": "subtitle", "time": 8090.87, "timestamp": "02:14:50", "text": "少しでも。ああ、そこには村がある"}, {"type": "subtitle", "time": 8092.229, "timestamp": "02:14:52", "text": "反対側。建設しないで"}, {"type": "subtitle", "time": 8094.55, "timestamp": "02:14:54", "text": "ここにあるものなら何でも。うん。うん、行けるよ"}]
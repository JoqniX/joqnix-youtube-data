[{"type": "subtitle", "time": 19861.11, "timestamp": "05:31:01", "text": "戻ってきて色々やってみる。取りに行きます"}, {"type": "subtitle", "time": 19863.11, "timestamp": "05:31:03", "text": "休む。すごく気分がいい"}, {"type": "subtitle", "time": 19865.99, "timestamp": "05:31:05", "text": "今は疲れ果てていて、私はそうしたくない"}, {"type": "subtitle", "time": 19869.27, "timestamp": "05:31:09", "text": "それが欲しい。では、少し休憩します。それで、"}, {"type": "subtitle", "time": 19876.35, "timestamp": "05:31:16", "text": "[音楽]"}, {"type": "subtitle", "time": 19887.11, "timestamp": "05:31:27", "text": "土曜日。わかった。ゲストの一人は"}, {"type": "subtitle", "time": 19891.468, "timestamp": "05:31:31", "text": "明日のチマは再出発しました"}, {"type": "subtitle", "time": 19894.708, "timestamp": "05:31:34", "text": "いや、明日はダメだ。ああ、明日私は"}, {"type": "subtitle", "time": 19897.03, "timestamp": "05:31:37", "text": "言い忘れたけど、明日は"}, {"type": "subtitle", "time": 19900.03, "timestamp": "05:31:40", "text": "午前11時までに私は"}, {"type": "subtitle", "time": 19902.628, "timestamp": "05:31:42", "text": "アカデミー、日本のアカデミーみたいなもの"}, {"type": "subtitle", "time": 19905.19, "timestamp": "05:31:45", "text": "地元。それで彼らは私の家族に電話をかけてきた"}, {"type": "subtitle", "time": 19907.27, "timestamp": "05:31:47", "text": "そこには。私と父は出発します"}, {"type": "subtitle", "time": 19909.75, "timestamp": "05:31:49", "text": "7月に行くすべての学生"}, {"type": "subtitle", "time": 19913.19, "timestamp": "05:31:53", "text": "新入生も明日出発します"}, {"type": "subtitle", "time": 19917.19, "timestamp": "05:31:57", "text": "彼らが私たちにそこへ行くように言ったとおりに。だから私は"}]
[{"type": "subtitle", "time": 16509.39, "timestamp": "04:35:09", "text": "これ？"}, {"type": "subtitle", "time": 16517.23, "timestamp": "04:35:17", "text": "ここ。トレーダー"}, {"type": "subtitle", "time": 16519.788, "timestamp": "04:35:19", "text": "次。おお"}, {"type": "subtitle", "time": 16522.99, "timestamp": "04:35:22", "text": "いや、待って"}, {"type": "subtitle", "time": 16526.47, "timestamp": "04:35:26", "text": "彼らは私を攻撃しているのですか？待って、待って、"}, {"type": "subtitle", "time": 16529.59, "timestamp": "04:35:29", "text": "待って、待って、待って。彼らは私から盗んだのか"}, {"type": "subtitle", "time": 16531.07, "timestamp": "04:35:31", "text": "それとも何か別のこと？"}, {"type": "subtitle", "time": 16534.548, "timestamp": "04:35:34", "text": "待って。とんでもない。右。待って。それは"}, {"type": "subtitle", "time": 16536.41, "timestamp": "04:35:36", "text": "起こる"}, {"type": "subtitle", "time": 16542.19, "timestamp": "04:35:42", "text": "[音楽]"}, {"type": "subtitle", "time": 16543.9, "timestamp": "04:35:43", "text": "けれど。ああ、"}, {"type": "subtitle", "time": 16546.83, "timestamp": "04:35:46", "text": "[音楽]"}, {"type": "subtitle", "time": 16550.67, "timestamp": "04:35:50", "text": "神。わかった。なぜ後ろをついてくるの？"}, {"type": "subtitle", "time": 16555.15, "timestamp": "04:35:55", "text": "え、彼らは裏切り者を殺したの？"}, {"type": "subtitle", "time": 16557.948, "timestamp": "04:35:57", "text": "なんてこった。"}]
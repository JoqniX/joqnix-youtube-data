[{"type": "subtitle", "time": 13505.59, "timestamp": "03:45:05", "text": "水道料金。私はどうすればいいのでしょうか？"}, {"type": "subtitle", "time": 13509.03, "timestamp": "03:45:09", "text": "なぜ、これに関するガイドがないのですか？おい、俺は"}, {"type": "subtitle", "time": 13511.43, "timestamp": "03:45:11", "text": "文明に新しく、"}, {"type": "subtitle", "time": 13531.15, "timestamp": "03:45:31", "text": "ここ。ああ、君に何をすればいいんだ？見つけた"}, {"type": "subtitle", "time": 13534.628, "timestamp": "03:45:34", "text": "市。ああ、私たちは街を作ったんだ。何？私たちは"}, {"type": "subtitle", "time": 13537.51, "timestamp": "03:45:37", "text": "都市。これは何ですか？大使の年齢。いいえ、"}, {"type": "subtitle", "time": 13539.47, "timestamp": "03:45:39", "text": "その"}, {"type": "subtitle", "time": 13543.55, "timestamp": "03:45:43", "text": "文明。これは何ですか？あなたは"}, {"type": "subtitle", "time": 13546.948, "timestamp": "03:45:46", "text": "ヨーロッパの建物、地域的な"}, {"type": "subtitle", "time": 13551.35, "timestamp": "03:45:51", "text": "宗教を信仰する市民はゼロ。アニミティーズとして"}, {"type": "subtitle", "time": 13556.83, "timestamp": "03:45:56", "text": "プラス1。住宅1棟。えっと、14回転まで"}, {"type": "subtitle", "time": 13559.82, "timestamp": "03:45:59", "text": "成長。選ぶ"}]
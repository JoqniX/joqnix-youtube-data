[{"type": "subtitle", "time": 11640.07, "timestamp": "03:14:00", "text": "4月になれば、十分な時間がある。"}, {"type": "subtitle", "time": 11643.269, "timestamp": "03:14:03", "text": "実際、私はそれほど必要としていません。"}, {"type": "subtitle", "time": 11645.99, "timestamp": "03:14:05", "text": "1年間は気にしません"}, {"type": "subtitle", "time": 11649.75, "timestamp": "03:14:09", "text": "ジョアトンはこんな感じ。何てことだ。"}, {"type": "subtitle", "time": 11652.95, "timestamp": "03:14:12", "text": "知っている。なぜ今、家族から電話がかかってくるのだろう？"}, {"type": "subtitle", "time": 11656.389, "timestamp": "03:14:16", "text": "今日のみんなはどうしたの？わかった。 1つ"}, {"type": "subtitle", "time": 11658.149, "timestamp": "03:14:18", "text": "2番。"}, {"type": "subtitle", "time": 11663.67, "timestamp": "03:14:23", "text": "こんにちは、ナット。私とあなたと"}, {"type": "subtitle", "time": 11672.389, "timestamp": "03:14:32", "text": "冗談はもう終わりだ。お前は死んだ。ああ、そうだよ。なぜ"}, {"type": "subtitle", "time": 11674.189, "timestamp": "03:14:34", "text": "彼らは行くのか"}, {"type": "subtitle", "time": 11676.95, "timestamp": "03:14:36", "text": "持ち帰り？"}, {"type": "subtitle", "time": 11689.91, "timestamp": "03:14:49", "text": "それらを返してください。"}, {"type": "subtitle", "time": 11692.71, "timestamp": "03:14:52", "text": "スパイクが植えられました。"}, {"type": "subtitle", "time": 11694.69, "timestamp": "03:14:54", "text": "敵はあと一体。"}, {"type": "subtitle", "time": 11696.87, "timestamp": "03:14:56", "text": "[拍手]"}, {"type": "subtitle", "time": 11699.67, "timestamp": "03:14:59", "text": "おお。"}]
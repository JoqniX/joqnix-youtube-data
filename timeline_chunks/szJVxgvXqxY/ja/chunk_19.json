[{"type": "subtitle", "time": 1143.43, "timestamp": "00:19:03", "text": "それから彼は「ああ、ただ」と言った。"}, {"type": "subtitle", "time": 1151.51, "timestamp": "00:19:11", "text": "そして私は「ああ、これ楽しいな」と思う。それで"}, {"type": "subtitle", "time": 1154.63, "timestamp": "00:19:14", "text": "ああ、結局Minecraftを作ることになった"}, {"type": "subtitle", "time": 1157.11, "timestamp": "00:19:17", "text": "肌。"}, {"type": "subtitle", "time": 1159.43, "timestamp": "00:19:19", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 1161.91, "timestamp": "00:19:21", "text": "すごくかっこいい。ああ、それはすごくかっこいいですね。私はしません"}, {"type": "subtitle", "time": 1165.189, "timestamp": "00:19:25", "text": "ジョック用のスキンもまだ持っていない"}, {"type": "subtitle", "time": 1167.35, "timestamp": "00:19:27", "text": "マインクラフトで。しかしMinecraftは"}, {"type": "subtitle", "time": 1169.99, "timestamp": "00:19:29", "text": "楽しいゲームです。いいえ、とても楽しいです。うん、そうだね"}, {"type": "subtitle", "time": 1172.31, "timestamp": "00:19:32", "text": "は。ええ、特にあなたがプレイするなら"}, {"type": "subtitle", "time": 1175.03, "timestamp": "00:19:35", "text": "友達と一緒に。"}, {"type": "subtitle", "time": 1177.75, "timestamp": "00:19:37", "text": "確かに、確かに、確かに。例えば、"}, {"type": "subtitle", "time": 1179.91, "timestamp": "00:19:39", "text": "自分のサーバーを持てば、ほら、"}, {"type": "subtitle", "time": 1182.35, "timestamp": "00:19:42", "text": "自慢する。"}, {"type": "subtitle", "time": 1185.43, "timestamp": "00:19:45", "text": "さて、Minecraft に関しては、"}, {"type": "subtitle", "time": 1188.39, "timestamp": "00:19:48", "text": "カスタムのものもあるし、"}, {"type": "subtitle", "time": 1190.709, "timestamp": "00:19:50", "text": "フィグラとかいうやつ。"}, {"type": "subtitle", "time": 1193.189, "timestamp": "00:19:53", "text": "えっと、それについて知ってますか？カスタムのように"}, {"type": "subtitle", "time": 1195.27, "timestamp": "00:19:55", "text": "尻尾とかあるんだよ、"}, {"type": "subtitle", "time": 1198.31, "timestamp": "00:19:58", "text": "ドラゴンの尻尾とか、何でもいいけど。そうそう、"}]
[{"type": "subtitle", "time": 11101.91, "timestamp": "03:05:01", "text": "ほとんど？わからない。私はFPSが好きで"}, {"type": "subtitle", "time": 11104.79, "timestamp": "03:05:04", "text": "もの。あれらは楽しいね。速いペース"}, {"type": "subtitle", "time": 11107.59, "timestamp": "03:05:07", "text": "ゲーム。"}, {"type": "subtitle", "time": 11111.59, "timestamp": "03:05:11", "text": "RPGやMMORPGタイプも構いません。"}, {"type": "subtitle", "time": 11114.91, "timestamp": "03:05:14", "text": "それらも楽しい。少し"}, {"type": "subtitle", "time": 11117.469, "timestamp": "03:05:17", "text": "面倒くさい。ああ、でもそうだね、"}, {"type": "subtitle", "time": 11120.15, "timestamp": "03:05:20", "text": "楽しんでいればそれでいいんです"}, {"type": "subtitle", "time": 11122.389, "timestamp": "03:05:22", "text": "どんなゲームでも。実際、私は持っていません"}, {"type": "subtitle", "time": 11129.11, "timestamp": "03:05:29", "text": "あなたの好きなストーリータイプは何ですか？"}, {"type": "subtitle", "time": 11130.87, "timestamp": "03:05:30", "text": "ゲーム？"}, {"type": "subtitle", "time": 11133.63, "timestamp": "03:05:33", "text": "お話の時間"}, {"type": "subtitle", "time": 11137.349, "timestamp": "03:05:37", "text": "ゲーム？はぁ？話。つまり、原神と"}, {"type": "subtitle", "time": 11140.189, "timestamp": "03:05:40", "text": "それらのガチャゲームはすべて良い"}, {"type": "subtitle", "time": 11143.51, "timestamp": "03:05:43", "text": "話。兄弟、一つだけプレイしたいことがあるんだ"}, {"type": "subtitle", "time": 11146.309, "timestamp": "03:05:46", "text": "今日はデトロイト：男になる日。ああ、私は"}, {"type": "subtitle", "time": 11148.63, "timestamp": "03:05:48", "text": "実際にプレイしました。それはまるで"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "私が始めたストリーム"}]
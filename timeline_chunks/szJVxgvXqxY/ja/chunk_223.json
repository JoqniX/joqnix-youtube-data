[{"type": "subtitle", "time": 13381.99, "timestamp": "03:43:01", "text": "動けば動くほど、"}, {"type": "subtitle", "time": 13386.11, "timestamp": "03:43:06", "text": "移動すればするほど、発見する領域は広がる。"}, {"type": "subtitle", "time": 13388.35, "timestamp": "03:43:08", "text": "何？"}, {"type": "subtitle", "time": 13391.15, "timestamp": "03:43:11", "text": "くそ。わかった。わかった。"}, {"type": "subtitle", "time": 13394.628, "timestamp": "03:43:14", "text": "わかった。わかった。わかった。わかった。私は興奮しています。"}, {"type": "subtitle", "time": 13397.39, "timestamp": "03:43:17", "text": "これは何ですか？サマリア"}, {"type": "subtitle", "time": 13400.628, "timestamp": "03:43:20", "text": "戦士よ、君を動かしてもいいか？動けません"}, {"type": "subtitle", "time": 13408.948, "timestamp": "03:43:28", "text": "行く。 1つ。待って、私は何をすべき？私は何？"}, {"type": "subtitle", "time": 13419.75, "timestamp": "03:43:39", "text": "トン。終わりにするのはどういう意味ですか？"}, {"type": "subtitle", "time": 13422.67, "timestamp": "03:43:42", "text": "トンベースのゲーム。"}, {"type": "subtitle", "time": 13429.91, "timestamp": "03:43:49", "text": "アドバイザーは淡水資源について語る"}, {"type": "subtitle", "time": 13431.788, "timestamp": "03:43:51", "text": "地域別収量"}, {"type": "subtitle", "time": 13437.27, "timestamp": "03:43:57", "text": "新しい都市。はぁ。研究を選びなさい。ええと、開いています"}, {"type": "subtitle", "time": 13438.99, "timestamp": "03:43:58", "text": "テクノロジーツリー。"}]
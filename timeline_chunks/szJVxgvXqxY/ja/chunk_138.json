[{"type": "subtitle", "time": 8287.59, "timestamp": "02:18:07", "text": "私は、味方同士の誤射は好きではないと思います。"}, {"type": "subtitle", "time": 8289.429, "timestamp": "02:18:09", "text": "オンになっています。"}, {"type": "subtitle", "time": 8292.349, "timestamp": "02:18:12", "text": "ええ、そうではありません。その"}, {"type": "subtitle", "time": 8312.63, "timestamp": "02:18:32", "text": "止めるつもりだ。"}, {"type": "subtitle", "time": 8328.75, "timestamp": "02:18:48", "text": "トップ。彼が殺そうとしないことを願う"}, {"type": "subtitle", "time": 8330.99, "timestamp": "02:18:50", "text": "私たち。そこで私たちは"}, {"type": "subtitle", "time": 8335.229, "timestamp": "02:18:55", "text": "行く。はい、私はかなりの量の"}, {"type": "subtitle", "time": 8338.309, "timestamp": "02:18:58", "text": "コイン。レアな宝箱を開けに行く"}]
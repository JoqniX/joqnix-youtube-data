[{"type": "subtitle", "time": 5646.47, "timestamp": "01:34:06", "text": "えっと、更新させてください"}, {"type": "subtitle", "time": 5648.67, "timestamp": "01:34:08", "text": "[音楽]"}, {"type": "subtitle", "time": 5651.67, "timestamp": "01:34:11", "text": "あれ。リンクを更新したと思います"}, {"type": "subtitle", "time": 5656.15, "timestamp": "01:34:16", "text": "などなど。切り替える必要があります"}, {"type": "subtitle", "time": 5664.309, "timestamp": "01:34:24", "text": "でも、もしあなたが楽しんでいたら、"}, {"type": "subtitle", "time": 5668.23, "timestamp": "01:34:28", "text": "今日はアゼラサンさんと楽しい時間を過ごしました。"}, {"type": "subtitle", "time": 5672.63, "timestamp": "01:34:32", "text": "どうぞご自由にフォローしてください"}, {"type": "subtitle", "time": 5674.27, "timestamp": "01:34:34", "text": "フォローして応援しよう"}, {"type": "subtitle", "time": 5676.79, "timestamp": "01:34:36", "text": "アゼラサナ。彼女がVに戻ってきてくれるといいな"}, {"type": "subtitle", "time": 5679.99, "timestamp": "01:34:39", "text": "チームを組む。彼女が来てくれて本当に楽しかった。"}, {"type": "subtitle", "time": 5682.87, "timestamp": "01:34:42", "text": "彼女は本当に良い人だった"}, {"type": "subtitle", "time": 5685.469, "timestamp": "01:34:45", "text": "すごくいい雰囲気で、"}, {"type": "subtitle", "time": 5687.99, "timestamp": "01:34:47", "text": "エネルギー。遊ぶのは本当に楽しかった"}, {"type": "subtitle", "time": 5690.309, "timestamp": "01:34:50", "text": "彼女とゲームをする。ゲームをプレイできるといいな"}, {"type": "subtitle", "time": 5693.07, "timestamp": "01:34:53", "text": "将来彼女と共に"}, {"type": "subtitle", "time": 5699.51, "timestamp": "01:34:59", "text": "人。ああ、私は"}]
[{"type": "subtitle", "time": 10500.63, "timestamp": "02:55:00", "text": "秒。本当にイライラした。気に入った"}, {"type": "subtitle", "time": 10502.15, "timestamp": "02:55:02", "text": "試合は1試合分くらいの期間続いた"}, {"type": "subtitle", "time": 10503.99, "timestamp": "02:55:03", "text": "時間。 1試合に1時間とか、"}, {"type": "subtitle", "time": 10511.75, "timestamp": "02:55:11", "text": "うん。だから私は燃え尽きてしまった"}, {"type": "subtitle", "time": 10514.87, "timestamp": "02:55:14", "text": "プレイをやめた。"}, {"type": "subtitle", "time": 10522.469, "timestamp": "02:55:22", "text": "そして私も小さな"}, {"type": "subtitle", "time": 10524.469, "timestamp": "02:55:24", "text": "少し毒性もある。だから私は「いや、"}, {"type": "subtitle", "time": 10526.15, "timestamp": "02:55:26", "text": "私としては以上です。私はなりたくない"}, {"type": "subtitle", "time": 10536.07, "timestamp": "02:55:36", "text": "うん。これらのゲームは、あなたが"}, {"type": "subtitle", "time": 10543.83, "timestamp": "02:55:43", "text": "ええ、時々、精神的に影響が出ますよね。"}, {"type": "subtitle", "time": 10546.229, "timestamp": "02:55:46", "text": "それは多くのことを成し遂げます。"}, {"type": "subtitle", "time": 10549.349, "timestamp": "02:55:49", "text": "それが私がプレイしない理由でもある"}, {"type": "subtitle", "time": 10551.75, "timestamp": "02:55:51", "text": "それほどまでに競争が激しいのです。以前は"}, {"type": "subtitle", "time": 10554.03, "timestamp": "02:55:54", "text": "フォートナイトとかそういうのがそれ"}, {"type": "subtitle", "time": 10556.95, "timestamp": "02:55:56", "text": "ソロキャッシュキャップと"}, {"type": "subtitle", "time": 10558.87, "timestamp": "02:55:58", "text": "それらすべて"}]
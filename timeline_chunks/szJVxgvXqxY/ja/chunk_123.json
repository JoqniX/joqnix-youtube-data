[{"type": "subtitle", "time": 7390.87, "timestamp": "02:03:10", "text": "プレイヤーのワイルドカード。"}, {"type": "subtitle", "time": 7401.95, "timestamp": "02:03:21", "text": "うん、クラフトしたよ"}, {"type": "subtitle", "time": 7404.95, "timestamp": "02:03:24", "text": "テーブル。えっと、使ってみましょう"}, {"type": "subtitle", "time": 7406.79, "timestamp": "02:03:26", "text": "小屋の一つ。ああ、"}, {"type": "subtitle", "time": 7410.59, "timestamp": "02:03:30", "text": "作業台は既にここにあります。"}, {"type": "subtitle", "time": 7413.429, "timestamp": "02:03:33", "text": "あ、あと鉄の棒は"}, {"type": "subtitle", "time": 7415.99, "timestamp": "02:03:35", "text": "鍛冶屋。"}, {"type": "subtitle", "time": 7418.55, "timestamp": "02:03:38", "text": "おお、いいね。"}, {"type": "subtitle", "time": 7423.11, "timestamp": "02:03:43", "text": "そして私は斧を手に入れたが、それはまるで"}, {"type": "subtitle", "time": 7437.309, "timestamp": "02:03:57", "text": "石炭を買うのを忘れないでください。私たちは作ります"}]
[{"type": "subtitle", "time": 16140.91, "timestamp": "04:29:00", "text": "えーと"}, {"type": "subtitle", "time": 16144.59, "timestamp": "04:29:04", "text": "生産。いや、いや、いや。 100%"}, {"type": "subtitle", "time": 16147.07, "timestamp": "04:29:07", "text": "生産とコスト削減"}, {"type": "subtitle", "time": 16158.11, "timestamp": "04:29:18", "text": "1つ。やあ、野蛮人ども、君たちは"}, {"type": "subtitle", "time": 16161.07, "timestamp": "04:29:21", "text": "おそらく"}, {"type": "subtitle", "time": 16163.548, "timestamp": "04:29:23", "text": "隠れる"}, {"type": "subtitle", "time": 16167.43, "timestamp": "04:29:27", "text": "自分自身を改革せよ。"}, {"type": "subtitle", "time": 16176.83, "timestamp": "04:29:36", "text": "目を覚ませ。戦争は決して戦えない"}, {"type": "subtitle", "time": 16186.708, "timestamp": "04:29:46", "text": "バカ。 37. ああ、私は"}, {"type": "subtitle", "time": 16191.59, "timestamp": "04:29:51", "text": "弓兵。わかった。選択してください"}, {"type": "subtitle", "time": 16195.19, "timestamp": "04:29:55", "text": "えっと、クラフト改良ビルダー1。わかった。"}, {"type": "subtitle", "time": 16197.07, "timestamp": "04:29:57", "text": "ドラマと静寂"}]
[{"type": "subtitle", "time": 2824.83, "timestamp": "00:47:04", "text": "間違い。これを服用すべきでしょうか？"}, {"type": "subtitle", "time": 2833.109, "timestamp": "00:47:13", "text": "A. ここに鎧があります。レベル2。"}, {"type": "subtitle", "time": 2837.189, "timestamp": "00:47:17", "text": "ああ、もう鎧は持ってるよ。"}, {"type": "subtitle", "time": 2866.95, "timestamp": "00:47:46", "text": "離れて。ショットガンとSMGは良いと思います"}, {"type": "subtitle", "time": 2869.109, "timestamp": "00:47:49", "text": "戦術、ということだろうか。"}, {"type": "subtitle", "time": 2872.229, "timestamp": "00:47:52", "text": "そう、前回の試合は私が"}, {"type": "subtitle", "time": 2874.38, "timestamp": "00:47:54", "text": "その荷物を運び出した。"}, {"type": "subtitle", "time": 2877.43, "timestamp": "00:47:57", "text": "[笑い]"}]
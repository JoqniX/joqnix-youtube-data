[{"type": "subtitle", "time": 1261.63, "timestamp": "00:21:01", "text": "青い石って知ってるよね。"}, {"type": "subtitle", "time": 1266.709, "timestamp": "00:21:06", "text": "ああ。ああ、ラップはマインクラフトから来ています。"}, {"type": "subtitle", "time": 1272.83, "timestamp": "00:21:12", "text": "それはまさに"}, {"type": "subtitle", "time": 1275.91, "timestamp": "00:21:15", "text": "クリエイティブ。すごくかっこいい。"}, {"type": "subtitle", "time": 1281.11, "timestamp": "00:21:21", "text": "何てことだ。ニース。それはすごくクールですね。"}, {"type": "subtitle", "time": 1283.59, "timestamp": "00:21:23", "text": "わかった。私はただランダムに別のものを作る"}, {"type": "subtitle", "time": 1287.229, "timestamp": "00:21:27", "text": "それには背景事情がある。だから"}, {"type": "subtitle", "time": 1291.99, "timestamp": "00:21:31", "text": "私は自分の見た目が好きです。"}, {"type": "subtitle", "time": 1302.149, "timestamp": "00:21:42", "text": "逃す？あなたの「私も」が本当に大好きです"}, {"type": "subtitle", "time": 1305.27, "timestamp": "00:21:45", "text": "モデル。とてもかわいい。"}, {"type": "subtitle", "time": 1307.11, "timestamp": "00:21:47", "text": "ありがとう。"}, {"type": "subtitle", "time": 1310.31, "timestamp": "00:21:50", "text": "とてもかわいい。自分で描いたんだね。"}, {"type": "subtitle", "time": 1315.27, "timestamp": "00:21:55", "text": "右？えっと、あの頃は"}, {"type": "subtitle", "time": 1319.59, "timestamp": "00:21:59", "text": "このウェブサイトには、"}]
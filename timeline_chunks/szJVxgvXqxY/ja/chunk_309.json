[{"type": "subtitle", "time": 18541.11, "timestamp": "05:09:01", "text": "ここです。そこで待っていてください。うん。うん。"}, {"type": "subtitle", "time": 18544.39, "timestamp": "05:09:04", "text": "女の子たちは"}, {"type": "subtitle", "time": 18551.51, "timestamp": "05:09:11", "text": "えーっと、それは、"}, {"type": "subtitle", "time": 18554.07, "timestamp": "05:09:14", "text": "孤独で、まるで彼らを狩るかのように。ない"}, {"type": "subtitle", "time": 18556.868, "timestamp": "05:09:16", "text": "グループでの活動が得意。うん。そう思います。私"}, {"type": "subtitle", "time": 18558.11, "timestamp": "05:09:18", "text": "考える"}, {"type": "subtitle", "time": 18570.47, "timestamp": "05:09:30", "text": "ドアや"}, {"type": "subtitle", "time": 18573.59, "timestamp": "05:09:33", "text": "えっと、実際に動いているところ？"}, {"type": "subtitle", "time": 18576.35, "timestamp": "05:09:36", "text": "いいえ。いいえ。"}, {"type": "subtitle", "time": 18579.11, "timestamp": "05:09:39", "text": "いいえ。ただ、ブーンという音のような感じです。それは"}, {"type": "subtitle", "time": 18581.03, "timestamp": "05:09:41", "text": "それ。"}, {"type": "subtitle", "time": 18584.27, "timestamp": "05:09:44", "text": "上の階に行ってみてください。行く"}, {"type": "subtitle", "time": 18588.11, "timestamp": "05:09:48", "text": "上。横にプレイするか、"}, {"type": "subtitle", "time": 18597.03, "timestamp": "05:09:57", "text": "上の階に靴があります。"}]
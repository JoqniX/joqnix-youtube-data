[{"type": "subtitle", "time": 18781.51, "timestamp": "05:13:01", "text": "待って、幽霊はどこ？わかりました、では"}, {"type": "subtitle", "time": 18785.35, "timestamp": "05:13:05", "text": "懐中電灯を消してください。わかった。それからあなたは"}, {"type": "subtitle", "time": 18787.27, "timestamp": "05:13:07", "text": "よく見ないと、時々"}, {"type": "subtitle", "time": 18789.67, "timestamp": "05:13:09", "text": "それは現れるでしょう。"}, {"type": "subtitle", "time": 18791.27, "timestamp": "05:13:11", "text": "うん。うん。時々現れて"}, {"type": "subtitle", "time": 18804.548, "timestamp": "05:13:24", "text": "えっと、また部屋を変えるんですか？"}, {"type": "subtitle", "time": 18812.868, "timestamp": "05:13:32", "text": "ああ、カメラを回転させることができるよ。それは素晴らしいですね。"}, {"type": "subtitle", "time": 18820.47, "timestamp": "05:13:40", "text": "毛がない。わかった、気にしないで。大丈夫。"}, {"type": "subtitle", "time": 18824.23, "timestamp": "05:13:44", "text": "それは狩りだ。"}, {"type": "subtitle", "time": 18826.67, "timestamp": "05:13:46", "text": "ああ、"}, {"type": "subtitle", "time": 18829.548, "timestamp": "05:13:49", "text": "ハント。そうでないことを願います"}, {"type": "subtitle", "time": 18834.12, "timestamp": "05:13:54", "text": "えっと、それが模倣生物じゃないことを願います。"}, {"type": "subtitle", "time": 18836.628, "timestamp": "05:13:56", "text": "[音楽]"}, {"type": "subtitle", "time": 18839.75, "timestamp": "05:13:59", "text": "紫外線ではありません。"}]
[{"type": "subtitle", "time": 2779.39, "timestamp": "00:46:19", "text": "うん。ああ、私は"}, {"type": "subtitle", "time": 2783.109, "timestamp": "00:46:23", "text": "AK。おお、いいね。"}, {"type": "subtitle", "time": 2783.95, "timestamp": "00:46:23", "text": "得る"}, {"type": "subtitle", "time": 2787.229, "timestamp": "00:46:27", "text": "これ。それを手に入れろ。おお、"}, {"type": "subtitle", "time": 2788.99, "timestamp": "00:46:28", "text": "胸。"}, {"type": "subtitle", "time": 2793.99, "timestamp": "00:46:33", "text": "ああ、超エリートだね。超高級弾薬。私"}, {"type": "subtitle", "time": 2797.109, "timestamp": "00:46:37", "text": "ゲームで何が起こったか考えてみてください。"}, {"type": "subtitle", "time": 2800.47, "timestamp": "00:46:40", "text": "このトミーガンはあったが、弾薬がなかった。私"}, {"type": "subtitle", "time": 2803.27, "timestamp": "00:46:43", "text": "再読み込みも試しましたが、"}, {"type": "subtitle", "time": 2813.47, "timestamp": "00:46:53", "text": "バカ。そういうこともあるんだよ。ああ、"}, {"type": "subtitle", "time": 2816.07, "timestamp": "00:46:56", "text": "神。大丈夫。それはそれはそれはそれはそれは"}]
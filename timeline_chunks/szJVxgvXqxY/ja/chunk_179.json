[{"type": "subtitle", "time": 10759.83, "timestamp": "02:59:19", "text": "何てことだ。彼が代替アカウントを持っていなければ、私は"}, {"type": "subtitle", "time": 10777.51, "timestamp": "02:59:37", "text": "いいえ。遊びたいの？遊ぼう。さあ"}, {"type": "subtitle", "time": 10780.389, "timestamp": "02:59:40", "text": "プレイチャンバー。ステージまであと数秒"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "ああ、"}, {"type": "subtitle", "time": 10798.429, "timestamp": "02:59:58", "text": "このネオン"}]
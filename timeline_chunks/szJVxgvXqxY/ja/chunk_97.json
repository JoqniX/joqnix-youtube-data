[{"type": "subtitle", "time": 5820.87, "timestamp": "01:37:00", "text": "[音楽]"}, {"type": "subtitle", "time": 5823.389, "timestamp": "01:37:03", "text": "こんにちは。"}, {"type": "subtitle", "time": 5827.51, "timestamp": "01:37:07", "text": "ハラム。元気ですか？何てことだ。"}, {"type": "subtitle", "time": 5830.27, "timestamp": "01:37:10", "text": "私は大丈夫です。お元気ですか？私は"}, {"type": "subtitle", "time": 5834.63, "timestamp": "01:37:14", "text": "素晴らしい。タタムの息子は今日、どんな様子ですか？"}, {"type": "subtitle", "time": 5839.27, "timestamp": "01:37:19", "text": "本当に疲れた。私は、えーと仕事を持っていた"}, {"type": "subtitle", "time": 5840.87, "timestamp": "01:37:20", "text": "午前中に仕事があるので"}, {"type": "subtitle", "time": 5842.63, "timestamp": "01:37:22", "text": "会議の後、私は寝ました"}, {"type": "subtitle", "time": 5845.349, "timestamp": "01:37:25", "text": "まただ。今、目が覚めたばかりだ。私"}, {"type": "subtitle", "time": 5848.87, "timestamp": "01:37:28", "text": "知る。君が錆びついた男みたいであることを願ってるよ。"}, {"type": "subtitle", "time": 5851.429, "timestamp": "01:37:31", "text": "もしあなたが私に、私は再好きになれると言ったら"}, {"type": "subtitle", "time": 5853.83, "timestamp": "01:37:33", "text": "タイミングを調整しました。あなたはこう言うこともできたでしょう"}, {"type": "subtitle", "time": 5856.79, "timestamp": "01:37:36", "text": "それ。大丈夫です。大丈夫です。私はそうすべきではない"}, {"type": "subtitle", "time": 5859.03, "timestamp": "01:37:39", "text": "睡眠時間が長すぎるのが好きだから"}, {"type": "subtitle", "time": 5861.429, "timestamp": "01:37:41", "text": "スケジュールがまためちゃくちゃになるだろう。"}, {"type": "subtitle", "time": 5865.51, "timestamp": "01:37:45", "text": "あなたはとても遅くまで寝ていることに気づきました。"}, {"type": "subtitle", "time": 5867.11, "timestamp": "01:37:47", "text": "おお。"}, {"type": "subtitle", "time": 5870.389, "timestamp": "01:37:50", "text": "午前4時か5時頃だったと思う。"}, {"type": "subtitle", "time": 5872.63, "timestamp": "01:37:52", "text": "昨日。"}, {"type": "subtitle", "time": 5875.309, "timestamp": "01:37:55", "text": "うん。さよなら。それは"}, {"type": "subtitle", "time": 5877.87, "timestamp": "01:37:57", "text": "非常識な。ああ、"}]
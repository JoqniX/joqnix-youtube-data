[{"type": "subtitle", "time": 1624.07, "timestamp": "00:27:04", "text": "わかった。ジャンプするとき"}, {"type": "subtitle", "time": 1626.79, "timestamp": "00:27:06", "text": "そして、あなたは自由落下する。"}, {"type": "subtitle", "time": 1629.189, "timestamp": "00:27:09", "text": "ああ、自由落下はEになり、あなたは"}, {"type": "subtitle", "time": 1632.39, "timestamp": "00:27:12", "text": "もう一度Eキーを押してください。そうすべきではない。ああ、わかった。"}, {"type": "subtitle", "time": 1634.79, "timestamp": "00:27:14", "text": "パラシュートを取り出すべきです。"}, {"type": "subtitle", "time": 1653.03, "timestamp": "00:27:33", "text": "ああ、武器は上に置くべきですよね？"}, {"type": "subtitle", "time": 1656.95, "timestamp": "00:27:36", "text": "待って。いいえ、この辺りだと思います"}, {"type": "subtitle", "time": 1659.79, "timestamp": "00:27:39", "text": "どこかで。かつては"}, {"type": "subtitle", "time": 1663.79, "timestamp": "00:27:43", "text": "戦闘範囲または"}]
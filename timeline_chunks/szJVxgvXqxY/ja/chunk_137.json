[{"type": "subtitle", "time": 8222.63, "timestamp": "02:17:02", "text": "私は彼らに勝てると思う。"}, {"type": "subtitle", "time": 8229.51, "timestamp": "02:17:09", "text": "私は実際に彼らに勝てると思う。"}, {"type": "subtitle", "time": 8232.07, "timestamp": "02:17:12", "text": "持続する。よぉ、俺が奴らを倒したんだ。私は彼らに勝った。"}, {"type": "subtitle", "time": 8233.429, "timestamp": "02:17:13", "text": "私は彼らに勝った。男は一人しかいない。わかった、"}, {"type": "subtitle", "time": 8251.349, "timestamp": "02:17:31", "text": "ああ、もう夜だ。"}, {"type": "subtitle", "time": 8252.95, "timestamp": "02:17:32", "text": "何てことだ。いいえ、私はすでに"}, {"type": "subtitle", "time": 8266.07, "timestamp": "02:17:46", "text": "宝箱を開けると、"}, {"type": "subtitle", "time": 8269.15, "timestamp": "02:17:49", "text": "彼らは彼らの前では怒り出す。"}, {"type": "subtitle", "time": 8279.59, "timestamp": "02:17:59", "text": "うん。あ、すみません。ああ、なんてことだ、君は怖がっている"}]
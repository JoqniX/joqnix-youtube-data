[{"type": "subtitle", "time": 10380.309, "timestamp": "02:53:00", "text": "いいえ、私はダイヤモンド1です。あなたは何を"}, {"type": "subtitle", "time": 10383.429, "timestamp": "02:53:03", "text": "平均？ PLと書いてあります。あ、あ、ごめんなさい、ごめんなさい、"}, {"type": "subtitle", "time": 10384.63, "timestamp": "02:53:04", "text": "ごめん。それは別人だった。ごめん、"}, {"type": "subtitle", "time": 10389.75, "timestamp": "02:53:09", "text": "ごめんなさい、ごめんなさい。ダイヤモンド1。それはすごい量ですね。"}, {"type": "subtitle", "time": 10392.229, "timestamp": "02:53:12", "text": "以前は昇天したような感じだったけど、"}, {"type": "subtitle", "time": 10394.95, "timestamp": "02:53:14", "text": "あまりプレイしなかったので、"}, {"type": "subtitle", "time": 10407.59, "timestamp": "02:53:27", "text": "ああ、誰かが私のレオンを選んだんだ。"}, {"type": "subtitle", "time": 10411.11, "timestamp": "02:53:31", "text": "時間はいくらでもある。"}, {"type": "subtitle", "time": 10413.469, "timestamp": "02:53:33", "text": "どのキャラクターのことですか"}, {"type": "subtitle", "time": 10417.51, "timestamp": "02:53:37", "text": "ほとんど？えっと、大学のチームでは、以前は"}, {"type": "subtitle", "time": 10420.95, "timestamp": "02:53:40", "text": "コントローラーのようにプレイします。まるで私が"}, {"type": "subtitle", "time": 10423.429, "timestamp": "02:53:43", "text": "Omen、Viper、その他何でもプレイ"}, {"type": "subtitle", "time": 10425.67, "timestamp": "02:53:45", "text": "チームのニーズ。でも、競争では、私はただ"}, {"type": "subtitle", "time": 10427.83, "timestamp": "02:53:47", "text": "好きなものを何でも演奏する。それは、"}, {"type": "subtitle", "time": 10430.389, "timestamp": "02:53:50", "text": "演じるキャラクターが多ければ多いほど、私の演技は良くなる。のように"}, {"type": "subtitle", "time": 10431.99, "timestamp": "02:53:51", "text": "一つのキャラクターにこだわると、"}, {"type": "subtitle", "time": 10435.11, "timestamp": "02:53:55", "text": "燃え尽きて、それから私は"}, {"type": "subtitle", "time": 10437.75, "timestamp": "02:53:57", "text": "プレーが下手になり始める。私はただ選ぶだけです"}, {"type": "subtitle", "time": 10439.59, "timestamp": "02:53:59", "text": "毎回ランダムなキャラクター、もしくは"}]
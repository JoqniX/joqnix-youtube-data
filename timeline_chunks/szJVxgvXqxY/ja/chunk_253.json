[{"type": "subtitle", "time": 15180.948, "timestamp": "04:13:00", "text": "171ゴールドを送って、まるで彼女が与えているかのように"}, {"type": "subtitle", "time": 15182.75, "timestamp": "04:13:02", "text": "私121"}, {"type": "subtitle", "time": 15185.07, "timestamp": "04:13:05", "text": "[音楽]"}, {"type": "subtitle", "time": 15187.85, "timestamp": "04:13:07", "text": "金。あなたなら何をあげますか？"}, {"type": "subtitle", "time": 15191.23, "timestamp": "04:13:11", "text": "[音楽]"}, {"type": "subtitle", "time": 15194.55, "timestamp": "04:13:14", "text": "自分？待って、待って、待って。"}, {"type": "subtitle", "time": 15195.948, "timestamp": "04:13:15", "text": "[音楽]"}, {"type": "chat", "time": 15200.309, "timestamp": "04:13:20", "author": "@natsukisouta", "avatar": "https://yt4.ggpht.com/DoWHfl2un-x9C1FjOZkls_H2TTeAipp9__JetXpYAJhuduFn6-Pn9_VXt5jORITV_b2weavr=s64-c-k-c0x00ffffff-no-rj", "message": "LETSGOOO"}, {"type": "subtitle", "time": 15200.43, "timestamp": "04:13:20", "text": "100 ギフトを贈る。ありがとう、友よ。"}, {"type": "subtitle", "time": 15203.67, "timestamp": "04:13:23", "text": "わかった。ああ、私たちは友達になったんだ。何てことだ、"}, {"type": "subtitle", "time": 15214.948, "timestamp": "04:13:34", "text": "あなた方の意図に反する。非難する"}, {"type": "subtitle", "time": 15217.35, "timestamp": "04:13:37", "text": "リーダーは約束を守れなかった"}, {"type": "subtitle", "time": 15220.55, "timestamp": "04:13:40", "text": "休憩の約束を頼む"}, {"type": "subtitle", "time": 15223.39, "timestamp": "04:13:43", "text": "彼らにとって。ああ、"}, {"type": "subtitle", "time": 15226.47, "timestamp": "04:13:46", "text": "神。聖なる。怖くて見るのもためらう"}, {"type": "subtitle", "time": 15230.07, "timestamp": "04:13:50", "text": "見て。わかった。ええと、私たちはこれらと戦っていました"}]
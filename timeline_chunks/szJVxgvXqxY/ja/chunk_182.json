[{"type": "subtitle", "time": 10924.99, "timestamp": "03:02:04", "text": "あらら"}, {"type": "subtitle", "time": 10940.11, "timestamp": "03:02:20", "text": "あのネオン。何てことだ。充電したい"}, {"type": "subtitle", "time": 10951.99, "timestamp": "03:02:31", "text": "それは"}, {"type": "subtitle", "time": 10963.11, "timestamp": "03:02:43", "text": "死ね、このガキ。私はできません。使えません"}, {"type": "subtitle", "time": 10965.03, "timestamp": "03:02:45", "text": "それ。"}, {"type": "subtitle", "time": 10967.59, "timestamp": "03:02:47", "text": "いや、私たちは勝てたはずだ"}]
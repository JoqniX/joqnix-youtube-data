[{"type": "subtitle", "time": 11460.229, "timestamp": "03:11:00", "text": "来年の4月か何かに延期"}, {"type": "subtitle", "time": 11462.55, "timestamp": "03:11:02", "text": "年。"}, {"type": "subtitle", "time": 11465.189, "timestamp": "03:11:05", "text": "心配です。私がすべてをやったと想像してみてください"}, {"type": "subtitle", "time": 11469.11, "timestamp": "03:11:09", "text": "今このヨアトンと私は私は私は私は"}, {"type": "subtitle", "time": 11471.91, "timestamp": "03:11:11", "text": "まるで私が日本に行かないかのように言われた"}, {"type": "subtitle", "time": 11475.75, "timestamp": "03:11:15", "text": "今年の7月。私は行く、私は行くことしかできない"}, {"type": "subtitle", "time": 11480.229, "timestamp": "03:11:20", "text": "4月までにね、兄弟。"}, {"type": "subtitle", "time": 11484.229, "timestamp": "03:11:24", "text": "まあ、私も次にやっても構わないけどね。私は"}, {"type": "subtitle", "time": 11487.91, "timestamp": "03:11:27", "text": "えっと、私と何人かが"}, {"type": "subtitle", "time": 11489.67, "timestamp": "03:11:29", "text": "クラスメートは行くことになっている。だから彼らは"}, {"type": "subtitle", "time": 11494.07, "timestamp": "03:11:34", "text": "私たち全員にそこへ行くように電話がかかってきた"}, {"type": "subtitle", "time": 11497.349, "timestamp": "03:11:37", "text": "アカデミーに行って話してください"}, {"type": "subtitle", "time": 11501.189, "timestamp": "03:11:41", "text": "明日の朝のような人々と"}, {"type": "subtitle", "time": 11503.59, "timestamp": "03:11:43", "text": "ありがたいことに、私には誰もいなかった"}, {"type": "subtitle", "time": 11505.349, "timestamp": "03:11:45", "text": "明日の朝、そうでなければ私は"}, {"type": "subtitle", "time": 11508.87, "timestamp": "03:11:48", "text": "キャンセルせざるを得なかった。うん。いいえ、できません"}, {"type": "subtitle", "time": 11510.95, "timestamp": "03:11:50", "text": "彼らとの約束をキャンセルする。うん。うん。ゲストI"}, {"type": "subtitle", "time": 11514.389, "timestamp": "03:11:54", "text": "今すぐ日程を変更しなければなりません。だから、それは"}, {"type": "subtitle", "time": 11518.389, "timestamp": "03:11:58", "text": "もう9位ですよね？私は"}]
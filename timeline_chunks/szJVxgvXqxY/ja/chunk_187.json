[{"type": "subtitle", "time": 11222.469, "timestamp": "03:07:02", "text": "つまり、私がそうしても構わないと思う"}, {"type": "subtitle", "time": 11224.07, "timestamp": "03:07:04", "text": "数人くらいの人向けだけど、もし私がやったら"}, {"type": "subtitle", "time": 11226.229, "timestamp": "03:07:06", "text": "みんなにとって、ああ、私は"}, {"type": "subtitle", "time": 11236.71, "timestamp": "03:07:16", "text": "再装填中。私はここから出て行く。"}, {"type": "subtitle", "time": 11238.469, "timestamp": "03:07:18", "text": "もし彼らがいい人で、彼らが望むなら"}, {"type": "subtitle", "time": 11240.389, "timestamp": "03:07:20", "text": "友達になって、私は何人か会ったことがある、"}, {"type": "subtitle", "time": 11243.189, "timestamp": "03:07:23", "text": "知ってるよ、ここでドラグノスに会ったのは、えーと"}, {"type": "subtitle", "time": 11245.75, "timestamp": "03:07:25", "text": "ヴァレラント。最後に残ったプレイヤー。ああ、君"}, {"type": "subtitle", "time": 11248.71, "timestamp": "03:07:28", "text": "ヴァレラントはドラオスと会った。敵1人"}, {"type": "subtitle", "time": 11250.71, "timestamp": "03:07:30", "text": "残り。"}, {"type": "subtitle", "time": 11254.87, "timestamp": "03:07:34", "text": "ああ、それはいいですね。最後に残ったプレイヤー。"}, {"type": "subtitle", "time": 11272.389, "timestamp": "03:07:52", "text": "彼はプロのようにプレーする。"}]
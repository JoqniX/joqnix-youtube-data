[{"type": "subtitle", "time": 19741.35, "timestamp": "05:29:01", "text": "ここだったけど、それでも本当に楽しかった。感謝"}, {"type": "subtitle", "time": 19744.708, "timestamp": "05:29:04", "text": "ジャナさん、来てくれてありがとう、ジョブ・サッサン。そして私は"}, {"type": "subtitle", "time": 19748.548, "timestamp": "05:29:08", "text": "すごく疲れている感じがする。"}, {"type": "subtitle", "time": 19751.43, "timestamp": "05:29:11", "text": "突然現れた。えっと、もし私の"}, {"type": "subtitle", "time": 19754.788, "timestamp": "05:29:14", "text": "エネルギーは低かったが、それでも楽しかった"}, {"type": "subtitle", "time": 19758.548, "timestamp": "05:29:18", "text": "Basmophobiaをプレイするけど、でもジョブは"}, {"type": "subtitle", "time": 19761.27, "timestamp": "05:29:21", "text": "悲しい。彼女とマインクラフトをプレイしたいです"}, {"type": "subtitle", "time": 19764.15, "timestamp": "05:29:24", "text": "将来においても。もしそうだったら"}, {"type": "subtitle", "time": 19765.67, "timestamp": "05:29:25", "text": "マインクラフト、私は準備できたはず"}, {"type": "subtitle", "time": 19768.468, "timestamp": "05:29:28", "text": "サーバーとかそういうもの。私は予想していなかった"}, {"type": "subtitle", "time": 19770.23, "timestamp": "05:29:30", "text": "計画通りにはいかなかった。私たちは"}, {"type": "subtitle", "time": 19772.468, "timestamp": "05:29:32", "text": "おしゃべりしたり、一緒に過ごしたりしよう"}, {"type": "subtitle", "time": 19775.11, "timestamp": "05:29:35", "text": "外。そして私は気づいた、ああ、私たちは"}, {"type": "subtitle", "time": 19776.51, "timestamp": "05:29:36", "text": "理解した"}, {"type": "subtitle", "time": 19779.91, "timestamp": "05:29:39", "text": "ゲーム。だから、大丈夫だよ。将来は、"}, {"type": "subtitle", "time": 19783.35, "timestamp": "05:29:43", "text": "ジョーンともっと一緒に過ごすつもりだ。だから私たちは"}, {"type": "subtitle", "time": 19786.628, "timestamp": "05:29:46", "text": "マインクラフトをプレイしましょうか？"}, {"type": "subtitle", "time": 19788.83, "timestamp": "05:29:48", "text": "一緒に楽しんで、"}, {"type": "subtitle", "time": 19796.868, "timestamp": "05:29:56", "text": "ええ、それがジョーンでした。もしあなたが楽しんでいるなら"}, {"type": "subtitle", "time": 19799.59, "timestamp": "05:29:59", "text": "ジョブサンの会社です。お気軽にフォローしてください。"}]
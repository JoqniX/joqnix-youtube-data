[{"type": "subtitle", "time": 2400.83, "timestamp": "00:40:00", "text": "チャット。あれには本当にびっくりした。ああ、"}, {"type": "subtitle", "time": 2405.709, "timestamp": "00:40:05", "text": "神。ええ、私たちはそうしませんでした、私たちはそうしませんでした"}, {"type": "subtitle", "time": 2410.189, "timestamp": "00:40:10", "text": "わからない"}, {"type": "subtitle", "time": 2413.51, "timestamp": "00:40:13", "text": "ああ、一番上にあるものだ。素晴らしい"}, {"type": "subtitle", "time": 2425.149, "timestamp": "00:40:25", "text": "何が"}, {"type": "subtitle", "time": 2428.91, "timestamp": "00:40:28", "text": "これ？ディーグル"}, {"type": "subtitle", "time": 2430.91, "timestamp": "00:40:30", "text": "H. 注意してください。"}, {"type": "subtitle", "time": 2442.83, "timestamp": "00:40:42", "text": "どこに"}, {"type": "subtitle", "time": 2446.229, "timestamp": "00:40:46", "text": "みんなの？私は思う"}, {"type": "subtitle", "time": 2449.59, "timestamp": "00:40:49", "text": "私は上を目指さなければならない。えっと、これ"}, {"type": "subtitle", "time": 2451.109, "timestamp": "00:40:51", "text": "もの。"}, {"type": "subtitle", "time": 2453.99, "timestamp": "00:40:53", "text": "これは何ですか？何が"}, {"type": "subtitle", "time": 2456.149, "timestamp": "00:40:56", "text": "人々の声が聞こえる？わからない。作って"}]
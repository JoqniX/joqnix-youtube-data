[{"type": "subtitle", "time": 9120.309, "timestamp": "02:32:00", "text": "ああ、待たなければならない。 12でキャンヴィーヴ"}, {"type": "subtitle", "time": 9122.309, "timestamp": "02:32:02", "text": "秒。何てことだ。わかった、ちょっと待って。"}, {"type": "subtitle", "time": 9125.75, "timestamp": "02:32:05", "text": "ちょっと待って。ちょっと待って。"}, {"type": "subtitle", "time": 9128.79, "timestamp": "02:32:08", "text": "食べ物とか何かありますか？"}, {"type": "subtitle", "time": 9134.95, "timestamp": "02:32:14", "text": "ああ、なんてことだ、彼が私に向かって物を投げている。わかった、"}, {"type": "subtitle", "time": 9136.95, "timestamp": "02:32:16", "text": "ああ、それは"}, {"type": "subtitle", "time": 9138.71, "timestamp": "02:32:18", "text": "2番。よし、これでいい。はい、どうぞ。そこには"}, {"type": "chat", "time": 9139.257, "timestamp": "02:32:19", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "glad I am able to catch up and see azura"}, {"type": "subtitle", "time": 9140.95, "timestamp": "02:32:20", "text": "行くぞ。よし、肉を"}, {"type": "subtitle", "time": 9147.51, "timestamp": "02:32:27", "text": "よし、こいつを殺そう。持っていますか"}, {"type": "chat", "time": 9152.315, "timestamp": "02:32:32", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "just back from exams"}, {"type": "subtitle", "time": 9161.229, "timestamp": "02:32:41", "text": "そして彼は死んだ。ああ、なんてことだ、"}, {"type": "chat", "time": 9162.418, "timestamp": "02:32:42", "author": "@calx_nyx", "avatar": "https://yt4.ggpht.com/XFPadkBWV-wDHemIdJAJ0ZlOnQHzuQJq3X3CrTt0JO7prEc9g-uiFft4EJRfG-ZfPUNyuCkI=s64-c-k-c0x00ffffff-no-rj", "message": "bye azuraaa"}, {"type": "subtitle", "time": 9163.75, "timestamp": "02:32:43", "text": "ものすごく時間がかかった。"}, {"type": "subtitle", "time": 9165.75, "timestamp": "02:32:45", "text": "うん。"}, {"type": "subtitle", "time": 9170.79, "timestamp": "02:32:50", "text": "それは良い点ですね。"}, {"type": "subtitle", "time": 9174.309, "timestamp": "02:32:54", "text": "ニース。ニース。必要であれば、宝箱を開けてください。"}, {"type": "subtitle", "time": 9177.03, "timestamp": "02:32:57", "text": "スナイパー。スナイパーライフルを手に入れたので、チャンスは少ない"}]
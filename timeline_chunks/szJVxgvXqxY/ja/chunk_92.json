[{"type": "subtitle", "time": 5521.75, "timestamp": "01:32:01", "text": "ジョギングをする。だから楽しかったよ。本当に"}, {"type": "subtitle", "time": 5525.67, "timestamp": "01:32:05", "text": "楽しい。本当に楽しかった。うん。私たちは遊ぶ"}, {"type": "subtitle", "time": 5530.469, "timestamp": "01:32:10", "text": "また後で。 M 私たちはそうするべきだ、そうするべきだ"}, {"type": "subtitle", "time": 5532.63, "timestamp": "01:32:12", "text": "次に試合をする時は、おそらく"}, {"type": "subtitle", "time": 5535.27, "timestamp": "01:32:15", "text": "日本なので、私はGST時間帯にいます"}, {"type": "subtitle", "time": 5539.51, "timestamp": "01:32:19", "text": "それでも、君のために時間を作るよ。"}, {"type": "subtitle", "time": 5541.349, "timestamp": "01:32:21", "text": "わかった。"}, {"type": "subtitle", "time": 5545.11, "timestamp": "01:32:25", "text": "こんにちは。本日はありがとうございました。私は話します"}, {"type": "subtitle", "time": 5547.429, "timestamp": "01:32:27", "text": "今日はあなたへ。"}, {"type": "subtitle", "time": 5549.15, "timestamp": "01:32:29", "text": "うん。"}, {"type": "subtitle", "time": 5552.71, "timestamp": "01:32:32", "text": "こんにちは。私は電話を切ります。良い一日を"}, {"type": "subtitle", "time": 5555.309, "timestamp": "01:32:35", "text": "素晴らしい一日になりそうだ。すてきな一日を。あなた"}, {"type": "subtitle", "time": 5560.23, "timestamp": "01:32:40", "text": "あまりにも。あなたも。こんにちは。さよなら。さよなら。みんなが言う"}, {"type": "subtitle", "time": 5563.429, "timestamp": "01:32:43", "text": "さようなら"}, {"type": "subtitle", "time": 5576.469, "timestamp": "01:32:56", "text": "今。あれはアゾラ・リサだった。もしあなたが楽しんでいるなら"}, {"type": "subtitle", "time": 5579.99, "timestamp": "01:32:59", "text": "アゼルサイエンスカンパニーは今日、お気軽に"}]
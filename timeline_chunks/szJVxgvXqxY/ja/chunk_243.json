[{"type": "subtitle", "time": 14582.07, "timestamp": "04:03:02", "text": "貿易ルートと、もちろん"}, {"type": "subtitle", "time": 14584.07, "timestamp": "04:03:04", "text": "聖地地区とその建造物群。"}, {"type": "subtitle", "time": 14588.47, "timestamp": "04:03:08", "text": "市民の言動を調べて"}, {"type": "subtitle", "time": 14592.51, "timestamp": "04:03:12", "text": "情報源は、"}, {"type": "subtitle", "time": 14595.67, "timestamp": "04:03:15", "text": "文明って何？待って、文明って何？"}, {"type": "subtitle", "time": 14602.03, "timestamp": "04:03:22", "text": "えっと、どうやって"}, {"type": "subtitle", "time": 14606.09, "timestamp": "04:03:26", "text": "市民をどのように管理すればよいですか"}, {"type": "subtitle", "time": 14608.75, "timestamp": "04:03:28", "text": "[音楽]"}, {"type": "subtitle", "time": 14613.75, "timestamp": "04:03:33", "text": "えっと、これをどうやって制御すればいいの？"}, {"type": "subtitle", "time": 14616.788, "timestamp": "04:03:36", "text": "耕作して、もっと家を建てるのが好きです"}, {"type": "subtitle", "time": 14620.708, "timestamp": "04:03:40", "text": "私の民のために、この件について。ああ、ユニット"}, {"type": "subtitle", "time": 14623.19, "timestamp": "04:03:43", "text": "注文が必要です。ちょっと待って。私は"}, {"type": "subtitle", "time": 14625.47, "timestamp": "04:03:45", "text": "今のあなた。行け、行け、"}, {"type": "subtitle", "time": 14630.55, "timestamp": "04:03:50", "text": "行く。なぜあなたは止めたのですか？なぜ？"}, {"type": "subtitle", "time": 14634.23, "timestamp": "04:03:54", "text": "ああ、あの男。はい、彼は去りました。あなたが"}, {"type": "subtitle", "time": 14636.708, "timestamp": "04:03:56", "text": "採掘場所を見つけよう、さあ行こう。掘るのをやめろ。"}, {"type": "subtitle", "time": 14639.11, "timestamp": "04:03:59", "text": "自分が窮地に陥っていることに気づいたら、諦めなさい"}]
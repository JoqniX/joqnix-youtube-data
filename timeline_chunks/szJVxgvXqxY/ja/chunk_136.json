[{"type": "subtitle", "time": 8162.95, "timestamp": "02:16:02", "text": "今まさにスポーンしているところ？何？何？どうやって？"}, {"type": "subtitle", "time": 8167.349, "timestamp": "02:16:07", "text": "まだ出現するべきではない。何てことだ。"}, {"type": "subtitle", "time": 8190.15, "timestamp": "02:16:30", "text": "私たちはまだ作り方を知りません"}, {"type": "subtitle", "time": 8208.389, "timestamp": "02:16:48", "text": "ああ、彼らに負けている。何てことだ。私"}, {"type": "subtitle", "time": 8209.51, "timestamp": "02:16:49", "text": "何も行動を起こさなかった。私はしなかった"}, {"type": "subtitle", "time": 8211.19, "timestamp": "02:16:51", "text": "何でも。ああ、彼らに負けている。わかった、"}, {"type": "subtitle", "time": 8213.19, "timestamp": "02:16:53", "text": "逃げなければならない。"}]
[{"type": "subtitle", "time": 13260.15, "timestamp": "03:41:00", "text": "今すぐプレイ。"}, {"type": "subtitle", "time": 13262.67, "timestamp": "03:41:02", "text": "地下での生命の最初の兆候から"}, {"type": "subtitle", "time": 13265.75, "timestamp": "03:41:05", "text": "フー族の巨大な獣たちに水を与える"}, {"type": "subtitle", "time": 13269.99, "timestamp": "03:41:09", "text": "このサムリア帝国の最初の直立歩行"}, {"type": "subtitle", "time": 13273.47, "timestamp": "03:41:13", "text": "あなたはここまでよく頑張ってきました。今"}, {"type": "subtitle", "time": 13277.23, "timestamp": "03:41:17", "text": "ギルガメシュは、"}, {"type": "subtitle", "time": 13280.39, "timestamp": "03:41:20", "text": "文明は星々へと向かう。"}, {"type": "subtitle", "time": 13282.39, "timestamp": "03:41:22", "text": "あなたの肩には大きな責任がのしかかっています。王"}, {"type": "subtitle", "time": 13285.07, "timestamp": "03:41:25", "text": "ギルガメシュ。ギルガメシュ王。あなた自身の"}, {"type": "subtitle", "time": 13288.31, "timestamp": "03:41:28", "text": "世界中の人々や多くの人々が"}, {"type": "subtitle", "time": 13290.55, "timestamp": "03:41:30", "text": "リーダーであるあなた、"}, {"type": "subtitle", "time": 13293.11, "timestamp": "03:41:33", "text": "しかし、あなたは単なる人間以上の存在です。そして"}, {"type": "subtitle", "time": 13295.27, "timestamp": "03:41:35", "text": "世界の重みが"}, {"type": "subtitle", "time": 13297.59, "timestamp": "03:41:37", "text": "ガイ・フェローの言葉を借りれば、あなたはwになる。"}, {"type": "subtitle", "time": 13300.39, "timestamp": "03:41:40", "text": "人々を励ます、これは戦いだ"}, {"type": "subtitle", "time": 13303.75, "timestamp": "03:41:43", "text": "歯のあるロイヤルを選び、必ず"}, {"type": "subtitle", "time": 13305.99, "timestamp": "03:41:45", "text": "あなたの同盟者たち。待って。えっと、それはちょっと"}, {"type": "subtitle", "time": 13308.67, "timestamp": "03:41:48", "text": "うるさい。下げてみます"}, {"type": "subtitle", "time": 13316.11, "timestamp": "03:41:56", "text": "H. 何が起こったのですか？"}]
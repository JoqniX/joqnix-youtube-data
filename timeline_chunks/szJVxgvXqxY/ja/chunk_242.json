[{"type": "subtitle", "time": 14523.27, "timestamp": "04:02:03", "text": "貿易。はぁ？ええ、戦争に参加しました。待って、"}, {"type": "subtitle", "time": 14526.75, "timestamp": "04:02:06", "text": "標的に対する共同戦争を確立する"}, {"type": "subtitle", "time": 14529.11, "timestamp": "04:02:09", "text": "文明。トレーダーはトレーダーを獲得するだろう。"}, {"type": "subtitle", "time": 14531.51, "timestamp": "04:02:11", "text": "よし、外国貿易業者で行こう。"}, {"type": "subtitle", "time": 14533.55, "timestamp": "04:02:13", "text": "制作を選びましょう"}, {"type": "subtitle", "time": 14537.31, "timestamp": "04:02:17", "text": "えっと、行きましょう"}, {"type": "subtitle", "time": 14540.39, "timestamp": "04:02:20", "text": "だからもっと都市とかが必要だ、"}, {"type": "subtitle", "time": 14543.31, "timestamp": "04:02:23", "text": "右？それでは、"}, {"type": "subtitle", "time": 14551.15, "timestamp": "04:02:31", "text": "ここ。"}, {"type": "subtitle", "time": 14556.31, "timestamp": "04:02:36", "text": "えっと、次の方どうぞ。この男を解放してやれ。"}, {"type": "subtitle", "time": 14558.628, "timestamp": "04:02:38", "text": "国民があなた方を信頼しているのと同じように"}, {"type": "subtitle", "time": 14560.628, "timestamp": "04:02:40", "text": "リーダーシップなので、彼らは"}, {"type": "subtitle", "time": 14562.23, "timestamp": "04:02:42", "text": "より高次の存在を信じなさい。私は思う"}, {"type": "subtitle", "time": 14565.47, "timestamp": "04:02:45", "text": "この新しい方法を育むために彼の声"}, {"type": "subtitle", "time": 14567.75, "timestamp": "04:02:47", "text": "何かメリットがあると思う、"}, {"type": "subtitle", "time": 14570.31, "timestamp": "04:02:50", "text": "もっと詳しく教えてください。信仰は通貨である"}, {"type": "subtitle", "time": 14572.948, "timestamp": "04:02:52", "text": "宗教はヴァンドから得ることができる"}, {"type": "subtitle", "time": 14575.91, "timestamp": "04:02:55", "text": "驚異、政策、指導者の能力、"}, {"type": "subtitle", "time": 14578.708, "timestamp": "04:02:58", "text": "自然の驚異、都市国家、信仰、"}]
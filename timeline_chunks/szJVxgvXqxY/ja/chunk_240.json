[{"type": "subtitle", "time": 14402.39, "timestamp": "04:00:02", "text": "通常料金の25％。都市は"}, {"type": "subtitle", "time": 14405.67, "timestamp": "04:00:05", "text": "5人以上の市民に成長する"}, {"type": "subtitle", "time": 14408.31, "timestamp": "04:00:08", "text": "住宅制限。このペースだと、"}, {"type": "subtitle", "time": 14410.03, "timestamp": "04:00:10", "text": "そして成長を止める"}, {"type": "subtitle", "time": 14412.948, "timestamp": "04:00:12", "text": "全体的に。都市は停滞し、"}, {"type": "subtitle", "time": 14415.91, "timestamp": "04:00:15", "text": "余剰がない場合は成長させる"}, {"type": "subtitle", "time": 14418.15, "timestamp": "04:00:18", "text": "えっと、食べ物。作るなら作るよ"}, {"type": "subtitle", "time": 14420.47, "timestamp": "04:00:20", "text": "そうすれば食料も少なくて済む。わかった。なんとなくわかる。"}, {"type": "subtitle", "time": 14423.19, "timestamp": "04:00:23", "text": "よく分からない。何てことだ。そしてこれ"}, {"type": "subtitle", "time": 14426.47, "timestamp": "04:00:26", "text": "レベル2です。二人います。いいえ。"}, {"type": "subtitle", "time": 14428.03, "timestamp": "04:00:28", "text": "幾つか"}, {"type": "subtitle", "time": 14431.39, "timestamp": "04:00:31", "text": "市民？わかった。わからない。"}, {"type": "subtitle", "time": 14434.75, "timestamp": "04:00:34", "text": "H. ハッチって誰？"}, {"type": "subtitle", "time": 14446.07, "timestamp": "04:00:46", "text": "次のターン。"}, {"type": "subtitle", "time": 14448.07, "timestamp": "04:00:48", "text": "そしてこれは私たちの新しい政策の一種です"}, {"type": "subtitle", "time": 14449.59, "timestamp": "04:00:49", "text": "政府は改善できる。そこには"}, {"type": "subtitle", "time": 14451.67, "timestamp": "04:00:51", "text": "政策政府。人々が待ち望んでいるもの"}, {"type": "subtitle", "time": 14454.15, "timestamp": "04:00:54", "text": "あなたの命令。"}, {"type": "subtitle", "time": 14456.708, "timestamp": "04:00:56", "text": "えっと、ポリシーはわかりました。私は必要としている 私は必要としている"}, {"type": "subtitle", "time": 14458.628, "timestamp": "04:00:58", "text": "都市の生産量を増やしながら"}]
[{"type": "subtitle", "time": 11520.87, "timestamp": "03:12:00", "text": "6月10日、私は彼らが手に入れる"}, {"type": "subtitle", "time": 11524.469, "timestamp": "03:12:04", "text": "COE（使用権証明書）は手元にあります。"}, {"type": "subtitle", "time": 11525.99, "timestamp": "03:12:05", "text": "再装填中。"}, {"type": "subtitle", "time": 11530.03, "timestamp": "03:12:10", "text": "CO は証明書のようなものです"}, {"type": "subtitle", "time": 11533.67, "timestamp": "03:12:13", "text": "アカデミーからの入学。いいえ。"}, {"type": "subtitle", "time": 11536.469, "timestamp": "03:12:16", "text": "ああ、日本からですね。"}, {"type": "subtitle", "time": 11538.389, "timestamp": "03:12:18", "text": "あなたはそこに勉強しに行くのですか？"}, {"type": "subtitle", "time": 11540.71, "timestamp": "03:12:20", "text": "勉強？うん、勉強。何に行くの？"}, {"type": "subtitle", "time": 11542.63, "timestamp": "03:12:22", "text": "勉強するために？どのような？私は勉強します"}, {"type": "subtitle", "time": 11545.99, "timestamp": "03:12:25", "text": "当時は日本人だった。ええ、初めての学習です"}, {"type": "subtitle", "time": 11547.99, "timestamp": "03:12:27", "text": "言語を学ぶ。学んだ後"}, {"type": "subtitle", "time": 11549.99, "timestamp": "03:12:29", "text": "その言語であれば、私は申請できます"}, {"type": "subtitle", "time": 11552.389, "timestamp": "03:12:32", "text": "仕事とか、そういうことですよね？だって、君にはこんなのが必要なんだ"}, {"type": "subtitle", "time": 11555.189, "timestamp": "03:12:35", "text": "流暢さのレベル、"}, {"type": "subtitle", "time": 11557.83, "timestamp": "03:12:37", "text": "すべて、ですよね？私は手に入れる必要がある"}, {"type": "subtitle", "time": 11561.07, "timestamp": "03:12:41", "text": "N2レベルが最も低い順に"}, {"type": "subtitle", "time": 11563.16, "timestamp": "03:12:43", "text": "に おい、あそこでめちゃくちゃフェイントされたよ。とにかく、"}, {"type": "subtitle", "time": 11566.96, "timestamp": "03:12:46", "text": "おい、あそこでめちゃくちゃフェイントされたよ。とにかく、 続く。ええ、レベルN2が必要です"}, {"type": "subtitle", "time": 11571.04, "timestamp": "03:12:51", "text": "続く。ええ、レベルN2が必要です 少なくとも、えっと"}, {"type": "subtitle", "time": 11574.479, "timestamp": "03:12:54", "text": "少なくとも、えっと 少なくとも好きになる"}, {"type": "subtitle", "time": 11577.68, "timestamp": "03:12:57", "text": "少なくとも好きになる 敵はあと一体残っている。求人に応募する。えっと"}]
[{"type": "subtitle", "time": 12781.149, "timestamp": "03:33:01", "text": "えっと、ちょっと痛いんだけど"}, {"type": "subtitle", "time": 12785.67, "timestamp": "03:33:05", "text": "モード。最近、私のDiscordを投稿しました"}, {"type": "subtitle", "time": 12787.83, "timestamp": "03:33:07", "text": "開かない"}, {"type": "subtitle", "time": 12791.59, "timestamp": "03:33:11", "text": "えっと、このコードはウェブのように開きません"}, {"type": "subtitle", "time": 12795.189, "timestamp": "03:33:15", "text": "ブラウザはウェブリンクなどが好きなので、"}, {"type": "subtitle", "time": 12797.67, "timestamp": "03:33:17", "text": "コピーして貼り付けたりする必要がある"}, {"type": "subtitle", "time": 12799.39, "timestamp": "03:33:19", "text": "私は何て思ったんだろう"}, {"type": "subtitle", "time": 12801.39, "timestamp": "03:33:21", "text": "n は何ですか"}, {"type": "subtitle", "time": 12805.349, "timestamp": "03:33:25", "text": "このコル"}, {"type": "subtitle", "time": 12809.23, "timestamp": "03:33:29", "text": "デフォルトでは何も開きません"}, {"type": "subtitle", "time": 12811.23, "timestamp": "03:33:31", "text": "O"}, {"type": "subtitle", "time": 12815.83, "timestamp": "03:33:35", "text": "いいえ。私は今、痛みを感じている状況にいます"}, {"type": "subtitle", "time": 12817.709, "timestamp": "03:33:37", "text": "今？ああ、"}, {"type": "subtitle", "time": 12830.67, "timestamp": "03:33:50", "text": "[音楽]"}]
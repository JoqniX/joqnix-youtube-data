[{"type": "subtitle", "time": 2345.79, "timestamp": "00:39:05", "text": "安全。ああ、ここはカフェテリアですか？おお、"}, {"type": "subtitle", "time": 2349.83, "timestamp": "00:39:09", "text": "ニース。ああ、胸は一番上にあるよ。"}, {"type": "subtitle", "time": 2351.4, "timestamp": "00:39:11", "text": "よし、レベル"}, {"type": "subtitle", "time": 2353.149, "timestamp": "00:39:13", "text": "[音楽]"}, {"type": "subtitle", "time": 2357.669, "timestamp": "00:39:17", "text": "二。ああ、君はもう鎧を持っているんだね。ニース。"}, {"type": "subtitle", "time": 2365.43, "timestamp": "00:39:25", "text": "ああ、私たちは見ていません。"}, {"type": "subtitle", "time": 2368.47, "timestamp": "00:39:28", "text": "出かけよう。"}, {"type": "subtitle", "time": 2372.07, "timestamp": "00:39:32", "text": "何てことだ。私たちはこれを見ていません。"}, {"type": "subtitle", "time": 2374.47, "timestamp": "00:39:34", "text": "おお。えっと、待って。いや、いや。わからない"}, {"type": "subtitle", "time": 2377.27, "timestamp": "00:39:37", "text": "それは良い考えですね。"}, {"type": "subtitle", "time": 2379.99, "timestamp": "00:39:39", "text": "うん。うん。何てことだ。"}, {"type": "subtitle", "time": 2382.47, "timestamp": "00:39:42", "text": "さあ行こう。"}, {"type": "subtitle", "time": 2384.55, "timestamp": "00:39:44", "text": "ここでボールを打ってみて。"}, {"type": "subtitle", "time": 2388.109, "timestamp": "00:39:48", "text": "はい、いただきます。"}, {"type": "subtitle", "time": 2392.149, "timestamp": "00:39:52", "text": "わかった。よし、そろそろ回復に取り掛かろう。"}]
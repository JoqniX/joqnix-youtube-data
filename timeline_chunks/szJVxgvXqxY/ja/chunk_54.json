[{"type": "subtitle", "time": 3240.189, "timestamp": "00:54:00", "text": "彼を殺せ。殺す"}, {"type": "subtitle", "time": 3249.75, "timestamp": "00:54:09", "text": "オフ。気をつけて。"}, {"type": "subtitle", "time": 3268.99, "timestamp": "00:54:28", "text": "感謝"}, {"type": "subtitle", "time": 3272.27, "timestamp": "00:54:32", "text": "あなた。人々がいる"}, {"type": "subtitle", "time": 3274.589, "timestamp": "00:54:34", "text": "来るよ。全て"}, {"type": "subtitle", "time": 3284.79, "timestamp": "00:54:44", "text": "脳。その通りです。うん。うん。"}, {"type": "subtitle", "time": 3287.75, "timestamp": "00:54:47", "text": "ここにはなかなか良い戦利品があったよ。"}, {"type": "subtitle", "time": 3296.629, "timestamp": "00:54:56", "text": "なぜなら、私は今まで鎧を持っていなかったことに今気づいたからだ。"}, {"type": "subtitle", "time": 3297.57, "timestamp": "00:54:57", "text": "少し分けてください"}, {"type": "subtitle", "time": 3299.47, "timestamp": "00:54:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 17401.51, "timestamp": "04:50:01", "text": "待って、あれは何？ああ、それはすごい"}, {"type": "subtitle", "time": 17404.39, "timestamp": "04:50:04", "text": "それ以外。おっと。"}, {"type": "subtitle", "time": 17409.59, "timestamp": "04:50:09", "text": "おっと。わかった。えっと、作戦はありません。えっと、違います"}, {"type": "subtitle", "time": 17413.43, "timestamp": "04:50:13", "text": "凍りつく。なんてこった。"}, {"type": "subtitle", "time": 17416.07, "timestamp": "04:50:16", "text": "うん。これにより。"}, {"type": "subtitle", "time": 17420.788, "timestamp": "04:50:20", "text": "はい、MFi認証だけで結構です。わかった。えっと、"}, {"type": "subtitle", "time": 17423.67, "timestamp": "04:50:23", "text": "待って。あの点々は何だったのですか？削除できますか？"}, {"type": "subtitle", "time": 17427.91, "timestamp": "04:50:27", "text": "そうねぇ。ああ、これが点線ですね。わかった、"}, {"type": "subtitle", "time": 17430.868, "timestamp": "04:50:30", "text": "そこに点がある。では、これは一体何でしょうか？"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "えっと、この灰色の、えっと、こっちにあるやつ？グレー"}, {"type": "subtitle", "time": 17438.31, "timestamp": "04:50:38", "text": "箱。えっと、これはモーションセンサーです。おお、"}, {"type": "subtitle", "time": 17440.788, "timestamp": "04:50:40", "text": "わかった。わかった。うん。幽霊を検知する"}, {"type": "subtitle", "time": 17442.75, "timestamp": "04:50:42", "text": "面前。"}, {"type": "subtitle", "time": 17446.03, "timestamp": "04:50:46", "text": "こんにちは。こんにちは。"}, {"type": "subtitle", "time": 17447.548, "timestamp": "04:50:47", "text": "えっと"}, {"type": "subtitle", "time": 17450.43, "timestamp": "04:50:50", "text": "交流"}, {"type": "subtitle", "time": 17455.35, "timestamp": "04:50:55", "text": "木。大丈夫だと思うよ。待って、"}]
[{"type": "subtitle", "time": 9810.229, "timestamp": "02:43:30", "text": "試してみて、私はあなたが試すべきだと思う"}, {"type": "subtitle", "time": 9813.51, "timestamp": "02:43:33", "text": "チャレンジみたいなもの。"}, {"type": "subtitle", "time": 9815.51, "timestamp": "02:43:35", "text": "戦闘開始。戦闘開始。うん、"}, {"type": "subtitle", "time": 9819.269, "timestamp": "02:43:39", "text": "いくつかのアイテムが手に入ります。"}, {"type": "subtitle", "time": 9823.59, "timestamp": "02:43:43", "text": "難しいですか、それとも"}, {"type": "subtitle", "time": 9826.07, "timestamp": "02:43:46", "text": "えーと、3匹のモブと3匹の犬が"}, {"type": "subtitle", "time": 9827.75, "timestamp": "02:43:47", "text": "スポーン。奴らを殺せばいいだけだ。おお、"}, {"type": "subtitle", "time": 9830.51, "timestamp": "02:43:50", "text": "これなら簡単だ。"}, {"type": "subtitle", "time": 9833.75, "timestamp": "02:43:53", "text": "ああ、爆発したか何かだった"}, {"type": "subtitle", "time": 9835.07, "timestamp": "02:43:55", "text": "伝説的"}, {"type": "subtitle", "time": 9838.59, "timestamp": "02:43:58", "text": "アイテムであり、簡単に"}]
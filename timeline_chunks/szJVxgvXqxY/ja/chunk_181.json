[{"type": "subtitle", "time": 10863.03, "timestamp": "03:01:03", "text": "今、みんなが私に電話をかけてきてるんだけど"}, {"type": "subtitle", "time": 10865.67, "timestamp": "03:01:05", "text": "明日、"}, {"type": "subtitle", "time": 10867.309, "timestamp": "03:01:07", "text": "アカデミー。毎"}, {"type": "subtitle", "time": 10869.99, "timestamp": "03:01:09", "text": "クラスメートが文字通り私に電話をかけている"}, {"type": "subtitle", "time": 10872.87, "timestamp": "03:01:12", "text": "「なあ、なんで俺はVP VIPなんだ？」"}, {"type": "subtitle", "time": 10878.309, "timestamp": "03:01:18", "text": "みんなあなたと話すのが好きで、"}, {"type": "subtitle", "time": 10897.51, "timestamp": "03:01:37", "text": "おお。おお。我々はどのように負けているのか？"}, {"type": "subtitle", "time": 10904.309, "timestamp": "03:01:44", "text": "4対5みたいなもんだよ、兄弟。もしそれが"}, {"type": "subtitle", "time": 10907.349, "timestamp": "03:01:47", "text": "4対5なら、勝てたと思う。"}, {"type": "subtitle", "time": 10913.11, "timestamp": "03:01:53", "text": "何てことだ。冗談はもう終わりだ。お前は死んだ。"}, {"type": "subtitle", "time": 10915.67, "timestamp": "03:01:55", "text": "何？"}, {"type": "subtitle", "time": 10918.55, "timestamp": "03:01:58", "text": "ああ、スポーン直後にひどい目に遭ってる。"}]
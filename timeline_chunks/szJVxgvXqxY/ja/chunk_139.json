[{"type": "subtitle", "time": 8345.51, "timestamp": "02:19:05", "text": "いくらですか、それを使って"}, {"type": "subtitle", "time": 8354.79, "timestamp": "02:19:14", "text": "わかった。牛乳。わからない。それは何ですか"}, {"type": "subtitle", "time": 8356.269, "timestamp": "02:19:16", "text": "する？強い"}, {"type": "subtitle", "time": 8360.389, "timestamp": "02:19:20", "text": "骨。何？ああ、そうだね。そこには"}, {"type": "subtitle", "time": 8363.269, "timestamp": "02:19:23", "text": "クリティカルチャンス。タブをクリックすると、"}, {"type": "subtitle", "time": 8365.03, "timestamp": "02:19:25", "text": "現時点では10％の確率です。"}, {"type": "subtitle", "time": 8366.71, "timestamp": "02:19:26", "text": "おそらく、"}, {"type": "subtitle", "time": 8385.75, "timestamp": "02:19:45", "text": "ああ、空腹ゲージは苦痛だ。"}, {"type": "subtitle", "time": 8387.75, "timestamp": "02:19:47", "text": "そして、どうすれば良くなるのか私には理解できません"}, {"type": "subtitle", "time": 8396.11, "timestamp": "02:19:56", "text": "木材はありますか？"}, {"type": "subtitle", "time": 8399.59, "timestamp": "02:19:59", "text": "私は持っています。ああ、気にしないでください。ログを取得しました"}]
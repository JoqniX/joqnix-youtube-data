[{"type": "subtitle", "time": 11290.469, "timestamp": "03:08:10", "text": "よし、それでは実際に電話会議に参加させてください"}, {"type": "subtitle", "time": 11292.71, "timestamp": "03:08:12", "text": "素早い。"}, {"type": "subtitle", "time": 11294.389, "timestamp": "03:08:14", "text": "すぐに電話に出ます。 1つ"}, {"type": "subtitle", "time": 11319.75, "timestamp": "03:08:39", "text": "私は起きる。"}, {"type": "subtitle", "time": 11330.95, "timestamp": "03:08:50", "text": "どけ。"}, {"type": "subtitle", "time": 11333.91, "timestamp": "03:08:53", "text": "ああ、俺はこのゲームが下手すぎる。最後"}]
[{"type": "subtitle", "time": 4863.349, "timestamp": "01:21:03", "text": "わかった。彼らは私たちを捕まえに来た。彼らは知っていた。あまりにも"}, {"type": "subtitle", "time": 4866.71, "timestamp": "01:21:06", "text": "静けさ。豆はどこへ行ったの？それは"}, {"type": "subtitle", "time": 4868.64, "timestamp": "01:21:08", "text": "全て。"}, {"type": "subtitle", "time": 4877.83, "timestamp": "01:21:17", "text": "ええと、見てみましょう。ランク制度のようなものはありますか？"}, {"type": "subtitle", "time": 4881.03, "timestamp": "01:21:21", "text": "そうそう。うん。もっと回転させるように"}, {"type": "subtitle", "time": 4885.349, "timestamp": "01:21:25", "text": "コード。いいえ、階級はありません。それは"}, {"type": "subtitle", "time": 4887.99, "timestamp": "01:21:27", "text": "どちらがより大きく回転していますか？"}, {"type": "subtitle", "time": 4890.71, "timestamp": "01:21:30", "text": "それは何ですか？とはいえ、1つ進むことができます"}, {"type": "subtitle", "time": 4892.55, "timestamp": "01:21:32", "text": "最後の試合だ、だって3試合目になるんだから。"}, {"type": "subtitle", "time": 4895.51, "timestamp": "01:21:35", "text": "次のゲストは、この後登場します。"}, {"type": "subtitle", "time": 4898.469, "timestamp": "01:21:38", "text": "わかった。それともただ話したいだけですか？"}, {"type": "subtitle", "time": 4900.71, "timestamp": "01:21:40", "text": "少しの間？残り時間は10分です"}, {"type": "subtitle", "time": 4902.63, "timestamp": "01:21:42", "text": "今。"}, {"type": "subtitle", "time": 4905.03, "timestamp": "01:21:45", "text": "ええと、1ゲームだけならできると思います。うん。"}, {"type": "subtitle", "time": 4908.5, "timestamp": "01:21:48", "text": "ああ、もう1試合やろう。うん。"}, {"type": "subtitle", "time": 4910.99, "timestamp": "01:21:50", "text": "[音楽]"}]
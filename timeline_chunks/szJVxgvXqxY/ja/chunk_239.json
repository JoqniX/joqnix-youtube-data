[{"type": "subtitle", "time": 14342.15, "timestamp": "03:59:02", "text": "秒戻ってくる。しかし、私たちは富を得ることができる"}, {"type": "subtitle", "time": 14346.39, "timestamp": "03:59:06", "text": "研究資料。だから、次に私が望むのは"}, {"type": "subtitle", "time": 14348.948, "timestamp": "03:59:08", "text": "採掘する、なぜなら私は物を採掘する必要があるから"}, {"type": "subtitle", "time": 14351.55, "timestamp": "03:59:11", "text": "お金を稼ぐ必要がある、"}, {"type": "subtitle", "time": 14354.23, "timestamp": "03:59:14", "text": "右？ああ、この男、このレンジャーたちは"}, {"type": "subtitle", "time": 14357.788, "timestamp": "03:59:17", "text": "ここ。市は引き続き繁栄している。"}, {"type": "subtitle", "time": 14361.99, "timestamp": "03:59:21", "text": "ノックすれば、人口は増える。教えて"}, {"type": "subtitle", "time": 14365.19, "timestamp": "03:59:25", "text": "もっと。あなたの街は成長し、さらに増えていくでしょう"}, {"type": "subtitle", "time": 14367.59, "timestamp": "03:59:27", "text": "余剰食料を持つ市民と"}, {"type": "subtitle", "time": 14369.51, "timestamp": "03:59:29", "text": "人気のある食品の量"}, {"type": "subtitle", "time": 14372.07, "timestamp": "03:59:32", "text": "都市住民の消費量。"}, {"type": "subtitle", "time": 14374.948, "timestamp": "03:59:34", "text": "Tuperは余剰とみなされ、追加されます"}, {"type": "subtitle", "time": 14378.31, "timestamp": "03:59:38", "text": "新しい市民への進歩として。 A"}, {"type": "subtitle", "time": 14381.75, "timestamp": "03:59:41", "text": "市は余剰食料をその成長に組み入れる"}, {"type": "subtitle", "time": 14385.11, "timestamp": "03:59:45", "text": "現在の個体数が2以上"}, {"type": "subtitle", "time": 14387.67, "timestamp": "03:59:47", "text": "市の住宅制限区域内。もし"}, {"type": "subtitle", "time": 14389.91, "timestamp": "03:59:49", "text": "都市は1つで、人口は"}, {"type": "subtitle", "time": 14392.99, "timestamp": "03:59:52", "text": "住宅供給の限界により、成長は鈍化するだろう"}, {"type": "subtitle", "time": 14396.55, "timestamp": "03:59:56", "text": "50％。人口が設定されるとき"}, {"type": "subtitle", "time": 14399.07, "timestamp": "03:59:59", "text": "住宅制限は、"}]
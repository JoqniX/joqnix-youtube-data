[{"type": "subtitle", "time": 16986.548, "timestamp": "04:43:06", "text": "わかった。タングルウッド。それでは行きましょう。私たちは"}, {"type": "subtitle", "time": 16988.23, "timestamp": "04:43:08", "text": "その物を持っていく？私は理解できません"}, {"type": "subtitle", "time": 16998.47, "timestamp": "04:43:18", "text": "始める。私たち二人だけですよね？うん。私たちだけ"}, {"type": "subtitle", "time": 17002.15, "timestamp": "04:43:22", "text": "二。わかった。わかった。最善を尽くしましょう"}, {"type": "subtitle", "time": 17010.948, "timestamp": "04:43:30", "text": "こんにちは。何てことだ。荷物を満載しました"}, {"type": "subtitle", "time": 17020.47, "timestamp": "04:43:40", "text": "あなたの？おお。はい。おお。"}, {"type": "subtitle", "time": 17023.59, "timestamp": "04:43:43", "text": "わあ、たくさんプレイしたんですね。何てことだ。どうやって"}, {"type": "subtitle", "time": 17026.03, "timestamp": "04:43:46", "text": "あなたはいくらお金を持っていましたか？ああ、"}, {"type": "subtitle", "time": 17033.11, "timestamp": "04:43:53", "text": "これ"}, {"type": "subtitle", "time": 17036.15, "timestamp": "04:43:56", "text": "私はこのゲームを数時間プレイしました"}]
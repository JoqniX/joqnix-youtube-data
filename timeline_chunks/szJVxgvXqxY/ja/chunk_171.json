[{"type": "subtitle", "time": 10284.55, "timestamp": "02:51:24", "text": "あなたの一番好きなゲームは何ですか？"}, {"type": "subtitle", "time": 10287.79, "timestamp": "02:51:27", "text": "私のお気に入りのゲームは"}, {"type": "subtitle", "time": 10292.309, "timestamp": "02:51:32", "text": "マインクラフトって言うのかな？"}, {"type": "subtitle", "time": 10295.11, "timestamp": "02:51:35", "text": "えっと、他のお気に入りも手に入れるよ"}, {"type": "subtitle", "time": 10298.229, "timestamp": "02:51:38", "text": "ゲームの合間には、"}, {"type": "subtitle", "time": 10305.349, "timestamp": "02:51:45", "text": "どれくらいプレイしていますか？"}, {"type": "subtitle", "time": 10310.67, "timestamp": "02:51:50", "text": "マインクラフト？私が"}, {"type": "subtitle", "time": 10314.55, "timestamp": "02:51:54", "text": "小学4年生を想像してみてください。えっと、どれくらい前のことだったかな"}, {"type": "subtitle", "time": 10318.229, "timestamp": "02:51:58", "text": "それ？ああ、くそ。それは何年も前のことです。"}]
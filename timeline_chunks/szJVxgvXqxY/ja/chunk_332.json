[{"type": "subtitle", "time": 19921.708, "timestamp": "05:32:01", "text": "ええと、ちょっと心配しているのですが"}, {"type": "subtitle", "time": 19925.59, "timestamp": "05:32:05", "text": "何か、クラスメートの一人が"}, {"type": "subtitle", "time": 19928.23, "timestamp": "05:32:08", "text": "同期生は"}, {"type": "subtitle", "time": 19930.548, "timestamp": "05:32:10", "text": "私と一緒に行くはずだった"}, {"type": "subtitle", "time": 19934.708, "timestamp": "05:32:14", "text": "来月は彼らにとって、彼らはこう言った"}, {"type": "subtitle", "time": 19937.91, "timestamp": "05:32:17", "text": "COEの発行が遅れているのは、"}, {"type": "subtitle", "time": 19942.39, "timestamp": "05:32:22", "text": "彼のために、そして彼らは7月までに行けない"}, {"type": "subtitle", "time": 19945.67, "timestamp": "05:32:25", "text": "彼らはそうなるだろう 彼はできるだろう"}, {"type": "subtitle", "time": 19948.868, "timestamp": "05:32:28", "text": "来年4月までに日本の学校へ行く"}, {"type": "subtitle", "time": 19953.43, "timestamp": "05:32:33", "text": "年。だから、ちょっと心配なんだけど"}, {"type": "subtitle", "time": 19956.23, "timestamp": "05:32:36", "text": "もしこれが全て無駄なことだったら"}, {"type": "subtitle", "time": 19958.548, "timestamp": "05:32:38", "text": "この時点で。まるで私が思ったように"}, {"type": "subtitle", "time": 19960.788, "timestamp": "05:32:40", "text": "7月入学を目指しています。だから私は"}, {"type": "subtitle", "time": 19964.15, "timestamp": "05:32:44", "text": "ジョックマラソンとかやったよ。元気です"}, {"type": "subtitle", "time": 19966.868, "timestamp": "05:32:46", "text": "ジョアトンをもう1年続ける"}, {"type": "subtitle", "time": 19969.43, "timestamp": "05:32:49", "text": "4月まで。私はそれで構いません。"}, {"type": "subtitle", "time": 19971.51, "timestamp": "05:32:51", "text": "また、ストリーミングできる日数が増えるほど、"}]
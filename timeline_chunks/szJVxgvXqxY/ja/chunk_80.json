[{"type": "subtitle", "time": 4802.07, "timestamp": "01:20:02", "text": "それは違う。争いが起きている"}, {"type": "subtitle", "time": 4827.19, "timestamp": "01:20:27", "text": "ああ、大変だ、壊れてしまった。大丈夫。"}, {"type": "subtitle", "time": 4828.11, "timestamp": "01:20:28", "text": "その"}, {"type": "subtitle", "time": 4830.95, "timestamp": "01:20:30", "text": "わかった。私はこちらへ行きます。おお、"}, {"type": "subtitle", "time": 4833.63, "timestamp": "01:20:33", "text": "彼らは今来る"}, {"type": "subtitle", "time": 4842.15, "timestamp": "01:20:42", "text": "治してください。治してください。治してください。私はここにいます。あなた"}, {"type": "chat", "time": 4849.899, "timestamp": "01:20:49", "author": "@natsukisouta", "avatar": "https://yt4.ggpht.com/DoWHfl2un-x9C1FjOZkls_H2TTeAipp9__JetXpYAJhuduFn6-Pn9_VXt5jORITV_b2weavr=s64-c-k-c0x00ffffff-no-rj", "message": "Peak."}, {"type": "subtitle", "time": 4853.07, "timestamp": "01:20:53", "text": "３、２、１。なんてこった。"}, {"type": "subtitle", "time": 4859.15, "timestamp": "01:20:59", "text": "いいえ。その"}]
[{"type": "subtitle", "time": 3780.39, "timestamp": "01:03:00", "text": "これは何ですか？ああ、レーザーがある。"}, {"type": "subtitle", "time": 3783.27, "timestamp": "01:03:03", "text": "バナナ。"}, {"type": "subtitle", "time": 3785.91, "timestamp": "01:03:05", "text": "よし、このバナナをもらおう。"}, {"type": "subtitle", "time": 3787.91, "timestamp": "01:03:07", "text": "ああ、床に埋め込むこともできますよ"}, {"type": "subtitle", "time": 3790.55, "timestamp": "01:03:10", "text": "そして、それらを逃がしてしまう。"}, {"type": "subtitle", "time": 3829.47, "timestamp": "01:03:49", "text": "丸。おお、"}, {"type": "subtitle", "time": 3831.31, "timestamp": "01:03:51", "text": "M16。"}, {"type": "subtitle", "time": 3836.109, "timestamp": "01:03:56", "text": "おお。ああ、弾薬は十分あるかな？わかった。"}]
[{"type": "subtitle", "time": 6269.83, "timestamp": "01:44:29", "text": "いいえ、このゲームは25ゴールドの宝箱を開けるように見えます。"}, {"type": "subtitle", "time": 6273.349, "timestamp": "01:44:33", "text": "でも、宝箱とかを開けることはできないよ。"}, {"type": "subtitle", "time": 6275.429, "timestamp": "01:44:35", "text": "私も開けられません。私は思う"}, {"type": "subtitle", "time": 6277.429, "timestamp": "01:44:37", "text": "それを壊すには、"}, {"type": "subtitle", "time": 6280.55, "timestamp": "01:44:40", "text": "つるはし、たぶん。ああ、そんなこと言わないで"}, {"type": "subtitle", "time": 6282.309, "timestamp": "01:44:42", "text": "このゲームはRustに似ている。手に入れなければならない"}, {"type": "subtitle", "time": 6284.11, "timestamp": "01:44:44", "text": "岩を掘って、それからそれを使う"}, {"type": "subtitle", "time": 6286.51, "timestamp": "01:44:46", "text": "壊す"}, {"type": "subtitle", "time": 6288.95, "timestamp": "01:44:48", "text": "あぁ、ああ。"}, {"type": "subtitle", "time": 6291.75, "timestamp": "01:44:51", "text": "それはRustです。"}, {"type": "subtitle", "time": 6293.59, "timestamp": "01:44:53", "text": "何てことだ。以前発売されたと思います"}, {"type": "subtitle", "time": 6296.87, "timestamp": "01:44:56", "text": "さび。そうだった。"}, {"type": "subtitle", "time": 6299.429, "timestamp": "01:44:59", "text": "それは2018年頃に公開された"}]
[{"type": "subtitle", "time": 6302.32, "timestamp": "01:45:02", "text": "2019年。"}, {"type": "subtitle", "time": 6304.87, "timestamp": "01:45:04", "text": "[音楽]"}, {"type": "subtitle", "time": 6315.349, "timestamp": "01:45:15", "text": "私の記憶では、少し難しい"}, {"type": "subtitle", "time": 6318.75, "timestamp": "01:45:18", "text": "実は夜が好きなんです。"}, {"type": "subtitle", "time": 6322.309, "timestamp": "01:45:22", "text": "ああ、ゾンビとか出てくるのかな？"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "うん、そう思う"}, {"type": "subtitle", "time": 6328.07, "timestamp": "01:45:28", "text": "まるでマインクラフトのサバイバルモードみたいだ。しなければならない"}, {"type": "subtitle", "time": 6332.349, "timestamp": "01:45:32", "text": "一つずつ組み立てていく。いいえ。えっと、"}, {"type": "subtitle", "time": 6335.75, "timestamp": "01:45:35", "text": "家に行って、それをやってください。こんにちは、ナティキ。いらっしゃいませ"}, {"type": "subtitle", "time": 6337.429, "timestamp": "01:45:37", "text": "で。"}, {"type": "subtitle", "time": 6343.99, "timestamp": "01:45:43", "text": "作業台を作りました。つまり"}, {"type": "subtitle", "time": 6346.55, "timestamp": "01:45:46", "text": "このゲームにおける作業台。"}, {"type": "subtitle", "time": 6357.99, "timestamp": "01:45:57", "text": "彼らはヤシの木を追いかけているんだろうね。なぜ"}]
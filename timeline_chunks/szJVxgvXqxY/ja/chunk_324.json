[{"type": "subtitle", "time": 19447.99, "timestamp": "05:24:07", "text": "稲妻。よし、行け、行け。走れ、走れ、走れ、"}, {"type": "subtitle", "time": 19450.07, "timestamp": "05:24:10", "text": "走れ、走れ、走れ。"}, {"type": "subtitle", "time": 19453.27, "timestamp": "05:24:13", "text": "走れ、走れ、走れ、走れ、走れ、走れ。"}, {"type": "subtitle", "time": 19455.948, "timestamp": "05:24:15", "text": "遅れている"}, {"type": "subtitle", "time": 19458.11, "timestamp": "05:24:18", "text": "自分。おお"}, {"type": "subtitle", "time": 19463.27, "timestamp": "05:24:23", "text": "神。何てことだ。何てことだ。はい、それで、えっと、私は"}, {"type": "subtitle", "time": 19467.35, "timestamp": "05:24:27", "text": "なるほど、悪魔は悪魔なんだな。"}, {"type": "subtitle", "time": 19471.91, "timestamp": "05:24:31", "text": "何てことだ。何度も"}, {"type": "subtitle", "time": 19477.19, "timestamp": "05:24:37", "text": "えっと、5でした。確認していません。"}, {"type": "subtitle", "time": 19479.19, "timestamp": "05:24:39", "text": "確認しましょうか？いいえ。"}, {"type": "subtitle", "time": 19482.03, "timestamp": "05:24:42", "text": "いや、いや、やめておいた方がいい。やめておいた方がいい。より良い"}, {"type": "subtitle", "time": 19484.91, "timestamp": "05:24:44", "text": "ない。でもあなたは"}, {"type": "subtitle", "time": 19486.91, "timestamp": "05:24:46", "text": "一人で。いいえ。"}, {"type": "subtitle", "time": 19490.548, "timestamp": "05:24:50", "text": "いいえ、いいえ、悪魔です。悪魔。悪魔。悪魔。行く。"}, {"type": "subtitle", "time": 19493.11, "timestamp": "05:24:53", "text": "悪魔はいましたか？右。わかった。うん。"}, {"type": "subtitle", "time": 19495.43, "timestamp": "05:24:55", "text": "悪魔。悪魔。悪魔。点々はありましたか？"}, {"type": "subtitle", "time": 19498.628, "timestamp": "05:24:58", "text": "投影？ドットがないと思います。"}]
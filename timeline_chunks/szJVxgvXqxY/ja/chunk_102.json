[{"type": "subtitle", "time": 6121.67, "timestamp": "01:42:01", "text": "良い。どういう意味ですか？\""}, {"type": "subtitle", "time": 6124.15, "timestamp": "01:42:04", "text": "おお。"}, {"type": "subtitle", "time": 6126.389, "timestamp": "01:42:06", "text": "それで、あなたの近況はいかがですか？"}, {"type": "subtitle", "time": 6129.51, "timestamp": "01:42:09", "text": "生活はどうですか？元気ですか？"}, {"type": "subtitle", "time": 6132.71, "timestamp": "01:42:12", "text": "人生は厳しい。私には仕事がある。私はしなければならない"}, {"type": "subtitle", "time": 6135.91, "timestamp": "01:42:15", "text": "私はAI開発者です。だから、私は"}, {"type": "subtitle", "time": 6138.55, "timestamp": "01:42:18", "text": "ああ、痛いよ。難しい"}, {"type": "subtitle", "time": 6142.469, "timestamp": "01:42:22", "text": "する。プログラミングは難しい。いいえ。ええ、そうです"}, {"type": "subtitle", "time": 6145.349, "timestamp": "01:42:25", "text": "痛み。たくさんのこと。"}, {"type": "subtitle", "time": 6146.95, "timestamp": "01:42:26", "text": "うん。そして同時に、私は"}, {"type": "subtitle", "time": 6148.95, "timestamp": "01:42:28", "text": "カレッジ。つまり、私は休暇中ですよね"}, {"type": "subtitle", "time": 6150.95, "timestamp": "01:42:30", "text": "今は少し良くなりました。だから私は"}, {"type": "subtitle", "time": 6153.03, "timestamp": "01:42:33", "text": "大学、そしてストリーミングとして"}, {"type": "subtitle", "time": 6156.71, "timestamp": "01:42:36", "text": "良い。最近ちょっとバタバタしていて、"}, {"type": "subtitle", "time": 6160.15, "timestamp": "01:42:40", "text": "でも大丈夫。対処できます。うん、"}, {"type": "subtitle", "time": 6161.63, "timestamp": "01:42:41", "text": "それは"}, {"type": "subtitle", "time": 6163.95, "timestamp": "01:42:43", "text": "ニース。それで、"}, {"type": "subtitle", "time": 6167.11, "timestamp": "01:42:47", "text": "終わり。では、今日は、えーと"}, {"type": "subtitle", "time": 6169.429, "timestamp": "01:42:49", "text": "マカライの試合。私はこれをプレイしたことがない"}, {"type": "subtitle", "time": 6172.23, "timestamp": "01:42:52", "text": "前に。"}, {"type": "subtitle", "time": 6175.11, "timestamp": "01:42:55", "text": "一度プレイしたと思うけど、"}, {"type": "subtitle", "time": 6178.07, "timestamp": "01:42:58", "text": "何年も前のことだったと思う。私は"}]
[{"type": "subtitle", "time": 9313.75, "timestamp": "02:35:13", "text": "それ。落ち込む人もいるだろう"}, {"type": "subtitle", "time": 9331.349, "timestamp": "02:35:31", "text": "ああ、わかった。白樺を手に入れたが、"}, {"type": "subtitle", "time": 9333.75, "timestamp": "02:35:33", "text": "今すぐにでも戻ってこなくちゃ。そうでなければ、私は"}, {"type": "subtitle", "time": 9335.83, "timestamp": "02:35:35", "text": "ここでみんなにくすぐられることになる"}, {"type": "subtitle", "time": 9340.229, "timestamp": "02:35:40", "text": "ああ、もう人が来てる"}, {"type": "subtitle", "time": 9342.87, "timestamp": "02:35:42", "text": "私をフォローしています。よし、もっと熱いと思う"}, {"type": "subtitle", "time": 9346.03, "timestamp": "02:35:46", "text": "物が出現するだろう。隠れて殺す"}, {"type": "subtitle", "time": 9349.95, "timestamp": "02:35:49", "text": "もの。ああ、ボスがいる"}, {"type": "subtitle", "time": 9353.67, "timestamp": "02:35:53", "text": "ここ。わかりました、助けが必要かもしれません。えっと"}, {"type": "subtitle", "time": 9355.91, "timestamp": "02:35:55", "text": "ああ、大変だ、周りに人がたくさんいる。私たちは"}, {"type": "subtitle", "time": 9357.19, "timestamp": "02:35:57", "text": "ここに食べ物はありますか？ありません"}, {"type": "subtitle", "time": 9359.11, "timestamp": "02:35:59", "text": "ここに食べ物があります。ええ、私は本当に"}]
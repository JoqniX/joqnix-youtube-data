[{"type": "subtitle", "time": 14280.788, "timestamp": "03:58:00", "text": "彼らが行った場所。"}, {"type": "subtitle", "time": 14284.91, "timestamp": "03:58:04", "text": "これはウィル・ロジャースの言葉です。わかった。私"}, {"type": "subtitle", "time": 14289.03, "timestamp": "03:58:09", "text": "ロック解除された牧草地キャンプ。収穫を許可する"}, {"type": "subtitle", "time": 14291.99, "timestamp": "03:58:11", "text": "牛、羊、鹿の。わかった。は"}, {"type": "subtitle", "time": 14294.75, "timestamp": "03:58:14", "text": "羊か鹿がいるの？馬が終わった"}, {"type": "subtitle", "time": 14298.99, "timestamp": "03:58:18", "text": "ここ。ああ、あそこに行かなきゃ。"}, {"type": "subtitle", "time": 14303.11, "timestamp": "03:58:23", "text": "ホリー、私は自分がすべきかどうかちょっと気になっている"}, {"type": "subtitle", "time": 14306.07, "timestamp": "03:58:26", "text": "シンディアと戦争をする。うん。誰が"}, {"type": "subtitle", "time": 14313.47, "timestamp": "03:58:33", "text": "知る。私は"}, {"type": "subtitle", "time": 14318.03, "timestamp": "03:58:38", "text": "怖がった。アニャ、さあ行こう"}, {"type": "subtitle", "time": 14319.55, "timestamp": "03:58:39", "text": "に"}, {"type": "subtitle", "time": 14321.4, "timestamp": "03:58:41", "text": "ここで"}, {"type": "subtitle", "time": 14322.91, "timestamp": "03:58:42", "text": "[音楽]"}, {"type": "subtitle", "time": 14327.11, "timestamp": "03:58:47", "text": "場所。離れてください。研究を選びなさい。わかった。"}, {"type": "subtitle", "time": 14330.55, "timestamp": "03:58:50", "text": "新しい研究材料が手に入るかもしれない。それで、"}]
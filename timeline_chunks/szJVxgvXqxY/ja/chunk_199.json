[{"type": "subtitle", "time": 11948.71, "timestamp": "03:19:08", "text": "彼は予想していなかった。"}, {"type": "subtitle", "time": 11950.95, "timestamp": "03:19:10", "text": "私の必殺技が完成しました。ああ、殺したばかりだ"}, {"type": "subtitle", "time": 11953.37, "timestamp": "03:19:13", "text": "彼自身。"}, {"type": "subtitle", "time": 11954.95, "timestamp": "03:19:14", "text": "[音楽]"}, {"type": "subtitle", "time": 11957.99, "timestamp": "03:19:17", "text": "何てことだ。わかった。でもママ、彼は叫んでいるの？"}, {"type": "subtitle", "time": 11960.469, "timestamp": "03:19:20", "text": "私に食べさせてくれるの？うん。うん。うん。あなたはできる"}, {"type": "subtitle", "time": 11964.63, "timestamp": "03:19:24", "text": "ここで終わりにしましょう。うん。ごめんなさい。"}, {"type": "subtitle", "time": 11966.469, "timestamp": "03:19:26", "text": "心配ない。心配ない。改めてありがとうございました。"}, {"type": "subtitle", "time": 11969.03, "timestamp": "03:19:29", "text": "今日はここまで。あなたと一緒に過ごせて本当に楽しかったです"}, {"type": "subtitle", "time": 11971.349, "timestamp": "03:19:31", "text": "ここで、これは私たちの最初のコラボレーションでした"}, {"type": "subtitle", "time": 11974.71, "timestamp": "03:19:34", "text": "そうですよね？ありがとう。ありがとう。感謝"}, {"type": "subtitle", "time": 11976.87, "timestamp": "03:19:36", "text": "招待してくれてありがとう。持っていますか"}, {"type": "subtitle", "time": 11978.309, "timestamp": "03:19:38", "text": "あなたが言いたいことは何でも"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "離れる？えっと、トークを購読して、いいねしてください"}, {"type": "subtitle", "time": 11984.07, "timestamp": "03:19:44", "text": "ストリーム。"}, {"type": "subtitle", "time": 11987.91, "timestamp": "03:19:47", "text": "皆さん、ぜひ購読してください。ありがとう。"}, {"type": "subtitle", "time": 11990.55, "timestamp": "03:19:50", "text": "バイバイ。こんにちは。バイバイ。気をつけて。取る"}, {"type": "subtitle", "time": 11993.03, "timestamp": "03:19:53", "text": "ケア。良い一日を。しっかり食べましょう。取る"}, {"type": "subtitle", "time": 11994.71, "timestamp": "03:19:54", "text": "ケア。"}, {"type": "subtitle", "time": 11997.95, "timestamp": "03:19:57", "text": "さよなら。さよなら。さよなら。こんにちは。"}]
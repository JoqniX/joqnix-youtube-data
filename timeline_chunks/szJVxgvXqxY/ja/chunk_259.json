[{"type": "subtitle", "time": 15546.11, "timestamp": "04:19:06", "text": "何が起こったのか？"}, {"type": "subtitle", "time": 15561.23, "timestamp": "04:19:21", "text": "赤？どうしてそんなに赤いの？"}, {"type": "subtitle", "time": 15563.99, "timestamp": "04:19:23", "text": "こんにちは。ああ、入植者が来たよ。はい、はい、"}, {"type": "subtitle", "time": 15565.83, "timestamp": "04:19:25", "text": "はい、はい、はい、はい、はい。私は手に入れた"}, {"type": "subtitle", "time": 15571.91, "timestamp": "04:19:31", "text": "怖がった。えーと、私たちは、私たちは"}, {"type": "subtitle", "time": 15578.99, "timestamp": "04:19:38", "text": "ああ、生産を選択してください"}, {"type": "subtitle", "time": 15583.628, "timestamp": "04:19:43", "text": "生産。わかりました、どうすれば"}, {"type": "subtitle", "time": 15587.19, "timestamp": "04:19:47", "text": "生産？ああ、なるほど、君が見えるよ。なるほど"}, {"type": "subtitle", "time": 15590.23, "timestamp": "04:19:50", "text": "あなた。あなたが見えてます。あなたが見えてます。"}, {"type": "subtitle", "time": 15592.628, "timestamp": "04:19:52", "text": "それで、入植者がやってきた。私たちはもっと作ることができます"}, {"type": "subtitle", "time": 15596.55, "timestamp": "04:19:56", "text": "都市とかそういうもの。次に、えーと"}]
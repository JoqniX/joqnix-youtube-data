[{"type": "subtitle", "time": 15900.39, "timestamp": "04:25:00", "text": "ええと、8回転です。これは一体何ですか？三つ"}, {"type": "subtitle", "time": 15901.628, "timestamp": "04:25:01", "text": "回転。"}, {"type": "subtitle", "time": 15908.868, "timestamp": "04:25:08", "text": "私は空に向かって矢を放った。アーチェリー。"}, {"type": "subtitle", "time": 15911.91, "timestamp": "04:25:11", "text": "さあ行こう。地球。アーチェリーができるようになりました。"}, {"type": "subtitle", "time": 15916.55, "timestamp": "04:25:16", "text": "さあ行こう。次は、私が必要とするもの"}, {"type": "subtitle", "time": 15926.47, "timestamp": "04:25:26", "text": "この不思議に思う人"}, {"type": "subtitle", "time": 15929.15, "timestamp": "04:25:29", "text": "えーと、神社の建物。わかった。"}, {"type": "subtitle", "time": 15934.99, "timestamp": "04:25:34", "text": "わかった。だから、ホイールセーリングマスターの書き方"}, {"type": "subtitle", "time": 15937.35, "timestamp": "04:25:37", "text": "灌漑。私たちが"}, {"type": "subtitle", "time": 15941.27, "timestamp": "04:25:41", "text": "簡単に少ない回転数で"}, {"type": "subtitle", "time": 15944.23, "timestamp": "04:25:44", "text": "セブン。占星術を使うか、"}, {"type": "subtitle", "time": 15946.31, "timestamp": "04:25:46", "text": "執筆活動と併用できる。では、"}, {"type": "subtitle", "time": 15948.75, "timestamp": "04:25:48", "text": "占星術"}, {"type": "subtitle", "time": 15951.07, "timestamp": "04:25:51", "text": "今。ユニットのニーズ"}, {"type": "subtitle", "time": 15953.868, "timestamp": "04:25:53", "text": "注文、睡眠、"}, {"type": "subtitle", "time": 15957.51, "timestamp": "04:25:57", "text": "動く。彼らは建設業者ですよね？何が"}]
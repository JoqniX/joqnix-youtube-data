[{"type": "subtitle", "time": 1440.39, "timestamp": "00:24:00", "text": "このゲームをプレイしています。少し難しかった"}, {"type": "subtitle", "time": 1443.99, "timestamp": "00:24:03", "text": "自分。でも、確かに楽しいゲームだよ。"}, {"type": "subtitle", "time": 1447.43, "timestamp": "00:24:07", "text": "私はこのゲームを長い間プレイしたと思います"}, {"type": "subtitle", "time": 1449.99, "timestamp": "00:24:09", "text": "以前一度だけ。"}, {"type": "subtitle", "time": 1452.629, "timestamp": "00:24:12", "text": "いつ見たのか覚えていない"}, {"type": "subtitle", "time": 1454.95, "timestamp": "00:24:14", "text": "私のストアページにあるゲームをご覧ください。私はこう思った。"}, {"type": "subtitle", "time": 1459.51, "timestamp": "00:24:19", "text": "「えっ、このゲーム96分もあるの？"}, {"type": "subtitle", "time": 1460.91, "timestamp": "00:24:20", "text": "覚えていない"}, {"type": "subtitle", "time": 1462.46, "timestamp": "00:24:22", "text": "それ。ああ、"}, {"type": "subtitle", "time": 1465.31, "timestamp": "00:24:25", "text": "[音楽]"}, {"type": "subtitle", "time": 1467.99, "timestamp": "00:24:27", "text": "神よ。」だから、"}, {"type": "subtitle", "time": 1473.79, "timestamp": "00:24:33", "text": "うん、君はプレイするつもりだね"}, {"type": "subtitle", "time": 1480.95, "timestamp": "00:24:40", "text": "すぐに死んでしまいそうな気がする"}, {"type": "subtitle", "time": 1483.95, "timestamp": "00:24:43", "text": "私は降参します。"}, {"type": "subtitle", "time": 1489.51, "timestamp": "00:24:49", "text": "ねえ、私があなたを守るわ。 D 私は今行く。"}, {"type": "subtitle", "time": 1492.149, "timestamp": "00:24:52", "text": "私は狼なのかもしれない。うん。いいえ、"}, {"type": "subtitle", "time": 1497.189, "timestamp": "00:24:57", "text": "キツネ。キツネ。私は、私は人々に"}, {"type": "subtitle", "time": 1499.47, "timestamp": "00:24:59", "text": "マシュマロスティック。"}]
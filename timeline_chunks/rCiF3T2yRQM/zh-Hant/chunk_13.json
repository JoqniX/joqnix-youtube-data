[{"type": "subtitle", "time": 813.03, "timestamp": "00:13:33", "text": "我們要帶走這只鈷藍色的貓嗎？」滴答會跳一段歡快的舞蹈，像"}, {"type": "subtitle", "time": 823.99, "timestamp": "00:13:43", "text": "一隻虎斑貓那樣輕快地跳一下，看起來很像堡壘之夜的舞蹈"}, {"type": "subtitle", "time": 826.069, "timestamp": "00:13:46", "text": "。就一個該死的堡壘之夜表情。我的天啊。我的天啊。大逃殺勝利。我的天啊。是啊。嗯"}, {"type": "subtitle", "time": 837.43, "timestamp": "00:13:57", "text": "，所以蓮花會說：「我們少了一個人，因為我們的貓神秘失蹤了。」"}, {"type": "subtitle", "time": 839.99, "timestamp": "00:13:59", "text": "你以前養過貓。太瘋狂了。  從未見過貓。"}]
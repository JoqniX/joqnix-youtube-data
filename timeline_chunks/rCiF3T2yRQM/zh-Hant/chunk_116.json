[{"type": "subtitle", "time": 6962.47, "timestamp": "01:56:02", "text": "你們想把所有"}, {"type": "subtitle", "time": 6964.47, "timestamp": "01:56:04", "text": "屍體都溶解掉，我想"}, {"type": "subtitle", "time": 6967.109, "timestamp": "01:56:07", "text": "這或許有助於擺脫它"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "。  其實不是，我的意思是"}, {"type": "subtitle", "time": 6974.31, "timestamp": "01:56:14", "text": "我們可以把一"}, {"type": "subtitle", "time": 6976.55, "timestamp": "01:56:16", "text": "小瓶"}, {"type": "subtitle", "time": 6978.79, "timestamp": "01:56:18", "text": "黑色液體倒在肉質的東西上，希望這樣能把它從那個肉質的大房間裡清除掉"}, {"type": "subtitle", "time": 6983.83, "timestamp": "01:56:23", "text": "。"}, {"type": "subtitle", "time": 6988.87, "timestamp": "01:56:28", "text": "我們可以試試。我們當然可以嘗試一下。  所以，他要拿著那瓶"}, {"type": "subtitle", "time": 6991.03, "timestamp": "01:56:31", "text": "黑色液體"}, {"type": "subtitle", "time": 6994.07, "timestamp": "01:56:34", "text": "前往另一個房間了"}, {"type": "subtitle", "time": 7004.07, "timestamp": "01:56:44", "text": "我會說這就像是靜止的藤蔓。  我想說的是，這些藤蔓"}]
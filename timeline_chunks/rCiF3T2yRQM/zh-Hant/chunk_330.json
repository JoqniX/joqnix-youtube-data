[{"type": "subtitle", "time": 19815.83, "timestamp": "05:30:15", "text": "洞裡。  好的，請繼續。  我得讓開。  好的。  好的。那樣一來，騙局就安全了。  [音樂] 好的。它在保險箱裡。  不太能接受"}, {"type": "subtitle", "time": 19817.27, "timestamp": "05:30:17", "text": "你的朋友。  [音樂] 我不"}, {"type": "subtitle", "time": 19827.83, "timestamp": "05:30:27", "text": "擲骰子決定傷害，對吧？  嗯，是的，你不需要。  是的，這無關緊要。  好吧，那"}, {"type": "subtitle", "time": 19838.868, "timestamp": "05:30:38", "text": "我們就讓開"}, {"type": "subtitle", "time": 19840.31, "timestamp": "05:30:40", "text": "。"}, {"type": "subtitle", "time": 19841.51, "timestamp": "05:30:41", "text": "好的。  是的。  我不知道。  不想被即將到來的攻擊擊中。  不過，也要看看其他人。"}, {"type": "subtitle", "time": 19848.788, "timestamp": "05:30:48", "text": "好的。還有其他東西嗎？照片裡要展現你最好的一面"}, {"type": "subtitle", "time": 19852.15, "timestamp": "05:30:52", "text": "。"}, {"type": "chat", "time": 19852.165, "timestamp": "05:30:52", "author": "@RylanGoldman", "avatar": "https://yt4.ggpht.com/ytc/AIdro_lBG4Q2j7htJbxg-phr_qVcAKlNOGbhJhWBe0SkBAuX3EdiRFA_mJUmpSD86gxTbRG5GQ=s64-c-k-c0x00ffffff-no-rj", "message": "how was your day Joq"}]
[{"type": "subtitle", "time": 6247.669, "timestamp": "01:44:07", "text": "黑色液體味道不好。  哦。  好的。我要去看看我旁邊的屍體。  好的。呃，你只想看看屍體，還是想"}, {"type": "subtitle", "time": 6254.149, "timestamp": "01:44:14", "text": "翻翻"}, {"type": "subtitle", "time": 6255.59, "timestamp": "01:44:15", "text": "口袋什麼的？我想"}, {"type": "subtitle", "time": 6260.709, "timestamp": "01:44:20", "text": "看看他們的口袋，但我很想知道裡面有什麼，就像我"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "翻遍了所有口袋一樣。它們都像這樣，它們大多是"}, {"type": "subtitle", "time": 6282.149, "timestamp": "01:44:42", "text": "空的。嗯，但是他們的"}, {"type": "subtitle", "time": 6294.55, "timestamp": "01:44:54", "text": "口袋裡有很多類似即興演奏的樂譜。  哦，對了，我好像忘了提這件事"}, {"type": "subtitle", "time": 6297.03, "timestamp": "01:44:57", "text": "。這些屍體並非全部來自冒險者。"}, {"type": "subtitle", "time": 6299.35, "timestamp": "01:44:59", "text": "他們更像是普通人"}]
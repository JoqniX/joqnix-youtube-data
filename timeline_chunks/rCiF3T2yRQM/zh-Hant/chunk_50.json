[{"type": "subtitle", "time": 3021.27, "timestamp": "00:50:21", "text": "翻看那些空空如也的戰利品，因為他們已經拿走了。但那裡"}, {"type": "subtitle", "time": 3030.79, "timestamp": "00:50:30", "text": "有一條路可以下去。嗯，我想我可以"}, {"type": "subtitle", "time": 3033.19, "timestamp": "00:50:33", "text": "說這條路有點曲折。  或許它肉質鮮美。是的。  嗯，嗯，你最終會知道的。不用擔心。你會找到的。  看起來毫不起眼。  Lotus會問Ariana，問她有沒有危險"}, {"type": "subtitle", "time": 3043.67, "timestamp": "00:50:43", "text": "阿里，哦，好的。有"}, {"type": "subtitle", "time": 3051.109, "timestamp": "00:50:51", "text": "危險嗎？我們應該有所了解"}]
[{"type": "subtitle", "time": 8580.309, "timestamp": "02:23:00", "text": "。  哦，我咽不下去。  太糟糕了，哦，原來是其中一個。  我的天啊，操。我討厭"}, {"type": "subtitle", "time": 8582.469, "timestamp": "02:23:02", "text": "史萊姆，不，其實我不能說討厭，我真的非常喜歡"}, {"type": "subtitle", "time": 8598.309, "timestamp": "02:23:18", "text": "史萊姆。  我也很喜歡它們。哦，我真是太喜歡了。  沒錯，老實說，這是我最喜歡的怪物"}, {"type": "subtitle", "time": 8599.83, "timestamp": "02:23:19", "text": "類型。我希望他們能得到威世智公司更多的關注。需要更多史萊姆。"}, {"type": "subtitle", "time": 8614.389, "timestamp": "02:23:34", "text": "我發誓應該有更多史萊姆。  是啊，他們有時候確實很糟糕。  好的。還要"}, {"type": "subtitle", "time": 8623.11, "timestamp": "02:23:43", "text": "別的嗎？  我不這麼認為"}, {"type": "subtitle", "time": 8627.11, "timestamp": "02:23:47", "text": "。我"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "想這就是我接下來要說的全部了。  好的。好的。這些人，呃，我們走吧，他們要搬家了"}]
[{"type": "subtitle", "time": 423.749, "timestamp": "00:07:03", "text": "我沒意識到自己被靜音了"}, {"type": "subtitle", "time": 425.83, "timestamp": "00:07:05", "text": "。該死的。  哦，幸好"}, {"type": "subtitle", "time": 437.589, "timestamp": "00:07:17", "text": "我提到了這一點。  我當時就覺得「是」。謝天謝地你這麼做了。"}, {"type": "subtitle", "time": 440.55, "timestamp": "00:07:20", "text": "我剛才想說的是，我被凱撞了。之前有人開車輾過我的腳，導致"}, {"type": "subtitle", "time": 443.27, "timestamp": "00:07:23", "text": "我腳上的好幾根骨頭都碎了，"}, {"type": "subtitle", "time": 446.07, "timestamp": "00:07:26", "text": "我"}, {"type": "subtitle", "time": 447.67, "timestamp": "00:07:27", "text": "打了好幾個月的石膏"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "。  我們走吧"}, {"type": "subtitle", "time": 451.189, "timestamp": "00:07:31", "text": "。"}, {"type": "subtitle", "time": 452.87, "timestamp": "00:07:32", "text": "我被打了一拳，但不知怎麼的，我竟然沒骨折。我想，當它影響到我的時候，"}, {"type": "subtitle", "time": 463.43, "timestamp": "00:07:43", "text": "我的身體就像是……該怎麼形容那種感覺呢？被擊中時"}, {"type": "subtitle", "time": 467.029, "timestamp": "00:07:47", "text": "我反而很放鬆。  貓骨。  是的。我被撞的時候身體一點也不緊張，因為"}, {"type": "subtitle", "time": 469.51, "timestamp": "00:07:49", "text": "我覺得我當時處於一種脫離現實的狀態，直到被撞之後才意識到自己被撞了，當時我"}]
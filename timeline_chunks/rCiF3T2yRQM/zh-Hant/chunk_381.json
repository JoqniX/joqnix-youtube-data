[{"type": "subtitle", "time": 22862.788, "timestamp": "06:21:02", "text": "這個家裡負責任地管理他們的錢。是的，你知道，Tick，希望…希望它很快就能好起來"}, {"type": "subtitle", "time": 22870.628, "timestamp": "06:21:10", "text": "睡覺吧，上大學。我一直直視著你的眼睛。問題是我太累了。一開始，大概過了30分鐘，"}, {"type": "subtitle", "time": 22890.948, "timestamp": "06:21:30", "text": "我超累，困得不行。我不知道我是怎麼撐過那天的。太瘋狂了。別擔心，他們聽不到我說話，因為我正在努力。什麼意思？等等，我們沒找到亡靈。你們說"}, {"type": "subtitle", "time": 22896.15, "timestamp": "06:21:36", "text": "我覺得我們可以。"}, {"type": "subtitle", "time": 22898.628, "timestamp": "06:21:38", "text": "我唯一討厭的就是我沒怎麼說話"}, {"type": "subtitle", "time": 22904.07, "timestamp": "06:21:44", "text": "。顯然"}, {"type": "subtitle", "time": 22906.708, "timestamp": "06:21:46", "text": "，我是個角色扮演者，什麼的。我沉默不語，就像……我不是……我是死人。我是人類。"}]
[{"type": "subtitle", "time": 7860.47, "timestamp": "02:11:00", "text": "。去他媽的。去他媽的。我們玩得很開心。我正在攻擊它。"}, {"type": "subtitle", "time": 7873.189, "timestamp": "02:11:13", "text": "好的。擲先攻。"}, {"type": "subtitle", "time": 7879.27, "timestamp": "02:11:19", "text": "我們都會死。哦，等等。他媽的。他媽的。對不起"}, {"type": "subtitle", "time": 7880.79, "timestamp": "02:11:20", "text": "。我他媽的掛住螺栓。"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "我會調整一下。  好的。還有其他舉措嗎？  [音樂] 喬克。是的，我會發起"}]
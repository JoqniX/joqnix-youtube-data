[{"type": "subtitle", "time": 1444.149, "timestamp": "00:24:04", "text": "令牌，"}, {"type": "subtitle", "time": 1453.669, "timestamp": "00:24:13", "text": "如果我只點擊我的令牌"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "，我就看不到你們在哪裡。你看不到我們。雖然是黑白的，但我們在地圖上什麼也看不清楚。  我的天啊。是黑色還是黑色？  哦"}, {"type": "subtitle", "time": 1460.31, "timestamp": "00:24:20", "text": "，是的。讓我來給你示範一下。讓我來向你展示"}, {"type": "subtitle", "time": 1486.07, "timestamp": "00:24:46", "text": "我眼中的代幣是什麼樣子。它也出現在公共聊天"}]
[{"type": "subtitle", "time": 8475.83, "timestamp": "02:21:15", "text": "引導船與這家人一起航行。  嗯，當螺栓起到導向作用時。  當螺栓處於"}, {"type": "subtitle", "time": 8480.55, "timestamp": "02:21:20", "text": "導向狀態時。糟糕，我之前不小心用掉一個了。感到"}, {"type": "subtitle", "time": 8485.67, "timestamp": "02:21:25", "text": "困惑。"}, {"type": "subtitle", "time": 8486.63, "timestamp": "02:21:26", "text": "哦，是的。是的，你只要點一下，我就可以退款。"}, {"type": "subtitle", "time": 8496.79, "timestamp": "02:21:36", "text": "哦，"}, {"type": "subtitle", "time": 8499.349, "timestamp": "02:21:39", "text": "我已經到了。好的，不錯。  [音樂] 把球打回去"}]
[{"type": "subtitle", "time": 22699.03, "timestamp": "06:18:19", "text": "嗯，我是說樓下的團隊"}, {"type": "subtitle", "time": 22706.47, "timestamp": "06:18:26", "text": "。在北美貨幣市場兌換美元會不會很麻煩？不會很"}, {"type": "subtitle", "time": 22711.99, "timestamp": "06:18:31", "text": "麻煩。只是平台會抽成，對吧？一個是支付處理費，一個是交易費，一個是兌換費，"}, {"type": "subtitle", "time": 22725.83, "timestamp": "06:18:45", "text": "然後還有國家的稅，對吧"}, {"type": "subtitle", "time": 22728.39, "timestamp": "06:18:48", "text": "？ GSC稅。所以，三個，然後還有三個扣款。我猜「通往男人心扉的路」是「我一直對男孩有感覺」。我的天哪，我喜歡這個。你知道嗎？這……這……我"}, {"type": "subtitle", "time": 22738.07, "timestamp": "06:18:58", "text": "的"}, {"type": "subtitle", "time": 22739.59, "timestamp": "06:18:59", "text": "天哪。我喜歡這個。這不是……這不對，但就因為這很有趣，我會給"}]
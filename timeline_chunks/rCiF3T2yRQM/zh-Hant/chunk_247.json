[{"type": "subtitle", "time": 14824.389, "timestamp": "04:07:04", "text": "但不知道你是否被禁言了，但我假設你還沒有被"}, {"type": "subtitle", "time": 14827.269, "timestamp": "04:07:07", "text": "禁言。好的，我們先輪到喬了。  我會繼續留意，呃呃，呃，再說一次？輪到"}, {"type": "subtitle", "time": 14828.309, "timestamp": "04:07:08", "text": "競技場了。"}, {"type": "subtitle", "time": 14830.71, "timestamp": "04:07:10", "text": "等這個回來我就做。而且，我也不記得我又不"}, {"type": "subtitle", "time": 14837.91, "timestamp": "04:07:17", "text": "小心把它刪掉了。  我打算把它放進去"}, {"type": "subtitle", "time": 14865.349, "timestamp": "04:07:45", "text": "黏液就開始移動，就像這個黏液向這邊移動一樣"}]
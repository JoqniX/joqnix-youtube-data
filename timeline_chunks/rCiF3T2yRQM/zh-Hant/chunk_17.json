[{"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "然後就決定睡在我們的"}, {"type": "subtitle", "time": 1058.789, "timestamp": "00:17:38", "text": "獨木舟裡。"}, {"type": "subtitle", "time": 1071.43, "timestamp": "00:17:51", "text": "哦，你知道嗎？你知道嗎？我受夠了那隻神祕失蹤的貓。嗯，一朵會說話的花，現在又來了一朵鈷藍花。我"}, {"type": "subtitle", "time": 1073.27, "timestamp": "00:17:53", "text": "接受了這個選擇"}]
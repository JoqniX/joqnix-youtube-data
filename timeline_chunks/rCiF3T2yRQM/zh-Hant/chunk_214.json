[{"type": "subtitle", "time": 12846.63, "timestamp": "03:34:06", "text": "我這就去。嗯，好的。呃，"}, {"type": "subtitle", "time": 12849.269, "timestamp": "03:34:09", "text": "擲骰子決定傷害，要嘛接受，要嘛接受 Ariana。愛莉安娜，為什麼不呢？阿麗亞娜，點擊擲骰子決定傷害。好的。  美好的。好的。好的。  呃，一個。非常好。  這些人，呃，他們甚至都不喜歡，他們甚至都不"}, {"type": "subtitle", "time": 12863.99, "timestamp": "03:34:23", "text": "試圖躲避。他們只是收下，似乎並沒有用"}, {"type": "subtitle", "time": 12870.469, "timestamp": "03:34:30", "text": "它們做太多事情。  他們只是放鬆休息。  好的。嗯，我只能說…哇。我很好奇他們為什麼那麼喜歡龍息。  我剛才攻擊了"}, {"type": "subtitle", "time": 12885.99, "timestamp": "03:34:45", "text": "那裡的那一個。我的天啊。好的。 19."}, {"type": "subtitle", "time": 12889.03, "timestamp": "03:34:49", "text": "很少人打人。擲骰子"}, {"type": "subtitle", "time": 12895.99, "timestamp": "03:34:55", "text": "造成傷害"}]
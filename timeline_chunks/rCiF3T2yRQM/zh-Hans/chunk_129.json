[{"type": "subtitle", "time": 7741.27, "timestamp": "02:09:01", "text": "不用担心。"}, {"type": "subtitle", "time": 7744.95, "timestamp": "02:09:04", "text": "我们玩得太像流氓了。"}, {"type": "subtitle", "time": 7747.669, "timestamp": "02:09:07", "text": "这是正常的。正常，对吧？"}, {"type": "subtitle", "time": 7748.149, "timestamp": "02:09:08", "text": "是的。"}, {"type": "subtitle", "time": 7752.709, "timestamp": "02:09:12", "text": "最后。"}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": "好的。好的。嗯，让我……"}, {"type": "subtitle", "time": 7758.149, "timestamp": "02:09:18", "text": "迅速揭示这一点。好的。你来处理"}, {"type": "subtitle", "time": 7762.149, "timestamp": "02:09:22", "text": "造成13点伤害。好的。嗯，我只想"}, {"type": "subtitle", "time": 7764.87, "timestamp": "02:09:24", "text": "照做。呃，你也选了。"}, {"type": "subtitle", "time": 7766.149, "timestamp": "02:09:26", "text": "酸。所以，我打算改一下。"}, {"type": "subtitle", "time": 7767.99, "timestamp": "02:09:27", "text": "我假设你没在服用迷幻药。"}, {"type": "subtitle", "time": 7770.79, "timestamp": "02:09:30", "text": "正确的？"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "我假设你不会……"}, {"type": "subtitle", "time": 7775.35, "timestamp": "02:09:35", "text": "造成破坏。所以，我打算……呃……"}, {"type": "subtitle", "time": 7778.39, "timestamp": "02:09:38", "text": "全部损失。好了。"}, {"type": "subtitle", "time": 7780.47, "timestamp": "02:09:40", "text": "我也这么认为。"}, {"type": "subtitle", "time": 7783.99, "timestamp": "02:09:43", "text": "我猜想大概是这样吧"}, {"type": "subtitle", "time": 7784.629, "timestamp": "02:09:44", "text": "是的。"}, {"type": "subtitle", "time": 7786.47, "timestamp": "02:09:46", "text": "或者至少是抵抗。"}, {"type": "subtitle", "time": 7793.109, "timestamp": "02:09:53", "text": "我认为这是一个合理的假设。"}, {"type": "subtitle", "time": 7795.109, "timestamp": "02:09:55", "text": "好的。好的。完成后，点击"}, {"type": "subtitle", "time": 7797.83, "timestamp": "02:09:57", "text": "进入。"}, {"type": "subtitle", "time": 7799.99, "timestamp": "02:09:59", "text": "除非你有办法再弄一个。"}]
[{"type": "subtitle", "time": 2763.109, "timestamp": "00:46:03", "text": "嘴巴张得老大，像一堵墙一样"}, {"type": "subtitle", "time": 2766.39, "timestamp": "00:46:06", "text": "一滩血。如果你看到游泳池"}, {"type": "subtitle", "time": 2769.51, "timestamp": "00:46:09", "text": "胸部有血迹，而且可能还有可疑的肿块。"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "或许最好别去那里。"}, {"type": "subtitle", "time": 2776.069, "timestamp": "00:46:16", "text": "你知道，为了避免任何"}, {"type": "subtitle", "time": 2779.51, "timestamp": "00:46:19", "text": "满载战利品。是的，里面也充满了"}, {"type": "subtitle", "time": 2784.63, "timestamp": "00:46:24", "text": "死去的朋友们还在试图获取战利品"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "[音乐]"}, {"type": "subtitle", "time": 2792.87, "timestamp": "00:46:32", "text": "但下面还有一个房间。我是"}, {"type": "subtitle", "time": 2794.63, "timestamp": "00:46:34", "text": "我敢肯定你们不需要看"}, {"type": "subtitle", "time": 2797.03, "timestamp": "00:46:37", "text": "穿过空荡荡的战利品，因为他们已经"}, {"type": "subtitle", "time": 2799.67, "timestamp": "00:46:39", "text": "已经拿走了。但总有一条路可走。"}, {"type": "subtitle", "time": 2803.51, "timestamp": "00:46:43", "text": "下面。嗯，我想我可以这么说。"}, {"type": "subtitle", "time": 2807.67, "timestamp": "00:46:47", "text": "这条路有点难走。"}, {"type": "subtitle", "time": 2809.43, "timestamp": "00:46:49", "text": "或许"}, {"type": "subtitle", "time": 2817.75, "timestamp": "00:46:57", "text": "出色地，"}]
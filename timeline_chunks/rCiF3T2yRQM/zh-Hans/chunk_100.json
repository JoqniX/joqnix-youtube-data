[{"type": "subtitle", "time": 6000.87, "timestamp": "01:40:00", "text": "大家都能拿到笔记吗？"}, {"type": "subtitle", "time": 6002.87, "timestamp": "01:40:02", "text": "一起？或许我们可以撒点尿。"}, {"type": "subtitle", "time": 6003.91, "timestamp": "01:40:03", "text": "出去。"}, {"type": "subtitle", "time": 6005.83, "timestamp": "01:40:05", "text": "我会给，我会给震撼我的音符"}, {"type": "subtitle", "time": 6007.51, "timestamp": "01:40:07", "text": "从尸体上捡到的。"}, {"type": "subtitle", "time": 6009.83, "timestamp": "01:40:09", "text": "好的。"}, {"type": "subtitle", "time": 6011.75, "timestamp": "01:40:11", "text": "对，是大脑。"}, {"type": "subtitle", "time": 6013.109, "timestamp": "01:40:13", "text": "你把笔记记下来了。"}, {"type": "subtitle", "time": 6014.79, "timestamp": "01:40:14", "text": "其实他并不是最聪明的人。我是"}, {"type": "subtitle", "time": 6016.629, "timestamp": "01:40:16", "text": "我相当确定 Jock 和 Tick 都是"}, {"type": "subtitle", "time": 6019.669, "timestamp": "01:40:19", "text": "实际上比……更聪明"}, {"type": "subtitle", "time": 6022.629, "timestamp": "01:40:22", "text": "T 出人意料地聪明。"}, {"type": "subtitle", "time": 6024.629, "timestamp": "01:40:24", "text": "好的。好的。我希望你们其中一人"}, {"type": "subtitle", "time": 6027.59, "timestamp": "01:40:27", "text": "具有优势的卷盘调查。"}, {"type": "subtitle", "time": 6028.07, "timestamp": "01:40:28", "text": "嘿，"}, {"type": "subtitle", "time": 6029.99, "timestamp": "01:40:29", "text": "你怎么认为？打钩，"}, {"type": "subtitle", "time": 6032.149, "timestamp": "01:40:32", "text": "Tick，你觉得怎么样？"}, {"type": "subtitle", "time": 6033.75, "timestamp": "01:40:33", "text": "勾选，阅读。"}, {"type": "subtitle", "time": 6035.27, "timestamp": "01:40:35", "text": "滴答，你会读书吗？"}, {"type": "subtitle", "time": 6036.149, "timestamp": "01:40:36", "text": "对，读。"}, {"type": "subtitle", "time": 6037.99, "timestamp": "01:40:37", "text": "如果具体情况确实如此。好的，我要走了"}, {"type": "subtitle", "time": 6040.629, "timestamp": "01:40:40", "text": "为了证明这一点。如果我要说如果T"}, {"type": "subtitle", "time": 6042.39, "timestamp": "01:40:42", "text": "如果是Tick做的，我希望如此。"}, {"type": "subtitle", "time": 6044.31, "timestamp": "01:40:44", "text": "加五分，因为T喝了两种酒。"}, {"type": "subtitle", "time": 6045.43, "timestamp": "01:40:45", "text": "液体。"}, {"type": "subtitle", "time": 6046.55, "timestamp": "01:40:46", "text": "好的。"}, {"type": "subtitle", "time": 6047.51, "timestamp": "01:40:47", "text": "嗯，那是20分。"}, {"type": "subtitle", "time": 6048.95, "timestamp": "01:40:48", "text": "那是20分。真不错。全部"}, {"type": "subtitle", "time": 6051.59, "timestamp": "01:40:51", "text": "正确的。所以，现在我正在查看笔记。"}, {"type": "subtitle", "time": 6053.43, "timestamp": "01:40:53", "text": "与你的……进行交叉核对"}, {"type": "subtitle", "time": 6059.43, "timestamp": "01:40:59", "text": "你知道这张纸条和这些纸条"}]
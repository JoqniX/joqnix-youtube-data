[{"type": "subtitle", "time": 4920.47, "timestamp": "01:22:00", "text": "好的。我可以把绳子扔出去吗？"}, {"type": "subtitle", "time": 4922.229, "timestamp": "01:22:02", "text": "回到Tick？"}, {"type": "subtitle", "time": 4928.39, "timestamp": "01:22:08", "text": "是的。是的。好的。所以，你扔掉你"}, {"type": "subtitle", "time": 4931.669, "timestamp": "01:22:11", "text": "现在把绳子扔给蒂格。"}, {"type": "subtitle", "time": 4933.43, "timestamp": "01:22:13", "text": "好的。我想那就是我。我会我会"}, {"type": "subtitle", "time": 4935.59, "timestamp": "01:22:15", "text": "让Kick做他想做的事。我"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "猜测"}, {"type": "subtitle", "time": 4938.79, "timestamp": "01:22:18", "text": "他做他最擅长的事。"}, {"type": "subtitle", "time": 4940.39, "timestamp": "01:22:20", "text": "是的。"}, {"type": "subtitle", "time": 4942.229, "timestamp": "01:22:22", "text": "把另一个房间的地板弄脏。"}, {"type": "subtitle", "time": 4944.95, "timestamp": "01:22:24", "text": "正确的。是吗？"}, {"type": "subtitle", "time": 4947.75, "timestamp": "01:22:27", "text": "嗯？地板就像……呃……地板"}, {"type": "subtitle", "time": 4949.11, "timestamp": "01:22:29", "text": "是另一个房间，对吧？或者说，是吗？"}, {"type": "subtitle", "time": 4950.39, "timestamp": "01:22:30", "text": "相似的？"}, {"type": "subtitle", "time": 4952.87, "timestamp": "01:22:32", "text": "是的，非常相似。"}, {"type": "subtitle", "time": 4954.95, "timestamp": "01:22:34", "text": "所以，我可以把水刮掉。"}, {"type": "subtitle", "time": 4956.629, "timestamp": "01:22:36", "text": "来自我。正确的。"}, {"type": "subtitle", "time": 4959.59, "timestamp": "01:22:39", "text": "哦。哦。呃，水在……"}, {"type": "subtitle", "time": 4961.59, "timestamp": "01:22:41", "text": "肉体一号。我会说这个。你知道"}, {"type": "subtitle", "time": 4964.39, "timestamp": "01:22:44", "text": "什么？就因为你这么说。嗯。你"}, {"type": "subtitle", "time": 4965.83, "timestamp": "01:22:45", "text": "一定要有灵感。我会让你用的"}, {"type": "subtitle", "time": 4968.55, "timestamp": "01:22:48", "text": "塑造血液的灵感。"}, {"type": "subtitle", "time": 4969.99, "timestamp": "01:22:49", "text": "我的天啊。血。"}, {"type": "subtitle", "time": 4972.31, "timestamp": "01:22:52", "text": "这个是金属的。"}, {"type": "subtitle", "time": 4973.03, "timestamp": "01:22:53", "text": "金属。"}, {"type": "subtitle", "time": 4974.47, "timestamp": "01:22:54", "text": "塑造血液。我要走了"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "我要分开，我要分开鲜血，就像这样"}]
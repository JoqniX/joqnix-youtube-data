[{"type": "subtitle", "time": 3542.23, "timestamp": "00:59:02", "text": "从这里延伸出来的碎片"}, {"type": "subtitle", "time": 3543.589, "timestamp": "00:59:03", "text": "这边的楼层。有点像"}, {"type": "subtitle", "time": 3545.27, "timestamp": "00:59:05", "text": "肌肉组织之类的东西。我爱"}, {"type": "subtitle", "time": 3546.309, "timestamp": "00:59:06", "text": "那些。"}, {"type": "subtitle", "time": 3548.23, "timestamp": "00:59:08", "text": "你可以拿走。"}, {"type": "subtitle", "time": 3548.63, "timestamp": "00:59:08", "text": "哦，不。"}, {"type": "subtitle", "time": 3549.67, "timestamp": "00:59:09", "text": "好的，请随意。"}, {"type": "subtitle", "time": 3552.15, "timestamp": "00:59:12", "text": "我的天哪。"}, {"type": "subtitle", "time": 3555.589, "timestamp": "00:59:15", "text": "我需要卷什么东西吗？"}, {"type": "subtitle", "time": 3557.27, "timestamp": "00:59:17", "text": "你知道吗？卷。给我"}, {"type": "subtitle", "time": 3558.47, "timestamp": "00:59:18", "text": "生存。"}, {"type": "subtitle", "time": 3561.829, "timestamp": "00:59:21", "text": "我的天哪。"}, {"type": "subtitle", "time": 3565.19, "timestamp": "00:59:25", "text": "给我掷个生存骰。好吧，你舔过了。"}, {"type": "subtitle", "time": 3567.75, "timestamp": "00:59:27", "text": "它的味道……它的味道有点像……"}, {"type": "subtitle", "time": 3569.829, "timestamp": "00:59:29", "text": "猪肉，但除此之外，你"}, {"type": "subtitle", "time": 3571.91, "timestamp": "00:59:31", "text": "对此我了解不多。"}, {"type": "subtitle", "time": 3574.47, "timestamp": "00:59:34", "text": "我可以用剑戳它一下吗？"}, {"type": "subtitle", "time": 3580.63, "timestamp": "00:59:40", "text": "戳一下它。发生什么事了吗？"}, {"type": "subtitle", "time": 3582.789, "timestamp": "00:59:42", "text": "它有反应。这有点像抽搐"}, {"type": "subtitle", "time": 3585.67, "timestamp": "00:59:45", "text": "有点，但也就仅此而已。是的。"}, {"type": "subtitle", "time": 3587.91, "timestamp": "00:59:47", "text": "我可以吗？"}, {"type": "subtitle", "time": 3592.71, "timestamp": "00:59:52", "text": "我可以试着……呃……操……我能做什么？"}, {"type": "subtitle", "time": 3594.87, "timestamp": "00:59:54", "text": "这不自然。"}, {"type": "subtitle", "time": 3599.589, "timestamp": "00:59:59", "text": "我不知道。宗教。真是见鬼了。"}]
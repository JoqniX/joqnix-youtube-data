[{"type": "subtitle", "time": 9000.63, "timestamp": "02:30:00", "text": "你可以做这件事。"}, {"type": "subtitle", "time": 9002.71, "timestamp": "02:30:02", "text": "但就像你也可以移动月光一样"}, {"type": "subtitle", "time": 9003.59, "timestamp": "02:30:03", "text": "嗯"}, {"type": "subtitle", "time": 9005.75, "timestamp": "02:30:05", "text": "哦，是的。你也可能再次造成损害。"}, {"type": "subtitle", "time": 9010.07, "timestamp": "02:30:10", "text": "是的。谢谢你提到这一点。哦，"}, {"type": "subtitle", "time": 9013.11, "timestamp": "02:30:13", "text": "把它移出再移入。"}, {"type": "subtitle", "time": 9015.27, "timestamp": "02:30:15", "text": "呃，"}, {"type": "subtitle", "time": 9018.389, "timestamp": "02:30:18", "text": "使用星形形态后，或者像“不，我可以”这样"}, {"type": "subtitle", "time": 9020.469, "timestamp": "02:30:20", "text": "就让月亮再次成为我吧。"}, {"type": "subtitle", "time": 9021.59, "timestamp": "02:30:21", "text": "你只需要使用月光就行了。"}, {"type": "subtitle", "time": 9022.87, "timestamp": "02:30:22", "text": "对，直接用月光就行了，因为"}, {"type": "subtitle", "time": 9023.83, "timestamp": "02:30:23", "text": "月光依然在那里。"}, {"type": "subtitle", "time": 9025.67, "timestamp": "02:30:25", "text": "还有，嗯，星形形态实际上并没有"}, {"type": "subtitle", "time": 9027.349, "timestamp": "02:30:27", "text": "顺便一提，它还可以变形。我只是"}, {"type": "subtitle", "time": 9027.83, "timestamp": "02:30:27", "text": "已确认。"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "哦，"}, {"type": "subtitle", "time": 9031.349, "timestamp": "02:30:31", "text": "是的。它只是召唤出一个星座。"}, {"type": "subtitle", "time": 9033.91, "timestamp": "02:30:33", "text": "哦好的。有道理。我有点"}, {"type": "subtitle", "time": 9035.51, "timestamp": "02:30:35", "text": "假设它是转变，因为"}, {"type": "subtitle", "time": 9038.309, "timestamp": "02:30:38", "text": "这是沃尔特的形状。是的，它使用"}, {"type": "subtitle", "time": 9041.91, "timestamp": "02:30:41", "text": "狂野形态​​之类的东西，但它就像……"}, {"type": "subtitle", "time": 9043.27, "timestamp": "02:30:43", "text": "传票。"}, {"type": "subtitle", "time": 9043.99, "timestamp": "02:30:43", "text": "啊，"}, {"type": "subtitle", "time": 9046.389, "timestamp": "02:30:46", "text": "我还看到 Jock 嗯 Jocks 是"}, {"type": "subtitle", "time": 9049.03, "timestamp": "02:30:49", "text": "实际上能够使用他们的功能"}, {"type": "subtitle", "time": 9054.389, "timestamp": "02:30:54", "text": "哦，"}, {"type": "subtitle", "time": 9056.55, "timestamp": "02:30:56", "text": "虽然不像我熟悉的那种，但它仍然是……"}, {"type": "subtitle", "time": 9058.71, "timestamp": "02:30:58", "text": "熟悉的。"}]
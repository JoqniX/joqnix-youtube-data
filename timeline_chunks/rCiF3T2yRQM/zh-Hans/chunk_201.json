[{"type": "subtitle", "time": 12060.15, "timestamp": "03:21:00", "text": "这边？又出现了一个凹痕"}, {"type": "subtitle", "time": 12063.11, "timestamp": "03:21:03", "text": "膜。好了。"}, {"type": "subtitle", "time": 12064.79, "timestamp": "03:21:04", "text": "好的。它几乎没什么生气。"}, {"type": "subtitle", "time": 12068.07, "timestamp": "03:21:08", "text": "我可以吗？我可以吗？"}, {"type": "subtitle", "time": 12069.83, "timestamp": "03:21:09", "text": "关心肠道健康吗？"}, {"type": "subtitle", "time": 12071.75, "timestamp": "03:21:11", "text": "我可以反抗吗？我可以做那件事吗？"}, {"type": "subtitle", "time": 12072.95, "timestamp": "03:21:12", "text": "再次？"}, {"type": "subtitle", "time": 12074.95, "timestamp": "03:21:14", "text": "呃，你其实没什么事可做。"}, {"type": "subtitle", "time": 12076.55, "timestamp": "03:21:16", "text": "就是现在这样。"}, {"type": "subtitle", "time": 12078.229, "timestamp": "03:21:18", "text": "哦，轮到我了。是吗？"}, {"type": "subtitle", "time": 12079.91, "timestamp": "03:21:19", "text": "我不这么认为。呃，你有一笔奖金"}, {"type": "subtitle", "time": 12081.19, "timestamp": "03:21:21", "text": "行动，但你是否有额外行动？"}, {"type": "subtitle", "time": 12082.87, "timestamp": "03:21:22", "text": "那些攻击？"}, {"type": "subtitle", "time": 12085.67, "timestamp": "03:21:25", "text": "奖励动作。"}, {"type": "subtitle", "time": 12087.19, "timestamp": "03:21:27", "text": "魔法石。"}, {"type": "subtitle", "time": 12087.75, "timestamp": "03:21:27", "text": "射手。"}, {"type": "subtitle", "time": 12090.07, "timestamp": "03:21:30", "text": "魔法石。魔法石。该行为"}, {"type": "subtitle", "time": 12091.91, "timestamp": "03:21:31", "text": "投掷本身仍然是一种动作。这"}, {"type": "subtitle", "time": 12093.349, "timestamp": "03:21:33", "text": "奖励部分确实很迷人"}, {"type": "subtitle", "time": 12094.63, "timestamp": "03:21:34", "text": "石头"}, {"type": "subtitle", "time": 12096.469, "timestamp": "03:21:36", "text": "因为你给三颗鹅卵石施了魔法，你就可以"}, {"type": "subtitle", "time": 12098.15, "timestamp": "03:21:38", "text": "送给别人。"}, {"type": "subtitle", "time": 12100.95, "timestamp": "03:21:40", "text": "哦，等等。我难道不能用魔法石做……吗？"}, {"type": "subtitle", "time": 12102.55, "timestamp": "03:21:42", "text": "它？"}, {"type": "subtitle", "time": 12104.55, "timestamp": "03:21:44", "text": "哦，你现在可以制作魔法石了。所以后来"}, {"type": "subtitle", "time": 12107.51, "timestamp": "03:21:47", "text": "你将拥有那块魔法石，你可以"}, {"type": "subtitle", "time": 12108.63, "timestamp": "03:21:48", "text": "扔掉它。"}, {"type": "subtitle", "time": 12111.51, "timestamp": "03:21:51", "text": "哦好的。我来做那块魔法石。"}, {"type": "subtitle", "time": 12113.269, "timestamp": "03:21:53", "text": "好的。好的。我就把那句话记下来吧。"}, {"type": "subtitle", "time": 12115.83, "timestamp": "03:21:55", "text": "头脑。所以你有三块魔法石。"}, {"type": "subtitle", "time": 12117.91, "timestamp": "03:21:57", "text": "你身上也有可以给予他人的东西。"}]
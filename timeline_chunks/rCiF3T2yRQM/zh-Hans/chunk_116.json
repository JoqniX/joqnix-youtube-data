[{"type": "subtitle", "time": 6961.03, "timestamp": "01:56:01", "text": "我认为我们有三种可能的情况。"}, {"type": "subtitle", "time": 6962.47, "timestamp": "01:56:02", "text": "我们可以做到。我们可以把所有的"}, {"type": "subtitle", "time": 6964.47, "timestamp": "01:56:04", "text": "黑色液体中浸泡着尸体。看看"}, {"type": "subtitle", "time": 6967.109, "timestamp": "01:56:07", "text": "事情发生了。呃，但我确实认为……"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "这可能是个坏主意。"}, {"type": "subtitle", "time": 6974.31, "timestamp": "01:56:14", "text": "我们可以沿着肉体的走廊走下去"}, {"type": "subtitle", "time": 6976.55, "timestamp": "01:56:16", "text": "或者我们可以尝试增加投入"}, {"type": "subtitle", "time": 6978.79, "timestamp": "01:56:18", "text": "黑色液体顺着洞口流了下来"}, {"type": "subtitle", "time": 6981.189, "timestamp": "01:56:21", "text": "坏掉的人体模型，因为它原本是工作的"}, {"type": "subtitle", "time": 6983.83, "timestamp": "01:56:23", "text": "那里。"}, {"type": "subtitle", "time": 6986.709, "timestamp": "01:56:26", "text": "这种方式"}, {"type": "subtitle", "time": 6988.87, "timestamp": "01:56:28", "text": "我们是不是可以一直往后跑？"}, {"type": "subtitle", "time": 6991.03, "timestamp": "01:56:31", "text": "避开黑色液体，然后慢慢地"}, {"type": "subtitle", "time": 6994.07, "timestamp": "01:56:34", "text": "把尸体放进锅里……"}, {"type": "subtitle", "time": 7001.03, "timestamp": "01:56:41", "text": "所以我们可以同时做这两件事。"}, {"type": "subtitle", "time": 7004.07, "timestamp": "01:56:44", "text": "我觉得这有点危险。"}, {"type": "subtitle", "time": 7006.87, "timestamp": "01:56:46", "text": "谁知道那黑色液体会怎么样呢？"}, {"type": "subtitle", "time": 7008.87, "timestamp": "01:56:48", "text": "活着也好，我们活着的那一刻"}, {"type": "subtitle", "time": 7011.109, "timestamp": "01:56:51", "text": "试着转身回到原处"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "我们来自他们所有人，他们都将是"}, {"type": "subtitle", "time": 7014.39, "timestamp": "01:56:54", "text": "攻击我们。"}, {"type": "subtitle", "time": 7016.79, "timestamp": "01:56:56", "text": "我们四个人，其中一个。"}]
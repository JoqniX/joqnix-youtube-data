[{"type": "subtitle", "time": 1865.269, "timestamp": "00:31:05", "text": "我的天哪。"}, {"type": "subtitle", "time": 1866.71, "timestamp": "00:31:06", "text": "在脑子里想象一下。它们只是蜱虫"}, {"type": "subtitle", "time": 1870.71, "timestamp": "00:31:10", "text": "向鸟儿抛洒金子"}, {"type": "subtitle", "time": 1873.11, "timestamp": "00:31:13", "text": "加载需要一些时间。"}, {"type": "subtitle", "time": 1874.789, "timestamp": "00:31:14", "text": "哦，等等。正在加载吗？坚持，稍等。"}, {"type": "subtitle", "time": 1879.19, "timestamp": "00:31:19", "text": "是的。是的，我这边正在加载。"}, {"type": "subtitle", "time": 1880.23, "timestamp": "00:31:20", "text": "这并不重要"}, {"type": "subtitle", "time": 1882.389, "timestamp": "00:31:22", "text": "它加载成功了。"}, {"type": "subtitle", "time": 1884.31, "timestamp": "00:31:24", "text": "事后有奖励。"}, {"type": "subtitle", "time": 1886.87, "timestamp": "00:31:26", "text": "很抱歉，我还在加载中。"}, {"type": "subtitle", "time": 1887.83, "timestamp": "00:31:27", "text": "哦，真奇怪。"}, {"type": "subtitle", "time": 1889.35, "timestamp": "00:31:29", "text": "你能从中获得什么样的奖励？"}, {"type": "subtitle", "time": 1891.11, "timestamp": "00:31:31", "text": "他们？"}, {"type": "subtitle", "time": 1894.31, "timestamp": "00:31:34", "text": "呃，更多的黄金和闪闪发光的石头。"}, {"type": "subtitle", "time": 1897.11, "timestamp": "00:31:37", "text": "有时候Tick会吃零食，"}, {"type": "subtitle", "time": 1898.23, "timestamp": "00:31:38", "text": "银。"}, {"type": "subtitle", "time": 1901.83, "timestamp": "00:31:41", "text": "哦好的。"}, {"type": "subtitle", "time": 1902.389, "timestamp": "00:31:42", "text": "那是"}, {"type": "subtitle", "time": 1905.75, "timestamp": "00:31:45", "text": "Tick is Tick 正在被收购。"}, {"type": "subtitle", "time": 1909.83, "timestamp": "00:31:49", "text": "他将被收购。"}, {"type": "subtitle", "time": 1916.63, "timestamp": "00:31:56", "text": "不，"}]
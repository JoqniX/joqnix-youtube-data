[{"type": "subtitle", "time": 7080.55, "timestamp": "01:58:00", "text": "它就像血肉之躯。它正在积极地"}, {"type": "subtitle", "time": 7081.83, "timestamp": "01:58:01", "text": "明白这一点，你知道，就像，你知道，"}, {"type": "subtitle", "time": 7085.189, "timestamp": "01:58:05", "text": "喉咙的那个动作有点……"}, {"type": "subtitle", "time": 7086.709, "timestamp": "01:58:06", "text": "当它试图获取食物时，就会发生这种情况"}, {"type": "subtitle", "time": 7088.07, "timestamp": "01:58:08", "text": "你的胃。差不多就是这样。"}, {"type": "subtitle", "time": 7090.229, "timestamp": "01:58:10", "text": "这就像试图移动你一样"}, {"type": "subtitle", "time": 7092.629, "timestamp": "01:58:12", "text": "慢慢地。你可以抵抗它。只是"}, {"type": "subtitle", "time": 7094.87, "timestamp": "01:58:14", "text": "比如，哦，当它处于激活状态时，我会说"}, {"type": "subtitle", "time": 7096.39, "timestamp": "01:58:16", "text": "下雨很难，"}, {"type": "subtitle", "time": 7099.75, "timestamp": "01:58:19", "text": "兄弟。这是消化系统。"}, {"type": "subtitle", "time": 7101.27, "timestamp": "01:58:21", "text": "是的。我打算转向范，然后就……"}, {"type": "subtitle", "time": 7103.51, "timestamp": "01:58:23", "text": "就像，这是，这是一张嘴。我们是否应该"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "好吧，我们唯一能做的就是离开。"}, {"type": "subtitle", "time": 7115.83, "timestamp": "01:58:35", "text": "夜晚。"}, {"type": "subtitle", "time": 7120.79, "timestamp": "01:58:40", "text": "你好。"}, {"type": "subtitle", "time": 7124.07, "timestamp": "01:58:44", "text": "是的。尖叫。"}, {"type": "subtitle", "time": 7125.91, "timestamp": "01:58:45", "text": "坐在那里，就像它试图……"}, {"type": "subtitle", "time": 7129.669, "timestamp": "01:58:49", "text": "就像自己移动一样。只需"}, {"type": "subtitle", "time": 7132.87, "timestamp": "01:58:52", "text": "好的。 T：就像我们"}, {"type": "subtitle", "time": 7138.47, "timestamp": "01:58:58", "text": "对不起。是我搬的。"}]
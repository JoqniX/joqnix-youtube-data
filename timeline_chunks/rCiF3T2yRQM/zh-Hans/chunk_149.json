[{"type": "subtitle", "time": 8940.63, "timestamp": "02:29:00", "text": "可以像施放骨骼切割法术一样。你"}, {"type": "subtitle", "time": 8941.99, "timestamp": "02:29:01", "text": "拥有诸如制造火焰、魔法之类的能力"}, {"type": "subtitle", "time": 8944.309, "timestamp": "02:29:04", "text": "石头，以及作为你的附赠动作法术。"}, {"type": "subtitle", "time": 8946.71, "timestamp": "02:29:06", "text": "你可以随意变形。然后你就可以"}, {"type": "subtitle", "time": 8951.11, "timestamp": "02:29:11", "text": "还有，呃，其实是狂野形态。"}, {"type": "subtitle", "time": 8951.67, "timestamp": "02:29:11", "text": "大概"}, {"type": "subtitle", "time": 8953.19, "timestamp": "02:29:13", "text": "如果你想要狂野的造型。你甚至"}, {"type": "subtitle", "time": 8954.95, "timestamp": "02:29:14", "text": "能够像一艘狂野的船一样变成"}, {"type": "subtitle", "time": 8957.51, "timestamp": "02:29:17", "text": "现在有飞行生物吗？"}, {"type": "subtitle", "time": 8960.469, "timestamp": "02:29:20", "text": "哦。呃呃，严格来说不是，但就像乔一样"}, {"type": "subtitle", "time": 8962.87, "timestamp": "02:29:22", "text": "确实有星形野性形态"}, {"type": "subtitle", "time": 8966.389, "timestamp": "02:29:26", "text": "来自子类。就是这样吗？"}, {"type": "subtitle", "time": 8968.79, "timestamp": "02:29:28", "text": "飞行？我不太确定。"}, {"type": "subtitle", "time": 8970.55, "timestamp": "02:29:30", "text": "那是什么？"}, {"type": "subtitle", "time": 8972.469, "timestamp": "02:29:32", "text": "我可以展示出来。坚持，稍等。不要让我"}, {"type": "subtitle", "time": 8974.389, "timestamp": "02:29:34", "text": "吃掉它。这就是这个东西"}, {"type": "subtitle", "time": 8976.87, "timestamp": "02:29:36", "text": "从子类中获取工作。那是"}, {"type": "subtitle", "time": 8979.19, "timestamp": "02:29:39", "text": "明星的梦想。"}, {"type": "subtitle", "time": 8981.67, "timestamp": "02:29:41", "text": "我不知道。我真的不知道。等待，"}, {"type": "subtitle", "time": 8984.07, "timestamp": "02:29:44", "text": "这难道不应该是我的终极目标吗？"}, {"type": "subtitle", "time": 8985.11, "timestamp": "02:29:45", "text": "某物？"}, {"type": "subtitle", "time": 8987.19, "timestamp": "02:29:47", "text": "呃，更像是你的“它是”"}, {"type": "subtitle", "time": 8989.27, "timestamp": "02:29:49", "text": "你拥有的功能就像你有两个"}, {"type": "subtitle", "time": 8991.429, "timestamp": "02:29:51", "text": "他们中的。就像你的W形一样。所以，你"}, {"type": "subtitle", "time": 8994.309, "timestamp": "02:29:54", "text": "我有两份。这是一个相当强的"}, {"type": "subtitle", "time": 8996.389, "timestamp": "02:29:56", "text": "能力，因为一旦你激活了这个"}, {"type": "subtitle", "time": 8998.79, "timestamp": "02:29:58", "text": "每次额外行动，你都会获得一个奖励。"}]
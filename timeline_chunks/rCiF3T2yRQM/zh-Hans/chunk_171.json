[{"type": "subtitle", "time": 10261.99, "timestamp": "02:51:01", "text": "我们可以尝试对付史莱姆。"}, {"type": "subtitle", "time": 10264.23, "timestamp": "02:51:04", "text": "我想，应该是首先吧。"}, {"type": "subtitle", "time": 10268.469, "timestamp": "02:51:08", "text": "好的，等等。嗯，所以我们确实想要"}, {"type": "subtitle", "time": 10271.59, "timestamp": "02:51:11", "text": "鸟先或"}, {"type": "subtitle", "time": 10275.03, "timestamp": "02:51:15", "text": "好的。"}, {"type": "subtitle", "time": 10276.95, "timestamp": "02:51:16", "text": "等等，我们想引起他们的注意，"}, {"type": "subtitle", "time": 10278.71, "timestamp": "02:51:18", "text": "然后移动月光。于是，他们开始了"}, {"type": "subtitle", "time": 10281.91, "timestamp": "02:51:21", "text": "漫步在月光下。"}, {"type": "subtitle", "time": 10284.07, "timestamp": "02:51:24", "text": "好的。我得说，受伤的人大概有一半"}, {"type": "subtitle", "time": 10289.59, "timestamp": "02:51:29", "text": "我们确实有办法抓住他们"}, {"type": "subtitle", "time": 10291.03, "timestamp": "02:51:31", "text": "顺便提一句，注意。我们确实有办法。"}, {"type": "subtitle", "time": 10292.95, "timestamp": "02:51:32", "text": "吸引他们的注意力。"}, {"type": "subtitle", "time": 10295.91, "timestamp": "02:51:35", "text": "我的意思是，你可以犹豫不决。"}, {"type": "subtitle", "time": 10298.15, "timestamp": "02:51:38", "text": "因为我真的让德拉诺人哭过"}, {"type": "subtitle", "time": 10305.19, "timestamp": "02:51:45", "text": "欢迎菲娜。他们说人们"}, {"type": "subtitle", "time": 10314.389, "timestamp": "02:51:54", "text": "我的天啊。罗迦那哭泣"}, {"type": "subtitle", "time": 10316.23, "timestamp": "02:51:56", "text": "额外攻击"}, {"type": "subtitle", "time": 10318.389, "timestamp": "02:51:58", "text": "攻击你周围 10 英尺内的敌人"}]
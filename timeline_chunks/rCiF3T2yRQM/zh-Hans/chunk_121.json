[{"type": "subtitle", "time": 7262.47, "timestamp": "02:01:02", "text": "这边。它是一团黄色的黏糊糊的东西。而且它"}, {"type": "subtitle", "time": 7265.27, "timestamp": "02:01:05", "text": "似乎察觉到了你的存在。它缓慢地"}, {"type": "subtitle", "time": 7267.43, "timestamp": "02:01:07", "text": "悄悄爬过来。"}, {"type": "subtitle", "time": 7270.149, "timestamp": "02:01:10", "text": "缓慢地蔓延开来。我的意思是，哦，"}, {"type": "subtitle", "time": 7270.87, "timestamp": "02:01:10", "text": "我不是故意这么想的。"}, {"type": "subtitle", "time": 7272.79, "timestamp": "02:01:12", "text": "我认为我们有敌人。"}, {"type": "subtitle", "time": 7273.669, "timestamp": "02:01:13", "text": "哦，不。"}, {"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "缓慢地蔓延开来。还有"}, {"type": "subtitle", "time": 7277.27, "timestamp": "02:01:17", "text": "其他"}, {"type": "subtitle", "time": 7279.109, "timestamp": "02:01:19", "text": "我的天哪。好的。就像我们一起……"}, {"type": "subtitle", "time": 7288.229, "timestamp": "02:01:28", "text": "不要尝试食用它们。"}, {"type": "subtitle", "time": 7290.68, "timestamp": "02:01:30", "text": "他们会想办法吃掉你。"}, {"type": "subtitle", "time": 7291.75, "timestamp": "02:01:31", "text": "[音乐]"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "你以前吃过史莱姆。"}, {"type": "subtitle", "time": 7307.27, "timestamp": "02:01:47", "text": "我觉得他只是在吃青柠果冻。酸橙"}, {"type": "subtitle", "time": 7308.07, "timestamp": "02:01:48", "text": "果冻。是的，"}, {"type": "subtitle", "time": 7310.47, "timestamp": "02:01:50", "text": "青柠果冻。嗯，"}, {"type": "subtitle", "time": 7312.87, "timestamp": "02:01:52", "text": "这款是柠檬口味的。"}, {"type": "subtitle", "time": 7315.91, "timestamp": "02:01:55", "text": "我觉得当这个点赞越来越近的时候。嗯，"}, {"type": "subtitle", "time": 7317.189, "timestamp": "02:01:57", "text": "你知道吗？我这就进攻"}, {"type": "subtitle", "time": 7319.27, "timestamp": "02:01:59", "text": "它。去他妈的。去他妈的。我们玩得很开心。我是"}]
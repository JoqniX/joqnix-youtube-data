[{"type": "subtitle", "time": 8040.149, "timestamp": "02:14:00", "text": "好的。好的。"}, {"type": "subtitle", "time": 8042.159, "timestamp": "02:14:02", "text": "好的。 刺。"}, {"type": "subtitle", "time": 8042.639, "timestamp": "02:14:02", "text": "刺。 是的。是的。好的。哦，是的。不用担心。"}, {"type": "subtitle", "time": 8044.8, "timestamp": "02:14:04", "text": "是的。是的。好的。哦，是的。不用担心。 伤害已经判定完毕。好的。"}, {"type": "subtitle", "time": 8046.719, "timestamp": "02:14:06", "text": "伤害已经判定完毕。好的。 当你这样做的时候，你会意识到，当"}, {"type": "subtitle", "time": 8049.52, "timestamp": "02:14:09", "text": "当你这样做的时候，你会意识到，当 你……当你……把它划掉的时候，它不会"}, {"type": "subtitle", "time": 8053.36, "timestamp": "02:14:13", "text": "你……当你……把它划掉的时候，它不会 似乎真的对它做了很多。这样做。"}, {"type": "subtitle", "time": 8057.119, "timestamp": "02:14:17", "text": "似乎真的对它做了很多。这样做。 好了。它有效吗？是的，就是这样。"}, {"type": "subtitle", "time": 8058.4, "timestamp": "02:14:18", "text": "好了。它有效吗？是的，就是这样。 变小，变成“有”。"}, {"type": "subtitle", "time": 8060.079, "timestamp": "02:14:20", "text": "变小，变成“有”。 又一个。"}, {"type": "subtitle", "time": 8063.199, "timestamp": "02:14:23", "text": "又一个。 嗯？猜测。"}, {"type": "subtitle", "time": 8072.229, "timestamp": "02:14:32", "text": "嗯，那不是我想要的结果。"}, {"type": "subtitle", "time": 8078.629, "timestamp": "02:14:38", "text": "这时，旋风就出现了。"}, {"type": "subtitle", "time": 8080.149, "timestamp": "02:14:40", "text": "玩。"}, {"type": "subtitle", "time": 8084.069, "timestamp": "02:14:44", "text": "嗯，好的。我想我大概就只能这样了"}, {"type": "subtitle", "time": 8087.35, "timestamp": "02:14:47", "text": "呃，伙计们，他们总是分裂。"}, {"type": "subtitle", "time": 8089.91, "timestamp": "02:14:49", "text": "分开。"}, {"type": "subtitle", "time": 8092.39, "timestamp": "02:14:52", "text": "玛丽安娜就像在砍他们。"}, {"type": "subtitle", "time": 8096.79, "timestamp": "02:14:56", "text": "我想我能理解。嗯，也许吧"}]
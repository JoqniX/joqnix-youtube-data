[{"type": "subtitle", "time": 1322.87, "timestamp": "00:22:02", "text": "它有效吗？"}, {"type": "subtitle", "time": 1325.11, "timestamp": "00:22:05", "text": "不，那是手电筒。"}, {"type": "subtitle", "time": 1327.35, "timestamp": "00:22:07", "text": "那是一支手电筒。我的天啊。是啊，你"}, {"type": "subtitle", "time": 1328.549, "timestamp": "00:22:08", "text": "就得一直这样努力。"}, {"type": "subtitle", "time": 1329.83, "timestamp": "00:22:09", "text": "好的，稍等一下。我打算尝试移除"}, {"type": "subtitle", "time": 1331.83, "timestamp": "00:22:11", "text": "火炬。让我把它删掉。好的，试试看。"}, {"type": "subtitle", "time": 1333.75, "timestamp": "00:22:13", "text": "移动。这是盲人"}, {"type": "subtitle", "time": 1337.35, "timestamp": "00:22:17", "text": "然后，这两个人就看不见了。"}, {"type": "subtitle", "time": 1340.95, "timestamp": "00:22:20", "text": "我喜欢什么都看不见的感觉。"}, {"type": "subtitle", "time": 1343.27, "timestamp": "00:22:23", "text": "我喜欢没有夜视能力。它是"}, {"type": "subtitle", "time": 1344.23, "timestamp": "00:22:24", "text": "伟大的。"}, {"type": "subtitle", "time": 1345.029, "timestamp": "00:22:25", "text": "哇。"}, {"type": "subtitle", "time": 1346.87, "timestamp": "00:22:26", "text": "视力被高估了。"}, {"type": "subtitle", "time": 1349.11, "timestamp": "00:22:29", "text": "运动健将怎么样？"}, {"type": "subtitle", "time": 1352.39, "timestamp": "00:22:32", "text": "我看不见。事情非黑即白。"}, {"type": "subtitle", "time": 1354.07, "timestamp": "00:22:34", "text": "哦，对了，黑白意味着你有"}, {"type": "subtitle", "time": 1355.11, "timestamp": "00:22:35", "text": "黑暗视觉。"}, {"type": "subtitle", "time": 1355.75, "timestamp": "00:22:35", "text": "哦好的。"}, {"type": "subtitle", "time": 1358.47, "timestamp": "00:22:38", "text": "等等，Ariana 和 Estan 就是看不见。"}, {"type": "subtitle", "time": 1360.87, "timestamp": "00:22:40", "text": "拉屎。"}, {"type": "subtitle", "time": 1362.71, "timestamp": "00:22:42", "text": "我看不见。"}, {"type": "subtitle", "time": 1364.95, "timestamp": "00:22:44", "text": "你看不见，因为你是精灵。所以，你"}, {"type": "subtitle", "time": 1366.71, "timestamp": "00:22:46", "text": "实际上在黑暗中什么也看不见。所以，但是"}, {"type": "subtitle", "time": 1369.27, "timestamp": "00:22:49", "text": "它会显示为黑色。但对我来说，"}, {"type": "subtitle", "time": 1372.47, "timestamp": "00:22:52", "text": "Ariana，嗯，我们根本看不见。所以，"}, {"type": "subtitle", "time": 1374.789, "timestamp": "00:22:54", "text": "基本上，如果我点击我的令牌，"}, {"type": "subtitle", "time": 1377.51, "timestamp": "00:22:57", "text": "如果我只点击我的令牌，就看不到任何东西。"}]
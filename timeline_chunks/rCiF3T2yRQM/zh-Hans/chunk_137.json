[{"type": "subtitle", "time": 8220.95, "timestamp": "02:17:00", "text": "正如一位著名的DM曾经说过的那样，"}, {"type": "subtitle", "time": 8224.23, "timestamp": "02:17:04", "text": "我当然可以试试。"}, {"type": "subtitle", "time": 8226.549, "timestamp": "02:17:06", "text": "好的，我来投掷。"}, {"type": "subtitle", "time": 8228.79, "timestamp": "02:17:08", "text": "好的，这是一个私人角色。"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "揭露这一点。好的，放置一个模板。"}, {"type": "subtitle", "time": 8236.23, "timestamp": "02:17:16", "text": "呃，等等。你不可能功成名就。好的。"}, {"type": "subtitle", "time": 8237.349, "timestamp": "02:17:17", "text": "是的。是的。是的。它很漂亮"}, {"type": "subtitle", "time": 8240.15, "timestamp": "02:17:20", "text": "虽然体积小，但可以随意移动。"}, {"type": "subtitle", "time": 8244.469, "timestamp": "02:17:24", "text": "好的。我打算在那里按下它。"}, {"type": "subtitle", "time": 8246.549, "timestamp": "02:17:26", "text": "好的。"}, {"type": "subtitle", "time": 8250.87, "timestamp": "02:17:30", "text": "节省。呃，这个圈子结束了。"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "顺便一提，就是那里。"}, {"type": "subtitle", "time": 8254.07, "timestamp": "02:17:34", "text": "是的。没关系。不用担心。让他去吧"}, {"type": "subtitle", "time": 8255.11, "timestamp": "02:17:35", "text": "死。"}, {"type": "subtitle", "time": 8256.709, "timestamp": "02:17:36", "text": "等待，"}, {"type": "subtitle", "time": 8258.309, "timestamp": "02:17:38", "text": "他快要死了。"}, {"type": "subtitle", "time": 8261.709, "timestamp": "02:17:41", "text": "哦，不。那是我儿子。"}, {"type": "subtitle", "time": 8262.95, "timestamp": "02:17:42", "text": "[音乐]"}, {"type": "subtitle", "time": 8264.95, "timestamp": "02:17:44", "text": "我儿子快要死了。但没关系。"}, {"type": "subtitle", "time": 8267.11, "timestamp": "02:17:47", "text": "好的。听着，这是他做出的牺牲。"}, {"type": "subtitle", "time": 8269.11, "timestamp": "02:17:49", "text": "愿意制作。"}, {"type": "subtitle", "time": 8271.83, "timestamp": "02:17:51", "text": "他之后总会回来的。"}, {"type": "subtitle", "time": 8274.389, "timestamp": "02:17:54", "text": "回来。我真的可以做到这一点"}, {"type": "subtitle", "time": 8276.79, "timestamp": "02:17:56", "text": "仪式。"}, {"type": "subtitle", "time": 8279.11, "timestamp": "02:17:59", "text": "我也必须这么做。"}]
[{"type": "subtitle", "time": 2881.19, "timestamp": "00:48:01", "text": "我的天啊。冰棒没有碰。"}, {"type": "subtitle", "time": 2891.109, "timestamp": "00:48:11", "text": "凉爽的。嗯，如果那样可以的话。"}, {"type": "subtitle", "time": 2892.63, "timestamp": "00:48:12", "text": "我想这就是我们需要的一切了。"}, {"type": "subtitle", "time": 2893.91, "timestamp": "00:48:13", "text": "知道了，对吧，伙计们？我们去看看……"}, {"type": "subtitle", "time": 2896.23, "timestamp": "00:48:16", "text": "其余的派对成员。"}, {"type": "subtitle", "time": 2899.109, "timestamp": "00:48:19", "text": "是的，"}, {"type": "subtitle", "time": 2902.549, "timestamp": "00:48:22", "text": "大概吧。似乎并非如此。"}, {"type": "subtitle", "time": 2907.589, "timestamp": "00:48:27", "text": "可疑的。这他妈到底是什么意思？"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "但它看起来很美味。"}, {"type": "subtitle", "time": 2910.71, "timestamp": "00:48:30", "text": "可口的。是的。"}, {"type": "subtitle", "time": 2913.829, "timestamp": "00:48:33", "text": "至少她只是喜欢"}, {"type": "subtitle", "time": 2917.27, "timestamp": "00:48:37", "text": "看起来确实很美味。我"}, {"type": "subtitle", "time": 2919.27, "timestamp": "00:48:39", "text": "喜欢你说话的方式。"}, {"type": "subtitle", "time": 2927.67, "timestamp": "00:48:47", "text": "蒂克会跑过去抱住她。"}, {"type": "subtitle", "time": 2928.95, "timestamp": "00:48:48", "text": "腿。"}, {"type": "subtitle", "time": 2935.109, "timestamp": "00:48:55", "text": "好吧，那是我腿上的黏液。所以，"}, {"type": "subtitle", "time": 2937.27, "timestamp": "00:48:57", "text": "就像猪身上滴着黏液一样"}, {"type": "subtitle", "time": 2939.43, "timestamp": "00:48:59", "text": "从他们口中。"}]
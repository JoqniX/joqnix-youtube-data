[{"type": "subtitle", "time": 1083.029, "timestamp": "00:18:03", "text": "我们之前发现的楼梯。我"}, {"type": "subtitle", "time": 1085.11, "timestamp": "00:18:05", "text": "我没能跟上他们。"}, {"type": "subtitle", "time": 1086.95, "timestamp": "00:18:06", "text": "嗯。"}, {"type": "subtitle", "time": 1089.029, "timestamp": "00:18:09", "text": "哦好的。嗯，我们现在就在这里。"}, {"type": "subtitle", "time": 1091.909, "timestamp": "00:18:11", "text": "去。快点，下到地牢里去。"}, {"type": "subtitle", "time": 1094.15, "timestamp": "00:18:14", "text": "我这就开始行军"}, {"type": "subtitle", "time": 1095.99, "timestamp": "00:18:15", "text": "向前迈进。"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "看来我们得下到地牢去了。"}, {"type": "subtitle", "time": 1098.63, "timestamp": "00:18:18", "text": "前往地牢。"}, {"type": "subtitle", "time": 1099.909, "timestamp": "00:18:19", "text": "我们走吧。"}, {"type": "subtitle", "time": 1102.39, "timestamp": "00:18:22", "text": "是的。是的。好的。好的。好的。还，"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "对了，在你之前还有一件事要说。"}, {"type": "subtitle", "time": 1106.71, "timestamp": "00:18:26", "text": "继续。我希望你们所有人，每个人，"}, {"type": "subtitle", "time": 1108.87, "timestamp": "00:18:28", "text": "给我来个盲掷。比如，所以你不能"}, {"type": "subtitle", "time": 1110.71, "timestamp": "00:18:30", "text": "我能看到它，但我能看出来。给我点赞"}, {"type": "subtitle", "time": 1113.43, "timestamp": "00:18:33", "text": "3d 100。这将是你的种子。"}, {"type": "subtitle", "time": 1116.15, "timestamp": "00:18:36", "text": "我一直都像3D 100一样。"}, {"type": "subtitle", "time": 1117.43, "timestamp": "00:18:37", "text": "是的，3D 100。"}, {"type": "subtitle", "time": 1118.71, "timestamp": "00:18:38", "text": "盲掷GM骰子。"}, {"type": "subtitle", "time": 1120.87, "timestamp": "00:18:40", "text": "是的，GM盲掷骰子。记住？好的。我"}, {"type": "subtitle", "time": 1122.95, "timestamp": "00:18:42", "text": "大概"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "谢谢。"}, {"type": "subtitle", "time": 1127.27, "timestamp": "00:18:47", "text": "好的。是的。呃，100。"}, {"type": "subtitle", "time": 1131.75, "timestamp": "00:18:51", "text": "没错，1 对 100。改成 3 对 100。是的。"}, {"type": "subtitle", "time": 1134.31, "timestamp": "00:18:54", "text": "我的笔到底去哪儿了？"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "我的笔坏了。"}, {"type": "subtitle", "time": 1137.27, "timestamp": "00:18:57", "text": "呃，笔走了。我在开玩笑。"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "顺便一提，对于其他不了解情况的人来说……"}]
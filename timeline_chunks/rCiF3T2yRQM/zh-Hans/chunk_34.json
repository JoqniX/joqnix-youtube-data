[{"type": "subtitle", "time": 2040.63, "timestamp": "00:34:00", "text": "滴答声意义重大。"}, {"type": "subtitle", "time": 2042.31, "timestamp": "00:34:02", "text": "哇，我的游戏加载不出来。我需要"}, {"type": "subtitle", "time": 2043.029, "timestamp": "00:34:03", "text": "重新启动。"}, {"type": "subtitle", "time": 2045.029, "timestamp": "00:34:05", "text": "是的，试试刷新一下。尽量"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "刷新。还有，呃，谢谢你"}, {"type": "subtitle", "time": 2050.71, "timestamp": "00:34:10", "text": "提前订阅。呃，我，我"}, {"type": "subtitle", "time": 2052.31, "timestamp": "00:34:12", "text": "不记得名字了。所以，我就是你"}, {"type": "subtitle", "time": 2053.589, "timestamp": "00:34:13", "text": "知道什么？为此，我打算……"}, {"type": "subtitle", "time": 2055.109, "timestamp": "00:34:15", "text": "给你，你知道吗，Tick，你会得到"}, {"type": "subtitle", "time": 2057.589, "timestamp": "00:34:17", "text": "从那次订阅中获得了灵感。"}, {"type": "subtitle", "time": 2061.03, "timestamp": "00:34:21", "text": "万岁！ Tick 的灵感来源于故事。"}, {"type": "subtitle", "time": 2063.19, "timestamp": "00:34:23", "text": "灵感迸发。耶。"}, {"type": "subtitle", "time": 2065.349, "timestamp": "00:34:25", "text": "灵感迸发。"}, {"type": "subtitle", "time": 2066.23, "timestamp": "00:34:26", "text": "这就是灵感。"}, {"type": "subtitle", "time": 2068.71, "timestamp": "00:34:28", "text": "岩石。你激励了Tick多吃东西。"}, {"type": "subtitle", "time": 2069.43, "timestamp": "00:34:29", "text": "岩石。"}, {"type": "subtitle", "time": 2070.79, "timestamp": "00:34:30", "text": "当然。"}, {"type": "subtitle", "time": 2073.589, "timestamp": "00:34:33", "text": "请不要再吃石头了。"}, {"type": "subtitle", "time": 2076.149, "timestamp": "00:34:36", "text": "那是一种健康"}, {"type": "subtitle", "time": 2078.55, "timestamp": "00:34:38", "text": "如果您订阅。"}, {"type": "subtitle", "time": 2087.109, "timestamp": "00:34:47", "text": "告诉我你们有没有喜欢的直播"}, {"type": "subtitle", "time": 2088.31, "timestamp": "00:34:48", "text": "因为我要发起这个活动"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "人走了。"}, {"type": "subtitle", "time": 2095.909, "timestamp": "00:34:55", "text": "太可怕了。我甚至不知道那是什么。"}, {"type": "subtitle", "time": 2097.19, "timestamp": "00:34:57", "text": "方法。"}]
[{"type": "subtitle", "time": 8647.83, "timestamp": "02:24:07", "text": "你刚才把我儿子拉了出来。"}, {"type": "subtitle", "time": 8651.27, "timestamp": "02:24:11", "text": "艾瑞安，我不喜欢这个东西。"}, {"type": "subtitle", "time": 8653.76, "timestamp": "02:24:13", "text": "这个东西。 我的天啊。"}, {"type": "subtitle", "time": 8654.8, "timestamp": "02:24:14", "text": "我的天啊。 我不喜欢这东西说话。"}, {"type": "subtitle", "time": 8656.64, "timestamp": "02:24:16", "text": "我不喜欢这东西说话。 那些关于我儿子的破事。"}, {"type": "subtitle", "time": 8665.03, "timestamp": "02:24:25", "text": "我会确保你知道什么？"}, {"type": "subtitle", "time": 8666.389, "timestamp": "02:24:26", "text": "好的。"}, {"type": "subtitle", "time": 8671.03, "timestamp": "02:24:31", "text": "我会记住这件事。"}, {"type": "subtitle", "time": 8674.309, "timestamp": "02:24:34", "text": "好的，这个东西，这个东西会动。"}, {"type": "subtitle", "time": 8676.63, "timestamp": "02:24:36", "text": "没有察觉到月光。糟糕。不是"}, {"type": "subtitle", "time": 8677.99, "timestamp": "02:24:37", "text": "在那边。坚持，稍等。让我回去"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "一。好了。移动，然后它"}, {"type": "subtitle", "time": 8682.23, "timestamp": "02:24:42", "text": "受到月光攻击而受伤。所以，"}, {"type": "subtitle", "time": 8686.87, "timestamp": "02:24:46", "text": "是的。"}, {"type": "subtitle", "time": 8689.91, "timestamp": "02:24:49", "text": "滚我吧，月光"}, {"type": "subtitle", "time": 8693.99, "timestamp": "02:24:53", "text": "再次没有造成任何损坏。就这么做吧。"}, {"type": "subtitle", "time": 8697.349, "timestamp": "02:24:57", "text": "你也可以只做 210。"}]
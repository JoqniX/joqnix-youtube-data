[{"type": "subtitle", "time": 7801.91, "timestamp": "02:10:01", "text": "攻击。"}, {"type": "subtitle", "time": 7805.27, "timestamp": "02:10:05", "text": "我不这么认为。"}, {"type": "subtitle", "time": 7807.109, "timestamp": "02:10:07", "text": "除非有人想告诉我我的确是。"}, {"type": "subtitle", "time": 7811.83, "timestamp": "02:10:11", "text": "呃，你试着检测一下。你？"}, {"type": "subtitle", "time": 7814.55, "timestamp": "02:10:14", "text": "所以，不。"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "目前看来还不是这样。"}, {"type": "subtitle", "time": 7818.069, "timestamp": "02:10:18", "text": "是的，他们不。"}, {"type": "subtitle", "time": 7819.189, "timestamp": "02:10:19", "text": "这里是德文郡。"}, {"type": "subtitle", "time": 7822.629, "timestamp": "02:10:22", "text": "我的天哪，是我。"}, {"type": "subtitle", "time": 7825.91, "timestamp": "02:10:25", "text": "真是个男人。"}, {"type": "subtitle", "time": 7827.75, "timestamp": "02:10:27", "text": "总之，他要去指导……"}, {"type": "subtitle", "time": 7830.55, "timestamp": "02:10:30", "text": "船。"}, {"type": "subtitle", "time": 7834.149, "timestamp": "02:10:34", "text": "点击引导船与这家人一起航行。"}, {"type": "subtitle", "time": 7835.27, "timestamp": "02:10:35", "text": "嗯，"}, {"type": "subtitle", "time": 7837.109, "timestamp": "02:10:37", "text": "当螺栓处于导向状态时。"}, {"type": "subtitle", "time": 7842.709, "timestamp": "02:10:42", "text": "不小心用掉了一个"}, {"type": "subtitle", "time": 7844.39, "timestamp": "02:10:44", "text": "前。感到困惑。"}, {"type": "subtitle", "time": 7846.31, "timestamp": "02:10:46", "text": "哦，是的。是的，你只需点击一下即可。"}, {"type": "subtitle", "time": 7848.39, "timestamp": "02:10:48", "text": "我可以退款。"}, {"type": "subtitle", "time": 7849.589, "timestamp": "02:10:49", "text": "哦，我已经"}]
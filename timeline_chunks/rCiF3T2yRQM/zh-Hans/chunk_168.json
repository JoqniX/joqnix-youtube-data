[{"type": "subtitle", "time": 10081.11, "timestamp": "02:48:01", "text": "好的。好的。好的。克里斯彭"}, {"type": "subtitle", "time": 10083.349, "timestamp": "02:48:03", "text": "去那边去，嗯，你可以等。"}, {"type": "subtitle", "time": 10084.87, "timestamp": "02:48:04", "text": "你能看到克里斯彭所看到的吗？"}, {"type": "subtitle", "time": 10085.99, "timestamp": "02:48:05", "text": "是的，我可以。我可以。"}, {"type": "subtitle", "time": 10088.07, "timestamp": "02:48:08", "text": "是的。是的。好的。好的。这边，"}, {"type": "subtitle", "time": 10090.71, "timestamp": "02:48:10", "text": "呃，我打算给你演示一下。有"}, {"type": "subtitle", "time": 10093.19, "timestamp": "02:48:13", "text": "呃，让我……让我展示……让我揭示一下"}, {"type": "subtitle", "time": 10106.15, "timestamp": "02:48:26", "text": "下面还有一大堆史莱姆。"}, {"type": "subtitle", "time": 10107.59, "timestamp": "02:48:27", "text": "我还要假设克里斯平是"}, {"type": "subtitle", "time": 10112.389, "timestamp": "02:48:32", "text": "那里看不见。在这方面。是的，"}, {"type": "subtitle", "time": 10115.19, "timestamp": "02:48:35", "text": "通常来说，那里有很多史莱姆和一个"}, {"type": "subtitle", "time": 10118.23, "timestamp": "02:48:38", "text": "你们很多人因为呃"}, {"type": "subtitle", "time": 10121.91, "timestamp": "02:48:41", "text": "如果我们进去，我们的衣服会"}, {"type": "subtitle", "time": 10128.87, "timestamp": "02:48:48", "text": "我简直不敢相信对方球队竟然留下了这个。"}, {"type": "subtitle", "time": 10130.71, "timestamp": "02:48:50", "text": "对我们来说。"}, {"type": "subtitle", "time": 10133.99, "timestamp": "02:48:53", "text": "我真的不喜欢这不是一个"}, {"type": "subtitle", "time": 10137.03, "timestamp": "02:48:57", "text": "今天，我终于体验到了我想要的那种感觉。我有"}, {"type": "subtitle", "time": 10139.51, "timestamp": "02:48:59", "text": "我的衣服都很贵。这是"}]
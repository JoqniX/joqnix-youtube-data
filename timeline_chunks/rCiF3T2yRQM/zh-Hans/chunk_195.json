[{"type": "subtitle", "time": 11702.63, "timestamp": "03:15:02", "text": "好的。嗯，好的。嗯，去做吧"}, {"type": "subtitle", "time": 11705.269, "timestamp": "03:15:05", "text": "呼吸困难。呼气。"}, {"type": "subtitle", "time": 11708.309, "timestamp": "03:15:08", "text": "如果你点击面包，呃，就是龙的"}, {"type": "subtitle", "time": 11713.429, "timestamp": "03:15:13", "text": "面包，就像呼气一样。"}, {"type": "subtitle", "time": 11715.75, "timestamp": "03:15:15", "text": "那小弟弟呢？"}, {"type": "subtitle", "time": 11718.229, "timestamp": "03:15:18", "text": "哦，我想"}, {"type": "subtitle", "time": 11720.229, "timestamp": "03:15:20", "text": "哦。呃，好的。坚持，稍等。我会退款"}, {"type": "subtitle", "time": 11721.67, "timestamp": "03:15:21", "text": "因为你应该点击"}, {"type": "subtitle", "time": 11723.03, "timestamp": "03:15:23", "text": "呃，这叫什么来着？我会退款的。"}, {"type": "subtitle", "time": 11726.63, "timestamp": "03:15:26", "text": "资源。只需点击呼气按钮。它是"}, {"type": "subtitle", "time": 11727.99, "timestamp": "03:15:27", "text": "如果你点击普通面包，它"}, {"type": "subtitle", "time": 11729.51, "timestamp": "03:15:29", "text": "它应该给出演员表还是其他什么？"}, {"type": "subtitle", "time": 11731.11, "timestamp": "03:15:31", "text": "呼气。"}, {"type": "subtitle", "time": 11732.389, "timestamp": "03:15:32", "text": "那是呼气。"}, {"type": "subtitle", "time": 11733.75, "timestamp": "03:15:33", "text": "哦，他呼出了一口气。哦，我真希望如此。"}, {"type": "subtitle", "time": 11735.75, "timestamp": "03:15:35", "text": "我试试点击它。呃，为什么"}, {"type": "subtitle", "time": 11738.229, "timestamp": "03:15:38", "text": "它会消耗法术位吗？真奇怪。我是"}, {"type": "subtitle", "time": 11740.389, "timestamp": "03:15:40", "text": "就因为它应该占用法术位。"}, {"type": "subtitle", "time": 11742.55, "timestamp": "03:15:42", "text": "随便吧。嗯，是的，我这就全部"}, {"type": "subtitle", "time": 11746.229, "timestamp": "03:15:46", "text": "正确的。嗯，好的。呃，掷骰子决定伤害值。"}, {"type": "subtitle", "time": 11749.99, "timestamp": "03:15:49", "text": "对，要么选 Take，要么选 Ariana。爱莉安娜，为什么？"}, {"type": "subtitle", "time": 11752.469, "timestamp": "03:15:52", "text": "不是？阿丽亚娜，点击掷骰子决定伤害。全部"}, {"type": "subtitle", "time": 11754.15, "timestamp": "03:15:54", "text": "正确的。"}, {"type": "subtitle", "time": 11756.55, "timestamp": "03:15:56", "text": "美好的。好的。好的。"}]
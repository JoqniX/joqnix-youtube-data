[{"type": "subtitle", "time": 4980.07, "timestamp": "01:23:00", "text": "像海洋一样​​。"}, {"type": "subtitle", "time": 4982.229, "timestamp": "01:23:02", "text": "好的。好的。我会用你的"}, {"type": "subtitle", "time": 4985.51, "timestamp": "01:23:05", "text": "灵感来源。好的。然后呃"}, {"type": "subtitle", "time": 4987.669, "timestamp": "01:23:07", "text": "你会像……一样提升你吗？"}, {"type": "subtitle", "time": 4993.43, "timestamp": "01:23:13", "text": "不，我只是想把它从我身边移开。"}, {"type": "subtitle", "time": 4995.91, "timestamp": "01:23:15", "text": "这样我就可以试着去获得"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "更近了。"}, {"type": "subtitle", "time": 4999.59, "timestamp": "01:23:19", "text": "试着靠近些。你是什​​么意思？"}, {"type": "subtitle", "time": 4999.99, "timestamp": "01:23:19", "text": "比如什么？"}, {"type": "subtitle", "time": 5001.51, "timestamp": "01:23:21", "text": "我只是想走近一点。我只是"}, {"type": "subtitle", "time": 5003.59, "timestamp": "01:23:23", "text": "想走。哦，你知道我会的"}, {"type": "subtitle", "time": 5005.27, "timestamp": "01:23:25", "text": "会让你这么做，因为那真是太……"}, {"type": "subtitle", "time": 5007.99, "timestamp": "01:23:27", "text": "真是个好主意。我会让你……就像"}, {"type": "subtitle", "time": 5011.11, "timestamp": "01:23:31", "text": "请尽情享受这种感觉。"}, {"type": "subtitle", "time": 5012.39, "timestamp": "01:23:32", "text": "可以从这边出去。"}, {"type": "subtitle", "time": 5015.59, "timestamp": "01:23:35", "text": "是的。是的。你出局了。"}, {"type": "subtitle", "time": 5018.149, "timestamp": "01:23:38", "text": "好的。"}, {"type": "subtitle", "time": 5018.47, "timestamp": "01:23:38", "text": "是的。"}, {"type": "subtitle", "time": 5022.39, "timestamp": "01:23:42", "text": "所以钴可以促进血液循环。我"}, {"type": "subtitle", "time": 5023.43, "timestamp": "01:23:43", "text": "好的。你知道"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "太诡异了。"}, {"type": "subtitle", "time": 5026.87, "timestamp": "01:23:46", "text": "他是我认识的那些血族操控者之一。"}, {"type": "subtitle", "time": 5028.79, "timestamp": "01:23:48", "text": "听说过。"}, {"type": "subtitle", "time": 5032.07, "timestamp": "01:23:52", "text": "曾经有那么一次，你喜欢的那种感觉很突出，"}, {"type": "subtitle", "time": 5033.75, "timestamp": "01:23:53", "text": "你会注意到这个房间一开始是这样的"}, {"type": "subtitle", "time": 5036.629, "timestamp": "01:23:56", "text": "下着像奇怪液体一样的雨。"}, {"type": "subtitle", "time": 5038.31, "timestamp": "01:23:58", "text": "呃。"}]
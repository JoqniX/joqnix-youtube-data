[{"type": "subtitle", "time": 10921.03, "timestamp": "03:02:01", "text": "我没弄错，呃，在龙版块上，"}, {"type": "subtitle", "time": 10922.71, "timestamp": "03:02:02", "text": "这是额外行动，但我忘了。"}, {"type": "subtitle", "time": 10924.95, "timestamp": "03:02:04", "text": "对我来说，这算什么行动。"}, {"type": "subtitle", "time": 10928.87, "timestamp": "03:02:08", "text": "让我查一下。嗯嗯"}, {"type": "subtitle", "time": 10932.71, "timestamp": "03:02:12", "text": "坚持，稍等。让我检查一下整个区块。"}, {"type": "subtitle", "time": 10934.79, "timestamp": "03:02:14", "text": "嗯，"}, {"type": "subtitle", "time": 10937.67, "timestamp": "03:02:17", "text": "你能把它搬走吗？坚持，稍等。呃，拿走"}, {"type": "subtitle", "time": 10939.269, "timestamp": "03:02:19", "text": "魔法动作。哦，它必须是一种魔法。"}, {"type": "subtitle", "time": 10940.55, "timestamp": "03:02:20", "text": "行动。所以，这就是一个"}, {"type": "subtitle", "time": 10941.99, "timestamp": "03:02:21", "text": "那我下次轮到我的时候就做。"}, {"type": "subtitle", "time": 10943.11, "timestamp": "03:02:23", "text": "是的。是的。"}, {"type": "subtitle", "time": 10944.87, "timestamp": "03:02:24", "text": "好的。那我猜我会的，因为我"}, {"type": "subtitle", "time": 10947.99, "timestamp": "03:02:27", "text": "消耗掉我的攻击力，所以我会"}, {"type": "subtitle", "time": 10951.03, "timestamp": "03:02:31", "text": "好的，下一个。你是？你想吗？"}, {"type": "subtitle", "time": 10951.91, "timestamp": "03:02:31", "text": "抵抗？"}, {"type": "subtitle", "time": 10953.51, "timestamp": "03:02:33", "text": "呃，不。"}, {"type": "subtitle", "time": 10959.51, "timestamp": "03:02:39", "text": "我们就像在这个巨大的空间里一样待在这里。"}, {"type": "subtitle", "time": 10961.59, "timestamp": "03:02:41", "text": "生物摧毁了它们，就像免疫一样，或者"}, {"type": "subtitle", "time": 10966.95, "timestamp": "03:02:46", "text": "这些都是消化酶。"}, {"type": "subtitle", "time": 10974.71, "timestamp": "03:02:54", "text": "我的天哪。好的，下一个。你的"}, {"type": "subtitle", "time": 10976.63, "timestamp": "03:02:56", "text": "行动？"}, {"type": "subtitle", "time": 10978.23, "timestamp": "03:02:58", "text": "呃"}]
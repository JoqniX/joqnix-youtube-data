[{"type": "subtitle", "time": 11163.429, "timestamp": "03:06:03", "text": "[音乐]"}, {"type": "subtitle", "time": 11164.71, "timestamp": "03:06:04", "text": "好的。"}, {"type": "subtitle", "time": 11167.269, "timestamp": "03:06:07", "text": "哦，我的月光"}, {"type": "subtitle", "time": 11169.51, "timestamp": "03:06:09", "text": "好像是关机了之类的。"}, {"type": "subtitle", "time": 11172.87, "timestamp": "03:06:12", "text": "呃，你的月亮，你的光芒，依然在那里。"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "呃，再来一轮，除非你想的话"}, {"type": "subtitle", "time": 11176.71, "timestamp": "03:06:16", "text": "驳回它。"}, {"type": "subtitle", "time": 11178.63, "timestamp": "03:06:18", "text": "[音乐]"}, {"type": "subtitle", "time": 11180.63, "timestamp": "03:06:20", "text": "所以，我可以像先生一样，我们都可以移动。"}, {"type": "subtitle", "time": 11181.83, "timestamp": "03:06:21", "text": "现在前进。"}, {"type": "subtitle", "time": 11183.99, "timestamp": "03:06:23", "text": "我的天哪。那我就驳回它。"}, {"type": "subtitle", "time": 11186.389, "timestamp": "03:06:26", "text": "好的。是的。我刚刚才意识到这一点。"}, {"type": "subtitle", "time": 11187.51, "timestamp": "03:06:27", "text": "所以，是的，我直接解雇了他。"}, {"type": "subtitle", "time": 11195.03, "timestamp": "03:06:35", "text": "我完成了。"}, {"type": "subtitle", "time": 11196.309, "timestamp": "03:06:36", "text": "还要别的吗？你想搬家吗？"}, {"type": "subtitle", "time": 11197.03, "timestamp": "03:06:37", "text": "或许？"}, {"type": "subtitle", "time": 11205.59, "timestamp": "03:06:45", "text": "30英尺。嗯，到底好多少？如何？好的。 30"}, {"type": "subtitle", "time": 11208.63, "timestamp": "03:06:48", "text": "英尺。我就搬到这里来。"}, {"type": "subtitle", "time": 11210.55, "timestamp": "03:06:50", "text": "好的。心之所爱。"}, {"type": "subtitle", "time": 11212.95, "timestamp": "03:06:52", "text": "记住，你也会……"}, {"type": "subtitle", "time": 11215.83, "timestamp": "03:06:55", "text": "你知道墙壁会是"}, {"type": "subtitle", "time": 11219.51, "timestamp": "03:06:59", "text": "想吃掉你，呃，待会儿或者把你搬走"}]
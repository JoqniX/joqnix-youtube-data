[{"type": "subtitle", "time": 11821.03, "timestamp": "03:17:01", "text": "这些东西。"}, {"type": "subtitle", "time": 11823.03, "timestamp": "03:17:03", "text": "我觉得肯定有什么大事要发生。"}, {"type": "subtitle", "time": 11825.269, "timestamp": "03:17:05", "text": "在那个该死的粪坑里。"}, {"type": "subtitle", "time": 11826.63, "timestamp": "03:17:06", "text": "对，我就是这个意思。我不"}, {"type": "subtitle", "time": 11828.15, "timestamp": "03:17:08", "text": "我觉得我应该现在就把它浪费掉。"}, {"type": "subtitle", "time": 11829.83, "timestamp": "03:17:09", "text": "简直就是个粪坑。"}, {"type": "subtitle", "time": 11838.79, "timestamp": "03:17:18", "text": "好了，乔，你得……你得让开。"}, {"type": "subtitle", "time": 11840.469, "timestamp": "03:17:20", "text": "这里。哦，是的。等等，稍等。我忘了"}, {"type": "subtitle", "time": 11842.87, "timestamp": "03:17:22", "text": "你有你的，是的，我会说你可以"}, {"type": "subtitle", "time": 11844.55, "timestamp": "03:17:24", "text": "如果你想反抗，你可以自由地反抗。"}, {"type": "subtitle", "time": 11847.67, "timestamp": "03:17:27", "text": "拒绝进行任何类似检查，因为你"}, {"type": "subtitle", "time": 11849.99, "timestamp": "03:17:29", "text": "既然你已经把你的东西种在了"}, {"type": "subtitle", "time": 11851.03, "timestamp": "03:17:31", "text": "地面。"}, {"type": "subtitle", "time": 11853.19, "timestamp": "03:17:33", "text": "我想带上我的东西，然后我"}, {"type": "subtitle", "time": 11855.19, "timestamp": "03:17:35", "text": "想搬家。"}, {"type": "subtitle", "time": 11857.349, "timestamp": "03:17:37", "text": "好的。是的。是的。就像你一样"}, {"type": "subtitle", "time": 11858.71, "timestamp": "03:17:38", "text": "让你被事物所感动。全部"}, {"type": "subtitle", "time": 11860.389, "timestamp": "03:17:40", "text": "正确的。"}, {"type": "subtitle", "time": 11872.63, "timestamp": "03:17:52", "text": "事情要糟透了。"}, {"type": "subtitle", "time": 11875.269, "timestamp": "03:17:55", "text": "字面上地"}, {"type": "subtitle", "time": 11877.51, "timestamp": "03:17:57", "text": "最终还是他妈的出来了"}, {"type": "subtitle", "time": 11879.19, "timestamp": "03:17:59", "text": "去他妈的混蛋。我会像我一样"}]
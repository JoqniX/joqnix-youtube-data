[{"type": "subtitle", "time": 9546.14, "timestamp": "02:39:06", "text": "因此，我的回合就到此为止。"}, {"type": "subtitle", "time": 9548.309, "timestamp": "02:39:08", "text": "[音乐]"}, {"type": "subtitle", "time": 9551.91, "timestamp": "02:39:11", "text": "我的天啊。好的。等等。好的。"}, {"type": "subtitle", "time": 9554.23, "timestamp": "02:39:14", "text": "我打算再确认一下，因为我觉得"}, {"type": "subtitle", "time": 9556.87, "timestamp": "02:39:16", "text": "呃，等等。我忘了。我只想"}, {"type": "subtitle", "time": 9558.63, "timestamp": "02:39:18", "text": "立即核实一遍。呃，在哪儿？"}, {"type": "subtitle", "time": 9560.87, "timestamp": "02:39:20", "text": "它？月光在哪儿？"}, {"type": "subtitle", "time": 9563.91, "timestamp": "02:39:23", "text": "因为我忘了是不是像转弯时那样，或者"}, {"type": "subtitle", "time": 9572.63, "timestamp": "02:39:32", "text": "一个生物只有不同的技能领域"}, {"type": "subtitle", "time": 9574.63, "timestamp": "02:39:34", "text": "空间以及它进入技能区域时"}, {"type": "subtitle", "time": 9576.87, "timestamp": "02:39:36", "text": "然后结束了这一轮。好的。所以它就是这样。"}, {"type": "subtitle", "time": 9579.75, "timestamp": "02:39:39", "text": "安全装置位于转弯端。好的。"}, {"type": "subtitle", "time": 9583.59, "timestamp": "02:39:43", "text": "知道了。嗯，好的。呃，黏液是"}, {"type": "subtitle", "time": 9584.469, "timestamp": "02:39:44", "text": "这里。"}, {"type": "subtitle", "time": 9588.389, "timestamp": "02:39:48", "text": "是的。然后就像黏液仍然……"}, {"type": "subtitle", "time": 9590.87, "timestamp": "02:39:50", "text": "记得爱莉安娜身材有多丰满。所以"}, {"type": "subtitle", "time": 9591.99, "timestamp": "02:39:51", "text": "这次他打算尝试一下"}, {"type": "subtitle", "time": 9593.19, "timestamp": "02:39:53", "text": "厚的。"}, {"type": "subtitle", "time": 9594.79, "timestamp": "02:39:54", "text": "我的天啊。"}, {"type": "subtitle", "time": 9597.11, "timestamp": "02:39:57", "text": "哦，不。镐和蜱。"}, {"type": "subtitle", "time": 9599.51, "timestamp": "02:39:59", "text": "是啊，滴答滴答。"}]
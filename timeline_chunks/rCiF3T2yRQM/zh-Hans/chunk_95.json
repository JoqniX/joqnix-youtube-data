[{"type": "subtitle", "time": 5701.27, "timestamp": "01:35:01", "text": "再次？进入尸体。而且似乎"}, {"type": "subtitle", "time": 5707.91, "timestamp": "01:35:07", "text": "几乎要长大了。它四处传播，"}, {"type": "subtitle", "time": 5710.55, "timestamp": "01:35:10", "text": "现在有更多的黑色液体和一些"}, {"type": "subtitle", "time": 5712.709, "timestamp": "01:35:12", "text": "上面有蓝色液体。"}, {"type": "subtitle", "time": 5715.27, "timestamp": "01:35:15", "text": "哦。"}, {"type": "subtitle", "time": 5719.75, "timestamp": "01:35:19", "text": "嗯。嗯？蓝色液体正在形成"}, {"type": "subtitle", "time": 5721.43, "timestamp": "01:35:21", "text": "那。"}, {"type": "subtitle", "time": 5723.35, "timestamp": "01:35:23", "text": "嘿，"}, {"type": "subtitle", "time": 5725.669, "timestamp": "01:35:25", "text": "也许这只是一种理论。你"}, {"type": "subtitle", "time": 5727.91, "timestamp": "01:35:27", "text": "想想那一大堆黑色的污泥和"}, {"type": "subtitle", "time": 5731.669, "timestamp": "01:35:31", "text": "蓝色污泥，那个容器在一个"}, {"type": "subtitle", "time": 5735.75, "timestamp": "01:35:35", "text": "被这东西卖掉的尸体？"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "大概会是这样的，"}, {"type": "subtitle", "time": 5740.229, "timestamp": "01:35:40", "text": "“莲花大师，您怎么看？”和"}, {"type": "subtitle", "time": 5741.91, "timestamp": "01:35:41", "text": "他会说：“嗯，在我的……”"}, {"type": "subtitle", "time": 5744.95, "timestamp": "01:35:44", "text": "多年来，我见过很多种液体，但是"}, {"type": "subtitle", "time": 5748.07, "timestamp": "01:35:48", "text": "这当然是其中之一。绝对的"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "对那些尸体做了些什么，"}, {"type": "subtitle", "time": 5751.99, "timestamp": "01:35:51", "text": "将它们分成两种不同的形式"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "但他们的目的究竟是什么，目前还不得而知。"}]
[{"type": "subtitle", "time": 9121.349, "timestamp": "02:32:01", "text": "对史莱姆造成更多伤害。"}, {"type": "subtitle", "time": 9123.83, "timestamp": "02:32:03", "text": "它是否对当前情况造成损害"}, {"type": "subtitle", "time": 9126.15, "timestamp": "02:32:06", "text": "史莱姆或"}, {"type": "subtitle", "time": 9132.71, "timestamp": "02:32:12", "text": "先把那个东西拿走，然后再把它移回来。"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "是的。"}, {"type": "subtitle", "time": 9134.389, "timestamp": "02:32:14", "text": "它会再次发生这种情况吗？"}, {"type": "subtitle", "time": 9135.75, "timestamp": "02:32:15", "text": "想把它挪动一下。我就让你滚吧。"}, {"type": "subtitle", "time": 9137.51, "timestamp": "02:32:17", "text": "立即地。"}, {"type": "subtitle", "time": 9141.03, "timestamp": "02:32:21", "text": "它会再次发生这种情况吗？比如损坏它？"}, {"type": "subtitle", "time": 9143.99, "timestamp": "02:32:23", "text": "是的。是的。好的。所以，2D"}, {"type": "subtitle", "time": 9152.95, "timestamp": "02:32:32", "text": "呃，原始2D，2D是什么来着？"}, {"type": "subtitle", "time": 9153.99, "timestamp": "02:32:33", "text": "2d10。"}, {"type": "subtitle", "time": 9155.67, "timestamp": "02:32:35", "text": "2D10。"}, {"type": "subtitle", "time": 9156.95, "timestamp": "02:32:36", "text": "我也想确认一下。"}, {"type": "subtitle", "time": 9158.469, "timestamp": "02:32:38", "text": "迅速地。坚持，稍等。让我再加倍"}, {"type": "subtitle", "time": 9160.15, "timestamp": "02:32:40", "text": "检查一下，因为我忘了如果"}, {"type": "subtitle", "time": 9161.91, "timestamp": "02:32:41", "text": "他们已经进去了。我忘了他们是否……"}, {"type": "subtitle", "time": 9163.67, "timestamp": "02:32:43", "text": "是否喜欢这个保险箱。让我"}, {"type": "subtitle", "time": 9165.03, "timestamp": "02:32:45", "text": "再确认一下。我认为他们会的，但是"}, {"type": "subtitle", "time": 9169.91, "timestamp": "02:32:49", "text": "我只是想确认一下。嗯"}, {"type": "subtitle", "time": 9173.11, "timestamp": "02:32:53", "text": "这样就变得不安全了。好的。好的。"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "不安全。他还制作了序列"}, {"type": "subtitle", "time": 9177.27, "timestamp": "02:32:57", "text": "将区域拼写到空间。好的。是的，"}, {"type": "subtitle", "time": 9178.309, "timestamp": "02:32:58", "text": "它确实能确保安全。我这就去"}]
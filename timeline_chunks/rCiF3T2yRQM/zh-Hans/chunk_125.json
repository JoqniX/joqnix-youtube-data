[{"type": "subtitle", "time": 7500.629, "timestamp": "02:05:00", "text": "我有仙女之火。"}, {"type": "subtitle", "time": 7502.229, "timestamp": "02:05:02", "text": "你可以改变准备工作"}, {"type": "subtitle", "time": 7503.669, "timestamp": "02:05:03", "text": "如果你想准备的话，因为你确实有。"}, {"type": "subtitle", "time": 7505.99, "timestamp": "02:05:05", "text": "中途进行一次长时间的休息。"}, {"type": "subtitle", "time": 7507.43, "timestamp": "02:05:07", "text": "我已经做好了准备。"}, {"type": "subtitle", "time": 7509.589, "timestamp": "02:05:09", "text": "如果你想。"}, {"type": "subtitle", "time": 7511.99, "timestamp": "02:05:11", "text": "我不知道什么"}, {"type": "subtitle", "time": 7514.31, "timestamp": "02:05:14", "text": "因为复活只是以防万一。"}, {"type": "subtitle", "time": 7516.55, "timestamp": "02:05:16", "text": "比如队伍里有人死了，然后你"}, {"type": "subtitle", "time": 7518.47, "timestamp": "02:05:18", "text": "可以使他们复活。"}, {"type": "subtitle", "time": 7521.589, "timestamp": "02:05:21", "text": "哦，我可以做到。是的。"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "等等，它在哪儿？咒语。"}, {"type": "subtitle", "time": 7526.87, "timestamp": "02:05:26", "text": "它在二楼。"}, {"type": "subtitle", "time": 7529.189, "timestamp": "02:05:29", "text": "这是一个二级法术。哦不，对不起。"}, {"type": "subtitle", "time": 7530.629, "timestamp": "02:05:30", "text": "第三级。抱歉，我的错。我是"}, {"type": "subtitle", "time": 7533.109, "timestamp": "02:05:33", "text": "好困惑。我的想法是，把它具体化。第二"}, {"type": "subtitle", "time": 7533.669, "timestamp": "02:05:33", "text": "等级。"}, {"type": "subtitle", "time": 7535.99, "timestamp": "02:05:35", "text": "抱歉，我的错。我的大脑 我的大脑是"}, {"type": "subtitle", "time": 7538.709, "timestamp": "02:05:38", "text": "患有动脉瘤。"}, {"type": "subtitle", "time": 7542.149, "timestamp": "02:05:42", "text": "我昨晚没睡好。"}, {"type": "subtitle", "time": 7544.07, "timestamp": "02:05:44", "text": "我忘了。我晚上9点睡着了。"}, {"type": "subtitle", "time": 7547.109, "timestamp": "02:05:47", "text": "早上，大概一点钟就醒了。"}, {"type": "subtitle", "time": 7548.87, "timestamp": "02:05:48", "text": "下午。"}, {"type": "subtitle", "time": 7549.43, "timestamp": "02:05:49", "text": "是的，"}, {"type": "subtitle", "time": 7552.31, "timestamp": "02:05:52", "text": "我也有这种感觉。我下午3点醒了。"}, {"type": "subtitle", "time": 7554.709, "timestamp": "02:05:54", "text": "情绪。"}, {"type": "subtitle", "time": 7557.75, "timestamp": "02:05:57", "text": "我们走这条车道"}, {"type": "subtitle", "time": 7559.51, "timestamp": "02:05:59", "text": "靴子们团结起来。当然。"}]
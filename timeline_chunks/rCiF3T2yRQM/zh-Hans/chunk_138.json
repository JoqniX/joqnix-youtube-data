[{"type": "subtitle", "time": 8281.509, "timestamp": "02:18:01", "text": "好的。他们都成功了。就是这样。"}, {"type": "subtitle", "time": 8282.79, "timestamp": "02:18:02", "text": "如果我不在，伤害就会减半。"}, {"type": "subtitle", "time": 8284.549, "timestamp": "02:18:04", "text": "错误。成功。"}, {"type": "subtitle", "time": 8286.15, "timestamp": "02:18:06", "text": "好的。现在进行伤害判定。"}, {"type": "subtitle", "time": 8290.469, "timestamp": "02:18:10", "text": "哦，不。损害。"}, {"type": "subtitle", "time": 8292.389, "timestamp": "02:18:12", "text": "卷。"}, {"type": "subtitle", "time": 8295.27, "timestamp": "02:18:15", "text": "好的。我可以证明这一点吗？坚持，稍等。"}, {"type": "subtitle", "time": 8296.79, "timestamp": "02:18:16", "text": "向所有人公开。我这就应用这个。"}, {"type": "subtitle", "time": 8298.469, "timestamp": "02:18:18", "text": "立即通知所有人。所以，你不会"}, {"type": "subtitle", "time": 8300.469, "timestamp": "02:18:20", "text": "需要申请给克雷辛先生"}, {"type": "subtitle", "time": 8303.03, "timestamp": "02:18:23", "text": "再次。我们全部应用吧。开始了。"}, {"type": "subtitle", "time": 8306.389, "timestamp": "02:18:26", "text": "好的。嗯，好的。"}, {"type": "subtitle", "time": 8309.11, "timestamp": "02:18:29", "text": "让我快速地做一下。这棵树"}, {"type": "subtitle", "time": 8312.549, "timestamp": "02:18:32", "text": "呃，只有一种颜色。坚持，稍等。在那里"}, {"type": "subtitle", "time": 8315.429, "timestamp": "02:18:35", "text": "去。"}, {"type": "subtitle", "time": 8324.389, "timestamp": "02:18:44", "text": "我喜欢“哦，不”。不。"}, {"type": "subtitle", "time": 8325.91, "timestamp": "02:18:45", "text": "我的天哪。"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "别放在心上。"}, {"type": "subtitle", "time": 8330.87, "timestamp": "02:18:50", "text": "好吧，我想我该结束我的回合了。"}, {"type": "subtitle", "time": 8334.87, "timestamp": "02:18:54", "text": "好的。好的。下一根棍子。你是"}, {"type": "subtitle", "time": 8337.509, "timestamp": "02:18:57", "text": "向上。记住，月亮仍然……"}, {"type": "subtitle", "time": 8339.83, "timestamp": "02:18:59", "text": "那里。"}]
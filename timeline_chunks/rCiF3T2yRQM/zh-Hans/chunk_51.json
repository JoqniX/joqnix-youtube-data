[{"type": "subtitle", "time": 3066.63, "timestamp": "00:51:06", "text": "他们又吃了一只。"}, {"type": "subtitle", "time": 3070.79, "timestamp": "00:51:10", "text": "什么？霍布尔斯甚至还吃"}, {"type": "subtitle", "time": 3079.03, "timestamp": "00:51:19", "text": "是啊，真他妈的，就这么看着"}, {"type": "subtitle", "time": 3082.79, "timestamp": "00:51:22", "text": "书。钴到底吃什么？为什么只是"}, {"type": "subtitle", "time": 3084.549, "timestamp": "00:51:24", "text": "全部吃掉？"}, {"type": "subtitle", "time": 3085.91, "timestamp": "00:51:25", "text": "爱莉安娜会来参加这个比赛的"}, {"type": "subtitle", "time": 3087.51, "timestamp": "00:51:27", "text": "然后就好像她要去……"}, {"type": "subtitle", "time": 3088.87, "timestamp": "00:51:28", "text": "她要去四处看看。"}, {"type": "subtitle", "time": 3091.67, "timestamp": "00:51:31", "text": "确保范没注意，她也……"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "就像要像……一样刺她"}, {"type": "subtitle", "time": 3094.71, "timestamp": "00:51:34", "text": "她把手指伸进去一点点，就……"}, {"type": "subtitle", "time": 3096.39, "timestamp": "00:51:36", "text": "试着尝试一下。"}, {"type": "subtitle", "time": 3098.95, "timestamp": "00:51:38", "text": "我他妈的能感知到那玩意儿吗？"}, {"type": "subtitle", "time": 3100.549, "timestamp": "00:51:40", "text": "是的。是的。"}, {"type": "subtitle", "time": 3104.87, "timestamp": "00:51:44", "text": "感知与隐蔽。快点。"}, {"type": "subtitle", "time": 3108.63, "timestamp": "00:51:48", "text": "什么是感知与爱莉安娜的隐秘行动之间的区别？"}, {"type": "subtitle", "time": 3112.39, "timestamp": "00:51:52", "text": "好的，我要公开露面了。还有，你"}, {"type": "subtitle", "time": 3114.63, "timestamp": "00:51:54", "text": "仍然处于劣势，因为你有"}, {"type": "subtitle", "time": 3116.309, "timestamp": "00:51:56", "text": "板甲之类的东西。"}, {"type": "subtitle", "time": 3119.109, "timestamp": "00:51:59", "text": "妈的。"}]
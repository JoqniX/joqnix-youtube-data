[{"type": "subtitle", "time": 11761.83, "timestamp": "03:16:01", "text": "这"}, {"type": "subtitle", "time": 11766.63, "timestamp": "03:16:06", "text": "别想躲得远远的。他们只是"}, {"type": "subtitle", "time": 11769.59, "timestamp": "03:16:09", "text": "拿了它，但似乎没什么用。"}, {"type": "subtitle", "time": 11770.63, "timestamp": "03:16:10", "text": "和他们一起。"}, {"type": "subtitle", "time": 11772.71, "timestamp": "03:16:12", "text": "他们就只是放松休息。"}, {"type": "subtitle", "time": 11780.55, "timestamp": "03:16:20", "text": "呃"}, {"type": "subtitle", "time": 11789.51, "timestamp": "03:16:29", "text": "就像龙的吐息。"}, {"type": "subtitle", "time": 11791.19, "timestamp": "03:16:31", "text": "我刚才攻击了那里的那一个。哦，我的"}, {"type": "subtitle", "time": 11793.83, "timestamp": "03:16:33", "text": "上帝。好的。 19."}, {"type": "subtitle", "time": 11796.309, "timestamp": "03:16:36", "text": "很少有人会打人。掷骰子造成伤害。"}, {"type": "subtitle", "time": 11799.429, "timestamp": "03:16:39", "text": "好的。去。低滚。哦，豪赌一把。"}, {"type": "subtitle", "time": 11802.87, "timestamp": "03:16:42", "text": "哦好的。好的。不错的一掷。那里"}, {"type": "subtitle", "time": 11804.79, "timestamp": "03:16:44", "text": "你去。我们造成了破坏。你有"}, {"type": "subtitle", "time": 11808.469, "timestamp": "03:16:48", "text": "成功造成伤害。"}, {"type": "subtitle", "time": 11813.269, "timestamp": "03:16:53", "text": "好的。嗯，我应该……我想那感觉……"}, {"type": "subtitle", "time": 11815.99, "timestamp": "03:16:55", "text": "简直是浪费。我想我就此结束吧"}, {"type": "subtitle", "time": 11817.51, "timestamp": "03:16:57", "text": "轮到我了。我不想，我觉得我"}, {"type": "subtitle", "time": 11819.349, "timestamp": "03:16:59", "text": "不应该把我的神圣惩击浪费在……"}]
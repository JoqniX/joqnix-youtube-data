[{"type": "subtitle", "time": 10683.269, "timestamp": "02:58:03", "text": "呃，你，是的，你，你平常的样子"}, {"type": "subtitle", "time": 10684.87, "timestamp": "02:58:04", "text": "法术位等级为1级。你的黑色"}, {"type": "subtitle", "time": 10686.79, "timestamp": "02:58:06", "text": "魔法法术位等级为二级。"}, {"type": "subtitle", "time": 10688.87, "timestamp": "02:58:08", "text": "哇，太可怕了。"}, {"type": "subtitle", "time": 10691.75, "timestamp": "02:58:11", "text": "天哪，我真讨厌这些该死的……"}, {"type": "subtitle", "time": 10692.95, "timestamp": "02:58:12", "text": "现在这些生物。"}, {"type": "subtitle", "time": 10694.87, "timestamp": "02:58:14", "text": "我知道，对吧？"}, {"type": "subtitle", "time": 10700.15, "timestamp": "02:58:20", "text": "哇。简直毫无用处。"}, {"type": "subtitle", "time": 10703.66, "timestamp": "02:58:23", "text": "嗯，让我看看我能不能做到。"}, {"type": "subtitle", "time": 10706.469, "timestamp": "02:58:26", "text": "[音乐]"}, {"type": "subtitle", "time": 10708.55, "timestamp": "02:58:28", "text": "好的。"}, {"type": "subtitle", "time": 10715.349, "timestamp": "02:58:35", "text": "我们走吧。我心中的怀抱。"}, {"type": "subtitle", "time": 10717.67, "timestamp": "02:58:37", "text": "好的。让我们来看看。"}, {"type": "subtitle", "time": 10718.71, "timestamp": "02:58:38", "text": "他要取消行程。"}, {"type": "subtitle", "time": 10721.67, "timestamp": "02:58:41", "text": "是的，这都是你搞的鬼。我"}, {"type": "subtitle", "time": 10723.67, "timestamp": "02:58:43", "text": "我认为它可能源于熟悉的事物。"}, {"type": "subtitle", "time": 10723.99, "timestamp": "02:58:43", "text": "思考。"}, {"type": "subtitle", "time": 10725.91, "timestamp": "02:58:45", "text": "是的，可以。有可能。"}, {"type": "subtitle", "time": 10728.07, "timestamp": "02:58:48", "text": "所以，是的，我真的可以直接搬走。"}, {"type": "subtitle", "time": 10728.95, "timestamp": "02:58:48", "text": "这里有棱镜。"}, {"type": "subtitle", "time": 10730.23, "timestamp": "02:58:50", "text": "好的。好的。"}, {"type": "subtitle", "time": 10732.309, "timestamp": "02:58:52", "text": "他正在飞行。他速度极快。所以，"}, {"type": "subtitle", "time": 10734.79, "timestamp": "02:58:54", "text": "这真的要做出来，我一定要做出来"}, {"type": "subtitle", "time": 10738.15, "timestamp": "02:58:58", "text": "他们都……呃，会保存力量。"}]
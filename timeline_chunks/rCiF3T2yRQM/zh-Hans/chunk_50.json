[{"type": "subtitle", "time": 3002.549, "timestamp": "00:50:02", "text": "谢谢你，小家伙。总之，再见。"}, {"type": "subtitle", "time": 3009.349, "timestamp": "00:50:09", "text": "好了。"}, {"type": "subtitle", "time": 3011.27, "timestamp": "00:50:11", "text": "锁上了门。"}, {"type": "subtitle", "time": 3013.75, "timestamp": "00:50:13", "text": "他情绪非常阴晴不定。"}, {"type": "subtitle", "time": 3014.309, "timestamp": "00:50:14", "text": "是的。"}, {"type": "subtitle", "time": 3016.15, "timestamp": "00:50:16", "text": "出色地，"}, {"type": "subtitle", "time": 3019.19, "timestamp": "00:50:19", "text": "因为范不得不喜欢"}, {"type": "subtitle", "time": 3021.27, "timestamp": "00:50:21", "text": "看看他们的政党是如何运作的"}, {"type": "subtitle", "time": 3023.99, "timestamp": "00:50:23", "text": "那地方真是个鬼地方，你知道的"}, {"type": "subtitle", "time": 3027.43, "timestamp": "00:50:27", "text": "什么？我大概能明白原因。他们确实如此"}, {"type": "subtitle", "time": 3030.79, "timestamp": "00:50:30", "text": "我会举办一个非常恶作剧的派对。"}, {"type": "subtitle", "time": 3033.19, "timestamp": "00:50:33", "text": "说。迪克认为她说的无论如何都是对的。"}, {"type": "subtitle", "time": 3043.67, "timestamp": "00:50:43", "text": "记忆力真好。打钩。哦，是的。"}, {"type": "subtitle", "time": 3045.43, "timestamp": "00:50:45", "text": "那肯定又是一只死掉的史莱姆。"}, {"type": "subtitle", "time": 3048.069, "timestamp": "00:50:48", "text": "嗯？"}, {"type": "subtitle", "time": 3051.109, "timestamp": "00:50:51", "text": "又一个死掉的史莱姆。"}, {"type": "subtitle", "time": 3053.99, "timestamp": "00:50:53", "text": "溢出。"}, {"type": "subtitle", "time": 3058.15, "timestamp": "00:50:58", "text": "老兄，别再吃史莱姆了。我的天啊，"}]
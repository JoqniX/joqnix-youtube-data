[{"type": "subtitle", "time": 1983.509, "timestamp": "00:33:03", "text": "我知道我不太信任小公司。"}, {"type": "subtitle", "time": 1986.389, "timestamp": "00:33:06", "text": "走失的儿童"}, {"type": "subtitle", "time": 1988.95, "timestamp": "00:33:08", "text": "在地牢里。我的意思是，我们实际上已经……"}, {"type": "subtitle", "time": 1992.31, "timestamp": "00:33:12", "text": "不得不和地牢里的老妇人打交道"}, {"type": "subtitle", "time": 1994.71, "timestamp": "00:33:14", "text": "前。我没有同样的感受。"}, {"type": "subtitle", "time": 1998.07, "timestamp": "00:33:18", "text": "质量如同地牢里的孩子"}, {"type": "subtitle", "time": 1999.909, "timestamp": "00:33:19", "text": "出色地。"}, {"type": "subtitle", "time": 2001.83, "timestamp": "00:33:21", "text": "年纪足够大，他们不再是"}, {"type": "subtitle", "time": 2004.23, "timestamp": "00:33:24", "text": "被船上的人视为孩子"}, {"type": "subtitle", "time": 2006.549, "timestamp": "00:33:26", "text": "就像船上的人一样。"}, {"type": "subtitle", "time": 2009.509, "timestamp": "00:33:29", "text": "哦，看来你已经够大了。"}, {"type": "subtitle", "time": 2011.509, "timestamp": "00:33:31", "text": "年纪足够大，不再是孩子了。"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "我不能再带着我的办公桌旅行了。"}, {"type": "subtitle", "time": 2015.83, "timestamp": "00:33:35", "text": "这些船只。他们必须，他们必须"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "就像把我们分开一样"}, {"type": "subtitle", "time": 2019.59, "timestamp": "00:33:39", "text": "点赞"}, {"type": "subtitle", "time": 2021.99, "timestamp": "00:33:41", "text": "哦。"}, {"type": "subtitle", "time": 2023.669, "timestamp": "00:33:43", "text": "嗯，"}, {"type": "subtitle", "time": 2027.43, "timestamp": "00:33:47", "text": "Tick，你多大了？滴答声不会"}, {"type": "subtitle", "time": 2028.95, "timestamp": "00:33:48", "text": "知道。"}, {"type": "subtitle", "time": 2030.71, "timestamp": "00:33:50", "text": "哦，"}, {"type": "subtitle", "time": 2033.19, "timestamp": "00:33:53", "text": "你知道吗？公平的。我其实也不太清楚。"}, {"type": "subtitle", "time": 2035.669, "timestamp": "00:33:55", "text": "记住我的年龄。"}, {"type": "subtitle", "time": 2037.75, "timestamp": "00:33:57", "text": "滴答声提醒我们，时间其实并不那么重要。"}]
[{"type": "subtitle", "time": 11101.19, "timestamp": "03:05:01", "text": "情况不太乐观。所以，节省了"}, {"type": "subtitle", "time": 11104.55, "timestamp": "03:05:04", "text": "因为是DC5，所以能省钱。"}, {"type": "subtitle", "time": 11106.15, "timestamp": "03:05:06", "text": "万岁！损害。"}, {"type": "subtitle", "time": 11107.59, "timestamp": "03:05:07", "text": "完全损坏。"}, {"type": "subtitle", "time": 11109.269, "timestamp": "03:05:09", "text": "损害。"}, {"type": "subtitle", "time": 11111.99, "timestamp": "03:05:11", "text": "他们遭受全部伤害。是2d10。"}, {"type": "subtitle", "time": 11113.91, "timestamp": "03:05:13", "text": "顺便说一句，容光焕发。"}, {"type": "subtitle", "time": 11116.63, "timestamp": "03:05:16", "text": "哦，我必须这么做。"}, {"type": "subtitle", "time": 11119.51, "timestamp": "03:05:19", "text": "是的。是的，你得滚动"}, {"type": "subtitle", "time": 11121.349, "timestamp": "03:05:21", "text": "理论上我可以做到，但这并非事实"}, {"type": "subtitle", "time": 11125.19, "timestamp": "03:05:25", "text": "乐趣。把它卷起来。"}, {"type": "subtitle", "time": 11127.83, "timestamp": "03:05:27", "text": "好的。好的。然后他们去了10"}, {"type": "subtitle", "time": 11131.03, "timestamp": "03:05:31", "text": "损害。好的。呃"}, {"type": "subtitle", "time": 11133.59, "timestamp": "03:05:33", "text": "摆出这个姿势。"}, {"type": "subtitle", "time": 11137.83, "timestamp": "03:05:37", "text": "我们还能掷出更高的最低伤害骰吗？"}, {"type": "subtitle", "time": 11139.91, "timestamp": "03:05:39", "text": "好的。一旦发生，你就会意识到"}, {"type": "subtitle", "time": 11142.71, "timestamp": "03:05:42", "text": "就是这个。哦，那一下快照和"}, {"type": "subtitle", "time": 11144.71, "timestamp": "03:05:44", "text": "它的前面。前面那个扣子"}, {"type": "subtitle", "time": 11145.91, "timestamp": "03:05:45", "text": "它。"}, {"type": "subtitle", "time": 11156.95, "timestamp": "03:05:56", "text": "我想我们必须把它关掉"}, {"type": "subtitle", "time": 11159.39, "timestamp": "03:05:59", "text": "链条。"}]
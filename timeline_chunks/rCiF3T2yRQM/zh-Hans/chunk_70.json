[{"type": "subtitle", "time": 4200.39, "timestamp": "01:10:00", "text": "一。"}, {"type": "subtitle", "time": 4203.03, "timestamp": "01:10:03", "text": "两害相权取其轻。"}, {"type": "subtitle", "time": 4205.11, "timestamp": "01:10:05", "text": "我会对你坦诚相待。我不太明白。"}, {"type": "subtitle", "time": 4211.03, "timestamp": "01:10:11", "text": "如果 Tick 能改变水体或"}, {"type": "subtitle", "time": 4214.63, "timestamp": "01:10:14", "text": "地板，那可能不太好。"}, {"type": "subtitle", "time": 4217.03, "timestamp": "01:10:17", "text": "谢谢你，Tick。我宁愿选择"}, {"type": "subtitle", "time": 4219.11, "timestamp": "01:10:19", "text": "那就选最上面的那个。"}, {"type": "subtitle", "time": 4221.51, "timestamp": "01:10:21", "text": "好的，那我们走吧。爱莉安娜要去"}, {"type": "subtitle", "time": 4222.87, "timestamp": "01:10:22", "text": "她开始往回走，但她"}, {"type": "subtitle", "time": 4223.91, "timestamp": "01:10:23", "text": "暂时不进去。她要去"}, {"type": "subtitle", "time": 4226.229, "timestamp": "01:10:26", "text": "等其他人。"}, {"type": "subtitle", "time": 4226.709, "timestamp": "01:10:26", "text": "好的，"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "如果我的铸造厂开工了，你就得在那儿。"}, {"type": "subtitle", "time": 4231.51, "timestamp": "01:10:31", "text": "XC。"}, {"type": "subtitle", "time": 4233.35, "timestamp": "01:10:33", "text": "哦。哦好的。是的。稍等片刻，我"}, {"type": "subtitle", "time": 4234.31, "timestamp": "01:10:34", "text": "猜测。"}, {"type": "subtitle", "time": 4235.189, "timestamp": "01:10:35", "text": "是的。"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "所以，还有另一条走廊。竞技场是"}, {"type": "subtitle", "time": 4238.79, "timestamp": "01:10:38", "text": "看起来就像在远处。她"}, {"type": "subtitle", "time": 4241.189, "timestamp": "01:10:41", "text": "太黑了，什么都看不见。"}, {"type": "subtitle", "time": 4243.03, "timestamp": "01:10:43", "text": "就像她正探头往外看一样。"}, {"type": "subtitle", "time": 4246.149, "timestamp": "01:10:46", "text": "看起来像"}, {"type": "subtitle", "time": 4249.03, "timestamp": "01:10:49", "text": "Tick和Ariana眯着眼睛，好像他们"}, {"type": "subtitle", "time": 4250.709, "timestamp": "01:10:50", "text": "看不见。仿佛他们没有黑暗"}, {"type": "subtitle", "time": 4256.709, "timestamp": "01:10:56", "text": "我的天啊。"}, {"type": "subtitle", "time": 4259.59, "timestamp": "01:10:59", "text": "他就是那种人，该怎么称呼呢？他有"}]
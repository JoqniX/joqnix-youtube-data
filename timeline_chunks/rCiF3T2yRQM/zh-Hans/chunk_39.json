[{"type": "subtitle", "time": 2340.39, "timestamp": "00:39:00", "text": "试图打开门。"}, {"type": "subtitle", "time": 2342.79, "timestamp": "00:39:02", "text": "门锁着。似乎是"}, {"type": "subtitle", "time": 2344.79, "timestamp": "00:39:04", "text": "另一侧设有路障。"}, {"type": "subtitle", "time": 2348.71, "timestamp": "00:39:08", "text": "他妈的为什么这里被封锁了？"}, {"type": "subtitle", "time": 2350.87, "timestamp": "00:39:10", "text": "好的。当你打招呼的时候，比如"}, {"type": "subtitle", "time": 2353.27, "timestamp": "00:39:13", "text": "你内心的回应。呃，"}, {"type": "subtitle", "time": 2356.069, "timestamp": "00:39:16", "text": "夜晚。我让你玩。利希。"}, {"type": "subtitle", "time": 2361.91, "timestamp": "00:39:21", "text": "是的。你是唯一一个同时在这两方面都参与的人。"}, {"type": "subtitle", "time": 2363.75, "timestamp": "00:39:23", "text": "会议。所以，我要去，你要去"}, {"type": "subtitle", "time": 2372.79, "timestamp": "00:39:32", "text": "好了。好了。"}, {"type": "subtitle", "time": 2378.15, "timestamp": "00:39:38", "text": "嗯，所以，所以雷当时可能在休息。"}, {"type": "subtitle", "time": 2381.589, "timestamp": "00:39:41", "text": "当他和她听到时，所有人都在……"}, {"type": "subtitle", "time": 2383.829, "timestamp": "00:39:43", "text": "外面传来呼唤声，她就……"}, {"type": "subtitle", "time": 2385.829, "timestamp": "00:39:45", "text": "她立刻精神一振，就像她刚才那样。"}, {"type": "subtitle", "time": 2388.15, "timestamp": "00:39:48", "text": "就像坐起来一样，就像睡着了一样"}, {"type": "subtitle", "time": 2390.47, "timestamp": "00:39:50", "text": "她和其他人一起走着，然后就径直走了。"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "走到门口，就问：谁在那儿？"}, {"type": "subtitle", "time": 2397.75, "timestamp": "00:39:57", "text": "是我们。你们认识我们。"}, {"type": "subtitle", "time": 2399.52, "timestamp": "00:39:59", "text": "我们。 我们。 WHO？"}]
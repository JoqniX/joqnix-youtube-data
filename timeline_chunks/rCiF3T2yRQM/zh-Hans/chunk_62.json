[{"type": "subtitle", "time": 3720.87, "timestamp": "01:02:00", "text": "里面。"}, {"type": "subtitle", "time": 3723.109, "timestamp": "01:02:03", "text": "T不喜欢这样。 T不喜欢"}, {"type": "subtitle", "time": 3724.95, "timestamp": "01:02:04", "text": "喷涌而出的泉水。"}, {"type": "subtitle", "time": 3727.109, "timestamp": "01:02:07", "text": "你为什么不喜欢它？"}, {"type": "subtitle", "time": 3729.51, "timestamp": "01:02:09", "text": "它开始变得肉乎乎的"}, {"type": "subtitle", "time": 3733.27, "timestamp": "01:02:13", "text": "咬得越深。"}, {"type": "subtitle", "time": 3737.27, "timestamp": "01:02:17", "text": "那绝对是……的信息。"}, {"type": "subtitle", "time": 3739.03, "timestamp": "01:02:19", "text": "所以基本上，滴答声是这样的"}, {"type": "subtitle", "time": 3740.789, "timestamp": "01:02:20", "text": "理解这一点就是内部"}, {"type": "subtitle", "time": 3742.95, "timestamp": "01:02:22", "text": "我们看到的附件是……"}, {"type": "subtitle", "time": 3745.43, "timestamp": "01:02:25", "text": "而且贯穿始终。"}, {"type": "subtitle", "time": 3746.789, "timestamp": "01:02:26", "text": "嗯。"}, {"type": "subtitle", "time": 3747.27, "timestamp": "01:02:27", "text": "E."}, {"type": "subtitle", "time": 3750.39, "timestamp": "01:02:30", "text": "这就是理解它的方法。所以"}, {"type": "subtitle", "time": 3752.15, "timestamp": "01:02:32", "text": "也许它们会活过来。我不"}, {"type": "subtitle", "time": 3754.549, "timestamp": "01:02:34", "text": "知道他们是否还活着。呃"}, {"type": "subtitle", "time": 3756.15, "timestamp": "01:02:36", "text": "反正。"}, {"type": "subtitle", "time": 3760.789, "timestamp": "01:02:40", "text": "嗯，那就慢点走。"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "减速。"}, {"type": "subtitle", "time": 3764.47, "timestamp": "01:02:44", "text": "又来了。倒叙。"}, {"type": "subtitle", "time": 3765.99, "timestamp": "01:02:45", "text": "闪回。"}, {"type": "subtitle", "time": 3768.87, "timestamp": "01:02:48", "text": "放慢闪回速度。就像"}, {"type": "subtitle", "time": 3771.349, "timestamp": "01:02:51", "text": "猫。"}, {"type": "subtitle", "time": 3775.349, "timestamp": "01:02:55", "text": "我猜这可能就是他们所说的"}]
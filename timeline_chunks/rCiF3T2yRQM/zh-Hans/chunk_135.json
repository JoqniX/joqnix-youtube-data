[{"type": "subtitle", "time": 8100.95, "timestamp": "02:15:00", "text": "把它们切成片是不好的。"}, {"type": "subtitle", "time": 8104.47, "timestamp": "02:15:04", "text": "好的。我得到了帮助。"}, {"type": "subtitle", "time": 8106.39, "timestamp": "02:15:06", "text": "如果我们这样想呢？"}, {"type": "subtitle", "time": 8109.27, "timestamp": "02:15:09", "text": "我们可以把它们重新组合起来吗？是"}, {"type": "subtitle", "time": 8111.99, "timestamp": "02:15:11", "text": "那可有可无吗？"}, {"type": "subtitle", "time": 8114.47, "timestamp": "02:15:14", "text": "呃，如果你队伍里有像法师这样的角色，我"}, {"type": "subtitle", "time": 8117.43, "timestamp": "02:15:17", "text": "实际上会让你尝试这样做。"}, {"type": "subtitle", "time": 8119.189, "timestamp": "02:15:19", "text": "听起来真搞笑。我有点想"}, {"type": "subtitle", "time": 8120.629, "timestamp": "02:15:20", "text": "让你这么做。"}, {"type": "subtitle", "time": 8123.91, "timestamp": "02:15:23", "text": "把它们修好。把它们修好。我会把你放在那里"}, {"type": "subtitle", "time": 8125.43, "timestamp": "02:15:25", "text": "重归于好。"}, {"type": "subtitle", "time": 8130.229, "timestamp": "02:15:30", "text": "我的天啊。好吧，那我还是不参加了。"}, {"type": "subtitle", "time": 8132.069, "timestamp": "02:15:32", "text": "我已经没有其他办法了，我"}, {"type": "subtitle", "time": 8132.39, "timestamp": "02:15:32", "text": "不要思考。"}, {"type": "subtitle", "time": 8134.79, "timestamp": "02:15:34", "text": "哦，不。"}, {"type": "subtitle", "time": 8148.31, "timestamp": "02:15:48", "text": "接下来轮到我了。对不起。我是。"}, {"type": "subtitle", "time": 8149.99, "timestamp": "02:15:49", "text": "好的。"}, {"type": "subtitle", "time": 8155.03, "timestamp": "02:15:55", "text": "M：所以我想用月光。"}, {"type": "subtitle", "time": 8158.709, "timestamp": "02:15:58", "text": "好的。哦，那会打到我。"}]
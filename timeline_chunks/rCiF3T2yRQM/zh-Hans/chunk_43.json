[{"type": "subtitle", "time": 2585.19, "timestamp": "00:43:05", "text": "你可能不会那样做。他们是"}, {"type": "subtitle", "time": 2588.87, "timestamp": "00:43:08", "text": "他们醒来后脾气很暴躁。"}, {"type": "subtitle", "time": 2591.03, "timestamp": "00:43:11", "text": "没关系。他们一定会喜欢Pick。挑选喜爱"}, {"type": "subtitle", "time": 2594.63, "timestamp": "00:43:14", "text": "已经让他们……奇怪的"}, {"type": "subtitle", "time": 2598.47, "timestamp": "00:43:18", "text": "你们在这里发现的生物。"}, {"type": "subtitle", "time": 2600.87, "timestamp": "00:43:20", "text": "他是我的新朋友。"}, {"type": "subtitle", "time": 2603.349, "timestamp": "00:43:23", "text": "我们现在是一家人了。我们所有人。"}, {"type": "subtitle", "time": 2607.19, "timestamp": "00:43:27", "text": "很高兴听到这个消息。我猜"}, {"type": "subtitle", "time": 2609.349, "timestamp": "00:43:29", "text": "你知道吗？有时候你会交到朋友"}, {"type": "subtitle", "time": 2618.95, "timestamp": "00:43:38", "text": "小蜱虫。"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "这既是好事也是坏事。"}, {"type": "subtitle", "time": 2625.03, "timestamp": "00:43:45", "text": "事物。你真可爱。嗯，我没有"}, {"type": "subtitle", "time": 2627.43, "timestamp": "00:43:47", "text": "真的很喜欢，但是你知道，我想"}, {"type": "subtitle", "time": 2630.95, "timestamp": "00:43:50", "text": "我可以接受。嗯，总之，你做什么？"}, {"type": "subtitle", "time": 2632.15, "timestamp": "00:43:52", "text": "你们"}, {"type": "subtitle", "time": 2634.79, "timestamp": "00:43:54", "text": "你会慢慢爱上它的。"}, {"type": "subtitle", "time": 2637.91, "timestamp": "00:43:57", "text": "好的。我是。她只会看着"}]
[{"type": "subtitle", "time": 1380.149, "timestamp": "00:23:00", "text": "你们在哪里？你们看不到我们"}, {"type": "subtitle", "time": 1382.07, "timestamp": "00:23:02", "text": "我们所在的地方。虽然是黑白的，但是"}, {"type": "subtitle", "time": 1384.63, "timestamp": "00:23:04", "text": "我们在地图上什么也看不到。"}, {"type": "subtitle", "time": 1392.39, "timestamp": "00:23:12", "text": "哦，是的。让我来给你演示一下。让我来展示一下"}, {"type": "subtitle", "time": 1394.71, "timestamp": "00:23:14", "text": "你正是我眼中的我，就像我的"}, {"type": "subtitle", "time": 1397.11, "timestamp": "00:23:17", "text": "令牌。它也会出现在公共聊天中，所以你会"}, {"type": "subtitle", "time": 1397.59, "timestamp": "00:23:17", "text": "看。"}, {"type": "subtitle", "time": 1400.47, "timestamp": "00:23:20", "text": "我能让乔克瞎，而乔能看见。"}, {"type": "subtitle", "time": 1400.71, "timestamp": "00:23:20", "text": "我是"}, {"type": "subtitle", "time": 1404.549, "timestamp": "00:23:24", "text": "盲人也能看见。"}, {"type": "subtitle", "time": 1405.669, "timestamp": "00:23:25", "text": "是的。"}, {"type": "subtitle", "time": 1408.23, "timestamp": "00:23:28", "text": "这就是我们在黑暗中看到的，因为"}, {"type": "subtitle", "time": 1409.75, "timestamp": "00:23:29", "text": "在黑暗中。"}, {"type": "subtitle", "time": 1410.95, "timestamp": "00:23:30", "text": "没有什么。"}, {"type": "subtitle", "time": 1412.47, "timestamp": "00:23:32", "text": "我的天啊。"}, {"type": "subtitle", "time": 1414.95, "timestamp": "00:23:34", "text": "这也是我当时的真实感受。那是"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "还有我失明时的感受，"}, {"type": "subtitle", "time": 1422.549, "timestamp": "00:23:42", "text": "我的天哪。"}, {"type": "subtitle", "time": 1425.909, "timestamp": "00:23:45", "text": "正确的。好的。呃，格林，你还好吗？"}, {"type": "subtitle", "time": 1427.43, "timestamp": "00:23:47", "text": "比如，如果"}, {"type": "subtitle", "time": 1429.43, "timestamp": "00:23:49", "text": "我仍然和手电筒连在一起，我不是"}, {"type": "subtitle", "time": 1430.549, "timestamp": "00:23:50", "text": "非常确定。"}, {"type": "subtitle", "time": 1430.95, "timestamp": "00:23:50", "text": "嗯"}, {"type": "subtitle", "time": 1433.19, "timestamp": "00:23:53", "text": "尝试刷新页面。你试过吗？"}, {"type": "subtitle", "time": 1433.75, "timestamp": "00:23:53", "text": "令人耳目一新？"}, {"type": "subtitle", "time": 1436.47, "timestamp": "00:23:56", "text": "技术故障。"}, {"type": "subtitle", "time": 1437.75, "timestamp": "00:23:57", "text": "你看到的和我看到的一样吗？"}]
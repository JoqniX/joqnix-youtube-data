[{"type": "subtitle", "time": 6422.149, "timestamp": "01:47:02", "text": "但我认为我们很安全。"}, {"type": "subtitle", "time": 6424.31, "timestamp": "01:47:04", "text": "这不是蜱虫。蜱虫会告诉你"}, {"type": "subtitle", "time": 6425.59, "timestamp": "01:47:05", "text": "很多。"}, {"type": "subtitle", "time": 6428.31, "timestamp": "01:47:08", "text": "看看蜱虫。"}, {"type": "subtitle", "time": 6431.35, "timestamp": "01:47:11", "text": "直接回头看"}, {"type": "subtitle", "time": 6433.75, "timestamp": "01:47:13", "text": "像你一样"}, {"type": "subtitle", "time": 6435.03, "timestamp": "01:47:15", "text": "我只是直接看着……"}, {"type": "subtitle", "time": 6437.83, "timestamp": "01:47:17", "text": "蜱虫的面团眼睛像"}, {"type": "subtitle", "time": 6440.07, "timestamp": "01:47:20", "text": "我不"}, {"type": "subtitle", "time": 6442.87, "timestamp": "01:47:22", "text": "我觉得他没那么危险。"}, {"type": "subtitle", "time": 6446.709, "timestamp": "01:47:26", "text": "没关系。这只是其中之一。如果是一位修女"}, {"type": "subtitle", "time": 6448.39, "timestamp": "01:47:28", "text": "它会攻击我，或者那个东西会攻击我吗？"}, {"type": "subtitle", "time": 6450.229, "timestamp": "01:47:30", "text": "杀了它。简单的。"}, {"type": "subtitle", "time": 6450.95, "timestamp": "01:47:30", "text": "确切地。"}, {"type": "subtitle", "time": 6452.39, "timestamp": "01:47:32", "text": "听起来不错。"}, {"type": "subtitle", "time": 6455.35, "timestamp": "01:47:35", "text": "这会不会是个陷阱？"}, {"type": "subtitle", "time": 6457.43, "timestamp": "01:47:37", "text": "这也可能是一个陷阱。"}, {"type": "subtitle", "time": 6460.79, "timestamp": "01:47:40", "text": "不死生物既可以成为朋友，也可以成为食物。"}, {"type": "subtitle", "time": 6462.629, "timestamp": "01:47:42", "text": "哦亲爱的。朋友，"}, {"type": "subtitle", "time": 6464.07, "timestamp": "01:47:44", "text": "我回来了。"}, {"type": "subtitle", "time": 6468.39, "timestamp": "01:47:48", "text": "不要成为不死族，直到……"}, {"type": "subtitle", "time": 6470.629, "timestamp": "01:47:50", "text": "直到我们证明自己安全为止。"}, {"type": "subtitle", "time": 6474.149, "timestamp": "01:47:54", "text": "我很高兴最终还是回到了这里。"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "他回来后发现，蒂克就像是……"}]
[{"type": "subtitle", "time": 7142.39, "timestamp": "01:59:02", "text": "是我把它搬走的，就像你"}, {"type": "subtitle", "time": 7144.47, "timestamp": "01:59:04", "text": "坐下，就像你慢慢移动一样。"}, {"type": "subtitle", "time": 7146.07, "timestamp": "01:59:06", "text": "向前。"}, {"type": "subtitle", "time": 7147.27, "timestamp": "01:59:07", "text": "我的天哪。"}, {"type": "subtitle", "time": 7152.79, "timestamp": "01:59:12", "text": "拿起票。现在要脱颖而出。"}, {"type": "subtitle", "time": 7155.51, "timestamp": "01:59:15", "text": "你真是个长不大的孩子。"}, {"type": "subtitle", "time": 7157.83, "timestamp": "01:59:17", "text": "他个子好小。"}, {"type": "subtitle", "time": 7160.47, "timestamp": "01:59:20", "text": "你真是个长不大的孩子。"}, {"type": "subtitle", "time": 7166.149, "timestamp": "01:59:26", "text": "它那么小，那么可爱，怎么会这样"}, {"type": "subtitle", "time": 7178.87, "timestamp": "01:59:38", "text": "不，就是不能站着走。你已经开始了"}, {"type": "subtitle", "time": 7181.51, "timestamp": "01:59:41", "text": "就像，如果这东西还活着的话……"}, {"type": "subtitle", "time": 7184.709, "timestamp": "01:59:44", "text": "如果我们采取什么行动，它会有反应。"}, {"type": "subtitle", "time": 7189.03, "timestamp": "01:59:49", "text": "我们该怎么办？去灭火吧。"}, {"type": "subtitle", "time": 7190.39, "timestamp": "01:59:50", "text": "杀了它。"}, {"type": "subtitle", "time": 7194.629, "timestamp": "01:59:54", "text": "它对食物没有反应。它"}, {"type": "subtitle", "time": 7196.95, "timestamp": "01:59:56", "text": "对黑色液体有反应。"}, {"type": "subtitle", "time": 7198.47, "timestamp": "01:59:58", "text": "我会说，我会说液体"}]
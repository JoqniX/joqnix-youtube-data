[{"type": "subtitle", "time": 4440.39, "timestamp": "01:14:00", "text": "我觉得你很容易受到影响。比如说"}, {"type": "subtitle", "time": 4442.709, "timestamp": "01:14:02", "text": "是的。我要让你趴下。"}, {"type": "subtitle", "time": 4444.149, "timestamp": "01:14:04", "text": "让我看看。它在哪里？王座。那里"}, {"type": "subtitle", "time": 4445.83, "timestamp": "01:14:05", "text": "你去。你摔倒在地，然后你"}, {"type": "subtitle", "time": 4448.709, "timestamp": "01:14:08", "text": "意识到地面很粘。全部"}, {"type": "subtitle", "time": 4450.07, "timestamp": "01:14:10", "text": "正确的。我会让你滚动"}, {"type": "subtitle", "time": 4451.99, "timestamp": "01:14:11", "text": "从这里开始行动。"}, {"type": "subtitle", "time": 4455.91, "timestamp": "01:14:15", "text": "嗯，我觉得我们可能有点陷入困境了。"}, {"type": "subtitle", "time": 4458.709, "timestamp": "01:14:18", "text": "真是棘手的情况。"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "我"}, {"type": "subtitle", "time": 4466.87, "timestamp": "01:14:26", "text": "关闭"}, {"type": "subtitle", "time": 4468.95, "timestamp": "01:14:28", "text": "我现在不想听你说话。"}, {"type": "subtitle", "time": 4470.95, "timestamp": "01:14:30", "text": "我的天啊。这是你的埃尔德里奇"}, {"type": "subtitle", "time": 4471.59, "timestamp": "01:14:31", "text": "赞助人。"}, {"type": "subtitle", "time": 4474.07, "timestamp": "01:14:34", "text": "是的，我的邪术师守护神就是这么做的。"}, {"type": "subtitle", "time": 4477.669, "timestamp": "01:14:37", "text": "我心想：“闭嘴吧，没人听见。”"}, {"type": "subtitle", "time": 4479.99, "timestamp": "01:14:39", "text": "我的天啊。"}, {"type": "subtitle", "time": 4484.39, "timestamp": "01:14:44", "text": "好的。好的。好了。嗯，好的。"}, {"type": "subtitle", "time": 4486.31, "timestamp": "01:14:46", "text": "呃，运动员规则。让我再确认一下"}, {"type": "subtitle", "time": 4488.63, "timestamp": "01:14:48", "text": "那。是的。好的。乔克。点击滚动"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "倡议。"}, {"type": "subtitle", "time": 4491.75, "timestamp": "01:14:51", "text": "是"}, {"type": "subtitle", "time": 4492.79, "timestamp": "01:14:52", "text": "哦，不。开始了。"}, {"type": "subtitle", "time": 4494.79, "timestamp": "01:14:54", "text": "顺便提醒一下。所以我也不知道。做"}, {"type": "subtitle", "time": 4498.39, "timestamp": "01:14:58", "text": "我的警报是否已经添加到该警报中了？"}]
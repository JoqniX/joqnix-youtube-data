[{"type": "subtitle", "time": 8826.87, "timestamp": "02:27:06", "text": "这光芒令人作呕。"}, {"type": "subtitle", "time": 8830.71, "timestamp": "02:27:10", "text": "这看起来像呕吐物。"}, {"type": "subtitle", "time": 8833.429, "timestamp": "02:27:13", "text": "好的，掷骰子决定伤害。哦，我想应该是点击它。"}, {"type": "subtitle", "time": 8835.03, "timestamp": "02:27:15", "text": "还是先这样吧，因为我打算直接用17。"}, {"type": "subtitle", "time": 8836.79, "timestamp": "02:27:16", "text": "已经发生了。"}, {"type": "subtitle", "time": 8838.79, "timestamp": "02:27:18", "text": "用附魔长矛掷骰造成伤害"}, {"type": "subtitle", "time": 8841.59, "timestamp": "02:27:21", "text": "剑。好的。好的。为什么它仍然"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "砍杀？我打算把它弄成这样"}, {"type": "subtitle", "time": 8845.03, "timestamp": "02:27:25", "text": "光芒四射。好的，我们就这么做吧。"}, {"type": "subtitle", "time": 8848.71, "timestamp": "02:27:28", "text": "光芒四射。好的，蓝色。好的，它"}, {"type": "subtitle", "time": 8853.349, "timestamp": "02:27:33", "text": "它真的会造成那么大的损害吗？和"}, {"type": "subtitle", "time": 8855.429, "timestamp": "02:27:35", "text": "呃，当你那样做的时候，即使它是"}, {"type": "subtitle", "time": 8858.07, "timestamp": "02:27:38", "text": "光芒四射，呃，你知道，你已经受损了"}, {"type": "subtitle", "time": 8861.91, "timestamp": "02:27:41", "text": "相当多，因为嗯，它似乎"}, {"type": "subtitle", "time": 8864.71, "timestamp": "02:27:44", "text": "就像开始……呃，让我先做这个"}, {"type": "subtitle", "time": 8868.309, "timestamp": "02:27:48", "text": "发出“噗”的一声，然后这样做。它会这样做。"}, {"type": "subtitle", "time": 8875.27, "timestamp": "02:27:55", "text": "我很庆幸我们没有……"}, {"type": "subtitle", "time": 8877.59, "timestamp": "02:27:57", "text": "为了对方而经历这一切"}, {"type": "subtitle", "time": 8879.67, "timestamp": "02:27:59", "text": "因为我只能这样做"}]
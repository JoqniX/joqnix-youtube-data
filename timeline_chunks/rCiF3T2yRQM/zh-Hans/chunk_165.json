[{"type": "subtitle", "time": 9905.269, "timestamp": "02:45:05", "text": "是的。是的。你做到了吗？库兹"}, {"type": "subtitle", "time": 9906.71, "timestamp": "02:45:06", "text": "如果你我要去，我要解决"}, {"type": "subtitle", "time": 9910.87, "timestamp": "02:45:10", "text": "该剧的HP。我要关门了。好的。"}, {"type": "subtitle", "time": 9913.51, "timestamp": "02:45:13", "text": "好的。好的。好的，我要……"}, {"type": "subtitle", "time": 9916.309, "timestamp": "02:45:16", "text": "我会为你加上。加"}, {"type": "subtitle", "time": 9917.51, "timestamp": "02:45:17", "text": "五。好的。"}, {"type": "subtitle", "time": 9920.389, "timestamp": "02:45:20", "text": "谢谢。"}, {"type": "subtitle", "time": 9920.79, "timestamp": "02:45:20", "text": "好的。"}, {"type": "subtitle", "time": 9923.91, "timestamp": "02:45:23", "text": "看起来好像什么都没有。"}, {"type": "subtitle", "time": 9926.95, "timestamp": "02:45:26", "text": "除了胃以外。"}, {"type": "subtitle", "time": 9927.99, "timestamp": "02:45:27", "text": "是的。是的。"}, {"type": "subtitle", "time": 9931.75, "timestamp": "02:45:31", "text": "嗯，好像那里还有更多东西。"}, {"type": "subtitle", "time": 9933.11, "timestamp": "02:45:33", "text": "那样做。"}, {"type": "subtitle", "time": 9935.99, "timestamp": "02:45:35", "text": "我想说，你们可以这样做。"}, {"type": "subtitle", "time": 9938.63, "timestamp": "02:45:38", "text": "嗯，抱歉。你们可以做五次。"}, {"type": "subtitle", "time": 9941.349, "timestamp": "02:45:41", "text": "在月光消失之前采取行动。"}, {"type": "subtitle", "time": 9943.67, "timestamp": "02:45:43", "text": "好的。"}, {"type": "subtitle", "time": 9945.99, "timestamp": "02:45:45", "text": "我可以重新召唤我的角色吗？"}, {"type": "subtitle", "time": 9947.91, "timestamp": "02:45:47", "text": "是的。"}, {"type": "subtitle", "time": 9950.55, "timestamp": "02:45:50", "text": "别再自掏腰包了。他们提到酥脆。"}, {"type": "subtitle", "time": 9952.95, "timestamp": "02:45:52", "text": "好吧，让我让我让我拉克里斯平"}, {"type": "subtitle", "time": 9954.95, "timestamp": "02:45:54", "text": "出去。坚持，稍等。干得好。圣诞节是"}, {"type": "subtitle", "time": 9958.309, "timestamp": "02:45:58", "text": "背部仍然保持静止。让我把它删掉。是的。"}]
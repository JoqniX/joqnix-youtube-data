[{"type": "subtitle", "time": 9300.23, "timestamp": "02:35:00", "text": "任何事物。我完全……我不知道"}, {"type": "subtitle", "time": 9302.07, "timestamp": "02:35:02", "text": "你身上有什么东西吗？"}, {"type": "subtitle", "time": 9304.95, "timestamp": "02:35:04", "text": "我的天哪。是的，我只有拳头和一个"}, {"type": "subtitle", "time": 9311.19, "timestamp": "02:35:11", "text": "好的，接下来我会做一个简短的B。"}, {"type": "subtitle", "time": 9313.429, "timestamp": "02:35:13", "text": "我猜我遭到了攻击。"}, {"type": "subtitle", "time": 9314.79, "timestamp": "02:35:14", "text": "好的，"}, {"type": "subtitle", "time": 9317.27, "timestamp": "02:35:17", "text": "我该怎么做？点击它。"}, {"type": "subtitle", "time": 9320.469, "timestamp": "02:35:20", "text": "只需点击你短弓上的……"}, {"type": "subtitle", "time": 9322.23, "timestamp": "02:35:22", "text": "并以此为目标。"}, {"type": "subtitle", "time": 9323.75, "timestamp": "02:35:23", "text": "对，就是这样。好的。"}, {"type": "subtitle", "time": 9326.95, "timestamp": "02:35:26", "text": "好的，点击攻击。"}, {"type": "subtitle", "time": 9327.75, "timestamp": "02:35:27", "text": "哦，"}, {"type": "subtitle", "time": 9329.349, "timestamp": "02:35:29", "text": "这是全部损失。"}, {"type": "subtitle", "time": 9333.349, "timestamp": "02:35:33", "text": "好的。好吧，我必须造成破坏。"}, {"type": "subtitle", "time": 9334.71, "timestamp": "02:35:34", "text": "嗯，是的。你不想做吗？"}, {"type": "subtitle", "time": 9338.71, "timestamp": "02:35:38", "text": "做"}, {"type": "subtitle", "time": 9346.469, "timestamp": "02:35:46", "text": "好了，就是这样。那一个受损了。"}, {"type": "subtitle", "time": 9348.469, "timestamp": "02:35:48", "text": "好的。"}, {"type": "subtitle", "time": 9349.99, "timestamp": "02:35:49", "text": "我觉得这就是你所能做的全部了。"}, {"type": "subtitle", "time": 9351.349, "timestamp": "02:35:51", "text": "轮到你了。"}, {"type": "subtitle", "time": 9353.19, "timestamp": "02:35:53", "text": "是的，我来结束回合。"}, {"type": "subtitle", "time": 9355.03, "timestamp": "02:35:55", "text": "好的。"}, {"type": "subtitle", "time": 9356.63, "timestamp": "02:35:56", "text": "进入。"}, {"type": "subtitle", "time": 9358.71, "timestamp": "02:35:58", "text": "你跑"}]
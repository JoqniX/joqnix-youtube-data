[{"type": "subtitle", "time": 8401.59, "timestamp": "02:20:01", "text": "知道小鸡正在吃东西"}, {"type": "subtitle", "time": 8404.22, "timestamp": "02:20:04", "text": "粘液？"}, {"type": "subtitle", "time": 8405.59, "timestamp": "02:20:05", "text": "[音乐]"}, {"type": "subtitle", "time": 8406.23, "timestamp": "02:20:06", "text": "制作它们"}, {"type": "subtitle", "time": 8408.07, "timestamp": "02:20:08", "text": "我会试试看。我会让你们"}, {"type": "subtitle", "time": 8410.389, "timestamp": "02:20:10", "text": "试试看你有没有什么咒语可以做到。"}, {"type": "subtitle", "time": 8411.59, "timestamp": "02:20:11", "text": "你已经掌握了咒语。"}, {"type": "subtitle", "time": 8413.59, "timestamp": "02:20:13", "text": "你感到恐惧。你感到害怕吗？"}, {"type": "subtitle", "time": 8414.07, "timestamp": "02:20:14", "text": "害怕。"}, {"type": "subtitle", "time": 8415.83, "timestamp": "02:20:15", "text": "是的，我有。第三级。"}, {"type": "subtitle", "time": 8419.429, "timestamp": "02:20:19", "text": "搞什么鬼？布罗确实有恐惧。"}, {"type": "subtitle", "time": 8421.03, "timestamp": "02:20:21", "text": "你可以试试。"}, {"type": "subtitle", "time": 8423.75, "timestamp": "02:20:23", "text": "布罗确实有恐惧。搞什么鬼？"}, {"type": "subtitle", "time": 8425.84, "timestamp": "02:20:25", "text": "等等，我该如何旋转它？"}, {"type": "subtitle", "time": 8427.19, "timestamp": "02:20:27", "text": "[音乐]"}, {"type": "subtitle", "time": 8430.07, "timestamp": "02:20:30", "text": "我没做好。我不知道。"}, {"type": "subtitle", "time": 8431.67, "timestamp": "02:20:31", "text": "它占用了我的法术位，但我没有"}, {"type": "subtitle", "time": 8433.19, "timestamp": "02:20:33", "text": "向右旋转。我不知道什么"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "30英尺高。"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "哦，"}, {"type": "subtitle", "time": 8444.55, "timestamp": "02:20:44", "text": "坚持，稍等。呃，稍等一下。我只希望如此。"}, {"type": "subtitle", "time": 8447.11, "timestamp": "02:20:47", "text": "不会的。哦，是的。关键是，按住Shift键。"}, {"type": "subtitle", "time": 8451.67, "timestamp": "02:20:51", "text": "然后滚动。抱歉。喜欢，"}, {"type": "subtitle", "time": 8453.75, "timestamp": "02:20:53", "text": "你好，"}, {"type": "subtitle", "time": 8456.07, "timestamp": "02:20:56", "text": "我已经没有那东西了。"}, {"type": "subtitle", "time": 8457.429, "timestamp": "02:20:57", "text": "我不知道该怎么处理它。"}, {"type": "subtitle", "time": 8459.67, "timestamp": "02:20:59", "text": "我可以帮你放置。坚持，稍等。你"}]
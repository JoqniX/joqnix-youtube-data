[{"type": "subtitle", "time": 4500.79, "timestamp": "01:15:00", "text": "嗯嗯，让我想想。警报就像"}, {"type": "subtitle", "time": 4502.39, "timestamp": "01:15:02", "text": "有优势，对吧？"}, {"type": "subtitle", "time": 4506.149, "timestamp": "01:15:06", "text": "嗯，不。我想，它能给我加五分。"}, {"type": "subtitle", "time": 4508.149, "timestamp": "01:15:08", "text": "哦，好的。我不这么认为。我会补充"}, {"type": "subtitle", "time": 4508.95, "timestamp": "01:15:08", "text": "手动操作。"}, {"type": "subtitle", "time": 4510.31, "timestamp": "01:15:10", "text": "已经101了。"}, {"type": "subtitle", "time": 4512.47, "timestamp": "01:15:12", "text": "是的，你获得+5的加成。"}, {"type": "subtitle", "time": 4513.669, "timestamp": "01:15:13", "text": "倡议。"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "等等，主动性在哪里？我找不到"}, {"type": "subtitle", "time": 4517.43, "timestamp": "01:15:17", "text": "它。"}, {"type": "subtitle", "time": 4519.83, "timestamp": "01:15:19", "text": "在你的收集表的第一页。"}, {"type": "subtitle", "time": 4522.149, "timestamp": "01:15:22", "text": "它就在你照片的下方"}, {"type": "subtitle", "time": 4523.189, "timestamp": "01:15:23", "text": "令牌，有这么一种东西叫做"}, {"type": "subtitle", "time": 4523.75, "timestamp": "01:15:23", "text": "倡议。"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "啊，就是这个。知道了。"}, {"type": "subtitle", "time": 4526.63, "timestamp": "01:15:26", "text": "是的。"}, {"type": "subtitle", "time": 4530.55, "timestamp": "01:15:30", "text": "所以，我的主动性是+9。"}, {"type": "subtitle", "time": 4532.95, "timestamp": "01:15:32", "text": "哦，还有。是的。呃，我会说的"}, {"type": "subtitle", "time": 4534.63, "timestamp": "01:15:34", "text": "已经添加了普通的那个，再加上"}, {"type": "subtitle", "time": 4536.07, "timestamp": "01:15:36", "text": "有了警报，将会是加五分。"}, {"type": "subtitle", "time": 4537.59, "timestamp": "01:15:37", "text": "再次。所以总共是23个。"}, {"type": "subtitle", "time": 4538.07, "timestamp": "01:15:38", "text": "正确的？"}, {"type": "subtitle", "time": 4538.79, "timestamp": "01:15:38", "text": "是的。是的。是的。"}, {"type": "subtitle", "time": 4542.31, "timestamp": "01:15:42", "text": "23. 好的。好了。"}, {"type": "subtitle", "time": 4543.59, "timestamp": "01:15:43", "text": "好的。我要去，我要去"}, {"type": "subtitle", "time": 4544.87, "timestamp": "01:15:44", "text": "把这东西卷起来。"}, {"type": "subtitle", "time": 4549.11, "timestamp": "01:15:49", "text": "好了。好的。嗯，等等。"}, {"type": "subtitle", "time": 4550.79, "timestamp": "01:15:50", "text": "我，我就直接揭晓吧。为什么"}, {"type": "subtitle", "time": 4553.669, "timestamp": "01:15:53", "text": "就是这样。好的。"}, {"type": "subtitle", "time": 4556.63, "timestamp": "01:15:56", "text": "好的。现在，呃，我这就……"}, {"type": "subtitle", "time": 4559.91, "timestamp": "01:15:59", "text": "就像这样做。嗯，好的。所以，"}]
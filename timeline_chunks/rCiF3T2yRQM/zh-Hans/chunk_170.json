[{"type": "subtitle", "time": 10201.75, "timestamp": "02:50:01", "text": "理论上我能把这个东西给它吗？"}, {"type": "subtitle", "time": 10205.03, "timestamp": "02:50:05", "text": "类似某种绦虫？"}, {"type": "subtitle", "time": 10206.95, "timestamp": "02:50:06", "text": "是的。"}, {"type": "subtitle", "time": 10207.99, "timestamp": "02:50:07", "text": "我的天啊。"}, {"type": "subtitle", "time": 10211.03, "timestamp": "02:50:11", "text": "是的，可以。"}, {"type": "subtitle", "time": 10213.429, "timestamp": "02:50:13", "text": "我家有虫害。大家都拿走你的"}, {"type": "subtitle", "time": 10216.95, "timestamp": "02:50:16", "text": "我该选哪种寄生虫给它呢？"}, {"type": "subtitle", "time": 10219.59, "timestamp": "02:50:19", "text": "兄弟要往这里面放绦虫。"}, {"type": "subtitle", "time": 10220.389, "timestamp": "02:50:20", "text": "该死的家伙。"}, {"type": "subtitle", "time": 10224.07, "timestamp": "02:50:24", "text": "我们走吧。绦虫。 10 或曾经是"}, {"type": "subtitle", "time": 10227.01, "timestamp": "02:50:27", "text": "它对单个生物的有效范围是30英尺吗？"}, {"type": "subtitle", "time": 10229.51, "timestamp": "02:50:29", "text": "[音乐]"}, {"type": "subtitle", "time": 10230.23, "timestamp": "02:50:30", "text": "呃"}, {"type": "subtitle", "time": 10232.55, "timestamp": "02:50:32", "text": "我会说，为了，为了，"}, {"type": "subtitle", "time": 10235.99, "timestamp": "02:50:35", "text": "攻击墙壁的目的并非"}, {"type": "subtitle", "time": 10241.03, "timestamp": "02:50:41", "text": "为了进行目标定位或"}, {"type": "subtitle", "time": 10243.91, "timestamp": "02:50:43", "text": "地面。是的。但如果你发现了一块粘液"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "那是一种生物，"}, {"type": "subtitle", "time": 10249.349, "timestamp": "02:50:49", "text": "我不做史莱姆，但那样做……"}, {"type": "subtitle", "time": 10251.429, "timestamp": "02:50:51", "text": "吃掉史莱姆。"}, {"type": "subtitle", "time": 10251.75, "timestamp": "02:50:51", "text": "是的，"}, {"type": "subtitle", "time": 10259.11, "timestamp": "02:50:59", "text": "我不确定那样是否可行。"}]
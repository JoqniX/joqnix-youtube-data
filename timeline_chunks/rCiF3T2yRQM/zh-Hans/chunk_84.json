[{"type": "subtitle", "time": 5041.669, "timestamp": "01:24:01", "text": "就这些。"}, {"type": "subtitle", "time": 5043.35, "timestamp": "01:24:03", "text": "他会抬头望向天空，"}, {"type": "subtitle", "time": 5052.55, "timestamp": "01:24:12", "text": "比如试着捂住Tick的嘴，然后……"}, {"type": "subtitle", "time": 5055.83, "timestamp": "01:24:15", "text": "比如，“不，不，Tick，别这么做。”你"}, {"type": "subtitle", "time": 5057.27, "timestamp": "01:24:17", "text": "知道，"}, {"type": "subtitle", "time": 5058.87, "timestamp": "01:24:18", "text": "就像我不会打电话一样"}, {"type": "subtitle", "time": 5061.75, "timestamp": "01:24:21", "text": "你把东西插在这里。"}, {"type": "subtitle", "time": 5064.149, "timestamp": "01:24:24", "text": "那"}, {"type": "subtitle", "time": 5066.31, "timestamp": "01:24:26", "text": "它就是这么做的。"}, {"type": "subtitle", "time": 5067.43, "timestamp": "01:24:27", "text": "好的，"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "别再那样做了。"}, {"type": "subtitle", "time": 5073.51, "timestamp": "01:24:33", "text": "好了，你到达了一个房间。在此"}, {"type": "subtitle", "time": 5075.11, "timestamp": "01:24:35", "text": "房间里有很多尸体。"}, {"type": "subtitle", "time": 5076.87, "timestamp": "01:24:36", "text": "地面。嗯，它和……非常相似"}, {"type": "subtitle", "time": 5079.75, "timestamp": "01:24:39", "text": "你之前看到的尸体，呃，呃，就是那个。"}, {"type": "subtitle", "time": 5081.51, "timestamp": "01:24:41", "text": "指着房间里"}, {"type": "subtitle", "time": 5084.55, "timestamp": "01:24:44", "text": "黏糊糊的房间。他们都非常"}, {"type": "subtitle", "time": 5086.229, "timestamp": "01:24:46", "text": "就像那里有很多磁铁一样"}, {"type": "subtitle", "time": 5088.709, "timestamp": "01:24:48", "text": "全部。在这中间这边，"}, {"type": "subtitle", "time": 5091.03, "timestamp": "01:24:51", "text": "那里有个玻璃罩。"}, {"type": "subtitle", "time": 5093.27, "timestamp": "01:24:53", "text": "里面有冒泡的黑色液体。"}, {"type": "subtitle", "time": 5095.11, "timestamp": "01:24:55", "text": "有一条街，就像有一条小街"}, {"type": "subtitle", "time": 5097.189, "timestamp": "01:24:57", "text": "另一侧的皮革延伸到"}]
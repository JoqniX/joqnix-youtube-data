[{"type": "subtitle", "time": 5100.87, "timestamp": "01:25:00", "text": "进入这个呃……东西的入口"}, {"type": "subtitle", "time": 5103.27, "timestamp": "01:25:03", "text": "船，船下面似乎有"}, {"type": "subtitle", "time": 5105.75, "timestamp": "01:25:05", "text": "某种水龙头。"}, {"type": "subtitle", "time": 5107.83, "timestamp": "01:25:07", "text": "哦，"}, {"type": "subtitle", "time": 5110.31, "timestamp": "01:25:10", "text": "好的。勾选，请勿尝试食用"}, {"type": "subtitle", "time": 5112.79, "timestamp": "01:25:12", "text": "房间里的任何东西。"}, {"type": "subtitle", "time": 5114.95, "timestamp": "01:25:14", "text": "已接到指示，不再"}, {"type": "subtitle", "time": 5116.87, "timestamp": "01:25:16", "text": "消耗。蒂克不再思考"}, {"type": "subtitle", "time": 5135.35, "timestamp": "01:25:35", "text": "哇。等等，也许是我太好奇了。"}, {"type": "subtitle", "time": 5138.709, "timestamp": "01:25:38", "text": "请问有人可以先进来一下吗？"}, {"type": "subtitle", "time": 5140.87, "timestamp": "01:25:40", "text": "好的。是吗？"}, {"type": "subtitle", "time": 5143.27, "timestamp": "01:25:43", "text": "走上去？是的，他当时好像要……"}, {"type": "subtitle", "time": 5144.47, "timestamp": "01:25:44", "text": "好奇的。我心想，“等等，我……”"}, {"type": "subtitle", "time": 5149.83, "timestamp": "01:25:49", "text": "我的天啊。"}, {"type": "subtitle", "time": 5152.39, "timestamp": "01:25:52", "text": "我们可以调查一下吗？"}, {"type": "subtitle", "time": 5155.35, "timestamp": "01:25:55", "text": "好的，请随意。哪个点是确切的"}, {"type": "subtitle", "time": 5156.87, "timestamp": "01:25:56", "text": "你想调查什么？喜欢"}, {"type": "subtitle", "time": 5159.27, "timestamp": "01:25:59", "text": "fl 这个 这个 这个 就在这里"}]
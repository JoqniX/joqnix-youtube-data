[{"type": "subtitle", "time": 8341.89, "timestamp": "02:19:01", "text": "正在考虑中。"}, {"type": "subtitle", "time": 8344.87, "timestamp": "02:19:04", "text": "[音乐]"}, {"type": "subtitle", "time": 8348.79, "timestamp": "02:19:08", "text": "迪克，别进电影院。"}, {"type": "subtitle", "time": 8352.87, "timestamp": "02:19:12", "text": "这让他看起来很有趣，但并非如此。"}, {"type": "subtitle", "time": 8354.549, "timestamp": "02:19:14", "text": "不，"}, {"type": "subtitle", "time": 8358.07, "timestamp": "02:19:18", "text": "我居然一击必杀了所有人。"}, {"type": "subtitle", "time": 8368.15, "timestamp": "02:19:28", "text": "不，T在想，万一他们很可怕呢？"}, {"type": "subtitle", "time": 8369.83, "timestamp": "02:19:29", "text": "如果他们知道蜱虫正在吃东西呢？"}, {"type": "subtitle", "time": 8372.87, "timestamp": "02:19:32", "text": "你那丑儿子？"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "如果他们知道罪孽呢？"}, {"type": "subtitle", "time": 8376.87, "timestamp": "02:19:36", "text": "蜱虫罪。"}, {"type": "subtitle", "time": 8378.87, "timestamp": "02:19:38", "text": "好像我们不需要蜱虫一样。我们不需要"}, {"type": "subtitle", "time": 8381.509, "timestamp": "02:19:41", "text": "现在就去思考一下你的道德观念。"}, {"type": "subtitle", "time": 8384.389, "timestamp": "02:19:44", "text": "我需要一篇哲学论证文章。"}, {"type": "subtitle", "time": 8387.11, "timestamp": "02:19:47", "text": "不，勾号并不代表哲学。"}, {"type": "subtitle", "time": 8392.95, "timestamp": "02:19:52", "text": "你为什么要这样做？你是做什么的"}, {"type": "subtitle", "time": 8394.79, "timestamp": "02:19:54", "text": "在说什么？"}, {"type": "subtitle", "time": 8397.99, "timestamp": "02:19:57", "text": "别害怕蜱虫。"}, {"type": "subtitle", "time": 8399.91, "timestamp": "02:19:59", "text": "有可能用……吓唬他们吗？"}]
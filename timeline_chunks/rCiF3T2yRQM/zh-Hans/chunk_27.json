[{"type": "subtitle", "time": 1624.87, "timestamp": "00:27:04", "text": "挑选"}, {"type": "subtitle", "time": 1626.31, "timestamp": "00:27:06", "text": "那是为了你。"}, {"type": "subtitle", "time": 1628.31, "timestamp": "00:27:08", "text": "专为你准备。 Tick非常爱你。"}, {"type": "subtitle", "time": 1633.35, "timestamp": "00:27:13", "text": "妈的。我的鸟太胖了。"}, {"type": "subtitle", "time": 1635.75, "timestamp": "00:27:15", "text": "我把你的鸟挤进去。好了。"}, {"type": "subtitle", "time": 1638.39, "timestamp": "00:27:18", "text": "谢谢。"}, {"type": "subtitle", "time": 1639.59, "timestamp": "00:27:19", "text": "好的，"}, {"type": "subtitle", "time": 1642.63, "timestamp": "00:27:22", "text": "回到欢迎船员的环节。你可以"}, {"type": "subtitle", "time": 1646.149, "timestamp": "00:27:26", "text": "你可以帮助我们战斗，并展现你的魔法。"}, {"type": "subtitle", "time": 1649.51, "timestamp": "00:27:29", "text": "是啊，但愿如此。嗯，大概会是这样。"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "对其他人来说。"}, {"type": "subtitle", "time": 1660.23, "timestamp": "00:27:40", "text": "非常好。"}, {"type": "subtitle", "time": 1661.669, "timestamp": "00:27:41", "text": "这将掩盖他们并非如此的事实。"}, {"type": "subtitle", "time": 1667.269, "timestamp": "00:27:47", "text": "好的，我们明白了。你们将会"}, {"type": "subtitle", "time": 1669.99, "timestamp": "00:27:49", "text": "立即前往。任何预先准备工作"}, {"type": "subtitle", "time": 1673.11, "timestamp": "00:27:53", "text": "你想做什么？呃，"}, {"type": "subtitle", "time": 1676.389, "timestamp": "00:27:56", "text": "我只是想说，我觉得爱丽儿是"}, {"type": "subtitle", "time": 1678.789, "timestamp": "00:27:58", "text": "大概就会说，“Van，我们该怎么做？”"}]
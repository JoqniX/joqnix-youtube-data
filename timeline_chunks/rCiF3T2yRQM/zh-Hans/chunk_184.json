[{"type": "subtitle", "time": 11040.79, "timestamp": "03:04:00", "text": "实际上并没有真正死亡。他是一个"}, {"type": "subtitle", "time": 11041.99, "timestamp": "03:04:01", "text": "熟悉的。不用担心。"}, {"type": "subtitle", "time": 11044.469, "timestamp": "03:04:04", "text": "是的，你可以把他找回来。"}, {"type": "subtitle", "time": 11046.23, "timestamp": "03:04:06", "text": "我的意思是，如果你搬到这里来，"}, {"type": "subtitle", "time": 11048.23, "timestamp": "03:04:08", "text": "实际上并没有击中克里斯。"}, {"type": "subtitle", "time": 11048.71, "timestamp": "03:04:08", "text": "在哪里？"}, {"type": "subtitle", "time": 11052.309, "timestamp": "03:04:12", "text": "对，就在这儿。"}, {"type": "subtitle", "time": 11054.469, "timestamp": "03:04:14", "text": "就在那儿。"}, {"type": "subtitle", "time": 11056.309, "timestamp": "03:04:16", "text": "月光。等等，你能……是……是……"}, {"type": "subtitle", "time": 11058.63, "timestamp": "03:04:18", "text": "隐形吗？还是你想让它留在这里？如果"}, {"type": "subtitle", "time": 11061.99, "timestamp": "03:04:21", "text": "它在这里。是的，很安全。"}, {"type": "subtitle", "time": 11062.309, "timestamp": "03:04:22", "text": "呃"}, {"type": "subtitle", "time": 11064.95, "timestamp": "03:04:24", "text": "我的天啊。圣诞节又延续了一天。"}, {"type": "subtitle", "time": 11067.269, "timestamp": "03:04:27", "text": "又活了一天。是啊，没错。滚动"}, {"type": "subtitle", "time": 11069.03, "timestamp": "03:04:29", "text": "滚动月光伤害。"}, {"type": "subtitle", "time": 11071.51, "timestamp": "03:04:31", "text": "现在只需意识到范就像"}, {"type": "subtitle", "time": 11073.349, "timestamp": "03:04:33", "text": "真心实意地说，这个角色长得真好看。"}, {"type": "subtitle", "time": 11075.59, "timestamp": "03:04:35", "text": "就让他去死吧。"}, {"type": "subtitle", "time": 11083.75, "timestamp": "03:04:43", "text": "克里斯平尽职尽责。"}, {"type": "subtitle", "time": 11087.51, "timestamp": "03:04:47", "text": "他只需要做这些就够了。"}, {"type": "subtitle", "time": 11090.79, "timestamp": "03:04:50", "text": "好的。再次拨打电话。卷"}]
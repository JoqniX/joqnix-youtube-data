[{"type": "subtitle", "time": 7383.03, "timestamp": "02:03:03", "text": "倡议。好的。坚持，稍等。让我来揭晓"}, {"type": "subtitle", "time": 7384.709, "timestamp": "02:03:04", "text": "那个也是。好的。那是"}, {"type": "subtitle", "time": 7386.79, "timestamp": "02:03:06", "text": "每个人的主动性。"}, {"type": "subtitle", "time": 7388.55, "timestamp": "02:03:08", "text": "不要吃那些黏糊糊的东西。"}, {"type": "subtitle", "time": 7391.03, "timestamp": "02:03:11", "text": "把黏糊糊的东西吃掉。是的。好的，我们开始吧"}, {"type": "subtitle", "time": 7392.79, "timestamp": "02:03:12", "text": "去。我想我会把它换成"}, {"type": "subtitle", "time": 7394.55, "timestamp": "02:03:14", "text": "我的战斗歌单到底在哪儿？"}, {"type": "subtitle", "time": 7397.669, "timestamp": "02:03:17", "text": "好了。"}, {"type": "subtitle", "time": 7400.709, "timestamp": "02:03:20", "text": "好了，开始吧。"}, {"type": "subtitle", "time": 7401.03, "timestamp": "02:03:21", "text": "所以，"}, {"type": "subtitle", "time": 7401.589, "timestamp": "02:03:21", "text": "妈的，"}, {"type": "subtitle", "time": 7403.99, "timestamp": "02:03:23", "text": "它像一团黏糊糊的东西。"}, {"type": "subtitle", "time": 7405.83, "timestamp": "02:03:25", "text": "让它睡觉。我可以让它睡觉吗？"}, {"type": "subtitle", "time": 7407.589, "timestamp": "02:03:27", "text": "立即地？"}, {"type": "subtitle", "time": 7417.669, "timestamp": "02:03:37", "text": "我知道答案，但我不是"}, {"type": "subtitle", "time": 7419.189, "timestamp": "02:03:39", "text": "我假装不知道"}, {"type": "subtitle", "time": 7419.75, "timestamp": "02:03:39", "text": "任何事物。"}, {"type": "subtitle", "time": 7421.91, "timestamp": "02:03:41", "text": "我想知道答案是什么。"}, {"type": "subtitle", "time": 7425.189, "timestamp": "02:03:45", "text": "我知道这一点，但我不是。"}, {"type": "subtitle", "time": 7427.91, "timestamp": "02:03:47", "text": "有一个正确答案。"}, {"type": "subtitle", "time": 7429.75, "timestamp": "02:03:49", "text": "我不认为它像……"}, {"type": "subtitle", "time": 7431.83, "timestamp": "02:03:51", "text": "大脑睡眠能力。我不认为"}, {"type": "subtitle", "time": 7433.589, "timestamp": "02:03:53", "text": "它就像任何智慧一样，如果我要……"}, {"type": "subtitle", "time": 7434.47, "timestamp": "02:03:54", "text": "要诚实。"}, {"type": "subtitle", "time": 7435.75, "timestamp": "02:03:55", "text": "它是黏糊糊的东西。"}, {"type": "subtitle", "time": 7439.99, "timestamp": "02:03:59", "text": "是的。所以，我觉得我做不到。我"}]
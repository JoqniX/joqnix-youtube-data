ubtitle", "time": 9288.23, "timestamp": "02:34:48", "text": "你有弩吗？"}, {"type": "subtitle", "time": 9290.309, "timestamp": "02:34:50", "text": "是的。"}, {"type": "subtitle", "time": 9292.309, "timestamp": "02:34:52", "text": "我的意思是，现在你会记得了，因为"}, {"type": "subtitle", "time": 9294.87, "timestamp": "02:34:54", "text": "真实打击现在确实不错。"}, {"type": "subtitle", "time": 9296.79, "timestamp": "02:34:56", "text": "其实我并没有"}]
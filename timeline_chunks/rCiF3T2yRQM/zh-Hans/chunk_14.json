[{"type": "subtitle", "time": 842.23, "timestamp": "00:14:02", "text": "像猫一样。我猜钴就像"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "这只猫也喜欢猫。"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "它吃粉笔。"}, {"type": "subtitle", "time": 848.069, "timestamp": "00:14:08", "text": "你吃粉笔吗？"}, {"type": "subtitle", "time": 849.269, "timestamp": "00:14:09", "text": "哦，不。"}, {"type": "subtitle", "time": 851.11, "timestamp": "00:14:11", "text": "不，不，不。不要吃粉笔。那不是"}, {"type": "subtitle", "time": 852.79, "timestamp": "00:14:12", "text": "对你有好处。"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "不，粉笔很好。打钩。勾选喜欢"}, {"type": "subtitle", "time": 858.55, "timestamp": "00:14:18", "text": "粉笔和蜱虫喜欢盐岩。"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "可口的。"}, {"type": "subtitle", "time": 862.87, "timestamp": "00:14:22", "text": "这只是一点点，还有莲花。"}, {"type": "subtitle", "time": 865.99, "timestamp": "00:14:25", "text": "困惑"}, {"type": "subtitle", "time": 869.35, "timestamp": "00:14:29", "text": "嗯，我不看自己。我不认为"}, {"type": "subtitle", "time": 872.389, "timestamp": "00:14:32", "text": "我读到过钴喜欢吃盐。"}, {"type": "subtitle", "time": 874.55, "timestamp": "00:14:34", "text": "摇滚乐，但显然可能是学术界。"}, {"type": "subtitle", "time": 876.55, "timestamp": "00:14:36", "text": "是错误的，或者有很多"}, {"type": "subtitle", "time": 880.069, "timestamp": "00:14:40", "text": "缺少细节。我不知道。"}, {"type": "subtitle", "time": 883.67, "timestamp": "00:14:43", "text": "滴答就是滴答"}, {"type": "subtitle", "time": 884.55, "timestamp": "00:14:44", "text": "就是这样。"}, {"type": "subtitle", "time": 887.91, "timestamp": "00:14:47", "text": "我明白了。我看得很清楚。"}, {"type": "subtitle", "time": 889.43, "timestamp": "00:14:49", "text": "等等，你的名字是怎么来的？打钩。"}, {"type": "subtitle", "time": 891.43, "timestamp": "00:14:51", "text": "谁给你取的名字？"}, {"type": "subtitle", "time": 894.87, "timestamp": "00:14:54", "text": "哦，达斯克。名为 Tick 的 Dask。"}, {"type": "subtitle", "time": 895.43, "timestamp": "00:14:55", "text": "达斯克。"}, {"type": "subtitle", "time": 896.87, "timestamp": "00:14:56", "text": "什么？"}, {"type": "subtitle", "time": 899.59, "timestamp": "00:14:59", "text": "一只蜱虫。 D，那就是，那不是"}]
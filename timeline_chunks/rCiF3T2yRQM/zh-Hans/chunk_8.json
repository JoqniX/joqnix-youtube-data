[{"type": "subtitle", "time": 481.189, "timestamp": "00:08:01", "text": "我的天啊。"}, {"type": "subtitle", "time": 483.51, "timestamp": "00:08:03", "text": "迎面而来，势不可挡。只是"}, {"type": "subtitle", "time": 491.11, "timestamp": "00:08:11", "text": "它正朝你走来。就躺着"}, {"type": "subtitle", "time": 493.83, "timestamp": "00:08:13", "text": "向下。深呼吸。关闭你的"}, {"type": "subtitle", "time": 496.39, "timestamp": "00:08:16", "text": "眼睛。"}, {"type": "subtitle", "time": 497.749, "timestamp": "00:08:17", "text": "你会没事的。"}, {"type": "subtitle", "time": 506.07, "timestamp": "00:08:26", "text": "想法。你不会，你只会死。"}, {"type": "subtitle", "time": 516.949, "timestamp": "00:08:36", "text": "你好。欢迎光临。欢迎光临。您好。"}, {"type": "subtitle", "time": 518.149, "timestamp": "00:08:38", "text": "我的天啊。"}, {"type": "subtitle", "time": 520.63, "timestamp": "00:08:40", "text": "你好。各位晚上好。"}, {"type": "subtitle", "time": 521.75, "timestamp": "00:08:41", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 524.389, "timestamp": "00:08:44", "text": "晚上好。欢迎各位。"}, {"type": "subtitle", "time": 525.91, "timestamp": "00:08:45", "text": "耶。"}, {"type": "subtitle", "time": 527.19, "timestamp": "00:08:47", "text": "我希望它真的能加载得更快。"}, {"type": "subtitle", "time": 528.15, "timestamp": "00:08:48", "text": "因为我确实做了很多"}, {"type": "subtitle", "time": 531.03, "timestamp": "00:08:51", "text": "优化。所以，关卡加载速度很快。"}, {"type": "subtitle", "time": 532.389, "timestamp": "00:08:52", "text": "比上次快。"}, {"type": "subtitle", "time": 533.91, "timestamp": "00:08:53", "text": "加载速度真快。"}, {"type": "subtitle", "time": 535.43, "timestamp": "00:08:55", "text": "是"}, {"type": "subtitle", "time": 539.509, "timestamp": "00:08:59", "text": "我们走吧。我的妙招奏效了。这是"}]
[{"type": "subtitle", "time": 3120.069, "timestamp": "00:52:00", "text": "我很高兴你愿意尝试。"}, {"type": "subtitle", "time": 3121.27, "timestamp": "00:52:01", "text": "我这就去展示。是的。不，不。只是"}, {"type": "subtitle", "time": 3122.79, "timestamp": "00:52:02", "text": "我会揭晓答案。我会揭晓答案。"}, {"type": "subtitle", "time": 3128.79, "timestamp": "00:52:08", "text": "哦，不。"}, {"type": "subtitle", "time": 3131.99, "timestamp": "00:52:11", "text": "我看到了。"}, {"type": "subtitle", "time": 3133.589, "timestamp": "00:52:13", "text": "我只是在调查。我当时只是"}, {"type": "subtitle", "time": 3134.63, "timestamp": "00:52:14", "text": "正在调查中。她要颤抖了"}, {"type": "subtitle", "time": 3135.91, "timestamp": "00:52:15", "text": "她试图把它甩掉。"}, {"type": "subtitle", "time": 3137.75, "timestamp": "00:52:17", "text": "手指。"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "请不要像钴那样做。"}, {"type": "subtitle", "time": 3144.23, "timestamp": "00:52:24", "text": "你是人类。那不是人类所希望的。"}, {"type": "subtitle", "time": 3150.47, "timestamp": "00:52:30", "text": "我打算就此离开。"}, {"type": "subtitle", "time": 3152.63, "timestamp": "00:52:32", "text": "略感失望。"}, {"type": "subtitle", "time": 3156.87, "timestamp": "00:52:36", "text": "就这么进来，把所有东西都吸溜干净。"}, {"type": "subtitle", "time": 3161.109, "timestamp": "00:52:41", "text": "你会没事的。我们不需要"}, {"type": "subtitle", "time": 3164.63, "timestamp": "00:52:44", "text": "我们的饮食。我们有很多食物。"}, {"type": "subtitle", "time": 3166.79, "timestamp": "00:52:46", "text": "我还可以吃更多东西。"}, {"type": "subtitle", "time": 3171.829, "timestamp": "00:52:51", "text": "哦，不。"}, {"type": "subtitle", "time": 3173.99, "timestamp": "00:52:53", "text": "瞧，看看这个。看看这个古老的"}, {"type": "subtitle", "time": 3177.51, "timestamp": "00:52:57", "text": "描绘一只猫躺在地板上的图案。"}]
[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "但我会相信你。我不知道什么"}, {"type": "subtitle", "time": 2102.55, "timestamp": "00:35:02", "text": "我看不见。"}, {"type": "subtitle", "time": 2105.75, "timestamp": "00:35:05", "text": "哦。哦，这是聊天令牌吗？"}, {"type": "subtitle", "time": 2107.19, "timestamp": "00:35:07", "text": "哦，是的。那是"}, {"type": "subtitle", "time": 2108.79, "timestamp": "00:35:08", "text": "是的，你还记得我当时制作它的时候吗？"}, {"type": "subtitle", "time": 2109.349, "timestamp": "00:35:09", "text": "最后一次直播。"}, {"type": "subtitle", "time": 2112.95, "timestamp": "00:35:12", "text": "耶。我在这里。嘿，我们走吧。耶。"}, {"type": "subtitle", "time": 2113.829, "timestamp": "00:35:13", "text": "好的，"}, {"type": "subtitle", "time": 2115.109, "timestamp": "00:35:15", "text": "我们走吧。"}, {"type": "subtitle", "time": 2117.589, "timestamp": "00:35:17", "text": "我还有两扇门要走。"}, {"type": "subtitle", "time": 2118.15, "timestamp": "00:35:18", "text": "通过。"}, {"type": "subtitle", "time": 2118.55, "timestamp": "00:35:18", "text": "是的。"}, {"type": "subtitle", "time": 2122.31, "timestamp": "00:35:22", "text": "还有，给我，给我，给我旋转。"}, {"type": "subtitle", "time": 2124.069, "timestamp": "00:35:24", "text": "你知道吗？哦。哦好的。我可以，我可以"}, {"type": "subtitle", "time": 2124.79, "timestamp": "00:35:24", "text": "把它放在这里。"}, {"type": "subtitle", "time": 2125.349, "timestamp": "00:35:25", "text": "让我看看。"}, {"type": "subtitle", "time": 2128.87, "timestamp": "00:35:28", "text": "是的。好了，食谱如下。"}, {"type": "subtitle", "time": 2131.27, "timestamp": "00:35:31", "text": "他在那里。"}, {"type": "subtitle", "time": 2132.069, "timestamp": "00:35:32", "text": "我的儿子。"}, {"type": "subtitle", "time": 2133.75, "timestamp": "00:35:33", "text": "好的。"}, {"type": "subtitle", "time": 2136.23, "timestamp": "00:35:36", "text": "所以，我们建了一个更长的游泳池。哦，"}, {"type": "subtitle", "time": 2136.39, "timestamp": "00:35:36", "text": "是的。"}, {"type": "subtitle", "time": 2137.75, "timestamp": "00:35:37", "text": "我们又装了一扇门。"}, {"type": "subtitle", "time": 2140.069, "timestamp": "00:35:40", "text": "而且地板上也有。在"}, {"type": "subtitle", "time": 2141.349, "timestamp": "00:35:41", "text": "地板上也有一张纸条。"}, {"type": "subtitle", "time": 2144.63, "timestamp": "00:35:44", "text": "共同。有一张纸条，上面写着类似这样的话。"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "嗯，非常香，闻起来很香。"}, {"type": "subtitle", "time": 2150.63, "timestamp": "00:35:50", "text": "好的。它说，跟随我们的香水。"}, {"type": "subtitle", "time": 2154.55, "timestamp": "00:35:54", "text": "就在那里，然后就像爱一样，主题"}, {"type": "subtitle", "time": 2156.15, "timestamp": "00:35:56", "text": "兄弟。"}, {"type": "subtitle", "time": 2158.95, "timestamp": "00:35:58", "text": "哦，这是那位老乌龟先生发来的。他"}]
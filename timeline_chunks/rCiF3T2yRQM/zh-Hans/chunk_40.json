[{"type": "subtitle", "time": 2401.359, "timestamp": "00:40:01", "text": "我们。 WHO？ 你们认识我们。其他人。"}, {"type": "subtitle", "time": 2404.32, "timestamp": "00:40:04", "text": "你们认识我们。其他人。 这笑话一点都不好笑。再试一次。"}, {"type": "subtitle", "time": 2411.99, "timestamp": "00:40:11", "text": "有人说房间表面。"}, {"type": "subtitle", "time": 2413.99, "timestamp": "00:40:13", "text": "那真是个糟糕的角色。"}, {"type": "subtitle", "time": 2415.99, "timestamp": "00:40:15", "text": "家政。"}, {"type": "subtitle", "time": 2418.87, "timestamp": "00:40:18", "text": "装作你认识我们，认出我们就是你们。"}, {"type": "subtitle", "time": 2420.79, "timestamp": "00:40:20", "text": "莲花大师说你们这些人"}, {"type": "subtitle", "time": 2423.349, "timestamp": "00:40:23", "text": "我们应该记住我们是谁。"}, {"type": "subtitle", "time": 2429.03, "timestamp": "00:40:29", "text": "呃，莲花大师有好笑的笑话吗？"}, {"type": "subtitle", "time": 2436.069, "timestamp": "00:40:36", "text": "太糟糕了。"}, {"type": "subtitle", "time": 2439.349, "timestamp": "00:40:39", "text": "就像，嗯，她确实记得……"}, {"type": "subtitle", "time": 2441.43, "timestamp": "00:40:41", "text": "参加派对，所以我猜她就像是要去一样。"}, {"type": "subtitle", "time": 2443.349, "timestamp": "00:40:43", "text": "打开它。她打算告诉"}, {"type": "subtitle", "time": 2444.87, "timestamp": "00:40:44", "text": "每个人，即使他们可能"}, {"type": "subtitle", "time": 2447.43, "timestamp": "00:40:47", "text": "睡着了。她说道：“各位，我要……”"}, {"type": "subtitle", "time": 2450.069, "timestamp": "00:40:50", "text": "打开门。如果他们最终像"}, {"type": "subtitle", "time": 2451.829, "timestamp": "00:40:51", "text": "别担心，他们会攻击我们。我会杀了"}, {"type": "subtitle", "time": 2454.55, "timestamp": "00:40:54", "text": "他们。"}, {"type": "subtitle", "time": 2456.15, "timestamp": "00:40:56", "text": "她就像这样把路障拿走了。"}, {"type": "subtitle", "time": 2458.95, "timestamp": "00:40:58", "text": "打开。就像是，你好。"}]
[{"type": "subtitle", "time": 11461.03, "timestamp": "03:11:01", "text": "不，不是那种神奇的绦虫。不，"}, {"type": "subtitle", "time": 11463.51, "timestamp": "03:11:03", "text": "至少绦虫会死。"}, {"type": "subtitle", "time": 11471.99, "timestamp": "03:11:11", "text": "别进去。他们实际上不可能……蠕虫"}, {"type": "subtitle", "time": 11473.59, "timestamp": "03:11:13", "text": "实际上，他们只是把自己塞了进去"}, {"type": "subtitle", "time": 11474.95, "timestamp": "03:11:14", "text": "肠壁。"}, {"type": "subtitle", "time": 11477.19, "timestamp": "03:11:17", "text": "别问我怎么知道的。"}, {"type": "subtitle", "time": 11479.429, "timestamp": "03:11:19", "text": "我不想知道的事实"}, {"type": "subtitle", "time": 11484.55, "timestamp": "03:11:24", "text": "我知道，对吧？好像我不需要……"}, {"type": "subtitle", "time": 11487.91, "timestamp": "03:11:27", "text": "知道。我今天并不需要知道这些。"}, {"type": "subtitle", "time": 11488.95, "timestamp": "03:11:28", "text": "谢谢你，"}, {"type": "subtitle", "time": 11490.23, "timestamp": "03:11:30", "text": "亲爱的。"}, {"type": "subtitle", "time": 11491.75, "timestamp": "03:11:31", "text": "谁知道呢？或许，下一个敌人是……"}, {"type": "subtitle", "time": 11494.15, "timestamp": "03:11:34", "text": "将会是一条巨大的绦虫。"}, {"type": "subtitle", "time": 11497.349, "timestamp": "03:11:37", "text": "我的天啊。我的天啊。这是一篇篇幅很长的论文。"}, {"type": "subtitle", "time": 11500.87, "timestamp": "03:11:40", "text": "报复那盘神奇的录像带。"}, {"type": "subtitle", "time": 11502.309, "timestamp": "03:11:42", "text": "好的。还要别的吗？"}, {"type": "subtitle", "time": 11504.389, "timestamp": "03:11:44", "text": "我想我真的只能做到这些了。"}, {"type": "subtitle", "time": 11507.51, "timestamp": "03:11:47", "text": "好的。进而"}, {"type": "subtitle", "time": 11508.469, "timestamp": "03:11:48", "text": "好的，"}, {"type": "subtitle", "time": 11511.269, "timestamp": "03:11:51", "text": "兄弟。兄弟，我看着就像我的"}, {"type": "subtitle", "time": 11513.75, "timestamp": "03:11:53", "text": "咒语，还有，老兄，我的咒语是"}, {"type": "subtitle", "time": 11518.15, "timestamp": "03:11:58", "text": "尤其是我跟人打架的时候"}]
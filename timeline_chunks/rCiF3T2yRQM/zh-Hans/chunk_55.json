[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "这个房间里有一张巨大的桌子。"}, {"type": "subtitle", "time": 3302.71, "timestamp": "00:55:02", "text": "这里。就像这是一个巨大的"}, {"type": "subtitle", "time": 3305.349, "timestamp": "00:55:05", "text": "桌子上有很多东西"}, {"type": "subtitle", "time": 3308.069, "timestamp": "00:55:08", "text": "食物。食物非常新鲜。外观"}, {"type": "subtitle", "time": 3309.51, "timestamp": "00:55:09", "text": "可口的。"}, {"type": "subtitle", "time": 3311.99, "timestamp": "00:55:11", "text": "我想这就是他们所说的神奇食物吧"}, {"type": "subtitle", "time": 3314.71, "timestamp": "00:55:14", "text": "我们正在谈论的。我可以滚动我们的"}, {"type": "subtitle", "time": 3317.19, "timestamp": "00:55:17", "text": "好的，请便。"}, {"type": "subtitle", "time": 3319.51, "timestamp": "00:55:19", "text": "好的，"}, {"type": "subtitle", "time": 3322.069, "timestamp": "00:55:22", "text": "我们应该在尝试之前进行调查。"}, {"type": "subtitle", "time": 3324.63, "timestamp": "00:55:24", "text": "做任何可疑的事情。迪克，别放"}, {"type": "subtitle", "time": 3327.19, "timestamp": "00:55:27", "text": "你拿到手了吗？"}, {"type": "subtitle", "time": 3329.91, "timestamp": "00:55:29", "text": "你确实知道这一点。"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "这种食物本身就具有神奇的功效，但是你"}, {"type": "subtitle", "time": 3334.79, "timestamp": "00:55:34", "text": "不知道。你其实懂得不多。"}, {"type": "subtitle", "time": 3336.39, "timestamp": "00:55:36", "text": "关于这件事，但你知道它是……"}, {"type": "subtitle", "time": 3338.47, "timestamp": "00:55:38", "text": "神奇。"}, {"type": "subtitle", "time": 3339.99, "timestamp": "00:55:39", "text": "把他们的小手放在上面，然后"}, {"type": "subtitle", "time": 3342.23, "timestamp": "00:55:42", "text": "也滚动我们的"}, {"type": "subtitle", "time": 3344.95, "timestamp": "00:55:44", "text": "好的。好的。给我一卷"}, {"type": "subtitle", "time": 3346.87, "timestamp": "00:55:46", "text": "瞎的。"}, {"type": "subtitle", "time": 3348.39, "timestamp": "00:55:48", "text": "就像推他们一把，推他们其中一个"}, {"type": "subtitle", "time": 3355.109, "timestamp": "00:55:55", "text": "非常有创意。"}, {"type": "subtitle", "time": 3356.789, "timestamp": "00:55:56", "text": "前进。"}, {"type": "subtitle", "time": 3359.91, "timestamp": "00:55:59", "text": "好的。哦，好的。好的。呃，你放"}]
[{"type": "subtitle", "time": 9966.389, "timestamp": "02:46:06", "text": "它……它被酸液浸湿了，但是"}, {"type": "subtitle", "time": 9968.469, "timestamp": "02:46:08", "text": "没意识到这有点像……"}, {"type": "subtitle", "time": 9971.19, "timestamp": "02:46:11", "text": "一个来自你来的地方。它不是"}, {"type": "subtitle", "time": 9973.11, "timestamp": "02:46:13", "text": "足以穿透你的盔甲"}, {"type": "subtitle", "time": 9974.87, "timestamp": "02:46:14", "text": "还有鞋子。"}, {"type": "subtitle", "time": 9976.469, "timestamp": "02:46:16", "text": "就像它会吞噬你一样"}, {"type": "subtitle", "time": 9978.55, "timestamp": "02:46:18", "text": "鞋。所以之后，你可能会吃新的"}, {"type": "subtitle", "time": 9980.63, "timestamp": "02:46:20", "text": "鞋子，但这还不够。"}, {"type": "subtitle", "time": 9982.55, "timestamp": "02:46:22", "text": "接触你的皮肤。"}, {"type": "subtitle", "time": 9983.51, "timestamp": "02:46:23", "text": "好的，"}, {"type": "subtitle", "time": 9989.349, "timestamp": "02:46:29", "text": "再往前走一点。看"}, {"type": "subtitle", "time": 9991.59, "timestamp": "02:46:31", "text": "如果我能看到什么的话。"}, {"type": "subtitle", "time": 9996.389, "timestamp": "02:46:36", "text": "我打算把克里斯·比姆放在头上"}, {"type": "subtitle", "time": 9998.389, "timestamp": "02:46:38", "text": "很快。他需要他需要一个"}, {"type": "subtitle", "time": 10000.23, "timestamp": "02:46:40", "text": "休息。"}, {"type": "subtitle", "time": 10003.429, "timestamp": "02:46:43", "text": "蜱虫不会走进脆脆的"}, {"type": "subtitle", "time": 10006.469, "timestamp": "02:46:46", "text": "打钩。你难道不尝试吃脆脆的东西吗？"}, {"type": "subtitle", "time": 10009.75, "timestamp": "02:46:49", "text": "哦，酥脆的并不"}, {"type": "subtitle", "time": 10012.71, "timestamp": "02:46:52", "text": "蜱虫会吃脆脆的。他太有活力了。"}, {"type": "subtitle", "time": 10015.6, "timestamp": "02:46:55", "text": "太有活力了。 对Tick来说，这活力太过旺盛了。"}, {"type": "subtitle", "time": 10017.68, "timestamp": "02:46:57", "text": "对Tick来说，这活力太过旺盛了。 更何况 Krispy 也是家人。"}]
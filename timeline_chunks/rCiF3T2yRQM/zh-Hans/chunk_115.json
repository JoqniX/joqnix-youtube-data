[{"type": "subtitle", "time": 6900.629, "timestamp": "01:55:00", "text": "家庭。"}, {"type": "subtitle", "time": 6902.39, "timestamp": "01:55:02", "text": "我的天啊。"}, {"type": "subtitle", "time": 6904.629, "timestamp": "01:55:04", "text": "他停止哭泣，露出了笑容。"}, {"type": "subtitle", "time": 6906.629, "timestamp": "01:55:06", "text": "立刻停止了哭泣。"}, {"type": "subtitle", "time": 6909.669, "timestamp": "01:55:09", "text": "我猜就像"}, {"type": "subtitle", "time": 6912.629, "timestamp": "01:55:12", "text": "Ari要给Tick一个拥抱。勾选"}, {"type": "subtitle", "time": 6916.229, "timestamp": "01:55:16", "text": "会发出快乐的小声音。"}, {"type": "subtitle", "time": 6917.43, "timestamp": "01:55:17", "text": "好吧，所以我想"}, {"type": "subtitle", "time": 6920.31, "timestamp": "01:55:20", "text": "操纵的艺术。"}, {"type": "subtitle", "time": 6922.07, "timestamp": "01:55:22", "text": "嗯，爱莉安娜并不是想操纵什么。"}, {"type": "subtitle", "time": 6925.99, "timestamp": "01:55:25", "text": "你。她只是在给你一个拥抱。"}, {"type": "subtitle", "time": 6927.669, "timestamp": "01:55:27", "text": "Stick的智慧究竟是什么？哦，"}, {"type": "subtitle", "time": 6934.07, "timestamp": "01:55:34", "text": "她那么聪明，却又那么蠢。"}, {"type": "subtitle", "time": 6937.03, "timestamp": "01:55:37", "text": "同时。"}, {"type": "subtitle", "time": 6937.43, "timestamp": "01:55:37", "text": "出色地，"}, {"type": "subtitle", "time": 6938.87, "timestamp": "01:55:38", "text": "就像爱莉安娜一样，你拥有你拥有"}, {"type": "subtitle", "time": 6943.109, "timestamp": "01:55:43", "text": "智力高，但缺乏街头智慧。"}, {"type": "subtitle", "time": 6944.79, "timestamp": "01:55:44", "text": "迷你书。"}, {"type": "subtitle", "time": 6947.589, "timestamp": "01:55:47", "text": "萨凡是我们所说的最基本的"}, {"type": "subtitle", "time": 6951.109, "timestamp": "01:55:51", "text": "贱人。他没有任何负面评价。"}, {"type": "subtitle", "time": 6953.99, "timestamp": "01:55:53", "text": "他就是个庸俗的家伙。"}, {"type": "subtitle", "time": 6956.47, "timestamp": "01:55:56", "text": "没关系。我们生活中都有一些基本要素。"}, {"type": "subtitle", "time": 6959.109, "timestamp": "01:55:59", "text": "好的，我已经考虑过了，"}]
[{"type": "subtitle", "time": 4620.55, "timestamp": "01:17:00", "text": "我跟你说实话。我觉得我不是"}, {"type": "subtitle", "time": 4624.31, "timestamp": "01:17:04", "text": "可以说是棘手的情况。请。"}, {"type": "subtitle", "time": 4626.149, "timestamp": "01:17:06", "text": "嗯"}, {"type": "subtitle", "time": 4627.83, "timestamp": "01:17:07", "text": "我真的不知道还能做什么了。"}, {"type": "subtitle", "time": 4630.149, "timestamp": "01:17:10", "text": "这里。"}, {"type": "subtitle", "time": 4633.27, "timestamp": "01:17:13", "text": "我想我可能会。打钩。蜱虫可能携带"}, {"type": "subtitle", "time": 4635.35, "timestamp": "01:17:15", "text": "计划。小鸡或许有计划。"}, {"type": "subtitle", "time": 4638.149, "timestamp": "01:17:18", "text": "好的。如果你有计划的话，嗯，我就……"}, {"type": "subtitle", "time": 4641.83, "timestamp": "01:17:21", "text": "这样做。就像点击一下。我只需轻敲一下。"}, {"type": "subtitle", "time": 4643.99, "timestamp": "01:17:23", "text": "他那该死的额头。你一直是"}, {"type": "subtitle", "time": 4645.189, "timestamp": "01:17:25", "text": "有指导。"}, {"type": "subtitle", "time": 4646.79, "timestamp": "01:17:26", "text": "好的。这是什么类型的指导？所以，"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "你需要具体说明它是否发生在……期间"}, {"type": "subtitle", "time": 4649.669, "timestamp": "01:17:29", "text": "疼痛。"}, {"type": "subtitle", "time": 4652.55, "timestamp": "01:17:32", "text": "你想提升哪项技能？"}, {"type": "subtitle", "time": 4656.07, "timestamp": "01:17:36", "text": "嗯，我很确定它也是。是吗？"}, {"type": "subtitle", "time": 4658.39, "timestamp": "01:17:38", "text": "竞技？是那一个吗？是的。"}, {"type": "subtitle", "time": 4659.35, "timestamp": "01:17:39", "text": "好的，"}, {"type": "subtitle", "time": 4664.47, "timestamp": "01:17:44", "text": "田径指南。"}, {"type": "subtitle", "time": 4666.07, "timestamp": "01:17:46", "text": "是的。这就是我的全部了。"}, {"type": "subtitle", "time": 4669.03, "timestamp": "01:17:49", "text": "转动。但实际上，Circus Bean Wait，"}, {"type": "subtitle", "time": 4670.87, "timestamp": "01:17:50", "text": "其实在那之前，我能先说一下吗？"}, {"type": "subtitle", "time": 4673.669, "timestamp": "01:17:53", "text": "马戏团豆子就像一根绳子，因为他确实如此。"}, {"type": "subtitle", "time": 4675.43, "timestamp": "01:17:55", "text": "我自己掌控局面？是的，"}, {"type": "subtitle", "time": 4678.07, "timestamp": "01:17:58", "text": "我只要把绳子给我，然后就像……"}]
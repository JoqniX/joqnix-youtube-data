[{"type": "subtitle", "time": 7442.39, "timestamp": "02:04:02", "text": "可以帮助解决这个问题。"}, {"type": "subtitle", "time": 7443.43, "timestamp": "02:04:03", "text": "是的，"}, {"type": "subtitle", "time": 7446.229, "timestamp": "02:04:06", "text": "我可以试试。我可以。还有哪些减益效果？"}, {"type": "subtitle", "time": 7447.43, "timestamp": "02:04:07", "text": "我有吗？"}, {"type": "subtitle", "time": 7449.83, "timestamp": "02:04:09", "text": "哦，是的。我忘了你会说，“哦，我们"}, {"type": "subtitle", "time": 7453.51, "timestamp": "02:04:13", "text": "真是太糟糕了。我刚刚意识到我是"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "真是个实用型法师。”而你曾经是……"}, {"type": "subtitle", "time": 7457.99, "timestamp": "02:04:17", "text": "减益法师。我们完蛋了。"}, {"type": "subtitle", "time": 7459.03, "timestamp": "02:04:19", "text": "我们走吧。"}, {"type": "subtitle", "time": 7459.75, "timestamp": "02:04:19", "text": "这个政党是"}, {"type": "subtitle", "time": 7462.229, "timestamp": "02:04:22", "text": "完全控制公鸡。"}, {"type": "subtitle", "time": 7465.03, "timestamp": "02:04:25", "text": "我觉得这个派对是乔。我要"}, {"type": "subtitle", "time": 7467.109, "timestamp": "02:04:27", "text": "看看 Jog，看看 Jog 是否真的"}, {"type": "subtitle", "time": 7469.51, "timestamp": "02:04:29", "text": "有用。"}, {"type": "subtitle", "time": 7473.669, "timestamp": "02:04:33", "text": "好吧，答案是……不。我们都是"}, {"type": "subtitle", "time": 7478.629, "timestamp": "02:04:38", "text": "我们都是他妈的支持者，而且只有一个。"}, {"type": "subtitle", "time": 7482.55, "timestamp": "02:04:42", "text": "水箱内有三个支撑结构。我们走吧。"}, {"type": "subtitle", "time": 7485.589, "timestamp": "02:04:45", "text": "至少可以说我们有双份的"}, {"type": "subtitle", "time": 7489.669, "timestamp": "02:04:49", "text": "爱莉安娜倒下了。"}, {"type": "subtitle", "time": 7492.07, "timestamp": "02:04:52", "text": "你们真的有吗？"}, {"type": "subtitle", "time": 7493.189, "timestamp": "02:04:53", "text": "不，"}, {"type": "subtitle", "time": 7494.39, "timestamp": "02:04:54", "text": "我不。"}, {"type": "subtitle", "time": 7497.189, "timestamp": "02:04:57", "text": "我的天哪。这肯定会很有趣。是否"}, {"type": "subtitle", "time": 7499.03, "timestamp": "02:04:59", "text": "工作没成？"}]
[{"type": "subtitle", "time": 11520.87, "timestamp": "03:12:00", "text": "到目前为止，我们还没有与人发生过战争。"}, {"type": "subtitle", "time": 11523.51, "timestamp": "03:12:03", "text": "史莱姆的内心深处也是人。"}, {"type": "subtitle", "time": 11525.349, "timestamp": "03:12:05", "text": "不，他们不是。他们没有"}, {"type": "subtitle", "time": 11527.19, "timestamp": "03:12:07", "text": "真是个该死的脑子。他们没有心。"}, {"type": "subtitle", "time": 11528.79, "timestamp": "03:12:08", "text": "闭嘴。"}, {"type": "subtitle", "time": 11532.469, "timestamp": "03:12:12", "text": "我忘了。你让我们相信了这一点。"}, {"type": "subtitle", "time": 11535.83, "timestamp": "03:12:15", "text": "你这边已经满了。嗯，还没有"}, {"type": "subtitle", "time": 11538.51, "timestamp": "03:12:18", "text": "吃一只皮卡丘。"}, {"type": "subtitle", "time": 11545.03, "timestamp": "03:12:25", "text": "我在这里能做什么？"}, {"type": "subtitle", "time": 11547.349, "timestamp": "03:12:27", "text": "是的。谢谢你，Tick。"}, {"type": "subtitle", "time": 11556.309, "timestamp": "03:12:36", "text": "[音乐]"}, {"type": "subtitle", "time": 11559.91, "timestamp": "03:12:39", "text": "如果它们有效，就不会这样了。"}, {"type": "subtitle", "time": 11561.99, "timestamp": "03:12:41", "text": "嗯哼。"}, {"type": "subtitle", "time": 11565.349, "timestamp": "03:12:45", "text": "想找点事做。"}, {"type": "subtitle", "time": 11568.23, "timestamp": "03:12:48", "text": "你知道吗，克里斯汀？真他妈的。"}, {"type": "subtitle", "time": 11569.51, "timestamp": "03:12:49", "text": "你可以移动。"}, {"type": "subtitle", "time": 11571.99, "timestamp": "03:12:51", "text": "嘿，你可以派人先去侦察一下。"}, {"type": "subtitle", "time": 11573.99, "timestamp": "03:12:53", "text": "是的。"}, {"type": "subtitle", "time": 11575.99, "timestamp": "03:12:55", "text": "我不知道。你知道吗？去他妈的。"}, {"type": "subtitle", "time": 11578.389, "timestamp": "03:12:58", "text": "我们正在进攻。"}]
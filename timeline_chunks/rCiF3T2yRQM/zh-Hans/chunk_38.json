[{"type": "subtitle", "time": 2285.829, "timestamp": "00:38:05", "text": "你知道吗？呃"}, {"type": "subtitle", "time": 2295.19, "timestamp": "00:38:15", "text": "我打算好好享受一下时光。"}, {"type": "subtitle", "time": 2295.829, "timestamp": "00:38:15", "text": "喜欢，"}, {"type": "subtitle", "time": 2299.19, "timestamp": "00:38:19", "text": "“你说我不应该……”"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "吃人的尸体"}, {"type": "subtitle", "time": 2305.109, "timestamp": "00:38:25", "text": "怪物。它不是"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "不像石头。石头对你来说很硬"}, {"type": "subtitle", "time": 2310.31, "timestamp": "00:38:30", "text": "嚼不动，但很软。停止进食。"}, {"type": "subtitle", "time": 2312.63, "timestamp": "00:38:32", "text": "我不太喜欢吃这些东西"}, {"type": "subtitle", "time": 2315.43, "timestamp": "00:38:35", "text": "地板。你呢，乔克？你想"}, {"type": "subtitle", "time": 2318.55, "timestamp": "00:38:38", "text": "吃掉地板上的果冻状东西？"}, {"type": "subtitle", "time": 2320.87, "timestamp": "00:38:40", "text": "不。"}, {"type": "subtitle", "time": 2322.71, "timestamp": "00:38:42", "text": "你不应该吃掉在地上的东西。"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "做得更好。"}, {"type": "subtitle", "time": 2330.71, "timestamp": "00:38:50", "text": "我的天啊。"}, {"type": "subtitle", "time": 2338.63, "timestamp": "00:38:58", "text": "门。这是个好消息。"}]
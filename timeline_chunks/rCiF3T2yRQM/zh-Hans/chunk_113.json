[{"type": "subtitle", "time": 6780.149, "timestamp": "01:53:00", "text": "真想进那个肉欲横流的房间。"}, {"type": "subtitle", "time": 6783.27, "timestamp": "01:53:03", "text": "所以，我们去做你想做的事吧"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "我想我们得试试看……"}, {"type": "subtitle", "time": 6786.709, "timestamp": "01:53:06", "text": "我不太想深入探讨这个问题。"}, {"type": "subtitle", "time": 6788.709, "timestamp": "01:53:08", "text": "肉体房间。"}, {"type": "subtitle", "time": 6790.87, "timestamp": "01:53:10", "text": "乔，你呢？你喜欢肉体吗？"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "房间？你想要"}, {"type": "subtitle", "time": 6794.709, "timestamp": "01:53:14", "text": "走吗？"}, {"type": "subtitle", "time": 6797.91, "timestamp": "01:53:17", "text": "不，我就跟着你们吧。"}, {"type": "subtitle", "time": 6799.669, "timestamp": "01:53:19", "text": "巨大的肉体房间。是的，"}, {"type": "subtitle", "time": 6802.229, "timestamp": "01:53:22", "text": "肉体房间。嗯，我想我们要走了"}, {"type": "subtitle", "time": 6802.79, "timestamp": "01:53:22", "text": "仅仅"}, {"type": "subtitle", "time": 6805.91, "timestamp": "01:53:25", "text": "墙壁确实如此。墙壁不匹配。"}, {"type": "subtitle", "time": 6807.35, "timestamp": "01:53:27", "text": "具体来说，就是这边。这绝对是"}, {"type": "subtitle", "time": 6809.03, "timestamp": "01:53:29", "text": "不匹配。"}, {"type": "subtitle", "time": 6810.47, "timestamp": "01:53:30", "text": "嗯，"}, {"type": "subtitle", "time": 6812.07, "timestamp": "01:53:32", "text": "我可以敲一下吗？"}, {"type": "subtitle", "time": 6815.43, "timestamp": "01:53:35", "text": "你轻点它。这里面肯定有东西。"}, {"type": "subtitle", "time": 6818.07, "timestamp": "01:53:38", "text": "它直接推开就行了。"}, {"type": "subtitle", "time": 6819.43, "timestamp": "01:53:39", "text": "我的天，这又要循环了。"}, {"type": "subtitle", "time": 6821.43, "timestamp": "01:53:41", "text": "又绕了一圈。"}, {"type": "subtitle", "time": 6824.229, "timestamp": "01:53:44", "text": "等等，我这就去拿。"}, {"type": "subtitle", "time": 6826.95, "timestamp": "01:53:46", "text": "把这东西拿过来。目前为止，呃，"}, {"type": "subtitle", "time": 6829.189, "timestamp": "01:53:49", "text": "克里斯彭走到了死胡同。"}, {"type": "subtitle", "time": 6831.51, "timestamp": "01:53:51", "text": "哦，你能敲一下吗？"}, {"type": "subtitle", "time": 6833.83, "timestamp": "01:53:53", "text": "轻敲一下。呃，我的意思是，我猜"}, {"type": "subtitle", "time": 6835.43, "timestamp": "01:53:55", "text": "我只是说他有点过分了。推动"}, {"type": "subtitle", "time": 6837.75, "timestamp": "01:53:57", "text": "继续推进。它在这里。"}]
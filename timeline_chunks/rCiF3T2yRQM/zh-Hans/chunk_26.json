[{"type": "subtitle", "time": 1563.269, "timestamp": "00:26:03", "text": "割礼。被环境蒙蔽了双眼。"}, {"type": "subtitle", "time": 1565.11, "timestamp": "00:26:05", "text": "我们正要出发时，爱莉安娜要去……"}, {"type": "subtitle", "time": 1568.23, "timestamp": "00:26:08", "text": "就像这样：“那么，Tick，你能做什么？”"}, {"type": "subtitle", "time": 1572.07, "timestamp": "00:26:12", "text": "打钩。 Tick做了很多事。"}, {"type": "subtitle", "time": 1573.75, "timestamp": "00:26:13", "text": "Tick最近得知他们"}, {"type": "subtitle", "time": 1575.59, "timestamp": "00:26:15", "text": "显然，他们一直以来都知道魔法。"}, {"type": "subtitle", "time": 1579.11, "timestamp": "00:26:19", "text": "时间。他们不知道。"}, {"type": "subtitle", "time": 1579.75, "timestamp": "00:26:19", "text": "哇。"}, {"type": "subtitle", "time": 1582.95, "timestamp": "00:26:22", "text": "所以，你是个神奇的……你是个神奇的"}, {"type": "subtitle", "time": 1584.789, "timestamp": "00:26:24", "text": "坦克。"}, {"type": "subtitle", "time": 1586.149, "timestamp": "00:26:26", "text": "在有人打开之前和之前"}, {"type": "subtitle", "time": 1587.99, "timestamp": "00:26:27", "text": "又是门。"}, {"type": "subtitle", "time": 1590.23, "timestamp": "00:26:30", "text": "我们别他妈去招惹那些老巫婆。"}, {"type": "subtitle", "time": 1593.029, "timestamp": "00:26:33", "text": "不再是了。"}, {"type": "subtitle", "time": 1600.39, "timestamp": "00:26:40", "text": "美好的。老太太们喜欢蜱虫。"}, {"type": "subtitle", "time": 1602.87, "timestamp": "00:26:42", "text": "不要爱老太太。没关系。"}, {"type": "subtitle", "time": 1607.51, "timestamp": "00:26:47", "text": "这些老太太们谁也不爱。"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "爱你。"}, {"type": "subtitle", "time": 1612.31, "timestamp": "00:26:52", "text": "我不这么认为。"}, {"type": "subtitle", "time": 1614.39, "timestamp": "00:26:54", "text": "我也这么认为。"}, {"type": "subtitle", "time": 1618.39, "timestamp": "00:26:58", "text": "蒂格不只是思考而已"}]
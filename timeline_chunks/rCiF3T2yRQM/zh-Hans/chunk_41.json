[{"type": "subtitle", "time": 2460.39, "timestamp": "00:41:00", "text": "你好，猫女士。"}, {"type": "subtitle", "time": 2463.99, "timestamp": "00:41:03", "text": "我现在就先睡了。"}, {"type": "subtitle", "time": 2466.39, "timestamp": "00:41:06", "text": "他是不是要脱离控制了？"}, {"type": "subtitle", "time": 2470.15, "timestamp": "00:41:10", "text": "仿佛瞬间消失。"}, {"type": "subtitle", "time": 2472.39, "timestamp": "00:41:12", "text": "乐趣因厚厚的舔舐而受到创伤"}, {"type": "subtitle", "time": 2473.27, "timestamp": "00:41:13", "text": "嘘。"}, {"type": "subtitle", "time": 2474.95, "timestamp": "00:41:14", "text": "是的。"}, {"type": "subtitle", "time": 2478.79, "timestamp": "00:41:18", "text": "哦。你好。你好呀。你好呀，"}, {"type": "subtitle", "time": 2482.23, "timestamp": "00:41:22", "text": "女圣骑士。嗯，那个人和另一个"}, {"type": "subtitle", "time": 2483.589, "timestamp": "00:41:23", "text": "一和"}, {"type": "subtitle", "time": 2485.91, "timestamp": "00:41:25", "text": "嗯"}, {"type": "subtitle", "time": 2496.15, "timestamp": "00:41:36", "text": "我们现在必须采取其他措施。"}, {"type": "subtitle", "time": 2498.79, "timestamp": "00:41:38", "text": "哦好的。我"}, {"type": "subtitle", "time": 2501.589, "timestamp": "00:41:41", "text": "更胜一筹。迪克将要发展出一种"}, {"type": "subtitle", "time": 2503.03, "timestamp": "00:41:43", "text": "复杂的。"}, {"type": "subtitle", "time": 2507.03, "timestamp": "00:41:47", "text": "嗯，好的。你们只看到雷吗？喜欢"}, {"type": "subtitle", "time": 2508.79, "timestamp": "00:41:48", "text": "她就在你们面前，但是"}, {"type": "subtitle", "time": 2511.03, "timestamp": "00:41:51", "text": "你可以看到她被绑住了，就像……"}, {"type": "subtitle", "time": 2514.309, "timestamp": "00:41:54", "text": "最后还剩一根绳子。"}, {"type": "subtitle", "time": 2518.55, "timestamp": "00:41:58", "text": "嗯，我想你们确实这么做了。"}]
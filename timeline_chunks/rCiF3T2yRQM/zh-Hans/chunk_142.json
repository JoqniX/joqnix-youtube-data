[{"type": "subtitle", "time": 8520.71, "timestamp": "02:22:00", "text": "他的每一种立场。除非有太多"}, {"type": "subtitle", "time": 8523.349, "timestamp": "02:22:03", "text": "搬家很麻烦。好的，"}, {"type": "subtitle", "time": 8525.27, "timestamp": "02:22:05", "text": "没关系。我可以接管。"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "圣诞节。"}, {"type": "subtitle", "time": 8527.91, "timestamp": "02:22:07", "text": "是的。是的。"}, {"type": "subtitle", "time": 8530.79, "timestamp": "02:22:10", "text": "我这就迅速接管我儿子。"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "你儿子很害怕。"}, {"type": "subtitle", "time": 8535.42, "timestamp": "02:22:15", "text": "你对我儿子做了什么？打钩。"}, {"type": "subtitle", "time": 8537.75, "timestamp": "02:22:17", "text": "[音乐]"}, {"type": "subtitle", "time": 8550.23, "timestamp": "02:22:30", "text": "我觉得这足以说明蜱虫的习性了。"}, {"type": "subtitle", "time": 8555.67, "timestamp": "02:22:35", "text": "我的天啊。"}, {"type": "subtitle", "time": 8558.15, "timestamp": "02:22:38", "text": "但那些尚未完成的事情，就还没有发生。"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "因为就连撒旦也无法宽恕。"}, {"type": "subtitle", "time": 8568.389, "timestamp": "02:22:48", "text": "好的。轮到你的时候还有什么要补充的吗？"}, {"type": "subtitle", "time": 8577.59, "timestamp": "02:22:57", "text": "好的。如果你一无所有，那就感受一下"}]
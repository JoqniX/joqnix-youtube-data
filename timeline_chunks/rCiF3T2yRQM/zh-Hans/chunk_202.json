[{"type": "subtitle", "time": 12123.349, "timestamp": "03:22:03", "text": "哦，"}, {"type": "subtitle", "time": 12126.309, "timestamp": "03:22:06", "text": "我得用石头砸一些史莱姆。"}, {"type": "subtitle", "time": 12128.71, "timestamp": "03:22:08", "text": "你给它 如果你给 不要给它"}, {"type": "subtitle", "time": 12131.59, "timestamp": "03:22:11", "text": "T 会直接把石头吃掉。"}, {"type": "subtitle", "time": 12135.99, "timestamp": "03:22:15", "text": "请不要喂食魔法石。"}, {"type": "subtitle", "time": 12137.75, "timestamp": "03:22:17", "text": "好的。还要别的吗？否则，就发动攻击。"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "他们。"}, {"type": "subtitle", "time": 12140.79, "timestamp": "03:22:20", "text": "好了，我讲完了。"}, {"type": "subtitle", "time": 12142.55, "timestamp": "03:22:22", "text": "遭到攻击。"}, {"type": "subtitle", "time": 12144.95, "timestamp": "03:22:24", "text": "你又要被黏液糊一身了。"}, {"type": "subtitle", "time": 12147.67, "timestamp": "03:22:27", "text": "好了，爱莉安娜，准备好开始吧"}, {"type": "subtitle", "time": 12149.51, "timestamp": "03:22:29", "text": "黏糊糊的。"}, {"type": "subtitle", "time": 12152.15, "timestamp": "03:22:32", "text": "好的，我们开始吧。嗯，真漂亮。"}, {"type": "subtitle", "time": 12155.19, "timestamp": "03:22:35", "text": "这是第一个。好的。你看"}, {"type": "subtitle", "time": 12157.03, "timestamp": "03:22:37", "text": "和其他史莱姆一样，它会拉扯"}, {"type": "subtitle", "time": 12159.269, "timestamp": "03:22:39", "text": "像有弹性的粘液一样穿过"}, {"type": "subtitle", "time": 12163.11, "timestamp": "03:22:43", "text": "它就在那里，并对你发起攻击。"}, {"type": "subtitle", "time": 12165.269, "timestamp": "03:22:45", "text": "让我来做吧。好的。我的天哪，那是"}, {"type": "subtitle", "time": 12166.389, "timestamp": "03:22:46", "text": "批评。"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "好的，这是一条批评意见。我的天啊。全部"}, {"type": "subtitle", "time": 12170.63, "timestamp": "03:22:50", "text": "正确的。"}, {"type": "subtitle", "time": 12172.95, "timestamp": "03:22:52", "text": "好的。嗯，"}, {"type": "subtitle", "time": 12177.91, "timestamp": "03:22:57", "text": "好的。头真的很大。这"}]
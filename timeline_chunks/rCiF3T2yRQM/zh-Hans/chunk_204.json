[{"type": "subtitle", "time": 12241.51, "timestamp": "03:24:01", "text": "蛆。"}, {"type": "subtitle", "time": 12242.79, "timestamp": "03:24:02", "text": "魔蛆。"}, {"type": "subtitle", "time": 12247.269, "timestamp": "03:24:07", "text": "我的天啊。好的。好的。"}, {"type": "subtitle", "time": 12250.55, "timestamp": "03:24:10", "text": "好的。是的。它已经生蛆了，如果"}, {"type": "subtitle", "time": 12252.79, "timestamp": "03:24:12", "text": "那是一个词。"}, {"type": "subtitle", "time": 12253.19, "timestamp": "03:24:13", "text": "是的。"}, {"type": "subtitle", "time": 12255.429, "timestamp": "03:24:15", "text": "好的。"}, {"type": "subtitle", "time": 12259.349, "timestamp": "03:24:19", "text": "哦，对不起。好吧，我其实掷出了那个。"}, {"type": "subtitle", "time": 12263.03, "timestamp": "03:24:23", "text": "为你。我的错。不过，如果你想的话。"}, {"type": "subtitle", "time": 12264.469, "timestamp": "03:24:24", "text": "可以重新抽取。我会让你们俩见面。"}, {"type": "subtitle", "time": 12266.55, "timestamp": "03:24:26", "text": "重新掷骰子。看看你能不能得到什么"}, {"type": "subtitle", "time": 12268.63, "timestamp": "03:24:28", "text": "更高。"}, {"type": "subtitle", "time": 12270.55, "timestamp": "03:24:30", "text": "但你感觉"}, {"type": "subtitle", "time": 12271.429, "timestamp": "03:24:31", "text": "对不起。"}, {"type": "subtitle", "time": 12272.87, "timestamp": "03:24:32", "text": "是的。哦，七。实际上，更高。"}, {"type": "subtitle", "time": 12276.15, "timestamp": "03:24:36", "text": "地狱。当然。四、"}, {"type": "subtitle", "time": 12278.63, "timestamp": "03:24:38", "text": "并非最小损失。"}, {"type": "subtitle", "time": 12280.71, "timestamp": "03:24:40", "text": "我们走吧。"}, {"type": "subtitle", "time": 12287.51, "timestamp": "03:24:47", "text": "还要别的吗？他们现在有磁力探测器了。"}]
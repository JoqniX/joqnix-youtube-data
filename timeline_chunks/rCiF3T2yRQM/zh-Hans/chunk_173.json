[{"type": "subtitle", "time": 10380.95, "timestamp": "02:53:00", "text": "这是一次轻松愉快的清洁冒险。"}, {"type": "subtitle", "time": 10383.03, "timestamp": "02:53:03", "text": "好的。乔，你想……"}, {"type": "subtitle", "time": 10385.11, "timestamp": "02:53:05", "text": "加入我们，晋升到更高职位？我该走了吗？"}, {"type": "subtitle", "time": 10387.59, "timestamp": "02:53:07", "text": "首先，我想是吧？谁想追她？"}, {"type": "subtitle", "time": 10388.79, "timestamp": "02:53:08", "text": "屁股？"}, {"type": "subtitle", "time": 10390.15, "timestamp": "02:53:10", "text": "让我"}, {"type": "subtitle", "time": 10393.11, "timestamp": "02:53:13", "text": "请您先让我儿子离开再尝试"}, {"type": "subtitle", "time": 10400.55, "timestamp": "02:53:20", "text": "好的。我，我想我还是进去吧。"}, {"type": "subtitle", "time": 10402.23, "timestamp": "02:53:22", "text": "第一的。"}, {"type": "subtitle", "time": 10403.51, "timestamp": "02:53:23", "text": "好的。我还要掷骰子决定。"}, {"type": "subtitle", "time": 10405.11, "timestamp": "02:53:25", "text": "现在。好了。就这么滚下去"}, {"type": "subtitle", "time": 10407.269, "timestamp": "02:53:27", "text": "是的。好的。好的。当你曾经"}, {"type": "subtitle", "time": 10409.269, "timestamp": "02:53:29", "text": "你喜欢踏上那片土地，你"}, {"type": "subtitle", "time": 10411.269, "timestamp": "02:53:31", "text": "意识到你在这里开始了"}, {"type": "subtitle", "time": 10413.429, "timestamp": "02:53:33", "text": "喜欢它，它能带你走得很远。"}, {"type": "subtitle", "time": 10414.95, "timestamp": "02:53:34", "text": "时间。"}, {"type": "subtitle", "time": 10416.79, "timestamp": "02:53:36", "text": "好的。然后，是的。然后，呃，那就是……"}, {"type": "subtitle", "time": 10418.389, "timestamp": "02:53:38", "text": "轮到爱莉安娜了。好的。接下来我是……"}, {"type": "subtitle", "time": 10420.15, "timestamp": "02:53:40", "text": "准备回镇上。接下来"}, {"type": "subtitle", "time": 10421.59, "timestamp": "02:53:41", "text": "接下来应该删除。"}, {"type": "subtitle", "time": 10423.429, "timestamp": "02:53:43", "text": "我想，当斯蒂芬站在这里时，我也会"}, {"type": "subtitle", "time": 10425.19, "timestamp": "02:53:45", "text": "也喜欢让你被拉扯。"}, {"type": "subtitle", "time": 10426.309, "timestamp": "02:53:46", "text": "哦"}, {"type": "subtitle", "time": 10429.91, "timestamp": "02:53:49", "text": "等待。我该怎么办？就待在那儿吧。"}, {"type": "subtitle", "time": 10431.59, "timestamp": "02:53:51", "text": "我被拉起来了，就像克里斯那样"}, {"type": "subtitle", "time": 10433.03, "timestamp": "02:53:53", "text": "抓住我的头发。"}, {"type": "subtitle", "time": 10435.03, "timestamp": "02:53:55", "text": "但一旦你踏入那里，你就会被拉扯。"}, {"type": "subtitle", "time": 10436.87, "timestamp": "02:53:56", "text": "在。"}, {"type": "subtitle", "time": 10437.67, "timestamp": "02:53:57", "text": "哦"}]
[{"type": "subtitle", "time": 3783.27, "timestamp": "01:03:03", "text": "雕像。"}, {"type": "subtitle", "time": 3785.27, "timestamp": "01:03:05", "text": "它们都一样吗？它们都还和以前一样。"}, {"type": "subtitle", "time": 3787.75, "timestamp": "01:03:07", "text": "他们都是同一个人。"}, {"type": "subtitle", "time": 3791.67, "timestamp": "01:03:11", "text": "这完全不用担心。"}, {"type": "subtitle", "time": 3793.43, "timestamp": "01:03:13", "text": "糟糕，那边有个东西。"}, {"type": "subtitle", "time": 3793.99, "timestamp": "01:03:13", "text": "好的，"}, {"type": "subtitle", "time": 3794.87, "timestamp": "01:03:14", "text": "现在又怎么了？"}, {"type": "subtitle", "time": 3795.349, "timestamp": "01:03:15", "text": "是的，"}, {"type": "subtitle", "time": 3797.27, "timestamp": "01:03:17", "text": "有个东西。看，那儿有个男的。"}, {"type": "subtitle", "time": 3800.069, "timestamp": "01:03:20", "text": "骷髅尸体。这是一具尸体。"}, {"type": "subtitle", "time": 3802.39, "timestamp": "01:03:22", "text": "指着这边。这就是"}, {"type": "subtitle", "time": 3804.39, "timestamp": "01:03:24", "text": "就像一堵被推开的墙"}, {"type": "subtitle", "time": 3805.91, "timestamp": "01:03:25", "text": "墙。而在地面上，"}, {"type": "subtitle", "time": 3808.71, "timestamp": "01:03:28", "text": "到处都是血。流了很多血。"}, {"type": "subtitle", "time": 3810.47, "timestamp": "01:03:30", "text": "这边好像有一些绿色植物"}, {"type": "subtitle", "time": 3812.549, "timestamp": "01:03:32", "text": "组织。你不知道那是什么。"}, {"type": "subtitle", "time": 3815.27, "timestamp": "01:03:35", "text": "嗯，我现在明白可疑之处在哪里了。"}, {"type": "subtitle", "time": 3819.99, "timestamp": "01:03:39", "text": "房间里有箱子和血迹。"}, {"type": "subtitle", "time": 3821.109, "timestamp": "01:03:41", "text": "这是一个箱子。"}, {"type": "subtitle", "time": 3823.109, "timestamp": "01:03:43", "text": "一个看似普通的房间里却有血迹。"}, {"type": "subtitle", "time": 3825.029, "timestamp": "01:03:45", "text": "它。"}, {"type": "subtitle", "time": 3826.63, "timestamp": "01:03:46", "text": "完全正常。"}, {"type": "subtitle", "time": 3832.309, "timestamp": "01:03:52", "text": "嗯。完全正常。就像所有事物一样"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "应该如此。"}, {"type": "subtitle", "time": 3833.99, "timestamp": "01:03:53", "text": "是的。"}, {"type": "subtitle", "time": 3836.069, "timestamp": "01:03:56", "text": "嗯。让我仔细看看。做"}, {"type": "subtitle", "time": 3839.029, "timestamp": "01:03:59", "text": "我有什么建议或许能帮上忙吗？"}]
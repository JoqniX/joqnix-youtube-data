[{"type": "subtitle", "time": 2820.55, "timestamp": "00:47:00", "text": "嗯，你会找到答案的。"}, {"type": "subtitle", "time": 2825.109, "timestamp": "00:47:05", "text": "最终。不用担心。你会找到的。"}, {"type": "subtitle", "time": 2831.27, "timestamp": "00:47:11", "text": "Lotus要对Ariana说："}, {"type": "subtitle", "time": 2833.829, "timestamp": "00:47:13", "text": "询问是否存在危险。"}, {"type": "subtitle", "time": 2834.71, "timestamp": "00:47:14", "text": "阿里，"}, {"type": "subtitle", "time": 2836.23, "timestamp": "00:47:16", "text": "哦，好的。有危险吗？我们"}, {"type": "subtitle", "time": 2837.829, "timestamp": "00:47:17", "text": "应该注意。"}, {"type": "subtitle", "time": 2843.589, "timestamp": "00:47:23", "text": "哦，"}, {"type": "subtitle", "time": 2845.27, "timestamp": "00:47:25", "text": "是的。"}, {"type": "subtitle", "time": 2850.79, "timestamp": "00:47:30", "text": "尝试之前，我们说要休息一下。"}, {"type": "subtitle", "time": 2854.63, "timestamp": "00:47:34", "text": "夜晚就像一只羊被吃掉了"}, {"type": "subtitle", "time": 2857.27, "timestamp": "00:47:37", "text": "那边某处有黏液。"}, {"type": "subtitle", "time": 2858.069, "timestamp": "00:47:38", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 2860.39, "timestamp": "00:47:40", "text": "好的。我们会没事的。我非常确定你"}, {"type": "subtitle", "time": 2862.39, "timestamp": "00:47:42", "text": "男人们有能力应对这种情况"}, {"type": "subtitle", "time": 2863.67, "timestamp": "00:47:43", "text": "他们。"}, {"type": "subtitle", "time": 2865.51, "timestamp": "00:47:45", "text": "他们应该做得更好。就像 Tick 那样"}, {"type": "subtitle", "time": 2867.349, "timestamp": "00:47:47", "text": "更好的。"}, {"type": "subtitle", "time": 2869.43, "timestamp": "00:47:49", "text": "不，是滴答。我本来就喜欢你。他们"}, {"type": "subtitle", "time": 2877.109, "timestamp": "00:47:57", "text": "卢克对冰棒的意图。"}]
[{"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "好的。是的。嗯，这达到了标准。"}, {"type": "subtitle", "time": 10865.67, "timestamp": "03:01:05", "text": "好了。你它它有点儿变成"}, {"type": "subtitle", "time": 10867.349, "timestamp": "03:01:07", "text": "切开。"}, {"type": "subtitle", "time": 10870.309, "timestamp": "03:01:10", "text": "杀。"}, {"type": "subtitle", "time": 10872.23, "timestamp": "03:01:12", "text": "有点恶心。"}, {"type": "subtitle", "time": 10874.55, "timestamp": "03:01:14", "text": "我猜我大概就直接删减吧。"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "我第二次攻击这个史莱姆"}, {"type": "subtitle", "time": 10883.75, "timestamp": "03:01:23", "text": "损害。"}, {"type": "subtitle", "time": 10890.95, "timestamp": "03:01:30", "text": "哇。我们他妈的进展得相当顺利"}, {"type": "subtitle", "time": 10892.95, "timestamp": "03:01:32", "text": "我知道，对吧？我的天哪，这些卷是"}, {"type": "subtitle", "time": 10899.51, "timestamp": "03:01:39", "text": "好的。轮到你了吗？还有其他事吗？"}, {"type": "subtitle", "time": 10903.51, "timestamp": "03:01:43", "text": "呃，我想呃，和我的"}, {"type": "subtitle", "time": 10905.75, "timestamp": "03:01:45", "text": "哦，是的。你有了面包武器。"}, {"type": "subtitle", "time": 10907.67, "timestamp": "03:01:47", "text": "我的什么？你简直就是个面包武器。你"}, {"type": "subtitle", "time": 10910.389, "timestamp": "03:01:50", "text": "火面包还是闪电面包？我是说，"}, {"type": "subtitle", "time": 10913.51, "timestamp": "03:01:53", "text": "哦，是啊，我想……"}, {"type": "subtitle", "time": 10915.03, "timestamp": "03:01:55", "text": "我觉得是奖励动作。你能吗？我能吗？"}, {"type": "subtitle", "time": 10917.269, "timestamp": "03:01:57", "text": "再检查一下拼写？我忘了是不是"}, {"type": "subtitle", "time": 10918.71, "timestamp": "03:01:58", "text": "行动或奖励行动，因为我知道如果"}]
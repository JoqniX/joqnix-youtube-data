[{"type": "subtitle", "time": 9480.55, "timestamp": "02:38:00", "text": "向上。"}, {"type": "subtitle", "time": 9484.07, "timestamp": "02:38:04", "text": "哇，我真无能为力。我"}, {"type": "subtitle", "time": 9485.83, "timestamp": "02:38:05", "text": "不想"}, {"type": "subtitle", "time": 9487.51, "timestamp": "02:38:07", "text": "我不想使用任何法术。"}, {"type": "subtitle", "time": 9493.67, "timestamp": "02:38:13", "text": "哇，我有时候都忘了这他妈到底有多糟糕。"}, {"type": "subtitle", "time": 9498.71, "timestamp": "02:38:18", "text": "妈的，他们这些该死的术士真是太可恶了。"}, {"type": "subtitle", "time": 9501.03, "timestamp": "02:38:21", "text": "总之，我开火了。"}, {"type": "subtitle", "time": 9504.389, "timestamp": "02:38:24", "text": "术士几乎得不到任何奖励。"}, {"type": "subtitle", "time": 9506.15, "timestamp": "02:38:26", "text": "好的。那非常神圣。好的。它"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "命中。"}, {"type": "subtitle", "time": 9508.63, "timestamp": "02:38:28", "text": "那非常神圣。那"}, {"type": "subtitle", "time": 9512.15, "timestamp": "02:38:32", "text": "非常神圣。我的天哪。"}, {"type": "subtitle", "time": 9513.11, "timestamp": "02:38:33", "text": "龙。"}, {"type": "subtitle", "time": 9515.349, "timestamp": "02:38:35", "text": "它已被圣化。全部"}, {"type": "subtitle", "time": 9516.23, "timestamp": "02:38:36", "text": "正确的。"}, {"type": "subtitle", "time": 9520.23, "timestamp": "02:38:40", "text": "圣化了，贱人。接受圣化。"}, {"type": "subtitle", "time": 9523.99, "timestamp": "02:38:43", "text": "去接受圣化吧，贱人。噗通。"}, {"type": "subtitle", "time": 9525.91, "timestamp": "02:38:45", "text": "我不喜欢那个词。你为什么会这样？"}, {"type": "subtitle", "time": 9527.67, "timestamp": "02:38:47", "text": "就这么说？"}, {"type": "subtitle", "time": 9529.99, "timestamp": "02:38:49", "text": "你为什么会这么说？就是它"}, {"type": "subtitle", "time": 9532.63, "timestamp": "02:38:52", "text": "听起来就像你知道自己喜欢什么"}, {"type": "subtitle", "time": 9534.71, "timestamp": "02:38:54", "text": "你称之为你试图喜欢的东西"}, {"type": "subtitle", "time": 9536.95, "timestamp": "02:38:56", "text": "教堂里，你把手伸向周围……"}]
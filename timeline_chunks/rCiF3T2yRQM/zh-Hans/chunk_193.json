[{"type": "subtitle", "time": 11580.23, "timestamp": "03:13:00", "text": "我们玩得很开心。去他妈的。小球。"}, {"type": "subtitle", "time": 11582.479, "timestamp": "03:13:02", "text": "去他妈的。小球。 嗯，我们正在施加影响。"}, {"type": "subtitle", "time": 11591.429, "timestamp": "03:13:11", "text": "好的。造成伤口。你将施加"}, {"type": "subtitle", "time": 11593.99, "timestamp": "03:13:13", "text": "一些伤口深入到黏液中。让我来做"}, {"type": "subtitle", "time": 11596.79, "timestamp": "03:13:16", "text": "骗局得逞。好了。好的。他妈的"}, {"type": "subtitle", "time": 11597.19, "timestamp": "03:13:17", "text": "你。"}, {"type": "subtitle", "time": 11599.59, "timestamp": "03:13:19", "text": "它非常，它，它，它不是吗？"}, {"type": "subtitle", "time": 11601.59, "timestamp": "03:13:21", "text": "拒绝受伤。"}, {"type": "subtitle", "time": 11605.11, "timestamp": "03:13:25", "text": "呃，豁免失败则伤害减半。"}, {"type": "subtitle", "time": 11608.95, "timestamp": "03:13:28", "text": "好的。一半伤害。"}, {"type": "subtitle", "time": 11614.07, "timestamp": "03:13:34", "text": "哇。我喜欢低伤害。"}, {"type": "subtitle", "time": 11614.95, "timestamp": "03:13:34", "text": "好的。"}, {"type": "subtitle", "time": 11617.429, "timestamp": "03:13:37", "text": "然后Crispy就直接上去打了，"}, {"type": "subtitle", "time": 11618.87, "timestamp": "03:13:38", "text": "兄弟。"}, {"type": "subtitle", "time": 11620.79, "timestamp": "03:13:40", "text": "是的。是的。"}, {"type": "subtitle", "time": 11622.389, "timestamp": "03:13:42", "text": "我好像不小心申请了九个，但是"}, {"type": "subtitle", "time": 11625.03, "timestamp": "03:13:45", "text": "你知道吗？没关系。我会补充"}, {"type": "subtitle", "time": 11627.75, "timestamp": "03:13:47", "text": "加五。好了。好的，就是这样。"}, {"type": "subtitle", "time": 11630.22, "timestamp": "03:13:50", "text": "点击量"}, {"type": "subtitle", "time": 11631.67, "timestamp": "03:13:51", "text": "[音乐]"}, {"type": "subtitle", "time": 11634.389, "timestamp": "03:13:54", "text": "损害。"}, {"type": "subtitle", "time": 11637.269, "timestamp": "03:13:57", "text": "造成了如此巨大的破坏。"}, {"type": "subtitle", "time": 11637.99, "timestamp": "03:13:57", "text": "造成更多破坏。"}]
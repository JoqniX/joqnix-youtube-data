[{"type": "subtitle", "time": 6121.03, "timestamp": "01:42:01", "text": "把尸体扔进去，然后就差不多了。"}, {"type": "subtitle", "time": 6123.75, "timestamp": "01:42:03", "text": "就像黑色液体蔓延开来一样"}, {"type": "subtitle", "time": 6125.99, "timestamp": "01:42:05", "text": "为你处理尸体，然后就像拉扯一样"}, {"type": "subtitle", "time": 6128.95, "timestamp": "01:42:08", "text": "放进去之后，好像开始冒泡了。你"}, {"type": "subtitle", "time": 6131.35, "timestamp": "01:42:11", "text": "看到很多类似小的东西"}, {"type": "subtitle", "time": 6134.629, "timestamp": "01:42:14", "text": "手指慢慢地，像是在慢慢地吞咽它。和"}, {"type": "subtitle", "time": 6137.109, "timestamp": "01:42:17", "text": "慢慢地，但肯定地，我的意思是，就像把……"}, {"type": "subtitle", "time": 6139.43, "timestamp": "01:42:19", "text": "这里面有具尸体，是的，尸体被……"}, {"type": "subtitle", "time": 6142.709, "timestamp": "01:42:22", "text": "溶解了，就在下面的下面"}, {"type": "subtitle", "time": 6146.31, "timestamp": "01:42:26", "text": "这管子里慢慢地流出蓝色液体"}, {"type": "subtitle", "time": 6148.31, "timestamp": "01:42:28", "text": "形成。"}, {"type": "subtitle", "time": 6150.31, "timestamp": "01:42:30", "text": "嘿，"}, {"type": "subtitle", "time": 6157.27, "timestamp": "01:42:37", "text": "我们正在进行回收利用。"}, {"type": "subtitle", "time": 6161.99, "timestamp": "01:42:41", "text": "总之。我们介意使用它们。"}, {"type": "subtitle", "time": 6164.95, "timestamp": "01:42:44", "text": "你知道，重复使用"}, {"type": "subtitle", "time": 6166.47, "timestamp": "01:42:46", "text": "尊重逝者固然重要，但"}, {"type": "subtitle", "time": 6168.39, "timestamp": "01:42:48", "text": "也重复使用"}, {"type": "subtitle", "time": 6169.27, "timestamp": "01:42:49", "text": "也。"}, {"type": "subtitle", "time": 6171.83, "timestamp": "01:42:51", "text": "重复使用即是尊重。"}, {"type": "subtitle", "time": 6174.31, "timestamp": "01:42:54", "text": "是的。因为你了解花，所以你知道"}, {"type": "subtitle", "time": 6176.47, "timestamp": "01:42:56", "text": "如果你用血浇花，它们就会"}, {"type": "subtitle", "time": 6179.59, "timestamp": "01:42:59", "text": "它们提供营养。那确实是一件事。"}]
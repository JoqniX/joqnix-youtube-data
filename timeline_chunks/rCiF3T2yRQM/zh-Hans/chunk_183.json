[{"type": "subtitle", "time": 10981.19, "timestamp": "03:03:01", "text": "我不知道我在这里能做什么。难道我不能"}, {"type": "subtitle", "time": 10984.87, "timestamp": "03:03:04", "text": "比如用我的棍子来移动"}, {"type": "subtitle", "time": 10988.87, "timestamp": "03:03:08", "text": "向前或其他什么，因为它是"}, {"type": "subtitle", "time": 10995.91, "timestamp": "03:03:15", "text": "呃"}, {"type": "subtitle", "time": 10999.21, "timestamp": "03:03:19", "text": "比如，呃，也许在这里。"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "[音乐]"}, {"type": "subtitle", "time": 11010.389, "timestamp": "03:03:30", "text": "等等，等等。好的。你搬家吗？"}, {"type": "subtitle", "time": 11012.87, "timestamp": "03:03:32", "text": "观察光束？"}, {"type": "subtitle", "time": 11015.429, "timestamp": "03:03:35", "text": "呃，我的意思是，等等，什么？"}, {"type": "subtitle", "time": 11017.83, "timestamp": "03:03:37", "text": "我当时不像那样"}, {"type": "subtitle", "time": 11018.389, "timestamp": "03:03:38", "text": "反正。"}, {"type": "subtitle", "time": 11020.55, "timestamp": "03:03:40", "text": "是的。是的。"}, {"type": "subtitle", "time": 11022.79, "timestamp": "03:03:42", "text": "哦，我可以移动月光。"}, {"type": "subtitle", "time": 11024.87, "timestamp": "03:03:44", "text": "是的。是的，你可以移动月光。"}, {"type": "subtitle", "time": 11025.91, "timestamp": "03:03:45", "text": "好的。"}, {"type": "subtitle", "time": 11027.19, "timestamp": "03:03:47", "text": "这里。"}, {"type": "subtitle", "time": 11029.429, "timestamp": "03:03:49", "text": "哦，我想把它搬到那里。"}, {"type": "subtitle", "time": 11030.309, "timestamp": "03:03:50", "text": "是的。"}, {"type": "subtitle", "time": 11038.79, "timestamp": "03:03:58", "text": "那我把它搬到这里来。克里斯·克里斯的意思是"}]
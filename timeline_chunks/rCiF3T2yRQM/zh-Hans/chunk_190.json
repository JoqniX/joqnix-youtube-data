[{"type": "subtitle", "time": 11401.19, "timestamp": "03:10:01", "text": "神奇的绦虫。把它扔给魔法"}, {"type": "subtitle", "time": 11402.15, "timestamp": "03:10:02", "text": "绦虫。"}, {"type": "subtitle", "time": 11405.83, "timestamp": "03:10:05", "text": "神奇的绦虫。"}, {"type": "subtitle", "time": 11407.429, "timestamp": "03:10:07", "text": "好的。呃，你需要视线范围"}, {"type": "subtitle", "time": 11409.269, "timestamp": "03:10:09", "text": "不过就这一点而言。对，就是这样。"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "你现在就能看到了。"}, {"type": "subtitle", "time": 11414.469, "timestamp": "03:10:14", "text": "我简直不敢相信我们就这样走进了"}, {"type": "subtitle", "time": 11416.23, "timestamp": "03:10:16", "text": "胃"}, {"type": "subtitle", "time": 11418.71, "timestamp": "03:10:18", "text": "随意地漫步在她的胃里。"}, {"type": "subtitle", "time": 11420.71, "timestamp": "03:10:20", "text": "现在正在肠胃里翻江倒海。这是"}, {"type": "subtitle", "time": 11425.83, "timestamp": "03:10:25", "text": "它"}, {"type": "subtitle", "time": 11427.75, "timestamp": "03:10:27", "text": "正在把我们搬出去。它会让我们拉屎"}, {"type": "subtitle", "time": 11429.11, "timestamp": "03:10:29", "text": "之后。"}, {"type": "subtitle", "time": 11430.87, "timestamp": "03:10:30", "text": "我们就这样进入下一部分了。"}, {"type": "subtitle", "time": 11432.15, "timestamp": "03:10:32", "text": "地牢。我们得拉屎了"}, {"type": "subtitle", "time": 11433.19, "timestamp": "03:10:33", "text": "向下。"}, {"type": "subtitle", "time": 11440.469, "timestamp": "03:10:40", "text": "干得好。无法保存。所以，它"}, {"type": "subtitle", "time": 11442.07, "timestamp": "03:10:42", "text": "不会。是的，它不会受到伤害。"}, {"type": "subtitle", "time": 11444.79, "timestamp": "03:10:44", "text": "向下。"}, {"type": "subtitle", "time": 11446.87, "timestamp": "03:10:46", "text": "是的。是的。它里面藏着一条绦虫。它"}, {"type": "subtitle", "time": 11450.39, "timestamp": "03:10:50", "text": "刚吃了条绦虫。现在这是他的朋友了。"}, {"type": "subtitle", "time": 11451.75, "timestamp": "03:10:51", "text": "[音乐]"}, {"type": "subtitle", "time": 11453.11, "timestamp": "03:10:53", "text": "神奇的绦虫。"}, {"type": "subtitle", "time": 11456.15, "timestamp": "03:10:56", "text": "这只史莱姆现在养了一条魔法绦虫当宠物。"}]
[{"type": "subtitle", "time": 2943.75, "timestamp": "00:49:03", "text": "好吧。嗯，拍拍他的头，就像"}, {"type": "subtitle", "time": 2945.27, "timestamp": "00:49:05", "text": "尴尬地。"}, {"type": "subtitle", "time": 2947.99, "timestamp": "00:49:07", "text": "现在，你们继续吧。"}, {"type": "subtitle", "time": 2950.309, "timestamp": "00:49:10", "text": "你的冒险经历？"}, {"type": "subtitle", "time": 2957.27, "timestamp": "00:49:17", "text": "你们这小家伙真奇怪！"}, {"type": "subtitle", "time": 2957.99, "timestamp": "00:49:17", "text": "有。是的。"}, {"type": "subtitle", "time": 2959.99, "timestamp": "00:49:19", "text": "好的。那么，你们想让我们去哪里？"}, {"type": "subtitle", "time": 2962.15, "timestamp": "00:49:22", "text": "等我们……的时候再见"}, {"type": "subtitle", "time": 2963.589, "timestamp": "00:49:23", "text": "我们结束了吗？"}, {"type": "subtitle", "time": 2967.03, "timestamp": "00:49:27", "text": "嗯，或许如果你……或许我们会尝试……"}, {"type": "subtitle", "time": 2969.03, "timestamp": "00:49:29", "text": "找到你。你可以找到一个迹象"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "当我们准备出门的时候。什么时候"}, {"type": "subtitle", "time": 2972.71, "timestamp": "00:49:32", "text": "大家都休息好了，我们接下来会怎样？"}, {"type": "subtitle", "time": 2974.39, "timestamp": "00:49:34", "text": "你。"}, {"type": "subtitle", "time": 2975.27, "timestamp": "00:49:35", "text": "痒痒。"}, {"type": "subtitle", "time": 2977.91, "timestamp": "00:49:37", "text": "听起来不错。我没有其他事了。"}, {"type": "subtitle", "time": 2989.51, "timestamp": "00:49:49", "text": "你们俩要不要离开？我"}, {"type": "subtitle", "time": 2993.91, "timestamp": "00:49:53", "text": "我还需要睡一会儿美容觉。"}, {"type": "subtitle", "time": 2995.43, "timestamp": "00:49:55", "text": "我觉得你不可能更漂亮了。"}, {"type": "subtitle", "time": 2996.87, "timestamp": "00:49:56", "text": "好好休息。"}, {"type": "subtitle", "time": 2998.15, "timestamp": "00:49:58", "text": "晚安。"}]
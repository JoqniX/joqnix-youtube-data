[{"type": "subtitle", "time": 7200.07, "timestamp": "02:00:00", "text": "会对此产生反应。就好像不在一样"}, {"type": "subtitle", "time": 7203.03, "timestamp": "02:00:03", "text": "一种重要的方式。哦好的。它有"}, {"type": "subtitle", "time": 7204.79, "timestamp": "02:00:04", "text": "也有类似的反应，但感觉"}, {"type": "subtitle", "time": 7206.55, "timestamp": "02:00:06", "text": "感觉太大了，难以消化，我想是这样吧。"}, {"type": "subtitle", "time": 7208.629, "timestamp": "02:00:08", "text": "可以说。"}, {"type": "subtitle", "time": 7215.99, "timestamp": "02:00:15", "text": "你们觉得我们应该怎么做？"}, {"type": "subtitle", "time": 7222.07, "timestamp": "02:00:22", "text": "Lotus会插话说，我没有"}, {"type": "subtitle", "time": 7224.55, "timestamp": "02:00:24", "text": "真是太想把自己送出去了"}, {"type": "subtitle", "time": 7226.95, "timestamp": "02:00:26", "text": "大家都喜欢给我们发信息"}, {"type": "subtitle", "time": 7229.83, "timestamp": "02:00:29", "text": "特别没有让爱莉安娜下台"}, {"type": "subtitle", "time": 7235.51, "timestamp": "02:00:35", "text": "血肉之躯最终会被吃掉，但我们"}, {"type": "subtitle", "time": 7237.589, "timestamp": "02:00:37", "text": "我们真的没有其他选择。"}, {"type": "subtitle", "time": 7239.99, "timestamp": "02:00:39", "text": "眼下。"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "我们不会得到那么多。"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "如果我们不继续下去，就会有这样的信息。"}, {"type": "subtitle", "time": 7246.95, "timestamp": "02:00:46", "text": "愚蠢的蘑菇。"}, {"type": "subtitle", "time": 7248.629, "timestamp": "02:00:48", "text": "大概会是这样的：“好，我来领导。”"}, {"type": "subtitle", "time": 7249.99, "timestamp": "02:00:49", "text": "这项指控。”她要走了。"}, {"type": "subtitle", "time": 7251.35, "timestamp": "02:00:51", "text": "前方。"}, {"type": "subtitle", "time": 7253.03, "timestamp": "02:00:53", "text": "哦，不。"}, {"type": "subtitle", "time": 7255.589, "timestamp": "02:00:55", "text": "你滑了进去。嘘。而且还有类似这样的"}, {"type": "subtitle", "time": 7259.109, "timestamp": "02:00:59", "text": "有什么？这里有这种黄色液体"}]
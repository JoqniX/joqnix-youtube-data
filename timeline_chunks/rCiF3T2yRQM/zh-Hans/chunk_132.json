[{"type": "subtitle", "time": 7921.109, "timestamp": "02:12:01", "text": "哦，我咽不下去。"}, {"type": "subtitle", "time": 7923.91, "timestamp": "02:12:03", "text": "太糟糕了，太糟糕了"}, {"type": "subtitle", "time": 7926.31, "timestamp": "02:12:06", "text": "哦，是其中之一。"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "我的天啊，操。我讨厌"}, {"type": "subtitle", "time": 7931.51, "timestamp": "02:12:11", "text": "不，其实我不能说我讨厌我"}, {"type": "subtitle", "time": 7933.35, "timestamp": "02:12:13", "text": "我真的超爱史莱姆。"}, {"type": "subtitle", "time": 7935.75, "timestamp": "02:12:15", "text": "我也很喜欢它们。哦，我太喜欢了！"}, {"type": "subtitle", "time": 7936.87, "timestamp": "02:12:16", "text": "一般的。"}, {"type": "subtitle", "time": 7937.589, "timestamp": "02:12:17", "text": "是的，"}, {"type": "subtitle", "time": 7939.27, "timestamp": "02:12:19", "text": "老实说，这是我最喜欢的怪物类型。我 我"}, {"type": "subtitle", "time": 7940.629, "timestamp": "02:12:20", "text": "希望他们能得到更多巫师们的喜爱"}, {"type": "subtitle", "time": 7942.95, "timestamp": "02:12:22", "text": "海岸。需要更多史莱姆。"}, {"type": "subtitle", "time": 7944.069, "timestamp": "02:12:24", "text": "我发誓"}, {"type": "subtitle", "time": 7951.27, "timestamp": "02:12:31", "text": "是的，"}, {"type": "subtitle", "time": 7954.87, "timestamp": "02:12:34", "text": "他们有时候很糟糕。"}, {"type": "subtitle", "time": 7957.35, "timestamp": "02:12:37", "text": "好的。还要别的吗？"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "我不这么认为。我认为那就是"}, {"type": "subtitle", "time": 7962.149, "timestamp": "02:12:42", "text": "轮到我的时候，这就是我所能做的。"}, {"type": "subtitle", "time": 7965.99, "timestamp": "02:12:45", "text": "好的。好的。这些人呃，我们来吧，我是"}, {"type": "subtitle", "time": 7968.47, "timestamp": "02:12:48", "text": "他们将要搬家。那里"}, {"type": "subtitle", "time": 7971.669, "timestamp": "02:12:51", "text": "你去。坚持，稍等。哦，这太像钱包了。"}, {"type": "subtitle", "time": 7974.069, "timestamp": "02:12:54", "text": "好了，这家伙要让开了。"}, {"type": "subtitle", "time": 7976.229, "timestamp": "02:12:56", "text": "然后它就会变得很粘稠。"}]
[{"type": "subtitle", "time": 8162.149, "timestamp": "02:16:02", "text": "等等，我必须搬到这里来吗？"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "我认为你可以把目标放在这里。我认为"}, {"type": "subtitle", "time": 8167.99, "timestamp": "02:16:07", "text": "是的，"}, {"type": "subtitle", "time": 8171.109, "timestamp": "02:16:11", "text": "我应该服用法术还是"}, {"type": "subtitle", "time": 8171.51, "timestamp": "02:16:11", "text": "那？"}, {"type": "subtitle", "time": 8173.27, "timestamp": "02:16:13", "text": "既然你在用，那就消耗掉吧。"}, {"type": "subtitle", "time": 8174.709, "timestamp": "02:16:14", "text": "吃掉它。"}, {"type": "subtitle", "time": 8177.35, "timestamp": "02:16:17", "text": "好的。嗯，"}, {"type": "subtitle", "time": 8179.43, "timestamp": "02:16:19", "text": "等待。呃"}, {"type": "subtitle", "time": 8183.43, "timestamp": "02:16:23", "text": "呃，我可以问问我的同伴们吗？呃呃，但是"}, {"type": "subtitle", "time": 8185.75, "timestamp": "02:16:25", "text": "我应该把我的计划告诉他们吗？应该"}, {"type": "subtitle", "time": 8189.589, "timestamp": "02:16:29", "text": "我愿意？我该怎么办？"}, {"type": "subtitle", "time": 8190.31, "timestamp": "02:16:30", "text": "哦好的。你好。"}, {"type": "subtitle", "time": 8192.15, "timestamp": "02:16:32", "text": "不，不，不。你做你做任何事"}, {"type": "subtitle", "time": 8194.629, "timestamp": "02:16:34", "text": "你想做什么。"}, {"type": "subtitle", "time": 8198.309, "timestamp": "02:16:38", "text": "所以也许我们应该倒点黑酒"}, {"type": "subtitle", "time": 8201.03, "timestamp": "02:16:41", "text": "他们身上带着酒。其中一种黏液。然后我"}, {"type": "subtitle", "time": 8203.75, "timestamp": "02:16:43", "text": "用月光术把它们全都射进去"}, {"type": "subtitle", "time": 8206.07, "timestamp": "02:16:46", "text": "一次性完成，并将它们整合起来，或者"}, {"type": "subtitle", "time": 8209.03, "timestamp": "02:16:49", "text": "某物。会"}, {"type": "subtitle", "time": 8210.469, "timestamp": "02:16:50", "text": "那样做？"}, {"type": "subtitle", "time": 8212.79, "timestamp": "02:16:52", "text": "你可以试试。"}, {"type": "subtitle", "time": 8217.91, "timestamp": "02:16:57", "text": "当然可以试试。"}]
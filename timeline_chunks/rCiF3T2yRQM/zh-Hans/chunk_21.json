[{"type": "subtitle", "time": 1260.23, "timestamp": "00:21:00", "text": "哦，是的"}, {"type": "subtitle", "time": 1264.07, "timestamp": "00:21:04", "text": "因为你点击了手电筒。它是"}, {"type": "subtitle", "time": 1266.23, "timestamp": "00:21:06", "text": "不，我点击“查找我的令牌”却找不到。"}, {"type": "subtitle", "time": 1268.95, "timestamp": "00:21:08", "text": "移动刻度线。我不知道为什么会这样。"}, {"type": "subtitle", "time": 1271.029, "timestamp": "00:21:11", "text": "是。"}, {"type": "subtitle", "time": 1273.27, "timestamp": "00:21:13", "text": "当我的令牌是火炬时。"}, {"type": "subtitle", "time": 1275.43, "timestamp": "00:21:15", "text": "令牌是火炬。"}, {"type": "subtitle", "time": 1277.83, "timestamp": "00:21:17", "text": "好的，稍等一下。就像我一样，是的，我"}, {"type": "subtitle", "time": 1280.549, "timestamp": "00:21:20", "text": "已勾选。它表现得像"}, {"type": "subtitle", "time": 1282.31, "timestamp": "00:21:22", "text": "蜱虫是敌人。我不知道为什么会这样。"}, {"type": "subtitle", "time": 1283.35, "timestamp": "00:21:23", "text": "是。"}, {"type": "subtitle", "time": 1285.029, "timestamp": "00:21:25", "text": "让我再确认一下。好的，我是"}, {"type": "subtitle", "time": 1287.909, "timestamp": "00:21:27", "text": "我打算尽快完成这件事。好的，"}, {"type": "subtitle", "time": 1290.23, "timestamp": "00:21:30", "text": "那我这就快速完成这件事。抓住"}, {"type": "subtitle", "time": 1293.27, "timestamp": "00:21:33", "text": "在。嗯，好的。好了。呃，"}, {"type": "subtitle", "time": 1295.43, "timestamp": "00:21:35", "text": "立即检查。现在就试试。"}, {"type": "subtitle", "time": 1297.669, "timestamp": "00:21:37", "text": "仍然连在手电筒上。"}, {"type": "subtitle", "time": 1300.149, "timestamp": "00:21:40", "text": "呃，好的。坚持，稍等。如果我喜欢……"}, {"type": "subtitle", "time": 1301.59, "timestamp": "00:21:41", "text": "移除您的令牌并重新添加？"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "好了。它有效吗？"}, {"type": "subtitle", "time": 1305.51, "timestamp": "00:21:45", "text": "不，它仍然与我相连。"}, {"type": "subtitle", "time": 1308.549, "timestamp": "00:21:48", "text": "火炬。我不知道为什么。我简直无语了。"}, {"type": "subtitle", "time": 1310.149, "timestamp": "00:21:50", "text": "棍子现在呈灰色，无法点击。我不知道"}, {"type": "subtitle", "time": 1310.95, "timestamp": "00:21:50", "text": "这是怎么回事。"}, {"type": "subtitle", "time": 1313.27, "timestamp": "00:21:53", "text": "嗯。这真酷。为什么会这样？"}, {"type": "subtitle", "time": 1316.63, "timestamp": "00:21:56", "text": "连接到手电筒上吗？ H."}, {"type": "subtitle", "time": 1318.71, "timestamp": "00:21:58", "text": "真奇怪。呃，如果你点击"}, {"type": "subtitle", "time": 1319.99, "timestamp": "00:21:59", "text": "勾选，然后像使用方向键一样操作，"}]
[{"type": "subtitle", "time": 2700.95, "timestamp": "00:45:00", "text": "味道好极了。你应该这么做。"}, {"type": "subtitle", "time": 2701.67, "timestamp": "00:45:01", "text": "更多的。"}, {"type": "subtitle", "time": 2705.67, "timestamp": "00:45:05", "text": "呃，你不会那样做的。我喜欢血。"}, {"type": "subtitle", "time": 2708.47, "timestamp": "00:45:08", "text": "我不喜欢地板上有粪便。感谢"}, {"type": "subtitle", "time": 2709.91, "timestamp": "00:45:09", "text": "非常感谢。"}, {"type": "subtitle", "time": 2712.23, "timestamp": "00:45:12", "text": "蜱虫确实会这样做。"}, {"type": "subtitle", "time": 2714.39, "timestamp": "00:45:14", "text": "食粪者。好的。你知道吗？"}, {"type": "subtitle", "time": 2716.71, "timestamp": "00:45:16", "text": "可能不是我遇到过的最糟糕的人。"}, {"type": "subtitle", "time": 2719.51, "timestamp": "00:45:19", "text": "今生。看看"}, {"type": "subtitle", "time": 2726.15, "timestamp": "00:45:26", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 2727.19, "timestamp": "00:45:27", "text": "好的。"}, {"type": "subtitle", "time": 2729.349, "timestamp": "00:45:29", "text": "那么，我们还有什么需要注意的吗？"}, {"type": "subtitle", "time": 2731.109, "timestamp": "00:45:31", "text": "除了死者之外，还要担心什么呢？"}, {"type": "subtitle", "time": 2732.63, "timestamp": "00:45:32", "text": "史莱姆？"}, {"type": "subtitle", "time": 2734.63, "timestamp": "00:45:34", "text": "有什么可怕的事情吗？有什么好玩的吗？哦，是吗？"}, {"type": "subtitle", "time": 2738.95, "timestamp": "00:45:38", "text": "你们找到战利品了吗？你们搜刮到东西了吗？"}, {"type": "subtitle", "time": 2741.51, "timestamp": "00:45:41", "text": "她只是抱着头"}, {"type": "subtitle", "time": 2745.67, "timestamp": "00:45:45", "text": "抢劫。好的，我们确实找到了地方。"}, {"type": "subtitle", "time": 2750.069, "timestamp": "00:45:50", "text": "就在某个偏僻的地方"}, {"type": "subtitle", "time": 2752.15, "timestamp": "00:45:52", "text": "哪里才是合适的地点？它是东边吗？"}, {"type": "subtitle", "time": 2753.589, "timestamp": "00:45:53", "text": "或者向西？"}, {"type": "subtitle", "time": 2754.87, "timestamp": "00:45:54", "text": "呃，西边。是的。"}, {"type": "subtitle", "time": 2757.75, "timestamp": "00:45:57", "text": "是的。所以，这里有个地方。"}, {"type": "subtitle", "time": 2759.51, "timestamp": "00:45:59", "text": "在西部，那里就像……"}]
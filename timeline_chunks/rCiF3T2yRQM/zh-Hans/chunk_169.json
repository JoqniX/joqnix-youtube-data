[{"type": "subtitle", "time": 10142.71, "timestamp": "02:49:02", "text": "这件事现在并没有让我开心。"}, {"type": "subtitle", "time": 10146.55, "timestamp": "02:49:06", "text": "没关系。非常适合家庭使用。"}, {"type": "subtitle", "time": 10150.87, "timestamp": "02:49:10", "text": "我没问，但谢谢你。"}, {"type": "subtitle", "time": 10152.95, "timestamp": "02:49:12", "text": "好的。"}, {"type": "subtitle", "time": 10157.349, "timestamp": "02:49:17", "text": "顺便说一句，用刀刺地面并不会……"}, {"type": "subtitle", "time": 10159.91, "timestamp": "02:49:19", "text": "似乎做了很多事。它会做出反应，但是就像"}, {"type": "subtitle", "time": 10162.95, "timestamp": "02:49:22", "text": "就像这样，就像这样，就像这样"}, {"type": "subtitle", "time": 10165.19, "timestamp": "02:49:25", "text": "被蚂蚁咬了。"}, {"type": "subtitle", "time": 10166.8, "timestamp": "02:49:26", "text": "好的，"}, {"type": "subtitle", "time": 10168.07, "timestamp": "02:49:28", "text": "[音乐]"}, {"type": "subtitle", "time": 10169.67, "timestamp": "02:49:29", "text": "从内部。"}, {"type": "subtitle", "time": 10172.15, "timestamp": "02:49:32", "text": "我本来打算取消的"}, {"type": "subtitle", "time": 10173.51, "timestamp": "02:49:33", "text": "里面。"}, {"type": "subtitle", "time": 10175.99, "timestamp": "02:49:35", "text": "我当时在想，要不要试着占卜一下。"}, {"type": "subtitle", "time": 10177.59, "timestamp": "02:49:37", "text": "惩罚它，但这感觉并不强烈。"}, {"type": "subtitle", "time": 10179.59, "timestamp": "02:49:39", "text": "就像个好主意。"}, {"type": "subtitle", "time": 10180.309, "timestamp": "02:49:40", "text": "感觉很浪费。"}, {"type": "subtitle", "time": 10183.269, "timestamp": "02:49:43", "text": "当然可以试试。"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "你看到了什么，伙计？是什么？"}, {"type": "subtitle", "time": 10192.309, "timestamp": "02:49:52", "text": "很多黏液和很多粘液，还有"}, {"type": "subtitle", "time": 10198.389, "timestamp": "02:49:58", "text": "我有个问题。"}, {"type": "subtitle", "time": 10198.87, "timestamp": "02:49:58", "text": "嗯。"}]
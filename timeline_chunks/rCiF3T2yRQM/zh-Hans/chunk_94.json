[{"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "想看看会发生什么。"}, {"type": "subtitle", "time": 5644.87, "timestamp": "01:34:04", "text": "在派对上四处游荡。"}, {"type": "subtitle", "time": 5645.75, "timestamp": "01:34:05", "text": "是的。"}, {"type": "subtitle", "time": 5648.229, "timestamp": "01:34:08", "text": "好的。你滴了一滴"}, {"type": "subtitle", "time": 5651.27, "timestamp": "01:34:11", "text": "尸体上的液体。开头是这样的"}, {"type": "subtitle", "time": 5654.39, "timestamp": "01:34:14", "text": "溶解于尸体之中。"}, {"type": "subtitle", "time": 5656.39, "timestamp": "01:34:16", "text": "但我希望你负责调查。"}, {"type": "subtitle", "time": 5658.149, "timestamp": "01:34:18", "text": "这里或感知取决于哪个"}, {"type": "subtitle", "time": 5661.189, "timestamp": "01:34:21", "text": "一。我将展开调查。"}, {"type": "subtitle", "time": 5663.03, "timestamp": "01:34:23", "text": "嗯，我觉得能活下来也算不错了。"}, {"type": "subtitle", "time": 5664.55, "timestamp": "01:34:24", "text": "取决于哪个最高。"}, {"type": "subtitle", "time": 5666.79, "timestamp": "01:34:26", "text": "此外，还要进行调查。我的生存是"}, {"type": "subtitle", "time": 5667.91, "timestamp": "01:34:27", "text": "减一。"}, {"type": "subtitle", "time": 5669.11, "timestamp": "01:34:29", "text": "我的天啊。"}, {"type": "subtitle", "time": 5671.27, "timestamp": "01:34:31", "text": "还有，韩韩，嗯"}, {"type": "subtitle", "time": 5674.79, "timestamp": "01:34:34", "text": "我可以拿出我的一个吗？"}, {"type": "subtitle", "time": 5677.99, "timestamp": "01:34:37", "text": "葡萄酒瓶？像液体一样取出"}, {"type": "subtitle", "time": 5681.189, "timestamp": "01:34:41", "text": "把它装满，这瓶无瓶葡萄酒"}, {"type": "subtitle", "time": 5683.11, "timestamp": "01:34:43", "text": "一瓶黑水。"}, {"type": "subtitle", "time": 5685.27, "timestamp": "01:34:45", "text": "是的。请随意。"}, {"type": "subtitle", "time": 5690.31, "timestamp": "01:34:50", "text": "请随意。好的。好的。你哦，"}, {"type": "subtitle", "time": 5692.31, "timestamp": "01:34:52", "text": "是的。对于爱莉安娜来说，你会注意到"}, {"type": "subtitle", "time": 5694.709, "timestamp": "01:34:54", "text": "当你滴落液体时，"}, {"type": "subtitle", "time": 5698.07, "timestamp": "01:34:58", "text": "它进入了那个什么玩意儿"}]
[{"type": "subtitle", "time": 3900.23, "timestamp": "01:05:00", "text": "里面是空的，箱子那种"}, {"type": "subtitle", "time": 3903.19, "timestamp": "01:05:03", "text": "倾倒，然后这就是"}, {"type": "subtitle", "time": 3905.51, "timestamp": "01:05:05", "text": "后面的墙壁有些褶皱，可以打开。"}, {"type": "subtitle", "time": 3907.589, "timestamp": "01:05:07", "text": "轻微地。"}, {"type": "subtitle", "time": 3908.63, "timestamp": "01:05:08", "text": "糟糕。"}, {"type": "subtitle", "time": 3909.75, "timestamp": "01:05:09", "text": "哦"}, {"type": "subtitle", "time": 3914.47, "timestamp": "01:05:14", "text": "轻微地。里面有东西。"}, {"type": "subtitle", "time": 3917.91, "timestamp": "01:05:17", "text": "我不太信任这种油漆。它是"}, {"type": "subtitle", "time": 3924.39, "timestamp": "01:05:24", "text": "看看里面到底是什么鬼东西。"}, {"type": "subtitle", "time": 3927.75, "timestamp": "01:05:27", "text": "好的。所以，呃，你做什么？呃，你做什么？"}, {"type": "subtitle", "time": 3929.589, "timestamp": "01:05:29", "text": "想试着推动这个东西，或者"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "什么东西，还是箱子？"}, {"type": "subtitle", "time": 3933.67, "timestamp": "01:05:33", "text": "是的。是的。嗯，推这玩意儿"}, {"type": "subtitle", "time": 3935.349, "timestamp": "01:05:35", "text": "因为呃，我们确实看到了那堵墙。"}, {"type": "subtitle", "time": 3937.109, "timestamp": "01:05:37", "text": "哦，是的。胸部。箱子是空的。"}, {"type": "subtitle", "time": 3940.23, "timestamp": "01:05:40", "text": "但墙被推后了一些。呃"}, {"type": "subtitle", "time": 3943.67, "timestamp": "01:05:43", "text": "当克里斯彭推它的时候，它就揭示了……"}, {"type": "subtitle", "time": 3946.47, "timestamp": "01:05:46", "text": "它进入了一个类似另一个地方。"}, {"type": "subtitle", "time": 3948.47, "timestamp": "01:05:48", "text": "嗯，"}, {"type": "subtitle", "time": 3951.829, "timestamp": "01:05:51", "text": "伙计们，我觉得房间后面还有个房间。"}, {"type": "subtitle", "time": 3953.349, "timestamp": "01:05:53", "text": "他们谈论的那个胸室"}, {"type": "subtitle", "time": 3958.95, "timestamp": "01:05:58", "text": "妈的。"}]
[{"type": "subtitle", "time": 6181.669, "timestamp": "01:43:01", "text": "以前确实如此。"}, {"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "当然。是的。我想我还需要"}, {"type": "subtitle", "time": 6186.31, "timestamp": "01:43:06", "text": "另外还要提到，还有更多黑色"}, {"type": "subtitle", "time": 6188.709, "timestamp": "01:43:08", "text": "这里现在也有液体了。他们正在获得"}, {"type": "subtitle", "time": 6190.47, "timestamp": "01:43:10", "text": "越来越满。"}, {"type": "subtitle", "time": 6191.75, "timestamp": "01:43:11", "text": "好的，你想扔下一个"}, {"type": "subtitle", "time": 6192.39, "timestamp": "01:43:12", "text": "一？"}, {"type": "subtitle", "time": 6195.43, "timestamp": "01:43:15", "text": "一点也不奇怪。"}, {"type": "subtitle", "time": 6197.59, "timestamp": "01:43:17", "text": "我当时想，等等，我们是不是应该……"}, {"type": "subtitle", "time": 6198.87, "timestamp": "01:43:18", "text": "还在做这件事吗？等等，还有"}, {"type": "subtitle", "time": 6202.229, "timestamp": "01:43:22", "text": "有很多事情正在积压，而我"}, {"type": "subtitle", "time": 6204.629, "timestamp": "01:43:24", "text": "当我把那具尸体扔进去的时候，它几乎"}, {"type": "subtitle", "time": 6208.149, "timestamp": "01:43:28", "text": "伸手去抓尸体。我不"}, {"type": "subtitle", "time": 6211.189, "timestamp": "01:43:31", "text": "我觉得它可能还活着。"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "喂它。"}, {"type": "subtitle", "time": 6215.109, "timestamp": "01:43:35", "text": "如果我们喂饱它，它就会喜欢我们。我"}, {"type": "subtitle", "time": 6217.91, "timestamp": "01:43:37", "text": "别以为大多数事情都是那样。"}, {"type": "subtitle", "time": 6221.35, "timestamp": "01:43:41", "text": "试图吃掉相似的生物。但"}, {"type": "subtitle", "time": 6223.75, "timestamp": "01:43:43", "text": "蜱虫是如何工作的，以及蜱虫是如何吃微型昆虫的。"}, {"type": "subtitle", "time": 6231.03, "timestamp": "01:43:51", "text": "或许目前是这样。"}, {"type": "subtitle", "time": 6235.35, "timestamp": "01:43:55", "text": "我们再来看看狼是如何生存的。"}, {"type": "subtitle", "time": 6237.43, "timestamp": "01:43:57", "text": "狼。"}, {"type": "subtitle", "time": 6239.51, "timestamp": "01:43:59", "text": "许多以其他生物为食的生物"}]
[{"type": "subtitle", "time": 6243.03, "timestamp": "01:44:03", "text": "人们常常通过食物与动物建立友谊。"}, {"type": "subtitle", "time": 6245.27, "timestamp": "01:44:05", "text": "好的。 Lotus 将会关注 Van 和"}, {"type": "subtitle", "time": 6247.669, "timestamp": "01:44:07", "text": "比如说，“也许我们应该选择蓝色。”"}, {"type": "subtitle", "time": 6251.03, "timestamp": "01:44:11", "text": "目前是液体。这可能很危险。"}, {"type": "subtitle", "time": 6252.07, "timestamp": "01:44:12", "text": "对我们来说。"}, {"type": "subtitle", "time": 6254.149, "timestamp": "01:44:14", "text": "有足够的蓝色液体可以倒入……"}, {"type": "subtitle", "time": 6255.59, "timestamp": "01:44:15", "text": "他妈的瓶子？"}, {"type": "subtitle", "time": 6257.669, "timestamp": "01:44:17", "text": "一瓶。"}, {"type": "subtitle", "time": 6258.709, "timestamp": "01:44:18", "text": "一剂。"}, {"type": "subtitle", "time": 6260.709, "timestamp": "01:44:20", "text": "你知道吗？我会把它放进去"}, {"type": "subtitle", "time": 6266.229, "timestamp": "01:44:26", "text": "[音乐]"}, {"type": "subtitle", "time": 6267.669, "timestamp": "01:44:27", "text": "一剂。"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "看看我是否在玩其中一个"}, {"type": "subtitle", "time": 6280.47, "timestamp": "01:44:40", "text": "我当时在想的其他角色"}, {"type": "subtitle", "time": 6282.149, "timestamp": "01:44:42", "text": "参与其中就像一场瘟疫"}, {"type": "subtitle", "time": 6283.99, "timestamp": "01:44:43", "text": "医生，他们想创造他们的"}, {"type": "subtitle", "time": 6286.709, "timestamp": "01:44:46", "text": "自有生物武器。所以我不是"}, {"type": "subtitle", "time": 6287.83, "timestamp": "01:44:47", "text": "玩那首歌。"}, {"type": "subtitle", "time": 6291.189, "timestamp": "01:44:51", "text": "当然。"}, {"type": "subtitle", "time": 6292.31, "timestamp": "01:44:52", "text": "我抓住了"}, {"type": "subtitle", "time": 6294.55, "timestamp": "01:44:54", "text": "我这小瓶里还有一点。"}, {"type": "subtitle", "time": 6297.03, "timestamp": "01:44:57", "text": "这里。"}, {"type": "subtitle", "time": 6299.35, "timestamp": "01:44:59", "text": "带一些回家。你可以培养你的"}]
[{"type": "subtitle", "time": 6300.629, "timestamp": "01:45:00", "text": "自己的。"}, {"type": "subtitle", "time": 6303.03, "timestamp": "01:45:03", "text": "我的天哪。我们可以……呃，我可以试着……"}, {"type": "subtitle", "time": 6305.03, "timestamp": "01:45:05", "text": "就像只是看看如果……会怎样一样。"}, {"type": "subtitle", "time": 6306.629, "timestamp": "01:45:06", "text": "房间里还有其他东西吗？"}, {"type": "subtitle", "time": 6309.75, "timestamp": "01:45:09", "text": "好的，请随意。"}, {"type": "subtitle", "time": 6311.43, "timestamp": "01:45:11", "text": "我们只是在瞎搞而已。"}, {"type": "subtitle", "time": 6314.47, "timestamp": "01:45:14", "text": "我们不了解的物质。"}, {"type": "subtitle", "time": 6315.03, "timestamp": "01:45:15", "text": "可口的。"}, {"type": "subtitle", "time": 6317.59, "timestamp": "01:45:17", "text": "这就是正在发生的事情。"}, {"type": "subtitle", "time": 6318.79, "timestamp": "01:45:18", "text": "听，"}, {"type": "subtitle", "time": 6321.99, "timestamp": "01:45:21", "text": "范玩得很开心。他"}, {"type": "subtitle", "time": 6325.669, "timestamp": "01:45:25", "text": "现在有人想让他做什么了？"}, {"type": "subtitle", "time": 6327.669, "timestamp": "01:45:27", "text": "诸如此类的事情"}, {"type": "subtitle", "time": 6329.99, "timestamp": "01:45:29", "text": "他并不太在意这一点。阿布"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "蒂克心想，如果我们拿走黑色呢？"}, {"type": "subtitle", "time": 6338.55, "timestamp": "01:45:38", "text": "我们把液体倒在了糊状物上。"}, {"type": "subtitle", "time": 6344.31, "timestamp": "01:45:44", "text": "看看发生了什么"}, {"type": "subtitle", "time": 6346.87, "timestamp": "01:45:46", "text": "好的，好的"}, {"type": "subtitle", "time": 6348.95, "timestamp": "01:45:48", "text": "像"}, {"type": "subtitle", "time": 6351.27, "timestamp": "01:45:51", "text": "好主意勾选"}, {"type": "subtitle", "time": 6353.43, "timestamp": "01:45:53", "text": "好的"}, {"type": "subtitle", "time": 6356.55, "timestamp": "01:45:56", "text": "哦，抱歉，V 不太常见到 V。"}, {"type": "subtitle", "time": 6358.629, "timestamp": "01:45:58", "text": "似乎没怎么看到类似“不”的情况。"}]
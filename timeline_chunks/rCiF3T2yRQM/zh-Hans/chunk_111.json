[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "如果它像雕像一样的话。"}, {"type": "subtitle", "time": 6661.51, "timestamp": "01:51:01", "text": "那就像液体一样"}, {"type": "subtitle", "time": 6663.35, "timestamp": "01:51:03", "text": "雕像之类的东西。"}, {"type": "subtitle", "time": 6665.669, "timestamp": "01:51:05", "text": "雕像就像石头一样，"}, {"type": "subtitle", "time": 6667.27, "timestamp": "01:51:07", "text": "然后变得肉质。"}, {"type": "subtitle", "time": 6669.59, "timestamp": "01:51:09", "text": "是的。"}, {"type": "subtitle", "time": 6672.229, "timestamp": "01:51:12", "text": "就像他们中的一些人是因为……"}, {"type": "subtitle", "time": 6674.39, "timestamp": "01:51:14", "text": "最后，另一队也去了这里。"}, {"type": "subtitle", "time": 6676.149, "timestamp": "01:51:16", "text": "而且也喜欢攻击一些"}, {"type": "subtitle", "time": 6678.07, "timestamp": "01:51:18", "text": "雕像，以及它们在遭受攻击时"}, {"type": "subtitle", "time": 6680.149, "timestamp": "01:51:20", "text": "会出血。"}, {"type": "subtitle", "time": 6685.75, "timestamp": "01:51:25", "text": "我好像喜欢尝试新事物。我只是"}, {"type": "subtitle", "time": 6687.109, "timestamp": "01:51:27", "text": "她又要掉链子了"}, {"type": "subtitle", "time": 6690.47, "timestamp": "01:51:30", "text": "往破碎的雕像上滴一滴水。"}, {"type": "subtitle", "time": 6692.629, "timestamp": "01:51:32", "text": "好的。好的。嗯，是的。等等，什么？"}, {"type": "subtitle", "time": 6693.99, "timestamp": "01:51:33", "text": "P 又做了什么来着？"}, {"type": "subtitle", "time": 6696.629, "timestamp": "01:51:36", "text": "猪只是在咬拐角而已。"}, {"type": "subtitle", "time": 6697.189, "timestamp": "01:51:37", "text": "哦，"}, {"type": "subtitle", "time": 6700.149, "timestamp": "01:51:40", "text": "是的，非常相似。"}, {"type": "subtitle", "time": 6701.51, "timestamp": "01:51:41", "text": "好的，这边。嗯，"}, {"type": "subtitle", "time": 6705.589, "timestamp": "01:51:45", "text": "这是玛尔塔的团队成员。"}, {"type": "subtitle", "time": 6707.83, "timestamp": "01:51:47", "text": "小组中最聪明的成员。"}, {"type": "subtitle", "time": 6710.95, "timestamp": "01:51:50", "text": "类似的事情也会发生，你知道的。"}, {"type": "subtitle", "time": 6712.95, "timestamp": "01:51:52", "text": "形成了一些细小的蓝色液体滴。"}, {"type": "subtitle", "time": 6716.39, "timestamp": "01:51:56", "text": "有些黑色液体有点像"}, {"type": "subtitle", "time": 6719.83, "timestamp": "01:51:59", "text": "嗯，好像变大了一点。我想你可以这么说"}]
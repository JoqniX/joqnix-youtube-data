[{"type": "subtitle", "time": 1020.31, "timestamp": "00:17:00", "text": "猫。嗯，一朵会说话的花，现在又是一个"}, {"type": "subtitle", "time": 1028.63, "timestamp": "00:17:08", "text": "选择。"}, {"type": "subtitle", "time": 1031.909, "timestamp": "00:17:11", "text": "这是个不错的选择。非常好。"}, {"type": "subtitle", "time": 1039.75, "timestamp": "00:17:19", "text": "迪克也加入了欢呼的行列。"}, {"type": "subtitle", "time": 1042.23, "timestamp": "00:17:22", "text": "耶。"}, {"type": "subtitle", "time": 1044.47, "timestamp": "00:17:24", "text": "我们已收购。"}, {"type": "subtitle", "time": 1046.63, "timestamp": "00:17:26", "text": "你长了个阴茎。我有"}, {"type": "subtitle", "time": 1053.19, "timestamp": "00:17:33", "text": "好的。"}, {"type": "subtitle", "time": 1053.669, "timestamp": "00:17:33", "text": "出色地，"}, {"type": "subtitle", "time": 1055.029, "timestamp": "00:17:35", "text": "好的。好的。"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "那么，我们应该去追赶吗？"}, {"type": "subtitle", "time": 1058.789, "timestamp": "00:17:38", "text": "跟对方队伍比起来怎么样了？看看他们怎么样"}, {"type": "subtitle", "time": 1059.43, "timestamp": "00:17:39", "text": "正在做。"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "哦，我差点忘了他们。"}, {"type": "subtitle", "time": 1064.71, "timestamp": "00:17:44", "text": "你说你说过他们说"}, {"type": "subtitle", "time": 1066.31, "timestamp": "00:17:46", "text": "他们的情况不太好，而且"}, {"type": "subtitle", "time": 1069.029, "timestamp": "00:17:49", "text": "他们骚扰了老太太们。"}, {"type": "subtitle", "time": 1071.43, "timestamp": "00:17:51", "text": "他们确实骚扰了那些老太太。"}, {"type": "subtitle", "time": 1073.27, "timestamp": "00:17:53", "text": "不知怎么的。他们设法脱身了。"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "毫发无损，"}, {"type": "subtitle", "time": 1077.35, "timestamp": "00:17:57", "text": "但是，嗯，我真的没法完全理解他们的意思。"}, {"type": "subtitle", "time": 1079.99, "timestamp": "00:17:59", "text": "下一层。你知道，那个"}]
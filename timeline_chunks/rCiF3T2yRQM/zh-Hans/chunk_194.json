[{"type": "subtitle", "time": 11641.51, "timestamp": "03:14:01", "text": "简直比我强多了。"}, {"type": "subtitle", "time": 11644.389, "timestamp": "03:14:04", "text": "这的确是事实。"}, {"type": "subtitle", "time": 11646.95, "timestamp": "03:14:06", "text": "克里斯彭就是更胜一筹。他是"}, {"type": "subtitle", "time": 11650.07, "timestamp": "03:14:10", "text": "唯一的角色。他就是那个"}, {"type": "subtitle", "time": 11653.19, "timestamp": "03:14:13", "text": "其实他喜欢打架，但SM不喜欢。"}, {"type": "subtitle", "time": 11656.55, "timestamp": "03:14:16", "text": "真的要打很多仗。我想我会"}, {"type": "subtitle", "time": 11658.15, "timestamp": "03:14:18", "text": "我的回合到此结束。"}, {"type": "subtitle", "time": 11663.269, "timestamp": "03:14:23", "text": "好的。然后，Ariana，你就被拉走了。"}, {"type": "subtitle", "time": 11665.03, "timestamp": "03:14:25", "text": "好的。我不会。"}, {"type": "subtitle", "time": 11667.03, "timestamp": "03:14:27", "text": "你得到“好的”。你没有。你被拉了"}, {"type": "subtitle", "time": 11668.229, "timestamp": "03:14:28", "text": "这边。"}, {"type": "subtitle", "time": 11669.99, "timestamp": "03:14:29", "text": "好的。我想我大概会……"}, {"type": "subtitle", "time": 11672.07, "timestamp": "03:14:32", "text": "走上去。"}, {"type": "subtitle", "time": 11673.59, "timestamp": "03:14:33", "text": "呃"}, {"type": "subtitle", "time": 11677.03, "timestamp": "03:14:37", "text": "亲切、亲密。嗯，我是……"}, {"type": "subtitle", "time": 11679.99, "timestamp": "03:14:39", "text": "近战型角色，所以"}, {"type": "subtitle", "time": 11687.349, "timestamp": "03:14:47", "text": "我近战的时候。没关系。正如我所说，"}, {"type": "subtitle", "time": 11689.83, "timestamp": "03:14:49", "text": "如果你需要打克里斯汀，你"}, {"type": "subtitle", "time": 11693.75, "timestamp": "03:14:53", "text": "也可以。克里斯汀已经完成了他的工作。"}, {"type": "subtitle", "time": 11695.269, "timestamp": "03:14:55", "text": "好吧，我就……我就这么做吧"}, {"type": "subtitle", "time": 11699.269, "timestamp": "03:14:59", "text": "呼吸攻击。嗯，好的。"}]
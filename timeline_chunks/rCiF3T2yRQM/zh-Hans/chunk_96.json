[{"type": "subtitle", "time": 5761.99, "timestamp": "01:36:01", "text": "除了黑色的那一个，其他都不确定了。"}, {"type": "subtitle", "time": 5771.83, "timestamp": "01:36:11", "text": "那可真不少。这很有帮助。"}, {"type": "subtitle", "time": 5774.55, "timestamp": "01:36:14", "text": "嗯，我还有另一瓶该死的"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "它叫什么名字？又一个该死的常见现象"}, {"type": "subtitle", "time": 5779.189, "timestamp": "01:36:19", "text": "葡萄酒瓶。我可以试试吗？"}, {"type": "subtitle", "time": 5781.03, "timestamp": "01:36:21", "text": "收集蓝色的那个？"}, {"type": "subtitle", "time": 5783.43, "timestamp": "01:36:23", "text": "呃，太少了。只有几个"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "滴。"}, {"type": "subtitle", "time": 5785.99, "timestamp": "01:36:25", "text": "太少了。好的。"}, {"type": "subtitle", "time": 5787.669, "timestamp": "01:36:27", "text": "那很可能是一个"}, {"type": "subtitle", "time": 5790.79, "timestamp": "01:36:30", "text": "我只是掉了一块石头。"}, {"type": "subtitle", "time": 5791.83, "timestamp": "01:36:31", "text": "有趣的。"}, {"type": "subtitle", "time": 5793.75, "timestamp": "01:36:33", "text": "提出建议。"}, {"type": "subtitle", "time": 5795.03, "timestamp": "01:36:35", "text": "你有什么建议？"}, {"type": "subtitle", "time": 5796.709, "timestamp": "01:36:36", "text": "如果我们把尸体捡起来扔掉呢？"}, {"type": "subtitle", "time": 5799.11, "timestamp": "01:36:39", "text": "把它扔进去？"}, {"type": "subtitle", "time": 5801.27, "timestamp": "01:36:41", "text": "嗯，你知道吗？"}, {"type": "subtitle", "time": 5804.79, "timestamp": "01:36:44", "text": "那真是个糟糕的主意。"}, {"type": "subtitle", "time": 5807.83, "timestamp": "01:36:47", "text": "我们可以试试。"}, {"type": "subtitle", "time": 5811.03, "timestamp": "01:36:51", "text": "正如他们所说，你当然可以试试。"}, {"type": "subtitle", "time": 5813.669, "timestamp": "01:36:53", "text": "然后，邪教开始活跃起来。"}, {"type": "subtitle", "time": 5815.8, "timestamp": "01:36:55", "text": "作为一名黑人大师。"}]
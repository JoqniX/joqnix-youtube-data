[{"type": "subtitle", "time": 1740.07, "timestamp": "00:29:00", "text": "黏糊糊的石头。"}, {"type": "subtitle", "time": 1740.789, "timestamp": "00:29:00", "text": "我的天啊。"}, {"type": "subtitle", "time": 1742.63, "timestamp": "00:29:02", "text": "爱莉安娜会说，不不不"}, {"type": "subtitle", "time": 1744.07, "timestamp": "00:29:04", "text": "拒绝善意的举动。她是"}, {"type": "subtitle", "time": 1745.19, "timestamp": "00:29:05", "text": "就拿过来，然后说：“谢谢。”"}, {"type": "subtitle", "time": 1747.19, "timestamp": "00:29:07", "text": "你。”"}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "你为什么喜欢拉响警报然后逃跑"}, {"type": "subtitle", "time": 1752.549, "timestamp": "00:29:12", "text": "绕着一个小圈转？"}, {"type": "subtitle", "time": 1754.149, "timestamp": "00:29:14", "text": "呃，"}, {"type": "subtitle", "time": 1756.549, "timestamp": "00:29:16", "text": "你为什么会接受这种该死的玩意儿？"}, {"type": "subtitle", "time": 1759.909, "timestamp": "00:29:19", "text": "唾液充满了生的？"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "我本来打算把夜晚变成……"}, {"type": "subtitle", "time": 1764.31, "timestamp": "00:29:24", "text": "走到面包车旁，然后说：“等等，我"}, {"type": "subtitle", "time": 1766.23, "timestamp": "00:29:26", "text": "无法拒绝如此优厚的条件"}, {"type": "subtitle", "time": 1773.029, "timestamp": "00:29:33", "text": "所以如果他让你吃那个"}, {"type": "subtitle", "time": 1775.59, "timestamp": "00:29:35", "text": "现在就摇滚，你肯定能做到。"}, {"type": "subtitle", "time": 1778.549, "timestamp": "00:29:38", "text": "或许不该吃，因为人类不吃。"}, {"type": "subtitle", "time": 1780.31, "timestamp": "00:29:40", "text": "吃石头。"}, {"type": "subtitle", "time": 1783.669, "timestamp": "00:29:43", "text": "不，其他人无法消化石头，但是……"}, {"type": "subtitle", "time": 1786.23, "timestamp": "00:29:46", "text": "它们是很好的礼物选择。"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "我希望如此。"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "如同神明一般，我将"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "让你吃下一根鱼竿并消化它"}, {"type": "subtitle", "time": 1799.83, "timestamp": "00:29:59", "text": "哦亲爱的。"}]
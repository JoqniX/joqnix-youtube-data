[{"type": "subtitle", "time": 3421.43, "timestamp": "00:57:01", "text": "其他人之前已经提到过了。"}, {"type": "subtitle", "time": 3423.109, "timestamp": "00:57:03", "text": "艾瑞安大概会说：“好吧，我"}, {"type": "subtitle", "time": 3425.75, "timestamp": "00:57:05", "text": "我觉得这应该是食物吧，伙计们。我不"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "我觉得这其中蕴含着很多东西。"}, {"type": "subtitle", "time": 3428.95, "timestamp": "00:57:08", "text": "那。”"}, {"type": "subtitle", "time": 3431.91, "timestamp": "00:57:11", "text": "嗯，看起来像是食物，但我不是。"}, {"type": "subtitle", "time": 3434.71, "timestamp": "00:57:14", "text": "真的相信你在街上找到的食物吗？"}, {"type": "subtitle", "time": 3437.51, "timestamp": "00:57:17", "text": "地牢中随机出现的一张长桌"}, {"type": "subtitle", "time": 3440.069, "timestamp": "00:57:20", "text": "上面有老巫婆的图案。"}, {"type": "subtitle", "time": 3442.95, "timestamp": "00:57:22", "text": "我们可以带走一些。"}, {"type": "subtitle", "time": 3445.349, "timestamp": "00:57:25", "text": "我想我们可以拿一些。"}, {"type": "subtitle", "time": 3449.19, "timestamp": "00:57:29", "text": "如果那是诅咒呢？或者如果"}, {"type": "subtitle", "time": 3451.349, "timestamp": "00:57:31", "text": "这会给你带来不祥之兆吗？"}, {"type": "subtitle", "time": 3451.99, "timestamp": "00:57:31", "text": "谁知道呢？"}, {"type": "subtitle", "time": 3455.109, "timestamp": "00:57:35", "text": "嗯，除非我们……，否则我们永远不会知道。"}, {"type": "subtitle", "time": 3456.87, "timestamp": "00:57:36", "text": "尝试。哈哈。"}, {"type": "subtitle", "time": 3458.39, "timestamp": "00:57:38", "text": "只有一种方法可以找到答案。"}, {"type": "subtitle", "time": 3459.99, "timestamp": "00:57:39", "text": "拿起一些食物，把它放进……"}, {"type": "subtitle", "time": 3461.19, "timestamp": "00:57:41", "text": "她的百宝袋。"}, {"type": "subtitle", "time": 3464.39, "timestamp": "00:57:44", "text": "好的。好的。呃，可疑的"}, {"type": "subtitle", "time": 3466.23, "timestamp": "00:57:46", "text": "地牢食物。就叫它那个名字吧。"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "我也要一些。"}, {"type": "subtitle", "time": 3472.789, "timestamp": "00:57:52", "text": "好的。是的。请随意采纳"}, {"type": "subtitle", "time": 3474.63, "timestamp": "00:57:54", "text": "你想买多少都行。"}, {"type": "subtitle", "time": 3477.19, "timestamp": "00:57:57", "text": "我要三块。我会说一个"}, {"type": "subtitle", "time": 3479.27, "timestamp": "00:57:59", "text": "其中只有一磅重。"}]
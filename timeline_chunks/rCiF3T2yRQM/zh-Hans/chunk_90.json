[{"type": "subtitle", "time": 5400.87, "timestamp": "01:30:00", "text": "焕然一新。"}, {"type": "subtitle", "time": 5403.03, "timestamp": "01:30:03", "text": "奇怪的是，你获得了五个临时奖励。"}, {"type": "subtitle", "time": 5404.709, "timestamp": "01:30:04", "text": "惠普。"}, {"type": "subtitle", "time": 5407.43, "timestamp": "01:30:07", "text": "哦。仍然感到窒息，因为那仍然是一个"}, {"type": "subtitle", "time": 5410.87, "timestamp": "01:30:10", "text": "大量水流入一个"}, {"type": "subtitle", "time": 5412.87, "timestamp": "01:30:12", "text": "的"}, {"type": "subtitle", "time": 5414.629, "timestamp": "01:30:14", "text": "Tick，你感觉怎么样？"}, {"type": "subtitle", "time": 5415.189, "timestamp": "01:30:15", "text": "是的，"}, {"type": "subtitle", "time": 5417.83, "timestamp": "01:30:17", "text": "它感觉鲜活。"}, {"type": "subtitle", "time": 5418.31, "timestamp": "01:30:18", "text": "你感觉自己充满活力"}, {"type": "subtitle", "time": 5419.83, "timestamp": "01:30:19", "text": "一旦完成。一旦完成，"}, {"type": "subtitle", "time": 5422.07, "timestamp": "01:30:22", "text": "那些蓝色的东西都没了。"}, {"type": "subtitle", "time": 5423.75, "timestamp": "01:30:23", "text": "在呃……下面"}, {"type": "subtitle", "time": 5425.11, "timestamp": "01:30:25", "text": "黑色下面的蓝色液体"}, {"type": "subtitle", "time": 5426.95, "timestamp": "01:30:26", "text": "冒泡的东西。"}, {"type": "subtitle", "time": 5428.95, "timestamp": "01:30:28", "text": "所以，首先出现的是……"}, {"type": "subtitle", "time": 5430.31, "timestamp": "01:30:30", "text": "蓝色的。"}, {"type": "subtitle", "time": 5433.51, "timestamp": "01:30:33", "text": "黑色的会是什么味道？"}, {"type": "subtitle", "time": 5435.99, "timestamp": "01:30:35", "text": "我，我的物品栏里有一个小瓶。"}, {"type": "subtitle", "time": 5437.75, "timestamp": "01:30:37", "text": "我可以往小瓶里装一些吗？"}, {"type": "subtitle", "time": 5439.03, "timestamp": "01:30:39", "text": "黑色液体？"}, {"type": "subtitle", "time": 5441.51, "timestamp": "01:30:41", "text": "是的，可以。"}, {"type": "subtitle", "time": 5444.31, "timestamp": "01:30:44", "text": "当然。我们走吧。"}, {"type": "subtitle", "time": 5447.03, "timestamp": "01:30:47", "text": "好的。好的。我得到了一小瓶黑色的"}, {"type": "subtitle", "time": 5448.229, "timestamp": "01:30:48", "text": "液体。"}, {"type": "subtitle", "time": 5451.43, "timestamp": "01:30:51", "text": "好的。你得到了一小瓶黑色液体。"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "它冒泡了，而且几乎"}, {"type": "subtitle", "time": 5457.11, "timestamp": "01:30:57", "text": "就像它想挣脱束缚一样。它是"}]
[{"type": "subtitle", "time": 662.069, "timestamp": "00:11:02", "text": "你好。"}, {"type": "subtitle", "time": 665.03, "timestamp": "00:11:05", "text": "我大概会说，你好。在哪里"}, {"type": "subtitle", "time": 667.59, "timestamp": "00:11:07", "text": "小家伙，你从哪里来？"}, {"type": "subtitle", "time": 670.55, "timestamp": "00:11:10", "text": "我是妹子。你好吗？"}, {"type": "subtitle", "time": 673.11, "timestamp": "00:11:13", "text": "哦，不。这是南方人。"}, {"type": "subtitle", "time": 680.63, "timestamp": "00:11:20", "text": "事实上，这甚至都不算错。"}, {"type": "subtitle", "time": 691.269, "timestamp": "00:11:31", "text": "我的天啊。我不说话。"}, {"type": "subtitle", "time": 692.79, "timestamp": "00:11:32", "text": "太搞笑了。"}, {"type": "subtitle", "time": 694.949, "timestamp": "00:11:34", "text": "他会过来抓住莲花，然后说："}, {"type": "subtitle", "time": 696.87, "timestamp": "00:11:36", "text": "“这位是我的师父，莲花师父。”"}, {"type": "subtitle", "time": 698.87, "timestamp": "00:11:38", "text": "这是我的朋友埃斯特万，还有这个"}, {"type": "subtitle", "time": 700.15, "timestamp": "00:11:40", "text": "是 Jock。"}, {"type": "subtitle", "time": 700.71, "timestamp": "00:11:40", "text": "你好。"}, {"type": "subtitle", "time": 709.19, "timestamp": "00:11:49", "text": "Van Van 就像滴答作响，然后就"}, {"type": "subtitle", "time": 711.829, "timestamp": "00:11:51", "text": "你知道吗，我来这里是为了……"}, {"type": "subtitle", "time": 719.67, "timestamp": "00:11:59", "text": "滴答，桌子不见了，然后滴答，花朵绽放了，呃"}]
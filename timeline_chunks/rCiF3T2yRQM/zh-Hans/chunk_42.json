[{"type": "subtitle", "time": 2522.23, "timestamp": "00:42:02", "text": "照着老人的信去做，"}, {"type": "subtitle", "time": 2525.67, "timestamp": "00:42:05", "text": "那太好了。嗯，进来吧"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "循着香水味而去。"}, {"type": "subtitle", "time": 2530.79, "timestamp": "00:42:10", "text": "嗯，他确实这么做了，没错。"}, {"type": "subtitle", "time": 2533.03, "timestamp": "00:42:13", "text": "而我，Ariana，马上就要来了"}, {"type": "subtitle", "time": 2534.87, "timestamp": "00:42:14", "text": "直接进去。"}, {"type": "subtitle", "time": 2539.109, "timestamp": "00:42:19", "text": "注意大家都在休息。"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "小心那个新朋友。"}, {"type": "subtitle", "time": 2544.55, "timestamp": "00:42:24", "text": "小心帐篷上的那个"}, {"type": "subtitle", "time": 2546.63, "timestamp": "00:42:26", "text": "那里。"}, {"type": "subtitle", "time": 2548.47, "timestamp": "00:42:28", "text": "杰克把人关进了帐篷。"}, {"type": "subtitle", "time": 2552.23, "timestamp": "00:42:32", "text": "别想太多，如果你看到……"}, {"type": "subtitle", "time": 2556.069, "timestamp": "00:42:36", "text": "他遇到了麻烦。没问题。"}, {"type": "subtitle", "time": 2557.76, "timestamp": "00:42:37", "text": "没问题。 没问题。"}, {"type": "subtitle", "time": 2564.47, "timestamp": "00:42:44", "text": "其他人都睡了吗？"}, {"type": "subtitle", "time": 2566.39, "timestamp": "00:42:46", "text": "大家都睡着了。"}, {"type": "subtitle", "time": 2569.91, "timestamp": "00:42:49", "text": "拥有"}, {"type": "subtitle", "time": 2572.309, "timestamp": "00:42:52", "text": "那边有问题。不，他不是。"}, {"type": "subtitle", "time": 2578.63, "timestamp": "00:42:58", "text": "想象一下，就像蜱虫叮咬其中一个……"}]
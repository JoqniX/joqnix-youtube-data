[{"type": "subtitle", "time": 961.11, "timestamp": "00:16:01", "text": "你想来吗？你想来吗？"}, {"type": "subtitle", "time": 964.71, "timestamp": "00:16:04", "text": "那你和我们在一起吗？打钩。"}, {"type": "subtitle", "time": 967.03, "timestamp": "00:16:07", "text": "是的。"}, {"type": "subtitle", "time": 969.67, "timestamp": "00:16:09", "text": "耶！"}, {"type": "subtitle", "time": 971.67, "timestamp": "00:16:11", "text": "我猜我只是想象出了循环错误。"}, {"type": "subtitle", "time": 974.71, "timestamp": "00:16:14", "text": "耶！"}, {"type": "subtitle", "time": 977.509, "timestamp": "00:16:17", "text": "是的。你是"}, {"type": "subtitle", "time": 980.949, "timestamp": "00:16:20", "text": "你是德克萨斯州的一部分"}, {"type": "subtitle", "time": 985.509, "timestamp": "00:16:25", "text": "间谍海伦，间谍海尔登，现在也一样了。"}, {"type": "subtitle", "time": 987.749, "timestamp": "00:16:27", "text": "跟之前的那些一样。"}, {"type": "subtitle", "time": 989.43, "timestamp": "00:16:29", "text": "最后一个。"}, {"type": "subtitle", "time": 991.99, "timestamp": "00:16:31", "text": "听起来很可疑。什么"}, {"type": "subtitle", "time": 992.23, "timestamp": "00:16:32", "text": "发生"}, {"type": "subtitle", "time": 993.829, "timestamp": "00:16:33", "text": "直到最后？"}, {"type": "subtitle", "time": 996.87, "timestamp": "00:16:36", "text": "最后一个怎么样了？打钩。"}, {"type": "subtitle", "time": 999.43, "timestamp": "00:16:39", "text": "蜱虫迷路了。"}, {"type": "subtitle", "time": 1002.87, "timestamp": "00:16:42", "text": "你迷路了，发现自己身处一个……"}, {"type": "subtitle", "time": 1005.11, "timestamp": "00:16:45", "text": "然后就决定在山洞里睡觉。"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "哦，你知道的"}, {"type": "subtitle", "time": 1013.43, "timestamp": "00:16:53", "text": "你知道吗？我已经受够了"}, {"type": "subtitle", "time": 1016.79, "timestamp": "00:16:56", "text": "神秘地神秘地失去"}]
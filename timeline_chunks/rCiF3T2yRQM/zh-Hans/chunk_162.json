[{"type": "subtitle", "time": 9721.75, "timestamp": "02:42:01", "text": "呃，现在就……就这么发生了，碰巧"}, {"type": "subtitle", "time": 9724.63, "timestamp": "02:42:04", "text": "现在，竞技场被拉进了月球。"}, {"type": "subtitle", "time": 9727.19, "timestamp": "02:42:07", "text": "光束。所以竞技场需要像这样……"}, {"type": "subtitle", "time": 9731.75, "timestamp": "02:42:11", "text": "月光。好的。再掷一次 2d10。"}, {"type": "subtitle", "time": 9732.95, "timestamp": "02:42:12", "text": "是的。我想你只要保存一下就行了。我"}, {"type": "subtitle", "time": 9735.03, "timestamp": "02:42:15", "text": "我忘了，是的，我忘了做"}, {"type": "subtitle", "time": 9735.99, "timestamp": "02:42:15", "text": "比上一个节省，但不要"}, {"type": "subtitle", "time": 9738.95, "timestamp": "02:42:18", "text": "担心。保存。然后还有……"}, {"type": "subtitle", "time": 9740.309, "timestamp": "02:42:20", "text": "这是哪种类型的存档？"}, {"type": "subtitle", "time": 9742.389, "timestamp": "02:42:22", "text": "呃，如果我没记错的话，应该是骗局。让我"}, {"type": "subtitle", "time": 9744.71, "timestamp": "02:42:24", "text": "再确认一下。实际上，我只要"}, {"type": "subtitle", "time": 9747.349, "timestamp": "02:42:27", "text": "点赞并点击查看。我的意思是，不要"}, {"type": "subtitle", "time": 9750.469, "timestamp": "02:42:30", "text": "消耗施法。嗯，是的。 DC-15"}, {"type": "subtitle", "time": 9753.03, "timestamp": "02:42:33", "text": "宪法得以保存。是的。然后慢跑"}, {"type": "subtitle", "time": 9755.67, "timestamp": "02:42:35", "text": "滚动"}, {"type": "subtitle", "time": 9758.95, "timestamp": "02:42:38", "text": "慢跑滚动滚动伤害就像"}, {"type": "subtitle", "time": 9760.79, "timestamp": "02:42:40", "text": "损害。"}, {"type": "subtitle", "time": 9761.91, "timestamp": "02:42:41", "text": "好的。"}, {"type": "subtitle", "time": 9776.95, "timestamp": "02:42:56", "text": "一起搬到这里来。所以如果你想要一个"}, {"type": "subtitle", "time": 9779.51, "timestamp": "02:42:59", "text": "慢跑时，你可以立刻像月光一样。"}]
[{"type": "subtitle", "time": 540.87, "timestamp": "00:09:00", "text": "用于我的测试。这实际上就像"}, {"type": "subtitle", "time": 543.75, "timestamp": "00:09:03", "text": "速度大约是原来的7.6倍"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "上一个。当然。只需更改"}, {"type": "subtitle", "time": 546.23, "timestamp": "00:09:06", "text": "编码。"}, {"type": "subtitle", "time": 548.79, "timestamp": "00:09:08", "text": "这个就是这样，我不喜欢。"}, {"type": "subtitle", "time": 550.07, "timestamp": "00:09:10", "text": "你找到原因了吗？"}, {"type": "subtitle", "time": 551.91, "timestamp": "00:09:11", "text": "这么慢？仅仅是图片的问题吗？"}, {"type": "subtitle", "time": 552.87, "timestamp": "00:09:12", "text": "尺寸？"}, {"type": "subtitle", "time": 554.55, "timestamp": "00:09:14", "text": "主要是因为加载方式"}, {"type": "subtitle", "time": 556.23, "timestamp": "00:09:16", "text": "同时处理的事情太多了。所以，我"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "就像把它分成多个部分一样。"}, {"type": "subtitle", "time": 564.23, "timestamp": "00:09:24", "text": "很公平。好的。好的。所以我们是"}, {"type": "subtitle", "time": 566.71, "timestamp": "00:09:26", "text": "这里又回到了山洞里。醒来。"}, {"type": "subtitle", "time": 570.63, "timestamp": "00:09:30", "text": "Ariana、Jock，还有呃，不知为何呃"}, {"type": "subtitle", "time": 573.269, "timestamp": "00:09:33", "text": "科纳中了钴的毒。你不"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "男生们不知道为什么，但是……所有……"}, {"type": "subtitle", "time": 578.79, "timestamp": "00:09:38", "text": "我当时在睡觉，你们过得很糟糕。"}, {"type": "subtitle", "time": 580.87, "timestamp": "00:09:40", "text": "恶梦。你做了个噩梦"}, {"type": "subtitle", "time": 584.15, "timestamp": "00:09:44", "text": "就像某个幽灵般的老太太"}, {"type": "subtitle", "time": 586.15, "timestamp": "00:09:46", "text": "给你打粉笔，但突然就……"}, {"type": "subtitle", "time": 588.47, "timestamp": "00:09:48", "text": "在某个时候消失了，而你……"}, {"type": "subtitle", "time": 590.63, "timestamp": "00:09:50", "text": "就像继续睡觉一样"}, {"type": "subtitle", "time": 593.67, "timestamp": "00:09:53", "text": "比较平静。好的。"}, {"type": "subtitle", "time": 596.47, "timestamp": "00:09:56", "text": "与对方见面。"}, {"type": "subtitle", "time": 598.47, "timestamp": "00:09:58", "text": "是的。"}]
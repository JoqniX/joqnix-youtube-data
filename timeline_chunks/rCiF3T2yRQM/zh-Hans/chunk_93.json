[{"type": "subtitle", "time": 5580.709, "timestamp": "01:33:00", "text": "龙族韧性可以提升你的生命值。"}, {"type": "subtitle", "time": 5582.629, "timestamp": "01:33:02", "text": "哦，那真酷。"}, {"type": "subtitle", "time": 5583.99, "timestamp": "01:33:03", "text": "好的，稍等。我不知道你为什么……"}, {"type": "subtitle", "time": 5585.83, "timestamp": "01:33:05", "text": "仍然俯卧。然后我也喜欢我会"}, {"type": "subtitle", "time": 5587.59, "timestamp": "01:33:07", "text": "我就用你的现金来付吧，因为"}, {"type": "subtitle", "time": 5588.87, "timestamp": "01:33:08", "text": "你的代币好像喝醉了。"}, {"type": "subtitle", "time": 5590.47, "timestamp": "01:33:10", "text": "原因。但你知道吗？那是……"}, {"type": "subtitle", "time": 5592.629, "timestamp": "01:33:12", "text": "特点。"}, {"type": "subtitle", "time": 5595.189, "timestamp": "01:33:15", "text": "好的，我们来看看。"}, {"type": "subtitle", "time": 5598.47, "timestamp": "01:33:18", "text": "迪克，你感觉怎么样，兄弟？"}, {"type": "subtitle", "time": 5599.43, "timestamp": "01:33:19", "text": "你还好吗？"}, {"type": "subtitle", "time": 5601.35, "timestamp": "01:33:21", "text": "好了。你承受了损失。全部"}, {"type": "subtitle", "time": 5604.39, "timestamp": "01:33:24", "text": "正确的。水是辣的吗？"}, {"type": "subtitle", "time": 5607.43, "timestamp": "01:33:27", "text": "一点点？"}, {"type": "subtitle", "time": 5608.149, "timestamp": "01:33:28", "text": "知道了。"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "别喝那个。"}, {"type": "subtitle", "time": 5611.27, "timestamp": "01:33:31", "text": "辣水。"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "好的。阿瑞娜正盯着小瓶看。"}, {"type": "subtitle", "time": 5621.27, "timestamp": "01:33:41", "text": "“是黑色液体。”好的。"}, {"type": "subtitle", "time": 5627.189, "timestamp": "01:33:47", "text": "谢谢你，Tick。你"}, {"type": "subtitle", "time": 5629.27, "timestamp": "01:33:49", "text": "做得很好。"}, {"type": "subtitle", "time": 5631.669, "timestamp": "01:33:51", "text": "你做得很好。打补丁。"}, {"type": "subtitle", "time": 5634.149, "timestamp": "01:33:54", "text": "我可以像倒一滴黑水那样倒出来吗？"}, {"type": "subtitle", "time": 5636.79, "timestamp": "01:33:56", "text": "我旁边尸体上的液体？"}, {"type": "subtitle", "time": 5638.79, "timestamp": "01:33:58", "text": "是的，可以。"}]
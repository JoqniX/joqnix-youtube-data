[{"type": "subtitle", "time": 10801.83, "timestamp": "03:00:01", "text": "这会造成伤害。"}, {"type": "subtitle", "time": 10806.55, "timestamp": "03:00:06", "text": "真棒。好的。运用它。好的。"}, {"type": "subtitle", "time": 10808.469, "timestamp": "03:00:08", "text": "轮到我了吗？"}, {"type": "subtitle", "time": 10810.54, "timestamp": "03:00:10", "text": "好的。我是谁？"}, {"type": "subtitle", "time": 10812.309, "timestamp": "03:00:12", "text": "[音乐]"}, {"type": "subtitle", "time": 10814.95, "timestamp": "03:00:14", "text": "那么，我也在前进吗？"}, {"type": "subtitle", "time": 10818.469, "timestamp": "03:00:18", "text": "是的。坚持，稍等。呃，10英尺。所以，我们就这么说吧。"}, {"type": "subtitle", "time": 10820.469, "timestamp": "03:00:20", "text": "这里。开始了。除非你想"}, {"type": "subtitle", "time": 10821.91, "timestamp": "03:00:21", "text": "抵抗。你想反抗吗？"}, {"type": "subtitle", "time": 10824.389, "timestamp": "03:00:24", "text": "不，不，不。我不会反抗。我会我会"}, {"type": "subtitle", "time": 10824.63, "timestamp": "03:00:24", "text": "是的，"}, {"type": "subtitle", "time": 10825.83, "timestamp": "03:00:25", "text": "我想我还是继续往前走吧。"}, {"type": "subtitle", "time": 10827.269, "timestamp": "03:00:27", "text": "另外，在这里，你也会注意到……"}, {"type": "subtitle", "time": 10829.51, "timestamp": "03:00:29", "text": "这里看起来很薄。"}, {"type": "subtitle", "time": 10832.55, "timestamp": "03:00:32", "text": "膜。这边这一段，"}, {"type": "subtitle", "time": 10835.51, "timestamp": "03:00:35", "text": "极薄的膜。如果你攻击它，它"}, {"type": "subtitle", "time": 10838.63, "timestamp": "03:00:38", "text": "可能会……坏掉。"}, {"type": "subtitle", "time": 10840.55, "timestamp": "03:00:40", "text": "当然可以，为什么不呢？发起进攻。"}, {"type": "subtitle", "time": 10842.23, "timestamp": "03:00:42", "text": "但那将意味着进攻。"}, {"type": "subtitle", "time": 10843.51, "timestamp": "03:00:43", "text": "你用的是多重攻击，对吧？如果我不是"}, {"type": "subtitle", "time": 10843.99, "timestamp": "03:00:43", "text": "错误。"}, {"type": "subtitle", "time": 10845.03, "timestamp": "03:00:45", "text": "是的，我进行多重攻击。"}, {"type": "subtitle", "time": 10846.63, "timestamp": "03:00:46", "text": "是的。是的。好的。"}, {"type": "subtitle", "time": 10848.95, "timestamp": "03:00:48", "text": "所以，我要进攻台球。"}, {"type": "subtitle", "time": 10851.83, "timestamp": "03:00:51", "text": "好的。立即造成破坏。"}, {"type": "subtitle", "time": 10852.95, "timestamp": "03:00:52", "text": "哦，立即造成损失。"}, {"type": "subtitle", "time": 10855.03, "timestamp": "03:00:55", "text": "是的。是的。因为它只是一堵墙而已。"}, {"type": "subtitle", "time": 10857.19, "timestamp": "03:00:57", "text": "是的。完全损坏。"}, {"type": "subtitle", "time": 10859.83, "timestamp": "03:00:59", "text": "损害。"}]
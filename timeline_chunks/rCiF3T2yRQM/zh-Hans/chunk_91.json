[{"type": "subtitle", "time": 5460.709, "timestamp": "01:31:00", "text": "冒出好多气泡。"}, {"type": "subtitle", "time": 5462.47, "timestamp": "01:31:02", "text": "我太好奇了。我有点想"}, {"type": "subtitle", "time": 5465.83, "timestamp": "01:31:05", "text": "他妈的，现在就尝尝这黑色液体的味道。"}, {"type": "subtitle", "time": 5468.149, "timestamp": "01:31:08", "text": "我感觉有点"}, {"type": "subtitle", "time": 5469.83, "timestamp": "01:31:09", "text": "你是"}, {"type": "subtitle", "time": 5472.07, "timestamp": "01:31:12", "text": "把想法放在脑海里。"}, {"type": "subtitle", "time": 5475.35, "timestamp": "01:31:15", "text": "但我不想要黑色液体"}, {"type": "subtitle", "time": 5476.87, "timestamp": "01:31:16", "text": "他们张开了嘴。他们显然"}, {"type": "subtitle", "time": 5478.55, "timestamp": "01:31:18", "text": "仔细考虑一下。显然存在一个"}, {"type": "subtitle", "time": 5480.95, "timestamp": "01:31:20", "text": "想法。然而，他们之前就被告知过。"}, {"type": "subtitle", "time": 5482.709, "timestamp": "01:31:22", "text": "没有，而且他们也没有被给予。"}, {"type": "subtitle", "time": 5488.39, "timestamp": "01:31:28", "text": "他只是看着蜱虫盯着黑色。"}, {"type": "chat", "time": 5489.251, "timestamp": "01:31:29", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "u well ?"}, {"type": "subtitle", "time": 5490.709, "timestamp": "01:31:30", "text": "液体。"}, {"type": "subtitle", "time": 5494.149, "timestamp": "01:31:34", "text": "他心怀邪念。"}, {"type": "subtitle", "time": 5497.43, "timestamp": "01:31:37", "text": "嗯，是的。我的天哪。"}, {"type": "subtitle", "time": 5499.669, "timestamp": "01:31:39", "text": "就像检查小瓶里的东西一样……"}, {"type": "subtitle", "time": 5501.99, "timestamp": "01:31:41", "text": "这？"}, {"type": "subtitle", "time": 5503.03, "timestamp": "01:31:43", "text": "你想试试吗？"}, {"type": "subtitle", "time": 5507.11, "timestamp": "01:31:47", "text": "DND游戏时间会非常长。"}, {"type": "subtitle", "time": 5507.51, "timestamp": "01:31:47", "text": "是的。"}, {"type": "subtitle", "time": 5509.91, "timestamp": "01:31:49", "text": "喝一杯。"}, {"type": "subtitle", "time": 5517.91, "timestamp": "01:31:57", "text": "我的天啊。所以"}]
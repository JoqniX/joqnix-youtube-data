[{"type": "subtitle", "time": 10742.309, "timestamp": "02:59:02", "text": "蓝色的。好的。好的。嗯，让我想想。"}, {"type": "subtitle", "time": 10745.349, "timestamp": "02:59:05", "text": "掷骰子造成伤害。"}, {"type": "subtitle", "time": 10747.03, "timestamp": "02:59:07", "text": "我的天哪。"}, {"type": "subtitle", "time": 10748.95, "timestamp": "02:59:08", "text": "克里斯汀在那里。我刚刚意识到我翻滚了。"}, {"type": "subtitle", "time": 10751.349, "timestamp": "02:59:11", "text": "克里斯彭。坚持，稍等。等等。我这就去"}, {"type": "subtitle", "time": 10754.389, "timestamp": "02:59:14", "text": "给水晶环上环。所以适用于所有人"}, {"type": "subtitle", "time": 10758.63, "timestamp": "02:59:18", "text": "但我刚刚他妈的干掉了两个人"}, {"type": "subtitle", "time": 10761.55, "timestamp": "02:59:21", "text": "例如。该死。"}, {"type": "subtitle", "time": 10764.15, "timestamp": "02:59:24", "text": "[音乐]"}, {"type": "subtitle", "time": 10766.79, "timestamp": "02:59:26", "text": "我再也不会玩术士了。"}, {"type": "subtitle", "time": 10767.91, "timestamp": "02:59:27", "text": "这场比赛之后。"}, {"type": "subtitle", "time": 10769.67, "timestamp": "02:59:29", "text": "吸取教训。"}, {"type": "subtitle", "time": 10771.75, "timestamp": "02:59:31", "text": "发誓成为一名术士治疗师"}, {"type": "subtitle", "time": 10773.91, "timestamp": "02:59:33", "text": "方式。"}, {"type": "subtitle", "time": 10776.389, "timestamp": "02:59:36", "text": "瓦尔人或野蛮人。"}, {"type": "subtitle", "time": 10778.07, "timestamp": "02:59:38", "text": "大理石雕刻师挺有意思的。"}, {"type": "subtitle", "time": 10780.23, "timestamp": "02:59:40", "text": "索洛克。"}, {"type": "subtitle", "time": 10782.63, "timestamp": "02:59:42", "text": "该喝酒了。是的。"}, {"type": "subtitle", "time": 10784.71, "timestamp": "02:59:44", "text": "你知道吗？你知道吗，克里斯彭？"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "咱们就这么办吧，你呢？"}, {"type": "subtitle", "time": 10789.62, "timestamp": "02:59:49", "text": "直到你死去。"}, {"type": "subtitle", "time": 10791.83, "timestamp": "02:59:51", "text": "[音乐]"}, {"type": "subtitle", "time": 10794.79, "timestamp": "02:59:54", "text": "我的双手丢失了。"}, {"type": "subtitle", "time": 10796.87, "timestamp": "02:59:56", "text": "好的。"}]
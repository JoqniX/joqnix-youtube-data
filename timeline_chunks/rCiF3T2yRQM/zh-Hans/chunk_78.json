[{"type": "subtitle", "time": 4681.59, "timestamp": "01:18:01", "text": "嗯，就像你知道的，告诉滴答和告诉"}, {"type": "subtitle", "time": 4684.47, "timestamp": "01:18:04", "text": "滴答，然后爱莉安娜就像拉一样。"}, {"type": "subtitle", "time": 4686.63, "timestamp": "01:18:06", "text": "这根绳子"}, {"type": "subtitle", "time": 4689.75, "timestamp": "01:18:09", "text": "请。好的，Ariana 来拿绳子。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "谢谢。轮到我了。"}, {"type": "subtitle", "time": 4695.75, "timestamp": "01:18:15", "text": "好的。好的。好的。谁还在坚持？"}, {"type": "subtitle", "time": 4697.75, "timestamp": "01:18:17", "text": "顺便问一下，绳子呢？顺便一提，"}, {"type": "subtitle", "time": 4699.27, "timestamp": "01:18:19", "text": "只是想让我知道一下。"}, {"type": "subtitle", "time": 4700.229, "timestamp": "01:18:20", "text": "绳子。"}, {"type": "subtitle", "time": 4702.229, "timestamp": "01:18:22", "text": "好的。另一个像谁？"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "像 Tick 或 Estan 那样的外在风格？因为就像"}, {"type": "subtitle", "time": 4708.709, "timestamp": "01:18:28", "text": "你们其中一人身上也有这件东西，对吧？"}, {"type": "subtitle", "time": 4710.55, "timestamp": "01:18:30", "text": "是的。是的。我一直都抓着它呢。"}, {"type": "subtitle", "time": 4711.03, "timestamp": "01:18:31", "text": "现在。"}, {"type": "subtitle", "time": 4713.83, "timestamp": "01:18:33", "text": "哦好的。我……我……就……呃"}, {"type": "subtitle", "time": 4715.91, "timestamp": "01:18:35", "text": "记住这一点。 Tick 还没动过，所以"}, {"type": "subtitle", "time": 4717.91, "timestamp": "01:18:37", "text": "他还不能把它留下来。"}, {"type": "subtitle", "time": 4719.51, "timestamp": "01:18:39", "text": "嗯。"}, {"type": "subtitle", "time": 4722.39, "timestamp": "01:18:42", "text": "除非Tick另有打算。"}, {"type": "subtitle", "time": 4724.39, "timestamp": "01:18:44", "text": "好的。"}, {"type": "subtitle", "time": 4726.95, "timestamp": "01:18:46", "text": "Tick确实有计划。"}, {"type": "subtitle", "time": 4729.189, "timestamp": "01:18:49", "text": "好的。哦，乔，轮到你了。"}, {"type": "subtitle", "time": 4731.11, "timestamp": "01:18:51", "text": "呃，"}, {"type": "subtitle", "time": 4735.11, "timestamp": "01:18:55", "text": "我应该施放缠绕咒语吗？呃……"}, {"type": "subtitle", "time": 4737.669, "timestamp": "01:18:57", "text": "萌发腺体，以便它们能够"}]
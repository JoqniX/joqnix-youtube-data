[{"type": "subtitle", "time": 1440.87, "timestamp": "00:24:00", "text": "爱它。"}, {"type": "subtitle", "time": 1444.149, "timestamp": "00:24:04", "text": "好的。技术细节。"}, {"type": "subtitle", "time": 1445.51, "timestamp": "00:24:05", "text": "好的。所有技术方面"}, {"type": "subtitle", "time": 1448.39, "timestamp": "00:24:08", "text": "困难。好的。嗯，当然。我是"}, {"type": "subtitle", "time": 1449.909, "timestamp": "00:24:09", "text": "打算想办法把你搬出去"}, {"type": "subtitle", "time": 1451.51, "timestamp": "00:24:11", "text": "场景切换后，再把你移回去。让"}, {"type": "subtitle", "time": 1453.669, "timestamp": "00:24:13", "text": "让我看看。所以，如果我们回到等待的状态。"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "房间，你能搬到那里去吗？"}, {"type": "subtitle", "time": 1457.75, "timestamp": "00:24:17", "text": "哦，瞧。令人耳目一新。"}, {"type": "subtitle", "time": 1460.31, "timestamp": "00:24:20", "text": "哦好的。好的。是的。好的。只是"}, {"type": "subtitle", "time": 1463.029, "timestamp": "00:24:23", "text": "告诉我那里有什么。"}, {"type": "subtitle", "time": 1468.95, "timestamp": "00:24:28", "text": "告诉我为什么。"}, {"type": "subtitle", "time": 1477.5, "timestamp": "00:24:37", "text": "还有第五名。"}, {"type": "subtitle", "time": 1479.99, "timestamp": "00:24:39", "text": "[音乐]"}, {"type": "subtitle", "time": 1486.07, "timestamp": "00:24:46", "text": "你说我希望那样。"}, {"type": "subtitle", "time": 1487.909, "timestamp": "00:24:47", "text": "第五名。第五名。杀死了我的"}, {"type": "subtitle", "time": 1489.43, "timestamp": "00:24:49", "text": "兄弟。"}, {"type": "subtitle", "time": 1491.75, "timestamp": "00:24:51", "text": "是复兴。"}, {"type": "subtitle", "time": 1493.19, "timestamp": "00:24:53", "text": "我的天啊。"}]
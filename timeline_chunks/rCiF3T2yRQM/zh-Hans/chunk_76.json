[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "哦。"}, {"type": "subtitle", "time": 4563.11, "timestamp": "01:16:03", "text": "呃，埃斯坦，该你出招了。你如何逃脱"}, {"type": "subtitle", "time": 4576.149, "timestamp": "01:16:16", "text": "别说"}, {"type": "subtitle", "time": 4576.95, "timestamp": "01:16:16", "text": "嗯，"}, {"type": "subtitle", "time": 4577.91, "timestamp": "01:16:17", "text": "他会转过身来，然后说："}, {"type": "subtitle", "time": 4579.51, "timestamp": "01:16:19", "text": "你们还好吗？"}, {"type": "subtitle", "time": 4581.03, "timestamp": "01:16:21", "text": "呃，"}, {"type": "subtitle", "time": 4583.43, "timestamp": "01:16:23", "text": "我们被困住了。"}, {"type": "subtitle", "time": 4584.79, "timestamp": "01:16:24", "text": "卡住。"}, {"type": "subtitle", "time": 4588.07, "timestamp": "01:16:28", "text": "我有点……嗯，有点"}, {"type": "subtitle", "time": 4591.35, "timestamp": "01:16:31", "text": "这里粘住了。嗯，我想我得试试。"}, {"type": "subtitle", "time": 4595.27, "timestamp": "01:16:35", "text": "摆脱它，试着喜欢你"}, {"type": "subtitle", "time": 4598.229, "timestamp": "01:16:38", "text": "知道了，跳回光盘。"}, {"type": "subtitle", "time": 4599.35, "timestamp": "01:16:39", "text": "好的。这会有点难。"}, {"type": "subtitle", "time": 4600.55, "timestamp": "01:16:40", "text": "政治。"}, {"type": "subtitle", "time": 4602.63, "timestamp": "01:16:42", "text": "是的，这会有点难。"}, {"type": "subtitle", "time": 4604.63, "timestamp": "01:16:44", "text": "但你知道，至少我不是。"}, {"type": "subtitle", "time": 4607.189, "timestamp": "01:16:47", "text": "负一，但我依然是。真的吗？"}, {"type": "subtitle", "time": 4613.99, "timestamp": "01:16:53", "text": "好的。嗯，是的，你，你只是，你只是"}, {"type": "subtitle", "time": 4615.59, "timestamp": "01:16:55", "text": "重重地摔回地上。"}, {"type": "subtitle", "time": 4616.07, "timestamp": "01:16:56", "text": "是的。"}, {"type": "subtitle", "time": 4617.43, "timestamp": "01:16:57", "text": "倒在地上。"}]
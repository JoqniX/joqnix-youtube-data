[{"type": "subtitle", "time": 5520.07, "timestamp": "01:32:00", "text": "他真是太好了"}, {"type": "subtitle", "time": 5521.99, "timestamp": "01:32:01", "text": "阿丽亚娜，我有时会忘记他是个……"}, {"type": "subtitle", "time": 5528.55, "timestamp": "01:32:08", "text": "她把整个头浸入水中，就像在水中上下摆动一样。"}, {"type": "subtitle", "time": 5529.83, "timestamp": "01:32:09", "text": "苹果。"}, {"type": "subtitle", "time": 5532.79, "timestamp": "01:32:12", "text": "好的。好的。你呃，你打开"}, {"type": "subtitle", "time": 5534.31, "timestamp": "01:32:14", "text": "水龙头又开了。这次是这样的"}, {"type": "subtitle", "time": 5537.51, "timestamp": "01:32:17", "text": "出来的东西是黑色的。再掷一次d20。"}, {"type": "subtitle", "time": 5547.91, "timestamp": "01:32:27", "text": "好的。好的。呃，你有酸吗？"}, {"type": "subtitle", "time": 5550.39, "timestamp": "01:32:30", "text": "反抗？你拿走你他妈的拿走"}, {"type": "subtitle", "time": 5553.27, "timestamp": "01:32:33", "text": "酸蚀损伤。"}, {"type": "subtitle", "time": 5555.03, "timestamp": "01:32:35", "text": "糟糕。坚持，稍等。我是否不小心"}, {"type": "subtitle", "time": 5557.11, "timestamp": "01:32:37", "text": "不小心删除了"}, {"type": "subtitle", "time": 5559.83, "timestamp": "01:32:39", "text": "我的天啊。被他妈的从系统里删除了。"}, {"type": "subtitle", "time": 5562.47, "timestamp": "01:32:42", "text": "哦不，他走了。"}, {"type": "subtitle", "time": 5564.39, "timestamp": "01:32:44", "text": "是的，不知为何令牌有点……"}, {"type": "subtitle", "time": 5566.39, "timestamp": "01:32:46", "text": "虽然有点歪，但我会做的。"}, {"type": "subtitle", "time": 5567.99, "timestamp": "01:32:47", "text": "计算。我不知道为什么会这样"}, {"type": "subtitle", "time": 5569.75, "timestamp": "01:32:49", "text": "虽然做了些不太靠谱的事，但确实如此。"}, {"type": "subtitle", "time": 5572.149, "timestamp": "01:32:52", "text": "哦，是的。不，他没有，他没有"}, {"type": "subtitle", "time": 5573.59, "timestamp": "01:32:53", "text": "有吗？"}, {"type": "subtitle", "time": 5574.79, "timestamp": "01:32:54", "text": "好的，"}, {"type": "subtitle", "time": 5577.669, "timestamp": "01:32:57", "text": "等待。什么是龙族韧性？我"}, {"type": "subtitle", "time": 5578.47, "timestamp": "01:32:58", "text": "我也不知道。"}]
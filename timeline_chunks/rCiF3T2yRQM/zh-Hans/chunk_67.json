[{"type": "subtitle", "time": 4020.16, "timestamp": "01:07:00", "text": "慢慢地，由肌肉控制 那个东西。"}, {"type": "subtitle", "time": 4021.359, "timestamp": "01:07:01", "text": "那个东西。 哦亲爱的。这似乎没什么帮助。"}, {"type": "subtitle", "time": 4025.68, "timestamp": "01:07:05", "text": "哦亲爱的。这似乎没什么帮助。 感觉像一张嘴。"}, {"type": "subtitle", "time": 4035.43, "timestamp": "01:07:15", "text": "我们可以尝试再次攻击它。"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "他正准备再射一箭。"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "还有，直接炸掉它。"}, {"type": "subtitle", "time": 4047.43, "timestamp": "01:07:27", "text": "好的。"}, {"type": "subtitle", "time": 4049.589, "timestamp": "01:07:29", "text": "正确的。直接掷骰判定伤害。"}, {"type": "subtitle", "time": 4052.309, "timestamp": "01:07:32", "text": "是的。"}, {"type": "subtitle", "time": 4055.27, "timestamp": "01:07:35", "text": "好的。炸毁地板。它不"}, {"type": "subtitle", "time": 4057.589, "timestamp": "01:07:37", "text": "似乎什么都不做。"}, {"type": "subtitle", "time": 4059.67, "timestamp": "01:07:39", "text": "就让它稍微抽搐一下。"}, {"type": "subtitle", "time": 4060.95, "timestamp": "01:07:40", "text": "差不多就是这样了。还，"}, {"type": "subtitle", "time": 4062.15, "timestamp": "01:07:42", "text": "什么？对不起。"}, {"type": "subtitle", "time": 4064.63, "timestamp": "01:07:44", "text": "我可以给水塑形吗？我只需要补充水分吗？"}, {"type": "subtitle", "time": 4066.23, "timestamp": "01:07:46", "text": "补水？"}, {"type": "subtitle", "time": 4067.67, "timestamp": "01:07:47", "text": "保持口腔湿润。"}, {"type": "subtitle", "time": 4069.27, "timestamp": "01:07:49", "text": "我的意思是，我想，我想，就像我"}, {"type": "subtitle", "time": 4071.43, "timestamp": "01:07:51", "text": "我会说，是的，我会说你可以喜欢"}, {"type": "subtitle", "time": 4073.19, "timestamp": "01:07:53", "text": "这里有水，你可以"}, {"type": "subtitle", "time": 4075.27, "timestamp": "01:07:55", "text": "摇晃水。"}, {"type": "subtitle", "time": 4076.789, "timestamp": "01:07:56", "text": "只是想给肉体补水。"}, {"type": "subtitle", "time": 4079.589, "timestamp": "01:07:59", "text": "很快。"}]
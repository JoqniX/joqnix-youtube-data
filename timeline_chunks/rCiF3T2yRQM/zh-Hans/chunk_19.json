[{"type": "subtitle", "time": 1143.909, "timestamp": "00:19:03", "text": "我知道，它是嗯 B。它是 slashBR 3D 100。"}, {"type": "subtitle", "time": 1147.35, "timestamp": "00:19:07", "text": "嗯。好的。"}, {"type": "subtitle", "time": 1149.19, "timestamp": "00:19:09", "text": "另一方遇到了很多麻烦。"}, {"type": "subtitle", "time": 1152.23, "timestamp": "00:19:12", "text": "就这样。我记得。"}, {"type": "subtitle", "time": 1155.43, "timestamp": "00:19:15", "text": "好的。好的。好了。好的。我"}, {"type": "subtitle", "time": 1159.43, "timestamp": "00:19:19", "text": "想想看，做个 D 100，呃，我打盲了。"}, {"type": "subtitle", "time": 1162.07, "timestamp": "00:19:22", "text": "盲打一次D100。"}, {"type": "subtitle", "time": 1164.63, "timestamp": "00:19:24", "text": "好的。我打算快速写下这些"}, {"type": "subtitle", "time": 1166.71, "timestamp": "00:19:26", "text": "向下。"}, {"type": "subtitle", "time": 1168.71, "timestamp": "00:19:28", "text": "这。所以，这个东西就是那个东西。"}, {"type": "subtitle", "time": 1170.23, "timestamp": "00:19:30", "text": "如果我打算……，我就会用它。"}, {"type": "subtitle", "time": 1173.029, "timestamp": "00:19:33", "text": "比如，如果我想秘密地确定"}, {"type": "subtitle", "time": 1183.35, "timestamp": "00:19:43", "text": "我确信是"}, {"type": "subtitle", "time": 1186.07, "timestamp": "00:19:46", "text": "我相信不会发生任何不好的事情。"}, {"type": "subtitle", "time": 1189.59, "timestamp": "00:19:49", "text": "已经写好了。乔克的乔克"}, {"type": "subtitle", "time": 1197.51, "timestamp": "00:19:57", "text": "好的，"}, {"type": "subtitle", "time": 1197.75, "timestamp": "00:19:57", "text": "我是"}]
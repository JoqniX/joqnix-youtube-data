[{"type": "subtitle", "time": 12180.229, "timestamp": "03:23:00", "text": "哦，等等。他妈的。妈的。真是他妈的"}, {"type": "subtitle", "time": 12183.11, "timestamp": "03:23:03", "text": "至少说过话。对不起。"}, {"type": "subtitle", "time": 12186.87, "timestamp": "03:23:06", "text": "角色扮演游戏 13。"}, {"type": "subtitle", "time": 12189.91, "timestamp": "03:23:09", "text": "哦，不。"}, {"type": "subtitle", "time": 12193.03, "timestamp": "03:23:13", "text": "不，是最后一个。好了，就是这样。"}, {"type": "subtitle", "time": 12193.67, "timestamp": "03:23:13", "text": "打。"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "你这行为可一点都不符合PG-13级（家长指导级）的要求。"}, {"type": "subtitle", "time": 12199.269, "timestamp": "03:23:19", "text": "我的天哪。"}, {"type": "subtitle", "time": 12203.67, "timestamp": "03:23:23", "text": "情况不太乐观。她感觉"}, {"type": "subtitle", "time": 12208.63, "timestamp": "03:23:28", "text": "猛烈的攻击。我的天哪。该死。"}, {"type": "subtitle", "time": 12210.87, "timestamp": "03:23:30", "text": "好的。而那将是……"}, {"type": "subtitle", "time": 12214.07, "timestamp": "03:23:34", "text": "给史莱姆用的。好的。厚的。"}, {"type": "subtitle", "time": 12217.19, "timestamp": "03:23:37", "text": "轮到你了。"}, {"type": "subtitle", "time": 12219.75, "timestamp": "03:23:39", "text": "但实际上，这会非常有趣。"}, {"type": "subtitle", "time": 12223.59, "timestamp": "03:23:43", "text": "因为想测试一下史莱姆。"}, {"type": "subtitle", "time": 12225.91, "timestamp": "03:23:45", "text": "第二条绦虫。"}, {"type": "subtitle", "time": 12228.309, "timestamp": "03:23:48", "text": "又一个。"}, {"type": "subtitle", "time": 12232.229, "timestamp": "03:23:52", "text": "第二。我的意思是，如果那盘神奇的磁带"}, {"type": "subtitle", "time": 12234.95, "timestamp": "03:23:54", "text": "没用，魔法蛆虫。矿。"}, {"type": "subtitle", "time": 12236.63, "timestamp": "03:23:56", "text": "魔法蛆虫。"}]
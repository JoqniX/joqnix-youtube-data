[{"type": "subtitle", "time": 11942.309, "timestamp": "03:19:02", "text": "轻松的挑战，我为此感到非常高兴"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "和它一起。"}, {"type": "subtitle", "time": 11945.75, "timestamp": "03:19:05", "text": "不过还是要向莱昂纳德致敬。我不"}, {"type": "subtitle", "time": 11947.91, "timestamp": "03:19:07", "text": "想知道他现在是否在线。"}, {"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "好的。我该怎么办？为什么我无法移动？哦"}, {"type": "subtitle", "time": 11951.99, "timestamp": "03:19:11", "text": "我的上帝。"}, {"type": "subtitle", "time": 11955.19, "timestamp": "03:19:15", "text": "哦，是的。呃呃，我动不了。"}, {"type": "subtitle", "time": 11961.67, "timestamp": "03:19:21", "text": "我够钱吗？"}, {"type": "subtitle", "time": 11962.15, "timestamp": "03:19:22", "text": "我的天哪。"}, {"type": "subtitle", "time": 11963.269, "timestamp": "03:19:23", "text": "是的。"}, {"type": "subtitle", "time": 11963.91, "timestamp": "03:19:23", "text": "和"}, {"type": "subtitle", "time": 11966.95, "timestamp": "03:19:26", "text": "嘿，就是它"}, {"type": "subtitle", "time": 11967.59, "timestamp": "03:19:27", "text": "我该怎么做？"}, {"type": "subtitle", "time": 11969.19, "timestamp": "03:19:29", "text": "你的东西已经是你的东西了"}, {"type": "subtitle", "time": 11971.19, "timestamp": "03:19:31", "text": "被挑战所吸引。我记得是因为我"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "从未删除过。所以你实际上可以"}, {"type": "subtitle", "time": 11974.63, "timestamp": "03:19:34", "text": "只需点击你的第四个选项，它就会"}, {"type": "subtitle", "time": 11977.83, "timestamp": "03:19:37", "text": "嗯，挑战一下。等等，我必须选择"}, {"type": "subtitle", "time": 11978.95, "timestamp": "03:19:38", "text": "目标或"}, {"type": "subtitle", "time": 11981.83, "timestamp": "03:19:41", "text": "是的。呃，你不需要只是呃"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "你没有选择目标。就，是啊。"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "好了。我会证明这一点。"}, {"type": "subtitle", "time": 11987.99, "timestamp": "03:19:47", "text": "呃，让我来揭晓答案。好的。好的。"}, {"type": "subtitle", "time": 11989.51, "timestamp": "03:19:49", "text": "立即掷骰判定伤害，因为"}, {"type": "subtitle", "time": 11990.95, "timestamp": "03:19:50", "text": "这是一堵墙。"}, {"type": "subtitle", "time": 11993.349, "timestamp": "03:19:53", "text": "好的。是的。掷骰子造成伤害。"}, {"type": "subtitle", "time": 11994.95, "timestamp": "03:19:54", "text": "普通的。"}, {"type": "subtitle", "time": 11996.79, "timestamp": "03:19:56", "text": "好的。好的。我会喜欢"}, {"type": "subtitle", "time": 11999.67, "timestamp": "03:19:59", "text": "揭示这一点，因为就像它仍然像"}]
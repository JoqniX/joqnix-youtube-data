[{"type": "subtitle", "time": 5821.189, "timestamp": "01:37:01", "text": "其中之一很可能"}, {"type": "subtitle", "time": 5823.27, "timestamp": "01:37:03", "text": "复活之类的。其中之一是"}, {"type": "subtitle", "time": 5825.83, "timestamp": "01:37:05", "text": "可能要等等。让我们来检查一下所有……"}, {"type": "subtitle", "time": 5827.35, "timestamp": "01:37:07", "text": "尸体。看看他们有没有什么"}, {"type": "subtitle", "time": 5829.91, "timestamp": "01:37:09", "text": "第一的。万一"}, {"type": "subtitle", "time": 5831.03, "timestamp": "01:37:11", "text": "如果你想核实，请随时联系。"}, {"type": "subtitle", "time": 5831.91, "timestamp": "01:37:11", "text": "调查这个问题。"}, {"type": "subtitle", "time": 5833.59, "timestamp": "01:37:13", "text": "我们可能不想"}, {"type": "subtitle", "time": 5835.35, "timestamp": "01:37:15", "text": "我们自己去触摸黑色液体。它"}, {"type": "subtitle", "time": 5839.59, "timestamp": "01:37:19", "text": "看起来绝对不安全。"}, {"type": "subtitle", "time": 5840.95, "timestamp": "01:37:20", "text": "味道不太好。"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "对不起。什么？那是什么？"}, {"type": "subtitle", "time": 5845.43, "timestamp": "01:37:25", "text": "黑色液体味道不好。"}, {"type": "subtitle", "time": 5847.109, "timestamp": "01:37:27", "text": "哦。"}, {"type": "subtitle", "time": 5848.07, "timestamp": "01:37:28", "text": "好的。我要去 我要去"}, {"type": "subtitle", "time": 5850.149, "timestamp": "01:37:30", "text": "看看我旁边的尸体。"}, {"type": "subtitle", "time": 5853.03, "timestamp": "01:37:33", "text": "好的。呃，你想看看吗？"}, {"type": "subtitle", "time": 5854.629, "timestamp": "01:37:34", "text": "只是在尸体旁，还是你想……"}, {"type": "subtitle", "time": 5856.149, "timestamp": "01:37:36", "text": "透过口袋之类的？我想"}, {"type": "subtitle", "time": 5857.43, "timestamp": "01:37:37", "text": "我会搜查他们的口袋，但我不会"}, {"type": "subtitle", "time": 5858.95, "timestamp": "01:37:38", "text": "想知道，就像我想避免一样"}, {"type": "subtitle", "time": 5860.39, "timestamp": "01:37:40", "text": "接触任何黑色液体。"}, {"type": "subtitle", "time": 5864.55, "timestamp": "01:37:44", "text": "好的。好吧。好的。呃呃制作"}, {"type": "subtitle", "time": 5866.39, "timestamp": "01:37:46", "text": "调查。其实，我觉得不是。"}, {"type": "subtitle", "time": 5867.75, "timestamp": "01:37:47", "text": "没关系。就像你经历的那样"}, {"type": "subtitle", "time": 5870.229, "timestamp": "01:37:50", "text": "口袋。他们都像……"}, {"type": "subtitle", "time": 5873.91, "timestamp": "01:37:53", "text": "它们大多是空的。嗯，但是有一些"}, {"type": "subtitle", "time": 5876.31, "timestamp": "01:37:56", "text": "他们里面有很多类似即兴演奏的音符。"}, {"type": "subtitle", "time": 5877.83, "timestamp": "01:37:57", "text": "口袋。"}, {"type": "subtitle", "time": 5879.91, "timestamp": "01:37:59", "text": "哦，对了，哦，我好像忘了"}]
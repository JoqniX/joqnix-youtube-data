[{"type": "subtitle", "time": 1500.31, "timestamp": "00:25:00", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 1502.47, "timestamp": "00:25:02", "text": "活租。"}, {"type": "subtitle", "time": 1505.51, "timestamp": "00:25:05", "text": "我知道，对吧？总是每隔几个"}, {"type": "subtitle", "time": 1507.51, "timestamp": "00:25:07", "text": "几个月来，这个梗都会出现。"}, {"type": "subtitle", "time": 1508.31, "timestamp": "00:25:08", "text": "随机。"}, {"type": "subtitle", "time": 1510.87, "timestamp": "00:25:10", "text": "哦，格林现在可以动它了。我在"}, {"type": "subtitle", "time": 1512.63, "timestamp": "00:25:12", "text": "候诊室，我现在可以搬走了。"}, {"type": "subtitle", "time": 1514.07, "timestamp": "00:25:14", "text": "哦好的。你可以移动它。好的，让我"}, {"type": "subtitle", "time": 1516.39, "timestamp": "00:25:16", "text": "回到之前那个场景。激活。"}, {"type": "subtitle", "time": 1520.549, "timestamp": "00:25:20", "text": "嗯，好的。我现在要搬到这里来。"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "初音未来帽子。"}, {"type": "subtitle", "time": 1524.87, "timestamp": "00:25:24", "text": "我的天啊。"}, {"type": "subtitle", "time": 1527.909, "timestamp": "00:25:27", "text": "Miku女士。"}, {"type": "subtitle", "time": 1530.95, "timestamp": "00:25:30", "text": "哦，找到了。你现在就在这里。全部"}, {"type": "subtitle", "time": 1532.549, "timestamp": "00:25:32", "text": "正确的。我现在就把火炬还回去。"}, {"type": "subtitle", "time": 1533.43, "timestamp": "00:25:33", "text": "火炬在那里。"}, {"type": "subtitle", "time": 1536.63, "timestamp": "00:25:36", "text": "是的，你可以再次看见了。"}, {"type": "subtitle", "time": 1539.669, "timestamp": "00:25:39", "text": "我的天哪，我们有远见。我可以吗？"}, {"type": "subtitle", "time": 1542.71, "timestamp": "00:25:42", "text": "请给我一个？万一。"}, {"type": "subtitle", "time": 1543.11, "timestamp": "00:25:43", "text": "好的，"}, {"type": "subtitle", "time": 1544.87, "timestamp": "00:25:44", "text": "万一。"}, {"type": "subtitle", "time": 1548.149, "timestamp": "00:25:48", "text": "万一我输了，我就失去了爱莉安娜。"}, {"type": "subtitle", "time": 1550.39, "timestamp": "00:25:50", "text": "我被上帝蒙蔽了双眼。"}, {"type": "subtitle", "time": 1551.43, "timestamp": "00:25:51", "text": "好了。"}, {"type": "subtitle", "time": 1553.83, "timestamp": "00:25:53", "text": "被蒙蔽"}, {"type": "subtitle", "time": 1554.95, "timestamp": "00:25:54", "text": "谢谢。"}, {"type": "subtitle", "time": 1556.39, "timestamp": "00:25:56", "text": "是的，我就是那个人，我不是那个人"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "让你失明。是环境使然。"}, {"type": "subtitle", "time": 1559.35, "timestamp": "00:25:59", "text": "让你失明。"}]
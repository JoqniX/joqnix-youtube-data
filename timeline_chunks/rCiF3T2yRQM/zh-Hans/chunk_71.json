[{"type": "subtitle", "time": 4262.87, "timestamp": "01:11:02", "text": "那叫什么？他正试图"}, {"type": "subtitle", "time": 4264.149, "timestamp": "01:11:04", "text": "成为盟友。"}, {"type": "subtitle", "time": 4266.55, "timestamp": "01:11:06", "text": "他试图拉近彼此的距离。"}, {"type": "subtitle", "time": 4267.59, "timestamp": "01:11:07", "text": "试图建立联系。"}, {"type": "subtitle", "time": 4270.149, "timestamp": "01:11:10", "text": "他已经尽力了，我为他感到骄傲。"}, {"type": "subtitle", "time": 4272.95, "timestamp": "01:11:12", "text": "他的。"}, {"type": "subtitle", "time": 4274.709, "timestamp": "01:11:14", "text": "嗯，我这就去看看你的直播。"}, {"type": "subtitle", "time": 4277.189, "timestamp": "01:11:17", "text": "少量。你能不能赶紧把我的破身体挪开？"}, {"type": "subtitle", "time": 4279.43, "timestamp": "01:11:19", "text": "振作起来？谢谢。"}, {"type": "subtitle", "time": 4287.11, "timestamp": "01:11:27", "text": "有像这样的吗？所以有像这样的"}, {"type": "subtitle", "time": 4288.87, "timestamp": "01:11:28", "text": "中间那一段我们可以走。"}, {"type": "subtitle", "time": 4291.83, "timestamp": "01:11:31", "text": "进去，对吧？"}, {"type": "subtitle", "time": 4301.99, "timestamp": "01:11:41", "text": "当然可以。没关系。去。不。嗯，"}, {"type": "subtitle", "time": 4302.87, "timestamp": "01:11:42", "text": "您认为，"}, {"type": "subtitle", "time": 4304.79, "timestamp": "01:11:44", "text": "我不是说过那里有危险吗？"}, {"type": "subtitle", "time": 4307.03, "timestamp": "01:11:47", "text": "以前来过这里吗？"}, {"type": "subtitle", "time": 4309.189, "timestamp": "01:11:49", "text": "顺便说一句，那里可能有点"}, {"type": "subtitle", "time": 4310.79, "timestamp": "01:11:50", "text": "里面有一点。"}, {"type": "subtitle", "time": 4312.709, "timestamp": "01:11:52", "text": "非常适合用来提醒，这个楼层"}, {"type": "subtitle", "time": 4315.43, "timestamp": "01:11:55", "text": "这里全是血。好多血。"}, {"type": "subtitle", "time": 4316.55, "timestamp": "01:11:56", "text": "哦亲爱的。"}, {"type": "subtitle", "time": 4319.43, "timestamp": "01:11:59", "text": "哦，是门。难道他们不应该……"}]
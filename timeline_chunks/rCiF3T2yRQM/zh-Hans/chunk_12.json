[{"type": "subtitle", "time": 721.35, "timestamp": "00:12:01", "text": "应该"}, {"type": "subtitle", "time": 724.389, "timestamp": "00:12:04", "text": "我害羞，我应该有"}, {"type": "subtitle", "time": 726.389, "timestamp": "00:12:06", "text": "我不知道你想表达什么。"}, {"type": "subtitle", "time": 728.47, "timestamp": "00:12:08", "text": "我们"}, {"type": "subtitle", "time": 729.269, "timestamp": "00:12:09", "text": "翻译"}, {"type": "subtitle", "time": 732.47, "timestamp": "00:12:12", "text": "那可不好。"}, {"type": "subtitle", "time": 734.87, "timestamp": "00:12:14", "text": "我"}, {"type": "subtitle", "time": 741.67, "timestamp": "00:12:21", "text": "莲花将进行一次深入的审视"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "然后就好像他看起来没事，他们看起来也没事"}, {"type": "subtitle", "time": 748.23, "timestamp": "00:12:28", "text": "进入眼睛，进入眼睛，用他们的"}, {"type": "subtitle", "time": 750.55, "timestamp": "00:12:30", "text": "大大的眼睛，他们的大老狗钴蓝色"}, {"type": "subtitle", "time": 759.509, "timestamp": "00:12:39", "text": "钴蓝色的眼睛，像小狗一样的大眼睛"}, {"type": "subtitle", "time": 762.71, "timestamp": "00:12:42", "text": "不是小狗，伙计们。"}, {"type": "subtitle", "time": 764.949, "timestamp": "00:12:44", "text": "爱莉安娜会说：“我喜欢”"}, {"type": "subtitle", "time": 766.31, "timestamp": "00:12:46", "text": "他们。"}, {"type": "subtitle", "time": 770.79, "timestamp": "00:12:50", "text": "太可爱了。"}]
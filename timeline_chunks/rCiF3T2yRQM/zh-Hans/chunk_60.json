[{"type": "subtitle", "time": 3601.51, "timestamp": "01:00:01", "text": "他长得跟我一样。我不"}, {"type": "subtitle", "time": 3604.23, "timestamp": "01:00:04", "text": "知道。我可以掷骰子选宗教之类的吗？"}, {"type": "subtitle", "time": 3606.309, "timestamp": "01:00:06", "text": "宗教？我不认为有……我的意思是"}, {"type": "subtitle", "time": 3608.15, "timestamp": "01:00:08", "text": "你可以试试。"}, {"type": "subtitle", "time": 3611.109, "timestamp": "01:00:11", "text": "不，我可以试试。你可以试试。"}, {"type": "subtitle", "time": 3612.309, "timestamp": "01:00:12", "text": "我的天啊。"}, {"type": "subtitle", "time": 3614.15, "timestamp": "01:00:14", "text": "好的。好的。好的。好的，你是"}, {"type": "subtitle", "time": 3616.309, "timestamp": "01:00:16", "text": "尽量做到好吧"}, {"type": "subtitle", "time": 3618.71, "timestamp": "01:00:18", "text": "你知道，你知道上帝不希望任何人插手"}, {"type": "subtitle", "time": 3622.23, "timestamp": "01:00:22", "text": "参与制造了这堆垃圾。"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "一点也不自然。"}, {"type": "subtitle", "time": 3633.03, "timestamp": "01:00:33", "text": "不是雕像。"}, {"type": "subtitle", "time": 3634.789, "timestamp": "01:00:34", "text": "那座雕像呢？打钩。"}, {"type": "subtitle", "time": 3635.75, "timestamp": "01:00:35", "text": "这是什么类型的岩石？"}, {"type": "subtitle", "time": 3637.829, "timestamp": "01:00:37", "text": "你好。欢迎来到直播间。"}, {"type": "subtitle", "time": 3640.069, "timestamp": "01:00:40", "text": "请勿试图啃咬雕像。"}, {"type": "subtitle", "time": 3642.71, "timestamp": "01:00:42", "text": "吃掉雕像。"}, {"type": "subtitle", "time": 3645.43, "timestamp": "01:00:45", "text": "我们自己的情况大概会是这样的：“好吧，它"}, {"type": "subtitle", "time": 3647.27, "timestamp": "01:00:47", "text": "我用手指戳它的时候，它抽搐了一下。"}, {"type": "subtitle", "time": 3649.51, "timestamp": "01:00:49", "text": "剑。我现在可以尝试攻击它吗？"}, {"type": "subtitle", "time": 3651.67, "timestamp": "01:00:51", "text": "是的。哦，是指肉体还是雕像？"}, {"type": "subtitle", "time": 3652.63, "timestamp": "01:00:52", "text": "肉体。"}, {"type": "subtitle", "time": 3658.549, "timestamp": "01:00:58", "text": "好的。我觉得你甚至不需要"}]
[{"type": "subtitle", "time": 780.79, "timestamp": "00:13:00", "text": "我们是否要提取钴？"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "一只小虎斑猫轻拍了一下。看起来"}, {"type": "subtitle", "time": 789.59, "timestamp": "00:13:09", "text": "非常像《堡垒之夜》"}, {"type": "subtitle", "time": 792.23, "timestamp": "00:13:12", "text": "或许可以跳舞。"}, {"type": "subtitle", "time": 796.23, "timestamp": "00:13:16", "text": "只不过是个该死的堡垒之夜表情而已。"}, {"type": "subtitle", "time": 797.19, "timestamp": "00:13:17", "text": "我的天啊。"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "所以 Lotus 会说：“好吧，"}, {"type": "subtitle", "time": 813.03, "timestamp": "00:13:33", "text": "我们少了一个人，因为我们的猫"}, {"type": "subtitle", "time": 821.67, "timestamp": "00:13:41", "text": "你以前养过猫。太疯狂了。"}, {"type": "subtitle", "time": 823.99, "timestamp": "00:13:43", "text": "从未见过猫。"}, {"type": "subtitle", "time": 826.069, "timestamp": "00:13:46", "text": "我以前从没见过猫。你去了哪里？"}, {"type": "subtitle", "time": 833.19, "timestamp": "00:13:53", "text": "他们通常不是都会带猫进来吗？"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "海洋？"}, {"type": "subtitle", "time": 837.43, "timestamp": "00:13:57", "text": "不，他们带来的是蜱虫。"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "我的天啊。"}, {"type": "subtitle", "time": 839.99, "timestamp": "00:13:59", "text": "你知道吗？你有点像"}]
[{"type": "subtitle", "time": 1802.07, "timestamp": "00:30:02", "text": "我的意思是，如果我们谈论的是"}, {"type": "subtitle", "time": 1804.31, "timestamp": "00:30:04", "text": "严格来说，我理论上可以吃一个"}, {"type": "subtitle", "time": 1805.99, "timestamp": "00:30:05", "text": "岩石。"}, {"type": "subtitle", "time": 1808.23, "timestamp": "00:30:08", "text": "技术上来说。技术上来说。"}, {"type": "subtitle", "time": 1809.59, "timestamp": "00:30:09", "text": "技术上来说。是的。任何事物都是"}, {"type": "subtitle", "time": 1811.19, "timestamp": "00:30:11", "text": "理论上可食用。"}, {"type": "subtitle", "time": 1812.149, "timestamp": "00:30:12", "text": "有时仅"}, {"type": "subtitle", "time": 1814.149, "timestamp": "00:30:14", "text": "只要你努力，任何东西都能吃得下。"}, {"type": "subtitle", "time": 1815.35, "timestamp": "00:30:15", "text": "足够的。"}, {"type": "subtitle", "time": 1821.19, "timestamp": "00:30:21", "text": "尤其是对鸟类而言。"}, {"type": "subtitle", "time": 1823.83, "timestamp": "00:30:23", "text": "鸟儿们。上帝。"}, {"type": "subtitle", "time": 1825.75, "timestamp": "00:30:25", "text": "闪闪发光的石头。"}, {"type": "subtitle", "time": 1827.19, "timestamp": "00:30:27", "text": "我本来只是打算去看一下。"}, {"type": "subtitle", "time": 1829.35, "timestamp": "00:30:29", "text": "令人困惑的是，你为什么要送鸟？"}, {"type": "subtitle", "time": 1831.35, "timestamp": "00:30:31", "text": "石头？"}, {"type": "subtitle", "time": 1833.43, "timestamp": "00:30:33", "text": "因为他们在船上，而且他们"}, {"type": "subtitle", "time": 1835.669, "timestamp": "00:30:35", "text": "值得犒劳一下。"}, {"type": "subtitle", "time": 1838.95, "timestamp": "00:30:38", "text": "用石头喂船上的鸟。"}, {"type": "subtitle", "time": 1840.789, "timestamp": "00:30:40", "text": "是的，当我把石头递给他们的时候"}, {"type": "subtitle", "time": 1842.549, "timestamp": "00:30:42", "text": "它们特别闪亮，它们给了Tick"}, {"type": "subtitle", "time": 1844.549, "timestamp": "00:30:44", "text": "奖励。"}, {"type": "subtitle", "time": 1850.549, "timestamp": "00:30:50", "text": "哦，这块石头很可能是黄金做的吗？"}, {"type": "subtitle", "time": 1853.029, "timestamp": "00:30:53", "text": "或许不是。或许。所以，Tick 不"}, {"type": "subtitle", "time": 1855.19, "timestamp": "00:30:55", "text": "真的足够在意，想办法解决吗？"}, {"type": "subtitle", "time": 1855.909, "timestamp": "00:30:55", "text": "方式。"}, {"type": "subtitle", "time": 1858.149, "timestamp": "00:30:58", "text": "我认为他是在给鸟儿们钱。"}]
[{"type": "subtitle", "time": 8580.309, "timestamp": "02:23:00", "text": "随意点击进入。"}, {"type": "subtitle", "time": 8582.469, "timestamp": "02:23:02", "text": "好的。斯特凡，"}, {"type": "subtitle", "time": 8584.79, "timestamp": "02:23:04", "text": "轮到你了。"}, {"type": "subtitle", "time": 8591.67, "timestamp": "02:23:11", "text": "克里斯平，把他送回另一边"}, {"type": "subtitle", "time": 8598.309, "timestamp": "02:23:18", "text": "好的，所以我们要把克里斯放进去"}, {"type": "subtitle", "time": 8599.83, "timestamp": "02:23:19", "text": "口袋尺寸。好的，"}, {"type": "subtitle", "time": 8602.23, "timestamp": "02:23:22", "text": "我们正在加入口袋尺寸。"}, {"type": "subtitle", "time": 8604.87, "timestamp": "02:23:24", "text": "让我儿子他妈的休息一会儿吧。"}, {"type": "subtitle", "time": 8606.79, "timestamp": "02:23:26", "text": "这婊子刚才到底干了些什么鬼事？"}, {"type": "subtitle", "time": 8608.23, "timestamp": "02:23:28", "text": "去它。"}, {"type": "subtitle", "time": 8610.71, "timestamp": "02:23:30", "text": "我的天哪。"}, {"type": "subtitle", "time": 8614.389, "timestamp": "02:23:34", "text": "我能做些什么？哇。我没有"}, {"type": "subtitle", "time": 8616.63, "timestamp": "02:23:36", "text": "不会触发其他法术的法术"}, {"type": "subtitle", "time": 8619.93, "timestamp": "02:23:39", "text": "他妈的裂开了。"}, {"type": "subtitle", "time": 8621.429, "timestamp": "02:23:41", "text": "[音乐]"}, {"type": "subtitle", "time": 8623.11, "timestamp": "02:23:43", "text": "你知道吗？我直接开火"}, {"type": "subtitle", "time": 8625.27, "timestamp": "02:23:45", "text": "它。我直接开火。我一无所有"}, {"type": "subtitle", "time": 8627.11, "timestamp": "02:23:47", "text": "可以做到。"}, {"type": "subtitle", "time": 8628.71, "timestamp": "02:23:48", "text": "好的，"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "听。你知道这会非常"}, {"type": "subtitle", "time": 8639.91, "timestamp": "02:23:59", "text": "好了，击中了。野餐不需要"}]
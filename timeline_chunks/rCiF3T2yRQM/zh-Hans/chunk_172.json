[{"type": "subtitle", "time": 10320.63, "timestamp": "02:52:00", "text": "直到你的下一个回合开始。你"}, {"type": "subtitle", "time": 10322.63, "timestamp": "02:52:02", "text": "你的盟友在进攻时具有优势"}, {"type": "subtitle", "time": 10324.79, "timestamp": "02:52:04", "text": "对抗任何这些敌人时进行掷骰"}, {"type": "subtitle", "time": 10326.469, "timestamp": "02:52:06", "text": "能"}, {"type": "subtitle", "time": 10328.389, "timestamp": "02:52:08", "text": "请把它放在这里，这样我们所有人都能看到你。"}, {"type": "subtitle", "time": 10332.95, "timestamp": "02:52:12", "text": "哦，"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "我从来没想过这个问题。真他妈的"}, {"type": "subtitle", "time": 10337.67, "timestamp": "02:52:17", "text": "这里有果冻吗？"}, {"type": "subtitle", "time": 10339.75, "timestamp": "02:52:19", "text": "说得对。我不这么认为，因为"}, {"type": "subtitle", "time": 10342.71, "timestamp": "02:52:22", "text": "他们依靠的是盲感。等等。"}, {"type": "subtitle", "time": 10344.71, "timestamp": "02:52:24", "text": "我不认为他们，我从来没有真正"}, {"type": "subtitle", "time": 10345.429, "timestamp": "02:52:25", "text": "我考虑过这个问题。"}, {"type": "subtitle", "time": 10347.349, "timestamp": "02:52:27", "text": "是的。是的。是的。他们免疫"}, {"type": "subtitle", "time": 10351.429, "timestamp": "02:52:31", "text": "实际上是震聋。所以他们听不见。"}, {"type": "subtitle", "time": 10351.83, "timestamp": "02:52:31", "text": "是的。"}, {"type": "subtitle", "time": 10354.71, "timestamp": "02:52:34", "text": "所以这实际上"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "哦，是的。是的，他们是，他们是"}, {"type": "subtitle", "time": 10362.86, "timestamp": "02:52:42", "text": "我想"}, {"type": "subtitle", "time": 10364.63, "timestamp": "02:52:44", "text": "[音乐]"}, {"type": "subtitle", "time": 10366.469, "timestamp": "02:52:46", "text": "Twitch 上有人说要吃掉它们。哦，别这样"}, {"type": "subtitle", "time": 10368.07, "timestamp": "02:52:48", "text": "担心。蜱虫已经开始吃东西了"}, {"type": "subtitle", "time": 10368.79, "timestamp": "02:52:48", "text": "史莱姆。"}, {"type": "subtitle", "time": 10371.429, "timestamp": "02:52:51", "text": "Tick 已经一直在做了。"}, {"type": "subtitle", "time": 10373.75, "timestamp": "02:52:53", "text": "你来晚了。我们没有"}, {"type": "subtitle", "time": 10377.51, "timestamp": "02:52:57", "text": "成功阻止了他这样做。"}, {"type": "subtitle", "time": 10378.71, "timestamp": "02:52:58", "text": "已经到了。"}]
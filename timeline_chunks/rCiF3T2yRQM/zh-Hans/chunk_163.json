[{"type": "subtitle", "time": 9780.87, "timestamp": "02:43:00", "text": "放在这里或者移到其他地方。"}, {"type": "subtitle", "time": 9782.95, "timestamp": "02:43:02", "text": "拜托拜托，把月光移开吧。"}, {"type": "subtitle", "time": 9785.51, "timestamp": "02:43:05", "text": "呃，我想把它挪走。是的，"}, {"type": "subtitle", "time": 9786.23, "timestamp": "02:43:06", "text": "请。"}, {"type": "subtitle", "time": 9787.91, "timestamp": "02:43:07", "text": "离这很远。离这很远。据，直到...为止"}, {"type": "subtitle", "time": 9789.51, "timestamp": "02:43:09", "text": "好的。你能把月亮移动多远？"}, {"type": "subtitle", "time": 9791.67, "timestamp": "02:43:11", "text": "光束？实际上，最大值是多少来着？我"}, {"type": "subtitle", "time": 9794.389, "timestamp": "02:43:14", "text": "忘了。"}, {"type": "subtitle", "time": 9796.389, "timestamp": "02:43:16", "text": "最远可达 60 英尺。这其实相当远了。"}, {"type": "subtitle", "time": 9797.99, "timestamp": "02:43:17", "text": "我先把它放在这里。你可以"}, {"type": "subtitle", "time": 9799.99, "timestamp": "02:43:19", "text": "如果你愿意，可以把它移到别的地方。"}, {"type": "subtitle", "time": 9800.79, "timestamp": "02:43:20", "text": "好的。"}, {"type": "subtitle", "time": 9803.27, "timestamp": "02:43:23", "text": "嗯，这样可行。是的，那个"}, {"type": "subtitle", "time": 9806.15, "timestamp": "02:43:26", "text": "地板慢慢地，就像……"}, {"type": "subtitle", "time": 9807.99, "timestamp": "02:43:27", "text": "看起来有点像传送带。"}, {"type": "subtitle", "time": 9810.07, "timestamp": "02:43:30", "text": "你正在缓慢前进。"}, {"type": "subtitle", "time": 9812.79, "timestamp": "02:43:32", "text": "嗯，它可以沾上一些粘液。"}, {"type": "subtitle", "time": 9815.11, "timestamp": "02:43:35", "text": "史莱姆，而且特别是指"}, {"type": "subtitle", "time": 9816.63, "timestamp": "02:43:36", "text": "其中一个试图攻击他们，而且是"}, {"type": "subtitle", "time": 9819.03, "timestamp": "02:43:39", "text": "吃掉它是为了彰显统治地位。"}, {"type": "subtitle", "time": 9821.59, "timestamp": "02:43:41", "text": "好的。好的。你把它吃掉。"}, {"type": "subtitle", "time": 9823.429, "timestamp": "02:43:43", "text": "这下可糟了。"}, {"type": "subtitle", "time": 9825.11, "timestamp": "02:43:45", "text": "这个这个这个这个，就有点……"}, {"type": "subtitle", "time": 9827.11, "timestamp": "02:43:47", "text": "尝起来像柠檬"}, {"type": "subtitle", "time": 9829.67, "timestamp": "02:43:49", "text": "柠檬果冻。"}, {"type": "subtitle", "time": 9832.469, "timestamp": "02:43:52", "text": "它会继续吃掉它们。"}]
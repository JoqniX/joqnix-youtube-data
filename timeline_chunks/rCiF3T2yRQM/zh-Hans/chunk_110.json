[{"type": "subtitle", "time": 6600.47, "timestamp": "01:50:00", "text": "对生物而言。忽略已经发生的事情"}, {"type": "subtitle", "time": 6604.07, "timestamp": "01:50:04", "text": "Tick 就像完全忘记了一样。"}, {"type": "subtitle", "time": 6607.51, "timestamp": "01:50:07", "text": "我爱这座雕像。但这有可能吗？"}, {"type": "subtitle", "time": 6610.629, "timestamp": "01:50:10", "text": "地牢还活着，我们就像要进去一样"}, {"type": "subtitle", "time": 6614.07, "timestamp": "01:50:14", "text": "放进它的胃里？"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "哦，是的，每个人都选择了成为"}, {"type": "subtitle", "time": 6617.43, "timestamp": "01:50:17", "text": "喜欢"}, {"type": "subtitle", "time": 6619.109, "timestamp": "01:50:19", "text": "顺便一提，说到这个，还有……"}, {"type": "subtitle", "time": 6621.75, "timestamp": "01:50:21", "text": "就像整个地牢一样，因为"}, {"type": "subtitle", "time": 6623.59, "timestamp": "01:50:23", "text": "这个地牢有好几层，对吧？"}, {"type": "subtitle", "time": 6626.47, "timestamp": "01:50:26", "text": "这个地牢好像有好几层。"}, {"type": "subtitle", "time": 6628.47, "timestamp": "01:50:28", "text": "呃，这个地牢是有主题的，"}, {"type": "subtitle", "time": 6630.39, "timestamp": "01:50:30", "text": "每层楼都有一个主题。如果你能猜到的话"}, {"type": "subtitle", "time": 6633.75, "timestamp": "01:50:33", "text": "主题，呃，你会从中获得灵感。"}, {"type": "subtitle", "time": 6636.47, "timestamp": "01:50:36", "text": "我还记得，我还记得SLA"}, {"type": "subtitle", "time": 6639.109, "timestamp": "01:50:39", "text": "就像你私信我，猜猜看。"}, {"type": "subtitle", "time": 6640.55, "timestamp": "01:50:40", "text": "你想接受那个已故的猜测吗？"}, {"type": "subtitle", "time": 6642.79, "timestamp": "01:50:42", "text": "每人每次游戏只有一次猜测机会。"}, {"type": "subtitle", "time": 6644.55, "timestamp": "01:50:44", "text": "我暂时保留我的猜测。"}, {"type": "subtitle", "time": 6645.109, "timestamp": "01:50:45", "text": "现在。"}, {"type": "subtitle", "time": 6646.629, "timestamp": "01:50:46", "text": "好的。每次游戏限猜一次。请随意"}, {"type": "subtitle", "time": 6648.31, "timestamp": "01:50:48", "text": "你想猜就猜吧。"}, {"type": "subtitle", "time": 6649.91, "timestamp": "01:50:49", "text": "正确的？情况会像这样，不是吗？"}, {"type": "subtitle", "time": 6650.709, "timestamp": "01:50:50", "text": "动动脑子。"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "我这就去再拿一个黑色的"}, {"type": "subtitle", "time": 6653.669, "timestamp": "01:50:53", "text": "液体。"}, {"type": "subtitle", "time": 6654.709, "timestamp": "01:50:54", "text": "好的。"}, {"type": "subtitle", "time": 6657.109, "timestamp": "01:50:57", "text": "就从这个拐角处测试一下"}]
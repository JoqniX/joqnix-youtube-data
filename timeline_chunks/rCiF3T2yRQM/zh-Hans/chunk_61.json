[{"type": "subtitle", "time": 3660.789, "timestamp": "01:01:00", "text": "做个卷。呃，你试着像切片一样。"}, {"type": "subtitle", "time": 3663.99, "timestamp": "01:01:03", "text": "它。它就像喷出来一样。"}, {"type": "subtitle", "time": 3665.829, "timestamp": "01:01:05", "text": "你惹上了麻烦，但这挺好的。"}, {"type": "subtitle", "time": 3674.15, "timestamp": "01:01:14", "text": "你以为我当时想把你抢走吗？"}, {"type": "subtitle", "time": 3674.63, "timestamp": "01:01:14", "text": "什么？"}, {"type": "subtitle", "time": 3676.069, "timestamp": "01:01:16", "text": "好了，我这就把它擦掉。"}, {"type": "subtitle", "time": 3677.67, "timestamp": "01:01:17", "text": "就像在地面上一样。"}, {"type": "subtitle", "time": 3680.47, "timestamp": "01:01:20", "text": "没关系。操得真烂，洗干净了"}, {"type": "subtitle", "time": 3682.87, "timestamp": "01:01:22", "text": "喜欢"}, {"type": "subtitle", "time": 3683.51, "timestamp": "01:01:23", "text": "现在。"}, {"type": "subtitle", "time": 3685.27, "timestamp": "01:01:25", "text": "哦，让我来揭晓答案。在那里"}, {"type": "subtitle", "time": 3687.829, "timestamp": "01:01:27", "text": "去。按下编辑键。"}, {"type": "subtitle", "time": 3688.71, "timestamp": "01:01:28", "text": "好的。"}, {"type": "subtitle", "time": 3690.63, "timestamp": "01:01:30", "text": "Tick说了什么吗？那是什么？"}, {"type": "subtitle", "time": 3692.63, "timestamp": "01:01:32", "text": "哦，Tick就像试图吞噬一样。"}, {"type": "subtitle", "time": 3693.91, "timestamp": "01:01:33", "text": "雕像。"}, {"type": "subtitle", "time": 3696.95, "timestamp": "01:01:36", "text": "好的。好的。你试着咬，你试着咬"}, {"type": "subtitle", "time": 3699.51, "timestamp": "01:01:39", "text": "就像雕像的一部分，但是当"}, {"type": "subtitle", "time": 3701.75, "timestamp": "01:01:41", "text": "咬下去的时候，一开始感觉像石头一样。"}, {"type": "subtitle", "time": 3703.67, "timestamp": "01:01:43", "text": "你知道外面是岩石，"}, {"type": "subtitle", "time": 3705.99, "timestamp": "01:01:45", "text": "但你越深入，这种感觉就越强烈。"}, {"type": "subtitle", "time": 3711.67, "timestamp": "01:01:51", "text": "确保他们喜欢。那不是"}, {"type": "subtitle", "time": 3714.309, "timestamp": "01:01:54", "text": "普通的岩石味道。"}, {"type": "subtitle", "time": 3716.549, "timestamp": "01:01:56", "text": "这会导致感觉方面的问题。"}, {"type": "subtitle", "time": 3718.87, "timestamp": "01:01:58", "text": "外皮酥脆，内里多汁"}]
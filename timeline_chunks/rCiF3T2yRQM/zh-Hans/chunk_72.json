[{"type": "subtitle", "time": 4322.63, "timestamp": "01:12:02", "text": "我的天啊。我的天啊。我的天啊。"}, {"type": "subtitle", "time": 4325.27, "timestamp": "01:12:05", "text": "我们有办法提升自己。我"}, {"type": "subtitle", "time": 4327.83, "timestamp": "01:12:07", "text": "我再也不需要性了。"}, {"type": "subtitle", "time": 4331.99, "timestamp": "01:12:11", "text": "这是在调情。"}, {"type": "subtitle", "time": 4334.07, "timestamp": "01:12:14", "text": "是的。"}, {"type": "subtitle", "time": 4336.87, "timestamp": "01:12:16", "text": "我可以画个像……一样的东西吗？"}, {"type": "subtitle", "time": 4340.07, "timestamp": "01:12:20", "text": "这里是浮动圆盘，所以"}, {"type": "subtitle", "time": 4346.07, "timestamp": "01:12:26", "text": "真有意思。"}, {"type": "subtitle", "time": 4348.709, "timestamp": "01:12:28", "text": "真搞笑。我们走吧。我的天哪，我爱"}, {"type": "subtitle", "time": 4351.51, "timestamp": "01:12:31", "text": "那意义非凡。"}, {"type": "subtitle", "time": 4353.59, "timestamp": "01:12:33", "text": "好的，"}, {"type": "subtitle", "time": 4355.75, "timestamp": "01:12:35", "text": "你变出一张圆盘。"}, {"type": "subtitle", "time": 4357.75, "timestamp": "01:12:37", "text": "我变出一张圆盘。"}, {"type": "subtitle", "time": 4358.55, "timestamp": "01:12:38", "text": "当然。"}, {"type": "subtitle", "time": 4360.31, "timestamp": "01:12:40", "text": "准备跳上光盘。"}, {"type": "subtitle", "time": 4361.189, "timestamp": "01:12:41", "text": "是的。"}, {"type": "subtitle", "time": 4363.27, "timestamp": "01:12:43", "text": "所以，我们可以踩上去，然后"}, {"type": "subtitle", "time": 4367.51, "timestamp": "01:12:47", "text": "操他妈的胸膛，然后滚出这里。"}, {"type": "subtitle", "time": 4369.27, "timestamp": "01:12:49", "text": "好的。"}, {"type": "subtitle", "time": 4373.99, "timestamp": "01:12:53", "text": "不过，我希望你能像……"}, {"type": "subtitle", "time": 4376.39, "timestamp": "01:12:56", "text": "小型杂技。它很漂亮"}, {"type": "subtitle", "time": 4378.229, "timestamp": "01:12:58", "text": "直流电压很低，但电压也很小。我"}]
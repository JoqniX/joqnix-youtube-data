[{"type": "subtitle", "time": 7024.95, "timestamp": "01:57:04", "text": "我们仍然占据高地。"}, {"type": "subtitle", "time": 7027.109, "timestamp": "01:57:07", "text": "你知道吗？因此，我们……"}, {"type": "subtitle", "time": 7029.189, "timestamp": "01:57:09", "text": "去肉体房间。"}, {"type": "subtitle", "time": 7030.149, "timestamp": "01:57:10", "text": "好的。"}, {"type": "subtitle", "time": 7032.07, "timestamp": "01:57:12", "text": "耶。肉体房间。"}, {"type": "subtitle", "time": 7033.109, "timestamp": "01:57:13", "text": "去肉体房间。"}, {"type": "subtitle", "time": 7035.51, "timestamp": "01:57:15", "text": "我不喜欢肉体展示室，但我认为"}, {"type": "subtitle", "time": 7038.31, "timestamp": "01:57:18", "text": "我最好还是通过肉体。"}, {"type": "subtitle", "time": 7041.51, "timestamp": "01:57:21", "text": "比起回去，有房间更方便。"}, {"type": "subtitle", "time": 7045.189, "timestamp": "01:57:25", "text": "看到疑似复活的生物"}, {"type": "subtitle", "time": 7048.07, "timestamp": "01:57:28", "text": "趁我们处于劣势时试图攻击我们。"}, {"type": "subtitle", "time": 7051.109, "timestamp": "01:57:31", "text": "我只是对此感到好奇。我希望"}, {"type": "subtitle", "time": 7053.109, "timestamp": "01:57:33", "text": "不，不，不，不，不。我不是"}, {"type": "subtitle", "time": 7054.709, "timestamp": "01:57:34", "text": "前往"}, {"type": "subtitle", "time": 7056.629, "timestamp": "01:57:36", "text": "你希望发生点什么。好的。全部"}, {"type": "subtitle", "time": 7058.31, "timestamp": "01:57:38", "text": "正确的。我会确保"}, {"type": "subtitle", "time": 7059.75, "timestamp": "01:57:39", "text": "我会确保这件事发生。"}, {"type": "subtitle", "time": 7061.27, "timestamp": "01:57:41", "text": "好的。我这就走一步"}, {"type": "subtitle", "time": 7062.629, "timestamp": "01:57:42", "text": "她会进来。"}, {"type": "subtitle", "time": 7064.47, "timestamp": "01:57:44", "text": "我不是派对上的那个一本正经的人。"}, {"type": "subtitle", "time": 7066.229, "timestamp": "01:57:46", "text": "如果我不是派对上的正经人，"}, {"type": "subtitle", "time": 7068.629, "timestamp": "01:57:48", "text": "我他妈的会这么做。"}, {"type": "subtitle", "time": 7070.149, "timestamp": "01:57:50", "text": "我他妈的会把它放出去。幸运的是，"}, {"type": "subtitle", "time": 7073.189, "timestamp": "01:57:53", "text": "我是派对上的捧哏。"}, {"type": "subtitle", "time": 7074.47, "timestamp": "01:57:54", "text": "肉体。"}, {"type": "subtitle", "time": 7077.51, "timestamp": "01:57:57", "text": "它软绵绵的。它软绵绵的。你知道"}]
[{"type": "subtitle", "time": 1921.269, "timestamp": "00:32:01", "text": "你知道，拥有任何垄断权。"}, {"type": "subtitle", "time": 1923.269, "timestamp": "00:32:03", "text": "然而，你垄断了Tick's"}, {"type": "subtitle", "time": 1925.99, "timestamp": "00:32:05", "text": "心。"}, {"type": "subtitle", "time": 1927.509, "timestamp": "00:32:07", "text": "一个"}, {"type": "subtitle", "time": 1935.11, "timestamp": "00:32:15", "text": "喜欢"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "会想：“我们能留下他吗？”"}, {"type": "subtitle", "time": 1938.95, "timestamp": "00:32:18", "text": "Van 和 Lotus 都是如此。他只是她"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "会想：“我们能留下他吗？”"}, {"type": "subtitle", "time": 1944.71, "timestamp": "00:32:24", "text": "我的天啊。我话不多。"}, {"type": "subtitle", "time": 1947.11, "timestamp": "00:32:27", "text": "即使我们说不。你要去吗？"}, {"type": "subtitle", "time": 1948.47, "timestamp": "00:32:28", "text": "你要说什么？"}, {"type": "subtitle", "time": 1952.95, "timestamp": "00:32:32", "text": "那是卡斯特吗？"}, {"type": "subtitle", "time": 1954.389, "timestamp": "00:32:34", "text": "谢谢你提醒我多喝水。"}, {"type": "subtitle", "time": 1956.87, "timestamp": "00:32:36", "text": "我觉得爱莉安娜要走了"}, {"type": "subtitle", "time": 1959.99, "timestamp": "00:32:39", "text": "我们俩说什么"}, {"type": "subtitle", "time": 1961.99, "timestamp": "00:32:41", "text": "极致脱水。每个人"}, {"type": "subtitle", "time": 1964.23, "timestamp": "00:32:44", "text": "喝点水。"}, {"type": "subtitle", "time": 1966.87, "timestamp": "00:32:46", "text": "她现在似乎感情很稳定。"}, {"type": "subtitle", "time": 1968.87, "timestamp": "00:32:48", "text": "那是热水。我的天哪，我刚刚"}, {"type": "subtitle", "time": 1971.909, "timestamp": "00:32:51", "text": "嘴唇被烧伤了。"}, {"type": "subtitle", "time": 1973.029, "timestamp": "00:32:53", "text": "如果他死了。"}, {"type": "subtitle", "time": 1977.269, "timestamp": "00:32:57", "text": "H，那就是，那就是，那就是我们所说的"}, {"type": "subtitle", "time": 1979.83, "timestamp": "00:32:59", "text": "这是一个危险信号。我"}]
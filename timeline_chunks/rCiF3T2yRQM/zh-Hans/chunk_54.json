[{"type": "subtitle", "time": 3241.27, "timestamp": "00:54:01", "text": "你知道，这个地方很漂亮，就像……"}, {"type": "subtitle", "time": 3243.75, "timestamp": "00:54:03", "text": "这里什么也没有。这里很干净。它"}, {"type": "subtitle", "time": 3246.309, "timestamp": "00:54:06", "text": "似乎发生了流血事件或污秽事件。"}, {"type": "subtitle", "time": 3249.67, "timestamp": "00:54:09", "text": "不管你怎么看待这件事，它就是一坨屎。"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "之前打了一场仗，不过现在挺好的。"}, {"type": "subtitle", "time": 3253.75, "timestamp": "00:54:13", "text": "干净的。"}, {"type": "subtitle", "time": 3256.309, "timestamp": "00:54:16", "text": "我猜这就是史莱姆。"}, {"type": "subtitle", "time": 3258.069, "timestamp": "00:54:18", "text": "他们谈论的那个房间"}, {"type": "subtitle", "time": 3260.39, "timestamp": "00:54:20", "text": "不久前。"}, {"type": "chat", "time": 3261.245, "timestamp": "00:54:21", "author": "@KripalNishad-ze8rb", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nINduFEoqdR9Ur9aH5Wjyys_h6Cvr5JLOUK2d9YuckXV4H-eJ2TUNvqVabpPDyQcaEZw=s64-c-k-c0x00ffffff-no-rj", "message": "❤"}, {"type": "subtitle", "time": 3264.309, "timestamp": "00:54:24", "text": "味道好极了。尝起来像青柠。"}, {"type": "chat", "time": 3264.454, "timestamp": "00:54:24", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Kripal Nishad~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 3267.51, "timestamp": "00:54:27", "text": "感谢科技部门的鼎力支持！"}, {"type": "subtitle", "time": 3276.87, "timestamp": "00:54:36", "text": "嗯，有条路，对吧？"}, {"type": "subtitle", "time": 3278.23, "timestamp": "00:54:38", "text": "这里。"}, {"type": "subtitle", "time": 3283.43, "timestamp": "00:54:43", "text": "我只是随便看看。对不起，"}, {"type": "subtitle", "time": 3284.069, "timestamp": "00:54:44", "text": "她来了。"}, {"type": "subtitle", "time": 3285.43, "timestamp": "00:54:45", "text": "你确定你在找东西吗？还是你在找别的东西？"}, {"type": "subtitle", "time": 3288.309, "timestamp": "00:54:48", "text": "试图找到另一种史莱姆来尝试"}, {"type": "subtitle", "time": 3289.99, "timestamp": "00:54:49", "text": "不，"}, {"type": "subtitle", "time": 3292.069, "timestamp": "00:54:52", "text": "她要，她要继续前进。"}, {"type": "subtitle", "time": 3294.15, "timestamp": "00:54:54", "text": "快速地。"}, {"type": "subtitle", "time": 3295.91, "timestamp": "00:54:55", "text": "我的天哪。好的。是的。"}, {"type": "subtitle", "time": 3296.71, "timestamp": "00:54:56", "text": "你还好吗？"}, {"type": "subtitle", "time": 3298.309, "timestamp": "00:54:58", "text": "在这个房间里。是的。"}]
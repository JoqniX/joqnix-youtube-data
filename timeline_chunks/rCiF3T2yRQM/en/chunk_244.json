[{"type": "subtitle", "time": 14643.429, "timestamp": "04:04:03", "text": ">> Oh,"}, {"type": "subtitle", "time": 14651.59, "timestamp": "04:04:11", "text": "God. Turns out it was my dad. Turns out"}, {"type": "subtitle", "time": 14653.349, "timestamp": "04:04:13", "text": "it was my uncle. Turns out it was my"}, {"type": "subtitle", "time": 14655.11, "timestamp": "04:04:15", "text": "grandpa."}, {"type": "subtitle", "time": 14656.15, "timestamp": "04:04:16", "text": ">> Oh no."}, {"type": "subtitle", "time": 14657.59, "timestamp": "04:04:17", "text": ">> Psychic damage."}, {"type": "subtitle", "time": 14662.469, "timestamp": "04:04:22", "text": ">> On you. Nick's too confused to take"}, {"type": "subtitle", "time": 14663.82, "timestamp": "04:04:23", "text": "that."}, {"type": "subtitle", "time": 14665.59, "timestamp": "04:04:25", "text": "[Music]"}, {"type": "subtitle", "time": 14668.469, "timestamp": "04:04:28", "text": ">> Here. Come over here."}, {"type": "subtitle", "time": 14670.15, "timestamp": "04:04:30", "text": ">> Just going to move with the flow here."}, {"type": "subtitle", "time": 14672.63, "timestamp": "04:04:32", "text": ">> Is just riding the wave."}, {"type": "subtitle", "time": 14674.389, "timestamp": "04:04:34", "text": "Oh, when the pig's just enjoying the"}, {"type": "subtitle", "time": 14680.389, "timestamp": "04:04:40", "text": ">> I'm home. I'm back for more."}, {"type": "subtitle", "time": 14682.07, "timestamp": "04:04:42", "text": ">> I get so much slime."}, {"type": "subtitle", "time": 14685.269, "timestamp": "04:04:45", "text": ">> Can you try to actually be useful now?"}, {"type": "subtitle", "time": 14687.429, "timestamp": "04:04:47", "text": ">> No."}, {"type": "subtitle", "time": 14693.269, "timestamp": "04:04:53", "text": ">> Talk back to me."}, {"type": "subtitle", "time": 14694.87, "timestamp": "04:04:54", "text": ">> Talking back to you this whole time."}, {"type": "subtitle", "time": 14698.63, "timestamp": "04:04:58", "text": "That's kind of how conversations work."}, {"type": "subtitle", "time": 14699.67, "timestamp": "04:04:59", "text": ">> You know what? Fair enough."}]
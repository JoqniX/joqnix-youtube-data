[{"type": "subtitle", "time": 11281.03, "timestamp": "03:08:01", "text": "確認するために"}, {"type": "subtitle", "time": 11283.19, "timestamp": "03:08:03", "text": "あなたは動かないように努める。うん。安定させる"}, {"type": "subtitle", "time": 11285.269, "timestamp": "03:08:05", "text": "あなた自身。よし。"}, {"type": "subtitle", "time": 11287.349, "timestamp": "03:08:07", "text": "他に何か？そうでない場合は、入力してください。"}, {"type": "subtitle", "time": 11289.91, "timestamp": "03:08:09", "text": "わかった。そして、"}, {"type": "subtitle", "time": 11291.429, "timestamp": "03:08:11", "text": "うっかり蹴ってしまったことに今気づいた"}, {"type": "subtitle", "time": 11292.79, "timestamp": "03:08:12", "text": "この人たちは主体性がない。"}, {"type": "subtitle", "time": 11294.71, "timestamp": "03:08:14", "text": "すぐにリロールさせてください。それは"}, {"type": "subtitle", "time": 11296.79, "timestamp": "03:08:16", "text": "4つ。追加して入れます"}, {"type": "subtitle", "time": 11300.469, "timestamp": "03:08:20", "text": "4人として。ええと、4のはずです。"}, {"type": "subtitle", "time": 11301.99, "timestamp": "03:08:21", "text": "まあ、そうですね。わかった。そこには。次はあなたの番です。"}, {"type": "subtitle", "time": 11306.75, "timestamp": "03:08:26", "text": "こんにちは、タキス。申し訳ありませんが、"}, {"type": "subtitle", "time": 11308.15, "timestamp": "03:08:28", "text": "[音楽]"}, {"type": "subtitle", "time": 11312.15, "timestamp": "03:08:32", "text": "あなたは、このように約10フィートのところが好きです"}, {"type": "subtitle", "time": 11312.63, "timestamp": "03:08:32", "text": "その物。"}, {"type": "subtitle", "time": 11313.83, "timestamp": "03:08:33", "text": "ほら、私たちみんなが結局は"}, {"type": "subtitle", "time": 11318.15, "timestamp": "03:08:38", "text": "そのブーツを履いて、ベイビー。それが人生だ。"}, {"type": "subtitle", "time": 11324.469, "timestamp": "03:08:44", "text": "ダメージ。"}, {"type": "subtitle", "time": 11327.269, "timestamp": "03:08:47", "text": "彼女は私たちに火のドラゴンをくれるつもりだ"}, {"type": "subtitle", "time": 11329.67, "timestamp": "03:08:49", "text": "男に任せる。"}, {"type": "subtitle", "time": 11333.19, "timestamp": "03:08:53", "text": "一体どういうことだ？カリカリに焼く"}, {"type": "subtitle", "time": 11335.11, "timestamp": "03:08:55", "text": "実は。うん、いい指摘だね。"}, {"type": "subtitle", "time": 11338.469, "timestamp": "03:08:58", "text": "カリッと焼き上げてください。私に触れないで。"}]
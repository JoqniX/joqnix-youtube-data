[{"type": "subtitle", "time": 8100.95, "timestamp": "02:15:00", "text": "それらを切り分けるのは良くない。"}, {"type": "subtitle", "time": 8104.47, "timestamp": "02:15:04", "text": "よし。ええ、助けてもらいました。"}, {"type": "subtitle", "time": 8106.39, "timestamp": "02:15:06", "text": "もし私たちがこう考えたら"}, {"type": "subtitle", "time": 8109.27, "timestamp": "02:15:09", "text": "それらを再び一緒に太字にすることはできますか？は"}, {"type": "subtitle", "time": 8111.99, "timestamp": "02:15:11", "text": "それはオプションですか？"}, {"type": "subtitle", "time": 8114.47, "timestamp": "02:15:14", "text": "えーと、魔法使いみたいなのがいるなら、"}, {"type": "subtitle", "time": 8117.43, "timestamp": "02:15:17", "text": "実際にそれを試させてくれます。"}, {"type": "subtitle", "time": 8119.189, "timestamp": "02:15:19", "text": "それはすごく面白いですね。私はちょっとそうしたい"}, {"type": "subtitle", "time": 8120.629, "timestamp": "02:15:20", "text": "あなたにそうさせる。"}, {"type": "subtitle", "time": 8123.91, "timestamp": "02:15:23", "text": "修理してください。修理してください。あなたを"}, {"type": "subtitle", "time": 8125.43, "timestamp": "02:15:25", "text": "再び一緒になった。"}, {"type": "subtitle", "time": 8130.229, "timestamp": "02:15:30", "text": "何てことだ。わかりました、今回は見送ります。"}, {"type": "subtitle", "time": 8132.069, "timestamp": "02:15:32", "text": "私には他にできることは何もない、"}, {"type": "subtitle", "time": 8132.39, "timestamp": "02:15:32", "text": "考えるな。"}, {"type": "subtitle", "time": 8134.79, "timestamp": "02:15:34", "text": "なんてこった。"}, {"type": "subtitle", "time": 8148.31, "timestamp": "02:15:48", "text": "次は私の番です。ごめんなさい。私はそれは"}, {"type": "subtitle", "time": 8149.99, "timestamp": "02:15:49", "text": "わかった。"}, {"type": "subtitle", "time": 8155.03, "timestamp": "02:15:55", "text": "M. では、月の光を使いたいと思います。"}, {"type": "subtitle", "time": 8158.709, "timestamp": "02:15:58", "text": "わかった。ああ、それは私にも響くだろう。"}]
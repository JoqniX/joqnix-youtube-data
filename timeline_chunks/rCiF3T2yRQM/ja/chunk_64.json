[{"type": "subtitle", "time": 3842.069, "timestamp": "01:04:02", "text": "胸に矢を射ってもいいですか？"}, {"type": "subtitle", "time": 3845.27, "timestamp": "01:04:05", "text": "ええ、どうぞご自由に。わかりました、お見せします。"}, {"type": "subtitle", "time": 3847.67, "timestamp": "01:04:07", "text": "はい、どうぞ。うん。えっと、ただ転がすだけ"}, {"type": "subtitle", "time": 3849.109, "timestamp": "01:04:09", "text": "ダメージ。"}, {"type": "subtitle", "time": 3850.23, "timestamp": "01:04:10", "text": "ああ、ただダメージを振ればいいんだ。"}, {"type": "subtitle", "time": 3851.75, "timestamp": "01:04:11", "text": "うん、ダメージロールをすればいいよ。これは"}, {"type": "subtitle", "time": 3853.19, "timestamp": "01:04:13", "text": "静止した標的。できると思います"}, {"type": "subtitle", "time": 3854.47, "timestamp": "01:04:14", "text": "それを達成するのはかなり簡単だった。"}, {"type": "subtitle", "time": 3857.19, "timestamp": "01:04:17", "text": "わかった。ロールダメージ。"}, {"type": "subtitle", "time": 3860.549, "timestamp": "01:04:20", "text": "よし。ああ、わかりました。えっと、"}, {"type": "subtitle", "time": 3862.71, "timestamp": "01:04:22", "text": "うん、"}, {"type": "subtitle", "time": 3871.349, "timestamp": "01:04:31", "text": "君のことをとても誇りに思うよ。大切なのは、あなた自身です。"}, {"type": "subtitle", "time": 3873.27, "timestamp": "01:04:33", "text": "あなたはとてもよくやった。"}, {"type": "subtitle", "time": 3875.109, "timestamp": "01:04:35", "text": "ありがとう、ティック。"}, {"type": "subtitle", "time": 3876.87, "timestamp": "01:04:36", "text": "撫でてあげようと思って"}, {"type": "subtitle", "time": 3879.51, "timestamp": "01:04:39", "text": "頭に。"}, {"type": "subtitle", "time": 3881.99, "timestamp": "01:04:41", "text": "あなたも攻撃してみてください。"}, {"type": "subtitle", "time": 3883.43, "timestamp": "01:04:43", "text": "わかった。よし。"}, {"type": "subtitle", "time": 3886.069, "timestamp": "01:04:46", "text": "なぜ私はいつも盲目将軍になってしまうのでしょうか？"}, {"type": "subtitle", "time": 3887.67, "timestamp": "01:04:47", "text": "そうそう。うん。設定するだけで"}, {"type": "subtitle", "time": 3889.43, "timestamp": "01:04:49", "text": "普通だから、私はただ明らかにし続けるしかない"}, {"type": "subtitle", "time": 3890.71, "timestamp": "01:04:50", "text": "それ。"}, {"type": "subtitle", "time": 3894.87, "timestamp": "01:04:54", "text": "公平。わかった。六。えっと、あなたが"}, {"type": "subtitle", "time": 3898.47, "timestamp": "01:04:58", "text": "胸が開いて見える"}]
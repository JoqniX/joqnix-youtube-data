[{"type": "subtitle", "time": 6360.87, "timestamp": "01:46:00", "text": "もうここにはいらない。君はそうするだろうけど"}, {"type": "subtitle", "time": 6364.229, "timestamp": "01:46:04", "text": "壁がそうではないことに気づいてください"}, {"type": "subtitle", "time": 6367.59, "timestamp": "01:46:07", "text": "壁は均一ではない。そしてあなたが"}, {"type": "subtitle", "time": 6369.91, "timestamp": "01:46:09", "text": "なぜそうなるのかを話し合うには、"}, {"type": "subtitle", "time": 6372.629, "timestamp": "01:46:12", "text": "バーの部屋。それでは、すぐ戻ります。"}, {"type": "subtitle", "time": 6373.99, "timestamp": "01:46:13", "text": "わかった。"}, {"type": "subtitle", "time": 6375.51, "timestamp": "01:46:15", "text": "完璧。"}, {"type": "subtitle", "time": 6376.55, "timestamp": "01:46:16", "text": "うん。"}, {"type": "subtitle", "time": 6379.43, "timestamp": "01:46:19", "text": "いいえ、私はただ「はい、完璧です」と言うだけです。私たちはできる"}, {"type": "subtitle", "time": 6381.59, "timestamp": "01:46:21", "text": "壁は均一ではない。"}, {"type": "subtitle", "time": 6387.59, "timestamp": "01:46:27", "text": "それはどういう意味ですか？壁には何がありますか？"}, {"type": "subtitle", "time": 6390.07, "timestamp": "01:46:30", "text": "私たちが知らないこと？"}, {"type": "subtitle", "time": 6392.47, "timestamp": "01:46:32", "text": "それはつまり、壁がないということです"}, {"type": "subtitle", "time": 6395.27, "timestamp": "01:46:35", "text": "何らかの理由で同じです。"}, {"type": "subtitle", "time": 6398.709, "timestamp": "01:46:38", "text": "もしかしたら神様は壁が均一ではない"}, {"type": "subtitle", "time": 6401.27, "timestamp": "01:46:41", "text": "クソバンドはまるで神のような彼らは本当に"}, {"type": "subtitle", "time": 6409.91, "timestamp": "01:46:49", "text": "何らかの理由で急いで建てられた。"}, {"type": "subtitle", "time": 6411.51, "timestamp": "01:46:51", "text": "アリは少なくともこう言おうとしていた"}, {"type": "subtitle", "time": 6413.189, "timestamp": "01:46:53", "text": "これらの死体は来ないだろう"}, {"type": "subtitle", "time": 6415.35, "timestamp": "01:46:55", "text": "生きている。アンデッドがいないか確認しました。そこには"}, {"type": "subtitle", "time": 6417.27, "timestamp": "01:46:57", "text": "近くに1つあるはずだけど、"}, {"type": "subtitle", "time": 6419.91, "timestamp": "01:46:59", "text": "どこにあるのかよく分からなかった。そして"}]
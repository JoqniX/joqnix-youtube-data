[{"type": "subtitle", "time": 9661.59, "timestamp": "02:41:01", "text": "よし、始めよう"}, {"type": "subtitle", "time": 9666.71, "timestamp": "02:41:06", "text": "完璧。"}, {"type": "subtitle", "time": 9669.349, "timestamp": "02:41:09", "text": "聖化されなさい。攻撃。"}, {"type": "subtitle", "time": 9670.63, "timestamp": "02:41:10", "text": "攻撃。 [音楽]"}, {"type": "subtitle", "time": 9673.2, "timestamp": "02:41:13", "text": "[音楽] わかった。ダメージ。"}, {"type": "subtitle", "time": 9684.79, "timestamp": "02:41:24", "text": "わかった。その粘液は今や神と一体となった。"}, {"type": "subtitle", "time": 9689.51, "timestamp": "02:41:29", "text": "よし。わかった。しかしここからは、"}, {"type": "subtitle", "time": 9692.07, "timestamp": "02:41:32", "text": "実際に主導権を握るべきだ。あなた"}, {"type": "subtitle", "time": 9694.07, "timestamp": "02:41:34", "text": "後でリロールすることもできますが、"}, {"type": "subtitle", "time": 9697.75, "timestamp": "02:41:37", "text": "主導権を握り続けるのは、"}, {"type": "subtitle", "time": 9701.67, "timestamp": "02:41:41", "text": "えーと、こちらで、えーと、その瞬間に、えーと"}, {"type": "subtitle", "time": 9704.469, "timestamp": "02:41:44", "text": "皆さんのようにスライムを取り除いてください"}, {"type": "subtitle", "time": 9714.389, "timestamp": "02:41:54", "text": "あなたも、あなたが"}, {"type": "subtitle", "time": 9716.309, "timestamp": "02:41:56", "text": "筋肉は、まるで常に"}, {"type": "subtitle", "time": 9718.87, "timestamp": "02:41:58", "text": "ゆっくりとあなたを引き込んできたような感じ。だから、"}]
[{"type": "subtitle", "time": 8520.71, "timestamp": "02:22:00", "text": "彼のそれぞれの姿勢。あまりにも多くない限り"}, {"type": "subtitle", "time": 8523.349, "timestamp": "02:22:03", "text": "大きな動き。わかった、"}, {"type": "subtitle", "time": 8525.27, "timestamp": "02:22:05", "text": "大丈夫。私が引き継ぎます"}, {"type": "subtitle", "time": 8526.87, "timestamp": "02:22:06", "text": "クリスマス。"}, {"type": "subtitle", "time": 8527.91, "timestamp": "02:22:07", "text": "うん。うん。"}, {"type": "subtitle", "time": 8530.79, "timestamp": "02:22:10", "text": "ちょっと息子の面倒をすぐに見ます。"}, {"type": "subtitle", "time": 8532.95, "timestamp": "02:22:12", "text": "息子さんは怖がっています。"}, {"type": "subtitle", "time": 8535.42, "timestamp": "02:22:15", "text": "私の息子に何をしたのですか？チクッ。"}, {"type": "subtitle", "time": 8537.75, "timestamp": "02:22:17", "text": "[音楽]"}, {"type": "subtitle", "time": 8550.23, "timestamp": "02:22:30", "text": "それはダニについて十分なことを物語っていると思います"}, {"type": "subtitle", "time": 8555.67, "timestamp": "02:22:35", "text": "何てことだ。"}, {"type": "subtitle", "time": 8558.15, "timestamp": "02:22:38", "text": "しかし、まだやっていないことは"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "サタンでさえ許すことができない"}, {"type": "subtitle", "time": 8568.389, "timestamp": "02:22:48", "text": "わかった。他に何かありますか？あなたの番です。"}, {"type": "subtitle", "time": 8577.59, "timestamp": "02:22:57", "text": "わかった。他に何もなければ、感じてください"}]
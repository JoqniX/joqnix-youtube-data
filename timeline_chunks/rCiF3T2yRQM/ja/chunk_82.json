[{"type": "subtitle", "time": 4920.47, "timestamp": "01:22:00", "text": "よし。ロープを投げてもいいですか？"}, {"type": "subtitle", "time": 4922.229, "timestamp": "01:22:02", "text": "ティックに戻りますか？"}, {"type": "subtitle", "time": 4928.39, "timestamp": "01:22:08", "text": "うん。うん。よし。だから、あなたは投げる"}, {"type": "subtitle", "time": 4931.669, "timestamp": "01:22:11", "text": "今すぐティグの方にロープを投げろ。"}, {"type": "subtitle", "time": 4933.43, "timestamp": "01:22:13", "text": "よし。それは私のことだと思う。私は私は"}, {"type": "subtitle", "time": 4935.59, "timestamp": "01:22:15", "text": "キックにはキックのやりたいことをやらせてあげよう。私"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "推測"}, {"type": "subtitle", "time": 4938.79, "timestamp": "01:22:18", "text": "彼は自分の得意なことをする。"}, {"type": "subtitle", "time": 4940.39, "timestamp": "01:22:20", "text": "うん。"}, {"type": "subtitle", "time": 4942.229, "timestamp": "01:22:22", "text": "隣の部屋の床を。"}, {"type": "subtitle", "time": 4944.95, "timestamp": "01:22:24", "text": "正しい。それは"}, {"type": "subtitle", "time": 4947.75, "timestamp": "01:22:27", "text": "え？床は、えーと、床は"}, {"type": "subtitle", "time": 4949.11, "timestamp": "01:22:29", "text": "もう一つの部屋ですよね？それとも"}, {"type": "subtitle", "time": 4950.39, "timestamp": "01:22:30", "text": "似ている？"}, {"type": "subtitle", "time": 4952.87, "timestamp": "01:22:32", "text": "ええ、かなり似ていますね。"}, {"type": "subtitle", "time": 4954.95, "timestamp": "01:22:34", "text": "だから、水を削って水を落とすことができた"}, {"type": "subtitle", "time": 4956.629, "timestamp": "01:22:36", "text": "私から。正しい。"}, {"type": "subtitle", "time": 4959.59, "timestamp": "01:22:39", "text": "おお。おお。えっと、これは水が"}, {"type": "subtitle", "time": 4961.59, "timestamp": "01:22:41", "text": "肉体そのもの。これは私が言うことだ。あなたが知っている"}, {"type": "subtitle", "time": 4964.39, "timestamp": "01:22:44", "text": "何？あなたがそう言うからって。ふむ。あなた"}, {"type": "subtitle", "time": 4965.83, "timestamp": "01:22:45", "text": "インスピレーションは必ず得られる。使わせてあげます"}, {"type": "subtitle", "time": 4968.55, "timestamp": "01:22:48", "text": "血液を形作るインスピレーション。"}, {"type": "subtitle", "time": 4969.99, "timestamp": "01:22:49", "text": "何てことだ。血。"}, {"type": "subtitle", "time": 4972.31, "timestamp": "01:22:52", "text": "これはメタルだ。"}, {"type": "subtitle", "time": 4973.03, "timestamp": "01:22:53", "text": "金属。"}, {"type": "subtitle", "time": 4974.47, "timestamp": "01:22:54", "text": "血液を形作る。そして私は行くつもりです"}, {"type": "subtitle", "time": 4976.79, "timestamp": "01:22:56", "text": "分け合うために、血を分け合う"}]
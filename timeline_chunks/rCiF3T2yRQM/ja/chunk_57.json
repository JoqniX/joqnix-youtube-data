[{"type": "subtitle", "time": 3421.43, "timestamp": "00:57:01", "text": "すでに他の人たちが先に述べていました。"}, {"type": "subtitle", "time": 3423.109, "timestamp": "00:57:03", "text": "アリアンはこう言うだろう。「まあ、私は"}, {"type": "subtitle", "time": 3425.75, "timestamp": "00:57:05", "text": "食べ物だと思うよ、みんな。私はしません"}, {"type": "subtitle", "time": 3427.27, "timestamp": "00:57:07", "text": "本当に、もっと多くのことがあると思う"}, {"type": "subtitle", "time": 3428.95, "timestamp": "00:57:08", "text": "それ。\""}, {"type": "subtitle", "time": 3431.91, "timestamp": "00:57:11", "text": "まあ、食べ物のように見えるけど、私は"}, {"type": "subtitle", "time": 3434.71, "timestamp": "00:57:14", "text": "本当に信頼できる食品は"}, {"type": "subtitle", "time": 3437.51, "timestamp": "00:57:17", "text": "ダンジョンの中にある、ランダムな長いテーブル"}, {"type": "subtitle", "time": 3440.069, "timestamp": "00:57:20", "text": "老婆が描かれている。"}, {"type": "subtitle", "time": 3442.95, "timestamp": "00:57:22", "text": "いくつか持って行ってもいいですよ。"}, {"type": "subtitle", "time": 3445.349, "timestamp": "00:57:25", "text": "少し分けてもらってもいいかな。"}, {"type": "subtitle", "time": 3449.19, "timestamp": "00:57:29", "text": "もしそれが呪いだったら？あるいは、もしそれが"}, {"type": "subtitle", "time": 3451.349, "timestamp": "00:57:31", "text": "不吉な前兆ですか？"}, {"type": "subtitle", "time": 3451.99, "timestamp": "00:57:31", "text": "知るか？"}, {"type": "subtitle", "time": 3455.109, "timestamp": "00:57:35", "text": "まあ、私たちが"}, {"type": "subtitle", "time": 3456.87, "timestamp": "00:57:36", "text": "試す。ハハ。"}, {"type": "subtitle", "time": 3458.39, "timestamp": "00:57:38", "text": "確かめる方法はただ一つ。"}, {"type": "subtitle", "time": 3459.99, "timestamp": "00:57:39", "text": "食べ物をいくつか手に取って"}, {"type": "subtitle", "time": 3461.19, "timestamp": "00:57:41", "text": "彼女の持ち物を入れるバッグ。"}, {"type": "subtitle", "time": 3464.39, "timestamp": "00:57:44", "text": "わかった。よし。えっと、怪しい"}, {"type": "subtitle", "time": 3466.23, "timestamp": "00:57:46", "text": "ダンジョンの食べ物。そう名付ければいい"}, {"type": "subtitle", "time": 3471.51, "timestamp": "00:57:51", "text": "私も少しいただきます。"}, {"type": "subtitle", "time": 3472.789, "timestamp": "00:57:52", "text": "わかった。うん。自由に"}, {"type": "subtitle", "time": 3474.63, "timestamp": "00:57:54", "text": "お好きなだけいくつでもどうぞ。"}, {"type": "subtitle", "time": 3477.19, "timestamp": "00:57:57", "text": "３つください。一つだけ言います"}, {"type": "subtitle", "time": 3479.27, "timestamp": "00:57:59", "text": "そのうちの1ポンドはわずか1ポンドです。"}]
[{"type": "subtitle", "time": 1260.23, "timestamp": "00:21:00", "text": "ああ、それは"}, {"type": "subtitle", "time": 1264.07, "timestamp": "00:21:04", "text": "だって、懐中電灯をクリックするから。その"}, {"type": "subtitle", "time": 1266.23, "timestamp": "00:21:06", "text": "いいえ、トークンを探すをクリックしても"}, {"type": "subtitle", "time": 1268.95, "timestamp": "00:21:08", "text": "どちらかのティックを移動してください。なぜなのかわかりません"}, {"type": "subtitle", "time": 1271.029, "timestamp": "00:21:11", "text": "は。"}, {"type": "subtitle", "time": 1273.27, "timestamp": "00:21:13", "text": "私のトークンがトーチのとき。"}, {"type": "subtitle", "time": 1275.43, "timestamp": "00:21:15", "text": "トークンはトーチです。"}, {"type": "subtitle", "time": 1277.83, "timestamp": "00:21:17", "text": "ちょっと待ってください。そうですね、"}, {"type": "subtitle", "time": 1280.549, "timestamp": "00:21:20", "text": "チェックマークを選択してください。まるで"}, {"type": "subtitle", "time": 1282.31, "timestamp": "00:21:22", "text": "ダニは敵だ。なぜなのかわかりません"}, {"type": "subtitle", "time": 1283.35, "timestamp": "00:21:23", "text": "は。"}, {"type": "subtitle", "time": 1285.029, "timestamp": "00:21:25", "text": "念のため確認させてください。はい、私は"}, {"type": "subtitle", "time": 1287.909, "timestamp": "00:21:27", "text": "これをすぐにやります。はい、そして"}, {"type": "subtitle", "time": 1290.23, "timestamp": "00:21:30", "text": "それでは、これを手早くやります。所有"}, {"type": "subtitle", "time": 1293.27, "timestamp": "00:21:33", "text": "の上。ああ、わかった。はい、どうぞ。えっと、"}, {"type": "subtitle", "time": 1295.43, "timestamp": "00:21:35", "text": "今すぐ確認してください。今すぐお試しください。"}, {"type": "subtitle", "time": 1297.669, "timestamp": "00:21:37", "text": "まだ懐中電灯に繋がっている。"}, {"type": "subtitle", "time": 1300.149, "timestamp": "00:21:40", "text": "ああ、わかった。持続する。もし私が、えっと"}, {"type": "subtitle", "time": 1301.59, "timestamp": "00:21:41", "text": "トークンを削除して、もう一度追加してみてください。"}, {"type": "subtitle", "time": 1303.83, "timestamp": "00:21:43", "text": "はい、どうぞ。効果はありますか？"}, {"type": "subtitle", "time": 1305.51, "timestamp": "00:21:45", "text": "いいえ、それはまだ私に繋がっています"}, {"type": "subtitle", "time": 1308.549, "timestamp": "00:21:48", "text": "トーチ。理由がわからない。言葉が出ない。"}, {"type": "subtitle", "time": 1310.149, "timestamp": "00:21:50", "text": "スティックがグレー表示になりました。わからない"}, {"type": "subtitle", "time": 1310.95, "timestamp": "00:21:50", "text": "どうしたの。"}, {"type": "subtitle", "time": 1313.27, "timestamp": "00:21:53", "text": "はぁ。これはファンキーだ。なぜ"}, {"type": "subtitle", "time": 1316.63, "timestamp": "00:21:56", "text": "懐中電灯に取り付けられている？ H."}, {"type": "subtitle", "time": 1318.71, "timestamp": "00:21:58", "text": "それはファンキーだね。えっと、クリックすると"}, {"type": "subtitle", "time": 1319.99, "timestamp": "00:21:59", "text": "チェックを入れてから矢印キーを使う、"}]
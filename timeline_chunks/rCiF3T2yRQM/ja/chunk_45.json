[{"type": "subtitle", "time": 2700.95, "timestamp": "00:45:00", "text": "とても美味しかった。やるべきだ"}, {"type": "subtitle", "time": 2701.67, "timestamp": "00:45:01", "text": "もっと。"}, {"type": "subtitle", "time": 2705.67, "timestamp": "00:45:05", "text": "いや、そんなことはさせませんよ。私は血が好きだ。"}, {"type": "subtitle", "time": 2708.47, "timestamp": "00:45:08", "text": "床に[ __ ]があるのは嫌だ。感謝"}, {"type": "subtitle", "time": 2709.91, "timestamp": "00:45:09", "text": "どういたしまして。"}, {"type": "subtitle", "time": 2712.23, "timestamp": "00:45:12", "text": "ダニはそうする。"}, {"type": "subtitle", "time": 2714.39, "timestamp": "00:45:14", "text": "糞食い野郎。わかった。あのね？"}, {"type": "subtitle", "time": 2716.71, "timestamp": "00:45:16", "text": "おそらく私が今まで出会った中で最悪の人物ではないでしょう。"}, {"type": "subtitle", "time": 2719.51, "timestamp": "00:45:19", "text": "この人生で。見て、見て"}, {"type": "subtitle", "time": 2726.15, "timestamp": "00:45:26", "text": "まあ。"}, {"type": "subtitle", "time": 2727.19, "timestamp": "00:45:27", "text": "わかった。"}, {"type": "subtitle", "time": 2729.349, "timestamp": "00:45:29", "text": "では、他に何かすべきことはありますか？"}, {"type": "subtitle", "time": 2731.109, "timestamp": "00:45:31", "text": "死者以外のことを心配する"}, {"type": "subtitle", "time": 2732.63, "timestamp": "00:45:32", "text": "スライム？"}, {"type": "subtitle", "time": 2734.63, "timestamp": "00:45:34", "text": "何か怖いことありましたか？何か面白いものあった？ああ、そうだった"}, {"type": "subtitle", "time": 2738.95, "timestamp": "00:45:38", "text": "君たちは戦利品を見つけた？君たちは略奪したの？"}, {"type": "subtitle", "time": 2741.51, "timestamp": "00:45:41", "text": "彼女はただ頭を抱えている"}, {"type": "subtitle", "time": 2745.67, "timestamp": "00:45:45", "text": "戦利品。よし、場所を見つけたぞ"}, {"type": "subtitle", "time": 2750.069, "timestamp": "00:45:50", "text": "どこかちょうどいいところに"}, {"type": "subtitle", "time": 2752.15, "timestamp": "00:45:52", "text": "どの場所が最適でしょうか？東ですか"}, {"type": "subtitle", "time": 2753.589, "timestamp": "00:45:53", "text": "それとも西？"}, {"type": "subtitle", "time": 2754.87, "timestamp": "00:45:54", "text": "ええと、西。うん。"}, {"type": "subtitle", "time": 2757.75, "timestamp": "00:45:57", "text": "うん。つまり、場所があるということです"}, {"type": "subtitle", "time": 2759.51, "timestamp": "00:45:59", "text": "西の方には、"}]
[{"type": "subtitle", "time": 11401.19, "timestamp": "03:10:01", "text": "魔法のサナダムシ。魔法に投げろ"}, {"type": "subtitle", "time": 11402.15, "timestamp": "03:10:02", "text": "サナダムシ。"}, {"type": "subtitle", "time": 11405.83, "timestamp": "03:10:05", "text": "魔法のサナダムシ。"}, {"type": "subtitle", "time": 11407.429, "timestamp": "03:10:07", "text": "よし。ええと、視線が必要です"}, {"type": "subtitle", "time": 11409.269, "timestamp": "03:10:09", "text": "ただし、そのためには。はい、どうぞ。"}, {"type": "subtitle", "time": 11412.55, "timestamp": "03:10:12", "text": "今ならそれが分かるでしょう。"}, {"type": "subtitle", "time": 11414.469, "timestamp": "03:10:14", "text": "信じられないことに、私たちは"}, {"type": "subtitle", "time": 11416.23, "timestamp": "03:10:16", "text": "胃"}, {"type": "subtitle", "time": 11418.71, "timestamp": "03:10:18", "text": "彼女の胃の中を何気なく歩いている。"}, {"type": "subtitle", "time": 11420.71, "timestamp": "03:10:20", "text": "今、腸の中でぐるぐる回っている。これは"}, {"type": "subtitle", "time": 11425.83, "timestamp": "03:10:25", "text": "それ"}, {"type": "subtitle", "time": 11427.75, "timestamp": "03:10:27", "text": "彼らが私たちを追い出そうとしている。それは私たちをうんちさせるだろう"}, {"type": "subtitle", "time": 11429.11, "timestamp": "03:10:29", "text": "後で。"}, {"type": "subtitle", "time": 11430.87, "timestamp": "03:10:30", "text": "そうやって次の段階に進むんだ"}, {"type": "subtitle", "time": 11432.15, "timestamp": "03:10:32", "text": "ダンジョンの。疲れ果てなければならない"}, {"type": "subtitle", "time": 11433.19, "timestamp": "03:10:33", "text": "下。"}, {"type": "subtitle", "time": 11440.469, "timestamp": "03:10:40", "text": "どうぞ。保存できません。だから、"}, {"type": "subtitle", "time": 11442.07, "timestamp": "03:10:42", "text": "ダメージを受けない"}, {"type": "subtitle", "time": 11444.79, "timestamp": "03:10:44", "text": "下。"}, {"type": "subtitle", "time": 11446.87, "timestamp": "03:10:46", "text": "うん。うん。それはサナダムシです。それ"}, {"type": "subtitle", "time": 11450.39, "timestamp": "03:10:50", "text": "条虫を食べてしまった。今では彼の友達だ。"}, {"type": "subtitle", "time": 11451.75, "timestamp": "03:10:51", "text": "[音楽]"}, {"type": "subtitle", "time": 11453.11, "timestamp": "03:10:53", "text": "魔法のサナダムシ。"}, {"type": "subtitle", "time": 11456.15, "timestamp": "03:10:56", "text": "このスライムは今、魔法のサナダムシをペットとして飼っている。"}]
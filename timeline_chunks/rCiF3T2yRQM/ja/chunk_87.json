[{"type": "subtitle", "time": 5223.43, "timestamp": "01:27:03", "text": "ちょっと待って。水分補給させてください。ごめん。"}, {"type": "subtitle", "time": 5230.31, "timestamp": "01:27:10", "text": "確認してみます。持続する。えっと、"}, {"type": "subtitle", "time": 5237.189, "timestamp": "01:27:17", "text": "おお。ああ、わかりました。実際、ああ、そう、私はただ"}, {"type": "subtitle", "time": 5240.39, "timestamp": "01:27:20", "text": "気づいたら、"}, {"type": "subtitle", "time": 5243.03, "timestamp": "01:27:23", "text": "アンデッドがここにいる。"}, {"type": "subtitle", "time": 5245.51, "timestamp": "01:27:25", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 5246.87, "timestamp": "01:27:26", "text": "それを忘れていました。ありがとう"}, {"type": "subtitle", "time": 5248.79, "timestamp": "01:27:28", "text": "それについて言及した。それを忘れてた"}, {"type": "subtitle", "time": 5250.87, "timestamp": "01:27:30", "text": "特定のアンデッド。"}, {"type": "subtitle", "time": 5254.629, "timestamp": "01:27:34", "text": "私はその特定のアンデッドのことを忘れていた"}, {"type": "chat", "time": 5254.844, "timestamp": "01:27:34", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ_yAK5S3_9EP-duW6Qo"}, {"type": "subtitle", "time": 5256.709, "timestamp": "01:27:36", "text": "それは確かにここに存在します。"}, {"type": "subtitle", "time": 5258.79, "timestamp": "01:27:38", "text": "特定のアンデッド。"}, {"type": "subtitle", "time": 5262.629, "timestamp": "01:27:42", "text": "ここには確かに存在する、特定のアンデッドがいる。"}, {"type": "subtitle", "time": 5268.229, "timestamp": "01:27:48", "text": "それはアンデッドと会話できる。"}, {"type": "subtitle", "time": 5272.629, "timestamp": "01:27:52", "text": "いいえ、でもなぜそれが具体的なのですか？"}, {"type": "subtitle", "time": 5275.11, "timestamp": "01:27:55", "text": "ここには実際にアンデッドがいる"}, {"type": "subtitle", "time": 5277.91, "timestamp": "01:27:57", "text": "どこかで。"}]
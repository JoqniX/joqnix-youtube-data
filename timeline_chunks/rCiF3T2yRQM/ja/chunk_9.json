[{"type": "subtitle", "time": 540.87, "timestamp": "00:09:00", "text": "私のテストのために。これは実際には"}, {"type": "subtitle", "time": 543.75, "timestamp": "00:09:03", "text": "約7.6倍速い"}, {"type": "subtitle", "time": 545.75, "timestamp": "00:09:05", "text": "前のもの。もちろんさ。変更する"}, {"type": "subtitle", "time": 546.23, "timestamp": "00:09:06", "text": "エンコーディング。"}, {"type": "subtitle", "time": 548.79, "timestamp": "00:09:08", "text": "これはまさに私が好きではないもの"}, {"type": "subtitle", "time": 550.07, "timestamp": "00:09:10", "text": "原因は分かりましたか？"}, {"type": "subtitle", "time": 551.91, "timestamp": "00:09:11", "text": "こんなに遅いなんて？イメージだけの問題だったのか？"}, {"type": "subtitle", "time": 552.87, "timestamp": "00:09:12", "text": "サイズ？"}, {"type": "subtitle", "time": 554.55, "timestamp": "00:09:14", "text": "主に読み込みが遅かったためです"}, {"type": "subtitle", "time": 556.23, "timestamp": "00:09:16", "text": "一度にやることが多すぎる。だから私は"}, {"type": "subtitle", "time": 559.829, "timestamp": "00:09:19", "text": "複数の部分に分割するのと同じように。"}, {"type": "subtitle", "time": 564.23, "timestamp": "00:09:24", "text": "けっこうだ。わかった。よし。だから私たちは"}, {"type": "subtitle", "time": 566.71, "timestamp": "00:09:26", "text": "ここから洞窟の中へ戻ります。目覚める。"}, {"type": "subtitle", "time": 570.63, "timestamp": "00:09:30", "text": "アリアナ、ジョック、そして、えーと、何らかの理由で、えーと"}, {"type": "subtitle", "time": 573.269, "timestamp": "00:09:33", "text": "コナはコバルトに刺された。あなたはそう思わない"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "みんな理由はわからないけど、"}, {"type": "subtitle", "time": 578.79, "timestamp": "00:09:38", "text": "寝ていたら、君たちは本当にひどい目に遭った"}, {"type": "subtitle", "time": 580.87, "timestamp": "00:09:40", "text": "悪夢。あなたは悪夢を見た"}, {"type": "subtitle", "time": 584.15, "timestamp": "00:09:44", "text": "まるで幽霊のような老婆"}, {"type": "subtitle", "time": 586.15, "timestamp": "00:09:46", "text": "チョークで描いているけど、突然"}, {"type": "subtitle", "time": 588.47, "timestamp": "00:09:48", "text": "ある時点で消えてしまい、"}, {"type": "subtitle", "time": 590.63, "timestamp": "00:09:50", "text": "まるで眠り続けるように"}, {"type": "subtitle", "time": 593.67, "timestamp": "00:09:53", "text": "比較的平和的に。わかった。"}, {"type": "subtitle", "time": 596.47, "timestamp": "00:09:56", "text": "相手と会う。"}, {"type": "subtitle", "time": 598.47, "timestamp": "00:09:58", "text": "うん。"}]
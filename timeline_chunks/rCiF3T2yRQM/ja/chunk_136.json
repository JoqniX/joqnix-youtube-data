[{"type": "subtitle", "time": 8162.149, "timestamp": "02:16:02", "text": "待って、私、ここに引っ越さなきゃいけないの？"}, {"type": "subtitle", "time": 8166.629, "timestamp": "02:16:06", "text": "ここを狙うのが良いと思います。私は思う"}, {"type": "subtitle", "time": 8167.99, "timestamp": "02:16:07", "text": "うん、"}, {"type": "subtitle", "time": 8171.109, "timestamp": "02:16:11", "text": "呪文を消費するか、または服用するか"}, {"type": "subtitle", "time": 8171.51, "timestamp": "02:16:11", "text": "それ？"}, {"type": "subtitle", "time": 8173.27, "timestamp": "02:16:13", "text": "使用している場合は消費してください"}, {"type": "subtitle", "time": 8174.709, "timestamp": "02:16:14", "text": "それを食べる。"}, {"type": "subtitle", "time": 8177.35, "timestamp": "02:16:17", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 8179.43, "timestamp": "02:16:19", "text": "待って。えっと"}, {"type": "subtitle", "time": 8183.43, "timestamp": "02:16:23", "text": "あの、パーティー仲間に聞いてもいいですか？いやいやでも"}, {"type": "subtitle", "time": 8185.75, "timestamp": "02:16:25", "text": "彼らに私の計画を伝えるべきだろうか？何をすべきか"}, {"type": "subtitle", "time": 8189.589, "timestamp": "02:16:29", "text": "私はします？私はどうするつもりですか？"}, {"type": "subtitle", "time": 8190.31, "timestamp": "02:16:30", "text": "ああ、わかりました。こんにちは。"}, {"type": "subtitle", "time": 8192.15, "timestamp": "02:16:32", "text": "いや、いや、いや。君は君は君は君は何でもする"}, {"type": "subtitle", "time": 8194.629, "timestamp": "02:16:34", "text": "あなたがやりたいこと。"}, {"type": "subtitle", "time": 8198.309, "timestamp": "02:16:38", "text": "だから、黒を注いでみようかな"}, {"type": "subtitle", "time": 8201.03, "timestamp": "02:16:41", "text": "彼らに酒を飲ませる。スライムの一つ。それから私は"}, {"type": "subtitle", "time": 8203.75, "timestamp": "02:16:43", "text": "月の光線を当てて、全部入れる"}, {"type": "subtitle", "time": 8206.07, "timestamp": "02:16:46", "text": "一度にまとめて統合するか、"}, {"type": "subtitle", "time": 8209.03, "timestamp": "02:16:49", "text": "何か。だろう"}, {"type": "subtitle", "time": 8210.469, "timestamp": "02:16:50", "text": "その仕事？"}, {"type": "subtitle", "time": 8212.79, "timestamp": "02:16:52", "text": "試してみてもいいかもしれません。"}, {"type": "subtitle", "time": 8217.91, "timestamp": "02:16:57", "text": "もちろん、試してみる価値はあるでしょう。"}]
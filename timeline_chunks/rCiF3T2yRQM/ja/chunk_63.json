[{"type": "subtitle", "time": 3783.27, "timestamp": "01:03:03", "text": "彫像。"}, {"type": "subtitle", "time": 3785.27, "timestamp": "01:03:05", "text": "彼らは皆、以前と全く同じです。"}, {"type": "subtitle", "time": 3787.75, "timestamp": "01:03:07", "text": "彼らは全員同一人物だ。"}, {"type": "subtitle", "time": 3791.67, "timestamp": "01:03:11", "text": "それは全く心配する必要はありません。"}, {"type": "subtitle", "time": 3793.43, "timestamp": "01:03:13", "text": "ああ、しまった、あそこに何かある。"}, {"type": "subtitle", "time": 3793.99, "timestamp": "01:03:13", "text": "わかった、"}, {"type": "subtitle", "time": 3794.87, "timestamp": "01:03:14", "text": "え、何だって？"}, {"type": "subtitle", "time": 3795.349, "timestamp": "01:03:15", "text": "うん、"}, {"type": "subtitle", "time": 3797.27, "timestamp": "01:03:17", "text": "そういうことがあるんです。ほら、あそこに男がいるよ。"}, {"type": "subtitle", "time": 3800.069, "timestamp": "01:03:20", "text": "骸骨のような死体。それは死体だ"}, {"type": "subtitle", "time": 3802.39, "timestamp": "01:03:22", "text": "こちらのことを指差しています。そしてこれは"}, {"type": "subtitle", "time": 3804.39, "timestamp": "01:03:24", "text": "押し開けられた壁のように"}, {"type": "subtitle", "time": 3805.91, "timestamp": "01:03:25", "text": "壁。そしてこちらの地上では、"}, {"type": "subtitle", "time": 3808.71, "timestamp": "01:03:28", "text": "血が大量に出ている。大量の血。"}, {"type": "subtitle", "time": 3810.47, "timestamp": "01:03:30", "text": "そしてこちらには、緑が少しある"}, {"type": "subtitle", "time": 3812.549, "timestamp": "01:03:32", "text": "組織。あなたはそれが何なのか知らない。"}, {"type": "subtitle", "time": 3815.27, "timestamp": "01:03:35", "text": "なるほど、疑わしい点がどこにあるか分かりました。"}, {"type": "subtitle", "time": 3819.99, "timestamp": "01:03:39", "text": "胸と血のある部屋があります。"}, {"type": "subtitle", "time": 3821.109, "timestamp": "01:03:41", "text": "これは宝箱です。"}, {"type": "subtitle", "time": 3823.109, "timestamp": "01:03:43", "text": "血痕のあるごく普通の部屋"}, {"type": "subtitle", "time": 3825.029, "timestamp": "01:03:45", "text": "それ。"}, {"type": "subtitle", "time": 3826.63, "timestamp": "01:03:46", "text": "全く普通のことです。"}, {"type": "subtitle", "time": 3832.309, "timestamp": "01:03:52", "text": "うん。全く普通のことです。すべてのものと同じように"}, {"type": "subtitle", "time": 3833.67, "timestamp": "01:03:53", "text": "そうあるべきだ。"}, {"type": "subtitle", "time": 3833.99, "timestamp": "01:03:53", "text": "うん。"}, {"type": "subtitle", "time": 3836.069, "timestamp": "01:03:56", "text": "はぁ。ええと、ちょっと調べてみますね。する"}, {"type": "subtitle", "time": 3839.029, "timestamp": "01:03:59", "text": "何かお役に立てそうなものはありますか？"}]
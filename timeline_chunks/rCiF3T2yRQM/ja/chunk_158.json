[{"type": "subtitle", "time": 9480.55, "timestamp": "02:38:00", "text": "上。"}, {"type": "subtitle", "time": 9484.07, "timestamp": "02:38:04", "text": "うわあ、私には何もできないよ。私"}, {"type": "subtitle", "time": 9485.83, "timestamp": "02:38:05", "text": "したくない"}, {"type": "subtitle", "time": 9487.51, "timestamp": "02:38:07", "text": "私は自分の呪文を使いたくない"}, {"type": "subtitle", "time": 9493.67, "timestamp": "02:38:13", "text": "うわー、時々、どれだけクソか忘れちゃう"}, {"type": "subtitle", "time": 9498.71, "timestamp": "02:38:18", "text": "クソ、奴らはクソみたいなウォーロックだ。"}, {"type": "subtitle", "time": 9501.03, "timestamp": "02:38:21", "text": "とにかく、私は爆撃する。"}, {"type": "subtitle", "time": 9504.389, "timestamp": "02:38:24", "text": "ウォーロックはほとんど何ももらえない。"}, {"type": "subtitle", "time": 9506.15, "timestamp": "02:38:26", "text": "わかった。それはとても神聖なことだ。よし。それ"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "ヒット。"}, {"type": "subtitle", "time": 9508.63, "timestamp": "02:38:28", "text": "それはとても神聖なことです。それ"}, {"type": "subtitle", "time": 9512.15, "timestamp": "02:38:32", "text": "とても神聖な場所です。なんてこった。"}, {"type": "subtitle", "time": 9513.11, "timestamp": "02:38:33", "text": "ドラゴン。"}, {"type": "subtitle", "time": 9515.349, "timestamp": "02:38:35", "text": "それは神聖化されてきた。全て"}, {"type": "subtitle", "time": 9516.23, "timestamp": "02:38:36", "text": "右。"}, {"type": "subtitle", "time": 9520.23, "timestamp": "02:38:40", "text": "聖別された、この[ __ ]め。聖化されなさい。"}, {"type": "subtitle", "time": 9523.99, "timestamp": "02:38:43", "text": "聖化されろ、この[ __ ]。ポチャン。"}, {"type": "subtitle", "time": 9525.91, "timestamp": "02:38:45", "text": "私はその言葉が好きではない。なぜ"}, {"type": "subtitle", "time": 9527.67, "timestamp": "02:38:47", "text": "そう言ってください。"}, {"type": "subtitle", "time": 9529.99, "timestamp": "02:38:49", "text": "なぜそんなことを言うのですか？それはそれは"}, {"type": "subtitle", "time": 9532.63, "timestamp": "02:38:52", "text": "好きな時の音"}, {"type": "subtitle", "time": 9534.71, "timestamp": "02:38:54", "text": "あなたが好きになろうとしているものを呼ぶ"}, {"type": "subtitle", "time": 9536.95, "timestamp": "02:38:56", "text": "教会であなたは手を周りに回して"}]
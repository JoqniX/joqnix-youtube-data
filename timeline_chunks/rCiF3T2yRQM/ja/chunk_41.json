[{"type": "subtitle", "time": 2460.39, "timestamp": "00:41:00", "text": "こんにちは、猫好きさん。"}, {"type": "subtitle", "time": 2463.99, "timestamp": "00:41:03", "text": "とりあえず、ここで寝ます。"}, {"type": "subtitle", "time": 2466.39, "timestamp": "00:41:06", "text": "彼は解離するつもりなのか"}, {"type": "subtitle", "time": 2470.15, "timestamp": "00:41:10", "text": "まるで一瞬、存在しないかのようだった。"}, {"type": "subtitle", "time": 2472.39, "timestamp": "00:41:12", "text": "ファンは厚く舐められてトラウマを負う"}, {"type": "subtitle", "time": 2473.27, "timestamp": "00:41:13", "text": "ブー。"}, {"type": "subtitle", "time": 2474.95, "timestamp": "00:41:14", "text": "うん。"}, {"type": "subtitle", "time": 2478.79, "timestamp": "00:41:18", "text": "おお。えっと、こんにちは。やあ。やあ、"}, {"type": "subtitle", "time": 2482.23, "timestamp": "00:41:22", "text": "女性聖騎士。えっと、あの男ともう一人"}, {"type": "subtitle", "time": 2483.589, "timestamp": "00:41:23", "text": "1つと"}, {"type": "subtitle", "time": 2485.91, "timestamp": "00:41:25", "text": "えっと"}, {"type": "subtitle", "time": 2496.15, "timestamp": "00:41:36", "text": "私たちは今、代わりにそれを取らなければならない。"}, {"type": "subtitle", "time": 2498.79, "timestamp": "00:41:38", "text": "ああ、わかりました。私"}, {"type": "subtitle", "time": 2501.589, "timestamp": "00:41:41", "text": "の方が優れている。ディックは"}, {"type": "subtitle", "time": 2503.03, "timestamp": "00:41:43", "text": "複雑な。"}, {"type": "subtitle", "time": 2507.03, "timestamp": "00:41:47", "text": "ええと、わかりました。君たちはレイしか見ていないの？のように"}, {"type": "subtitle", "time": 2508.79, "timestamp": "00:41:48", "text": "彼女はあなたたちの目の前にいるけれど、"}, {"type": "subtitle", "time": 2511.03, "timestamp": "00:41:51", "text": "彼女は縛られているのがわかる"}, {"type": "subtitle", "time": 2514.309, "timestamp": "00:41:54", "text": "端の方にロープがある。"}, {"type": "subtitle", "time": 2518.55, "timestamp": "00:41:58", "text": "えっと、君たちは"}]
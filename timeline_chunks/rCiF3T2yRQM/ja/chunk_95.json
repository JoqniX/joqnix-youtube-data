[{"type": "subtitle", "time": 5701.27, "timestamp": "01:35:01", "text": "また？死体の中に。そしてそれは"}, {"type": "subtitle", "time": 5707.91, "timestamp": "01:35:07", "text": "ほぼ成長している。それは広がり、"}, {"type": "subtitle", "time": 5710.55, "timestamp": "01:35:10", "text": "今は黒い液体がもっとあって、"}, {"type": "subtitle", "time": 5712.709, "timestamp": "01:35:12", "text": "その上に青い液体が付着している。"}, {"type": "subtitle", "time": 5715.27, "timestamp": "01:35:15", "text": "おお。"}, {"type": "subtitle", "time": 5719.75, "timestamp": "01:35:19", "text": "はぁ。はぁ？青い液体が形成されています"}, {"type": "subtitle", "time": 5721.43, "timestamp": "01:35:21", "text": "それ。"}, {"type": "subtitle", "time": 5723.35, "timestamp": "01:35:23", "text": "おい、"}, {"type": "subtitle", "time": 5725.669, "timestamp": "01:35:25", "text": "これは単なる仮説かもしれない。あなたは"}, {"type": "subtitle", "time": 5727.91, "timestamp": "01:35:27", "text": "あの黒い泥全体と"}, {"type": "subtitle", "time": 5731.669, "timestamp": "01:35:31", "text": "青いヘドロがあり、その容器は"}, {"type": "subtitle", "time": 5735.75, "timestamp": "01:35:35", "text": "この物体によって売られた死体？"}, {"type": "subtitle", "time": 5738.47, "timestamp": "01:35:38", "text": "こんな感じになるだろう、"}, {"type": "subtitle", "time": 5740.229, "timestamp": "01:35:40", "text": "「ロータス師匠、どう思われますか？」そして"}, {"type": "subtitle", "time": 5741.91, "timestamp": "01:35:41", "text": "彼はこう言うだろう、「まあ、私の"}, {"type": "subtitle", "time": 5744.95, "timestamp": "01:35:44", "text": "何年も、たくさんの液体を見てきましたが、"}, {"type": "subtitle", "time": 5748.07, "timestamp": "01:35:48", "text": "これは確かにその一つだ。間違いなく"}, {"type": "subtitle", "time": 5749.75, "timestamp": "01:35:49", "text": "それらの死体に何かをする、"}, {"type": "subtitle", "time": 5751.99, "timestamp": "01:35:51", "text": "それらを2つの異なる形態に分離する"}, {"type": "subtitle", "time": 5759.43, "timestamp": "01:35:59", "text": "しかし、彼らの目的は間違いなく"}]
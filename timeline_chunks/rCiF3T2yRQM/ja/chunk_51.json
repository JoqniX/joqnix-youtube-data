[{"type": "subtitle", "time": 3066.63, "timestamp": "00:51:06", "text": "彼らはもう一つ食べた。"}, {"type": "subtitle", "time": 3070.79, "timestamp": "00:51:10", "text": "何？ホブルズは食べる"}, {"type": "subtitle", "time": 3079.03, "timestamp": "00:51:19", "text": "ああ、クソ野郎はただ見ているだけだ"}, {"type": "subtitle", "time": 3082.79, "timestamp": "00:51:22", "text": "本。コバルトは一体何を食べるのだろうか？なぜただ"}, {"type": "subtitle", "time": 3084.549, "timestamp": "00:51:24", "text": "全部食べる？"}, {"type": "subtitle", "time": 3085.91, "timestamp": "00:51:25", "text": "アリアナがこれに来るだろう"}, {"type": "subtitle", "time": 3087.51, "timestamp": "00:51:27", "text": "そして彼女はただ行くだけだと言う"}, {"type": "subtitle", "time": 3088.87, "timestamp": "00:51:28", "text": "彼女は周りを見回すつもりだ、"}, {"type": "subtitle", "time": 3091.67, "timestamp": "00:51:31", "text": "ヴァンが見ていないことを確認して、"}, {"type": "subtitle", "time": 3093.27, "timestamp": "00:51:33", "text": "彼女を刺すみたいに"}, {"type": "subtitle", "time": 3094.71, "timestamp": "00:51:34", "text": "彼女の指が少しだけそこに入っていて、"}, {"type": "subtitle", "time": 3096.39, "timestamp": "00:51:36", "text": "ちょっと試してみて。"}, {"type": "subtitle", "time": 3098.95, "timestamp": "00:51:38", "text": "そんなの認識できるのか？"}, {"type": "subtitle", "time": 3100.549, "timestamp": "00:51:40", "text": "はい。はい。"}, {"type": "subtitle", "time": 3104.87, "timestamp": "00:51:44", "text": "知覚と隠密行動。来て。"}, {"type": "subtitle", "time": 3108.63, "timestamp": "00:51:48", "text": "アリアナの「見かけ」と「隠密行動」の違いは何ですか？"}, {"type": "subtitle", "time": 3112.39, "timestamp": "00:51:52", "text": "よし、公の場に出よう。また、あなたも"}, {"type": "subtitle", "time": 3114.63, "timestamp": "00:51:54", "text": "まだ不利な点があります"}, {"type": "subtitle", "time": 3116.309, "timestamp": "00:51:56", "text": "板金鎧か何かのようなもの。"}, {"type": "subtitle", "time": 3119.109, "timestamp": "00:51:59", "text": "ああ、くそ。"}]
[{"type": "subtitle", "time": 4620.55, "timestamp": "01:17:00", "text": "正直に言います。私はそうは思わない"}, {"type": "subtitle", "time": 4624.31, "timestamp": "01:17:04", "text": "厄介な状況になりそうだ。お願いします。"}, {"type": "subtitle", "time": 4626.149, "timestamp": "01:17:06", "text": "えっと"}, {"type": "subtitle", "time": 4627.83, "timestamp": "01:17:07", "text": "他にどうすればいいのか本当にわからない"}, {"type": "subtitle", "time": 4630.149, "timestamp": "01:17:10", "text": "ここ。"}, {"type": "subtitle", "time": 4633.27, "timestamp": "01:17:13", "text": "そうするかもしれない。チクッ。ダニは"}, {"type": "subtitle", "time": 4635.35, "timestamp": "01:17:15", "text": "プラン。チックには何か計画があるのか​​もしれない。"}, {"type": "subtitle", "time": 4638.149, "timestamp": "01:17:18", "text": "わかった。もし計画があるなら、えっと、私はただ"}, {"type": "subtitle", "time": 4641.83, "timestamp": "01:17:21", "text": "これをしてください。クリックするだけ。タップするだけです"}, {"type": "subtitle", "time": 4643.99, "timestamp": "01:17:23", "text": "彼のクソみたいな額。あなたは"}, {"type": "subtitle", "time": 4645.189, "timestamp": "01:17:25", "text": "ガイド付き。"}, {"type": "subtitle", "time": 4646.79, "timestamp": "01:17:26", "text": "わかった。これは一体どのような指針なのでしょうか？それで、"}, {"type": "subtitle", "time": 4648.63, "timestamp": "01:17:28", "text": "期間中かどうかを指定する必要があります"}, {"type": "subtitle", "time": 4649.669, "timestamp": "01:17:29", "text": "痛み。"}, {"type": "subtitle", "time": 4652.55, "timestamp": "01:17:32", "text": "どのスキルを伸ばしたいですか？"}, {"type": "subtitle", "time": 4656.07, "timestamp": "01:17:36", "text": "それは、ええと、それはまた、"}, {"type": "subtitle", "time": 4658.39, "timestamp": "01:17:38", "text": "陸上競技？それだったのか？うん。"}, {"type": "subtitle", "time": 4659.35, "timestamp": "01:17:39", "text": "わかった、"}, {"type": "subtitle", "time": 4664.47, "timestamp": "01:17:44", "text": "陸上競技ガイド。"}, {"type": "subtitle", "time": 4666.07, "timestamp": "01:17:46", "text": "うん。そしてそれは私の"}, {"type": "subtitle", "time": 4669.03, "timestamp": "01:17:49", "text": "振り向く。でも実際は、サーカスビーンウェイト、"}, {"type": "subtitle", "time": 4670.87, "timestamp": "01:17:50", "text": "実際その前に、"}, {"type": "subtitle", "time": 4673.669, "timestamp": "01:17:53", "text": "サーカスビーンはロープが好きで、"}, {"type": "subtitle", "time": 4675.43, "timestamp": "01:17:55", "text": "自分の手で動かす？うん、"}, {"type": "subtitle", "time": 4678.07, "timestamp": "01:17:58", "text": "私はただロープを渡して、"}]
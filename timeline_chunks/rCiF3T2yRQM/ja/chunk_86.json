[{"type": "subtitle", "time": 5160.87, "timestamp": "01:26:00", "text": "死体？"}, {"type": "subtitle", "time": 5162.149, "timestamp": "01:26:02", "text": "わかった。"}, {"type": "subtitle", "time": 5163.669, "timestamp": "01:26:03", "text": "死体。"}, {"type": "subtitle", "time": 5165.91, "timestamp": "01:26:05", "text": "部屋に入るとすぐに、私は"}, {"type": "subtitle", "time": 5167.35, "timestamp": "01:26:07", "text": "これらの死体をすべて見に行くと"}, {"type": "subtitle", "time": 5169.75, "timestamp": "01:26:09", "text": "「ああ、これはこれだ、これはこれだ」って思うだろう"}, {"type": "subtitle", "time": 5171.669, "timestamp": "01:26:11", "text": "「不快だ。」そして私は"}, {"type": "subtitle", "time": 5174.07, "timestamp": "01:26:14", "text": "私の神聖な感覚。"}, {"type": "subtitle", "time": 5175.51, "timestamp": "01:26:15", "text": "わかった。よし。"}, {"type": "subtitle", "time": 5177.03, "timestamp": "01:26:17", "text": "私は中央です。"}, {"type": "subtitle", "time": 5180.87, "timestamp": "01:26:20", "text": "見てみましょう。ああ、わかった。よし。えっと、それから"}, {"type": "subtitle", "time": 5183.189, "timestamp": "01:26:23", "text": "チューブは実際にはわからない"}, {"type": "subtitle", "time": 5184.47, "timestamp": "01:26:24", "text": "地下鉄について多くを語る。まるで"}, {"type": "subtitle", "time": 5186.47, "timestamp": "01:26:26", "text": "ただの筒です。ああ、もしかしたら、私が開ければ"}, {"type": "subtitle", "time": 5188.149, "timestamp": "01:26:28", "text": "蛇口から何かが流れ出てくる"}, {"type": "subtitle", "time": 5190.95, "timestamp": "01:26:30", "text": "あなたが飲めるもの。ああ、でもそうだね。そして、"}, {"type": "subtitle", "time": 5194.55, "timestamp": "01:26:34", "text": "アリアナ、それを明かしましょう。ええと、わかりました。あなた"}, {"type": "subtitle", "time": 5197.51, "timestamp": "01:26:37", "text": "これらの死体はただ"}, {"type": "subtitle", "time": 5199.27, "timestamp": "01:26:39", "text": "普通の死体。"}, {"type": "subtitle", "time": 5202.47, "timestamp": "01:26:42", "text": "ああ、わかりました。ええ、彼らはそうしないでしょう"}, {"type": "subtitle", "time": 5203.75, "timestamp": "01:26:43", "text": "表示されません。"}, {"type": "subtitle", "time": 5205.27, "timestamp": "01:26:45", "text": "何？ええと、ちょっと見せてください。あなたはできる"}, {"type": "subtitle", "time": 5208.229, "timestamp": "01:26:48", "text": "次の10分間、あなたのWERSを開いてください"}, {"type": "subtitle", "time": 5210.79, "timestamp": "01:26:50", "text": "中に入るまでは、場所がわかりません"}, {"type": "subtitle", "time": 5212.87, "timestamp": "01:26:52", "text": "それらのタイプの生き物。"}, {"type": "subtitle", "time": 5215.27, "timestamp": "01:26:55", "text": "えっと"}, {"type": "subtitle", "time": 5216.149, "timestamp": "01:26:56", "text": "ハンハン。"}]
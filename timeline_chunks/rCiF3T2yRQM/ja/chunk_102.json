[{"type": "subtitle", "time": 6121.03, "timestamp": "01:42:01", "text": "死体を投げ込んで、それからほとんど"}, {"type": "subtitle", "time": 6123.75, "timestamp": "01:42:03", "text": "黒い液体が届くように"}, {"type": "subtitle", "time": 6125.99, "timestamp": "01:42:05", "text": "死体をあなたのために、そして引っ張るように"}, {"type": "subtitle", "time": 6128.95, "timestamp": "01:42:08", "text": "中に入れると、泡立ち始める。あなた"}, {"type": "subtitle", "time": 6131.35, "timestamp": "01:42:11", "text": "小さいものがたくさん"}, {"type": "subtitle", "time": 6134.629, "timestamp": "01:42:14", "text": "指でゆっくりと、まるでそれを食べるように。そして"}, {"type": "subtitle", "time": 6137.109, "timestamp": "01:42:17", "text": "ゆっくりと確実に、つまり、"}, {"type": "subtitle", "time": 6139.43, "timestamp": "01:42:19", "text": "ここに死体があって、そう、死体が"}, {"type": "subtitle", "time": 6142.709, "timestamp": "01:42:22", "text": "溶解して、そのすぐ下に"}, {"type": "subtitle", "time": 6146.31, "timestamp": "01:42:26", "text": "このチューブからゆっくりと青い液体が流れ始めます"}, {"type": "subtitle", "time": 6148.31, "timestamp": "01:42:28", "text": "形成する。"}, {"type": "subtitle", "time": 6150.31, "timestamp": "01:42:30", "text": "おい、"}, {"type": "subtitle", "time": 6157.27, "timestamp": "01:42:37", "text": "私たちはリサイクルをしています。"}, {"type": "subtitle", "time": 6161.99, "timestamp": "01:42:41", "text": "とにかく。私たちはそれらの使用を気にします。"}, {"type": "subtitle", "time": 6164.95, "timestamp": "01:42:44", "text": "それは、再利用することだと知っています"}, {"type": "subtitle", "time": 6166.47, "timestamp": "01:42:46", "text": "死者を敬うことは重要ですが"}, {"type": "subtitle", "time": 6168.39, "timestamp": "01:42:48", "text": "また再利用も"}, {"type": "subtitle", "time": 6169.27, "timestamp": "01:42:49", "text": "あまりにも。"}, {"type": "subtitle", "time": 6171.83, "timestamp": "01:42:51", "text": "再利用することは、尊重することと同じだ。"}, {"type": "subtitle", "time": 6174.31, "timestamp": "01:42:54", "text": "うん。花を知っているから、"}, {"type": "subtitle", "time": 6176.47, "timestamp": "01:42:56", "text": "花に血を注ぐと、"}, {"type": "subtitle", "time": 6179.59, "timestamp": "01:42:59", "text": "彼らは栄養素を摂取する。それは事実です"}]
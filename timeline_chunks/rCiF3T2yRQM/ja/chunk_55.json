[{"type": "subtitle", "time": 3300.79, "timestamp": "00:55:00", "text": "この部屋には巨大なテーブルがある"}, {"type": "subtitle", "time": 3302.71, "timestamp": "00:55:02", "text": "ここ。これはとても大きな"}, {"type": "subtitle", "time": 3305.349, "timestamp": "00:55:05", "text": "テーブルの上にはたくさんの"}, {"type": "subtitle", "time": 3308.069, "timestamp": "00:55:08", "text": "食べ物。非常に新鮮な食材です。見た目"}, {"type": "subtitle", "time": 3309.51, "timestamp": "00:55:09", "text": "美味しい。"}, {"type": "subtitle", "time": 3311.99, "timestamp": "00:55:11", "text": "これが魔法の食べ物だと思う"}, {"type": "subtitle", "time": 3314.71, "timestamp": "00:55:14", "text": "私たちが話していたのは。ロールアウトできますか"}, {"type": "subtitle", "time": 3317.19, "timestamp": "00:55:17", "text": "ええ、どうぞ。"}, {"type": "subtitle", "time": 3319.51, "timestamp": "00:55:19", "text": "わかった、"}, {"type": "subtitle", "time": 3322.069, "timestamp": "00:55:22", "text": "試みる前に調査すべきです"}, {"type": "subtitle", "time": 3324.63, "timestamp": "00:55:24", "text": "何か不審な行動をとる。ディック、置かないで"}, {"type": "subtitle", "time": 3327.19, "timestamp": "00:55:27", "text": "あなたはまだそれに触れていません。"}, {"type": "subtitle", "time": 3329.91, "timestamp": "00:55:29", "text": "あなたは確かにそれを知っています"}, {"type": "subtitle", "time": 3332.95, "timestamp": "00:55:32", "text": "この食べ物は魔法のような性質を持っていますが、"}, {"type": "subtitle", "time": 3334.79, "timestamp": "00:55:34", "text": "わからない。あなたはあまりよく知らない"}, {"type": "subtitle", "time": 3336.39, "timestamp": "00:55:36", "text": "それについてですが、それは"}, {"type": "subtitle", "time": 3338.47, "timestamp": "00:55:38", "text": "魔法のようだ。"}, {"type": "subtitle", "time": 3339.99, "timestamp": "00:55:39", "text": "小さな手をそれに置いて、それから"}, {"type": "subtitle", "time": 3342.23, "timestamp": "00:55:42", "text": "また、"}, {"type": "subtitle", "time": 3344.95, "timestamp": "00:55:44", "text": "わかった。よし。ロールをください"}, {"type": "subtitle", "time": 3346.87, "timestamp": "00:55:46", "text": "盲目。"}, {"type": "subtitle", "time": 3348.39, "timestamp": "00:55:48", "text": "まるで彼らの押しの1つを押しのけるように"}, {"type": "subtitle", "time": 3355.109, "timestamp": "00:55:55", "text": "とても独創的だ。"}, {"type": "subtitle", "time": 3356.789, "timestamp": "00:55:56", "text": "どうぞ。"}, {"type": "subtitle", "time": 3359.91, "timestamp": "00:55:59", "text": "わかった。ああ、わかった。わかった。えっと、"}]
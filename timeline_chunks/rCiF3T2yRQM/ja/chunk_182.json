[{"type": "subtitle", "time": 10921.03, "timestamp": "03:02:01", "text": "ドラゴンボードについては間違っていません、"}, {"type": "subtitle", "time": 10922.71, "timestamp": "03:02:02", "text": "ボーナスアクションだけど、忘れてない"}, {"type": "subtitle", "time": 10924.95, "timestamp": "03:02:04", "text": "それについて、私にとって行動を起こすべきだ。"}, {"type": "subtitle", "time": 10928.87, "timestamp": "03:02:08", "text": "ちょっと確認させてください。いやいや"}, {"type": "subtitle", "time": 10932.71, "timestamp": "03:02:12", "text": "持続する。ブロック全体を確認させてください。"}, {"type": "subtitle", "time": 10934.79, "timestamp": "03:02:14", "text": "えっと、"}, {"type": "subtitle", "time": 10937.67, "timestamp": "03:02:17", "text": "運べますか？持続する。えーと、"}, {"type": "subtitle", "time": 10939.269, "timestamp": "03:02:19", "text": "魔法のアクション。ああ、魔法でなければならない"}, {"type": "subtitle", "time": 10940.55, "timestamp": "03:02:20", "text": "アクション。つまり、"}, {"type": "subtitle", "time": 10941.99, "timestamp": "03:02:21", "text": "それでは、次の番でやります。"}, {"type": "subtitle", "time": 10943.11, "timestamp": "03:02:23", "text": "うん。うん。"}, {"type": "subtitle", "time": 10944.87, "timestamp": "03:02:24", "text": "よし。そうすると思うよ、だって私は"}, {"type": "subtitle", "time": 10947.99, "timestamp": "03:02:27", "text": "私の攻撃を燃やすので、"}, {"type": "subtitle", "time": 10951.03, "timestamp": "03:02:31", "text": "はい、次。あなたは、あなたはしたいですか"}, {"type": "subtitle", "time": 10951.91, "timestamp": "03:02:31", "text": "抵抗する？"}, {"type": "subtitle", "time": 10953.51, "timestamp": "03:02:33", "text": "いや、違うよ。"}, {"type": "subtitle", "time": 10959.51, "timestamp": "03:02:39", "text": "私たちはただこの巨大な"}, {"type": "subtitle", "time": 10961.59, "timestamp": "03:02:41", "text": "生物が免疫を持っているか、"}, {"type": "subtitle", "time": 10966.95, "timestamp": "03:02:46", "text": "これらはすべて消化酵素です"}, {"type": "subtitle", "time": 10974.71, "timestamp": "03:02:54", "text": "ああ、大変だ。まあ、次ね。あなたの"}, {"type": "subtitle", "time": 10976.63, "timestamp": "03:02:56", "text": "アクション？"}, {"type": "subtitle", "time": 10978.23, "timestamp": "03:02:58", "text": "えっと"}]
[{"type": "subtitle", "time": 11881.67, "timestamp": "03:18:01", "text": "それを切り開くつもりだ"}, {"type": "subtitle", "time": 11883.269, "timestamp": "03:18:03", "text": "スマイト"}, {"type": "subtitle", "time": 11885.67, "timestamp": "03:18:05", "text": "クソ野郎を叩きのめせ。"}, {"type": "subtitle", "time": 11888.229, "timestamp": "03:18:08", "text": "私のはロバを叩いたのか。"}, {"type": "subtitle", "time": 11891.11, "timestamp": "03:18:11", "text": "わかった。また。ああ、こっちだよ。として"}, {"type": "subtitle", "time": 11892.55, "timestamp": "03:18:12", "text": "ステファンもこちらで気づいて"}, {"type": "subtitle", "time": 11895.269, "timestamp": "03:18:15", "text": "ここも非常に薄い膜のようなものです。"}, {"type": "subtitle", "time": 11897.429, "timestamp": "03:18:17", "text": "ああ"}, {"type": "subtitle", "time": 11901.19, "timestamp": "03:18:21", "text": "ジョックはこの店を開店させようと試みるつもりなのか？"}, {"type": "subtitle", "time": 11905.03, "timestamp": "03:18:25", "text": "はい、そうしたいです。うん、"}, {"type": "subtitle", "time": 11906.87, "timestamp": "03:18:26", "text": "打つことができます"}, {"type": "subtitle", "time": 11908.71, "timestamp": "03:18:28", "text": "えーと"}, {"type": "subtitle", "time": 11911.83, "timestamp": "03:18:31", "text": "魔法石を使うべきでしょうか？"}, {"type": "subtitle", "time": 11912.95, "timestamp": "03:18:32", "text": "あなたはできる。"}, {"type": "subtitle", "time": 11914.71, "timestamp": "03:18:34", "text": "わかった。"}, {"type": "subtitle", "time": 11918.309, "timestamp": "03:18:38", "text": "魔法石かチャルも"}, {"type": "subtitle", "time": 11920.15, "timestamp": "03:18:40", "text": "右。おお、"}, {"type": "subtitle", "time": 11922.79, "timestamp": "03:18:42", "text": "私は自分のshを使うことができます。ええ、できますよ。"}, {"type": "subtitle", "time": 11925.51, "timestamp": "03:18:45", "text": "うん、"}, {"type": "subtitle", "time": 11928.469, "timestamp": "03:18:48", "text": "もっと近づかないといけないの？"}, {"type": "subtitle", "time": 11930.79, "timestamp": "03:18:50", "text": "うん。つまり、近接戦闘だ。"}, {"type": "subtitle", "time": 11932.55, "timestamp": "03:18:52", "text": "ここに行って、それからこれを叩かなければならない"}, {"type": "subtitle", "time": 11933.89, "timestamp": "03:18:53", "text": "あなたのchle。"}, {"type": "subtitle", "time": 11938.95, "timestamp": "03:18:58", "text": "私のお気に入りの1つが実際に私を"}]
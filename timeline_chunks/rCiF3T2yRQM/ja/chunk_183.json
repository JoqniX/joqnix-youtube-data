[{"type": "subtitle", "time": 10981.19, "timestamp": "03:03:01", "text": "ここで何ができるのか分かりません。できないの？"}, {"type": "subtitle", "time": 10984.87, "timestamp": "03:03:04", "text": "スティックを使って、えーと動かす"}, {"type": "subtitle", "time": 10988.87, "timestamp": "03:03:08", "text": "前進か何か、なぜならそれは"}, {"type": "subtitle", "time": 10995.91, "timestamp": "03:03:15", "text": "えっと"}, {"type": "subtitle", "time": 10999.21, "timestamp": "03:03:19", "text": "例えば、ここかな。"}, {"type": "subtitle", "time": 11002.87, "timestamp": "03:03:22", "text": "[音楽]"}, {"type": "subtitle", "time": 11010.389, "timestamp": "03:03:30", "text": "待って、待って。よし。移動しますか、それとも"}, {"type": "subtitle", "time": 11012.87, "timestamp": "03:03:32", "text": "ビームを監視？"}, {"type": "subtitle", "time": 11015.429, "timestamp": "03:03:35", "text": "えっと、待って、何？"}, {"type": "subtitle", "time": 11017.83, "timestamp": "03:03:37", "text": "私はそうではなかった"}, {"type": "subtitle", "time": 11018.389, "timestamp": "03:03:38", "text": "ともかく。"}, {"type": "subtitle", "time": 11020.55, "timestamp": "03:03:40", "text": "うん。うん。"}, {"type": "subtitle", "time": 11022.79, "timestamp": "03:03:42", "text": "ああ、私は月の光を動かすことができる。"}, {"type": "subtitle", "time": 11024.87, "timestamp": "03:03:44", "text": "うん。ええ、月の光を動かすことはできますよ。"}, {"type": "subtitle", "time": 11025.91, "timestamp": "03:03:45", "text": "わかった。"}, {"type": "subtitle", "time": 11027.19, "timestamp": "03:03:47", "text": "ここ。"}, {"type": "subtitle", "time": 11029.429, "timestamp": "03:03:49", "text": "ああ、そこに移動したいです。"}, {"type": "subtitle", "time": 11030.309, "timestamp": "03:03:50", "text": "はい。"}, {"type": "subtitle", "time": 11038.79, "timestamp": "03:03:58", "text": "それでは、こちらに移動させます。クリス クリスは意地悪"}]
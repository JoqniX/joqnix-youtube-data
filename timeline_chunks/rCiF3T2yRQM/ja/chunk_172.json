[{"type": "subtitle", "time": 10320.63, "timestamp": "02:52:00", "text": "あなたの次のターンが始まるまで。あなた"}, {"type": "subtitle", "time": 10322.63, "timestamp": "02:52:02", "text": "そしてあなたの味方は攻撃で有利になります"}, {"type": "subtitle", "time": 10324.79, "timestamp": "02:52:04", "text": "それらの敵のいずれかに対してロールします"}, {"type": "subtitle", "time": 10326.469, "timestamp": "02:52:06", "text": "できる"}, {"type": "subtitle", "time": 10328.389, "timestamp": "02:52:08", "text": "ここに載せてください。そうすれば私たち全員が見ることができます。"}, {"type": "subtitle", "time": 10332.95, "timestamp": "02:52:12", "text": "おお、"}, {"type": "subtitle", "time": 10335.03, "timestamp": "02:52:15", "text": "考えたこともなかった。クソッ"}, {"type": "subtitle", "time": 10337.67, "timestamp": "02:52:17", "text": "ゼリーはここにありますか？"}, {"type": "subtitle", "time": 10339.75, "timestamp": "02:52:19", "text": "良い指摘ですね。そうは思わない、なぜなら"}, {"type": "subtitle", "time": 10342.71, "timestamp": "02:52:22", "text": "彼らは盲目的な感覚を使う。それを保持してください。"}, {"type": "subtitle", "time": 10344.71, "timestamp": "02:52:24", "text": "私は彼らが本当に"}, {"type": "subtitle", "time": 10345.429, "timestamp": "02:52:25", "text": "それについて考えました。"}, {"type": "subtitle", "time": 10347.349, "timestamp": "02:52:27", "text": "うん。うん。うん。彼らは免疫を持っている"}, {"type": "subtitle", "time": 10351.429, "timestamp": "02:52:31", "text": "実際には耳が聞こえなくなるほどだ。だから彼らは聞こえないのです。"}, {"type": "subtitle", "time": 10351.83, "timestamp": "02:52:31", "text": "うん。"}, {"type": "subtitle", "time": 10354.71, "timestamp": "02:52:34", "text": "これは実際には"}, {"type": "subtitle", "time": 10357.99, "timestamp": "02:52:37", "text": "ああ、そうだね。ええ、彼らは"}, {"type": "subtitle", "time": 10362.86, "timestamp": "02:52:42", "text": "欲しい"}, {"type": "subtitle", "time": 10364.63, "timestamp": "02:52:44", "text": "[音楽]"}, {"type": "subtitle", "time": 10366.469, "timestamp": "02:52:46", "text": "Twitchでは「食べろ」と言っている。ああ、やめて"}, {"type": "subtitle", "time": 10368.07, "timestamp": "02:52:48", "text": "心配。ダニはすでに食べている"}, {"type": "subtitle", "time": 10368.79, "timestamp": "02:52:48", "text": "スライム。"}, {"type": "subtitle", "time": 10371.429, "timestamp": "02:52:51", "text": "ティックは既にそれを実行している。"}, {"type": "subtitle", "time": 10373.75, "timestamp": "02:52:53", "text": "もう手遅れだ。私たちは"}, {"type": "subtitle", "time": 10377.51, "timestamp": "02:52:57", "text": "彼がそうするのを阻止することに成功した。"}, {"type": "subtitle", "time": 10378.71, "timestamp": "02:52:58", "text": "既にここにいる。"}]
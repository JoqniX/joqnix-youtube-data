[{"type": "subtitle", "time": 6181.669, "timestamp": "01:43:01", "text": "以前はそうだった。"}, {"type": "subtitle", "time": 6184.47, "timestamp": "01:43:04", "text": "もちろんさ。うん。また、私は"}, {"type": "subtitle", "time": 6186.31, "timestamp": "01:43:06", "text": "さらに、黒色も"}, {"type": "subtitle", "time": 6188.709, "timestamp": "01:43:08", "text": "ここにも液体が流れ込んでいる。彼らは手に入れている"}, {"type": "subtitle", "time": 6190.47, "timestamp": "01:43:10", "text": "どんどん人が集まってきた。"}, {"type": "subtitle", "time": 6191.75, "timestamp": "01:43:11", "text": "よし、次は投げたい"}, {"type": "subtitle", "time": 6192.39, "timestamp": "01:43:12", "text": "1つ？"}, {"type": "subtitle", "time": 6195.43, "timestamp": "01:43:15", "text": "全くおかしくないよ。"}, {"type": "subtitle", "time": 6197.59, "timestamp": "01:43:17", "text": "「待って、私たちは"}, {"type": "subtitle", "time": 6198.87, "timestamp": "01:43:18", "text": "まだこれをやっているのか？待って、"}, {"type": "subtitle", "time": 6202.229, "timestamp": "01:43:22", "text": "たくさんあります。それは蓄積され、私は"}, {"type": "subtitle", "time": 6204.629, "timestamp": "01:43:24", "text": "私がその死体を落としたとき、それはほとんど"}, {"type": "subtitle", "time": 6208.149, "timestamp": "01:43:28", "text": "死体をつかもうと手を伸ばした。私はしません"}, {"type": "subtitle", "time": 6211.189, "timestamp": "01:43:31", "text": "生きているかもしれないと思う。"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "餌を与えている。"}, {"type": "subtitle", "time": 6215.109, "timestamp": "01:43:35", "text": "十分に餌を与えれば、私たちのことを好きになってくれるだろう。私"}, {"type": "subtitle", "time": 6217.91, "timestamp": "01:43:37", "text": "ほとんどの物事がそうであるとは思わない"}, {"type": "subtitle", "time": 6221.35, "timestamp": "01:43:41", "text": "似たような生き物を食べようとする。しかし"}, {"type": "subtitle", "time": 6223.75, "timestamp": "01:43:43", "text": "ダニの働きとダニが食べるもの"}, {"type": "subtitle", "time": 6231.03, "timestamp": "01:43:51", "text": "今のところはそうかもしれない。"}, {"type": "subtitle", "time": 6235.35, "timestamp": "01:43:55", "text": "オオカミの生態についても見ていきましょう。"}, {"type": "subtitle", "time": 6237.43, "timestamp": "01:43:57", "text": "オオカミ。"}, {"type": "subtitle", "time": 6239.51, "timestamp": "01:43:59", "text": "他の生き物を食べる生き物はたくさんいます"}]
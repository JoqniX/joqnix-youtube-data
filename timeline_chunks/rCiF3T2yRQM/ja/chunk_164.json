[{"type": "chat", "time": 9840.503, "timestamp": "02:44:00", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! definitely not Taki ~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 9840.63, "timestamp": "02:44:00", "text": "ここはスライムがいる寿司屋です。"}, {"type": "subtitle", "time": 9844.55, "timestamp": "02:44:04", "text": "ケーキに「殺す」という言葉を使いたい。"}, {"type": "subtitle", "time": 9846.469, "timestamp": "02:44:06", "text": "よし、どうぞ。"}, {"type": "subtitle", "time": 9848.07, "timestamp": "02:44:08", "text": "わかった、"}, {"type": "subtitle", "time": 9849.75, "timestamp": "02:44:09", "text": "あのね？"}, {"type": "subtitle", "time": 9851.429, "timestamp": "02:44:11", "text": "こんにちは。えっと"}, {"type": "subtitle", "time": 9855.59, "timestamp": "02:44:15", "text": "壁に挟まって動けなくなってしまった。ヘルプ。あの、助けてください。"}, {"type": "subtitle", "time": 9859.11, "timestamp": "02:44:19", "text": "壁に挟まって動けなくなってしまった。私"}, {"type": "subtitle", "time": 9861.83, "timestamp": "02:44:21", "text": "ああ、あそこだ。はい、いただきます"}, {"type": "subtitle", "time": 9865.11, "timestamp": "02:44:25", "text": "私があなたを助け出します。持続する。"}, {"type": "subtitle", "time": 9867.19, "timestamp": "02:44:27", "text": "一歩踏み出そう。クリップなし。"}, {"type": "subtitle", "time": 9868.55, "timestamp": "02:44:28", "text": "いいえ、クリップは持っていません。"}, {"type": "subtitle", "time": 9869.51, "timestamp": "02:44:29", "text": "感謝します。"}, {"type": "subtitle", "time": 9871.429, "timestamp": "02:44:31", "text": "そういうことが起こったとき、私は"}, {"type": "subtitle", "time": 9873.349, "timestamp": "02:44:33", "text": "すぐにティックもこう言う、"}, {"type": "subtitle", "time": 9875.99, "timestamp": "02:44:35", "text": "知ってるよ、まるで死にかけてるみたいに。彼はただ"}, {"type": "subtitle", "time": 9879.429, "timestamp": "02:44:39", "text": "ティックを見ない。大丈夫ですか？"}, {"type": "subtitle", "time": 9883.67, "timestamp": "02:44:43", "text": "ああ、ちょっと出過ぎたね。"}, {"type": "subtitle", "time": 9885.349, "timestamp": "02:44:45", "text": "大丈夫です。"}, {"type": "subtitle", "time": 9887.269, "timestamp": "02:44:47", "text": "それは"}, {"type": "subtitle", "time": 9890.55, "timestamp": "02:44:50", "text": "そちらへ伺ってもいいですか？ああ、それは普通のことなの？"}, {"type": "subtitle", "time": 9892.63, "timestamp": "02:44:52", "text": "ここに来て。ああ、心配しないでください。"}, {"type": "subtitle", "time": 9897.269, "timestamp": "02:44:57", "text": "私はあなたの手を私自身に委ねます。"}, {"type": "subtitle", "time": 9899.67, "timestamp": "02:44:59", "text": "心配しないでください、先生。私は遊んでいます 私は遊んでいません"}]
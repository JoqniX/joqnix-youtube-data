[{"type": "subtitle", "time": 5520.07, "timestamp": "01:32:00", "text": "彼がどれほど親切か"}, {"type": "subtitle", "time": 5521.99, "timestamp": "01:32:01", "text": "アリアナ、私は時々彼が"}, {"type": "subtitle", "time": 5528.55, "timestamp": "01:32:08", "text": "頭を水に浸して、まるで水に浮かぶように"}, {"type": "subtitle", "time": 5529.83, "timestamp": "01:32:09", "text": "リンゴ。"}, {"type": "subtitle", "time": 5532.79, "timestamp": "01:32:12", "text": "わかった。よし。えーと、開けて"}, {"type": "subtitle", "time": 5534.31, "timestamp": "01:32:14", "text": "もう一度蛇口をひねる。今回は"}, {"type": "subtitle", "time": 5537.51, "timestamp": "01:32:17", "text": "出てくるのは黒色だ。もう一度20面ダイスを1つ振ってください。"}, {"type": "subtitle", "time": 5547.91, "timestamp": "01:32:27", "text": "よし。わかった。えっと、酸はありますか？"}, {"type": "subtitle", "time": 5550.39, "timestamp": "01:32:30", "text": "抵抗？お前は、お前は、クソを奪う"}, {"type": "subtitle", "time": 5553.27, "timestamp": "01:32:33", "text": "酸による損傷。"}, {"type": "subtitle", "time": 5555.03, "timestamp": "01:32:35", "text": "おっと。持続する。うっかり"}, {"type": "subtitle", "time": 5557.11, "timestamp": "01:32:37", "text": "誤って削除"}, {"type": "subtitle", "time": 5559.83, "timestamp": "01:32:39", "text": "何てことだ。クソから削除される"}, {"type": "subtitle", "time": 5562.47, "timestamp": "01:32:42", "text": "ああ、彼は行ってしまった。"}, {"type": "subtitle", "time": 5564.39, "timestamp": "01:32:44", "text": "ええ、どういうわけかトークンは"}, {"type": "subtitle", "time": 5566.39, "timestamp": "01:32:46", "text": "ちょっとおかしいけど、うん、私は"}, {"type": "subtitle", "time": 5567.99, "timestamp": "01:32:47", "text": "計算。なぜそうではなかったのか分かりません"}, {"type": "subtitle", "time": 5569.75, "timestamp": "01:32:49", "text": "ちょっと変なことやってるけど、まあね。"}, {"type": "subtitle", "time": 5572.149, "timestamp": "01:32:52", "text": "そうそう。いいえ、彼は持っていません。"}, {"type": "subtitle", "time": 5573.59, "timestamp": "01:32:53", "text": "何かありますか？"}, {"type": "subtitle", "time": 5574.79, "timestamp": "01:32:54", "text": "わかった、"}, {"type": "subtitle", "time": 5577.669, "timestamp": "01:32:57", "text": "待って。竜の回復力とは何ですか？私"}, {"type": "subtitle", "time": 5578.47, "timestamp": "01:32:58", "text": "実のところ、よくわからない。"}]
[{"type": "subtitle", "time": 421.83, "timestamp": "00:07:01", "text": "私はただ「はい」と答えただけです。神様、あなたがそうしてくれてよかった。私"}, {"type": "subtitle", "time": 423.749, "timestamp": "00:07:03", "text": "私はただ、"}, {"type": "subtitle", "time": 425.83, "timestamp": "00:07:05", "text": "えっと、カイに轢かれた。私の足の上を走った"}, {"type": "subtitle", "time": 428.15, "timestamp": "00:07:08", "text": "前に、そしてそれはいくつかのように潰れた"}, {"type": "subtitle", "time": 430.07, "timestamp": "00:07:10", "text": "足の骨が折れて、ギプスをしていた"}, {"type": "subtitle", "time": 432.309, "timestamp": "00:07:12", "text": "何ヶ月もの間。"}, {"type": "subtitle", "time": 434.95, "timestamp": "00:07:14", "text": "さあ行こう。"}, {"type": "subtitle", "time": 437.589, "timestamp": "00:07:17", "text": "一度殴られたけど、どういうわけか実際に"}, {"type": "subtitle", "time": 440.55, "timestamp": "00:07:20", "text": "何も壊さなかった。たぶん"}, {"type": "subtitle", "time": 443.27, "timestamp": "00:07:23", "text": "衝撃を受けた、まるで体が"}, {"type": "subtitle", "time": 446.07, "timestamp": "00:07:26", "text": "では、それを何と呼ぶのでしょうか？リラックスした時"}, {"type": "subtitle", "time": 447.67, "timestamp": "00:07:27", "text": "被弾した。"}, {"type": "subtitle", "time": 448.79, "timestamp": "00:07:28", "text": "猫の骨。"}, {"type": "subtitle", "time": 451.189, "timestamp": "00:07:31", "text": "うん。私の体は全く緊張していなかった"}, {"type": "subtitle", "time": 452.87, "timestamp": "00:07:32", "text": "私は、"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "殴られた時に解離して、"}, {"type": "subtitle", "time": 457.909, "timestamp": "00:07:37", "text": "すでに"}, {"type": "subtitle", "time": 459.67, "timestamp": "00:07:39", "text": "攻撃を受けて、私は横にいました"}, {"type": "subtitle", "time": 461.51, "timestamp": "00:07:41", "text": "道路"}, {"type": "subtitle", "time": 463.43, "timestamp": "00:07:43", "text": "体が緊張していなかったから"}, {"type": "subtitle", "time": 465.11, "timestamp": "00:07:45", "text": "それについて。どうやらそれが理由らしい"}, {"type": "subtitle", "time": 467.029, "timestamp": "00:07:47", "text": "なぜ俺は骨折しなかったのか。"}, {"type": "subtitle", "time": 469.51, "timestamp": "00:07:49", "text": "痛いけど、何も壊してないよ。私"}, {"type": "subtitle", "time": 471.35, "timestamp": "00:07:51", "text": "緊張していなかった。"}, {"type": "subtitle", "time": 474.07, "timestamp": "00:07:54", "text": "だから次にあなたが殴られそうになったら"}, {"type": "subtitle", "time": 475.99, "timestamp": "00:07:55", "text": "そんなこと考えるなよ。"}, {"type": "subtitle", "time": 477.749, "timestamp": "00:07:57", "text": "ただ、現実から切り離すんだ。"}, {"type": "subtitle", "time": 479.749, "timestamp": "00:07:59", "text": "その通り。めちゃくちゃ効くよ。"}]
[{"type": "subtitle", "time": 5041.669, "timestamp": "01:24:01", "text": "以上です。"}, {"type": "subtitle", "time": 5043.35, "timestamp": "01:24:03", "text": "彼は空を見上げて"}, {"type": "subtitle", "time": 5052.55, "timestamp": "01:24:12", "text": "ティックの口を覆って"}, {"type": "subtitle", "time": 5055.83, "timestamp": "01:24:15", "text": "「ダメだ、ダメだ、ティック。やめて。」あなた"}, {"type": "subtitle", "time": 5057.27, "timestamp": "01:24:17", "text": "知る、"}, {"type": "subtitle", "time": 5058.87, "timestamp": "01:24:18", "text": "電話しないよ"}, {"type": "subtitle", "time": 5061.75, "timestamp": "01:24:21", "text": "ここに何かを挿入してください。"}, {"type": "subtitle", "time": 5064.149, "timestamp": "01:24:24", "text": "それ"}, {"type": "subtitle", "time": 5067.43, "timestamp": "01:24:27", "text": "わかった、"}, {"type": "subtitle", "time": 5070.87, "timestamp": "01:24:30", "text": "それをやめなさい。"}, {"type": "subtitle", "time": 5073.51, "timestamp": "01:24:33", "text": "よし、部屋に到着した。この"}, {"type": "subtitle", "time": 5075.11, "timestamp": "01:24:35", "text": "部屋にはたくさんの死体がある"}, {"type": "subtitle", "time": 5076.87, "timestamp": "01:24:36", "text": "地面。ええと、それはとても似ています"}, {"type": "subtitle", "time": 5079.75, "timestamp": "01:24:39", "text": "以前見た死体は"}, {"type": "subtitle", "time": 5081.51, "timestamp": "01:24:41", "text": "この部屋を指さすと、"}, {"type": "subtitle", "time": 5084.55, "timestamp": "01:24:44", "text": "ベタベタした部屋。そしてそれらはすべてとても"}, {"type": "subtitle", "time": 5086.229, "timestamp": "01:24:46", "text": "そこにはたくさんの磁石がある"}, {"type": "subtitle", "time": 5088.709, "timestamp": "01:24:48", "text": "全員です。こちらの真ん中で、"}, {"type": "subtitle", "time": 5091.03, "timestamp": "01:24:51", "text": "ガラス製の囲いがある"}, {"type": "subtitle", "time": 5093.27, "timestamp": "01:24:53", "text": "中には泡立つ黒い液体が入っていた。"}, {"type": "subtitle", "time": 5095.11, "timestamp": "01:24:55", "text": "小さなもののようなものがあります"}, {"type": "subtitle", "time": 5097.189, "timestamp": "01:24:57", "text": "反対側の革は"}]
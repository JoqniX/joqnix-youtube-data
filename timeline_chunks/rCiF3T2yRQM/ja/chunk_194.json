[{"type": "subtitle", "time": 11641.51, "timestamp": "03:14:01", "text": "文字通り私より優れている。"}, {"type": "subtitle", "time": 11644.389, "timestamp": "03:14:04", "text": "それは今となっては紛れもない事実だ"}, {"type": "subtitle", "time": 11646.95, "timestamp": "03:14:06", "text": "クリスピンの方が断然いい。彼は"}, {"type": "subtitle", "time": 11650.07, "timestamp": "03:14:10", "text": "そのキャラクターは1人だけ。彼は"}, {"type": "subtitle", "time": 11653.19, "timestamp": "03:14:13", "text": "実際は喧嘩が好きで、SMはそうではない"}, {"type": "subtitle", "time": 11656.55, "timestamp": "03:14:16", "text": "本当にできる限り戦う。そして私は"}, {"type": "subtitle", "time": 11658.15, "timestamp": "03:14:18", "text": "ここで私のターンを終了します。"}, {"type": "subtitle", "time": 11663.269, "timestamp": "03:14:23", "text": "わかった。そしてアリアナ、あなたは引っ張られる。"}, {"type": "subtitle", "time": 11665.03, "timestamp": "03:14:25", "text": "わかった。私はしません。"}, {"type": "subtitle", "time": 11667.03, "timestamp": "03:14:27", "text": "大丈夫です。あなたはしない。引っ張られる"}, {"type": "subtitle", "time": 11668.229, "timestamp": "03:14:28", "text": "こちらです。"}, {"type": "subtitle", "time": 11669.99, "timestamp": "03:14:29", "text": "よし。私はただ"}, {"type": "subtitle", "time": 11672.07, "timestamp": "03:14:32", "text": "歩いて登ってください。"}, {"type": "subtitle", "time": 11673.59, "timestamp": "03:14:33", "text": "えっと"}, {"type": "subtitle", "time": 11677.03, "timestamp": "03:14:37", "text": "親密で素敵な雰囲気。ええと、私は"}, {"type": "subtitle", "time": 11679.99, "timestamp": "03:14:39", "text": "近接戦闘の人なので"}, {"type": "subtitle", "time": 11687.349, "timestamp": "03:14:47", "text": "近接攻撃をしている時の私。大丈夫。先ほども申し上げたように、"}, {"type": "subtitle", "time": 11689.83, "timestamp": "03:14:49", "text": "クリスティーンを殴る必要がある場合は、"}, {"type": "subtitle", "time": 11693.75, "timestamp": "03:14:53", "text": "可能です。クリスティンは自分の仕事をやり遂げた。"}, {"type": "subtitle", "time": 11695.269, "timestamp": "03:14:55", "text": "わかった、じゃあ私は"}, {"type": "subtitle", "time": 11699.269, "timestamp": "03:14:59", "text": "呼吸困難発作。ええと、わかりました。"}]
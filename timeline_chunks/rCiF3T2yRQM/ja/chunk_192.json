[{"type": "subtitle", "time": 11520.87, "timestamp": "03:12:00", "text": "そして今のところ、我々は人々と戦ったことはない。"}, {"type": "subtitle", "time": 11523.51, "timestamp": "03:12:03", "text": "スライムも内面は人間と同じだ。"}, {"type": "subtitle", "time": 11525.349, "timestamp": "03:12:05", "text": "いいえ、違います。彼らは持っていない"}, {"type": "subtitle", "time": 11527.19, "timestamp": "03:12:07", "text": "クソ脳。彼らには心がない。"}, {"type": "subtitle", "time": 11528.79, "timestamp": "03:12:08", "text": "黙れ。"}, {"type": "subtitle", "time": 11532.469, "timestamp": "03:12:12", "text": "忘れた。あなたは私たちにこれを信じさせた。"}, {"type": "subtitle", "time": 11535.83, "timestamp": "03:12:15", "text": "こちらでは満腹状態です。えっと、まだ"}, {"type": "subtitle", "time": 11538.51, "timestamp": "03:12:18", "text": "ピカチュウを食べろ。"}, {"type": "subtitle", "time": 11545.03, "timestamp": "03:12:25", "text": "ここで何ができますか？"}, {"type": "subtitle", "time": 11547.349, "timestamp": "03:12:27", "text": "はい。ありがとう、ティック。"}, {"type": "subtitle", "time": 11556.309, "timestamp": "03:12:36", "text": "[音楽]"}, {"type": "subtitle", "time": 11559.91, "timestamp": "03:12:39", "text": "もしそれらが機能すれば、そうはならないだろう。"}, {"type": "subtitle", "time": 11561.99, "timestamp": "03:12:41", "text": "うんうん。"}, {"type": "subtitle", "time": 11565.349, "timestamp": "03:12:45", "text": "何かすることを探そうと必死だ。"}, {"type": "subtitle", "time": 11568.23, "timestamp": "03:12:48", "text": "ねえ、クリスティン？動けよ。"}, {"type": "subtitle", "time": 11569.51, "timestamp": "03:12:49", "text": "あなたは動くことができます。"}, {"type": "subtitle", "time": 11571.99, "timestamp": "03:12:51", "text": "おい、偵察隊を先に送ってもいいぞ。"}, {"type": "subtitle", "time": 11573.99, "timestamp": "03:12:53", "text": "うん。"}, {"type": "subtitle", "time": 11575.99, "timestamp": "03:12:55", "text": "わからない。あのね？もうどうでもいい。"}, {"type": "subtitle", "time": 11578.389, "timestamp": "03:12:58", "text": "我々は攻撃している。"}]
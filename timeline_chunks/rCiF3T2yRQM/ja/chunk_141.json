[{"type": "subtitle", "time": 8460.95, "timestamp": "02:21:00", "text": "何かできますか？"}, {"type": "subtitle", "time": 8462.469, "timestamp": "02:21:02", "text": "これ。"}, {"type": "subtitle", "time": 8463.99, "timestamp": "02:21:03", "text": "ええ、それが私の望みです。まさにその通りです"}, {"type": "subtitle", "time": 8465.429, "timestamp": "02:21:05", "text": "私が欲しいもの。ありがとう。"}, {"type": "subtitle", "time": 8469.349, "timestamp": "02:21:09", "text": "わかった。よし。えっと、"}, {"type": "subtitle", "time": 8470.469, "timestamp": "02:21:10", "text": "わかった。"}, {"type": "subtitle", "time": 8473.349, "timestamp": "02:21:13", "text": "では、わかりました。あなたは、えっと、"}, {"type": "subtitle", "time": 8475.83, "timestamp": "02:21:15", "text": "怖がらせる"}, {"type": "subtitle", "time": 8477.59, "timestamp": "02:21:17", "text": "液体、"}, {"type": "subtitle", "time": 8480.55, "timestamp": "02:21:20", "text": "でも、それはフェーズではないようです。それはただ"}, {"type": "subtitle", "time": 8483.429, "timestamp": "02:21:23", "text": "免疫があるように感じる"}, {"type": "subtitle", "time": 8485.67, "timestamp": "02:21:25", "text": "恐ろしかった。"}, {"type": "subtitle", "time": 8486.63, "timestamp": "02:21:26", "text": "うわあ、賢いね。"}, {"type": "subtitle", "time": 8489.11, "timestamp": "02:21:29", "text": "誰が免疫を持っていないか知っていますか？"}, {"type": "subtitle", "time": 8496.79, "timestamp": "02:21:36", "text": "そうそう。一人だけ実在した男がいた。"}, {"type": "subtitle", "time": 8499.349, "timestamp": "02:21:39", "text": "クリスマスがあることを忘れていました。"}, {"type": "subtitle", "time": 8502.469, "timestamp": "02:21:42", "text": "何てことだ。"}, {"type": "subtitle", "time": 8504.389, "timestamp": "02:21:44", "text": "時計"}, {"type": "subtitle", "time": 8513.11, "timestamp": "02:21:53", "text": "クリスティはスライムよりも怖がっている。"}, {"type": "subtitle", "time": 8513.91, "timestamp": "02:21:53", "text": "何てことだ。"}, {"type": "subtitle", "time": 8515.83, "timestamp": "02:21:55", "text": "おお"}, {"type": "subtitle", "time": 8517.59, "timestamp": "02:21:57", "text": "リチャードはDアクションを取り、"}, {"type": "subtitle", "time": 8519.19, "timestamp": "02:21:59", "text": "最も安全なルートであなたから離れる"}]
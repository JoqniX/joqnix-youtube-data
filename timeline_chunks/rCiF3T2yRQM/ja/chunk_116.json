[{"type": "subtitle", "time": 6961.03, "timestamp": "01:56:01", "text": "可能性としては３つあると思う"}, {"type": "subtitle", "time": 6962.47, "timestamp": "01:56:02", "text": "私たちにはできる。すべてを置くことができます"}, {"type": "subtitle", "time": 6964.47, "timestamp": "01:56:04", "text": "黒い液体の中に浮かぶ死体。何を見るか"}, {"type": "subtitle", "time": 6967.109, "timestamp": "01:56:07", "text": "起こる。ええと、でも私はそう思います"}, {"type": "subtitle", "time": 6970.229, "timestamp": "01:56:10", "text": "それは良くない考えかもしれない。"}, {"type": "subtitle", "time": 6974.31, "timestamp": "01:56:14", "text": "私たちは肉体の廊下を進むことができる"}, {"type": "subtitle", "time": 6976.55, "timestamp": "01:56:16", "text": "または、もっと"}, {"type": "subtitle", "time": 6978.79, "timestamp": "01:56:18", "text": "穴に流れ込む黒い液体"}, {"type": "subtitle", "time": 6981.189, "timestamp": "01:56:21", "text": "マネキンが壊れていたのは、動いていたからである"}, {"type": "subtitle", "time": 6983.83, "timestamp": "01:56:23", "text": "そこには。"}, {"type": "subtitle", "time": 6986.709, "timestamp": "01:56:26", "text": "このやり方"}, {"type": "subtitle", "time": 6988.87, "timestamp": "01:56:28", "text": "我々はただ走り続けることができるし"}, {"type": "subtitle", "time": 6991.03, "timestamp": "01:56:31", "text": "黒い液体を避けて、ゆっくりと"}, {"type": "subtitle", "time": 6994.07, "timestamp": "01:56:34", "text": "死体を鍋に入れると"}, {"type": "subtitle", "time": 7001.03, "timestamp": "01:56:41", "text": "つまり、両方を同時に行うことができたということです。"}, {"type": "subtitle", "time": 7004.07, "timestamp": "01:56:44", "text": "それはちょっと危険だと思う"}, {"type": "subtitle", "time": 7006.87, "timestamp": "01:56:46", "text": "なぜなら、黒い液体が"}, {"type": "subtitle", "time": 7008.87, "timestamp": "01:56:48", "text": "生きているのと同じように、私たちが"}, {"type": "subtitle", "time": 7011.109, "timestamp": "01:56:51", "text": "背を向けて戻る"}, {"type": "subtitle", "time": 7012.87, "timestamp": "01:56:52", "text": "私たちは彼ら全員から来たのです"}, {"type": "subtitle", "time": 7014.39, "timestamp": "01:56:54", "text": "我々を攻撃している。"}, {"type": "subtitle", "time": 7016.79, "timestamp": "01:56:56", "text": "我々4人と彼らの1人。"}]
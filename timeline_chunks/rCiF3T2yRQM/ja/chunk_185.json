[{"type": "subtitle", "time": 11101.19, "timestamp": "03:05:01", "text": "状況は良くない。つまり、"}, {"type": "subtitle", "time": 11104.55, "timestamp": "03:05:04", "text": "DC5だから助かるんだ。"}, {"type": "subtitle", "time": 11106.15, "timestamp": "03:05:06", "text": "やったー。ダメージ。"}, {"type": "subtitle", "time": 11107.59, "timestamp": "03:05:07", "text": "完全な損傷。"}, {"type": "subtitle", "time": 11109.269, "timestamp": "03:05:09", "text": "ダメージ。"}, {"type": "subtitle", "time": 11111.99, "timestamp": "03:05:11", "text": "彼らは完全なダメージを受ける。 2d10です。"}, {"type": "subtitle", "time": 11113.91, "timestamp": "03:05:13", "text": "ところで、輝いていますね。"}, {"type": "subtitle", "time": 11116.63, "timestamp": "03:05:16", "text": "ああ、やらなきゃいけないんだ。"}, {"type": "subtitle", "time": 11119.51, "timestamp": "03:05:19", "text": "はい。うん、転がさないといけない"}, {"type": "subtitle", "time": 11121.349, "timestamp": "03:05:21", "text": "技術的にはできるけど、それは"}, {"type": "subtitle", "time": 11125.19, "timestamp": "03:05:25", "text": "楽しい。転がすんだ。"}, {"type": "subtitle", "time": 11127.83, "timestamp": "03:05:27", "text": "わかった。よし。そして彼らは10に行く"}, {"type": "subtitle", "time": 11131.03, "timestamp": "03:05:31", "text": "ダメージ。よし。えっと"}, {"type": "subtitle", "time": 11133.59, "timestamp": "03:05:33", "text": "この姿勢をとってください。"}, {"type": "subtitle", "time": 11137.83, "timestamp": "03:05:37", "text": "最小ダメージをさらに増やすことはできますか？"}, {"type": "subtitle", "time": 11139.91, "timestamp": "03:05:39", "text": "よし。一度それが起こると、あなたは気づく"}, {"type": "subtitle", "time": 11142.71, "timestamp": "03:05:42", "text": "これ、これ。ああ、あのパチンという音と"}, {"type": "subtitle", "time": 11144.71, "timestamp": "03:05:44", "text": "その前に。前面のスナップボタンで"}, {"type": "subtitle", "time": 11145.91, "timestamp": "03:05:45", "text": "それ。"}, {"type": "subtitle", "time": 11156.95, "timestamp": "03:05:56", "text": "電源を切る必要があると思います"}, {"type": "subtitle", "time": 11159.39, "timestamp": "03:05:59", "text": "鎖。"}]
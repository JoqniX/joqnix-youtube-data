[{"type": "subtitle", "time": 12000.55, "timestamp": "03:20:00", "text": "腸。"}, {"type": "subtitle", "time": 12003.75, "timestamp": "03:20:03", "text": "よし。わかった。うん。それは、それは開きます"}, {"type": "subtitle", "time": 12010.9, "timestamp": "03:20:10", "text": "新しい部品。"}, {"type": "subtitle", "time": 12013.83, "timestamp": "03:20:13", "text": "[音楽]"}, {"type": "subtitle", "time": 12015.269, "timestamp": "03:20:15", "text": "わかった。ああ、神様。"}, {"type": "subtitle", "time": 12018.15, "timestamp": "03:20:18", "text": "新しい部品。胃の新しい部分。"}, {"type": "subtitle", "time": 12021.03, "timestamp": "03:20:21", "text": "おい。"}, {"type": "subtitle", "time": 12024.07, "timestamp": "03:20:24", "text": "よし。他に何かあなたの番ですか？"}, {"type": "subtitle", "time": 12027.03, "timestamp": "03:20:27", "text": "えっと、ここにはモンスターはいないんですよね？私"}, {"type": "subtitle", "time": 12028.309, "timestamp": "03:20:28", "text": "見えない。わかった。"}, {"type": "subtitle", "time": 12029.51, "timestamp": "03:20:29", "text": "いいえ。"}, {"type": "subtitle", "time": 12029.83, "timestamp": "03:20:29", "text": "わかった。"}, {"type": "subtitle", "time": 12031.59, "timestamp": "03:20:31", "text": "あなたはあと10フィートほど残しました"}, {"type": "subtitle", "time": 12032.95, "timestamp": "03:20:32", "text": "動き。"}, {"type": "subtitle", "time": 12035.03, "timestamp": "03:20:35", "text": "ああ、そうだったよ。"}, {"type": "subtitle", "time": 12037.269, "timestamp": "03:20:37", "text": "わかった。中に入りたいですか？"}, {"type": "subtitle", "time": 12038.79, "timestamp": "03:20:38", "text": "えっと、"}, {"type": "subtitle", "time": 12040.79, "timestamp": "03:20:40", "text": "穴に入る。"}, {"type": "subtitle", "time": 12044.07, "timestamp": "03:20:44", "text": "穴に入る"}, {"type": "subtitle", "time": 12046.87, "timestamp": "03:20:46", "text": "無限の彼方へ。"}, {"type": "subtitle", "time": 12048.469, "timestamp": "03:20:48", "text": "一人の女性が行く。"}, {"type": "subtitle", "time": 12050.87, "timestamp": "03:20:50", "text": "銃撃されるだろう。"}, {"type": "subtitle", "time": 12053.19, "timestamp": "03:20:53", "text": "よし。"}, {"type": "subtitle", "time": 12054.71, "timestamp": "03:20:54", "text": "ああ、私たちはどちらかというとそれを求めているんです。"}, {"type": "subtitle", "time": 12056.87, "timestamp": "03:20:56", "text": "はい、どうぞ。うん。はい、どうぞ。うん。"}, {"type": "subtitle", "time": 12058.63, "timestamp": "03:20:58", "text": "よし。それが、あなたが見ているものです。分かりますか"}]
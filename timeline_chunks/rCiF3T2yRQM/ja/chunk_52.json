[{"type": "subtitle", "time": 3120.069, "timestamp": "00:52:00", "text": "君が転がってくれて嬉しいよ。"}, {"type": "subtitle", "time": 3121.27, "timestamp": "00:52:01", "text": "見せてあげるよ。うん。いや、いや。ただ"}, {"type": "subtitle", "time": 3122.79, "timestamp": "00:52:02", "text": "明かしましょう。明かしましょう。"}, {"type": "subtitle", "time": 3128.79, "timestamp": "00:52:08", "text": "なんてこった。"}, {"type": "subtitle", "time": 3131.99, "timestamp": "00:52:11", "text": "それを見たよ。"}, {"type": "subtitle", "time": 3133.589, "timestamp": "00:52:13", "text": "私はただ調べていただけです。私はただ"}, {"type": "subtitle", "time": 3134.63, "timestamp": "00:52:14", "text": "調査中。そして彼女は震えるだろう"}, {"type": "subtitle", "time": 3135.91, "timestamp": "00:52:15", "text": "それを振り払おうとして"}, {"type": "subtitle", "time": 3137.75, "timestamp": "00:52:17", "text": "指。"}, {"type": "subtitle", "time": 3141.03, "timestamp": "00:52:21", "text": "コバルトがするようなことはしないでください。"}, {"type": "subtitle", "time": 3144.23, "timestamp": "00:52:24", "text": "あなたは人間です。それは人間が"}, {"type": "subtitle", "time": 3150.47, "timestamp": "00:52:30", "text": "私はただ立ち去って"}, {"type": "subtitle", "time": 3152.63, "timestamp": "00:52:32", "text": "少しがっかりした。"}, {"type": "subtitle", "time": 3156.87, "timestamp": "00:52:36", "text": "入ってきて、全部すすり尽くす。"}, {"type": "subtitle", "time": 3161.109, "timestamp": "00:52:41", "text": "大丈夫だよ。私たちは必要としません"}, {"type": "subtitle", "time": 3164.63, "timestamp": "00:52:44", "text": "私たちの食生活。食料はたくさんあります。"}, {"type": "subtitle", "time": 3166.79, "timestamp": "00:52:46", "text": "もっと食べ物をもらってもいいですよ。"}, {"type": "subtitle", "time": 3171.829, "timestamp": "00:52:51", "text": "なんてこった。"}, {"type": "subtitle", "time": 3173.99, "timestamp": "00:52:53", "text": "ほら、これを見てください。この古代のものを見てください"}, {"type": "subtitle", "time": 3177.51, "timestamp": "00:52:57", "text": "床にいる猫の描写。"}]
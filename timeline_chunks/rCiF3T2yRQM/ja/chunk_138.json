[{"type": "subtitle", "time": 8281.509, "timestamp": "02:18:01", "text": "わかった。彼らは全員成功した。つまり、"}, {"type": "subtitle", "time": 8282.79, "timestamp": "02:18:02", "text": "もし私がそうしなければ、ダメージは半分になるだろう"}, {"type": "subtitle", "time": 8284.549, "timestamp": "02:18:04", "text": "間違いです。成功。"}, {"type": "subtitle", "time": 8286.15, "timestamp": "02:18:06", "text": "わかった。ダメージロールを今すぐ実行してください。"}, {"type": "subtitle", "time": 8290.469, "timestamp": "02:18:10", "text": "なんてこった。ダメージ。"}, {"type": "subtitle", "time": 8292.389, "timestamp": "02:18:12", "text": "ロール。"}, {"type": "subtitle", "time": 8295.27, "timestamp": "02:18:15", "text": "よし。それを見せてもいいですか？持続する。"}, {"type": "subtitle", "time": 8296.79, "timestamp": "02:18:16", "text": "皆に明かす。これを適用します"}, {"type": "subtitle", "time": 8298.469, "timestamp": "02:18:18", "text": "全員に直ちに通知します。だから、あなたは"}, {"type": "subtitle", "time": 8300.469, "timestamp": "02:18:20", "text": "クレシン卿に応募する必要がある"}, {"type": "subtitle", "time": 8303.03, "timestamp": "02:18:23", "text": "また。すべて適用してみましょう。さぁ行こう。"}, {"type": "subtitle", "time": 8306.389, "timestamp": "02:18:26", "text": "よし。ええと、わかりました。"}, {"type": "subtitle", "time": 8309.11, "timestamp": "02:18:29", "text": "ちょっとこれをやってみよう。この木"}, {"type": "subtitle", "time": 8312.549, "timestamp": "02:18:32", "text": "えっと、色は1色だけです。持続する。そこにいる"}, {"type": "subtitle", "time": 8315.429, "timestamp": "02:18:35", "text": "行く。"}, {"type": "subtitle", "time": 8324.389, "timestamp": "02:18:44", "text": "「ああ、いや」が好きです。いいえ。"}, {"type": "subtitle", "time": 8325.91, "timestamp": "02:18:45", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 8328.629, "timestamp": "02:18:48", "text": "強く受け止めてください。"}, {"type": "subtitle", "time": 8330.87, "timestamp": "02:18:50", "text": "よし、じゃあ私の番はこれで終わりにします。"}, {"type": "subtitle", "time": 8334.87, "timestamp": "02:18:54", "text": "わかった。よし。次の棒。あなたは"}, {"type": "subtitle", "time": 8337.509, "timestamp": "02:18:57", "text": "上。月はまだ"}, {"type": "subtitle", "time": 8339.83, "timestamp": "02:18:59", "text": "そこには。"}]
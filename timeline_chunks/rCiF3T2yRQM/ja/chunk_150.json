[{"type": "subtitle", "time": 9000.63, "timestamp": "02:30:00", "text": "あなたにできること。"}, {"type": "subtitle", "time": 9002.71, "timestamp": "02:30:02", "text": "でも、月の光を動かすこともできる"}, {"type": "subtitle", "time": 9003.59, "timestamp": "02:30:03", "text": "えーと"}, {"type": "subtitle", "time": 9005.75, "timestamp": "02:30:05", "text": "そうそう。また、再び損傷する可能性もあります。"}, {"type": "subtitle", "time": 9010.07, "timestamp": "02:30:10", "text": "うん。ご指摘ありがとうございます。おお、"}, {"type": "subtitle", "time": 9013.11, "timestamp": "02:30:13", "text": "出し入れする。"}, {"type": "subtitle", "time": 9015.27, "timestamp": "02:30:15", "text": "えっと、"}, {"type": "subtitle", "time": 9018.389, "timestamp": "02:30:18", "text": "星形を使った後、またはいいえ、私は"}, {"type": "subtitle", "time": 9020.469, "timestamp": "02:30:20", "text": "月を使って、もう一度私になりましょう。"}, {"type": "subtitle", "time": 9021.59, "timestamp": "02:30:21", "text": "月の光を使えばいいんです。"}, {"type": "subtitle", "time": 9022.87, "timestamp": "02:30:22", "text": "うん、月の光を使えばいいんだよ"}, {"type": "subtitle", "time": 9023.83, "timestamp": "02:30:23", "text": "月の光はまだそこにある。"}, {"type": "subtitle", "time": 9025.67, "timestamp": "02:30:25", "text": "また、えっと、星形は実際には"}, {"type": "subtitle", "time": 9027.349, "timestamp": "02:30:27", "text": "ちなみに、変身するんですよ。私はただ"}, {"type": "subtitle", "time": 9027.83, "timestamp": "02:30:27", "text": "確認済み。"}, {"type": "subtitle", "time": 9028.469, "timestamp": "02:30:28", "text": "おお、"}, {"type": "subtitle", "time": 9031.349, "timestamp": "02:30:31", "text": "うん。それはまるで星座を呼び寄せるかのようだ。"}, {"type": "subtitle", "time": 9033.91, "timestamp": "02:30:33", "text": "ああ、わかりました。なるほど。私はちょっと"}, {"type": "subtitle", "time": 9035.51, "timestamp": "02:30:35", "text": "変形だったと仮定します。"}, {"type": "subtitle", "time": 9038.309, "timestamp": "02:30:38", "text": "それはウォルトの形だ。ええ、それは"}, {"type": "subtitle", "time": 9041.91, "timestamp": "02:30:41", "text": "ワイルドな形、えーと、でもそれはただ"}, {"type": "subtitle", "time": 9043.27, "timestamp": "02:30:43", "text": "召喚状。"}, {"type": "subtitle", "time": 9043.99, "timestamp": "02:30:43", "text": "ああ、"}, {"type": "subtitle", "time": 9046.389, "timestamp": "02:30:46", "text": "また、ジョックと一緒に見たのですが、ジョックは"}, {"type": "subtitle", "time": 9049.03, "timestamp": "02:30:49", "text": "実際にその機能を使って"}, {"type": "subtitle", "time": 9054.389, "timestamp": "02:30:54", "text": "おお、"}, {"type": "subtitle", "time": 9056.55, "timestamp": "02:30:56", "text": "私の使い魔とは違うけど、それでも"}, {"type": "subtitle", "time": 9058.71, "timestamp": "02:30:58", "text": "おなじみ。"}]
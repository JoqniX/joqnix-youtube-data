[{"type": "subtitle", "time": 7860.47, "timestamp": "02:11:00", "text": "ボールを返す。私がガイドするとき"}, {"type": "subtitle", "time": 7862.47, "timestamp": "02:11:02", "text": "B."}, {"type": "subtitle", "time": 7864.87, "timestamp": "02:11:04", "text": "Bが誘導されると。よし。それ"}, {"type": "subtitle", "time": 7871.75, "timestamp": "02:11:11", "text": "ダメージ。"}, {"type": "subtitle", "time": 7873.189, "timestamp": "02:11:13", "text": "わかった。よし。"}, {"type": "subtitle", "time": 7874.47, "timestamp": "02:11:14", "text": "17."}, {"type": "subtitle", "time": 7876.149, "timestamp": "02:11:16", "text": "それを適用してください。わかった。"}, {"type": "subtitle", "time": 7879.27, "timestamp": "02:11:19", "text": "まだ一人残っている。"}, {"type": "subtitle", "time": 7880.79, "timestamp": "02:11:20", "text": "うん。うん。"}, {"type": "subtitle", "time": 7892.83, "timestamp": "02:11:32", "text": "それを回してください。"}, {"type": "subtitle", "time": 7896.069, "timestamp": "02:11:36", "text": "[音楽]"}, {"type": "subtitle", "time": 7899.51, "timestamp": "02:11:39", "text": "よし。チーン。"}, {"type": "subtitle", "time": 7902.55, "timestamp": "02:11:42", "text": "よし。そうしましょう。"}, {"type": "subtitle", "time": 7906.95, "timestamp": "02:11:46", "text": "わかった。いいね。よし。えっと、これが"}, {"type": "subtitle", "time": 7908.39, "timestamp": "02:11:48", "text": "えっと、あなたがそうしたとき、実際に"}, {"type": "subtitle", "time": 7912.95, "timestamp": "02:11:52", "text": "えっと、これを素早くやってください。信じるよ、ああ、"}, {"type": "subtitle", "time": 7914.79, "timestamp": "02:11:54", "text": "持続する。待って。オブジェクトは"}, {"type": "subtitle", "time": 7919.51, "timestamp": "02:11:59", "text": "無効？はい、どうぞ。さあ、やろう。"}]
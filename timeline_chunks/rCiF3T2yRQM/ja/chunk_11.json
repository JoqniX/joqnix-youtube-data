[{"type": "subtitle", "time": 662.069, "timestamp": "00:11:02", "text": "こんにちは。"}, {"type": "subtitle", "time": 665.03, "timestamp": "00:11:05", "text": "私はただ「こんにちは」と言うだけです。どこ"}, {"type": "subtitle", "time": 667.59, "timestamp": "00:11:07", "text": "君はどこから来たの、ちびっ子？"}, {"type": "subtitle", "time": 670.55, "timestamp": "00:11:10", "text": "私は女の子です。元気ですか？"}, {"type": "subtitle", "time": 673.11, "timestamp": "00:11:13", "text": "なんてこった。南部出身者だ。"}, {"type": "subtitle", "time": 680.63, "timestamp": "00:11:20", "text": "それが間違っていないという事実。"}, {"type": "subtitle", "time": 691.269, "timestamp": "00:11:31", "text": "何てことだ。私は話しません。"}, {"type": "subtitle", "time": 692.79, "timestamp": "00:11:32", "text": "すごく面白い。"}, {"type": "subtitle", "time": 694.949, "timestamp": "00:11:34", "text": "ロータスを捕まえてこう言うだろう、"}, {"type": "subtitle", "time": 696.87, "timestamp": "00:11:36", "text": "「ええと、こちらは私の師匠、ロータス師匠です。"}, {"type": "subtitle", "time": 698.87, "timestamp": "00:11:38", "text": "そしてこちらは私の友人、エステバンです。"}, {"type": "subtitle", "time": 700.15, "timestamp": "00:11:40", "text": "ジョックです。"}, {"type": "subtitle", "time": 700.71, "timestamp": "00:11:40", "text": "こんにちは。"}, {"type": "subtitle", "time": 709.19, "timestamp": "00:11:49", "text": "ヴァンヴァンはただチクチクと音を立てて、それからただ"}, {"type": "subtitle", "time": 711.829, "timestamp": "00:11:51", "text": "ほら、私が来たのは"}, {"type": "subtitle", "time": 719.67, "timestamp": "00:11:59", "text": "紛失したデスクにチェックを入れて、それからブロッサムにチェックを入れる"}]
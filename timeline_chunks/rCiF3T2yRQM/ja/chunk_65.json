[{"type": "subtitle", "time": 3900.23, "timestamp": "01:05:00", "text": "中は空っぽで、チェストのような"}, {"type": "subtitle", "time": 3903.19, "timestamp": "01:05:03", "text": "倒れて、それからこれが"}, {"type": "subtitle", "time": 3905.51, "timestamp": "01:05:05", "text": "後ろの壁の折り目が開く"}, {"type": "subtitle", "time": 3907.589, "timestamp": "01:05:07", "text": "わずかに。"}, {"type": "subtitle", "time": 3908.63, "timestamp": "01:05:08", "text": "おっと。"}, {"type": "subtitle", "time": 3909.75, "timestamp": "01:05:09", "text": "おお"}, {"type": "subtitle", "time": 3914.47, "timestamp": "01:05:14", "text": "わずかに。何か入っている。"}, {"type": "subtitle", "time": 3917.91, "timestamp": "01:05:17", "text": "この塗料を信用できるかどうか分からない。その"}, {"type": "subtitle", "time": 3924.39, "timestamp": "01:05:24", "text": "中身が一体何なのか確かめるために。"}, {"type": "subtitle", "time": 3927.75, "timestamp": "01:05:27", "text": "よし。それで、えっと、何をするんですか？"}, {"type": "subtitle", "time": 3929.589, "timestamp": "01:05:29", "text": "これを押し進めてみたい、"}, {"type": "subtitle", "time": 3930.39, "timestamp": "01:05:30", "text": "何か、それとも胸？"}, {"type": "subtitle", "time": 3933.67, "timestamp": "01:05:33", "text": "うん。うん。えーっと、これを押して"}, {"type": "subtitle", "time": 3935.349, "timestamp": "01:05:35", "text": "なぜなら、ええと、私たちは壁を見たからです。"}, {"type": "subtitle", "time": 3937.109, "timestamp": "01:05:37", "text": "そうそう。胸部。宝箱は空っぽです。"}, {"type": "subtitle", "time": 3940.23, "timestamp": "01:05:40", "text": "しかし、壁は少し後退した。えっと"}, {"type": "subtitle", "time": 3943.67, "timestamp": "01:05:43", "text": "クリスピンがそれを押すと、これが現れる"}, {"type": "subtitle", "time": 3946.47, "timestamp": "01:05:46", "text": "それはまるで別の場所へ入っていくようだ。"}, {"type": "subtitle", "time": 3948.47, "timestamp": "01:05:48", "text": "えっと、"}, {"type": "subtitle", "time": 3951.829, "timestamp": "01:05:51", "text": "みんな、その向こうに部屋があると思う"}, {"type": "subtitle", "time": 3953.349, "timestamp": "01:05:53", "text": "彼らが話していた箱の部屋"}, {"type": "subtitle", "time": 3958.95, "timestamp": "01:05:58", "text": "ああ、くそ。"}]
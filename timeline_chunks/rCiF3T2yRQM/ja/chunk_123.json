[{"type": "subtitle", "time": 7383.03, "timestamp": "02:03:03", "text": "主導権。わかった。持続する。明らかにしましょう"}, {"type": "subtitle", "time": 7384.709, "timestamp": "02:03:04", "text": "それもそうだ。よし。それは"}, {"type": "subtitle", "time": 7386.79, "timestamp": "02:03:06", "text": "全員の主体性。"}, {"type": "subtitle", "time": 7388.55, "timestamp": "02:03:08", "text": "そのドロドロしたものは食べないでください。"}, {"type": "subtitle", "time": 7391.03, "timestamp": "02:03:11", "text": "そのドロドロしたものを食べろ。まあ、そうですね。よし、"}, {"type": "subtitle", "time": 7392.79, "timestamp": "02:03:12", "text": "行く。たぶん、"}, {"type": "subtitle", "time": 7394.55, "timestamp": "02:03:14", "text": "俺の戦闘プレイリストは一体どこにあるんだ？"}, {"type": "subtitle", "time": 7397.669, "timestamp": "02:03:17", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 7400.709, "timestamp": "02:03:20", "text": "よし、始めよう。"}, {"type": "subtitle", "time": 7401.03, "timestamp": "02:03:21", "text": "それで、"}, {"type": "subtitle", "time": 7401.589, "timestamp": "02:03:21", "text": "ああ、くそ、"}, {"type": "subtitle", "time": 7403.99, "timestamp": "02:03:23", "text": "それはドロドロした物質だ。"}, {"type": "subtitle", "time": 7405.83, "timestamp": "02:03:25", "text": "これを眠らせてください。スリープモードにしてもいいですか？"}, {"type": "subtitle", "time": 7407.589, "timestamp": "02:03:27", "text": "すぐに？"}, {"type": "subtitle", "time": 7417.669, "timestamp": "02:03:37", "text": "私はその答えを知っているが、"}, {"type": "subtitle", "time": 7419.189, "timestamp": "02:03:39", "text": "知らないふりをします"}, {"type": "subtitle", "time": 7419.75, "timestamp": "02:03:39", "text": "何でも。"}, {"type": "subtitle", "time": 7421.91, "timestamp": "02:03:41", "text": "答えは何だろう。"}, {"type": "subtitle", "time": 7425.189, "timestamp": "02:03:45", "text": "私はそのことを知っているが、そうではない。"}, {"type": "subtitle", "time": 7427.91, "timestamp": "02:03:47", "text": "正解があります。"}, {"type": "subtitle", "time": 7429.75, "timestamp": "02:03:49", "text": "私はそれが"}, {"type": "subtitle", "time": 7431.83, "timestamp": "02:03:51", "text": "脳の睡眠能力。私はそうは思わない"}, {"type": "subtitle", "time": 7433.589, "timestamp": "02:03:53", "text": "もし私が"}, {"type": "subtitle", "time": 7434.47, "timestamp": "02:03:54", "text": "正直に言ってください。"}, {"type": "subtitle", "time": 7435.75, "timestamp": "02:03:55", "text": "それはドロドロした物質だ。"}, {"type": "subtitle", "time": 7439.99, "timestamp": "02:03:59", "text": "うん。だから、私にはできないと思います。私"}]
[{"type": "subtitle", "time": 2820.55, "timestamp": "00:47:00", "text": "まあ、いずれ分かるよ"}, {"type": "subtitle", "time": 2825.109, "timestamp": "00:47:05", "text": "最終的に。心配しないで。きっと見つかりますよ。"}, {"type": "subtitle", "time": 2831.27, "timestamp": "00:47:11", "text": "ロータスはアリアナにこう言うだろう。"}, {"type": "subtitle", "time": 2833.829, "timestamp": "00:47:13", "text": "危険性について尋ねてください。"}, {"type": "subtitle", "time": 2834.71, "timestamp": "00:47:14", "text": "アリ、"}, {"type": "subtitle", "time": 2836.23, "timestamp": "00:47:16", "text": "ああ、わかった。危険はありますか？私たちは"}, {"type": "subtitle", "time": 2837.829, "timestamp": "00:47:17", "text": "注意すべき事項です。"}, {"type": "subtitle", "time": 2843.589, "timestamp": "00:47:23", "text": "おお、"}, {"type": "subtitle", "time": 2845.27, "timestamp": "00:47:25", "text": "うん。"}, {"type": "subtitle", "time": 2847.51, "timestamp": "00:47:27", "text": "はい。最後に私たちが見たもの"}, {"type": "subtitle", "time": 2850.79, "timestamp": "00:47:30", "text": "試す前に、私たちは休むように言いました"}, {"type": "subtitle", "time": 2854.63, "timestamp": "00:47:34", "text": "夜は、羊が食べられている"}, {"type": "subtitle", "time": 2857.27, "timestamp": "00:47:37", "text": "どこかにぬめりがある。"}, {"type": "subtitle", "time": 2858.069, "timestamp": "00:47:38", "text": "まあ。"}, {"type": "subtitle", "time": 2860.39, "timestamp": "00:47:40", "text": "ニース。私たちは大丈夫だ。きっとあなたは"}, {"type": "subtitle", "time": 2862.39, "timestamp": "00:47:42", "text": "男たちは対処するのに十分な能力を持っている"}, {"type": "subtitle", "time": 2863.67, "timestamp": "00:47:43", "text": "彼ら。"}, {"type": "subtitle", "time": 2865.51, "timestamp": "00:47:45", "text": "彼らはもっとうまくやるべきだ。ティックのように"}, {"type": "subtitle", "time": 2867.349, "timestamp": "00:47:47", "text": "より良い。"}, {"type": "subtitle", "time": 2869.43, "timestamp": "00:47:49", "text": "いいえ、ティック。私はもうあなたのことが好きよ。彼らは"}, {"type": "subtitle", "time": 2877.109, "timestamp": "00:47:57", "text": "ルークのビングボンに対する意図。"}]
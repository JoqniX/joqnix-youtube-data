[{"type": "subtitle", "time": 780.79, "timestamp": "00:13:00", "text": "私たちはコバルトを取るつもりですか？"}, {"type": "subtitle", "time": 787.75, "timestamp": "00:13:07", "text": "小さなトラ猫のつつき。見た目"}, {"type": "subtitle", "time": 789.59, "timestamp": "00:13:09", "text": "フォートナイトにそっくり"}, {"type": "subtitle", "time": 792.23, "timestamp": "00:13:12", "text": "ダンスもいいかも。"}, {"type": "subtitle", "time": 796.23, "timestamp": "00:13:16", "text": "ただのフォートナイトのエモートだよ。"}, {"type": "subtitle", "time": 797.19, "timestamp": "00:13:17", "text": "何てことだ。"}, {"type": "subtitle", "time": 810.55, "timestamp": "00:13:30", "text": "だからロータスはこう言うだろう、「まあ、"}, {"type": "subtitle", "time": 813.03, "timestamp": "00:13:33", "text": "猫が亡くなったので、私たちは一人減ってしまいました"}, {"type": "subtitle", "time": 821.67, "timestamp": "00:13:41", "text": "あなたは猫を飼っていましたね。それはおかしい。"}, {"type": "subtitle", "time": 823.99, "timestamp": "00:13:43", "text": "猫を見たことがない。"}, {"type": "subtitle", "time": 833.19, "timestamp": "00:13:53", "text": "彼らは通常猫を連れてくるのではないですか"}, {"type": "subtitle", "time": 834.71, "timestamp": "00:13:54", "text": "海？"}, {"type": "subtitle", "time": 837.43, "timestamp": "00:13:57", "text": "いいえ、ダニを連れてきます。"}, {"type": "subtitle", "time": 838.31, "timestamp": "00:13:58", "text": "何てことだ。"}, {"type": "subtitle", "time": 839.99, "timestamp": "00:13:59", "text": "あのね？あなたは、あなたは、"}]
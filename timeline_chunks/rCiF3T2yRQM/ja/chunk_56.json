[{"type": "subtitle", "time": 3363.349, "timestamp": "00:56:03", "text": "手を差し入れると、食べ物のような感じがするが、"}, {"type": "subtitle", "time": 3365.75, "timestamp": "00:56:05", "text": "この食べ物は、"}, {"type": "subtitle", "time": 3367.91, "timestamp": "00:56:07", "text": "夢中になった。それは召喚されたものだ。"}, {"type": "subtitle", "time": 3370.069, "timestamp": "00:56:10", "text": "まるで食べ物みたいだ。"}, {"type": "subtitle", "time": 3375.91, "timestamp": "00:56:15", "text": "食べ物が食べ物だなんて信じられない。"}, {"type": "subtitle", "time": 3377.829, "timestamp": "00:56:17", "text": "それは本物の食べ物ではない。"}, {"type": "subtitle", "time": 3379.91, "timestamp": "00:56:19", "text": "ああ、これは本物の食べ物じゃない。"}, {"type": "subtitle", "time": 3380.47, "timestamp": "00:56:20", "text": "完璧。"}, {"type": "subtitle", "time": 3381.829, "timestamp": "00:56:21", "text": "それは本物の食べ物ではない。本物みたい"}, {"type": "subtitle", "time": 3382.789, "timestamp": "00:56:22", "text": "食べ物。"}, {"type": "subtitle", "time": 3384.95, "timestamp": "00:56:24", "text": "そしてそれはそれをまっすぐ貫通する。"}, {"type": "subtitle", "time": 3386.789, "timestamp": "00:56:26", "text": "あなたはそれを完全に理解しましたか？押しつぶすことができます"}, {"type": "subtitle", "time": 3388.47, "timestamp": "00:56:28", "text": "それ。まるで食べ物みたいだ。"}, {"type": "subtitle", "time": 3390.15, "timestamp": "00:56:30", "text": "ああ、それは基本的に"}, {"type": "subtitle", "time": 3392.309, "timestamp": "00:56:32", "text": "それはまるで創造されたかのように想像した"}, {"type": "subtitle", "time": 3393.349, "timestamp": "00:56:33", "text": "これ。"}, {"type": "subtitle", "time": 3393.91, "timestamp": "00:56:33", "text": "うん。うん。"}, {"type": "subtitle", "time": 3395.91, "timestamp": "00:56:35", "text": "ジョック、君はどう？試してみたい"}, {"type": "subtitle", "time": 3397.91, "timestamp": "00:56:37", "text": "これを調査するために？"}, {"type": "subtitle", "time": 3402.63, "timestamp": "00:56:42", "text": "ええ、もちろんです。えっと、アルカナですよね？"}, {"type": "subtitle", "time": 3403.43, "timestamp": "00:56:43", "text": "うん。"}, {"type": "subtitle", "time": 3405.349, "timestamp": "00:56:45", "text": "ブラインドジャムロール。"}, {"type": "subtitle", "time": 3414.069, "timestamp": "00:56:54", "text": "わかった。よし。ええ、ジョックはそうしませんでした"}, {"type": "subtitle", "time": 3415.75, "timestamp": "00:56:55", "text": "新しい情報を本当に発信する。"}, {"type": "subtitle", "time": 3417.349, "timestamp": "00:56:57", "text": "ジョックが知っていることはすべて"}]
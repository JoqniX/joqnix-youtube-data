[{"type": "subtitle", "time": 11163.429, "timestamp": "03:06:03", "text": "[音楽]"}, {"type": "subtitle", "time": 11164.71, "timestamp": "03:06:04", "text": "わかりました。"}, {"type": "subtitle", "time": 11167.269, "timestamp": "03:06:07", "text": "ああ、私の月の光"}, {"type": "subtitle", "time": 11169.51, "timestamp": "03:06:09", "text": "電源が切れたか何かでしょう。"}, {"type": "subtitle", "time": 11172.87, "timestamp": "03:06:12", "text": "ああ、君の月、君の光線はまだそこにある"}, {"type": "subtitle", "time": 11175.51, "timestamp": "03:06:15", "text": "えーと、あと1ターンだけ、あなたが望まない限り"}, {"type": "subtitle", "time": 11176.71, "timestamp": "03:06:16", "text": "それを無視する。"}, {"type": "subtitle", "time": 11178.63, "timestamp": "03:06:18", "text": "[音楽]"}, {"type": "subtitle", "time": 11180.63, "timestamp": "03:06:20", "text": "だから、みんなで動けるようにできるんです"}, {"type": "subtitle", "time": 11181.83, "timestamp": "03:06:21", "text": "さあ、前に進もう。"}, {"type": "subtitle", "time": 11183.99, "timestamp": "03:06:23", "text": "ああ、神様。それなら却下します。"}, {"type": "subtitle", "time": 11186.389, "timestamp": "03:06:26", "text": "わかった。うん。とにかく、今気づいたんです。"}, {"type": "subtitle", "time": 11187.51, "timestamp": "03:06:27", "text": "ええ、それで却下しました。"}, {"type": "subtitle", "time": 11195.03, "timestamp": "03:06:35", "text": "終わったよ。"}, {"type": "subtitle", "time": 11196.309, "timestamp": "03:06:36", "text": "他に何か？引っ越したいですか？"}, {"type": "subtitle", "time": 11197.03, "timestamp": "03:06:37", "text": "多分？"}, {"type": "subtitle", "time": 11205.59, "timestamp": "03:06:45", "text": "30フィート。どれくらい良くなったの？どうやって？わかった。 30"}, {"type": "subtitle", "time": 11208.63, "timestamp": "03:06:48", "text": "ft. ここに引っ越します。"}, {"type": "subtitle", "time": 11210.55, "timestamp": "03:06:50", "text": "よし。心からの愛。"}, {"type": "subtitle", "time": 11212.95, "timestamp": "03:06:52", "text": "あなたもまた、"}, {"type": "subtitle", "time": 11215.83, "timestamp": "03:06:55", "text": "壁は"}, {"type": "subtitle", "time": 11219.51, "timestamp": "03:06:59", "text": "後であなたを食べようとしたり、あなたを動かそうとしたり"}]
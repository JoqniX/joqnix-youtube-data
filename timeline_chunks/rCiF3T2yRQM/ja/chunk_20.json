[{"type": "subtitle", "time": 1200.47, "timestamp": "00:20:00", "text": "どうぞご自由に"}, {"type": "subtitle", "time": 1202.23, "timestamp": "00:20:02", "text": "ちなみに、もしよろしければ、あなたも一緒に行ってもいいですよ。"}, {"type": "subtitle", "time": 1205.27, "timestamp": "00:20:05", "text": "デイム・スポーク・アビリティは何をしているのか？"}, {"type": "subtitle", "time": 1211.029, "timestamp": "00:20:11", "text": "えっと、兄貴はただただ楽しんでるだけだと思う"}, {"type": "subtitle", "time": 1213.59, "timestamp": "00:20:13", "text": "彼もパーティーで寝ていた"}, {"type": "subtitle", "time": 1218.63, "timestamp": "00:20:18", "text": "そして今はまるでストレッチをしているような感じです。"}, {"type": "subtitle", "time": 1221.029, "timestamp": "00:20:21", "text": "彼はただ、ええ、ただストレッチをしているだけです"}, {"type": "subtitle", "time": 1223.51, "timestamp": "00:20:23", "text": "今。彼は準備万端で、ヴァンは"}, {"type": "subtitle", "time": 1226.47, "timestamp": "00:20:26", "text": "まるでそれに対する笛のようだ。彼女のために笛を吹く"}, {"type": "subtitle", "time": 1228.23, "timestamp": "00:20:28", "text": "そうすれば彼女は立ち上がって、"}, {"type": "subtitle", "time": 1230.23, "timestamp": "00:20:30", "text": "知ってる？パーティーに来なよ。彼はそうしない"}, {"type": "subtitle", "time": 1233.59, "timestamp": "00:20:33", "text": "本当に、彼女と話をする必要があるんだ。"}, {"type": "subtitle", "time": 1234.07, "timestamp": "00:20:34", "text": "けっこうだ。"}, {"type": "subtitle", "time": 1234.789, "timestamp": "00:20:34", "text": "彼女はただついていく"}, {"type": "subtitle", "time": 1237.83, "timestamp": "00:20:37", "text": "私はもっ​​と調べておくべきだったし"}, {"type": "subtitle", "time": 1241.029, "timestamp": "00:20:41", "text": "あなたの電話番号を入手しました。えっと、どうぞ"}, {"type": "subtitle", "time": 1242.39, "timestamp": "00:20:42", "text": "前に進み始めて、「"}, {"type": "subtitle", "time": 1243.75, "timestamp": "00:20:43", "text": "男たちが来るの？"}, {"type": "subtitle", "time": 1245.19, "timestamp": "00:20:45", "text": "俺たちは物を手に入れた。私たちは手に入れました 私たちは手に入れました"}, {"type": "subtitle", "time": 1246.549, "timestamp": "00:20:46", "text": "冒険。"}, {"type": "subtitle", "time": 1248.39, "timestamp": "00:20:48", "text": "さあ行こう。\""}, {"type": "subtitle", "time": 1250.23, "timestamp": "00:20:50", "text": "少し問題があります。ああ、どうやら"}, {"type": "subtitle", "time": 1251.669, "timestamp": "00:20:51", "text": "どういうわけか、私は"}, {"type": "subtitle", "time": 1253.19, "timestamp": "00:20:53", "text": "トーチ。"}, {"type": "subtitle", "time": 1255.59, "timestamp": "00:20:55", "text": "あ、待って。何？何？"}, {"type": "subtitle", "time": 1256.87, "timestamp": "00:20:56", "text": "君こそが、その灯火だ。"}]
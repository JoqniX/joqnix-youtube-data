[{"type": "subtitle", "time": 1020.31, "timestamp": "00:17:00", "text": "猫。えっと、しゃべる花、そして今"}, {"type": "subtitle", "time": 1028.63, "timestamp": "00:17:08", "text": "選択。"}, {"type": "subtitle", "time": 1031.909, "timestamp": "00:17:11", "text": "それは良い選択ですね。とても良い。"}, {"type": "subtitle", "time": 1039.75, "timestamp": "00:17:19", "text": "ディックがパーティーに参加して「やったー」と言っている。"}, {"type": "subtitle", "time": 1042.23, "timestamp": "00:17:22", "text": "わーい。"}, {"type": "subtitle", "time": 1044.47, "timestamp": "00:17:24", "text": "取得しました。"}, {"type": "subtitle", "time": 1046.63, "timestamp": "00:17:26", "text": "君はチンポを手に入れた。私は持っている"}, {"type": "subtitle", "time": 1053.19, "timestamp": "00:17:33", "text": "よし。"}, {"type": "subtitle", "time": 1053.669, "timestamp": "00:17:33", "text": "良い、"}, {"type": "subtitle", "time": 1055.029, "timestamp": "00:17:35", "text": "よし。わかった。"}, {"type": "subtitle", "time": 1056.63, "timestamp": "00:17:36", "text": "では、私たちは捕まえに行くべきでしょうか"}, {"type": "subtitle", "time": 1058.789, "timestamp": "00:17:38", "text": "相手チームと合流したのか？彼らがどのように"}, {"type": "subtitle", "time": 1059.43, "timestamp": "00:17:39", "text": "実行中。"}, {"type": "subtitle", "time": 1062.63, "timestamp": "00:17:42", "text": "ああ、彼らのことをすっかり忘れていた。"}, {"type": "subtitle", "time": 1064.71, "timestamp": "00:17:44", "text": "あなたは、彼らが言ったと言った"}, {"type": "subtitle", "time": 1066.31, "timestamp": "00:17:46", "text": "彼らはあまりうまくいっていなかったし、"}, {"type": "subtitle", "time": 1069.029, "timestamp": "00:17:49", "text": "彼らは老婦人たちにちょっかいを出した。"}, {"type": "subtitle", "time": 1071.43, "timestamp": "00:17:51", "text": "まあ、彼らは老婦人たちを困らせたんだ"}, {"type": "subtitle", "time": 1073.27, "timestamp": "00:17:53", "text": "どうにか。彼らはなんとかそこから抜け出した"}, {"type": "subtitle", "time": 1074.87, "timestamp": "00:17:54", "text": "無傷で、"}, {"type": "subtitle", "time": 1077.35, "timestamp": "00:17:57", "text": "でも、私は彼らのことをよく理解できなかった"}, {"type": "subtitle", "time": 1079.99, "timestamp": "00:17:59", "text": "次の階。ほら、"}]
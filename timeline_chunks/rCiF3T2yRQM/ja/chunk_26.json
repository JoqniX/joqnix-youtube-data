[{"type": "subtitle", "time": 1563.269, "timestamp": "00:26:03", "text": "割礼。状況によって盲目になっている。"}, {"type": "subtitle", "time": 1565.11, "timestamp": "00:26:05", "text": "私たちが出発する時、アリアナは"}, {"type": "subtitle", "time": 1568.23, "timestamp": "00:26:08", "text": "「それで、ティック、君は何ができるの？」という感じ。"}, {"type": "subtitle", "time": 1572.07, "timestamp": "00:26:12", "text": "チクッ。ティックはたくさんのことをする。"}, {"type": "subtitle", "time": 1573.75, "timestamp": "00:26:13", "text": "ティックは最近、"}, {"type": "subtitle", "time": 1575.59, "timestamp": "00:26:15", "text": "どうやらこの魔法を知っていたようだ"}, {"type": "subtitle", "time": 1579.11, "timestamp": "00:26:19", "text": "時間。彼らは知らなかった。"}, {"type": "subtitle", "time": 1579.75, "timestamp": "00:26:19", "text": "おお。"}, {"type": "subtitle", "time": 1582.95, "timestamp": "00:26:22", "text": "つまり、あなたは魔法使いで、あなたは魔法使いです"}, {"type": "subtitle", "time": 1584.789, "timestamp": "00:26:24", "text": "タンク。"}, {"type": "subtitle", "time": 1586.149, "timestamp": "00:26:26", "text": "誰かが開ける前に"}, {"type": "subtitle", "time": 1587.99, "timestamp": "00:26:27", "text": "再びドアを開ける。"}, {"type": "subtitle", "time": 1590.23, "timestamp": "00:26:30", "text": "あの老婆たちを煩わせるのはやめよう"}, {"type": "subtitle", "time": 1593.029, "timestamp": "00:26:33", "text": "もう。"}, {"type": "subtitle", "time": 1600.39, "timestamp": "00:26:40", "text": "大丈夫。おばあちゃんはダニが大好き。"}, {"type": "subtitle", "time": 1602.87, "timestamp": "00:26:42", "text": "おばあちゃんたちを愛してはいけない。大丈夫。"}, {"type": "subtitle", "time": 1607.51, "timestamp": "00:26:47", "text": "あの老婦人たちは誰のことも愛していない。"}, {"type": "subtitle", "time": 1609.669, "timestamp": "00:26:49", "text": "愛してるよ。"}, {"type": "subtitle", "time": 1612.31, "timestamp": "00:26:52", "text": "私はそうは思わない。"}, {"type": "subtitle", "time": 1614.39, "timestamp": "00:26:54", "text": "そう思います。"}, {"type": "subtitle", "time": 1618.39, "timestamp": "00:26:58", "text": "ティグはただ考えているだけではなく、知っている。"}]
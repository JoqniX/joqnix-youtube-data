[{"type": "subtitle", "time": 2522.23, "timestamp": "00:42:02", "text": "実際に老人の手紙に従って、"}, {"type": "subtitle", "time": 2525.67, "timestamp": "00:42:05", "text": "それはいいですね。えっと、入ってきて"}, {"type": "subtitle", "time": 2527.75, "timestamp": "00:42:07", "text": "香りを追って。"}, {"type": "subtitle", "time": 2530.79, "timestamp": "00:42:10", "text": "まあ、彼はそうしたけど、そうだね。"}, {"type": "subtitle", "time": 2533.03, "timestamp": "00:42:13", "text": "そしてアリアナが来る"}, {"type": "subtitle", "time": 2534.87, "timestamp": "00:42:14", "text": "まさにその通り。"}, {"type": "subtitle", "time": 2539.109, "timestamp": "00:42:19", "text": "みんな休んでいるから気をつけてね。"}, {"type": "subtitle", "time": 2542.71, "timestamp": "00:42:22", "text": "その新しい友達には気をつけた方がいいよ。"}, {"type": "subtitle", "time": 2544.55, "timestamp": "00:42:24", "text": "テントの上のものに注意してください"}, {"type": "subtitle", "time": 2546.63, "timestamp": "00:42:26", "text": "そこには。"}, {"type": "subtitle", "time": 2548.47, "timestamp": "00:42:28", "text": "ジャックはテントを張る。"}, {"type": "subtitle", "time": 2552.23, "timestamp": "00:42:32", "text": "見たら"}, {"type": "subtitle", "time": 2556.069, "timestamp": "00:42:36", "text": "彼には問題がある。問題ありません。"}, {"type": "subtitle", "time": 2557.76, "timestamp": "00:42:37", "text": "問題ありません。 問題ありません。"}, {"type": "subtitle", "time": 2564.47, "timestamp": "00:42:44", "text": "他の皆は寝ているのだろうか？"}, {"type": "subtitle", "time": 2566.39, "timestamp": "00:42:46", "text": "みんな寝ている。"}, {"type": "subtitle", "time": 2569.91, "timestamp": "00:42:49", "text": "持つこと"}, {"type": "subtitle", "time": 2572.309, "timestamp": "00:42:52", "text": "そこに問題がある。いいえ、違います。"}, {"type": "subtitle", "time": 2578.63, "timestamp": "00:42:58", "text": "ダニが1匹を突く様子を想像してみてください"}]
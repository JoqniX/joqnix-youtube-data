[{"type": "subtitle", "time": 10081.11, "timestamp": "02:48:01", "text": "わかった。よし。わかった。クリスピンが"}, {"type": "subtitle", "time": 10083.349, "timestamp": "02:48:03", "text": "あっちに行くよ、うん、待ってていいよ。"}, {"type": "subtitle", "time": 10084.87, "timestamp": "02:48:04", "text": "クリスピンが見ているものが、あなたにも見えますか？"}, {"type": "subtitle", "time": 10085.99, "timestamp": "02:48:05", "text": "はい、できます。できます。"}, {"type": "subtitle", "time": 10088.07, "timestamp": "02:48:08", "text": "うん。うん。よし。わかった。こちらでは、"}, {"type": "subtitle", "time": 10090.71, "timestamp": "02:48:10", "text": "えっと、お見せしますね。そこには"}, {"type": "subtitle", "time": 10093.19, "timestamp": "02:48:13", "text": "えっと、見せて、明らかにさせてください"}, {"type": "subtitle", "time": 10106.15, "timestamp": "02:48:26", "text": "下の方にもスライムがたくさんいるよ。"}, {"type": "subtitle", "time": 10107.59, "timestamp": "02:48:27", "text": "クリスピンは"}, {"type": "subtitle", "time": 10112.389, "timestamp": "02:48:32", "text": "そこでは見えない。その点において。うん、"}, {"type": "subtitle", "time": 10115.19, "timestamp": "02:48:35", "text": "それは一般的にたくさんのスライムと"}, {"type": "subtitle", "time": 10118.23, "timestamp": "02:48:38", "text": "あなたたちの多くは、"}, {"type": "subtitle", "time": 10121.91, "timestamp": "02:48:41", "text": "私たちがそこに入ると、私たちの服は"}, {"type": "subtitle", "time": 10128.87, "timestamp": "02:48:48", "text": "相手チームがこれを残したなんて信じられない"}, {"type": "subtitle", "time": 10130.71, "timestamp": "02:48:50", "text": "私たちにとって。"}, {"type": "subtitle", "time": 10133.99, "timestamp": "02:48:53", "text": "私は本当に好きではありませんでした これは"}, {"type": "subtitle", "time": 10137.03, "timestamp": "02:48:57", "text": "今日私が求めていた体験。私は持っている"}, {"type": "subtitle", "time": 10139.51, "timestamp": "02:48:59", "text": "私の服は本当に高いんです。これは"}]
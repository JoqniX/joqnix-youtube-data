[{"type": "subtitle", "time": 8220.95, "timestamp": "02:17:00", "text": "ある有名なDMがかつて言ったように、"}, {"type": "subtitle", "time": 8224.23, "timestamp": "02:17:04", "text": "もちろん試してみます。"}, {"type": "subtitle", "time": 8226.549, "timestamp": "02:17:06", "text": "わかりました、私がそれをキャスティングします。"}, {"type": "subtitle", "time": 8228.79, "timestamp": "02:17:08", "text": "よし、それはプライベートな役割で"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "それを明らかにする。はい、テンプレートを配置してください。"}, {"type": "subtitle", "time": 8236.23, "timestamp": "02:17:16", "text": "えっと、待って。大成功は無理だよ。わかった。"}, {"type": "subtitle", "time": 8237.349, "timestamp": "02:17:17", "text": "うん。うん。うん。それはとても"}, {"type": "subtitle", "time": 8240.15, "timestamp": "02:17:20", "text": "小さいけれど、移動はできる。"}, {"type": "subtitle", "time": 8244.469, "timestamp": "02:17:24", "text": "わかった。そこを押してみます。"}, {"type": "subtitle", "time": 8246.549, "timestamp": "02:17:26", "text": "わかった。"}, {"type": "subtitle", "time": 8248.07, "timestamp": "02:17:28", "text": "よし。私は彼らに"}, {"type": "subtitle", "time": 8250.87, "timestamp": "02:17:30", "text": "保存する。ええと、円は終わりました"}, {"type": "subtitle", "time": 8251.75, "timestamp": "02:17:31", "text": "ちなみに、そこです。"}, {"type": "subtitle", "time": 8254.07, "timestamp": "02:17:34", "text": "うん。大丈夫。心配しないで。彼に任せよう"}, {"type": "subtitle", "time": 8255.11, "timestamp": "02:17:35", "text": "死ぬ。"}, {"type": "subtitle", "time": 8256.709, "timestamp": "02:17:36", "text": "待って、"}, {"type": "subtitle", "time": 8258.309, "timestamp": "02:17:38", "text": "彼は死ぬだろう。"}, {"type": "subtitle", "time": 8261.709, "timestamp": "02:17:41", "text": "なんてこった。あれは私の息子です。"}, {"type": "subtitle", "time": 8262.95, "timestamp": "02:17:42", "text": "[音楽]"}, {"type": "subtitle", "time": 8264.95, "timestamp": "02:17:44", "text": "私の息子は死ぬだろう。でも大丈夫。"}, {"type": "subtitle", "time": 8267.11, "timestamp": "02:17:47", "text": "わかった。聞いてくれ、それは彼の犠牲だ"}, {"type": "subtitle", "time": 8269.11, "timestamp": "02:17:49", "text": "喜んで作る。"}, {"type": "subtitle", "time": 8271.83, "timestamp": "02:17:51", "text": "彼は必ず後で戻ってくる。"}, {"type": "subtitle", "time": 8274.389, "timestamp": "02:17:54", "text": "戻ってくる。私は文字通りそれをできます"}, {"type": "subtitle", "time": 8276.79, "timestamp": "02:17:56", "text": "儀式。"}, {"type": "subtitle", "time": 8279.11, "timestamp": "02:17:59", "text": "私もやらなければならない。"}]
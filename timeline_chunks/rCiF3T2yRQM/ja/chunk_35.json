[{"type": "subtitle", "time": 2100.55, "timestamp": "00:35:00", "text": "でも、あなたの言うことを信じます。わからない"}, {"type": "subtitle", "time": 2102.55, "timestamp": "00:35:02", "text": "見えない。"}, {"type": "subtitle", "time": 2105.75, "timestamp": "00:35:05", "text": "おお。ああ、これはチャットトークンですか？"}, {"type": "subtitle", "time": 2107.19, "timestamp": "00:35:07", "text": "そうそう。それは"}, {"type": "subtitle", "time": 2108.79, "timestamp": "00:35:08", "text": "ああ、私がそれを作っていた時のことを覚えてるよね"}, {"type": "subtitle", "time": 2109.349, "timestamp": "00:35:09", "text": "最後の配信。"}, {"type": "subtitle", "time": 2112.95, "timestamp": "00:35:12", "text": "わーい。私はここにいます。さあ、行こう。わーい。"}, {"type": "subtitle", "time": 2113.829, "timestamp": "00:35:13", "text": "よし、"}, {"type": "subtitle", "time": 2115.109, "timestamp": "00:35:15", "text": "さあ行こう。"}, {"type": "subtitle", "time": 2117.589, "timestamp": "00:35:17", "text": "ドアが2つ、出入り口が2つ残っている"}, {"type": "subtitle", "time": 2118.15, "timestamp": "00:35:18", "text": "を通して。"}, {"type": "subtitle", "time": 2118.55, "timestamp": "00:35:18", "text": "うん。"}, {"type": "subtitle", "time": 2122.31, "timestamp": "00:35:22", "text": "それから、私に私のスピンをください。"}, {"type": "subtitle", "time": 2124.069, "timestamp": "00:35:24", "text": "あのね？おお。ああ、わかりました。私はできる 私はできる"}, {"type": "subtitle", "time": 2124.79, "timestamp": "00:35:24", "text": "ここに置いてください。"}, {"type": "subtitle", "time": 2125.349, "timestamp": "00:35:25", "text": "そうねぇ。"}, {"type": "subtitle", "time": 2128.87, "timestamp": "00:35:28", "text": "うん。それでは、レシピです。"}, {"type": "subtitle", "time": 2131.27, "timestamp": "00:35:31", "text": "彼がそこにいる。"}, {"type": "subtitle", "time": 2132.069, "timestamp": "00:35:32", "text": "私の息子。"}, {"type": "subtitle", "time": 2133.75, "timestamp": "00:35:33", "text": "よし。"}, {"type": "subtitle", "time": 2136.23, "timestamp": "00:35:36", "text": "それで、もっと長いプールを買ったんです。おお、"}, {"type": "subtitle", "time": 2136.39, "timestamp": "00:35:36", "text": "うん。"}, {"type": "subtitle", "time": 2137.75, "timestamp": "00:35:37", "text": "そして、もう一つドアが見つかった。"}, {"type": "subtitle", "time": 2140.069, "timestamp": "00:35:40", "text": "そして、床にもそれがありました。の上"}, {"type": "subtitle", "time": 2141.349, "timestamp": "00:35:41", "text": "床にもメモがある"}, {"type": "subtitle", "time": 2144.63, "timestamp": "00:35:44", "text": "コミュニケーションをとる。次のようなメモがあります"}, {"type": "subtitle", "time": 2147.109, "timestamp": "00:35:47", "text": "とても香りがとても良いです"}, {"type": "subtitle", "time": 2150.63, "timestamp": "00:35:50", "text": "良い。それは、私たちが香水を追っていると言っている"}, {"type": "subtitle", "time": 2154.55, "timestamp": "00:35:54", "text": "その時、愛のテーマのように"}, {"type": "subtitle", "time": 2156.15, "timestamp": "00:35:56", "text": "兄弟。"}, {"type": "subtitle", "time": 2158.95, "timestamp": "00:35:58", "text": "ああ、これはあのカメの老人からのものだ。彼"}]
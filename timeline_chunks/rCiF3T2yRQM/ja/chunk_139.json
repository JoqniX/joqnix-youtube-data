[{"type": "subtitle", "time": 8341.89, "timestamp": "02:19:01", "text": "考えているところです。"}, {"type": "subtitle", "time": 8344.87, "timestamp": "02:19:04", "text": "[音楽]"}, {"type": "subtitle", "time": 8348.79, "timestamp": "02:19:08", "text": "ディック、映画館には入らないで。"}, {"type": "subtitle", "time": 8352.87, "timestamp": "02:19:12", "text": "それは彼を楽しそうに見せたが、そうではなかった。"}, {"type": "subtitle", "time": 8354.549, "timestamp": "02:19:14", "text": "いいえ、"}, {"type": "subtitle", "time": 8358.07, "timestamp": "02:19:18", "text": "実際、私は全員を一撃で倒しました。"}, {"type": "subtitle", "time": 8368.15, "timestamp": "02:19:28", "text": "いいえ。Tは、もし彼らが怖かったらどうしようと考えているのです。"}, {"type": "subtitle", "time": 8369.83, "timestamp": "02:19:29", "text": "ダニが食べていることがわかったらどうなるでしょうか"}, {"type": "subtitle", "time": 8372.87, "timestamp": "02:19:32", "text": "あなたの醜い息子？"}, {"type": "subtitle", "time": 8375.75, "timestamp": "02:19:35", "text": "もし彼らが罪を知っていたらどうなるだろうか？"}, {"type": "subtitle", "time": 8376.87, "timestamp": "02:19:36", "text": "ティックの罪。"}, {"type": "subtitle", "time": 8378.87, "timestamp": "02:19:38", "text": "まるで、ティックが必要ないかのように。私たちは必要としません"}, {"type": "subtitle", "time": 8381.509, "timestamp": "02:19:41", "text": "今、自分の倫理観について考えてみてください。"}, {"type": "subtitle", "time": 8384.389, "timestamp": "02:19:44", "text": "哲学的な議論が必要だ。"}, {"type": "subtitle", "time": 8387.11, "timestamp": "02:19:47", "text": "いいえ、チェックマークは哲学を意味するものではありません。"}, {"type": "subtitle", "time": 8392.95, "timestamp": "02:19:52", "text": "なぜそんなことをするのですか？あなたは何者ですか"}, {"type": "subtitle", "time": 8394.79, "timestamp": "02:19:54", "text": "何について話しているのですか？"}, {"type": "subtitle", "time": 8397.99, "timestamp": "02:19:57", "text": "ダニを恐れる必要はありません。"}, {"type": "subtitle", "time": 8399.91, "timestamp": "02:19:59", "text": "彼らを怖がらせることは可能でしょうか？"}]
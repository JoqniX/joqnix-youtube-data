[{"type": "subtitle", "time": 11821.03, "timestamp": "03:17:01", "text": "これらのもの。"}, {"type": "subtitle", "time": 11823.03, "timestamp": "03:17:03", "text": "何かすごく大きなことが起きているような気がする"}, {"type": "subtitle", "time": 11825.269, "timestamp": "03:17:05", "text": "クソみたいな穴の上で。"}, {"type": "subtitle", "time": 11826.63, "timestamp": "03:17:06", "text": "そう、まさに私が言いたかったのはそれです。私はしません"}, {"type": "subtitle", "time": 11828.15, "timestamp": "03:17:08", "text": "今すぐ無駄にすべきだと思う。"}, {"type": "subtitle", "time": 11829.83, "timestamp": "03:17:09", "text": "文字通りのクソみたいな場所。"}, {"type": "subtitle", "time": 11838.79, "timestamp": "03:17:18", "text": "わかったよ、ジョー、ちょっとどいて"}, {"type": "subtitle", "time": 11840.469, "timestamp": "03:17:20", "text": "ここ。そうそう。待って、ちょっと待って。忘れた"}, {"type": "subtitle", "time": 11842.87, "timestamp": "03:17:22", "text": "そうですね、できますよ"}, {"type": "subtitle", "time": 11844.55, "timestamp": "03:17:24", "text": "抵抗したい場合は、自由に"}, {"type": "subtitle", "time": 11847.67, "timestamp": "03:17:27", "text": "抵抗する、チェックなしだから"}, {"type": "subtitle", "time": 11849.99, "timestamp": "03:17:29", "text": "あなたが自分のものを植えているので"}, {"type": "subtitle", "time": 11851.03, "timestamp": "03:17:31", "text": "地面。"}, {"type": "subtitle", "time": 11853.19, "timestamp": "03:17:33", "text": "私は自分の荷物を持って行きたいのですが"}, {"type": "subtitle", "time": 11855.19, "timestamp": "03:17:35", "text": "引っ越したい。"}, {"type": "subtitle", "time": 11857.349, "timestamp": "03:17:37", "text": "よし。うん。うん。あなたもそう"}, {"type": "subtitle", "time": 11858.71, "timestamp": "03:17:38", "text": "そのものに心を動かされてください。全て"}, {"type": "subtitle", "time": 11860.389, "timestamp": "03:17:40", "text": "右。"}, {"type": "subtitle", "time": 11872.63, "timestamp": "03:17:52", "text": "事態は最悪になるだろう。"}, {"type": "subtitle", "time": 11875.269, "timestamp": "03:17:55", "text": "文字通り"}, {"type": "subtitle", "time": 11877.51, "timestamp": "03:17:57", "text": "結局、クソみたいな結果になる"}, {"type": "subtitle", "time": 11879.19, "timestamp": "03:17:59", "text": "あのクソ野郎へ。私はこうするつもりです"}]
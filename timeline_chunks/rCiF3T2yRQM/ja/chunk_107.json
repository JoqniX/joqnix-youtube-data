[{"type": "subtitle", "time": 6422.149, "timestamp": "01:47:02", "text": "でも、私たちは安全だと思います。"}, {"type": "subtitle", "time": 6424.31, "timestamp": "01:47:04", "text": "チクチクしない。ティックはこう言うでしょう"}, {"type": "subtitle", "time": 6425.59, "timestamp": "01:47:05", "text": "多くの。"}, {"type": "subtitle", "time": 6428.31, "timestamp": "01:47:08", "text": "時計の針を見る。"}, {"type": "subtitle", "time": 6431.35, "timestamp": "01:47:11", "text": "まっすぐ振り返る"}, {"type": "subtitle", "time": 6433.75, "timestamp": "01:47:13", "text": "あなたの好きなように"}, {"type": "subtitle", "time": 6435.03, "timestamp": "01:47:15", "text": "私はただ直接調べているだけです"}, {"type": "subtitle", "time": 6437.83, "timestamp": "01:47:17", "text": "ダニの生地の目は"}, {"type": "subtitle", "time": 6440.07, "timestamp": "01:47:20", "text": "私はしません"}, {"type": "subtitle", "time": 6442.87, "timestamp": "01:47:22", "text": "まあ、彼はそれほど危険な人物だとは思わないけどね。"}, {"type": "subtitle", "time": 6446.709, "timestamp": "01:47:26", "text": "大丈夫です。それはほんの一例に過ぎません。もし修道女が"}, {"type": "subtitle", "time": 6448.39, "timestamp": "01:47:28", "text": "攻撃する、もしくはその何かが私を攻撃する、"}, {"type": "subtitle", "time": 6450.229, "timestamp": "01:47:30", "text": "殺してしまえ。簡単。"}, {"type": "subtitle", "time": 6450.95, "timestamp": "01:47:30", "text": "その通り。"}, {"type": "subtitle", "time": 6452.39, "timestamp": "01:47:32", "text": "いいですね。"}, {"type": "subtitle", "time": 6455.35, "timestamp": "01:47:35", "text": "それは罠だろうか？"}, {"type": "subtitle", "time": 6457.43, "timestamp": "01:47:37", "text": "それは罠である可能性もある。"}, {"type": "subtitle", "time": 6460.79, "timestamp": "01:47:40", "text": "アンデッドは友達にも食料にもなり得る。"}, {"type": "subtitle", "time": 6462.629, "timestamp": "01:47:42", "text": "まあ。友人、"}, {"type": "subtitle", "time": 6464.07, "timestamp": "01:47:44", "text": "戻ってきました。"}, {"type": "subtitle", "time": 6468.39, "timestamp": "01:47:48", "text": "死ぬまではアンデッドにならないで"}, {"type": "subtitle", "time": 6470.629, "timestamp": "01:47:50", "text": "我々の安全が証明されるまで。"}, {"type": "subtitle", "time": 6474.149, "timestamp": "01:47:54", "text": "結局、そこに戻ってきたという感じが気に入っています。"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "彼が戻ってきたとき、ティックはこう言っていた。"}]
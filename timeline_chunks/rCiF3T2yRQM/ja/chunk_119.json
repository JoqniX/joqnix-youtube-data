[{"type": "subtitle", "time": 7142.39, "timestamp": "01:59:02", "text": "私がそれを動かしたのなら、"}, {"type": "subtitle", "time": 7144.47, "timestamp": "01:59:04", "text": "座って、ゆっくりと動くように"}, {"type": "subtitle", "time": 7146.07, "timestamp": "01:59:06", "text": "フォワード。"}, {"type": "subtitle", "time": 7147.27, "timestamp": "01:59:07", "text": "ああ、神様。"}, {"type": "subtitle", "time": 7152.79, "timestamp": "01:59:12", "text": "チケットをつかむ。今こそ、目立とう。"}, {"type": "subtitle", "time": 7155.51, "timestamp": "01:59:15", "text": "君はもう大きな子供だね。"}, {"type": "subtitle", "time": 7157.83, "timestamp": "01:59:17", "text": "彼はとても小さい。"}, {"type": "subtitle", "time": 7160.47, "timestamp": "01:59:20", "text": "君はもう大きな子供だね。"}, {"type": "subtitle", "time": 7166.149, "timestamp": "01:59:26", "text": "とても小さくてとてもかわいいので、"}, {"type": "subtitle", "time": 7178.87, "timestamp": "01:59:38", "text": "いいえ、立ち上がって歩くことはできません。君は"}, {"type": "subtitle", "time": 7181.51, "timestamp": "01:59:41", "text": "まあ、これが生きているなら"}, {"type": "subtitle", "time": 7184.709, "timestamp": "01:59:44", "text": "私たちが何か行動を起こせば、それは反応するだろう。"}, {"type": "subtitle", "time": 7189.03, "timestamp": "01:59:49", "text": "私たちはどうするべきか？火事だ。"}, {"type": "subtitle", "time": 7190.39, "timestamp": "01:59:50", "text": "殺せ。"}, {"type": "subtitle", "time": 7194.629, "timestamp": "01:59:54", "text": "ええ、食べ物には反応しませんでした。それ"}, {"type": "subtitle", "time": 7196.95, "timestamp": "01:59:56", "text": "黒い液体に反応した。"}, {"type": "subtitle", "time": 7198.47, "timestamp": "01:59:58", "text": "私は液体について言うつもりです"}]
[{"type": "subtitle", "time": 11461.03, "timestamp": "03:11:01", "text": "いいえ、魔法のサナダムシのことではありません。いいえ、"}, {"type": "subtitle", "time": 11463.51, "timestamp": "03:11:03", "text": "少なくとも条虫は死ぬだろう"}, {"type": "subtitle", "time": 11471.99, "timestamp": "03:11:11", "text": "入らないで。彼らは実際にはワームを"}, {"type": "subtitle", "time": 11473.59, "timestamp": "03:11:13", "text": "実際に彼らは"}, {"type": "subtitle", "time": 11474.95, "timestamp": "03:11:14", "text": "腸壁。"}, {"type": "subtitle", "time": 11477.19, "timestamp": "03:11:17", "text": "どうして知っているのかは聞かないで。"}, {"type": "subtitle", "time": 11479.429, "timestamp": "03:11:19", "text": "知りたくなかった事実"}, {"type": "subtitle", "time": 11484.55, "timestamp": "03:11:24", "text": "私は当然知っている？必要なかったように"}, {"type": "subtitle", "time": 11487.91, "timestamp": "03:11:27", "text": "知る。今日はそんなことを知る必要はなかった。"}, {"type": "subtitle", "time": 11488.95, "timestamp": "03:11:28", "text": "ありがとう、"}, {"type": "subtitle", "time": 11490.23, "timestamp": "03:11:30", "text": "親愛なる。"}, {"type": "subtitle", "time": 11491.75, "timestamp": "03:11:31", "text": "知るか？もしかしたら次の敵は"}, {"type": "subtitle", "time": 11494.15, "timestamp": "03:11:34", "text": "巨大なサナダムシになりそうだ。"}, {"type": "subtitle", "time": 11497.349, "timestamp": "03:11:37", "text": "何てことだ。何てことだ。それは大きな論文だ。"}, {"type": "subtitle", "time": 11500.87, "timestamp": "03:11:40", "text": "魔法のテープに復讐せよ。"}, {"type": "subtitle", "time": 11502.309, "timestamp": "03:11:42", "text": "よし。他に何か？"}, {"type": "subtitle", "time": 11504.389, "timestamp": "03:11:44", "text": "それが私にできる全てだと思います。"}, {"type": "subtitle", "time": 11507.51, "timestamp": "03:11:47", "text": "わかった。その後"}, {"type": "subtitle", "time": 11508.469, "timestamp": "03:11:48", "text": "よし、"}, {"type": "subtitle", "time": 11511.269, "timestamp": "03:11:51", "text": "兄弟。兄さん、私はただ自分の"}, {"type": "subtitle", "time": 11513.75, "timestamp": "03:11:53", "text": "呪文とか、ああ、俺の呪文は"}, {"type": "subtitle", "time": 11518.15, "timestamp": "03:11:58", "text": "特に私が人と戦うとき"}]
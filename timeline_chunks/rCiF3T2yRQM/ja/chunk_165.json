[{"type": "subtitle", "time": 9905.269, "timestamp": "02:45:05", "text": "うん。うん。あなたはそれをしましたか？なぜなら"}, {"type": "subtitle", "time": 9906.71, "timestamp": "02:45:06", "text": "もしあなたが私が解決するつもりなら"}, {"type": "subtitle", "time": 9910.87, "timestamp": "02:45:10", "text": "プレイのHP。これで閉店します。わかった。"}, {"type": "subtitle", "time": 9913.51, "timestamp": "02:45:13", "text": "よし。わかった。わかりました、"}, {"type": "subtitle", "time": 9916.309, "timestamp": "02:45:16", "text": "君のためにプラスするつもりだ。プラス"}, {"type": "subtitle", "time": 9917.51, "timestamp": "02:45:17", "text": "五。よし。"}, {"type": "subtitle", "time": 9920.389, "timestamp": "02:45:20", "text": "ありがとう。"}, {"type": "subtitle", "time": 9920.79, "timestamp": "02:45:20", "text": "よし。"}, {"type": "subtitle", "time": 9921.83, "timestamp": "02:45:21", "text": "わかった。"}, {"type": "subtitle", "time": 9923.91, "timestamp": "02:45:23", "text": "何もないように見える"}, {"type": "subtitle", "time": 9926.95, "timestamp": "02:45:26", "text": "胃を除く。"}, {"type": "subtitle", "time": 9927.99, "timestamp": "02:45:27", "text": "うん。うん。"}, {"type": "subtitle", "time": 9931.75, "timestamp": "02:45:31", "text": "えっと、他にも何かあるみたいですね"}, {"type": "subtitle", "time": 9933.11, "timestamp": "02:45:33", "text": "そのように。"}, {"type": "subtitle", "time": 9935.99, "timestamp": "02:45:35", "text": "君たちはこうできると思う"}, {"type": "subtitle", "time": 9938.63, "timestamp": "02:45:38", "text": "すみません。君たちは5つくらいできるよ"}, {"type": "subtitle", "time": 9941.349, "timestamp": "02:45:41", "text": "月の光が消える前に行う行動。"}, {"type": "subtitle", "time": 9943.67, "timestamp": "02:45:43", "text": "わかった。"}, {"type": "subtitle", "time": 9945.99, "timestamp": "02:45:45", "text": "俺の相棒をもう一度呼び出せるか？"}, {"type": "subtitle", "time": 9947.91, "timestamp": "02:45:47", "text": "はい。"}, {"type": "subtitle", "time": 9950.55, "timestamp": "02:45:50", "text": "出費する。彼らは「サクサク」と言っている。"}, {"type": "subtitle", "time": 9952.95, "timestamp": "02:45:52", "text": "オーケー、クリスピンを引っ張らせてもらうよ"}, {"type": "subtitle", "time": 9954.95, "timestamp": "02:45:54", "text": "外。持続する。どうぞ。クリスマスは"}, {"type": "subtitle", "time": 9958.309, "timestamp": "02:45:58", "text": "依然として後ろ向き。それを削除しましょう。うん。"}]
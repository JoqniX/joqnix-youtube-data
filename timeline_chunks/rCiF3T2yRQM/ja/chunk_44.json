[{"type": "subtitle", "time": 2642.63, "timestamp": "00:44:02", "text": "アリアナは、まあ、わかったって感じ。えっと、"}, {"type": "subtitle", "time": 2644.63, "timestamp": "00:44:04", "text": "ご覧のとおり、みんな"}, {"type": "subtitle", "time": 2646.95, "timestamp": "00:44:06", "text": "眠っている。君たちは"}, {"type": "subtitle", "time": 2648.23, "timestamp": "00:44:08", "text": "続く？"}, {"type": "subtitle", "time": 2650.15, "timestamp": "00:44:10", "text": "うん。うん。うん。君たちは言った"}, {"type": "subtitle", "time": 2651.75, "timestamp": "00:44:11", "text": "あなたに会いに来るべきです。だから私たちは"}, {"type": "subtitle", "time": 2654.15, "timestamp": "00:44:14", "text": "ここで何が起こっているのか突き止めなければならない。"}, {"type": "subtitle", "time": 2657.589, "timestamp": "00:44:17", "text": "そうそう。私は言われた、私は言われた"}, {"type": "subtitle", "time": 2660.39, "timestamp": "00:44:20", "text": "えーと、君たちがここに来ることについて"}, {"type": "subtitle", "time": 2664.79, "timestamp": "00:44:24", "text": "古いポータル。えっと、私たちは"}, {"type": "subtitle", "time": 2669.99, "timestamp": "00:44:29", "text": "この地域を探索して、本当に"}, {"type": "chat", "time": 2670.711, "timestamp": "00:44:30", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "hello joq ... gud evng👋"}, {"type": "chat", "time": 2671.369, "timestamp": "00:44:31", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Aniket W~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 2672.309, "timestamp": "00:44:32", "text": "今回の調査で注目すべき点は何だったでしょうか？"}, {"type": "subtitle", "time": 2675.43, "timestamp": "00:44:35", "text": "ええと、魔法のテーブルを見つけました"}, {"type": "subtitle", "time": 2677.27, "timestamp": "00:44:37", "text": "たくさんの食べ物と一緒に。よくわからない"}, {"type": "subtitle", "time": 2679.43, "timestamp": "00:44:39", "text": "それが何であるかはわかりませんが、テーブルがありました"}, {"type": "subtitle", "time": 2682.23, "timestamp": "00:44:42", "text": "そこにはたくさんの食べ物がある。そしてもしあなたが"}, {"type": "subtitle", "time": 2683.43, "timestamp": "00:44:43", "text": "大きい"}, {"type": "subtitle", "time": 2686.309, "timestamp": "00:44:46", "text": "死んだスライムがたくさんある部屋、それは"}, {"type": "subtitle", "time": 2688.95, "timestamp": "00:44:48", "text": "おそらくここにいる誰かがビング"}, {"type": "subtitle", "time": 2696.069, "timestamp": "00:44:56", "text": "ライムゼリーみたいに"}, {"type": "subtitle", "time": 2698.87, "timestamp": "00:44:58", "text": "ダニは、ダニが食べ始めたことに気づいた。"}]
[{"type": "subtitle", "time": 5341.83, "timestamp": "01:29:01", "text": "デヴォンは実際には、そうじゃない、"}, {"type": "subtitle", "time": 5345.35, "timestamp": "01:29:05", "text": "本当に、"}, {"type": "subtitle", "time": 5349.51, "timestamp": "01:29:09", "text": "これは良い実験だ。"}, {"type": "subtitle", "time": 5351.91, "timestamp": "01:29:11", "text": "よし、蛇口を開けて、"}, {"type": "subtitle", "time": 5354.149, "timestamp": "01:29:14", "text": "液体が放出される"}, {"type": "subtitle", "time": 5356.709, "timestamp": "01:29:16", "text": "黒い泡が立ち上る。それは黒です"}, {"type": "subtitle", "time": 5358.149, "timestamp": "01:29:18", "text": "泡立つ液体ですが、その下で"}, {"type": "subtitle", "time": 5360.55, "timestamp": "01:29:20", "text": "少し、少し、ええと"}, {"type": "subtitle", "time": 5363.189, "timestamp": "01:29:23", "text": "半透明の青色の液体。何が出てくるか"}, {"type": "subtitle", "time": 5365.91, "timestamp": "01:29:25", "text": "その物の特徴は、青い液体です。"}, {"type": "subtitle", "time": 5368.79, "timestamp": "01:29:28", "text": "それは、ええと、泡の下にあります。"}, {"type": "subtitle", "time": 5371.59, "timestamp": "01:29:31", "text": "そして、えっと、あなたには"}, {"type": "subtitle", "time": 5374.47, "timestamp": "01:29:34", "text": "20面ダイスを1つ振ってください。"}, {"type": "subtitle", "time": 5376.629, "timestamp": "01:29:36", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 5379.03, "timestamp": "01:29:39", "text": "サラは公に、または"}, {"type": "subtitle", "time": 5381.35, "timestamp": "01:29:41", "text": "公に。公に"}, {"type": "subtitle", "time": 5383.35, "timestamp": "01:29:43", "text": "私はとても怖いです。"}, {"type": "subtitle", "time": 5384.31, "timestamp": "01:29:44", "text": "わかった。"}, {"type": "subtitle", "time": 5385.99, "timestamp": "01:29:45", "text": "待って。みんなと同じように。"}, {"type": "subtitle", "time": 5388.87, "timestamp": "01:29:48", "text": "ああ、わかりました。それもそうだ。"}, {"type": "subtitle", "time": 5390.229, "timestamp": "01:29:50", "text": "わかった。最初のやつでいいよ。それで、"}, {"type": "subtitle", "time": 5393.189, "timestamp": "01:29:53", "text": "5点です。よし。わかった。あなたが"}, {"type": "subtitle", "time": 5397.189, "timestamp": "01:29:57", "text": "それを飲むと、体が軽くなったように感じるよ。"}, {"type": "subtitle", "time": 5399.27, "timestamp": "01:29:59", "text": "もしかしたら、"}]
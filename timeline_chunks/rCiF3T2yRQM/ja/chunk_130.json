[{"type": "subtitle", "time": 7801.91, "timestamp": "02:10:01", "text": "攻撃。"}, {"type": "subtitle", "time": 7805.27, "timestamp": "02:10:05", "text": "私はそうは思わない。"}, {"type": "subtitle", "time": 7807.109, "timestamp": "02:10:07", "text": "誰かが私にそう言ってくれない限りは。"}, {"type": "subtitle", "time": 7811.83, "timestamp": "02:10:11", "text": "ええと、検出してみてください。あなたは？"}, {"type": "subtitle", "time": 7814.55, "timestamp": "02:10:14", "text": "だから、いいえ。"}, {"type": "subtitle", "time": 7816.149, "timestamp": "02:10:16", "text": "今のところ、そうは見えない。"}, {"type": "subtitle", "time": 7818.069, "timestamp": "02:10:18", "text": "ええ、そうではありません。"}, {"type": "subtitle", "time": 7819.189, "timestamp": "02:10:19", "text": "デヴォンです。"}, {"type": "subtitle", "time": 7822.629, "timestamp": "02:10:22", "text": "ああ、私だ。"}, {"type": "subtitle", "time": 7825.91, "timestamp": "02:10:25", "text": "おい、男だよ。"}, {"type": "subtitle", "time": 7827.75, "timestamp": "02:10:27", "text": "とにかく、彼はクソみたいなガイドをするだろう"}, {"type": "subtitle", "time": 7830.55, "timestamp": "02:10:30", "text": "ボート。"}, {"type": "subtitle", "time": 7834.149, "timestamp": "02:10:34", "text": "この世帯のガイドボートをクリックしてください。"}, {"type": "subtitle", "time": 7835.27, "timestamp": "02:10:35", "text": "えっと、"}, {"type": "subtitle", "time": 7837.109, "timestamp": "02:10:37", "text": "ボルトがガイドしているとき。"}, {"type": "subtitle", "time": 7842.709, "timestamp": "02:10:42", "text": "うっかりそのうちの1つを使い切ってしまいました"}, {"type": "subtitle", "time": 7844.39, "timestamp": "02:10:44", "text": "前。混乱した。"}, {"type": "subtitle", "time": 7846.31, "timestamp": "02:10:46", "text": "そうそう。はい、クリックするだけで"}, {"type": "subtitle", "time": 7848.39, "timestamp": "02:10:48", "text": "そうすれば、そのリソースを返金できます。"}, {"type": "subtitle", "time": 7849.589, "timestamp": "02:10:49", "text": "ああ、もう"}, {"type": "subtitle", "time": 7852.29, "timestamp": "02:10:52", "text": "あ、もう着きましたよ。よし、いいね。"}]
[{"type": "subtitle", "time": 9602.389, "timestamp": "02:40:02", "text": "よし、スライムを用意しよう。"}, {"type": "subtitle", "time": 9605.429, "timestamp": "02:40:05", "text": "なんてこった。なんてこった。"}, {"type": "subtitle", "time": 9608.55, "timestamp": "02:40:08", "text": "それは完全な損傷です。はい、これで17です"}, {"type": "subtitle", "time": 9609.83, "timestamp": "02:40:09", "text": "ダメージ。"}, {"type": "subtitle", "time": 9610.87, "timestamp": "02:40:10", "text": "まあ。"}, {"type": "subtitle", "time": 9611.83, "timestamp": "02:40:11", "text": "下。"}, {"type": "subtitle", "time": 9612.95, "timestamp": "02:40:12", "text": "まあ。わかった。"}, {"type": "subtitle", "time": 9616.55, "timestamp": "02:40:16", "text": "ああ、彼は生きている。よし、選んで。どのように"}, {"type": "subtitle", "time": 9619.27, "timestamp": "02:40:19", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 9620.63, "timestamp": "02:40:20", "text": "うん、素晴らしいね。"}, {"type": "subtitle", "time": 9623.51, "timestamp": "02:40:23", "text": "よし。スライムと妹。"}, {"type": "subtitle", "time": 9627.11, "timestamp": "02:40:27", "text": "だから、私からドロップロールダメージを受けてください。"}, {"type": "subtitle", "time": 9630.23, "timestamp": "02:40:30", "text": "えっと、ダメージはd10ですよね？"}, {"type": "subtitle", "time": 9632.63, "timestamp": "02:40:32", "text": "ええ、2d10です。"}, {"type": "subtitle", "time": 9634.95, "timestamp": "02:40:34", "text": "2d10。"}, {"type": "subtitle", "time": 9637.03, "timestamp": "02:40:37", "text": "あ、待って。そんなやり方はダメだ。えっと"}, {"type": "subtitle", "time": 9644.87, "timestamp": "02:40:44", "text": "わかった。ああ、その発表をお見せします"}, {"type": "subtitle", "time": 9649.99, "timestamp": "02:40:49", "text": "では、簡単に適用してみましょう"}, {"type": "subtitle", "time": 9652.07, "timestamp": "02:40:52", "text": "それ。"}, {"type": "subtitle", "time": 9656.87, "timestamp": "02:40:56", "text": "はい、どうぞ。よし、それはしがみついている"}, {"type": "subtitle", "time": 9658.389, "timestamp": "02:40:58", "text": "人生。"}]
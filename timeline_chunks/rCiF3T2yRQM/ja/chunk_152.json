[{"type": "subtitle", "time": 9121.349, "timestamp": "02:32:01", "text": "スライムへのダメージがさらに増える。"}, {"type": "subtitle", "time": 9123.83, "timestamp": "02:32:03", "text": "現在の"}, {"type": "subtitle", "time": 9126.15, "timestamp": "02:32:06", "text": "スライムまたは"}, {"type": "subtitle", "time": 9132.71, "timestamp": "02:32:12", "text": "それをいったん移動させてから、元に戻してください。"}, {"type": "subtitle", "time": 9133.27, "timestamp": "02:32:13", "text": "うん。"}, {"type": "subtitle", "time": 9134.389, "timestamp": "02:32:14", "text": "それは再び起こるだろうか？"}, {"type": "subtitle", "time": 9135.75, "timestamp": "02:32:15", "text": "動かしたい。君に任せるよ"}, {"type": "subtitle", "time": 9137.51, "timestamp": "02:32:17", "text": "すぐに。"}, {"type": "subtitle", "time": 9141.03, "timestamp": "02:32:21", "text": "えっと、また同じことが起こるのかな？それを壊すようなこと？"}, {"type": "subtitle", "time": 9143.99, "timestamp": "02:32:23", "text": "うん。うん。わかった。つまり、2D"}, {"type": "subtitle", "time": 9152.95, "timestamp": "02:32:32", "text": "えっと、生の2D 2Dって何ですか？"}, {"type": "subtitle", "time": 9153.99, "timestamp": "02:32:33", "text": "2d10。"}, {"type": "subtitle", "time": 9155.67, "timestamp": "02:32:35", "text": "2D10。"}, {"type": "subtitle", "time": 9156.95, "timestamp": "02:32:36", "text": "私もこれを本当に確認したい"}, {"type": "subtitle", "time": 9158.469, "timestamp": "02:32:38", "text": "素早く。持続する。ダブルダブルさせてください"}, {"type": "subtitle", "time": 9160.15, "timestamp": "02:32:40", "text": "これを確認してください。もし"}, {"type": "subtitle", "time": 9161.91, "timestamp": "02:32:41", "text": "彼らは既に入っている。彼らがそうするかどうか忘れた。"}, {"type": "subtitle", "time": 9163.67, "timestamp": "02:32:43", "text": "金庫を再び使うのが好きかどうか。私にさせて"}, {"type": "subtitle", "time": 9165.03, "timestamp": "02:32:45", "text": "もう一度確認してください。彼らはそう思うけど、"}, {"type": "subtitle", "time": 9169.91, "timestamp": "02:32:49", "text": "念のため確認しておきたいんです。えっと"}, {"type": "subtitle", "time": 9173.11, "timestamp": "02:32:53", "text": "そうなると、危険な状態になる。よし。わかった。"}, {"type": "subtitle", "time": 9175.59, "timestamp": "02:32:55", "text": "危険です。彼はまた、シーケンスを作成する"}, {"type": "subtitle", "time": 9177.27, "timestamp": "02:32:57", "text": "呪文の領域をその空間に。わかった。そうですね、"}, {"type": "subtitle", "time": 9178.309, "timestamp": "02:32:58", "text": "それは安全をもたらす。私はただ"}]
[{"type": "subtitle", "time": 7980.149, "timestamp": "02:13:00", "text": "アリアナの全身に触手が生えている。"}, {"type": "subtitle", "time": 7982.55, "timestamp": "02:13:02", "text": "回転式回転装置。"}, {"type": "subtitle", "time": 7983.589, "timestamp": "02:13:03", "text": "彼らには当たらない。"}, {"type": "subtitle", "time": 7985.189, "timestamp": "02:13:05", "text": "兄貴、すごく太いね。"}, {"type": "subtitle", "time": 7987.589, "timestamp": "02:13:07", "text": "うん、まるでそれが全部"}, {"type": "subtitle", "time": 7990.95, "timestamp": "02:13:10", "text": "鎧と盾の上に。"}, {"type": "subtitle", "time": 7992.87, "timestamp": "02:13:12", "text": "20 AC"}, {"type": "subtitle", "time": 7997.189, "timestamp": "02:13:17", "text": "すごくすごくぬるぬるしている。おいしい。"}, {"type": "subtitle", "time": 7999.51, "timestamp": "02:13:19", "text": "はい、わかりました。えーと、それから後ろのやつ"}, {"type": "subtitle", "time": 8003.43, "timestamp": "02:13:23", "text": "こちらはちょっと移動します。えっと、"}, {"type": "subtitle", "time": 8007.109, "timestamp": "02:13:27", "text": "わかった。それでは、アリアナ、あなたの番です。"}, {"type": "subtitle", "time": 8011.669, "timestamp": "02:13:31", "text": "よし、じゃあ彼のを刺すしかないな"}, {"type": "subtitle", "time": 8012.87, "timestamp": "02:13:32", "text": "お尻。"}, {"type": "subtitle", "time": 8014.069, "timestamp": "02:13:34", "text": "わかった。"}, {"type": "subtitle", "time": 8015.189, "timestamp": "02:13:35", "text": "攻撃。"}, {"type": "subtitle", "time": 8022.55, "timestamp": "02:13:42", "text": "どうすればいいですか？"}, {"type": "subtitle", "time": 8025.589, "timestamp": "02:13:45", "text": "ダメージ。みんなが一般的に"}, {"type": "subtitle", "time": 8028.55, "timestamp": "02:13:48", "text": "良い。それらをすべてお見せしましょう。"}, {"type": "subtitle", "time": 8030.31, "timestamp": "02:13:50", "text": "戦闘では、すべてを次のようにします"}, {"type": "subtitle", "time": 8031.03, "timestamp": "02:13:51", "text": "公共。"}, {"type": "subtitle", "time": 8031.35, "timestamp": "02:13:51", "text": "わかった。"}, {"type": "subtitle", "time": 8033.43, "timestamp": "02:13:53", "text": "でも、大丈夫だよ。わかった。よし。"}, {"type": "subtitle", "time": 8035.27, "timestamp": "02:13:55", "text": "よし。それからもう一度刺す、"}, {"type": "subtitle", "time": 8035.83, "timestamp": "02:13:55", "text": "推測。"}]
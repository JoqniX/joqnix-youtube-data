[{"type": "subtitle", "time": 842.23, "timestamp": "00:14:02", "text": "猫のように。コバルトは"}, {"type": "subtitle", "time": 845.11, "timestamp": "00:14:05", "text": "その猫は猫も好きだ。"}, {"type": "subtitle", "time": 847.43, "timestamp": "00:14:07", "text": "チョークを食べる。"}, {"type": "subtitle", "time": 848.069, "timestamp": "00:14:08", "text": "チョークを食べるの？"}, {"type": "subtitle", "time": 849.269, "timestamp": "00:14:09", "text": "なんてこった。"}, {"type": "subtitle", "time": 851.11, "timestamp": "00:14:11", "text": "いや、いや、いや。チョークを食べてはいけません。それは違う"}, {"type": "subtitle", "time": 852.79, "timestamp": "00:14:12", "text": "よかったね。"}, {"type": "subtitle", "time": 855.189, "timestamp": "00:14:15", "text": "いいえ。チョークはとても良いです。チクッ。ティックは好きです"}, {"type": "subtitle", "time": 858.55, "timestamp": "00:14:18", "text": "チョークとダニは塩の岩を好む。"}, {"type": "subtitle", "time": 859.75, "timestamp": "00:14:19", "text": "美味しい。"}, {"type": "subtitle", "time": 862.87, "timestamp": "00:14:22", "text": "これはほんの少しで、蓮が"}, {"type": "subtitle", "time": 865.99, "timestamp": "00:14:25", "text": "混乱のような"}, {"type": "subtitle", "time": 869.35, "timestamp": "00:14:29", "text": "えっと、私は自分の姿を見ません。私はそうは思わない"}, {"type": "subtitle", "time": 872.389, "timestamp": "00:14:32", "text": "コバルトは塩を食べるのが好きだと読んだことがある。"}, {"type": "subtitle", "time": 874.55, "timestamp": "00:14:34", "text": "岩石だが、どうやら学界は"}, {"type": "subtitle", "time": 876.55, "timestamp": "00:14:36", "text": "間違っているか、またはたくさんある"}, {"type": "subtitle", "time": 880.069, "timestamp": "00:14:40", "text": "詳細情報が不足している。わからない。"}, {"type": "subtitle", "time": 883.67, "timestamp": "00:14:43", "text": "ティックはただのティックです"}, {"type": "subtitle", "time": 884.55, "timestamp": "00:14:44", "text": "そんな感じ。"}, {"type": "subtitle", "time": 887.91, "timestamp": "00:14:47", "text": "それは分かります。それはよく分かります。"}, {"type": "subtitle", "time": 889.43, "timestamp": "00:14:49", "text": "待って、その名前はどこから来たの？チクッ。"}, {"type": "subtitle", "time": 891.43, "timestamp": "00:14:51", "text": "誰があなたに名前をつけたのですか？"}, {"type": "subtitle", "time": 894.87, "timestamp": "00:14:54", "text": "ああ、ダスク。ダスクの名前はティック。"}, {"type": "subtitle", "time": 895.43, "timestamp": "00:14:55", "text": "ダスク。"}, {"type": "subtitle", "time": 896.87, "timestamp": "00:14:56", "text": "何？"}, {"type": "subtitle", "time": 899.59, "timestamp": "00:14:59", "text": "ダニ。 D、そしてそれは、そしてそれはではない"}]
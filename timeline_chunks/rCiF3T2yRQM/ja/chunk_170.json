[{"type": "subtitle", "time": 10201.75, "timestamp": "02:50:01", "text": "技術的にこの物を与えることはできますか"}, {"type": "subtitle", "time": 10205.03, "timestamp": "02:50:05", "text": "まるでサナダムシのようなもの？"}, {"type": "subtitle", "time": 10206.95, "timestamp": "02:50:06", "text": "はい。"}, {"type": "subtitle", "time": 10207.99, "timestamp": "02:50:07", "text": "何てことだ。"}, {"type": "subtitle", "time": 10211.03, "timestamp": "02:50:11", "text": "はい、できますよ。"}, {"type": "subtitle", "time": 10213.429, "timestamp": "02:50:13", "text": "害虫が発生しています。みんな、"}, {"type": "subtitle", "time": 10216.95, "timestamp": "02:50:16", "text": "どの寄生虫を与えるべきか選んでください。"}, {"type": "subtitle", "time": 10219.59, "timestamp": "02:50:19", "text": "兄貴はこれにサナダムシを入れるつもりだ"}, {"type": "subtitle", "time": 10220.389, "timestamp": "02:50:20", "text": "まったく、あの野郎。"}, {"type": "subtitle", "time": 10224.07, "timestamp": "02:50:24", "text": "さあ行こう。条虫。 10 または"}, {"type": "subtitle", "time": 10227.01, "timestamp": "02:50:27", "text": "1匹の生物に対して30フィートの範囲をカバーできるのか？"}, {"type": "subtitle", "time": 10229.51, "timestamp": "02:50:29", "text": "[音楽]"}, {"type": "subtitle", "time": 10230.23, "timestamp": "02:50:30", "text": "えっと"}, {"type": "subtitle", "time": 10232.55, "timestamp": "02:50:32", "text": "私は、"}, {"type": "subtitle", "time": 10235.99, "timestamp": "02:50:35", "text": "壁を標的にする目的は"}, {"type": "subtitle", "time": 10241.03, "timestamp": "02:50:41", "text": "ターゲットにする目的で、または"}, {"type": "subtitle", "time": 10243.91, "timestamp": "02:50:43", "text": "床。うん。しかし、スライムを見つけたら"}, {"type": "subtitle", "time": 10246.71, "timestamp": "02:50:46", "text": "それは生き物です、"}, {"type": "subtitle", "time": 10249.349, "timestamp": "02:50:49", "text": "私はスライムは作らないけど、"}, {"type": "subtitle", "time": 10251.429, "timestamp": "02:50:51", "text": "スライムを食べろ。"}, {"type": "subtitle", "time": 10251.75, "timestamp": "02:50:51", "text": "うん、"}, {"type": "subtitle", "time": 10259.11, "timestamp": "02:50:59", "text": "それがうまくいくかどうかは分かりません。"}]
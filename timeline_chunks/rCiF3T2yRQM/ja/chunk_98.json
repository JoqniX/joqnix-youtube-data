[{"type": "subtitle", "time": 5881.189, "timestamp": "01:38:01", "text": "これについて言及しておきます。これらの死体はすべて"}, {"type": "subtitle", "time": 5883.189, "timestamp": "01:38:03", "text": "冒険者向けではない。彼らは"}, {"type": "subtitle", "time": 5885.03, "timestamp": "01:38:05", "text": "どちらかというと庶民といった感じだ。"}, {"type": "subtitle", "time": 5886.55, "timestamp": "01:38:06", "text": "おお、"}, {"type": "subtitle", "time": 5888.95, "timestamp": "01:38:08", "text": "それらはすべて、"}, {"type": "subtitle", "time": 5891.83, "timestamp": "01:38:11", "text": "もし私がカルト集団にいたら、これらは"}, {"type": "subtitle", "time": 5893.43, "timestamp": "01:38:13", "text": "まさに私がなりたいタイプの人たち"}, {"type": "subtitle", "time": 5897.27, "timestamp": "01:38:17", "text": "何かのために犠牲を払う。"}, {"type": "subtitle", "time": 5898.87, "timestamp": "01:38:18", "text": "これらの人たちは誰もここにいないだろう"}, {"type": "subtitle", "time": 5900.94, "timestamp": "01:38:20", "text": "彼らは大釜の中にいるだろう。"}, {"type": "subtitle", "time": 5906.87, "timestamp": "01:38:26", "text": "彼らのポケットに入っている紙幣。"}, {"type": "subtitle", "time": 5910.229, "timestamp": "01:38:30", "text": "了解、メモはよく似ています"}, {"type": "subtitle", "time": 5911.91, "timestamp": "01:38:31", "text": "非常に科学的に見える。たくさんある"}, {"type": "subtitle", "time": 5914.87, "timestamp": "01:38:34", "text": "方程式。でも、私は"}, {"type": "subtitle", "time": 5916.55, "timestamp": "01:38:36", "text": "調査。"}, {"type": "subtitle", "time": 5917.59, "timestamp": "01:38:37", "text": "わかった。"}, {"type": "subtitle", "time": 5920.229, "timestamp": "01:38:40", "text": "メモを解読するには、"}, {"type": "subtitle", "time": 5922.87, "timestamp": "01:38:42", "text": "調査。"}, {"type": "subtitle", "time": 5924.39, "timestamp": "01:38:44", "text": "非常に優れたメモだ。"}, {"type": "subtitle", "time": 5926.87, "timestamp": "01:38:46", "text": "よし。ええ、メモのことですね。ちょっと"}, {"type": "subtitle", "time": 5928.87, "timestamp": "01:38:48", "text": "君には賢すぎるけど、少なくとも君は知っている"}, {"type": "subtitle", "time": 5931.83, "timestamp": "01:38:51", "text": "そのメモは明らかに不完全だ。"}, {"type": "subtitle", "time": 5934.709, "timestamp": "01:38:54", "text": "わかった。えっと、私はただ"}, {"type": "subtitle", "time": 5936.79, "timestamp": "01:38:56", "text": "よし。うん。そして楽しいFも楽しい"}, {"type": "subtitle", "time": 5937.99, "timestamp": "01:38:57", "text": "内部に似たものを見つけました"}]
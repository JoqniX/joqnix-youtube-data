[{"type": "subtitle", "time": 9721.75, "timestamp": "02:42:01", "text": "えっと、今たまたま"}, {"type": "subtitle", "time": 9724.63, "timestamp": "02:42:04", "text": "アリーナが月に引き込まれた"}, {"type": "subtitle", "time": 9727.19, "timestamp": "02:42:07", "text": "ビーム。つまり、アリーナは"}, {"type": "subtitle", "time": 9731.75, "timestamp": "02:42:11", "text": "月の光。よし。再び2d10。"}, {"type": "subtitle", "time": 9732.95, "timestamp": "02:42:12", "text": "うん。とりあえずセーブしておこうかな。私"}, {"type": "subtitle", "time": 9735.03, "timestamp": "02:42:15", "text": "忘れてた ああ、作るのを忘れてた"}, {"type": "subtitle", "time": 9735.99, "timestamp": "02:42:15", "text": "前のものを保存するが、"}, {"type": "subtitle", "time": 9738.95, "timestamp": "02:42:18", "text": "心配。セーブする。それから、えーと"}, {"type": "subtitle", "time": 9740.309, "timestamp": "02:42:20", "text": "どのような種類のセーブデータですか？"}, {"type": "subtitle", "time": 9742.389, "timestamp": "02:42:22", "text": "えっと、間違ってなければconだったと思います。私にさせて"}, {"type": "subtitle", "time": 9744.71, "timestamp": "02:42:24", "text": "もう一度確認してください。実際、私はただ"}, {"type": "subtitle", "time": 9747.349, "timestamp": "02:42:27", "text": "このビューをクリックする。つまり、"}, {"type": "subtitle", "time": 9750.469, "timestamp": "02:42:30", "text": "キャストを消費します。ええ、そうですね。 DC-15"}, {"type": "subtitle", "time": 9753.03, "timestamp": "02:42:33", "text": "憲法は救う。うん。そしてジョギング"}, {"type": "subtitle", "time": 9755.67, "timestamp": "02:42:35", "text": "転がす"}, {"type": "subtitle", "time": 9758.95, "timestamp": "02:42:38", "text": "ジョグロールロールダメージは"}, {"type": "subtitle", "time": 9760.79, "timestamp": "02:42:40", "text": "ダメージ。"}, {"type": "subtitle", "time": 9761.91, "timestamp": "02:42:41", "text": "わかった。"}, {"type": "subtitle", "time": 9774.71, "timestamp": "02:42:54", "text": "よし。さあ、皆さんは"}, {"type": "subtitle", "time": 9776.95, "timestamp": "02:42:56", "text": "ここで一緒に動く。だから、もしあなたが"}, {"type": "subtitle", "time": 9779.51, "timestamp": "02:42:59", "text": "ジョギングすれば、すぐに月の光のように感じられるでしょう"}]
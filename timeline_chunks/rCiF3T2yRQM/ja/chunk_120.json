[{"type": "subtitle", "time": 7200.07, "timestamp": "02:00:00", "text": "それに対して反応する。それはまるで"}, {"type": "subtitle", "time": 7203.03, "timestamp": "02:00:03", "text": "重要な意味で。ああ、わかりました。それを持っている"}, {"type": "subtitle", "time": 7204.79, "timestamp": "02:00:04", "text": "似たような反応だったけど、"}, {"type": "subtitle", "time": 7206.55, "timestamp": "02:00:06", "text": "消化するには大きすぎるみたいですね、"}, {"type": "subtitle", "time": 7208.629, "timestamp": "02:00:08", "text": "言えることは言えます。"}, {"type": "subtitle", "time": 7215.99, "timestamp": "02:00:15", "text": "さて、皆さんはどう思いますか？"}, {"type": "subtitle", "time": 7222.07, "timestamp": "02:00:22", "text": "ロータスはこう言うだろう、「私は"}, {"type": "subtitle", "time": 7224.55, "timestamp": "02:00:24", "text": "まさに私を送りたい"}, {"type": "subtitle", "time": 7226.95, "timestamp": "02:00:26", "text": "みんなが私たちに送ってくれるのが好きで、"}, {"type": "subtitle", "time": 7229.83, "timestamp": "02:00:29", "text": "特にアリアナを送らない"}, {"type": "subtitle", "time": 7235.51, "timestamp": "02:00:35", "text": "肉は食べられるまでになるが、"}, {"type": "subtitle", "time": 7237.589, "timestamp": "02:00:37", "text": "他に選択肢はない"}, {"type": "subtitle", "time": 7239.99, "timestamp": "02:00:39", "text": "現時点で。"}, {"type": "subtitle", "time": 7241.75, "timestamp": "02:00:41", "text": "そんなに多くは手に入らないだろう"}, {"type": "subtitle", "time": 7243.91, "timestamp": "02:00:43", "text": "この情報"}, {"type": "subtitle", "time": 7246.95, "timestamp": "02:00:46", "text": "バカなクソキノコめ。"}, {"type": "subtitle", "time": 7248.629, "timestamp": "02:00:48", "text": "「ああ、私がリードするよ」って感じになるだろう"}, {"type": "subtitle", "time": 7249.99, "timestamp": "02:00:49", "text": "告訴状。」そして彼女は行くつもりだ"}, {"type": "subtitle", "time": 7251.35, "timestamp": "02:00:51", "text": "先に。"}, {"type": "subtitle", "time": 7253.03, "timestamp": "02:00:53", "text": "なんてこった。"}, {"type": "subtitle", "time": 7255.589, "timestamp": "02:00:55", "text": "あなたは滑り込んだ。シーッ。そして、"}, {"type": "subtitle", "time": 7259.109, "timestamp": "02:00:59", "text": "何があるの？黄色い液体があります"}]
[{"type": "subtitle", "time": 4020.15, "timestamp": "01:07:00", "text": "ゆっくりと筋肉によって"}, {"type": "subtitle", "time": 4021.349, "timestamp": "01:07:01", "text": "その物。"}, {"type": "subtitle", "time": 4025.67, "timestamp": "01:07:05", "text": "まあ。それはあまり役に立たないようだ。"}, {"type": "subtitle", "time": 4035.43, "timestamp": "01:07:15", "text": "もう一度攻撃を試みてもよいだろう。"}, {"type": "subtitle", "time": 4042.63, "timestamp": "01:07:22", "text": "もう一本矢を放つだけだ。"}, {"type": "subtitle", "time": 4045.19, "timestamp": "01:07:25", "text": "あと、とにかくぶっ放してやれ。"}, {"type": "subtitle", "time": 4047.43, "timestamp": "01:07:27", "text": "わかった。"}, {"type": "subtitle", "time": 4049.589, "timestamp": "01:07:29", "text": "右。ダメージロールを振るだけです。"}, {"type": "subtitle", "time": 4052.309, "timestamp": "01:07:32", "text": "はい。"}, {"type": "subtitle", "time": 4055.27, "timestamp": "01:07:35", "text": "わかった。床を爆破する。そうではない"}, {"type": "subtitle", "time": 4057.589, "timestamp": "01:07:37", "text": "何もしていないように見える。"}, {"type": "subtitle", "time": 4059.67, "timestamp": "01:07:39", "text": "ちょっとピクピクさせるだけ"}, {"type": "subtitle", "time": 4060.95, "timestamp": "01:07:40", "text": "そして、だいたいそんな感じです。また、"}, {"type": "subtitle", "time": 4062.15, "timestamp": "01:07:42", "text": "何？ごめん。"}, {"type": "subtitle", "time": 4064.63, "timestamp": "01:07:44", "text": "水を形作ることができますか？水分補給だけしてもいいですか？"}, {"type": "subtitle", "time": 4066.23, "timestamp": "01:07:46", "text": "水分補給？"}, {"type": "subtitle", "time": 4067.67, "timestamp": "01:07:47", "text": "口の中を潤しましょう。"}, {"type": "subtitle", "time": 4069.27, "timestamp": "01:07:49", "text": "つまり、私は"}, {"type": "subtitle", "time": 4071.43, "timestamp": "01:07:51", "text": "そうですね、好きになれると思います"}, {"type": "subtitle", "time": 4073.19, "timestamp": "01:07:53", "text": "ここには水があります"}, {"type": "subtitle", "time": 4075.27, "timestamp": "01:07:55", "text": "水と一緒に振ってください。"}, {"type": "subtitle", "time": 4076.789, "timestamp": "01:07:56", "text": "肉に水分を与えるだけです"}, {"type": "subtitle", "time": 4079.589, "timestamp": "01:07:59", "text": "非常に速く。"}]
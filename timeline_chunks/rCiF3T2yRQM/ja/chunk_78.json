[{"type": "subtitle", "time": 4681.59, "timestamp": "01:18:01", "text": "えっと、知ってると思うけど、ティックして教えて"}, {"type": "subtitle", "time": 4684.47, "timestamp": "01:18:04", "text": "ティックとアリアナはただ引っ張るだけ"}, {"type": "subtitle", "time": 4686.63, "timestamp": "01:18:06", "text": "このロープ"}, {"type": "subtitle", "time": 4689.75, "timestamp": "01:18:09", "text": "お願いします。よし、アリアナがロープを持っていくよ。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "ありがとう。次は私の番です。"}, {"type": "subtitle", "time": 4695.75, "timestamp": "01:18:15", "text": "わかった。よし。わかった。誰が持ちこたえているのか"}, {"type": "subtitle", "time": 4697.75, "timestamp": "01:18:17", "text": "ところで、ロープのことですか？ところで、"}, {"type": "subtitle", "time": 4699.27, "timestamp": "01:18:19", "text": "念のため確認させてください。"}, {"type": "subtitle", "time": 4700.229, "timestamp": "01:18:20", "text": "ロープ。"}, {"type": "subtitle", "time": 4702.229, "timestamp": "01:18:22", "text": "わかった。そして、もう一人はどうですか？"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "外見はティックやエスタンのような感じ？だって、"}, {"type": "subtitle", "time": 4708.709, "timestamp": "01:18:28", "text": "それはあなた方の誰かのものだったんですよね？"}, {"type": "subtitle", "time": 4710.55, "timestamp": "01:18:30", "text": "うん。うん。私はそれを今保持しています"}, {"type": "subtitle", "time": 4711.03, "timestamp": "01:18:31", "text": "今。"}, {"type": "subtitle", "time": 4713.83, "timestamp": "01:18:33", "text": "ああ、わかりました。えっと、えっと"}, {"type": "subtitle", "time": 4715.91, "timestamp": "01:18:35", "text": "それを覚えておいてください。ティックはまだ動いていないので"}, {"type": "subtitle", "time": 4717.91, "timestamp": "01:18:37", "text": "彼はまだそれを保持できない。"}, {"type": "subtitle", "time": 4719.51, "timestamp": "01:18:39", "text": "うん。"}, {"type": "subtitle", "time": 4722.39, "timestamp": "01:18:42", "text": "ティックに独自の計画がない限りは。"}, {"type": "subtitle", "time": 4724.39, "timestamp": "01:18:44", "text": "わかった。"}, {"type": "subtitle", "time": 4726.95, "timestamp": "01:18:46", "text": "ティックには計画がある。"}, {"type": "subtitle", "time": 4729.189, "timestamp": "01:18:49", "text": "わかった。ああ、ジョー、今度はあなたの番よ。"}, {"type": "subtitle", "time": 4731.11, "timestamp": "01:18:51", "text": "えっと、"}, {"type": "subtitle", "time": 4735.11, "timestamp": "01:18:55", "text": "エンダングル呪文を唱えるべきでしょうか？"}, {"type": "subtitle", "time": 4737.669, "timestamp": "01:18:57", "text": "芽腺を成長させ、"}]
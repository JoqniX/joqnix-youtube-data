[{"type": "subtitle", "time": 5641.99, "timestamp": "01:34:01", "text": "何が起こるか見てみたい。"}, {"type": "subtitle", "time": 5644.87, "timestamp": "01:34:04", "text": "パーティーで大暴れする。"}, {"type": "subtitle", "time": 5645.75, "timestamp": "01:34:05", "text": "うん。"}, {"type": "subtitle", "time": 5648.229, "timestamp": "01:34:08", "text": "わかった。滴下します"}, {"type": "subtitle", "time": 5651.27, "timestamp": "01:34:11", "text": "死体の上に液体が付着していた。始まりは"}, {"type": "subtitle", "time": 5654.39, "timestamp": "01:34:14", "text": "死体を通して溶けていく。"}, {"type": "subtitle", "time": 5656.39, "timestamp": "01:34:16", "text": "でも、調査ロールをしてほしい"}, {"type": "subtitle", "time": 5658.149, "timestamp": "01:34:18", "text": "ここでの認識、または認識に応じて"}, {"type": "subtitle", "time": 5661.189, "timestamp": "01:34:21", "text": "1つ。調査を開始します。"}, {"type": "subtitle", "time": 5663.03, "timestamp": "01:34:23", "text": "まあ、生き残るのも悪くないと思うけど。"}, {"type": "subtitle", "time": 5664.55, "timestamp": "01:34:24", "text": "どちらが高いかによります。"}, {"type": "subtitle", "time": 5666.79, "timestamp": "01:34:26", "text": "また、調査も行いました。私の生存は"}, {"type": "subtitle", "time": 5667.91, "timestamp": "01:34:27", "text": "マイナス1。"}, {"type": "subtitle", "time": 5669.11, "timestamp": "01:34:29", "text": "何てことだ。"}, {"type": "subtitle", "time": 5671.27, "timestamp": "01:34:31", "text": "あと、ハンハン、えっと"}, {"type": "subtitle", "time": 5674.79, "timestamp": "01:34:34", "text": "私の"}, {"type": "subtitle", "time": 5677.99, "timestamp": "01:34:37", "text": "ワインボトル？液体のように取り出す"}, {"type": "subtitle", "time": 5681.189, "timestamp": "01:34:41", "text": "その中に入れて、この無瓶ワインを満たしてください"}, {"type": "subtitle", "time": 5683.11, "timestamp": "01:34:43", "text": "黒い水が入ったボトル。"}, {"type": "subtitle", "time": 5685.27, "timestamp": "01:34:45", "text": "はい。ご自由にどうぞ。"}, {"type": "subtitle", "time": 5690.31, "timestamp": "01:34:50", "text": "ご自由にどうぞ。よし。わかった。ああ、"}, {"type": "subtitle", "time": 5692.31, "timestamp": "01:34:52", "text": "うん。アリアナの場合、"}, {"type": "subtitle", "time": 5694.709, "timestamp": "01:34:54", "text": "液体を落とすと、"}, {"type": "subtitle", "time": 5698.07, "timestamp": "01:34:58", "text": "それはワットチャマコールに入ります"}]
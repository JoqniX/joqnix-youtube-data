[{"type": "subtitle", "time": 4560.63, "timestamp": "01:16:00", "text": "おお。"}, {"type": "subtitle", "time": 4563.11, "timestamp": "01:16:03", "text": "えっと、エスタン、次は君の番だ。どうやって脱出するの？"}, {"type": "subtitle", "time": 4576.149, "timestamp": "01:16:16", "text": "言わないで"}, {"type": "subtitle", "time": 4576.95, "timestamp": "01:16:16", "text": "えっと、"}, {"type": "subtitle", "time": 4577.91, "timestamp": "01:16:17", "text": "振り返ってこう言うだろう、"}, {"type": "subtitle", "time": 4579.51, "timestamp": "01:16:19", "text": "「みんな大丈夫？」"}, {"type": "subtitle", "time": 4581.03, "timestamp": "01:16:21", "text": "えっと、"}, {"type": "subtitle", "time": 4583.43, "timestamp": "01:16:23", "text": "私たちは行き詰まってしまった。"}, {"type": "subtitle", "time": 4584.79, "timestamp": "01:16:24", "text": "立ち往生。"}, {"type": "subtitle", "time": 4588.07, "timestamp": "01:16:28", "text": "えっと、ちょっと"}, {"type": "subtitle", "time": 4591.35, "timestamp": "01:16:31", "text": "ここは要注意です。うーん、試してみようかな"}, {"type": "subtitle", "time": 4595.27, "timestamp": "01:16:35", "text": "そこから離れて、"}, {"type": "subtitle", "time": 4598.229, "timestamp": "01:16:38", "text": "わかった、ディスクに戻る。"}, {"type": "subtitle", "time": 4599.35, "timestamp": "01:16:39", "text": "わかった。少し難しいだろう。"}, {"type": "subtitle", "time": 4600.55, "timestamp": "01:16:40", "text": "政治。"}, {"type": "subtitle", "time": 4602.63, "timestamp": "01:16:42", "text": "うん、ちょっと大変だろうね。"}, {"type": "subtitle", "time": 4604.63, "timestamp": "01:16:44", "text": "でも、少なくとも私は"}, {"type": "subtitle", "time": 4607.189, "timestamp": "01:16:47", "text": "マイナス1だけど、それでも私はそうだ。本当に？"}, {"type": "subtitle", "time": 4613.99, "timestamp": "01:16:53", "text": "わかった。ああ、そうだね、君はただ君はただ"}, {"type": "subtitle", "time": 4615.59, "timestamp": "01:16:55", "text": "地面に倒れ込んだ。"}, {"type": "subtitle", "time": 4616.07, "timestamp": "01:16:56", "text": "はい。"}, {"type": "subtitle", "time": 4617.43, "timestamp": "01:16:57", "text": "地面に。"}]
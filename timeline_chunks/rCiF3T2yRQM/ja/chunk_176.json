[{"type": "subtitle", "time": 10561.83, "timestamp": "02:56:01", "text": "私のボーナスキー。"}, {"type": "subtitle", "time": 10564.55, "timestamp": "02:56:04", "text": "わかったよ、ステファン。よし。ああ、わかった。以来"}, {"type": "subtitle", "time": 10567.51, "timestamp": "02:56:07", "text": "ここからターンを開始します、"}, {"type": "subtitle", "time": 10569.91, "timestamp": "02:56:09", "text": "床は積極的にあなたを動かそうとしています。する"}, {"type": "subtitle", "time": 10572.95, "timestamp": "02:56:12", "text": "抵抗したいのか、したくないのか？"}, {"type": "subtitle", "time": 10574.63, "timestamp": "02:56:14", "text": "抵抗する。くそ。"}, {"type": "subtitle", "time": 10578.15, "timestamp": "02:56:18", "text": "えっと、アクションを使う必要がありますか？"}, {"type": "subtitle", "time": 10578.87, "timestamp": "02:56:18", "text": "抵抗する？"}, {"type": "subtitle", "time": 10580.71, "timestamp": "02:56:20", "text": "いいえ、アクションを使用する必要はありません。"}, {"type": "subtitle", "time": 10584.309, "timestamp": "02:56:24", "text": "ああ、あのね？面白い。いいえ。"}, {"type": "subtitle", "time": 10586.63, "timestamp": "02:56:26", "text": "わかった。よし。えっと、あなたは"}, {"type": "subtitle", "time": 10587.91, "timestamp": "02:56:27", "text": "自動。これは移動コストを伴いません。"}, {"type": "subtitle", "time": 10589.75, "timestamp": "02:56:29", "text": "あなたは自動的にあちらへ行きます"}, {"type": "subtitle", "time": 10593.429, "timestamp": "02:56:33", "text": "10時頃。了解。 10フィートくらい。"}, {"type": "subtitle", "time": 10595.91, "timestamp": "02:56:35", "text": "ええ、どうぞご自由に"}, {"type": "subtitle", "time": 10601.75, "timestamp": "02:56:41", "text": "わかった。"}, {"type": "subtitle", "time": 10603.99, "timestamp": "02:56:43", "text": "待って。実際、ちょっと見てみましょう"}, {"type": "subtitle", "time": 10606.63, "timestamp": "02:56:46", "text": "私の呪文をすぐに使ってください。いや、私は"}, {"type": "subtitle", "time": 10609.07, "timestamp": "02:56:49", "text": "クソがある。"}, {"type": "subtitle", "time": 10611.19, "timestamp": "02:56:51", "text": "[音楽]"}, {"type": "subtitle", "time": 10613.349, "timestamp": "02:56:53", "text": "ウォーロックのライフスタイルへようこそ。"}, {"type": "subtitle", "time": 10616.469, "timestamp": "02:56:56", "text": "正直、ウォーロックであることは大嫌いだ。そうです。"}, {"type": "subtitle", "time": 10618.469, "timestamp": "02:56:58", "text": "あなたはごくわずかな呪文しか持っていません"}]
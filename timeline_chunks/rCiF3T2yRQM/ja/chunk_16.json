[{"type": "subtitle", "time": 961.11, "timestamp": "00:16:01", "text": "来たいですか？ 来たいですか？"}, {"type": "subtitle", "time": 964.71, "timestamp": "00:16:04", "text": "それでは、私たちと一緒に？チクッ。"}, {"type": "subtitle", "time": 967.03, "timestamp": "00:16:07", "text": "うん。"}, {"type": "subtitle", "time": 969.67, "timestamp": "00:16:09", "text": "やったー。"}, {"type": "subtitle", "time": 971.67, "timestamp": "00:16:11", "text": "ループバグのことは、私の想像に過ぎないと思う。"}, {"type": "subtitle", "time": 974.71, "timestamp": "00:16:14", "text": "やったー！"}, {"type": "subtitle", "time": 977.509, "timestamp": "00:16:17", "text": "うん。あなたは"}, {"type": "subtitle", "time": 980.949, "timestamp": "00:16:20", "text": "あなたはTexの一員です"}, {"type": "subtitle", "time": 985.509, "timestamp": "00:16:25", "text": "スパイ・スパイ・ヘレン、スパイ・ヘルデンも今や。"}, {"type": "subtitle", "time": 987.749, "timestamp": "00:16:27", "text": "前回と同じだ。"}, {"type": "subtitle", "time": 989.43, "timestamp": "00:16:29", "text": "最後の一つ。"}, {"type": "subtitle", "time": 991.99, "timestamp": "00:16:31", "text": "それは非常に怪しいですね。何"}, {"type": "subtitle", "time": 992.23, "timestamp": "00:16:32", "text": "起こった"}, {"type": "subtitle", "time": 993.829, "timestamp": "00:16:33", "text": "最後の人たちまで？"}, {"type": "subtitle", "time": 996.87, "timestamp": "00:16:36", "text": "前回はどうなったの？チクッ。"}, {"type": "subtitle", "time": 999.43, "timestamp": "00:16:39", "text": "ティックは迷子になった。"}, {"type": "subtitle", "time": 1002.87, "timestamp": "00:16:42", "text": "あなたは迷子になり、"}, {"type": "subtitle", "time": 1005.11, "timestamp": "00:16:45", "text": "洞窟で寝ることにした"}, {"type": "subtitle", "time": 1010.87, "timestamp": "00:16:50", "text": "ああ、ほら、"}, {"type": "subtitle", "time": 1013.43, "timestamp": "00:16:53", "text": "あのね？もううんざりだ"}, {"type": "subtitle", "time": 1016.79, "timestamp": "00:16:56", "text": "謎めいた敗北とともに"}]
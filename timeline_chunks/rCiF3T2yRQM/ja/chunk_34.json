[{"type": "subtitle", "time": 2040.63, "timestamp": "00:34:00", "text": "チェックを入れることには大きな意味がある。"}, {"type": "subtitle", "time": 2042.31, "timestamp": "00:34:02", "text": "うわあ、ゲームが全然読み込まれない。私は必要としている"}, {"type": "subtitle", "time": 2043.029, "timestamp": "00:34:03", "text": "再起動する。"}, {"type": "subtitle", "time": 2045.029, "timestamp": "00:34:05", "text": "はい、リフレッシュしてみてください。試してみてください"}, {"type": "subtitle", "time": 2048.389, "timestamp": "00:34:08", "text": "更新します。あと、えっと、ありがとう"}, {"type": "subtitle", "time": 2050.71, "timestamp": "00:34:10", "text": "より早く購読する。えっと、誰かが"}, {"type": "subtitle", "time": 2052.31, "timestamp": "00:34:12", "text": "名前を覚えていなかった。つまり、私はあなたなの"}, {"type": "subtitle", "time": 2053.589, "timestamp": "00:34:13", "text": "何だと思う？そのためには、"}, {"type": "subtitle", "time": 2055.109, "timestamp": "00:34:15", "text": "ティック、君に何を与えるか、君は"}, {"type": "subtitle", "time": 2057.589, "timestamp": "00:34:17", "text": "その購読からインスピレーションを得た。"}, {"type": "subtitle", "time": 2061.03, "timestamp": "00:34:21", "text": "やったー。ティックは物語からインスピレーションを得ている。"}, {"type": "subtitle", "time": 2063.19, "timestamp": "00:34:23", "text": "インスパイヤされた。わーい。"}, {"type": "subtitle", "time": 2065.349, "timestamp": "00:34:25", "text": "インスパイヤされた。"}, {"type": "subtitle", "time": 2066.23, "timestamp": "00:34:26", "text": "それはインスピレーションだ。"}, {"type": "subtitle", "time": 2068.71, "timestamp": "00:34:28", "text": "岩。あなたはティックにもっと食べるように促しました"}, {"type": "subtitle", "time": 2069.43, "timestamp": "00:34:29", "text": "岩。"}, {"type": "subtitle", "time": 2070.79, "timestamp": "00:34:30", "text": "もちろんさ。"}, {"type": "subtitle", "time": 2073.589, "timestamp": "00:34:33", "text": "これ以上石を食べないでください。"}, {"type": "subtitle", "time": 2076.149, "timestamp": "00:34:36", "text": "それは健康"}, {"type": "subtitle", "time": 2078.55, "timestamp": "00:34:38", "text": "購読すると。"}, {"type": "subtitle", "time": 2087.109, "timestamp": "00:34:47", "text": "ストリームのようなものがあれば教えてください"}, {"type": "subtitle", "time": 2088.31, "timestamp": "00:34:48", "text": "イベント、なぜなら私はこれを引っ張るつもりだから"}, {"type": "subtitle", "time": 2089.909, "timestamp": "00:34:49", "text": "男が出て行った。"}, {"type": "subtitle", "time": 2095.909, "timestamp": "00:34:55", "text": "恐ろしい。それが何なのかさえわからない"}, {"type": "subtitle", "time": 2097.19, "timestamp": "00:34:57", "text": "手段。"}]
[{"type": "subtitle", "time": 362.53, "timestamp": "00:06:02", "text": "今日、ルディは交代させられた"}, {"type": "subtitle", "time": 365.029, "timestamp": "00:06:05", "text": "[音楽]"}, {"type": "subtitle", "time": 369.11, "timestamp": "00:06:09", "text": "実際よりもはるかに悪く言われている。"}, {"type": "subtitle", "time": 370.87, "timestamp": "00:06:10", "text": "うん、"}, {"type": "subtitle", "time": 373.43, "timestamp": "00:06:13", "text": "ライ・ルーシーは偶然変身した"}, {"type": "subtitle", "time": 377.909, "timestamp": "00:06:17", "text": "何らかの魔法的な手段によって。"}, {"type": "subtitle", "time": 380.07, "timestamp": "00:06:20", "text": "ご心配なく。すべて順調です。"}, {"type": "subtitle", "time": 382.629, "timestamp": "00:06:22", "text": "ええ、すべて順調です。で"}, {"type": "subtitle", "time": 383.83, "timestamp": "00:06:23", "text": "少なくとも彼らはそう言っている。"}, {"type": "subtitle", "time": 385.189, "timestamp": "00:06:25", "text": "こんにちは、みんな。ようこそ。"}, {"type": "subtitle", "time": 387.67, "timestamp": "00:06:27", "text": "私が"}, {"type": "subtitle", "time": 389.16, "timestamp": "00:06:29", "text": "思いやり"}, {"type": "subtitle", "time": 390.629, "timestamp": "00:06:30", "text": "[音楽]"}, {"type": "subtitle", "time": 399.27, "timestamp": "00:06:39", "text": "うん。車に乗ってください。大丈夫だよ。"}, {"type": "subtitle", "time": 401.749, "timestamp": "00:06:41", "text": "ただの擦り傷だよ。"}, {"type": "subtitle", "time": 404.55, "timestamp": "00:06:44", "text": "あなたはもっと強いはずだ。"}, {"type": "subtitle", "time": 407.11, "timestamp": "00:06:47", "text": "ただの擦り傷だよ、兄弟。"}, {"type": "subtitle", "time": 409.43, "timestamp": "00:06:49", "text": "わかった。"}, {"type": "subtitle", "time": 411.67, "timestamp": "00:06:51", "text": "よし。わかった。いつもまだ"}, {"type": "subtitle", "time": 413.189, "timestamp": "00:06:53", "text": "ミュート。"}, {"type": "subtitle", "time": 414.71, "timestamp": "00:06:54", "text": "自分がミュートされていたことに気づきませんでした。くそっ"}, {"type": "subtitle", "time": 415.189, "timestamp": "00:06:55", "text": "それ。"}, {"type": "subtitle", "time": 417.99, "timestamp": "00:06:57", "text": "おお、"}, {"type": "subtitle", "time": 419.83, "timestamp": "00:06:59", "text": "言っておいてよかった。"}]
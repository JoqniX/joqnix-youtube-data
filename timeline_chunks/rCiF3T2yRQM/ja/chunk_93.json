[{"type": "subtitle", "time": 5580.709, "timestamp": "01:33:00", "text": "竜の回復力は、あなたのHPを増加させます。"}, {"type": "subtitle", "time": 5582.629, "timestamp": "01:33:02", "text": "おお、それはいいですね。"}, {"type": "subtitle", "time": 5583.99, "timestamp": "01:33:03", "text": "はい、ちょっと待ってください。なぜあなたが"}, {"type": "subtitle", "time": 5585.83, "timestamp": "01:33:05", "text": "依然として伏せている。そして私はまた、"}, {"type": "subtitle", "time": 5587.59, "timestamp": "01:33:07", "text": "現金でやりますよ。"}, {"type": "subtitle", "time": 5588.87, "timestamp": "01:33:08", "text": "あなたのトークンはちょっと酔っ払っている"}, {"type": "subtitle", "time": 5590.47, "timestamp": "01:33:10", "text": "理由。でもね、知ってる？了解"}, {"type": "subtitle", "time": 5592.629, "timestamp": "01:33:12", "text": "キャラクター。"}, {"type": "subtitle", "time": 5595.189, "timestamp": "01:33:15", "text": "よし、見てみよう。"}, {"type": "subtitle", "time": 5598.47, "timestamp": "01:33:18", "text": "ディック、調子はどうだい？"}, {"type": "subtitle", "time": 5599.43, "timestamp": "01:33:19", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 5601.35, "timestamp": "01:33:21", "text": "はい、どうぞ。損害を受けたのはあなたです。全て"}, {"type": "subtitle", "time": 5604.39, "timestamp": "01:33:24", "text": "右。水はその後辛かったですか？"}, {"type": "subtitle", "time": 5607.43, "timestamp": "01:33:27", "text": "若干？"}, {"type": "subtitle", "time": 5608.149, "timestamp": "01:33:28", "text": "それは良い情報ですね。"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "それは飲まないで。"}, {"type": "subtitle", "time": 5611.27, "timestamp": "01:33:31", "text": "スパイシーな水。"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "わかった。アリーナはただバイアルを見ているだけだ"}, {"type": "subtitle", "time": 5621.27, "timestamp": "01:33:41", "text": "「黒い液体です。」わかりました。"}, {"type": "subtitle", "time": 5627.189, "timestamp": "01:33:47", "text": "ありがとう、ティック。あなた"}, {"type": "subtitle", "time": 5629.27, "timestamp": "01:33:49", "text": "素晴らしい仕事ぶりだった。"}, {"type": "subtitle", "time": 5631.669, "timestamp": "01:33:51", "text": "素晴らしい仕事ぶりでした。パッチパッチ。"}, {"type": "subtitle", "time": 5634.149, "timestamp": "01:33:54", "text": "黒の雫のように注いでもいいですか？"}, {"type": "subtitle", "time": 5636.79, "timestamp": "01:33:56", "text": "私の隣の死体に液体がかかっている？"}, {"type": "subtitle", "time": 5638.79, "timestamp": "01:33:58", "text": "はい、できますよ。"}]
[{"type": "subtitle", "time": 4142.07, "timestamp": "01:09:02", "text": "では、このように調査すべきでしょうか？"}, {"type": "subtitle", "time": 4143.749, "timestamp": "01:09:03", "text": "あるいはその逆？どう思いますか、"}, {"type": "subtitle", "time": 4146.63, "timestamp": "01:09:06", "text": "男？"}, {"type": "subtitle", "time": 4149.03, "timestamp": "01:09:09", "text": "ああ、くそ。"}, {"type": "subtitle", "time": 4150.709, "timestamp": "01:09:10", "text": "待って。こんにちは。こんにちは。こんにちは。ごめん。私の"}, {"type": "subtitle", "time": 4153.749, "timestamp": "01:09:13", "text": "クソッ、インターネットが一瞬ダウンした。"}, {"type": "subtitle", "time": 4157.11, "timestamp": "01:09:17", "text": "大丈夫。さあ行こう。フィリピン人"}, {"type": "subtitle", "time": 4158.229, "timestamp": "01:09:18", "text": "経験。"}, {"type": "subtitle", "time": 4159.03, "timestamp": "01:09:19", "text": "大丈夫です。"}, {"type": "chat", "time": 4161.305, "timestamp": "01:09:21", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "back"}, {"type": "subtitle", "time": 4162.47, "timestamp": "01:09:22", "text": "フィリピン人のXです。つまり、そうではなかった"}, {"type": "subtitle", "time": 4164.47, "timestamp": "01:09:24", "text": "行きたい。それはそれを殺したわけではない"}, {"type": "subtitle", "time": 4166.39, "timestamp": "01:09:26", "text": "まるで昔の電気みたいだ。ただ"}, {"type": "subtitle", "time": 4168.07, "timestamp": "01:09:28", "text": "今のところはインターネットで済ませています。"}, {"type": "subtitle", "time": 4169.749, "timestamp": "01:09:29", "text": "これは第一段階です。"}, {"type": "subtitle", "time": 4175.189, "timestamp": "01:09:35", "text": "さて、君はどう思う？そして"}, {"type": "subtitle", "time": 4176.95, "timestamp": "01:09:36", "text": "彼女はマスター・ロータス・Lを支えようとしている。"}, {"type": "subtitle", "time": 4179.189, "timestamp": "01:09:39", "text": "調査すべきではないと思う"}, {"type": "subtitle", "time": 4184.39, "timestamp": "01:09:44", "text": "肉の部分。それは危険そうだ。"}, {"type": "subtitle", "time": 4187.349, "timestamp": "01:09:47", "text": "上記の経路の1つは、"}, {"type": "subtitle", "time": 4189.669, "timestamp": "01:09:49", "text": "危険ではあるが、血塗られた道だ。ここ"}, {"type": "subtitle", "time": 4194.07, "timestamp": "01:09:54", "text": "まるで入り口のように見える"}, {"type": "subtitle", "time": 4197.03, "timestamp": "01:09:57", "text": "誰かのマウスへ。私はあまり信用していない"}, {"type": "subtitle", "time": 4199.03, "timestamp": "01:09:59", "text": "両方。だから、私たちは選ばなければならない"}]
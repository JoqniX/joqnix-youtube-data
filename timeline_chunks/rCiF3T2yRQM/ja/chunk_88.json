[{"type": "subtitle", "time": 5284.21, "timestamp": "01:28:04", "text": "単に"}, {"type": "subtitle", "time": 5288.229, "timestamp": "01:28:08", "text": "[笑い]"}, {"type": "subtitle", "time": 5290.39, "timestamp": "01:28:10", "text": "ただあなたの手で握るためだけに。チェックするだけ"}, {"type": "subtitle", "time": 5293.35, "timestamp": "01:28:13", "text": "あなたの手を握りたい。"}, {"type": "subtitle", "time": 5297.03, "timestamp": "01:28:17", "text": "よし、これは許可しよう。"}, {"type": "subtitle", "time": 5298.709, "timestamp": "01:28:18", "text": "そうそう。"}, {"type": "subtitle", "time": 5300.229, "timestamp": "01:28:20", "text": "えっと、"}, {"type": "subtitle", "time": 5303.51, "timestamp": "01:28:23", "text": "まあ、これは私にはあまり"}, {"type": "subtitle", "time": 5305.83, "timestamp": "01:28:25", "text": "これが何なのかは分かっているが、蛇口がある"}, {"type": "subtitle", "time": 5309.27, "timestamp": "01:28:29", "text": "そして私は本当に最後に"}, {"type": "subtitle", "time": 5311.11, "timestamp": "01:28:31", "text": "何かに触ろうとしたら、目がくらんだ。"}, {"type": "subtitle", "time": 5312.39, "timestamp": "01:28:32", "text": "それで、"}, {"type": "subtitle", "time": 5314.629, "timestamp": "01:28:34", "text": "テクノロジーは影響を与えるだろう。"}, {"type": "subtitle", "time": 5316.39, "timestamp": "01:28:36", "text": "あなたは欲しいの？ 知ってる？あなたが知っている"}, {"type": "subtitle", "time": 5319.669, "timestamp": "01:28:39", "text": "何だって、ティック？そうするべきだよ。"}, {"type": "subtitle", "time": 5322.149, "timestamp": "01:28:42", "text": "行ってこの水を飲んでみてください。さあ"}, {"type": "subtitle", "time": 5323.35, "timestamp": "01:28:43", "text": "見る。"}, {"type": "subtitle", "time": 5324.47, "timestamp": "01:28:44", "text": "わかった。"}, {"type": "subtitle", "time": 5326.47, "timestamp": "01:28:46", "text": "よし。わかった。わかった。では、あなたは"}, {"type": "subtitle", "time": 5328.79, "timestamp": "01:28:48", "text": "蛇口を開けてみる？"}, {"type": "subtitle", "time": 5329.35, "timestamp": "01:28:49", "text": "なんてこった。"}, {"type": "subtitle", "time": 5329.92, "timestamp": "01:28:49", "text": "ひよこひよこひよこひよこひよこひよこ ひよこひよひよひよ t t t t t t t t t"}, {"type": "subtitle", "time": 5330.159, "timestamp": "01:28:50", "text": "ひよこひよひよひよ t t t t t t t t t t t t t t t t t t t t t t ひよこひよこ"}, {"type": "subtitle", "time": 5330.719, "timestamp": "01:28:50", "text": "t t t t t t t t t t t t t ひよこひよこ ひよこは口を下に突っ込むのが好き"}, {"type": "subtitle", "time": 5332.239, "timestamp": "01:28:52", "text": "ひよこは口を下に突っ込むのが好き 蛇口を直接使って試す"}, {"type": "subtitle", "time": 5336.08, "timestamp": "01:28:56", "text": "蛇口を直接使って試す 移動中。"}]
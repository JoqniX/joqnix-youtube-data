[{"type": "subtitle", "time": 2881.19, "timestamp": "00:48:01", "text": "何てことだ。ビンボンは触らなかった。"}, {"type": "subtitle", "time": 2891.109, "timestamp": "00:48:11", "text": "いいね。まあ、もしそれが大丈夫なら、"}, {"type": "subtitle", "time": 2892.63, "timestamp": "00:48:12", "text": "これで必要なものは全て揃ったと思います。"}, {"type": "subtitle", "time": 2893.91, "timestamp": "00:48:13", "text": "知っておくべきですよね、皆さん？見に行きましょう"}, {"type": "subtitle", "time": 2896.23, "timestamp": "00:48:16", "text": "パーティーの残りのメンバー。"}, {"type": "subtitle", "time": 2899.109, "timestamp": "00:48:19", "text": "うん、"}, {"type": "subtitle", "time": 2902.549, "timestamp": "00:48:22", "text": "私はそう思います。そうではないようです"}, {"type": "subtitle", "time": 2907.589, "timestamp": "00:48:27", "text": "疑わしい。一体どういう意味ですか？"}, {"type": "subtitle", "time": 2909.51, "timestamp": "00:48:29", "text": "でも、美味しそうですね。"}, {"type": "subtitle", "time": 2910.71, "timestamp": "00:48:30", "text": "美味しい。うん。"}, {"type": "subtitle", "time": 2913.829, "timestamp": "00:48:33", "text": "少なくとも彼女は"}, {"type": "subtitle", "time": 2917.27, "timestamp": "00:48:37", "text": "見た目は間違いなく美味しそうだ。私"}, {"type": "subtitle", "time": 2919.27, "timestamp": "00:48:39", "text": "あなたの話し方が好きです。"}, {"type": "subtitle", "time": 2927.67, "timestamp": "00:48:47", "text": "ティックは駆け寄って彼女を抱きしめるだろう"}, {"type": "subtitle", "time": 2928.95, "timestamp": "00:48:48", "text": "脚。"}, {"type": "subtitle", "time": 2935.109, "timestamp": "00:48:55", "text": "ああ、これは私の足についたぬめりだ。それで、"}, {"type": "subtitle", "time": 2937.27, "timestamp": "00:48:57", "text": "まるで豚がぬめりを垂らしているみたいだ"}, {"type": "subtitle", "time": 2939.43, "timestamp": "00:48:59", "text": "彼らの口から。"}]
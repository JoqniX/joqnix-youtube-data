[{"type": "subtitle", "time": 8700.389, "timestamp": "02:25:00", "text": "待って、呪文を唱えるべきか、それとも"}, {"type": "subtitle", "time": 8701.51, "timestamp": "02:25:01", "text": "ただ"}, {"type": "subtitle", "time": 8703.51, "timestamp": "02:25:03", "text": "それはただ、ある場所へ歩いて行くだけだ。私はただ"}, {"type": "subtitle", "time": 8706.63, "timestamp": "02:25:06", "text": "転がる"}, {"type": "subtitle", "time": 8708.389, "timestamp": "02:25:08", "text": "ええ、チャンネルでロールすることもできます"}, {"type": "subtitle", "time": 8709.83, "timestamp": "02:25:09", "text": "すぐに。"}, {"type": "subtitle", "time": 8712.309, "timestamp": "02:25:12", "text": "わかった。えっと、私は何をしたんでしたっけ？"}, {"type": "subtitle", "time": 8712.95, "timestamp": "02:25:12", "text": "D2"}, {"type": "subtitle", "time": 8714.61, "timestamp": "02:25:14", "text": "スラッシュロール"}, {"type": "subtitle", "time": 8723.429, "timestamp": "02:25:23", "text": "わかった。よし。これからお見せします"}, {"type": "subtitle", "time": 8725.59, "timestamp": "02:25:25", "text": "それ。はい、これで完了です。ああ、12時だ"}, {"type": "subtitle", "time": 8727.67, "timestamp": "02:25:27", "text": "ダメージ。"}, {"type": "subtitle", "time": 8732.55, "timestamp": "02:25:32", "text": "12. よし、これでよし。わかった。そして、"}, {"type": "subtitle", "time": 8736.309, "timestamp": "02:25:36", "text": "スライムは、えっと、"}, {"type": "subtitle", "time": 8743.349, "timestamp": "02:25:43", "text": "そうすればいいんです。わかった。うん、君はただ"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "あなたは、あなたは、あなたは、それは"}, {"type": "subtitle", "time": 8748.87, "timestamp": "02:25:48", "text": "ちょっとだけあなたをイライラさせるだけです。スライム。"}, {"type": "subtitle", "time": 8751.59, "timestamp": "02:25:51", "text": "やめて。"}, {"type": "subtitle", "time": 8755.19, "timestamp": "02:25:55", "text": "対する女の子。"}, {"type": "subtitle", "time": 8758.309, "timestamp": "02:25:58", "text": "わかった。まあ、アリアンはこう言うだろうね。"}]
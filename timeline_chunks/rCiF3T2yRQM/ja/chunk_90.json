[{"type": "subtitle", "time": 5400.87, "timestamp": "01:30:00", "text": "若返った。"}, {"type": "subtitle", "time": 5403.03, "timestamp": "01:30:03", "text": "不思議なことに、一時的に5つの"}, {"type": "subtitle", "time": 5404.709, "timestamp": "01:30:04", "text": "HP。"}, {"type": "subtitle", "time": 5407.43, "timestamp": "01:30:07", "text": "おお。それでも窒息したのは、それがまだ"}, {"type": "subtitle", "time": 5410.87, "timestamp": "01:30:10", "text": "大量の水が1つに流れ込む"}, {"type": "subtitle", "time": 5412.87, "timestamp": "01:30:12", "text": "の"}, {"type": "subtitle", "time": 5414.629, "timestamp": "01:30:14", "text": "ティック、気分はどう？"}, {"type": "subtitle", "time": 5415.189, "timestamp": "01:30:15", "text": "うん、"}, {"type": "subtitle", "time": 5417.83, "timestamp": "01:30:17", "text": "生きている感じがする。"}, {"type": "subtitle", "time": 5418.31, "timestamp": "01:30:18", "text": "生きている実感がある"}, {"type": "subtitle", "time": 5419.83, "timestamp": "01:30:19", "text": "それが終わったら。それが終わったら、"}, {"type": "subtitle", "time": 5422.07, "timestamp": "01:30:22", "text": "もうあの青いものはない"}, {"type": "subtitle", "time": 5423.75, "timestamp": "01:30:23", "text": "えーと、"}, {"type": "subtitle", "time": 5425.11, "timestamp": "01:30:25", "text": "黒い液体の下にある青い液体"}, {"type": "subtitle", "time": 5426.95, "timestamp": "01:30:26", "text": "泡立つもの。"}, {"type": "subtitle", "time": 5428.95, "timestamp": "01:30:28", "text": "それで、最初に出てきたのは"}, {"type": "subtitle", "time": 5430.31, "timestamp": "01:30:30", "text": "青。"}, {"type": "subtitle", "time": 5433.51, "timestamp": "01:30:33", "text": "黒いやつはどんな味がするんだろう？"}, {"type": "subtitle", "time": 5435.99, "timestamp": "01:30:35", "text": "私は自分のインベントリにバイアルを持っています。"}, {"type": "subtitle", "time": 5437.75, "timestamp": "01:30:37", "text": "バイアルに"}, {"type": "subtitle", "time": 5439.03, "timestamp": "01:30:39", "text": "黒い液体？"}, {"type": "subtitle", "time": 5441.51, "timestamp": "01:30:41", "text": "はい、できますよ。"}, {"type": "subtitle", "time": 5444.31, "timestamp": "01:30:44", "text": "もちろんさ。さあ行こう。"}, {"type": "subtitle", "time": 5447.03, "timestamp": "01:30:47", "text": "よし。わかった。黒い小瓶を手に入れた"}, {"type": "subtitle", "time": 5448.229, "timestamp": "01:30:48", "text": "液体。"}, {"type": "subtitle", "time": 5451.43, "timestamp": "01:30:51", "text": "わかった。あなたは黒い液体が入った小瓶を手に入れた。"}, {"type": "subtitle", "time": 5454.31, "timestamp": "01:30:54", "text": "それは泡立っていて、まるで"}, {"type": "subtitle", "time": 5457.11, "timestamp": "01:30:57", "text": "まるで、外に出ようとしているみたいだ。その"}]
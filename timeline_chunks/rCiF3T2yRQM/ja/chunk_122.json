[{"type": "subtitle", "time": 7321.589, "timestamp": "02:02:01", "text": "それを攻撃する。"}, {"type": "subtitle", "time": 7323.99, "timestamp": "02:02:03", "text": "わかった。イニシアチブを振ってください。"}, {"type": "subtitle", "time": 7325.35, "timestamp": "02:02:05", "text": "私たちは死ぬ。おお、"}, {"type": "subtitle", "time": 7328.149, "timestamp": "02:02:08", "text": "待って。くそ。くそ。ごめん。私はしがみつく"}, {"type": "subtitle", "time": 7329.35, "timestamp": "02:02:09", "text": "ボルト。"}, {"type": "subtitle", "time": 7332.47, "timestamp": "02:02:12", "text": "私は案内役です。ボルト締め。私はボルトを締めています"}, {"type": "subtitle", "time": 7334.709, "timestamp": "02:02:14", "text": "ライト。"}, {"type": "subtitle", "time": 7336.55, "timestamp": "02:02:16", "text": "えっと、"}, {"type": "subtitle", "time": 7337.669, "timestamp": "02:02:17", "text": "主導権。"}, {"type": "subtitle", "time": 7340.87, "timestamp": "02:02:20", "text": "わかった。"}, {"type": "subtitle", "time": 7343.109, "timestamp": "02:02:23", "text": "プラス5 17。"}, {"type": "subtitle", "time": 7353.22, "timestamp": "02:02:33", "text": "よし。他に何か取り組みはありますか？"}, {"type": "subtitle", "time": 7354.95, "timestamp": "02:02:34", "text": "[音楽]"}, {"type": "subtitle", "time": 7357.43, "timestamp": "02:02:37", "text": "ジョック。そして"}, {"type": "subtitle", "time": 7364.39, "timestamp": "02:02:44", "text": "わかった。"}, {"type": "subtitle", "time": 7367.03, "timestamp": "02:02:47", "text": "ああ、くそ。まずはダニをいじってみることから始めましょう。"}, {"type": "subtitle", "time": 7369.109, "timestamp": "02:02:49", "text": "なんてこった。"}, {"type": "subtitle", "time": 7375.109, "timestamp": "02:02:55", "text": "よし。"}, {"type": "subtitle", "time": 7376.31, "timestamp": "02:02:56", "text": "食べないで。"}, {"type": "subtitle", "time": 7378.55, "timestamp": "02:02:58", "text": "おそらく処分した方が良いでしょう。チクッ。"}, {"type": "subtitle", "time": 7379.83, "timestamp": "02:02:59", "text": "ええ、それはみんなの"}]
[{"type": "subtitle", "time": 3601.51, "timestamp": "01:00:01", "text": "彼は私と同じような見た目をしている。私はしません"}, {"type": "subtitle", "time": 3604.23, "timestamp": "01:00:04", "text": "知る。宗教とか、そういうものをロールしてもいいですか？"}, {"type": "subtitle", "time": 3606.309, "timestamp": "01:00:06", "text": "宗教？私はそうは思わない、つまり"}, {"type": "subtitle", "time": 3608.15, "timestamp": "01:00:08", "text": "試してみてもいいですよ。"}, {"type": "subtitle", "time": 3611.109, "timestamp": "01:00:11", "text": "いいえ、やってみます。試してみてもいいですよ。"}, {"type": "subtitle", "time": 3612.309, "timestamp": "01:00:12", "text": "何てことだ。"}, {"type": "subtitle", "time": 3614.15, "timestamp": "01:00:14", "text": "わかった。よし。わかった。はい、あなたは"}, {"type": "subtitle", "time": 3616.309, "timestamp": "01:00:16", "text": "試してみます。"}, {"type": "subtitle", "time": 3618.71, "timestamp": "01:00:18", "text": "神は手を差し伸べる必要はないと、あなたは知っているでしょう。"}, {"type": "subtitle", "time": 3622.23, "timestamp": "01:00:22", "text": "このクソみたいなものを作る際に。"}, {"type": "subtitle", "time": 3625.349, "timestamp": "01:00:25", "text": "全く自然ではない。"}, {"type": "subtitle", "time": 3633.03, "timestamp": "01:00:33", "text": "像のことではない。"}, {"type": "subtitle", "time": 3634.789, "timestamp": "01:00:34", "text": "像はどうなったの？チクッ。"}, {"type": "subtitle", "time": 3635.75, "timestamp": "01:00:35", "text": "これはどんな種類の岩ですか？"}, {"type": "subtitle", "time": 3637.829, "timestamp": "01:00:37", "text": "こんにちは。配信へようこ​​そ。"}, {"type": "subtitle", "time": 3640.069, "timestamp": "01:00:40", "text": "像を噛もうとしないでください。"}, {"type": "subtitle", "time": 3642.71, "timestamp": "01:00:42", "text": "像を食べろ。"}, {"type": "subtitle", "time": 3643.91, "timestamp": "01:00:43", "text": "像を食らえ。"}, {"type": "subtitle", "time": 3645.43, "timestamp": "01:00:45", "text": "私たち自身はこう思うでしょう。「まあ、それは"}, {"type": "subtitle", "time": 3647.27, "timestamp": "01:00:47", "text": "私が指で突くと、それはピクピクと動いた"}, {"type": "subtitle", "time": 3649.51, "timestamp": "01:00:49", "text": "剣。今、攻撃してみてもいいですか？"}, {"type": "subtitle", "time": 3651.67, "timestamp": "01:00:51", "text": "うん。ああ、肉体のことですか、それとも彫像のことですか？"}, {"type": "subtitle", "time": 3652.63, "timestamp": "01:00:52", "text": "肉。"}, {"type": "subtitle", "time": 3658.549, "timestamp": "01:00:58", "text": "わかった。私は、あなたはそれさえも必要としないと言うでしょう"}]
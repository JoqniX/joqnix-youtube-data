[{"type": "subtitle", "time": 6540.79, "timestamp": "01:49:00", "text": "それを試してみて。"}, {"type": "subtitle", "time": 6542.87, "timestamp": "01:49:02", "text": "それで、"}, {"type": "subtitle", "time": 6543.99, "timestamp": "01:49:03", "text": "に向かっていく"}, {"type": "subtitle", "time": 6545.43, "timestamp": "01:49:05", "text": "黒い液体が入った小瓶のある別の部屋"}, {"type": "subtitle", "time": 6546.07, "timestamp": "01:49:06", "text": "液体。"}, {"type": "subtitle", "time": 6546.709, "timestamp": "01:49:06", "text": "わかった、"}, {"type": "subtitle", "time": 6549.109, "timestamp": "01:49:09", "text": "これはまるでプロメテウスの粘液のようだ"}, {"type": "subtitle", "time": 6550.87, "timestamp": "01:49:10", "text": "またはいくつか"}, {"type": "subtitle", "time": 6553.43, "timestamp": "01:49:13", "text": "ゼノモーフとかに変身する。"}, {"type": "subtitle", "time": 6556.229, "timestamp": "01:49:16", "text": "これはまるでまだブドウの木のようだと言わざるを得ません。"}, {"type": "subtitle", "time": 6558.07, "timestamp": "01:49:18", "text": "ぶどうの木はまだ"}, {"type": "subtitle", "time": 6560.79, "timestamp": "01:49:20", "text": "渡る。"}, {"type": "subtitle", "time": 6563.51, "timestamp": "01:49:23", "text": "ブドウ畑を横切り、"}, {"type": "subtitle", "time": 6565.35, "timestamp": "01:49:25", "text": "右？これから入るよ。"}, {"type": "subtitle", "time": 6567.189, "timestamp": "01:49:27", "text": "手を伸ばすと"}, {"type": "subtitle", "time": 6569.51, "timestamp": "01:49:29", "text": "瓶の中身を注ぎ出してください。"}, {"type": "subtitle", "time": 6572.149, "timestamp": "01:49:32", "text": "わかった。よし。えっと、注ぎ出す"}, {"type": "subtitle", "time": 6575.59, "timestamp": "01:49:35", "text": "バイアルが滑り始める。"}, {"type": "subtitle", "time": 6577.03, "timestamp": "01:49:37", "text": "ほら、ほら、水銀みたいに"}, {"type": "subtitle", "time": 6579.03, "timestamp": "01:49:39", "text": "手の甲に滑り落ちる？"}, {"type": "subtitle", "time": 6580.629, "timestamp": "01:49:40", "text": "まあ、そんな感じですね。ただ"}, {"type": "subtitle", "time": 6582.95, "timestamp": "01:49:42", "text": "滑り降りる"}, {"type": "subtitle", "time": 6585.99, "timestamp": "01:49:45", "text": "ますます深くその問題にのめり込んでいく。"}, {"type": "subtitle", "time": 6588.87, "timestamp": "01:49:48", "text": "本当に、"}, {"type": "subtitle", "time": 6590.229, "timestamp": "01:49:50", "text": "胃。"}, {"type": "subtitle", "time": 6596.39, "timestamp": "01:49:56", "text": "人生には通用しないのかもしれない。のように"}, {"type": "subtitle", "time": 6597.91, "timestamp": "01:49:57", "text": "彼女は「もしかしたらうまくいかないかも」って感じで"}]
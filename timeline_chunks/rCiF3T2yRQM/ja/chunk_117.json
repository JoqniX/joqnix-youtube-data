[{"type": "subtitle", "time": 7024.95, "timestamp": "01:57:04", "text": "我々はまだ有利な立場にいる。"}, {"type": "subtitle", "time": 7027.109, "timestamp": "01:57:07", "text": "あのね、知ってる？そのため、"}, {"type": "subtitle", "time": 7029.189, "timestamp": "01:57:09", "text": "肉の部屋へ行きなさい。"}, {"type": "subtitle", "time": 7030.149, "timestamp": "01:57:10", "text": "わかった。"}, {"type": "subtitle", "time": 7032.07, "timestamp": "01:57:12", "text": "わーい。肉の部屋。"}, {"type": "subtitle", "time": 7033.109, "timestamp": "01:57:13", "text": "肉体室をやってください。"}, {"type": "subtitle", "time": 7035.51, "timestamp": "01:57:15", "text": "私は肉体の部屋が好きではないが、"}, {"type": "subtitle", "time": 7038.31, "timestamp": "01:57:18", "text": "肉体を通り抜けた方がましだ"}, {"type": "subtitle", "time": 7041.51, "timestamp": "01:57:21", "text": "部屋に戻るよりも、"}, {"type": "subtitle", "time": 7045.189, "timestamp": "01:57:25", "text": "蘇生した可能性のある生物を見る"}, {"type": "subtitle", "time": 7048.07, "timestamp": "01:57:28", "text": "我々が弱っている時に攻撃を仕掛けてくる。"}, {"type": "subtitle", "time": 7051.109, "timestamp": "01:57:31", "text": "ただ気になっただけです。私は、私は願っています"}, {"type": "subtitle", "time": 7053.109, "timestamp": "01:57:33", "text": "何か、いや、いや、いや、いや、いや。私は違います"}, {"type": "subtitle", "time": 7054.709, "timestamp": "01:57:34", "text": "行く"}, {"type": "subtitle", "time": 7056.629, "timestamp": "01:57:36", "text": "何かが起こったことを願う。わかった。全て"}, {"type": "subtitle", "time": 7058.31, "timestamp": "01:57:38", "text": "右。必ずそうします"}, {"type": "subtitle", "time": 7059.75, "timestamp": "01:57:39", "text": "必ずそうします。"}, {"type": "subtitle", "time": 7061.27, "timestamp": "01:57:41", "text": "よし。一歩踏み出そう"}, {"type": "subtitle", "time": 7062.629, "timestamp": "01:57:42", "text": "入る。彼女は"}, {"type": "subtitle", "time": 7064.47, "timestamp": "01:57:44", "text": "私はそのパーティーで常識的な役割を担っていたわけではなかった。"}, {"type": "subtitle", "time": 7066.229, "timestamp": "01:57:46", "text": "もし私が党の常識人ではなかったら、"}, {"type": "subtitle", "time": 7068.629, "timestamp": "01:57:48", "text": "俺は絶対にやるよ。"}, {"type": "subtitle", "time": 7070.149, "timestamp": "01:57:50", "text": "私はそれを公開する。幸いなことに、"}, {"type": "subtitle", "time": 7073.189, "timestamp": "01:57:53", "text": "私はそのパーティーで、常識的な役割を担っていた。"}, {"type": "subtitle", "time": 7074.47, "timestamp": "01:57:54", "text": "肉。"}, {"type": "subtitle", "time": 7077.51, "timestamp": "01:57:57", "text": "ドロドロしている。ドロドロしている。そして、ご存知のとおり"}]
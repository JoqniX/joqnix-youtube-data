[{"type": "subtitle", "time": 1624.87, "timestamp": "00:27:04", "text": "選ぶ"}, {"type": "subtitle", "time": 1626.31, "timestamp": "00:27:06", "text": "それはあなたへの贈り物です。"}, {"type": "subtitle", "time": 1628.31, "timestamp": "00:27:08", "text": "あなただけのために。ティックは君のことをとても愛しているよ。"}, {"type": "subtitle", "time": 1633.35, "timestamp": "00:27:13", "text": "ああ、くそ。ああ、私の鳥は太りすぎだ。"}, {"type": "subtitle", "time": 1635.75, "timestamp": "00:27:15", "text": "あなたの鳥を何とか詰め込みますよ。はい、どうぞ。"}, {"type": "subtitle", "time": 1638.39, "timestamp": "00:27:18", "text": "ありがとう。"}, {"type": "subtitle", "time": 1639.59, "timestamp": "00:27:19", "text": "わかった、"}, {"type": "subtitle", "time": 1642.63, "timestamp": "00:27:22", "text": "クルーへの歓迎に戻ります。あなたはできる"}, {"type": "subtitle", "time": 1646.149, "timestamp": "00:27:26", "text": "あなたは私たちと共に戦い、魔法を使うことができる。"}, {"type": "subtitle", "time": 1649.51, "timestamp": "00:27:29", "text": "ええ、そう願っています。まあ、おそらく"}, {"type": "subtitle", "time": 1657.75, "timestamp": "00:27:37", "text": "他の人々へ。"}, {"type": "subtitle", "time": 1660.23, "timestamp": "00:27:40", "text": "とても良い。"}, {"type": "subtitle", "time": 1661.669, "timestamp": "00:27:41", "text": "それは彼らがそうではないことを暗示するだろう"}, {"type": "subtitle", "time": 1667.269, "timestamp": "00:27:47", "text": "はい、わかりました。君たちは"}, {"type": "subtitle", "time": 1669.99, "timestamp": "00:27:49", "text": "すぐに行ってください。事前準備は何かありますか？"}, {"type": "subtitle", "time": 1673.11, "timestamp": "00:27:53", "text": "あなたがやりたいことは何ですか？えっと、"}, {"type": "subtitle", "time": 1676.389, "timestamp": "00:27:56", "text": "私はただ、アリエルは"}, {"type": "subtitle", "time": 1678.789, "timestamp": "00:27:58", "text": "「ヴァン、私たちは"}]
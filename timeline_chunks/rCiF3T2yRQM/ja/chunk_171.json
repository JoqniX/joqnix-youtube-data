[{"type": "subtitle", "time": 10261.99, "timestamp": "02:51:01", "text": "スライムに対処してみることもできる"}, {"type": "subtitle", "time": 10264.23, "timestamp": "02:51:04", "text": "まず、たぶん。"}, {"type": "subtitle", "time": 10268.469, "timestamp": "02:51:08", "text": "ちょっと待って。では、私たちは"}, {"type": "subtitle", "time": 10271.59, "timestamp": "02:51:11", "text": "鳥が先か"}, {"type": "subtitle", "time": 10275.03, "timestamp": "02:51:15", "text": "わかった。"}, {"type": "subtitle", "time": 10276.95, "timestamp": "02:51:16", "text": "待って、私たちは彼らの注意を引いて"}, {"type": "subtitle", "time": 10278.71, "timestamp": "02:51:18", "text": "それから月の光を動かします。そこで彼らは始める"}, {"type": "subtitle", "time": 10281.91, "timestamp": "02:51:21", "text": "月の光の中を歩く。"}, {"type": "subtitle", "time": 10284.07, "timestamp": "02:51:24", "text": "わかった。負傷者の半分くらいだったと言っておこう"}, {"type": "subtitle", "time": 10289.59, "timestamp": "02:51:29", "text": "我々には彼らのものを手に入れる方法がある"}, {"type": "subtitle", "time": 10291.03, "timestamp": "02:51:31", "text": "ちなみに、注意点があります。私たちには方法があります"}, {"type": "subtitle", "time": 10292.95, "timestamp": "02:51:32", "text": "彼らの注意を引くため。"}, {"type": "subtitle", "time": 10295.91, "timestamp": "02:51:35", "text": "つまり、ためらうこともできます"}, {"type": "subtitle", "time": 10298.15, "timestamp": "02:51:38", "text": "なぜなら、私は実際にドラオニックが泣くのを見たことがあるから"}, {"type": "subtitle", "time": 10305.19, "timestamp": "02:51:45", "text": "フィナさん、ようこそ。そして彼らは、"}, {"type": "subtitle", "time": 10314.389, "timestamp": "02:51:54", "text": "何てことだ。ラカナが泣く"}, {"type": "subtitle", "time": 10316.23, "timestamp": "02:51:56", "text": "ボーナス攻撃"}, {"type": "subtitle", "time": 10318.389, "timestamp": "02:51:58", "text": "10フィート以内の敵に向かって"}]
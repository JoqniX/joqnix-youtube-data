[{"type": "subtitle", "time": 6722.149, "timestamp": "01:52:02", "text": "今ではその数が増えている。そしてそれは"}, {"type": "subtitle", "time": 6724.95, "timestamp": "01:52:04", "text": "ここから滑り落ちていく"}, {"type": "subtitle", "time": 6726.709, "timestamp": "01:52:06", "text": "筋肉組織の中に"}, {"type": "subtitle", "time": 6728.07, "timestamp": "01:52:08", "text": "ここに穴が開いている。"}, {"type": "subtitle", "time": 6730.149, "timestamp": "01:52:10", "text": "まあ。"}, {"type": "subtitle", "time": 6732.39, "timestamp": "01:52:12", "text": "まあ、少なくともそれが本当に"}, {"type": "subtitle", "time": 6738.47, "timestamp": "01:52:18", "text": "これらすべてを行った結果、"}, {"type": "subtitle", "time": 6739.75, "timestamp": "01:52:19", "text": "肉。"}, {"type": "subtitle", "time": 6747.669, "timestamp": "01:52:27", "text": "[音楽]"}, {"type": "subtitle", "time": 6748.55, "timestamp": "01:52:28", "text": "良い、"}, {"type": "subtitle", "time": 6750.39, "timestamp": "01:52:30", "text": "まあ、私たちは"}, {"type": "subtitle", "time": 6752.07, "timestamp": "01:52:32", "text": "探索する以外に選択肢はほとんどない"}, {"type": "subtitle", "time": 6754.31, "timestamp": "01:52:34", "text": "別の方法。"}, {"type": "subtitle", "time": 6756.87, "timestamp": "01:52:36", "text": "しかし、ちなみに、別の部屋では、"}, {"type": "subtitle", "time": 6760.55, "timestamp": "01:52:40", "text": "ええと、部屋は"}, {"type": "subtitle", "time": 6762.149, "timestamp": "01:52:42", "text": "あれは何て言うんだ？"}, {"type": "subtitle", "time": 6764.47, "timestamp": "01:52:44", "text": "それは左右対称ではなかった。私はしません"}, {"type": "subtitle", "time": 6767.669, "timestamp": "01:52:47", "text": "ええ、壁は壁ではなく、"}, {"type": "subtitle", "time": 6770.229, "timestamp": "01:52:50", "text": "一致していません。"}, {"type": "subtitle", "time": 6771.03, "timestamp": "01:52:51", "text": "H"}, {"type": "subtitle", "time": 6773.43, "timestamp": "01:52:53", "text": "皆さんは試してみたいですか？"}, {"type": "subtitle", "time": 6775.27, "timestamp": "01:52:55", "text": "そこに何かまだあるのか、それとも私たちは"}, {"type": "subtitle", "time": 6776.79, "timestamp": "01:52:56", "text": "行く"}, {"type": "subtitle", "time": 6778.47, "timestamp": "01:52:58", "text": "のように？うん。いいえ、私はしません、私はしません"}]
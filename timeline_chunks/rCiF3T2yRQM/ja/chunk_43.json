[{"type": "subtitle", "time": 2585.19, "timestamp": "00:43:05", "text": "あなたは恐らくそんなことはしないでしょう。彼らは"}, {"type": "subtitle", "time": 2588.87, "timestamp": "00:43:08", "text": "起きた時、すごく機嫌が悪い。"}, {"type": "subtitle", "time": 2591.03, "timestamp": "00:43:11", "text": "大丈夫。彼らはピックを気に入るだろう。ピックは大好き"}, {"type": "subtitle", "time": 2594.63, "timestamp": "00:43:14", "text": "すでに彼らに。奇妙な"}, {"type": "subtitle", "time": 2598.47, "timestamp": "00:43:18", "text": "君たちがここで見つけた生き物。"}, {"type": "subtitle", "time": 2600.87, "timestamp": "00:43:20", "text": "彼は私の新しい友達です。"}, {"type": "subtitle", "time": 2603.349, "timestamp": "00:43:23", "text": "私たちはもう家族です。私たち全員。"}, {"type": "subtitle", "time": 2607.19, "timestamp": "00:43:27", "text": "それは良かったです。私は推測する"}, {"type": "subtitle", "time": 2609.349, "timestamp": "00:43:29", "text": "あのね？時には友達が"}, {"type": "subtitle", "time": 2618.95, "timestamp": "00:43:38", "text": "小さなチクチク音。"}, {"type": "subtitle", "time": 2620.309, "timestamp": "00:43:40", "text": "それは良いことか悪いことか"}, {"type": "subtitle", "time": 2625.03, "timestamp": "00:43:45", "text": "もの。あなたは優しい人です。えっと、私は"}, {"type": "subtitle", "time": 2627.43, "timestamp": "00:43:47", "text": "本当に気に入ってるんだけど、まあ、"}, {"type": "subtitle", "time": 2630.95, "timestamp": "00:43:50", "text": "それは受け入れられます。えーっと、とにかく、"}, {"type": "subtitle", "time": 2632.15, "timestamp": "00:43:52", "text": "君たち"}, {"type": "subtitle", "time": 2634.79, "timestamp": "00:43:54", "text": "きっと好きになるよ。"}, {"type": "subtitle", "time": 2637.91, "timestamp": "00:43:57", "text": "わかった。私は。彼女はただ"}]
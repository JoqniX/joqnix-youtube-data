[{"type": "subtitle", "time": 1380.149, "timestamp": "00:23:00", "text": "君たちはどこにいるの？あなたには私たちが見えません"}, {"type": "subtitle", "time": 1382.07, "timestamp": "00:23:02", "text": "私たちが今いる場所。白黒ですが、"}, {"type": "subtitle", "time": 1384.63, "timestamp": "00:23:04", "text": "地図には何も表示されていません。"}, {"type": "subtitle", "time": 1392.39, "timestamp": "00:23:12", "text": "そうそう。お見せしましょう。お見せしましょう"}, {"type": "subtitle", "time": 1394.71, "timestamp": "00:23:14", "text": "まさに私が思う通り"}, {"type": "subtitle", "time": 1397.11, "timestamp": "00:23:17", "text": "トークン。一般的なチャットでも、"}, {"type": "subtitle", "time": 1397.59, "timestamp": "00:23:17", "text": "見る。"}, {"type": "subtitle", "time": 1400.47, "timestamp": "00:23:20", "text": "私はジョックを盲目にすることはできるが、ジョーには見える。"}, {"type": "subtitle", "time": 1400.71, "timestamp": "00:23:20", "text": "私は"}, {"type": "subtitle", "time": 1404.549, "timestamp": "00:23:24", "text": "盲人が見える。"}, {"type": "subtitle", "time": 1405.669, "timestamp": "00:23:25", "text": "うん。"}, {"type": "subtitle", "time": 1408.23, "timestamp": "00:23:28", "text": "暗闇の中で私たちが見るのは"}, {"type": "subtitle", "time": 1409.75, "timestamp": "00:23:29", "text": "暗闇の中で。"}, {"type": "subtitle", "time": 1410.95, "timestamp": "00:23:30", "text": "何もない。"}, {"type": "subtitle", "time": 1412.47, "timestamp": "00:23:32", "text": "何てことだ。"}, {"type": "subtitle", "time": 1414.95, "timestamp": "00:23:34", "text": "私も実際にそう感じました。それは"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "また、私が失明したときに感じたことは、"}, {"type": "subtitle", "time": 1422.549, "timestamp": "00:23:42", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 1425.909, "timestamp": "00:23:45", "text": "右。わかった。あの、グリム、大丈夫？"}, {"type": "subtitle", "time": 1427.43, "timestamp": "00:23:47", "text": "例えば、もし"}, {"type": "subtitle", "time": 1429.43, "timestamp": "00:23:49", "text": "まだトーチに繋がれたまま、私は"}, {"type": "subtitle", "time": 1430.549, "timestamp": "00:23:50", "text": "間違いない。"}, {"type": "subtitle", "time": 1430.95, "timestamp": "00:23:50", "text": "えっと"}, {"type": "subtitle", "time": 1433.19, "timestamp": "00:23:53", "text": "リフレッシュしてみてください。試してみましたか？"}, {"type": "subtitle", "time": 1433.75, "timestamp": "00:23:53", "text": "爽やか？"}, {"type": "subtitle", "time": 1436.47, "timestamp": "00:23:56", "text": "技術的な問題が発生しました。"}, {"type": "subtitle", "time": 1437.75, "timestamp": "00:23:57", "text": "私が見ているのは、あなたですか？"}]
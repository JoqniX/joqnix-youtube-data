[{"type": "subtitle", "time": 1083.029, "timestamp": "00:18:03", "text": "私たちが以前見つけた階段。私"}, {"type": "subtitle", "time": 1085.11, "timestamp": "00:18:05", "text": "そこまで彼らについていくことはできなかった。"}, {"type": "subtitle", "time": 1086.95, "timestamp": "00:18:06", "text": "うん。"}, {"type": "subtitle", "time": 1089.029, "timestamp": "00:18:09", "text": "ああ、わかりました。まあ、私たちはそういう状況です"}, {"type": "subtitle", "time": 1091.909, "timestamp": "00:18:11", "text": "行くよ。地下牢へ急いで降りろ。"}, {"type": "subtitle", "time": 1094.15, "timestamp": "00:18:14", "text": "行進を始めよう"}, {"type": "subtitle", "time": 1095.99, "timestamp": "00:18:15", "text": "前進する。"}, {"type": "subtitle", "time": 1097.909, "timestamp": "00:18:17", "text": "地下牢へ降りていくしかないみたいだ。"}, {"type": "subtitle", "time": 1098.63, "timestamp": "00:18:18", "text": "地下牢へ。"}, {"type": "subtitle", "time": 1099.909, "timestamp": "00:18:19", "text": "さあ行こう。"}, {"type": "subtitle", "time": 1102.39, "timestamp": "00:18:22", "text": "うん。うん。わかった。よし。わかった。また、"}, {"type": "subtitle", "time": 1104.15, "timestamp": "00:18:24", "text": "ところで、その前にちょっと"}, {"type": "subtitle", "time": 1106.71, "timestamp": "00:18:26", "text": "進む。私は皆さん全員に、"}, {"type": "subtitle", "time": 1108.87, "timestamp": "00:18:28", "text": "目隠しをしてロールしてください。つまり、できない"}, {"type": "subtitle", "time": 1110.71, "timestamp": "00:18:30", "text": "君にも見えるけど、僕にも見えるよ。いいねをください"}, {"type": "subtitle", "time": 1113.43, "timestamp": "00:18:33", "text": "3d 100。これがあなたのシードになります。"}, {"type": "subtitle", "time": 1116.15, "timestamp": "00:18:36", "text": "私は3D 100のような状態です。"}, {"type": "subtitle", "time": 1117.43, "timestamp": "00:18:37", "text": "うん、3D 100点。"}, {"type": "subtitle", "time": 1118.71, "timestamp": "00:18:38", "text": "GMによるブラインドロール。"}, {"type": "subtitle", "time": 1120.87, "timestamp": "00:18:40", "text": "ええ、GMによるブラインドロールです。覚えて？わかった。私"}, {"type": "subtitle", "time": 1122.95, "timestamp": "00:18:42", "text": "おそらく"}, {"type": "subtitle", "time": 1124.63, "timestamp": "00:18:44", "text": "ありがとう。"}, {"type": "subtitle", "time": 1127.27, "timestamp": "00:18:47", "text": "わかった。うん。ええと、100。"}, {"type": "subtitle", "time": 1131.75, "timestamp": "00:18:51", "text": "うん、1対100。3Dで100にしよう。うん。"}, {"type": "subtitle", "time": 1134.31, "timestamp": "00:18:54", "text": "私のペンは一体どこへ行ったんだ？"}, {"type": "subtitle", "time": 1135.59, "timestamp": "00:18:55", "text": "ペンを壊してしまった。"}, {"type": "subtitle", "time": 1137.27, "timestamp": "00:18:57", "text": "えっと、ペンが行きます。冗談です。"}, {"type": "subtitle", "time": 1139.27, "timestamp": "00:18:59", "text": "ちなみに、そうでない他の人たちのために"}]
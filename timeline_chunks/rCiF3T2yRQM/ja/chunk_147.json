[{"type": "subtitle", "time": 8826.87, "timestamp": "02:27:06", "text": "その輝きは吐き気を催すほどだ。"}, {"type": "subtitle", "time": 8830.71, "timestamp": "02:27:10", "text": "これは嘔吐物みたいだ。"}, {"type": "subtitle", "time": 8833.429, "timestamp": "02:27:13", "text": "よし、ダメージロールをしよう。ああ、クリックすればいいんだね"}, {"type": "subtitle", "time": 8835.03, "timestamp": "02:27:15", "text": "まず、17 を使用するので"}, {"type": "subtitle", "time": 8836.79, "timestamp": "02:27:16", "text": "それは既に響いている。"}, {"type": "subtitle", "time": 8838.79, "timestamp": "02:27:18", "text": "魔法のロングでダメージをロールする"}, {"type": "subtitle", "time": 8841.59, "timestamp": "02:27:21", "text": "剣。わかった。よし。なぜまだ"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "切り裂く？こうするつもりです"}, {"type": "subtitle", "time": 8845.03, "timestamp": "02:27:25", "text": "輝いている。よし、それを作ってみよう"}, {"type": "subtitle", "time": 8848.71, "timestamp": "02:27:28", "text": "輝いている。よし、青だ。はい、"}, {"type": "subtitle", "time": 8853.349, "timestamp": "02:27:33", "text": "えっと、そんなにダメージを与えるんですか。そして"}, {"type": "subtitle", "time": 8855.429, "timestamp": "02:27:35", "text": "えーと、そうすると、たとえ"}, {"type": "subtitle", "time": 8858.07, "timestamp": "02:27:38", "text": "輝いている、ええと、あなたは損傷を受けています"}, {"type": "subtitle", "time": 8861.91, "timestamp": "02:27:41", "text": "かなりそうだと思う。"}, {"type": "subtitle", "time": 8864.71, "timestamp": "02:27:44", "text": "えっと、これを始めよう"}, {"type": "subtitle", "time": 8868.309, "timestamp": "02:27:48", "text": "ブープしてから、これをしてください。それはそうする"}, {"type": "subtitle", "time": 8875.27, "timestamp": "02:27:55", "text": "私たちは持っていなくてよかったと感謝しています"}, {"type": "subtitle", "time": 8877.59, "timestamp": "02:27:57", "text": "相手側のためにこれを経験する"}, {"type": "subtitle", "time": 8879.67, "timestamp": "02:27:59", "text": "なぜなら私は具体的には"}]
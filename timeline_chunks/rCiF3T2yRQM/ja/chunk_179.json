[{"type": "subtitle", "time": 10742.309, "timestamp": "02:59:02", "text": "青。よし。わかった。えっと、そうですね。"}, {"type": "subtitle", "time": 10745.349, "timestamp": "02:59:05", "text": "ダメージロール。"}, {"type": "subtitle", "time": 10747.03, "timestamp": "02:59:07", "text": "ああ、なんてこった。"}, {"type": "subtitle", "time": 10748.95, "timestamp": "02:59:08", "text": "クリステンがそこにいます。今気づいたんだけど、転がっちゃった"}, {"type": "subtitle", "time": 10751.349, "timestamp": "02:59:11", "text": "クリスペン。持続する。ちょっと待ってください。私はただ"}, {"type": "subtitle", "time": 10754.389, "timestamp": "02:59:14", "text": "クリスティンを鳴らしてください。だから、すべての人に当てはまる"}, {"type": "subtitle", "time": 10758.63, "timestamp": "02:59:18", "text": "でも俺はたった今2人を倒した"}, {"type": "subtitle", "time": 10761.55, "timestamp": "02:59:21", "text": "例えば、くそ。"}, {"type": "subtitle", "time": 10764.15, "timestamp": "02:59:24", "text": "[音楽]"}, {"type": "subtitle", "time": 10766.79, "timestamp": "02:59:26", "text": "私は二度とウォーロックをプレイしない"}, {"type": "subtitle", "time": 10767.91, "timestamp": "02:59:27", "text": "この試合の後。"}, {"type": "subtitle", "time": 10769.67, "timestamp": "02:59:29", "text": "教訓を得た。"}, {"type": "subtitle", "time": 10771.75, "timestamp": "02:59:31", "text": "誓って、ウォーロックヒーラーになる"}, {"type": "subtitle", "time": 10773.91, "timestamp": "02:59:33", "text": "方法。"}, {"type": "subtitle", "time": 10776.389, "timestamp": "02:59:36", "text": "戦士か野蛮人か。"}, {"type": "subtitle", "time": 10778.07, "timestamp": "02:59:38", "text": "マーバリアンはなかなか面白い。"}, {"type": "subtitle", "time": 10780.23, "timestamp": "02:59:40", "text": "ソーロック。"}, {"type": "subtitle", "time": 10782.63, "timestamp": "02:59:42", "text": "スイッチロックの時間だ。うん。"}, {"type": "subtitle", "time": 10784.71, "timestamp": "02:59:44", "text": "あのね？ねえ、クリスピン？"}, {"type": "subtitle", "time": 10787.91, "timestamp": "02:59:47", "text": "君がするようにしよう"}, {"type": "subtitle", "time": 10789.62, "timestamp": "02:59:49", "text": "あなたが死ぬまで。"}, {"type": "subtitle", "time": 10791.83, "timestamp": "02:59:51", "text": "[音楽]"}, {"type": "subtitle", "time": 10794.79, "timestamp": "02:59:54", "text": "両手を失った。"}, {"type": "subtitle", "time": 10796.87, "timestamp": "02:59:56", "text": "わかった。"}, {"type": "subtitle", "time": 10798.55, "timestamp": "02:59:58", "text": "よし。"}]
[{"type": "subtitle", "time": 11040.79, "timestamp": "03:04:00", "text": "実際には本当に死ぬわけではない。彼は"}, {"type": "subtitle", "time": 11041.99, "timestamp": "03:04:01", "text": "おなじみ。心配しないで。"}, {"type": "subtitle", "time": 11044.469, "timestamp": "03:04:04", "text": "ああ、彼を取り戻せるよ。"}, {"type": "subtitle", "time": 11046.23, "timestamp": "03:04:06", "text": "つまり、こちらに引っ越してきたら、"}, {"type": "subtitle", "time": 11048.23, "timestamp": "03:04:08", "text": "実際にはクリスには当たらない。"}, {"type": "subtitle", "time": 11048.71, "timestamp": "03:04:08", "text": "どこ？"}, {"type": "subtitle", "time": 11052.309, "timestamp": "03:04:12", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 11054.469, "timestamp": "03:04:14", "text": "まさにそこです。"}, {"type": "subtitle", "time": 11056.309, "timestamp": "03:04:16", "text": "月の光。待って、できる？ それは？ それは"}, {"type": "subtitle", "time": 11058.63, "timestamp": "03:04:18", "text": "見えないようにしますか？それともここに置きますか？もし"}, {"type": "subtitle", "time": 11061.99, "timestamp": "03:04:21", "text": "ここにあります。ええ、安全ですよ。"}, {"type": "subtitle", "time": 11062.309, "timestamp": "03:04:22", "text": "えっと"}, {"type": "subtitle", "time": 11064.95, "timestamp": "03:04:24", "text": "何てことだ。クリスマスはもう一日続く。"}, {"type": "subtitle", "time": 11067.269, "timestamp": "03:04:27", "text": "明日も生き延びる。ああ、そうかい。転がす"}, {"type": "subtitle", "time": 11069.03, "timestamp": "03:04:29", "text": "月光によるダメージをロールします。"}, {"type": "subtitle", "time": 11071.51, "timestamp": "03:04:31", "text": "ヴァンは"}, {"type": "subtitle", "time": 11073.349, "timestamp": "03:04:33", "text": "この見た目の人物について、本当にそう思っている。"}, {"type": "subtitle", "time": 11075.59, "timestamp": "03:04:35", "text": "彼を死なせてしまえばいい。"}, {"type": "subtitle", "time": 11083.75, "timestamp": "03:04:43", "text": "クリスピングはちゃんと役割を果たしている。"}, {"type": "subtitle", "time": 11087.51, "timestamp": "03:04:47", "text": "彼がすべきことはそれだけだ。"}, {"type": "subtitle", "time": 11090.79, "timestamp": "03:04:50", "text": "わかった。もう一度ロール、えっと、何て呼ぶんだっけ。ロール"}]
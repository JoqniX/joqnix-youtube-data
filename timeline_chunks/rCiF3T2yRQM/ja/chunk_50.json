[{"type": "subtitle", "time": 3002.549, "timestamp": "00:50:02", "text": "ありがとう、ちびっ子。それでは、さようなら。"}, {"type": "subtitle", "time": 3009.349, "timestamp": "00:50:09", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 3011.27, "timestamp": "00:50:11", "text": "ドアに鍵をかけた。"}, {"type": "subtitle", "time": 3013.75, "timestamp": "00:50:13", "text": "彼はひどく気まぐれだった。"}, {"type": "subtitle", "time": 3014.309, "timestamp": "00:50:14", "text": "うん。"}, {"type": "subtitle", "time": 3016.15, "timestamp": "00:50:16", "text": "良い、"}, {"type": "subtitle", "time": 3019.19, "timestamp": "00:50:19", "text": "ヴァンは好きでなければならなかったから好きだった"}, {"type": "subtitle", "time": 3021.27, "timestamp": "00:50:21", "text": "彼らの党の活動を見る"}, {"type": "subtitle", "time": 3023.99, "timestamp": "00:50:23", "text": "クソみたいな魔女の場所で、ほら、わかるでしょ"}, {"type": "subtitle", "time": 3027.43, "timestamp": "00:50:27", "text": "何？その理由はおそらく理解できる。彼らはそうする"}, {"type": "subtitle", "time": 3030.79, "timestamp": "00:50:30", "text": "とてもいたずら好きなパーティーをしたいのですが"}, {"type": "subtitle", "time": 3033.19, "timestamp": "00:50:33", "text": "言う。ディックは彼女が正しいと思っている"}, {"type": "subtitle", "time": 3043.67, "timestamp": "00:50:43", "text": "素晴らしい記憶力ですね。チクッ。ああ、そうだね。"}, {"type": "subtitle", "time": 3045.43, "timestamp": "00:50:45", "text": "それは間違いなく別の死んだスライムだ。"}, {"type": "subtitle", "time": 3048.069, "timestamp": "00:50:48", "text": "はぁ？"}, {"type": "subtitle", "time": 3051.109, "timestamp": "00:50:51", "text": "またしても死んだスライムだ。"}, {"type": "subtitle", "time": 3053.99, "timestamp": "00:50:53", "text": "乗り越える。"}, {"type": "subtitle", "time": 3058.15, "timestamp": "00:50:58", "text": "おい、スライムを食べるのはやめろよ。ああ神様、"}]
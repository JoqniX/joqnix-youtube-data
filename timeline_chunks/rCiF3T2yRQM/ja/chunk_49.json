[{"type": "subtitle", "time": 2943.75, "timestamp": "00:49:03", "text": "まあ、いいでしょう。えっと、頭を撫でて"}, {"type": "subtitle", "time": 2945.27, "timestamp": "00:49:05", "text": "ぎこちなく。"}, {"type": "subtitle", "time": 2947.99, "timestamp": "00:49:07", "text": "では、皆さんは続けてください"}, {"type": "subtitle", "time": 2950.309, "timestamp": "00:49:10", "text": "あなたの冒険？"}, {"type": "subtitle", "time": 2957.27, "timestamp": "00:49:17", "text": "君たちはなんて奇妙な生き物なんだ"}, {"type": "subtitle", "time": 2957.99, "timestamp": "00:49:17", "text": "持っている。まあ、そうですね。"}, {"type": "subtitle", "time": 2959.99, "timestamp": "00:49:19", "text": "わかった。さて、皆さんはどこに行きたいですか？"}, {"type": "subtitle", "time": 2962.15, "timestamp": "00:49:22", "text": "また会えるのはいつになるか"}, {"type": "subtitle", "time": 2963.589, "timestamp": "00:49:23", "text": "これで終わり？"}, {"type": "subtitle", "time": 2967.03, "timestamp": "00:49:27", "text": "ええと、もしかしたら、私たちは試してみます"}, {"type": "subtitle", "time": 2969.03, "timestamp": "00:49:29", "text": "あなたを見つける。兆候が見つかる"}, {"type": "subtitle", "time": 2970.87, "timestamp": "00:49:30", "text": "外出の準備ができたら。いつ"}, {"type": "subtitle", "time": 2972.71, "timestamp": "00:49:32", "text": "みんな休んだから、"}, {"type": "subtitle", "time": 2974.39, "timestamp": "00:49:34", "text": "あなた。"}, {"type": "subtitle", "time": 2975.27, "timestamp": "00:49:35", "text": "くすぐる。"}, {"type": "subtitle", "time": 2977.91, "timestamp": "00:49:37", "text": "いいですね。これ以上"}, {"type": "subtitle", "time": 2989.51, "timestamp": "00:49:49", "text": "とにかく、君たちはもう帰ってもいいかな？私"}, {"type": "subtitle", "time": 2993.91, "timestamp": "00:49:53", "text": "まだ美容のために睡眠が必要だ。"}, {"type": "subtitle", "time": 2995.43, "timestamp": "00:49:55", "text": "これ以上美しくなることはないと思う。"}, {"type": "subtitle", "time": 2996.87, "timestamp": "00:49:56", "text": "でも、ゆっくり休んでください。"}, {"type": "subtitle", "time": 2998.15, "timestamp": "00:49:58", "text": "おやすみ。"}]
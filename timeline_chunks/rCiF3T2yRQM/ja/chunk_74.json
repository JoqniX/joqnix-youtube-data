[{"type": "subtitle", "time": 4440.39, "timestamp": "01:14:00", "text": "あなたはそういう傾向があると言えるでしょう。例えば"}, {"type": "subtitle", "time": 4442.709, "timestamp": "01:14:02", "text": "うん。あなたをうつ伏せにさせます。"}, {"type": "subtitle", "time": 4444.149, "timestamp": "01:14:04", "text": "そうねぇ。どこですか？王位。そこには"}, {"type": "subtitle", "time": 4445.83, "timestamp": "01:14:05", "text": "あなたが行く。あなたは地面に倒れ、"}, {"type": "subtitle", "time": 4448.709, "timestamp": "01:14:08", "text": "地面が粘着質であることに気づいてください。全て"}, {"type": "subtitle", "time": 4450.07, "timestamp": "01:14:10", "text": "右。君を転がしてやる"}, {"type": "subtitle", "time": 4451.99, "timestamp": "01:14:11", "text": "ここから主導権を握ろう。"}, {"type": "subtitle", "time": 4455.91, "timestamp": "01:14:15", "text": "うーん、ちょっと行き詰まっているかもしれません。"}, {"type": "subtitle", "time": 4458.709, "timestamp": "01:14:18", "text": "なんとも厄介な状況だ。"}, {"type": "subtitle", "time": 4459.91, "timestamp": "01:14:19", "text": "私"}, {"type": "subtitle", "time": 4466.87, "timestamp": "01:14:26", "text": "シャット"}, {"type": "subtitle", "time": 4468.95, "timestamp": "01:14:28", "text": "今はあなたの話を聞きたくない。"}, {"type": "subtitle", "time": 4470.95, "timestamp": "01:14:30", "text": "何てことだ。これはあなたのエルドリッチです"}, {"type": "subtitle", "time": 4471.59, "timestamp": "01:14:31", "text": "パトロン。"}, {"type": "subtitle", "time": 4474.07, "timestamp": "01:14:34", "text": "ええ、私のエルドリッチ・パトロンがまさにそれを作ってくれるんです"}, {"type": "subtitle", "time": 4477.669, "timestamp": "01:14:37", "text": "「黙ってて。誰も聞いてないよ」って感じだった。"}, {"type": "subtitle", "time": 4479.99, "timestamp": "01:14:39", "text": "何てことだ。"}, {"type": "subtitle", "time": 4484.39, "timestamp": "01:14:44", "text": "わかった。よし。はい、どうぞ。ああ、わかった。"}, {"type": "subtitle", "time": 4486.31, "timestamp": "01:14:46", "text": "ええと、スポーツマンのルールですね。もう一度確認させてください"}, {"type": "subtitle", "time": 4488.63, "timestamp": "01:14:48", "text": "それ。うん。わかった。ジョック。クリックロール"}, {"type": "subtitle", "time": 4489.51, "timestamp": "01:14:49", "text": "主導権。"}, {"type": "subtitle", "time": 4491.75, "timestamp": "01:14:51", "text": "y"}, {"type": "subtitle", "time": 4492.79, "timestamp": "01:14:52", "text": "なんてこった。さぁ行こう。"}, {"type": "subtitle", "time": 4494.79, "timestamp": "01:14:54", "text": "ちなみに、警告です。だから、私にはわからない。する"}, {"type": "subtitle", "time": 4498.39, "timestamp": "01:14:58", "text": "私のアラートは既にそのアラートに追加されていますか？"}]
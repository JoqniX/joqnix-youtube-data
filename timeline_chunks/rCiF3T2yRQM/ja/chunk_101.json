[{"type": "subtitle", "time": 6061.669, "timestamp": "01:41:01", "text": "この機能の詳細"}, {"type": "subtitle", "time": 6064.79, "timestamp": "01:41:04", "text": "もの。これはどうやら"}, {"type": "subtitle", "time": 6069.35, "timestamp": "01:41:09", "text": "物質をリサイクルする方法の一つとなる。もしあなたが"}, {"type": "subtitle", "time": 6070.87, "timestamp": "01:41:10", "text": "有機物を入れると"}, {"type": "subtitle", "time": 6074.229, "timestamp": "01:41:14", "text": "リサイクルして、より"}, {"type": "subtitle", "time": 6077.189, "timestamp": "01:41:17", "text": "役に立つ。彼らは彼ら自身だ。"}, {"type": "subtitle", "time": 6078.47, "timestamp": "01:41:18", "text": "彼らは間違いなく何らかの"}, {"type": "subtitle", "time": 6081.51, "timestamp": "01:41:21", "text": "研究者。彼らは作ろうとしている"}, {"type": "subtitle", "time": 6085.35, "timestamp": "01:41:25", "text": "問題を解決できるもの"}, {"type": "subtitle", "time": 6087.75, "timestamp": "01:41:27", "text": "飢餓の。"}, {"type": "subtitle", "time": 6090.95, "timestamp": "01:41:30", "text": "まさにその通りです。もしティックがこれを主導していたら"}, {"type": "subtitle", "time": 6092.47, "timestamp": "01:41:32", "text": "カルト、これらの死体、これらの"}, {"type": "subtitle", "time": 6094.629, "timestamp": "01:41:34", "text": "死体は釜の中にあるだろう。"}, {"type": "subtitle", "time": 6097.91, "timestamp": "01:41:37", "text": "ファンタジーのリサイクル。うん。削減、再利用、"}, {"type": "subtitle", "time": 6099.109, "timestamp": "01:41:39", "text": "蘇生させる。"}, {"type": "subtitle", "time": 6104.79, "timestamp": "01:41:44", "text": "マスターを見て"}, {"type": "subtitle", "time": 6106.55, "timestamp": "01:41:46", "text": "ほら、こう言うんだ、「試してみようと思う」"}, {"type": "subtitle", "time": 6107.91, "timestamp": "01:41:47", "text": "それ。そして彼女は投げようとするだろう"}, {"type": "subtitle", "time": 6109.59, "timestamp": "01:41:49", "text": "死体をこのようなものに変えます"}, {"type": "subtitle", "time": 6110.47, "timestamp": "01:41:50", "text": "ここに死体がある。"}, {"type": "subtitle", "time": 6110.95, "timestamp": "01:41:50", "text": "わかった。"}, {"type": "subtitle", "time": 6113.189, "timestamp": "01:41:53", "text": "黒いものの中へ。"}, {"type": "subtitle", "time": 6115.51, 
[{"type": "subtitle", "time": 1983.509, "timestamp": "00:33:03", "text": "私は小さいものをあまり信用していない"}, {"type": "subtitle", "time": 1986.389, "timestamp": "00:33:06", "text": "迷子になった子供たち"}, {"type": "subtitle", "time": 1988.95, "timestamp": "00:33:08", "text": "ダンジョンの中で。つまり、私たちは文字通り"}, {"type": "subtitle", "time": 1992.31, "timestamp": "00:33:12", "text": "地下牢で老婆たちと対峙しなければならなかった"}, {"type": "subtitle", "time": 1994.71, "timestamp": "00:33:14", "text": "前に。私は同じものを持っていません"}, {"type": "subtitle", "time": 1998.07, "timestamp": "00:33:18", "text": "ダンジョンにいる子供たちとしての質"}, {"type": "subtitle", "time": 1999.909, "timestamp": "00:33:19", "text": "良い。"}, {"type": "subtitle", "time": 2001.83, "timestamp": "00:33:21", "text": "年齢が古くなり、もはや"}, {"type": "subtitle", "time": 2004.23, "timestamp": "00:33:24", "text": "船によって子供と見なされた"}, {"type": "subtitle", "time": 2006.549, "timestamp": "00:33:26", "text": "船乗りみたいにね。"}, {"type": "subtitle", "time": 2009.509, "timestamp": "00:33:29", "text": "ああ、あなたはもう十分な年齢なんですね。"}, {"type": "subtitle", "time": 2011.509, "timestamp": "00:33:31", "text": "子供とはみなされない年齢。"}, {"type": "subtitle", "time": 2014.23, "timestamp": "00:33:34", "text": "デスクを持って旅行することはもうできません"}, {"type": "subtitle", "time": 2015.83, "timestamp": "00:33:35", "text": "船。彼らはそうしなければならない 彼らはそうしなければならない"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "私たちを引き離すように"}, {"type": "subtitle", "time": 2019.59, "timestamp": "00:33:39", "text": "いいね！"}, {"type": "subtitle", "time": 2021.99, "timestamp": "00:33:41", "text": "おお。"}, {"type": "subtitle", "time": 2023.669, "timestamp": "00:33:43", "text": "えっと、"}, {"type": "subtitle", "time": 2027.43, "timestamp": "00:33:47", "text": "ティック、君は何歳？ティックは"}, {"type": "subtitle", "time": 2028.95, "timestamp": "00:33:48", "text": "知る。"}, {"type": "subtitle", "time": 2030.71, "timestamp": "00:33:50", "text": "おお、"}, {"type": "subtitle", "time": 2033.19, "timestamp": "00:33:53", "text": "あのね？公平。私もあまり"}, {"type": "subtitle", "time": 2035.669, "timestamp": "00:33:55", "text": "私の年齢を覚えておいてください。"}, {"type": "subtitle", "time": 2037.75, "timestamp": "00:33:57", "text": "ティックは、時間には実際には"}]
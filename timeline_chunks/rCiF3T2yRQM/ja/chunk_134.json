[{"type": "subtitle", "time": 8040.149, "timestamp": "02:14:00", "text": "わかった。よし。"}, {"type": "subtitle", "time": 8042.149, "timestamp": "02:14:02", "text": "わかった。"}, {"type": "subtitle", "time": 8042.629, "timestamp": "02:14:02", "text": "刺す。"}, {"type": "subtitle", "time": 8044.79, "timestamp": "02:14:04", "text": "うん。うん。わかった。そうそう。心配しないで。"}, {"type": "subtitle", "time": 8046.709, "timestamp": "02:14:06", "text": "ダメージ計算は既に完了しています。わかった。"}, {"type": "subtitle", "time": 8049.51, "timestamp": "02:14:09", "text": "そうすると、"}, {"type": "subtitle", "time": 8053.35, "timestamp": "02:14:13", "text": "えっと、それを切ると、"}, {"type": "subtitle", "time": 8057.109, "timestamp": "02:14:17", "text": "実際にはあまり効果がないようです。これをやってください。"}, {"type": "subtitle", "time": 8058.39, "timestamp": "02:14:18", "text": "よし、これでいい。効果はありますか？うん、そうだね"}, {"type": "subtitle", "time": 8060.069, "timestamp": "02:14:20", "text": "小さくなって、"}, {"type": "subtitle", "time": 8063.189, "timestamp": "02:14:23", "text": "また一つ。"}, {"type": "subtitle", "time": 8072.229, "timestamp": "02:14:32", "text": "いや、それは私が望んでいたことではない。"}, {"type": "subtitle", "time": 8078.629, "timestamp": "02:14:38", "text": "ここでサイクロンが登場する"}, {"type": "subtitle", "time": 8080.149, "timestamp": "02:14:40", "text": "遊ぶ。"}, {"type": "subtitle", "time": 8084.069, "timestamp": "02:14:44", "text": "ああ、わかった。私はただ"}, {"type": "subtitle", "time": 8087.35, "timestamp": "02:14:47", "text": "えっと、みんな、彼らは分裂し続けている"}, {"type": "subtitle", "time": 8089.91, "timestamp": "02:14:49", "text": "離れて。"}, {"type": "subtitle", "time": 8092.39, "timestamp": "02:14:52", "text": "マリアナはまるで彼らを切り裂いているかのようだ。"}, {"type": "subtitle", "time": 8096.79, "timestamp": "02:14:56", "text": "まあ、それは理解できるかな。うーん、たぶん、たぶん"}]
[{"type": "subtitle", "time": 1802.07, "timestamp": "00:30:02", "text": "つまり、つまり、もし私たちが"}, {"type": "subtitle", "time": 1804.31, "timestamp": "00:30:04", "text": "厳密に言えば、私は"}, {"type": "subtitle", "time": 1805.99, "timestamp": "00:30:05", "text": "ロック。"}, {"type": "subtitle", "time": 1808.23, "timestamp": "00:30:08", "text": "技術的には。技術的には。"}, {"type": "subtitle", "time": 1809.59, "timestamp": "00:30:09", "text": "技術的には。うん。何でも"}, {"type": "subtitle", "time": 1811.19, "timestamp": "00:30:11", "text": "技術的には食用可能。"}, {"type": "subtitle", "time": 1812.149, "timestamp": "00:30:12", "text": "時々だけ"}, {"type": "subtitle", "time": 1814.149, "timestamp": "00:30:14", "text": "努力すれば何でも食べられる"}, {"type": "subtitle", "time": 1815.35, "timestamp": "00:30:15", "text": "十分。"}, {"type": "subtitle", "time": 1821.19, "timestamp": "00:30:21", "text": "特に鳥たちにとって。"}, {"type": "subtitle", "time": 1823.83, "timestamp": "00:30:23", "text": "鳥たち。神。"}, {"type": "subtitle", "time": 1825.75, "timestamp": "00:30:25", "text": "光り輝く石。"}, {"type": "subtitle", "time": 1827.19, "timestamp": "00:30:27", "text": "ちょっと覗いてみようと思ってただけ"}, {"type": "subtitle", "time": 1829.35, "timestamp": "00:30:29", "text": "鳥に何を与えるのかという混乱"}, {"type": "subtitle", "time": 1831.35, "timestamp": "00:30:31", "text": "岩？"}, {"type": "subtitle", "time": 1833.43, "timestamp": "00:30:33", "text": "彼らは船に乗っていて、"}, {"type": "subtitle", "time": 1835.669, "timestamp": "00:30:35", "text": "ご褒美に値する。"}, {"type": "subtitle", "time": 1838.95, "timestamp": "00:30:38", "text": "船上で鳥に石を与えて餌をやろう。"}, {"type": "subtitle", "time": 1840.789, "timestamp": "00:30:40", "text": "ええ、私が彼らに石を渡して"}, {"type": "subtitle", "time": 1842.549, "timestamp": "00:30:42", "text": "特に光沢があり、ティックに"}, {"type": "subtitle", "time": 1844.549, "timestamp": "00:30:44", "text": "報酬。"}, {"type": "subtitle", "time": 1850.549, "timestamp": "00:30:50", "text": "ああ、その岩はもしかして金でできているの？"}, {"type": "subtitle", "time": 1853.029, "timestamp": "00:30:53", "text": "そうではないかもしれない。多分。だから、ティックは"}, {"type": "subtitle", "time": 1855.19, "timestamp": "00:30:55", "text": "本当に気にかけているなら、"}, {"type": "subtitle", "time": 1855.909, "timestamp": "00:30:55", "text": "方法。"}, {"type": "subtitle", "time": 1858.149, "timestamp": "00:30:58", "text": "彼は鳥にお金をあげていると思う。"}]
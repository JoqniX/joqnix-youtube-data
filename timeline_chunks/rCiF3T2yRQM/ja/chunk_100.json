[{"type": "subtitle", "time": 6000.87, "timestamp": "01:40:00", "text": "みんなノートをもらえますか？"}, {"type": "subtitle", "time": 6002.87, "timestamp": "01:40:02", "text": "一緒に？もしかしたら、何かおしっこできるかも"}, {"type": "subtitle", "time": 6003.91, "timestamp": "01:40:03", "text": "外。"}, {"type": "subtitle", "time": 6005.83, "timestamp": "01:40:05", "text": "私はショックを与えるメモを"}, {"type": "subtitle", "time": 6007.51, "timestamp": "01:40:07", "text": "死体から拾い上げた。"}, {"type": "subtitle", "time": 6009.83, "timestamp": "01:40:09", "text": "よし。"}, {"type": "subtitle", "time": 6011.75, "timestamp": "01:40:11", "text": "そう、脳だよ。"}, {"type": "subtitle", "time": 6013.109, "timestamp": "01:40:13", "text": "ノートをアップします。"}, {"type": "subtitle", "time": 6014.79, "timestamp": "01:40:14", "text": "実際には、最も賢い人物ではない。私は"}, {"type": "subtitle", "time": 6016.629, "timestamp": "01:40:16", "text": "ジョックとティックは"}, {"type": "subtitle", "time": 6019.669, "timestamp": "01:40:19", "text": "実際にはより賢い"}, {"type": "subtitle", "time": 6022.629, "timestamp": "01:40:22", "text": "Tは妙に賢い。"}, {"type": "subtitle", "time": 6024.629, "timestamp": "01:40:24", "text": "わかった。よし。あなたたちのうちの一人に"}, {"type": "subtitle", "time": 6027.59, "timestamp": "01:40:27", "text": "有利な条件で調査判定を行う。"}, {"type": "subtitle", "time": 6028.07, "timestamp": "01:40:28", "text": "おい、"}, {"type": "subtitle", "time": 6029.99, "timestamp": "01:40:29", "text": "どう思いますか？ティック、"}, {"type": "subtitle", "time": 6032.149, "timestamp": "01:40:32", "text": "ティック、どう思う？"}, {"type": "subtitle", "time": 6033.75, "timestamp": "01:40:33", "text": "チェック、読む。"}, {"type": "subtitle", "time": 6035.27, "timestamp": "01:40:35", "text": "ティック、字が読める？"}, {"type": "subtitle", "time": 6036.149, "timestamp": "01:40:36", "text": "うん、読んでみて。"}, {"type": "subtitle", "time": 6037.99, "timestamp": "01:40:37", "text": "具体的にそうするのであれば。わかった、行くよ"}, {"type": "subtitle", "time": 6040.629, "timestamp": "01:40:40", "text": "それを示すために。もし私がTと言おうとしていたら"}, {"type": "subtitle", "time": 6042.39, "timestamp": "01:40:42", "text": "もし具体的にティックがそうするなら、私は"}, {"type": "subtitle", "time": 6044.31, "timestamp": "01:40:44", "text": "Tが両方飲んだのでプラス5点あげよう"}, {"type": "subtitle", "time": 6045.43, "timestamp": "01:40:45", "text": "液体。"}, {"type": "subtitle", "time": 6046.55, "timestamp": "01:40:46", "text": "よし。"}, {"type": "subtitle", "time": 6047.51, "timestamp": "01:40:47", "text": "ええと、それは20点ですね。"}, {"type": "subtitle", "time": 6048.95, "timestamp": "01:40:48", "text": "20点だ。それは本当に素晴らしい。全て"}, {"type": "subtitle", "time": 6051.59, "timestamp": "01:40:51", "text": "右。メモを見て"}, {"type": "subtitle", "time": 6053.43, "timestamp": "01:40:53", "text": "クロスチェックすると、"}, {"type": "subtitle", "time": 6059.43, "timestamp": "01:40:59", "text": "このメモ、これらのメモはご存知でしょう"}]
[{"type": "subtitle", "time": 4200.39, "timestamp": "01:10:00", "text": "1つ。"}, {"type": "subtitle", "time": 4203.03, "timestamp": "01:10:03", "text": "よりましな方を選ぶ。"}, {"type": "subtitle", "time": 4205.11, "timestamp": "01:10:05", "text": "正直に言います。あまりそうは思わない"}, {"type": "subtitle", "time": 4211.03, "timestamp": "01:10:11", "text": "ティックが水や"}, {"type": "subtitle", "time": 4214.63, "timestamp": "01:10:14", "text": "床は、おそらくあまり良くないでしょう。"}, {"type": "subtitle", "time": 4217.03, "timestamp": "01:10:17", "text": "ありがとう、ティック。私はむしろ"}, {"type": "subtitle", "time": 4219.11, "timestamp": "01:10:19", "text": "それなら一番上のやつですね。"}, {"type": "subtitle", "time": 4221.51, "timestamp": "01:10:21", "text": "よし、じゃあ行こう。アリアナは"}, {"type": "subtitle", "time": 4222.87, "timestamp": "01:10:22", "text": "頂上へ戻り始めるが、彼女は"}, {"type": "subtitle", "time": 4223.91, "timestamp": "01:10:23", "text": "まだ中には入らない。彼女は"}, {"type": "subtitle", "time": 4226.229, "timestamp": "01:10:26", "text": "他の人を待つ。"}, {"type": "subtitle", "time": 4226.709, "timestamp": "01:10:26", "text": "わかった、"}, {"type": "subtitle", "time": 4230.39, "timestamp": "01:10:30", "text": "俺のクソ鋳造所がロードされたらそこにいるぞ。"}, {"type": "subtitle", "time": 4231.51, "timestamp": "01:10:31", "text": "XC。"}, {"type": "subtitle", "time": 4233.35, "timestamp": "01:10:33", "text": "おお。ああ、わかりました。うん。ちょっと待って、"}, {"type": "subtitle", "time": 4234.31, "timestamp": "01:10:34", "text": "推測。"}, {"type": "subtitle", "time": 4235.189, "timestamp": "01:10:35", "text": "うん。"}, {"type": "subtitle", "time": 4237.27, "timestamp": "01:10:37", "text": "それで、もう一つ廊下があるんです。アリーナは"}, {"type": "subtitle", "time": 4238.79, "timestamp": "01:10:38", "text": "遠くから見ているだけのように見える。彼女"}, {"type": "subtitle", "time": 4241.189, "timestamp": "01:10:41", "text": "暗すぎて何も見えない。"}, {"type": "subtitle", "time": 4243.03, "timestamp": "01:10:43", "text": "まるで彼女が覗き込んでいるように"}, {"type": "subtitle", "time": 4246.149, "timestamp": "01:10:46", "text": "のように見える"}, {"type": "subtitle", "time": 4249.03, "timestamp": "01:10:49", "text": "ティックはアリアナと一緒に目を細めている"}, {"type": "subtitle", "time": 4250.709, "timestamp": "01:10:50", "text": "見えない。まるで彼らには闇がないかのように"}, {"type": "subtitle", "time": 4256.709, "timestamp": "01:10:56", "text": "何てことだ。"}, {"type": "subtitle", "time": 4259.59, "timestamp": "01:10:59", "text": "彼は、なんて言うんだっけ？彼は、えっと"}]
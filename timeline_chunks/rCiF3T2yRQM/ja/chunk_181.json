[{"type": "subtitle", "time": 10863.269, "timestamp": "03:01:03", "text": "わかった。はい。ああ、それは基準値を超えている。"}, {"type": "subtitle", "time": 10865.67, "timestamp": "03:01:05", "text": "はい、どうぞ。君は、それはちょっと"}, {"type": "subtitle", "time": 10867.349, "timestamp": "03:01:07", "text": "切り開く。"}, {"type": "subtitle", "time": 10870.309, "timestamp": "03:01:10", "text": "殺す。"}, {"type": "subtitle", "time": 10872.23, "timestamp": "03:01:12", "text": "ちょっと気持ち悪い。"}, {"type": "subtitle", "time": 10874.55, "timestamp": "03:01:14", "text": "たぶん、私はただ切り裂くだけだと思う"}, {"type": "subtitle", "time": 10876.469, "timestamp": "03:01:16", "text": "このスライムへの2度目の攻撃で"}, {"type": "subtitle", "time": 10883.75, "timestamp": "03:01:23", "text": "ダメージ。"}, {"type": "subtitle", "time": 10890.95, "timestamp": "03:01:30", "text": "おお。俺たちはかなりヤバい"}, {"type": "subtitle", "time": 10892.95, "timestamp": "03:01:32", "text": "私は当然知っている？ああ、ロールパンは"}, {"type": "subtitle", "time": 10899.51, "timestamp": "03:01:39", "text": "よし。他に何かあなたの番ですか？"}, {"type": "subtitle", "time": 10903.51, "timestamp": "03:01:43", "text": "えっと、私の"}, {"type": "subtitle", "time": 10905.75, "timestamp": "03:01:45", "text": "そうそう。君はパンという武器を手に入れた。"}, {"type": "subtitle", "time": 10907.67, "timestamp": "03:01:47", "text": "私の何ですって？君はパン兵器だ。あなたは"}, {"type": "subtitle", "time": 10910.389, "timestamp": "03:01:50", "text": "火のパンか、それとも雷のパンか？つまり、"}, {"type": "subtitle", "time": 10913.51, "timestamp": "03:01:53", "text": "ああ、そうだな。"}, {"type": "subtitle", "time": 10915.03, "timestamp": "03:01:55", "text": "ボーナスアクションだと思う。できますか？"}, {"type": "subtitle", "time": 10917.269, "timestamp": "03:01:57", "text": "もう一度呪文を確認しますか？それが"}, {"type": "subtitle", "time": 10918.71, "timestamp": "03:01:58", "text": "アクションまたはボーナスアクションかどうかは、"}]
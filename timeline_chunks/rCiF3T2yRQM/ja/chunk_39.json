[{"type": "subtitle", "time": 2340.39, "timestamp": "00:39:00", "text": "ドアを開けようとしている。"}, {"type": "subtitle", "time": 2342.79, "timestamp": "00:39:02", "text": "ドアは施錠されています。それは"}, {"type": "subtitle", "time": 2344.79, "timestamp": "00:39:04", "text": "反対側からバリケードで封鎖されている。"}, {"type": "subtitle", "time": 2348.71, "timestamp": "00:39:08", "text": "なんでバリケードが張ってあるんだ？"}, {"type": "subtitle", "time": 2350.87, "timestamp": "00:39:10", "text": "よし。こんにちはと言うとき、"}, {"type": "subtitle", "time": 2353.27, "timestamp": "00:39:13", "text": "内側からのあなたの反応。えっと、"}, {"type": "subtitle", "time": 2356.069, "timestamp": "00:39:16", "text": "夜。遊ばせてあげよう。リシー。"}, {"type": "subtitle", "time": 2361.91, "timestamp": "00:39:21", "text": "うん。両方にいるのはあなただけです"}, {"type": "subtitle", "time": 2363.75, "timestamp": "00:39:23", "text": "セッション。だから、私は行くよ、あなたは行くよ"}, {"type": "subtitle", "time": 2372.79, "timestamp": "00:39:32", "text": "はい、どうぞ。はい、どうぞ。"}, {"type": "subtitle", "time": 2378.15, "timestamp": "00:39:38", "text": "えっと、それで、レイはたぶん休んでいたんだと思う"}, {"type": "subtitle", "time": 2381.589, "timestamp": "00:39:41", "text": "彼がみんなと一緒にいるとき、彼女が聞いたとき"}, {"type": "subtitle", "time": 2383.829, "timestamp": "00:39:43", "text": "外からの呼び出しがあり、彼女はただ"}, {"type": "subtitle", "time": 2385.829, "timestamp": "00:39:45", "text": "すぐに元気が出る"}, {"type": "subtitle", "time": 2388.15, "timestamp": "00:39:48", "text": "まるで寝ているかのように座っている"}, {"type": "subtitle", "time": 2390.47, "timestamp": "00:39:50", "text": "他の人たちと一緒に、それから彼女はただ歩く"}, {"type": "subtitle", "time": 2394.63, "timestamp": "00:39:54", "text": "ドアのところに行って、「誰ですか？」って感じで。"}, {"type": "subtitle", "time": 2397.75, "timestamp": "00:39:57", "text": "私たちです。あなたは私たちのことをよく知っていますよね。"}, {"type": "subtitle", "time": 2399.51, "timestamp": "00:39:59", "text": "私たち。"}]
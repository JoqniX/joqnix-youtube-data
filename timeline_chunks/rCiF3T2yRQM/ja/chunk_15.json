[{"type": "subtitle", "time": 901.11, "timestamp": "00:15:01", "text": "良い。"}, {"type": "subtitle", "time": 901.59, "timestamp": "00:15:01", "text": "そうそう。"}, {"type": "subtitle", "time": 902.71, "timestamp": "00:15:02", "text": "わかった。"}, {"type": "subtitle", "time": 905.509, "timestamp": "00:15:05", "text": "ドラコニック語を話す人、または"}, {"type": "subtitle", "time": 907.829, "timestamp": "00:15:07", "text": "何か？何が"}, {"type": "subtitle", "time": 911.35, "timestamp": "00:15:11", "text": "あなたが話しているのは。"}, {"type": "subtitle", "time": 913.35, "timestamp": "00:15:13", "text": "えっと"}, {"type": "subtitle", "time": 915.829, "timestamp": "00:15:15", "text": "いいえ。個性的な感じがする。"}, {"type": "subtitle", "time": 919.99, "timestamp": "00:15:19", "text": "私はドニック語を話します。アリアナはそうする。"}, {"type": "subtitle", "time": 921.91, "timestamp": "00:15:21", "text": "Jもまた慢性的なことを話す。ジョー、あなた"}, {"type": "subtitle", "time": 924.15, "timestamp": "00:15:24", "text": "長時間の休息を忘れる。全ての人にとって"}, {"type": "subtitle", "time": 927.269, "timestamp": "00:15:27", "text": "十分な休息を取ることを忘れないでください。はい、そうします"}, {"type": "subtitle", "time": 929.03, "timestamp": "00:15:29", "text": "それ。"}, {"type": "subtitle", "time": 930.31, "timestamp": "00:15:30", "text": "まだ十分に休んでいないなら、"}, {"type": "subtitle", "time": 932.23, "timestamp": "00:15:32", "text": "ゆっくり休んでください。"}, {"type": "subtitle", "time": 934.949, "timestamp": "00:15:34", "text": "もう一度やらなきゃいけないのは、絶対に"}, {"type": "subtitle", "time": 939.509, "timestamp": "00:15:39", "text": "大量のクソを使う。"}, {"type": "subtitle", "time": 940.55, "timestamp": "00:15:40", "text": "やったー。"}, {"type": "subtitle", "time": 941.35, "timestamp": "00:15:41", "text": "おい。"}, {"type": "subtitle", "time": 941.91, "timestamp": "00:15:41", "text": "もちろんさ。"}, {"type": "subtitle", "time": 943.35, "timestamp": "00:15:43", "text": "ああ、だって君は"}, {"type": "subtitle", "time": 945.43, "timestamp": "00:15:45", "text": "相手側。"}, {"type": "subtitle", "time": 953.11, "timestamp": "00:15:53", "text": "何てことだ。"}, {"type": "subtitle", "time": 956.55, "timestamp": "00:15:56", "text": "2回敗北した。"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "2回。する"}]
[{"type": "subtitle", "time": 4384.229, "timestamp": "01:13:04", "text": "とても簡単なアクロバットです。何が起こるかわかりませんからね。"}, {"type": "subtitle", "time": 4386.55, "timestamp": "01:13:06", "text": "面白いことになるよ。よし、君は安全だ。"}, {"type": "subtitle", "time": 4388.79, "timestamp": "01:13:08", "text": "アリアンは無事です。歩くだけで"}, {"type": "subtitle", "time": 4391.59, "timestamp": "01:13:11", "text": "胸を反対側に向けます。おお、"}, {"type": "subtitle", "time": 4397.51, "timestamp": "01:13:17", "text": "取っていく"}, {"type": "subtitle", "time": 4400.229, "timestamp": "01:13:20", "text": "わかった、アリアナは乗り越えたと言っておこう"}, {"type": "subtitle", "time": 4402.55, "timestamp": "01:13:22", "text": "ここ。おお、"}, {"type": "subtitle", "time": 4407.03, "timestamp": "01:13:27", "text": "私はこれを予想していました。予想通りだった。"}, {"type": "subtitle", "time": 4409.91, "timestamp": "01:13:29", "text": "そして、あなたは飛び乗ろうとした"}, {"type": "subtitle", "time": 4411.59, "timestamp": "01:13:31", "text": "ディスクはあちらに落ちた。何何"}, {"type": "subtitle", "time": 4412.87, "timestamp": "01:13:32", "text": "ジョグ？"}, {"type": "subtitle", "time": 4414.149, "timestamp": "01:13:34", "text": "そうそう。"}, {"type": "subtitle", "time": 4417.43, "timestamp": "01:13:37", "text": "わかった。よし。ジョギングなら大丈夫だよ。"}, {"type": "subtitle", "time": 4418.79, "timestamp": "01:13:38", "text": "ディスクの上に立つか、"}, {"type": "subtitle", "time": 4420.07, "timestamp": "01:13:40", "text": "反対側。どれ？どこで"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "立ちたいですか？"}, {"type": "subtitle", "time": 4423.83, "timestamp": "01:13:43", "text": "ああ、反対側。"}, {"type": "subtitle", "time": 4427.189, "timestamp": "01:13:47", "text": "わかった。でも、私はそんなに運動神経が良いわけではないんです。"}, {"type": "subtitle", "time": 4428.31, "timestamp": "01:13:48", "text": "では、これを移動します"}, {"type": "subtitle", "time": 4429.43, "timestamp": "01:13:49", "text": "とりあえずここに。"}, {"type": "subtitle", "time": 4430.87, "timestamp": "01:13:50", "text": "脚。"}, {"type": "subtitle", "time": 4433.51, "timestamp": "01:13:53", "text": "わかった。よし。えっと、テックと"}, {"type": "subtitle", "time": 4436.95, "timestamp": "01:13:56", "text": "エスタンは、えっと、転んだんだけど、気づいてる？"}, {"type": "subtitle", "time": 4438.79, "timestamp": "01:13:58", "text": "地面に倒れ込むように。私は...するだろう"}]
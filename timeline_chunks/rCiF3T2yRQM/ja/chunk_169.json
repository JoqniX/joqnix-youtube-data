[{"type": "subtitle", "time": 10142.71, "timestamp": "02:49:02", "text": "今は私を幸せにしてくれない。"}, {"type": "subtitle", "time": 10146.55, "timestamp": "02:49:06", "text": "大丈夫。家庭での使用に非常に良い選択肢です。"}, {"type": "subtitle", "time": 10150.87, "timestamp": "02:49:10", "text": "頼んではいませんが、ありがとうございます。"}, {"type": "subtitle", "time": 10152.95, "timestamp": "02:49:12", "text": "わかった。"}, {"type": "subtitle", "time": 10157.349, "timestamp": "02:49:17", "text": "ちなみに、地面を突き刺しても"}, {"type": "subtitle", "time": 10159.91, "timestamp": "02:49:19", "text": "多くを成し遂げているようだ。反応はするが、"}, {"type": "subtitle", "time": 10162.95, "timestamp": "02:49:22", "text": "まるで、まるで、まるで"}, {"type": "subtitle", "time": 10165.19, "timestamp": "02:49:25", "text": "アリに噛まれる。"}, {"type": "subtitle", "time": 10166.8, "timestamp": "02:49:26", "text": "わかった、"}, {"type": "subtitle", "time": 10168.07, "timestamp": "02:49:28", "text": "[音楽]"}, {"type": "subtitle", "time": 10169.67, "timestamp": "02:49:29", "text": "内側から。"}, {"type": "subtitle", "time": 10172.15, "timestamp": "02:49:32", "text": "キャンセルするつもりだった"}, {"type": "subtitle", "time": 10173.51, "timestamp": "02:49:33", "text": "内部。"}, {"type": "subtitle", "time": 10175.99, "timestamp": "02:49:35", "text": "占いをしてみようと思っていた"}, {"type": "subtitle", "time": 10177.59, "timestamp": "02:49:37", "text": "それを打ち砕くが、これは感じない"}, {"type": "subtitle", "time": 10179.59, "timestamp": "02:49:39", "text": "いいアイデアですね。"}, {"type": "subtitle", "time": 10180.309, "timestamp": "02:49:40", "text": "もったいない気がする。"}, {"type": "subtitle", "time": 10183.269, "timestamp": "02:49:43", "text": "もちろん、試してみてもいいですよ。"}, {"type": "subtitle", "time": 10186.15, "timestamp": "02:49:46", "text": "もちろん試してみてもいいですよ。"}, {"type": "subtitle", "time": 10189.19, "timestamp": "02:49:49", "text": "何が見えるんだ？何が"}, {"type": "subtitle", "time": 10192.309, "timestamp": "02:49:52", "text": "たくさんのぬめりとたくさんの粘液と"}, {"type": "subtitle", "time": 10198.389, "timestamp": "02:49:58", "text": "では、質問があります。"}, {"type": "subtitle", "time": 10198.87, "timestamp": "02:49:58", "text": "うん。"}]
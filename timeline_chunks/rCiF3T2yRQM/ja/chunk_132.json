[{"type": "subtitle", "time": 7921.109, "timestamp": "02:12:01", "text": "ああ、飲み込めない。"}, {"type": "subtitle", "time": 7923.91, "timestamp": "02:12:03", "text": "ああ、やばい、"}, {"type": "subtitle", "time": 7926.31, "timestamp": "02:12:06", "text": "ああ、これのどれかですね。"}, {"type": "subtitle", "time": 7929.27, "timestamp": "02:12:09", "text": "ああ、くそ。私は嫌いです"}, {"type": "subtitle", "time": 7931.51, "timestamp": "02:12:11", "text": "いいえ、実際には嫌いとは言えません"}, {"type": "subtitle", "time": 7933.35, "timestamp": "02:12:13", "text": "スライムが本当に大好きです。"}, {"type": "subtitle", "time": 7935.75, "timestamp": "02:12:15", "text": "私も大好きです。ああ、私はちょうど"}, {"type": "subtitle", "time": 7936.87, "timestamp": "02:12:16", "text": "一般的な。"}, {"type": "subtitle", "time": 7937.589, "timestamp": "02:12:17", "text": "うん、"}, {"type": "subtitle", "time": 7939.27, "timestamp": "02:12:19", "text": "正直言って、私の一番好きなモンスタータイプです。私 私"}, {"type": "subtitle", "time": 7940.629, "timestamp": "02:12:20", "text": "ウィザーズ・オブ・ザ・コーストからもっと愛されることを願う"}, {"type": "subtitle", "time": 7942.95, "timestamp": "02:12:22", "text": "海岸。スライムをもっと増やすべきだ。"}, {"type": "subtitle", "time": 7944.069, "timestamp": "02:12:24", "text": "私は誓います"}, {"type": "subtitle", "time": 7951.27, "timestamp": "02:12:31", "text": "うん、"}, {"type": "subtitle", "time": 7954.87, "timestamp": "02:12:34", "text": "彼らは時々最悪だ。"}, {"type": "subtitle", "time": 7957.35, "timestamp": "02:12:37", "text": "わかった。他に何か？"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "私はそうは思わない。それは"}, {"type": "subtitle", "time": 7962.149, "timestamp": "02:12:42", "text": "私の番が回ってきたのはこれだけです。"}, {"type": "subtitle", "time": 7965.99, "timestamp": "02:12:45", "text": "わかった。よし。これらの人たちは、えっと、私は"}, {"type": "subtitle", "time": 7968.47, "timestamp": "02:12:48", "text": "彼らは引っ越すつもりだ。そこには"}, {"type": "subtitle", "time": 7971.669, "timestamp": "02:12:51", "text": "あなたが行く。持続する。ああ、それはまさに財布の中身だね。"}, {"type": "subtitle", "time": 7974.069, "timestamp": "02:12:54", "text": "よし、この男は道を譲る"}, {"type": "subtitle", "time": 7976.229, "timestamp": "02:12:56", "text": "そしてグリップ力が増す"}]
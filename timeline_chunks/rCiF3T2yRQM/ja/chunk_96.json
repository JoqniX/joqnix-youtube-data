[{"type": "subtitle", "time": 5761.99, "timestamp": "01:36:01", "text": "黒いもの以外はよくわからない"}, {"type": "subtitle", "time": 5771.83, "timestamp": "01:36:11", "text": "大変だったね。それは大きな効果があります。"}, {"type": "subtitle", "time": 5774.55, "timestamp": "01:36:14", "text": "ええと、もう1本クソのボトルがある"}, {"type": "subtitle", "time": 5777.189, "timestamp": "01:36:17", "text": "それは何という名前ですか？またしてもクソありふれた"}, {"type": "subtitle", "time": 5779.189, "timestamp": "01:36:19", "text": "ワインボトル。できますか？試してもいいですか？"}, {"type": "subtitle", "time": 5781.03, "timestamp": "01:36:21", "text": "青い方を集めますか？"}, {"type": "subtitle", "time": 5783.43, "timestamp": "01:36:23", "text": "うーん、少なすぎますね。ほんのわずかです"}, {"type": "subtitle", "time": 5783.91, "timestamp": "01:36:23", "text": "滴。"}, {"type": "subtitle", "time": 5785.99, "timestamp": "01:36:25", "text": "少なすぎる。わかった。"}, {"type": "subtitle", "time": 5787.669, "timestamp": "01:36:27", "text": "それはおそらく"}, {"type": "subtitle", "time": 5790.79, "timestamp": "01:36:30", "text": "私は石を落としただけです。"}, {"type": "subtitle", "time": 5791.83, "timestamp": "01:36:31", "text": "面白い。"}, {"type": "subtitle", "time": 5793.75, "timestamp": "01:36:33", "text": "提案をしてください。"}, {"type": "subtitle", "time": 5795.03, "timestamp": "01:36:35", "text": "あなたの提案は何ですか？"}, {"type": "subtitle", "time": 5796.709, "timestamp": "01:36:36", "text": "死体を拾い上げて投げたらどうなるだろう"}, {"type": "subtitle", "time": 5799.11, "timestamp": "01:36:39", "text": "それを入れますか？"}, {"type": "subtitle", "time": 5801.27, "timestamp": "01:36:41", "text": "あの、あのね？"}, {"type": "subtitle", "time": 5804.79, "timestamp": "01:36:44", "text": "それはひどい考えだ。"}, {"type": "subtitle", "time": 5807.83, "timestamp": "01:36:47", "text": "それも試してみてもいいかもしれませんね。"}, {"type": "subtitle", "time": 5811.03, "timestamp": "01:36:51", "text": "彼らが言うように、試してみるのもいいでしょう。"}, {"type": "subtitle", "time": 5813.669, "timestamp": "01:36:53", "text": "そしてカルト集団が現実のものとなり始める。"}, {"type": "subtitle", "time": 5815.8, "timestamp": "01:36:55", "text": "黒人の達人として。"}]
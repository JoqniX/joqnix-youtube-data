[{"type": "subtitle", "time": 1921.269, "timestamp": "00:32:01", "text": "何でも独占できるってことだよね。"}, {"type": "subtitle", "time": 1923.269, "timestamp": "00:32:03", "text": "しかし、あなたはティックの独占権を持っています"}, {"type": "subtitle", "time": 1925.99, "timestamp": "00:32:05", "text": "心臓。"}, {"type": "subtitle", "time": 1927.509, "timestamp": "00:32:07", "text": "A"}, {"type": "subtitle", "time": 1935.11, "timestamp": "00:32:15", "text": "のように"}, {"type": "subtitle", "time": 1937.11, "timestamp": "00:32:17", "text": "「彼を飼ってもいいですか？」って感じになるだろうね。"}, {"type": "subtitle", "time": 1938.95, "timestamp": "00:32:18", "text": "ヴァンとロータスの両方。彼はただ彼女は"}, {"type": "subtitle", "time": 1940.71, "timestamp": "00:32:20", "text": "「彼を飼ってもいいですか？」って感じになるだろうね。"}, {"type": "subtitle", "time": 1944.71, "timestamp": "00:32:24", "text": "何てことだ。私はあまり話しません。"}, {"type": "subtitle", "time": 1947.11, "timestamp": "00:32:27", "text": "たとえ私たちが「ノー」と言ったとしても。あなたは"}, {"type": "subtitle", "time": 1948.47, "timestamp": "00:32:28", "text": "あなたはこう言うつもりですか"}, {"type": "subtitle", "time": 1952.95, "timestamp": "00:32:32", "text": "それはカステですか？"}, {"type": "subtitle", "time": 1954.389, "timestamp": "00:32:34", "text": "水分補給の注意喚起、ありがとうございます。"}, {"type": "subtitle", "time": 1956.87, "timestamp": "00:32:36", "text": "アリアナは行くと思う"}, {"type": "subtitle", "time": 1959.99, "timestamp": "00:32:39", "text": "私たちどちらかが言うこと"}, {"type": "subtitle", "time": 1961.99, "timestamp": "00:32:41", "text": "極度の脱水症状。みんな"}, {"type": "subtitle", "time": 1964.23, "timestamp": "00:32:44", "text": "水を飲んでください。"}, {"type": "subtitle", "time": 1966.87, "timestamp": "00:32:46", "text": "彼女は今、かなり愛着を持っているように見える。"}, {"type": "subtitle", "time": 1968.87, "timestamp": "00:32:48", "text": "それは熱湯だ。ああ、なんてことだ、私はただ"}, {"type": "subtitle", "time": 1971.909, "timestamp": "00:32:51", "text": "唇がヒリヒリした。"}, {"type": "subtitle", "time": 1973.029, "timestamp": "00:32:53", "text": "彼が死んだ場合。"}, {"type": "subtitle", "time": 1977.269, "timestamp": "00:32:57", "text": "H それは、それは、私たちが呼ぶものです"}, {"type": "subtitle", "time": 1979.83, "timestamp": "00:32:59", "text": "危険信号だ。私"}]
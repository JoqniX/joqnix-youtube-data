[{"type": "subtitle", "time": 6900.629, "timestamp": "01:55:00", "text": "家族。"}, {"type": "subtitle", "time": 6902.39, "timestamp": "01:55:02", "text": "何てことだ。"}, {"type": "subtitle", "time": 6904.629, "timestamp": "01:55:04", "text": "泣き止んで、ただ微笑む。"}, {"type": "subtitle", "time": 6906.629, "timestamp": "01:55:06", "text": "すぐに泣き止んだ。"}, {"type": "subtitle", "time": 6909.669, "timestamp": "01:55:09", "text": "たぶん"}, {"type": "subtitle", "time": 6912.629, "timestamp": "01:55:12", "text": "アリはティックにハグをするつもりだ。ティックは"}, {"type": "subtitle", "time": 6916.229, "timestamp": "01:55:16", "text": "幸せそうな小さな声を出すつもり。"}, {"type": "subtitle", "time": 6917.43, "timestamp": "01:55:17", "text": "なるほど、じゃあ"}, {"type": "subtitle", "time": 6920.31, "timestamp": "01:55:20", "text": "操作の技術。"}, {"type": "subtitle", "time": 6922.07, "timestamp": "01:55:22", "text": "まあ、アリアナは操作しようとしているわけではない"}, {"type": "subtitle", "time": 6925.99, "timestamp": "01:55:25", "text": "あなた。彼女はただあなたを抱きしめているだけです。"}, {"type": "subtitle", "time": 6927.669, "timestamp": "01:55:27", "text": "スティックの知恵とは一体何なのか？おお、"}, {"type": "subtitle", "time": 6934.07, "timestamp": "01:55:34", "text": "彼女はとても賢いのに、とてもバカだ"}, {"type": "subtitle", "time": 6937.03, "timestamp": "01:55:37", "text": "同時に。"}, {"type": "subtitle", "time": 6937.43, "timestamp": "01:55:37", "text": "良い、"}, {"type": "subtitle", "time": 6938.87, "timestamp": "01:55:38", "text": "アリアナのように、あなたは持っている"}, {"type": "subtitle", "time": 6943.109, "timestamp": "01:55:43", "text": "知性はあるが、世渡りの知恵はない。"}, {"type": "subtitle", "time": 6944.79, "timestamp": "01:55:44", "text": "ミニブック。"}, {"type": "subtitle", "time": 6947.589, "timestamp": "01:55:47", "text": "サバンは、私たちが最も基本的なと呼ぶものです"}, {"type": "subtitle", "time": 6951.109, "timestamp": "01:55:51", "text": "[ __ ]。彼にはマイナス面は何もない。"}, {"type": "subtitle", "time": 6953.99, "timestamp": "01:55:53", "text": "彼はありきたりな男だ。"}, {"type": "subtitle", "time": 6956.47, "timestamp": "01:55:56", "text": "大丈夫。私たちは皆、人生において基本的な存在です。"}, {"type": "subtitle", "time": 6959.109, "timestamp": "01:55:59", "text": "よし、それで、私はそれについて考えたし、"}]
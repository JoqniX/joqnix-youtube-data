[{"type": "subtitle", "time": 4800.63, "timestamp": "01:20:00", "text": "何らかの橋を架ける。私は思う"}, {"type": "subtitle", "time": 4802.95, "timestamp": "01:20:02", "text": "芽が出るようなものだから、理にかなっている。"}, {"type": "subtitle", "time": 4804.95, "timestamp": "01:20:04", "text": "地面にある物。うん。"}, {"type": "subtitle", "time": 4807.51, "timestamp": "01:20:07", "text": "わーい。"}, {"type": "subtitle", "time": 4811.11, "timestamp": "01:20:11", "text": "私は茶色く変色して、まるで草のようになる。"}, {"type": "subtitle", "time": 4812.55, "timestamp": "01:20:12", "text": "あなたはそれをしたいのですか？もし"}, {"type": "subtitle", "time": 4814.229, "timestamp": "01:20:14", "text": "ということで、私はそのリソースを消費します。"}, {"type": "subtitle", "time": 4818.95, "timestamp": "01:20:18", "text": "はい。はい。ああ、私はできる、私はできる"}, {"type": "subtitle", "time": 4821.43, "timestamp": "01:20:21", "text": "えーと、橋。おお、"}, {"type": "subtitle", "time": 4823.27, "timestamp": "01:20:23", "text": "わかった。はい、どうぞ。 20フィート四方。私"}, {"type": "subtitle", "time": 4825.75, "timestamp": "01:20:25", "text": "20フィート四方くらいでしょうか。えっと、見てみましょう。"}, {"type": "subtitle", "time": 4827.83, "timestamp": "01:20:27", "text": "えっと、どこに"}, {"type": "subtitle", "time": 4829.03, "timestamp": "01:20:29", "text": "測定テンプレート？よし、これでいい。うん。"}, {"type": "subtitle", "time": 4831.11, "timestamp": "01:20:31", "text": "わかった。はい、どうぞ。すべて揃っている。今"}, {"type": "subtitle", "time": 4833.35, "timestamp": "01:20:33", "text": "地面はただのもつれ状態になる。それは"}, {"type": "subtitle", "time": 4835.51, "timestamp": "01:20:35", "text": "以前よりずっとベタつきが少なくなった。はるかに簡単です"}, {"type": "subtitle", "time": 4838.07, "timestamp": "01:20:38", "text": "もし手を引っ張ってみたいなら"}, {"type": "subtitle", "time": 4840.95, "timestamp": "01:20:40", "text": "外。"}, {"type": "subtitle", "time": 4843.43, "timestamp": "01:20:43", "text": "まあ、そうですね。わかった。ああ、そしてそれは"}, {"type": "subtitle", "time": 4845.99, "timestamp": "01:20:45", "text": "困難な地形、まるでそれが仕事だから"}, {"type": "subtitle", "time": 4847.51, "timestamp": "01:20:47", "text": "お手伝いします。よし。他に何かありますか？"}, {"type": "subtitle", "time": 4848.87, "timestamp": "01:20:48", "text": "次はあなたの番ですか？"}, {"type": "subtitle", "time": 4851.83, "timestamp": "01:20:51", "text": "えっと、どうやってプレイするんですか？配置するんですか？"}, {"type": "subtitle", "time": 4852.95, "timestamp": "01:20:52", "text": "ああ、もう設置済みですね。心配しないで。"}, {"type": "subtitle", "time": 4854.07, "timestamp": "01:20:54", "text": "はい、どうぞ。わかった。わかった。全て"}, {"type": "subtitle", "time": 4855.75, "timestamp": "01:20:55", "text": "右。"}, {"type": "subtitle", "time": 4858.149, "timestamp": "01:20:58", "text": "えっと"}]
[{"type": "subtitle", "time": 603.59, "timestamp": "00:10:03", "text": "今回はもっと積極的に話すようにしないと。"}, {"type": "subtitle", "time": 605.59, "timestamp": "00:10:05", "text": "彼らがそれをするのを見なければならない"}, {"type": "subtitle", "time": 606.389, "timestamp": "00:10:06", "text": "もう一度。"}, {"type": "subtitle", "time": 609.43, "timestamp": "00:10:09", "text": "また。また。"}, {"type": "subtitle", "time": 609.839, "timestamp": "00:10:09", "text": "また。 私はもっ​​とこのことを話すようにしなければならない"}, {"type": "subtitle", "time": 612.08, "timestamp": "00:10:12", "text": "私はもっ​​とこのことを話すようにしなければならない 時間。"}, {"type": "subtitle", "time": 613.92, "timestamp": "00:10:13", "text": "時間。 ああ、それから、カヌーはもうカヌーのままです。"}, {"type": "subtitle", "time": 616.959, "timestamp": "00:10:16", "text": "ああ、それから、カヌーはもうカヌーのままです。 何てことだ。"}, {"type": "subtitle", "time": 619.279, "timestamp": "00:10:19", "text": "何てことだ。 おお。"}, {"type": "subtitle", "time": 622.079, "timestamp": "00:10:22", "text": "おお。 カヌーはカヌーだ。"}, {"type": "subtitle", "time": 624.64, "timestamp": "00:10:24", "text": "カヌーはカヌーだ。 カヌーが"}, {"type": "subtitle", "time": 626.48, "timestamp": "00:10:26", "text": "カヌーが 間違いなくカヌーだ。"}, {"type": "subtitle", "time": 633.03, "timestamp": "00:10:33", "text": "時間軸を破壊する歪み。そうだった"}, {"type": "subtitle", "time": 634.31, "timestamp": "00:10:34", "text": "いつもカヌーだ。"}, {"type": "subtitle", "time": 636.23, "timestamp": "00:10:36", "text": "それは昔からずっとカヌーだった。うん。"}, {"type": "subtitle", "time": 637.59, "timestamp": "00:10:37", "text": "ずっとカヌーだった。"}, {"type": "subtitle", "time": 639.91, "timestamp": "00:10:39", "text": "うん。どういう意味ですか？"}, {"type": "subtitle", "time": 643.11, "timestamp": "00:10:43", "text": "うん。それは、決してカヌーではなかった。"}, {"type": "subtitle", "time": 645.19, "timestamp": "00:10:45", "text": "そうでないと言う人は間違いなく"}, {"type": "subtitle", "time": 646.63, "timestamp": "00:10:46", "text": "非常識な。"}, {"type": "subtitle", "time": 649.99, "timestamp": "00:10:49", "text": "うん。うん。私は狂ってなんかいない。君はどうかしてるよ。"}, {"type": "subtitle", "time": 651.43, "timestamp": "00:10:51", "text": "で。"}, {"type": "subtitle", "time": 654.79, "timestamp": "00:10:54", "text": "何てことだ。でも、ただ"}, {"type": "subtitle", "time": 657.269, "timestamp": "00:10:57", "text": "ここにランダムなコバルトがあります。"}, {"type": "subtitle", "time": 659.269, "timestamp": "00:10:59", "text": "一体なぜ"}, {"type": "subtitle", "time": 659.75, "timestamp": "00:10:59", "text": "ただ"}]
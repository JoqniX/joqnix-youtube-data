[{"type": "subtitle", "time": 4500.79, "timestamp": "01:15:00", "text": "えーっと、ちょっと見せてください。アラートは"}, {"type": "subtitle", "time": 4502.39, "timestamp": "01:15:02", "text": "有利ですよね？"}, {"type": "subtitle", "time": 4506.149, "timestamp": "01:15:06", "text": "いや、違うよ。これでプラス5点もらえると思う。"}, {"type": "subtitle", "time": 4508.149, "timestamp": "01:15:08", "text": "ああ、わかりました。そうは思わない。追加します"}, {"type": "subtitle", "time": 4508.95, "timestamp": "01:15:08", "text": "手動で行います。"}, {"type": "subtitle", "time": 4510.31, "timestamp": "01:15:10", "text": "すでに101人。"}, {"type": "subtitle", "time": 4512.47, "timestamp": "01:15:12", "text": "はい、+5のボーナスを獲得します"}, {"type": "subtitle", "time": 4513.669, "timestamp": "01:15:13", "text": "主導権。"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "待って、イニシアチブはどこにあるの？見つかりません"}, {"type": "subtitle", "time": 4517.43, "timestamp": "01:15:17", "text": "それ。"}, {"type": "subtitle", "time": 4519.83, "timestamp": "01:15:19", "text": "収集シートの最初のページに記入してください。"}, {"type": "subtitle", "time": 4522.149, "timestamp": "01:15:22", "text": "それはあなたの写真の下にあります"}, {"type": "subtitle", "time": 4523.189, "timestamp": "01:15:23", "text": "トークンというものがある"}, {"type": "subtitle", "time": 4523.75, "timestamp": "01:15:23", "text": "主導権。"}, {"type": "subtitle", "time": 4525.43, "timestamp": "01:15:25", "text": "ああ、これだ。わかった。"}, {"type": "subtitle", "time": 4526.63, "timestamp": "01:15:26", "text": "はい。"}, {"type": "subtitle", "time": 4530.55, "timestamp": "01:15:30", "text": "つまり、私のイニシアチブはプラス9ということでしょうか。"}, {"type": "subtitle", "time": 4532.95, "timestamp": "01:15:32", "text": "ああ、それに加えて。うん。ええと、言いますね"}, {"type": "subtitle", "time": 4534.63, "timestamp": "01:15:34", "text": "すでに通常のものが追加されています"}, {"type": "subtitle", "time": 4536.07, "timestamp": "01:15:36", "text": "アラートがあればプラス5になります"}, {"type": "subtitle", "time": 4537.59, "timestamp": "01:15:37", "text": "また。つまり、合計23人になります。"}, {"type": "subtitle", "time": 4538.07, "timestamp": "01:15:38", "text": "右？"}, {"type": "subtitle", "time": 4538.79, "timestamp": "01:15:38", "text": "うん。うん。うん。"}, {"type": "subtitle", "time": 4542.31, "timestamp": "01:15:42", "text": "23. わかりました。はい、どうぞ。"}, {"type": "subtitle", "time": 4543.59, "timestamp": "01:15:43", "text": "よし。そして私は、私は"}, {"type": "subtitle", "time": 4544.87, "timestamp": "01:15:44", "text": "これを転がしてください。"}, {"type": "subtitle", "time": 4549.11, "timestamp": "01:15:49", "text": "はい、どうぞ。よし。えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 4550.79, "timestamp": "01:15:50", "text": "私はそれを明らかにします。なぜ"}, {"type": "subtitle", "time": 4553.669, "timestamp": "01:15:53", "text": "それは、ほら、という感じですか。よし。"}, {"type": "subtitle", "time": 4556.63, "timestamp": "01:15:56", "text": "わかった。さて、えーと、私はただ"}, {"type": "subtitle", "time": 4559.91, "timestamp": "01:15:59", "text": "こうやってやってみて。ああ、わかった。それで、"}]
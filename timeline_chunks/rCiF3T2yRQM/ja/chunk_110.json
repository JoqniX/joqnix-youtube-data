[{"type": "subtitle", "time": 6600.47, "timestamp": "01:50:00", "text": "生物について。起きたことを無視する"}, {"type": "subtitle", "time": 6604.07, "timestamp": "01:50:04", "text": "ティックはまるで完全に忘れてしまったかのようだ。"}, {"type": "subtitle", "time": 6607.51, "timestamp": "01:50:07", "text": "私はその像だ。しかし、これは可能だろうか"}, {"type": "subtitle", "time": 6610.629, "timestamp": "01:50:10", "text": "ダンジョンは生きているし、私たちは行くような"}, {"type": "subtitle", "time": 6614.07, "timestamp": "01:50:14", "text": "その胃袋の中へ？"}, {"type": "subtitle", "time": 6616.31, "timestamp": "01:50:16", "text": "ああ、みんなが"}, {"type": "subtitle", "time": 6617.43, "timestamp": "01:50:17", "text": "のように"}, {"type": "subtitle", "time": 6619.109, "timestamp": "01:50:19", "text": "そういえば、"}, {"type": "subtitle", "time": 6621.75, "timestamp": "01:50:21", "text": "このダンジョン全体が、"}, {"type": "subtitle", "time": 6623.59, "timestamp": "01:50:23", "text": "このダンジョンは複数階建てですよね？"}, {"type": "subtitle", "time": 6626.47, "timestamp": "01:50:26", "text": "このダンジョンは複数の階層から成っているようだ。"}, {"type": "subtitle", "time": 6628.47, "timestamp": "01:50:28", "text": "えっと、ダンジョンにはテーマがあって、"}, {"type": "subtitle", "time": 6630.39, "timestamp": "01:50:30", "text": "各階にはそれぞれテーマがある。推測できるなら"}, {"type": "subtitle", "time": 6633.75, "timestamp": "01:50:33", "text": "テーマからインスピレーションを得るんです。"}, {"type": "subtitle", "time": 6636.47, "timestamp": "01:50:36", "text": "そして、SLAも覚えているよ"}, {"type": "subtitle", "time": 6639.109, "timestamp": "01:50:39", "text": "君がDMで君の予想を1つ送ってくれたら嬉しいな。"}, {"type": "subtitle", "time": 6640.55, "timestamp": "01:50:40", "text": "死者を当てにしますか？"}, {"type": "subtitle", "time": 6642.79, "timestamp": "01:50:42", "text": "各セッションにつき、お一人様1回ずつ推測できます。"}, {"type": "subtitle", "time": 6644.55, "timestamp": "01:50:44", "text": "私は推測を保留します"}, {"type": "subtitle", "time": 6645.109, "timestamp": "01:50:45", "text": "今。"}, {"type": "subtitle", "time": 6646.629, "timestamp": "01:50:46", "text": "わかった。 1セッションにつき1回のみの推測。遠慮なく"}, {"type": "subtitle", "time": 6648.31, "timestamp": "01:50:48", "text": "推測したいなら、"}, {"type": "subtitle", "time": 6649.91, "timestamp": "01:50:49", "text": "右？それは、"}, {"type": "subtitle", "time": 6650.709, "timestamp": "01:50:50", "text": "脳みそを持っている。"}, {"type": "subtitle", "time": 6652.629, "timestamp": "01:50:52", "text": "もう一枚黒を取りに行ってきます"}, {"type": "subtitle", "time": 6653.669, "timestamp": "01:50:53", "text": "液体。"}, {"type": "subtitle", "time": 6654.709, "timestamp": "01:50:54", "text": "わかった。"}, {"type": "subtitle", "time": 6657.109, "timestamp": "01:50:57", "text": "ここのこの一角をテストしてみましょう"}]
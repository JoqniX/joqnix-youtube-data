[{"type": "subtitle", "time": 4980.07, "timestamp": "01:23:00", "text": "まるで海のように。"}, {"type": "subtitle", "time": 4982.229, "timestamp": "01:23:02", "text": "わかった。よし。あなたの"}, {"type": "subtitle", "time": 4985.51, "timestamp": "01:23:05", "text": "そのインスピレーションの源。わかった。そして、えーと"}, {"type": "subtitle", "time": 4987.669, "timestamp": "01:23:07", "text": "あなたも同じようにあなたを持ち上げますか、それとも"}, {"type": "subtitle", "time": 4993.43, "timestamp": "01:23:13", "text": "いいえ、ただ私から遠ざけているだけです"}, {"type": "subtitle", "time": 4995.91, "timestamp": "01:23:15", "text": "そうすれば、私はただ試して手に入れることができる"}, {"type": "subtitle", "time": 4997.59, "timestamp": "01:23:17", "text": "もっと近くに。"}, {"type": "subtitle", "time": 4999.59, "timestamp": "01:23:19", "text": "もっと近づいてみてください。どういう意味ですか？"}, {"type": "subtitle", "time": 4999.99, "timestamp": "01:23:19", "text": "どのような？"}, {"type": "subtitle", "time": 5001.51, "timestamp": "01:23:21", "text": "私はただ、もっと近づこうとしているだけです。私はただ"}, {"type": "subtitle", "time": 5003.59, "timestamp": "01:23:23", "text": "行こうとしている。ああ、私は私が"}, {"type": "subtitle", "time": 5005.27, "timestamp": "01:23:25", "text": "あなたにそうさせてあげるよ、だってそれはとても"}, {"type": "subtitle", "time": 5007.99, "timestamp": "01:23:27", "text": "面白い考えだ。あなたに、ええと、ただ"}, {"type": "subtitle", "time": 5011.11, "timestamp": "01:23:31", "text": "それに関しては遠慮なく行動してください。"}, {"type": "subtitle", "time": 5012.39, "timestamp": "01:23:32", "text": "ここから出られるよ。"}, {"type": "subtitle", "time": 5015.59, "timestamp": "01:23:35", "text": "うん。うん。あなたはもう終わりです。"}, {"type": "subtitle", "time": 5018.149, "timestamp": "01:23:38", "text": "わかった。"}, {"type": "subtitle", "time": 5018.47, "timestamp": "01:23:38", "text": "うん。"}, {"type": "subtitle", "time": 5022.39, "timestamp": "01:23:42", "text": "つまり、コバルトは血液を動かすことができるのだ。私"}, {"type": "subtitle", "time": 5023.43, "timestamp": "01:23:43", "text": "わかった。あなたが知っている"}, {"type": "subtitle", "time": 5024.47, "timestamp": "01:23:44", "text": "それは不気味だ。"}, {"type": "subtitle", "time": 5026.87, "timestamp": "01:23:46", "text": "彼は私が知っている血を操る者の一人だ"}, {"type": "subtitle", "time": 5028.79, "timestamp": "01:23:48", "text": "聞いたことがある。"}, {"type": "subtitle", "time": 5032.07, "timestamp": "01:23:52", "text": "一度一度一度あなたが一度好きなものが際立っている、"}, {"type": "subtitle", "time": 5033.75, "timestamp": "01:23:53", "text": "この部屋は次のように始まることに気づく"}, {"type": "subtitle", "time": 5036.629, "timestamp": "01:23:56", "text": "奇妙な液体が降っている。"}, {"type": "subtitle", "time": 5038.31, "timestamp": "01:23:58", "text": "うわぁ。"}]
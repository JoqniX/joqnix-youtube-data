[{"type": "subtitle", "time": 5821.189, "timestamp": "01:37:01", "text": "これらのうちの1つはおそらく"}, {"type": "subtitle", "time": 5823.27, "timestamp": "01:37:03", "text": "蘇生させるとか、そういうこと。その一つは"}, {"type": "subtitle", "time": 5825.83, "timestamp": "01:37:05", "text": "おそらく待つことになるでしょう。すべてチェックしてみましょう"}, {"type": "subtitle", "time": 5827.35, "timestamp": "01:37:07", "text": "死体。何かあるか見てみよう"}, {"type": "subtitle", "time": 5829.91, "timestamp": "01:37:09", "text": "初め。念のため"}, {"type": "subtitle", "time": 5831.03, "timestamp": "01:37:11", "text": "確認したい場合は、"}, {"type": "subtitle", "time": 5831.91, "timestamp": "01:37:11", "text": "その問題を調査してください。"}, {"type": "subtitle", "time": 5833.59, "timestamp": "01:37:13", "text": "私たちは恐らく私たちは恐らく望んでいない"}, {"type": "subtitle", "time": 5835.35, "timestamp": "01:37:15", "text": "黒い液体に自ら触れてみる。それ"}, {"type": "subtitle", "time": 5839.59, "timestamp": "01:37:19", "text": "どう見ても安全そうには見えない。"}, {"type": "subtitle", "time": 5840.95, "timestamp": "01:37:20", "text": "あまり美味しくない。"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "ごめん。何？あれは何でしょう？"}, {"type": "subtitle", "time": 5845.43, "timestamp": "01:37:25", "text": "黒い液体は美味しくない。"}, {"type": "subtitle", "time": 5847.109, "timestamp": "01:37:27", "text": "おお。"}, {"type": "subtitle", "time": 5848.07, "timestamp": "01:37:28", "text": "よし。私は行くつもりです 私は行くつもりです"}, {"type": "subtitle", "time": 5850.149, "timestamp": "01:37:30", "text": "私の隣にある死体を見てください。"}, {"type": "subtitle", "time": 5853.03, "timestamp": "01:37:33", "text": "わかった。えっと、見てみたい？"}, {"type": "subtitle", "time": 5854.629, "timestamp": "01:37:34", "text": "死体のそばにいるだけですか、それとも手に入れたいですか？"}, {"type": "subtitle", "time": 5856.149, "timestamp": "01:37:36", "text": "ポケットとかから？欲しい"}, {"type": "subtitle", "time": 5857.43, "timestamp": "01:37:37", "text": "ポケットの中を見るだろうが、私は"}, {"type": "subtitle", "time": 5858.95, "timestamp": "01:37:38", "text": "知りたいと思うこと、避けたいこと"}, {"type": "subtitle", "time": 5860.39, "timestamp": "01:37:40", "text": "黒い液体に触れること。"}, {"type": "subtitle", "time": 5864.55, "timestamp": "01:37:44", "text": "わかった。わかりました。わかった。ああ、ああ、作る"}, {"type": "subtitle", "time": 5866.39, "timestamp": "01:37:46", "text": "調査。実際、そうは思わない"}, {"type": "subtitle", "time": 5867.75, "timestamp": "01:37:47", "text": "大丈夫です。まるであなたが"}, {"type": "subtitle", "time": 5870.229, "timestamp": "01:37:50", "text": "ポケット。どれもまるで"}, {"type": "subtitle", "time": 5873.91, "timestamp": "01:37:53", "text": "ほとんど空っぽだ。えっと、でも"}, {"type": "subtitle", "time": 5876.31, "timestamp": "01:37:56", "text": "スキャットノートのようなものがたくさんある"}, {"type": "subtitle", "time": 5877.83, "timestamp": "01:37:57", "text": "ポケット。"}, {"type": "subtitle", "time": 5879.91, "timestamp": "01:37:59", "text": "ああ、そうそう、忘れてたみたいだけど"}]
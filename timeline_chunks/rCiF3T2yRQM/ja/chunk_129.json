[{"type": "subtitle", "time": 7741.27, "timestamp": "02:09:01", "text": "心配しないで。"}, {"type": "subtitle", "time": 7744.95, "timestamp": "02:09:04", "text": "私たちはローグ（反逆者）の要素を出し過ぎている。"}, {"type": "subtitle", "time": 7747.669, "timestamp": "02:09:07", "text": "それは普通のことです。普通ですよね？"}, {"type": "subtitle", "time": 7748.149, "timestamp": "02:09:08", "text": "うん。"}, {"type": "subtitle", "time": 7752.709, "timestamp": "02:09:12", "text": "ついに。"}, {"type": "subtitle", "time": 7755.75, "timestamp": "02:09:15", "text": "わかった。よし。えっと、"}, {"type": "subtitle", "time": 7758.149, "timestamp": "02:09:18", "text": "それをすぐに明らかにする。わかった。取引"}, {"type": "subtitle", "time": 7762.149, "timestamp": "02:09:22", "text": "13ダメージ。よし。えっと、私はただ"}, {"type": "subtitle", "time": 7764.87, "timestamp": "02:09:24", "text": "そうしてください。えっと、それはあなたも選んだ"}, {"type": "subtitle", "time": 7766.149, "timestamp": "02:09:26", "text": "酸。だから、それを変更することにします。"}, {"type": "subtitle", "time": 7767.99, "timestamp": "02:09:27", "text": "あなたはLSDをやっていないと仮定します。"}, {"type": "subtitle", "time": 7770.79, "timestamp": "02:09:30", "text": "右？"}, {"type": "subtitle", "time": 7772.629, "timestamp": "02:09:32", "text": "あなたはそうするつもりはないと仮定します"}, {"type": "subtitle", "time": 7775.35, "timestamp": "02:09:35", "text": "損害を与える。だから、私は"}, {"type": "subtitle", "time": 7778.39, "timestamp": "02:09:38", "text": "全損害額。はい、どうぞ。"}, {"type": "subtitle", "time": 7780.47, "timestamp": "02:09:40", "text": "そう思います。"}, {"type": "subtitle", "time": 7783.99, "timestamp": "02:09:43", "text": "おそらく"}, {"type": "subtitle", "time": 7784.629, "timestamp": "02:09:44", "text": "うん。"}, {"type": "subtitle", "time": 7786.47, "timestamp": "02:09:46", "text": "あるいは少なくとも抵抗。"}, {"type": "subtitle", "time": 7793.109, "timestamp": "02:09:53", "text": "それは妥当な推測だと思います。"}, {"type": "subtitle", "time": 7795.109, "timestamp": "02:09:55", "text": "よし。わかった。完了したら、クリックしてください"}, {"type": "subtitle", "time": 7797.83, "timestamp": "02:09:57", "text": "入力。"}, {"type": "subtitle", "time": 7799.99, "timestamp": "02:09:59", "text": "別の方法を入手しない限り"}]
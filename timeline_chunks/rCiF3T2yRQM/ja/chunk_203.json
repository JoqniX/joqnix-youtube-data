[{"type": "subtitle", "time": 12180.229, "timestamp": "03:23:00", "text": "あ、待って。くそ。ああ、くそ。クソッ"}, {"type": "subtitle", "time": 12183.11, "timestamp": "03:23:03", "text": "少なくとも話した。ごめんなさい。"}, {"type": "subtitle", "time": 12186.87, "timestamp": "03:23:06", "text": "RPG 13。"}, {"type": "subtitle", "time": 12189.91, "timestamp": "03:23:09", "text": "なんてこった。"}, {"type": "subtitle", "time": 12193.03, "timestamp": "03:23:13", "text": "いいえ、最後のです。はい、それが"}, {"type": "subtitle", "time": 12193.67, "timestamp": "03:23:13", "text": "打つ。"}, {"type": "subtitle", "time": 12197.11, "timestamp": "03:23:17", "text": "それはPG-13指定には全くふさわしくない行動だ。"}, {"type": "subtitle", "time": 12199.269, "timestamp": "03:23:19", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 12203.67, "timestamp": "03:23:23", "text": "状況はあまり良くないようだ。彼女は感じている"}, {"type": "subtitle", "time": 12208.63, "timestamp": "03:23:28", "text": "強烈な攻撃。なんてこった。ちくしょう。"}, {"type": "subtitle", "time": 12210.87, "timestamp": "03:23:30", "text": "よし。そしてそれは"}, {"type": "subtitle", "time": 12214.07, "timestamp": "03:23:34", "text": "スライムのための。よし。厚い。"}, {"type": "subtitle", "time": 12217.19, "timestamp": "03:23:37", "text": "次はあなたの番です。"}, {"type": "subtitle", "time": 12219.75, "timestamp": "03:23:39", "text": "でも実際はすごく面白いだろう"}, {"type": "subtitle", "time": 12223.59, "timestamp": "03:23:43", "text": "スライムをテストしようとしたからです。"}, {"type": "subtitle", "time": 12225.91, "timestamp": "03:23:45", "text": "2匹目のサナダムシ。"}, {"type": "subtitle", "time": 12228.309, "timestamp": "03:23:48", "text": "また一人。"}, {"type": "subtitle", "time": 12232.229, "timestamp": "03:23:52", "text": "2番。つまり、魔法のテープが"}, {"type": "subtitle", "time": 12234.95, "timestamp": "03:23:54", "text": "魔法のウジ虫、効かないよ。私の。"}, {"type": "subtitle", "time": 12236.63, "timestamp": "03:23:56", "text": "魔法のウジ虫。"}]
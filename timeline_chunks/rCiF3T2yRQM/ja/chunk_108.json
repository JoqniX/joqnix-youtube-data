[{"type": "subtitle", "time": 6483.51, "timestamp": "01:48:03", "text": "もちろんさ。"}, {"type": "subtitle", "time": 6485.83, "timestamp": "01:48:05", "text": "そして男は舐めました"}, {"type": "subtitle", "time": 6487.669, "timestamp": "01:48:07", "text": "小さな唇とあなたが思うように"}, {"type": "subtitle", "time": 6489.83, "timestamp": "01:48:09", "text": "ダニは食べようとしなかった。"}, {"type": "subtitle", "time": 6494.229, "timestamp": "01:48:14", "text": "私たちが食べない限り、食べ物を食べないでほしい"}, {"type": "subtitle", "time": 6500.629, "timestamp": "01:48:20", "text": "わかった。"}, {"type": "subtitle", "time": 6502.87, "timestamp": "01:48:22", "text": "たぶん私たちは"}, {"type": "subtitle", "time": 6505.03, "timestamp": "01:48:25", "text": "この黒い液体を塗ってみて"}, {"type": "subtitle", "time": 6508.07, "timestamp": "01:48:28", "text": "あちらの肉を見て、それがどうなるか見てみましょう"}, {"type": "subtitle", "time": 6509.189, "timestamp": "01:48:29", "text": "それを取り除く。"}, {"type": "subtitle", "time": 6511.35, "timestamp": "01:48:31", "text": "ああ、ティックがそう言ってたよ。"}, {"type": "subtitle", "time": 6513.51, "timestamp": "01:48:33", "text": "ええ、わかっています。だから私は言ったし、"}, {"type": "subtitle", "time": 6514.55, "timestamp": "01:48:34", "text": "「うん、これは"}, {"type": "subtitle", "time": 6516.07, "timestamp": "01:48:36", "text": "チクッ。これはあなたのアイデアです。私はただ"}, {"type": "subtitle", "time": 6517.43, "timestamp": "01:48:37", "text": "それを伝達する。"}, {"type": "subtitle", "time": 6518.95, "timestamp": "01:48:38", "text": "うん。うん。いいえ、実際は良い"}, {"type": "subtitle", "time": 6520.709, "timestamp": "01:48:40", "text": "誰も聞いていないはずのアイデアだ。"}, {"type": "subtitle", "time": 6525.59, "timestamp": "01:48:45", "text": "もし皆さんがすべてを解散したいなら"}, {"type": "subtitle", "time": 6528.229, "timestamp": "01:48:48", "text": "死体、それは取り除くのに役立つかもしれない"}, {"type": "subtitle", "time": 6529.43, "timestamp": "01:48:49", "text": "それの。"}, {"type": "subtitle", "time": 6529.99, "timestamp": "01:48:49", "text": "実際は"}, {"type": "subtitle", "time": 6531.51, "timestamp": "01:48:51", "text": "いいえ、ただ、"}, {"type": "subtitle", "time": 6533.35, "timestamp": "01:48:53", "text": "肉厚な黒い液体の入った小瓶"}, {"type": "subtitle", "time": 6535.51, "timestamp": "01:48:55", "text": "物を取り除いて、"}, {"type": "subtitle", "time": 6537.35, "timestamp": "01:48:57", "text": "大きくて肉感的な部屋。"}, {"type": "subtitle", "time": 6539.109, "timestamp": "01:48:59", "text": "まあ、やってみる価値はあるね。間違いなく"}]
[{"type": "subtitle", "time": 9966.389, "timestamp": "02:46:06", "text": "それは酸で濡れていますが、"}, {"type": "subtitle", "time": 9968.469, "timestamp": "02:46:08", "text": "見えない、それはまるで"}, {"type": "subtitle", "time": 9971.19, "timestamp": "02:46:11", "text": "あなたが来た場所から来たもの。そうではありません"}, {"type": "subtitle", "time": 9973.11, "timestamp": "02:46:13", "text": "あなたの鎧を貫通するのに十分な強さ"}, {"type": "subtitle", "time": 9974.87, "timestamp": "02:46:14", "text": "そして靴。"}, {"type": "subtitle", "time": 9976.469, "timestamp": "02:46:16", "text": "同じように、それはあなたの"}, {"type": "subtitle", "time": 9978.55, "timestamp": "02:46:18", "text": "靴。だからこの後は新しいものを食べるかもしれない"}, {"type": "subtitle", "time": 9980.63, "timestamp": "02:46:20", "text": "靴ですが、それだけでは十分ではありません"}, {"type": "subtitle", "time": 9982.55, "timestamp": "02:46:22", "text": "お肌に届きます。"}, {"type": "subtitle", "time": 9983.51, "timestamp": "02:46:23", "text": "わかった、"}, {"type": "subtitle", "time": 9989.349, "timestamp": "02:46:29", "text": "少しだけ先に進みましょう。見る"}, {"type": "subtitle", "time": 9991.59, "timestamp": "02:46:31", "text": "何か見えるものがあれば。"}, {"type": "subtitle", "time": 9996.389, "timestamp": "02:46:36", "text": "クリス・ビームを頭に乗せるだけ"}, {"type": "subtitle", "time": 9998.389, "timestamp": "02:46:38", "text": "手短に。彼は必要としている 彼は必要としている"}, {"type": "subtitle", "time": 10000.23, "timestamp": "02:46:40", "text": "壊す。"}, {"type": "subtitle", "time": 10003.429, "timestamp": "02:46:43", "text": "ダニはパリパリの中を歩かないだろう"}, {"type": "subtitle", "time": 10006.469, "timestamp": "02:46:46", "text": "チクタク。カリカリに揚げたものを食べようとは思わないのですか？"}, {"type": "subtitle", "time": 10009.75, "timestamp": "02:46:49", "text": "ああ、クリスピーは"}, {"type": "subtitle", "time": 10012.71, "timestamp": "02:46:52", "text": "ダニはカリカリに食べるだろう。彼はあまりにも生き生きしすぎている。"}, {"type": "subtitle", "time": 10015.6, "timestamp": "02:46:55", "text": "生き生きしすぎている。 ティックの好みには生々しすぎる。"}, {"type": "subtitle", "time": 10017.68, "timestamp": "02:46:57", "text": "ティックの好みには生々しすぎる。 言うまでもなく、クリスピーは家族でもある。"}]
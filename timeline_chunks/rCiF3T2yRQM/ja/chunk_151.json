[{"type": "subtitle", "time": 9067.91, "timestamp": "02:31:07", "text": "えーっと、弓使いを使うような感じで、"}, {"type": "subtitle", "time": 9068.79, "timestamp": "02:31:08", "text": "下げてください。"}, {"type": "subtitle", "time": 9070.389, "timestamp": "02:31:10", "text": "使用するにはスターフォームをアクティブにする必要があります"}, {"type": "subtitle", "time": 9071.429, "timestamp": "02:31:11", "text": "射手。"}, {"type": "subtitle", "time": 9075.349, "timestamp": "02:31:15", "text": "つまり、2つのスキルということですね？あるいは行動。"}, {"type": "subtitle", "time": 9077.19, "timestamp": "02:31:17", "text": "えっと、電源を入れたとき"}, {"type": "subtitle", "time": 9079.349, "timestamp": "02:31:19", "text": "星形の場合、"}, {"type": "subtitle", "time": 9080.87, "timestamp": "02:31:20", "text": "もの。例えば、アーチャーを選んだ場合、"}, {"type": "subtitle", "time": 9085.11, "timestamp": "02:31:25", "text": "弓兵を召喚するつもり"}, {"type": "subtitle", "time": 9087.99, "timestamp": "02:31:27", "text": "より大きな被害をもたらす。それは"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "2D。 2Dだとダメージが大きいってことですよね？二"}, {"type": "subtitle", "time": 9093.51, "timestamp": "02:31:33", "text": "サイコロは"}, {"type": "subtitle", "time": 9094.87, "timestamp": "02:31:34", "text": "うん。"}, {"type": "subtitle", "time": 9097.99, "timestamp": "02:31:37", "text": "サイコロの神は、あなたに多くのものを与える"}, {"type": "subtitle", "time": 9099.19, "timestamp": "02:31:39", "text": "損害の。うん。"}, {"type": "subtitle", "time": 9101.75, "timestamp": "02:31:41", "text": "うん。うん。サイコロの神様が"}, {"type": "subtitle", "time": 9104.79, "timestamp": "02:31:44", "text": "あなたに損害を与えます。"}, {"type": "subtitle", "time": 9105.51, "timestamp": "02:31:45", "text": "わかった。"}, {"type": "subtitle", "time": 9107.83, "timestamp": "02:31:47", "text": "イエス。イエスを解放せよ。"}, {"type": "subtitle", "time": 9111.03, "timestamp": "02:31:51", "text": "ああ、わかった。待って、私の月の光線がアクティブです、"}, {"type": "subtitle", "time": 9111.99, "timestamp": "02:31:51", "text": "右？"}, {"type": "subtitle", "time": 9116.63, "timestamp": "02:31:56", "text": "はい。だから私はそれを制御したり、再トリガーしたりできます"}, {"type": "subtitle", "time": 9117.59, "timestamp": "02:31:57", "text": "それとか、そういうもの。"}, {"type": "subtitle", "time": 9119.83, "timestamp": "02:31:59", "text": "取引をご希望の場合は、再度追加いたします。"}]
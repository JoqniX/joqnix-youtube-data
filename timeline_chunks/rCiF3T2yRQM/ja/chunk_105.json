[{"type": "subtitle", "time": 6300.629, "timestamp": "01:45:00", "text": "自分の。"}, {"type": "subtitle", "time": 6303.03, "timestamp": "01:45:03", "text": "ああ、神様。試してみてもいいですか？"}, {"type": "subtitle", "time": 6305.03, "timestamp": "01:45:05", "text": "知覚は、もしも見たらどうなるかというようなものです"}, {"type": "subtitle", "time": 6306.629, "timestamp": "01:45:06", "text": "部屋には他に何かありますか？"}, {"type": "subtitle", "time": 6309.75, "timestamp": "01:45:09", "text": "ええ、どうぞご自由に。"}, {"type": "subtitle", "time": 6311.43, "timestamp": "01:45:11", "text": "これはただふざけてるだけだよ"}, {"type": "subtitle", "time": 6314.47, "timestamp": "01:45:14", "text": "私たちが理解できない物質。"}, {"type": "subtitle", "time": 6315.03, "timestamp": "01:45:15", "text": "美味しい。"}, {"type": "subtitle", "time": 6317.59, "timestamp": "01:45:17", "text": "これは今起こっていることです。"}, {"type": "subtitle", "time": 6318.79, "timestamp": "01:45:18", "text": "聞く、"}, {"type": "subtitle", "time": 6321.99, "timestamp": "01:45:21", "text": "ヴァンは楽しんでいる。彼"}, {"type": "subtitle", "time": 6325.669, "timestamp": "01:45:25", "text": "誰かにこう言ってあげたい"}, {"type": "subtitle", "time": 6327.669, "timestamp": "01:45:27", "text": "そういう類のもの"}, {"type": "subtitle", "time": 6329.99, "timestamp": "01:45:29", "text": "それは彼にとってそれほど重要なことではない。アブ"}, {"type": "subtitle", "time": 6336.79, "timestamp": "01:45:36", "text": "ティックは、もし私たちが黒を取ったらどうなるかと考えた"}, {"type": "subtitle", "time": 6338.55, "timestamp": "01:45:38", "text": "液体をドロドロのものに注ぎました"}, {"type": "subtitle", "time": 6344.31, "timestamp": "01:45:44", "text": "何が起こったか見てみましょう"}, {"type": "subtitle", "time": 6346.87, "timestamp": "01:45:46", "text": "はい、わかりました。"}, {"type": "subtitle", "time": 6348.95, "timestamp": "01:45:48", "text": "こんな感じ"}, {"type": "subtitle", "time": 6351.27, "timestamp": "01:45:51", "text": "良いアイデアにチェックを入れる"}, {"type": "subtitle", "time": 6353.43, "timestamp": "01:45:53", "text": "よし、それなら"}, {"type": "subtitle", "time": 6356.55, "timestamp": "01:45:56", "text": "あ、ごめん、Vはあまり会えないんだ。"}, {"type": "subtitle", "time": 6358.629, "timestamp": "01:45:58", "text": "あまり見かけない"}]
[{"type": "subtitle", "time": 721.35, "timestamp": "00:12:01", "text": "すべき"}, {"type": "subtitle", "time": 724.389, "timestamp": "00:12:04", "text": "私は恥ずかしがり屋なので、"}, {"type": "subtitle", "time": 726.389, "timestamp": "00:12:06", "text": "あなたが何を伝えようとしているのか分かりません"}, {"type": "subtitle", "time": 728.47, "timestamp": "00:12:08", "text": "私たち"}, {"type": "subtitle", "time": 729.269, "timestamp": "00:12:09", "text": "翻訳"}, {"type": "subtitle", "time": 732.47, "timestamp": "00:12:12", "text": "それは良くない"}, {"type": "subtitle", "time": 734.87, "timestamp": "00:12:14", "text": "私"}, {"type": "subtitle", "time": 739.03, "timestamp": "00:12:19", "text": "なぜ私たちはなぜ私たちはなぜ私たちはなぜ私たちは"}, {"type": "subtitle", "time": 739.67, "timestamp": "00:12:19", "text": "我々は持っています"}, {"type": "subtitle", "time": 741.67, "timestamp": "00:12:21", "text": "蓮はじっくりと見つめるだろう"}, {"type": "subtitle", "time": 746.389, "timestamp": "00:12:26", "text": "そして彼は大丈夫そうに見えるし、彼らも大丈夫そうに見える"}, {"type": "subtitle", "time": 748.23, "timestamp": "00:12:28", "text": "目に、目に、彼らの"}, {"type": "subtitle", "time": 750.55, "timestamp": "00:12:30", "text": "大きな瞳、大きな子犬、コバルトブルー"}, {"type": "subtitle", "time": 759.509, "timestamp": "00:12:39", "text": "コバルトブルーの大きな子犬のような瞳"}, {"type": "subtitle", "time": 762.71, "timestamp": "00:12:42", "text": "子犬じゃないよ、みんな、"}, {"type": "subtitle", "time": 764.949, "timestamp": "00:12:44", "text": "アリアナはこう言うだろう、「私は好き」"}, {"type": "subtitle", "time": 766.31, "timestamp": "00:12:46", "text": "彼ら。"}, {"type": "subtitle", "time": 770.79, "timestamp": "00:12:50", "text": "とてもかわいい。"}]
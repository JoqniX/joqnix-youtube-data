[{"type": "subtitle", "time": 8647.83, "timestamp": "02:24:07", "text": "あなたは私の息子を助け出してくれた。"}, {"type": "subtitle", "time": 8651.27, "timestamp": "02:24:11", "text": "アリアン、私はこれが好きじゃない。"}, {"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "これだよ。"}, {"type": "subtitle", "time": 8654.79, "timestamp": "02:24:14", "text": "何てことだ。"}, {"type": "subtitle", "time": 8656.63, "timestamp": "02:24:16", "text": "この人が喋るのは好きじゃない"}, {"type": "subtitle", "time": 8665.03, "timestamp": "02:24:25", "text": "必ずあなたに分かってもらうからね​​。"}, {"type": "subtitle", "time": 8666.389, "timestamp": "02:24:26", "text": "わかった。"}, {"type": "subtitle", "time": 8668.87, "timestamp": "02:24:28", "text": "よし。これを覚えておいてください。"}, {"type": "subtitle", "time": 8671.03, "timestamp": "02:24:31", "text": "私はこのことを覚えておく。"}, {"type": "subtitle", "time": 8674.309, "timestamp": "02:24:34", "text": "よし、これこれこれ動くぞ。"}, {"type": "subtitle", "time": 8676.63, "timestamp": "02:24:36", "text": "月の光に気づかずに。おっと。いいえ"}, {"type": "subtitle", "time": 8677.99, "timestamp": "02:24:37", "text": "そちら側。持続する。戻ってきます"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "1つ。はい、どうぞ。動いて、それから"}, {"type": "subtitle", "time": 8682.23, "timestamp": "02:24:42", "text": "月の光によってダメージを受ける。そうだね"}, {"type": "subtitle", "time": 8686.87, "timestamp": "02:24:46", "text": "うん。"}, {"type": "subtitle", "time": 8689.91, "timestamp": "02:24:49", "text": "月の光線を転がして"}, {"type": "subtitle", "time": 8693.99, "timestamp": "02:24:53", "text": "今度は損傷なしで。そうすればいい。"}, {"type": "subtitle", "time": 8697.349, "timestamp": "02:24:57", "text": "210 だけ行うこともできます。"}]
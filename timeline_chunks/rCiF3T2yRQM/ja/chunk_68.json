[{"type": "subtitle", "time": 4081.51, "timestamp": "01:08:01", "text": "何が起こるかわからない。水が必要になるかもしれない。"}, {"type": "subtitle", "time": 4082.95, "timestamp": "01:08:02", "text": "H. すみません、何ですか？"}, {"type": "subtitle", "time": 4086.309, "timestamp": "01:08:06", "text": "何が起こるかわからない。水が必要になるかもしれない。"}, {"type": "subtitle", "time": 4088.309, "timestamp": "01:08:08", "text": "うん。"}, {"type": "subtitle", "time": 4089.589, "timestamp": "01:08:09", "text": "わかった。"}, {"type": "subtitle", "time": 4091.43, "timestamp": "01:08:11", "text": "兄弟、水の形を整えているんだ。"}, {"type": "subtitle", "time": 4094.549, "timestamp": "01:08:14", "text": "君は君はみんなと同じように形作っている"}, {"type": "subtitle", "time": 4097.749, "timestamp": "01:08:17", "text": "この物体の周りには透明な粘液が付着している。"}, {"type": "subtitle", "time": 4100.789, "timestamp": "01:08:20", "text": "唾液みたいなものだよ。"}, {"type": "subtitle", "time": 4104.95, "timestamp": "01:08:24", "text": "まるで人形そのものを作るように。"}, {"type": "subtitle", "time": 4106.55, "timestamp": "01:08:26", "text": "私はそれを人々に作り変えようと思う"}, {"type": "subtitle", "time": 4107.83, "timestamp": "01:08:27", "text": "ハート。"}, {"type": "subtitle", "time": 4114.789, "timestamp": "01:08:34", "text": "君は実に巧みだね、この野郎。"}, {"type": "subtitle", "time": 4118.95, "timestamp": "01:08:38", "text": "ありがとう、魔法のコバルト。"}, {"type": "subtitle", "time": 4121.829, "timestamp": "01:08:41", "text": "うわぁ。"}, {"type": "subtitle", "time": 4124.63, "timestamp": "01:08:44", "text": "それはティックの愛を体現している"}, {"type": "subtitle", "time": 4126.55, "timestamp": "01:08:46", "text": "あなた。"}, {"type": "subtitle", "time": 4131.91, "timestamp": "01:08:51", "text": "ああ、いやだ。"}, {"type": "subtitle", "time": 4133.91, "timestamp": "01:08:53", "text": "誰かがユナイトに挨拶した。"}, {"type": "subtitle", "time": 4136.55, "timestamp": "01:08:56", "text": "あ、こんにちは。"}, {"type": "subtitle", "time": 4138.95, "timestamp": "01:08:58", "text": "よし。"}, {"type": "subtitle", "time": 4139.99, "timestamp": "01:08:59", "text": "のように、"}]
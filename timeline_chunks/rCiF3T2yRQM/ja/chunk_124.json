[{"type": "subtitle", "time": 7442.39, "timestamp": "02:04:02", "text": "このヒットの解決に役立つでしょう。"}, {"type": "subtitle", "time": 7443.43, "timestamp": "02:04:03", "text": "うん、"}, {"type": "subtitle", "time": 7446.229, "timestamp": "02:04:06", "text": "やってみてもいいですよ。できました。他にどんなデバフがありますか？"}, {"type": "subtitle", "time": 7447.43, "timestamp": "02:04:07", "text": "私は持っていますか？"}, {"type": "subtitle", "time": 7449.83, "timestamp": "02:04:09", "text": "そうそう。君が「ああ、私たちは"}, {"type": "subtitle", "time": 7453.51, "timestamp": "02:04:13", "text": "本当にひどい。私は今気づいた"}, {"type": "subtitle", "time": 7455.83, "timestamp": "02:04:15", "text": "「そんな万能魔法使いだったのに。」そしてあなたは"}, {"type": "subtitle", "time": 7457.99, "timestamp": "02:04:17", "text": "デバフ魔法使い。俺たちはもう終わりだ。"}, {"type": "subtitle", "time": 7459.03, "timestamp": "02:04:19", "text": "さあ行こう。"}, {"type": "subtitle", "time": 7459.75, "timestamp": "02:04:19", "text": "このパーティーは"}, {"type": "subtitle", "time": 7462.229, "timestamp": "02:04:22", "text": "全てのペニス制御。"}, {"type": "subtitle", "time": 7465.03, "timestamp": "02:04:25", "text": "このパーティーはジョーだと思う。私は"}, {"type": "subtitle", "time": 7467.109, "timestamp": "02:04:27", "text": "ジョグを見て、ジョグが実際に"}, {"type": "subtitle", "time": 7469.51, "timestamp": "02:04:29", "text": "役に立つ。"}, {"type": "subtitle", "time": 7473.669, "timestamp": "02:04:33", "text": "はい、答えはええと、いいえです。私たちは皆"}, {"type": "subtitle", "time": 7478.629, "timestamp": "02:04:38", "text": "俺たちはみんなクソみたいなサポートで、"}, {"type": "subtitle", "time": 7482.55, "timestamp": "02:04:42", "text": "タンク内には3つの支柱がある。さあ行こう。"}, {"type": "subtitle", "time": 7485.589, "timestamp": "02:04:45", "text": "少なくとも、ダブルワンがあると言えるでしょう。"}, {"type": "subtitle", "time": 7489.669, "timestamp": "02:04:49", "text": "アリアナは落ちていく。"}, {"type": "subtitle", "time": 7492.07, "timestamp": "02:04:52", "text": "実際に持っているんですか？"}, {"type": "subtitle", "time": 7493.189, "timestamp": "02:04:53", "text": "いいえ、"}, {"type": "subtitle", "time": 7494.39, "timestamp": "02:04:54", "text": "私はしません。"}, {"type": "subtitle", "time": 7497.189, "timestamp": "02:04:57", "text": "ああ、大変だ。これは面白くなりそうだ。は"}, {"type": "subtitle", "time": 7499.03, "timestamp": "02:04:59", "text": "仕事は実現しないのか？"}]
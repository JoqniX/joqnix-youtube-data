[{"type": "subtitle", "time": 7500.629, "timestamp": "02:05:00", "text": "私は妖精の炎を持っています。"}, {"type": "subtitle", "time": 7502.229, "timestamp": "02:05:02", "text": "準備を変更することもできます"}, {"type": "subtitle", "time": 7503.669, "timestamp": "02:05:03", "text": "準備したいなら、"}, {"type": "subtitle", "time": 7505.99, "timestamp": "02:05:05", "text": "どこかの時点で、長い休息を取る必要がある。"}, {"type": "subtitle", "time": 7507.43, "timestamp": "02:05:07", "text": "私はすでに準備を済ませました"}, {"type": "subtitle", "time": 7509.589, "timestamp": "02:05:09", "text": "あなたが望むなら。"}, {"type": "subtitle", "time": 7511.99, "timestamp": "02:05:11", "text": "わからない"}, {"type": "subtitle", "time": 7514.31, "timestamp": "02:05:14", "text": "それは、蘇生が万が一の場合のためだからだ。"}, {"type": "subtitle", "time": 7516.55, "timestamp": "02:05:16", "text": "パーティーの誰かが死んで、"}, {"type": "subtitle", "time": 7518.47, "timestamp": "02:05:18", "text": "彼らを蘇生させることができる。"}, {"type": "subtitle", "time": 7521.589, "timestamp": "02:05:21", "text": "ああ、それはできますよ。はい。"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "待って、それはどこにあるの？呪文。"}, {"type": "subtitle", "time": 7526.87, "timestamp": "02:05:26", "text": "2階にあります。"}, {"type": "subtitle", "time": 7529.189, "timestamp": "02:05:29", "text": "これは第2レベルの呪文です。ああ、すみません。"}, {"type": "subtitle", "time": 7530.629, "timestamp": "02:05:30", "text": "3階。すみません、私の間違いでした。私は"}, {"type": "subtitle", "time": 7533.109, "timestamp": "02:05:33", "text": "とても混乱しています。私はそれを具体化したいんです。 2番"}, {"type": "subtitle", "time": 7533.669, "timestamp": "02:05:33", "text": "レベル。"}, {"type": "subtitle", "time": 7535.99, "timestamp": "02:05:35", "text": "すみません、私の間違いでした。私の脳は 私の脳は"}, {"type": "subtitle", "time": 7538.709, "timestamp": "02:05:38", "text": "動脈瘤を患っている。"}, {"type": "subtitle", "time": 7542.149, "timestamp": "02:05:42", "text": "昨夜はよく眠れませんでした。"}, {"type": "subtitle", "time": 7544.07, "timestamp": "02:05:44", "text": "忘れていました。私は午前9時に寝ました"}, {"type": "subtitle", "time": 7547.109, "timestamp": "02:05:47", "text": "朝、午前1時頃に目が覚めた。"}, {"type": "subtitle", "time": 7548.87, "timestamp": "02:05:48", "text": "午後に。"}, {"type": "subtitle", "time": 7549.43, "timestamp": "02:05:49", "text": "うん、"}, {"type": "subtitle", "time": 7552.31, "timestamp": "02:05:52", "text": "私もそう感じました。私は午後3時に目が覚めた。"}, {"type": "subtitle", "time": 7554.709, "timestamp": "02:05:54", "text": "気分。"}, {"type": "subtitle", "time": 7557.75, "timestamp": "02:05:57", "text": "レーンに行きましょう"}, {"type": "subtitle", "time": 7559.51, "timestamp": "02:05:59", "text": "ブーツよ、団結せよ。もちろんさ。"}]
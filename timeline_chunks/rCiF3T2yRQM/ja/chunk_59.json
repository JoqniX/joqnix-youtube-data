[{"type": "subtitle", "time": 3542.23, "timestamp": "00:59:02", "text": "このように伸びている部分"}, {"type": "subtitle", "time": 3543.589, "timestamp": "00:59:03", "text": "床はこちらです。それはまるで"}, {"type": "subtitle", "time": 3545.27, "timestamp": "00:59:05", "text": "筋肉組織とか、そういう類のもの。私は愛する"}, {"type": "subtitle", "time": 3546.309, "timestamp": "00:59:06", "text": "それらの。"}, {"type": "subtitle", "time": 3548.23, "timestamp": "00:59:08", "text": "受け取ってもいいですよ。"}, {"type": "subtitle", "time": 3548.63, "timestamp": "00:59:08", "text": "なんてこった。"}, {"type": "subtitle", "time": 3549.67, "timestamp": "00:59:09", "text": "ええ、どうぞご自由に。"}, {"type": "subtitle", "time": 3552.15, "timestamp": "00:59:12", "text": "ああ、神様。"}, {"type": "subtitle", "time": 3555.589, "timestamp": "00:59:15", "text": "何か転がすものはありますか？"}, {"type": "subtitle", "time": 3557.27, "timestamp": "00:59:17", "text": "あのね、知ってる？ロール。ください"}, {"type": "subtitle", "time": 3558.47, "timestamp": "00:59:18", "text": "生存。"}, {"type": "subtitle", "time": 3561.829, "timestamp": "00:59:21", "text": "ああ、神様。"}, {"type": "subtitle", "time": 3565.19, "timestamp": "00:59:25", "text": "生存判定を振ってくれ。はい、舐めましたね。"}, {"type": "subtitle", "time": 3567.75, "timestamp": "00:59:27", "text": "味は、"}, {"type": "subtitle", "time": 3569.829, "timestamp": "00:59:29", "text": "豚肉、でもそれ以外は、"}, {"type": "subtitle", "time": 3571.91, "timestamp": "00:59:31", "text": "あまり詳しく知らないんです。"}, {"type": "subtitle", "time": 3574.47, "timestamp": "00:59:34", "text": "剣でちょっと突っついてもいいですか？"}, {"type": "subtitle", "time": 3580.63, "timestamp": "00:59:40", "text": "軽く突っついてみてください。何かあったの？"}, {"type": "subtitle", "time": 3582.789, "timestamp": "00:59:42", "text": "それは反応します。まるでピクピクと痙攣するような感じ"}, {"type": "subtitle", "time": 3585.67, "timestamp": "00:59:45", "text": "少しはそうだけど、それ以外は特に何もない。うん。"}, {"type": "subtitle", "time": 3587.91, "timestamp": "00:59:47", "text": "できますか"}, {"type": "subtitle", "time": 3592.71, "timestamp": "00:59:52", "text": "試してみてもいいですか、えっと、[ __ ]、何ができるでしょうか"}, {"type": "subtitle", "time": 3594.87, "timestamp": "00:59:54", "text": "それは自然なことではない。"}, {"type": "subtitle", "time": 3599.589, "timestamp": "00:59:59", "text": "わからない。宗教。なんてこった。"}]
[{"type": "subtitle", "time": 11761.83, "timestamp": "03:16:01", "text": "の"}, {"type": "subtitle", "time": 11764.55, "timestamp": "03:16:04", "text": "これらの人たちは、彼らは"}, {"type": "subtitle", "time": 11766.63, "timestamp": "03:16:06", "text": "避けようとしても無駄だ。彼らはただ"}, {"type": "subtitle", "time": 11769.59, "timestamp": "03:16:09", "text": "受け取ってもあまり効果がないようだ"}, {"type": "subtitle", "time": 11770.63, "timestamp": "03:16:10", "text": "彼らと共に。"}, {"type": "subtitle", "time": 11772.71, "timestamp": "03:16:12", "text": "彼らはただ、ただリラックスしているだけです。"}, {"type": "subtitle", "time": 11780.55, "timestamp": "03:16:20", "text": "えーと"}, {"type": "subtitle", "time": 11789.51, "timestamp": "03:16:29", "text": "まるで竜の息吹のようだ。"}, {"type": "subtitle", "time": 11791.19, "timestamp": "03:16:31", "text": "私はそこにいた奴を攻撃した。ああ、"}, {"type": "subtitle", "time": 11793.83, "timestamp": "03:16:33", "text": "神。良い。 19."}, {"type": "subtitle", "time": 11796.309, "timestamp": "03:16:36", "text": "殴られた人は少なかった。ダメージロール。"}, {"type": "subtitle", "time": 11799.429, "timestamp": "03:16:39", "text": "よし。行く。低いロール。おお、ハイロールだ。"}, {"type": "subtitle", "time": 11802.87, "timestamp": "03:16:42", "text": "ああ、わかりました。よし。悪くないロールだ。そこには"}, {"type": "subtitle", "time": 11804.79, "timestamp": "03:16:44", "text": "あなたが行く。我々は損害を与えた。あなたが持っている"}, {"type": "subtitle", "time": 11808.469, "timestamp": "03:16:48", "text": "ダメージを与えることに成功しました。"}, {"type": "subtitle", "time": 11813.269, "timestamp": "03:16:53", "text": "わかった。えっと、そうすべきかな、そう感じると思う"}, {"type": "subtitle", "time": 11815.99, "timestamp": "03:16:55", "text": "まるで無駄だ。私はただ終わりにしようと思う"}, {"type": "subtitle", "time": 11817.51, "timestamp": "03:16:57", "text": "今度は私の番だ。私はしたくない、私は"}, {"type": "subtitle", "time": 11819.349, "timestamp": "03:16:59", "text": "私の神聖なる打撃を無駄にすべきではない"}]
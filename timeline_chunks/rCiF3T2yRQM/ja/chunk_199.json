[{"type": "subtitle", "time": 11942.309, "timestamp": "03:19:02", "text": "リラックスチャレンジで、とても嬉しいです"}, {"type": "subtitle", "time": 11944.309, "timestamp": "03:19:04", "text": "それと共に。"}, {"type": "subtitle", "time": 11945.75, "timestamp": "03:19:05", "text": "レナードにも感謝を伝えたい。私はしません"}, {"type": "subtitle", "time": 11947.91, "timestamp": "03:19:07", "text": "彼が今チャットをしているかどうか知りたい。"}, {"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "よし。どうすればいいですか？なぜ動けないのですか？おお"}, {"type": "subtitle", "time": 11951.99, "timestamp": "03:19:11", "text": "我が神よ。"}, {"type": "subtitle", "time": 11955.19, "timestamp": "03:19:15", "text": "そうそう。ああ、動けない。"}, {"type": "subtitle", "time": 11961.67, "timestamp": "03:19:21", "text": "それを買うのに十分なお金がありますか？"}, {"type": "subtitle", "time": 11962.15, "timestamp": "03:19:22", "text": "ああ、神様。"}, {"type": "subtitle", "time": 11963.269, "timestamp": "03:19:23", "text": "はい。"}, {"type": "subtitle", "time": 11963.91, "timestamp": "03:19:23", "text": "そして"}, {"type": "subtitle", "time": 11966.95, "timestamp": "03:19:26", "text": "ああ、それだ"}, {"type": "subtitle", "time": 11967.59, "timestamp": "03:19:27", "text": "どうすれば"}, {"type": "subtitle", "time": 11969.19, "timestamp": "03:19:29", "text": "あなたの持ち物は あなたの持ち物はすでに"}, {"type": "subtitle", "time": 11971.19, "timestamp": "03:19:31", "text": "チャルに魅了された。覚えてるよ、だって"}, {"type": "subtitle", "time": 11972.389, "timestamp": "03:19:32", "text": "決して削除しなかった。だから実際に"}, {"type": "subtitle", "time": 11974.63, "timestamp": "03:19:34", "text": "4番目のものをクリックするだけで"}, {"type": "subtitle", "time": 11977.83, "timestamp": "03:19:37", "text": "えっと、挑戦してみます。待って、選択する必要がある"}, {"type": "subtitle", "time": 11978.95, "timestamp": "03:19:38", "text": "ターゲットまたは"}, {"type": "subtitle", "time": 11981.83, "timestamp": "03:19:41", "text": "うん。えーと、ただ単に"}, {"type": "subtitle", "time": 11983.429, "timestamp": "03:19:43", "text": "対象を選択しません。そうだね、"}, {"type": "subtitle", "time": 11985.19, "timestamp": "03:19:45", "text": "はい、どうぞ。それを証明してみせます。"}, {"type": "subtitle", "time": 11987.99, "timestamp": "03:19:47", "text": "ええと、それを明かしましょう。わかった。よし。"}, {"type": "subtitle", "time": 11989.51, "timestamp": "03:19:49", "text": "すぐにダメージロールしてください"}, {"type": "subtitle", "time": 11990.95, "timestamp": "03:19:50", "text": "これは壁です。"}, {"type": "subtitle", "time": 11993.349, "timestamp": "03:19:53", "text": "よし。うん。ダメージロール。"}, {"type": "subtitle", "time": 11994.95, "timestamp": "03:19:54", "text": "普通。"}, {"type": "subtitle", "time": 11996.79, "timestamp": "03:19:56", "text": "わかった。よし。私は好きになるつもりです"}, {"type": "subtitle", "time": 11999.67, "timestamp": "03:19:59", "text": "明らかにする、だってまだ"}]
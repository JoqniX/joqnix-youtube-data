[{"type": "subtitle", "time": 7080.55, "timestamp": "01:58:00", "text": "それはまるで肉体のようだ。積極的に"}, {"type": "subtitle", "time": 7081.83, "timestamp": "01:58:01", "text": "これを手に入れる、ほら、ほら、"}, {"type": "subtitle", "time": 7085.189, "timestamp": "01:58:05", "text": "喉の動きが"}, {"type": "subtitle", "time": 7086.709, "timestamp": "01:58:06", "text": "食べ物を下に落とそうとするときに"}, {"type": "subtitle", "time": 7088.07, "timestamp": "01:58:08", "text": "あなたの胃。まあ、そんな感じですね。"}, {"type": "subtitle", "time": 7090.229, "timestamp": "01:58:10", "text": "それはまるであなたを動かそうとしているようなものです"}, {"type": "subtitle", "time": 7092.629, "timestamp": "01:58:12", "text": "ゆっくり。あなたはそれに抵抗できる。ただ"}, {"type": "subtitle", "time": 7094.87, "timestamp": "01:58:14", "text": "ああ、それがアクティブの時は、"}, {"type": "subtitle", "time": 7096.39, "timestamp": "01:58:16", "text": "雨が降るのは難しい、"}, {"type": "subtitle", "time": 7099.75, "timestamp": "01:58:19", "text": "兄弟。これは消化器系です。"}, {"type": "subtitle", "time": 7101.27, "timestamp": "01:58:21", "text": "うん。ヴァンの方を向いて、"}, {"type": "subtitle", "time": 7103.51, "timestamp": "01:58:23", "text": "これは口だ、という感じ。私たちは"}, {"type": "subtitle", "time": 7110.149, "timestamp": "01:58:30", "text": "まあ、私たちにできることはただ行くことだけです"}, {"type": "subtitle", "time": 7115.83, "timestamp": "01:58:35", "text": "夜。"}, {"type": "subtitle", "time": 7120.79, "timestamp": "01:58:40", "text": "こんにちは。"}, {"type": "subtitle", "time": 7124.07, "timestamp": "01:58:44", "text": "はい。悲鳴。"}, {"type": "subtitle", "time": 7125.91, "timestamp": "01:58:45", "text": "座ると、"}, {"type": "subtitle", "time": 7129.669, "timestamp": "01:58:49", "text": "まるで自ら動くかのように。必要なのは"}, {"type": "subtitle", "time": 7132.87, "timestamp": "01:58:52", "text": "わかった。 T. それはまるで"}, {"type": "subtitle", "time": 7138.47, "timestamp": "01:58:58", "text": "ごめん。それを動かしたのは私です。"}]
[{"type": "subtitle", "time": 3241.27, "timestamp": "00:54:01", "text": "知ってる、ここはまるで"}, {"type": "subtitle", "time": 3243.75, "timestamp": "00:54:03", "text": "ここには何もない。かなりきれいだ。それ"}, {"type": "subtitle", "time": 3246.309, "timestamp": "00:54:06", "text": "流血か汚泥があったようだ"}, {"type": "subtitle", "time": 3249.67, "timestamp": "00:54:09", "text": "クソ、どう考えても、そこに"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "戦いだったけど、今はかなり"}, {"type": "subtitle", "time": 3253.75, "timestamp": "00:54:13", "text": "クリーン。"}, {"type": "subtitle", "time": 3256.309, "timestamp": "00:54:16", "text": "これはスライムだと思う"}, {"type": "subtitle", "time": 3258.069, "timestamp": "00:54:18", "text": "彼らが話していた部屋"}, {"type": "subtitle", "time": 3260.39, "timestamp": "00:54:20", "text": "少し前のことです。"}, {"type": "chat", "time": 3261.245, "timestamp": "00:54:21", "author": "@KripalNishad-ze8rb", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nINduFEoqdR9Ur9aH5Wjyys_h6Cvr5JLOUK2d9YuckXV4H-eJ2TUNvqVabpPDyQcaEZw=s64-c-k-c0x00ffffff-no-rj", "message": "❤"}, {"type": "subtitle", "time": 3264.309, "timestamp": "00:54:24", "text": "とても美味しかった。ライムのような味がする。"}, {"type": "chat", "time": 3264.454, "timestamp": "00:54:24", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Kripal Nishad~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 3267.51, "timestamp": "00:54:27", "text": "テックさん、ありがとうございます。"}, {"type": "subtitle", "time": 3276.87, "timestamp": "00:54:36", "text": "ええと、道はありますよね"}, {"type": "subtitle", "time": 3278.23, "timestamp": "00:54:38", "text": "ここ。"}, {"type": "subtitle", "time": 3283.43, "timestamp": "00:54:43", "text": "ただ見ていただけです。ごめん、"}, {"type": "subtitle", "time": 3284.069, "timestamp": "00:54:44", "text": "彼女が来る。"}, {"type": "subtitle", "time": 3285.43, "timestamp": "00:54:45", "text": "本当に探しているのですか、それとも"}, {"type": "subtitle", "time": 3288.309, "timestamp": "00:54:48", "text": "別のスライムを探して試してみよう"}, {"type": "subtitle", "time": 3289.99, "timestamp": "00:54:49", "text": "いいえ、"}, {"type": "subtitle", "time": 3292.069, "timestamp": "00:54:52", "text": "彼女は前進するだろう"}, {"type": "subtitle", "time": 3294.15, "timestamp": "00:54:54", "text": "速い。"}, {"type": "subtitle", "time": 3295.91, "timestamp": "00:54:55", "text": "ああ、神様。わかった。うん。"}, {"type": "subtitle", "time": 3296.71, "timestamp": "00:54:56", "text": "大丈夫ですか？"}, {"type": "subtitle", "time": 3298.309, "timestamp": "00:54:58", "text": "この部屋で。うん。"}]
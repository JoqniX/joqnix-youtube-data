[{"type": "subtitle", "time": 4863.75, "timestamp": "01:21:03", "text": "それでおしまい。うん。えっと、私の"}, {"type": "subtitle", "time": 4865.27, "timestamp": "01:21:05", "text": "他に何もなければ？"}, {"type": "subtitle", "time": 4866.07, "timestamp": "01:21:06", "text": "うん。"}, {"type": "subtitle", "time": 4869.99, "timestamp": "01:21:09", "text": "わかった。"}, {"type": "subtitle", "time": 4873.75, "timestamp": "01:21:13", "text": "えっと、ロープを引っ張ってみてもいいですか？"}, {"type": "subtitle", "time": 4875.99, "timestamp": "01:21:15", "text": "ヴァンは今、"}, {"type": "subtitle", "time": 4876.79, "timestamp": "01:21:16", "text": "ヤンクを手伝う？"}, {"type": "subtitle", "time": 4879.27, "timestamp": "01:21:19", "text": "私ならできます。"}, {"type": "subtitle", "time": 4880.63, "timestamp": "01:21:20", "text": "もちろん。欲しいですか"}, {"type": "subtitle", "time": 4881.91, "timestamp": "01:21:21", "text": "運動能力チェック？"}, {"type": "subtitle", "time": 4882.87, "timestamp": "01:21:22", "text": "陸上競技？"}, {"type": "subtitle", "time": 4883.51, "timestamp": "01:21:23", "text": "ええ、大丈夫です。"}, {"type": "subtitle", "time": 4884.55, "timestamp": "01:21:24", "text": "有利な立場にある。"}, {"type": "subtitle", "time": 4886.63, "timestamp": "01:21:26", "text": "実際、陸上競技の方が有利だ。"}, {"type": "subtitle", "time": 4888.709, "timestamp": "01:21:28", "text": "わかった。うん、それは確かに引っ張る"}, {"type": "subtitle", "time": 4891.51, "timestamp": "01:21:31", "text": "出て行け。よし、魚を引っ張って"}, {"type": "subtitle", "time": 4899.91, "timestamp": "01:21:39", "text": "まるでアリアナが釣りをしたみたいだ"}, {"type": "subtitle", "time": 4902.07, "timestamp": "01:21:42", "text": "バンが購入されました。"}, {"type": "subtitle", "time": 4905.189, "timestamp": "01:21:45", "text": "うん。"}, {"type": "subtitle", "time": 4908.07, "timestamp": "01:21:48", "text": "よし。他に何かありますか？"}, {"type": "subtitle", "time": 4910.79, "timestamp": "01:21:50", "text": "えっと、ティック、大丈夫？何か必要ですか？"}, {"type": "subtitle", "time": 4912.709, "timestamp": "01:21:52", "text": "助けも必要ですか？"}, {"type": "subtitle", "time": 4914.709, "timestamp": "01:21:54", "text": "ティックならきっと解決してくれるだろう。心配しないで。"}, {"type": "subtitle", "time": 4919.11, "timestamp": "01:21:59", "text": "ティックは賢い。ティックは悪態をつく。"}]
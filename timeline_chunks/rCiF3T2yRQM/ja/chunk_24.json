[{"type": "subtitle", "time": 1440.87, "timestamp": "00:24:00", "text": "大好きです。"}, {"type": "subtitle", "time": 1444.149, "timestamp": "00:24:04", "text": "わかった。技術的な詳細。"}, {"type": "subtitle", "time": 1445.51, "timestamp": "00:24:05", "text": "わかった。技術的なことはすべて"}, {"type": "subtitle", "time": 1448.39, "timestamp": "00:24:08", "text": "困難。よし。ええ、もちろん。私は"}, {"type": "subtitle", "time": 1449.909, "timestamp": "00:24:09", "text": "あなたをそこから移動させようとしています"}, {"type": "subtitle", "time": 1451.51, "timestamp": "00:24:11", "text": "シーンを撮影してから、あなたを元の場所に戻します。させて"}, {"type": "subtitle", "time": 1453.669, "timestamp": "00:24:13", "text": "私にはわかる。つまり、待機に戻ると"}, {"type": "subtitle", "time": 1455.59, "timestamp": "00:24:15", "text": "部屋に移動できますか？"}, {"type": "subtitle", "time": 1457.75, "timestamp": "00:24:17", "text": "ああ、見て。爽快だ。"}, {"type": "subtitle", "time": 1460.31, "timestamp": "00:24:20", "text": "ああ、わかりました。わかった。うん。よし。ただ"}, {"type": "subtitle", "time": 1463.029, "timestamp": "00:24:23", "text": "そこに何があるのか​​教えてください。"}, {"type": "subtitle", "time": 1468.95, "timestamp": "00:24:28", "text": "理由を教えてください。"}, {"type": "subtitle", "time": 1477.5, "timestamp": "00:24:37", "text": "そして5番目。"}, {"type": "subtitle", "time": 1479.99, "timestamp": "00:24:39", "text": "[音楽]"}, {"type": "subtitle", "time": 1486.07, "timestamp": "00:24:46", "text": "あなたは私がそう望んでいると言う。"}, {"type": "subtitle", "time": 1487.909, "timestamp": "00:24:47", "text": "5番目。 5番目。私の"}, {"type": "subtitle", "time": 1489.43, "timestamp": "00:24:49", "text": "兄弟。"}, {"type": "subtitle", "time": 1491.75, "timestamp": "00:24:51", "text": "復活です。"}, {"type": "subtitle", "time": 1493.19, "timestamp": "00:24:53", "text": "何てことだ。"}]
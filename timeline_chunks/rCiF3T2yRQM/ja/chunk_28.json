[{"type": "subtitle", "time": 1680.149, "timestamp": "00:28:00", "text": "出発前にやらなければならないことは何もない"}, {"type": "subtitle", "time": 1682.95, "timestamp": "00:28:02", "text": "下？あなたは"}, {"type": "subtitle", "time": 1685.909, "timestamp": "00:28:05", "text": "前回のヴァンに譲歩したのと同じように"}, {"type": "subtitle", "time": 1688.47, "timestamp": "00:28:08", "text": "時間？\""}, {"type": "subtitle", "time": 1692.63, "timestamp": "00:28:12", "text": "念のため、先に持って行きます。"}, {"type": "subtitle", "time": 1694.149, "timestamp": "00:28:14", "text": "トラウマ。よし。"}, {"type": "subtitle", "time": 1696.71, "timestamp": "00:28:16", "text": "私たちは歩き回ることからトラウマを抱えています"}, {"type": "subtitle", "time": 1699.59, "timestamp": "00:28:19", "text": "部屋。わかった。"}, {"type": "subtitle", "time": 1701.43, "timestamp": "00:28:21", "text": "石を拾って、それから"}, {"type": "subtitle", "time": 1704.23, "timestamp": "00:28:24", "text": "それを口に入れなさい。"}, {"type": "subtitle", "time": 1706.23, "timestamp": "00:28:26", "text": "どんな味がするの？"}, {"type": "subtitle", "time": 1707.59, "timestamp": "00:28:27", "text": "岩のような味がする"}, {"type": "subtitle", "time": 1707.99, "timestamp": "00:28:27", "text": "今。"}, {"type": "subtitle", "time": 1709.35, "timestamp": "00:28:29", "text": "美味しい。"}, {"type": "subtitle", "time": 1710.95, "timestamp": "00:28:30", "text": "素晴らしい。"}, {"type": "subtitle", "time": 1712.23, "timestamp": "00:28:32", "text": "アリアナは振り返って見る"}, {"type": "subtitle", "time": 1713.669, "timestamp": "00:28:33", "text": "ティックに「"}, {"type": "subtitle", "time": 1715.78, "timestamp": "00:28:35", "text": "付与された。\""}, {"type": "subtitle", "time": 1718.31, "timestamp": "00:28:38", "text": "[拍手]"}, {"type": "subtitle", "time": 1719.35, "timestamp": "00:28:39", "text": "何てことだ。"}, {"type": "subtitle", "time": 1721.99, "timestamp": "00:28:41", "text": "そのパンは精神的なダメージを受けている。"}, {"type": "subtitle", "time": 1725.029, "timestamp": "00:28:45", "text": "精神的ダメージ。"}, {"type": "subtitle", "time": 1725.83, "timestamp": "00:28:45", "text": "何てことだ。"}, {"type": "subtitle", "time": 1731.51, "timestamp": "00:28:51", "text": "わかった。"}, {"type": "subtitle", "time": 1734.87, "timestamp": "00:28:54", "text": "その石をアリアナに渡してあげて。"}, {"type": "subtitle", "time": 1736.07, "timestamp": "00:28:56", "text": "彼らはそれを彼らの"}, {"type": "subtitle", "time": 1738.63, "timestamp": "00:28:58", "text": "口に含んで差し出す。"}]
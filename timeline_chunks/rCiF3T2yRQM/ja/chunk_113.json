[{"type": "subtitle", "time": 6780.149, "timestamp": "01:53:00", "text": "まさに肉感的な部屋に入りたい。"}, {"type": "subtitle", "time": 6783.27, "timestamp": "01:53:03", "text": "さあ、あなたのやりたいことをやりましょう"}, {"type": "subtitle", "time": 6785.43, "timestamp": "01:53:05", "text": "試してみようと思うんだけど"}, {"type": "subtitle", "time": 6786.709, "timestamp": "01:53:06", "text": "私は、"}, {"type": "subtitle", "time": 6788.709, "timestamp": "01:53:08", "text": "肉体の部屋。"}, {"type": "subtitle", "time": 6790.87, "timestamp": "01:53:10", "text": "ジョー、君はどう？肉が好きですか？"}, {"type": "subtitle", "time": 6793.35, "timestamp": "01:53:13", "text": "部屋？欲しいですか"}, {"type": "subtitle", "time": 6794.709, "timestamp": "01:53:14", "text": "持ち帰り？"}, {"type": "subtitle", "time": 6797.91, "timestamp": "01:53:17", "text": "いいえ、私はただあなたたちについていきます。"}, {"type": "subtitle", "time": 6799.669, "timestamp": "01:53:19", "text": "偉大なる肉体の部屋。うん、"}, {"type": "subtitle", "time": 6802.229, "timestamp": "01:53:22", "text": "肉の部屋。えっと、私たちは行くと思います"}, {"type": "subtitle", "time": 6802.79, "timestamp": "01:53:22", "text": "単に"}, {"type": "subtitle", "time": 6805.91, "timestamp": "01:53:25", "text": "壁はそうする。壁の色が合っていない。"}, {"type": "subtitle", "time": 6807.35, "timestamp": "01:53:27", "text": "具体的にはこちら側です。それは間違いなく"}, {"type": "subtitle", "time": 6809.03, "timestamp": "01:53:29", "text": "一致しません。"}, {"type": "subtitle", "time": 6810.47, "timestamp": "01:53:30", "text": "えっと、"}, {"type": "subtitle", "time": 6812.07, "timestamp": "01:53:32", "text": "タップしてもいいですか？"}, {"type": "subtitle", "time": 6815.43, "timestamp": "01:53:35", "text": "それをタップします。そして、ここには何かがある。"}, {"type": "subtitle", "time": 6818.07, "timestamp": "01:53:38", "text": "押すだけで開きます。"}, {"type": "subtitle", "time": 6819.43, "timestamp": "01:53:39", "text": "ああ、ループバックしそうだ"}, {"type": "subtitle", "time": 6821.43, "timestamp": "01:53:41", "text": "また戻ってきた。"}, {"type": "subtitle", "time": 6824.229, "timestamp": "01:53:44", "text": "待って、私はただ持ってきます"}, {"type": "subtitle", "time": 6826.95, "timestamp": "01:53:46", "text": "これをここに持ってきてください。今のところ、えーと、"}, {"type": "subtitle", "time": 6829.189, "timestamp": "01:53:49", "text": "クリスピンは行き詰まりに陥る。"}, {"type": "subtitle", "time": 6831.51, "timestamp": "01:53:51", "text": "ああ、軽く叩いてくれますか？"}, {"type": "subtitle", "time": 6833.83, "timestamp": "01:53:53", "text": "タップする、まるでタップするように。えっと、まあ、"}, {"type": "subtitle", "time": 6835.43, "timestamp": "01:53:55", "text": "彼はちょっとやり過ぎだと思う。押す"}, {"type": "subtitle", "time": 6837.75, "timestamp": "01:53:57", "text": "やりすぎだ。こっち側です。"}]
[{"type": "subtitle", "time": 3483.109, "timestamp": "00:58:03", "text": "怪しい食べ物。怪しいダンジョン"}, {"type": "subtitle", "time": 3484.71, "timestamp": "00:58:04", "text": "食べ物。"}, {"type": "subtitle", "time": 3488.309, "timestamp": "00:58:08", "text": "ええと、2回です。はい、どうぞ。"}, {"type": "subtitle", "time": 3489.03, "timestamp": "00:58:09", "text": "よし、これでいい。"}, {"type": "subtitle", "time": 3490.63, "timestamp": "00:58:10", "text": "わかった。"}, {"type": "subtitle", "time": 3492.309, "timestamp": "00:58:12", "text": "とりあえず、リストに入れておきます。"}, {"type": "subtitle", "time": 3493.03, "timestamp": "00:58:13", "text": "うん。"}, {"type": "subtitle", "time": 3495.19, "timestamp": "00:58:15", "text": "よし。うん。サスダンジョンを設置しよう"}, {"type": "subtitle", "time": 3501.67, "timestamp": "00:58:21", "text": "よし。それでは、このまま続けますか？"}, {"type": "subtitle", "time": 3502.309, "timestamp": "00:58:22", "text": "うん。"}, {"type": "subtitle", "time": 3504.549, "timestamp": "00:58:24", "text": "他にここでやることはなさそうだ。"}, {"type": "subtitle", "time": 3506.15, "timestamp": "00:58:26", "text": "まあいいか。"}, {"type": "subtitle", "time": 3507.349, "timestamp": "00:58:27", "text": "わかった。"}, {"type": "subtitle", "time": 3508.95, "timestamp": "00:58:28", "text": "換気口がないことを本当に願っています"}, {"type": "subtitle", "time": 3510.63, "timestamp": "00:58:30", "text": "あのバッグ。食べ物が"}, {"type": "subtitle", "time": 3512.71, "timestamp": "00:58:32", "text": "出て行った。"}, {"type": "subtitle", "time": 3516.309, "timestamp": "00:58:36", "text": "その考えは、私にとって本当に恐ろしいものです。"}, {"type": "subtitle", "time": 3519.75, "timestamp": "00:58:39", "text": "二度とそんなことを言わないでください。"}, {"type": "subtitle", "time": 3520.549, "timestamp": "00:58:40", "text": "まあ。"}, {"type": "subtitle", "time": 3523.349, "timestamp": "00:58:43", "text": "もうティックが大好き！"}, {"type": "subtitle", "time": 3525.589, "timestamp": "00:58:45", "text": "あのね、知ってる？あなたは好きなものを愛することができる"}, {"type": "subtitle", "time": 3527.27, "timestamp": "00:58:47", "text": "欲しい。"}, {"type": "subtitle", "time": 3528.549, "timestamp": "00:58:48", "text": "ああ、彫像。"}, {"type": "subtitle", "time": 3529.99, "timestamp": "00:58:49", "text": "約束はできません。"}, {"type": "subtitle", "time": 3531.829, "timestamp": "00:58:51", "text": "こちらです。たくさんの彫像が見える"}, {"type": "subtitle", "time": 3533.75, "timestamp": "00:58:53", "text": "こちらにも同じ人物が描かれている。 1つ"}, {"type": "subtitle", "time": 3535.589, "timestamp": "00:58:55", "text": "像のいくつかは倒された。"}, {"type": "subtitle", "time": 3537.349, "timestamp": "00:58:57", "text": "そして像の下、その下から、"}, {"type": "subtitle", "time": 3539.51, "timestamp": "00:58:59", "text": "肉厚なものがたくさん見える"}]
[{"type": "subtitle", "time": 2285.829, "timestamp": "00:38:05", "text": "あのね？えっと"}, {"type": "subtitle", "time": 2295.19, "timestamp": "00:38:15", "text": "私はただ長く過ごすつもりです"}, {"type": "subtitle", "time": 2295.829, "timestamp": "00:38:15", "text": "のように、"}, {"type": "subtitle", "time": 2299.19, "timestamp": "00:38:19", "text": "「私がそうすべきではないと言ったらどうですか？」"}, {"type": "subtitle", "time": 2301.75, "timestamp": "00:38:21", "text": "人間の死体や"}, {"type": "subtitle", "time": 2305.109, "timestamp": "00:38:25", "text": "モンスター。そうではありません"}, {"type": "subtitle", "time": 2306.87, "timestamp": "00:38:26", "text": "岩石とは違う。岩はあなたにとって硬い"}, {"type": "subtitle", "time": 2310.31, "timestamp": "00:38:30", "text": "噛み切れないが、柔らかいので食べるのをやめてください。"}, {"type": "subtitle", "time": 2312.63, "timestamp": "00:38:32", "text": "私はあまり好きではない"}, {"type": "subtitle", "time": 2315.43, "timestamp": "00:38:35", "text": "床。ジョック、君はどう？あなたは欲しい"}, {"type": "subtitle", "time": 2318.55, "timestamp": "00:38:38", "text": "床に落ちているゼリー状のものを食べる？"}, {"type": "subtitle", "time": 2320.87, "timestamp": "00:38:40", "text": "いいえ。"}, {"type": "subtitle", "time": 2322.71, "timestamp": "00:38:42", "text": "床に落ちたものを食べてはいけません。"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "もっと良くなれ。"}, {"type": "subtitle", "time": 2330.71, "timestamp": "00:38:50", "text": "何てことだ。"}, {"type": "subtitle", "time": 2338.63, "timestamp": "00:38:58", "text": "ドア。間違いない。"}]
[{"type": "subtitle", "time": 12123.349, "timestamp": "03:22:03", "text": "おお、"}, {"type": "subtitle", "time": 12126.309, "timestamp": "03:22:06", "text": "スライムを石で叩き潰さなきゃ。"}, {"type": "subtitle", "time": 12128.71, "timestamp": "03:22:08", "text": "与えるなら、与えないで"}, {"type": "subtitle", "time": 12131.59, "timestamp": "03:22:11", "text": "Tは石を食べるだけです。"}, {"type": "subtitle", "time": 12135.99, "timestamp": "03:22:15", "text": "魔法の石に餌を与えないでください。"}, {"type": "subtitle", "time": 12137.75, "timestamp": "03:22:17", "text": "よし。他に何か？そうでない場合は、攻撃する"}, {"type": "subtitle", "time": 12138.55, "timestamp": "03:22:18", "text": "彼ら。"}, {"type": "subtitle", "time": 12140.79, "timestamp": "03:22:20", "text": "はい、これで終わりです。"}, {"type": "subtitle", "time": 12142.55, "timestamp": "03:22:22", "text": "攻撃される。"}, {"type": "subtitle", "time": 12144.95, "timestamp": "03:22:24", "text": "またスライムまみれになるぞ。"}, {"type": "subtitle", "time": 12147.67, "timestamp": "03:22:27", "text": "よし、アリアナ、準備して"}, {"type": "subtitle", "time": 12149.51, "timestamp": "03:22:29", "text": "ぬるぬるした。"}, {"type": "subtitle", "time": 12152.15, "timestamp": "03:22:32", "text": "よし、そうしよう。ああ、美しい。"}, {"type": "subtitle", "time": 12155.19, "timestamp": "03:22:35", "text": "それが1つ目です。わかった。そして、"}, {"type": "subtitle", "time": 12157.03, "timestamp": "03:22:37", "text": "他のスライムと同様に、それは引き寄せます"}, {"type": "subtitle", "time": 12159.269, "timestamp": "03:22:39", "text": "伸びる粘液のような"}, {"type": "subtitle", "time": 12163.11, "timestamp": "03:22:43", "text": "それはそれであり、あなたを攻撃します。"}, {"type": "subtitle", "time": 12165.269, "timestamp": "03:22:45", "text": "私にやらせてください。わかった。ああ、それは"}, {"type": "subtitle", "time": 12166.389, "timestamp": "03:22:46", "text": "批評。"}, {"type": "subtitle", "time": 12169.19, "timestamp": "03:22:49", "text": "よし、これは批評だ。何てことだ。全て"}, {"type": "subtitle", "time": 12170.63, "timestamp": "03:22:50", "text": "右。"}, {"type": "subtitle", "time": 12172.95, "timestamp": "03:22:52", "text": "わかった。えっと、"}, {"type": "subtitle", "time": 12177.91, "timestamp": "03:22:57", "text": "わかった。本当に本当に大きな頭。これ"}]
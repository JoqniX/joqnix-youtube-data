[{"type": "subtitle", "time": 2404.31, "timestamp": "00:40:04", "text": "あなたは私たちのことをよく知っていますよね。他の連中。"}, {"type": "subtitle", "time": 2411.99, "timestamp": "00:40:11", "text": "誰かが部屋の表面について言っている。"}, {"type": "subtitle", "time": 2413.99, "timestamp": "00:40:13", "text": "それはひどい人物だ。"}, {"type": "subtitle", "time": 2415.99, "timestamp": "00:40:15", "text": "ハウスキーピング。"}, {"type": "subtitle", "time": 2418.87, "timestamp": "00:40:18", "text": "まるで私たちを知っているかのように、それが私たちだと認識させてください。"}, {"type": "subtitle", "time": 2420.79, "timestamp": "00:40:20", "text": "マスターロータスは、君たちが"}, {"type": "subtitle", "time": 2423.349, "timestamp": "00:40:23", "text": "私たちは自分たちが何者であるかを忘れてはならない。"}, {"type": "subtitle", "time": 2429.03, "timestamp": "00:40:29", "text": "えっと、マスター・ロータスは面白いジョークを知っていますか？"}, {"type": "subtitle", "time": 2436.069, "timestamp": "00:40:36", "text": "残念な。"}, {"type": "subtitle", "time": 2439.349, "timestamp": "00:40:39", "text": "ちょうど、えっと、彼女は覚えている"}, {"type": "subtitle", "time": 2441.43, "timestamp": "00:40:41", "text": "パーティーに行くみたいだから、彼女は行くつもりだと思う"}, {"type": "subtitle", "time": 2443.349, "timestamp": "00:40:43", "text": "それを開けるために。彼女はただ言うだけだ"}, {"type": "subtitle", "time": 2444.87, "timestamp": "00:40:44", "text": "おそらく誰もが"}, {"type": "subtitle", "time": 2447.43, "timestamp": "00:40:47", "text": "眠っている。彼女は「みんな、私は"}, {"type": "subtitle", "time": 2450.069, "timestamp": "00:40:50", "text": "ドアを開けてください。もし彼らが"}, {"type": "subtitle", "time": 2451.829, "timestamp": "00:40:51", "text": "攻撃してくるかもしれないけど、心配しないで。殺す"}, {"type": "subtitle", "time": 2454.55, "timestamp": "00:40:54", "text": "彼ら。"}, {"type": "subtitle", "time": 2456.15, "timestamp": "00:40:56", "text": "彼女はバリケードを外すだけで"}, {"type": "subtitle", "time": 2458.95, "timestamp": "00:40:58", "text": "開ける。まるで、「こんにちは」って感じ。"}]
[{"type": "subtitle", "time": 1500.31, "timestamp": "00:25:00", "text": "まあ。"}, {"type": "subtitle", "time": 1502.47, "timestamp": "00:25:02", "text": "生活費。"}, {"type": "subtitle", "time": 1505.51, "timestamp": "00:25:05", "text": "私は当然知っている？いつも数回"}, {"type": "subtitle", "time": 1507.51, "timestamp": "00:25:07", "text": "そのミームは毎月必ず出てくる"}, {"type": "subtitle", "time": 1508.31, "timestamp": "00:25:08", "text": "ランダムに。"}, {"type": "subtitle", "time": 1510.87, "timestamp": "00:25:10", "text": "ああ、グリムならもう動かせるよ。私は"}, {"type": "subtitle", "time": 1512.63, "timestamp": "00:25:12", "text": "待合室に置いたので、今は動かすことができます。"}, {"type": "subtitle", "time": 1514.07, "timestamp": "00:25:14", "text": "ああ、わかりました。動かすことができます。はい、では"}, {"type": "subtitle", "time": 1516.39, "timestamp": "00:25:16", "text": "別のシーンに戻ってください。活性化。"}, {"type": "subtitle", "time": 1520.549, "timestamp": "00:25:20", "text": "ええと、わかりました。今からここに引っ越します。"}, {"type": "subtitle", "time": 1522.71, "timestamp": "00:25:22", "text": "ミクの帽子。"}, {"type": "subtitle", "time": 1524.87, "timestamp": "00:25:24", "text": "何てことだ。"}, {"type": "subtitle", "time": 1527.909, "timestamp": "00:25:27", "text": "ミク夫人。"}, {"type": "subtitle", "time": 1530.95, "timestamp": "00:25:30", "text": "ああ、そうそう。さあ、あなたは今ここにいます。全て"}, {"type": "subtitle", "time": 1532.549, "timestamp": "00:25:32", "text": "右。それでは、トーチをお返しします。"}, {"type": "subtitle", "time": 1533.43, "timestamp": "00:25:33", "text": "そこにトーチがある。"}, {"type": "subtitle", "time": 1536.63, "timestamp": "00:25:36", "text": "はい、あなたは再び見えるようになります。"}, {"type": "subtitle", "time": 1539.669, "timestamp": "00:25:39", "text": "ああ、なんてことだ、私たちにはビジョンがある。私も"}, {"type": "subtitle", "time": 1542.71, "timestamp": "00:25:42", "text": "一ついただけますか？念のため。"}, {"type": "subtitle", "time": 1543.11, "timestamp": "00:25:43", "text": "よし、"}, {"type": "subtitle", "time": 1544.87, "timestamp": "00:25:44", "text": "念のため。"}, {"type": "subtitle", "time": 1548.149, "timestamp": "00:25:48", "text": "万が一負けたらアリアナも失うし"}, {"type": "subtitle", "time": 1550.39, "timestamp": "00:25:50", "text": "私は神に目がくらんでいる。"}, {"type": "subtitle", "time": 1551.43, "timestamp": "00:25:51", "text": "はい、どうぞ。"}, {"type": "subtitle", "time": 1553.83, "timestamp": "00:25:53", "text": "盲目になる"}, {"type": "subtitle", "time": 1554.95, "timestamp": "00:25:54", "text": "ありがとう。"}, {"type": "subtitle", "time": 1556.39, "timestamp": "00:25:56", "text": "ええ、私は私ではありません"}, {"type": "subtitle", "time": 1557.83, "timestamp": "00:25:57", "text": "君の目をくらませたんだ。それは状況による"}, {"type": "subtitle", "time": 1559.35, "timestamp": "00:25:59", "text": "君の目をくらませたんだ。"}]
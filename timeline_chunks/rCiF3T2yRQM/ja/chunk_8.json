[{"type": "subtitle", "time": 481.189, "timestamp": "00:08:01", "text": "何てことだ。"}, {"type": "subtitle", "time": 483.51, "timestamp": "00:08:03", "text": "頭から突っ込んでくる。ただ"}, {"type": "subtitle", "time": 491.11, "timestamp": "00:08:11", "text": "あれがあなたの方へ向かってきます。ただ横になるだけ"}, {"type": "subtitle", "time": 493.83, "timestamp": "00:08:13", "text": "下。深呼吸をしてください。閉じる"}, {"type": "subtitle", "time": 496.39, "timestamp": "00:08:16", "text": "目。"}, {"type": "subtitle", "time": 497.749, "timestamp": "00:08:17", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 506.07, "timestamp": "00:08:26", "text": "考え。あなたは死ぬだけ"}, {"type": "subtitle", "time": 516.949, "timestamp": "00:08:36", "text": "こんにちは。ようこそ。ようこそ。こんにちは。"}, {"type": "subtitle", "time": 518.149, "timestamp": "00:08:38", "text": "何てことだ。"}, {"type": "subtitle", "time": 520.63, "timestamp": "00:08:40", "text": "こんにちは。皆さん、こんばんは。"}, {"type": "subtitle", "time": 521.75, "timestamp": "00:08:41", "text": "まあ。"}, {"type": "subtitle", "time": 524.389, "timestamp": "00:08:44", "text": "こんばんは。それでは、皆さん、ようこそ。"}, {"type": "subtitle", "time": 525.91, "timestamp": "00:08:45", "text": "わーい。"}, {"type": "subtitle", "time": 527.19, "timestamp": "00:08:47", "text": "これが実際にもっと速く読み込まれることを願っています"}, {"type": "subtitle", "time": 528.15, "timestamp": "00:08:48", "text": "なぜなら私は実際にたくさん"}, {"type": "subtitle", "time": 531.03, "timestamp": "00:08:51", "text": "最適化。そのため、レベルは多くのものをロードします"}, {"type": "subtitle", "time": 532.389, "timestamp": "00:08:52", "text": "前回よりも速かった。"}, {"type": "subtitle", "time": 533.91, "timestamp": "00:08:53", "text": "読み込みがすごく速かった。"}, {"type": "subtitle", "time": 535.43, "timestamp": "00:08:55", "text": "Y"}, {"type": "subtitle", "time": 539.509, "timestamp": "00:08:59", "text": "さあ行こう。私の作戦はうまくいった。これは"}]
[{"type": "subtitle", "time": 1143.909, "timestamp": "00:19:03", "text": "知ってるよ、えっと、Bだよ。スラッシュBR 3D 100だよ。"}, {"type": "subtitle", "time": 1147.35, "timestamp": "00:19:07", "text": "うん。わかった。"}, {"type": "subtitle", "time": 1149.19, "timestamp": "00:19:09", "text": "別の政党は大きな問題を抱えていた"}, {"type": "subtitle", "time": 1152.23, "timestamp": "00:19:12", "text": "それと。覚えている。"}, {"type": "subtitle", "time": 1155.43, "timestamp": "00:19:15", "text": "わかった。よし。はい、どうぞ。わかった。私"}, {"type": "subtitle", "time": 1159.43, "timestamp": "00:19:19", "text": "考えて、D 100 を 1 つ実行します。私は盲目と呼んでいます。"}, {"type": "subtitle", "time": 1162.07, "timestamp": "00:19:22", "text": "D100を1回、目隠しして行う。"}, {"type": "subtitle", "time": 1164.63, "timestamp": "00:19:24", "text": "わかった。それをさっと書きます"}, {"type": "subtitle", "time": 1166.71, "timestamp": "00:19:26", "text": "下。"}, {"type": "subtitle", "time": 1168.71, "timestamp": "00:19:28", "text": "これ。つまり、これがその物だ"}, {"type": "subtitle", "time": 1170.23, "timestamp": "00:19:30", "text": "私が使うつもりなら"}, {"type": "subtitle", "time": 1173.029, "timestamp": "00:19:33", "text": "えっと、もし私が密かに決めたいなら"}, {"type": "subtitle", "time": 1183.35, "timestamp": "00:19:43", "text": "きっと"}, {"type": "subtitle", "time": 1186.07, "timestamp": "00:19:46", "text": "何も悪いことは起こらないと確信しています。"}, {"type": "subtitle", "time": 1189.59, "timestamp": "00:19:49", "text": "書き終えました。ジョックのジョック"}, {"type": "subtitle", "time": 1197.51, "timestamp": "00:19:57", "text": "わかった、"}, {"type": "subtitle", "time": 1197.75, "timestamp": "00:19:57", "text": "私は"}]
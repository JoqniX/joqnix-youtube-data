[{"type": "subtitle", "time": 1740.07, "timestamp": "00:29:00", "text": "ぬるぬるした岩。"}, {"type": "subtitle", "time": 1740.789, "timestamp": "00:29:00", "text": "何てことだ。"}, {"type": "subtitle", "time": 1742.63, "timestamp": "00:29:02", "text": "アリアナは「いやいやいや」って言うだろう"}, {"type": "subtitle", "time": 1744.07, "timestamp": "00:29:04", "text": "善意の申し出を断る。彼女は"}, {"type": "subtitle", "time": 1745.19, "timestamp": "00:29:05", "text": "ただ受け取って、「ありがとう」と言うだけです"}, {"type": "subtitle", "time": 1747.19, "timestamp": "00:29:07", "text": "あなた。\""}, {"type": "subtitle", "time": 1749.75, "timestamp": "00:29:09", "text": "なぜ警報を鳴らして逃げたのですか"}, {"type": "subtitle", "time": 1752.549, "timestamp": "00:29:12", "text": "小さな円を描くように？"}, {"type": "subtitle", "time": 1754.149, "timestamp": "00:29:14", "text": "えっと、"}, {"type": "subtitle", "time": 1756.549, "timestamp": "00:29:16", "text": "なぜそんなクソを受け入れるんだ"}, {"type": "subtitle", "time": 1759.909, "timestamp": "00:29:19", "text": "唾液が生で満たされている？"}, {"type": "subtitle", "time": 1761.83, "timestamp": "00:29:21", "text": "そして私は夜を"}, {"type": "subtitle", "time": 1764.31, "timestamp": "00:29:24", "text": "バンに向かって「でも待って、私は"}, {"type": "subtitle", "time": 1766.23, "timestamp": "00:29:26", "text": "素敵なオファーを断ることはできない"}, {"type": "subtitle", "time": 1773.029, "timestamp": "00:29:33", "text": "だから、もし彼があなたにそれを食べるように頼んだら"}, {"type": "subtitle", "time": 1775.59, "timestamp": "00:29:35", "text": "今すぐロックすれば、君ならできるよ。"}, {"type": "subtitle", "time": 1778.549, "timestamp": "00:29:38", "text": "人間は食べないかもしれないから食べないのかも"}, {"type": "subtitle", "time": 1780.31, "timestamp": "00:29:40", "text": "石を食べる。"}, {"type": "subtitle", "time": 1783.669, "timestamp": "00:29:43", "text": "いいえ、他の人は岩を消化できませんが、"}, {"type": "subtitle", "time": 1786.23, "timestamp": "00:29:46", "text": "贈り物に最適です。"}, {"type": "subtitle", "time": 1789.75, "timestamp": "00:29:49", "text": "そう願っています。"}, {"type": "subtitle", "time": 1792.23, "timestamp": "00:29:52", "text": "神のように、私は"}, {"type": "subtitle", "time": 1793.99, "timestamp": "00:29:53", "text": "棒を食べて消化できるようにする"}, {"type": "subtitle", "time": 1799.83, "timestamp": "00:29:59", "text": "まあ。"}]
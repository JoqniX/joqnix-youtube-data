[{"type": "subtitle", "time": 2224.71, "timestamp": "00:37:04", "text": "スライムの死体。私"}, {"type": "subtitle", "time": 2225.75, "timestamp": "00:37:05", "text": "考える。"}, {"type": "subtitle", "time": 2228.069, "timestamp": "00:37:08", "text": "うん、確かに"}, {"type": "subtitle", "time": 2229.43, "timestamp": "00:37:09", "text": "スライムは"}, {"type": "subtitle", "time": 2231.109, "timestamp": "00:37:11", "text": "ぷにぷにした。"}, {"type": "subtitle", "time": 2232.39, "timestamp": "00:37:12", "text": "はい。それは"}, {"type": "subtitle", "time": 2233.75, "timestamp": "00:37:13", "text": "けれど。"}, {"type": "subtitle", "time": 2236.31, "timestamp": "00:37:16", "text": "ダニの粘液は？"}, {"type": "subtitle", "time": 2239.03, "timestamp": "00:37:19", "text": "ああ、なんてことだ。"}, {"type": "subtitle", "time": 2240.23, "timestamp": "00:37:20", "text": "ああ、神様。"}, {"type": "subtitle", "time": 2242.23, "timestamp": "00:37:22", "text": "スライムを舐めるつもりですか？"}, {"type": "subtitle", "time": 2244.71, "timestamp": "00:37:24", "text": "ダニはどうなるのか？"}, {"type": "subtitle", "time": 2246.15, "timestamp": "00:37:26", "text": "どういう意味ですか？スライムの量"}, {"type": "subtitle", "time": 2247.67, "timestamp": "00:37:27", "text": "なり得るだろうか？"}, {"type": "subtitle", "time": 2249.19, "timestamp": "00:37:29", "text": "彼はそれを舐めるつもりだ。"}, {"type": "subtitle", "time": 2251.75, "timestamp": "00:37:31", "text": "ああ、どうぞご自由に。"}, {"type": "subtitle", "time": 2257.75, "timestamp": "00:37:37", "text": "ティグはあのぬるぬるしたものを舐めるつもりだ。"}, {"type": "subtitle", "time": 2259.03, "timestamp": "00:37:39", "text": "うん、転がす必要はないよ"}, {"type": "subtitle", "time": 2260.63, "timestamp": "00:37:40", "text": "何でも。味はまるで"}, {"type": "subtitle", "time": 2262.55, "timestamp": "00:37:42", "text": "ライムゼリー。"}, {"type": "subtitle", "time": 2263.99, "timestamp": "00:37:43", "text": "ティグは食べ続けるつもりだ"}, {"type": "subtitle", "time": 2265.589, "timestamp": "00:37:45", "text": "スライム。"}, {"type": "subtitle", "time": 2268.39, "timestamp": "00:37:48", "text": "あなたはおいしいものを食べます。"}, {"type": "subtitle", "time": 2273.75, "timestamp": "00:37:53", "text": "ああ、彼は床にあるものも食べるんですよ。"}, {"type": "subtitle", "time": 2275.589, "timestamp": "00:37:55", "text": "いや、いや、いや。あなたはそうすべきではない"}, {"type": "subtitle", "time": 2277.27, "timestamp": "00:37:57", "text": "死体を食べる。これらは"}, {"type": "subtitle", "time": 2278.87, "timestamp": "00:37:58", "text": "あなた。"}]
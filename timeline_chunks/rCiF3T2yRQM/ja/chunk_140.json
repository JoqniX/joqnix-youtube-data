[{"type": "subtitle", "time": 8401.59, "timestamp": "02:20:01", "text": "ひなが食べているという知識"}, {"type": "subtitle", "time": 8404.22, "timestamp": "02:20:04", "text": "スライム？"}, {"type": "subtitle", "time": 8405.59, "timestamp": "02:20:05", "text": "[音楽]"}, {"type": "subtitle", "time": 8406.23, "timestamp": "02:20:06", "text": "作って"}, {"type": "subtitle", "time": 8408.07, "timestamp": "02:20:08", "text": "試してみます。あなたに"}, {"type": "subtitle", "time": 8410.389, "timestamp": "02:20:10", "text": "呪文があるなら試してみてください。"}, {"type": "subtitle", "time": 8411.59, "timestamp": "02:20:11", "text": "あなたは呪文を持っている。"}, {"type": "subtitle", "time": 8413.59, "timestamp": "02:20:13", "text": "あなたは恐怖心を抱いている。あなたは恐怖を感じますか？"}, {"type": "subtitle", "time": 8414.07, "timestamp": "02:20:14", "text": "恐れ。"}, {"type": "subtitle", "time": 8415.83, "timestamp": "02:20:15", "text": "ええ、持っていますよ。 3階。"}, {"type": "subtitle", "time": 8419.429, "timestamp": "02:20:19", "text": "一体どういうことだ？兄貴は確かに恐怖心を持っている。"}, {"type": "subtitle", "time": 8421.03, "timestamp": "02:20:21", "text": "試してみてもいいですよ。"}, {"type": "subtitle", "time": 8423.75, "timestamp": "02:20:23", "text": "兄貴は確かに恐怖心を持っている。一体どういうことだ？"}, {"type": "subtitle", "time": 8425.84, "timestamp": "02:20:25", "text": "待って、これってどうやって回転させるの？"}, {"type": "subtitle", "time": 8427.19, "timestamp": "02:20:27", "text": "[音楽]"}, {"type": "subtitle", "time": 8430.07, "timestamp": "02:20:30", "text": "私は正しくやらなかった。わからない。"}, {"type": "subtitle", "time": 8431.67, "timestamp": "02:20:31", "text": "それは私の呪文スロットを消費したが、私は"}, {"type": "subtitle", "time": 8433.19, "timestamp": "02:20:33", "text": "右に回転させてください。わからない"}, {"type": "subtitle", "time": 8439.99, "timestamp": "02:20:39", "text": "高さ30フィート。"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "おお、"}, {"type": "subtitle", "time": 8444.55, "timestamp": "02:20:44", "text": "持続する。えっと、ちょっと待ってください。ただ、私は"}, {"type": "subtitle", "time": 8447.11, "timestamp": "02:20:47", "text": "そうはならないよ。ああ、そうだね。要は、シフトキーを押しながら"}, {"type": "subtitle", "time": 8451.67, "timestamp": "02:20:51", "text": "そしてスクロールする。申し訳ありませんでした。のように、"}, {"type": "subtitle", "time": 8453.75, "timestamp": "02:20:53", "text": "こんにちは、"}, {"type": "subtitle", "time": 8456.07, "timestamp": "02:20:56", "text": "もうそれは持っていません。"}, {"type": "subtitle", "time": 8457.429, "timestamp": "02:20:57", "text": "どうすればいいのか分からない。"}, {"type": "subtitle", "time": 8459.67, "timestamp": "02:20:59", "text": "私が代わりに設置できますよ。持続する。あなた"}]
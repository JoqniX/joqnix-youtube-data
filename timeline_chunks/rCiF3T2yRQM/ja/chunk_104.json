[{"type": "subtitle", "time": 6243.03, "timestamp": "01:44:03", "text": "生き物はしばしば食べ物を通して仲良くなる。"}, {"type": "subtitle", "time": 6245.27, "timestamp": "01:44:05", "text": "わかった。ロータスはヴァンと"}, {"type": "subtitle", "time": 6247.669, "timestamp": "01:44:07", "text": "「青い方を選んだ方がいいかも」"}, {"type": "subtitle", "time": 6251.03, "timestamp": "01:44:11", "text": "今のところは液体の状態です。これは危険な可能性がある"}, {"type": "subtitle", "time": 6252.07, "timestamp": "01:44:12", "text": "私たちにとっては。」"}, {"type": "subtitle", "time": 6254.149, "timestamp": "01:44:14", "text": "青い液体は十分ありますか"}, {"type": "subtitle", "time": 6255.59, "timestamp": "01:44:15", "text": "クソボトル？"}, {"type": "subtitle", "time": 6257.669, "timestamp": "01:44:17", "text": "1本。"}, {"type": "subtitle", "time": 6258.709, "timestamp": "01:44:18", "text": "1回分。"}, {"type": "subtitle", "time": 6260.709, "timestamp": "01:44:20", "text": "あのね？私はそれを置きます"}, {"type": "subtitle", "time": 6266.229, "timestamp": "01:44:26", "text": "[音楽]"}, {"type": "subtitle", "time": 6267.669, "timestamp": "01:44:27", "text": "1回分。"}, {"type": "subtitle", "time": 6278.07, "timestamp": "01:44:38", "text": "Y 見て、私が 1 つをプレイしていたら"}, {"type": "subtitle", "time": 6280.47, "timestamp": "01:44:40", "text": "他のキャラクターについて考えていた"}, {"type": "subtitle", "time": 6282.149, "timestamp": "01:44:42", "text": "このゲームに参加することはまるで疫病のようだった"}, {"type": "subtitle", "time": 6283.99, "timestamp": "01:44:43", "text": "医者であり、彼らは自分たちの"}, {"type": "subtitle", "time": 6286.709, "timestamp": "01:44:46", "text": "生物兵器を保有する。だから私は"}, {"type": "subtitle", "time": 6287.83, "timestamp": "01:44:47", "text": "それを実行する。"}, {"type": "subtitle", "time": 6291.189, "timestamp": "01:44:51", "text": "もちろんさ。"}, {"type": "subtitle", "time": 6292.31, "timestamp": "01:44:52", "text": "私は掴んだ"}, {"type": "subtitle", "time": 6294.55, "timestamp": "01:44:54", "text": "この小瓶に少し入っています"}, {"type": "subtitle", "time": 6297.03, "timestamp": "01:44:57", "text": "ここ。"}, {"type": "subtitle", "time": 6299.35, "timestamp": "01:44:59", "text": "いくつか持ち帰ってください。あなたは自分の文化を育むことができます"}]
[{"type": "subtitle", "time": 8580.309, "timestamp": "02:23:00", "text": "自由にエンターキーを押してください。"}, {"type": "subtitle", "time": 8582.469, "timestamp": "02:23:02", "text": "よし。ステファン、"}, {"type": "subtitle", "time": 8584.79, "timestamp": "02:23:04", "text": "次はあなたの番です。"}, {"type": "subtitle", "time": 8591.67, "timestamp": "02:23:11", "text": "クリスピン、彼を他のところへ連れて行って"}, {"type": "subtitle", "time": 8598.309, "timestamp": "02:23:18", "text": "よし、それではクリスを"}, {"type": "subtitle", "time": 8599.83, "timestamp": "02:23:19", "text": "ポケットの寸法。よし、"}, {"type": "subtitle", "time": 8602.23, "timestamp": "02:23:22", "text": "ポケットサイズという要素を取り入れています。"}, {"type": "subtitle", "time": 8604.87, "timestamp": "02:23:24", "text": "息子をちょっと休ませてくれよ"}, {"type": "subtitle", "time": 8606.79, "timestamp": "02:23:26", "text": "この女が今やったことの後で"}, {"type": "subtitle", "time": 8608.23, "timestamp": "02:23:28", "text": "それへ。"}, {"type": "subtitle", "time": 8610.71, "timestamp": "02:23:30", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 8614.389, "timestamp": "02:23:34", "text": "私に何ができる？おお。私は持っていません"}, {"type": "subtitle", "time": 8616.63, "timestamp": "02:23:36", "text": "別の呪文を誘発しない呪文"}, {"type": "subtitle", "time": 8619.93, "timestamp": "02:23:39", "text": "めちゃくちゃ分裂した。"}, {"type": "subtitle", "time": 8621.429, "timestamp": "02:23:41", "text": "[音楽]"}, {"type": "subtitle", "time": 8623.11, "timestamp": "02:23:43", "text": "あのね？ぶっ放してやる"}, {"type": "subtitle", "time": 8625.27, "timestamp": "02:23:45", "text": "それ。ぶっ放すよ。私は何も持っていません"}, {"type": "subtitle", "time": 8627.11, "timestamp": "02:23:47", "text": "できます。"}, {"type": "subtitle", "time": 8628.71, "timestamp": "02:23:48", "text": "わかった、"}, {"type": "subtitle", "time": 8630.71, "timestamp": "02:23:50", "text": "聞く。これは本当に"}, {"type": "subtitle", "time": 8639.91, "timestamp": "02:23:59", "text": "よし、当たった。ピクニックは"}]
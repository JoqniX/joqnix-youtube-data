[{"type": "subtitle", "time": 12060.15, "timestamp": "03:21:00", "text": "こちらですか？もう一つへこみがあります"}, {"type": "subtitle", "time": 12063.11, "timestamp": "03:21:03", "text": "膜。はい、どうぞ。"}, {"type": "subtitle", "time": 12064.79, "timestamp": "03:21:04", "text": "わかった。ほとんど人がいない。"}, {"type": "subtitle", "time": 12068.07, "timestamp": "03:21:08", "text": "できますか できますか できますか できるか"}, {"type": "subtitle", "time": 12069.83, "timestamp": "03:21:09", "text": "腸の健康を気遣う？"}, {"type": "subtitle", "time": 12071.75, "timestamp": "03:21:11", "text": "これと戦えるか、あれをできるか"}, {"type": "subtitle", "time": 12072.95, "timestamp": "03:21:12", "text": "また？"}, {"type": "subtitle", "time": 12074.95, "timestamp": "03:21:14", "text": "えっと、特にやることはないよ"}, {"type": "subtitle", "time": 12076.55, "timestamp": "03:21:16", "text": "それを今すぐに。"}, {"type": "subtitle", "time": 12078.229, "timestamp": "03:21:18", "text": "ああ、私の番は終わった。私はそうでしょうか？"}, {"type": "subtitle", "time": 12079.91, "timestamp": "03:21:19", "text": "私はそうは思わない。えっと、ボーナスがあります"}, {"type": "subtitle", "time": 12081.19, "timestamp": "03:21:21", "text": "アクションですが、ボーナスアクションはありますか？"}, {"type": "subtitle", "time": 12082.87, "timestamp": "03:21:22", "text": "攻撃する？"}, {"type": "subtitle", "time": 12085.67, "timestamp": "03:21:25", "text": "ボーナスアクション。"}, {"type": "subtitle", "time": 12087.19, "timestamp": "03:21:27", "text": "魔法の石。"}, {"type": "subtitle", "time": 12087.75, "timestamp": "03:21:27", "text": "射手。"}, {"type": "subtitle", "time": 12090.07, "timestamp": "03:21:30", "text": "魔法の石。魔法の石。の行動"}, {"type": "subtitle", "time": 12091.91, "timestamp": "03:21:31", "text": "投げるという行為自体も、やはり一つの動作である。の"}, {"type": "subtitle", "time": 12093.349, "timestamp": "03:21:33", "text": "ボーナスセクションは実際には魅力的です"}, {"type": "subtitle", "time": 12094.63, "timestamp": "03:21:34", "text": "石"}, {"type": "subtitle", "time": 12096.469, "timestamp": "03:21:36", "text": "なぜなら、あなたは3つの小石に魔法をかけるからです"}, {"type": "subtitle", "time": 12098.15, "timestamp": "03:21:38", "text": "誰かに与える。"}, {"type": "subtitle", "time": 12100.95, "timestamp": "03:21:40", "text": "あ、待って。魔法の石を使って"}, {"type": "subtitle", "time": 12102.55, "timestamp": "03:21:42", "text": "それ？"}, {"type": "subtitle", "time": 12104.55, "timestamp": "03:21:44", "text": "ああ、魔法の石が使えるようになったんですね。後で"}, {"type": "subtitle", "time": 12107.51, "timestamp": "03:21:47", "text": "魔法の石を手に入れることができます"}, {"type": "subtitle", "time": 12108.63, "timestamp": "03:21:48", "text": "投げろ。"}, {"type": "subtitle", "time": 12111.51, "timestamp": "03:21:51", "text": "ああ、わかりました。私が魔法の石を作ります。"}, {"type": "subtitle", "time": 12113.269, "timestamp": "03:21:53", "text": "わかった。よし。それをそのままにしておきます"}, {"type": "subtitle", "time": 12115.83, "timestamp": "03:21:55", "text": "心。つまり、魔法の石が３つあるってことですね。"}, {"type": "subtitle", "time": 12117.91, "timestamp": "03:21:57", "text": "あなたにも人に与えることができる"}]
[{"type": "subtitle", "time": 2763.109, "timestamp": "00:46:03", "text": "口を大きく開けて、壁のように"}, {"type": "subtitle", "time": 2766.39, "timestamp": "00:46:06", "text": "血だまり。プールを見たら"}, {"type": "subtitle", "time": 2769.51, "timestamp": "00:46:09", "text": "血痕と恐らく不審な胸部、"}, {"type": "subtitle", "time": 2772.87, "timestamp": "00:46:12", "text": "そこへは行かない方がいいかもしれない。"}, {"type": "subtitle", "time": 2776.069, "timestamp": "00:46:16", "text": "ほら、どんなことも避けるために"}, {"type": "subtitle", "time": 2779.51, "timestamp": "00:46:19", "text": "戦利品でいっぱい。ええ、それもいっぱい"}, {"type": "subtitle", "time": 2784.63, "timestamp": "00:46:24", "text": "戦利品を手に入れようとし続ける死んだ友人たち"}, {"type": "subtitle", "time": 2790.87, "timestamp": "00:46:30", "text": "[音楽]"}, {"type": "subtitle", "time": 2792.87, "timestamp": "00:46:32", "text": "しかし、その下にも部屋がある。私は"}, {"type": "subtitle", "time": 2794.63, "timestamp": "00:46:34", "text": "君たちは探す必要はないと思うよ"}, {"type": "subtitle", "time": 2797.03, "timestamp": "00:46:37", "text": "空っぽの戦利品を通して、彼らは"}, {"type": "subtitle", "time": 2799.67, "timestamp": "00:46:39", "text": "それは既に取得済みです。しかし、道はある"}, {"type": "subtitle", "time": 2803.51, "timestamp": "00:46:43", "text": "あそこだ。ええと、そう言えるかもしれませんね"}, {"type": "subtitle", "time": 2807.67, "timestamp": "00:46:47", "text": "道筋は少し肉厚だ。"}, {"type": "subtitle", "time": 2809.43, "timestamp": "00:46:49", "text": "多分"}, {"type": "subtitle", "time": 2817.75, "timestamp": "00:46:57", "text": "良い、"}]
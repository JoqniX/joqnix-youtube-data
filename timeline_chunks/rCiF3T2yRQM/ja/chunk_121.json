[{"type": "subtitle", "time": 7262.47, "timestamp": "02:01:02", "text": "こちらです。それは黄色いドロドロした物質だ。そしてそれは"}, {"type": "subtitle", "time": 7265.27, "timestamp": "02:01:05", "text": "あなたの存在に気づいているようです。ゆっくりと"}, {"type": "subtitle", "time": 7267.43, "timestamp": "02:01:07", "text": "忍び寄る。"}, {"type": "subtitle", "time": 7270.149, "timestamp": "02:01:10", "text": "非常にゆっくりと忍び寄る。つまり、ああ、"}, {"type": "subtitle", "time": 7270.87, "timestamp": "02:01:10", "text": "そんなつもりで考えたわけじゃない。"}, {"type": "subtitle", "time": 7272.79, "timestamp": "02:01:12", "text": "我々には敵がいると思う。"}, {"type": "subtitle", "time": 7273.669, "timestamp": "02:01:13", "text": "なんてこった。"}, {"type": "subtitle", "time": 7275.51, "timestamp": "02:01:15", "text": "非常にゆっくりと忍び寄る。また、"}, {"type": "subtitle", "time": 7277.27, "timestamp": "02:01:17", "text": "別の"}, {"type": "subtitle", "time": 7279.109, "timestamp": "02:01:19", "text": "ああ、神様。よし。まるで、さあ、さあ、"}, {"type": "subtitle", "time": 7288.229, "timestamp": "02:01:28", "text": "食べようとしないでください。"}, {"type": "subtitle", "time": 7290.68, "timestamp": "02:01:30", "text": "彼らはあなたを食べようとするでしょう。"}, {"type": "subtitle", "time": 7291.75, "timestamp": "02:01:31", "text": "[音楽]"}, {"type": "subtitle", "time": 7300.149, "timestamp": "02:01:40", "text": "あなたは以前、スライムを食べたことがある。"}, {"type": "subtitle", "time": 7307.27, "timestamp": "02:01:47", "text": "ライムゼリーを食べているだけだと思う​​。ライム"}, {"type": "subtitle", "time": 7308.07, "timestamp": "02:01:48", "text": "ゼリー。うん、"}, {"type": "subtitle", "time": 7310.47, "timestamp": "02:01:50", "text": "ライムゼリー。えっと、"}, {"type": "subtitle", "time": 7312.87, "timestamp": "02:01:52", "text": "こちらはレモン味になります。"}, {"type": "subtitle", "time": 7315.91, "timestamp": "02:01:55", "text": "これが近づくにつれて、私は思う。えっと、"}, {"type": "subtitle", "time": 7317.189, "timestamp": "02:01:57", "text": "あのね？私はただ攻撃するつもりだ"}, {"type": "subtitle", "time": 7319.27, "timestamp": "02:01:59", "text": "それ。もうどうでもいい。もうどうでもいい。俺たちは最高だぜ。私は"}]
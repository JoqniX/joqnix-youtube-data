[{"type": "subtitle", "time": 3720.87, "timestamp": "01:02:00", "text": "内部。"}, {"type": "subtitle", "time": 3723.109, "timestamp": "01:02:03", "text": "Tはそれが気に入らない。 Tは好きではない"}, {"type": "subtitle", "time": 3724.95, "timestamp": "01:02:04", "text": "噴出する。"}, {"type": "subtitle", "time": 3727.109, "timestamp": "01:02:07", "text": "なぜ気に入らないのですか？"}, {"type": "subtitle", "time": 3729.51, "timestamp": "01:02:09", "text": "それは肉厚になり始めます"}, {"type": "subtitle", "time": 3733.27, "timestamp": "01:02:13", "text": "噛めば噛むほど。"}, {"type": "subtitle", "time": 3737.27, "timestamp": "01:02:17", "text": "それは確かに情報ですね"}, {"type": "subtitle", "time": 3739.03, "timestamp": "01:02:19", "text": "つまり、ティックの仕組みは"}, {"type": "subtitle", "time": 3740.789, "timestamp": "01:02:20", "text": "これを理解するということは、内側"}, {"type": "subtitle", "time": 3742.95, "timestamp": "01:02:22", "text": "添付されているように、私たちが見ているのは"}, {"type": "subtitle", "time": 3745.43, "timestamp": "01:02:25", "text": "それも最初から最後までずっと。"}, {"type": "subtitle", "time": 3746.789, "timestamp": "01:02:26", "text": "うん。"}, {"type": "subtitle", "time": 3747.27, "timestamp": "01:02:27", "text": "E."}, {"type": "subtitle", "time": 3750.39, "timestamp": "01:02:30", "text": "つまり、そういう風に理解すればいいのです。それで"}, {"type": "subtitle", "time": 3752.15, "timestamp": "01:02:32", "text": "これらはもしかしたら生き返るかもしれない。私はしません"}, {"type": "subtitle", "time": 3754.549, "timestamp": "01:02:34", "text": "彼らが生きているかどうかを知る。えっと"}, {"type": "subtitle", "time": 3756.15, "timestamp": "01:02:36", "text": "ともかく。"}, {"type": "subtitle", "time": 3760.789, "timestamp": "01:02:40", "text": "ええと、ゆっくりしましょう。"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "減速する。"}, {"type": "subtitle", "time": 3764.47, "timestamp": "01:02:44", "text": "またか。回想シーン。"}, {"type": "subtitle", "time": 3765.99, "timestamp": "01:02:45", "text": "フラッシュバック。"}, {"type": "subtitle", "time": 3768.87, "timestamp": "01:02:48", "text": "フラッシュバックのペースを落としてください。ちょうど"}, {"type": "subtitle", "time": 3771.349, "timestamp": "01:02:51", "text": "猫。"}, {"type": "subtitle", "time": 3775.349, "timestamp": "01:02:55", "text": "これは彼らが言うところの"}]
[{"type": "subtitle", "time": 2161.43, "timestamp": "00:36:01", "text": "香水をくれた。"}, {"type": "subtitle", "time": 2164.15, "timestamp": "00:36:04", "text": "ええ、彼はそうしました。はい。まさにその通りです"}, {"type": "subtitle", "time": 2168.47, "timestamp": "00:36:08", "text": "彼の香水の匂い。不思議なことに、"}, {"type": "subtitle", "time": 2170.47, "timestamp": "00:36:10", "text": "メモを奪い取って詰め込む"}, {"type": "subtitle", "time": 2171.829, "timestamp": "00:36:11", "text": "彼らの口。"}, {"type": "subtitle", "time": 2175.829, "timestamp": "00:36:15", "text": "ありがとう。それは少なくとも適切な処分方法だ。"}, {"type": "subtitle", "time": 2178.63, "timestamp": "00:36:18", "text": "本当にそれを食べたいのですか？その"}, {"type": "subtitle", "time": 2185.109, "timestamp": "00:36:25", "text": "彼は石を食べる。本当にそう思いますか？"}, {"type": "subtitle", "time": 2188.31, "timestamp": "00:36:28", "text": "懸念事項ですか？"}, {"type": "subtitle", "time": 2190.95, "timestamp": "00:36:30", "text": "おそらく違うだろう。しかし"}, {"type": "subtitle", "time": 2194.15, "timestamp": "00:36:34", "text": "ジェイクは体調がとても良い。"}, {"type": "subtitle", "time": 2195.99, "timestamp": "00:36:35", "text": "わかった。うん。うん。また、香りは"}, {"type": "subtitle", "time": 2197.99, "timestamp": "00:36:37", "text": "だいたいこんな感じです。"}, {"type": "subtitle", "time": 2198.95, "timestamp": "00:36:38", "text": "おお、"}, {"type": "subtitle", "time": 2200.63, "timestamp": "00:36:40", "text": "匂いをたどって行きたいなら"}, {"type": "subtitle", "time": 2201.67, "timestamp": "00:36:41", "text": "それ。"}, {"type": "subtitle", "time": 2203.75, "timestamp": "00:36:43", "text": "匂いを追っているのですか？"}, {"type": "subtitle", "time": 2205.91, "timestamp": "00:36:45", "text": "知っている。アリアナはこう言うだろう、"}, {"type": "subtitle", "time": 2207.43, "timestamp": "00:36:47", "text": "「ああ、相手チームに会いに行こう。"}, {"type": "subtitle", "time": 2208.87, "timestamp": "00:36:48", "text": "彼らはどうやったのか。」"}, {"type": "subtitle", "time": 2209.43, "timestamp": "00:36:49", "text": "よし。"}, {"type": "subtitle", "time": 2211.43, "timestamp": "00:36:51", "text": "床の匂いを嗅いでみて。"}, {"type": "subtitle", "time": 2213.43, "timestamp": "00:36:53", "text": "ああ、神様。"}, {"type": "subtitle", "time": 2215.27, "timestamp": "00:36:55", "text": "クソの匂いがしたら"}, {"type": "subtitle", "time": 2217.03, "timestamp": "00:36:57", "text": "最後に「これは何だ？」と思う。"}, {"type": "subtitle", "time": 2218.15, "timestamp": "00:36:58", "text": "たくさんの"}, {"type": "subtitle", "time": 2219.91, "timestamp": "00:36:59", "text": "地面にべたべたしたものが付着している。"}]
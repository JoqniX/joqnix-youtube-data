[{"type": "subtitle", "time": 3660.789, "timestamp": "01:01:00", "text": "ロールを作る。えっと、スライスしてみます"}, {"type": "subtitle", "time": 3663.99, "timestamp": "01:01:03", "text": "それ。まるで何かが噴き出すように"}, {"type": "subtitle", "time": 3665.829, "timestamp": "01:01:05", "text": "血と騒ぎは君につくけど、それはかなり"}, {"type": "subtitle", "time": 3674.15, "timestamp": "01:01:14", "text": "私があなたを奪おうとしていたとでも思ってください。"}, {"type": "subtitle", "time": 3674.63, "timestamp": "01:01:14", "text": "何？"}, {"type": "subtitle", "time": 3676.069, "timestamp": "01:01:16", "text": "よし、拭き取ろう"}, {"type": "subtitle", "time": 3677.67, "timestamp": "01:01:17", "text": "地面のように。"}, {"type": "subtitle", "time": 3680.47, "timestamp": "01:01:20", "text": "大丈夫。クソ悪い、君をきれいにする"}, {"type": "subtitle", "time": 3682.87, "timestamp": "01:01:22", "text": "のように"}, {"type": "subtitle", "time": 3683.51, "timestamp": "01:01:23", "text": "今。"}, {"type": "subtitle", "time": 3685.27, "timestamp": "01:01:25", "text": "ああ、それを明かさせてください。そこにいる"}, {"type": "subtitle", "time": 3687.829, "timestamp": "01:01:27", "text": "行く。編集ボタンを押してください。"}, {"type": "subtitle", "time": 3688.71, "timestamp": "01:01:28", "text": "わかった。"}, {"type": "subtitle", "time": 3690.63, "timestamp": "01:01:30", "text": "ティックは何か言った？何だって？"}, {"type": "subtitle", "time": 3692.63, "timestamp": "01:01:32", "text": "ああ、ティックはまるでむさぼり食おうとしているみたいだ"}, {"type": "subtitle", "time": 3693.91, "timestamp": "01:01:33", "text": "その像。"}, {"type": "subtitle", "time": 3696.95, "timestamp": "01:01:36", "text": "わかった。よし。噛みついてみて"}, {"type": "subtitle", "time": 3699.51, "timestamp": "01:01:39", "text": "彫像の一部のように、しかし"}, {"type": "subtitle", "time": 3701.75, "timestamp": "01:01:41", "text": "最初に噛んでみると、岩のように硬い。"}, {"type": "subtitle", "time": 3703.67, "timestamp": "01:01:43", "text": "外側は岩でできている、"}, {"type": "subtitle", "time": 3705.99, "timestamp": "01:01:45", "text": "しかし、深く潜れば潜るほど、"}, {"type": "subtitle", "time": 3711.67, "timestamp": "01:01:51", "text": "彼らがそれを気に入ってくれるように。それは違う"}, {"type": "subtitle", "time": 3714.309, "timestamp": "01:01:54", "text": "通常のロックの味。"}, {"type": "subtitle", "time": 3716.549, "timestamp": "01:01:56", "text": "それは感覚過敏を引き起こす。"}, {"type": "subtitle", "time": 3718.87, "timestamp": "01:01:58", "text": "外はカリカリ、中はジューシー"}]
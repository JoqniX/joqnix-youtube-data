[{"type": "subtitle", "time": 1865.269, "timestamp": "00:31:05", "text": "ああ、大変だ。"}, {"type": "subtitle", "time": 1866.71, "timestamp": "00:31:06", "text": "頭の中でそれをやってみて。彼らはただ"}, {"type": "subtitle", "time": 1870.71, "timestamp": "00:31:10", "text": "鳥に金を投げる"}, {"type": "subtitle", "time": 1873.11, "timestamp": "00:31:13", "text": "読み込みに少し時間がかかっています。"}, {"type": "subtitle", "time": 1874.789, "timestamp": "00:31:14", "text": "あ、待って。読み込み中ですか？持続する。"}, {"type": "subtitle", "time": 1879.19, "timestamp": "00:31:19", "text": "うん。うん、私の方では読み込み中だよ。"}, {"type": "subtitle", "time": 1880.23, "timestamp": "00:31:20", "text": "問題ない"}, {"type": "subtitle", "time": 1882.389, "timestamp": "00:31:22", "text": "私の環境では読み込まれました。"}, {"type": "subtitle", "time": 1884.31, "timestamp": "00:31:24", "text": "後でご褒美をあげよう。"}, {"type": "subtitle", "time": 1886.87, "timestamp": "00:31:26", "text": "残念ながら、まだ読み込み中です。"}, {"type": "subtitle", "time": 1887.83, "timestamp": "00:31:27", "text": "ああ、それは奇妙ですね。"}, {"type": "subtitle", "time": 1889.35, "timestamp": "00:31:29", "text": "どのような報酬が得られますか"}, {"type": "subtitle", "time": 1891.11, "timestamp": "00:31:31", "text": "彼ら？"}, {"type": "subtitle", "time": 1894.31, "timestamp": "00:31:34", "text": "ええと、もっと金ともっと光る石を。"}, {"type": "subtitle", "time": 1897.11, "timestamp": "00:31:37", "text": "ティックは時々おやつを食べて"}, {"type": "subtitle", "time": 1898.23, "timestamp": "00:31:38", "text": "銀。"}, {"type": "subtitle", "time": 1901.83, "timestamp": "00:31:41", "text": "ああ、わかりました。"}, {"type": "subtitle", "time": 1902.389, "timestamp": "00:31:42", "text": "それは"}, {"type": "subtitle", "time": 1905.75, "timestamp": "00:31:45", "text": "Tick is Tickは買収されることになった。"}, {"type": "subtitle", "time": 1909.83, "timestamp": "00:31:49", "text": "彼は買収される予定だ。"}, {"type": "subtitle", "time": 1916.63, "timestamp": "00:31:56", "text": "いいえ、"}]
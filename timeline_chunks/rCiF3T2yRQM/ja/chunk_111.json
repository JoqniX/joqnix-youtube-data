[{"type": "subtitle", "time": 6660.31, "timestamp": "01:51:00", "text": "もしそれが像のようなものなら。"}, {"type": "subtitle", "time": 6661.51, "timestamp": "01:51:01", "text": "それはまるで、"}, {"type": "subtitle", "time": 6663.35, "timestamp": "01:51:03", "text": "像か何か。"}, {"type": "subtitle", "time": 6665.669, "timestamp": "01:51:05", "text": "その像は石のようで、"}, {"type": "subtitle", "time": 6667.27, "timestamp": "01:51:07", "text": "そして肉厚になる。"}, {"type": "subtitle", "time": 6669.59, "timestamp": "01:51:09", "text": "うん。"}, {"type": "subtitle", "time": 6672.229, "timestamp": "01:51:12", "text": "まるで、彼らの何人かは"}, {"type": "subtitle", "time": 6674.39, "timestamp": "01:51:14", "text": "最後に、もう一方のチームがここに行った"}, {"type": "subtitle", "time": 6676.149, "timestamp": "01:51:16", "text": "そして、攻撃も好きだった"}, {"type": "subtitle", "time": 6678.07, "timestamp": "01:51:18", "text": "像と、攻撃されたときに"}, {"type": "subtitle", "time": 6680.149, "timestamp": "01:51:20", "text": "出血する。"}, {"type": "subtitle", "time": 6685.75, "timestamp": "01:51:25", "text": "私は実験するのが好きなんです。私はただ"}, {"type": "subtitle", "time": 6687.109, "timestamp": "01:51:27", "text": "彼女はもう1つ落とすつもりだ"}, {"type": "subtitle", "time": 6690.47, "timestamp": "01:51:30", "text": "壊れた像に一滴垂らす。"}, {"type": "subtitle", "time": 6692.629, "timestamp": "01:51:32", "text": "よし。わかった。ああ、そうだね。待って、何？"}, {"type": "subtitle", "time": 6693.99, "timestamp": "01:51:33", "text": "Pは何をしましたっけ？"}, {"type": "subtitle", "time": 6696.629, "timestamp": "01:51:36", "text": "豚はここで角をかじっているだけだ。"}, {"type": "subtitle", "time": 6697.189, "timestamp": "01:51:37", "text": "おお、"}, {"type": "subtitle", "time": 6700.149, "timestamp": "01:51:40", "text": "ええ、とても似たようなものです。"}, {"type": "subtitle", "time": 6701.51, "timestamp": "01:51:41", "text": "はい、こちらへ。えっと、"}, {"type": "subtitle", "time": 6705.589, "timestamp": "01:51:45", "text": "これはマルタのクソみたいなグループメンバーだ。"}, {"type": "subtitle", "time": 6707.83, "timestamp": "01:51:47", "text": "グループの中で最も賢いメンバー。"}, {"type": "subtitle", "time": 6710.95, "timestamp": "01:51:50", "text": "似たようなことが起こる"}, {"type": "subtitle", "time": 6712.95, "timestamp": "01:51:52", "text": "小さな青い液体の滴がいくつかできる。"}, {"type": "subtitle", "time": 6716.39, "timestamp": "01:51:56", "text": "黒い液体のようなもの"}, {"type": "subtitle", "time": 6719.83, "timestamp": "01:51:59", "text": "えっと、少し大きくなりました。そうですね、"}]
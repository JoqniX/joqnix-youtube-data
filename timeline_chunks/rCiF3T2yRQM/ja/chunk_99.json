[{"type": "subtitle", "time": 5940.55, "timestamp": "01:39:00", "text": "ポケット。メモも見つかりましたね。たいてい"}, {"type": "subtitle", "time": 5942.07, "timestamp": "01:39:02", "text": "注記。"}, {"type": "subtitle", "time": 5951.99, "timestamp": "01:39:11", "text": "私も調査してもいいですか？"}, {"type": "subtitle", "time": 5953.83, "timestamp": "01:39:13", "text": "はい。ええ、できますよ"}, {"type": "subtitle", "time": 5956.39, "timestamp": "01:39:16", "text": "調査ロール、または、えっと、または"}, {"type": "subtitle", "time": 5958.07, "timestamp": "01:39:18", "text": "すぐに調査してください。チェック"}, {"type": "subtitle", "time": 5960.229, "timestamp": "01:39:20", "text": "ポケット。"}, {"type": "subtitle", "time": 5960.629, "timestamp": "01:39:20", "text": "よし、"}, {"type": "subtitle", "time": 5963.91, "timestamp": "01:39:23", "text": "調査判定を行います。"}, {"type": "subtitle", "time": 5965.669, "timestamp": "01:39:25", "text": "ああ、調査は最初のページに載っている"}, {"type": "subtitle", "time": 5967.27, "timestamp": "01:39:27", "text": "あなたのキャラクターシートの。よし、これでいい。"}, {"type": "subtitle", "time": 5970.07, "timestamp": "01:39:30", "text": "ええ、それで大丈夫です。わかった。はい。えっと、"}, {"type": "subtitle", "time": 5971.75, "timestamp": "01:39:31", "text": "それはあなたです。次回はそれをしたいときに"}, {"type": "subtitle", "time": 5973.43, "timestamp": "01:39:33", "text": "空白ですが、これで問題ありません。ええ、そうですね。あなた"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "メモを見つけたが、"}, {"type": "subtitle", "time": 5977.91, "timestamp": "01:39:37", "text": "本当に解読する。数学がたくさんある"}, {"type": "subtitle", "time": 5979.99, "timestamp": "01:39:39", "text": "方程式。"}, {"type": "subtitle", "time": 5981.35, "timestamp": "01:39:41", "text": "よし。ちょっと確認してみます"}, {"type": "subtitle", "time": 5983.189, "timestamp": "01:39:43", "text": "これに関しては。"}, {"type": "subtitle", "time": 5986.229, "timestamp": "01:39:46", "text": "持って行ってもいいですか？ ああ、もちろん。はい、どうぞ。"}, {"type": "subtitle", "time": 5987.189, "timestamp": "01:39:47", "text": "あなたはできる。"}, {"type": "subtitle", "time": 5990.39, "timestamp": "01:39:50", "text": "私が話したらどうなる？"}, {"type": "subtitle", "time": 5990.87, "timestamp": "01:39:50", "text": "えっと、"}, {"type": "subtitle", "time": 5994.31, "timestamp": "01:39:54", "text": "彼らはとにかくメモが多い。"}, {"type": "subtitle", "time": 5997.51, "timestamp": "01:39:57", "text": "ええ、私には理解できない音符ですね。"}]
[{"type": "subtitle", "time": 11226.87, "timestamp": "03:07:06", "text": "待って、スタッフを使って好きにできないの？"}, {"type": "subtitle", "time": 11229.67, "timestamp": "03:07:09", "text": "バランスを取るか、"}, {"type": "subtitle", "time": 11231.59, "timestamp": "03:07:11", "text": "地面？"}, {"type": "subtitle", "time": 11235.91, "timestamp": "03:07:15", "text": "ブーム。ああ、おい。でも、ええ、あなたの"}, {"type": "subtitle", "time": 11237.59, "timestamp": "03:07:17", "text": "もの"}, {"type": "subtitle", "time": 11240.23, "timestamp": "03:07:20", "text": "あなたならできると思いますよ"}, {"type": "subtitle", "time": 11241.59, "timestamp": "03:07:21", "text": "ボーナスアクションとして、"}, {"type": "subtitle", "time": 11242.95, "timestamp": "03:07:22", "text": "それ"}, {"type": "subtitle", "time": 11246.15, "timestamp": "03:07:26", "text": "ボーナスアクション。えっと、ちょっと見てみましょう。"}, {"type": "subtitle", "time": 11247.269, "timestamp": "03:07:27", "text": "あなたはすでにそれを使っている"}, {"type": "subtitle", "time": 11247.75, "timestamp": "03:07:27", "text": "月の光。"}, {"type": "subtitle", "time": 11253.11, "timestamp": "03:07:33", "text": "H 優柔不断な遅れ。シェリーのラグはボーナスです"}, {"type": "subtitle", "time": 11255.67, "timestamp": "03:07:35", "text": "行動も同様です。まあ、私もあなたと同じように思う"}, {"type": "subtitle", "time": 11256.87, "timestamp": "03:07:36", "text": "必要に応じてアクションを使用することもできます"}, {"type": "subtitle", "time": 11259.67, "timestamp": "03:07:39", "text": "ほら、自分の物を置いてみてよ"}, {"type": "subtitle", "time": 11262.07, "timestamp": "03:07:42", "text": "地面に立ってバランスを取る。"}, {"type": "subtitle", "time": 11263.99, "timestamp": "03:07:43", "text": "ああ、それはどうすればいいんですか？おお、アクション。"}, {"type": "subtitle", "time": 11265.67, "timestamp": "03:07:45", "text": "えっと、言ってくださいよ。ただ私に言って、"}, {"type": "subtitle", "time": 11271.83, "timestamp": "03:07:51", "text": "言ってくれれば、実現させてみせる。"}, {"type": "subtitle", "time": 11273.99, "timestamp": "03:07:53", "text": "はい、作りたいです。はい、好きです。"}, {"type": "subtitle", "time": 11275.51, "timestamp": "03:07:55", "text": "それを行うために。右。"}, {"type": "subtitle", "time": 11277.75, "timestamp": "03:07:57", "text": "わかった。あなたは自分のスタックを地面に置いた"}]
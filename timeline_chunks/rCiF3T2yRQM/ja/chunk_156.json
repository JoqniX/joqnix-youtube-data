[{"type": "subtitle", "time": 9361.03, "timestamp": "02:36:01", "text": "それ。"}, {"type": "subtitle", "time": 9364.07, "timestamp": "02:36:04", "text": "幾つか？ 2つあります。"}, {"type": "subtitle", "time": 9365.349, "timestamp": "02:36:05", "text": "2つあります。うん。"}, {"type": "subtitle", "time": 9367.75, "timestamp": "02:36:07", "text": "うん。わかった。もう片方は灰色で"}, {"type": "subtitle", "time": 9369.99, "timestamp": "02:36:09", "text": "病気"}, {"type": "subtitle", "time": 9379.03, "timestamp": "02:36:19", "text": "えっと、半音階の順序をクリアしないといけない。それ"}, {"type": "subtitle", "time": 9381.27, "timestamp": "02:36:21", "text": "唯一効果的な方法のようだ"}, {"type": "subtitle", "time": 9382.79, "timestamp": "02:36:22", "text": "彼らならできる。"}, {"type": "subtitle", "time": 9385.429, "timestamp": "02:36:25", "text": "よし。"}, {"type": "subtitle", "time": 9391.27, "timestamp": "02:36:31", "text": "オーブを入手してください。"}, {"type": "subtitle", "time": 9393.19, "timestamp": "02:36:33", "text": "オーブを手に入れろ、この野郎。"}, {"type": "subtitle", "time": 9400.469, "timestamp": "02:36:40", "text": "ダメージの種類を設定することを忘れないでください。"}, {"type": "subtitle", "time": 9401.75, "timestamp": "02:36:41", "text": "私はしませんでした。おっと。"}, {"type": "subtitle", "time": 9403.429, "timestamp": "02:36:43", "text": "だって、この敵はそういう敵の一人だと思うから"}, {"type": "subtitle", "time": 9404.79, "timestamp": "02:36:44", "text": "非常に敏感な敵"}, {"type": "subtitle", "time": 9407.51, "timestamp": "02:36:47", "text": "特定のダメージタイプに対して。"}, {"type": "subtitle", "time": 9409.19, "timestamp": "02:36:49", "text": "私はしませんでした。"}, {"type": "subtitle", "time": 9412.07, "timestamp": "02:36:52", "text": "はい。大丈夫です。"}, {"type": "subtitle", "time": 9414.71, "timestamp": "02:36:54", "text": "次にいつだったか覚えていない。"}, {"type": "subtitle", "time": 9415.91, "timestamp": "02:36:55", "text": "待って。いいえ、そうです。いいえ、"}, {"type": "subtitle", "time": 9417.27, "timestamp": "02:36:57", "text": "あれは当たった。それは痛い。うん。"}, {"type": "subtitle", "time": 9418.87, "timestamp": "02:36:58", "text": "なるほど、そういうことだったんですね。どこにあるか分かりました。私"}]
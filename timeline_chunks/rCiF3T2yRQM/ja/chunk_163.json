[{"type": "subtitle", "time": 9780.87, "timestamp": "02:43:00", "text": "ここに置くか、別の場所に移動してください。"}, {"type": "subtitle", "time": 9782.95, "timestamp": "02:43:02", "text": "ええ、どうか、どうか月の光を動かしてください。"}, {"type": "subtitle", "time": 9785.51, "timestamp": "02:43:05", "text": "えっと、それを移動したいんです。うん、"}, {"type": "subtitle", "time": 9786.23, "timestamp": "02:43:06", "text": "お願いします。"}, {"type": "subtitle", "time": 9787.91, "timestamp": "02:43:07", "text": "遠く離れた。遠く離れた。の限り"}, {"type": "subtitle", "time": 9789.51, "timestamp": "02:43:09", "text": "よし。月をどこまで動かせますか？"}, {"type": "subtitle", "time": 9791.67, "timestamp": "02:43:11", "text": "ビーム？ところで、最大値って何でしたっけ？私"}, {"type": "subtitle", "time": 9794.389, "timestamp": "02:43:14", "text": "忘れた。"}, {"type": "subtitle", "time": 9796.389, "timestamp": "02:43:16", "text": "最大60フィート。それは実際かなり遠い距離です。"}, {"type": "subtitle", "time": 9797.99, "timestamp": "02:43:17", "text": "とりあえずここに置いておきます。あなたはできる"}, {"type": "subtitle", "time": 9799.99, "timestamp": "02:43:19", "text": "必要であれば、別の場所に移動してください。"}, {"type": "subtitle", "time": 9800.79, "timestamp": "02:43:20", "text": "わかった。"}, {"type": "subtitle", "time": 9803.27, "timestamp": "02:43:23", "text": "うん、それはうまくいくよ。ええ、"}, {"type": "subtitle", "time": 9806.15, "timestamp": "02:43:26", "text": "床はゆっくりとまるで"}, {"type": "subtitle", "time": 9807.99, "timestamp": "02:43:27", "text": "まるでコンベアベルトのようだ。"}, {"type": "subtitle", "time": 9810.07, "timestamp": "02:43:30", "text": "あなたはゆっくりと前進しています。"}, {"type": "subtitle", "time": 9812.79, "timestamp": "02:43:32", "text": "粘液の一つを拾うことができます"}, {"type": "subtitle", "time": 9815.11, "timestamp": "02:43:35", "text": "スライムであり、特に"}, {"type": "subtitle", "time": 9816.63, "timestamp": "02:43:36", "text": "彼らを攻撃しようとした者であり、"}, {"type": "subtitle", "time": 9819.03, "timestamp": "02:43:39", "text": "それを食べることで優位性を主張する。"}, {"type": "subtitle", "time": 9821.59, "timestamp": "02:43:41", "text": "わかった。よし。あなたはそれを食べる。"}, {"type": "subtitle", "time": 9823.429, "timestamp": "02:43:43", "text": "これはもうすぐ起こるぞ。"}, {"type": "subtitle", "time": 9825.11, "timestamp": "02:43:45", "text": "これこれこれこれこれはただ"}, {"type": "subtitle", "time": 9827.11, "timestamp": "02:43:47", "text": "レモンの味がする"}, {"type": "subtitle", "time": 9829.67, "timestamp": "02:43:49", "text": "レモンゼリー。"}, {"type": "subtitle", "time": 9832.469, "timestamp": "02:43:52", "text": "食べ続けるつもりだ。"}]
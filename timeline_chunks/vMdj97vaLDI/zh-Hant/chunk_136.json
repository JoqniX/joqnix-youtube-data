[{"type": "subtitle", "time": 8167.83, "timestamp": "02:16:07", "text": "變成了公司員工。所以對我來說很難開口，不過沒關係，一切都會好起來的。也完成了。我很高興能與大家交流。"}, {"type": "subtitle", "time": 8186.709, "timestamp": "02:16:26", "text": "我可以說，我甚至和年紀較大的人也交談過、互動過。  是的，"}, {"type": "subtitle", "time": 8193.75, "timestamp": "02:16:33", "text": "我們會在成為虛擬主播之前就邀請一些人來參加。我在 2018 年、2017 年開始做"}, {"type": "subtitle", "time": 8200.79, "timestamp": "02:16:40", "text": "YouTube 之前認識的人，"}, {"type": "subtitle", "time": 8206.429, "timestamp": "02:16:46", "text": "嗯，2017 年我在"}, {"type": "subtitle", "time": 8209.99, "timestamp": "02:16:49", "text": "Twitch 上認識的人。我已經聯絡了其中兩人"}, {"type": "subtitle", "time": 8212.87, "timestamp": "02:16:52", "text": "。不知道他們是否還在那裡，"}, {"type": "subtitle", "time": 8216.309, "timestamp": "02:16:56", "text": "但其中一人回覆了。所以我們會在其中一個地方感受到"}, {"type": "subtitle", "time": 8219.27, "timestamp": "02:16:59", "text": "愛，在另一個地方感受到愛"}]
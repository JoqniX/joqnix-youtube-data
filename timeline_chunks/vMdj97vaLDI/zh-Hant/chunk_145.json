[{"type": "subtitle", "time": 8702.469, "timestamp": "02:25:02", "text": "我覺得你沒必要說出來，因為我覺得我們當時在午夜時分放聲尖叫。所以我覺得你沒必要讀它。  我們當時放聲吶喊"}, {"type": "subtitle", "time": 8721.99, "timestamp": "02:25:21", "text": "這樣吧。  我真的很擔心。不，不，不，不。不用擔心。我們要停下來。  你知道，馬上就開始，但不是現在，因為再說一遍，當我看到你的恐密症時，我意識到你比我膽小得多。  所以，至少我打了一場單人比賽。"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "我沒有完成它。我"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "尖叫著跑開了。我想，我想你看到了那"}, {"type": "subtitle", "time": 8730.469, "timestamp": "02:25:30", "text": "一刻。  那"}, {"type": "subtitle", "time": 8732.23, "timestamp": "02:25:32", "text": "一刻。哦，是的。我也在"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "那裡發布了一些快速瀏覽的瞬間。所以，"}, {"type": "subtitle", "time": 8737.429, "timestamp": "02:25:37", "text": "想看就去看吧。哦，"}, {"type": "subtitle", "time": 8739.11, "timestamp": "02:25:39", "text": "不錯。  是啊"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "，我快要崩潰了。我"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "不知道。我快瘋了，我不"}, {"type": "subtitle", "time": 8745.429, "timestamp": "02:25:45", "text": "知道。我不知道該怎麼辦。你在嘗試"}, {"type": "subtitle", "time": 8748.23, "timestamp": "02:25:48", "text": "新事物。是的。是的。我得"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "穿上短褲之類的衣服，但同時又有點"}, {"type": "subtitle", "time": 8752.63, "timestamp": "02:25:52", "text": "迷惘。什麼是搞笑的"}, {"type": "subtitle", "time": 8755.51, "timestamp": "02:25:55", "text": "瞬間？什麼是美好的瞬間？我不"}, {"type": "subtitle", "time": 8758.07, "timestamp": "02:25:58", "text": "知道。我不知道。呃，我以前很喜歡，"}]
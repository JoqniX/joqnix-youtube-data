[{"type": "subtitle", "time": 8221.83, "timestamp": "02:17:01", "text": "等等。我仍在努力聯繫他們，希望在我離開之前"}, {"type": "subtitle", "time": 8225.11, "timestamp": "02:17:05", "text": "他們能及時看到，這樣"}, {"type": "subtitle", "time": 8228.19, "timestamp": "02:17:08", "text": "我就可以和他們談談了"}, {"type": "subtitle", "time": 8229.22, "timestamp": "02:17:09", "text": "。"}, {"type": "subtitle", "time": 8231.07, "timestamp": "02:17:11", "text": "[音樂]"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "是的，我想和某"}, {"type": "subtitle", "time": 8237.709, "timestamp": "02:17:17", "text": "個人談談。嗯，他是我"}, {"type": "subtitle", "time": 8242.95, "timestamp": "02:17:22", "text": "在 Twitch 上的第一位創辦人，在"}, {"type": "subtitle", "time": 8245.589, "timestamp": "02:17:25", "text": "我剛開始做推廣的時候，他幫我做賭注和訂閱，"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "對吧？是的。是的。我不"}, {"type": "subtitle", "time": 8250.87, "timestamp": "02:17:30", "text": "知道該如何查看"}, {"type": "subtitle", "time": 8252.429, "timestamp": "02:17:32", "text": "我的頻道裡有哪些創辦人"}, {"type": "subtitle", "time": 8254.95, "timestamp": "02:17:34", "text": "。在Twitch上直播的人都"}, {"type": "subtitle", "time": 8257.99, "timestamp": "02:17:37", "text": "知道嗎？我得谷歌一下才行"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "。給我一分鐘時間。我"}, {"type": "subtitle", "time": 8263.549, "timestamp": "02:17:43", "text": "去找找我的"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "耳機。我可以把它放進耳朵裡，"}, {"type": "subtitle", "time": 8268.629, "timestamp": "02:17:48", "text": "戴上耳機。耳機"}]
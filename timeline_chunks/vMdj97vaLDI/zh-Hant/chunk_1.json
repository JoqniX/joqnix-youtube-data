[{"type": "subtitle", "time": 61.99, "timestamp": "00:01:01", "text": "77 天。今晚我們邀請到一位特別嘉賓，他"}, {"type": "subtitle", "time": 63.789, "timestamp": "00:01:03", "text": "是來自"}, {"type": "subtitle", "time": 66.59, "timestamp": "00:01:06", "text": "Buddscape 的 Psychonishan。我們將在"}, {"type": "subtitle", "time": 69.99, "timestamp": "00:01:09", "text": "40 分鐘內，呃，大約 30 分鐘後進行合作"}, {"type": "subtitle", "time": 74.23, "timestamp": "00:01:14", "text": "。好的。但是，在我們合作之前"}, {"type": "subtitle", "time": 76.789, "timestamp": "00:01:16", "text": "，我要先"}, {"type": "subtitle", "time": 80.63, "timestamp": "00:01:20", "text": "速通遊戲，吃完晚餐再"}, {"type": "subtitle", "time": 83.03, "timestamp": "00:01:23", "text": "回來。好的。給我幾分鐘"}, {"type": "subtitle", "time": 85.51, "timestamp": "00:01:25", "text": "時間，我去速通一下，吃吃吃，馬上回來"}, {"type": "subtitle", "time": 88.23, "timestamp": "00:01:28", "text": "。好的。你好。那我先"}, {"type": "subtitle", "time": 91.03, "timestamp": "00:01:31", "text": "去吃晚飯，一會兒就回來。到那時，"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "請盡情欣賞歌舞雜耍吧。你好。請盡情欣賞"}]
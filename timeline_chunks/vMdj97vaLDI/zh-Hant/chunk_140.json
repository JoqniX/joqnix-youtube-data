[{"type": "subtitle", "time": 8402.389, "timestamp": "02:20:02", "text": "三個帳號。可惜我沒"}, {"type": "subtitle", "time": 8405.59, "timestamp": "02:20:05", "text": "進去。不像這位Jnix先生，他是"}, {"type": "subtitle", "time": 8408.63, "timestamp": "02:20:08", "text": "真的花錢買了雷電。所以，是的，"}, {"type": "subtitle", "time": 8411.349, "timestamp": "02:20:11", "text": "他有，但我即使付了錢也沒拿到"}, {"type": "subtitle", "time": 8413.67, "timestamp": "02:20:13", "text": "。後來意外地發現它就在那裡"}, {"type": "subtitle", "time": 8417.19, "timestamp": "02:20:17", "text": "。我當時就想，呃，我"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "沒抽到雷電。然後有一天，我突然"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "想去Kokcomi。但是，到了"}, {"type": "subtitle", "time": 8424.07, "timestamp": "02:20:24", "text": "活動最後一天，我就想，是"}, {"type": "subtitle", "time": 8425.59, "timestamp": "02:20:25", "text": "啊，就算我"}, {"type": "subtitle", "time": 8426.87, "timestamp": "02:20:26", "text": "抽一次也不會有什麼事發生。"}, {"type": "subtitle", "time": 8427.95, "timestamp": "02:20:27", "text": "她"}, {"type": "subtitle", "time": 8430.389, "timestamp": "02:20:30", "text": "來了。然後我會感到偏見和"}, {"type": "subtitle", "time": 8437.349, "timestamp": "02:20:37", "text": "呃，我只想把我的Wen帶在身上。我希望我的"}, {"type": "subtitle", "time": 8439.389, "timestamp": "02:20:39", "text": "溫氏小隊能夠完整。但"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "不幸的是，Ginchin Impact 中有人"}, {"type": "subtitle", "time": 8445.67, "timestamp": "02:20:45", "text": "在戲弄我，"}, {"type": "subtitle", "time": 8447.99, "timestamp": "02:20:47", "text": "讓我得不到雷電。我"}, {"type": "subtitle", "time": 8451.99, "timestamp": "02:20:51", "text": "對此非常高興。糟了，我餵牠了。我"}, {"type": "subtitle", "time": 8453.07, "timestamp": "02:20:53", "text": "找到我的"}, {"type": "subtitle", "time": 8455.51, "timestamp": "02:20:55", "text": "耳機了。好的，請稍等片刻。盡情享受"}, {"type": "subtitle", "time": 8457.59, "timestamp": "02:20:57", "text": "水帶來的樂趣。去小便一下就回來。我的天啊，"}]
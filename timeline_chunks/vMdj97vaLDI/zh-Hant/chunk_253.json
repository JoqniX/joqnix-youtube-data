[{"type": "subtitle", "time": 15182.149, "timestamp": "04:13:02", "text": "我"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "在洗手間。  等等，你在哪裡？你在樓上還是樓下？"}, {"type": "subtitle", "time": 15191.189, "timestamp": "04:13:11", "text": "樓上。朝你的右邊走。你在哪裡？"}, {"type": "subtitle", "time": 15194.95, "timestamp": "04:13:14", "text": "你在哪裡？你又在廁所嗎？"}, {"type": "subtitle", "time": 15199.269, "timestamp": "04:13:19", "text": "不，我不在廁所裡。我已從"}, {"type": "subtitle", "time": 15201.91, "timestamp": "04:13:21", "text": "廁所出來。非常感謝。是的。  是的。呃，從這裡開始。過來。這邊。這邊有廁所。  洗手間？在"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "？但我其實是指浴室。  我是個瘋狂的"}]
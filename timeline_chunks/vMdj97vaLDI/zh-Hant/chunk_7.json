[{"type": "subtitle", "time": 429.909, "timestamp": "00:07:09", "text": "？為什麼我總覺得好像在哪裡看過"}, {"type": "subtitle", "time": 432.27, "timestamp": "00:07:12", "text": "他們"}, {"type": "subtitle", "time": 436.23, "timestamp": "00:07:16", "text": "？我認識Hiroshan、Renan、"}, {"type": "subtitle", "time": 439.909, "timestamp": "00:07:19", "text": "Asuka、Sama、Anenda和Yamadasan。"}, {"type": "subtitle", "time": 442.95, "timestamp": "00:07:22", "text": "我相信所有這些人，包括艾娜在內，都來自同一個"}, {"type": "subtitle", "time": 449.909, "timestamp": "00:07:29", "text": "虛擬實境世界。我們相遇後"}, {"type": "subtitle", "time": 453.189, "timestamp": "00:07:33", "text": "聊了很多，而且我們一直"}, {"type": "subtitle", "time": 456.07, "timestamp": "00:07:36", "text": "積極地互相見面，"}, {"type": "subtitle", "time": 458.469, "timestamp": "00:07:38", "text": "就像一個小組，一個學習"}, {"type": "subtitle", "time": 462.07, "timestamp": "00:07:42", "text": "小組或小組會議之類的，大概"}, {"type": "subtitle", "time": 466.15, "timestamp": "00:07:46", "text": "持續了兩週吧。是的，我以前非常"}, {"type": "subtitle", "time": 469.30899999999997, "timestamp": "00:07:49", "text": "活躍，但我不知道"}, {"type": "subtitle", "time": 473.029, "timestamp": "00:07:53", "text": "之後發生了什麼。嘿，"}, {"type": "subtitle", "time": 477.23, "timestamp": "00:07:57", "text": "這個虛擬"}]
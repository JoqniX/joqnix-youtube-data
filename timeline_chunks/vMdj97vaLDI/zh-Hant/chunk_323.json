[{"type": "subtitle", "time": 19381.27, "timestamp": "05:23:01", "text": "我需要對更高位元率的內容進行影音測試。所以我們"}, {"type": "subtitle", "time": 19389.51, "timestamp": "05:23:09", "text": "現在會這樣做。讓我切換到遊戲模式。這是新玩意兒。讓我換一下。你聽到了嗎？是的。  我的槍出問題了。  她在這裡"}, {"type": "subtitle", "time": 19399.07, "timestamp": "05:23:19", "text": "做什麼？  我的天哪。  你不應該在這裡。什麼？我永遠不會離開。  哦，是的。"}, {"type": "subtitle", "time": 19401.35, "timestamp": "05:23:21", "text": "你好。"}, {"type": "subtitle", "time": 19418.39, "timestamp": "05:23:38", "text": "這個犯罪集團到底在想什麼？嗯，讓小狗也加入遊戲吧。我是個人。"}, {"type": "subtitle", "time": 19421.03, "timestamp": "05:23:41", "text": "你應該留在這裡。"}, {"type": "subtitle", "time": 19423.99, "timestamp": "05:23:43", "text": "更安全。我們不會"}]
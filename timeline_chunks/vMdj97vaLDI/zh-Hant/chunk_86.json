[{"type": "chat", "time": 5166.274, "timestamp": "01:26:06", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "that was my umbrella bro"}, {"type": "subtitle", "time": 5169.51, "timestamp": "01:26:09", "text": "地方，以便下一個人可以在你之後使用它。這其實並不違法。好的。但人們確實會這樣做"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "。  這種情況很"}, {"type": "subtitle", "time": 5183.669, "timestamp": "01:26:23", "text": "常見。我不知道他們現在是否還這樣做。但是，我們以前確實這樣做過。有一次我忘了帶傘。我只是隨手拿了一把傘，就好像它本來就橫放在某個地方一樣"}, {"type": "subtitle", "time": 5185.43, "timestamp": "01:26:25", "text": "。我剛拿走了。"}, {"type": "chat", "time": 5186.295, "timestamp": "01:26:26", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "is it really stealing a umbrella when you can just grab another umbrella?"}, {"type": "subtitle", "time": 5187.189, "timestamp": "01:26:27", "text": "我進來後，把它留在下一站了"}, {"type": "subtitle", "time": 5197.03, "timestamp": "01:26:37", "text": "。你離開的時候，別"}, {"type": "subtitle", "time": 5199.55, "timestamp": "01:26:39", "text": "擔心。只有你離開的時候傘才會被偷。不管怎樣，你的"}, {"type": "chat", "time": 5201.268, "timestamp": "01:26:41", "author": "@saikatdey0909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mT2Up10wsYYwilcayEwYxOCwTgzDSnNztFejTB-x02nR8=s64-c-k-c0x00ffffff-no-rj", "message": "Grand Theft Umbrella"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "傘一定會被偷。真是太"}]
[{"type": "subtitle", "time": 21933.708, "timestamp": "06:05:33", "text": "哦，等等。我不知道怎麼穿高跟鞋。"}, {"type": "subtitle", "time": 21936.788, "timestamp": "06:05:36", "text": "哦，不。我沒穿高跟鞋。  哦，不。不，不。我"}, {"type": "subtitle", "time": 21945.03, "timestamp": "06:05:45", "text": "沒穿"}, {"type": "subtitle", "time": 21947.59, "timestamp": "06:05:47", "text": "高跟鞋。  我的錯。我的錯。我的錯。我穿高跟鞋。我沒穿高跟鞋。那"}, {"type": "subtitle", "time": 21956.07, "timestamp": "06:05:56", "text": "是這根雞雞嗎？嗯"}]
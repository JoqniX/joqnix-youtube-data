[{"type": "subtitle", "time": 8463.11, "timestamp": "02:21:03", "text": "這是三個帳戶。我有三個"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "帳戶。我有三個孩子。我不"}, {"type": "subtitle", "time": 8467.75, "timestamp": "02:21:07", "text": "知道該怎麼處理它們。三個孩子。"}, {"type": "subtitle", "time": 8469.59, "timestamp": "02:21:09", "text": "哦，是的。最近你是不是"}, {"type": "subtitle", "time": 8472.63, "timestamp": "02:21:12", "text": "常常玩《情人節》這款遊戲？是的。  感覺"}, {"type": "subtitle", "time": 8477.349, "timestamp": "02:21:17", "text": "我好像把那些孩子忘了。  是的。是的。是的"}, {"type": "subtitle", "time": 8479.67, "timestamp": "02:21:19", "text": "。我忘了。因為我快要"}, {"type": "subtitle", "time": 8491.99, "timestamp": "02:21:31", "text": "可以的。杰奎琳說的。做"}, {"type": "subtitle", "time": 8494.15, "timestamp": "02:21:34", "text": "一個糟糕的父親角色也無妨。是的，"}, {"type": "subtitle", "time": 8496.71, "timestamp": "02:21:36", "text": "各位。你們都聽到了他的消息。是的。  我們"}, {"type": "subtitle", "time": 8499.83, "timestamp": "02:21:39", "text": "走吧。我的意思是，從某種程度上來說，這沒問題，"}, {"type": "subtitle", "time": 8502.23, "timestamp": "02:21:42", "text": "但你也必須意識到自己做得"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "不好，然後努力"}, {"type": "subtitle", "time": 8508.23, "timestamp": "02:21:48", "text": "改進，你知道的。呃，"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "別去那裡。他媽的。請不要讓"}, {"type": "subtitle", "time": 8516.469, "timestamp": "02:21:56", "text": "自己陷入那樣的困境。你好。你好。  你好"}]
[{"type": "subtitle", "time": 8103.03, "timestamp": "02:15:03", "text": "這些，等等。我也想邀請一些"}, {"type": "subtitle", "time": 8105.189, "timestamp": "02:15:05", "text": "新的 YouTuber 來，"}, {"type": "subtitle", "time": 8108.31, "timestamp": "02:15:08", "text": "跟他們交流互動。嗯，我還沒"}, {"type": "subtitle", "time": 8111.27, "timestamp": "02:15:11", "text": "聯絡過很多人。呃，因為我得先把"}, {"type": "subtitle", "time": 8113.189, "timestamp": "02:15:13", "text": "待處理的任務處理完，對吧？我"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "聯絡了其中的74個人"}, {"type": "subtitle", "time": 8120.55, "timestamp": "02:15:20", "text": "。有幾個人有空，可以"}, {"type": "subtitle", "time": 8123.669, "timestamp": "02:15:23", "text": "過來跟我聊聊天什麼的"}, {"type": "subtitle", "time": 8125.43, "timestamp": "02:15:25", "text": "。所以我正在努力聯繫"}, {"type": "subtitle", "time": 8128.79, "timestamp": "02:15:28", "text": "所有人。是的，甚至包括虛擬主播。我會"}, {"type": "subtitle", "time": 8131.83, "timestamp": "02:15:31", "text": "聯絡一些我以前認識的老朋友"}, {"type": "subtitle", "time": 8135.35, "timestamp": "02:15:35", "text": "。嗯，我有一些比較老的聯絡人。由於種種限制，"}, {"type": "subtitle", "time": 8137.669, "timestamp": "02:15:37", "text": "我無法"}, {"type": "subtitle", "time": 8140.27, "timestamp": "02:15:40", "text": "邀請一些人參與直播，"}, {"type": "subtitle", "time": 8144.39, "timestamp": "02:15:44", "text": "但也許以後有機會和他們合作會"}, {"type": "subtitle", "time": 8147.189, "timestamp": "02:15:47", "text": "更好。"}, {"type": "subtitle", "time": 8153.51, "timestamp": "02:15:53", "text": "嗯，是的，因為還有那些"}, {"type": "subtitle", "time": 8155.83, "timestamp": "02:15:55", "text": "東西。  我接觸過的大多數 YouTuber 都變成了公司老闆。所以，呃，"}, {"type": "subtitle", "time": 8158.79, "timestamp": "02:15:58", "text": "大多數伊恩和我認識的人都"}]
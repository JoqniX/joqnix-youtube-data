[{"type": "subtitle", "time": 9963.15, "timestamp": "02:46:03", "text": "哪個？溫度計和那本書。是的，就像紫外線和那本書一樣。那我帶紫外線燈和那本書吧。  好了，我們走吧。  哦，我們需要一個“哦，上帝”。呃，"}, {"type": "subtitle", "time": 9972.23, "timestamp": "02:46:12", "text": "你有手電筒跳傘器嗎"}, {"type": "subtitle", "time": 9974.309, "timestamp": "02:46:14", "text": "？但我有"}, {"type": "subtitle", "time": 9982.07, "timestamp": "02:46:22", "text": "紫外線燈。  等等，這些東西都是你買的。你有多"}, {"type": "subtitle", "time": 9989.51, "timestamp": "02:46:29", "text": "富有？不，不。我當時只有132美元。這就是我全部的資料了。我的天啊。為什麼買這些東西？你可以免費獲得"}, {"type": "subtitle", "time": 10009.03, "timestamp": "02:46:49", "text": "你拿走鑰匙了嗎？是的，我確實這麼做了"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "。"}, {"type": "subtitle", "time": 10014.07, "timestamp": "02:46:54", "text": "哦，真可怕。  我的天哪。幽靈般的。哦，對了，這是專業的。"}]
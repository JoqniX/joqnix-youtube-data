[{"type": "subtitle", "time": 1827.19, "timestamp": "00:30:27", "text": "何てことだ。"}, {"type": "subtitle", "time": 1840.19, "timestamp": "00:30:40", "text": "何をするか？私はとても、とても下手です"}, {"type": "subtitle", "time": 1842.63, "timestamp": "00:30:42", "text": "コミュニケーション。私はついていけない"}, {"type": "subtitle", "time": 1846.31, "timestamp": "00:30:46", "text": "私には友達がいる。あなたは何を話しますか？どのように"}]
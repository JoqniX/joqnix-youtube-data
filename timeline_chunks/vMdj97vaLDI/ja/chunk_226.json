[{"type": "subtitle", "time": 13561.11, "timestamp": "03:46:01", "text": "わかった。わかった。私は上がる。私は上がる。わかった。"}, {"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "私は上へ行って、私の"}, {"type": "subtitle", "time": 13568.87, "timestamp": "03:46:08", "text": "バカバカしい本、そして私はEMF4になります。"}, {"type": "subtitle", "time": 13571.349, "timestamp": "03:46:11", "text": "EMF4。分かりますよ。分かりますよ。分かりますよ。私"}, {"type": "subtitle", "time": 13573.189, "timestamp": "03:46:13", "text": "それを見て。ああ、私は死にかけている。私は死にかけている。私は"}, {"type": "subtitle", "time": 13575.11, "timestamp": "03:46:15", "text": "死にかけている。私は死にかけている。見てて。私を見ていてください。"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "私を見ていてください。あらら。私は死にかけている。心配しないで。"}, {"type": "subtitle", "time": 13582.469, "timestamp": "03:46:22", "text": "私は死んだ。心配しないで。いや、いや、いや。"}, {"type": "subtitle", "time": 13585.11, "timestamp": "03:46:25", "text": "私はヨブの気をそらした。気をそらしたんだ。しないで"}, {"type": "subtitle", "time": 13595.59, "timestamp": "03:46:35", "text": "ああ、何もクリックできませんでした。ああ、"}, {"type": "subtitle", "time": 13597.51, "timestamp": "03:46:37", "text": "私のミスです。しかし、それは女性だった。それは"}, {"type": "subtitle", "time": 13600.55, "timestamp": "03:46:40", "text": "でも、女性です。女性は這いずり回っていた"}, {"type": "subtitle", "time": 13603.99, "timestamp": "03:46:43", "text": "4つ。それは幻影だ。ああ、それは"}, {"type": "subtitle", "time": 13606.309, "timestamp": "03:46:46", "text": "ファントム。どうでも。"}, {"type": "subtitle", "time": 13608.63, "timestamp": "03:46:48", "text": "四つん這いになる。わかった。"}, {"type": "subtitle", "time": 13610.469, "timestamp": "03:46:50", "text": "ああ、それは幻影だ。うん。うん。うん。私"}, {"type": "subtitle", "time": 13612.79, "timestamp": "03:46:52", "text": "ファントムと混同していると思った"}, {"type": "subtitle", "time": 13615.83, "timestamp": "03:46:55", "text": "まるでポルターガイストのようだ。理由がわからない。"}, {"type": "subtitle", "time": 13617.99, "timestamp": "03:46:57", "text": "私が知っている唯一のファントムはマインクラフトに出てくるものだ"}]
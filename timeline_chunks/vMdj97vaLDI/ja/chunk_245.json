[{"type": "subtitle", "time": 14701.67, "timestamp": "04:05:01", "text": "非常に速い。亡霊は旅することができる"}, {"type": "subtitle", "time": 14704.87, "timestamp": "04:05:04", "text": "獲物を狩っている時の兆候。"}, {"type": "subtitle", "time": 14707.59, "timestamp": "04:05:07", "text": "弱点。牧師から隠れることは"}, {"type": "subtitle", "time": 14711.349, "timestamp": "04:05:11", "text": "非常にゆっくりと動くようにする。ああ、もし"}, {"type": "subtitle", "time": 14713.429, "timestamp": "04:05:13", "text": "奴に見つかったら、事実上お前は死ぬ。"}, {"type": "subtitle", "time": 14715.429, "timestamp": "04:05:15", "text": "文字通り、あなたを急かしますよ。おお"}, {"type": "subtitle", "time": 14716.99, "timestamp": "04:05:16", "text": "男の子。でももしあなたが"}, {"type": "subtitle", "time": 14719.83, "timestamp": "04:05:19", "text": "隠れてください、それはあなたを殺しません、または"}, {"type": "subtitle", "time": 14721.83, "timestamp": "04:05:21", "text": "まるで忘れてしまうかのように、とてもゆっくりと進む"}, {"type": "subtitle", "time": 14725.51, "timestamp": "04:05:25", "text": "あなたについて。幽霊、幽霊乗り。彼女が持っている"}, {"type": "subtitle", "time": 14728.55, "timestamp": "04:05:28", "text": "ゴースティング。よし、幽霊がいっぱいいる"}, {"type": "subtitle", "time": 14731.99, "timestamp": "04:05:31", "text": "これに乗って。私は今まで見たことがなかった"}, {"type": "subtitle", "time": 14734.389, "timestamp": "04:05:34", "text": "幽霊か、それともこれまでも。私はそれがどうなのか見てみたい"}, {"type": "subtitle", "time": 14737.269, "timestamp": "04:05:37", "text": "どうやらそうみたいだ。ああ、いや、いや、いや。そうではありません"}, {"type": "subtitle", "time": 14739.91, "timestamp": "04:05:39", "text": "それは実に興味深いですね。それは何ですか？"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "幽霊って何？"}, {"type": "subtitle", "time": 14745.189, "timestamp": "04:05:45", "text": "うん。いや、そうじゃないよ。あなたは普段あなたは"}, {"type": "subtitle", "time": 14748.389, "timestamp": "04:05:48", "text": "私がカメラを仕掛けたのを覚えてる？"}, {"type": "subtitle", "time": 14750.63, "timestamp": "04:05:50", "text": "キャビンのことですよね？とてもとても"}, {"type": "subtitle", "time": 14753.75, "timestamp": "04:05:53", "text": "怪しい場所だったが、それでもそれは"}, {"type": "subtitle", "time": 14757.51, "timestamp": "04:05:57", "text": "狩猟地だった。だから、もしあなたが"}, {"type": "subtitle", "time": 14759.189, "timestamp": "04:05:59", "text": "トラックに戻って、"}]
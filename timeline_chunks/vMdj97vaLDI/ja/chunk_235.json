[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "血とかそういうのがある。つまり"}, {"type": "subtitle", "time": 14104.87, "timestamp": "03:55:04", "text": "ケチャップとかそういう類。なんてこった。"}, {"type": "subtitle", "time": 14108.309, "timestamp": "03:55:08", "text": "ここは一体何ですか？"}, {"type": "subtitle", "time": 14110.55, "timestamp": "03:55:10", "text": "わからない。これらの人たちはここ"}, {"type": "subtitle", "time": 14112.389, "timestamp": "03:55:12", "text": "不器用な食べ方をする人がたくさんいる。私が言いたいのはそれだけです"}, {"type": "subtitle", "time": 14120.309, "timestamp": "03:55:20", "text": "幽霊は、"}, {"type": "subtitle", "time": 14122.87, "timestamp": "03:55:22", "text": "こいつらクソ野郎どもは何をやってんだ？おお"}, {"type": "subtitle", "time": 14124.79, "timestamp": "03:55:24", "text": "我が神よ。こいつらは何者だ？特に"}, {"type": "subtitle", "time": 14126.87, "timestamp": "03:55:26", "text": "その"}, {"type": "subtitle", "time": 14128.87, "timestamp": "03:55:28", "text": "何てことだ。"}, {"type": "subtitle", "time": 14131.83, "timestamp": "03:55:31", "text": "おお、素敵。さあ行こう。さあ行こう。ああ、私は"}, {"type": "subtitle", "time": 14133.99, "timestamp": "03:55:33", "text": "できません。"}, {"type": "subtitle", "time": 14137.429, "timestamp": "03:55:37", "text": "中に入っても構いません。何てことだ。誰かがああ"}, {"type": "subtitle", "time": 14140.95, "timestamp": "03:55:40", "text": "我が神よ。これは何ですか？彼らはまるで"}, {"type": "subtitle", "time": 14143.349, "timestamp": "03:55:43", "text": "濃い血がたくさんある"}, {"type": "subtitle", "time": 14146.15, "timestamp": "03:55:46", "text": "もの。何てことだ。いいえ、血ではありません。"}, {"type": "subtitle", "time": 14149.349, "timestamp": "03:55:49", "text": "ケチャップです。それはトマトソースです。見てください"}, {"type": "subtitle", "time": 14152.63, "timestamp": "03:55:52", "text": "このトマトソース。彼らは"}, {"type": "subtitle", "time": 14156.95, "timestamp": "03:55:56", "text": "おそらくパスタを作っているのだろう。何てことだ、"}, {"type": "subtitle", "time": 14159.269, "timestamp": "03:55:59", "text": "みんな。見て。見て。これはトマトソースです。"}]
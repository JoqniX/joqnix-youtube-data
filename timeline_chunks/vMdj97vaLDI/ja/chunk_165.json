[{"type": "subtitle", "time": 9900.389, "timestamp": "02:45:00", "text": "よし、行こう。"}, {"type": "subtitle", "time": 9903.03, "timestamp": "02:45:03", "text": "ああ、私たちは「ああ、神様」が必要です。えっと、"}, {"type": "subtitle", "time": 9905.51, "timestamp": "02:45:05", "text": "懐中電灯ジャンプ？私は紫外線ライトを持っています"}, {"type": "subtitle", "time": 9907.59, "timestamp": "02:45:07", "text": "けれど。"}, {"type": "subtitle", "time": 9909.59, "timestamp": "02:45:09", "text": "待って、君はこれら全部買ったの？どうやって"}, {"type": "subtitle", "time": 9913.75, "timestamp": "02:45:13", "text": "ところで、あなたはどれくらいお金持ちですか？いや、いや。私"}, {"type": "subtitle", "time": 9916.389, "timestamp": "02:45:16", "text": "132ドルくらいしか持っていなかった。私が言いたいのはそれだけです"}, {"type": "subtitle", "time": 9918.07, "timestamp": "02:45:18", "text": "持っている。何てことだ。なぜ全部買ったの？"}, {"type": "subtitle", "time": 9925.91, "timestamp": "02:45:25", "text": "ああ、私は被害妄想が強いんです。"}, {"type": "subtitle", "time": 9928.95, "timestamp": "02:45:28", "text": "ああ、鍵を持って行ったの？ええ、そうしました。"}, {"type": "subtitle", "time": 9933.51, "timestamp": "02:45:33", "text": "実は。ああ、それは、ああ、不気味だ。"}, {"type": "subtitle", "time": 9936.15, "timestamp": "02:45:36", "text": "ああ、なんてことだ。不気味な。あ、そういえば、"}, {"type": "subtitle", "time": 9939.269, "timestamp": "02:45:39", "text": "プロ。つまり、恵みはないということです"}, {"type": "subtitle", "time": 9942.71, "timestamp": "02:45:42", "text": "時間。では、猶予期間でしょうか？恵みとは何か"}, {"type": "subtitle", "time": 9945.03, "timestamp": "02:45:45", "text": "ダイヤモンド？はい、グレースダイヤモンドとは"}, {"type": "subtitle", "time": 9948.11, "timestamp": "02:45:48", "text": "ああ、安全な時間"}, {"type": "subtitle", "time": 9959.51, "timestamp": "02:45:59", "text": "外。聞こえますか？聞いた？"}]
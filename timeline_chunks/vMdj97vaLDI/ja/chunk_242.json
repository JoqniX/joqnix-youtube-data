[{"type": "subtitle", "time": 14521.95, "timestamp": "04:02:01", "text": "箱、指紋、そして幽霊"}, {"type": "subtitle", "time": 14526.309, "timestamp": "04:02:06", "text": "乗馬。わかった。バンシー。バンシーもまた"}, {"type": "subtitle", "time": 14529.189, "timestamp": "04:02:09", "text": "幽霊が幽霊の球体に乗っている。私はまだ持っていません"}, {"type": "subtitle", "time": 14532.269, "timestamp": "04:02:12", "text": "クラウドはゴーストオーブを手に入れるのが好きですが、"}, {"type": "subtitle", "time": 14535.11, "timestamp": "04:02:15", "text": "それでも歌うセイレーンとして知られる"}, {"type": "subtitle", "time": 14537.75, "timestamp": "04:02:17", "text": "歌で獲物を誘い込む。また、"}, {"type": "subtitle", "time": 14540.309, "timestamp": "04:02:20", "text": "獲物を選別することが知られている"}, {"type": "subtitle", "time": 14543.67, "timestamp": "04:02:23", "text": "とどめの一撃を与える。わかった。バンシー"}, {"type": "subtitle", "time": 14547.269, "timestamp": "04:02:27", "text": "弱まるだろう、ああ、歌うだろう。それで"}, {"type": "subtitle", "time": 14549.229, "timestamp": "04:02:29", "text": "誰かが叫んでいるのを見たり、"}, {"type": "subtitle", "time": 14552.63, "timestamp": "04:02:32", "text": "何か、バンシーかもしれない。"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "おそらく、私たちのボットも"}, {"type": "subtitle", "time": 14559.75, "timestamp": "04:02:39", "text": "叫んだり、その他いろいろ。"}, {"type": "subtitle", "time": 14562.309, "timestamp": "04:02:42", "text": "そうだった。私たちは、私たちは、"}, {"type": "subtitle", "time": 14564.15, "timestamp": "04:02:44", "text": "叫び声をあげて、死ぬ前に、"}, {"type": "subtitle", "time": 14565.67, "timestamp": "04:02:45", "text": "右？"}, {"type": "subtitle", "time": 14568.55, "timestamp": "04:02:48", "text": "あるいは、叫んだとも言える。"}, {"type": "subtitle", "time": 14571.59, "timestamp": "04:02:51", "text": "悲鳴を聞いた記憶はない"}, {"type": "subtitle", "time": 14573.99, "timestamp": "04:02:53", "text": "けれど。わからない。うん。うん。いつ"}, {"type": "subtitle", "time": 14576.07, "timestamp": "04:02:56", "text": "あ、待って。まあ、あなたは私たちのことを覚えているでしょう"}, {"type": "subtitle", "time": 14578.229, "timestamp": "04:02:58", "text": "部屋の中に入っていくんだよね？それは"}]
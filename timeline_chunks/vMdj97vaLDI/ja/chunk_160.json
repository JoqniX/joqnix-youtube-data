[{"type": "subtitle", "time": 9601.75, "timestamp": "02:40:01", "text": "はい。あなたはこの部屋に行きたいのですか？"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "ジャック、何があったんだ？何てことだ。あなたは"}, {"type": "subtitle", "time": 9621.18, "timestamp": "02:40:21", "text": "[音楽]"}, {"type": "subtitle", "time": 9623.349, "timestamp": "02:40:23", "text": "[笑い]"}, {"type": "subtitle", "time": 9625.19, "timestamp": "02:40:25", "text": "見て、見て、見て。わかった。わかった。ごめんなさい。"}, {"type": "subtitle", "time": 9627.19, "timestamp": "02:40:27", "text": "ごめんなさい。わかった。あのね？わかった。"}, {"type": "subtitle", "time": 9628.63, "timestamp": "02:40:28", "text": "あのね？何でも。私は"}, {"type": "subtitle", "time": 9631.23, "timestamp": "02:40:31", "text": "自分も肌を手に入れよう。心配しないで。おお"}, {"type": "subtitle", "time": 9635.67, "timestamp": "02:40:35", "text": "いいえ。私が何をすべきかはともかく、"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "でも彼は私をそうしてくれた。何てことだ。私はできません"}, {"type": "subtitle", "time": 9645.27, "timestamp": "02:40:45", "text": "それ。何てことだ。何てことだ。私は"}, {"type": "subtitle", "time": 9648.15, "timestamp": "02:40:48", "text": "何か？"}, {"type": "subtitle", "time": 9654.63, "timestamp": "02:40:54", "text": "飛び上がって怖かった。わからない。私は違います"}, {"type": "subtitle", "time": 9658.71, "timestamp": "02:40:58", "text": "私は彼らを怖がらせたくない。なぜ、"}]
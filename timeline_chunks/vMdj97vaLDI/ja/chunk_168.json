[{"type": "subtitle", "time": 10081.83, "timestamp": "02:48:01", "text": "ドラッグ？いいえ、このドアは開けられません。なぜ？"}, {"type": "subtitle", "time": 10084.389, "timestamp": "02:48:04", "text": "私は怖いです。そうそう。幽霊って何？"}, {"type": "subtitle", "time": 10085.91, "timestamp": "02:48:05", "text": "あ、待って。その幽霊の名前は何ですか？ああ、"}, {"type": "subtitle", "time": 10088.469, "timestamp": "02:48:08", "text": "ああ、確認するのを忘れてた。"}, {"type": "subtitle", "time": 10090.309, "timestamp": "02:48:10", "text": "いいえ、ゴーストネームは必要ありません。私たちは"}, {"type": "subtitle", "time": 10092.95, "timestamp": "02:48:12", "text": "現時点では集計する必要はありません。私は思う"}, {"type": "subtitle", "time": 10096.95, "timestamp": "02:48:16", "text": "私たちは死ぬだろう。ロリ。ロリ。いいえ、お父さん。私たちは"}, {"type": "subtitle", "time": 10098.79, "timestamp": "02:48:18", "text": "一瞬で死ぬだろう。やめてください"}, {"type": "subtitle", "time": 10100.55, "timestamp": "02:48:20", "text": "それ。"}, {"type": "subtitle", "time": 10102.71, "timestamp": "02:48:22", "text": "誰かの笑い声が聞こえましたか？聞いた？"}, {"type": "subtitle", "time": 10105.67, "timestamp": "02:48:25", "text": "誰か笑った？あなたは"}, {"type": "subtitle", "time": 10108.15, "timestamp": "02:48:28", "text": "わかりました、それが私が言った唯一の理由です"}, {"type": "subtitle", "time": 10111.19, "timestamp": "02:48:31", "text": "幽霊の名前は口にしてはいけない。私はかなり"}, {"type": "subtitle", "time": 10115.55, "timestamp": "02:48:35", "text": "もちろん。いや、いや、いや。彼らが"}, {"type": "subtitle", "time": 10118.55, "timestamp": "02:48:38", "text": "ここ。ああ、震えが止まらない。神様、私は"}, {"type": "subtitle", "time": 10120.15, "timestamp": "02:48:40", "text": "震えている。"}, {"type": "subtitle", "time": 10123.11, "timestamp": "02:48:43", "text": "あなたはここにいますか？"}, {"type": "subtitle", "time": 10127.59, "timestamp": "02:48:47", "text": "待って、もしかしてブッシュトークを使ってるの？"}, {"type": "subtitle", "time": 10129.51, "timestamp": "02:48:49", "text": "よし、これのためにもう一つ必要なものがある"}, {"type": "subtitle", "time": 10132.15, "timestamp": "02:48:52", "text": "これらのどれも機能していません。"}, {"type": "subtitle", "time": 10134.469, "timestamp": "02:48:54", "text": "では、トラックに戻ります。参加します"}, {"type": "subtitle", "time": 10136.95, "timestamp": "02:48:56", "text": "トラック修理工場。一人でそこにいてはいけません。"}, {"type": "subtitle", "time": 10139.99, "timestamp": "02:48:59", "text": "お前は死ぬだろう。わかった。ええ、そうですね。さあ行こう"}]
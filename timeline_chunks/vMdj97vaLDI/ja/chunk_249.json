[{"type": "subtitle", "time": 14943.03, "timestamp": "04:09:03", "text": "エリア。あなたはここにいますか？"}, {"type": "subtitle", "time": 14947.07, "timestamp": "04:09:07", "text": "どこにいるの？ああ、なんてことだ、怖かったよ"}, {"type": "subtitle", "time": 14949.71, "timestamp": "04:09:09", "text": "ほとんど。それは"}, {"type": "subtitle", "time": 14951.83, "timestamp": "04:09:11", "text": "ガレージ。なぜ私はそれが"}, {"type": "subtitle", "time": 14954.55, "timestamp": "04:09:14", "text": "ガレージ？"}, {"type": "subtitle", "time": 14957.269, "timestamp": "04:09:17", "text": "そうかもしれない。ああ、そうだね。あ、待って、待って。は"}, {"type": "subtitle", "time": 14960.389, "timestamp": "04:09:20", "text": "汚いものはありますか？"}, {"type": "subtitle", "time": 14964.15, "timestamp": "04:09:24", "text": "わかったよ、サメ。はい。これを覚えておいてください。もし"}, {"type": "subtitle", "time": 14966.389, "timestamp": "04:09:26", "text": "汚れた水が出てくるよ、"}, {"type": "subtitle", "time": 14968.229, "timestamp": "04:09:28", "text": "写真を撮るべきだ、そうすれば"}, {"type": "subtitle", "time": 14970.309, "timestamp": "04:09:30", "text": "私たち"}, {"type": "subtitle", "time": 14973.429, "timestamp": "04:09:33", "text": "どうしてそんなこと全部知ってるの？兄弟、"}, {"type": "subtitle", "time": 14975.75, "timestamp": "04:09:35", "text": "シャワーを浴びたい？兄弟、君は"}, {"type": "subtitle", "time": 14977.59, "timestamp": "04:09:37", "text": "一緒にシャワーを浴びる？"}, {"type": "subtitle", "time": 14980.71, "timestamp": "04:09:40", "text": "え、どうやって？これは汚れた水ではありません。これ"}, {"type": "subtitle", "time": 14983.11, "timestamp": "04:09:43", "text": "しかし、水はきれいだ。"}, {"type": "subtitle", "time": 14986.07, "timestamp": "04:09:46", "text": "いいえ。汚れた水がある場合は、"}, {"type": "subtitle", "time": 14987.99, "timestamp": "04:09:47", "text": "写真。どうしてそんなにプロなの？何？は"}, {"type": "subtitle", "time": 14989.91, "timestamp": "04:09:49", "text": "あなた"}, {"type": "subtitle", "time": 14993.59, "timestamp": "04:09:53", "text": "遊んでいる人たちを見かけたんだけど？わかった。私は私は"}, {"type": "subtitle", "time": 14996.309, "timestamp": "04:09:56", "text": "私は、私は、私は、私は、プロとして復帰します。"}, {"type": "subtitle", "time": 14999.67, "timestamp": "04:09:59", "text": "わかった。いや、いや、いや、いや。私は死んだ"}]
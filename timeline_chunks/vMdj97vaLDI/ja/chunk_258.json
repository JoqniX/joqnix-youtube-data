[{"type": "subtitle", "time": 15487.95, "timestamp": "04:18:07", "text": "あなた"}, {"type": "subtitle", "time": 15491.429, "timestamp": "04:18:11", "text": "ドットプロジェクターが欲しかった。あなたは＿＿したいですか"}, {"type": "subtitle", "time": 15493.189, "timestamp": "04:18:13", "text": "購入 私にDOTを購入してほしいですか?"}, {"type": "subtitle", "time": 15495.51, "timestamp": "04:18:15", "text": "プロジェクターはいかがですか？"}, {"type": "subtitle", "time": 15498.149, "timestamp": "04:18:18", "text": "いや、いや。私たちは既に理解しています。ゲットゲット"}, {"type": "subtitle", "time": 15500.63, "timestamp": "04:18:20", "text": "それはフリーロードアウトに含まれるものですよね？いいえ、"}, {"type": "subtitle", "time": 15502.469, "timestamp": "04:18:22", "text": "いや、いや。無料で積み込みはできません。"}, {"type": "subtitle", "time": 15505.03, "timestamp": "04:18:25", "text": "ところで。参考までに。あなたは何を得るのですか"}, {"type": "subtitle", "time": 15507.91, "timestamp": "04:18:27", "text": "平均？ビデオカメラを手に入れましょう。あなた"}, {"type": "subtitle", "time": 15510.63, "timestamp": "04:18:30", "text": "あなたに合ったEMF測定器を入手してください。懐中電灯がもらえます。"}, {"type": "subtitle", "time": 15513.83, "timestamp": "04:18:33", "text": "D以外はすべて手に入ります"}, {"type": "subtitle", "time": 15516.149, "timestamp": "04:18:36", "text": "何か。"}, {"type": "subtitle", "time": 15520.87, "timestamp": "04:18:40", "text": "ああ、65ドルだよ。私は90ドル持っています"}, {"type": "subtitle", "time": 15523.99, "timestamp": "04:18:43", "text": "今、私が着ています。とても怖いです。おい、俺たちは"}]
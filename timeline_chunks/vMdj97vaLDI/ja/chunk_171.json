[{"type": "subtitle", "time": 10262.83, "timestamp": "02:51:02", "text": "マイナス。マイナスに転じる必要がある。"}, {"type": "subtitle", "time": 10266.55, "timestamp": "02:51:06", "text": "わかった。私のEMFはレベル5まで上がりました。"}, {"type": "subtitle", "time": 10267.99, "timestamp": "02:51:07", "text": "けれど。では、実際にそれを受け取ります"}, {"type": "subtitle", "time": 10272.79, "timestamp": "02:51:12", "text": "今のところ。はい。はい。 EMF5。イエス。"}, {"type": "subtitle", "time": 10275.349, "timestamp": "02:51:15", "text": "うん。赤い方。赤いやつ。"}, {"type": "subtitle", "time": 10277.51, "timestamp": "02:51:17", "text": "うん。わかった。もう1つ選びます"}, {"type": "subtitle", "time": 10279.23, "timestamp": "02:51:19", "text": "時間。あなたは"}, {"type": "subtitle", "time": 10281.71, "timestamp": "02:51:21", "text": "ここ？どこに"}, {"type": "subtitle", "time": 10285.51, "timestamp": "02:51:25", "text": "あなた？おっと。狩り、狩り、"}, {"type": "subtitle", "time": 10287.11, "timestamp": "02:51:27", "text": "狩り、狩り、狩り、狩り、"}, {"type": "subtitle", "time": 10288.79, "timestamp": "02:51:28", "text": "狩猟。私は死んだ。私は死んだ。私は私は"}, {"type": "subtitle", "time": 10290.469, "timestamp": "02:51:30", "text": "死んだ。"}, {"type": "subtitle", "time": 10292.87, "timestamp": "02:51:32", "text": "ああ、くそ。くそっ。くそっ。やり方がわからない"}, {"type": "subtitle", "time": 10294.07, "timestamp": "02:51:34", "text": "隠れる。どうやって隠れたらいいのかわからない。ああ、"}, {"type": "subtitle", "time": 10296.51, "timestamp": "02:51:36", "text": "神。何てことだ。恐ろしい不気味な"}, {"type": "subtitle", "time": 10299.19, "timestamp": "02:51:39", "text": "バック。何てことだ。何てことだ。私はほしくない"}, {"type": "subtitle", "time": 10303.349, "timestamp": "02:51:43", "text": "それで、おばあさん、私は自分が"}, {"type": "subtitle", "time": 10306.23, "timestamp": "02:51:46", "text": "女性恐怖症。わからない。おお、"}, {"type": "subtitle", "time": 10309.59, "timestamp": "02:51:49", "text": "わかった。ジョック、君はどこにいるの？参加します"}, {"type": "subtitle", "time": 10312.55, "timestamp": "02:51:52", "text": "私はクローゼットの中にいる。死んだ。"}, {"type": "subtitle", "time": 10317.83, "timestamp": "02:51:57", "text": "死んだ。はい。なんてこった。お前は死んだ。なんてこった。"}]
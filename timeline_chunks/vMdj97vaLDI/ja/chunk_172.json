[{"type": "subtitle", "time": 10320.12, "timestamp": "02:52:00", "text": "なんてこった。 おっと。彼女は私の近くにいる。彼女は私の近くにいる。おお、"}, {"type": "subtitle", "time": 10323.12, "timestamp": "02:52:03", "text": "おっと。彼女は私の近くにいる。彼女は私の近くにいる。おお、 私は死んだ。私は死んだ。"}, {"type": "subtitle", "time": 10324.6, "timestamp": "02:52:04", "text": "私は死んだ。私は死んだ。 右。私は完全に死んでいます。私はほぼ"}, {"type": "subtitle", "time": 10327.04, "timestamp": "02:52:07", "text": "右。私は完全に死んでいます。私はほぼ 私もすぐ後を追います。ええ、そうです。はい。"}, {"type": "subtitle", "time": 10330.64, "timestamp": "02:52:10", "text": "私もすぐ後を追います。ええ、そうです。はい。 私は死んだ。"}, {"type": "subtitle", "time": 10337.75, "timestamp": "02:52:17", "text": "何てことだ。腰が痛くなった。何てことだ。見て"}, {"type": "subtitle", "time": 10341.19, "timestamp": "02:52:21", "text": "彼が死ぬまで。何てことだ。おお。"}, {"type": "subtitle", "time": 10343.269, "timestamp": "02:52:23", "text": "私は自分が死んだと確信していました。"}, {"type": "subtitle", "time": 10346.469, "timestamp": "02:52:26", "text": "だから、私はあまり感じないんです。"}, {"type": "subtitle", "time": 10351.269, "timestamp": "02:52:31", "text": "カメラを取り出すべきだった。"}, {"type": "subtitle", "time": 10353.19, "timestamp": "02:52:33", "text": "いいえ、大丈夫です。いいえ、あまり心配しないでください"}, {"type": "subtitle", "time": 10359.55, "timestamp": "02:52:39", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 10363.349, "timestamp": "02:52:43", "text": "5ドル稼いだぜ、兄弟。何てことだ。わかった、"}, {"type": "subtitle", "time": 10367.19, "timestamp": "02:52:47", "text": "私たちは2ドル稼ぎました。ああ、なんてことだ。"}, {"type": "subtitle", "time": 10369.99, "timestamp": "02:52:49", "text": "私たちは2ドル稼いだ。はい。良い。なぜ"}, {"type": "subtitle", "time": 10371.91, "timestamp": "02:52:51", "text": "あなた"}, {"type": "subtitle", "time": 10373.429, "timestamp": "02:52:53", "text": "ニース。クール、クール、クール。私はしたい"}, {"type": "subtitle", "time": 10375.67, "timestamp": "02:52:55", "text": "別の試合。実際、楽しかったよ。"}, {"type": "subtitle", "time": 10377.83, "timestamp": "02:52:57", "text": "ええ、もちろんです。"}, {"type": "subtitle", "time": 10379.23, "timestamp": "02:52:59", "text": "わかった。わかった。さあ、さあ"}]
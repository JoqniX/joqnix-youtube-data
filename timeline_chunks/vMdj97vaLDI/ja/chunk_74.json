[{"type": "subtitle", "time": 4440.79, "timestamp": "01:14:00", "text": "だから、500ドル以下で手に入れることができる"}, {"type": "subtitle", "time": 4443.03, "timestamp": "01:14:03", "text": "本当に美味しい食事でした。つまり、"}, {"type": "subtitle", "time": 4445.03, "timestamp": "01:14:05", "text": "場所によっては、どれが良いかを見るだけでも良い"}, {"type": "subtitle", "time": 4446.709, "timestamp": "01:14:06", "text": "都道府県とはどの地域ですか"}, {"type": "subtitle", "time": 4448.35, "timestamp": "01:14:08", "text": "なぜなら、あなたが行くととても奇妙だから"}, {"type": "subtitle", "time": 4450.87, "timestamp": "01:14:10", "text": "給料をもらっている男性たちの周りには、"}, {"type": "subtitle", "time": 4454.07, "timestamp": "01:14:14", "text": "すでに非常に過労状態にあると言える"}, {"type": "subtitle", "time": 4456.07, "timestamp": "01:14:16", "text": "この配信が終わったら行かなければならないので"}, {"type": "subtitle", "time": 4462.95, "timestamp": "01:14:22", "text": "仕事。だから、そうかもしれないと思う"}, {"type": "subtitle", "time": 4464.39, "timestamp": "01:14:24", "text": "非常に過労で、彼らは"}, {"type": "subtitle", "time": 4467.11, "timestamp": "01:14:27", "text": "尾行されるなどの厄介事に対処する。"}, {"type": "subtitle", "time": 4469.75, "timestamp": "01:14:29", "text": "だから、どの会社でもいいから行って、"}, {"type": "subtitle", "time": 4473.669, "timestamp": "01:14:33", "text": "もしあなたが何か見かけたら"}, {"type": "subtitle", "time": 4475.83, "timestamp": "01:14:35", "text": "サラリーマンは白い服を着ているのが見える"}, {"type": "subtitle", "time": 4477.669, "timestamp": "01:14:37", "text": "そして黒色で、もしあなたがそれらを見たら"}, {"type": "subtitle", "time": 4479.83, "timestamp": "01:14:39", "text": "似たようなレストランから出てくる"}, {"type": "chat", "time": 4481.549, "timestamp": "01:14:41", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "how about LAWSONS?"}, {"type": "subtitle", "time": 4481.83, "timestamp": "01:14:41", "text": "レストランは小さな屋台のようなもの"}, {"type": "subtitle", "time": 4483.83, "timestamp": "01:14:43", "text": "食料品店などすべてチェックしてみてください"}, {"type": "subtitle", "time": 4486.47, "timestamp": "01:14:46", "text": "まず価格を教えて、それから購入してください"}, {"type": "subtitle", "time": 4489.11, "timestamp": "01:14:49", "text": "持ち帰りシステムはありません。だからもしあなたが"}, {"type": "subtitle", "time": 4491.03, "timestamp": "01:14:51", "text": "食べ物を買ったら、必ず全部食べきってください。"}, {"type": "subtitle", "time": 4492.95, "timestamp": "01:14:52", "text": "そうでなければ、こうなるでしょう"}, {"type": "subtitle", "time": 4494.709, "timestamp": "01:14:54", "text": "本当に迷子になった。ローエンはどうでしょう？うん、"}, {"type": "subtitle", "time": 4496.79, "timestamp": "01:14:56", "text": "レンソン・ブラック社。 Loenは会社です。"}, {"type": "subtitle", "time": 4499.11, "timestamp": "01:14:59", "text": "ファミリーマークはセブンイレブン傘下の企業です。私"}]
[{"type": "subtitle", "time": 6420.95, "timestamp": "01:47:00", "text": "私はそれが好きではありません。食べ物は"}, {"type": "subtitle", "time": 6422.709, "timestamp": "01:47:02", "text": "最悪だ。行くつもりなら"}, {"type": "subtitle", "time": 6424.149, "timestamp": "01:47:04", "text": "食事のためではなく、体験のためだ。"}, {"type": "subtitle", "time": 6425.91, "timestamp": "01:47:05", "text": "私はいつもそう言っています。食べ物は"}, {"type": "subtitle", "time": 6427.669, "timestamp": "01:47:07", "text": "くそっ。"}, {"type": "subtitle", "time": 6431.43, "timestamp": "01:47:11", "text": "彼らはあなたにモとかそういうことをさせるんです。あなた"}, {"type": "subtitle", "time": 6433.109, "timestamp": "01:47:13", "text": "それはできますが、食べ物はとても"}, {"type": "subtitle", "time": 6435.27, "timestamp": "01:47:15", "text": "最悪だ。だから、食べ物目当てで行かない方がいいよ。しかし"}, {"type": "subtitle", "time": 6444.709, "timestamp": "01:47:24", "text": "ええ、高いですね。何てことだ。それは"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "外国人税のため、または"}, {"type": "subtitle", "time": 6449.35, "timestamp": "01:47:29", "text": "何か？通常は高価です。それ"}, {"type": "subtitle", "time": 6451.51, "timestamp": "01:47:31", "text": "通常でも高価です"}, {"type": "subtitle", "time": 6453.83, "timestamp": "01:47:33", "text": "普通の人々。うん。いや、そうじゃない"}, {"type": "subtitle", "time": 6455.99, "timestamp": "01:47:35", "text": "外国人のように、"}, {"type": "subtitle", "time": 6458.95, "timestamp": "01:47:38", "text": "メッドカフェは主に食べ物のためではなく、"}, {"type": "subtitle", "time": 6460.47, "timestamp": "01:47:40", "text": "人々とエンターテイメントと"}, {"type": "subtitle", "time": 6462.91, "timestamp": "01:47:42", "text": "テーマ。だから、もしあなたがどこかに行くなら"}, {"type": "subtitle", "time": 6465.43, "timestamp": "01:47:45", "text": "レストランでは、食べ物が"}, {"type": "subtitle", "time": 6467.109, "timestamp": "01:47:47", "text": "高額になるでしょう。もしあなたがただ行くだけなら"}, {"type": "subtitle", "time": 6470.39, "timestamp": "01:47:50", "text": "どんなカフェでも、どんなレストランでも、うん、"}, {"type": "subtitle", "time": 6471.55, "timestamp": "01:47:51", "text": "そうなる"}, {"type": "subtitle", "time": 6474.07, "timestamp": "01:47:54", "text": "2,000以下の安い価格で、"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "食事。カツ丼は、"}, {"type": "subtitle", "time": 6479.189, "timestamp": "01:47:59", "text": "何？ 2,000円、2,500円。それはとても"}]
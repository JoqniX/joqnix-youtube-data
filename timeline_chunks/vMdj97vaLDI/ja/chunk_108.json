[{"type": "subtitle", "time": 6480.47, "timestamp": "01:48:00", "text": "通常価格。でも、もしあなたが行くなら"}, {"type": "chat", "time": 6481.827, "timestamp": "01:48:01", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "how about macca?"}, {"type": "subtitle", "time": 6482.87, "timestamp": "01:48:02", "text": "Metapなどが好きなら、"}, {"type": "chat", "time": 6484.449, "timestamp": "01:48:04", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "for alcohol, I rarely like clear alcohol. I prefer aged alcohol like whiskey or brandy"}, {"type": "subtitle", "time": 6485.109, "timestamp": "01:48:05", "text": "最悪の食べ物だが、"}, {"type": "subtitle", "time": 6493.51, "timestamp": "01:48:13", "text": "通貨換算を安定させる必要がある"}, {"type": "subtitle", "time": 6495.99, "timestamp": "01:48:15", "text": "もの。慣れるよ"}, {"type": "subtitle", "time": 6498.229, "timestamp": "01:48:18", "text": "通貨について言えば、"}, {"type": "subtitle", "time": 6503.189, "timestamp": "01:48:23", "text": "それは主に現金経済です"}, {"type": "subtitle", "time": 6506.709, "timestamp": "01:48:26", "text": "カードを使ってもいいけど、"}, {"type": "subtitle", "time": 6509.27, "timestamp": "01:48:29", "text": "常に財布を持ち歩くことをお勧めします。もし"}, {"type": "subtitle", "time": 6510.87, "timestamp": "01:48:30", "text": "あなたは財布を持っている、いいですか、"}, {"type": "subtitle", "time": 6511.79, "timestamp": "01:48:31", "text": "何もない"}, {"type": "subtitle", "time": 6516.709, "timestamp": "01:48:36", "text": "男性、特に男性について、私の話を聞いてください。"}, {"type": "subtitle", "time": 6519.189, "timestamp": "01:48:39", "text": "財布を用意して、小銭を入れる"}, {"type": "subtitle", "time": 6521.83, "timestamp": "01:48:41", "text": "ポケットは、500までだと思うから"}, {"type": "subtitle", "time": 6523.27, "timestamp": "01:48:43", "text": "円では、コインがあり、"}, {"type": "subtitle", "time": 6525.35, "timestamp": "01:48:45", "text": "たくさんのコインを手に入れよう。だから、もしあなたが購入しているなら"}, {"type": "subtitle", "time": 6527.109, "timestamp": "01:48:47", "text": "財布、さらに"}, {"type": "subtitle", "time": 6529.35, "timestamp": "01:48:49", "text": "小銭入れ。コインを入れるだけでいいですよ"}, {"type": "subtitle", "time": 6531.189, "timestamp": "01:48:51", "text": "内部。"}, {"type": "subtitle", "time": 6533.35, "timestamp": "01:48:53", "text": "うん。うん。そうでなければ、もしあなたが"}, {"type": "subtitle", "time": 6534.79, "timestamp": "01:48:54", "text": "ポーチバッグのようなバッグを持ち運ぶ"}, {"type": "subtitle", "time": 6536.31, "timestamp": "01:48:56", "text": "コインエリアがある"}, {"type": "subtitle", "time": 6538.709, "timestamp": "01:48:58", "text": "なぜなら、あなたは大量のコインを手に入れるからです"}]
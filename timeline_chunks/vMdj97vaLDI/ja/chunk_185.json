[{"type": "subtitle", "time": 11103.79, "timestamp": "03:05:03", "text": "わかった。わかった。心を開いて。私たちは準備ができています"}, {"type": "subtitle", "time": 11128.11, "timestamp": "03:05:28", "text": "なんてこった。"}, {"type": "subtitle", "time": 11131.91, "timestamp": "03:05:31", "text": "不気味で恐ろしい骸骨。なぜ"}, {"type": "subtitle", "time": 11141.349, "timestamp": "03:05:41", "text": "バイバイ。おい。わかった。吹く。ああ、私は近くにいます"}, {"type": "subtitle", "time": 11144.87, "timestamp": "03:05:44", "text": "発電機のある場所へ。私は思う。"}, {"type": "subtitle", "time": 11148.469, "timestamp": "03:05:48", "text": "待って。発電機はどこにありますか？"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "私はその件に関わっています。ああ、私は持っていません"}, {"type": "subtitle", "time": 11154.55, "timestamp": "03:05:54", "text": "分析。ああ、くそ。分析はありません"}, {"type": "subtitle", "time": 11158.51, "timestamp": "03:05:58", "text": "私の持ち物。私はただバカなことをしているだけです"}]
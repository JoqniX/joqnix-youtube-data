[{"type": "subtitle", "time": 9541.67, "timestamp": "02:39:01", "text": "心配しないで。私はあなたと一緒にいます"}, {"type": "subtitle", "time": 9543.75, "timestamp": "02:39:03", "text": "永遠に。心配しないで。私は去らない"}, {"type": "subtitle", "time": 9547.91, "timestamp": "02:39:07", "text": "あなた。あ、こんにちは。良い。感謝します。わかった。"}, {"type": "subtitle", "time": 9551.59, "timestamp": "02:39:11", "text": "とにかく、これを追加します。追加します"}, {"type": "subtitle", "time": 9554.07, "timestamp": "02:39:14", "text": "私は[ __ ]を追加します。懐中電灯を追加します。"}, {"type": "subtitle", "time": 9556.71, "timestamp": "02:39:16", "text": "本を1冊追加します。ラジオを追加するよ"}, {"type": "subtitle", "time": 9561.51, "timestamp": "02:39:21", "text": "もの。うんちを追加します。えーと、"}, {"type": "subtitle", "time": 9565.59, "timestamp": "02:39:25", "text": "温度計みたいなもの。塩を加えます。"}, {"type": "subtitle", "time": 9568.55, "timestamp": "02:39:28", "text": "あなたはとてもお金持ちですね。君は頑張っているね。"}, {"type": "subtitle", "time": 9571.19, "timestamp": "02:39:31", "text": "いや。ああ、なんてことだ。いいえ、持っていません"}, {"type": "subtitle", "time": 9573.75, "timestamp": "02:39:33", "text": "お金。あなたは何について話しているのですか？どうやって"}, {"type": "subtitle", "time": 9576.79, "timestamp": "02:39:36", "text": "あなたは？追加しようよ、追加しないよ"}, {"type": "subtitle", "time": 9579.51, "timestamp": "02:39:39", "text": "知る。いくつか追加しました。もしそこにあれば"}, {"type": "subtitle", "time": 9581.349, "timestamp": "02:39:41", "text": "トラックの中には何も入っていません。"}, {"type": "subtitle", "time": 9582.51, "timestamp": "02:39:42", "text": "私は違います 私は"}, {"type": "subtitle", "time": 9586.71, "timestamp": "02:39:46", "text": "この部屋に行きたいのですか？どれの"}, {"type": "subtitle", "time": 9589.11, "timestamp": "02:39:49", "text": "1つ？どの地図を選びますか？いいえ、"}, {"type": "subtitle", "time": 9591.91, "timestamp": "02:39:51", "text": "いや、いや。おいおい、J。こっちに来いよ。"}, {"type": "subtitle", "time": 9594.95, "timestamp": "02:39:54", "text": "どれ？私はここにいます。私はここにいます。いや、いや。"}, {"type": "subtitle", "time": 9598.07, "timestamp": "02:39:58", "text": "ここに来て。今すぐ降りてきて。"}]
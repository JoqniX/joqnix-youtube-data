[{"type": "subtitle", "time": 8702.469, "timestamp": "02:25:02", "text": "本当に心配です。いいえ、いいえ、"}, {"type": "subtitle", "time": 8704.389, "timestamp": "02:25:04", "text": "いや、いや。心配しないで。私たちは止めるつもりだ。"}, {"type": "subtitle", "time": 8706.469, "timestamp": "02:25:06", "text": "物事を始める、つまり、"}, {"type": "subtitle", "time": 8712.99, "timestamp": "02:25:12", "text": "また、あなたの"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "クラスモポビア、あなたは"}, {"type": "subtitle", "time": 8718.11, "timestamp": "02:25:18", "text": "私よりもちょっと臆病な方だ。"}, {"type": "subtitle", "time": 8721.99, "timestamp": "02:25:21", "text": "まあ、少なくともソロマッチはできたからいいか。私"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "私はそれを完了しませんでした。私は逃げた"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "叫び声。私は、あなたが見たと思います"}, {"type": "subtitle", "time": 8730.469, "timestamp": "02:25:30", "text": "一瞬。"}, {"type": "subtitle", "time": 8732.23, "timestamp": "02:25:32", "text": "その瞬間。そうそう。私も"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "そこにも、素早い瞬間を投稿した。だから、もし"}, {"type": "subtitle", "time": 8737.429, "timestamp": "02:25:37", "text": "見たいなら、見に行けばいい。おお、"}, {"type": "subtitle", "time": 8739.11, "timestamp": "02:25:39", "text": "ニース。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "ああ、ショートパンツが怖くてたまらないよ。私"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "わからない。パニックになってる、わからない。私"}, {"type": "subtitle", "time": 8745.429, "timestamp": "02:25:45", "text": "どうすればいいのかわからない。試着しています"}, {"type": "subtitle", "time": 8748.23, "timestamp": "02:25:48", "text": "新商品。うん。うん。私は手に入れる必要がある"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "私はショートパンツとかが好きだけど、"}, {"type": "subtitle", "time": 8752.63, "timestamp": "02:25:52", "text": "混乱しているんです。面白い"}, {"type": "subtitle", "time": 8755.51, "timestamp": "02:25:55", "text": "良い瞬間とは何か？私はしません"}, {"type": "subtitle", "time": 8758.07, "timestamp": "02:25:58", "text": "知る。わからない。えっと、私は昔好きだった"}]
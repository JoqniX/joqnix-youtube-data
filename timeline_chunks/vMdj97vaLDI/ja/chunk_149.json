[{"type": "subtitle", "time": 8942.55, "timestamp": "02:29:02", "text": "Shiftキーを押しながらTabキーを押す。わかった。 Shiftキーを押しながらTabキーを押す。わかった。私にさせて"}, {"type": "subtitle", "time": 8945.67, "timestamp": "02:29:05", "text": "ご招待します。待って、どうやって招待するの？"}, {"type": "subtitle", "time": 8948.99, "timestamp": "02:29:08", "text": "待って、どうやって質問を招待するの？"}, {"type": "subtitle", "time": 8952.27, "timestamp": "02:29:12", "text": "マーク？なんてこった。"}, {"type": "subtitle", "time": 8956.55, "timestamp": "02:29:16", "text": "わかった。あなたが何をするかは、ああ、人々は"}, {"type": "subtitle", "time": 8958.55, "timestamp": "02:29:18", "text": "質問は最後まで書きましたか？わかった。はい、私たちは"}, {"type": "subtitle", "time": 8967.99, "timestamp": "02:29:27", "text": "彼のリンクは説明欄にあります。もし"}, {"type": "subtitle", "time": 8970.95, "timestamp": "02:29:30", "text": "私たち二人の視点を見たいなら、チェックしてください"}, {"type": "subtitle", "time": 8972.63, "timestamp": "02:29:32", "text": "コメント内のリンクまたは"}, {"type": "subtitle", "time": 8974.55, "timestamp": "02:29:34", "text": "説明。問題はそこだ。はい、私は名前を付けました"}, {"type": "subtitle", "time": 8979.429, "timestamp": "02:29:39", "text": "マリオがアノスになった姿。何？ A N O S。"}, {"type": "subtitle", "time": 8981.75, "timestamp": "02:29:41", "text": "彼はそれについて怒っていなかった。だから、私はとても"}, {"type": "subtitle", "time": 8983.83, "timestamp": "02:29:43", "text": "彼が「ああ」とか言わなかったのが嬉しい。"}, {"type": "subtitle", "time": 8986.03, "timestamp": "02:29:46", "text": "マリオのジョークをあなたに"}, {"type": "subtitle", "time": 8989.309, "timestamp": "02:29:49", "text": "何でも。それは嬉しいです。"}]
[{"type": "subtitle", "time": 13260.389, "timestamp": "03:41:00", "text": "私たちはそれを使っていないと思います。いや、いや、いや、"}, {"type": "subtitle", "time": 13262.389, "timestamp": "03:41:02", "text": "いいえ。 1つだけ使えばいい。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 13264.95, "timestamp": "03:41:04", "text": "わかった。私は1つ買いました。とった。追加した"}, {"type": "subtitle", "time": 13268.79, "timestamp": "03:41:08", "text": "1つ。おい。わかった。わかった。"}, {"type": "subtitle", "time": 13271.75, "timestamp": "03:41:11", "text": "温度計はありますか？はい。私"}, {"type": "subtitle", "time": 13274.55, "timestamp": "03:41:14", "text": "見えないよ、ああ、それはちょっと待って。スクロール"}, {"type": "subtitle", "time": 13276.469, "timestamp": "03:41:16", "text": "下。うん。うん。うん。うん。私は見えます"}, {"type": "subtitle", "time": 13278.79, "timestamp": "03:41:18", "text": "温度計はもうあります。よし、"}, {"type": "subtitle", "time": 13280.63, "timestamp": "03:41:20", "text": "さあ行こう。"}, {"type": "subtitle", "time": 13282.469, "timestamp": "03:41:22", "text": "温度計が本当に必要だから"}, {"type": "subtitle", "time": 13284.309, "timestamp": "03:41:24", "text": "私には理解できないので"}, {"type": "subtitle", "time": 13296.95, "timestamp": "03:41:36", "text": "スクリーンはどうなったのですか？"}, {"type": "subtitle", "time": 13299.91, "timestamp": "03:41:39", "text": "悪夢の世界へようこそ、兄弟。これは"}, {"type": "subtitle", "time": 13302.15, "timestamp": "03:41:42", "text": "私の"}, {"type": "subtitle", "time": 13303.83, "timestamp": "03:41:43", "text": "狩猟を阻止する"}, {"type": "subtitle", "time": 13305.349, "timestamp": "03:41:45", "text": "十字架。"}, {"type": "subtitle", "time": 13307.269, "timestamp": "03:41:47", "text": "幽霊を目撃したらどうなるか考えてみよう"}, {"type": "subtitle", "time": 13311.67, "timestamp": "03:41:51", "text": "イベント。よし、少なくとも私はそれを目撃できる。"}, {"type": "subtitle", "time": 13313.349, "timestamp": "03:41:53", "text": "目撃者、そしてあなたは生きている必要があります"}, {"type": "subtitle", "time": 13315.75, "timestamp": "03:41:55", "text": "分。それで、"}]
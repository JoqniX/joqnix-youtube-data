[{"type": "subtitle", "time": 11340.71, "timestamp": "03:09:00", "text": "EMFレベルは？だってそれはただ"}, {"type": "subtitle", "time": 11343.03, "timestamp": "03:09:03", "text": "飛行機。それは、もう少しで理解できそうだった"}, {"type": "subtitle", "time": 11345.51, "timestamp": "03:09:05", "text": "二。"}, {"type": "subtitle", "time": 11347.51, "timestamp": "03:09:07", "text": "危うく2つ目をクリックするところだった。わかりました。"}, {"type": "subtitle", "time": 11350.55, "timestamp": "03:09:10", "text": "氷点下の気温。そうです。わかった。"}, {"type": "subtitle", "time": 11356.469, "timestamp": "03:09:16", "text": "見てみましょう。えっと、確認してもらえますか？"}, {"type": "subtitle", "time": 11359.91, "timestamp": "03:09:19", "text": "私が植えたから幽霊がいないか確認するんだ"}, {"type": "subtitle", "time": 11361.99, "timestamp": "03:09:21", "text": "いくつかの"}, {"type": "subtitle", "time": 11365.83, "timestamp": "03:09:25", "text": "待って。えっと、ゴーストソース。確認方法は？"}, {"type": "subtitle", "time": 11367.67, "timestamp": "03:09:27", "text": "ああ、迷彩柄のやつみたいにね。私は植えました"}, {"type": "subtitle", "time": 11371.03, "timestamp": "03:09:31", "text": "迷彩柄。ああ、わかりました。おお。おお。おお。心に残る。"}, {"type": "subtitle", "time": 11372.71, "timestamp": "03:09:32", "text": "心に残る。私は死んだ。私は死んだ。仕事。私は"}, {"type": "subtitle", "time": 11374.71, "timestamp": "03:09:34", "text": "死んだ。私は死んだ。私は死んだ。私は死んだ。私は"}, {"type": "subtitle", "time": 11377.19, "timestamp": "03:09:37", "text": "死んだ。私は死んだ。どこでどこで"}, {"type": "subtitle", "time": 11383.11, "timestamp": "03:09:43", "text": "あなた？あなたはどのように亡くなったのですか？"}, {"type": "subtitle", "time": 11385.67, "timestamp": "03:09:45", "text": "えっと、それは、いいえ、いいえ、いいえの中にあります。その"}, {"type": "subtitle", "time": 11389.91, "timestamp": "03:09:49", "text": "大丈夫です。わかった。ああ、私は死んだ。"}, {"type": "subtitle", "time": 11393.63, "timestamp": "03:09:53", "text": "だから、あまり心配しないでください。私"}, {"type": "subtitle", "time": 11396.51, "timestamp": "03:09:56", "text": "いいと思う。"}, {"type": "subtitle", "time": 11398.91, "timestamp": "03:09:58", "text": "ジャーナルゴースト"}]
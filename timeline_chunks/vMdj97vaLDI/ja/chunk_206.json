[{"type": "subtitle", "time": 12361.349, "timestamp": "03:26:01", "text": "床に。 EMFを落とさないでください。あなた"}, {"type": "subtitle", "time": 12364.229, "timestamp": "03:26:04", "text": "電磁波は要らない。うん。うん。見て、"}, {"type": "subtitle", "time": 12366.389, "timestamp": "03:26:06", "text": "見て。私はろうそくを植え、"}, {"type": "subtitle", "time": 12368.15, "timestamp": "03:26:08", "text": "戻ってきて、EMFを拾ってください。それで、"}, {"type": "subtitle", "time": 12369.51, "timestamp": "03:26:09", "text": "ご心配なく。わかった。わかった。"}, {"type": "subtitle", "time": 12373.03, "timestamp": "03:26:13", "text": "わかった。わかった。さあ行こう。"}, {"type": "subtitle", "time": 12375.67, "timestamp": "03:26:15", "text": "うん。こんにちは、ジェイミー。あけましておめでとう。どうやって"}, {"type": "subtitle", "time": 12378.389, "timestamp": "03:26:18", "text": "あなたは？新年が良い年であることを願っています"}, {"type": "subtitle", "time": 12380.469, "timestamp": "03:26:20", "text": "良い。"}, {"type": "subtitle", "time": 12390.309, "timestamp": "03:26:30", "text": "このドアは何らかの理由で開いています。"}, {"type": "subtitle", "time": 12392.71, "timestamp": "03:26:32", "text": "これは怪しい。"}, {"type": "subtitle", "time": 12394.71, "timestamp": "03:26:34", "text": "サス。あなたは死ぬでしょう"}, {"type": "subtitle", "time": 12396.229, "timestamp": "03:26:36", "text": "次は2番目です。はい、私たちです。私はしません"}, {"type": "subtitle", "time": 12397.83, "timestamp": "03:26:37", "text": "知る。早速本題に入ります。"}, {"type": "subtitle", "time": 12400.389, "timestamp": "03:26:40", "text": "わからない。私は死ぬだろう。そこには"}, {"type": "subtitle", "time": 12402.71, "timestamp": "03:26:42", "text": "トイレ。ああ、私たちは死ぬんだ。だった"}, {"type": "subtitle", "time": 12404.389, "timestamp": "03:26:44", "text": "死ぬぞ、ジャック。あなたは何者ですか？何"}, {"type": "subtitle", "time": 12406.63, "timestamp": "03:26:46", "text": "つまりそういうことですか？"}, {"type": "subtitle", "time": 12410.309, "timestamp": "03:26:50", "text": "こっちに明かりがあるよ。何てことだ。"}, {"type": "subtitle", "time": 12412.389, "timestamp": "03:26:52", "text": "ああ、光が見える。それは素晴らしいですね。わかった、"}, {"type": "subtitle", "time": 12414.55, "timestamp": "03:26:54", "text": "ここはどこ？ところで、一つだけ"}, {"type": "subtitle", "time": 12418.469, "timestamp": "03:26:58", "text": "私はファスモフォビアが本当に苦手で、"}]
[{"type": "subtitle", "time": 8762.389, "timestamp": "02:26:02", "text": "えーっと、YouTubeに投稿するみたいな感じ"}, {"type": "subtitle", "time": 8766.469, "timestamp": "02:26:06", "text": "えっと、YouTube関連の動画をよく見ます。それで何が起こったのか"}, {"type": "subtitle", "time": 8769.51, "timestamp": "02:26:09", "text": "まるで私がビデオを作っていた頃のように"}, {"type": "subtitle", "time": 8773.03, "timestamp": "02:26:13", "text": "YouTube。だから私も、"}, {"type": "subtitle", "time": 8776.23, "timestamp": "02:26:16", "text": "YouTube の最高の瞬間も、私が"}, {"type": "subtitle", "time": 8779.349, "timestamp": "02:26:19", "text": "前回。だから、私が"}, {"type": "subtitle", "time": 8781.67, "timestamp": "02:26:21", "text": "知っているように、そうやってあなたは知るのです"}, {"type": "subtitle", "time": 8783.59, "timestamp": "02:26:23", "text": "あなたがやっていることは、そこに"}, {"type": "subtitle", "time": 8785.03, "timestamp": "02:26:25", "text": "これは良い瞬間です これは悪い瞬間です"}, {"type": "subtitle", "time": 8786.15, "timestamp": "02:26:26", "text": "一瞬。"}, {"type": "subtitle", "time": 8787.67, "timestamp": "02:26:27", "text": "これは恥ずかしい。これは"}, {"type": "subtitle", "time": 8789.75, "timestamp": "02:26:29", "text": "恥ずかしい。ご存知だと思いますが"}, {"type": "subtitle", "time": 8793.03, "timestamp": "02:26:33", "text": "それ。きっと許してくれるでしょう。自分"}, {"type": "subtitle", "time": 8795.19, "timestamp": "02:26:35", "text": "あなたに会えるのを楽しみにしています。ああ、神様。わかった。何でも"}, {"type": "subtitle", "time": 8797.03, "timestamp": "02:26:37", "text": "あなたがやっていることは、きっとできると思います"}, {"type": "subtitle", "time": 8801.03, "timestamp": "02:26:41", "text": "まるで10倍も知らないような感じ。できます"}, {"type": "subtitle", "time": 8804.95, "timestamp": "02:26:44", "text": "私が何をしているかはともかく、あなたにもそれができます。えっと"}, {"type": "subtitle", "time": 8807.99, "timestamp": "02:26:47", "text": "私はとても大丈夫です。あなたは"}, {"type": "subtitle", "time": 8810.63, "timestamp": "02:26:50", "text": "少し低いですが、これをやればまあまあの仕事になります"}, {"type": "subtitle", "time": 8814.07, "timestamp": "02:26:54", "text": "話す。わかった。少しピークがありますが"}, {"type": "subtitle", "time": 8816.63, "timestamp": "02:26:56", "text": "まあ、いいんじゃない？私はそうは思わない"}, {"type": "subtitle", "time": 8819.83, "timestamp": "02:26:59", "text": "私のオーディオは大音量だと思います"}]
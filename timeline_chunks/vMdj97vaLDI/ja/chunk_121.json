[{"type": "subtitle", "time": 7261.75, "timestamp": "02:01:01", "text": "大阪に住んでいる知り合いがいる"}, {"type": "subtitle", "time": 7263.91, "timestamp": "02:01:03", "text": "そして、彼らは最近大阪に引っ越したとのことだ。"}, {"type": "subtitle", "time": 7266.229, "timestamp": "02:01:06", "text": "だから、どうやって引っ越したのか聞くことができる"}, {"type": "subtitle", "time": 7268.95, "timestamp": "02:01:08", "text": "私にとっては、"}, {"type": "subtitle", "time": 7270.79, "timestamp": "02:01:10", "text": "何ヶ月も行かなかった"}, {"type": "subtitle", "time": 7272.55, "timestamp": "02:01:12", "text": "私はたった1ヶ月だけ行ったんです。だから、"}, {"type": "subtitle", "time": 7274.55, "timestamp": "02:01:14", "text": "問題は、私は何も買わなかったし、持ち歩かなかったということです"}, {"type": "subtitle", "time": 7275.99, "timestamp": "02:01:15", "text": "服は何も着ないつもりだったから"}, {"type": "subtitle", "time": 7277.87, "timestamp": "02:01:17", "text": "そこで服を買う"}, {"type": "subtitle", "time": 7281.83, "timestamp": "02:01:21", "text": "自体。そうですね"}, {"type": "subtitle", "time": 7284.149, "timestamp": "02:01:24", "text": "たくさんの物を持っていくか、買わないようにする"}, {"type": "subtitle", "time": 7285.109, "timestamp": "02:01:25", "text": "たくさんのもの"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "背中に戻って"}, {"type": "subtitle", "time": 7289.43, "timestamp": "02:01:29", "text": "そこは好きにならなければならない場所であり、"}, {"type": "subtitle", "time": 7291.91, "timestamp": "02:01:31", "text": "持ち帰る荷物がたくさんあるでしょう"}, {"type": "subtitle", "time": 7294.55, "timestamp": "02:01:34", "text": "家。うん。でも、彼らは"}, {"type": "subtitle", "time": 7295.91, "timestamp": "02:01:35", "text": "心配しなくて済むサービス"}, {"type": "subtitle", "time": 7298.55, "timestamp": "02:01:38", "text": "それについて。だから、もしあなたが"}, {"type": "subtitle", "time": 7300.47, "timestamp": "02:01:40", "text": "たくさんの物が必要なら小包で"}, {"type": "subtitle", "time": 7302.0, "timestamp": "02:01:42", "text": "彼ら。"}, {"type": "subtitle", "time": 7303.27, "timestamp": "02:01:43", "text": "[音楽]"}, {"type": "subtitle", "time": 7307.669, "timestamp": "02:01:47", "text": "うん。うん。そうするべきだ。うん。"}, {"type": "subtitle", "time": 7310.55, "timestamp": "02:01:50", "text": "それは、それは、それは、何も機能しません。でも私は"}, {"type": "subtitle", "time": 7312.95, "timestamp": "02:01:52", "text": "もうすぐ10時半になると思うんだけど、そうだよね？私"}, {"type": "subtitle", "time": 7316.31, "timestamp": "02:01:56", "text": "仕事に戻らなければならない。"}, {"type": "subtitle", "time": 7318.79, "timestamp": "02:01:58", "text": "だから私は自分のところに戻らなければならないと思う"}]
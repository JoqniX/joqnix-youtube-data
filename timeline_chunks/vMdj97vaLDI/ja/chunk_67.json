[{"type": "subtitle", "time": 4020.39, "timestamp": "01:07:00", "text": "飲んでいる時のあなた"}, {"type": "subtitle", "time": 4021.75, "timestamp": "01:07:01", "text": "そうして、彼らはあなたに請求します"}, {"type": "subtitle", "time": 4025.51, "timestamp": "01:07:05", "text": "それぞれ、1時間ごとに、そしてあなたは"}, {"type": "subtitle", "time": 4027.589, "timestamp": "01:07:07", "text": "飲み物を注文する料金もかかります"}, {"type": "subtitle", "time": 4030.47, "timestamp": "01:07:10", "text": "1時間ごとに。おお。何でも同じように"}, {"type": "subtitle", "time": 4031.99, "timestamp": "01:07:11", "text": "アルコール入りかノンアルコールかは、"}, {"type": "subtitle", "time": 4034.309, "timestamp": "01:07:14", "text": "あなた。だから、受け入れるしかないんです。だから私は"}, {"type": "subtitle", "time": 4036.71, "timestamp": "01:07:16", "text": "そういうカフェに一度行ったことがある。本当に"}, {"type": "subtitle", "time": 4038.71, "timestamp": "01:07:18", "text": "いいけど、次の順番で注文しないといけない"}, {"type": "subtitle", "time": 4041.029, "timestamp": "01:07:21", "text": "毎時間、そしてあなたも好きでなければなりません"}, {"type": "subtitle", "time": 4043.91, "timestamp": "01:07:23", "text": "その時間に対して時給で支払うので、"}, {"type": "subtitle", "time": 4046.549, "timestamp": "01:07:26", "text": "支払いをしなければならないのと同じだ"}, {"type": "subtitle", "time": 4048.39, "timestamp": "01:07:28", "text": "今はどうなっているかはわかりませんが、"}, {"type": "subtitle", "time": 4051.99, "timestamp": "01:07:31", "text": "確か当時は1個2000円くらいだったと思う"}, {"type": "subtitle", "time": 4053.91, "timestamp": "01:07:33", "text": "数時間後には別のものを買わなければならない"}, {"type": "chat", "time": 4056.208, "timestamp": "01:07:36", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yooo"}, {"type": "subtitle", "time": 4057.19, "timestamp": "01:07:37", "text": "飲み物代がさらに1000ドルもかかるなんて、なんてことだ"}, {"type": "subtitle", "time": 4059.91, "timestamp": "01:07:39", "text": "神様、お金は問題じゃない、俺に必要なのは"}, {"type": "subtitle", "time": 4062.23, "timestamp": "01:07:42", "text": "それはあなたが持っていることができます、あなたはそれを持っています"}, {"type": "subtitle", "time": 4064.87, "timestamp": "01:07:44", "text": "猫カフェは本当に素敵ですよ。"}, {"type": "subtitle", "time": 4066.47, "timestamp": "01:07:46", "text": "愛"}, {"type": "subtitle", "time": 4069.589, "timestamp": "01:07:49", "text": "とても良かったです。猫カフェに行きました"}, {"type": "subtitle", "time": 4072.309, "timestamp": "01:07:52", "text": "えっと、私がプナ・コミコンに行ったとき。前に"}, {"type": "subtitle", "time": 4073.829, "timestamp": "01:07:53", "text": "日本に行くと、会えると思った"}, {"type": "subtitle", "time": 4078.069, "timestamp": "01:07:58", "text": "他のIM系YouTuber。それで、私はそこへ行った。"}, {"type": "subtitle", "time": 4079.39, "timestamp": "01:07:59", "text": "猫がいた"}]
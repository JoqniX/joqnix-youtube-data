[{"type": "subtitle", "time": 8463.11, "timestamp": "02:21:03", "text": "3つのアカウントです。私は３つ持っています"}, {"type": "subtitle", "time": 8465.11, "timestamp": "02:21:05", "text": "アカウント。私には3人の子供がいます。私はしません"}, {"type": "subtitle", "time": 8467.75, "timestamp": "02:21:07", "text": "それらをどう扱うべきかを知っている。子供は３人。"}, {"type": "subtitle", "time": 8469.59, "timestamp": "02:21:09", "text": "そうそう。最近、あなたはプレイしていますね"}, {"type": "subtitle", "time": 8472.63, "timestamp": "02:21:12", "text": "最近、ヴァレンティンをよく見かけますよね？はい、そうです。"}, {"type": "subtitle", "time": 8477.349, "timestamp": "02:21:17", "text": "まるで私がその子供たちのことを忘れてしまったかのようだ。"}, {"type": "subtitle", "time": 8479.67, "timestamp": "02:21:19", "text": "うん。うん。うん。忘れた。私は"}, {"type": "subtitle", "time": 8491.99, "timestamp": "02:21:31", "text": "「はい」と言っても大丈夫です。ジャックがそう言ったんだ。その"}, {"type": "subtitle", "time": 8494.15, "timestamp": "02:21:34", "text": "悪い父親像であっても構わない。はい、"}, {"type": "subtitle", "time": 8496.71, "timestamp": "02:21:36", "text": "みんな。君たちは彼から連絡を受けたよね。はい。"}, {"type": "subtitle", "time": 8499.83, "timestamp": "02:21:39", "text": "さあ行こう。つまり、ある意味では問題ないのですが、"}, {"type": "subtitle", "time": 8502.23, "timestamp": "02:21:42", "text": "でも、自分の知識も知っておく必要がある"}, {"type": "subtitle", "time": 8504.469, "timestamp": "02:21:44", "text": "あなたはうまくいっていないし、えーと"}, {"type": "subtitle", "time": 8508.23, "timestamp": "02:21:48", "text": "それを改善するとか、そういうことだよ。えっと"}, {"type": "subtitle", "time": 8513.429, "timestamp": "02:21:53", "text": "そこへは行かないでください。くそ。やめてください"}, {"type": "subtitle", "time": 8516.469, "timestamp": "02:21:56", "text": "そんな風に自分を罠にかけてはいけない。こんにちは。こんにちは。"}]
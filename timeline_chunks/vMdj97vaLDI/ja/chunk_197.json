[{"type": "subtitle", "time": 11820.309, "timestamp": "03:17:00", "text": "あるいは、そんな感じ。ああ、私も同感です。うん。"}, {"type": "subtitle", "time": 11823.03, "timestamp": "03:17:03", "text": "はい。私たちは植える必要がある"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "寝室にカメラが設置されている。はい。うん。"}, {"type": "subtitle", "time": 11827.75, "timestamp": "03:17:07", "text": "うん。この部屋は、"}, {"type": "subtitle", "time": 11833.11, "timestamp": "03:17:13", "text": "ここに来て。わかった。私は行くつもりです 私は行くつもりです"}, {"type": "subtitle", "time": 11839.67, "timestamp": "03:17:19", "text": "カメラをここに置くと、"}, {"type": "subtitle", "time": 11841.99, "timestamp": "03:17:21", "text": "ここ。ここに設置します。それで"}, {"type": "subtitle", "time": 11846.389, "timestamp": "03:17:26", "text": "ああ、ジョー、懐中電灯が好きでいてくれない？"}, {"type": "subtitle", "time": 11851.03, "timestamp": "03:17:31", "text": "ジョー、助けて。私はUhohの中にいます。おっと。"}, {"type": "subtitle", "time": 11853.269, "timestamp": "03:17:33", "text": "どうしたの？どうしたの？私の"}, {"type": "subtitle", "time": 11855.59, "timestamp": "03:17:35", "text": "カメラは設置済みですか？"}, {"type": "subtitle", "time": 11859.11, "timestamp": "03:17:39", "text": "ああ、床下にあるんですね。"}, {"type": "subtitle", "time": 11865.269, "timestamp": "03:17:45", "text": "これは疑わしくない"}, {"type": "subtitle", "time": 11871.03, "timestamp": "03:17:51", "text": "まったく。わかった。これをここに置いてください。"}, {"type": "subtitle", "time": 11879.269, "timestamp": "03:17:59", "text": "全て。了解、了解。えっと"}]
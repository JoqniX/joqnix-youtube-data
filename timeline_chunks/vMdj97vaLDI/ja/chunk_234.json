[{"type": "subtitle", "time": 14040.95, "timestamp": "03:54:00", "text": "ここ？どこにいるの？私は"}, {"type": "subtitle", "time": 14042.87, "timestamp": "03:54:02", "text": "私はこの質問をするのが好きだ。君をある程度手に入れたよ"}, {"type": "subtitle", "time": 14047.51, "timestamp": "03:54:07", "text": "ほら、もっとケチャップだよ。ああ、そうじゃない"}, {"type": "subtitle", "time": 14050.83, "timestamp": "03:54:10", "text": "ケチャップ。どうでも。誤報でした。間違い"}, {"type": "subtitle", "time": 14053.11, "timestamp": "03:54:13", "text": "アラーム。わかった。わかった。わかった。わかった。私が行きます"}, {"type": "subtitle", "time": 14055.11, "timestamp": "03:54:15", "text": "一人で中にいる。私が死ぬなら、死ぬしかない。その"}, {"type": "subtitle", "time": 14058.389, "timestamp": "03:54:18", "text": "大丈夫。ああ、中に入ります。"}, {"type": "subtitle", "time": 14059.71, "timestamp": "03:54:19", "text": "あなたは"}, {"type": "subtitle", "time": 14062.79, "timestamp": "03:54:22", "text": "ここ？どこにいるの？待つべきでしょうか"}, {"type": "subtitle", "time": 14065.429, "timestamp": "03:54:25", "text": "あなたから行くべきか、それとも私がまっすぐ行くべきか？何歳ですか"}, {"type": "subtitle", "time": 14072.91, "timestamp": "03:54:32", "text": "ああ、なんてことだ、怖い"}, {"type": "subtitle", "time": 14075.91, "timestamp": "03:54:35", "text": "自分。誰が？それは誰だったのか"}, {"type": "subtitle", "time": 14078.95, "timestamp": "03:54:38", "text": "ドアをノックした？"}, {"type": "subtitle", "time": 14081.91, "timestamp": "03:54:41", "text": "わかった。"}, {"type": "subtitle", "time": 14085.03, "timestamp": "03:54:45", "text": "あの光る物体は何？ああ、それは"}, {"type": "subtitle", "time": 14087.189, "timestamp": "03:54:47", "text": "自分。"}, {"type": "subtitle", "time": 14089.99, "timestamp": "03:54:49", "text": "あのシンは誰ですか？"}, {"type": "subtitle", "time": 14092.07, "timestamp": "03:54:52", "text": "あの中国の明るい光は誰？"}, {"type": "subtitle", "time": 14095.11, "timestamp": "03:54:55", "text": "ケチャップ。ケチャップです。ああ、彼らは"}, {"type": "subtitle", "time": 14097.67, "timestamp": "03:54:57", "text": "ケチャップをあちこちにこぼした。とても不器用"}, {"type": "subtitle", "time": 14099.99, "timestamp": "03:54:59", "text": "食べる人。待って、もしこの中を覗いたら、"}]
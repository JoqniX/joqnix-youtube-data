[{"type": "subtitle", "time": 7142.87, "timestamp": "01:59:02", "text": "うん。行くなら大丈夫です。得る"}, {"type": "subtitle", "time": 7145.03, "timestamp": "01:59:05", "text": "マサラ。わかった。マサラを持って行ってください。得る"}, {"type": "subtitle", "time": 7148.39, "timestamp": "01:59:08", "text": "マサラを一緒に。わかった。日本語"}, {"type": "subtitle", "time": 7150.149, "timestamp": "01:59:10", "text": "カレーは私が今まで食べた中で最悪のカレーです"}, {"type": "subtitle", "time": 7152.07, "timestamp": "01:59:12", "text": "今まで試したことがある。わかった。食べないで"}, {"type": "subtitle", "time": 7153.75, "timestamp": "01:59:13", "text": "それ。食べてみて。それは"}, {"type": "subtitle", "time": 7156.709, "timestamp": "01:59:16", "text": "今まで食べた中で一番まずいカレー。"}, {"type": "subtitle", "time": 7160.709, "timestamp": "01:59:20", "text": "生の食品や加工食品は"}, {"type": "subtitle", "time": 7162.79, "timestamp": "01:59:22", "text": "空港か何かで許可されていない。私は"}, {"type": "subtitle", "time": 7164.709, "timestamp": "01:59:24", "text": "わからない。"}, {"type": "subtitle", "time": 7168.149, "timestamp": "01:59:28", "text": "でもマサラなら大丈夫でしょう。"}, {"type": "subtitle", "time": 7171.51, "timestamp": "01:59:31", "text": "そうだといい。君がどう思うか見てみたい"}, {"type": "subtitle", "time": 7173.91, "timestamp": "01:59:33", "text": "あなたの中にマサラを少し入れるために"}, {"type": "subtitle", "time": 7175.02, "timestamp": "01:59:35", "text": "荷物。"}, {"type": "subtitle", "time": 7176.709, "timestamp": "01:59:36", "text": "[音楽]"}, {"type": "subtitle", "time": 7178.47, "timestamp": "01:59:38", "text": "だって、ただの粉末状のものでしょ？"}, {"type": "subtitle", "time": 7180.79, "timestamp": "01:59:40", "text": "うん。ハルディ。残りのもの"}, {"type": "subtitle", "time": 7182.39, "timestamp": "01:59:42", "text": "手に入れます。でも、ハルディとか"}, {"type": "subtitle", "time": 7184.47, "timestamp": "01:59:44", "text": "もの。"}, {"type": "subtitle", "time": 7186.79, "timestamp": "01:59:46", "text": "そして"}, {"type": "subtitle", "time": 7189.189, "timestamp": "01:59:49", "text": "ええ、私が働いている会社でさえも"}, {"type": "subtitle", "time": 7192.87, "timestamp": "01:59:52", "text": "インドのマサラ、インドのマサラのようなもの"}, {"type": "subtitle", "time": 7194.47, "timestamp": "01:59:54", "text": "あれ。"}, {"type": "subtitle", "time": 7196.47, "timestamp": "01:59:56", "text": "そう、インド製品も置いてあるよ。それ"}, {"type": "subtitle", "time": 7198.629, "timestamp": "01:59:58", "text": "それは私の会社が知っていることです"}]
[{"type": "subtitle", "time": 12180.79, "timestamp": "03:23:00", "text": "ろうそくを買いに行く。購入できますか"}, {"type": "subtitle", "time": 12183.99, "timestamp": "03:23:03", "text": "スマッジスティック？ええ、もちろんです。"}, {"type": "subtitle", "time": 12187.229, "timestamp": "03:23:07", "text": "キャンドルを買ったんだけど、えっと、付け加えると"}, {"type": "subtitle", "time": 12191.349, "timestamp": "03:23:11", "text": "それ。何？キャンドルを追加する。例えば"}, {"type": "subtitle", "time": 12194.79, "timestamp": "03:23:14", "text": "ああ、"}, {"type": "subtitle", "time": 12204.63, "timestamp": "03:23:24", "text": "厚手のものを買ったように。ニース。追加"}, {"type": "subtitle", "time": 12210.389, "timestamp": "03:23:30", "text": "それ。追加してください。追加してください。それを追加してください。追加しました。"}, {"type": "subtitle", "time": 12213.83, "timestamp": "03:23:33", "text": "わかった。ところで、どんな地図が欲しいですか？"}, {"type": "subtitle", "time": 12216.71, "timestamp": "03:23:36", "text": "もう一度遠い地図を見に行きたいのですか？私"}, {"type": "subtitle", "time": 12218.269, "timestamp": "03:23:38", "text": "つまり、私は"}, {"type": "subtitle", "time": 12220.63, "timestamp": "03:23:40", "text": "もう一度、うん。うん。行きましょう"}, {"type": "subtitle", "time": 12222.07, "timestamp": "03:23:42", "text": "異なる 異なる 異なる"}, {"type": "subtitle", "time": 12223.59, "timestamp": "03:23:43", "text": "農家。農家。これは何ですか"}, {"type": "subtitle", "time": 12225.349, "timestamp": "03:23:45", "text": "農家？これは新しい事例だ。私はしません"}, {"type": "subtitle", "time": 12228.87, "timestamp": "03:23:48", "text": "知る。これは血の腐りです。私"}, {"type": "subtitle", "time": 12230.15, "timestamp": "03:23:50", "text": "わからない。何が変なのか分からない"}]
[{"type": "subtitle", "time": 8221.83, "timestamp": "02:17:01", "text": "もの。私はまだ手を差し伸べ、希望を抱いています"}, {"type": "subtitle", "time": 8225.11, "timestamp": "02:17:05", "text": "彼らは私が行く前にそれを見るだろうから"}, {"type": "subtitle", "time": 8228.19, "timestamp": "02:17:08", "text": "私は話をして"}, {"type": "subtitle", "time": 8229.22, "timestamp": "02:17:09", "text": "もの。"}, {"type": "subtitle", "time": 8231.07, "timestamp": "02:17:11", "text": "[音楽]"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "ええ、特定の人と話したいんです"}, {"type": "subtitle", "time": 8237.709, "timestamp": "02:17:17", "text": "誰か、男。えっと、私の"}, {"type": "subtitle", "time": 8242.95, "timestamp": "02:17:22", "text": "Twitchの最初の創設者、"}, {"type": "subtitle", "time": 8245.589, "timestamp": "02:17:25", "text": "賭けと購読を始めたとき"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "提携関係にあるんですよね？うん。うん。私はしません"}, {"type": "subtitle", "time": 8250.87, "timestamp": "02:17:30", "text": "誰が"}, {"type": "subtitle", "time": 8252.429, "timestamp": "02:17:32", "text": "私の創設者"}, {"type": "subtitle", "time": 8254.95, "timestamp": "02:17:34", "text": "チャネル。ストリーミング配信をしている人は"}, {"type": "subtitle", "time": 8257.99, "timestamp": "02:17:37", "text": "Twitchはそれを知っているのか？これをグーグルで調べなきゃ"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "あるいは、そんな感じ。では、少し時間をください。私"}, {"type": "subtitle", "time": 8263.549, "timestamp": "02:17:43", "text": "見つけるだけ"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "イヤホン。耳に入れて"}, {"type": "subtitle", "time": 8268.629, "timestamp": "02:17:48", "text": "ヘッドホンを装着してください。イヤホンは"}]
[{"type": "subtitle", "time": 3970.63, "timestamp": "01:06:10", "text": "高い。 1個にしてはめちゃくちゃ高い"}, {"type": "subtitle", "time": 3974.47, "timestamp": "01:06:14", "text": "時間。 1時間2回くらいもらえます。"}, {"type": "subtitle", "time": 3979.67, "timestamp": "01:06:19", "text": "そして子供たちは本当に本当に素晴らしい"}, {"type": "subtitle", "time": 3981.789, "timestamp": "01:06:21", "text": "まるで彼らはとても"}, {"type": "subtitle", "time": 3985.51, "timestamp": "01:06:25", "text": "良い。でも、ええ、とても高価です。"}, {"type": "subtitle", "time": 3987.589, "timestamp": "01:06:27", "text": "だから、もしあなたがそれらに投資するつもりなら"}, {"type": "subtitle", "time": 3989.75, "timestamp": "01:06:29", "text": "カフェのようなカフェ、そういうカフェのようなカフェ"}, {"type": "subtitle", "time": 3993.349, "timestamp": "01:06:33", "text": "彼らはまるで王様のようだ。だから"}, {"type": "subtitle", "time": 3996.23, "timestamp": "01:06:36", "text": "女性が着飾るカフェがある"}, {"type": "subtitle", "time": 4000.789, "timestamp": "01:06:40", "text": "男性のような服装をして、それから"}, {"type": "chat", "time": 4001.358, "timestamp": "01:06:41", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Money is not a problem Mam I need it"}, {"type": "subtitle", "time": 4002.87, "timestamp": "01:06:42", "text": "基本的にはホストのようなものですが、"}, {"type": "subtitle", "time": 4005.029, "timestamp": "01:06:45", "text": "そういうホストではないけれど、"}, {"type": "subtitle", "time": 4008.63, "timestamp": "01:06:48", "text": "それは女性向けで、それから"}, {"type": "subtitle", "time": 4011.75, "timestamp": "01:06:51", "text": "彼らは男性の格好をする。"}, {"type": "subtitle", "time": 4014.23, "timestamp": "01:06:54", "text": "彼らは基本的にプロセスが好きで、それから"}, {"type": "subtitle", "time": 4017.51, "timestamp": "01:06:57", "text": "彼らがしていることは、"}, {"type": "subtitle", "time": 4019.109, "timestamp": "01:06:59", "text": "エンターテイナーではなく、エンターテイナーと話すこと"}]
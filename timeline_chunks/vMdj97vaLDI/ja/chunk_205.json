[{"type": "subtitle", "time": 12301.99, "timestamp": "03:25:01", "text": "だから、私は正しいことをして"}, {"type": "subtitle", "time": 12305.269, "timestamp": "03:25:05", "text": "懐中電灯と、そしてその物"}, {"type": "subtitle", "time": 12306.79, "timestamp": "03:25:06", "text": "床の中に何かがある。それは"}, {"type": "subtitle", "time": 12308.389, "timestamp": "03:25:08", "text": "床。床の中にあります。では"}, {"type": "subtitle", "time": 12310.469, "timestamp": "03:25:10", "text": "押しつぶす？"}, {"type": "subtitle", "time": 12313.67, "timestamp": "03:25:13", "text": "いいえ。いいえ。それに関する任務はありますか？"}, {"type": "subtitle", "time": 12315.429, "timestamp": "03:25:15", "text": "その物体と幽霊を捉えろ。はい。"}, {"type": "subtitle", "time": 12317.75, "timestamp": "03:25:17", "text": "はい。私たちはキャンドルを届ける使命を担っています。わかった。私たちは"}, {"type": "subtitle", "time": 12319.429, "timestamp": "03:25:19", "text": "私たちにはキャンドルを届ける使命があります。はい。ニース。"}, {"type": "subtitle", "time": 12321.75, "timestamp": "03:25:21", "text": "ニース。ニース。ニース。ニース。ニース。わかった。取る"}, {"type": "subtitle", "time": 12323.83, "timestamp": "03:25:23", "text": "これを手に取ってください。"}, {"type": "subtitle", "time": 12325.67, "timestamp": "03:25:25", "text": "いいえ、ろうそくはありません。ああ、私たちは"}, {"type": "subtitle", "time": 12327.75, "timestamp": "03:25:27", "text": "ちなみにカメラ持ってますよ。のように"}, {"type": "subtitle", "time": 12330.309, "timestamp": "03:25:30", "text": "写真に撮るもの。はい、ございます。"}, {"type": "subtitle", "time": 12332.07, "timestamp": "03:25:32", "text": "わかった、"}, {"type": "subtitle", "time": 12333.83, "timestamp": "03:25:33", "text": "カメラを持って行ってもいいですよ。取る 取る"}, {"type": "subtitle", "time": 12337.91, "timestamp": "03:25:37", "text": "その物。ああ、お願いだから懐中電灯を。はい、"}, {"type": "subtitle", "time": 12339.83, "timestamp": "03:25:39", "text": "これくらいならまた下げることができます。"}, {"type": "subtitle", "time": 12341.67, "timestamp": "03:25:41", "text": "カメラを手に入れることができます"}, {"type": "subtitle", "time": 12345.03, "timestamp": "03:25:45", "text": "あなた。ええ、その本は持っています。えっと、これ"}, {"type": "subtitle", "time": 12348.83, "timestamp": "03:25:48", "text": "EMF のこと"}, {"type": "subtitle", "time": 12350.87, "timestamp": "03:25:50", "text": "実は。私に持って行ってほしいですか？"}, {"type": "subtitle", "time": 12353.429, "timestamp": "03:25:53", "text": "カメラ？カメラ。そうそう。カメラ。"}, {"type": "subtitle", "time": 12355.269, "timestamp": "03:25:55", "text": "カメラ。さあ行こう。"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "わかった。あのね？それを"}, {"type": "subtitle", "time": 12357.99, "timestamp": "03:25:57", "text": "床。欲しくないものは何でも捨てなさい"}]
[{"type": "subtitle", "time": 10861.03, "timestamp": "03:01:01", "text": "右？彼らは私の声しか聞かないだろう。つまり"}, {"type": "subtitle", "time": 10865.03, "timestamp": "03:01:05", "text": "悪い。だから、バランスを取る必要がある。それで"}, {"type": "subtitle", "time": 10867.19, "timestamp": "03:01:07", "text": "それはもっと、どのようにバランスを取るかということです"}, {"type": "subtitle", "time": 10870.63, "timestamp": "03:01:10", "text": "それ？音量を下げることで。下げることができます"}, {"type": "subtitle", "time": 10873.67, "timestamp": "03:01:13", "text": "よろしければDiscordでどうぞ。"}, {"type": "subtitle", "time": 10875.91, "timestamp": "03:01:15", "text": "Discordでその値を下げました。下にあります"}, {"type": "subtitle", "time": 10882.469, "timestamp": "03:01:22", "text": "わかった。待って、どうやって"}, {"type": "subtitle", "time": 10885.99, "timestamp": "03:01:25", "text": "Discordも？明らかにキャップを表示しない"}, {"type": "subtitle", "time": 10896.63, "timestamp": "03:01:36", "text": "私の音声はあなたの音声より少し小さいです。私"}, {"type": "subtitle", "time": 10898.63, "timestamp": "03:01:38", "text": "理由はわからない。"}, {"type": "subtitle", "time": 10901.03, "timestamp": "03:01:41", "text": "うん。うん。うん。ああ、ゲインフィルターを追加してください"}, {"type": "subtitle", "time": 10903.55, "timestamp": "03:01:43", "text": "マイクに。マイクで、"}, {"type": "subtitle", "time": 10908.15, "timestamp": "03:01:48", "text": "マイクをメインにしてください。つまり、利益を加算するということです。"}, {"type": "subtitle", "time": 10911.51, "timestamp": "03:01:51", "text": "何を追加するのですか？マイクをマイクソースに接続してください。追加"}]
[{"type": "subtitle", "time": 9183.19, "timestamp": "02:33:03", "text": "難易度の高いゲーム。待って、ゲームは"}, {"type": "subtitle", "time": 9185.23, "timestamp": "02:33:05", "text": "存在しない。待って、"}, {"type": "subtitle", "time": 9187.91, "timestamp": "02:33:07", "text": "何？待って、いや、いや、いや、いや。そうです"}, {"type": "subtitle", "time": 9189.91, "timestamp": "02:33:09", "text": "存在する。"}, {"type": "subtitle", "time": 9192.23, "timestamp": "02:33:12", "text": "どのサーバーを使いましたか？と書いてありますか？"}, {"type": "subtitle", "time": 9195.349, "timestamp": "02:33:15", "text": "ナナナナナ？待って、あなたは"}, {"type": "subtitle", "time": 9198.63, "timestamp": "02:33:18", "text": "取った、取るべきだった、えーと、えーと、"}, {"type": "subtitle", "time": 9200.55, "timestamp": "02:33:20", "text": "アジア。"}, {"type": "subtitle", "time": 9203.11, "timestamp": "02:33:23", "text": "あ、待って。本当に？わかった。私はそうしなかった"}, {"type": "subtitle", "time": 9204.55, "timestamp": "02:33:24", "text": "それは知らなかった。わかった。わかった。わかった。その"}, {"type": "subtitle", "time": 9207.19, "timestamp": "02:33:27", "text": "大丈夫。大丈夫です。わかった。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 9209.91, "timestamp": "02:33:29", "text": "もう一度設定できます。わかった。わかった。私"}, {"type": "subtitle", "time": 9211.67, "timestamp": "02:33:31", "text": "再度設定できます。大丈夫です。その"}, {"type": "subtitle", "time": 9214.23, "timestamp": "02:33:34", "text": "大丈夫。私たちは今、それを解明しようとしているところです。"}, {"type": "subtitle", "time": 9215.309, "timestamp": "02:33:35", "text": "これは"}, {"type": "subtitle", "time": 9218.79, "timestamp": "02:33:38", "text": "大丈夫。どうすれば変更できますか"}, {"type": "subtitle", "time": 9221.27, "timestamp": "02:33:41", "text": "サーバーは？"}, {"type": "subtitle", "time": 9230.23, "timestamp": "02:33:50", "text": "アジア人はいないと思う。"}, {"type": "subtitle", "time": 9232.95, "timestamp": "02:33:52", "text": "大丈夫。わかった。"}, {"type": "subtitle", "time": 9235.429, "timestamp": "02:33:55", "text": "いや、いや、いや。優先言語があります。"}, {"type": "subtitle", "time": 9238.309, "timestamp": "02:33:58", "text": "でも、そんなことはない"}]
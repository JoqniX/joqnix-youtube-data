[{"type": "subtitle", "time": 3604.23, "timestamp": "01:00:04", "text": "ああ、最悪だよ。"}, {"type": "subtitle", "time": 3610.03, "timestamp": "01:00:10", "text": "ニンジン。"}, {"type": "subtitle", "time": 3612.789, "timestamp": "01:00:12", "text": "よし、グーグルで調べてみよう。私は見たことがない"}, {"type": "subtitle", "time": 3614.19, "timestamp": "01:00:14", "text": "ニンジン。"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "わかった。そして、そして、私はそこにいます"}, {"type": "subtitle", "time": 3619.43, "timestamp": "01:00:19", "text": "共感できるかどうかはわかりません"}, {"type": "subtitle", "time": 3622.789, "timestamp": "01:00:22", "text": "フィリピン料理には"}, {"type": "subtitle", "time": 3625.51, "timestamp": "01:00:25", "text": "チョコレートを入れる"}, {"type": "subtitle", "time": 3628.95, "timestamp": "01:00:28", "text": "エバミルクライスを混ぜて"}, {"type": "subtitle", "time": 3633.91, "timestamp": "01:00:33", "text": "それを一緒に、干し魚と一緒に食べるんです。"}, {"type": "subtitle", "time": 3639.99, "timestamp": "01:00:39", "text": "何？うん。おお。おお。ケーキの中に。干し魚。"}, {"type": "subtitle", "time": 3641.27, "timestamp": "01:00:41", "text": "それはケーキではありません。それはケーキではありません。"}, {"type": "subtitle", "time": 3644.549, "timestamp": "01:00:44", "text": "それはむしろ、ほら、あなたが"}, {"type": "subtitle", "time": 3648.589, "timestamp": "01:00:48", "text": "置く 置く 置く 置く"}, {"type": "subtitle", "time": 3652.95, "timestamp": "01:00:52", "text": "米。わかった。あなたは無糖練乳を入れた。"}, {"type": "subtitle", "time": 3656.99, "timestamp": "01:00:56", "text": "チョコレートを入れます"}, {"type": "subtitle", "time": 3659.51, "timestamp": "01:00:59", "text": "粉。一緒に調理します"}]
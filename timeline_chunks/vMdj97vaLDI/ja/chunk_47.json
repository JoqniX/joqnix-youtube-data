[{"type": "subtitle", "time": 2825.19, "timestamp": "00:47:05", "text": "あなたに教えることができて感謝しています。"}, {"type": "subtitle", "time": 2827.589, "timestamp": "00:47:07", "text": "これは私が年下の子供にも言うことです"}, {"type": "chat", "time": 2828.63, "timestamp": "00:47:08", "author": "@relaxbreatheblossomasmr5099", "avatar": "https://yt4.ggpht.com/ckcBBCnJoTgzSBf41z6qIrlbXLgznOucPKQ1RdeSjWdIubetNhA8L40rK7FrC8Ymp_UJfKAA5w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCxUCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCxUCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCx"}, {"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "兄弟。わかった？悪いことを学ぶ。"}, {"type": "subtitle", "time": 2832.55, "timestamp": "00:47:12", "text": "わかった？やめてください。やめてください。しかし"}, {"type": "subtitle", "time": 2834.79, "timestamp": "00:47:14", "text": "悪いことを学んで、もし"}, {"type": "subtitle", "time": 2836.87, "timestamp": "00:47:16", "text": "あなたに何かが起こったら、あなたは"}, {"type": "subtitle", "time": 2838.95, "timestamp": "00:47:18", "text": "世間知らずな人。だから私はこう言うんだ"}, {"type": "chat", "time": 2841.323, "timestamp": "00:47:21", "author": "@relaxbreatheblossomasmr5099", "avatar": "https://yt4.ggpht.com/ckcBBCnJoTgzSBf41z6qIrlbXLgznOucPKQ1RdeSjWdIubetNhA8L40rK7FrC8Ymp_UJfKAA5w=s64-c-k-c0x00ffffff-no-rj", "message": "rip joq senpai"}, {"type": "subtitle", "time": 2841.589, "timestamp": "00:47:21", "text": "人々。悪いことも学べ。しないでください"}, {"type": "subtitle", "time": 2843.19, "timestamp": "00:47:23", "text": "それ。悪いことも学べ。ほら、あの"}, {"type": "subtitle", "time": 2846.03, "timestamp": "00:47:26", "text": "私は、えっと、私は"}, {"type": "subtitle", "time": 2849.27, "timestamp": "00:47:29", "text": "5年生か4年生か、覚えていない。私"}, {"type": "subtitle", "time": 2851.03, "timestamp": "00:47:31", "text": "中指の意味を知らなかった。"}, {"type": "subtitle", "time": 2853.91, "timestamp": "00:47:33", "text": "わかった。それで、ええと、似たようなグループ"}, {"type": "chat", "time": 2854.733, "timestamp": "00:47:34", "author": "@pallyshorts", "avatar": "https://yt4.ggpht.com/bUFK7G0ngMhKt0hngr1HLPABWGhXa5Sj__hJIN8j8POnZah6-QZLHwZYWCrDrKUlyKnBW0Md5g=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/xsIfY4OqCd2T29sP54iAsAwUCkszU2WH9gy1mb0dV-11UJg/xsIfY4OqCd2T29sP54iAsAwUCkszU2WH9gy1mb0dV-11UJg/xsIfY4OqCd2T29sP54iAsAw"}, {"type": "subtitle", "time": 2855.91, "timestamp": "00:47:35", "text": "近くにいる兄弟たち、"}, {"type": "subtitle", "time": 2858.47, "timestamp": "00:47:38", "text": "近所の兄弟たち。ええと、それで私たちは"}, {"type": "subtitle", "time": 2860.79, "timestamp": "00:47:40", "text": "小さな店があった。母はよく走っていた"}, {"type": "subtitle", "time": 2862.79, "timestamp": "00:47:42", "text": "小さな店。私は外に座っていた"}, {"type": "subtitle", "time": 2865.109, "timestamp": "00:47:45", "text": "その店と私の近所のバヤ"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "兄弟のようだったし、近所の人たちのようだった"}, {"type": "subtitle", "time": 2869.349, "timestamp": "00:47:49", "text": "兄弟はサイコサイコみたいだった、なぜ"}, {"type": "subtitle", "time": 2870.95, "timestamp": "00:47:50", "text": "なぜ指さないのですか"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "あの女の子たちに中指を立てて"}, {"type": "subtitle", "time": 2874.55, "timestamp": "00:47:54", "text": "歩いている女の子のグループ"}, {"type": "subtitle", "time": 2876.15, "timestamp": "00:47:56", "text": "道路を渡ろうとしていて、私はこう思った"}, {"type": "subtitle", "time": 2877.91, "timestamp": "00:47:57", "text": "中指って何？って感じだった"}, {"type": "subtitle", "time": 2879.589, "timestamp": "00:47:59", "text": "いや、ただ見せるだけ、ただ見せるだけ、そして私はこう思った"}]
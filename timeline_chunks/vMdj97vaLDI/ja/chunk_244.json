[{"type": "subtitle", "time": 14642.309, "timestamp": "04:04:02", "text": "スピード。より速い速度で移動します"}, {"type": "subtitle", "time": 14645.75, "timestamp": "04:04:05", "text": "被害者が遠くにいる場合。イエス様、それは"}, {"type": "subtitle", "time": 14648.269, "timestamp": "04:04:08", "text": "本当にあなたを洗い流してくれる。電源を切る"}, {"type": "subtitle", "time": 14651.11, "timestamp": "04:04:11", "text": "場所の場所の電源は"}, {"type": "subtitle", "time": 14653.269, "timestamp": "04:04:13", "text": "ジンがその能力を使うのを阻止する。"}, {"type": "subtitle", "time": 14656.79, "timestamp": "04:04:16", "text": "本当に暗闇の中に立って"}, {"type": "subtitle", "time": 14659.91, "timestamp": "04:04:19", "text": "この件を避けてくれてありがとう。"}, {"type": "subtitle", "time": 14669.189, "timestamp": "04:04:29", "text": "市長。ああ、イエス様。市長。わかった。 A"}, {"type": "subtitle", "time": 14671.99, "timestamp": "04:04:31", "text": "市長はあらゆる悪夢の源である"}, {"type": "subtitle", "time": 14674.389, "timestamp": "04:04:34", "text": "暗闇の中で最も強力な力を発揮する。 A"}, {"type": "subtitle", "time": 14676.469, "timestamp": "04:04:36", "text": "市長は"}, {"type": "subtitle", "time": 14679.11, "timestamp": "04:04:39", "text": "暗闇の中での攻撃。電源を切る"}, {"type": "subtitle", "time": 14682.229, "timestamp": "04:04:42", "text": "ライトを点灯すると、"}, {"type": "subtitle", "time": 14683.99, "timestamp": "04:04:43", "text": "攻撃のチャンスがまだあるか、"}, {"type": "subtitle", "time": 14686.91, "timestamp": "04:04:46", "text": "彼らを攻撃するが、成功する可能性は低い。その"}, {"type": "subtitle", "time": 14689.349, "timestamp": "04:04:49", "text": "反響する、激しい。ああ、ワイルドだ"}, {"type": "subtitle", "time": 14691.67, "timestamp": "04:04:51", "text": "無差別に攻撃する幽霊。"}, {"type": "subtitle", "time": 14694.87, "timestamp": "04:04:54", "text": "彼らのスピードは、"}, {"type": "subtitle", "time": 14697.269, "timestamp": "04:04:57", "text": "遅いが、優勢な矢印である。すぐに"}, {"type": "subtitle", "time": 14699.11, "timestamp": "04:04:59", "text": "狩りを始めると彼らは移動する"}]
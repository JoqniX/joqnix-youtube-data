[{"type": "subtitle", "time": 5581.51, "timestamp": "01:33:01", "text": "すると、入り口のようなものが"}, {"type": "subtitle", "time": 5585.11, "timestamp": "01:33:05", "text": "新入生のための式典か何か"}, {"type": "subtitle", "time": 5588.31, "timestamp": "01:33:08", "text": "そんな感じで、たくさんのことをするつもり"}, {"type": "subtitle", "time": 5590.39, "timestamp": "01:33:10", "text": "アニメの学校に通うつもりです"}, {"type": "subtitle", "time": 5592.47, "timestamp": "01:33:12", "text": "人生"}, {"type": "subtitle", "time": 5594.55, "timestamp": "01:33:14", "text": "そして、もしあなたがそれを買うなら"}, {"type": "subtitle", "time": 5596.709, "timestamp": "01:33:16", "text": "まるで買うかのように手に入れることができる"}, {"type": "subtitle", "time": 5600.31, "timestamp": "01:33:20", "text": "最初の右側のノートパソコンは、私はそうは思わない"}, {"type": "subtitle", "time": 5602.55, "timestamp": "01:33:22", "text": "知ってるよ、私はただ何かが欲しいだけなんだ"}, {"type": "subtitle", "time": 5604.95, "timestamp": "01:33:24", "text": "最新のストリーミングも処理できます"}, {"type": "subtitle", "time": 5607.03, "timestamp": "01:33:27", "text": "すべて"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "そうすれば、"}, {"type": "subtitle", "time": 5612.07, "timestamp": "01:33:32", "text": "最初に手に入れるなら、ノートパソコンは良いでしょう"}, {"type": "subtitle", "time": 5613.91, "timestamp": "01:33:33", "text": "手ですが、アクセサリーには"}, {"type": "subtitle", "time": 5616.07, "timestamp": "01:33:36", "text": "安いので、Book Off に行けばいい"}, {"type": "subtitle", "time": 5618.87, "timestamp": "01:33:38", "text": "私は本のアンバサダーです"}, {"type": "subtitle", "time": 5620.39, "timestamp": "01:33:40", "text": "オフですが、私が言うことは"}, {"type": "subtitle", "time": 5622.39, "timestamp": "01:33:42", "text": "人々はあなたから本を買うだけです"}, {"type": "subtitle", "time": 5624.07, "timestamp": "01:33:44", "text": "全てを手に入れるだろう。理由がわからない"}, {"type": "subtitle", "time": 5626.229, "timestamp": "01:33:46", "text": "インフルエンサーは多くの"}, {"type": "subtitle", "time": 5627.75, "timestamp": "01:33:47", "text": "旅行インフルエンサーについて語られることはない"}, {"type": "subtitle", "time": 5630.629, "timestamp": "01:33:50", "text": "十分に休みを取ってください。彼らは話し合う必要がある"}, {"type": "subtitle", "time": 5632.55, "timestamp": "01:33:52", "text": "人々が人々を知るようにたくさん"}, {"type": "subtitle", "time": 5635.189, "timestamp": "01:33:55", "text": "予算重視の旅行者は、"}, {"type": "subtitle", "time": 5637.35, "timestamp": "01:33:57", "text": "学生でさえ知っておくべきなのは、"}]
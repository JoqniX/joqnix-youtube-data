[{"type": "subtitle", "time": 13501.03, "timestamp": "03:45:01", "text": "ホール。うん。うん。わかった。わかった。その"}, {"type": "subtitle", "time": 13502.95, "timestamp": "03:45:02", "text": "文字通り玄関から、正面玄関から。"}, {"type": "subtitle", "time": 13505.51, "timestamp": "03:45:05", "text": "わかった。私は上へ行きます。もし私が死んだら、"}, {"type": "subtitle", "time": 13507.349, "timestamp": "03:45:07", "text": "分かり次第お知らせします。もし"}, {"type": "subtitle", "time": 13509.349, "timestamp": "03:45:09", "text": "私が死んだら、あなたに知らせます。だから私は"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "さあ、来て、イベントは"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "君は死にかけている。私は外へ逃げ出すよ。"}, {"type": "subtitle", "time": 13518.63, "timestamp": "03:45:18", "text": "うん。わかった。楽に稼げる。これは"}, {"type": "subtitle", "time": 13523.83, "timestamp": "03:45:23", "text": "開ける。氷点下の気温はありますか？いいえ。いいえ"}, {"type": "subtitle", "time": 13528.79, "timestamp": "03:45:28", "text": "氷点下の気温。私は間違いなく向かっています。"}, {"type": "subtitle", "time": 13533.11, "timestamp": "03:45:33", "text": "私は、ええと、ドアの鍵です。"}, {"type": "subtitle", "time": 13535.03, "timestamp": "03:45:35", "text": "わかった。"}, {"type": "subtitle", "time": 13537.59, "timestamp": "03:45:37", "text": "ああ、それは私の責任です。"}, {"type": "subtitle", "time": 13539.59, "timestamp": "03:45:39", "text": "待って、あなたはそれを経験しているのですか、それとも"}, {"type": "subtitle", "time": 13547.429, "timestamp": "03:45:47", "text": "EMF4。 EMF4。 EMF4。ああ、それはそれはそれはそれは"}, {"type": "subtitle", "time": 13550.469, "timestamp": "03:45:50", "text": "わかった。えっと、私、死ぬの？"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "あなたは死にかけているのですか？"}, {"type": "subtitle", "time": 13555.75, "timestamp": "03:45:55", "text": "私は死にかけているわけではない。ああ、それはそれは"}, {"type": "subtitle", "time": 13558.15, "timestamp": "03:45:58", "text": "それはこの部屋にあるのですか？どの部屋ですか？"}]
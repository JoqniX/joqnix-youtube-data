[{"type": "subtitle", "time": 3781.829, "timestamp": "01:03:01", "text": "胃の調子が悪いとか、そういうこと。そうだった"}, {"type": "subtitle", "time": 3783.43, "timestamp": "01:03:03", "text": "彼女にとって食べ物を見つけるのは本当に難しい"}, {"type": "subtitle", "time": 3786.789, "timestamp": "01:03:06", "text": "それはビーガンです、それはビーガンです、ビーガンです。"}, {"type": "subtitle", "time": 3788.71, "timestamp": "01:03:08", "text": "だから、もしあなたがベジタリアンなら、"}, {"type": "subtitle", "time": 3790.309, "timestamp": "01:03:10", "text": "難しい。あなたがビーガンなら"}, {"type": "subtitle", "time": 3792.309, "timestamp": "01:03:12", "text": "めちゃくちゃ難しい。しかし、あなたが非ヴェーダであれば"}, {"type": "subtitle", "time": 3794.069, "timestamp": "01:03:14", "text": "非ベジタリアンのように、何かを食べる"}, {"type": "subtitle", "time": 3795.67, "timestamp": "01:03:15", "text": "あなたは気にしない。ただ食べるだけ"}, {"type": "subtitle", "time": 3798.309, "timestamp": "01:03:18", "text": "何でも、そこはあなたにとって最高の場所です"}, {"type": "subtitle", "time": 3800.95, "timestamp": "01:03:20", "text": "行けるかどうか。神に誓って。生生"}, {"type": "subtitle", "time": 3803.51, "timestamp": "01:03:23", "text": "チキン。良い場所で食べてみてください"}, {"type": "subtitle", "time": 3805.829, "timestamp": "01:03:25", "text": "鶏肉を切って"}, {"type": "subtitle", "time": 3808.23, "timestamp": "01:03:28", "text": "彼らはただ皿に盛り付けるのが好きなだけだ。それ"}, {"type": "subtitle", "time": 3810.15, "timestamp": "01:03:30", "text": "最初はとても嫌悪感を覚えるかもしれません"}, {"type": "subtitle", "time": 3811.829, "timestamp": "01:03:31", "text": "だって、生の状態だからでしょ？私たちは決して食べない"}, {"type": "subtitle", "time": 3814.87, "timestamp": "01:03:34", "text": "生。はい。しかし驚くべきことに、それは白色だった。"}, {"type": "subtitle", "time": 3818.15, "timestamp": "01:03:38", "text": "肉は白っぽい。彼らは本当にカットした"}, {"type": "subtitle", "time": 3820.23, "timestamp": "01:03:40", "text": "薄くて、あとは"}, {"type": "subtitle", "time": 3822.309, "timestamp": "01:03:42", "text": "調理してからソースをかけて食べる。"}, {"type": "subtitle", "time": 3825.19, "timestamp": "01:03:45", "text": "本当に素晴らしいです。特にそれが"}, {"type": "subtitle", "time": 3828.39, "timestamp": "01:03:48", "text": "寿司とかそういうのがずっと続く。しかし、もしそれが"}, {"type": "subtitle", "time": 3830.15, "timestamp": "01:03:50", "text": "普通の魚と"}, {"type": "subtitle", "time": 3831.829, "timestamp": "01:03:51", "text": "そしてそれを複数個に切り分け、"}, {"type": "subtitle", "time": 3835.51, "timestamp": "01:03:55", "text": "生のままが最高だよ、ああ、そうしなくてもいいよ"}, {"type": "subtitle", "time": 3837.99, "timestamp": "01:03:57", "text": "何を心配するのですか"}, {"type": "subtitle", "time": 3839.67, "timestamp": "01:03:59", "text": "骨と呼ぶ"}]
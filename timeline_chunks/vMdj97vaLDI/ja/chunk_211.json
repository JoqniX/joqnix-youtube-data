[{"type": "subtitle", "time": 12662.229, "timestamp": "03:31:02", "text": "えーと、活動時間。どうやって全部学んだの？"}, {"type": "subtitle", "time": 12664.309, "timestamp": "03:31:04", "text": "これ？"}, {"type": "subtitle", "time": 12667.349, "timestamp": "03:31:07", "text": "わからない。私はとても混乱しています。私は"}, {"type": "subtitle", "time": 12669.51, "timestamp": "03:31:09", "text": "あなたと同じように混乱しています。ところで、あなたは"}, {"type": "subtitle", "time": 12672.55, "timestamp": "03:31:12", "text": "恐怖を証明しているのか？"}, {"type": "subtitle", "time": 12686.389, "timestamp": "03:31:26", "text": "こんにちは。"}, {"type": "subtitle", "time": 12698.389, "timestamp": "03:31:38", "text": "ああ、いや。あなたは植物を植えましたか？"}, {"type": "subtitle", "time": 12700.07, "timestamp": "03:31:40", "text": "その本？あなたがその本を仕掛けたのですか？いいえ、"}, {"type": "subtitle", "time": 12702.309, "timestamp": "03:31:42", "text": "いや、いや、いや、いや。私はその本を"}, {"type": "subtitle", "time": 12703.99, "timestamp": "03:31:43", "text": "中心部。"}, {"type": "subtitle", "time": 12706.15, "timestamp": "03:31:46", "text": "うん。テーブルの上に置いておいてください。ああ、例えば"}, {"type": "subtitle", "time": 12708.79, "timestamp": "03:31:48", "text": "この奇妙なベッドのようなものの中にいる。おお、"}, {"type": "subtitle", "time": 12712.07, "timestamp": "03:31:52", "text": "それはソファです。どうでも。それはソファです。"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "みんな。誤報でした。それはソファです。そうではありません"}, {"type": "subtitle", "time": 12716.55, "timestamp": "03:31:56", "text": "ベッドのようなもの。わかりました、置いてみます"}, {"type": "subtitle", "time": 12719.59, "timestamp": "03:31:59", "text": "この椅子みたいなところで。わかった。私は好きになれない"}]
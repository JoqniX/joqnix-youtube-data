[{"type": "subtitle", "time": 13021.51, "timestamp": "03:37:01", "text": "ラ。わからない。ラウラウラウ。ただ"}, {"type": "subtitle", "time": 13024.87, "timestamp": "03:37:04", "text": "出て行ってください。とにかく死なないで"}, {"type": "subtitle", "time": 13028.389, "timestamp": "03:37:08", "text": "はい、そうしました。立ち去ってライチュウを拾いに行こう。"}, {"type": "subtitle", "time": 13037.83, "timestamp": "03:37:17", "text": "わかった。何てことだ。わかった。戻ってきました。私は"}, {"type": "subtitle", "time": 13040.79, "timestamp": "03:37:20", "text": "家に帰る。バイバイ。"}, {"type": "subtitle", "time": 13042.469, "timestamp": "03:37:22", "text": "わかった。いいね。いいね。仕事。大丈夫です。その"}, {"type": "subtitle", "time": 13045.59, "timestamp": "03:37:25", "text": "大丈夫。私が死ぬ。誰も気にしない。"}, {"type": "subtitle", "time": 13049.67, "timestamp": "03:37:29", "text": "本当にラジンかヨクですか？"}, {"type": "subtitle", "time": 13052.63, "timestamp": "03:37:32", "text": "私は気にしない。ラーを選んでください。"}, {"type": "subtitle", "time": 13056.55, "timestamp": "03:37:36", "text": "わかった。推測している間は、誰が気にするだろうか？"}, {"type": "subtitle", "time": 13058.79, "timestamp": "03:37:38", "text": "お待ちください。なんてこった。大丈夫です。その"}, {"type": "subtitle", "time": 13062.87, "timestamp": "03:37:42", "text": "大丈夫。お待ちください。わかった。少なくとも私たちは"}, {"type": "subtitle", "time": 13065.91, "timestamp": "03:37:45", "text": "おい、俺ら5ドル持ってるぜ。"}, {"type": "subtitle", "time": 13067.79, "timestamp": "03:37:47", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 13070.87, "timestamp": "03:37:50", "text": "15ドル持ってるよ。はい。良い。しかし私たちは"}, {"type": "subtitle", "time": 13072.79, "timestamp": "03:37:52", "text": "お金を稼いだ。"}, {"type": "subtitle", "time": 13074.87, "timestamp": "03:37:54", "text": "うん。それはそれはそれはそれは2つよりも良い"}, {"type": "subtitle", "time": 13076.79, "timestamp": "03:37:56", "text": "ドルですよね？"}, {"type": "subtitle", "time": 13078.79, "timestamp": "03:37:58", "text": "うん。"}]
[{"type": "subtitle", "time": 5704.31, "timestamp": "01:35:04", "text": "どうぞ。あなたは私が彼らの"}, {"type": "subtitle", "time": 5706.07, "timestamp": "01:35:06", "text": "玉ねぎの値段が上がって、私は"}, {"type": "subtitle", "time": 5709.51, "timestamp": "01:35:09", "text": "くそ？いくらでしたか？"}, {"type": "subtitle", "time": 5712.149, "timestamp": "01:35:12", "text": "現時点でいくらなのかは分かりません。"}, {"type": "subtitle", "time": 5716.39, "timestamp": "01:35:16", "text": "当時、およそ300人くらいだったかな。"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "約300円。"}, {"type": "subtitle", "time": 5724.79, "timestamp": "01:35:24", "text": "それはちょっとやりすぎじゃないですか？"}, {"type": "subtitle", "time": 5729.75, "timestamp": "01:35:29", "text": "2つでほぼ180ルピー。具体的に何ですか？"}, {"type": "subtitle", "time": 5733.11, "timestamp": "01:35:33", "text": "幾つか？ 1キロ。高い。私はしません"}, {"type": "subtitle", "time": 5734.55, "timestamp": "01:35:34", "text": "どれくらいか知ってるよ、ちょうど３つくらいだった"}, {"type": "chat", "time": 5735.198, "timestamp": "01:35:35", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "wait till you see the prices here 🥲"}, {"type": "subtitle", "time": 5737.51, "timestamp": "01:35:37", "text": "玉ねぎ３個。何？"}, {"type": "subtitle", "time": 5739.11, "timestamp": "01:35:39", "text": "これくらいの大きさの玉ねぎ３個分くらいかな。"}, {"type": "subtitle", "time": 5741.83, "timestamp": "01:35:41", "text": "玉ねぎ３つ４つ一緒にね、兄弟。それは"}, {"type": "subtitle", "time": 5744.149, "timestamp": "01:35:44", "text": "それは市場で買ったものではなかった。それ"}, {"type": "subtitle", "time": 5745.83, "timestamp": "01:35:45", "text": "ちょうどその辺りにいたんだけど、どれがどれかわからない"}, {"type": "subtitle", "time": 5749.229, "timestamp": "01:35:49", "text": "会社かどこかだった。しかし"}, {"type": "subtitle", "time": 5752.75, "timestamp": "01:35:52", "text": "次に価格を見てください"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "ここで、私はオレンジ色です"}]
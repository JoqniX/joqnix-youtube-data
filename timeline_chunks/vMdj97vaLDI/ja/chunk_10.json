[{"type": "subtitle", "time": 619.19, "timestamp": "00:10:19", "text": "彼が話している。待って、うっかり"}, {"type": "subtitle", "time": 622.23, "timestamp": "00:10:22", "text": "彼をミュートするとか？いいえ。そうですね。ユーザー"}, {"type": "subtitle", "time": 625.29, "timestamp": "00:10:25", "text": "音声通話が有効になっています。わかった。"}, {"type": "subtitle", "time": 633.87, "timestamp": "00:10:33", "text": "えっと"}, {"type": "subtitle", "time": 641.55, "timestamp": "00:10:41", "text": "[音楽]"}, {"type": "subtitle", "time": 644.55, "timestamp": "00:10:44", "text": "日？待って、私の声が聞こえますか？私は怖いです。"}, {"type": "subtitle", "time": 647.069, "timestamp": "00:10:47", "text": "心配です"}, {"type": "subtitle", "time": 654.75, "timestamp": "00:10:54", "text": "えっと、もっと私は"}, {"type": "subtitle", "time": 658.509, "timestamp": "00:10:58", "text": "心配した。聞こえますか？"}]
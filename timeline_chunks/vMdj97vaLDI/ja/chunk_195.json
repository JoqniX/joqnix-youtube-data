[{"type": "subtitle", "time": 11700.15, "timestamp": "03:15:00", "text": "なぜなら、これは暗視機能のようなものだから"}, {"type": "subtitle", "time": 11702.63, "timestamp": "03:15:02", "text": "それ。そこで、あなたは懐中電灯を手に取ります。私"}, {"type": "subtitle", "time": 11709.349, "timestamp": "03:15:09", "text": "わかりました、ラジオを取って"}, {"type": "subtitle", "time": 11712.389, "timestamp": "03:15:12", "text": "ああ、EMFリーダーを手に取るんだね。病気"}, {"type": "subtitle", "time": 11714.87, "timestamp": "03:15:14", "text": "雑誌を手に取ってください。あなたは拾い上げます"}, {"type": "subtitle", "time": 11718.07, "timestamp": "03:15:18", "text": "移民とアカウントなので、私たちは"}, {"type": "subtitle", "time": 11720.19, "timestamp": "03:15:20", "text": "もっとお金を稼ぐことができる"}, {"type": "subtitle", "time": 11724.07, "timestamp": "03:15:24", "text": "行動することによって。"}, {"type": "subtitle", "time": 11727.59, "timestamp": "03:15:27", "text": "なぜ自分の声が聞こえるのだろう？"}, {"type": "subtitle", "time": 11732.71, "timestamp": "03:15:32", "text": "わからない。さあ行こう。見てみましょう。"}, {"type": "subtitle", "time": 11734.19, "timestamp": "03:15:34", "text": "私"}, {"type": "subtitle", "time": 11735.87, "timestamp": "03:15:35", "text": "推測"}, {"type": "subtitle", "time": 11739.59, "timestamp": "03:15:39", "text": "それで。これが重要な点です。"}, {"type": "subtitle", "time": 11745.67, "timestamp": "03:15:45", "text": "右？うん。うん。うん。 Eボーイ。"}, {"type": "subtitle", "time": 11748.79, "timestamp": "03:15:48", "text": "え、もしかしてゲーム内で喋ってるの？"}, {"type": "subtitle", "time": 11751.51, "timestamp": "03:15:51", "text": "私はそうは思わない。しかし、なぜ？私はそうは思わない"}, {"type": "subtitle", "time": 11754.71, "timestamp": "03:15:54", "text": "なぜ自分の声が聞こえるのか、その理由がわかる。あなたは"}, {"type": "subtitle", "time": 11756.349, "timestamp": "03:15:56", "text": "見ている"}, {"type": "subtitle", "time": 11759.67, "timestamp": "03:15:59", "text": "電話か何かでストリーミングする？は"}]
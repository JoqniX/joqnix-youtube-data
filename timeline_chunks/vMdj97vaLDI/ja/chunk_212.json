[{"type": "subtitle", "time": 12722.389, "timestamp": "03:32:02", "text": "見つける。この問題点はただ 1 つですが"}, {"type": "subtitle", "time": 12725.269, "timestamp": "03:32:05", "text": "このゲームは文字通り、隠れる必要があるような感じだ。"}, {"type": "subtitle", "time": 12727.59, "timestamp": "03:32:07", "text": "この本はどうやって開けますか？"}, {"type": "subtitle", "time": 12729.99, "timestamp": "03:32:09", "text": "わかった。私たちはこれ以上失明者を増やす必要があるのだろうか？さあ"}, {"type": "subtitle", "time": 12740.15, "timestamp": "03:32:20", "text": "本の開き方。いや、いや、いや。 F."}, {"type": "subtitle", "time": 12744.229, "timestamp": "03:32:24", "text": "その本を手に取ってください。 FとYeah。ジャンプ。いいえ、"}, {"type": "subtitle", "time": 12747.19, "timestamp": "03:32:27", "text": "いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ、いいえ。一つもありません。"}, {"type": "subtitle", "time": 12749.19, "timestamp": "03:32:29", "text": "二階へ行きましょう。二階へ行きましょう。"}, {"type": "subtitle", "time": 12752.15, "timestamp": "03:32:32", "text": "仕事。私を置いていかないで。私たちが死んだら、"}, {"type": "subtitle", "time": 12754.95, "timestamp": "03:32:34", "text": "私たちは共に死ぬ。それはいいです。"}, {"type": "subtitle", "time": 12758.229, "timestamp": "03:32:38", "text": "元気ですか？私は気にしない、いや、"}, {"type": "subtitle", "time": 12762.07, "timestamp": "03:32:42", "text": "お金も何もなくて、私は"}, {"type": "subtitle", "time": 12764.229, "timestamp": "03:32:44", "text": "ここで決定する。"}, {"type": "subtitle", "time": 12766.429, "timestamp": "03:32:46", "text": "あなたは"}, {"type": "subtitle", "time": 12770.63, "timestamp": "03:32:50", "text": "ここ？どこにいるの？あの音は何だ？"}, {"type": "subtitle", "time": 12772.71, "timestamp": "03:32:52", "text": "スピリットボックスを使いましたか？ああ、わかりました。"}, {"type": "subtitle", "time": 12775.03, "timestamp": "03:32:55", "text": "あなたはスピリットボックスを使っていますね。はい、そうです"}, {"type": "subtitle", "time": 12778.59, "timestamp": "03:32:58", "text": "スピリットボックスを使う。"}]
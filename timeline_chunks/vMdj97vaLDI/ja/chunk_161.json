[{"type": "subtitle", "time": 9662.71, "timestamp": "02:41:02", "text": "男？ああ、彼女は誰か厳しい人だと思う"}, {"type": "subtitle", "time": 9665.27, "timestamp": "02:41:05", "text": "回答しました。彼女は以前はこっそり覗いていた"}, {"type": "subtitle", "time": 9667.349, "timestamp": "02:41:07", "text": "風切り窓の更新情報。あなたは幸運だ"}, {"type": "subtitle", "time": 9670.71, "timestamp": "02:41:10", "text": "アスリート。なんてこった。つまり、彼女は"}, {"type": "subtitle", "time": 9674.15, "timestamp": "02:41:14", "text": "部屋からこっそり覗き見するのに使っていた？何てことだ。"}, {"type": "subtitle", "time": 9676.55, "timestamp": "02:41:16", "text": "うん。うん。彼女はオープンなのが好きらしい"}, {"type": "subtitle", "time": 9679.67, "timestamp": "02:41:19", "text": "ドアと"}, {"type": "subtitle", "time": 9682.309, "timestamp": "02:41:22", "text": "うん。うん。何てことだ。私は心を持つでしょう"}, {"type": "subtitle", "time": 9684.469, "timestamp": "02:41:24", "text": "攻撃。"}, {"type": "subtitle", "time": 9686.87, "timestamp": "02:41:26", "text": "うん。うん。地図を選びたいですか？"}, {"type": "subtitle", "time": 9688.87, "timestamp": "02:41:28", "text": "はい。どの地図をご希望ですか？あなたは"}, {"type": "subtitle", "time": 9690.95, "timestamp": "02:41:30", "text": "最小の地図ですが、最小の地図は"}, {"type": "subtitle", "time": 9693.67, "timestamp": "02:41:33", "text": "バカ。では、大きな地図を作ってみませんか？うん、"}, {"type": "subtitle", "time": 9698.15, "timestamp": "02:41:38", "text": "もちろん。お好きなものを何でも。 16部屋"}, {"type": "subtitle", "time": 9700.23, "timestamp": "02:41:40", "text": "ええと、プロフェッショナルですね。私たちは死ぬだろう"}, {"type": "subtitle", "time": 9702.87, "timestamp": "02:41:42", "text": "一瞬で。誰が気にする？わかったよ、ジョン。のように、"}, {"type": "subtitle", "time": 9705.349, "timestamp": "02:41:45", "text": "えーと、ほら、選ぶ、選ぶ、"}, {"type": "subtitle", "time": 9713.07, "timestamp": "02:41:53", "text": "準備できました"}, {"type": "subtitle", "time": 9717.27, "timestamp": "02:41:57", "text": "上。木がチリンチリンと鳴る森。"}, {"type": "subtitle", "time": 9719.59, "timestamp": "02:41:59", "text": "木材。まるでバグが発生しているみたいだ。私は"}]
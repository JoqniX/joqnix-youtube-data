[{"type": "subtitle", "time": 5220.27, "timestamp": "01:27:00", "text": "[音楽]"}, {"type": "chat", "time": 5222.477, "timestamp": "01:27:02", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "sounds like nobody cares just grab when you need"}, {"type": "subtitle", "time": 5224.629, "timestamp": "01:27:04", "text": "うん。でも、それはタブーだと聞いたんです"}, {"type": "subtitle", "time": 5228.229, "timestamp": "01:27:08", "text": "桜の花びらなどに触らないで、"}, {"type": "subtitle", "time": 5230.87, "timestamp": "01:27:10", "text": "木か何かから？"}, {"type": "chat", "time": 5232.85, "timestamp": "01:27:12", "author": "@saikatdey0909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mT2Up10wsYYwilcayEwYxOCwTgzDSnNztFejTB-x02nR8=s64-c-k-c0x00ffffff-no-rj", "message": "How are You Doing JoqUCdZBnUb7m8Pd_wUTDNqUu3Q/PVfsZ-7tIYCO_9EPt-GMgAw"}, {"type": "chat", "time": 5234.001, "timestamp": "01:27:14", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "I don't use umbrellas, I just use the big ahh leaf from animes"}, {"type": "subtitle", "time": 5234.55, "timestamp": "01:27:14", "text": "ごめん。それはルールのようなものですか、それとも"}, {"type": "subtitle", "time": 5239.07, "timestamp": "01:27:19", "text": "桜の木や葉に触れたり"}, {"type": "subtitle", "time": 5242.31, "timestamp": "01:27:22", "text": "何か？桜の花。つまり、あなた"}, {"type": "subtitle", "time": 5244.149, "timestamp": "01:27:24", "text": "楽しむ道があるように楽しむことができる"}, {"type": "subtitle", "time": 5246.31, "timestamp": "01:27:26", "text": "桜の花とか、もし落ちたら"}, {"type": "subtitle", "time": 5248.95, "timestamp": "01:27:28", "text": "君はそれで遊べるけど"}, {"type": "chat", "time": 5249.543, "timestamp": "01:27:29", "author": "@saikatdey0909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mT2Up10wsYYwilcayEwYxOCwTgzDSnNztFejTB-x02nR8=s64-c-k-c0x00ffffff-no-rj", "message": "orange Based"}, {"type": "subtitle", "time": 5251.11, "timestamp": "01:27:31", "text": "木に近づかないで、押し回すように。"}, {"type": "chat", "time": 5251.752, "timestamp": "01:27:31", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "don't shake the sakura tree"}, {"type": "subtitle", "time": 5253.11, "timestamp": "01:27:33", "text": "落ちたり、枝が折れたりする"}, {"type": "subtitle", "time": 5254.629, "timestamp": "01:27:34", "text": "なぜなら"}, {"type": "subtitle", "time": 5256.07, "timestamp": "01:27:36", "text": "場所によっては、それを書かないかもしれない"}, {"type": "subtitle", "time": 5258.79, "timestamp": "01:27:38", "text": "それは許可されていませんが、それでもそれは"}, {"type": "subtitle", "time": 5263.03, "timestamp": "01:27:43", "text": "敬意から、あなたはそうすべきではない"}, {"type": "chat", "time": 5264.304, "timestamp": "01:27:44", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "heyoo saikat"}, {"type": "subtitle", "time": 5264.87, "timestamp": "01:27:44", "text": "場所によっては書いていないので、もし"}, {"type": "subtitle", "time": 5266.629, "timestamp": "01:27:46", "text": "そこにいる何人かは、もし"}, {"type": "subtitle", "time": 5268.31, "timestamp": "01:27:48", "text": "特に一部の観光客"}, {"type": "subtitle", "time": 5269.91, "timestamp": "01:27:49", "text": "彼らは「ああ、もう取り返しがつかない」と言う"}, {"type": "subtitle", "time": 5271.83, "timestamp": "01:27:51", "text": "ここは触れることができない"}, {"type": "subtitle", "time": 5274.39, "timestamp": "01:27:54", "text": "特にここのような場所では"}, {"type": "subtitle", "time": 5276.149, "timestamp": "01:27:56", "text": "あなたが摘むと何も言いません"}, {"type": "subtitle", "time": 5278.39, "timestamp": "01:27:58", "text": "木から摘んだ花とか、そういうもの。はい。しかし"}]
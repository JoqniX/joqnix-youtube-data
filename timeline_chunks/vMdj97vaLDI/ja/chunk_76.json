[{"type": "subtitle", "time": 4562.63, "timestamp": "01:16:02", "text": "彼らについて行かないで、そう、それはまるで"}, {"type": "subtitle", "time": 4566.39, "timestamp": "01:16:06", "text": "金髪の女の子、あぁ、名前を忘れちゃった。"}, {"type": "subtitle", "time": 4568.87, "timestamp": "01:16:08", "text": "ええ、彼女は高校の教師でしたか"}, {"type": "subtitle", "time": 4571.47, "timestamp": "01:16:11", "text": "何かわかってる、わかってる、わかってる、わかってる、ええと"}, {"type": "subtitle", "time": 4574.07, "timestamp": "01:16:14", "text": "お弁当何か"}, {"type": "subtitle", "time": 4576.709, "timestamp": "01:16:16", "text": "えっと、彼女はカップルで"}, {"type": "subtitle", "time": 4581.07, "timestamp": "01:16:21", "text": "そう、私も"}, {"type": "subtitle", "time": 4584.39, "timestamp": "01:16:24", "text": "だから、学生は良いものを持っているかもしれない"}, {"type": "subtitle", "time": 4586.31, "timestamp": "01:16:26", "text": "英語なので、その後の良い点は"}, {"type": "subtitle", "time": 4589.43, "timestamp": "01:16:29", "text": "2020年は、そのほとんどが"}, {"type": "subtitle", "time": 4592.149, "timestamp": "01:16:32", "text": "看板には英語が書いてあるので、"}, {"type": "subtitle", "time": 4593.99, "timestamp": "01:16:33", "text": "ほとんどの人が心配している"}, {"type": "subtitle", "time": 4595.51, "timestamp": "01:16:35", "text": "英語なので心配する必要はありません"}, {"type": "subtitle", "time": 4597.47, "timestamp": "01:16:37", "text": "前回私が入った時"}, {"type": "subtitle", "time": 4601.189, "timestamp": "01:16:41", "text": "2017年には英語のものがあまりなかったので、"}, {"type": "subtitle", "time": 4603.99, "timestamp": "01:16:43", "text": "ひらがなは読めるけど、"}, {"type": "subtitle", "time": 4606.59, "timestamp": "01:16:46", "text": "私のように難しい人間になるには、"}, {"type": "subtitle", "time": 4609.03, "timestamp": "01:16:49", "text": "文Iを覚えておいてください、"}, {"type": "subtitle", "time": 4612.07, "timestamp": "01:16:52", "text": "私、1つを終えるのに1分くらいかかるかな"}, {"type": "subtitle", "time": 4615.35, "timestamp": "01:16:55", "text": "文。だから、でも良い点は、"}, {"type": "subtitle", "time": 4617.35, "timestamp": "01:16:57", "text": "あなたはこれ英語を持つでしょう"}, {"type": "chat", "time": 4618.601, "timestamp": "01:16:58", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "man saiko is old"}]
[{"type": "subtitle", "time": 12121.349, "timestamp": "03:22:01", "text": "懐中電灯が必要だ。追加の懐中電灯"}, {"type": "subtitle", "time": 12125.03, "timestamp": "03:22:05", "text": "とても疲れているからです。ああ、私たちは"}, {"type": "subtitle", "time": 12127.429, "timestamp": "03:22:07", "text": "温度計も。どのような？いくら"}, {"type": "subtitle", "time": 12130.229, "timestamp": "03:22:10", "text": "温度計ですか？ 30ドルです。"}, {"type": "subtitle", "time": 12132.229, "timestamp": "03:22:12", "text": "温度計は無料です。実際、私たちは"}, {"type": "subtitle", "time": 12134.71, "timestamp": "03:22:14", "text": "毎週1つずつ入手できます。"}, {"type": "subtitle", "time": 12137.349, "timestamp": "03:22:17", "text": "いいえ、いいえ、私たちは毎日温度計を手に入れるわけではありません"}, {"type": "subtitle", "time": 12139.429, "timestamp": "03:22:19", "text": "ラウンド。いいえ、温度計の意味です"}, {"type": "subtitle", "time": 12142.71, "timestamp": "03:22:22", "text": "電磁場測定器。いや、いや、いや。銃。の"}, {"type": "subtitle", "time": 12144.229, "timestamp": "03:22:24", "text": "銃。あなたが見る銃は"}, {"type": "subtitle", "time": 12146.79, "timestamp": "03:22:26", "text": "温度とともに。"}, {"type": "subtitle", "time": 12150.55, "timestamp": "03:22:30", "text": "ああ、あれは何だ？青色の銃"}, {"type": "subtitle", "time": 12159.71, "timestamp": "03:22:39", "text": "ああ、それだ。それは実際には"}, {"type": "subtitle", "time": 12163.15, "timestamp": "03:22:43", "text": "それ。グロースティック。スティックのりが欲しいの？"}, {"type": "subtitle", "time": 12166.389, "timestamp": "03:22:46", "text": "光る。正気を保つための薬。塩。いいえ。いいえ。"}, {"type": "subtitle", "time": 12169.67, "timestamp": "03:22:49", "text": "キャンドル。スマッジスティックで十分です。"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "右？わかった。あのね？あなたには"}, {"type": "subtitle", "time": 12173.67, "timestamp": "03:22:53", "text": "キャンドルとスマッジスティック"}, {"type": "subtitle", "time": 12175.95, "timestamp": "03:22:55", "text": "たくさんあります"}, {"type": "subtitle", "time": 12178.469, "timestamp": "03:22:58", "text": "スマッジスティックのようなもの。わからない。でも私は"}]
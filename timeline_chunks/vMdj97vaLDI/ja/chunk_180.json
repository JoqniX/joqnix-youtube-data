[{"type": "subtitle", "time": 10800.389, "timestamp": "03:00:00", "text": "いいえ。何ですか？いや、いや、いや。音声なしではない"}, {"type": "subtitle", "time": 10802.63, "timestamp": "03:00:02", "text": "ストリーム。私はこれでいいのですが、"}, {"type": "subtitle", "time": 10805.59, "timestamp": "03:00:05", "text": "このマイクはうまく機能する。ではない"}, {"type": "subtitle", "time": 10807.67, "timestamp": "03:00:07", "text": "マイクロフォン。すべてはこれらと同じです"}, {"type": "subtitle", "time": 10809.99, "timestamp": "03:00:09", "text": "これらは同じものですか？私はしません"}, {"type": "subtitle", "time": 10815.51, "timestamp": "03:00:15", "text": "わかった、あのね？調べてみましょう"}, {"type": "subtitle", "time": 10819.51, "timestamp": "03:00:19", "text": "音声手段です。"}, {"type": "subtitle", "time": 10821.51, "timestamp": "03:00:21", "text": "ええ、どうやらあなたの音声は"}, {"type": "subtitle", "time": 10825.269, "timestamp": "03:00:25", "text": "川の水位が低い。音量を上げてください。"}, {"type": "subtitle", "time": 10828.469, "timestamp": "03:00:28", "text": "音声が小さすぎる。うん。えっと、あなたの"}, {"type": "subtitle", "time": 10830.95, "timestamp": "03:00:30", "text": "ストリーム、音量を確認してください。"}, {"type": "subtitle", "time": 10832.51, "timestamp": "03:00:32", "text": "私は下げます"}, {"type": "subtitle", "time": 10834.269, "timestamp": "03:00:34", "text": "音声の場合"}, {"type": "subtitle", "time": 10838.23, "timestamp": "03:00:38", "text": "可能。私はあなたを作ったと思った"}, {"type": "subtitle", "time": 10839.15, "timestamp": "03:00:39", "text": "選ぶ"}, {"type": "subtitle", "time": 10842.23, "timestamp": "03:00:42", "text": "Discordのことですよね？のみ"}, {"type": "subtitle", "time": 10844.63, "timestamp": "03:00:44", "text": "Discord音声。だから、"}, {"type": "subtitle", "time": 10846.71, "timestamp": "03:00:46", "text": "Discordの音声であって、デスクトップの音声ではありません。"}, {"type": "subtitle", "time": 10850.95, "timestamp": "03:00:50", "text": "あ、待って。これはあなたのオーディオの音量ですか？"}, {"type": "subtitle", "time": 10853.429, "timestamp": "03:00:53", "text": "うん、ストリームの中では、ストリームの中では、"}, {"type": "subtitle", "time": 10858.95, "timestamp": "03:00:58", "text": "だから、人々はあなたの声を聞くことができません。"}]
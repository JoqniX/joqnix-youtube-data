[{"type": "subtitle", "time": 7321.189, "timestamp": "02:02:01", "text": "仕事。えっと"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "はい、今日はありがとうございました。ありがとうございます"}, {"type": "chat", "time": 7327.762, "timestamp": "02:02:07", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "ggs saiko"}, {"type": "subtitle", "time": 7327.99, "timestamp": "02:02:07", "text": "時間をかけて、それが"}, {"type": "subtitle", "time": 7329.47, "timestamp": "02:02:09", "text": "に変わった"}, {"type": "subtitle", "time": 7333.189, "timestamp": "02:02:13", "text": "教育的な教育の流れ。"}, {"type": "subtitle", "time": 7336.709, "timestamp": "02:02:16", "text": "久しぶりにとても楽しいです"}, {"type": "subtitle", "time": 7339.43, "timestamp": "02:02:19", "text": "おしゃべりしたり、一緒に時間を過ごしたりするのが好きです。とても"}, {"type": "subtitle", "time": 7342.55, "timestamp": "02:02:22", "text": "良い。とても気持ちよかった。私は感じる"}, {"type": "subtitle", "time": 7345.669, "timestamp": "02:02:25", "text": "何度も話した後、とてもいい感じ"}, {"type": "subtitle", "time": 7348.79, "timestamp": "02:02:28", "text": "PBO以外の誰かと話す"}, {"type": "subtitle", "time": 7351.83, "timestamp": "02:02:31", "text": "そして、話している人以外の誰か"}, {"type": "subtitle", "time": 7353.91, "timestamp": "02:02:33", "text": "誰かに「こんにちは、元気ですか？」と聞く"}, {"type": "subtitle", "time": 7356.87, "timestamp": "02:02:36", "text": "あなた？いいですね。あなたに"}, {"type": "subtitle", "time": 7359.03, "timestamp": "02:02:39", "text": "でも楽しんでくださいね。何よりも楽しむことが好きです"}, {"type": "subtitle", "time": 7361.669, "timestamp": "02:02:41", "text": "新しい場所だから、好きになる必要はない。"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "ここは新しい場所だ。あなたはそうするかもしれないが、私はそうしない"}, {"type": "subtitle", "time": 7366.87, "timestamp": "02:02:46", "text": "もしあなたが内向的なら、"}, {"type": "subtitle", "time": 7369.83, "timestamp": "02:02:49", "text": "時々、何て感じてるのかわからない"}, {"type": "subtitle", "time": 7371.27, "timestamp": "02:02:51", "text": "仲間外れにされたと感じるかもしれないが、"}, {"type": "subtitle", "time": 7373.75, "timestamp": "02:02:53", "text": "社交しようと試みる、それが"}, {"type": "subtitle", "time": 7375.83, "timestamp": "02:02:55", "text": "人々は社交しようとして"}, {"type": "subtitle", "time": 7378.39, "timestamp": "02:02:58", "text": "記憶力が良いので、もし"}, {"type": "subtitle", "time": 7379.35, "timestamp": "02:02:59", "text": "あなたはそこへ行くつもりです"}]
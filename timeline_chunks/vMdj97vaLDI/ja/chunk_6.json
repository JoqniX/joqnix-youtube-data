[{"type": "subtitle", "time": 361.59, "timestamp": "00:06:01", "text": "彼らの会話を遮りたくない。"}, {"type": "subtitle", "time": 363.79, "timestamp": "00:06:03", "text": "侵略するのが好きだろう"}, {"type": "subtitle", "time": 366.79, "timestamp": "00:06:06", "text": "誰か。それはまるで誰かの領地を侵略するようなものだ"}, {"type": "subtitle", "time": 368.029, "timestamp": "00:06:08", "text": "それ以外の場合または"}, {"type": "subtitle", "time": 370.15, "timestamp": "00:06:10", "text": "何か。なぜ彼らは"}, {"type": "subtitle", "time": 380.71, "timestamp": "00:06:20", "text": "コミュニケーションを取るのは本当に難しい。なぜ"}, {"type": "subtitle", "time": 404.51, "timestamp": "00:06:44", "text": "何か？どうすればいいですか どうすればいいですか"}, {"type": "subtitle", "time": 407.23, "timestamp": "00:06:47", "text": "メッセージ？私は"}, {"type": "subtitle", "time": 409.55, "timestamp": "00:06:49", "text": "話す。それは"}, {"type": "subtitle", "time": 412.15, "timestamp": "00:06:52", "text": "その間。待って、7人いるよ"}, {"type": "subtitle", "time": 414.07, "timestamp": "00:06:54", "text": "オンライン。誰かいるか見てみましょう"}]
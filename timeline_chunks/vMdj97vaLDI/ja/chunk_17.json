[{"type": "subtitle", "time": 1022.949, "timestamp": "00:17:02", "text": "チャット。墜落しなくて本当に良かった。聖なる"}, {"type": "subtitle", "time": 1036.15, "timestamp": "00:17:16", "text": "ゲームがクラッシュします。"}, {"type": "subtitle", "time": 1059.789, "timestamp": "00:17:39", "text": "のように"}, {"type": "subtitle", "time": 1072.11, "timestamp": "00:17:52", "text": "多く？ああ、そして太陽が昇った"}, {"type": "subtitle", "time": 1075.19, "timestamp": "00:17:55", "text": "オンライン。彼らは参加するだろうと私は信じています。"}, {"type": "subtitle", "time": 1078.07, "timestamp": "00:17:58", "text": "待って、待って、待って、待って。私と一緒に来てください。私は思う"}]
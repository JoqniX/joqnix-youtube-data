[{"type": "subtitle", "time": 11940.229, "timestamp": "03:19:00", "text": "何をしたか教えてください"}, {"type": "subtitle", "time": 11949.269, "timestamp": "03:19:09", "text": "ええと、その男です。わかった。あらら。それは"}, {"type": "subtitle", "time": 11951.19, "timestamp": "03:19:11", "text": "スピリットボックス？"}, {"type": "subtitle", "time": 11953.99, "timestamp": "03:19:13", "text": "スピリットボックス。わかった。スピリットボックスを持って行ってください。私"}, {"type": "subtitle", "time": 11957.269, "timestamp": "03:19:17", "text": "わからない。スピリットボックスの音を聞きましたか？"}, {"type": "subtitle", "time": 11960.95, "timestamp": "03:19:20", "text": "自分が自分の声を聞いているのが聞こえた。"}, {"type": "subtitle", "time": 11963.67, "timestamp": "03:19:23", "text": "誰かが「えっと、何ですか」って言ってるのが聞こえた"}, {"type": "subtitle", "time": 11967.63, "timestamp": "03:19:27", "text": "それって何？懐中電灯を見たとき"}, {"type": "subtitle", "time": 11971.51, "timestamp": "03:19:31", "text": "まばたきする。私が知っているのはそれだけです。"}, {"type": "subtitle", "time": 11975.15, "timestamp": "03:19:35", "text": "わかった。明らかに殺されたもの"}, {"type": "subtitle", "time": 11978.349, "timestamp": "03:19:38", "text": "私たち。えっと"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "もしそれを見ても、それが幽霊だと認識してはいけません。"}, {"type": "subtitle", "time": 11984.63, "timestamp": "03:19:44", "text": "見てみて。"}, {"type": "subtitle", "time": 11991.55, "timestamp": "03:19:51", "text": "私は茂みが好きだと聞きました"}, {"type": "subtitle", "time": 11999.83, "timestamp": "03:19:59", "text": "音。 EMFはその一つです。心配しないで。"}]
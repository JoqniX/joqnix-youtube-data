[{"type": "subtitle", "time": 13801.91, "timestamp": "03:50:01", "text": "良い一日をお過ごしください。"}, {"type": "subtitle", "time": 13803.07, "timestamp": "03:50:03", "text": "それで"}, {"type": "subtitle", "time": 13806.07, "timestamp": "03:50:06", "text": "面白い。また死んでしまった。待って、あなたは"}, {"type": "subtitle", "time": 13809.59, "timestamp": "03:50:09", "text": "音がとてもこもっている。見て。心配しないで。"}, {"type": "subtitle", "time": 13810.399, "timestamp": "03:50:10", "text": "心配しないで。 私は"}, {"type": "subtitle", "time": 13813.52, "timestamp": "03:50:13", "text": "私は これで大丈夫でしょうか？これで大丈夫でしょうか？うん。"}, {"type": "subtitle", "time": 13815.04, "timestamp": "03:50:15", "text": "これで大丈夫でしょうか？これで大丈夫でしょうか？うん。 うん。うん、大丈夫だよ。"}, {"type": "subtitle", "time": 13817.359, "timestamp": "03:50:17", "text": "うん。うん、大丈夫だよ。 わかった。俺は大丈夫か、兄弟？はい。牧草地"}, {"type": "subtitle", "time": 13821.439, "timestamp": "03:50:21", "text": "わかった。俺は大丈夫か、兄弟？はい。牧草地 制限装置。これは何ですか？"}, {"type": "subtitle", "time": 13827.91, "timestamp": "03:50:27", "text": "ここは一体何ですか？イエス様、ここは"}, {"type": "subtitle", "time": 13829.99, "timestamp": "03:50:29", "text": "とんでもなく大きい。"}, {"type": "subtitle", "time": 13837.51, "timestamp": "03:50:37", "text": "はい、ジュリー・トンプソンさん。"}, {"type": "subtitle", "time": 13839.59, "timestamp": "03:50:39", "text": "チームのメンバーに目撃してもらい、"}, {"type": "subtitle", "time": 13841.349, "timestamp": "03:50:41", "text": "幽霊イベント。チームのメンバーに"}, {"type": "subtitle", "time": 13845.189, "timestamp": "03:50:45", "text": "幽霊狩りの最中に幽霊から逃げる。わかった。それで、"}, {"type": "subtitle", "time": 13846.87, "timestamp": "03:50:46", "text": "幽霊から逃れるということは、私が来なければならないということです"}, {"type": "subtitle", "time": 13849.99, "timestamp": "03:50:49", "text": "このトラックに戻るか、"}, {"type": "subtitle", "time": 13852.389, "timestamp": "03:50:52", "text": "いや、逃げなければならない。逃げる。逃げる"}, {"type": "subtitle", "time": 13856.269, "timestamp": "03:50:56", "text": "つまり、生きている必要があるということだ。"}]
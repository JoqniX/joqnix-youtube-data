[{"type": "subtitle", "time": 7921.39, "timestamp": "02:12:01", "text": "スケジュールウィスパーチャレンジ"}, {"type": "subtitle", "time": 7924.95, "timestamp": "02:12:04", "text": "2025年。うん。じゃあ、実行させてください"}, {"type": "subtitle", "time": 7926.27, "timestamp": "02:12:06", "text": "下。"}, {"type": "subtitle", "time": 7929.03, "timestamp": "02:12:09", "text": "水曜日には3つのコラボレーションがあります。"}, {"type": "subtitle", "time": 7931.109, "timestamp": "02:12:11", "text": "明日は3人の協力者がいます"}, {"type": "subtitle", "time": 7934.47, "timestamp": "02:12:14", "text": "明日も"}, {"type": "subtitle", "time": 7936.55, "timestamp": "02:12:16", "text": "私が行かなければならないかもしれない日"}, {"type": "subtitle", "time": 7939.99, "timestamp": "02:12:19", "text": "父と一緒に銀行で何か"}, {"type": "subtitle", "time": 7941.75, "timestamp": "02:12:21", "text": "署名する必要があるもの、または"}, {"type": "subtitle", "time": 7943.43, "timestamp": "02:12:23", "text": "何か何か何か。そして"}, {"type": "subtitle", "time": 7945.27, "timestamp": "02:12:25", "text": "対処しなければならない問題がいくつかある。"}, {"type": "subtitle", "time": 7949.47, "timestamp": "02:12:29", "text": "12時か1時頃には戻ります。"}, {"type": "chat", "time": 7949.913, "timestamp": "02:12:29", "author": "@adthirnegii555", "avatar": "https://yt4.ggpht.com/2Cc1YwU-uCrqW2z5qvi5AkqQE1B24SRxdmfPyDze9eyV1Sux1rRBrAOLxTFmE3GC3YMqYbZsL6k=s64-c-k-c0x00ffffff-no-rj", "message": "i am gonna miss you 🥺 joq"}, {"type": "subtitle", "time": 7951.83, "timestamp": "02:12:31", "text": "約。ストリームが"}, {"type": "subtitle", "time": 7953.43, "timestamp": "02:12:33", "text": "朝に走る。パート1"}, {"type": "subtitle", "time": 7956.39, "timestamp": "02:12:36", "text": "ストリーム。この次の配信です。の"}, {"type": "subtitle", "time": 7957.589, "timestamp": "02:12:37", "text": "次の配信は午前中になります"}, {"type": "subtitle", "time": 7959.95, "timestamp": "02:12:39", "text": "明日。見せる。うん。"}, {"type": "subtitle", "time": 7963.83, "timestamp": "02:12:43", "text": "ええ、そうですね。午後3時から、"}, {"type": "subtitle", "time": 7967.109, "timestamp": "02:12:47", "text": "私たちはAraxar社と提携しています。"}, {"type": "subtitle", "time": 7968.87, "timestamp": "02:12:48", "text": "リラックスしたゲームをいくつかプレイして、"}, {"type": "subtitle", "time": 7971.83, "timestamp": "02:12:51", "text": "もの。どのゲームにするか決めなければならない"}, {"type": "subtitle", "time": 7973.35, "timestamp": "02:12:53", "text": "今夜。えっと、土壇場なんです"}, {"type": "subtitle", "time": 7975.27, "timestamp": "02:12:55", "text": "準備中ですが、はい、修正しようとしています"}, {"type": "subtitle", "time": 7978.229, "timestamp": "02:12:58", "text": "全て設定しました。そして夜になると、"}]
[{"type": "subtitle", "time": 11280.23, "timestamp": "03:08:00", "text": "凍りつくようなものを見たと聞きました。ああ、"}, {"type": "subtitle", "time": 11281.83, "timestamp": "03:08:01", "text": "神。はい。はい。大丈夫です。大丈夫です。"}, {"type": "subtitle", "time": 11283.23, "timestamp": "03:08:03", "text": "その"}, {"type": "subtitle", "time": 11285.99, "timestamp": "03:08:05", "text": "大丈夫。ごくわずかです。幽霊が出るという話はほとんどない。"}, {"type": "subtitle", "time": 11288.55, "timestamp": "03:08:08", "text": "それはいいです。幽霊が出るという話はほとんどない。その"}, {"type": "subtitle", "time": 11292.79, "timestamp": "03:08:12", "text": "わかった。 1つ手に入れました。もう一つあります。"}, {"type": "subtitle", "time": 11303.83, "timestamp": "03:08:23", "text": "いやいや、実は別のものが必要なんです。"}, {"type": "subtitle", "time": 11305.91, "timestamp": "03:08:25", "text": "実際には、別のものが必要だ。わかった、"}, {"type": "subtitle", "time": 11309.51, "timestamp": "03:08:29", "text": "了解です。何か証拠はありましたか？"}, {"type": "subtitle", "time": 11312.95, "timestamp": "03:08:32", "text": "待って、私は見た"}, {"type": "subtitle", "time": 11316.87, "timestamp": "03:08:36", "text": "えーっと、空気が来る"}, {"type": "subtitle", "time": 11319.83, "timestamp": "03:08:39", "text": "口から出たのは、ああ、あなたは手に入れた"}, {"type": "subtitle", "time": 11322.63, "timestamp": "03:08:42", "text": "それらはお持ちですか？いや、いや。私が見たように"}, {"type": "subtitle", "time": 11325.11, "timestamp": "03:08:45", "text": "ガスみたいなやつ"}, {"type": "subtitle", "time": 11327.269, "timestamp": "03:08:47", "text": "口から何かが出てくる"}, {"type": "subtitle", "time": 11329.51, "timestamp": "03:08:49", "text": "凍えるような場所"}, {"type": "subtitle", "time": 11331.11, "timestamp": "03:08:51", "text": "私たちの口から出た言葉ですよね？つまり"}, {"type": "subtitle", "time": 11334.469, "timestamp": "03:08:54", "text": "ちなみに、気温は氷点下です。わかった。だから私たちは"}, {"type": "subtitle", "time": 11337.67, "timestamp": "03:08:57", "text": "氷点下の気温になることもある。 EMFか何か"}]
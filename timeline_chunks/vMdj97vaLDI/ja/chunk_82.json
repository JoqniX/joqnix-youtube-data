[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "聞く。ええ、どちらでもできます"}, {"type": "subtitle", "time": 4922.47, "timestamp": "01:22:02", "text": "必要なら、それを手に入れるか、そうでなければ"}, {"type": "subtitle", "time": 4924.149, "timestamp": "01:22:04", "text": "緊急時のために、緊急時用に1つ用意しておきましょう。"}, {"type": "subtitle", "time": 4926.629, "timestamp": "01:22:06", "text": "5000円払って、15日間くらい使える"}, {"type": "subtitle", "time": 4929.11, "timestamp": "01:22:09", "text": "インターネットのみ。そこに着陸したら、"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "あなたの権威のような人"}, {"type": "subtitle", "time": 4933.51, "timestamp": "01:22:13", "text": "教師や誰かを雇えるような機関"}, {"type": "subtitle", "time": 4936.149, "timestamp": "01:22:16", "text": "現地のSIMカードを頼んでください。彼らは"}, {"type": "subtitle", "time": 4938.149, "timestamp": "01:22:18", "text": "より的確な判断ができるでしょう。私は提案します"}, {"type": "subtitle", "time": 4940.47, "timestamp": "01:22:20", "text": "一時的なSIMカードを入手するには"}, {"type": "subtitle", "time": 4942.39, "timestamp": "01:22:22", "text": "空港に行きたい場合は、"}, {"type": "subtitle", "time": 4945.03, "timestamp": "01:22:25", "text": "インターネットが必要ですか"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "まずあなたの現在地ですよね？はい。だから、手に入れよう"}, {"type": "subtitle", "time": 4949.189, "timestamp": "01:22:29", "text": "一時的なSIMカードを入手するには、費用がかかります。"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "5,000円くらいで15日間使えるよ"}, {"type": "subtitle", "time": 4955.91, "timestamp": "01:22:35", "text": "15日間。ええと、あなたはただ"}, {"type": "subtitle", "time": 4957.43, "timestamp": "01:22:37", "text": "インターネットのみ、それ以外は何もなし、コードも不要。しかし"}, {"type": "subtitle", "time": 4959.03, "timestamp": "01:22:39", "text": "めちゃくちゃ速い。だから、"}, {"type": "subtitle", "time": 4961.11, "timestamp": "01:22:41", "text": "それについて心配してください。そうすればとても簡単です。"}, {"type": "subtitle", "time": 4963.11, "timestamp": "01:22:43", "text": "そこに立って、それから尋ねることができます"}, {"type": "subtitle", "time": 4965.709, "timestamp": "01:22:45", "text": "あなたを助けてくれる人。ただ"}, {"type": "subtitle", "time": 4968.87, "timestamp": "01:22:48", "text": "彼らはあなたを助けてくれると言って、それからあなたは"}, {"type": "subtitle", "time": 4970.149, "timestamp": "01:22:50", "text": "それ以上何もする必要はありません"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "それ。そして、それを持って外に出る"}, {"type": "subtitle", "time": 4975.43, "timestamp": "01:22:55", "text": "インターネットヘルプ。行くよ、きっと"}, {"type": "subtitle", "time": 4978.229, "timestamp": "01:22:58", "text": "地下鉄でどこへでも直接行ける"}, {"type": "subtitle", "time": 4979.99, "timestamp": "01:22:59", "text": "あなたは行くのです。絶対にタクシーに乗ってはいけない。"}]
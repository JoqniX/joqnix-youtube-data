[{"type": "subtitle", "time": 13988.15, "timestamp": "03:53:08", "text": "あなたはここにいますか？"}, {"type": "subtitle", "time": 14001.189, "timestamp": "03:53:21", "text": "大丈夫ですか？うん。うん。カメラがある"}, {"type": "subtitle", "time": 14003.91, "timestamp": "03:53:23", "text": "そちら側。"}, {"type": "subtitle", "time": 14013.51, "timestamp": "03:53:33", "text": "ああ、下に降りなきゃ。こっちです。"}, {"type": "subtitle", "time": 14019.189, "timestamp": "03:53:39", "text": "心配しないで。誰かがこぼしたかもしれない"}, {"type": "subtitle", "time": 14021.91, "timestamp": "03:53:41", "text": "ケチャップ。何てことだ。"}, {"type": "subtitle", "time": 14023.79, "timestamp": "03:53:43", "text": "そうそう。"}, {"type": "subtitle", "time": 14026.229, "timestamp": "03:53:46", "text": "ケチャップ。彼らはケチャップを無駄にしている、私の"}, {"type": "subtitle", "time": 14029.189, "timestamp": "03:53:49", "text": "男。私は彼らのことを知りません。私はしません"}, {"type": "subtitle", "time": 14033.51, "timestamp": "03:53:53", "text": "知る。そのドアはまっすぐに開いています。"}, {"type": "subtitle", "time": 14035.389, "timestamp": "03:53:55", "text": "さあ行こう"}, {"type": "subtitle", "time": 14037.87, "timestamp": "03:53:57", "text": "それから。あなたは"}]
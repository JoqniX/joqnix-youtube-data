[{"type": "subtitle", "time": 2101.349, "timestamp": "00:35:01", "text": "一体何で彼は倒れたんだ？"}, {"type": "subtitle", "time": 2103.03, "timestamp": "00:35:03", "text": "ああ、"}, {"type": "subtitle", "time": 2135.109, "timestamp": "00:35:35", "text": "何てことだ。わかった。"}, {"type": "subtitle", "time": 2136.829, "timestamp": "00:35:36", "text": "コピーしたい"}, {"type": "subtitle", "time": 2141.109, "timestamp": "00:35:41", "text": "これ。私はコピーしたのでしょうか？彼はより暗い性格になった"}, {"type": "subtitle", "time": 2143.27, "timestamp": "00:35:43", "text": "色。何てことだ。待って。なぜ私は"}, {"type": "subtitle", "time": 2144.43, "timestamp": "00:35:44", "text": "彼の"}, {"type": "subtitle", "time": 2148.55, "timestamp": "00:35:48", "text": "あれ？うん。えっと"}, {"type": "subtitle", "time": 2153.03, "timestamp": "00:35:53", "text": "どうすればいいですか？それを複製できません。何"}, {"type": "subtitle", "time": 2159.27, "timestamp": "00:35:59", "text": "確認はできるけど、好きになれない"}]
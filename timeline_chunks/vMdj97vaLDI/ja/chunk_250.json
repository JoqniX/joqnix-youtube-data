[{"type": "subtitle", "time": 15007.51, "timestamp": "04:10:07", "text": "君はまるで愚かな指紋を探すようなものだ。"}, {"type": "subtitle", "time": 15009.99, "timestamp": "04:10:09", "text": "わからない。私は何ももらっていません。何"}, {"type": "subtitle", "time": 15020.63, "timestamp": "04:10:20", "text": "あ、トイレにいるんです。"}, {"type": "subtitle", "time": 15022.389, "timestamp": "04:10:22", "text": "待って、君はどこにいるの？あなたは2階にいますか、それとも"}, {"type": "subtitle", "time": 15025.429, "timestamp": "04:10:25", "text": "階下？ 2階へ。あなたの"}, {"type": "subtitle", "time": 15027.349, "timestamp": "04:10:27", "text": "右。どこにいるの？どこにいるのか"}, {"type": "subtitle", "time": 15030.229, "timestamp": "04:10:30", "text": "あなたは？またトイレにいるの？"}, {"type": "subtitle", "time": 15031.99, "timestamp": "04:10:31", "text": "いいえ、トイレにはいません。私は"}, {"type": "subtitle", "time": 15033.67, "timestamp": "04:10:33", "text": "トイレ。どうもありがとうございます。うん。"}, {"type": "subtitle", "time": 15036.99, "timestamp": "04:10:36", "text": "うん。ええと、ここから。ここに来て。以上"}, {"type": "subtitle", "time": 15041.75, "timestamp": "04:10:41", "text": "ここ。ここにトイレがあります。"}, {"type": "subtitle", "time": 15046.15, "timestamp": "04:10:46", "text": "トイレ？どこ？でも、トイレのことだよ"}, {"type": "subtitle", "time": 15048.389, "timestamp": "04:10:48", "text": "実は。"}, {"type": "subtitle", "time": 15055.91, "timestamp": "04:10:55", "text": "あらら。"}, {"type": "subtitle", "time": 15058.87, "timestamp": "04:10:58", "text": "どうしたの？おっと。あらら。何"}]
[{"type": "subtitle", "time": 15125.469, "timestamp": "04:12:05", "text": "ああ、今、鍵をかけちゃった？"}, {"type": "subtitle", "time": 15128.63, "timestamp": "04:12:08", "text": "ここ？どうでも。自分のものを見させてください"}, {"type": "subtitle", "time": 15131.67, "timestamp": "04:12:11", "text": "ストリーミングして確認するだけです。私は持っていた"}, {"type": "subtitle", "time": 15134.63, "timestamp": "04:12:14", "text": "考え。それが理由です。"}, {"type": "subtitle", "time": 15138.07, "timestamp": "04:12:18", "text": "ああ、わかりました。ああ、不気味だ。そう、ASMR"}, {"type": "subtitle", "time": 15140.63, "timestamp": "04:12:20", "text": "ここがちょうどいい。どうでも。"}, {"type": "subtitle", "time": 15143.67, "timestamp": "04:12:23", "text": "私はジムと一緒に行きます。"}, {"type": "subtitle", "time": 15148.389, "timestamp": "04:12:28", "text": "念のため、そうすることにします。あなたは生きていますか？"}, {"type": "subtitle", "time": 15151.03, "timestamp": "04:12:31", "text": "私は生きている。私はこう思う、私の"}, {"type": "subtitle", "time": 15153.03, "timestamp": "04:12:33", "text": "ストリームだよ、兄弟。うん。うん。うん。私は私は"}, {"type": "subtitle", "time": 15156.309, "timestamp": "04:12:36", "text": "ああ、大変だ。私は、"}, {"type": "subtitle", "time": 15158.63, "timestamp": "04:12:38", "text": "ちなみに、文字通りこの部屋の中にいます。うん。"}, {"type": "subtitle", "time": 15159.91, "timestamp": "04:12:39", "text": "うん。うん。見ていますよ。私は見ている"}, {"type": "subtitle", "time": 15162.309, "timestamp": "04:12:42", "text": "この幽霊。彼は呼吸が荒い。その"}, {"type": "subtitle", "time": 15165.03, "timestamp": "04:12:45", "text": "本当に本当にそうだ。彼はこちらに向かってきている"}, {"type": "subtitle", "time": 15166.51, "timestamp": "04:12:46", "text": "えーと、その"}, {"type": "subtitle", "time": 15170.469, "timestamp": "04:12:50", "text": "トイレ。最初のトイレ。非常にオンに"}, {"type": "subtitle", "time": 15173.79, "timestamp": "04:12:53", "text": "あれ。彼は歩いている"}, {"type": "subtitle", "time": 15177.03, "timestamp": "04:12:57", "text": "自分。なんてこった。ここにあります。ところで、私の"}, {"type": "subtitle", "time": 15179.75, "timestamp": "04:12:59", "text": "電源がオンオフを繰り返している。どこに"}]
[{"type": "subtitle", "time": 15421.269, "timestamp": "04:17:01", "text": "40ドル。わあ、40ドルももらったよ。"}, {"type": "subtitle", "time": 15424.149, "timestamp": "04:17:04", "text": "ニース。ええと、私が思うに、"}, {"type": "subtitle", "time": 15428.63, "timestamp": "04:17:08", "text": "せめて生き延びろ。よし、やってみよう。"}, {"type": "subtitle", "time": 15431.59, "timestamp": "04:17:11", "text": "うん。うん。わかった、わかった、"}, {"type": "subtitle", "time": 15434.71, "timestamp": "04:17:14", "text": "私たちはレベル6です。うん、まだレベルは変わらないよ"}, {"type": "subtitle", "time": 15437.11, "timestamp": "04:17:17", "text": "レベル5。あなたは何をしましたか"}, {"type": "subtitle", "time": 15441.83, "timestamp": "04:17:21", "text": "ロックを解除しますか？モーションロックを解除しました"}, {"type": "subtitle", "time": 15444.149, "timestamp": "04:17:24", "text": "モーションセンサー。モーションセンサー。おお、いいね、"}, {"type": "subtitle", "time": 15446.87, "timestamp": "04:17:26", "text": "いいね、いいね。"}, {"type": "subtitle", "time": 15448.95, "timestamp": "04:17:28", "text": "ああ、パラボラマイクなら買えるよ。"}, {"type": "subtitle", "time": 15452.149, "timestamp": "04:17:32", "text": "一体何なんだ？何？"}, {"type": "subtitle", "time": 15453.51, "timestamp": "04:17:33", "text": "ああ、いやいや、気にしないでください。どうでも。"}, {"type": "subtitle", "time": 15457.11, "timestamp": "04:17:37", "text": "どうでも。バカは買えない。"}, {"type": "subtitle", "time": 15459.91, "timestamp": "04:17:39", "text": "65ドルです。"}, {"type": "subtitle", "time": 15462.71, "timestamp": "04:17:42", "text": "馬鹿げている。わかった。とにかく、私たちはすでに"}, {"type": "subtitle", "time": 15465.51, "timestamp": "04:17:45", "text": "EMFの動画を入手してください。私たちはすでに"}, {"type": "subtitle", "time": 15473.75, "timestamp": "04:17:53", "text": "懐中電灯。ああ、私たちはすでに"}, {"type": "subtitle", "time": 15475.07, "timestamp": "04:17:55", "text": "写真"}, {"type": "subtitle", "time": 15477.429, "timestamp": "04:17:57", "text": "カメラ。ええ、そうですね。うん。取らないで"}]
[{"type": "subtitle", "time": 8103.03, "timestamp": "02:15:03", "text": "それで構いません、など。私は持っていきたいです"}, {"type": "subtitle", "time": 8105.189, "timestamp": "02:15:05", "text": "新しいYouTuberが話したり交流したり"}, {"type": "subtitle", "time": 8108.31, "timestamp": "02:15:08", "text": "彼らも例外ではない。ええと、私は持っていません"}, {"type": "subtitle", "time": 8111.27, "timestamp": "02:15:11", "text": "まだ多くの人に連絡を取っていません。えっと、私は"}, {"type": "subtitle", "time": 8113.189, "timestamp": "02:15:13", "text": "保留中のタスクを完了させるためですよね？私"}, {"type": "subtitle", "time": 8116.709, "timestamp": "02:15:16", "text": "74人以上の人に連絡を取った"}, {"type": "subtitle", "time": 8120.55, "timestamp": "02:15:20", "text": "それについて。自由で有能な人はごくわずかです"}, {"type": "subtitle", "time": 8123.669, "timestamp": "02:15:23", "text": "気軽に立ち寄って私と話をしてください"}, {"type": "subtitle", "time": 8125.43, "timestamp": "02:15:25", "text": "などなど。だから私は手に入れようとしている"}, {"type": "subtitle", "time": 8128.79, "timestamp": "02:15:28", "text": "みんな。はい、VTuberも例外ではありません。私はします"}, {"type": "subtitle", "time": 8131.83, "timestamp": "02:15:31", "text": "古い世代に連絡を取っている"}, {"type": "subtitle", "time": 8135.35, "timestamp": "02:15:35", "text": "ええと、私が持っている連絡先。えっと、年配の連絡先"}, {"type": "subtitle", "time": 8137.669, "timestamp": "02:15:37", "text": "持っている。私にはできない人がいる"}, {"type": "subtitle", "time": 8140.27, "timestamp": "02:15:40", "text": "ストリームを開始"}, {"type": "subtitle", "time": 8144.39, "timestamp": "02:15:44", "text": "制限とか色々あるけど、たぶん"}, {"type": "subtitle", "time": 8147.189, "timestamp": "02:15:47", "text": "協力すれば問題ないし、むしろ良い"}, {"type": "subtitle", "time": 8149.43, "timestamp": "02:15:49", "text": "将来彼らと共にダウンでダウン"}, {"type": "subtitle", "time": 8153.51, "timestamp": "02:15:53", "text": "列に並んで。ええ、だってそういうこともあるから"}, {"type": "subtitle", "time": 8155.83, "timestamp": "02:15:55", "text": "他にもいろいろ。"}, {"type": "subtitle", "time": 8158.79, "timestamp": "02:15:58", "text": "私がこれまで見てきたユーチューバーのほとんどは"}]
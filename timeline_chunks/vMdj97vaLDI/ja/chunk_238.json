[{"type": "subtitle", "time": 14281.75, "timestamp": "03:58:01", "text": "いつものようにバカなことをしているだけだ。いいえ、やめてください"}, {"type": "subtitle", "time": 14285.429, "timestamp": "03:58:05", "text": "それについて心配してください。よし。"}, {"type": "subtitle", "time": 14297.51, "timestamp": "03:58:17", "text": "うん。オバケ。"}, {"type": "subtitle", "time": 14300.79, "timestamp": "03:58:20", "text": "お化けってどういう意味ですか？電磁波レベル5。私"}, {"type": "subtitle", "time": 14303.03, "timestamp": "03:58:23", "text": "電磁界レベルは測定できませんでした。 EMF測定を受けました"}, {"type": "subtitle", "time": 14306.429, "timestamp": "03:58:26", "text": "手に付けてみたけど、いまだに全く見当がつかない。"}, {"type": "subtitle", "time": 14309.349, "timestamp": "03:58:29", "text": "時々この幽霊は形を変える"}, {"type": "subtitle", "time": 14312.51, "timestamp": "03:58:32", "text": "独自のものを残しながらシフトする"}, {"type": "subtitle", "time": 14314.87, "timestamp": "03:58:34", "text": "証拠。ストランドを捕獲する際に"}, {"type": "subtitle", "time": 14317.269, "timestamp": "03:58:37", "text": "使節。オバキはめったに"}, {"type": "subtitle", "time": 14319.99, "timestamp": "03:58:39", "text": "トレース。"}, {"type": "subtitle", "time": 14321.59, "timestamp": "03:58:41", "text": "おお、"}, {"type": "subtitle", "time": 14323.95, "timestamp": "03:58:43", "text": "恐ろしい変身能力を持つ"}, {"type": "subtitle", "time": 14327.429, "timestamp": "03:58:47", "text": "様々な形態をとる。彼らは見てきた"}, {"type": "subtitle", "time": 14329.91, "timestamp": "03:58:49", "text": "人型に変形して"}, {"type": "subtitle", "time": 14336.389, "timestamp": "03:58:56", "text": "人間。うん。あなたは学びたい"}, {"type": "subtitle", "time": 14339.51, "timestamp": "03:58:59", "text": "どれもよくわからない。まったく"}]
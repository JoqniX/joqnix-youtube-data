[{"type": "subtitle", "time": 1461.59, "timestamp": "00:24:21", "text": "こんにちは、ゲンキです。ああ、くそ。うん。ああ、男の人だ。"}, {"type": "subtitle", "time": 1463.87, "timestamp": "00:24:23", "text": "あなたも"}, {"type": "subtitle", "time": 1479.029, "timestamp": "00:24:39", "text": "彼は一生懸命タイピングしている。"}, {"type": "subtitle", "time": 1480.47, "timestamp": "00:24:40", "text": "インドネシア。ああ、人が"}, {"type": "subtitle", "time": 1483.07, "timestamp": "00:24:43", "text": "私の周り。私は"}, {"type": "subtitle", "time": 1495.99, "timestamp": "00:24:55", "text": "いや。ああ、怖い。その過程で、"}, {"type": "subtitle", "time": 1498.31, "timestamp": "00:24:58", "text": "私は怖いです。たくさんの人がいる"}]
[{"type": "subtitle", "time": 11760.429, "timestamp": "03:16:00", "text": "あなた"}, {"type": "subtitle", "time": 11764.229, "timestamp": "03:16:04", "text": "ここ？あなたはここにいますか？名前は何ですか"}, {"type": "subtitle", "time": 11766.15, "timestamp": "03:16:06", "text": "の"}, {"type": "subtitle", "time": 11769.429, "timestamp": "03:16:09", "text": "ラーロ？大丈夫。いや、いや、やめて、やめて"}, {"type": "subtitle", "time": 11771.349, "timestamp": "03:16:11", "text": "そう言ってください。私たちは死につつある"}, {"type": "subtitle", "time": 11773.429, "timestamp": "03:16:13", "text": "一言でも発する。仕事。やめてください"}, {"type": "subtitle", "time": 11781.59, "timestamp": "03:16:21", "text": "わかった。このイギリス人男性は誰ですか？"}, {"type": "subtitle", "time": 11785.03, "timestamp": "03:16:25", "text": "彼はイギリス人だ。わからない。違う"}, {"type": "subtitle", "time": 11787.99, "timestamp": "03:16:27", "text": "この男も同じ人物なのか？この男は"}, {"type": "subtitle", "time": 11791.59, "timestamp": "03:16:31", "text": "今まさにあなたが言ったのと同じ野郎だ。"}, {"type": "subtitle", "time": 11796.03, "timestamp": "03:16:36", "text": "待って、でも、わかった。うん。しないで"}, {"type": "subtitle", "time": 11798.87, "timestamp": "03:16:38", "text": "彼らは一瞬で死んでしまうんじゃないの？お願いします"}, {"type": "subtitle", "time": 11802.229, "timestamp": "03:16:42", "text": "そんなことはしないでください。"}, {"type": "subtitle", "time": 11810.309, "timestamp": "03:16:50", "text": "わかった。ああ、私は、私は、まるで絶望的です。"}, {"type": "subtitle", "time": 11812.71, "timestamp": "03:16:52", "text": "ジョー、どこにいるの？私はまるで"}, {"type": "subtitle", "time": 11816.389, "timestamp": "03:16:56", "text": "部屋。ラリーの奥さんの部屋だと思う"}]
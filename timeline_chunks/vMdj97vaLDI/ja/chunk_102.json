[{"type": "subtitle", "time": 6121.99, "timestamp": "01:42:01", "text": "本当に強いってこと？ええ、そうです"}, {"type": "subtitle", "time": 6125.43, "timestamp": "01:42:05", "text": "非常に強い。私は好きです、私は好きです"}, {"type": "subtitle", "time": 6129.87, "timestamp": "01:42:09", "text": "ジャガー・マスターとレッドブル。私はワインが好きです"}, {"type": "subtitle", "time": 6132.87, "timestamp": "01:42:12", "text": "そして、私はビールが大好きです。ワインとビール。"}, {"type": "subtitle", "time": 6134.149, "timestamp": "01:42:14", "text": "それが私にとって最高の組み合わせです。私はいつも"}, {"type": "subtitle", "time": 6136.39, "timestamp": "01:42:16", "text": "ワインとビールをよく飲む。私は高い"}, {"type": "subtitle", "time": 6138.149, "timestamp": "01:42:18", "text": "ワインやビールに対する耐性は"}, {"type": "subtitle", "time": 6141.03, "timestamp": "01:42:21", "text": "ウォッカ。レモンはそうする。これが何なのかわかりません"}, {"type": "chat", "time": 6142.104, "timestamp": "01:42:22", "author": "@vinzidcreator", "avatar": "https://yt4.ggpht.com/6N6hlttqAPJW-h4WV0cWFHqds0lBhXYYguTso6VNcwcD9Pl0uHdL7RphVieFjKCvwzUnqOh1=s64-c-k-c0x00ffffff-no-rj", "message": "im so used to patiala pegs that normal pegs feel like 30ml to me :,)"}, {"type": "subtitle", "time": 6142.87, "timestamp": "01:42:22", "text": "は。本当に奇妙だ。あなたはただ行くことができます"}, {"type": "subtitle", "time": 6145.83, "timestamp": "01:42:25", "text": "どの会社でも構いません。そうすれば入手できます。"}, {"type": "subtitle", "time": 6148.629, "timestamp": "01:42:28", "text": "きっと理解できますよ。"}, {"type": "subtitle", "time": 6150.709, "timestamp": "01:42:30", "text": "でも、もしあなたがkに行って、それから"}, {"type": "subtitle", "time": 6152.55, "timestamp": "01:42:32", "text": "サラリーマンが酔っ払っているのを見ても、助けない"}, {"type": "subtitle", "time": 6156.709, "timestamp": "01:42:36", "text": "彼らも私と同じようにした。とても不快だ。"}, {"type": "subtitle", "time": 6158.629, "timestamp": "01:42:38", "text": "待って、あなたは戻って"}, {"type": "subtitle", "time": 6161.03, "timestamp": "01:42:41", "text": "タクシーか、それとも家か何か？いいえ、私は"}, {"type": "subtitle", "time": 6162.55, "timestamp": "01:42:42", "text": "それはしなかった。私はそんなことはしていません。私"}, {"type": "subtitle", "time": 6164.79, "timestamp": "01:42:44", "text": "私と友達がちょうどその直後だった"}, {"type": "subtitle", "time": 6167.189, "timestamp": "01:42:47", "text": "私たちはコックにいましたが、お酒は飲みませんでした"}, {"type": "subtitle", "time": 6169.43, "timestamp": "01:42:49", "text": "アルコール。私たちはただ歌っていて"}, {"type": "subtitle", "time": 6171.35, "timestamp": "01:42:51", "text": "真夜中、午前2時過ぎだった。"}, {"type": "subtitle", "time": 6174.79, "timestamp": "01:42:54", "text": "３つ目、私たちは戻って、それから"}, {"type": "subtitle", "time": 6177.669, "timestamp": "01:42:57", "text": "酔っ払った人たちがいた"}, {"type": "subtitle", "time": 6179.43, "timestamp": "01:42:59", "text": "文字通り彼らの上に吐いて、それから"}]
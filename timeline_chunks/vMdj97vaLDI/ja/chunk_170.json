[{"type": "subtitle", "time": 10205.349, "timestamp": "02:50:05", "text": "ああ。ああ、それはこの部屋にありますよ。で"}, {"type": "subtitle", "time": 10208.07, "timestamp": "02:50:08", "text": "この部屋。私は隠れている。私は隠れている。私は"}, {"type": "subtitle", "time": 10210.63, "timestamp": "02:50:10", "text": "ごめん。はい。"}, {"type": "subtitle", "time": 10213.59, "timestamp": "02:50:13", "text": "ここ。どこがいいですか？えっと、その向こう側"}, {"type": "subtitle", "time": 10216.23, "timestamp": "02:50:16", "text": "ここ。真っ直ぐ。ここにあるもの。わかった。"}, {"type": "subtitle", "time": 10217.83, "timestamp": "02:50:17", "text": "うん。うん。うん。うん。それです。うん。"}, {"type": "subtitle", "time": 10220.87, "timestamp": "02:50:20", "text": "うん。うん。うん。あなたはここにいますか？わかった。"}, {"type": "subtitle", "time": 10222.83, "timestamp": "02:50:22", "text": "これはこれです"}, {"type": "subtitle", "time": 10226.51, "timestamp": "02:50:26", "text": "それは2です。わかった。ああ、凍えるほど寒い"}, {"type": "subtitle", "time": 10229.67, "timestamp": "02:50:29", "text": "クローゼット内の温度。私は見ることができます"}, {"type": "subtitle", "time": 10233.469, "timestamp": "02:50:33", "text": "クローゼットの中にあるものが見える。"}, {"type": "subtitle", "time": 10236.309, "timestamp": "02:50:36", "text": "わかった。それは、ああ、それは、"}, {"type": "subtitle", "time": 10238.23, "timestamp": "02:50:38", "text": "バスルーム。どうでも。凍えるほど寒くはない"}, {"type": "subtitle", "time": 10243.71, "timestamp": "02:50:43", "text": "しかし"}, {"type": "subtitle", "time": 10246.19, "timestamp": "02:50:46", "text": "わかった。氷点下ではない"}, {"type": "subtitle", "time": 10249.75, "timestamp": "02:50:49", "text": "まだ。寒くなってきたけど、"}, {"type": "subtitle", "time": 10252.71, "timestamp": "02:50:52", "text": "氷点下の気温。わかった。私はそうすべきでしょうか"}, {"type": "subtitle", "time": 10255.67, "timestamp": "02:50:55", "text": "えっと、日記に記録しておこうか？"}, {"type": "subtitle", "time": 10257.19, "timestamp": "02:50:57", "text": "いやいや、氷点下になるような気温じゃないよ。"}, {"type": "subtitle", "time": 10259.15, "timestamp": "02:50:59", "text": "それは、そうでなければならない"}]
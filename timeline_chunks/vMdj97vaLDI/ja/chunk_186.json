[{"type": "subtitle", "time": 11162.79, "timestamp": "03:06:02", "text": "本。わかった。私は本を​​持っています。私は私は持っています"}, {"type": "subtitle", "time": 11166.07, "timestamp": "03:06:06", "text": "廊下に本を置いた。だから私たちは"}, {"type": "subtitle", "time": 11168.349, "timestamp": "03:06:08", "text": "何かを得る"}, {"type": "subtitle", "time": 11171.51, "timestamp": "03:06:11", "text": "それ。それで"}, {"type": "subtitle", "time": 11177.269, "timestamp": "03:06:17", "text": "ここはトイレだと思う。汚い"}, {"type": "subtitle", "time": 11179.349, "timestamp": "03:06:19", "text": "水。その中には汚れた水が入っている。いいえ。"}, {"type": "subtitle", "time": 11182.87, "timestamp": "03:06:22", "text": "誰かの叫び声が聞こえましたか？"}, {"type": "subtitle", "time": 11185.19, "timestamp": "03:06:25", "text": "いいえ。どこにいるのですか？何？なぜ"}, {"type": "subtitle", "time": 11189.59, "timestamp": "03:06:29", "text": "私のような？私は地下室にいます。"}, {"type": "subtitle", "time": 11191.269, "timestamp": "03:06:31", "text": "地下。地下室に行きたいですか？"}, {"type": "subtitle", "time": 11198.23, "timestamp": "03:06:38", "text": "これ見ましたか？私はこれを触っていました"}, {"type": "subtitle", "time": 11199.87, "timestamp": "03:06:39", "text": "そして叫び声が聞こえた"}, {"type": "subtitle", "time": 11203.269, "timestamp": "03:06:43", "text": "ノイズ。これだよ。わかった。わかった。あなたは"}, {"type": "subtitle", "time": 11206.95, "timestamp": "03:06:46", "text": "分析を持っている唯一の人"}, {"type": "subtitle", "time": 11210.07, "timestamp": "03:06:50", "text": "装置。それでは、食料の入った箱を取り出してください。"}, {"type": "subtitle", "time": 11212.469, "timestamp": "03:06:52", "text": "今あなたが持っているものなら何でも、"}]
[{"type": "subtitle", "time": 1875.669, "timestamp": "00:31:15", "text": "彼は、空腹は良いことだと言う。それで十分だ。おお"}, {"type": "subtitle", "time": 1878.51, "timestamp": "00:31:18", "text": "我が神よ。それはとても"}, {"type": "subtitle", "time": 1889.269, "timestamp": "00:31:29", "text": "でも、たくさんの人が"}, {"type": "subtitle", "time": 1912.75, "timestamp": "00:31:52", "text": "えーと"}, {"type": "subtitle", "time": 1916.43, "timestamp": "00:31:56", "text": "待って。翻訳する必要がある"}, {"type": "subtitle", "time": 1918.63, "timestamp": "00:31:58", "text": "これ。日本人はどこにいる？どこ"}]
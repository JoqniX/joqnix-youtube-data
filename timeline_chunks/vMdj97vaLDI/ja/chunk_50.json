[{"type": "subtitle", "time": 3000.63, "timestamp": "00:50:00", "text": "私と一緒にバナナとクルミのケーキを食べます。おお、"}, {"type": "subtitle", "time": 3004.15, "timestamp": "00:50:04", "text": "私はそれを食べるつもりだ。どうやって"}, {"type": "subtitle", "time": 3006.71, "timestamp": "00:50:06", "text": "これを開かなきゃいけない時って嫌だよね？私はしません"}, {"type": "subtitle", "time": 3009.03, "timestamp": "00:50:09", "text": "これを開ける方法を知っている。"}, {"type": "chat", "time": 3009.436, "timestamp": "00:50:09", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "banana and wallnut?"}, {"type": "subtitle", "time": 3012.589, "timestamp": "00:50:12", "text": "ああ、プラスチックのカバーか。ええ、"}, {"type": "subtitle", "time": 3014.71, "timestamp": "00:50:14", "text": "プラスティカ。でも私は一番良い方法を知っている"}, {"type": "subtitle", "time": 3024.47, "timestamp": "00:50:24", "text": "ペン。はい。穴をいくつか開ける。"}, {"type": "subtitle", "time": 3026.71, "timestamp": "00:50:26", "text": "穴を開ける。パンチしないように注意してください"}, {"type": "subtitle", "time": 3028.829, "timestamp": "00:50:28", "text": "の"}, {"type": "subtitle", "time": 3031.51, "timestamp": "00:50:31", "text": "ケーキ。そして、もしナビが見ているなら"}, {"type": "subtitle", "time": 3034.27, "timestamp": "00:50:34", "text": "これは、これはあなたの"}, {"type": "subtitle", "time": 3037.549, "timestamp": "00:50:37", "text": "ペン。ごめんなさい、"}, {"type": "subtitle", "time": 3040.069, "timestamp": "00:50:40", "text": "ナビ。私をこんな目に遭わせた報いだ"}, {"type": "subtitle", "time": 3042.43, "timestamp": "00:50:42", "text": "ベビーシッター"}, {"type": "subtitle", "time": 3047.91, "timestamp": "00:50:47", "text": "え。わかった。バナナとクルミ。はい。"}, {"type": "subtitle", "time": 3049.549, "timestamp": "00:50:49", "text": "これ"}, {"type": "subtitle", "time": 3055.43, "timestamp": "00:50:55", "text": "熱い。とにかく、ああ、チャンスがあるよ"}, {"type": "subtitle", "time": 3057.99, "timestamp": "00:50:57", "text": "ここ。"}]
[{"type": "subtitle", "time": 14401.309, "timestamp": "04:00:01", "text": "壁を通して。イエス"}, {"type": "subtitle", "time": 14403.99, "timestamp": "04:00:03", "text": "フリークはほとんど地面に触れない"}, {"type": "subtitle", "time": 14407.189, "timestamp": "04:00:07", "text": "つまり、足跡で罠を仕掛けることはできないということだ"}, {"type": "subtitle", "time": 14409.91, "timestamp": "04:00:09", "text": "塩を恐れる弱点と"}, {"type": "subtitle", "time": 14419.59, "timestamp": "04:00:19", "text": "em5 スピリットボックスと"}, {"type": "subtitle", "time": 14423.83, "timestamp": "04:00:23", "text": "えーっと、ドットプロジェクター、イエス・キリスト"}, {"type": "subtitle", "time": 14430.469, "timestamp": "04:00:30", "text": "いいえ、それは、それが問題です。"}, {"type": "subtitle", "time": 14432.87, "timestamp": "04:00:32", "text": "それは緑色のものです。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 14435.67, "timestamp": "04:00:35", "text": "見えますか？ 見えますか？のように"}, {"type": "subtitle", "time": 14438.469, "timestamp": "04:00:38", "text": "2つ目はビデオカメラです。の"}, {"type": "subtitle", "time": 14442.55, "timestamp": "04:00:42", "text": "次はDOSプロジェクターです。わかった。手に入れた"}, {"type": "subtitle", "time": 14446.67, "timestamp": "04:00:46", "text": "それ。うん。うん。それが点です"}, {"type": "subtitle", "time": 14448.87, "timestamp": "04:00:48", "text": "プロジェクター。それでは、"}, {"type": "subtitle", "time": 14451.269, "timestamp": "04:00:51", "text": "ファントム。ファントムとは幽霊のことで"}, {"type": "subtitle", "time": 14454.07, "timestamp": "04:00:54", "text": "生きている流れ込む恐怖を所有することができる"}, {"type": "subtitle", "time": 14457.189, "timestamp": "04:00:57", "text": "その周りに。ほとんど一般的に"}]
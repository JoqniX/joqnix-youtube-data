[{"type": "subtitle", "time": 8402.389, "timestamp": "02:20:02", "text": "3つのアカウント。残念ながら、私は"}, {"type": "subtitle", "time": 8405.59, "timestamp": "02:20:05", "text": "入る。ここにいるJnix氏とは違って、彼は"}, {"type": "subtitle", "time": 8408.63, "timestamp": "02:20:08", "text": "文字通り、雷電の代金を支払った。そうですね、"}, {"type": "subtitle", "time": 8411.349, "timestamp": "02:20:11", "text": "彼が持っていたが、私は支払っても得られなかった"}, {"type": "subtitle", "time": 8413.67, "timestamp": "02:20:13", "text": "けれど。それは偶然から"}, {"type": "subtitle", "time": 8417.19, "timestamp": "02:20:17", "text": "その後のあれ。私は「ええと、私は"}, {"type": "subtitle", "time": 8419.99, "timestamp": "02:20:19", "text": "雷電は手に入らない。そしてある日私はこう思った"}, {"type": "subtitle", "time": 8422.55, "timestamp": "02:20:22", "text": "コッコミに行くよ。しかし、それから、"}, {"type": "subtitle", "time": 8424.07, "timestamp": "02:20:24", "text": "バナー最終日、私はこう思った。"}, {"type": "subtitle", "time": 8425.59, "timestamp": "02:20:25", "text": "うん、私が"}, {"type": "subtitle", "time": 8426.87, "timestamp": "02:20:26", "text": "1回引っ張ってください。"}, {"type": "subtitle", "time": 8427.95, "timestamp": "02:20:27", "text": "ドーン、彼女は"}, {"type": "subtitle", "time": 8430.389, "timestamp": "02:20:30", "text": "来る。それから私は偏見を得ようとしていた"}, {"type": "subtitle", "time": 8437.349, "timestamp": "02:20:37", "text": "えっと、ウェンを身につけていたいだけなんです。私は欲しい"}, {"type": "subtitle", "time": 8439.389, "timestamp": "02:20:39", "text": "ウェン選手のチームが完成する。しかし"}, {"type": "subtitle", "time": 8441.67, "timestamp": "02:20:41", "text": "残念ながら、ギンチンの誰かが"}, {"type": "subtitle", "time": 8445.67, "timestamp": "02:20:45", "text": "Impactは私を嘲笑っているし"}, {"type": "subtitle", "time": 8447.99, "timestamp": "02:20:47", "text": "雷電を手に入れられないようにする。私はとても"}, {"type": "subtitle", "time": 8451.99, "timestamp": "02:20:51", "text": "それについては嬉しいです。ああ、しまった、餌をあげてしまった。私"}, {"type": "subtitle", "time": 8453.07, "timestamp": "02:20:53", "text": "見つけた"}, {"type": "subtitle", "time": 8455.51, "timestamp": "02:20:55", "text": "イヤホン。はい、少々お待ちください。楽しむ"}, {"type": "subtitle", "time": 8457.59, "timestamp": "02:20:57", "text": "水。トイレに行って戻ってきて。ああ神様、"}]
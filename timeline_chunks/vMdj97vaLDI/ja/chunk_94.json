[{"type": "subtitle", "time": 5645.59, "timestamp": "01:34:05", "text": "そしてたくさんのものを手に入れ、そしてこれ"}, {"type": "subtitle", "time": 5648.47, "timestamp": "01:34:08", "text": "えーと、違うタイプの便利さですよね"}, {"type": "subtitle", "time": 5650.229, "timestamp": "01:34:10", "text": "これは卸売りのようなもので、購入できます"}, {"type": "subtitle", "time": 5653.669, "timestamp": "01:34:13", "text": "卸売りの商品、例えば野菜など"}, {"type": "subtitle", "time": 5656.709, "timestamp": "01:34:16", "text": "卸売りのようなものとは"}, {"type": "subtitle", "time": 5661.189, "timestamp": "01:34:21", "text": "また電話がかかってきたの？名前を忘れてしまった。私のえっと"}, {"type": "subtitle", "time": 5663.75, "timestamp": "01:34:23", "text": "日本の先生は私にこう言った、君はそうしないだろうと"}, {"type": "subtitle", "time": 5666.39, "timestamp": "01:34:26", "text": "コンビニで購入する必要があります。その"}, {"type": "chat", "time": 5668.741, "timestamp": "01:34:28", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "how many weeks will joqqy be there?"}, {"type": "subtitle", "time": 5669.43, "timestamp": "01:34:29", "text": "高い。別の場所に行くことができます"}, {"type": "subtitle", "time": 5671.99, "timestamp": "01:34:31", "text": "会社の種類。うん。うん。実は、"}, {"type": "subtitle", "time": 5673.51, "timestamp": "01:34:33", "text": "うん、できるよ。実際、私は"}, {"type": "subtitle", "time": 5675.91, "timestamp": "01:34:35", "text": "そこへ。野菜市場みたいなものがある"}, {"type": "subtitle", "time": 5677.83, "timestamp": "01:34:37", "text": "どこにでも。石鹸も手に入りますし、"}, {"type": "subtitle", "time": 5679.75, "timestamp": "01:34:39", "text": "シャンプーなど全てとても安い"}, {"type": "subtitle", "time": 5681.669, "timestamp": "01:34:41", "text": "額。でもそれは大きいけど"}, {"type": "subtitle", "time": 5686.55, "timestamp": "01:34:46", "text": "でも名前がわからないのは、"}, {"type": "subtitle", "time": 5688.87, "timestamp": "01:34:48", "text": "私が行ったものは、"}, {"type": "subtitle", "time": 5692.55, "timestamp": "01:34:52", "text": "県。変わるかもしれない"}, {"type": "subtitle", "time": 5694.55, "timestamp": "01:34:54", "text": "都道
[{"type": "subtitle", "time": 302.39, "timestamp": "00:05:02", "text": "えっと、彼らは何かのゲームについて話しているんです。"}, {"type": "subtitle", "time": 310.87, "timestamp": "00:05:10", "text": "あ、待って。インターネットの調子が悪くなりました。"}, {"type": "subtitle", "time": 312.39, "timestamp": "00:05:12", "text": "待って、待って、待って。インターネットが動作しています"}, {"type": "subtitle", "time": 315.43, "timestamp": "00:05:15", "text": "上。何かダウンロード中ですか？"}, {"type": "subtitle", "time": 317.469, "timestamp": "00:05:17", "text": "待って、何か"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "ダウンロード中？いいえ。そうですね。"}, {"type": "subtitle", "time": 322.35, "timestamp": "00:05:22", "text": "すべてを閉じます"}, {"type": "subtitle", "time": 325.07, "timestamp": "00:05:25", "text": "もの。"}, {"type": "subtitle", "time": 328.95, "timestamp": "00:05:28", "text": "えっと、ダウンロードって何ですか？すごい。あなたは"}, {"type": "subtitle", "time": 336.39, "timestamp": "00:05:36", "text": "ええ、そうですね。わかった。今は安定しています。私は思う"}, {"type": "subtitle", "time": 338.71, "timestamp": "00:05:38", "text": "閉じました。チームか何かだったんだ。"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "わかった。わかった。つまり、ストリームは"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "大丈夫。エンダはどうなっているのでしょうか？"}, {"type": "subtitle", "time": 344.51, "timestamp": "00:05:44", "text": "彼は"}, {"type": "subtitle", "time": 351.95, "timestamp": "00:05:51", "text": "彼。"}, {"type": "subtitle", "time": 354.87, "timestamp": "00:05:54", "text": "そして、ここには誰かが寝ている。見てください"}, {"type": "subtitle", "time": 355.79, "timestamp": "00:05:55", "text": "彼ら"}, {"type": "subtitle", "time": 359.909, "timestamp": "00:05:59", "text": "寝る。少ししたら戻ってきます。"}]
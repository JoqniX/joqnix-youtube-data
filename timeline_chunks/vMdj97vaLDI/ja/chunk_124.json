[{"type": "subtitle", "time": 7441.589, "timestamp": "02:04:01", "text": "うん。あなたが望むなら、試してみてください。"}, {"type": "subtitle", "time": 7445.03, "timestamp": "02:04:05", "text": "パートタイムで雇うこともできます。人々は"}, {"type": "chat", "time": 7447.404, "timestamp": "02:04:07", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "holy"}, {"type": "subtitle", "time": 7447.51, "timestamp": "02:04:07", "text": "参加する。パートタイムは必須です"}, {"type": "subtitle", "time": 7449.75, "timestamp": "02:04:09", "text": "自分。ええと、生活していくためにはパートタイムの仕事が必要なんです"}, {"type": "subtitle", "time": 7452.95, "timestamp": "02:04:12", "text": "そこで生活費を払い、"}, {"type": "subtitle", "time": 7456.75, "timestamp": "02:04:16", "text": "食べ物も何もかも。ああ、それはいいですね。"}, {"type": "subtitle", "time": 7460.79, "timestamp": "02:04:20", "text": "ロバ、ロバ。えっと、ロバはいいと思う"}, {"type": "subtitle", "time": 7463.27, "timestamp": "02:04:23", "text": "パートタイムの場合、多くの場合"}, {"type": "subtitle", "time": 7465.189, "timestamp": "02:04:25", "text": "外国人はロバに乗ってやってくる。それで"}, {"type": "subtitle", "time": 7466.95, "timestamp": "02:04:26", "text": "時々英語を求められる"}, {"type": "subtitle", "time": 7471.03, "timestamp": "02:04:31", "text": "話す人々。うん。うん。だから一度でも"}, {"type": "subtitle", "time": 7473.109, "timestamp": "02:04:33", "text": "私は何かを買わなければならなかったのですが、"}, {"type": "subtitle", "time": 7474.709, "timestamp": "02:04:34", "text": "人々は理解していなかったし、私も理解していなかった"}, {"type": "subtitle", "time": 7476.87, "timestamp": "02:04:36", "text": "その単語を日本語で知っていますか？だから私は"}, {"type": "subtitle", "time": 7480.629, "timestamp": "02:04:40", "text": "誰でも英語を話せるかのように尋ねた"}, {"type": "subtitle", "time": 7483.189, "timestamp": "02:04:43", "text": "好きにならなければならず、それから彼らは持ってこなければならなかった"}, {"type": "subtitle", "time": 7485.99, "timestamp": "02:04:45", "text": "一人の人間と直接私と非常に"}, {"type": "subtitle", "time": 7489.75, "timestamp": "02:04:49", "text": "ああ、好きな人を見たよ"}, {"type": "subtitle", "time": 7492.79, "timestamp": "02:04:52", "text": "彼がインド語を話していたとき、その兄弟は"}, {"type": "subtitle", "time": 7495.109, "timestamp": "02:04:55", "text": "インド人OK"}, {"type": "subtitle", "time": 7497.75, "timestamp": "02:04:57", "text": "彼はやって来て、"}, {"type": "subtitle", "time": 7499.83, "timestamp": "02:04:59", "text": "私はヒンディー語で行ったのですが、彼は"}]
[{"type": "subtitle", "time": 14762.309, "timestamp": "04:06:02", "text": "カメラ。派手なものを見かけたら"}, {"type": "subtitle", "time": 14767.189, "timestamp": "04:06:07", "text": "カメラを横切る、それは"}, {"type": "subtitle", "time": 14769.99, "timestamp": "04:06:09", "text": "ああ、まるで塵の粒のように"}, {"type": "subtitle", "time": 14772.91, "timestamp": "04:06:12", "text": "その周り。あれが幽霊だ。"}, {"type": "subtitle", "time": 14776.95, "timestamp": "04:06:16", "text": "わかった。わかった。いいね、いいね、いいね、いいね、"}, {"type": "subtitle", "time": 14779.38, "timestamp": "04:06:19", "text": "いいね、いいね。"}, {"type": "subtitle", "time": 14780.79, "timestamp": "04:06:20", "text": "[拍手]"}, {"type": "subtitle", "time": 14782.95, "timestamp": "04:06:22", "text": "わかった。わかった。えっと、仕事、遊びに行きたいの？"}, {"type": "subtitle", "time": 14784.79, "timestamp": "04:06:24", "text": "ゲームをする？"}, {"type": "subtitle", "time": 14786.469, "timestamp": "04:06:26", "text": "うん。私たちはたくさん本を読んでいます。わかった。"}, {"type": "subtitle", "time": 14788.469, "timestamp": "04:06:28", "text": "わかった。うん。うん。うん。うん。さあ"}, {"type": "subtitle", "time": 14790.63, "timestamp": "04:06:30", "text": "ちょっと休憩して"}, {"type": "subtitle", "time": 14793.269, "timestamp": "04:06:33", "text": "そうすれば、私たちはもっと多くのことを学ぶことができるでしょう。ああ、私たちは"}, {"type": "subtitle", "time": 14800.87, "timestamp": "04:06:40", "text": "さあ行こう。"}, {"type": "subtitle", "time": 14802.87, "timestamp": "04:06:42", "text": "急いで始めましょう。私たちは"}, {"type": "subtitle", "time": 14804.389, "timestamp": "04:06:44", "text": "すべて、ですよね？手に入れました 私たちは買いました"}, {"type": "subtitle", "time": 14807.189, "timestamp": "04:06:47", "text": "すべて。私たちは貯蓄をしているだろうか？貯金しましょう。"}, {"type": "subtitle", "time": 14809.91, "timestamp": "04:06:49", "text": "よし、やってみよう。貯金しましょう。がある"}]
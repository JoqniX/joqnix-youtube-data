ssage": "two platinum alcoholics talking damnn..."}, {"type": "subtitle", "time": 6035.75, "timestamp": "01:40:35", "text": "しかし職場環境では誰かが"}, {"type": "subtitle", "time": 6038.47, "timestamp": "01:40:38", "text": "同伴する。だから私はあなたが好きではない"}, {"type": "subtitle", "time": 6041.59, "timestamp": "01:40:41", "text": "あなたは、何と言いますか、義務ではありません"}, {"type": "subtitle", "time": 6043.75, "timestamp": "01:40:43", "text": "同行したが、私だけだったので"}, {"type": "subtitle", "time": 6046.87, "timestamp": "01:40:46", "text": "酒を飲む人。だから、"}, {"type": "subtitle", "time": 6049.91, "timestamp": "01:40:49", "text": "飲酒は義務付けられなければならない。だから"}, {"type": "subtitle", "time": 6051.99, "timestamp": "01:40:51", "text": "サチョに付き添って、私は飲んでいました"}, {"type": "subtitle", "time": 6053.91, "timestamp": "01:40:53", "text": "そんな感じ。でも、もしあなたが"}, {"type": "subtitle", "time": 6056.47, "timestamp": "01:40:56", "text": "ビールを飲むつもりだ"}, {"type": "subtitle", "time": 6057.91, "timestamp": "01:40:57", "text": "非常に軽い。だから心配する必要はありません"}, {"type": "subtitle", "time": 6059.43, "timestamp": "01:40:59", "text": "酔いがすぐに回ることについて"}]
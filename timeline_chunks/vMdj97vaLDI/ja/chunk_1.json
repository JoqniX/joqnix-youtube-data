[{"type": "subtitle", "time": 61.99, "timestamp": "00:01:01", "text": "77. 今夜は特別なゲストをお迎えしています"}, {"type": "subtitle", "time": 63.789, "timestamp": "00:01:03", "text": "サイコニシャンは"}, {"type": "subtitle", "time": 66.59, "timestamp": "00:01:06", "text": "バッドスケープ。コラボレーションを行います"}, {"type": "subtitle", "time": 69.99, "timestamp": "00:01:09", "text": "40分以内、30分以内"}, {"type": "subtitle", "time": 74.23, "timestamp": "00:01:14", "text": "今。わかった。でも、その前に、"}, {"type": "subtitle", "time": 76.789, "timestamp": "00:01:16", "text": "コラボの件ですが、私は"}, {"type": "subtitle", "time": 80.63, "timestamp": "00:01:20", "text": "スピードランをして夕食を食べ、"}, {"type": "subtitle", "time": 83.03, "timestamp": "00:01:23", "text": "戻ってきます。わかった。では、少し時間をください"}, {"type": "subtitle", "time": 85.51, "timestamp": "00:01:25", "text": "瞬間が来たらスピードランして食べるよ"}, {"type": "subtitle", "time": 88.23, "timestamp": "00:01:28", "text": "そして戻ってきてください。わかった。こんにちは。だから、私を行かせてください"}, {"type": "subtitle", "time": 91.03, "timestamp": "00:01:31", "text": "夕食を食べて戻ってきてください。ええと、その頃には、"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "どうぞごゆっくりお楽しみください。こんにちは。楽しんでください"}]
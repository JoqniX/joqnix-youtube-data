[{"type": "subtitle", "time": 9360.19, "timestamp": "02:36:00", "text": "その？あの男は文字通り叫んでいる"}, {"type": "subtitle", "time": 9367.59, "timestamp": "02:36:07", "text": "神。叫ぼうとしない方がいいのは、"}, {"type": "subtitle", "time": 9370.67, "timestamp": "02:36:10", "text": "午後。起こしたくない"}, {"type": "subtitle", "time": 9374.15, "timestamp": "02:36:14", "text": "上。それと、ベックに何があったの？"}, {"type": "subtitle", "time": 9381.75, "timestamp": "02:36:21", "text": "そこには？かわいい雪だるまですね。いいえ、彼女は"}, {"type": "subtitle", "time": 9383.87, "timestamp": "02:36:23", "text": "見たくない"}, {"type": "subtitle", "time": 9386.389, "timestamp": "02:36:26", "text": "自分。私"}, {"type": "subtitle", "time": 9389.19, "timestamp": "02:36:29", "text": "君ならできる。"}, {"type": "subtitle", "time": 9391.19, "timestamp": "02:36:31", "text": "はい、同じコードをもう一度入力することはできません"}, {"type": "subtitle", "time": 9393.03, "timestamp": "02:36:33", "text": "だって私は"}, {"type": "subtitle", "time": 9395.99, "timestamp": "02:36:35", "text": "こんにちは。こんにちは。戻ってきました。何てことだ。"}, {"type": "subtitle", "time": 9398.15, "timestamp": "02:36:38", "text": "くそったれ。"}, {"type": "subtitle", "time": 9400.23, "timestamp": "02:36:40", "text": "また戻ってきます。"}, {"type": "subtitle", "time": 9402.15, "timestamp": "02:36:42", "text": "戻る。戻ってきました。私は生きている。私は生きている。"}, {"type": "subtitle", "time": 9411.83, "timestamp": "02:36:51", "text": "神。参加する。自分のサーバーに参加できますか？"}, {"type": "subtitle", "time": 9414.87, "timestamp": "02:36:54", "text": "はい。はい。うん。うん。うん。同じ"}]
[{"type": "subtitle", "time": 5041.11, "timestamp": "01:24:01", "text": "それは本当に良いことです。なぜなら、"}, {"type": "subtitle", "time": 5043.75, "timestamp": "01:24:03", "text": "そこの交通状況は本当に"}, {"type": "subtitle", "time": 5045.669, "timestamp": "01:24:05", "text": "めちゃくちゃ従順だ。わかった？たとえ"}, {"type": "subtitle", "time": 5048.07, "timestamp": "01:24:08", "text": "誰もいない、人々はまだ従う、まるで"}, {"type": "chat", "time": 5048.121, "timestamp": "01:24:08", "author": "@saikatdey0909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mT2Up10wsYYwilcayEwYxOCwTgzDSnNztFejTB-x02nR8=s64-c-k-c0x00ffffff-no-rj", "message": "HelloUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 5049.59, "timestamp": "01:24:09", "text": "車がないような人がいなければ"}, {"type": "subtitle", "time": 5053.629, "timestamp": "01:24:13", "text": "来るが、それでも彼らは従う"}, {"type": "subtitle", "time": 5055.91, "timestamp": "01:24:15", "text": "交通規則。だから、"}, {"type": "subtitle", "time": 5057.27, "timestamp": "01:24:17", "text": "何も心配するな。ただ、"}, {"type": "chat", "time": 5058.876, "timestamp": "01:24:18", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "the thing is, walking is okay when there's an actual sidewalk like in Japan 😆"}, {"type": "subtitle", "time": 5059.189, "timestamp": "01:24:19", "text": "交通ルールを自分で学び、"}, {"type": "subtitle", "time": 5061.11, "timestamp": "01:24:21", "text": "散策したいなら自転車がおすすめです。ただ"}, {"type": "subtitle", "time": 5063.27, "timestamp": "01:24:23", "text": "駐車するときは、"}, {"type": "subtitle", "time": 5064.95, "timestamp": "01:24:24", "text": "サイクル。駐車する場所には注意してください。"}, {"type": "subtitle", "time": 5066.79, "timestamp": "01:24:26", "text": "駐車場所を知っているように"}, {"type": "subtitle", "time": 5069.669, "timestamp": "01:24:29", "text": "時々、指差しのようなことをして、"}, {"type": "subtitle", "time": 5072.55, "timestamp": "01:24:32", "text": "雨季なので8月は"}, {"type": "subtitle", "time": 5074.99, "timestamp": "01:24:34", "text": "雨季。手に入れる"}, {"type": "subtitle", "time": 5077.35, "timestamp": "01:24:37", "text": "傘。しかし、あなたが続けるなら"}, {"type": "subtitle", "time": 5078.629, "timestamp": "01:24:38", "text": "傘を不注意に扱うと、"}, {"type": "subtitle", "time": 5082.229, "timestamp": "01:24:42", "text": "盗まれた。何てことだ。え、そういうことあるの？"}, {"type": "subtitle", "time": 5085.35, "timestamp": "01:24:45", "text": "盗まれる。盗まれる。えっと、それで"}, {"type": "subtitle", "time": 5087.03, "timestamp": "01:24:47", "text": "あなたのお金は盗まれません。わかった。あなたの"}, {"type": "subtitle", "time": 5088.95, "timestamp": "01:24:48", "text": "電話は盗まれない。もしあなたが"}, {"type": "subtitle", "time": 5090.87, "timestamp": "01:24:50", "text": "財布はどこかに置いておけば、盗まれることはないでしょう。"}, {"type": "subtitle", "time": 5092.95, "timestamp": "01:24:52", "text": "盗まれるのは"}, {"type": "subtitle", "time": 5096.629, "timestamp": "01:24:56", "text": "傘と下着。"}, {"type": "subtitle", "time": 5099.43, "timestamp": "01:24:59", "text": "何？そこが問題なんです。何？私は"}]
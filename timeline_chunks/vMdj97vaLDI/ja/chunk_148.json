[{"type": "subtitle", "time": 8883.309, "timestamp": "02:28:03", "text": "わかった。"}, {"type": "subtitle", "time": 8887.11, "timestamp": "02:28:07", "text": "マルチプレイヤー。私は"}, {"type": "subtitle", "time": 8889.67, "timestamp": "02:28:09", "text": "うん。こんにちは、ティガサ。こんにちは。うん。こんにちは"}, {"type": "subtitle", "time": 8893.469, "timestamp": "02:28:13", "text": "ティガサ。あなたに見覚えがあります。はい、そうしました。"}, {"type": "subtitle", "time": 8896.95, "timestamp": "02:28:16", "text": "非公開参加。カスタムアプリを作成できますか？"}, {"type": "subtitle", "time": 8899.87, "timestamp": "02:28:19", "text": "ロビーを作成します。どうでも。プライベート"}, {"type": "subtitle", "time": 8904.03, "timestamp": "02:28:24", "text": "最大2名まで"}, {"type": "subtitle", "time": 8907.429, "timestamp": "02:28:27", "text": "希望する言語。英語。はい。 1つ"}, {"type": "subtitle", "time": 8911.27, "timestamp": "02:28:31", "text": "秒ロビーを作成する必要があります。何か行動を起こしてください。"}, {"type": "subtitle", "time": 8914.389, "timestamp": "02:28:34", "text": "作成する。ロビーを作成します。わかった。えっと、忘れてた"}, {"type": "subtitle", "time": 8928.79, "timestamp": "02:28:48", "text": "わかった、切り替えるよ。 1秒。あなたは欲しい"}, {"type": "subtitle", "time": 8932.23, "timestamp": "02:28:52", "text": "ジャンプする？そうしたいんですね。うん。 1つ"}, {"type": "subtitle", "time": 8936.469, "timestamp": "02:28:56", "text": "秒あなたを招待する必要があるよね？"}, {"type": "subtitle", "time": 8939.51, "timestamp": "02:28:59", "text": "Steamを再度開くにはどうすればよいですか？"}]
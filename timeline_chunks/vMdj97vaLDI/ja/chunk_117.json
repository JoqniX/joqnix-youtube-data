[{"type": "subtitle", "time": 7022.709, "timestamp": "01:57:02", "text": "大阪へ行って、それから滞在できます"}, {"type": "subtitle", "time": 7025.189, "timestamp": "01:57:05", "text": "ドットリーとかそういうのに"}, {"type": "subtitle", "time": 7027.03, "timestamp": "01:57:07", "text": "安い。新幹線に乗るなら"}, {"type": "subtitle", "time": 7028.629, "timestamp": "01:57:08", "text": "7,000ルピーか何か払わなければならない"}, {"type": "subtitle", "time": 7030.55, "timestamp": "01:57:10", "text": "それはモードによって異なる"}, {"type": "subtitle", "time": 7032.07, "timestamp": "01:57:12", "text": "あなたが行っている輸送手段。だからもしあなたが"}, {"type": "chat", "time": 7032.637, "timestamp": "01:57:12", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "I will look gud tbh"}, {"type": "subtitle", "time": 7033.669, "timestamp": "01:57:13", "text": "もっと安く行きたいなら簡単に"}, {"type": "subtitle", "time": 7035.589, "timestamp": "01:57:15", "text": "夜行バスで到着します。"}, {"type": "subtitle", "time": 7038.31, "timestamp": "01:57:18", "text": "予算は5万ドルくらいです"}, {"type": "subtitle", "time": 7040.709, "timestamp": "01:57:20", "text": "または40,000なら簡単に歩き回れます"}, {"type": "subtitle", "time": 7042.55, "timestamp": "01:57:22", "text": "お土産のようなものはあまり買わない"}, {"type": "subtitle", "time": 7045.03, "timestamp": "01:57:25", "text": "などなど。うん。大人の男性が着用"}, {"type": "subtitle", "time": 7048.79, "timestamp": "01:57:28", "text": "着物。はい、調べてみます。"}, {"type": "subtitle", "time": 7051.189, "timestamp": "01:57:31", "text": "うん、まさにそんな感じ。だから私は"}, {"type": "subtitle", "time": 7053.27, "timestamp": "01:57:33", "text": "もし行くつもりなら、"}, {"type": "subtitle", "time": 7056.07, "timestamp": "01:57:36", "text": "私に知らせてください、私はアドバイスするのが好きなので"}, {"type": "chat", "time": 7057.475, "timestamp": "01:57:37", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "what about a samurai costume? freaking cool right"}, {"type": "subtitle", "time": 7059.51, "timestamp": "01:57:39", "text": "すごく安い、破格の安さ。それは"}, {"type": "subtitle", "time": 7061.43, "timestamp": "01:57:41", "text": "いや、私は自分の周りで成長するのが好きだ"}, {"type": "subtitle", "time": 7063.75, "timestamp": "01:57:43", "text": "場所。しかし、一部の人々は"}, {"type": "subtitle", "time": 7067.189, "timestamp": "01:57:47", "text": "節約よりも利便性を優先する。それで"}, {"type": "subtitle", "time": 7070.229, "timestamp": "01:57:50", "text": "彼らにとっては、インフルエンサーが何をしようと構わない"}, {"type": "subtitle", "time": 7073.03, "timestamp": "01:57:53", "text": "私の考えでは、"}, {"type": "subtitle", "time": 7075.75, "timestamp": "01:57:55", "text": "一部の人にとってはちょっとした不便"}, {"type": "subtitle", "time": 7077.669, "timestamp": "01:57:57", "text": "なぜなら、私は非常に順応性が高いからです。だから私は"}, {"type": "subtitle", "time": 7079.51, "timestamp": "01:57:59", "text": "不便を我慢してでも"}]
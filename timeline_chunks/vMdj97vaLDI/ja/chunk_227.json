[{"type": "subtitle", "time": 13625.11, "timestamp": "03:47:05", "text": "うん。わかった。お金を手に入れた。私たちは"}, {"type": "subtitle", "time": 13627.83, "timestamp": "03:47:07", "text": "ドル。うん。"}, {"type": "subtitle", "time": 13630.15, "timestamp": "03:47:10", "text": "ああ、もっと遊びたいの？うん。うん。"}, {"type": "subtitle", "time": 13633.189, "timestamp": "03:47:13", "text": "ちょっと読ませてください。すべて見せてください"}, {"type": "subtitle", "time": 13635.269, "timestamp": "03:47:15", "text": "幽霊は実際に私が理解できるように"}, {"type": "subtitle", "time": 13651.51, "timestamp": "03:47:31", "text": "それは実際には問題です"}, {"type": "subtitle", "time": 13654.229, "timestamp": "03:47:34", "text": "ファソフォビアは新しいもので、それほど多くはなかった"}, {"type": "subtitle", "time": 13656.55, "timestamp": "03:47:36", "text": "幽霊は今皆さんが見ているように"}, {"type": "subtitle", "time": 13659.99, "timestamp": "03:47:39", "text": "今は多すぎる、待って、彼らはそうしない"}, {"type": "subtitle", "time": 13662.51, "timestamp": "03:47:42", "text": "写真を表示する"}, {"type": "subtitle", "time": 13667.269, "timestamp": "03:47:47", "text": "幽霊、いや、いやいや、ところで、"}, {"type": "subtitle", "time": 13671.59, "timestamp": "03:47:51", "text": "ゴーストモデルだが、それらには名前がない"}, {"type": "subtitle", "time": 13672.389, "timestamp": "03:47:52", "text": "ああ"}, {"type": "subtitle", "time": 13674.07, "timestamp": "03:47:54", "text": "ランダムに選んで、"}, {"type": "subtitle", "time": 13677.03, "timestamp": "03:47:57", "text": "ランダムな女性、ランダムな男性"}, {"type": "subtitle", "time": 13678.75, "timestamp": "03:47:58", "text": "切り刻まれた顔または"}]
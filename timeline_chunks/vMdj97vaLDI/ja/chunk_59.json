[{"type": "subtitle", "time": 3540.71, "timestamp": "00:59:00", "text": "キャロットケーキはおいしい。えっと、私は"}, {"type": "subtitle", "time": 3543.91, "timestamp": "00:59:03", "text": "以前、家族の家で食べたのを覚えている。いいえ、"}, {"type": "subtitle", "time": 3546.309, "timestamp": "00:59:06", "text": "数回"}, {"type": "subtitle", "time": 3549.27, "timestamp": "00:59:09", "text": "行事などの際に。ええ、そうです"}, {"type": "subtitle", "time": 3551.109, "timestamp": "00:59:11", "text": "良い"}, {"type": "chat", "time": 3551.2, "timestamp": "00:59:11", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "u should try coconut cake"}, {"type": "chat", "time": 3554.124, "timestamp": "00:59:14", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "carrot cake is noice"}, {"type": "subtitle", "time": 3555.27, "timestamp": "00:59:15", "text": "なぜなら私は食べるからです"}, {"type": "subtitle", "time": 3557.19, "timestamp": "00:59:17", "text": "ガジャルワ？"}, {"type": "subtitle", "time": 3560.309, "timestamp": "00:59:20", "text": "ガジェル・カハラとは何ですか？えっと、野菜。"}, {"type": "subtitle", "time": 3569.51, "timestamp": "00:59:29", "text": "えっと、キャロットプリンみたいな感じ。ニンジン"}, {"type": "subtitle", "time": 3573.349, "timestamp": "00:59:33", "text": "プリン。ああ、キャロットプリン。私は思う"}, {"type": "subtitle", "time": 3576.15, "timestamp": "00:59:36", "text": "すぐに手に入れた。私はそれが大嫌いだ。"}, {"type": "subtitle", "time": 3578.15, "timestamp": "00:59:38", "text": "私はそれが気に入りません。私は泣くでしょう"}, {"type": "subtitle", "time": 3579.99, "timestamp": "00:59:39", "text": "もし誰かがそれを私の"}, {"type": "subtitle", "time": 3587.19, "timestamp": "00:59:47", "text": "ああ、なんてことだ、"}, {"type": "subtitle", "time": 3589.47, "timestamp": "00:59:49", "text": "最悪だ"}, {"type": "subtitle", "time": 3591.789, "timestamp": "00:59:51", "text": "悪い。それは それは"}, {"type": "subtitle", "time": 3594.87, "timestamp": "00:59:54", "text": "物議を醸す残念な意見。しかしもし"}, {"type": "subtitle", "time": 3597.19, "timestamp": "00:59:57", "text": "誰かがこれを聞いて、誰かがこれを聞いて、"}, {"type": "subtitle", "time": 3599.47, "timestamp": "00:59:59", "text": "私は叱られるだろう。しかし"}]
[{"type": "subtitle", "time": 10920.91, "timestamp": "03:02:00", "text": "どこ？明らかなフィルターオーディオフィルター。"}, {"type": "subtitle", "time": 10924.63, "timestamp": "03:02:04", "text": "それは何ですか？これは何ですか？追加する"}, {"type": "subtitle", "time": 10927.99, "timestamp": "03:02:07", "text": "うん、フィルターだね。ゲインと増加を追加"}, {"type": "subtitle", "time": 10930.55, "timestamp": "03:02:10", "text": "ゲインを2くらいにするか"}, {"type": "subtitle", "time": 10933.75, "timestamp": "03:02:13", "text": "何か。あ、待って。私がすべき時に"}, {"type": "subtitle", "time": 10936.309, "timestamp": "03:02:16", "text": "これをするために？私の趣味？それともあなたの趣味？"}, {"type": "subtitle", "time": 10939.19, "timestamp": "03:02:19", "text": "えっと、あなたのものの中に？マイクで。あなたのマイク、"}, {"type": "subtitle", "time": 10941.87, "timestamp": "03:02:21", "text": "私のものではありません。"}, {"type": "subtitle", "time": 10947.429, "timestamp": "03:02:27", "text": "わかった。得。わかった。 2ポイント獲得。あなた"}, {"type": "subtitle", "time": 10950.75, "timestamp": "03:02:30", "text": "2つ頼みたい？"}, {"type": "subtitle", "time": 10953.269, "timestamp": "03:02:33", "text": "うん。 2つか3つでうまくいく"}, {"type": "subtitle", "time": 10954.87, "timestamp": "03:02:34", "text": "君の声は、ちょっと聞き取りやすいね。"}, {"type": "subtitle", "time": 10957.75, "timestamp": "03:02:37", "text": "オーディオブックっぽい。"}, {"type": "subtitle", "time": 10961.469, "timestamp": "03:02:41", "text": "ニース。わかった。私は優秀ですか？"}, {"type": "subtitle", "time": 10964.79, "timestamp": "03:02:44", "text": "わかった。お願いします。ありがとう。これは良いですか？"}, {"type": "subtitle", "time": 10967.95, "timestamp": "03:02:47", "text": "今？これでいいですか？私は"}, {"type": "subtitle", "time": 10977.59, "timestamp": "03:02:57", "text": "あ、待って。ストリームを入れるのを忘れています"}]
[{"type": "subtitle", "time": 13083.429, "timestamp": "03:38:03", "text": "三つ星の写真を撮ろう。おお、"}, {"type": "subtitle", "time": 13086.15, "timestamp": "03:38:06", "text": "星3つ。私は今レベル5です。わーい。"}, {"type": "subtitle", "time": 13089.83, "timestamp": "03:38:09", "text": "さあ行こう。私は愛する"}, {"type": "subtitle", "time": 13092.07, "timestamp": "03:38:12", "text": "悪夢を描きたいんだね。"}, {"type": "subtitle", "time": 13094.71, "timestamp": "03:38:14", "text": "悪夢って何だっけ？"}, {"type": "subtitle", "time": 13097.269, "timestamp": "03:38:17", "text": "それは、それは、それは、それは、それは、それは、"}, {"type": "subtitle", "time": 13100.15, "timestamp": "03:38:20", "text": "ちなみに、プロというよりは。ああ、"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "私たちはすぐに死ぬだろう。心配しないで、"}, {"type": "subtitle", "time": 13115.11, "timestamp": "03:38:35", "text": "わかった。えーと、もう1本ろうそくが必要で、"}, {"type": "subtitle", "time": 13117.67, "timestamp": "03:38:37", "text": "ライターが必要だ。誰が買うのか"}, {"type": "subtitle", "time": 13120.469, "timestamp": "03:38:40", "text": "わかりました、ライターを買って"}, {"type": "subtitle", "time": 13123.03, "timestamp": "03:38:43", "text": "私はキャンドルを買います。なぜならこれは"}, {"type": "subtitle", "time": 13126.87, "timestamp": "03:38:46", "text": "行くたびにイライラする"}, {"type": "subtitle", "time": 13128.91, "timestamp": "03:38:48", "text": "まるで"}, {"type": "subtitle", "time": 13132.389, "timestamp": "03:38:52", "text": "バカめ、そんなことは全部忘れろ。はい、そうします"}, {"type": "subtitle", "time": 13135.349, "timestamp": "03:38:55", "text": "ろうそくを追加すれば、ライトアップも追加します。"}, {"type": "subtitle", "time": 13137.99, "timestamp": "03:38:57", "text": "追加：悪夢を見たいの？我々はできる"}]
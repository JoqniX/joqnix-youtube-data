[{"type": "subtitle", "time": 13860.63, "timestamp": "03:51:00", "text": "わかった。待って。ここは広い場所だ。おお。"}, {"type": "subtitle", "time": 13863.75, "timestamp": "03:51:03", "text": "ああ、これはランダムに選ぶときです。"}, {"type": "subtitle", "time": 13865.67, "timestamp": "03:51:05", "text": "まだ見たことのない地図へ連れて行ってくれます"}, {"type": "subtitle", "time": 13868.389, "timestamp": "03:51:08", "text": "であった。あ、待って。私は受け取らなかった"}, {"type": "subtitle", "time": 13870.55, "timestamp": "03:51:10", "text": "何でも。待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 13872.349, "timestamp": "03:51:12", "text": "何か拝借させてください。待って、待って、待って、"}, {"type": "subtitle", "time": 13879.83, "timestamp": "03:51:19", "text": "これ。わかった。その本を持っていくべきでしょうか？"}, {"type": "subtitle", "time": 13881.389, "timestamp": "03:51:21", "text": "うん、君は"}, {"type": "subtitle", "time": 13884.55, "timestamp": "03:51:24", "text": "本。 Sh。"}, {"type": "subtitle", "time": 13887.91, "timestamp": "03:51:27", "text": "ああ、どうぞ。私は、好きが増えたことが嬉しいです"}, {"type": "subtitle", "time": 13892.15, "timestamp": "03:51:32", "text": "私の明るさを少しだけ。まるで私が"}, {"type": "subtitle", "time": 13895.03, "timestamp": "03:51:35", "text": "文字通り、だから今は代わりに見ることができる"}, {"type": "subtitle", "time": 13898.309, "timestamp": "03:51:38", "text": "ほら、言った通りでしょ？"}, {"type": "subtitle", "time": 13900.71, "timestamp": "03:51:40", "text": "ほら、言った通りだろ、兄弟？それでも"}, {"type": "subtitle", "time": 13902.189, "timestamp": "03:51:42", "text": "これは"}, {"type": "subtitle", "time": 13904.55, "timestamp": "03:51:44", "text": "不正行為。大丈夫。だって私にはできないから"}, {"type": "subtitle", "time": 13906.83, "timestamp": "03:51:46", "text": "もうゲームはやらない。"}, {"type": "subtitle", "time": 13909.67, "timestamp": "03:51:49", "text": "実際、これはああ、なんてことだ。見た目"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "まるで城のようだ。"}, {"type": "subtitle", "time": 13915.83, "timestamp": "03:51:55", "text": "うん。さよなら。ああ、こんにちは。"}, {"type": "subtitle", "time": 13919.11, "timestamp": "03:51:59", "text": "これは本当に不気味だ。何？"}]
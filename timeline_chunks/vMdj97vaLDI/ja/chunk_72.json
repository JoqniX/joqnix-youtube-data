[{"type": "subtitle", "time": 4321.75, "timestamp": "01:12:01", "text": "私は独学で勉強するつもりです。いいえ、"}, {"type": "subtitle", "time": 4323.31, "timestamp": "01:12:03", "text": "あなたはそれさえも必要としません"}, {"type": "subtitle", "time": 4326.95, "timestamp": "01:12:06", "text": "話す。そして、友達も作りましょう。作らない"}, {"type": "subtitle", "time": 4328.51, "timestamp": "01:12:08", "text": "感覚だが"}, {"type": "subtitle", "time": 4330.95, "timestamp": "01:12:10", "text": "例えば、あなたが失くしたことがあるか、"}, {"type": "subtitle", "time": 4334.07, "timestamp": "01:12:14", "text": "何か、だってわからないから"}, {"type": "subtitle", "time": 4336.229, "timestamp": "01:12:16", "text": "とても小さな場所から来たので、"}, {"type": "chat", "time": 4336.612, "timestamp": "01:12:16", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "y am i getting to know all the fun degrees when i just came out of college"}, {"type": "subtitle", "time": 4339.83, "timestamp": "01:12:19", "text": "今でもこの場所で迷子になる"}, {"type": "subtitle", "time": 4341.75, "timestamp": "01:12:21", "text": "ここムンバイでは、私は"}, {"type": "subtitle", "time": 4343.51, "timestamp": "01:12:23", "text": "ここに2年住んでいるけど、まだ道に迷う"}, {"type": "subtitle", "time": 4346.55, "timestamp": "01:12:26", "text": "ここで、でももしあなたが迷子になったら"}, {"type": "subtitle", "time": 4348.229, "timestamp": "01:12:28", "text": "ご存知の通り、インドの人々はとても"}, {"type": "subtitle", "time": 4350.95, "timestamp": "01:12:30", "text": "権威者のように近づくのが怖い"}, {"type": "subtitle", "time": 4354.709, "timestamp": "01:12:34", "text": "警察とかそういうの、ほら、俺たち"}, {"type": "subtitle", "time": 4356.31, "timestamp": "01:12:36", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 4358.79, "timestamp": "01:12:38", "text": "怖くて近づけない。決して"}, {"type": "subtitle", "time": 4361.51, "timestamp": "01:12:41", "text": "彼らに近づくのが怖かった。わかった？私は持っている"}, {"type": "subtitle", "time": 4362.95, "timestamp": "01:12:42", "text": "それを学びました。決して恐れないでください"}, {"type": "subtitle", "time": 4364.87, "timestamp": "01:12:44", "text": "彼らに近づく。ただ彼らに近づいてみてください。ただ"}, {"type": "subtitle", "time": 4366.79, "timestamp": "01:12:46", "text": "彼らと話してください。もしあなたが"}, {"type": "subtitle", "time": 4369.27, "timestamp": "01:12:49", "text": "もしあなたが迷子なら、私は"}, {"type": "subtitle", "time": 4371.35, "timestamp": "01:12:51", "text": "何度も負けた。ただ彼らに近づいてみてください。"}, {"type": "subtitle", "time": 4373.59, "timestamp": "01:12:53", "text": "やり方がわかったら、"}, {"type": "subtitle", "time": 4375.03, "timestamp": "01:12:55", "text": "日本語を話すには、"}, {"type": "subtitle", "time": 4377.27, "timestamp": "01:12:57", "text": "片言の日本語で、それからただ近づく"}, {"type": "subtitle", "time": 4379.11, "timestamp": "01:12:59", "text": "そして彼らはあなたを助けてくれるでしょう。心配しないで"}]
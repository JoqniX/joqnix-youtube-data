[{"type": "subtitle", "time": 5883.35, "timestamp": "01:38:03", "text": "ここにもう2人同僚がいるようなものだ。それで"}, {"type": "subtitle", "time": 5885.59, "timestamp": "01:38:05", "text": "私たち３人は上司に会わなければならなかった。だから私たちは"}, {"type": "subtitle", "time": 5887.51, "timestamp": "01:38:07", "text": "会議の後、会社の夕食会がありました。"}, {"type": "subtitle", "time": 5889.75, "timestamp": "01:38:09", "text": "そして彼は私の目の前にいて"}, {"type": "subtitle", "time": 5891.43, "timestamp": "01:38:11", "text": "すると私は彼とは正反対の立場になった。それで"}, {"type": "subtitle", "time": 5893.83, "timestamp": "01:38:13", "text": "実は、飲んでいたのは私だけだったんです。"}, {"type": "subtitle", "time": 5896.07, "timestamp": "01:38:16", "text": "わかった。あの二人は酒を飲んでいなかった。だから私は"}, {"type": "subtitle", "time": 5898.27, "timestamp": "01:38:18", "text": "しなければならないのは"}, {"type": "subtitle", "time": 5901.75, "timestamp": "01:38:21", "text": "会社のボスはサチョのような感じ。"}, {"type": "subtitle", "time": 5904.229, "timestamp": "01:38:24", "text": "サチョと付き合わなければならない。だから私は"}, {"type": "subtitle", "time": 5906.229, "timestamp": "01:38:26", "text": "彼が飲み物を飲み終えるたびに"}, {"type": "subtitle", "time": 5909.35, "timestamp": "01:38:29", "text": "そして私は自分のものを終える、彼はあなたが望むようにする"}, {"type": "subtitle", "time": 5911.51, "timestamp": "01:38:31", "text": "もっと、そしてもっと手に入れよう。そして私は"}, {"type": "subtitle", "time": 5913.27, "timestamp": "01:38:33", "text": "まあ、いいんじゃない。そして私は同じものを取ります"}, {"type": "subtitle", "time": 5915.109, "timestamp": "01:38:35", "text": "彼のような量。だから私は"}, {"type": "subtitle", "time": 5918.47, "timestamp": "01:38:38", "text": "ビール5本分くらい飲んだかな。"}, {"type": "subtitle", "time": 5921.79, "timestamp": "01:38:41", "text": "何てことだ。そして私は"}, {"type": "subtitle", "time": 5925.27, "timestamp": "01:38:45", "text": "ワインを飲みに行くのが好きで、"}, {"type": "subtitle", "time": 5927.27, "timestamp": "01:38:47", "text": "問題は誰かが同行しなければならないということだ。"}, {"type": "subtitle", "time": 5929.03, "timestamp": "01:38:49", "text": "飲んでいたのは彼だけだった。だから私は"}, {"type": "subtitle", "time": 5931.95, "timestamp": "01:38:51", "text": "彼はワインのようで、私は"}, {"type": "subtitle", "time": 5934.229, "timestamp": "01:38:54", "text": "そして彼はそれを注ぎ始めた。私"}, {"type": "subtitle", "time": 5936.55, "timestamp": "01:38:56", "text": "よし、彼に注がせておこう"}, {"type": "subtitle", "time": 5939.27, "timestamp": "01:38:59", "text": "これくらいで、それからゆっくりと"}]
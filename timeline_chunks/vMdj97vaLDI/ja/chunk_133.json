[{"type": "subtitle", "time": 7981.75, "timestamp": "02:13:01", "text": "スキナと一緒にいるでしょう。えーと、スキナと"}, {"type": "subtitle", "time": 7984.229, "timestamp": "02:13:04", "text": "そしてGSGと共に。私たちはただ話をするだけです"}, {"type": "subtitle", "time": 7986.069, "timestamp": "02:13:06", "text": "そしてぶらぶらして、ランダムなゲームをする"}, {"type": "subtitle", "time": 7988.39, "timestamp": "02:13:08", "text": "ゲームとかそういうもの。うん。うん。うん。私"}, {"type": "chat", "time": 7989.382, "timestamp": "02:13:09", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "do you ever do horror games?"}, {"type": "subtitle", "time": 7990.79, "timestamp": "02:13:10", "text": "書き留めておかなければならない。私は、えっと"}, {"type": "subtitle", "time": 7994.069, "timestamp": "02:13:14", "text": "今すぐそれをやってみて。うん。私は"}, {"type": "chat", "time": 7995.547, "timestamp": "02:13:15", "author": "@astravt", "avatar": "https://yt4.ggpht.com/MdOwC7qdh0gmlabcCYgLQ5BOZxo7CGLbc14xFv1rO9eQ745gkga99YKsszwMjcyNnEBittX8WA=s64-c-k-c0x00ffffff-no-rj", "message": "dayo dao dayo"}, {"type": "subtitle", "time": 7995.91, "timestamp": "02:13:15", "text": "ジョー、寂しくなるよ。寂しくなるだろう"}, {"type": "subtitle", "time": 7998.79, "timestamp": "02:13:18", "text": "みんなそうだけどね。私は別の場所にいます"}, {"type": "subtitle", "time": 8001.589, "timestamp": "02:13:21", "text": "全く異なるタイムゾーンです。みんな"}, {"type": "subtitle", "time": 8005.589, "timestamp": "02:13:25", "text": "一緒にぶらぶらして、"}, {"type": "subtitle", "time": 8008.229, "timestamp": "02:13:28", "text": "午前10時から午後10時まで楽しんでいます。その間"}, {"type": "subtitle", "time": 8011.43, "timestamp": "02:13:31", "text": "私は文字通りベッドにいて、"}, {"type": "subtitle", "time": 8014.03, "timestamp": "02:13:34", "text": "私にとって早朝"}, {"type": "subtitle", "time": 8017.91, "timestamp": "02:13:37", "text": "日本ですよね？うん。例えば"}, {"type": "subtitle", "time": 8021.589, "timestamp": "02:13:41", "text": "午後6時30分インドでは午後10時に相当する。"}, {"type": "subtitle", "time": 8024.87, "timestamp": "02:13:44", "text": "日本で。つまり、3つあるということです"}, {"type": "subtitle", "time": 8028.149, "timestamp": "02:13:48", "text": "時差1時間。つまり3時間30分"}, {"type": "subtitle", "time": 8031.189, "timestamp": "02:13:51", "text": "もし私の理解が正しければ、違いはあります。こんにちは、アストラ。"}, {"type": "subtitle", "time": 8032.589, "timestamp": "02:13:52", "text": "惜しかった"}, {"type": "subtitle", "time": 8034.57, "timestamp": "02:13:54", "text": "サイコソ W."}, {"type": "subtitle", "time": 8039.39, "timestamp": "02:13:59", "text": "[音楽]"}]
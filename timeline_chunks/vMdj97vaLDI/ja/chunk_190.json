[{"type": "subtitle", "time": 11402.269, "timestamp": "03:10:02", "text": "証拠。それは"}, {"type": "subtitle", "time": 11406.07, "timestamp": "03:10:06", "text": "悪魔を退治する。それはアリのように見えた。私"}, {"type": "subtitle", "time": 11407.83, "timestamp": "03:10:07", "text": "わからない。それは今もなお、"}, {"type": "subtitle", "time": 11416.389, "timestamp": "03:10:16", "text": "私は死んでしまっているはずだ。うん。うん。私は"}, {"type": "subtitle", "time": 11419.11, "timestamp": "03:10:19", "text": "外。たくさん。それで"}, {"type": "subtitle", "time": 11421.389, "timestamp": "03:10:21", "text": "私はしません"}, {"type": "subtitle", "time": 11425.11, "timestamp": "03:10:25", "text": "知る。ああ、くそ。それは本当に"}, {"type": "subtitle", "time": 11426.79, "timestamp": "03:10:26", "text": "実際、インスタグラムで殺されたけど、"}, {"type": "subtitle", "time": 11428.469, "timestamp": "03:10:28", "text": "知る。狩猟は行けると思います"}, {"type": "subtitle", "time": 11432.469, "timestamp": "03:10:32", "text": "ちなみに。本当にそう思いますか？"}, {"type": "subtitle", "time": 11433.99, "timestamp": "03:10:33", "text": "うん。うん、大丈夫だよ。その"}, {"type": "subtitle", "time": 11435.83, "timestamp": "03:10:35", "text": "わかった。入ってもいいですよ。それで、あなたはどこに"}, {"type": "subtitle", "time": 11439.51, "timestamp": "03:10:39", "text": "死ぬの？ええ、まさにここにありますよ。"}, {"type": "subtitle", "time": 11442.63, "timestamp": "03:10:42", "text": "友達みたいに。ああ、君のことは分かっているよ。うん、"}, {"type": "subtitle", "time": 11450.15, "timestamp": "03:10:50", "text": "心配しないで、あなたは安全です。続けて。何"}, {"type": "subtitle", "time": 11451.51, "timestamp": "03:10:51", "text": "どうすればいいでしょうか？つまり、私はそうするべきではない"}, {"type": "subtitle", "time": 11457.67, "timestamp": "03:10:57", "text": "に。何？何？何？私はどうすればいいの？"}]
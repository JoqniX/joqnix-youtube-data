[{"type": "subtitle", "time": 14460.469, "timestamp": "04:01:00", "text": "ウィジャ盤から呼び出された。立ち止まって見る"}, {"type": "subtitle", "time": 14462.55, "timestamp": "04:01:02", "text": "幻影はあなたの正気を低下させるでしょう"}, {"type": "subtitle", "time": 14465.349, "timestamp": "04:01:05", "text": "かなり速い。弱点。を"}, {"type": "subtitle", "time": 14467.55, "timestamp": "04:01:07", "text": "Verの写真が一時的に消えた。"}, {"type": "subtitle", "time": 14470.71, "timestamp": "04:01:10", "text": "おお。わかった。私たちはどのように考える必要があるか"}, {"type": "subtitle", "time": 14472.71, "timestamp": "04:01:12", "text": "これらすべての作品。だから、私にはわからない。"}, {"type": "subtitle", "time": 14475.83, "timestamp": "04:01:15", "text": "わかった。これは最も安全な幽霊です"}, {"type": "subtitle", "time": 14478.389, "timestamp": "04:01:18", "text": "ちなみに、持つことができます。ファントム。これは"}, {"type": "subtitle", "time": 14480.71, "timestamp": "04:01:20", "text": "ファン。いや、いや、いや。のように"}, {"type": "subtitle", "time": 14482.79, "timestamp": "04:01:22", "text": "ポルターガイストは、"}, {"type": "subtitle", "time": 14485.55, "timestamp": "04:01:25", "text": "金庫。彼らはあなたを殺したりはしないでしょう。彼らは"}, {"type": "subtitle", "time": 14488.469, "timestamp": "04:01:28", "text": "無害です。だから、私はそうは思わない"}, {"type": "subtitle", "time": 14490.469, "timestamp": "04:01:30", "text": "彼らはあなたを殺すことができると思いますが、私は"}, {"type": "subtitle", "time": 14492.07, "timestamp": "04:01:32", "text": "わからない。それらは最も有害なもののようなものだ。"}, {"type": "subtitle", "time": 14493.51, "timestamp": "04:01:33", "text": "彼らは、あなたが想像できる最も安全な幽霊のようなものです"}, {"type": "subtitle", "time": 14497.349, "timestamp": "04:01:37", "text": "持っている。では、見てみましょう。えーと、最も"}, {"type": "subtitle", "time": 14499.429, "timestamp": "04:01:39", "text": "有名な幽霊、ポルターガイストとして知られる"}, {"type": "subtitle", "time": 14501.67, "timestamp": "04:01:41", "text": "周囲の物体を操作して広げる"}, {"type": "subtitle", "time": 14503.99, "timestamp": "04:01:43", "text": "恐怖を犠牲者の力に変える。の"}, {"type": "subtitle", "time": 14506.79, "timestamp": "04:01:46", "text": "ポルターガイストは複数の投げを投げることができます"}, {"type": "subtitle", "time": 14508.71, "timestamp": "04:01:48", "text": "複数のオブジェクトを優れた1つとして"}, {"type": "subtitle", "time": 14512.55, "timestamp": "04:01:52", "text": "力。チーズの弱さは何もありません"}, {"type": "subtitle", "time": 14519.429, "timestamp": "04:01:59", "text": "無力だ。とにかく、スピリットボックス、スピリット"}]
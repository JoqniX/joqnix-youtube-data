[{"type": "subtitle", "time": 11246.23, "timestamp": "03:07:26", "text": "それも明らかだ。"}, {"type": "subtitle", "time": 11248.67, "timestamp": "03:07:28", "text": "わかった。わかった。それを"}, {"type": "subtitle", "time": 11251.59, "timestamp": "03:07:31", "text": "寝室。カメラを置くだけです"}, {"type": "subtitle", "time": 11253.91, "timestamp": "03:07:33", "text": "寝室に降りて、"}, {"type": "subtitle", "time": 11256.309, "timestamp": "03:07:36", "text": "最高。そしてこれが寝室です"}, {"type": "subtitle", "time": 11259.269, "timestamp": "03:07:39", "text": "人里離れた。だから、私はこう確信している"}, {"type": "subtitle", "time": 11263.349, "timestamp": "03:07:43", "text": "この場所は"}, {"type": "subtitle", "time": 11266.309, "timestamp": "03:07:46", "text": "ああ、お皿が落ちたんだ。皿"}, {"type": "subtitle", "time": 11268.07, "timestamp": "03:07:48", "text": "倒れた。お皿が落ちた。わかった。"}, {"type": "subtitle", "time": 11269.91, "timestamp": "03:07:49", "text": "皿が落ちた。それは、それは"}, {"type": "subtitle", "time": 11271.99, "timestamp": "03:07:51", "text": "不吉。顎、出てこい。出てくる。来る"}, {"type": "subtitle", "time": 11274.55, "timestamp": "03:07:54", "text": "外。出てくる。外に1人。外。"}, {"type": "subtitle", "time": 11276.71, "timestamp": "03:07:56", "text": "外。外。いや、いや。えっと、私は"}]
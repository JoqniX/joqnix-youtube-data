[{"type": "subtitle", "time": 12421.269, "timestamp": "03:27:01", "text": "それは使節団です。"}, {"type": "subtitle", "time": 12423.59, "timestamp": "03:27:03", "text": "私は一般的に混乱している"}, {"type": "subtitle", "time": 12426.87, "timestamp": "03:27:06", "text": "使節団。私たちは外にいます。"}, {"type": "subtitle", "time": 12435.51, "timestamp": "03:27:15", "text": "悪魔が現れるだろう。あ、そういえば、"}, {"type": "subtitle", "time": 12437.75, "timestamp": "03:27:17", "text": "その幽霊は外にも出没するだろう。それで、"}, {"type": "subtitle", "time": 12440.63, "timestamp": "03:27:20", "text": "「ここは安全ですか？」なんて言わないでください。いいえ、"}, {"type": "subtitle", "time": 12443.03, "timestamp": "03:27:23", "text": "いや、いや。そこは安全ではない。良い、"}, {"type": "subtitle", "time": 12445.83, "timestamp": "03:27:25", "text": "それについて。そこは安全ではない。ただ"}, {"type": "subtitle", "time": 12449.99, "timestamp": "03:27:29", "text": "怖がらせないで"}, {"type": "subtitle", "time": 12451.75, "timestamp": "03:27:31", "text": "うんち。ビームを"}, {"type": "subtitle", "time": 12453.95, "timestamp": "03:27:33", "text": "私の人生の光、もう一度ください。感謝"}, {"type": "subtitle", "time": 12457.79, "timestamp": "03:27:37", "text": "あなた。ああ、誰かが"}, {"type": "subtitle", "time": 12460.429, "timestamp": "03:27:40", "text": "開ける。誰がそんなことをするだろうか"}, {"type": "subtitle", "time": 12470.87, "timestamp": "03:27:50", "text": "ハンマー。わかった。どうですか？"}, {"type": "subtitle", "time": 12473.11, "timestamp": "03:27:53", "text": "あ、待って。光が好きですか？"}, {"type": "subtitle", "time": 12474.349, "timestamp": "03:27:54", "text": "の"}, {"type": "subtitle", "time": 12477.349, "timestamp": "03:27:57", "text": "もの？それを点灯できますか？"}, {"type": "subtitle", "time": 12478.87, "timestamp": "03:27:58", "text": "いいえ。"}]
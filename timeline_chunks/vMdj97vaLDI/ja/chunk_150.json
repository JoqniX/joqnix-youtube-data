[{"type": "subtitle", "time": 9004.79, "timestamp": "02:30:04", "text": "えっと、どうやってお互いを追加すればいいですか？"}, {"type": "subtitle", "time": 9006.469, "timestamp": "02:30:06", "text": "実は？わかった。わかった。わかった。さあ、さあ"}, {"type": "subtitle", "time": 9008.309, "timestamp": "02:30:08", "text": "見る。それでは、見てみましょう。解決策を見つけよう"}, {"type": "subtitle", "time": 9010.83, "timestamp": "02:30:10", "text": "外。これは結構です。"}, {"type": "subtitle", "time": 9015.27, "timestamp": "02:30:15", "text": "えっと、マルチプレイヤー。ロビーを作成します。プライベート。"}, {"type": "subtitle", "time": 9018.389, "timestamp": "02:30:18", "text": "これはプライベートなものです。うん。ええ、そうですね。"}, {"type": "subtitle", "time": 9021.63, "timestamp": "02:30:21", "text": "希望する言語も。作成する"}, {"type": "subtitle", "time": 9024.309, "timestamp": "02:30:24", "text": "ロビー。このゲームはまだ少し運が良かった。"}, {"type": "subtitle", "time": 9025.99, "timestamp": "02:30:25", "text": "だから、私にはわからない。"}, {"type": "subtitle", "time": 9029.83, "timestamp": "02:30:29", "text": "わかった。招待コード。招待コード。おお、"}, {"type": "subtitle", "time": 9031.19, "timestamp": "02:30:31", "text": "うん。うん。うん。招待すると言って"}, {"type": "subtitle", "time": 9032.63, "timestamp": "02:30:32", "text": "コード。忘れた。忘れた。うん。うん。"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "うん。そういうことなんです。わかった。あなた"}, {"type": "subtitle", "time": 9039.389, "timestamp": "02:30:39", "text": "ロビーに参加してください。招待コードは"}, {"type": "subtitle", "time": 9043.71, "timestamp": "02:30:43", "text": "えーと90 52"}, {"type": "subtitle", "time": 9046.469, "timestamp": "02:30:46", "text": "そして他のハンターのリスト"}, {"type": "subtitle", "time": 9048.469, "timestamp": "02:30:48", "text": "ヘルプ。送ってください。了解です。あのね？"}, {"type": "subtitle", "time": 9050.95, "timestamp": "02:30:50", "text": "わかった。わかった。うん。人々は"}, {"type": "subtitle", "time": 9055.19, "timestamp": "02:30:55", "text": "まるで流れに勢いよく飛び込むようなものだ。"}, {"type": "subtitle", "time": 9058.469, "timestamp": "02:30:58", "text": "そして、まさにその通り。私はそうは思わない"}]
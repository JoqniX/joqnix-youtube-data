[{"type": "subtitle", "time": 10443.19, "timestamp": "02:54:03", "text": "フルスタックとか？"}, {"type": "subtitle", "time": 10445.75, "timestamp": "02:54:05", "text": "それはフルスタックですね。 W 満員です。は"}, {"type": "subtitle", "time": 10449.51, "timestamp": "02:54:09", "text": "本当にプロ並みの実力ですか？"}, {"type": "subtitle", "time": 10451.99, "timestamp": "02:54:11", "text": "フルスタックでやってみよう。私は何も持っていません"}, {"type": "subtitle", "time": 10453.59, "timestamp": "02:54:13", "text": "ところで。だから、私にはわからない。何が"}, {"type": "subtitle", "time": 10455.75, "timestamp": "02:54:15", "text": "あなたが心配していることは何ですか？"}, {"type": "subtitle", "time": 10458.309, "timestamp": "02:54:18", "text": "私は全てを失ってしまった。わかりました、少なくとも"}, {"type": "subtitle", "time": 10462.15, "timestamp": "02:54:22", "text": "懐中電灯が必要です。ああ、神様。私"}, {"type": "subtitle", "time": 10464.71, "timestamp": "02:54:24", "text": "懐中電灯が必要だ。くそ。"}, {"type": "subtitle", "time": 10466.309, "timestamp": "02:54:26", "text": "買えますか？買えますか？"}, {"type": "subtitle", "time": 10467.91, "timestamp": "02:54:27", "text": "温度計？"}, {"type": "subtitle", "time": 10470.389, "timestamp": "02:54:30", "text": "スマートスティックが必要だ。"}, {"type": "subtitle", "time": 10473.91, "timestamp": "02:54:33", "text": "ああ、わかった。必要なのは、"}, {"type": "subtitle", "time": 10478.309, "timestamp": "02:54:38", "text": "これはカメラであり、EMFリーダーです。えっと、"}, {"type": "subtitle", "time": 10482.75, "timestamp": "02:54:42", "text": "スピリットボックス。私は持っています 私は持っています 私は持っています"}, {"type": "subtitle", "time": 10492.95, "timestamp": "02:54:52", "text": "唾を吐くための箱。"}, {"type": "subtitle", "time": 10496.15, "timestamp": "02:54:56", "text": "唾吐き箱。"}, {"type": "subtitle", "time": 10499.19, "timestamp": "02:54:59", "text": "待って、それは何、それは何、えーと物"}]
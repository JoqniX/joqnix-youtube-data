[{"type": "subtitle", "time": 13441.11, "timestamp": "03:44:01", "text": "すべてが青色ですか？"}, {"type": "subtitle", "time": 13452.63, "timestamp": "03:44:12", "text": "わかった。"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "ああ、トイレ。トイレに紫外線殺菌灯はありますか？"}, {"type": "subtitle", "time": 13459.83, "timestamp": "03:44:19", "text": "光線？いいえ。わかりました。キャビネット型UV殺菌装置はありますか？"}, {"type": "subtitle", "time": 13461.79, "timestamp": "03:44:21", "text": "光線？いいえ。"}, {"type": "subtitle", "time": 13464.71, "timestamp": "03:44:24", "text": "わかった。服が私たちを見つめている。"}, {"type": "subtitle", "time": 13466.15, "timestamp": "03:44:26", "text": "2階です。 2番目です"}, {"type": "subtitle", "time": 13468.95, "timestamp": "03:44:28", "text": "床だと思います。うん。うん。さあ、さあ"}, {"type": "subtitle", "time": 13470.389, "timestamp": "03:44:30", "text": "2階に行って死ぬ"}, {"type": "subtitle", "time": 13473.51, "timestamp": "03:44:33", "text": "インスタント。ご心配なく。私たちは死んだ"}, {"type": "subtitle", "time": 13475.269, "timestamp": "03:44:35", "text": "この場所で10兆回。誰が"}, {"type": "subtitle", "time": 13477.349, "timestamp": "03:44:37", "text": "気にする？"}, {"type": "subtitle", "time": 13479.349, "timestamp": "03:44:39", "text": "わかった。わかった。わかった。さて、どうやって"}, {"type": "subtitle", "time": 13483.67, "timestamp": "03:44:43", "text": "上の階は今ですか？えっと、まっすぐ進んでください"}, {"type": "subtitle", "time": 13486.309, "timestamp": "03:44:46", "text": "真っ直ぐ。まっすぐ、まっすぐ。"}, {"type": "subtitle", "time": 13489.59, "timestamp": "03:44:49", "text": "いや、ああ、そうだね。そうそう。"}, {"type": "subtitle", "time": 13492.15, "timestamp": "03:44:52", "text": "しかたがない。私はこのことをすっかり忘れていました。"}, {"type": "subtitle", "time": 13496.189, "timestamp": "03:44:56", "text": "うん。ねえ、これ"}, {"type": "subtitle", "time": 13499.03, "timestamp": "03:44:59", "text": "ドアからすぐ、ああ、それは"}]
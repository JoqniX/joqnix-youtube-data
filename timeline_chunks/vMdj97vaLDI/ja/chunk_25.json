[{"type": "subtitle", "time": 1505.75, "timestamp": "00:25:05", "text": "多くの人が集団で攻撃し合っている。何"}, {"type": "subtitle", "time": 1513.269, "timestamp": "00:25:13", "text": "待って、あの人のアバターは何なの？"}, {"type": "subtitle", "time": 1515.029, "timestamp": "00:25:15", "text": "持っている？"}, {"type": "subtitle", "time": 1528.789, "timestamp": "00:25:28", "text": "離れて。ようやく、お互いの声が聞こえるようになった。"}]
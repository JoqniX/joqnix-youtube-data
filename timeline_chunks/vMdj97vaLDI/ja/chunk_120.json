[{"type": "subtitle", "time": 7200.27, "timestamp": "02:00:00", "text": "それはうまくいきますか。"}, {"type": "subtitle", "time": 7202.95, "timestamp": "02:00:02", "text": "それで、でも、でも、私は、"}, {"type": "subtitle", "time": 7204.35, "timestamp": "02:00:04", "text": "あなた自身の"}, {"type": "subtitle", "time": 7206.709, "timestamp": "02:00:06", "text": "マサラ。肉類の持ち込みは禁止されています。肉類と"}, {"type": "subtitle", "time": 7209.75, "timestamp": "02:00:09", "text": "肉類などの食品は許可されていません。"}, {"type": "subtitle", "time": 7211.35, "timestamp": "02:00:11", "text": "でも、マサラはこんな感じであるべきだ"}, {"type": "subtitle", "time": 7215.189, "timestamp": "02:00:15", "text": "マサラパウダーパウダーのようなものだから"}, {"type": "subtitle", "time": 7218.149, "timestamp": "02:00:18", "text": "ハジムムラ・イムリとか全部手に入れたよ。私は手に入れた"}, {"type": "subtitle", "time": 7220.629, "timestamp": "02:00:20", "text": "たくさん食べて"}, {"type": "subtitle", "time": 7227.91, "timestamp": "02:00:27", "text": "ええ、でも医療関係者は費用が高いですよね。どうでしたか？"}, {"type": "subtitle", "time": 7230.47, "timestamp": "02:00:30", "text": "あなたが荷物を持っていたとき"}, {"type": "subtitle", "time": 7232.79, "timestamp": "02:00:32", "text": "日本を訪れる予定ですか？荷物は何個"}, {"type": "subtitle", "time": 7237.27, "timestamp": "02:00:37", "text": "一緒に行くの？たった2人だけ。 1つ手に"}, {"type": "subtitle", "time": 7241.35, "timestamp": "02:00:41", "text": "荷物、1つは、どこに行くか"}, {"type": "subtitle", "time": 7243.669, "timestamp": "02:00:43", "text": "手荷物は1つ、"}, {"type": "subtitle", "time": 7245.83, "timestamp": "02:00:45", "text": "スーツケース 手荷物 でも、"}, {"type": "subtitle", "time": 7248.149, "timestamp": "02:00:48", "text": "たくさん必要になるだろうね。小包"}, {"type": "subtitle", "time": 7251.189, "timestamp": "02:00:51", "text": "も良いですね。配送も良好です。おお"}, {"type": "subtitle", "time": 7253.91, "timestamp": "02:00:53", "text": "インドから日本へ小包で発送できます。"}, {"type": "subtitle", "time": 7255.91, "timestamp": "02:00:55", "text": "簡単にできます、私たちはそれをやりました"}, {"type": "subtitle", "time": 7257.91, "timestamp": "02:00:57", "text": "かなりの時間。知りたい場合は"}, {"type": "subtitle", "time": 7259.91, "timestamp": "02:00:59", "text": "それについては、私は質問できます。なぜなら私は"}]
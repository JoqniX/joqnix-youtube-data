[{"type": "subtitle", "time": 11884.389, "timestamp": "03:18:04", "text": "わからない。私はまるで盲目みたいだ。"}, {"type": "subtitle", "time": 11886.309, "timestamp": "03:18:06", "text": "では、どうか助けていただけませんか？"}, {"type": "subtitle", "time": 11888.71, "timestamp": "03:18:08", "text": "待って、明るさも上げてください"}, {"type": "subtitle", "time": 11890.95, "timestamp": "03:18:10", "text": "ビデオ設定。それはとても役に立つでしょう"}, {"type": "subtitle", "time": 11893.429, "timestamp": "03:18:13", "text": "見る。"}, {"type": "subtitle", "time": 11904.71, "timestamp": "03:18:24", "text": "ああ、私はあなたが盲目になるのを助けたくない"}, {"type": "subtitle", "time": 11907.19, "timestamp": "03:18:27", "text": "私の内側ではいつものことだ。私は怖くて"}, {"type": "subtitle", "time": 11910.87, "timestamp": "03:18:30", "text": "震えているけど、大丈夫、あなたは私の"}, {"type": "subtitle", "time": 11913.269, "timestamp": "03:18:33", "text": "私の人生の光。助けてください。ライト"}, {"type": "subtitle", "time": 11915.79, "timestamp": "03:18:35", "text": "私の人生の中で。はい。"}, {"type": "subtitle", "time": 11921.19, "timestamp": "03:18:41", "text": "お父さん、お母さんが帰ってきたよ。はい、私は"}, {"type": "subtitle", "time": 11928.469, "timestamp": "03:18:48", "text": "蚊の幽霊？"}, {"type": "subtitle", "time": 11931.11, "timestamp": "03:18:51", "text": "彼らは外にいるんですよね？おばけ。おばけ。"}, {"type": "subtitle", "time": 11932.67, "timestamp": "03:18:52", "text": "おばけ。おばけ。おばけ。おばけ。おばけ。"}, {"type": "subtitle", "time": 11935.429, "timestamp": "03:18:55", "text": "おばけ。私です。"}, {"type": "subtitle", "time": 11938.79, "timestamp": "03:18:58", "text": "ああ、あなたは亡くなったのですね。何？私は死んだ。教えて。"}]
[{"type": "subtitle", "time": 11641.59, "timestamp": "03:14:01", "text": "チャック、チャック。はい。はい。おお。おお。見て、"}, {"type": "subtitle", "time": 11643.15, "timestamp": "03:14:03", "text": "見て。する"}, {"type": "subtitle", "time": 11645.389, "timestamp": "03:14:05", "text": "好きではない"}, {"type": "subtitle", "time": 11649.75, "timestamp": "03:14:09", "text": "ああ、そんなことしないで。おお。"}, {"type": "subtitle", "time": 11651.99, "timestamp": "03:14:11", "text": "どうしたの？黙っていてはいけない。しないで"}, {"type": "subtitle", "time": 11654.63, "timestamp": "03:14:14", "text": "静けさ。よし、農場へ行こう。"}, {"type": "subtitle", "time": 11658.15, "timestamp": "03:14:18", "text": "電話に行きましょう。何てことだ。"}, {"type": "subtitle", "time": 11660.55, "timestamp": "03:14:20", "text": "準備ができて。ええ、でも私は何も見ていません"}, {"type": "subtitle", "time": 11662.59, "timestamp": "03:14:22", "text": "ちなみに、これらです。それで、"}, {"type": "subtitle", "time": 11665.429, "timestamp": "03:14:25", "text": "まあ、頑張ってね。"}, {"type": "subtitle", "time": 11666.87, "timestamp": "03:14:26", "text": "幸運を。"}, {"type": "subtitle", "time": 11670.71, "timestamp": "03:14:30", "text": "ああ、これは私が叫んだ唯一のマップだ"}, {"type": "subtitle", "time": 11674.71, "timestamp": "03:14:34", "text": "私の前回のFast Mafia配信で。"}, {"type": "subtitle", "time": 11678.07, "timestamp": "03:14:38", "text": "かわいい。わかった。とにかく、えーと"}, {"type": "subtitle", "time": 11682.91, "timestamp": "03:14:42", "text": "わかった。おっと、デフォルトの負荷があります"}, {"type": "subtitle", "time": 11685.83, "timestamp": "03:14:45", "text": "今。あいつはとっとと消え失せろ。そうですね、"}, {"type": "subtitle", "time": 11687.99, "timestamp": "03:14:47", "text": "これはデフォルトの注文順序です。だから、私たちは"}, {"type": "subtitle", "time": 11690.03, "timestamp": "03:14:50", "text": "これらのものを全部また買わないといけない、"}, {"type": "subtitle", "time": 11693.229, "timestamp": "03:14:53", "text": "右？わかった。"}, {"type": "subtitle", "time": 11697.99, "timestamp": "03:14:57", "text": "わかった。わかった。わかった。カメラを持っていく"}]
[{"type": "subtitle", "time": 9240.87, "timestamp": "02:34:00", "text": "そんなものはないよ"}, {"type": "subtitle", "time": 9243.67, "timestamp": "02:34:03", "text": "サーバーのように。"}, {"type": "subtitle", "time": 9245.429, "timestamp": "02:34:05", "text": "ああ、そうだね。これは"}, {"type": "subtitle", "time": 9248.389, "timestamp": "02:34:08", "text": "サーバー。それは地域のようなものだ。えっと"}, {"type": "subtitle", "time": 9250.87, "timestamp": "02:34:10", "text": "NA をクリックしてください"}, {"type": "subtitle", "time": 9254.79, "timestamp": "02:34:14", "text": "左上の方、作成物の近く"}, {"type": "subtitle", "time": 9258.309, "timestamp": "02:34:18", "text": "ロビーみたいなところ。ああ、わかりました。わかった。今ならできる"}, {"type": "subtitle", "time": 9260.79, "timestamp": "02:34:20", "text": "ロビーを作成します。うん。いいね、いいね、いいね、"}, {"type": "subtitle", "time": 9263.19, "timestamp": "02:34:23", "text": "いいね、いいね、いいね。クール、クール、クール。私"}, {"type": "subtitle", "time": 9269.11, "timestamp": "02:34:29", "text": "わかった。さあ行こう。ロビーを作成します。そしてこれ"}, {"type": "subtitle", "time": 9273.27, "timestamp": "02:34:33", "text": "これをコピーして貼り付けます"}, {"type": "subtitle", "time": 9289.429, "timestamp": "02:34:49", "text": "よし、参加できると思う。とにかく、うん。うん、"}, {"type": "subtitle", "time": 9293.11, "timestamp": "02:34:53", "text": "私は。ああ、そうだよ。黙れ。あなたは淑女です。"}]
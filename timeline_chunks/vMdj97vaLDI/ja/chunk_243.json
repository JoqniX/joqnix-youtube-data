[{"type": "subtitle", "time": 14580.71, "timestamp": "04:03:00", "text": "文字通り誰かが叫んでいるのを見た"}, {"type": "subtitle", "time": 14583.99, "timestamp": "04:03:03", "text": "トマトソースが好きなんですよね？待って、"}, {"type": "subtitle", "time": 14586.51, "timestamp": "04:03:06", "text": "最後の地図、"}, {"type": "subtitle", "time": 14589.67, "timestamp": "04:03:09", "text": "前回はさっき遊んだばかりだよね？その"}, {"type": "subtitle", "time": 14592.389, "timestamp": "04:03:12", "text": "トマトソースがたっぷりですね。トマト"}, {"type": "subtitle", "time": 14594.87, "timestamp": "04:03:14", "text": "ソース室。私たちは文字通り悲鳴を聞いた。"}, {"type": "subtitle", "time": 14597.51, "timestamp": "04:03:17", "text": "だから、彼が息を呑んだり、"}, {"type": "subtitle", "time": 14598.87, "timestamp": "04:03:18", "text": "何か。わからない。忘れた。しかし"}, {"type": "subtitle", "time": 14601.91, "timestamp": "04:03:21", "text": "うん、君はそれに対して何か行動を起こしたんだね。しかしそれは"}, {"type": "subtitle", "time": 14605.03, "timestamp": "04:03:25", "text": "私たちだけを特別扱いしたわけじゃないですよね？おお、"}, {"type": "subtitle", "time": 14607.59, "timestamp": "04:03:27", "text": "待って。どうでも。ああ、それは、ああ、決して"}, {"type": "subtitle", "time": 14608.95, "timestamp": "04:03:28", "text": "心。どうでも。わかった。わかった。わかった。"}, {"type": "subtitle", "time": 14616.55, "timestamp": "04:03:36", "text": "指紋。私は見つけるのがとても苦手です"}, {"type": "subtitle", "time": 14618.15, "timestamp": "04:03:38", "text": "指紋。電車に乗る必要がある"}, {"type": "subtitle", "time": 14620.79, "timestamp": "04:03:40", "text": "私自身は指紋を探す方が好きです。私"}, {"type": "subtitle", "time": 14623.67, "timestamp": "04:03:43", "text": "彼らが普段どこで何をしているかを知っている。"}, {"type": "subtitle", "time": 14625.429, "timestamp": "04:03:45", "text": "彼らは通常ドアのところにいるか、"}, {"type": "subtitle", "time": 14628.309, "timestamp": "04:03:48", "text": "窓越しに見るのは、非常に難しい。"}, {"type": "subtitle", "time": 14630.229, "timestamp": "04:03:50", "text": "じゃあ、わかったよ、ジン。私たちはこれから話します"}, {"type": "subtitle", "time": 14632.63, "timestamp": "04:03:52", "text": "ジン。今やジンは縄張り意識の強い幽霊だ"}, {"type": "subtitle", "time": 14634.79, "timestamp": "04:03:54", "text": "攻撃する"}, {"type": "subtitle", "time": 14637.11, "timestamp": "04:03:57", "text": "脅威を感じたら攻撃する。また、"}, {"type": "subtitle", "time": 14639.429, "timestamp": "04:03:59", "text": "重要な旅行のために建設することが知られています"}]
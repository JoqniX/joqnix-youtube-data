[{"type": "subtitle", "time": 6720.669, "timestamp": "01:52:00", "text": "私は本当の"}, {"type": "subtitle", "time": 6723.35, "timestamp": "01:52:03", "text": "アルコール依存症。心理学は日本の"}, {"type": "subtitle", "time": 6724.51, "timestamp": "01:52:04", "text": "女の子たち。"}, {"type": "chat", "time": 6726.033, "timestamp": "01:52:06", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I wanna go to a dive bar. like some family owned run down place. it don't look fancy but you know their fame put heart and soul into the meal"}, {"type": "subtitle", "time": 6735.55, "timestamp": "01:52:15", "text": "えっと、どこにあるんですか"}, {"type": "subtitle", "time": 6744.189, "timestamp": "01:52:24", "text": "京都に行くなら"}, {"type": "subtitle", "time": 6746.629, "timestamp": "01:52:26", "text": "えっと、もしあなたが持っているなら、もしあなたが"}, {"type": "subtitle", "time": 6748.709, "timestamp": "01:52:28", "text": "京都に行くなら、"}, {"type": "subtitle", "time": 6751.109, "timestamp": "01:52:31", "text": "あなたができることは、"}, {"type": "subtitle", "time": 6753.109, "timestamp": "01:52:33", "text": "具体的には京都に行きたいです。"}, {"type": "subtitle", "time": 6754.709, "timestamp": "01:52:34", "text": "最初に東京に行きたくないので、"}, {"type": "subtitle", "time": 6757.27, "timestamp": "01:52:37", "text": "京都と大阪に行きたいのですが、どうすればいいですか？"}, {"type": "chat", "time": 6759.768, "timestamp": "01:52:39", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "family*"}, {"type": "subtitle", "time": 6762.229, "timestamp": "01:52:42", "text": "大阪にあるドローンルームのようなものを手に入れて"}, {"type": "subtitle", "time": 6764.149, "timestamp": "01:52:44", "text": "そうすれば大阪から簡単に"}, {"type": "subtitle", "time": 6766.55, "timestamp": "01:52:46", "text": "京都、そして京都のように"}, {"type": "subtitle", "time": 6768.55, "timestamp": "01:52:48", "text": "滞在費が少し高いのは"}, {"type": "subtitle", "time": 6770.47, "timestamp": "01:52:50", "text": "場所が好きですが、もしあなたがただ"}, {"type": "subtitle", "time": 6773.75, "timestamp": "01:52:53", "text": "大阪でドムルームを予約できます"}, {"type": "subtitle", "time": 6776.07, "timestamp": "01:52:56", "text": "地下鉄から京都へ簡単に移動でき、"}, {"type": "subtitle", "time": 6778.27, "timestamp": "01:52:58", "text": "それから京都から旅行すると"}]
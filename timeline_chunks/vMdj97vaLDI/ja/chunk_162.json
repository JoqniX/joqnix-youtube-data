[{"type": "subtitle", "time": 9722.389, "timestamp": "02:42:02", "text": "これで7人目となる。やったぞ。準備できました。"}, {"type": "subtitle", "time": 9724.55, "timestamp": "02:42:04", "text": "ジャック、ここで地図を選択してください。うん。"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "ええ、そうしました。ああ、地図を選択したんですね"}, {"type": "subtitle", "time": 9729.27, "timestamp": "02:42:09", "text": "ここ。私も準備を整えました。"}, {"type": "subtitle", "time": 9732.389, "timestamp": "02:42:12", "text": "準備ができて。準備ができて。始める。マップを開始します。おお、"}, {"type": "subtitle", "time": 9734.75, "timestamp": "02:42:14", "text": "うん。うん。私がリーダーです。忘れた。"}, {"type": "subtitle", "time": 9738.15, "timestamp": "02:42:18", "text": "ニース。ゴールを決めたら、"}, {"type": "subtitle", "time": 9741.11, "timestamp": "02:42:21", "text": "彼女が上がってくる。待って。とんでもない。とんでもない。いいえ"}, {"type": "subtitle", "time": 9743.91, "timestamp": "02:42:23", "text": "方法。"}, {"type": "subtitle", "time": 9748.07, "timestamp": "02:42:28", "text": "なんてこった。よぉ、いいぞいいぞ。行け！行け！行け。おお、"}, {"type": "subtitle", "time": 9749.51, "timestamp": "02:42:29", "text": "よし。私たちはここにいます。おお、いいね。"}, {"type": "subtitle", "time": 9751.19, "timestamp": "02:42:31", "text": "ついに。機器を準備し、"}, {"type": "subtitle", "time": 9752.95, "timestamp": "02:42:32", "text": "それに応じて。ニース。 2つあります"}, {"type": "subtitle", "time": 9755.349, "timestamp": "02:42:35", "text": "懐中電灯。"}, {"type": "subtitle", "time": 9758.79, "timestamp": "02:42:38", "text": "汚れはありますか？"}, {"type": "subtitle", "time": 9761.27, "timestamp": "02:42:41", "text": "ああ、私たちは持っていると思います、私たちは1つ持っています"}, {"type": "subtitle", "time": 9763.11, "timestamp": "02:42:43", "text": "汚れ。はい、汚れが1つあります。"}, {"type": "subtitle", "time": 9765.67, "timestamp": "02:42:45", "text": "はい。わかった。だから、私たちがすべきことは"}, {"type": "subtitle", "time": 9769.03, "timestamp": "02:42:49", "text": "捕獲。そうそう。手に取ってください。"}, {"type": "subtitle", "time": 9771.429, "timestamp": "02:42:51", "text": "これは何ですか？のように"}, {"type": "subtitle", "time": 9773.87, "timestamp": "02:42:53", "text": "幽霊の。カメラがありません。私は"}, {"type": "subtitle", "time": 9776.07, "timestamp": "02:42:56", "text": "ごめん。スマッジスティックを持った幽霊。私たちはそうします"}]
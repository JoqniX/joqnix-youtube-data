[{"type": "subtitle", "time": 3302.95, "timestamp": "00:55:02", "text": "弓。何てことだ。しかし私たちはそうではなく、"}, {"type": "subtitle", "time": 3305.03, "timestamp": "00:55:05", "text": "私の家族は誰も"}, {"type": "subtitle", "time": 3307.19, "timestamp": "00:55:07", "text": "親戚か、祖父母のような"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "彼らは誰もそれを食べない。それは純粋だ"}, {"type": "subtitle", "time": 3312.79, "timestamp": "00:55:12", "text": "サイコ。彼には言わないでください。見て"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "彼はジョン・ニック・セナイを気に入るだろう"}, {"type": "subtitle", "time": 3318.79, "timestamp": "00:55:18", "text": "一体何に突入するつもりなんだ、待って"}, {"type": "subtitle", "time": 3321.829, "timestamp": "00:55:21", "text": "彼らは現実の世界へ飛び込むことになる。うん。"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "わかった、知っておく必要がある、知っておく必要がある"}, {"type": "subtitle", "time": 3325.99, "timestamp": "00:55:25", "text": "すべてのステレオタイプ、すべての悪いこと、"}, {"type": "subtitle", "time": 3328.069, "timestamp": "00:55:28", "text": "あらゆる悪口。そして、もしあなたが待つなら、"}, {"type": "subtitle", "time": 3332.23, "timestamp": "00:55:32", "text": "誰かが「ああ、あなたは"}, {"type": "subtitle", "time": 3334.71, "timestamp": "00:55:34", "text": "怒らなきゃいけないんだ。」わかった。怒らなきゃいけないんだ。"}, {"type": "subtitle", "time": 3336.87, "timestamp": "00:55:36", "text": "悪いことから守る"}, {"type": "chat", "time": 3343.601, "timestamp": "00:55:43", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "they eat bao bao??? (pork bao buns) hehe"}, {"type": "subtitle", "time": 3343.99, "timestamp": "00:55:43", "text": "そうそう。彼らはろれつが回らなくなるだろう"}, {"type": "subtitle", "time": 3347.75, "timestamp": "00:55:47", "text": "私にとっては日本語で「on」ですよね？ああ、君"}, {"type": "subtitle", "time": 3350.15, "timestamp": "00:55:50", "text": "理解する？私はとても"}, {"type": "subtitle", "time": 3352.63, "timestamp": "00:55:52", "text": "光栄です。"}]
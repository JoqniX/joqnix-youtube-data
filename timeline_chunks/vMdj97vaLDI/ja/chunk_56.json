[{"type": "subtitle", "time": 3361.23, "timestamp": "00:56:01", "text": "そんなことを言っていいのだろうか？私にさせて"}, {"type": "subtitle", "time": 3364.309, "timestamp": "00:56:04", "text": "考える。はい。または"}, {"type": "subtitle", "time": 3367.589, "timestamp": "00:56:07", "text": "だから、これはただのアドバイスだよ。わかった。"}, {"type": "subtitle", "time": 3370.789, "timestamp": "00:56:10", "text": "はい。はい。はい。人種差別を受ける可能性があります。"}, {"type": "subtitle", "time": 3372.87, "timestamp": "00:56:12", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 3374.349, "timestamp": "00:56:14", "text": "そして、そして"}, {"type": "chat", "time": 3374.743, "timestamp": "00:56:14", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Joq the type of guy who'll cry while fighting"}, {"type": "subtitle", "time": 3376.349, "timestamp": "00:56:16", "text": "好きで、そのこと"}, {"type": "subtitle", "time": 3380.39, "timestamp": "00:56:20", "text": "私はそれを自分でやったのです。だから、だから時々私は"}, {"type": "subtitle", "time": 3382.87, "timestamp": "00:56:22", "text": "私の友人の誰かが"}, {"type": "subtitle", "time": 3384.15, "timestamp": "00:56:24", "text": "特に海外出身の"}, {"type": "subtitle", "time": 3386.71, "timestamp": "00:56:26", "text": "通知を受け取っていない人"}, {"type": "subtitle", "time": 3388.03, "timestamp": "00:56:28", "text": "気づいて"}, {"type": "subtitle", "time": 3390.789, "timestamp": "00:56:30", "text": "私が好きになろうとしている特徴は、これを与えることです"}, {"type": "subtitle", "time": 3394.39, "timestamp": "00:56:34", "text": "いつでも準備しておくようにというアドバイス"}, {"type": "subtitle", "time": 3396.069, "timestamp": "00:56:36", "text": "私にはたくさんの友達がいたから"}, {"type": "subtitle", "time": 3397.91, "timestamp": "00:56:37", "text": "日本に行った人たちはこうでした"}, {"type": "subtitle", "time": 3400.39, "timestamp": "00:56:40", "text": "ああ、とても素敵です。皆さんとても礼儀正しいですが"}, {"type": "subtitle", "time": 3402.47, "timestamp": "00:56:42", "text": "そして、これに直面すると、"}, {"type": "subtitle", "time": 3403.309, "timestamp": "00:56:43", "text": "とても"}, {"type": "subtitle", "time": 3408.23, "timestamp": "00:56:48", "text": "この錯覚を見てください、これは私です"}, {"type": "subtitle", "time": 3411.069, "timestamp": "00:56:51", "text": "私が欲しいものはそこにあると思う"}, {"type": "subtitle", "time": 3414.549, "timestamp": "00:56:54", "text": "えーと、解離しているとか、こういう感じではない"}, {"type": "subtitle", "time": 3416.91, "timestamp": "00:56:56", "text": "がっかりして、ああ彼らは"}]
[{"type": "subtitle", "time": 2887.99, "timestamp": "00:48:07", "text": "ああ、本当にやったんですね。ええ、本当に"}, {"type": "subtitle", "time": 2890.55, "timestamp": "00:48:10", "text": "私は、文字通り"}, {"type": "subtitle", "time": 2897.829, "timestamp": "00:48:17", "text": "わかった。"}, {"type": "subtitle", "time": 2900.47, "timestamp": "00:48:20", "text": "そして私はそれは、それは"}, {"type": "subtitle", "time": 2901.91, "timestamp": "00:48:21", "text": "ジョーク。これは、これは実際のものです"}, {"type": "subtitle", "time": 2904.67, "timestamp": "00:48:24", "text": "それは私にも起こったことです。私は文字通り上に登った"}, {"type": "subtitle", "time": 2908.349, "timestamp": "00:48:28", "text": "まるで、そして、そして彼らは両方とも"}, {"type": "subtitle", "time": 2911.51, "timestamp": "00:48:31", "text": "「それは良くないよ。そんなことしちゃダメだよ。」みたいな感じ。"}, {"type": "subtitle", "time": 2913.349, "timestamp": "00:48:33", "text": "私は「なぜ？これはただの指じゃないか」と思いました。"}, {"type": "subtitle", "time": 2915.349, "timestamp": "00:48:35", "text": "なぜ、なぜあなたは私にそうしないように言うのですか"}, {"type": "subtitle", "time": 2918.15, "timestamp": "00:48:38", "text": "「そうするの？」そしてその後、私は"}, {"type": "subtitle", "time": 2919.67, "timestamp": "00:48:39", "text": "彼らが訂正すらしていないことに気づいた"}, {"type": "subtitle", "time": 2921.109, "timestamp": "00:48:41", "text": "自分。わかった。あの兄弟はそうしなかった"}, {"type": "subtitle", "time": 2923.51, "timestamp": "00:48:43", "text": "私を訂正して、その後"}, {"type": "subtitle", "time": 2925.589, "timestamp": "00:48:45", "text": "3年、4年、5年経って私は"}, {"type": "subtitle", "time": 2929.43, "timestamp": "00:48:49", "text": "これは、なんてことだという意味です"}, {"type": "subtitle", "time": 2932.23, "timestamp": "00:48:52", "text": "ええ、それが強壮剤の理由です"}, {"type": "subtitle", "time": 2934.71, "timestamp": "00:48:54", "text": "悪いことを学べと言っているんだ"}, {"type": "subtitle", "time": 2936.87, "timestamp": "00:48:56", "text": "やらないで、悪いことを学んで"}, {"type": "subtitle", "time": 2939.91, "timestamp": "00:48:59", "text": "もし誰かがあなたのところにやって来て、こう言ったら"}]
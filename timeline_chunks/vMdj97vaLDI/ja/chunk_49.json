[{"type": "subtitle", "time": 2941.109, "timestamp": "00:49:01", "text": "あなたはそれが何を意味するのか分からないし、"}, {"type": "subtitle", "time": 2943.549, "timestamp": "00:49:03", "text": "好きになる"}, {"type": "subtitle", "time": 2948.23, "timestamp": "00:49:08", "text": "そうそう、まさにその通り、もし誰かが"}, {"type": "subtitle", "time": 2950.549, "timestamp": "00:49:10", "text": "やって来て、えっと何何って言うの"}, {"type": "subtitle", "time": 2954.23, "timestamp": "00:49:14", "text": "あの有名なものって何ですか？想像してみて"}, {"type": "subtitle", "time": 2957.829, "timestamp": "00:49:17", "text": "あなたはムンバイにいて、そして誰かが"}, {"type": "subtitle", "time": 2960.47, "timestamp": "00:49:20", "text": "マラーティー語を話すと、私は"}, {"type": "subtitle", "time": 2961.829, "timestamp": "00:49:21", "text": "そしてあなたはそれが何を意味するのかさえ知らない"}, {"type": "subtitle", "time": 2965.75, "timestamp": "00:49:25", "text": "そしてあなたはこう言うでしょう"}, {"type": "subtitle", "time": 2968.39, "timestamp": "00:49:28", "text": "まさに私のことだ。ええ、それが理由です"}, {"type": "subtitle", "time": 2969.75, "timestamp": "00:49:29", "text": "だから私はあなたに学んでほしいと言っているのです"}, {"type": "subtitle", "time": 2971.75, "timestamp": "00:49:31", "text": "最高。だから人々はこう言う"}, {"type": "subtitle", "time": 2973.75, "timestamp": "00:49:33", "text": "人々が新しいことを学んでいるとき、なぜ"}, {"type": "chat", "time": 2974.199, "timestamp": "00:49:34", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Dats Him fr"}, {"type": "subtitle", "time": 2975.99, "timestamp": "00:49:35", "text": "言語はなぜ、なぜ、ご存知のように、"}, {"type": "subtitle", "time": 2978.95, "timestamp": "00:49:38", "text": "なぜ彼らはいつも「え、何？」って感じなの？"}, {"type": "subtitle", "time": 2980.87, "timestamp": "00:49:40", "text": "まずは悪いことから学ぶべきだ。つまり"}, {"type": "subtitle", "time": 2983.31, "timestamp": "00:49:43", "text": "それがあなたがすべきことです。"}, {"type": "subtitle", "time": 2985.549, "timestamp": "00:49:45", "text": "[音楽]"}, {"type": "subtitle", "time": 2988.71, "timestamp": "00:49:48", "text": "真実。だから、それを回避したりできるんです。"}, {"type": "subtitle", "time": 2990.549, "timestamp": "00:49:50", "text": "うん。だからそれを避けて、"}, {"type": "subtitle", "time": 2992.23, "timestamp": "00:49:52", "text": "また、あなたも知ることができるように、避けることもできます。"}, {"type": "subtitle", "time": 2994.39, "timestamp": "00:49:54", "text": "人があなたに悪口を言っているとき。"}, {"type": "subtitle", "time": 2996.549, "timestamp": "00:49:56", "text": "それは良い。私は持っています 私は持っています"}]
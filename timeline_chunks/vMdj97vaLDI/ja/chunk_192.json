[{"type": "subtitle", "time": 11530.14, "timestamp": "03:12:10", "text": "の上。何てことだ。"}, {"type": "subtitle", "time": 11533.11, "timestamp": "03:12:13", "text": "[音楽]"}, {"type": "subtitle", "time": 11534.309, "timestamp": "03:12:14", "text": "凍えるほど寒い。凍えるほど寒い。私は"}, {"type": "subtitle", "time": 11536.71, "timestamp": "03:12:16", "text": "凍りつく。"}, {"type": "subtitle", "time": 11539.99, "timestamp": "03:12:19", "text": "いや、死なないで。まだ死ぬな。わかった。いいえ。"}, {"type": "subtitle", "time": 11542.469, "timestamp": "03:12:22", "text": "行く。外出。外出。三つ。三つ。あらら。"}, {"type": "subtitle", "time": 11545.429, "timestamp": "03:12:25", "text": "あらら。狩猟。 1つ。 1つ。 1つ。 1つ。それ"}, {"type": "subtitle", "time": 11547.57, "timestamp": "03:12:27", "text": "３歳でした。そうだった"}, {"type": "subtitle", "time": 11548.91, "timestamp": "03:12:28", "text": "[音楽]"}, {"type": "subtitle", "time": 11555.63, "timestamp": "03:12:35", "text": "本当に怖い。ヴァカ。ああ、"}, {"type": "subtitle", "time": 11559.11, "timestamp": "03:12:39", "text": "神。私はリアルを選びました。わからない。私"}, {"type": "subtitle", "time": 11561.99, "timestamp": "03:12:41", "text": "Reentも選んだ。わかった。"}, {"type": "subtitle", "time": 11564.23, "timestamp": "03:12:44", "text": "ああ、明けましておめでとうございます。行かなくてごめんなさい"}, {"type": "subtitle", "time": 11566.87, "timestamp": "03:12:46", "text": "ここに長い間住んでいます。私は背骨に栄養を与えた。おお"}, {"type": "subtitle", "time": 11569.63, "timestamp": "03:12:49", "text": "我が神よ。"}, {"type": "subtitle", "time": 11573.83, "timestamp": "03:12:53", "text": "錯覚。我が神よ。大丈夫ですか？"}, {"type": "subtitle", "time": 11576.71, "timestamp": "03:12:56", "text": "ああ、それは悪魔だ。それは悪魔だった。私"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "ああ、聞こえたんですね。"}]
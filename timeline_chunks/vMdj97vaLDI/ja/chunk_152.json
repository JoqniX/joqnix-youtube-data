[{"type": "subtitle", "time": 9120.95, "timestamp": "02:32:00", "text": "それは、驚きへの準備のようなものだ。"}, {"type": "subtitle", "time": 9125.19, "timestamp": "02:32:05", "text": "さあ行こう。待って。三つ。待って。それでなぜ"}, {"type": "subtitle", "time": 9128.389, "timestamp": "02:32:08", "text": "マンドに名前を付ける必要はありますか？はい。"}, {"type": "subtitle", "time": 9130.07, "timestamp": "02:32:10", "text": "ちなみに、それはクエストの一部です。"}, {"type": "subtitle", "time": 9133.429, "timestamp": "02:32:13", "text": "それをスキップしたりすることはできません。ああ"}, {"type": "subtitle", "time": 9136.309, "timestamp": "02:32:16", "text": "1つか1つとか入れられないの？"}, {"type": "subtitle", "time": 9139.27, "timestamp": "02:32:19", "text": "それとも2つか何か？おいおい。来る"}, {"type": "subtitle", "time": 9141.67, "timestamp": "02:32:21", "text": "の上。わかった。そんなことを言ってはいけない。"}, {"type": "subtitle", "time": 9144.55, "timestamp": "02:32:24", "text": "わかった。あなたも参加しますか？待って。いやいや。"}, {"type": "subtitle", "time": 9147.75, "timestamp": "02:32:27", "text": "もう一度コードを教えてください。うん。いいえ、いいえ、"}, {"type": "subtitle", "time": 9149.75, "timestamp": "02:32:29", "text": "いいえ。ちなみに、DMで送りましたよ。"}, {"type": "subtitle", "time": 9151.03, "timestamp": "02:32:31", "text": "おっしゃる通りです。ああ、そうだったね。わかった。わかった。"}, {"type": "subtitle", "time": 9154.27, "timestamp": "02:32:34", "text": "わかった。わかった。ありがとう。"}, {"type": "subtitle", "time": 9156.55, "timestamp": "02:32:36", "text": "雪だるま、これを作りたい？"}, {"type": "subtitle", "time": 9158.15, "timestamp": "02:32:38", "text": "雪だるま？"}, {"type": "subtitle", "time": 9165.27, "timestamp": "02:32:45", "text": "立ち寄ってくれましたか？"}, {"type": "subtitle", "time": 9176.55, "timestamp": "02:32:56", "text": "わかった。あなたが望む困難は、"}]
[{"type": "subtitle", "time": 15060.71, "timestamp": "04:11:00", "text": "何が起こったのか？どうしたの？私は死にかけている。私"}, {"type": "subtitle", "time": 15064.469, "timestamp": "04:11:04", "text": "死にかけているかもしれない。どこにいるの？"}, {"type": "subtitle", "time": 15067.269, "timestamp": "04:11:07", "text": "私は階下にいて、ウホッという声が聞こえました。私は"}, {"type": "subtitle", "time": 15069.67, "timestamp": "04:11:09", "text": "死んだ。私は死んだ。私は死んだ。私は死んだ。私は"}, {"type": "subtitle", "time": 15071.59, "timestamp": "04:11:11", "text": "死んだ。私は死ぬかもしれない。私はパニックになった。私"}, {"type": "subtitle", "time": 15073.349, "timestamp": "04:11:13", "text": "パニックになった。ごめんなさい。私は耐えられなかった"}, {"type": "subtitle", "time": 15075.03, "timestamp": "04:11:15", "text": "その写真。私はパニックになった。私はパニックになった"}, {"type": "subtitle", "time": 15077.51, "timestamp": "04:11:17", "text": "外。みんなでそれをタップしたよ。私はパニックになった。私は"}, {"type": "subtitle", "time": 15079.67, "timestamp": "04:11:19", "text": "ごめん。"}, {"type": "subtitle", "time": 15082.229, "timestamp": "04:11:22", "text": "わかった。私はしゃがんでいます。私はしゃがんでいます。私は"}, {"type": "subtitle", "time": 15084.71, "timestamp": "04:11:24", "text": "しゃがむ。私はしゃがんでいます。私はしゃがんでいます。"}, {"type": "subtitle", "time": 15087.03, "timestamp": "04:11:27", "text": "おお。おいおい、勘弁してくれよ。おい、待ってくれ。した"}, {"type": "subtitle", "time": 15089.83, "timestamp": "04:11:29", "text": "死ぬのか？死んだのか、兄弟？来て。あなた"}, {"type": "subtitle", "time": 15092.87, "timestamp": "04:11:32", "text": "私にこんなことさせないで。あなたは死んだのですか？"}, {"type": "subtitle", "time": 15095.67, "timestamp": "04:11:35", "text": "俺は「おい、俺はトイレにいるんだ」って感じだ。"}, {"type": "subtitle", "time": 15099.91, "timestamp": "04:11:39", "text": "まあ、あなたにできることはあまりないと思うよ。"}, {"type": "subtitle", "time": 15102.59, "timestamp": "04:11:42", "text": "私はEMFを使用しませんでした。"}, {"type": "subtitle", "time": 15105.75, "timestamp": "04:11:45", "text": "男。私の待って、それはEMFがなかった、"}, {"type": "subtitle", "time": 15108.55, "timestamp": "04:11:48", "text": "しかし、私はそう信じています。待って、待って。私は使用しましたか"}, {"type": "subtitle", "time": 15113.269, "timestamp": "04:11:53", "text": "VFですか？ちょっと待って、混乱してる。ああ、君のせいだ。"}, {"type": "subtitle", "time": 15117.03, "timestamp": "04:11:57", "text": "私は、私は、私は、私は、私は、"}, {"type": "subtitle", "time": 15119.03, "timestamp": "04:11:59", "text": "の"}]
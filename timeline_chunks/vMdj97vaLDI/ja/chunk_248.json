[{"type": "subtitle", "time": 14880.309, "timestamp": "04:08:00", "text": "わかった。何もない"}, {"type": "subtitle", "time": 14886.79, "timestamp": "04:08:06", "text": "開いている部屋があります。"}, {"type": "subtitle", "time": 14889.429, "timestamp": "04:08:09", "text": "わかった。この場所はブーストのようなもの"}, {"type": "subtitle", "time": 14891.229, "timestamp": "04:08:11", "text": "幽霊のように"}, {"type": "subtitle", "time": 14895.67, "timestamp": "04:08:15", "text": "起こる。では、待ってください。待って、部屋が"}, {"type": "subtitle", "time": 14897.15, "timestamp": "04:08:17", "text": "開ける、それが"}, {"type": "subtitle", "time": 14899.59, "timestamp": "04:08:19", "text": "「あ、待って」という意味です。それは何ですか？我々は持っています"}, {"type": "subtitle", "time": 14901.11, "timestamp": "04:08:21", "text": "待って、待って、待って、待って。私は取るべき"}, {"type": "subtitle", "time": 14903.189, "timestamp": "04:08:23", "text": "これの写真ですよね？"}, {"type": "subtitle", "time": 14904.79, "timestamp": "04:08:24", "text": "ところで、これは一体何ですか？空挺。"}, {"type": "subtitle", "time": 14907.349, "timestamp": "04:08:27", "text": "空挺。そうそう。骨の写真。"}, {"type": "subtitle", "time": 14910.229, "timestamp": "04:08:30", "text": "どうぞ。"}, {"type": "subtitle", "time": 14912.389, "timestamp": "04:08:32", "text": "どうすればいいですか？いつも写真を撮る"}, {"type": "subtitle", "time": 14915.349, "timestamp": "04:08:35", "text": "骨。どうやって装備すればいいですか？"}, {"type": "subtitle", "time": 14916.67, "timestamp": "04:08:36", "text": "わかった。わかった。手に入れた"}, {"type": "subtitle", "time": 14918.87, "timestamp": "04:08:38", "text": "それ。何てことだ。あなたは写真を撮りました"}, {"type": "subtitle", "time": 14922.07, "timestamp": "04:08:42", "text": "骨のことですよね？はい。わかった。そのその"}, {"type": "subtitle", "time": 14924.99, "timestamp": "04:08:44", "text": "幽霊乗りのやつがここにある。しないでください"}, {"type": "subtitle", "time": 14928.79, "timestamp": "04:08:48", "text": "忘れる。それは上の階の倉庫の寝室にあります。"}]
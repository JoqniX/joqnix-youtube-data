[{"type": "subtitle", "time": 13211.269, "timestamp": "03:40:11", "text": "テレビに行って、負荷をかけてください"}, {"type": "subtitle", "time": 13218.95, "timestamp": "03:40:18", "text": "オーケーからやらなければならなかった。私は"}, {"type": "subtitle", "time": 13220.99, "timestamp": "03:40:20", "text": "誤って他の商品を購入してしまった？わかった、"}, {"type": "subtitle", "time": 13225.51, "timestamp": "03:40:25", "text": "待って。えっと、追加します"}, {"type": "subtitle", "time": 13229.269, "timestamp": "03:40:29", "text": "ニース。待って、私たちはそれを持っていたの？ いいえ、持っていました"}, {"type": "subtitle", "time": 13234.71, "timestamp": "03:40:34", "text": "待って、あなたは持っていない"}, {"type": "subtitle", "time": 13237.349, "timestamp": "03:40:37", "text": "温度計、あなたは持っていますか？買わなければならない。"}, {"type": "subtitle", "time": 13239.51, "timestamp": "03:40:39", "text": "買いましたか？わかった。わかった。わかった。"}, {"type": "subtitle", "time": 13241.59, "timestamp": "03:40:41", "text": "わかった。えっと、下にスクロールしてください。待って"}, {"type": "subtitle", "time": 13248.389, "timestamp": "03:40:48", "text": "ああ、2つですね。待って、私は２つ買ったの？"}, {"type": "subtitle", "time": 13251.269, "timestamp": "03:40:51", "text": "彼ら？何てことだ。 1つ取り除く。"}, {"type": "subtitle", "time": 13254.71, "timestamp": "03:40:54", "text": "2つ買うなら問題ないよ。 1つだけ使えばいい。"}, {"type": "subtitle", "time": 13257.269, "timestamp": "03:40:57", "text": "いや、いや。たとえ"}]
[{"type": "subtitle", "time": 15307.429, "timestamp": "04:15:07", "text": "あなた。どのトイレですか？私は2つチェックしました"}, {"type": "subtitle", "time": 15310.269, "timestamp": "04:15:10", "text": "トイレ。シャワー"}, {"type": "subtitle", "time": 15313.51, "timestamp": "04:15:13", "text": "部屋と、私たちが最初にオープンした場所"}, {"type": "subtitle", "time": 15314.83, "timestamp": "04:15:14", "text": "立ち上がって"}, {"type": "subtitle", "time": 15317.59, "timestamp": "04:15:17", "text": "行ってみると、幽霊は跡形もなく消えてしまった。"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "今は私たちは"}, {"type": "subtitle", "time": 15330.309, "timestamp": "04:15:30", "text": "待って、ところで君はどこにいるの？ああ、なるほど。"}, {"type": "subtitle", "time": 15331.83, "timestamp": "04:15:31", "text": "あなた。あなたが見えてます。わかった。わかった。行く。出て行け。"}, {"type": "subtitle", "time": 15332.99, "timestamp": "04:15:32", "text": "出て行け。うん。うん。"}, {"type": "subtitle", "time": 15338.71, "timestamp": "04:15:38", "text": "うん。えっと、EMFは確か5だったと思います。"}, {"type": "subtitle", "time": 15342.95, "timestamp": "04:15:42", "text": "電磁界。わかった。うん。それから、ええと、"}, {"type": "subtitle", "time": 15346.229, "timestamp": "04:15:46", "text": "えーと、電磁場とか。何もありません。だった"}, {"type": "subtitle", "time": 15348.55, "timestamp": "04:15:48", "text": "私のレベル5にいます。見つかりませんでした"}, {"type": "subtitle", "time": 15349.309, "timestamp": "04:15:49", "text": "どれでも"}, {"type": "subtitle", "time": 15351.91, "timestamp": "04:15:51", "text": "指紋。私は知らない"}, {"type": "subtitle", "time": 15354.79, "timestamp": "04:15:54", "text": "霊媒箱はありません。いいえ"}, {"type": "subtitle", "time": 15358.389, "timestamp": "04:15:58", "text": "氷点下の気温。ゴーストライディングは禁止です。えっと"}]
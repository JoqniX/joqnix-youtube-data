[{"type": "subtitle", "time": 10621.429, "timestamp": "02:57:01", "text": "マイクをマイクから離してください。何何私は"}, {"type": "subtitle", "time": 10624.23, "timestamp": "02:57:04", "text": "録音するべきでしょうか？"}, {"type": "subtitle", "time": 10628.07, "timestamp": "02:57:08", "text": "ええと、配列が友達になるかもしれないと思います"}, {"type": "subtitle", "time": 10634.83, "timestamp": "02:57:14", "text": "うん。うん。システムを確認してください"}, {"type": "subtitle", "time": 10637.75, "timestamp": "02:57:17", "text": "話すときの音"}, {"type": "subtitle", "time": 10639.59, "timestamp": "02:57:19", "text": "点灯するでしょう。そのうちの1つは"}, {"type": "subtitle", "time": 10641.59, "timestamp": "02:57:21", "text": "明かりが灯る。それがあなたが"}, {"type": "subtitle", "time": 10644.23, "timestamp": "02:57:24", "text": "選択する必要がある。"}, {"type": "subtitle", "time": 10646.63, "timestamp": "02:57:26", "text": "わかった。これはマイクではない"}, {"type": "subtitle", "time": 10661.67, "timestamp": "02:57:41", "text": "頭脳は技術的な作業を助けてくれる。"}, {"type": "subtitle", "time": 10664.71, "timestamp": "02:57:44", "text": "こんにちは。こんにちは。こんにちは。こんにちは。うーん、うーん、うーん。"}, {"type": "subtitle", "time": 10667.19, "timestamp": "02:57:47", "text": "おい。おい。おい。なぜ３つあるのか"}, {"type": "subtitle", "time": 10669.67, "timestamp": "02:57:49", "text": "懐中電灯？何てことだ。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 10673.51, "timestamp": "02:57:53", "text": "こんにちは。こんにちは。こんにちは。こんにちは。こんにちは。おい。おい。おい。"}]
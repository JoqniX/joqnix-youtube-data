[{"type": "subtitle", "time": 12840.79, "timestamp": "03:34:00", "text": "ええと、入ります。私が死んだら、あなたは"}, {"type": "subtitle", "time": 12849.269, "timestamp": "03:34:09", "text": "わかりました、行きます。どこで"}, {"type": "subtitle", "time": 12850.95, "timestamp": "03:34:10", "text": "ところで、その本を仕込んだのはあなたですか？私は"}, {"type": "subtitle", "time": 12853.269, "timestamp": "03:34:13", "text": "探しています。ええと、あそこです。"}, {"type": "subtitle", "time": 12854.55, "timestamp": "03:34:14", "text": "まっすぐまっすぐまっすぐまっすぐ"}, {"type": "subtitle", "time": 12870.229, "timestamp": "03:34:30", "text": "ドア。大丈夫です。ただのドアだよ。"}, {"type": "subtitle", "time": 12871.59, "timestamp": "03:34:31", "text": "神。"}, {"type": "subtitle", "time": 12874.71, "timestamp": "03:34:34", "text": "いいえ、ここでは幽霊乗りはできません。これ"}, {"type": "subtitle", "time": 12875.399, "timestamp": "03:34:35", "text": "これ この幽霊は最悪だ。"}, {"type": "subtitle", "time": 12882.15, "timestamp": "03:34:42", "text": "いいえ、違います。ドアが開かない。"}, {"type": "subtitle", "time": 12884.91, "timestamp": "03:34:44", "text": "手伝っていただけますか？私はできません"}, {"type": "subtitle", "time": 12887.83, "timestamp": "03:34:47", "text": "ヘルプ。何てことだ。はい、心配しないでください。ただ"}, {"type": "subtitle", "time": 12889.67, "timestamp": "03:34:49", "text": "ドアを開けてください。なぜあなたが"}, {"type": "subtitle", "time": 12891.75, "timestamp": "03:34:51", "text": "のように"}, {"type": "subtitle", "time": 12894.71, "timestamp": "03:34:54", "text": "了解、了解。いいね。私たちを殺さないでください"}]
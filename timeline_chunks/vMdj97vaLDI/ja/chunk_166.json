[{"type": "subtitle", "time": 9963.15, "timestamp": "02:46:03", "text": "何か？それは何ですか？あなたは"}, {"type": "subtitle", "time": 9965.55, "timestamp": "02:46:05", "text": "ここ？聞こえますか？"}, {"type": "subtitle", "time": 9968.349, "timestamp": "02:46:08", "text": "私たち？あなたは"}, {"type": "subtitle", "time": 9972.23, "timestamp": "02:46:12", "text": "ここ？あなたはここにいますか？"}, {"type": "subtitle", "time": 9974.309, "timestamp": "02:46:14", "text": "どこにいるの？"}, {"type": "subtitle", "time": 9977.75, "timestamp": "02:46:17", "text": "私の何歳ですか？"}, {"type": "subtitle", "time": 9979.83, "timestamp": "02:46:19", "text": "いいね。"}, {"type": "subtitle", "time": 9982.07, "timestamp": "02:46:22", "text": "わかった。自由のゲーム。私はゲームをしています"}, {"type": "subtitle", "time": 9989.51, "timestamp": "02:46:29", "text": "ヴィックはどこにいたのか？ええ、ここにいますよ。私は"}, {"type": "subtitle", "time": 9990.79, "timestamp": "02:46:30", "text": "ここ。心配しないで。心配しないで、"}, {"type": "subtitle", "time": 10002.83, "timestamp": "02:46:42", "text": "あなたは"}, {"type": "subtitle", "time": 10006.07, "timestamp": "02:46:46", "text": "ここ？どこにいるの？"}, {"type": "subtitle", "time": 10009.03, "timestamp": "02:46:49", "text": "わかった。何かが動くのを見ましたか？それは"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "私ですか？それとも何か動くものが見えましたか？ドゥドゥ"}, {"type": "subtitle", "time": 10014.07, "timestamp": "02:46:54", "text": "カメラを手に取るのは君か、ジョック？はい、私は"}, {"type": "subtitle", "time": 10016.309, "timestamp": "02:46:56", "text": "した。 1秒。どこにあるか確認させてください"}, {"type": "subtitle", "time": 10018.79, "timestamp": "02:46:58", "text": "ジェネレーターは。"}]
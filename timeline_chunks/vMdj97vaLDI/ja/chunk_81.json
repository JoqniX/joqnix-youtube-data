[{"type": "subtitle", "time": 4860.95, "timestamp": "01:21:00", "text": "Nで始まる何か"}, {"type": "subtitle", "time": 4864.99, "timestamp": "01:21:04", "text": "成田空港。ああ、成田。うん。ああ"}, {"type": "chat", "time": 4866.004, "timestamp": "01:21:06", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "I can ask about the internet"}, {"type": "subtitle", "time": 4869.27, "timestamp": "01:21:09", "text": "だから私は成田を使っています。手に入れた瞬間"}, {"type": "subtitle", "time": 4872.229, "timestamp": "01:21:12", "text": "下、"}, {"type": "subtitle", "time": 4874.95, "timestamp": "01:21:14", "text": "降りる瞬間に、"}, {"type": "subtitle", "time": 4879.11, "timestamp": "01:21:19", "text": "CMI Simという会社を目にするだけです。あなた"}, {"type": "subtitle", "time": 4881.27, "timestamp": "01:21:21", "text": "彼らに私が欲しいように尋ねることもできます"}, {"type": "subtitle", "time": 4884.63, "timestamp": "01:21:24", "text": "SIMカードは、"}, {"type": "subtitle", "time": 4887.11, "timestamp": "01:21:27", "text": "もちろん、私はそれを充電し続けることができます"}, {"type": "subtitle", "time": 4888.87, "timestamp": "01:21:28", "text": "そして彼らはあなたにSIMカードを渡します"}, {"type": "subtitle", "time": 4891.51, "timestamp": "01:21:31", "text": "通話とインターネットが同時に利用できます"}, {"type": "subtitle", "time": 4897.35, "timestamp": "01:21:37", "text": "時間。費用はおよそ"}, {"type": "subtitle", "time": 4899.27, "timestamp": "01:21:39", "text": "15日間であれば、"}, {"type": "subtitle", "time": 4902.31, "timestamp": "01:21:42", "text": "5,000ルピー。"}, {"type": "subtitle", "time": 4904.47, "timestamp": "01:21:44", "text": "5,000円お待ちください。費用は5,000です"}, {"type": "subtitle", "time": 4907.669, "timestamp": "01:21:47", "text": "円。想像してみてください、どれほどの金額になるか。おお"}, {"type": "subtitle", "time": 4910.87, "timestamp": "01:21:50", "text": "我が神よ。 3000くらい。だから私たちと比較すると"}, {"type": "subtitle", "time": 4914.03, "timestamp": "01:21:54", "text": "インドでは、000。"}, {"type": "subtitle", "time": 4917.11, "timestamp": "01:21:57", "text": "わかった。インターネットについて尋ねたところ、"}, {"type": "subtitle", "time": 4918.79, "timestamp": "01:21:58", "text": "今月、2週間そこに滞在する予定です。私はできる"}]
[{"type": "subtitle", "time": 12002.07, "timestamp": "03:20:02", "text": "それはテレビ、テレビ、ラジオの音です。"}, {"type": "subtitle", "time": 12003.91, "timestamp": "03:20:03", "text": "ラジオやテレビの音が聞こえる。ブー"}, {"type": "subtitle", "time": 12006.71, "timestamp": "03:20:06", "text": "音は上から聞こえてくる。"}, {"type": "subtitle", "time": 12008.95, "timestamp": "03:20:08", "text": "いや、いや。ラジオテレビの音は"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "文字通り私のスピリットボックスは"}, {"type": "subtitle", "time": 12018.95, "timestamp": "03:20:18", "text": "それは何かを物語っている。"}, {"type": "subtitle", "time": 12021.59, "timestamp": "03:20:21", "text": "何かを言っているということは、"}, {"type": "subtitle", "time": 12024.71, "timestamp": "03:20:24", "text": "スピリットボックスについて書いてください。もし"}, {"type": "subtitle", "time": 12026.63, "timestamp": "03:20:26", "text": "来るような感じだ、ああ、どこにいるの？"}, {"type": "subtitle", "time": 12028.63, "timestamp": "03:20:28", "text": "ところで？私はそれを書くべきだ。おばけ"}, {"type": "subtitle", "time": 12030.87, "timestamp": "03:20:30", "text": "乗馬。"}, {"type": "subtitle", "time": 12033.349, "timestamp": "03:20:33", "text": "ゴーストライティング。ゴーストライディング。いいえ。いいえ。私は私"}, {"type": "subtitle", "time": 12037.429, "timestamp": "03:20:37", "text": "とりあえず、スピリットボックスをチェックしました。うん。"}, {"type": "subtitle", "time": 12039.83, "timestamp": "03:20:39", "text": "わかった。わかった。そこに行くと、そこには"}, {"type": "subtitle", "time": 12041.67, "timestamp": "03:20:41", "text": "本。幽霊乗りの本。幽霊"}, {"type": "subtitle", "time": 12044.15, "timestamp": "03:20:44", "text": "本当です。幽霊が私の近くにいる"}, {"type": "subtitle", "time": 12051.59, "timestamp": "03:20:51", "text": "EMFとは何ですか？ EMFは何のためにあるのですか？おお"}, {"type": "subtitle", "time": 12053.03, "timestamp": "03:20:53", "text": "我が神よ。"}, {"type": "subtitle", "time": 12055.95, "timestamp": "03:20:55", "text": "それは、それは、それは、それは、"}]
[{"type": "subtitle", "time": 15182.149, "timestamp": "04:13:02", "text": "あなたはそう思いますか？あなたはどのトイレにいますか？私は"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "ちなみに、階下のトイレで。"}, {"type": "subtitle", "time": 15188.349, "timestamp": "04:13:08", "text": "わかった。だから、あなたの"}, {"type": "subtitle", "time": 15191.189, "timestamp": "04:13:11", "text": "マイクは階下にあります。あなたはどのトイレですか？"}, {"type": "subtitle", "time": 15194.95, "timestamp": "04:13:14", "text": "ここでは違う。あなたはどのトイレにいますか？のように"}, {"type": "subtitle", "time": 15197.349, "timestamp": "04:13:17", "text": "ずっと下の方。地下。"}, {"type": "subtitle", "time": 15199.269, "timestamp": "04:13:19", "text": "いや、地下のトイレじゃないよ。私は"}, {"type": "subtitle", "time": 15201.91, "timestamp": "04:13:21", "text": "1階のトイレ。"}, {"type": "subtitle", "time": 15209.75, "timestamp": "04:13:29", "text": "わかった。少々お待ちください。わかった。わかった。取る"}, {"type": "subtitle", "time": 15226.349, "timestamp": "04:13:46", "text": "それは"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "けれど？幽霊はどこに置いたの？"}]
[{"type": "subtitle", "time": 12241.67, "timestamp": "03:24:01", "text": "幽霊と一緒にPvPをしよう。何てことだ。"}, {"type": "subtitle", "time": 12243.03, "timestamp": "03:24:03", "text": "ところで、あなたはできると思います"}, {"type": "subtitle", "time": 12246.349, "timestamp": "03:24:06", "text": "感嘆符の頭文字。ところで、"}, {"type": "subtitle", "time": 12248.55, "timestamp": "03:24:08", "text": "古き良き時代を、"}, {"type": "subtitle", "time": 12251.349, "timestamp": "03:24:11", "text": "文字通り、ただ横になってまたプレイすればいいんです。"}, {"type": "subtitle", "time": 12253.19, "timestamp": "03:24:13", "text": "これが、"}, {"type": "subtitle", "time": 12256.55, "timestamp": "03:24:16", "text": "ここに召喚された。"}, {"type": "subtitle", "time": 12265.349, "timestamp": "03:24:25", "text": "はい、UVライトが必要です。"}, {"type": "subtitle", "time": 12268.469, "timestamp": "03:24:28", "text": "それは、好きになるのが極めて絶望的だ"}, {"type": "subtitle", "time": 12271.03, "timestamp": "03:24:31", "text": "わかった。ケア。ビデオカメラは役に立たない"}, {"type": "subtitle", "time": 12275.71, "timestamp": "03:24:35", "text": "私にとって。 EMFのことなので、"}, {"type": "subtitle", "time": 12277.99, "timestamp": "03:24:37", "text": "キャンドル。わかった。拾ってもらえますか"}, {"type": "subtitle", "time": 12280.229, "timestamp": "03:24:40", "text": "電磁界の低下？私はろうそくを持って"}, {"type": "subtitle", "time": 12282.229, "timestamp": "03:24:42", "text": "それを置いて戻ってきて、それから"}, {"type": "subtitle", "time": 12285.03, "timestamp": "03:24:45", "text": "電磁界を拾います。"}, {"type": "subtitle", "time": 12287.51, "timestamp": "03:24:47", "text": "日記帳が欲しいですか？"}, {"type": "subtitle", "time": 12289.67, "timestamp": "03:24:49", "text": "本？"}, {"type": "subtitle", "time": 12291.51, "timestamp": "03:24:51", "text": "君は日記帳を持っているから、"}, {"type": "subtitle", "time": 12298.87, "timestamp": "03:24:58", "text": "行く。"}]
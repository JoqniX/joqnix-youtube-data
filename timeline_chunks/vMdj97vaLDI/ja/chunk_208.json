[{"type": "subtitle", "time": 12481.59, "timestamp": "03:28:01", "text": "待って。使うべきでしょうか？"}, {"type": "subtitle", "time": 12484.229, "timestamp": "03:28:04", "text": "マッチ。えっと、どうやって点火するの？"}, {"type": "subtitle", "time": 12485.91, "timestamp": "03:28:05", "text": "これ？"}, {"type": "subtitle", "time": 12487.99, "timestamp": "03:28:07", "text": "えっと、点灯の仕方を調べてもいいですか？"}, {"type": "subtitle", "time": 12491.11, "timestamp": "03:28:11", "text": "ろうそく？私は探してみようと思います"}, {"type": "subtitle", "time": 12495.03, "timestamp": "03:28:15", "text": "ポンプのように。"}, {"type": "subtitle", "time": 12496.95, "timestamp": "03:28:16", "text": "わかりました、調べてみます。調べてみます"}, {"type": "subtitle", "time": 12499.83, "timestamp": "03:28:19", "text": "実は。"}, {"type": "subtitle", "time": 12505.469, "timestamp": "03:28:25", "text": "ろうそくに火をつける方法と、えーと"}, {"type": "subtitle", "time": 12507.75, "timestamp": "03:28:27", "text": "バスケットボール。えっと、あなたは"}, {"type": "subtitle", "time": 12511.83, "timestamp": "03:28:31", "text": "ライト。なんてこった。ライターがありません。"}, {"type": "subtitle", "time": 12514.309, "timestamp": "03:28:34", "text": "あなたはここにいますか？私たちには"}, {"type": "subtitle", "time": 12518.309, "timestamp": "03:28:38", "text": "ライター。ヴィック、ここにいるの？私たちはそうしません。"}, {"type": "subtitle", "time": 12521.389, "timestamp": "03:28:41", "text": "どこにいるの？いいえ、ありません"}, {"type": "subtitle", "time": 12523.83, "timestamp": "03:28:43", "text": "ライター。どうすればいいですか？"}, {"type": "subtitle", "time": 12525.11, "timestamp": "03:28:45", "text": "ライター。私たちはどうすべきでしょうか？何をすべきか"}, {"type": "subtitle", "time": 12527.51, "timestamp": "03:28:47", "text": "そうなんですか？私たちはどうすべきでしょうか？"}, {"type": "subtitle", "time": 12528.67, "timestamp": "03:28:48", "text": "私たちはそうしません。"}, {"type": "subtitle", "time": 12530.67, "timestamp": "03:28:50", "text": "ああ、行こう"}, {"type": "subtitle", "time": 12533.95, "timestamp": "03:28:53", "text": "外。おっと。ろうそくを持っていくべきでしょうか？"}, {"type": "subtitle", "time": 12537.67, "timestamp": "03:28:57", "text": "おっと。おっと。どういう意味ですか？あらら。"}]
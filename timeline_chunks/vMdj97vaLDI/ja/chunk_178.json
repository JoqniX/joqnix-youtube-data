[{"type": "subtitle", "time": 10684.349, "timestamp": "02:58:04", "text": "ええと、実は4つあります"}, {"type": "subtitle", "time": 10688.07, "timestamp": "02:58:08", "text": "懐中電灯。なぜ？"}, {"type": "subtitle", "time": 10691.11, "timestamp": "02:58:11", "text": "懐中電灯は4つあります。イエス。"}, {"type": "subtitle", "time": 10694.269, "timestamp": "02:58:14", "text": "それらを削除するにはどうすればよいですか？"}, {"type": "subtitle", "time": 10697.51, "timestamp": "02:58:17", "text": "ハァ。ハァ。これは"}, {"type": "subtitle", "time": 10713.91, "timestamp": "02:58:33", "text": "H こんにちは。えっと"}, {"type": "subtitle", "time": 10732.19, "timestamp": "02:58:52", "text": "わかった。 「こんにちは」と入力する必要があります。"}, {"type": "subtitle", "time": 10734.63, "timestamp": "02:58:54", "text": "こんにちは。こんにちは。こんにちは。こんにちは。こんにちは。"}, {"type": "subtitle", "time": 10738.309, "timestamp": "02:58:58", "text": "こんにちは。こんにちは。うーん、うーん、うーん。おい。おい。おい。"}]
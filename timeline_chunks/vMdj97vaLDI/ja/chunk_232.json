[{"type": "subtitle", "time": 13920.95, "timestamp": "03:52:00", "text": "私たちはこの場所のどこでも死ぬ可能性がある。"}, {"type": "subtitle", "time": 13923.349, "timestamp": "03:52:03", "text": "私は推測する。えっと、"}, {"type": "subtitle", "time": 13925.189, "timestamp": "03:52:05", "text": "これは注射のようなものですか？ああ、そう思った"}, {"type": "subtitle", "time": 13933.469, "timestamp": "03:52:13", "text": "階段。あなたは"}, {"type": "subtitle", "time": 13936.99, "timestamp": "03:52:16", "text": "ここ？どこに"}, {"type": "subtitle", "time": 13939.87, "timestamp": "03:52:19", "text": "あなた？どこに"}, {"type": "subtitle", "time": 13943.75, "timestamp": "03:52:23", "text": "あなた？ああ、階下ですね。"}, {"type": "subtitle", "time": 13947.51, "timestamp": "03:52:27", "text": "おい、この場所を見てみろよ。"}, {"type": "subtitle", "time": 13955.349, "timestamp": "03:52:35", "text": "誰か、えっと、これは何の儀式ですか？待って、"}, {"type": "subtitle", "time": 13957.59, "timestamp": "03:52:37", "text": "これはオジョですか？"}, {"type": "subtitle", "time": 13959.269, "timestamp": "03:52:39", "text": "触らないでください。あなたは憑依されるでしょう"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "幻影のクルーの犠牲。うわぁ。うわぁ。"}, {"type": "subtitle", "time": 13974.389, "timestamp": "03:52:54", "text": "おお。何てことだ。わかった。できますか"}]
[{"type": "subtitle", "time": 15363.229, "timestamp": "04:16:03", "text": "ちくしょう。もしかしたら幽霊かも"}, {"type": "subtitle", "time": 15367.349, "timestamp": "04:16:07", "text": "球体。ノーの方がはるかに危険だ。ウー。"}, {"type": "subtitle", "time": 15375.11, "timestamp": "04:16:15", "text": "私はミランを選びます。"}, {"type": "subtitle", "time": 15376.83, "timestamp": "04:16:16", "text": "うん、そうしよう"}, {"type": "subtitle", "time": 15380.63, "timestamp": "04:16:20", "text": "よし、行こう。ああ、神様。"}, {"type": "subtitle", "time": 15389.189, "timestamp": "04:16:29", "text": "私はしませんでした。ごめんね、ジャック。チャーリー、私は"}, {"type": "subtitle", "time": 15391.91, "timestamp": "04:16:31", "text": "あなたを置き去りにして。そうそう。大丈夫。"}, {"type": "subtitle", "time": 15393.99, "timestamp": "04:16:33", "text": "私は実際にあなたの中にいて、あなたを見ています"}, {"type": "subtitle", "time": 15404.309, "timestamp": "04:16:44", "text": "[音楽]"}, {"type": "subtitle", "time": 15406.469, "timestamp": "04:16:46", "text": "シャクは今、あなたの中にいます。さあ行こう。ああ、それは"}, {"type": "subtitle", "time": 15408.95, "timestamp": "04:16:48", "text": "模倣だった。はい、骨は取りました"}, {"type": "subtitle", "time": 15412.55, "timestamp": "04:16:52", "text": "証拠。おお、いいね。少なくとも私たちは"}]
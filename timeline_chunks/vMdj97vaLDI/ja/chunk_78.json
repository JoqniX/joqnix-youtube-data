[{"type": "subtitle", "time": 4680.709, "timestamp": "01:18:00", "text": "行きたい場所へ行き、ただ通り過ぎるだけ"}, {"type": "subtitle", "time": 4683.669, "timestamp": "01:18:03", "text": "地下鉄に乗ると、路線が見えてきます。"}, {"type": "subtitle", "time": 4685.91, "timestamp": "01:18:05", "text": "すると、あなたはただ歩いて行き、そしてあなたは"}, {"type": "subtitle", "time": 4687.99, "timestamp": "01:18:07", "text": "そこに置いておく。わかった。だからとても簡単です"}, {"type": "subtitle", "time": 4689.59, "timestamp": "01:18:09", "text": "私は地元の文化に触れて育ったわけではないので"}, {"type": "subtitle", "time": 4690.95, "timestamp": "01:18:10", "text": "トレンド。だから私はまだ理解できない"}, {"type": "subtitle", "time": 4693.189, "timestamp": "01:18:13", "text": "ローカルトレンドなども含めて、もし私が理解できれば"}, {"type": "subtitle", "time": 4695.43, "timestamp": "01:18:15", "text": "外に出れば簡単にわかるでしょう。あなた"}, {"type": "subtitle", "time": 4697.03, "timestamp": "01:18:17", "text": "心配する必要はありません。そうです"}, {"type": "subtitle", "time": 4699.03, "timestamp": "01:18:19", "text": "複雑そうに見えるけど、一度やれば"}, {"type": "subtitle", "time": 4701.51, "timestamp": "01:18:21", "text": "慣れるまでには1日かかるでしょう。そして"}, {"type": "subtitle", "time": 4704.31, "timestamp": "01:18:24", "text": "カードももらえます。カードを手に入れましょう。それ"}, {"type": "subtitle", "time": 4707.03, "timestamp": "01:18:27", "text": "費用は500円でした。私はそれを持っていると思います"}, {"type": "subtitle", "time": 4709.189, "timestamp": "01:18:29", "text": "今、カードを持っています。あなたは費用を負担します"}, {"type": "subtitle", "time": 4711.83, "timestamp": "01:18:31", "text": "あなたは500円。また、次のようにすることもできます。"}, {"type": "chat", "time": 4712.174, "timestamp": "01:18:32", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "am back"}, {"type": "subtitle", "time": 4714.55, "timestamp": "01:18:34", "text": "そこにお金を入れる、例えば5000円入れて"}, {"type": "subtitle", "time": 4716.79, "timestamp": "01:18:36", "text": "そのカードは買い物にも使えます"}, {"type": "subtitle", "time": 4718.709, "timestamp": "01:18:38", "text": "自動販売機から、または"}, {"type": "subtitle", "time": 4720.709, "timestamp": "01:18:40", "text": "他の会社と同じように購入できます。だからそれは"}, {"type": "chat", "time": 4721.1, "timestamp": "01:18:41", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "hi orange"}, {"type": "subtitle", "time": 4723.11, "timestamp": "01:18:43", "text": "ATMのようなものですが、ATMではありません。"}, {"type": "subtitle", "time": 4724.63, "timestamp": "01:18:44", "text": "撤回する。お金を入れるだけで"}, {"type": "subtitle", "time": 4726.87, "timestamp": "01:18:46", "text": "それ。だから、複雑なことではないんです。心配しないで"}, {"type": "subtitle", "time": 4728.709, "timestamp": "01:18:48", "text": "もし私が考えれば、人々に伝えることは"}, {"type": "subtitle", "time": 4730.229, "timestamp": "01:18:50", "text": "私にはわかる、あなたにもわかる"}, {"type": "chat", "time": 4731.574, "timestamp": "01:18:51", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "get the blue eyes white dragon card"}, {"type": "subtitle", "time": 4732.31, "timestamp": "01:18:52", "text": "外。"}, {"type": "subtitle", "time": 4733.95, "timestamp": "01:18:53", "text": "私は"}, {"type": "chat", "time": 4736.118, "timestamp": "01:18:56", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "heyoo pravin"}, {"type": "subtitle", "time": 4736.55, "timestamp": "01:18:56", "text": "ごめん、もし君たちがそう思わないなら"}, {"type": "subtitle", "time": 4738.709, "timestamp": "01:18:58", "text": "私はとても不安です"}]
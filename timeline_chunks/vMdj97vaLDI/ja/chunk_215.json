[{"type": "subtitle", "time": 12908.229, "timestamp": "03:35:08", "text": "わかった。わあ、すごい。私たちは実際に生き延びました"}, {"type": "subtitle", "time": 12911.269, "timestamp": "03:35:11", "text": "大きな幽霊が出る。それは幻ではない、なぜなら"}, {"type": "subtitle", "time": 12913.91, "timestamp": "03:35:13", "text": "ファントムでさえ10まで上がらない。だから"}, {"type": "subtitle", "time": 12916.389, "timestamp": "03:35:16", "text": "それは、待って、本当に私はああ、なんてことだ、私は"}, {"type": "subtitle", "time": 12918.03, "timestamp": "03:35:18", "text": "ああ、"}, {"type": "subtitle", "time": 12920.95, "timestamp": "03:35:20", "text": "神。ついに、幽霊の存在を示す証拠が見つかった。わかった、"}, {"type": "subtitle", "time": 12923.75, "timestamp": "03:35:23", "text": "幽霊の証拠を手に入れたというわけですね。ああ、"}, {"type": "subtitle", "time": 12928.55, "timestamp": "03:35:28", "text": "神。いやいやいや、いいよ。なんて生き物だ。"}, {"type": "subtitle", "time": 12930.75, "timestamp": "03:35:30", "text": "それは"}, {"type": "subtitle", "time": 12934.63, "timestamp": "03:35:34", "text": "[ __ ]。老人のように見えた"}, {"type": "subtitle", "time": 12938.15, "timestamp": "03:35:38", "text": "幽霊、ファン、そして、えっと、"}, {"type": "subtitle", "time": 12941.63, "timestamp": "03:35:41", "text": "侍っぽいものとか、何か"}, {"type": "subtitle", "time": 12944.269, "timestamp": "03:35:44", "text": "剣または"}, {"type": "subtitle", "time": 12951.19, "timestamp": "03:35:51", "text": "うん。ああ、それはいいですね。それはすばらしい。"}, {"type": "subtitle", "time": 12953.07, "timestamp": "03:35:53", "text": "私たちはビスケットを作るつもりです"}, {"type": "subtitle", "time": 12958.07, "timestamp": "03:35:58", "text": "これら。残念ながら、"}, {"type": "subtitle", "time": 12959.309, "timestamp": "03:35:59", "text": "美味しいものを食べる"}]
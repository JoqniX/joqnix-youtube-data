[{"type": "subtitle", "time": 429.909, "timestamp": "00:07:09", "text": "待つ？なぜ私は見たような気がするのだろうか"}, {"type": "subtitle", "time": 432.27, "timestamp": "00:07:12", "text": "彼らから"}, {"type": "subtitle", "time": 436.23, "timestamp": "00:07:16", "text": "どこかで？私はヒロシャン、レナンを知っています。"}, {"type": "subtitle", "time": 439.909, "timestamp": "00:07:19", "text": "アスカ、サマ、アネンダ、ヤマダサン。"}, {"type": "subtitle", "time": 442.95, "timestamp": "00:07:22", "text": "これらの人々全員、アイナもそうだと信じています"}, {"type": "subtitle", "time": 445.27, "timestamp": "00:07:25", "text": "これらはすべて同じものから来ていました"}, {"type": "subtitle", "time": 449.909, "timestamp": "00:07:29", "text": "VRの世界で私たちは出会い、私たちは"}, {"type": "subtitle", "time": 453.189, "timestamp": "00:07:33", "text": "たくさん話したし、"}, {"type": "subtitle", "time": 456.07, "timestamp": "00:07:36", "text": "みんなで積極的に会おう"}, {"type": "subtitle", "time": 458.469, "timestamp": "00:07:38", "text": "グループのように勉強熱心なグループのように"}, {"type": "subtitle", "time": 462.07, "timestamp": "00:07:42", "text": "セクションまたはセッションのようなもの"}, {"type": "subtitle", "time": 463.30899999999997, "timestamp": "00:07:43", "text": "私"}, {"type": "subtitle", "time": 466.15, "timestamp": "00:07:46", "text": "2週間連続で使ったと信じている"}, {"type": "subtitle", "time": 469.30899999999997, "timestamp": "00:07:49", "text": "こんなに活動的だけど、何が"}, {"type": "subtitle", "time": 473.029, "timestamp": "00:07:53", "text": "その後、起こった。それはただ、ねえ、何"}, {"type": "subtitle", "time": 474.99, "timestamp": "00:07:54", "text": "は"}, {"type": "subtitle", "time": 477.23, "timestamp": "00:07:57", "text": "この仮想"}]
[{"type": "subtitle", "time": 9480.95, "timestamp": "02:38:00", "text": "わかった。難易度を選択できません。なぜ？"}, {"type": "subtitle", "time": 9483.27, "timestamp": "02:38:03", "text": "おお。ああ、だって、私がリーダーになったのは"}, {"type": "subtitle", "time": 9485.23, "timestamp": "02:38:05", "text": "あなたは去った。"}, {"type": "subtitle", "time": 9488.389, "timestamp": "02:38:08", "text": "いいえ。私をリーダーにしてくれませんか？"}, {"type": "subtitle", "time": 9490.71, "timestamp": "02:38:10", "text": "わかった。私たちは作り直す必要があります 私たちは"}, {"type": "subtitle", "time": 9493.03, "timestamp": "02:38:13", "text": "No. No. Okay をリメイクします。わかった。それから"}, {"type": "subtitle", "time": 9495.19, "timestamp": "02:38:15", "text": "難易度はあなたが設定します。やろう"}, {"type": "subtitle", "time": 9496.469, "timestamp": "02:38:16", "text": "それ。"}, {"type": "subtitle", "time": 9500.79, "timestamp": "02:38:20", "text": "プロらしくやりましょう。さあ行こう。はぁ？"}, {"type": "subtitle", "time": 9504.55, "timestamp": "02:38:24", "text": "はい、プロとして活動しましょう。はぁ？"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "うん。なぜ？ウォーミングアップが必要です。はい、"}, {"type": "subtitle", "time": 9509.83, "timestamp": "02:38:29", "text": "ウォーミングアップをしましょうか。"}, {"type": "subtitle", "time": 9526.07, "timestamp": "02:38:46", "text": "懐中電灯が必要だ。強力なトーチではありません"}, {"type": "subtitle", "time": 9528.95, "timestamp": "02:38:48", "text": "ライト。"}, {"type": "subtitle", "time": 9531.51, "timestamp": "02:38:51", "text": "私と一緒にいてくれると約束して。わかった。する"}]
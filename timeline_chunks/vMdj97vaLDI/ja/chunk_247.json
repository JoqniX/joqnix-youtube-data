[{"type": "subtitle", "time": 14824.95, "timestamp": "04:07:04", "text": "エモ。よし、手に入れたぞ。それを受け取ります。私たちは"}, {"type": "subtitle", "time": 14828.469, "timestamp": "04:07:08", "text": "エミッターを持っている。私たちはスピリットボックスを持っています。"}, {"type": "subtitle", "time": 14830.229, "timestamp": "04:07:10", "text": "ジョン、懐中電灯はいらないの？あなた"}, {"type": "subtitle", "time": 14832.71, "timestamp": "04:07:12", "text": "本当にそう思いますか？写真を撮って"}, {"type": "subtitle", "time": 14845.03, "timestamp": "04:07:25", "text": "幽霊を見つけるまで家に帰らない"}, {"type": "subtitle", "time": 14856.55, "timestamp": "04:07:36", "text": "神。なぜこの場所は急に安くなったのか"}, {"type": "subtitle", "time": 14859.71, "timestamp": "04:07:39", "text": "ポリ？ところで、"}, {"type": "subtitle", "time": 14862.389, "timestamp": "04:07:42", "text": "みんな大丈夫、私は一人で行くつもりです"}, {"type": "subtitle", "time": 14865.07, "timestamp": "04:07:45", "text": "1秒。もし"}, {"type": "subtitle", "time": 14867.79, "timestamp": "04:07:47", "text": "あなたは"}, {"type": "subtitle", "time": 14874.63, "timestamp": "04:07:54", "text": "あなた？わかった。"}, {"type": "subtitle", "time": 14876.07, "timestamp": "04:07:56", "text": "何もない。私は全行程をスピードランしています"}, {"type": "subtitle", "time": 14878.389, "timestamp": "04:07:58", "text": "場所。わかった。"}]
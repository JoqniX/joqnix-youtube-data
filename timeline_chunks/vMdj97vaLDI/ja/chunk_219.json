[{"type": "subtitle", "time": 13140.469, "timestamp": "03:39:00", "text": "悪夢へ行け。悪夢の世界へ行こう。誰が"}, {"type": "subtitle", "time": 13142.15, "timestamp": "03:39:02", "text": "気にする？まるで私たちが死につつあるように"}, {"type": "subtitle", "time": 13145.19, "timestamp": "03:39:05", "text": "とにかく2番目だ。私にはわからない。その"}, {"type": "subtitle", "time": 13147.91, "timestamp": "03:39:07", "text": "少なくとも面白いだろう。"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "どの地図に行きたいですか？"}, {"type": "subtitle", "time": 13154.03, "timestamp": "03:39:14", "text": "この農場に行こう"}, {"type": "subtitle", "time": 13161.03, "timestamp": "03:39:21", "text": "わかった。では、何を改めて購入する必要がありますか？"}, {"type": "subtitle", "time": 13162.55, "timestamp": "03:39:22", "text": "ライター。"}, {"type": "subtitle", "time": 13164.15, "timestamp": "03:39:24", "text": "いや、いや、いや。買いました。買いました。私"}, {"type": "subtitle", "time": 13166.309, "timestamp": "03:39:26", "text": "買いました。何もするな。わかった。私は"}, {"type": "subtitle", "time": 13168.71, "timestamp": "03:39:28", "text": "他に何か購入する必要はありますか？"}, {"type": "subtitle", "time": 13171.429, "timestamp": "03:39:31", "text": "わからない。マイクを買うことはできますか？"}, {"type": "subtitle", "time": 13175.269, "timestamp": "03:39:35", "text": "まるでそのように"}, {"type": "subtitle", "time": 13179.19, "timestamp": "03:39:39", "text": "えっと、温度計のことですか？購入できますか"}, {"type": "subtitle", "time": 13182.469, "timestamp": "03:39:42", "text": "体温計をいただけますか？温度計。"}, {"type": "subtitle", "time": 13185.83, "timestamp": "03:39:45", "text": "まだロックを解除していません。あ、待って。何が"}, {"type": "subtitle", "time": 13187.79, "timestamp": "03:39:47", "text": "はい、わかりました。わかった。手に入れた"}, {"type": "subtitle", "time": 13194.309, "timestamp": "03:39:54", "text": "あ、待って。私にさせてください、そして、しないでください"}, {"type": "subtitle", "time": 13196.309, "timestamp": "03:39:56", "text": "汚れを落とさせてください"}, {"type": "subtitle", "time": 13199.59, "timestamp": "03:39:59", "text": "スティック。うん、スマッジスティックには入らないでね"}]
[{"type": "subtitle", "time": 6840.629, "timestamp": "01:54:00", "text": "おすすめのものは何ですか？"}, {"type": "subtitle", "time": 6842.629, "timestamp": "01:54:02", "text": "あり得るだろうか？行くなら何をおすすめしますか？"}, {"type": "subtitle", "time": 6846.229, "timestamp": "01:54:06", "text": "えーと、私ができる唯一のことは"}, {"type": "subtitle", "time": 6848.31, "timestamp": "01:54:08", "text": "旅行するならおすすめは"}, {"type": "subtitle", "time": 6849.75, "timestamp": "01:54:09", "text": "もしあなたがそこに行きたいとしたら"}, {"type": "chat", "time": 6851.101, "timestamp": "01:54:11", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "so for 1 week fun in japan i have to sell my grandparents land?"}, {"type": "subtitle", "time": 6852.39, "timestamp": "01:54:12", "text": "大阪についてはもう話したけど、えっと"}, {"type": "subtitle", "time": 6856.87, "timestamp": "01:54:16", "text": "大阪と京都でできることは"}, {"type": "subtitle", "time": 6859.189, "timestamp": "01:54:19", "text": "東京に行くなら、"}, {"type": "subtitle", "time": 6860.87, "timestamp": "01:54:20", "text": "東京に行く東京の男、なぜなら私は見たから"}, {"type": "subtitle", "time": 6862.31, "timestamp": "01:54:22", "text": "その間違いを犯している多くの人が"}, {"type": "subtitle", "time": 6865.589, "timestamp": "01:54:25", "text": "東京メインとか新宿とかカラジュクとか"}, {"type": "subtitle", "time": 6868.39, "timestamp": "01:54:28", "text": "東京駅からの行き先"}, {"type": "subtitle", "time": 6870.31, "timestamp": "01:54:30", "text": "東京から少し離れたところ"}, {"type": "subtitle", "time": 6872.229, "timestamp": "01:54:32", "text": "いちわ千葉は本当に良いです。"}, {"type": "subtitle", "time": 6875.03, "timestamp": "01:54:35", "text": "千葉県は東京都に近い。だからもし"}, {"type": "subtitle", "time": 6878.149, "timestamp": "01:54:38", "text": "千葉に行けば、"}, {"type": "subtitle", "time": 6881.91, "timestamp": "01:54:41", "text": "えっと、ホームルームなど、何でも予約できます"}, {"type": "subtitle", "time": 6884.87, "timestamp": "01:54:44", "text": "ダートチップのようにして、それから何でも予約する"}, {"type": "subtitle", "time": 6886.03, "timestamp": "01:54:46", "text": "例えば、一人旅をする場合"}, {"type": "subtitle", "time": 6888.07, "timestamp": "01:54:48", "text": "特に、そして、"}, {"type": "subtitle", "time": 6890.47, "timestamp": "01:54:50", "text": "booking.comで予約するか、上野に泊まるか何か"}, {"type": "subtitle", "time": 6892.229, "timestamp": "01:54:52", "text": "なぜなら、それらは観光地ではないからです"}, {"type": "subtitle", "time": 6894.149, "timestamp": "01:54:54", "text": "だからこそ、とても安いのです"}, {"type": "subtitle", "time": 6897.75, "timestamp": "01:54:57", "text": "あなたのために、そしてそこからあなたは"}]
[{"type": "subtitle", "time": 6301.87, "timestamp": "01:45:01", "text": "会話全体を"}, {"type": "subtitle", "time": 6304.95, "timestamp": "01:45:04", "text": "アニメアニメみたいなもの。持ってきていただければ"}, {"type": "subtitle", "time": 6306.629, "timestamp": "01:45:06", "text": "会話から抜け出すが、あまり"}, {"type": "subtitle", "time": 6309.109, "timestamp": "01:45:09", "text": "ああ、なんてことだ、何人かの人を見た"}, {"type": "subtitle", "time": 6312.07, "timestamp": "01:45:12", "text": "アニメイベントのように"}, {"type": "subtitle", "time": 6316.149, "timestamp": "01:45:16", "text": "アニメにとても似ていて、彼らは"}, {"type": "subtitle", "time": 6318.149, "timestamp": "01:45:18", "text": "アニメとかそういうのが好きな人もいる"}, {"type": "subtitle", "time": 6321.59, "timestamp": "01:45:21", "text": "それで彼らはそれをしないし私は"}, {"type": "subtitle", "time": 6323.59, "timestamp": "01:45:23", "text": "人々はそうしないように、"}, {"type": "subtitle", "time": 6325.109, "timestamp": "01:45:25", "text": "彼らはそれを軽蔑しないのは"}, {"type": "subtitle", "time": 6328.39, "timestamp": "01:45:28", "text": "アニメ文化は、とても"}, {"type": "subtitle", "time": 6331.99, "timestamp": "01:45:31", "text": "彼らの市場は、アニメーションでご覧になるとおりです"}, {"type": "subtitle", "time": 6333.91, "timestamp": "01:45:33", "text": "広告はどこにでもあるだろう"}, {"type": "subtitle", "time": 6335.59, "timestamp": "01:45:35", "text": "アニメ。すべては彼らが作るものになるでしょう"}, {"type": "subtitle", "time": 6338.229, "timestamp": "01:45:38", "text": "アニメっぽいものすべて。だからそうではない"}, {"type": "subtitle", "time": 6340.95, "timestamp": "01:45:40", "text": "見下される。それはむしろあなたが"}, {"type": "subtitle", "time": 6344.43, "timestamp": "01:45:44", "text": "見せびらかしすぎると、彼らは"}, {"type": "subtitle", "time": 6347.91, "timestamp": "01:45:47", "text": "彼らが見るであろうように目を賭ける"}, {"type": "subtitle", "time": 6350.39, "timestamp": "01:45:50", "text": "あなたに向かって。はぁ？そして、もしあなたが着ているなら"}, {"type": "subtitle", "time": 6352.39, "timestamp": "01:45:52", "text": "コスプレ衣装みたいに、それから行く"}, {"type": "subtitle", "time": 6353.91, "timestamp": "01:45:53", "text": "地下鉄周辺では、当然人々は"}, {"type": "subtitle", "time": 6354.91, "timestamp": "01:45:54", "text": "なれ"}, {"type": "subtitle", "time": 6357.59, "timestamp": "01:45:57", "text": "そして、問題は彼らが"}]
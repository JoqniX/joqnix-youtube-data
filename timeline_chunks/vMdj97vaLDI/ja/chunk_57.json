[{"type": "subtitle", "time": 3420.309, "timestamp": "00:57:00", "text": "幻滅。ああ。ああ。だから、彼らは"}, {"type": "subtitle", "time": 3422.309, "timestamp": "00:57:02", "text": "彼らは何らかの期待を抱いていて、"}, {"type": "subtitle", "time": 3423.91, "timestamp": "00:57:03", "text": "すると突然、彼らは"}, {"type": "subtitle", "time": 3425.91, "timestamp": "00:57:05", "text": "経験のおかげで、今では"}, {"type": "subtitle", "time": 3429.589, "timestamp": "00:57:09", "text": "彼らはこれを気に入るだろう、彼らはこれを覚えているだろう"}, {"type": "subtitle", "time": 3432.309, "timestamp": "00:57:12", "text": "永遠に続くようなもの。"}, {"type": "subtitle", "time": 3433.75, "timestamp": "00:57:13", "text": "何かわからない。だから私は"}, {"type": "subtitle", "time": 3435.349, "timestamp": "00:57:15", "text": "必ず事前に警告するようにしてください。"}, {"type": "subtitle", "time": 3439.19, "timestamp": "00:57:19", "text": "あなたはどんな困難にも立ち向かうでしょう。うん。"}, {"type": "subtitle", "time": 3441.44, "timestamp": "00:57:21", "text": "うん。 あまりにも"}, {"type": "subtitle", "time": 3442.28, "timestamp": "00:57:22", "text": "あまりにも 戦闘中は特にそうだった。"}, {"type": "subtitle", "time": 3445.92, "timestamp": "00:57:25", "text": "戦闘中は特にそうだった。 そうそう。お前みたいなクソ野郎に晒されてるんだぞ。"}, {"type": "subtitle", "time": 3457.51, "timestamp": "00:57:37", "text": "ほら、心配しなくていいよ。もし誰かが"}, {"type": "subtitle", "time": 3459.27, "timestamp": "00:57:39", "text": "誰かがあなたにクソみたいなことを言ったら、私は"}, {"type": "subtitle", "time": 3461.349, "timestamp": "00:57:41", "text": "精神的にそこにいるか、私は黒くなるだろう"}, {"type": "subtitle", "time": 3464.15, "timestamp": "00:57:44", "text": "彼らには魔法がかかっている。"}, {"type": "subtitle", "time": 3472.069, "timestamp": "00:57:52", "text": "[音楽]"}, {"type": "subtitle", "time": 3474.87, "timestamp": "00:57:54", "text": "彼らは実際とても親切です。 M. 何ですか"}]
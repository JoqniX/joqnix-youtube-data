[{"type": "subtitle", "time": 10142.95, "timestamp": "02:49:02", "text": "中。そして、チェックする必要がある"}, {"type": "subtitle", "time": 10146.469, "timestamp": "02:49:06", "text": "現在の気温。わかった。ラジオ。えっと"}, {"type": "subtitle", "time": 10149.03, "timestamp": "02:49:09", "text": "わかった、ジャック、"}, {"type": "subtitle", "time": 10150.79, "timestamp": "02:49:10", "text": "機械。体温計を持って行きます"}, {"type": "subtitle", "time": 10153.269, "timestamp": "02:49:13", "text": "なぜなら、私たちにはこれが必要だからだ。"}, {"type": "subtitle", "time": 10158.469, "timestamp": "02:49:18", "text": "ああ、神様。なんてこった。 3.5 3.3 38 4.2"}, {"type": "subtitle", "time": 10160.87, "timestamp": "02:49:20", "text": "氷点下の気温。"}, {"type": "subtitle", "time": 10163.51, "timestamp": "02:49:23", "text": "ああ、そういう意味ですか？わかった、私は"}, {"type": "subtitle", "time": 10172.95, "timestamp": "02:49:32", "text": "あらら。 2度。 2度。"}, {"type": "subtitle", "time": 10179.309, "timestamp": "02:49:39", "text": "それは何ですか？二"}, {"type": "subtitle", "time": 10181.23, "timestamp": "02:49:41", "text": "度。二"}, {"type": "subtitle", "time": 10184.79, "timestamp": "02:49:44", "text": "度。あなたはここにいますか？"}, {"type": "subtitle", "time": 10186.429, "timestamp": "02:49:46", "text": "何も"}, {"type": "subtitle", "time": 10190.95, "timestamp": "02:49:50", "text": "実際はエミナです。"}, {"type": "subtitle", "time": 10193.63, "timestamp": "02:49:53", "text": "わかった。わかった。の"}]
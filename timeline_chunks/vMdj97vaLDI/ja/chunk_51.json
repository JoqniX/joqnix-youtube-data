[{"type": "chat", "time": 3063.793, "timestamp": "00:51:03", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "gawd"}, {"type": "subtitle", "time": 3065.43, "timestamp": "00:51:05", "text": "大丈夫。"}, {"type": "subtitle", "time": 3072.79, "timestamp": "00:51:12", "text": "わかった。それが現実さ。ええ、それが"}, {"type": "chat", "time": 3075.752, "timestamp": "00:51:15", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "We are worse then monkeys😭"}, {"type": "subtitle", "time": 3076.39, "timestamp": "00:51:16", "text": "ああ、実際はいい感じだよ。"}, {"type": "subtitle", "time": 3079.829, "timestamp": "00:51:19", "text": "写真を撮らせてください。こんにちは。私は"}, {"type": "subtitle", "time": 3083.67, "timestamp": "00:51:23", "text": "食べ物の写真。ああ。"}, {"type": "subtitle", "time": 3086.47, "timestamp": "00:51:26", "text": "お風呂に入っている時に悲しむべきだった"}, {"type": "chat", "time": 3087.639, "timestamp": "00:51:27", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "that's a great combo"}, {"type": "subtitle", "time": 3089.27, "timestamp": "00:51:29", "text": "誰かがお風呂に入った。うん、そうするべきだよ"}, {"type": "subtitle", "time": 3090.549, "timestamp": "00:51:30", "text": "必ず食べ物の写真を撮ってください"}, {"type": "subtitle", "time": 3092.15, "timestamp": "00:51:32", "text": "特に屋外で食事をしているとき"}, {"type": "subtitle", "time": 3093.91, "timestamp": "00:51:33", "text": "レストランなどの屋外や"}, {"type": "subtitle", "time": 3095.03, "timestamp": "00:51:35", "text": "何か。彼らは"}, {"type": "subtitle", "time": 3097.03, "timestamp": "00:51:37", "text": "猿。ああ、神様、"}, {"type": "subtitle", "time": 3099.43, "timestamp": "00:51:39", "text": "猿。猿はスマッシュが好きです。彼らです"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "ハンサム。美味しいですよ。さらに彼らは"}, {"type": "subtitle", "time": 3103.91, "timestamp": "00:51:43", "text": "彼らはとても賢い。"}, {"type": "subtitle", "time": 3109.75, "timestamp": "00:51:49", "text": "だから私はいつもあなたに"}, {"type": "subtitle", "time": 3111.589, "timestamp": "00:51:51", "text": "外で食事をする時はいつでも、その光景を思い浮かべてください。いつも"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "写真を撮る。なぜだか分かる？もしも"}, {"type": "subtitle", "time": 3115.19, "timestamp": "00:51:55", "text": "間違った注文が届いたり、"}, {"type": "subtitle", "time": 3117.03, "timestamp": "00:51:57", "text": "卵は2個もらえるはずだったけど"}, {"type": "subtitle", "time": 3118.87, "timestamp": "00:51:58", "text": "卵を1つ手に入れて、その後"}]
[{"type": "subtitle", "time": 14223.75, "timestamp": "03:57:03", "text": "写真を撮ってくれよ、兄弟。私たちには必要な"}, {"type": "subtitle", "time": 14228.229, "timestamp": "03:57:08", "text": "もっと写真を撮る必要がある。"}, {"type": "subtitle", "time": 14230.309, "timestamp": "03:57:10", "text": "はい。"}, {"type": "subtitle", "time": 14233.03, "timestamp": "03:57:13", "text": "はい、彼は幽霊でした。名前は"}, {"type": "subtitle", "time": 14236.03, "timestamp": "03:57:16", "text": "オバカ。それで"}, {"type": "subtitle", "time": 14238.51, "timestamp": "03:57:18", "text": "オバカ"}, {"type": "subtitle", "time": 14247.51, "timestamp": "03:57:27", "text": "ああ、お前は私を殺そうとしている、左へ"}, {"type": "subtitle", "time": 14250.95, "timestamp": "03:57:30", "text": "右。一体どうしたんだ？"}, {"type": "subtitle", "time": 14253.03, "timestamp": "03:57:33", "text": "その通り。"}, {"type": "subtitle", "time": 14255.87, "timestamp": "03:57:35", "text": "私たちは何を受け取るべきなのでしょうか？私は何者だったのか"}, {"type": "subtitle", "time": 14259.03, "timestamp": "03:57:39", "text": "オーケー。私が夢中になっているものは何だろう？私"}, {"type": "subtitle", "time": 14259.95, "timestamp": "03:57:39", "text": "しないで"}, {"type": "subtitle", "time": 14262.87, "timestamp": "03:57:42", "text": "知る。待って、あれは何？通常それは"}, {"type": "subtitle", "time": 14265.11, "timestamp": "03:57:45", "text": "バカなことに、何かを持っていくように書いてある"}, {"type": "subtitle", "time": 14268.07, "timestamp": "03:57:48", "text": "パラボラ型マイクか何か。"}, {"type": "subtitle", "time": 14270.79, "timestamp": "03:57:50", "text": "うん。ああ、ああ、いや。いいえ。ロック解除していません"}, {"type": "subtitle", "time": 14273.349, "timestamp": "03:57:53", "text": "これ。ああ、気にしないで。"}, {"type": "subtitle", "time": 14276.229, "timestamp": "03:57:56", "text": "ああ、だからあなたにたくさん質問していたんですね。"}, {"type": "subtitle", "time": 14278.07, "timestamp": "03:57:58", "text": "いや、いや、いや。私はそれを解除していません。私はしませんでした"}, {"type": "subtitle", "time": 14279.83, "timestamp": "03:57:59", "text": "ロックを解除してください。どうでも。どうでも。私は"}]
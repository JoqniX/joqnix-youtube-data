[{"type": "subtitle", "time": 8642.55, "timestamp": "02:24:02", "text": "やっていることは、ショート動画を投稿することです。そうそう。うん、"}, {"type": "subtitle", "time": 8645.11, "timestamp": "02:24:05", "text": "見たよ。とても楽しかった。私は死を見た"}, {"type": "subtitle", "time": 8647.27, "timestamp": "02:24:07", "text": "1つ目をマッチする。いや、それほど楽しいものではなかった。"}, {"type": "subtitle", "time": 8649.99, "timestamp": "02:24:09", "text": "でも、あなたがどこに行くかはあなたを怖がらせたりします。"}, {"type": "subtitle", "time": 8652.79, "timestamp": "02:24:12", "text": "えっと、何て言うんだっけ"}, {"type": "subtitle", "time": 8655.349, "timestamp": "02:24:15", "text": "それ？牡羊座はピューピューピューピューが好きです。"}, {"type": "subtitle", "time": 8659.11, "timestamp": "02:24:19", "text": "それです。ええ、楽しかったです。"}, {"type": "subtitle", "time": 8662.63, "timestamp": "02:24:22", "text": "うん、新しいのを手に入れたみたいに2つ投稿したよ"}, {"type": "subtitle", "time": 8663.469, "timestamp": "02:24:23", "text": "過去"}, {"type": "subtitle", "time": 8665.429, "timestamp": "02:24:25", "text": "そこにはプラズマ恐怖症に関するものがある。あなたがすべき"}, {"type": "subtitle", "time": 8667.87, "timestamp": "02:24:27", "text": "見てみて。すごく面白い。私は実際に"}, {"type": "subtitle", "time": 8670.07, "timestamp": "02:24:30", "text": "編集済み。ところで、新年おめでとうございます。"}, {"type": "subtitle", "time": 8672.87, "timestamp": "02:24:32", "text": "あけましておめでとう。ありがとう。新年おめでとう"}, {"type": "subtitle", "time": 8676.389, "timestamp": "02:24:36", "text": "あなたにも良い年になりますように。うん。"}, {"type": "subtitle", "time": 8678.71, "timestamp": "02:24:38", "text": "ああ、明けましておめでとうございます。言い忘れた"}, {"type": "subtitle", "time": 8681.51, "timestamp": "02:24:41", "text": "またそれだ。"}, {"type": "subtitle", "time": 8683.03, "timestamp": "02:24:43", "text": "あけましておめでとう。必要ないと思います"}, {"type": "subtitle", "time": 8684.87, "timestamp": "02:24:44", "text": "知っておくために、そう言うのは、私たちが"}, {"type": "subtitle", "time": 8687.27, "timestamp": "02:24:47", "text": "大声で叫んだ"}, {"type": "subtitle", "time": 8689.75, "timestamp": "02:24:49", "text": "夜中。だから、私は"}, {"type": "subtitle", "time": 8693.429, "timestamp": "02:24:53", "text": "読む必要はないと思います。"}, {"type": "subtitle", "time": 8695.59, "timestamp": "02:24:55", "text": "私たちは大声で叫び、"}, {"type": "subtitle", "time": 8697.349, "timestamp": "02:24:57", "text": "私たちは声を張り上げて叫ぶつもりです"}, {"type": "subtitle", "time": 8699.99, "timestamp": "02:24:59", "text": "今、肺が。ええ、そういうことです。"}]
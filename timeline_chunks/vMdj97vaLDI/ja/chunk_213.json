[{"type": "subtitle", "time": 12780.63, "timestamp": "03:33:00", "text": "あ、私が写真を撮ったんです。私は"}, {"type": "subtitle", "time": 12783.51, "timestamp": "03:33:03", "text": "写真。ああ、ああ、あなたが写真を撮ったんですね。"}, {"type": "subtitle", "time": 12785.349, "timestamp": "03:33:05", "text": "お願いします。走って、走って、走って、走って、走って"}, {"type": "subtitle", "time": 12787.349, "timestamp": "03:33:07", "text": "外。中に駆け込んで。外へ走れ。走る"}, {"type": "subtitle", "time": 12789.03, "timestamp": "03:33:09", "text": "外。外へ走れ。走れ、走れ、走れ、"}, {"type": "subtitle", "time": 12791.59, "timestamp": "03:33:11", "text": "走る。大丈夫です。大丈夫です。大丈夫です。彼"}, {"type": "subtitle", "time": 12793.59, "timestamp": "03:33:13", "text": "死ななかったよね？彼は殺さなかった"}, {"type": "subtitle", "time": 12796.469, "timestamp": "03:33:16", "text": "自分。それは戦士のような感じだ。その"}, {"type": "subtitle", "time": 12800.83, "timestamp": "03:33:20", "text": "戦士っぽい感じ。その"}, {"type": "subtitle", "time": 12805.11, "timestamp": "03:33:25", "text": "かっこいい。私たちは死んでいない。"}, {"type": "subtitle", "time": 12807.67, "timestamp": "03:33:27", "text": "私たちは死んでいない。はい。さあ行こう。はい、"}, {"type": "subtitle", "time": 12810.71, "timestamp": "03:33:30", "text": "ジャック。私たちはまだ何も分かっていません"}, {"type": "subtitle", "time": 12815.11, "timestamp": "03:33:35", "text": "ちなみに、何でもいいですよ。それについてですが。"}, {"type": "subtitle", "time": 12817.349, "timestamp": "03:33:37", "text": "何てことだ。よし、見てみよう。見てみましょう。"}, {"type": "subtitle", "time": 12820.71, "timestamp": "03:33:40", "text": "見てみましょう。暴力的な行為ではなかった。"}, {"type": "subtitle", "time": 12824.229, "timestamp": "03:33:44", "text": "暴力的な行為ではなかった。わかった。電磁界。そうではなかった"}, {"type": "subtitle", "time": 12826.95, "timestamp": "03:33:46", "text": "ちなみに、それはピーク時の電磁界値ではありませんでした。それ"}, {"type": "subtitle", "time": 12829.59, "timestamp": "03:33:49", "text": "スピリットボックスは持っていなかったが、"}, {"type": "subtitle", "time": 12832.229, "timestamp": "03:33:52", "text": "心に残る。心に残る。幽霊ですか？"}, {"type": "subtitle", "time": 12833.83, "timestamp": "03:33:53", "text": "書き込み？待って、待って、待って。私たちはする必要があります"}, {"type": "subtitle", "time": 12838.389, "timestamp": "03:33:58", "text": "本を確認してください。なんてこった。そして私はできない"}]
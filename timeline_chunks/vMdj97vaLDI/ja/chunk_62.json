[{"type": "subtitle", "time": 3722.39, "timestamp": "01:02:02", "text": "野蛮なパン。えっと、刺身を試してみました。私"}, {"type": "subtitle", "time": 3727.75, "timestamp": "01:02:07", "text": "京都で食べた甲斐のある生鶏が好きだった。それで、"}, {"type": "subtitle", "time": 3729.39, "timestamp": "01:02:09", "text": "それで"}, {"type": "subtitle", "time": 3731.87, "timestamp": "01:02:11", "text": "えっと、心配しなくていいよ"}, {"type": "subtitle", "time": 3733.829, "timestamp": "01:02:13", "text": "サラーム。心配する必要はありません"}, {"type": "subtitle", "time": 3736.15, "timestamp": "01:02:16", "text": "どれも本当に新鮮に作られている。"}, {"type": "subtitle", "time": 3737.75, "timestamp": "01:02:17", "text": "食べないことをお勧めしますが"}, {"type": "subtitle", "time": 3741.27, "timestamp": "01:02:21", "text": "コンビニで売っている生魚が多すぎる。"}, {"type": "subtitle", "time": 3742.39, "timestamp": "01:02:22", "text": "でも、食べるなら食べなさい"}, {"type": "subtitle", "time": 3743.99, "timestamp": "01:02:23", "text": "どこか良いレストランで"}, {"type": "subtitle", "time": 3746.789, "timestamp": "01:02:26", "text": "彼らは本当に美味しい食べ物を持っています"}, {"type": "subtitle", "time": 3748.63, "timestamp": "01:02:28", "text": "特に生魚。それらは本当に"}, {"type": "subtitle", "time": 3750.309, "timestamp": "01:02:30", "text": "本当に良い。あなたはベジタリアンですか、それとも"}, {"type": "subtitle", "time": 3754.15, "timestamp": "01:02:34", "text": "ベジタリアン？ええ、両方です。私は大丈夫です"}, {"type": "subtitle", "time": 3756.71, "timestamp": "01:02:36", "text": "食べられる限り、何でも食べる。えっと"}, {"type": "subtitle", "time": 3759.67, "timestamp": "01:02:39", "text": "ああ、生き延びるんだ。ええ、私はこだわりません。それで"}, {"type": "subtitle", "time": 3761.109, "timestamp": "01:02:41", "text": "大丈夫です。ああ、あなたはそうではない、あなたはそうではない"}, {"type": "subtitle", "time": 3762.87, "timestamp": "01:02:42", "text": "あなたはそうではないので、もし"}, {"type": "subtitle", "time": 3764.87, "timestamp": "01:02:44", "text": "あなたがベジタリアンなら、とても"}, {"type": "subtitle", "time": 3766.47, "timestamp": "01:02:46", "text": "あなたにとっては難しいでしょう。しかし、もしあなたが"}, {"type": "subtitle", "time": 3768.99, "timestamp": "01:02:48", "text": "ビーガンにとってはより困難になるでしょう"}, {"type": "subtitle", "time": 3771.51, "timestamp": "01:02:51", "text": "前回行ったとき、私は"}, {"type": "subtitle", "time": 3774.23, "timestamp": "01:02:54", "text": "ビーガンの友人は"}, {"type": "subtitle", "time": 3776.71, "timestamp": "01:02:56", "text": "彼女が食べ物を食べるとき、彼女が食べるとき"}, {"type": "subtitle", "time": 3779.27, "timestamp": "01:02:59", "text": "彼女が手に入れる非ヴィーガンのもの"}]
[{"type": "subtitle", "time": 10980.469, "timestamp": "03:03:00", "text": "超低遅延を実現。大丈夫です。その"}, {"type": "subtitle", "time": 10982.15, "timestamp": "03:03:02", "text": "大丈夫。そのため、"}, {"type": "subtitle", "time": 10984.07, "timestamp": "03:03:04", "text": "ストリーム。それが理由です。それが理由です。その"}, {"type": "subtitle", "time": 10986.79, "timestamp": "03:03:06", "text": "わかった。大丈夫。ああ、私が教えてあげるよ"}, {"type": "subtitle", "time": 10989.83, "timestamp": "03:03:09", "text": "それについては次の配信で話します。いいえ、あなたが教えた"}, {"type": "subtitle", "time": 10992.71, "timestamp": "03:03:12", "text": "私自身はそうするつもりだったのですが、全部忘れてしまいました。"}, {"type": "subtitle", "time": 10995.269, "timestamp": "03:03:15", "text": "ああ、気にしないで。うっかり忘れてた。"}, {"type": "subtitle", "time": 10998.15, "timestamp": "03:03:18", "text": "心配しないで。実際、あなたは私に教えてくれたんです。私"}, {"type": "subtitle", "time": 11000.55, "timestamp": "03:03:20", "text": "した。ああ、よかった。良い。ええ、そうでしたね。あなた"}, {"type": "subtitle", "time": 11002.79, "timestamp": "03:03:22", "text": "彼がそれら全てを教えてくれました。"}, {"type": "subtitle", "time": 11006.71, "timestamp": "03:03:26", "text": "はい、でも忘れていました"}, {"type": "subtitle", "time": 11008.63, "timestamp": "03:03:28", "text": "ともかく。うん。あなたはしたい あなたはしたい"}, {"type": "subtitle", "time": 11011.03, "timestamp": "03:03:31", "text": "行きたいの？うん。それでは始めましょう。さあ"}, {"type": "subtitle", "time": 11013.11, "timestamp": "03:03:33", "text": "始める。"}, {"type": "subtitle", "time": 11015.59, "timestamp": "03:03:35", "text": "ええ、全く分かりません。私は一度もプレイしたことがない"}, {"type": "subtitle", "time": 11019.51, "timestamp": "03:03:39", "text": "ちなみに、この地図のことです。"}, {"type": "subtitle", "time": 11022.71, "timestamp": "03:03:42", "text": "それで、あなたの音声は本当に素晴らしいです"}, {"type": "subtitle", "time": 11025.11, "timestamp": "03:03:45", "text": "一瞬。今はバランスが取れています"}, {"type": "subtitle", "time": 11028.389, "timestamp": "03:03:48", "text": "ストリーム。とても良い。"}, {"type": "subtitle", "time": 11029.91, "timestamp": "03:03:49", "text": "ニース。"}, {"type": "subtitle", "time": 11032.63, "timestamp": "03:03:52", "text": "我々には何があるだろうか？おお、いいね。"}, {"type": "subtitle", "time": 11036.309, "timestamp": "03:03:56", "text": "デフォルトの装備構成があります。わかった。私は"}, {"type": "subtitle", "time": 11037.91, "timestamp": "03:03:57", "text": "今回は時間をかけてみます。私は"}, {"type": "subtitle", "time": 11039.99, "timestamp": "03:03:59", "text": "カメラを持って行ってください。"}]
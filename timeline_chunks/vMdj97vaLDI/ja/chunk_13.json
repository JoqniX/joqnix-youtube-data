[{"type": "subtitle", "time": 799.75, "timestamp": "00:13:19", "text": "ああ、忘れてた。彼は～が得意でしたか？"}, {"type": "subtitle", "time": 802.47, "timestamp": "00:13:22", "text": "英語ですか？それとも英語以外ですか？忘れた。実は"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "座ることです。私"}, {"type": "subtitle", "time": 827.71, "timestamp": "00:13:47", "text": "彼は最善を尽くして修正しようとしていると信じています"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "多く。見逃した。"}]
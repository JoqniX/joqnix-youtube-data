[{"type": "subtitle", "time": 11460.87, "timestamp": "03:11:00", "text": "の上？続けて。何が起こっていますか？誰かが"}, {"type": "subtitle", "time": 11464.309, "timestamp": "03:11:04", "text": "心を開いて。ああ、なんてことだ、怖かったよ。"}, {"type": "subtitle", "time": 11465.83, "timestamp": "03:11:05", "text": "何？何？どうしたの？何"}, {"type": "subtitle", "time": 11467.91, "timestamp": "03:11:07", "text": "何が起こったのか？"}, {"type": "subtitle", "time": 11470.23, "timestamp": "03:11:10", "text": "私はただ叫んだ。"}, {"type": "subtitle", "time": 11471.67, "timestamp": "03:11:11", "text": "わかった、気にしないで。はい、どうぞお入りください。"}, {"type": "subtitle", "time": 11473.19, "timestamp": "03:11:13", "text": "私を捕まえられるよ。まだ幽霊が出るような感じではない。"}, {"type": "subtitle", "time": 11474.95, "timestamp": "03:11:14", "text": "続けて。"}, {"type": "subtitle", "time": 11477.03, "timestamp": "03:11:17", "text": "あなたが"}, {"type": "subtitle", "time": 11480.63, "timestamp": "03:11:20", "text": "そこにいるから、ただ家に帰るわけにはいかない。"}, {"type": "subtitle", "time": 11483.11, "timestamp": "03:11:23", "text": "わかった。わかった。わかった。わかった。わかった。私は思う"}, {"type": "subtitle", "time": 11486.15, "timestamp": "03:11:26", "text": "それはただ"}, {"type": "subtitle", "time": 11487.15, "timestamp": "03:11:27", "text": "凍りつく"}, {"type": "subtitle", "time": 11491.389, "timestamp": "03:11:31", "text": "気温。まったく、わからない。"}, {"type": "subtitle", "time": 11494.349, "timestamp": "03:11:34", "text": "再利用して移動"}, {"type": "subtitle", "time": 11498.71, "timestamp": "03:11:38", "text": "外。引っ越してもいいですか？わかった。"}, {"type": "subtitle", "time": 11500.79, "timestamp": "03:11:40", "text": "いいえ、ジャック。私たちはそうすべきではない"}, {"type": "subtitle", "time": 11505.11, "timestamp": "03:11:45", "text": "まだ引っ越していませんか。えっと"}]
[{"type": "subtitle", "time": 7380.79, "timestamp": "02:03:00", "text": "働きたいならコネクション"}, {"type": "subtitle", "time": 7385.229, "timestamp": "02:03:05", "text": "日本の会社が"}, {"type": "subtitle", "time": 7388.47, "timestamp": "02:03:08", "text": "準備して、準備して、わからない"}, {"type": "subtitle", "time": 7391.149, "timestamp": "02:03:11", "text": "命を犠牲にせよ"}, {"type": "chat", "time": 7394.196, "timestamp": "02:03:14", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I never seen a streamer do so much haircare before 0.0"}, {"type": "subtitle", "time": 7394.31, "timestamp": "02:03:14", "text": "うん。"}, {"type": "chat", "time": 7396.78, "timestamp": "02:03:16", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "having fun is also part of the trip"}, {"type": "subtitle", "time": 7399.39, "timestamp": "02:03:19", "text": "それでは、楽しい時間をお過ごしください。気をつけて。"}, {"type": "subtitle", "time": 7402.55, "timestamp": "02:03:22", "text": "はい。本日はありがとうございました。"}, {"type": "subtitle", "time": 7404.51, "timestamp": "02:03:24", "text": "ありがとう。私は"}, {"type": "subtitle", "time": 7406.669, "timestamp": "02:03:26", "text": "決してそうではない"}, {"type": "subtitle", "time": 7409.99, "timestamp": "02:03:29", "text": "私は、私は大丈夫だ、私はただ"}, {"type": "subtitle", "time": 7412.149, "timestamp": "02:03:32", "text": "お風呂に入ったので、私が"}, {"type": "subtitle", "time": 7413.589, "timestamp": "02:03:33", "text": "あなたと話している。だから私は髪をとかさなければならなかった"}, {"type": "subtitle", "time": 7415.669, "timestamp": "02:03:35", "text": "髪がそうでないととても"}, {"type": "subtitle", "time": 7417.75, "timestamp": "02:03:37", "text": "ひどく崩れ落ちたような感じだった。だから私は"}, {"type": "subtitle", "time": 7419.83, "timestamp": "02:03:39", "text": "髪をこのようにとかすと、"}, {"type": "subtitle", "time": 7423.43, "timestamp": "02:03:43", "text": "櫛さえも。ここは角地です。"}, {"type": "subtitle", "time": 7429.03, "timestamp": "02:03:49", "text": "私はそれを知っています。髪をとかすのに使っています。"}, {"type": "subtitle", "time": 7430.95, "timestamp": "02:03:50", "text": "楽しむことも旅の一部です。"}, {"type": "subtitle", "time": 7432.709, "timestamp": "02:03:52", "text": "うん。うん。実際には旅行ではなく、"}, {"type": "subtitle", "time": 7434.39, "timestamp": "02:03:54", "text": "右？旅行ではない。引っ越します"}, {"type": "subtitle", "time": 7436.709, "timestamp": "02:03:56", "text": "そこには。私は2日以上そこにいるでしょう"}, {"type": "subtitle", "time": 7439.43, "timestamp": "02:03:59", "text": "両方の場合、数年くらいでしょうか。うん。うん。"}]
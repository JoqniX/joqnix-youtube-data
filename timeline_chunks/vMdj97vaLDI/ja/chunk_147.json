[{"type": "subtitle", "time": 8822.309, "timestamp": "02:27:02", "text": "私にとってあなたの側はあなたのオーディオも"}, {"type": "subtitle", "time": 8824.79, "timestamp": "02:27:04", "text": "私の側からすると、声が大きいようだ。だから私はこう思った"}, {"type": "subtitle", "time": 8827.27, "timestamp": "02:27:07", "text": "それを下げるから私はそうしなかった"}, {"type": "subtitle", "time": 8830.79, "timestamp": "02:27:10", "text": "よく話す。わかった。えっと、何が起こるかというと"}, {"type": "subtitle", "time": 8833.75, "timestamp": "02:27:13", "text": "少しでも下げると"}, {"type": "subtitle", "time": 8836.71, "timestamp": "02:27:16", "text": "問題は、私が"}, {"type": "subtitle", "time": 8838.23, "timestamp": "02:27:18", "text": "編集"}, {"type": "subtitle", "time": 8840.309, "timestamp": "02:27:20", "text": "えーと、編集って、何かを編集して消すみたいなことだよね"}, {"type": "subtitle", "time": 8843.349, "timestamp": "02:27:23", "text": "ショートパンツを抜くように私の声は"}, {"type": "subtitle", "time": 8845.99, "timestamp": "02:27:25", "text": "すごく安いから、それが好きなんです"}, {"type": "subtitle", "time": 8849.19, "timestamp": "02:27:29", "text": "少し大きめの音量で。待って、あなたは好きですか"}, {"type": "subtitle", "time": 8851.51, "timestamp": "02:27:31", "text": "YouTubeボードをダウンロードするか、いいね"}, {"type": "subtitle", "time": 8854.309, "timestamp": "02:27:34", "text": "それって録音とか？いや、いや、いや。私"}, {"type": "subtitle", "time": 8855.99, "timestamp": "02:27:35", "text": "YouTubeボードをダウンロードしてください。私はしません"}, {"type": "subtitle", "time": 8859.03, "timestamp": "02:27:39", "text": "それを記録してください。それは私の私のノートパソコンです"}, {"type": "subtitle", "time": 8862.23, "timestamp": "02:27:42", "text": "そうなった場合、自滅する。"}, {"type": "subtitle", "time": 8864.15, "timestamp": "02:27:44", "text": "だから私はそうしない。私は違う 私は違う"}, {"type": "subtitle", "time": 8868.15, "timestamp": "02:27:48", "text": "そのリスクを冒す。いや、絶対に嫌だ。はい。はい。"}, {"type": "subtitle", "time": 8871.429, "timestamp": "02:27:51", "text": "そうですね、私たちは"}, {"type": "subtitle", "time": 8874.389, "timestamp": "02:27:54", "text": "ゲーム。ゲームはもう起動しましたか？えっと、私は"}, {"type": "subtitle", "time": 8875.63, "timestamp": "02:27:55", "text": "オープン"}]
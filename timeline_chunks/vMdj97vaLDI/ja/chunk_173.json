[{"type": "subtitle", "time": 10382.15, "timestamp": "02:53:02", "text": "大きな地図を作ろう。 ３回の落下。"}, {"type": "subtitle", "time": 10385.15, "timestamp": "02:53:05", "text": "さあ行こう。三つ"}, {"type": "subtitle", "time": 10388.71, "timestamp": "02:53:08", "text": "落ちる。あれは楽しかった。実は、"}, {"type": "subtitle", "time": 10390.63, "timestamp": "02:53:10", "text": "すごく面白かった。"}, {"type": "subtitle", "time": 10403.87, "timestamp": "02:53:23", "text": "ファンシー。ファンシー。おしゃれな女性。ファンシー"}, {"type": "subtitle", "time": 10406.79, "timestamp": "02:53:26", "text": "レディ。いいえ。いいえ。ゲーム内通貨です。手に入れる"}, {"type": "subtitle", "time": 10413.51, "timestamp": "02:53:33", "text": "わからない。私は、えっと、あなたのことが好きだと思います"}, {"type": "subtitle", "time": 10415.469, "timestamp": "02:53:35", "text": "知ってるよ、私は"}, {"type": "subtitle", "time": 10420.309, "timestamp": "02:53:40", "text": "繰り返しますが、ファスモフォビア（異文化恐怖症）だけでも恐ろしいものです。"}, {"type": "subtitle", "time": 10422.23, "timestamp": "02:53:42", "text": "でも友達と一緒なら"}, {"type": "subtitle", "time": 10424.389, "timestamp": "02:53:44", "text": "うん。わからない。 10 のように死ぬことができます"}, {"type": "subtitle", "time": 10426.95, "timestamp": "02:53:46", "text": "兆倍もあなたは"}, {"type": "subtitle", "time": 10429.67, "timestamp": "02:53:49", "text": "困惑した。よし。始めます。あなたは"}, {"type": "subtitle", "time": 10431.75, "timestamp": "02:53:51", "text": "あなたが望んでいたもの全て？"}, {"type": "subtitle", "time": 10434.95, "timestamp": "02:53:54", "text": "私は待たない。えっと、私は何をすればいいの？"}, {"type": "subtitle", "time": 10437.67, "timestamp": "02:53:57", "text": "持っている？フリーランですか、それとも"}, {"type": "subtitle", "time": 10439.67, "timestamp": "02:53:59", "text": "安いランニングみたいな感じ？それとも、私たちは行くの？"}]
[{"type": "subtitle", "time": 9304.75, "timestamp": "02:35:04", "text": "午前。彼を見て。"}, {"type": "subtitle", "time": 9308.71, "timestamp": "02:35:08", "text": "ゲーム中にマイクを使っていないことを願っています。"}, {"type": "subtitle", "time": 9311.309, "timestamp": "02:35:11", "text": "念のため確認させてください。"}, {"type": "subtitle", "time": 9313.63, "timestamp": "02:35:13", "text": "わかった。"}, {"type": "subtitle", "time": 9316.309, "timestamp": "02:35:16", "text": "ああ、わかった。私は頑張っています。よし、いいぞ、いいぞ、"}, {"type": "subtitle", "time": 9333.429, "timestamp": "02:35:33", "text": "いいえ、正直に言うと、私は本当に"}, {"type": "subtitle", "time": 9348.99, "timestamp": "02:35:48", "text": "また、この男は"}, {"type": "subtitle", "time": 9354.07, "timestamp": "02:35:54", "text": "自分。この男、文字通り私をじっと見つめている。"}]
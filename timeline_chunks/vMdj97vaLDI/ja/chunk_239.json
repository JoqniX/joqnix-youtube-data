[{"type": "subtitle", "time": 14342.15, "timestamp": "03:59:02", "text": "どうやってグーグルで検索するの？それともいいえ。"}, {"type": "subtitle", "time": 14344.469, "timestamp": "03:59:04", "text": "いいえ。ゲームの中にあります。あなたはしたい"}, {"type": "subtitle", "time": 14348.389, "timestamp": "03:59:08", "text": "学ぶ？できます。待って、それはどこにあるの？行く。"}, {"type": "subtitle", "time": 14350.79, "timestamp": "03:59:10", "text": "ああ、クリックしても見ることはできません。わかった。"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "わかった。わかった。これはあなたが望むものです あなたはあなたが望むものです"}, {"type": "subtitle", "time": 14353.99, "timestamp": "03:59:13", "text": "これらについて学ぶのは、"}, {"type": "subtitle", "time": 14356.55, "timestamp": "03:59:16", "text": "もちろん。私たちは大したことはしないつもりです。わかった。"}, {"type": "subtitle", "time": 14359.03, "timestamp": "03:59:19", "text": "だから、私たちはただ教育を続けよう"}, {"type": "subtitle", "time": 14361.269, "timestamp": "03:59:21", "text": "少なくとも。霊は非常に一般的です"}, {"type": "subtitle", "time": 14362.79, "timestamp": "03:59:22", "text": "おばけ。彼らは非常に強力ですが"}, {"type": "subtitle", "time": 14364.55, "timestamp": "03:59:24", "text": "受け身。必要な時だけ攻撃する"}, {"type": "subtitle", "time": 14367.51, "timestamp": "03:59:27", "text": "に。彼らは自分たちの死の場所を守る"}, {"type": "subtitle", "time": 14370.63, "timestamp": "03:59:30", "text": "彼らの最大限の範囲で、誰でも殺す"}, {"type": "subtitle", "time": 14373.67, "timestamp": "03:59:33", "text": "捕まったか、歓迎されずに滞在しているかのどちらかだ。"}, {"type": "subtitle", "time": 14375.99, "timestamp": "03:59:35", "text": "霊を目撃することは一時的なものである"}, {"type": "subtitle", "time": 14378.63, "timestamp": "03:59:38", "text": "近くでスマッジスティックを燃やすことで止められた"}, {"type": "subtitle", "time": 14383.349, "timestamp": "03:59:43", "text": "証拠はEMFレベル5の箱で、"}, {"type": "subtitle", "time": 14388.07, "timestamp": "03:59:48", "text": "ゴーストライディング。 Wさんを見ました。"}, {"type": "subtitle", "time": 14390.63, "timestamp": "03:59:50", "text": "亡霊。幽霊は最も"}, {"type": "subtitle", "time": 14393.269, "timestamp": "03:59:53", "text": "危険な幽霊に遭遇するでしょう。また、"}, {"type": "subtitle", "time": 14395.75, "timestamp": "03:59:55", "text": "唯一知られている幽霊は、"}, {"type": "subtitle", "time": 14398.55, "timestamp": "03:59:58", "text": "旅行として知られているフライト"}]
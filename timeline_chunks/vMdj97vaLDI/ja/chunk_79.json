[{"type": "subtitle", "time": 4741.11, "timestamp": "01:19:01", "text": "外に出なさい。わかった。私はぼんやりしてしまう傾向がある"}, {"type": "subtitle", "time": 4743.75, "timestamp": "01:19:03", "text": "すべては理解できるが、簡単に解決できる。"}, {"type": "subtitle", "time": 4745.27, "timestamp": "01:19:05", "text": "心配する必要はありません。そして"}, {"type": "subtitle", "time": 4747.59, "timestamp": "01:19:07", "text": "たとえ混乱していても、"}, {"type": "chat", "time": 4747.772, "timestamp": "01:19:07", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "he'll probably get it in my opinion the metro stuff here was also scary to move around metro but we got gucci in like 5 mins"}, {"type": "subtitle", "time": 4749.91, "timestamp": "01:19:09", "text": "混乱したら、ショーを見せてください"}, {"type": "subtitle", "time": 4752.229, "timestamp": "01:19:12", "text": "Googleマップの件は、"}, {"type": "subtitle", "time": 4755.669, "timestamp": "01:19:15", "text": "たくさんの警察官が"}, {"type": "subtitle", "time": 4761.59, "timestamp": "01:19:21", "text": "いいねして、それから彼らに見せて、それから"}, {"type": "subtitle", "time": 4763.51, "timestamp": "01:19:23", "text": "ここでどこに行きたいか聞いて"}, {"type": "subtitle", "time": 4765.189, "timestamp": "01:19:25", "text": "ここ。英語を使っても構いません"}, {"type": "subtitle", "time": 4766.709, "timestamp": "01:19:26", "text": "それを解明すれば、彼らはただ"}, {"type": "subtitle", "time": 4769.27, "timestamp": "01:19:29", "text": "どこへ行くべきか、どの方向へ行くべきかを教えてくれる。"}, {"type": "subtitle", "time": 4772.149, "timestamp": "01:19:32", "text": "心配する必要はありません。うん。"}, {"type": "subtitle", "time": 4773.99, "timestamp": "01:19:33", "text": "私の意見では、地下鉄の駅もまた"}, {"type": "subtitle", "time": 4777.11, "timestamp": "01:19:37", "text": "私にとっては怖い。でも、あと5分で。"}, {"type": "subtitle", "time": 4779.669, "timestamp": "01:19:39", "text": "ええ、まさにその通りです。 5分くらいで着きます"}, {"type": "subtitle", "time": 4783.35, "timestamp": "01:19:43", "text": "分。えっと、Googleマップを使えばいいですよ。"}, {"type": "subtitle", "time": 4785.27, "timestamp": "01:19:45", "text": "Googleマップ。ダウンロードする必要はありません"}, {"type": "subtitle", "time": 4787.669, "timestamp": "01:19:47", "text": "そして、そのカードを手に入れましょう。そのカードを手に入れろ。"}, {"type": "subtitle", "time": 4789.27, "timestamp": "01:19:49", "text": "とても簡単です。好きなものに行ってみてください"}, {"type": "subtitle", "time": 4790.63, "timestamp": "01:19:50", "text": "地下鉄に行けば、"}, {"type": "subtitle", "time": 4792.31, "timestamp": "01:19:52", "text": "機械。あなたはただあなたの"}, {"type": "subtitle", "time": 4794.07, "timestamp": "01:19:54", "text": "情報、あなたの名前、そして"}, {"type": "subtitle", "time": 4796.39, "timestamp": "01:19:56", "text": "お金。追加で500ドルかかりました。"}, {"type": "subtitle", "time": 4798.95, "timestamp": "01:19:58", "text": "その500は後で手に入れます。だから、"}]
[{"type": "subtitle", "time": 3420.309, "timestamp": "00:57:00", "text": "幻灭。啊。啊。所以就像他们"}, {"type": "subtitle", "time": 3422.309, "timestamp": "00:57:02", "text": "他们抱有一定的期望，"}, {"type": "subtitle", "time": 3423.91, "timestamp": "00:57:03", "text": "然后，不知从哪里冒出来一些"}, {"type": "subtitle", "time": 3425.91, "timestamp": "00:57:05", "text": "正是因为这段经历，他们现在才有了这些经历。"}, {"type": "subtitle", "time": 3429.589, "timestamp": "00:57:09", "text": "他们会喜欢这个，他们会记住这个。"}, {"type": "subtitle", "time": 3432.309, "timestamp": "00:57:12", "text": "这种永恒的事情。"}, {"type": "subtitle", "time": 3433.75, "timestamp": "00:57:13", "text": "我不知道的事情。所以，我"}, {"type": "subtitle", "time": 3435.349, "timestamp": "00:57:15", "text": "一定要提前通知他们。"}, {"type": "subtitle", "time": 3439.19, "timestamp": "00:57:19", "text": "你将面对一切。是的。"}, {"type": "subtitle", "time": 3441.44, "timestamp": "00:57:21", "text": "是的。 也"}, {"type": "subtitle", "time": 3442.28, "timestamp": "00:57:22", "text": "也 战斗中经常出现这种情况。"}, {"type": "subtitle", "time": 3445.92, "timestamp": "00:57:25", "text": "战斗中经常出现这种情况。 哦，是的。我被你这混蛋盯上了。"}, {"type": "subtitle", "time": 3457.51, "timestamp": "00:57:37", "text": "你看，别担心。如果有人"}, {"type": "subtitle", "time": 3459.27, "timestamp": "00:57:39", "text": "如果有人对你说脏话，我会……"}, {"type": "subtitle", "time": 3461.349, "timestamp": "00:57:41", "text": "精神上或我将我将黑色"}, {"type": "subtitle", "time": 3464.15, "timestamp": "00:57:44", "text": "他们身上有魔法。"}, {"type": "subtitle", "time": 3472.069, "timestamp": "00:57:52", "text": "[音乐]"}, {"type": "subtitle", "time": 3474.87, "timestamp": "00:57:54", "text": "他们人其实很好。 M. 什么"}]
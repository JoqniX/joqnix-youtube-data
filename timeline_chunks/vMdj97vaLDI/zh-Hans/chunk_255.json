[{"type": "subtitle", "time": 15307.429, "timestamp": "04:15:07", "text": "你。哪个厕所？我已经检查过两处了。"}, {"type": "subtitle", "time": 15310.269, "timestamp": "04:15:10", "text": "洗手间。淋浴"}, {"type": "subtitle", "time": 15313.51, "timestamp": "04:15:13", "text": "房间，还有我们第一个开门的地方"}, {"type": "subtitle", "time": 15314.83, "timestamp": "04:15:14", "text": "向上和"}, {"type": "subtitle", "time": 15317.59, "timestamp": "04:15:17", "text": "我走了，鬼魂就消失了。"}, {"type": "subtitle", "time": 15328.63, "timestamp": "04:15:28", "text": "现在我们不在……"}, {"type": "subtitle", "time": 15330.309, "timestamp": "04:15:30", "text": "等等，你现在在哪里？我懂了"}, {"type": "subtitle", "time": 15331.83, "timestamp": "04:15:31", "text": "你。我看见你。好的。好的。去。出去。"}, {"type": "subtitle", "time": 15332.99, "timestamp": "04:15:32", "text": "出去。是的。是的。"}, {"type": "subtitle", "time": 15338.71, "timestamp": "04:15:38", "text": "是的。所以，呃，EMF值是5，我记得是这样。"}, {"type": "subtitle", "time": 15342.95, "timestamp": "04:15:42", "text": "电磁场。好的。是的。然后，呃，就没有了。"}, {"type": "subtitle", "time": 15346.229, "timestamp": "04:15:46", "text": "比如，呃，电磁场。什么也没有。曾是"}, {"type": "subtitle", "time": 15348.55, "timestamp": "04:15:48", "text": "那是我五级的时候。我没找到"}, {"type": "subtitle", "time": 15349.309, "timestamp": "04:15:49", "text": "任何"}, {"type": "subtitle", "time": 15351.91, "timestamp": "04:15:51", "text": "指纹。我不了解"}, {"type": "subtitle", "time": 15354.79, "timestamp": "04:15:54", "text": "没有灵盒。不"}, {"type": "subtitle", "time": 15358.389, "timestamp": "04:15:58", "text": "冰冻温度。禁止幽灵骑行。呃"}]
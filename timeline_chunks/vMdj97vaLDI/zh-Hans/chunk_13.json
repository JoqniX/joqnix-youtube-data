[{"type": "subtitle", "time": 799.75, "timestamp": "00:13:19", "text": "哎呀，我忘了这事儿了。他擅长什么？"}, {"type": "subtitle", "time": 802.47, "timestamp": "00:13:22", "text": "英语还是其他语言？我忘了。实际上"}, {"type": "subtitle", "time": 824.43, "timestamp": "00:13:44", "text": "就是坐下。我"}, {"type": "subtitle", "time": 827.71, "timestamp": "00:13:47", "text": "相信他正在尽力解决这个问题。"}, {"type": "subtitle", "time": 836.629, "timestamp": "00:13:56", "text": "很多。我错过了。"}]
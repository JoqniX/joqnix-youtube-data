[{"type": "subtitle", "time": 1461.59, "timestamp": "00:24:21", "text": "嗨元基。妈的。是的。哦，是个男的。"}, {"type": "subtitle", "time": 1463.87, "timestamp": "00:24:23", "text": "你也应该参与其中"}, {"type": "subtitle", "time": 1479.029, "timestamp": "00:24:39", "text": "他正在尽力打字。"}, {"type": "subtitle", "time": 1480.47, "timestamp": "00:24:40", "text": "印度尼西亚。我的天哪，有人！"}, {"type": "subtitle", "time": 1483.07, "timestamp": "00:24:43", "text": "我周围。我是"}, {"type": "subtitle", "time": 1495.99, "timestamp": "00:24:55", "text": "不。我的天哪，我好害怕。以这种方式，"}, {"type": "subtitle", "time": 1498.31, "timestamp": "00:24:58", "text": "我很害怕。人太多了"}]
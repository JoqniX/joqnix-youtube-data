[{"type": "subtitle", "time": 12840.79, "timestamp": "03:34:00", "text": "呃，我会进去。如果我死了，你就选吧。"}, {"type": "subtitle", "time": 12849.269, "timestamp": "03:34:09", "text": "好的，我会到场。你在哪里"}, {"type": "subtitle", "time": 12850.95, "timestamp": "03:34:10", "text": "顺便问一下，那本书是你栽赃的吗？我是"}, {"type": "subtitle", "time": 12853.269, "timestamp": "03:34:13", "text": "正在寻找。就在那边。"}, {"type": "subtitle", "time": 12854.55, "timestamp": "03:34:14", "text": "直通直通直通"}, {"type": "subtitle", "time": 12870.229, "timestamp": "03:34:30", "text": "门。没关系。只是一扇门而已。"}, {"type": "subtitle", "time": 12871.59, "timestamp": "03:34:31", "text": "上帝。"}, {"type": "subtitle", "time": 12874.71, "timestamp": "03:34:34", "text": "不，这里没有幽灵骑行。这"}, {"type": "subtitle", "time": 12875.399, "timestamp": "03:34:35", "text": "这 这个鬼真讨厌。"}, {"type": "subtitle", "time": 12882.15, "timestamp": "03:34:42", "text": "不，不是。门打不开。"}, {"type": "subtitle", "time": 12884.91, "timestamp": "03:34:44", "text": "你能帮忙吗？我不能"}, {"type": "subtitle", "time": 12887.83, "timestamp": "03:34:47", "text": "帮助。我的天啊。好的，别担心。只是"}, {"type": "subtitle", "time": 12889.67, "timestamp": "03:34:49", "text": "打开门。我不知道你为什么……"}, {"type": "subtitle", "time": 12891.75, "timestamp": "03:34:51", "text": "喜欢"}, {"type": "subtitle", "time": 12894.71, "timestamp": "03:34:54", "text": "好的，明白了。凉爽的。别杀我们。"}]
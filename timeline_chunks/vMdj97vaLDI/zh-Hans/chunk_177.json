[{"type": "subtitle", "time": 10621.429, "timestamp": "02:57:01", "text": "麦克风离麦克风远了。我是什么？"}, {"type": "subtitle", "time": 10624.23, "timestamp": "02:57:04", "text": "我应该录下来吗？"}, {"type": "subtitle", "time": 10628.07, "timestamp": "02:57:08", "text": "嗯，我觉得数组可能是个好朋友。"}, {"type": "subtitle", "time": 10634.83, "timestamp": "02:57:14", "text": "是的。是的。检查一下你的系统"}, {"type": "subtitle", "time": 10637.75, "timestamp": "02:57:17", "text": "当你说话时发出的声音"}, {"type": "subtitle", "time": 10639.59, "timestamp": "02:57:19", "text": "它会亮起来。其中一人将是"}, {"type": "subtitle", "time": 10641.59, "timestamp": "02:57:21", "text": "灯亮了。所以，这就是你"}, {"type": "subtitle", "time": 10644.23, "timestamp": "02:57:24", "text": "需要做出选择。"}, {"type": "subtitle", "time": 10646.63, "timestamp": "02:57:26", "text": "好的。这不是麦克风"}, {"type": "subtitle", "time": 10661.67, "timestamp": "02:57:41", "text": "思维有助于处理技术问题。"}, {"type": "subtitle", "time": 10664.71, "timestamp": "02:57:44", "text": "你好。你好。你好。你好。呃呃呃。"}, {"type": "subtitle", "time": 10667.19, "timestamp": "02:57:47", "text": "嘿。嘿。嘿。为什么有三个"}, {"type": "subtitle", "time": 10669.67, "timestamp": "02:57:49", "text": "手电筒？我的天啊。你好。你好。"}, {"type": "subtitle", "time": 10673.51, "timestamp": "02:57:53", "text": "你好。你好。你好。你好。你好。嘿。嘿。嘿。"}]
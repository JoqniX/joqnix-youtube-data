[{"type": "subtitle", "time": 11460.87, "timestamp": "03:11:00", "text": "在？继续。发生了什么事？有人这么做了"}, {"type": "subtitle", "time": 11464.309, "timestamp": "03:11:04", "text": "打开。我的天哪，吓死我了。"}, {"type": "subtitle", "time": 11465.83, "timestamp": "03:11:05", "text": "什么？什么？发生了什么？什么"}, {"type": "subtitle", "time": 11467.91, "timestamp": "03:11:07", "text": "发生了吗？"}, {"type": "subtitle", "time": 11470.23, "timestamp": "03:11:10", "text": "我当时就尖叫起来。"}, {"type": "subtitle", "time": 11471.67, "timestamp": "03:11:11", "text": "好吧，没事了。好的，你可以进来了。"}, {"type": "subtitle", "time": 11473.19, "timestamp": "03:11:13", "text": "你可以抓住我。现在还不觉得闹鬼。"}, {"type": "subtitle", "time": 11474.95, "timestamp": "03:11:14", "text": "继续。"}, {"type": "subtitle", "time": 11477.03, "timestamp": "03:11:17", "text": "我知道我需要在你……的时候进来"}, {"type": "subtitle", "time": 11480.63, "timestamp": "03:11:20", "text": "我就在那里，不能回家。"}, {"type": "subtitle", "time": 11483.11, "timestamp": "03:11:23", "text": "好的。好的。好的。好的。好的。我觉得我"}, {"type": "subtitle", "time": 11486.15, "timestamp": "03:11:26", "text": "我觉得就是这样"}, {"type": "subtitle", "time": 11487.15, "timestamp": "03:11:27", "text": "冷冻"}, {"type": "subtitle", "time": 11491.389, "timestamp": "03:11:31", "text": "温度。我真不知道。"}, {"type": "subtitle", "time": 11494.349, "timestamp": "03:11:34", "text": "重复使用和移动"}, {"type": "subtitle", "time": 11498.71, "timestamp": "03:11:38", "text": "出去。我们可以搬出去吗？好的。"}, {"type": "subtitle", "time": 11500.79, "timestamp": "03:11:40", "text": "不，雅克。我们不应该"}, {"type": "subtitle", "time": 11505.11, "timestamp": "03:11:45", "text": "别急着搬出去。呃"}]
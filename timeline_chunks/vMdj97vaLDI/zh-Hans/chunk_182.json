[{"type": "subtitle", "time": 10920.91, "timestamp": "03:02:00", "text": "在哪里？显而易见的音频滤波器。"}, {"type": "subtitle", "time": 10924.63, "timestamp": "03:02:04", "text": "添加什么？这是什么？加上呃"}, {"type": "subtitle", "time": 10927.99, "timestamp": "03:02:07", "text": "对，过滤。呃，增加增益和增加"}, {"type": "subtitle", "time": 10930.55, "timestamp": "03:02:10", "text": "呃，比如把增益调到2左右"}, {"type": "subtitle", "time": 10933.75, "timestamp": "03:02:13", "text": "某物。哦，等等。当我应该……的时候"}, {"type": "subtitle", "time": 10936.309, "timestamp": "03:02:16", "text": "这样做？是我的东西还是你的东西？"}, {"type": "subtitle", "time": 10939.19, "timestamp": "03:02:19", "text": "呃，在你的东西里？在你的麦克风里。你的麦克风，"}, {"type": "subtitle", "time": 10941.87, "timestamp": "03:02:21", "text": "不是我的。"}, {"type": "subtitle", "time": 10947.429, "timestamp": "03:02:27", "text": "好的。获得。好的。获得两倍。你"}, {"type": "subtitle", "time": 10950.75, "timestamp": "03:02:30", "text": "你想问我要两个吗？"}, {"type": "subtitle", "time": 10953.269, "timestamp": "03:02:33", "text": "是的。两三个人就能做到。"}, {"type": "subtitle", "time": 10954.87, "timestamp": "03:02:34", "text": "你有点像能听见的声音。"}, {"type": "subtitle", "time": 10957.75, "timestamp": "03:02:37", "text": "勉强能听见。"}, {"type": "subtitle", "time": 10961.469, "timestamp": "03:02:41", "text": "好的。好的。我做得好吗？"}, {"type": "subtitle", "time": 10964.79, "timestamp": "03:02:44", "text": "好的。请。谢谢。这样好吗？"}, {"type": "subtitle", "time": 10967.95, "timestamp": "03:02:47", "text": "现在？现在这样可以吗？我是谁？"}, {"type": "subtitle", "time": 10977.59, "timestamp": "03:02:57", "text": "哦，等等。你忘了放流媒体"}]
[{"type": "subtitle", "time": 14223.75, "timestamp": "03:57:03", "text": "拍照的方式真是绝了，兄弟。我们需要"}, {"type": "subtitle", "time": 14228.229, "timestamp": "03:57:08", "text": "我们需要多拍些照片。"}, {"type": "subtitle", "time": 14230.309, "timestamp": "03:57:10", "text": "是的。"}, {"type": "subtitle", "time": 14233.03, "timestamp": "03:57:13", "text": "是的，他就是那个鬼魂，名字是……"}, {"type": "subtitle", "time": 14236.03, "timestamp": "03:57:16", "text": "奥巴卡。所以"}, {"type": "subtitle", "time": 14238.51, "timestamp": "03:57:18", "text": "奥巴卡"}, {"type": "subtitle", "time": 14247.51, "timestamp": "03:57:27", "text": "哦，你这个傻小子，快把我逼疯了，左边和"}, {"type": "subtitle", "time": 14250.95, "timestamp": "03:57:30", "text": "正确的。你他妈到底怎么了？"}, {"type": "subtitle", "time": 14253.03, "timestamp": "03:57:33", "text": "确切地。"}, {"type": "subtitle", "time": 14255.87, "timestamp": "03:57:35", "text": "我们应该得到什么？我当时是什么？"}, {"type": "subtitle", "time": 14259.03, "timestamp": "03:57:39", "text": "好的。我究竟痴迷于什么？我"}, {"type": "subtitle", "time": 14259.95, "timestamp": "03:57:39", "text": "不"}, {"type": "subtitle", "time": 14262.87, "timestamp": "03:57:42", "text": "知道。等等，那是什么？通常情况下"}, {"type": "subtitle", "time": 14265.11, "timestamp": "03:57:45", "text": "蠢事说得好像拿走一样"}, {"type": "subtitle", "time": 14268.07, "timestamp": "03:57:48", "text": "抛物线麦克风之类的东西。"}, {"type": "subtitle", "time": 14270.79, "timestamp": "03:57:50", "text": "是的。哦，不。不，我没有解锁。"}, {"type": "subtitle", "time": 14273.349, "timestamp": "03:57:53", "text": "这。哦，没事了。"}, {"type": "subtitle", "time": 14276.229, "timestamp": "03:57:56", "text": "哦，怪不得我问你那么多问题。"}, {"type": "subtitle", "time": 14278.07, "timestamp": "03:57:58", "text": "不，不，不。我没有解锁它。我没有"}, {"type": "subtitle", "time": 14279.83, "timestamp": "03:57:59", "text": "解锁。没关系。没关系。我当时"}]
[{"type": "subtitle", "time": 9541.67, "timestamp": "02:39:01", "text": "不用担心。我会的，我会和你在一起。"}, {"type": "subtitle", "time": 9543.75, "timestamp": "02:39:03", "text": "永远。不用担心。我不会离开"}, {"type": "subtitle", "time": 9547.91, "timestamp": "02:39:07", "text": "你。哦，你好。好的。谢谢。好的。"}, {"type": "subtitle", "time": 9551.59, "timestamp": "02:39:11", "text": "总之，我要加上这个。我要补充"}, {"type": "subtitle", "time": 9554.07, "timestamp": "02:39:14", "text": "我加了操。我打算加个手电筒。"}, {"type": "subtitle", "time": 9556.71, "timestamp": "02:39:16", "text": "我打算加一本书。我打算加装收音机。"}, {"type": "subtitle", "time": 9561.51, "timestamp": "02:39:21", "text": "事物。我加了一坨屎。呃，我还要补充一点"}, {"type": "subtitle", "time": 9565.59, "timestamp": "02:39:25", "text": "温度计之类的东西。我加点盐。"}, {"type": "subtitle", "time": 9568.55, "timestamp": "02:39:28", "text": "你很有钱。你正在努力奋斗。"}, {"type": "subtitle", "time": 9571.19, "timestamp": "02:39:31", "text": "不。我的天哪。不，我没有。"}, {"type": "subtitle", "time": 9573.75, "timestamp": "02:39:33", "text": "钱。你在说什么？如何"}, {"type": "subtitle", "time": 9576.79, "timestamp": "02:39:36", "text": "你是？让我们加进去，我不加。"}, {"type": "subtitle", "time": 9579.51, "timestamp": "02:39:39", "text": "知道。我添加了一些内容。如果有的话"}, {"type": "subtitle", "time": 9581.349, "timestamp": "02:39:41", "text": "卡车里没有。"}, {"type": "subtitle", "time": 9582.51, "timestamp": "02:39:42", "text": "我不是我是"}, {"type": "subtitle", "time": 9586.71, "timestamp": "02:39:46", "text": "你想去这个房间吗？哪个"}, {"type": "subtitle", "time": 9589.11, "timestamp": "02:39:49", "text": "一？你想选择哪张地图？不，"}, {"type": "subtitle", "time": 9591.91, "timestamp": "02:39:51", "text": "不，不。拜托，J，过来一下。"}, {"type": "subtitle", "time": 9594.95, "timestamp": "02:39:54", "text": "哪个？我在这里。我在这里。不，不。"}, {"type": "subtitle", "time": 9598.07, "timestamp": "02:39:58", "text": "过来。下来吧。"}]
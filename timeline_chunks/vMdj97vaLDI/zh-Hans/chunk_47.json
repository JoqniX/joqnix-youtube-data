[{"type": "subtitle", "time": 2825.19, "timestamp": "00:47:05", "text": "很荣幸能有机会教你，这样……"}, {"type": "subtitle", "time": 2827.589, "timestamp": "00:47:07", "text": "这是我甚至对我的弟弟妹妹们都说的。"}, {"type": "chat", "time": 2828.63, "timestamp": "00:47:08", "author": "@relaxbreatheblossomasmr5099", "avatar": "https://yt4.ggpht.com/ckcBBCnJoTgzSBf41z6qIrlbXLgznOucPKQ1RdeSjWdIubetNhA8L40rK7FrC8Ymp_UJfKAA5w=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCxUCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCxUCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCx"}, {"type": "subtitle", "time": 2830.63, "timestamp": "00:47:10", "text": "兄弟。好的？了解不好的事情。"}, {"type": "subtitle", "time": 2832.55, "timestamp": "00:47:12", "text": "好的？别这么做。别这么做。但"}, {"type": "subtitle", "time": 2834.79, "timestamp": "00:47:14", "text": "了解坏事，这样，当……的时候"}, {"type": "subtitle", "time": 2836.87, "timestamp": "00:47:16", "text": "如果你出了什么事，你不会……"}, {"type": "subtitle", "time": 2838.95, "timestamp": "00:47:18", "text": "天真的那个。所以我就是这么说的。"}, {"type": "chat", "time": 2841.323, "timestamp": "00:47:21", "author": "@relaxbreatheblossomasmr5099", "avatar": "https://yt4.ggpht.com/ckcBBCnJoTgzSBf41z6qIrlbXLgznOucPKQ1RdeSjWdIubetNhA8L40rK7FrC8Ymp_UJfKAA5w=s64-c-k-c0x00ffffff-no-rj", "message": "rip joq senpai"}, {"type": "subtitle", "time": 2841.589, "timestamp": "00:47:21", "text": "人们。了解不好的事情。不要这样做"}, {"type": "subtitle", "time": 2843.19, "timestamp": "00:47:23", "text": "它。了解不好的事情。你知道，当"}, {"type": "subtitle", "time": 2846.03, "timestamp": "00:47:26", "text": "我当时……我想我当时在……"}, {"type": "subtitle", "time": 2849.27, "timestamp": "00:47:29", "text": "五年级，四年级，我不记得了。我"}, {"type": "subtitle", "time": 2851.03, "timestamp": "00:47:31", "text": "不知道竖中指是什么意思。"}, {"type": "subtitle", "time": 2853.91, "timestamp": "00:47:33", "text": "好的。所以，呃，一群这样的"}, {"type": "chat", "time": 2854.733, "timestamp": "00:47:34", "author": "@pallyshorts", "avatar": "https://yt4.ggpht.com/bUFK7G0ngMhKt0hngr1HLPABWGhXa5Sj__hJIN8j8POnZah6-QZLHwZYWCrDrKUlyKnBW0Md5g=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/xsIfY4OqCd2T29sP54iAsAwUCkszU2WH9gy1mb0dV-11UJg/xsIfY4OqCd2T29sP54iAsAwUCkszU2WH9gy1mb0dV-11UJg/xsIfY4OqCd2T29sP54iAsAw"}, {"type": "subtitle", "time": 2855.91, "timestamp": "00:47:35", "text": "附近的兄弟们，"}, {"type": "subtitle", "time": 2858.47, "timestamp": "00:47:38", "text": "邻里兄弟。呃，所以我们有"}, {"type": "subtitle", "time": 2860.79, "timestamp": "00:47:40", "text": "我曾拥有这家小店。我妈妈以前跑步"}, {"type": "subtitle", "time": 2862.79, "timestamp": "00:47:42", "text": "一家小商店。我当时坐在外面"}, {"type": "subtitle", "time": 2865.109, "timestamp": "00:47:45", "text": "那家店和我附近的巴亚"}, {"type": "subtitle", "time": 2867.19, "timestamp": "00:47:47", "text": "就像邻居一样，情同手足"}, {"type": "subtitle", "time": 2869.349, "timestamp": "00:47:49", "text": "兄弟俩就像疯子一样，为什么？"}, {"type": "subtitle", "time": 2870.95, "timestamp": "00:47:50", "text": "你为什么不指着你的"}, {"type": "subtitle", "time": 2872.95, "timestamp": "00:47:52", "text": "对那些女孩竖中指"}, {"type": "subtitle", "time": 2874.55, "timestamp": "00:47:54", "text": "一群女孩走着"}, {"type": "subtitle", "time": 2876.15, "timestamp": "00:47:56", "text": "准备过马路时，我心想："}, {"type": "subtitle", "time": 2877.91, "timestamp": "00:47:57", "text": "什么是竖中指？他们就像"}, {"type": "subtitle", "time": 2879.589, "timestamp": "00:47:59", "text": "不，只是表演，只是表演，然后我就想"}]
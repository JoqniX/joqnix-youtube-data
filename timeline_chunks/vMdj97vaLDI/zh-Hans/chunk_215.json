[{"type": "subtitle", "time": 12908.229, "timestamp": "03:35:08", "text": "好的。哦，哇。我们竟然活了下来"}, {"type": "subtitle", "time": 12911.269, "timestamp": "03:35:11", "text": "闹鬼事件很严重。它不是幻影，因为"}, {"type": "subtitle", "time": 12913.91, "timestamp": "03:35:13", "text": "即使是幻影也达不到10。"}, {"type": "subtitle", "time": 12916.389, "timestamp": "03:35:16", "text": "等等，我真的……我的天哪，我"}, {"type": "subtitle", "time": 12918.03, "timestamp": "03:35:18", "text": "击中了“哦，我的”"}, {"type": "subtitle", "time": 12920.95, "timestamp": "03:35:20", "text": "上帝。终于，鬼魂存在的证据出现了。好的，"}, {"type": "subtitle", "time": 12923.75, "timestamp": "03:35:23", "text": "我们得到了闹鬼的证据。哦，我的"}, {"type": "subtitle", "time": 12928.55, "timestamp": "03:35:28", "text": "上帝。不，不，不，很好。真是个奇特的生物。"}, {"type": "subtitle", "time": 12930.75, "timestamp": "03:35:30", "text": "那就是"}, {"type": "subtitle", "time": 12934.63, "timestamp": "03:35:34", "text": "贱人。所以他看起来像个老人，"}, {"type": "subtitle", "time": 12938.15, "timestamp": "03:35:38", "text": "一个鬼魂，一个粉丝，还有，呃，就像一个"}, {"type": "subtitle", "time": 12941.63, "timestamp": "03:35:41", "text": "武士之类的东西"}, {"type": "subtitle", "time": 12944.269, "timestamp": "03:35:44", "text": "一把剑或"}, {"type": "subtitle", "time": 12951.19, "timestamp": "03:35:51", "text": "是的。好的，那不错。那很好。"}, {"type": "subtitle", "time": 12953.07, "timestamp": "03:35:53", "text": "我们将用……制作饼干"}, {"type": "subtitle", "time": 12958.07, "timestamp": "03:35:58", "text": "这些。很遗憾，我们没有"}, {"type": "subtitle", "time": 12959.309, "timestamp": "03:35:59", "text": "吃得好"}]
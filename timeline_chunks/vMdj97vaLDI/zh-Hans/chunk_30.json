[{"type": "subtitle", "time": 1827.19, "timestamp": "00:30:27", "text": "我的天啊。"}, {"type": "subtitle", "time": 1840.19, "timestamp": "00:30:40", "text": "该怎么办？我……我……我不太擅长"}, {"type": "subtitle", "time": 1842.63, "timestamp": "00:30:42", "text": "沟通。我跟不上……"}, {"type": "subtitle", "time": 1846.31, "timestamp": "00:30:46", "text": "我的一个朋友。你们都聊些什么？如何"}]
[{"type": "subtitle", "time": 12780.63, "timestamp": "03:33:00", "text": "哦，照片是我拍的。我接受了"}, {"type": "subtitle", "time": 12783.51, "timestamp": "03:33:03", "text": "图片。哦，哦，是你拍的照片。"}, {"type": "subtitle", "time": 12785.349, "timestamp": "03:33:05", "text": "请。请快跑，快跑，快跑，快跑"}, {"type": "subtitle", "time": 12787.349, "timestamp": "03:33:07", "text": "外部。快跑进去。跑出去。跑步"}, {"type": "subtitle", "time": 12789.03, "timestamp": "03:33:09", "text": "外部。跑出去。跑，跑，跑！"}, {"type": "subtitle", "time": 12791.59, "timestamp": "03:33:11", "text": "跑步。没关系。没关系。没关系。他"}, {"type": "subtitle", "time": 12793.59, "timestamp": "03:33:13", "text": "它没要了你的命，对吧？他没有杀人"}, {"type": "subtitle", "time": 12796.469, "timestamp": "03:33:16", "text": "我。它就像个战士。它是"}, {"type": "subtitle", "time": 12800.83, "timestamp": "03:33:20", "text": "某种战士之类的东西。它是"}, {"type": "subtitle", "time": 12805.11, "timestamp": "03:33:25", "text": "很酷。我们还没死。"}, {"type": "subtitle", "time": 12807.67, "timestamp": "03:33:27", "text": "我们还没死。是的。我们走吧。是的，"}, {"type": "subtitle", "time": 12810.71, "timestamp": "03:33:30", "text": "雅克。我们仍然没有任何进展"}, {"type": "subtitle", "time": 12815.11, "timestamp": "03:33:35", "text": "顺便问一下。就是这件事。"}, {"type": "subtitle", "time": 12817.349, "timestamp": "03:33:37", "text": "我的天啊。好的，我们来看看。让我们来看看。"}, {"type": "subtitle", "time": 12820.71, "timestamp": "03:33:40", "text": "让我们来看看。它并不暴力。"}, {"type": "subtitle", "time": 12824.229, "timestamp": "03:33:44", "text": "它并不暴力。好的。电磁场。并非如此"}, {"type": "subtitle", "time": 12826.95, "timestamp": "03:33:46", "text": "顺便说一句，那并不是电磁场峰值。它"}, {"type": "subtitle", "time": 12829.59, "timestamp": "03:33:49", "text": "我没有灵盒，但是"}, {"type": "subtitle", "time": 12832.229, "timestamp": "03:33:52", "text": "令人难忘。令人难忘。是鬼魂吗？"}, {"type": "subtitle", "time": 12833.83, "timestamp": "03:33:53", "text": "写作？等等，等等，等等。我们需要"}, {"type": "subtitle", "time": 12838.389, "timestamp": "03:33:58", "text": "查阅这本书。哦，不。我不能"}]
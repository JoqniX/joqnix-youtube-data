[{"type": "subtitle", "time": 1505.75, "timestamp": "00:25:05", "text": "太多人联合起来欺负人了。什么"}, {"type": "subtitle", "time": 1513.269, "timestamp": "00:25:13", "text": "等等，那个人的头像是什么意思？"}, {"type": "subtitle", "time": 1515.029, "timestamp": "00:25:15", "text": "有？"}, {"type": "subtitle", "time": 1528.789, "timestamp": "00:25:28", "text": "离开。终于，我们能听到彼此的声音了。"}]
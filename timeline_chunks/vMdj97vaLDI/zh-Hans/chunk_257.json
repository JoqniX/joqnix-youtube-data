[{"type": "subtitle", "time": 15421.269, "timestamp": "04:17:01", "text": "40美元。哇，我得了40美元。"}, {"type": "subtitle", "time": 15424.149, "timestamp": "04:17:04", "text": "好的。嗯，你看，我觉得我们需要……"}, {"type": "subtitle", "time": 15428.63, "timestamp": "04:17:08", "text": "至少要活下去。快点到“是”。"}, {"type": "subtitle", "time": 15431.59, "timestamp": "04:17:11", "text": "是的。是的。好吧，我现在明白了，好吧。"}, {"type": "subtitle", "time": 15434.71, "timestamp": "04:17:14", "text": "我们是六级。是的，我目前水平还不错。"}, {"type": "subtitle", "time": 15437.11, "timestamp": "04:17:17", "text": "五级。你做了什么？你做了什么？"}, {"type": "subtitle", "time": 15441.83, "timestamp": "04:17:21", "text": "开锁？我解锁了运动"}, {"type": "subtitle", "time": 15444.149, "timestamp": "04:17:24", "text": "运动传感器。运动传感器。哦，不错。"}, {"type": "subtitle", "time": 15446.87, "timestamp": "04:17:26", "text": "不错，不错。"}, {"type": "subtitle", "time": 15448.95, "timestamp": "04:17:28", "text": "哦，我可以买抛物线麦克风。"}, {"type": "subtitle", "time": 15452.149, "timestamp": "04:17:32", "text": "这到底是什么怪事？什么？"}, {"type": "subtitle", "time": 15453.51, "timestamp": "04:17:33", "text": "哦，不，不，没事了。没关系。"}, {"type": "subtitle", "time": 15457.11, "timestamp": "04:17:37", "text": "没关系。我买不起愚蠢的东西。"}, {"type": "subtitle", "time": 15459.91, "timestamp": "04:17:39", "text": "售价65美元。"}, {"type": "subtitle", "time": 15462.71, "timestamp": "04:17:42", "text": "太愚蠢了。好的。总之，我们已经"}, {"type": "subtitle", "time": 15465.51, "timestamp": "04:17:45", "text": "获取一段关于电磁场（EMF）的视频。我们已经得到一个"}, {"type": "subtitle", "time": 15473.75, "timestamp": "04:17:53", "text": "手电筒。哦，我们已经有一个了"}, {"type": "subtitle", "time": 15475.07, "timestamp": "04:17:55", "text": "照片"}, {"type": "subtitle", "time": 15477.429, "timestamp": "04:17:57", "text": "相机。是的。是的。不要拿"}]
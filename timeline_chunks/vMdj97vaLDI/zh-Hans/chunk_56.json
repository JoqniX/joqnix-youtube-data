[{"type": "subtitle", "time": 3361.23, "timestamp": "00:56:01", "text": "我能这么说吗？让我"}, {"type": "subtitle", "time": 3364.309, "timestamp": "00:56:04", "text": "思考。是的。或者"}, {"type": "subtitle", "time": 3367.589, "timestamp": "00:56:07", "text": "我只是给你提个建议。好的。"}, {"type": "subtitle", "time": 3370.789, "timestamp": "00:56:10", "text": "是的。是的。是的。你可能会遭遇种族歧视。"}, {"type": "subtitle", "time": 3372.87, "timestamp": "00:56:12", "text": "啊，是的。"}, {"type": "subtitle", "time": 3374.349, "timestamp": "00:56:14", "text": "而且"}, {"type": "chat", "time": 3374.743, "timestamp": "00:56:14", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Joq the type of guy who'll cry while fighting"}, {"type": "subtitle", "time": 3376.349, "timestamp": "00:56:16", "text": "就像那件事"}, {"type": "subtitle", "time": 3380.39, "timestamp": "00:56:20", "text": "是我自己做的。所以，有时候我"}, {"type": "subtitle", "time": 3382.87, "timestamp": "00:56:22", "text": "每当我的朋友，尤其是"}, {"type": "subtitle", "time": 3384.15, "timestamp": "00:56:24", "text": "那些特别是来自外地的人"}, {"type": "subtitle", "time": 3386.71, "timestamp": "00:56:26", "text": "通知以及谁没有收到通知"}, {"type": "subtitle", "time": 3388.03, "timestamp": "00:56:28", "text": "注意到并"}, {"type": "subtitle", "time": 3390.789, "timestamp": "00:56:30", "text": "我尽量喜欢赋予他们的这些特性"}, {"type": "subtitle", "time": 3394.39, "timestamp": "00:56:34", "text": "比如，无论何时出门都要做好准备。"}, {"type": "subtitle", "time": 3396.069, "timestamp": "00:56:36", "text": "因为我有很多朋友"}, {"type": "subtitle", "time": 3397.91, "timestamp": "00:56:37", "text": "去了日本的人，他们就像"}, {"type": "subtitle", "time": 3400.39, "timestamp": "00:56:40", "text": "啊，大家都很好，很有礼貌，但是"}, {"type": "subtitle", "time": 3402.47, "timestamp": "00:56:42", "text": "一旦他们面对这种情况，他们就会变成"}, {"type": "subtitle", "time": 3403.309, "timestamp": "00:56:43", "text": "非常"}, {"type": "subtitle", "time": 3408.23, "timestamp": "00:56:48", "text": "这是幻觉吗？这就是我"}, {"type": "subtitle", "time": 3411.069, "timestamp": "00:56:51", "text": "我想这就是我想要的"}, {"type": "subtitle", "time": 3414.549, "timestamp": "00:56:54", "text": "呃，分离，或者像这样，不"}, {"type": "subtitle", "time": 3416.91, "timestamp": "00:56:56", "text": "失望地想：哦，他们会变成"}]
[{"type": "subtitle", "time": 4920.709, "timestamp": "01:22:00", "text": "问。是的，你可以……"}, {"type": "subtitle", "time": 4922.47, "timestamp": "01:22:02", "text": "要么就买，要么就不用买了，如果你需要的话。"}, {"type": "subtitle", "time": 4924.149, "timestamp": "01:22:04", "text": "以备不时之需，准备一个应急用。"}, {"type": "subtitle", "time": 4926.629, "timestamp": "01:22:06", "text": "花5000日元，就能用15天左右。"}, {"type": "subtitle", "time": 4929.11, "timestamp": "01:22:09", "text": "仅限互联网。到达那里后，"}, {"type": "subtitle", "time": 4931.43, "timestamp": "01:22:11", "text": "像你这样的权威人士"}, {"type": "subtitle", "time": 4933.51, "timestamp": "01:22:13", "text": "比如找个老师之类的机构"}, {"type": "subtitle", "time": 4936.149, "timestamp": "01:22:16", "text": "向他们要一张当地的SIM卡。他们"}, {"type": "subtitle", "time": 4938.149, "timestamp": "01:22:18", "text": "会有更好的主意。我建议"}, {"type": "subtitle", "time": 4940.47, "timestamp": "01:22:20", "text": "你只需要办理一张临时SIM卡即可"}, {"type": "subtitle", "time": 4942.39, "timestamp": "01:22:22", "text": "如果你想的话，可以去机场，因为你会"}, {"type": "subtitle", "time": 4945.03, "timestamp": "01:22:25", "text": "你需要上网才能去"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "首先，请问您的位置在哪里？是的。所以，开始吧"}, {"type": "subtitle", "time": 4949.189, "timestamp": "01:22:29", "text": "办理一张临时SIM卡，费用为"}, {"type": "subtitle", "time": 4952.95, "timestamp": "01:22:32", "text": "比如5000日元，15美元就能搞定。"}, {"type": "subtitle", "time": 4955.91, "timestamp": "01:22:35", "text": "15天。呃，你只会得到"}, {"type": "subtitle", "time": 4957.43, "timestamp": "01:22:37", "text": "仅需一台电脑，无需其他设备，也无需编写代码。但"}, {"type": "subtitle", "time": 4959.03, "timestamp": "01:22:39", "text": "速度快得惊人。所以，你不必……"}, {"type": "subtitle", "time": 4961.11, "timestamp": "01:22:41", "text": "别担心。然后就非常简单了。"}, {"type": "subtitle", "time": 4963.11, "timestamp": "01:22:43", "text": "你可以站在那里，然后问"}, {"type": "subtitle", "time": 4965.709, "timestamp": "01:22:45", "text": "能帮助你的人。只是"}, {"type": "subtitle", "time": 4968.87, "timestamp": "01:22:48", "text": "他们说他们会帮助你，然后你"}, {"type": "subtitle", "time": 4970.149, "timestamp": "01:22:50", "text": "无需做任何其他事情"}, {"type": "subtitle", "time": 4973.35, "timestamp": "01:22:53", "text": "那。然后带着它走到外面去。"}, {"type": "subtitle", "time": 4975.43, "timestamp": "01:22:55", "text": "网络求助。你去吧，我想你会的"}, {"type": "subtitle", "time": 4978.229, "timestamp": "01:22:58", "text": "乘坐地铁可直达任何地点"}, {"type": "subtitle", "time": 4979.99, "timestamp": "01:22:59", "text": "你要走了。千万不要乘坐出租车。"}]
[{"type": "subtitle", "time": 9004.79, "timestamp": "02:30:04", "text": "呃，我们该如何互相添加好友呢？"}, {"type": "subtitle", "time": 9006.469, "timestamp": "02:30:06", "text": "实际上？好的。好的。好的。让我们……"}, {"type": "subtitle", "time": 9008.309, "timestamp": "02:30:08", "text": "看。现在让我们看看。我们会想办法的。"}, {"type": "subtitle", "time": 9010.83, "timestamp": "02:30:10", "text": "出去。很好。"}, {"type": "subtitle", "time": 9015.27, "timestamp": "02:30:15", "text": "呃，多人游戏。创建大厅。私人的。"}, {"type": "subtitle", "time": 9018.389, "timestamp": "02:30:18", "text": "这是私人信息。是的。嗯，是的。"}, {"type": "subtitle", "time": 9021.63, "timestamp": "02:30:21", "text": "也包括首选语言。创造"}, {"type": "subtitle", "time": 9024.309, "timestamp": "02:30:24", "text": "大厅。这场比赛还是有点运气成分的。"}, {"type": "subtitle", "time": 9025.99, "timestamp": "02:30:25", "text": "所以我也不知道。"}, {"type": "subtitle", "time": 9029.83, "timestamp": "02:30:29", "text": "好的。邀请码。邀请码。哦，"}, {"type": "subtitle", "time": 9031.19, "timestamp": "02:30:31", "text": "是的。是的。是的。你告诉我邀请"}, {"type": "subtitle", "time": 9032.63, "timestamp": "02:30:32", "text": "代码。我忘了。我忘了。是的。是的。"}, {"type": "subtitle", "time": 9035.349, "timestamp": "02:30:35", "text": "是的。就是这样。好的。你"}, {"type": "subtitle", "time": 9039.389, "timestamp": "02:30:39", "text": "加入大厅，您的邀请码是"}, {"type": "subtitle", "time": 9043.71, "timestamp": "02:30:43", "text": "呃 90 52"}, {"type": "subtitle", "time": 9046.469, "timestamp": "02:30:46", "text": "以及其他猎人的请求名单"}, {"type": "subtitle", "time": 9048.469, "timestamp": "02:30:48", "text": "帮助。发过去。好的。你知道吗？"}, {"type": "subtitle", "time": 9050.95, "timestamp": "02:30:50", "text": "好的。好的。是的。我不认为人们"}, {"type": "subtitle", "time": 9055.19, "timestamp": "02:30:55", "text": "就像冲进溪流一样。"}, {"type": "subtitle", "time": 9058.469, "timestamp": "02:30:58", "text": "简直太棒了！我不认为我"}]
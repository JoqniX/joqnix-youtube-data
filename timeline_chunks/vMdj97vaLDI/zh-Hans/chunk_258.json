[{"type": "subtitle", "time": 15487.95, "timestamp": "04:18:07", "text": "你"}, {"type": "subtitle", "time": 15491.429, "timestamp": "04:18:11", "text": "想要点阵投影仪。你想要_____吗"}, {"type": "subtitle", "time": 15493.189, "timestamp": "04:18:13", "text": "买 你想让我买这个点吗？"}, {"type": "subtitle", "time": 15495.51, "timestamp": "04:18:15", "text": "你需要投影仪吗？"}, {"type": "subtitle", "time": 15498.149, "timestamp": "04:18:18", "text": "不，不。我们已经明白了。获取"}, {"type": "subtitle", "time": 15500.63, "timestamp": "04:18:20", "text": "那是免费装载的，对吧？不，"}, {"type": "subtitle", "time": 15502.469, "timestamp": "04:18:22", "text": "不，不。你拿不到免费赠品，"}, {"type": "subtitle", "time": 15505.03, "timestamp": "04:18:25", "text": "顺便一提。供参考。你得到一个“你做什么？”"}, {"type": "subtitle", "time": 15507.91, "timestamp": "04:18:27", "text": "意思是？你会得到一台摄像机。你"}, {"type": "subtitle", "time": 15510.63, "timestamp": "04:18:30", "text": "给你做个电磁场检测。你得到一个手电筒。"}, {"type": "subtitle", "time": 15513.83, "timestamp": "04:18:33", "text": "除了D之外，你什么都得到了。"}, {"type": "subtitle", "time": 15516.149, "timestamp": "04:18:36", "text": "某物。"}, {"type": "subtitle", "time": 15520.87, "timestamp": "04:18:40", "text": "哦，是的，65美元。我有90美元"}, {"type": "subtitle", "time": 15523.99, "timestamp": "04:18:43", "text": "现在轮到我了。我很害怕。兄弟，我们"}]
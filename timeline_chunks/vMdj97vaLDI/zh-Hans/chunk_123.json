[{"type": "subtitle", "time": 7380.79, "timestamp": "02:03:00", "text": "如果你想在……领域工作，需要建立人脉关系"}, {"type": "subtitle", "time": 7385.229, "timestamp": "02:03:05", "text": "日本公司嗯获取"}, {"type": "subtitle", "time": 7388.47, "timestamp": "02:03:08", "text": "准备好了，准备好了，我不知道"}, {"type": "subtitle", "time": 7391.149, "timestamp": "02:03:11", "text": "牺牲你的生命"}, {"type": "chat", "time": 7394.196, "timestamp": "02:03:14", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I never seen a streamer do so much haircare before 0.0"}, {"type": "subtitle", "time": 7394.31, "timestamp": "02:03:14", "text": "嗯。"}, {"type": "chat", "time": 7396.78, "timestamp": "02:03:16", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "having fun is also part of the trip"}, {"type": "subtitle", "time": 7399.39, "timestamp": "02:03:19", "text": "所以，祝你玩得愉快。小心。"}, {"type": "subtitle", "time": 7402.55, "timestamp": "02:03:22", "text": "是的。谢谢你今天抽出时间。"}, {"type": "subtitle", "time": 7404.51, "timestamp": "02:03:24", "text": "谢谢。我已经"}, {"type": "subtitle", "time": 7406.669, "timestamp": "02:03:26", "text": "从未如此"}, {"type": "subtitle", "time": 7409.99, "timestamp": "02:03:29", "text": "很多我，事情还好，我只是"}, {"type": "subtitle", "time": 7412.149, "timestamp": "02:03:32", "text": "洗完澡后，它就干了。"}, {"type": "subtitle", "time": 7413.589, "timestamp": "02:03:33", "text": "跟你说话。所以我不得不梳理我的"}, {"type": "subtitle", "time": 7415.669, "timestamp": "02:03:35", "text": "否则头发会变得非常……"}, {"type": "subtitle", "time": 7417.75, "timestamp": "02:03:37", "text": "像彻底崩溃了一样。所以我不得不"}, {"type": "subtitle", "time": 7419.83, "timestamp": "02:03:39", "text": "就像这样梳我的头发，但不是这样的"}, {"type": "subtitle", "time": 7423.43, "timestamp": "02:03:43", "text": "甚至还有一把梳子。这是一个拐角。"}, {"type": "subtitle", "time": 7429.03, "timestamp": "02:03:49", "text": "我知道这一点。我正在用它来梳头。"}, {"type": "subtitle", "time": 7430.95, "timestamp": "02:03:50", "text": "旅途中享受乐趣也是其中的一部分。"}, {"type": "subtitle", "time": 7432.709, "timestamp": "02:03:52", "text": "是的。是的。这其实算不上是一次旅行。"}, {"type": "subtitle", "time": 7434.39, "timestamp": "02:03:54", "text": "正确的？这不是一次旅行。我要搬家了。"}, {"type": "subtitle", "time": 7436.709, "timestamp": "02:03:56", "text": "那里。我会在那里待上两个多小时。"}, {"type": "subtitle", "time": 7439.43, "timestamp": "02:03:59", "text": "如果两者都是的话，那大概需要几年时间。是的。是的。"}]
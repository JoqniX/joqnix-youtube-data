[{"type": "subtitle", "time": 6420.95, "timestamp": "01:47:00", "text": "我不喜欢。食物是"}, {"type": "subtitle", "time": 6422.709, "timestamp": "01:47:02", "text": "非常糟糕。如果你要走，那就走吧"}, {"type": "subtitle", "time": 6424.149, "timestamp": "01:47:04", "text": "是为了体验，而不是为了食物。"}, {"type": "subtitle", "time": 6425.91, "timestamp": "01:47:05", "text": "我就是这么跟别人说的。食物是"}, {"type": "subtitle", "time": 6427.669, "timestamp": "01:47:07", "text": "拉屎。"}, {"type": "subtitle", "time": 6431.43, "timestamp": "01:47:11", "text": "他们让你做那些事之类的。你"}, {"type": "subtitle", "time": 6433.109, "timestamp": "01:47:13", "text": "你可以那样做，但是食物非常"}, {"type": "subtitle", "time": 6435.27, "timestamp": "01:47:15", "text": "糟糕。所以，别去吃东西。但"}, {"type": "subtitle", "time": 6444.709, "timestamp": "01:47:24", "text": "是的，很贵。我的天啊。是吗？"}, {"type": "subtitle", "time": 6446.79, "timestamp": "01:47:26", "text": "因为外国人税或"}, {"type": "subtitle", "time": 6449.35, "timestamp": "01:47:29", "text": "某物？它通常很贵。它"}, {"type": "subtitle", "time": 6451.51, "timestamp": "01:47:31", "text": "即使对于某些人来说，通常也很昂贵。"}, {"type": "subtitle", "time": 6453.83, "timestamp": "01:47:33", "text": "普通人。是的。你知道，并非如此"}, {"type": "subtitle", "time": 6455.99, "timestamp": "01:47:35", "text": "就像个外国人，因为这件事"}, {"type": "subtitle", "time": 6458.95, "timestamp": "01:47:38", "text": "医疗咖啡馆主要不是为了食物而设的，"}, {"type": "subtitle", "time": 6460.47, "timestamp": "01:47:40", "text": "为了人民和娱乐"}, {"type": "subtitle", "time": 6462.91, "timestamp": "01:47:42", "text": "主题。所以如果你要去任何地方"}, {"type": "subtitle", "time": 6465.43, "timestamp": "01:47:45", "text": "去餐厅，你就会知道食物"}, {"type": "subtitle", "time": 6467.109, "timestamp": "01:47:47", "text": "会很贵。如果你只是去"}, {"type": "subtitle", "time": 6470.39, "timestamp": "01:47:50", "text": "去任何咖啡馆，任何类似的餐厅，是的。"}, {"type": "subtitle", "time": 6471.55, "timestamp": "01:47:51", "text": "这将是"}, {"type": "subtitle", "time": 6474.07, "timestamp": "01:47:54", "text": "价格便宜，比如低于2000元，你就能得到一个"}, {"type": "subtitle", "time": 6475.75, "timestamp": "01:47:55", "text": "一顿饭。炸猪排饭，你会得到它"}, {"type": "subtitle", "time": 6479.189, "timestamp": "01:47:59", "text": "什么？ 2000日元，2500日元。这就像非常"}]
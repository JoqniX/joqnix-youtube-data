[{"type": "subtitle", "time": 7441.589, "timestamp": "02:04:01", "text": "是的。如果你想的话，试着去做吧"}, {"type": "subtitle", "time": 7445.03, "timestamp": "02:04:05", "text": "可以兼职。人们确实"}, {"type": "chat", "time": 7447.404, "timestamp": "02:04:07", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "holy"}, {"type": "subtitle", "time": 7447.51, "timestamp": "02:04:07", "text": "参加。兼职是强制性的"}, {"type": "subtitle", "time": 7449.75, "timestamp": "02:04:09", "text": "我。呃，我得做兼职才能维持生计。"}, {"type": "subtitle", "time": 7452.95, "timestamp": "02:04:12", "text": "在那里支付生活费，"}, {"type": "subtitle", "time": 7456.75, "timestamp": "02:04:16", "text": "食物和其他一切都好。啊，那真不错。"}, {"type": "subtitle", "time": 7460.79, "timestamp": "02:04:20", "text": "驴驴。嗯，我觉得驴挺可爱的。"}, {"type": "subtitle", "time": 7463.27, "timestamp": "02:04:23", "text": "有时是兼职，因为很多"}, {"type": "subtitle", "time": 7465.189, "timestamp": "02:04:25", "text": "外国人来这里是为了驴。所以"}, {"type": "subtitle", "time": 7466.95, "timestamp": "02:04:26", "text": "有时他们会要求英语"}, {"type": "subtitle", "time": 7471.03, "timestamp": "02:04:31", "text": "会说话的人。嗯。是的。所以即使只有一次"}, {"type": "subtitle", "time": 7473.109, "timestamp": "02:04:33", "text": "我当时必须买点东西，而他们"}, {"type": "subtitle", "time": 7474.709, "timestamp": "02:04:34", "text": "人们不理解，我也不理解。"}, {"type": "subtitle", "time": 7476.87, "timestamp": "02:04:36", "text": "知道日语中对应的词是什么吗？所以，我"}, {"type": "subtitle", "time": 7480.629, "timestamp": "02:04:40", "text": "问得好像任何人都能说英语似的。"}, {"type": "subtitle", "time": 7483.189, "timestamp": "02:04:43", "text": "他们必须喜欢，然后他们还得带来"}, {"type": "subtitle", "time": 7485.99, "timestamp": "02:04:45", "text": "一个人，然后直接跟我说话，非常"}, {"type": "subtitle", "time": 7489.75, "timestamp": "02:04:49", "text": "好吧，我看到了我喜欢的那个人。"}, {"type": "subtitle", "time": 7492.79, "timestamp": "02:04:52", "text": "当他用印度语说话时，那兄弟是"}, {"type": "subtitle", "time": 7495.109, "timestamp": "02:04:55", "text": "印度人好的"}, {"type": "subtitle", "time": 7497.75, "timestamp": "02:04:57", "text": "他来了，而且一丝不苟。"}, {"type": "subtitle", "time": 7499.83, "timestamp": "02:04:59", "text": "我刚才去了，你知道，印地语，然后他就"}]
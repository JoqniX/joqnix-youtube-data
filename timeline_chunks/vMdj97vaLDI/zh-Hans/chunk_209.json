[{"type": "subtitle", "time": 12541.11, "timestamp": "03:29:01", "text": "糟糕。这扇门打不开。"}, {"type": "subtitle", "time": 12542.309, "timestamp": "03:29:02", "text": "是的。是的。过来。过来。患病的"}, {"type": "subtitle", "time": 12545.67, "timestamp": "03:29:05", "text": "打开它。我来打开它。去。去。好的。"}, {"type": "subtitle", "time": 12548.11, "timestamp": "03:29:08", "text": "没关系。我当时就想，“哦，确实如此。”"}, {"type": "subtitle", "time": 12552.07, "timestamp": "03:29:12", "text": "哦真的吗？真的有那么多吗？这么快？"}, {"type": "subtitle", "time": 12564.389, "timestamp": "03:29:24", "text": "经过。"}, {"type": "subtitle", "time": 12569.75, "timestamp": "03:29:29", "text": "我们回家吧。我们回家吧。我们走吧"}, {"type": "subtitle", "time": 12572.19, "timestamp": "03:29:32", "text": "家。不，不，不，不。我们不去。"}, {"type": "subtitle", "time": 12573.87, "timestamp": "03:29:33", "text": "家。"}, {"type": "subtitle", "time": 12577.79, "timestamp": "03:29:37", "text": "上帝啊，请您冷静下来。冷静下来。"}, {"type": "subtitle", "time": 12580.229, "timestamp": "03:29:40", "text": "为什么？你如何……你如何拿起这个"}, {"type": "subtitle", "time": 12582.11, "timestamp": "03:29:42", "text": "事物？哦，"}, {"type": "subtitle", "time": 12585.51, "timestamp": "03:29:45", "text": "他妈的。呃，好的。是的，我捡到了。"}, {"type": "subtitle", "time": 12592.71, "timestamp": "03:29:52", "text": "嘿，我们走吧。哦，拜托。没关系。"}, {"type": "subtitle", "time": 12596.71, "timestamp": "03:29:56", "text": "我们需要它吗？我们还需要别的吗？"}, {"type": "subtitle", "time": 12598.71, "timestamp": "03:29:58", "text": "嗨，我不小心拍了一张照片。哦，我的"}]
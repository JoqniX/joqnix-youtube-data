[{"type": "subtitle", "time": 7200.27, "timestamp": "02:00:00", "text": "这样行得通吗？"}, {"type": "subtitle", "time": 7202.95, "timestamp": "02:00:02", "text": "所以，但是，但是，我建议带上"}, {"type": "subtitle", "time": 7204.35, "timestamp": "02:00:04", "text": "你自己的"}, {"type": "subtitle", "time": 7206.709, "timestamp": "02:00:06", "text": "玛萨拉。禁止携带肉类。肉类和"}, {"type": "subtitle", "time": 7209.75, "timestamp": "02:00:09", "text": "像那种肉类制品是不允许的。"}, {"type": "subtitle", "time": 7211.35, "timestamp": "02:00:11", "text": "但是，玛萨拉香料应该很像……"}, {"type": "subtitle", "time": 7215.189, "timestamp": "02:00:15", "text": "玛萨拉粉，因为我"}, {"type": "subtitle", "time": 7218.149, "timestamp": "02:00:18", "text": "就像 hajimmula immli 那样。我得到了"}, {"type": "subtitle", "time": 7220.629, "timestamp": "02:00:20", "text": "很多东西，这样我就可以吃了。"}, {"type": "subtitle", "time": 7227.91, "timestamp": "02:00:27", "text": "是啊，但是医疗费用很贵。怎么样？"}, {"type": "subtitle", "time": 7230.47, "timestamp": "02:00:30", "text": "你当时的行李箱"}, {"type": "subtitle", "time": 7232.79, "timestamp": "02:00:32", "text": "去日本旅游吗？有多少件行李"}, {"type": "subtitle", "time": 7237.27, "timestamp": "02:00:37", "text": "你和谁一起去？只有两个。一只手"}, {"type": "subtitle", "time": 7241.35, "timestamp": "02:00:41", "text": "行李，一件带走，就像去哪里"}, {"type": "subtitle", "time": 7243.669, "timestamp": "02:00:43", "text": "其中一件是手提行李，一件是类似"}, {"type": "subtitle", "time": 7245.83, "timestamp": "02:00:45", "text": "手提行李箱，但我认为你"}, {"type": "subtitle", "time": 7248.149, "timestamp": "02:00:48", "text": "确实需要很多。所以包裹"}, {"type": "subtitle", "time": 7251.189, "timestamp": "02:00:51", "text": "也很好。打包也很好。哦"}, {"type": "subtitle", "time": 7253.91, "timestamp": "02:00:53", "text": "我们可以从印度邮寄到日本。"}, {"type": "subtitle", "time": 7255.91, "timestamp": "02:00:55", "text": "你可以很容易地做到，我们已经做到了。"}, {"type": "subtitle", "time": 7257.91, "timestamp": "02:00:57", "text": "很多时间。如果你想知道"}, {"type": "subtitle", "time": 7259.91, "timestamp": "02:00:59", "text": "关于这一点，我可以问，因为我有一个"}]
[{"type": "subtitle", "time": 3000.63, "timestamp": "00:50:00", "text": "跟我一起吃香蕉核桃蛋糕。哦，"}, {"type": "subtitle", "time": 3004.15, "timestamp": "00:50:04", "text": "我要把它吃掉。我该怎么……"}, {"type": "subtitle", "time": 3006.71, "timestamp": "00:50:06", "text": "讨厌打开这个吗？我不"}, {"type": "subtitle", "time": 3009.03, "timestamp": "00:50:09", "text": "知道怎么打开它。"}, {"type": "chat", "time": 3009.436, "timestamp": "00:50:09", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "banana and wallnut?"}, {"type": "subtitle", "time": 3012.589, "timestamp": "00:50:12", "text": "啊，是塑料薄膜。是的，"}, {"type": "subtitle", "time": 3014.71, "timestamp": "00:50:14", "text": "塑料。但我知道最好的方法是"}, {"type": "subtitle", "time": 3024.47, "timestamp": "00:50:24", "text": "笔。是的。打几个孔。"}, {"type": "subtitle", "time": 3026.71, "timestamp": "00:50:26", "text": "打孔。小心别打到人"}, {"type": "subtitle", "time": 3028.829, "timestamp": "00:50:28", "text": "这"}, {"type": "subtitle", "time": 3031.51, "timestamp": "00:50:31", "text": "蛋糕。如果纳比正在看着"}, {"type": "subtitle", "time": 3034.27, "timestamp": "00:50:34", "text": "这是，这是你的"}, {"type": "subtitle", "time": 3037.549, "timestamp": "00:50:37", "text": "笔。我很抱歉，"}, {"type": "subtitle", "time": 3040.069, "timestamp": "00:50:40", "text": "先知。这就是你让我这么做的下场"}, {"type": "subtitle", "time": 3042.43, "timestamp": "00:50:42", "text": "照看孩子"}, {"type": "subtitle", "time": 3047.91, "timestamp": "00:50:47", "text": "pe。好的。香蕉和核桃。是的。"}, {"type": "subtitle", "time": 3049.549, "timestamp": "00:50:49", "text": "这"}, {"type": "subtitle", "time": 3055.43, "timestamp": "00:50:55", "text": "热的。总之，哦，你们有个空缺。"}, {"type": "subtitle", "time": 3057.99, "timestamp": "00:50:57", "text": "这里。"}]
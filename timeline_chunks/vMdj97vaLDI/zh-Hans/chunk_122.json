[{"type": "subtitle", "time": 7321.189, "timestamp": "02:02:01", "text": "工作。嗯"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "是的，谢谢你今天的时间。谢谢你"}, {"type": "chat", "time": 7327.762, "timestamp": "02:02:07", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "ggs saiko"}, {"type": "subtitle", "time": 7327.99, "timestamp": "02:02:07", "text": "慢慢来，我希望，我希望它"}, {"type": "subtitle", "time": 7329.47, "timestamp": "02:02:09", "text": "变成了"}, {"type": "subtitle", "time": 7333.189, "timestamp": "02:02:13", "text": "教育方向。"}, {"type": "subtitle", "time": 7336.709, "timestamp": "02:02:16", "text": "时隔这么久，我们玩得很开心"}, {"type": "subtitle", "time": 7339.43, "timestamp": "02:02:19", "text": "比如聊天和闲逛。感觉如此"}, {"type": "subtitle", "time": 7342.55, "timestamp": "02:02:22", "text": "好的。感觉非常好。我感觉"}, {"type": "subtitle", "time": 7345.669, "timestamp": "02:02:25", "text": "聊了很多次之后感觉很好"}, {"type": "subtitle", "time": 7348.79, "timestamp": "02:02:28", "text": "与PBO以外的其他人交谈"}, {"type": "subtitle", "time": 7351.83, "timestamp": "02:02:31", "text": "以及除了说话之外的其他人"}, {"type": "subtitle", "time": 7353.91, "timestamp": "02:02:33", "text": "你跟某人打招呼，比如“你好，你好吗？”"}, {"type": "subtitle", "time": 7356.87, "timestamp": "02:02:36", "text": "你？它很好。我希望我希望你"}, {"type": "subtitle", "time": 7359.03, "timestamp": "02:02:39", "text": "不过，好好享受吧。最重要的是享受"}, {"type": "subtitle", "time": 7361.669, "timestamp": "02:02:41", "text": "不一定非得喜欢它，毕竟是个新地方。"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "这是一个新地方。你可能会，但我不会。"}, {"type": "subtitle", "time": 7366.87, "timestamp": "02:02:46", "text": "如果你性格内向，你可能会"}, {"type": "subtitle", "time": 7369.83, "timestamp": "02:02:49", "text": "感觉就像，呃，我不知道，有时候你"}, {"type": "subtitle", "time": 7371.27, "timestamp": "02:02:51", "text": "可能会感到被冷落之类的，但"}, {"type": "subtitle", "time": 7373.75, "timestamp": "02:02:53", "text": "比如试着去社交，就是这样。"}, {"type": "subtitle", "time": 7375.83, "timestamp": "02:02:55", "text": "我说人们试图进行社交，并拥有……"}, {"type": "subtitle", "time": 7378.39, "timestamp": "02:02:58", "text": "记忆力好，如果能跟上他们的步伐就好了"}, {"type": "subtitle", "time": 7379.35, "timestamp": "02:02:59", "text": "你要去那里"}]
[{"type": "subtitle", "time": 13988.15, "timestamp": "03:53:08", "text": "你在这里吗？"}, {"type": "subtitle", "time": 14001.189, "timestamp": "03:53:21", "text": "你还好吗？是的。是的。那里有一台摄像机"}, {"type": "subtitle", "time": 14003.91, "timestamp": "03:53:23", "text": "在那边。"}, {"type": "subtitle", "time": 14013.51, "timestamp": "03:53:33", "text": "哦，我们得下去。就在这里。"}, {"type": "subtitle", "time": 14019.189, "timestamp": "03:53:39", "text": "不用担心。可能有人洒了东西。"}, {"type": "subtitle", "time": 14021.91, "timestamp": "03:53:41", "text": "番茄酱。我的天啊。"}, {"type": "subtitle", "time": 14023.79, "timestamp": "03:53:43", "text": "哦，是的。"}, {"type": "subtitle", "time": 14026.229, "timestamp": "03:53:46", "text": "番茄酱。他们浪费番茄酱，我的"}, {"type": "subtitle", "time": 14029.189, "timestamp": "03:53:49", "text": "男。我不认识这些人。我不"}, {"type": "subtitle", "time": 14033.51, "timestamp": "03:53:53", "text": "知道。那扇门是敞开的。"}, {"type": "subtitle", "time": 14035.389, "timestamp": "03:53:55", "text": "我们走吧"}, {"type": "subtitle", "time": 14037.87, "timestamp": "03:53:57", "text": "然后。你在吗？"}]
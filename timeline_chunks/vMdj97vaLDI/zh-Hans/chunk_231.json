[{"type": "subtitle", "time": 13860.63, "timestamp": "03:51:00", "text": "好的。等待。这里地方很大。哇。"}, {"type": "subtitle", "time": 13863.75, "timestamp": "03:51:03", "text": "哦，这时我们选择随机选项。"}, {"type": "subtitle", "time": 13865.67, "timestamp": "03:51:05", "text": "带你到你从未去过的地图上"}, {"type": "subtitle", "time": 13868.389, "timestamp": "03:51:08", "text": "已经很久了。哦，等等。我没有接受"}, {"type": "subtitle", "time": 13870.55, "timestamp": "03:51:10", "text": "任何事物。等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 13872.349, "timestamp": "03:51:12", "text": "让我拿点东西。等等，等等，等等"}, {"type": "subtitle", "time": 13879.83, "timestamp": "03:51:19", "text": "这。好的。我该带这本书吗？"}, {"type": "subtitle", "time": 13881.389, "timestamp": "03:51:21", "text": "是的，你应该接受"}, {"type": "subtitle", "time": 13884.55, "timestamp": "03:51:24", "text": "书。嘘。"}, {"type": "subtitle", "time": 13887.91, "timestamp": "03:51:27", "text": "哦，走吧。我很高兴我喜欢增加"}, {"type": "subtitle", "time": 13892.15, "timestamp": "03:51:32", "text": "我的亮度稍微调高了一点。就像我"}, {"type": "subtitle", "time": 13895.03, "timestamp": "03:51:35", "text": "就像这样，我现在就能看到了"}, {"type": "subtitle", "time": 13898.309, "timestamp": "03:51:38", "text": "就像“看吧，我早就告诉过你了，对吧？”"}, {"type": "subtitle", "time": 13900.71, "timestamp": "03:51:40", "text": "你看，我早就跟你说了吧，兄弟？虽然"}, {"type": "subtitle", "time": 13902.189, "timestamp": "03:51:42", "text": "这是"}, {"type": "subtitle", "time": 13904.55, "timestamp": "03:51:44", "text": "作弊。美好的。因为我甚至都做不到"}, {"type": "subtitle", "time": 13906.83, "timestamp": "03:51:46", "text": "不再玩这个游戏了。"}, {"type": "subtitle", "time": 13909.67, "timestamp": "03:51:49", "text": "这简直太可怕了。看起来"}, {"type": "subtitle", "time": 13912.79, "timestamp": "03:51:52", "text": "像一座城堡。"}, {"type": "subtitle", "time": 13915.83, "timestamp": "03:51:55", "text": "是的。再见。哦，你好。"}, {"type": "subtitle", "time": 13919.11, "timestamp": "03:51:59", "text": "这太诡异了。什么？"}]
[{"type": "subtitle", "time": 10262.83, "timestamp": "02:51:02", "text": "减。必须用负数表示。"}, {"type": "subtitle", "time": 10266.55, "timestamp": "02:51:06", "text": "好的。所以，我的电磁场辐射水平确实达到了五级。"}, {"type": "subtitle", "time": 10267.99, "timestamp": "02:51:07", "text": "尽管。所以，我接受这个提议。"}, {"type": "subtitle", "time": 10272.79, "timestamp": "02:51:12", "text": "目前。是的。是的。 EMF5。耶稣。"}, {"type": "subtitle", "time": 10275.349, "timestamp": "02:51:15", "text": "是的。红色的那一个。红色的那一个。"}, {"type": "subtitle", "time": 10277.51, "timestamp": "02:51:17", "text": "是的。好的。我还要再选一个。"}, {"type": "subtitle", "time": 10279.23, "timestamp": "02:51:19", "text": "时间。你在吗？"}, {"type": "subtitle", "time": 10281.71, "timestamp": "02:51:21", "text": "这里？在哪里？"}, {"type": "subtitle", "time": 10285.51, "timestamp": "02:51:25", "text": "你？糟糕。这是狩猎，狩猎，"}, {"type": "subtitle", "time": 10287.11, "timestamp": "02:51:27", "text": "狩猎，狩猎，狩猎，狩猎"}, {"type": "subtitle", "time": 10288.79, "timestamp": "02:51:28", "text": "打猎。我死了。我死了。我 我"}, {"type": "subtitle", "time": 10290.469, "timestamp": "02:51:30", "text": "死的。"}, {"type": "subtitle", "time": 10292.87, "timestamp": "02:51:32", "text": "妈的。拉屎。拉屎。我不知道该怎么做"}, {"type": "subtitle", "time": 10294.07, "timestamp": "02:51:34", "text": "隐藏。我不知道该如何躲藏。哦，我的"}, {"type": "subtitle", "time": 10296.51, "timestamp": "02:51:36", "text": "上帝。我的天啊。令人毛骨悚然的"}, {"type": "subtitle", "time": 10299.19, "timestamp": "02:51:39", "text": "雄鹿。我的天啊。我的天啊。我不想"}, {"type": "subtitle", "time": 10303.349, "timestamp": "02:51:43", "text": "所以，老太太，我不知道我是不是"}, {"type": "subtitle", "time": 10306.23, "timestamp": "02:51:46", "text": "害怕女人。我不知道。哦，"}, {"type": "subtitle", "time": 10309.59, "timestamp": "02:51:49", "text": "好的。我，你在哪里，乔克？我同意了。"}, {"type": "subtitle", "time": 10312.55, "timestamp": "02:51:52", "text": "我躲在衣柜里。死的。"}, {"type": "subtitle", "time": 10317.83, "timestamp": "02:51:57", "text": "死的。是的。哦，不。你死定了。哦，不。"}]
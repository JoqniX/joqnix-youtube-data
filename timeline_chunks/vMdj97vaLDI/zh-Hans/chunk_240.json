[{"type": "subtitle", "time": 14401.309, "timestamp": "04:00:01", "text": "穿墙而过。耶稣"}, {"type": "subtitle", "time": 14403.99, "timestamp": "04:00:03", "text": "怪胎几乎从不落地"}, {"type": "subtitle", "time": 14407.189, "timestamp": "04:00:07", "text": "这意味着你不能通过脚印来设陷阱。"}, {"type": "subtitle", "time": 14409.91, "timestamp": "04:00:09", "text": "弱点在于害怕盐和"}, {"type": "subtitle", "time": 14419.59, "timestamp": "04:00:19", "text": "em5灵盒和"}, {"type": "subtitle", "time": 14423.83, "timestamp": "04:00:23", "text": "呃，点阵投影仪耶稣基督"}, {"type": "subtitle", "time": 14430.469, "timestamp": "04:00:30", "text": "我不……不，就是那个……就是那个问题。"}, {"type": "subtitle", "time": 14432.87, "timestamp": "04:00:32", "text": "就是那种绿色的东西。好的。好的。好的。"}, {"type": "subtitle", "time": 14435.67, "timestamp": "04:00:35", "text": "你能看到吗？喜欢"}, {"type": "subtitle", "time": 14438.469, "timestamp": "04:00:38", "text": "第二台摄像机。这"}, {"type": "subtitle", "time": 14442.55, "timestamp": "04:00:42", "text": "接下来是DOS投影仪。知道了。得到"}, {"type": "subtitle", "time": 14446.67, "timestamp": "04:00:46", "text": "它。是的。是的。那就是点。"}, {"type": "subtitle", "time": 14448.87, "timestamp": "04:00:48", "text": "投影仪。那么，我们来谈谈……"}, {"type": "subtitle", "time": 14451.269, "timestamp": "04:00:51", "text": "幻影。幽灵就是鬼魂。"}, {"type": "subtitle", "time": 14454.07, "timestamp": "04:00:54", "text": "可以拥有活生生的、不断涌入的恐惧"}, {"type": "subtitle", "time": 14457.189, "timestamp": "04:00:57", "text": "围绕着它。这种情况几乎很常见"}]
[{"type": "subtitle", "time": 14040.95, "timestamp": "03:54:00", "text": "这里？你在哪里？我应该"}, {"type": "subtitle", "time": 14042.87, "timestamp": "03:54:02", "text": "我喜欢问这个问题。我有点儿明白你的意思了。"}, {"type": "subtitle", "time": 14047.51, "timestamp": "03:54:07", "text": "看，还有番茄酱。哦，不是的。"}, {"type": "subtitle", "time": 14050.83, "timestamp": "03:54:10", "text": "番茄酱。没关系。虚惊。错误的"}, {"type": "subtitle", "time": 14053.11, "timestamp": "03:54:13", "text": "警报。好的。好的。好的。好的。我要走了"}, {"type": "subtitle", "time": 14055.11, "timestamp": "03:54:15", "text": "独自一人在里面。如果我死了，那就死了。它是"}, {"type": "subtitle", "time": 14058.389, "timestamp": "03:54:18", "text": "美好的。哦，我要进去了。"}, {"type": "subtitle", "time": 14059.71, "timestamp": "03:54:19", "text": "你在吗？"}, {"type": "subtitle", "time": 14062.79, "timestamp": "03:54:22", "text": "这里？你在哪里？我应该等吗？"}, {"type": "subtitle", "time": 14065.429, "timestamp": "03:54:25", "text": "你还是我直接走？他们多大了？"}, {"type": "subtitle", "time": 14072.91, "timestamp": "03:54:32", "text": "我的天啊，好吓人"}, {"type": "subtitle", "time": 14075.91, "timestamp": "03:54:35", "text": "我。 WHO？那个人是谁？"}, {"type": "subtitle", "time": 14078.95, "timestamp": "03:54:38", "text": "敲门了吗？"}, {"type": "subtitle", "time": 14081.91, "timestamp": "03:54:41", "text": "好的。"}, {"type": "subtitle", "time": 14085.03, "timestamp": "03:54:45", "text": "那个闪闪发光的东西是什么？哦，那是"}, {"type": "subtitle", "time": 14087.189, "timestamp": "03:54:47", "text": "我。"}, {"type": "subtitle", "time": 14089.99, "timestamp": "03:54:49", "text": "那个Shin是谁？"}, {"type": "subtitle", "time": 14092.07, "timestamp": "03:54:52", "text": "那位中国亮光是谁？"}, {"type": "subtitle", "time": 14095.11, "timestamp": "03:54:55", "text": "番茄酱。那是番茄酱。哦不，他们他们"}, {"type": "subtitle", "time": 14097.67, "timestamp": "03:54:57", "text": "番茄酱洒得到处都是。非常笨拙"}, {"type": "subtitle", "time": 14099.99, "timestamp": "03:54:59", "text": "食客。等等，如果你往里看一眼，"}]
[{"type": "subtitle", "time": 8163.83, "timestamp": "02:16:03", "text": "与呃他们有联系，他们是他们"}, {"type": "subtitle", "time": 8167.83, "timestamp": "02:16:07", "text": "有点像公司了。所以，呃，大部分"}, {"type": "subtitle", "time": 8170.95, "timestamp": "02:16:10", "text": "伊恩和我联系过的人"}, {"type": "subtitle", "time": 8173.35, "timestamp": "02:16:13", "text": "他们变成了公司。所以这对……来说很难"}, {"type": "subtitle", "time": 8174.83, "timestamp": "02:16:14", "text": "让我到达"}, {"type": "subtitle", "time": 8184.47, "timestamp": "02:16:24", "text": "完毕。我很高兴能联系到您"}, {"type": "subtitle", "time": 8186.709, "timestamp": "02:16:26", "text": "人们。我可以和他们谈过。"}, {"type": "subtitle", "time": 8190.47, "timestamp": "02:16:30", "text": "甚至还和年纪较大的人进行了交流。"}, {"type": "subtitle", "time": 8193.75, "timestamp": "02:16:33", "text": "是的，在我之前我们就会有人了。"}, {"type": "subtitle", "time": 8197.349, "timestamp": "02:16:37", "text": "VTuber 嗯，时间。我遇到的那些人"}, {"type": "subtitle", "time": 8200.79, "timestamp": "02:16:40", "text": "在我开始做 YouTube 之前，大概是 2018 年。"}, {"type": "subtitle", "time": 8202.549, "timestamp": "02:16:42", "text": "2017"}, {"type": "subtitle", "time": 8206.429, "timestamp": "02:16:46", "text": "嗯，是的，2017年我认识的人"}, {"type": "subtitle", "time": 8209.99, "timestamp": "02:16:49", "text": "抽搐。我已经联系了其中两位"}, {"type": "subtitle", "time": 8212.87, "timestamp": "02:16:52", "text": "他们。不确定他们是否还在那里。"}, {"type": "subtitle", "time": 8216.309, "timestamp": "02:16:56", "text": "但其中一人回复了。所以我们会有"}, {"type": "subtitle", "time": 8219.27, "timestamp": "02:16:59", "text": "爱上其中一个，还有另一个，"}]
[{"type": "subtitle", "time": 14824.95, "timestamp": "04:07:04", "text": "情绪化。好了，我们抓到他们了。我接受。我们"}, {"type": "subtitle", "time": 14828.469, "timestamp": "04:07:08", "text": "具有发射器。我们有灵盒。"}, {"type": "subtitle", "time": 14830.229, "timestamp": "04:07:10", "text": "约翰，你不需要手电筒吗？你"}, {"type": "subtitle", "time": 14832.71, "timestamp": "04:07:12", "text": "你确定吗？我来拍照，"}, {"type": "subtitle", "time": 14845.03, "timestamp": "04:07:25", "text": "我们找不到鬼魂就不回家。"}, {"type": "subtitle", "time": 14856.55, "timestamp": "04:07:36", "text": "上帝。为什么这个地方突然变得这么低"}, {"type": "subtitle", "time": 14859.71, "timestamp": "04:07:39", "text": "聚合物？顺便说一句，你"}, {"type": "subtitle", "time": 14862.389, "timestamp": "04:07:42", "text": "各位，没事的，我要一个人待一段时间。"}, {"type": "subtitle", "time": 14865.07, "timestamp": "04:07:45", "text": "一秒钟。如果"}, {"type": "subtitle", "time": 14867.79, "timestamp": "04:07:47", "text": "你在吗？"}, {"type": "subtitle", "time": 14874.63, "timestamp": "04:07:54", "text": "你？好的。"}, {"type": "subtitle", "time": 14876.07, "timestamp": "04:07:56", "text": "没有什么。我正在速通整个游戏"}, {"type": "subtitle", "time": 14878.389, "timestamp": "04:07:58", "text": "地方。好的。"}]
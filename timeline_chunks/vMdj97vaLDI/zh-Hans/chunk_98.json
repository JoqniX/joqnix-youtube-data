[{"type": "subtitle", "time": 5883.35, "timestamp": "01:38:03", "text": "这里还有另外两位同事。所以"}, {"type": "subtitle", "time": 5885.59, "timestamp": "01:38:05", "text": "我们三个人要去见老板。所以我们就这么做了。"}, {"type": "subtitle", "time": 5887.51, "timestamp": "01:38:07", "text": "会议结束后，我们一起吃了公司晚餐。"}, {"type": "subtitle", "time": 5889.75, "timestamp": "01:38:09", "text": "然后他就出现在我面前，"}, {"type": "subtitle", "time": 5891.43, "timestamp": "01:38:11", "text": "那时我就​​和他截然相反了。所以"}, {"type": "subtitle", "time": 5893.83, "timestamp": "01:38:13", "text": "问题是只有我一个人在喝酒。"}, {"type": "subtitle", "time": 5896.07, "timestamp": "01:38:16", "text": "好的。那两个人没有喝酒。所以，我"}, {"type": "subtitle", "time": 5898.27, "timestamp": "01:38:18", "text": "必须是那个必须……的人"}, {"type": "subtitle", "time": 5901.75, "timestamp": "01:38:21", "text": "就像公司老板萨乔一样。"}, {"type": "subtitle", "time": 5904.229, "timestamp": "01:38:24", "text": "你得陪着萨乔。所以，我当时"}, {"type": "subtitle", "time": 5906.229, "timestamp": "01:38:26", "text": "就像他每次喝完饮料一样"}, {"type": "subtitle", "time": 5909.35, "timestamp": "01:38:29", "text": "我做完之后，他就会像你想要的那样。"}, {"type": "subtitle", "time": 5911.51, "timestamp": "01:38:31", "text": "我们还要更多，然后我们再多要一些。而我当时"}, {"type": "subtitle", "time": 5913.27, "timestamp": "01:38:33", "text": "好的。然后我也会采取同样的做法。"}, {"type": "subtitle", "time": 5915.109, "timestamp": "01:38:35", "text": "像他这样的人很多。所以我就那样想了"}, {"type": "subtitle", "time": 5918.47, "timestamp": "01:38:38", "text": "喝完就像喝了五瓶啤酒一样。"}, {"type": "subtitle", "time": 5921.79, "timestamp": "01:38:41", "text": "我的天啊。然后我就"}, {"type": "subtitle", "time": 5925.27, "timestamp": "01:38:45", "text": "就像去喝葡萄酒一样，就像……"}, {"type": "subtitle", "time": 5927.27, "timestamp": "01:38:47", "text": "问题是总得有人陪同，而我"}, {"type": "subtitle", "time": 5929.03, "timestamp": "01:38:49", "text": "只有他一个人在喝酒。所以，我"}, {"type": "subtitle", "time": 5931.95, "timestamp": "01:38:51", "text": "他就像美酒，而我……"}, {"type": "subtitle", "time": 5934.229, "timestamp": "01:38:54", "text": "然后他就直接倒了起来。我"}, {"type": "subtitle", "time": 5936.55, "timestamp": "01:38:56", "text": "我当时就想，好吧，我就让他倒吧。"}, {"type": "subtitle", "time": 5939.27, "timestamp": "01:38:59", "text": "就这样，然后我就慢慢地"}]
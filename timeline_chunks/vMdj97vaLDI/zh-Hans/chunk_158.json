[{"type": "subtitle", "time": 9480.95, "timestamp": "02:38:00", "text": "好的。我无法选择难度。为什么？"}, {"type": "subtitle", "time": 9483.27, "timestamp": "02:38:03", "text": "哦。哦，因为我成了领导者，因为"}, {"type": "subtitle", "time": 9485.23, "timestamp": "02:38:05", "text": "你离开了。"}, {"type": "subtitle", "time": 9488.389, "timestamp": "02:38:08", "text": "不。请问可以让我当领导吗？"}, {"type": "subtitle", "time": 9490.71, "timestamp": "02:38:10", "text": "好的。我们需要重制……我们需要……"}, {"type": "subtitle", "time": 9493.03, "timestamp": "02:38:13", "text": "重制《不，不，好的》。好的。然后就像"}, {"type": "subtitle", "time": 9495.19, "timestamp": "02:38:15", "text": "你来设定难度。我们来吧"}, {"type": "subtitle", "time": 9496.469, "timestamp": "02:38:16", "text": "它。"}, {"type": "subtitle", "time": 9500.79, "timestamp": "02:38:20", "text": "让我们用专业的方式来处理。我们走吧。嗯？"}, {"type": "subtitle", "time": 9504.55, "timestamp": "02:38:24", "text": "是的，让我们走向专业化。嗯？"}, {"type": "subtitle", "time": 9506.71, "timestamp": "02:38:26", "text": "是的。为什么？你需要热身。好的，我们"}, {"type": "subtitle", "time": 9509.83, "timestamp": "02:38:29", "text": "我们可以做个热身运动吗？"}, {"type": "subtitle", "time": 9526.07, "timestamp": "02:38:46", "text": "我需要一支手电筒。不是强光手电筒"}, {"type": "subtitle", "time": 9528.95, "timestamp": "02:38:48", "text": "光。"}, {"type": "subtitle", "time": 9531.51, "timestamp": "02:38:51", "text": "答应我，你会一直陪着我。好的。做"}]
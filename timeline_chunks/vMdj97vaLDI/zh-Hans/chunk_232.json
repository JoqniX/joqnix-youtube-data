[{"type": "subtitle", "time": 13920.95, "timestamp": "03:52:00", "text": "我们随时都可能死在这里的任何一个地方。"}, {"type": "subtitle", "time": 13923.349, "timestamp": "03:52:03", "text": "我猜也是。嗯，"}, {"type": "subtitle", "time": 13925.189, "timestamp": "03:52:05", "text": "这是像射击一样吗？哦，我以为是这样。"}, {"type": "subtitle", "time": 13933.469, "timestamp": "03:52:13", "text": "楼梯。你在吗？"}, {"type": "subtitle", "time": 13936.99, "timestamp": "03:52:16", "text": "这里？在哪里？"}, {"type": "subtitle", "time": 13939.87, "timestamp": "03:52:19", "text": "你？在哪里？"}, {"type": "subtitle", "time": 13943.75, "timestamp": "03:52:23", "text": "你？哦，楼下还有。"}, {"type": "subtitle", "time": 13947.51, "timestamp": "03:52:27", "text": "老兄，看看这地方。"}, {"type": "subtitle", "time": 13955.349, "timestamp": "03:52:35", "text": "有人问：这是什么仪式？等等，是"}, {"type": "subtitle", "time": 13957.59, "timestamp": "03:52:37", "text": "这是 Ojo 吗？"}, {"type": "subtitle", "time": 13959.269, "timestamp": "03:52:39", "text": "不要碰它。你会被附身。"}, {"type": "subtitle", "time": 13970.63, "timestamp": "03:52:50", "text": "幻影祭祀。哇。哇。"}, {"type": "subtitle", "time": 13974.389, "timestamp": "03:52:54", "text": "哦。我的天啊。好的。你能接受吗？"}]
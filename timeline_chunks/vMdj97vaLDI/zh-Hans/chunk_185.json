[{"type": "subtitle", "time": 11103.79, "timestamp": "03:05:03", "text": "好的。好的。打开。我们已做好准备"}, {"type": "subtitle", "time": 11128.11, "timestamp": "03:05:28", "text": "哦，不。"}, {"type": "subtitle", "time": 11131.91, "timestamp": "03:05:31", "text": "诡异可怕的骷髅。为什么是"}, {"type": "subtitle", "time": 11141.349, "timestamp": "03:05:41", "text": "再见。嘿。好的。吹。呃，我就在附近。"}, {"type": "subtitle", "time": 11144.87, "timestamp": "03:05:44", "text": "到发电机所在地。我认为。"}, {"type": "subtitle", "time": 11148.469, "timestamp": "03:05:48", "text": "等待。发电机在哪里？"}, {"type": "subtitle", "time": 11151.11, "timestamp": "03:05:51", "text": "我参与其中。哦，我没有"}, {"type": "subtitle", "time": 11154.55, "timestamp": "03:05:54", "text": "分析。妈的。我没有分析。"}, {"type": "subtitle", "time": 11158.51, "timestamp": "03:05:58", "text": "我身上有东西。我只是个笨蛋"}]
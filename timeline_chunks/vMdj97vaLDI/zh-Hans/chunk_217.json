[{"type": "subtitle", "time": 13021.51, "timestamp": "03:37:01", "text": "拉。我不知道。劳。劳。劳。只是"}, {"type": "subtitle", "time": 13024.87, "timestamp": "03:37:04", "text": "走吧。别死得那么惨。"}, {"type": "subtitle", "time": 13028.389, "timestamp": "03:37:08", "text": "我做了。离开并带走雷丘。"}, {"type": "subtitle", "time": 13037.83, "timestamp": "03:37:17", "text": "好的。我的天啊。好的。我回来了。我是"}, {"type": "subtitle", "time": 13040.79, "timestamp": "03:37:20", "text": "回家。再见。"}, {"type": "subtitle", "time": 13042.469, "timestamp": "03:37:22", "text": "好的。凉爽的。凉爽的。工作。没关系。它是"}, {"type": "subtitle", "time": 13045.59, "timestamp": "03:37:25", "text": "美好的。我即将死去。没人关心。"}, {"type": "subtitle", "time": 13049.67, "timestamp": "03:37:29", "text": "你确定是拉金还是约克？"}, {"type": "subtitle", "time": 13052.63, "timestamp": "03:37:32", "text": "我不在乎。直接选Ra就行了。"}, {"type": "subtitle", "time": 13056.55, "timestamp": "03:37:36", "text": "好的。猜的时候谁会在意呢？"}, {"type": "subtitle", "time": 13058.79, "timestamp": "03:37:38", "text": "需要等待。哦，不。没关系。它是"}, {"type": "subtitle", "time": 13062.87, "timestamp": "03:37:42", "text": "美好的。需要等待。好的。至少我们得到了"}, {"type": "subtitle", "time": 13065.91, "timestamp": "03:37:45", "text": "兄弟，我们只有五块钱。"}, {"type": "subtitle", "time": 13067.79, "timestamp": "03:37:47", "text": "哦，我们得到了"}, {"type": "subtitle", "time": 13070.87, "timestamp": "03:37:50", "text": "我有15美元。是的。好的。但是我们"}, {"type": "subtitle", "time": 13072.79, "timestamp": "03:37:52", "text": "赚到钱了。"}, {"type": "subtitle", "time": 13074.87, "timestamp": "03:37:54", "text": "是的。它比两个好。"}, {"type": "subtitle", "time": 13076.79, "timestamp": "03:37:56", "text": "是美元，对吧？"}, {"type": "subtitle", "time": 13078.79, "timestamp": "03:37:58", "text": "是的。"}]
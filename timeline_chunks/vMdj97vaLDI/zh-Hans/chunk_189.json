[{"type": "subtitle", "time": 11340.71, "timestamp": "03:09:00", "text": "电磁场强度是多少？呃，因为它只是一个"}, {"type": "subtitle", "time": 11343.03, "timestamp": "03:09:03", "text": "飞机。呃，它差点就点击上了。"}, {"type": "subtitle", "time": 11345.51, "timestamp": "03:09:05", "text": "二。"}, {"type": "subtitle", "time": 11347.51, "timestamp": "03:09:07", "text": "差点点开了两个。好的，那就这样吧。"}, {"type": "subtitle", "time": 11350.55, "timestamp": "03:09:10", "text": "气温骤降至冰点以下。这是。好的。"}, {"type": "subtitle", "time": 11356.469, "timestamp": "03:09:16", "text": "让我们来看看。呃，你能查一下吗？"}, {"type": "subtitle", "time": 11359.91, "timestamp": "03:09:19", "text": "你检查是否有鬼魂，因为我种下了鬼魂。"}, {"type": "subtitle", "time": 11361.99, "timestamp": "03:09:21", "text": "一些"}, {"type": "subtitle", "time": 11365.83, "timestamp": "03:09:25", "text": "等待。呃，幽灵来源。如何检查？"}, {"type": "subtitle", "time": 11367.67, "timestamp": "03:09:27", "text": "哦，就像穿着迷彩服一样。我种了一棵"}, {"type": "subtitle", "time": 11371.03, "timestamp": "03:09:31", "text": "迷彩。哦好的。哦。哦。哦。令人难忘。"}, {"type": "subtitle", "time": 11372.71, "timestamp": "03:09:32", "text": "令人难忘。我死了。我死了。工作。我是"}, {"type": "subtitle", "time": 11374.71, "timestamp": "03:09:34", "text": "死的。我死了。我死了。我死了。我是"}, {"type": "subtitle", "time": 11377.19, "timestamp": "03:09:37", "text": "死的。我死了。它在哪里？它在哪里？"}, {"type": "subtitle", "time": 11383.11, "timestamp": "03:09:43", "text": "你？你是怎么死的？"}, {"type": "subtitle", "time": 11385.67, "timestamp": "03:09:45", "text": "呃，它在……不，不，不。它是"}, {"type": "subtitle", "time": 11389.91, "timestamp": "03:09:49", "text": "还好。好的。呃，我死了。"}, {"type": "subtitle", "time": 11393.63, "timestamp": "03:09:53", "text": "所以，别太担心。我"}, {"type": "subtitle", "time": 11396.51, "timestamp": "03:09:56", "text": "我觉得可以。"}, {"type": "subtitle", "time": 11398.91, "timestamp": "03:09:58", "text": "期刊幽灵"}]
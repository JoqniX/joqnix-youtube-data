[{"type": "subtitle", "time": 14642.309, "timestamp": "04:04:02", "text": "速度。如果……将以更快的速度旅行"}, {"type": "subtitle", "time": 14645.75, "timestamp": "04:04:05", "text": "如果受害者距离很远的话。耶稣啊，它"}, {"type": "subtitle", "time": 14648.269, "timestamp": "04:04:08", "text": "真的能把你洗干净。关闭"}, {"type": "subtitle", "time": 14651.11, "timestamp": "04:04:11", "text": "位置的电源将"}, {"type": "subtitle", "time": 14653.269, "timestamp": "04:04:13", "text": "阻止杜松子酒发挥其作用。"}, {"type": "subtitle", "time": 14656.79, "timestamp": "04:04:16", "text": "你真的需要站在黑暗中才能"}, {"type": "subtitle", "time": 14659.91, "timestamp": "04:04:19", "text": "谢谢你避免了这件事。"}, {"type": "subtitle", "time": 14669.189, "timestamp": "04:04:29", "text": "一位市长。我的天哪。一位市长。好的。一个"}, {"type": "subtitle", "time": 14671.99, "timestamp": "04:04:31", "text": "市长是所有噩梦的根源。"}, {"type": "subtitle", "time": 14674.389, "timestamp": "04:04:34", "text": "在黑暗中发挥最大威力。一个"}, {"type": "subtitle", "time": 14676.469, "timestamp": "04:04:36", "text": "市长将有更大的机会"}, {"type": "subtitle", "time": 14679.11, "timestamp": "04:04:39", "text": "在黑暗中发动攻击。关闭"}, {"type": "subtitle", "time": 14682.229, "timestamp": "04:04:42", "text": "打开灯会使下方"}, {"type": "subtitle", "time": 14683.99, "timestamp": "04:04:43", "text": "它有机会发动攻击，否则它仍然会……"}, {"type": "subtitle", "time": 14686.91, "timestamp": "04:04:46", "text": "攻击他们，但成功的机会较小。它是"}, {"type": "subtitle", "time": 14689.349, "timestamp": "04:04:49", "text": "回荡的暴力。呃，真是个狂野的"}, {"type": "subtitle", "time": 14691.67, "timestamp": "04:04:51", "text": "会不分青红皂白攻击的幽灵。"}, {"type": "subtitle", "time": 14694.87, "timestamp": "04:04:54", "text": "他们的速度可能会具有欺骗性，因为他们"}, {"type": "subtitle", "time": 14697.269, "timestamp": "04:04:57", "text": "速度慢，但优势箭矢。很快"}, {"type": "subtitle", "time": 14699.11, "timestamp": "04:04:59", "text": "它们开始狩猎时就会移动"}]
[{"type": "subtitle", "time": 302.39, "timestamp": "00:05:02", "text": "嗯，他们在聊某个游戏。"}, {"type": "subtitle", "time": 310.87, "timestamp": "00:05:10", "text": "哦，等等。我的网络出问题了。"}, {"type": "subtitle", "time": 312.39, "timestamp": "00:05:12", "text": "等等，等等，等等。我的网络连接有问题"}, {"type": "subtitle", "time": 315.43, "timestamp": "00:05:15", "text": "向上。是否有任何下载操作正在进行？"}, {"type": "subtitle", "time": 317.469, "timestamp": "00:05:17", "text": "等等，什么？"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "正在下载？不。对。"}, {"type": "subtitle", "time": 322.35, "timestamp": "00:05:22", "text": "让我把所有的"}, {"type": "subtitle", "time": 325.07, "timestamp": "00:05:25", "text": "东西。"}, {"type": "subtitle", "time": 328.95, "timestamp": "00:05:28", "text": "呃，下载是什么？史诗。你是"}, {"type": "subtitle", "time": 336.39, "timestamp": "00:05:36", "text": "嗯，是的。好的。现在稳定了。我认为"}, {"type": "subtitle", "time": 338.71, "timestamp": "00:05:38", "text": "我把它关掉了。好像是某个团队之类的。"}, {"type": "subtitle", "time": 341.27, "timestamp": "00:05:41", "text": "好的。好的。所以，流媒体将会是"}, {"type": "subtitle", "time": 343.67, "timestamp": "00:05:43", "text": "美好的。恩达那边情况怎么样了？"}, {"type": "subtitle", "time": 344.51, "timestamp": "00:05:44", "text": "他是"}, {"type": "subtitle", "time": 351.95, "timestamp": "00:05:51", "text": "他。"}, {"type": "subtitle", "time": 354.87, "timestamp": "00:05:54", "text": "有人在这里过夜。看看"}, {"type": "subtitle", "time": 355.79, "timestamp": "00:05:55", "text": "他们"}, {"type": "subtitle", "time": 359.909, "timestamp": "00:05:59", "text": "睡觉。我一会儿就回来。"}]
[{"type": "subtitle", "time": 3970.63, "timestamp": "01:06:10", "text": "昂贵的。贵得离谱，才1个"}, {"type": "subtitle", "time": 3974.47, "timestamp": "01:06:14", "text": "小时。我们每次都得花一小时两次。"}, {"type": "subtitle", "time": 3979.67, "timestamp": "01:06:19", "text": "孩子们真的非常非常棒"}, {"type": "subtitle", "time": 3981.789, "timestamp": "01:06:21", "text": "就像他们如此"}, {"type": "subtitle", "time": 3985.51, "timestamp": "01:06:25", "text": "好的。但是，嗯，它确实很贵。"}, {"type": "subtitle", "time": 3987.589, "timestamp": "01:06:27", "text": "所以如果你打算投资这些"}, {"type": "subtitle", "time": 3989.75, "timestamp": "01:06:29", "text": "那种咖啡馆，就像那种咖啡馆一样。"}, {"type": "subtitle", "time": 3993.349, "timestamp": "01:06:33", "text": "他们就像国王一样。所以，这里有一个"}, {"type": "subtitle", "time": 3996.23, "timestamp": "01:06:36", "text": "有一家咖啡馆，那里的女性穿着……"}, {"type": "subtitle", "time": 4000.789, "timestamp": "01:06:40", "text": "打扮得像个男人，像个男人一样，然后"}, {"type": "chat", "time": 4001.358, "timestamp": "01:06:41", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Money is not a problem Mam I need it"}, {"type": "subtitle", "time": 4002.87, "timestamp": "01:06:42", "text": "它们基本上就像一个主机，但非常"}, {"type": "subtitle", "time": 4005.029, "timestamp": "01:06:45", "text": "不是那种类型的主持人，而是……"}, {"type": "subtitle", "time": 4008.63, "timestamp": "01:06:48", "text": "更像是针对女性的，然后她们"}, {"type": "subtitle", "time": 4011.75, "timestamp": "01:06:51", "text": "他们打扮成男性的样子。"}, {"type": "subtitle", "time": 4014.23, "timestamp": "01:06:54", "text": "他们基本上喜欢按流程来，然后"}, {"type": "subtitle", "time": 4017.51, "timestamp": "01:06:57", "text": "他们所做的就是他们会喜欢"}, {"type": "subtitle", "time": 4019.109, "timestamp": "01:06:59", "text": "招待，而不是与艺人交谈"}]
[{"type": "subtitle", "time": 14460.469, "timestamp": "04:01:00", "text": "通过通灵板召唤而来。站着"}, {"type": "subtitle", "time": 14462.55, "timestamp": "04:01:02", "text": "幻影会让你精神崩溃"}, {"type": "subtitle", "time": 14465.349, "timestamp": "04:01:05", "text": "速度快得多。弱点。采取"}, {"type": "subtitle", "time": 14467.55, "timestamp": "04:01:07", "text": "Ver 的照片暂时消失了。"}, {"type": "subtitle", "time": 14470.71, "timestamp": "04:01:10", "text": "哦。好的。我们需要考虑如何"}, {"type": "subtitle", "time": 14472.71, "timestamp": "04:01:12", "text": "所有这些作品。所以，我不知道。"}, {"type": "subtitle", "time": 14475.83, "timestamp": "04:01:15", "text": "好的。这是最安全的鬼魂"}, {"type": "subtitle", "time": 14478.389, "timestamp": "04:01:18", "text": "顺便说一句，可以拥有。幻影。这是"}, {"type": "subtitle", "time": 14480.71, "timestamp": "04:01:20", "text": "风扇。不，不，不。就像"}, {"type": "subtitle", "time": 14482.79, "timestamp": "04:01:22", "text": "吵闹鬼就像……"}, {"type": "subtitle", "time": 14485.55, "timestamp": "04:01:25", "text": "保险箱。他们不会杀你。他们是"}, {"type": "subtitle", "time": 14488.469, "timestamp": "04:01:28", "text": "无害。所以，你知道，我不认为"}, {"type": "subtitle", "time": 14490.469, "timestamp": "04:01:30", "text": "我觉得他们能杀了你，但是"}, {"type": "subtitle", "time": 14492.07, "timestamp": "04:01:32", "text": "不知道。它们造成的危害最大。"}, {"type": "subtitle", "time": 14493.51, "timestamp": "04:01:33", "text": "他们就像最安全的鬼魂一样。"}, {"type": "subtitle", "time": 14497.349, "timestamp": "04:01:37", "text": "有。那么，我们来看看。嗯，其中最"}, {"type": "subtitle", "time": 14499.429, "timestamp": "04:01:39", "text": "著名的鬼魂，也就是人们熟知的骚灵"}, {"type": "subtitle", "time": 14501.67, "timestamp": "04:01:41", "text": "操纵周围的物体并扩散"}, {"type": "subtitle", "time": 14503.99, "timestamp": "04:01:43", "text": "将恐惧转化为受害者的力量。这"}, {"type": "subtitle", "time": 14506.79, "timestamp": "04:01:46", "text": "吵闹鬼可以扔多个东西"}, {"type": "subtitle", "time": 14508.71, "timestamp": "04:01:48", "text": "多个对象作为一个整体，具有强大的功能"}, {"type": "subtitle", "time": 14512.55, "timestamp": "04:01:52", "text": "力量。奶酪弱点，却无能为力"}, {"type": "subtitle", "time": 14519.429, "timestamp": "04:01:59", "text": "无力。总之，灵盒，灵魂"}]
[{"type": "subtitle", "time": 10081.83, "timestamp": "02:48:01", "text": "拖？不，我打不开这扇门。为什么？"}, {"type": "subtitle", "time": 10084.389, "timestamp": "02:48:04", "text": "我很害怕。哦，是的。鬼是什么？"}, {"type": "subtitle", "time": 10085.91, "timestamp": "02:48:05", "text": "哦，等等。这个鬼魂叫什么名字？哦，我的"}, {"type": "subtitle", "time": 10088.469, "timestamp": "02:48:08", "text": "天哪，我忘了检查了。"}, {"type": "subtitle", "time": 10090.309, "timestamp": "02:48:10", "text": "不，我们不需要鬼魂的名字。我们"}, {"type": "subtitle", "time": 10092.95, "timestamp": "02:48:12", "text": "暂时不需要汇总。我认为"}, {"type": "subtitle", "time": 10096.95, "timestamp": "02:48:16", "text": "我们终将死去。洛里。洛里。不，爸爸。我们"}, {"type": "subtitle", "time": 10098.79, "timestamp": "02:48:18", "text": "瞬间死亡。请不要这样做"}, {"type": "subtitle", "time": 10100.55, "timestamp": "02:48:20", "text": "那。"}, {"type": "subtitle", "time": 10102.71, "timestamp": "02:48:22", "text": "你听到有人笑了吗？你听说了吗？"}, {"type": "subtitle", "time": 10105.67, "timestamp": "02:48:25", "text": "有人笑了吗？你……"}, {"type": "subtitle", "time": 10108.15, "timestamp": "02:48:28", "text": "好吧，这就是我这么说的唯一原因。"}, {"type": "subtitle", "time": 10111.19, "timestamp": "02:48:31", "text": "不要说出鬼魂的名字。我很漂亮"}, {"type": "subtitle", "time": 10115.55, "timestamp": "02:48:35", "text": "当然。不，不，不。我希望他们"}, {"type": "subtitle", "time": 10118.55, "timestamp": "02:48:38", "text": "这里。天哪，我浑身发抖。天哪，我"}, {"type": "subtitle", "time": 10120.15, "timestamp": "02:48:40", "text": "摇晃。"}, {"type": "subtitle", "time": 10123.11, "timestamp": "02:48:43", "text": "你在这里吗？"}, {"type": "subtitle", "time": 10127.59, "timestamp": "02:48:47", "text": "等等，你这是在用俚语吗？"}, {"type": "subtitle", "time": 10129.51, "timestamp": "02:48:49", "text": "好的，我还需要另一样东西，因为这个"}, {"type": "subtitle", "time": 10132.15, "timestamp": "02:48:52", "text": "这些方法都行不通。"}, {"type": "subtitle", "time": 10134.469, "timestamp": "02:48:54", "text": "所以，我要回卡车去了。我同意了。"}, {"type": "subtitle", "time": 10136.95, "timestamp": "02:48:56", "text": "卡车修理店。不要独自一人待在那里。"}, {"type": "subtitle", "time": 10139.99, "timestamp": "02:48:59", "text": "你会死。好的。是的。我们走吧"}]
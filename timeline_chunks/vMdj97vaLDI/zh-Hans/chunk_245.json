[{"type": "subtitle", "time": 14701.67, "timestamp": "04:05:01", "text": "速度极快。亡灵可以旅行"}, {"type": "subtitle", "time": 14704.87, "timestamp": "04:05:04", "text": "这是它捕猎时发出的信号。"}, {"type": "subtitle", "time": 14707.59, "timestamp": "04:05:07", "text": "弱点。躲避牧师的意志"}, {"type": "subtitle", "time": 14711.349, "timestamp": "04:05:11", "text": "使其移动得非常缓慢。哦，所以如果"}, {"type": "subtitle", "time": 14713.429, "timestamp": "04:05:13", "text": "它看见你，你就基本死了。"}, {"type": "subtitle", "time": 14715.429, "timestamp": "04:05:15", "text": "它真的会催促你。哦"}, {"type": "subtitle", "time": 14716.99, "timestamp": "04:05:16", "text": "男生。但是如果你"}, {"type": "subtitle", "time": 14719.83, "timestamp": "04:05:19", "text": "躲起来，它不会杀你，或者它会"}, {"type": "subtitle", "time": 14721.83, "timestamp": "04:05:21", "text": "就像走得很慢，好像忘记了似的。"}, {"type": "subtitle", "time": 14725.51, "timestamp": "04:05:25", "text": "关于你。幽灵，幽灵骑行。她有"}, {"type": "subtitle", "time": 14728.55, "timestamp": "04:05:28", "text": "幽灵。好吧，鬼魂真多啊。"}, {"type": "subtitle", "time": 14731.99, "timestamp": "04:05:31", "text": "骑着它。我从未见过像……"}, {"type": "subtitle", "time": 14734.389, "timestamp": "04:05:34", "text": "鬼魂，或者永远存在。我想看看那会怎样"}, {"type": "subtitle", "time": 14737.269, "timestamp": "04:05:37", "text": "看起来像。哦，不，不，不。它不是"}, {"type": "subtitle", "time": 14739.91, "timestamp": "04:05:39", "text": "真是令人着迷。那是什么？"}, {"type": "subtitle", "time": 14742.389, "timestamp": "04:05:42", "text": "那是什么鬼魂？"}, {"type": "subtitle", "time": 14745.189, "timestamp": "04:05:45", "text": "是的。哦，不是的。你通常你"}, {"type": "subtitle", "time": 14748.389, "timestamp": "04:05:48", "text": "还记得我把摄像头放在里面吗？"}, {"type": "subtitle", "time": 14750.63, "timestamp": "04:05:50", "text": "是小木屋，对吧？非常非常"}, {"type": "subtitle", "time": 14753.75, "timestamp": "04:05:53", "text": "地方很可疑，但它仍然是个……"}, {"type": "subtitle", "time": 14757.51, "timestamp": "04:05:57", "text": "曾是狩猎场所。所以，现在如果你"}, {"type": "subtitle", "time": 14759.189, "timestamp": "04:05:59", "text": "回到卡车旁，你看看"}]
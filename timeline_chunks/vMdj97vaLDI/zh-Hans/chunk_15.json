[{"type": "subtitle", "time": 901.35, "timestamp": "00:15:01", "text": "我们找个日本人，这样我就可以……"}, {"type": "subtitle", "time": 902.75, "timestamp": "00:15:02", "text": "日本人"}, {"type": "subtitle", "time": 914.71, "timestamp": "00:15:14", "text": "团体。为什么要这样做？这是一个很大的团体。我是"}, {"type": "subtitle", "time": 929.949, "timestamp": "00:15:29", "text": "中国人。那是一个中国团体"}, {"type": "subtitle", "time": 948.43, "timestamp": "00:15:48", "text": "朋友们。我知道那些是日本的。"}, {"type": "subtitle", "time": 952.11, "timestamp": "00:15:52", "text": "人们。我在这方面很差劲"}, {"type": "subtitle", "time": 954.829, "timestamp": "00:15:54", "text": "沟通。"}, {"type": "subtitle", "time": 958.67, "timestamp": "00:15:58", "text": "哦。我的天啊。太可爱了。它是"}]
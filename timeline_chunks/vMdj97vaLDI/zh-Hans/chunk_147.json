[{"type": "subtitle", "time": 8822.309, "timestamp": "02:27:02", "text": "对我来说，你的音频也是"}, {"type": "subtitle", "time": 8824.79, "timestamp": "02:27:04", "text": "我这边声音好像比较大。所以我就想"}, {"type": "subtitle", "time": 8827.27, "timestamp": "02:27:07", "text": "降低它就是我没去的原因"}, {"type": "subtitle", "time": 8830.79, "timestamp": "02:27:10", "text": "话很多。好的。呃，发生的事情是……"}, {"type": "subtitle", "time": 8833.75, "timestamp": "02:27:13", "text": "如果我把它调低一点点"}, {"type": "subtitle", "time": 8836.71, "timestamp": "02:27:16", "text": "问题在于，就像当我……"}, {"type": "subtitle", "time": 8838.23, "timestamp": "02:27:18", "text": "编辑"}, {"type": "subtitle", "time": 8840.309, "timestamp": "02:27:20", "text": "呃，编辑，就像把任何东西剪掉一样。"}, {"type": "subtitle", "time": 8843.349, "timestamp": "02:27:23", "text": "就像提取短裤一样，我的声音就像"}, {"type": "subtitle", "time": 8845.99, "timestamp": "02:27:25", "text": "价格超级低，所以我才喜欢它。"}, {"type": "subtitle", "time": 8849.19, "timestamp": "02:27:29", "text": "声音稍微大一点。等等，你喜欢吗？"}, {"type": "subtitle", "time": 8851.51, "timestamp": "02:27:31", "text": "下载 YouTube 板块或点赞"}, {"type": "subtitle", "time": 8854.309, "timestamp": "02:27:34", "text": "录下来什么的？不，不，不。我"}, {"type": "subtitle", "time": 8855.99, "timestamp": "02:27:35", "text": "下载 YouTube 板块。我不"}, {"type": "subtitle", "time": 8859.03, "timestamp": "02:27:39", "text": "录下来。这是我的笔记本电脑"}, {"type": "subtitle", "time": 8862.23, "timestamp": "02:27:42", "text": "如果这种情况发生，它会自行毁灭。"}, {"type": "subtitle", "time": 8864.15, "timestamp": "02:27:44", "text": "所以我不会那样做。我不是，我不是"}, {"type": "subtitle", "time": 8868.15, "timestamp": "02:27:48", "text": "承担这种风险。哦，绝对不行。是的。是的。"}, {"type": "subtitle", "time": 8871.429, "timestamp": "02:27:51", "text": "就像，是的，我们要进去了。"}, {"type": "subtitle", "time": 8874.389, "timestamp": "02:27:54", "text": "游戏。你打开游戏了吗？呃，我是"}, {"type": "subtitle", "time": 8875.63, "timestamp": "02:27:55", "text": "开幕"}]
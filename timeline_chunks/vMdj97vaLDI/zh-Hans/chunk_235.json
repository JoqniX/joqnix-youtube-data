[{"type": "subtitle", "time": 14101.99, "timestamp": "03:55:01", "text": "里面好像有血之类的东西。我是说"}, {"type": "subtitle", "time": 14104.87, "timestamp": "03:55:04", "text": "番茄酱之类的东西。哦，不。"}, {"type": "subtitle", "time": 14108.309, "timestamp": "03:55:08", "text": "这是什么地方？"}, {"type": "subtitle", "time": 14110.55, "timestamp": "03:55:10", "text": "我不知道。这些人就是这个地方"}, {"type": "subtitle", "time": 14112.389, "timestamp": "03:55:12", "text": "里面全是笨手笨脚的食客。这就是全部内容了。"}, {"type": "subtitle", "time": 14120.309, "timestamp": "03:55:20", "text": "鬼魂意识到了什么"}, {"type": "subtitle", "time": 14122.87, "timestamp": "03:55:22", "text": "这些混蛋到底在干什么？哦"}, {"type": "subtitle", "time": 14124.79, "timestamp": "03:55:24", "text": "我的上帝。这些人是什么人？尤其"}, {"type": "subtitle", "time": 14126.87, "timestamp": "03:55:26", "text": "的"}, {"type": "subtitle", "time": 14128.87, "timestamp": "03:55:28", "text": "我的天啊。"}, {"type": "subtitle", "time": 14131.83, "timestamp": "03:55:31", "text": "哦，真高级。我们走吧。我们走吧。哦，我"}, {"type": "subtitle", "time": 14133.99, "timestamp": "03:55:33", "text": "不能。"}, {"type": "subtitle", "time": 14137.429, "timestamp": "03:55:37", "text": "可以进去。我的天啊。有人哦"}, {"type": "subtitle", "time": 14140.95, "timestamp": "03:55:40", "text": "我的上帝。这是什么？他们就像"}, {"type": "subtitle", "time": 14143.349, "timestamp": "03:55:43", "text": "有很多像浓稠血液一样的东西"}, {"type": "subtitle", "time": 14146.15, "timestamp": "03:55:46", "text": "东西。我的天啊。不，那不是血。"}, {"type": "subtitle", "time": 14149.349, "timestamp": "03:55:49", "text": "那是番茄酱。这是番茄酱。看看"}, {"type": "subtitle", "time": 14152.63, "timestamp": "03:55:52", "text": "这个上面加了番茄酱。他们 他们是"}, {"type": "subtitle", "time": 14156.95, "timestamp": "03:55:56", "text": "可能在做意大利面。我的天啊，"}, {"type": "subtitle", "time": 14159.269, "timestamp": "03:55:59", "text": "伙计们。看。看。这是番茄酱。"}]
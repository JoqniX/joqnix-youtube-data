[{"type": "subtitle", "time": 9601.75, "timestamp": "02:40:01", "text": "是的。你想去这个房间吗？"}, {"type": "subtitle", "time": 9613.59, "timestamp": "02:40:13", "text": "杰克，发生什么事了？我的天啊。你……"}, {"type": "subtitle", "time": 9621.18, "timestamp": "02:40:21", "text": "[音乐]"}, {"type": "subtitle", "time": 9623.349, "timestamp": "02:40:23", "text": "[笑声]"}, {"type": "subtitle", "time": 9625.19, "timestamp": "02:40:25", "text": "看，看，看。好的。好的。对不起。"}, {"type": "subtitle", "time": 9627.19, "timestamp": "02:40:27", "text": "对不起。好的。你知道吗？好的。"}, {"type": "subtitle", "time": 9628.63, "timestamp": "02:40:28", "text": "你知道吗？任何。我要"}, {"type": "subtitle", "time": 9631.23, "timestamp": "02:40:31", "text": "我自己也弄点皮肤。不用担心。哦"}, {"type": "subtitle", "time": 9635.67, "timestamp": "02:40:35", "text": "不。无论我应该做什么，"}, {"type": "subtitle", "time": 9637.99, "timestamp": "02:40:37", "text": "但他对我做了。我的天啊。我不能"}, {"type": "subtitle", "time": 9645.27, "timestamp": "02:40:45", "text": "那。我的天啊。我的天啊。我明白了吗？"}, {"type": "subtitle", "time": 9648.15, "timestamp": "02:40:48", "text": "某物？"}, {"type": "subtitle", "time": 9654.63, "timestamp": "02:40:54", "text": "吓了一跳。我不知道。我不是"}, {"type": "subtitle", "time": 9658.71, "timestamp": "02:40:58", "text": "我不想吓到他们。为什么，"}]
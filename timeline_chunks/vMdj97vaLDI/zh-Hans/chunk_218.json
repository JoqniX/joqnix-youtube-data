[{"type": "subtitle", "time": 13083.429, "timestamp": "03:38:03", "text": "拍一张三星级照片。哦，"}, {"type": "subtitle", "time": 13086.15, "timestamp": "03:38:06", "text": "三星级。我现在五级了。耶。"}, {"type": "subtitle", "time": 13089.83, "timestamp": "03:38:09", "text": "我们走吧。我爱"}, {"type": "subtitle", "time": 13092.07, "timestamp": "03:38:12", "text": "你想做噩梦。"}, {"type": "subtitle", "time": 13094.71, "timestamp": "03:38:14", "text": "噩梦到底是什么来着？"}, {"type": "subtitle", "time": 13097.269, "timestamp": "03:38:17", "text": "它关乎它，它关乎它，它关乎更多，它关乎更多"}, {"type": "subtitle", "time": 13100.15, "timestamp": "03:38:20", "text": "顺便说一句，他比专业人士还要专业。哦，我的"}, {"type": "subtitle", "time": 13107.19, "timestamp": "03:38:27", "text": "我们马上就要死了。别担心，是的"}, {"type": "subtitle", "time": 13115.11, "timestamp": "03:38:35", "text": "好的。呃，我们还需要另一根蜡烛，而且我们"}, {"type": "subtitle", "time": 13117.67, "timestamp": "03:38:37", "text": "需要打火机。谁会买一个"}, {"type": "subtitle", "time": 13120.469, "timestamp": "03:38:40", "text": "好的，我会去买打火机。"}, {"type": "subtitle", "time": 13123.03, "timestamp": "03:38:43", "text": "我会买一支蜡烛，因为这是"}, {"type": "subtitle", "time": 13126.87, "timestamp": "03:38:46", "text": "每次进去都让人很沮丧"}, {"type": "subtitle", "time": 13128.91, "timestamp": "03:38:48", "text": "就像一个"}, {"type": "subtitle", "time": 13132.389, "timestamp": "03:38:52", "text": "蠢货，把这一切都忘了吧。好的，我会的"}, {"type": "subtitle", "time": 13135.349, "timestamp": "03:38:55", "text": "加根蜡烛，我就会加个灯。"}, {"type": "subtitle", "time": 13137.99, "timestamp": "03:38:57", "text": "所以你想体验噩梦？我们可以"}]
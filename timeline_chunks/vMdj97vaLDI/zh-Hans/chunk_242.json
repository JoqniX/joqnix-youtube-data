[{"type": "subtitle", "time": 14521.95, "timestamp": "04:02:01", "text": "盒子、指纹和鬼魂"}, {"type": "subtitle", "time": 14526.309, "timestamp": "04:02:06", "text": "骑术。好的。女妖。女妖也"}, {"type": "subtitle", "time": 14529.189, "timestamp": "04:02:09", "text": "幽灵骑乘幽灵球。我仍然没有"}, {"type": "subtitle", "time": 14532.269, "timestamp": "04:02:12", "text": "就像云朵能获得幽灵宝珠一样，但是"}, {"type": "subtitle", "time": 14535.11, "timestamp": "04:02:15", "text": "依然是那位以歌声闻名的海妖"}, {"type": "subtitle", "time": 14537.75, "timestamp": "04:02:17", "text": "用歌声吸引受害者。它还是"}, {"type": "subtitle", "time": 14540.309, "timestamp": "04:02:20", "text": "已知它会先单独挑选猎物下手。"}, {"type": "subtitle", "time": 14543.67, "timestamp": "04:02:23", "text": "给予致命一击。好的。女妖"}, {"type": "subtitle", "time": 14547.269, "timestamp": "04:02:27", "text": "会削弱“是啊，它会唱歌”。所以"}, {"type": "subtitle", "time": 14549.229, "timestamp": "04:02:29", "text": "如果你看到有人尖叫或"}, {"type": "subtitle", "time": 14552.63, "timestamp": "04:02:32", "text": "可能是某种东西，也许是女妖。"}, {"type": "subtitle", "time": 14555.83, "timestamp": "04:02:35", "text": "可能是因为我认为我们的机器人也"}, {"type": "subtitle", "time": 14559.75, "timestamp": "04:02:39", "text": "就像尖叫之类的。"}, {"type": "subtitle", "time": 14562.309, "timestamp": "04:02:42", "text": "确实如此。我们听说我们听说"}, {"type": "subtitle", "time": 14564.15, "timestamp": "04:02:44", "text": "尖叫声，那是在我们死之前。"}, {"type": "subtitle", "time": 14565.67, "timestamp": "04:02:45", "text": "正确的？"}, {"type": "subtitle", "time": 14568.55, "timestamp": "04:02:48", "text": "或者也尖叫了。"}, {"type": "subtitle", "time": 14571.59, "timestamp": "04:02:51", "text": "我不记得听到过尖叫声。"}, {"type": "subtitle", "time": 14573.99, "timestamp": "04:02:53", "text": "尽管。我不知道。是的。是的。什么时候"}, {"type": "subtitle", "time": 14576.07, "timestamp": "04:02:56", "text": "哦，等等。嗯，你还记得我们吗？"}, {"type": "subtitle", "time": 14578.229, "timestamp": "04:02:58", "text": "进入房间，对吧？它，它是"}]
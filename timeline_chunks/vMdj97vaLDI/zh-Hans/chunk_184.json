[{"type": "subtitle", "time": 11042.469, "timestamp": "03:04:02", "text": "手电筒。摄像机。不是"}, {"type": "subtitle", "time": 11044.269, "timestamp": "03:04:04", "text": "音频摄像机。一段视频"}, {"type": "subtitle", "time": 11048.63, "timestamp": "03:04:08", "text": "相机。还有一本书。约翰，你来吧。"}, {"type": "subtitle", "time": 11051.67, "timestamp": "03:04:11", "text": "电磁场读数器。你拿走了灵盒。"}, {"type": "subtitle", "time": 11053.99, "timestamp": "03:04:13", "text": "还有一支手电筒。等等，我们不等。"}, {"type": "subtitle", "time": 11055.51, "timestamp": "03:04:15", "text": "我们不需要灵盒。我们只是"}, {"type": "subtitle", "time": 11058.87, "timestamp": "03:04:18", "text": "需要电磁场读数和蜡烛。我们"}, {"type": "subtitle", "time": 11061.59, "timestamp": "03:04:21", "text": "做。我们有一支蜡烛。不，我们不。"}, {"type": "subtitle", "time": 11062.75, "timestamp": "03:04:22", "text": "准备一支蜡烛。"}, {"type": "subtitle", "time": 11065.91, "timestamp": "03:04:25", "text": "对不起。电磁场读数器。"}, {"type": "subtitle", "time": 11069.429, "timestamp": "03:04:29", "text": "是的。不，我们没有抛物线"}, {"type": "subtitle", "time": 11071.429, "timestamp": "03:04:31", "text": "抛物线麦克风。是的，我没有"}, {"type": "subtitle", "time": 11075.429, "timestamp": "03:04:35", "text": "还没解锁呢。我觉得我需要 我们需要"}, {"type": "subtitle", "time": 11077.19, "timestamp": "03:04:37", "text": "问题很大。我听不见你说话。"}, {"type": "subtitle", "time": 11079.91, "timestamp": "03:04:39", "text": "所以，我需要调高你的音量。等等，我……"}, {"type": "subtitle", "time": 11082.51, "timestamp": "03:04:42", "text": "你可以把它加载到Discord上，或者"}, {"type": "subtitle", "time": 11086.309, "timestamp": "03:04:46", "text": "像 OBS 那样？我把它加载到你俩的……"}, {"type": "subtitle", "time": 11088.309, "timestamp": "03:04:48", "text": "他们。所以，"}, {"type": "subtitle", "time": 11090.95, "timestamp": "03:04:50", "text": "我需要像“是”一样。现在，现在你是"}, {"type": "subtitle", "time": 11093.63, "timestamp": "03:04:53", "text": "好的。现在你没事了，兄弟。"}]
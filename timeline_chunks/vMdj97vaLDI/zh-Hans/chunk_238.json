[{"type": "subtitle", "time": 14281.75, "timestamp": "03:58:01", "text": "跟往常一样犯傻。不，不要"}, {"type": "subtitle", "time": 14285.429, "timestamp": "03:58:05", "text": "别担心。好的。"}, {"type": "subtitle", "time": 14297.51, "timestamp": "03:58:17", "text": "是的。奥贝克。"}, {"type": "subtitle", "time": 14300.79, "timestamp": "03:58:20", "text": "Obake是什么意思？电磁场等级五级。我"}, {"type": "subtitle", "time": 14303.03, "timestamp": "03:58:23", "text": "没有测得电磁场强度。我做了电磁场辐射检测"}, {"type": "subtitle", "time": 14306.429, "timestamp": "03:58:26", "text": "它就在我手上，但我仍然毫无头绪。"}, {"type": "subtitle", "time": 14309.349, "timestamp": "03:58:29", "text": "就像有时候这个幽灵会成形"}, {"type": "subtitle", "time": 14312.51, "timestamp": "03:58:32", "text": "转变留下独特的"}, {"type": "subtitle", "time": 14314.87, "timestamp": "03:58:34", "text": "证据。用线捕获"}, {"type": "subtitle", "time": 14317.269, "timestamp": "03:58:37", "text": "使节。大木很少会离开"}, {"type": "subtitle", "time": 14319.99, "timestamp": "03:58:39", "text": "痕迹。"}, {"type": "subtitle", "time": 14321.59, "timestamp": "03:58:41", "text": "哦，"}, {"type": "subtitle", "time": 14323.95, "timestamp": "03:58:43", "text": "是可怕的变形者，能够……"}, {"type": "subtitle", "time": 14327.429, "timestamp": "03:58:47", "text": "呈现出多种形式。他们已经看到了"}, {"type": "subtitle", "time": 14329.91, "timestamp": "03:58:49", "text": "呈现出人形以吸引"}, {"type": "subtitle", "time": 14336.389, "timestamp": "03:58:56", "text": "人类。是的。你想了解"}, {"type": "subtitle", "time": 14339.51, "timestamp": "03:58:59", "text": "所有这些都我不知道。真他妈的"}]
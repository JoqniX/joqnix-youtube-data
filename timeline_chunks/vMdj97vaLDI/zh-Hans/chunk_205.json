[{"type": "subtitle", "time": 12301.99, "timestamp": "03:25:01", "text": "所以，我应该做正确的事，"}, {"type": "subtitle", "time": 12305.269, "timestamp": "03:25:05", "text": "手电筒，还有那个东西"}, {"type": "subtitle", "time": 12306.79, "timestamp": "03:25:06", "text": "地板上的东西。它在……"}, {"type": "subtitle", "time": 12308.389, "timestamp": "03:25:08", "text": "地面。它在地板上。那"}, {"type": "subtitle", "time": 12310.469, "timestamp": "03:25:10", "text": "挤压？"}, {"type": "subtitle", "time": 12313.67, "timestamp": "03:25:13", "text": "不，不。我们有相关的任务吗？"}, {"type": "subtitle", "time": 12315.429, "timestamp": "03:25:15", "text": "抓住那东西和鬼魂。是的。"}, {"type": "subtitle", "time": 12317.75, "timestamp": "03:25:17", "text": "是的。我们有一个蜡烛任务。好的。我们"}, {"type": "subtitle", "time": 12319.429, "timestamp": "03:25:19", "text": "我们确实有一项蜡烛任务。是的。好的。"}, {"type": "subtitle", "time": 12321.75, "timestamp": "03:25:21", "text": "好的。好的。好的。好的。好的。好的。拿"}, {"type": "subtitle", "time": 12323.83, "timestamp": "03:25:23", "text": "把这个捡起来。"}, {"type": "subtitle", "time": 12325.67, "timestamp": "03:25:25", "text": "不，我们没有蜡烛。哦，我们"}, {"type": "subtitle", "time": 12327.75, "timestamp": "03:25:27", "text": "顺便说一句，我有一台相机。就像"}, {"type": "subtitle", "time": 12330.309, "timestamp": "03:25:30", "text": "照片的东西。是的，我们有。"}, {"type": "subtitle", "time": 12332.07, "timestamp": "03:25:32", "text": "好的，"}, {"type": "subtitle", "time": 12333.83, "timestamp": "03:25:33", "text": "我们可以带上相机。你拿走"}, {"type": "subtitle", "time": 12337.91, "timestamp": "03:25:37", "text": "那个东西。哦，请给我手电筒。是的，"}, {"type": "subtitle", "time": 12339.83, "timestamp": "03:25:39", "text": "你还可以再降这么多。"}, {"type": "subtitle", "time": 12341.67, "timestamp": "03:25:41", "text": "你可以像拥有相机一样拥有它"}, {"type": "subtitle", "time": 12345.03, "timestamp": "03:25:45", "text": "你。是的，我有这本书。呃，这个"}, {"type": "subtitle", "time": 12348.83, "timestamp": "03:25:48", "text": "电磁场"}, {"type": "subtitle", "time": 12350.87, "timestamp": "03:25:50", "text": "实际上。你想让我带走吗？"}, {"type": "subtitle", "time": 12353.429, "timestamp": "03:25:53", "text": "相机？相机。哦，是的。相机。"}, {"type": "subtitle", "time": 12355.269, "timestamp": "03:25:55", "text": "相机。我们走吧。"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "好的。你知道吗？把它放进去"}, {"type": "subtitle", "time": 12357.99, "timestamp": "03:25:57", "text": "地面。你不想要的东西，就扔掉吧。"}]
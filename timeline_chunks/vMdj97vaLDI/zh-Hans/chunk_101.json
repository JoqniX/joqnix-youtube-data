[{"type": "subtitle", "time": 6061.91, "timestamp": "01:41:01", "text": "到印度啤酒。它很轻。你"}, {"type": "subtitle", "time": 6063.27, "timestamp": "01:41:03", "text": "感觉不太像你知道自己什么时候会这样"}, {"type": "subtitle", "time": 6064.95, "timestamp": "01:41:04", "text": "喝啤酒后你会感觉非常强壮"}, {"type": "subtitle", "time": 6066.709, "timestamp": "01:41:06", "text": "感觉。你不明白，你不明白这一点。"}, {"type": "subtitle", "time": 6068.709, "timestamp": "01:41:08", "text": "尤其是搭配日本啤酒"}, {"type": "subtitle", "time": 6071.91, "timestamp": "01:41:11", "text": "明基，如果你只是想喝点什么的话"}, {"type": "chat", "time": 6074.037, "timestamp": "01:41:14", "author": "@vinzidcreator", "avatar": "https://yt4.ggpht.com/6N6hlttqAPJW-h4WV0cWFHqds0lBhXYYguTso6VNcwcD9Pl0uHdL7RphVieFjKCvwzUnqOh1=s64-c-k-c0x00ffffff-no-rj", "message": "saiko is amateur alcoholic "}, {"type": "subtitle", "time": 6074.39, "timestamp": "01:41:14", "text": "你可以直接去买便宜的啤酒"}, {"type": "subtitle", "time": 6076.629, "timestamp": "01:41:16", "text": "在便利店里，你会发现不同的口味。"}, {"type": "subtitle", "time": 6079.91, "timestamp": "01:41:19", "text": "啤酒简直像屎一样。"}, {"type": "subtitle", "time": 6081.99, "timestamp": "01:41:21", "text": "我哭了，因为我喜欢"}, {"type": "subtitle", "time": 6083.75, "timestamp": "01:41:23", "text": "啤酒，啤酒。我不喜欢这种混合口味。"}, {"type": "subtitle", "time": 6086.07, "timestamp": "01:41:26", "text": "除非是葡萄酒啤酒，否则就不是啤酒。"}, {"type": "subtitle", "time": 6088.95, "timestamp": "01:41:28", "text": "所以我去了那里。我喝了这个柠檬"}, {"type": "chat", "time": 6089.18, "timestamp": "01:41:29", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "I think most people are soft to alcohol. I drink vodka regularly. so beer is practically water to me."}, {"type": "subtitle", "time": 6090.55, "timestamp": "01:41:30", "text": "风味啤酒。我当时就想，“哦，柠檬”"}, {"type": "subtitle", "time": 6092.79, "timestamp": "01:41:32", "text": "风味啤酒。我的天哪。“我到了。”"}, {"type": "subtitle", "time": 6106.39, "timestamp": "01:41:46", "text": "是的。酒店。我认为大多数人都是"}, {"type": "subtitle", "time": 6108.709, "timestamp": "01:41:48", "text": "对啤酒来说很柔和。我认为是普通的伏特加。所以"}, {"type": "chat", "time": 6108.94, "timestamp": "01:41:48", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "lemondou?"}, {"type": "subtitle", "time": 6111.27, "timestamp": "01:41:51", "text": "啤酒和伏特加很像。我无法忍受我的身体"}, {"type": "subtitle", "time": 6113.109, "timestamp": "01:41:53", "text": "不能喝伏特加。我觉得我可能是"}, {"type": "subtitle", "time": 6116.51, "timestamp": "01:41:56", "text": "对……有轻微但非常奇怪的过敏反应"}, {"type": "subtitle", "time": 6119.669, "timestamp": "01:41:59", "text": "伏特加酒。所以我不能喝伏特加。伏特加不就是伏特加吗？"}]
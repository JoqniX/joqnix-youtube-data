[{"type": "subtitle", "time": 8360.469, "timestamp": "02:19:20", "text": "手电筒。我会回来的。等等，我会"}, {"type": "subtitle", "time": 8363.429, "timestamp": "02:19:23", "text": "我会跳过这个加载过程。"}, {"type": "subtitle", "time": 8366.549, "timestamp": "02:19:26", "text": "古老的溪流。哦，动作真快。"}, {"type": "subtitle", "time": 8370.469, "timestamp": "02:19:30", "text": "哦，是的。呃，有人……呃，我是谁？"}, {"type": "subtitle", "time": 8372.79, "timestamp": "02:19:32", "text": "想想 Guardian Gaming，你问对了吗？"}, {"type": "subtitle", "time": 8374.309, "timestamp": "02:19:34", "text": "恐怖直播。对，就是这样。"}, {"type": "subtitle", "time": 8380.469, "timestamp": "02:19:40", "text": "看看。我会回来的。过来一下。很多"}, {"type": "subtitle", "time": 8381.91, "timestamp": "02:19:41", "text": "谢谢。你好吗？我是"}, {"type": "subtitle", "time": 8386.629, "timestamp": "02:19:46", "text": "做好事。你好吗？好的。呃，让我"}, {"type": "subtitle", "time": 8391.95, "timestamp": "02:19:51", "text": "向雅克尼克问好。嘿，Jacnik，向你问好"}, {"type": "subtitle", "time": 8395.03, "timestamp": "02:19:55", "text": "嘿彦，你好吗？"}, {"type": "subtitle", "time": 8396.469, "timestamp": "02:19:56", "text": "你入手《雷电将军》了吗？"}, {"type": "subtitle", "time": 8399.349, "timestamp": "02:19:59", "text": "很遗憾，不行。我尝试了我所有的"}]
[{"type": "subtitle", "time": 12421.269, "timestamp": "03:27:01", "text": "这是特使。"}, {"type": "subtitle", "time": 12423.59, "timestamp": "03:27:03", "text": "我通常都感到很困惑"}, {"type": "subtitle", "time": 12426.87, "timestamp": "03:27:06", "text": "使节。我们在外面。"}, {"type": "subtitle", "time": 12435.51, "timestamp": "03:27:15", "text": "恶魔会出来。哦，对了，"}, {"type": "subtitle", "time": 12437.75, "timestamp": "03:27:17", "text": "鬼魂也会在外面出没。所以，"}, {"type": "subtitle", "time": 12440.63, "timestamp": "03:27:20", "text": "不要问：“你在这里安全吗？”不，"}, {"type": "subtitle", "time": 12443.03, "timestamp": "03:27:23", "text": "不，不。你在那里不安全。出色地，"}, {"type": "subtitle", "time": 12445.83, "timestamp": "03:27:25", "text": "关于它。你在那里不安全。只是"}, {"type": "subtitle", "time": 12449.99, "timestamp": "03:27:29", "text": "别这样，我们别变成一群吓人的人。"}, {"type": "subtitle", "time": 12451.75, "timestamp": "03:27:31", "text": "便便。比如，你能像光束一样传送吗？"}, {"type": "subtitle", "time": 12453.95, "timestamp": "03:27:33", "text": "再次成为我生命中的光，好吗？感谢"}, {"type": "subtitle", "time": 12457.79, "timestamp": "03:27:37", "text": "你。哦，会有人"}, {"type": "subtitle", "time": 12460.429, "timestamp": "03:27:40", "text": "打开。谁会那样做呢？"}, {"type": "subtitle", "time": 12470.87, "timestamp": "03:27:50", "text": "锤。好的。你喜欢什么？"}, {"type": "subtitle", "time": 12473.11, "timestamp": "03:27:53", "text": "哦，等等。你喜欢什么样的光线"}, {"type": "subtitle", "time": 12474.349, "timestamp": "03:27:54", "text": "这"}, {"type": "subtitle", "time": 12477.349, "timestamp": "03:27:57", "text": "事物？你能把那东西点亮吗？"}, {"type": "subtitle", "time": 12478.87, "timestamp": "03:27:58", "text": "不。"}]
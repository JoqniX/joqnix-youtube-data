[{"type": "subtitle", "time": 9304.75, "timestamp": "02:35:04", "text": "是。看看他。"}, {"type": "subtitle", "time": 9308.71, "timestamp": "02:35:08", "text": "我希望我在游戏中没有使用麦克风。"}, {"type": "subtitle", "time": 9311.309, "timestamp": "02:35:11", "text": "让我再确认一下。"}, {"type": "subtitle", "time": 9313.63, "timestamp": "02:35:13", "text": "好的。"}, {"type": "subtitle", "time": 9316.309, "timestamp": "02:35:16", "text": "呃，好的。我正在努力。好的，好的。"}, {"type": "subtitle", "time": 9333.429, "timestamp": "02:35:33", "text": "不，老实说，我真的"}, {"type": "subtitle", "time": 9348.99, "timestamp": "02:35:48", "text": "再说一遍，这个人正在看着"}, {"type": "subtitle", "time": 9354.07, "timestamp": "02:35:54", "text": "我。这家伙一直在盯着我看。"}]
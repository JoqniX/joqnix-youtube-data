[{"type": "subtitle", "time": 13140.469, "timestamp": "03:39:00", "text": "去噩梦吧。去吧，噩梦！ WHO"}, {"type": "subtitle", "time": 13142.15, "timestamp": "03:39:02", "text": "关心吗？就像我们正在死去一样"}, {"type": "subtitle", "time": 13145.19, "timestamp": "03:39:05", "text": "反正就是第二。我不知道。它是"}, {"type": "subtitle", "time": 13147.91, "timestamp": "03:39:07", "text": "至少会很有趣。"}, {"type": "subtitle", "time": 13151.59, "timestamp": "03:39:11", "text": "你想看哪张地图？"}, {"type": "subtitle", "time": 13154.03, "timestamp": "03:39:14", "text": "咱们去农场吧"}, {"type": "subtitle", "time": 13161.03, "timestamp": "03:39:21", "text": "好的。那我还需要再买些什么呢？"}, {"type": "subtitle", "time": 13162.55, "timestamp": "03:39:22", "text": "打火机。"}, {"type": "subtitle", "time": 13164.15, "timestamp": "03:39:24", "text": "不，不，不。我买了。我买了。我"}, {"type": "subtitle", "time": 13166.309, "timestamp": "03:39:26", "text": "买了。什么都别做。好的。我该怎么做？"}, {"type": "subtitle", "time": 13168.71, "timestamp": "03:39:28", "text": "还需要买其他东西吗？"}, {"type": "subtitle", "time": 13171.429, "timestamp": "03:39:31", "text": "我不知道。你能买到麦克风吗？"}, {"type": "subtitle", "time": 13175.269, "timestamp": "03:39:35", "text": "就像那个那个"}, {"type": "subtitle", "time": 13179.19, "timestamp": "03:39:39", "text": "呃，是温度计吗？你能买到吗？"}, {"type": "subtitle", "time": 13182.469, "timestamp": "03:39:42", "text": "请问可以帮我拿个体温计吗？温度计。"}, {"type": "subtitle", "time": 13185.83, "timestamp": "03:39:45", "text": "我还没解锁哦，等等。是什么？"}, {"type": "subtitle", "time": 13187.79, "timestamp": "03:39:47", "text": "好的，明白了。知道了。得到"}, {"type": "subtitle", "time": 13194.309, "timestamp": "03:39:54", "text": "哦，等等。让我和，不要，不要"}, {"type": "subtitle", "time": 13196.309, "timestamp": "03:39:56", "text": "不要做“让我去除污迹”这种事"}, {"type": "subtitle", "time": 13199.59, "timestamp": "03:39:59", "text": "戳。是的，别碰熏香棒。"}]
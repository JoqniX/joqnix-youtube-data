[{"type": "subtitle", "time": 7261.75, "timestamp": "02:01:01", "text": "我认识一个住在大阪的人。"}, {"type": "subtitle", "time": 7263.91, "timestamp": "02:01:03", "text": "他们最近搬到了大阪。"}, {"type": "subtitle", "time": 7266.229, "timestamp": "02:01:06", "text": "所以我可以问他们，比如你们是怎么搬家的。"}, {"type": "subtitle", "time": 7268.95, "timestamp": "02:01:08", "text": "诸如此类的事情，因为对我来说，虽然我……"}, {"type": "subtitle", "time": 7270.79, "timestamp": "02:01:10", "text": "几个月都没去。"}, {"type": "subtitle", "time": 7272.55, "timestamp": "02:01:12", "text": "我只去了一个月。所以，还有"}, {"type": "subtitle", "time": 7274.55, "timestamp": "02:01:14", "text": "问题是我没买，也没携带任何东西。"}, {"type": "subtitle", "time": 7275.99, "timestamp": "02:01:15", "text": "因为我打算穿任何衣服"}, {"type": "subtitle", "time": 7277.87, "timestamp": "02:01:17", "text": "从那里买衣服"}, {"type": "subtitle", "time": 7281.83, "timestamp": "02:01:21", "text": "本身。是的"}, {"type": "subtitle", "time": 7284.149, "timestamp": "02:01:24", "text": "带很多东西，或者尽量不要买东西。"}, {"type": "subtitle", "time": 7285.109, "timestamp": "02:01:25", "text": "很多东西，因为当你"}, {"type": "subtitle", "time": 7287.189, "timestamp": "02:01:27", "text": "返回你的背部"}, {"type": "subtitle", "time": 7289.43, "timestamp": "02:01:29", "text": "你必须喜欢那里的地方，那里会有"}, {"type": "subtitle", "time": 7291.91, "timestamp": "02:01:31", "text": "你要带回去的东西可真不少。"}, {"type": "subtitle", "time": 7294.55, "timestamp": "02:01:34", "text": "家。嗯。但他们确实有喜欢"}, {"type": "subtitle", "time": 7295.91, "timestamp": "02:01:35", "text": "提供各种服务，让您无需担心"}, {"type": "subtitle", "time": 7298.55, "timestamp": "02:01:38", "text": "关于那件事。所以如果你想……"}, {"type": "subtitle", "time": 7300.47, "timestamp": "02:01:40", "text": "如果你需要很多东西，也许可以考虑包裹寄送。"}, {"type": "subtitle", "time": 7302.0, "timestamp": "02:01:42", "text": "他们。"}, {"type": "subtitle", "time": 7303.27, "timestamp": "02:01:43", "text": "[音乐]"}, {"type": "subtitle", "time": 7307.669, "timestamp": "02:01:47", "text": "是的。是的。我应该那样做。是的。"}, {"type": "subtitle", "time": 7310.55, "timestamp": "02:01:50", "text": "那样就没用了。但我"}, {"type": "subtitle", "time": 7312.95, "timestamp": "02:01:52", "text": "现在应该快10点半了吧？我"}, {"type": "subtitle", "time": 7316.31, "timestamp": "02:01:56", "text": "我得回去工作了。"}, {"type": "subtitle", "time": 7318.79, "timestamp": "02:01:58", "text": "所以我想我得回去了。"}]
[{"type": "subtitle", "time": 9360.19, "timestamp": "02:36:00", "text": "这？那家伙简直是在对着人大喊大叫"}, {"type": "subtitle", "time": 9367.59, "timestamp": "02:36:07", "text": "上帝。我不应该尖叫，因为"}, {"type": "subtitle", "time": 9370.67, "timestamp": "02:36:10", "text": "下午。我不想醒来"}, {"type": "subtitle", "time": 9374.15, "timestamp": "02:36:14", "text": "向上。还有，贝克那边发生了什么事？"}, {"type": "subtitle", "time": 9381.75, "timestamp": "02:36:21", "text": "那里？这是一个可爱的雪人。不，她确实有。"}, {"type": "subtitle", "time": 9383.87, "timestamp": "02:36:23", "text": "不想看"}, {"type": "subtitle", "time": 9386.389, "timestamp": "02:36:26", "text": "我。我"}, {"type": "subtitle", "time": 9389.19, "timestamp": "02:36:29", "text": "你可以做到。"}, {"type": "subtitle", "time": 9391.19, "timestamp": "02:36:31", "text": "是的，你不能再次输入相同的代码。"}, {"type": "subtitle", "time": 9393.03, "timestamp": "02:36:33", "text": "因为我"}, {"type": "subtitle", "time": 9395.99, "timestamp": "02:36:35", "text": "你好。你好。我回来了。我的天啊。"}, {"type": "subtitle", "time": 9398.15, "timestamp": "02:36:38", "text": "真是见鬼。"}, {"type": "subtitle", "time": 9400.23, "timestamp": "02:36:40", "text": "我会回来的。"}, {"type": "subtitle", "time": 9402.15, "timestamp": "02:36:42", "text": "后退。我回来了。我还活着。我还活着。"}, {"type": "subtitle", "time": 9411.83, "timestamp": "02:36:51", "text": "上帝。加入。我可以加入我自己的服务器吗？"}, {"type": "subtitle", "time": 9414.87, "timestamp": "02:36:54", "text": "是的。是的。是的。是的。是的。同样的"}]
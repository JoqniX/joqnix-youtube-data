[{"type": "subtitle", "time": 13801.91, "timestamp": "03:50:01", "text": "祝你今天过得愉快。"}, {"type": "subtitle", "time": 13803.07, "timestamp": "03:50:03", "text": "所以"}, {"type": "subtitle", "time": 13806.07, "timestamp": "03:50:06", "text": "有趣的。又死了一次。等等，你是"}, {"type": "subtitle", "time": 13809.59, "timestamp": "03:50:09", "text": "听起来很闷。看。不用担心。"}, {"type": "subtitle", "time": 13810.399, "timestamp": "03:50:10", "text": "不用担心。 我当时"}, {"type": "subtitle", "time": 13813.52, "timestamp": "03:50:13", "text": "我当时 我现在可以了吗？我现在可以了吗？是的。"}, {"type": "subtitle", "time": 13815.04, "timestamp": "03:50:15", "text": "我现在可以了吗？我现在可以了吗？是的。 是的。是的，你没问题。"}, {"type": "subtitle", "time": 13817.359, "timestamp": "03:50:17", "text": "是的。是的，你没问题。 好的。我表现好吗，兄弟？是的。草地"}, {"type": "subtitle", "time": 13821.439, "timestamp": "03:50:21", "text": "好的。我表现好吗，兄弟？是的。草地 限制器。这是什么？"}, {"type": "subtitle", "time": 13827.91, "timestamp": "03:50:27", "text": "这是什么地方？耶稣，这个地方是"}, {"type": "subtitle", "time": 13829.99, "timestamp": "03:50:29", "text": "巨大无比。"}, {"type": "subtitle", "time": 13837.51, "timestamp": "03:50:37", "text": "好的，朱莉·汤普森。"}, {"type": "subtitle", "time": 13839.59, "timestamp": "03:50:39", "text": "请团队成员见证"}, {"type": "subtitle", "time": 13841.349, "timestamp": "03:50:41", "text": "幽灵事件。让你的团队成员"}, {"type": "subtitle", "time": 13845.189, "timestamp": "03:50:45", "text": "狩猎途中躲避鬼魂。好的。所以，"}, {"type": "subtitle", "time": 13846.87, "timestamp": "03:50:46", "text": "逃离幽灵意味着我需要来"}, {"type": "subtitle", "time": 13849.99, "timestamp": "03:50:49", "text": "回到这辆卡车或者类似的地方"}, {"type": "subtitle", "time": 13852.389, "timestamp": "03:50:52", "text": "不，你必须逃跑。逃脱。逃脱"}, {"type": "subtitle", "time": 13856.269, "timestamp": "03:50:56", "text": "意思是说，你必须活着。"}]
[{"type": "subtitle", "time": 5704.31, "timestamp": "01:35:04", "text": "前进。你说我看到了他们的"}, {"type": "subtitle", "time": 5706.07, "timestamp": "01:35:06", "text": "洋葱价格飙升，我当时就想：什么鬼？"}, {"type": "subtitle", "time": 5709.51, "timestamp": "01:35:09", "text": "他妈的？多少钱？"}, {"type": "subtitle", "time": 5712.149, "timestamp": "01:35:12", "text": "我不知道现在是多少。"}, {"type": "subtitle", "time": 5716.39, "timestamp": "01:35:16", "text": "当时大概是300左右吧。"}, {"type": "subtitle", "time": 5719.51, "timestamp": "01:35:19", "text": "大约300日元。"}, {"type": "subtitle", "time": 5724.79, "timestamp": "01:35:24", "text": "这会不会有点过分了？"}, {"type": "subtitle", "time": 5729.75, "timestamp": "01:35:29", "text": "两个差不多一个180卢比。究竟是什么？"}, {"type": "subtitle", "time": 5733.11, "timestamp": "01:35:33", "text": "多少？ 1公斤。昂贵的。我不"}, {"type": "subtitle", "time": 5734.55, "timestamp": "01:35:34", "text": "知道它有多少钱，就像三个"}, {"type": "chat", "time": 5735.198, "timestamp": "01:35:35", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "wait till you see the prices here 🥲"}, {"type": "subtitle", "time": 5737.51, "timestamp": "01:35:37", "text": "三个洋葱。什么？"}, {"type": "subtitle", "time": 5739.11, "timestamp": "01:35:39", "text": "这大概是三个洋葱之类的东西。"}, {"type": "subtitle", "time": 5741.83, "timestamp": "01:35:41", "text": "兄弟，三个四个洋葱放在一起。那是"}, {"type": "subtitle", "time": 5744.149, "timestamp": "01:35:44", "text": "并非说它不是来自市场。那"}, {"type": "subtitle", "time": 5745.83, "timestamp": "01:35:45", "text": "就在附近，我不知道是哪个。"}, {"type": "subtitle", "time": 5749.229, "timestamp": "01:35:49", "text": "那是在公司或者某个地方。但"}, {"type": "subtitle", "time": 5752.75, "timestamp": "01:35:52", "text": "然后查看价格"}, {"type": "subtitle", "time": 5757.51, "timestamp": "01:35:57", "text": "你知道，我在这里，在橙色里"}]
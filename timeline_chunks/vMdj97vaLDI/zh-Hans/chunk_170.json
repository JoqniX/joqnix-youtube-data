[{"type": "subtitle", "time": 10205.349, "timestamp": "02:50:05", "text": "啊。哦，就在这个房间里。在"}, {"type": "subtitle", "time": 10208.07, "timestamp": "02:50:08", "text": "这个房间。我在躲藏。我在躲藏。我是"}, {"type": "subtitle", "time": 10210.63, "timestamp": "02:50:10", "text": "对不起。是的。"}, {"type": "subtitle", "time": 10213.59, "timestamp": "02:50:13", "text": "这里。你会去哪里？呃，就是上面那一个。"}, {"type": "subtitle", "time": 10216.23, "timestamp": "02:50:16", "text": "这里。直的。就是这个。好的。"}, {"type": "subtitle", "time": 10217.83, "timestamp": "02:50:17", "text": "是的。是的。是的。是的。那个。是的。"}, {"type": "subtitle", "time": 10220.87, "timestamp": "02:50:20", "text": "是的。是的。是的。你在这里吗？好的。"}, {"type": "subtitle", "time": 10222.83, "timestamp": "02:50:22", "text": "这就是这个"}, {"type": "subtitle", "time": 10226.51, "timestamp": "02:50:26", "text": "是二。好的。哦，冰冻"}, {"type": "subtitle", "time": 10229.67, "timestamp": "02:50:29", "text": "衣橱内的温度。我可以看到我"}, {"type": "subtitle", "time": 10233.469, "timestamp": "02:50:33", "text": "可以看到衣柜里的东西。"}, {"type": "subtitle", "time": 10236.309, "timestamp": "02:50:36", "text": "好的。它不在“哦”，它在“"}, {"type": "subtitle", "time": 10238.23, "timestamp": "02:50:38", "text": "浴室。没关系。天气不冷"}, {"type": "subtitle", "time": 10243.71, "timestamp": "02:50:43", "text": "但"}, {"type": "subtitle", "time": 10246.19, "timestamp": "02:50:46", "text": "好的。现在气温并不低。"}, {"type": "subtitle", "time": 10249.75, "timestamp": "02:50:49", "text": "然而。天气渐渐冷了，但还没到……"}, {"type": "subtitle", "time": 10252.71, "timestamp": "02:50:52", "text": "气温骤降至冰点以下。好的。我应该这样做吗？"}, {"type": "subtitle", "time": 10255.67, "timestamp": "02:50:55", "text": "呃，记在日记里吗？"}, {"type": "subtitle", "time": 10257.19, "timestamp": "02:50:57", "text": "不，不，现在气温不是冰点以下。"}, {"type": "subtitle", "time": 10259.15, "timestamp": "02:50:59", "text": "必须是"}]
[{"type": "subtitle", "time": 15125.469, "timestamp": "04:12:05", "text": "哦，我刚才是不是把自己锁起来了？"}, {"type": "subtitle", "time": 15128.63, "timestamp": "04:12:08", "text": "这里？没关系。让我看看我自己的"}, {"type": "subtitle", "time": 15131.67, "timestamp": "04:12:11", "text": "直播并查看。我当时拿着"}, {"type": "subtitle", "time": 15134.63, "timestamp": "04:12:14", "text": "想法。这就是原因。"}, {"type": "subtitle", "time": 15138.07, "timestamp": "04:12:18", "text": "哦，好的。哦，真吓人。对，就是ASMR。"}, {"type": "subtitle", "time": 15140.63, "timestamp": "04:12:20", "text": "就写在这里。没关系。"}, {"type": "subtitle", "time": 15143.67, "timestamp": "04:12:23", "text": "我和吉姆一起去。"}, {"type": "subtitle", "time": 15148.389, "timestamp": "04:12:28", "text": "以防万一。你还活着吗？"}, {"type": "subtitle", "time": 15151.03, "timestamp": "04:12:31", "text": "我还活着。我心想，你看看我的"}, {"type": "subtitle", "time": 15153.03, "timestamp": "04:12:33", "text": "直播吧，兄弟。是的。是的。是的。我 我"}, {"type": "subtitle", "time": 15156.309, "timestamp": "04:12:36", "text": "看着“糟糕”。我感觉就像……"}, {"type": "subtitle", "time": 15158.63, "timestamp": "04:12:38", "text": "顺便说一句，我就是在这个房间里。是的。"}, {"type": "subtitle", "time": 15159.91, "timestamp": "04:12:39", "text": "是的。是的。我正在观看。我看到"}, {"type": "subtitle", "time": 15162.309, "timestamp": "04:12:42", "text": "这个鬼魂。他呼吸很急促。它是"}, {"type": "subtitle", "time": 15165.03, "timestamp": "04:12:45", "text": "真的，真的。他正朝这边走来"}, {"type": "subtitle", "time": 15166.51, "timestamp": "04:12:46", "text": "呃，那个"}, {"type": "subtitle", "time": 15170.469, "timestamp": "04:12:50", "text": "洗手间。第一个厕所。非常"}, {"type": "subtitle", "time": 15173.79, "timestamp": "04:12:53", "text": "那个东西。他正朝那边走去"}, {"type": "subtitle", "time": 15177.03, "timestamp": "04:12:57", "text": "我。哦，不。它在这里。顺便说一句，我的我的"}, {"type": "subtitle", "time": 15179.75, "timestamp": "04:12:59", "text": "设备一直在自动开关机。在哪里？"}]
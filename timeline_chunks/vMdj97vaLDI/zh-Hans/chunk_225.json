[{"type": "subtitle", "time": 13501.03, "timestamp": "03:45:01", "text": "大厅。是的。是的。好的。好的。它是"}, {"type": "subtitle", "time": 13502.95, "timestamp": "03:45:02", "text": "字面意义上的从门口，前门。"}, {"type": "subtitle", "time": 13505.51, "timestamp": "03:45:05", "text": "好的。我要上去。如果我死了，我"}, {"type": "subtitle", "time": 13507.349, "timestamp": "03:45:07", "text": "我会的，我会告诉你的。如果"}, {"type": "subtitle", "time": 13509.349, "timestamp": "03:45:09", "text": "我死后会通知你的。所以，我会"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "就上来吧，嗯，所以这个活动是……"}, {"type": "subtitle", "time": 13516.07, "timestamp": "03:45:16", "text": "你快死了，我要跑出去。"}, {"type": "subtitle", "time": 13518.63, "timestamp": "03:45:18", "text": "是的。好的。轻松赚钱。我猜是这样"}, {"type": "subtitle", "time": 13523.83, "timestamp": "03:45:23", "text": "打开。气温会降到冰点以下吗？没有。不"}, {"type": "subtitle", "time": 13528.79, "timestamp": "03:45:28", "text": "冰冻温度。我稳操胜券。"}, {"type": "subtitle", "time": 13533.11, "timestamp": "03:45:33", "text": "我就像门上的一把锁。"}, {"type": "subtitle", "time": 13535.03, "timestamp": "03:45:35", "text": "好的。"}, {"type": "subtitle", "time": 13537.59, "timestamp": "03:45:37", "text": "啊，这都怪我。"}, {"type": "subtitle", "time": 13539.59, "timestamp": "03:45:39", "text": "等等，你正在经历这件事吗？"}, {"type": "subtitle", "time": 13547.429, "timestamp": "03:45:47", "text": "EMF4。 EMF4。 EMF4。哦，是，是，是"}, {"type": "subtitle", "time": 13550.469, "timestamp": "03:45:50", "text": "好的。呃，我快死了吗？"}, {"type": "subtitle", "time": 13552.71, "timestamp": "03:45:52", "text": "你快要死了吗？"}, {"type": "subtitle", "time": 13555.75, "timestamp": "03:45:55", "text": "我不会死。哦，是的，是的，它在里面吗？"}, {"type": "subtitle", "time": 13558.15, "timestamp": "03:45:58", "text": "是在这个房间里吗？哪个房间？"}]
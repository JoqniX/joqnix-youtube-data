[{"type": "subtitle", "time": 11280.23, "timestamp": "03:08:00", "text": "确实听到了，也看到了那个冷冻的东西。哦，我的"}, {"type": "subtitle", "time": 11281.83, "timestamp": "03:08:01", "text": "上帝。是的。是的。没关系。没关系。"}, {"type": "subtitle", "time": 11283.23, "timestamp": "03:08:03", "text": "它是"}, {"type": "subtitle", "time": 11285.99, "timestamp": "03:08:05", "text": "美好的。它非常简洁。极少的闹鬼现象。"}, {"type": "subtitle", "time": 11288.55, "timestamp": "03:08:08", "text": "没关系。极少的闹鬼现象。它是"}, {"type": "subtitle", "time": 11292.79, "timestamp": "03:08:12", "text": "好的。我们拿到一个了。我还有一个。"}, {"type": "subtitle", "time": 11303.83, "timestamp": "03:08:23", "text": "不，不，我们实际上需要别的东西。"}, {"type": "subtitle", "time": 11305.91, "timestamp": "03:08:25", "text": "我们其实还需要别的东西。好的，"}, {"type": "subtitle", "time": 11309.51, "timestamp": "03:08:29", "text": "我们没事的。有任何证据吗？"}, {"type": "subtitle", "time": 11312.95, "timestamp": "03:08:32", "text": "我们没有等等，我……我……我……我看到了"}, {"type": "subtitle", "time": 11316.87, "timestamp": "03:08:36", "text": "就像你知道的，空气来了"}, {"type": "subtitle", "time": 11319.83, "timestamp": "03:08:39", "text": "脱口而出是因为：哦，你拿到了吗？"}, {"type": "subtitle", "time": 11322.63, "timestamp": "03:08:42", "text": "你有吗？不，不。就像我看到的那样。"}, {"type": "subtitle", "time": 11325.11, "timestamp": "03:08:45", "text": "就像那个东西，就像气体一样"}, {"type": "subtitle", "time": 11327.269, "timestamp": "03:08:47", "text": "从你嘴里出来的东西"}, {"type": "subtitle", "time": 11329.51, "timestamp": "03:08:49", "text": "你那里冷得要命。"}, {"type": "subtitle", "time": 11331.11, "timestamp": "03:08:51", "text": "是从我们嘴里说出来的，对吧？就是这样。"}, {"type": "subtitle", "time": 11334.469, "timestamp": "03:08:54", "text": "顺便说一句，气温非常低。好的。所以，我们"}, {"type": "subtitle", "time": 11337.67, "timestamp": "03:08:57", "text": "可能会出现冰冻低温。电磁场或其他什么？"}]
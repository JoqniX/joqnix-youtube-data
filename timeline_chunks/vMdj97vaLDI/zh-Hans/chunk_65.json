[{"type": "subtitle", "time": 3902.23, "timestamp": "01:05:02", "text": "发酵食品，你可能会感觉有点"}, {"type": "subtitle", "time": 3905.75, "timestamp": "01:05:05", "text": "很像你，你可能需要很多"}, {"type": "subtitle", "time": 3908.99, "timestamp": "01:05:08", "text": "厌倦了，否则有些人会喜欢它"}, {"type": "subtitle", "time": 3911.99, "timestamp": "01:05:11", "text": "人们不会喜欢纳豆"}, {"type": "subtitle", "time": 3914.15, "timestamp": "01:05:14", "text": "根据我的经验，我能让人们……"}, {"type": "subtitle", "time": 3916.069, "timestamp": "01:05:16", "text": "吃纳豆，他们其实不太喜欢。"}, {"type": "subtitle", "time": 3918.39, "timestamp": "01:05:18", "text": "因为它是发酵的，所以"}, {"type": "subtitle", "time": 3920.71, "timestamp": "01:05:20", "text": "他们觉得这很奇怪。嗯。但是……"}, {"type": "subtitle", "time": 3923.349, "timestamp": "01:05:23", "text": "对我们来说，就像我们的linaga一样，我们只是吃"}, {"type": "subtitle", "time": 3925.51, "timestamp": "01:05:25", "text": "因为它很简单，它基本上就是如此。"}, {"type": "subtitle", "time": 3928.15, "timestamp": "01:05:28", "text": "发酵程度较低的阿库尼或"}, {"type": "subtitle", "time": 3930.23, "timestamp": "01:05:30", "text": "皮娅。味道确实很好。你喜欢"}, {"type": "subtitle", "time": 3932.549, "timestamp": "01:05:32", "text": "它。就像这样把米饭放在上面。"}, {"type": "subtitle", "time": 3936.789, "timestamp": "01:05:36", "text": "非常热，就像一碗热腾腾的米饭。"}, {"type": "chat", "time": 3939.971, "timestamp": "01:05:39", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "I ate it with roti"}, {"type": "subtitle", "time": 3940.15, "timestamp": "01:05:40", "text": "然后放入纳豆。不，不。放入蛋黄"}, {"type": "subtitle", "time": 3942.39, "timestamp": "01:05:42", "text": "这样它就能更快煮熟。所以放鸡蛋"}, {"type": "subtitle", "time": 3944.95, "timestamp": "01:05:44", "text": "先放蛋黄，再放纳豆，最后放一点"}, {"type": "subtitle", "time": 3946.71, "timestamp": "01:05:46", "text": "少许酱油。将它们混合在一起"}, {"type": "subtitle", "time": 3949.43, "timestamp": "01:05:49", "text": "吃那玩意儿。味道非常好。"}, {"type": "subtitle", "time": 3956.15, "timestamp": "01:05:56", "text": "我想问一下，你有没有去过任何地方？"}, {"type": "subtitle", "time": 3958.71, "timestamp": "01:05:58", "text": "日本的猫咪咖啡馆怎么样？"}]
[{"type": "subtitle", "time": 12121.349, "timestamp": "03:22:01", "text": "需要手电筒。额外的手电筒"}, {"type": "subtitle", "time": 12125.03, "timestamp": "03:22:05", "text": "因为我非常累。哦，我们需要一个"}, {"type": "subtitle", "time": 12127.429, "timestamp": "03:22:07", "text": "温度计也是。比如什么？多少"}, {"type": "subtitle", "time": 12130.229, "timestamp": "03:22:10", "text": "这是温度计吗？是30ucks。"}, {"type": "subtitle", "time": 12132.229, "timestamp": "03:22:12", "text": "体温计是免费的。实际上，我们将"}, {"type": "subtitle", "time": 12134.71, "timestamp": "03:22:14", "text": "每周五获得一个。"}, {"type": "subtitle", "time": 12137.349, "timestamp": "03:22:17", "text": "不，不，我们不会每次都拿到体温计。"}, {"type": "subtitle", "time": 12139.429, "timestamp": "03:22:19", "text": "圆形的。不，我的意思是温度计的意思"}, {"type": "subtitle", "time": 12142.71, "timestamp": "03:22:22", "text": "电磁场读数器。不，不，不。那把枪。这"}, {"type": "subtitle", "time": 12144.229, "timestamp": "03:22:24", "text": "枪。你看到的那把枪"}, {"type": "subtitle", "time": 12146.79, "timestamp": "03:22:26", "text": "温度随。"}, {"type": "subtitle", "time": 12150.55, "timestamp": "03:22:30", "text": "哦，那是什么？蓝色的枪"}, {"type": "subtitle", "time": 12159.71, "timestamp": "03:22:39", "text": "哦，原来是这样。实际上"}, {"type": "subtitle", "time": 12163.15, "timestamp": "03:22:43", "text": "它。荧光棒。你想要固体胶棒吗？"}, {"type": "subtitle", "time": 12166.389, "timestamp": "03:22:46", "text": "辉光。理智药丸。盐。不。不。"}, {"type": "subtitle", "time": 12169.67, "timestamp": "03:22:49", "text": "蜡烛。一根熏香棒就足够了。"}, {"type": "subtitle", "time": 12172.389, "timestamp": "03:22:52", "text": "正确的？好的。你知道吗？你需要一个"}, {"type": "subtitle", "time": 12173.67, "timestamp": "03:22:53", "text": "蜡烛和鼠尾草熏香棒，因为"}, {"type": "subtitle", "time": 12175.95, "timestamp": "03:22:55", "text": "有很多"}, {"type": "subtitle", "time": 12178.469, "timestamp": "03:22:58", "text": "就像熏香棒一样。我不知道。但我"}]
[{"type": "subtitle", "time": 12662.229, "timestamp": "03:31:02", "text": "呃，活动时间。你是怎么学会这一切的"}, {"type": "subtitle", "time": 12664.309, "timestamp": "03:31:04", "text": "这？"}, {"type": "subtitle", "time": 12667.349, "timestamp": "03:31:07", "text": "我不知道。我感到非常困惑。我"}, {"type": "subtitle", "time": 12669.51, "timestamp": "03:31:09", "text": "和你一样困惑。对了，你是……"}, {"type": "subtitle", "time": 12672.55, "timestamp": "03:31:12", "text": "探究恐怖之处？"}, {"type": "subtitle", "time": 12686.389, "timestamp": "03:31:26", "text": "你好呀。"}, {"type": "subtitle", "time": 12698.389, "timestamp": "03:31:38", "text": "你……哦，不。这株植物是你种的吗？"}, {"type": "subtitle", "time": 12700.07, "timestamp": "03:31:40", "text": "这本书？你把书藏起来了吗？不，"}, {"type": "subtitle", "time": 12702.309, "timestamp": "03:31:42", "text": "不，不，不，不。我会把书埋起来"}, {"type": "subtitle", "time": 12703.99, "timestamp": "03:31:43", "text": "中心。"}, {"type": "subtitle", "time": 12706.15, "timestamp": "03:31:46", "text": "是的。请放在桌子上。哦，就像在"}, {"type": "subtitle", "time": 12708.79, "timestamp": "03:31:48", "text": "在这张奇形怪状的床上。哦，"}, {"type": "subtitle", "time": 12712.07, "timestamp": "03:31:52", "text": "这是一张沙发。没关系。这是一张沙发。"}, {"type": "subtitle", "time": 12713.83, "timestamp": "03:31:53", "text": "伙计们。虚惊。这是一张沙发。它不是"}, {"type": "subtitle", "time": 12716.55, "timestamp": "03:31:56", "text": "一个看起来像床的东西。好的，我把它放上去。"}, {"type": "subtitle", "time": 12719.59, "timestamp": "03:31:59", "text": "在这把椅子上。好的。我无法喜欢"}]
[{"type": "subtitle", "time": 9722.389, "timestamp": "02:42:02", "text": "总共七人。我们成功了。我准备好了。"}, {"type": "subtitle", "time": 9724.55, "timestamp": "02:42:04", "text": "杰克，请在这里选择地图。是的。"}, {"type": "subtitle", "time": 9726.07, "timestamp": "02:42:06", "text": "是的，我做了。哦，你确实选择了地图。"}, {"type": "subtitle", "time": 9729.27, "timestamp": "02:42:09", "text": "这里。我也准备好了。"}, {"type": "subtitle", "time": 9732.389, "timestamp": "02:42:12", "text": "准备好。准备好。开始。开始绘制地图。哦，"}, {"type": "subtitle", "time": 9734.75, "timestamp": "02:42:14", "text": "是的。是的。我是领导者。我忘了。"}, {"type": "subtitle", "time": 9738.15, "timestamp": "02:42:18", "text": "好的。我当时就想，当你得分的时候……"}, {"type": "subtitle", "time": 9741.11, "timestamp": "02:42:21", "text": "她上来了。等待。决不。决不。不"}, {"type": "subtitle", "time": 9743.91, "timestamp": "02:42:23", "text": "方式。"}, {"type": "subtitle", "time": 9748.07, "timestamp": "02:42:28", "text": "哦，不。哟，一切顺利。去！去！去。哦，"}, {"type": "subtitle", "time": 9749.51, "timestamp": "02:42:29", "text": "好的。我们到了。哦，不错。"}, {"type": "subtitle", "time": 9751.19, "timestamp": "02:42:31", "text": "最后。设备和准备"}, {"type": "subtitle", "time": 9752.95, "timestamp": "02:42:32", "text": "因此。好的。我们有两个"}, {"type": "subtitle", "time": 9755.349, "timestamp": "02:42:35", "text": "手电筒。"}, {"type": "subtitle", "time": 9758.79, "timestamp": "02:42:38", "text": "我们有污渍吗？"}, {"type": "subtitle", "time": 9761.27, "timestamp": "02:42:41", "text": "我想我们确实有一个，哦，我们有一个。"}, {"type": "subtitle", "time": 9763.11, "timestamp": "02:42:43", "text": "弄脏。是的，我们有一个污点。"}, {"type": "subtitle", "time": 9765.67, "timestamp": "02:42:45", "text": "是的。好的。所以，我们需要做的是……"}, {"type": "subtitle", "time": 9769.03, "timestamp": "02:42:49", "text": "捕获。哦，是的。直接拿起来就行了。"}, {"type": "subtitle", "time": 9771.429, "timestamp": "02:42:51", "text": "这是什么？喜欢"}, {"type": "subtitle", "time": 9773.87, "timestamp": "02:42:53", "text": "鬼魂。我们没有相机。我是"}, {"type": "subtitle", "time": 9776.07, "timestamp": "02:42:56", "text": "对不起。拿着烟熏棒的幽灵。我们确实"}]
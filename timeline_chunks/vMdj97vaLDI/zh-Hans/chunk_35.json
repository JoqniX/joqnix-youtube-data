[{"type": "subtitle", "time": 2101.349, "timestamp": "00:35:01", "text": "他怎么就摔倒了？"}, {"type": "subtitle", "time": 2103.03, "timestamp": "00:35:03", "text": "哦，我的"}, {"type": "subtitle", "time": 2113.829, "timestamp": "00:35:13", "text": "哦，太好了。"}, {"type": "subtitle", "time": 2135.109, "timestamp": "00:35:35", "text": "我的天啊。好的。"}, {"type": "subtitle", "time": 2136.829, "timestamp": "00:35:36", "text": "我想复制"}, {"type": "subtitle", "time": 2141.109, "timestamp": "00:35:41", "text": "这。我复制了吗？他变得更加阴暗。"}, {"type": "subtitle", "time": 2143.27, "timestamp": "00:35:43", "text": "颜色。我的天啊。等待。为什么我无法获得"}, {"type": "subtitle", "time": 2144.43, "timestamp": "00:35:44", "text": "他的呃"}, {"type": "subtitle", "time": 2148.55, "timestamp": "00:35:48", "text": "那玩意儿？是的。呃"}, {"type": "subtitle", "time": 2153.03, "timestamp": "00:35:53", "text": "我该怎么做？我无法克隆它。什么？"}, {"type": "subtitle", "time": 2159.27, "timestamp": "00:35:59", "text": "可以查一下，但我不能点赞"}]
[{"type": "subtitle", "time": 12722.389, "timestamp": "03:32:02", "text": "找到任何。就像这个软件的一个问题一样"}, {"type": "subtitle", "time": 12725.269, "timestamp": "03:32:05", "text": "这游戏玩起来简直就像我需要躲起来一样。"}, {"type": "subtitle", "time": 12727.59, "timestamp": "03:32:07", "text": "我该如何打开这本书？"}, {"type": "subtitle", "time": 12729.99, "timestamp": "03:32:09", "text": "好的。我们需要更多的盲人吗？我们开始吧"}, {"type": "subtitle", "time": 12740.15, "timestamp": "03:32:20", "text": "如何打开这本书。不，不，不。 F."}, {"type": "subtitle", "time": 12744.229, "timestamp": "03:32:24", "text": "拿起这本书。 F 和是的。跳。不，"}, {"type": "subtitle", "time": 12747.19, "timestamp": "03:32:27", "text": "不，不，不，不，不，不，不，不。一个也没有。"}, {"type": "subtitle", "time": 12749.19, "timestamp": "03:32:29", "text": "我们上楼吧。我们上楼吧。"}, {"type": "subtitle", "time": 12752.15, "timestamp": "03:32:32", "text": "工作。不要离开我。如果我们死了，"}, {"type": "subtitle", "time": 12754.95, "timestamp": "03:32:34", "text": "我们一起死去。没关系。"}, {"type": "subtitle", "time": 12758.229, "timestamp": "03:32:38", "text": "你好吗？我不在乎，就像不，我"}, {"type": "subtitle", "time": 12762.07, "timestamp": "03:32:42", "text": "我没有钱，或者像我一样，我是"}, {"type": "subtitle", "time": 12764.229, "timestamp": "03:32:44", "text": "此处已确定。"}, {"type": "subtitle", "time": 12766.429, "timestamp": "03:32:46", "text": "你在吗？"}, {"type": "subtitle", "time": 12770.63, "timestamp": "03:32:50", "text": "这里？你在哪里？那是什么声音？"}, {"type": "subtitle", "time": 12772.71, "timestamp": "03:32:52", "text": "你用过灵盒吗？哦好的。"}, {"type": "subtitle", "time": 12775.03, "timestamp": "03:32:55", "text": "你正在使用灵盒。我是"}, {"type": "subtitle", "time": 12778.59, "timestamp": "03:32:58", "text": "使用灵盒。"}]
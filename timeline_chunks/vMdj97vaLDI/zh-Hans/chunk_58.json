[{"type": "subtitle", "time": 3484.71, "timestamp": "00:58:04", "text": "我不喜欢加了很多东西的蛋糕"}, {"type": "subtitle", "time": 3487.349, "timestamp": "00:58:07", "text": "奶油。"}, {"type": "subtitle", "time": 3489.27, "timestamp": "00:58:09", "text": "我不喜欢。问题是我不喜欢。"}, {"type": "subtitle", "time": 3492.23, "timestamp": "00:58:12", "text": "甜食。我不喜欢吃甜食。"}, {"type": "subtitle", "time": 3493.829, "timestamp": "00:58:13", "text": "但我喜欢喝甜的饮料。我不"}, {"type": "subtitle", "time": 3497.589, "timestamp": "00:58:17", "text": "喜欢吃甜食。所以当它有"}, {"type": "subtitle", "time": 3500.309, "timestamp": "00:58:20", "text": "很多奶油，就像你知道的，生日派对一样"}, {"type": "subtitle", "time": 3503.91, "timestamp": "00:58:23", "text": "蛋糕。是的。是的。口感太顺滑了。"}, {"type": "subtitle", "time": 3505.589, "timestamp": "00:58:25", "text": "真的吗？有很多奶油。我不能"}, {"type": "subtitle", "time": 3507.43, "timestamp": "00:58:27", "text": "甚至吃它，因为我的身体会开始"}, {"type": "subtitle", "time": 3509.349, "timestamp": "00:58:29", "text": "瑟瑟发抖。就像我咬了一口。它将"}, {"type": "subtitle", "time": 3513.349, "timestamp": "00:58:33", "text": "就这么办。纳美人和禅宗"}, {"type": "subtitle", "time": 3514.789, "timestamp": "00:58:34", "text": "多次执行。就像我吃了什么东西"}, {"type": "subtitle", "time": 3516.549, "timestamp": "00:58:36", "text": "我的身体会开始像这样颤抖"}, {"type": "subtitle", "time": 3519.109, "timestamp": "00:58:39", "text": "像这样开始抽搐。这就是我喜欢它的原因"}, {"type": "subtitle", "time": 3522.43, "timestamp": "00:58:42", "text": "潘趣潘趣蛋糕。不多。"}, {"type": "subtitle", "time": 3525.109, "timestamp": "00:58:45", "text": "甜的。所以我觉得最近我开始"}, {"type": "subtitle", "time": 3527.589, "timestamp": "00:58:47", "text": "更喜欢香蕉蛋糕。核桃和"}, {"type": "subtitle", "time": 3531.109, "timestamp": "00:58:51", "text": "更多香蕉蛋糕。啊。哦。胡萝卜蛋糕是"}, {"type": "chat", "time": 3532.789, "timestamp": "00:58:52", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "Nabi asking joq to bring mithai saiko asking for cream"}, {"type": "subtitle", "time": 3533.63, "timestamp": "00:58:53", "text": "也很不错。李子"}, {"type": "subtitle", "time": 3535.789, "timestamp": "00:58:55", "text": "蛋糕"}, {"type": "chat", "time": 3537.63, "timestamp": "00:58:57", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "gud to know"}, {"type": "subtitle", "time": 3538.309, "timestamp": "00:58:58", "text": "总是很愉快。"}]
[{"type": "subtitle", "time": 12180.79, "timestamp": "03:23:00", "text": "准备去买根蜡烛。你能买一个"}, {"type": "subtitle", "time": 12183.99, "timestamp": "03:23:03", "text": "熏香棒？当然可以。"}, {"type": "subtitle", "time": 12187.229, "timestamp": "03:23:07", "text": "我买了一支蜡烛，呃，让我补充一下"}, {"type": "subtitle", "time": 12191.349, "timestamp": "03:23:11", "text": "它。什么？添加蜡烛。就像因为"}, {"type": "subtitle", "time": 12194.79, "timestamp": "03:23:14", "text": "有很多事情都让人觉得，哦，"}, {"type": "subtitle", "time": 12204.63, "timestamp": "03:23:24", "text": "就像我买了很多厚厚的东西一样。好的。添加"}, {"type": "subtitle", "time": 12210.389, "timestamp": "03:23:30", "text": "它。添加它。添加它。加上这个。已添加。"}, {"type": "subtitle", "time": 12213.83, "timestamp": "03:23:33", "text": "好的。总之，你想要什么样的地图？"}, {"type": "subtitle", "time": 12216.71, "timestamp": "03:23:36", "text": "你想再去看看远方的地图吗？我"}, {"type": "subtitle", "time": 12218.269, "timestamp": "03:23:38", "text": "我的意思是，我是"}, {"type": "subtitle", "time": 12220.63, "timestamp": "03:23:40", "text": "又一个“是”。是的。我们去一个"}, {"type": "subtitle", "time": 12222.07, "timestamp": "03:23:42", "text": "不同，不同，不同"}, {"type": "subtitle", "time": 12223.59, "timestamp": "03:23:43", "text": "农家。农家。这是什么？"}, {"type": "subtitle", "time": 12225.349, "timestamp": "03:23:45", "text": "农家？这是个新发现。我不"}, {"type": "subtitle", "time": 12228.87, "timestamp": "03:23:48", "text": "知道。这是陈腐的血腥味。我"}, {"type": "subtitle", "time": 12230.15, "timestamp": "03:23:50", "text": "不知道。我不知道这怪胎是什么"}]
[{"type": "subtitle", "time": 361.59, "timestamp": "00:06:01", "text": "我不想打断他们的谈话。"}, {"type": "subtitle", "time": 363.79, "timestamp": "00:06:03", "text": "这就像入侵一样"}, {"type": "subtitle", "time": 366.79, "timestamp": "00:06:06", "text": "某人。这就像入侵某人的领地一样。"}, {"type": "subtitle", "time": 368.029, "timestamp": "00:06:08", "text": "否则或"}, {"type": "subtitle", "time": 370.15, "timestamp": "00:06:10", "text": "某物。为什么他们感觉像……"}, {"type": "subtitle", "time": 380.71, "timestamp": "00:06:20", "text": "沟通太难了。为什么会这样？"}, {"type": "subtitle", "time": 404.51, "timestamp": "00:06:44", "text": "某物？我该怎么做？"}, {"type": "subtitle", "time": 407.23, "timestamp": "00:06:47", "text": "信息？我想"}, {"type": "subtitle", "time": 409.55, "timestamp": "00:06:49", "text": "讲话。一直以来"}, {"type": "subtitle", "time": 412.15, "timestamp": "00:06:52", "text": "尽管。等等，这里有七个人"}, {"type": "subtitle", "time": 414.07, "timestamp": "00:06:54", "text": "在线的。让我看看有没有人"}]
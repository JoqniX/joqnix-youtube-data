[{"type": "subtitle", "time": 11162.79, "timestamp": "03:06:02", "text": "书。好的。我有一本书。我我有我我"}, {"type": "subtitle", "time": 11166.07, "timestamp": "03:06:06", "text": "把书放在走廊里。所以我们可以"}, {"type": "subtitle", "time": 11168.349, "timestamp": "03:06:08", "text": "从中获利一些"}, {"type": "subtitle", "time": 11171.51, "timestamp": "03:06:11", "text": "它。所以"}, {"type": "subtitle", "time": 11177.269, "timestamp": "03:06:17", "text": "我猜这里是浴室。肮脏的"}, {"type": "subtitle", "time": 11179.349, "timestamp": "03:06:19", "text": "水。里面的水是脏水。不。"}, {"type": "subtitle", "time": 11182.87, "timestamp": "03:06:22", "text": "你听到有人尖叫了吗？"}, {"type": "subtitle", "time": 11185.19, "timestamp": "03:06:25", "text": "不。你在哪里？什么？你为什么……"}, {"type": "subtitle", "time": 11189.59, "timestamp": "03:06:29", "text": "像我这样的？我在地下室。"}, {"type": "subtitle", "time": 11191.269, "timestamp": "03:06:31", "text": "地下室。你想去地下室"}, {"type": "subtitle", "time": 11198.23, "timestamp": "03:06:38", "text": "你看到这个了吗？我当时正在触摸这个"}, {"type": "subtitle", "time": 11199.87, "timestamp": "03:06:39", "text": "现场一片尖叫声。"}, {"type": "subtitle", "time": 11203.269, "timestamp": "03:06:43", "text": "噪音。这个东西。好的。好的。你是"}, {"type": "subtitle", "time": 11206.95, "timestamp": "03:06:46", "text": "唯一一个有分析能力的人"}, {"type": "subtitle", "time": 11210.07, "timestamp": "03:06:50", "text": "设备。所以，拿出你的饭盒。"}, {"type": "subtitle", "time": 11212.469, "timestamp": "03:06:52", "text": "你现在拥有的任何东西"}]
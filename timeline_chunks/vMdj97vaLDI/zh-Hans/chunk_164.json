[{"type": "subtitle", "time": 9845.91, "timestamp": "02:44:05", "text": "上次见到他的时候，我感觉自己像个老朋友。哦，真好。"}, {"type": "subtitle", "time": 9849.55, "timestamp": "02:44:09", "text": "真好，也祝你新年快乐！"}, {"type": "subtitle", "time": 9852.99, "timestamp": "02:44:12", "text": "儿子又来了"}, {"type": "subtitle", "time": 9855.75, "timestamp": "02:44:15", "text": "哈希斯坦也祝大家新年快乐"}, {"type": "subtitle", "time": 9857.87, "timestamp": "02:44:17", "text": "希望你喜欢新的黄色"}, {"type": "subtitle", "time": 9861.59, "timestamp": "02:44:21", "text": "车。 “哦，不，”他开口说道。好的，等等。呃"}, {"type": "subtitle", "time": 9864.15, "timestamp": "02:44:24", "text": "呃。等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 9867.03, "timestamp": "02:44:27", "text": "等待。呃，所以我拿了这个东西。这"}, {"type": "subtitle", "time": 9870.469, "timestamp": "02:44:30", "text": "镜子。什么？这个镜子和"}, {"type": "subtitle", "time": 9873.11, "timestamp": "02:44:33", "text": "不，不。我有。等等，你拿走了"}, {"type": "subtitle", "time": 9875.75, "timestamp": "02:44:35", "text": "它？哦，你拿走了这个？是的。哦，"}, {"type": "subtitle", "time": 9877.429, "timestamp": "02:44:37", "text": "等待。是的，我也有电磁场辐射。我有"}, {"type": "subtitle", "time": 9879.51, "timestamp": "02:44:39", "text": "顺便提一下，这是电磁场读数器。我有"}, {"type": "subtitle", "time": 9881.75, "timestamp": "02:44:41", "text": "收音机。我有那东西。你可以使用"}, {"type": "subtitle", "time": 9884.469, "timestamp": "02:44:44", "text": "温度计。是的，拿体温计来。"}, {"type": "subtitle", "time": 9886.71, "timestamp": "02:44:46", "text": "温度计。哪个？温度计和"}, {"type": "subtitle", "time": 9889.51, "timestamp": "02:44:49", "text": "这本书。是的，就像紫外线"}, {"type": "subtitle", "time": 9892.309, "timestamp": "02:44:52", "text": "光线和书。我选紫外线"}]
[{"type": "subtitle", "time": 8702.469, "timestamp": "02:25:02", "text": "我真的很担心。不，不"}, {"type": "subtitle", "time": 8704.389, "timestamp": "02:25:04", "text": "不，不。不用担心。我们要停下来。"}, {"type": "subtitle", "time": 8706.469, "timestamp": "02:25:06", "text": "开始做这件事，你知道，在一个……"}, {"type": "subtitle", "time": 8712.99, "timestamp": "02:25:12", "text": "再次，当我看到你"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "恐同症，我能意识到你是一个"}, {"type": "subtitle", "time": 8718.11, "timestamp": "02:25:18", "text": "他比我胆子还小。"}, {"type": "subtitle", "time": 8721.99, "timestamp": "02:25:21", "text": "所以，至少我打了一场单人比赛。我"}, {"type": "subtitle", "time": 8725.429, "timestamp": "02:25:25", "text": "我没完成。我跑掉了"}, {"type": "subtitle", "time": 8728.23, "timestamp": "02:25:28", "text": "尖叫。我想，我想你看到了"}, {"type": "subtitle", "time": 8730.469, "timestamp": "02:25:30", "text": "片刻。"}, {"type": "subtitle", "time": 8732.23, "timestamp": "02:25:32", "text": "那一刻。哦，是的。我也是"}, {"type": "subtitle", "time": 8734.63, "timestamp": "02:25:34", "text": "那里也发布了一些精彩瞬间。所以，如果"}, {"type": "subtitle", "time": 8737.429, "timestamp": "02:25:37", "text": "想看就去看。哦，"}, {"type": "subtitle", "time": 8739.11, "timestamp": "02:25:39", "text": "好的。"}, {"type": "subtitle", "time": 8741.03, "timestamp": "02:25:41", "text": "是啊，我快要崩溃了。我"}, {"type": "subtitle", "time": 8743.91, "timestamp": "02:25:43", "text": "不知道。我快疯了，我不知道。我"}, {"type": "subtitle", "time": 8745.429, "timestamp": "02:25:45", "text": "不知道该怎么办。你在试穿"}, {"type": "subtitle", "time": 8748.23, "timestamp": "02:25:48", "text": "新东西。是的。是的。我需要得到"}, {"type": "subtitle", "time": 8750.55, "timestamp": "02:25:50", "text": "我自己也喜欢穿短裤之类的衣服，而且"}, {"type": "subtitle", "time": 8752.63, "timestamp": "02:25:52", "text": "我感觉很困惑。什么才算搞笑"}, {"type": "subtitle", "time": 8755.51, "timestamp": "02:25:55", "text": "美好时刻，或者说，什么是美好时刻？我不"}, {"type": "subtitle", "time": 8758.07, "timestamp": "02:25:58", "text": "知道。我不知道。呃，我以前喜欢"}]
[{"type": "subtitle", "time": 14342.15, "timestamp": "03:59:02", "text": "你是用谷歌搜索还是其他方式搜索？"}, {"type": "subtitle", "time": 14344.469, "timestamp": "03:59:04", "text": "不，它在游戏里。你想要"}, {"type": "subtitle", "time": 14348.389, "timestamp": "03:59:08", "text": "学习？我可以。等等，它在哪儿？走了。"}, {"type": "subtitle", "time": 14350.79, "timestamp": "03:59:10", "text": "哦，你不能点击查看。好的。"}, {"type": "subtitle", "time": 14352.63, "timestamp": "03:59:12", "text": "好的。好的。这就是你想要的。"}, {"type": "subtitle", "time": 14353.99, "timestamp": "03:59:13", "text": "了解这些只是为了……"}, {"type": "subtitle", "time": 14356.55, "timestamp": "03:59:16", "text": "当然。我们不会做太多事。好的。"}, {"type": "subtitle", "time": 14359.03, "timestamp": "03:59:19", "text": "所以，但我们还是来接受教育吧。"}, {"type": "subtitle", "time": 14361.269, "timestamp": "03:59:21", "text": "至少。灵魂是一种非常常见的生物。"}, {"type": "subtitle", "time": 14362.79, "timestamp": "03:59:22", "text": "鬼。它们非常强大，但是"}, {"type": "subtitle", "time": 14364.55, "timestamp": "03:59:24", "text": "被动的。只在需要时才发动攻击"}, {"type": "subtitle", "time": 14367.51, "timestamp": "03:59:27", "text": "到。他们捍卫着他们的死亡之地"}, {"type": "subtitle", "time": 14370.63, "timestamp": "03:59:30", "text": "他们的极端手段，杀死任何……"}, {"type": "subtitle", "time": 14373.67, "timestamp": "03:59:33", "text": "被抓住了或者不受欢迎。"}, {"type": "subtitle", "time": 14375.99, "timestamp": "03:59:35", "text": "目睹灵魂可能只是暂时的"}, {"type": "subtitle", "time": 14378.63, "timestamp": "03:59:38", "text": "被附近燃烧的烟熏棒阻止了"}, {"type": "subtitle", "time": 14383.349, "timestamp": "03:59:43", "text": "证据确凿，是电磁场等级5的盒子。"}, {"type": "subtitle", "time": 14388.07, "timestamp": "03:59:48", "text": "幽灵骑行。我看到了W。我们来谈谈吧。"}, {"type": "subtitle", "time": 14390.63, "timestamp": "03:59:50", "text": "幽灵。幽灵是其中最……"}, {"type": "subtitle", "time": 14393.269, "timestamp": "03:59:53", "text": "你会遇到危险的鬼魂。此外"}, {"type": "subtitle", "time": 14395.75, "timestamp": "03:59:55", "text": "唯一已知的拥有这种能力的鬼魂"}, {"type": "subtitle", "time": 14398.55, "timestamp": "03:59:58", "text": "航班，有时也被称为旅行"}]
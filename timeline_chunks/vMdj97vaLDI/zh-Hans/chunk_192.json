[{"type": "subtitle", "time": 11530.14, "timestamp": "03:12:10", "text": "在。我的天啊。"}, {"type": "subtitle", "time": 11533.11, "timestamp": "03:12:13", "text": "[音乐]"}, {"type": "subtitle", "time": 11534.309, "timestamp": "03:12:14", "text": "我冷死了。我冷死了。我是"}, {"type": "subtitle", "time": 11536.71, "timestamp": "03:12:16", "text": "冷冻。"}, {"type": "subtitle", "time": 11539.99, "timestamp": "03:12:19", "text": "不，别死。别死。好的。不。"}, {"type": "subtitle", "time": 11542.469, "timestamp": "03:12:22", "text": "去。出去。出去。三。三。糟糕。"}, {"type": "subtitle", "time": 11545.429, "timestamp": "03:12:25", "text": "糟糕。打猎。一。一。一。一。它"}, {"type": "subtitle", "time": 11547.57, "timestamp": "03:12:27", "text": "当时三岁。那是"}, {"type": "subtitle", "time": 11548.91, "timestamp": "03:12:28", "text": "[音乐]"}, {"type": "subtitle", "time": 11555.63, "timestamp": "03:12:35", "text": "真可怕。瓦卡。哦，我的"}, {"type": "subtitle", "time": 11559.11, "timestamp": "03:12:39", "text": "上帝。我选择了真实。我不知道。我"}, {"type": "subtitle", "time": 11561.99, "timestamp": "03:12:41", "text": "还选择了Reent。好的。"}, {"type": "subtitle", "time": 11564.23, "timestamp": "03:12:44", "text": "哦，新年快乐。抱歉我一直没来"}, {"type": "subtitle", "time": 11566.87, "timestamp": "03:12:46", "text": "在这里待了很久。我滋养了我的脊椎。哦"}, {"type": "subtitle", "time": 11569.63, "timestamp": "03:12:49", "text": "我的上帝。"}, {"type": "subtitle", "time": 11573.83, "timestamp": "03:12:53", "text": "错觉。我的上帝。你还好吗？"}, {"type": "subtitle", "time": 11576.71, "timestamp": "03:12:56", "text": "哦，原来是个恶魔。那是个恶魔。我"}, {"type": "subtitle", "time": 11579.11, "timestamp": "03:12:59", "text": "我以为是“哦，你听到了”。"}]
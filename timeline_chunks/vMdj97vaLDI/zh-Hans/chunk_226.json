[{"type": "subtitle", "time": 13561.11, "timestamp": "03:46:01", "text": "好的。好的。我会上去。好的。"}, {"type": "subtitle", "time": 13563.59, "timestamp": "03:46:03", "text": "我会上去，我会捡起我的"}, {"type": "subtitle", "time": 13568.87, "timestamp": "03:46:08", "text": "一本愚蠢的书，我会 EMF4。"}, {"type": "subtitle", "time": 13571.349, "timestamp": "03:46:11", "text": "EMF4。我看到了。我看到了。我看到了。我"}, {"type": "subtitle", "time": 13573.189, "timestamp": "03:46:13", "text": "看看吧。呃，我要死了。我要死了。我是"}, {"type": "subtitle", "time": 13575.11, "timestamp": "03:46:15", "text": "垂死。我要死了。看着我。看着我。"}, {"type": "subtitle", "time": 13578.55, "timestamp": "03:46:18", "text": "看着我。糟糕。我要死了。不用担心。"}, {"type": "subtitle", "time": 13582.469, "timestamp": "03:46:22", "text": "我死了。不用担心。不，不，不。"}, {"type": "subtitle", "time": 13585.11, "timestamp": "03:46:25", "text": "我分散了约伯的注意力。我分散了它的注意力。不"}, {"type": "subtitle", "time": 13595.59, "timestamp": "03:46:35", "text": "哦，我什么都点不开。啊，"}, {"type": "subtitle", "time": 13597.51, "timestamp": "03:46:37", "text": "我的错。不过她是一位女士。那是一个"}, {"type": "subtitle", "time": 13600.55, "timestamp": "03:46:40", "text": "不过，她是一位女士。女士爬来爬去"}, {"type": "subtitle", "time": 13603.99, "timestamp": "03:46:43", "text": "四。这是幻影。哦，这是一个"}, {"type": "subtitle", "time": 13606.309, "timestamp": "03:46:46", "text": "幻影。没关系。"}, {"type": "subtitle", "time": 13608.63, "timestamp": "03:46:48", "text": "四肢着地。好的。"}, {"type": "subtitle", "time": 13610.469, "timestamp": "03:46:50", "text": "哦，原来是幻影。是的。是的。是的。我"}, {"type": "subtitle", "time": 13612.79, "timestamp": "03:46:52", "text": "我以为我把幻影和……搞混了"}, {"type": "subtitle", "time": 13615.83, "timestamp": "03:46:55", "text": "就像闹鬼一样。我不知道为什么。"}, {"type": "subtitle", "time": 13617.99, "timestamp": "03:46:57", "text": "我唯一知道的幻影存在于《我的世界》中。"}]
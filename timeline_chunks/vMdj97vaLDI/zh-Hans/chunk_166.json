[{"type": "subtitle", "time": 9963.15, "timestamp": "02:46:03", "text": "某物？那是什么？你是"}, {"type": "subtitle", "time": 9965.55, "timestamp": "02:46:05", "text": "这里？你能听到吗？"}, {"type": "subtitle", "time": 9968.349, "timestamp": "02:46:08", "text": "我们？你在吗？"}, {"type": "subtitle", "time": 9972.23, "timestamp": "02:46:12", "text": "这里？你在这里吗？"}, {"type": "subtitle", "time": 9974.309, "timestamp": "02:46:14", "text": "你在哪里？"}, {"type": "subtitle", "time": 9977.75, "timestamp": "02:46:17", "text": "我的“你几岁了？”在哪里？"}, {"type": "subtitle", "time": 9979.83, "timestamp": "02:46:19", "text": "凉爽的。"}, {"type": "subtitle", "time": 9982.07, "timestamp": "02:46:22", "text": "好的。自由游戏。我正在玩游戏"}, {"type": "subtitle", "time": 9989.51, "timestamp": "02:46:29", "text": "维克去哪儿了？是的，我在这里。我是"}, {"type": "subtitle", "time": 9990.79, "timestamp": "02:46:30", "text": "这里。别担心，兄弟。不用担心，"}, {"type": "subtitle", "time": 10002.83, "timestamp": "02:46:42", "text": "你是"}, {"type": "subtitle", "time": 10006.07, "timestamp": "02:46:46", "text": "这里？你在哪里？"}, {"type": "subtitle", "time": 10009.03, "timestamp": "02:46:49", "text": "好的。你看到有什么东西在动吗？是吗？"}, {"type": "subtitle", "time": 10011.51, "timestamp": "02:46:51", "text": "是我看到的，还是你看到的？嘟嘟"}, {"type": "subtitle", "time": 10014.07, "timestamp": "02:46:54", "text": "乔克，你拿起相机了吗？是的，我"}, {"type": "subtitle", "time": 10016.309, "timestamp": "02:46:56", "text": "做过。一秒钟。让我查一下……"}, {"type": "subtitle", "time": 10018.79, "timestamp": "02:46:58", "text": "生成器是。"}]
[{"type": "subtitle", "time": 14880.309, "timestamp": "04:08:00", "text": "好的。没什么"}, {"type": "subtitle", "time": 14886.79, "timestamp": "04:08:06", "text": "有一间空着的房间。"}, {"type": "subtitle", "time": 14889.429, "timestamp": "04:08:09", "text": "好的。这个地方就像一个助力"}, {"type": "subtitle", "time": 14891.229, "timestamp": "04:08:11", "text": "像闹鬼一样"}, {"type": "subtitle", "time": 14895.67, "timestamp": "04:08:15", "text": "事情发生了。所以，等等。如果等待，如果一个房间是"}, {"type": "subtitle", "time": 14897.15, "timestamp": "04:08:17", "text": "开放，那"}, {"type": "subtitle", "time": 14899.59, "timestamp": "04:08:19", "text": "意思是：哦，等等。那是什么？我们有"}, {"type": "subtitle", "time": 14901.11, "timestamp": "04:08:21", "text": "等等，等等，等等，等等。我应该拿一个"}, {"type": "subtitle", "time": 14903.189, "timestamp": "04:08:23", "text": "这张照片，对吧？"}, {"type": "subtitle", "time": 14904.79, "timestamp": "04:08:24", "text": "对了，这是什么？空中。"}, {"type": "subtitle", "time": 14907.349, "timestamp": "04:08:27", "text": "空中。哦，是的。骨骼图片。"}, {"type": "subtitle", "time": 14910.229, "timestamp": "04:08:30", "text": "请这样做。"}, {"type": "subtitle", "time": 14912.389, "timestamp": "04:08:32", "text": "我该怎么做？你总是拍照……"}, {"type": "subtitle", "time": 14915.349, "timestamp": "04:08:35", "text": "一根骨头。我该如何装备它？"}, {"type": "subtitle", "time": 14916.67, "timestamp": "04:08:36", "text": "好的。知道了。得到"}, {"type": "subtitle", "time": 14918.87, "timestamp": "04:08:38", "text": "它。我的天啊。你拍了这张照片"}, {"type": "subtitle", "time": 14922.07, "timestamp": "04:08:42", "text": "骨头，对吧？是的。好的。那"}, {"type": "subtitle", "time": 14924.99, "timestamp": "04:08:44", "text": "幽灵骑行活动开始了。不要"}, {"type": "subtitle", "time": 14928.79, "timestamp": "04:08:48", "text": "忘记。它在楼上的卧室里。"}]
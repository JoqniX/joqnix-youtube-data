[{"type": "subtitle", "time": 15007.51, "timestamp": "04:10:07", "text": "你搜索的就像愚蠢的指纹一样。"}, {"type": "subtitle", "time": 15009.99, "timestamp": "04:10:09", "text": "我不知道。我一个也没收到。什么"}, {"type": "subtitle", "time": 15020.63, "timestamp": "04:10:20", "text": "哦，我在洗手间。"}, {"type": "subtitle", "time": 15022.389, "timestamp": "04:10:22", "text": "等等，你在哪里？你在楼上吗？"}, {"type": "subtitle", "time": 15025.429, "timestamp": "04:10:25", "text": "楼下？楼上。朝着你的方向"}, {"type": "subtitle", "time": 15027.349, "timestamp": "04:10:27", "text": "正确的。你在哪里？在哪里"}, {"type": "subtitle", "time": 15030.229, "timestamp": "04:10:30", "text": "你是？你又在厕所里吗？"}, {"type": "subtitle", "time": 15031.99, "timestamp": "04:10:31", "text": "不，我不在厕所里。我没了"}, {"type": "subtitle", "time": 15033.67, "timestamp": "04:10:33", "text": "厕所。非常感谢。是的。"}, {"type": "subtitle", "time": 15036.99, "timestamp": "04:10:36", "text": "是的。呃，从这里开始。过来。超过"}, {"type": "subtitle", "time": 15041.75, "timestamp": "04:10:41", "text": "这里。这边有厕所。"}, {"type": "subtitle", "time": 15046.15, "timestamp": "04:10:46", "text": "洗手间？在哪里？但我指的是浴室"}, {"type": "subtitle", "time": 15048.389, "timestamp": "04:10:48", "text": "实际上。"}, {"type": "subtitle", "time": 15055.91, "timestamp": "04:10:55", "text": "糟糕。"}, {"type": "subtitle", "time": 15058.87, "timestamp": "04:10:58", "text": "发生了什么？糟糕。糟糕。什么"}]
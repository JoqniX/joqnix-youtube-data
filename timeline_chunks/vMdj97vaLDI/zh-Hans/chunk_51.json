[{"type": "chat", "time": 3063.793, "timestamp": "00:51:03", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "gawd"}, {"type": "subtitle", "time": 3065.43, "timestamp": "00:51:05", "text": "没关系。"}, {"type": "subtitle", "time": 3072.79, "timestamp": "00:51:12", "text": "好的。就是这样。是的，就是这样。"}, {"type": "chat", "time": 3075.752, "timestamp": "00:51:15", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "We are worse then monkeys😭"}, {"type": "subtitle", "time": 3076.39, "timestamp": "00:51:16", "text": "哦，其实还不错。"}, {"type": "subtitle", "time": 3079.829, "timestamp": "00:51:19", "text": "让我拍张照片。你好。我拿一个"}, {"type": "subtitle", "time": 3083.67, "timestamp": "00:51:23", "text": "食物的照片。啊。"}, {"type": "subtitle", "time": 3086.47, "timestamp": "00:51:26", "text": "我应该在洗澡的时候感到难过"}, {"type": "chat", "time": 3087.639, "timestamp": "00:51:27", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "that's a great combo"}, {"type": "subtitle", "time": 3089.27, "timestamp": "00:51:29", "text": "有人去洗澡了。是的，你应该"}, {"type": "subtitle", "time": 3090.549, "timestamp": "00:51:30", "text": "一定要给你的食物拍照。"}, {"type": "subtitle", "time": 3092.15, "timestamp": "00:51:32", "text": "尤其是在户外用餐时。"}, {"type": "subtitle", "time": 3093.91, "timestamp": "00:51:33", "text": "比如在餐厅等户外场所"}, {"type": "subtitle", "time": 3095.03, "timestamp": "00:51:35", "text": "某物。它们比……更糟糕"}, {"type": "subtitle", "time": 3097.03, "timestamp": "00:51:37", "text": "猴。我的天哪，别提那件事了。"}, {"type": "subtitle", "time": 3099.43, "timestamp": "00:51:39", "text": "猴。猴子喜欢砸东西。他们是"}, {"type": "subtitle", "time": 3101.27, "timestamp": "00:51:41", "text": "好看。它们很好吃。而且他们"}, {"type": "subtitle", "time": 3103.91, "timestamp": "00:51:43", "text": "他们非常聪明。"}, {"type": "subtitle", "time": 3109.75, "timestamp": "00:51:49", "text": "所以我才告诉你一定要带上"}, {"type": "subtitle", "time": 3111.589, "timestamp": "00:51:51", "text": "想象一下每次在外面吃饭的情景。总是"}, {"type": "subtitle", "time": 3113.43, "timestamp": "00:51:53", "text": "拍张照片。你知道为什么吗？如果什么"}, {"type": "subtitle", "time": 3115.19, "timestamp": "00:51:55", "text": "如果你收到错误的订单，或者如果……"}, {"type": "subtitle", "time": 3117.03, "timestamp": "00:51:57", "text": "你本来应该得到两个鸡蛋，但是"}, {"type": "subtitle", "time": 3118.87, "timestamp": "00:51:58", "text": "你得到了一个鸡蛋，然后你后来"}]
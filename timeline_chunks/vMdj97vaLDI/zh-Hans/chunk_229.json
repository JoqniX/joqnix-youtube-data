[{"type": "subtitle", "time": 13741.15, "timestamp": "03:49:01", "text": "很遗憾，是的。"}, {"type": "subtitle", "time": 13743.83, "timestamp": "03:49:03", "text": "很遗憾。呃，我没有。"}, {"type": "subtitle", "time": 13745.99, "timestamp": "03:49:05", "text": "钱。我没钱。是的，"}, {"type": "subtitle", "time": 13748.55, "timestamp": "03:49:08", "text": "关于那件事。但你才五级。相同的"}, {"type": "subtitle", "time": 13750.389, "timestamp": "03:49:10", "text": "不过，我倒是挺喜欢的。你是如何解锁的"}, {"type": "subtitle", "time": 13753.67, "timestamp": "03:49:13", "text": "尽管？问号。"}, {"type": "subtitle", "time": 13757.349, "timestamp": "03:49:17", "text": "等等，那是什么？我不知道。我震惊了"}, {"type": "subtitle", "time": 13759.59, "timestamp": "03:49:19", "text": "如果你看到寓言麦克风。那里"}, {"type": "subtitle", "time": 13761.429, "timestamp": "03:49:21", "text": "有三件事我还没解锁。"}, {"type": "subtitle", "time": 13763.83, "timestamp": "03:49:23", "text": "顺便一提，头戴式摄像头，"}, {"type": "subtitle", "time": 13766.07, "timestamp": "03:49:26", "text": "动态音频、运动、声音"}, {"type": "subtitle", "time": 13768.229, "timestamp": "03:49:28", "text": "传感器和运动传感器。我做了"}, {"type": "subtitle", "time": 13770.229, "timestamp": "03:49:30", "text": "他们三个都喜欢“不”"}, {"type": "subtitle", "time": 13778.469, "timestamp": "03:49:38", "text": "哦，我没有解锁抛物线"}, {"type": "subtitle", "time": 13786.63, "timestamp": "03:49:46", "text": "我需要解锁它。"}, {"type": "subtitle", "time": 13791.269, "timestamp": "03:49:51", "text": "好的。准备好了就告诉我。"}, {"type": "subtitle", "time": 13793.75, "timestamp": "03:49:53", "text": "我准备好了。"}, {"type": "subtitle", "time": 13795.71, "timestamp": "03:49:55", "text": "好的。"}, {"type": "subtitle", "time": 13799.59, "timestamp": "03:49:59", "text": "几乎。祝你有美好的一天。是的，你也是。"}]
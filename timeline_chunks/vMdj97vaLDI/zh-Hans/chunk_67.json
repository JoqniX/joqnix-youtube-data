[{"type": "subtitle", "time": 4020.39, "timestamp": "01:07:00", "text": "你一边喝酒一边做这些事"}, {"type": "subtitle", "time": 4021.75, "timestamp": "01:07:01", "text": "就这样，他们会向你收费。"}, {"type": "subtitle", "time": 4025.51, "timestamp": "01:07:05", "text": "每个小时，你都有"}, {"type": "subtitle", "time": 4027.589, "timestamp": "01:07:07", "text": "费用还包括你必须点一杯饮料。"}, {"type": "subtitle", "time": 4030.47, "timestamp": "01:07:10", "text": "每隔一小时一次。哇。就像任何事"}, {"type": "subtitle", "time": 4031.99, "timestamp": "01:07:11", "text": "含酒精的，不含酒精的，这取决于……"}, {"type": "subtitle", "time": 4034.309, "timestamp": "01:07:14", "text": "你。所以你必须接受它。所以，我"}, {"type": "subtitle", "time": 4036.71, "timestamp": "01:07:16", "text": "我曾经去过那种咖啡馆。真的"}, {"type": "subtitle", "time": 4038.71, "timestamp": "01:07:18", "text": "不错，但你得像……之后那样下单。"}, {"type": "subtitle", "time": 4041.029, "timestamp": "01:07:21", "text": "每小时你都得喜欢"}, {"type": "subtitle", "time": 4043.91, "timestamp": "01:07:23", "text": "按小时支付那一小时的工资，所以是"}, {"type": "subtitle", "time": 4046.549, "timestamp": "01:07:26", "text": "就像你必须付钱一样。"}, {"type": "subtitle", "time": 4048.39, "timestamp": "01:07:28", "text": "我不知道现在情况如何，但当时"}, {"type": "subtitle", "time": 4051.99, "timestamp": "01:07:31", "text": "当时的价格好像是每人2000日元。"}, {"type": "subtitle", "time": 4053.91, "timestamp": "01:07:33", "text": "几个小时后，你还得再买一个。"}, {"type": "chat", "time": 4056.208, "timestamp": "01:07:36", "author": "@S4bOTh", "avatar": "https://yt4.ggpht.com/dwyGFV5nV4j6B4rbXTQnxbALJAtFrkvLLYXpy4kpbik67Arf3Y7OK8dSERSwTEtgKPyQeDTq-w=s64-c-k-c0x00ffffff-no-rj", "message": "Yooo"}, {"type": "subtitle", "time": 4057.19, "timestamp": "01:07:37", "text": "饮料又花了你1000块，我的天哪"}, {"type": "subtitle", "time": 4059.91, "timestamp": "01:07:39", "text": "老天，钱不是问题，我需要的"}, {"type": "subtitle", "time": 4062.23, "timestamp": "01:07:42", "text": "你可以拥有它，你有那个"}, {"type": "subtitle", "time": 4064.87, "timestamp": "01:07:44", "text": "猫咪咖啡馆真的很不错，你会喜欢的。"}, {"type": "subtitle", "time": 4066.47, "timestamp": "01:07:46", "text": "爱"}, {"type": "subtitle", "time": 4069.589, "timestamp": "01:07:49", "text": "真是太好了。我去了猫咪咖啡馆"}, {"type": "subtitle", "time": 4072.309, "timestamp": "01:07:52", "text": "呃，我去普纳动漫展的时候。前"}, {"type": "subtitle", "time": 4073.829, "timestamp": "01:07:53", "text": "去日本之前，我想我会遇到"}, {"type": "subtitle", "time": 4078.069, "timestamp": "01:07:58", "text": "其他即时通讯类YouTuber。于是，我就去了那里。"}, {"type": "subtitle", "time": 4079.39, "timestamp": "01:07:59", "text": "有一只猫"}]
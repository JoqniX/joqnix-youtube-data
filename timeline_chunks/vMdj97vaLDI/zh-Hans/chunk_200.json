[{"type": "subtitle", "time": 12002.07, "timestamp": "03:20:02", "text": "那是电视、收音机的声音。"}, {"type": "subtitle", "time": 12003.91, "timestamp": "03:20:03", "text": "有收音机电视的声音。嘘"}, {"type": "subtitle", "time": 12006.71, "timestamp": "03:20:06", "text": "声音是从上方传来的。"}, {"type": "subtitle", "time": 12008.95, "timestamp": "03:20:08", "text": "不，不。广播电视的声音是"}, {"type": "subtitle", "time": 12010.87, "timestamp": "03:20:10", "text": "我的灵盒实际上就是它的"}, {"type": "subtitle", "time": 12018.95, "timestamp": "03:20:18", "text": "这说明了一些问题。"}, {"type": "subtitle", "time": 12021.59, "timestamp": "03:20:21", "text": "如果它说了什么，那就意味着它是……"}, {"type": "subtitle", "time": 12024.71, "timestamp": "03:20:24", "text": "灵盒，你应该把它写下来。如果"}, {"type": "subtitle", "time": 12026.63, "timestamp": "03:20:26", "text": "就像要来了一样，哦，你在哪里？"}, {"type": "subtitle", "time": 12028.63, "timestamp": "03:20:28", "text": "顺便一提？我应该写出来。鬼"}, {"type": "subtitle", "time": 12030.87, "timestamp": "03:20:30", "text": "骑术。"}, {"type": "subtitle", "time": 12033.349, "timestamp": "03:20:33", "text": "代笔写作。幽灵骑行。不，不，我"}, {"type": "subtitle", "time": 12037.429, "timestamp": "03:20:37", "text": "暂时检查了一下灵盒。是的。"}, {"type": "subtitle", "time": 12039.83, "timestamp": "03:20:39", "text": "好的。好的。去那里有个那里有个"}, {"type": "subtitle", "time": 12041.67, "timestamp": "03:20:41", "text": "书。 《幽灵骑行》这本书。鬼魂"}, {"type": "subtitle", "time": 12044.15, "timestamp": "03:20:44", "text": "是真的。鬼魂就在我附近……"}, {"type": "subtitle", "time": 12051.59, "timestamp": "03:20:51", "text": "什么是电磁场？电磁场是做什么用的？哦"}, {"type": "subtitle", "time": 12053.03, "timestamp": "03:20:53", "text": "我的上帝。"}, {"type": "subtitle", "time": 12055.95, "timestamp": "03:20:55", "text": "它是为了它是为了它在滴答作响"}]
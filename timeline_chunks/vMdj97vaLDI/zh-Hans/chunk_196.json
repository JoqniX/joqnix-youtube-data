[{"type": "subtitle", "time": 11760.429, "timestamp": "03:16:00", "text": "你"}, {"type": "subtitle", "time": 11764.229, "timestamp": "03:16:04", "text": "这里？你在这里吗？名字是什么？"}, {"type": "subtitle", "time": 11766.15, "timestamp": "03:16:06", "text": "的"}, {"type": "subtitle", "time": 11769.429, "timestamp": "03:16:09", "text": "Lar Ro？没关系。不，不，不要，不要"}, {"type": "subtitle", "time": 11771.349, "timestamp": "03:16:11", "text": "说出来。我们正在死去，没有"}, {"type": "subtitle", "time": 11773.429, "timestamp": "03:16:13", "text": "哪怕只是说一句话。工作。请不要这样做"}, {"type": "subtitle", "time": 11781.59, "timestamp": "03:16:21", "text": "好的。这位英国人是谁？"}, {"type": "subtitle", "time": 11785.03, "timestamp": "03:16:25", "text": "他是英国人。我不知道。不是吗"}, {"type": "subtitle", "time": 11787.99, "timestamp": "03:16:27", "text": "这个人也是这样吗？这家伙是"}, {"type": "subtitle", "time": 11791.59, "timestamp": "03:16:31", "text": "你刚才跟那个混蛋说的。"}, {"type": "subtitle", "time": 11796.03, "timestamp": "03:16:36", "text": "等等，那是但是。好的。是的。不"}, {"type": "subtitle", "time": 11798.87, "timestamp": "03:16:38", "text": "他们不是瞬间就死了吗？请"}, {"type": "subtitle", "time": 11802.229, "timestamp": "03:16:42", "text": "别那样做。"}, {"type": "subtitle", "time": 11810.309, "timestamp": "03:16:50", "text": "好的。呃，我感觉很绝望。"}, {"type": "subtitle", "time": 11812.71, "timestamp": "03:16:52", "text": "乔，你在哪里？我感觉自己就像在……里面"}, {"type": "subtitle", "time": 11816.389, "timestamp": "03:16:56", "text": "房间。我想那是拉里妻子的房间"}]
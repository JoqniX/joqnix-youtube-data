[{"type": "subtitle", "time": 5163.91, "timestamp": "01:26:03", "text": "离开。无论如何，你的伞"}, {"type": "subtitle", "time": 5165.83, "timestamp": "01:26:05", "text": "会被偷走。这非常"}, {"type": "chat", "time": 5166.274, "timestamp": "01:26:06", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "that was my umbrella bro"}, {"type": "subtitle", "time": 5169.51, "timestamp": "01:26:09", "text": "恼人的。是的。而且我认为有些地方"}, {"type": "subtitle", "time": 5172.39, "timestamp": "01:26:12", "text": "不喜欢从……溢出的水"}, {"type": "subtitle", "time": 5174.149, "timestamp": "01:26:14", "text": "就像他们有烘干机一样的雨伞"}, {"type": "subtitle", "time": 5176.31, "timestamp": "01:26:16", "text": "在外面撑伞，然后当你放"}, {"type": "subtitle", "time": 5178.47, "timestamp": "01:26:18", "text": "放在外面会被偷的。我的朋友"}, {"type": "subtitle", "time": 5180.07, "timestamp": "01:26:20", "text": "我跟朋友说不要买好东西"}, {"type": "subtitle", "time": 5181.83, "timestamp": "01:26:21", "text": "伞，随便买把伞就行了，因为"}, {"type": "subtitle", "time": 5183.669, "timestamp": "01:26:23", "text": "那天阳光很灿烂，所以她得到了"}, {"type": "subtitle", "time": 5185.43, "timestamp": "01:26:25", "text": "伞。"}, {"type": "chat", "time": 5186.295, "timestamp": "01:26:26", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "is it really stealing a umbrella when you can just grab another umbrella?"}, {"type": "subtitle", "time": 5187.189, "timestamp": "01:26:27", "text": "她过了一会儿才拿到伞。"}, {"type": "subtitle", "time": 5189.31, "timestamp": "01:26:29", "text": "几天后它就被偷了，我"}, {"type": "subtitle", "time": 5193.669, "timestamp": "01:26:33", "text": "尤其是在下雨的时候"}, {"type": "subtitle", "time": 5197.03, "timestamp": "01:26:37", "text": "但是没有伞。"}, {"type": "subtitle", "time": 5199.55, "timestamp": "01:26:39", "text": "所以，要小心你的"}, {"type": "chat", "time": 5201.268, "timestamp": "01:26:41", "author": "@saikatdey0909", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mT2Up10wsYYwilcayEwYxOCwTgzDSnNztFejTB-x02nR8=s64-c-k-c0x00ffffff-no-rj", "message": "Grand Theft Umbrella"}, {"type": "subtitle", "time": 5204.229, "timestamp": "01:26:44", "text": "伞。真的只是"}, {"type": "subtitle", "time": 5206.149, "timestamp": "01:26:46", "text": "是的，这不算偷窃。好的。这是"}, {"type": "subtitle", "time": 5210.31, "timestamp": "01:26:50", "text": "只是一种不成文的文化。"}]
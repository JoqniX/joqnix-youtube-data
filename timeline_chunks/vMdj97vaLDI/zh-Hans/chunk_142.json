[{"type": "subtitle", "time": 8520.63, "timestamp": "02:22:00", "text": "你好。是的。深入探讨这个问题并不明智。"}, {"type": "subtitle", "time": 8524.469, "timestamp": "02:22:04", "text": "你想说什么就说什么。"}, {"type": "subtitle", "time": 8527.99, "timestamp": "02:22:07", "text": "你好。总之，是的。把那蠢东西扔掉"}, {"type": "subtitle", "time": 8531.91, "timestamp": "02:22:11", "text": "老爸式的笑话。嗯，你的计划怎么样了？"}, {"type": "subtitle", "time": 8533.99, "timestamp": "02:22:13", "text": "去？乔，你长高了不少。如何"}, {"type": "subtitle", "time": 8537.429, "timestamp": "02:22:17", "text": "很多人都觉得你长到了 B 级。"}, {"type": "subtitle", "time": 8539.19, "timestamp": "02:22:19", "text": "你们的订阅用户数量是多少？我认为"}, {"type": "subtitle", "time": 8541.59, "timestamp": "02:22:21", "text": "大约是400。"}, {"type": "subtitle", "time": 8544.469, "timestamp": "02:22:24", "text": "我也这么认为。"}, {"type": "subtitle", "time": 8546.79, "timestamp": "02:22:26", "text": "那天我特意去查了一下。是的，"}, {"type": "subtitle", "time": 8548.71, "timestamp": "02:22:28", "text": "4:35。"}, {"type": "subtitle", "time": 8551.75, "timestamp": "02:22:31", "text": "我通常不会关注这件事，但是"}, {"type": "subtitle", "time": 8553.349, "timestamp": "02:22:33", "text": "是的，"}, {"type": "subtitle", "time": 8556.389, "timestamp": "02:22:36", "text": "我也是。但我就是喜欢"}, {"type": "subtitle", "time": 8561.349, "timestamp": "02:22:41", "text": "不，我想我当时在想，我到底在干什么？"}, {"type": "subtitle", "time": 8564.469, "timestamp": "02:22:44", "text": "在你的账户里吗？我当时在找……"}, {"type": "subtitle", "time": 8567.429, "timestamp": "02:22:47", "text": "你喜欢活着，因为它不像活着。"}, {"type": "subtitle", "time": 8570.15, "timestamp": "02:22:50", "text": "我收到了你的Discord消息，但是"}, {"type": "subtitle", "time": 8572.389, "timestamp": "02:22:52", "text": "我没收到我发的YouTube消息。我"}, {"type": "subtitle", "time": 8574.63, "timestamp": "02:22:54", "text": "当时我就想，这是直播还是录像？我非常"}, {"type": "subtitle", "time": 8576.87, "timestamp": "02:22:56", "text": "使困惑。通常情况下，YouTube至少会"}, {"type": "subtitle", "time": 8579.429, "timestamp": "02:22:59", "text": "就像给我来点儿你知道的，泼一溅。"}]
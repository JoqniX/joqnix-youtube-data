[{"type": "subtitle", "time": 13260.389, "timestamp": "03:41:00", "text": "我想我们没用过它。不，不，不"}, {"type": "subtitle", "time": 13262.389, "timestamp": "03:41:02", "text": "不。只需用一个就行了。没关系。没关系。"}, {"type": "subtitle", "time": 13264.95, "timestamp": "03:41:04", "text": "好的。我买了一个。我得到了一个。额外"}, {"type": "subtitle", "time": 13268.79, "timestamp": "03:41:08", "text": "一。嘿。好的。好的。"}, {"type": "subtitle", "time": 13271.75, "timestamp": "03:41:11", "text": "我们有温度计吗？是的。我"}, {"type": "subtitle", "time": 13274.55, "timestamp": "03:41:14", "text": "看不见。哦，等等。滚动"}, {"type": "subtitle", "time": 13276.469, "timestamp": "03:41:16", "text": "向下。是的。是的。是的。是的。我可以看到"}, {"type": "subtitle", "time": 13278.79, "timestamp": "03:41:18", "text": "温度计已经装好了。好的，"}, {"type": "subtitle", "time": 13280.63, "timestamp": "03:41:20", "text": "我们走吧。"}, {"type": "subtitle", "time": 13282.469, "timestamp": "03:41:22", "text": "因为我们真的需要温度计"}, {"type": "subtitle", "time": 13284.309, "timestamp": "03:41:24", "text": "因为我搞不清楚……"}, {"type": "subtitle", "time": 13296.95, "timestamp": "03:41:36", "text": "屏幕怎么了？"}, {"type": "subtitle", "time": 13299.91, "timestamp": "03:41:39", "text": "欢迎来到噩梦，兄弟。这是"}, {"type": "subtitle", "time": 13302.15, "timestamp": "03:41:42", "text": "我的"}, {"type": "subtitle", "time": 13303.83, "timestamp": "03:41:43", "text": "阻止他们进行狩猎。"}, {"type": "subtitle", "time": 13305.349, "timestamp": "03:41:45", "text": "十字架。"}, {"type": "subtitle", "time": 13307.269, "timestamp": "03:41:47", "text": "我们心里有个疑问：如果我们目睹了鬼魂会怎么样？"}, {"type": "subtitle", "time": 13311.67, "timestamp": "03:41:51", "text": "事件。好吧，至少我可以亲眼见证。"}, {"type": "subtitle", "time": 13313.349, "timestamp": "03:41:53", "text": "见证人，而且你必须活着。"}, {"type": "subtitle", "time": 13315.75, "timestamp": "03:41:55", "text": "分钟。所以，"}]
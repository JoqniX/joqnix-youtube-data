[{"type": "subtitle", "time": 12361.349, "timestamp": "03:26:01", "text": "在地板上。不要降低电磁场强度。你"}, {"type": "subtitle", "time": 12364.229, "timestamp": "03:26:04", "text": "不想接触电磁场。是的。是的。看，"}, {"type": "subtitle", "time": 12366.389, "timestamp": "03:26:06", "text": "看。我会种下蜡烛，然后我会"}, {"type": "subtitle", "time": 12368.15, "timestamp": "03:26:08", "text": "回来后再拾取电磁场信号。所以，"}, {"type": "subtitle", "time": 12369.51, "timestamp": "03:26:09", "text": "别担心。知道了。知道了。"}, {"type": "subtitle", "time": 12373.03, "timestamp": "03:26:13", "text": "知道了。知道了。我们走吧。"}, {"type": "subtitle", "time": 12375.67, "timestamp": "03:26:15", "text": "是的。你好，杰米。新年快乐。如何"}, {"type": "subtitle", "time": 12378.389, "timestamp": "03:26:18", "text": "你是？希望你新年快乐"}, {"type": "subtitle", "time": 12380.469, "timestamp": "03:26:20", "text": "出色地。"}, {"type": "subtitle", "time": 12390.309, "timestamp": "03:26:30", "text": "这扇门不知何故开着。"}, {"type": "subtitle", "time": 12392.71, "timestamp": "03:26:32", "text": "这很可疑。"}, {"type": "subtitle", "time": 12394.71, "timestamp": "03:26:34", "text": "可疑的你会像……一样死去"}, {"type": "subtitle", "time": 12396.229, "timestamp": "03:26:36", "text": "第二个。是的，那就是我们。我不"}, {"type": "subtitle", "time": 12397.83, "timestamp": "03:26:37", "text": "知道。我要直接切入正题了。"}, {"type": "subtitle", "time": 12400.389, "timestamp": "03:26:40", "text": "不知道。我要死了。有一个"}, {"type": "subtitle", "time": 12402.71, "timestamp": "03:26:42", "text": "洗手间。哦，我们要死了。是"}, {"type": "subtitle", "time": 12404.389, "timestamp": "03:26:44", "text": "杰克，你死定了。你是做什么的？什么"}, {"type": "subtitle", "time": 12406.63, "timestamp": "03:26:46", "text": "你是说？"}, {"type": "subtitle", "time": 12410.309, "timestamp": "03:26:50", "text": "这边有盏灯。我的天啊。"}, {"type": "subtitle", "time": 12412.389, "timestamp": "03:26:52", "text": "哦，有光了。太棒了。好的，"}, {"type": "subtitle", "time": 12414.55, "timestamp": "03:26:54", "text": "我们在哪里？顺便说一句，有一件事"}, {"type": "subtitle", "time": 12418.469, "timestamp": "03:26:58", "text": "我对恐女症真的非常不擅长"}]
[{"type": "subtitle", "time": 3302.95, "timestamp": "00:55:02", "text": "弓。我的天啊。但我们没有，但我们"}, {"type": "subtitle", "time": 3305.03, "timestamp": "00:55:05", "text": "不要，我的家人，我的家人，一个也没有。"}, {"type": "subtitle", "time": 3307.19, "timestamp": "00:55:07", "text": "亲戚，或者像我祖母那样的母亲"}, {"type": "subtitle", "time": 3310.47, "timestamp": "00:55:10", "text": "他们都不吃。它就是纯粹的"}, {"type": "subtitle", "time": 3312.79, "timestamp": "00:55:12", "text": "精神病。请不要告诉他。看"}, {"type": "subtitle", "time": 3315.589, "timestamp": "00:55:15", "text": "他会喜欢约翰·尼克·塞奈你"}, {"type": "subtitle", "time": 3318.79, "timestamp": "00:55:18", "text": "你要去干嘛？等等，你"}, {"type": "subtitle", "time": 3321.829, "timestamp": "00:55:21", "text": "即将步入现实世界。是的。"}, {"type": "subtitle", "time": 3324.23, "timestamp": "00:55:24", "text": "好吧，你需要知道，你需要知道"}, {"type": "subtitle", "time": 3325.99, "timestamp": "00:55:25", "text": "所有的刻板印象，所有的坏事，"}, {"type": "subtitle", "time": 3328.069, "timestamp": "00:55:28", "text": "所有脏话。如果你等待，你就会"}, {"type": "subtitle", "time": 3332.23, "timestamp": "00:55:32", "text": "如果有人说：“哦，我的天哪，你"}, {"type": "subtitle", "time": 3334.71, "timestamp": "00:55:34", "text": "你必须生气。”好吧。你必须……"}, {"type": "subtitle", "time": 3336.87, "timestamp": "00:55:36", "text": "坏事，这样你才能保护自己"}, {"type": "chat", "time": 3343.601, "timestamp": "00:55:43", "author": "@Orange-Sleipnir", "avatar": "https://yt4.ggpht.com/ytc/AIdro_n5J-87avtPs7B_snpcnK5WQMhN-5kM_m8EJRYz2oJ72Wg=s64-c-k-c0x00ffffff-no-rj", "message": "they eat bao bao??? (pork bao buns) hehe"}, {"type": "subtitle", "time": 3343.99, "timestamp": "00:55:43", "text": "哦，是的。他们说话会含糊不清。"}, {"type": "subtitle", "time": 3347.75, "timestamp": "00:55:47", "text": "对我来说，日语是“on”，对吧？哦，你"}, {"type": "subtitle", "time": 3350.15, "timestamp": "00:55:50", "text": "理解？因为我会非常"}, {"type": "subtitle", "time": 3352.63, "timestamp": "00:55:52", "text": "荣幸。"}]
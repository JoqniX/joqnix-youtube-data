[{"type": "subtitle", "time": 11940.229, "timestamp": "03:19:00", "text": "告诉我你都做了些什么。"}, {"type": "subtitle", "time": 11949.269, "timestamp": "03:19:09", "text": "呃，就是那个人。好的。糟糕。那是……"}, {"type": "subtitle", "time": 11951.19, "timestamp": "03:19:11", "text": "灵盒？"}, {"type": "subtitle", "time": 11953.99, "timestamp": "03:19:13", "text": "灵盒。好的。拿灵盒。我"}, {"type": "subtitle", "time": 11957.269, "timestamp": "03:19:17", "text": "不知道。你听到灵盒的声音了吗？"}, {"type": "subtitle", "time": 11960.95, "timestamp": "03:19:20", "text": "我听到了，我刚才听到的只是我自己的声音。"}, {"type": "subtitle", "time": 11963.67, "timestamp": "03:19:23", "text": "我听到有人说，呃，你……"}, {"type": "subtitle", "time": 11967.63, "timestamp": "03:19:27", "text": "叫它什么？就像我看到我的手电筒一样"}, {"type": "subtitle", "time": 11971.51, "timestamp": "03:19:31", "text": "眨。我只知道这些。"}, {"type": "subtitle", "time": 11975.15, "timestamp": "03:19:35", "text": "好的。那东西显然杀死了"}, {"type": "subtitle", "time": 11978.349, "timestamp": "03:19:38", "text": "我们。呃"}, {"type": "subtitle", "time": 11981.59, "timestamp": "03:19:41", "text": "如果你看到那个鬼魂，就认不出来。"}, {"type": "subtitle", "time": 11984.63, "timestamp": "03:19:44", "text": "看看吧。"}, {"type": "subtitle", "time": 11991.55, "timestamp": "03:19:51", "text": "我听说我喜欢灌木丛"}, {"type": "subtitle", "time": 11999.83, "timestamp": "03:19:59", "text": "声音。电磁场就是其中之一。不用担心。"}]
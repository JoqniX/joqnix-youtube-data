[{"type": "subtitle", "time": 11641.59, "timestamp": "03:14:01", "text": "查克，查克。是的。是的。哇。哇。看，"}, {"type": "subtitle", "time": 11643.15, "timestamp": "03:14:03", "text": "看。做"}, {"type": "subtitle", "time": 11645.389, "timestamp": "03:14:05", "text": "不是不喜欢"}, {"type": "subtitle", "time": 11649.75, "timestamp": "03:14:09", "text": "呃，别这样对我。哇。"}, {"type": "subtitle", "time": 11651.99, "timestamp": "03:14:11", "text": "发生了什么？不要保持沉默。别这样"}, {"type": "subtitle", "time": 11654.63, "timestamp": "03:14:14", "text": "沉默的。好，我们去农田吧。"}, {"type": "subtitle", "time": 11658.15, "timestamp": "03:14:18", "text": "我们去打电话吧。我的天啊。"}, {"type": "subtitle", "time": 11660.55, "timestamp": "03:14:20", "text": "准备好。是的，但我一个也没看到。"}, {"type": "subtitle", "time": 11662.59, "timestamp": "03:14:22", "text": "顺便一提，就是这些。所以，"}, {"type": "subtitle", "time": 11665.429, "timestamp": "03:14:25", "text": "祝你好运。"}, {"type": "subtitle", "time": 11670.71, "timestamp": "03:14:30", "text": "没错，这张地图我简直要尖叫了。"}, {"type": "subtitle", "time": 11674.71, "timestamp": "03:14:34", "text": "在我上次直播《Fast Mafia》的时候。"}, {"type": "subtitle", "time": 11678.07, "timestamp": "03:14:38", "text": "可爱的。好的。总之，呃"}, {"type": "subtitle", "time": 11682.91, "timestamp": "03:14:42", "text": "好的。糟糕，我们确实有一个默认负载"}, {"type": "subtitle", "time": 11685.83, "timestamp": "03:14:45", "text": "现在。滚开！是的，"}, {"type": "subtitle", "time": 11687.99, "timestamp": "03:14:47", "text": "这是默认订单。所以，我们不"}, {"type": "subtitle", "time": 11690.03, "timestamp": "03:14:50", "text": "需要把这些东西全部重新买一遍。"}, {"type": "subtitle", "time": 11693.229, "timestamp": "03:14:53", "text": "正确的？好的。"}, {"type": "subtitle", "time": 11697.99, "timestamp": "03:14:57", "text": "好的。好的。好的。我带了一台相机"}]
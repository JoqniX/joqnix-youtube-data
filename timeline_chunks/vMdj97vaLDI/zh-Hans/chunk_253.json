[{"type": "subtitle", "time": 15182.149, "timestamp": "04:13:02", "text": "你呢？你在哪个厕所？我是"}, {"type": "subtitle", "time": 15184.79, "timestamp": "04:13:04", "text": "顺便说一下，是在楼下的厕所里。"}, {"type": "subtitle", "time": 15188.349, "timestamp": "04:13:08", "text": "好的。所以，不要和你的"}, {"type": "subtitle", "time": 15191.189, "timestamp": "04:13:11", "text": "麦克风在楼下。你是哪个厕所？"}, {"type": "subtitle", "time": 15194.95, "timestamp": "04:13:14", "text": "这里不行。你在哪个厕所？喜欢"}, {"type": "subtitle", "time": 15197.349, "timestamp": "04:13:17", "text": "一路向下。地下室。"}, {"type": "subtitle", "time": 15199.269, "timestamp": "04:13:19", "text": "不，不是地下室的厕所。我感觉就像在"}, {"type": "subtitle", "time": 15201.91, "timestamp": "04:13:21", "text": "一楼的厕所。"}, {"type": "subtitle", "time": 15209.75, "timestamp": "04:13:29", "text": "好的。请稍等片刻。好的。好的。拿"}, {"type": "subtitle", "time": 15226.349, "timestamp": "04:13:46", "text": "那是"}, {"type": "subtitle", "time": 15237.99, "timestamp": "04:13:57", "text": "尽管？你把鬼魂放在哪里了？"}]
[{"type": "subtitle", "time": 619.19, "timestamp": "00:10:19", "text": "他说话了。等等，我是不是不小心……"}, {"type": "subtitle", "time": 622.23, "timestamp": "00:10:22", "text": "把他静音之类的？不。对。用户"}, {"type": "subtitle", "time": 625.29, "timestamp": "00:10:25", "text": "语音功能已启用。好的。"}, {"type": "subtitle", "time": 633.87, "timestamp": "00:10:33", "text": "呃"}, {"type": "subtitle", "time": 641.55, "timestamp": "00:10:41", "text": "[音乐]"}, {"type": "subtitle", "time": 644.55, "timestamp": "00:10:44", "text": "天？等等，你能听到我说话吗？我很害怕。"}, {"type": "subtitle", "time": 647.069, "timestamp": "00:10:47", "text": "我很担心"}, {"type": "subtitle", "time": 654.75, "timestamp": "00:10:54", "text": "呃，我更……"}, {"type": "subtitle", "time": 658.509, "timestamp": "00:10:58", "text": "担心。你能听到吗？"}]
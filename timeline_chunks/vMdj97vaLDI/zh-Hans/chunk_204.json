[{"type": "subtitle", "time": 12241.67, "timestamp": "03:24:01", "text": "和幽灵一起进行玩家对战。我的天啊。"}, {"type": "subtitle", "time": 12243.03, "timestamp": "03:24:03", "text": "顺便说一句，我认为你可以做到"}, {"type": "subtitle", "time": 12246.349, "timestamp": "03:24:06", "text": "感叹号。顺便一提，"}, {"type": "subtitle", "time": 12248.55, "timestamp": "03:24:08", "text": "尽可能地怀念过去的美好时光"}, {"type": "subtitle", "time": 12251.349, "timestamp": "03:24:11", "text": "直接躺下再玩就行了。"}, {"type": "subtitle", "time": 12253.19, "timestamp": "03:24:13", "text": "这一定是原因所在。"}, {"type": "subtitle", "time": 12256.55, "timestamp": "03:24:16", "text": "被召至此。"}, {"type": "subtitle", "time": 12265.349, "timestamp": "03:24:25", "text": "好的，我需要一个紫外线灯，因为"}, {"type": "subtitle", "time": 12268.469, "timestamp": "03:24:28", "text": "喜欢它真是极其无望。"}, {"type": "subtitle", "time": 12271.03, "timestamp": "03:24:31", "text": "好的。关心。摄像机没用"}, {"type": "subtitle", "time": 12275.71, "timestamp": "03:24:35", "text": "为我。电磁场问题，我会采取"}, {"type": "subtitle", "time": 12277.99, "timestamp": "03:24:37", "text": "蜡烛。好的。你能捡起来吗？"}, {"type": "subtitle", "time": 12280.229, "timestamp": "03:24:40", "text": "电磁场下降？我会拿起蜡烛，"}, {"type": "subtitle", "time": 12282.229, "timestamp": "03:24:42", "text": "把它放好，然后再回来，然后我"}, {"type": "subtitle", "time": 12285.03, "timestamp": "03:24:45", "text": "我会接收电磁场。"}, {"type": "subtitle", "time": 12287.51, "timestamp": "03:24:47", "text": "你想要那本日记还是那本随笔？"}, {"type": "subtitle", "time": 12289.67, "timestamp": "03:24:49", "text": "书？"}, {"type": "subtitle", "time": 12291.51, "timestamp": "03:24:51", "text": "你，你有日记本，所以我们"}, {"type": "subtitle", "time": 12298.87, "timestamp": "03:24:58", "text": "去。"}]
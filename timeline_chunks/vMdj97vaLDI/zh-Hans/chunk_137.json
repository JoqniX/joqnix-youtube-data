[{"type": "subtitle", "time": 8221.83, "timestamp": "02:17:01", "text": "东西。我仍在努力联系并抱有希望"}, {"type": "subtitle", "time": 8225.11, "timestamp": "02:17:05", "text": "在我走之前他们会及时看到的，所以"}, {"type": "subtitle", "time": 8228.19, "timestamp": "02:17:08", "text": "我可以和你谈谈，"}, {"type": "subtitle", "time": 8229.22, "timestamp": "02:17:09", "text": "东西。"}, {"type": "subtitle", "time": 8231.07, "timestamp": "02:17:11", "text": "[音乐]"}, {"type": "subtitle", "time": 8233.509, "timestamp": "02:17:13", "text": "是的，我想和某些人谈谈。"}, {"type": "subtitle", "time": 8237.709, "timestamp": "02:17:17", "text": "某人，伙计。嗯，某个曾经是我的人"}, {"type": "subtitle", "time": 8242.95, "timestamp": "02:17:22", "text": "Twitch 的首位创始人，一位……"}, {"type": "subtitle", "time": 8245.589, "timestamp": "02:17:25", "text": "我刚开始接触博彩和订阅的时候，就接触到了这些。"}, {"type": "subtitle", "time": 8248.709, "timestamp": "02:17:28", "text": "是附属机构，对吧？是的。是的。我不"}, {"type": "subtitle", "time": 8250.87, "timestamp": "02:17:30", "text": "知道如何核实，比如谁是……"}, {"type": "subtitle", "time": 8252.429, "timestamp": "02:17:32", "text": "我的创始人"}, {"type": "subtitle", "time": 8254.95, "timestamp": "02:17:34", "text": "渠道。有没有人直播？"}, {"type": "subtitle", "time": 8257.99, "timestamp": "02:17:37", "text": "Twitch知道这一点吗？我得谷歌一下这个"}, {"type": "subtitle", "time": 8259.99, "timestamp": "02:17:39", "text": "或者别的什么。给我一分钟时间。我"}, {"type": "subtitle", "time": 8263.549, "timestamp": "02:17:43", "text": "会找到我的"}, {"type": "subtitle", "time": 8266.389, "timestamp": "02:17:46", "text": "耳塞。我可以把它放进耳朵里，"}, {"type": "subtitle", "time": 8268.629, "timestamp": "02:17:48", "text": "戴上耳机。耳机显示"}]
[{"type": "subtitle", "time": 11820.309, "timestamp": "03:17:00", "text": "或者别的什么。哦，我同意你的看法。是的。"}, {"type": "subtitle", "time": 11823.03, "timestamp": "03:17:03", "text": "是的。我们需要种植"}, {"type": "subtitle", "time": 11825.11, "timestamp": "03:17:05", "text": "卧室里有一台摄像头。是的。是的。"}, {"type": "subtitle", "time": 11827.75, "timestamp": "03:17:07", "text": "是的。这个房间是开放的"}, {"type": "subtitle", "time": 11833.11, "timestamp": "03:17:13", "text": "过来。好的。我要去，我要去"}, {"type": "subtitle", "time": 11839.67, "timestamp": "03:17:19", "text": "把我的相机放在这里，这样我们就可以……"}, {"type": "subtitle", "time": 11841.99, "timestamp": "03:17:21", "text": "这里。我们会把它放在这里。所以"}, {"type": "subtitle", "time": 11846.389, "timestamp": "03:17:26", "text": "哦，乔，你能点个手电筒吗？"}, {"type": "subtitle", "time": 11851.03, "timestamp": "03:17:31", "text": "乔，帮帮我。我在“糟糕”号上。糟糕。"}, {"type": "subtitle", "time": 11853.269, "timestamp": "03:17:33", "text": "发生了什么？发生了什么？我的"}, {"type": "subtitle", "time": 11855.59, "timestamp": "03:17:35", "text": "摄像机安装到位了吗？"}, {"type": "subtitle", "time": 11859.11, "timestamp": "03:17:39", "text": "哦，它在地板下面。"}, {"type": "subtitle", "time": 11865.269, "timestamp": "03:17:45", "text": "这并不可疑。"}, {"type": "subtitle", "time": 11871.03, "timestamp": "03:17:51", "text": "完全没有。好的。把这个东西放在这里。"}, {"type": "subtitle", "time": 11879.269, "timestamp": "03:17:59", "text": "全部。好的，明白了。呃"}]
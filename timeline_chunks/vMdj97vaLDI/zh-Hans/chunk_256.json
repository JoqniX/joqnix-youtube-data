[{"type": "subtitle", "time": 15363.229, "timestamp": "04:16:03", "text": "真他妈的。或许，或许是鬼魂"}, {"type": "subtitle", "time": 15367.349, "timestamp": "04:16:07", "text": "球体。不，那样会危险得多。吴。"}, {"type": "subtitle", "time": 15375.11, "timestamp": "04:16:15", "text": "我选米兰。"}, {"type": "subtitle", "time": 15376.83, "timestamp": "04:16:16", "text": "好，我们开始吧"}, {"type": "subtitle", "time": 15380.63, "timestamp": "04:16:20", "text": "W：我们走吧。我的天哪。"}, {"type": "subtitle", "time": 15389.189, "timestamp": "04:16:29", "text": "我没有。对不起，杰克。查理，我是"}, {"type": "subtitle", "time": 15391.91, "timestamp": "04:16:31", "text": "把你抛在身后。哦，是的。没关系。"}, {"type": "subtitle", "time": 15393.99, "timestamp": "04:16:33", "text": "我其实就在你体内看着你。"}, {"type": "subtitle", "time": 15404.309, "timestamp": "04:16:44", "text": "[音乐]"}, {"type": "subtitle", "time": 15406.469, "timestamp": "04:16:46", "text": "夏克现在就在你体内。我们走吧。哦，它"}, {"type": "subtitle", "time": 15408.95, "timestamp": "04:16:48", "text": "模仿。好吧，我确实拿走了骨头"}, {"type": "subtitle", "time": 15412.55, "timestamp": "04:16:52", "text": "证据。哦，不错。至少我们得到了"}]
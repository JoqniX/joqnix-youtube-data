[{"type": "subtitle", "time": 5461.59, "timestamp": "01:31:01", "text": "可以买到鞋子、游戏机、游戏周边产品"}, {"type": "subtitle", "time": 5464.31, "timestamp": "01:31:04", "text": "任何事物。曼达拉克。是的，曼达拉克是"}, {"type": "subtitle", "time": 5466.87, "timestamp": "01:31:06", "text": "适合可动人偶之类的。"}, {"type": "chat", "time": 5468.699, "timestamp": "01:31:08", "author": "@notpravinlol", "avatar": "https://yt4.ggpht.com/t9UXLD6AmzS1-YItB_6_Kz4uAutM3H0oNxaU47_WUxq4oWNpbcDQvZiftO3UE0nS_-jgazDe=s64-c-k-c0x00ffffff-no-rj", "message": "shoes?"}, {"type": "subtitle", "time": 5468.95, "timestamp": "01:31:08", "text": "流行文化，如果你想喜欢的话"}, {"type": "chat", "time": 5470.384, "timestamp": "01:31:10", "author": "@gaurdiangaming4603", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mFiZLBZWkzinaMdP6tEYkP1j69A0G3jL01PKtnzXI=s64-c-k-c0x00ffffff-no-rj", "message": "eat the Sakura tree to absorb its power! XD"}, {"type": "subtitle", "time": 5471.51, "timestamp": "01:31:11", "text": "戏服、假发，都很便宜。我有一个"}, {"type": "subtitle", "time": 5474.39, "timestamp": "01:31:14", "text": "我曾经……嗯……我有很多假发"}, {"type": "subtitle", "time": 5479.189, "timestamp": "01:31:19", "text": "如果你想要收藏品，那当然是曼达拉克。"}, {"type": "subtitle", "time": 5481.189, "timestamp": "01:31:21", "text": "真的很好。我认为是长古屋的"}, {"type": "subtitle", "time": 5483.87, "timestamp": "01:31:23", "text": "与……相比，Mandarak 真的很好。"}, {"type": "subtitle", "time": 5486.43, "timestamp": "01:31:26", "text": "长古屋"}, {"type": "subtitle", "time": 5490.55, "timestamp": "01:31:30", "text": "并飞往东京。我觉得东京不错，但是"}, {"type": "subtitle", "time": 5499.51, "timestamp": "01:31:39", "text": "曼达尔鞋。鞋。对，鞋子。和"}, {"type": "subtitle", "time": 5501.51, "timestamp": "01:31:41", "text": "虽然你可能会想，"}, {"type": "subtitle", "time": 5503.51, "timestamp": "01:31:43", "text": "哦，如果它很便宜，那可能就像……"}, {"type": "subtitle", "time": 5505.83, "timestamp": "01:31:45", "text": "质量很好，而且真的很好"}, {"type": "subtitle", "time": 5508.31, "timestamp": "01:31:48", "text": "质量。它会非常耐用。"}, {"type": "subtitle", "time": 5511.55, "timestamp": "01:31:51", "text": "时间。真的很不错。我得到了一个"}, {"type": "subtitle", "time": 5513.75, "timestamp": "01:31:53", "text": "鞋。很遗憾，我没有检查……"}, {"type": "subtitle", "time": 5515.35, "timestamp": "01:31:55", "text": "尺寸，但它比我大得多，但是"}, {"type": "subtitle", "time": 5516.95, "timestamp": "01:31:56", "text": "那确实很好。我花了大概时间买的"}, {"type": "subtitle", "time": 5518.79, "timestamp": "01:31:58", "text": "1000日元，这其实相当"}]
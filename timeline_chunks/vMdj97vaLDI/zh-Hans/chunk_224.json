[{"type": "subtitle", "time": 13441.11, "timestamp": "03:44:01", "text": "所有东西都是蓝色的吗？"}, {"type": "subtitle", "time": 13452.63, "timestamp": "03:44:12", "text": "好的。"}, {"type": "subtitle", "time": 13456.07, "timestamp": "03:44:16", "text": "哦，厕所。我们有带紫外线的厕所吗？"}, {"type": "subtitle", "time": 13459.83, "timestamp": "03:44:19", "text": "射线？不。好的。我们有紫外线杀菌柜吗？"}, {"type": "subtitle", "time": 13461.79, "timestamp": "03:44:21", "text": "射线？不。"}, {"type": "subtitle", "time": 13464.71, "timestamp": "03:44:24", "text": "好的。这些衣服仿佛在注视着我们。"}, {"type": "subtitle", "time": 13466.15, "timestamp": "03:44:26", "text": "是在二楼。这是第二个"}, {"type": "subtitle", "time": 13468.95, "timestamp": "03:44:28", "text": "我确定是在地板上。是的。是的。让我们……"}, {"type": "subtitle", "time": 13470.389, "timestamp": "03:44:30", "text": "上到二楼，然后死在……"}, {"type": "subtitle", "time": 13473.51, "timestamp": "03:44:33", "text": "立即的。别担心。我们死了"}, {"type": "subtitle", "time": 13475.269, "timestamp": "03:44:35", "text": "这里曾出现过10万亿次。 WHO"}, {"type": "subtitle", "time": 13477.349, "timestamp": "03:44:37", "text": "关心吗？"}, {"type": "subtitle", "time": 13479.349, "timestamp": "03:44:39", "text": "好的。好的。好的。那么，你如何前往"}, {"type": "subtitle", "time": 13483.67, "timestamp": "03:44:43", "text": "现在上楼了吗？呃，直接走。"}, {"type": "subtitle", "time": 13486.309, "timestamp": "03:44:46", "text": "直的。笔直笔直。"}, {"type": "subtitle", "time": 13489.59, "timestamp": "03:44:49", "text": "不，就像“哦，是啊”。哦，是的。"}, {"type": "subtitle", "time": 13492.15, "timestamp": "03:44:52", "text": "那好吧。我把这件事全忘了。"}, {"type": "subtitle", "time": 13496.189, "timestamp": "03:44:56", "text": "是的。嘿，这个"}, {"type": "subtitle", "time": 13499.03, "timestamp": "03:44:59", "text": "刚进门，哦，原来是这样。"}]
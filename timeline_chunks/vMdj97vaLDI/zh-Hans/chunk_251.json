[{"type": "subtitle", "time": 15060.71, "timestamp": "04:11:00", "text": "发生了吗？发生了什么？我要死了。我"}, {"type": "subtitle", "time": 15064.469, "timestamp": "04:11:04", "text": "可能快要死了。你在哪里？"}, {"type": "subtitle", "time": 15067.269, "timestamp": "04:11:07", "text": "我在楼下，听到“哎呀”一声。我是"}, {"type": "subtitle", "time": 15069.67, "timestamp": "04:11:09", "text": "死的。我死了。我死了。我死了。我是"}, {"type": "subtitle", "time": 15071.59, "timestamp": "04:11:11", "text": "死的。我可能会死。我吓坏了。我"}, {"type": "subtitle", "time": 15073.349, "timestamp": "04:11:13", "text": "吓坏了。对不起。我无法接受"}, {"type": "subtitle", "time": 15075.03, "timestamp": "04:11:15", "text": "图片。我吓坏了。我吓坏了"}, {"type": "subtitle", "time": 15077.51, "timestamp": "04:11:17", "text": "出去。我们都敲了它。我吓坏了。我是"}, {"type": "subtitle", "time": 15079.67, "timestamp": "04:11:19", "text": "对不起。"}, {"type": "subtitle", "time": 15082.229, "timestamp": "04:11:22", "text": "好的。我蹲着。我蹲着。我是"}, {"type": "subtitle", "time": 15084.71, "timestamp": "04:11:24", "text": "蹲伏。我蹲着。我蹲着。"}, {"type": "subtitle", "time": 15087.03, "timestamp": "04:11:27", "text": "哦。哦，拜托，老兄。兄弟，等等。做过"}, {"type": "subtitle", "time": 15089.83, "timestamp": "04:11:29", "text": "你死了吗？兄弟，你死了吗？快点。你"}, {"type": "subtitle", "time": 15092.87, "timestamp": "04:11:32", "text": "你不能这样对我。你死了吗？"}, {"type": "subtitle", "time": 15095.67, "timestamp": "04:11:35", "text": "我心想：老兄，我在洗手间呢。"}, {"type": "subtitle", "time": 15099.91, "timestamp": "04:11:39", "text": "我觉得你做不了什么。"}, {"type": "subtitle", "time": 15102.59, "timestamp": "04:11:42", "text": "我没有使用电磁场。"}, {"type": "subtitle", "time": 15105.75, "timestamp": "04:11:45", "text": "男人。等等，原来根本没有电磁场。"}, {"type": "subtitle", "time": 15108.55, "timestamp": "04:11:48", "text": "不过，我相信。等等，等等。我是否使用过"}, {"type": "subtitle", "time": 15113.269, "timestamp": "04:11:53", "text": "VF？等等，我有点糊涂了。是的，你负责。"}, {"type": "subtitle", "time": 15117.03, "timestamp": "04:11:57", "text": "我当时在里面，我死了，呃，我，我死了"}, {"type": "subtitle", "time": 15119.03, "timestamp": "04:11:59", "text": "这"}]
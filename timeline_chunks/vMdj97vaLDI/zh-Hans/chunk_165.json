[{"type": "subtitle", "time": 9900.389, "timestamp": "02:45:00", "text": "好了，我们走吧。"}, {"type": "subtitle", "time": 9903.03, "timestamp": "02:45:03", "text": "哦，我们需要一个“哦，上帝”。呃，你有……"}, {"type": "subtitle", "time": 9905.51, "timestamp": "02:45:05", "text": "手电筒跳跃？我有一个紫外线灯"}, {"type": "subtitle", "time": 9907.59, "timestamp": "02:45:07", "text": "尽管。"}, {"type": "subtitle", "time": 9909.59, "timestamp": "02:45:09", "text": "等等，这些东西都是你买的。如何"}, {"type": "subtitle", "time": 9913.75, "timestamp": "02:45:13", "text": "另外，你有多富有？不，不。我"}, {"type": "subtitle", "time": 9916.389, "timestamp": "02:45:16", "text": "我当时只有132美元。这就是全部内容了。"}, {"type": "subtitle", "time": 9918.07, "timestamp": "02:45:18", "text": "有。我的天啊。你为什么把所有东西都买下来了？"}, {"type": "subtitle", "time": 9925.91, "timestamp": "02:45:25", "text": "哦，我好多疑。"}, {"type": "subtitle", "time": 9928.95, "timestamp": "02:45:28", "text": "哦，你拿走钥匙了吗？是的，我做了。"}, {"type": "subtitle", "time": 9933.51, "timestamp": "02:45:33", "text": "实际上。哦，真可怕。"}, {"type": "subtitle", "time": 9936.15, "timestamp": "02:45:36", "text": "我的天哪。幽灵般的。哦，对了，它是"}, {"type": "subtitle", "time": 9939.269, "timestamp": "02:45:39", "text": "专业的。所以，呃，没有宽容可言。"}, {"type": "subtitle", "time": 9942.71, "timestamp": "02:45:42", "text": "时间。那么，宽限时间到了吗？什么是恩典？"}, {"type": "subtitle", "time": 9945.03, "timestamp": "02:45:45", "text": "钻石？是的，优雅钻石意味着它是一颗……"}, {"type": "subtitle", "time": 9948.11, "timestamp": "02:45:48", "text": "哦，安全时间到了。"}, {"type": "subtitle", "time": 9959.51, "timestamp": "02:45:59", "text": "出去。你听到了吗？你听说了吗？"}]
[{"type": "subtitle", "time": 11884.389, "timestamp": "03:18:04", "text": "我不知道。我感觉自己像个瞎子。"}, {"type": "subtitle", "time": 11886.309, "timestamp": "03:18:06", "text": "所以，您能帮帮我吗？"}, {"type": "subtitle", "time": 11888.71, "timestamp": "03:18:08", "text": "等等，还要调高屏幕亮度。"}, {"type": "subtitle", "time": 11890.95, "timestamp": "03:18:10", "text": "视频设置。那会很有帮助。"}, {"type": "subtitle", "time": 11893.429, "timestamp": "03:18:13", "text": "查看。"}, {"type": "subtitle", "time": 11904.71, "timestamp": "03:18:24", "text": "啊，我不想让你变得盲目。"}, {"type": "subtitle", "time": 11907.19, "timestamp": "03:18:27", "text": "我内心深处一直都有这种感觉。我感觉很害怕，"}, {"type": "subtitle", "time": 11910.87, "timestamp": "03:18:30", "text": "我瑟瑟发抖，好吧，你是我的。"}, {"type": "subtitle", "time": 11913.269, "timestamp": "03:18:33", "text": "我生命中的光。请帮忙。光"}, {"type": "subtitle", "time": 11915.79, "timestamp": "03:18:35", "text": "我生命中的一部分。是的。"}, {"type": "subtitle", "time": 11921.19, "timestamp": "03:18:41", "text": "爸爸，妈妈回家了。是的，我"}, {"type": "subtitle", "time": 11928.469, "timestamp": "03:18:48", "text": "蚊子鬼？"}, {"type": "subtitle", "time": 11931.11, "timestamp": "03:18:51", "text": "他们在外面，对吧？鬼。鬼。"}, {"type": "subtitle", "time": 11932.67, "timestamp": "03:18:52", "text": "鬼。鬼。鬼。鬼。鬼。"}, {"type": "subtitle", "time": 11935.429, "timestamp": "03:18:55", "text": "鬼。我来。"}, {"type": "subtitle", "time": 11938.79, "timestamp": "03:18:58", "text": "哦，你死了。什么？我死了。告诉我。"}]
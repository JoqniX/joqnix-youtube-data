[{"type": "subtitle", "time": 10443.19, "timestamp": "02:54:03", "text": "全栈开发之类的？"}, {"type": "subtitle", "time": 10445.75, "timestamp": "02:54:05", "text": "这是全栈式技术。 W 满了。是"}, {"type": "subtitle", "time": 10449.51, "timestamp": "02:54:09", "text": "你确定自己是专业人士吗？"}, {"type": "subtitle", "time": 10451.99, "timestamp": "02:54:11", "text": "让我们来做全栈开发。我身上什么都没有"}, {"type": "subtitle", "time": 10453.59, "timestamp": "02:54:13", "text": "顺便一提。所以我也不知道。什么是"}, {"type": "subtitle", "time": 10455.75, "timestamp": "02:54:15", "text": "你担心什么？"}, {"type": "subtitle", "time": 10458.309, "timestamp": "02:54:18", "text": "我全都丢了。好的，我至少需要"}, {"type": "subtitle", "time": 10462.15, "timestamp": "02:54:22", "text": "我需要……我需要一个手电筒。我的天哪。我"}, {"type": "subtitle", "time": 10464.71, "timestamp": "02:54:24", "text": "需要手电筒。他妈的。"}, {"type": "subtitle", "time": 10466.309, "timestamp": "02:54:26", "text": "你能买一个吗？"}, {"type": "subtitle", "time": 10467.91, "timestamp": "02:54:27", "text": "温度计？"}, {"type": "subtitle", "time": 10470.389, "timestamp": "02:54:30", "text": "我们需要智能棒。"}, {"type": "subtitle", "time": 10473.91, "timestamp": "02:54:33", "text": "呃，好的。我们需要好的，最重要的事"}, {"type": "subtitle", "time": 10478.309, "timestamp": "02:54:38", "text": "是一台相机，也是一台电磁场探测器。呃，一个"}, {"type": "subtitle", "time": 10482.75, "timestamp": "02:54:42", "text": "灵盒。我有一个 我有一个 我有一个"}, {"type": "subtitle", "time": 10492.95, "timestamp": "02:54:52", "text": "吐痰盒。"}, {"type": "subtitle", "time": 10499.19, "timestamp": "02:54:59", "text": "等等，那些东西是什么？那些东西是什么？呃……"}]
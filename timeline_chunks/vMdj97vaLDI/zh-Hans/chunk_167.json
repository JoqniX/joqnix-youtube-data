[{"type": "subtitle", "time": 10020.63, "timestamp": "02:47:00", "text": "发电机位于地下室，就在……"}, {"type": "subtitle", "time": 10023.67, "timestamp": "02:47:03", "text": "方式。发电机位于"}, {"type": "subtitle", "time": 10025.99, "timestamp": "02:47:05", "text": "顺便说一句，是地下室。所以，去你的"}, {"type": "subtitle", "time": 10028.55, "timestamp": "02:47:08", "text": "是的。是的。往那边走。正确的。正确的。"}, {"type": "subtitle", "time": 10032.07, "timestamp": "02:47:12", "text": "正确的。对，对，对。不，不。呃，"}, {"type": "subtitle", "time": 10034.95, "timestamp": "02:47:14", "text": "那就是不，不，不。那不是……"}, {"type": "subtitle", "time": 10037.67, "timestamp": "02:47:17", "text": "地图。那又是另一栋房子。是的。"}, {"type": "subtitle", "time": 10039.75, "timestamp": "02:47:19", "text": "是的。是的。好的。好的。回去。去"}, {"type": "subtitle", "time": 10041.59, "timestamp": "02:47:21", "text": "后退。回去。去。回去。是，是"}, {"type": "subtitle", "time": 10043.51, "timestamp": "02:47:23", "text": "这里。它在这里。他妈的。它在这里。它是"}, {"type": "subtitle", "time": 10065.51, "timestamp": "02:47:45", "text": "知道。真是个可怕的地方。"}, {"type": "subtitle", "time": 10068.349, "timestamp": "02:47:48", "text": "如何开门？对不起。"}, {"type": "subtitle", "time": 10071.03, "timestamp": "02:47:51", "text": "我忘了怎么开门了。我是"}, {"type": "subtitle", "time": 10072.79, "timestamp": "02:47:52", "text": "对不起。"}, {"type": "subtitle", "time": 10074.83, "timestamp": "02:47:54", "text": "你是个洞吗？"}]
[{"type": "subtitle", "time": 8042.109, "timestamp": "02:14:02", "text": "W：所以，是的，很多"}, {"type": "subtitle", "time": 8045.109, "timestamp": "02:14:05", "text": "事物。当我和Psycho交谈时"}, {"type": "subtitle", "time": 8046.51, "timestamp": "02:14:06", "text": "萨娜，我"}, {"type": "subtitle", "time": 8049.55, "timestamp": "02:14:09", "text": "不小心蹲下了之类的"}, {"type": "subtitle", "time": 8053.03, "timestamp": "02:14:13", "text": "我看到了一些东西，我当时"}, {"type": "subtitle", "time": 8056.79, "timestamp": "02:14:16", "text": "就像弯腰一样，我失去了我的"}, {"type": "subtitle", "time": 8060.149, "timestamp": "02:14:20", "text": "耳机，但我得找到它。所以请"}, {"type": "subtitle", "time": 8062.629, "timestamp": "02:14:22", "text": "让我高兴一会儿。你做过恐怖片吗？"}, {"type": "subtitle", "time": 8065.27, "timestamp": "02:14:25", "text": "游戏？我玩恐怖游戏都玩不下去。但"}, {"type": "subtitle", "time": 8067.43, "timestamp": "02:14:27", "text": "我们将进行一款恐怖游戏的合作开发。"}, {"type": "subtitle", "time": 8071.27, "timestamp": "02:14:31", "text": "我最近发现了一位新的 YouTuber。"}, {"type": "subtitle", "time": 8072.95, "timestamp": "02:14:32", "text": "最近联系过。他们是"}, {"type": "subtitle", "time": 8075.99, "timestamp": "02:14:35", "text": "他们是一位印度YouTube博主，"}, {"type": "subtitle", "time": 8078.95, "timestamp": "02:14:38", "text": "实际上正在Twitch上直播。我将"}, {"type": "subtitle", "time": 8084.47, "timestamp": "02:14:44", "text": "呃，和他们合作呃，六月"}, {"type": "subtitle", "time": 8087.27, "timestamp": "02:14:47", "text": "大概下周吧。是的，下周"}, {"type": "subtitle", "time": 8090.629, "timestamp": "02:14:50", "text": "将会为此进行合作。呃，我们"}, {"type": "subtitle", "time": 8093.03, "timestamp": "02:14:53", "text": "我们得先开一次风险投资会议，因为"}, {"type": "subtitle", "time": 8095.109, "timestamp": "02:14:55", "text": "这是我们的第一次见面，对吗？我"}, {"type": "subtitle", "time": 8097.589, "timestamp": "02:14:57", "text": "这件事必须专业一些。看"}, {"type": "subtitle", "time": 8099.83, "timestamp": "02:14:59", "text": "氛围和一切都很好。希望你"}]
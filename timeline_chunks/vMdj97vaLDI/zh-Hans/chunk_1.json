[{"type": "subtitle", "time": 61.99, "timestamp": "00:01:01", "text": "77. 今晚我们有一位特别嘉宾，"}, {"type": "subtitle", "time": 63.789, "timestamp": "00:01:03", "text": "是来自 Psychonishan"}, {"type": "subtitle", "time": 66.59, "timestamp": "00:01:06", "text": "芽景。我们将进行合作"}, {"type": "subtitle", "time": 69.99, "timestamp": "00:01:09", "text": "40分钟内，或者30分钟内"}, {"type": "subtitle", "time": 74.23, "timestamp": "00:01:14", "text": "现在。好的。但是，呃，在我们开始之前"}, {"type": "subtitle", "time": 76.789, "timestamp": "00:01:16", "text": "关于合作这件事，我会……"}, {"type": "subtitle", "time": 80.63, "timestamp": "00:01:20", "text": "速通游戏，然后吃晚饭"}, {"type": "subtitle", "time": 83.03, "timestamp": "00:01:23", "text": "回来了。好的。所以，给我几个"}, {"type": "subtitle", "time": 85.51, "timestamp": "00:01:25", "text": "一会儿我就去速通，然后吃吃喝喝"}, {"type": "subtitle", "time": 88.23, "timestamp": "00:01:28", "text": "然后回来。好的。你好。那就让我走吧"}, {"type": "subtitle", "time": 91.03, "timestamp": "00:01:31", "text": "我吃完晚饭就回来。到那时，"}, {"type": "subtitle", "time": 94.55, "timestamp": "00:01:34", "text": "请尽情欣赏这场滑稽剧。你好。请尽情享受"}]
[{"type": "subtitle", "time": 3604.23, "timestamp": "01:00:04", "text": "是啊，糟透了。"}, {"type": "subtitle", "time": 3610.03, "timestamp": "01:00:10", "text": "胡萝卜。"}, {"type": "subtitle", "time": 3612.789, "timestamp": "01:00:12", "text": "好的，我上网查一下。我从未见过"}, {"type": "subtitle", "time": 3614.19, "timestamp": "01:00:14", "text": "胡萝卜。"}, {"type": "subtitle", "time": 3618.15, "timestamp": "01:00:18", "text": "好的。而且，而且，还有我"}, {"type": "subtitle", "time": 3619.43, "timestamp": "01:00:19", "text": "不知道你是否能感同身受"}, {"type": "subtitle", "time": 3622.789, "timestamp": "01:00:22", "text": "有一种菲律宾菜，你"}, {"type": "subtitle", "time": 3625.51, "timestamp": "01:00:25", "text": "放巧克力"}, {"type": "subtitle", "time": 3628.95, "timestamp": "01:00:28", "text": "淡奶、米饭，然后搅拌均匀。"}, {"type": "subtitle", "time": 3633.91, "timestamp": "01:00:33", "text": "把它们放在一起，和干鱼一起吃。"}, {"type": "subtitle", "time": 3639.99, "timestamp": "01:00:39", "text": "什么？是的。哦。哦。在蛋糕里。干鱼。"}, {"type": "subtitle", "time": 3641.27, "timestamp": "01:00:41", "text": "那不是蛋糕。那不是蛋糕。"}, {"type": "subtitle", "time": 3644.549, "timestamp": "01:00:44", "text": "更像是，你知道，你把你"}, {"type": "subtitle", "time": 3648.589, "timestamp": "01:00:48", "text": "你放你放你放"}, {"type": "subtitle", "time": 3652.95, "timestamp": "01:00:52", "text": "米饭。好的。你放入了淡奶。"}, {"type": "subtitle", "time": 3656.99, "timestamp": "01:00:56", "text": "你放了巧克力"}, {"type": "subtitle", "time": 3659.51, "timestamp": "01:00:59", "text": "粉末。你们一起烹饪它们，就像……"}]
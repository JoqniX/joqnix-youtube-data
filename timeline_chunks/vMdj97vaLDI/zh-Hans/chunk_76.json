[{"type": "subtitle", "time": 4562.63, "timestamp": "01:16:02", "text": "别跟着他们，是啊，就像……"}, {"type": "subtitle", "time": 4566.39, "timestamp": "01:16:06", "text": "金发女郎，呃，我忘了她叫什么名字了。"}, {"type": "subtitle", "time": 4568.87, "timestamp": "01:16:08", "text": "是的，她曾是一名高中老师。"}, {"type": "subtitle", "time": 4571.47, "timestamp": "01:16:11", "text": "我知道我知道我知道我知道呃"}, {"type": "subtitle", "time": 4574.07, "timestamp": "01:16:14", "text": "便当之类的"}, {"type": "subtitle", "time": 4576.709, "timestamp": "01:16:16", "text": "呃，就像她……她有一个……她是一对夫妇"}, {"type": "subtitle", "time": 4581.07, "timestamp": "01:16:21", "text": "我知道，我也"}, {"type": "subtitle", "time": 4584.39, "timestamp": "01:16:24", "text": "所以，有的，学生甚至可能有好的"}, {"type": "subtitle", "time": 4586.31, "timestamp": "01:16:26", "text": "所以英语的好处在于……"}, {"type": "subtitle", "time": 4589.43, "timestamp": "01:16:29", "text": "2020年，他们中的大多数人……"}, {"type": "subtitle", "time": 4592.149, "timestamp": "01:16:32", "text": "路标上有英文，所以你不需要"}, {"type": "subtitle", "time": 4593.99, "timestamp": "01:16:33", "text": "他们大多数人都有这方面的顾虑。"}, {"type": "subtitle", "time": 4595.51, "timestamp": "01:16:35", "text": "英语，所以你不用担心"}, {"type": "subtitle", "time": 4597.47, "timestamp": "01:16:37", "text": "因为上次我进去的时候……"}, {"type": "subtitle", "time": 4601.189, "timestamp": "01:16:41", "text": "2017年没多少东西是英文的，所以就这样吧。"}, {"type": "subtitle", "time": 4603.99, "timestamp": "01:16:43", "text": "我能读懂平假名，但那样的话就容易出问题。"}, {"type": "subtitle", "time": 4606.59, "timestamp": "01:16:46", "text": "像我这样难搞的人，我必须喜欢"}, {"type": "subtitle", "time": 4609.03, "timestamp": "01:16:49", "text": "记住，对于一个句子，它需要"}, {"type": "subtitle", "time": 4612.07, "timestamp": "01:16:52", "text": "我觉得大概一分钟就能完成一个"}, {"type": "subtitle", "time": 4615.35, "timestamp": "01:16:55", "text": "句子。所以，但好消息是你"}, {"type": "subtitle", "time": 4617.35, "timestamp": "01:16:57", "text": "你会拥有这个英语"}, {"type": "chat", "time": 4618.601, "timestamp": "01:16:58", "author": "@BreaDGuy0078", "avatar": "https://yt4.ggpht.com/O8v1G-sabQKoVvPbSD8h_pLVydQ_mLyNSXpDD2A2gNJXBLHO228IzT5zq41iTuqUdmG_2xiIlg=s64-c-k-c0x00ffffff-no-rj", "message": "man saiko is old"}]
[{"type": "subtitle", "time": 19141.27, "timestamp": "05:19:01", "text": "leaving."}, {"type": "subtitle", "time": 19143.35, "timestamp": "05:19:03", "text": "Oh yeah. Hello."}, {"type": "subtitle", "time": 19145.788, "timestamp": "05:19:05", "text": "Forget about"}, {"type": "subtitle", "time": 19154.31, "timestamp": "05:19:14", "text": "Bring closing. We'll head to the bunker."}, {"type": "subtitle", "time": 19156.07, "timestamp": "05:19:16", "text": "Resupply."}, {"type": "subtitle", "time": 19158.47, "timestamp": "05:19:18", "text": "I haven't seen him. That's what my mom"}, {"type": "subtitle", "time": 19161.35, "timestamp": "05:19:21", "text": "always says. What is the syndicate"}, {"type": "subtitle", "time": 19163.43, "timestamp": "05:19:23", "text": "thinking? Eh, letting the pup join the"}, {"type": "subtitle", "time": 19165.59, "timestamp": "05:19:25", "text": "games. I'm a human person. You should"}, {"type": "subtitle", "time": 19168.708, "timestamp": "05:19:28", "text": "stay here. Safer. We're not leaving her."}, {"type": "subtitle", "time": 19170.628, "timestamp": "05:19:30", "text": "We're a team. We look out for each"}, {"type": "subtitle", "time": 19173.03, "timestamp": "05:19:33", "text": "other. Mhm. It's our funeral. We look"}, {"type": "subtitle", "time": 19175.51, "timestamp": "05:19:35", "text": "out for each other."}, {"type": "subtitle", "time": 19177.99, "timestamp": "05:19:37", "text": "Is it true? Did you do the things they"}, {"type": "subtitle", "time": 19180.55, "timestamp": "05:19:40", "text": "said? Of course not. But all that"}, {"type": "subtitle", "time": 19182.868, "timestamp": "05:19:42", "text": "matters here is what people believe."}, {"type": "subtitle", "time": 19185.27, "timestamp": "05:19:45", "text": "It's my fault. You're in here, isn't it?"}, {"type": "subtitle", "time": 19187.35, "timestamp": "05:19:47", "text": "If only I'd listen. We all make our own"}]
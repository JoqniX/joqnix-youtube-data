[{"type": "subtitle", "time": 16502.029, "timestamp": "04:35:02", "text": "[音楽]"}, {"type": "subtitle", "time": 16505.39, "timestamp": "04:35:05", "text": "トウ。行く前に少し立ち止まります"}, {"type": "subtitle", "time": 16517.349, "timestamp": "04:35:17", "text": "スマッシュ。では、待ってください。ゲームキャプチャ"}, {"type": "subtitle", "time": 16519.709, "timestamp": "04:35:19", "text": "あれ、"}, {"type": "subtitle", "time": 16522.269, "timestamp": "04:35:22", "text": "右？さあ"}, {"type": "subtitle", "time": 16532.949, "timestamp": "04:35:32", "text": "つまり、こういうことですよね？"}, {"type": "subtitle", "time": 16549.109, "timestamp": "04:35:49", "text": "そうそう。ストリーミングはどのように"}, {"type": "subtitle", "time": 16552.189, "timestamp": "04:35:52", "text": "トーナメント？実際はそうではない"}, {"type": "subtitle", "time": 16554.949, "timestamp": "04:35:54", "text": "知る。私はそうすべきかどうかわかりません"}, {"type": "subtitle", "time": 16557.47, "timestamp": "04:35:57", "text": "ストリーミングするか、"}]
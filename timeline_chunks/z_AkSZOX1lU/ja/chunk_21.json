[{"type": "subtitle", "time": 1284.43, "timestamp": "00:21:24", "text": "うん。は"}, {"type": "subtitle", "time": 1287.14, "timestamp": "00:21:27", "text": "あなた"}, {"type": "subtitle", "time": 1300.47, "timestamp": "00:21:40", "text": "どうしたの？何？何って言ったの？"}, {"type": "subtitle", "time": 1304.23, "timestamp": "00:21:44", "text": "闇は純粋だ、そう言ってみろ。私は言った、そして"}, {"type": "subtitle", "time": 1311.19, "timestamp": "00:21:51", "text": "ええ、私はただ闇は純粋で"}, {"type": "subtitle", "time": 1313.83, "timestamp": "00:21:53", "text": "そう言ってください。うん。"}, {"type": "subtitle", "time": 1316.549, "timestamp": "00:21:56", "text": "あら、どうしたの？何？何？何が"}]
[{"type": "subtitle", "time": 14346.71, "timestamp": "03:59:06", "text": "B. わかりました。午前6時。了解。午前6時は8時30分です"}, {"type": "subtitle", "time": 14349.75, "timestamp": "03:59:09", "text": "皆さんにとっては、午前（中部標準時）です。わかった。それらは"}, {"type": "subtitle", "time": 14352.15, "timestamp": "03:59:12", "text": "今、ビリー・ビリーの番組を見ています。えっと、"}, {"type": "subtitle", "time": 14376.63, "timestamp": "03:59:36", "text": "母親。うん、できるよ。私は信じます"}, {"type": "subtitle", "time": 14379.67, "timestamp": "03:59:39", "text": "できるよ。えっと、アレックス、私の体が"}, {"type": "subtitle", "time": 14382.429, "timestamp": "03:59:42", "text": "巨大な"}, {"type": "subtitle", "time": 14386.349, "timestamp": "03:59:46", "text": "プレッシャー。睡眠不足と"}, {"type": "subtitle", "time": 14389.269, "timestamp": "03:59:49", "text": "すべて。えっと、今何時ですか？ 1:41。"}, {"type": "subtitle", "time": 14393.59, "timestamp": "03:59:53", "text": "よし、寝るよ。 2 2 3から"}, {"type": "subtitle", "time": 14397.75, "timestamp": "03:59:57", "text": "3 4 5 6. ああ、私は4時間しか時間がない"}, {"type": "chat", "time": 14398.826, "timestamp": "03:59:58", "author": "@LordHeadAss002", "avatar": "https://yt4.ggpht.com/-EWTr8l_W5L2rvpeIbbmfhhB0C_JFG5p8g68fFdW2VO7paKednRMpYHY2A7J0gqpYJkgYp2Vnw=s64-c-k-c0x00ffffff-no-rj", "message": "goodnight"}, {"type": "subtitle", "time": 14399.83, "timestamp": "03:59:59", "text": "寝る。大丈夫。大丈夫。大丈夫。"}]
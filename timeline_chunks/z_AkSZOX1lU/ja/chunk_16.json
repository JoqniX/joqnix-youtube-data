[{"type": "subtitle", "time": 961.389, "timestamp": "00:16:01", "text": "のように"}, {"type": "subtitle", "time": 966.15, "timestamp": "00:16:06", "text": "えっと、母の、母と父が使っていると思います"}, {"type": "subtitle", "time": 969.43, "timestamp": "00:16:09", "text": "それは腰と背中のやつに効くんだ。私"}, {"type": "subtitle", "time": 971.47, "timestamp": "00:16:11", "text": "それを使って"}, {"type": "subtitle", "time": 976.749, "timestamp": "00:16:16", "text": "以前はそれを長くは使っていませんでした"}, {"type": "subtitle", "time": 985.15, "timestamp": "00:16:25", "text": "ニハ。ああ、いいぞ"}, {"type": "subtitle", "time": 988.189, "timestamp": "00:16:28", "text": "夕方。お元気でお過ごしでしょうか"}, {"type": "subtitle", "time": 995.509, "timestamp": "00:16:35", "text": "こんにちは。もう遅いんじゃないですか？それはそれは"}, {"type": "subtitle", "time": 1009.1, "timestamp": "00:16:49", "text": "よし、これを編集しよう。私たちはこれを編集します。"}]
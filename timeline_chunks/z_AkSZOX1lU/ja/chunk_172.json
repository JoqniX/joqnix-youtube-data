[{"type": "subtitle", "time": 10342.269, "timestamp": "02:52:22", "text": "おお。あなたは反省しない方です"}, {"type": "subtitle", "time": 10344.79, "timestamp": "02:52:24", "text": "不法侵入の罪で有罪"}, {"type": "subtitle", "time": 10348.389, "timestamp": "02:52:28", "text": "我が国は幾度となく。"}, {"type": "subtitle", "time": 10350.07, "timestamp": "02:52:30", "text": "私が唯一罪を犯したことは"}, {"type": "subtitle", "time": 10352.23, "timestamp": "02:52:32", "text": "君の汚い仕事を代わりにやってあ​​げるよ。そして"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "補償、私たちはあなたの"}, {"type": "subtitle", "time": 10356.07, "timestamp": "02:52:36", "text": "犯罪。"}, {"type": "subtitle", "time": 10358.15, "timestamp": "02:52:38", "text": "かかってこいよ、俺はこんなことやってられないから。"}, {"type": "subtitle", "time": 10359.83, "timestamp": "02:52:39", "text": "もう。あなたに"}, {"type": "subtitle", "time": 10365.29, "timestamp": "02:52:45", "text": "どんな種類"}, {"type": "subtitle", "time": 10368.15, "timestamp": "02:52:48", "text": "[音楽]"}, {"type": "subtitle", "time": 10369.55, "timestamp": "02:52:49", "text": "車"}, {"type": "subtitle", "time": 10371.79, "timestamp": "02:52:51", "text": "まるで持ってくるように"}, {"type": "subtitle", "time": 10375.59, "timestamp": "02:52:55", "text": "妊娠中の女性の死亡？"}, {"type": "subtitle", "time": 10378.23, "timestamp": "02:52:58", "text": "そんなことを許す人はいないだろう。"}]
[{"type": "subtitle", "time": 9421.95, "timestamp": "02:37:01", "text": "トゥ・オブリビオン リマスター版、またはルック・イット・ライク"}, {"type": "subtitle", "time": 9425.03, "timestamp": "02:37:05", "text": "なぜ私は忘却を見ることができないのか"}, {"type": "subtitle", "time": 9431.51, "timestamp": "02:37:11", "text": "インドにはないのですか？ああ、それは"}, {"type": "subtitle", "time": 9432.59, "timestamp": "02:37:12", "text": "成熟した"}, {"type": "subtitle", "time": 9435.349, "timestamp": "02:37:15", "text": "コンテンツ。だから私は言わなかったんです。"}, {"type": "subtitle", "time": 9447.19, "timestamp": "02:37:27", "text": "87年前に生まれた。"}, {"type": "subtitle", "time": 9453.349, "timestamp": "02:37:33", "text": "[音楽]"}, {"type": "subtitle", "time": 9455.21, "timestamp": "02:37:35", "text": "なぜ"}, {"type": "subtitle", "time": 9471.11, "timestamp": "02:37:51", "text": "高い？なぜ高いのですか？お願いします"}]
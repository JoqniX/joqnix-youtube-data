[{"type": "subtitle", "time": 26582.27, "timestamp": "07:23:02", "text": "今、インランドは最も"}, {"type": "subtitle", "time": 26586.15, "timestamp": "07:23:06", "text": "最強のキャラクター"}, {"type": "subtitle", "time": 26587.31, "timestamp": "07:23:07", "text": "私にとって"}, {"type": "subtitle", "time": 26590.99, "timestamp": "07:23:10", "text": "少しでも。だから、私はこうなりたかった"}, {"type": "subtitle", "time": 26600.27, "timestamp": "07:23:20", "text": "バッシュ、その日が来ることを願ってるよ"}, {"type": "subtitle", "time": 26604.03, "timestamp": "07:23:24", "text": "実際、私が好きなところ"}, {"type": "subtitle", "time": 26606.948, "timestamp": "07:23:26", "text": "文字通り、私は文字通り、ええと"}, {"type": "subtitle", "time": 26619.788, "timestamp": "07:23:39", "text": "[音楽]"}, {"type": "subtitle", "time": 26623.27, "timestamp": "07:23:43", "text": "フローズンヨーグルトでした。どういう意味ですか？えっと"}, {"type": "subtitle", "time": 26626.468, "timestamp": "07:23:46", "text": "何って言ったの？何？また、ようこそ"}, {"type": "subtitle", "time": 26628.35, "timestamp": "07:23:48", "text": "ストリーム、他のチーム。"}, {"type": "subtitle", "time": 26633.03, "timestamp": "07:23:53", "text": "いらっしゃいませ。はい、Kおじさんが来ました。"}, {"type": "subtitle", "time": 26636.75, "timestamp": "07:23:56", "text": "彼女にランダムな何かを与えてください"}]
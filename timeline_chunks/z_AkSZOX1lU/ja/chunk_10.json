[{"type": "subtitle", "time": 602.31, "timestamp": "00:10:02", "text": "より良い。もう一方のほうが良い"}, {"type": "subtitle", "time": 628.15, "timestamp": "00:10:28", "text": "私は何をしますか？えっと、私はそうすべきだった"}, {"type": "subtitle", "time": 630.11, "timestamp": "00:10:30", "text": "きちんと"}, {"type": "subtitle", "time": 637.11, "timestamp": "00:10:37", "text": "ここ？きちんと確認しておくべきだった"}, {"type": "subtitle", "time": 639.91, "timestamp": "00:10:39", "text": "削除します。私はただ"}, {"type": "subtitle", "time": 642.75, "timestamp": "00:10:42", "text": "アップロードする"}, {"type": "subtitle", "time": 646.15, "timestamp": "00:10:46", "text": "部分的にブロックされるはずです。私が"}, {"type": "subtitle", "time": 648.55, "timestamp": "00:10:48", "text": "カロクの配信をすれば、すべての配信は"}, {"type": "subtitle", "time": 651.59, "timestamp": "00:10:51", "text": "部分的にブロックされています。そこには何もありませんでした。いいえ、それは"}, {"type": "subtitle", "time": 653.15, "timestamp": "00:10:53", "text": "どちらか"}, {"type": "subtitle", "time": 656.509, "timestamp": "00:10:56", "text": "著作権。わかった。ショートパンツ。"}]
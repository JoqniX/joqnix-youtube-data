[{"type": "subtitle", "time": 23880.27, "timestamp": "06:38:00", "text": "ヴィナ。わかった。ヤナはなぜ？彼女は何者？"}, {"type": "subtitle", "time": 23888.35, "timestamp": "06:38:08", "text": "気づきましたか？"}, {"type": "subtitle", "time": 23898.91, "timestamp": "06:38:18", "text": "あちこちにナンが？これらは"}, {"type": "subtitle", "time": 23902.11, "timestamp": "06:38:22", "text": "ミッセナ。任せてください"}, {"type": "subtitle", "time": 23904.788, "timestamp": "06:38:24", "text": "自分。あなたにとって危険な場合があります。信頼"}, {"type": "subtitle", "time": 23916.6, "timestamp": "06:38:36", "text": "えっと"}, {"type": "subtitle", "time": 23920.03, "timestamp": "06:38:40", "text": "[音楽]"}, {"type": "subtitle", "time": 23923.548, "timestamp": "06:38:43", "text": "パパ・ロック、音がどこから聞こえてくるのか"}, {"type": "subtitle", "time": 23926.27, "timestamp": "06:38:46", "text": "から。調査してもいいですか？"}, {"type": "subtitle", "time": 23931.03, "timestamp": "06:38:51", "text": "それ？黒い花びら。ああ、わかりました。彼らだ。"}, {"type": "subtitle", "time": 23933.67, "timestamp": "06:38:53", "text": "ああ、わかりました。黒い花びら部隊のテーマまたは"}]
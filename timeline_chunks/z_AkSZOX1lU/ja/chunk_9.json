[{"type": "subtitle", "time": 545.509, "timestamp": "00:09:05", "text": "そう思います。この動画は何ですか？でも待って、"}, {"type": "subtitle", "time": 547.43, "timestamp": "00:09:07", "text": "昨日アップロードしたもの"}, {"type": "subtitle", "time": 551.75, "timestamp": "00:09:11", "text": "昨日アップロードされました。おお、これは"}, {"type": "subtitle", "time": 554.47, "timestamp": "00:09:14", "text": "私がアップロードしたものよりも良いクリップ"}, {"type": "subtitle", "time": 557.91, "timestamp": "00:09:17", "text": "昨日。ああ、大変だ。私は何をしますか？私"}, {"type": "subtitle", "time": 561.509, "timestamp": "00:09:21", "text": "おそらく適切に評価すべきだった"}, {"type": "subtitle", "time": 562.91, "timestamp": "00:09:22", "text": "は"}, {"type": "subtitle", "time": 565.91, "timestamp": "00:09:25", "text": "あ、待って。どの動画をアップロードしましたか？"}, {"type": "subtitle", "time": 567.79, "timestamp": "00:09:27", "text": "昨日？おお、"}, {"type": "subtitle", "time": 570.79, "timestamp": "00:09:30", "text": "いいえ。なんてこった。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 574.43, "timestamp": "00:09:34", "text": "いいえ。いいえ。いいえ。ああ、"}, {"type": "subtitle", "time": 578.11, "timestamp": "00:09:38", "text": "いいえ。なんてこった。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。いいえ。"}, {"type": "subtitle", "time": 583.55, "timestamp": "00:09:43", "text": "いいえ。こちらです。いいえ。私が削除しましたか？"}, {"type": "subtitle", "time": 588.07, "timestamp": "00:09:48", "text": "いや、違う。闇は純粋だ。そう言ってください。の"}, {"type": "subtitle", "time": 591.23, "timestamp": "00:09:51", "text": "闇は純粋で言う"}, {"type": "subtitle", "time": 594.4, "timestamp": "00:09:54", "text": "それで。ああ、もう1つは"}, {"type": "subtitle", "time": 594.78, "timestamp": "00:09:54", "text": "[拍手]"}]
[{"type": "subtitle", "time": 20761.51, "timestamp": "05:46:01", "text": "エングラム。九人はあなたの勇気を見ています。"}, {"type": "subtitle", "time": 20764.548, "timestamp": "05:46:04", "text": "今のところ、ほとんど揃っています。私はただ必要としている"}, {"type": "subtitle", "time": 20766.548, "timestamp": "05:46:06", "text": "たくさんのオオカミ。"}, {"type": "subtitle", "time": 20768.83, "timestamp": "05:46:08", "text": "モンテ"}, {"type": "subtitle", "time": 20792.03, "timestamp": "05:46:32", "text": "これはほとんど手に入れた"}, {"type": "subtitle", "time": 20793.548, "timestamp": "05:46:33", "text": "[音楽]"}, {"type": "subtitle", "time": 20811.788, "timestamp": "05:46:51", "text": "得る。六"}, {"type": "subtitle", "time": 20815.07, "timestamp": "05:46:55", "text": "コヨーテ。私は本当にオーを手に入れたのか"}]
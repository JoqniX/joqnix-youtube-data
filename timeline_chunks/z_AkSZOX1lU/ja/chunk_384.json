[{"type": "subtitle", "time": 23047.548, "timestamp": "06:24:07", "text": "に"}, {"type": "subtitle", "time": 23050.16, "timestamp": "06:24:10", "text": "なれ"}, {"type": "subtitle", "time": 23052.51, "timestamp": "06:24:12", "text": "[音楽]"}, {"type": "subtitle", "time": 23055.11, "timestamp": "06:24:15", "text": "実践。それは難しいだろう。"}, {"type": "subtitle", "time": 23057.35, "timestamp": "06:24:17", "text": "ええ、私たちは写真しか持っていません"}, {"type": "subtitle", "time": 23058.59, "timestamp": "06:24:18", "text": "花。"}, {"type": "subtitle", "time": 23062.75, "timestamp": "06:24:22", "text": "いいえ、リンおばあちゃん。誰"}, {"type": "subtitle", "time": 23066.39, "timestamp": "06:24:26", "text": "それ？よし、おばあちゃんに聞いてみよう。"}, {"type": "subtitle", "time": 23070.99, "timestamp": "06:24:30", "text": "彼女はいくつかアドバイスをくれるかもしれない。おお、"}, {"type": "subtitle", "time": 23085.868, "timestamp": "06:24:45", "text": "うん。彼女を探しに行こう。こんにちは。さあ"}, {"type": "subtitle", "time": 23089.708, "timestamp": "06:24:49", "text": "行く。私たちは探しています"}, {"type": "subtitle", "time": 23095.31, "timestamp": "06:24:55", "text": "おばあちゃん。雨を巻き戻す。ああ、雨粒。"}, {"type": "subtitle", "time": 23099.23, "timestamp": "06:24:59", "text": "わかった。ああ、彼女はとても近い。"}]
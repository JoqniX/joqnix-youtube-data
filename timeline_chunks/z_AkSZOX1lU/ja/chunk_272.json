[{"type": "subtitle", "time": 16323.429, "timestamp": "04:32:03", "text": "覗き魔。待って、それってニット帽？待って、"}, {"type": "subtitle", "time": 16326.03, "timestamp": "04:32:06", "text": "このゲームでビーニー帽は手に入るの？待って、"}, {"type": "subtitle", "time": 16331.75, "timestamp": "04:32:11", "text": "どうやって？え、何だって？それはニット帽です。"}, {"type": "subtitle", "time": 16333.07, "timestamp": "04:32:13", "text": "何"}, {"type": "subtitle", "time": 16335.95, "timestamp": "04:32:15", "text": "えっ？何"}, {"type": "subtitle", "time": 16338.95, "timestamp": "04:32:18", "text": "えっ？待って、どうやって明白なゲームを使うのか"}, {"type": "subtitle", "time": 16340.91, "timestamp": "04:32:20", "text": "捕獲？"}, {"type": "subtitle", "time": 16345.67, "timestamp": "04:32:25", "text": "バカ、もし私が、えっと、"}, {"type": "subtitle", "time": 16348.87, "timestamp": "04:32:28", "text": "あなたが言ったこと、えーと、パンド、えーと、明らかなゲーム"}, {"type": "subtitle", "time": 16352.07, "timestamp": "04:32:32", "text": "2つあれば可能なキャプチャ"}, {"type": "subtitle", "time": 16354.87, "timestamp": "04:32:34", "text": "モニター。"}, {"type": "subtitle", "time": 16358.67, "timestamp": "04:32:38", "text": "私はここに2台のモニターを持っていません。"}, {"type": "subtitle", "time": 16361.469, "timestamp": "04:32:41", "text": "ゲーム"}, {"type": "subtitle", "time": 16365.11, "timestamp": "04:32:45", "text": "PC その方法は、2 台目を使用するものです"}, {"type": "subtitle", "time": 16367.63, "timestamp": "04:32:47", "text": "監視して目立たないようにする"}, {"type": "subtitle", "time": 16371.67, "timestamp": "04:32:51", "text": "プレビューを開いてゲームを使用すると、"}, {"type": "subtitle", "time": 16375.07, "timestamp": "04:32:55", "text": "それはあなたの明らかなプレビューを使用します"}, {"type": "subtitle", "time": 16378.349, "timestamp": "04:32:58", "text": "ウィンドウ。私は試してみました"}]
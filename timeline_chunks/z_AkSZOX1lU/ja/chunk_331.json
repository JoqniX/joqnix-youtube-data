[{"type": "subtitle", "time": 19871.67, "timestamp": "05:31:11", "text": "わあ、やっと戻ってきたよ。ああ、残念。おお、あなた"}, {"type": "subtitle", "time": 19874.628, "timestamp": "05:31:14", "text": "自宅に到着した。さあ行こう。あ、待って。私"}, {"type": "subtitle", "time": 19876.868, "timestamp": "05:31:16", "text": "そういえば、原神にログインするのを忘れてた。"}, {"type": "subtitle", "time": 19901.83, "timestamp": "05:31:41", "text": "一体どういうことだ？"}]
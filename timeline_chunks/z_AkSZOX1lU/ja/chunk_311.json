[{"type": "subtitle", "time": 18660.91, "timestamp": "05:11:00", "text": "ええ、彼女は"}, {"type": "subtitle", "time": 18693.67, "timestamp": "05:11:33", "text": "よし、彼は先に彼を捕まえに行った。どうやって"}, {"type": "subtitle", "time": 18697.27, "timestamp": "05:11:37", "text": "この後、何回走る必要がありますか？えっと"}, {"type": "subtitle", "time": 18700.47, "timestamp": "05:11:40", "text": "16、17、18、19、20、21。さらに5ラン。"}, {"type": "subtitle", "time": 18716.948, "timestamp": "05:11:56", "text": "まったくその通りだ。ぜひそう信じてください。"}, {"type": "subtitle", "time": 18718.75, "timestamp": "05:11:58", "text": "どうですか？"}]
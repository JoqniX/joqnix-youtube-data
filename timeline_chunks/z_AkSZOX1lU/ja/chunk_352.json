[{"type": "subtitle", "time": 21123.35, "timestamp": "05:52:03", "text": "ストリーム。こんにちは。また皆さんにお会いしましょう"}, {"type": "subtitle", "time": 21126.03, "timestamp": "05:52:06", "text": "Twitchで"}, {"type": "subtitle", "time": 21128.35, "timestamp": "05:52:08", "text": "明日。ほとんど"}, {"type": "subtitle", "time": 21134.43, "timestamp": "05:52:14", "text": "おそらく。うん、明日。待って。ええ、そうですね。"}, {"type": "subtitle", "time": 21137.51, "timestamp": "05:52:17", "text": "ジョー、もう帰らなきゃ。"}, {"type": "subtitle", "time": 21140.788, "timestamp": "05:52:20", "text": "すごく疲れた。元に戻す作業は私がやります。"}, {"type": "subtitle", "time": 21143.43, "timestamp": "05:52:23", "text": "配信を終えてリラックスした後"}, {"type": "subtitle", "time": 21146.51, "timestamp": "05:52:26", "text": "しばらくの間。でも、そうですね"}, {"type": "subtitle", "time": 21149.99, "timestamp": "05:52:29", "text": "3時間の配信にご参加ください。私はそれが"}, {"type": "subtitle", "time": 21153.03, "timestamp": "05:52:33", "text": "短いですが、それでも私は"}, {"type": "subtitle", "time": 21156.51, "timestamp": "05:52:36", "text": "エネルギー。ストリーミング配信はしない方がいいと思う"}, {"type": "subtitle", "time": 21161.67, "timestamp": "05:52:41", "text": "ちょっとやりすぎだけど、まあね。はい、そうです。それで、"}, {"type": "subtitle", "time": 21163.788, "timestamp": "05:52:43", "text": "また後で会いましょう"}, {"type": "subtitle", "time": 21167.67, "timestamp": "05:52:47", "text": "少し。えっと、今日はExaconで配信するかもしれない"}, {"type": "subtitle", "time": 21170.91, "timestamp": "05:52:50", "text": "多分。はい、そうです。こんにちは、それで"}, {"type": "subtitle", "time": 21174.708, "timestamp": "05:52:54", "text": "さよならと言って、また会いましょう"}, {"type": "subtitle", "time": 21175.708, "timestamp": "05:52:55", "text": "次の"}, {"type": "subtitle", "time": 21178.79, "timestamp": "05:52:58", "text": "1つ。こんにちは。"}]
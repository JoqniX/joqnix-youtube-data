[{"type": "subtitle", "time": 17280.47, "timestamp": "04:48:00", "text": "右？よし、今度こそやるぞ。私"}, {"type": "subtitle", "time": 17284.43, "timestamp": "04:48:04", "text": "レベルに到達したい"}, {"type": "subtitle", "time": 17288.11, "timestamp": "04:48:08", "text": "私の"}, {"type": "subtitle", "time": 17290.59, "timestamp": "04:48:10", "text": "ほうきの柄。私はそれを成し遂げる"}, {"type": "subtitle", "time": 17309.07, "timestamp": "04:48:29", "text": "する？よし、これでいい。私はそれを作りました"}, {"type": "subtitle", "time": 17311.39, "timestamp": "04:48:31", "text": "ほうきの柄。"}, {"type": "subtitle", "time": 17314.11, "timestamp": "04:48:34", "text": "リード。ああ、それは"}, {"type": "subtitle", "time": 17318.31, "timestamp": "04:48:38", "text": "良い。あ、待って。ここで私は何をすればいいのでしょうか？おお、"}]
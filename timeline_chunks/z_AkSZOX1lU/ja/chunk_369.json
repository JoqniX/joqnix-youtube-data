[{"type": "subtitle", "time": 22141.59, "timestamp": "06:09:01", "text": "読まない方が楽だ。しかし、"}, {"type": "subtitle", "time": 22145.59, "timestamp": "06:09:05", "text": "唯一の問題は、えっと、名前ですよね、名前です"}, {"type": "subtitle", "time": 22148.39, "timestamp": "06:09:08", "text": "私ができない人の"}, {"type": "subtitle", "time": 22152.43, "timestamp": "06:09:12", "text": "誰が誰で誰が誰であるかを覚えておいてください"}, {"type": "subtitle", "time": 22155.91, "timestamp": "06:09:15", "text": "これは、名前が中国語になったためです。"}, {"type": "subtitle", "time": 22158.47, "timestamp": "06:09:18", "text": "中国語の名前は別の名前です"}, {"type": "subtitle", "time": 22160.868, "timestamp": "06:09:20", "text": "えっと、意味とかそういうのがわからない"}, {"type": "subtitle", "time": 22163.03, "timestamp": "06:09:23", "text": "知る"}, {"type": "subtitle", "time": 22168.788, "timestamp": "06:09:28", "text": "そう、漢字とかそういうやつでね。"}, {"type": "subtitle", "time": 22171.27, "timestamp": "06:09:31", "text": "ええ、私は50歳です。ええ、知っています。あなたは50歳です。"}, {"type": "subtitle", "time": 22174.708, "timestamp": "06:09:34", "text": "はい。はい。私は慣れるようにしています"}, {"type": "subtitle", "time": 22178.23, "timestamp": "06:09:38", "text": "ユーザー名が今見えています。あなたも"}, {"type": "subtitle", "time": 22181.59, "timestamp": "06:09:41", "text": "7人くらい、17人くらいかな"}, {"type": "subtitle", "time": 22185.628, "timestamp": "06:09:45", "text": "あなたに。うん、それは少しは役に立つだろう"}, {"type": "subtitle", "time": 22187.708, "timestamp": "06:09:47", "text": "少し。"}, {"type": "subtitle", "time": 22191.23, "timestamp": "06:09:51", "text": "ええ、そうですね。えっと"}, {"type": "subtitle", "time": 22194.948, "timestamp": "06:09:54", "text": "今日は何をしようかな。私たちは"}, {"type": "subtitle", "time": 22196.91, "timestamp": "06:09:56", "text": "メインクエストを進めてください。"}]
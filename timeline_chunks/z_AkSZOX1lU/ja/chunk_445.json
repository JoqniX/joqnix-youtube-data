[{"type": "subtitle", "time": 26700.07, "timestamp": "07:25:00", "text": "何よりも登場人物たちが一番大切なんだ、そうでしょう？"}, {"type": "subtitle", "time": 26702.19, "timestamp": "07:25:02", "text": "どうにか。"}, {"type": "subtitle", "time": 26711.628, "timestamp": "07:25:11", "text": "これ？これによって何が残るのか？私"}, {"type": "subtitle", "time": 26720.35, "timestamp": "07:25:20", "text": "ヒドラをありがとう、ヒドラ"}, {"type": "subtitle", "time": 26723.91, "timestamp": "07:25:23", "text": "12番氏をここで引き換えてください。ありがとう。エルサ、"}, {"type": "subtitle", "time": 26730.868, "timestamp": "07:25:30", "text": "ストリーム。ジョー、最近どうしてる？そして"}, {"type": "subtitle", "time": 26739.75, "timestamp": "07:25:39", "text": "テスト。試験を受けています。そう、私は"}, {"type": "subtitle", "time": 26742.26, "timestamp": "07:25:42", "text": "よくやっている。"}, {"type": "subtitle", "time": 26756.75, "timestamp": "07:25:56", "text": "[音楽]"}]
[{"type": "subtitle", "time": 13380.55, "timestamp": "03:43:00", "text": "いいですね、リポジトリが見つかりました。みんなが遊んでいる"}, {"type": "subtitle", "time": 13383.51, "timestamp": "03:43:03", "text": "リポジトリも同様です。"}, {"type": "subtitle", "time": 13386.67, "timestamp": "03:43:06", "text": "でも、友達は必要だよ。私は孤独な人間で"}, {"type": "subtitle", "time": 13395.53, "timestamp": "03:43:15", "text": "時々Apex"}, {"type": "subtitle", "time": 13397.389, "timestamp": "03:43:17", "text": "[音楽]"}, {"type": "subtitle", "time": 13400.469, "timestamp": "03:43:20", "text": "フォートはこれらのゲームに参加している。どうやって"}, {"type": "subtitle", "time": 13402.91, "timestamp": "03:43:22", "text": "これらの新しいものにアクセス"}, {"type": "subtitle", "time": 13405.429, "timestamp": "03:43:25", "text": "ゲーム？どれくらいの人気が必要なのか？おお、"}, {"type": "subtitle", "time": 13408.87, "timestamp": "03:43:28", "text": "こんにちは。こんにちは。いらっしゃいませ。"}, {"type": "subtitle", "time": 13419.349, "timestamp": "03:43:39", "text": "モンスターハンターワイルドを配信していますか？"}, {"type": "subtitle", "time": 13421.95, "timestamp": "03:43:41", "text": "みんながプレイするか"}, {"type": "subtitle", "time": 13425.11, "timestamp": "03:43:45", "text": "モンスター。新しいゲームの数は"}, {"type": "subtitle", "time": 13428.59, "timestamp": "03:43:48", "text": "非常識な。どうやって追跡するのですか"}, {"type": "subtitle", "time": 13430.79, "timestamp": "03:43:50", "text": "どのゲームか分かるカレンダー"}, {"type": "subtitle", "time": 13433.91, "timestamp": "03:43:53", "text": "これから始まるゲームと、プレプレイ用のゲームはどれですか？"}]
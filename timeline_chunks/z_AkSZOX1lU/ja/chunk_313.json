[{"type": "subtitle", "time": 18790.23, "timestamp": "05:13:10", "text": "独立性を確認する。私は注目します"}, {"type": "subtitle", "time": 18791.788, "timestamp": "05:13:11", "text": "これ"}, {"type": "subtitle", "time": 18795.43, "timestamp": "05:13:15", "text": "窓は、他のものでもやったから"}, {"type": "subtitle", "time": 18798.47, "timestamp": "05:13:18", "text": "これは実際に"}, {"type": "subtitle", "time": 18800.35, "timestamp": "05:13:20", "text": "チェックですか、それとも"}, {"type": "subtitle", "time": 18803.47, "timestamp": "05:13:23", "text": "単にこうなるだろう"}, {"type": "subtitle", "time": 18820.11, "timestamp": "05:13:40", "text": "これを終えた後"}, {"type": "subtitle", "time": 18824.708, "timestamp": "05:13:44", "text": "えーと、走って、えーと、昼食を食べに行って、"}, {"type": "subtitle", "time": 18828.55, "timestamp": "05:13:48", "text": "少し後で戻ってきます。私たちはクエストを行います"}, {"type": "subtitle", "time": 18831.83, "timestamp": "05:13:51", "text": "月とエウロパ。私たちは"}]
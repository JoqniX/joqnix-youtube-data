[{"type": "subtitle", "time": 13562.55, "timestamp": "03:46:02", "text": "要するに、インディーゲームとしては"}, {"type": "subtitle", "time": 13565.03, "timestamp": "03:46:05", "text": "良いけど、プレミアムAAAのようなもの"}, {"type": "subtitle", "time": 13571.15, "timestamp": "03:46:11", "text": "[音楽]"}, {"type": "subtitle", "time": 13574.87, "timestamp": "03:46:14", "text": "くそ。でも、私はマラソンをプレイしたいんです。私は"}, {"type": "subtitle", "time": 13576.51, "timestamp": "03:46:16", "text": "私はそうではない"}, {"type": "subtitle", "time": 13579.99, "timestamp": "03:46:19", "text": "知る。マナトンをプレイしたい。マラソン"}, {"type": "subtitle", "time": 13581.79, "timestamp": "03:46:21", "text": "どうやら"}, {"type": "subtitle", "time": 13584.71, "timestamp": "03:46:24", "text": "楽しい。その頃には、私は日本にいるでしょう。私"}, {"type": "subtitle", "time": 13586.55, "timestamp": "03:46:26", "text": "今はもう9月だと思う。私はそうかもしれない"}, {"type": "subtitle", "time": 13587.55, "timestamp": "03:46:27", "text": "できる"}, {"type": "subtitle", "time": 13591.07, "timestamp": "03:46:31", "text": "私はノートパソコンを持っているかもしれない"}, {"type": "subtitle", "time": 13602.87, "timestamp": "03:46:42", "text": "マラソンだと思う。みんな配信している。"}, {"type": "subtitle", "time": 13608.98, "timestamp": "03:46:48", "text": "マラソン。私が勝ちました"}, {"type": "subtitle", "time": 13613.87, "timestamp": "03:46:53", "text": "[音楽]"}, {"type": "subtitle", "time": 13617.15, "timestamp": "03:46:57", "text": "マラソン。私はしません"}]
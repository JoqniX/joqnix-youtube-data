[{"type": "subtitle", "time": 22983.03, "timestamp": "06:23:03", "text": "嘆く。ショーのメンバー全員が花開く"}, {"type": "subtitle", "time": 22988.51, "timestamp": "06:23:08", "text": "このような。 25日頃は空いているでしょう。ええと、24歳です。"}, {"type": "subtitle", "time": 22992.788, "timestamp": "06:23:12", "text": "えっと、私の試験はいつだったっけ？えっと、"}, {"type": "subtitle", "time": 22994.83, "timestamp": "06:23:14", "text": "えっと、私に"}, {"type": "subtitle", "time": 22997.87, "timestamp": "06:23:17", "text": "分。また、ようこそ"}, {"type": "subtitle", "time": 22999.868, "timestamp": "06:23:19", "text": "[音楽]"}, {"type": "subtitle", "time": 23001.548, "timestamp": "06:23:21", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 23004.43, "timestamp": "06:23:24", "text": "えっと、もう一度確認させてください"}, {"type": "subtitle", "time": 23006.67, "timestamp": "06:23:26", "text": "チェック。"}, {"type": "subtitle", "time": 23011.59, "timestamp": "06:23:31", "text": "えっと、25歳って言ったよね？ええ、私は自由です。私"}, {"type": "subtitle", "time": 23012.59, "timestamp": "06:23:32", "text": "できる"}, {"type": "subtitle", "time": 23016.868, "timestamp": "06:23:36", "text": "無料。いつですか？え、25歳？火曜日、"}, {"type": "subtitle", "time": 23039.07, "timestamp": "06:23:59", "text": "25日。わかった。しないで"}]
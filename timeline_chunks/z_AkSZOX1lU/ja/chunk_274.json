[{"type": "subtitle", "time": 16441.67, "timestamp": "04:34:01", "text": "また参加します。それで、今週は"}, {"type": "subtitle", "time": 16443.83, "timestamp": "04:34:03", "text": "来週からスケジュールは作成しません"}, {"type": "subtitle", "time": 16446.709, "timestamp": "04:34:06", "text": "今後はスケジュールに従って"}, {"type": "subtitle", "time": 16450.47, "timestamp": "04:34:10", "text": "予定されているスケジュールがあります。"}, {"type": "subtitle", "time": 16453.83, "timestamp": "04:34:13", "text": "ストリームのツイートは"}, {"type": "subtitle", "time": 16456.47, "timestamp": "04:34:16", "text": "1週間後に起こるので、私は"}, {"type": "subtitle", "time": 16458.67, "timestamp": "04:34:18", "text": "明日配信開始"}, {"type": "subtitle", "time": 16461.67, "timestamp": "04:34:21", "text": "Twitch はおそらく"}, {"type": "subtitle", "time": 16465.189, "timestamp": "04:34:25", "text": "朝かもしれないし、夕方かもしれない。"}, {"type": "subtitle", "time": 16468.39, "timestamp": "04:34:28", "text": "午後。明日は試合をします"}, {"type": "subtitle", "time": 16470.629, "timestamp": "04:34:30", "text": "ああ、いやいやいやいやいや。明日は"}, {"type": "subtitle", "time": 16472.269, "timestamp": "04:34:32", "text": "ヴァレリン"}, {"type": "subtitle", "time": 16475.109, "timestamp": "04:34:35", "text": "トーナメント。明日は、えっと、私は"}, {"type": "subtitle", "time": 16480.029, "timestamp": "04:34:40", "text": "Twitchで配信中のバーチャルなヴァレリン"}, {"type": "subtitle", "time": 16482.39, "timestamp": "04:34:42", "text": "トーナメント。それは夕方から始まる。それで"}, {"type": "subtitle", "time": 16484.629, "timestamp": "04:34:44", "text": "おそらく朝に何か"}, {"type": "subtitle", "time": 16487.189, "timestamp": "04:34:47", "text": "配信を開始します。ツイートします。"}, {"type": "subtitle", "time": 16489.429, "timestamp": "04:34:49", "text": "私のDiscordに参加しているなら、"}, {"type": "subtitle", "time": 16493.99, "timestamp": "04:34:53", "text": "ジョギングでピンロールして、ピンを受けられるようにする"}]
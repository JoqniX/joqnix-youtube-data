[{"type": "subtitle", "time": 26224.35, "timestamp": "07:17:04", "text": "手に入れるのはとても難しいだろう"}, {"type": "subtitle", "time": 26228.628, "timestamp": "07:17:08", "text": "お金も何もかも。まるで"}, {"type": "subtitle", "time": 26232.43, "timestamp": "07:17:12", "text": "ええ、確かにプライマルは手に入ります"}, {"type": "subtitle", "time": 26234.19, "timestamp": "07:17:14", "text": "[音楽]"}, {"type": "subtitle", "time": 26258.548, "timestamp": "07:17:38", "text": "レール。彼らは男性を短くしたと思う"}, {"type": "subtitle", "time": 26273.708, "timestamp": "07:17:53", "text": "した？私たちは戦わなければならないと思いますか？"}]
[{"type": "subtitle", "time": 14647.7, "timestamp": "04:04:07", "text": "終わり？私は虚無をやらなければならない。"}, {"type": "subtitle", "time": 14650.03, "timestamp": "04:04:10", "text": "[音楽]"}, {"type": "subtitle", "time": 14651.95, "timestamp": "04:04:11", "text": "いいえ。"}, {"type": "subtitle", "time": 14654.269, "timestamp": "04:04:14", "text": "いや。"}, {"type": "subtitle", "time": 14658.07, "timestamp": "04:04:18", "text": "大丈夫。大丈夫。大丈夫。大丈夫。私たちと一緒に参加しませんか？"}, {"type": "subtitle", "time": 14660.389, "timestamp": "04:04:20", "text": "後で？うーん、いい流れですよね？"}, {"type": "subtitle", "time": 14664.59, "timestamp": "04:04:24", "text": "「ああ、なんてことだ」を切り捨てます"}, {"type": "subtitle", "time": 14668.83, "timestamp": "04:04:28", "text": "ああ、本当に難しいよ。"}, {"type": "subtitle", "time": 14693.91, "timestamp": "04:04:53", "text": "ああ、これは昨日のことだった。する必要がある"}, {"type": "subtitle", "time": 14696.469, "timestamp": "04:04:56", "text": "時間を書き留めておけば簡単にカットできます"}]
[{"type": "subtitle", "time": 27554.6, "timestamp": "07:39:14", "text": "自分？信頼できる"}, {"type": "subtitle", "time": 27567.99, "timestamp": "07:39:27", "text": "え、何？えっと、個人的な知り合いはいますか？の"}, {"type": "subtitle", "time": 27569.07, "timestamp": "07:39:29", "text": "もちろん私たちは"}, {"type": "subtitle", "time": 27572.31, "timestamp": "07:39:32", "text": "する。彼女は確かに我々の仲間の一人だ。ああ、それは"}, {"type": "subtitle", "time": 27575.83, "timestamp": "07:39:35", "text": "なるほど、彼女は良い人なんですね。"}]
[{"type": "subtitle", "time": 17762.708, "timestamp": "04:56:02", "text": "5～10分、または3分"}, {"type": "subtitle", "time": 17771.59, "timestamp": "04:56:11", "text": "通常のストライキは15分から30分かかります。"}, {"type": "subtitle", "time": 17774.55, "timestamp": "04:56:14", "text": "これは本当に一番短いものです。人々"}, {"type": "subtitle", "time": 17778.15, "timestamp": "04:56:18", "text": "これを挽いて仕上げます"}, {"type": "subtitle", "time": 17800.708, "timestamp": "04:56:40", "text": "あと何人？ 15."}, {"type": "subtitle", "time": 17803.35, "timestamp": "04:56:43", "text": "あと6人。これは7番目だった"}, {"type": "subtitle", "time": 17804.948, "timestamp": "04:56:44", "text": "走る。"}, {"type": "subtitle", "time": 17807.19, "timestamp": "04:56:47", "text": "17回目のラン。"}, {"type": "subtitle", "time": 17809.47, "timestamp": "04:56:49", "text": "待て、17じゃない。7回目の挑戦だ。"}]
[{"type": "subtitle", "time": 16020.83, "timestamp": "04:27:00", "text": "何てことだ。おお"}, {"type": "subtitle", "time": 16025.469, "timestamp": "04:27:05", "text": "私の。私をからかってるの？ただ私に"}, {"type": "subtitle", "time": 16052.229, "timestamp": "04:27:32", "text": "いろいろあるけど、なぜダウンロードできないの？"}, {"type": "subtitle", "time": 16058.87, "timestamp": "04:27:38", "text": "コア？これらすべてを表示すべきではありません"}, {"type": "subtitle", "time": 16072.469, "timestamp": "04:27:52", "text": "ああ、つまり私は傷つきやすい、傷つきやすい"}, {"type": "subtitle", "time": 16075.269, "timestamp": "04:27:55", "text": "キャプチャカードのせいだ。もし私が"}, {"type": "subtitle", "time": 16078.51, "timestamp": "04:27:58", "text": "表示に明らかな方法を使う場合すべて"}]
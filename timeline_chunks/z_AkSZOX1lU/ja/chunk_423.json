[{"type": "subtitle", "time": 25381.83, "timestamp": "07:03:01", "text": "顔。こんにちは。ストリームへようこそ、"}, {"type": "subtitle", "time": 25390.468, "timestamp": "07:03:10", "text": "いらっしゃいませ。なぜダメなの？待って、ゲームはなかった"}, {"type": "subtitle", "time": 25397.788, "timestamp": "07:03:17", "text": "私、みんな？"}, {"type": "subtitle", "time": 25401.83, "timestamp": "07:03:21", "text": "ミナのコンサート会場。なぜ？なぜ誰も教えてくれなかったのか"}, {"type": "subtitle", "time": 25403.948, "timestamp": "07:03:23", "text": "私自身も"}, {"type": "subtitle", "time": 25421.468, "timestamp": "07:03:41", "text": "はい、彼らは黒人です"}]
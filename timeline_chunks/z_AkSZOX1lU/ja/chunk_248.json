[{"type": "subtitle", "time": 14881.03, "timestamp": "04:08:01", "text": "たったの693MBです。信じられますか？"}, {"type": "subtitle", "time": 14885.229, "timestamp": "04:08:05", "text": "F5。私たちのVはわずか693です"}, {"type": "subtitle", "time": 14889.75, "timestamp": "04:08:09", "text": "MB。おお。ただただすごい。短すぎる。"}, {"type": "subtitle", "time": 14892.55, "timestamp": "04:08:12", "text": "それは私がどれだけ少ないかを示しています"}, {"type": "subtitle", "time": 14894.63, "timestamp": "04:08:14", "text": "これがストリームに登場しても"}, {"type": "subtitle", "time": 14896.03, "timestamp": "04:08:16", "text": "24時間"}, {"type": "subtitle", "time": 14898.429, "timestamp": "04:08:18", "text": "ストリーム。ああ、"}, {"type": "subtitle", "time": 14902.79, "timestamp": "04:08:22", "text": "神。でも、私はそこに5時間いました。"}, {"type": "subtitle", "time": 14906.55, "timestamp": "04:08:26", "text": "5時間は短い。短すぎる。知っている。"}, {"type": "subtitle", "time": 14907.98, "timestamp": "04:08:27", "text": "その"}, {"type": "subtitle", "time": 14910.51, "timestamp": "04:08:30", "text": "[音楽]"}, {"type": "subtitle", "time": 14914.229, "timestamp": "04:08:34", "text": "わかった。今日は朝の配信をします"}, {"type": "subtitle", "time": 14917.75, "timestamp": "04:08:37", "text": "45日目 パート1。えーと明日えーと"}, {"type": "subtitle", "time": 14920.389, "timestamp": "04:08:40", "text": "午前6時。了解。 6時までにアップロードします。"}, {"type": "subtitle", "time": 14922.79, "timestamp": "04:08:42", "text": "午前中、眠くなる。皆さん、お元気で。"}, {"type": "subtitle", "time": 14924.79, "timestamp": "04:08:44", "text": "おやすみ。待って、待って、待って。ビリー"}, {"type": "subtitle", "time": 14928.429, "timestamp": "04:08:48", "text": "ビリー。えっと、ご視聴ありがとうございました。"}, {"type": "subtitle", "time": 14930.75, "timestamp": "04:08:50", "text": "無信者"}, {"type": "subtitle", "time": 14933.71, "timestamp": "04:08:53", "text": "それでは、寝ます。ありがとうございます"}, {"type": "subtitle", "time": 14936.07, "timestamp": "04:08:56", "text": "見ている人たちを見つめていた。感謝"}, {"type": "subtitle", "time": 14938.75, "timestamp": "04:08:58", "text": "楽しんでいただければ幸いです"}]
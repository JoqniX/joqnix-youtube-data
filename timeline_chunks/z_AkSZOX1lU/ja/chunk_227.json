[{"type": "subtitle", "time": 13626.55, "timestamp": "03:47:06", "text": "今の時点で。とても混乱しています。何を"}, {"type": "subtitle", "time": 13630.62, "timestamp": "03:47:10", "text": "する？何をプレイすればいいですか？"}, {"type": "subtitle", "time": 13633.55, "timestamp": "03:47:13", "text": "[音楽]"}, {"type": "subtitle", "time": 13646.83, "timestamp": "03:47:26", "text": "もの？それで"}, {"type": "subtitle", "time": 13650.469, "timestamp": "03:47:30", "text": "PCの制限で混乱しています"}, {"type": "subtitle", "time": 13650.92, "timestamp": "03:47:30", "text": "は"}, {"type": "subtitle", "time": 13652.349, "timestamp": "03:47:32", "text": "[音楽]"}, {"type": "subtitle", "time": 13660.71, "timestamp": "03:47:40", "text": "でも、このゲームをインストールしました"}, {"type": "subtitle", "time": 13663.269, "timestamp": "03:47:43", "text": "ロングドッグ。では、明日それをプレイします"}, {"type": "subtitle", "time": 13667.11, "timestamp": "03:47:47", "text": "サバイバルクラフト、というかワイルドなゲーム、"}, {"type": "subtitle", "time": 13669.95, "timestamp": "03:47:49", "text": "野生生物の生存"}, {"type": "subtitle", "time": 13673.63, "timestamp": "03:47:53", "text": "ゲームを見て、それがどう"}]
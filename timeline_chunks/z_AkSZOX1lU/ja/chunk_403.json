[{"type": "subtitle", "time": 24195.19, "timestamp": "06:43:15", "text": "私は祖父が多すぎる"}, {"type": "subtitle", "time": 24214.11, "timestamp": "06:43:34", "text": "フルーツ。周囲の環境の甘さを支持する。"}, {"type": "subtitle", "time": 24217.788, "timestamp": "06:43:37", "text": "何が"}, {"type": "subtitle", "time": 24219.39, "timestamp": "06:43:39", "text": "フルーツ"}, {"type": "subtitle", "time": 24228.59, "timestamp": "06:43:48", "text": "テーブル"}, {"type": "subtitle", "time": 24239.67, "timestamp": "06:43:59", "text": "ああ、私はあなたに変なことは何もしませんよ。"}]
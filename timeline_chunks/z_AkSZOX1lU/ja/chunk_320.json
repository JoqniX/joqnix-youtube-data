[{"type": "subtitle", "time": 19200.51, "timestamp": "05:20:00", "text": "いいえ。まるで"}, {"type": "subtitle", "time": 19207.35, "timestamp": "05:20:07", "text": "大丈夫。少なくとも私にはスペースがある。待ちます"}, {"type": "subtitle", "time": 19210.67, "timestamp": "05:20:10", "text": "それに対して。こんにちは。"}, {"type": "subtitle", "time": 19214.27, "timestamp": "05:20:14", "text": "えーと、ああ、いつも"}, {"type": "subtitle", "time": 19221.27, "timestamp": "05:20:21", "text": "行く。あのね？取りに行ってきます"}, {"type": "subtitle", "time": 19224.03, "timestamp": "05:20:24", "text": "ランチ。私はAB型になります。私は"}, {"type": "subtitle", "time": 19233.55, "timestamp": "05:20:33", "text": "座る。"}, {"type": "subtitle", "time": 19259.788, "timestamp": "05:20:59", "text": "消防隊を動員して"}]
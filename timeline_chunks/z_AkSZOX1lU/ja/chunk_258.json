[{"type": "subtitle", "time": 15480.149, "timestamp": "04:18:00", "text": "連絡を取りたい人が何人かいます"}, {"type": "subtitle", "time": 15482.349, "timestamp": "04:18:02", "text": "外に出るけど、私も"}, {"type": "subtitle", "time": 15485.309, "timestamp": "04:18:05", "text": "まあ、でも問題は"}, {"type": "subtitle", "time": 15489.11, "timestamp": "04:18:09", "text": "バカサキ、あなたの"}, {"type": "subtitle", "time": 15492.07, "timestamp": "04:18:12", "text": "彼らが決定する数字は"}, {"type": "subtitle", "time": 15495.95, "timestamp": "04:18:15", "text": "数字とかそういうのが嫌い"}, {"type": "subtitle", "time": 15497.469, "timestamp": "04:18:17", "text": "それ"}, {"type": "subtitle", "time": 15500.469, "timestamp": "04:18:20", "text": "なぜ数字の問題ではないのか"}, {"type": "subtitle", "time": 15503.11, "timestamp": "04:18:23", "text": "数字は意味を持たない、そうでしょう？"}, {"type": "subtitle", "time": 15506.71, "timestamp": "04:18:26", "text": "100万人の登録者がいる場合、または"}, {"type": "subtitle", "time": 15508.71, "timestamp": "04:18:28", "text": "登録者数が100人だろうと、それは問題ではない。何"}, {"type": "subtitle", "time": 15510.11, "timestamp": "04:18:30", "text": "問題は"}, {"type": "subtitle", "time": 15512.03, "timestamp": "04:18:32", "text": "人、"}, {"type": "subtitle", "time": 15537.91, "timestamp": "04:18:57", "text": "それで、えっと、何かする必要があるかもしれません"}]
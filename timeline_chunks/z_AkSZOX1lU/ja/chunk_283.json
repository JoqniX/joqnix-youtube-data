[{"type": "subtitle", "time": 16980.788, "timestamp": "04:43:00", "text": "えっと、25秒待ってて、それから"}, {"type": "subtitle", "time": 16982.99, "timestamp": "04:43:02", "text": "ただ"}, {"type": "subtitle", "time": 16989.83, "timestamp": "04:43:09", "text": "ビジュアル。どれが"}, {"type": "subtitle", "time": 16991.55, "timestamp": "04:43:11", "text": "1つ私が"}, {"type": "subtitle", "time": 16994.44, "timestamp": "04:43:14", "text": "必要。私は"}, {"type": "subtitle", "time": 17005.23, "timestamp": "04:43:25", "text": "マイクロソフト。ビジュアルだけが欲しい"}, {"type": "subtitle", "time": 17009.19, "timestamp": "04:43:29", "text": "スタジオ。これらは何ですか？"}, {"type": "subtitle", "time": 17024.11, "timestamp": "04:43:44", "text": "また？グーグルで検索すればいいかな？"}, {"type": "subtitle", "time": 17034.42, "timestamp": "04:43:54", "text": "2017"}]
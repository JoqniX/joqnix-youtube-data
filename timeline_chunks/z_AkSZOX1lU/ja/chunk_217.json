[{"type": "subtitle", "time": 13028.71, "timestamp": "03:37:08", "text": "目覚めさせないでください。それは新しいゲームですか？"}, {"type": "subtitle", "time": 13030.349, "timestamp": "03:37:10", "text": "行う"}, {"type": "subtitle", "time": 13043.19, "timestamp": "03:37:23", "text": "ああ、もし今それができたらすごく楽しいだろうな"}, {"type": "subtitle", "time": 13044.93, "timestamp": "03:37:24", "text": "ゲームで生計を立てる"}, {"type": "subtitle", "time": 13047.469, "timestamp": "03:37:27", "text": "[音楽]"}, {"type": "subtitle", "time": 13051.03, "timestamp": "03:37:31", "text": "そして、Twitchの他のストリーマーたちと同じように"}, {"type": "subtitle", "time": 13053.67, "timestamp": "03:37:33", "text": "そしてシュラウドとかそういうもの全部、"}, {"type": "subtitle", "time": 13056.349, "timestamp": "03:37:36", "text": "ゲームを仕事にしてお金をもらう"}, {"type": "subtitle", "time": 13076.0, "timestamp": "03:37:56", "text": "大丈夫。"}, {"type": "subtitle", "time": 13078.75, "timestamp": "03:37:58", "text": "[音楽]"}]
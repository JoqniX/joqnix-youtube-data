[{"type": "subtitle", "time": 14728.87, "timestamp": "04:05:28", "text": "秒。さて、何が終わったのですか？"}, {"type": "subtitle", "time": 14732.71, "timestamp": "04:05:32", "text": "VODの次のやつを切り抜いてるよ"}, {"type": "subtitle", "time": 14735.51, "timestamp": "04:05:35", "text": "私がアップロードしているストリームから"}, {"type": "subtitle", "time": 14737.75, "timestamp": "04:05:37", "text": "ビリー、人々は必要としていないと思うから"}, {"type": "subtitle", "time": 14741.349, "timestamp": "04:05:41", "text": "12時間全部見るとか"}, {"type": "subtitle", "time": 14744.309, "timestamp": "04:05:44", "text": "睡眠中のv全体。それは馬鹿げている。私"}, {"type": "subtitle", "time": 14746.309, "timestamp": "04:05:46", "text": "これらのストリームは既にアップロード済みです"}, {"type": "subtitle", "time": 14748.389, "timestamp": "04:05:48", "text": "すでに。だから意味がないと思う"}, {"type": "subtitle", "time": 14750.71, "timestamp": "04:05:50", "text": "それについて。だから、コンテンツだけを掲載します"}, {"type": "subtitle", "time": 14753.469, "timestamp": "04:05:53", "text": "私が実際に目に見える形で存在している場所。"}, {"type": "subtitle", "time": 14756.469, "timestamp": "04:05:56", "text": "右。うん。そっちの方がずっといい。私は感じる"}]
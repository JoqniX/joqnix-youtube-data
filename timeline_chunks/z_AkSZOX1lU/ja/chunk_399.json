[{"type": "subtitle", "time": 23941.548, "timestamp": "06:39:01", "text": "倒す"}, {"type": "subtitle", "time": 23944.67, "timestamp": "06:39:04", "text": "フラクティカス。よし、"}, {"type": "subtitle", "time": 23950.51, "timestamp": "06:39:10", "text": "行く。ああ、私のヨーリンがヒットした"}, {"type": "subtitle", "time": 23953.19, "timestamp": "06:39:13", "text": "難しい。ああ、言い忘れてたけど"}, {"type": "subtitle", "time": 23955.11, "timestamp": "06:39:15", "text": "彼女を完全に最大限まで強化しなかったし、"}, {"type": "subtitle", "time": 23960.51, "timestamp": "06:39:20", "text": "タイトルの才能なので、"}, {"type": "subtitle", "time": 23964.868, "timestamp": "06:39:24", "text": "する。ボスをアンロックするだけでいい"}, {"type": "subtitle", "time": 23977.628, "timestamp": "06:39:37", "text": "[音楽]"}]
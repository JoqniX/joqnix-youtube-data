[{"type": "subtitle", "time": 18002.868, "timestamp": "05:00:02", "text": "クエストをX回進行させる。それで、"}, {"type": "subtitle", "time": 18006.15, "timestamp": "05:00:06", "text": "代わりにこのストライキを行う"}, {"type": "subtitle", "time": 18009.27, "timestamp": "05:00:09", "text": "21回、ただやるしかない 11"}, {"type": "subtitle", "time": 18012.91, "timestamp": "05:00:12", "text": "回。それだけです。"}, {"type": "subtitle", "time": 18017.15, "timestamp": "05:00:17", "text": "X2。 1回のストライクは2回の進歩に等しい"}, {"type": "subtitle", "time": 18030.788, "timestamp": "05:00:30", "text": "そこには。だからもちろん、私はお金を使って"}, {"type": "subtitle", "time": 18032.51, "timestamp": "05:00:32", "text": "季節"}, {"type": "subtitle", "time": 18035.27, "timestamp": "05:00:35", "text": "要点、要約版。これらすべて"}, {"type": "subtitle", "time": 18037.83, "timestamp": "05:00:37", "text": "もの。終わらせなければならない"}, {"type": "subtitle", "time": 18040.708, "timestamp": "05:00:40", "text": "2月。それは来月のことです。"}, {"type": "subtitle", "time": 18042.99, "timestamp": "05:00:42", "text": "これらすべてが"}, {"type": "subtitle", "time": 18045.75, "timestamp": "05:00:45", "text": "コンテンツに飛び込んだ。行くよ"}, {"type": "subtitle", "time": 18047.948, "timestamp": "05:00:47", "text": "騙される。私は"}, {"type": "subtitle", "time": 18051.15, "timestamp": "05:00:51", "text": "多すぎる"}]
[{"type": "subtitle", "time": 61.51, "timestamp": "00:01:01", "text": "少し。私は1 2 3 4 5 6 7 8 9 10をしなければなりません"}, {"type": "subtitle", "time": 64.109, "timestamp": "00:01:04", "text": "10クリップ"}, {"type": "subtitle", "time": 67.87, "timestamp": "00:01:07", "text": "良い。一つずつ準備します"}, {"type": "subtitle", "time": 69.23, "timestamp": "00:01:09", "text": "[音楽]"}, {"type": "subtitle", "time": 72.87, "timestamp": "00:01:12", "text": "1つダウンロードして後で"}, {"type": "subtitle", "time": 75.149, "timestamp": "00:01:15", "text": "夜には私たちは"}, {"type": "subtitle", "time": 78.87, "timestamp": "00:01:18", "text": "えっと、新しいゲームをダウンロードしています"}, {"type": "subtitle", "time": 81.03, "timestamp": "00:01:21", "text": "まさに今、このゲームをプレイしています。"}, {"type": "subtitle", "time": 85.39, "timestamp": "00:01:25", "text": "それはハンターと呼ばれています"}, {"type": "subtitle", "time": 88.71000000000001, "timestamp": "00:01:28", "text": "クラシック。私はこのコールオブデューティを買いたかった"}, {"type": "subtitle", "time": 98.91, "timestamp": "00:01:38", "text": "それは動物を狩るゲームのようなもので、"}, {"type": "subtitle", "time": 102.83, "timestamp": "00:01:42", "text": "鹿、熊、鳥など"}, {"type": "subtitle", "time": 105.069, "timestamp": "00:01:45", "text": "など、"}, {"type": "subtitle", "time": 108.95, "timestamp": "00:01:48", "text": "スナイパー、複数の武器などなど。"}, {"type": "subtitle", "time": 112.31, "timestamp": "00:01:52", "text": "オープンワールドとして良さそうだ"}, {"type": "subtitle", "time": 116.95, "timestamp": "00:01:56", "text": "一種のオープンワールド体験。それは"}]
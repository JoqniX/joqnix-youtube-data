[{"type": "subtitle", "time": 20420.07, "timestamp": "05:40:20", "text": "待って、私のほうき。彼は私の"}, {"type": "subtitle", "time": 20421.99, "timestamp": "05:40:21", "text": "ほうきの柄。"}, {"type": "subtitle", "time": 20439.27, "timestamp": "05:40:39", "text": "えっ？あなたはどうするつもりですか？ああ、これは"}, {"type": "subtitle", "time": 20441.99, "timestamp": "05:40:41", "text": "影の湖での最後の挑戦。それで、"}, {"type": "subtitle", "time": 20445.91, "timestamp": "05:40:45", "text": "もうこれ以上繰り返す必要はない。の"}]
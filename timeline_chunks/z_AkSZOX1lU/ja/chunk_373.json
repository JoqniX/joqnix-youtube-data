[{"type": "subtitle", "time": 22380.59, "timestamp": "06:13:00", "text": "あなたが"}, {"type": "subtitle", "time": 22382.91, "timestamp": "06:13:02", "text": "走っている？どこにいるの"}, {"type": "subtitle", "time": 22390.59, "timestamp": "06:13:10", "text": "これ。ああ、大変だ。私は"}, {"type": "subtitle", "time": 22393.83, "timestamp": "06:13:13", "text": "再起動。技術的な問題が発生しました。その"}, {"type": "subtitle", "time": 22400.11, "timestamp": "06:13:20", "text": "[音楽]"}, {"type": "subtitle", "time": 22402.98, "timestamp": "06:13:22", "text": "ああ、わかった。私にやらせてください"}, {"type": "subtitle", "time": 22405.15, "timestamp": "06:13:25", "text": "[音楽]"}, {"type": "subtitle", "time": 22415.67, "timestamp": "06:13:35", "text": "男の子。ああ、そういえば今日、インターネットが使えなくなったんだ。"}, {"type": "subtitle", "time": 22417.628, "timestamp": "06:13:37", "text": "ああ、それは"}, {"type": "subtitle", "time": 22419.39, "timestamp": "06:13:39", "text": "なぜ。"}, {"type": "subtitle", "time": 22424.548, "timestamp": "06:13:44", "text": "おお。ああ、忘れてた。"}, {"type": "subtitle", "time": 22427.628, "timestamp": "06:13:47", "text": "そんなことがあったなんて忘れてた"}, {"type": "subtitle", "time": 22437.14, "timestamp": "06:13:57", "text": "なぜ私は"}]
[{"type": "subtitle", "time": 25500.11, "timestamp": "07:05:00", "text": "このゲームでは、"}, {"type": "subtitle", "time": 25503.75, "timestamp": "07:05:03", "text": "毎日のお休みを終えて"}, {"type": "subtitle", "time": 25505.23, "timestamp": "07:05:05", "text": "プレートと"}, {"type": "subtitle", "time": 25509.19, "timestamp": "07:05:09", "text": "他に何をすべきか"}, {"type": "subtitle", "time": 25512.19, "timestamp": "07:05:12", "text": "探索を終えて"}, {"type": "subtitle", "time": 25514.708, "timestamp": "07:05:14", "text": "やることがあまりない"}, {"type": "subtitle", "time": 25517.708, "timestamp": "07:05:17", "text": "ゲームはどうやって"}, {"type": "subtitle", "time": 25521.868, "timestamp": "07:05:21", "text": "農場 プライムのために農場を経営するにはどうすればいいですか？"}, {"type": "subtitle", "time": 25525.03, "timestamp": "07:05:25", "text": "アステロイドをプレイして、協力プレイでコールアウトをプレイします。なぜ"}, {"type": "subtitle", "time": 25528.19, "timestamp": "07:05:28", "text": "協力プレイをしたいですか？誰が？退屈だ"}, {"type": "subtitle", "time": 25532.35, "timestamp": "07:05:32", "text": "今。つまり、"}, {"type": "subtitle", "time": 25537.19, "timestamp": "07:05:37", "text": "コープ？ボスと戦う。いや、でもできるよ"}, {"type": "subtitle", "time": 25539.31, "timestamp": "07:05:39", "text": "それだけでも十分だ。いや、"}, {"type": "subtitle", "time": 25546.31, "timestamp": "07:05:46", "text": "ああ、私はまるで乗り越えたみたいに聞こえる"}, {"type": "subtitle", "time": 25549.59, "timestamp": "07:05:49", "text": "このゲームですよね？私はまるで"}, {"type": "subtitle", "time": 25551.67, "timestamp": "07:05:51", "text": "原神とスターに飽きてしまった"}, {"type": "subtitle", "time": 25557.99, "timestamp": "07:05:57", "text": "ビランは最善を尽くします。もしあなたがすべてを行ったらどうなるでしょうか"}, {"type": "subtitle", "time": 25559.628, "timestamp": "07:05:59", "text": "それ？職業はなんですか"}]
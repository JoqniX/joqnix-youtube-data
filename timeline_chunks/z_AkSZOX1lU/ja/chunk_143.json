[{"type": "subtitle", "time": 8588.56, "timestamp": "02:23:08", "text": "それがエネルギーだ。"}, {"type": "subtitle", "time": 8603.51, "timestamp": "02:23:23", "text": "家に帰ろうかな。私は"}, {"type": "subtitle", "time": 8619.349, "timestamp": "02:23:39", "text": "[音楽]"}, {"type": "subtitle", "time": 8622.15, "timestamp": "02:23:42", "text": "私は、ただセックスできるだけだと思った"}, {"type": "subtitle", "time": 8625.23, "timestamp": "02:23:45", "text": "鹿を殺したが、見つけられなかった"}]
[{"type": "subtitle", "time": 2527.27, "timestamp": "00:42:07", "text": "わかった。私は完全な英語を作ることができません"}, {"type": "subtitle", "time": 2530.03, "timestamp": "00:42:10", "text": "文。大丈夫。いいえ"}, {"type": "subtitle", "time": 2532.109, "timestamp": "00:42:12", "text": "心配事。私"}, {"type": "subtitle", "time": 2534.75, "timestamp": "00:42:14", "text": "待ってはいけません。どうすればいいですか"}, {"type": "subtitle", "time": 2566.75, "timestamp": "00:42:46", "text": "顔の中にすべてが揃っています。"}, {"type": "subtitle", "time": 2570.109, "timestamp": "00:42:50", "text": "うん。本当に"}]
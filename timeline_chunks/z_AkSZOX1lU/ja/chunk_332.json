[{"type": "subtitle", "time": 19930.23, "timestamp": "05:32:10", "text": "えっ？アップデート後にログインしました。こんにちは。"}, {"type": "subtitle", "time": 19933.43, "timestamp": "05:32:13", "text": "あ、待って。アップデートはいつですか？"}, {"type": "subtitle", "time": 19935.548, "timestamp": "05:32:15", "text": "新しい"}, {"type": "subtitle", "time": 19946.708, "timestamp": "05:32:26", "text": "それ？ああ、なんてことだ、髪の毛が口の中に入ってしまった。"}, {"type": "subtitle", "time": 19977.67, "timestamp": "05:32:57", "text": "わかった。ああ、この髪。ああ、それは"}]
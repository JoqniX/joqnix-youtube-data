[{"type": "subtitle", "time": 25921.07, "timestamp": "07:12:01", "text": "[音楽]"}, {"type": "subtitle", "time": 25924.51, "timestamp": "07:12:04", "text": "モード。ああ、ダウンロードしないといけない。"}, {"type": "subtitle", "time": 25932.708, "timestamp": "07:12:12", "text": "ええ、そうですね。こんにちは、アラクサ。うん。こんにちは、"}, {"type": "subtitle", "time": 25935.31, "timestamp": "07:12:15", "text": "DGST。いらっしゃいませ。"}, {"type": "subtitle", "time": 25938.83, "timestamp": "07:12:18", "text": "いらっしゃいませ。私は今、クリックしたのでしょうか？"}, {"type": "subtitle", "time": 25940.79, "timestamp": "07:12:20", "text": "わかった。英語ですよね？"}, {"type": "subtitle", "time": 25945.07, "timestamp": "07:12:25", "text": "[音楽]"}, {"type": "subtitle", "time": 25949.35, "timestamp": "07:12:29", "text": "うん。誕生日のお祝いの歌声。"}, {"type": "subtitle", "time": 25950.99, "timestamp": "07:12:30", "text": "どのように"}, {"type": "subtitle", "time": 25960.59, "timestamp": "07:12:40", "text": "声。何？ハッピー"}, {"type": "subtitle", "time": 25964.23, "timestamp": "07:12:44", "text": "誕生日。あれは何だ？何？来る"}, {"type": "subtitle", "time": 25967.548, "timestamp": "07:12:47", "text": "の上。本当にあなたの特別なものだと約束します"}, {"type": "subtitle", "time": 25971.11, "timestamp": "07:12:51", "text": "日。いいえ、私はゲームをしているわけではありません"}, {"type": "subtitle", "time": 25975.43, "timestamp": "07:12:55", "text": "この時。待って。ああ、もう"}, {"type": "subtitle", "time": 25978.788, "timestamp": "07:12:58", "text": "何も予定がないと伝えてください。では、"}]
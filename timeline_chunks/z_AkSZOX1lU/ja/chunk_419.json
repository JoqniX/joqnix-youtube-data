[{"type": "subtitle", "time": 25146.868, "timestamp": "06:59:06", "text": "ああ、アンジェラおじさんは悪いことはしないよ"}, {"type": "subtitle", "time": 25147.868, "timestamp": "06:59:07", "text": "に"}, {"type": "subtitle", "time": 25161.75, "timestamp": "06:59:21", "text": "これ。大切なクライアントを解放します。"}, {"type": "subtitle", "time": 25164.868, "timestamp": "06:59:24", "text": "彼女は良いヤギと悪いヤギを飼っている"}, {"type": "subtitle", "time": 25183.708, "timestamp": "06:59:43", "text": "ああ、彼の目は金色だ。"}, {"type": "subtitle", "time": 25185.58, "timestamp": "06:59:45", "text": "おお。いいね。"}, {"type": "subtitle", "time": 25193.788, "timestamp": "06:59:53", "text": "[音楽]"}]
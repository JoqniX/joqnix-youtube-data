[{"type": "subtitle", "time": 16262.189, "timestamp": "04:31:02", "text": "男。彼はどんな武器を使っているのか？ああ、融合"}, {"type": "subtitle", "time": 16264.03, "timestamp": "04:31:04", "text": "ライフル。"}, {"type": "subtitle", "time": 16266.309, "timestamp": "04:31:06", "text": "ニース。私たちの後ろにあるものは何であれ"}, {"type": "subtitle", "time": 16300.11, "timestamp": "04:31:40", "text": "ああ。ああ、彼のスピード、スピード。私はこれが好き"}, {"type": "subtitle", "time": 16302.63, "timestamp": "04:31:42", "text": "男。私たちは明らかなゲームキャプチャは使用しません"}, {"type": "subtitle", "time": 16316.03, "timestamp": "04:31:56", "text": "いいえ。私"}]
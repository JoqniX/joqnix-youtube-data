[{"type": "subtitle", "time": 1443.19, "timestamp": "00:24:03", "text": "D 大きい方は愛されていなかったので"}, {"type": "subtitle", "time": 1445.669, "timestamp": "00:24:05", "text": "小さいものと大きいもの"}, {"type": "subtitle", "time": 1450.59, "timestamp": "00:24:10", "text": "一緒に寝る。私は、"}, {"type": "subtitle", "time": 1453.39, "timestamp": "00:24:13", "text": "ASMR。私は大きなものを持っています"}, {"type": "subtitle", "time": 1455.31, "timestamp": "00:24:15", "text": "けれど。"}, {"type": "subtitle", "time": 1477.669, "timestamp": "00:24:37", "text": "この種の中央中央の物"}, {"type": "subtitle", "time": 1481.43, "timestamp": "00:24:41", "text": "すべては、待って、私には何かありますか？"}, {"type": "subtitle", "time": 1483.35, "timestamp": "00:24:43", "text": "ああ、ハンタークラシックは終わった。私はできる"}, {"type": "subtitle", "time": 1485.549, "timestamp": "00:24:45", "text": "ストリーム"}, {"type": "subtitle", "time": 1488.95, "timestamp": "00:24:48", "text": "今のところ、誰でも5つまでアップロードできます。"}, {"type": "subtitle", "time": 1498.11, "timestamp": "00:24:58", "text": "[音楽]"}]
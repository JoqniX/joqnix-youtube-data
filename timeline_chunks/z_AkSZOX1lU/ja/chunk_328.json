[{"type": "subtitle", "time": 19692.43, "timestamp": "05:28:12", "text": "満杯。私は"}, {"type": "subtitle", "time": 19709.51, "timestamp": "05:28:29", "text": "ああ、水をたくさん飲んだな。私のお腹"}, {"type": "subtitle", "time": 19711.27, "timestamp": "05:28:31", "text": "満員です。"}, {"type": "subtitle", "time": 19720.43, "timestamp": "05:28:40", "text": "そして、ストームコート作戦"}, {"type": "subtitle", "time": 19723.43, "timestamp": "05:28:43", "text": "地元の鶏の群れが隠れている"}]
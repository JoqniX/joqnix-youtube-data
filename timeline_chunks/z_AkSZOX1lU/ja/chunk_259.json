[{"type": "subtitle", "time": 15541.67, "timestamp": "04:19:01", "text": "手短に。それで、私はこれを追っていたんです"}, {"type": "subtitle", "time": 15544.189, "timestamp": "04:19:04", "text": "えっと、チュートリアルですね。所有"}, {"type": "subtitle", "time": 15547.55, "timestamp": "04:19:07", "text": "上。手短に済ませますね。"}, {"type": "subtitle", "time": 15550.99, "timestamp": "04:19:10", "text": "待って。これを終わらせるだけ"}, {"type": "subtitle", "time": 15552.99, "timestamp": "04:19:12", "text": "上。所有"}, {"type": "subtitle", "time": 15557.349, "timestamp": "04:19:17", "text": "上。今日中にこれを済ませたい"}, {"type": "subtitle", "time": 15561.269, "timestamp": "04:19:21", "text": "そうすれば、Unreal Engineで3D制作ができる。"}, {"type": "subtitle", "time": 15564.71, "timestamp": "04:19:24", "text": "あなたの機材はどこに設置されていますか？うん。こんにちは、マサさん。"}, {"type": "subtitle", "time": 15572.03, "timestamp": "04:19:32", "text": "何をしているの？バイナリは"}, {"type": "subtitle", "time": 15574.59, "timestamp": "04:19:34", "text": "ダウンロードしました。作る必要があるだけです"}, {"type": "subtitle", "time": 15579.07, "timestamp": "04:19:39", "text": "それ。エクスポートできるようにしてください。所有"}, {"type": "subtitle", "time": 15582.51, "timestamp": "04:19:42", "text": "上。ちょっとこれを実際にやってみます"}, {"type": "subtitle", "time": 15586.349, "timestamp": "04:19:46", "text": "素早い。わかった。 Unreal は今"}, {"type": "subtitle", "time": 15594.03, "timestamp": "04:19:54", "text": "市場"}, {"type": "subtitle", "time": 15598.309, "timestamp": "04:19:58", "text": "負荷。プラグインがあればいいのに"}]
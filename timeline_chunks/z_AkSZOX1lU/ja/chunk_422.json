[{"type": "subtitle", "time": 25320.23, "timestamp": "07:02:00", "text": "ええと、私は足首から目が離せません。"}, {"type": "subtitle", "time": 25323.708, "timestamp": "07:02:03", "text": "彼女はすごく素敵でかっこいい。そして"}, {"type": "subtitle", "time": 25328.35, "timestamp": "07:02:08", "text": "カワイイ、彼女の動きはどれも"}, {"type": "subtitle", "time": 25336.07, "timestamp": "07:02:16", "text": "貴重な。私は引っ張るつもりです"}, {"type": "subtitle", "time": 25338.39, "timestamp": "07:02:18", "text": "ああ、そうだね。私には、"}, {"type": "subtitle", "time": 25340.628, "timestamp": "07:02:20", "text": "彼女。"}, {"type": "subtitle", "time": 25368.19, "timestamp": "07:02:48", "text": "[笑い]"}, {"type": "subtitle", "time": 25371.788, "timestamp": "07:02:51", "text": "ああ、なんてことだ"}, {"type": "subtitle", "time": 25379.23, "timestamp": "07:02:59", "text": "[音楽]"}]
[{"type": "subtitle", "time": 14581.11, "timestamp": "04:03:01", "text": "すべて。万全の準備を整えました。"}, {"type": "subtitle", "time": 14584.309, "timestamp": "04:03:04", "text": "うん、そうしよう。大丈夫、任せて。"}, {"type": "subtitle", "time": 14587.51, "timestamp": "04:03:07", "text": "大丈夫、できるよ。ディオ、私ならできます。私はできる"}, {"type": "subtitle", "time": 14589.79, "timestamp": "04:03:09", "text": "そうしてください。うん。うん。うん。"}, {"type": "subtitle", "time": 14593.03, "timestamp": "04:03:13", "text": "うん。それは植物です。それは、それは"}, {"type": "subtitle", "time": 14596.389, "timestamp": "04:03:16", "text": "植物。これは計画だ。計画がある。私たちは"}, {"type": "subtitle", "time": 14599.15, "timestamp": "04:03:19", "text": "計画に従います。願っています"}, {"type": "subtitle", "time": 14602.389, "timestamp": "04:03:22", "text": "それで。自分のスケジュールをきちんと調整したいんです。"}, {"type": "subtitle", "time": 14605.67, "timestamp": "04:03:25", "text": "だから、このコラボを使っているんです"}, {"type": "subtitle", "time": 14609.349, "timestamp": "04:03:29", "text": "コラボリーパーコラボは私にとって"}, {"type": "subtitle", "time": 14612.59, "timestamp": "04:03:32", "text": "実際に睡眠を改善したい"}, {"type": "subtitle", "time": 14615.469, "timestamp": "04:03:35", "text": "人々がすることすべて"}, {"type": "subtitle", "time": 14634.429, "timestamp": "04:03:54", "text": "とにかく、私は寝ます。なぜ私の犬は"}, {"type": "subtitle", "time": 14638.269, "timestamp": "04:03:58", "text": "吠えている？えっと、私の"}]
[{"type": "subtitle", "time": 2166.349, "timestamp": "00:36:06", "text": "それ。あなたは14歳か15歳くらいに感じます。"}, {"type": "subtitle", "time": 2169.67, "timestamp": "00:36:09", "text": "なぜ？何てことだ。私は何をしてきたのか"}, {"type": "subtitle", "time": 2172.87, "timestamp": "00:36:12", "text": "私が14歳か15歳の頃のこと？私はそうは思わない"}, {"type": "subtitle", "time": 2183.91, "timestamp": "00:36:23", "text": "おお。何をしたか覚えていない"}, {"type": "subtitle", "time": 2186.589, "timestamp": "00:36:26", "text": "それは"}, {"type": "subtitle", "time": 2194.109, "timestamp": "00:36:34", "text": "たぶん私は"}, {"type": "subtitle", "time": 2202.99, "timestamp": "00:36:42", "text": "だった。待って、ちょっと待って。 15"}, {"type": "subtitle", "time": 2209.349, "timestamp": "00:36:49", "text": "何歳で、インドでは何年生ですか？待って、"}, {"type": "subtitle", "time": 2212.39, "timestamp": "00:36:52", "text": "15歳だったら何年生になるの？"}, {"type": "subtitle", "time": 2213.55, "timestamp": "00:36:53", "text": "年"}]
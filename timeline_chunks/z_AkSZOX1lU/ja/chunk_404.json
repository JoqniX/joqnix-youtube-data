[{"type": "subtitle", "time": 24242.24, "timestamp": "06:44:02", "text": "あなたが思うことは"}, {"type": "subtitle", "time": 24253.868, "timestamp": "06:44:13", "text": "[音楽]"}, {"type": "subtitle", "time": 24262.23, "timestamp": "06:44:22", "text": "ゲームはあなたの心を奪う。私は共有するのが好きではない。"}, {"type": "subtitle", "time": 24280.628, "timestamp": "06:44:40", "text": "愚か者ども。私に感謝しなければならない"}, {"type": "subtitle", "time": 24283.23, "timestamp": "06:44:43", "text": "あの人たち"}]
[{"type": "subtitle", "time": 13869.83, "timestamp": "03:51:09", "text": "私もそれを試してみたいです。"}, {"type": "subtitle", "time": 13872.79, "timestamp": "03:51:12", "text": "ゲームを買う前に、"}, {"type": "subtitle", "time": 13876.03, "timestamp": "03:51:16", "text": "私が興味を持っているかどうかを知りたい"}, {"type": "subtitle", "time": 13878.85, "timestamp": "03:51:18", "text": "それが良いもので、"}, {"type": "subtitle", "time": 13880.269, "timestamp": "03:51:20", "text": "[音楽]"}, {"type": "subtitle", "time": 13889.99, "timestamp": "03:51:29", "text": "ゲームをしたくないから"}, {"type": "subtitle", "time": 13901.79, "timestamp": "03:51:41", "text": "[音楽]"}]
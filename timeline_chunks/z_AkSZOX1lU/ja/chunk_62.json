[{"type": "subtitle", "time": 3733.43, "timestamp": "01:02:13", "text": "D. よし、これで終わりだ。そして私たちは"}, {"type": "subtitle", "time": 3736.67, "timestamp": "01:02:16", "text": "今からスイッチを入れます"}, {"type": "subtitle", "time": 3739.51, "timestamp": "01:02:19", "text": "狩猟ゲームをして、それをプレイします"}, {"type": "subtitle", "time": 3741.109, "timestamp": "01:02:21", "text": "今すぐ。"}, {"type": "subtitle", "time": 3742.789, "timestamp": "01:02:22", "text": "私にとって初めてになります"}, {"type": "subtitle", "time": 3745.67, "timestamp": "01:02:25", "text": "そのゲームをプレイするので、楽しみです。だった"}, {"type": "subtitle", "time": 3747.75, "timestamp": "01:02:27", "text": "お皿はもう終わりました"}, {"type": "subtitle", "time": 3749.87, "timestamp": "01:02:29", "text": "右"}, {"type": "subtitle", "time": 3751.71, "timestamp": "01:02:31", "text": "今。"}]
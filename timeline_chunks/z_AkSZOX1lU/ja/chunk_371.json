[{"type": "subtitle", "time": 22262.67, "timestamp": "06:11:02", "text": "え、何？どこ"}, {"type": "subtitle", "time": 22268.43, "timestamp": "06:11:08", "text": "それ？待って、なぜ送信されないの？"}, {"type": "subtitle", "time": 22270.91, "timestamp": "06:11:10", "text": "何？ああ、"}, {"type": "subtitle", "time": 22275.628, "timestamp": "06:11:15", "text": "待って。我慢する。ちょっと待って。"}, {"type": "subtitle", "time": 22279.31, "timestamp": "06:11:19", "text": "ミイ、君じゃないよ。待って、君が必要なんだ。"}, {"type": "subtitle", "time": 22282.708, "timestamp": "06:11:22", "text": "えっと、どうしてここにいないんですか？待って、待って、"}, {"type": "subtitle", "time": 22285.59, "timestamp": "06:11:25", "text": "待って、待って、待って、待って、待って。メディオSX。"}, {"type": "subtitle", "time": 22288.23, "timestamp": "06:11:28", "text": "えっと、発売されなかったんですか？何"}, {"type": "subtitle", "time": 22300.11, "timestamp": "06:11:40", "text": "の上。やったか"}, {"type": "subtitle", "time": 22301.868, "timestamp": "06:11:41", "text": "[音楽]"}, {"type": "subtitle", "time": 22305.548, "timestamp": "06:11:45", "text": "打ち上げ？発売されましたか？やったか"}, {"type": "subtitle", "time": 22308.548, "timestamp": "06:11:48", "text": "打ち上げ？ああ、確かに発売されたよ。ではどうして"}, {"type": "subtitle", "time": 22310.948, "timestamp": "06:11:50", "text": "私のデータを送信していないのですか？ちょっと待って"}, {"type": "subtitle", "time": 22314.83, "timestamp": "06:11:54", "text": "2番。えっと、削除。"}, {"type": "subtitle", "time": 22317.39, "timestamp": "06:11:57", "text": "消去。打ち上げ"}]
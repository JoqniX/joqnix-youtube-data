[{"type": "subtitle", "time": 21721.868, "timestamp": "06:02:01", "text": "日曜日？日曜日。えっと、昨日だったと思う"}, {"type": "subtitle", "time": 21724.948, "timestamp": "06:02:04", "text": "右。えっと、いつ配信したっけ"}, {"type": "subtitle", "time": 21727.91, "timestamp": "06:02:07", "text": "ビリー？忘れた。えっと、土曜日でしたっけ？"}, {"type": "subtitle", "time": 21731.59, "timestamp": "06:02:11", "text": "それとも日曜日だったかな？確か"}, {"type": "subtitle", "time": 21735.67, "timestamp": "06:02:15", "text": "日曜日、土曜日。うん。私たちはいくつかプレイしました"}, {"type": "subtitle", "time": 21738.47, "timestamp": "06:02:18", "text": "カリ・バイユー。ゲームのアップデートを忘れていました。"}, {"type": "subtitle", "time": 21741.07, "timestamp": "06:02:21", "text": "だから、アップデートが"}, {"type": "subtitle", "time": 21745.03, "timestamp": "06:02:25", "text": "終わり。私たちは、えっと、私たちは、"}, {"type": "subtitle", "time": 21748.708, "timestamp": "06:02:28", "text": "それまでのApexとか、そういうのはどうだったんだろう。そして"}, {"type": "subtitle", "time": 21750.47, "timestamp": "06:02:30", "text": "今日の配信では、"}, {"type": "subtitle", "time": 21751.99, "timestamp": "06:02:31", "text": "実は"}, {"type": "subtitle", "time": 21756.83, "timestamp": "06:02:36", "text": "えーっと、プレイしたくなかった"}, {"type": "subtitle", "time": 21759.59, "timestamp": "06:02:39", "text": "流れの波。私はストリーミングしただけです"}, {"type": "subtitle", "time": 21761.99, "timestamp": "06:02:41", "text": "ストリーミング配信を考えた理由は"}, {"type": "subtitle", "time": 21764.39, "timestamp": "06:02:44", "text": "イベントが終わり、最後の配信をすると"}, {"type": "subtitle", "time": 21767.59, "timestamp": "06:02:47", "text": "私たちは一緒にイベントを行うと言いました"}, {"type": "subtitle", "time": 21770.788, "timestamp": "06:02:50", "text": "なくなる前に。いいえ。そうですね、私は"}, {"type": "subtitle", "time": 21773.868, "timestamp": "06:02:53", "text": "実のところ、術をやってみたかっただけ"}, {"type": "subtitle", "time": 21776.31, "timestamp": "06:02:56", "text": "チャット中。私はただ"}, {"type": "subtitle", "time": 21778.788, "timestamp": "06:02:58", "text": "チャットと"}]
[{"type": "subtitle", "time": 2880.63, "timestamp": "00:48:00", "text": "あなた。私は日本語を読むのが遅い。両方"}, {"type": "subtitle", "time": 2883.349, "timestamp": "00:48:03", "text": "ひらがなとカタカナ。そして、それがいつなのか"}, {"type": "subtitle", "time": 2885.95, "timestamp": "00:48:05", "text": "漢字があるけど、スキップする"}, {"type": "subtitle", "time": 2919.91, "timestamp": "00:48:39", "text": "終わり。さよなら。あなたは去っていく。こんにちは。取る"}, {"type": "subtitle", "time": 2931.91, "timestamp": "00:48:51", "text": "ええ、中国ではもうかなり遅い時間です。"}, {"type": "subtitle", "time": 2934.19, "timestamp": "00:48:54", "text": "まるで"}, {"type": "subtitle", "time": 2938.549, "timestamp": "00:48:58", "text": "12. 人々は寝床に向かい、"}]
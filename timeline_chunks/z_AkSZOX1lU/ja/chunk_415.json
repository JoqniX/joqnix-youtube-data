[{"type": "subtitle", "time": 24924.91, "timestamp": "06:55:24", "text": "古い。彼女は毒のあるものを食べて"}, {"type": "subtitle", "time": 24946.788, "timestamp": "06:55:46", "text": "今。彼女は陽気で楽天的なタイプで"}, {"type": "subtitle", "time": 24950.03, "timestamp": "06:55:50", "text": "元気な女の子。"}, {"type": "subtitle", "time": 24952.948, "timestamp": "06:55:52", "text": "アンカーアングル。何？それは何ですか"}, {"type": "subtitle", "time": 24955.47, "timestamp": "06:55:55", "text": "上部全体がちらついている？"}, {"type": "subtitle", "time": 24958.15, "timestamp": "06:55:58", "text": "[音楽]"}]
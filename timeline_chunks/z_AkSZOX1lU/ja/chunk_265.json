[{"type": "subtitle", "time": 15904.229, "timestamp": "04:25:04", "text": "上。何てことだ。この検証。ああ、"}, {"type": "subtitle", "time": 15906.11, "timestamp": "04:25:06", "text": "神。ああ、"}, {"type": "subtitle", "time": 15909.79, "timestamp": "04:25:09", "text": "神。彼は逮捕されなかったの？待って、"}, {"type": "subtitle", "time": 15912.03, "timestamp": "04:25:12", "text": "何？待って、"}, {"type": "subtitle", "time": 15925.71, "timestamp": "04:25:25", "text": "はぁ？え、逮捕されたの？そして"}, {"type": "subtitle", "time": 15930.71, "timestamp": "04:25:30", "text": "待って、ズームすることに対して何が反対なの？"}, {"type": "subtitle", "time": 15942.07, "timestamp": "04:25:42", "text": "だから待って、すべてのペすべての"}, {"type": "subtitle", "time": 15958.429, "timestamp": "04:25:58", "text": "おお。"}]
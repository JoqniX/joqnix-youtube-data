[{"type": "subtitle", "time": 22754.75, "timestamp": "06:19:14", "text": "おお。ああ、その、その、その"}, {"type": "subtitle", "time": 22782.43, "timestamp": "06:19:42", "text": "新しい体制でスタートすることを約束する"}, {"type": "subtitle", "time": 22785.35, "timestamp": "06:19:45", "text": "ああ、もし私が"}, {"type": "subtitle", "time": 22787.27, "timestamp": "06:19:47", "text": "気が散っている。私は"}, {"type": "subtitle", "time": 22797.19, "timestamp": "06:19:57", "text": "[音楽]"}, {"type": "subtitle", "time": 22798.45, "timestamp": "06:19:58", "text": "でも私は"}]
[{"type": "subtitle", "time": 13447.189, "timestamp": "03:44:07", "text": "人々が"}, {"type": "subtitle", "time": 13451.309, "timestamp": "03:44:11", "text": "えーと、人々はOpera GXカレンダーを使っています、"}, {"type": "subtitle", "time": 13470.469, "timestamp": "03:44:30", "text": "私はShroudがゲームをプレイするのを見るのが大好きです。くそ。"}, {"type": "subtitle", "time": 13472.95, "timestamp": "03:44:32", "text": "どうすればShroudのようになれるのでしょうか？私は"}, {"type": "subtitle", "time": 13475.95, "timestamp": "03:44:35", "text": "FPSの天才でなければならない、あるいは"}, {"type": "subtitle", "time": 13480.07, "timestamp": "03:44:40", "text": "何か？どんな遊び方ですか？"}, {"type": "subtitle", "time": 13488.229, "timestamp": "03:44:48", "text": "リビング？これはクラフトゲームです。私はします。"}, {"type": "subtitle", "time": 13493.189, "timestamp": "03:44:53", "text": "『ファイアーエムブレム 覚醒』はまさに私の好みのゲームです。"}, {"type": "subtitle", "time": 13496.67, "timestamp": "03:44:56", "text": "なぜ何でもかんでもやるのが私の好きなゲームタイプなのか？"}, {"type": "subtitle", "time": 13499.15, "timestamp": "03:44:59", "text": "生存 生存"}]
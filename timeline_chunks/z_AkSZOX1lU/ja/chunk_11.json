[{"type": "subtitle", "time": 660.59, "timestamp": "00:11:00", "text": "では、一つずつやっていきましょう。"}, {"type": "subtitle", "time": 663.71, "timestamp": "00:11:03", "text": "信じる。わかった。もっと大きな音量でストリーミング再生してください。だから私たちは"}, {"type": "subtitle", "time": 669.11, "timestamp": "00:11:09", "text": "たぶん5回かな。これは完了しましたか？"}, {"type": "subtitle", "time": 671.509, "timestamp": "00:11:11", "text": "よし、5つのクリップをアップロードする頃には、"}, {"type": "subtitle", "time": 675.03, "timestamp": "00:11:15", "text": "その件は、おそらく間もなく解決するだろう。"}, {"type": "subtitle", "time": 677.79, "timestamp": "00:11:17", "text": "ええ、大丈夫です。その"}, {"type": "subtitle", "time": 681.389, "timestamp": "00:11:21", "text": "大丈夫。 １、２、３、４、"}, {"type": "subtitle", "time": 687.39, "timestamp": "00:11:27", "text": "わかった。初め"}, {"type": "subtitle", "time": 689.71, "timestamp": "00:11:29", "text": "[音楽]"}, {"type": "subtitle", "time": 693.269, "timestamp": "00:11:33", "text": "1つ。次に、すべてが"}, {"type": "subtitle", "time": 696.069, "timestamp": "00:11:36", "text": "手元カメラの配信みたいに。見せてください"}, {"type": "subtitle", "time": 698.03, "timestamp": "00:11:38", "text": "それ。"}, {"type": "subtitle", "time": 703.15, "timestamp": "00:11:43", "text": "しかしインスタントコーヒーは100％純粋です"}, {"type": "subtitle", "time": 705.75, "timestamp": "00:11:45", "text": "コーヒーは良くない。使いたくない"}, {"type": "subtitle", "time": 715.35, "timestamp": "00:11:55", "text": "たくさん。私はこれを覚えています。ああ、"}, {"type": "subtitle", "time": 718.47, "timestamp": "00:11:58", "text": "今日はカメラによる罰ゲームです。"}]
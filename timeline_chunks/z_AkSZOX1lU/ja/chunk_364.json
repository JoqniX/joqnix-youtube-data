[{"type": "subtitle", "time": 21840.35, "timestamp": "06:04:00", "text": "今日は波に乗る準備万端だ。"}, {"type": "subtitle", "time": 21846.59, "timestamp": "06:04:06", "text": "うん。えっと、私の配信PCがダウンしています。"}, {"type": "subtitle", "time": 21850.07, "timestamp": "06:04:10", "text": "いいえ、どうやって開けるのですか"}, {"type": "subtitle", "time": 21853.868, "timestamp": "06:04:13", "text": "翻訳ソフト？ O"}, {"type": "subtitle", "time": 21856.99, "timestamp": "06:04:16", "text": "ええ、有効です"}, {"type": "subtitle", "time": 21860.75, "timestamp": "06:04:20", "text": "遅れ。えっと、私がやってみましょう。"}, {"type": "subtitle", "time": 21863.19, "timestamp": "06:04:23", "text": "もちろんラグは発生するだろうが、"}, {"type": "subtitle", "time": 21864.59, "timestamp": "06:04:24", "text": "病気"}, {"type": "subtitle", "time": 21870.83, "timestamp": "06:04:30", "text": "右。全体を遅らせないでください"}, {"type": "subtitle", "time": 21878.03, "timestamp": "06:04:38", "text": "CPU。"}, {"type": "subtitle", "time": 21882.23, "timestamp": "06:04:42", "text": "ああ、ラグですね。フレーム数を数えられますか？"}, {"type": "subtitle", "time": 21886.03, "timestamp": "06:04:46", "text": "わかった、私がどれだけ遅いか数えられる？"}]
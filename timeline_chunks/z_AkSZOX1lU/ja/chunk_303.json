[{"type": "subtitle", "time": 18180.15, "timestamp": "05:03:00", "text": "それは私が担当します。私は、えっと、まだ"}, {"type": "subtitle", "time": 18182.47, "timestamp": "05:03:02", "text": "配信後にはやらなきゃいけないことがあるよね？"}, {"type": "subtitle", "time": 18185.35, "timestamp": "05:03:05", "text": "アンリアルな話。私はちょっとそうしたい"}, {"type": "subtitle", "time": 18188.55, "timestamp": "05:03:08", "text": "クリエイティブなものをストリーミング配信する。あなた"}, {"type": "subtitle", "time": 18194.47, "timestamp": "05:03:14", "text": "えっと、4つ以上は行けないんです"}, {"type": "subtitle", "time": 18197.35, "timestamp": "05:03:17", "text": "夜間の数時間。朝には、"}, {"type": "subtitle", "time": 18208.31, "timestamp": "05:03:28", "text": "推測。一体どういうことだ？今蹴ったの？"}, {"type": "subtitle", "time": 18232.03, "timestamp": "05:03:52", "text": "来る"}, {"type": "subtitle", "time": 18235.59, "timestamp": "05:03:55", "text": "の上。待って。彼はGを持っているのか？ああ、彼は"}]
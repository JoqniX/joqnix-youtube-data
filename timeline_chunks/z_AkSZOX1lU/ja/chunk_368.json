[{"type": "subtitle", "time": 22083.948, "timestamp": "06:08:03", "text": "えっと、私はそうすべきだと思う"}, {"type": "subtitle", "time": 22087.35, "timestamp": "06:08:07", "text": "新規ユーザー向けです。いいえ、彼らはこうなります"}, {"type": "subtitle", "time": 22090.23, "timestamp": "06:08:10", "text": "アンカーはなぜストリーマーなのか"}, {"type": "subtitle", "time": 22099.43, "timestamp": "06:08:19", "text": "ああ、そうするべきだろうね。 1つ"}, {"type": "subtitle", "time": 22103.07, "timestamp": "06:08:23", "text": "2番。わかった。えっと、私は"}, {"type": "subtitle", "time": 22107.15, "timestamp": "06:08:27", "text": "こういうことを忘れてしまう。私は必要としている"}, {"type": "subtitle", "time": 22111.23, "timestamp": "06:08:31", "text": "君に、私は自分の"}, {"type": "subtitle", "time": 22114.48, "timestamp": "06:08:34", "text": "画面。ちょっと待って。"}, {"type": "subtitle", "time": 22118.35, "timestamp": "06:08:38", "text": "[音楽]"}, {"type": "subtitle", "time": 22127.11, "timestamp": "06:08:47", "text": "翻訳する。私が中国語を話せば、あなたは"}, {"type": "subtitle", "time": 22130.03, "timestamp": "06:08:50", "text": "理解できましたか？いいえ、私はGoogle翻訳を使っています"}, {"type": "subtitle", "time": 22135.31, "timestamp": "06:08:55", "text": "それ。私はコメントをGoogle翻訳します。"}, {"type": "subtitle", "time": 22138.47, "timestamp": "06:08:58", "text": "うん。うん。うん。それが私の仕事です。それで、"}]
[{"type": "subtitle", "time": 17521.03, "timestamp": "04:52:01", "text": "待って。彼らはチームメイトだ。わかった。"}, {"type": "subtitle", "time": 17556.708, "timestamp": "04:52:36", "text": "あと少しで捕まえられそうだった。ああ、彼は私を蘇生させてくれなかった。"}, {"type": "subtitle", "time": 17559.99, "timestamp": "04:52:39", "text": "おい、何だって？待って、彼は私を蘇らせたんだ。"}, {"type": "subtitle", "time": 17561.31, "timestamp": "04:52:41", "text": "感謝"}, {"type": "subtitle", "time": 17577.27, "timestamp": "04:52:57", "text": "カバカ？さあ、やってみよう。"}]
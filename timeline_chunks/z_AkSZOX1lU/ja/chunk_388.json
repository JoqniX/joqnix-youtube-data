[{"type": "subtitle", "time": 23280.67, "timestamp": "06:28:00", "text": "推測。"}, {"type": "subtitle", "time": 23282.42, "timestamp": "06:28:02", "text": "ショートカット。"}, {"type": "subtitle", "time": 23286.03, "timestamp": "06:28:06", "text": "[音楽]"}, {"type": "subtitle", "time": 23289.27, "timestamp": "06:28:09", "text": "おお。何てことだ。これはすごくクールだ。"}, {"type": "subtitle", "time": 23292.548, "timestamp": "06:28:12", "text": "私は本当にどこかを訪れてみたいです"}, {"type": "subtitle", "time": 23295.19, "timestamp": "06:28:15", "text": "そこには文字通り滝がある"}, {"type": "subtitle", "time": 23298.628, "timestamp": "06:28:18", "text": "落ちていくと、あなたはただ"}, {"type": "subtitle", "time": 23300.788, "timestamp": "06:28:20", "text": "えーと滝の裏には"}, {"type": "subtitle", "time": 23303.75, "timestamp": "06:28:23", "text": "好きな場所、そう、まるで"}, {"type": "subtitle", "time": 23306.39, "timestamp": "06:28:26", "text": "隠れた場所とか、そういうところ。それはまさに"}, {"type": "subtitle", "time": 23309.91, "timestamp": "06:28:29", "text": "かっこよくて、可愛くて、すごくかっこいい。それは"}, {"type": "subtitle", "time": 23310.99, "timestamp": "06:28:30", "text": "それで"}, {"type": "subtitle", "time": 23317.51, "timestamp": "06:28:37", "text": "うん。はい。はい。ぜひ行きたいです"}, {"type": "subtitle", "time": 23333.19, "timestamp": "06:28:53", "text": "そこには。そうそう。それは、待って、"}, {"type": "subtitle", "time": 23336.91, "timestamp": "06:28:56", "text": "花。なぜヴェリナのように見えるのか"}]
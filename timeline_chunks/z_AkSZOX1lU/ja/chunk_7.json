[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "ええと、疲労です。私はそうするべきだと思う"}, {"type": "subtitle", "time": 422.87, "timestamp": "00:07:02", "text": "それを呼ぶ"}, {"type": "subtitle", "time": 424.35, "timestamp": "00:07:04", "text": "いや"}, {"type": "subtitle", "time": 429.029, "timestamp": "00:07:09", "text": "ストリーム。ああ、私は言う"}, {"type": "subtitle", "time": 432.11, "timestamp": "00:07:12", "text": "ええ、疲労のため、"}, {"type": "subtitle", "time": 435.029, "timestamp": "00:07:15", "text": "物、私は罪悪感を感じています"}, {"type": "subtitle", "time": 439.87, "timestamp": "00:07:19", "text": "VODと、そこにいないことを残しておく"}, {"type": "subtitle", "time": 443.589, "timestamp": "00:07:23", "text": "ストリーム。でも、本当にそうなりたい"}, {"type": "subtitle", "time": 445.909, "timestamp": "00:07:25", "text": "少なくとも12時間連続でここにいる、"}, {"type": "subtitle", "time": 448.189, "timestamp": "00:07:28", "text": "男。"}, {"type": "subtitle", "time": 452.27, "timestamp": "00:07:32", "text": "ああ、長々と書いてしまって申し訳ない気持ちだ"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "休憩はいいえ、私はこれをずっとやってきました"}, {"type": "subtitle", "time": 458.30899999999997, "timestamp": "00:07:38", "text": "もう何ヶ月くらい経ったかな？それは"}, {"type": "subtitle", "time": 465.589, "timestamp": "00:07:45", "text": "すぐ。 10から11。それは小さい。"}, {"type": "subtitle", "time": 468.87, "timestamp": "00:07:48", "text": "もう数時間経ちました。ああ、忘れてた。ええ、今"}, {"type": "subtitle", "time": 472.39, "timestamp": "00:07:52", "text": "私は毎日24時間ストリーミング配信しています。"}, {"type": "subtitle", "time": 478.469, "timestamp": "00:07:58", "text": "10時間から11時間というのは、私にとっては短いように思えます。"}]
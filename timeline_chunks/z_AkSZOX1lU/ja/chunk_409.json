[{"type": "subtitle", "time": 24546.23, "timestamp": "06:49:06", "text": "待って、スーパーチャットみたいなものか、それとも"}, {"type": "subtitle", "time": 24558.43, "timestamp": "06:49:18", "text": "何？これは何ですか？えっと、それは"}, {"type": "subtitle", "time": 24573.708, "timestamp": "06:49:33", "text": "ティファ？でも、ありがとう"}, {"type": "subtitle", "time": 24575.99, "timestamp": "06:49:35", "text": "それ。ああ、忘れてたよ"}, {"type": "subtitle", "time": 24579.23, "timestamp": "06:49:39", "text": "文字通りスーパーチャットで"}, {"type": "subtitle", "time": 24582.468, "timestamp": "06:49:42", "text": "これ。うん、じゃあね。それはすごくクールだね。によって"}, {"type": "subtitle", "time": 24589.708, "timestamp": "06:49:49", "text": "[音楽]"}, {"type": "subtitle", "time": 24594.5, "timestamp": "06:49:54", "text": "ところで、あそこにあるあれは何？"}, {"type": "subtitle", "time": 24596.31, "timestamp": "06:49:56", "text": "[音楽]"}]
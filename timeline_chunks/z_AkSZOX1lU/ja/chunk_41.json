[{"type": "subtitle", "time": 2466.72, "timestamp": "00:41:06", "text": "下"}, {"type": "subtitle", "time": 2472.589, "timestamp": "00:41:12", "text": "[音楽]"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "私は完全な英語を書くことができません"}, {"type": "subtitle", "time": 2478.15, "timestamp": "00:41:18", "text": "文。彼は中国語でタイピングできます。いいえ"}, {"type": "subtitle", "time": 2481.43, "timestamp": "00:41:21", "text": "心配事。えーと、20語の、えーと20"}, {"type": "subtitle", "time": 2484.33, "timestamp": "00:41:24", "text": "文字数制限ができました。だから彼はそれを入力できない"}, {"type": "subtitle", "time": 2485.87, "timestamp": "00:41:25", "text": "[音楽]"}, {"type": "subtitle", "time": 2488.95, "timestamp": "00:41:28", "text": "英語。ええと、そのソフトウェアは推奨されました"}, {"type": "subtitle", "time": 2493.309, "timestamp": "00:41:33", "text": "私にとって。ああ、なんて"}, {"type": "subtitle", "time": 2499.39, "timestamp": "00:41:39", "text": "私は自分が"}, {"type": "subtitle", "time": 2501.069, "timestamp": "00:41:41", "text": "2日間"}, {"type": "subtitle", "time": 2506.589, "timestamp": "00:41:46", "text": "私がいない最終"}, {"type": "subtitle", "time": 2508.109, "timestamp": "00:41:48", "text": "えーと"}]
[{"type": "subtitle", "time": 14821.59, "timestamp": "04:07:01", "text": "25日目。いいえ。一昨日です。私"}, {"type": "subtitle", "time": 14823.59, "timestamp": "04:07:03", "text": "つまり、ある意味では、技術的にはまだ"}, {"type": "subtitle", "time": 14826.63, "timestamp": "04:07:06", "text": "日付は今4時45分です。なぜなら私は"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "日付45ストリーム。しかし今日に至るまで、つまり、"}, {"type": "subtitle", "time": 14847.69, "timestamp": "04:07:27", "text": "うん。"}, {"type": "subtitle", "time": 14874.39, "timestamp": "04:07:54", "text": "そのため。"}, {"type": "subtitle", "time": 14877.429, "timestamp": "04:07:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 9841.349, "timestamp": "02:44:01", "text": "あれ。サバイバルクラフトタイプ。忘れた"}, {"type": "subtitle", "time": 9842.429, "timestamp": "02:44:02", "text": "の"}, {"type": "subtitle", "time": 9846.15, "timestamp": "02:44:06", "text": "名前。それは一体何なのか？おい、人々は"}, {"type": "subtitle", "time": 9848.75, "timestamp": "02:44:08", "text": "マラソンをプレイする。遊びたい"}, {"type": "subtitle", "time": 9852.51, "timestamp": "02:44:12", "text": "マラソンだよ、兄弟。与える"}, {"type": "subtitle", "time": 9853.8, "timestamp": "02:44:13", "text": "自分"}, {"type": "subtitle", "time": 9855.71, "timestamp": "02:44:15", "text": "[音楽]"}, {"type": "subtitle", "time": 9868.03, "timestamp": "02:44:28", "text": "おお。フォールアウトニュー"}, {"type": "subtitle", "time": 9871.59, "timestamp": "02:44:31", "text": "ベガス。ああ、見て。シルはスケジュールをこなしている"}, {"type": "subtitle", "time": 9875.03, "timestamp": "02:44:35", "text": "1つ。演奏に戻るべきでしょうか"}, {"type": "subtitle", "time": 9877.79, "timestamp": "02:44:37", "text": "スケジュールを組む？私は感じる"}, {"type": "subtitle", "time": 9881.07, "timestamp": "02:44:41", "text": "これ以上のゲームはない"}, {"type": "subtitle", "time": 9884.19, "timestamp": "02:44:44", "text": "それ。なんだか"}, {"type": "subtitle", "time": 9887.11, "timestamp": "02:44:47", "text": "退屈になった。そこが問題なんです。待って、"}, {"type": "subtitle", "time": 9891.51, "timestamp": "02:44:51", "text": "タロフ・アリーナからの脱出があります。何？"}, {"type": "subtitle", "time": 9896.51, "timestamp": "02:44:56", "text": "外？"}, {"type": "chat", "time": 9897.604, "timestamp": "02:44:57", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yea"}, {"type": "subtitle", "time": 9899.79, "timestamp": "02:44:59", "text": "何？それは来た"}]
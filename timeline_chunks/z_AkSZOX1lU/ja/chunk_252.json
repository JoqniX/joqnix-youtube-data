[{"type": "subtitle", "time": 15121.87, "timestamp": "04:12:01", "text": "そして文書と"}, {"type": "subtitle", "time": 15129.03, "timestamp": "04:12:09", "text": "痛み。これは何ですか？私たちは社会に生きている"}, {"type": "subtitle", "time": 15132.83, "timestamp": "04:12:12", "text": "あれ。私はそれが嫌いです。なぜ？なぜできないのか"}, {"type": "subtitle", "time": 15136.03, "timestamp": "04:12:16", "text": "独立した？何が"}, {"type": "subtitle", "time": 15140.03, "timestamp": "04:12:20", "text": "これ？それは別の話題です。私はしません"}, {"type": "subtitle", "time": 15157.07, "timestamp": "04:12:37", "text": "[音楽]"}, {"type": "subtitle", "time": 15159.83, "timestamp": "04:12:39", "text": "典型的な医学クラス出身なので痛みを感じます"}, {"type": "subtitle", "time": 15161.87, "timestamp": "04:12:41", "text": "私たちはそれをやらなければならない。"}, {"type": "subtitle", "time": 15166.269, "timestamp": "04:12:46", "text": "うん。記録を数多く書き記す"}, {"type": "subtitle", "time": 15169.55, "timestamp": "04:12:49", "text": "プロジェクトやたくさんの"}, {"type": "subtitle", "time": 15176.03, "timestamp": "04:12:56", "text": "男の子。あなたは大変ですね"}]
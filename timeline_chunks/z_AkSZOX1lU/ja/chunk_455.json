[{"type": "subtitle", "time": 27303.35, "timestamp": "07:35:03", "text": "[音楽]"}, {"type": "subtitle", "time": 27310.43, "timestamp": "07:35:10", "text": "アンコ。あ、待って。私たちは"}, {"type": "subtitle", "time": 27314.07, "timestamp": "07:35:14", "text": "ああ、それはすごくクールですね。待って。何をすればいいですか"}, {"type": "subtitle", "time": 27322.15, "timestamp": "07:35:22", "text": "彼女？ああ、大変だ。私は死にかけている。"}, {"type": "subtitle", "time": 27335.07, "timestamp": "07:35:35", "text": "お前。 Eは何をしますか？おお、"}, {"type": "subtitle", "time": 27338.788, "timestamp": "07:35:38", "text": "うわー、それはすごいですね。待って、私は農業をしたい"}, {"type": "subtitle", "time": 27356.19, "timestamp": "07:35:56", "text": "わかった。"}, {"type": "subtitle", "time": 27359.03, "timestamp": "07:35:59", "text": "究極の。彼女は正気を失いかけている。おお、"}]
[{"type": "subtitle", "time": 27004.03, "timestamp": "07:30:04", "text": "赤。"}, {"type": "subtitle", "time": 27011.23, "timestamp": "07:30:11", "text": "そこには"}, {"type": "subtitle", "time": 27014.27, "timestamp": "07:30:14", "text": "そして私たちは"}, {"type": "subtitle", "time": 27017.99, "timestamp": "07:30:17", "text": "これをそこに置くんだ。ああ、それはまるで"}, {"type": "subtitle", "time": 27019.628, "timestamp": "07:30:19", "text": "これ。"}, {"type": "subtitle", "time": 27033.35, "timestamp": "07:30:33", "text": "大丈夫。どういうわけか、私のVerinaは"}, {"type": "subtitle", "time": 27036.11, "timestamp": "07:30:36", "text": "大した被害は出ていない。私は気づいた"}, {"type": "subtitle", "time": 27041.43, "timestamp": "07:30:41", "text": "最近。私の"}, {"type": "subtitle", "time": 27044.868, "timestamp": "07:30:44", "text": "うーん、叫び声がさらに大きくなった。私は気づきました"}, {"type": "subtitle", "time": 27046.468, "timestamp": "07:30:46", "text": "それ"}, {"type": "subtitle", "time": 27049.91, "timestamp": "07:30:49", "text": "アリーナは、あまり強くなくなってきた。私"}]
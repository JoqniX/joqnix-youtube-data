[{"type": "subtitle", "time": 23104.67, "timestamp": "06:25:04", "text": "わかった。リンス。わかった。こんにちは、"}, {"type": "subtitle", "time": 23106.948, "timestamp": "06:25:06", "text": "おばあちゃん。彼女は"}, {"type": "subtitle", "time": 23110.27, "timestamp": "06:25:10", "text": "[音楽]"}, {"type": "subtitle", "time": 23114.35, "timestamp": "06:25:14", "text": "若い。おお。若くはないが、"}, {"type": "subtitle", "time": 23119.628, "timestamp": "06:25:19", "text": "成熟した。うん。白髪はほんの少しだけ。"}, {"type": "subtitle", "time": 23123.19, "timestamp": "06:25:23", "text": "うん。彼女を大人っぽく見せる。うん。"}, {"type": "subtitle", "time": 23139.07, "timestamp": "06:25:39", "text": "ブレイク・ブルームを彼女に見せてあげて"}, {"type": "subtitle", "time": 23141.23, "timestamp": "06:25:41", "text": "写真。"}, {"type": "subtitle", "time": 23143.74, "timestamp": "06:25:43", "text": "うん。願わくば"}]
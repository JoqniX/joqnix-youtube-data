[{"type": "subtitle", "time": 10202.15, "timestamp": "02:50:02", "text": "ボス？彼女はまるで母親のようで、"}, {"type": "chat", "time": 10203.512, "timestamp": "02:50:03", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "kojima was there on original"}, {"type": "subtitle", "time": 10203.99, "timestamp": "02:50:03", "text": "マスター。"}, {"type": "subtitle", "time": 10210.67, "timestamp": "02:50:10", "text": "聞こえますか？"}, {"type": "subtitle", "time": 10214.309, "timestamp": "02:50:14", "text": "私、スネーク？"}, {"type": "subtitle", "time": 10217.51, "timestamp": "02:50:17", "text": "私たちはボスの息子たちです。"}, {"type": "chat", "time": 10217.98, "timestamp": "02:50:17", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but, we all known wut happened to him"}, {"type": "subtitle", "time": 10221.51, "timestamp": "02:50:21", "text": "分かりますよ。恐怖。"}, {"type": "subtitle", "time": 10223.67, "timestamp": "02:50:23", "text": "何てことだ。"}, {"type": "subtitle", "time": 10228.11, "timestamp": "02:50:28", "text": "生きていることへの激しい怒り。多数の"}, {"type": "subtitle", "time": 10231.91, "timestamp": "02:50:31", "text": "悲しみ。そして、あなたもその一人です。なぜ'"}, {"type": "subtitle", "time": 10234.429, "timestamp": "02:50:34", "text": "戻ってくるの？あなたには何もありません"}, {"type": "subtitle", "time": 10236.95, "timestamp": "02:50:36", "text": "ここ。家に帰れ。"}, {"type": "subtitle", "time": 10239.91, "timestamp": "02:50:39", "text": "上司のところに戻ってください。"}, {"type": "subtitle", "time": 10242.75, "timestamp": "02:50:42", "text": "でも私はまだシャドウホッドと"}, {"type": "subtitle", "time": 10245.75, "timestamp": "02:50:45", "text": "遺産。アメリカには何もできない"}, {"type": "subtitle", "time": 10248.76, "timestamp": "02:50:48", "text": "我々を止めるために何をするのか。"}, {"type": "subtitle", "time": 10251.83, "timestamp": "02:50:51", "text": "[音楽]"}, {"type": "subtitle", "time"
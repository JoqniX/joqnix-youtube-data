[{"type": "subtitle", "time": 21423.31, "timestamp": "05:57:03", "text": "神。ああ、それは死にかけている。私"}, {"type": "subtitle", "time": 21426.91, "timestamp": "05:57:06", "text": "知る。どうやら、あまりにも多くのことを実行しているようだ。"}, {"type": "subtitle", "time": 21430.788, "timestamp": "05:57:10", "text": "実は。ああ、まずい。悪い。"}, {"type": "subtitle", "time": 21435.19, "timestamp": "05:57:15", "text": "わかった。だから、今日は新しい"}, {"type": "subtitle", "time": 21439.51, "timestamp": "05:57:19", "text": "実は新しいものを試しているところなんです。えっと、私は"}, {"type": "subtitle", "time": 21443.07, "timestamp": "05:57:23", "text": "全てがうまくいくことを願っています。私はそう願っています"}, {"type": "subtitle", "time": 21446.868, "timestamp": "05:57:26", "text": "聞こえる。えーっと、もしあなたが"}, {"type": "subtitle", "time": 21449.31, "timestamp": "05:57:29", "text": "私の声を体験しているなら、"}, {"type": "subtitle", "time": 21453.708, "timestamp": "05:57:33", "text": "ラグやそれに類するもの、"}, {"type": "subtitle", "time": 21457.23, "timestamp": "05:57:37", "text": "ぜひ教えてください。わかった。"}, {"type": "subtitle", "time": 21460.83, "timestamp": "05:57:40", "text": "ええ、そうですね。ぜひ教えてください"}, {"type": "subtitle", "time": 21464.708, "timestamp": "05:57:44", "text": "自分。直してみます。わかった。私が試してみます"}, {"type": "subtitle", "time": 21466.83, "timestamp": "05:57:46", "text": "私のベスト。私は最善を尽くそうとしています。それは"}, {"type": "subtitle", "time": 21469.83, "timestamp": "05:57:49", "text": "わかった？最善を尽くします。私は試してみます"}, {"type": "subtitle", "time": 21472.708, "timestamp": "05:57:52", "text": "最高。それでよろしいですか？最善を尽くします。"}, {"type": "subtitle", "time": 21474.948, "timestamp": "05:57:54", "text": "全力を尽くします。それでよろしいですか？"}, {"type": "subtitle", "time": 21476.11, "timestamp": "05:57:56", "text": "私は試してみます"}, {"type": "subtitle", "time": 21477.948, "timestamp": "05:57:57", "text": "最高。は"}]
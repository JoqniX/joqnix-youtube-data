[{"type": "subtitle", "time": 15660.63, "timestamp": "04:21:00", "text": "もの。ほとんどの場合、私は"}, {"type": "subtitle", "time": 15663.99, "timestamp": "04:21:03", "text": "ああ、アプローチするために近づかないでください"}, {"type": "subtitle", "time": 15666.75, "timestamp": "04:21:06", "text": "コラボレーションのため。私はただそれをしただけです"}, {"type": "subtitle", "time": 15670.79, "timestamp": "04:21:10", "text": "1、2回以外は"}, {"type": "subtitle", "time": 15673.59, "timestamp": "04:21:13", "text": "やってみて。ほとんどの場合、人々はやって来ます"}, {"type": "subtitle", "time": 15674.59, "timestamp": "04:21:14", "text": "に"}, {"type": "subtitle", "time": 15678.469, "timestamp": "04:21:18", "text": "自分。だから、私が連絡を取るなら、"}, {"type": "subtitle", "time": 15681.67, "timestamp": "04:21:21", "text": "その人のことをよく知る、ということですよね？それもまた"}, {"type": "subtitle", "time": 15684.71, "timestamp": "04:21:24", "text": "私が絶対にやりたくないことは、"}, {"type": "subtitle", "time": 15687.83, "timestamp": "04:21:27", "text": "コラボレーション。私は誰のことか知っているはずだ"}, {"type": "subtitle", "time": 15691.51, "timestamp": "04:21:31", "text": "私は対処し、一緒にいて、"}, {"type": "subtitle", "time": 15694.469, "timestamp": "04:21:34", "text": "一緒に時間を過ごしたり、良い雰囲気を共有したりする。どのようにどのように"}, {"type": "subtitle", "time": 15697.51, "timestamp": "04:21:37", "text": "彼らは私の雰囲気を楽しんでくれるだろうか、そして私たちの"}, {"type": "subtitle", "time": 15702.469, "timestamp": "04:21:42", "text": "雰囲気が繋がって、ああとかそういう感じになる？する"}, {"type": "subtitle", "time": 15705.67, "timestamp": "04:21:45", "text": "ooチェック。"}, {"type": "subtitle", "time": 15707.429, "timestamp": "04:21:47", "text": "Epic Gamesで何かオファーがありました"}, {"type": "subtitle", "time": 15711.51, "timestamp": "04:21:51", "text": "先週。そうそう。えっと、トゥームレイダー。"}, {"type": "subtitle", "time": 15714.91, "timestamp": "04:21:54", "text": "トゥームレイダーの3人"}, {"type": "subtitle", "time": 15718.59, "timestamp": "04:21:58", "text": "無料でプレイできるゲーム"}]
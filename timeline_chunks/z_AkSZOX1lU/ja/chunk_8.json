[{"type": "subtitle", "time": 481.67, "timestamp": "00:08:01", "text": "でも、そう、私が日本にいるときは"}, {"type": "subtitle", "time": 483.83, "timestamp": "00:08:03", "text": "7月以降は配信できないと思います"}, {"type": "subtitle", "time": 484.99, "timestamp": "00:08:04", "text": "このような"}, {"type": "subtitle", "time": 487.67, "timestamp": "00:08:07", "text": "もう。少なくとも2年間は、"}, {"type": "subtitle", "time": 491.43, "timestamp": "00:08:11", "text": "こんな感じで配信します。ストリーミングしかできません"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "夜、私が暇な時に。だから"}, {"type": "subtitle", "time": 502.15, "timestamp": "00:08:22", "text": "残念ながら、それは最悪だ。だから私は行く"}, {"type": "subtitle", "time": 505.35, "timestamp": "00:08:25", "text": "持っている時間をすべて使う"}, {"type": "subtitle", "time": 507.55, "timestamp": "00:08:27", "text": "まで"}, {"type": "subtitle", "time": 510.629, "timestamp": "00:08:30", "text": "しかし、私たちがそうするのは、"}, {"type": "subtitle", "time": 514.7090000000001, "timestamp": "00:08:34", "text": "ジョッカソンは、私が貯金しているから、そして"}, {"type": "subtitle", "time": 516.75, "timestamp": "00:08:36", "text": "このサブマラソンをやっているのは"}, {"type": "subtitle", "time": 520.829, "timestamp": "00:08:40", "text": "新モデルIの資金調達のため"}, {"type": "subtitle", "time": 529.91, "timestamp": "00:08:49", "text": "そう、私はいつも闇は純粋だと言ってきた"}, {"type": "subtitle", "time": 532.71, "timestamp": "00:08:52", "text": "そしてそう言う。「うん」。"}, {"type": "subtitle", "time": 535.59, "timestamp": "00:08:55", "text": "あら、どうしたの？何？何をしたの？"}]
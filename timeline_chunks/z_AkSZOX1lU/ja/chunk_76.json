[{"type": "subtitle", "time": 4567.51, "timestamp": "01:16:07", "text": "わかった。あの細い光る弧を見てください"}, {"type": "subtitle", "time": 4570.07, "timestamp": "01:16:10", "text": "手がかりを示している？もしあなたが既に"}, {"type": "subtitle", "time": 4572.55, "timestamp": "01:16:12", "text": "動物の追跡には、すべて物理的な痕跡が用いられる。"}, {"type": "subtitle", "time": 4575.83, "timestamp": "01:16:15", "text": "ドームははるかに大きくなるだろう。行く"}, {"type": "subtitle", "time": 4578.189, "timestamp": "01:16:18", "text": "最初のトラックでは、"}, {"type": "subtitle", "time": 4581.43, "timestamp": "01:16:21", "text": "違い。 ID追跡服のような"}, {"type": "subtitle", "time": 4584.07, "timestamp": "01:16:24", "text": "足跡、[ __ ]、寝床、または音"}, {"type": "subtitle", "time": 4586.149, "timestamp": "01:16:26", "text": "トラッキングスキルを向上させるには"}, {"type": "subtitle", "time": 4587.75, "timestamp": "01:16:27", "text": "詳細をお伝えし、"}, {"type": "subtitle", "time": 4590.709, "timestamp": "01:16:30", "text": "トラックからの情報としてスキル"}, {"type": "subtitle", "time": 4592.39, "timestamp": "01:16:32", "text": "増加する。発見と射撃は"}, {"type": "subtitle", "time": 4594.709, "timestamp": "01:16:34", "text": "あなたの他の主なスキルは、"}, {"type": "subtitle", "time": 4596.709, "timestamp": "01:16:36", "text": "それらをフォローし始めましょう。"}, {"type": "subtitle", "time": 4619.229, "timestamp": "01:16:59", "text": "追跡"}]
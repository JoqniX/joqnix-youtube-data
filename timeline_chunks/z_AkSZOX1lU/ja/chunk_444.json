[{"type": "subtitle", "time": 26640.35, "timestamp": "07:24:00", "text": "うん、彼女に少しあげるよ"}, {"type": "subtitle", "time": 26646.548, "timestamp": "07:24:06", "text": "反響。私は中国語でアイスクリームと言いました。それ"}, {"type": "subtitle", "time": 26655.07, "timestamp": "07:24:15", "text": "ヨーグルト。ええ、翻訳ってそういうものですよね。"}, {"type": "subtitle", "time": 26663.788, "timestamp": "07:24:23", "text": "自分。わかった。待って。"}, {"type": "subtitle", "time": 26668.708, "timestamp": "07:24:28", "text": "えっと、それで私は全部手に入れました"}, {"type": "subtitle", "time": 26672.03, "timestamp": "07:24:32", "text": "小さな文字。だから私は"}, {"type": "subtitle", "time": 26673.948, "timestamp": "07:24:33", "text": "ラン、私たちは"}, {"type": "subtitle", "time": 26675.708, "timestamp": "07:24:35", "text": "アンカ、"}, {"type": "subtitle", "time": 26680.35, "timestamp": "07:24:40", "text": "ガヴァリナ、そして他に誰がいる？コウキ"}, {"type": "subtitle", "time": 26684.31, "timestamp": "07:24:44", "text": "シーケンス6となった。完全にロックを解除しました"}, {"type": "subtitle", "time": 26689.15, "timestamp": "07:24:49", "text": "彼女。おお、いいね。信じられなかった。しかし"}, {"type": "subtitle", "time": 26694.03, "timestamp": "07:24:54", "text": "うん、アルトはかなり良いよ"}, {"type": "subtitle", "time": 26696.788, "timestamp": "07:24:56", "text": "良い。この時点で、私は"}]
[{"type": "subtitle", "time": 18483.948, "timestamp": "05:08:03", "text": "ああ、私はとても"}, {"type": "subtitle", "time": 18485.788, "timestamp": "05:08:05", "text": "近い。"}, {"type": "subtitle", "time": 18491.628, "timestamp": "05:08:11", "text": "いいえ。"}, {"type": "subtitle", "time": 18494.47, "timestamp": "05:08:14", "text": "ウィンク。はい、インストールが完了しました。これは"}, {"type": "subtitle", "time": 18529.39, "timestamp": "05:08:49", "text": "暗い。何てことだ。私"}, {"type": "subtitle", "time": 18536.628, "timestamp": "05:08:56", "text": "待って。彼はゆっくりとしたペースで進んでいる。待って、"}, {"type": "subtitle", "time": 18538.27, "timestamp": "05:08:58", "text": "銃は何"}]
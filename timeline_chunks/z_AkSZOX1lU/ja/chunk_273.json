[{"type": "subtitle", "time": 16380.83, "timestamp": "04:33:00", "text": "他のメタデータと"}, {"type": "subtitle", "time": 16384.349, "timestamp": "04:33:04", "text": "一つですが、それは"}, {"type": "subtitle", "time": 16419.47, "timestamp": "04:33:39", "text": "いいえ、"}, {"type": "subtitle", "time": 16427.429, "timestamp": "04:33:47", "text": "あと何回走るか。私たちには共通点があります"}, {"type": "subtitle", "time": 16429.99, "timestamp": "04:33:49", "text": "ゴール。民間人と警備員は立つことができる"}, {"type": "subtitle", "time": 16434.23, "timestamp": "04:33:54", "text": "並んで。夕方に手伝う"}, {"type": "subtitle", "time": 16435.869, "timestamp": "04:33:55", "text": "何"}, {"type": "subtitle", "time": 16438.39, "timestamp": "04:33:58", "text": "パカ、それで、えっと、あなたのスケジュールは？"}]
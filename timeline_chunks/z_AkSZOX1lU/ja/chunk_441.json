[{"type": "subtitle", "time": 26460.31, "timestamp": "07:21:00", "text": "彼女からそれを取り上げて。そして、私は"}, {"type": "subtitle", "time": 26462.35, "timestamp": "07:21:02", "text": "これも入手してください。なぜ"}, {"type": "subtitle", "time": 26472.788, "timestamp": "07:21:12", "text": "何？今武器を手に入れれば、"}, {"type": "subtitle", "time": 26474.75, "timestamp": "07:21:14", "text": "とても幸せです、"}, {"type": "subtitle", "time": 26477.39, "timestamp": "07:21:17", "text": "男。"}, {"type": "subtitle", "time": 26499.31, "timestamp": "07:21:39", "text": "行く。ニース。それは"}, {"type": "subtitle", "time": 26516.03, "timestamp": "07:21:56", "text": "その"}, {"type": "subtitle", "time": 26518.59, "timestamp": "07:21:58", "text": "叔父さん"}]
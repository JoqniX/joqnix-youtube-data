[{"type": "subtitle", "time": 21601.67, "timestamp": "06:00:01", "text": "わからないけど、少なくとも"}, {"type": "subtitle", "time": 21605.39, "timestamp": "06:00:05", "text": "見応えがあるでしょ？少なくとも"}, {"type": "subtitle", "time": 21608.868, "timestamp": "06:00:08", "text": "見応えがある。だから、私はただ、ええ、そうなんです"}, {"type": "subtitle", "time": 21610.628, "timestamp": "06:00:10", "text": "皆さん、お元気ですか？うん。こんにちは、ロバートさん"}, {"type": "subtitle", "time": 21611.868, "timestamp": "06:00:11", "text": "ジャクソン。"}, {"type": "subtitle", "time": 21613.39, "timestamp": "06:00:13", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 21621.83, "timestamp": "06:00:21", "text": "私たちはメインクエストを進めます"}, {"type": "subtitle", "time": 21625.03, "timestamp": "06:00:25", "text": "衰えゆく波。それから、私が終わったら"}, {"type": "subtitle", "time": 21627.91, "timestamp": "06:00:27", "text": "天気、メインクエスト。わかった。"}, {"type": "subtitle", "time": 21630.23, "timestamp": "06:00:30", "text": "メインクエストを終えたら、"}, {"type": "subtitle", "time": 21632.15, "timestamp": "06:00:32", "text": "する"}, {"type": "subtitle", "time": 21635.83, "timestamp": "06:00:35", "text": "ジャイアントクエスト、コンパニオンクエスト"}, {"type": "subtitle", "time": 21638.868, "timestamp": "06:00:38", "text": "巨大な旗と仲間として"}, {"type": "subtitle", "time": 21643.27, "timestamp": "06:00:43", "text": "イベントのようなもののクエストは"}, {"type": "subtitle", "time": 21644.91, "timestamp": "06:00:44", "text": "省略する"}, {"type": "subtitle", "time": 21647.91, "timestamp": "06:00:47", "text": "すぐ。だからそれは良い考えだと思った"}, {"type": "subtitle", "time": 21650.07, "timestamp": "06:00:50", "text": "文字通り、あの、あのね、"}, {"type": "subtitle", "time": 21652.31, "timestamp": "06:00:52", "text": "これをオフにする。それは"}, {"type": "subtitle", "time": 21656.59, "timestamp": "06:00:56", "text": "FPSをください。これでFPSが上がる。"}, {"type": "subtitle", "time": 21659.67, "timestamp": "06:00:59", "text": "はい、メディアソースをオフにすると"}]
[{"type": "subtitle", "time": 19813.31, "timestamp": "05:30:13", "text": "神。それは"}, {"type": "subtitle", "time": 19818.15, "timestamp": "05:30:18", "text": "チームメイト？ああ、彼らはその中にいる。 H."}, {"type": "subtitle", "time": 19819.708, "timestamp": "05:30:19", "text": "入手できますか？"}, {"type": "subtitle", "time": 19821.99, "timestamp": "05:30:21", "text": "自分？良いことをしている。あなたはどうですか？私は"}, {"type": "subtitle", "time": 19824.19, "timestamp": "05:30:24", "text": "よくやっている。ちょうど昼食を食べたところです"}, {"type": "subtitle", "time": 19827.11, "timestamp": "05:30:27", "text": "今。私はまだ、ええ。ええ、"}, {"type": "subtitle", "time": 19829.548, "timestamp": "05:30:29", "text": "運命"}]
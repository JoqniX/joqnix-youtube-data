[{"type": "subtitle", "time": 21960.99, "timestamp": "06:06:00", "text": "いいえ。わかりました、翻訳機は使えません"}, {"type": "subtitle", "time": 21965.39, "timestamp": "06:06:05", "text": "今日。ノイズがおかしくなる"}, {"type": "subtitle", "time": 21969.35, "timestamp": "06:06:09", "text": "抑制。ああ、いやだ。ミシ、どうして"}, {"type": "subtitle", "time": 21971.548, "timestamp": "06:06:11", "text": "のように"}, {"type": "subtitle", "time": 21974.868, "timestamp": "06:06:14", "text": "これ？でも大丈夫。えっと、ストリームPC、"}, {"type": "subtitle", "time": 21978.47, "timestamp": "06:06:18", "text": "今日死なないでくれ。"}, {"type": "subtitle", "time": 21982.11, "timestamp": "06:06:22", "text": "えっと、こんにちは。それでは、ゲームに移りましょう。"}, {"type": "subtitle", "time": 21986.35, "timestamp": "06:06:26", "text": "はい、少々お待ちください。私はもうすぐ"}, {"type": "subtitle", "time": 21988.43, "timestamp": "06:06:28", "text": "終わり。"}, {"type": "subtitle", "time": 21989.948, "timestamp": "06:06:29", "text": "えっと、"}, {"type": "subtitle", "time": 21993.548, "timestamp": "06:06:33", "text": "待って、待って。ビリー・ビリーの配信は終了したのですか？"}, {"type": "subtitle", "time": 21996.43, "timestamp": "06:06:36", "text": "え、死んだの？"}, {"type": "subtitle", "time": 22001.23, "timestamp": "06:06:41", "text": "待って、待って。私はビリー・ビリーで生放送中です。"}, {"type": "subtitle", "time": 22003.35, "timestamp": "06:06:43", "text": "右？待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 22005.43, "timestamp": "06:06:45", "text": "待って。クラッシュしたと表示されています。クラッシュした"}, {"type": "subtitle", "time": 22008.75, "timestamp": "06:06:48", "text": "2回。始まった。わかった。わかった。"}, {"type": "subtitle", "time": 22011.07, "timestamp": "06:06:51", "text": "わかった。おお、"}, {"type": "subtitle", "time": 22014.23, "timestamp": "06:06:54", "text": "わかった。えっと、怖かったんです。私はこう思った。"}, {"type": "subtitle", "time": 22015.31, "timestamp": "06:06:55", "text": "\"待って、"}, {"type": "subtitle", "time": 22017.948, "timestamp": "06:06:57", "text": "何？いいえ"}]
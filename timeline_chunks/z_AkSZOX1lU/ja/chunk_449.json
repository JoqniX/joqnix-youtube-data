[{"type": "subtitle", "time": 26942.948, "timestamp": "07:29:02", "text": "だから、もう1つ奪う必要がある。どこ"}, {"type": "subtitle", "time": 26949.59, "timestamp": "07:29:09", "text": "もっと？これもう1つどこで手に入りますか？"}, {"type": "subtitle", "time": 26967.31, "timestamp": "07:29:27", "text": "それは"}, {"type": "subtitle", "time": 26991.388, "timestamp": "07:29:51", "text": "おお、"}, {"type": "subtitle", "time": 26995.83, "timestamp": "07:29:55", "text": "もしかしたら、もしかしたら、私が書いたように"}]
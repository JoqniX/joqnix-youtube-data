[{"type": "subtitle", "time": 4143.749, "timestamp": "01:09:03", "text": "待って。あなたは看守の近くを見ます"}, {"type": "subtitle", "time": 4146.789, "timestamp": "01:09:06", "text": "常緑樹林の狩猟保護区。エール"}, {"type": "subtitle", "time": 4149.11, "timestamp": "01:09:09", "text": "短い。お手伝いさせてください。"}, {"type": "subtitle", "time": 4150.59, "timestamp": "01:09:10", "text": "注文する"}, {"type": "subtitle", "time": 4152.95, "timestamp": "01:09:12", "text": "アイテムとは、あなたがそれを持ち出すという意味ではありません"}, {"type": "subtitle", "time": 4154.63, "timestamp": "01:09:14", "text": "狩りに出かける。簡単に見てみましょう。"}, {"type": "subtitle", "time": 4156.63, "timestamp": "01:09:16", "text": "スロットの数字はホットキーで、"}, {"type": "subtitle", "time": 4158.87, "timestamp": "01:09:18", "text": "弾薬の種類は状況によって異なります"}, {"type": "subtitle", "time": 4160.55, "timestamp": "01:09:20", "text": "サイズ。だから、必ず持ち歩いているものを確認してください"}, {"type": "subtitle", "time": 4162.55, "timestamp": "01:09:22", "text": "倫理的な殺害には、それが必要です。動物"}, {"type": "subtitle", "time": 4164.149, "timestamp": "01:09:24", "text": "で殺してもカウントされません"}, {"type": "subtitle", "time": 4165.63, "timestamp": "01:09:25", "text": "間違ったタイプ"}, {"type": "subtitle", "time": 4168.65, "timestamp": "01:09:28", "text": "弾薬の。うわあ、それは"}, {"type": "subtitle", "time": 4187.59, "timestamp": "01:09:47", "text": "ゲーム？何てことだ。どこ？どうすれば入手できますか"}]
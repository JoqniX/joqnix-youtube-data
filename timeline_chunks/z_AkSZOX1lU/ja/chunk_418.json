[{"type": "subtitle", "time": 25080.15, "timestamp": "06:58:00", "text": "霧のような苦しみが私たちを結びつける。"}, {"type": "subtitle", "time": 25082.43, "timestamp": "06:58:02", "text": "私たちの"}, {"type": "subtitle", "time": 25098.91, "timestamp": "06:58:18", "text": "まるで彼が踊っているか、"}, {"type": "subtitle", "time": 25102.31, "timestamp": "06:58:22", "text": "心臓。まるで彼が"}, {"type": "subtitle", "time": 25108.468, "timestamp": "06:58:28", "text": "手。しばらくお待ちください。答えは"}, {"type": "subtitle", "time": 25111.27, "timestamp": "06:58:31", "text": "すぐそこです。ああ、それはつまり"}, {"type": "subtitle", "time": 25120.71, "timestamp": "06:58:40", "text": "私たち。ああ、あそこにいる。こんにちは"}, {"type": "subtitle", "time": 25130.31, "timestamp": "06:58:50", "text": "はい。うん。どこへ行くの？"}, {"type": "subtitle", "time": 25132.35, "timestamp": "06:58:52", "text": "これを走破するために"}, {"type": "subtitle", "time": 25134.788, "timestamp": "06:58:54", "text": "時間？私たちはただ確認したかっただけです"}, {"type": "subtitle", "time": 25136.19, "timestamp": "06:58:56", "text": "あなたは"}, {"type": "subtitle", "time": 25138.99, "timestamp": "06:58:58", "text": "一人で。"}]
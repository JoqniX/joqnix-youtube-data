[{"type": "subtitle", "time": 15060.55, "timestamp": "04:11:00", "text": "女王は厳密にはマロンではない。それは"}, {"type": "subtitle", "time": 15093.349, "timestamp": "04:11:33", "text": "あなたはインド人全体に嫉妬しているのですか？"}, {"type": "subtitle", "time": 15097.229, "timestamp": "04:11:37", "text": "人口、人口の半分"}, {"type": "subtitle", "time": 15098.83, "timestamp": "04:11:38", "text": "インド？"}, {"type": "subtitle", "time": 15101.99, "timestamp": "04:11:41", "text": "うーん、わからない。つまり、もう一つある"}, {"type": "subtitle", "time": 15104.95, "timestamp": "04:11:44", "text": "私の中には、学校についてこう言う部分がある。"}, {"type": "subtitle", "time": 15107.83, "timestamp": "04:11:47", "text": "人々はこんな風に大学に通っている"}, {"type": "subtitle", "time": 15109.91, "timestamp": "04:11:49", "text": "そして学校。私の中には、"}, {"type": "subtitle", "time": 15112.63, "timestamp": "04:11:52", "text": "勉強しなくていいからよかった、という感じ"}, {"type": "subtitle", "time": 15115.83, "timestamp": "04:11:55", "text": "などなど。しかしこの社会では"}, {"type": "subtitle", "time": 15117.75, "timestamp": "04:11:57", "text": "問題は、あなたが作らなければならないということです"}, {"type": "subtitle", "time": 15119.91, "timestamp": "04:11:59", "text": "自分の名前を確立し、イメージを持つ"}]
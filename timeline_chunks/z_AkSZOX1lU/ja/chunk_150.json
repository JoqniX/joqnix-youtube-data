[{"type": "subtitle", "time": 9000.75, "timestamp": "02:30:00", "text": "それ。あなたは目を使う。"}, {"type": "subtitle", "time": 9003.91, "timestamp": "02:30:03", "text": "ナンド、あなたの「あなたの」を使うとはどういう意味ですか？"}, {"type": "subtitle", "time": 9011.469, "timestamp": "02:30:11", "text": "ナンデ、アルビアンをプレイしたい"}, {"type": "subtitle", "time": 9024.11, "timestamp": "02:30:24", "text": "オンラインでこのゲームを待ってください"}, {"type": "subtitle", "time": 9028.349, "timestamp": "02:30:28", "text": "ああ、私はそれを主張したんだ、そう、私はこう思った"}, {"type": "subtitle", "time": 9031.91, "timestamp": "02:30:31", "text": "待って。クライシス3 リマスター版。それは"}, {"type": "subtitle", "time": 9034.71, "timestamp": "02:30:34", "text": "弓？何てことだ。待って、あれは弓？は"}, {"type": "subtitle", "time": 9036.27, "timestamp": "02:30:36", "text": "それは弓ですか？"}, {"type": "subtitle", "time": 9038.63, "timestamp": "02:30:38", "text": "アーチェリー。待てよ、それは弓矢を使ったゲームだ。"}, {"type": "subtitle", "time": 9041.55, "timestamp": "02:30:41", "text": "待って、それが危機とは何かということなの？"}, {"type": "subtitle", "time": 9045.19, "timestamp": "02:30:45", "text": "3？ああ、彼らは弓を持っている。それを買うべきでしょうか？"}, {"type": "subtitle", "time": 9058.63, "timestamp": "02:30:58", "text": "これ？おお。"}]
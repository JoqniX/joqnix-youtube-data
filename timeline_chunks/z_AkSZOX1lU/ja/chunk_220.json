[{"type": "subtitle", "time": 13203.19, "timestamp": "03:40:03", "text": "ああ、俺は自分の仕事で十分な収入を得られない"}, {"type": "subtitle", "time": 13205.15, "timestamp": "03:40:05", "text": "私は愛する"}, {"type": "subtitle", "time": 13208.19, "timestamp": "03:40:08", "text": "または"}, {"type": "subtitle", "time": 13234.469, "timestamp": "03:40:34", "text": "うん、みんなデューン・アウェイクニングをプレイしてるよ"}, {"type": "subtitle", "time": 13237.83, "timestamp": "03:40:37", "text": "独占先行プレイテスト。おお、"}, {"type": "subtitle", "time": 13241.24, "timestamp": "03:40:41", "text": "シルバーはなぜみんなプレイしているのですか"}, {"type": "subtitle", "time": 13244.11, "timestamp": "03:40:44", "text": "[音楽]"}]
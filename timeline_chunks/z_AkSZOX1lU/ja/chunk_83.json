[{"type": "subtitle", "time": 4981.35, "timestamp": "01:23:01", "text": "何てことだ。ホバースクリーンを表示する"}, {"type": "subtitle", "time": 4984.39, "timestamp": "01:23:04", "text": "ホバースクリーンには、ショットが当たった場所が表示されます"}, {"type": "subtitle", "time": 4986.629, "timestamp": "01:23:06", "text": "動物に関する情報は、"}, {"type": "subtitle", "time": 4988.47, "timestamp": "01:23:08", "text": "このスペース。"}, {"type": "subtitle", "time": 4991.709, "timestamp": "01:23:11", "text": "誰かが「ダーリン」って言った"}, {"type": "subtitle", "time": 4995.35, "timestamp": "01:23:15", "text": "親愛なるエンハンスのように、スコアはありません"}, {"type": "subtitle", "time": 4996.75, "timestamp": "01:23:16", "text": "支払わない"}, {"type": "subtitle", "time": 4998.669, "timestamp": "01:23:18", "text": "どんな支払いでも"}, {"type": "subtitle", "time": 5017.87, "timestamp": "01:23:37", "text": "それ？殺しに来た"}, {"type": "subtitle", "time": 5019.77, "timestamp": "01:23:39", "text": "リティ。彼に会いましょう"}]
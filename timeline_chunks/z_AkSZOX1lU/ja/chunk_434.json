[{"type": "subtitle", "time": 26042.07, "timestamp": "07:14:02", "text": "理解はできるけど、彼女はどうやって"}, {"type": "subtitle", "time": 26046.79, "timestamp": "07:14:06", "text": "言ってみて？どこですか？しかし"}, {"type": "subtitle", "time": 26056.73, "timestamp": "07:14:16", "text": "彼らは理解していない。でも、まあいいでしょう。"}, {"type": "subtitle", "time": 26075.03, "timestamp": "07:14:35", "text": "考えてみれば、いつか私は"}, {"type": "subtitle", "time": 26077.99, "timestamp": "07:14:37", "text": "私が言っていることを書き起こす"}, {"type": "subtitle", "time": 26080.468, "timestamp": "07:14:40", "text": "マンドレナ。"}, {"type": "subtitle", "time": 26083.468, "timestamp": "07:14:43", "text": "考えてみるよ。私はこう思う、"}]
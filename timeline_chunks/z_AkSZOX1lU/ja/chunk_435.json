[{"type": "subtitle", "time": 26102.91, "timestamp": "07:15:02", "text": "私は忘れていました"}, {"type": "subtitle", "time": 26115.03, "timestamp": "07:15:15", "text": "わかった。ニース。"}, {"type": "subtitle", "time": 26123.948, "timestamp": "07:15:23", "text": "行く。チャンギもそうしてくれたらよかったのに"}, {"type": "subtitle", "time": 26127.51, "timestamp": "07:15:27", "text": "自分。ええ、チャンギはフェニックスです"}, {"type": "subtitle", "time": 26129.59, "timestamp": "07:15:29", "text": "女の子だよね？これから登場するのは"}, {"type": "subtitle", "time": 26132.07, "timestamp": "07:15:32", "text": "次のマナ。"}, {"type": "subtitle", "time": 26134.628, "timestamp": "07:15:34", "text": "小惑星の入手方法がわかりません"}, {"type": "subtitle", "time": 26141.59, "timestamp": "07:15:41", "text": "宝箱は復活しません。そこには"}, {"type": "subtitle", "time": 26143.34, "timestamp": "07:15:43", "text": "あなたには何もできない"}, {"type": "subtitle", "time": 26153.07, "timestamp": "07:15:53", "text": "多くの。何をすればいいですか"}, {"type": "subtitle", "time": 26156.19, "timestamp": "07:15:56", "text": "[音楽]"}, {"type": "subtitle", "time": 26158.628, "timestamp": "07:15:58", "text": "する？どうやって開けるか考えなければならない"}]
[{"type": "subtitle", "time": 780.069, "timestamp": "00:13:00", "text": "それ？ケーブル。ちなみにこれはタイプCです。"}, {"type": "subtitle", "time": 783.19, "timestamp": "00:13:03", "text": "私が買ったナイフは"}, {"type": "subtitle", "time": 785.19, "timestamp": "00:13:05", "text": "ストリーム。"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "ああ、大変だ、めちゃくちゃにしてしまった。ああ神様、"}, {"type": "subtitle", "time": 791.71, "timestamp": "00:13:11", "text": "これは私がPG（ゲストハウス）に住んでいた時の話です。"}, {"type": "subtitle", "time": 795.43, "timestamp": "00:13:15", "text": "自分のオフィスストリームを手に入れる前の場所"}, {"type": "subtitle", "time": 799.79, "timestamp": "00:13:19", "text": "今持っている部屋にあるものとUSBメモリ"}, {"type": "subtitle", "time": 802.91, "timestamp": "00:13:22", "text": "ケーブル。これはタイプCです"}, {"type": "subtitle", "time": 806.23, "timestamp": "00:13:26", "text": "方法。きっと見つけられると思います。そうそう、"}, {"type": "subtitle", "time": 810.069, "timestamp": "00:13:30", "text": "これは私の腕です。あ、腕が見えています。"}, {"type": "subtitle", "time": 824.949, "timestamp": "00:13:44", "text": "狂ったように。でも、問題は、どうすれば"}, {"type": "subtitle", "time": 827.949, "timestamp": "00:13:47", "text": "これらを適切に切り取る"}, {"type": "subtitle", "time": 836.67, "timestamp": "00:13:56", "text": "多くの。大丈夫。置くだけです"}, {"type": "subtitle", "time": 839.75, "timestamp": "00:13:59", "text": "つまり、人々がそれを切り取ったということです。だから私は"}]
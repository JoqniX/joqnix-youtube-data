[{"type": "subtitle", "time": 913.11, "timestamp": "00:15:13", "text": "私だけでしょうか、それともマイクがオンオフを繰り返しているのでしょうか？"}, {"type": "subtitle", "time": 922.15, "timestamp": "00:15:22", "text": "なぜ私はこんな顔をしているのだろう？何てことだ。"}, {"type": "subtitle", "time": 924.47, "timestamp": "00:15:24", "text": "これは何ですか？私は計画を持っています"}, {"type": "subtitle", "time": 927.47, "timestamp": "00:15:27", "text": "あ、待って。ええ、そうです。ほら、私は欲しい"}, {"type": "subtitle", "time": 931.47, "timestamp": "00:15:31", "text": "私が買ったものを見る"}, {"type": "subtitle", "time": 935.03, "timestamp": "00:15:35", "text": "引っ越して以来ずっと。待って、私は"}, {"type": "subtitle", "time": 941.31, "timestamp": "00:15:41", "text": "自分？私は自分の"}, {"type": "subtitle", "time": 945.509, "timestamp": "00:15:45", "text": "おもちゃ、おもちゃ。ええと、争奪の対象となるおもちゃについて。ここに"}, {"type": "subtitle", "time": 949.11, "timestamp": "00:15:49", "text": "えーと、機械式回転"}, {"type": "subtitle", "time": 953.35, "timestamp": "00:15:53", "text": "マッサージ器みたいな機械"}, {"type": "subtitle", "time": 956.31, "timestamp": "00:15:56", "text": "えっと、背中に背中を乗せます。"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "歯車みたいなものですね。それは"}]
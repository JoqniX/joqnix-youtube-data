[{"type": "subtitle", "time": 2831.87, "timestamp": "00:47:11", "text": "[音楽]"}, {"type": "subtitle", "time": 2834.51, "timestamp": "00:47:14", "text": "今、私の声が聞こえますか？"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "マイクから犬の鳴き声が聞こえる？いいえ。そうです。"}, {"type": "subtitle", "time": 2841.48, "timestamp": "00:47:21", "text": "ええ、できません。"}, {"type": "subtitle", "time": 2850.95, "timestamp": "00:47:30", "text": "あ、待って。それは私が使わないものです"}, {"type": "subtitle", "time": 2871.87, "timestamp": "00:47:51", "text": "ああ、私は漢字が読めません。私は下手です"}, {"type": "subtitle", "time": 2874.55, "timestamp": "00:47:54", "text": "漢字。そうそう。お会いできてうれしいです。"}, {"type": "subtitle", "time": 2876.829, "timestamp": "00:47:56", "text": "はじめまして。お会いできて嬉しいです"}]
[{"type": "subtitle", "time": 25980.788, "timestamp": "07:13:00", "text": "待つのか？彼女がどこで言ったか知っていますか？"}, {"type": "subtitle", "time": 25983.788, "timestamp": "07:13:03", "text": "それ？一日中。"}, {"type": "subtitle", "time": 25987.19, "timestamp": "07:13:07", "text": "何？皆さん全員を私にください"}, {"type": "subtitle", "time": 25996.548, "timestamp": "07:13:16", "text": "席はいかがですか？何てことだ。ええ、そうですね。あなたは"}, {"type": "subtitle", "time": 25998.5, "timestamp": "07:13:18", "text": "ヴァカ、超ラッキーだね。"}, {"type": "subtitle", "time": 26000.99, "timestamp": "07:13:20", "text": "[音楽]"}, {"type": "subtitle", "time": 26005.11, "timestamp": "07:13:25", "text": "くそ。待って、彼らは"}, {"type": "subtitle", "time": 26008.35, "timestamp": "07:13:28", "text": "ボイスラインが本当にたくさん。"}, {"type": "subtitle", "time": 26015.19, "timestamp": "07:13:35", "text": "いいね。龍が如くゼロが"}, {"type": "subtitle", "time": 26018.75, "timestamp": "07:13:38", "text": "私の場合はスムーズに動作しますが、"}, {"type": "subtitle", "time": 26023.19, "timestamp": "07:13:43", "text": "彼自身。やあ、こんにちは。えーと、"}, {"type": "subtitle", "time": 26024.33, "timestamp": "07:13:44", "text": "中国語（北京語）"}, {"type": "subtitle", "time": 26030.628, "timestamp": "07:13:50", "text": "学習中なので、"}, {"type": "subtitle", "time": 26035.91, "timestamp": "07:13:55", "text": "これ。待って、彼女はそれをどう言うだろうか"}, {"type": "subtitle", "time": 26038.948, "timestamp": "07:13:58", "text": "中国語（北京語）？そうねぇ。そしてそれは"}]
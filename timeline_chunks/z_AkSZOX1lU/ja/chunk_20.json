[{"type": "subtitle", "time": 1207.83, "timestamp": "00:20:07", "text": "[音楽]"}, {"type": "subtitle", "time": 1211.74, "timestamp": "00:20:11", "text": "それでは、おやすみなさい。"}, {"type": "subtitle", "time": 1229.51, "timestamp": "00:20:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1231.83, "timestamp": "00:20:31", "text": "待って、持つのは良いことだと思いますか"}, {"type": "subtitle", "time": 1240.669, "timestamp": "00:20:40", "text": "ストリーム？私"}, {"type": "subtitle", "time": 1244.83, "timestamp": "00:20:44", "text": "これは"}, {"type": "subtitle", "time": 1246.95, "timestamp": "00:20:46", "text": "良い。わからない。ちょうど"}, {"type": "subtitle", "time": 1250.35, "timestamp": "00:20:50", "text": "考え。ベルトとして使うこともできますし"}, {"type": "subtitle", "time": 1259.68, "timestamp": "00:20:59", "text": "とても混乱しています。"}]
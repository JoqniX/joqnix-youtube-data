[{"type": "subtitle", "time": 17940.31, "timestamp": "04:59:00", "text": "h.ここにはない。何てことだ。する必要がある"}, {"type": "subtitle", "time": 17942.39, "timestamp": "04:59:02", "text": "何か行動を起こしましょう。映像が出るまで待ちます"}, {"type": "subtitle", "time": 17943.948, "timestamp": "04:59:03", "text": "コードを仕上げる"}, {"type": "subtitle", "time": 17948.15, "timestamp": "04:59:08", "text": "ダウンロード中。え、何だって？え、何だって？私"}, {"type": "subtitle", "time": 17951.948, "timestamp": "04:59:11", "text": "待ってください。私は列に並びました"}, {"type": "subtitle", "time": 17954.59, "timestamp": "04:59:14", "text": "既存のああ。"}, {"type": "subtitle", "time": 17961.07, "timestamp": "04:59:21", "text": "それは"}, {"type": "subtitle", "time": 17964.07, "timestamp": "04:59:24", "text": "最速。これは私が今までで最速の攻撃です"}, {"type": "subtitle", "time": 17966.868, "timestamp": "04:59:26", "text": "やった。"}, {"type": "subtitle", "time": 17969.51, "timestamp": "04:59:29", "text": "たった5～10秒しかかからなかった。 5つまたは"}, {"type": "subtitle", "time": 17973.59, "timestamp": "04:59:33", "text": "6秒、7秒。一体どういうことだ？私は"}, {"type": "subtitle", "time": 17976.99, "timestamp": "04:59:36", "text": "列に並ぶことができてとてもラッキー"}, {"type": "subtitle", "time": 17980.55, "timestamp": "04:59:40", "text": "既存のセクション。はい、行きましょう。今私たちは"}, {"type": "subtitle", "time": 17983.99, "timestamp": "04:59:43", "text": "あと5回繰り返す必要がある。のみ"}, {"type": "subtitle", "time": 17987.11, "timestamp": "04:59:47", "text": "私のクランにチームメイトがいて、"}, {"type": "subtitle", "time": 17990.35, "timestamp": "04:59:50", "text": "オンラインなら、これができる。だから、もし私が"}, {"type": "subtitle", "time": 17993.91, "timestamp": "04:59:53", "text": "チームメイト、もし私が"}, {"type": "subtitle", "time": 17995.75, "timestamp": "04:59:55", "text": "あなたにはチームメイトがいて、"}, {"type": "subtitle", "time": 17999.03, "timestamp": "04:59:59", "text": "同じ一族、ただ、それは"}]
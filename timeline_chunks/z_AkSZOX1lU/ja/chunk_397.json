[{"type": "subtitle", "time": 23826.83, "timestamp": "06:37:06", "text": "公平。"}, {"type": "subtitle", "time": 23829.67, "timestamp": "06:37:09", "text": "大丈夫です。後ほど画面をお見せします。"}, {"type": "subtitle", "time": 23835.948, "timestamp": "06:37:15", "text": "[音楽]"}, {"type": "subtitle", "time": 23838.11, "timestamp": "06:37:18", "text": "2番。私は"}, {"type": "subtitle", "time": 23847.468, "timestamp": "06:37:27", "text": "[音楽]"}, {"type": "subtitle", "time": 23850.788, "timestamp": "06:37:30", "text": "ストリーム。ただひたすら上を目指すだけだ。実行するだけ"}, {"type": "subtitle", "time": 23851.34, "timestamp": "06:37:31", "text": "ブレイク"}, {"type": "subtitle", "time": 23852.67, "timestamp": "06:37:32", "text": "[音楽]"}, {"type": "subtitle", "time": 23854.63, "timestamp": "06:37:34", "text": "咲く。おお。"}, {"type": "subtitle", "time": 23857.27, "timestamp": "06:37:37", "text": "[音楽]"}, {"type": "subtitle", "time": 23859.43, "timestamp": "06:37:39", "text": "共鳴能力。ああ、彼女は何者なのか"}, {"type": "subtitle", "time": 23869.39, "timestamp": "06:37:49", "text": "もの？そこには"}, {"type": "subtitle", "time": 23876.43, "timestamp": "06:37:56", "text": "もっと。ヴェリナ対"}]
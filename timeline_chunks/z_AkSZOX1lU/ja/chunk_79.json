[{"type": "subtitle", "time": 4753.27, "timestamp": "01:19:13", "text": "寝具はここでレスリングをしていたという意味です。"}, {"type": "subtitle", "time": 4755.51, "timestamp": "01:19:15", "text": "ずっと昔のこと。彼はもうすぐそこにいるはずだ。がある"}, {"type": "subtitle", "time": 4757.59, "timestamp": "01:19:17", "text": "さまざまな方法で狩りをすれば"}, {"type": "subtitle", "time": 4759.11, "timestamp": "01:19:19", "text": "近づくまでここをストーキングしてください"}, {"type": "subtitle", "time": 4761.669, "timestamp": "01:19:21", "text": "撃つかルアーを使って連れてくるのに十分な"}, {"type": "subtitle", "time": 4763.83, "timestamp": "01:19:23", "text": "彼からあなたへ。開けた土地がたくさんある"}, {"type": "subtitle", "time": 4765.55, "timestamp": "01:19:25", "text": "ストーカー行為"}, {"type": "subtitle", "time": 4767.75, "timestamp": "01:19:27", "text": "難しい。彼を誘い出して"}, {"type": "subtitle", "time": 4769.11, "timestamp": "01:19:29", "text": "やり方がわからない場合はしゃがむべきです"}, {"type": "subtitle", "time": 4771.35, "timestamp": "01:19:31", "text": "彼に話しかけた。サウンドを送信瞬間すべて"}, {"type": "subtitle", "time": 4774.47, "timestamp": "01:19:34", "text": "動物が話した。くそ、私は自分の"}]
[{"type": "subtitle", "time": 1382.31, "timestamp": "00:23:02", "text": "エクスポートできます。動作が遅い。"}, {"type": "subtitle", "time": 1404.95, "timestamp": "00:23:24", "text": "わかった。大きな窓があって、そこで寝ています"}, {"type": "subtitle", "time": 1410.549, "timestamp": "00:23:30", "text": "と。つまり、私はそんなことは言っていません。つまり、"}, {"type": "subtitle", "time": 1413.07, "timestamp": "00:23:33", "text": "うん。私は大きなものを持っています"}, {"type": "subtitle", "time": 1416.95, "timestamp": "00:23:36", "text": "けれど。でも、私には大きなものがあるんです。持つ"}, {"type": "subtitle", "time": 1419.47, "timestamp": "00:23:39", "text": "でも、かなり大きなやつだよ。"}, {"type": "subtitle", "time": 1423.11, "timestamp": "00:23:43", "text": "待って、私が見せた瞬間を誰も切り取ってない"}, {"type": "subtitle", "time": 1426.47, "timestamp": "00:23:46", "text": "テディベアと窓の両方が"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "私"}, {"type": "subtitle", "time": 1429.99, "timestamp": "00:23:49", "text": "つまり、私はそんなことは言っていないということです。ええ、そうですね。"}, {"type": "subtitle", "time": 1432.27, "timestamp": "00:23:52", "text": "大きなものをどうぞ"}, {"type": "subtitle", "time": 1434.669, "timestamp": "00:23:54", "text": "けれど。私はテディベアが大好きです"}]
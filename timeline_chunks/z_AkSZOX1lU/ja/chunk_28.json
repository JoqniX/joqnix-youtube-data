[{"type": "subtitle", "time": 1681.269, "timestamp": "00:28:01", "text": "ビタミン。私は家から一歩も出ない。私"}, {"type": "subtitle", "time": 1684.549, "timestamp": "00:28:04", "text": "草に触れていないし、日光も浴びていない。私"}, {"type": "subtitle", "time": 1686.11, "timestamp": "00:28:06", "text": "私の"}, {"type": "subtitle", "time": 1687.95, "timestamp": "00:28:07", "text": "ビタミン。"}, {"type": "subtitle", "time": 1720.07, "timestamp": "00:28:40", "text": "神。だから私の私のお腹は私のお腹は"}]
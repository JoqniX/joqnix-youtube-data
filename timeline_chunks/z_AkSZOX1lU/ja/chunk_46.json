[{"type": "subtitle", "time": 2776.03, "timestamp": "00:46:16", "text": "それ以外？"}, {"type": "subtitle", "time": 2785.589, "timestamp": "00:46:25", "text": "[音楽]"}, {"type": "subtitle", "time": 2787.67, "timestamp": "00:46:27", "text": "初めて待つとき。"}, {"type": "subtitle", "time": 2790.589, "timestamp": "00:46:30", "text": "さよならを言うとき、"}, {"type": "subtitle", "time": 2793.55, "timestamp": "00:46:33", "text": "しかし、強い"}, {"type": "subtitle", "time": 2808.71, "timestamp": "00:46:48", "text": "ああ、さようなら、仕事。彼らは英語を使う"}, {"type": "subtitle", "time": 2811.51, "timestamp": "00:46:51", "text": "時々。"}]
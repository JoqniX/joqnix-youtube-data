[{"type": "subtitle", "time": 21540.07, "timestamp": "05:59:00", "text": "マルチリーム。これでライブ配信が可能になる"}, {"type": "subtitle", "time": 21543.11, "timestamp": "05:59:03", "text": "6つ以上のプラットフォームへ。"}, {"type": "subtitle", "time": 21546.19, "timestamp": "05:59:06", "text": "だってすごく安いから。"}, {"type": "subtitle", "time": 21549.35, "timestamp": "05:59:09", "text": "7ドル。そして、それはうまくいった。どういうわけか"}, {"type": "subtitle", "time": 21552.19, "timestamp": "05:59:12", "text": "最終的にビリー・ビリーとうまくやるために"}, {"type": "subtitle", "time": 21556.83, "timestamp": "05:59:16", "text": "最近。だから私は本当に嬉しい"}, {"type": "subtitle", "time": 21561.11, "timestamp": "05:59:21", "text": "うまくいった。たくさん祈った後、"}, {"type": "subtitle", "time": 21564.628, "timestamp": "05:59:24", "text": "待って待って待って、"}, {"type": "subtitle", "time": 21567.51, "timestamp": "05:59:27", "text": "すべてがうまくいくことを願って、ついに"}, {"type": "subtitle", "time": 21570.628, "timestamp": "05:59:30", "text": "うまくいった。うん。"}, {"type": "subtitle", "time": 21571.628, "timestamp": "05:59:31", "text": "それで"}, {"type": "subtitle", "time": 21574.868, "timestamp": "05:59:34", "text": "えっと、なんて言えばいいんだろう？何て言えばいいんだろう？私"}, {"type": "subtitle", "time": 21575.85, "timestamp": "05:59:35", "text": "考える"}, {"type": "subtitle", "time": 21577.47, "timestamp": "05:59:37", "text": "[音楽]"}, {"type": "subtitle", "time": 21580.788, "timestamp": "05:59:40", "text": "えっと、すべて低設定になっています。何"}, {"type": "subtitle", "time": 21583.548, "timestamp": "05:59:43", "text": "もっと必要なら少し"}, {"type": "subtitle", "time": 21587.99, "timestamp": "05:59:47", "text": "より低い？えっと、それは私が思うから"}, {"type": "subtitle", "time": 21591.75, "timestamp": "05:59:51", "text": "テスト配信はあまりやってない"}, {"type": "subtitle", "time": 21595.12, "timestamp": "05:59:55", "text": "おそらく。だからだと思う"}, {"type": "subtitle", "time": 21596.35, "timestamp": "05:59:56", "text": "[音楽]"}, {"type": "subtitle", "time": 21597.948, "timestamp": "05:59:57", "text": "えっと"}]
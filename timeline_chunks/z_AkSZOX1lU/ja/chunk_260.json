[{"type": "subtitle", "time": 15600.229, "timestamp": "04:20:00", "text": "Twitchに接続できる場所は"}, {"type": "subtitle", "time": 15601.71, "timestamp": "04:20:01", "text": "無料"}, {"type": "subtitle", "time": 15605.189, "timestamp": "04:20:05", "text": "Twitchに接続する方法。私は欲しい"}, {"type": "subtitle", "time": 15608.189, "timestamp": "04:20:08", "text": "無料の方法。 Twitchっていうやつ知ってる？"}, {"type": "subtitle", "time": 15611.75, "timestamp": "04:20:11", "text": "3つの作品。私は2,000を支払わなければならない"}, {"type": "subtitle", "time": 15614.229, "timestamp": "04:20:14", "text": "これのルピー。私はこう思う、これは"}, {"type": "subtitle", "time": 15618.63, "timestamp": "04:20:18", "text": "ミコが使用するコードの一つ。"}, {"type": "subtitle", "time": 15627.91, "timestamp": "04:20:27", "text": "1つ。彼女はこれを持っている。 Twitchイベント"}, {"type": "subtitle", "time": 15630.51, "timestamp": "04:20:30", "text": "1つ。私は"}, {"type": "subtitle", "time": 15633.84, "timestamp": "04:20:33", "text": "無料のものが欲しい"}, {"type": "subtitle", "time": 15635.389, "timestamp": "04:20:35", "text": "[音楽]"}, {"type": "subtitle", "time": 15638.149, "timestamp": "04:20:38", "text": "方法。私は昨日までひどく体調が悪かった。"}, {"type": "subtitle", "time": 15640.51, "timestamp": "04:20:40", "text": "なんてこった。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 15651.11, "timestamp": "04:20:51", "text": "くそ。ああ、でもそうでない人もいる。"}, {"type": "subtitle", "time": 15654.149, "timestamp": "04:20:54", "text": "ええ、そうでない人もいますよ。私は必要としている"}, {"type": "subtitle", "time": 15656.55, "timestamp": "04:20:56", "text": "コラボレーションのために人々に連絡を取り、"}]
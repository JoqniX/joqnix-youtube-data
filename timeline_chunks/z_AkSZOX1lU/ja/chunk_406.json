[{"type": "subtitle", "time": 24360.67, "timestamp": "06:46:00", "text": "女性。彼女は黒人出身です"}, {"type": "subtitle", "time": 24374.868, "timestamp": "06:46:14", "text": "離れて。でも次の男は、"}, {"type": "subtitle", "time": 24377.19, "timestamp": "06:46:17", "text": "フェニックスの女の子はすごくクールで、"}, {"type": "subtitle", "time": 24379.39, "timestamp": "06:46:19", "text": "赤毛のディオ。欲しい"}, {"type": "subtitle", "time": 24382.07, "timestamp": "06:46:22", "text": "彼女。えーと、全部集めよう"}, {"type": "subtitle", "time": 24385.07, "timestamp": "06:46:25", "text": "この赤毛の"}, {"type": "subtitle", "time": 24387.708, "timestamp": "06:46:27", "text": "ゲーム。愛してください"}, {"type": "subtitle", "time": 24390.868, "timestamp": "06:46:30", "text": "自分。原神でさえ赤毛の女性を好まなかった"}, {"type": "subtitle", "time": 24394.468, "timestamp": "06:46:34", "text": "ここまでだ、ディオ。このゲームだけ。これまでのところ、"}, {"type": "subtitle", "time": 24397.27, "timestamp": "06:46:37", "text": "このゲームは愛を与えてくれるのを見たことがある"}, {"type": "subtitle", "time": 24401.75, "timestamp": "06:46:41", "text": "赤毛でギンガレッドを好む"}, {"type": "subtitle", "time": 24405.35, "timestamp": "06:46:45", "text": "頭の部分。だから私は好きなんです"}]
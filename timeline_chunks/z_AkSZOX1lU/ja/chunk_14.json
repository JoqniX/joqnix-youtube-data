[{"type": "subtitle", "time": 841.67, "timestamp": "00:14:01", "text": "それをクリップにしようと思うだけです。"}, {"type": "subtitle", "time": 844.03, "timestamp": "00:14:04", "text": "飲む"}, {"type": "subtitle", "time": 846.79, "timestamp": "00:14:06", "text": "長さ。彼は大きなものを持っている。これは何ですか"}, {"type": "subtitle", "time": 853.509, "timestamp": "00:14:13", "text": "でも、私は大きなものを持っていて、それを寝ています"}, {"type": "subtitle", "time": 856.15, "timestamp": "00:14:16", "text": "私が一緒に寝る相手。つまり、私はこうは言っていません"}, {"type": "subtitle", "time": 858.31, "timestamp": "00:14:18", "text": "それ。ええ、そうですね。大きなものをどうぞ"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "なぜなら、人々はそれを文脈から切り離して解釈する可能性があるからだ。"}, {"type": "subtitle", "time": 880.55, "timestamp": "00:14:40", "text": "この大バカ。私は聖なるものが欲しい"}, {"type": "subtitle", "time": 880.95, "timestamp": "00:14:40", "text": "ボン"}, {"type": "subtitle", "time": 882.189, "timestamp": "00:14:42", "text": "[音楽]"}, {"type": "subtitle", "time": 890.269, "timestamp": "00:14:50", "text": "H. わかりました。それもまた然り。そして最後"}, {"type": "subtitle", "time": 893.59, "timestamp": "00:14:53", "text": "1つ。引っ越して以来ずっと。待って、私が"}]
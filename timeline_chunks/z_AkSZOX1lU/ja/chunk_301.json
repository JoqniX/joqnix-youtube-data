[{"type": "subtitle", "time": 18069.11, "timestamp": "05:01:09", "text": "Warframeはどんなゲームになるんだろう。もし"}, {"type": "subtitle", "time": 18071.91, "timestamp": "05:01:11", "text": "運命とはこういうものなのか、どうしてだろう"}, {"type": "subtitle", "time": 18082.83, "timestamp": "05:01:22", "text": "ああ、お腹が空いた。"}, {"type": "subtitle", "time": 18089.91, "timestamp": "05:01:29", "text": "1つ。ああ、もう1つですね。その後"}, {"type": "subtitle", "time": 18093.83, "timestamp": "05:01:33", "text": "ストライキ中、何か食べに行ってきます。"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "船。待って、動作が遅い。一体どういうことだ"}]
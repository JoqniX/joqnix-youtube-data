[{"type": "subtitle", "time": 14401.91, "timestamp": "04:00:01", "text": "大丈夫。私はただ眠ってしまえば"}, {"type": "subtitle", "time": 14404.71, "timestamp": "04:00:04", "text": "朝。私はVを「ただ目を覚ます」という意味で使います"}, {"type": "subtitle", "time": 14410.429, "timestamp": "04:00:10", "text": "5時半に起床。 Vを作る、えーと作る"}, {"type": "subtitle", "time": 14414.389, "timestamp": "04:00:14", "text": "5時30分か5時45分くらいかな。新しいストリームを作成します。"}, {"type": "subtitle", "time": 14417.51, "timestamp": "04:00:17", "text": "新しいタイミングを試してみてください。えーっと"}, {"type": "subtitle", "time": 14423.229, "timestamp": "04:00:23", "text": "私の体をそのハードに耐えさせる"}, {"type": "subtitle", "time": 14426.79, "timestamp": "04:00:26", "text": "方法。私はそれを行うことができます。私はすでに"}, {"type": "subtitle", "time": 14430.83, "timestamp": "04:00:30", "text": "旧24時間12時間制限。"}, {"type": "subtitle", "time": 14434.11, "timestamp": "04:00:34", "text": "では、私の配線をどのように変更するか"}, {"type": "subtitle", "time": 14437.349, "timestamp": "04:00:37", "text": "体？わからない。できない、できない"}, {"type": "subtitle", "time": 14439.83, "timestamp": "04:00:39", "text": "睡眠薬を飲んでください。それは私を破滅させるだろう"}, {"type": "subtitle", "time": 14441.87, "timestamp": "04:00:41", "text": "それも良くないことだ。"}, {"type": "subtitle", "time": 14444.87, "timestamp": "04:00:44", "text": "だから、無理やり眠らなければならない。多分"}, {"type": "subtitle", "time": 14448.269, "timestamp": "04:00:48", "text": "別の場所で寝ます"}, {"type": "subtitle", "time": 14451.83, "timestamp": "04:00:51", "text": "位置。階下で寝るかもしれない"}, {"type": "subtitle", "time": 14454.15, "timestamp": "04:00:54", "text": "ストリーム配信ではなく、自分の部屋で過ごす"}]
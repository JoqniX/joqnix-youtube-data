[{"type": "subtitle", "time": 14771.79, "timestamp": "04:06:11", "text": "わかった、じゃあ行くよ"}, {"type": "subtitle", "time": 14775.75, "timestamp": "04:06:15", "text": "EPはこのボードをダウンロードできるようにしました。私"}, {"type": "subtitle", "time": 14777.79, "timestamp": "04:06:17", "text": "知る"}, {"type": "subtitle", "time": 14781.51, "timestamp": "04:06:21", "text": "アップロード。うん。うん。うん。うん。私はしなければならない"}, {"type": "subtitle", "time": 14786.7, "timestamp": "04:06:26", "text": "ください"}, {"type": "subtitle", "time": 14797.309, "timestamp": "04:06:37", "text": "[音楽]"}, {"type": "subtitle", "time": 14817.11, "timestamp": "04:06:57", "text": "44日目。つまり昨日のことだ。今日は"}]
[{"type": "subtitle", "time": 22320.47, "timestamp": "06:12:00", "text": "1つ。これらは気にしないでください。わかった。私はできませんでした"}, {"type": "subtitle", "time": 22322.59, "timestamp": "06:12:02", "text": "私の"}, {"type": "subtitle", "time": 22325.43, "timestamp": "06:12:05", "text": "画面。わかった。えーと、メインは"}, {"type": "subtitle", "time": 22330.59, "timestamp": "06:12:10", "text": "今のところは探求です。巻き戻しを行う"}, {"type": "subtitle", "time": 22333.31, "timestamp": "06:12:13", "text": "雨滴。わかった。さあ行こう"}, {"type": "subtitle", "time": 22337.83, "timestamp": "06:12:17", "text": "ここ。ファストトラベルを使えばいいんです。私にさせて"}, {"type": "subtitle", "time": 22341.628, "timestamp": "06:12:21", "text": "この男がなぜそうしないのかを突き止める"}, {"type": "subtitle", "time": 22375.35, "timestamp": "06:12:55", "text": "2番。どうやって？待って。何？なぜ？何が"}, {"type": "subtitle", "time": 22378.788, "timestamp": "06:12:58", "text": "今日何が起こっているの？待って。何？はぁ？どこ"}]
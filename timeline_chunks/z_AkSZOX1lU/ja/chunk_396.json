[{"type": "subtitle", "time": 23762.03, "timestamp": "06:36:02", "text": "サス。わかった。えっと、ちょっと待ってください。"}, {"type": "subtitle", "time": 23764.43, "timestamp": "06:36:04", "text": "ええと、私は"}, {"type": "subtitle", "time": 23792.27, "timestamp": "06:36:32", "text": "これ。"}, {"type": "subtitle", "time": 23803.43, "timestamp": "06:36:43", "text": "えーと、時々そういうものがないのは残念です"}, {"type": "subtitle", "time": 23806.708, "timestamp": "06:36:46", "text": "思い通りにはいかない。"}, {"type": "subtitle", "time": 23810.43, "timestamp": "06:36:50", "text": "私は、何をしたのか"}]
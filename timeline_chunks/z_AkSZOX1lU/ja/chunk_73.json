[{"type": "subtitle", "time": 4393.51, "timestamp": "01:13:13", "text": "よし、ハンターだ。あなたの親友をご紹介します。"}, {"type": "subtitle", "time": 4396.51, "timestamp": "01:13:16", "text": "猟師の仲間。この赤ちゃんは"}, {"type": "subtitle", "time": 4400.51, "timestamp": "01:13:20", "text": "動物を追跡し、地図を表示し、"}, {"type": "subtitle", "time": 4403.27, "timestamp": "01:13:23", "text": "それに乗って旅行する。収集品を手に入れ、収穫する"}, {"type": "subtitle", "time": 4404.87, "timestamp": "01:13:24", "text": "動物たちとゲームをすることもできます"}, {"type": "subtitle", "time": 4407.03, "timestamp": "01:13:27", "text": "それ。すべてマウスボタンで操作できます。トップ"}, {"type": "subtitle", "time": 4409.35, "timestamp": "01:13:29", "text": "100 の常にマークしないので、"}, {"type": "subtitle", "time": 4411.03, "timestamp": "01:13:31", "text": "ついに君がどこへ向かっているのかがわかったよ"}, {"type": "subtitle", "time": 4413.43, "timestamp": "01:13:33", "text": "予約が必要です。えっと、何か"}, {"type": "subtitle", "time": 4421.27, "timestamp": "01:13:41", "text": "する。探さなければならない時がわかります"}]
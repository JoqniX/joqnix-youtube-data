[{"type": "subtitle", "time": 25860.59, "timestamp": "07:11:00", "text": "それを示している。"}, {"type": "subtitle", "time": 25863.35, "timestamp": "07:11:03", "text": "ごめん。贈り物ありがとうございます。あなた"}, {"type": "subtitle", "time": 25865.548, "timestamp": "07:11:05", "text": "そうする必要はなかったけど、ありがとう"}, {"type": "subtitle", "time": 25867.788, "timestamp": "07:11:07", "text": "あなた。"}, {"type": "subtitle", "time": 25869.548, "timestamp": "07:11:09", "text": "わかった。"}, {"type": "subtitle", "time": 25881.43, "timestamp": "07:11:21", "text": "施設。そして、私たちはどうするのだろうか"}, {"type": "subtitle", "time": 25883.31, "timestamp": "07:11:23", "text": "ここ。"}, {"type": "subtitle", "time": 25884.83, "timestamp": "07:11:24", "text": "[音楽]"}, {"type": "subtitle", "time": 25886.43, "timestamp": "07:11:26", "text": "それで、"}, {"type": "subtitle", "time": 25900.43, "timestamp": "07:11:40", "text": "えーと、第１章、幕"}, {"type": "subtitle", "time": 25903.468, "timestamp": "07:11:43", "text": "六。切り替えられますか？"}, {"type": "subtitle", "time": 25910.868, "timestamp": "07:11:50", "text": "そこには？あなたに何かを見せてあげましょう"}, {"type": "subtitle", "time": 25912.628, "timestamp": "07:11:52", "text": "わかった。"}]
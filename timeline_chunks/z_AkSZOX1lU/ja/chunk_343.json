[{"type": "subtitle", "time": 20599.43, "timestamp": "05:43:19", "text": "さあ行こう。終わり。私は"}, {"type": "subtitle", "time": 20601.75, "timestamp": "05:43:21", "text": "テクノロジー探求。"}, {"type": "subtitle", "time": 20608.708, "timestamp": "05:43:28", "text": "民間人と警備員は傍観者になることができる"}, {"type": "subtitle", "time": 20620.75, "timestamp": "05:43:40", "text": "手に入れよう"}, {"type": "subtitle", "time": 20632.628, "timestamp": "05:43:52", "text": "ゾラン。ああ、神が来たとき、私の両親は"}]
[{"type": "subtitle", "time": 21901.35, "timestamp": "06:05:01", "text": "遅れ。動作が遅い。ああ、そうだ"}, {"type": "subtitle", "time": 21905.35, "timestamp": "06:05:05", "text": "遅れている。それは死につつある。おお。おお。おお。おお。"}, {"type": "subtitle", "time": 21907.07, "timestamp": "06:05:07", "text": "電源を切った方がいいでしょうか？"}, {"type": "subtitle", "time": 21910.788, "timestamp": "06:05:10", "text": "えっと、何か考えなきゃいけないことがあるんです。私の"}, {"type": "subtitle", "time": 21917.91, "timestamp": "06:05:17", "text": "悪い。しかし、その翻訳も間違っている。"}, {"type": "subtitle", "time": 21921.19, "timestamp": "06:05:21", "text": "ということで、o。大丈夫。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 21924.31, "timestamp": "06:05:24", "text": "みんな、きっと解決策を見つけるよ。良い"}, {"type": "subtitle", "time": 21926.67, "timestamp": "06:05:26", "text": "考えてみてください"}, {"type": "subtitle", "time": 21930.59, "timestamp": "06:05:30", "text": "外。始める前に、確認させてください"}, {"type": "subtitle", "time": 21942.43, "timestamp": "06:05:42", "text": "良い。あ、音声が途切れてる。あ、待って、"}, {"type": "subtitle", "time": 21948.67, "timestamp": "06:05:48", "text": "何？ちょっと待って。閉鎖する必要がある、"}, {"type": "subtitle", "time": 21952.51, "timestamp": "06:05:52", "text": "右？ああ、背景なしで行くよ"}]
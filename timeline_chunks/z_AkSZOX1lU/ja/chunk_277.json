[{"type": "subtitle", "time": 16621.429, "timestamp": "04:37:01", "text": "あ、ちょっと待って待って待って。このような"}, {"type": "subtitle", "time": 16626.709, "timestamp": "04:37:06", "text": "「ああ」って言いたかったんですね。あ、待って。私は私はしませんでした"}, {"type": "subtitle", "time": 16629.75, "timestamp": "04:37:09", "text": "この方法を知っておく。待って。実際に"}, {"type": "subtitle", "time": 16631.15, "timestamp": "04:37:11", "text": "する"}, {"type": "subtitle", "time": 16634.109, "timestamp": "04:37:14", "text": "これ。待って"}, {"type": "subtitle", "time": 16636.51, "timestamp": "04:37:16", "text": "何？待って"}, {"type": "subtitle", "time": 16640.269, "timestamp": "04:37:20", "text": "何？実際に次のようにすることができます"}, {"type": "subtitle", "time": 16643.349, "timestamp": "04:37:23", "text": "それ。一体どういうことだ？知りませんでした"}, {"type": "subtitle", "time": 16645.31, "timestamp": "04:37:25", "text": "について"}, {"type": "subtitle", "time": 16653.189, "timestamp": "04:37:33", "text": "いいね。ああ、キャプチャに送ることができます"}, {"type": "subtitle", "time": 16663.75, "timestamp": "04:37:43", "text": "ああ、それはすごくクールですね。待って、試させて"}, {"type": "subtitle", "time": 16666.23, "timestamp": "04:37:46", "text": "送信します。あなたから連絡はありませんでしたが、"}, {"type": "subtitle", "time": 16669.51, "timestamp": "04:37:49", "text": "私もそれを見ました。待って、これが私の画面です"}, {"type": "subtitle", "time": 16671.83, "timestamp": "04:37:51", "text": "黒。それはうまくいかない。何が"}, {"type": "subtitle", "time": 16673.83, "timestamp": "04:37:53", "text": "その背後には地下があるに違いない。所有"}]
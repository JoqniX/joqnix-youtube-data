[{"type": "subtitle", "time": 25273.708, "timestamp": "07:01:13", "text": "私は情報ブローカーです。"}, {"type": "subtitle", "time": 25276.948, "timestamp": "07:01:16", "text": "わかった。私は死後から取引をする。あなたは"}, {"type": "subtitle", "time": 25278.39, "timestamp": "07:01:18", "text": "情報が必要ですか？私にくれなきゃ"}, {"type": "subtitle", "time": 25287.948, "timestamp": "07:01:27", "text": "[音楽]"}, {"type": "subtitle", "time": 25290.628, "timestamp": "07:01:30", "text": "H. 彼らはただ取引をしたいだけです"}, {"type": "subtitle", "time": 25304.628, "timestamp": "07:01:44", "text": "あ、待って。共鳴ビーコン。それは"}, {"type": "subtitle", "time": 25307.27, "timestamp": "07:01:47", "text": "今は像の塔になっているの？なぜストレスを感じる必要があるのか"}]
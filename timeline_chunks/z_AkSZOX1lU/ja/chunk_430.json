[{"type": "subtitle", "time": 25802.15, "timestamp": "07:10:02", "text": "ああ、私はどうせお金を無駄にするだろう。こんにちは、"}, {"type": "subtitle", "time": 25803.628, "timestamp": "07:10:03", "text": "その"}, {"type": "subtitle", "time": 25814.35, "timestamp": "07:10:14", "text": "いや。あ、待って。今気づいたんだけど、ありがとう"}, {"type": "subtitle", "time": 25819.23, "timestamp": "07:10:19", "text": "えっと、ティフィー。贈り物ありがとうございます。"}, {"type": "subtitle", "time": 25823.23, "timestamp": "07:10:23", "text": "えっと、これは何ですか？それは"}, {"type": "subtitle", "time": 25826.59, "timestamp": "07:10:26", "text": "これは一体何ですか？"}, {"type": "subtitle", "time": 25828.99, "timestamp": "07:10:28", "text": "待って、私には読めない"}, {"type": "subtitle", "time": 25832.51, "timestamp": "07:10:32", "text": "それ。ありがとうございます"}, {"type": "subtitle", "time": 25841.83, "timestamp": "07:10:41", "text": "えっと、なぜ翻訳できないのでしょうか？まるで"}, {"type": "subtitle", "time": 25851.99, "timestamp": "07:10:51", "text": "絵文字。次はこれ。贈り物ありがとうございます。"}, {"type": "subtitle", "time": 25855.548, "timestamp": "07:10:55", "text": "本当に申し訳ありません。今気づいた"}, {"type": "subtitle", "time": 25859.03, "timestamp": "07:10:59", "text": "今。ええ、私のもう一つのチャットツールは"}]
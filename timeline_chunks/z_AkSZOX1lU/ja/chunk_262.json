[{"type": "subtitle", "time": 15721.309, "timestamp": "04:22:01", "text": "すごい。どこに"}, {"type": "subtitle", "time": 15726.79, "timestamp": "04:22:06", "text": "それ？はい、あなたにそう言いました"}, {"type": "subtitle", "time": 15729.03, "timestamp": "04:22:09", "text": "協力すべきだ。はい、連絡を取るべきですね"}, {"type": "subtitle", "time": 15731.469, "timestamp": "04:22:11", "text": "そして協力する。"}, {"type": "subtitle", "time": 15742.95, "timestamp": "04:22:22", "text": "はい。我慢する。バイナリは"}, {"type": "subtitle", "time": 15744.67, "timestamp": "04:22:24", "text": "[音楽]"}, {"type": "subtitle", "time": 15748.229, "timestamp": "04:22:28", "text": "読み込み中？うまくいくはずだ。ダウンロードされましたか？"}, {"type": "subtitle", "time": 15754.389, "timestamp": "04:22:34", "text": "バイナリ？そうそう。えっと、トゥームレイダーは"}, {"type": "subtitle", "time": 15757.55, "timestamp": "04:22:37", "text": "まだ無料です。私は主張した"}, {"type": "subtitle", "time": 15760.63, "timestamp": "04:22:40", "text": "それ。私はそれを主張したと思う。ああ、"}, {"type": "subtitle", "time": 15766.75, "timestamp": "04:22:46", "text": "ああ、この白さは私の目に映る。"}, {"type": "subtitle", "time": 15770.229, "timestamp": "04:22:50", "text": "ああ、なぜダークモードが好きなのか自分でもよくわからない。"}, {"type": "subtitle", "time": 15772.87, "timestamp": "04:22:52", "text": "ライトモードのときは、ああ、"}, {"type": "subtitle", "time": 15774.429, "timestamp": "04:22:54", "text": "私の"}, {"type": "subtitle", "time": 15778.13, "timestamp": "04:22:58", "text": "目がくらんだ。私の目は"}]
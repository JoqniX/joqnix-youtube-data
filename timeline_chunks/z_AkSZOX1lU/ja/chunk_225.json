[{"type": "subtitle", "time": 13501.469, "timestamp": "03:45:01", "text": "クラフト"}, {"type": "subtitle", "time": 13503.67, "timestamp": "03:45:03", "text": "マルチプレイヤー。本当に本当に"}, {"type": "subtitle", "time": 13506.59, "timestamp": "03:45:06", "text": "非常に得意"}, {"type": "subtitle", "time": 13510.03, "timestamp": "03:45:10", "text": "彼ら。歌詞が再生されています"}, {"type": "subtitle", "time": 13523.95, "timestamp": "03:45:23", "text": "みんなが遊んでいる"}, {"type": "subtitle", "time": 13527.67, "timestamp": "03:45:27", "text": "これ。お金の問題がなければ、"}, {"type": "subtitle", "time": 13530.229, "timestamp": "03:45:30", "text": "全部買っていただろう。いや、待って。"}, {"type": "subtitle", "time": 13531.99, "timestamp": "03:45:31", "text": "彼らは無料でそれを手に入れるか、"}, {"type": "subtitle", "time": 13535.55, "timestamp": "03:45:35", "text": "何かあるよね？から"}, {"type": "subtitle", "time": 13539.51, "timestamp": "03:45:39", "text": "そうですね。なぜなら、もしあなたが"}, {"type": "subtitle", "time": 13541.91, "timestamp": "03:45:41", "text": "スポンサーなどがいれば良いですね。"}, {"type": "subtitle", "time": 13544.389, "timestamp": "03:45:44", "text": "スポンサーからの資金で賄うんだよね？"}, {"type": "subtitle", "time": 13554.83, "timestamp": "03:45:54", "text": "何か。これはまさにクラフトシミュレーションゲームです"}, {"type": "subtitle", "time": 13558.07, "timestamp": "03:45:58", "text": "けれど。文字通りスケジュールを思い出させる"}, {"type": "subtitle", "time": 13559.469, "timestamp": "03:45:59", "text": "1つ"}]
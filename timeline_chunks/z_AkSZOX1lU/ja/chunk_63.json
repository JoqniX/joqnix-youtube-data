[{"type": "subtitle", "time": 3804.15, "timestamp": "01:03:24", "text": "それ。ハンタークローのヒナ。よし、行こう。"}, {"type": "subtitle", "time": 3805.51, "timestamp": "01:03:25", "text": "さあ行こう。さあ行こう。さあ行こう。さあ行こう。"}, {"type": "subtitle", "time": 3807.51, "timestamp": "01:03:27", "text": "何てことだ。インストールが必要です。あなたは"}, {"type": "subtitle", "time": 3815.67, "timestamp": "01:03:35", "text": "今？こちらもインストールしてください。私たちは"}, {"type": "subtitle", "time": 3818.87, "timestamp": "01:03:38", "text": "鳥や鹿などを狩らなきゃ。"}, {"type": "subtitle", "time": 3822.43, "timestamp": "01:03:42", "text": "私はFPSのスキルを披露します"}, {"type": "subtitle", "time": 3825.23, "timestamp": "01:03:45", "text": "実際の現実の生活"}, {"type": "subtitle", "time": 3828.67, "timestamp": "01:03:48", "text": "野生生物。本物"}]
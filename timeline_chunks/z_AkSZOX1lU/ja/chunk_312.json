[{"type": "subtitle", "time": 18721.27, "timestamp": "05:12:01", "text": "行くの？奪われた赤"}, {"type": "subtitle", "time": 18723.11, "timestamp": "05:12:03", "text": "軍団兵。それはどのように説明するか"}, {"type": "subtitle", "time": 18725.75, "timestamp": "05:12:05", "text": "オリックス抜きでそれを組織した。私はしませんでした"}, {"type": "subtitle", "time": 18738.75, "timestamp": "05:12:18", "text": "あなたは"}, {"type": "subtitle", "time": 18741.708, "timestamp": "05:12:21", "text": "面白い"}, {"type": "subtitle", "time": 18747.948, "timestamp": "05:12:27", "text": "キラキラ。"}, {"type": "subtitle", "time": 18752.868, "timestamp": "05:12:32", "text": "右。それで、スタジオコードを使って"}, {"type": "subtitle", "time": 18773.43, "timestamp": "05:12:53", "text": "さあ、来い。これを終わらせよう。これを"}]
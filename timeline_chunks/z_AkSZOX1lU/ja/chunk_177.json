[{"type": "subtitle", "time": 10621.59, "timestamp": "02:57:01", "text": "彼の妻は殺された。"}, {"type": "subtitle", "time": 10626.11, "timestamp": "02:57:06", "text": "私たちの中にまだ残っている部分"}, {"type": "subtitle", "time": 10630.99, "timestamp": "02:57:10", "text": "含む。私たちは動物以上の存在でなければならない"}, {"type": "subtitle", "time": 10633.69, "timestamp": "02:57:13", "text": "鎖。それは毒だ"}, {"type": "subtitle", "time": 10636.51, "timestamp": "02:57:16", "text": "[音楽]"}, {"type": "subtitle", "time": 10640.07, "timestamp": "02:57:20", "text": "それ。風に言わせてみようか"}, {"type": "subtitle", "time": 10642.18, "timestamp": "02:57:22", "text": "どこへ行けばいい？"}, {"type": "subtitle", "time": 10643.51, "timestamp": "02:57:23", "text": "[音楽]"}, {"type": "subtitle", "time": 10647.71, "timestamp": "02:57:27", "text": "もしあなたが運命を破り、それを証明できるなら"}, {"type": "subtitle", "time": 10650.67, "timestamp": "02:57:30", "text": "間違っている。おお。"}, {"type": "subtitle", "time": 10659.15, "timestamp": "02:57:39", "text": "[音楽]"}, {"type": "subtitle", "time": 10661.95, "timestamp": "02:57:41", "text": "おお。へ"}, {"type": "subtitle", "time": 10664.67, "timestamp": "02:57:44", "text": "世界。へ"}, {"type": "subtitle", "time": 10676.03, "timestamp": "02:57:56", "text": "野生。へ"}]
[{"type": "subtitle", "time": 10501.79, "timestamp": "02:55:01", "text": "まだ見ぬすべての道へ"}, {"type": "subtitle", "time": 10504.99, "timestamp": "02:55:04", "text": "舗装する。静寂の夢"}, {"type": "subtitle", "time": 10508.63, "timestamp": "02:55:08", "text": "楽しませ、そして奴隷にする。"}, {"type": "subtitle", "time": 10512.51, "timestamp": "02:55:12", "text": "さて、もし私のあなたへの愛があなたを"}, {"type": "subtitle", "time": 10521.99, "timestamp": "02:55:21", "text": "意思。あなたは決して痕跡を残さないでしょう"}, {"type": "subtitle", "time": 10524.309, "timestamp": "02:55:24", "text": "あなたは歩く。"}, {"type": "subtitle", "time": 10527.19, "timestamp": "02:55:27", "text": "なぜこんなに綺麗で美しいのでしょうか？の"}, {"type": "subtitle", "time": 10529.99, "timestamp": "02:55:29", "text": "伝えられるところによると、"}, {"type": "subtitle", "time": 10532.23, "timestamp": "02:55:32", "text": "[音楽]"}, {"type": "subtitle", "time": 10535.51, "timestamp": "02:55:35", "text": "ああ、まだ移動しなくてはならない。ウォーキング"}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": "[音楽]"}, {"type": "chat", "time": 10547.626, "timestamp": "02:55:47", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that reminds me, i haven't played DS 1 even tho i claimed it back on epic"}, {"type": "subtitle", "time": 10557.99, "timestamp": "02:55:57", "text": "よりワイルドに。"}]
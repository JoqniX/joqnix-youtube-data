[{"type": "subtitle", "time": 21781.03, "timestamp": "06:03:01", "text": "えっと、ちょっとおしゃべりしたかったんだけど"}, {"type": "subtitle", "time": 21786.31, "timestamp": "06:03:06", "text": "えっと、ちょっと変なのがあるんだけど"}, {"type": "subtitle", "time": 21789.27, "timestamp": "06:03:09", "text": "ピングというゲーム"}, {"type": "subtitle", "time": 21792.548, "timestamp": "06:03:12", "text": "えーとトランポリン、えーとトランペット、トロンボーン、または"}, {"type": "subtitle", "time": 21795.67, "timestamp": "06:03:15", "text": "視覚的に調整できるもの"}, {"type": "subtitle", "time": 21799.51, "timestamp": "06:03:19", "text": "音声変調がはっきりと聞こえる"}, {"type": "subtitle", "time": 21804.07, "timestamp": "06:03:24", "text": "そして全て。だから、とても良い"}, {"type": "subtitle", "time": 21805.83, "timestamp": "06:03:25", "text": "えっと、あれ。できるかどうかわかりません"}, {"type": "subtitle", "time": 21807.99, "timestamp": "06:03:27", "text": "ゲームと呼ぶ人もいるかもしれないが、楽しいよ。私"}, {"type": "subtitle", "time": 21810.03, "timestamp": "06:03:30", "text": "そうしようと思った。もしかしたらやるかもしれない"}, {"type": "subtitle", "time": 21814.35, "timestamp": "06:03:34", "text": "明日。ええ、そうですね。こんにちは。こんにちは、ニハ。"}, {"type": "subtitle", "time": 21816.788, "timestamp": "06:03:36", "text": "ニハ。今日は調子はどうですか？"}, {"type": "subtitle", "time": 21820.07, "timestamp": "06:03:40", "text": "元気です。今日は元気ですか？私は"}, {"type": "subtitle", "time": 21828.548, "timestamp": "06:03:48", "text": "今日。えっと、ちょうど壊れたんです。"}, {"type": "subtitle", "time": 21831.43, "timestamp": "06:03:51", "text": "朝食、夕食。"}, {"type": "subtitle", "time": 21835.99, "timestamp": "06:03:55", "text": "夕食を済ませてここにいます。"}]
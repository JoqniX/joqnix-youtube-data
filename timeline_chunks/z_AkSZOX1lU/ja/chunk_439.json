[{"type": "subtitle", "time": 26340.468, "timestamp": "07:19:00", "text": "曇り空の下では、宝探しの時間だ。なぜ"}, {"type": "subtitle", "time": 26343.39, "timestamp": "07:19:03", "text": "彼女はとても可愛いですか？今すぐ彼女が欲しい。"}, {"type": "subtitle", "time": 26346.83, "timestamp": "07:19:06", "text": "待って、PSが24個あるよ。"}, {"type": "subtitle", "time": 26350.548, "timestamp": "07:19:10", "text": "わかった。私のミニミッドMIDIグッズが欲しい"}, {"type": "subtitle", "time": 26353.03, "timestamp": "07:19:13", "text": "すぐにズームインできるように機能しましたが、"}, {"type": "subtitle", "time": 26355.708, "timestamp": "07:19:15", "text": "手動でボタンを押す必要があります。"}, {"type": "subtitle", "time": 26358.59, "timestamp": "07:19:18", "text": "ああ、"}, {"type": "subtitle", "time": 26362.03, "timestamp": "07:19:22", "text": "待って。ご覧のとおり、私は"}, {"type": "subtitle", "time": 26365.11, "timestamp": "07:19:25", "text": "24. ええと、それだけでは不十分ですが、"}, {"type": "subtitle", "time": 26370.27, "timestamp": "07:19:30", "text": "ない？"}, {"type": "subtitle", "time": 26372.67, "timestamp": "07:19:32", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 26383.23, "timestamp": "07:19:43", "text": "彼女は正式に"}, {"type": "subtitle", "time": 26386.43, "timestamp": "07:19:46", "text": "um配列"}, {"type": "subtitle", "time": 26389.59, "timestamp": "07:19:49", "text": "6. ああ、彼女は本当に"}, {"type": "subtitle", "time": 26397.708, "timestamp": "07:19:57", "text": "ああ、実際"}, {"type": "subtitle", "time": 26399.708, "timestamp": "07:19:59", "text": "良い。"}]
[{"type": "subtitle", "time": 10740.58, "timestamp": "02:59:00", "text": "は"}, {"type": "subtitle", "time": 10743.67, "timestamp": "02:59:03", "text": "[音楽]"}, {"type": "subtitle", "time": 10746.45, "timestamp": "02:59:06", "text": "待って、彼女は生きている。"}, {"type": "subtitle", "time": 10751.11, "timestamp": "02:59:11", "text": "[音楽]"}, {"type": "subtitle", "time": 10753.51, "timestamp": "02:59:13", "text": "黒インクの件がよく分からない。それは"}, {"type": "subtitle", "time": 10757.91, "timestamp": "02:59:17", "text": "泥か何かみたいな感じ？ずっとこの間ずっと。"}, {"type": "subtitle", "time": 10760.07, "timestamp": "02:59:20", "text": "あなたは間違っています。ああ、彼女は死んでしまった。死は"}, {"type": "subtitle", "time": 10763.23, "timestamp": "02:59:23", "text": "私たちを引き裂いてください。私たちはいつも"}, {"type": "subtitle", "time": 10765.83, "timestamp": "02:59:25", "text": "接続済み。私たちはいつもあなたと共にいます"}, {"type": "subtitle", "time": 10766.99, "timestamp": "02:59:26", "text": "案件"}, {"type": "subtitle", "time": 10776.309, "timestamp": "02:59:36", "text": "それはトランスジェンダーです。"}, {"type": "subtitle", "time": 10780.55, "timestamp": "02:59:40", "text": "今度こそ、永続的な繋がりを築く"}, {"type": "subtitle", "time": 10782.75, "timestamp": "02:59:42", "text": "女性と一緒に"}, {"type": "subtitle", "time": 10786.07, "timestamp": "02:59:46", "text": "赤。完璧な結末 人類"}, {"type": "subtitle", "time": 10788.71, "timestamp": "02:59:48", "text": "ふさわしい。"}, {"type": "subtitle", "time": 10791.269, "timestamp": "02:59:51", "text": "未来のために、私たちは皆"}, {"type": "subtitle", "time": 10794.55, "timestamp": "02:59:54", "text": "悪いものに対する障壁として集まる"}, {"type": "subtitle", "time": 10797.59, "timestamp": "02:59:57", "text": "そして、善への入り口でもある。全員"}]
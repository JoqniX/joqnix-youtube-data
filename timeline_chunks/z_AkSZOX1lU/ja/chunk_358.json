[{"type": "subtitle", "time": 21481.59, "timestamp": "05:58:01", "text": "それでいいですか？最善を尽くします。ああ、君"}, {"type": "subtitle", "time": 21486.28, "timestamp": "05:58:06", "text": "これ、聞こえますか？それが理由です。何てことだ。私は"}, {"type": "subtitle", "time": 21494.31, "timestamp": "05:58:14", "text": "最後に配信したのがいつだったか忘れちゃった"}, {"type": "subtitle", "time": 21501.11, "timestamp": "05:58:21", "text": "えっと、私のものが爆発したので、だからあなたは"}, {"type": "subtitle", "time": 21503.86, "timestamp": "05:58:23", "text": "みんな聞いてるよ。はい、どうぞ"}, {"type": "subtitle", "time": 21506.35, "timestamp": "05:58:26", "text": "[音楽]"}, {"type": "subtitle", "time": 21511.75, "timestamp": "05:58:31", "text": "行く。文字通り46、いや47FPSです"}, {"type": "subtitle", "time": 21520.83, "timestamp": "05:58:40", "text": "いいえ。どうやって運営するつもりですか"}, {"type": "subtitle", "time": 21529.43, "timestamp": "05:58:49", "text": "ラッキー？何てことだ。そうでない人のために"}, {"type": "subtitle", "time": 21533.15, "timestamp": "05:58:53", "text": "知ってるよ、私は完全に切り替えたんだ"}, {"type": "subtitle", "time": 21536.67, "timestamp": "05:58:56", "text": "reream.io から caster labs へ"}]
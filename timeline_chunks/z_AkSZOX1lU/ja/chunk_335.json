[{"type": "subtitle", "time": 20104.43, "timestamp": "05:35:04", "text": "それ。さあ"}, {"type": "subtitle", "time": 20107.35, "timestamp": "05:35:07", "text": "行く。何回走ればいいですか？"}, {"type": "subtitle", "time": 20110.07, "timestamp": "05:35:10", "text": "あと1回走れば終わりだ。"}, {"type": "subtitle", "time": 20112.07, "timestamp": "05:35:12", "text": "私たちには共通の目標がある。民間人および"}, {"type": "subtitle", "time": 20115.03, "timestamp": "05:35:15", "text": "守護者は並んで立つことができる"}]
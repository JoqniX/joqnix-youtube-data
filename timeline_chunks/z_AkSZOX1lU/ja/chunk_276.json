[{"type": "subtitle", "time": 16560.629, "timestamp": "04:36:00", "text": "ニャー。おそらく私のせいか何かでしょう。"}, {"type": "subtitle", "time": 16562.39, "timestamp": "04:36:02", "text": "あ、待って。"}, {"type": "subtitle", "time": 16564.709, "timestamp": "04:36:04", "text": "ストリーミング配信は私が担当するべきだと思う"}, {"type": "subtitle", "time": 16582.029, "timestamp": "04:36:22", "text": "待って。あ、待って。聞き忘れた"}, {"type": "subtitle", "time": 16590.07, "timestamp": "04:36:30", "text": "イベントをストリーミング配信する場合は、必ず"}, {"type": "subtitle", "time": 16594.429, "timestamp": "04:36:34", "text": "ストリーム用PCを維持するために"}, {"type": "subtitle", "time": 16596.269, "timestamp": "04:36:36", "text": "えーと"}, {"type": "subtitle", "time": 16598.709, "timestamp": "04:36:38", "text": "待って、プレイしないの？"}, {"type": "subtitle", "time": 16602.109, "timestamp": "04:36:42", "text": "けれど？ええ、私はプレイします"}, {"type": "subtitle", "time": 16604.629, "timestamp": "04:36:44", "text": "ストリーミング配信。私は「えっ？」って感じでした。何をすべきか"}, {"type": "subtitle", "time": 16612.99, "timestamp": "04:36:52", "text": "それで、あなたが言った方法は"}, {"type": "subtitle", "time": 16614.51, "timestamp": "04:36:54", "text": "バカ。"}, {"type": "subtitle", "time": 16618.67, "timestamp": "04:36:58", "text": "ああ、こんな感じ。"}]
[{"type": "subtitle", "time": 14520.429, "timestamp": "04:02:00", "text": "多分。"}, {"type": "subtitle", "time": 14524.229, "timestamp": "04:02:04", "text": "えっと、問題は、父を頼りにできないことなんです"}, {"type": "subtitle", "time": 14526.229, "timestamp": "04:02:06", "text": "好き"}, {"type": "subtitle", "time": 14528.91, "timestamp": "04:02:08", "text": "えっと、そこまで送ってください"}, {"type": "subtitle", "time": 14532.469, "timestamp": "04:02:12", "text": "えっと、大学とか大学とかそういうところで"}, {"type": "subtitle", "time": 14535.51, "timestamp": "04:02:15", "text": "課題を提出しなければならない。私は思う"}, {"type": "subtitle", "time": 14538.63, "timestamp": "04:02:18", "text": "自分で行ってみます。私は速い"}, {"type": "subtitle", "time": 14540.03, "timestamp": "04:02:20", "text": "私の"}, {"type": "subtitle", "time": 14542.83, "timestamp": "04:02:22", "text": "スクーター。えっと、私はただ"}, {"type": "subtitle", "time": 14546.469, "timestamp": "04:02:26", "text": "旅をスピードランで駆け抜けよう。成功することを願う"}, {"type": "subtitle", "time": 14549.189, "timestamp": "04:02:29", "text": "いずれは。できれば避けたいのですが"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "交通渋滞を避けて、"}, {"type": "subtitle", "time": 14555.59, "timestamp": "04:02:35", "text": "ストリームがいつまで続くかはわかりません"}, {"type": "subtitle", "time": 14560.15, "timestamp": "04:02:40", "text": "あの時は希望もなく何も起こらなかった"}, {"type": "subtitle", "time": 14562.349, "timestamp": "04:02:42", "text": "戻ってくる前に"}, {"type": "subtitle", "time": 14566.309, "timestamp": "04:02:46", "text": "夕方6時に2番目のストリームを作る"}, {"type": "subtitle", "time": 14567.309, "timestamp": "04:02:47", "text": "する"}, {"type": "subtitle", "time": 14569.75, "timestamp": "04:02:49", "text": "いつでもどんな時間でもコラボレーション"}, {"type": "subtitle", "time": 14572.87, "timestamp": "04:02:52", "text": "コラボは11月12日に終了し、必ず"}, {"type": "subtitle", "time": 14576.15, "timestamp": "04:02:56", "text": "私は朝6時と夜6時に早めの食事をします。"}, {"type": "subtitle", "time": 14578.55, "timestamp": "04:02:58", "text": "夕食も食べるし、軽食も食べる。"}]
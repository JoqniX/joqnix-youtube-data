[{"type": "subtitle", "time": 11532.55, "timestamp": "03:12:12", "text": "[音楽]"}, {"type": "subtitle", "time": 11536.55, "timestamp": "03:12:16", "text": "私は英語を話せますし、"}, {"type": "subtitle", "time": 11539.309, "timestamp": "03:12:19", "text": "日本語を少し"}, {"type": "subtitle", "time": 11552.81, "timestamp": "03:12:32", "text": "そこへ行きなさい。そこへ行きなさい。"}, {"type": "subtitle", "time": 11572.309, "timestamp": "03:12:52", "text": "日本語。いいえ、私はインド出身です。私は"}, {"type": "subtitle", "time": 11574.51, "timestamp": "03:12:54", "text": "から"}]
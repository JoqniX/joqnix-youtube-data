[{"type": "subtitle", "time": 15429.309, "timestamp": "04:17:09", "text": "これらのアイテムをすべて送る"}, {"type": "subtitle", "time": 15444.309, "timestamp": "04:17:24", "text": "なぜ？満員ですか？何てことだ。は"}, {"type": "subtitle", "time": 15445.63, "timestamp": "04:17:25", "text": "満杯"}, {"type": "subtitle", "time": 15453.75, "timestamp": "04:17:33", "text": "満腹。私の"}, {"type": "subtitle", "time": 15457.87, "timestamp": "04:17:37", "text": "電子メールをメインで保持できますか"}, {"type": "subtitle", "time": 15467.389, "timestamp": "04:17:47", "text": "えっと、私はそうは思わない、私はそうは思わない"}, {"type": "subtitle", "time": 15471.269, "timestamp": "04:17:51", "text": "知る。つまり、私は"}, {"type": "subtitle", "time": 15474.269, "timestamp": "04:17:54", "text": "連絡を取りたい"}, {"type": "subtitle", "time": 15477.229, "timestamp": "04:17:57", "text": "多くの。私はします"}]
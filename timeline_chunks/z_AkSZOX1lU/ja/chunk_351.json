[{"type": "subtitle", "time": 21061.59, "timestamp": "05:51:01", "text": "それで、そうですね、上から、えーと、みんな"}, {"type": "subtitle", "time": 21066.03, "timestamp": "05:51:06", "text": "今日来た人たちは花田"}, {"type": "subtitle", "time": 21068.03, "timestamp": "05:51:08", "text": "来るのは"}, {"type": "subtitle", "time": 21070.84, "timestamp": "05:51:10", "text": "人間を狙っている。"}, {"type": "subtitle", "time": 21076.83, "timestamp": "05:51:16", "text": "えっと、私は"}, {"type": "subtitle", "time": 21084.11, "timestamp": "05:51:24", "text": "くそ"}, {"type": "subtitle", "time": 21091.97, "timestamp": "05:51:31", "text": "男。所有"}, {"type": "subtitle", "time": 21094.75, "timestamp": "05:51:34", "text": "[音楽]"}, {"type": "subtitle", "time": 21111.51, "timestamp": "05:51:51", "text": "ハニー。こんにちは、彼らは"}, {"type": "subtitle", "time": 21114.23, "timestamp": "05:51:54", "text": "チャットで活発に活動し、私と話してくれた。"}, {"type": "subtitle", "time": 21116.868, "timestamp": "05:51:56", "text": "今日の配信とすべてのROM専"}, {"type": "subtitle", "time": 21119.51, "timestamp": "05:51:59", "text": "来てロックオンした"}]
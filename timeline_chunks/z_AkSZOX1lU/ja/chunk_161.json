[{"type": "subtitle", "time": 9660.67, "timestamp": "02:41:00", "text": "神。買うべきではないと思う"}, {"type": "subtitle", "time": 9667.17, "timestamp": "02:41:07", "text": "何でも。ああ、Halo Infinite"}, {"type": "subtitle", "time": 9669.63, "timestamp": "02:41:09", "text": "[音楽]"}, {"type": "subtitle", "time": 9672.75, "timestamp": "02:41:12", "text": "キャンペーン。新しいものを見せてください"}, {"type": "subtitle", "time": 9674.87, "timestamp": "02:41:14", "text": "リリース。あ、待って。私はそうすべきではない"}, {"type": "subtitle", "time": 9676.71, "timestamp": "02:41:16", "text": "これは信じられない。私は手に入れるかもしれない"}, {"type": "subtitle", "time": 9680.07, "timestamp": "02:41:20", "text": "再び禁止された。禁止ではなく、罰則です。"}, {"type": "subtitle", "time": 9681.83, "timestamp": "02:41:21", "text": "よし、このシーンに切り替えて"}, {"type": "subtitle", "time": 9686.83, "timestamp": "02:41:26", "text": "わかった。"}, {"type": "subtitle", "time": 9701.27, "timestamp": "02:41:41", "text": "不正な設計図。これは何ですか？ミステリー"}, {"type": "subtitle", "time": 9713.23, "timestamp": "02:41:53", "text": "ストライクフラグ"}, {"type": "subtitle", "time": 9715.91, "timestamp": "02:41:55", "text": "ブランク・モンスター・アンダーワールド。したい"}]
[{"type": "subtitle", "time": 21000.35, "timestamp": "05:50:00", "text": "えっと、それでは早めに切り上げます"}, {"type": "subtitle", "time": 21004.23, "timestamp": "05:50:04", "text": "今。ほとんど、ただリラックスしようという感じだ。"}, {"type": "subtitle", "time": 21007.35, "timestamp": "05:50:07", "text": "それから、えーと、私もいくつか作ります"}, {"type": "subtitle", "time": 21011.23, "timestamp": "05:50:11", "text": "私の配信にちょっとした変更があります"}, {"type": "subtitle", "time": 21016.67, "timestamp": "05:50:16", "text": "もの。だから、その点に備えておいてください。ほとんど"}, {"type": "subtitle", "time": 21024.83, "timestamp": "05:50:24", "text": "トゥイッチ。 Unreal Engineをテストします"}, {"type": "subtitle", "time": 21028.23, "timestamp": "05:50:28", "text": "もの。よし、Unrealを作りましょう。の"}, {"type": "subtitle", "time": 21030.948, "timestamp": "05:50:30", "text": "トーナメント終了後の次の配信"}, {"type": "subtitle", "time": 21034.39, "timestamp": "05:50:34", "text": "音楽とクリエイティブストリームの両方になります"}, {"type": "subtitle", "time": 21036.59, "timestamp": "05:50:36", "text": "制作とUnreal。"}, {"type": "subtitle", "time": 21053.27, "timestamp": "05:50:53", "text": "これから来るので、私は締めくくります"}, {"type": "subtitle", "time": 21054.35, "timestamp": "05:50:54", "text": "右"}]
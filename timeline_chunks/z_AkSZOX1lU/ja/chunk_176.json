[{"type": "subtitle", "time": 10561.63, "timestamp": "02:56:01", "text": "ベイ、あの物体が動くよ。ベイ。ベイ。彼は"}, {"type": "chat", "time": 10565.081, "timestamp": "02:56:05", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "yea"}, {"type": "subtitle", "time": 10595.19, "timestamp": "02:56:35", "text": "そこに行ったが、私は自分の"}, {"type": "subtitle", "time": 10596.83, "timestamp": "02:56:36", "text": "機器"}, {"type": "subtitle", "time": 10599.51, "timestamp": "02:56:39", "text": "自分。そして私は考えもしなかった"}, {"type": "subtitle", "time": 10600.75, "timestamp": "02:56:40", "text": "青い"}, {"type": "subtitle", "time": 10603.349, "timestamp": "02:56:43", "text": "それ。私たち二人には"}, {"type": "subtitle", "time": 10604.51, "timestamp": "02:56:44", "text": "逃げる"}, {"type": "subtitle", "time": 10607.75, "timestamp": "02:56:47", "text": "一緒に。私が望める最高のことは"}, {"type": "subtitle", "time": 10618.07, "timestamp": "02:56:58", "text": "何てことだ。"}]
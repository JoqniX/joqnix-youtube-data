[{"type": "subtitle", "time": 17521.03, "timestamp": "04:52:01", "text": "等待。他们是队友。好的。"}, {"type": "subtitle", "time": 17556.708, "timestamp": "04:52:36", "text": "差点就抓到我了。哦，他没能救活我。"}, {"type": "subtitle", "time": 17559.99, "timestamp": "04:52:39", "text": "哟，什么事？等等，是他，他真的救了我。"}, {"type": "subtitle", "time": 17561.31, "timestamp": "04:52:41", "text": "感谢"}, {"type": "subtitle", "time": 17577.27, "timestamp": "04:52:57", "text": "卡巴卡？快点，动手吧。"}]
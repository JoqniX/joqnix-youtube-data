[{"type": "subtitle", "time": 10202.15, "timestamp": "02:50:02", "text": "老板？她就像我的母亲一样。"}, {"type": "chat", "time": 10203.512, "timestamp": "02:50:03", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "kojima was there on original"}, {"type": "subtitle", "time": 10203.99, "timestamp": "02:50:03", "text": "掌握。"}, {"type": "subtitle", "time": 10210.67, "timestamp": "02:50:10", "text": "你听到了吗？"}, {"type": "subtitle", "time": 10214.309, "timestamp": "02:50:14", "text": "我，蛇？"}, {"type": "subtitle", "time": 10217.51, "timestamp": "02:50:17", "text": "我们是老板的儿子。"}, {"type": "chat", "time": 10217.98, "timestamp": "02:50:17", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "but, we all known wut happened to him"}, {"type": "subtitle", "time": 10221.51, "timestamp": "02:50:21", "text": "我看到了。恐惧。"}, {"type": "subtitle", "time": 10223.67, "timestamp": "02:50:23", "text": "我的天啊。"}, {"type": "subtitle", "time": 10228.11, "timestamp": "02:50:28", "text": "对活着这件事感到无比愤怒。一大批"}, {"type": "subtitle", "time": 10231.91, "timestamp": "02:50:31", "text": "悲伤。而你就是其中之一。为什么'"}, {"type": "subtitle", "time": 10234.429, "timestamp": "02:50:34", "text": "你会回来吗？你什么都没有。"}, {"type": "subtitle", "time": 10236.95, "timestamp": "02:50:36", "text": "这里。回家吧。"}, {"type": "subtitle", "time": 10239.91, "timestamp": "02:50:39", "text": "回去跟你的老板说。"}, {"type": "subtitle", "time": 10242.75, "timestamp": "02:50:42", "text": "但我仍然有影子兜帽和"}, {"type": "subtitle", "time": 10245.75, "timestamp": "02:50:45", "text": "遗产。美国没有什么可以"}, {"type": "subtitle", "time": 10248.76, "timestamp": "02:50:48", "text": "阻止我们。"}, {"type": "subtitle", "time": 10251.83, "timestamp": "02:50:51", "text": "[音乐]"}, {"type": "subtitle", "time": 10259.63, "timestamp": "02:50:59", "text": "战术上的"}]
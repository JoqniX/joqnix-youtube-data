[{"type": "subtitle", "time": 18968.07, "timestamp": "05:16:08", "text": "惠普。队友，队友，队友，"}, {"type": "subtitle", "time": 18986.708, "timestamp": "05:16:26", "text": "我的天哪，他们根本不在乎。"}, {"type": "subtitle", "time": 18990.31, "timestamp": "05:16:30", "text": "为什么？你为什么这么蠢？"}, {"type": "subtitle", "time": 18995.11, "timestamp": "05:16:35", "text": "这件事背后一定隐藏着什么……"}]
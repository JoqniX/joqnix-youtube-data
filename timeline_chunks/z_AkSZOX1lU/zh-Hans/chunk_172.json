[{"type": "subtitle", "time": 10342.269, "timestamp": "02:52:22", "text": "哇。先生，你真是个不知悔改的人。"}, {"type": "subtitle", "time": 10344.79, "timestamp": "02:52:24", "text": "非法闯入罪"}, {"type": "subtitle", "time": 10348.389, "timestamp": "02:52:28", "text": "我们的国家曾多次经历过这种情况。"}, {"type": "subtitle", "time": 10350.07, "timestamp": "02:52:30", "text": "我唯一有罪的就是"}, {"type": "subtitle", "time": 10352.23, "timestamp": "02:52:32", "text": "替你干脏活。通过"}, {"type": "subtitle", "time": 10354.55, "timestamp": "02:52:34", "text": "赔偿方面，我们忽略了您的"}, {"type": "subtitle", "time": 10356.07, "timestamp": "02:52:36", "text": "犯罪。"}, {"type": "subtitle", "time": 10358.15, "timestamp": "02:52:38", "text": "放马过来吧，反正我可不干这破事。"}, {"type": "subtitle", "time": 10359.83, "timestamp": "02:52:39", "text": "不再是了。让你觉得你拥有"}, {"type": "subtitle", "time": 10365.29, "timestamp": "02:52:45", "text": "什么样的"}, {"type": "subtitle", "time": 10368.15, "timestamp": "02:52:48", "text": "[音乐]"}, {"type": "subtitle", "time": 10369.55, "timestamp": "02:52:49", "text": "车"}, {"type": "subtitle", "time": 10371.79, "timestamp": "02:52:51", "text": "就像带来"}, {"type": "subtitle", "time": 10375.59, "timestamp": "02:52:55", "text": "孕妇死亡？"}, {"type": "subtitle", "time": 10378.23, "timestamp": "02:52:58", "text": "绝对没有人会允许这种事发生。"}]
[{"type": "subtitle", "time": 21901.35, "timestamp": "06:05:01", "text": "落后。它运行缓慢。我的天啊，真是这样吗？"}, {"type": "subtitle", "time": 21905.35, "timestamp": "06:05:05", "text": "滞后。它正在消亡。哦。哦。哦。哦。"}, {"type": "subtitle", "time": 21907.07, "timestamp": "06:05:07", "text": "我应该把它关掉吗？"}, {"type": "subtitle", "time": 21910.788, "timestamp": "06:05:10", "text": "呃，我需要想个办法。我的"}, {"type": "subtitle", "time": 21917.91, "timestamp": "06:05:17", "text": "坏的。但翻译也是错误的。"}, {"type": "subtitle", "time": 21921.19, "timestamp": "06:05:21", "text": "所以，哦。没关系。没关系。没关系。"}, {"type": "subtitle", "time": 21924.31, "timestamp": "06:05:24", "text": "我们会想办法的，大家一起。出色地"}, {"type": "subtitle", "time": 21926.67, "timestamp": "06:05:26", "text": "想想看"}, {"type": "subtitle", "time": 21930.59, "timestamp": "06:05:30", "text": "出去。开始之前，让我先确认一下……"}, {"type": "subtitle", "time": 21942.43, "timestamp": "06:05:42", "text": "出色地。哦，我的音频有延迟。哦，等等，"}, {"type": "subtitle", "time": 21948.67, "timestamp": "06:05:48", "text": "什么？好的，等等。我们需要关闭它。"}, {"type": "subtitle", "time": 21952.51, "timestamp": "06:05:52", "text": "正确的？哦不，我们去没有背景"}]
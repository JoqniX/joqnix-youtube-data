[{"type": "subtitle", "time": 780.069, "timestamp": "00:13:00", "text": "那？电缆。顺便说一下，这是C型。"}, {"type": "subtitle", "time": 783.19, "timestamp": "00:13:03", "text": "我买这把刀就是为了……"}, {"type": "subtitle", "time": 785.19, "timestamp": "00:13:05", "text": "溪流。"}, {"type": "subtitle", "time": 787.99, "timestamp": "00:13:07", "text": "天哪，我搞砸了。我的天啊，"}, {"type": "subtitle", "time": 791.71, "timestamp": "00:13:11", "text": "那是我住在学生公寓的那段时间。"}, {"type": "subtitle", "time": 795.43, "timestamp": "00:13:15", "text": "在我拥有自己的办公室之前"}, {"type": "subtitle", "time": 799.79, "timestamp": "00:13:19", "text": "我现在用的这个房间玩意儿和我的USB"}, {"type": "subtitle", "time": 802.91, "timestamp": "00:13:22", "text": "电缆。这是C型"}, {"type": "subtitle", "time": 806.23, "timestamp": "00:13:26", "text": "方式。我相信我能找到它。哦，是的。"}, {"type": "subtitle", "time": 810.069, "timestamp": "00:13:30", "text": "这是我的……哦，我的胳膊露出来了。"}, {"type": "subtitle", "time": 824.949, "timestamp": "00:13:44", "text": "疯狂地。但是，问题是，我该怎么做？"}, {"type": "subtitle", "time": 827.949, "timestamp": "00:13:47", "text": "把这些剪下来"}, {"type": "subtitle", "time": 836.67, "timestamp": "00:13:56", "text": "很多。美好的。我就这么说吧。"}, {"type": "subtitle", "time": 839.75, "timestamp": "00:13:59", "text": "我的意思是，有人剪辑过它。所以我是"}]
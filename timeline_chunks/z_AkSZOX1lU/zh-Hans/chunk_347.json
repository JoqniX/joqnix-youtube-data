[{"type": "subtitle", "time": 20845.628, "timestamp": "05:47:25", "text": "我嫉妒那些拥有……的人"}, {"type": "subtitle", "time": 20848.03, "timestamp": "05:47:28", "text": "呃"}, {"type": "subtitle", "time": 20858.35, "timestamp": "05:47:38", "text": "嗯？这个。这就是墙。那是"}, {"type": "subtitle", "time": 20867.35, "timestamp": "05:47:47", "text": "呃，如果你和这些怪物一起骑车，它们就会……"}]
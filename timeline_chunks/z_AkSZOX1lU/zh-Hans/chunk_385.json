[{"type": "subtitle", "time": 23104.67, "timestamp": "06:25:04", "text": "好的。呃，林苏。好的。你好呀，"}, {"type": "subtitle", "time": 23106.948, "timestamp": "06:25:06", "text": "奶奶。她看起来不像个"}, {"type": "subtitle", "time": 23108.45, "timestamp": "06:25:08", "text": "奶奶。她看起来如此"}, {"type": "subtitle", "time": 23110.27, "timestamp": "06:25:10", "text": "[音乐]"}, {"type": "subtitle", "time": 23114.35, "timestamp": "06:25:14", "text": "年轻的。哇。虽然不年轻，但是"}, {"type": "subtitle", "time": 23119.628, "timestamp": "06:25:19", "text": "成熟。是的。只有这缕缕灰白的头发。"}, {"type": "subtitle", "time": 23123.19, "timestamp": "06:25:23", "text": "是的。让她看起来很成熟。是的。"}, {"type": "subtitle", "time": 23139.07, "timestamp": "06:25:39", "text": "给她看看布莱克·布鲁姆。"}, {"type": "subtitle", "time": 23141.23, "timestamp": "06:25:41", "text": "图片。"}, {"type": "subtitle", "time": 23143.74, "timestamp": "06:25:43", "text": "是的。希望如此"}]
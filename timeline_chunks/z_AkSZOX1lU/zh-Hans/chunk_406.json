[{"type": "subtitle", "time": 24360.67, "timestamp": "06:46:00", "text": "女士。她来自黑人社区"}, {"type": "subtitle", "time": 24374.868, "timestamp": "06:46:14", "text": "离开。但是，呃，在下一个男人身上，"}, {"type": "subtitle", "time": 24377.19, "timestamp": "06:46:17", "text": "凤凰城女孩太酷了，她是一个"}, {"type": "subtitle", "time": 24379.39, "timestamp": "06:46:19", "text": "红发迪奥。我想"}, {"type": "subtitle", "time": 24382.07, "timestamp": "06:46:22", "text": "她。呃，我要收集所有的"}, {"type": "subtitle", "time": 24385.07, "timestamp": "06:46:25", "text": "这里面的红头发"}, {"type": "subtitle", "time": 24387.708, "timestamp": "06:46:27", "text": "游戏。请爱"}, {"type": "subtitle", "time": 24390.868, "timestamp": "06:46:30", "text": "我。就连原神也不喜欢红头发的人。"}, {"type": "subtitle", "time": 24394.468, "timestamp": "06:46:34", "text": "就这样，迪奥。只有这款游戏。迄今为止，"}, {"type": "subtitle", "time": 24397.27, "timestamp": "06:46:37", "text": "我只见过这款游戏给予爱"}, {"type": "subtitle", "time": 24401.75, "timestamp": "06:46:41", "text": "红头发，欣赏 Ginga 红"}, {"type": "subtitle", "time": 24405.35, "timestamp": "06:46:45", "text": "头部的东西。你知道，这就是我喜欢它的原因"}]
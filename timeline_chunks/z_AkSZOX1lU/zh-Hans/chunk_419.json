[{"type": "subtitle", "time": 25146.868, "timestamp": "06:59:06", "text": "哦，安吉拉叔叔不会做坏事的。"}, {"type": "subtitle", "time": 25147.868, "timestamp": "06:59:07", "text": "到"}, {"type": "subtitle", "time": 25161.75, "timestamp": "06:59:21", "text": "这。解救我们珍贵的客户。"}, {"type": "subtitle", "time": 25164.868, "timestamp": "06:59:24", "text": "她有一只好山羊和一只坏山羊。"}, {"type": "subtitle", "time": 25183.708, "timestamp": "06:59:43", "text": "哦，他的眼睛是金色的。"}, {"type": "subtitle", "time": 25185.58, "timestamp": "06:59:45", "text": "哇。凉爽的。"}, {"type": "subtitle", "time": 25193.788, "timestamp": "06:59:53", "text": "[音乐]"}]
[{"type": "subtitle", "time": 2831.87, "timestamp": "00:47:11", "text": "[音乐]"}, {"type": "subtitle", "time": 2834.51, "timestamp": "00:47:14", "text": "现在你能听到我的"}, {"type": "subtitle", "time": 2838.15, "timestamp": "00:47:18", "text": "我的麦克风里传来狗叫声？不。对。"}, {"type": "subtitle", "time": 2841.48, "timestamp": "00:47:21", "text": "是的，你不能。"}, {"type": "subtitle", "time": 2850.95, "timestamp": "00:47:30", "text": "哦，等等。我不会用那个，我会"}, {"type": "subtitle", "time": 2871.87, "timestamp": "00:47:51", "text": "啊，我看不懂汉字。我在这方面很差劲"}, {"type": "subtitle", "time": 2874.55, "timestamp": "00:47:54", "text": "汉字。哦，是的。很高兴认识你。"}, {"type": "subtitle", "time": 2876.829, "timestamp": "00:47:56", "text": "很高兴见到你。很高兴见到你"}]
[{"type": "subtitle", "time": 17594.03, "timestamp": "04:53:14", "text": "我死的时候"}, {"type": "subtitle", "time": 17597.27, "timestamp": "04:53:17", "text": "复苏。我被轮奸了"}, {"type": "subtitle", "time": 17607.628, "timestamp": "04:53:27", "text": "我的"}, {"type": "subtitle", "time": 17620.788, "timestamp": "04:53:40", "text": "去。我们走吧。哦，等等。一路返回"}]
[{"type": "subtitle", "time": 17106.868, "timestamp": "04:45:06", "text": "我不知道我做了什么，但是，是的。"}, {"type": "subtitle", "time": 17114.75, "timestamp": "04:45:14", "text": "去。我就不说了。"}, {"type": "subtitle", "time": 17118.15, "timestamp": "04:45:18", "text": "下载。我希望这件事发生。"}, {"type": "subtitle", "time": 17119.55, "timestamp": "04:45:19", "text": "虚幻"}, {"type": "subtitle", "time": 17123.51, "timestamp": "04:45:23", "text": "因为我想尽可能地推动它。"}, {"type": "subtitle", "time": 17125.19, "timestamp": "04:45:25", "text": "能。"}, {"type": "subtitle", "time": 17127.75, "timestamp": "04:45:27", "text": "那些不真实的世界。侦察兵有"}, {"type": "subtitle", "time": 17129.43, "timestamp": "04:45:29", "text": "报告称机票突然变更。"}, {"type": "subtitle", "time": 17131.67, "timestamp": "04:45:31", "text": "行为"}, {"type": "subtitle", "time": 17134.788, "timestamp": "04:45:34", "text": "所以如果我现在开始着手做这件事，那么我"}, {"type": "subtitle", "time": 17140.07, "timestamp": "04:45:40", "text": "不需要像拖延症患者那样犹豫不决。"}, {"type": "subtitle", "time": 17142.788, "timestamp": "04:45:42", "text": "这就是我为什么在最后一刻还在工作的原因"}, {"type": "subtitle", "time": 17146.47, "timestamp": "04:45:46", "text": "虽然我告诉自己……，但我现在还是在做这件事。"}, {"type": "subtitle", "time": 17148.03, "timestamp": "04:45:48", "text": "不会这么做"}, {"type": "subtitle", "time": 17152.11, "timestamp": "04:45:52", "text": "如果你喜欢 iPhone X 或 11"}, {"type": "subtitle", "time": 17154.51, "timestamp": "04:45:54", "text": "更多的"}, {"type": "subtitle", "time": 17158.11, "timestamp": "04:45:58", "text": "嗨，我喜欢我，呃，我不知道"}]
[{"type": "subtitle", "time": 1382.31, "timestamp": "00:23:02", "text": "我可以导出它。运行速度很慢。"}, {"type": "subtitle", "time": 1404.95, "timestamp": "00:23:24", "text": "好的。我睡在一扇大窗户旁。"}, {"type": "subtitle", "time": 1410.549, "timestamp": "00:23:30", "text": "和。我的意思是，我没说过那样的话。我是说，"}, {"type": "subtitle", "time": 1413.07, "timestamp": "00:23:33", "text": "是的。我有一个大的"}, {"type": "subtitle", "time": 1416.95, "timestamp": "00:23:36", "text": "尽管。不过我有一个很大的。有"}, {"type": "subtitle", "time": 1419.47, "timestamp": "00:23:39", "text": "不过这可是个大问题。"}, {"type": "subtitle", "time": 1423.11, "timestamp": "00:23:43", "text": "等等，没人剪辑我展示的那一刻吗？"}, {"type": "subtitle", "time": 1426.47, "timestamp": "00:23:46", "text": "泰迪熊和窗户"}, {"type": "subtitle", "time": 1427.99, "timestamp": "00:23:47", "text": "我"}, {"type": "subtitle", "time": 1429.99, "timestamp": "00:23:49", "text": "意思是说，我没说过那样的话。我的意思是，是的。"}, {"type": "subtitle", "time": 1432.27, "timestamp": "00:23:52", "text": "吃一大杯"}, {"type": "subtitle", "time": 1434.669, "timestamp": "00:23:54", "text": "尽管。我喜欢泰迪熊"}]
[{"type": "subtitle", "time": 722.15, "timestamp": "00:12:02", "text": "这相机质量太差了。"}, {"type": "subtitle", "time": 725.59, "timestamp": "00:12:05", "text": "我想这应该是我的手机吧？这"}, {"type": "subtitle", "time": 729.069, "timestamp": "00:12:09", "text": "后置摄像头，在它坏掉之前。"}, {"type": "subtitle", "time": 733.03, "timestamp": "00:12:13", "text": "呃，真的如此吗？我当时正在使用"}, {"type": "subtitle", "time": 736.87, "timestamp": "00:12:16", "text": "ASMR麦克风。哦，是的。 HyperX QuadCast。"}, {"type": "subtitle", "time": 738.55, "timestamp": "00:12:18", "text": "哦，是的。是的。是的。是的。是的。我是否"}, {"type": "subtitle", "time": 741.59, "timestamp": "00:12:21", "text": "比如说腰带？这听起来和……不一样"}, {"type": "subtitle", "time": 744.35, "timestamp": "00:12:24", "text": "我右边有一支动圈麦克风"}, {"type": "subtitle", "time": 747.069, "timestamp": "00:12:27", "text": "现在。我当时就想，"}, {"type": "subtitle", "time": 750.71, "timestamp": "00:12:30", "text": "兄弟，我可没装。哦，等等。"}, {"type": "subtitle", "time": 761.59, "timestamp": "00:12:41", "text": "我仍然把那个麦克风放在床边。"}, {"type": "subtitle", "time": 765.509, "timestamp": "00:12:45", "text": "那我什么时候直播呢？"}, {"type": "subtitle", "time": 767.23, "timestamp": "00:12:47", "text": "我需要做这件事。"}, {"type": "subtitle", "time": 772.269, "timestamp": "00:12:52", "text": "现在。好久不见了。好的，我们可以这样做"}, {"type": "subtitle", "time": 775.23, "timestamp": "00:12:55", "text": "这。为什么桌子会像这样移动"}]
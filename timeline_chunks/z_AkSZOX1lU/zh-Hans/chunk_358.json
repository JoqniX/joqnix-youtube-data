[{"type": "subtitle", "time": 21481.59, "timestamp": "05:58:01", "text": "这样可以吗？我会尽力而为。哦，你"}, {"type": "subtitle", "time": 21486.28, "timestamp": "05:58:06", "text": "听到了吗？这就是原因。我的天啊。我当时"}, {"type": "subtitle", "time": 21494.31, "timestamp": "05:58:14", "text": "我都忘了我上次直播是什么时候了。"}, {"type": "subtitle", "time": 21501.11, "timestamp": "05:58:21", "text": "嗯，我的东西都散架了，所以你"}, {"type": "subtitle", "time": 21503.86, "timestamp": "05:58:23", "text": "大家听好了。好了，就是这样。"}, {"type": "subtitle", "time": 21506.35, "timestamp": "05:58:26", "text": "[音乐]"}, {"type": "subtitle", "time": 21511.75, "timestamp": "05:58:31", "text": "去。它的帧率实际上是 46 到 47 帧。"}, {"type": "subtitle", "time": 21520.83, "timestamp": "05:58:40", "text": "不。我该如何运营一个"}, {"type": "subtitle", "time": 21529.43, "timestamp": "05:58:49", "text": "幸运的？我的天啊。对于那些不了解的人来说"}, {"type": "subtitle", "time": 21533.15, "timestamp": "05:58:53", "text": "我知道，我完全从呃……"}, {"type": "subtitle", "time": 21536.67, "timestamp": "05:58:56", "text": "reream.io 到 caster labs"}]
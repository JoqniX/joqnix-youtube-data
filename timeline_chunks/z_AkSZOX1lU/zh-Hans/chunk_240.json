[{"type": "subtitle", "time": 14401.91, "timestamp": "04:00:01", "text": "没关系。我可以睡着。"}, {"type": "subtitle", "time": 14404.71, "timestamp": "04:00:04", "text": "早晨。我会用 V 表示我刚醒来"}, {"type": "subtitle", "time": 14410.429, "timestamp": "04:00:10", "text": "早上5点半起床。把 v 呃 把呃"}, {"type": "subtitle", "time": 14414.389, "timestamp": "04:00:14", "text": "大概5:30到5:45。创建新流。"}, {"type": "subtitle", "time": 14417.51, "timestamp": "04:00:17", "text": "尝试调整新的时间。呃"}, {"type": "subtitle", "time": 14423.229, "timestamp": "04:00:23", "text": "让我的身体承受这艰难的考验"}, {"type": "subtitle", "time": 14426.79, "timestamp": "04:00:26", "text": "方式。我能做到。我已经超越了我的"}, {"type": "subtitle", "time": 14430.83, "timestamp": "04:00:30", "text": "旧的 24 小时 12 小时限制。"}, {"type": "subtitle", "time": 14434.11, "timestamp": "04:00:34", "text": "现在该如何重新连接我的线路呢？"}, {"type": "subtitle", "time": 14437.349, "timestamp": "04:00:37", "text": "身体？我不知道。我不能，我不能"}, {"type": "subtitle", "time": 14439.83, "timestamp": "04:00:39", "text": "去买安眠药。那会毁了我。"}, {"type": "subtitle", "time": 14441.87, "timestamp": "04:00:41", "text": "那也很糟糕。"}, {"type": "subtitle", "time": 14444.87, "timestamp": "04:00:44", "text": "所以我必须强迫自己入睡。或许"}, {"type": "subtitle", "time": 14448.269, "timestamp": "04:00:48", "text": "我还是去别的地方睡吧。"}, {"type": "subtitle", "time": 14451.83, "timestamp": "04:00:51", "text": "地点。或许可以睡在楼下我的房间里。"}, {"type": "subtitle", "time": 14454.15, "timestamp": "04:00:54", "text": "自己住房间，而不是在直播间"}]
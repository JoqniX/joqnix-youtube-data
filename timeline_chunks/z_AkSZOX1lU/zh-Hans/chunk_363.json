[{"type": "subtitle", "time": 21781.03, "timestamp": "06:03:01", "text": "嗯，我只是想和人聊聊天。"}, {"type": "subtitle", "time": 21786.31, "timestamp": "06:03:06", "text": "就像做……呃……哦，这里有个奇怪的"}, {"type": "subtitle", "time": 21789.27, "timestamp": "06:03:09", "text": "一款名为“Ping”的游戏"}, {"type": "subtitle", "time": 21792.548, "timestamp": "06:03:12", "text": "呃，蹦床，呃，特朗普，长号，或者"}, {"type": "subtitle", "time": 21795.67, "timestamp": "06:03:15", "text": "你可以像视觉方式那样进行调节的东西"}, {"type": "subtitle", "time": 21799.51, "timestamp": "06:03:19", "text": "并且可以清楚地听到语音调制之类的东西"}, {"type": "subtitle", "time": 21804.07, "timestamp": "06:03:24", "text": "以及所有的一切。所以，真是太好了……"}, {"type": "subtitle", "time": 21805.83, "timestamp": "06:03:25", "text": "呃，那个东西。我不知道你是否可以"}, {"type": "subtitle", "time": 21807.99, "timestamp": "06:03:27", "text": "你可以把它当成游戏，但它真的很有趣。我"}, {"type": "subtitle", "time": 21810.03, "timestamp": "06:03:30", "text": "我考虑过这样做。或许我们会这么做。"}, {"type": "subtitle", "time": 21814.35, "timestamp": "06:03:34", "text": "明天。是的。你好。你好，Niha。"}, {"type": "subtitle", "time": 21816.788, "timestamp": "06:03:36", "text": "妮哈。你今天过得怎么样？"}, {"type": "subtitle", "time": 21820.07, "timestamp": "06:03:40", "text": "我很好。你今天怎么样？我是"}, {"type": "subtitle", "time": 21828.548, "timestamp": "06:03:48", "text": "今天。呃，我刚才……呃，休息了一下，呃，不是。"}, {"type": "subtitle", "time": 21831.43, "timestamp": "06:03:51", "text": "早餐，晚餐。"}, {"type": "subtitle", "time": 21835.99, "timestamp": "06:03:55", "text": "我吃过晚饭了，我现在在这里，我"}]
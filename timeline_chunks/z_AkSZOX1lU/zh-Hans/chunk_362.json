[{"type": "subtitle", "time": 21721.868, "timestamp": "06:02:01", "text": "星期日？星期日。呃，我想是昨天"}, {"type": "subtitle", "time": 21724.948, "timestamp": "06:02:04", "text": "正确的。呃，我什么时候开始直播的？"}, {"type": "subtitle", "time": 21727.91, "timestamp": "06:02:07", "text": "比利？我忘了。呃，是星期六吗？"}, {"type": "subtitle", "time": 21731.59, "timestamp": "06:02:11", "text": "还是星期天？我相信是在"}, {"type": "subtitle", "time": 21735.67, "timestamp": "06:02:15", "text": "星期六，太阳。是的。我们玩了一些呃"}, {"type": "subtitle", "time": 21738.47, "timestamp": "06:02:18", "text": "卡利河口。我忘了更新游戏。"}, {"type": "subtitle", "time": 21741.07, "timestamp": "06:02:21", "text": "所以，我们只能等到更新发布。"}, {"type": "subtitle", "time": 21745.03, "timestamp": "06:02:25", "text": "完毕。我们打得就像……我们打得就像"}, {"type": "subtitle", "time": 21748.708, "timestamp": "06:02:28", "text": "到那时为止的Apex都怎么样了？和"}, {"type": "subtitle", "time": 21750.47, "timestamp": "06:02:30", "text": "我今天本应该直播的"}, {"type": "subtitle", "time": 21751.99, "timestamp": "06:02:31", "text": "实际上"}, {"type": "subtitle", "time": 21756.83, "timestamp": "06:02:36", "text": "呃，玩……嗯，我不是，我不想……"}, {"type": "subtitle", "time": 21759.59, "timestamp": "06:02:39", "text": "水流波。我只直播了"}, {"type": "subtitle", "time": 21761.99, "timestamp": "06:02:41", "text": "想着要不要在线观看，因为"}, {"type": "subtitle", "time": 21764.39, "timestamp": "06:02:44", "text": "活动即将结束，我说过这是我的最后一次直播"}, {"type": "subtitle", "time": 21767.59, "timestamp": "06:02:47", "text": "我说我们会一起举办这个活动。"}, {"type": "subtitle", "time": 21770.788, "timestamp": "06:02:50", "text": "在用完之前。不。所以，是的，我"}, {"type": "subtitle", "time": 21773.868, "timestamp": "06:02:53", "text": "其实我只是想学一些忍术而已。"}, {"type": "subtitle", "time": 21776.31, "timestamp": "06:02:56", "text": "聊天。我只想做一些事情"}, {"type": "subtitle", "time": 21778.788, "timestamp": "06:02:58", "text": "聊天和"}]
[{"type": "subtitle", "time": 25080.15, "timestamp": "06:58:00", "text": "迷雾中的痛苦将我们联系在一起。"}, {"type": "subtitle", "time": 25082.43, "timestamp": "06:58:02", "text": "愿我们"}, {"type": "subtitle", "time": 25098.91, "timestamp": "06:58:18", "text": "就好像他在跳舞或做出某种动作一样"}, {"type": "subtitle", "time": 25102.31, "timestamp": "06:58:22", "text": "心。就好像他正在做……"}, {"type": "subtitle", "time": 25108.468, "timestamp": "06:58:28", "text": "手。请耐心等待。答案是"}, {"type": "subtitle", "time": 25111.27, "timestamp": "06:58:31", "text": "就在拐角处。哦，那是什么意思？"}, {"type": "subtitle", "time": 25120.71, "timestamp": "06:58:40", "text": "我们。哦，他在那儿。你好"}, {"type": "subtitle", "time": 25130.31, "timestamp": "06:58:50", "text": "是的。是的。你要去哪儿？"}, {"type": "subtitle", "time": 25132.35, "timestamp": "06:58:52", "text": "运行这个"}, {"type": "subtitle", "time": 25134.788, "timestamp": "06:58:54", "text": "时间？我们只是想确保"}, {"type": "subtitle", "time": 25136.19, "timestamp": "06:58:56", "text": "你曾是"}, {"type": "subtitle", "time": 25138.99, "timestamp": "06:58:58", "text": "独自的。"}]
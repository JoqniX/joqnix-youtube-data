[{"type": "subtitle", "time": 15429.309, "timestamp": "04:17:09", "text": "请寄送所有这些物品"}, {"type": "subtitle", "time": 15444.309, "timestamp": "04:17:24", "text": "为什么？它满了吗？我的天啊。是"}, {"type": "subtitle", "time": 15445.63, "timestamp": "04:17:25", "text": "它满"}, {"type": "subtitle", "time": 15448.429, "timestamp": "04:17:28", "text": "满的？哦，天哪，是"}, {"type": "subtitle", "time": 15453.75, "timestamp": "04:17:33", "text": "饱满的。我的天哪，你能……你能拿着任何东西吗？"}, {"type": "subtitle", "time": 15457.87, "timestamp": "04:17:37", "text": "你能保留任何主要的电子邮件吗？"}, {"type": "subtitle", "time": 15467.389, "timestamp": "04:17:47", "text": "嗯，我不，我不"}, {"type": "subtitle", "time": 15471.269, "timestamp": "04:17:51", "text": "知道。我的意思是，我想做我我"}, {"type": "subtitle", "time": 15474.269, "timestamp": "04:17:54", "text": "想联系"}, {"type": "subtitle", "time": 15477.229, "timestamp": "04:17:57", "text": "许多。我愿意"}]
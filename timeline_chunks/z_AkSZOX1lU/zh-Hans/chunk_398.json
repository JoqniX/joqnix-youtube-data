[{"type": "subtitle", "time": 23880.27, "timestamp": "06:38:00", "text": "维娜。好的。为什么是亚娜？她是什么人？"}, {"type": "subtitle", "time": 23888.35, "timestamp": "06:38:08", "text": "你注意到了吗？"}, {"type": "subtitle", "time": 23898.91, "timestamp": "06:38:18", "text": "到处都是楠？它们并非由……制造"}, {"type": "subtitle", "time": 23902.11, "timestamp": "06:38:22", "text": "米塞纳。交给它吧"}, {"type": "subtitle", "time": 23904.788, "timestamp": "06:38:24", "text": "我。可能对你有危险。相信"}, {"type": "subtitle", "time": 23916.6, "timestamp": "06:38:36", "text": "呃"}, {"type": "subtitle", "time": 23920.03, "timestamp": "06:38:40", "text": "[音乐]"}, {"type": "subtitle", "time": 23923.548, "timestamp": "06:38:43", "text": "爸爸洛克，声音是从哪里传来的？"}, {"type": "subtitle", "time": 23926.27, "timestamp": "06:38:46", "text": "从。我可以调查吗？"}, {"type": "subtitle", "time": 23931.03, "timestamp": "06:38:51", "text": "它？黑色花瓣。哦好的。就是他们。"}, {"type": "subtitle", "time": 23933.67, "timestamp": "06:38:53", "text": "哦好的。黑色花瓣小队主题或"}]
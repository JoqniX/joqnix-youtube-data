[{"type": "subtitle", "time": 26102.91, "timestamp": "07:15:02", "text": "我忘了还有个……"}, {"type": "subtitle", "time": 26115.03, "timestamp": "07:15:15", "text": "好的。好的。"}, {"type": "subtitle", "time": 26123.948, "timestamp": "07:15:23", "text": "去。我希望樟宜机场也能那样做。"}, {"type": "subtitle", "time": 26127.51, "timestamp": "07:15:27", "text": "我。嗯，樟宜机场就是凤凰。"}, {"type": "subtitle", "time": 26129.59, "timestamp": "07:15:29", "text": "是女孩子吧？接下来要讨论的是……"}, {"type": "subtitle", "time": 26132.07, "timestamp": "07:15:32", "text": "下一个法力值。"}, {"type": "subtitle", "time": 26134.628, "timestamp": "07:15:34", "text": "我不知道如何把小行星弄进来。"}, {"type": "subtitle", "time": 26141.59, "timestamp": "07:15:41", "text": "宝箱不会刷新。有"}, {"type": "subtitle", "time": 26143.34, "timestamp": "07:15:43", "text": "你无能为力。"}, {"type": "subtitle", "time": 26153.07, "timestamp": "07:15:53", "text": "很多。我该怎么办？"}, {"type": "subtitle", "time": 26156.19, "timestamp": "07:15:56", "text": "[音乐]"}, {"type": "subtitle", "time": 26158.628, "timestamp": "07:15:58", "text": "做？你得想办法打开它。"}]
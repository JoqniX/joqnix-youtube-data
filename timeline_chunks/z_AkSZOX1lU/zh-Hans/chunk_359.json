[{"type": "subtitle", "time": 21540.07, "timestamp": "05:59:00", "text": "多梦。这样我就可以直播了。"}, {"type": "subtitle", "time": 21543.11, "timestamp": "05:59:03", "text": "支持六个以上平台。"}, {"type": "subtitle", "time": 21546.19, "timestamp": "05:59:06", "text": "因为它真的很便宜。"}, {"type": "subtitle", "time": 21549.35, "timestamp": "05:59:09", "text": "7美元。而且奏效了。它不知何故能够"}, {"type": "subtitle", "time": 21552.19, "timestamp": "05:59:12", "text": "最终和比利·比利成功了"}, {"type": "subtitle", "time": 21556.83, "timestamp": "05:59:16", "text": "最近。所以我真的很高兴"}, {"type": "subtitle", "time": 21561.11, "timestamp": "05:59:21", "text": "成功了。经过如此多的祈祷和喜欢"}, {"type": "subtitle", "time": 21564.628, "timestamp": "05:59:24", "text": "等啊等啊等，就像"}, {"type": "subtitle", "time": 21567.51, "timestamp": "05:59:27", "text": "希望一切顺利，终于"}, {"type": "subtitle", "time": 21570.628, "timestamp": "05:59:30", "text": "成功了。是的。"}, {"type": "subtitle", "time": 21571.628, "timestamp": "05:59:31", "text": "所以"}, {"type": "subtitle", "time": 21574.868, "timestamp": "05:59:34", "text": "嗯……我该说什么呢？我该说什么？我"}, {"type": "subtitle", "time": 21575.85, "timestamp": "05:59:35", "text": "思考"}, {"type": "subtitle", "time": 21577.47, "timestamp": "05:59:37", "text": "[音乐]"}, {"type": "subtitle", "time": 21580.788, "timestamp": "05:59:40", "text": "嗯，所有设置都调到了最低。什么"}, {"type": "subtitle", "time": 21583.548, "timestamp": "05:59:43", "text": "我还需要一点吗？"}, {"type": "subtitle", "time": 21587.99, "timestamp": "05:59:47", "text": "降低？呃，因为我觉得我"}, {"type": "subtitle", "time": 21591.75, "timestamp": "05:59:51", "text": "还没怎么做过测试直播"}, {"type": "subtitle", "time": 21595.12, "timestamp": "05:59:55", "text": "大概。这就是原因吧"}, {"type": "subtitle", "time": 21596.35, "timestamp": "05:59:56", "text": "[音乐]"}, {"type": "subtitle", "time": 21597.948, "timestamp": "05:59:57", "text": "嗯"}]
[{"type": "subtitle", "time": 26460.31, "timestamp": "07:21:00", "text": "让她摆脱那个。而且，我还要"}, {"type": "subtitle", "time": 26462.35, "timestamp": "07:21:02", "text": "这个也买一份。为什么"}, {"type": "subtitle", "time": 26472.788, "timestamp": "07:21:12", "text": "什么？如果我现在拿到武器，我就会"}, {"type": "subtitle", "time": 26474.75, "timestamp": "07:21:14", "text": "太开心了！"}, {"type": "subtitle", "time": 26477.39, "timestamp": "07:21:17", "text": "男人。"}, {"type": "subtitle", "time": 26499.31, "timestamp": "07:21:39", "text": "去。好的。那将会是"}, {"type": "subtitle", "time": 26516.03, "timestamp": "07:21:56", "text": "它是"}, {"type": "subtitle", "time": 26518.59, "timestamp": "07:21:58", "text": "叔叔"}]
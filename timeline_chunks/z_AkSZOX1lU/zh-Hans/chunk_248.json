[{"type": "subtitle", "time": 14881.03, "timestamp": "04:08:01", "text": "它只有 693 MB。你相信吗？"}, {"type": "subtitle", "time": 14885.229, "timestamp": "04:08:05", "text": "F5。我们的V只有693"}, {"type": "subtitle", "time": 14889.75, "timestamp": "04:08:09", "text": "MB。哇。真是太棒了。太短了。"}, {"type": "subtitle", "time": 14892.55, "timestamp": "04:08:12", "text": "这说明我比他们差了多少。"}, {"type": "subtitle", "time": 14894.63, "timestamp": "04:08:14", "text": "即使这是在直播中出现，"}, {"type": "subtitle", "time": 14896.03, "timestamp": "04:08:16", "text": "24小时"}, {"type": "subtitle", "time": 14898.429, "timestamp": "04:08:18", "text": "溪流。哦，我的"}, {"type": "subtitle", "time": 14902.79, "timestamp": "04:08:22", "text": "上帝。但我在那里待了5个小时。"}, {"type": "subtitle", "time": 14906.55, "timestamp": "04:08:26", "text": "五个小时太短了。过短。我知道。"}, {"type": "subtitle", "time": 14907.98, "timestamp": "04:08:27", "text": "它是"}, {"type": "subtitle", "time": 14910.51, "timestamp": "04:08:30", "text": "[音乐]"}, {"type": "subtitle", "time": 14914.229, "timestamp": "04:08:34", "text": "好的。我今天早上会直播。"}, {"type": "subtitle", "time": 14917.75, "timestamp": "04:08:37", "text": "第45天（第一部分）。呃，明天呃，呃，在"}, {"type": "subtitle", "time": 14920.389, "timestamp": "04:08:40", "text": "早上6点。好的。我会在6点前上传。"}, {"type": "subtitle", "time": 14922.79, "timestamp": "04:08:42", "text": "早上，我犯困。你们保重。"}, {"type": "subtitle", "time": 14924.79, "timestamp": "04:08:44", "text": "晚安。等等，等等，等等。比利"}, {"type": "subtitle", "time": 14928.429, "timestamp": "04:08:48", "text": "比利。嗯，谢谢大家的观看。"}, {"type": "subtitle", "time": 14930.75, "timestamp": "04:08:50", "text": "不信者"}, {"type": "subtitle", "time": 14933.71, "timestamp": "04:08:53", "text": "我去睡觉了。谢谢你"}, {"type": "subtitle", "time": 14936.07, "timestamp": "04:08:56", "text": "看着那些正在观看的人。感谢"}, {"type": "subtitle", "time": 14938.75, "timestamp": "04:08:58", "text": "希望你喜欢"}]
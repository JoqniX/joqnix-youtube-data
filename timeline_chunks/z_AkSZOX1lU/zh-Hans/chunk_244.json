[{"type": "subtitle", "time": 14647.7, "timestamp": "04:04:07", "text": "完毕？我必须填补空白。"}, {"type": "subtitle", "time": 14650.03, "timestamp": "04:04:10", "text": "[音乐]"}, {"type": "subtitle", "time": 14651.95, "timestamp": "04:04:11", "text": "不。"}, {"type": "subtitle", "time": 14658.07, "timestamp": "04:04:18", "text": "美好的。美好的。美好的。美好的。在哪里加入我们"}, {"type": "subtitle", "time": 14660.389, "timestamp": "04:04:20", "text": "之后？嗯，这条溪流真不错，对吧？"}, {"type": "subtitle", "time": 14664.59, "timestamp": "04:04:24", "text": "我这就把“哦，我的”删掉。"}, {"type": "subtitle", "time": 14668.83, "timestamp": "04:04:28", "text": "天哪，这真的很难。"}, {"type": "subtitle", "time": 14693.91, "timestamp": "04:04:53", "text": "我的天，这是昨天发生的事。我需要"}, {"type": "subtitle", "time": 14696.469, "timestamp": "04:04:56", "text": "记下时间，这样我就可以方便地剪线了。"}]
[{"type": "subtitle", "time": 10501.79, "timestamp": "02:55:01", "text": "通往我们尚未踏足的所有道路"}, {"type": "subtitle", "time": 10504.99, "timestamp": "02:55:04", "text": "铺平。那些静谧的梦"}, {"type": "subtitle", "time": 10508.63, "timestamp": "02:55:08", "text": "娱乐和奴隶。"}, {"type": "subtitle", "time": 10512.51, "timestamp": "02:55:12", "text": "现在，如果我对你的爱不能让你……"}, {"type": "subtitle", "time": 10521.99, "timestamp": "02:55:21", "text": "将要。你永远不会留下任何痕迹"}, {"type": "subtitle", "time": 10524.309, "timestamp": "02:55:24", "text": "你走。"}, {"type": "subtitle", "time": 10527.19, "timestamp": "02:55:27", "text": "为什么它这么漂亮？这"}, {"type": "subtitle", "time": 10529.99, "timestamp": "02:55:29", "text": "别人告诉你的。"}, {"type": "subtitle", "time": 10532.23, "timestamp": "02:55:32", "text": "[音乐]"}, {"type": "subtitle", "time": 10535.51, "timestamp": "02:55:35", "text": "哦，我们还要旅行。步行"}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": "[音乐]"}, {"type": "chat", "time": 10547.626, "timestamp": "02:55:47", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that reminds me, i haven't played DS 1 even tho i claimed it back on epic"}, {"type": "subtitle", "time": 10557.99, "timestamp": "02:55:57", "text": "更狂野。"}]
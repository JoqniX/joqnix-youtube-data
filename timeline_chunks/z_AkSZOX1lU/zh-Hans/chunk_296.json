[{"type": "subtitle", "time": 17762.708, "timestamp": "04:56:02", "text": "5到10分钟，或者如果你是的话，3分钟即可。"}, {"type": "subtitle", "time": 17771.59, "timestamp": "04:56:11", "text": "正常罢工需要15到30分钟。"}, {"type": "subtitle", "time": 17774.55, "timestamp": "04:56:14", "text": "这是最短的一篇。人们"}, {"type": "subtitle", "time": 17778.15, "timestamp": "04:56:18", "text": "研磨至完成。"}, {"type": "subtitle", "time": 17800.708, "timestamp": "04:56:40", "text": "还有多少人？ 15."}, {"type": "subtitle", "time": 17803.35, "timestamp": "04:56:43", "text": "还剩六个。这是第七次"}, {"type": "subtitle", "time": 17804.948, "timestamp": "04:56:44", "text": "跑步。"}, {"type": "subtitle", "time": 17807.19, "timestamp": "04:56:47", "text": "第17次运行。"}, {"type": "subtitle", "time": 17809.47, "timestamp": "04:56:49", "text": "等等，不是17。是第七次。"}]
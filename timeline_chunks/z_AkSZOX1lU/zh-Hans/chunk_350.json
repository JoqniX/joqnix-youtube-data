[{"type": "subtitle", "time": 21000.35, "timestamp": "05:50:00", "text": "嗯，那我就提前结束了。"}, {"type": "subtitle", "time": 21004.23, "timestamp": "05:50:04", "text": "现在。我几乎可以放松下来了。"}, {"type": "subtitle", "time": 21007.35, "timestamp": "05:50:07", "text": "还有，呃，我也会做一些"}, {"type": "subtitle", "time": 21011.23, "timestamp": "05:50:11", "text": "我的直播偶尔会有一些变化"}, {"type": "subtitle", "time": 21016.67, "timestamp": "05:50:16", "text": "东西。所以，做好心理准备吧。最多"}, {"type": "subtitle", "time": 21024.83, "timestamp": "05:50:24", "text": "抽搐。我们将测试虚幻引擎"}, {"type": "subtitle", "time": 21028.23, "timestamp": "05:50:28", "text": "东西。好的，我们将使用虚幻引擎。这"}, {"type": "subtitle", "time": 21030.948, "timestamp": "05:50:30", "text": "下一轮直播将在锦标赛结束后进行。"}, {"type": "subtitle", "time": 21034.39, "timestamp": "05:50:34", "text": "将成为音乐创作的灵感源泉"}, {"type": "subtitle", "time": 21036.59, "timestamp": "05:50:36", "text": "制作和虚幻。"}, {"type": "subtitle", "time": 21053.27, "timestamp": "05:50:53", "text": "感谢您的到来，我这就结束。"}, {"type": "subtitle", "time": 21054.35, "timestamp": "05:50:54", "text": "正确的"}]
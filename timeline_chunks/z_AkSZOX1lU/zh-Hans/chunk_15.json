[{"type": "subtitle", "time": 913.11, "timestamp": "00:15:13", "text": "是我的问题吗？我的麦克风好像时断时续？"}, {"type": "subtitle", "time": 922.15, "timestamp": "00:15:22", "text": "我为什么会露出这种表情？我的天啊。"}, {"type": "subtitle", "time": 924.47, "timestamp": "00:15:24", "text": "这是什么？我有一些计划，"}, {"type": "subtitle", "time": 927.47, "timestamp": "00:15:27", "text": "哦，等等。是的。你看，我想要……"}, {"type": "subtitle", "time": 931.47, "timestamp": "00:15:31", "text": "看看我买了些什么"}, {"type": "subtitle", "time": 935.03, "timestamp": "00:15:35", "text": "自从我搬家后就一直这样。等等，我拿了什么？"}, {"type": "subtitle", "time": 941.31, "timestamp": "00:15:41", "text": "我？我想用我的"}, {"type": "subtitle", "time": 945.509, "timestamp": "00:15:45", "text": "玩具玩具。呃，针对有争议的玩具。这里是"}, {"type": "subtitle", "time": 949.11, "timestamp": "00:15:49", "text": "那个，嗯，那个，机械旋转"}, {"type": "subtitle", "time": 953.35, "timestamp": "00:15:53", "text": "类似按摩器的机器"}, {"type": "subtitle", "time": 956.31, "timestamp": "00:15:56", "text": "呃，你把它放在你的背上。"}, {"type": "subtitle", "time": 959.67, "timestamp": "00:15:59", "text": "它就像齿轮一样。那是"}]
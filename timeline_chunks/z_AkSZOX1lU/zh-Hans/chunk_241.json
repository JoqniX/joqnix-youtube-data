[{"type": "subtitle", "time": 14463.83, "timestamp": "04:01:03", "text": "地方。我刚才站着站着的姿势有点不自然。"}, {"type": "subtitle", "time": 14465.91, "timestamp": "04:01:05", "text": "这就是我的模型排名不上的原因。"}, {"type": "subtitle", "time": 14470.07, "timestamp": "04:01:10", "text": "好的。所以我一般在5:30或5:45睡觉。我醒来"}, {"type": "subtitle", "time": 14474.389, "timestamp": "04:01:14", "text": "向上。呃，我去……呃，做这个直播，"}, {"type": "subtitle", "time": 14476.55, "timestamp": "04:01:16", "text": "早上做个自我介绍，嗯，还有……"}, {"type": "subtitle", "time": 14478.15, "timestamp": "04:01:18", "text": "开始新的一天。那我走"}, {"type": "subtitle", "time": 14480.59, "timestamp": "04:01:20", "text": "楼下，做一些呃"}, {"type": "subtitle", "time": 14482.91, "timestamp": "04:01:22", "text": "茶，回来"}, {"type": "subtitle", "time": 14486.469, "timestamp": "04:01:26", "text": "向上。也尽量吃早餐。"}, {"type": "subtitle", "time": 14489.269, "timestamp": "04:01:29", "text": "然后我们会玩一些游戏之类的。患病的"}, {"type": "subtitle", "time": 14491.429, "timestamp": "04:01:31", "text": "就算我累得筋疲力尽，也要尽量去做。"}, {"type": "subtitle", "time": 14494.91, "timestamp": "04:01:34", "text": "美好的。我会玩两个小时，拿"}, {"type": "subtitle", "time": 14497.75, "timestamp": "04:01:37", "text": "休息。呃，明天是星期六。我可能"}, {"type": "subtitle", "time": 14500.91, "timestamp": "04:01:40", "text": "我必须交作业。我的天哪。"}, {"type": "subtitle", "time": 14504.469, "timestamp": "04:01:44", "text": "啊，等等。嗯，星期一是我最后一天的约会。哦"}, {"type": "subtitle", "time": 14508.03, "timestamp": "04:01:48", "text": "不。我的天哪。我必须计划一下"}, {"type": "subtitle", "time": 14512.469, "timestamp": "04:01:52", "text": "出去。鱼儿入睡。不，不，不。是的。我 我"}, {"type": "subtitle", "time": 14513.389, "timestamp": "04:01:53", "text": "哦"}, {"type": "subtitle", "time": 14516.469, "timestamp": "04:01:56", "text": "天哪，我要打个盹儿。我想我会"}, {"type": "subtitle", "time": 14518.71, "timestamp": "04:01:58", "text": "在谷歌上搜索“如何小睡一会儿”，然后照做。"}]
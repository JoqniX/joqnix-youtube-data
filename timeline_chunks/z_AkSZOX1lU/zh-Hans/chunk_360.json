[{"type": "subtitle", "time": 21601.67, "timestamp": "06:00:01", "text": "我不知道，但希望至少是"}, {"type": "subtitle", "time": 21605.39, "timestamp": "06:00:05", "text": "值得一看吧？我希望至少"}, {"type": "subtitle", "time": 21608.868, "timestamp": "06:00:08", "text": "值得一看。所以，我只是希望，嗯，是的。"}, {"type": "subtitle", "time": 21610.628, "timestamp": "06:00:10", "text": "大家最近怎么样？是的。你好，罗伯特"}, {"type": "subtitle", "time": 21611.868, "timestamp": "06:00:11", "text": "杰克逊。"}, {"type": "subtitle", "time": 21613.39, "timestamp": "06:00:13", "text": "欢迎。"}, {"type": "subtitle", "time": 21621.83, "timestamp": "06:00:21", "text": "我们将进行主线任务"}, {"type": "subtitle", "time": 21625.03, "timestamp": "06:00:25", "text": "枯萎的波浪。然后，呃，等我做完之后"}, {"type": "subtitle", "time": 21627.91, "timestamp": "06:00:27", "text": "天气，呃，主线任务。好的。"}, {"type": "subtitle", "time": 21630.23, "timestamp": "06:00:30", "text": "完成主线任务后，我们将"}, {"type": "subtitle", "time": 21632.15, "timestamp": "06:00:32", "text": "正在做"}, {"type": "subtitle", "time": 21635.83, "timestamp": "06:00:35", "text": "呃，巨人任务，呃，同伴任务"}, {"type": "subtitle", "time": 21638.868, "timestamp": "06:00:38", "text": "作为巨人旗帜和同伴"}, {"type": "subtitle", "time": 21643.27, "timestamp": "06:00:43", "text": "类似活动的任务即将到来"}, {"type": "subtitle", "time": 21644.91, "timestamp": "06:00:44", "text": "省略"}, {"type": "subtitle", "time": 21647.91, "timestamp": "06:00:47", "text": "很快。所以我认为这会是个好主意"}, {"type": "subtitle", "time": 21650.07, "timestamp": "06:00:50", "text": "就像字面上，呃，你知道的，就那样吧"}, {"type": "subtitle", "time": 21652.31, "timestamp": "06:00:52", "text": "让我关掉它。会吗？"}, {"type": "subtitle", "time": 21656.59, "timestamp": "06:00:56", "text": "给我帧率？这样就能给我提供帧率了。"}, {"type": "subtitle", "time": 21659.67, "timestamp": "06:00:59", "text": "好的，关闭媒体源后……"}]
[{"type": "subtitle", "time": 26224.35, "timestamp": "07:17:04", "text": "我觉得很难得到"}, {"type": "subtitle", "time": 26228.628, "timestamp": "07:17:08", "text": "金钱和一切。就像"}, {"type": "subtitle", "time": 26232.43, "timestamp": "07:17:12", "text": "我的意思是，没错，它确实会提供原始物品。"}, {"type": "subtitle", "time": 26234.19, "timestamp": "07:17:14", "text": "[音乐]"}, {"type": "subtitle", "time": 26258.548, "timestamp": "07:17:38", "text": "轨。我认为他们缩短了男性部分。"}, {"type": "subtitle", "time": 26273.708, "timestamp": "07:17:53", "text": "做过？你认为我们必须战斗吗？"}]
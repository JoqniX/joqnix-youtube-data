[{"type": "subtitle", "time": 14520.429, "timestamp": "04:02:00", "text": "或许。"}, {"type": "subtitle", "time": 14524.229, "timestamp": "04:02:04", "text": "呃，问题是我不能指望我爸。"}, {"type": "subtitle", "time": 14526.229, "timestamp": "04:02:06", "text": "喜欢"}, {"type": "subtitle", "time": 14528.91, "timestamp": "04:02:08", "text": "呃，把我送到那里。"}, {"type": "subtitle", "time": 14532.469, "timestamp": "04:02:12", "text": "嗯，大学或者学院之类的，哪里"}, {"type": "subtitle", "time": 14535.51, "timestamp": "04:02:15", "text": "我必须提交作业。我认为"}, {"type": "subtitle", "time": 14538.63, "timestamp": "04:02:18", "text": "我还是自己去吧。我速度更快"}, {"type": "subtitle", "time": 14540.03, "timestamp": "04:02:20", "text": "我的"}, {"type": "subtitle", "time": 14542.83, "timestamp": "04:02:22", "text": "小型摩托车。呃，我只需要"}, {"type": "subtitle", "time": 14546.469, "timestamp": "04:02:26", "text": "速通旅程。我希望我能成功"}, {"type": "subtitle", "time": 14549.189, "timestamp": "04:02:29", "text": "及时。我希望我能呃避免呃不"}, {"type": "subtitle", "time": 14552.87, "timestamp": "04:02:32", "text": "避开交通拥堵，就像我一样"}, {"type": "subtitle", "time": 14555.59, "timestamp": "04:02:35", "text": "不知道直播何时结束"}, {"type": "subtitle", "time": 14560.15, "timestamp": "04:02:40", "text": "那段时间毫无希望，什么事都没发生，我只是"}, {"type": "subtitle", "time": 14562.349, "timestamp": "04:02:42", "text": "必须在……之前回来"}, {"type": "subtitle", "time": 14566.309, "timestamp": "04:02:46", "text": "晚上6点开第二股流"}, {"type": "subtitle", "time": 14567.309, "timestamp": "04:02:47", "text": "做"}, {"type": "subtitle", "time": 14569.75, "timestamp": "04:02:49", "text": "无论何时何地，都可以合作"}, {"type": "subtitle", "time": 14572.87, "timestamp": "04:02:52", "text": "合作将于11月12日结束，无论如何，请确保"}, {"type": "subtitle", "time": 14576.15, "timestamp": "04:02:56", "text": "我吃得早，早上6点吃，下午6点吃。"}, {"type": "subtitle", "time": 14578.55, "timestamp": "04:02:58", "text": "吃晚饭，吃点零食。"}]
[{"type": "subtitle", "time": 20761.51, "timestamp": "05:46:01", "text": "印痕。九个人看到了你的英勇。"}, {"type": "subtitle", "time": 20764.548, "timestamp": "05:46:04", "text": "目前为止，我已经拥有了大部分。我只需要"}, {"type": "subtitle", "time": 20766.548, "timestamp": "05:46:06", "text": "很多狼。"}, {"type": "subtitle", "time": 20768.83, "timestamp": "05:46:08", "text": "蒙特"}, {"type": "subtitle", "time": 20792.03, "timestamp": "05:46:32", "text": "这我大部分都明白了。"}, {"type": "subtitle", "time": 20793.548, "timestamp": "05:46:33", "text": "[音乐]"}, {"type": "subtitle", "time": 20811.788, "timestamp": "05:46:51", "text": "得到。六"}, {"type": "subtitle", "time": 20815.07, "timestamp": "05:46:55", "text": "郊狼。我真的听到“哦”了吗？"}]
[{"type": "subtitle", "time": 26042.07, "timestamp": "07:14:02", "text": "我能理解，但她会怎么做呢？"}, {"type": "subtitle", "time": 26046.79, "timestamp": "07:14:06", "text": "说出来？它在哪里？但"}, {"type": "subtitle", "time": 26056.73, "timestamp": "07:14:16", "text": "他们不明白。好吧。"}, {"type": "subtitle", "time": 26075.03, "timestamp": "07:14:35", "text": "嗯，仔细想想，总有一天我会……"}, {"type": "subtitle", "time": 26077.99, "timestamp": "07:14:37", "text": "把我说的话转录出来"}, {"type": "subtitle", "time": 26080.468, "timestamp": "07:14:40", "text": "曼德雷纳。"}, {"type": "subtitle", "time": 26083.468, "timestamp": "07:14:43", "text": "我考虑了一下。我当时就想，"}]
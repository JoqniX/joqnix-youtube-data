[{"type": "subtitle", "time": 4753.27, "timestamp": "01:19:13", "text": "铺床意味着这里摔跤不太过分"}, {"type": "subtitle", "time": 4755.51, "timestamp": "01:19:15", "text": "很久以前。他应该快到了。有"}, {"type": "subtitle", "time": 4757.59, "timestamp": "01:19:17", "text": "不同的狩猎方式，这样你就可以"}, {"type": "subtitle", "time": 4759.11, "timestamp": "01:19:19", "text": "密切关注这里，直到你接近为止"}, {"type": "subtitle", "time": 4761.669, "timestamp": "01:19:21", "text": "足以射杀或使用诱饵将其引诱过来"}, {"type": "subtitle", "time": 4763.83, "timestamp": "01:19:23", "text": "他对你来说。这里有很多空地"}, {"type": "subtitle", "time": 4765.55, "timestamp": "01:19:25", "text": "这使得跟踪行为变得可笑"}, {"type": "subtitle", "time": 4767.75, "timestamp": "01:19:27", "text": "难的。我们要引诱他过来，"}, {"type": "subtitle", "time": 4769.11, "timestamp": "01:19:29", "text": "如果你不知道怎么做，就应该蹲下。"}, {"type": "subtitle", "time": 4771.35, "timestamp": "01:19:31", "text": "和他说话。发送声音瞬间可以全部"}, {"type": "subtitle", "time": 4774.47, "timestamp": "01:19:34", "text": "跟动物说话。该死，我玩不了了"}]
[{"type": "subtitle", "time": 23941.548, "timestamp": "06:39:01", "text": "击败"}, {"type": "subtitle", "time": 23944.67, "timestamp": "06:39:04", "text": "fracticus。好的，我们开始吧"}, {"type": "subtitle", "time": 23950.51, "timestamp": "06:39:10", "text": "去。我的天啊，我的尤林击中了"}, {"type": "subtitle", "time": 23953.19, "timestamp": "06:39:13", "text": "难的。哦，对了，我忘了说我"}, {"type": "subtitle", "time": 23955.11, "timestamp": "06:39:15", "text": "没能完全发挥她的潜力，甚至连……"}, {"type": "subtitle", "time": 23960.51, "timestamp": "06:39:20", "text": "标题中的天才人物，所以没有什么可说的。"}, {"type": "subtitle", "time": 23964.868, "timestamp": "06:39:24", "text": "做。我只需要解锁boss就行了"}, {"type": "subtitle", "time": 23977.628, "timestamp": "06:39:37", "text": "[音乐]"}]
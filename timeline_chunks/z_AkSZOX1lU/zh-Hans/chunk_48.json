[{"type": "subtitle", "time": 2880.63, "timestamp": "00:48:00", "text": "你。我阅读日语很慢。两个都"}, {"type": "subtitle", "time": 2883.349, "timestamp": "00:48:03", "text": "平假名和片假名。何时才是最佳时机"}, {"type": "subtitle", "time": 2885.95, "timestamp": "00:48:05", "text": "既然有汉字，我就跳过。"}, {"type": "subtitle", "time": 2919.91, "timestamp": "00:48:39", "text": "完毕。再见。你要离开了。你好。拿"}, {"type": "subtitle", "time": 2931.91, "timestamp": "00:48:51", "text": "是啊，中国现在真的很晚了。"}, {"type": "subtitle", "time": 2934.19, "timestamp": "00:48:54", "text": "就像"}, {"type": "subtitle", "time": 2938.549, "timestamp": "00:48:58", "text": "12. 人们正准备睡觉或离开"}]
[{"type": "subtitle", "time": 21061.59, "timestamp": "05:51:01", "text": "现在，是的，从顶部开始，呃，谁都"}, {"type": "subtitle", "time": 21066.03, "timestamp": "05:51:06", "text": "今天来的人都是花田"}, {"type": "subtitle", "time": 21068.03, "timestamp": "05:51:08", "text": "即将到来"}, {"type": "subtitle", "time": 21070.84, "timestamp": "05:51:10", "text": "来找人了。"}, {"type": "subtitle", "time": 21076.83, "timestamp": "05:51:16", "text": "呃，我"}, {"type": "subtitle", "time": 21084.11, "timestamp": "05:51:24", "text": "他妈的"}, {"type": "subtitle", "time": 21091.97, "timestamp": "05:51:31", "text": "男人。抓住"}, {"type": "subtitle", "time": 21094.75, "timestamp": "05:51:34", "text": "[音乐]"}, {"type": "subtitle", "time": 21111.51, "timestamp": "05:51:51", "text": "蜂蜜。嗨，这些人就是……"}, {"type": "subtitle", "time": 21114.23, "timestamp": "05:51:54", "text": "他积极参与聊天，并和我交谈。"}, {"type": "subtitle", "time": 21116.868, "timestamp": "05:51:56", "text": "今天在直播间和所有潜水的观众"}, {"type": "subtitle", "time": 21119.51, "timestamp": "05:51:59", "text": "我因为过来并锁定而得到了奖励"}]
[{"type": "subtitle", "time": 841.67, "timestamp": "00:14:01", "text": "我打算把它剪辑成一个片段。"}, {"type": "subtitle", "time": 844.03, "timestamp": "00:14:04", "text": "喝"}, {"type": "subtitle", "time": 846.79, "timestamp": "00:14:06", "text": "长的。他有一个很大的。这是什么？"}, {"type": "subtitle", "time": 853.509, "timestamp": "00:14:13", "text": "不过我有一个很大的，我睡在里面。"}, {"type": "subtitle", "time": 856.15, "timestamp": "00:14:16", "text": "我睡觉时就抱着它。我的意思是，我没说"}, {"type": "subtitle", "time": 858.31, "timestamp": "00:14:18", "text": "那。我的意思是，是的。吃一大杯"}, {"type": "subtitle", "time": 876.069, "timestamp": "00:14:36", "text": "因为人们可能会断章取义。"}, {"type": "subtitle", "time": 880.55, "timestamp": "00:14:40", "text": "这个大笨蛋。我想要一个圣洁的"}, {"type": "subtitle", "time": 880.95, "timestamp": "00:14:40", "text": "烟枪"}, {"type": "subtitle", "time": 882.189, "timestamp": "00:14:42", "text": "[音乐]"}, {"type": "subtitle", "time": 890.269, "timestamp": "00:14:50", "text": "H. 好的。也一样。最后"}, {"type": "subtitle", "time": 893.59, "timestamp": "00:14:53", "text": "一。自从我搬家后就一直这样。等等，我刚才是不是……"}]
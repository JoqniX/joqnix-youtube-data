[{"type": "subtitle", "time": 10621.59, "timestamp": "02:57:01", "text": "他的妻子被杀害了。"}, {"type": "subtitle", "time": 10626.11, "timestamp": "02:57:06", "text": "我们身上仍然存在的那部分"}, {"type": "subtitle", "time": 10630.99, "timestamp": "02:57:10", "text": "包含。我们必须超越动物的范畴。"}, {"type": "subtitle", "time": 10633.69, "timestamp": "02:57:13", "text": "链条。它有毒。"}, {"type": "subtitle", "time": 10636.51, "timestamp": "02:57:16", "text": "[音乐]"}, {"type": "subtitle", "time": 10640.07, "timestamp": "02:57:20", "text": "那。你愿意让风告诉你答案吗？"}, {"type": "subtitle", "time": 10642.18, "timestamp": "02:57:22", "text": "去哪儿？"}, {"type": "subtitle", "time": 10643.51, "timestamp": "02:57:23", "text": "[音乐]"}, {"type": "subtitle", "time": 10647.71, "timestamp": "02:57:27", "text": "如果你能打破命运并证明这一点"}, {"type": "subtitle", "time": 10650.67, "timestamp": "02:57:30", "text": "错误的。哇。"}, {"type": "subtitle", "time": 10659.15, "timestamp": "02:57:39", "text": "[音乐]"}, {"type": "subtitle", "time": 10661.95, "timestamp": "02:57:41", "text": "哇。至"}, {"type": "subtitle", "time": 10664.67, "timestamp": "02:57:44", "text": "世界。至"}, {"type": "subtitle", "time": 10676.03, "timestamp": "02:57:56", "text": "荒野。至"}]
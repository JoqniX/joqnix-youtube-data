[{"type": "subtitle", "time": 18640.55, "timestamp": "05:10:40", "text": "韦恩。不。我的天哪。你是认真的吗？"}, {"type": "subtitle", "time": 18643.948, "timestamp": "05:10:43", "text": "我刚才是不是跳进了……"}, {"type": "subtitle", "time": 18646.47, "timestamp": "05:10:46", "text": "湖？哦，是的，他要进去了。好的。"}, {"type": "subtitle", "time": 18648.39, "timestamp": "05:10:48", "text": "好，好，好，好，好。我这就去"}]
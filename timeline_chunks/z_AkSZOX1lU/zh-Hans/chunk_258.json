[{"type": "subtitle", "time": 15480.149, "timestamp": "04:18:00", "text": "我想联系一些人。"}, {"type": "subtitle", "time": 15482.349, "timestamp": "04:18:02", "text": "出去，但又感觉像我"}, {"type": "subtitle", "time": 15485.309, "timestamp": "04:18:05", "text": "但问题是……"}, {"type": "subtitle", "time": 15489.11, "timestamp": "04:18:09", "text": "巴卡萨基，有这么一种东西叫你的"}, {"type": "subtitle", "time": 15492.07, "timestamp": "04:18:12", "text": "呃，他们决定的数字"}, {"type": "subtitle", "time": 15495.95, "timestamp": "04:18:15", "text": "数字之类的东西，我讨厌"}, {"type": "subtitle", "time": 15497.469, "timestamp": "04:18:17", "text": "那"}, {"type": "subtitle", "time": 15500.469, "timestamp": "04:18:20", "text": "为什么关键不在于数字"}, {"type": "subtitle", "time": 15503.11, "timestamp": "04:18:23", "text": "数字本身没有任何意义，对吧？"}, {"type": "subtitle", "time": 15506.71, "timestamp": "04:18:26", "text": "拥有百万订阅者，或者如果你有"}, {"type": "subtitle", "time": 15508.71, "timestamp": "04:18:28", "text": "100个订阅者，没关系。什么"}, {"type": "subtitle", "time": 15510.11, "timestamp": "04:18:30", "text": "事情是这样的"}, {"type": "subtitle", "time": 15512.03, "timestamp": "04:18:32", "text": "人，"}, {"type": "subtitle", "time": 15537.91, "timestamp": "04:18:57", "text": "所以，呃，我可能需要做点什么。"}]
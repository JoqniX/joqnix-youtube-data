[{"type": "subtitle", "time": 660.59, "timestamp": "00:11:00", "text": "好的，那我们一个一个地来，我"}, {"type": "subtitle", "time": 663.71, "timestamp": "00:11:03", "text": "相信。好的。调高音量。所以，我们是"}, {"type": "subtitle", "time": 669.11, "timestamp": "00:11:09", "text": "我猜是做五个。完成了吗？"}, {"type": "subtitle", "time": 671.509, "timestamp": "00:11:11", "text": "好的，等我们上传完五个视频片段，"}, {"type": "subtitle", "time": 675.03, "timestamp": "00:11:15", "text": "这件事可能很快就会完成。"}, {"type": "subtitle", "time": 677.79, "timestamp": "00:11:17", "text": "嗯，是的，没问题。它是"}, {"type": "subtitle", "time": 681.389, "timestamp": "00:11:21", "text": "美好的。一、二、三、四"}, {"type": "subtitle", "time": 687.39, "timestamp": "00:11:27", "text": "好的。第一的"}, {"type": "subtitle", "time": 689.71, "timestamp": "00:11:29", "text": "[音乐]"}, {"type": "subtitle", "time": 693.269, "timestamp": "00:11:33", "text": "一。然后接下来，呃，接下来的一切都是"}, {"type": "subtitle", "time": 696.069, "timestamp": "00:11:36", "text": "就像手部摄像头直播一样。让我看看"}, {"type": "subtitle", "time": 698.03, "timestamp": "00:11:38", "text": "它。"}, {"type": "subtitle", "time": 703.15, "timestamp": "00:11:43", "text": "但速溶咖啡是100%纯的"}, {"type": "subtitle", "time": 705.75, "timestamp": "00:11:45", "text": "咖啡不好喝。我不能喜欢使用"}, {"type": "subtitle", "time": 715.35, "timestamp": "00:11:55", "text": "很多。我记得这件事。哦，对了，"}, {"type": "subtitle", "time": 718.47, "timestamp": "00:11:58", "text": "今天要接受摄像头惩罚。"}]
[{"type": "subtitle", "time": 18660.91, "timestamp": "05:11:00", "text": "是的，她"}, {"type": "subtitle", "time": 18693.67, "timestamp": "05:11:33", "text": "好吧，他先去把他找来了。如何"}, {"type": "subtitle", "time": 18697.27, "timestamp": "05:11:37", "text": "之后我还需要跑很多趟吗？呃"}, {"type": "subtitle", "time": 18700.47, "timestamp": "05:11:40", "text": "16、17、18、19、20、21。再得五分。"}, {"type": "subtitle", "time": 18716.948, "timestamp": "05:11:56", "text": "说得对。别信这个。"}, {"type": "subtitle", "time": 18718.75, "timestamp": "05:11:58", "text": "怎么样？"}]
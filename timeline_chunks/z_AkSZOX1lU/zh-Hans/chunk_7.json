[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "呃，是疲劳。我想我应该……"}, {"type": "subtitle", "time": 422.87, "timestamp": "00:07:02", "text": "就这么称呼它"}, {"type": "subtitle", "time": 424.35, "timestamp": "00:07:04", "text": "呃，不"}, {"type": "subtitle", "time": 429.029, "timestamp": "00:07:09", "text": "流。啊，我说"}, {"type": "subtitle", "time": 432.11, "timestamp": "00:07:12", "text": "嗯，是的，由于疲劳和"}, {"type": "subtitle", "time": 435.029, "timestamp": "00:07:15", "text": "我觉得很内疚，因为我正在做这些事。"}, {"type": "subtitle", "time": 439.87, "timestamp": "00:07:19", "text": "VOD 和离开时未在场"}, {"type": "subtitle", "time": 443.589, "timestamp": "00:07:23", "text": "溪流。但是，是的，我真的很想成为"}, {"type": "subtitle", "time": 445.909, "timestamp": "00:07:25", "text": "在这里至少连续待了12个小时，"}, {"type": "subtitle", "time": 448.189, "timestamp": "00:07:28", "text": "男人。"}, {"type": "subtitle", "time": 452.27, "timestamp": "00:07:32", "text": "唉，我为自己长时间的……感到内疚"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "休息一下，因为不，我一直都在做这件事"}, {"type": "subtitle", "time": 458.30899999999997, "timestamp": "00:07:38", "text": "已经过去几个月了？它将"}, {"type": "subtitle", "time": 465.589, "timestamp": "00:07:45", "text": "很快。 10到11。这很小。"}, {"type": "subtitle", "time": 468.87, "timestamp": "00:07:48", "text": "已经几个小时了。是啊，我忘了。是的，现在"}, {"type": "subtitle", "time": 472.39, "timestamp": "00:07:52", "text": "我每天24小时都在直播，"}, {"type": "subtitle", "time": 478.469, "timestamp": "00:07:58", "text": "嗯，10到11个小时对我来说似乎太短了。"}]
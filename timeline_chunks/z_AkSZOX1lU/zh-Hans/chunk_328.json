[{"type": "subtitle", "time": 19692.43, "timestamp": "05:28:12", "text": "满的。我完成了"}, {"type": "subtitle", "time": 19709.51, "timestamp": "05:28:29", "text": "哎呀，我喝了好多水。我的肚子"}, {"type": "subtitle", "time": 19711.27, "timestamp": "05:28:31", "text": "已满。"}, {"type": "subtitle", "time": 19720.43, "timestamp": "05:28:40", "text": "然后是“风暴大衣行动”。"}, {"type": "subtitle", "time": 19723.43, "timestamp": "05:28:43", "text": "当地一群鸡躲起来了"}]
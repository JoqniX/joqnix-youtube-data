[{"type": "subtitle", "time": 13626.55, "timestamp": "03:47:06", "text": "现在就是这样。我好困惑。什么"}, {"type": "subtitle", "time": 13630.62, "timestamp": "03:47:10", "text": "做？我应该玩哪个游戏？"}, {"type": "subtitle", "time": 13633.55, "timestamp": "03:47:13", "text": "[音乐]"}, {"type": "subtitle", "time": 13646.83, "timestamp": "03:47:26", "text": "东西？所以"}, {"type": "subtitle", "time": 13650.469, "timestamp": "03:47:30", "text": "我很困惑，因为现在我的电脑性能有限。"}, {"type": "subtitle", "time": 13650.92, "timestamp": "03:47:30", "text": "是"}, {"type": "subtitle", "time": 13652.349, "timestamp": "03:47:32", "text": "[音乐]"}, {"type": "subtitle", "time": 13660.71, "timestamp": "03:47:40", "text": "是的，我安装了这款游戏，叫做"}, {"type": "subtitle", "time": 13663.269, "timestamp": "03:47:43", "text": "长狗。所以，明天我们将演奏那首曲子。"}, {"type": "subtitle", "time": 13667.11, "timestamp": "03:47:47", "text": "生存工艺，呃，一种更狂野的游戏，"}, {"type": "subtitle", "time": 13669.95, "timestamp": "03:47:49", "text": "野生动物生存"}, {"type": "subtitle", "time": 13673.63, "timestamp": "03:47:53", "text": "玩游戏，看看效果如何。"}]
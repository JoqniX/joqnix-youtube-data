[{"type": "subtitle", "time": 25563.59, "timestamp": "07:06:03", "text": "然后？你如何玩弄你的前任？"}, {"type": "subtitle", "time": 25566.628, "timestamp": "07:06:06", "text": "游戏？我不知道。如果你这样做呢？"}, {"type": "subtitle", "time": 25568.99, "timestamp": "07:06:08", "text": "全部"}, {"type": "subtitle", "time": 25571.91, "timestamp": "07:06:11", "text": "那些？你会如何直播？我不直播"}, {"type": "subtitle", "time": 25574.868, "timestamp": "07:06:14", "text": "你会怎么做？我认为是"}, {"type": "subtitle", "time": 25577.75, "timestamp": "07:06:17", "text": "就像回声狩猎一样，对吧？获得"}, {"type": "subtitle", "time": 25580.868, "timestamp": "07:06:20", "text": "最好的回声效果等等。农业"}, {"type": "subtitle", "time": 25581.92, "timestamp": "07:06:21", "text": "某种文物"}, {"type": "subtitle", "time": 25583.788, "timestamp": "07:06:23", "text": "[音乐]"}, {"type": "subtitle", "time": 25599.15, "timestamp": "07:06:39", "text": "猜测。我心想，老兄，我就是想要"}, {"type": "subtitle", "time": 25600.99, "timestamp": "07:06:40", "text": "到"}, {"type": "subtitle", "time": 25610.788, "timestamp": "07:06:50", "text": "知道吗，多么壮丽的雨啊。安可"}, {"type": "subtitle", "time": 25615.19, "timestamp": "07:06:55", "text": "全部结算完毕。她为什么这么可爱？"}]
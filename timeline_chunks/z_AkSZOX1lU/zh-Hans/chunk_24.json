[{"type": "subtitle", "time": 1443.19, "timestamp": "00:24:03", "text": "D，那个大的，不受欢迎，买的"}, {"type": "subtitle", "time": 1445.669, "timestamp": "00:24:05", "text": "小的和大的，我，我"}, {"type": "subtitle", "time": 1450.59, "timestamp": "00:24:10", "text": "和……一起睡觉。我想念我以前用来玩的玩具。"}, {"type": "subtitle", "time": 1453.39, "timestamp": "00:24:13", "text": "ASMR。我有一个大的"}, {"type": "subtitle", "time": 1455.31, "timestamp": "00:24:15", "text": "尽管。"}, {"type": "subtitle", "time": 1477.669, "timestamp": "00:24:37", "text": "这种中心中心的东西"}, {"type": "subtitle", "time": 1481.43, "timestamp": "00:24:41", "text": "等等，我还有什么吗？"}, {"type": "subtitle", "time": 1483.35, "timestamp": "00:24:43", "text": "哦，猎人经典赛结束了。我可以"}, {"type": "subtitle", "time": 1485.549, "timestamp": "00:24:45", "text": "有流"}, {"type": "subtitle", "time": 1488.95, "timestamp": "00:24:48", "text": "目前任何设备都可以上传五个文件。"}, {"type": "subtitle", "time": 1498.11, "timestamp": "00:24:58", "text": "[音乐]"}]
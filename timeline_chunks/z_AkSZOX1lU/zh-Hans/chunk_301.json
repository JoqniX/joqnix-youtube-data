[{"type": "subtitle", "time": 18069.11, "timestamp": "05:01:09", "text": "我很好奇《星际战甲》（Warframe）会是什么样子。如果"}, {"type": "subtitle", "time": 18071.91, "timestamp": "05:01:11", "text": "命运就是这样，我很好奇它是如何发生的。"}, {"type": "subtitle", "time": 18082.83, "timestamp": "05:01:22", "text": "哦，我饿了。"}, {"type": "subtitle", "time": 18089.91, "timestamp": "05:01:29", "text": "一。哦，已经是1了。之后"}, {"type": "subtitle", "time": 18093.83, "timestamp": "05:01:33", "text": "罢工，我去弄点吃的。"}, {"type": "subtitle", "time": 18115.51, "timestamp": "05:01:55", "text": "船。等等，好像有点卡顿。这到底是怎么回事"}]
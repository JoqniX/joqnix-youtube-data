[{"type": "subtitle", "time": 22141.59, "timestamp": "06:09:01", "text": "不看书更容易些。但是"}, {"type": "subtitle", "time": 22145.59, "timestamp": "06:09:05", "text": "唯一的问题是……名字，对吧，名字"}, {"type": "subtitle", "time": 22148.39, "timestamp": "06:09:08", "text": "我无法见到的那个人"}, {"type": "subtitle", "time": 22152.43, "timestamp": "06:09:12", "text": "记住谁是谁，谁是谁"}, {"type": "subtitle", "time": 22155.91, "timestamp": "06:09:15", "text": "这是因为这个名字现在是中文的。"}, {"type": "subtitle", "time": 22158.47, "timestamp": "06:09:18", "text": "中文名字有不同的名称。"}, {"type": "subtitle", "time": 22160.868, "timestamp": "06:09:20", "text": "呃，就像某种含义之类的，我不知道。"}, {"type": "subtitle", "time": 22163.03, "timestamp": "06:09:23", "text": "知道"}, {"type": "subtitle", "time": 22168.788, "timestamp": "06:09:28", "text": "对，还有汉字什么的，对吧？"}, {"type": "subtitle", "time": 22171.27, "timestamp": "06:09:31", "text": "是的，我50岁了，是的，我知道你50岁了。"}, {"type": "subtitle", "time": 22174.708, "timestamp": "06:09:34", "text": "是的。是的。我正在学习习惯"}, {"type": "subtitle", "time": 22178.23, "timestamp": "06:09:38", "text": "现在可以看到用户名了。你呢"}, {"type": "subtitle", "time": 22181.59, "timestamp": "06:09:41", "text": "有七个，比如十七岁之类的"}, {"type": "subtitle", "time": 22185.628, "timestamp": "06:09:45", "text": "在你身上。是的，那会有点帮助。"}, {"type": "subtitle", "time": 22187.708, "timestamp": "06:09:47", "text": "少量。"}, {"type": "subtitle", "time": 22191.23, "timestamp": "06:09:51", "text": "嗯，是的。呃"}, {"type": "subtitle", "time": 22194.948, "timestamp": "06:09:54", "text": "今天我在想我们会做什么。我们可以呃"}, {"type": "subtitle", "time": 22196.91, "timestamp": "06:09:56", "text": "完成主线任务。"}]
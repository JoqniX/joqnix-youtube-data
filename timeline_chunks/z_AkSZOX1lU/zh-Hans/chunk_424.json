[{"type": "subtitle", "time": 25440.83, "timestamp": "07:04:00", "text": "植物。它们真的是来自黑色的吗？"}, {"type": "subtitle", "time": 25442.948, "timestamp": "07:04:02", "text": "注射？至少他们很擅长跑步。"}, {"type": "subtitle", "time": 25445.43, "timestamp": "07:04:05", "text": "我承认这一点。我跟谁说过什么？"}, {"type": "subtitle", "time": 25446.868, "timestamp": "07:04:06", "text": "你？"}, {"type": "subtitle", "time": 25449.03, "timestamp": "07:04:09", "text": "我怪你，所以我才不知道这件事。"}, {"type": "subtitle", "time": 25467.708, "timestamp": "07:04:27", "text": "[音乐]"}, {"type": "subtitle", "time": 25471.27, "timestamp": "07:04:31", "text": "破解版应该可以帮你解锁。你要走了"}, {"type": "subtitle", "time": 25472.99, "timestamp": "07:04:32", "text": "那里。请"}, {"type": "subtitle", "time": 25475.6, "timestamp": "07:04:35", "text": "开锁。好了，我们得走了。"}, {"type": "subtitle", "time": 25483.31, "timestamp": "07:04:43", "text": "佩库利亚·布莱克·布鲁姆。好的。 600 XP。"}, {"type": "subtitle", "time": 25486.15, "timestamp": "07:04:46", "text": "好的。哦，是的。你可以立即升级"}, {"type": "subtitle", "time": 25490.548, "timestamp": "07:04:50", "text": "非常用力。因为我在讲故事。"}, {"type": "subtitle", "time": 25491.39, "timestamp": "07:04:51", "text": "寻求"}, {"type": "subtitle", "time": 25494.468, "timestamp": "07:04:54", "text": "现在。好的。"}, {"type": "subtitle", "time": 25496.948, "timestamp": "07:04:56", "text": "我的问题是，你接下来会怎么做？"}]
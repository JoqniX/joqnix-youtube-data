[{"type": "subtitle", "time": 15660.63, "timestamp": "04:21:00", "text": "东西。大多数时候，我是一个……"}, {"type": "subtitle", "time": 15663.99, "timestamp": "04:21:03", "text": "呃，不要用接近的方式。"}, {"type": "subtitle", "time": 15666.75, "timestamp": "04:21:06", "text": "为了合作。我这么做只是为了"}, {"type": "subtitle", "time": 15670.79, "timestamp": "04:21:10", "text": "除此之外，我还有一两次没有"}, {"type": "subtitle", "time": 15673.59, "timestamp": "04:21:13", "text": "去做。大多数时候，呃，人们会来"}, {"type": "subtitle", "time": 15674.59, "timestamp": "04:21:14", "text": "到"}, {"type": "subtitle", "time": 15678.469, "timestamp": "04:21:18", "text": "我。所以如果我要联系别人，我需要"}, {"type": "subtitle", "time": 15681.67, "timestamp": "04:21:21", "text": "要先了解这个人，对吧？也"}, {"type": "subtitle", "time": 15684.71, "timestamp": "04:21:24", "text": "我最不想做的就是盲目行事。"}, {"type": "subtitle", "time": 15687.83, "timestamp": "04:21:27", "text": "合作。我应该知道是谁"}, {"type": "subtitle", "time": 15691.51, "timestamp": "04:21:31", "text": "我将处理并陪伴"}, {"type": "subtitle", "time": 15694.469, "timestamp": "04:21:34", "text": "和朋友一起玩，一起感受氛围。如何如何"}, {"type": "subtitle", "time": 15697.51, "timestamp": "04:21:37", "text": "他们会喜欢我的风格吗？我们会……"}, {"type": "subtitle", "time": 15702.469, "timestamp": "04:21:42", "text": "感觉能连接起来，然后就……之类的？做"}, {"type": "subtitle", "time": 15705.67, "timestamp": "04:21:45", "text": "oo 检查。"}, {"type": "subtitle", "time": 15707.429, "timestamp": "04:21:47", "text": "Epic Games 上有优惠活动。"}, {"type": "subtitle", "time": 15711.51, "timestamp": "04:21:51", "text": "上星期。哦，是的。呃，古墓丽影。"}, {"type": "subtitle", "time": 15714.91, "timestamp": "04:21:54", "text": "三位古墓丽影"}, {"type": "subtitle", "time": 15718.59, "timestamp": "04:21:58", "text": "这些游戏都是免费的。"}]
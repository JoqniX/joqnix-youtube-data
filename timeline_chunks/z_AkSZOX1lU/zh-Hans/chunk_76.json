[{"type": "subtitle", "time": 4567.51, "timestamp": "01:16:07", "text": "好的。你看那道细细的发光弧线"}, {"type": "subtitle", "time": 4570.07, "timestamp": "01:16:10", "text": "这是否暗示了什么？如果你已经是"}, {"type": "subtitle", "time": 4572.55, "timestamp": "01:16:12", "text": "追踪动物，全靠物理标记。"}, {"type": "subtitle", "time": 4575.83, "timestamp": "01:16:15", "text": "将拥有一个更大的穹顶。前往"}, {"type": "subtitle", "time": 4578.189, "timestamp": "01:16:18", "text": "第一首歌，你就会看到"}, {"type": "subtitle", "time": 4581.43, "timestamp": "01:16:21", "text": "差异。身份追踪服装"}, {"type": "subtitle", "time": 4584.07, "timestamp": "01:16:24", "text": "脚印、粪便、寝具或音频"}, {"type": "subtitle", "time": 4586.149, "timestamp": "01:16:26", "text": "提高你的追踪技能，这将"}, {"type": "subtitle", "time": 4587.75, "timestamp": "01:16:27", "text": "提供更多细节并创建"}, {"type": "subtitle", "time": 4590.709, "timestamp": "01:16:30", "text": "赛道信息作为技能"}, {"type": "subtitle", "time": 4592.39, "timestamp": "01:16:32", "text": "增加。侦察和射击"}, {"type": "subtitle", "time": 4594.709, "timestamp": "01:16:34", "text": "你的其他主要技能，例如开始"}, {"type": "subtitle", "time": 4596.709, "timestamp": "01:16:36", "text": "像我一样开始关注他们吧。"}, {"type": "subtitle", "time": 4619.229, "timestamp": "01:16:59", "text": "追踪"}]
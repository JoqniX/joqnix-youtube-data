[{"type": "subtitle", "time": 481.67, "timestamp": "00:08:01", "text": "但是，是的，当我在日本的时候"}, {"type": "subtitle", "time": 483.83, "timestamp": "00:08:03", "text": "从七月开始，我觉得我可能没法直播了。"}, {"type": "subtitle", "time": 484.99, "timestamp": "00:08:04", "text": "像这样"}, {"type": "subtitle", "time": 487.67, "timestamp": "00:08:07", "text": "不再是了。至少两年内，我不能"}, {"type": "subtitle", "time": 491.43, "timestamp": "00:08:11", "text": "像这样直播。我只能直播呃"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "晚上有空的时候。所以，在"}, {"type": "subtitle", "time": 502.15, "timestamp": "00:08:22", "text": "可惜，这太糟糕了。所以我走了"}, {"type": "subtitle", "time": 505.35, "timestamp": "00:08:25", "text": "充分利用我所有的时间。"}, {"type": "subtitle", "time": 507.55, "timestamp": "00:08:27", "text": "直到"}, {"type": "subtitle", "time": 510.629, "timestamp": "00:08:30", "text": "但我们这样做只是因为"}, {"type": "subtitle", "time": 514.7090000000001, "timestamp": "00:08:34", "text": "因为我在攒钱，所以要参加运动会，而且我们"}, {"type": "subtitle", "time": 516.75, "timestamp": "00:08:36", "text": "正在参加这项亚马拉松比赛"}, {"type": "subtitle", "time": 520.829, "timestamp": "00:08:40", "text": "为新型号筹集资金"}, {"type": "subtitle", "time": 529.91, "timestamp": "00:08:49", "text": "是的，我一直都说黑暗是纯粹的"}, {"type": "subtitle", "time": 532.71, "timestamp": "00:08:52", "text": "并这么说。是的。"}, {"type": "subtitle", "time": 535.59, "timestamp": "00:08:55", "text": "哦，出什么事了？什么？你做了什么？"}]
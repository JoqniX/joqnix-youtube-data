[{"type": "subtitle", "time": 26340.468, "timestamp": "07:19:00", "text": "阴天，正是寻宝的好时机。为什么"}, {"type": "subtitle", "time": 26343.39, "timestamp": "07:19:03", "text": "她是不是超级可爱？我现在就要她。"}, {"type": "subtitle", "time": 26346.83, "timestamp": "07:19:06", "text": "等等，我有 24 个 PS。"}, {"type": "subtitle", "time": 26350.548, "timestamp": "07:19:10", "text": "好的。我希望我的迷你中型 MIDI 设备"}, {"type": "subtitle", "time": 26353.03, "timestamp": "07:19:13", "text": "它能让我立即放大，但是"}, {"type": "subtitle", "time": 26355.708, "timestamp": "07:19:15", "text": "必须手动按下按钮。"}, {"type": "subtitle", "time": 26358.59, "timestamp": "07:19:18", "text": "哦，呃，"}, {"type": "subtitle", "time": 26362.03, "timestamp": "07:19:22", "text": "等待。如你所见，我拥有"}, {"type": "subtitle", "time": 26365.11, "timestamp": "07:19:25", "text": "24. 嗯，这还不够，但我们会"}, {"type": "subtitle", "time": 26370.27, "timestamp": "07:19:30", "text": "不是？"}, {"type": "subtitle", "time": 26372.67, "timestamp": "07:19:32", "text": "哦，我们没得到"}, {"type": "subtitle", "time": 26383.23, "timestamp": "07:19:43", "text": "她正式成为"}, {"type": "subtitle", "time": 26386.43, "timestamp": "07:19:46", "text": "um序列"}, {"type": "subtitle", "time": 26389.59, "timestamp": "07:19:49", "text": "6. 我的天哪，她真的变成了"}, {"type": "subtitle", "time": 26397.708, "timestamp": "07:19:57", "text": "哦，实际上"}, {"type": "subtitle", "time": 26399.708, "timestamp": "07:19:59", "text": "好的。"}]
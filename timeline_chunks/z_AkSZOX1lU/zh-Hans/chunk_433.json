[{"type": "subtitle", "time": 25980.788, "timestamp": "07:13:00", "text": "你还在等什么？你知道她在哪里说的吗？"}, {"type": "subtitle", "time": 25983.788, "timestamp": "07:13:03", "text": "那？一整天。"}, {"type": "subtitle", "time": 25987.19, "timestamp": "07:13:07", "text": "什么？你们愿意让我带走你们所有人吗？"}, {"type": "subtitle", "time": 25996.548, "timestamp": "07:13:16", "text": "有座位吗？我的天啊。是的，你确实有。你是"}, {"type": "subtitle", "time": 25998.5, "timestamp": "07:13:18", "text": "瓦卡真是太幸运了。"}, {"type": "subtitle", "time": 26000.99, "timestamp": "07:13:20", "text": "[音乐]"}, {"type": "subtitle", "time": 26005.11, "timestamp": "07:13:25", "text": "该死。等等，他们有"}, {"type": "subtitle", "time": 26008.35, "timestamp": "07:13:28", "text": "好多语音台词啊。"}, {"type": "subtitle", "time": 26015.19, "timestamp": "07:13:35", "text": "凉爽的。我很惊讶《如龙0》"}, {"type": "subtitle", "time": 26018.75, "timestamp": "07:13:38", "text": "对我来说运行流畅，但对其他人来说却并非如此。"}, {"type": "subtitle", "time": 26023.19, "timestamp": "07:13:43", "text": "他自己。嘿，你好。我们切换回呃"}, {"type": "subtitle", "time": 26024.33, "timestamp": "07:13:44", "text": "普通话。"}, {"type": "subtitle", "time": 26030.628, "timestamp": "07:13:50", "text": "因为我正在学习它，所以我需要获得"}, {"type": "subtitle", "time": 26035.91, "timestamp": "07:13:55", "text": "这。等等，她会怎么说呢？"}, {"type": "subtitle", "time": 26038.948, "timestamp": "07:13:58", "text": "普通话？让我看看。而且情况并非如此"}]
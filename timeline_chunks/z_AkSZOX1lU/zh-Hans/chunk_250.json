[{"type": "subtitle", "time": 15003.71, "timestamp": "04:10:03", "text": "猜测。是啊，兄弟。我这就走"}, {"type": "subtitle", "time": 15006.79, "timestamp": "04:10:06", "text": "美联社。是的。各位晚安。"}, {"type": "subtitle", "time": 15009.63, "timestamp": "04:10:09", "text": "睡得好。我要去"}, {"type": "subtitle", "time": 15011.67, "timestamp": "04:10:11", "text": "晚安。晚安。晚安。"}, {"type": "subtitle", "time": 15014.399, "timestamp": "04:10:14", "text": "晚安。晚安。 我打算这么做。我知道现在是10点30分，"}, {"type": "subtitle", "time": 15017.439, "timestamp": "04:10:17", "text": "我打算这么做。我知道现在是10点30分， 但万一我睡着了，我们仍然会"}, {"type": "subtitle", "time": 15019.92, "timestamp": "04:10:19", "text": "但万一我睡着了，我们仍然会 做 10:30。万一我无法醒来"}, {"type": "subtitle", "time": 15023.12, "timestamp": "04:10:23", "text": "做 10:30。万一我无法醒来 6点钟，我还是会……我仍然计划……"}, {"type": "subtitle", "time": 15026.88, "timestamp": "04:10:26", "text": "6点钟，我还是会……我仍然计划…… 夜间新流"}, {"type": "subtitle", "time": 15029.439, "timestamp": "04:10:29", "text": "夜间新流 至少在下午6点。好的。所以，是的，尽情享受吧。"}, {"type": "subtitle", "time": 15033.12, "timestamp": "04:10:33", "text": "至少在下午6点。好的。所以，是的，尽情享受吧。 伏特加。晚安。再见。尤其"}, {"type": "subtitle", "time": 15036.56, "timestamp": "04:10:36", "text": "伏特加。晚安。再见。尤其 我高中时的两个呃，不是高中"}, {"type": "subtitle", "time": 15040.279, "timestamp": "04:10:40", "text": "我高中时的两个呃，不是高中 学校，毕业班，在我之前"}, {"type": "subtitle", "time": 15044.84, "timestamp": "04:10:44", "text": "学校，毕业班，在我之前 毕业了，我的数学书和社交"}, {"type": "subtitle", "time": 15048.64, "timestamp": "04:10:48", "text": "毕业了，我的数学书和社交 书籍就像超级科技。我就像"}, {"type": "subtitle", "time": 15051.8, "timestamp": "04:10:51", "text": "书籍就像超级科技。我就像 呃"}]
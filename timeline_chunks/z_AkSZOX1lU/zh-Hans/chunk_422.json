[{"type": "subtitle", "time": 25320.23, "timestamp": "07:02:00", "text": "我忍不住一直盯着脚踝看。"}, {"type": "subtitle", "time": 25323.708, "timestamp": "07:02:03", "text": "她真是太漂亮太酷了。和"}, {"type": "subtitle", "time": 25328.35, "timestamp": "07:02:08", "text": "她做的每一个动作都好可爱"}, {"type": "subtitle", "time": 25336.07, "timestamp": "07:02:16", "text": "宝贵的。我要……我要拉"}, {"type": "subtitle", "time": 25338.39, "timestamp": "07:02:18", "text": "哦，是的。我有足够的理由去争取"}, {"type": "subtitle", "time": 25340.628, "timestamp": "07:02:20", "text": "她。"}, {"type": "subtitle", "time": 25368.19, "timestamp": "07:02:48", "text": "[笑声]"}, {"type": "subtitle", "time": 25371.788, "timestamp": "07:02:51", "text": "哦，我的"}, {"type": "subtitle", "time": 25379.23, "timestamp": "07:02:59", "text": "[音乐]"}]
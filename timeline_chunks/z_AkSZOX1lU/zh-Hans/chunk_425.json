[{"type": "subtitle", "time": 25500.11, "timestamp": "07:05:00", "text": "在这个游戏中，一旦你完成了"}, {"type": "subtitle", "time": 25503.75, "timestamp": "07:05:03", "text": "每日例行检查，并完成你的休息"}, {"type": "subtitle", "time": 25505.23, "timestamp": "07:05:05", "text": "盘子和"}, {"type": "subtitle", "time": 25509.19, "timestamp": "07:05:09", "text": "还有什么可做的呢？即使"}, {"type": "subtitle", "time": 25512.19, "timestamp": "07:05:12", "text": "你完成了探索，"}, {"type": "subtitle", "time": 25514.708, "timestamp": "07:05:14", "text": "没什么事可做"}, {"type": "subtitle", "time": 25517.708, "timestamp": "07:05:17", "text": "现在游戏怎么玩？"}, {"type": "subtitle", "time": 25521.868, "timestamp": "07:05:21", "text": "农场，如何刷Prime资源？"}, {"type": "subtitle", "time": 25525.03, "timestamp": "07:05:25", "text": "小行星玩呼叫合作模式。为什么要这样做"}, {"type": "subtitle", "time": 25528.19, "timestamp": "07:05:28", "text": "你想玩合作模式吗？ WHO？真无聊"}, {"type": "subtitle", "time": 25532.35, "timestamp": "07:05:32", "text": "现在。我的意思是，你在做什么？"}, {"type": "subtitle", "time": 25537.19, "timestamp": "07:05:37", "text": "合作社？与首领战斗。不，但你可以这么做"}, {"type": "subtitle", "time": 25539.31, "timestamp": "07:05:39", "text": "单单这一点就足以说明问题了。不，"}, {"type": "subtitle", "time": 25546.31, "timestamp": "07:05:46", "text": "嗯，我听起来好像已经过去了。"}, {"type": "subtitle", "time": 25549.59, "timestamp": "07:05:49", "text": "这款游戏，对吧？我听起来像我"}, {"type": "subtitle", "time": 25551.67, "timestamp": "07:05:51", "text": "玩《原神》和《星之卡比》玩腻了。"}, {"type": "subtitle", "time": 25557.99, "timestamp": "07:05:57", "text": "比兰，我们尽力而为。如果你把所有事情都做了呢？"}, {"type": "subtitle", "time": 25559.628, "timestamp": "07:05:59", "text": "那？你做什么工作"}]
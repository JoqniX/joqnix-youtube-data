[{"type": "subtitle", "time": 34862.11, "timestamp": "09:41:02", "text": "這個救護車司機"}, {"type": "subtitle", "time": 34869.55, "timestamp": "09:41:09", "text": "。我們終於拿到了那些被停用的。好的。這是一場冒險。這好像是這個地區的特色。知道了。但 bas 擊敗了敵人。哦，"}, {"type": "subtitle", "time": 34891.99, "timestamp": "09:41:31", "text": "這傢伙叫希特。熱。  [掌聲] 好。我渾身是汗。  [音樂]"}, {"type": "subtitle", "time": 34902.71, "timestamp": "09:41:42", "text": "哇。幫幫我。發生了什麼？"}, {"type": "subtitle", "time": 34913.07, "timestamp": "09:41:53", "text": "？好吧，這樣吧。  [音樂]"}]
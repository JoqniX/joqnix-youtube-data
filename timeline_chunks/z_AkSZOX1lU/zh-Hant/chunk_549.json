[{"type": "subtitle", "time": 32978.63, "timestamp": "09:09:38", "text": "瑪麗娜正在康復中。哦，現在她正在盡力治愈我們。哦，凌根來了。"}, {"type": "subtitle", "time": 32987.428, "timestamp": "09:09:47", "text": "該死。哦，那個人也在那裡。  哦，"}, {"type": "subtitle", "time": 32992.31, "timestamp": "09:09:52", "text": "等等。我們可以使用凌幹。該死。  哇，我可以利用所有人。"}]
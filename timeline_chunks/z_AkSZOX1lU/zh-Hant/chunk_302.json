[{"type": "subtitle", "time": 18137.75, "timestamp": "05:02:17", "text": "？哦，聚變步槍。  好的"}, {"type": "subtitle", "time": 18148.788, "timestamp": "05:02:28", "text": "。我們身後的東西一定在地下。  我的天哪，我被困住了。"}, {"type": "subtitle", "time": 18158.07, "timestamp": "05:02:38", "text": "哦，他的速度真快。我喜歡這個人。"}, {"type": "subtitle", "time": 18166.15, "timestamp": "05:02:46", "text": "我們不使用顯式的遊戲採集卡進行遊戲採集。"}]
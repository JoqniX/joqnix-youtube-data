[{"type": "subtitle", "time": 39243.266, "timestamp": "10:54:03", "text": "四星。好的，我花一個皇家點數。給我個四星"}, {"type": "subtitle", "time": 39248.19, "timestamp": "10:54:08", "text": "。啊，是"}, {"type": "subtitle", "time": 39250.83, "timestamp": "10:54:10", "text": "四星。"}, {"type": "subtitle", "time": 39260.11, "timestamp": "10:54:20", "text": "[音樂]"}, {"type": "subtitle", "time": 39264.55, "timestamp": "10:54:24", "text": "她。我現在沒錢了。沒有"}, {"type": "subtitle", "time": 39267.426, "timestamp": "10:54:27", "text": "原始裝備。什麼都沒有。"}, {"type": "subtitle", "time": 39271.95, "timestamp": "10:54:31", "text": "我有個農場。農場農場。存錢"}, {"type": "subtitle", "time": 39273.55, "timestamp": "10:54:33", "text": "。"}]
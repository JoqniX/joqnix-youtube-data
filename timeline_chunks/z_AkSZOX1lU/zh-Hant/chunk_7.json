[{"type": "subtitle", "time": 420.629, "timestamp": "00:07:00", "text": "疲勞。我想我應該"}, {"type": "subtitle", "time": 422.87, "timestamp": "00:07:02", "text": "稱之為「"}, {"type": "subtitle", "time": 424.35, "timestamp": "00:07:04", "text": "無"}, {"type": "subtitle", "time": 429.029, "timestamp": "00:07:09", "text": "直播」。啊，嗯，是的"}, {"type": "subtitle", "time": 432.11, "timestamp": "00:07:12", "text": "，因為太累了"}, {"type": "subtitle", "time": 435.029, "timestamp": "00:07:15", "text": "，我感覺很內疚，因為我打開了"}, {"type": "subtitle", "time": 439.87, "timestamp": "00:07:19", "text": "錄播視頻，卻沒有在"}, {"type": "subtitle", "time": 443.589, "timestamp": "00:07:23", "text": "直播間裡。是啊，我真希望能在"}, {"type": "subtitle", "time": 445.909, "timestamp": "00:07:25", "text": "這裡待上至少12個小時"}, {"type": "subtitle", "time": 448.189, "timestamp": "00:07:28", "text": "。"}, {"type": "subtitle", "time": 452.27, "timestamp": "00:07:32", "text": "唉，我覺得很內疚，因為我"}, {"type": "subtitle", "time": 455.27, "timestamp": "00:07:35", "text": "休息了這麼久，不，我已經堅持做這件事"}, {"type": "subtitle", "time": 458.30899999999997, "timestamp": "00:07:38", "text": "好幾個月了？"}, {"type": "subtitle", "time": 465.589, "timestamp": "00:07:45", "text": "很快就滿兩個月了。晚上10點到11點。"}, {"type": "subtitle", "time": 468.87, "timestamp": "00:07:48", "text": "現在都凌晨了。是啊，我忘了。是的，現在"}, {"type": "subtitle", "time": 472.39, "timestamp": "00:07:52", "text": "我每天都會直播，24小時，"}, {"type": "subtitle", "time": 478.469, "timestamp": "00:07:58", "text": "呃，10到11個小時對我來說似乎不夠。  但是"}]
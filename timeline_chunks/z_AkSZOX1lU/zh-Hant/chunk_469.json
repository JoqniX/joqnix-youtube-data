[{"type": "subtitle", "time": 28142.15, "timestamp": "07:49:02", "text": "她為什麼這麼漂亮"}, {"type": "subtitle", "time": 28170.628, "timestamp": "07:49:30", "text": "你認識"}, {"type": "subtitle", "time": 28173.27, "timestamp": "07:49:33", "text": "這個男孩嗎？叔叔認識他們。"}, {"type": "subtitle", "time": 28191.84, "timestamp": "07:49:51", "text": "所以，別再拿我們的許可證說事了。糟了，"}]
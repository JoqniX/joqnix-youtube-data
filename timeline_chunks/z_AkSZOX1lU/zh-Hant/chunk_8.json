[{"type": "subtitle", "time": 481.67, "timestamp": "00:08:01", "text": "，從七月開始我在日本的時候"}, {"type": "subtitle", "time": 483.83, "timestamp": "00:08:03", "text": "，我覺得我可能就沒辦法"}, {"type": "subtitle", "time": 484.99, "timestamp": "00:08:04", "text": "像這樣直播了"}, {"type": "subtitle", "time": 487.67, "timestamp": "00:08:07", "text": "。至少在未來兩年內，"}, {"type": "subtitle", "time": 491.43, "timestamp": "00:08:11", "text": "我無法這樣直播。我只能"}, {"type": "subtitle", "time": 494.71, "timestamp": "00:08:14", "text": "在晚上有空的時候直播。所以"}, {"type": "subtitle", "time": 502.15, "timestamp": "00:08:22", "text": "糟糕了。所以，在那之前，我會"}, {"type": "subtitle", "time": 505.35, "timestamp": "00:08:25", "text": "利用我所有的時間，"}, {"type": "subtitle", "time": 514.7090000000001, "timestamp": "00:08:34", "text": "但我們這樣做只是因為運動馬拉松，因為我正在存錢，我們"}, {"type": "subtitle", "time": 516.75, "timestamp": "00:08:36", "text": "參加這個子馬拉松只是為了籌集資金購買我給"}, {"type": "subtitle", "time": 529.91, "timestamp": "00:08:49", "text": "你看的新模型，是的，我一直說黑暗是"}]
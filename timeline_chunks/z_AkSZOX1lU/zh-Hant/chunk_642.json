[{"type": "subtitle", "time": 38534.266, "timestamp": "10:42:14", "text": "[音樂]時間。好的。大怪物正猛擊我的臉。我的天哪，是梅菲斯。"}, {"type": "subtitle", "time": 38542.95, "timestamp": "10:42:22", "text": "哦，天哪，是……你好啊，梅菲斯。我沒能及時"}, {"type": "subtitle", "time": 38544.22, "timestamp": "10:42:24", "text": "撞上來，是嗎？梅菲斯對戰我。我的天哪。又一場我對戰"}]
[{"type": "subtitle", "time": 30300.99, "timestamp": "08:25:00", "text": "他們不懂音樂。好吧。  [音樂] 當我想到這件事的時候，總有一天"}, {"type": "subtitle", "time": 30304.23, "timestamp": "08:25:04", "text": "我必須把我用曼德雷納語說的話記錄下來"}, {"type": "subtitle", "time": 30307.19, "timestamp": "08:25:07", "text": "。  我"}, {"type": "subtitle", "time": 30324.23, "timestamp": "08:25:24", "text": "考慮了一下。我"}, {"type": "subtitle", "time": 30350.388, "timestamp": "08:25:50", "text": "我忘了還有個公雞怪獸之類的東西。  我"}]
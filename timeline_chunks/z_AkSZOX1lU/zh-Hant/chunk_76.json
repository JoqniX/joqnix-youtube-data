[{"type": "subtitle", "time": 4567.51, "timestamp": "01:16:07", "text": "射擊遊戲技巧。真正的野生"}, {"type": "subtitle", "time": 4572.55, "timestamp": "01:16:12", "text": "動物。我很興奮，我想確認一下。嗯，是的，"}, {"type": "subtitle", "time": 4578.189, "timestamp": "01:16:18", "text": "重新開始，"}, {"type": "subtitle", "time": 4581.43, "timestamp": "01:16:21", "text": "註冊連接以訪問，註冊一個新帳戶，兄弟，我必須馬上做這件事，阿尼亞，我發誓，鬧鐘響了。為什麼我那留短髮的老婆會當運動型男？那是"}, {"type": "subtitle", "time": 4594.709, "timestamp": "01:16:34", "text": "我的名字，對吧？ J O J O Q N I X。我說的「那是我的名字」是什麼意思？"}]
[{"type": "subtitle", "time": 15857.71, "timestamp": "04:24:17", "text": "。我騎踏板車更快。呃，我"}, {"type": "subtitle", "time": 15862.95, "timestamp": "04:24:22", "text": "得速通這段旅程"}, {"type": "subtitle", "time": 15870.71, "timestamp": "04:24:30", "text": "。我希望我能及時趕到。我希望我能避開交通擁堵，而且我不知道直播到時候會不會開始，希望不會出什麼事。"}, {"type": "subtitle", "time": 15888.389, "timestamp": "04:24:48", "text": "我必須在晚上6點前回來，進行第二次直播，合作直播的時間"}]
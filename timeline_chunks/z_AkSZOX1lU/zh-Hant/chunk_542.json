[{"type": "subtitle", "time": 32550.628, "timestamp": "09:02:30", "text": "左鍵。好的。  [音樂]居倫。哦。  你永遠無法超越無止盡的犧牲。  哦，他死了。  哦，他去世了。  你（音樂）看起來"}, {"type": "subtitle", "time": 32557.03, "timestamp": "09:02:37", "text": "像是在新月形位置下方戰鬥"}, {"type": "subtitle", "time": 32563.628, "timestamp": "09:02:43", "text": "。"}, {"type": "subtitle", "time": 32570.15, "timestamp": "09:02:50", "text": "從事。  好的。哦，太多了。  他們會砰砰砰砰地"}, {"type": "subtitle", "time": 32572.03, "timestamp": "09:02:52", "text": "開火。"}, {"type": "subtitle", "time": 32574.99, "timestamp": "09:02:54", "text": "哦，那些都是巨型怪物。  會不會"}]
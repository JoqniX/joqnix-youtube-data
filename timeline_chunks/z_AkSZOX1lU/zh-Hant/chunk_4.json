[{"type": "subtitle", "time": 240.869, "timestamp": "00:04:00", "text": "。所以，我們會一個一個上傳"}, {"type": "subtitle", "time": 255.069, "timestamp": "00:04:15", "text": "猜我的電腦運行音樂有點吃力"}, {"type": "subtitle", "time": 257.71, "timestamp": "00:04:17", "text": "。它運行不暢，"}, {"type": "subtitle", "time": 260.789, "timestamp": "00:04:20", "text": "我嘗試向 Billy Billy 流，"}, {"type": "subtitle", "time": 277.35, "timestamp": "00:04:37", "text": "[音樂]"}, {"type": "subtitle", "time": 286.71, "timestamp": "00:04:46", "text": "Switch。好的，我正在下載這款遊戲，《"}, {"type": "subtitle", "time": 288.79, "timestamp": "00:04:48", "text": "獵人經典版》。我想試試這款"}, {"type": "subtitle", "time": 291.03, "timestamp": "00:04:51", "text": "經典遊戲的免費版本。為什麼？"}, {"type": "subtitle", "time": 295.83, "timestamp": "00:04:55", "text": "在我購買"}, {"type": "subtitle", "time": 298.83, "timestamp": "00:04:58", "text": "價值 60GB 的正式"}]
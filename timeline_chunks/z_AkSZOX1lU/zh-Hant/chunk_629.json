[{"type": "subtitle", "time": 37792.11, "timestamp": "10:29:52", "text": "我覺得這可能與他的"}, {"type": "subtitle", "time": 37795.266, "timestamp": "10:29:55", "text": "過去有關。如果尹蘭的背景故事"}, {"type": "subtitle", "time": 37796.51, "timestamp": "10:29:56", "text": "與她的"}, {"type": "subtitle", "time": 37798.03, "timestamp": "10:29:58", "text": "過去有關。是的。  好吧，我們和吉安打架。我們"}]
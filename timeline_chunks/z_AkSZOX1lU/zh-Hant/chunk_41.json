[{"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "但我已經合法化了"}, {"type": "subtitle", "time": 2478.15, "timestamp": "00:41:18", "text": "。合法的？不，不"}, {"type": "subtitle", "time": 2481.43, "timestamp": "00:41:21", "text": "。我才到了可以喝你那輛車的法定年齡。"}, {"type": "subtitle", "time": 2488.95, "timestamp": "00:41:28", "text": "哦"}, {"type": "subtitle", "time": 2493.309, "timestamp": "00:41:33", "text": "，我真希望自己永遠18歲而不是8歲。  好的，我來翻譯一下。"}, {"type": "subtitle", "time": 2499.39, "timestamp": "00:41:39", "text": "我覺得你大概14、15歲。為什麼？我的天啊。我14、15歲的時候都在做什麼？"}]
[{"type": "subtitle", "time": 39182.83, "timestamp": "10:53:02", "text": "因為我想"}, {"type": "subtitle", "time": 39186.11, "timestamp": "10:53:06", "text": "存錢抽下一個卡池，就是"}, {"type": "subtitle", "time": 39190.07, "timestamp": "10:53:10", "text": "現在的鳳凰女。"}, {"type": "subtitle", "time": 39193.95, "timestamp": "10:53:13", "text": "所以，一、二、三、四、五、六、七、八、"}, {"type": "subtitle", "time": 39198.39, "timestamp": "10:53:18", "text": "九、十。抽三次就能抽到"}, {"type": "subtitle", "time": 39200.586, "timestamp": "10:53:20", "text": "[音樂]"}, {"type": "subtitle", "time": 39218.83, "timestamp": "10:53:38", "text": "更快點。"}, {"type": "subtitle", "time": 39220.07, "timestamp": "10:53:40", "text": "不。"}, {"type": "subtitle", "time": 39233.48, "timestamp": "10:53:53", "text": "四星。給我個四星。"}, {"type": "subtitle", "time": 39239.71, "timestamp": "10:53:59", "text": "你知道，我給個"}]
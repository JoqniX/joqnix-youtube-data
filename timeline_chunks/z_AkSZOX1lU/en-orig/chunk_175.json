[{"type": "subtitle", "time": 10501.79, "timestamp": "02:55:01", "text": "to all the roads that we are yet to"}, {"type": "subtitle", "time": 10504.99, "timestamp": "02:55:04", "text": "pave. The dreams that stillness"}, {"type": "subtitle", "time": 10508.63, "timestamp": "02:55:08", "text": "entertains and slaves."}, {"type": "subtitle", "time": 10512.51, "timestamp": "02:55:12", "text": "Now, if my love for you won't make you"}, {"type": "subtitle", "time": 10521.99, "timestamp": "02:55:21", "text": "will. You will never leave a trace where"}, {"type": "subtitle", "time": 10524.309, "timestamp": "02:55:24", "text": "you walk."}, {"type": "subtitle", "time": 10527.19, "timestamp": "02:55:27", "text": "Why is it so pretty and beautiful? the"}, {"type": "subtitle", "time": 10529.99, "timestamp": "02:55:29", "text": "one you're told."}, {"type": "subtitle", "time": 10532.23, "timestamp": "02:55:32", "text": "[Music]"}, {"type": "subtitle", "time": 10535.51, "timestamp": "02:55:35", "text": "Oh, we still have to travel. Walking"}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": "[Music]"}, {"type": "chat", "time": 10547.626, "timestamp": "02:55:47", "author": "@kronosMonke", "avatar": "https://yt4.ggpht.com/u5R_PAWdwUdS05VsH3X9UsOPhhDkvp9L56mdw35mAubmJfUNuvcEeYcJ70Z5Hh_SFtAZe4NL2w=s64-c-k-c0x00ffffff-no-rj", "message": "that reminds me, i haven't played DS 1 even tho i claimed it back on epic"}, {"type": "subtitle", "time": 10557.99, "timestamp": "02:55:57", "text": "the wilder."}]
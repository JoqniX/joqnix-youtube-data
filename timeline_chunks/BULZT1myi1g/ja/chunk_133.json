[{"type": "subtitle", "time": 7982.47, "timestamp": "02:13:02", "text": "将来何をしようとも尊重してほしいと思っています。"}, {"type": "subtitle", "time": 7984.229, "timestamp": "02:13:04", "text": "ええ、"}, {"type": "subtitle", "time": 7986.87, "timestamp": "02:13:06", "text": "皆さんが他のクリエイターを応援することには賛成です。例えば、"}, {"type": "subtitle", "time": 7993.43, "timestamp": "02:13:13", "text": "インドのメーターコミュニティ出身の方なら、好きな"}, {"type": "subtitle", "time": 7995.27, "timestamp": "02:13:15", "text": "人を自由に応援してください"}, {"type": "subtitle", "time": 7997.83, "timestamp": "02:13:17", "text": "。 何が"}, {"type": "subtitle", "time": 8000.069, "timestamp": "02:13:20", "text": "起こったにせよ、すべてはうまくいった。 そして私は気にしませんが、"}, {"type": "subtitle", "time": 8002.47, "timestamp": "02:13:22", "text": "あなたがまだ"}, {"type": "subtitle", "time": 8006.149, "timestamp": "02:13:26", "text": "人々を支援したいかどうか、そしてあれこれについてはあなたの希望です。ですから、"}, {"type": "subtitle", "time": 8012.069, "timestamp": "02:13:32", "text": "選択はあなた次第です。しかし、"}, {"type": "subtitle", "time": 8018.709, "timestamp": "02:13:38", "text": "今後私のコミュニティの"}, {"type": "subtitle", "time": 8023.03, "timestamp": "02:13:43", "text": "メンバーが攻撃されたり、何かあったりした場合は、"}, {"type": "subtitle", "time": 8026.31, "timestamp": "02:13:46", "text": "私が立ち上がって擁護することをはっきりさせておきます。 私は"}, {"type": "subtitle", "time": 8028.47, "timestamp": "02:13:48", "text": "自分のコミュニティと空間を守るために立ち上がります。なぜなら、私は"}, {"type": "subtitle", "time": 8033.27, "timestamp": "02:13:53", "text": "気にかけているからです。ええ、それが"}, {"type": "subtitle", "time": 8037.35, "timestamp": "02:13:57", "text": "私が言いたかったことです。"}, {"type": "subtitle", "time": 8039.35, "timestamp": "02:13:59", "text": "ドラムやその他のことについては、"}]
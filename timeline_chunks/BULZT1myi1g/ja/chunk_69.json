[{"type": "subtitle", "time": 4141.11, "timestamp": "01:09:01", "text": "コンテンツ作成と同じです。"}, {"type": "subtitle", "time": 4142.789, "timestamp": "01:09:02", "text": "コンテンツクリエイターとして、ビデオや"}, {"type": "chat", "time": 4143.745, "timestamp": "01:09:03", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "Idk fugitech works for me keke"}, {"type": "subtitle", "time": 4145.349, "timestamp": "01:09:05", "text": "ショート動画を複数のプラットフォームに投稿したり、"}, {"type": "subtitle", "time": 4147.669, "timestamp": "01:09:07", "text": "ストリーミングしたり、"}, {"type": "subtitle", "time": 4149.349, "timestamp": "01:09:09", "text": "視聴者を楽しませたり、その他すべてのことを行います。それらすべてが当てはまります。さらに、"}, {"type": "subtitle", "time": 4159.749, "timestamp": "01:09:19", "text": "BITはサイドクエスト、つまりアドオンとして考慮する必要があります。"}, {"type": "subtitle", "time": 4164.55, "timestamp": "01:09:24", "text": "通常のコンテンツ作成とBITは単なる"}, {"type": "subtitle", "time": 4167.669, "timestamp": "01:09:27", "text": "アドオンです。ですから、"}, {"type": "subtitle", "time": 4170.39, "timestamp": "01:09:30", "text": "無料モデルを使用してください。 どうなるか見てみよう。 オーディエンスを構築しましょう"}, {"type": "subtitle", "time": 4173.269, "timestamp": "01:09:33", "text": "。 最も重要なことは、常に"}, {"type": "subtitle", "time": 4175.349, "timestamp": "01:09:35", "text": "自分のオーディエンスを構築することです。"}, {"type": "subtitle", "time": 4177.43, "timestamp": "01:09:37", "text": "オーディエンスを構築しましょう。 わかった。 もしあなたが"}, {"type": "subtitle", "time": 4179.349, "timestamp": "01:09:39", "text": "ストリーミング配信をしていて、インド人ユーチューバーなどであれば"}, {"type": "subtitle", "time": 4182.07, "timestamp": "01:09:42", "text": "、ここのコミュニティは本当に"}, {"type": "subtitle", "time": 4184.63, "timestamp": "01:09:44", "text": "小さいです。 ここに来る人たちは、"}, {"type": "subtitle", "time": 4188.07, "timestamp": "01:09:48", "text": "他のインド人ユーチューバーの動画を見ているような人たちです。 つまり、"}, {"type": "subtitle", "time": 4189.749, "timestamp": "01:09:49", "text": "共通の視聴者層を持つようなものなんです"}, {"type": "subtitle", "time": 4192.709, "timestamp": "01:09:52", "text": "。 そこからさらに広げたい場合は、"}]
[{"type": "subtitle", "time": 7621.43, "timestamp": "02:07:01", "text": "今はもっと難しくなったけど、"}, {"type": "subtitle", "time": 7626.95, "timestamp": "02:07:06", "text": "楽しいよ。 私はその伝説に出会った。 私は"}, {"type": "subtitle", "time": 7630.55, "timestamp": "02:07:10", "text": "インドでトップ10入りを目指していました。 えーと、"}, {"type": "subtitle", "time": 7634.31, "timestamp": "02:07:14", "text": "リーダーボードはトップ500とか、アジアからはトップ50はないよ。だって、"}, {"type": "subtitle", "time": 7647.75, "timestamp": "02:07:27", "text": "FPSゲームでピューピューピューって撃つのが楽しかったから、ハイを目指して頑張ってたんだもん。"}, {"type": "subtitle", "time": 7650.87, "timestamp": "02:07:30", "text": "[音楽]"}, {"type": "subtitle", "time": 7654.79, "timestamp": "02:07:34", "text": "ええ、楽しいですよ。 私は興奮しています。 他にも"}, {"type": "subtitle", "time": 7657.189, "timestamp": "02:07:37", "text": "新しいゲームが発売される予定です。"}, {"type": "subtitle", "time": 7660.47, "timestamp": "02:07:40", "text": "それらをストリーミング配信したい。 楽しみたい。"}, {"type": "subtitle", "time": 7662.709, "timestamp": "02:07:42", "text": "待てません。"}, {"type": "subtitle", "time": 7665.189, "timestamp": "02:07:45", "text": "そうですね、"}, {"type": "subtitle", "time": 7669.27, "timestamp": "02:07:49", "text": "またいろいろなことをする予定です。チャットしたり、ゲームをしたり、"}, {"type": "subtitle", "time": 7671.669, "timestamp": "02:07:51", "text": "日本語の"}, {"type": "subtitle", "time": 7674.069, "timestamp": "02:07:54", "text": "勉強をしたり、"}, {"type": "subtitle", "time": 7677.189, "timestamp": "02:07:57", "text": "小説や"}]
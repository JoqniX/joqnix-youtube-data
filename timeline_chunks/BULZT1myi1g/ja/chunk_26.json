[{"type": "subtitle", "time": 1571.909, "timestamp": "00:26:11", "text": "まあ、そういうことです。ええ、"}, {"type": "subtitle", "time": 1576.549, "timestamp": "00:26:16", "text": "ジャカサンイベントはこれで終わりです。 えっと、やろうと思えば今でもできるのは分かっているんですが、"}, {"type": "subtitle", "time": 1587.35, "timestamp": "00:26:27", "text": "今は優先すべきことがあるので、あえてやらないことにしました。それに"}, {"type": "subtitle", "time": 1590.31, "timestamp": "00:26:30", "text": "集中したいし、"}, {"type": "subtitle", "time": 1593.75, "timestamp": "00:26:33", "text": "ストリーミングなどは"}, {"type": "subtitle", "time": 1596.39, "timestamp": "00:26:36", "text": "最小限に抑えたいと思っています。 草にも触れたし、もう"}, {"type": "subtitle", "time": 1599.669, "timestamp": "00:26:39", "text": "何もかも手に入ったよ。 ええ、そういうことです。"}, {"type": "subtitle", "time": 1605.19, "timestamp": "00:26:45", "text": "ええ、そうですね。 ええ、"}, {"type": "chat", "time": 1605.614, "timestamp": "00:26:45", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I just watched your earlier video."}, {"type": "subtitle", "time": 1607.669, "timestamp": "00:26:47", "text": "サブマラソンやジョックマラソン"}, {"type": "subtitle", "time": 1611.35, "timestamp": "00:26:51", "text": "イベントを開催していなくても、説明欄にある"}, {"type": "chat", "time": 1613.179, "timestamp": "00:26:53", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I support you."}, {"type": "subtitle", "time": 1618.95, "timestamp": "00:26:58", "text": "寄付リンクからサポートしていただけます"}]
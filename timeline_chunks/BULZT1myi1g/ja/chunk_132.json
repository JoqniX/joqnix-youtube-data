[{"type": "subtitle", "time": 7936.709, "timestamp": "02:12:16", "text": "私に反対する人は多くなく、ほんの数"}, {"type": "subtitle", "time": 7941.43, "timestamp": "02:12:21", "text": "パーセントです。それでも、私は自分の"}, {"type": "subtitle", "time": 7948.47, "timestamp": "02:12:28", "text": "コミュニティとすべてを全体的に再構築したいと思っていました。"}, {"type": "subtitle", "time": 7952.79, "timestamp": "02:12:32", "text": "うん。 でも今のところ、誰かが「"}, {"type": "subtitle", "time": 7957.03, "timestamp": "02:12:37", "text": "ジョーンは取り巻きだ」とか何とか言って、"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "他の人が"}, {"type": "subtitle", "time": 7962.39, "timestamp": "02:12:42", "text": "それについてあれこれ話しているのを見ても、私は"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "それを自分の"}, {"type": "subtitle", "time": 7967.35, "timestamp": "02:12:47", "text": "コミュニティとかとは考えません。 人は人、それだけだ"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "。 そうそう、"}, {"type": "subtitle", "time": 7975.83, "timestamp": "02:12:55", "text": "ドラマがなく、有害でない空間を作りたいんです。 私は自分の"}, {"type": "subtitle", "time": 7979.669, "timestamp": "02:12:59", "text": "コミュニティに、そのこと、そして私が"}]
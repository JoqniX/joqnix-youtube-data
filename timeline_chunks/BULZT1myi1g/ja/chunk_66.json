[{"type": "subtitle", "time": 3961.51, "timestamp": "01:06:01", "text": "フォームのようなものを書かなければなりませんでした。 つまり、請求書のようなもので、"}, {"type": "subtitle", "time": 3967.51, "timestamp": "01:06:07", "text": "YouTubeやGoogleなどの会社からこの"}, {"type": "chat", "time": 3969.077, "timestamp": "01:06:09", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "Joq-san, for someone just starting out, is it smarter financially to use a generic purpose model to test the waters? or go full all-in from the start??"}, {"type": "subtitle", "time": 3969.99, "timestamp": "01:06:09", "text": "金額を受け取ったという内容で、請求書番号、"}, {"type": "subtitle", "time": 3973.51, "timestamp": "01:06:13", "text": "銀行口座の詳細、"}, {"type": "subtitle", "time": 3975.589, "timestamp": "01:06:15", "text": "ビジネス情報、住所などが記載されています。ええ、"}, {"type": "subtitle", "time": 3984.23, "timestamp": "01:06:24", "text": "経済的に賢い人であれば、"}, {"type": "subtitle", "time": 3988.549, "timestamp": "01:06:28", "text": "最初から本格的に取り組むのではなく"}, {"type": "subtitle", "time": 3993.029, "timestamp": "01:06:33", "text": "、ストリーミングの方法やコンテンツ"}, {"type": "subtitle", "time": 3996.39, "timestamp": "01:06:36", "text": "作成の仕組みがわからない場合は、最初から本格的に取り組むべきではありません。"}, {"type": "subtitle", "time": 3999.349, "timestamp": "01:06:39", "text": "お金を使う余裕があるなら、"}, {"type": "subtitle", "time": 4002.789, "timestamp": "01:06:42", "text": "インド出身の場合は"}, {"type": "subtitle", "time": 4006.15, "timestamp": "01:06:46", "text": "モデルが非常に高額になることを覚えておいてください。"}, {"type": "subtitle", "time": 4010.63, "timestamp": "01:06:50", "text": "例えば、私の場合は、"}, {"type": "subtitle", "time": 4013.91, "timestamp": "01:06:53", "text": "モデルのリギング"}, {"type": "subtitle", "time": 4016.71, "timestamp": "01:06:56", "text": "やアートなどすべてに2,000ドルかかります。つまり、"}]
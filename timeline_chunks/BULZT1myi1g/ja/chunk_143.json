[{"type": "subtitle", "time": 8581.19, "timestamp": "02:23:01", "text": "。 ええ、ゆっくりゆっくり進めていきます"}, {"type": "subtitle", "time": 8583.47, "timestamp": "02:23:03", "text": "。"}, {"type": "subtitle", "time": 8595.429, "timestamp": "02:23:15", "text": "こんにちは。 ええと、"}, {"type": "subtitle", "time": 8598.95, "timestamp": "02:23:18", "text": "2時間23分です。 もう"}, {"type": "subtitle", "time": 8601.99, "timestamp": "02:23:21", "text": "2時間を過ぎています。   というわけで、"}, {"type": "subtitle", "time": 8607.429, "timestamp": "02:23:27", "text": "今日は私の配信を見てくださった皆さん、ありがとうございました。 本当に本当に感謝しています"}, {"type": "subtitle", "time": 8608.55, "timestamp": "02:23:28", "text": "。   ええ"}, {"type": "subtitle", "time": 8611.27, "timestamp": "02:23:31", "text": "、これからはここで積極的に"}, {"type": "subtitle", "time": 8614.63, "timestamp": "02:23:34", "text": "活動していきます。 新しい配信形式などを試してみます"}, {"type": "subtitle", "time": 8620.23, "timestamp": "02:23:40", "text": "。 えっと、なんて"}, {"type": "subtitle", "time": 8623.11, "timestamp": "02:23:43", "text": "言うんでしょう？"}, {"type": "subtitle", "time": 8626.23, "timestamp": "02:23:46", "text": "動画、映像、そしてライブ配信も。"}, {"type": "subtitle", "time": 8629.51, "timestamp": "02:23:49", "text": "全額ローンを組んでみて、"}, {"type": "subtitle", "time": 8632.309, "timestamp": "02:23:52", "text": "どうなるか見てみようと思います。 時間がある時はいつでも、"}, {"type": "subtitle", "time": 8635.59, "timestamp": "02:23:55", "text": "コンテンツ制作や配信をしようと思っています。 右。   以上です。   ご来場いただいた"}]
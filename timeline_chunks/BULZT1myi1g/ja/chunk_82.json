[{"type": "subtitle", "time": 4920.149, "timestamp": "01:22:00", "text": "今後は音楽ベースの配信をもっとやっていきます。"}, {"type": "subtitle", "time": 4923.189, "timestamp": "01:22:03", "text": "音楽制作関連のことです。"}, {"type": "subtitle", "time": 4925.91, "timestamp": "01:22:05", "text": "それに集中したいからです。それは"}, {"type": "subtitle", "time": 4929.189, "timestamp": "01:22:09", "text": "私のコアな趣味の一つで、"}, {"type": "subtitle", "time": 4932.07, "timestamp": "01:22:12", "text": "今Jockのためにやりたいことすべてです。Jockは元々"}, {"type": "subtitle", "time": 4936.95, "timestamp": "01:22:16", "text": "音楽家になるはずでした。だから、その方面に集中したいんです"}, {"type": "subtitle", "time": 4939.03, "timestamp": "01:22:19", "text": "。"}, {"type": "subtitle", "time": 4940.709, "timestamp": "01:22:20", "text": "この5年間、"}, {"type": "subtitle", "time": 4943.35, "timestamp": "01:22:23", "text": "カジュアルな配信や"}, {"type": "subtitle", "time": 4945.43, "timestamp": "01:22:25", "text": "バラエティ番組に集中してきました。今回は"}, {"type": "subtitle", "time": 4949.11, "timestamp": "01:22:29", "text": "音楽関連のことに集中したいんです。"}, {"type": "subtitle", "time": 4951.03, "timestamp": "01:22:31", "text": "私のストーリーは、ギャンブルでお金を失い、"}, {"type": "subtitle", "time": 4953.91, "timestamp": "01:22:33", "text": "法律から逃れるために"}, {"type": "subtitle", "time": 4955.669, "timestamp": "01:22:35", "text": "土地の下に隠れて、2日後に「これは"}, {"type": "subtitle", "time": 4962.27, "timestamp": "01:22:42", "text": "すごい」と思ったというものです。すごい。"}, {"type": "subtitle", "time": 4963.91, "timestamp": "01:22:43", "text": "[音楽]"}, {"type": "subtitle", "time": 4966.31, "timestamp": "01:22:46", "text": "何？"}, {"type": "subtitle", "time": 4968.79, "timestamp": "01:22:48", "text": "すごい。まるで"}, {"type": "subtitle", "time": 4971.03, "timestamp": "01:22:51", "text": "魔法でジャガイモに変わったみたいだ"}, {"type": "subtitle", "time": 4973.59, "timestamp": "01:22:53", "text": "。すごい。いいね。"}, {"type": "subtitle", "time": 4977.86, "timestamp": "01:22:57", "text": "本当にいいね。"}, {"type": "subtitle", "time": 4979.43, "timestamp": "01:22:59", "text": "[音楽]"}]
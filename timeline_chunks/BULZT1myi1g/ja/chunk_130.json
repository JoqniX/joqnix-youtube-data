[{"type": "subtitle", "time": 7802.87, "timestamp": "02:10:02", "text": "25日。 ああ、5日ですね。 待てません。"}, {"type": "subtitle", "time": 7805.75, "timestamp": "02:10:05", "text": "ちなみに、その模様はストリーミング配信する予定です。"}, {"type": "subtitle", "time": 7807.589, "timestamp": "02:10:07", "text": "彼は、えっと"}, {"type": "subtitle", "time": 7810.39, "timestamp": "02:10:10", "text": "、"}, {"type": "subtitle", "time": 7812.95, "timestamp": "02:10:12", "text": "すごい。"}, {"type": "subtitle", "time": 7815.91, "timestamp": "02:10:15", "text": "しかし、改めて皆さんに心から感謝申し上げます"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "。 えーっと、"}, {"type": "subtitle", "time": 7821.75, "timestamp": "02:10:21", "text": "配信がうまくいったとは思っていませんでした。ええ"}, {"type": "subtitle", "time": 7826.47, "timestamp": "02:10:26", "text": "、"}, {"type": "subtitle", "time": 7829.75, "timestamp": "02:10:29", "text": "皆さん来てくれてありがとう。そして、"}, {"type": "subtitle", "time": 7832.149, "timestamp": "02:10:32", "text": "今日私と交流してくれた人、チャットに書き込んでくれた人、そしてこっそり見てくれている人など"}, {"type": "subtitle", "time": 7838.95, "timestamp": "02:10:38", "text": "。 こっそり見てくれて、"}, {"type": "subtitle", "time": 7840.79, "timestamp": "02:10:40", "text": "配信に参加してくれて、"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "私の話を聞いてくれてありがとう。 そして、"}, {"type": "subtitle", "time": 7847.43, "timestamp": "02:10:47", "text": "皆さんがこれからも私を、"}, {"type": "subtitle", "time": 7851.189, "timestamp": "02:10:51", "text": "そして私がこれからやりたいことすべてにおいて、このウッズで私を応援し続けてくれることを楽しみにしています"}, {"type": "subtitle", "time": 7854.069, "timestamp": "02:10:54", "text": "。   ええ"}, {"type": "subtitle", "time": 7857.35, "timestamp": "02:10:57", "text": "、そうですね、"}]
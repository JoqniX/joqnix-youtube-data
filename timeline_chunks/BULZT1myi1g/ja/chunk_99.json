[{"type": "subtitle", "time": 5943.75, "timestamp": "01:39:03", "text": "エージェンシー所属のYouTuberとしてどうあるべきかを学ばなければなりませんでした。だって、"}, {"type": "subtitle", "time": 5947.75, "timestamp": "01:39:07", "text": "愚かなことをして、以前の企業"}, {"type": "subtitle", "time": 5954.31, "timestamp": "01:39:14", "text": "所属YouTuberとしてやっていたことを繰り返したくないですし、それは"}, {"type": "subtitle", "time": 5958.79, "timestamp": "01:39:18", "text": "エージェンシーを代表する立場として良くないことですからね。だから、"}, {"type": "subtitle", "time": 5962.79, "timestamp": "01:39:22", "text": "そのイメージを"}, {"type": "subtitle", "time": 5964.31, "timestamp": "01:39:24", "text": "損なわないようにしなければなりません。"}, {"type": "subtitle", "time": 5965.83, "timestamp": "01:39:25", "text": "プロフェッショナルでなければならないんです。だから、"}, {"type": "subtitle", "time": 5969.109, "timestamp": "01:39:29", "text": "いろいろ学んできました。私の考え方は、ある意味で間違っているかもしれないし、"}, {"type": "subtitle", "time": 5972.79, "timestamp": "01:39:32", "text": "良くないかもしれません。なぜなら、"}, {"type": "subtitle", "time": 5979.91, "timestamp": "01:39:39", "text": "実際に企業環境で働いている人"}, {"type": "subtitle", "time": 5983.669, "timestamp": "01:39:43", "text": "や、フルタイムで"}, {"type": "subtitle", "time": 5986.47, "timestamp": "01:39:46", "text": "YouTuberとして活動している人とは違うからです"}, {"type": "subtitle", "time": 5991.51, "timestamp": "01:39:51", "text": "。 ええ、そうですね。分かりません。でも、好きなようにすればいいと思います"}, {"type": "subtitle", "time": 5994.629, "timestamp": "01:39:54", "text": "。"}, {"type": "subtitle", "time": 5997.75, "timestamp": "01:39:57", "text": "楽しんでください。私の動画を楽しんでください。"}]
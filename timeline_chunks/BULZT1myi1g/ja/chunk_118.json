[{"type": "subtitle", "time": 7080.95, "timestamp": "01:58:00", "text": "それら全て。 だから、まずは"}, {"type": "subtitle", "time": 7084.31, "timestamp": "01:58:04", "text": "ソロ配信をもっとたくさんやらないといけないよ。 えーと、"}, {"type": "subtitle", "time": 7087.589, "timestamp": "01:58:07", "text": "私の件に関しては、"}, {"type": "subtitle", "time": 7090.149, "timestamp": "01:58:10", "text": "チャンネル全体と以前のコミュニティなどを再構築しているので"}, {"type": "subtitle", "time": 7092.55, "timestamp": "01:58:12", "text": "、"}, {"type": "subtitle", "time": 7097.03, "timestamp": "01:58:17", "text": "チャンネルでソロ配信をもっと行う予定です。 はい。 コラボ"}, {"type": "subtitle", "time": 7100.47, "timestamp": "01:58:20", "text": "配信は一生に一度か、"}, {"type": "subtitle", "time": 7103.109, "timestamp": "01:58:23", "text": "時々ですが、"}, {"type": "subtitle", "time": 7105.99, "timestamp": "01:58:25", "text": "他の人のチャンネルに出演します。 ええと、今のところは"}, {"type": "subtitle", "time": 7112.87, "timestamp": "01:58:32", "text": "例外だと思いますが、変更するかもしれません。   ええ"}, {"type": "subtitle", "time": 7115.109, "timestamp": "01:58:35", "text": "、"}, {"type": "subtitle", "time": 7117.75, "timestamp": "01:58:37", "text": "こんにちは。"}, {"type": "subtitle", "time": 7123.83, "timestamp": "01:58:43", "text": "私たちはたくさん話しました。"}, {"type": "subtitle", "time": 7126.229, "timestamp": "01:58:46", "text": "さよなら。"}, {"type": "subtitle", "time": 7131.75, "timestamp": "01:58:51", "text": "えっと、最初はもっと"}, {"type": "subtitle", "time": 7135.51, "timestamp": "01:58:55", "text": "短い配信にしたかったんだけど、まあ、これでいいかな。   たぶん"}, {"type": "subtitle", "time": 7139.75, "timestamp": "01:58:59", "text": "2時間くらいだと思う。 翔さん、"}]
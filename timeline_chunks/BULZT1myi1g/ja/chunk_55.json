[{"type": "subtitle", "time": 3301.99, "timestamp": "00:55:01", "text": "でも、前に進むんですよね？"}, {"type": "subtitle", "time": 3304.549, "timestamp": "00:55:04", "text": "例えば、"}, {"type": "subtitle", "time": 3307.67, "timestamp": "00:55:07", "text": "卒業式とか、そういうの全部だよね？"}, {"type": "subtitle", "time": 3310.15, "timestamp": "00:55:10", "text": "卒業するということは、"}, {"type": "chat", "time": 3310.632, "timestamp": "00:55:10", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "truuuuuuue"}, {"type": "subtitle", "time": 3312.15, "timestamp": "00:55:12", "text": "趣味や夢、その他すべてを手放し、諦めて"}, {"type": "subtitle", "time": 3316.39, "timestamp": "00:55:16", "text": "YouTuberとして卒業するという、大きな決断をすることです。 それは大きな"}, {"type": "chat", "time": 3318.992, "timestamp": "00:55:18", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "Where from reddit?"}, {"type": "subtitle", "time": 3320.63, "timestamp": "00:55:20", "text": "ことですよね？ そこで私は、"}, {"type": "subtitle", "time": 3327.67, "timestamp": "00:55:27", "text": "私を評価してくれず、"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "私を裏切ったりするような人たちを手放し、前に進むことを"}, {"type": "subtitle", "time": 3332.47, "timestamp": "00:55:32", "text": "選びました。 それでおしまい。"}, {"type": "subtitle", "time": 3334.79, "timestamp": "00:55:34", "text": "Redditのどこから来た情報？"}, {"type": "chat", "time": 3337.725, "timestamp": "00:55:37", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "Oh wait was it the accusation post?"}, {"type": "subtitle", "time": 3338.23, "timestamp": "00:55:38", "text": "多分、"}, {"type": "subtitle", "time": 3342.069, "timestamp": "00:55:42", "text": "VTuberドラマのサブレディットか、"}, {"type": "subtitle", "time": 3344.71, "timestamp": "00:55:44", "text": "Kuros Sanjianからだと思う。"}, {"type": "subtitle", "time": 3348.39, "timestamp": "00:55:48", "text": "私の"}, {"type": "subtitle", "time": 3352.309, "timestamp": "00:55:52", "text": "ドラマ関連のものが4chan、"}, {"type": "subtitle", "time": 3357.99, "timestamp": "00:55:57", "text": "Reddit、いくつかのフォーラムに投稿されたと"}]
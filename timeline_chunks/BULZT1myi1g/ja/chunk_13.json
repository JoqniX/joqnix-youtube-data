[{"type": "subtitle", "time": 780.629, "timestamp": "00:13:00", "text": "。 だから、"}, {"type": "subtitle", "time": 784.949, "timestamp": "00:13:04", "text": "ビデオ制作とか、そういうことを練習したかったんです"}, {"type": "subtitle", "time": 788.47, "timestamp": "00:13:08", "text": "。 というわけで、これから"}, {"type": "subtitle", "time": 793.269, "timestamp": "00:13:13", "text": "先は様々な話題について語る動画コンテンツを投稿していく予定です。"}, {"type": "subtitle", "time": 795.99, "timestamp": "00:13:15", "text": "うん。 そして、私が巻き込まれた、あるいは巻き込まれた"}, {"type": "subtitle", "time": 798.15, "timestamp": "00:13:18", "text": "最近の論争や騒動については、すでに触れました"}, {"type": "subtitle", "time": 804.389, "timestamp": "00:13:24", "text": "。 ええと、今日でその件は終わりです"}, {"type": "subtitle", "time": 808.389, "timestamp": "00:13:28", "text": "。 つまり、"}, {"type": "subtitle", "time": 811.59, "timestamp": "00:13:31", "text": "最初の配信として、"}, {"type": "subtitle", "time": 814.71, "timestamp": "00:13:34", "text": "これに関して質問があればお答えできますが、"}, {"type": "subtitle", "time": 822.23, "timestamp": "00:13:42", "text": "今日以降、次の配信以降は、過去の出来事に終止符を"}, {"type": "subtitle", "time": 825.829, "timestamp": "00:13:45", "text": "打ち、前に進んでいきたいと思っています。それが"}, {"type": "subtitle", "time": 834.23, "timestamp": "00:13:54", "text": "私の望みです。"}, {"type": "subtitle", "time": 836.31, "timestamp": "00:13:56", "text": "カカサンさん、ありがとうございます。 会員になることを検討してみてください"}]
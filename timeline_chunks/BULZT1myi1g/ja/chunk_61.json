[{"type": "subtitle", "time": 3666.069, "timestamp": "01:01:06", "text": "OBS のことでも配信の技術的なこと、カスタムのことでも、手伝うのは構わないよ。"}, {"type": "subtitle", "time": 3671.91, "timestamp": "01:01:11", "text": "Sammy、Mix It Up、Streamerboardといった"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "プログラム類のことです。 うん。 そうそう。"}, {"type": "subtitle", "time": 3681.829, "timestamp": "01:01:21", "text": "革新的なことがたくさんありました。 何てことだ。 俺をここから出さないでくれよ"}, {"type": "subtitle", "time": 3686.549, "timestamp": "01:01:26", "text": "、兄弟。"}, {"type": "subtitle", "time": 3691.91, "timestamp": "01:01:31", "text": "ストリーミング配信されるコンテンツが本当にたくさんあります。 えっと、ああ、"}, {"type": "subtitle", "time": 3695.349, "timestamp": "01:01:35", "text": "Twitchのデュアルフォーマットみたいな感じ。"}, {"type": "subtitle", "time": 3697.75, "timestamp": "01:01:37", "text": "興奮した。  YouTubeにはデュアル"}, {"type": "subtitle", "time": 3701.27, "timestamp": "01:01:41", "text": "フォーマット機能がありますが、残念ながら"}, {"type": "subtitle", "time": 3704.309, "timestamp": "01:01:44", "text": "縦方向のストリームキーはありません。 つまり、"}, {"type": "subtitle", "time": 3707.51, "timestamp": "01:01:47", "text": "水平方向のストリームキーのようなものです。"}, {"type": "subtitle", "time": 3710.39, "timestamp": "01:01:50", "text": "水平方向のストリームが、"}, {"type": "subtitle", "time": 3714.47, "timestamp": "01:01:54", "text": "垂直方向の1080×920のようにズームインされてしまうんです。"}, {"type": "subtitle", "time": 3717.67, "timestamp": "01:01:57", "text": "それはちょっと良くないですね。"}]
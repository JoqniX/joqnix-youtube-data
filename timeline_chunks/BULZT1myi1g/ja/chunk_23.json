[{"type": "subtitle", "time": 1382.39, "timestamp": "00:23:02", "text": "。 だから、もし私が他の人"}, {"type": "subtitle", "time": 1386.31, "timestamp": "00:23:06", "text": "のチャンネルに出演したら、"}, {"type": "subtitle", "time": 1389.83, "timestamp": "00:23:09", "text": "私のYouTubeホームページ、つまり"}, {"type": "subtitle", "time": 1392.149, "timestamp": "00:23:12", "text": "YouTubeチャンネルページの"}, {"type": "subtitle", "time": 1394.549, "timestamp": "00:23:14", "text": "コラボレーションセクションにそれが表示されるかもしれません。私が"}, {"type": "subtitle", "time": 1397.029, "timestamp": "00:23:17", "text": "誰かのチャンネルに出演している場合は、そこに表示されます"}, {"type": "subtitle", "time": 1401.27, "timestamp": "00:23:21", "text": "。 つまり、"}, {"type": "subtitle", "time": 1406.149, "timestamp": "00:23:26", "text": "ドッグネットのコラボレーションを見たい場合、そうすることもできますし、"}, {"type": "subtitle", "time": 1408.789, "timestamp": "00:23:28", "text": "過去の配信を参照することもできます"}, {"type": "subtitle", "time": 1412.31, "timestamp": "00:23:32", "text": "。 ああ、コンテンツに関しては"}, {"type": "subtitle", "time": 1414.789, "timestamp": "00:23:34", "text": "、ええと、コンテンツに関しては、"}, {"type": "subtitle", "time": 1417.83, "timestamp": "00:23:37", "text": "あちこちで実験していくつもりです。 えっと、"}, {"type": "subtitle", "time": 1426.789, "timestamp": "00:23:46", "text": "次はジョーと一緒に何をしたいかにもっと集中するつもりで、"}, {"type": "subtitle", "time": 1430.63, "timestamp": "00:23:50", "text": "ええ、音楽もありますし"}, {"type": "chat", "time": 1432.028, "timestamp": "00:23:52", "author": "@bakononcopiumm", "avatar": "https://yt4.ggpht.com/hb5sPAHLUD7fBrZZsmfkzISQWwRqI8BY1n8lceyhZz0sNISomD05pCwUe-GL2amD5y-voH_uYw=s64-c-k-c0x00ffffff-no-rj", "message": "where? i dunt see it"}, {"type": "subtitle", "time": 1433.11, "timestamp": "00:23:53", "text": "、歌の配信もありますし、"}, {"type": "subtitle", "time": 1436.87, "timestamp": "00:23:56", "text": "ゲーム配信も時々やります。ええ、"}]
[{"type": "subtitle", "time": 2040.47, "timestamp": "00:34:00", "text": "ためにアセットを作ってくれた人たちのアセットは使用しません"}, {"type": "subtitle", "time": 2043.35, "timestamp": "00:34:03", "text": "。 えっと、あなたと同じように、"}, {"type": "subtitle", "time": 2053.349, "timestamp": "00:34:13", "text": "適切な、何と呼ぶのか、適切な"}, {"type": "subtitle", "time": 2056.629, "timestamp": "00:34:16", "text": "コミュニケーションを彼らから受け取ったので、"}, {"type": "subtitle", "time": 2060.629, "timestamp": "00:34:20", "text": "音楽などの特定のアセットを使用しないようにと言われました"}, {"type": "subtitle", "time": 2063.829, "timestamp": "00:34:23", "text": "。"}, {"type": "subtitle", "time": 2070.869, "timestamp": "00:34:30", "text": "ランダムな音楽を使います。 ええ、ええ、それもそこにあるでしょう"}, {"type": "subtitle", "time": 2074.389, "timestamp": "00:34:34", "text": "。 そして、クレジットに関しては、例えば、"}, {"type": "subtitle", "time": 2086.869, "timestamp": "00:34:46", "text": "私のためにラジオ作品を作ってくれた人、ファンアートを作ってくれた人、"}, {"type": "subtitle", "time": 2091.909, "timestamp": "00:34:51", "text": "音楽を作ってくれた人、"}, {"type": "subtitle", "time": 2094.389, "timestamp": "00:34:54", "text": "グラフィックを作ってくれた人、その他諸々の人たちのことです。 それらの人々は"}, {"type": "subtitle", "time": 2097.109, "timestamp": "00:34:57", "text": "常に私のウェブサイトまたは"}]
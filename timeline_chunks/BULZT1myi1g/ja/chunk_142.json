[{"type": "subtitle", "time": 8522.309, "timestamp": "02:22:02", "text": "。 それでおしまい。 そして、私の"}, {"type": "subtitle", "time": 8528.56, "timestamp": "02:22:08", "text": "今後の道のりを共に歩み、支えてくださることを願っています。"}, {"type": "subtitle", "time": 8530.79, "timestamp": "02:22:10", "text": "[音楽]"}, {"type": "subtitle", "time": 8533.349, "timestamp": "02:22:13", "text": "私は行動を起こすべきだ。"}, {"type": "subtitle", "time": 8538.55, "timestamp": "02:22:18", "text": "うん、どうなるか見てみよう。 ええ、そうですね。"}, {"type": "subtitle", "time": 8542.07, "timestamp": "02:22:22", "text": "どうなるか見てみましょう。"}, {"type": "subtitle", "time": 8544.389, "timestamp": "02:22:24", "text": "今月は弁護士との打ち合わせがたくさんある"}, {"type": "subtitle", "time": 8546.95, "timestamp": "02:22:26", "text": "。 ということで、あれこれと、これこれと"}, {"type": "subtitle", "time": 8550.71, "timestamp": "02:22:30", "text": "。 まあ、どうなるか見てみよう。"}, {"type": "subtitle", "time": 8553.99, "timestamp": "02:22:33", "text": "あ、こんにちは、"}, {"type": "subtitle", "time": 8556.389, "timestamp": "02:22:36", "text": "ホモホモ。"}, {"type": "subtitle", "time": 8561.11, "timestamp": "02:22:41", "text": "そう、私の全ては、"}, {"type": "subtitle", "time": 8565.67, "timestamp": "02:22:45", "text": "フェニックス時代のようなものになった。 いいえ、"}, {"type": "subtitle", "time": 8567.91, "timestamp": "02:22:47", "text": "正しい姿勢で。 私は今、完全に打ちのめされています"}, {"type": "subtitle", "time": 8572.15, "timestamp": "02:22:52", "text": "。 灰の中からゆっくりと人生を取り戻し、"}, {"type": "subtitle", "time": 8578.15, "timestamp": "02:22:58", "text": "生き返っていくような感じだよ"}]
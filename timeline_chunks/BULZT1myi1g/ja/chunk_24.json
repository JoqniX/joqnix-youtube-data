[{"type": "subtitle", "time": 1440.07, "timestamp": "00:24:00", "text": "ブループロトコルを密かに楽しんでいます"}, {"type": "subtitle", "time": 1441.75, "timestamp": "00:24:01", "text": "。"}, {"type": "subtitle", "time": 1444.789, "timestamp": "00:24:04", "text": "えっと、いつか"}, {"type": "subtitle", "time": 1448.789, "timestamp": "00:24:08", "text": "このチャンネルで配信したいと思っています。   ええ"}, {"type": "subtitle", "time": 1451.909, "timestamp": "00:24:11", "text": "、私にはそれが見えないんです。 ええと、"}, {"type": "subtitle", "time": 1454.23, "timestamp": "00:24:14", "text": "現在、共同"}, {"type": "subtitle", "time": 1456.23, "timestamp": "00:24:16", "text": "作業者として追加しているユーザーはいません。"}, {"type": "subtitle", "time": 1461.11, "timestamp": "00:24:21", "text": "えっと、"}, {"type": "subtitle", "time": 1464.549, "timestamp": "00:24:24", "text": "まだ私のページ、ホームページ、チャンネルページには表示されていませんが、"}, {"type": "subtitle", "time": 1473.99, "timestamp": "00:24:33", "text": "えっと、"}, {"type": "subtitle", "time": 1476.07, "timestamp": "00:24:36", "text": "もし分からなければ、私はスペイン語を話します。"}, {"type": "subtitle", "time": 1479.269, "timestamp": "00:24:39", "text": "こんにちは。 心配ない。 心配ない。"}, {"type": "subtitle", "time": 1483.75, "timestamp": "00:24:43", "text": "えっと、こんにちは、アムノスティックさん。 ええと、ゆっくり休んでください"}, {"type": "subtitle", "time": 1486.95, "timestamp": "00:24:46", "text": "。 気をつけて。"}, {"type": "subtitle", "time": 1490.95, "timestamp": "00:24:50", "text": "えっと、こんにちは。 えっと、他に何かありますか？"}, {"type": "subtitle", "time": 1493.43, "timestamp": "00:24:53", "text": "言いたいことはたくさんあったけれど、何を"}]
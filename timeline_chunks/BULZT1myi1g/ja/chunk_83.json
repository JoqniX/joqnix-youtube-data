[{"type": "subtitle", "time": 5001.189, "timestamp": "01:23:21", "text": "読んでいるチャットで何か見逃したでしょうか？"}, {"type": "subtitle", "time": 5005.43, "timestamp": "01:23:25", "text": "もし見逃していたら教えてください。わかりました、"}, {"type": "subtitle", "time": 5019.35, "timestamp": "01:23:39", "text": "さようなら。午前3時。すごい。"}, {"type": "subtitle", "time": 5021.51, "timestamp": "01:23:41", "text": "最近の動画は、"}, {"type": "subtitle", "time": 5026.39, "timestamp": "01:23:46", "text": "真夜中過ぎに録画しています。"}, {"type": "subtitle", "time": 5032.47, "timestamp": "01:23:52", "text": "ブループロトコルを頑張っているので、睡眠スケジュールが崩れています。"}]
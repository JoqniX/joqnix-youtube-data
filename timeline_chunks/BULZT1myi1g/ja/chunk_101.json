[{"type": "subtitle", "time": 6062.07, "timestamp": "01:41:02", "text": "ストリーミングを始めたら、"}, {"type": "subtitle", "time": 6063.91, "timestamp": "01:41:03", "text": "視聴者とコンテンツの構築に集中してください。それが"}, {"type": "subtitle", "time": 6068.79, "timestamp": "01:41:08", "text": "あなたが集中しなければならない2つの主要なことです。"}, {"type": "subtitle", "time": 6071.59, "timestamp": "01:41:11", "text": "それが"}, {"type": "subtitle", "time": 6074.87, "timestamp": "01:41:14", "text": "コンテンツの基本です。 創作活動。会議に関しては、"}, {"type": "subtitle", "time": 6078.87, "timestamp": "01:41:18", "text": "どうなるか見てみましょう。時間がかかるでしょう。順調に"}, {"type": "subtitle", "time": 6082.79, "timestamp": "01:41:22", "text": "成長する人もいれば、"}, {"type": "subtitle", "time": 6085.27, "timestamp": "01:41:25", "text": "スタートが悪かったり、"}, {"type": "subtitle", "time": 6090.229, "timestamp": "01:41:30", "text": "成長が鈍かったりする人もいるでしょう。それは旅の一部です。そう"}, {"type": "subtitle", "time": 6092.77, "timestamp": "01:41:32", "text": "、本当にたくさんのことがあります。"}, {"type": "subtitle", "time": 6093.91, "timestamp": "01:41:33", "text": "[音楽] では、"}, {"type": "subtitle", "time": 6096.79, "timestamp": "01:41:36", "text": "なぜ"}, {"type": "subtitle", "time": 6099.109, "timestamp": "01:41:39", "text": "普通の配信をしているような気分になるのでしょうか？これは"}, {"type": "subtitle", "time": 6101.669, "timestamp": "01:41:41", "text": "カムバックのはずなのに。"}, {"type": "subtitle", "time": 6104.79, "timestamp": "01:41:44", "text": "ここに座って、いろいろと話すべきなのでしょうか"}, {"type": "subtitle", "time": 6107.51, "timestamp": "01:41:47", "text": "？でも、"}, {"type": "subtitle", "time": 6109.03, "timestamp": "01:41:49", "text": "居心地が良すぎる気がします。"}]
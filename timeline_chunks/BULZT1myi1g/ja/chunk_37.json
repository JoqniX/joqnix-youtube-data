[{"type": "subtitle", "time": 2223.51, "timestamp": "00:37:03", "text": "直前に始まったような感じだった。 えっと、私には"}, {"type": "subtitle", "time": 2227.99, "timestamp": "00:37:07", "text": "時間がなかったんです。 ちょっと色々忙しかったんです。"}, {"type": "subtitle", "time": 2229.91, "timestamp": "00:37:09", "text": "それで、"}, {"type": "subtitle", "time": 2234.31, "timestamp": "00:37:14", "text": "私は全部まとめてそれをやったんです"}, {"type": "subtitle", "time": 2237.349, "timestamp": "00:37:17", "text": "。   はい、そうです"}, {"type": "subtitle", "time": 2239.51, "timestamp": "00:37:19", "text": "。   よし"}, {"type": "subtitle", "time": 2243.27, "timestamp": "00:37:23", "text": "。 えっと、次の配信についてですが、もし"}, {"type": "subtitle", "time": 2245.75, "timestamp": "00:37:25", "text": "質問しようと思っていたら、ジョーは"}, {"type": "subtitle", "time": 2249.109, "timestamp": "00:37:29", "text": "明日ディワリのために配信します。 うーん、よくわからない"}, {"type": "subtitle", "time": 2250.79, "timestamp": "00:37:30", "text": "。"}, {"type": "subtitle", "time": 2254.23, "timestamp": "00:37:34", "text": "授業とか"}, {"type": "subtitle", "time": 2256.55, "timestamp": "00:37:36", "text": "色々あるから。 そういえば、えーと配信の"}, {"type": "subtitle", "time": 2259.589, "timestamp": "00:37:39", "text": "時間ですね。 えっと、いつ配信するんですか？"}, {"type": "subtitle", "time": 2263.109, "timestamp": "00:37:43", "text": "私の出番はいつになるのだろうか？ ストリーミング配信時間。 私の"}, {"type": "subtitle", "time": 2265.75, "timestamp": "00:37:45", "text": "配信時間は、午前"}, {"type": "subtitle", "time": 2269.349, "timestamp": "00:37:49", "text": "10時頃、つまり午前中の時間帯になります。"}, {"type": "subtitle", "time": 2272.31, "timestamp": "00:37:52", "text": "私は昔そうやってたんだ。 えーと、"}, {"type": "subtitle", "time": 2275.589, "timestamp": "00:37:55", "text": "ジョアソンとかが来る前は、"}, {"type": "subtitle", "time": 2277.349, "timestamp": "00:37:57", "text": "ストリームをやっていた時は、"}]
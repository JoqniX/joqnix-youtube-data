[{"type": "subtitle", "time": 8342.309, "timestamp": "02:19:02", "text": "正義とかで自分が"}, {"type": "subtitle", "time": 8344.309, "timestamp": "02:19:04", "text": "正しいとか思っている人がいるからです。 私の"}, {"type": "subtitle", "time": 8348.15, "timestamp": "02:19:08", "text": "ドラマが完全に否定されて完全に終わり、"}, {"type": "subtitle", "time": 8354.309, "timestamp": "02:19:14", "text": "すべてが解決したとしても、そうですよね？"}, {"type": "subtitle", "time": 8358.79, "timestamp": "02:19:18", "text": "ええ、もしあなたがブラックリストに載せられたり、"}, {"type": "subtitle", "time": 8361.349, "timestamp": "02:19:21", "text": "サーバーから追放されたり、"}, {"type": "subtitle", "time": 8366.23, "timestamp": "02:19:26", "text": "私と交流したり、私をサポートしたりしているなら、私にはわかりません"}, {"type": "subtitle", "time": 8368.469, "timestamp": "02:19:28", "text": "。 私は"}, {"type": "subtitle", "time": 8372.549, "timestamp": "02:19:32", "text": "それに関して一切責任を負いません。"}, {"type": "subtitle", "time": 8374.87, "timestamp": "02:19:34", "text": "私を応援しに来てくれるかどうか、あるいは"}, {"type": "subtitle", "time": 8377.27, "timestamp": "02:19:37", "text": "他のクリエイターが何をしているか気にせず、"}, {"type": "subtitle", "time": 8382.549, "timestamp": "02:19:42", "text": "私を応援してくれる人をブロックしたりするかどうかは、あなた次第です"}, {"type": "subtitle", "time": 8385.11, "timestamp": "02:19:45", "text": "。 ええ、どうぞ"}, {"type": "subtitle", "time": 8388.07, "timestamp": "02:19:48", "text": "ご自由に。それは、"}, {"type": "subtitle", "time": 8390.87, "timestamp": "02:19:50", "text": "私をサポートしたいと思ってくださる皆さん次第です"}, {"type": "subtitle", "time": 8393.349, "timestamp": "02:19:53", "text": "。 だから、それは君次第だ。 もし"}, {"type": "subtitle", "time": 8395.11, "timestamp": "02:19:55", "text": "私のコンテンツを見るのが気に入らない場合、"}, {"type": "subtitle", "time": 8396.95, "timestamp": "02:19:56", "text": "私のコンテンツに不満がある場合などは"}]
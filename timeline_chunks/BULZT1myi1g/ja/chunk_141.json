[{"type": "subtitle", "time": 8462.55, "timestamp": "02:21:02", "text": "私たちは前に進んでいくのです。"}, {"type": "subtitle", "time": 8465.59, "timestamp": "02:21:05", "text": "私は前に進んでいますし、今はただ冗談を言い合えると思います。"}, {"type": "subtitle", "time": 8472.55, "timestamp": "02:21:12", "text": "もし誰かが、"}, {"type": "subtitle", "time": 8474.71, "timestamp": "02:21:14", "text": "裁判になるのか、法的措置が取られるのかといった最新情報を知りたいというのであれば、"}, {"type": "subtitle", "time": 8480.15, "timestamp": "02:21:20", "text": "私は"}, {"type": "subtitle", "time": 8482.71, "timestamp": "02:21:22", "text": "それを公には開示しません。もしそうなるのであれば、そうなるでしょう。私が"}, {"type": "subtitle", "time": 8487.99, "timestamp": "02:21:27", "text": "言えるのはそれだけです。"}, {"type": "subtitle", "time": 8491.349, "timestamp": "02:21:31", "text": "今回は、何かが"}, {"type": "subtitle", "time": 8495.429, "timestamp": "02:21:35", "text": "起こっているかどうかについて話すことは許されていないので、こんにちは。"}, {"type": "subtitle", "time": 8498.63, "timestamp": "02:21:38", "text": "それは舞台裏で起こることだからだ。"}, {"type": "subtitle", "time": 8500.63, "timestamp": "02:21:40", "text": "もし何か発表しても良いと思える最新情報があれば、"}, {"type": "subtitle", "time": 8503.51, "timestamp": "02:21:43", "text": "お知らせします。 それだけです。"}, {"type": "subtitle", "time": 8506.389, "timestamp": "02:21:46", "text": "でも、私は何よりも前に進みたいと思っていて、"}, {"type": "subtitle", "time": 8511.91, "timestamp": "02:21:51", "text": "すでにそういうことをした人たちのことは許しましたし、ただ前に"}, {"type": "subtitle", "time": 8513.83, "timestamp": "02:21:53", "text": "進みたいだけです。 もう"}, {"type": "subtitle", "time": 8517.91, "timestamp": "02:21:57", "text": "彼らとは関わりたくないし、関わりたくない。自分の道を自分のやり方で進みたいだけなんです"}]
[{"type": "subtitle", "time": 8223.03, "timestamp": "02:17:03", "text": "私と公の場で話したいと思っているクリエイター仲間が、嫌がらせを受けたり攻撃されたりすることを望みません。   だから、"}, {"type": "subtitle", "time": 8227.429, "timestamp": "02:17:07", "text": "私としては、"}, {"type": "subtitle", "time": 8235.589, "timestamp": "02:17:15", "text": "物事が落ち着いてから、今は公にはしないという決断をしたかったんです。そして、"}, {"type": "subtitle", "time": 8238.629, "timestamp": "02:17:18", "text": "時間が経てば、"}, {"type": "subtitle", "time": 8240.709, "timestamp": "02:17:20", "text": "将来的に人々とコラボレーションするかもしれませんが、それは"}, {"type": "subtitle", "time": 8251.27, "timestamp": "02:17:31", "text": "本当に稀な機会で、本当に限られた"}, {"type": "subtitle", "time": 8253.83, "timestamp": "02:17:33", "text": "人数です。"}, {"type": "subtitle", "time": 8256.95, "timestamp": "02:17:36", "text": "インドのメーター側について言えば、もう"}, {"type": "subtitle", "time": 8259.11, "timestamp": "02:17:39", "text": "そのコミュニティとは関わりたくないですね"}, {"type": "subtitle", "time": 8262.07, "timestamp": "02:17:42", "text": "。 しかし、人数に関しては、1人"}, {"type": "subtitle", "time": 8264.95, "timestamp": "02:17:44", "text": "か2人、せいぜい3人が限界だろう。 はい、"}, {"type": "subtitle", "time": 8266.95, "timestamp": "02:17:46", "text": "その通りです。"}, {"type": "subtitle", "time": 8271.11, "timestamp": "02:17:51", "text": "ええ、主に私の"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "チャンネルにもっと力を入れていきます。"}, {"type": "subtitle", "time": 8275.83, "timestamp": "02:17:55", "text": "そう、まさにそこなんです。 私はすでにたくさんの"}]
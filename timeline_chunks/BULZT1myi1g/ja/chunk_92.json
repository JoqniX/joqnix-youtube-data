[{"type": "subtitle", "time": 5522.229, "timestamp": "01:32:02", "text": "友情は仕事に基づいたものであるべきで、"}, {"type": "subtitle", "time": 5524.229, "timestamp": "01:32:04", "text": "すべてを"}, {"type": "subtitle", "time": 5527.43, "timestamp": "01:32:07", "text": "仕事に関連付けておく方がずっと良いと思います。つまり、"}, {"type": "chat", "time": 5529.279, "timestamp": "01:32:09", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "ah I'm bad with that stuff... I just tend to avoid jelly and toxic folks UCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCx"}, {"type": "subtitle", "time": 5529.75, "timestamp": "01:32:09", "text": "同僚、仕事仲間、知り合いといった"}, {"type": "subtitle", "time": 5531.91, "timestamp": "01:32:11", "text": "関係は、"}, {"type": "subtitle", "time": 5536.07, "timestamp": "01:32:16", "text": "お互いの境界線を尊重しなければならないという意味で良いと思います"}, {"type": "subtitle", "time": 5539.03, "timestamp": "01:32:19", "text": "。コミュニティに関しても"}, {"type": "subtitle", "time": 5544.07, "timestamp": "01:32:24", "text": "境界線が必要です。"}, {"type": "subtitle", "time": 5546.55, "timestamp": "01:32:26", "text": "例えば、"}, {"type": "subtitle", "time": 5549.43, "timestamp": "01:32:29", "text": "VTuber Aは男性で、VTuber Bは"}, {"type": "subtitle", "time": 5551.99, "timestamp": "01:32:31", "text": "女性だとします。もし彼らがコラボレーションすると、"}, {"type": "subtitle", "time": 5555.27, "timestamp": "01:32:35", "text": "噂話などが広まるかもしれません。コミュニティ内で"}, {"type": "subtitle", "time": 5557.91, "timestamp": "01:32:37", "text": "カップリングが話題になったり、"}, {"type": "subtitle", "time": 5567.27, "timestamp": "01:32:47", "text": "友人のAとBに問題が生じたりするような事態は避けたいですよね。ですから、"}, {"type": "subtitle", "time": 5569.11, "timestamp": "01:32:49", "text": "コミュニティ内で一定の境界線を設定し、"}, {"type": "subtitle", "time": 5572.709, "timestamp": "01:32:52", "text": "彼らが越権行為をしないようにする必要があります。"}, {"type": "subtitle", "time": 5579.189, "timestamp": "01:32:59", "text": "こうしたことはすべて重要です。"}]
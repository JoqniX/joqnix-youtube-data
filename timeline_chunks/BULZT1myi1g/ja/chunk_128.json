[{"type": "subtitle", "time": 7680.39, "timestamp": "02:08:00", "text": "短い本を読んだりといった教育的なコンテンツもやります。"}, {"type": "subtitle", "time": 7681.91, "timestamp": "02:08:01", "text": "読解"}, {"type": "subtitle", "time": 7684.149, "timestamp": "02:08:04", "text": "力などを向上させる必要があるからです。"}, {"type": "subtitle", "time": 7689.589, "timestamp": "02:08:09", "text": "日本語学習の一環として、以前日本語で行っていたようにVRストリームも提供する予定です。例えば、"}, {"type": "subtitle", "time": 7695.83, "timestamp": "02:08:15", "text": "日本語ネイティブスピーカーとの実際の会話などです"}, {"type": "subtitle", "time": 7698.149, "timestamp": "02:08:18", "text": "。 そのような"}, {"type": "subtitle", "time": 7701.51, "timestamp": "02:08:21", "text": "コンテンツを用意する予定です。 ええ、いつものことですが、時々ちょっと"}, {"type": "subtitle", "time": 7703.83, "timestamp": "02:08:23", "text": "変えてみます"}, {"type": "subtitle", "time": 7705.43, "timestamp": "02:08:25", "text": "。   今のところ、"}, {"type": "subtitle", "time": 7709.189, "timestamp": "02:08:29", "text": "今日の予定は以上です。"}, {"type": "subtitle", "time": 7711.91, "timestamp": "02:08:31", "text": "ええ、でも、私は積極的に配信はしないということを覚えておいてください"}, {"type": "subtitle", "time": 7714.709, "timestamp": "02:08:34", "text": "。 それは、私がやりたいと思った時、あるいは"}, {"type": "subtitle", "time": 7721.51, "timestamp": "02:08:41", "text": "時間割を組んだ時にやる、という感じになるでしょう。   えっと、これから"}, {"type": "subtitle", "time": 7724.149, "timestamp": "02:08:44", "text": "配信スケジュールを作成するとします"}, {"type": "subtitle", "time": 7728.55, "timestamp": "02:08:48", "text": "。 ええ、"}, {"type": "subtitle", "time": 7731.27, "timestamp": "02:08:51", "text": "授業があるから。 夜に私が配信しているのを見ることはないでしょう"}, {"type": "subtitle", "time": 7734.47, "timestamp": "02:08:54", "text": "。 はい。 これからは"}, {"type": "subtitle", "time": 7739.669, "timestamp": "02:08:59", "text": "授業があるので、夕方や夜に配信することはありません。 配信は"}]
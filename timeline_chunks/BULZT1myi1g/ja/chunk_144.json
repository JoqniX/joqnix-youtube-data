[{"type": "subtitle", "time": 8642.309, "timestamp": "02:24:02", "text": "皆様、そして"}, {"type": "subtitle", "time": 8649.27, "timestamp": "02:24:09", "text": "本日会員になられた皆様、ありがとうございました。 メンバーシップにご登録いただき、ありがとうございます。また、"}, {"type": "subtitle", "time": 8653.75, "timestamp": "02:24:13", "text": "Twitch、Kick、そして"}, {"type": "subtitle", "time": 8655.51, "timestamp": "02:24:15", "text": "YouTubeのフォロワーの皆様にも感謝いたします。 新規参加者の皆様にも感謝いたします"}, {"type": "subtitle", "time": 8659.59, "timestamp": "02:24:19", "text": "。 皆さんに楽しんでいただければ幸いです。 わかった。"}, {"type": "subtitle", "time": 8662.309, "timestamp": "02:24:22", "text": "セルゲイさん、こんにちは。お越しいただき"}, {"type": "subtitle", "time": 8665.01, "timestamp": "02:24:25", "text": "ありがとうございます。 バイバイ。"}, {"type": "subtitle", "time": 8666.389, "timestamp": "02:24:26", "text": "【音楽】"}, {"type": "subtitle", "time": 8669.35, "timestamp": "02:24:29", "text": "皆さん、おはようございます。"}]
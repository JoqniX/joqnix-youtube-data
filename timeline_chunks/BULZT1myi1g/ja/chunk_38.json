[{"type": "subtitle", "time": 2282.55, "timestamp": "00:38:02", "text": "この時間帯を使っていたんだけど、"}, {"type": "subtitle", "time": 2284.87, "timestamp": "00:38:04", "text": "考えてみればもう"}, {"type": "subtitle", "time": 2287.589, "timestamp": "00:38:07", "text": "時間帯のことは気にしなくていいんだ。"}, {"type": "subtitle", "time": 2290.63, "timestamp": "00:38:10", "text": "タイムゾーンなんてクソくらえ。"}, {"type": "subtitle", "time": 2297.43, "timestamp": "00:38:17", "text": "他のインド人ユーチューバーとか、僕の時間帯を奪う他の人たちのことなんか気にしなくていいからね"}, {"type": "subtitle", "time": 2304.31, "timestamp": "00:38:24", "text": "。 私は"}, {"type": "subtitle", "time": 2306.39, "timestamp": "00:38:26", "text": "この"}, {"type": "subtitle", "time": 2308.95, "timestamp": "00:38:28", "text": "コミュニティから距離を置こうとしているんです。 ええ、私はいつでも配信できますし、"}, {"type": "subtitle", "time": 2316.31, "timestamp": "00:38:36", "text": "皆さんも参加してくれたら嬉しいです。   えっと、"}, {"type": "subtitle", "time": 2319.109, "timestamp": "00:38:39", "text": "私が配信を開始する時は、"}, {"type": "subtitle", "time": 2323.75, "timestamp": "00:38:43", "text": "私のDiscordでお知らせします。"}, {"type": "subtitle", "time": 2327.109, "timestamp": "00:38:47", "text": "Twitchを使っているならDiscordを使ってください。"}, {"type": "subtitle", "time": 2329.91, "timestamp": "00:38:49", "text": "キック機能が有効になっている場合は、Discordで通知されます"}, {"type": "subtitle", "time": 2332.95, "timestamp": "00:38:52", "text": "。 よろしければ、お気軽にDiscordサーバーにご参加ください"}, {"type": "subtitle", "time": 2337.51, "timestamp": "00:38:57", "text": "。 そして、もし私が"}, {"type": "subtitle", "time": 2339.67, "timestamp": "00:38:59", "text": "ストリームを事前にスケジュール設定している場合は、"}]
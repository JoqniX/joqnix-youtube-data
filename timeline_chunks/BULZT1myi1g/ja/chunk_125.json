[{"type": "subtitle", "time": 7500.629, "timestamp": "02:05:00", "text": "Twitterのツイートを間接的に伝えることもできるかもしれません。 何が起こるかわからない"}, {"type": "subtitle", "time": 7503.589, "timestamp": "02:05:03", "text": "。 実は、それら全てを予想していました"}, {"type": "subtitle", "time": 7505.669, "timestamp": "02:05:05", "text": "。 しかし、それが実際に起こるかどうかは誰にもわからない"}, {"type": "subtitle", "time": 7508.149, "timestamp": "02:05:08", "text": "。"}, {"type": "subtitle", "time": 7510.87, "timestamp": "02:05:10", "text": "でも、もう仕方"}, {"type": "subtitle", "time": 7513.669, "timestamp": "02:05:13", "text": "ないし、どうでもいい。 好きなようにすればいい"}, {"type": "subtitle", "time": 7517.83, "timestamp": "02:05:17", "text": "。 マハ。"}, {"type": "subtitle", "time": 7519.27, "timestamp": "02:05:19", "text": "次の配信の予定は？ 次の"}, {"type": "subtitle", "time": 7522.31, "timestamp": "02:05:22", "text": "配信では、ズダン配信をします。そこでは、"}, {"type": "subtitle", "time": 7526.149, "timestamp": "02:05:26", "text": "気楽に話したり、いろいろ話したりします。"}, {"type": "subtitle", "time": 7530.39, "timestamp": "02:05:30", "text": "次の配信は、えっと、"}, {"type": "subtitle", "time": 7534.47, "timestamp": "02:05:34", "text": "マイクカレンダーを見せてください。 えっと、"}, {"type": "subtitle", "time": 7537.75, "timestamp": "02:05:37", "text": "次はゲーム配信としてBlue Protocolを配信したいと思っています。"}, {"type": "subtitle", "time": 7541.91, "timestamp": "02:05:41", "text": "というのも、そのゲームを楽しんでいるからです。 私は"}, {"type": "subtitle", "time": 7545.589, "timestamp": "02:05:45", "text": "約5時間、いや、550時間も費やしています"}, {"type": "subtitle", "time": 7548.95, "timestamp": "02:05:48", "text": "。 えっと、この"}, {"type": "subtitle", "time": 7550.55, "timestamp": "02:05:50", "text": "ゲームは"}, {"type": "subtitle", "time": 7553.589, "timestamp": "02:05:53", "text": "発売されてから何ヶ月、何週間経ちましたか？ もう7日経ったよね？"}, {"type": "subtitle", "time": 7556.149, "timestamp": "02:05:56", "text": "ゲームが発売された時からプレイしています。 つまり、その時点"}, {"type": "subtitle", "time": 7559.43, "timestamp": "02:05:59", "text": "から現在まで、私は"}]
[{"type": "subtitle", "time": 5101.35, "timestamp": "01:25:01", "text": "あちこちで色々なことを知ります。私も"}, {"type": "subtitle", "time": 5104.39, "timestamp": "01:25:04", "text": "すべてを知っているわけではありませんが、私も"}, {"type": "subtitle", "time": 5107.189, "timestamp": "01:25:07", "text": "毎日学んでいます。Twitter では、人々が"}, {"type": "subtitle", "time": 5109.189, "timestamp": "01:25:09", "text": "自分の"}, {"type": "subtitle", "time": 5111.83, "timestamp": "01:25:11", "text": "経験やガイドなどを共有しています。だから、"}, {"type": "subtitle", "time": 5120.07, "timestamp": "01:25:20", "text": "自分の配信以外は Twitter にあまり投稿しません。"}, {"type": "subtitle", "time": 5128.55, "timestamp": "01:25:28", "text": "日記として使ったり、他の人が使っているような使い方はしません。ただ"}, {"type": "subtitle", "time": 5147.83, "timestamp": "01:25:47", "text": "[音楽]"}, {"type": "subtitle", "time": 5151.35, "timestamp": "01:25:51", "text": "長々と喋ってしまいましたね。ええ。では"}, {"type": "subtitle", "time": 5154.47, "timestamp": "01:25:54", "text": "。"}, {"type": "subtitle", "time": 5158.39, "timestamp": "01:25:58", "text": "今日は日本語の授業があります"}]
[{"type": "subtitle", "time": 5225.43, "timestamp": "01:27:05", "text": "私を知っていて、"}, {"type": "chat", "time": 5226.992, "timestamp": "01:27:06", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "I heard this word collab a loooot, what's it mean actually, like a contract between different streamers to stream together??"}, {"type": "subtitle", "time": 5228.229, "timestamp": "01:27:08", "text": "Joathon の一員として私とコラボレーションしたいと思っていた JP KR と CN VT の人たちは、"}, {"type": "subtitle", "time": 5232.47, "timestamp": "01:27:12", "text": "私の作品を完全に認識していて、ええ、"}, {"type": "subtitle", "time": 5234.95, "timestamp": "01:27:14", "text": "彼らの何人かはこれを見つけて、"}, {"type": "subtitle", "time": 5241.59, "timestamp": "01:27:21", "text": "私と連絡を取り続け、私の味方になって、"}, {"type": "subtitle", "time": 5244.07, "timestamp": "01:27:24", "text": "私がもっとうまくやれるようにしたいと思っていて、"}, {"type": "subtitle", "time": 5247.59, "timestamp": "01:27:27", "text": "将来もコラボレーションなどをしたいと思っています"}, {"type": "subtitle", "time": 5250.629, "timestamp": "01:27:30", "text": "。だから、私はそれに興奮しています。"}, {"type": "subtitle", "time": 5253.27, "timestamp": "01:27:33", "text": "ええと、この「コラボレーション」という言葉をよく聞きます。"}, {"type": "subtitle", "time": 5255.03, "timestamp": "01:27:35", "text": "実際にはどういう意味ですか？"}, {"type": "subtitle", "time": 5256.709, "timestamp": "01:27:36", "text": "異なるストリーマーが"}, {"type": "subtitle", "time": 5259.51, "timestamp": "01:27:39", "text": "一緒にストリーミングするための契約のようなものですか？ ええと、"}, {"type": "subtitle", "time": 5263.51, "timestamp": "01:27:43", "text": "それを見るには 2 つの方法があります。私が"}, {"type": "subtitle", "time": 5266.79, "timestamp": "01:27:46", "text": "どう見ているかについて話します。ええと、"}, {"type": "subtitle", "time": 5269.11, "timestamp": "01:27:49", "text": "ストリーミングなどを始めたいと思っているので、"}, {"type": "subtitle", "time": 5271.35, "timestamp": "01:27:51", "text": "コラボレーション。"}, {"type": "subtitle", "time": 5273.35, "timestamp": "01:27:53", "text": "コラボレーションという言葉は、2人の"}, {"type": "subtitle", "time": 5278.47, "timestamp": "01:27:58", "text": "クリエイターが協力したり、"}]
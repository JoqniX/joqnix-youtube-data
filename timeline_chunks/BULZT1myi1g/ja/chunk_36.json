[{"type": "subtitle", "time": 2161.349, "timestamp": "00:36:01", "text": "弧の基底に基づいて分割しているんです"}, {"type": "subtitle", "time": 2163.349, "timestamp": "00:36:03", "text": "。"}, {"type": "subtitle", "time": 2165.51, "timestamp": "00:36:05", "text": "そう、これは私の人生における一つの章、あるいは旅のようなものですよ"}, {"type": "subtitle", "time": 2168.79, "timestamp": "00:36:08", "text": "ね？ そう、だから、自分の"}, {"type": "subtitle", "time": 2174.63, "timestamp": "00:36:14", "text": "始まりや挫折、成功など、すべてを数えたいんです"}, {"type": "subtitle", "time": 2178.63, "timestamp": "00:36:18", "text": "。 それも念のため言っておきたかったんです"}, {"type": "subtitle", "time": 2182.31, "timestamp": "00:36:22", "text": "。   他に何か"}, {"type": "subtitle", "time": 2186.79, "timestamp": "00:36:26", "text": "見落としていることはありますか？   ああ"}, {"type": "subtitle", "time": 2193.91, "timestamp": "00:36:33", "text": "、本当にストリーミング配信が恋しかったよ。"}, {"type": "subtitle", "time": 2198.71, "timestamp": "00:36:38", "text": "ストリーミング配信が本当に恋しかった。"}, {"type": "subtitle", "time": 2203.109, "timestamp": "00:36:43", "text": "今日は感情的になるかもしれないと、最初は思っていました。"}, {"type": "subtitle", "time": 2208.23, "timestamp": "00:36:48", "text": "ええと、でも私がそうでないのは良いことです。"}, {"type": "subtitle", "time": 2215.91, "timestamp": "00:36:55", "text": "見落としていることはありますか？"}, {"type": "subtitle", "time": 2218.71, "timestamp": "00:36:58", "text": "今日の配信は、まるで"}]
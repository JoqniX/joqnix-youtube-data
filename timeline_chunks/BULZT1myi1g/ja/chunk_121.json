[{"type": "subtitle", "time": 7262.31, "timestamp": "02:01:02", "text": "来年以降、4月以降は、"}, {"type": "subtitle", "time": 7271.43, "timestamp": "02:01:11", "text": "午前中の授業が終わってからストリーミングする時間しか取れないと思います。   後でまた連絡しますが、学校のウェブ"}, {"type": "subtitle", "time": 7280.709, "timestamp": "02:01:20", "text": "サイトに掲載されていた時間割のところで、学校のカリキュラムを参照しました。   だから、"}, {"type": "subtitle", "time": 7283.51, "timestamp": "02:01:23", "text": "もし私が午前中の枠だったら、"}, {"type": "subtitle", "time": 7291.83, "timestamp": "02:01:31", "text": "午後か夕方の日本時間で配信できると思います。あるいは、もし"}, {"type": "subtitle", "time": 7295.43, "timestamp": "02:01:35", "text": "私が"}, {"type": "subtitle", "time": 7297.75, "timestamp": "02:01:37", "text": "パートタイムの仕事をしていて、宿題を終えた後に時間が空いていれば配信できます"}, {"type": "subtitle", "time": 7300.07, "timestamp": "02:01:40", "text": "。"}, {"type": "subtitle", "time": 7303.589, "timestamp": "02:01:43", "text": "おそらく夜にやるでしょう。 それは"}, {"type": "subtitle", "time": 7306.07, "timestamp": "02:01:46", "text": "インド時間になります。 それは"}, {"type": "chat", "time": 7308.035, "timestamp": "02:01:48", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "time to shower and lunchy.... i'll see you Joq-san, potato-san and others later! THANK YOU SO MUCH for the talk and the tips and suggestions!! Tc <3 <3"}, {"type": "subtitle", "time": 7311.189, "timestamp": "02:01:51", "text": "午後3時か4時頃になるでしょう。"}, {"type": "subtitle", "time": 7316.229, "timestamp": "02:01:56", "text": "午後3時か4時 うん。 午後6時 午後7時"}, {"type": "chat", "time": 7319.291, "timestamp": "02:01:59", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}]
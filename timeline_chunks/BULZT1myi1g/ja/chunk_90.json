[{"type": "subtitle", "time": 5403.35, "timestamp": "01:30:03", "text": "チャンネルの規模などに関係なく、平等でなければなりません。"}, {"type": "subtitle", "time": 5405.669, "timestamp": "01:30:05", "text": "通常のコラボレーションでは、一緒にコンテンツを作成したりします"}, {"type": "subtitle", "time": 5408.229, "timestamp": "01:30:08", "text": "。両方の"}, {"type": "subtitle", "time": 5411.35, "timestamp": "01:30:11", "text": "視聴者が一体となり、"}, {"type": "chat", "time": 5412.493, "timestamp": "01:30:12", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "oooh got it"}, {"type": "subtitle", "time": 5414.31, "timestamp": "01:30:14", "text": "共通の体験を共有できます。コラボレーションは"}, {"type": "subtitle", "time": 5418.229, "timestamp": "01:30:18", "text": "2つの方法で行われます。YouTuberが自分の"}, {"type": "subtitle", "time": 5420.87, "timestamp": "01:30:20", "text": "チャンネルで"}, {"type": "subtitle", "time": 5424.629, "timestamp": "01:30:24", "text": "自分の視点から配信するか、一方が他方"}, {"type": "subtitle", "time": 5427.35, "timestamp": "01:30:27", "text": "のチャンネルに出向いて配信するかです。例えば、"}, {"type": "subtitle", "time": 5429.99, "timestamp": "01:30:29", "text": "ある日あなたが"}, {"type": "subtitle", "time": 5432.149, "timestamp": "01:30:32", "text": "YouTuber Bのチャンネルに出向くといった具合です。  YouTuber Aの"}, {"type": "subtitle", "time": 5436.07, "timestamp": "01:30:36", "text": "配信に、例えば1日目と"}, {"type": "subtitle", "time": 5438.47, "timestamp": "01:30:38", "text": "2日目、あるいは1週間後に出演する、あるいは"}, {"type": "subtitle", "time": 5441.189, "timestamp": "01:30:41", "text": "役割を逆転させてAが"}, {"type": "subtitle", "time": 5443.99, "timestamp": "01:30:43", "text": "Bのチャンネルに出演する、といった具合です。"}, {"type": "subtitle", "time": 5445.669, "timestamp": "01:30:45", "text": "ええ、"}, {"type": "subtitle", "time": 5449.43, "timestamp": "01:30:49", "text": "説明が長くなってしまいましたが、"}, {"type": "subtitle", "time": 5453.51, "timestamp": "01:30:53", "text": "そうですね、それはどちらかというと、"}, {"type": "subtitle", "time": 5459.59, "timestamp": "01
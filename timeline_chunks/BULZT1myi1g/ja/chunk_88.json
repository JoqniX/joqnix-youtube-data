[{"type": "subtitle", "time": 5281.59, "timestamp": "01:28:01", "text": "一緒にコンテンツを作成するストリームに出演したりすることを意味しますよ"}, {"type": "subtitle", "time": 5283.43, "timestamp": "01:28:03", "text": "ね？ YouTuberの"}, {"type": "subtitle", "time": 5285.99, "timestamp": "01:28:05", "text": "コラボレーションに関しては、ほとんどの場合、"}, {"type": "subtitle", "time": 5290.95, "timestamp": "01:28:10", "text": "ある人が"}, {"type": "subtitle", "time": 5292.87, "timestamp": "01:28:12", "text": "自分のチャンネルでストリーミング配信をしていて、別の"}, {"type": "subtitle", "time": 5296.149, "timestamp": "01:28:16", "text": "YouTuberがそのチャンネルに出演する、という形になります。"}, {"type": "subtitle", "time": 5298.629, "timestamp": "01:28:18", "text": "例えば、YouTuber AとVTuber Bの場合です。VTuber"}, {"type": "subtitle", "time": 5301.189, "timestamp": "01:28:21", "text": "AがVTuber Bと一緒にストリーム配信をします"}, {"type": "subtitle", "time": 5303.91, "timestamp": "01:28:23", "text": "。つまり、VTuber BがA"}, {"type": "subtitle", "time": 5314.229, "timestamp": "01:28:34", "text": "のチャンネルに出演するということです。AとBのコミュニティが融合するようなものです。AのコミュニティがBのコミュニティと出会い、Bのコミュニティが"}, {"type": "subtitle", "time": 5316.229, "timestamp": "01:28:36", "text": "Aのコミュニティと交流するのです"}, {"type": "subtitle", "time": 5320.31, "timestamp": "01:28:40", "text": "。つまり、"}, {"type": "subtitle", "time": 5324.47, "timestamp": "01:28:44", "text": "お互いに繋がり、"}, {"type": "subtitle", "time": 5327.35, "timestamp": "01:28:47", "text": "楽しむ方法です。では、"}, {"type": "chat", "time": 5328.884, "timestamp": "01:28:48", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "Partnering together for some shared goals?"}, {"type": "subtitle", "time": 5329.51, "timestamp": "01:28:49", "text": "コンテンツ制作という形でどのように捉えるのでしょうか？それは、"}, {"type": "subtitle", "time": 5335.03, "timestamp": "01:28:55", "text": "友達とゲームをする形として考えてみてください。"}, {"type": "subtitle", "time": 5338.149, "timestamp": "01:28:58", "text": "オンラインで新しい友達ができました。お互いに気が合って、"}]
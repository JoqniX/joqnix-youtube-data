[{"type": "subtitle", "time": 1929.029, "timestamp": "00:32:09", "text": "出来事が起こって以来、配信するモチベーションが全くなくなってしまったような気がするんです。"}, {"type": "subtitle", "time": 1930.789, "timestamp": "00:32:10", "text": "みんなの反応とか、そういうのを全部見てみた"}, {"type": "subtitle", "time": 1934.71, "timestamp": "00:32:14", "text": "。 それは私をひどく傷つけた。 でも、"}, {"type": "subtitle", "time": 1938.149, "timestamp": "00:32:18", "text": "休止期間中、あるいはそれ以降、"}, {"type": "subtitle", "time": 1949.99, "timestamp": "00:32:29", "text": "配信を再開する感覚をつかむため、あるいは"}, {"type": "subtitle", "time": 1953.19, "timestamp": "00:32:33", "text": "配信したいゲームをプレイしたりするために、オルタネーターで時々配信していました。 それが"}, {"type": "subtitle", "time": 1956.31, "timestamp": "00:32:36", "text": "本当に復帰の助けになったし、こんなに早く復帰することを選んだ"}, {"type": "subtitle", "time": 1960.389, "timestamp": "00:32:40", "text": "理由でもあるんです"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "。"}, {"type": "subtitle", "time": 1967.43, "timestamp": "00:32:47", "text": "ええ、今は10月、8月、"}, {"type": "subtitle", "time": 1969.509, "timestamp": "00:32:49", "text": "9月、10月です。 ということは、もう2ヶ月経っ"}, {"type": "subtitle", "time": 1972.789, "timestamp": "00:32:52", "text": "たということですね？ こんにちは。   というわけで、"}, {"type": "subtitle", "time": 1975.19, "timestamp": "00:32:55", "text": "プレゼントしていただいた会員権、改めてありがとうございました"}]
[{"type": "subtitle", "time": 5705.99, "timestamp": "01:35:05", "text": "YouTubeを真剣に"}, {"type": "subtitle", "time": 5708.07, "timestamp": "01:35:08", "text": "フルタイムの仕事として、適切な"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "管理、独立した"}, {"type": "subtitle", "time": 5712.87, "timestamp": "01:35:12", "text": "問題管理、形式、"}, {"type": "subtitle", "time": 5715.189, "timestamp": "01:35:15", "text": "メールビジネスなどを行っているプロのYouTuberとコラボレーションする場合、コラボレーション"}, {"type": "subtitle", "time": 5720.87, "timestamp": "01:35:20", "text": "相手がコラボレーションルールシートを渡します。そこには、"}, {"type": "subtitle", "time": 5724.39, "timestamp": "01:35:24", "text": "彼らが快適に感じるものと不快に感じるものがすべてリストされています。たとえば、"}, {"type": "subtitle", "time": 5731.189, "timestamp": "01:35:31", "text": "ジョークなどを言う人であれば、"}, {"type": "subtitle", "time": 5735.59, "timestamp": "01:35:35", "text": "自己肯定的なジョークは好きではない、といった一連のルールがあります。これは"}, {"type": "subtitle", "time": 5739.75, "timestamp": "01:35:39", "text": "受け入れられる、これは受け入れられない、といったすべてのコンテンツルール、許可されているもの、許可されていないもの、ルールなど、そのルールは"}, {"type": "subtitle", "time": 5748.229, "timestamp": "01:35:48", "text": "そこにあります。TwitterなどのYouTuber関連のものには、"}, {"type": "subtitle", "time": 5754.149, "timestamp": "01:35:54", "text": "プレイしているゲーム、似たようなゲーム、"}, {"type": "subtitle", "time": 5756.55, "timestamp": "01:35:56", "text": "プレイしたいゲームなどが記載されたコラボレーションシートがあります。 そういう"}]
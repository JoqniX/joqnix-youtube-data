[{"type": "subtitle", "time": 6000.07, "timestamp": "01:40:00", "text": "ルールやあれこれのことは気にしないでください"}, {"type": "subtitle", "time": 6002.229, "timestamp": "01:40:02", "text": "。ルールを破ってください。"}, {"type": "subtitle", "time": 6005.91, "timestamp": "01:40:05", "text": "ルールなんてクソくらえ。とにかくやってください。私が"}, {"type": "subtitle", "time": 6008.629, "timestamp": "01:40:08", "text": "悪態をつくのも気にしないでください。だって、私は何"}, {"type": "subtitle", "time": 6011.99, "timestamp": "01:40:11", "text": "年も"}, {"type": "subtitle", "time": 6016.31, "timestamp": "01:40:16", "text": "神様だったんですから。"}, {"type": "chat", "time": 6019.864, "timestamp": "01:40:19", "author": "@DeMackLive", "avatar": "https://yt4.ggpht.com/Y9x6LUKT9XsbwBHkB8ZyUoByC4i0pk63CKmeVqi4T73pPCnEiCzrM7dK4To7bHIeV8lUGzYmbCg=s64-c-k-c0x00ffffff-no-rj", "message": "yooooooooooooooooooooooooooooooooooooo"}, {"type": "subtitle", "time": 6019.91, "timestamp": "01:40:19", "text": "ええ。もうこれ以上は言えません"}, {"type": "subtitle", "time": 6022.149, "timestamp": "01:40:22", "text": "。でも、"}, {"type": "subtitle", "time": 6027.27, "timestamp": "01:40:27", "text": "ええ、私はまだそれをそのままにしておきます。"}, {"type": "subtitle", "time": 6030.229, "timestamp": "01:40:30", "text": "それが私がどう"}, {"type": "subtitle", "time": 6037.99, "timestamp": "01:40:37", "text": "でも、私はまだ家族向けです。何が起ころうとも"}, {"type": "subtitle", "time": 6039.75, "timestamp": "01:40:39", "text": "心配しないでください"}, {"type": "subtitle", "time": 6044.07, "timestamp": "01:40:44", "text": "。いいですね。"}, {"type": "subtitle", "time": 6045.83, "timestamp": "01:40:45", "text": "彼らは傍らでメモを取っています。"}, {"type": "subtitle", "time": 6048.55, "timestamp": "01:40:48", "text": "こんにちは。でも、私は"}, {"type": "subtitle", "time": 6051.75, "timestamp": "01:40:51", "text": "これらのことは何も気にしなくていいと思います。"}, {"type": "subtitle", "time": 6054.47, "timestamp": "01:40:54", "text": "メモを取って、ああ、こういうものがあると知っておくのは良いことですが、"}]
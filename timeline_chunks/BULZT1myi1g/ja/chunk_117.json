[{"type": "subtitle", "time": 7021.99, "timestamp": "01:57:01", "text": "人生が"}, {"type": "subtitle", "time": 7025.75, "timestamp": "01:57:05", "text": "2D、3D、あるいは3Dといったように制限されているからといって、多くのことを実現できるわけではありません"}, {"type": "subtitle", "time": 7028.31, "timestamp": "01:57:08", "text": "。 あなた"}, {"type": "subtitle", "time": 7032.79, "timestamp": "01:57:12", "text": "自身の創造力で、そうした障壁を打ち破ることは可能です。   ああ"}, {"type": "subtitle", "time": 7035.75, "timestamp": "01:57:15", "text": "、私は"}, {"type": "subtitle", "time": 7038.229, "timestamp": "01:57:18", "text": "情熱的なことばかり話しています"}, {"type": "subtitle", "time": 7043.03, "timestamp": "01:57:23", "text": "が、それについて話すのが大好きなんです。 うん。"}, {"type": "subtitle", "time": 7045.51, "timestamp": "01:57:25", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 7047.109, "timestamp": "01:57:27", "text": "うん。"}, {"type": "subtitle", "time": 7049.109, "timestamp": "01:57:29", "text": "しかし、始めたばかりの頃は、"}, {"type": "subtitle", "time": 7051.83, "timestamp": "01:57:31", "text": "ソロ配信に集中しましょう。"}, {"type": "subtitle", "time": 7054.95, "timestamp": "01:57:34", "text": "いつもコラボ、コラボ、コラボばかりするような人になってはいけません。 それは"}, {"type": "subtitle", "time": 7058.629, "timestamp": "01:57:38", "text": "あなたが犯しうる悪い過ちの一つです。"}, {"type": "subtitle", "time": 7061.75, "timestamp": "01:57:41", "text": "初期段階で犯しがちな間違いの一つです。なぜなら、"}, {"type": "subtitle", "time": 7063.91, "timestamp": "01:57:43", "text": "あなたはオーディエンスを構築している最中だということを忘れないでください"}, {"type": "subtitle", "time": 7066.39, "timestamp": "01:57:46", "text": "。 つまり、"}, {"type": "subtitle", "time": 7071.03, "timestamp": "01:57:51", "text": "あなたを狙っている人たちがいるということですよね？ だから、彼らをその場に留めておいて、"}, {"type": "subtitle", "time": 7079.35, "timestamp": "01:57:59", "text": "楽しませたりする必要があるんですよね？"}]
[{"type": "subtitle", "time": 6422.07, "timestamp": "01:47:02", "text": "今回は公に情報を共有しすぎないようにします。"}, {"type": "subtitle", "time": 6425.99, "timestamp": "01:47:05", "text": "はい。 もう配信で自分のことを話すのはやめよう"}, {"type": "subtitle", "time": 6427.75, "timestamp": "01:47:07", "text": "。"}, {"type": "subtitle", "time": 6431.43, "timestamp": "01:47:11", "text": "えーっと、"}, {"type": "subtitle", "time": 6437.03, "timestamp": "01:47:17", "text": "ネット上で人が"}, {"type": "subtitle", "time": 6445.51, "timestamp": "01:47:25", "text": "嫌がらせや中傷、"}, {"type": "subtitle", "time": 6448.47, "timestamp": "01:47:28", "text": "特に日本の件など、誰かを陥れるためにどれだけのことをするのかという教訓を学んで以来、"}, {"type": "subtitle", "time": 6455.35, "timestamp": "01:47:35", "text": "私はそれ"}, {"type": "subtitle", "time": 6456.79, "timestamp": "01:47:36", "text": "について何も言わないように最善を尽くします。"}, {"type": "subtitle", "time": 6459.669, "timestamp": "01:47:39", "text": "もし私がそれについて言及したら、"}, {"type": "subtitle", "time": 6463.03, "timestamp": "01:47:43", "text": "それは私です。 私は自ら墓穴を掘っている。   ごめん"}, {"type": "subtitle", "time": 6467.189, "timestamp": "01:47:47", "text": "。 まあ、そうですね。 ああ"}, {"type": "subtitle", "time": 6469.189, "timestamp": "01:47:49", "text": "、もう自分の墓穴を掘ってるよ。 でも、"}, {"type": "subtitle", "time": 6472.07, "timestamp": "01:47:52", "text": "ストリーミング配信をしている人たちにとっては良いアドバイスですね"}, {"type": "subtitle", "time": 6474.39, "timestamp": "01:47:54", "text": "。 そう、"}, {"type": "subtitle", "time": 6478.629, "timestamp": "01:47:58", "text": "YouTuberとしての私生活についてあまり多くを語らない方がいいよ。"}]
[{"type": "subtitle", "time": 5885.27, "timestamp": "01:38:05", "text": "チャンネルに悪影響を与え、キャンセルされるような悪い人が必ず出てきます。そういう人を"}, {"type": "subtitle", "time": 5887.669, "timestamp": "01:38:07", "text": "排除して、"}, {"type": "subtitle", "time": 5891.75, "timestamp": "01:38:11", "text": "信頼できる空間を作るために、"}, {"type": "subtitle", "time": 5893.43, "timestamp": "01:38:13", "text": "そういうジョークがあるんです。"}, {"type": "subtitle", "time": 5895.51, "timestamp": "01:38:15", "text": "いいと思いますよ。ああ、私が"}, {"type": "subtitle", "time": 5898.229, "timestamp": "01:38:18", "text": "しゃべり始めると、"}, {"type": "subtitle", "time": 5901.99, "timestamp": "01:38:21", "text": "すごくしゃべり始めるんですけど、私はそういう"}, {"type": "chat", "time": 5903.877, "timestamp": "01:38:23", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/6_cfY8HJH8bV5QS5yYDYDg"}, {"type": "subtitle", "time": 5905.27, "timestamp": "01:38:25", "text": "言い方をするんです。あなたもそう思ってるでしょう？"}, {"type": "subtitle", "time": 5908.79, "timestamp": "01:38:28", "text": "私もメモを取っていたんです。さて、こんにちは、ようこそ。"}, {"type": "subtitle", "time": 5910.47, "timestamp": "01:38:30", "text": "ストリームニンジャです。"}, {"type": "subtitle", "time": 5915.669, "timestamp": "01:38:35", "text": "ようこそ。えっと、"}, {"type": "subtitle", "time": 5918.39, "timestamp": "01:38:38", "text": "他のクリエイターを見て、"}, {"type": "subtitle", "time": 5921.75, "timestamp": "01:38:41", "text": "彼らがどのように物事を行っているかなど、いろいろ学んできました"}, {"type": "chat", "time": 5921.755, "timestamp": "01:38:41", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "me taking notes on the sideline-"}, {"type": "subtitle", "time": 5923.59, "timestamp": "01:38:43", "text": "。"}, {"type": "subtitle", "time": 5926.229, "timestamp": "01:38:46", "text": "そして、私は"}, {"type": "subtitle", "time": 5928.95, "timestamp": "01:38:48", "text": "エージェンシーに所属するはずだったのですが、最近の騒動のせい"}, {"type": "subtitle", "time": 5932.31, "timestamp": "01:38:52", "text": "で既にその情報を公表してしまいましたよ"}, {"type": "subtitle", "time": 5935.51, "timestamp": "01:38:55", "text": "ね？だから、"}]
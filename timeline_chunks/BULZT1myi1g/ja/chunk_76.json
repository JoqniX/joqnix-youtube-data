[{"type": "subtitle", "time": 4568.39, "timestamp": "01:16:08", "text": "主が"}, {"type": "subtitle", "time": 4573.03, "timestamp": "01:16:13", "text": "ペトラのように毎日落ちたように作った。なんてことだ。"}, {"type": "subtitle", "time": 4577.189, "timestamp": "01:16:17", "text": "どうやってウランに落ちたの？何？"}, {"type": "subtitle", "time": 4581.35, "timestamp": "01:16:21", "text": "ハーレイ・クインのやつを思い出す。"}, {"type": "subtitle", "time": 4591.11, "timestamp": "01:16:31", "text": "ああ、そうだ。楽しい楽しい下降が今。"}]
[{"type": "subtitle", "time": 2343.19, "timestamp": "00:39:03", "text": "YouTubeとTwitchの"}, {"type": "subtitle", "time": 2347.91, "timestamp": "00:39:07", "text": "スケジュールページの両方にスケジュールされます。 それから、"}, {"type": "subtitle", "time": 2352.95, "timestamp": "00:39:12", "text": "YouTube メンバー、つまり YouTube の"}, {"type": "subtitle", "time": 2355.589, "timestamp": "00:39:15", "text": "人たちのためのコミュニティ投稿も作成しようと思います。 ええと、それはそこにありますし、私は"}, {"type": "subtitle", "time": 2358.63, "timestamp": "00:39:18", "text": "視聴者コミュニティ投稿"}, {"type": "subtitle", "time": 2361.75, "timestamp": "00:39:21", "text": "設定を有効にしていました。 だから、もしあなたが"}, {"type": "subtitle", "time": 2363.99, "timestamp": "00:39:23", "text": "ジョックニックのミームやファンアートなどのミームを持っているなら"}, {"type": "subtitle", "time": 2367.51, "timestamp": "00:39:27", "text": "、"}, {"type": "subtitle", "time": 2372.31, "timestamp": "00:39:32", "text": "YouTubeコミュニティの投稿機能に投稿できるようになりました。   わかった"}, {"type": "subtitle", "time": 2375.349, "timestamp": "00:39:35", "text": "。 えっと、無関係なことでは"}, {"type": "subtitle", "time": 2379.109, "timestamp": "00:39:39", "text": "なく、私に関係のあることを書いていただけると嬉しいです"}, {"type": "subtitle", "time": 2384.47, "timestamp": "00:39:44", "text": "。 ええと、そうですね、"}, {"type": "subtitle", "time": 2389.67, "timestamp": "00:39:49", "text": "YouTubeのコミュニティ投稿に関するルールは、おそらく後日公開する予定です。あるいは、私のウェブ"}, {"type": "subtitle", "time": 2394.95, "timestamp": "00:39:54", "text": "サイトのガイドラインに記載するかもしれません。"}, {"type": "subtitle", "time": 2397.27, "timestamp": "00:39:57", "text": "そうですね、でも、どう進めたいかは皆さんにお知らせしますね"}]
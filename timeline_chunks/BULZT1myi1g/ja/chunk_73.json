[{"type": "subtitle", "time": 4385.189, "timestamp": "01:13:05", "text": "いいんだ。"}, {"type": "subtitle", "time": 4387.59, "timestamp": "01:13:07", "text": "うん。"}, {"type": "chat", "time": 4389.387, "timestamp": "01:13:09", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "I'm good at goof-ups-"}, {"type": "subtitle", "time": 4389.99, "timestamp": "01:13:09", "text": "ああ、もういつもの配信みたいだ"}, {"type": "subtitle", "time": 4392.87, "timestamp": "01:13:12", "text": "。"}, {"type": "chat", "time": 4394.402, "timestamp": "01:13:14", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/6_cfY8HJH8bV5QS5yYDYDg"}, {"type": "subtitle", "time": 4395.43, "timestamp": "01:13:15", "text": "気楽に話してる。"}, {"type": "subtitle", "time": 4406.47, "timestamp": "01:13:26", "text": "みんなのおかげでリラックスできた。"}, {"type": "subtitle", "time": 4409.59, "timestamp": "01:13:29", "text": "僕は失敗も平気なんだ。うん、"}, {"type": "subtitle", "time": 4413.99, "timestamp": "01:13:33", "text": "大丈夫。多少の失敗も問題ない。"}, {"type": "subtitle", "time": 4416.39, "timestamp": "01:13:36", "text": "デビューの時だって、気にしなくていいよ"}, {"type": "subtitle", "time": 4419.75, "timestamp": "01:13:39", "text": "。失敗とか、僕の失敗とか、技術的なこととか、何も気にしなくていいんだ"}, {"type": "subtitle", "time": 4427.75, "timestamp": "01:13:47", "text": "。"}, {"type": "subtitle", "time": 4430.79, "timestamp": "01:13:50", "text": "インドとか、"}, {"type": "subtitle", "time": 4433.99, "timestamp": "01:13:53", "text": "大きな会社とか、エージェンシーとかでデビューするなら、プレッシャーは大きいだろうけど、"}, {"type": "subtitle", "time": 4438.95, "timestamp": "01:13:58", "text": "物事を正しく整えたり、"}]
[{"type": "subtitle", "time": 606.63, "timestamp": "00:10:06", "text": "今でも信頼の問題を抱えているので、"}, {"type": "subtitle", "time": 613.99, "timestamp": "00:10:13", "text": "難しいでしょうが、最終的には"}, {"type": "subtitle", "time": 617.11, "timestamp": "00:10:17", "text": "どうなるか見てみましょう。私の言っていることは"}, {"type": "chat", "time": 620.251, "timestamp": "00:10:20", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "Do you believe in karma?"}, {"type": "subtitle", "time": 620.31, "timestamp": "00:10:20", "text": "理解できますか？ええ、"}, {"type": "subtitle", "time": 624.31, "timestamp": "00:10:24", "text": "こんにちはムーンライト、"}, {"type": "subtitle", "time": 630.23, "timestamp": "00:10:30", "text": "カルマカルマを信じますか。 えっと、つまり、"}, {"type": "subtitle", "time": 635.99, "timestamp": "00:10:35", "text": "私にはわからないんです。 彼は私にこう言いました。「つまり、"}, {"type": "subtitle", "time": 640.47, "timestamp": "00:10:40", "text": "カルマはあちこちで起こる。何か"}, {"type": "subtitle", "time": 644.71, "timestamp": "00:10:44", "text": "悪いことをして、それを償おうと"}, {"type": "subtitle", "time": 651.19, "timestamp": "00:10:51", "text": "努力せず、何らかの方法でそれを補おうとしないと、"}, {"type": "subtitle", "time": 654.069, "timestamp": "00:10:54", "text": "人生は"}, {"type": "subtitle", "time": 656.389, "timestamp": "00:10:56", "text": "あなたに薬を与える何かを見つけるだろう。」 右？ それは"}]
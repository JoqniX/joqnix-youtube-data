[{"type": "subtitle", "time": 4681.43, "timestamp": "01:18:01", "text": "星座です。"}, {"type": "subtitle", "time": 4685.35, "timestamp": "01:18:05", "text": "星座の星界のプログネーターです。"}, {"type": "subtitle", "time": 4688.229, "timestamp": "01:18:08", "text": "それは、ある意味で新しいドックロワーの一部です"}, {"type": "subtitle", "time": 4692.95, "timestamp": "01:18:12", "text": "。つまり、"}, {"type": "subtitle", "time": 4695.27, "timestamp": "01:18:15", "text": "ここでもまだ当てはまります。私はまだ星座のプログネーターです"}, {"type": "chat", "time": 4697.821, "timestamp": "01:18:17", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/DfgfY9LaNdmMq7IPuI2AaA"}, {"type": "subtitle", "time": 4698.39, "timestamp": "01:18:18", "text": "。それは、ええ、"}, {"type": "subtitle", "time": 4700.55, "timestamp": "01:18:20", "text": "私は存在です。私は、私は、えーと、何て"}, {"type": "subtitle", "time": 4708.63, "timestamp": "01:18:28", "text": "言うんだっけ"}, {"type": "subtitle", "time": 4711.189, "timestamp": "01:18:31", "text": "？星座を作ったり、"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "既存の"}, {"type": "subtitle", "time": 4719.43, "timestamp": "01:18:39", "text": "星座や黄道十二星座と共鳴したりできる、天体の存在です。 えーと、いろいろ"}, {"type": "subtitle", "time": 4722.79, "timestamp": "01:18:42", "text": "作って、全部。それって、"}, {"type": "subtitle", "time": 4728.63, "timestamp": "01:18:48", "text": "星座とか全部の守護者みたいなものじゃない？ああ、その"}, {"type": "subtitle", "time": 4731.11, "timestamp": "01:18:51", "text": "裏にはちゃんとした伝承があるんだ。なあ、あまり"}, {"type": "subtitle", "time": 4734.39, "timestamp": "01:18:54", "text": "焦らしたくないんだ。新しいスポーツマンは"}, {"type": "subtitle", "time": 4739.51, "timestamp": "01:18:59", "text": "いい感じになるよ。"}]
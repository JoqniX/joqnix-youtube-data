[{"type": "subtitle", "time": 723.19, "timestamp": "00:12:03", "text": "ディワリですね。 そうそう、明日はディワリだ。"}, {"type": "subtitle", "time": 727.509, "timestamp": "00:12:07", "text": "こんにちは。 えっと、10月頃に配信に戻りたいと思っていたんですが、最近は時々何らかの"}, {"type": "subtitle", "time": 737.75, "timestamp": "00:12:17", "text": "コンテンツをやりたいと思っていて、"}, {"type": "subtitle", "time": 748.23, "timestamp": "00:12:28", "text": "配信から離れて十分な休息を取ったと感じています。 だから、戻ってきた方が"}, {"type": "chat", "time": 749.402, "timestamp": "00:12:29", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’ve been trying to be a Jain but Jainism is hard to practice."}, {"type": "subtitle", "time": 751.509, "timestamp": "00:12:31", "text": "いいと思ったんです。"}, {"type": "subtitle", "time": 758.79, "timestamp": "00:12:38", "text": "将来的にどうなるかというと、"}, {"type": "subtitle", "time": 763.35, "timestamp": "00:12:43", "text": "ストリーミングコンテンツは主に私自身が担当する"}, {"type": "subtitle", "time": 766.55, "timestamp": "00:12:46", "text": "か、あるいは半分ずつくらいになると思います"}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "。 来年以降はあまりストリーミング配信ができなくなるので、動画コンテンツにもっと力を入れたいと思っています"}]
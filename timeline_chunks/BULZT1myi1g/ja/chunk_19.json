[{"type": "subtitle", "time": 1141.99, "timestamp": "00:19:01", "text": "も。 気をつけて。 気をつけて。"}, {"type": "subtitle", "time": 1145.27, "timestamp": "00:19:05", "text": "タランさん、来てくれてありがとう。"}, {"type": "subtitle", "time": 1149.59, "timestamp": "00:19:09", "text": "お越しいただきありがとうございます。 それから、"}, {"type": "subtitle", "time": 1157.59, "timestamp": "00:19:17", "text": "テレーナさん、5周年おめでとうございます。   直接お祝いに行けなくて残念だった"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "けど、"}, {"type": "subtitle", "time": 1167.86, "timestamp": "00:19:27", "text": "こんにちは"}, {"type": "subtitle", "time": 1169.75, "timestamp": "00:19:29", "text": "[音楽]"}, {"type": "subtitle", "time": 1171.27, "timestamp": "00:19:31", "text": "ええ、そうです"}, {"type": "subtitle", "time": 1174.71, "timestamp": "00:19:34", "text": "。 えっと、他に何か？"}, {"type": "chat", "time": 1177.67, "timestamp": "00:19:37", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’m going to chant the navkar mantra. Then, go to sleep. 😴"}, {"type": "subtitle", "time": 1179.029, "timestamp": "00:19:39", "text": "コミュニティのことに関してですが、"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "コミュニティコンステレーションは、"}, {"type": "subtitle", "time": 1188.95, "timestamp": "00:19:48", "text": "ええ、おそらく"}, {"type": "subtitle", "time": 1192.31, "timestamp": "00:19:52", "text": "2つか何かに分裂すると思います。 人々は"}, {"type": "subtitle", "time": 1195.27, "timestamp": "00:19:55", "text": "私や、まだ反対派の人たちを引用するだろう"}, {"type": "subtitle", "time": 1198.95, "timestamp": "00:19:58", "text": "。   というわけで、"}]
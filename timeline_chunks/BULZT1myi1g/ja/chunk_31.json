[{"type": "subtitle", "time": 1866.389, "timestamp": "00:31:06", "text": "もし彼らがあなたの動画を見たいのであれば、私の動画を見るように誘導するでしょう"}, {"type": "subtitle", "time": 1869.51, "timestamp": "00:31:09", "text": "。 それは彼ら次第だ。 そして、そのことについては話さ"}, {"type": "subtitle", "time": 1871.669, "timestamp": "00:31:11", "text": "ないでいただけると本当にありがたいです"}, {"type": "subtitle", "time": 1874.87, "timestamp": "00:31:14", "text": "。 そして、あのビデオでも言ったように、ああ、"}, {"type": "subtitle", "time": 1881.59, "timestamp": "00:31:21", "text": "これは一部の人が考えているもう一つの質問ですよね。"}, {"type": "subtitle", "time": 1889.11, "timestamp": "00:31:29", "text": "それは、"}, {"type": "chat", "time": 1889.354, "timestamp": "00:31:29", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "🙏 potato has generously gifted 5 membership(s) on YouTube!"}, {"type": "subtitle", "time": 1891.43, "timestamp": "00:31:31", "text": "告訴するのか、"}, {"type": "subtitle", "time": 1894.23, "timestamp": "00:31:34", "text": "裁判に持ち込むのか、それに関して、私は"}, {"type": "subtitle", "time": 1897.19, "timestamp": "00:31:37", "text": "ここでストリームで公に開示することはできません。"}, {"type": "subtitle", "time": 1902.31, "timestamp": "00:31:42", "text": "もしそうなったとしても、それはプライベートなことであり、個人的に、"}, {"type": "subtitle", "time": 1909.11, "timestamp": "00:31:49", "text": "法的に解決されます。 今はただ、"}, {"type": "subtitle", "time": 1911.59, "timestamp": "00:31:51", "text": "前に進みたいだけです。 私はただ自分のやりたいことをやりたいだけなんです"}, {"type": "subtitle", "time": 1914.63, "timestamp": "00:31:54", "text": "。"}, {"type": "subtitle", "time": 1919.269, "timestamp": "00:31:59", "text": "もう一度ストリーミングを楽しみたいだけなんです。 えっと、あの"}]
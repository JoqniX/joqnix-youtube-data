[{"type": "subtitle", "time": 1504.23, "timestamp": "00:25:04", "text": "ジョアソンについて。   えっと、"}, {"type": "subtitle", "time": 1509.029, "timestamp": "00:25:09", "text": "それは、えっと、"}, {"type": "subtitle", "time": 1516.95, "timestamp": "00:25:16", "text": "どう言えばいいかな？ ジャカタンイベントは"}, {"type": "subtitle", "time": 1520.23, "timestamp": "00:25:20", "text": "それ以来キャンセルされていて、まだ"}, {"type": "subtitle", "time": 1528.31, "timestamp": "00:25:28", "text": "158で終了しなければならないと考えています。"}, {"type": "chat", "time": 1529.941, "timestamp": "00:25:29", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 1533.029, "timestamp": "00:25:33", "text": "待って、158ですか? 番号を忘れてしまいました。"}, {"type": "subtitle", "time": 1537.909, "timestamp": "00:25:37", "text": "160で終わってくれたらよかったのに。"}, {"type": "subtitle", "time": 1549.19, "timestamp": "00:25:49", "text": "終わってほしいです。"}, {"type": "subtitle", "time": 1552.39, "timestamp": "00:25:52", "text": "ジョッカソンが終わってほしいです。あるいは、"}, {"type": "subtitle", "time": 1555.35, "timestamp": "00:25:55", "text": "私に起こったこれらの予期せぬ出来事が終わってほしいです。"}, {"type": "subtitle", "time": 1559.83, "timestamp": "00:25:59", "text": "160日目に終わってほしかったのですが、"}]
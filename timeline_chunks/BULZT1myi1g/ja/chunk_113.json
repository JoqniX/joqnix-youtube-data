[{"type": "subtitle", "time": 6782.39, "timestamp": "01:53:02", "text": "自己表現の場でもあると言えるのではないでしょう"}, {"type": "subtitle", "time": 6785.03, "timestamp": "01:53:05", "text": "か？ 主にそうです。 だから、"}, {"type": "subtitle", "time": 6787.589, "timestamp": "01:53:07", "text": "あなたが持っているスキルや才能を、存分に発揮すればいいんです。"}, {"type": "subtitle", "time": 6791.669, "timestamp": "01:53:11", "text": "もっと愛を。 例えば、"}, {"type": "subtitle", "time": 6793.589, "timestamp": "01:53:13", "text": "ロシア語、ドイツ語、イタリア語"}, {"type": "subtitle", "time": 6797.189, "timestamp": "01:53:17", "text": "など、いろいろな言語が話せるとしましょう。 はい、それをコンテンツに使ってください"}, {"type": "chat", "time": 6798.184, "timestamp": "01:53:18", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "to help humans realise uranium is the new Gatorade-"}, {"type": "subtitle", "time": 6800.47, "timestamp": "01:53:20", "text": "。"}, {"type": "chat", "time": 6801.61, "timestamp": "01:53:21", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCx"}, {"type": "subtitle", "time": 6808.95, "timestamp": "01:53:28", "text": "もしあなたがそうしたいのなら、ドイツ語やフランス語などを知っている多言語話者のYouTuber、つまりポリゴッドになってもいいんですよ。"}, {"type": "subtitle", "time": 6813.109, "timestamp": "01:53:33", "text": "そうですね、もし"}, {"type": "subtitle", "time": 6816.149, "timestamp": "01:53:36", "text": "もっと視聴者を意識して、"}, {"type": "subtitle", "time": 6819.35, "timestamp": "01:53:39", "text": "フランス語圏の視聴者も対象にしたいなら、"}, {"type": "subtitle", "time": 6821.27, "timestamp": "01:53:41", "text": "フランス語の配信とか、そういうこともできますよ"}, {"type": "subtitle", "time": 6823.99, "timestamp": "01:53:43", "text": "ね？ フランス語のコンテンツ"}, {"type": "subtitle", "time": 6826.229, "timestamp": "01:53:46", "text": "とか、そういう類のものですよね？ スペイン語"}, {"type": "subtitle", "time": 6829.83, "timestamp": "01:53:49", "text": "コンテンツ、あれこれ、ですよね？"}, {"type": "subtitle", "time": 6832.709, "timestamp": "01:53:52", "text": "チューブが日本発祥であるように、すべての"}, {"type": "subtitle", "time": 6834.629, "timestamp": "01:53:54", "text": "文化や物事は"}, {"type": "subtitle", "time": 6836.87, "timestamp": "01:53:56", "text": "日本のアイドル文化と同等である、ということですよね？ だから、"}]
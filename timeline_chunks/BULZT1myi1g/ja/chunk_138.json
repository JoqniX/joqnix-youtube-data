[{"type": "subtitle", "time": 8280.629, "timestamp": "02:18:00", "text": "コラボレーションをしていて、1"}, {"type": "subtitle", "time": 8283.03, "timestamp": "02:18:03", "text": "日に5件のコラボレーションをしたり、"}, {"type": "subtitle", "time": 8285.91, "timestamp": "02:18:05", "text": "あれこれしたり、100件以上のコラボレーションを"}, {"type": "subtitle", "time": 8288.15, "timestamp": "02:18:08", "text": "コラボパートナーと行っています。 すでにたくさんの"}, {"type": "subtitle", "time": 8290.79, "timestamp": "02:18:10", "text": "コラボレーションをしてきました。"}, {"type": "subtitle", "time": 8293.11, "timestamp": "02:18:13", "text": "すでに多くのことを成し遂げた。 だから今回は"}, {"type": "subtitle", "time": 8296.15, "timestamp": "02:18:16", "text": "それら全てから少し離れることにします。 わかった。 こんにちは。"}, {"type": "subtitle", "time": 8302.309, "timestamp": "02:18:22", "text": "ええ、だいたいそんなところです。 そして"}, {"type": "subtitle", "time": 8307.91, "timestamp": "02:18:27", "text": "私が言いたいことは、"}, {"type": "subtitle", "time": 8313.11, "timestamp": "02:18:33", "text": "今私のチャットや"}, {"type": "subtitle", "time": 8318.15, "timestamp": "02:18:38", "text": "ストリームに来てくれた人、または私を再びサポートしたいと思ってくれる人たちです。   えーっと、"}, {"type": "subtitle", "time": 8321.99, "timestamp": "02:18:41", "text": "それは私の"}, {"type": "subtitle", "time": 8326.87, "timestamp": "02:18:46", "text": "2時間にも及ぶビデオでも触れたのですが、ある意味では、あなたが"}, {"type": "subtitle", "time": 8332.87, "timestamp": "02:18:52", "text": "見ている人や友達からブラックリストに入れられたり、関係を断たれたりするかもしれません。なぜなら、"}, {"type": "subtitle", "time": 8336.389, "timestamp": "02:18:56", "text": "ええ、まだアンチや、自分なりの"}]
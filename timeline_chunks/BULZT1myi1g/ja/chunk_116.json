[{"type": "subtitle", "time": 6962.47, "timestamp": "01:56:02", "text": "実験とか色々続けてみて。 例えば、私"}, {"type": "subtitle", "time": 6965.189, "timestamp": "01:56:05", "text": "自身を"}, {"type": "subtitle", "time": 6966.95, "timestamp": "01:56:06", "text": "例にとると、私は5年間ストリーミングをしていますが、自分が何が得意なのか、"}, {"type": "subtitle", "time": 6971.669, "timestamp": "01:56:11", "text": "どんなコンテンツが得意なのか、あるいは"}, {"type": "subtitle", "time": 6973.83, "timestamp": "01:56:13", "text": "どんなコンテンツをやりたいのか、"}, {"type": "subtitle", "time": 6977.51, "timestamp": "01:56:17", "text": "今でもわかりません。音楽"}, {"type": "subtitle", "time": 6980.55, "timestamp": "01:56:20", "text": "ベースのコンテンツや、ミュージックビデオの"}, {"type": "subtitle", "time": 6983.75, "timestamp": "01:56:23", "text": "リリース、ボーカロイド関連のもの、"}, {"type": "subtitle", "time": 6987.189, "timestamp": "01:56:27", "text": "音楽アルバムなど、あらゆることをやりたいと思っていました。それは"}, {"type": "subtitle", "time": 6989.669, "timestamp": "01:56:29", "text": "ミュージシャンとしての私の一部です。そうですよね"}, {"type": "subtitle", "time": 6992.87, "timestamp": "01:56:32", "text": "？  YouTubeと同じように、"}, {"type": "subtitle", "time": 6994.79, "timestamp": "01:56:34", "text": "チャンネルを作成するだけで、"}, {"type": "subtitle", "time": 6996.87, "timestamp": "01:56:36", "text": "リリース一覧タブに表示されます。 右？ でも、"}, {"type": "subtitle", "time": 7000.47, "timestamp": "01:56:40", "text": "動画とか普通のことなら、"}, {"type": "subtitle", "time": 7003.189, "timestamp": "01:56:43", "text": "YouTuberとして他のこともできるよ"}, {"type": "subtitle", "time": 7006.87, "timestamp": "01:56:46", "text": "ね？ ゲームとかポッドキャストとか"}, {"type": "subtitle", "time": 7017.35, "timestamp": "01:56:57", "text": "この媒体への参入方法は様々で、"}]
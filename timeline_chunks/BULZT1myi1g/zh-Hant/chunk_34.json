[{"type": "subtitle", "time": 2040.47, "timestamp": "00:34:00", "text": "製作素材的人提供的素材"}, {"type": "subtitle", "time": 2043.35, "timestamp": "00:34:03", "text": "。嗯，"}, {"type": "subtitle", "time": 2047.509, "timestamp": "00:34:07", "text": "自從我收到道具……就像你收到一份"}, {"type": "subtitle", "time": 2053.349, "timestamp": "00:34:13", "text": "正式的……該怎麼稱呼呢……正式的"}, {"type": "subtitle", "time": 2056.629, "timestamp": "00:34:16", "text": "溝通通知，告知我不要使用"}, {"type": "subtitle", "time": 2060.629, "timestamp": "00:34:20", "text": "某些素材，比如音樂……那樣"}, {"type": "subtitle", "time": 2063.829, "timestamp": "00:34:23", "text": "就不一樣了。我將使用"}, {"type": "subtitle", "time": 2070.869, "timestamp": "00:34:30", "text": "一段隨機播放的音樂。嗯，是的，嗯，"}, {"type": "subtitle", "time": 2074.389, "timestamp": "00:34:34", "text": "那會在那裡。至於製作人員"}, {"type": "subtitle", "time": 2077.51, "timestamp": "00:34:37", "text": "名單，"}, {"type": "subtitle", "time": 2080.47, "timestamp": "00:34:40", "text": "例如"}, {"type": "subtitle", "time": 2086.869, "timestamp": "00:34:46", "text": "為我製作廣播節目、粉絲藝術作品、"}, {"type": "subtitle", "time": 2091.909, "timestamp": "00:34:51", "text": "音樂、"}, {"type": "subtitle", "time": 2094.389, "timestamp": "00:34:54", "text": "圖形等等的人。這些人"}, {"type": "subtitle", "time": 2097.109, "timestamp": "00:34:57", "text": "總會在我的網站或這篇文章中得到署名，是的"}]
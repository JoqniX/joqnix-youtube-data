[{"type": "subtitle", "time": 723.19, "timestamp": "00:12:03", "text": "排燈節。對，明天就是排燈節了。"}, {"type": "subtitle", "time": 727.509, "timestamp": "00:12:07", "text": "你好。嗯，我本來想在"}, {"type": "subtitle", "time": 731.19, "timestamp": "00:12:11", "text": "十月份左右回歸直播，但是我"}, {"type": "subtitle", "time": 734.23, "timestamp": "00:12:14", "text": "覺得，嗯，現在我想時不時地做"}, {"type": "subtitle", "time": 737.75, "timestamp": "00:12:17", "text": "一些內容，而且"}, {"type": "subtitle", "time": 741.91, "timestamp": "00:12:21", "text": "我覺得我已經休息了足夠長的時間，可以暫時離開"}, {"type": "subtitle", "time": 748.23, "timestamp": "00:12:28", "text": "直播了。所以我覺得，還是"}, {"type": "chat", "time": 749.402, "timestamp": "00:12:29", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’ve been trying to be a Jain but Jainism is hard to practice."}, {"type": "subtitle", "time": 751.509, "timestamp": "00:12:31", "text": "回來比較好。"}, {"type": "subtitle", "time": 754.79, "timestamp": "00:12:34", "text": "所以，關於"}, {"type": "subtitle", "time": 758.79, "timestamp": "00:12:38", "text": "未來發展方向，我想說，"}, {"type": "subtitle", "time": 763.35, "timestamp": "00:12:43", "text": "串流內容主要會由我來做，"}, {"type": "subtitle", "time": 766.55, "timestamp": "00:12:46", "text": "或者說適度一些，大概一半一半吧"}, {"type": "subtitle", "time": 769.67, "timestamp": "00:12:49", "text": "。我想把更多精力放在影片類型的"}, {"type": "subtitle", "time": 772.71, "timestamp": "00:12:52", "text": "內容上，因為從明年開始，我可能"}, {"type": "subtitle", "time": 775.91, "timestamp": "00:12:55", "text": "就沒辦法進行"}]
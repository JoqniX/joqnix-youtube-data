[{"type": "subtitle", "time": 1504.23, "timestamp": "00:25:04", "text": "關於喬森。"}, {"type": "subtitle", "time": 1505.99, "timestamp": "00:25:05", "text": "呃，好吧，那"}, {"type": "subtitle", "time": 1516.95, "timestamp": "00:25:16", "text": "該怎麼說呢？ Jakatan活動"}, {"type": "subtitle", "time": 1520.23, "timestamp": "00:25:20", "text": "從那時起就被取消了，"}, {"type": "subtitle", "time": 1524.95, "timestamp": "00:25:24", "text": "而且它仍然認為"}, {"type": "subtitle", "time": 1528.31, "timestamp": "00:25:28", "text": "它必須在158日結束。"}, {"type": "chat", "time": 1529.941, "timestamp": "00:25:29", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 1533.029, "timestamp": "00:25:33", "text": "等等，是158日嗎？我忘了號碼。"}, {"type": "subtitle", "time": 1537.909, "timestamp": "00:25:37", "text": "我倒希望它在第160集就結束了。"}, {"type": "subtitle", "time": 1545.75, "timestamp": "00:25:45", "text": "嗯，是啊，"}, {"type": "subtitle", "time": 1549.19, "timestamp": "00:25:49", "text": "我希望它結束，我希望這場運動"}, {"type": "subtitle", "time": 1552.39, "timestamp": "00:25:52", "text": "馬拉松結束，或者說所有這些"}, {"type": "subtitle", "time": 1555.35, "timestamp": "00:25:55", "text": "發生在我身上的意想不到的事情結束，"}, {"type": "subtitle", "time": 1559.83, "timestamp": "00:25:59", "text": "對吧？我希望它在第160天結束，"}]
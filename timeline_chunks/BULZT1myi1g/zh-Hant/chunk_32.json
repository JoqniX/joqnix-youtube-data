[{"type": "subtitle", "time": 1923.75, "timestamp": "00:32:03", "text": "我失去了所有直播的動力。"}, {"type": "subtitle", "time": 1930.789, "timestamp": "00:32:10", "text": "看到大家的各種反應"}, {"type": "subtitle", "time": 1934.71, "timestamp": "00:32:14", "text": "等等。這件事讓我非常難過。但是，呃，"}, {"type": "subtitle", "time": 1938.149, "timestamp": "00:32:18", "text": "在我暫停直播的這段時間，或者從那以後，我時不時地在"}, {"type": "subtitle", "time": 1941.029, "timestamp": "00:32:21", "text": "我的 Alteracon 上直播，"}, {"type": "subtitle", "time": 1946.549, "timestamp": "00:32:26", "text": "以找回"}, {"type": "subtitle", "time": 1949.99, "timestamp": "00:32:29", "text": "再次直播的感覺，或者只是玩"}, {"type": "subtitle", "time": 1953.19, "timestamp": "00:32:33", "text": "我想直播的任何遊戲之類的。"}, {"type": "subtitle", "time": 1956.31, "timestamp": "00:32:36", "text": "那確實幫助我重新振作起來，"}, {"type": "subtitle", "time": 1960.389, "timestamp": "00:32:40", "text": "這也是我選擇"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "這麼快就回來的原因。"}, {"type": "subtitle", "time": 1967.43, "timestamp": "00:32:47", "text": "嗯，現在是十月、八月、"}, {"type": "subtitle", "time": 1969.509, "timestamp": "00:32:49", "text": "九月、十月。兩個月"}, {"type": "subtitle", "time": 1972.789, "timestamp": "00:32:52", "text": "過去了，對吧？你好。"}, {"type": "subtitle", "time": 1975.19, "timestamp": "00:32:55", "text": "所以，再次感謝你們贈送的"}, {"type": "subtitle", "time": 1976.71, "timestamp": "00:32:56", "text": "會員資格"}]
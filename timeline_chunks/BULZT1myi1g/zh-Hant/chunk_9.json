[{"type": "subtitle", "time": 541.829, "timestamp": "00:09:01", "text": "我先提起，否則不會有人提起其他人。好的。從現在開始，我"}, {"type": "subtitle", "time": 546.87, "timestamp": "00:09:06", "text": "會對"}, {"type": "subtitle", "time": 550.23, "timestamp": "00:09:10", "text": "頻道規則格外嚴格。因此，我要求"}, {"type": "subtitle", "time": 557.03, "timestamp": "00:09:17", "text": "Twitch、Kick 和 YouTube 等多個平台上的所有聊天用戶"}, {"type": "subtitle", "time": 561.269, "timestamp": "00:09:21", "text": "從現在開始參考這些準則。"}, {"type": "subtitle", "time": 568.71, "timestamp": "00:09:28", "text": "是的，我不再有版主了。"}, {"type": "subtitle", "time": 571.829, "timestamp": "00:09:31", "text": "我不確定我是否會盡快任命"}, {"type": "subtitle", "time": 573.43, "timestamp": "00:09:33", "text": "版主，"}, {"type": "subtitle", "time": 578.949, "timestamp": "00:09:38", "text": "因為……我不得不"}, {"type": "subtitle", "time": 580.949, "timestamp": "00:09:40", "text": "解僱所有版主，那些"}, {"type": "subtitle", "time": 585.829, "timestamp": "00:09:45", "text": "離開的版主已經走了，但我不知道……"}, {"type": "subtitle", "time": 589.509, "timestamp": "00:09:49", "text": "我是否……我知道在目前的"}, {"type": "subtitle", "time": 592.949, "timestamp": "00:09:52", "text": "情況下，最好是找到"}, {"type": "subtitle", "time": 594.79, "timestamp": "00:09:54", "text": "能夠……"}, {"type": "subtitle", "time": 597.829, "timestamp": "00:09:57", "text": "確保直播聊天室安全的版主，"}]
[{"type": "subtitle", "time": 8235.589, "timestamp": "02:17:15", "text": "問題，在 joathon 比賽中遇到困難的原因。就是這樣。  所以，在合作方面，"}, {"type": "subtitle", "time": 8240.709, "timestamp": "02:17:20", "text": "我會稍微開放一些，"}, {"type": "subtitle", "time": 8247.27, "timestamp": "02:17:27", "text": "與他人合作，在他們的頻道、影片或直播中合作。"}, {"type": "subtitle", "time": 8253.83, "timestamp": "02:17:33", "text": "如果我參與或進行這些合作，這些合作內容會在我的 YouTube 頻道的合作版塊中展示，這是 YouTube 的新功能。我也會在我的"}, {"type": "subtitle", "time": 8262.07, "timestamp": "02:17:42", "text": "社群媒體上提及我正在與某人合作等等。你好。  我希望"}, {"type": "subtitle", "time": 8271.11, "timestamp": "02:17:51", "text": "我的"}, {"type": "subtitle", "time": 8273.75, "timestamp": "02:17:53", "text": "頻道上不會與任何人合作。請注意這一點，因為印度的會議氛圍真的非常糟糕。"}, {"type": "subtitle", "time": 8275.83, "timestamp": "02:17:55", "text": "我不希望那些想站在我這邊的人、那些想支持我的人，或是那些想公開和我"}]
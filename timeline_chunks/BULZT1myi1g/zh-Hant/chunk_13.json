[{"type": "subtitle", "time": 780.629, "timestamp": "00:13:00", "text": "太多直播了。所以我想練習…"}, {"type": "subtitle", "time": 784.949, "timestamp": "00:13:04", "text": "我想練習製作影片"}, {"type": "subtitle", "time": 788.47, "timestamp": "00:13:08", "text": "等等。是的，"}, {"type": "subtitle", "time": 790.47, "timestamp": "00:13:10", "text": "從現在開始會發布一些影片內容，"}, {"type": "subtitle", "time": 793.269, "timestamp": "00:13:13", "text": "討論各種隨機話題。"}, {"type": "subtitle", "time": 795.99, "timestamp": "00:13:15", "text": "是的。我已經"}, {"type": "subtitle", "time": 798.15, "timestamp": "00:13:18", "text": "提到我最近"}, {"type": "subtitle", "time": 800.55, "timestamp": "00:13:20", "text": "捲入或被捲入的爭議和風波事件"}, {"type": "subtitle", "time": 804.389, "timestamp": "00:13:24", "text": "。呃，從今天起，這件事就到此為止了"}, {"type": "subtitle", "time": 808.389, "timestamp": "00:13:28", "text": "。我的意思是，我可以把這次"}, {"type": "subtitle", "time": 811.59, "timestamp": "00:13:31", "text": "直播當作第一次直播，或者如果有人"}, {"type": "subtitle", "time": 814.71, "timestamp": "00:13:34", "text": "有任何問題，我可以……"}, {"type": "subtitle", "time": 819.67, "timestamp": "00:13:39", "text": "嗯……回答。但從"}, {"type": "subtitle", "time": 822.23, "timestamp": "00:13:42", "text": "今天之後，從下次直播開始，我"}, {"type": "subtitle", "time": 825.829, "timestamp": "00:13:45", "text": "希望我們能翻過這一"}, {"type": "subtitle", "time": 830.069, "timestamp": "00:13:50", "text": "頁，向前看，"}, {"type": "subtitle", "time": 834.23, "timestamp": "00:13:54", "text": "這也是我所希望的。"}, {"type": "subtitle", "time": 836.31, "timestamp": "00:13:56", "text": "謝謝Kakasan。考慮加入"}]
[{"type": "subtitle", "time": 1020.23, "timestamp": "00:17:00", "text": "類的。"}, {"type": "subtitle", "time": 1022.47, "timestamp": "00:17:02", "text": "好的，我有一些事情想"}, {"type": "subtitle", "time": 1024.15, "timestamp": "00:17:04", "text": "談談，"}, {"type": "subtitle", "time": 1025.829, "timestamp": "00:17:05", "text": "今天就先說完這些吧。"}, {"type": "chat", "time": 1026.809, "timestamp": "00:17:06", "author": "@kurunekodream", "avatar": "https://yt4.ggpht.com/RLzqgZjl8ILhIIU27ghgxtcyxaMDaQ4nJQ8GzPmDKVVI7HHPJUZsDQV_Itc49vlXGx8THQhiP90=s64-c-k-c0x00ffffff-no-rj", "message": "can't stay in the stream today because of some work sorry about that"}, {"type": "subtitle", "time": 1030.87, "timestamp": "00:17:10", "text": "既然事情已經發生，這將是我"}, {"type": "subtitle", "time": 1033.189, "timestamp": "00:17:13", "text": "第一次也是最後一次談論這件事"}, {"type": "chat", "time": 1033.481, "timestamp": "00:17:13", "author": "@terence1m1", "avatar": "https://yt4.ggpht.com/ZSLu2xKu0AG9hyqD2TMVUX0PWhfge9RgOTT9L5VJe5jcXwM-tiCva-Da6sNfe1NbMkVYd-a0=s64-c-k-c0x00ffffff-no-rj", "message": "Welcome back"}, {"type": "subtitle", "time": 1035.51, "timestamp": "00:17:15", "text": "。自從這件事"}, {"type": "subtitle", "time": 1038.47, "timestamp": "00:17:18", "text": "發生後，我注意到我的許多"}, {"type": "subtitle", "time": 1041.75, "timestamp": "00:17:21", "text": "社群成員都與我為敵。"}, {"type": "subtitle", "time": 1046.47, "timestamp": "00:17:26", "text": "你們當中90%的人都反對"}, {"type": "subtitle", "time": 1050.71, "timestamp": "00:17:30", "text": "我，事實就是如此。"}, {"type": "subtitle", "time": 1056.39, "timestamp": "00:17:36", "text": "正因如此，我不信任任何人，"}, {"type": "subtitle", "time": 1059.59, "timestamp": "00:17:39", "text": "而建立信任還需要很長時間"}, {"type": "subtitle", "time": 1062.39, "timestamp": "00:17:42", "text": "。"}, {"type": "subtitle", "time": 1066.39, "timestamp": "00:17:46", "text": "呃，不過如果你想看的話，隨時可以看"}, {"type": "subtitle", "time": 1069.669, "timestamp": "00:17:49", "text": "。如果你想繼續仇恨，或是"}, {"type": "chat", "time": 1069.872, "timestamp": "00:17:49", "author
[{"type": "subtitle", "time": 1141.99, "timestamp": "00:19:01", "text": "也一樣。小心。小心。謝謝你"}, {"type": "subtitle", "time": 1145.27, "timestamp": "00:19:05", "text": "過來，塔蘭。"}, {"type": "subtitle", "time": 1149.59, "timestamp": "00:19:09", "text": "謝謝光臨。還有，"}, {"type": "subtitle", "time": 1157.59, "timestamp": "00:19:17", "text": "特雷娜，恭喜你結婚五週年！"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "我沒能親自過來祝賀，不過，是的，"}, {"type": "subtitle", "time": 1167.86, "timestamp": "00:19:27", "text": "嗨"}, {"type": "subtitle", "time": 1169.75, "timestamp": "00:19:29", "text": "[音樂]"}, {"type": "subtitle", "time": 1171.27, "timestamp": "00:19:31", "text": "嗯，是的"}, {"type": "subtitle", "time": 1174.71, "timestamp": "00:19:34", "text": "。還有什麼？"}, {"type": "chat", "time": 1177.67, "timestamp": "00:19:37", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’m going to chant the navkar mantra. Then, go to sleep. 😴"}, {"type": "subtitle", "time": 1179.029, "timestamp": "00:19:39", "text": "所以關於社區的事情，嗯，"}, {"type": "subtitle", "time": 1182.15, "timestamp": "00:19:42", "text": "關於社區的事情，嗯，我的"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "社區星座，嗯，是的"}, {"type": "subtitle", "time": 1188.95, "timestamp": "00:19:48", "text": "，我可能認為它會"}, {"type": "subtitle", "time": 1192.31, "timestamp": "00:19:52", "text": "分成兩個之類的。人們"}, {"type": "subtitle", "time": 1195.27, "timestamp": "00:19:55", "text": "會引用我的話，也會引用那些"}, {"type": "subtitle", "time": 1198.95, "timestamp": "00:19:58", "text": "仍然站在另一邊的人的話，或是其他什麼人的話。"}]
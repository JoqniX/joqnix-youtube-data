[{"type": "chat", "time": 5462.045, "timestamp": "01:31:02", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "wow so alternating like this means more exposure for both... smart!"}, {"type": "chat", "time": 5466.052, "timestamp": "01:31:06", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2Ak"}, {"type": "subtitle", "time": 5472.47, "timestamp": "01:31:12", "text": "。合作有兩種方式。一種是"}, {"type": "subtitle", "time": 5475.43, "timestamp": "01:31:15", "text": "YouTuber在各自的頻道上進行直播，以他們自己的視角進行交流；另一種是，一個人可以去另一個人的頻道進行直播，比如有一天你去了YouTuber B的頻道，第二天，"}, {"type": "subtitle", "time": 5487.51, "timestamp": "01:31:27", "text": "或者一周後，你們可以互換角色。就像A會像這樣出現在B的頻道裡。是的，我解釋得有點多了，但其實，這更像是你在建立一種真誠的聯繫，一種真正的友誼，或者"}, {"type": "subtitle", "time": 5489.99, "timestamp": "01:31:29", "text": "某種程度上。是的。"}, {"type": "subtitle", "time": 5510.07, "timestamp": "01:31:50", "text": "但記住，你們都是娛樂從業者。你們是娛樂主播，你們是魔法師，你們是主播，你們是創作者。所以，即使是基於友誼的主播朋友，也會有很多事情發生，對吧？例如嫉妒之類的情緒。哦，你他她做得更好了，他做得更好了，等等等等，對吧？"}]
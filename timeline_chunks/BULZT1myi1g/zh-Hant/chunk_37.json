[{"type": "subtitle", "time": 2223.51, "timestamp": "00:37:03", "text": "最後一刻才開始的。嗯，我當時覺得自己根本沒"}, {"type": "subtitle", "time": 2227.99, "timestamp": "00:37:07", "text": "時間。我當時有點忙。"}, {"type": "subtitle", "time": 2229.91, "timestamp": "00:37:09", "text": "所以"}, {"type": "subtitle", "time": 2234.31, "timestamp": "00:37:14", "text": "我把所有東西都準備好，然後就做了"}, {"type": "subtitle", "time": 2237.349, "timestamp": "00:37:17", "text": "。  是的。"}, {"type": "subtitle", "time": 2243.27, "timestamp": "00:37:23", "text": "好的。嗯，如果你"}, {"type": "subtitle", "time": 2245.75, "timestamp": "00:37:25", "text": "要問的話，Jo"}, {"type": "subtitle", "time": 2249.109, "timestamp": "00:37:29", "text": "明天會直播慶祝排燈節。嗯，不太"}, {"type": "subtitle", "time": 2250.79, "timestamp": "00:37:30", "text": "確定。"}, {"type": "subtitle", "time": 2254.23, "timestamp": "00:37:34", "text": "因為我還要上課什麼的"}, {"type": "subtitle", "time": 2256.55, "timestamp": "00:37:36", "text": "。說到這個，呃，直播時間到。"}, {"type": "subtitle", "time": 2259.589, "timestamp": "00:37:39", "text": "呃，我什麼時候開始直播？"}, {"type": "subtitle", "time": 2263.109, "timestamp": "00:37:43", "text": "我的時代會是怎麼樣的？呃，直播時間。我的"}, {"type": "subtitle", "time": 2265.75, "timestamp": "00:37:45", "text": "直播時間大概都在這個時段，像是"}, {"type": "subtitle", "time": 2269.349, "timestamp": "00:37:49", "text": "上午 10 點左右。"}, {"type": "subtitle", "time": 2272.31, "timestamp": "00:37:52", "text": "我以前就是這麼做的。呃，"}, {"type": "subtitle", "time": 2275.589, "timestamp": "00:37:55", "text": "以前我會直播的時候，像是參加 Joathon 之類的活動，"}, {"type": "subtitle", "time": 2277.349, "timestamp": "00:37:57", "text": "我都會選擇特定的時段。"}]
[{"type": "subtitle", "time": 3901.43, "timestamp": "01:05:01", "text": "更加认真对待一切。"}, {"type": "subtitle", "time": 3904.39, "timestamp": "01:05:04", "text": "嗯，是的，我的意思是，这也适用于我。"}, {"type": "subtitle", "time": 3906.15, "timestamp": "01:05:06", "text": "我现在是一家公司了。 我是灵魂的"}, {"type": "subtitle", "time": 3908.95, "timestamp": "01:05:08", "text": "主人。 所以，我应该算是"}, {"type": "subtitle", "time": 3912.23, "timestamp": "01:05:12", "text": "全职主播，而不是把主播当成一个"}, {"type": "subtitle", "time": 3914.47, "timestamp": "01:05:14", "text": "充满热情的业余爱好者"}, {"type": "subtitle", "time": 3918.23, "timestamp": "01:05:18", "text": "或业余直播者，对吧？ 我"}, {"type": "subtitle", "time": 3922.47, "timestamp": "01:05:22", "text": "每个月都要申报消费税，感觉"}, {"type": "subtitle", "time": 3927.829, "timestamp": "01:05:27", "text": "好多东西都要申报，对吧？   是的"}, {"type": "subtitle", "time": 3930.95, "timestamp": "01:05:30", "text": "。"}, {"type": "subtitle", "time": 3933.99, "timestamp": "01:05:33", "text": "哦，对了，商品及服务税（GST）申报是上个月提交的。"}, {"type": "subtitle", "time": 3937.109, "timestamp": "01:05:37", "text": "我不得不这么做，兄弟。 但我进去的时候"}, {"type": "subtitle", "time": 3944.87, "timestamp": "01:05:44", "text": "东西并不多。"}, {"type": "subtitle", "time": 3947.19, "timestamp": "01:05:47", "text": "至于 YouTube 和 YouTube 的"}, {"type": "subtitle", "time": 3948.95, "timestamp": "01:05:48", "text": "收益支付等等，就像我"}, {"type": "subtitle", "time": 3951.029, "timestamp": "01:05:51", "text": "在我的更新视频中提到的那样，我不得不"}, {"type": "subtitle", "time": 3957.349, "timestamp": "01:05:57", "text": "填写一份"}]
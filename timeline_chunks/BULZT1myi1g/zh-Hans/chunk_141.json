[{"type": "subtitle", "time": 8462.55, "timestamp": "02:21:02", "text": "过去发生的那些破事了，现在我们要向前看了。"}, {"type": "subtitle", "time": 8465.59, "timestamp": "02:21:05", "text": "我要翻篇了，我们现在可以拿这件事开玩笑了，嗯，"}, {"type": "subtitle", "time": 8468.71, "timestamp": "02:21:08", "text": "我想。"}, {"type": "subtitle", "time": 8472.55, "timestamp": "02:21:12", "text": "如果有人想"}, {"type": "subtitle", "time": 8474.71, "timestamp": "02:21:14", "text": "知道最新进展，比如会不会闹上法庭"}, {"type": "subtitle", "time": 8477.75, "timestamp": "02:21:17", "text": "或者发生什么法律纠纷之类的，"}, {"type": "subtitle", "time": 8480.15, "timestamp": "02:21:20", "text": "我不会公开"}, {"type": "subtitle", "time": 8482.71, "timestamp": "02:21:22", "text": "透露的。如果真要发生，它自然会"}, {"type": "subtitle", "time": 8485.67, "timestamp": "02:21:25", "text": "发生。嗯，就这些，我"}, {"type": "subtitle", "time": 8487.99, "timestamp": "02:21:27", "text": "只能说这么多了。嗨，"}, {"type": "subtitle", "time": 8491.349, "timestamp": "02:21:31", "text": "因为这次我不能透露太多，如果真有什么事发生，我可不能跟你"}, {"type": "subtitle", "time": 8492.71, "timestamp": "02:21:32", "text": "打招呼，"}, {"type": "subtitle", "time": 8495.429, "timestamp": "02:21:35", "text": "对吧？"}, {"type": "subtitle", "time": 8498.63, "timestamp": "02:21:38", "text": "因为这一切都会在幕后发生。"}, {"type": "subtitle", "time": 8500.63, "timestamp": "02:21:40", "text": "呃，如果有什么我可以"}, {"type": "subtitle", "time": 8503.51, "timestamp": "02:21:43", "text": "透露的最新消息，我会告诉你的。 就这样"}, {"type": "subtitle", "time": 8506.389, "timestamp": "02:21:46", "text": "。 但我主要想向前看，"}, {"type": "subtitle", "time": 8509.429, "timestamp": "02:21:49", "text": "我已经原谅了那些"}, {"type": "subtitle", "time": 8511.91, "timestamp": "02:21:51", "text": "做过那些事的人，我只想"}, {"type": "subtitle", "time": 8513.83, "timestamp": "02:21:53", "text": "继续前进。 我就是不想再跟"}, {"type": "subtitle", "time": 8517.91, "timestamp": "02:21:57", "text": "他们有任何瓜葛，也不想再跟"}]
[{"type": "subtitle", "time": 5522.229, "timestamp": "01:32:02", "text": "友谊，它必须更多地基于工作，"}, {"type": "subtitle", "time": 5524.229, "timestamp": "01:32:04", "text": "最好让一切都"}, {"type": "subtitle", "time": 5527.43, "timestamp": "01:32:07", "text": "与工作相关。 某种程度上来说是这样。就像"}, {"type": "chat", "time": 5529.279, "timestamp": "01:32:09", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "ah I'm bad with that stuff... I just tend to avoid jelly and toxic folks UCkszU2WH9gy1mb0dV-11UJg/ygF1XpGUMMjk8gSDrI2wCx"}, {"type": "subtitle", "time": 5529.75, "timestamp": "01:32:09", "text": "同事、工作伙伴、熟人之"}, {"type": "subtitle", "time": 5531.91, "timestamp": "01:32:11", "text": "类的，你知道，"}, {"type": "subtitle", "time": 5534.39, "timestamp": "01:32:14", "text": "我觉得这样挺好的，因为在某种程度上，你必须"}, {"type": "subtitle", "time": 5536.07, "timestamp": "01:32:16", "text": "尊重彼此的界限"}, {"type": "subtitle", "time": 5539.03, "timestamp": "01:32:19", "text": "等等。还有"}, {"type": "subtitle", "time": 5544.07, "timestamp": "01:32:24", "text": "社群层面，嗯，界限也很重要"}, {"type": "subtitle", "time": 5546.55, "timestamp": "01:32:26", "text": "。例如，"}, {"type": "subtitle", "time": 5549.43, "timestamp": "01:32:29", "text": "VTuber A 是男性，VTuber B 是"}, {"type": "subtitle", "time": 5551.99, "timestamp": "01:32:31", "text": "女性。如果他们合作，"}, {"type": "subtitle", "time": 5555.27, "timestamp": "01:32:35", "text": "可能会有八卦之类的。比如"}, {"type": "subtitle", "time": 5557.91, "timestamp": "01:32:37", "text": "你的社群会把他们配对什么的"}, {"type": "subtitle", "time": 5559.99, "timestamp": "01:32:39", "text": "。你不想这种情况发生，"}, {"type": "subtitle", "time": 5564.709, "timestamp": "01:32:44", "text": "给你的"}, {"type": "subtitle", "time": 5567.27, "timestamp": "01:32:47", "text": "朋友 A 和 B 带来麻烦。所以你必须"}, {"type": "subtitle", "time": 5569.11, "timestamp": "01:32:49", "text": "为你的社群设定一些界限，"}, {"type": "subtitle", "time": 5572.709, "timestamp": "01:32:52", "text": "这样他们就不会越界等等。"}, {"type": "subtitle", "time": 5579.189, "timestamp": "01:32:59", "text": "所有这些都很重要。是的，"}]
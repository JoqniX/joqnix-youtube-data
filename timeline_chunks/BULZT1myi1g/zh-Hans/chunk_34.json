[{"type": "subtitle", "time": 2043.35, "timestamp": "00:34:03", "text": "我制作素材的人提供的素材。 嗯，"}, {"type": "subtitle", "time": 2047.509, "timestamp": "00:34:07", "text": "自从我收到道具……就像你收到一份"}, {"type": "subtitle", "time": 2053.349, "timestamp": "00:34:13", "text": "正式的……该怎么称呼呢……正式的"}, {"type": "subtitle", "time": 2056.629, "timestamp": "00:34:16", "text": "沟通通知，告知我不要使用"}, {"type": "subtitle", "time": 2060.629, "timestamp": "00:34:20", "text": "某些素材，比如音乐……那样就不"}, {"type": "subtitle", "time": 2063.829, "timestamp": "00:34:23", "text": "一样了。 我将使用"}, {"type": "subtitle", "time": 2070.869, "timestamp": "00:34:30", "text": "一段随机播放的音乐。 嗯，是的，嗯，"}, {"type": "subtitle", "time": 2074.389, "timestamp": "00:34:34", "text": "那会在那里。 至于制作人员"}, {"type": "subtitle", "time": 2077.51, "timestamp": "00:34:37", "text": "名单，比如那些"}, {"type": "subtitle", "time": 2086.869, "timestamp": "00:34:46", "text": "为我制作广播节目、粉丝艺术作品、"}, {"type": "subtitle", "time": 2091.909, "timestamp": "00:34:51", "text": "音乐、"}, {"type": "subtitle", "time": 2094.389, "timestamp": "00:34:54", "text": "图形等等的人。 这些人"}, {"type": "subtitle", "time": 2097.109, "timestamp": "00:34:57", "text": "总会在我的网站或"}]
[{"type": "subtitle", "time": 5101.35, "timestamp": "01:25:01", "text": "。就像我不可能"}, {"type": "subtitle", "time": 5104.39, "timestamp": "01:25:04", "text": "什么都知道，但我自己也"}, {"type": "subtitle", "time": 5107.189, "timestamp": "01:25:07", "text": "每天都在学习。"}, {"type": "subtitle", "time": 5109.189, "timestamp": "01:25:09", "text": "推特上的人会分享他们的"}, {"type": "subtitle", "time": 5111.83, "timestamp": "01:25:11", "text": "经验、各种指南"}, {"type": "subtitle", "time": 5114.39, "timestamp": "01:25:14", "text": "等等。所以，"}, {"type": "subtitle", "time": 5120.07, "timestamp": "01:25:20", "text": "除了我自己的直播之外，我不太在推特上发东西。"}, {"type": "subtitle", "time": 5123.91, "timestamp": "01:25:23", "text": "我不会把它当成"}, {"type": "subtitle", "time": 5128.55, "timestamp": "01:25:28", "text": "日记或者像其他人那样用，"}, {"type": "subtitle", "time": 5147.83, "timestamp": "01:25:47", "text": "[音乐]"}, {"type": "subtitle", "time": 5151.35, "timestamp": "01:25:51", "text": "我好像说了好多废话，是吧？是"}, {"type": "subtitle", "time": 5154.47, "timestamp": "01:25:54", "text": "啊。拜拜。"}, {"type": "subtitle", "time": 5158.39, "timestamp": "01:25:58", "text": "今天我上日语课"}]
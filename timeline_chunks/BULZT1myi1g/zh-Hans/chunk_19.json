[{"type": "subtitle", "time": 1141.99, "timestamp": "00:19:01", "text": "也一样。 小心。 小心。 谢谢你"}, {"type": "subtitle", "time": 1145.27, "timestamp": "00:19:05", "text": "过来，塔兰。"}, {"type": "subtitle", "time": 1149.59, "timestamp": "00:19:09", "text": "谢谢光临。 还有，"}, {"type": "subtitle", "time": 1157.59, "timestamp": "00:19:17", "text": "特雷娜，祝贺你结婚五周年！"}, {"type": "subtitle", "time": 1160.549, "timestamp": "00:19:20", "text": "我没能亲自过来祝贺，不过，是的，"}, {"type": "subtitle", "time": 1167.86, "timestamp": "00:19:27", "text": "嗨"}, {"type": "subtitle", "time": 1169.75, "timestamp": "00:19:29", "text": "[音乐]"}, {"type": "subtitle", "time": 1171.27, "timestamp": "00:19:31", "text": "嗯，是的"}, {"type": "subtitle", "time": 1174.71, "timestamp": "00:19:34", "text": "。 还有什么？"}, {"type": "chat", "time": 1177.67, "timestamp": "00:19:37", "author": "@ObnoxiousAgnostic", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kVrH3KET_eX7LDEi_ka-c3eoI3J-Vcy4GX19VQNPnWwZQ=s64-c-k-c0x00ffffff-no-rj", "message": "I’m going to chant the navkar mantra. Then, go to sleep. 😴"}, {"type": "subtitle", "time": 1179.029, "timestamp": "00:19:39", "text": "所以关于社区的事情，嗯，"}, {"type": "subtitle", "time": 1182.15, "timestamp": "00:19:42", "text": "关于社区的事情，嗯，我的"}, {"type": "subtitle", "time": 1184.71, "timestamp": "00:19:44", "text": "社区星座，"}, {"type": "subtitle", "time": 1186.47, "timestamp": "00:19:46", "text": "嗯，是的"}, {"type": "subtitle", "time": 1188.95, "timestamp": "00:19:48", "text": "，我可能认为它会"}, {"type": "subtitle", "time": 1192.31, "timestamp": "00:19:52", "text": "分成两个之类的。 人们"}, {"type": "subtitle", "time": 1195.27, "timestamp": "00:19:55", "text": "会引用我的话，也会引用那些"}, {"type": "subtitle", "time": 1198.95, "timestamp": "00:19:58", "text": "仍然站在另一边的人的话，或者其他什么人的话。"}]
[{"type": "subtitle", "time": 1742.789, "timestamp": "00:29:02", "text": "嗯，是的，所以目前我会用它来"}, {"type": "subtitle", "time": 1745.51, "timestamp": "00:29:05", "text": "处理旧的实时 3D 效果。"}, {"type": "subtitle", "time": 1751.35, "timestamp": "00:29:11", "text": "嗯，它仍然是我的。 所以，如果我"}, {"type": "subtitle", "time": 1754.63, "timestamp": "00:29:14", "text": "以后还想用它，我会"}, {"type": "subtitle", "time": 1758.23, "timestamp": "00:29:18", "text": "那样做。 或者，一旦"}, {"type": "subtitle", "time": 1761.43, "timestamp": "00:29:21", "text": "我的新模型准备就绪，我可能会"}, {"type": "subtitle", "time": 1763.99, "timestamp": "00:29:23", "text": "从现在开始优先使用它"}, {"type": "subtitle", "time": 1765.51, "timestamp": "00:29:25", "text": "。"}, {"type": "subtitle", "time": 1767.83, "timestamp": "00:29:27", "text": "呃，因为这更像是一切的重新开始"}, {"type": "subtitle", "time": 1770.95, "timestamp": "00:29:30", "text": "，对吧？"}, {"type": "subtitle", "time": 1777.19, "timestamp": "00:29:37", "text": "我想寄五个。 没关系。 一切都好"}, {"type": "subtitle", "time": 1778.789, "timestamp": "00:29:38", "text": "。"}, {"type": "subtitle", "time": 1782.87, "timestamp": "00:29:42", "text": "还有什么呢？ 我错过了很多。"}, {"type": "subtitle", "time": 1785.909, "timestamp": "00:29:45", "text": "我的大脑一片空白。"}, {"type": "subtitle", "time": 1787.75, "timestamp": "00:29:47", "text": "还有什么？ 呃，我谈到了"}, {"type": "subtitle", "time": 1790.07, "timestamp": "00:29:50", "text": "内容方面的事情"}, {"type": "subtitle", "time": 1795.11, "timestamp": "00:29:55", "text": "等等。 是的。 你好。 嗯，"}, {"type": "subtitle", "time": 1798.149, "timestamp": "00:29:58", "text": "如果你有什么问题，"}]
[{"type": "subtitle", "time": 5700.07, "timestamp": "01:35:00", "text": "如果 你要和一位"}, {"type": "subtitle", "time": 5703.669, "timestamp": "01:35:03", "text": "专业级别的 YouTuber 合作，就是那种把"}, {"type": "subtitle", "time": 5705.99, "timestamp": "01:35:05", "text": "YouTube 当作"}, {"type": "subtitle", "time": 5708.07, "timestamp": "01:35:08", "text": "全职工作，认真对待，有正规"}, {"type": "subtitle", "time": 5710.79, "timestamp": "01:35:10", "text": "管理，独立运营，处理各种"}, {"type": "subtitle", "time": 5712.87, "timestamp": "01:35:12", "text": "问题、手续、邮件往来等等的那种。"}, {"type": "subtitle", "time": 5718.149, "timestamp": "01:35:18", "text": "为此，"}, {"type": "subtitle", "time": 5720.87, "timestamp": "01:35:20", "text": "合作方会给你一份合作规则表，上面"}, {"type": "subtitle", "time": 5724.39, "timestamp": "01:35:24", "text": "列出了他们能"}, {"type": "subtitle", "time": 5726.95, "timestamp": "01:35:26", "text": "接受和不能"}, {"type": "subtitle", "time": 5728.709, "timestamp": "01:35:28", "text": "接受的内容。比如，如果你喜欢"}, {"type": "subtitle", "time": 5731.189, "timestamp": "01:35:31", "text": "开玩笑，"}, {"type": "subtitle", "time": 5733.03, "timestamp": "01:35:33", "text": "他们会列出一些限制，比如“我"}, {"type": "subtitle", "time": 5735.59, "timestamp": "01:35:35", "text": "不喜欢自说自话”等等。"}, {"type": "subtitle", "time": 5737.669, "timestamp": "01:35:37", "text": "这些内容规则包括哪些可以"}, {"type": "subtitle", "time": 5739.75, "timestamp": "01:35:39", "text": "接受，哪些不可以接受，"}, {"type": "subtitle", "time": 5742.629, "timestamp": "01:35:42", "text": "以及哪些内容允许，哪些内容"}, {"type": "subtitle", "time": 5744.31, "timestamp": "01:35:44", "text": "不允许。此外，"}, {"type": "subtitle", "time": 5748.229, "timestamp": "01:35:48", "text": "在"}, {"type": "subtitle", "time": 5749.51, "timestamp": "01:35:49", "text": "Twitter 等平台上，也会有类似的合作规则"}, {"type": "subtitle", "time": 5752.07, "timestamp": "01:35:52", "text": "表，上面会列出"}, {"type": "subtitle", "time": 5754.149, "timestamp": "01:35:54", "text": "你们玩的游戏类型、"}, {"type": "subtitle", "time": 5756.55, "timestamp": "01:35:56", "text": "你们想玩的游戏等等。具体情况"}]
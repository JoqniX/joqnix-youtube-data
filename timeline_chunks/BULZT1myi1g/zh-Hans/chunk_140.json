[{"type": "subtitle", "time": 8400.15, "timestamp": "02:20:00", "text": "任何不满，你随时可以"}, {"type": "subtitle", "time": 8402.63, "timestamp": "02:20:02", "text": "取消关注、取消订阅、屏蔽"}, {"type": "subtitle", "time": 8404.95, "timestamp": "02:20:04", "text": "等等。 由你决定。 我不在乎。"}, {"type": "subtitle", "time": 8407.51, "timestamp": "02:20:07", "text": "嗯，我只想为那些"}, {"type": "subtitle", "time": 8410.469, "timestamp": "02:20:10", "text": "愿意支持我、会到场的人做这件事，"}, {"type": "subtitle", "time": 8415.75, "timestamp": "02:20:15", "text": "而且，嗯，因为这是一个重建的篇章。"}, {"type": "subtitle", "time": 8418.63, "timestamp": "02:20:18", "text": "是的，我会考虑这一点，"}, {"type": "subtitle", "time": 8422.87, "timestamp": "02:20:22", "text": "嗯，我会继续尽我"}, {"type": "subtitle", "time": 8425.75, "timestamp": "02:20:25", "text": "所能，每个人都保持"}, {"type": "subtitle", "time": 8429.99, "timestamp": "02:20:29", "text": "中立的态度，就像，嗯，我们会看看"}, {"type": "subtitle", "time": 8433.91, "timestamp": "02:20:33", "text": "你如何根据情况做你的事情"}, {"type": "subtitle", "time": 8436.469, "timestamp": "02:20:36", "text": "。 我们会决定是否支持"}, {"type": "subtitle", "time": 8438.55, "timestamp": "02:20:38", "text": "你之类的。 这就是"}, {"type": "subtitle", "time": 8441.349, "timestamp": "02:20:41", "text": "我所说的中立立场。 所以，"}, {"type": "subtitle", "time": 8443.75, "timestamp": "02:20:43", "text": "作为一名创作者，当我回归"}, {"type": "subtitle", "time": 8446.15, "timestamp": "02:20:46", "text": "直播时，我会尽我所能，以此作为衡量"}, {"type": "subtitle", "time": 8451.349, "timestamp": "02:20:51", "text": "标准。 嗨，我会全力以赴。"}, {"type": "subtitle", "time": 8454.63, "timestamp": "02:20:54", "text": "嗨，这就是我所相信的一切，"}, {"type": "subtitle", "time": 8457.67, "timestamp": "02:20:57", "text": "我建议不要再谈论"}]
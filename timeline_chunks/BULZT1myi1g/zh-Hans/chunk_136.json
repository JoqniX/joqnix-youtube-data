[{"type": "subtitle", "time": 8164.87, "timestamp": "02:16:04", "text": "作为一名印度 YouTuber，因为面临这些问题，在 joathon 比赛中遇到困难的原因。 就是"}, {"type": "subtitle", "time": 8166.87, "timestamp": "02:16:06", "text": "这样。"}, {"type": "subtitle", "time": 8169.589, "timestamp": "02:16:09", "text": "所以，在合作方面，我会"}, {"type": "subtitle", "time": 8172.79, "timestamp": "02:16:12", "text": "稍微开放一些，"}, {"type": "subtitle", "time": 8175.669, "timestamp": "02:16:15", "text": "与他人合作，在他们的"}, {"type": "subtitle", "time": 8179.669, "timestamp": "02:16:19", "text": "频道、视频或直播中进行合作。如果我"}, {"type": "subtitle", "time": 8182.87, "timestamp": "02:16:22", "text": "参与或进行这些"}, {"type": "subtitle", "time": 8186.069, "timestamp": "02:16:26", "text": "合作，这些合作内容会在我的"}, {"type": "subtitle", "time": 8188.47, "timestamp": "02:16:28", "text": "YouTube 频道的合作"}, {"type": "subtitle", "time": 8190.629, "timestamp": "02:16:30", "text": "版块中展示，这是 YouTube 的一个新功能。"}, {"type": "subtitle", "time": 8193.429, "timestamp": "02:16:33", "text": "我也会在"}, {"type": "subtitle", "time": 8195.83, "timestamp": "02:16:35", "text": "我的社交媒体上提及我正在与"}, {"type": "subtitle", "time": 8198.95, "timestamp": "02:16:38", "text": "某人合作等等。 你好。"}, {"type": "subtitle", "time": 8201.429, "timestamp": "02:16:41", "text": "我希望"}, {"type": "subtitle", "time": 8204.629, "timestamp": "02:16:44", "text": "我的频道上不会与任何人合作。 请"}, {"type": "subtitle", "time": 8207.99, "timestamp": "02:16:47", "text": "注意这一点，因为"}, {"type": "subtitle", "time": 8211.91, "timestamp": "02:16:51", "text": "印度的会议氛围真的非常糟糕。"}, {"type": "subtitle", "time": 8214.79, "timestamp": "02:16:54", "text": "我不希望那些想站在我这边的人"}, {"type": "subtitle", "time": 8217.429, "timestamp": "02:16:57", "text": "、那些想支持我的人，"}, {"type": "subtitle", "time": 8219.83, "timestamp": "02:16:59", "text": "或者那些想公开和我交流的创作同行"}]
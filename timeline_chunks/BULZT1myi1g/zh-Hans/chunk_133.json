[{"type": "subtitle", "time": 7982.47, "timestamp": "02:13:02", "text": "我未来计划做的任何事。 是的"}, {"type": "subtitle", "time": 7984.229, "timestamp": "02:13:04", "text": "，"}, {"type": "subtitle", "time": 7986.87, "timestamp": "02:13:06", "text": "我完全赞成你们支持其他"}, {"type": "subtitle", "time": 7990.709, "timestamp": "02:13:10", "text": "创作者，比如如果你来自"}, {"type": "subtitle", "time": 7993.43, "timestamp": "02:13:13", "text": "印度音乐圈，"}, {"type": "subtitle", "time": 7995.27, "timestamp": "02:13:15", "text": "嗯，你可以随意支持任何你"}, {"type": "subtitle", "time": 7997.83, "timestamp": "02:13:17", "text": "想支持的人。 不管发生了什么，一切都好"}, {"type": "subtitle", "time": 8000.069, "timestamp": "02:13:20", "text": "。 我不会在意，"}, {"type": "subtitle", "time": 8002.47, "timestamp": "02:13:22", "text": "但你是否仍然想"}, {"type": "subtitle", "time": 8006.149, "timestamp": "02:13:26", "text": "支持他人，这是"}, {"type": "subtitle", "time": 8012.069, "timestamp": "02:13:32", "text": "你的自由，等等等等，所以，选择权在你。但"}, {"type": "subtitle", "time": 8015.51, "timestamp": "02:13:35", "text": "我要明确一点，从今"}, {"type": "subtitle", "time": 8018.709, "timestamp": "02:13:38", "text": "以后，如果我的任何社区"}, {"type": "subtitle", "time": 8023.03, "timestamp": "02:13:43", "text": "成员受到攻击或其他任何伤害，"}, {"type": "subtitle", "time": 8026.31, "timestamp": "02:13:46", "text": "我都会挺身而出。 我会"}, {"type": "subtitle", "time": 8028.47, "timestamp": "02:13:48", "text": "站出来保护我自己的社区"}, {"type": "subtitle", "time": 8030.31, "timestamp": "02:13:50", "text": "和空间，"}, {"type": "subtitle", "time": 8033.27, "timestamp": "02:13:53", "text": "因为我关心它，是的，"}, {"type": "subtitle", "time": 8037.35, "timestamp": "02:13:57", "text": "这就是我想说的。"}, {"type": "subtitle", "time": 8039.35, "timestamp": "02:13:59", "text": "至于鼓之类的东西，"}]
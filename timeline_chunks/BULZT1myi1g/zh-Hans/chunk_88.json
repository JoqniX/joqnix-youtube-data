[{"type": "subtitle", "time": 5281.59, "timestamp": "01:28:01", "text": "直播间里一起做内容，"}, {"type": "subtitle", "time": 5283.43, "timestamp": "01:28:03", "text": "对吧？说到YouTube主播的"}, {"type": "subtitle", "time": 5285.99, "timestamp": "01:28:05", "text": "合作， 大概就是，"}, {"type": "subtitle", "time": 5290.95, "timestamp": "01:28:10", "text": "嗯，就像一个人"}, {"type": "subtitle", "time": 5292.87, "timestamp": "01:28:12", "text": "在自己的频道直播，另一个"}, {"type": "subtitle", "time": 5296.149, "timestamp": "01:28:16", "text": "YouTuber也会出现在他的频道里。"}, {"type": "subtitle", "time": 5298.629, "timestamp": "01:28:18", "text": "比如YouTuber A和虚拟主播B。虚拟主播"}, {"type": "subtitle", "time": 5301.189, "timestamp": "01:28:21", "text": "A会和虚拟主播B一起直播。"}, {"type": "subtitle", "time": 5303.91, "timestamp": "01:28:23", "text": "虚拟主播B会出现在A的频道里。这就"}, {"type": "subtitle", "time": 5306.629, "timestamp": "01:28:26", "text": "像是"}, {"type": "subtitle", "time": 5311.99, "timestamp": "01:28:31", "text": "A和B两个社群的融合。A的社群会和"}, {"type": "subtitle", "time": 5314.229, "timestamp": "01:28:34", "text": "B的社群相遇，B的"}, {"type": "subtitle", "time": 5316.229, "timestamp": "01:28:36", "text": "社群也会和A的"}, {"type": "subtitle", "time": 5320.31, "timestamp": "01:28:40", "text": "社群互动。这就像是"}, {"type": "subtitle", "time": 5324.47, "timestamp": "01:28:44", "text": "彼此联系、一起"}, {"type": "subtitle", "time": 5327.35, "timestamp": "01:28:47", "text": "玩耍的一种方式。那么，从"}, {"type": "chat", "time": 5328.884, "timestamp": "01:28:48", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "Partnering together for some shared goals?"}, {"type": "subtitle", "time": 5329.51, "timestamp": "01:28:49", "text": "内容创作的角度来看，这就像"}, {"type": "subtitle", "time": 5332.55, "timestamp": "01:28:52", "text": "你"}, {"type": "subtitle", "time": 5335.03, "timestamp": "01:28:55", "text": "和朋友一起玩游戏一样。你在网上认识了一个新"}, {"type": "subtitle", "time": 5338.149, "tim
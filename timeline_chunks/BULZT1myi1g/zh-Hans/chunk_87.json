[{"type": "subtitle", "time": 5221.189, "timestamp": "01:27:01", "text": "呃，日本、韩国、中国、"}, {"type": "subtitle", "time": 5225.43, "timestamp": "01:27:05", "text": "越南的那些认识我，并且想"}, {"type": "chat", "time": 5226.992, "timestamp": "01:27:06", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "I heard this word collab a loooot, what's it mean actually, like a contract between different streamers to stream together??"}, {"type": "subtitle", "time": 5228.229, "timestamp": "01:27:08", "text": "和我一起参加Joathon活动的人，"}, {"type": "subtitle", "time": 5232.47, "timestamp": "01:27:12", "text": "他们完全了解我的情况，呃，是的，"}, {"type": "subtitle", "time": 5234.95, "timestamp": "01:27:14", "text": "他们中的一些人发现了这件事，呃，选择和"}, {"type": "subtitle", "time": 5241.59, "timestamp": "01:27:21", "text": "我保持联系，呃，"}, {"type": "subtitle", "time": 5244.07, "timestamp": "01:27:24", "text": "站在我这边，希望看到我"}, {"type": "subtitle", "time": 5246.07, "timestamp": "01:27:26", "text": "做得更好，他们也愿意"}, {"type": "subtitle", "time": 5247.59, "timestamp": "01:27:27", "text": "在未来继续合作"}, {"type": "subtitle", "time": 5250.629, "timestamp": "01:27:30", "text": "。所以我对此感到很兴奋。"}, {"type": "subtitle", "time": 5253.27, "timestamp": "01:27:33", "text": "所以，是的，我经常听到“合作”这个词。它"}, {"type": "subtitle", "time": 5255.03, "timestamp": "01:27:35", "text": "到底是什么意思？是"}, {"type": "subtitle", "time": 5256.709, "timestamp": "01:27:36", "text": "不同的主播之间签订合同"}, {"type": "subtitle", "time": 5259.51, "timestamp": "01:27:39", "text": "一起直播吗？好吧，有两种方式"}, {"type": "subtitle", "time": 5263.51, "timestamp": "01:27:43", "text": "。我来说说我"}, {"type": "subtitle", "time": 5266.79, "timestamp": "01:27:46", "text": "理解的。好吧，"}, {"type": "subtitle", "time": 5269.11, "timestamp": "01:27:49", "text": "既然你想开始直播"}, {"type": "subtitle", "time": 5271.35, "timestamp": "01:27:51", "text": "什么的，对吧？合作。"}, {"type": "subtitle", "time": 5273.35, "timestamp": "01:27:53", "text": "合作这个词指的是两个"}, {"type": "subtitle", "time": 5278.47, "timestamp": "01:27:58", "text": "创作者合作，或者出现在同一个"}]
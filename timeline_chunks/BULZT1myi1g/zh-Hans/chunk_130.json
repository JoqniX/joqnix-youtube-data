[{"type": "subtitle", "time": 7802.87, "timestamp": "02:10:02", "text": "25日 哦，还有5天。 等不及了。"}, {"type": "subtitle", "time": 7805.75, "timestamp": "02:10:05", "text": "顺便说一句，我们会进行直播。"}, {"type": "subtitle", "time": 7807.589, "timestamp": "02:10:07", "text": "他……嗯"}, {"type": "subtitle", "time": 7810.39, "timestamp": "02:10:10", "text": "，"}, {"type": "subtitle", "time": 7812.95, "timestamp": "02:10:12", "text": "太棒了。"}, {"type": "subtitle", "time": 7815.91, "timestamp": "02:10:15", "text": "但我想再次"}, {"type": "subtitle", "time": 7818.79, "timestamp": "02:10:18", "text": "真诚地感谢大家。 嗯，"}, {"type": "subtitle", "time": 7821.75, "timestamp": "02:10:21", "text": "没想到直播会这么顺利，"}, {"type": "subtitle", "time": 7826.47, "timestamp": "02:10:26", "text": "嗯，谢谢"}, {"type": "subtitle", "time": 7829.75, "timestamp": "02:10:29", "text": "大家的到来，也谢谢"}, {"type": "subtitle", "time": 7832.149, "timestamp": "02:10:32", "text": "今天和我互动、"}, {"type": "subtitle", "time": 7835.109, "timestamp": "02:10:35", "text": "在聊天室留言的各位，还有那些潜水的朋友们"}, {"type": "subtitle", "time": 7838.95, "timestamp": "02:10:38", "text": "。 感谢各位潜水观看，也感谢各位"}, {"type": "subtitle", "time": 7840.79, "timestamp": "02:10:40", "text": "参与直播并聆听"}, {"type": "subtitle", "time": 7843.91, "timestamp": "02:10:43", "text": "我的发言。 我期待"}, {"type": "subtitle", "time": 7847.43, "timestamp": "02:10:47", "text": "大家继续支持我"}, {"type": "subtitle", "time": 7851.189, "timestamp": "02:10:51", "text": "在伍兹的这段旅程，以及"}, {"type": "subtitle", "time": 7854.069, "timestamp": "02:10:54", "text": "我未来想做的任何事。"}, {"type": "subtitle", "time": 7857.35, "timestamp": "02:10:57", "text": "嗯，算是对"}]
[{"type": "subtitle", "time": 4681.43, "timestamp": "01:18:01", "text": "星座。"}, {"type": "subtitle", "time": 4685.35, "timestamp": "01:18:05", "text": "呃，星座的星体投射者。"}, {"type": "subtitle", "time": 4688.229, "timestamp": "01:18:08", "text": "这在某种程度上是新"}, {"type": "subtitle", "time": 4692.95, "timestamp": "01:18:12", "text": "码头下层的一部分。呃，我的意思是，它仍然适用于"}, {"type": "subtitle", "time": 4695.27, "timestamp": "01:18:15", "text": "这里。我仍然是星座的投射者"}, {"type": "chat", "time": 4697.821, "timestamp": "01:18:17", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/DfgfY9LaNdmMq7IPuI2AaA"}, {"type": "subtitle", "time": 4698.39, "timestamp": "01:18:18", "text": "。更像是……呃，是的，"}, {"type": "subtitle", "time": 4700.55, "timestamp": "01:18:20", "text": "我是一个实体，"}, {"type": "subtitle", "time": 4705.11, "timestamp": "01:18:25", "text": "呃，我是一个天体实体，我……呃，那"}, {"type": "subtitle", "time": 4708.63, "timestamp": "01:18:28", "text": "是什么？就像……呃，我该怎么说"}, {"type": "subtitle", "time": 4711.189, "timestamp": "01:18:31", "text": "呢？就像我可以创造星座，"}, {"type": "subtitle", "time": 4714.149, "timestamp": "01:18:34", "text": "或者与现有的"}, {"type": "subtitle", "time": 4719.43, "timestamp": "01:18:39", "text": "星座或黄道十二宫产生共鸣，呃，"}, {"type": "subtitle", "time": 4722.79, "timestamp": "01:18:42", "text": "创造……东西等等。这难道不更像是"}, {"type": "subtitle", "time": 4726.229, "timestamp": "01:18:46", "text": "一个守护者吗？ 关于"}, {"type": "subtitle", "time": 4728.63, "timestamp": "01:18:48", "text": "星座之类的？哦，背后还有完整的背景"}, {"type": "subtitle", "time": 4731.11, "timestamp": "01:18:51", "text": "故事。兄弟，我不想"}, {"type": "subtitle", "time": 4734.39, "timestamp": "01:18:54", "text": "剧透太多。新的运动健将角色会"}, {"type": "subtitle", "time": 4739.51, "timestamp": "01:18:59", "text": "很棒。是"}]
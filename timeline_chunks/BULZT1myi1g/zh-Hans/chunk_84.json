[{"type": "subtitle", "time": 5041.51, "timestamp": "01:24:01", "text": "周末烟花"}, {"type": "subtitle", "time": 5046.47, "timestamp": "01:24:06", "text": "日常任务，我得凌晨四点起床去看烟花。这东西是为了……嗯"}, {"type": "subtitle", "time": 5048.95, "timestamp": "01:24:08", "text": "，世界boss。我得凌晨"}, {"type": "subtitle", "time": 5054.47, "timestamp": "01:24:14", "text": "两点起床。不，不。呃，是的，凌晨两点。"}, {"type": "subtitle", "time": 5057.35, "timestamp": "01:24:17", "text": "没错。"}, {"type": "subtitle", "time": 5059.99, "timestamp": "01:24:19", "text": "好多事。我的意思是，这很有趣。"}, {"type": "subtitle", "time": 5063.99, "timestamp": "01:24:23", "text": "我一直很享受这款游戏。"}, {"type": "subtitle", "time": 5066.47, "timestamp": "01:24:26", "text": "但"}, {"type": "subtitle", "time": 5083.669, "timestamp": "01:24:43", "text": "[音乐]"}, {"type": "subtitle", "time": 5085.59, "timestamp": "01:24:45", "text": "但是，如果你对YouTube有什么想法"}, {"type": "subtitle", "time": 5087.91, "timestamp": "01:24:47", "text": "，如果你是新手什么的，随时可以"}, {"type": "subtitle", "time": 5090.95, "timestamp": "01:24:50", "text": "提问什么的。我的意思是，这是一段"}, {"type": "subtitle", "time": 5094.55, "timestamp": "01:24:54", "text": "旅程。不，我们都在不断学习，不断"}, {"type": "subtitle", "time": 5098.87, "timestamp": "01:24:58", "text": "进步。 知道一些零零碎碎的事情"}]
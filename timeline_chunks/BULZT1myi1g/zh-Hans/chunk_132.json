[{"type": "subtitle", "time": 7923.03, "timestamp": "02:12:03", "text": "再次信任你们。"}, {"type": "subtitle", "time": 7927.27, "timestamp": "02:12:07", "text": "我知道我这么说有点奇怪，但其实"}, {"type": "subtitle", "time": 7936.709, "timestamp": "02:12:16", "text": "反对我的人并不多，只有一"}, {"type": "subtitle", "time": 7941.43, "timestamp": "02:12:21", "text": "小部分，但我"}, {"type": "subtitle", "time": 7943.43, "timestamp": "02:12:23", "text": "仍然想"}, {"type": "subtitle", "time": 7945.75, "timestamp": "02:12:25", "text": "重建我的"}, {"type": "subtitle", "time": 7948.47, "timestamp": "02:12:28", "text": "社区。   是的"}, {"type": "subtitle", "time": 7952.79, "timestamp": "02:12:32", "text": "。 但就目前而言，如果你看到有人说"}, {"type": "subtitle", "time": 7957.03, "timestamp": "02:12:37", "text": "琼是她的跟班之类的，或者其他什么"}, {"type": "subtitle", "time": 7959.43, "timestamp": "02:12:39", "text": "乱七八糟的事，或者其他人"}, {"type": "subtitle", "time": 7962.39, "timestamp": "02:12:42", "text": "对此议论纷纷，我"}, {"type": "subtitle", "time": 7964.79, "timestamp": "02:12:44", "text": "不会把那视为我自己的"}, {"type": "subtitle", "time": 7967.35, "timestamp": "02:12:47", "text": "圈子之类的。 人就是人，仅此而已"}, {"type": "subtitle", "time": 7970.55, "timestamp": "02:12:50", "text": "。 哦，是的，我想打造一个"}, {"type": "subtitle", "time": 7972.629, "timestamp": "02:12:52", "text": "既轻松"}, {"type": "subtitle", "time": 7975.83, "timestamp": "02:12:55", "text": "愉快又无毒害的空间。 我希望我的"}, {"type": "subtitle", "time": 7979.669, "timestamp": "02:12:59", "text": "社区能够尊重这一点，以及"}]
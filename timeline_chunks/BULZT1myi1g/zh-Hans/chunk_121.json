[{"type": "subtitle", "time": 7262.31, "timestamp": "02:01:02", "text": "明年开始，呃，从四月份"}, {"type": "subtitle", "time": 7267.189, "timestamp": "02:01:07", "text": "开始，呃，我只能在"}, {"type": "subtitle", "time": 7271.43, "timestamp": "02:01:11", "text": "早上上完课后才有时间直播。"}, {"type": "subtitle", "time": 7275.43, "timestamp": "02:01:15", "text": "所以我会回来的，我确实参考了"}, {"type": "subtitle", "time": 7278.229, "timestamp": "02:01:18", "text": "学校"}, {"type": "subtitle", "time": 7280.709, "timestamp": "02:01:20", "text": "网站上的课程表。"}, {"type": "subtitle", "time": 7283.51, "timestamp": "02:01:23", "text": "所以，如果我被安排在上午的时段，"}, {"type": "subtitle", "time": 7286.55, "timestamp": "02:01:26", "text": "我希望我能在"}, {"type": "subtitle", "time": 7291.83, "timestamp": "02:01:31", "text": "下午或晚上（日本标准时间）进行直播，或者，"}, {"type": "subtitle", "time": 7295.43, "timestamp": "02:01:35", "text": "如果我做完"}, {"type": "subtitle", "time": 7300.07, "timestamp": "02:01:40", "text": "作业后有空的话。"}, {"type": "subtitle", "time": 7303.589, "timestamp": "02:01:43", "text": "我可能晚上会做。 所以"}, {"type": "subtitle", "time": 7306.07, "timestamp": "02:01:46", "text": "那时就是印度时间了。 那大概是下午"}, {"type": "chat", "time": 7308.035, "timestamp": "02:01:48", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "time to shower and lunchy.... i'll see you Joq-san, potato-san and others later! THANK YOU SO MUCH for the talk and the tips and suggestions!! Tc <3 <3"}, {"type": "subtitle", "time": 7311.189, "timestamp": "02:01:51", "text": "三四点钟。"}, {"type": "subtitle", "time": 7316.229, "timestamp": "02:01:56", "text": "下午3点或4点 是的。 下午6点 晚上7点"}, {"type": "chat", "time": 7319.291, "timestamp": "02:01:59", "author": "@nuclearmaidch", "avatar": "https://yt4.ggpht.com/MS3mIduhKynDUQHTdAP09smm9-S_B6gqCjrteh5PLq8oahJNV_6F7Nz1MLSlqRPjz4ot-KSp-8Y=s64-c-k-c0x00ffffff-no-rj", "message": "UCkszU2WH9gy1mb0dV-11UJg/m8MfY4jbFsWJhL0PyouA2AkUCkszU2WH
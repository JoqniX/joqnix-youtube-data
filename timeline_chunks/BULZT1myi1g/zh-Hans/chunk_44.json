[{"type": "subtitle", "time": 2645.109, "timestamp": "00:44:05", "text": "最近发生的事情。 嗯，所以，"}, {"type": "subtitle", "time": 2649.109, "timestamp": "00:44:09", "text": "如果人们希望我的封面步骤"}, {"type": "subtitle", "time": 2659.349, "timestamp": "00:44:19", "text": "头像有问题吗？ 哦，原来是"}, {"type": "subtitle", "time": 2663.349, "timestamp": "00:44:23", "text": "送礼的那个人收到了这份"}, {"type": "subtitle", "time": 2666.95, "timestamp": "00:44:26", "text": "订阅。 他们的头像会"}, {"type": "subtitle", "time": 2669.43, "timestamp": "00:44:29", "text": "显示在那里。 哦好的。"}, {"type": "subtitle", "time": 2677.67, "timestamp": "00:44:37", "text": "我忘了这里有流元素提醒"}, {"type": "subtitle", "time": 2686.309, "timestamp": "00:44:46", "text": "你好。"}]
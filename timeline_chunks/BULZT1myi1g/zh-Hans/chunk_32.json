[{"type": "subtitle", "time": 1923.75, "timestamp": "00:32:03", "text": "我失去了所有直播的动力"}, {"type": "subtitle", "time": 1929.029, "timestamp": "00:32:09", "text": "。"}, {"type": "subtitle", "time": 1930.789, "timestamp": "00:32:10", "text": "看到大家的各种反应"}, {"type": "subtitle", "time": 1934.71, "timestamp": "00:32:14", "text": "等等。 这件事让我非常难过。 但是，呃，"}, {"type": "subtitle", "time": 1938.149, "timestamp": "00:32:18", "text": "在我暂停直播的这段时间，或者从那以后，我时不时地在"}, {"type": "subtitle", "time": 1941.029, "timestamp": "00:32:21", "text": "我的 Alteracon 上直播，"}, {"type": "subtitle", "time": 1946.549, "timestamp": "00:32:26", "text": "以找回"}, {"type": "subtitle", "time": 1949.99, "timestamp": "00:32:29", "text": "再次直播的感觉，或者只是玩"}, {"type": "subtitle", "time": 1953.19, "timestamp": "00:32:33", "text": "我想直播的任何游戏之类的。"}, {"type": "subtitle", "time": 1956.31, "timestamp": "00:32:36", "text": "那确实帮助我重新振作起来，"}, {"type": "subtitle", "time": 1960.389, "timestamp": "00:32:40", "text": "这也是我选择"}, {"type": "subtitle", "time": 1962.95, "timestamp": "00:32:42", "text": "这么快就回来的原因。"}, {"type": "subtitle", "time": 1967.43, "timestamp": "00:32:47", "text": "嗯，现在是十月、八月、"}, {"type": "subtitle", "time": 1969.509, "timestamp": "00:32:49", "text": "九月、十月。 两个月"}, {"type": "subtitle", "time": 1972.789, "timestamp": "00:32:52", "text": "过去了，对吧？ 你好。"}, {"type": "subtitle", "time": 1975.19, "timestamp": "00:32:55", "text": "所以，再次感谢你们赠送的"}, {"type": "subtitle", "time": 1976.71, "timestamp": "00:32:56", "text": "会员资格"}]
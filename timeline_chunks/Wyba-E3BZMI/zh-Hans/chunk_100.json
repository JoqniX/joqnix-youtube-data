[{"type": "subtitle", "time": 6001.43, "timestamp": "01:40:01", "text": "好的，我到了。"}, {"type": "subtitle", "time": 6014.79, "timestamp": "01:40:14", "text": "它确实很滞后。"}, {"type": "subtitle", "time": 6017.109, "timestamp": "01:40:17", "text": "我先把游戏关掉，然后"}, {"type": "subtitle", "time": 6037.189, "timestamp": "01:40:37", "text": "我的意思是把这首歌的音乐和其他所有东西都准备好"}, {"type": "subtitle", "time": 6053.99, "timestamp": "01:40:53", "text": "我可以给他们打电话吗？ 好的。 我们会完成"}, {"type": "subtitle", "time": 6055.91, "timestamp": "01:40:55", "text": "这件事的。 我们将练习音乐方面的"}, {"type": "subtitle", "time": 6059.51, "timestamp": "01:40:59", "text": "内容。 好的。 呃，唱英国歌。"}]
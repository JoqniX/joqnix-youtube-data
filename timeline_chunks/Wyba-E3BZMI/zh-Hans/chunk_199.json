[{"type": "subtitle", "time": 11950.309, "timestamp": "03:19:10", "text": "他们的盔甲没了。 击中他们的"}, {"type": "subtitle", "time": 11952.07, "timestamp": "03:19:12", "text": "痛处。 他们很虚弱，只剩下"}, {"type": "subtitle", "time": 11954.07, "timestamp": "03:19:14", "text": "30 秒时间到达安全"}, {"type": "subtitle", "time": 11992.63, "timestamp": "03:19:52", "text": "我真的需要一个狙击手。"}]
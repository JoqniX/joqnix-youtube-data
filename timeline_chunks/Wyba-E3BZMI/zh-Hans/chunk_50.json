[{"type": "subtitle", "time": 3001.589, "timestamp": "00:50:01", "text": "密码正确吗？ 它不是。"}, {"type": "subtitle", "time": 3005.19, "timestamp": "00:50:05", "text": "好吧，行。 下一个。 密码。"}, {"type": "subtitle", "time": 3007.43, "timestamp": "00:50:07", "text": "密码正确吗？"}, {"type": "subtitle", "time": 3009.27, "timestamp": "00:50:09", "text": "又一次"}, {"type": "subtitle", "time": 3017.19, "timestamp": "00:50:17", "text": "呃，这到底是"}, {"type": "subtitle", "time": 3021.51, "timestamp": "00:50:21", "text": "怎么回事？ 好的。 嗯，"}, {"type": "subtitle", "time": 3025.75, "timestamp": "00:50:25", "text": "这或许是我的密码。"}, {"type": "subtitle", "time": 3027.589, "timestamp": "00:50:27", "text": "请"}, {"type": "subtitle", "time": 3030.39, "timestamp": "00:50:30", "text": "务必是那个密码。 天哪，我"}, {"type": "subtitle", "time": 3033.67, "timestamp": "00:50:33", "text": "忘了密码。 搞什么鬼？"}, {"type": "subtitle", "time": 3035.67, "timestamp": "00:50:35", "text": "不，不，不，不，不，不。 别这样对"}, {"type": "subtitle", "time": 3039.67, "timestamp": "00:50:39", "text": "我。 别那样做。 等等，什么？ 嗯？"}, {"type": "subtitle", "time": 3042.549, "timestamp": "00:50:42", "text": "等等，我的密码快用完了。"}, {"type": "subtitle", "time": 3046.069, "timestamp": "00:50:46", "text": "等等，是这个吗？ 求求你，求求你，"}, {"type": "subtitle", "time": 3048.87, "timestamp": "00:50:48", "text": "求求你。"}, {"type": "subtitle", "time": 3050.71, "timestamp": "00:50:50", "text": "等待。"}]
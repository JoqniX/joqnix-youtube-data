[{"type": "subtitle", "time": 782.35, "timestamp": "00:13:02", "text": "[掌声]"}, {"type": "subtitle", "time": 827.11, "timestamp": "00:13:47", "text": "现在就要战斗了。 最好的防御"}, {"type": "subtitle", "time": 830.55, "timestamp": "00:13:50", "text": "永远就在你的眼中。 现在我知道你"}, {"type": "subtitle", "time": 834.629, "timestamp": "00:13:54", "text": "能尝到味道了。 现在黄金正"}, {"type": "subtitle", "time": 837.03, "timestamp": "00:13:57", "text": "等着你。 黄金在等着"}, {"type": "subtitle", "time": 838.83, "timestamp": "00:13:58", "text": "你。"}]
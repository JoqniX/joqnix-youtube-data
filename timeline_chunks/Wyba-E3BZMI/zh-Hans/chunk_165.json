[{"type": "subtitle", "time": 9905.03, "timestamp": "02:45:05", "text": "装弹。"}, {"type": "subtitle", "time": 9906.389, "timestamp": "02:45:06", "text": "去拿。"}, {"type": "subtitle", "time": 9931.59, "timestamp": "02:45:31", "text": "我看到她了。"}, {"type": "subtitle", "time": 9934.23, "timestamp": "02:45:34", "text": "她在哪儿？我打倒了一个。在"}, {"type": "subtitle", "time": 9937.19, "timestamp": "02:45:37", "text": "哪儿？"}, {"type": "subtitle", "time": 9939.83, "timestamp": "02:45:39", "text": "她去哪儿了？"}, {"type": "subtitle", "time": 9942.309, "timestamp": "02:45:42", "text": "我是不是瞎了？那是什么鬼东西"}]
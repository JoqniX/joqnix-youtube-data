[{"type": "subtitle", "time": 5779.11, "timestamp": "01:36:19", "text": "你注意到我那边速度很慢吗？"}, {"type": "subtitle", "time": 5788.47, "timestamp": "01:36:28", "text": "我想起床。 我该怎么上来"}, {"type": "subtitle", "time": 5806.629, "timestamp": "01:36:46", "text": "我需要移除 F。"}, {"type": "subtitle", "time": 5807.59, "timestamp": "01:36:47", "text": "走吧，艾瑞尔。"}, {"type": "subtitle", "time": 5817.83, "timestamp": "01:36:57", "text": "哦，它最多只能移动180度。你不能移动"}]
[{"type": "subtitle", "time": 1080.549, "timestamp": "00:18:00", "text": "[音乐]"}, {"type": "subtitle", "time": 1084.31, "timestamp": "00:18:04", "text": "如何修复网络错误？"}, {"type": "subtitle", "time": 1095.029, "timestamp": "00:18:15", "text": "一旦你授予管理员权限，"}, {"type": "subtitle", "time": 1097.27, "timestamp": "00:18:17", "text": "从游戏主界面选择安装文件，"}, {"type": "subtitle", "time": 1098.789, "timestamp": "00:18:18", "text": "问题就会得到解决。"}, {"type": "subtitle", "time": 1101.19, "timestamp": "00:18:21", "text": "兄弟，"}, {"type": "subtitle", "time": 1113.75, "timestamp": "00:18:33", "text": "确保你的 Windows 已更新到 11，"}, {"type": "subtitle", "time": 1115.669, "timestamp": "00:18:35", "text": "并将你的显卡更新到最新"}, {"type": "subtitle", "time": 1128.71, "timestamp": "00:18:48", "text": "命运触发网络”？"}]
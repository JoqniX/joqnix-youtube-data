[{"type": "subtitle", "time": 8340.15, "timestamp": "02:19:00", "text": "。"}, {"type": "subtitle", "time": 8350.15, "timestamp": "02:19:10", "text": "嗨，祝你有个美好的夜晚。有什么事吗？祝"}, {"type": "subtitle", "time": 8358.709, "timestamp": "02:19:18", "text": "你接下来的直播一切顺利？你会继续直播吗？嗯，你会"}, {"type": "subtitle", "time": 8360.549, "timestamp": "02:19:20", "text": "继续直播的，对吧？"}, {"type": "subtitle", "time": 8363.349, "timestamp": "02:19:23", "text": "是的，我会的。"}, {"type": "subtitle", "time": 8365.429, "timestamp": "02:19:25", "text": "我一直很好奇，你的嗓子不会"}, {"type": "subtitle", "time": 8367.75, "timestamp": "02:19:27", "text": "很累吗？"}, {"type": "subtitle", "time": 8370.15, "timestamp": "02:19:30", "text": "不会，我大概一个小时前才开始直播，所以"}, {"type": "subtitle", "time": 8371.669, "timestamp": "02:19:31", "text": "没事。"}, {"type": "subtitle", "time": 8372.549, "timestamp": "02:19:32", "text": "嗯。"}, {"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "可能只是我的错觉，但你的声音"}, {"type": "subtitle", "time": 8377.589, "timestamp": "02:19:37", "text": "比我喜欢的要高很多，"}, {"type": "subtitle", "time": 8380.87, "timestamp": "02:19:40", "text": "你知道，就像我第一次"}, {"type": "subtitle", "time": 8383.11, "timestamp": "02:19:43", "text": "和你练习的时候那样。我想可能"}, {"type": "subtitle", "time": 8385.589, "timestamp": "02:19:45", "text": "只是我的感觉。你的声音"}, {"type": "subtitle", "time": 8387.99, "timestamp": "02:19:47", "text": "确实变高了。等等，真的吗？是的"}, {"type": "subtitle", "time": 8390.87, "timestamp": "02:19:50", "text": "。是的。我感觉，是的。而且声音也更"}, {"type": "subtitle", "time": 8393.11, "timestamp": "02:19:53", "text": "清晰了。"}, {"type": "subtitle", "time": 8394.79, "timestamp": "02:19:54", "text": "啊，"}, {"type": "subtitle", "time": 8397.51, "timestamp": "02:19:57", "text": "我想知道。声音更清晰不好吗？我"}, {"type": "subtitle", "time": 8398.07, "timestamp": "02:19:58", "text": "不知道。"}]
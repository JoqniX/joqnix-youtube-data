[{"type": "subtitle", "time": 302.55, "timestamp": "00:05:02", "text": "好的，稍等一下。 让我先调整一下"}, {"type": "subtitle", "time": 305.43, "timestamp": "00:05:05", "text": "思路。"}, {"type": "subtitle", "time": 307.749, "timestamp": "00:05:07", "text": "今天我们要玩的是《命运"}, {"type": "subtitle", "time": 311.27, "timestamp": "00:05:11", "text": "触发》。 呃，请稍等片刻。"}, {"type": "subtitle", "time": 315.67, "timestamp": "00:05:15", "text": "不知何故，我"}, {"type": "subtitle", "time": 319.749, "timestamp": "00:05:19", "text": "无法创建"}, {"type": "subtitle", "time": 323.51, "timestamp": "00:05:23", "text": "Instagram 快拍。"}, {"type": "subtitle", "time": 326.629, "timestamp": "00:05:26", "text": "为什么制作一个像Instagram"}, {"type": "subtitle", "time": 330.23, "timestamp": "00:05:30", "text": "故事那样会导致点赞崩溃而不导致崩溃的事情就这么难"}, {"type": "subtitle", "time": 333.99, "timestamp": "00:05:33", "text": "？ 所以这就像是出错了。 我不知道。   是的"}, {"type": "subtitle", "time": 336.07, "timestamp": "00:05:36", "text": "。 大家好。 欢迎光临。"}, {"type": "subtitle", "time": 337.909, "timestamp": "00:05:37", "text": "欢迎光临。哦，原来是因为我没有"}, {"type": "subtitle", "time": 341.029, "timestamp": "00:05:41", "text": "更新。 证明。"}, {"type": "subtitle", "time": 344.87, "timestamp": "00:05:44", "text": "好的，有意思。 嗯，我这就去做"}, {"type": "subtitle", "time": 348.55, "timestamp": "00:05:48", "text": "。 你好。 今天我们要"}, {"type": "subtitle", "time": 350.31, "timestamp": "00:05:50", "text": "玩的是《命运触发》。 它"}, {"type": "subtitle", "time": 354.07, "timestamp": "00:05:54", "text": "更像是动漫版的绝地求生，我对此一直很"}, {"type": "subtitle", "time": 357.99, "timestamp": "00:05:57", "text": "好奇，我们"}]
[{"type": "subtitle", "time": 10740.07, "timestamp": "02:59:00", "text": "她为什么……"}, {"type": "subtitle", "time": 10742.15, "timestamp": "02:59:02", "text": "只剩一队了。"}, {"type": "subtitle", "time": 10744.07, "timestamp": "02:59:04", "text": "等等，只剩一队了……别死。别死"}, {"type": "subtitle", "time": 10761.67, "timestamp": "02:59:21", "text": "我能感受到节奏。"}, {"type": "subtitle", "time": 10764.87, "timestamp": "02:59:24", "text": "我们能行。"}, {"type": "subtitle", "time": 10767.269, "timestamp": "02:59:27", "text": "哦，对，她……她可能会死在圈里"}, {"type": "subtitle", "time": 10769.269, "timestamp": "02:59:29", "text": "。"}, {"type": "subtitle", "time": 10778.23, "timestamp": "02:59:38", "text": "不错。"}, {"type": "subtitle", "time": 10785.22, "timestamp": "02:59:45", "text": "我不得不挂机了，兄弟。"}, {"type": "subtitle", "time": 10786.79, "timestamp": "02:59:46", "text": "[音乐]"}, {"type": "subtitle", "time": 10789.11, "timestamp": "02:59:49", "text": "这就是原因，因为我不得不"}, {"type": "subtitle", "time": 10791.59, "timestamp": "02:59:51", "text": "挂机了。"}, {"type": "subtitle", "time": 10794.23, "timestamp": "02:59:54", "text": "如果我当时在，我就可以"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "保存我的东西了。所以是"}]
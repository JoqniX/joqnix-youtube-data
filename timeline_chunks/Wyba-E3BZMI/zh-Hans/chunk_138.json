[{"type": "subtitle", "time": 8282.87, "timestamp": "02:18:02", "text": "今天就到这里。练习到此结束。耶！结束了。是的。"}, {"type": "subtitle", "time": 8291.589, "timestamp": "02:18:11", "text": "你准备好从明天"}, {"type": "subtitle", "time": 8293.27, "timestamp": "02:18:13", "text": "开始继续练习了吗？"}, {"type": "subtitle", "time": 8294.95, "timestamp": "02:18:14", "text": "好的，当然。好的。"}, {"type": "subtitle", "time": 8298.629, "timestamp": "02:18:18", "text": "嗯。我大概只有"}, {"type": "subtitle", "time": 8301.509, "timestamp": "02:18:21", "text": "到8月28号有空。所以，是的。"}, {"type": "subtitle", "time": 8303.91, "timestamp": "02:18:23", "text": "等等，之后你还有考试什么的吗"}, {"type": "subtitle", "time": 8304.629, "timestamp": "02:18:24", "text": "？"}, {"type": "subtitle", "time": 8307.429, "timestamp": "02:18:27", "text": "没有考试。我要去上大学了。"}, {"type": "subtitle", "time": 8309.75, "timestamp": "02:18:29", "text": "啊，开学了。好的。哦，不。是的，"}, {"type": "subtitle", "time": 8312.709, "timestamp": "02:18:32", "text": "我得走了。嗯，"}, {"type": "subtitle", "time": 8315.11, "timestamp": "02:18:35", "text": "大概在印度北部。我"}, {"type": "subtitle", "time": 8317.429, "timestamp": "02:18:37", "text": "现在在那里找到了座位安排。"}, {"type": "subtitle", "time": 8317.99, "timestamp": "02:18:37", "text": "啊，"}, {"type": "subtitle", "time": 8320.15, "timestamp": "02:18:40", "text": "是的。"}, {"type": "subtitle", "time": 8321.429, "timestamp": "02:18:41", "text": "嗯。"}, {"type": "subtitle", "time": 8324.709, "timestamp": "02:18:44", "text": "我为你高兴。我们…… 走吧。"}, {"type": "subtitle", "time": 8327.669, "timestamp": "02:18:47", "text": "嗯，我会试着做一些vlog。"}, {"type": "subtitle", "time": 8331.669, "timestamp": "02:18:51", "text": "我最近在我的另一个频道上做了一个vlog"}, {"type": "subtitle", "time": 8333.429, "timestamp": "02:18:53", "text": "。"}, {"type": "subtitle", "time": 8335.19, "timestamp": "02:18:55", "text": "挺有意思的，"}, {"type": "subtitle", "time": 8337.83, "timestamp": "02:18:57", "text": "不过剪辑视频有点烦人"}]
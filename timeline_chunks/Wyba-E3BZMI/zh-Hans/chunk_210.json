[{"type": "subtitle", "time": 12636.71, "timestamp": "03:30:36", "text": "我已倒地，请求支援。 别担心"}, {"type": "subtitle", "time": 12645.19, "timestamp": "03:30:45", "text": "不，不，不，不。 杀了他。"}, {"type": "subtitle", "time": 12647.67, "timestamp": "03:30:47", "text": "我们体内充满了力量"}, {"type": "subtitle", "time": 12650.229, "timestamp": "03:30:50", "text": "手榴弹。"}]
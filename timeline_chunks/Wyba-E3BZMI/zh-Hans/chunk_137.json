[{"type": "subtitle", "time": 8222.309, "timestamp": "02:17:02", "text": "不过，我现在又来了。"}, {"type": "subtitle", "time": 8224.15, "timestamp": "02:17:04", "text": "就像这样。这样教你挺好的，"}, {"type": "subtitle", "time": 8229.509, "timestamp": "02:17:09", "text": "因为即使我不听，我还是记得"}, {"type": "subtitle", "time": 8232.23, "timestamp": "02:17:12", "text": "。不，我只要记住一个词就能"}, {"type": "subtitle", "time": 8233.91, "timestamp": "02:17:13", "text": "记住整首歌的"}, {"type": "subtitle", "time": 8237.91, "timestamp": "02:17:17", "text": "歌词，不用看歌词。"}, {"type": "subtitle", "time": 8239.589, "timestamp": "02:17:19", "text": "对，"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "我得把这种能力用在其他"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "歌上。我在学习。"}, {"type": "subtitle", "time": 8246.309, "timestamp": "02:17:26", "text": "对，我觉得把歌曲分成几段来教比较好。"}, {"type": "subtitle", "time": 8251.99, "timestamp": "02:17:31", "text": "从长远来看，这肯定对你更有帮助。是的"}, {"type": "subtitle", "time": 8253.19, "timestamp": "02:17:33", "text": "。"}, {"type": "subtitle", "time": 8255.669, "timestamp": "02:17:35", "text": "我还希望你学习的时候一次只练一首歌"}, {"type": "subtitle", "time": 8258.07, "timestamp": "02:17:38", "text": "。"}, {"type": "subtitle", "time": 8261.349, "timestamp": "02:17:41", "text": "是的。别"}, {"type": "subtitle", "time": 8264.07, "timestamp": "02:17:44", "text": "一次练两三首歌。先学一首，"}, {"type": "subtitle", "time": 8266.95, "timestamp": "02:17:46", "text": "再学另一首，然后把"}, {"type": "subtitle", "time": 8269.19, "timestamp": "02:17:49", "text": "这两首歌一起唱，然后再学下一首"}, {"type": "subtitle", "time": 8272.309, "timestamp": "02:17:52", "text": "。"}, {"type": "subtitle", "time": 8276.07, "timestamp": "02:17:56", "text": "好的，这就是我想让你"}, {"type": "subtitle", "time": 8279.669, "timestamp": "02:17:59", "text": "做的。明白了，我会的。"}]
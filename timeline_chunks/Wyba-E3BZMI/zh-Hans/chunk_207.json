[{"type": "subtitle", "time": 12420.87, "timestamp": "03:27:00", "text": "自己。 等我见到我的朋友们时，"}, {"type": "subtitle", "time": 12424.79, "timestamp": "03:27:04", "text": "你们都得先过我这关。"}, {"type": "subtitle", "time": 12426.87, "timestamp": "03:27:06", "text": "不用谢我。 这就是我的"}, {"type": "subtitle", "time": 12438.63, "timestamp": "03:27:18", "text": "谢谢你，只是想确保我处于"}, {"type": "subtitle", "time": 12445.75, "timestamp": "03:27:25", "text": "糟糕。"}, {"type": "subtitle", "time": 12447.99, "timestamp": "03:27:27", "text": "重新装弹。 注意你的掩护。"}, {"type": "subtitle", "time": 12449.91, "timestamp": "03:27:29", "text": "美国宇航局，你们都还好吗？"}, {"type": "subtitle", "time": 12459.03, "timestamp": "03:27:39", "text": "险。 幸好我正在"}, {"type": "subtitle", "time": 12464.87, "timestamp": "03:27:44", "text": "在海上航行，我仍然可以跑得很快"}]
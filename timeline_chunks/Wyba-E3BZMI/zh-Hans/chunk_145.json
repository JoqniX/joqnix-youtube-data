[{"type": "subtitle", "time": 8718.95, "timestamp": "02:25:18", "text": "为什么我杀不掉它？我的天哪。"}, {"type": "subtitle", "time": 8721.83, "timestamp": "02:25:21", "text": "我的电脑怎么了？"}, {"type": "subtitle", "time": 8739.03, "timestamp": "02:25:39", "text": "为什么Zoom共享设备在运行？为什么我"}, {"type": "subtitle", "time": 8743.03, "timestamp": "02:25:43", "text": "的电脑里有这么多垃圾程序在"}, {"type": "subtitle", "time": 8745.429, "timestamp": "02:25:45", "text": "我不想让它运行的情况下运行"}, {"type": "subtitle", "time": 8747.19, "timestamp": "02:25:47", "text": "？什么？发生了什么"}, {"type": "subtitle", "time": 8757.75, "timestamp": "02:25:57", "text": "我有一些"}]
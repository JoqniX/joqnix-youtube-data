[{"type": "subtitle", "time": 7747.27, "timestamp": "02:09:07", "text": "发音。她做了"}, {"type": "subtitle", "time": 7779.27, "timestamp": "02:09:39", "text": "我的天哪。"}, {"type": "subtitle", "time": 7780.149, "timestamp": "02:09:40", "text": "嗯。"}, {"type": "subtitle", "time": 7782.55, "timestamp": "02:09:42", "text": "你有没有把撕裂的发音搞砸？"}, {"type": "subtitle", "time": 7784.87, "timestamp": "02:09:44", "text": "我想我搞砸了。等等。"}, {"type": "subtitle", "time": 7787.91, "timestamp": "02:09:47", "text": "我不确定，因为我 听不太清楚"}, {"type": "subtitle", "time": 7791.109, "timestamp": "02:09:51", "text": "音频。就像我分不清伴奏和人声"}, {"type": "subtitle", "time": 7792.79, "timestamp": "02:09:52", "text": "。"}, {"type": "subtitle", "time": 7795.43, "timestamp": "02:09:55", "text": "我就是这个意思。我真的听不出来。我"}, {"type": "subtitle", "time": 7799.35, "timestamp": "02:09:59", "text": "怎么可能听出来呢？真希望可以把"}]
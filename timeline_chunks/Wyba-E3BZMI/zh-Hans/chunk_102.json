[{"type": "subtitle", "time": 6122.35, "timestamp": "01:42:02", "text": "把蛋糕切开什么的都做完。"}, {"type": "subtitle", "time": 6123.99, "timestamp": "01:42:03", "text": "[音乐] 是"}, {"type": "subtitle", "time": 6126.55, "timestamp": "01:42:06", "text": "啊，我"}, {"type": "subtitle", "time": 6130.79, "timestamp": "01:42:10", "text": "今年因为忙于"}, {"type": "subtitle", "time": 6133.59, "timestamp": "01:42:13", "text": "考试，都没能庆祝我的生日。 我觉得是啊，那确实有点"}, {"type": "subtitle", "time": 6141.83, "timestamp": "01:42:21", "text": "就像在家里举行了一场小型但温馨的庆祝活动"}, {"type": "subtitle", "time": 6145.35, "timestamp": "01:42:25", "text": "。 然后，嗯，我的一个朋友"}, {"type": "subtitle", "time": 6148.149, "timestamp": "01:42:28", "text": "送了我一个蛋糕，所以我"}, {"type": "subtitle", "time": 6150.149, "timestamp": "01:42:30", "text": "直播庆祝了一下。"}, {"type": "subtitle", "time": 6153.83, "timestamp": "01:42:33", "text": "哦，你知道吗？给朋友们打个电话什么"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "的？"}, {"type": "subtitle", "time": 6157.189, "timestamp": "01:42:37", "text": "不不不，只有家人在场。"}, {"type": "subtitle", "time": 6158.629, "timestamp": "01:42:38", "text": "好的。"}, {"type": "subtitle", "time": 6160.709, "timestamp": "01:42:40", "text": "嗯，是的。"}, {"type": "subtitle", "time": 6162.55, "timestamp": "01:42:42", "text": "所以"}, {"type": "subtitle", "time": 6164.79, "timestamp": "01:42:44", "text": "我通常会……嗯。 我通常不太会"}, {"type": "subtitle", "time": 6166.709, "timestamp": "01:42:46", "text": "庆祝节日，除了"}, {"type": "subtitle", "time": 6168.709, "timestamp": "01:42:48", "text": "出去"}, {"type": "subtitle", "time": 6172.31, "timestamp": "01:42:52", "text": "吃顿饭什么的。   是的"}, {"type": "subtitle", "time": 6173.52, "timestamp": "01:42:53", "text": "。   是的 ，我今年肯定没有庆祝"}, {"type": "subtitle", "time": 6175.44, "timestamp": "01:42:55", "text": "，我今年肯定没有庆祝 。   是的"}, {"type": "subtitle", "time": 6176.8, "timestamp": "01:42:56", "text": "。   是的 。"}, {"type": "subtitle", "time": 6178.4, "timestamp": "01:42:58", "text": "。 不。是的"}, {"type": "subtitle", "time": 6179.679, "timestamp": "01:42:59", "text": "不。是的 。 现在才一月份。"}]
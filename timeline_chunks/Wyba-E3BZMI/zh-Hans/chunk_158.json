[{"type": "subtitle", "time": 9516.63, "timestamp": "02:38:36", "text": "我血量低。我血量低。哦，天哪，我血量低。正在"}, {"type": "subtitle", "time": 9517.429, "timestamp": "02:38:37", "text": "装弹。"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "我的队友们…… 好远啊。搞什么鬼？"}, {"type": "subtitle", "time": 9524.389, "timestamp": "02:38:44", "text": "我可能要死了。"}, {"type": "subtitle", "time": 9533.11, "timestamp": "02:38:53", "text": "真的中"}, {"type": "subtitle", "time": 9535.349, "timestamp": "02:38:55", "text": "枪了。"}]
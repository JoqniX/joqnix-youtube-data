[{"type": "subtitle", "time": 8050.31, "timestamp": "02:14:10", "text": "？好"}, {"type": "subtitle", "time": 8052.629, "timestamp": "02:14:12", "text": "。好。"}, {"type": "subtitle", "time": 8054.709, "timestamp": "02:14:14", "text": "我注意到，当我不用"}, {"type": "subtitle", "time": 8057.03, "timestamp": "02:14:17", "text": "伴奏唱歌时，不知为何我会放慢速度"}, {"type": "subtitle", "time": 8057.589, "timestamp": "02:14:17", "text": "。是"}, {"type": "subtitle", "time": 8060.55, "timestamp": "02:14:20", "text": "的。这是其中一点。是的"}, {"type": "subtitle", "time": 8063.669, "timestamp": "02:14:23", "text": "。我知道。即使是我自己，当我教"}, {"type": "subtitle", "time": 8067.43, "timestamp": "02:14:27", "text": "别人唱歌时，如果我"}, {"type": "subtitle", "time": 8069.35, "timestamp": "02:14:29", "text": "不放伴奏教，就像是"}, {"type": "subtitle", "time": 8071.75, "timestamp": "02:14:31", "text": "一句一句地唱。所以我唱得比"}, {"type": "subtitle", "time": 8074.79, "timestamp": "02:14:34", "text": "实际唱得慢得多"}, {"type": "subtitle", "time": 8078.149, "timestamp": "02:14:38", "text": "。是的。是的"}, {"type": "subtitle", "time": 8080.95, "timestamp": "02:14:40", "text": "。是的。即使是我自己，"}, {"type": "subtitle", "time": 8083.15, "timestamp": "02:14:43", "text": "可能也有同样的问题。"}, {"type": "subtitle", "time": 8084.709, "timestamp": "02:14:44", "text": "[音乐]"}, {"type": "subtitle", "time": 8087.589, "timestamp": "02:14:47", "text": "是的。对了，你什么时候有空？"}, {"type": "subtitle", "time": 8087.99, "timestamp": "02:14:47", "text": "是的。"}, {"type": "subtitle", "time": 8091.91, "timestamp": "02:14:51", "text": "我不知道。呃，我大概"}, {"type": "subtitle", "time": 8094.79, "timestamp": "02:14:54", "text": "这个时候有空，或者四点左右。是的。"}]
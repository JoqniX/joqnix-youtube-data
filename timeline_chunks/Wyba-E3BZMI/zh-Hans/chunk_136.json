[{"type": "subtitle", "time": 8160.629, "timestamp": "02:16:00", "text": "是的。经过漫长的一年，或者说一年"}, {"type": "subtitle", "time": 8163.75, "timestamp": "02:16:03", "text": "之后，我想我之前跟你说的是一年前。我"}, {"type": "subtitle", "time": 8165.189, "timestamp": "02:16:05", "text": "不太确定是一"}, {"type": "subtitle", "time": 8167.589, "timestamp": "02:16:07", "text": "年前。不，就在最近，大概"}, {"type": "subtitle", "time": 8170.31, "timestamp": "02:16:10", "text": "几周前。不， 几个月"}, {"type": "subtitle", "time": 8172.39, "timestamp": "02:16:12", "text": "前。嗯，两个月前。"}, {"type": "subtitle", "time": 8175.03, "timestamp": "02:16:15", "text": "我第一次教你这"}, {"type": "subtitle", "time": 8178.709, "timestamp": "02:16:18", "text": "首歌的时候。我说的就是这个。"}, {"type": "subtitle", "time": 8182.069, "timestamp": "02:16:22", "text": "嗯，大概是上个月吧"}, {"type": "subtitle", "time": 8183.51, "timestamp": "02:16:23", "text": "？"}, {"type": "subtitle", "time": 8185.83, "timestamp": "02:16:25", "text": "我说的是我"}, {"type": "subtitle", "time": 8187.43, "timestamp": "02:16:27", "text": "第一次尝试一口气教你"}, {"type": "subtitle", "time": 8189.27, "timestamp": "02:16:29", "text": "这首歌，"}, {"type": "subtitle", "time": 8191.189, "timestamp": "02:16:31", "text": "没有把各个部分分开，"}, {"type": "subtitle", "time": 8192.87, "timestamp": "02:16:32", "text": "基本上就是"}, {"type": "subtitle", "time": 8193.669, "timestamp": "02:16:33", "text": "第一次。"}, {"type": "subtitle", "time": 8195.429, "timestamp": "02:16:35", "text": "哦，对。对。对。对。对。我"}, {"type": "subtitle", "time": 8197.349, "timestamp": "02:16:37", "text": "记得。是的。对。"}, {"type": "subtitle", "time": 8199.99, "timestamp": "02:16:39", "text": "不是这个月，也不是"}, {"type": "subtitle", "time": 8201.83, "timestamp": "02:16:41", "text": "今年，因为我当时在"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "考试。肯定是去年我"}, {"type": "subtitle", "time": 8206.549, "timestamp": "02:16:46", "text": "教过你这首歌，但你从来没"}, {"type": "subtitle", "time": 8209.11, "timestamp": "02:16:49", "text": "练过，然后就全忘了"}, {"type": "subtitle", "time": 8211.589, "timestamp": "02:16:51", "text": "。"}, {"type": "subtitle", "time": 8214.79, "timestamp": "02:16:54", "text": "我还以为你练过"}]
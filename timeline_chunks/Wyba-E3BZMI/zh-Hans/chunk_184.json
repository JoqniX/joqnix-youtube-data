[{"type": "subtitle", "time": 11041.349, "timestamp": "03:04:01", "text": "让我不禁好奇这些人究竟是"}, {"type": "subtitle", "time": 11079.349, "timestamp": "03:04:39", "text": "Principi"}, {"type": "subtitle", "time": 11081.19, "timestamp": "03:04:41", "text": "对光源的运用远比我们"}, {"type": "subtitle", "time": 11083.91, "timestamp": "03:04:43", "text": "在研究所取得的成就先进得多。这让我"}, {"type": "subtitle", "time": 11086.309, "timestamp": "03:04:46", "text": "不禁好奇"}]
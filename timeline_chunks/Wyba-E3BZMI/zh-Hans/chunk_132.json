[{"type": "subtitle", "time": 7920.47, "timestamp": "02:12:00", "text": "听起来很滑稽。嗯，你"}, {"type": "subtitle", "time": 7923.75, "timestamp": "02:12:03", "text": "这句唱的音调太低了"}, {"type": "subtitle", "time": 7925.91, "timestamp": "02:12:05", "text": "。实际上，我可能得用"}, {"type": "subtitle", "time": 7930.47, "timestamp": "02:12:10", "text": "你的音调，你的音域来录制。嗯"}, {"type": "subtitle", "time": 7934.709, "timestamp": "02:12:14", "text": "。这样你才能"}, {"type": "subtitle", "time": 7936.79, "timestamp": "02:12:16", "text": "比较准确地跟着唱。所以，嗯。"}, {"type": "subtitle", "time": 7940.229, "timestamp": "02:12:20", "text": "嗯。我会在下次直播前尽量录好"}, {"type": "subtitle", "time": 7941.99, "timestamp": "02:12:21", "text": "。"}, {"type": "subtitle", "time": 7946.069, "timestamp": "02:12:26", "text": "嗯。嗯。哦，嗯。我 喝点水。"}, {"type": "subtitle", "time": 7949.27, "timestamp": "02:12:29", "text": "是的。需要再喝点水。这"}, {"type": "subtitle", "time": 7952.87, "timestamp": "02:12:32", "text": "感觉就像……这太冷了。不，不，不。"}, {"type": "subtitle", "time": 7955.75, "timestamp": "02:12:35", "text": "它已经正常了。是的。也该等了"}, {"type": "subtitle", "time": 7960.55, "timestamp": "02:12:40", "text": "。"}, {"type": "subtitle", "time": 7963.27, "timestamp": "02:12:43", "text": "好的。"}, {"type": "subtitle", "time": 7966.47, "timestamp": "02:12:46", "text": "那就不用伴奏唱吧"}, {"type": "subtitle", "time": 7966.95, "timestamp": "02:12:46", "text": "。"}, {"type": "subtitle", "time": 7968.95, "timestamp": "02:12:48", "text": "这是最后一遍。"}, {"type": "subtitle", "time": 7970.229, "timestamp": "02:12:50", "text": "嗨。"}]
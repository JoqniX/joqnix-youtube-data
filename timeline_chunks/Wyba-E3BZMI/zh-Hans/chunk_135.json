[{"type": "subtitle", "time": 8101.51, "timestamp": "02:15:01", "text": "嗯，"}, {"type": "subtitle", "time": 8103.75, "timestamp": "02:15:03", "text": "我可以。 你什么时候"}, {"type": "subtitle", "time": 8107.35, "timestamp": "02:15:07", "text": "有空？我可以有空。我会到的。不，"}, {"type": "subtitle", "time": 8110.31, "timestamp": "02:15:10", "text": "我的意思是，我大部分时间都有空，但"}, {"type": "subtitle", "time": 8112.709, "timestamp": "02:15:12", "text": "下午3点到4点是唱歌比较合适的"}, {"type": "subtitle", "time": 8115.43, "timestamp": "02:15:15", "text": "时间。"}, {"type": "subtitle", "time": 8118.069, "timestamp": "02:15:18", "text": "我喜欢那个时间。是的，那是"}, {"type": "subtitle", "time": 8120.629, "timestamp": "02:15:20", "text": "我最喜欢的时间。是的，我通常会"}, {"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "和大家约好时间。"}, {"type": "subtitle", "time": 8127.43, "timestamp": "02:15:27", "text": "好的。那就下午3点或4点。然后是周六、"}, {"type": "subtitle", "time": 8129.189, "timestamp": "02:15:29", "text": "周日，我会到的。"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "哪一天？就一天。"}, {"type": "subtitle", "time": 8135.99, "timestamp": "02:15:35", "text": "一天就够了。嗯，"}, {"type": "subtitle", "time": 8137.669, "timestamp": "02:15:37", "text": "好的。"}, {"type": "subtitle", "time": 8139.91, "timestamp": "02:15:39", "text": "等等。所以你想唱最后"}, {"type": "subtitle", "time": 8141.189, "timestamp": "02:15:41", "text": "一部分？"}, {"type": "subtitle", "time": 8143.189, "timestamp": "02:15:43", "text": "是的，就那部分。那只是"}, {"type": "subtitle", "time": 8146.069, "timestamp": "02:15:46", "text": "一小段。我只需要一天就能教你"}, {"type": "subtitle", "time": 8148.149, "timestamp": "02:15:48", "text": "。"}, {"type": "subtitle", "time": 8151.83, "timestamp": "02:15:51", "text": "好的，那我们周六唱。"}, {"type": "subtitle", "time": 8155.189, "timestamp": "02:15:55", "text": "好的。好的。是的，你终于要"}, {"type": "subtitle", "time": 8157.51, "timestamp": "02:15:57", "text": "完成这首歌了。"}]
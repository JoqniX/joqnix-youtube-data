[{"type": "subtitle", "time": 9781.91, "timestamp": "02:43:01", "text": "是什么？那是机器人，对吧"}, {"type": "subtitle", "time": 9793.11, "timestamp": "02:43:13", "text": "那是机器人，对吧？"}, {"type": "subtitle", "time": 9794.95, "timestamp": "02:43:14", "text": "我遭到攻击了。有本事就"}, {"type": "subtitle", "time": 9806.63, "timestamp": "02:43:26", "text": "，你这小鬼。去死。你死定了。去死，去死，去死，去死，去死，去死，"}, {"type": "subtitle", "time": 9819.349, "timestamp": "02:43:39", "text": "无人生还。果然不出我所料。"}, {"type": "subtitle", "time": 9827.67, "timestamp": "02:43:47", "text": "应该还有一个。"}, {"type": "subtitle", "time": 9830.23, "timestamp": "02:43:50", "text": "你看到了吗？我不能用墙。我得用"}, {"type": "subtitle", "time": 9833.67, "timestamp": "02:43:53", "text": "墙盖住它，"}, {"type": "subtitle", "time": 9836.389, "timestamp": "02:43:56", "text": "我不能像那样"}, {"type": "subtitle", "time": 9838.71, "timestamp": "02:43:58", "text": "往上，我会把它放在那里。霰弹枪，"}]
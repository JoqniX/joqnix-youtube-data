[{"type": "subtitle", "time": 8400.469, "timestamp": "02:20:00", "text": "ああ、もっと"}, {"type": "subtitle", "time": 8401.99, "timestamp": "02:20:01", "text": "クリアになった感じ。"}, {"type": "subtitle", "time": 8404.469, "timestamp": "02:20:04", "text": "ああ、クリアになってきた。ああ、わかった。わかった。うん。そう。うん。"}, {"type": "subtitle", "time": 8410.95, "timestamp": "02:20:10", "text": "いいよ。それでは、"}, {"type": "subtitle", "time": 8413.349, "timestamp": "02:20:13", "text": "良い配信を。"}, {"type": "subtitle", "time": 8416.23, "timestamp": "02:20:16", "text": "幸運を祈って、おやすみなさい。こんにちは。さようなら。さようなら。こんにちは。さようなら"}, {"type": "subtitle", "time": 8420.15, "timestamp": "02:20:20", "text": "、ダン。素敵な夜を"}, {"type": "subtitle", "time": 8427.75, "timestamp": "02:20:27", "text": "こんにちは。ダンでした。"}, {"type": "subtitle", "time": 8430.469, "timestamp": "02:20:30", "text": "えっと、"}, {"type": "subtitle", "time": 8432.71, "timestamp": "02:20:32", "text": "歌の練習は終わりました"}, {"type": "subtitle", "time": 8435.75, "timestamp": "02:20:35", "text": "。さて、あれはあの歌でした。"}, {"type": "subtitle", "time": 8437.19, "timestamp": "02:20:37", "text": "歌の練習は終わりました"}, {"type": "subtitle", "time": 8440.79, "timestamp": "02:20:40", "text": "。ゲームに戻りましょう。運命の"}]
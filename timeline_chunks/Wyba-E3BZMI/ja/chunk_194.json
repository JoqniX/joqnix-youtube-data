[{"type": "subtitle", "time": 11654.79, "timestamp": "03:14:14", "text": "周囲に気を付けて。ソース。"}, {"type": "subtitle", "time": 11656.71, "timestamp": "03:14:16", "text": "シャーキー。待って。"}, {"type": "subtitle", "time": 11669.429, "timestamp": "03:14:29", "text": "ごめん。もう"}, {"type": "subtitle", "time": 11673.51, "timestamp": "03:14:33", "text": "1人いるはずだ。何してるの？"}, {"type": "subtitle", "time": 11676.15, "timestamp": "03:14:36", "text": "リロード中。周囲に気を付けて。"}, {"type": "subtitle", "time": 11692.07, "timestamp": "03:14:52", "text": "鎧が壊れた。"}, {"type": "subtitle", "time": 11694.07, "timestamp": "03:14:54", "text": "ニース。"}]
[{"type": "subtitle", "time": 10921.349, "timestamp": "03:02:01", "text": "[音楽]"}, {"type": "subtitle", "time": 10940.71, "timestamp": "03:02:20", "text": "。わかった。あの、"}, {"type": "subtitle", "time": 10942.469, "timestamp": "03:02:22", "text": "知ってる？キャンセルして戻ってくるよ"}, {"type": "subtitle", "time": 10944.07, "timestamp": "03:02:24", "text": "。戻ってきて。わかった。ちょっと待ってくれ"}, {"type": "subtitle", "time": 10959.349, "timestamp": "03:02:39", "text": "Principiは、"}, {"type": "subtitle", "time": 10961.19, "timestamp": "03:02:41", "text": "私たちが"}, {"type": "subtitle", "time": 10963.83, "timestamp": "03:02:43", "text": "研究所で達成したよりもはるかに高度なソースの使用法を採用している。一体"}, {"type": "subtitle", "time": 10970.07, "timestamp": "03:02:50", "text": "この人たちは誰なのかと疑問に思う。わかった、"}, {"type": "subtitle", "time": 10973.67, "timestamp": "03:02:53", "text": "私だ。ああ、"}, {"type": "chat", "time": 10976.172, "timestamp": "03:02:56", "author": "@aniketwande4403", "avatar": "https://yt4.ggpht.com/ytc/AIdro_m_Z2M4vVHkWPdw0fzo-i-Dy4Pm4-b-bs22Utnn5zkWBHY=s64-c-k-c0x00ffffff-no-rj", "message": "👍"}]
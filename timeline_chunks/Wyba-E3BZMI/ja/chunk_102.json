[{"type": "subtitle", "time": 6122.35, "timestamp": "01:42:02", "text": "ケーキを切ったり、その他いろいろ。"}, {"type": "subtitle", "time": 6123.99, "timestamp": "01:42:03", "text": "[音楽]"}, {"type": "subtitle", "time": 6126.55, "timestamp": "01:42:06", "text": "ええ、"}, {"type": "subtitle", "time": 6130.79, "timestamp": "01:42:10", "text": "今年は試験で忙しかったので誕生日を祝うことができませんでした"}, {"type": "subtitle", "time": 6133.59, "timestamp": "01:42:13", "text": "。 ええ、確かに"}, {"type": "subtitle", "time": 6141.83, "timestamp": "01:42:21", "text": "それはまるで、家の中でのささやかなお祝いのようだった"}, {"type": "subtitle", "time": 6145.35, "timestamp": "01:42:25", "text": "。 それから、えっと、友達が"}, {"type": "subtitle", "time": 6148.149, "timestamp": "01:42:28", "text": "ケーキを送ってくれたので、"}, {"type": "subtitle", "time": 6150.149, "timestamp": "01:42:30", "text": "配信でお祝いしました。"}, {"type": "subtitle", "time": 6153.83, "timestamp": "01:42:33", "text": "あ、友達に電話したりとか、"}, {"type": "subtitle", "time": 6155.03, "timestamp": "01:42:35", "text": "何かした？"}, {"type": "subtitle", "time": 6157.189, "timestamp": "01:42:37", "text": "いいえ、いいえ、家族しかいませんでした。   わかった"}, {"type": "subtitle", "time": 6158.629, "timestamp": "01:42:38", "text": "。"}, {"type": "subtitle", "time": 6160.709, "timestamp": "01:42:40", "text": "ええ、そうですね。   だから"}, {"type": "subtitle", "time": 6164.79, "timestamp": "01:42:44", "text": "私はたいていそうする。 普段はあまり盛大に"}, {"type": "subtitle", "time": 6166.709, "timestamp": "01:42:46", "text": "お祝いはしないんです。"}, {"type": "subtitle", "time": 6168.709, "timestamp": "01:42:48", "text": "せいぜい外に"}, {"type": "subtitle", "time": 6172.31, "timestamp": "01:42:52", "text": "夕食を食べに行ったりするくらいですね。"}, {"type": "subtitle", "time": 6173.51, "timestamp": "01:42:53", "text": "うん。"}, {"type": "subtitle", "time": 6175.43, "timestamp": "01:42:55", "text": "でも、今年は絶対にお祝いはしなかったよ"}, {"type": "subtitle", "time": 6176.79, "timestamp": "01:42:56", "text": "。"}, {"type": "subtitle", "time": 6178.39, "timestamp": "01:42:58", "text": "うん。   いいえ。ええ。 まだ"}]
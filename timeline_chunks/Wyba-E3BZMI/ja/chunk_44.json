[{"type": "subtitle", "time": 2649.349, "timestamp": "00:44:09", "text": "【音楽】"}, {"type": "subtitle", "time": 2653.43, "timestamp": "00:44:13", "text": "特別なイベントと"}, {"type": "subtitle", "time": 2668.23, "timestamp": "00:44:28", "text": "Discordを起動して、"}, {"type": "subtitle", "time": 2672.23, "timestamp": "00:44:32", "text": "その曲を流しながら通話を開始して、"}, {"type": "subtitle", "time": 2676.23, "timestamp": "00:44:36", "text": "それから歌の練習をしましょう。"}, {"type": "subtitle", "time": 2680.309, "timestamp": "00:44:40", "text": "ええ、皆さんは"}, {"type": "subtitle", "time": 2683.91, "timestamp": "00:44:43", "text": "お茶やお菓子などはちゃんと召し上がりましたか？"}, {"type": "subtitle", "time": 2685.99, "timestamp": "00:44:45", "text": "えっと、"}, {"type": "subtitle", "time": 2690.309, "timestamp": "00:44:50", "text": "昨日、ジョックニックのケーキを食べました。"}, {"type": "subtitle", "time": 2693.109, "timestamp": "00:44:53", "text": "パンディタンが私の"}]
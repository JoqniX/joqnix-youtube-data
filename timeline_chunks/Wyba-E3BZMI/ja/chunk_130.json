[{"type": "subtitle", "time": 7801.43, "timestamp": "02:10:01", "text": "これを送れたらいいのに。"}, {"type": "subtitle", "time": 7802.55, "timestamp": "02:10:02", "text": "大丈夫。大丈夫。わかった。"}, {"type": "subtitle", "time": 7804.55, "timestamp": "02:10:04", "text": "こんにちは。あと"}, {"type": "subtitle", "time": 7808.31, "timestamp": "02:10:08", "text": "2回だけ。練習。"}, {"type": "subtitle", "time": 7811.03, "timestamp": "02:10:11", "text": "タイミングを練習する必要がある。うん。うん。うん"}, {"type": "subtitle", "time": 7813.589, "timestamp": "02:10:13", "text": "。あと2回歌えば"}, {"type": "subtitle", "time": 7817.99, "timestamp": "02:10:17", "text": "練習は終わり。わかった。"}, {"type": "subtitle", "time": 7826.55, "timestamp": "02:10:26", "text": "水を飲んで。うん。"}]
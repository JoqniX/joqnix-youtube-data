[{"type": "subtitle", "time": 13560.229, "timestamp": "03:46:00", "text": "。 ええと、その合間にウィザリング・"}, {"type": "subtitle", "time": 13565.51, "timestamp": "03:46:05", "text": "ウェーブスも演奏してみようと思います。 ええ"}, {"type": "subtitle", "time": 13567.349, "timestamp": "03:46:07", "text": "、"}, {"type": "subtitle", "time": 13570.07, "timestamp": "03:46:10", "text": "正直に言うと、FPSゲームに関して私が抱えている唯一の問題は、"}, {"type": "subtitle", "time": 13575.91, "timestamp": "03:46:15", "text": "FPSに見合うだけの満足感を得られていないことです。 私は"}, {"type": "subtitle", "time": 13580.07, "timestamp": "03:46:20", "text": "60Hzモニターを使っています。いや、240Hzモニターを使っています。 行き詰まってしまった"}, {"type": "subtitle", "time": 13583.59, "timestamp": "03:46:23", "text": "。  PCが60度で止まってしまって、"}, {"type": "subtitle", "time": 13587.11, "timestamp": "03:46:27", "text": "処理しきれません。 ゲーム用"}, {"type": "subtitle", "time": 13588.71, "timestamp": "03:46:28", "text": "PCがあればよかったのに。"}, {"type": "subtitle", "time": 13591.75, "timestamp": "03:46:31", "text": "知っている。 私はそれ"}, {"type": "subtitle", "time": 13594.15, "timestamp": "03:46:34", "text": "について文句を言うでしょう。 私は"}, {"type": "subtitle", "time": 13597.429, "timestamp": "03:46:37", "text": "この男について毎回文句を言うだろう。なぜなら、これは"}, {"type": "subtitle", "time": 13601.67, "timestamp": "03:46:41", "text": "必要なことで、それがどれほど重要か分かるからだ"}, {"type": "subtitle", "time": 13604.389, "timestamp": "03:46:44", "text": "。"}, {"type": "subtitle", "time": 13608.38, "timestamp": "03:46:48", "text": "持続する。 私は"}, {"type": "subtitle", "time": 13610.389, "timestamp": "03:46:50", "text": "音楽です"}, {"type": "subtitle", "time": 13612.95, "timestamp": "03:46:52", "text": "。   ええ"}, {"type": "subtitle", "time": 13617.349, "timestamp": "03:46:57", "text": "、今のところは楽しんでいますよ。   では"}]
[{"type": "subtitle", "time": 8101.51, "timestamp": "02:15:01", "text": "えっと、"}, {"type": "subtitle", "time": 8103.75, "timestamp": "02:15:03", "text": "何時なら"}, {"type": "subtitle", "time": 8107.35, "timestamp": "02:15:07", "text": "空いてる？空いてるよ。行くよ。いや、"}, {"type": "subtitle", "time": 8110.31, "timestamp": "02:15:10", "text": "ほとんどの時間は空いてるんだけど、"}, {"type": "subtitle", "time": 8112.709, "timestamp": "02:15:12", "text": "午後3時か4時くらいが"}, {"type": "subtitle", "time": 8115.43, "timestamp": "02:15:15", "text": "歌うのにちょうどいい時間なんだ。その時間が一番好きなんだ。"}, {"type": "subtitle", "time": 8118.069, "timestamp": "02:15:18", "text": "うん、その時間が"}, {"type": "subtitle", "time": 8120.629, "timestamp": "02:15:20", "text": "一番好きなんだ。うん、いつも"}, {"type": "subtitle", "time": 8123.75, "timestamp": "02:15:23", "text": "みんなとこの時間に時間を調整してるよ。"}, {"type": "subtitle", "time": 8124.55, "timestamp": "02:15:24", "text": "うん。わかった"}, {"type": "subtitle", "time": 8127.43, "timestamp": "02:15:27", "text": "。じゃあ午後3時か4時。土曜日か"}, {"type": "subtitle", "time": 8129.189, "timestamp": "02:15:29", "text": "日曜日、行くよ。"}, {"type": "subtitle", "time": 8133.669, "timestamp": "02:15:33", "text": "どっちの日？1日だけ。"}, {"type": "subtitle", "time": 8135.99, "timestamp": "02:15:35", "text": "うん、1日で十分だよ。うん"}, {"type": "subtitle", "time": 8137.669, "timestamp": "02:15:37", "text": "。"}, {"type": "subtitle", "time": 8139.91, "timestamp": "02:15:39", "text": "ちょっと待って。最後の部分をやりたいの"}, {"type": "subtitle", "time": 8141.189, "timestamp": "02:15:41", "text": "？"}, {"type": "subtitle", "time": 8143.189, "timestamp": "02:15:43", "text": "うん、その部分だけ。ほんの少しの"}, {"type": "subtitle", "time": 8146.069, "timestamp": "02:15:46", "text": "部分だから。それを教えるのに1日あれば十分だよ"}, {"type": "subtitle", "time": 8148.149, "timestamp": "02:15:48", "text": "。わかった"}, {"type": "subtitle", "time": 8151.83, "timestamp": "02:15:51", "text": "、じゃあ土曜日にやろう。わかった。わかった。"}, {"type": "subtitle", "time": 8155.189, "timestamp": "02:15:55", "text": "うん、やっと"}, {"type": "subtitle", "time": 8157.51, "timestamp": "02:15:57", "text": "終わるんだね。 曲をアップします。"}]
[{"type": "subtitle", "time": 1562.52, "timestamp": "00:26:02", "text": "これ、アラートみたいだよね？"}, {"type": "subtitle", "time": 1564.23, "timestamp": "00:26:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1565.43, "timestamp": "00:26:05", "text": "男たちの声が聞こえない。"}, {"type": "subtitle", "time": 1567.35, "timestamp": "00:26:07", "text": "これはテスト用のスーパーチャットメッセージです。"}, {"type": "chat", "time": 1568.951, "timestamp": "00:26:08", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "yes"}, {"type": "subtitle", "time": 1569.75, "timestamp": "00:26:09", "text": "ああ、聞こえました。 聞こえますか？"}, {"type": "subtitle", "time": 1572.31, "timestamp": "00:26:12", "text": "聞こえますか？ 聞こえますか？ うん。 うん。"}, {"type": "subtitle", "time": 1576.63, "timestamp": "00:26:16", "text": "ここへ行ってください。  Streamlabsに行ってみてください。 えっと"}, {"type": "chat", "time": 1577.97, "timestamp": "00:26:17", "author": "@Shiori_mitsuki", "avatar": "https://yt4.ggpht.com/Dn0VbakjSKrSNaXx6PyhznuqbomoCGx22ivSawRcMXp25Io7cfsud3H3qP-g9QprPJUESlxxtJA=s64-c-k-c0x00ffffff-no-rj", "message": "yess"}, {"type": "subtitle", "time": 1578.95, "timestamp": "00:26:18", "text": "、ストリーム要素でこれってできますか"}, {"type": "subtitle", "time": 1580.71, "timestamp": "00:26:20", "text": "？ それでは、"}, {"type": "subtitle", "time": 1583.269, "timestamp": "00:26:23", "text": "ストリーム要素についてもご紹介しましょう。 ストリーム要素をカスタマイズしたい場合は、"}, {"type": "subtitle", "time": 1588.789, "timestamp": "00:26:28", "text": "YouTube のバージョンにログインする必要があります。YouTube に"}, {"type": "subtitle", "time": 1597.909, "timestamp": "00:26:37", "text": "ログインして、ストリーミング ツール"}, {"type": "subtitle", "time": 1599.99, "timestamp": "00:26:39", "text": "とオーバーレイに移動します。"}, {"type": "subtitle", "time": 1602.63, "timestamp": "00:26:42", "text": "待って、要素を使えばできると思うよ"}, {"type": "subtitle", "time": 1606.23, "timestamp": "00:26:46", "text": "。"}, {"type": "subtitle", "time": 1608.549, "timestamp": "00:26:48", "text": "新しい要素をチェックしてみます。"}, {"type": "subtitle", "time": 1610.789, "timestamp": "00:26:50", "text": "要素は基本的にアラートボックスの"}, {"type": "subtitle", "time": 1614.789, "timestamp": "00:26:54", "text": "ようなものです。 つまり、さまざまな州などを追加できるということです"}, {"type": "subtitle", "time": 1619.029, "timestamp": "00:26:59", "text": "。 それで、"}]
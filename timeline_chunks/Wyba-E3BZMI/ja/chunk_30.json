[{"type": "subtitle", "time": 1802.87, "timestamp": "00:30:02", "text": "よし、これから"}, {"type": "subtitle", "time": 1805.75, "timestamp": "00:30:05", "text": "一緒に学んでいこう。 はい、では"}, {"type": "subtitle", "time": 1810.549, "timestamp": "00:30:10", "text": "テキストを追加してください。 えっと、"}, {"type": "subtitle", "time": 1812.63, "timestamp": "00:30:12", "text": "これは何ですか？ ああ、わかりました。 これが本文で、"}, {"type": "subtitle", "time": 1817.029, "timestamp": "00:30:17", "text": "これがタイトルです。 タイトルは"}, {"type": "subtitle", "time": 1820.71, "timestamp": "00:30:20", "text": "スーパーチャットされます。"}, {"type": "subtitle", "time": 1824.71, "timestamp": "00:30:24", "text": "ああ、全部カスタマイズできるんですよ。"}, {"type": "subtitle", "time": 1827.19, "timestamp": "00:30:27", "text": "入力したテキストは、"}, {"type": "subtitle", "time": 1830.23, "timestamp": "00:30:30", "text": "これを削除してスラッシュを入力すると、"}, {"type": "subtitle", "time": 1833.029, "timestamp": "00:30:33", "text": "利用可能なプロパティが表示されます。 いいね"}, {"type": "subtitle", "time": 1837.75, "timestamp": "00:30:37", "text": "メッセージを送ったり、スーパーチャットを送ったりできます。 えっと、"}, {"type": "subtitle", "time": 1841.669, "timestamp": "00:30:41", "text": "スーパーチャッターの名前を載せることができます。"}, {"type": "subtitle", "time": 1846.789, "timestamp": "00:30:46", "text": "ああ、ああ、これは素晴らしい。 そして、"}, {"type": "subtitle", "time": 1856.149, "timestamp": "00:30:56", "text": "スーパー"}, {"type": "subtitle", "time": 1859.269, "timestamp": "00:30:59", "text": "チャットで金額を送る。 ああ、"}]
fffff-no-rj", "message": "thenkyuuu 😺 "}, {"type": "subtitle", "time": 2200.47, "timestamp": "00:36:40", "text": "こちらもお使いいただけます。 すべて"}, {"type": "subtitle", "time": 2203.109, "timestamp": "00:36:43", "text": "順調です。 つまり、両者は同じです。  Streamlabsと"}, {"type": "subtitle", "time": 2205.99, "timestamp": "00:36:45", "text": "Stream Elementsはどちらも同じものです。"}, {"type": "subtitle", "time": 2209.349, "timestamp": "00:36:49", "text": "Stream Elementsを使ってみて、うまくいくかどうか試してみてください"}, {"type": "subtitle", "time": 2212.15, "timestamp": "00:36:52", "text": "。"}, {"type": "subtitle", "time": 2215.67, "timestamp": "00:36:55", "text": "グラブタブとは何ですか？"}, {"type": "subtitle", "time": 2219.589, "timestamp": "00:36:59", "text": "Grab Tabがあなたの地域にも登場します。"}]
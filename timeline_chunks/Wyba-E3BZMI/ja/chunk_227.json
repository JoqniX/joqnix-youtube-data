[{"type": "subtitle", "time": 13633.83, "timestamp": "03:47:13", "text": "えっと、それに"}, {"type": "subtitle", "time": 13636.229, "timestamp": "03:47:16", "text": "私は全部 Opius を使っていないので、"}, {"type": "subtitle", "time": 13643.269, "timestamp": "03:47:23", "text": "ええ、"}, {"type": "subtitle", "time": 13644.87, "timestamp": "03:47:24", "text": "今日は何の日ですか？ 今日は何月何日ですか？"}, {"type": "subtitle", "time": 13651.11, "timestamp": "03:47:31", "text": "8月"}, {"type": "subtitle", "time": 13655.11, "timestamp": "03:47:35", "text": "12日。  JSONファイルをバックアップしてください。"}, {"type": "subtitle", "time": 13661.67, "timestamp": "03:47:41", "text": "すべてをオフにした、全く新しいシーンを新たに作成する必要があるかもしれない。   わから"}]
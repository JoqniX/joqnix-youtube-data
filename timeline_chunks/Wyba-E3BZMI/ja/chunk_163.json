[{"type": "subtitle", "time": 9781.91, "timestamp": "02:43:01", "text": "何だったんだ？あれはボットだったよね"}, {"type": "subtitle", "time": 9793.11, "timestamp": "02:43:13", "text": "あれはボットだったよね？"}, {"type": "subtitle", "time": 9794.95, "timestamp": "02:43:14", "text": "攻撃を受けてる。捕まえ"}, {"type": "subtitle", "time": 9806.63, "timestamp": "02:43:26", "text": "死ね、ガキ。死ね。お前は死ぬ。死ね、死ね、死ね、死ね、死ね、死ね、死ね、死ね、死ね。"}, {"type": "subtitle", "time": 9819.349, "timestamp": "02:43:39", "text": "生存者なし。予想通りだ。"}, {"type": "subtitle", "time": 9827.67, "timestamp": "02:43:47", "text": "1人いるはずだ。"}, {"type": "subtitle", "time": 9830.23, "timestamp": "02:43:50", "text": "見たか？壁を作れない。"}, {"type": "subtitle", "time": 9833.67, "timestamp": "02:43:53", "text": "壁を越えなきゃいけないし、上には置け"}, {"type": "subtitle", "time": 9836.389, "timestamp": "02:43:56", "text": "ない。そこに"}, {"type": "subtitle", "time": 9838.71, "timestamp": "02:43:58", "text": "置こう。ショットガンだろ"}]
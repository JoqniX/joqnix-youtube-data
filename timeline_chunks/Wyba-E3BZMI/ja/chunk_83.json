[{"type": "subtitle", "time": 4983.35, "timestamp": "01:23:03", "text": "これは何をするものですか？"}, {"type": "subtitle", "time": 4986.229, "timestamp": "01:23:06", "text": "これはバトルパスですか？"}, {"type": "subtitle", "time": 4990.709, "timestamp": "01:23:10", "text": "プレゼントを選んでください。 贈り物をいくつか用意する。   どちらが"}, {"type": "subtitle", "time": 4993.27, "timestamp": "01:23:13", "text": "お好みですか？"}, {"type": "subtitle", "time": 4996.31, "timestamp": "01:23:16", "text": "これは男性用か女性用か？   何てことだ"}, {"type": "subtitle", "time": 4999.03, "timestamp": "01:23:19", "text": "。"}, {"type": "subtitle", "time": 5005.27, "timestamp": "01:23:25", "text": "なあ、俺は両方欲しいよ。 両方することはできないのでしょうか？"}, {"type": "subtitle", "time": 5010.55, "timestamp": "01:23:30", "text": "両方とも欲しい。 両方することはできないのでしょうか？   わかった"}, {"type": "subtitle", "time": 5014.55, "timestamp": "01:23:34", "text": "、いいよ。 どちらも良い人です。 私は"}, {"type": "subtitle", "time": 5017.35, "timestamp": "01:23:37", "text": "青色が好きです。 私は青色が好きです。"}, {"type": "subtitle", "time": 5020.629, "timestamp": "01:23:40", "text": "執事。 これもまた"}, {"type": "subtitle", "time": 5022.79, "timestamp": "01:23:42", "text": "良い点だ。"}, {"type": "subtitle", "time": 5024.87, "timestamp": "01:23:44", "text": "私の"}]
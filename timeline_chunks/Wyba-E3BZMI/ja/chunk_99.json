[{"type": "subtitle", "time": 5949.91, "timestamp": "01:39:09", "text": "それが癒しの性質です。"}, {"type": "subtitle", "time": 5953.109, "timestamp": "01:39:13", "text": "この男はどうですか？"}, {"type": "subtitle", "time": 5953.27, "timestamp": "01:39:13", "text": "彼は"}, {"type": "subtitle", "time": 5961.109, "timestamp": "01:39:21", "text": "これには"}, {"type": "subtitle", "time": 5968.07, "timestamp": "01:39:28", "text": "面白い。"}, {"type": "subtitle", "time": 5971.99, "timestamp": "01:39:31", "text": "とにかく、"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "このゲームから少し休憩する必要があります。"}, {"type": "subtitle", "time": 5978.31, "timestamp": "01:39:38", "text": "よし、ゲームは"}, {"type": "subtitle", "time": 5982.55, "timestamp": "01:39:42", "text": "後で再開しよう。 息子とのセッションをやらなければならない"}, {"type": "subtitle", "time": 5984.47, "timestamp": "01:39:44", "text": "。   だから"}, {"type": "subtitle", "time": 5986.709, "timestamp": "01:39:46", "text": "、今はそれに集中することにします"}, {"type": "subtitle", "time": 5990.07, "timestamp": "01:39:50", "text": "。 わかった。 えっと、私が交代させてください"}]
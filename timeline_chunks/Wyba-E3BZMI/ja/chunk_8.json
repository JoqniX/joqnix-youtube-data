[{"type": "subtitle", "time": 485.029, "timestamp": "00:08:05", "text": "よし、そろそろ戻ってこなくちゃね？   はい"}, {"type": "subtitle", "time": 488.23, "timestamp": "00:08:08", "text": "、戻ってきました。"}, {"type": "subtitle", "time": 490.469, "timestamp": "00:08:10", "text": "[音楽]"}, {"type": "subtitle", "time": 493.83, "timestamp": "00:08:13", "text": "私の配信は再びアクティブになりましたか？ ええ、そうだと思います"}, {"type": "subtitle", "time": 503.589, "timestamp": "00:08:23", "text": "はい、配信が再開しました。 ニース。"}, {"type": "subtitle", "time": 509.83, "timestamp": "00:08:29", "text": "ライブ配信できるかどうか確認したいだけです。   わかった"}, {"type": "subtitle", "time": 512.31, "timestamp": "00:08:32", "text": "。"}, {"type": "subtitle", "time": 519.509, "timestamp": "00:08:39", "text": "[音楽] ちょっと"}, {"type": "subtitle", "time": 521.829, "timestamp": "00:08:41", "text": "待って、あの紙吹雪は何だったの？ そうそう。"}, {"type": "subtitle", "time": 523.909, "timestamp": "00:08:43", "text": "紙吹雪のトリガーは「いいね」とか「"}, {"type": "subtitle", "time": 527.43, "timestamp": "00:08:47", "text": "チャンネル登録」とか、そういう類のものだと思います。"}]
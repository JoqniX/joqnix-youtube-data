[{"type": "subtitle", "time": 12360.229, "timestamp": "03:26:00", "text": "。 ああ、彼女は私のもとを去った。 別のチームメイト。"}, {"type": "subtitle", "time": 12383.429, "timestamp": "03:26:23", "text": "あれは崖だ。 いいえ。"}, {"type": "subtitle", "time": 12411.03, "timestamp": "03:26:51", "text": "気をつけろ。 私は攻撃を受けている。"}, {"type": "subtitle", "time": 12413.19, "timestamp": "03:26:53", "text": "ああ、神様。 ああ、神様。 ああ、神様。 ああ、神様。   今行ってる"}, {"type": "subtitle", "time": 12416.309, "timestamp": "03:26:56", "text": "。"}, {"type": "subtitle", "time": 12418.309, "timestamp": "03:26:58", "text": "私のことは心配しないでください。 今はただ、自分の身なりを整えているところです"}]
[{"type": "subtitle", "time": 6240.87, "timestamp": "01:44:00", "text": "日で構いません。 あるいは"}, {"type": "subtitle", "time": 6242.87, "timestamp": "01:44:02", "text": "月曜日や火曜日でもいい。"}, {"type": "subtitle", "time": 6245.99, "timestamp": "01:44:05", "text": "20時までに終わらせればいいんだ。"}, {"type": "subtitle", "time": 6248.149, "timestamp": "01:44:08", "text": "うん、できるよ。 うん。"}, {"type": "subtitle", "time": 6250.709, "timestamp": "01:44:10", "text": "うん。 日程さえ教えてくれれば、あとは君の都合がいいよ"}, {"type": "subtitle", "time": 6253.51, "timestamp": "01:44:13", "text": "。"}, {"type": "subtitle", "time": 6254.79, "timestamp": "01:44:14", "text": "はい。   ほんの"}, {"type": "subtitle", "time": 6256.47, "timestamp": "01:44:16", "text": "一部です。 だから、"}, {"type": "subtitle", "time": 6258.39, "timestamp": "01:44:18", "text": "あなたに多くを教える必要はないと思います。 それは単に一部を"}, {"type": "subtitle", "time": 6260.95, "timestamp": "01:44:20", "text": "繰り返しているだけです。 うん。 もう"}, {"type": "subtitle", "time": 6263.51, "timestamp": "01:44:23", "text": "歌い始めてもいいかな。"}, {"type": "subtitle", "time": 6263.83, "timestamp": "01:44:23", "text": "ああ、"}, {"type": "subtitle", "time": 6266.39, "timestamp": "01:44:26", "text": "私のことは気にしないで。 はい、少々お待ちください"}, {"type": "subtitle", "time": 6268.87, "timestamp": "01:44:28", "text": "。 ちょっと調整させてください"}, {"type": "subtitle", "time": 6271.83, "timestamp": "01:44:31", "text": "。"}, {"type": "subtitle", "time": 6276.47, "timestamp": "01:44:36", "text": "ああ、わかった。 ああ、そうだね。 今日はどんな一日でしたか"}, {"type": "subtitle", "time": 6278.229, "timestamp": "01:44:38", "text": "？ 聞き忘れた。"}, {"type": "subtitle", "time": 6280.87, "timestamp": "01:44:40", "text": "今日はどんな一日でしたか？ 今日。"}, {"type": "subtitle", "time": 6284.149, "timestamp": "01:44:44", "text": "ええ、別のアーティストとのコラボレーションのミュージックビデオを仕上げていたところでした。"}, {"type": "subtitle", "time": 6289.51, "timestamp": "01:44:49", "text": "ええ、それをやっていました。"}, {"type": "subtitle", "time": 6291.59, "timestamp": "01:44:51", "text": "今日は他に予定はありません。"}, {"type": "subtitle", "time": 6293.43, "timestamp": "01:44:53", "text": "今日は楽しかったとか、そういうことは特に言えないな"}, {"type": "subtitle", "time": 6295.109, "timestamp": "01:44:55", "text": "。"}, {"type": "subtitle", "time": 6297.669, "timestamp": "01:44:57", "text": "うん。 ところで、ジョー、今日の調子はどう？   えっと、私は"}]
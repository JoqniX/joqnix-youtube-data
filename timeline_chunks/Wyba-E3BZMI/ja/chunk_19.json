[{"type": "subtitle", "time": 1149.029, "timestamp": "00:19:09", "text": "えーとランチャーが突然"}, {"type": "subtitle", "time": 1150.87, "timestamp": "00:19:10", "text": "黒い画面にアンチチーフが"}, {"type": "subtitle", "time": 1154.63, "timestamp": "00:19:14", "text": "ポップアップして、フェイト"}, {"type": "subtitle", "time": 1159.75, "timestamp": "00:19:19", "text": "トリガーが"}, {"type": "subtitle", "time": 1169.43, "timestamp": "00:19:29", "text": "これは全体的に最悪だ、"}, {"type": "subtitle", "time": 1172.15, "timestamp": "00:19:32", "text": "ゲームをプレイしたかったのにプレイできない、一体どういうことだ"}]
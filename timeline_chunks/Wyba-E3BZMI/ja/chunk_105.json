[{"type": "subtitle", "time": 6302.229, "timestamp": "01:45:02", "text": "大丈夫です。"}, {"type": "subtitle", "time": 6304.709, "timestamp": "01:45:04", "text": "私は大丈夫です。 うん。"}, {"type": "subtitle", "time": 6307.27, "timestamp": "01:45:07", "text": "今日はいい日だった。"}, {"type": "subtitle", "time": 6312.07, "timestamp": "01:45:12", "text": "昨日からずっと寝ている。"}, {"type": "subtitle", "time": 6313.669, "timestamp": "01:45:13", "text": "ありがとう。"}, {"type": "subtitle", "time": 6314.31, "timestamp": "01:45:14", "text": "こんにちは。"}, {"type": "subtitle", "time": 6315.91, "timestamp": "01:45:15", "text": "歌う準備はできた？"}, {"type": "subtitle", "time": 6321.27, "timestamp": "01:45:21", "text": "1秒。 ええと、これを繋げてみようかな。"}, {"type": "subtitle", "time": 6324.629, "timestamp": "01:45:24", "text": "うん。 ええと、最初から順番にやっていきますよね"}, {"type": "subtitle", "time": 6325.35, "timestamp": "01:45:25", "text": "？"}, {"type": "subtitle", "time": 6327.83, "timestamp": "01:45:27", "text": "うん。   わかった"}, {"type": "subtitle", "time": 6335.669, "timestamp": "01:45:35", "text": "。 音楽を入れるべきでしょうか、それとも入れ"}, {"type": "subtitle", "time": 6337.27, "timestamp": "01:45:37", "text": "ない方が良いでしょうか？"}, {"type": "subtitle", "time": 6339.99, "timestamp": "01:45:39", "text": "じゃあ、音楽に合わせて歌いましょう。   わかった"}, {"type": "subtitle", "time": 6342.47, "timestamp": "01:45:42", "text": "。 水を少し飲ませてくれれば、準備完了だ"}, {"type": "subtitle", "time": 6345.27, "timestamp": "01:45:45", "text": "。   こんにちは"}, {"type": "subtitle", "time": 6348.95, "timestamp": "01:45:48", "text": "。"}, {"type": "subtitle", "time": 6351.189, "timestamp": "01:45:51", "text": "おい。"}]
[{"type": "subtitle", "time": 13023.51, "timestamp": "03:37:03", "text": "ねえ、もっと他に"}, {"type": "subtitle", "time": 13024.95, "timestamp": "03:37:04", "text": "クリックする価値のあるものはないの？"}, {"type": "subtitle", "time": 13027.67, "timestamp": "03:37:07", "text": "ああ、彼女をクリックすることはできません。"}, {"type": "subtitle", "time": 13045.51, "timestamp": "03:37:25", "text": "私は世界を照らすためにここにいる。"}, {"type": "subtitle", "time": 13047.83, "timestamp": "03:37:27", "text": "どんな些細な考えにも、何かの扉を"}, {"type": "subtitle", "time": 13050.79, "timestamp": "03:37:30", "text": "開く可能性が秘められている。"}, {"type": "subtitle", "time": 13054.229, "timestamp": "03:37:34", "text": "ああ、2日間とか"}, {"type": "subtitle", "time": 13063.269, "timestamp": "03:37:43", "text": "あなたの約束に従って。   彼らには"}, {"type": "subtitle", "time": 13065.269, "timestamp": "03:37:45", "text": "盛り上げ役が必要だとおっしゃったので、私が来ました"}]
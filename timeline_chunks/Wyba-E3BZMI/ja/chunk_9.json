[{"type": "subtitle", "time": 547.43, "timestamp": "00:09:07", "text": "えっと、とにかく、"}, {"type": "subtitle", "time": 549.509, "timestamp": "00:09:09", "text": "ゲームに接続できません。 一体どういうことだ"}, {"type": "subtitle", "time": 551.75, "timestamp": "00:09:11", "text": "？   まさか私が"}, {"type": "subtitle", "time": 554.87, "timestamp": "00:09:14", "text": "この配信を作ったなんて言わないで。"}, {"type": "subtitle", "time": 563.67, "timestamp": "00:09:23", "text": "待って、待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 564.79, "timestamp": "00:09:24", "text": "彼らは私に教えてくれない。 彼らは"}, {"type": "subtitle", "time": 575.59, "timestamp": "00:09:35", "text": "待たないで、待たないで。"}, {"type": "subtitle", "time": 590.63, "timestamp": "00:09:50", "text": "待って。"}, {"type": "subtitle", "time": 592.47, "timestamp": "00:09:52", "text": "そう、その頃には"}]
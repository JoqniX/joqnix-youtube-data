[{"type": "subtitle", "time": 10740.07, "timestamp": "02:59:00", "text": "なぜ彼女は"}, {"type": "subtitle", "time": 10742.15, "timestamp": "02:59:02", "text": "残っているチームは1つだけ。"}, {"type": "subtitle", "time": 10744.07, "timestamp": "02:59:04", "text": "待って、チームは1つだけ 死なないで。"}, {"type": "subtitle", "time": 10761.67, "timestamp": "02:59:21", "text": "リズムを感じる。"}, {"type": "subtitle", "time": 10764.87, "timestamp": "02:59:24", "text": "私たちはできる。"}, {"type": "subtitle", "time": 10767.269, "timestamp": "02:59:27", "text": "ああ、彼女はおそらく円で死ぬだろう"}, {"type": "subtitle", "time": 10769.269, "timestamp": "02:59:29", "text": "。"}, {"type": "subtitle", "time": 10778.23, "timestamp": "02:59:38", "text": "いい試みだ。"}, {"type": "subtitle", "time": 10785.22, "timestamp": "02:59:45", "text": "、兄弟。"}, {"type": "subtitle", "time": 10786.79, "timestamp": "02:59:46", "text": "[音楽]"}, {"type": "subtitle", "time": 10789.11, "timestamp": "02:59:49", "text": "そうなったのは、私が"}, {"type": "subtitle", "time": 10791.59, "timestamp": "02:59:51", "text": "AFKするために。"}, {"type": "subtitle", "time": 10794.23, "timestamp": "02:59:54", "text": "もしそうしていたら、今そこにいたら、"}, {"type": "subtitle", "time": 10797.11, "timestamp": "02:59:57", "text": "自分のものを救えたかもしれない。だから、私の責任だ"}]
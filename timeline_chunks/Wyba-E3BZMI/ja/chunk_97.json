[{"type": "subtitle", "time": 5820.07, "timestamp": "01:37:00", "text": "そんなに大きくは動けない。"}, {"type": "subtitle", "time": 5831.189, "timestamp": "01:37:11", "text": "再装填中。 私を援護してください。"}, {"type": "subtitle", "time": 5834.39, "timestamp": "01:37:14", "text": "そして、8つくらいあるんですが、2つくらい、"}, {"type": "subtitle", "time": 5837.99, "timestamp": "01:37:17", "text": "3000の痛みがあります。 そういう側面もあるんですね"}, {"type": "subtitle", "time": 5840.95, "timestamp": "01:37:20", "text": "。"}, {"type": "subtitle", "time": 5843.51, "timestamp": "01:37:23", "text": "それは痛みだ。 地域を変更する方法はありますか"}]
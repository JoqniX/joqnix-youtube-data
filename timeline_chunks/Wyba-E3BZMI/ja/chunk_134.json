[{"type": "subtitle", "time": 8050.31, "timestamp": "02:14:10", "text": "良かった？"}, {"type": "subtitle", "time": 8052.629, "timestamp": "02:14:12", "text": "うん。うん。"}, {"type": "subtitle", "time": 8057.03, "timestamp": "02:14:17", "text": "楽器なしで歌うと、なぜかゆっくりになるのに気づいたんだ"}, {"type": "subtitle", "time": 8057.589, "timestamp": "02:14:17", "text": "。"}, {"type": "subtitle", "time": 8060.55, "timestamp": "02:14:20", "text": "うん。それは、"}, {"type": "subtitle", "time": 8063.669, "timestamp": "02:14:23", "text": "うん。知ってるよ。僕自身も、他の人に歌を教えるときに楽器なしで"}, {"type": "subtitle", "time": 8067.43, "timestamp": "02:14:27", "text": "教えるんだ"}, {"type": "subtitle", "time": 8069.35, "timestamp": "02:14:29", "text": "。だから、"}, {"type": "subtitle", "time": 8071.75, "timestamp": "02:14:31", "text": "一行ずつ教えるんだ。だから、"}, {"type": "subtitle", "time": 8074.79, "timestamp": "02:14:34", "text": "実際の歌よりもずっとゆっくり言ってる感じなんだ"}, {"type": "subtitle", "time": 8078.149, "timestamp": "02:14:38", "text": "。うん。うん"}, {"type": "subtitle", "time": 8080.95, "timestamp": "02:14:40", "text": "。うん。僕自身も、"}, {"type": "subtitle", "time": 8083.15, "timestamp": "02:14:43", "text": "たぶん同じ問題だと思う。"}, {"type": "subtitle", "time": 8084.709, "timestamp": "02:14:44", "text": "[音楽]"}, {"type": "subtitle", "time": 8087.589, "timestamp": "02:14:47", "text": "うん。ところで、いつ空いてる？"}, {"type": "subtitle", "time": 8087.99, "timestamp": "02:14:47", "text": "うん。"}, {"type": "subtitle", "time": 8091.91, "timestamp": "02:14:51", "text": "僕は わからない。えっと、たぶん"}, {"type": "subtitle", "time": 8094.79, "timestamp": "02:14:54", "text": "この時間か4時くらいなら空いてると思う。"}, {"type": "subtitle", "time": 8095.27, "timestamp": "02:14:55", "text": "うん。"}]
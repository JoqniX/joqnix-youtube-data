[{"type": "subtitle", "time": 9516.63, "timestamp": "02:38:36", "text": "少ない。少ない。ああ、少ない。"}, {"type": "subtitle", "time": 9517.429, "timestamp": "02:38:37", "text": "リロード中。チーム"}, {"type": "subtitle", "time": 9522.07, "timestamp": "02:38:42", "text": "メイトは遠くにいる。一体どういうことだ？"}, {"type": "subtitle", "time": 9524.389, "timestamp": "02:38:44", "text": "死ぬかもしれない。"}, {"type": "subtitle", "time": 9533.11, "timestamp": "02:38:53", "text": "実際に"}, {"type": "subtitle", "time": 9535.349, "timestamp": "02:38:55", "text": "撃たれた。"}]
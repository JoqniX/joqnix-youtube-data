[{"type": "subtitle", "time": 7920.47, "timestamp": "02:12:00", "text": "。うん、"}, {"type": "subtitle", "time": 7923.75, "timestamp": "02:12:03", "text": "この詩では鳩の音程で歌ってるね"}, {"type": "subtitle", "time": 7925.91, "timestamp": "02:12:05", "text": "。実際、"}, {"type": "subtitle", "time": 7927.589, "timestamp": "02:12:07", "text": "これを"}, {"type": "subtitle", "time": 7930.47, "timestamp": "02:12:10", "text": "うん、君の声域の音程で録音しないといけないと思う"}, {"type": "subtitle", "time": 7932.229, "timestamp": "02:12:12", "text": "。"}, {"type": "subtitle", "time": 7934.709, "timestamp": "02:12:14", "text": "うん。そうすれば"}, {"type": "subtitle", "time": 7936.79, "timestamp": "02:12:16", "text": "かなり正確に一緒に歌えるよ。そう"}, {"type": "subtitle", "time": 7940.229, "timestamp": "02:12:20", "text": "。 うん。"}, {"type": "subtitle", "time": 7941.99, "timestamp": "02:12:21", "text": "次の配信の前に録音してみるよ。うん"}, {"type": "subtitle", "time": 7946.069, "timestamp": "02:12:26", "text": "。うん。ああ、うん。水を飲んだ。"}, {"type": "subtitle", "time": 7949.27, "timestamp": "02:12:29", "text": "うん。もっと水を飲まなくちゃ。これはまるで「"}, {"type": "subtitle", "time": 7952.87, "timestamp": "02:12:32", "text": "これは全部冷たい」って感じだった。いや、いや、いや。"}, {"type": "subtitle", "time": 7955.75, "timestamp": "02:12:35", "text": "普通になった。うん"}, {"type": "subtitle", "time": 7960.55, "timestamp": "02:12:40", "text": "。待つ時間も来た。"}, {"type": "subtitle", "time": 7963.27, "timestamp": "02:12:43", "text": "よし。じゃあ、"}, {"type": "subtitle", "time": 7966.47, "timestamp": "02:12:46", "text": "楽器なしでやろう"}, {"type": "subtitle", "time": 7966.95, "timestamp": "02:12:46", "text": "。"}, {"type": "subtitle", "time": 7968.95, "timestamp": "02:12:48", "text": "これが最後だ。やあ"}, {"type": "subtitle", "time": 7970.229, "timestamp": "02:12:50", "text": "。やあ。"}]
[{"type": "subtitle", "time": 6090.39, "timestamp": "01:41:30", "text": "あ、"}, {"type": "subtitle", "time": 6091.43, "timestamp": "01:41:31", "text": "こんにちは。"}, {"type": "subtitle", "time": 6093.51, "timestamp": "01:41:33", "text": "こんにちは、ジャック。"}, {"type": "subtitle", "time": 6095.35, "timestamp": "01:41:35", "text": "待って、待って、待って、待って、待って、待って。   そこの"}, {"type": "subtitle", "time": 6096.31, "timestamp": "01:41:36", "text": "あなた？"}, {"type": "subtitle", "time": 6098.31, "timestamp": "01:41:38", "text": "はい。 こんにちは。 私はプッシュトゥトークモードにしていました。   ごめん"}, {"type": "subtitle", "time": 6100.229, "timestamp": "01:41:40", "text": "。 こんにちは。"}, {"type": "subtitle", "time": 6104.31, "timestamp": "01:41:44", "text": "こんにちは。 うん。 うん。   今"}, {"type": "subtitle", "time": 6105.59, "timestamp": "01:41:45", "text": "すぐ。"}, {"type": "subtitle", "time": 6108.07, "timestamp": "01:41:48", "text": "はい。 あなたは配信中です。 はい。   私はできません"}, {"type": "subtitle", "time": 6111.35, "timestamp": "01:41:51", "text": "。 えっと、"}, {"type": "subtitle", "time": 6113.91, "timestamp": "01:41:53", "text": "今日は誕生日ですか？"}, {"type": "subtitle", "time": 6116.55, "timestamp": "01:41:56", "text": "うん、昨日の配信は昨日の"}, {"type": "subtitle", "time": 6119.99, "timestamp": "01:41:59", "text": "誕生日のお祝いだったんだね。よかったよ。"}]
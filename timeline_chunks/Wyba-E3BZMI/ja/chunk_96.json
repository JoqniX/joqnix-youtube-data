[{"type": "subtitle", "time": 5779.11, "timestamp": "01:36:19", "text": "あちらでどれだけ遅れていたか、気づきましたか？"}, {"type": "subtitle", "time": 5788.47, "timestamp": "01:36:28", "text": "私は起き上がりたかった。 どうすれば"}, {"type": "subtitle", "time": 5806.629, "timestamp": "01:36:46", "text": "Fを取り除かないといけない。"}, {"type": "subtitle", "time": 5807.59, "timestamp": "01:36:47", "text": "さあ、アリエル、行こう。"}, {"type": "subtitle", "time": 5817.83, "timestamp": "01:36:57", "text": "ああ、180までしか動けないんだよ。"}]
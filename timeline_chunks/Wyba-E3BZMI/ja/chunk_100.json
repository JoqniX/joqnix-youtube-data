[{"type": "subtitle", "time": 6001.43, "timestamp": "01:40:01", "text": "はい、到着しました。"}, {"type": "subtitle", "time": 6014.79, "timestamp": "01:40:14", "text": "確かに動作が遅いですね。"}, {"type": "subtitle", "time": 6017.109, "timestamp": "01:40:17", "text": "とりあえずゲームを閉じて、"}, {"type": "subtitle", "time": 6037.189, "timestamp": "01:40:37", "text": "つまり、曲に合わせて音楽とか全部準備するってこと"}, {"type": "subtitle", "time": 6053.99, "timestamp": "01:40:53", "text": "彼らに電話してもいいですか？ わかった。 それは必ずやり遂げます"}, {"type": "subtitle", "time": 6055.91, "timestamp": "01:40:55", "text": "。 音楽の練習をします"}, {"type": "subtitle", "time": 6059.51, "timestamp": "01:40:59", "text": "。 わかった。 えっと、イギリスの歌を歌ってる。"}]
[{"type": "subtitle", "time": 13501.11, "timestamp": "03:45:01", "text": "今日のストリームの内容を楽しんでいただけたら嬉しいです。楽しかったらいいな。"}, {"type": "subtitle", "time": 13519.349, "timestamp": "03:45:19", "text": "楽しかったです。   わかった"}, {"type": "subtitle", "time": 13521.269, "timestamp": "03:45:21", "text": "。 遅延時間はどれくらいですか？"}, {"type": "subtitle", "time": 13524.309, "timestamp": "03:45:24", "text": "Battlefieldをダウンロードできるようにしました。 明日、というか"}, {"type": "subtitle", "time": 13526.469, "timestamp": "03:45:26", "text": "明日の朝は、"}, {"type": "subtitle", "time": 13529.75, "timestamp": "03:45:29", "text": "バトルフィールド4をプレイする予定です。了解。   わかった"}, {"type": "subtitle", "time": 13531.349, "timestamp": "03:45:31", "text": "。  1分間の遅延があります。"}, {"type": "subtitle", "time": 13533.349, "timestamp": "03:45:33", "text": "ダウンロードを一時停止します。"}, {"type": "subtitle", "time": 13535.429, "timestamp": "03:45:35", "text": "うん。 うん。 これで終わりにします。   わかった"}, {"type": "subtitle", "time": 13539.59, "timestamp": "03:45:39", "text": "。 それでは、皆さんが今日を楽しんでくれることを願っています。"}, {"type": "subtitle", "time": 13542.79, "timestamp": "03:45:42", "text": "皆さんが今日を楽しんでくれることを願っています。 そうそう、"}, {"type": "subtitle", "time": 13545.429, "timestamp": "03:45:45", "text": "心配しないで。 たとえ"}, {"type": "subtitle", "time": 13550.07, "timestamp": "03:45:50", "text": "コールオブデューティをプレイすることになっても、"}, {"type": "subtitle", "time": 13556.63, "timestamp": "03:45:56", "text": "今週はバトルフィールド6をプレイする予定です"}]
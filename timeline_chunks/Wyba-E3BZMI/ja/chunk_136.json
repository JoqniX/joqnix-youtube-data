[{"type": "subtitle", "time": 8160.629, "timestamp": "02:16:00", "text": "ええ。長い1年後、あるいは1年"}, {"type": "subtitle", "time": 8163.75, "timestamp": "02:16:03", "text": "後だったと思います。1年前だったかな。"}, {"type": "subtitle", "time": 8167.589, "timestamp": "02:16:07", "text": "いや、正確には1年前じゃない。いや、つい最近、"}, {"type": "subtitle", "time": 8170.31, "timestamp": "02:16:10", "text": "数週間前だったかな。いや、数週間"}, {"type": "subtitle", "time": 8172.39, "timestamp": "02:16:12", "text": "前。ええ、2ヶ月前。"}, {"type": "subtitle", "time": 8175.03, "timestamp": "02:16:15", "text": "私が初めてあなたに"}, {"type": "subtitle", "time": 8178.709, "timestamp": "02:16:18", "text": "この曲を教えた時のことです。そういうことです。"}, {"type": "subtitle", "time": 8182.069, "timestamp": "02:16:22", "text": "ええ、それは確か先月だったよね"}, {"type": "subtitle", "time": 8183.51, "timestamp": "02:16:23", "text": "？"}, {"type": "subtitle", "time": 8185.83, "timestamp": "02:16:25", "text": "ええと、私が言っているのは、"}, {"type": "subtitle", "time": 8192.87, "timestamp": "02:16:32", "text": "基本的にパートを分割せずに、この曲全体を1つのストリームであなたに教えようとした、本当に本当に"}, {"type": "subtitle", "time": 8193.669, "timestamp": "02:16:33", "text": "初めての時のことです。"}, {"type": "subtitle", "time": 8195.429, "timestamp": "02:16:35", "text": "ああ、そう。そう。そう。そう。そう。"}, {"type": "subtitle", "time": 8197.349, "timestamp": "02:16:37", "text": "覚えているよ。そう。そう。"}, {"type": "subtitle", "time": 8199.99, "timestamp": "02:16:39", "text": "今月ではないし、"}, {"type": "subtitle", "time": 8201.83, "timestamp": "02:16:41", "text": "今年でもないと思う。"}, {"type": "subtitle", "time": 8204.309, "timestamp": "02:16:44", "text": "試験があったから。間違いなく去年のことだった"}, {"type": "subtitle", "time": 8206.549, "timestamp": "02:16:46", "text": "けど、あなたは"}, {"type": "subtitle", "time": 8209.11, "timestamp": "02:16:49", "text": "練習しなかったし、"}, {"type": "subtitle", "time": 8211.589, "timestamp": "02:16:51", "text": "曲をすっかり忘れてしまった。"}]
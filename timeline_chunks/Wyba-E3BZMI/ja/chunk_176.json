[{"type": "subtitle", "time": 10562.55, "timestamp": "02:56:02", "text": "ああ、しまった。それに、"}, {"type": "subtitle", "time": 10566.63, "timestamp": "02:56:06", "text": "死にかけている。回復している。"}, {"type": "subtitle", "time": 10572.79, "timestamp": "02:56:12", "text": "ああ、"}, {"type": "subtitle", "time": 10588.469, "timestamp": "02:56:28", "text": "心配しないで。ただ回復しているだけだ"}, {"type": "subtitle", "time": 10599.83, "timestamp": "02:56:39", "text": "。攻撃されている。2"}, {"type": "subtitle", "time": 10607.11, "timestamp": "02:56:47", "text": "こんにちは、アン。ようこそ。捕まえ"}, {"type": "subtitle", "time": 10609.429, "timestamp": "02:56:49", "text": "られるものなら捕まえてみろ。私のことは"}, {"type": "subtitle", "time": 10611.51, "timestamp": "02:56:51", "text": "心配しないで。 ちょっと手直ししてるだけだよ"}]
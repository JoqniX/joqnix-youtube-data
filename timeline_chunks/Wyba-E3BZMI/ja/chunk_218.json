[{"type": "subtitle", "time": 13101.91, "timestamp": "03:38:21", "text": "私は本当にコール オブ デューティをプレイしたい。 明日は"}, {"type": "subtitle", "time": 13105.03, "timestamp": "03:38:25", "text": "コール オブ デューティではなく、バトルフィールドだ"}, {"type": "subtitle", "time": 13115.91, "timestamp": "03:38:35", "text": "えっと、アン"}, {"type": "subtitle", "time": 13122.95, "timestamp": "03:38:42", "text": "インストールすべきゲームを全部確認してみます。 スペースを空ける必要がある。"}, {"type": "subtitle", "time": 13125.269, "timestamp": "03:38:45", "text": "Apexにウェーブを追加してアップデートする必要がある。"}]
[{"type": "subtitle", "time": 361.189, "timestamp": "00:06:01", "text": "今日プレイしてみます。"}, {"type": "subtitle", "time": 363.27, "timestamp": "00:06:03", "text": "はい。"}, {"type": "subtitle", "time": 365.51, "timestamp": "00:06:05", "text": "今日はそれをプレイする予定なので、どんな感じになるのか"}, {"type": "subtitle", "time": 370.55, "timestamp": "00:06:10", "text": "見てみたい。"}, {"type": "subtitle", "time": 372.87, "timestamp": "00:06:12", "text": "いらっしゃいませ。"}, {"type": "subtitle", "time": 378.05, "timestamp": "00:06:18", "text": "ゲームを起動して"}, {"type": "subtitle", "time": 379.35, "timestamp": "00:06:19", "text": "[音楽]を再生します"}, {"type": "subtitle", "time": 381.99, "timestamp": "00:06:21", "text": "。 今回が初めてのローンチなので、とても"}, {"type": "subtitle", "time": 385.029, "timestamp": "00:06:25", "text": "ワクワクしています。 良い"}, {"type": "subtitle", "time": 387.029, "timestamp": "00:06:27", "text": "ゲームだといいな。"}, {"type": "subtitle", "time": 389.51, "timestamp": "00:06:29", "text": "ええ、そうですね。"}, {"type": "subtitle", "time": 393.909, "timestamp": "00:06:33", "text": "私のPCが対応していれば、彼女はそう思うだろう。"}, {"type": "subtitle", "time": 396.23, "timestamp": "00:06:36", "text": "アップデートとか色々あるなんて言わないでくれよ"}, {"type": "subtitle", "time": 413.189, "timestamp": "00:06:53", "text": "ネットワークエラーが発生しました。もう一度お試しください。 想像してみてください。"}, {"type": "subtitle", "time": 415.35, "timestamp": "00:06:55", "text": "配信を開始したのに、ゲームがプレイできないとします"}, {"type": "subtitle", "time": 419.83, "timestamp": "00:06:59", "text": "。 ああ、それは大変だ。"}]
[{"type": "subtitle", "time": 7747.27, "timestamp": "02:09:07", "text": "スピーチのために。彼女は"}, {"type": "subtitle", "time": 7779.27, "timestamp": "02:09:39", "text": "。"}, {"type": "subtitle", "time": 7780.149, "timestamp": "02:09:40", "text": "ええ。"}, {"type": "subtitle", "time": 7782.55, "timestamp": "02:09:42", "text": "涙を間違えましたか？ やったよ"}, {"type": "subtitle", "time": 7784.87, "timestamp": "02:09:44", "text": "。待って。"}, {"type": "subtitle", "time": 7791.109, "timestamp": "02:09:51", "text": "音声がよく聞こえないからよくわからない。つまり、インス"}, {"type": "subtitle", "time": 7792.79, "timestamp": "02:09:52", "text": "トゥルメンタルの音声がわからないってこと。"}, {"type": "subtitle", "time": 7795.43, "timestamp": "02:09:55", "text": "そういうこと。"}, {"type": "subtitle", "time": 7799.35, "timestamp": "02:09:59", "text": "よくわからない。どうすればいいの？"}]
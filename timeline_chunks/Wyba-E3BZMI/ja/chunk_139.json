[{"type": "subtitle", "time": 8340.15, "timestamp": "02:19:00", "text": "。"}, {"type": "subtitle", "time": 8350.15, "timestamp": "02:19:10", "text": "こんにちは、素敵な夜を。"}, {"type": "subtitle", "time": 8356.709, "timestamp": "02:19:16", "text": "残りの"}, {"type": "subtitle", "time": 8358.709, "timestamp": "02:19:18", "text": "配信も頑張ってね。配信を続けるつもり？うん、続けるよね"}, {"type": "subtitle", "time": 8360.549, "timestamp": "02:19:20", "text": "？うん"}, {"type": "subtitle", "time": 8363.349, "timestamp": "02:19:23", "text": "、続けるよ。"}, {"type": "subtitle", "time": 8365.429, "timestamp": "02:19:25", "text": "いつも思うんだけど、声が"}, {"type": "subtitle", "time": 8367.75, "timestamp": "02:19:27", "text": "疲れないの？"}, {"type": "subtitle", "time": 8370.15, "timestamp": "02:19:30", "text": "いや、1時間前に始めたばかりだから"}, {"type": "subtitle", "time": 8371.669, "timestamp": "02:19:31", "text": "大丈夫。"}, {"type": "subtitle", "time": 8372.549, "timestamp": "02:19:32", "text": "うん。気のせいかもしれない"}, {"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "けど、君の声が、僕が"}, {"type": "subtitle", "time": 8380.87, "timestamp": "02:19:40", "text": "最初に"}, {"type": "subtitle", "time": 8383.11, "timestamp": "02:19:43", "text": "君と練習した時よりもずっと高くなった気がする。気のせいかもしれないけど"}, {"type": "subtitle", "time": 8385.589, "timestamp": "02:19:45", "text": "。"}, {"type": "subtitle", "time": 8387.99, "timestamp": "02:19:47", "text": "実際、声が高くなったよね。 え、本当に？"}, {"type": "subtitle", "time": 8390.87, "timestamp": "02:19:50", "text": "うん。うん。うん、そうだね。それに、"}, {"type": "subtitle", "time": 8393.11, "timestamp": "02:19:53", "text": "もっとパリッとしてる。"}, {"type": "subtitle", "time": 8394.79, "timestamp": "02:19:54", "text": "あぁ、"}, {"type": "subtitle", "time": 8397.51, "timestamp": "02:19:57", "text": "パリッとするのは良くないのかな？わから"}, {"type": "subtitle", "time": 8398.07, "timestamp": "02:19:58", "text": "ない。いや、違う。"}]
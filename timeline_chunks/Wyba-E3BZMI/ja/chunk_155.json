[{"type": "subtitle", "time": 9307.21, "timestamp": "02:35:07", "text": "。さあ。"}, {"type": "subtitle", "time": 9329.51, "timestamp": "02:35:29", "text": "わかった、パンフレットを閉じて、遊べるように。"}, {"type": "subtitle", "time": 9331.19, "timestamp": "02:35:31", "text": "世界を照らすために来たんだ。"}, {"type": "subtitle", "time": 9333.19, "timestamp": "02:35:33", "text": "受動支援偵察。"}, {"type": "subtitle", "time": 9335.11, "timestamp": "02:35:35", "text": "掘り起こさないで。"}, {"type": "subtitle", "time": 9345.19, "timestamp": "02:35:45", "text": "行動の準備はできている。"}, {"type": "subtitle", "time": 9348.79, "timestamp": "02:35:48", "text": "これが私だ。わかった。よし。"}]
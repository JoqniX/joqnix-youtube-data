[{"type": "subtitle", "time": 12542.79, "timestamp": "03:29:02", "text": "手榴弾を投げろ。"}, {"type": "subtitle", "time": 12555.03, "timestamp": "03:29:15", "text": "扇動的な上方。"}, {"type": "subtitle", "time": 12557.99, "timestamp": "03:29:17", "text": "私の塔は守ってくれる。"}, {"type": "subtitle", "time": 12575.429, "timestamp": "03:29:35", "text": "ここでは2つのチームが戦っている。   何てことだ"}, {"type": "subtitle", "time": 12581.83, "timestamp": "03:29:41", "text": "敵の装甲が破壊された。 再装填中。"}, {"type": "subtitle", "time": 12592.309, "timestamp": "03:29:52", "text": "的中。 最高の"}]
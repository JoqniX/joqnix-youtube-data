[{"type": "subtitle", "time": 6181.99, "timestamp": "01:43:01", "text": "1月だ。"}, {"type": "subtitle", "time": 6183.35, "timestamp": "01:43:03", "text": "1月。"}, {"type": "subtitle", "time": 6184.95, "timestamp": "01:43:04", "text": "うん。"}, {"type": "subtitle", "time": 6187.189, "timestamp": "01:43:07", "text": "ああ。 そうそう。 その時、あなたは"}, {"type": "subtitle", "time": 6191.35, "timestamp": "01:43:11", "text": "試験を受けていたんですよね？ あなたのセッション。 はい。"}, {"type": "subtitle", "time": 6195.189, "timestamp": "01:43:15", "text": "その時こそ、試験という拷問が始まるのだ。"}, {"type": "subtitle", "time": 6196.47, "timestamp": "01:43:16", "text": "いいえ、結構です"}, {"type": "subtitle", "time": 6198.31, "timestamp": "01:43:18", "text": "。 それでは、"}, {"type": "subtitle", "time": 6201.59, "timestamp": "01:43:21", "text": "今日の練習から始めましょう。 こんにちは。 そうそう。 もう一つ"}, {"type": "subtitle", "time": 6203.51, "timestamp": "01:43:23", "text": "。 うん。 私の"}, {"type": "subtitle", "time": 6206.55, "timestamp": "01:43:26", "text": "SNSで配信を共有できますよ。 うん。"}, {"type": "subtitle", "time": 6208.31, "timestamp": "01:43:28", "text": "はい。"}, {"type": "subtitle", "time": 6212.47, "timestamp": "01:43:32", "text": "それともう一つ、"}, {"type": "subtitle", "time": 6215.189, "timestamp": "01:43:35", "text": "大学の入学手続きがあって、"}, {"type": "subtitle", "time": 6219.109, "timestamp": "01:43:39", "text": "8月"}, {"type": "subtitle", "time": 6223.35, "timestamp": "01:43:43", "text": "20日頃に行かないといけないんです。だから、"}, {"type": "subtitle", "time": 6225.83, "timestamp": "01:43:45", "text": "もし"}, {"type": "subtitle", "time": 6228.31, "timestamp": "01:43:48", "text": "土曜日か日曜日に時間があれば、その時に配信して、私が残りの部分を教えたいと思っています"}, {"type": "subtitle", "time": 6233.03, "timestamp": "01:43:53", "text": "。"}, {"type": "subtitle", "time": 6235.35, "timestamp": "01:43:55", "text": "ああ、今週の土曜日と日曜日。"}, {"type": "subtitle", "time": 6237.83, "timestamp": "01:43:57", "text": "ええ、今度の土曜日か日曜日、都合の良い"}]
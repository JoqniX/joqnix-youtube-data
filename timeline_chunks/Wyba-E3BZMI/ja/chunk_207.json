[{"type": "subtitle", "time": 12420.87, "timestamp": "03:27:00", "text": "。 そして、私が友達のところに着くときには、私を通さなければならない"}, {"type": "subtitle", "time": 12424.79, "timestamp": "03:27:04", "text": "。   お礼は結構です。"}, {"type": "subtitle", "time": 12426.87, "timestamp": "03:27:06", "text": "それが私の仕事です"}, {"type": "subtitle", "time": 12438.63, "timestamp": "03:27:18", "text": "ありがとうございます。私が"}, {"type": "subtitle", "time": 12445.75, "timestamp": "03:27:25", "text": "。"}, {"type": "subtitle", "time": 12447.99, "timestamp": "03:27:27", "text": "再装填中。 表紙に気をつけろ。"}, {"type": "subtitle", "time": 12449.91, "timestamp": "03:27:29", "text": "NASAの皆さん、大丈夫ですか？"}, {"type": "subtitle", "time": 12459.03, "timestamp": "03:27:39", "text": "危なかった。 幸いなことに、私は自分で"}, {"type": "subtitle", "time": 12464.87, "timestamp": "03:27:44", "text": "船酔いの状態ではまだかなり速く走れる"}]
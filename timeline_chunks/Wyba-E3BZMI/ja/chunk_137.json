[{"type": "subtitle", "time": 8222.309, "timestamp": "02:17:02", "text": "でも、またここにいるよ。こうやってやってるのは"}, {"type": "subtitle", "time": 8226.549, "timestamp": "02:17:06", "text": "いいことだ。"}, {"type": "subtitle", "time": 8229.509, "timestamp": "02:17:09", "text": "まだ覚えているから。"}, {"type": "subtitle", "time": 8232.23, "timestamp": "02:17:12", "text": "聞いていなくても。いや、単語一つで"}, {"type": "subtitle", "time": 8237.91, "timestamp": "02:17:17", "text": "歌詞全体を見なくても覚えられるくらい。"}, {"type": "subtitle", "time": 8239.589, "timestamp": "02:17:19", "text": "うん、"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "他の曲でもそうできるようにしないといけない"}, {"type": "subtitle", "time": 8244.309, "timestamp": "02:17:24", "text": "。勉強中なんだ。"}, {"type": "subtitle", "time": 8246.309, "timestamp": "02:17:26", "text": "うん、曲を分割する方が、"}, {"type": "subtitle", "time": 8251.99, "timestamp": "02:17:31", "text": "長い目で見ればずっと役に立つと思うよ。そうだね"}, {"type": "subtitle", "time": 8253.19, "timestamp": "02:17:33", "text": "。あと、"}, {"type": "subtitle", "time": 8258.07, "timestamp": "02:17:38", "text": "勉強するときは一度に一曲に集中してほしい。"}, {"type": "subtitle", "time": 8261.349, "timestamp": "02:17:41", "text": "うん。一度に2曲か"}, {"type": "subtitle", "time": 8264.07, "timestamp": "02:17:44", "text": "3曲なんてことしないで。1曲覚えたら"}, {"type": "subtitle", "time": 8266.95, "timestamp": "02:17:46", "text": "次の曲に進んで、"}, {"type": "subtitle", "time": 8269.19, "timestamp": "02:17:49", "text": "その2曲を歌ってから"}, {"type": "subtitle", "time": 8272.309, "timestamp": "02:17:52", "text": "次の曲に進むんだ。"}, {"type": "subtitle", "time": 8276.07, "timestamp": "02:17:56", "text": "うん、そうしてほしい。わかった、そうするよ"}, {"type": "subtitle", "time": 8279.669, "timestamp": "02:17:59", "text": "。"}]
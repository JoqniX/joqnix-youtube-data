[{"type": "subtitle", "time": 6547.03, "timestamp": "01:49:07", "text": "あなたが再び発音するときもわかります"}, {"type": "subtitle", "time": 6547.91, "timestamp": "01:49:07", "text": "。   いや。"}, {"type": "subtitle", "time": 6553.109, "timestamp": "01:49:13", "text": "ああ、なんてことだ。 わかった。   まあ"}, {"type": "subtitle", "time": 6555.51, "timestamp": "01:49:15", "text": "、だいたいそんなところかな。"}, {"type": "subtitle", "time": 6557.51, "timestamp": "01:49:17", "text": "他に間違いは見つかりませんでした。"}, {"type": "subtitle", "time": 6560.95, "timestamp": "01:49:20", "text": "歌う真珠に問題があると思うけど、"}, {"type": "subtitle", "time": 6563.59, "timestamp": "01:49:23", "text": "それ以外は大丈夫だよね"}, {"type": "subtitle", "time": 6565.03, "timestamp": "01:49:25", "text": "？   わかった"}]
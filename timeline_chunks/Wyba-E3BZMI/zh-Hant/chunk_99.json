[{"type": "subtitle", "time": 5961.109, "timestamp": "01:39:21", "text": "呃，這到底是怎麼回事？"}, {"type": "subtitle", "time": 5968.07, "timestamp": "01:39:28", "text": "好的。"}, {"type": "subtitle", "time": 5971.99, "timestamp": "01:39:31", "text": "嗯，這或許是我的密碼。  請務必是"}, {"type": "subtitle", "time": 5976.629, "timestamp": "01:39:36", "text": "那個密碼。天哪，我忘了密碼。搞什麼鬼？  不，不，不，不，不，不。別這樣"}, {"type": "subtitle", "time": 5982.55, "timestamp": "01:39:42", "text": "對我"}, {"type": "subtitle", "time": 5984.47, "timestamp": "01:39:44", "text": "。別"}, {"type": "subtitle", "time": 5986.709, "timestamp": "01:39:46", "text": "那樣做"}, {"type": "subtitle", "time": 5990.07, "timestamp": "01:39:50", "text": "。等等"}]
[{"type": "subtitle", "time": 485.029, "timestamp": "00:08:05", "text": "嗯，是的。  她想知道我"}, {"type": "subtitle", "time": 493.83, "timestamp": "00:08:13", "text": "的電腦是否支援。  別跟我說有什麼更新之類的。我真的會哭"}, {"type": "subtitle", "time": 503.589, "timestamp": "00:08:23", "text": "呃，網路錯誤，請重試。想像一下，"}, {"type": "subtitle", "time": 506.869, "timestamp": "00:08:26", "text": "我開始"}, {"type": "subtitle", "time": 509.83, "timestamp": "00:08:29", "text": "直播卻玩不了遊戲。我的天，那也太糟糕了。  我的天"}]
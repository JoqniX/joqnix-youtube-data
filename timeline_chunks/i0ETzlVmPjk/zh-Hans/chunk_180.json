[{"type": "subtitle", "time": 10816.63, "timestamp": "03:00:16", "text": "所以，我们不需要这个人。 我们不需要“是”"}, {"type": "subtitle", "time": 10818.95, "timestamp": "03:00:18", "text": "。 所以，从某种意义上说，"}, {"type": "subtitle", "time": 10822.71, "timestamp": "03:00:22", "text": "我们不需要单个游戏类型的"}, {"type": "subtitle", "time": 10825.59, "timestamp": "03:00:25", "text": "东西。 所以，我也不知道我当初为什么要做"}, {"type": "subtitle", "time": 10829.11, "timestamp": "03:00:29", "text": "这套牌，但我觉得，"}, {"type": "subtitle", "time": 10833.19, "timestamp": "03:00:33", "text": "嗯，我，我，我真的花了不少心思，"}, {"type": "subtitle", "time": 10836.23, "timestamp": "03:00:36", "text": "而且修复了大部分"}, {"type": "subtitle", "time": 10840.46, "timestamp": "03:00:40", "text": "问题。 我很庆幸我这么做了。"}]
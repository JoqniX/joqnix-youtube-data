[{"type": "subtitle", "time": 2164.23, "timestamp": "00:36:04", "text": "什么？"}, {"type": "subtitle", "time": 2167.51, "timestamp": "00:36:07", "text": "好吧。  17、19、11、12、13、8。这是一个"}, {"type": "subtitle", "time": 2170.63, "timestamp": "00:36:10", "text": "随机循环。"}, {"type": "subtitle", "time": 2173.19, "timestamp": "00:36:13", "text": "很酷。 最新直播流在"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "最底部。"}, {"type": "subtitle", "time": 2179.03, "timestamp": "00:36:19", "text": "好的。 好的。 我的天啊。 我终于做到了"}, {"type": "subtitle", "time": 2182.23, "timestamp": "00:36:22", "text": "，兄弟。"}, {"type": "subtitle", "time": 2185.589, "timestamp": "00:36:25", "text": "那甚至不到一秒钟。"}, {"type": "subtitle", "time": 2188.87, "timestamp": "00:36:28", "text": "我复制粘贴了第四部分，使之适用"}, {"type": "subtitle", "time": 2192.23, "timestamp": "00:36:32", "text": "于第四部分。 是的，但我们还"}, {"type": "subtitle", "time": 2195.109, "timestamp": "00:36:35", "text": "没有完全完成。"}, {"type": "subtitle", "time": 2197.109, "timestamp": "00:36:37", "text": "哦，是的，正如你所看到的，哦，等等。"}, {"type": "subtitle", "time": 2201.03, "timestamp": "00:36:41", "text": "幻想之塔第三代。 嗯？"}, {"type": "subtitle", "time": 2205.109, "timestamp": "00:36:45", "text": "等等，那东西本来就应该在那里吗？"}, {"type": "subtitle", "time": 2209.349, "timestamp": "00:36:49", "text": "为什么《幻想之塔》会出现在这里？"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "等等，等等，等等，等等，等等，等等，"}, {"type": "subtitle", "time": 2213.99, "timestamp": "00:36:53", "text": "等等。 为什么会有《幻想之塔》和《"}, {"type": "subtitle", "time": 2216.15, "timestamp": "00:36:56", "text": "原神》的播放列表？"}, {"type": "subtitle", "time": 2219.829, "timestamp": "00:36:59", "text": "耽误。 等一下。"}]
[{"type": "subtitle", "time": 16200.469, "timestamp": "04:30:00", "text": "H"}, {"type": "subtitle", "time": 16209.83, "timestamp": "04:30:09", "text": "这话我说不出口。"}, {"type": "subtitle", "time": 16219.429, "timestamp": "04:30:19", "text": "打电话叫它，"}, {"type": "subtitle", "time": 16240.229, "timestamp": "04:30:40", "text": "[音乐]"}, {"type": "subtitle", "time": 16242.71, "timestamp": "04:30:42", "text": "等等，什么场景？ 我是在对话"}, {"type": "subtitle", "time": 16255.429, "timestamp": "04:30:55", "text": "我真是太笨了。 我把它放进了其他地方。 哦，"}, {"type": "subtitle", "time": 16258.63, "timestamp": "04:30:58", "text": "怪不得它一直不起作用。"}]
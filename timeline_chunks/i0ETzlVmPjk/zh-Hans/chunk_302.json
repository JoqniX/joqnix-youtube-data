[{"type": "subtitle", "time": 18141.99, "timestamp": "05:02:21", "text": "H. 好。 好的。 好的。"}, {"type": "subtitle", "time": 18144.23, "timestamp": "05:02:24", "text": "这样可行。"}, {"type": "subtitle", "time": 18151.11, "timestamp": "05:02:31", "text": "你好。 我去睡觉了。"}, {"type": "subtitle", "time": 18154.948, "timestamp": "05:02:34", "text": "我们完成了一半。 没关系。 我"}, {"type": "subtitle", "time": 18157.03, "timestamp": "05:02:37", "text": "稍后会处理这件事。 好的。 太晚了。   现在"}, {"type": "subtitle", "time": 18161.27, "timestamp": "05:02:41", "text": "12点了，我要睡觉了。 好的。 呃，我的"}, {"type": "subtitle", "time": 18163.99, "timestamp": "05:02:43", "text": "嗓子好痛。 我还有"}, {"type": "subtitle", "time": 18165.56, "timestamp": "05:02:45", "text": "7个小时就要起床了。"}, {"type": "subtitle", "time": 18167.35, "timestamp": "05:02:47", "text": "[音乐]"}, {"type": "subtitle", "time": 18170.23, "timestamp": "05:02:50", "text": "不过，还是要感谢所有"}, {"type": "subtitle", "time": 18173.35, "timestamp": "05:02:53", "text": "坚持到最后的人们。 很抱歉，我"}, {"type": "subtitle", "time": 18177.43, "timestamp": "05:02:57", "text": "觉得今天的节目对很多人来说太无聊了"}]
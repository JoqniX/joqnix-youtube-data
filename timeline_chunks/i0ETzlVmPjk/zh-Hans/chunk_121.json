[{"type": "subtitle", "time": 7263.83, "timestamp": "02:01:03", "text": "这个人在这里，这个人也在这里。"}, {"type": "subtitle", "time": 7266.55, "timestamp": "02:01:06", "text": "我该如何区分这"}, {"type": "subtitle", "time": 7269.75, "timestamp": "02:01:09", "text": "两者呢？顺便"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "如何区分这两者呢？"}, {"type": "subtitle", "time": 7289.51, "timestamp": "02:01:29", "text": "嗯，好吧，我先给手机充电，刚才"}, {"type": "subtitle", "time": 7296.39, "timestamp": "02:01:36", "text": "我的嗓子有点疼。"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "这个人。 复制它。"}, {"type": "subtitle", "time": 7314.55, "timestamp": "02:01:54", "text": "哦，是的。 是的。 我们还需要标题"}, {"type": "subtitle", "time": 7319.189, "timestamp": "02:01:59", "text": "。 所以，我们要做 TTV"}]
[{"type": "subtitle", "time": 12312.15, "timestamp": "03:25:12", "text": "我可以在太空旁边做乔。"}, {"type": "subtitle", "time": 12315.429, "timestamp": "03:25:15", "text": "我是在用GPD做教程吗？"}, {"type": "subtitle", "time": 12319.429, "timestamp": "03:25:19", "text": "你好，Vex。 欢迎，兄弟。"}, {"type": "subtitle", "time": 12321.75, "timestamp": "03:25:21", "text": "我当时想说的是“谢谢你"}, {"type": "subtitle", "time": 12324.15, "timestamp": "03:25:24", "text": "提醒我多喝水”。 我当时在做一个类似V字形"}, {"type": "subtitle", "time": 12327.51, "timestamp": "03:25:27", "text": "循环的东西。"}, {"type": "subtitle", "time": 12329.51, "timestamp": "03:25:29", "text": "我们真的完成了。 只是"}, {"type": "subtitle", "time": 12332.79, "timestamp": "03:25:32", "text": "YouTube 对嵌入方式做了一些更改"}, {"type": "subtitle", "time": 12335.03, "timestamp": "03:25:35", "text": "。"}, {"type": "subtitle", "time": 12339.269, "timestamp": "03:25:39", "text": "举个例子，如果我尝试复制"}, {"type": "subtitle", "time": 12343.67, "timestamp": "03:25:43", "text": "一个嵌入链接到像 Vivaldi 这样的普通网站，就会"}, {"type": "subtitle", "time": 12347.19, "timestamp": "03:25:47", "text": "出现 553 错误。"}, {"type": "subtitle", "time": 12349.91, "timestamp": "03:25:49", "text": "所以就像 Twitch 一样，现在你必须"}, {"type": "subtitle", "time": 12352.71, "timestamp": "03:25:52", "text": "输入参考信息和来源信息，你"}, {"type": "subtitle", "time": 12356.55, "timestamp": "03:25:56", "text": "必须输入你的域名或其他什么信息。   是的"}, {"type": "subtitle", "time": 12359.83, "timestamp": "03:25:59", "text": "。 所以今天我们把它弄成了这样，嗯，"}]
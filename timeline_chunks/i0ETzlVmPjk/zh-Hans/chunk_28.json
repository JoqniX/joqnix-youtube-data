[{"type": "subtitle", "time": 1681.35, "timestamp": "00:28:01", "text": "然后我们就得到了 YouTube 链接，也就是"}, {"type": "subtitle", "time": 1685.35, "timestamp": "00:28:05", "text": "第一批视频，对吧？"}, {"type": "subtitle", "time": 1688.549, "timestamp": "00:28:08", "text": "这是第一个视频系列。 所以如果我……"}, {"type": "subtitle", "time": 1692.789, "timestamp": "00:28:12", "text": "呃，演奏这个H。哦我的天哪。"}, {"type": "subtitle", "time": 1696.47, "timestamp": "00:28:16", "text": "为什么？ 它为什么坏了？"}, {"type": "subtitle", "time": 1705.029, "timestamp": "00:28:25", "text": "，等等。"}, {"type": "subtitle", "time": 1713.909, "timestamp": "00:28:33", "text": "好的，这是三年前的Arc生存直播"}, {"type": "subtitle", "time": 1717.35, "timestamp": "00:28:37", "text": "，对吧？ 是的，情况一样"}, {"type": "subtitle", "time": 1720.389, "timestamp": "00:28:40", "text": "。 它的第一条流是这样的，"}, {"type": "subtitle", "time": 1723.19, "timestamp": "00:28:43", "text": "第二条、第三条、第四条、第五条流也是如此。"}, {"type": "subtitle", "time": 1725.43, "timestamp": "00:28:45", "text": "所以基本上，我们得到的是一个随机"}, {"type": "subtitle", "time": 1727.51, "timestamp": "00:28:47", "text": "播放列表，"}, {"type": "subtitle", "time": 1729.909, "timestamp": "00:28:49", "text": "但不知何故它不起作用，所以基本上我们会"}, {"type": "subtitle", "time": 1733.19, "timestamp": "00:28:53", "text": "复制粘贴相同的系统，"}, {"type": "subtitle", "time": 1736.789, "timestamp": "00:28:56", "text": "并将其应用到我们新的"}]
[{"type": "subtitle", "time": 4502.95, "timestamp": "01:15:02", "text": "切换到了这个呃……场景。 它会"}, {"type": "subtitle", "time": 4505.99, "timestamp": "01:15:05", "text": "播放一段随机的旁白，对吧？ 它"}, {"type": "subtitle", "time": 4509.99, "timestamp": "01:15:09", "text": "以前就是这么做的，对吧？ 所以基本上，基本上，"}, {"type": "subtitle", "time": 4514.149, "timestamp": "01:15:14", "text": "基本上，呃，就像"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "我平时直播的时候，"}, {"type": "subtitle", "time": 4518.07, "timestamp": "01:15:18", "text": "比如说，"}, {"type": "subtitle", "time": 4519.83, "timestamp": "01:15:19", "text": "假设我今天玩《Genchin Impact》"}, {"type": "subtitle", "time": 4521.669, "timestamp": "01:15:21", "text": "，对吧？ 这是《原钦》的"}, {"type": "subtitle", "time": 4523.91, "timestamp": "01:15:23", "text": "直播，我正在玩游戏，现在"}, {"type": "subtitle", "time": 4526.47, "timestamp": "01:15:26", "text": "休息一会儿，希望正在"}, {"type": "subtitle", "time": 4529.75, "timestamp": "01:15:29", "text": "观看我直播的观众不要"}, {"type": "subtitle", "time": 4531.75, "timestamp": "01:15:31", "text": "离开。 他们仍然可以"}, {"type": "subtitle", "time": 4534.47, "timestamp": "01:15:34", "text": "享受《Genchin Impact》带来的乐趣，因为"}, {"type": "subtitle", "time": 4537.27, "timestamp": "01:15:37", "text": "他们来这里就是为了体验这种乐趣，对吧？ 所以，当我"}, {"type": "subtitle", "time": 4539.91, "timestamp": "01:15:39", "text": "休息的时候，我可以随机播放一段《"}, {"type": "subtitle", "time": 4543.27, "timestamp": "01:15:43", "text": "Genchin Impact》的录像，对吧？ 因为我"}, {"type": "subtitle", "time": 4546.229, "timestamp": "01:15:46", "text": "在 YouTube 上的所有直播，无论我"}, {"type": "subtitle", "time": 4547.75, "timestamp": "01:15:47", "text": "玩什么游戏，都会出现在播放列表中，"}, {"type": "subtitle", "time": 4551.43, "timestamp": "01:15:51", "text": "对吧？ 所以，我在这里实现了我"}, {"type": "subtitle", "time": 4554.709, "timestamp": "01:15:54", "text": "之前做的设置，我正在尝试让它"}, {"type": "subtitle", "time": 4558.07, "timestamp": "01:15:58", "text": "像基于类别或播放列表一样。 于是，"}]
[{"type": "subtitle", "time": 6242.55, "timestamp": "01:44:02", "text": "好的，回到我们刚才说的这件事。 所以"}, {"type": "subtitle", "time": 6245.43, "timestamp": "01:44:05", "text": "我要做的就是把它变量化。"}, {"type": "subtitle", "time": 6248.55, "timestamp": "01:44:08", "text": "所以，呃，下忍冲击对吧。 所以它会"}, {"type": "subtitle", "time": 6252.95, "timestamp": "01:44:12", "text": "变成这样：这个列表等于……"}, {"type": "subtitle", "time": 6257.03, "timestamp": "01:44:17", "text": "美元符号粘贴它点……"}, {"type": "subtitle", "time": 6270.629, "timestamp": "01:44:30", "text": "我们稍后再进行字符串"}, {"type": "subtitle", "time": 6273.51, "timestamp": "01:44:33", "text": "操作。 目前，我就先这样吧"}, {"type": "subtitle", "time": 6276.149, "timestamp": "01:44:36", "text": "。 我觉得这事儿应该没"}, {"type": "subtitle", "time": 6279.189, "timestamp": "01:44:39", "text": "问题。"}, {"type": "subtitle", "time": 6286.07, "timestamp": "01:44:46", "text": "所以，"}, {"type": "subtitle", "time": 6289.03, "timestamp": "01:44:49", "text": "呃，等等，等等，等等，等等。 所以，是"}, {"type": "subtitle", "time": 6292.87, "timestamp": "01:44:52", "text": "原神，对吧？ 所以，Apex 又来了"}, {"type": "subtitle", "time": 6295.75, "timestamp": "01:44:55", "text": "。 好的。 复制该变量的路径，"}]
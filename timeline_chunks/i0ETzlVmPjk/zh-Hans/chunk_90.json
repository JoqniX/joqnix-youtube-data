[{"type": "subtitle", "time": 5401.51, "timestamp": "01:30:01", "text": "Joathon 活动，对吧？ 我这样做是"}, {"type": "subtitle", "time": 5403.27, "timestamp": "01:30:03", "text": "为了 Joathon，"}, {"type": "subtitle", "time": 5406.55, "timestamp": "01:30:06", "text": "因为我当时不在直播。 我当时在外面，"}, {"type": "subtitle", "time": 5409.27, "timestamp": "01:30:09", "text": "这样我就可以用手机打开 Notion 应用了。 我可以"}, {"type": "subtitle", "time": 5411.59, "timestamp": "01:30:11", "text": "直接勾选这个。 看过"}, {"type": "subtitle", "time": 5414.39, "timestamp": "01:30:14", "text": "我以前直播的人都知道，"}, {"type": "subtitle", "time": 5417.59, "timestamp": "01:30:17", "text": "Jo 不在家。 这是一块"}, {"type": "subtitle", "time": 5420.87, "timestamp": "01:30:20", "text": "板子。 这不是直播。 是的，随着时间的推移，"}, {"type": "subtitle", "time": 5424.79, "timestamp": "01:30:24", "text": "我们对这个系统进行了更好的迭代"}, {"type": "subtitle", "time": 5426.709, "timestamp": "01:30:26", "text": "。   是的，"}, {"type": "subtitle", "time": 5429.35, "timestamp": "01:30:29", "text": "我分心了。 对不起。 我们"}, {"type": "subtitle", "time": 5432.07, "timestamp": "01:30:32", "text": "应该对YouTube播放列表进行"}, {"type": "subtitle", "time": 5435.59, "timestamp": "01:30:35", "text": "评论。 我分心了。 我当时以为"}, {"type": "subtitle", "time": 5439.51, "timestamp": "01:30:39", "text": "自己被困在书呆子的世界里了。"}, {"type": "subtitle", "time": 5441.51, "timestamp": "01:30:41", "text": "嗯，"}, {"type": "subtitle", "time": 5452.07, "timestamp": "01:30:52", "text": "好的。 所以，呃，回来后我会检查我的"}, {"type": "subtitle", "time": 5454.95, "timestamp": "01:30:54", "text": "Twitch 分类，如果"}, {"type": "subtitle", "time": 5457.669, "timestamp": "01:30:57", "text": "它检查了我的 Twitch 分类，并且"}]
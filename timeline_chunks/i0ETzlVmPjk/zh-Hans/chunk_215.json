[{"type": "subtitle", "time": 12900.309, "timestamp": "03:35:00", "text": "检查一次我的 YouTube 频道（"}, {"type": "subtitle", "time": 12904.309, "timestamp": "03:35:04", "text": "如果我没记错的话），对吧，就是每小时一次，"}, {"type": "subtitle", "time": 12906.469, "timestamp": "03:35:06", "text": "让我确认一下，是"}, {"type": "subtitle", "time": 12909.59, "timestamp": "03:35:09", "text": "的，每小时一次，而且这个命令会一直"}, {"type": "subtitle", "time": 12911.59, "timestamp": "03:35:11", "text": "运行。"}, {"type": "subtitle", "time": 12915.19, "timestamp": "03:35:15", "text": "这是一个特殊情况，"}, {"type": "subtitle", "time": 12920.07, "timestamp": "03:35:20", "text": "它会使用 YouTube API 获取"}, {"type": "subtitle", "time": 12922.87, "timestamp": "03:35:22", "text": "所有已安排的直播流，"}, {"type": "subtitle", "time": 12929.429, "timestamp": "03:35:29", "text": "而且它正在运行吗？ 是的，它会显示"}, {"type": "subtitle", "time": 12932.55, "timestamp": "03:35:32", "text": "一整套信息，比如"}, {"type": "subtitle", "time": 12935.59, "timestamp": "03:35:35", "text": "即将发布的描述、时间、缩略图、"}, {"type": "subtitle", "time": 12939.99, "timestamp": "03:35:39", "text": "标题和视频 ID。 所以，一共五"}, {"type": "subtitle", "time": 12942.87, "timestamp": "03:35:42", "text": "组数据。 是的，我这里有"}, {"type": "subtitle", "time": 12945.99, "timestamp": "03:35:45", "text": "开始时间之类的信息。 是的"}, {"type": "subtitle", "time": 12948.469, "timestamp": "03:35:48", "text": "，我还做了大概 11 个东西。 这个"}, {"type": "subtitle", "time": 12951.67, "timestamp": "03:35:51", "text": "按钮"}, {"type": "subtitle", "time": 12954.389, "timestamp": "03:35:54", "text": "原本是用来触发 Discord 活动的，就是"}, {"type": "subtitle", "time": 12957.349, "timestamp": "03:35:57", "text": "这个。 这样，当我在线时，系统会自动创建"}, {"type": "subtitle", "time": 12959.67, "timestamp": "03:35:59", "text": "一个 Discord 事件"}]
[{"type": "subtitle", "time": 14473.59, "timestamp": "04:01:13", "text": "那么会发送什么呢？"}, {"type": "subtitle", "time": 14480.07, "timestamp": "04:01:20", "text": "最后要再次发送的内容是什么"}, {"type": "subtitle", "time": 14486.309, "timestamp": "04:01:26", "text": "好的，上面那部分我们不用担心"}, {"type": "subtitle", "time": 14488.79, "timestamp": "04:01:28", "text": "。"}, {"type": "subtitle", "time": 14491.269, "timestamp": "04:01:31", "text": "所以上半部分我们不用"}, {"type": "subtitle", "time": 14495.11, "timestamp": "04:01:35", "text": "担心。 这就是"}, {"type": "subtitle", "time": 14499.11, "timestamp": "04:01:39", "text": "我频道想要的东西。 好的。"}, {"type": "subtitle", "time": 14514.229, "timestamp": "04:01:54", "text": "。 这个人。"}, {"type": "subtitle", "time": 14516.95, "timestamp": "04:01:56", "text": "我想我会把它复制粘贴到这里。 然后"}]
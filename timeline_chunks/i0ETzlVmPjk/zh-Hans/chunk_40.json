[{"type": "subtitle", "time": 2400.95, "timestamp": "00:40:00", "text": "我的类别。 我总是在"}, {"type": "subtitle", "time": 2404.71, "timestamp": "00:40:04", "text": "Kick的VTuber分类下浏览，对吧？"}, {"type": "subtitle", "time": 2406.47, "timestamp": "00:40:06", "text": "是的，我总是在Kick的VTuber分类"}, {"type": "subtitle", "time": 2409.75, "timestamp": "00:40:09", "text": "下浏览。 所以踢球并不重要，对吧？"}, {"type": "subtitle", "time": 2411.99, "timestamp": "00:40:11", "text": "所以这就是我优先考虑"}, {"type": "subtitle", "time": 2415.67, "timestamp": "00:40:15", "text": "Twitch 的原因。 所以从某种意义上说，我们可以让它奏效。"}, {"type": "subtitle", "time": 2417.91, "timestamp": "00:40:17", "text": "如果我们检查的是 Twitch，那应该没问题吧"}, {"type": "subtitle", "time": 2421.829, "timestamp": "00:40:21", "text": "？ 所以，下一个版本，比如"}, {"type": "subtitle", "time": 2424.55, "timestamp": "00:40:24", "text": "我想让它具备以下功能："}, {"type": "subtitle", "time": 2427.27, "timestamp": "00:40:27", "text": "假设我"}, {"type": "subtitle", "time": 2432.47, "timestamp": "00:40:32", "text": "在我的电脑上打开一个游戏，它会"}, {"type": "subtitle", "time": 2435.75, "timestamp": "00:40:35", "text": "检查正在打开的是什么游戏。如果"}, {"type": "subtitle", "time": 2440.87, "timestamp": "00:40:40", "text": "是我想要的特定游戏，我想让它"}, {"type": "subtitle", "time": 2446.87, "timestamp": "00:40:46", "text": "在 Twitch 上自动更改类别，"}, {"type": "subtitle", "time": 2450.39, "timestamp": "00:40:50", "text": "例如，我打开 Genshin Impact.exe。"}, {"type": "subtitle", "time": 2452.63, "timestamp": "00:40:52", "text": "它会把我的游戏分类改成原神"}, {"type": "subtitle", "time": 2455.349, "timestamp": "00:40:55", "text": "。"}]
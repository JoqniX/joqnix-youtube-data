[{"type": "subtitle", "time": 9121.59, "timestamp": "02:32:01", "text": "。 だから、"}, {"type": "subtitle", "time": 9140.309, "timestamp": "02:32:20", "text": "ええ、"}, {"type": "subtitle", "time": 9146.469, "timestamp": "02:32:26", "text": "ライブ配信中かどうかに関わらず。 うん、"}, {"type": "subtitle", "time": 9148.07, "timestamp": "02:32:28", "text": "君には走り続けてほしい。 うん。 うん。"}, {"type": "subtitle", "time": 9158.63, "timestamp": "02:32:38", "text": "さて、ここで「ジョー、なぜ"}, {"type": "subtitle", "time": 9160.71, "timestamp": "02:32:40", "text": "これに別のボタンが必要なの？」と疑問に思う人もいるでしょう。 なぜ"}, {"type": "subtitle", "time": 9164.469, "timestamp": "02:32:44", "text": "それを1つのボタンに統合できないのですか？"}, {"type": "subtitle", "time": 9166.469, "timestamp": "02:32:46", "text": "右。 良い質問ですね。 もし"}, {"type": "subtitle", "time": 9168.95, "timestamp": "02:32:48", "text": "考えたことがあるなら、そう、"}, {"type": "subtitle", "time": 9171.67, "timestamp": "02:32:51", "text": "これらではなく、私はそれ用のデッキを作りました。 だから、ある意味"}, {"type": "subtitle", "time": 9174.309, "timestamp": "02:32:54", "text": "、この人が最高"}, {"type": "subtitle", "time": 9176.63, "timestamp": "02:32:56", "text": "司令官なんだと思ったんです。"}, {"type": "subtitle", "time": 9178.87, "timestamp": "02:32:58", "text": "必要ないと思います。"}]
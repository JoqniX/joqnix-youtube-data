[{"type": "subtitle", "time": 14473.59, "timestamp": "04:01:13", "text": "では、何が送信されるのでしょうか？"}, {"type": "subtitle", "time": 14480.07, "timestamp": "04:01:20", "text": "最後に再送信されるのはどれですか"}, {"type": "subtitle", "time": 14486.309, "timestamp": "04:01:26", "text": "よし、上の部分は心配する必要はない"}, {"type": "subtitle", "time": 14488.79, "timestamp": "04:01:28", "text": "。"}, {"type": "subtitle", "time": 14491.269, "timestamp": "04:01:31", "text": "だから、上部については"}, {"type": "subtitle", "time": 14495.11, "timestamp": "04:01:35", "text": "心配する必要はありません。 それが"}, {"type": "subtitle", "time": 14499.11, "timestamp": "04:01:39", "text": "私のチャンネルに必要なものです。 わかった。"}, {"type": "subtitle", "time": 14514.229, "timestamp": "04:01:54", "text": "うん。 この男。"}, {"type": "subtitle", "time": 14516.95, "timestamp": "04:01:56", "text": "ここにコピー＆ペーストしようと思います。 そして"}]
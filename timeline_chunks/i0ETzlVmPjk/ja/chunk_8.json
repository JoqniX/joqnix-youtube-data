[{"type": "subtitle", "time": 481.99, "timestamp": "00:08:01", "text": "古いBulu"}, {"type": "subtitle", "time": 487.27, "timestamp": "00:08:07", "text": "Protocolストリームを再生しました。 右。 右。"}, {"type": "subtitle", "time": 492.869, "timestamp": "00:08:12", "text": "今日の私の目標は、"}, {"type": "subtitle", "time": 507.27, "timestamp": "00:08:27", "text": "設定されたカテゴリに基づいて、自動化された自動YouTubeプレイリストワードサイクルシステムを作成することです。 つまり、簡単に言うと、"}, {"type": "subtitle", "time": 511.27, "timestamp": "00:08:31", "text": "私が配信するストリームは、どんなストリームでも"}, {"type": "subtitle", "time": 513.99, "timestamp": "00:08:33", "text": "常に"}, {"type": "subtitle", "time": 516.63, "timestamp": "00:08:36", "text": "YouTubeのプレイリストに含まれます。だから私の"}, {"type": "subtitle", "time": 518.949, "timestamp": "00:08:38", "text": "YouTubeチャンネルにはたくさんの"}, {"type": "subtitle", "time": 522.23, "timestamp": "00:08:42", "text": "プレイリストがあり、私がプレイするすべてのゲーム、"}, {"type": "subtitle", "time": 527.11, "timestamp": "00:08:47", "text": "チャットや共同作業ストリームのような通常のカジュアルなストリームはすべて、"}, {"type": "subtitle", "time": 530.07, "timestamp": "00:08:50", "text": "今日のストリーム「Work with me」ストリームのように"}, {"type": "subtitle", "time": 533.67, "timestamp": "00:08:53", "text": "共同作業プレイリストに含まれます"}, {"type": "subtitle", "time": 536.55, "timestamp": "00:08:56", "text": "。 だから私は何でもプレイリストにするのが好きなんです"}, {"type": "subtitle", "time": 539.03, "timestamp": "00:08:59", "text": "。 つまり、私のコンテンツはすべて"}]
[{"type": "subtitle", "time": 2167.51, "timestamp": "00:36:07", "text": "。  17、19、11、12、13、8。これは"}, {"type": "subtitle", "time": 2170.63, "timestamp": "00:36:10", "text": "ランダムなサイクルです。"}, {"type": "subtitle", "time": 2173.19, "timestamp": "00:36:13", "text": "かっこよかった。 最新の配信は一番"}, {"type": "subtitle", "time": 2175.589, "timestamp": "00:36:15", "text": "下にあります。   わかった"}, {"type": "subtitle", "time": 2179.03, "timestamp": "00:36:19", "text": "。 ニース。 何てことだ。 ついにやったぜ"}, {"type": "subtitle", "time": 2182.23, "timestamp": "00:36:22", "text": "、兄弟。"}, {"type": "subtitle", "time": 2185.589, "timestamp": "00:36:25", "text": "それはほんの一瞬の出来事だった。"}, {"type": "subtitle", "time": 2188.87, "timestamp": "00:36:28", "text": "4番目の部分をコピー＆ペーストして、4番目の部分に合うようにしました"}, {"type": "subtitle", "time": 2192.23, "timestamp": "00:36:32", "text": "。 ええ、でもまだ"}, {"type": "subtitle", "time": 2195.109, "timestamp": "00:36:35", "text": "完全に終わったわけではありません。   ああ"}, {"type": "subtitle", "time": 2197.109, "timestamp": "00:36:37", "text": "、ご覧のとおり、ああ、待って。"}, {"type": "subtitle", "time": 2201.03, "timestamp": "00:36:41", "text": "ファンタジータワー第3世代。 はぁ？"}, {"type": "subtitle", "time": 2205.109, "timestamp": "00:36:45", "text": "待って、あれってそこにあるべきものだったの？"}, {"type": "subtitle", "time": 2209.349, "timestamp": "00:36:49", "text": "なぜタワー・オブ・ファンタジーがこれに含まれているのですか？"}, {"type": "subtitle", "time": 2210.87, "timestamp": "00:36:50", "text": "待って、待って、待って、待って、待って、待って、"}, {"type": "subtitle", "time": 2213.99, "timestamp": "00:36:53", "text": "待って。  「タワー・オブ・ファンタジー」と「"}, {"type": "subtitle", "time": 2216.15, "timestamp": "00:36:56", "text": "原神」がプレイリストに含まれているのはなぜですか？"}, {"type": "subtitle", "time": 2219.829, "timestamp": "00:36:59", "text": "我慢する。 ちょっと待って。"}]
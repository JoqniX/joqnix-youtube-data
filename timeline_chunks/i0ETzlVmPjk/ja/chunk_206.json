[{"type": "subtitle", "time": 12363.91, "timestamp": "03:26:03", "text": "私の以前のセットアップはこんな感じでした。"}, {"type": "subtitle", "time": 12366.63, "timestamp": "03:26:06", "text": "以前の私の設定はこんな感じでした。"}, {"type": "subtitle", "time": 12369.83, "timestamp": "03:26:09", "text": "OBSまたはMeltでシーンを切り替えます。 私はもうOBSではなくMeltを使っています"}, {"type": "subtitle", "time": 12373.349, "timestamp": "03:26:13", "text": "。 そこで、"}, {"type": "subtitle", "time": 12375.59, "timestamp": "03:26:15", "text": "私は「すぐ戻ります」シーンに切り替えます。 それは、私が以前"}, {"type": "subtitle", "time": 12382.309, "timestamp": "03:26:22", "text": "手動で行っていたように、私のすべての Twitch ビデオをスキャンして生成します"}, {"type": "subtitle", "time": 12386.469, "timestamp": "03:26:26", "text": "。 ええ、以前は古い設定で、"}, {"type": "subtitle", "time": 12394.15, "timestamp": "03:26:34", "text": "YouTubeの動画やストリームをすべて手動でこのように設定していました。ええ、"}, {"type": "subtitle", "time": 12397.59, "timestamp": "03:26:37", "text": "ランダムなVODが再生されます。 つまり、"}, {"type": "subtitle", "time": 12403.03, "timestamp": "03:26:43", "text": "ランダムなタイムスタンプからランダムなVODを再生し、"}, {"type": "subtitle", "time": 12409.19, "timestamp": "03:26:49", "text": "その設定の3回目の反復も行います。 それは、"}, {"type": "subtitle", "time": 12412.309, "timestamp": "03:26:52", "text": "30本の動画を含むランダムなプレイリストを作成します。"}, {"type": "subtitle", "time": 12414.389, "timestamp": "03:26:54", "text": "つまり、"}, {"type": "subtitle", "time": 12417.269, "timestamp": "03:26:57", "text": "YouTube上の私のすべての配信や動画から、"}, {"type": "subtitle", "time": 12419.51, "timestamp": "03:26:59", "text": "このようにランダムなプレイリストを作成するということですね。 だから、私が"}]
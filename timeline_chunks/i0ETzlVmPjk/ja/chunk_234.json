[{"type": "subtitle", "time": 14042.229, "timestamp": "03:54:02", "text": "子供の頃に、もし望むなら、"}, {"type": "subtitle", "time": 14046.63, "timestamp": "03:54:06", "text": "これらの"}, {"type": "subtitle", "time": 14049.75, "timestamp": "03:54:09", "text": "生成されたストリームの1つをチェックしたいと思ったことがある人は。 いいえ。あ、待って、"}, {"type": "subtitle", "time": 14053.269, "timestamp": "03:54:13", "text": "生成されませんでした。 何？"}, {"type": "subtitle", "time": 14055.67, "timestamp": "03:54:15", "text": "はぁ？"}, {"type": "subtitle", "time": 14058.63, "timestamp": "03:54:18", "text": "私は何をしたの"}, {"type": "subtitle", "time": 14062.87, "timestamp": "03:54:22", "text": "？ 私は"}, {"type": "subtitle", "time": 14069.349, "timestamp": "03:54:29", "text": "show.ioのトリガーボタンは実行しません。"}, {"type": "subtitle", "time": 14071.91, "timestamp": "03:54:31", "text": "ええ、"}, {"type": "subtitle", "time": 14075.51, "timestamp": "03:54:35", "text": "YouTubeの埋め込みリンクを作成するはずですよね？ それから"}, {"type": "subtitle", "time": 14077.189, "timestamp": "03:54:37", "text": "私は、それは"}, {"type": "subtitle", "time": 14079.75, "timestamp": "03:54:39", "text": "また壊れてしまったのか？"}, {"type": "subtitle", "time": 14082.71, "timestamp": "03:54:42", "text": "ああ、それも直さなきゃ。 わかった。"}, {"type": "subtitle", "time": 14085.75, "timestamp": "03:54:45", "text": "Shot.io。 そう、この人だよ。 いいえ、それは"}, {"type": "subtitle", "time": 14088.15, "timestamp": "03:54:48", "text": "自動化されたバージョンです。"}, {"type": "subtitle", "time": 14093.189, "timestamp": "03:54:53", "text": "shot.io ショット。 どこにいるの？"}, {"type": "subtitle", "time": 14094.95, "timestamp": "03:54:54", "text": "ああ、この人か。 いや、待って。 それが"}, {"type": "subtitle", "time": 14098.469, "timestamp": "03:54:58", "text": "自動化装置です。 待て、2人いるぞ。"}]
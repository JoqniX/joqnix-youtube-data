[{"type": "subtitle", "time": 10505.11, "timestamp": "02:55:05", "text": "待っていてください。"}, {"type": "subtitle", "time": 10509.349, "timestamp": "02:55:09", "text": "少し時間がかかります。time.io"}, {"type": "subtitle", "time": 10513.83, "timestamp": "02:55:13", "text": "に API リクエストを実行して"}, {"type": "subtitle", "time": 10518.95, "timestamp": "02:55:18", "text": "時刻を取得し、"}, {"type": "subtitle", "time": 10527.19, "timestamp": "02:55:27", "text": "私だけでしょうか、すごく時間がかかっているように感じるのですが？ こんにちは。"}, {"type": "subtitle", "time": 10529.19, "timestamp": "02:55:29", "text": "ああ、そうだ、そうだ、そうだ。 ほら、ほら、うまくいったでしょ"}, {"type": "subtitle", "time": 10536.63, "timestamp": "02:55:36", "text": "エモートは正常に動作しています。 タイムゾーン関連の機能は正常に"}, {"type": "subtitle", "time": 10538.95, "timestamp": "02:55:38", "text": "動作しています。"}, {"type": "subtitle", "time": 10546.79, "timestamp": "02:55:46", "text": "時間も機能します。"}, {"type": "subtitle", "time": 10550.55, "timestamp": "02:55:50", "text": "そして、"}, {"type": "subtitle", "time": 10554.23, "timestamp": "02:55:54", "text": "Discordでアップデートを行いました。 私"}]
[{"type": "subtitle", "time": 3663.91, "timestamp": "01:01:03", "text": "物理的なものから見ていきましょう。 いいえ、私は"}, {"type": "subtitle", "time": 3667.51, "timestamp": "01:01:07", "text": "物理的なものを持っています。 これ、"}, {"type": "subtitle", "time": 3672.39, "timestamp": "01:01:12", "text": "パソコンに接続できるMIDIピアノみたいなの持ってるんだよね？"}, {"type": "subtitle", "time": 3674.23, "timestamp": "01:01:14", "text": "楽器を演奏したり、音楽を演奏したりできるよね？"}, {"type": "subtitle", "time": 3679.27, "timestamp": "01:01:19", "text": "ピアノ。 えっと、私が昔やっていたのは、"}, {"type": "subtitle", "time": 3686.23, "timestamp": "01:01:26", "text": "Cシャープのような音符を押して"}, {"type": "subtitle", "time": 3692.87, "timestamp": "01:01:32", "text": "ゲームを開始し、Fを押してゲームを終了することでした。   えっと、えっと、"}, {"type": "subtitle", "time": 3702.71, "timestamp": "01:01:42", "text": "待ってください、Fシャープはありません、すみません、AまたはBキーはありません、"}, {"type": "subtitle", "time": 3706.15, "timestamp": "01:01:46", "text": "またはピッチまたはダイヤルを調整します。"}, {"type": "subtitle", "time": 3709.589, "timestamp": "01:01:49", "text": "A5はCを切り替えるようなもので、"}, {"type": "subtitle", "time": 3712.87, "timestamp": "01:01:52", "text": "A4は戻るようなもので、以前は"}, {"type": "subtitle", "time": 3716.15, "timestamp": "01:01:56", "text": "MIDIキーボードですべてをキーバインドしていました"}, {"type": "subtitle", "time": 3719.03, "timestamp": "01:01:59", "text": "。 それから、Sammyには音声コマンド機能があります"}]
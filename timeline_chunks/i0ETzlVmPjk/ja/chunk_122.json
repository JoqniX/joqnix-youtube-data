[{"type": "subtitle", "time": 7330.95, "timestamp": "02:02:10", "text": "ああ神様、拒否されたのはどこだ？みたいな感じでやるんだ。"}, {"type": "subtitle", "time": 7332.95, "timestamp": "02:02:12", "text": "待って、こっちに来て。"}, {"type": "subtitle", "time": 7338.79, "timestamp": "02:02:18", "text": "コピー。 この男をここに置いてくれ。"}, {"type": "subtitle", "time": 7344.709, "timestamp": "02:02:24", "text": "つまり、入力文字列は"}, {"type": "subtitle", "time": 7348.87, "timestamp": "02:02:28", "text": "このTTVタイトルになります。"}, {"type": "subtitle", "time": 7350.95, "timestamp": "02:02:30", "text": "つまり、表現のようなものを実行して、"}, {"type": "subtitle", "time": 7362.31, "timestamp": "02:02:42", "text": "TTV タイトル"}, {"type": "subtitle", "time": 7364.629, "timestamp": "02:02:44", "text": "タイトル 質問のようになります。 いや、いや。 疑問符が付く"}, {"type": "subtitle", "time": 7368.39, "timestamp": "02:02:48", "text": "と問題になる。 タイトル、"}, {"type": "subtitle", "time": 7369.92, "timestamp": "02:02:49", "text": "タイトル、 タイトル、タイトル、タイトル。"}, {"type": "subtitle", "time": 7378.55, "timestamp": "02:02:58", "text": "待って。 えーと、タイトルは"}]
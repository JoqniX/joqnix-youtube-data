[{"type": "subtitle", "time": 17643.51, "timestamp": "04:54:03", "text": "では、これをやってみましょう。 だから、"}, {"type": "subtitle", "time": 17647.99, "timestamp": "04:54:07", "text": "すごく小さいサイズを買ったつもりだったんです。 これは"}, {"type": "subtitle", "time": 17650.868, "timestamp": "04:54:10", "text": "オープンモニターです。 開いているとか、そういう感じ。 うん。"}, {"type": "subtitle", "time": 17652.47, "timestamp": "04:54:12", "text": "うん。   何か"}, {"type": "subtitle", "time": 17655.51, "timestamp": "04:54:15", "text": "。 少しの間、ミュートにします"}, {"type": "subtitle", "time": 17673.19, "timestamp": "04:54:33", "text": "変わっていないよ、兄弟。 一体どういうことだ"}]
[{"type": "subtitle", "time": 8776.07, "timestamp": "02:26:16", "text": "そして、それをここに置きます。 これで閉じます"}, {"type": "subtitle", "time": 8781.75, "timestamp": "02:26:21", "text": "。 ここに置いてください。 私もこの人が必要だ。"}, {"type": "subtitle", "time": 8783.67, "timestamp": "02:26:23", "text": "そしてそれは"}, {"type": "subtitle", "time": 8788.55, "timestamp": "02:26:28", "text": "自動ジェットplです。 いや、これは違う。 シアティック"}, {"type": "subtitle", "time": 8790.79, "timestamp": "02:26:30", "text": "シーンスイッチメルトスタジオ。 うん。 うん。"}, {"type": "subtitle", "time": 8795.19, "timestamp": "02:26:35", "text": "この男。 だから、私はこれが欲しい。"}, {"type": "subtitle", "time": 8799.03, "timestamp": "02:26:39", "text": "これらは不要です。"}, {"type": "subtitle", "time": 8803.429, "timestamp": "02:26:43", "text": "うーん、いいえ。 必要なのはそれだけです。"}, {"type": "subtitle", "time": 8806.71, "timestamp": "02:26:46", "text": "はい、それを受け取って行きます"}, {"type": "subtitle", "time": 8809.83, "timestamp": "02:26:49", "text": "。   両方をうまく"}, {"type": "subtitle", "time": 8811.99, "timestamp": "02:26:51", "text": "組み合わせる必要がある。 それでは、私が"}, {"type": "subtitle", "time": 8814.87, "timestamp": "02:26:54", "text": "現在"}, {"type": "subtitle", "time": 8818.23, "timestamp": "02:26:58", "text": "ストリーミング配信中かどうかを表示します。 はい。 そして、もし私がそうなら、"}]
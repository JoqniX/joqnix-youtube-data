[{"type": "subtitle", "time": 3241.109, "timestamp": "00:54:01", "text": "Sammy に戻って"}, {"type": "subtitle", "time": 3245.67, "timestamp": "00:54:05", "text": "ここに来ると、YouTube の"}, {"type": "subtitle", "time": 3248.95, "timestamp": "00:54:08", "text": "プレイリストは現在 ETA にあります。 そう、これだよ、"}, {"type": "subtitle", "time": 3251.91, "timestamp": "00:54:11", "text": "コワーキングスペース。 だから、"}, {"type": "subtitle", "time": 3258.309, "timestamp": "00:54:18", "text": "チャットのみに変わり、"}, {"type": "subtitle", "time": 3260.63, "timestamp": "00:54:20", "text": "チャットのみのストリームのプレイリストが表示されます"}, {"type": "subtitle", "time": 3265.27, "timestamp": "00:54:25", "text": "。 右。 だから私たちはそれを直しました。"}, {"type": "subtitle", "time": 3269.829, "timestamp": "00:54:29", "text": "ええ、私たちはただ"}, {"type": "subtitle", "time": 3272.47, "timestamp": "00:54:32", "text": "おしゃべりするプレイリストを持っています。 ほら、これが"}, {"type": "subtitle", "time": 3276.549, "timestamp": "00:54:36", "text": "私が考えていた方法なんです。だって、この方が"}, {"type": "subtitle", "time": 3279.75, "timestamp": "00:54:39", "text": "簡単そうに感じるから。 あとは、えっと、それは"}, {"type": "subtitle", "time": 3286.95, "timestamp": "00:54:46", "text": "どこにあるんだろう？ えっと、私がやるべきことは"}, {"type": "subtitle", "time": 3293.829, "timestamp": "00:54:53", "text": "私のチャンネルにアクセスして、このように"}, {"type": "subtitle", "time": 3295.589, "timestamp": "00:54:55", "text": "プレイリストを入手してください。 よし"}, {"type": "subtitle", "time": 3298.47, "timestamp": "00:54:58", "text": "。 次に、"}]
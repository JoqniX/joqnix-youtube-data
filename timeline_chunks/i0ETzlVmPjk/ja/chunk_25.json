[{"type": "subtitle", "time": 1500.549, "timestamp": "00:25:00", "text": "すべてに対して行う必要があります。"}, {"type": "subtitle", "time": 1511.11, "timestamp": "00:25:11", "text": "バージョン4.1用に作成する必要があります。"}, {"type": "subtitle", "time": 1513.43, "timestamp": "00:25:13", "text": "これは4回目の反復です。このように"}, {"type": "subtitle", "time": 1515.99, "timestamp": "00:25:15", "text": "。 私は青いプロトコル原神を持っています。"}, {"type": "subtitle", "time": 1518.87, "timestamp": "00:25:18", "text": "私が持っているすべてのカテゴリのようなプレイリストは、"}, {"type": "subtitle", "time": 1521.75, "timestamp": "00:25:21", "text": "このようにします。"}, {"type": "subtitle", "time": 1525.269, "timestamp": "00:25:25", "text": "プレイリストIDをこのように入力します。"}, {"type": "subtitle", "time": 1528.549, "timestamp": "00:25:28", "text": "基本的には、"}, {"type": "subtitle", "time": 1532.87, "timestamp": "00:25:32", "text": "以前のバージョン3と同じシステムです。これが古い"}, {"type": "subtitle", "time": 1536.31, "timestamp": "00:25:36", "text": "ボタンです。 これは一体いくつのコマンドで構成されているのでしょうか"}, {"type": "subtitle", "time": 1540.71, "timestamp": "00:25:40", "text": "？ えーと、それは419みたいなものです。ええと"}, {"type": "subtitle", "time": 1543.269, "timestamp": "00:25:43", "text": "、これは"}, {"type": "subtitle", "time": 1545.75, "timestamp": "00:25:45", "text": "私がライブ配信中かどうか、現在"}, {"type": "subtitle", "time": 1548.71, "timestamp": "00:25:48", "text": "ストリーミング中かどうか、OBSに接続しているかどうか、"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "OBSに接続していないかどうか、または"}, {"type": "subtitle", "time": 1554.549, "timestamp": "00:25:54", "text": "Meltを使用しているかどうかをスキャンします。 今日はOBSではなくMeltを使用します"}, {"type": "subtitle", "time": 1556.71, "timestamp": "00:25:56", "text": "。 つまり、私がMeltに接続されているかどうかを確認するということです"}]
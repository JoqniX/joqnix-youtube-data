[{"type": "subtitle", "time": 16803.35, "timestamp": "04:40:03", "text": "。 それはいつ起こってもおかしくない状況だ"}, {"type": "subtitle", "time": 16808.628, "timestamp": "04:40:08", "text": "。 うん。 そして、それを更新してください。"}, {"type": "subtitle", "time": 16810.788, "timestamp": "04:40:10", "text": "待っていてください。"}, {"type": "subtitle", "time": 16823.27, "timestamp": "04:40:23", "text": "ああ、わかった。 気分がリフレッシュできたと思う。 私は"}, {"type": "subtitle", "time": 16825.99, "timestamp": "04:40:25", "text": "それを見ていないか、何か事情があるようです。   わかった"}, {"type": "subtitle", "time": 16836.39, "timestamp": "04:40:36", "text": "ここで唯一の問題は、この"}, {"type": "subtitle", "time": 16838.628, "timestamp": "04:40:38", "text": "男のランダムな"}, {"type": "subtitle", "time": 16841.67, "timestamp": "04:40:41", "text": "ビデオ番号です。"}, {"type": "subtitle", "time": 16848.708, "timestamp": "04:40:48", "text": "動画IDごとに約90本の動画が生成されてしまうのですが、それは良くないことで、私はそのような事態を望んでいません"}, {"type": "subtitle", "time": 16851.83, "timestamp": "04:40:51", "text": "。 だから、ランダムに表示される"}]
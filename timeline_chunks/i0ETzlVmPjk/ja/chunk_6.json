[{"type": "subtitle", "time": 373.59, "timestamp": "00:06:13", "text": "うん。"}, {"type": "subtitle", "time": 377.43, "timestamp": "00:06:17", "text": "今日は水分補給をしっかりしないと。 それ以来、私は頻繁に"}, {"type": "subtitle", "time": 390.23, "timestamp": "00:06:30", "text": "今日は朝の小川が流れていなかったのです。 やりたかったのですが、"}, {"type": "subtitle", "time": 393.27, "timestamp": "00:06:33", "text": "今朝と夕方に出かけなければならず、"}, {"type": "subtitle", "time": 400.469, "timestamp": "00:06:40", "text": "夜に授業があると思っていたのですが、結局"}, {"type": "subtitle", "time": 403.51, "timestamp": "00:06:43", "text": "明日に変更になったので、今"}, {"type": "subtitle", "time": 406.34000000000003, "timestamp": "00:06:46", "text": "ここで"}]
[{"type": "subtitle", "time": 8374.95, "timestamp": "02:19:34", "text": "キックのためにもこれを作らなければならない"}, {"type": "subtitle", "time": 8377.27, "timestamp": "02:19:37", "text": "。 これらのボットは、私に"}, {"type": "subtitle", "time": 8380.15, "timestamp": "02:19:40", "text": "Discordで自分たちを追加するように言ってきます。"}, {"type": "subtitle", "time": 8383.27, "timestamp": "02:19:43", "text": "自動的にBANされるように設定して、"}, {"type": "subtitle", "time": 8386.87, "timestamp": "02:19:46", "text": "私のDiscordサーバーにログが残るようにする必要がある。 また、"}, {"type": "subtitle", "time": 8393.11, "timestamp": "02:19:53", "text": "モデレーターがいないため、自動的にBANされた理由をメッセージで説明しました。"}, {"type": "subtitle", "time": 8396.63, "timestamp": "02:19:56", "text": "そうですね、次回はそうしたいと思います"}]
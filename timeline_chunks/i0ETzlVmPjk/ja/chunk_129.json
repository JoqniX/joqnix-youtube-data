[{"type": "subtitle", "time": 7748.95, "timestamp": "02:09:08", "text": "保存。   走る"}, {"type": "subtitle", "time": 7755.589, "timestamp": "02:09:15", "text": "、リンクを確認してみます。"}, {"type": "subtitle", "time": 7758.55, "timestamp": "02:09:18", "text": "お願いだから、コワーキングスペースの恥を知れ。"}, {"type": "subtitle", "time": 7762.069, "timestamp": "02:09:22", "text": "お願い、お願いだから、コワーキングプレイリストにして。"}, {"type": "subtitle", "time": 7766.31, "timestamp": "02:09:26", "text": "はい。 何てことだ。 さあ行こう。 わーい。   直ったよ"}, {"type": "subtitle", "time": 7771.03, "timestamp": "02:09:31", "text": "、兄弟。 やったよ。 何てことだ。 やったよ"}, {"type": "subtitle", "time": 7773.589, "timestamp": "02:09:33", "text": "。 やったよ。 何てことだ。 つまり、"}, {"type": "subtitle", "time": 7776.87, "timestamp": "02:09:36", "text": "これで差別化ができたわけです。"}, {"type": "subtitle", "time": 7781.27, "timestamp": "02:09:41", "text": "ニース。 わかった。 ニース。 素晴らしいショーでした。 ニース。"}, {"type": "subtitle", "time": 7783.35, "timestamp": "02:09:43", "text": "私は幸せです。 わかった。 いいね、いいね、いいね、いいね。   わかった"}, {"type": "subtitle", "time": 7787.27, "timestamp": "02:09:47", "text": "。 続けて。 我々にはまだやるべきことがある。"}, {"type": "subtitle", "time": 7789.75, "timestamp": "02:09:49", "text": "これはコワーキングスペースのカテゴリーです。   わかった"}, {"type": "subtitle", "time": 7792.55, "timestamp": "02:09:52", "text": "。 ええと、コワーキングスペースと勉強スペースです。 私たちはついに両者の違いを明確に"}, {"type": "subtitle", "time": 7796.47, "timestamp": "02:09:56", "text": "区別することができました"}, {"type": "subtitle", "time": 7799.35, "timestamp": "02:09:59", "text": "。 コワーキングに関するものであれば、"}]
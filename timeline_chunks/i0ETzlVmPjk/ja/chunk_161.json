[{"type": "subtitle", "time": 9661.27, "timestamp": "02:41:01", "text": "ああ、クラッシュした。 いや。一体どういうことだ？ 一体どういうことだ"}, {"type": "subtitle", "time": 9671.75, "timestamp": "02:41:11", "text": "それに、早く寝たいんです。 明日は"}, {"type": "subtitle", "time": 9695.67, "timestamp": "02:41:35", "text": "え、さっきまで作業した内容が全部消えちゃったの"}, {"type": "subtitle", "time": 9699.11, "timestamp": "02:41:39", "text": "？ いや、違うよ。 ああ、助かった。 わかった。"}, {"type": "subtitle", "time": 9701.51, "timestamp": "02:41:41", "text": "待って、待って、待って、待って、待って。 えっと、考えよう"}, {"type": "subtitle", "time": 9703.51, "timestamp": "02:41:43", "text": "。   他に"}, {"type": "subtitle", "time": 9717.67, "timestamp": "02:41:57", "text": "[音楽]"}]
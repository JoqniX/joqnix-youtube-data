[{"type": "subtitle", "time": 11523.83, "timestamp": "03:12:03", "text": "よし、いいね。 こんにちは、ドラゴン。 ようこそ。"}, {"type": "subtitle", "time": 11527.03, "timestamp": "03:12:07", "text": "こんにちは。 ボタンを確認してみましょう。 えっと、ちゃんと"}, {"type": "subtitle", "time": 11537.59, "timestamp": "03:12:17", "text": "。 ニース。"}, {"type": "subtitle", "time": 11546.95, "timestamp": "03:12:26", "text": "そして、それを取りに行かせます。 ゆっくりしてください。 取りに行かせましょう"}, {"type": "subtitle", "time": 11555.269, "timestamp": "03:12:35", "text": "H."}, {"type": "subtitle", "time": 11558.79, "timestamp": "03:12:38", "text": "つまり、リンク"}, {"type": "subtitle", "time": 11566.389, "timestamp": "03:12:46", "text": "カテゴリのプレイリストが私のチャンネルのすべてのプレイリストをリンクするようにするということです"}, {"type": "subtitle", "time": 11568.71, "timestamp": "03:12:48", "text": "。"}, {"type": "subtitle", "time": 11571.51, "timestamp": "03:12:51", "text": "うん。 良い。"}, {"type": "subtitle", "time": 11573.359, "timestamp": "03:12:53", "text": "良い。 はい。 やっと終わった。"}, {"type": "subtitle", "time": 11576.13, "timestamp": "03:12:56", "text": "はい。 やっと終わった。 [音楽]"}]
[{"type": "subtitle", "time": 6481.189, "timestamp": "01:48:01", "text": "ええ、プレイリストは全部で138個あって、そのうち"}, {"type": "subtitle", "time": 6487.27, "timestamp": "01:48:07", "text": "公開されているのは128個だけです。 誰も。 ええ、だいたいそんな感じです"}, {"type": "subtitle", "time": 6489.75, "timestamp": "01:48:09", "text": "。 うん。"}, {"type": "subtitle", "time": 6506.95, "timestamp": "01:48:26", "text": "共同作業や"}, {"type": "subtitle", "time": 6508.95, "timestamp": "01:48:28", "text": "勉強のカテゴリでは、特に手動でやらなければならないということですよね？ 私は"}, {"type": "subtitle", "time": 6512.709, "timestamp": "01:48:32", "text": "共同作業用のプレイリストと、"}, {"type": "subtitle", "time": 6515.43, "timestamp": "01:48:35", "text": "勉強用のプレイリストを持っています。   それはまた別の"}, {"type": "subtitle", "time": 6526.53, "timestamp": "01:48:46", "text": "頭痛の種ですね。"}]
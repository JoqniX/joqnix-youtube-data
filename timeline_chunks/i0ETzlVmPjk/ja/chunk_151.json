[{"type": "subtitle", "time": 9077.83, "timestamp": "02:31:17", "text": "変数名が true と等しい場合、"}, {"type": "subtitle", "time": 9085.429, "timestamp": "02:31:25", "text": "なぜ OBS があるのですか? 私はもうOBSを使っていません"}, {"type": "subtitle", "time": 9091.83, "timestamp": "02:31:31", "text": "そこが問題なんです。"}, {"type": "subtitle", "time": 9093.91, "timestamp": "02:31:33", "text": "うん。 こちらのカスタム条件が見えますか"}, {"type": "subtitle", "time": 9097.27, "timestamp": "02:31:37", "text": "？ もし私がオフラインでライブ配信をする場合、これが"}, {"type": "subtitle", "time": 9100.79, "timestamp": "02:31:40", "text": "私の望むものです。"}, {"type": "subtitle", "time": 9103.27, "timestamp": "02:31:43", "text": "文字通り、私が欲しいものは何でも、"}, {"type": "subtitle", "time": 9106.79, "timestamp": "02:31:46", "text": "文字通りここに拡張機能として備わっている。"}, {"type": "subtitle", "time": 9109.19, "timestamp": "02:31:49", "text": "でも私は"}, {"type": "subtitle", "time": 9112.79, "timestamp": "02:31:52", "text": "OBSは使いません。 だからこれは使えません。"}]
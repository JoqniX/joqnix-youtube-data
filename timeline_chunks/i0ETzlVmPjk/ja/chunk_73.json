[{"type": "subtitle", "time": 4382.95, "timestamp": "01:13:02", "text": "それを配列にして、そのように"}, {"type": "subtitle", "time": 4388.39, "timestamp": "01:13:08", "text": "取得することです。 いいえ、"}, {"type": "subtitle", "time": 4411.43, "timestamp": "01:13:31", "text": "列化することについてはどうでしょうか？"}, {"type": "subtitle", "time": 4413.669, "timestamp": "01:13:33", "text": "いいえ、その"}, {"type": "subtitle", "time": 4417.91, "timestamp": "01:13:37", "text": "物体ではありません。 オブジェクトを配列に渡すには、"}, {"type": "subtitle", "time": 4422.12, "timestamp": "01:13:42", "text": "配列またはオブジェクトを渡します。 いいえ、"}, {"type": "subtitle", "time": 4424.87, "timestamp": "01:13:44", "text": "[音楽] では、"}, {"type": "subtitle", "time": 4429.51, "timestamp": "01:13:49", "text": "ch に聞かなければなりません。"}, {"type": "subtitle", "time": 4436.31, "timestamp": "01:13:56", "text": "結果の"}, {"type": "subtitle", "time": 4438.07, "timestamp": "01:13:58", "text": "プレイリスト"}]
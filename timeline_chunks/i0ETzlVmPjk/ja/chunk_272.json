[{"type": "subtitle", "time": 16326.48, "timestamp": "04:32:06", "text": "はい、"}, {"type": "subtitle", "time": 16329.91, "timestamp": "04:32:09", "text": "音楽は"}, {"type": "subtitle", "time": 16333.51, "timestamp": "04:32:13", "text": "効果があります。 ああ、大丈夫そうだ。 では、"}, {"type": "subtitle", "time": 16336.469, "timestamp": "04:32:16", "text": "もう一度実行してもいいですか？"}, {"type": "subtitle", "time": 16339.9, "timestamp": "04:32:19", "text": "それはうまくいかないよね？"}, {"type": "subtitle", "time": 16345.75, "timestamp": "04:32:25", "text": "よし、直したよ。 はい、直しました"}, {"type": "subtitle", "time": 16350.98, "timestamp": "04:32:30", "text": "。 ディオ。 さあ行こう。 直しました。"}, {"type": "subtitle", "time": 16353.59, "timestamp": "04:32:33", "text": "[音楽]"}, {"type": "subtitle", "time": 16356.55, "timestamp": "04:32:36", "text": "オーケー。 これで、毎秒ごとに積極的に"}, {"type": "subtitle", "time": 16359.75, "timestamp": "04:32:39", "text": "チェックするように設定できます。 いや、"}, {"type": "subtitle", "time": 16361.67, "timestamp": "04:32:41", "text": "いや、いや、いや。  10秒ごと。  10"}, {"type": "subtitle", "time": 16364.389, "timestamp": "04:32:44", "text": "秒ごと。 はい。 はい。 はい。 はい。"}, {"type": "subtitle", "time": 16366.87, "timestamp": "04:32:46", "text": "10秒ごと。  10秒は"}, {"type": "subtitle", "time": 16373.75, "timestamp": "04:32:53", "text": "忘れていた。 えっと、MSまであと10秒。 何という"}, {"type": "subtitle", "time": 16375.269, "timestamp": "04:32:55", "text": "瞬間だ。"}, {"type": "subtitle", "time": 16379.349, "timestamp": "04:32:59", "text": "これです。 そして私はそれをここに、あれに、これに置いておきました"}]
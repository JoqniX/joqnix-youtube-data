[{"type": "subtitle", "time": 12663.429, "timestamp": "03:31:03", "text": "Vリンクのようなものを手に入れます。それがこれです。  Chromeに入れれば"}, {"type": "subtitle", "time": 12665.67, "timestamp": "03:31:05", "text": "、オリジンを必要としないので動作します"}, {"type": "subtitle", "time": 12670.389, "timestamp": "03:31:10", "text": "。 ええ、共同作業は"}, {"type": "subtitle", "time": 12673.59, "timestamp": "03:31:13", "text": "ランダムなタイムスタンプから始まり、"}, {"type": "subtitle", "time": 12677.75, "timestamp": "03:31:17", "text": "この場合はループしている 30 本の動画がありますが、"}, {"type": "subtitle", "time": 12680.15, "timestamp": "03:31:20", "text": "もし私が下忍カテゴリにいる場合、"}, {"type": "subtitle", "time": 12684.469, "timestamp": "03:31:24", "text": "私のプレイリストに"}, {"type": "subtitle", "time": 12687.51, "timestamp": "03:31:27", "text": "30 本以上の動画がある場合は、完全にランダム化されたリストが作成されます"}, {"type": "subtitle", "time": 12691.03, "timestamp": "03:31:31", "text": "。 そうですね、これは"}, {"type": "subtitle", "time": 12695.19, "timestamp": "03:31:35", "text": "バージョン3と新しいエディションを統合したもので、"}, {"type": "subtitle", "time": 12701.91, "timestamp": "03:31:41", "text": "私がどのカテゴリにいて、どのカテゴリの"}, {"type": "subtitle", "time": 12704.469, "timestamp": "03:31:44", "text": "ゲームをストリーミングしているかに応じてカテゴリベースになっています。   これは"}, {"type": "subtitle", "time": 12710.469, "timestamp": "03:31:50", "text": "セットアップの4番目のバージョンです。 かっこいいと思わない？"}, {"type": "subtitle", "time": 12713.59, "timestamp": "03:31:53", "text": "右。 そうなんです、でも"}, {"type": "subtitle", "time": 12716.55, "timestamp": "03:31:56", "text": "このシーンに切り替えたらうまくいくはずなんですが、"}, {"type": "subtitle", "time": 12719.67, "timestamp": "03:31:59", "text": "残念ながらうまくいきません。 そのエラーが表示されます。 だから、"}]
[{"type": "subtitle", "time": 2340.71, "timestamp": "00:39:00", "text": "ストリーム情報 async。 私が運営しています。"}, {"type": "subtitle", "time": 2343.51, "timestamp": "00:39:03", "text": "どうなるか見てみよう。"}, {"type": "subtitle", "time": 2346.31, "timestamp": "00:39:06", "text": "えっと、"}, {"type": "subtitle", "time": 2349.51, "timestamp": "00:39:09", "text": "配信情報、ゲーム名、"}, {"type": "subtitle", "time": 2351.03, "timestamp": "00:39:11", "text": "タイトル、"}, {"type": "subtitle", "time": 2354.31, "timestamp": "00:39:14", "text": "あなたのアカウント。 わかった。 えっと、タグとタグ。   わかった"}, {"type": "subtitle", "time": 2357.75, "timestamp": "00:39:17", "text": "。 つまり、ゲームの名前ですよね？"}, {"type": "subtitle", "time": 2360.069, "timestamp": "00:39:20", "text": "ゲーム名。 わかった。 行く。 これです。 これこそ"}, {"type": "subtitle", "time": 2363.589, "timestamp": "00:39:23", "text": "私たちが求めていたものだ。 わかった。 パスをコピーします。"}, {"type": "subtitle", "time": 2367.589, "timestamp": "00:39:27", "text": "このコマンドでは、私が"}, {"type": "subtitle", "time": 2376.55, "timestamp": "00:39:36", "text": "ストリーミング配信をしている場合、Twitchで私がライブ配信中かどうかを積極的にチェックするようにします。"}, {"type": "subtitle", "time": 2382.55, "timestamp": "00:39:42", "text": "Twitchで自分のカテゴリーが何なのか確認したかったんです。"}, {"type": "subtitle", "time": 2385.19, "timestamp": "00:39:45", "text": "さて、これを乗り越える別の方法がある"}, {"type": "subtitle", "time": 2389.27, "timestamp": "00:39:49", "text": "。 キックもチェックするようにすることもできます"}, {"type": "subtitle", "time": 2393.51, "timestamp": "00:39:53", "text": "。 でもキックに関しては、"}, {"type": "subtitle", "time": 2395.67, "timestamp": "00:39:55", "text": "私は現在キックでライブ配信中ですよね？"}, {"type": "subtitle", "time": 2398.87, "timestamp": "00:39:58", "text": "つまり、問題は私が"}]
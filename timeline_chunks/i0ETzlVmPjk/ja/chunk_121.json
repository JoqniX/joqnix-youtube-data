[{"type": "subtitle", "time": 7263.83, "timestamp": "02:01:03", "text": "この人とこの人がここにいてほしいということです。"}, {"type": "subtitle", "time": 7266.55, "timestamp": "02:01:06", "text": "そして、その2つをどうやって区別するかは、"}, {"type": "subtitle", "time": 7283.99, "timestamp": "02:01:23", "text": "両者をどう区別するかは、えっと、ちょっと携帯"}, {"type": "subtitle", "time": 7289.51, "timestamp": "02:01:29", "text": "電話を充電させてください"}, {"type": "subtitle", "time": 7296.39, "timestamp": "02:01:36", "text": "喉が痛くてすみません。   ええと、"}, {"type": "subtitle", "time": 7304.07, "timestamp": "02:01:44", "text": "この人ですね。 コピーしてください。   それを"}, {"type": "subtitle", "time": 7314.55, "timestamp": "02:01:54", "text": "そうそう。 うん。 タイトルも必要です"}, {"type": "subtitle", "time": 7319.189, "timestamp": "02:01:59", "text": "。 それで、TTV"}]
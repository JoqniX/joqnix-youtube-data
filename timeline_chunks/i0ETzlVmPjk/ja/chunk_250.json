[{"type": "subtitle", "time": 15012.79, "timestamp": "04:10:12", "text": "ボタンの時間です。 よし、君たちは"}, {"type": "subtitle", "time": 15017.59, "timestamp": "04:10:17", "text": "そこへアクセスしてくれ。私はこれをやる。 だから、でも、"}, {"type": "subtitle", "time": 15020.389, "timestamp": "04:10:20", "text": "ここにはこれらの人たちは必要ないんです。   わかった"}, {"type": "subtitle", "time": 15025.189, "timestamp": "04:10:25", "text": "。 えっと、走るボタンを押すんですよね？"}, {"type": "subtitle", "time": 15027.11, "timestamp": "04:10:27", "text": "現在配信中です。 はい、メルが今いる"}, {"type": "subtitle", "time": 15029.51, "timestamp": "04:10:29", "text": "シーンは"}, {"type": "subtitle", "time": 15031.349, "timestamp": "04:10:31", "text": "BRB"}, {"type": "subtitle", "time": 15035.99, "timestamp": "04:10:35", "text": "vaudeになりますよね？ またはゲーム。 だから、"}, {"type": "subtitle", "time": 15042.95, "timestamp": "04:10:42", "text": "このボタンの"}, {"type": "subtitle", "time": 15047.76, "timestamp": "04:10:47", "text": "実行がリセットされるようにしたいのです。"}, {"type": "subtitle", "time": 15049.11, "timestamp": "04:10:49", "text": "[音楽]"}, {"type": "subtitle", "time": 15053.349, "timestamp": "04:10:53", "text": "ええと、リセットされます。"}, {"type": "subtitle", "time": 15055.03, "timestamp": "04:10:55", "text": "ええ、"}, {"type": "subtitle", "time": 15058.71, "timestamp": "04:10:58", "text": "シーンを切り替えるたびにリセットされるでしょうね。"}]
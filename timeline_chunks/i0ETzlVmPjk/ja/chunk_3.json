[{"type": "subtitle", "time": 188.47, "timestamp": "00:03:08", "text": "、どうやら"}, {"type": "subtitle", "time": 193.99, "timestamp": "00:03:13", "text": "今日は語学の授業がなかったみたいです。 だから私は「"}, {"type": "subtitle", "time": 198.39, "timestamp": "00:03:18", "text": "今日は仕事配信をしよう」と思ったんです。 ええと"}, {"type": "subtitle", "time": 200.71, "timestamp": "00:03:20", "text": "、今日は"}, {"type": "subtitle", "time": 203.67000000000002, "timestamp": "00:03:23", "text": "技術的なことをいくつかやります。 たぶん"}, {"type": "subtitle", "time": 207.43, "timestamp": "00:03:27", "text": "音楽をかけながら、ただ"}, {"type": "subtitle", "time": 210.789, "timestamp": "00:03:30", "text": "話したり仕事をしたりすると思います。"}, {"type": "subtitle", "time": 213.589, "timestamp": "00:03:33", "text": "それでおしまい。 えっと、"}, {"type": "subtitle", "time": 216.869, "timestamp": "00:03:36", "text": "作業とテストが終わったら、えっと"}, {"type": "subtitle", "time": 219.589, "timestamp": "00:03:39", "text": "、ちょっとブループロトコルをプレイしましょう。だって、やらない理由は"}, {"type": "subtitle", "time": 224.149, "timestamp": "00:03:44", "text": "ないでしょう？ ええ、そうですね、"}, {"type": "subtitle", "time": 227.19, "timestamp": "00:03:47", "text": "ブループロトコルとかをプレイしてみて、どうなるか見てみましょう"}, {"type": "subtitle", "time": 231.19, "timestamp": "00:03:51", "text": "。 えっと、レベル40の装備が"}, {"type": "subtitle", "time": 234.22899999999998, "timestamp": "00:03:54", "text": "今日発売されるから。 いいえ、40ではありません。レベル60の装備が"}, {"type": "subtitle", "time": 235.82999999999998, "timestamp": "00:03:55", "text": "今日発売されます。 だから、それが楽しみなんです"}]
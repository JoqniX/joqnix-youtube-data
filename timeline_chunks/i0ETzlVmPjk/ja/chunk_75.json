[{"type": "subtitle", "time": 4502.95, "timestamp": "01:15:02", "text": "このえーと、あのシーンに切り替えたんです。"}, {"type": "subtitle", "time": 4505.99, "timestamp": "01:15:05", "text": "ランダムなナレーションが再生されるんですよね？"}, {"type": "subtitle", "time": 4509.99, "timestamp": "01:15:09", "text": "以前はそうだったんですよね？ つまり、つまり、つまり、えーと、"}, {"type": "subtitle", "time": 4516.47, "timestamp": "01:15:16", "text": "私が普段配信をしているとき、例えば"}, {"type": "subtitle", "time": 4521.669, "timestamp": "01:15:21", "text": "今日は原知インパクトをプレイしているとしましょう、そうですよね？ これは原知インパクトの"}, {"type": "subtitle", "time": 4523.91, "timestamp": "01:15:23", "text": "配信で、私はプレイしていて、"}, {"type": "subtitle", "time": 4526.47, "timestamp": "01:15:26", "text": "少し休憩を取っています。私の"}, {"type": "subtitle", "time": 4529.75, "timestamp": "01:15:29", "text": "配信を見ている人たちには、"}, {"type": "subtitle", "time": 4531.75, "timestamp": "01:15:31", "text": "配信を離れないでほしいと思っています。 彼らはただ"}, {"type": "subtitle", "time": 4534.47, "timestamp": "01:15:34", "text": "Genchin Impactを楽しむだけでいいんです。だってそれが"}, {"type": "subtitle", "time": 4537.27, "timestamp": "01:15:37", "text": "彼らがここにいる目的でしょう？ だから、"}, {"type": "subtitle", "time": 4539.91, "timestamp": "01:15:39", "text": "休憩時間には、ランダムに"}, {"type": "subtitle", "time": 4543.27, "timestamp": "01:15:43", "text": "ゲンチンインパクトのVODを再生してもいいんですよね？ だって、"}, {"type": "subtitle", "time": 4546.229, "timestamp": "01:15:46", "text": "YouTubeの配信は全部、どんなゲームを"}, {"type": "subtitle", "time": 4547.75, "timestamp": "01:15:47", "text": "プレイしていても、プレイリストに入ってるでしょ"}, {"type": "subtitle", "time": 4551.43, "timestamp": "01:15:51", "text": "？ そこで、私が"}, {"type": "subtitle", "time": 4554.709, "timestamp": "01:15:54", "text": "作った古い設定を使用しました。"}, {"type": "subtitle", "time": 4558.07, "timestamp": "01:15:58", "text": "カテゴリやプレイリストに基づいて作成しようとしています。"}]
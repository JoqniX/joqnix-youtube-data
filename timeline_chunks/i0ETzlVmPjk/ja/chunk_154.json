[{"type": "subtitle", "time": 9240.23, "timestamp": "02:34:00", "text": "。"}, {"type": "subtitle", "time": 9245.03, "timestamp": "02:34:05", "text": "前回のバージョンから変更しているのは、"}, {"type": "subtitle", "time": 9251.27, "timestamp": "02:34:11", "text": "こちらのコマンド、"}, {"type": "subtitle", "time": 9255.349, "timestamp": "02:34:15", "text": "この人だけです。"}, {"type": "subtitle", "time": 9260.95, "timestamp": "02:34:20", "text": "私がどのカテゴリーに属しているか、そして"}, {"type": "subtitle", "time": 9268.71, "timestamp": "02:34:28", "text": "そのカテゴリーがどの[音楽]プレイリストにリンクされているかによって異なります。"}, {"type": "subtitle", "time": 9275.99, "timestamp": "02:34:35", "text": "その動画を入手したいです。 右？ だから、"}, {"type": "subtitle", "time": 9279.75, "timestamp": "02:34:39", "text": "こちらのコマンドは、"}, {"type": "subtitle", "time": 9281.51, "timestamp": "02:34:41", "text": "原神のプレイリストから外してもいいと思う。"}, {"type": "subtitle", "time": 9287.27, "timestamp": "02:34:47", "text": "必要ないからね。 設置できます。 ボタンにすることもできると思います"}, {"type": "subtitle", "time": 9289.75, "timestamp": "02:34:49", "text": "。 つまり、今のところは"}, {"type": "subtitle", "time": 9291.59, "timestamp": "02:34:51", "text": "別々のボタンを作成し、それらをすべて含む"}, {"type": "subtitle", "time": 9297.51, "timestamp": "02:34:57", "text": "com ボタンのような単一のコマンドにまとめます"}]
[{"type": "subtitle", "time": 12542.55, "timestamp": "03:29:02", "text": "最初の"}, {"type": "subtitle", "time": 12545.59, "timestamp": "03:29:05", "text": "部分のようなものが取得されます。 つまり、タイトルに「"}, {"type": "subtitle", "time": 12547.51, "timestamp": "03:29:07", "text": "コワーキング」と書いてあれば、それは"}, {"type": "subtitle", "time": 12549.99, "timestamp": "03:29:09", "text": "コワーキングのプレイリストに入ります。  「一緒に働きませんか」と書いてあれば"}, {"type": "subtitle", "time": 12551.91, "timestamp": "03:29:11", "text": "、それはコワーキングスペースのことです。 もしそれが"}, {"type": "subtitle", "time": 12553.67, "timestamp": "03:29:13", "text": "私にとって安定しているなら、そのような安定した"}, {"type": "subtitle", "time": 12556.95, "timestamp": "03:29:16", "text": "プレイリストになるでしょう。 私は自分のゲームのほとんどすべてを追加しました"}, {"type": "subtitle", "time": 12560.15, "timestamp": "03:29:20", "text": "。 ということで、原神。 つまり、"}, {"type": "subtitle", "time": 12562.389, "timestamp": "03:29:22", "text": "私のTwitchのタイトルが「原神」だったら、"}, {"type": "subtitle", "time": 12568.15, "timestamp": "03:29:28", "text": "YouTubeの「原神」というプレイリストをチェックするのと同じことですよ"}, {"type": "subtitle", "time": 12577.349, "timestamp": "03:29:37", "text": "ね？ つまり、YouTube の情報を取得した後、"}, {"type": "subtitle", "time": 12581.83, "timestamp": "03:29:41", "text": "Twitch から情報を取得して YouTube の"}, {"type": "subtitle", "time": 12584.55, "timestamp": "03:29:44", "text": "プレイリストなどにリンクした後、この部分に入ります"}, {"type": "subtitle", "time": 12587.429, "timestamp": "03:29:47", "text": "。 それで、プレイリストのリンクは入手できましたよね"}, {"type": "subtitle", "time": 12589.269, "timestamp": "03:29:49", "text": "？ 例えば、プレイリストのリンクを入手しました"}, {"type": "subtitle", "time": 12592.15, "timestamp": "03:29:52", "text": "。 えっと、今はコワーキングスペースで働いています。"}, {"type": "subtitle", "time": 12596.63, "timestamp": "03:29:56", "text": "これがプレイリストリンクの"}]
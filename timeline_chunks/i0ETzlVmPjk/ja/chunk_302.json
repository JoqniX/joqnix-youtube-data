[{"type": "subtitle", "time": 18141.99, "timestamp": "05:02:21", "text": "H. 良い。 良い。 良い。"}, {"type": "subtitle", "time": 18144.23, "timestamp": "05:02:24", "text": "それで大丈夫です。   わーい"}, {"type": "subtitle", "time": 18151.11, "timestamp": "05:02:31", "text": "こんにちは。 私は寝ます。"}, {"type": "subtitle", "time": 18154.948, "timestamp": "05:02:34", "text": "半分まで終わった。 大丈夫です。"}, {"type": "subtitle", "time": 18157.03, "timestamp": "05:02:37", "text": "後で取り組みます。 わかった。 もうこんなに遅い時間だ。"}, {"type": "subtitle", "time": 18161.27, "timestamp": "05:02:41", "text": "12時だ。寝るよ。 わかった。 あぁ、"}, {"type": "subtitle", "time": 18163.99, "timestamp": "05:02:43", "text": "喉がすごく痛い。"}, {"type": "subtitle", "time": 18165.56, "timestamp": "05:02:45", "text": "7時間後に起きなければならない。"}, {"type": "subtitle", "time": 18167.35, "timestamp": "05:02:47", "text": "[音楽]"}, {"type": "subtitle", "time": 18170.23, "timestamp": "05:02:50", "text": "ええ、"}, {"type": "subtitle", "time": 18173.35, "timestamp": "05:02:53", "text": "最後まで残ってくれた皆さん、ありがとうございました。"}, {"type": "subtitle", "time": 18177.43, "timestamp": "05:02:57", "text": "今日の内容は、多くの人にとって退屈すぎたと思います"}]
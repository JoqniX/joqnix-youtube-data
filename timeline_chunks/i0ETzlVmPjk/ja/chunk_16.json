[{"type": "subtitle", "time": 962.71, "timestamp": "00:16:02", "text": "今回は例えば、現在"}, {"type": "subtitle", "time": 964.949, "timestamp": "00:16:04", "text": "コワーキングスペースを運営している、といったように分類してもらいたかったんです。 これは一緒に仕事をする"}, {"type": "subtitle", "time": 967.35, "timestamp": "00:16:07", "text": "配信です。 つまり、ここはコワーキングスペースです。 この"}, {"type": "subtitle", "time": 970.23, "timestamp": "00:16:10", "text": "配信はYouTubeのコワーキング"}, {"type": "subtitle", "time": 973.99, "timestamp": "00:16:13", "text": "プレイリストに入っているんですよね？ つまり、"}, {"type": "subtitle", "time": 977.11, "timestamp": "00:16:17", "text": "私のYouTubeチャンネルにあるすべての再生をスキャンするということです。"}, {"type": "subtitle", "time": 980.949, "timestamp": "00:16:20", "text": "私がどのカテゴリにいても、Twitchの"}, {"type": "subtitle", "time": 984.55, "timestamp": "00:16:24", "text": "カテゴリ、Twitchのストリームカテゴリをチェックします。"}, {"type": "subtitle", "time": 987.35, "timestamp": "00:16:27", "text": "例えば、現在"}, {"type": "subtitle", "time": 991.59, "timestamp": "00:16:31", "text": "Twitchでは、仕事と勉強の"}, {"type": "subtitle", "time": 995.11, "timestamp": "00:16:35", "text": "カテゴリーにいます。 だから"}, {"type": "subtitle", "time": 999.11, "timestamp": "00:16:39", "text": "、Twitchでライブ配信しているときはいつでも、"}, {"type": "subtitle", "time": 1001.189, "timestamp": "00:16:41", "text": "コワーキングや"}, {"type": "subtitle", "time": 1007.509, "timestamp": "00:16:47", "text": "勉強のカテゴリにいるときはいつでも、私のストリームが"}, {"type": "subtitle", "time": 1009.829, "timestamp": "00:16:49", "text": "コワーキングのプレイリストに入るようにする必要があるんです。 この配信は、"}, {"type": "subtitle", "time": 1012.31, "timestamp": "00:16:52", "text": "そういったコワーキングスペースのカテゴリーに属している。"}, {"type": "subtitle", "time": 1014.23, "timestamp": "00:16:54", "text": "例えば、明日は"}, {"type": "subtitle", "time": 1016.949, "timestamp": "00:16:56", "text": "Dとナイトアビスをプレイする予定ですよね？"}, {"type": "subtitle", "time": 1018.949, "timestamp": "00:16:58", "text": "私のTwitchのカテゴリーはDとナイト"}]
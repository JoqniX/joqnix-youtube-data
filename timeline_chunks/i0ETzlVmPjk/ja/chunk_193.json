[{"type": "subtitle", "time": 11581.269, "timestamp": "03:13:01", "text": "ええと、実際には、"}, {"type": "subtitle", "time": 11601.03, "timestamp": "03:13:21", "text": "ええと、問題ないと"}, {"type": "subtitle", "time": 11604.15, "timestamp": "03:13:24", "text": "思います。 考えすぎているだけだよ"}, {"type": "subtitle", "time": 11610.95, "timestamp": "03:13:30", "text": "ええ、まあ、だいたいそんなところです。"}, {"type": "subtitle", "time": 11616.55, "timestamp": "03:13:36", "text": "ストリーミング配信環境に新たに追加した機器の一つを、ついに設置できたようです。"}, {"type": "subtitle", "time": 11620.229, "timestamp": "03:13:40", "text": "行ったり来たり、といった感じでしょうか。 ええ、そうですね、"}, {"type": "subtitle", "time": 11627.269, "timestamp": "03:13:47", "text": "ゲームやアート、チャットなどを配信しているときに、"}, {"type": "subtitle", "time": 11632.55, "timestamp": "03:13:52", "text": "10分以上または5"}, {"type": "subtitle", "time": 11635.51, "timestamp": "03:13:55", "text": "分以上AFK状態になると、VAシーンに切り替わり、"}, {"type": "subtitle", "time": 11638.309, "timestamp": "03:13:58", "text": "ランダムな"}]
[{"type": "subtitle", "time": 13142.79, "timestamp": "03:39:02", "text": "えっと、待って、どうしてここにいないの？"}, {"type": "subtitle", "time": 13149.75, "timestamp": "03:39:09", "text": "何？ なぜここにいないのですか？ あなたは"}, {"type": "subtitle", "time": 13152.87, "timestamp": "03:39:12", "text": "ここにいるべきなんです。 待って。 なぜ私は"}, {"type": "subtitle", "time": 13155.59, "timestamp": "03:39:15", "text": "それを壊してしまったのだろうか？   えっと、"}, {"type": "subtitle", "time": 13157.67, "timestamp": "03:39:17", "text": "待って。 あなたはTwitchをやっているんですよね？ だから、ここにも来るだろう"}, {"type": "subtitle", "time": 13160.07, "timestamp": "03:39:20", "text": "。"}, {"type": "subtitle", "time": 13162.469, "timestamp": "03:39:22", "text": "ええ、あなたはここにいますね。 待って、なぜ"}, {"type": "subtitle", "time": 13165.59, "timestamp": "03:39:25", "text": "スレッドが作成されなかったの？"}, {"type": "subtitle", "time": 13168.389, "timestamp": "03:39:28", "text": "壊れた。"}, {"type": "subtitle", "time": 13171.67, "timestamp": "03:39:31", "text": "待って、壊れた。 待って、"}, {"type": "subtitle", "time": 13174.63, "timestamp": "03:39:34", "text": "壊れた。"}, {"type": "subtitle", "time": 13177.03, "timestamp": "03:39:37", "text": "それはあなたのためにスレッドを作成しませんでした。 一体どういうことだ"}, {"type": "subtitle", "time": 13179.349, "timestamp": "03:39:39", "text": "？"}, {"type": "subtitle", "time": 13181.51, "timestamp": "03:39:41", "text": "待って。   何てことだ"}, {"type": "subtitle", "time": 13183.91, "timestamp": "03:39:43", "text": "。 壊れた。"}, {"type": "subtitle", "time": 13185.429, "timestamp": "03:39:45", "text": "待って、待って、待って、待って。 実際に"}, {"type": "subtitle", "time": 13192.309, "timestamp": "03:39:52", "text": "でも、これを直したいんです。 待って、"}]
[{"type": "subtitle", "time": 11400.87, "timestamp": "03:10:00", "text": "ずっとVを作り続けてしまいます。"}, {"type": "subtitle", "time": 11403.429, "timestamp": "03:10:03", "text": "いや、それは望んでいません。 私たちはそれを望んでいません"}, {"type": "subtitle", "time": 11405.429, "timestamp": "03:10:05", "text": "。"}, {"type": "subtitle", "time": 11408.63, "timestamp": "03:10:08", "text": "私がその特定のシーンにいる場合に限り、それを実行します"}, {"type": "subtitle", "time": 11410.469, "timestamp": "03:10:10", "text": "。 よし、では"}, {"type": "subtitle", "time": 11412.71, "timestamp": "03:10:12", "text": "もう一度テストして、これを"}, {"type": "subtitle", "time": 11416.71, "timestamp": "03:10:16", "text": "貼り付けて、これを"}, {"type": "subtitle", "time": 11419.59, "timestamp": "03:10:19", "text": "保存する。 つまり、10秒ごとに、"}, {"type": "subtitle", "time": 11423.19, "timestamp": "03:10:23", "text": "BRB"}, {"type": "subtitle", "time": 11427.11, "timestamp": "03:10:27", "text": "シーンに切り替えるたびに、Twitchのカテゴリをチェックし、"}, {"type": "subtitle", "time": 11434.389, "timestamp": "03:10:34", "text": "カテゴリとYouTubeの再生を二重チェックします。"}, {"type": "subtitle", "time": 11436.71, "timestamp": "03:10:36", "text": "また、YouTube のすべての"}, {"type": "subtitle", "time": 11441.11, "timestamp": "03:10:41", "text": "プレイリストを取得し、たとえば、"}, {"type": "subtitle", "time": 11442.95, "timestamp": "03:10:42", "text": "今日のストリームが「一緒に仕事をする」"}, {"type": "subtitle", "time": 11444.87, "timestamp": "03:10:44", "text": "ストリームである場合、"}, {"type": "subtitle", "time": 11446.71, "timestamp": "03:10:46", "text": "Twitch のカテゴリが「"}, {"type": "subtitle", "time": 11448.95, "timestamp": "03:10:48", "text": "勉強と共同作業」であるかどうかを確認します。"}, {"type": "subtitle", "time": 11451.59, "timestamp": "03:10:51", "text": "勉強と共同作業が"}, {"type": "subtitle", "time": 11453.83, "timestamp": "03:10:53", "text": "YouTube プレイリストと同じであれば、"}, {"type": "subtitle", "time": 11457.11, "timestamp": "03:10:57", "text": "共同作業プレイリストに移動します。そして、そこから"}]
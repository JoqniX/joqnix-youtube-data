[{"type": "subtitle", "time": 902.15, "timestamp": "00:15:02", "text": "て、ちょっと待って。"}, {"type": "subtitle", "time": 904.629, "timestamp": "00:15:04", "text": "えっと、"}, {"type": "subtitle", "time": 906.949, "timestamp": "00:15:06", "text": "今見たものって何ですか？ つまり、"}, {"type": "subtitle", "time": 910.79, "timestamp": "00:15:10", "text": "基本的には声優がいるということです。"}, {"type": "subtitle", "time": 913.59, "timestamp": "00:15:13", "text": "では、例えば私が"}, {"type": "subtitle", "time": 916.389, "timestamp": "00:15:16", "text": "ゲームをプレイしているとしましょう。 先ほど、ブループロトコルについて見てきました。 いいえ、"}, {"type": "subtitle", "time": 918.87, "timestamp": "00:15:18", "text": "私が最近プレイしていたゲームのことです。 私は"}, {"type": "subtitle", "time": 921.11, "timestamp": "00:15:21", "text": "ブループロトコルの配信をしていて、"}, {"type": "subtitle", "time": 923.99, "timestamp": "00:15:23", "text": "数分間席を外します。いいですか？"}, {"type": "subtitle", "time": 926.629, "timestamp": "00:15:26", "text": "昼食か夕食か何かに出かけるつもりです。"}, {"type": "subtitle", "time": 929.11, "timestamp": "00:15:29", "text": "私は配信から離れますが、皆さんは、こっそり見ている人、"}, {"type": "subtitle", "time": 934.389, "timestamp": "00:15:34", "text": "私と一緒に仕事をしている人、あるいは"}, {"type": "subtitle", "time": 937.59, "timestamp": "00:15:37", "text": "配信をこっそり見ている人、または見ている人です。 ちょっと"}, {"type": "subtitle", "time": 939.269, "timestamp": "00:15:39", "text": "退屈するんじゃない？ なぜなら、配信者は"}, {"type": "subtitle", "time": 941.99, "timestamp": "00:15:41", "text": "楽しませるためにここにいるのではないからだ。 だから、そういう"}, {"type": "chat", "time": 943.368, "timestamp": "00:15:43", "author": "@MR_Bhalu", "avatar": "https://yt4.ggpht.com/ytc/AIdro_nZa2L5tvX7AvSd4Ge5CNES4grhI0iSwAR0FOEKVgy-ONyNf84-qq6U12ADeVbgPcot_Q=s64-c-k-c0x00ffffff-no-rj", "message": "work is not working"}, {"type": "subtitle", "time": 945.35, "timestamp": "00:15:45", "text": "状況では、古い"}, {"type": "subtitle", "time": 948.23, "timestamp": "00:15:48", "text": "動画やライブ配信などを再生したいんです"}, {"type": "subtitle", "time": 951.189, "timestamp": "00:15:51", "text": "。 それは、ずっとずっと昔に私たちが持っていたものだった"}, {"type": "subtitle", "time": 953.99, "timestamp": "00:15:53", "text": "。"}, {"type": "subtitle", "time": 957.35, "timestamp": "00:15:57", "text": "えっと、ランダムに選ばれたものだったんですが、"}]
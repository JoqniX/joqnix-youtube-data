[{"type": "subtitle", "time": 14290.229, "timestamp": "03:58:10", "text": "ちょっと待って、実際はああ、ああ、今"}, {"type": "subtitle", "time": 14293.349, "timestamp": "03:58:13", "text": "気づいたよ。 ああ、なんてことだ"}, {"type": "subtitle", "time": 14304.87, "timestamp": "03:58:24", "text": "やあ、君。 勉強。 どちらかというと、"}, {"type": "subtitle", "time": 14307.51, "timestamp": "03:58:27", "text": "コワーキングスペースに近いですね。"}, {"type": "subtitle", "time": 14310.07, "timestamp": "03:58:30", "text": "勉強していない。 私たちは、まさにこれを"}, {"type": "subtitle", "time": 14312.71, "timestamp": "03:58:32", "text": "研究し、その方法を学んでいるところです。"}, {"type": "subtitle", "time": 14321.11, "timestamp": "03:58:41", "text": "元気？ 元気です。 彼らは"}, {"type": "subtitle", "time": 14325.75, "timestamp": "03:58:45", "text": "皆疲れていた。 夕食を食べなければならない。"}, {"type": "subtitle", "time": 14328.07, "timestamp": "03:58:48", "text": "私はずっと喋り続けていました。 これを"}, {"type": "subtitle", "time": 14335.429, "timestamp": "03:58:55", "text": "何時間やってきたんだろう？  3時間、ほぼ4時間。 聖なる。"}, {"type": "subtitle", "time": 14338.79, "timestamp": "03:58:58", "text": "明日は午前7時から配信があるので、"}]
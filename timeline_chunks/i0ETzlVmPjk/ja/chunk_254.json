[{"type": "subtitle", "time": 15249.59, "timestamp": "04:14:09", "text": "私のbongコマンドが動作しません。 ループ再生になると思う"}, {"type": "subtitle", "time": 15253.11, "timestamp": "04:14:13", "text": "。 ループ再生。"}, {"type": "subtitle", "time": 15255.59, "timestamp": "04:14:15", "text": "メニューはボンです。 ブーム"}, {"type": "subtitle", "time": 15264.63, "timestamp": "04:14:24", "text": "これからチャットコマンドの作業に取り掛からなければならない。"}, {"type": "subtitle", "time": 15266.55, "timestamp": "04:14:26", "text": "私たちにはアパートも何もないんです。"}, {"type": "subtitle", "time": 15271.11, "timestamp": "04:14:31", "text": "残念ながら、今はPNG画像を使っています。"}, {"type": "subtitle", "time": 15274.07, "timestamp": "04:14:34", "text": "それら全てを追加しなければならない。"}, {"type": "subtitle", "time": 15277.349, "timestamp": "04:14:37", "text": "思い出させてくれてありがとう。 ああ、あくびが出てきた"}, {"type": "subtitle", "time": 15279.03, "timestamp": "04:14:39", "text": "。"}, {"type": "subtitle", "time": 15283.11, "timestamp": "04:14:43", "text": "その件について思い出させてくれてありがとう。 ありがとう。"}, {"type": "subtitle", "time": 15285.349, "timestamp": "04:14:45", "text": "うわあ、これは直さなきゃ"}, {"type": "subtitle", "time": 15288.71, "timestamp": "04:14:48", "text": "。"}, {"type": "subtitle", "time": 15292.71, "timestamp": "04:14:52", "text": "喉が痛い。 よし、じゃあ病棟"}]
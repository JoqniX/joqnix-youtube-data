[{"type": "subtitle", "time": 8042.55, "timestamp": "02:14:02", "text": "穴を掘るゲーム。 よし、あの"}, {"type": "subtitle", "time": 8055.27, "timestamp": "02:14:15", "text": "星界のパーティーだ。 はい、それを持ってきて"}, {"type": "subtitle", "time": 8065.43, "timestamp": "02:14:25", "text": "マーベル・ライバルズを"}, {"type": "subtitle", "time": 8075.83, "timestamp": "02:14:35", "text": "キーにおける無限。 それをコピーして"}, {"type": "subtitle", "time": 8089.589, "timestamp": "02:14:49", "text": "私が「手動で"}, {"type": "subtitle", "time": 8096.149, "timestamp": "02:14:56", "text": "大丈夫です。"}, {"type": "subtitle", "time": 8097.99, "timestamp": "02:14:57", "text": "つまり、他にももっとうまくやれた"}]
[{"type": "subtitle", "time": 2400.95, "timestamp": "00:40:00", "text": "カテゴリーを変更しないことです。 私はいつも"}, {"type": "subtitle", "time": 2404.71, "timestamp": "00:40:04", "text": "KickのVTuberカテゴリを見てるよね？"}, {"type": "subtitle", "time": 2406.47, "timestamp": "00:40:06", "text": "うん、私はいつもKickのVTuberカテゴリを見てるよ"}, {"type": "subtitle", "time": 2409.75, "timestamp": "00:40:09", "text": "。 つまり、キックは関係ないってことですよね？   だから"}, {"type": "subtitle", "time": 2411.99, "timestamp": "00:40:11", "text": "私は"}, {"type": "subtitle", "time": 2415.67, "timestamp": "00:40:15", "text": "Twitchを優先しているんです。 だから、ある意味ではうまくいくはずだ。"}, {"type": "subtitle", "time": 2417.91, "timestamp": "00:40:17", "text": "Twitchをチェックするなら、それで大丈夫ですよね"}, {"type": "subtitle", "time": 2421.829, "timestamp": "00:40:21", "text": "？ だから、次のバージョンでは、"}, {"type": "subtitle", "time": 2424.55, "timestamp": "00:40:24", "text": "私がどのカテゴリに属しているかという機能を実現したいと思っていました。"}, {"type": "subtitle", "time": 2427.27, "timestamp": "00:40:27", "text": "たとえば、"}, {"type": "subtitle", "time": 2432.47, "timestamp": "00:40:32", "text": "PCでゲームを開いたときに、"}, {"type": "subtitle", "time": 2435.75, "timestamp": "00:40:35", "text": "どのゲームが開かれているかをチェックし、"}, {"type": "subtitle", "time": 2440.87, "timestamp": "00:40:40", "text": "特定のゲームであれば、"}, {"type": "subtitle", "time": 2446.87, "timestamp": "00:40:46", "text": "Twitchのカテゴリを自動的に変更するようにしたかったのです。"}, {"type": "subtitle", "time": 2450.39, "timestamp": "00:40:50", "text": "たとえば、Genshin Impact.exeを開きます。"}, {"type": "subtitle", "time": 2455.349, "timestamp": "00:40:55", "text": "そうすると、私のカテゴリが原神に変わります。 それは将来的に"}, {"type": "subtitle", "time": 2457.829, "timestamp": "00:40:57", "text": "私たちが行うであろうことと同じです"}]
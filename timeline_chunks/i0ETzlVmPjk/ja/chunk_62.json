[{"type": "subtitle", "time": 3720.87, "timestamp": "01:02:00", "text": "。 音声コマンドはこのように使用できます"}, {"type": "subtitle", "time": 3722.95, "timestamp": "01:02:02", "text": "。   うまくいけばね"}, {"type": "subtitle", "time": 3726.47, "timestamp": "01:02:06", "text": "。 私はローンチヴァラント"}, {"type": "subtitle", "time": 3728.63, "timestamp": "01:02:08", "text": "とヘッドパッドなどを持っています。 あ、待って。 それはただそれを聞いていただけだった"}, {"type": "subtitle", "time": 3731.67, "timestamp": "01:02:11", "text": "。 ああ、そうか"}, {"type": "subtitle", "time": 3734.71, "timestamp": "01:02:14", "text": "、"}, {"type": "subtitle", "time": 3737.75, "timestamp": "01:02:17", "text": "音声コマンドとかでこれらの機能を作動させることができるんだね。"}, {"type": "subtitle", "time": 3740.309, "timestamp": "01:02:20", "text": "あるいは、もっと良くしたい場合は、"}, {"type": "subtitle", "time": 3743.99, "timestamp": "01:02:23", "text": "ボイスアタックを使うこともできます。 私は"}, {"type": "subtitle", "time": 3746.95, "timestamp": "01:02:26", "text": "このソフトウェアを購入しました。"}, {"type": "subtitle", "time": 3750.39, "timestamp": "01:02:30", "text": "音声攻撃や"}, {"type": "subtitle", "time": 3752.87, "timestamp": "01:02:32", "text": "音声起動式の機器も使えるよ。"}, {"type": "subtitle", "time": 3755.43, "timestamp": "01:02:35", "text": "ずっと昔、ずっと昔に、"}, {"type": "subtitle", "time": 3758.63, "timestamp": "01:02:38", "text": "自分の声を使って"}, {"type": "subtitle", "time": 3762.069, "timestamp": "01:02:42", "text": "ゲームをプレイするボイスコマンダー配信をやっていました。 私は、上、下、"}, {"type": "subtitle", "time": 3766.63, "timestamp": "01:02:46", "text": "左、右、攻撃、防御、ブロック、"}, {"type": "subtitle", "time": 3770.069, "timestamp": "01:02:50", "text": "シュートといった感じで動きます。 昔はよくやっていたよ"}, {"type": "subtitle", "time": 3773.19, "timestamp": "01:02:53", "text": "。 あの配信が懐かしいよ。 そうすべきだ"}, {"type": "subtitle", "time": 3779.43, "timestamp": "01:02:59", "text": "チャット参加者が"}]
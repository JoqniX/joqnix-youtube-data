[{"type": "subtitle", "time": 13202.07, "timestamp": "03:40:02", "text": "配信チャット。 わかった、ここで君を見つけなきゃ"}, {"type": "subtitle", "time": 13205.03, "timestamp": "03:40:05", "text": "。 歪んでいる。"}, {"type": "subtitle", "time": 13215.75, "timestamp": "03:40:15", "text": "あのね？ 削除し"}, {"type": "subtitle", "time": 13218.63, "timestamp": "03:40:18", "text": "て保存します。"}, {"type": "subtitle", "time": 13221.429, "timestamp": "03:40:21", "text": "それでは、チャットに何か入力してください。 今すぐ"}, {"type": "subtitle", "time": 13224.95, "timestamp": "03:40:24", "text": "あなたのためにスレッドを作成したかったんです。"}, {"type": "subtitle", "time": 13240.71, "timestamp": "03:40:40", "text": "ああ、うまくいった。 成功した。 わーい。 まずは見に行こう"}, {"type": "subtitle", "time": 13246.07, "timestamp": "03:40:46", "text": "。 よし、そのまま入力を続けてください。 うまくいくかどうか見てみましょう"}, {"type": "subtitle", "time": 13258.15, "timestamp": "03:40:58", "text": "うん、うまくいくよ。 それは動作します。 わーい。 はい。 はい。"}]
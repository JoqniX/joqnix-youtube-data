[{"type": "subtitle", "time": 12480.95, "timestamp": "03:28:00", "text": "？ そして、私の"}, {"type": "subtitle", "time": 12484.389, "timestamp": "03:28:04", "text": "Twitchカテゴリをチェックします。カテゴリはこちらです。"}, {"type": "subtitle", "time": 12486.71, "timestamp": "03:28:06", "text": "私のTwitchカテゴリをチェックします。"}, {"type": "subtitle", "time": 12489.75, "timestamp": "03:28:09", "text": "つまり、ここでは私のタイトルと"}, {"type": "subtitle", "time": 12491.11, "timestamp": "03:28:11", "text": "Twitchのカテゴリをチェックしているということですね。 現在、私は"}, {"type": "subtitle", "time": 12494.87, "timestamp": "03:28:14", "text": "共同作業と勉強をしています。つまり、"}, {"type": "subtitle", "time": 12501.11, "timestamp": "03:28:21", "text": "Twitch からストリーム情報を取得し、Twitch"}, {"type": "subtitle", "time": 12504.229, "timestamp": "03:28:24", "text": "カテゴリを YouTube のプレイリスト リンクにリンクします。"}, {"type": "subtitle", "time": 12506.389, "timestamp": "03:28:26", "text": "たとえば、共同作業と"}, {"type": "subtitle", "time": 12510.07, "timestamp": "03:28:30", "text": "勉強の場合、私のシナリオでは、"}, {"type": "subtitle", "time": 12512.63, "timestamp": "03:28:32", "text": "2 つのプレイリストがあり、1 つは共同作業用、もう 1 つは"}, {"type": "subtitle", "time": 12516.95, "timestamp": "03:28:36", "text": "勉強用です。ここで私がやったことは、"}, {"type": "subtitle", "time": 12521.19, "timestamp": "03:28:41", "text": "Twitch のタイトルをスキャンし、"}, {"type": "subtitle", "time": 12524.07, "timestamp": "03:28:44", "text": "左側の部分だけをスキャンすることです。"}, {"type": "subtitle", "time": 12527.03, "timestamp": "03:28:47", "text": "分離器を持っています。  YouTubeやTwitchの私のタイトルを見ると、"}, {"type": "subtitle", "time": 12532.15, "timestamp": "03:28:52", "text": "点線の縦の"}, {"type": "subtitle", "time": 12534.95, "timestamp": "03:28:54", "text": "区切り線のようなものがありますよね？ そう、何らかの"}, {"type": "subtitle", "time": 12538.229, "timestamp": "03:28:58", "text": "反応が起こるだろう。 拒否処理が行われ、"}]
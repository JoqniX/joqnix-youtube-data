[{"type": "subtitle", "time": 729.59, "timestamp": "00:12:09", "text": "ジョッカソン ストリーム中に再生されるかどうかは関係ありません。BRB"}, {"type": "subtitle", "time": 732.949, "timestamp": "00:12:12", "text": "V サイクルの第 3 回目の反復を実行したとき、"}, {"type": "chat", "time": 734.978, "timestamp": "00:12:14", "author": "@yashchourasia2215", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mbRu2gYmpEUO4nLl0jA2optOzbTHvVFqZhza3dfpPmwg=s64-c-k-c0x00ffffff-no-rj", "message": "How are you doingg ?, it's been soo many days"}, {"type": "subtitle", "time": 736.55, "timestamp": "00:12:16", "text": "私が気づいたのは、"}, {"type": "subtitle", "time": 738.71, "timestamp": "00:12:18", "text": "睡眠ストリーム、チャットストリーム、"}, {"type": "subtitle", "time": 741.03, "timestamp": "00:12:21", "text": "ランダム ゲーム ストリーム、"}, {"type": "subtitle", "time": 743.59, "timestamp": "00:12:23", "text": "シューティング ストリーム、時々"}, {"type": "subtitle", "time": 748.47, "timestamp": "00:12:28", "text": "MMO ゲームなど、さまざまなストリームがありましたが、"}, {"type": "subtitle", "time": 752.069, "timestamp": "00:12:32", "text": "ここでは通常のストリームを行い"}, {"type": "subtitle", "time": 754.47, "timestamp": "00:12:34", "text": "たいので、"}, {"type": "subtitle", "time": 757.11, "timestamp": "00:12:37", "text": "カテゴリ"}, {"type": "subtitle", "time": 759.67, "timestamp": "00:12:39", "text": "ベースのストリームにしたいのです。今日行うストリームの種類に応じて、"}, {"type": "subtitle", "time": 765.75, "timestamp": "00:12:45", "text": "以前のストリームからそのようなストリーム コンテンツを再生したいのです。これが第"}, {"type": "subtitle", "time": 767.91, "timestamp": "00:12:47", "text": "4 回目の反復であり、"}, {"type": "subtitle", "time": 774.949, "timestamp": "00:12:54", "text": "ストリーム関連のあらゆる場所で今日取り組むものです。 お元気ですか"}, {"type": "subtitle", "time": 777.269, "timestamp": "00:12:57", "text": "？ もう何日も経ちました。"}]
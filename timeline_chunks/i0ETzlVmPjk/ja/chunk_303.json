[{"type": "subtitle", "time": 18182.07, "timestamp": "05:03:02", "text": "。申し訳ありません。 えっと、でも、"}, {"type": "subtitle", "time": 18185.11, "timestamp": "05:03:05", "text": "ロックしてくれていたら本当に感謝しています。   来てくださった"}, {"type": "subtitle", "time": 18187.59, "timestamp": "05:03:07", "text": "皆様、ありがとうございました"}, {"type": "subtitle", "time": 18191.19, "timestamp": "05:03:11", "text": "。 本当に本当に嬉しいです。"}, {"type": "subtitle", "time": 18192.868, "timestamp": "05:03:12", "text": "いや。   ええと"}, {"type": "subtitle", "time": 18196.628, "timestamp": "05:03:16", "text": "、それでは皆さん、午前"}, {"type": "subtitle", "time": 18200.628, "timestamp": "05:03:20", "text": "7時の夜の深淵ストリームでお会いしましょう。つまり、"}, {"type": "subtitle", "time": 18204.39, "timestamp": "05:03:24", "text": "今から7時間後ですね。 こんにちは。   というわけで"}, {"type": "subtitle", "time": 18205.91, "timestamp": "05:03:25", "text": "、"}, {"type": "subtitle", "time": 18214.788, "timestamp": "05:03:34", "text": "私は寝ます。"}, {"type": "subtitle", "time": 18218.07, "timestamp": "05:03:38", "text": "今日は楽しかった。 楽しかったです。 やあ、おやすみ"}]
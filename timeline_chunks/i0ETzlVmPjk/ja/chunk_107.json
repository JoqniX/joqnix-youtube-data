[{"type": "subtitle", "time": 6422.79, "timestamp": "01:47:02", "text": "就労許可証はいらない。 あなたを自動化したい"}, {"type": "subtitle", "time": 6425.189, "timestamp": "01:47:05", "text": "。"}, {"type": "subtitle", "time": 6430.149, "timestamp": "01:47:10", "text": "これを自動化するにはどうすればいいですか？"}, {"type": "subtitle", "time": 6432.95, "timestamp": "01:47:12", "text": "私はタイプしたくない。 ただ"}, {"type": "subtitle", "time": 6435.37, "timestamp": "01:47:15", "text": "リラックスしたいだけ。"}, {"type": "subtitle", "time": 6439.43, "timestamp": "01:47:19", "text": "【音楽】見せてください"}, {"type": "subtitle", "time": 6449.59, "timestamp": "01:47:29", "text": "それは、私がプレイ"}, {"type": "subtitle", "time": 6454.55, "timestamp": "01:47:34", "text": "リストにどのようなタイトルを付けるかにもよりますよね？"}, {"type": "subtitle", "time": 6465.109, "timestamp": "01:47:45", "text": "ああ、"}, {"type": "subtitle", "time": 6469.109, "timestamp": "01:47:49", "text": "自分でさらに難しいことをより難しくしているんだ。 ええと、"}, {"type": "subtitle", "time": 6471.91, "timestamp": "01:47:51", "text": "こういうことが起こったんです。"}]
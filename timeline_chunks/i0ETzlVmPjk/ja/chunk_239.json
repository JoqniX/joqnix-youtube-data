[{"type": "subtitle", "time": 14342.63, "timestamp": "03:59:02", "text": "これが終わったら寝なければなりません。"}, {"type": "subtitle", "time": 14347.91, "timestamp": "03:59:07", "text": "あなたはジムに通っていますか？ いいえ。 私は"}, {"type": "subtitle", "time": 14351.51, "timestamp": "03:59:11", "text": "全く運動をしません。"}, {"type": "subtitle", "time": 14382.15, "timestamp": "03:59:42", "text": "送って溶かす運動はしません。つまり、"}, {"type": "subtitle", "time": 14389.91, "timestamp": "03:59:49", "text": "基本的に"}, {"type": "subtitle", "time": 14393.11, "timestamp": "03:59:53", "text": "これを複製して、"}, {"type": "subtitle", "time": 14396.07, "timestamp": "03:59:56", "text": "no cookie"}]
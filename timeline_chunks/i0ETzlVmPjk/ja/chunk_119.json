[{"type": "subtitle", "time": 7141.83, "timestamp": "01:59:01", "text": "文字列が"}, {"type": "subtitle", "time": 7145.109, "timestamp": "01:59:05", "text": "タイトルになります。"}, {"type": "subtitle", "time": 7152.31, "timestamp": "01:59:12", "text": "文字列変数を設定します。 これを引き下ろしてください。"}, {"type": "subtitle", "time": 7155.669, "timestamp": "01:59:15", "text": "変数名は"}, {"type": "subtitle", "time": 7163.109, "timestamp": "01:59:23", "text": "包装紙と一緒にここに置き、"}, {"type": "subtitle", "time": 7165.83, "timestamp": "01:59:25", "text": "例えば「夜にやるのが正しい」というタイトルを付けます"}, {"type": "subtitle", "time": 7168.95, "timestamp": "01:59:28", "text": "。 これはこのように配置すると、"}, {"type": "subtitle", "time": 7172.07, "timestamp": "01:59:32", "text": "このように動作し、"}, {"type": "subtitle", "time": 7175.589, "timestamp": "01:59:35", "text": "タイトルタイトルが固定され、"}, {"type": "subtitle", "time": 7179.51, "timestamp": "01:59:39", "text": "保存して実行されます。 うまくいくかどうか見てみましょう"}, {"type": "subtitle", "time": 7190.79, "timestamp": "01:59:50", "text": "物体。 うん。 ネットを作ってください。 わかった。  1番目は"}, {"type": "subtitle", "time": 7196.229, "timestamp": "01:59:56", "text": "1番目は有効です。 ゼロではない。"}, {"type": "subtitle", "time": 7198.149, "timestamp": "01:59:58", "text": "一言。"}]
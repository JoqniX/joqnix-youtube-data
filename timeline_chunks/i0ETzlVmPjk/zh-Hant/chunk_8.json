[{"type": "subtitle", "time": 487.27, "timestamp": "00:08:07", "text": "Protocol 串流。正確的。正確的。所以"}, {"type": "subtitle", "time": 492.869, "timestamp": "00:08:12", "text": "我今天的目標是，我們將"}, {"type": "subtitle", "time": 497.27, "timestamp": "00:08:17", "text": "創建一個基於設定類別的"}, {"type": "subtitle", "time": 500.39, "timestamp": "00:08:20", "text": "自動化 YouTube 播放清單字詞循環系統"}, {"type": "subtitle", "time": 507.27, "timestamp": "00:08:27", "text": "。所以，簡而言之，無論"}, {"type": "subtitle", "time": 511.27, "timestamp": "00:08:31", "text": "我進行什麼直播，任何直播都會出現在 YouTube 的一個播放清單中，對吧？這就是"}, {"type": "subtitle", "time": 516.63, "timestamp": "00:08:36", "text": "為什麼我的"}, {"type": "subtitle", "time": 518.949, "timestamp": "00:08:38", "text": "YouTube 頻道裡會有很多播放列表，所有我玩的"}, {"type": "subtitle", "time": 522.23, "timestamp": "00:08:42", "text": "遊戲，所有我做的"}, {"type": "subtitle", "time": 525.03, "timestamp": "00:08:45", "text": "普通休閒直播，比如"}, {"type": "subtitle", "time": 527.11, "timestamp": "00:08:47", "text": "聊天或一起工作直播，像今天的“和我一起工作”直播都會放在“一起工作”播放"}, {"type": "subtitle", "time": 533.67, "timestamp": "00:08:53", "text": "列表中。所以"}, {"type": "subtitle", "time": 536.55, "timestamp": "00:08:56", "text": "我喜歡把所有東西都加到播放清單裡。"}, {"type": "subtitle", "time": 539.03, "timestamp": "00:08:59", "text": "所以我的所有內容都"}]
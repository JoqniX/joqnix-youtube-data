[{"type": "subtitle", "time": 11302.79, "timestamp": "03:08:22", "text": "，把那個人也放在最上面。  正確的。我知道"}, {"type": "subtitle", "time": 11306.309, "timestamp": "03:08:26", "text": "我做了"}, {"type": "subtitle", "time": 11309.67, "timestamp": "03:08:29", "text": "這件事，但我們沒必要那麼做。  我們這就把它刪掉。  我正在將它們合併成一個"}, {"type": "subtitle", "time": 11313.51, "timestamp": "03:08:33", "text": "整體。太酷了。"}, {"type": "subtitle", "time": 11328.55, "timestamp": "03:08:48", "text": "我想將它合併到舊的設定中，使其成為第四個正式版本。  那肯定超酷"}]
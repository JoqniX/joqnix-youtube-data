[{"type": "subtitle", "time": 1441.51, "timestamp": "00:24:01", "text": "像《源神帝國》、《血之"}, {"type": "subtitle", "time": 1446.31, "timestamp": "00:24:06", "text": "協議》之類的遊戲。所以，"}, {"type": "subtitle", "time": 1452.39, "timestamp": "00:24:12", "text": "例如當我直播《原神》的時候"}, {"type": "subtitle", "time": 1454.31, "timestamp": "00:24:14", "text": "，我就會玩《原神》。好的，"}, {"type": "subtitle", "time": 1456.63, "timestamp": "00:24:16", "text": "假設我在玩原神。我切換到"}, {"type": "subtitle", "time": 1460.71, "timestamp": "00:24:20", "text": "VRB螢幕。好的。所以，從這 35 個"}, {"type": "subtitle", "time": 1464.87, "timestamp": "00:24:24", "text": "串流中，它會產生"}, {"type": "subtitle", "time": 1466.95, "timestamp": "00:24:26", "text": "相同的內容，無論你在"}, {"type": "subtitle", "time": 1469.75, "timestamp": "00:24:29", "text": "Genchin Impact 播放清單中看到什麼，你都可以在"}, {"type": "subtitle", "time": 1472.07, "timestamp": "00:24:32", "text": "這裡看到，而且這裡還會有一個隨機的"}, {"type": "subtitle", "time": 1475.83, "timestamp": "00:24:35", "text": "東西。這個順序就像是按時間順序排列的，從"}, {"type": "subtitle", "time": 1480.549, "timestamp": "00:24:40", "text": "三年前我第一次直播"}, {"type": "subtitle", "time": 1483.75, "timestamp": "00:24:43", "text": "到右上角最新的33。所以"}, {"type": "subtitle", "time": 1486.63, "timestamp": "00:24:46", "text": "這裡會隨機排列，像是"}, {"type": "subtitle", "time": 1490.71, "timestamp": "00:24:50", "text": "33、27、19、1、2等等，隨機排列，"}, {"type": "subtitle", "time": 1494.149, "timestamp": "00:24:54", "text": "這就是今天的目標，對吧？對，所以"}, {"type": "subtitle", "time": 1497.75, "timestamp": "00:24:57", "text": "這只是針對原神的，對吧？但是我們"}]
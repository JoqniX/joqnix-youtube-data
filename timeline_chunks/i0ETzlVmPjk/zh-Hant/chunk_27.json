[{"type": "subtitle", "time": 1623.029, "timestamp": "00:27:03", "text": "棘手。而且我還將其隨機化了。如"}, {"type": "subtitle", "time": 1626.31, "timestamp": "00:27:06", "text": "你所見，我重複執行的操作就像我們得到一個"}, {"type": "subtitle", "time": 1631.59, "timestamp": "00:27:11", "text": "隨機數字。所以這裡是零，因為"}, {"type": "subtitle", "time": 1635.029, "timestamp": "00:27:15", "text": "我不在現場，對吧？嗯，"}, {"type": "subtitle", "time": 1637.99, "timestamp": "00:27:17", "text": "我該如何展示這個呢？接下來怎麼辦？讓我來介紹一下"}, {"type": "subtitle", "time": 1642.47, "timestamp": "00:27:22", "text": "目前的遊戲場景。"}, {"type": "subtitle", "time": 1645.99, "timestamp": "00:27:25", "text": "然後我按下運行鍵。"}, {"type": "subtitle", "time": 1647.99, "timestamp": "00:27:27", "text": "哦，等等。我需要保存並運行它。"}, {"type": "subtitle", "time": 1651.269, "timestamp": "00:27:31", "text": "我會即時演示"}, {"type": "subtitle", "time": 1653.83, "timestamp": "00:27:33", "text": "這個按鈕是如何運作的。  是的"}, {"type": "subtitle", "time": 1658.47, "timestamp": "00:27:38", "text": "，它給了我 583 個影片。由此"}, {"type": "subtitle", "time": 1662.71, "timestamp": "00:27:42", "text": "我們得到一個隨機數，這個"}, {"type": "subtitle", "time": 1665.75, "timestamp": "00:27:45", "text": "隨機數是 456。"}, {"type": "subtitle", "time": 1669.669, "timestamp": "00:27:49", "text": "對吧？所以這些是隨機播放的1"}, {"type": "subtitle", "time": 1674.63, "timestamp": "00:27:54", "text": "到30號視訊串流。這些是隨機播放的視頻，它們"}, {"type": "subtitle", "time": 1677.43, "timestamp": "00:27:57", "text": "將被放入一個播放清單中。正確的？"}]
[{"type": "subtitle", "time": 3301.99, "timestamp": "00:55:01", "text": "你有超過 50 個播放清單嗎？"}, {"type": "subtitle", "time": 3304.71, "timestamp": "00:55:04", "text": "你打算如何一個一個地去"}, {"type": "subtitle", "time": 3307.829, "timestamp": "00:55:07", "text": "獲取正確的播放清單 ID 呢？"}, {"type": "subtitle", "time": 3310.23, "timestamp": "00:55:10", "text": "問得好。兄弟，我罩著你。不用"}, {"type": "subtitle", "time": 3314.63, "timestamp": "00:55:14", "text": "擔心。這時，我們將使用我們"}, {"type": "subtitle", "time": 3318.87, "timestamp": "00:55:18", "text": "方便的"}, {"type": "subtitle", "time": 3323.75, "timestamp": "00:55:23", "text": "命令 promote 來使用 YTDL。我做了"}, {"type": "subtitle", "time": 3326.79, "timestamp": "00:55:26", "text": "。我以前做過。讓我來拿。"}, {"type": "subtitle", "time": 3329.03, "timestamp": "00:55:29", "text": "我做到了。對，就是這樣"}, {"type": "subtitle", "time": 3331.829, "timestamp": "00:55:31", "text": "。這是頻道的全部"}, {"type": "subtitle", "time": 3335.03, "timestamp": "00:55:35", "text": "播放清單。所以，我們得到了杜夜深淵。我們"}, {"type": "subtitle", "time": 3336.549, "timestamp": "00:55:36", "text": "有《"}, {"type": "subtitle", "time": 3342.15, "timestamp": "00:55:42", "text": "戰地4》，我們有《Pay Trigger》、《"}, {"type": "subtitle", "time": 3345.109, "timestamp": "00:55:45", "text": "Fel 6》和《Goose Goose Dag》。所有"}, {"type": "subtitle", "time": 3347.75, "timestamp": "00:55:47", "text": "播放清單都在這裡。正確的。我"}, {"type": "subtitle", "time": 3351.51, "timestamp": "00:55:51", "text": "以前做過這件事。我使用了 Chad GPT 來幫助我。"}, {"type": "subtitle", "time": 3354.309, "timestamp": "00:55:54", "text": "所以我只需要得到「是」。  是的。"}, {"type": "subtitle", "time": 3357.51, "timestamp": "00:55:57", "text": "這個。所以我將透過這種方式取得ID"}]
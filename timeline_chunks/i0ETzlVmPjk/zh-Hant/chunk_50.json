[{"type": "subtitle", "time": 3001.67, "timestamp": "00:50:01", "text": "所以基本上我們有兩個播放清單。一間"}, {"type": "subtitle", "time": 3003.75, "timestamp": "00:50:03", "text": "是用於共享辦公，一間是用於"}, {"type": "subtitle", "time": 3005.99, "timestamp": "00:50:05", "text": "學習，例如語言學習、"}, {"type": "subtitle", "time": 3008.79, "timestamp": "00:50:08", "text": "日語學習等等，對吧？那將會是"}, {"type": "subtitle", "time": 3011.99, "timestamp": "00:50:11", "text": "個問題。嗯，我稍後會解決這個問題。"}, {"type": "subtitle", "time": 3014.309, "timestamp": "00:50:14", "text": "我有個主意。我稍後會做。是的。是的。我們還是"}, {"type": "subtitle", "time": 3017.27, "timestamp": "00:50:17", "text": "別這麼做了。我們就玩"}, {"type": "subtitle", "time": 3019.91, "timestamp": "00:50:19", "text": "第一局吧。  我們就隨便"}, {"type": "subtitle", "time": 3027.03, "timestamp": "00:50:27", "text": "聊聊吧。我們就隨便"}, {"type": "subtitle", "time": 3029.589, "timestamp": "00:50:29", "text": "聊聊吧。"}, {"type": "subtitle", "time": 3033.91, "timestamp": "00:50:33", "text": "不懂版權梗。下一個。"}, {"type": "subtitle", "time": 3037.43, "timestamp": "00:50:37", "text": "好的。只是閒聊。我複製了網址，然後把"}, {"type": "subtitle", "time": 3040.71, "timestamp": "00:50:40", "text": "它貼在這裡。"}, {"type": "subtitle", "time": 3044.71, "timestamp": "00:50:44", "text": "我們把螞蟻東西移走了。 URL"}, {"type": "subtitle", "time": 3048.39, "timestamp": "00:50:48", "text": "參數。好的。直播將在"}, {"type": "subtitle", "time": 3051.03, "timestamp": "00:50:51", "text": "Twitch平台進行。只是閒聊而已。如果我"}, {"type": "subtitle", "time": 3055.349, "timestamp": "00:50:55", "text": "能找到正確的格式。"}, {"type": "subtitle", "time": 3057.589, "timestamp": "00:50:57", "text": "不是。是的。只是閒聊。大寫字母"}, {"type": "subtitle", "time": 3059.51, "timestamp": "00:50:59", "text": "C。"}]
[{"type": "subtitle", "time": 186.47, "timestamp": "00:03:06", "text": "嗯，是的，"}, {"type": "subtitle", "time": 188.47, "timestamp": "00:03:08", "text": "我今天好像沒有"}, {"type": "subtitle", "time": 193.99, "timestamp": "00:03:13", "text": "語言課。所以我就想，"}, {"type": "subtitle", "time": 198.39, "timestamp": "00:03:18", "text": "嗯，我今天就做個工作直播吧。嗯"}, {"type": "subtitle", "time": 200.71, "timestamp": "00:03:20", "text": "，今天我們會做一些"}, {"type": "subtitle", "time": 203.67000000000002, "timestamp": "00:03:23", "text": "技術性的事情。我可能會放點"}, {"type": "subtitle", "time": 207.43, "timestamp": "00:03:27", "text": "音樂，然後我們就會"}, {"type": "subtitle", "time": 210.789, "timestamp": "00:03:30", "text": "聊天、工作。"}, {"type": "subtitle", "time": 213.589, "timestamp": "00:03:33", "text": "就是這樣。嗯，"}, {"type": "subtitle", "time": 216.869, "timestamp": "00:03:36", "text": "工作和測試完成後，"}, {"type": "subtitle", "time": 219.589, "timestamp": "00:03:39", "text": "嗯，我們會玩一會兒《藍色協議》，"}, {"type": "subtitle", "time": 224.149, "timestamp": "00:03:44", "text": "為什麼不呢？嗯，是的，我們會玩《"}, {"type": "subtitle", "time": 227.19, "timestamp": "00:03:47", "text": "藍色協議》之類的遊戲，看看效果如何"}, {"type": "subtitle", "time": 231.19, "timestamp": "00:03:51", "text": "。呃，因為40級裝備"}, {"type": "subtitle", "time": 234.22899999999998, "timestamp": "00:03:54", "text": "今天上線。不，不是40級。呃，60級裝備"}, {"type": "subtitle", "time": 235.82999999999998, "timestamp": "00:03:55", "text": "今天就出來了。所以，我很期待"}]
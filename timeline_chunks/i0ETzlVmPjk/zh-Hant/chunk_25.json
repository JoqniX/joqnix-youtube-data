[{"type": "subtitle", "time": 1500.549, "timestamp": "00:25:00", "text": "必須對所有遊戲都這樣做，"}, {"type": "subtitle", "time": 1511.11, "timestamp": "00:25:11", "text": "呃，對於4.1版本，"}, {"type": "subtitle", "time": 1513.43, "timestamp": "00:25:13", "text": "這是第四次迭代，所以像"}, {"type": "subtitle", "time": 1515.99, "timestamp": "00:25:15", "text": "這樣。我會把《原神》的藍色協議加到我"}, {"type": "subtitle", "time": 1518.87, "timestamp": "00:25:18", "text": "所有的播放清單類別中，"}, {"type": "subtitle", "time": 1521.75, "timestamp": "00:25:21", "text": "就像這樣。我會像"}, {"type": "subtitle", "time": 1525.269, "timestamp": "00:25:25", "text": "這樣輸入播放清單 ID，"}, {"type": "subtitle", "time": 1528.549, "timestamp": "00:25:28", "text": "基本上和"}, {"type": "subtitle", "time": 1532.87, "timestamp": "00:25:32", "text": "舊版 3 的系統一樣。這是舊"}, {"type": "subtitle", "time": 1536.31, "timestamp": "00:25:36", "text": "按鈕。這大概包含多少"}, {"type": "subtitle", "time": 1540.71, "timestamp": "00:25:40", "text": "條指令？呃，這就像 419。"}, {"type": "subtitle", "time": 1543.269, "timestamp": "00:25:43", "text": "所以，呃，它的作用是"}, {"type": "subtitle", "time": 1545.75, "timestamp": "00:25:45", "text": "掃描我是否正在直播，是否正在串流媒體播放"}, {"type": "subtitle", "time": 1548.71, "timestamp": "00:25:48", "text": "，是否連接到 OBS，是否"}, {"type": "subtitle", "time": 1551.99, "timestamp": "00:25:51", "text": "未連接到 OBS，或者是否正在使用"}, {"type": "subtitle", "time": 1554.549, "timestamp": "00:25:54", "text": "Melt。今天我們用的是 Melt，不是"}, {"type": "subtitle", "time": 1556.71, "timestamp": "00:25:56", "text": "OBS。它會檢查我是否已連接到"}]
[{"type": "subtitle", "time": 542.55, "timestamp": "00:09:02", "text": "整理好了，對吧？所以，"}, {"type": "subtitle", "time": 545.19, "timestamp": "00:09:05", "text": "如果，"}, {"type": "subtitle", "time": 547.35, "timestamp": "00:09:07", "text": "比如說，如果我在直播玩遊戲"}, {"type": "subtitle", "time": 550.47, "timestamp": "00:09:10", "text": "，然後離開 5 到 10"}, {"type": "subtitle", "time": 553.03, "timestamp": "00:09:13", "text": "分鐘，我希望你們能欣賞一些我以前製作或直播的內容，對吧"}, {"type": "subtitle", "time": 558.63, "timestamp": "00:09:18", "text": "？無論是視訊還是"}, {"type": "subtitle", "time": 560.87, "timestamp": "00:09:20", "text": "串流媒體，對吧？目前，我們都只專注於直播。是的"}, {"type": "subtitle", "time": 563.43, "timestamp": "00:09:23", "text": "。嗯，"}, {"type": "subtitle", "time": 566.31, "timestamp": "00:09:26", "text": "我想玩那個遊戲。所以，我想做一個系統，例如，如果我在玩《原神》遊戲，呃，"}, {"type": "subtitle", "time": 575.03, "timestamp": "00:09:35", "text": "如果是《原神》的直播，我想離開遊戲，掛機的時候，我"}, {"type": "subtitle", "time": 577.75, "timestamp": "00:09:37", "text": "希望播放《原神》播放列表中的"}, {"type": "subtitle", "time": 581.91, "timestamp": "00:09:41", "text": "一個隨機詞"}, {"type": "subtitle", "time": 585.43, "timestamp": "00:09:45", "text": "。例如，我在我的頻道裡，在"}, {"type": "subtitle", "time": 591.43, "timestamp": "00:09:51", "text": "genad cate 播放清單中大概做了 35 個直播，"}, {"type": "subtitle", "time": 594.79, "timestamp": "00:09:54", "text": "這就是我做的"}, {"type": "subtitle", "time": 596.63, "timestamp": "00:09:56", "text": "直播數量，對吧？所以在這"}]
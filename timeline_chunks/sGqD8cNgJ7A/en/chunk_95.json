[{"type": "subtitle", "time": 5724.87, "timestamp": "01:35:24", "text": ">> How much bullets do I need to feed him"}, {"type": "subtitle", "time": 5727.51, "timestamp": "01:35:27", "text": "for him to die?"}, {"type": "subtitle", "time": 5751.27, "timestamp": "01:35:51", "text": "We control more sectors than the enemy."}, {"type": "subtitle", "time": 5755.11, "timestamp": "01:35:55", "text": ">> We have taken Fox."}, {"type": "subtitle", "time": 5758.07, "timestamp": "01:35:58", "text": ">> I feel like I should"}, {"type": "subtitle", "time": 5759.83, "timestamp": "01:35:59", "text": "get a sniper and pew pew pew pew."}]
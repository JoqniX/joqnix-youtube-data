[{"type": "subtitle", "time": 301.749, "timestamp": "00:05:01", "text": "大概是下午六七点吧。 对"}, {"type": "subtitle", "time": 308.39, "timestamp": "00:05:08", "text": "印度来说，对吧？ 是的，我知道"}, {"type": "subtitle", "time": 311.11, "timestamp": "00:05:11", "text": "我的大多数老观众以前都是在"}, {"type": "subtitle", "time": 313.35, "timestamp": "00:05:13", "text": "晚上，比如晚上十点左右看我的节目"}, {"type": "subtitle", "time": 315.189, "timestamp": "00:05:15", "text": "。"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "呃，晚上10点或9点。  IST。"}, {"type": "subtitle", "time": 323.189, "timestamp": "00:05:23", "text": "所以，"}, {"type": "subtitle", "time": 325.59, "timestamp": "00:05:25", "text": "我对音乐一窍不通。 感觉有点奇怪"}, {"type": "subtitle", "time": 338.31, "timestamp": "00:05:38", "text": "让我切换到我的游戏。"}, {"type": "subtitle", "time": 341.43, "timestamp": "00:05:41", "text": "一秒钟。"}, {"type": "subtitle", "time": 349.99, "timestamp": "00:05:49", "text": "你能看到吗？ 是的，你可以看到。   是的"}, {"type": "subtitle", "time": 352.95, "timestamp": "00:05:52", "text": "。 所以，我想刷一个"}, {"type": "subtitle", "time": 356.469, "timestamp": "00:05:56", "text": "叫“暴风雨”的特定干员。"}, {"type": "subtitle", "time": 359.749, "timestamp": "00:05:59", "text": "她有一头红发。 她看起来很漂亮。"}]
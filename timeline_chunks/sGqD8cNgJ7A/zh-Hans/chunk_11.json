[{"type": "subtitle", "time": 661.269, "timestamp": "00:11:01", "text": "这是什么枪？我该怎么更换"}, {"type": "subtitle", "time": 669.67, "timestamp": "00:11:09", "text": "目标位置最接近于逃离黑暗"}, {"type": "subtitle", "time": 671.59, "timestamp": "00:11:11", "text": "防御。"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "好的。 是的，我发现"}, {"type": "subtitle", "time": 679.269, "timestamp": "00:11:19", "text": "它运行缓慢。 我的网络太差了。 我的天，"}, {"type": "subtitle", "time": 681.829, "timestamp": "00:11:21", "text": "它正在下载一些东西。 我的天，卡"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "顿了。 它运行滞后。"}, {"type": "subtitle", "time": 693.59, "timestamp": "00:11:33", "text": "我死了。 到底是怎么回事？"}, {"type": "subtitle", "time": 712.63, "timestamp": "00:11:52", "text": "游戏运行卡"}, {"type": "subtitle", "time": 715.35, "timestamp": "00:11:55", "text": "顿，非常繁忙。"}, {"type": "subtitle", "time": 718.55, "timestamp": "00:11:58", "text": "我还活着吗？"}]
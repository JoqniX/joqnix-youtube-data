[{"type": "subtitle", "time": 1632.87, "timestamp": "00:27:12", "text": "呃，在此之前，让我先稍微调整一下"}, {"type": "subtitle", "time": 1642.549, "timestamp": "00:27:22", "text": "即使现在画面都"}, {"type": "subtitle", "time": 1663.269, "timestamp": "00:27:43", "text": "外围都崩溃了。 突击队"}, {"type": "subtitle", "time": 1665.51, "timestamp": "00:27:45", "text": "冲入废墟。 确保前沿"}, {"type": "subtitle", "time": 1667.35, "timestamp": "00:27:47", "text": "射击阵地安全，避免"}, {"type": "subtitle", "time": 1667.99, "timestamp": "00:27:47", "text": "受到压力。"}]
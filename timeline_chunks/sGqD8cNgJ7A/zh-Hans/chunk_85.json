[{"type": "subtitle", "time": 5102.149, "timestamp": "01:25:02", "text": "我没有获得那种满足感。"}, {"type": "subtitle", "time": 5115.03, "timestamp": "01:25:15", "text": "是不是因为我玩得太投入"}, {"type": "subtitle", "time": 5119.43, "timestamp": "01:25:19", "text": "、太沉迷了，所以就想："}, {"type": "subtitle", "time": 5121.669, "timestamp": "01:25:21", "text": "“是啊，我想要，但我没钱"}, {"type": "subtitle", "time": 5125.83, "timestamp": "01:25:25", "text": "买。那"}, {"type": "subtitle", "time": 5150.07, "timestamp": "01:25:50", "text": "，我可以自动奔跑。好吧，我忘了我的"}, {"type": "subtitle", "time": 5153.43, "timestamp": "01:25:53", "text": "键盘是日文的。所以是打到"}]
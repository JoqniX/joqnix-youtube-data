[{"type": "subtitle", "time": 8706.309, "timestamp": "02:25:06", "text": "我不会像以前那样，比如，"}, {"type": "subtitle", "time": 8708.309, "timestamp": "02:25:08", "text": "你还记得去年我参加"}, {"type": "subtitle", "time": 8711.11, "timestamp": "02:25:11", "text": "Joathon的时候吗？我每天都在直播"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "这款游戏。 大概玩了12到24"}, {"type": "subtitle", "time": 8719.19, "timestamp": "02:25:19", "text": "小时，就像第一季那样。"}, {"type": "subtitle", "time": 8723.27, "timestamp": "02:25:23", "text": "第一季结束后，"}, {"type": "subtitle", "time": 8727.59, "timestamp": "02:25:27", "text": "我连续玩了"}, {"type": "subtitle", "time": 8731.59, "timestamp": "02:25:31", "text": "好几天，然后突然就"}, {"type": "subtitle", "time": 8735.27, "timestamp": "02:25:35", "text": "换了游戏，之后就再也"}, {"type": "subtitle", "time": 8737.27, "timestamp": "02:25:37", "text": "没打开过那款游戏了"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "。"}, {"type": "subtitle", "time": 8743.429, "timestamp": "02:25:43", "text": "上次玩是去年"}, {"type": "subtitle", "time": 8748.23, "timestamp": "02:25:48", "text": "2025年5月，不是4月。是啊，是啊，就是"}, {"type": "subtitle", "time": 8755.67, "timestamp": "02:25:55", "text": "这样。我现在玩的游戏有原神、"}, {"type": "subtitle", "time": 8758.07, "timestamp": "02:25:58", "text": "鹰眼之星、"}]
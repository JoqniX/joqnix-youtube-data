[{"type": "subtitle", "time": 5724.87, "timestamp": "01:35:24", "text": "我得给他多少子弹才能"}, {"type": "subtitle", "time": 5727.51, "timestamp": "01:35:27", "text": "让他死？"}, {"type": "subtitle", "time": 5751.27, "timestamp": "01:35:51", "text": "我们控制的区域比敌人多。"}, {"type": "subtitle", "time": 5755.11, "timestamp": "01:35:55", "text": "我们占领了狐狸区。"}, {"type": "subtitle", "time": 5758.07, "timestamp": "01:35:58", "text": "我觉得我应该"}, {"type": "subtitle", "time": 5759.83, "timestamp": "01:35:59", "text": "拿个狙击枪，然后突突突突突突。"}]
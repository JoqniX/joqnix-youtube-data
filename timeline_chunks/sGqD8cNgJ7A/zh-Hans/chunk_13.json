[{"type": "subtitle", "time": 781.03, "timestamp": "00:13:01", "text": "背景中的静止画面。 仍然在"}, {"type": "subtitle", "time": 783.03, "timestamp": "00:13:03", "text": "背景中。 如果进程"}, {"type": "subtitle", "time": 784.79, "timestamp": "00:13:04", "text": "消失了"}, {"type": "subtitle", "time": 796.71, "timestamp": "00:13:16", "text": "它是在内核上运行还是在其他地方运行？"}, {"type": "subtitle", "time": 806.47, "timestamp": "00:13:26", "text": "为什么？"}, {"type": "subtitle", "time": 808.31, "timestamp": "00:13:28", "text": "我的天，它还在"}, {"type": "subtitle", "time": 810.629, "timestamp": "00:13:30", "text": "背景里。"}, {"type": "subtitle", "time": 814.71, "timestamp": "00:13:34", "text": "兄弟，你还是自杀吧。"}, {"type": "subtitle", "time": 817.43, "timestamp": "00:13:37", "text": "听起来太不对劲了。"}, {"type": "subtitle", "time": 820.949, "timestamp": "00:13:40", "text": "我的整台电脑都卡顿。 所有画面帧率均为 1"}, {"type": "subtitle", "time": 834.15, "timestamp": "00:13:54", "text": "我当时强行关闭它，然后"}, {"type": "subtitle", "time": 836.87, "timestamp": "00:13:56", "text": "鼠标就消失了。"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "怎么了？ 我无法"}]
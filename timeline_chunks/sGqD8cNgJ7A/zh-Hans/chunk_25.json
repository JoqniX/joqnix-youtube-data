[{"type": "subtitle", "time": 1504.95, "timestamp": "00:25:04", "text": "呃，"}, {"type": "subtitle", "time": 1507.83, "timestamp": "00:25:07", "text": "这款游戏试图对所有内容进行修改，而"}, {"type": "subtitle", "time": 1513.029, "timestamp": "00:25:13", "text": "不是更多。 是的。"}, {"type": "subtitle", "time": 1515.11, "timestamp": "00:25:15", "text": "呃，等一下。 我觉得我应该"}, {"type": "subtitle", "time": 1517.269, "timestamp": "00:25:17", "text": "改用"}, {"type": "subtitle", "time": 1522.39, "timestamp": "00:25:22", "text": "我认为我应该切换到无边框"}, {"type": "subtitle", "time": 1536.789, "timestamp": "00:25:36", "text": "我的队友们一个也不来。"}, {"type": "subtitle", "time": 1538.95, "timestamp": "00:25:38", "text": "我的意思是，它不是个人电脑。 这是一台笔记本电脑。"}, {"type": "subtitle", "time": 1540.71, "timestamp": "00:25:40", "text": "5060"}]
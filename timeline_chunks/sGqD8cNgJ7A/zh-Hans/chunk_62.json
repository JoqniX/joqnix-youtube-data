[{"type": "subtitle", "time": 3759.43, "timestamp": "01:02:39", "text": "等等，你觉得我的队友能听到"}, {"type": "subtitle", "time": 3761.51, "timestamp": "01:02:41", "text": "我说话吗？"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "不，你不是。"}, {"type": "subtitle", "time": 3766.549, "timestamp": "01:02:46", "text": "我们来谈谈吧。"}, {"type": "subtitle", "time": 3769.27, "timestamp": "01:02:49", "text": "这只猫很可怕。 它能迅速吸引人们的注意力"}, {"type": "subtitle", "time": 3772.39, "timestamp": "01:02:52", "text": "。 真的吗？"}]
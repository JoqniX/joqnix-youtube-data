[{"type": "subtitle", "time": 543.75, "timestamp": "00:09:03", "text": "尝试占领高地。 知道了。"}, {"type": "subtitle", "time": 545.67, "timestamp": "00:09:05", "text": "明白了。"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "我的直播可能会有延迟。 是的，但我可能需要把"}, {"type": "subtitle", "time": 553.19, "timestamp": "00:09:13", "text": "帧率调到"}, {"type": "subtitle", "time": 557.03, "timestamp": "00:09:17", "text": "永恒经典。   是的"}, {"type": "subtitle", "time": 560.15, "timestamp": "00:09:20", "text": "。 好的。 让我穿上我的"}, {"type": "subtitle", "time": 563.75, "timestamp": "00:09:23", "text": "电竞服。 呃，"}, {"type": "subtitle", "time": 566.949, "timestamp": "00:09:26", "text": "她的人民把和平视为理所当然。 她"}, {"type": "subtitle", "time": 568.87, "timestamp": "00:09:28", "text": "做这件事的时候信心十足。   我"}, {"type": "subtitle", "time": 571.43, "timestamp": "00:09:31", "text": "必须成为一名游戏玩家。"}, {"type": "subtitle", "time": 575.67, "timestamp": "00:09:35", "text": "脆弱不堪的国家。 但现在我一切都"}, {"type": "subtitle", "time": 578.07, "timestamp": "00:09:38", "text": "安排好了。 我准备好了。"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "我戴着我的游戏手套。"}, {"type": "subtitle", "time": 583.67, "timestamp": "00:09:43", "text": "我睡着了。"}, {"type": "subtitle", "time": 584.949, "timestamp": "00:09:44", "text": "只有在佩戴"}, {"type": "subtitle", "time": 588.47, "timestamp": "00:09:48", "text": "护臂时才会出现这种情况。   我们"}, {"type": "subtitle", "time": 591.59, "timestamp": "00:09:51", "text": "走吧。 袖套。"}, {"type": "subtitle", "time": 593.43, "timestamp": "00:09:53", "text": "捍卫者。 不要让任何事情影响你的判断，要"}, {"type": "subtitle", "time": 595.59, "timestamp": "00:09:55", "text": "小心，否则人们真的会失去你。啊，就像一切都很顺利一样"}, {"type": "subtitle", "time": 598.31, "timestamp": "00:09:58", "text": "。"}]
[{"type": "subtitle", "time": 2222.15, "timestamp": "00:37:02", "text": "生活太糟糕了。"}, {"type": "subtitle", "time": 2227.109, "timestamp": "00:37:07", "text": "我一击就把他撂倒了。 不错的爆头镜头。"}, {"type": "subtitle", "time": 2230.31, "timestamp": "00:37:10", "text": "但有时候生活就是这么美好。"}, {"type": "subtitle", "time": 2234.069, "timestamp": "00:37:14", "text": "至少我能开枪射击，这感觉"}, {"type": "subtitle", "time": 2273.589, "timestamp": "00:37:53", "text": "检测到敌对目标。"}]
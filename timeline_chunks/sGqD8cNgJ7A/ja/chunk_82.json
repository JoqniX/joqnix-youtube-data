[{"type": "subtitle", "time": 4929.75, "timestamp": "01:22:09", "text": "それは物語であり、"}, {"type": "subtitle", "time": 4933.189, "timestamp": "01:22:13", "text": "作戦であり、作戦がないのは"}, {"type": "subtitle", "time": 4936.07, "timestamp": "01:22:16", "text": "抽出です。"}, {"type": "subtitle", "time": 4938.47, "timestamp": "01:22:18", "text": "これは抽出のことです。"}, {"type": "subtitle", "time": 4942.47, "timestamp": "01:22:22", "text": "隠し場所などがあります。ああ、"}, {"type": "subtitle", "time": 4947.03, "timestamp": "01:22:27", "text": "ブラックサイドスペースシティゼロダウン。"}, {"type": "subtitle", "time": 4949.03, "timestamp": "01:22:29", "text": "私は別のアークを通したくない。"}, {"type": "subtitle", "time": 4961.59, "timestamp": "01:22:41", "text": "私は戦闘訓練の1つが好きです。 あのね"}, {"type": "subtitle", "time": 4965.27, "timestamp": "01:22:45", "text": "？ ボット相手に遊ぶだけにします。 もしかしたら、俺には分から"}]
[{"type": "subtitle", "time": 8706.309, "timestamp": "02:25:06", "text": "例えば、"}, {"type": "subtitle", "time": 8711.11, "timestamp": "02:25:11", "text": "去年のジョアソンをやっていた時、"}, {"type": "subtitle", "time": 8715.59, "timestamp": "02:25:15", "text": "このゲームを毎日12時間から24"}, {"type": "subtitle", "time": 8719.19, "timestamp": "02:25:19", "text": "時間配信していたのを覚えてる？スケジュール1みたいな感じ。"}, {"type": "subtitle", "time": 8723.27, "timestamp": "02:25:23", "text": "それで、スケジュール1のシーズンが終わった後、つまり何日もプレイしていたあの期間が終わって、突然"}, {"type": "subtitle", "time": 8735.27, "timestamp": "02:25:35", "text": "ゲームを変えて、それ以来、"}, {"type": "subtitle", "time": 8737.27, "timestamp": "02:25:37", "text": "そのゲームを開いてないんだ"}, {"type": "subtitle", "time": 8739.429, "timestamp": "02:25:39", "text": "。"}, {"type": "subtitle", "time": 8743.429, "timestamp": "02:25:43", "text": "最後にプレイしたのは去年の"}, {"type": "subtitle", "time": 8748.23, "timestamp": "02:25:48", "text": "2025年5月、4月じゃなくて5月だよ。"}, {"type": "subtitle", "time": 8750.23, "timestamp": "02:25:50", "text": "うん、うん、うん。そうなるだろうね"}, {"type": "subtitle", "time": 8755.67, "timestamp": "02:25:55", "text": "。それで今は、原神、"}, {"type": "subtitle", "time": 8758.07, "timestamp": "02:25:58", "text": "ホークアイ・スター、"}]
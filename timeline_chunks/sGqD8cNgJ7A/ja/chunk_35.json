[{"type": "subtitle", "time": 2121.829, "timestamp": "00:35:21", "text": "私たちはどこへ行くのですか？   何てことだ"}, {"type": "subtitle", "time": 2125.349, "timestamp": "00:35:25", "text": "。 おそらく、"}, {"type": "subtitle", "time": 2128.79, "timestamp": "00:35:28", "text": "私が参加した時と同じでしょう。"}, {"type": "subtitle", "time": 2130.55, "timestamp": "00:35:30", "text": "悪いことだと言っているわけではありません。 多分、"}, {"type": "subtitle", "time": 2134.79, "timestamp": "00:35:34", "text": "私が本格的に参加するにつれて、あなたの成長ぶりを見せてくれると思うよ。"}, {"type": "subtitle", "time": 2136.95, "timestamp": "00:35:36", "text": "うん、言いたいことはわかるよ。 うん。 うん。"}, {"type": "subtitle", "time": 2141.349, "timestamp": "00:35:41", "text": "うん。 というわけで、そういうことだ。"}, {"type": "subtitle", "time": 2143.589, "timestamp": "00:35:43", "text": "どうやって終了すればいいですか？ もし私が脱出したら、"}, {"type": "subtitle", "time": 2145.75, "timestamp": "00:35:45", "text": "パラシュートは出るのでしょうか？それとも死んでしまうのでしょうか？ 連合"}, {"type": "subtitle", "time": 2148.95, "timestamp": "00:35:48", "text": "軍がチャーリー軍への攻撃を開始した。"}, {"type": "subtitle", "time": 2151.109, "timestamp": "00:35:51", "text": "えっと、全部ピクセル化されてる。 何も"}, {"type": "subtitle", "time": 2153.829, "timestamp": "00:35:53", "text": "見えないよ、兄弟。"}, {"type": "subtitle", "time": 2156.39, "timestamp": "00:35:56", "text": "出口はありますか？"}, {"type": "subtitle", "time": 2159.67, "timestamp": "00:35:59", "text": "ああ、くそ。"}]
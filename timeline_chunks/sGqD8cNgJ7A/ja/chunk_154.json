[{"type": "subtitle", "time": 9243.99, "timestamp": "02:34:03", "text": "時間後、土曜日の午前2時頃に、Call of"}, {"type": "subtitle", "time": 9246.55, "timestamp": "02:34:06", "text": "Duty"}, {"type": "subtitle", "time": 9250.55, "timestamp": "02:34:10", "text": "Modern Warfare 4のベータ版が配信されます。"}, {"type": "chat", "time": 9251.239, "timestamp": "02:34:11", "author": "@wildan19gta73", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ltgSuqdkVmFy7b8YNX34dHb6whG0lODXr6m68zEAgk=s64-c-k-c0x00ffffff-no-rj", "message": "Sleep. You'll need it"}, {"type": "subtitle", "time": 9257.51, "timestamp": "02:34:17", "text": "なので、土曜日は仕事があると思います。早起きして、"}, {"type": "subtitle", "time": 9260.469, "timestamp": "02:34:20", "text": "配信をして、"}, {"type": "subtitle", "time": 9263.51, "timestamp": "02:34:23", "text": "仕事に行って、"}, {"type": "subtitle", "time": 9268.07, "timestamp": "02:34:28", "text": "夜遅くに帰ってきて、また配信するか、何かするかもしれません"}, {"type": "subtitle", "time": 9270.469, "timestamp": "02:34:30", "text": "。分かりません。あまり配信はしませんが"}, {"type": "subtitle", "time": 9272.469, "timestamp": "02:34:32", "text": "、他にも"}, {"type": "subtitle", "time": 9275.27, "timestamp": "02:34:35", "text": "優先すべきことがあります。"}, {"type": "subtitle", "time": 9277.51, "timestamp": "02:34:37", "text": "日曜日は配信はありません。"}, {"type": "subtitle", "time": 9280.87, "timestamp": "02:34:40", "text": "シンジグに行くからです。実は、"}, {"type": "subtitle", "time": 9283.99, "timestamp": "02:34:43", "text": "参加しなければならないイベントがあるんです。"}, {"type": "subtitle", "time": 9294.71, "timestamp": "02:34:54", "text": "すぐには戻れないかもしれませんが、そういうことです。そして月曜日は、面接があります"}]
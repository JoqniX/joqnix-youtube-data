[{"type": "subtitle", "time": 3759.43, "timestamp": "01:02:39", "text": "待って、私のチームメイトは私の声を聞いていると思う"}, {"type": "subtitle", "time": 3761.51, "timestamp": "01:02:41", "text": "？"}, {"type": "subtitle", "time": 3763.589, "timestamp": "01:02:43", "text": "いいえ、違います。"}, {"type": "subtitle", "time": 3766.549, "timestamp": "01:02:46", "text": "話し合いましょう。"}, {"type": "subtitle", "time": 3769.27, "timestamp": "01:02:49", "text": "その猫は怖い。 それは人々の心をあっという間に掴むことができる"}, {"type": "subtitle", "time": 3772.39, "timestamp": "01:02:52", "text": "。 本当に？"}]
[{"type": "subtitle", "time": 5761.75, "timestamp": "01:36:01", "text": "みんな"}, {"type": "subtitle", "time": 5765.11, "timestamp": "01:36:05", "text": "遠距離からのピューピューが好きだ"}, {"type": "subtitle", "time": 5768.31, "timestamp": "01:36:08", "text": "けど、俺は今すぐ死ななきゃいけない。どうやって"}, {"type": "subtitle", "time": 5774.07, "timestamp": "01:36:14", "text": "分からない。"}, {"type": "subtitle", "time": 5776.79, "timestamp": "01:36:16", "text": "ちょっとの間、俺を殺してくれないか？"}, {"type": "subtitle", "time": 5779.669, "timestamp": "01:36:19", "text": "本当に感謝するよ。"}, {"type": "subtitle", "time": 5781.51, "timestamp": "01:36:21", "text": "ありがとう。"}, {"type": "subtitle", "time": 5783.189, "timestamp": "01:36:23", "text": "心配しないで。君を見つけに行くよ"}, {"type": "subtitle", "time": 5784.79, "timestamp": "01:36:24", "text": "。今行くよ"}, {"type": "subtitle", "time": 5788.79, "timestamp": "01:36:28", "text": "。心配しないで。"}, {"type": "subtitle", "time": 5794.39, "timestamp": "01:36:34", "text": "逃げるか、隠れることはできない。彼は"}, {"type": "subtitle", "time": 5797.669, "timestamp": "01:36:37", "text": "オーケー。ダメージ。大物。オーケー。大物らしい"}, {"type": "subtitle", "time": 5807.35, "timestamp": "01:36:47", "text": "どこだ？"}, {"type": "subtitle", "time": 5812.95, "timestamp": "01:36:52", "text": "スコープはどこに向かっているんだ？"}, {"type": "subtitle", "time": 5815.669, "timestamp": "01:36:55", "text": "どうやってやるつもりだ？"}]
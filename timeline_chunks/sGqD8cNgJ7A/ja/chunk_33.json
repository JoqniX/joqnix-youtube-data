[{"type": "subtitle", "time": 2008.63, "timestamp": "00:33:28", "text": "くそ。 くそ。 くそ。"}, {"type": "subtitle", "time": 2012.549, "timestamp": "00:33:32", "text": "あなたの新しいアバターにはまだ慣れていません。"}, {"type": "subtitle", "time": 2014.149, "timestamp": "00:33:34", "text": "時間がかかるだろう。"}, {"type": "subtitle", "time": 2017.269, "timestamp": "00:33:37", "text": "私は怪我をしています。"}, {"type": "subtitle", "time": 2020.149, "timestamp": "00:33:40", "text": "でも俺は相変わらずスポーツマンだから、あまり"}]
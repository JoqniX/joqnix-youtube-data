[{"type": "subtitle", "time": 2164.069, "timestamp": "00:36:04", "text": "私は、そうすべきではなかったのですが、"}, {"type": "subtitle", "time": 2166.31, "timestamp": "00:36:06", "text": "建物の中に入り、"}, {"type": "subtitle", "time": 2167.67, "timestamp": "00:36:07", "text": "死んでしまいました。"}, {"type": "subtitle", "time": 2203.19, "timestamp": "00:36:43", "text": "[叫び声]"}, {"type": "subtitle", "time": 2209.91, "timestamp": "00:36:49", "text": "救急隊員、助けて。"}, {"type": "subtitle", "time": 2211.27, "timestamp": "00:36:51", "text": "ありがとう。 ありがとうございます。"}, {"type": "subtitle", "time": 2214.87, "timestamp": "00:36:54", "text": "あなたは私の命を救ってくれた。 ありがとう。"}, {"type": "subtitle", "time": 2218.71, "timestamp": "00:36:58", "text": "FPSゲームで苦戦してるんだよ。"}]
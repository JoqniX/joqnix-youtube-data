[{"type": "subtitle", "time": 4745.83, "timestamp": "01:19:05", "text": "くそ。 彼は狙撃手から私を救ってくれた。 なぜ"}, {"type": "subtitle", "time": 4757.83, "timestamp": "01:19:17", "text": "敵の"}, {"type": "subtitle", "time": 4767.75, "timestamp": "01:19:27", "text": "でもここは厳密に言えば戦場ですよね"}, {"type": "subtitle", "time": 4769.35, "timestamp": "01:19:29", "text": "？"}, {"type": "subtitle", "time": 4771.59, "timestamp": "01:19:31", "text": "あなたが使っているキャラクターの前には、araという文字がありました"}, {"type": "subtitle", "time": 4774.55, "timestamp": "01:19:34", "text": "。 この崩壊現象は、これと呼ばれています"}, {"type": "subtitle", "time": 4776.07, "timestamp": "01:19:36", "text": "。"}, {"type": "subtitle", "time": 4779.189, "timestamp": "01:19:39", "text": "どれ？ アルカナイトとはどれのことですか？"}, {"type": "subtitle", "time": 4796.55, "timestamp": "01:19:56", "text": "全員帰ってしまったの？ だから、あの"}, {"type": "subtitle", "time": 4799.75, "timestamp": "01:19:59", "text": "ロビーに残っているのは私だけなんです。"}]
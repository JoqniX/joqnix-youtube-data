[{"type": "subtitle", "time": 5102.149, "timestamp": "01:25:02", "text": "私はその満足感を得られない。"}, {"type": "subtitle", "time": 5115.03, "timestamp": "01:25:15", "text": "やり込みすぎて"}, {"type": "subtitle", "time": 5119.43, "timestamp": "01:25:19", "text": "、あまりにもプレイしすぎて、"}, {"type": "subtitle", "time": 5121.669, "timestamp": "01:25:21", "text": "「ああ、欲しいけど、買うお金がない。"}, {"type": "subtitle", "time": 5131.189, "timestamp": "01:25:31", "text": "無料の期間限定でじっくり味わって、"}, {"type": "subtitle", "time": 5150.07, "timestamp": "01:25:50", "text": "ああ、オートランできる。あ、"}, {"type": "subtitle", "time": 5153.43, "timestamp": "01:25:53", "text": "日本語キーボードを使ってるのを忘れてた。だから、マークまでじゃなくて、"}]
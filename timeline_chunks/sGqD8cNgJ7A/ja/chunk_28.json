[{"type": "subtitle", "time": 1682.07, "timestamp": "00:28:02", "text": "時間的超"}, {"type": "subtitle", "time": 1702.31, "timestamp": "00:28:22", "text": "私は何をしているのだろう？ なぜこんなにぼやけているのですか？"}, {"type": "subtitle", "time": 1704.389, "timestamp": "00:28:24", "text": "ああ、時間的な時間的な"}, {"type": "subtitle", "time": 1707.75, "timestamp": "00:28:27", "text": "ものは良くない。"}, {"type": "subtitle", "time": 1722.789, "timestamp": "00:28:42", "text": "バランスが取れていると思う。"}]
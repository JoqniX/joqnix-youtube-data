[{"type": "subtitle", "time": 7334.95, "timestamp": "02:02:14", "text": "ちょっと待って。自分の"}, {"type": "subtitle", "time": 7337.589, "timestamp": "02:02:17", "text": "ストリームを見てみよう。"}, {"type": "subtitle", "time": 7355.109, "timestamp": "02:02:35", "text": "死んでる。"}, {"type": "subtitle", "time": 7357.75, "timestamp": "02:02:37", "text": "でも視覚的には何が起きたんだ？なんてこった。ちょっと待って。"}, {"type": "subtitle", "time": 7365.03, "timestamp": "02:02:45", "text": "OBSを再起動しないといけないみたい。"}, {"type": "subtitle", "time": 7366.79, "timestamp": "02:02:46", "text": "ああ、まずい。わかった"}]
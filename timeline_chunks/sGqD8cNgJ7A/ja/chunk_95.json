[{"type": "subtitle", "time": 5727.51, "timestamp": "01:35:27", "text": "殺すには、どれだけの弾丸を撃ち込めばいいんだ？信じられない"}, {"type": "subtitle", "time": 5751.27, "timestamp": "01:35:51", "text": "敵よりも多くのセクターを支配している。"}, {"type": "subtitle", "time": 5755.11, "timestamp": "01:35:55", "text": "フォックスを奪取した。"}, {"type": "subtitle", "time": 5759.83, "timestamp": "01:35:59", "text": "スナイパーライフルを手に入れて、ピューピューピューピュー撃ちたい気分だ。"}]
[{"type": "subtitle", "time": 2763.99, "timestamp": "00:46:03", "text": "私が見せられた秘密は、日本時間です。 はい、それは"}, {"type": "subtitle", "time": 2799.829, "timestamp": "00:46:39", "text": "兄弟、ちゃんと殺せなかったんだ。   あれがどれだけ動作が"}, {"type": "subtitle", "time": 2803.829, "timestamp": "00:46:43", "text": "遅かったか、見ましたか？   まともにできなかった"}]
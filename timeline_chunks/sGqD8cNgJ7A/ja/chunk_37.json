[{"type": "subtitle", "time": 2222.15, "timestamp": "00:37:02", "text": "人生はなんてつまらないんだ。"}, {"type": "subtitle", "time": 2227.109, "timestamp": "00:37:07", "text": "私は彼をワンタップで倒した。 いい顔写真だね。"}, {"type": "subtitle", "time": 2230.31, "timestamp": "00:37:10", "text": "でも、人生って時々すごく素晴らしいよね。"}, {"type": "subtitle", "time": 2234.069, "timestamp": "00:37:14", "text": "少なくとも「ピューピュー」と撃てるだけでも、すごく"}, {"type": "subtitle", "time": 2273.589, "timestamp": "00:37:53", "text": "敵対行為を検知しました。"}]
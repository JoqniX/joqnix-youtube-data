[{"type": "subtitle", "time": 6601.51, "timestamp": "01:50:01", "text": "プレイ時間。現在のシーズン。待って、"}, {"type": "subtitle", "time": 6606.55, "timestamp": "01:50:06", "text": "全シーズン生涯使えるのか？2時間、"}, {"type": "subtitle", "time": 6609.109, "timestamp": "01:50:09", "text": "君の声を聞きながら、歌ったり、"}, {"type": "subtitle", "time": 6615.43, "timestamp": "01:50:15", "text": "分。一度も"}, {"type": "subtitle", "time": 6630.229, "timestamp": "01:50:30", "text": "オペレーター"}, {"type": "subtitle", "time": 6656.149, "timestamp": "01:50:56", "text": "。あ、待って。12時12分だ。12時だったのを"}, {"type": "subtitle", "time": 6658.55, "timestamp": "01:50:58", "text": "忘れてた。"}]
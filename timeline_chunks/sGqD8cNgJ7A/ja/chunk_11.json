[{"type": "subtitle", "time": 661.269, "timestamp": "00:11:01", "text": "この銃は何ですか？どうすれば変更できますか"}, {"type": "subtitle", "time": 669.67, "timestamp": "00:11:09", "text": "標的は、暗闇から逃れ、身を守る可能性が最も高い場所に位置している"}, {"type": "subtitle", "time": 671.59, "timestamp": "00:11:11", "text": "。   わかった"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "。 ええ、動作が"}, {"type": "subtitle", "time": 679.269, "timestamp": "00:11:19", "text": "遅いのは確認しました。 私のネットワーク環境は劣悪です。 ああ、"}, {"type": "subtitle", "time": 681.829, "timestamp": "00:11:21", "text": "ダウンロード中だ。 ああ、なんてことだ、動作が"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "遅い。 遅れている。"}, {"type": "subtitle", "time": 693.59, "timestamp": "00:11:33", "text": "私は死んだんだ。 何が起こっているのか？"}, {"type": "subtitle", "time": 712.63, "timestamp": "00:11:52", "text": "ゲームが"}, {"type": "subtitle", "time": 715.35, "timestamp": "00:11:55", "text": "混雑していて、動作が重くなっています。"}, {"type": "subtitle", "time": 718.55, "timestamp": "00:11:58", "text": "私は生きているのだろうか？"}]
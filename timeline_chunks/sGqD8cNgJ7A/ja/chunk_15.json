[{"type": "subtitle", "time": 905.75, "timestamp": "00:15:05", "text": "ああ、いやだ。"}, {"type": "subtitle", "time": 923.35, "timestamp": "00:15:23", "text": "待って。 私はまだプレイできます。 わかった。 わかった。"}, {"type": "subtitle", "time": 925.269, "timestamp": "00:15:25", "text": "ダウンロードファイルを投稿したら、ちゃんと"}, {"type": "subtitle", "time": 929.509, "timestamp": "00:15:29", "text": "再生できました。 ニース。 また、"}, {"type": "subtitle", "time": 932.47, "timestamp": "00:15:32", "text": "ボディカムで"}, {"type": "subtitle", "time": 934.31, "timestamp": "00:15:34", "text": "リアルな"}, {"type": "subtitle", "time": 938.87, "timestamp": "00:15:38", "text": "ピューピューをプレイしたいと思っています。 えっと、"}, {"type": "subtitle", "time": 942.87, "timestamp": "00:15:42", "text": "それは9月3日か2日に"}, {"type": "subtitle", "time": 946.31, "timestamp": "00:15:46", "text": "新しいアップデートがリリースされる時で、ロック、ロックアンドロード、"}, {"type": "subtitle", "time": 948.31, "timestamp": "00:15:48", "text": "リロードとかいうアップデート"}, {"type": "subtitle", "time": 951.99, "timestamp": "00:15:51", "text": "名だったかな。 大規模アップデートが公開されたらお知らせします。"}, {"type": "subtitle", "time": 955.509, "timestamp": "00:15:55", "text": "プレイしたいです。 ええ、それは"}, {"type": "subtitle", "time": 958.23, "timestamp": "00:15:58", "text": "インドの実家にあった私のゲーム用PCを壊したゲームです"}]
[{"type": "subtitle", "time": 5341.189, "timestamp": "01:29:01", "text": "フォックスは"}, {"type": "subtitle", "time": 5342.87, "timestamp": "01:29:02", "text": "我々のものだ。A"}, {"type": "subtitle", "time": 5353.83, "timestamp": "01:29:13", "text": "よし。Aはアルファ、ベータ、チャラリー、えーと、"}, {"type": "subtitle", "time": 5358.55, "timestamp": "01:29:18", "text": "デルタ、イーグル、フォックスロッド。Gは何だ？H"}, {"type": "subtitle", "time": 5381.91, "timestamp": "01:29:41", "text": "スライディングのメカニズムがあればいいのに。"}, {"type": "subtitle", "time": 5384.39, "timestamp": "01:29:44", "text": "スライディングして撃てるのに。"}, {"type": "subtitle", "time": 5386.31, "timestamp": "01:29:46", "text": "今、コードを掴んでいる。"}, {"type": "subtitle", "time": 5388.737, "timestamp": "01:29:48", "text": "助けが必要だ。[笑い声]"}, {"type": "subtitle", "time": 5389.27, "timestamp": "01:29:49", "text": "[息を呑む]"}, {"type": "subtitle", "time": 5391.11, "timestamp": "01:29:51", "text": "待って。えーと、バトルフィールド6では、"}, {"type": "subtitle", "time": 5394.07, "timestamp": "01:29:54", "text": "右にスライディングできるはずだ。"}]
[{"type": "subtitle", "time": 8761.429, "timestamp": "02:26:01", "text": "ウィザリング・ウェーブス、Dナイトなどのゲームがある。たくさんのゲームを"}, {"type": "subtitle", "time": 8764.95, "timestamp": "02:26:04", "text": "試して、少しプレイしてみたんだけど、"}, {"type": "subtitle", "time": 8768.389, "timestamp": "02:26:08", "text": "1週間か1ヶ月くらいプレイして、それから"}, {"type": "subtitle", "time": 8773.59, "timestamp": "02:26:13", "text": "戻ってこなかったんだ。"}, {"type": "subtitle", "time": 8777.51, "timestamp": "02:26:17", "text": "デイリークエストがあるから、毎日デイリークエストに時間を費やすことはできないし、"}, {"type": "subtitle", "time": 8790.23, "timestamp": "02:26:30", "text": "友達は、"}, {"type": "subtitle", "time": 8792.309, "timestamp": "02:26:32", "text": "えーと、他の配信者の友達が、"}, {"type": "subtitle", "time": 8794.79, "timestamp": "02:26:34", "text": "原神をプレイしてデイリーをやっているとか言っていて、私は、"}, {"type": "subtitle", "time": 8797.99, "timestamp": "02:26:37", "text": "えー、"}, {"type": "subtitle", "time": 8801.349, "timestamp": "02:26:41", "text": "まだデイリーやってるの？って感じ"}]
[{"type": "subtitle", "time": 1142.95, "timestamp": "00:19:02", "text": "このテスト期間中はサーバーを選択できると思います。 私はできません"}, {"type": "subtitle", "time": 1144.789, "timestamp": "00:19:04", "text": "。"}, {"type": "subtitle", "time": 1147.27, "timestamp": "00:19:07", "text": "できるなら、それは良いことだ。 また、私の"}, {"type": "subtitle", "time": 1157.19, "timestamp": "00:19:17", "text": "よし、ライブ配信中」で終了しましたか。 わかった。"}, {"type": "subtitle", "time": 1160.07, "timestamp": "00:19:20", "text": "セクター内には少なくとも3基の発射用バッテリーが"}, {"type": "subtitle", "time": 1162.47, "timestamp": "00:19:22", "text": "待機状態にある。 了解しました。 突撃"}, {"type": "subtitle", "time": 1164.31, "timestamp": "00:19:24", "text": "大隊が市街地周辺に投入された"}, {"type": "subtitle", "time": 1166.47, "timestamp": "00:19:26", "text": "。 目立たないように行動し、"}, {"type": "subtitle", "time": 1168.63, "timestamp": "00:19:28", "text": "監視を続けろ。 これはどうにも納得がいかない"}, {"type": "subtitle", "time": 1171.27, "timestamp": "00:19:31", "text": "。 導入は"}, {"type": "subtitle", "time": 1172.47, "timestamp": "00:19:32", "text": "非常に急いで行われた。"}, {"type": "subtitle", "time": 1175.35, "timestamp": "00:19:35", "text": "あ、待って。 全画面表示です。 これは"}, {"type": "subtitle", "time": 1177.669, "timestamp": "00:19:37", "text": "パニック状態に見える。"}]
[{"type": "subtitle", "time": 301.749, "timestamp": "00:05:01", "text": "思います。午後6時か7時頃なので。"}, {"type": "subtitle", "time": 308.39, "timestamp": "00:05:08", "text": "インド向けですよね？ そう、"}, {"type": "subtitle", "time": 311.11, "timestamp": "00:05:11", "text": "私の視聴者の大半は、"}, {"type": "subtitle", "time": 313.35, "timestamp": "00:05:13", "text": "夜10時頃とかに私を見てくれていたのは知っています"}, {"type": "subtitle", "time": 315.189, "timestamp": "00:05:15", "text": "。"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "えっと、午後10時か9時 IST。"}, {"type": "subtitle", "time": 323.189, "timestamp": "00:05:23", "text": "だから、"}, {"type": "subtitle", "time": 325.59, "timestamp": "00:05:25", "text": "私は音楽についてはよく知らないんです。 少し"}, {"type": "subtitle", "time": 338.31, "timestamp": "00:05:38", "text": "ゲームに切り替えよう。"}, {"type": "subtitle", "time": 341.43, "timestamp": "00:05:41", "text": "1秒。"}, {"type": "subtitle", "time": 349.99, "timestamp": "00:05:49", "text": "これが見えますか？ はい、これはご覧いただけます。"}, {"type": "subtitle", "time": 352.95, "timestamp": "00:05:52", "text": "うん。 だから、"}, {"type": "subtitle", "time": 356.469, "timestamp": "00:05:56", "text": "テンペストという特定のオペレーターをゲットするために、ひたすらレベル上げをしたいんです。"}, {"type": "subtitle", "time": 359.749, "timestamp": "00:05:59", "text": "彼女は赤毛だ。 彼女は綺麗に見える。"}]
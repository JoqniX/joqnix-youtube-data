[{"type": "subtitle", "time": 363.35, "timestamp": "00:06:03", "text": "彼女はかっこいい。 彼女が欲しい。"}, {"type": "subtitle", "time": 366.139, "timestamp": "00:06:06", "text": "彼女を見て。 彼女はクールだ。 ああ、"}, {"type": "subtitle", "time": 368.95, "timestamp": "00:06:08", "text": "彼女が欲しいよ（笑）。"}, {"type": "subtitle", "time": 379.67, "timestamp": "00:06:19", "text": "何を演奏すればいいのかわからない。"}, {"type": "subtitle", "time": 383.67, "timestamp": "00:06:23", "text": "作戦に参加しよう。 攻撃と防御。"}, {"type": "subtitle", "time": 390.469, "timestamp": "00:06:30", "text": "パイロットは"}, {"type": "subtitle", "time": 393.83, "timestamp": "00:06:33", "text": "派閥に参加して"}, {"type": "subtitle", "time": 397.029, "timestamp": "00:06:37", "text": "占領するか、"}, {"type": "subtitle", "time": 399.83, "timestamp": "00:06:39", "text": "敵とマッチするチームでプレイします。"}, {"type": "subtitle", "time": 410.39, "timestamp": "00:06:50", "text": "、"}, {"type": "subtitle", "time": 414.15, "timestamp": "00:06:54", "text": "何を演奏したらいいかわからないんです。 定番の"}, {"type": "subtitle", "time": 417.909, "timestamp": "00:06:57", "text": "特徴は以下の通りです。"}, {"type": "subtitle", "time": 419.43, "timestamp": "00:06:59", "text": "ああ、わかった"}]
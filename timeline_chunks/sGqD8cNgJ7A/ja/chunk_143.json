[{"type": "subtitle", "time": 8581.59, "timestamp": "02:23:01", "text": "試してみたかったんだけど、"}, {"type": "subtitle", "time": 8590.07, "timestamp": "02:23:10", "text": "ガチャゲームは避けたいんだ。ガチャゲームを始めると、しばらくプレイしてやめてしまうから。だから"}, {"type": "subtitle", "time": 8598.23, "timestamp": "02:23:18", "text": "ウマムスも同じように扱われると思う"}, {"type": "subtitle", "time": 8600.309, "timestamp": "02:23:20", "text": "。"}, {"type": "subtitle", "time": 8604.15, "timestamp": "02:23:24", "text": "ゲームを試してみて、"}, {"type": "subtitle", "time": 8606.63, "timestamp": "02:23:26", "text": "少しプレイして、それからプレイをやめる"}, {"type": "subtitle", "time": 8619.91, "timestamp": "02:23:39", "text": "リング"}, {"type": "subtitle", "time": 8624.389, "timestamp": "02:23:44", "text": "ウェーブとか他のゲームもそうだった。"}, {"type": "chat", "time": 8627.092, "timestamp": "02:23:47", "author": "@wildan19gta73", "avatar": "https://yt4.ggpht.com/ytc/AIdro_ltgSuqdkVmFy7b8YNX34dHb6whG0lODXr6m68zEAgk=s64-c-k-c0x00ffffff-no-rj", "message": "I see"}]
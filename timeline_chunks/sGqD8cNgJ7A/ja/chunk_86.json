[{"type": "subtitle", "time": 5176.79, "timestamp": "01:26:16", "text": "敵がブラボーを攻撃中。連合"}, {"type": "subtitle", "time": 5179.11, "timestamp": "01:26:19", "text": "軍が無力化中。"}, {"type": "subtitle", "time": 5188.39, "timestamp": "01:26:28", "text": "待って、いつ単発射撃に変わったの？"}, {"type": "subtitle", "time": 5190.39, "timestamp": "01:26:30", "text": "何？"}, {"type": "subtitle", "time": 5198.47, "timestamp": "01:26:38", "text": "いいポイントでプレイしてる。ああ。"}, {"type": "subtitle", "time": 5200.629, "timestamp": "01:26:40", "text": "うーん、うっかり"}, {"type": "subtitle", "time": 5209.669, "timestamp": "01:26:49", "text": "よし、これでいい。"}]
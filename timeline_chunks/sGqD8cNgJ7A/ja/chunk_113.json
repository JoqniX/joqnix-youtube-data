[{"type": "subtitle", "time": 6791.109, "timestamp": "01:53:11", "text": "寝るね。"}, {"type": "subtitle", "time": 6795.669, "timestamp": "01:53:15", "text": "日本の真夜中に1つ開けて閉めるよ。だから、毎日"}, {"type": "subtitle", "time": 6820.629, "timestamp": "01:53:40", "text": "、このバカげた"}, {"type": "subtitle", "time": 6824.87, "timestamp": "01:53:44", "text": "解像度。大嫌い。大嫌い。大嫌い。"}, {"type": "subtitle", "time": 6828.229, "timestamp": "01:53:48", "text": "解像度の"}, {"type": "subtitle", "time": 6830.95, "timestamp": "01:53:50", "text": "クソ。"}]
[{"type": "subtitle", "time": 7763.43, "timestamp": "02:09:23", "text": "ああ、"}, {"type": "subtitle", "time": 7765.109, "timestamp": "02:09:25", "text": "機械みたいに準備万端にしておくのはちょっと難しいし、"}, {"type": "subtitle", "time": 7767.51, "timestamp": "02:09:27", "text": "実用的じゃない。俺は"}, {"type": "subtitle", "time": 7771.03, "timestamp": "02:09:31", "text": "独自のやり方で市場をやっているような気がする。ああ、"}, {"type": "subtitle", "time": 7773.99, "timestamp": "02:09:33", "text": "ゾンビモードとかが来るって聞いたよ。新しい"}, {"type": "subtitle", "time": 7789.91, "timestamp": "02:09:49", "text": "この叫び声は"}]
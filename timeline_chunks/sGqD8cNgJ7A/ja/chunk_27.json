[{"type": "subtitle", "time": 1632.87, "timestamp": "00:27:12", "text": "えっと、その前に、ちょっと"}, {"type": "subtitle", "time": 1642.549, "timestamp": "00:27:22", "text": "グラフィックは今でも"}, {"type": "subtitle", "time": 1663.269, "timestamp": "00:27:43", "text": "外周が壊れています。 突撃部隊は"}, {"type": "subtitle", "time": 1665.51, "timestamp": "00:27:45", "text": "廃墟へと突入する。 前方"}, {"type": "subtitle", "time": 1667.35, "timestamp": "00:27:47", "text": "射撃陣地を確保し、敵の攻撃を防ごう"}, {"type": "subtitle", "time": 1667.99, "timestamp": "00:27:47", "text": "。"}]
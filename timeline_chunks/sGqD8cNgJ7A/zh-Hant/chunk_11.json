[{"type": "subtitle", "time": 661.269, "timestamp": "00:11:01", "text": "這是什麼槍？我該怎麼更換"}, {"type": "subtitle", "time": 669.67, "timestamp": "00:11:09", "text": "目標位置最接近逃離黑暗"}, {"type": "subtitle", "time": 671.59, "timestamp": "00:11:11", "text": "防禦。"}, {"type": "subtitle", "time": 675.75, "timestamp": "00:11:15", "text": "好的。是的，我發現它運行"}, {"type": "subtitle", "time": 679.269, "timestamp": "00:11:19", "text": "緩慢。我的網路太差了。我的天"}, {"type": "subtitle", "time": 681.829, "timestamp": "00:11:21", "text": "，它正在下載一些東西。我的天，卡"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "頓了。它運行滯後。"}, {"type": "subtitle", "time": 693.59, "timestamp": "00:11:33", "text": "我死了。到底是怎麼回事？  幀率只有"}, {"type": "subtitle", "time": 712.63, "timestamp": "00:11:52", "text": "遊戲運行卡頓，非常繁忙"}, {"type": "subtitle", "time": 715.35, "timestamp": "00:11:55", "text": "。"}, {"type": "subtitle", "time": 718.55, "timestamp": "00:11:58", "text": "我還活著嗎？  呃"}]
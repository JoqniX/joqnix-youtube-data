[{"type": "subtitle", "time": 301.749, "timestamp": "00:05:01", "text": "六、七點吧。對"}, {"type": "subtitle", "time": 308.39, "timestamp": "00:05:08", "text": "印度來說，對吧？是的，我知道"}, {"type": "subtitle", "time": 311.11, "timestamp": "00:05:11", "text": "我的大多數老觀眾以前都是在"}, {"type": "subtitle", "time": 313.35, "timestamp": "00:05:13", "text": "晚上，例如晚上十點左右看我的節目"}, {"type": "subtitle", "time": 315.189, "timestamp": "00:05:15", "text": "。"}, {"type": "subtitle", "time": 320.31, "timestamp": "00:05:20", "text": "呃，晚上10點或9點。 IST。"}, {"type": "subtitle", "time": 323.189, "timestamp": "00:05:23", "text": "所以，"}, {"type": "subtitle", "time": 325.59, "timestamp": "00:05:25", "text": "我對音樂一竅不通。感覺有點奇怪"}, {"type": "subtitle", "time": 338.31, "timestamp": "00:05:38", "text": "讓我切換到我的遊戲。"}, {"type": "subtitle", "time": 341.43, "timestamp": "00:05:41", "text": "一秒鐘。"}, {"type": "subtitle", "time": 349.99, "timestamp": "00:05:49", "text": "你能看到嗎？是的，你可以看到。  是的"}, {"type": "subtitle", "time": 352.95, "timestamp": "00:05:52", "text": "。所以，我想刷一個"}, {"type": "subtitle", "time": 356.469, "timestamp": "00:05:56", "text": "叫「暴風雨」的特定幹員。"}, {"type": "subtitle", "time": 359.749, "timestamp": "00:05:59", "text": "她有一頭紅髮。她看起來很漂亮。"}]
[{"type": "subtitle", "time": 781.03, "timestamp": "00:13:01", "text": "背景中的靜止畫面。仍然在"}, {"type": "subtitle", "time": 783.03, "timestamp": "00:13:03", "text": "背景。如果進程"}, {"type": "subtitle", "time": 784.79, "timestamp": "00:13:04", "text": "消失了"}, {"type": "subtitle", "time": 796.71, "timestamp": "00:13:16", "text": "它是在核心上運行還是在其他地方運行？"}, {"type": "subtitle", "time": 839.189, "timestamp": "00:13:59", "text": "為什麼？  我的天，它還在背景裡。  兄弟，你還是自殺吧。  聽起來太不對勁了。  我的整台"}]
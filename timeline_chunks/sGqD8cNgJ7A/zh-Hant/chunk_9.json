[{"type": "subtitle", "time": 543.75, "timestamp": "00:09:03", "text": "試著佔領高地。知道了。  明白了。"}, {"type": "subtitle", "time": 549.75, "timestamp": "00:09:09", "text": "我的直播可能會有延遲。是的，但"}, {"type": "subtitle", "time": 553.19, "timestamp": "00:09:13", "text": "我可能需要把幀率調到"}, {"type": "subtitle", "time": 557.03, "timestamp": "00:09:17", "text": "永恆經典。  是的。好的"}, {"type": "subtitle", "time": 560.15, "timestamp": "00:09:20", "text": "。讓我穿上我的"}, {"type": "subtitle", "time": 563.75, "timestamp": "00:09:23", "text": "電競服。呃，"}, {"type": "subtitle", "time": 566.949, "timestamp": "00:09:26", "text": "她的人民把和平視為理所當然。她"}, {"type": "subtitle", "time": 568.87, "timestamp": "00:09:28", "text": "做這件事的時候信心十足。  我"}, {"type": "subtitle", "time": 571.43, "timestamp": "00:09:31", "text": "必須成為一名遊戲玩家。"}, {"type": "subtitle", "time": 575.67, "timestamp": "00:09:35", "text": "脆弱不堪的國家。但現在我一切都"}, {"type": "subtitle", "time": 578.07, "timestamp": "00:09:38", "text": "安排好了。我準備好了。"}, {"type": "subtitle", "time": 581.509, "timestamp": "00:09:41", "text": "我戴著我的遊戲手套。"}, {"type": "subtitle", "time": 583.67, "timestamp": "00:09:43", "text": "我睡著了"}]
[{"type": "subtitle", "time": 5102.149, "timestamp": "01:25:02", "text": "我就堅持這個。然後"}, {"type": "subtitle", "time": 5115.03, "timestamp": "01:25:15", "text": "我喜歡戰鬥練習那個。你知道嗎？我還是跟電腦人"}, {"type": "subtitle", "time": 5119.43, "timestamp": "01:25:19", "text": "玩吧。也許我真的"}, {"type": "subtitle", "time": 5121.669, "timestamp": "01:25:21", "text": "不知道，夥計。  好的，我們來試試這個遊戲。  可以，我會用人工智慧來完成。這是我第一次下載遊戲時做的事情。  出現任何技術問題。  不錯。  但我確實"}, {"type": "subtitle", "time": 5153.43, "timestamp": "01:25:53", "text": "有隨身攝影機。好吧，[笑聲]這很糟糕。現在我決定玩個遊戲，然後換個遊戲玩。那很糟糕。  我不知道什麼不是。它沒給我那種"}]
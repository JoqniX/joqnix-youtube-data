[{"type": "subtitle", "time": 423.189, "timestamp": "00:07:03", "text": "好的。讓我們來玩這張"}, {"type": "subtitle", "time": 425.909, "timestamp": "00:07:05", "text": "還沒下載的戰爭地圖吧。我需要"}, {"type": "subtitle", "time": 433.589, "timestamp": "00:07:13", "text": "天啊。  等待。"}, {"type": "subtitle", "time": 439.029, "timestamp": "00:07:19", "text": "我的天啊。我必須下載"}, {"type": "subtitle", "time": 441.83, "timestamp": "00:07:21", "text": "更多。"}, {"type": "subtitle", "time": 443.67, "timestamp": "00:07:23", "text": "進攻和防守都要兼顧。沒關係。哦好的"}, {"type": "subtitle", "time": 463.029, "timestamp": "00:07:43", "text": "哦，你看著我連續執行了三次"}, {"type": "subtitle", "time": 465.35, "timestamp": "00:07:45", "text": "流。我的天啊。我們走吧。"}, {"type": "subtitle", "time": 469.11, "timestamp": "00:07:49", "text": "你連續觀看了好幾次。"}, {"type": "subtitle", "time": 472.30899999999997, "timestamp": "00:07:52", "text": "這意義重大。  謝謝。謝謝。"}]
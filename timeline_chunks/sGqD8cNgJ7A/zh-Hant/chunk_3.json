[{"type": "subtitle", "time": 181.589, "timestamp": "00:03:01", "text": "正式直播。另外，"}, {"type": "subtitle", "time": 185.43, "timestamp": "00:03:05", "text": "今晚我們將在三角洲部隊進行射擊遊戲"}, {"type": "subtitle", "time": 188.79, "timestamp": "00:03:08", "text": "。我玩《三角洲"}, {"type": "subtitle", "time": 192.47, "timestamp": "00:03:12", "text": "特種部隊》的主要原因是它有一個"}, {"type": "subtitle", "time": 195.50900000000001, "timestamp": "00:03:15", "text": "叫做「戰爭」的特殊遊戲模式"}, {"type": "subtitle", "time": 197.589, "timestamp": "00:03:17", "text": "。"}, {"type": "subtitle", "time": 201.35, "timestamp": "00:03:21", "text": "所以，它能為你帶來類似《戰地風雲》系列遊戲的"}, {"type": "subtitle", "time": 203.589, "timestamp": "00:03:23", "text": "體驗。"}, {"type": "subtitle", "time": 207.19, "timestamp": "00:03:27", "text": "這就是我"}]
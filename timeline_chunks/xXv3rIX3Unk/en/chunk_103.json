[{"type": "subtitle", "time": 6189.43, "timestamp": "01:43:09", "text": "Let's go to the ruined homestead."}, {"type": "subtitle", "time": 6192.709, "timestamp": "01:43:12", "text": ">> That's the plan. Okay,"}, {"type": "subtitle", "time": 6194.95, "timestamp": "01:43:14", "text": ">> this is Apollo. Gate still standing."}, {"type": "subtitle", "time": 6196.95, "timestamp": "01:43:16", "text": "Raider, you'll find the unfinished"}, {"type": "subtitle", "time": 6198.79, "timestamp": "01:43:18", "text": "structures scattered around the valley."}, {"type": "subtitle", "time": 6201.91, "timestamp": "01:43:21", "text": "Look for construction signs and cones."}, {"type": "subtitle", "time": 6203.83, "timestamp": "01:43:23", "text": "My previous crew came under heavy fire"}, {"type": "subtitle", "time": 6226.229, "timestamp": "01:43:46", "text": "I have to be careful. I don't want to"}, {"type": "subtitle", "time": 6229.43, "timestamp": "01:43:49", "text": "get caught by any patrol"}, {"type": "subtitle", "time": 6232.31, "timestamp": "01:43:52", "text": "patrolling art."}]
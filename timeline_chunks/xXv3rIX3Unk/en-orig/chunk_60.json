[{"type": "subtitle", "time": 3608.47, "timestamp": "01:00:08", "text": "An Ark Orbiter is on the road. The safe"}, {"type": "subtitle", "time": 3611.109, "timestamp": "01:00:11", "text": "window is closing. You have 10 minutes"}, {"type": "subtitle", "time": 3613.51, "timestamp": "01:00:13", "text": "to return to Sparanza. I repeat, 10"}, {"type": "subtitle", "time": 3615.99, "timestamp": "01:00:15", "text": "minutes."}, {"type": "subtitle", "time": 3619.75, "timestamp": "01:00:19", "text": ">> Where is the rod? Ah, someone looted"}, {"type": "subtitle", "time": 3622.63, "timestamp": "01:00:22", "text": "this."}, {"type": "subtitle", "time": 3639.19, "timestamp": "01:00:39", "text": "Oh, this is not looted."}, {"type": "subtitle", "time": 3640.71, "timestamp": "01:00:40", "text": "Lightning rod. Please, please, please,"}, {"type": "subtitle", "time": 3649.99, "timestamp": "01:00:49", "text": "where will I get my lightning rod?"}]
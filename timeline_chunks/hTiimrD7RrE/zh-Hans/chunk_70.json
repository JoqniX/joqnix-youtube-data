[{"type": "subtitle", "time": 4202.149, "timestamp": "01:10:02", "text": "好的。 好的。 二，三。 两三"}, {"type": "subtitle", "time": 4205.91, "timestamp": "01:10:05", "text": "个人。 好的。 五分之三。 五。"}, {"type": "subtitle", "time": 4208.79, "timestamp": "01:10:08", "text": "有多少人去了？ 所以，"}, {"type": "subtitle", "time": 4210.31, "timestamp": "01:10:10", "text": "呃，"}, {"type": "subtitle", "time": 4215.03, "timestamp": "01:10:15", "text": "有些人有工作要做，但是，"}, {"type": "subtitle", "time": 4222.31, "timestamp": "01:10:22", "text": "不，等等，不，不。 或许总共是"}, {"type": "subtitle", "time": 4224.149, "timestamp": "01:10:24", "text": "三、四、五。 所以，我打算做"}, {"type": "subtitle", "time": 4249.75, "timestamp": "01:10:49", "text": "等等。 我看到了和子。 我看到了卡苏库。"}, {"type": "subtitle", "time": 4252.48, "timestamp": "01:10:52", "text": "卡苏库。 嗯，"}, {"type": "subtitle", "time": 4255.28, "timestamp": "01:10:55", "text": "嗯， 我选这个叫Kazuku的人。 我"}, {"type": "subtitle", "time": 4258.48, "timestamp": "01:10:58", "text": "我选这个叫Kazuku的人。 我 不知道这样做是否正确。 第六"}]
[{"type": "subtitle", "time": 300.07, "timestamp": "00:05:00", "text": "这款名为 Pratt 的软件。 它"}, {"type": "subtitle", "time": 303.59, "timestamp": "00:05:03", "text": "就像一款软件，你可以录制"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "自己的声音，然后它会分析"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "频率、音调等等"}, {"type": "chat", "time": 309.841, "timestamp": "00:05:09", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I am not"}, {"type": "subtitle", "time": 312.23, "timestamp": "00:05:12", "text": "。 嗯，差不多是这样。 是的，"}, {"type": "subtitle", "time": 314.79, "timestamp": "00:05:14", "text": "我今天"}, {"type": "subtitle", "time": 317.51, "timestamp": "00:05:17", "text": "从那位研究人员那里听说了这件事。 她跟我讲了"}, {"type": "chat", "time": 318.016, "timestamp": "00:05:18", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 320.55, "timestamp": "00:05:20", "text": "这些东西，因为我对"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "音乐之类的东西很感兴趣。 我把"}, {"type": "subtitle", "time": 325.67, "timestamp": "00:05:25", "text": "我的爱好、我想"}, {"type": "subtitle", "time": 328.15, "timestamp": "00:05:28", "text": "在日本做的事情等等都告诉了他们。 所以她把"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "一切都告诉我了。 所以感觉还不错。 所以，嗯，"}, {"type": "subtitle", "time": 335.909, "timestamp": "00:05:35", "text": "今天，我大概"}, {"type": "subtitle", "time": 338.629, "timestamp": "00:05:38", "text": "在学院办公室待了"}, {"type": "subtitle", "time": 341.59000000000003, "timestamp": "00:05:41", "text": "7个小时，做这个录音"}, {"type": "subtitle", "time": 343.99, "timestamp": "00:05:43", "text": "工作。 我得用"}, {"type": "subtitle", "time": 347.83, "timestamp": "00:05:47", "text": "日语把那玩意儿念出来，而且还得用"}, {"type": "subtitle", "time": 351.51, "timestamp": "00:05:51", "text": "我的母语翻译"}, {"type": "subtitle", "time": 354.95, "timestamp": "00:05:54", "text": "。 呃，当时真是忙得不可开交。 所以，"}, {"type": "subtitle", "time": 358.15, "timestamp": "00:05:58", "text": "我没时间"}]
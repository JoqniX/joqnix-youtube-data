[{"type": "subtitle", "time": 1142.47, "timestamp": "00:19:02", "text": "是的，他们给这个节目安排了时间，"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "就像每个 YouTuber 都有"}, {"type": "subtitle", "time": 1158.39, "timestamp": "00:19:18", "text": "自己的配音演员一样，这个也不例外"}, {"type": "subtitle", "time": 1168.31, "timestamp": "00:19:28", "text": "配音真的太棒了，他们肯定"}, {"type": "subtitle", "time": 1170.95, "timestamp": "00:19:30", "text": "下了不少功夫。不过，我"}, {"type": "subtitle", "time": 1173.59, "timestamp": "00:19:33", "text": "觉得我可能用不了，因为对我来说，这个要"}, {"type": "subtitle", "time": 1176.71, "timestamp": "00:19:36", "text": "40分钟，"}, {"type": "subtitle", "time": 1179.43, "timestamp": "00:19:39", "text": "我不知道我能不能用这个。"}, {"type": "subtitle", "time": 1187.029, "timestamp": "00:19:47", "text": "所以我还是用Windows的闹钟/"}, {"type": "subtitle", "time": 1190.549, "timestamp": "00:19:50", "text": "定时器来设置"}, {"type": "subtitle", "time": 1193.99, "timestamp": "00:19:53", "text": "时间吧。我不知道要不要"}, {"type": "subtitle", "time": 1197.11, "timestamp": "00:19:57", "text": "计时，但某种程度上来说，"}, {"type": "subtitle", "time": 1199.99, "timestamp": "00:19:59", "text": "如果我真的在考试，我就得计时。我必须把它想象成正在"}]
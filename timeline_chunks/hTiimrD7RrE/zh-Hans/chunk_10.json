[{"type": "subtitle", "time": 600.31, "timestamp": "00:10:00", "text": "日语歌曲，也喜欢读"}, {"type": "subtitle", "time": 603.35, "timestamp": "00:10:03", "text": "它们的罗曼语版本，而且很容易就能学会。"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "但是当遇到平假名、片假名和"}, {"type": "subtitle", "time": 608.15, "timestamp": "00:10:08", "text": "汉字混在一起的情况时，"}, {"type": "subtitle", "time": 611.43, "timestamp": "00:10:11", "text": "我就得花很长时间，这很"}, {"type": "subtitle", "time": 613.67, "timestamp": "00:10:13", "text": "不好，因为当你准备参加"}, {"type": "subtitle", "time": 618.069, "timestamp": "00:10:18", "text": "国家考试或日语考试时，比如"}, {"type": "subtitle", "time": 622.87, "timestamp": "00:10:22", "text": "N5 Q5或N4 Q4，任何级别，都会遇到这种情况，"}, {"type": "subtitle", "time": 625.67, "timestamp": "00:10:25", "text": "因为学会"}, {"type": "subtitle", "time": 627.509, "timestamp": "00:10:27", "text": "阅读这些语言很重要。 如果你做不到，你会遇到"}, {"type": "subtitle", "time": 629.59, "timestamp": "00:10:29", "text": "很多困难。"}, {"type": "subtitle", "time": 632.55, "timestamp": "00:10:32", "text": "你写那些关于"}, {"type": "subtitle", "time": 635.59, "timestamp": "00:10:35", "text": "天然凝胶药的考试题时会浪费很多时间，对吧？"}, {"type": "subtitle", "time": 637.99, "timestamp": "00:10:37", "text": "我意识到了这一点。"}, {"type": "subtitle", "time": 640.31, "timestamp": "00:10:40", "text": "好，让我连接我的绘图板。"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "所以，我们将直接编辑PDF文件。"}, {"type": "subtitle", "time": 647.509, "timestamp": "00:10:47", "text": "好的？ 所以，我"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "估计得在浏览器里操作了。"}, {"type": "subtitle", "time": 653.11, "timestamp": "00:10:53", "text": "呃，"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "让我查一下。 我应该使用Edge浏览器还是"}, {"type": "subtitle", "time": 659.19, "timestamp": "00:10:59", "text": "Vivald浏览器？"}]
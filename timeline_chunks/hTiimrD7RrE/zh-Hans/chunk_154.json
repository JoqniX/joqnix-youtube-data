[{"type": "subtitle", "time": 9241.59, "timestamp": "02:34:01", "text": "我学习了，不，我学习的不仅仅是"}, {"type": "subtitle", "time": 9245.349, "timestamp": "02:34:05", "text": "日语的东西，我们还写了一些东西，但我会在"}, {"type": "subtitle", "time": 9250.79, "timestamp": "02:34:10", "text": "本周晚些时候，"}, {"type": "subtitle", "time": 9254.389, "timestamp": "02:34:14", "text": "比如周五周六，进行一次正式的复习直播和更多的练习直播。"}, {"type": "subtitle", "time": 9256.95, "timestamp": "02:34:16", "text": "是的，我们会做Vatcha之类的。 好的，"}, {"type": "subtitle", "time": 9258.63, "timestamp": "02:34:18", "text": "我们打算周六晚上聚聚"}, {"type": "subtitle", "time": 9269.59, "timestamp": "02:34:29", "text": "星期天也是如此。 呃，明天是"}, {"type": "subtitle", "time": 9272.469, "timestamp": "02:34:32", "text": "几号？"}, {"type": "subtitle", "time": 9275.429, "timestamp": "02:34:35", "text": "明天是星期二，不，是"}, {"type": "subtitle", "time": 9278.23, "timestamp": "02:34:38", "text": "星期四。 所以，我不知道"}, {"type": "subtitle", "time": 9281.349, "timestamp": "02:34:41", "text": "原神的新版本是否已经发布了"}, {"type": "subtitle", "time": 9283.19, "timestamp": "02:34:43", "text": "。 我不知道。 但我们会玩"}, {"type": "subtitle", "time": 9285.19, "timestamp": "02:34:45", "text": "那个游戏，"}, {"type": "subtitle", "time": 9290.63, "timestamp": "02:34:50", "text": "然后，嗯，星期五会怎么样呢？ 我"}, {"type": "subtitle", "time": 9292.63, "timestamp": "02:34:52", "text": "不知道。"}, {"type": "subtitle", "time": 9294.71, "timestamp": "02:34:54", "text": "今天突袭行动以蓝色"}, {"type": "subtitle", "time": 9296.55, "timestamp": "02:34:56", "text": "粒子形式展开。 我今天一整天都没法玩《蓝色粒子》"}]
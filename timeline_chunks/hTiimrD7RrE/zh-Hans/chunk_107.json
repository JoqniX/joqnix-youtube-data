[{"type": "subtitle", "time": 6423.189, "timestamp": "01:47:03", "text": "呃，怎么了？ 你好。 欢迎来到"}, {"type": "subtitle", "time": 6427.189, "timestamp": "01:47:07", "text": "直播间。 我刚做完考试"}, {"type": "subtitle", "time": 6429.83, "timestamp": "01:47:09", "text": "作业。 这不是作业，而是考试之"}, {"type": "subtitle", "time": 6433.189, "timestamp": "01:47:13", "text": "类的东西。 我"}, {"type": "subtitle", "time": 6436.31, "timestamp": "01:47:16", "text": "还就"}, {"type": "subtitle", "time": 6439.99, "timestamp": "01:47:19", "text": "我早上做的事情做了一个调查反馈。"}, {"type": "subtitle", "time": 6442.149, "timestamp": "01:47:22", "text": "显然，我的 YouTube 直播被中断了，"}, {"type": "subtitle", "time": 6446.07, "timestamp": "01:47:26", "text": "因为我当时正在使用 Beam 进行多平台直播，"}, {"type": "subtitle", "time": 6448.709, "timestamp": "01:47:28", "text": "我感到非常难过，"}, {"type": "subtitle", "time": 6457.35, "timestamp": "01:47:37", "text": "因为我愚蠢地忘记"}, {"type": "subtitle", "time": 6460.79, "timestamp": "01:47:40", "text": "在浏览器中保持 YouTube Studio 打开，导致我丢失了 YouTube 上长达 1 小时的视频素材。"}, {"type": "subtitle", "time": 6465.03, "timestamp": "01:47:45", "text": "真是蠢到家了。  YouTube 的 RTMP 是谁发明的"}, {"type": "subtitle", "time": 6468.31, "timestamp": "01:47:48", "text": "？ 他们得去挨顿揍。"}, {"type": "subtitle", "time": 6471.03, "timestamp": "01:47:51", "text": "说实话，现在都2025年了，"}, {"type": "subtitle", "time": 6475.59, "timestamp": "01:47:55", "text": "他们的RTMP问题还没解决，"}]
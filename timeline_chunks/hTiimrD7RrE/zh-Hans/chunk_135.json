[{"type": "subtitle", "time": 8123.589, "timestamp": "02:15:23", "text": "哇，我打哈欠了，兄弟。 哇，我把"}, {"type": "subtitle", "time": 8126.149, "timestamp": "02:15:26", "text": "最后一个搞砸了。"}, {"type": "subtitle", "time": 8129.91, "timestamp": "02:15:29", "text": "我没办法对着我打哈欠的兄弟大喊大叫。"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "我今天晚些时候会拿到仪器启用权限"}, {"type": "subtitle", "time": 8150.39, "timestamp": "02:15:50", "text": "。 所以，呃，当我们唱卡拉OK的时候"}, {"type": "subtitle", "time": 8154.069, "timestamp": "02:15:54", "text": "，你知道，我可以，嗯，让"}, {"type": "subtitle", "time": 8155.99, "timestamp": "02:15:55", "text": "你们听到伴奏，而"}, {"type": "subtitle", "time": 8158.79, "timestamp": "02:15:58", "text": "不是我随意地唱歌，没有"}]
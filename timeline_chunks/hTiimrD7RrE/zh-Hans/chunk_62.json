[{"type": "subtitle", "time": 3720.069, "timestamp": "01:02:00", "text": "他在工作。"}, {"type": "subtitle", "time": 3724.069, "timestamp": "01:02:04", "text": "呃，卡尔，我不知道。 我没时间。"}, {"type": "subtitle", "time": 3726.63, "timestamp": "01:02:06", "text": "我直接跳过吧。 呃，下一个。 我的天，"}, {"type": "subtitle", "time": 3739.349, "timestamp": "01:02:19", "text": "呃，我忘了。 啊，我也得学"}, {"type": "subtitle", "time": 3742.549, "timestamp": "01:02:22", "text": "。 兄弟，别生气。 我忘了。 我应该"}]
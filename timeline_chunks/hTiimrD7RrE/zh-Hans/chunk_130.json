[{"type": "subtitle", "time": 7805.83, "timestamp": "02:10:05", "text": "这首歌叫《Cream it cream》，"}, {"type": "subtitle", "time": 7807.99, "timestamp": "02:10:07", "text": "它讲的是笨手笨脚以及生活如何"}, {"type": "subtitle", "time": 7809.99, "timestamp": "02:10:09", "text": "对待你，就像一个傻瓜一样颠倒黑白，"}, {"type": "subtitle", "time": 7812.87, "timestamp": "02:10:12", "text": "你想死却"}, {"type": "subtitle", "time": 7815.91, "timestamp": "02:10:15", "text": "死不了，你渴望死亡却又不想死，就是那种感觉，"}, {"type": "subtitle", "time": 7819.51, "timestamp": "02:10:19", "text": "嗯，这"}, {"type": "subtitle", "time": 7823.51, "timestamp": "02:10:23", "text": "首歌太深刻了，我想它确实"}, {"type": "subtitle", "time": 7826.709, "timestamp": "02:10:26", "text": "是一首好歌，真的，它确实"}, {"type": "subtitle", "time": 7845.43, "timestamp": "02:10:45", "text": "[音乐]"}, {"type": "subtitle", "time": 7846.76, "timestamp": "02:10:46", "text": "论坛。"}]
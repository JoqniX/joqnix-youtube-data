[{"type": "chat", "time": 541.255, "timestamp": "00:09:01", "author": "@joqnix", "avatar": "https://yt4.ggpht.com/1rNe-FcvCKbSXpzuK86tx4EpeshYhox1KGRLnP8jvk1YWjbcndAtJwbDs74VZeGf462RnXuCJPE=s64-c-k-c0x00ffffff-no-rj", "message": "When i am writing this exam/sample paper i wont be reading chat. and please refrain from revealing the answers if you do know it too~ but feel free to chat~ and watch me attempt this! .w. "}, {"type": "chat", "time": 541.52, "timestamp": "00:09:01", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I get it"}, {"type": "subtitle", "time": 545.99, "timestamp": "00:09:05", "text": "呃，還有哪些"}, {"type": "subtitle", "time": 549.11, "timestamp": "00:09:09", "text": "會議之類的」。"}, {"type": "chat", "time": 551.683, "timestamp": "00:09:11", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I wont send answers *wink*"}, {"type": "subtitle", "time": 562.07, "timestamp": "00:09:22", "text": "我的問題在於我不"}, {"type": "subtitle", "time": 568.55, "timestamp": "00:09:28", "text": "擅長閱讀，而且像今天的……呃……就像關於採訪或研究工作，對吧？呃，我必須去參加那個活動。問題是我必須讀很多東西，"}, {"type": "subtitle", "time": 575.75, "timestamp": "00:09:35", "text": "而且發音要準確無誤。我對羅曼語沒問題，因為"}, {"type": "subtitle", "time": 579.19, "timestamp": "00:09:39", "text": "我習慣了學習這些日語歌曲，也"}, {"type": "subtitle", "time": 597.99, "timestamp": "00:09:57", "text": "喜歡讀它們的羅曼語版本，而且很容易學會。但是當遇到平假名、片假名和漢字混在一起的情況時，我就得花很長時間，這很不好，因為當你準備參加國家考試或日語考試時，比如N5 Q5或N4 Q4，任何級別，都會遇到這種情況，因為學會閱讀這些"}]
[{"type": "subtitle", "time": 3561.109, "timestamp": "00:59:21", "text": "今天的問題呃研究東西我"}, {"type": "subtitle", "time": 3563.829, "timestamp": "00:59:23", "text": "有很多東西"}, {"type": "subtitle", "time": 3566.39, "timestamp": "00:59:26", "text": "哦，是的。我打算把它放上去。"}, {"type": "subtitle", "time": 3568.71, "timestamp": "00:59:28", "text": "謝謝。我要去，我要去，我"}, {"type": "subtitle", "time": 3570.39, "timestamp": "00:59:30", "text": "不知道。"}, {"type": "subtitle", "time": 3572.71, "timestamp": "00:59:32", "text": "呃，我的"}, {"type": "subtitle", "time": 3577.03, "timestamp": "00:59:37", "text": "意思是。好的。他們要來"}, {"type": "subtitle", "time": 3580.309, "timestamp": "00:59:40", "text": "登山。所以，"}, {"type": "subtitle", "time": 3582.71, "timestamp": "00:59:42", "text": "嗯，"}, {"type": "subtitle", "time": 3595.03, "timestamp": "00:59:55", "text": "好的。官方時間是 30 分鐘，我想我們還有"}, {"type": "subtitle", "time": 3597.829, "timestamp": "00:59:57", "text": "三堂課。快點，"}]
[{"type": "subtitle", "time": 300.07, "timestamp": "00:05:00", "text": "這款名為 Pratt 的軟體。它"}, {"type": "subtitle", "time": 303.59, "timestamp": "00:05:03", "text": "就像一款軟體，你可以錄製"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "自己的聲音，然後它會分析"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "頻率、音調"}, {"type": "chat", "time": 309.841, "timestamp": "00:05:09", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I am not"}, {"type": "subtitle", "time": 312.23, "timestamp": "00:05:12", "text": "等等。嗯，差不多是這樣。是的，我"}, {"type": "subtitle", "time": 314.79, "timestamp": "00:05:14", "text": "今天"}, {"type": "subtitle", "time": 317.51, "timestamp": "00:05:17", "text": "從那位研究人員那裡聽說了這件事。她跟我講了"}, {"type": "chat", "time": 318.016, "timestamp": "00:05:18", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 320.55, "timestamp": "00:05:20", "text": "這些東西，因為我對"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "音樂之類的東西很有興趣。我把"}, {"type": "subtitle", "time": 325.67, "timestamp": "00:05:25", "text": "我的嗜好、我想"}, {"type": "subtitle", "time": 328.15, "timestamp": "00:05:28", "text": "在日本做的事情等等都告訴了他們。所以她把"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "一切都告訴我了。所以感覺還不錯。所以，嗯，"}, {"type": "subtitle", "time": 335.909, "timestamp": "00:05:35", "text": "今天，我大概"}, {"type": "subtitle", "time": 338.629, "timestamp": "00:05:38", "text": "在學院辦公室待了"}, {"type": "subtitle", "time": 341.59000000000003, "timestamp": "00:05:41", "text": "7個小時，做這個錄音"}, {"type": "subtitle", "time": 343.99, "timestamp": "00:05:43", "text": "工作。我得用"}, {"type": "subtitle", "time": 347.83, "timestamp": "00:05:47", "text": "日文把那玩意兒念出來，而且還得"}, {"type": "subtitle", "time": 351.51, "timestamp": "00:05:51", "text": "用我的母語翻譯"}, {"type": "subtitle", "time": 354.95, "timestamp": "00:05:54", "text": "。呃，當時真是忙得不可開交。所以，"}, {"type": "subtitle", "time": 358.15, "timestamp": "00:05:58", "text": "我沒時間"}]
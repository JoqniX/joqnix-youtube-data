[{"type": "subtitle", "time": 4033.349, "timestamp": "01:07:13", "text": "是的，基馬斯。"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "，我的研究老師，她剛剛"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "給了我一個提問者。我們應該"}, {"type": "subtitle", "time": 4067.109, "timestamp": "01:07:47", "text": "在直播中這樣做嗎？為什麼之後就不行了？"}, {"type": "subtitle", "time": 4069.029, "timestamp": "01:07:49", "text": "好了，"}, {"type": "subtitle", "time": 4070.71, "timestamp": "01:07:50", "text": "我時間不多了。"}, {"type": "subtitle", "time": 4075.43, "timestamp": "01:07:55", "text": "再過兩節我們就進入漢字部分了。"}]
[{"type": "subtitle", "time": 3720.069, "timestamp": "01:02:00", "text": "他在工作。"}, {"type": "subtitle", "time": 3724.069, "timestamp": "01:02:04", "text": "呃，卡爾，我不知道。我沒時間。"}, {"type": "subtitle", "time": 3726.63, "timestamp": "01:02:06", "text": "我直接跳過吧。呃，下一個。我的天，"}, {"type": "subtitle", "time": 3739.349, "timestamp": "01:02:19", "text": "呃，我忘了。啊，我也得學"}, {"type": "subtitle", "time": 3742.549, "timestamp": "01:02:22", "text": "。兄弟，別生氣。我忘了。我應該"}]
[{"type": "subtitle", "time": 421.35, "timestamp": "00:07:01", "text": "文法部分和閱讀"}, {"type": "subtitle", "time": 424.23, "timestamp": "00:07:04", "text": "理解部分，對吧？嗨，"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "你好，Sonan，你好，Sasan，你好，"}, {"type": "subtitle", "time": 431.51, "timestamp": "00:07:11", "text": "歡迎！你們上什麼課？我正在上日語課。嗯，"}, {"type": "subtitle", "time": 438.95, "timestamp": "00:07:18", "text": "如果你…我已經通過了五年級的考試，所以這是"}, {"type": "subtitle", "time": 445.99, "timestamp": "00:07:25", "text": "我們班一些學生的情況，他們還"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "沒有參加 N5 考試。所以，嗯，他們週日會舉辦。  所以，對我來說，這更像是一次回顧。嗯，這個，它更像是一個"}, {"type": "subtitle", "time": 458.87, "timestamp": "00:07:38", "text": "回顧總結之類的東西。嗯，是的，"}, {"type": "subtitle", "time": 462.55, "timestamp": "00:07:42", "text": "這有點像是一項"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "任務，但又不完全是，嗨。嗯，是的"}, {"type": "subtitle", "time": 475.67, "timestamp": "00:07:55", "text": "，我想在"}, {"type": "subtitle", "time": 478.95, "timestamp": "00:07:58", "text": "直播中完成這件事。呃，在此之前，我需要置頂一條"}]
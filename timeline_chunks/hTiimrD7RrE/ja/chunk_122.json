[{"type": "subtitle", "time": 7322.87, "timestamp": "02:02:02", "text": "いくつかの単語の発音や正しい"}, {"type": "subtitle", "time": 7324.47, "timestamp": "02:02:04", "text": "句読点に問題がある"}, {"type": "subtitle", "time": 7328.31, "timestamp": "02:02:08", "text": "けど、練習するつもりだ。"}, {"type": "subtitle", "time": 7330.629, "timestamp": "02:02:10", "text": "昨日歌詞を載せたばかりで、"}, {"type": "subtitle", "time": 7334.39, "timestamp": "02:02:14", "text": "一度歌ったことがある。今日初めてちゃんと全部見て覚えて、"}, {"type": "subtitle", "time": 7348.709, "timestamp": "02:02:28", "text": "この曲が好きだということを示したい。それから、ああ"}, {"type": "subtitle", "time": 7356.229, "timestamp": "02:02:36", "text": "、私は死んだと思う。 ええ、これも"}, {"type": "subtitle", "time": 7359.669, "timestamp": "02:02:39", "text": "私が練習している曲の一つです。   私は"}, {"type": "subtitle", "time": 7362.95, "timestamp": "02:02:42", "text": "死んだと思う。   より"}, {"type": "subtitle", "time": 7365.51, "timestamp": "02:02:45", "text": "低い。   ここは"}, {"type": "subtitle", "time": 7367.99, "timestamp": "02:02:47", "text": "どこですか？"}, {"type": "subtitle", "time": 7377.27, "timestamp": "02:02:57", "text": "、"}]
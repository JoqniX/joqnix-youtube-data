[{"type": "subtitle", "time": 1384.23, "timestamp": "00:23:04", "text": "それに集中すればいいの？ ちょっと待って、"}, {"type": "subtitle", "time": 1386.71, "timestamp": "00:23:06", "text": "これを管理者として実行するにはどうすればいいの？ いいえ、"}, {"type": "subtitle", "time": 1390.87, "timestamp": "00:23:10", "text": "Windowsアプリケーションです。 えっと、待って、"}, {"type": "subtitle", "time": 1411.19, "timestamp": "00:23:31", "text": "。 せめてこれだけは書いておこうと思ったんです"}, {"type": "subtitle", "time": 1414.07, "timestamp": "00:23:34", "text": "。"}, {"type": "subtitle", "time": 1416.71, "timestamp": "00:23:36", "text": "私は何をしますか？"}, {"type": "subtitle", "time": 1421.909, "timestamp": "00:23:41", "text": "タイマー機能にWindowsの時計を使えると思ったんです。 ああ。"}, {"type": "subtitle", "time": 1425.11, "timestamp": "00:23:45", "text": "それでは、こうしましょう。"}, {"type": "subtitle", "time": 1428.149, "timestamp": "00:23:48", "text": "試験は8時30分に開始します。 わかりました、"}, {"type": "subtitle", "time": 1431.11, "timestamp": "00:23:51", "text": "5分だけ時間をください。 何とか解決してみせる。   わかった"}, {"type": "subtitle", "time": 1434.07, "timestamp": "00:23:54", "text": "。   えっと"}, {"type": "chat", "time": 1438.203, "timestamp": "00:23:58", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "k"}]
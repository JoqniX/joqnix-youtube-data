[{"type": "subtitle", "time": 3720.069, "timestamp": "01:02:00", "text": "彼は仕事をしている。   えっと"}, {"type": "subtitle", "time": 3724.069, "timestamp": "01:02:04", "text": "、わからない。 私には時間がない。"}, {"type": "subtitle", "time": 3726.63, "timestamp": "01:02:06", "text": "私はパスします。 えっと、次。 ああ、"}, {"type": "subtitle", "time": 3739.349, "timestamp": "01:02:19", "text": "えっと、忘れてた。 ああ、私もそれを学ばなければならない"}, {"type": "subtitle", "time": 3742.549, "timestamp": "01:02:22", "text": "。 ヌッシュ、兄弟。 忘れた。"}]
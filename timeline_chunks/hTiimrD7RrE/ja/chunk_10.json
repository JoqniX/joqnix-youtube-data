[{"type": "subtitle", "time": 600.31, "timestamp": "00:10:00", "text": "日本語の歌を学んだり、"}, {"type": "subtitle", "time": 603.35, "timestamp": "00:10:03", "text": "そのロマニ語を読んだりすることに慣れていて、簡単にできるからです。"}, {"type": "subtitle", "time": 606.23, "timestamp": "00:10:06", "text": "しかし、ひらがな、カタカナ、"}, {"type": "subtitle", "time": 608.15, "timestamp": "00:10:08", "text": "漢字などが混ざっていると、私は"}, {"type": "subtitle", "time": 611.43, "timestamp": "00:10:11", "text": "時間をかけてしまいます。これは、N5"}, {"type": "subtitle", "time": 622.87, "timestamp": "00:10:22", "text": "Q5やN4 Q4などの国家試験や日本語試験を軽く書くときには良くありません。"}, {"type": "subtitle", "time": 625.67, "timestamp": "00:10:25", "text": "つまり、読み方を知っていることが重要なのです"}, {"type": "subtitle", "time": 627.509, "timestamp": "00:10:27", "text": "。 それができないなら、あなたは"}, {"type": "subtitle", "time": 629.59, "timestamp": "00:10:29", "text": "大変苦労することになるでしょう。 ナチュラル"}, {"type": "subtitle", "time": 635.59, "timestamp": "00:10:35", "text": "ジェルの毛穴に関する試験を受けるとき、かなりの時間を無駄にすることになりますよね？ それが私が"}, {"type": "subtitle", "time": 637.99, "timestamp": "00:10:37", "text": "気づいたことです。"}, {"type": "subtitle", "time": 640.31, "timestamp": "00:10:40", "text": "それでは、ペンタブレットを接続してみましょう。"}, {"type": "subtitle", "time": 643.67, "timestamp": "00:10:43", "text": "それでは、PDFファイルを直接編集します。"}, {"type": "subtitle", "time": 647.509, "timestamp": "00:10:47", "text": "わかった？ ということは、"}, {"type": "subtitle", "time": 651.269, "timestamp": "00:10:51", "text": "ブラウザ上でやらなければならないということですね。"}, {"type": "subtitle", "time": 653.11, "timestamp": "00:10:53", "text": "えっと、ちょっと"}, {"type": "subtitle", "time": 656.63, "timestamp": "00:10:56", "text": "確認させてください。  Edgeを使うべきか、それとも"}, {"type": "subtitle", "time": 659.19, "timestamp": "00:10:59", "text": "Vivaldを使うべきか？"}]
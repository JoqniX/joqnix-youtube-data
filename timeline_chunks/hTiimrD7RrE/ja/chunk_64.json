[{"type": "subtitle", "time": 3854.87, "timestamp": "01:04:14", "text": "オーケー。 わかった。 これは数学の"}, {"type": "subtitle", "time": 3865.109, "timestamp": "01:04:25", "text": "彼らは1000円持っていて、"}, {"type": "subtitle", "time": 3868.069, "timestamp": "01:04:28", "text": "600円のケーキを買いました。"}, {"type": "subtitle", "time": 3870.87, "timestamp": "01:04:30", "text": "だから1000 - 600…"}, {"type": "subtitle", "time": 3874.71, "timestamp": "01:04:34", "text": "数学がわからない。 ああ、神様。 待って。  10 - 6"}, {"type": "subtitle", "time": 3880.549, "timestamp": "01:04:40", "text": "えーと 5 6 ああ 400 400。わかりました。"}]
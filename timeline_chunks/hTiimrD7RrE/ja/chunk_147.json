[{"type": "subtitle", "time": 8828.309, "timestamp": "02:27:08", "text": "私はただ、ガイド"}, {"type": "subtitle", "time": 8830.55, "timestamp": "02:27:10", "text": "トラックなしで読んでいるだけです。   たくさんの"}, {"type": "subtitle", "time": 8833.27, "timestamp": "02:27:13", "text": "曲。   たくさんの"}, {"type": "subtitle", "time": 8836.79, "timestamp": "02:27:16", "text": "曲。 ええ、"}, {"type": "subtitle", "time": 8840.07, "timestamp": "02:27:20", "text": "この2つは得意です。 ドールストーリーは私の"}, {"type": "subtitle", "time": 8841.59, "timestamp": "02:27:21", "text": "お気に入りで、"}, {"type": "subtitle", "time": 8851.51, "timestamp": "02:27:31", "text": "ええ、"}, {"type": "subtitle", "time": 8854.63, "timestamp": "02:27:34", "text": "この歌を歌ってプロポーズしようとしたのですが、これは途中で"}, {"type": "subtitle", "time": 8858.79, "timestamp": "02:27:38", "text": "声が出なくなってしまう曲でした。"}, {"type": "subtitle", "time": 8865.83, "timestamp": "02:27:45", "text": "ナナのプロポーズですが、"}, {"type": "subtitle", "time": 8868.95, "timestamp": "02:27:48", "text": "最近ナトゥリが出したプロポーズの曲があって、"}, {"type": "subtitle", "time": 8871.99, "timestamp": "02:27:51", "text": "それを習いたいんです。"}]
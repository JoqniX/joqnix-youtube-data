[{"type": "subtitle", "time": 2292.39, "timestamp": "00:38:12", "text": "忘れてるかな？炎レベルの"}, {"type": "subtitle", "time": 2306.23, "timestamp": "00:38:26", "text": "この漢字を忘れてしまいました。 ああ、シマサ。   えっと、私です"}, {"type": "subtitle", "time": 2310.15, "timestamp": "00:38:30", "text": "。   何てことだ"}, {"type": "subtitle", "time": 2314.39, "timestamp": "00:38:34", "text": "。 この漢字を忘れてしまった。 じゃーん、ダッシュ。   違う"}, {"type": "subtitle", "time": 2330.2, "timestamp": "00:38:50", "text": "。"}]
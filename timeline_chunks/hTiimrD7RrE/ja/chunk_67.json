[{"type": "subtitle", "time": 4031.51, "timestamp": "01:07:11", "text": "、これ忘れてた。"}, {"type": "subtitle", "time": 4033.349, "timestamp": "01:07:13", "text": "ああ、キマス。"}, {"type": "subtitle", "time": 4060.63, "timestamp": "01:07:40", "text": "ああ、私の研究の先生が、"}, {"type": "subtitle", "time": 4063.51, "timestamp": "01:07:43", "text": "質問者をくれたんです。"}, {"type": "subtitle", "time": 4067.109, "timestamp": "01:07:47", "text": "それを配信中にやるべきでしょうか？ この後ならどうだろう？"}, {"type": "subtitle", "time": 4069.029, "timestamp": "01:07:49", "text": "よし、もう"}, {"type": "subtitle", "time": 4070.71, "timestamp": "01:07:50", "text": "時間がない。 あと2つの"}, {"type": "subtitle", "time": 4075.43, "timestamp": "01:07:55", "text": "セクションを終えると、漢字に入ります。"}]
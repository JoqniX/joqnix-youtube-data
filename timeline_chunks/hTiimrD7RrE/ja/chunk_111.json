[{"type": "subtitle", "time": 6678.95, "timestamp": "01:51:18", "text": "こんにちは。 えっと、ドーン・ファイアフライの曲です。   私は"}, {"type": "subtitle", "time": 6690.79, "timestamp": "01:51:30", "text": "最近"}, {"type": "subtitle", "time": 6693.189, "timestamp": "01:51:33", "text": "それを学び始めたので、そうしないでください。 だから、自分にどれだけのことができるのか確認したいんです"}, {"type": "subtitle", "time": 6697.189, "timestamp": "01:51:37", "text": "。 どうやら私は読解力があるようで、"}, {"type": "subtitle", "time": 6703.189, "timestamp": "01:51:43", "text": "日本語で読むよりもロマニー語の方が上手に読めるようです。 私はそれを変えなければならない。"}]
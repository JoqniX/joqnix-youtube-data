[{"type": "subtitle", "time": 6066.229, "timestamp": "01:41:06", "text": "皆さんは"}, {"type": "subtitle", "time": 6069.83, "timestamp": "01:41:09", "text": "日本語、音声学、言語に関するアンケートを見逃しましたね"}, {"type": "subtitle", "time": 6075.109, "timestamp": "01:41:15", "text": "。 調査研究"}, {"type": "subtitle", "time": 6086.229, "timestamp": "01:41:26", "text": "いやあ、すごく美味しかったよ。 こぼしてしまった"}, {"type": "subtitle", "time": 6088.149, "timestamp": "01:41:28", "text": "。 こぼれたミルクだ。"}, {"type": "subtitle", "time": 6092.47, "timestamp": "01:41:32", "text": "大丈夫です。 私は理性を失った。 大丈夫です。"}, {"type": "subtitle", "time": 6102.55, "timestamp": "01:41:42", "text": "でも、そうですね、私は"}, {"type": "subtitle", "time": 6117.59, "timestamp": "01:41:57", "text": "持ち物が"}]
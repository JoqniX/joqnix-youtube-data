[{"type": "subtitle", "time": 5467.11, "timestamp": "01:31:07", "text": "待って。 でもそれは"}, {"type": "subtitle", "time": 5477.51, "timestamp": "01:31:17", "text": "カバノア カバン カバン クイ クイ"}, {"type": "subtitle", "time": 5489.59, "timestamp": "01:31:29", "text": "サカイ サカイ それは言葉じゃない"}, {"type": "subtitle", "time": 5496.47, "timestamp": "01:31:36", "text": "ヤヤシヤサシ。 わかった。 カバン。 箱。 カード。"}, {"type": "subtitle", "time": 5499.91, "timestamp": "01:31:39", "text": "待って。  Cabanは"}, {"type": "subtitle", "time": 5503.27, "timestamp": "01:31:43", "text": "タクシーのようなものだ。 さて、タクシーが親切な存在になるにはどうすればいいでしょうか？ だから、クイクイになるよ"}]
[{"type": "subtitle", "time": 8123.589, "timestamp": "02:15:23", "text": "うわ、あくびしちゃったよ、兄弟。 うわ、"}, {"type": "subtitle", "time": 8126.149, "timestamp": "02:15:26", "text": "最後のやつ、失敗しちゃった。"}, {"type": "subtitle", "time": 8129.91, "timestamp": "02:15:29", "text": "私は叫ぶことができなかった、あくびをしたんだ、兄弟。"}, {"type": "subtitle", "time": 8146.87, "timestamp": "02:15:46", "text": "楽器演奏を有効にする設定は、今日の後半に行います"}, {"type": "subtitle", "time": 8150.39, "timestamp": "02:15:50", "text": "。 それで、カラオケをする時"}, {"type": "subtitle", "time": 8154.069, "timestamp": "02:15:54", "text": "、例えば、伴奏なしで私が適当に歌うのではなく、インス"}, {"type": "subtitle", "time": 8155.99, "timestamp": "02:15:55", "text": "トゥルメンタルを皆さんに聴いてもらうこともできるよ"}]
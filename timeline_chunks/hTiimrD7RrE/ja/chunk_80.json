[{"type": "subtitle", "time": 4817.83, "timestamp": "01:20:17", "text": "【音楽】"}, {"type": "subtitle", "time": 4829.51, "timestamp": "01:20:29", "text": "[音楽]"}, {"type": "subtitle", "time": 4833.99, "timestamp": "01:20:33", "text": "ああ、南南北。"}, {"type": "subtitle", "time": 4838.07, "timestamp": "01:20:38", "text": "道順を忘れてしまったのは、何だったんだろう？ ああ、主よ。 えっと、"}, {"type": "subtitle", "time": 4840.07, "timestamp": "01:20:40", "text": "ハイキングって"}, {"type": "subtitle", "time": 4843.83, "timestamp": "01:20:43", "text": "北の方ですか？ 南。 いいえ、南は南です。"}]
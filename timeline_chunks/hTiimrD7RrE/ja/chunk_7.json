[{"type": "subtitle", "time": 421.35, "timestamp": "00:07:01", "text": "文法のセグメントと読解の"}, {"type": "subtitle", "time": 424.23, "timestamp": "00:07:04", "text": "セグメントがあります。こんにちは、ええ、こんにちは、ソナンさん、こんにちは、"}, {"type": "subtitle", "time": 428.79, "timestamp": "00:07:08", "text": "ササンさん、こんにちは、ようこそ。"}, {"type": "subtitle", "time": 431.51, "timestamp": "00:07:11", "text": "どんなクラスを受講していますか？私は"}, {"type": "subtitle", "time": 434.79, "timestamp": "00:07:14", "text": "日本語の授業に出席しています。それで、"}, {"type": "subtitle", "time": 438.95, "timestamp": "00:07:18", "text": "もしあなたが"}, {"type": "subtitle", "time": 441.51, "timestamp": "00:07:21", "text": "5つ合格していたら、これは"}, {"type": "subtitle", "time": 445.99, "timestamp": "00:07:25", "text": "私たちのクラスの何人かの学生のためのものです。彼らは"}, {"type": "subtitle", "time": 451.83, "timestamp": "00:07:31", "text": "まだN5試験を受けていません。 えっと、それで、"}, {"type": "subtitle", "time": 456.07, "timestamp": "00:07:36", "text": "彼らはそれを日曜日に開催するんです。   えっと、"}, {"type": "subtitle", "time": 458.87, "timestamp": "00:07:38", "text": "私にとっては復習みたいなものですね。 ええ"}, {"type": "subtitle", "time": 462.55, "timestamp": "00:07:42", "text": "、これはどちらかというと要約のようなものです"}, {"type": "subtitle", "time": 466.95, "timestamp": "00:07:46", "text": "。 ええ、そうですね、"}, {"type": "subtitle", "time": 471.589, "timestamp": "00:07:51", "text": "課題みたいなものですが、同時に"}, {"type": "subtitle", "time": 475.67, "timestamp": "00:07:55", "text": "こんにちはという感じでもあります。 ええと、そうですね、"}, {"type": "subtitle", "time": 478.95, "timestamp": "00:07:58", "text": "ストリームストリームでやりたかったんです。 えっと、その前に、"}]
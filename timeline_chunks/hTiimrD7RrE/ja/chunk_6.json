[{"type": "subtitle", "time": 362.39, "timestamp": "00:06:02", "text": "今日の試験のために練習したり復習したりする時間がなかったんです"}, {"type": "subtitle", "time": 365.83, "timestamp": "00:06:05", "text": "。 ありがたいことに、今日の試験は、ええと、"}, {"type": "subtitle", "time": 369.83, "timestamp": "00:06:09", "text": "センシットが"}, {"type": "subtitle", "time": 373.029, "timestamp": "00:06:13", "text": "時間制限を設けたようなものでした。 つまり、明日の午前10時までに"}, {"type": "subtitle", "time": 374.71, "timestamp": "00:06:14", "text": "提出しなければならないということです"}, {"type": "subtitle", "time": 376.87, "timestamp": "00:06:16", "text": "。 それが締め切りです。 つまり、"}, {"type": "subtitle", "time": 379.59, "timestamp": "00:06:19", "text": "PDF のようなもので、"}, {"type": "subtitle", "time": 384.71, "timestamp": "00:06:24", "text": "N5 や Q5 や"}, {"type": "subtitle", "time": 387.029, "timestamp": "00:06:27", "text": "P のワークシートのようなサンプル用紙、"}, {"type": "subtitle", "time": 389.27, "timestamp": "00:06:29", "text": "サンプル用紙のようなものです。 そう、まさにそれみたいなものだ"}, {"type": "chat", "time": 389.895, "timestamp": "00:06:29", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "so its like a assignment??"}, {"type": "subtitle", "time": 391.749, "timestamp": "00:06:31", "text": "。 それで、各"}, {"type": "subtitle", "time": 395.749, "timestamp": "00:06:35", "text": "セクションを順に見ていく必要があります。PDF 1 と PDF"}, {"type": "subtitle", "time": 398.55, "timestamp": "00:06:38", "text": "2 があります。PDF2 は語彙と漢字です。"}, {"type": "subtitle", "time": 401.59000000000003, "timestamp": "00:06:41", "text": "PDF 1 は、えっと、"}, {"type": "subtitle", "time": 405.51, "timestamp": "00:06:45", "text": "何て言うんだっけ？ えーと、PDF 版には、"}, {"type": "subtitle", "time": 409.83, "timestamp": "00:06:49", "text": "文法とか"}, {"type": "subtitle", "time": 411.749, "timestamp": "00:06:51", "text": "あれこれといったものが全部入っているよ。"}, {"type": "subtitle", "time": 416.469, "timestamp": "00:06:56", "text": "うん。 基本的にN5またはQ5試験には、"}, {"type": "subtitle", "time": 419.67, "timestamp": "00:06:59", "text": "漢字のセグメントと"}]
[{"type": "subtitle", "time": 300.07, "timestamp": "00:05:00", "text": "Prattというソフトウェアをご存知でしょうか？ それは、"}, {"type": "subtitle", "time": 306.23, "timestamp": "00:05:06", "text": "自分の声を録音すると、"}, {"type": "subtitle", "time": 308.79, "timestamp": "00:05:08", "text": "周波数やイントネーションなどを分析してくれるソフトウェアのようなものです"}, {"type": "chat", "time": 309.841, "timestamp": "00:05:09", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "I am not"}, {"type": "subtitle", "time": 312.23, "timestamp": "00:05:12", "text": "。 ええ、そんな感じです。 ええ、"}, {"type": "subtitle", "time": 314.79, "timestamp": "00:05:14", "text": "今日"}, {"type": "subtitle", "time": 317.51, "timestamp": "00:05:17", "text": "研究者から聞きました。 えっと、"}, {"type": "chat", "time": 318.016, "timestamp": "00:05:18", "author": "@Surya_VT", "avatar": "https://yt4.ggpht.com/xYZGMsDSkF4w1IOdT2xKmMHI-M3-NParGStQvKERjxxwivecaInz95y5n8jliQSZ7SgMMYzdrw=s64-c-k-c0x00ffffff-no-rj", "message": "ohh"}, {"type": "subtitle", "time": 320.55, "timestamp": "00:05:20", "text": "私が音楽とかそういうものに興味があったから、彼女がこういうことを教えてくれたんです"}, {"type": "subtitle", "time": 323.27, "timestamp": "00:05:23", "text": "。 私は"}, {"type": "subtitle", "time": 325.67, "timestamp": "00:05:25", "text": "自分の趣味や"}, {"type": "subtitle", "time": 328.15, "timestamp": "00:05:28", "text": "日本でやりたいことなど、全てを話しました。 彼女は"}, {"type": "subtitle", "time": 332.39, "timestamp": "00:05:32", "text": "私にすべてを話してくれた。 だから、良かったよ。 えっと、"}, {"type": "subtitle", "time": 335.909, "timestamp": "00:05:35", "text": "今日は"}, {"type": "subtitle", "time": 338.629, "timestamp": "00:05:38", "text": "アカデミーのオフィスに"}, {"type": "subtitle", "time": 341.59000000000003, "timestamp": "00:05:41", "text": "7時間くらいいて、ボーカル"}, {"type": "subtitle", "time": 343.99, "timestamp": "00:05:43", "text": "レコーディングをしていました。"}, {"type": "subtitle", "time": 347.83, "timestamp": "00:05:47", "text": "日本語でその文章を読み上げなければならず、"}, {"type": "subtitle", "time": 351.51, "timestamp": "00:05:51", "text": "母国語にも翻訳しなければなりませんでした"}, {"type": "subtitle", "time": 354.95, "timestamp": "00:05:54", "text": "。 ええ、大変でした。 だから、"}]
[{"type": "subtitle", "time": 7805.83, "timestamp": "02:10:05", "text": "これは"}, {"type": "subtitle", "time": 7807.99, "timestamp": "02:10:07", "text": "不器用なことと人生がどう"}, {"type": "subtitle", "time": 7809.99, "timestamp": "02:10:09", "text": "扱うかについての歌で、まるで馬鹿みたいに逆さまになっていて、"}, {"type": "subtitle", "time": 7812.87, "timestamp": "02:10:12", "text": "死にたいけど"}, {"type": "subtitle", "time": 7815.91, "timestamp": "02:10:15", "text": "[ __ ]ない、死にたいけど"}, {"type": "subtitle", "time": 7819.51, "timestamp": "02:10:19", "text": "死にたくない、そんな瞬間。うん、それは"}, {"type": "subtitle", "time": 7823.51, "timestamp": "02:10:23", "text": "深すぎる歌だと思うけど、"}, {"type": "subtitle", "time": 7826.709, "timestamp": "02:10:26", "text": "いい歌だと思う、"}, {"type": "subtitle", "time": 7845.43, "timestamp": "02:10:45", "text": "【音楽】"}, {"type": "subtitle", "time": 7846.76, "timestamp": "02:10:46", "text": "フォーラム。"}]
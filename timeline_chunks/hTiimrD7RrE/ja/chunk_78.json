[{"type": "subtitle", "time": 4711.189, "timestamp": "01:18:31", "text": "これは1ヶ月のガンジです。 つまり、これは"}, {"type": "subtitle", "time": 4715.35, "timestamp": "01:18:35", "text": "1ヶ月間のはずなんです。 だから、"}, {"type": "subtitle", "time": 4723.83, "timestamp": "01:18:43", "text": "サキはサキ、ササ、サキはサキ、スキ、サキになります"}, {"type": "subtitle", "time": 4726.39, "timestamp": "01:18:46", "text": "。 そんな話は聞いたことがない。   わかった"}, {"type": "subtitle", "time": 4732.31, "timestamp": "01:18:52", "text": "。 私のスキ。 ミスキ。"}, {"type": "subtitle", "time": 4735.43, "timestamp": "01:18:55", "text": "善逸。 ゼンは「これ聞いたことある」と言う。 わかった。"}]
[{"type": "subtitle", "time": 4202.149, "timestamp": "01:10:02", "text": "。 わかった。  ２、３。  2人か3"}, {"type": "subtitle", "time": 4205.91, "timestamp": "01:10:05", "text": "人。 わかった。  5回中3回。 五。"}, {"type": "subtitle", "time": 4208.79, "timestamp": "01:10:08", "text": "何人くらいが行ったの？ それで、"}, {"type": "subtitle", "time": 4210.31, "timestamp": "01:10:10", "text": "ええと、"}, {"type": "subtitle", "time": 4215.03, "timestamp": "01:10:15", "text": "何人かの人はやらなければならない仕事があったのですが、ええと"}, {"type": "subtitle", "time": 4222.31, "timestamp": "01:10:22", "text": "いや、待って、いや、いや。 おそらく合計で"}, {"type": "subtitle", "time": 4224.149, "timestamp": "01:10:24", "text": "3、4、5でしょう。 では、"}, {"type": "subtitle", "time": 4249.75, "timestamp": "01:10:49", "text": "待って。 私はカスコを見ました。 カスクさんを見ました。"}, {"type": "subtitle", "time": 4252.47, "timestamp": "01:10:52", "text": "カスク。"}, {"type": "subtitle", "time": 4255.27, "timestamp": "01:10:55", "text": "えっと、"}, {"type": "subtitle", "time": 4258.47, "timestamp": "01:10:58", "text": "カズクでいきます。 それが"}]
[{"type": "subtitle", "time": 1142.47, "timestamp": "00:19:02", "text": "そう、彼らはこれをタイミングよくやってるんだ。"}, {"type": "subtitle", "time": 1155.19, "timestamp": "00:19:15", "text": "ここにいるすべてのユーチューバーに、それぞれ"}, {"type": "subtitle", "time": 1158.39, "timestamp": "00:19:18", "text": "独自の声優がいるんだ。これもそうだ。"}, {"type": "subtitle", "time": 1168.31, "timestamp": "00:19:28", "text": "声優の演技はすごかった、すごい、彼らは"}, {"type": "subtitle", "time": 1170.95, "timestamp": "00:19:30", "text": "これにたくさんの労力を費やしたんだな。でも、"}, {"type": "subtitle", "time": 1173.59, "timestamp": "00:19:33", "text": "これは使えないと思う。だって、私にとってはこれが"}, {"type": "subtitle", "time": 1176.71, "timestamp": "00:19:36", "text": "40分だから。"}, {"type": "subtitle", "time": 1179.43, "timestamp": "00:19:39", "text": "この人も使えるかどうかわからないし。"}, {"type": "subtitle", "time": 1187.029, "timestamp": "00:19:47", "text": "だから、Windowsのアラームとかタイマーとか"}, {"type": "subtitle", "time": 1190.549, "timestamp": "00:19:50", "text": "時計を使って時間を設定することにする。時間を計るべきかどうかわからない"}, {"type": "subtitle", "time": 1197.11, "timestamp": "00:19:57", "text": "けど、ある意味、時間を計らなきゃいけない。"}, {"type": "subtitle", "time": 1199.99, "timestamp": "00:19:59", "text": "実際に試験を受けているなら、"}]
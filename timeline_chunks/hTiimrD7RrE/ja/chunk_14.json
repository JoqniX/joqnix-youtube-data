[{"type": "subtitle", "time": 858.87, "timestamp": "00:14:18", "text": "。 水分補給を忘れずに。"}, {"type": "subtitle", "time": 861.75, "timestamp": "00:14:21", "text": "水を飲みましょう。   ポ"}, {"type": "subtitle", "time": 866.629, "timestamp": "00:14:26", "text": "ドーロタイマーを設定しなければならない。"}, {"type": "subtitle", "time": 869.75, "timestamp": "00:14:29", "text": "ポドーロタイマー。 それって、"}, {"type": "subtitle", "time": 872.47, "timestamp": "00:14:32", "text": "勉強用タイマーみたいなものですよね？  25分間"}, {"type": "subtitle", "time": 875.91, "timestamp": "00:14:35", "text": "勉強したり仕事をしたりして、5分間"}, {"type": "subtitle", "time": 878.71, "timestamp": "00:14:38", "text": "休憩したり、15分間休憩してからまた"}, {"type": "subtitle", "time": 881.59, "timestamp": "00:14:41", "text": "仕事に戻る、タスク1、タスク2のような感じですよね。"}, {"type": "chat", "time": 888.033, "timestamp": "00:14:48", "author": "@sagirixvio", "avatar": "https://yt4.ggpht.com/xJRT5L3mG6ChvkcGJnQ7sbLEO1ILEfSoMy-rPaG9bEfLs-EINW2YBe4WD5qnBR4UtNCnqAFKHA=s64-c-k-c0x00ffffff-no-rj", "message": "pomodoro?"}]
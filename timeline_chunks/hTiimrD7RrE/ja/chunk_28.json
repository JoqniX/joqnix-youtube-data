[{"type": "subtitle", "time": 1681.669, "timestamp": "00:28:01", "text": "ああ、残り時間はあと1分だ。 さあ、"}, {"type": "subtitle", "time": 1684.389, "timestamp": "00:28:04", "text": "時間が迫っているぞ、みんな。"}, {"type": "subtitle", "time": 1687.029, "timestamp": "00:28:07", "text": "時間は刻々と過ぎていく。 わかりました、"}, {"type": "subtitle", "time": 1689.83, "timestamp": "00:28:09", "text": "最初の"}, {"type": "subtitle", "time": 1693.35, "timestamp": "00:28:13", "text": "質問は却下して、えーと始めます。 よし、"}, {"type": "subtitle", "time": 1699.59, "timestamp": "00:28:19", "text": "。 わかった。 えっと、"}, {"type": "subtitle", "time": 1702.549, "timestamp": "00:28:22", "text": "2つ目の質問も開いたままにして、"}, {"type": "subtitle", "time": 1708.23, "timestamp": "00:28:28", "text": "漢字の質問もできるようにした方がいいですか？"}, {"type": "subtitle", "time": 1710.07, "timestamp": "00:28:30", "text": "うん、ここに置いておくよ。 残り"}, {"type": "subtitle", "time": 1723.029, "timestamp": "00:28:43", "text": "パステルカラーを答えとして選びます。ああ、"}, {"type": "subtitle", "time": 1727.11, "timestamp": "00:28:47", "text": "青で十分だと思います。 おい。 こんにちは。"}, {"type": "subtitle", "time": 1737.83, "timestamp": "00:28:57", "text": "こんにちは、Gさん。チャットを確認したいのですが。"}]
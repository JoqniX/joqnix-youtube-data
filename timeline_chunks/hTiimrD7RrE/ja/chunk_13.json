[{"type": "subtitle", "time": 786.949, "timestamp": "00:13:06", "text": "修正する時間があればよかったのにと思います"}, {"type": "subtitle", "time": 789.68, "timestamp": "00:13:09", "text": "。"}, {"type": "subtitle", "time": 792.23, "timestamp": "00:13:12", "text": "[音楽]"}, {"type": "subtitle", "time": 796.15, "timestamp": "00:13:16", "text": "えーと、"}, {"type": "subtitle", "time": 800.55, "timestamp": "00:13:20", "text": "インスタグラムで"}, {"type": "subtitle", "time": 803.11, "timestamp": "00:13:23", "text": "ストーリーを作成するときに作成機能が使えなくて変なんです。カメラを覆うような"}, {"type": "subtitle", "time": 805.59, "timestamp": "00:13:25", "text": "真っ黒な空白の写真を撮って、"}, {"type": "subtitle", "time": 812.87, "timestamp": "00:13:32", "text": "ストリームのリンク"}, {"type": "subtitle", "time": 816.87, "timestamp": "00:13:36", "text": "とか色々入れないといけないんです。すごく面倒くさいです。"}, {"type": "subtitle", "time": 820.79, "timestamp": "00:13:40", "text": "他の人もこのバグに遭遇しているかわかりませんが"}, {"type": "subtitle", "time": 828.3, "timestamp": "00:13:48", "text": "うん。"}, {"type": "subtitle", "time": 832.23, "timestamp": "00:13:52", "text": "[音楽]"}, {"type": "subtitle", "time": 835.829, "timestamp": "00:13:55", "text": "えーと、私がライブ配信中だってツイートしたっけ？   はい"}]
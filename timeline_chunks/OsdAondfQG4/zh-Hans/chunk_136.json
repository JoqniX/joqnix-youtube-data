[{"type": "subtitle", "time": 8161.99, "timestamp": "02:16:01", "text": "而且，你还在咳嗽。所以，我不"}, {"type": "subtitle", "time": 8165.75, "timestamp": "02:16:05", "text": "我觉得我应该让你多说话。"}, {"type": "subtitle", "time": 8167.43, "timestamp": "02:16:07", "text": "没关系。我习惯了多说话。"}, {"type": "subtitle", "time": 8170.85, "timestamp": "02:16:10", "text": "这是我工作的一部分。"}, {"type": "subtitle", "time": 8186.47, "timestamp": "02:16:26", "text": "你对此有何看法？呃，"}, {"type": "subtitle", "time": 8188.87, "timestamp": "02:16:28", "text": "你是否曾感到别人评判你？"}, {"type": "subtitle", "time": 8190.35, "timestamp": "02:16:30", "text": "因为你"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "数字？人数不够，"}, {"type": "subtitle", "time": 8196.669, "timestamp": "02:16:36", "text": "人们并不完全认同你的观点。"}, {"type": "subtitle", "time": 8199.429, "timestamp": "02:16:39", "text": "事物。有过什么不好的经历吗？"}, {"type": "subtitle", "time": 8205.309, "timestamp": "02:16:45", "text": "[音乐]"}, {"type": "subtitle", "time": 8209.99, "timestamp": "02:16:49", "text": "因为我认识一些在推特上的人，或者喜欢……"}, {"type": "subtitle", "time": 8212.469, "timestamp": "02:16:52", "text": "我猜X上的人看到了我的号码，"}, {"type": "subtitle", "time": 8213.629, "timestamp": "02:16:53", "text": "它们是"}, {"type": "subtitle", "time": 8216.389, "timestamp": "02:16:56", "text": "比如，“哦，你至少有1000分。你是……”"}, {"type": "subtitle", "time": 8219.03, "timestamp": "02:16:59", "text": "好的。”然后他们就喜欢我了。"}]
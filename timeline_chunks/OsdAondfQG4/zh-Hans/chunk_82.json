[{"type": "subtitle", "time": 4922.229, "timestamp": "01:22:02", "text": "最长可达 3 天。"}, {"type": "subtitle", "time": 4926.39, "timestamp": "01:22:06", "text": "哦，所以，是的，就像你可以扮演的角色一样"}, {"type": "subtitle", "time": 4928.87, "timestamp": "01:22:08", "text": "从某种意义上说，它有点像原神，你"}, {"type": "subtitle", "time": 4930.91, "timestamp": "01:22:10", "text": "可以获得其他角色并扮演他们"}, {"type": "subtitle", "time": 4934.47, "timestamp": "01:22:14", "text": "它们在《星际战甲》中需要建造。"}, {"type": "subtitle", "time": 4937.189, "timestamp": "01:22:17", "text": "角色并提升他们的等级以使用"}, {"type": "subtitle", "time": 4939.75, "timestamp": "01:22:19", "text": "能力之类的。"}, {"type": "subtitle", "time": 4942.189, "timestamp": "01:22:22", "text": "哦"}, {"type": "subtitle", "time": 4944.87, "timestamp": "01:22:24", "text": "是的。哦，我看到你玩《呼啸海啸》了。"}, {"type": "subtitle", "time": 4947.91, "timestamp": "01:22:27", "text": "也。我上个月才开始做这件事。哦，"}, {"type": "subtitle", "time": 4950.39, "timestamp": "01:22:30", "text": "它怎么样？旅途如何？我喜欢"}, {"type": "subtitle", "time": 4953.669, "timestamp": "01:22:33", "text": "它。我已经……我不知道。我是"}, {"type": "subtitle", "time": 4958.229, "timestamp": "01:22:38", "text": "快到50级了。哇哦。如何？哦，我的"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "上帝。我仍在努力。"}, {"type": "subtitle", "time": 4963.95, "timestamp": "01:22:43", "text": "我有很多好东西。我有"}, {"type": "subtitle", "time": 4969.669, "timestamp": "01:22:49", "text": "扎尼。我有……Chamellia。我有呃谁"}, {"type": "subtitle", "time": 4971.59, "timestamp": "01:22:51", "text": "和扎尼在一起的是谁？呃"}, {"type": "subtitle", "time": 4974.229, "timestamp": "01:22:54", "text": "小女孩。有光的那个。呃"}, {"type": "subtitle", "time": 4975.91, "timestamp": "01:22:55", "text": "法比。"}, {"type": "subtitle", "time": 4978.75, "timestamp": "01:22:58", "text": "是的，菲比。菲比也是。"}]
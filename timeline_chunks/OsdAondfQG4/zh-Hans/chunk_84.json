[{"type": "subtitle", "time": 5041.11, "timestamp": "01:24:01", "text": "索娜，但也像"}, {"type": "subtitle", "time": 5044.31, "timestamp": "01:24:04", "text": "我想，是的，就团队而言。萨科纳不是吗？"}, {"type": "subtitle", "time": 5046.149, "timestamp": "01:24:06", "text": "应该是另一个支撑点吧？是的，"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "支持。是的。"}, {"type": "subtitle", "time": 5050.229, "timestamp": "01:24:10", "text": "哦，"}, {"type": "subtitle", "time": 5052.55, "timestamp": "01:24:12", "text": "我喜欢她演奏音乐。"}, {"type": "subtitle", "time": 5059.83, "timestamp": "01:24:19", "text": "我当时就想，“哇，这太酷了。”"}, {"type": "subtitle", "time": 5067.59, "timestamp": "01:24:27", "text": "龙女太棒了。显然，"}, {"type": "subtitle", "time": 5071.59, "timestamp": "01:24:31", "text": "动画。哦，我好想要她。"}, {"type": "subtitle", "time": 5074.149, "timestamp": "01:24:34", "text": "她是我下一个要训练的队员。我的下一个单元是"}, {"type": "subtitle", "time": 5076.47, "timestamp": "01:24:36", "text": "会成为她。我不知道她什么时候"}, {"type": "subtitle", "time": 5078.79, "timestamp": "01:24:38", "text": "横幅是。现在已经到了吗？我没有"}, {"type": "subtitle", "time": 5081.83, "timestamp": "01:24:41", "text": "大概三周没玩了。"}, {"type": "subtitle", "time": 5085.51, "timestamp": "01:24:45", "text": "我觉得应该是下一个横幅广告。"}, {"type": "subtitle", "time": 5088.229, "timestamp": "01:24:48", "text": "下一个横幅。我的天啊。哦，我一直"}, {"type": "subtitle", "time": 5092.629, "timestamp": "01:24:52", "text": "保存。不过我也不确定。我没有"}, {"type": "subtitle", "time": 5095.51, "timestamp": "01:24:55", "text": "我也玩了一会儿。哦，等等。呃，我"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "活动尚未结束。骰子"}]
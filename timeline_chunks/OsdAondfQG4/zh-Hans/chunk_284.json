[{"type": "subtitle", "time": 17040.83, "timestamp": "04:44:00", "text": "疲劳的。你知道"}, {"type": "subtitle", "time": 17043.35, "timestamp": "04:44:03", "text": "什么？呃"}, {"type": "subtitle", "time": 17045.628, "timestamp": "04:44:05", "text": "我不知道什么时候才能拿到我的"}, {"type": "subtitle", "time": 17048.35, "timestamp": "04:44:08", "text": "早餐，但一旦我吃完我的"}, {"type": "subtitle", "time": 17052.23, "timestamp": "04:44:12", "text": "吃完早餐，我回家的时候就……"}, {"type": "subtitle", "time": 17055.51, "timestamp": "04:44:15", "text": "现在，回到我最新的住处，我不会"}, {"type": "subtitle", "time": 17058.83, "timestamp": "04:44:18", "text": "洗个澡。我就这样去吃吧"}, {"type": "subtitle", "time": 17061.91, "timestamp": "04:44:21", "text": "早餐，又这样出来了。"}, {"type": "subtitle", "time": 17064.47, "timestamp": "04:44:24", "text": "这次要浸入床单里"}, {"type": "subtitle", "time": 17067.19, "timestamp": "04:44:27", "text": "顺便说一句，我穿的是拖鞋。游个泳"}, {"type": "subtitle", "time": 17070.948, "timestamp": "04:44:30", "text": "盖上床单，然后走回家"}, {"type": "subtitle", "time": 17089.43, "timestamp": "04:44:49", "text": "地方。嘿，我应该拍张照片吗？"}, {"type": "subtitle", "time": 17092.948, "timestamp": "04:44:52", "text": "那是我吗？但你们却做不到。"}, {"type": "subtitle", "time": 17099.35, "timestamp": "04:44:59", "text": "乘货船之类的。并且关于"}]
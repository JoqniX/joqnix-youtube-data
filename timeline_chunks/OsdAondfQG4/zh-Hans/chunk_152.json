[{"type": "subtitle", "time": 9121.51, "timestamp": "02:32:01", "text": "最近与 Sumu 的合作就像是"}, {"type": "subtitle", "time": 9126.07, "timestamp": "02:32:06", "text": "鸭鸭鹅。啊，鸭鹅。我从未"}, {"type": "subtitle", "time": 9129.03, "timestamp": "02:32:09", "text": "玩过。好玩吗？"}, {"type": "subtitle", "time": 9131.349, "timestamp": "02:32:11", "text": "挺有意思的。对，就像《Among Us》一样。"}, {"type": "subtitle", "time": 9134.309, "timestamp": "02:32:14", "text": "这样你们就能互相交谈了。"}, {"type": "subtitle", "time": 9137.27, "timestamp": "02:32:17", "text": "啊，"}, {"type": "subtitle", "time": 9138.87, "timestamp": "02:32:18", "text": "真不错，因为那里有一只鸭子。"}, {"type": "subtitle", "time": 9140.71, "timestamp": "02:32:20", "text": "它会吃人，如果你吃了它……"}, {"type": "subtitle", "time": 9143.429, "timestamp": "02:32:23", "text": "你们这些人"}, {"type": "subtitle", "time": 9145.11, "timestamp": "02:32:25", "text": "就像你能听到他们在跟你说话一样。"}, {"type": "subtitle", "time": 9147.91, "timestamp": "02:32:27", "text": "而且其他人听不到。"}, {"type": "subtitle", "time": 9149.27, "timestamp": "02:32:29", "text": "就像它们在你胃里一样，而你"}, {"type": "subtitle", "time": 9150.79, "timestamp": "02:32:30", "text": "就听他们说，“为什么你听到"}, {"type": "subtitle", "time": 9157.16, "timestamp": "02:32:37", "text": "我喜欢那只鸭子。"}, {"type": "subtitle", "time": 9159.67, "timestamp": "02:32:39", "text": "[音乐]"}, {"type": "subtitle", "time": 9161.46, "timestamp": "02:32:41", "text": "很有趣。"}, {"type": "subtitle", "time": 9163.309, "timestamp": "02:32:43", "text": "[音乐]"}, {"type": "subtitle", "time": 9166.23, "timestamp": "02:32:46", "text": "但你直播多久了？"}, {"type": "subtitle", "time": 9169.91, "timestamp": "02:32:49", "text": "不是现在这种情况，而是通常意义上的情况。呃"}, {"type": "subtitle", "time": 9173.27, "timestamp": "02:32:53", "text": "就像我刚开始的时候一样"}, {"type": "subtitle", "time": 9176.79, "timestamp": "02:32:56", "text": "我们正在进行一些调整之类的。哦，我当时就像……"}, {"type": "subtitle", "time": 9178.75, "timestamp": "02:32:58", "text": "开始直播"}]
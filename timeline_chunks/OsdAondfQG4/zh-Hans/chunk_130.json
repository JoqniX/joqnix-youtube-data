[{"type": "subtitle", "time": 7801.03, "timestamp": "02:10:01", "text": "我想在X上观看直播，因为我买了X。"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "高级功能，只是想私信一个日本人。"}, {"type": "subtitle", "time": 7808.069, "timestamp": "02:10:08", "text": "块茎。我必须重新获得高级会员资格，而且"}, {"type": "subtitle", "time": 7810.79, "timestamp": "02:10:10", "text": "结果证明那是件坏事。没有"}, {"type": "subtitle", "time": 7814.069, "timestamp": "02:10:14", "text": "锻炼。他们至今仍未回应"}, {"type": "subtitle", "time": 7817.109, "timestamp": "02:10:17", "text": "我心想：“哇，我花了这么多钱。”"}, {"type": "subtitle", "time": 7824.31, "timestamp": "02:10:24", "text": "是的。是的，确实如此。但至少我可以"}, {"type": "subtitle", "time": 7826.35, "timestamp": "02:10:26", "text": "像这么多人喜欢"}, {"type": "subtitle", "time": 7830.03, "timestamp": "02:10:30", "text": "段落，推文段落。是的。"}, {"type": "subtitle", "time": 7833.99, "timestamp": "02:10:33", "text": "是的。限制是如何增加的？"}, {"type": "subtitle", "time": 7837.669, "timestamp": "02:10:37", "text": "帖子可以写多少字？ H"}, {"type": "subtitle", "time": 7839.229, "timestamp": "02:10:39", "text": "我考虑过要不要买"}, {"type": "subtitle", "time": 7844.83, "timestamp": "02:10:44", "text": "比如X是什么高级版。我考虑了一下，"}, {"type": "subtitle", "time": 7847.189, "timestamp": "02:10:47", "text": "但我认为实际上并没有"}, {"type": "subtitle", "time": 7849.99, "timestamp": "02:10:49", "text": "应该由我来做。我的意思是，最基本的"}, {"type": "subtitle", "time": 7853.27, "timestamp": "02:10:53", "text": "如果你只想……的话，一个更好。"}, {"type": "subtitle", "time": 7856.39, "timestamp": "02:10:56", "text": "写长一点的推文之类的。只是"}, {"type": "subtitle", "time": 7858.55, "timestamp": "02:10:58", "text": "他们有这个选择。不，"}]
[{"type": "subtitle", "time": 15967.469, "timestamp": "04:26:07", "text": "再说一遍，因为就像再说一遍，呃，你怎么称呼它"}, {"type": "subtitle", "time": 15970.75, "timestamp": "04:26:10", "text": "它？呃，这该怎么说呢？"}, {"type": "subtitle", "time": 15979.51, "timestamp": "04:26:19", "text": "疲劳的。我希望我没有误解"}, {"type": "subtitle", "time": 15982.67, "timestamp": "04:26:22", "text": "路线。是的。呃，等等。我当时是什么？"}, {"type": "subtitle", "time": 15985.389, "timestamp": "04:26:25", "text": "怎么说？等等，我忘了。我当时是什么？"}, {"type": "subtitle", "time": 15987.91, "timestamp": "04:26:27", "text": "怎么说？哦不，我忘了。我当时是什么？"}, {"type": "subtitle", "time": 15988.83, "timestamp": "04:26:28", "text": "说"}, {"type": "subtitle", "time": 16012.55, "timestamp": "04:26:52", "text": "哎呀，我好累啊。实际上，我的身体"}, {"type": "subtitle", "time": 16015.99, "timestamp": "04:26:55", "text": "说实话，我的身体还不习惯这样"}, {"type": "subtitle", "time": 16019.429, "timestamp": "04:26:59", "text": "像这样走路，或者走出去，或者像这样"}]
[{"type": "subtitle", "time": 8403.91, "timestamp": "02:20:03", "text": "是的，他们想以此为生。"}, {"type": "subtitle", "time": 8410.63, "timestamp": "02:20:10", "text": "他们必须锁定目标，但它还会回来的。"}, {"type": "subtitle", "time": 8413.349, "timestamp": "02:20:13", "text": "以后会让他们吃苦头的"}, {"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "职业。"}, {"type": "subtitle", "time": 8417.429, "timestamp": "02:20:17", "text": "呃"}, {"type": "subtitle", "time": 8420.309, "timestamp": "02:20:20", "text": "因为你得到了，我不会说你必须……"}, {"type": "subtitle", "time": 8422.389, "timestamp": "02:20:22", "text": "保持谦逊一点，但这样做也挺好的。"}, {"type": "subtitle", "time": 8424.79, "timestamp": "02:20:24", "text": "如果你想的话，就保持头脑清醒。"}, {"type": "subtitle", "time": 8427.07, "timestamp": "02:20:27", "text": "保持"}, {"type": "subtitle", "time": 8431.51, "timestamp": "02:20:31", "text": "良好的公共关系。民众"}, {"type": "subtitle", "time": 8432.95, "timestamp": "02:20:32", "text": "公众视角。如果你想要一个好的公众"}, {"type": "subtitle", "time": 8437.429, "timestamp": "02:20:37", "text": "从别人的角度来看，你得证明自己很优秀。"}, {"type": "subtitle", "time": 8439.11, "timestamp": "02:20:39", "text": "你值得一看。你"}, {"type": "subtitle", "time": 8440.23, "timestamp": "02:20:40", "text": "你明白我的意思吗？人们不想"}, {"type": "subtitle", "time": 8444.469, "timestamp": "02:20:44", "text": "像个超级疯狂的邪恶人类一样观看。"}, {"type": "subtitle", "time": 8445.51, "timestamp": "02:20:45", "text": "他们想看某个人"}, {"type": "subtitle", "time": 8446.87, "timestamp": "02:20:46", "text": "其实挺有共鸣的，你"}, {"type": "subtitle", "time": 8450.75, "timestamp": "02:20:50", "text": "知道？真的。"}, {"type": "subtitle", "time": 8452.79, "timestamp": "02:20:52", "text": "是的。我一直都在努力做到这一点。"}, {"type": "subtitle", "time": 8453.95, "timestamp": "02:20:53", "text": "最近。"}, {"type": "subtitle", "time": 8456.19, "timestamp": "02:20:56", "text": "我是"}, {"type": "subtitle", "time": 8458.71, "timestamp": "02:20:58", "text": "我的意思是，你知道，做个……感觉真好。"}]
[{"type": "subtitle", "time": 5590.47, "timestamp": "01:33:10", "text": "游戏。呃。哦，等等。呃，你是搞艺术的。"}, {"type": "subtitle", "time": 5593.27, "timestamp": "01:33:13", "text": "正确的？等等，你会画画吗？"}, {"type": "subtitle", "time": 5595.75, "timestamp": "01:33:15", "text": "我不。我唯一画的东西就是我的"}, {"type": "subtitle", "time": 5596.91, "timestamp": "01:33:16", "text": "火柴人。"}, {"type": "subtitle", "time": 5602.229, "timestamp": "01:33:22", "text": "他是个简笔画人物。火柴人。"}, {"type": "subtitle", "time": 5603.99, "timestamp": "01:33:23", "text": "是的。我不知道。我为此感到自豪"}, {"type": "subtitle", "time": 5606.39, "timestamp": "01:33:26", "text": "虽然从透视角度来看，我的火柴人像就是这样。"}, {"type": "subtitle", "time": 5608.07, "timestamp": "01:33:28", "text": "喜欢"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "我知道他的头真的很大，而且"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "身体非常小，眼睛却很大。"}, {"type": "subtitle", "time": 5617.51, "timestamp": "01:33:37", "text": "嗯。但我觉得我可以，我觉得我可以"}, {"type": "subtitle", "time": 5619.55, "timestamp": "01:33:39", "text": "越来越擅长"}, {"type": "subtitle", "time": 5621.83, "timestamp": "01:33:41", "text": "塑造的视角。你知道我"}, {"type": "subtitle", "time": 5624.79, "timestamp": "01:33:44", "text": "意思是？像一个圆圈。闪亮的"}, {"type": "subtitle", "time": 5626.31, "timestamp": "01:33:46", "text": "球。"}, {"type": "subtitle", "time": 5627.91, "timestamp": "01:33:47", "text": "闪亮的球。我觉得我可以画一个闪亮的东西"}, {"type": "subtitle", "time": 5629.75, "timestamp": "01:33:49", "text": "现在球。"}, {"type": "subtitle", "time": 5633.51, "timestamp": "01:33:53", "text": "嗯。我对此感到有点自豪。它"}, {"type": "subtitle", "time": 5635.11, "timestamp": "01:33:55", "text": "可能算不上什么巨大的成就"}, {"type": "subtitle", "time": 5637.83, "timestamp": "01:33:57", "text": "什么都行，反正我感觉很好。我感觉很好"}]
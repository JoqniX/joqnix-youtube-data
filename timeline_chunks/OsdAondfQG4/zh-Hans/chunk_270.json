[{"type": "subtitle", "time": 16202.149, "timestamp": "04:30:02", "text": "哦，真有趣。所以，我应该接受"}, {"type": "subtitle", "time": 16203.63, "timestamp": "04:30:03", "text": "这张照片"}, {"type": "subtitle", "time": 16221.11, "timestamp": "04:30:21", "text": "图片。我需要一个焦点，以便它能显示出来。"}, {"type": "subtitle", "time": 16223.11, "timestamp": "04:30:23", "text": "因为电子烟。我的天，那可真是个大问题"}, {"type": "subtitle", "time": 16232.11, "timestamp": "04:30:32", "text": "我不知道你是否能看到"}, {"type": "subtitle", "time": 16235.63, "timestamp": "04:30:35", "text": "好的，我拿了一个"}, {"type": "subtitle", "time": 16242.87, "timestamp": "04:30:42", "text": "等等，还有一个。好的。是的，"}, {"type": "subtitle", "time": 16245.189, "timestamp": "04:30:45", "text": "顺便说一下，我会把这些发布到推特上。"}, {"type": "subtitle", "time": 16246.269, "timestamp": "04:30:46", "text": "和"}, {"type": "subtitle", "time": 16248.87, "timestamp": "04:30:48", "text": "到处。所以，别担心。你们"}, {"type": "subtitle", "time": 16251.79, "timestamp": "04:30:51", "text": "你们的人将能够看到"}]
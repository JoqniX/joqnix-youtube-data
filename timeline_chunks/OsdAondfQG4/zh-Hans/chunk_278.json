[{"type": "subtitle", "time": 16680.39, "timestamp": "04:38:00", "text": "那。你的声音非常清晰，"}, {"type": "subtitle", "time": 16682.109, "timestamp": "04:38:02", "text": "方式。"}, {"type": "subtitle", "time": 16686.07, "timestamp": "04:38:06", "text": "嗨，等等。所以，它和……相比是不好吗？"}, {"type": "subtitle", "time": 16688.949, "timestamp": "04:38:08", "text": "与推特相比，它是好是坏？"}, {"type": "subtitle", "time": 16690.75, "timestamp": "04:38:10", "text": "空格？"}, {"type": "subtitle", "time": 16693.59, "timestamp": "04:38:13", "text": "娜娜，推特空间怎么样？是这样的吗？"}, {"type": "subtitle", "time": 16695.551, "timestamp": "04:38:15", "text": "甚至"}, {"type": "subtitle", "time": 16699.269, "timestamp": "04:38:19", "text": "更糟？我想问的是"}, {"type": "subtitle", "time": 16700.949, "timestamp": "04:38:20", "text": "呃，就像直播开始时那样"}, {"type": "subtitle", "time": 16703.75, "timestamp": "04:38:23", "text": "感觉更像是我希望 Hash 或 Ninja 或"}, {"type": "subtitle", "time": 16706.629, "timestamp": "04:38:26", "text": "布拉德当时在场，谁在场，或者甚至"}, {"type": "subtitle", "time": 16709.15, "timestamp": "04:38:29", "text": "当时也在场的培根在推特上"}, {"type": "subtitle", "time": 16711.99, "timestamp": "04:38:31", "text": "留白，这样我就可以进行比较和了解"}, {"type": "subtitle", "time": 16716.31, "timestamp": "04:38:36", "text": "Twitter 空间音频到底有多糟糕？"}, {"type": "subtitle", "time": 16718.629, "timestamp": "04:38:38", "text": "与 YouTube 直播相比。它是"}, {"type": "subtitle", "time": 16721.429, "timestamp": "04:38:41", "text": "比太空波更清晰。什么？然后我"}, {"type": "subtitle", "time": 16724.51, "timestamp": "04:38:44", "text": "那我想我会做……呃，该怎么称呼呢？"}, {"type": "subtitle", "time": 16727.029, "timestamp": "04:38:47", "text": "它？那我想我会像YouTube那样做。"}, {"type": "subtitle", "time": 16735.99, "timestamp": "04:38:55", "text": "所以从某种意义上说，看到这一点是件好事。"}, {"type": "subtitle", "time": 16739.189, "timestamp": "04:38:59", "text": "变得更加自信。我并没有隐瞒我的"}]
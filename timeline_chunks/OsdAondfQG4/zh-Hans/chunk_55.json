[{"type": "subtitle", "time": 3301.75, "timestamp": "00:55:01", "text": "关掉一些。等等，罗，这是什么意思？"}, {"type": "subtitle", "time": 3303.349, "timestamp": "00:55:03", "text": "意思是？翻译。等等，我要……"}, {"type": "subtitle", "time": 3305.75, "timestamp": "00:55:05", "text": "翻译它。"}, {"type": "subtitle", "time": 3307.75, "timestamp": "00:55:07", "text": "我很害怕。"}, {"type": "subtitle", "time": 3311.63, "timestamp": "00:55:11", "text": "允许暂停交互。尝试"}, {"type": "subtitle", "time": 3313.75, "timestamp": "00:55:13", "text": "[音乐]"}, {"type": "subtitle", "time": 3316.309, "timestamp": "00:55:16", "text": "按下 Esc 键。我正在重点介绍的那个"}, {"type": "subtitle", "time": 3319.349, "timestamp": "00:55:19", "text": "正在直播。要说的是哪个联盟"}, {"type": "subtitle", "time": 3327.51, "timestamp": "00:55:27", "text": "乐队，然后"}, {"type": "subtitle", "time": 3331.589, "timestamp": "00:55:31", "text": "我的天哪，你知道他是中国人吗？"}, {"type": "subtitle", "time": 3343.829, "timestamp": "00:55:43", "text": "儿子或者别的什么，我不知道。"}, {"type": "subtitle", "time": 3353.109, "timestamp": "00:55:53", "text": "[音乐]"}, {"type": "subtitle", "time": 3356.789, "timestamp": "00:55:56", "text": "你好。小心。好的。好的。"}, {"type": "subtitle", "time": 3359.589, "timestamp": "00:55:59", "text": "我的天啊。他来自中国。我的天啊。"}]
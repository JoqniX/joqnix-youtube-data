[{"type": "subtitle", "time": 12300.03, "timestamp": "03:25:00", "text": "一切。离开，"}, {"type": "subtitle", "time": 12302.71, "timestamp": "03:25:02", "text": "正确的？我必须想办法去做"}, {"type": "subtitle", "time": 12307.03, "timestamp": "03:25:07", "text": "眼睛的东西。快快快快，在中间"}, {"type": "subtitle", "time": 12311.11, "timestamp": "03:25:11", "text": "在外面做事情，穿梭其中，然后进来"}, {"type": "subtitle", "time": 12312.87, "timestamp": "03:25:12", "text": "回去完成坍塌操作。"}, {"type": "subtitle", "time": 12315.469, "timestamp": "03:25:15", "text": "关闭和"}, {"type": "subtitle", "time": 12322.87, "timestamp": "03:25:22", "text": "事物。睡眠不足简直太可怕了。"}, {"type": "chat", "time": 12324.37, "timestamp": "03:25:24", "author": "@PanditJi.Y", "avatar": "https://yt4.ggpht.com/dbuBEqO3mJ9DX4Uu_LhA4jdzC_POgn5GfeMyztO06j5c73okFxwnXUaKWurMIj0mYXB_y53S_Q=s64-c-k-c0x00ffffff-no-rj", "message": "when are u leaving for japan?"}, {"type": "subtitle", "time": 12324.83, "timestamp": "03:25:24", "text": "Dio，我的身体是"}, {"type": "subtitle", "time": 12326.91, "timestamp": "03:25:26", "text": "腐烂，"}, {"type": "subtitle", "time": 12329.87, "timestamp": "03:25:29", "text": "诚实地。但我必须这样做"}, {"type": "subtitle", "time": 12333.03, "timestamp": "03:25:33", "text": "它。再看看我。仍然很受欢迎"}, {"type": "subtitle", "time": 12334.91, "timestamp": "03:25:34", "text": "更多的"}, {"type": "subtitle", "time": 12338.79, "timestamp": "03:25:38", "text": "人们。 30日我会在最后一刻离开。"}, {"type": "subtitle", "time": 12343.19, "timestamp": "03:25:43", "text": "星期。上星期。是的。我想应该是29、30、31。"}, {"type": "subtitle", "time": 12344.71, "timestamp": "03:25:44", "text": "我不知道航班是什么时候。患病的"}, {"type": "subtitle", "time": 12352.91, "timestamp": "03:25:52", "text": "所以"}, {"type": "subtitle", "time": 12355.91, "timestamp": "03:25:55", "text": "是的，问题是我想要合作，而不是"}, {"type": "subtitle", "time": 12357.91, "timestamp": "03:25:57", "text": "合作。我想和每个人都谈谈。"}, {"type": "subtitle", "time": 12359.83, "timestamp": "03:25:59", "text": "今天见面了。这就是为什么我也是"}]
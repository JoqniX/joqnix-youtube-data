[{"type": "subtitle", "time": 6480.55, "timestamp": "01:48:00", "text": "哦，就像一个新的活动横幅，嗯嗯"}, {"type": "subtitle", "time": 6483.91, "timestamp": "01:48:03", "text": "就像事情发生过一样，对吧？哦，是的。"}, {"type": "subtitle", "time": 6488.229, "timestamp": "01:48:08", "text": "就是那个新的武器旗帜。"}, {"type": "subtitle", "time": 6490.39, "timestamp": "01:48:10", "text": "呃，是那个武器横幅吗？呃，就像"}, {"type": "subtitle", "time": 6492.669, "timestamp": "01:48:12", "text": "我昨天登录的时候有没有登录？"}, {"type": "subtitle", "time": 6494.51, "timestamp": "01:48:14", "text": "昨天就像这样"}, {"type": "subtitle", "time": 6498.709, "timestamp": "01:48:18", "text": "那天我看到好像有个……嗯，那是什么？"}, {"type": "subtitle", "time": 6502.07, "timestamp": "01:48:22", "text": "你可以称之为活动之类的。"}, {"type": "subtitle", "time": 6505.31, "timestamp": "01:48:25", "text": "那里有横幅之类的东西，"}, {"type": "subtitle", "time": 6509.31, "timestamp": "01:48:29", "text": "所有好玩的事情。是的。的"}, {"type": "subtitle", "time": 6512.149, "timestamp": "01:48:32", "text": "呃，这武器看起来真酷。我不是"}, {"type": "subtitle", "time": 6515.59, "timestamp": "01:48:35", "text": "我要撒谎。我差点……差点就拉倒了。"}, {"type": "subtitle", "time": 6517.59, "timestamp": "01:48:37", "text": "掏出钱包。我不会撒谎。哦"}, {"type": "subtitle", "time": 6520.47, "timestamp": "01:48:40", "text": "我的上帝。你在这类产品上花了多少钱？"}, {"type": "subtitle", "time": 6530.39, "timestamp": "01:48:50", "text": "粗略估计我知道它超过……"}, {"type": "subtitle", "time": 6537.51, "timestamp": "01:48:57", "text": "圣。是的。我的意思是，你能责怪谁呢？"}]
[{"type": "subtitle", "time": 1988.789, "timestamp": "00:33:08", "text": "然后。他为什么对他们要求太多？所以"}, {"type": "subtitle", "time": 1991.23, "timestamp": "00:33:11", "text": "过段时间再问他们吧。我不"}, {"type": "subtitle", "time": 1994.19, "timestamp": "00:33:14", "text": "知道。他受到了激烈的辩论。"}, {"type": "subtitle", "time": 1996.389, "timestamp": "00:33:16", "text": "是的，持久耐用更好。"}, {"type": "subtitle", "time": 1998.789, "timestamp": "00:33:18", "text": "比那更令人印象深刻。哦，你可以打电话"}, {"type": "subtitle", "time": 2007.509, "timestamp": "00:33:27", "text": "是的。呃，jockn。就是这样"}, {"type": "subtitle", "time": 2010.389, "timestamp": "00:33:30", "text": "读出来。但如果很难，你"}, {"type": "subtitle", "time": 2013.35, "timestamp": "00:33:33", "text": "你可以叫我运动员。"}, {"type": "subtitle", "time": 2016.07, "timestamp": "00:33:36", "text": "运动健将或运动健将。乔乔。"}, {"type": "subtitle", "time": 2018.83, "timestamp": "00:33:38", "text": "是的，你可以叫我骑师。是的。"}, {"type": "subtitle", "time": 2022.23, "timestamp": "00:33:42", "text": "是的。几乎所有人都叫我"}, {"type": "subtitle", "time": 2039.35, "timestamp": "00:33:59", "text": "我不想把事情搞砸。我是"}]
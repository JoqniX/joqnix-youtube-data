[{"type": "subtitle", "time": 3721.349, "timestamp": "01:02:01", "text": "不是我的朋友，你的头像很棒"}, {"type": "subtitle", "time": 3724.95, "timestamp": "01:02:04", "text": "善待他人。你知道的。不，我确实这么做了。"}, {"type": "subtitle", "time": 3728.23, "timestamp": "01:02:08", "text": "我不知道。"}, {"type": "subtitle", "time": 3732.87, "timestamp": "01:02:12", "text": "我以为所有人都能看到头像。"}, {"type": "subtitle", "time": 3737.91, "timestamp": "01:02:17", "text": "抱歉，我没能做到。好的。好的。"}, {"type": "subtitle", "time": 3740.95, "timestamp": "01:02:20", "text": "好吧，没事了。我看不到你"}, {"type": "subtitle", "time": 3756.63, "timestamp": "01:02:36", "text": "摇钱树。等待，"}, {"type": "subtitle", "time": 3759.91, "timestamp": "01:02:39", "text": "我该说什么？总是"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "我的思绪如同沙卡。"}, {"type": "subtitle", "time": 3767.27, "timestamp": "01:02:47", "text": "哦，是的。是的，就像……嗯，就是这样。"}, {"type": "subtitle", "time": 3772.789, "timestamp": "01:02:52", "text": "[音乐]"}, {"type": "subtitle", "time": 3774.789, "timestamp": "01:02:54", "text": "你的语言是？"}, {"type": "subtitle", "time": 3777.589, "timestamp": "01:02:57", "text": "不，不，它是英语。但是，我们该怎么办？"}]
[{"type": "subtitle", "time": 8108.75, "timestamp": "02:15:08", "text": "听起来有点刻薄，不是吗？"}, {"type": "subtitle", "time": 8112.21, "timestamp": "02:15:12", "text": "一心一意的"}, {"type": "subtitle", "time": 8115.27, "timestamp": "02:15:15", "text": "[音乐]"}, {"type": "subtitle", "time": 8118.47, "timestamp": "02:15:18", "text": "措辞很难"}, {"type": "subtitle", "time": 8120.43, "timestamp": "02:15:20", "text": "算了，没事了。我打算把它忘掉。"}, {"type": "subtitle", "time": 8123.83, "timestamp": "02:15:23", "text": "因为我不想，我不想。"}, {"type": "subtitle", "time": 8126.47, "timestamp": "02:15:26", "text": "伤到我的大脑。"}, {"type": "subtitle", "time": 8132.149, "timestamp": "02:15:32", "text": "是的。"}, {"type": "subtitle", "time": 8134.79, "timestamp": "02:15:34", "text": "太酷了。"}, {"type": "subtitle", "time": 8138.47, "timestamp": "02:15:38", "text": "我们已经聊了两个小时了。"}, {"type": "subtitle", "time": 8147.03, "timestamp": "02:15:47", "text": "哦，我们一开始就好像我什么都不记得了。曾是"}, {"type": "subtitle", "time": 8149.51, "timestamp": "02:15:49", "text": "大概是我这边时间12点半吧？所以，是1"}, {"type": "subtitle", "time": 8153.589, "timestamp": "02:15:53", "text": "小时。只需1小时。是的。该死。"}, {"type": "subtitle", "time": 8155.83, "timestamp": "02:15:55", "text": "没关系。我当时都快疯了。我当时"}]
[{"type": "subtitle", "time": 1810.909, "timestamp": "00:30:10", "text": "那是他的朋友吗？哦"}, {"type": "subtitle", "time": 1831.95, "timestamp": "00:30:31", "text": "[音乐]"}, {"type": "subtitle", "time": 1835.029, "timestamp": "00:30:35", "text": "泰国。泰国。泰国。泰国。"}, {"type": "subtitle", "time": 1841.31, "timestamp": "00:30:41", "text": "明白了。我 我已经"}, {"type": "subtitle", "time": 1844.23, "timestamp": "00:30:44", "text": "我在这里已经很久了。所以，"}, {"type": "subtitle", "time": 1847.11, "timestamp": "00:30:47", "text": "哦，是的。这里是泰国。忘记如何"}, {"type": "subtitle", "time": 1850.23, "timestamp": "00:30:50", "text": "跟我朋友说，和外国人聊天。我的"}, {"type": "subtitle", "time": 1853.19, "timestamp": "00:30:53", "text": "朋友。哦，原来是你的朋友。是的。"}, {"type": "subtitle", "time": 1856.95, "timestamp": "00:30:56", "text": "你好。这里不是印度。我绝对是"}]
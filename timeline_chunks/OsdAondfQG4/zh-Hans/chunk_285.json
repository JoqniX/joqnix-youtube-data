[{"type": "subtitle", "time": 17101.27, "timestamp": "04:45:01", "text": "右侧好像有个可见的东西"}, {"type": "subtitle", "time": 17102.51, "timestamp": "04:45:02", "text": "渔夫"}, {"type": "subtitle", "time": 17118.708, "timestamp": "04:45:18", "text": "上帝。在我完成数据之前，我应该"}, {"type": "subtitle", "time": 17120.868, "timestamp": "04:45:20", "text": "回家吧。我需要上网时的数据"}, {"type": "subtitle", "time": 17125.67, "timestamp": "04:45:25", "text": "火车。大概要开4个小时的车。"}, {"type": "subtitle", "time": 17137.11, "timestamp": "04:45:37", "text": "我的天啊，这些石头真的太大了。我"}, {"type": "subtitle", "time": 17139.75, "timestamp": "04:45:39", "text": "可能会坠落身亡。想象一下死亡"}, {"type": "subtitle", "time": 17141.788, "timestamp": "04:45:41", "text": "穿过这些岩石。哦，"}, {"type": "subtitle", "time": 17149.47, "timestamp": "04:45:49", "text": "坏的。哦"}, {"type": "subtitle", "time": 17152.708, "timestamp": "04:45:52", "text": "上帝。我从哪里来？我没有"}, {"type": "subtitle", "time": 17154.708, "timestamp": "04:45:54", "text": "知道。"}, {"type": "subtitle", "time": 17156.59, "timestamp": "04:45:56", "text": "圣哉上帝，"}, {"type": "subtitle", "time": 17159.67, "timestamp": "04:45:59", "text": "我。哦，那看起来真酷。"}]
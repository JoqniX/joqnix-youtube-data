[{"type": "subtitle", "time": 15360.95, "timestamp": "04:16:00", "text": "比如一次性袋子之类的"}, {"type": "subtitle", "time": 15363.11, "timestamp": "04:16:03", "text": "把它带回家。"}, {"type": "subtitle", "time": 15366.71, "timestamp": "04:16:06", "text": "我把它放进了我的行李里。呃"}, {"type": "subtitle", "time": 15367.55, "timestamp": "04:16:07", "text": "再次，"}, {"type": "subtitle", "time": 15370.75, "timestamp": "04:16:10", "text": "洗衣服，然后回家，到家时"}, {"type": "subtitle", "time": 15373.75, "timestamp": "04:16:13", "text": "晚上把它们放一段时间，就像……"}, {"type": "subtitle", "time": 15376.07, "timestamp": "04:16:16", "text": "洗衣机之类的东西。我这就去"}, {"type": "subtitle", "time": 15390.55, "timestamp": "04:16:30", "text": "哎，这太不公平了，对吧？我会"}, {"type": "subtitle", "time": 15394.07, "timestamp": "04:16:34", "text": "来海滩只是为了什么？步行前往"}, {"type": "subtitle", "time": 15396.309, "timestamp": "04:16:36", "text": "海边，看到贝壳，然后拿走"}, {"type": "subtitle", "time": 15410.309, "timestamp": "04:16:50", "text": "呃，那大概是12岁，真的。"}, {"type": "subtitle", "time": 15411.87, "timestamp": "04:16:51", "text": "午夜之爱"}, {"type": "subtitle", "time": 15415.59, "timestamp": "04:16:55", "text": "的。当时大概是午夜时分。但"}, {"type": "subtitle", "time": 15416.59, "timestamp": "04:16:56", "text": "那是"}, {"type": "subtitle", "time": 15419.75, "timestamp": "04:16:59", "text": "凉爽的。那还挺酷的。我"}]
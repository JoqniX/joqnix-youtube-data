[{"type": "subtitle", "time": 3780.47, "timestamp": "01:03:00", "text": "你管它叫什么？"}, {"type": "subtitle", "time": 3783.67, "timestamp": "01:03:03", "text": "就像……呃，这是英语。是的，的确如此。"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "就好像，呃，你说没关系。我"}, {"type": "subtitle", "time": 3790.109, "timestamp": "01:03:10", "text": "改变"}, {"type": "subtitle", "time": 3795.829, "timestamp": "01:03:15", "text": "呃，就像喜欢其他东西也可以一样。"}, {"type": "subtitle", "time": 3799.589, "timestamp": "01:03:19", "text": "呃，它就像……该怎么称呼它呢？"}, {"type": "subtitle", "time": 3803.67, "timestamp": "01:03:23", "text": "比如，你知道动漫"}, {"type": "subtitle", "time": 3806.549, "timestamp": "01:03:26", "text": "对动漫感兴趣的人"}, {"type": "subtitle", "time": 3809.19, "timestamp": "01:03:29", "text": "用一种奇怪的方式说话，不像是那种奇怪的方式"}, {"type": "subtitle", "time": 3812.15, "timestamp": "01:03:32", "text": "不同类型的英语权利"}, {"type": "subtitle", "time": 3815.19, "timestamp": "01:03:35", "text": "就是这样。我不知道。"}, {"type": "subtitle", "time": 3817.309, "timestamp": "01:03:37", "text": "这就像你叫什么来着"}, {"type": "subtitle", "time": 3821.029, "timestamp": "01:03:41", "text": "它？我最先听到的。"}, {"type": "subtitle", "time": 3829.829, "timestamp": "01:03:49", "text": "我现在有工作，英语说得很好。"}, {"type": "subtitle", "time": 3831.21, "timestamp": "01:03:51", "text": "长的"}, {"type": "subtitle", "time": 3832.43, "timestamp": "01:03:52", "text": "[音乐]"}]
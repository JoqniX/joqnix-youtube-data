[{"type": "subtitle", "time": 3063.109, "timestamp": "00:51:03", "text": "是的。等等，你看了最新一期吗？"}, {"type": "subtitle", "time": 3066.15, "timestamp": "00:51:06", "text": "剧集之类的？我还没有完全"}, {"type": "subtitle", "time": 3068.95, "timestamp": "00:51:08", "text": "已更新至第二季。"}, {"type": "subtitle", "time": 3081.43, "timestamp": "00:51:21", "text": "最新进展。"}, {"type": "subtitle", "time": 3085.67, "timestamp": "00:51:25", "text": "是的。你好。你们好吗？"}, {"type": "subtitle", "time": 3087.75, "timestamp": "00:51:27", "text": "你好。你好。"}, {"type": "subtitle", "time": 3094.15, "timestamp": "00:51:34", "text": "我的皮肤好像在说：“哦，等等。什么？”"}, {"type": "subtitle", "time": 3097.67, "timestamp": "00:51:37", "text": "那是什么语言？韩语。"}, {"type": "subtitle", "time": 3112.87, "timestamp": "00:51:52", "text": "实际上。哦，对不起。和我说话"}, {"type": "subtitle", "time": 3118.349, "timestamp": "00:51:58", "text": "哦，那是"}]
[{"type": "subtitle", "time": 10223.23, "timestamp": "02:50:23", "text": "呃，好的。我私信了一个"}, {"type": "subtitle", "time": 10224.59, "timestamp": "02:50:24", "text": "人。"}, {"type": "subtitle", "time": 10237.269, "timestamp": "02:50:37", "text": "嗯，我本身也是这样的人。"}, {"type": "subtitle", "time": 10240.83, "timestamp": "02:50:40", "text": "兄弟，我加了好多人到我的……"}, {"type": "subtitle", "time": 10244.55, "timestamp": "02:50:44", "text": "列表。这简直太疯狂了。所以，所以"}, {"type": "subtitle", "time": 10247.03, "timestamp": "02:50:47", "text": "目前为止，有人统计过有多少个吗？"}, {"type": "subtitle", "time": 10249.75, "timestamp": "02:50:49", "text": "我目前为止合作过的人有哪些？让"}, {"type": "subtitle", "time": 10255.389, "timestamp": "02:50:55", "text": "其实是我自己数的。 1 2 3 4 5"}]
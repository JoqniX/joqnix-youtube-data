[{"type": "subtitle", "time": 15722.07, "timestamp": "04:22:02", "text": "家。家有点远。我必须"}, {"type": "subtitle", "time": 15723.79, "timestamp": "04:22:03", "text": "步行穿过"}, {"type": "subtitle", "time": 15734.11, "timestamp": "04:22:14", "text": "等等，那里有个椰子正在……"}, {"type": "subtitle", "time": 15737.75, "timestamp": "04:22:17", "text": "溺水身亡。我觉得这简直就是……"}, {"type": "subtitle", "time": 15742.59, "timestamp": "04:22:22", "text": "椰子来自大海。等待，"}, {"type": "subtitle", "time": 15745.269, "timestamp": "04:22:25", "text": "什么？椰子来自大海。"}, {"type": "subtitle", "time": 15747.429, "timestamp": "04:22:27", "text": "顺便说一句，这是干椰子。它是"}, {"type": "subtitle", "time": 15749.75, "timestamp": "04:22:29", "text": "有点湿。"}, {"type": "subtitle", "time": 15753.03, "timestamp": "04:22:33", "text": "你知道，我觉得我好像看到了一个"}, {"type": "subtitle", "time": 15754.51, "timestamp": "04:22:34", "text": "故事或"}, {"type": "subtitle", "time": 15758.309, "timestamp": "04:22:38", "text": "某种东西，或者类似某种呃……东西"}, {"type": "subtitle", "time": 15761.59, "timestamp": "04:22:41", "text": "椰子如何像某些人一样旅行"}, {"type": "subtitle", "time": 15763.55, "timestamp": "04:22:43", "text": "世界各地或"}, {"type": "subtitle", "time": 15766.469, "timestamp": "04:22:46", "text": "某种东西在海里流动，"}, {"type": "subtitle", "time": 15767.79, "timestamp": "04:22:47", "text": "就像所有这些"}, {"type": "subtitle", "time": 15771.03, "timestamp": "04:22:51", "text": "东西。我觉得这太酷了。那是"}, {"type": "subtitle", "time": 15778.389, "timestamp": "04:22:58", "text": "比如去海岛游玩之类的，但是"}]
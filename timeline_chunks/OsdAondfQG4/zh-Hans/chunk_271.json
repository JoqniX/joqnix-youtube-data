[{"type": "subtitle", "time": 16261.99, "timestamp": "04:31:01", "text": "哦，等等。就像……等等，有人……"}, {"type": "subtitle", "time": 16264.229, "timestamp": "04:31:04", "text": "实际上是在拉绳子之类的。"}, {"type": "subtitle", "time": 16266.309, "timestamp": "04:31:06", "text": "哦，等等。所以，它就像一张渔网。"}, {"type": "subtitle", "time": 16281.429, "timestamp": "04:31:21", "text": "网。是的，那是一张渔网。等等，我"}, {"type": "subtitle", "time": 16302.389, "timestamp": "04:31:42", "text": "网。别理我。就像人们一样"}, {"type": "subtitle", "time": 16309.63, "timestamp": "04:31:49", "text": "请讲。呃，我正走在厚重的沙子上。"}, {"type": "subtitle", "time": 16313.189, "timestamp": "04:31:53", "text": "再次。我不知道路。"}, {"type": "subtitle", "time": 16314.67, "timestamp": "04:31:54", "text": "回家"}, {"type": "subtitle", "time": 16317.67, "timestamp": "04:31:57", "text": "再次。再次声明，我真的只是个客人。"}, {"type": "subtitle", "time": 16319.87, "timestamp": "04:31:59", "text": "这边。我不住在这里"}]
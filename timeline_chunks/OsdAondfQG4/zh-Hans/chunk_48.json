[{"type": "subtitle", "time": 2880.55, "timestamp": "00:48:00", "text": "天气更冷了，或者"}, {"type": "subtitle", "time": 2883.03, "timestamp": "00:48:03", "text": "是的，确实如此。"}, {"type": "subtitle", "time": 2884.03, "timestamp": "00:48:04", "text": "但"}, {"type": "subtitle", "time": 2886.63, "timestamp": "00:48:06", "text": "这是你通常如何度过你的时间"}, {"type": "subtitle", "time": 2890.23, "timestamp": "00:48:10", "text": "周末？橡胶罐。所以橡胶是指"}, {"type": "subtitle", "time": 2891.79, "timestamp": "00:48:11", "text": "你知道那件事"}, {"type": "subtitle", "time": 2897.95, "timestamp": "00:48:17", "text": "[音乐]"}, {"type": "subtitle", "time": 2901.67, "timestamp": "00:48:21", "text": "我不小心勾引她的那些时代。哦"}, {"type": "subtitle", "time": 2908.23, "timestamp": "00:48:28", "text": "等等，你读书喜欢漫画吗？"}, {"type": "subtitle", "time": 2910.87, "timestamp": "00:48:30", "text": "或者像webun之类的？"}, {"type": "subtitle", "time": 2913.75, "timestamp": "00:48:33", "text": "你喜欢那样吗？"}, {"type": "subtitle", "time": 2930.589, "timestamp": "00:48:50", "text": "新版电锯人登顶"}, {"type": "subtitle", "time": 2935.43, "timestamp": "00:48:55", "text": "这座山……呃，用英语怎么说？我"}, {"type": "subtitle", "time": 2938.549, "timestamp": "00:48:58", "text": "不知道。"}]
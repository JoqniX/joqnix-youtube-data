[{"type": "subtitle", "time": 14821.59, "timestamp": "04:07:01", "text": "长途步行。我本应该去拿一个"}, {"type": "subtitle", "time": 14824.03, "timestamp": "04:07:04", "text": "短途步行"}, {"type": "subtitle", "time": 14827.99, "timestamp": "04:07:07", "text": "但我走了很长一段路。我的天啊。"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "没关系。我今天的目标不是"}, {"type": "subtitle", "time": 14833.83, "timestamp": "04:07:13", "text": "到达海滩表演的终点"}, {"type": "subtitle", "time": 14836.71, "timestamp": "04:07:16", "text": "触摸它，但只是触摸蓝色的身体。"}, {"type": "subtitle", "time": 14839.59, "timestamp": "04:07:19", "text": "就在我面前。但我只需要"}, {"type": "subtitle", "time": 14841.59, "timestamp": "04:07:21", "text": "如果需要的话，我会稍微走一段路。"}, {"type": "subtitle", "time": 14845.11, "timestamp": "04:07:25", "text": "触摸这片沙滩的尽头。呃，这个"}, {"type": "subtitle", "time": 14846.269, "timestamp": "04:07:26", "text": "曲线"}, {"type": "subtitle", "time": 14849.75, "timestamp": "04:07:29", "text": "那东西看起来像个岛屿，就像……"}, {"type": "subtitle", "time": 14851.91, "timestamp": "04:07:31", "text": "在我面前。但我应该拍张照片"}, {"type": "subtitle", "time": 14853.229, "timestamp": "04:07:33", "text": "的"}, {"type": "subtitle", "time": 14856.429, "timestamp": "04:07:36", "text": "它。看起来就像一个"}, {"type": "subtitle", "time": 14858.429, "timestamp": "04:07:38", "text": "岛。"}, {"type": "subtitle", "time": 14860.429, "timestamp": "04:07:40", "text": "哇。"}, {"type": "subtitle", "time": 14863.349, "timestamp": "04:07:43", "text": "绍阿。等等，我应该做2倍的吗？"}, {"type": "subtitle", "time": 14864.67, "timestamp": "04:07:44", "text": "飞涨"}, {"type": "subtitle", "time": 14868.67, "timestamp": "04:07:48", "text": "东西。我的天，狗狗正在走路"}, {"type": "subtitle", "time": 14871.99, "timestamp": "04:07:51", "text": "我。我安全吗？"}, {"type": "subtitle", "time": 14873.71, "timestamp": "04:07:53", "text": "嘿"}, {"type": "subtitle", "time": 14878.15, "timestamp": "04:07:58", "text": "哟。糟糕，那条狗跟着我。"}]
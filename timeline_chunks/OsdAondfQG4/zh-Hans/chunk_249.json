[{"type": "subtitle", "time": 14942.389, "timestamp": "04:09:02", "text": "当我在火车上时，我不会……"}, {"type": "subtitle", "time": 14945.75, "timestamp": "04:09:05", "text": "我将无法使用 Wait 功能。是的，我"}, {"type": "subtitle", "time": 14948.309, "timestamp": "04:09:08", "text": "不知道火车上有没有Wi-Fi。那"}, {"type": "subtitle", "time": 14950.95, "timestamp": "04:09:10", "text": "我当时乘坐的是一列智能列车。我不"}, {"type": "subtitle", "time": 14954.79, "timestamp": "04:09:14", "text": "知道。但是啊哈娜，你知道吗？患病的"}, {"type": "subtitle", "time": 14958.55, "timestamp": "04:09:18", "text": "这1GB的来源。我买了2GB的"}, {"type": "subtitle", "time": 14960.269, "timestamp": "04:09:20", "text": "是附加组件之类的东西，对吧？所以那将是"}, {"type": "subtitle", "time": 14961.87, "timestamp": "04:09:21", "text": "美好的。全部"}, {"type": "subtitle", "time": 14964.99, "timestamp": "04:09:24", "text": "正确的。说实话，"}, {"type": "subtitle", "time": 14968.63, "timestamp": "04:09:28", "text": "3500 比特率相当耗电。"}, {"type": "subtitle", "time": 14969.309, "timestamp": "04:09:29", "text": "的"}, {"type": "subtitle", "time": 14972.51, "timestamp": "04:09:32", "text": "移动的。这有点奇怪"}, {"type": "subtitle", "time": 14976.59, "timestamp": "04:09:36", "text": "可疑的。当我设想自己直播时"}, {"type": "subtitle", "time": 14980.03, "timestamp": "04:09:40", "text": "两万次背叛，让我感觉，哦"}, {"type": "subtitle", "time": 14982.87, "timestamp": "04:09:42", "text": "不。但你们已经知道我的"}, {"type": "subtitle", "time": 14985.51, "timestamp": "04:09:45", "text": "使用互联网，对吧？好的。让我"}, {"type": "subtitle", "time": 14987.349, "timestamp": "04:09:47", "text": "碰到蓝球我们就返回。"}, {"type": "subtitle", "time": 14989.309, "timestamp": "04:09:49", "text": "好的。"}, {"type": "subtitle", "time": 14992.79, "timestamp": "04:09:52", "text": "正确的。这里有人。你好。我们"}]
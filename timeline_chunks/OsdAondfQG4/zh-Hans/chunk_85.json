[{"type": "subtitle", "time": 5101.03, "timestamp": "01:25:01", "text": "活动，对吧？"}, {"type": "subtitle", "time": 5103.27, "timestamp": "01:25:03", "text": "什么？掷骰子事件。滚动"}, {"type": "subtitle", "time": 5106.07, "timestamp": "01:25:06", "text": "滑翔机用的骰子。哦，骰子"}, {"type": "subtitle", "time": 5111.03, "timestamp": "01:25:11", "text": "为这个东西举办的活动。是的。是的。"}, {"type": "subtitle", "time": 5113.03, "timestamp": "01:25:13", "text": "周年纪念日。"}, {"type": "subtitle", "time": 5115.99, "timestamp": "01:25:15", "text": "我也没看完。我不是"}, {"type": "subtitle", "time": 5117.189, "timestamp": "01:25:17", "text": "我要撒谎。"}, {"type": "subtitle", "time": 5118.79, "timestamp": "01:25:18", "text": "是的。"}, {"type": "subtitle", "time": 5120.95, "timestamp": "01:25:20", "text": "哦，不。如果我……我不认为我有"}, {"type": "subtitle", "time": 5123.189, "timestamp": "01:25:23", "text": "有足够的时间赶上进度。是的，你需要"}, {"type": "subtitle", "time": 5126.229, "timestamp": "01:25:26", "text": "要做这么多事。而且卷数还真不少"}, {"type": "subtitle", "time": 5128.629, "timestamp": "01:25:28", "text": "你也得按顺序来。 12"}, {"type": "subtitle", "time": 5130.629, "timestamp": "01:25:30", "text": "回合。"}, {"type": "subtitle", "time": 5137.43, "timestamp": "01:25:37", "text": "是的。"}, {"type": "subtitle", "time": 5139.43, "timestamp": "01:25:39", "text": "但是，如果你这样做，回报将非常丰厚。"}, {"type": "subtitle", "time": 5142.31, "timestamp": "01:25:42", "text": "完成每一轮。是的。真是太"}, {"type": "subtitle", "time": 5146.55, "timestamp": "01:25:46", "text": "男人。"}, {"type": "subtitle", "time": 5147.91, "timestamp": "01:25:47", "text": "我不知道自己是否还想继续奋斗。"}, {"type": "subtitle", "time": 5150.07, "timestamp": "01:25:50", "text": "不过确实如此。我必须保留"}, {"type": "subtitle", "time": 5153.03, "timestamp": "01:25:53", "text": "每天往返。"}, {"type": "subtitle", "time": 5154.39, "timestamp": "01:25:54", "text": "我想这就是我一直没能进入这个行业的原因吧"}]
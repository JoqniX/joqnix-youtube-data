[{"type": "subtitle", "time": 8461.59, "timestamp": "02:21:01", "text": "他人很好，但我还是想多尝试几次。"}, {"type": "subtitle", "time": 8464.79, "timestamp": "02:21:04", "text": "做一个绅士很难，做一个……"}, {"type": "subtitle", "time": 8467.19, "timestamp": "02:21:07", "text": "人很好。"}, {"type": "subtitle", "time": 8473.389, "timestamp": "02:21:13", "text": "我曾有过这个"}, {"type": "subtitle", "time": 8476.95, "timestamp": "02:21:16", "text": "呃，和日本虚拟主播的互动经历有点奇怪。"}, {"type": "subtitle", "time": 8478.87, "timestamp": "02:21:18", "text": "我一直都在关注他"}, {"type": "subtitle", "time": 8482.389, "timestamp": "02:21:22", "text": "在开始做 YouTube 之前，我有一段时间了。"}, {"type": "subtitle", "time": 8485.11, "timestamp": "02:21:25", "text": "我知道他们是认真的，等等。"}, {"type": "subtitle", "time": 8488.71, "timestamp": "02:21:28", "text": "作为专家，我也会得到同样的答案。"}, {"type": "subtitle", "time": 8490.03, "timestamp": "02:21:30", "text": "东西"}, {"type": "subtitle", "time": 8492.03, "timestamp": "02:21:32", "text": "就像这样"}, {"type": "subtitle", "time": 8496.79, "timestamp": "02:21:36", "text": "就像他们不喜欢那些人一样"}, {"type": "subtitle", "time": 8499.349, "timestamp": "02:21:39", "text": "看着我"}, {"type": "subtitle", "time": 8503.03, "timestamp": "02:21:43", "text": "那些关注我的人，他们都知道"}, {"type": "subtitle", "time": 8505.51, "timestamp": "02:21:45", "text": "嗯，甚至还有乔森那件事"}, {"type": "subtitle", "time": 8508.11, "timestamp": "02:21:48", "text": "他很难做到这一点。"}, {"type": "subtitle", "time": 8511.75, "timestamp": "02:21:51", "text": "嗯，所以当我联系他们询问他们是否"}, {"type": "subtitle", "time": 8514.469, "timestamp": "02:21:54", "text": "他们乐于合作之类的，他们喜欢"}, {"type": "subtitle", "time": 8517.349, "timestamp": "02:21:57", "text": "真的就像在看那条溪流一样"}, {"type": "subtitle", "time": 8519.51, "timestamp": "02:21:59", "text": "是的，他们不。所以如果一个随机的人"}]
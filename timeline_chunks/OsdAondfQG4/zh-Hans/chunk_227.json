[{"type": "subtitle", "time": 13621.469, "timestamp": "03:47:01", "text": "瘾君子。他们处于顶端"}, {"type": "subtitle", "time": 13625.229, "timestamp": "03:47:05", "text": "树顶上"}, {"type": "subtitle", "time": 13628.469, "timestamp": "03:47:08", "text": "超过。那里还有乌鸦之类的东西"}, {"type": "subtitle", "time": 13630.55, "timestamp": "03:47:10", "text": "砍伐树木，还有鸟类之类的东西，因为"}, {"type": "subtitle", "time": 13634.83, "timestamp": "03:47:14", "text": "早晨。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "是的。我觉得好像没有某些人"}, {"type": "subtitle", "time": 13641.71, "timestamp": "03:47:21", "text": "我目前正在穿过……"}, {"type": "subtitle", "time": 13645.189, "timestamp": "03:47:25", "text": "海滩边的公路。是的，"}, {"type": "subtitle", "time": 13647.51, "timestamp": "03:47:27", "text": "我们走的路线和当时走的路线完全一样。"}, {"type": "subtitle", "time": 13651.349, "timestamp": "03:47:31", "text": "呃，我当时在推特空间直播的时候。"}, {"type": "subtitle", "time": 13652.91, "timestamp": "03:47:32", "text": "是的，一样。"}, {"type": "subtitle", "time": 13656.469, "timestamp": "03:47:36", "text": "路线。所以"}, {"type": "subtitle", "time": 13659.349, "timestamp": "03:47:39", "text": "嗯，这次我带了电池组。"}, {"type": "subtitle", "time": 13662.91, "timestamp": "03:47:42", "text": "这意味着我真的可以"}, {"type": "subtitle", "time": 13664.99, "timestamp": "03:47:44", "text": "游泳方式"}, {"type": "subtitle", "time": 13668.07, "timestamp": "03:47:48", "text": "直到我的电池组耗尽为止"}, {"type": "subtitle", "time": 13669.95, "timestamp": "03:47:49", "text": "我的手机没电了"}, {"type": "subtitle", "time": 13675.269, "timestamp": "03:47:55", "text": "出去。是的，没错。嗯"}, {"type": "subtitle", "time": 13678.67, "timestamp": "03:47:58", "text": "嗯，你叫什么来着？"}]
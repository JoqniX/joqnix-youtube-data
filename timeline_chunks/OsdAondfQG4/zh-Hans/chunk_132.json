[{"type": "subtitle", "time": 7923.27, "timestamp": "02:12:03", "text": "也许做这些事是因为我以前做过这些事"}, {"type": "subtitle", "time": 7925.189, "timestamp": "02:12:05", "text": "曾经尝试过创建推特空间。这"}, {"type": "subtitle", "time": 7927.03, "timestamp": "02:12:07", "text": "那还是我成长的时期。"}, {"type": "subtitle", "time": 7931.43, "timestamp": "02:12:11", "text": "在TikTok和Twitter上速度快与否。哦，"}, {"type": "subtitle", "time": 7937.51, "timestamp": "02:12:17", "text": "呃，异常快。我不知道该怎么做"}, {"type": "subtitle", "time": 7939.47, "timestamp": "02:12:19", "text": "解释"}, {"type": "subtitle", "time": 7943.229, "timestamp": "02:12:23", "text": "它。就像三天之内我就得到了"}, {"type": "subtitle", "time": 7946.069, "timestamp": "02:12:26", "text": "1500名粉丝。然后速度慢了下来。"}, {"type": "subtitle", "time": 7954.629, "timestamp": "02:12:34", "text": "对我来说很快。好的。我知道有"}, {"type": "subtitle", "time": 7956.589, "timestamp": "02:12:36", "text": "那些获得"}, {"type": "subtitle", "time": 7960.55, "timestamp": "02:12:40", "text": "比每天多得多，是的。"}, {"type": "subtitle", "time": 7967.35, "timestamp": "02:12:47", "text": "我做不到。这太过分了。"}, {"type": "subtitle", "time": 7975.91, "timestamp": "02:12:55", "text": "现在大家都要踢人了"}]
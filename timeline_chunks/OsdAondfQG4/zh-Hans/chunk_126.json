[{"type": "subtitle", "time": 7569.35, "timestamp": "02:06:09", "text": "你好聊天。我的名字是马斯孔。呃，我"}, {"type": "subtitle", "time": 7572.47, "timestamp": "02:06:12", "text": "主要在 Twitch 上直播，有时也在其他地方直播"}, {"type": "subtitle", "time": 7578.709, "timestamp": "02:06:18", "text": "YouTube 每年都会更新一次。"}, {"type": "subtitle", "time": 7582.83, "timestamp": "02:06:22", "text": "等等，你不支持多直播吗？"}, {"type": "subtitle", "time": 7586.91, "timestamp": "02:06:26", "text": "我确实这么做，这就是我有点像……"}, {"type": "subtitle", "time": 7589.35, "timestamp": "02:06:29", "text": "懒得做缩略图之类的东西"}, {"type": "subtitle", "time": 7591.51, "timestamp": "02:06:31", "text": "那。"}, {"type": "subtitle", "time": 7593.83, "timestamp": "02:06:33", "text": "等待。呃，你是做什么的？云或"}, {"type": "subtitle", "time": 7597.589, "timestamp": "02:06:37", "text": "本地插件版本？再说一遍，呃，我"}, {"type": "subtitle", "time": 7601.109, "timestamp": "02:06:41", "text": "使用插件版本。哦，"}, {"type": "subtitle", "time": 7603.35, "timestamp": "02:06:43", "text": "我有多余的带宽，我的电脑是"}, {"type": "subtitle", "time": 7605.75, "timestamp": "02:06:45", "text": "能够处理。所以，"}, {"type": "chat", "time": 7606.762, "timestamp": "02:06:46", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "that's exactly what I meant, natural spring water from your nose"}, {"type": "subtitle", "time": 7608.79, "timestamp": "02:06:48", "text": "你是分开做的吗？比如 Twitch"}, {"type": "subtitle", "time": 7610.709, "timestamp": "02:06:50", "text": "将有 Twitch 聊天室，YouTube 将有"}, {"type": "subtitle", "time": 7613.189, "timestamp": "02:06:53", "text": "YouTube聊天就是这样。"}, {"type": "subtitle", "time": 7616.229, "timestamp": "02:06:56", "text": "等等，我把它分开。我会惹上麻烦。"}, {"type": "subtitle", "time": 7619.51, "timestamp": "02:06:59", "text": "如果我不把它和 Twitch 分开，它就会一直存在。"}]
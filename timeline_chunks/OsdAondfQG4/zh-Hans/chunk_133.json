[{"type": "subtitle", "time": 7980.39, "timestamp": "02:13:00", "text": "从 Twitch 踢人赚得更多。"}, {"type": "subtitle", "time": 7982.39, "timestamp": "02:13:02", "text": "哦"}, {"type": "subtitle", "time": 7985.589, "timestamp": "02:13:05", "text": "是的。就像阿斯明去TTO和那些人一样"}, {"type": "subtitle", "time": 7988.95, "timestamp": "02:13:08", "text": "大型主播们纷纷出手，他们……"}, {"type": "subtitle", "time": 7991.83, "timestamp": "02:13:11", "text": "现在赚大钱就这么快，就在……之后"}, {"type": "subtitle", "time": 7994.629, "timestamp": "02:13:14", "text": "Twitch 直播间播放一到两段视频时，会播放一些其他类型的视频。"}, {"type": "chat", "time": 7997.768, "timestamp": "02:13:17", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "assmongol"}, {"type": "subtitle", "time": 7998.75, "timestamp": "02:13:18", "text": "他们需要30天或更长时间才能获得那么多钱"}, {"type": "subtitle", "time": 8011.03, "timestamp": "02:13:31", "text": "我检查了一下踢球伙伴的事。他们"}, {"type": "subtitle", "time": 8012.51, "timestamp": "02:13:32", "text": "允许"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "多路复现。那很好。即使"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "你是独家合作伙伴，他们允许"}, {"type": "subtitle", "time": 8021.51, "timestamp": "02:13:41", "text": "多路复现。那还挺酷的。"}, {"type": "subtitle", "time": 8025.55, "timestamp": "02:13:45", "text": "是啊，我不知道。 Pik真的很好"}, {"type": "subtitle", "time": 8027.87, "timestamp": "02:13:47", "text": "我该如何做"}, {"type": "subtitle", "time": 8031.75, "timestamp": "02:13:51", "text": "我不会说是市场营销，但他们是"}, {"type": "subtitle", "time": 8034.47, "timestamp": "02:13:54", "text": "非常擅长说服高层"}, {"type": "subtitle", "time": 8038.39, "timestamp": "02:13:58", "text": "付费观众比例较高，但付费观众比例较低。"}]
[{"type": "subtitle", "time": 7442.51, "timestamp": "02:04:02", "text": "如果你了解美元，但我"}, {"type": "subtitle", "time": 7445.27, "timestamp": "02:04:05", "text": "像湿的"}, {"type": "subtitle", "time": 7449.27, "timestamp": "02:04:09", "text": "呃，它叫什么来着？做什么"}, {"type": "subtitle", "time": 7451.91, "timestamp": "02:04:11", "text": "他们用英语怎么称呼它？"}, {"type": "subtitle", "time": 7454.149, "timestamp": "02:04:14", "text": "莱昂。"}, {"type": "subtitle", "time": 7457.43, "timestamp": "02:04:17", "text": "呃，你说的是lechron。"}, {"type": "subtitle", "time": 7459.669, "timestamp": "02:04:19", "text": "莱昂。"}, {"type": "subtitle", "time": 7462.95, "timestamp": "02:04:22", "text": "不，不，等等。呃，它叫什么来着？"}, {"type": "subtitle", "time": 7465.03, "timestamp": "02:04:25", "text": "在加洛语中被称为萨邦。我不知道"}, {"type": "subtitle", "time": 7467.95, "timestamp": "02:04:27", "text": "但用英语来说，它到底是什么意思呢？就像"}, {"type": "subtitle", "time": 7472.709, "timestamp": "02:04:32", "text": "湿漉漉的鼻屎之类的东西。呃"}, {"type": "subtitle", "time": 7476.39, "timestamp": "02:04:36", "text": "不是湿鼻屎，但是呃，它里面是湿的。"}, {"type": "chat", "time": 7481.906, "timestamp": "02:04:41", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "snot"}, {"type": "subtitle", "time": 7483.109, "timestamp": "02:04:43", "text": "鼻子湿漉漉的。"}, {"type": "subtitle", "time": 7486.39, "timestamp": "02:04:46", "text": "对，就像流鼻涕一样。流鼻涕。"}, {"type": "chat", "time": 7487.865, "timestamp": "02:04:47", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "mucus?"}, {"type": "subtitle", "time": 7489.109, "timestamp": "02:04:49", "text": "啊，流鼻涕了。是啊，红鼻子。它是"}, {"type": "subtitle", "time": 7492.31, "timestamp": "02:04:52", "text": "不是。好了。是的，这不是一个"}, {"type": "subtitle", "time": 7496.55, "timestamp": "02:04:56", "text": "流鼻涕。哦，是的。流鼻涕。是的。"}, {"type": "subtitle", "time": 7498.91, "timestamp": "02:04:58", "text": "好的。因为"}]
[{"type": "subtitle", "time": 13980.55, "timestamp": "03:53:00", "text": "如果我有一个笔记本电脑，那我就没有笔记本电脑了。"}, {"type": "subtitle", "time": 13982.67, "timestamp": "03:53:02", "text": "笔记本电脑的话，我简直就像……"}, {"type": "subtitle", "time": 13985.67, "timestamp": "03:53:05", "text": "无论我在哪里，我都能实时直播。"}, {"type": "subtitle", "time": 13988.83, "timestamp": "03:53:08", "text": "即使我在外面，我也会带上我的"}, {"type": "subtitle", "time": 14022.99, "timestamp": "03:53:42", "text": "好吧，让我先系好鞋带。"}, {"type": "subtitle", "time": 14026.11, "timestamp": "03:53:46", "text": "实际上。那里有一家商店，"}, {"type": "subtitle", "time": 14028.229, "timestamp": "03:53:48", "text": "关闭。这些就像"}, {"type": "subtitle", "time": 14031.91, "timestamp": "03:53:51", "text": "街边小店。我的天哪，我"}, {"type": "subtitle", "time": 14033.389, "timestamp": "03:53:53", "text": "不能"}, {"type": "subtitle", "time": 14037.51, "timestamp": "03:53:57", "text": "发音。所以，是的，我希望没有人会"}]
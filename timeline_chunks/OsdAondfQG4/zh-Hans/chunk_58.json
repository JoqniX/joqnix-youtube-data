[{"type": "subtitle", "time": 3484.39, "timestamp": "00:58:04", "text": "哦，是的。是的。我确实给你介绍了一位朋友。"}, {"type": "subtitle", "time": 3488.109, "timestamp": "00:58:08", "text": "我很好。这是一台游戏机。"}, {"type": "subtitle", "time": 3489.63, "timestamp": "00:58:09", "text": "好的。"}, {"type": "subtitle", "time": 3493.589, "timestamp": "00:58:13", "text": "嗨，游戏男孩戴安娜。用了两秒钟。"}, {"type": "subtitle", "time": 3495.67, "timestamp": "00:58:15", "text": "意识到是同一个人"}, {"type": "subtitle", "time": 3497.23, "timestamp": "00:58:17", "text": "与……交谈"}, {"type": "subtitle", "time": 3515.109, "timestamp": "00:58:35", "text": "是的。不，我看不到你的头像。或许"}, {"type": "subtitle", "time": 3517.67, "timestamp": "00:58:37", "text": "你仍然"}, {"type": "subtitle", "time": 3520.87, "timestamp": "00:58:40", "text": "等等，是不是卡顿了？"}, {"type": "subtitle", "time": 3531.03, "timestamp": "00:58:51", "text": "[音乐]"}, {"type": "subtitle", "time": 3534.87, "timestamp": "00:58:54", "text": "好的，现在我能看到你了。哦，很好。好的。"}, {"type": "subtitle", "time": 3537.43, "timestamp": "00:58:57", "text": "等等，我以为我的头像已经是公开的了。"}]
[{"type": "subtitle", "time": 15541.75, "timestamp": "04:19:01", "text": "热的。我会说我应该带上我的"}, {"type": "subtitle", "time": 15553.83, "timestamp": "04:19:13", "text": "那么，今天的具体目标是什么？"}, {"type": "subtitle", "time": 15556.55, "timestamp": "04:19:16", "text": "溪流？呃，让我给你演示一下。这"}, {"type": "subtitle", "time": 15557.79, "timestamp": "04:19:17", "text": "事物"}, {"type": "subtitle", "time": 15561.309, "timestamp": "04:19:21", "text": "我们目前正朝着哪个方向前进？"}, {"type": "subtitle", "time": 15564.269, "timestamp": "04:19:24", "text": "后退。我们目前正在返回途中"}, {"type": "subtitle", "time": 15566.469, "timestamp": "04:19:26", "text": "那它叫什么呢？你是什​​么"}, {"type": "subtitle", "time": 15569.63, "timestamp": "04:19:29", "text": "说？嗯，是的，我们目前正在前往"}, {"type": "subtitle", "time": 15572.389, "timestamp": "04:19:32", "text": "后退。等等，我没带钱包。哦"}, {"type": "subtitle", "time": 15574.59, "timestamp": "04:19:34", "text": "我的上帝。你是认真的吗？"}, {"type": "subtitle", "time": 15577.55, "timestamp": "04:19:37", "text": "运动健将？我的天哪，我忘了带我的"}, {"type": "subtitle", "time": 15579.95, "timestamp": "04:19:39", "text": "钱包。你在开玩笑吧"}, {"type": "subtitle", "time": 15583.83, "timestamp": "04:19:43", "text": "我？我应该带上钱包的。我怎么样？"}, {"type": "subtitle", "time": 15587.51, "timestamp": "04:19:47", "text": "去买水吗？等等，你知道吗？"}, {"type": "subtitle", "time": 15588.99, "timestamp": "04:19:48", "text": "我还是回去吧。"}, {"type": "subtitle", "time": 15590.59, "timestamp": "04:19:50", "text": "家。"}, {"type": "subtitle", "time": 15593.67, "timestamp": "04:19:53", "text": "疼痛。我还是回家吧。然后我们"}]
[{"type": "subtitle", "time": 7740.55, "timestamp": "02:09:00", "text": "汽车光束的高级版本"}, {"type": "subtitle", "time": 7742.629, "timestamp": "02:09:02", "text": "溪流。请务必删除“呃”"}, {"type": "subtitle", "time": 7745.83, "timestamp": "02:09:05", "text": "你刚才发给我的图片。"}, {"type": "subtitle", "time": 7747.27, "timestamp": "02:09:07", "text": "它会显示你直播的一小部分内容。"}, {"type": "subtitle", "time": 7756.709, "timestamp": "02:09:16", "text": "这些都会给你带来麻烦。是的。是的。它是"}, {"type": "subtitle", "time": 7760.149, "timestamp": "02:09:20", "text": "好的。不用担心。"}, {"type": "subtitle", "time": 7763.03, "timestamp": "02:09:23", "text": "他们还有一个大学聊天群。"}, {"type": "subtitle", "time": 7765.43, "timestamp": "02:09:25", "text": "真酷"}, {"type": "subtitle", "time": 7768.47, "timestamp": "02:09:28", "text": "比如，你可以在YouTube上看到教堂的视频"}, {"type": "subtitle", "time": 7770.39, "timestamp": "02:09:30", "text": "所有平台都已成功试运行。"}, {"type": "subtitle", "time": 7774.109, "timestamp": "02:09:34", "text": "现在，请阅读我的直播内容。"}, {"type": "subtitle", "time": 7776.39, "timestamp": "02:09:36", "text": "这里真高档。我知道那件事正在发生"}, {"type": "subtitle", "time": 7778.87, "timestamp": "02:09:38", "text": "帮上大忙，因为我还有第二个"}, {"type": "subtitle", "time": 7783.03, "timestamp": "02:09:43", "text": "监控那个，我遮住了我一半的"}, {"type": "subtitle", "time": 7788.19, "timestamp": "02:09:48", "text": "我的直播预览，只有聊天内容。"}, {"type": "subtitle", "time": 7791.51, "timestamp": "02:09:51", "text": "[音乐]"}, {"type": "subtitle", "time": 7794.43, "timestamp": "02:09:54", "text": "是的，这个方法不错。"}, {"type": "subtitle", "time": 7798.629, "timestamp": "02:09:58", "text": "实际上。非常精致酷炫。"}]
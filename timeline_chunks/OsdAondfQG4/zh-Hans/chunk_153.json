[{"type": "subtitle", "time": 9184.95, "timestamp": "02:33:04", "text": "2018 年，我觉得是 2020 年和 2019 年。"}, {"type": "subtitle", "time": 9189.15, "timestamp": "02:33:09", "text": "哦，不。呃，2090年，2020年。是的。"}, {"type": "subtitle", "time": 9191.75, "timestamp": "02:33:11", "text": "[音乐]"}, {"type": "subtitle", "time": 9195.11, "timestamp": "02:33:15", "text": "你一开始真的真的"}, {"type": "subtitle", "time": 9196.71, "timestamp": "02:33:16", "text": "是的。"}, {"type": "subtitle", "time": 9197.99, "timestamp": "02:33:17", "text": "你需要掌握哪些知识？"}, {"type": "subtitle", "time": 9200.07, "timestamp": "02:33:20", "text": "想聊聊吗？"}, {"type": "subtitle", "time": 9203.55, "timestamp": "02:33:23", "text": "嗯，我会说，知识会"}, {"type": "subtitle", "time": 9206.23, "timestamp": "02:33:26", "text": "也别太在意数字。"}, {"type": "subtitle", "time": 9209.03, "timestamp": "02:33:29", "text": "刚开始的时候尤其如此。就保持"}, {"type": "subtitle", "time": 9211.75, "timestamp": "02:33:31", "text": "人数大概有五六个人，或者十个人。"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "创业初期遇到的人。如果你"}, {"type": "subtitle", "time": 9216.11, "timestamp": "02:33:36", "text": "只有一两个人观看，或者根本没人观看。"}, {"type": "subtitle", "time": 9219.469, "timestamp": "02:33:39", "text": "看着，继续说，记住"}, {"type": "subtitle", "time": 9222.389, "timestamp": "02:33:42", "text": "总会有反对者"}, {"type": "subtitle", "time": 9223.99, "timestamp": "02:33:43", "text": "源自 Twitch 文化。是的，"}, {"type": "subtitle", "time": 9226.51, "timestamp": "02:33:46", "text": "将会有"}, {"type": "subtitle", "time": 9230.79, "timestamp": "02:33:50", "text": "储物柜，嗯，是的，这是你的职责。"}, {"type": "subtitle", "time": 9237.11, "timestamp": "02:33:57", "text": "是将这些学习者转化为实际的"}]
[{"type": "subtitle", "time": 8521.51, "timestamp": "02:22:01", "text": "看着直播，他们会说："}, {"type": "subtitle", "time": 8523.51, "timestamp": "02:22:03", "text": "哦，他们正在做这个人正在做的事情"}, {"type": "subtitle", "time": 8526.389, "timestamp": "02:22:06", "text": "如果只是为了开玩笑，那就是这么做。"}, {"type": "subtitle", "time": 8529.91, "timestamp": "02:22:09", "text": "所以，几天，或者50天、60天、70天。”但是"}, {"type": "subtitle", "time": 8531.99, "timestamp": "02:22:11", "text": "他们也能看到叠加层，对吧？喜欢"}, {"type": "subtitle", "time": 8535.51, "timestamp": "02:22:15", "text": "他们把一个人叫做51。是的。所以"}, {"type": "subtitle", "time": 8537.99, "timestamp": "02:22:17", "text": "他们会说：哦，原来你真的要这么做啊。"}, {"type": "subtitle", "time": 8539.67, "timestamp": "02:22:19", "text": "这么多天了，你却不是"}, {"type": "subtitle", "time": 8542.55, "timestamp": "02:22:22", "text": "他们得到任何东西，就像他们假设的那样。"}, {"type": "subtitle", "time": 8543.389, "timestamp": "02:22:23", "text": "喜欢"}, {"type": "subtitle", "time": 8546.309, "timestamp": "02:22:26", "text": "那样想好像不是这样"}, {"type": "subtitle", "time": 8548.309, "timestamp": "02:22:28", "text": "锻炼之类的，然后他们就会……"}, {"type": "subtitle", "time": 8550.23, "timestamp": "02:22:30", "text": "我为什么要和你合作？这有什么意义？"}, {"type": "subtitle", "time": 8554.11, "timestamp": "02:22:34", "text": "这样对我有好处，我就觉得"}, {"type": "subtitle", "time": 8558.23, "timestamp": "02:22:38", "text": "哇，他们居然做了超高水准的点评，我当时就想："}, {"type": "subtitle", "time": 8562.75, "timestamp": "02:22:42", "text": "我必须完全下去。"}, {"type": "subtitle", "time": 8565.67, "timestamp": "02:22:45", "text": "解释说我那样做是因为他们就像"}, {"type": "subtitle", "time": 8569.349, "timestamp": "02:22:49", "text": "我很久以前认识的一个人"}, {"type": "subtitle", "time": 8572.23, "timestamp": "02:22:52", "text": "还没能和他们建立良好的联系"}, {"type": "subtitle", "time": 8575.309, "timestamp": "02:22:55", "text": "我刚才解释了我的"}, {"type": "subtitle", "time": 8578.63, "timestamp": "02:22:58", "text": "情况就是这样，然后就发生了这件事。"}]
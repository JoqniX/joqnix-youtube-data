[{"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "是的。是的。"}, {"type": "subtitle", "time": 2225.43, "timestamp": "00:37:05", "text": "我也是。我也是。我依然很怀念它。我不能"}, {"type": "subtitle", "time": 2229.51, "timestamp": "00:37:09", "text": "我不能散开头发，因为我妈妈，我妈妈"}, {"type": "subtitle", "time": 2231.75, "timestamp": "00:37:11", "text": "前往"}, {"type": "subtitle", "time": 2233.67, "timestamp": "00:37:13", "text": "我妈会怪我的。你知道，我"}, {"type": "subtitle", "time": 2235.43, "timestamp": "00:37:15", "text": "我其实可以稍微移动一下我的模型。"}, {"type": "subtitle", "time": 2237.67, "timestamp": "00:37:17", "text": "与操作系统有关联。"}, {"type": "subtitle", "time": 2242.23, "timestamp": "00:37:22", "text": "我一直想做这件事。"}, {"type": "subtitle", "time": 2244.99, "timestamp": "00:37:24", "text": "是的。一秒钟。我接到一个电话，来自"}, {"type": "subtitle", "time": 2248.65, "timestamp": "00:37:28", "text": "家人"}, {"type": "subtitle", "time": 2258.109, "timestamp": "00:37:38", "text": "[音乐]"}, {"type": "subtitle", "time": 2262.95, "timestamp": "00:37:42", "text": "安全的。哦好的。"}, {"type": "subtitle", "time": 2264.829, "timestamp": "00:37:44", "text": "是，是"}, {"type": "subtitle", "time": 2272.63, "timestamp": "00:37:52", "text": "人们总是会肿胀。"}, {"type": "subtitle", "time": 2274.63, "timestamp": "00:37:54", "text": "你们都听他们的。好的。患病的"}, {"type": "subtitle", "time": 2277.349, "timestamp": "00:37:57", "text": "一会儿就回来。让我把门关上。"}]
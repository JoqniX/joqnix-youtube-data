[{"type": "subtitle", "time": 16567.029, "timestamp": "04:36:07", "text": "正在做？晨练感觉如何？我是"}, {"type": "subtitle", "time": 16569.269, "timestamp": "04:36:09", "text": "我真的快要死了，我真的"}, {"type": "subtitle", "time": 16572.51, "timestamp": "04:36:12", "text": "沿着海边散步。海滩"}, {"type": "subtitle", "time": 16576.47, "timestamp": "04:36:16", "text": "就是那种有沙子之类的东西。"}, {"type": "subtitle", "time": 16580.59, "timestamp": "04:36:20", "text": "我们，我，走到了海滩的尽头"}, {"type": "subtitle", "time": 16582.869, "timestamp": "04:36:22", "text": "几乎到了海滩尽头的那个东西"}, {"type": "subtitle", "time": 16585.109, "timestamp": "04:36:25", "text": "东西。那里有一艘大型渔船。"}, {"type": "subtitle", "time": 16586.869, "timestamp": "04:36:26", "text": "或者别的什么。我的天哪。水。等等"}, {"type": "subtitle", "time": 16589.189, "timestamp": "04:36:29", "text": "等等等等。让我上去。放我走"}, {"type": "subtitle", "time": 16593.47, "timestamp": "04:36:33", "text": "向左转。我的天哪。真是太糟糕了！"}, {"type": "subtitle", "time": 16597.07, "timestamp": "04:36:37", "text": "上帝。所以我的意思是，我去干掉了蓝色的敌人。"}, {"type": "subtitle", "time": 16599.91, "timestamp": "04:36:39", "text": "登上渔夫的船，就像"}, {"type": "subtitle", "time": 16602.869, "timestamp": "04:36:42", "text": "靠近海滩尽头的地方。然后我"}, {"type": "subtitle", "time": 16605.91, "timestamp": "04:36:45", "text": "步行。我的天，那是一大滩水。"}, {"type": "subtitle", "time": 16606.67, "timestamp": "04:36:46", "text": "哦"}, {"type": "subtitle", "time": 16609.07, "timestamp": "04:36:49", "text": "上帝。"}, {"type": "subtitle", "time": 16613.109, "timestamp": "04:36:53", "text": "啊，我不知道回家的路，但是"}]
[{"type": "subtitle", "time": 5226.55, "timestamp": "01:27:06", "text": "忘了，哦对对，好吧，我不知道"}, {"type": "subtitle", "time": 5230.27, "timestamp": "01:27:10", "text": "记住，永远不要作恶。"}, {"type": "subtitle", "time": 5232.55, "timestamp": "01:27:12", "text": "呃，抱歉。我的记忆力一直不太好。"}, {"type": "subtitle", "time": 5236.189, "timestamp": "01:27:16", "text": "最近不太好。不，没关系。这一切都是"}, {"type": "subtitle", "time": 5240.31, "timestamp": "01:27:20", "text": "好的。记住，这只是注意力缺陷多动症发作而已。"}, {"type": "subtitle", "time": 5243.03, "timestamp": "01:27:23", "text": "时不时地跟我们说，“是啊，你"}, {"type": "subtitle", "time": 5246.229, "timestamp": "01:27:26", "text": "需要提提神。"}, {"type": "subtitle", "time": 5251.669, "timestamp": "01:27:31", "text": "根钦。根钦。关于"}, {"type": "subtitle", "time": 5255.35, "timestamp": "01:27:35", "text": "是要加入 Genchin 吗？"}, {"type": "subtitle", "time": 5257.629, "timestamp": "01:27:37", "text": "呃，哦，是的。不，不，不。"}, {"type": "subtitle", "time": 5262.87, "timestamp": "01:27:42", "text": "我差点想起来。呃"}, {"type": "subtitle", "time": 5265.189, "timestamp": "01:27:45", "text": "我想我等不及了，你知道的"}, {"type": "subtitle", "time": 5270.149, "timestamp": "01:27:50", "text": "游戏每周更新。是的。"}, {"type": "subtitle", "time": 5273.91, "timestamp": "01:27:53", "text": "呃，或者说，不，不是每周都这样。呃，我"}, {"type": "subtitle", "time": 5276.709, "timestamp": "01:27:56", "text": "我不知道该怎么解释。"}, {"type": "subtitle", "time": 5278.11, "timestamp": "01:27:58", "text": "比如"}]
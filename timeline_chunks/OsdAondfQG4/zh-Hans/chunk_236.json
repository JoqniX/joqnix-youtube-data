[{"type": "subtitle", "time": 14161.11, "timestamp": "03:56:01", "text": "我会死，我会死，我会哭。我会死。我"}, {"type": "subtitle", "time": 14162.429, "timestamp": "03:56:02", "text": "我不"}, {"type": "subtitle", "time": 14165.309, "timestamp": "03:56:05", "text": "知道。但是，呃，有一个"}, {"type": "subtitle", "time": 14167.67, "timestamp": "03:56:07", "text": "摇摆。那东西叫什么？"}, {"type": "subtitle", "time": 14169.91, "timestamp": "03:56:09", "text": "你可以在这里左右摇摆"}, {"type": "subtitle", "time": 14173.189, "timestamp": "03:56:13", "text": "上下？等等，上下移动。等待，"}, {"type": "subtitle", "time": 14175.15, "timestamp": "03:56:15", "text": "你管这叫什么？"}, {"type": "subtitle", "time": 14177.67, "timestamp": "03:56:17", "text": "再次？我看到了那东西，但它是人造的。"}, {"type": "subtitle", "time": 14180.75, "timestamp": "03:56:20", "text": "木制"}, {"type": "subtitle", "time": 14184.15, "timestamp": "03:56:24", "text": "东西。是的。目前在店里，"}, {"type": "subtitle", "time": 14187.75, "timestamp": "03:56:27", "text": "也。实际上只有两个狗狗目标"}, {"type": "subtitle", "time": 14192.229, "timestamp": "03:56:32", "text": "盯着我看。这家伙在干什么？"}, {"type": "subtitle", "time": 14194.55, "timestamp": "03:56:34", "text": "他为什么把手机举到嘴边？"}, {"type": "subtitle", "time": 14196.269, "timestamp": "03:56:36", "text": "以及说话"}, {"type": "subtitle", "time": 14204.229, "timestamp": "03:56:44", "text": "上帝。哦，这里有花之类的东西，但是……"}, {"type": "subtitle", "time": 14213.11, "timestamp": "03:56:53", "text": "我猜这里有花之类的东西。"}]
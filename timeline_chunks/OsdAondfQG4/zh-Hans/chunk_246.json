[{"type": "subtitle", "time": 14762.87, "timestamp": "04:06:02", "text": "我的天哪，我得重新学习一下了。"}, {"type": "subtitle", "time": 14765.59, "timestamp": "04:06:05", "text": "我的天啊，不过这又有点酷"}, {"type": "subtitle", "time": 14768.15, "timestamp": "04:06:08", "text": "虽然就像你看到冲浪一样"}, {"type": "subtitle", "time": 14771.83, "timestamp": "04:06:11", "text": "视频之类的东西，我仍然想知道是怎么回事。"}, {"type": "subtitle", "time": 14775.15, "timestamp": "04:06:15", "text": "你能冲浪到那样的大浪吗？"}, {"type": "subtitle", "time": 14781.75, "timestamp": "04:06:21", "text": "凉爽的。小时候，我"}, {"type": "subtitle", "time": 14785.67, "timestamp": "04:06:25", "text": "以前常看冲浪视频。不知何故"}, {"type": "subtitle", "time": 14790.389, "timestamp": "04:06:30", "text": "它出现在我的YouTube频道上之类的。"}, {"type": "subtitle", "time": 14793.269, "timestamp": "04:06:33", "text": "是的。所以，我以前一直很纳闷。我想"}, {"type": "subtitle", "time": 14797.03, "timestamp": "04:06:37", "text": "成为我自己。但对，因为它太……"}, {"type": "subtitle", "time": 14800.15, "timestamp": "04:06:40", "text": "很酷，对吧，乘风破浪，"}, {"type": "subtitle", "time": 14802.55, "timestamp": "04:06:42", "text": "很酷，你知道，就像在你的"}, {"type": "subtitle", "time": 14807.189, "timestamp": "04:06:47", "text": "冲浪，喜欢做很酷的事情。"}, {"type": "subtitle", "time": 14808.59, "timestamp": "04:06:48", "text": "这有点像"}, {"type": "subtitle", "time": 14810.75, "timestamp": "04:06:50", "text": "凉爽的。"}, {"type": "subtitle", "time": 14814.229, "timestamp": "04:06:54", "text": "于是，我走到了沙滩的尽头。"}, {"type": "subtitle", "time": 14815.67, "timestamp": "04:06:55", "text": "几乎就要到达终点了"}, {"type": "subtitle", "time": 14818.469, "timestamp": "04:06:58", "text": "海滩。这真是太好了。"}]
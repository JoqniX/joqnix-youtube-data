[{"type": "subtitle", "time": 4200.07, "timestamp": "01:10:00", "text": "对，就是那时候我看到的。"}, {"type": "subtitle", "time": 4202.47, "timestamp": "01:10:02", "text": "新型号。它真漂亮。为什么会这样？"}, {"type": "subtitle", "time": 4211.149, "timestamp": "01:10:11", "text": "我相信你还在做"}, {"type": "subtitle", "time": 4215.11, "timestamp": "01:10:15", "text": "一半是油管博主，一半是现实生活中的人。那"}, {"type": "subtitle", "time": 4217.11, "timestamp": "01:10:17", "text": "太酷了。"}, {"type": "subtitle", "time": 4226.39, "timestamp": "01:10:26", "text": "一半一半这种说法更像是"}, {"type": "subtitle", "time": 4228.95, "timestamp": "01:10:28", "text": "我不知道该如何解释，因为"}, {"type": "subtitle", "time": 4230.79, "timestamp": "01:10:30", "text": "最近我也不知道为什么，我好像更频繁地看流媒体了。"}, {"type": "subtitle", "time": 4233.669, "timestamp": "01:10:33", "text": "在 Twitch 上，但就像最近"}, {"type": "subtitle", "time": 4235.35, "timestamp": "01:10:35", "text": "我的模特越来越不常出现了，"}, {"type": "subtitle", "time": 4238.229, "timestamp": "01:10:38", "text": "就像我已经公开露面过一样"}, {"type": "subtitle", "time": 4243.03, "timestamp": "01:10:43", "text": "你做到了。哇。好的。是的。"}, {"type": "subtitle", "time": 4245.11, "timestamp": "01:10:45", "text": "所以我觉得自己越来越不像个虚拟主播了。"}, {"type": "subtitle", "time": 4250.709, "timestamp": "01:10:50", "text": "嘿，乔。"}, {"type": "subtitle", "time": 4252.95, "timestamp": "01:10:52", "text": "但那件事真的太疯狂了。我"}, {"type": "subtitle", "time": 4255.83, "timestamp": "01:10:55", "text": "还有一些BNG之类的东西。是的，你的确有。"}, {"type": "subtitle", "time": 4256.99, "timestamp": "01:10:56", "text": "你"}]
[{"type": "subtitle", "time": 4622.149, "timestamp": "01:17:02", "text": "你自己。这简直就像艾伦·林格一样"}, {"type": "subtitle", "time": 4624.07, "timestamp": "01:17:04", "text": "斗争。等等，这个模组叫什么名字？"}, {"type": "subtitle", "time": 4625.91, "timestamp": "01:17:05", "text": "再次？动画等等。它是"}, {"type": "subtitle", "time": 4629.229, "timestamp": "01:17:09", "text": "名为“史诗级战斗”。史诗"}, {"type": "subtitle", "time": 4639.189, "timestamp": "01:17:19", "text": "缓和。你用的是哪一个？缓和"}, {"type": "subtitle", "time": 4644.55, "timestamp": "01:17:24", "text": "或者比如，哦，我用的是 Curse Forge。啊，"}, {"type": "subtitle", "time": 4647.03, "timestamp": "01:17:27", "text": "是的。我不知道。我一直都在用"}, {"type": "subtitle", "time": 4649.59, "timestamp": "01:17:29", "text": "Curse Forge 是因为它最……"}, {"type": "subtitle", "time": 4659.75, "timestamp": "01:17:39", "text": "感觉好孤独。改变我的世界"}, {"type": "subtitle", "time": 4663.31, "timestamp": "01:17:43", "text": "战斗。我刚刚输掉了战斗。"}, {"type": "subtitle", "time": 4667.709, "timestamp": "01:17:47", "text": "哦。我的天哪，这也太酷了吧！短跑"}, {"type": "subtitle", "time": 4670.51, "timestamp": "01:17:50", "text": "攻击，"}, {"type": "subtitle", "time": 4673.189, "timestamp": "01:17:53", "text": "闪避，特殊攻击。我喜欢这样"}, {"type": "subtitle", "time": 4678.32, "timestamp": "01:17:58", "text": "那是一个"}, {"type": "subtitle", "time": 4679.79, "timestamp": "01:17:59", "text": "[音乐]"}]
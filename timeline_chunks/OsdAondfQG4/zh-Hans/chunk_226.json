[{"type": "subtitle", "time": 13561.269, "timestamp": "03:46:01", "text": "他为什么一直在对着手机说话之类的"}, {"type": "subtitle", "time": 13563.95, "timestamp": "03:46:03", "text": "东西。但"}, {"type": "subtitle", "time": 13569.67, "timestamp": "03:46:09", "text": "嗯，还行吧，不过某种程度上我觉得……"}, {"type": "subtitle", "time": 13573.469, "timestamp": "03:46:13", "text": "现在开始变得自信了，这"}, {"type": "subtitle", "time": 13576.07, "timestamp": "03:46:16", "text": "就像我以前做旅游景点的时候一样"}, {"type": "subtitle", "time": 13578.87, "timestamp": "03:46:18", "text": "我当时真的非常害怕，非常"}, {"type": "subtitle", "time": 13582.07, "timestamp": "03:46:22", "text": "既尴尬又担心"}, {"type": "subtitle", "time": 13585.71, "timestamp": "03:46:25", "text": "每当我们路过陌生人时，我都会试着"}, {"type": "subtitle", "time": 13589.03, "timestamp": "03:46:29", "text": "静音并尽量保持安静，然后当我"}, {"type": "subtitle", "time": 13592.07, "timestamp": "03:46:32", "text": "洗它们，我试着说话，但"}, {"type": "subtitle", "time": 13595.429, "timestamp": "03:46:35", "text": "就像直接冲上去一样。所以我觉得"}, {"type": "subtitle", "time": 13596.91, "timestamp": "03:46:36", "text": "呃，你越……"}, {"type": "subtitle", "time": 13600.55, "timestamp": "03:46:40", "text": "做一些让你感到快乐的事情"}, {"type": "subtitle", "time": 13603.67, "timestamp": "03:46:43", "text": "不舒服，或者像……你"}, {"type": "subtitle", "time": 13607.429, "timestamp": "03:46:47", "text": "以前没做过，呃，你那种"}, {"type": "subtitle", "time": 13610.309, "timestamp": "03:46:50", "text": "过一段时间后就会适应，那就是"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "挺酷的。等等，那是蟋蟀吗？"}, {"type": "subtitle", "time": 13614.87, "timestamp": "03:46:54", "text": "等等，那是只蟋蟀。等等，你……"}, {"type": "subtitle", "time": 13616.95, "timestamp": "03:46:56", "text": "听到了吗？"}, {"type": "subtitle", "time": 13619.07, "timestamp": "03:46:59", "text": "这是"}]
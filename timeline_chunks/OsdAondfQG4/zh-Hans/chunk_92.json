[{"type": "subtitle", "time": 5522.149, "timestamp": "01:32:02", "text": "所以，我总是……嗯，是的，我总是喜欢"}, {"type": "subtitle", "time": 5524.47, "timestamp": "01:32:04", "text": "玩完那个游戏之后，也许……"}, {"type": "subtitle", "time": 5527.75, "timestamp": "01:32:07", "text": "偶尔会直播，但是"}, {"type": "subtitle", "time": 5530.79, "timestamp": "01:32:10", "text": "是啊，我不知道。我认为原因"}, {"type": "subtitle", "time": 5533.189, "timestamp": "01:32:13", "text": "我玩很多游戏的原因是："}, {"type": "subtitle", "time": 5534.59, "timestamp": "01:32:14", "text": "主播"}, {"type": "subtitle", "time": 5538.31, "timestamp": "01:32:18", "text": "朋友们。 M"}, {"type": "subtitle", "time": 5539.669, "timestamp": "01:32:19", "text": "我不会撒谎。我以为你"}, {"type": "subtitle", "time": 5542.149, "timestamp": "01:32:22", "text": "虽然打法像个路人甲。是的，"}, {"type": "subtitle", "time": 5544.39, "timestamp": "01:32:24", "text": "随机的那些。"}, {"type": "subtitle", "time": 5547.27, "timestamp": "01:32:27", "text": "是啊，市面上有很多乱七八糟的游戏。"}, {"type": "subtitle", "time": 5549.35, "timestamp": "01:32:29", "text": "那里。"}, {"type": "subtitle", "time": 5551.99, "timestamp": "01:32:31", "text": "只需要找到它就行了。寻找好"}, {"type": "subtitle", "time": 5555.11, "timestamp": "01:32:35", "text": "然后，是的，我发现了一个真正的"}, {"type": "subtitle", "time": 5565.47, "timestamp": "01:32:45", "text": "是的。好多东西。"}, {"type": "subtitle", "time": 5569.91, "timestamp": "01:32:49", "text": "打扰一下。或许。"}, {"type": "subtitle", "time": 5572.95, "timestamp": "01:32:52", "text": "你喝酒了吗？你补充水分了吗？"}, {"type": "subtitle", "time": 5574.229, "timestamp": "01:32:54", "text": "是的，我的水快用完了。"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "就在这里。我知道。哦，你可以拿一个"}, {"type": "subtitle", "time": 5579.59, "timestamp": "01:32:59", "text": "稍作休息，比如……呃，补充一下你的瓶子。"}]
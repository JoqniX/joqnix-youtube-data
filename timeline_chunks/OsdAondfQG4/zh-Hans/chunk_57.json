[{"type": "subtitle", "time": 3427.15, "timestamp": "00:57:07", "text": "希望你一切都好。你过得怎么样？"}, {"type": "subtitle", "time": 3429.39, "timestamp": "00:57:09", "text": "天？"}, {"type": "subtitle", "time": 3433.03, "timestamp": "00:57:13", "text": "等等，为什么？等等，我的电脑居然变成这样了"}, {"type": "subtitle", "time": 3438.309, "timestamp": "00:57:18", "text": "真他妈的亮。哦不，是辆车。"}, {"type": "subtitle", "time": 3441.349, "timestamp": "00:57:21", "text": "完全记住了。"}, {"type": "subtitle", "time": 3443.829, "timestamp": "00:57:23", "text": "哦，我居然忘了取消静音。你"}, {"type": "subtitle", "time": 3447.19, "timestamp": "00:57:27", "text": "知道什么？不用担心。从下周开始"}, {"type": "subtitle", "time": 3449.75, "timestamp": "00:57:29", "text": "接下来，我会用我的脚踏板。我只是"}, {"type": "subtitle", "time": 3452.789, "timestamp": "00:57:32", "text": "需要踩下脚踏板才能说话"}, {"type": "subtitle", "time": 3455.99, "timestamp": "00:57:35", "text": "加入 Discord，一起玩游戏什么的。"}, {"type": "subtitle", "time": 3464.63, "timestamp": "00:57:44", "text": "Asa应该把这东西弄得可爱一点。"}, {"type": "subtitle", "time": 3469.27, "timestamp": "00:57:49", "text": "哦，游戏盒。太可爱了。化身。"}, {"type": "subtitle", "time": 3472.309, "timestamp": "00:57:52", "text": "是的。你好。"}, {"type": "subtitle", "time": 3477.19, "timestamp": "00:57:57", "text": "这似乎很难为建筑而建造。"}]
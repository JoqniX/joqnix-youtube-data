[{"type": "subtitle", "time": 4504.27, "timestamp": "01:15:04", "text": "一个 Minecraft 生存模块化服务器。"}, {"type": "subtitle", "time": 4506.99, "timestamp": "01:15:06", "text": "啊，进展如何？"}, {"type": "subtitle", "time": 4510.95, "timestamp": "01:15:10", "text": "是的。哦，进展顺利。到目前为止"}, {"type": "subtitle", "time": 4514.31, "timestamp": "01:15:14", "text": "我大概做了五个。呃"}, {"type": "subtitle", "time": 4516.11, "timestamp": "01:15:16", "text": "每一项持续约"}, {"type": "subtitle", "time": 4519.27, "timestamp": "01:15:19", "text": "一年过去了，我不知道自己学到了什么。"}, {"type": "subtitle", "time": 4522.59, "timestamp": "01:15:22", "text": "通过制作它们"}, {"type": "subtitle", "time": 4525.75, "timestamp": "01:15:25", "text": "比如如何制作一款好游戏。如何"}, {"type": "subtitle", "time": 4527.59, "timestamp": "01:15:27", "text": "如何让人们觉得有趣？如何制作"}, {"type": "subtitle", "time": 4531.11, "timestamp": "01:15:31", "text": "对人们来说难吗？诸如此类的事情。"}, {"type": "subtitle", "time": 4532.709, "timestamp": "01:15:32", "text": "[音乐]"}, {"type": "subtitle", "time": 4535.75, "timestamp": "01:15:35", "text": "你添加了类似那些自定义代码的东西吗？"}, {"type": "subtitle", "time": 4538.95, "timestamp": "01:15:38", "text": "比如按下 Esc 键"}, {"type": "subtitle", "time": 4542.149, "timestamp": "01:15:42", "text": "按下退出键，你就会看到SMP的名称。"}, {"type": "subtitle", "time": 4544.87, "timestamp": "01:15:44", "text": "以及那些定制的东西"}, {"type": "subtitle", "time": 4546.63, "timestamp": "01:15:46", "text": "主题式的？"}, {"type": "subtitle", "time": 4551.59, "timestamp": "01:15:51", "text": "呃，我上个SMP做过。啊，"}, {"type": "subtitle", "time": 4555.189, "timestamp": "01:15:55", "text": "有些球员超级棒"}, {"type": "subtitle", "time": 4557.99, "timestamp": "01:15:57", "text": "他们对SMP很感兴趣，所以就定制了"}]
[{"type": "subtitle", "time": 4740.55, "timestamp": "01:19:00", "text": "还有闲逛的人们。然后我就可以做我"}, {"type": "subtitle", "time": 4747.99, "timestamp": "01:19:07", "text": "如果你想的话，它会保留一段时间。"}, {"type": "subtitle", "time": 4751.189, "timestamp": "01:19:11", "text": "玩耍。告诉我一声就好。"}, {"type": "subtitle", "time": 4754.63, "timestamp": "01:19:14", "text": "你知道。你好。"}, {"type": "subtitle", "time": 4761.11, "timestamp": "01:19:21", "text": "所以，你最近一直在玩《命运》吗？你"}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "你买了新的吗？"}, {"type": "subtitle", "time": 4767.83, "timestamp": "01:19:27", "text": "有一个新的，我的意思是，我拥有所有……"}, {"type": "subtitle", "time": 4770.79, "timestamp": "01:19:30", "text": "已购买未来几季的套票。哦，但是"}, {"type": "subtitle", "time": 4773.669, "timestamp": "01:19:33", "text": "你得把它磨碎，对吧？即使你"}, {"type": "subtitle", "time": 4777.189, "timestamp": "01:19:37", "text": "买那个。我真的很想，但是我"}, {"type": "subtitle", "time": 4779.149, "timestamp": "01:19:39", "text": "不知道。我找不到"}, {"type": "subtitle", "time": 4782.189, "timestamp": "01:19:42", "text": "我的，我不能，呃，那是什么？"}, {"type": "subtitle", "time": 4786.229, "timestamp": "01:19:46", "text": "叫什么？我懒。"}, {"type": "subtitle", "time": 4789.03, "timestamp": "01:19:49", "text": "嗯，没关系。我得到它。动机。我"}, {"type": "subtitle", "time": 4793.39, "timestamp": "01:19:53", "text": "找不到做这件事的动力。嗯。"}, {"type": "subtitle", "time": 4795.75, "timestamp": "01:19:55", "text": "是啊，这很难。看起来很有趣"}]
[{"type": "subtitle", "time": 15664.349, "timestamp": "04:21:04", "text": "是的，所以我正走过……"}, {"type": "subtitle", "time": 15668.71, "timestamp": "04:21:08", "text": "那家店，呃，该怎么称呼它呢？我"}, {"type": "subtitle", "time": 15672.149, "timestamp": "04:21:12", "text": "买来像莫吉托那样的饮料"}, {"type": "subtitle", "time": 15674.469, "timestamp": "04:21:14", "text": "在我的旅游空间里。所以这家店是"}, {"type": "subtitle", "time": 15677.71, "timestamp": "04:21:17", "text": "关闭。他们只在晚上才开门。"}, {"type": "subtitle", "time": 15680.229, "timestamp": "04:21:20", "text": "时间。我到底是什么时候做的？"}, {"type": "subtitle", "time": 15683.99, "timestamp": "04:21:23", "text": "旅游基地？下午三四点，对吧？曾是"}, {"type": "subtitle", "time": 15687.75, "timestamp": "04:21:27", "text": "是5吗？我不知道。我想应该是2个呃"}, {"type": "subtitle", "time": 15693.07, "timestamp": "04:21:33", "text": "下午3点至4点或者在附近等300"}, {"type": "subtitle", "time": 15700.429, "timestamp": "04:21:40", "text": "进去。但是"}, {"type": "subtitle", "time": 15702.189, "timestamp": "04:21:42", "text": "是的，"}, {"type": "subtitle", "time": 15704.63, "timestamp": "04:21:44", "text": "你的孩子还在走路。"}, {"type": "subtitle", "time": 15707.51, "timestamp": "04:21:47", "text": "海滩边而不是路边，因为"}, {"type": "subtitle", "time": 15711.269, "timestamp": "04:21:51", "text": "我想迷路。天哪，我好累。"}, {"type": "subtitle", "time": 15714.389, "timestamp": "04:21:54", "text": "我的天哪，我好累。我不想"}, {"type": "subtitle", "time": 15717.95, "timestamp": "04:21:57", "text": "去。不是扫荡，但我很想去"}]
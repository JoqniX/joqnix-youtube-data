[{"type": "subtitle", "time": 17640.628, "timestamp": "04:54:00", "text": "下雪了，雪下得很大。然后谢谢"}, {"type": "subtitle", "time": 17641.788, "timestamp": "04:54:01", "text": "谢谢你的光临"}, {"type": "subtitle", "time": 17645.23, "timestamp": "04:54:05", "text": "经过。谢谢，祝你一切顺利"}, {"type": "subtitle", "time": 17649.75, "timestamp": "04:54:09", "text": "早上好。嗯等等，你带着你的"}, {"type": "subtitle", "time": 17655.11, "timestamp": "04:54:15", "text": "也记账。嗨，谢谢你的光临。"}, {"type": "subtitle", "time": 17658.23, "timestamp": "04:54:18", "text": "还有，早上好！"}, {"type": "subtitle", "time": 17659.67, "timestamp": "04:54:19", "text": "又下雪了。我忘了说“好”。"}, {"type": "subtitle", "time": 17660.91, "timestamp": "04:54:20", "text": "早上好"}, {"type": "subtitle", "time": 17663.47, "timestamp": "04:54:23", "text": "是的"}, {"type": "subtitle", "time": 17691.39, "timestamp": "04:54:51", "text": "少量。我应该拍张照片"}, {"type": "subtitle", "time": 17693.51, "timestamp": "04:54:53", "text": "狗狗。是的。是的。是的。你知道吗？"}, {"type": "subtitle", "time": 17695.868, "timestamp": "04:54:55", "text": "等等，这里有粪便之类的东西。哦，我的"}, {"type": "subtitle", "time": 17698.15, "timestamp": "04:54:58", "text": "上帝。等等，我拍张照片。"}, {"type": "subtitle", "time": 17699.39, "timestamp": "04:54:59", "text": "狗狗。"}]
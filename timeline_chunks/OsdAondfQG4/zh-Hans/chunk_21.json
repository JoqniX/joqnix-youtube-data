[{"type": "subtitle", "time": 1260.71, "timestamp": "00:21:00", "text": "拥有环球影业。所以你的音频"}, {"type": "subtitle", "time": 1263.909, "timestamp": "00:21:03", "text": "在直播中听到的也是一样的。"}, {"type": "subtitle", "time": 1266.149, "timestamp": "00:21:06", "text": "你听到的音频来自我的麦克风。"}, {"type": "subtitle", "time": 1267.83, "timestamp": "00:21:07", "text": "直播这个对他们来说也是一样的。"}, {"type": "subtitle", "time": 1269.59, "timestamp": "00:21:09", "text": "也一样。"}, {"type": "subtitle", "time": 1275.029, "timestamp": "00:21:15", "text": "是的。麦克风指示灯已开启。是的。是的。"}, {"type": "subtitle", "time": 1278.47, "timestamp": "00:21:18", "text": "是的。是的。我把它调成静音了。我"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "麦克风离得太近了"}, {"type": "subtitle", "time": 1282.87, "timestamp": "00:21:22", "text": "耳机。音频泄露了。"}, {"type": "subtitle", "time": 1287.75, "timestamp": "00:21:27", "text": "这意味着我需要把耳机调低一些。"}, {"type": "subtitle", "time": 1290.549, "timestamp": "00:21:30", "text": "我从没想过我需要听"}, {"type": "subtitle", "time": 1293.99, "timestamp": "00:21:33", "text": "给你。我的天啊。所以，是的，回去吧"}, {"type": "subtitle", "time": 1303.35, "timestamp": "00:21:43", "text": "你觉得呢？我的天哪，你是"}, {"type": "subtitle", "time": 1306.47, "timestamp": "00:21:46", "text": "太可爱了。对了，你多大了？"}, {"type": "subtitle", "time": 1310.23, "timestamp": "00:21:50", "text": "想吃东西吗？想喝血吗？"}, {"type": "subtitle", "time": 1312.07, "timestamp": "00:21:52", "text": "我的天啊。"}, {"type": "subtitle", "time": 1314.75, "timestamp": "00:21:54", "text": "如此年轻"}, {"type": "subtitle", "time": 1316.51, "timestamp": "00:21:56", "text": "吸血鬼"}, {"type": "subtitle", "time": 1319.51, "timestamp": "00:21:59", "text": "孩子不是吸血鬼。为什么？为什么是孩子？"}]
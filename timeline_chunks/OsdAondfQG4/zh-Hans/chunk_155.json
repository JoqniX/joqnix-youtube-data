[{"type": "subtitle", "time": 9303.27, "timestamp": "02:35:03", "text": "很好的建议。很好的建议。"}, {"type": "subtitle", "time": 9305.19, "timestamp": "02:35:05", "text": "尤其是数字1。是的，"}, {"type": "subtitle", "time": 9312.87, "timestamp": "02:35:12", "text": "很难把它藏起来。不，不，是"}, {"type": "subtitle", "time": 9315.67, "timestamp": "02:35:15", "text": "美好的。没关系。前进。"}, {"type": "subtitle", "time": 9318.27, "timestamp": "02:35:18", "text": "我尽量保持人数统计"}, {"type": "subtitle", "time": 9320.51, "timestamp": "02:35:20", "text": "就像"}, {"type": "subtitle", "time": 9327.59, "timestamp": "02:35:27", "text": "而不是记住数量"}, {"type": "subtitle", "time": 9328.95, "timestamp": "02:35:28", "text": "我记得那些进来的人"}, {"type": "subtitle", "time": 9336.95, "timestamp": "02:35:36", "text": "快点。所以如果我看到至少一个"}, {"type": "subtitle", "time": 9338.55, "timestamp": "02:35:38", "text": "这个人，而且是同一个人。"}, {"type": "subtitle", "time": 9351.03, "timestamp": "02:35:51", "text": "你刚才说什么？我喜欢砍你"}, {"type": "subtitle", "time": 9355.15, "timestamp": "02:35:55", "text": "离开。哦，我刚才说的是……"}, {"type": "subtitle", "time": 9358.51, "timestamp": "02:35:58", "text": "嗯……我刚才说到哪儿了？"}]
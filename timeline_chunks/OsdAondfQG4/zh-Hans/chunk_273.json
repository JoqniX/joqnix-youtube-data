[{"type": "subtitle", "time": 16380.07, "timestamp": "04:33:00", "text": "我想我不知道该用哪个词来形容"}, {"type": "subtitle", "time": 16383.07, "timestamp": "04:33:03", "text": "这又来了"}, {"type": "subtitle", "time": 16386.91, "timestamp": "04:33:06", "text": "词汇量有限"}, {"type": "subtitle", "time": 16391.029, "timestamp": "04:33:11", "text": "走吧，不过我们确实一直在直播"}, {"type": "subtitle", "time": 16393.23, "timestamp": "04:33:13", "text": "整整一个小时，我的天哪"}, {"type": "subtitle", "time": 16396.47, "timestamp": "04:33:16", "text": "天哪，昨天我们居然真的做到了"}, {"type": "subtitle", "time": 16400.39, "timestamp": "04:33:20", "text": "又是1小时23分钟。我喜欢他们"}, {"type": "subtitle", "time": 16408.789, "timestamp": "04:33:28", "text": "在那里我可以进行更长时间的……"}, {"type": "subtitle", "time": 16411.629, "timestamp": "04:33:31", "text": "因为我坐着，所以就直播了"}, {"type": "subtitle", "time": 16414.789, "timestamp": "04:33:34", "text": "这方面我受到限制，因为移动数据流量有限。"}, {"type": "subtitle", "time": 16417.91, "timestamp": "04:33:37", "text": "手机电池是其中之一。"}, {"type": "subtitle", "time": 16419.91, "timestamp": "04:33:39", "text": "这就是为什么你需要电池的原因"}, {"type": "subtitle", "time": 16422.551, "timestamp": "04:33:42", "text": "盒。说到这个，我需要检查一下"}, {"type": "subtitle", "time": 16431.31, "timestamp": "04:33:51", "text": "盒。我的天哪，真是太累了。"}, {"type": "subtitle", "time": 16433.99, "timestamp": "04:33:53", "text": "很多。我的天哪，这太让人精疲力竭了。"}, {"type": "subtitle", "time": 16436.07, "timestamp": "04:33:56", "text": "疯狂的。你知道吗？我要删除"}, {"type": "subtitle", "time": 16438.349, "timestamp": "04:33:58", "text": "角色"}]
[{"type": "subtitle", "time": 5282.79, "timestamp": "01:28:02", "text": "游戏更新频率可能是每月或每周。"}, {"type": "subtitle", "time": 5285.51, "timestamp": "01:28:05", "text": "内容，而且我不想等"}, {"type": "subtitle", "time": 5292.07, "timestamp": "01:28:12", "text": "是啊，但就像《呼啸山庄》一样，你"}, {"type": "subtitle", "time": 5293.59, "timestamp": "01:28:13", "text": "我开始的时候就已经有了那些内容"}, {"type": "subtitle", "time": 5295.43, "timestamp": "01:28:15", "text": "正在玩。"}, {"type": "subtitle", "time": 5299.27, "timestamp": "01:28:19", "text": "好的。好的。就是这样。是的。所以，如果"}, {"type": "subtitle", "time": 5300.709, "timestamp": "01:28:20", "text": "我回到源神城，我不会……"}, {"type": "subtitle", "time": 5301.83, "timestamp": "01:28:21", "text": "明白发生了什么，因为我"}, {"type": "subtitle", "time": 5303.83, "timestamp": "01:28:23", "text": "账户已经像取得了一些进展。"}, {"type": "subtitle", "time": 5308.35, "timestamp": "01:28:28", "text": "一点。对我来说也不够。"}, {"type": "subtitle", "time": 5312.31, "timestamp": "01:28:32", "text": "仍然想玩。我不知道"}, {"type": "subtitle", "time": 5314.149, "timestamp": "01:28:34", "text": "如何解释呢？我没有"}, {"type": "subtitle", "time": 5316.149, "timestamp": "01:28:36", "text": "知识。我已经走得太远了"}, {"type": "subtitle", "time": 5317.75, "timestamp": "01:28:37", "text": "教程对我没用了，而且"}, {"type": "subtitle", "time": 5319.189, "timestamp": "01:28:39", "text": "不想再创建另一个账号，因为"}, {"type": "subtitle", "time": 5321.95, "timestamp": "01:28:41", "text": "我已经取得了足够的进展，"}, {"type": "subtitle", "time": 5324.31, "timestamp": "01:28:44", "text": "我不想创建新账户。"}, {"type": "subtitle", "time": 5327.83, "timestamp": "01:28:47", "text": "你知道我的意思？啊，是的。是吗？"}, {"type": "subtitle", "time": 5330.55, "timestamp": "01:28:50", "text": "那是不是咔哒声？是的，那是咔哒声。"}, {"type": "subtitle", "time": 5332.51, "timestamp": "01:28:52", "text": "是的。"}, {"type": "subtitle", "time": 5334.709, "timestamp": "01:28:54", "text": "好的。因为它没反应。"}, {"type": "subtitle", "time": 5336.87, "timestamp": "01:28:56", "text": "我的头。我不会撒谎。我不"}, {"type": "subtitle", "time": 5338.39, "timestamp": "01:28:58", "text": "我完全听不懂我刚才说的任何一个字。"}]
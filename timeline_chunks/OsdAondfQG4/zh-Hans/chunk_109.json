[{"type": "subtitle", "time": 6545.03, "timestamp": "01:49:05", "text": "我？这不是我的错。他们太棒了"}, {"type": "subtitle", "time": 6548.55, "timestamp": "01:49:08", "text": "通过营销手段吸引我。"}, {"type": "subtitle", "time": 6556.07, "timestamp": "01:49:16", "text": "是的。哦，不。他们，他们，就是他们"}, {"type": "subtitle", "time": 6565.27, "timestamp": "01:49:25", "text": "英伟达不是英特尔旗下的公司吗？"}, {"type": "subtitle", "time": 6568.83, "timestamp": "01:49:28", "text": "等等，真的是这样吗？等待。"}, {"type": "subtitle", "time": 6572.229, "timestamp": "01:49:32", "text": "嗯？不。如果英伟达是英特尔旗下的公司，"}, {"type": "subtitle", "time": 6574.229, "timestamp": "01:49:34", "text": "那么他们为什么要生产英特尔显卡呢？"}, {"type": "subtitle", "time": 6581.91, "timestamp": "01:49:41", "text": "什么"}, {"type": "subtitle", "time": 6585.189, "timestamp": "01:49:45", "text": "有没有？是否有英特尔集成显卡？"}, {"type": "subtitle", "time": 6594.07, "timestamp": "01:49:54", "text": "有。是的，"}]
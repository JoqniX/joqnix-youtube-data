[{"type": "subtitle", "time": 15241.389, "timestamp": "04:14:01", "text": "海边就像有波浪一样"}, {"type": "subtitle", "time": 15246.63, "timestamp": "04:14:06", "text": "水试图弄湿我，弄湿我的脚，但是"}, {"type": "subtitle", "time": 15248.63, "timestamp": "04:14:08", "text": "我穿着鞋。我没有喜欢"}, {"type": "subtitle", "time": 15251.11, "timestamp": "04:14:11", "text": "拖鞋之类的东西。那不是给我的"}, {"type": "subtitle", "time": 15254.95, "timestamp": "04:14:14", "text": "我本来可以借拖鞋的。"}, {"type": "subtitle", "time": 15257.99, "timestamp": "04:14:17", "text": "还有一些其他的东西，但我也不知道。我有点"}, {"type": "subtitle", "time": 15261.75, "timestamp": "04:14:21", "text": "虽然我更想来这里游泳，"}, {"type": "subtitle", "time": 15263.67, "timestamp": "04:14:23", "text": "就像你知道的那样。但我认为"}, {"type": "subtitle", "time": 15266.75, "timestamp": "04:14:26", "text": "今天这样做是个好主意，因为"}, {"type": "subtitle", "time": 15270.59, "timestamp": "04:14:30", "text": "我的衣服又要湿了。那是一个"}, {"type": "subtitle", "time": 15274.87, "timestamp": "04:14:34", "text": "事物。我的天哪。我需要上去。那是一个"}, {"type": "subtitle", "time": 15278.59, "timestamp": "04:14:38", "text": "大潮。我的天哪。不是潮汐。那可是个大问题"}, {"type": "subtitle", "time": 15280.99, "timestamp": "04:14:40", "text": "海浪。是的。"}, {"type": "subtitle", "time": 15285.349, "timestamp": "04:14:45", "text": "再次。嗯，我刚才说到哪儿了？"}, {"type": "subtitle", "time": 15287.469, "timestamp": "04:14:47", "text": "那个人正盯着……"}, {"type": "subtitle", "time": 15291.07, "timestamp": "04:14:51", "text": "我。那个人正盯着……"}, {"type": "subtitle", "time": 15293.87, "timestamp": "04:14:53", "text": "我。你好，我又来了。"}, {"type": "subtitle", "time": 15297.67, "timestamp": "04:14:57", "text": "嗯，如果我真的要游泳的话……"}]
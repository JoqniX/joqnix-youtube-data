[{"type": "subtitle", "time": 15121.189, "timestamp": "04:12:01", "text": "是的。是的。你好，Snowy。欢迎，"}, {"type": "subtitle", "time": 15123.469, "timestamp": "04:12:03", "text": "欢迎。你怎么样"}, {"type": "subtitle", "time": 15125.99, "timestamp": "04:12:05", "text": "正在做？是的。正如我刚才所说，"}, {"type": "subtitle", "time": 15129.83, "timestamp": "04:12:09", "text": "真的，就像……嗯，把它们拿走了"}, {"type": "subtitle", "time": 15132.95, "timestamp": "04:12:12", "text": "送货竟然花了两个小时！"}, {"type": "subtitle", "time": 15135.75, "timestamp": "04:12:15", "text": "呃，比如食物之类的。还有什么"}, {"type": "subtitle", "time": 15137.67, "timestamp": "04:12:17", "text": "事情的经过是送货员……"}, {"type": "subtitle", "time": 15141.67, "timestamp": "04:12:21", "text": "小孩子什么的。他们就像"}, {"type": "subtitle", "time": 15143.349, "timestamp": "04:12:23", "text": "他们走错路了。"}, {"type": "subtitle", "time": 15145.429, "timestamp": "04:12:25", "text": "他们不知道方向。他们"}, {"type": "subtitle", "time": 15148.15, "timestamp": "04:12:28", "text": "东西丢了之类的。所以，呃，我的亲戚们"}, {"type": "subtitle", "time": 15149.87, "timestamp": "04:12:29", "text": "表兄弟姐妹们"}, {"type": "subtitle", "time": 15153.11, "timestamp": "04:12:33", "text": "不得不去取货"}, {"type": "subtitle", "time": 15156.07, "timestamp": "04:12:36", "text": "他们自己。"}, {"type": "subtitle", "time": 15158.389, "timestamp": "04:12:38", "text": "那很好笑。但那也很酷"}, {"type": "subtitle", "time": 15160.87, "timestamp": "04:12:40", "text": "尽管。就好像如果我……如果我……如果我回来了"}, {"type": "subtitle", "time": 15162.11, "timestamp": "04:12:42", "text": "家，我的"}, {"type": "subtitle", "time": 15164.71, "timestamp": "04:12:44", "text": "回家，就像真的会带他们回家一样。"}, {"type": "subtitle", "time": 15167.71, "timestamp": "04:12:47", "text": "大约六七分钟"}, {"type": "subtitle", "time": 15169.91, "timestamp": "04:12:49", "text": "可以从任何商店送货，例如"}, {"type": "subtitle", "time": 15171.59, "timestamp": "04:12:51", "text": "他们会像超级一样"}, {"type": "subtitle", "time": 15174.63, "timestamp": "04:12:54", "text": "快节奏之类的。"}, {"type": "subtitle", "time": 15176.71, "timestamp": "04:12:56", "text": "没错，这就是住在……的好处。"}]
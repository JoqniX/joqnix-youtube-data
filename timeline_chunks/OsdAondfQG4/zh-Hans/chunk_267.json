[{"type": "subtitle", "time": 16024.349, "timestamp": "04:27:04", "text": "任何事，因为我真的极少做。"}, {"type": "subtitle", "time": 16027.71, "timestamp": "04:27:07", "text": "那。所以，从某种意义上说，它就像是超高速。"}, {"type": "subtitle", "time": 16032.11, "timestamp": "04:27:12", "text": "像我这样的人很少会真的"}, {"type": "subtitle", "time": 16034.87, "timestamp": "04:27:14", "text": "哇，你已经用掉了100%的"}, {"type": "subtitle", "time": 16042.309, "timestamp": "04:27:22", "text": "超过。所以，嗯，这种情况确实比较少见。"}, {"type": "subtitle", "time": 16044.79, "timestamp": "04:27:24", "text": "让我实际上"}, {"type": "subtitle", "time": 16047.55, "timestamp": "04:27:27", "text": "呃，你知道走路"}, {"type": "subtitle", "time": 16050.87, "timestamp": "04:27:30", "text": "呃，它叫什么？我要去吗？"}, {"type": "subtitle", "time": 16052.99, "timestamp": "04:27:32", "text": "方向对吗？我真是太好了"}, {"type": "subtitle", "time": 16054.91, "timestamp": "04:27:34", "text": "使困惑。全部"}, {"type": "subtitle", "time": 16057.229, "timestamp": "04:27:37", "text": "正确的。但是，是的，我从来没有"}, {"type": "subtitle", "time": 16060.83, "timestamp": "04:27:40", "text": "我的天哪，沙子好重啊！"}, {"type": "subtitle", "time": 16064.229, "timestamp": "04:27:44", "text": "走。我好累。"}, {"type": "subtitle", "time": 16067.55, "timestamp": "04:27:47", "text": "我汗流浃背。我需要"}, {"type": "subtitle", "time": 16071.349, "timestamp": "04:27:51", "text": "我想要水，但我买不起水。我是我"}, {"type": "subtitle", "time": 16072.91, "timestamp": "04:27:52", "text": "没拿走我的墙"}, {"type": "subtitle", "time": 16079.95, "timestamp": "04:27:59", "text": "向上。糟了，情况不妙。天哪，我快要崩溃了！"}]
[{"type": "subtitle", "time": 15601.149, "timestamp": "04:20:01", "text": "预"}, {"type": "subtitle", "time": 15604.55, "timestamp": "04:20:04", "text": "7点钟。我本应该从……开始"}, {"type": "subtitle", "time": 15608.99, "timestamp": "04:20:08", "text": "6，但我呃，就像当我……"}, {"type": "subtitle", "time": 15613.269, "timestamp": "04:20:13", "text": "晚上，比如凌晨一点左右，眉毛会皱起来。"}, {"type": "subtitle", "time": 15615.91, "timestamp": "04:20:15", "text": "那场直播结束后大概过了12分钟左右"}, {"type": "subtitle", "time": 15618.71, "timestamp": "04:20:18", "text": "昨天视频直播结束后。"}, {"type": "subtitle", "time": 15621.83, "timestamp": "04:20:21", "text": "呃，我忘了。我以为已经插上电源了。"}, {"type": "subtitle", "time": 15625.79, "timestamp": "04:20:25", "text": "但显然它并不完全"}, {"type": "subtitle", "time": 15628.389, "timestamp": "04:20:28", "text": "已插电。我当时真是蠢透了，因为我"}, {"type": "subtitle", "time": 15629.63, "timestamp": "04:20:29", "text": "真是太"}, {"type": "subtitle", "time": 15633.349, "timestamp": "04:20:33", "text": "疲劳的。我当时太累了，所以我就那样做了。"}, {"type": "subtitle", "time": 15635.269, "timestamp": "04:20:35", "text": "不知情的情况下。如果可以，我就可以"}, {"type": "subtitle", "time": 15639.11, "timestamp": "04:20:39", "text": "我早上6点就开始散步了。"}, {"type": "subtitle", "time": 15644.63, "timestamp": "04:20:44", "text": "清晨，就像一个早晨。"}, {"type": "subtitle", "time": 15646.87, "timestamp": "04:20:46", "text": "微风拂面，感觉凉爽。将有"}, {"type": "subtitle", "time": 15650.469, "timestamp": "04:20:50", "text": "没有那么强烈的阳光"}, {"type": "subtitle", "time": 15651.229, "timestamp": "04:20:51", "text": "正确的"}, {"type": "subtitle", "time": 15654.03, "timestamp": "04:20:54", "text": "现在即便如此，"}]
[{"type": "subtitle", "time": 16860.31, "timestamp": "04:41:00", "text": "呃，今天。 Pia 1小时前点赞了。不，不是1"}, {"type": "subtitle", "time": 16863.27, "timestamp": "04:41:03", "text": "小时。 30分钟前或20分钟前。"}, {"type": "subtitle", "time": 16875.11, "timestamp": "04:41:15", "text": "热的。哇。有个家伙正在游泳。"}, {"type": "subtitle", "time": 16877.07, "timestamp": "04:41:17", "text": "或者他是在试图钓鱼？"}, {"type": "subtitle", "time": 16880.628, "timestamp": "04:41:20", "text": "网？凉爽的。"}, {"type": "subtitle", "time": 16893.83, "timestamp": "04:41:33", "text": "波浪。你知道我会怎么做吗？我会尽力"}, {"type": "subtitle", "time": 16898.07, "timestamp": "04:41:38", "text": "问问我爸或者把这件事告诉我。我会来的"}, {"type": "subtitle", "time": 16899.55, "timestamp": "04:41:39", "text": "这里，走"}, {"type": "subtitle", "time": 16901.75, "timestamp": "04:41:41", "text": "再次。我不会直播。我不认为我"}, {"type": "subtitle", "time": 16904.43, "timestamp": "04:41:44", "text": "应该直播。我再次来到这里"}, {"type": "subtitle", "time": 16909.708, "timestamp": "04:41:49", "text": "就像在海滩游个泳然后回来一样"}, {"type": "subtitle", "time": 16914.07, "timestamp": "04:41:54", "text": "家。我抓住了“不”，回去，喜欢整洁。"}, {"type": "subtitle", "time": 16918.788, "timestamp": "04:41:58", "text": "起来，准备好迎接什么？嗯，是的。"}]
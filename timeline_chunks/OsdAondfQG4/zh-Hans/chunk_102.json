[{"type": "subtitle", "time": 6120.229, "timestamp": "01:42:00", "text": "呃，我知道我刚开始的时候有"}, {"type": "subtitle", "time": 6123.189, "timestamp": "01:42:03", "text": "比我现在拥有的观众多得多。点赞"}, {"type": "subtitle", "time": 6126.87, "timestamp": "01:42:06", "text": "在 YouTube 上获得 20 次观看，就像其他观众一样"}, {"type": "subtitle", "time": 6128.99, "timestamp": "01:42:08", "text": "很有可能。"}, {"type": "subtitle", "time": 6131.149, "timestamp": "01:42:11", "text": "呃，"}, {"type": "subtitle", "time": 6134.55, "timestamp": "01:42:14", "text": "但是，我不知道。我只是觉得"}, {"type": "subtitle", "time": 6136.79, "timestamp": "01:42:16", "text": "现在就来体验更好的流媒体服务吧"}, {"type": "subtitle", "time": 6139.27, "timestamp": "01:42:19", "text": "因为"}, {"type": "subtitle", "time": 6141.59, "timestamp": "01:42:21", "text": "呃，现在在这里的这些人，他们"}, {"type": "subtitle", "time": 6143.43, "timestamp": "01:42:23", "text": "他们已经很久没来这里了。"}, {"type": "subtitle", "time": 6144.47, "timestamp": "01:42:24", "text": "他们从一开始就在这里。"}, {"type": "subtitle", "time": 6146.79, "timestamp": "01:42:26", "text": "就像从 YouTube 时代开始那样。"}, {"type": "subtitle", "time": 6148.79, "timestamp": "01:42:28", "text": "就是这样。比如我有一位名叫“否”的观众"}, {"type": "subtitle", "time": 6151.109, "timestamp": "01:42:31", "text": "夏威夷上帝。他在这里待了大概四年了。"}, {"type": "subtitle", "time": 6153.03, "timestamp": "01:42:33", "text": "或五年。"}, {"type": "subtitle", "time": 6154.99, "timestamp": "01:42:34", "text": "呃，每集都看。"}, {"type": "subtitle", "time": 6158.07, "timestamp": "01:42:38", "text": "直播间，来聊天室。"}, {"type": "subtitle", "time": 6159.99, "timestamp": "01:42:39", "text": "我现在拥有的观众都是后来来的。"}, {"type": "subtitle", "time": 6163.43, "timestamp": "01:42:43", "text": "就像去年那样四处赠送"}, {"type": "subtitle", "time": 6165.41, "timestamp": "01:42:45", "text": "或许更多"}, {"type": "subtitle", "time": 6170.91, "timestamp": "01:42:50", "text": "[音乐]"}]
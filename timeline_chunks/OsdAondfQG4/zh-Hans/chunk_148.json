[{"type": "subtitle", "time": 8885.349, "timestamp": "02:28:05", "text": "正如你所说，“合作”这个词是"}, {"type": "subtitle", "time": 8887.19, "timestamp": "02:28:07", "text": "商店。"}, {"type": "subtitle", "time": 8889.27, "timestamp": "02:28:09", "text": "我觉得应该说它像个聚会场所"}, {"type": "subtitle", "time": 8891.59, "timestamp": "02:28:11", "text": "反而。"}, {"type": "subtitle", "time": 8892.95, "timestamp": "02:28:12", "text": "是的。你想玩游戏吗？我要去"}, {"type": "subtitle", "time": 8894.71, "timestamp": "02:28:14", "text": "流式传输。"}, {"type": "subtitle", "time": 8895.99, "timestamp": "02:28:15", "text": "这次你愿意玩吗？我是"}, {"type": "subtitle", "time": 8902.23, "timestamp": "02:28:22", "text": "我不会撒谎。我将会是"}, {"type": "subtitle", "time": 8905.309, "timestamp": "02:28:25", "text": "流媒体。是的，我打算试试。"}, {"type": "subtitle", "time": 8907.59, "timestamp": "02:28:27", "text": "那。等等，它对新版本有效吗？"}, {"type": "subtitle", "time": 8909.67, "timestamp": "02:28:29", "text": "人们？"}, {"type": "subtitle", "time": 8911.51, "timestamp": "02:28:31", "text": "是的，很多。我心想，“嘿，你想……”"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "挂出？将会进行直播。"}, {"type": "subtitle", "time": 8916.71, "timestamp": "02:28:36", "text": "我在玩《Valerant》的时候遇到了很多 YouTuber。"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "事情就是这样开始的。"}, {"type": "subtitle", "time": 8921.75, "timestamp": "02:28:41", "text": "你想出来玩吗？我想成为"}, {"type": "subtitle", "time": 8923.27, "timestamp": "02:28:43", "text": "虽然是直播，但他们却说：“哦，"}, {"type": "subtitle", "time": 8924.63, "timestamp": "02:28:44", "text": "你也是个油管博主吗？这到底是怎么回事？"}, {"type": "subtitle", "time": 8934.03, "timestamp": "02:28:54", "text": "我不知道。我遇到了一些"}, {"type": "subtitle", "time": 8939.11, "timestamp": "02:28:59", "text": "他们真的是非常好的人。"}]
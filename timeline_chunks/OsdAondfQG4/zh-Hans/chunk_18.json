[{"type": "subtitle", "time": 1082.23, "timestamp": "00:18:02", "text": "那是粤语吗？我也这么认为。我不"}, {"type": "subtitle", "time": 1094.83, "timestamp": "00:18:14", "text": "任何人都能喝到的那种普通饮料是什么"}, {"type": "subtitle", "time": 1109.27, "timestamp": "00:18:29", "text": "我的天啊。他的中文真的很好。我"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "我想说，中国人"}, {"type": "subtitle", "time": 1113.669, "timestamp": "00:18:33", "text": "他给我讲的是日语，但我自己不讲。"}, {"type": "subtitle", "time": 1115.19, "timestamp": "00:18:35", "text": "知道。"}, {"type": "subtitle", "time": 1119.51, "timestamp": "00:18:39", "text": "真是滑稽。有趣的。"}, {"type": "subtitle", "time": 1121.83, "timestamp": "00:18:41", "text": "是的。"}, {"type": "subtitle", "time": 1125.35, "timestamp": "00:18:45", "text": "我猜我不知道。疯狂的。我的天啊。"}, {"type": "subtitle", "time": 1133.11, "timestamp": "00:18:53", "text": "你可以学习。你可以通过以下方式学习"}, {"type": "subtitle", "time": 1136.15, "timestamp": "00:18:56", "text": "想学习。我可以，我可以像……一样说话"}]
[{"type": "subtitle", "time": 15492.67, "timestamp": "04:18:12", "text": "它没有类似墨盒的东西。"}, {"type": "subtitle", "time": 15496.149, "timestamp": "04:18:16", "text": "就是你放进去的那个弹药装置"}, {"type": "subtitle", "time": 15499.03, "timestamp": "04:18:19", "text": "我跟别人说的那把手枪和那些东西"}, {"type": "subtitle", "time": 15501.269, "timestamp": "04:18:21", "text": "就像某人的……真的……"}, {"type": "subtitle", "time": 15505.11, "timestamp": "04:18:25", "text": "在海滩附近放一个钱包。"}, {"type": "subtitle", "time": 15507.83, "timestamp": "04:18:27", "text": "我们现在正在找兽医。"}, {"type": "subtitle", "time": 15511.07, "timestamp": "04:18:31", "text": "但我只是路过而已。"}, {"type": "subtitle", "time": 15513.469, "timestamp": "04:18:33", "text": "那里。但"}, {"type": "subtitle", "time": 15516.51, "timestamp": "04:18:36", "text": "是的。好的。是的。我不知道路"}, {"type": "subtitle", "time": 15527.349, "timestamp": "04:18:47", "text": "但是，当它变成 8 或 9 的时候……"}, {"type": "subtitle", "time": 15531.349, "timestamp": "04:18:51", "text": "早上会非常热"}, {"type": "subtitle", "time": 15533.87, "timestamp": "04:18:53", "text": "意思是，因为"}, {"type": "subtitle", "time": 15537.429, "timestamp": "04:18:57", "text": "阳光。他等太阳出来了。是的，"}, {"type": "subtitle", "time": 15539.189, "timestamp": "04:18:59", "text": "因为阳光照射，所以会有点……"}]
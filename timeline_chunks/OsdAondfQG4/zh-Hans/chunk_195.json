[{"type": "subtitle", "time": 11710.67, "timestamp": "03:15:10", "text": "我很高兴很久以前就给他们发了私信。"}, {"type": "subtitle", "time": 11730.75, "timestamp": "03:15:30", "text": "呃"}, {"type": "subtitle", "time": 11741.429, "timestamp": "03:15:41", "text": "我会被视为某人吗？"}, {"type": "subtitle", "time": 11744.469, "timestamp": "03:15:44", "text": "谁很执着又很坏？呃，我不知道。"}, {"type": "subtitle", "time": 11746.87, "timestamp": "03:15:46", "text": "我只是想尝试重新建立联系"}, {"type": "subtitle", "time": 11757.309, "timestamp": "03:15:57", "text": "2022年。是什么时候？"}]
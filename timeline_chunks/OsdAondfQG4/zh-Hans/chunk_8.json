[{"type": "subtitle", "time": 489.11, "timestamp": "00:08:09", "text": "是的，我的情况也一样。"}, {"type": "subtitle", "time": 492.23, "timestamp": "00:08:12", "text": "日本人也是。我知道，别说它"}, {"type": "subtitle", "time": 500.23, "timestamp": "00:08:20", "text": "但是，每当我和一个日本人在一起时"}, {"type": "subtitle", "time": 502.71, "timestamp": "00:08:22", "text": "懂日语的人"}, {"type": "subtitle", "time": 506.23, "timestamp": "00:08:26", "text": "有时候我会脱口而出这样的话"}, {"type": "subtitle", "time": 507.83, "timestamp": "00:08:27", "text": "虽然我不知道该说什么，"}, {"type": "subtitle", "time": 511.11, "timestamp": "00:08:31", "text": "但这是无意的，或者就像我很抱歉一样。"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "你的日语怎么样？我的日语水平真差。"}, {"type": "subtitle", "time": 527.59, "timestamp": "00:08:47", "text": "不，"}, {"type": "subtitle", "time": 530.07, "timestamp": "00:08:50", "text": "说实话，我不知道。我呃我"}, {"type": "subtitle", "time": 532.31, "timestamp": "00:08:52", "text": "我开始通过看电影学习日语"}, {"type": "subtitle", "time": 533.389, "timestamp": "00:08:53", "text": "动漫和"}, {"type": "subtitle", "time": 537.509, "timestamp": "00:08:57", "text": "比如日剧之类的。我"}]
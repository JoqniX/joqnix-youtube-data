[{"type": "subtitle", "time": 8221.11, "timestamp": "02:17:01", "text": "我直播的地方，然后他们就看到了"}, {"type": "subtitle", "time": 8227.79, "timestamp": "02:17:07", "text": "我想说很长很长一段时间。"}, {"type": "subtitle", "time": 8233.15, "timestamp": "02:17:13", "text": "因为是我，我在这里"}, {"type": "subtitle", "time": 8234.91, "timestamp": "02:17:14", "text": "至少"}, {"type": "subtitle", "time": 8237.91, "timestamp": "02:17:17", "text": "足够大的数字，以至于不会"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "叫它小小小，但我仍然"}, {"type": "subtitle", "time": 8244.19, "timestamp": "02:17:24", "text": "小，你"}, {"type": "subtitle", "time": 8248.07, "timestamp": "02:17:28", "text": "知道？但我猜，呃，我不知道"}, {"type": "chat", "time": 8248.571, "timestamp": "02:17:28", "author": "@yashchourasia2215", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mbRu2gYmpEUO4nLl0jA2optOzbTHvVFqZhza3dfpPmwg=s64-c-k-c0x00ffffff-no-rj", "message": "Yahalloo"}, {"type": "subtitle", "time": 8249.19, "timestamp": "02:17:29", "text": "别太担心这个。"}, {"type": "chat", "time": 8250.85, "timestamp": "02:17:30", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Yash Chourasia~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 8257.91, "timestamp": "02:17:37", "text": "但确实有人会过来，而且很喜欢。"}, {"type": "subtitle", "time": 8260.23, "timestamp": "02:17:40", "text": "比如说，“好像没人关注你。”"}, {"type": "subtitle", "time": 8262.549, "timestamp": "02:17:42", "text": "你在干什么？我管好自己的事。"}, {"type": "subtitle", "time": 8263.75, "timestamp": "02:17:43", "text": "我从事的是商业活动。为什么不呢？"}, {"type": "subtitle", "time": 8266.03, "timestamp": "02:17:46", "text": "你也管好你自己的事吧？你"}, {"type": "subtitle", "time": 8268.629, "timestamp": "02:17:48", "text": "我知道了，抱歉。"}, {"type": "subtitle", "time": 8277.75, "timestamp": "02:17:57", "text": "是的，没错。这是真的。是的。"}]
[{"type": "subtitle", "time": 5461.91, "timestamp": "01:31:01", "text": "游戏。和"}, {"type": "subtitle", "time": 5465.03, "timestamp": "01:31:05", "text": "回合制游戏有点难。"}, {"type": "subtitle", "time": 5466.629, "timestamp": "01:31:06", "text": "给我一个。我不会撒谎，因为我"}, {"type": "subtitle", "time": 5468.229, "timestamp": "01:31:08", "text": "有时候我喜欢让大脑放空。"}, {"type": "subtitle", "time": 5470.229, "timestamp": "01:31:10", "text": "我正在玩一款需要……的游戏"}, {"type": "subtitle", "time": 5477.91, "timestamp": "01:31:17", "text": "呃，它叫什么来着？是的。我不知道。"}, {"type": "subtitle", "time": 5479.99, "timestamp": "01:31:19", "text": "我喜欢玩各种各样的游戏。"}, {"type": "subtitle", "time": 5483.03, "timestamp": "01:31:23", "text": "大部分情况下。种类。"}, {"type": "subtitle", "time": 5484.95, "timestamp": "01:31:24", "text": "是的。我也是一样。"}, {"type": "subtitle", "time": 5487.51, "timestamp": "01:31:27", "text": "种类。"}, {"type": "subtitle", "time": 5490.229, "timestamp": "01:31:30", "text": "一开始我只会想，是啊，"}, {"type": "subtitle", "time": 5493.91, "timestamp": "01:31:33", "text": "第一人称射击游戏很有趣。快节奏的游戏"}, {"type": "subtitle", "time": 5495.75, "timestamp": "01:31:35", "text": "有趣等等。我就这么定了。"}, {"type": "subtitle", "time": 5498.149, "timestamp": "01:31:38", "text": "然后我意识到，尝试一下也没什么不好。"}, {"type": "subtitle", "time": 5500.149, "timestamp": "01:31:40", "text": "走出舒适区，拓展视野，尝试不同的事物"}, {"type": "subtitle", "time": 5503.03, "timestamp": "01:31:43", "text": "还有其他东西。"}, {"type": "subtitle", "time": 5504.83, "timestamp": "01:31:44", "text": "是的。"}, {"type": "subtitle", "time": 5509.43, "timestamp": "01:31:49", "text": "主播朋友们，就是那些在"}, {"type": "subtitle", "time": 5512.149, "timestamp": "01:31:52", "text": "是YouTube吧？我总是会看他们。"}, {"type": "subtitle", "time": 5515.11, "timestamp": "01:31:55", "text": "玩起来就像在玩随机游戏，仅此而已。"}, {"type": "subtitle", "time": 5516.709, "timestamp": "01:31:56", "text": "就像超级独立游戏，而且没人知道。"}, {"type": "subtitle", "time": 5519.11, "timestamp": "01:31:59", "text": "虽然它看起来很有趣，但实际上并非如此。"}]
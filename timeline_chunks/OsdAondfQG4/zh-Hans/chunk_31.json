[{"type": "subtitle", "time": 1860.07, "timestamp": "00:31:00", "text": "印度来自印度。你好。你好。如何"}, {"type": "subtitle", "time": 1862.46, "timestamp": "00:31:02", "text": "你是？学校生活怎么样？"}, {"type": "subtitle", "time": 1864.47, "timestamp": "00:31:04", "text": "[音乐]"}, {"type": "subtitle", "time": 1866.11, "timestamp": "00:31:06", "text": "你好。我是"}, {"type": "subtitle", "time": 1882.789, "timestamp": "00:31:22", "text": "英语。更多英语单词。那些"}, {"type": "subtitle", "time": 1886.389, "timestamp": "00:31:26", "text": "那边的人都在说英语。"}, {"type": "subtitle", "time": 1909.99, "timestamp": "00:31:49", "text": "我不叫我印度人，对吧？"}]
[{"type": "subtitle", "time": 7202.39, "timestamp": "02:00:02", "text": "如果从物理学的角度来讨论，那没问题。"}, {"type": "subtitle", "time": 7204.229, "timestamp": "02:00:04", "text": "好的。如果我说得太深入了，请见谅。"}, {"type": "subtitle", "time": 7207.109, "timestamp": "02:00:07", "text": "比如喜欢研究高智商学科。对不起。"}, {"type": "subtitle", "time": 7209.83, "timestamp": "02:00:09", "text": "但就物理学而言，那些相信这一点的人"}, {"type": "subtitle", "time": 7211.99, "timestamp": "02:00:11", "text": "就像喜欢收集的太空清洁工一样"}, {"type": "subtitle", "time": 7213.709, "timestamp": "02:00:13", "text": "用于除尘"}, {"type": "subtitle", "time": 7216.229, "timestamp": "02:00:16", "text": "他们。它不起作用。那东西"}, {"type": "subtitle", "time": 7217.83, "timestamp": "02:00:17", "text": "行不通。别那样做。不要买"}, {"type": "subtitle", "time": 7219.669, "timestamp": "02:00:19", "text": "那。呃，你肯定只想……"}, {"type": "subtitle", "time": 7221.87, "timestamp": "02:00:21", "text": "拿个掸子把所有东西都掸一遍。"}, {"type": "subtitle", "time": 7224.669, "timestamp": "02:00:24", "text": "你自己"}, {"type": "subtitle", "time": 7229.39, "timestamp": "02:00:29", "text": "因为旁边放着一个小风扇"}, {"type": "subtitle", "time": 7232.95, "timestamp": "02:00:32", "text": "上床睡觉，然后像吸东西一样把东西吸进去，这不是吗？"}, {"type": "subtitle", "time": 7236.35, "timestamp": "02:00:36", "text": "打算做任何类似的事情"}, {"type": "subtitle", "time": 7240.51, "timestamp": "02:00:40", "text": "去打扫，去打扫。"}, {"type": "subtitle", "time": 7244.189, "timestamp": "02:00:44", "text": "但是，你知道的"}, {"type": "subtitle", "time": 7246.51, "timestamp": "02:00:46", "text": "呃，我"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "就像你无处可去一样"}, {"type": "subtitle", "time": 7250.47, "timestamp": "02:00:50", "text": "这样房间里就不会积灰，因为"}, {"type": "subtitle", "time": 7251.31, "timestamp": "02:00:51", "text": "有"}, {"type": "subtitle", "time": 7255.51, "timestamp": "02:00:55", "text": "灰尘无处可去，无法漂浮"}, {"type": "subtitle", "time": 7257.75, "timestamp": "02:00:57", "text": "因为房间里没有空气。所以如果"}]
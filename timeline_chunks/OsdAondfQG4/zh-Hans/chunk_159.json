[{"type": "subtitle", "time": 9541.67, "timestamp": "02:39:01", "text": "一个半小时前。一个小时"}, {"type": "subtitle", "time": 9543.309, "timestamp": "02:39:03", "text": "一半。是的。是的。"}, {"type": "subtitle", "time": 9546.71, "timestamp": "02:39:06", "text": "是的。是的。当时是下午两三点。为你，"}, {"type": "subtitle", "time": 9548.309, "timestamp": "02:39:08", "text": "正确的？"}, {"type": "subtitle", "time": 9552.23, "timestamp": "02:39:12", "text": "是的。该死。我的意思是，我通常都是醒着的。"}, {"type": "subtitle", "time": 9554.309, "timestamp": "02:39:14", "text": "有时候就是这样。"}, {"type": "subtitle", "time": 9556.71, "timestamp": "02:39:16", "text": "只是，呃，碰巧发生在我身上，我没有"}, {"type": "subtitle", "time": 9560.23, "timestamp": "02:39:20", "text": "今天有工作。嗯。幸运的。"}, {"type": "subtitle", "time": 9563.11, "timestamp": "02:39:23", "text": "谢谢你今天陪我，马斯卡尔。那是"}, {"type": "subtitle", "time": 9565.03, "timestamp": "02:39:25", "text": "很高兴能和你叙旧。"}, {"type": "subtitle", "time": 9566.87, "timestamp": "02:39:26", "text": "讲话。"}, {"type": "subtitle", "time": 9568.469, "timestamp": "02:39:28", "text": "是吗？我不知道。我觉得我只是"}, {"type": "subtitle", "time": 9570.63, "timestamp": "02:39:30", "text": "他滔滔不绝地说着，而你只是听着。不，不"}, {"type": "subtitle", "time": 9573.19, "timestamp": "02:39:33", "text": "不，不，不。没关系。我有时"}, {"type": "subtitle", "time": 9575.59, "timestamp": "02:39:35", "text": "启用我的主动聆听模式"}, {"type": "subtitle", "time": 9578.79, "timestamp": "02:39:38", "text": "找个理由，别再多说话了。"}, {"type": "subtitle", "time": 9581.11, "timestamp": "02:39:41", "text": "所以，就像我喜欢听什么"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "另一个人正在说并理解他们"}, {"type": "subtitle", "time": 9586.71, "timestamp": "02:39:46", "text": "这显然是一个特殊的时刻。对，那是我。"}, {"type": "subtitle", "time": 9588.389, "timestamp": "02:39:48", "text": "我想，我可能也有错。"}, {"type": "subtitle", "time": 9591.03, "timestamp": "02:39:51", "text": "因为我开始胡言乱语了，"}, {"type": "subtitle", "time": 9593.67, "timestamp": "02:39:53", "text": "没有给回应的机会。哦，不！"}, {"type": "subtitle", "time": 9597.19, "timestamp": "02:39:57", "text": "没关系。没关系。我很喜欢。"}]
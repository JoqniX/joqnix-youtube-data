[{"type": "subtitle", "time": 4082.47, "timestamp": "01:08:02", "text": "突袭。是的，突袭地牢"}, {"type": "subtitle", "time": 4085.789, "timestamp": "01:08:05", "text": "东西。地牢。是的。是的。"}, {"type": "subtitle", "time": 4089.43, "timestamp": "01:08:09", "text": "是的。我的天啊。国家就在那里。芒果"}, {"type": "subtitle", "time": 4091.109, "timestamp": "01:08:11", "text": "留了下来。"}, {"type": "subtitle", "time": 4095.829, "timestamp": "01:08:15", "text": "是的。是的。我想念州政府。他也曾是"}, {"type": "subtitle", "time": 4099.669, "timestamp": "01:08:19", "text": "此后一直活跃至今。"}, {"type": "subtitle", "time": 4106.309, "timestamp": "01:08:26", "text": "是的。好久没见到他了。超过"}, {"type": "subtitle", "time": 4109.99, "timestamp": "01:08:29", "text": "我想大概两年吧。是的。我也是。"}, {"type": "subtitle", "time": 4112.149, "timestamp": "01:08:32", "text": "他几乎没能完全摆脱投篮。我认为"}, {"type": "subtitle", "time": 4122.55, "timestamp": "01:08:42", "text": "希望你一切都好。"}, {"type": "subtitle", "time": 4125.149, "timestamp": "01:08:45", "text": "希望他一切都好。"}, {"type": "subtitle", "time": 4128.789, "timestamp": "01:08:48", "text": "是的。那么，呃，一切都怎么样了？"}, {"type": "subtitle", "time": 4131.969, "timestamp": "01:08:51", "text": "你之后一直都这样吗？我有点错过了"}, {"type": "subtitle", "time": 4133.47, "timestamp": "01:08:53", "text": "[音乐]"}, {"type": "subtitle", "time": 4136.07, "timestamp": "01:08:56", "text": "一切。你终于得到了你的"}, {"type": "subtitle", "time": 4139.11, "timestamp": "01:08:59", "text": "模型之类的东西，对吧？一款新模型。"}]
[{"type": "subtitle", "time": 7143.39, "timestamp": "01:59:03", "text": "呃，我内心快要崩溃了，因为……"}, {"type": "subtitle", "time": 7145.189, "timestamp": "01:59:05", "text": "打喷嚏。"}, {"type": "subtitle", "time": 7150.229, "timestamp": "01:59:10", "text": "哦，是啊，是啊，是啊。不，我在打喷嚏。"}, {"type": "subtitle", "time": 7153.27, "timestamp": "01:59:13", "text": "是的，我在打喷嚏。"}, {"type": "subtitle", "time": 7155.91, "timestamp": "01:59:15", "text": "我认为这是一个征兆。不，问题是"}, {"type": "subtitle", "time": 7159.669, "timestamp": "01:59:19", "text": "我确实会清理办公桌什么的，但是……"}, {"type": "subtitle", "time": 7163.229, "timestamp": "01:59:23", "text": "是的，时不时会有更多灰尘到来。"}, {"type": "subtitle", "time": 7165.75, "timestamp": "01:59:25", "text": "哇。"}, {"type": "subtitle", "time": 7169.91, "timestamp": "01:59:29", "text": "不，我也有这种感觉。是的。你如何"}, {"type": "subtitle", "time": 7173.99, "timestamp": "01:59:33", "text": "防止这种情况从“喜欢”那里发生。"}, {"type": "subtitle", "time": 7177.51, "timestamp": "01:59:37", "text": "注册频率过高？"}, {"type": "subtitle", "time": 7187.27, "timestamp": "01:59:47", "text": "那是指良好的通风吗？"}, {"type": "subtitle", "time": 7189.669, "timestamp": "01:59:49", "text": "哦，通风系统。"}, {"type": "subtitle", "time": 7191.87, "timestamp": "01:59:51", "text": "但这样做很难。"}, {"type": "subtitle", "time": 7194.27, "timestamp": "01:59:54", "text": "那。所以我想"}, {"type": "subtitle", "time": 7196.79, "timestamp": "01:59:56", "text": "就像人们会购买的人一样。我不"}, {"type": "subtitle", "time": 7197.87, "timestamp": "01:59:57", "text": "知道。"}]
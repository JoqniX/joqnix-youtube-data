[{"type": "subtitle", "time": 2520.069, "timestamp": "00:42:00", "text": "哦，等等。你找到人了吗？"}, {"type": "subtitle", "time": 2531.87, "timestamp": "00:42:11", "text": "我"}, {"type": "subtitle", "time": 2540.069, "timestamp": "00:42:20", "text": "等待。你今天还没跟女生说话吗？"}, {"type": "subtitle", "time": 2545.109, "timestamp": "00:42:25", "text": "哦，是的。是的，你可以找人谈谈。"}, {"type": "subtitle", "time": 2550.67, "timestamp": "00:42:30", "text": "你是。没关系。我喜欢。我喜欢"}, {"type": "subtitle", "time": 2554.87, "timestamp": "00:42:34", "text": "这。我不想和他们说话。"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "你好。"}, {"type": "subtitle", "time": 2559.67, "timestamp": "00:42:39", "text": "我也很害羞，所以我不知道该怎么做。"}]
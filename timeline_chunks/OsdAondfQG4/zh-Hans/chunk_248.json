[{"type": "subtitle", "time": 14880.71, "timestamp": "04:08:00", "text": "糟糕，狗狗跟着我了。我是"}, {"type": "subtitle", "time": 14882.79, "timestamp": "04:08:02", "text": "害怕的。它们正在产生影响。哦，我的"}, {"type": "subtitle", "time": 14885.75, "timestamp": "04:08:05", "text": "上帝。我的天啊。你是吗？我的天哪，我是"}, {"type": "subtitle", "time": 14887.55, "timestamp": "04:08:07", "text": "害怕的。我很害怕。我很害怕。"}, {"type": "subtitle", "time": 14890.16, "timestamp": "04:08:10", "text": "来了。他们正在查看"}, {"type": "subtitle", "time": 14892.51, "timestamp": "04:08:12", "text": "[音乐]"}, {"type": "subtitle", "time": 14895.99, "timestamp": "04:08:15", "text": "我。天哪，这里有五条狗。不，六。 1 2"}, {"type": "subtitle", "time": 14899.269, "timestamp": "04:08:19", "text": "3 4 5 六。七个。这条狗"}, {"type": "subtitle", "time": 14902.75, "timestamp": "04:08:22", "text": "盯着我看。是的。"}, {"type": "subtitle", "time": 14905.309, "timestamp": "04:08:25", "text": "再见。哦"}, {"type": "subtitle", "time": 14912.87, "timestamp": "04:08:32", "text": "船。我这就完成了。好的。我认为"}, {"type": "subtitle", "time": 14915.429, "timestamp": "04:08:35", "text": "这是渔民们……的地方"}, {"type": "subtitle", "time": 14917.79, "timestamp": "04:08:37", "text": "船只和物品，他们的渔网和"}, {"type": "subtitle", "time": 14920.469, "timestamp": "04:08:40", "text": "东西。等等，为什么它说你有"}, {"type": "subtitle", "time": 14923.59, "timestamp": "04:08:43", "text": "手机电量使用率达到50%了吗？等等，什么？"}, {"type": "subtitle", "time": 14925.71, "timestamp": "04:08:45", "text": "嘿，什么？"}, {"type": "subtitle", "time": 14928.469, "timestamp": "04:08:48", "text": "什么？我出门在外时需要网络。"}, {"type": "subtitle", "time": 14931.429, "timestamp": "04:08:51", "text": "后退。我的天啊。你在开玩笑吧"}, {"type": "subtitle", "time": 14932.99, "timestamp": "04:08:52", "text": "正确的"}, {"type": "subtitle", "time": 14936.71, "timestamp": "04:08:56", "text": "现在？你现在是在跟我开玩笑吗？所以"}, {"type": "subtitle", "time": 14939.83, "timestamp": "04:08:59", "text": "这意味着如果我回到火车上，我"}]
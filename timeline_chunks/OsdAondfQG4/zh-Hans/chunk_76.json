[{"type": "subtitle", "time": 4561.03, "timestamp": "01:16:01", "text": "我要添加到“喜欢”菜单中的内容"}, {"type": "subtitle", "time": 4563.189, "timestamp": "01:16:03", "text": "诸如此类的事情。是的，我做了"}, {"type": "subtitle", "time": 4566.149, "timestamp": "01:16:06", "text": "有一点点。那很好。原谅"}, {"type": "subtitle", "time": 4568.31, "timestamp": "01:16:08", "text": "我。"}, {"type": "subtitle", "time": 4571.03, "timestamp": "01:16:11", "text": "很有趣。很有趣。尤其是最后"}, {"type": "subtitle", "time": 4572.669, "timestamp": "01:16:12", "text": "SMP。就像"}, {"type": "subtitle", "time": 4578.11, "timestamp": "01:16:18", "text": "嗯……一款基于多人在线角色扮演游戏（MMO RPG）的SMP游戏。"}, {"type": "subtitle", "time": 4581.91, "timestamp": "01:16:21", "text": "哦，拥有类似的法术和类似的属性，"}, {"type": "subtitle", "time": 4584.63, "timestamp": "01:16:24", "text": "东西。是的。我不知道你是否"}, {"type": "subtitle", "time": 4587.27, "timestamp": "01:16:27", "text": "知道它是什么。史诗级战斗模组。"}, {"type": "subtitle", "time": 4589.75, "timestamp": "01:16:29", "text": "一场精彩绝伦的战斗。"}, {"type": "subtitle", "time": 4592.63, "timestamp": "01:16:32", "text": "是的，这是一个战斗相关的模组。"}, {"type": "subtitle", "time": 4595.79, "timestamp": "01:16:35", "text": "就像上古环一样。"}, {"type": "subtitle", "time": 4599.11, "timestamp": "01:16:39", "text": "哦，那你和谁打仗？像世界"}, {"type": "subtitle", "time": 4601.87, "timestamp": "01:16:41", "text": "老板？"}, {"type": "subtitle", "time": 4605.43, "timestamp": "01:16:45", "text": "嗯，有很多东西我都喜欢。"}, {"type": "subtitle", "time": 4607.75, "timestamp": "01:16:47", "text": "他们改变了普通的暴徒。他们"}, {"type": "subtitle", "time": 4609.83, "timestamp": "01:16:49", "text": "互相攻击还是不互相攻击。"}, {"type": "subtitle", "time": 4611.47, "timestamp": "01:16:51", "text": "他们会像这样攻击你"}, {"type": "subtitle", "time": 4613.669, "timestamp": "01:16:53", "text": "它们来自艾伦·林。他们"}, {"type": "subtitle", "time": 4615.27, "timestamp": "01:16:55", "text": "他们先出拳，然后躲闪之类的。"}, {"type": "subtitle", "time": 4618.39, "timestamp": "01:16:58", "text": "那。哇。我不知道。你，它是，它是"}, {"type": "subtitle", "time": 4619.83, "timestamp": "01:16:59", "text": "不亲眼看到很难解释。"}]
[{"type": "subtitle", "time": 12061.269, "timestamp": "03:21:01", "text": "虽然有很多话题，但从某种意义上说，它是"}, {"type": "subtitle", "time": 12065.07, "timestamp": "03:21:05", "text": "像挂"}, {"type": "subtitle", "time": 12099.19, "timestamp": "03:21:39", "text": "好的。我觉得我确实联系了所有人。"}, {"type": "subtitle", "time": 12101.389, "timestamp": "03:21:41", "text": "单身的"}, {"type": "subtitle", "time": 12104.63, "timestamp": "03:21:44", "text": "人们。现在我敞开大门"}, {"type": "subtitle", "time": 12107.15, "timestamp": "03:21:47", "text": "对于新人来说"}]
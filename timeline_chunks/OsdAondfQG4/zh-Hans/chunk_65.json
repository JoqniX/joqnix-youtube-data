[{"type": "subtitle", "time": 3901.67, "timestamp": "01:05:01", "text": "呼叫你好。"}, {"type": "subtitle", "time": 3905.67, "timestamp": "01:05:05", "text": "你好。你好，Mascar。已经过了很久了。"}, {"type": "subtitle", "time": 3907.99, "timestamp": "01:05:07", "text": "你好吗？"}, {"type": "subtitle", "time": 3909.91, "timestamp": "01:05:09", "text": "我很好。"}, {"type": "subtitle", "time": 3912.549, "timestamp": "01:05:12", "text": "兄弟，你好吗？我好想你。"}, {"type": "subtitle", "time": 3917.109, "timestamp": "01:05:17", "text": "你觉得一切都好吗？"}, {"type": "subtitle", "time": 3919.589, "timestamp": "01:05:19", "text": "一切都很好。"}, {"type": "subtitle", "time": 3923.109, "timestamp": "01:05:23", "text": "相同的。我感觉，呃，压力超级大，但是"}, {"type": "subtitle", "time": 3933.829, "timestamp": "01:05:33", "text": "幸存者。所以，呃，等等，我们……我们……"}, {"type": "subtitle", "time": 3935.589, "timestamp": "01:05:35", "text": "选个游戏什么的？我 我"}, {"type": "subtitle", "time": 3938.549, "timestamp": "01:05:38", "text": "完全忘记了。"}, {"type": "subtitle", "time": 3942.47, "timestamp": "01:05:42", "text": "我的天哪，我们没有……你想……"}, {"type": "subtitle", "time": 3944.309, "timestamp": "01:05:44", "text": "聊聊，还是你想聊聊？"}, {"type": "subtitle", "time": 3946.789, "timestamp": "01:05:46", "text": "你想追赶进度还是想玩游戏？"}, {"type": "subtitle", "time": 3950.63, "timestamp": "01:05:50", "text": "说话的时候或者其他什么时候？"}, {"type": "subtitle", "time": 3951.67, "timestamp": "01:05:51", "text": "我不知道。我真的不会……"}, {"type": "subtitle", "time": 3952.87, "timestamp": "01:05:52", "text": "因为是直播，所以我真的不知道该怎么办"}, {"type": "subtitle", "time": 3958.23, "timestamp": "01:05:58", "text": "你有什么计划？"}]
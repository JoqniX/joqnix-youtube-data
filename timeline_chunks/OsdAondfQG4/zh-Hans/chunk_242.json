[{"type": "subtitle", "time": 14520.63, "timestamp": "04:02:00", "text": "海滨。是的。但我从未到过这里"}, {"type": "subtitle", "time": 14521.71, "timestamp": "04:02:01", "text": "远的"}, {"type": "subtitle", "time": 14535.67, "timestamp": "04:02:15", "text": "等待。我接到一个电话。等待，"}, {"type": "subtitle", "time": 14538.99, "timestamp": "04:02:18", "text": "等等，等等。我应该静音，对吧？"}, {"type": "subtitle", "time": 14540.67, "timestamp": "04:02:20", "text": "等待。哦，"}, {"type": "subtitle", "time": 14544.67, "timestamp": "04:02:24", "text": "等待。哦。哦，等等。哦，"}, {"type": "subtitle", "time": 14547.07, "timestamp": "04:02:27", "text": "等待。等等，等等，"}, {"type": "subtitle", "time": 14562.429, "timestamp": "04:02:42", "text": "什么？好的。"}, {"type": "subtitle", "time": 14572.55, "timestamp": "04:02:52", "text": "你好。我的意思是，当我出去散步的时候，"}, {"type": "subtitle", "time": 14575.83, "timestamp": "04:02:55", "text": "我确实告诉过我那个混蛋，我是"}, {"type": "subtitle", "time": 14577.99, "timestamp": "04:02:57", "text": "出去散步。他当时就说：“在哪儿？”"}]
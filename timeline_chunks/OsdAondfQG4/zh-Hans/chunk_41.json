[{"type": "subtitle", "time": 2466.63, "timestamp": "00:41:06", "text": "哦，是的。"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "担心。她开始训练了。"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "呃，你想，你想搬到那边去。"}, {"type": "subtitle", "time": 2479.41, "timestamp": "00:41:19", "text": "还是别的什么？"}, {"type": "subtitle", "time": 2492.71, "timestamp": "00:41:32", "text": "嗯，我在听。是的。是的。是的。"}, {"type": "subtitle", "time": 2496.63, "timestamp": "00:41:36", "text": "我玩这个游戏。我玩这个游戏是为了"}, {"type": "subtitle", "time": 2500.15, "timestamp": "00:41:40", "text": "正在听。咒骂声。"}, {"type": "subtitle", "time": 2512.09, "timestamp": "00:41:52", "text": "我感觉不太好。"}]
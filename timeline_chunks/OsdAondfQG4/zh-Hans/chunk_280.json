[{"type": "subtitle", "time": 16800.788, "timestamp": "04:40:00", "text": "哦，是的。是的。过了这个地方之后，对吧？"}, {"type": "subtitle", "time": 16807.788, "timestamp": "04:40:07", "text": "好的。"}, {"type": "subtitle", "time": 16811.03, "timestamp": "04:40:11", "text": "再见。那是螃蟹的老巢。"}, {"type": "subtitle", "time": 16814.99, "timestamp": "04:40:14", "text": "所以，它就像一只白色的螃蟹。"}, {"type": "subtitle", "time": 16818.47, "timestamp": "04:40:18", "text": "这里。是的。我不知道，我不知道"}, {"type": "subtitle", "time": 16821.19, "timestamp": "04:40:21", "text": "白蟹确实存在。我只知道就像"}, {"type": "subtitle", "time": 16823.59, "timestamp": "04:40:23", "text": "一只红螃蟹之类的东西。那是……"}, {"type": "subtitle", "time": 16826.47, "timestamp": "04:40:26", "text": "龙虾？我不知道。等等，什么颜色？"}, {"type": "subtitle", "time": 16828.11, "timestamp": "04:40:28", "text": "螃蟹会……吗？"}, {"type": "subtitle", "time": 16831.91, "timestamp": "04:40:31", "text": "喜欢？是的，我玩过螃蟹游戏。"}, {"type": "subtitle", "time": 16835.51, "timestamp": "04:40:35", "text": "所以，它是红色的，对吧？我从我的"}, {"type": "subtitle", "time": 16838.708, "timestamp": "04:40:38", "text": "当地鱼市的鱼和家里的鱼"}, {"type": "subtitle", "time": 16840.948, "timestamp": "04:40:40", "text": "在我家。就好像他们有这种感觉一样"}, {"type": "subtitle", "time": 16844.11, "timestamp": "04:40:44", "text": "棕色或深棕色"}, {"type": "subtitle", "time": 16845.788, "timestamp": "04:40:45", "text": "东西"}, {"type": "subtitle", "time": 16849.03, "timestamp": "04:40:49", "text": "螃蟹，然后我就看到了一只死螃蟹"}, {"type": "subtitle", "time": 16853.55, "timestamp": "04:40:53", "text": "像红色的成年螃蟹。没有死去的白人成年人"}, {"type": "subtitle", "time": 16856.868, "timestamp": "04:40:56", "text": "我走路的时候螃蟹"}]
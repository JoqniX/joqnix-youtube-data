[{"type": "subtitle", "time": 17520.83, "timestamp": "04:52:00", "text": "我回家了。"}, {"type": "subtitle", "time": 17523.27, "timestamp": "04:52:03", "text": "对，我今天早上有点想这么做。"}, {"type": "subtitle", "time": 17525.43, "timestamp": "04:52:05", "text": "走路的东西。这会很有趣，对吧？"}, {"type": "subtitle", "time": 17527.47, "timestamp": "04:52:07", "text": "由于我将进行直播，"}, {"type": "subtitle", "time": 17530.15, "timestamp": "04:52:10", "text": "自从我尝到味道以来，一切都变了。"}, {"type": "subtitle", "time": 17531.15, "timestamp": "04:52:11", "text": "移动的"}, {"type": "subtitle", "time": 17535.35, "timestamp": "04:52:15", "text": "流媒体播放，这会很有趣。"}, {"type": "subtitle", "time": 17538.948, "timestamp": "04:52:18", "text": "散步，还有溪流。你知道什么是"}, {"type": "subtitle", "time": 17541.55, "timestamp": "04:52:21", "text": "做这件事的最佳时机"}, {"type": "subtitle", "time": 17544.31, "timestamp": "04:52:24", "text": "溪流？等等，你什么意思？ 50%"}, {"type": "subtitle", "time": 17547.67, "timestamp": "04:52:27", "text": "每天付钱的木头。哦不，我想"}, {"type": "subtitle", "time": 17549.15, "timestamp": "04:52:29", "text": "我需要结束"}, {"type": "subtitle", "time": 17553.31, "timestamp": "04:52:33", "text": "尽快直播。你知道吗？"}, {"type": "subtitle", "time": 17556.47, "timestamp": "04:52:36", "text": "3500比特率。它消耗大量移动数据"}, {"type": "subtitle", "time": 17559.75, "timestamp": "04:52:39", "text": "数据。这很糟糕。坏的。我需要一部手机"}, {"type": "subtitle", "time": 17562.39, "timestamp": "04:52:42", "text": "我回家后会提供数据。不。回到……"}, {"type": "subtitle", "time": 17565.27, "timestamp": "04:52:45", "text": "火车。大概要开4个小时的车。我需要一个"}, {"type": "subtitle", "time": 17567.15, "timestamp": "04:52:47", "text": "手表。我需要一个"}, {"type": "subtitle", "time": 17570.15, "timestamp": "04:52:50", "text": "手表。我需要听几首歌。"}, {"type": "subtitle", "time": 17572.39, "timestamp": "04:52:52", "text": "不，不。你知道我一直在做什么。"}, {"type": "subtitle", "time": 17575.59, "timestamp": "04:52:55", "text": "最近每天都这样吗？我一直只是"}, {"type": "subtitle", "time": 17577.83, "timestamp": "04:52:57", "text": "听音乐。如果你有"}, {"type": "subtitle", "time": 17579.708, "timestamp": "04:52:59", "text": "一直在跟踪我"}]
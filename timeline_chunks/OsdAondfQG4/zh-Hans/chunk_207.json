[{"type": "subtitle", "time": 12437.91, "timestamp": "03:27:17", "text": "因为如果我记得对我来说，米奇和"}, {"type": "subtitle", "time": 12439.07, "timestamp": "03:27:19", "text": "你"}, {"type": "subtitle", "time": 12442.59, "timestamp": "03:27:22", "text": "我只保留了那个小组合作"}, {"type": "subtitle", "time": 12445.75, "timestamp": "03:27:25", "text": "是的，我们确实一起出去玩了，潘迪特。"}, {"type": "subtitle", "time": 12448.11, "timestamp": "03:27:28", "text": "合作之前"}, {"type": "subtitle", "time": 12452.07, "timestamp": "03:27:32", "text": "我们开始了英勇之旅，玩了一会儿。我愿意"}, {"type": "subtitle", "time": 12455.03, "timestamp": "03:27:35", "text": "想做个个人版的。我可能会"}, {"type": "subtitle", "time": 12457.67, "timestamp": "03:27:37", "text": "我得检查一下我是否有足够的空间。"}, {"type": "subtitle", "time": 12459.95, "timestamp": "03:27:39", "text": "临近尾声"}, {"type": "subtitle", "time": 12464.15, "timestamp": "03:27:44", "text": "上周推特。上周，也就是21号或"}, {"type": "subtitle", "time": 12467.389, "timestamp": "03:27:47", "text": "如果20号或19号有空位的话，我会……"}]
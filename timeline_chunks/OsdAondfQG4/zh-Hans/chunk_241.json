[{"type": "subtitle", "time": 14460.51, "timestamp": "04:01:00", "text": "不。那看起来像"}, {"type": "subtitle", "time": 14465.03, "timestamp": "04:01:05", "text": "那是什么？等等，我尽量不去想"}, {"type": "subtitle", "time": 14475.95, "timestamp": "04:01:15", "text": "某物。看起来像是有人推搡或"}, {"type": "subtitle", "time": 14480.349, "timestamp": "04:01:20", "text": "某物。就在沙滩上。"}, {"type": "subtitle", "time": 14500.75, "timestamp": "04:01:40", "text": "嗯，大的那些，对吧？"}, {"type": "subtitle", "time": 14503.67, "timestamp": "04:01:43", "text": "现在。这里还有一小片螃蟹海滩。"}, {"type": "subtitle", "time": 14506.229, "timestamp": "04:01:46", "text": "宝贝，我在这儿走。我在走路。哦"}, {"type": "subtitle", "time": 14507.95, "timestamp": "04:01:47", "text": "我的天哪，这太……"}, {"type": "subtitle", "time": 14511.15, "timestamp": "04:01:51", "text": "可爱的。小螃蟹"}, {"type": "subtitle", "time": 14514.95, "timestamp": "04:01:54", "text": "海滩。我其实不知道自己身在何处。"}, {"type": "subtitle", "time": 14518.03, "timestamp": "04:01:58", "text": "我只是沿着直线走。"}]
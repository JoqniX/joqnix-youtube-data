[{"type": "subtitle", "time": 6062.629, "timestamp": "01:41:02", "text": "继续前进。自从我学会了所有这些"}, {"type": "subtitle", "time": 6064.629, "timestamp": "01:41:04", "text": "这些东西我在高中就已经学过了。"}, {"type": "subtitle", "time": 6067.709, "timestamp": "01:41:07", "text": "大学时什么都知道。所以，"}, {"type": "subtitle", "time": 6072.55, "timestamp": "01:41:12", "text": "我不会说我失去了兴趣，但是……"}, {"type": "subtitle", "time": 6074.669, "timestamp": "01:41:14", "text": "这就像试图教……"}, {"type": "subtitle", "time": 6077.35, "timestamp": "01:41:17", "text": "一个15岁的孩子如何说英语"}, {"type": "subtitle", "time": 6085.43, "timestamp": "01:41:25", "text": "啊，我有点明白你的意思了。是的。"}, {"type": "subtitle", "time": 6095.59, "timestamp": "01:41:35", "text": "不，不，不。那么，流媒体的发展情况如何呢？"}, {"type": "subtitle", "time": 6098.07, "timestamp": "01:41:38", "text": "最近？"}, {"type": "subtitle", "time": 6100.47, "timestamp": "01:41:40", "text": "我爱我的观众们。他们人真好"}, {"type": "subtitle", "time": 6102.43, "timestamp": "01:41:42", "text": "我。"}, {"type": "subtitle", "time": 6106.229, "timestamp": "01:41:46", "text": "好吧，我的社区已经发生了变化。"}, {"type": "subtitle", "time": 6109.35, "timestamp": "01:41:49", "text": "多年来，陌生人突然出现"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "而且时不时会有点古怪"}, {"type": "subtitle", "time": 6117.03, "timestamp": "01:41:57", "text": "然后我现在就像"}]
[{"type": "subtitle", "time": 16921.03, "timestamp": "04:42:01", "text": "准备回家吧。是的。呃"}, {"type": "subtitle", "time": 16924.59, "timestamp": "04:42:04", "text": "下午3点前赶上火车。所有这些"}, {"type": "subtitle", "time": 16928.31, "timestamp": "04:42:08", "text": "胡闹。我试着游泳，并且很享受。"}, {"type": "subtitle", "time": 16931.35, "timestamp": "04:42:11", "text": "因为我做不到。这个"}, {"type": "subtitle", "time": 16934.55, "timestamp": "04:42:14", "text": "过来。我所做的就是像个傻瓜一样待着"}, {"type": "subtitle", "time": 16939.03, "timestamp": "04:42:19", "text": "在家。我喜欢做我平常做的事。"}, {"type": "subtitle", "time": 16942.31, "timestamp": "04:42:22", "text": "我在家做的事情，玩玩"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "用手机看动漫什么的"}, {"type": "subtitle", "time": 16948.27, "timestamp": "04:42:28", "text": "那"}, {"type": "subtitle", "time": 16953.11, "timestamp": "04:42:33", "text": "玩匈牙利游戏。我的天啊。"}, {"type": "subtitle", "time": 16954.948, "timestamp": "04:42:34", "text": "哦，说到这个，我没有做我的"}, {"type": "subtitle", "time": 16957.39, "timestamp": "04:42:37", "text": "每日恶搞。我会这么做。"}, {"type": "subtitle", "time": 16965.628, "timestamp": "04:42:45", "text": "等等，那婊子还剩了一些。"}, {"type": "subtitle", "time": 16969.23, "timestamp": "04:42:49", "text": "等等，我想我已经到达目的地了。"}, {"type": "subtitle", "time": 16972.708, "timestamp": "04:42:52", "text": "再次。这次我需要一个你知道吗？"}, {"type": "subtitle", "time": 16975.39, "timestamp": "04:42:55", "text": "我应该坐下来休息一会儿。然后我会"}]
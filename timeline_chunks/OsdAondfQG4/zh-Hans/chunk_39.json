[{"type": "subtitle", "time": 2350.67, "timestamp": "00:39:10", "text": "除了"}, {"type": "subtitle", "time": 2356.95, "timestamp": "00:39:16", "text": "中国人，你吃你吃食物。"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "我本不必停下来。太可爱了。"}, {"type": "subtitle", "time": 2367.349, "timestamp": "00:39:27", "text": "等等，等等，等等，等等，等等。"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "你虽然在我身边，但我并不总是这样。"}, {"type": "subtitle", "time": 2376.109, "timestamp": "00:39:36", "text": "训练。所以就像是……"}]
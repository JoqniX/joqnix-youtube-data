[{"type": "subtitle", "time": 13740.83, "timestamp": "03:49:00", "text": "就像我不知道你是否能听到……"}, {"type": "subtitle", "time": 13744.229, "timestamp": "03:49:04", "text": "海洋。不是海洋。嗯，海滩。呃，你"}, {"type": "subtitle", "time": 13745.95, "timestamp": "03:49:05", "text": "了解海浪情况"}, {"type": "subtitle", "time": 13748.55, "timestamp": "03:49:08", "text": "东西。我想，你叫什么来着？"}, {"type": "subtitle", "time": 13751.55, "timestamp": "03:49:11", "text": "这？水体海洋"}, {"type": "subtitle", "time": 13754.229, "timestamp": "03:49:14", "text": "正确的？今天是星期二，对吧？这是"}, {"type": "subtitle", "time": 13756.95, "timestamp": "03:49:16", "text": "周二。达。你好。"}, {"type": "subtitle", "time": 13760.63, "timestamp": "03:49:20", "text": "早上好。希望你一切都好。"}, {"type": "subtitle", "time": 13763.429, "timestamp": "03:49:23", "text": "是的。你好。我的手机几乎"}, {"type": "subtitle", "time": 13767.07, "timestamp": "03:49:27", "text": "即将坠落。我现在正在系我的"}, {"type": "subtitle", "time": 13769.71, "timestamp": "03:49:29", "text": "鞋带，这是正确的"}, {"type": "subtitle", "time": 13773.269, "timestamp": "03:49:33", "text": "鞋子好像解开了。不，不，它有点像"}, {"type": "subtitle", "time": 13775.07, "timestamp": "03:49:35", "text": "你怎么称呼它？"}, {"type": "subtitle", "time": 13779.429, "timestamp": "03:49:39", "text": "再次？鞋带，就是你系鞋带的时候那种感觉。"}, {"type": "subtitle", "time": 13783.469, "timestamp": "03:49:43", "text": "把它拉起来，就像解开系带一样。"}, {"type": "subtitle", "time": 13787.79, "timestamp": "03:49:47", "text": "本身。床。你管它叫什么？"}, {"type": "subtitle", "time": 13789.55, "timestamp": "03:49:49", "text": "那？好的"}, {"type": "subtitle", "time": 13791.95, "timestamp": "03:49:51", "text": "早晨。希望你今天过得愉快"}, {"type": "subtitle", "time": 13794.83, "timestamp": "03:49:54", "text": "今天。祝你今天一切顺利。"}, {"type": "subtitle", "time": 13798.55, "timestamp": "03:49:58", "text": "真是愚蠢。所以，是的，到明天我就会"}]
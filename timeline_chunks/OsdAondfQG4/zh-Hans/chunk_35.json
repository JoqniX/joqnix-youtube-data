[{"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "[音乐]"}, {"type": "subtitle", "time": 2115.109, "timestamp": "00:35:15", "text": "我喜欢我们现在这个小团队。我是"}, {"type": "subtitle", "time": 2117.349, "timestamp": "00:35:17", "text": "就像现在那些酷小孩一样。我的天啊。"}, {"type": "subtitle", "time": 2123.91, "timestamp": "00:35:23", "text": "我们周围的每个人都像小东西一样。"}, {"type": "subtitle", "time": 2126.95, "timestamp": "00:35:26", "text": "环己基基团。我也有一个自己的"}, {"type": "subtitle", "time": 2134.39, "timestamp": "00:35:34", "text": "天应该黑了。我的天啊。我们是"}, {"type": "subtitle", "time": 2143.51, "timestamp": "00:35:43", "text": "哦，"}, {"type": "subtitle", "time": 2145.75, "timestamp": "00:35:45", "text": "是的。"}, {"type": "subtitle", "time": 2147.829, "timestamp": "00:35:47", "text": "乔现在是学校里很酷的孩子之一了。是的。"}, {"type": "subtitle", "time": 2150.55, "timestamp": "00:35:50", "text": "慢慢来，慢慢来。"}, {"type": "subtitle", "time": 2153.99, "timestamp": "00:35:53", "text": "是的。是的。是的。你呢？"}, {"type": "subtitle", "time": 2156.47, "timestamp": "00:35:56", "text": "我是中国人。"}, {"type": "subtitle", "time": 2159.829, "timestamp": "00:35:59", "text": "哦，你们中国人。好的。给我看看"}]
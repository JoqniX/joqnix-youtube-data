[{"type": "subtitle", "time": 15300.429, "timestamp": "04:15:00", "text": "大海，我是指海滩。"}, {"type": "subtitle", "time": 15304.469, "timestamp": "04:15:04", "text": "东西。嗯，我会有的。"}, {"type": "subtitle", "time": 15308.07, "timestamp": "04:15:08", "text": "更有趣。我会，我不会，呃，我会"}, {"type": "subtitle", "time": 15311.429, "timestamp": "04:15:11", "text": "不要因为自己不会游泳而感到沮丧"}, {"type": "subtitle", "time": 15313.389, "timestamp": "04:15:13", "text": "尽管我来到了"}, {"type": "subtitle", "time": 15317.63, "timestamp": "04:15:17", "text": "海滩，但实际上人们会游泳，而且"}, {"type": "subtitle", "time": 15321.03, "timestamp": "04:15:21", "text": "事情就是这样，但与此同时，我来这里是为了这件事。"}, {"type": "subtitle", "time": 15324.07, "timestamp": "04:15:24", "text": "一个人正朝我走来，但是"}, {"type": "subtitle", "time": 15326.11, "timestamp": "04:15:26", "text": "我确实在这里"}, {"type": "subtitle", "time": 15331.07, "timestamp": "04:15:31", "text": "呃，比如，你管它叫什么？"}, {"type": "subtitle", "time": 15334.309, "timestamp": "04:15:34", "text": "我真的不是来这里拿东西的。"}, {"type": "subtitle", "time": 15337.75, "timestamp": "04:15:37", "text": "泡在水里什么的，然后我就……"}, {"type": "subtitle", "time": 15338.75, "timestamp": "04:15:38", "text": "一个"}, {"type": "subtitle", "time": 15341.07, "timestamp": "04:15:41", "text": "恐鸟"}, {"type": "subtitle", "time": 15343.59, "timestamp": "04:15:43", "text": "疼痛。所以如果我"}, {"type": "subtitle", "time": 15346.389, "timestamp": "04:15:46", "text": "我今天回去的时候。但是，我又可以"}, {"type": "subtitle", "time": 15348.99, "timestamp": "04:15:48", "text": "真的就拿一个"}, {"type": "subtitle", "time": 15350.51, "timestamp": "04:15:50", "text": "蘸"}, {"type": "subtitle", "time": 15353.349, "timestamp": "04:15:53", "text": "好像我不需要洗衣服似的。我"}, {"type": "subtitle", "time": 15356.55, "timestamp": "04:15:56", "text": "只需要把它们像盖子一样放进去就行了。"}]
[{"type": "subtitle", "time": 14108.229, "timestamp": "03:55:08", "text": "压力，呃，我所做的就是，呃，有一个"}, {"type": "subtitle", "time": 14111.51, "timestamp": "03:55:11", "text": "长凳，坐凳。我把脚抬起来"}, {"type": "subtitle", "time": 14114.189, "timestamp": "03:55:14", "text": "试图靠近并喜欢"}, {"type": "subtitle", "time": 14118.15, "timestamp": "03:55:18", "text": "呃，试着靠近一点，然后问：嗯，该怎么做？"}, {"type": "subtitle", "time": 14119.229, "timestamp": "03:55:19", "text": "你打电话"}, {"type": "subtitle", "time": 14121.75, "timestamp": "03:55:21", "text": "它？它叫什么？试图倾斜"}, {"type": "subtitle", "time": 14124.469, "timestamp": "03:55:24", "text": "我呃，试着系一下我的鞋带，左边那个。"}, {"type": "subtitle", "time": 14126.87, "timestamp": "03:55:26", "text": "我漏掉了一条腿。它开始摇晃。"}, {"type": "subtitle", "time": 14128.95, "timestamp": "03:55:28", "text": "我当时就懵了，心想：等等，发生了什么事？是什么"}, {"type": "subtitle", "time": 14131.95, "timestamp": "03:55:31", "text": "正在发生？"}, {"type": "subtitle", "time": 14135.11, "timestamp": "03:55:35", "text": "南德，我觉得早上完全不是这样。"}, {"type": "subtitle", "time": 14138.469, "timestamp": "03:55:38", "text": "这次风很大，跟上次不一样。"}, {"type": "subtitle", "time": 14140.87, "timestamp": "03:55:40", "text": "我们完成了我们的巡回演出，加入了空间流"}, {"type": "subtitle", "time": 14143.71, "timestamp": "03:55:43", "text": "音频流"}, {"type": "subtitle", "time": 14146.15, "timestamp": "03:55:46", "text": "就像晚上在推特上那样"}, {"type": "subtitle", "time": 14154.189, "timestamp": "03:55:54", "text": "海滩，我有点"}, {"type": "subtitle", "time": 14157.03, "timestamp": "03:55:57", "text": "无论我朋友的相机拍到什么，痛苦都会随之而来。"}]
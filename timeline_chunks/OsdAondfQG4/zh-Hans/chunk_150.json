[{"type": "subtitle", "time": 9001.03, "timestamp": "02:30:01", "text": "还有一些人会觉得，如果……"}, {"type": "subtitle", "time": 9003.19, "timestamp": "02:30:03", "text": "可以加你好友或者给你发私信。"}, {"type": "subtitle", "time": 9007.11, "timestamp": "02:30:07", "text": "东西，对吧？你这样做吗？"}, {"type": "subtitle", "time": 9009.87, "timestamp": "02:30:09", "text": "我不，我根本就没加。"}, {"type": "subtitle", "time": 9012.15, "timestamp": "02:30:12", "text": "人们。有时候，我就像"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "和某人聊了好几年"}, {"type": "subtitle", "time": 9018.67, "timestamp": "02:30:18", "text": "我还没有把它们全部添加进去。"}, {"type": "subtitle", "time": 9023.51, "timestamp": "02:30:23", "text": "时间。嗯。太疯狂了，"}, {"type": "subtitle", "time": 9029.67, "timestamp": "02:30:29", "text": "太疯狂了。"}, {"type": "subtitle", "time": 9033.19, "timestamp": "02:30:33", "text": "是的，我喜欢"}, {"type": "subtitle", "time": 9034.95, "timestamp": "02:30:34", "text": "就像有时候我们意识到这一点的时候"}, {"type": "subtitle", "time": 9036.71, "timestamp": "02:30:36", "text": "我们还没有互相添加好友，我们只是……"}, {"type": "subtitle", "time": 9039.67, "timestamp": "02:30:39", "text": "比如，“等等，我的天哪，我们还没有添加……”"}, {"type": "subtitle", "time": 9041.51, "timestamp": "02:30:41", "text": "彼此。”我们俩都像"}, {"type": "subtitle", "time": 9043.83, "timestamp": "02:30:43", "text": "目瞪口呆，因为我们一直在谈论"}, {"type": "subtitle", "time": 9049.27, "timestamp": "02:30:49", "text": "长的。只是没意识到而已。真有趣"}, {"type": "subtitle", "time": 9051.429, "timestamp": "02:30:51", "text": "想想"}]
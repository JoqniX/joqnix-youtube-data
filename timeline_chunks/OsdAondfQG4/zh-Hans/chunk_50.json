[{"type": "subtitle", "time": 3007.03, "timestamp": "00:50:07", "text": "恍然大悟的反应。呃，他跟我讲了个笑话，别这样"}, {"type": "subtitle", "time": 3010.069, "timestamp": "00:50:10", "text": "戳一下情况，她看起来没事，明白了"}, {"type": "subtitle", "time": 3013.19, "timestamp": "00:50:13", "text": "收到，谢谢你和家人。"}, {"type": "subtitle", "time": 3021.67, "timestamp": "00:50:21", "text": "我正在看"}, {"type": "subtitle", "time": 3034.71, "timestamp": "00:50:34", "text": "我喜欢老婆"}, {"type": "subtitle", "time": 3037.54, "timestamp": "00:50:37", "text": "哦，白色。是的，我"}, {"type": "subtitle", "time": 3039.71, "timestamp": "00:50:39", "text": "[音乐]"}, {"type": "subtitle", "time": 3043.15, "timestamp": "00:50:43", "text": "像 yolu。"}, {"type": "subtitle", "time": 3048.069, "timestamp": "00:50:48", "text": "是的。是的。是的。我喜欢，因为我喜欢哦。"}, {"type": "subtitle", "time": 3049.589, "timestamp": "00:50:49", "text": "是的。是的。发布了一段视频更新。"}, {"type": "subtitle", "time": 3053.43, "timestamp": "00:50:53", "text": "是的。已更新。是的。是的。"}, {"type": "subtitle", "time": 3055.67, "timestamp": "00:50:55", "text": "我不喜欢。这很有趣吗？我"}]
[{"type": "subtitle", "time": 1030.429, "timestamp": "00:17:10", "text": "[音乐]"}, {"type": "subtitle", "time": 1033.549, "timestamp": "00:17:13", "text": "好的，你讲得真好。"}, {"type": "subtitle", "time": 1047.23, "timestamp": "00:17:27", "text": "我不是"}, {"type": "subtitle", "time": 1054.15, "timestamp": "00:17:34", "text": "什么？什么？你是同性恋吗？等等，我是"}, {"type": "subtitle", "time": 1058.789, "timestamp": "00:17:38", "text": "[音乐]"}, {"type": "subtitle", "time": 1061.99, "timestamp": "00:17:41", "text": "但你的中文真的很好，你知道的。"}, {"type": "subtitle", "time": 1066.39, "timestamp": "00:17:46", "text": "完美的。你没有"}, {"type": "subtitle", "time": 1068.549, "timestamp": "00:17:48", "text": "谢谢。谢谢。是的。是的。你的"}, {"type": "subtitle", "time": 1071.59, "timestamp": "00:17:51", "text": "日本人。它也太可爱了。我有"}, {"type": "subtitle", "time": 1073.07, "timestamp": "00:17:53", "text": "有中文"}]
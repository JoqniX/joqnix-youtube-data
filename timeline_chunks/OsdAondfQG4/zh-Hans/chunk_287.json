[{"type": "subtitle", "time": 17220.43, "timestamp": "04:47:00", "text": "然后有点像"}, {"type": "subtitle", "time": 17223.868, "timestamp": "04:47:03", "text": "嗯，那就像什么？"}, {"type": "subtitle", "time": 17226.43, "timestamp": "04:47:06", "text": "嗯，然后就像"}, {"type": "subtitle", "time": 17229.67, "timestamp": "04:47:09", "text": "那玩意儿不是自行车，是踏板车"}, {"type": "subtitle", "time": 17232.23, "timestamp": "04:47:12", "text": "东西，但其中一个确实有"}, {"type": "subtitle", "time": 17235.788, "timestamp": "04:47:15", "text": "我当时就觉得，哇，这电动滑板车真棒！"}, {"type": "subtitle", "time": 17239.27, "timestamp": "04:47:19", "text": "酷，我想我知道了，所以这是我的"}, {"type": "subtitle", "time": 17242.19, "timestamp": "04:47:22", "text": "排队走就是海滩"}, {"type": "subtitle", "time": 17245.788, "timestamp": "04:47:25", "text": "就靠它了。这就是方法。"}, {"type": "subtitle", "time": 17249.31, "timestamp": "04:47:29", "text": "明白了。等等，这真的是"}, {"type": "subtitle", "time": 17251.91, "timestamp": "04:47:31", "text": "方式？我不知道。我也这么认为。我不"}, {"type": "subtitle", "time": 17255.19, "timestamp": "04:47:35", "text": "知道。不，绝对不是。是的，我"}, {"type": "subtitle", "time": 17257.75, "timestamp": "04:47:37", "text": "我觉得就是这个了。你好。这是"}, {"type": "subtitle", "time": 17261.23, "timestamp": "04:47:41", "text": "我想，大概一个吧。拜托，我希望我不是。"}, {"type": "subtitle", "time": 17263.51, "timestamp": "04:47:43", "text": "错误的。是的，我们目前已经恢复正常了。"}, {"type": "subtitle", "time": 17265.43, "timestamp": "04:47:45", "text": "步行回家。"}, {"type": "subtitle", "time": 17267.27, "timestamp": "04:47:47", "text": "我回到家后就会结束直播。"}, {"type": "subtitle", "time": 17270.23, "timestamp": "04:47:50", "text": "或者别的什么。有点不想结束"}, {"type": "subtitle", "time": 17272.91, "timestamp": "04:47:52", "text": "继续直播。但"}, {"type": "subtitle", "time": 17277.11, "timestamp": "04:47:57", "text": "我真的累得筋疲力尽了。"}, {"type": "subtitle", "time": 17278.27, "timestamp": "04:47:58", "text": "早晨"}]
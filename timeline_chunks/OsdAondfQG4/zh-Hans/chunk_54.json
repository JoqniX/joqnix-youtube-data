[{"type": "subtitle", "time": 3242.23, "timestamp": "00:54:02", "text": "你好，印度？哦，你说的是合十礼。"}, {"type": "subtitle", "time": 3243.91, "timestamp": "00:54:03", "text": "是的，有很多语言"}, {"type": "subtitle", "time": 3247.83, "timestamp": "00:54:07", "text": "印度。我每项都不擅长。"}, {"type": "subtitle", "time": 3249.75, "timestamp": "00:54:09", "text": "[音乐]"}, {"type": "subtitle", "time": 3261.27, "timestamp": "00:54:21", "text": "好多语言"}, {"type": "subtitle", "time": 3263.309, "timestamp": "00:54:23", "text": "比如我不擅长"}, {"type": "subtitle", "time": 3266.79, "timestamp": "00:54:26", "text": "哦，我不知道你怎么样，所以你说"}, {"type": "subtitle", "time": 3277.15, "timestamp": "00:54:37", "text": "哦，"}, {"type": "subtitle", "time": 3290.51, "timestamp": "00:54:50", "text": "语言。那是什么？她是什么人？"}, {"type": "subtitle", "time": 3293.79, "timestamp": "00:54:53", "text": "怎么说？或许你"}, {"type": "subtitle", "time": 3296.829, "timestamp": "00:54:56", "text": "禁用。那是"}, {"type": "subtitle", "time": 3299.589, "timestamp": "00:54:59", "text": "他们为什么在交谈。"}]
[{"type": "subtitle", "time": 13802.87, "timestamp": "03:50:02", "text": "回家。不，不，不。今晚7点"}, {"type": "subtitle", "time": 13806.87, "timestamp": "03:50:06", "text": "我会回家的。我们将进行电脑操作。"}, {"type": "subtitle", "time": 13808.429, "timestamp": "03:50:08", "text": "等我回来就直播"}, {"type": "subtitle", "time": 13811.95, "timestamp": "03:50:11", "text": "家。无法感同身受。我穿的鞋子"}, {"type": "subtitle", "time": 13814.87, "timestamp": "03:50:14", "text": "诺伊斯。是的。再见。"}, {"type": "subtitle", "time": 13817.15, "timestamp": "03:50:17", "text": "那简直就是字面意思。"}, {"type": "subtitle", "time": 13820.15, "timestamp": "03:50:20", "text": "呃，我的天哪，有人在盯着我看"}, {"type": "subtitle", "time": 13822.309, "timestamp": "03:50:22", "text": "我。我的天哪，这种感觉。我仍然"}, {"type": "subtitle", "time": 13824.87, "timestamp": "03:50:24", "text": "无法适应这种情况。这次我依然如此"}, {"type": "subtitle", "time": 13827.67, "timestamp": "03:50:27", "text": "我没有尝试静音。我刚才就去了"}, {"type": "subtitle", "time": 13830.63, "timestamp": "03:50:30", "text": "它。这算是一个小小的进步。我认为"}, {"type": "subtitle", "time": 13834.469, "timestamp": "03:50:34", "text": "我喜欢待在这里，当我不在我身边的时候"}, {"type": "subtitle", "time": 13837.67, "timestamp": "03:50:37", "text": "家乡的事情，我能搞定。但"}, {"type": "subtitle", "time": 13840.83, "timestamp": "03:50:40", "text": "主要的主要比赛是"}, {"type": "subtitle", "time": 13843.429, "timestamp": "03:50:43", "text": "实际上，我尝试做的是手机版"}, {"type": "subtitle", "time": 13848.83, "timestamp": "03:50:48", "text": "直播和像这样说话，就像在我的直播中一样"}, {"type": "subtitle", "time": 13853.15, "timestamp": "03:50:53", "text": "地方。这才是最重要的。"}, {"type": "subtitle", "time": 13854.91, "timestamp": "03:50:54", "text": "实际上。"}, {"type": "subtitle", "time": 13858.75, "timestamp": "03:50:58", "text": "是的。呃，但我需要买一个好的"}]
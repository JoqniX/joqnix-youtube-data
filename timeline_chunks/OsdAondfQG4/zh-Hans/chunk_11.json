[{"type": "subtitle", "time": 666.51, "timestamp": "00:11:06", "text": "泰国。你呢？"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "中国人。"}, {"type": "subtitle", "time": 682.63, "timestamp": "00:11:22", "text": "哦，哇。你没能很好地跟我交流。"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "不，不。哦，是的。哦。哦，我又回来了"}, {"type": "subtitle", "time": 687.03, "timestamp": "00:11:27", "text": "我的一天。祝你有美好的一天。我的上帝。它是"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "好的。我没跟你提过这件事。我"}, {"type": "subtitle", "time": 690.11, "timestamp": "00:11:30", "text": "意思是"}, {"type": "subtitle", "time": 694.069, "timestamp": "00:11:34", "text": "给你。恩潘。是的。"}, {"type": "subtitle", "time": 697.75, "timestamp": "00:11:37", "text": "你学日语吧？"}, {"type": "subtitle", "time": 706.23, "timestamp": "00:11:46", "text": "我的天哪。是的。我正在学习日语。我是"}, {"type": "subtitle", "time": 708.949, "timestamp": "00:11:48", "text": "太慢了。我的天啊。"}, {"type": "subtitle", "time": 718.389, "timestamp": "00:11:58", "text": "太可爱了。是的。好的。黑色。"}]
[{"type": "subtitle", "time": 13501.83, "timestamp": "03:45:01", "text": "呃，那个节目，呃，该怎么称呼它呢？"}, {"type": "subtitle", "time": 13503.91, "timestamp": "03:45:03", "text": "与其说是修复麦克风，不如说是方便。"}, {"type": "subtitle", "time": 13505.63, "timestamp": "03:45:05", "text": "我必须去哪里"}, {"type": "subtitle", "time": 13509.429, "timestamp": "03:45:09", "text": "呃，它好像有根电缆之类的东西。"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "那会很痛苦，但你知道，我感觉"}, {"type": "subtitle", "time": 13514.11, "timestamp": "03:45:14", "text": "这样更"}, {"type": "subtitle", "time": 13516.75, "timestamp": "03:45:16", "text": "更好的。那么，什么是……"}, {"type": "subtitle", "time": 13520.03, "timestamp": "03:45:20", "text": "向上？希望我的声音能被听到"}, {"type": "subtitle", "time": 13522.87, "timestamp": "03:45:22", "text": "方式。嗯，我希望我的声音能被听到。"}, {"type": "subtitle", "time": 13528.63, "timestamp": "03:45:28", "text": "我的天啊。我可能会把帕沃伦拉起来"}, {"type": "subtitle", "time": 13532.67, "timestamp": "03:45:32", "text": "通知系统。"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "是的。所以有很多"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "因为是早上，所以有很多人走过。"}, {"type": "subtitle", "time": 13540.95, "timestamp": "03:45:40", "text": "7，对吧？当然会有人。"}, {"type": "subtitle", "time": 13544.389, "timestamp": "03:45:44", "text": "他们也会进行晨练。"}, {"type": "subtitle", "time": 13546.309, "timestamp": "03:45:46", "text": "但确实，某种程度上感觉有点像。"}, {"type": "subtitle", "time": 13549.349, "timestamp": "03:45:49", "text": "尴尬又奇怪，居然是我在说话"}, {"type": "subtitle", "time": 13551.83, "timestamp": "03:45:51", "text": "英语不好，他们就像陌生人一样。"}, {"type": "subtitle", "time": 13556.189, "timestamp": "03:45:56", "text": "看着我，好像在说这男孩是干嘛的"}, {"type": "subtitle", "time": 13558.79, "timestamp": "03:45:58", "text": "正在做？他在对着手机说什么？"}]
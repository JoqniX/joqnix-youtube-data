[{"type": "subtitle", "time": 6302.55, "timestamp": "01:45:02", "text": "我当时说不出话来。但我很高兴我能做到"}, {"type": "subtitle", "time": 6306.31, "timestamp": "01:45:06", "text": "至少还能以这种方式重新联系上。"}, {"type": "subtitle", "time": 6308.31, "timestamp": "01:45:08", "text": "是的。"}, {"type": "subtitle", "time": 6310.229, "timestamp": "01:45:10", "text": "我知道。当你……的时候，事情就会变得更容易。"}, {"type": "subtitle", "time": 6311.149, "timestamp": "01:45:11", "text": "有喜欢"}, {"type": "subtitle", "time": 6320.709, "timestamp": "01:45:20", "text": "与人沟通的好地方。"}, {"type": "subtitle", "time": 6322.95, "timestamp": "01:45:22", "text": "就像在我的Discord服务器上一样，所有"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "观众们喜欢在聊天室里热烈讨论。"}, {"type": "subtitle", "time": 6328.709, "timestamp": "01:45:28", "text": "那里。有时甚至连观众都未必能理解。"}, {"type": "subtitle", "time": 6331.03, "timestamp": "01:45:31", "text": "就像一些随机的人来到这里，然后就变成了"}, {"type": "subtitle", "time": 6333.189, "timestamp": "01:45:33", "text": "朋友之类的，然后他们就用我的"}, {"type": "subtitle", "time": 6335.189, "timestamp": "01:45:35", "text": "Discord 服务器就像一个交流中心"}, {"type": "subtitle", "time": 6337.75, "timestamp": "01:45:37", "text": "彼此。啊，对对对，我也有"}, {"type": "subtitle", "time": 6339.87, "timestamp": "01:45:39", "text": "从前"}, {"type": "subtitle", "time": 6343.109, "timestamp": "01:45:43", "text": "时间，但人们，但我意识到，超过"}, {"type": "subtitle", "time": 6346.55, "timestamp": "01:45:46", "text": "他们找到新的目标后，就会继续前进。"}, {"type": "subtitle", "time": 6348.109, "timestamp": "01:45:48", "text": "空格或"}, {"type": "subtitle", "time": 6351.109, "timestamp": "01:45:51", "text": "某物。真令人难过。他们乘公交车"}, {"type": "subtitle", "time": 6355.27, "timestamp": "01:45:55", "text": "生活。对，也是。"}, {"type": "subtitle", "time": 6358.07, "timestamp": "01:45:58", "text": "是的，我一直在看很多东西。"}]
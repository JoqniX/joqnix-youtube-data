[{"type": "subtitle", "time": 3361.67, "timestamp": "00:56:01", "text": "哇。"}, {"type": "subtitle", "time": 3365.07, "timestamp": "00:56:05", "text": "我以为他是俄罗斯人。"}, {"type": "subtitle", "time": 3367.589, "timestamp": "00:56:07", "text": "[音乐]"}, {"type": "subtitle", "time": 3370.28, "timestamp": "00:56:10", "text": "所以他是俄罗斯人。"}, {"type": "subtitle", "time": 3383.03, "timestamp": "00:56:23", "text": "我忘了静音。对不起。妈的。哦"}, {"type": "subtitle", "time": 3386.19, "timestamp": "00:56:26", "text": "我的上帝。我忘了"}, {"type": "subtitle", "time": 3387.95, "timestamp": "00:56:27", "text": "[音乐]"}, {"type": "subtitle", "time": 3391.19, "timestamp": "00:56:31", "text": "聊天。我当时正在聊天室里欢迎某人。"}, {"type": "subtitle", "time": 3395.51, "timestamp": "00:56:35", "text": "虽然有人过来打招呼。"}, {"type": "subtitle", "time": 3399.349, "timestamp": "00:56:39", "text": "没关系。还可以。没关系。"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "是的。是吗？没关系。别这样"}, {"type": "subtitle", "time": 3406.789, "timestamp": "00:56:46", "text": "害羞的。别害羞。没关系。没关系。"}, {"type": "subtitle", "time": 3409.75, "timestamp": "00:56:49", "text": "你好。是的。"}, {"type": "subtitle", "time": 3418.069, "timestamp": "00:56:58", "text": "你好吗？你好。我很好。"}]
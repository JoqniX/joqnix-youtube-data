[{"type": "subtitle", "time": 8762.389, "timestamp": "02:26:02", "text": "戴维斯寿司"}, {"type": "subtitle", "time": 8765.08, "timestamp": "02:26:05", "text": "呃，寿司和"}, {"type": "subtitle", "time": 8767.55, "timestamp": "02:26:07", "text": "[音乐]"}, {"type": "subtitle", "time": 8770.389, "timestamp": "02:26:10", "text": "Sosanhan回来了。我不会撒谎。"}, {"type": "subtitle", "time": 8772.87, "timestamp": "02:26:12", "text": "哪个？ WHO？"}, {"type": "subtitle", "time": 8776.99, "timestamp": "02:26:16", "text": "寿司。嗯？寿司又回来了。是的。是的。"}, {"type": "subtitle", "time": 8779.99, "timestamp": "02:26:19", "text": "是的。当他宣布他"}, {"type": "subtitle", "time": 8780.87, "timestamp": "02:26:20", "text": "我当时想，我不会回来了。"}, {"type": "subtitle", "time": 8782.469, "timestamp": "02:26:22", "text": "“哦，天哪。”然后他回来了，我"}, {"type": "subtitle", "time": 8785.27, "timestamp": "02:26:25", "text": "当时我就想，“哦，好的。”"}, {"type": "subtitle", "time": 8791.91, "timestamp": "02:26:31", "text": "因为很难放下对……的爱"}, {"type": "subtitle", "time": 8794.71, "timestamp": "02:26:34", "text": "流媒体等等。这里真好玩。"}, {"type": "subtitle", "time": 8796.55, "timestamp": "02:26:36", "text": "是的。"}, {"type": "subtitle", "time": 8799.27, "timestamp": "02:26:39", "text": "只要你把它当作爱好来对待就好。"}, {"type": "subtitle", "time": 8801.91, "timestamp": "02:26:41", "text": "以及你充满热情的事物"}, {"type": "subtitle", "time": 8803.349, "timestamp": "02:26:43", "text": "没问题，但是当你服用它的时候"}, {"type": "subtitle", "time": 8805.349, "timestamp": "02:26:45", "text": "非常认真地去做，把它当成一件苦差事。"}, {"type": "subtitle", "time": 8810.63, "timestamp": "02:26:50", "text": "那确实有点麻烦。"}, {"type": "subtitle", "time": 8813.27, "timestamp": "02:26:53", "text": "是的。是的，他确实有。我觉得对我来说"}, {"type": "subtitle", "time": 8815.51, "timestamp": "02:26:55", "text": "就像其他事情完成一样。"}, {"type": "subtitle", "time": 8817.99, "timestamp": "02:26:57", "text": "我不知道。我觉得当时"}]
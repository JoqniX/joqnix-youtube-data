[{"type": "subtitle", "time": 16981.91, "timestamp": "04:43:01", "text": "知道。我已经做好准备了。准备"}, {"type": "subtitle", "time": 16984.35, "timestamp": "04:43:04", "text": "为了上课。祝您散步愉快。"}, {"type": "subtitle", "time": 16987.91, "timestamp": "04:43:07", "text": "嗨，哥们儿。小心。"}, {"type": "subtitle", "time": 16991.27, "timestamp": "04:43:11", "text": "我想这就是我需要的地方。"}, {"type": "subtitle", "time": 16994.39, "timestamp": "04:43:14", "text": "走吧。我确定吗？我没有"}, {"type": "subtitle", "time": 16996.868, "timestamp": "04:43:16", "text": "知道。你知道吗？我打算走一小段路。"}, {"type": "subtitle", "time": 16998.99, "timestamp": "04:43:18", "text": "少量"}, {"type": "subtitle", "time": 17001.948, "timestamp": "04:43:21", "text": "更远。我的一部分想法是"}, {"type": "subtitle", "time": 17004.788, "timestamp": "04:43:24", "text": "那份喜悦。这是同一个地方。你"}, {"type": "subtitle", "time": 17006.59, "timestamp": "04:43:26", "text": "做错了"}, {"type": "subtitle", "time": 17008.11, "timestamp": "04:43:28", "text": "时间。"}, {"type": "subtitle", "time": 17011.708, "timestamp": "04:43:31", "text": "是的。所以，我打算走走。"}, {"type": "subtitle", "time": 17014.788, "timestamp": "04:43:34", "text": "更远。好的。哦，还有另一个。"}, {"type": "subtitle", "time": 17015.788, "timestamp": "04:43:35", "text": "海滩"}, {"type": "subtitle", "time": 17018.23, "timestamp": "04:43:38", "text": "采取。有个家伙真的在做"}, {"type": "subtitle", "time": 17022.03, "timestamp": "04:43:42", "text": "在海里、沙滩上做俯卧撑。"}, {"type": "subtitle", "time": 17025.628, "timestamp": "04:43:45", "text": "哇。海滩上的人们真酷"}, {"type": "subtitle", "time": 17031.39, "timestamp": "04:43:51", "text": "去。"}, {"type": "subtitle", "time": 17033.39, "timestamp": "04:43:53", "text": "哇。"}, {"type": "subtitle", "time": 17035.39, "timestamp": "04:43:55", "text": "再见。我太"}, {"type": "subtitle", "time": 17037.55, "timestamp": "04:43:57", "text": "疲劳的。我太"}]
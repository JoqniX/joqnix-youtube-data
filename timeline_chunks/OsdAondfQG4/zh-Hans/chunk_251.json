[{"type": "subtitle", "time": 15061.429, "timestamp": "04:11:01", "text": "不知道。就像我的亲戚们一样"}, {"type": "subtitle", "time": 15062.67, "timestamp": "04:11:02", "text": "最近"}, {"type": "subtitle", "time": 15065.389, "timestamp": "04:11:05", "text": "像点餐一样点餐。"}, {"type": "subtitle", "time": 15068.95, "timestamp": "04:11:08", "text": "好的。一些快餐之类的东西。"}, {"type": "subtitle", "time": 15073.189, "timestamp": "04:11:13", "text": "就像它应该像一个一样"}, {"type": "subtitle", "time": 15075.91, "timestamp": "04:11:15", "text": "持续时间，对，就像订单一样"}, {"type": "subtitle", "time": 15077.83, "timestamp": "04:11:17", "text": "手机订单和点赞或订单"}, {"type": "subtitle", "time": 15080.229, "timestamp": "04:11:20", "text": "东西，网上订购的商品等等。"}, {"type": "subtitle", "time": 15082.59, "timestamp": "04:11:22", "text": "应该最多需要30分钟左右。"}, {"type": "subtitle", "time": 15085.349, "timestamp": "04:11:25", "text": "大概四十个，这取决于……"}, {"type": "subtitle", "time": 15087.15, "timestamp": "04:11:27", "text": "您所在的位置。"}, {"type": "subtitle", "time": 15090.71, "timestamp": "04:11:30", "text": "但这就像在应用程序中显示的那样"}, {"type": "subtitle", "time": 15094.15, "timestamp": "04:11:34", "text": "大概15分钟左右吧，但是"}, {"type": "subtitle", "time": 15096.95, "timestamp": "04:11:36", "text": "他们花了大约两个小时。"}, {"type": "subtitle", "time": 15100.11, "timestamp": "04:11:40", "text": "我的天哪，因为人们太……"}, {"type": "subtitle", "time": 15102.79, "timestamp": "04:11:42", "text": "使困惑。我的天，狗狗帮不是"}, {"type": "subtitle", "time": 15107.269, "timestamp": "04:11:47", "text": "攻击我。那真是太好了。你好。"}, {"type": "subtitle", "time": 15108.91, "timestamp": "04:11:48", "text": "你好。是的，"}, {"type": "subtitle", "time": 15113.11, "timestamp": "04:11:53", "text": "所以他们……哦，有人在走动"}, {"type": "subtitle", "time": 15114.429, "timestamp": "04:11:54", "text": "沿着"}, {"type": "subtitle", "time": 15117.83, "timestamp": "04:11:57", "text": "海滨。他们可能会听到我说话，"}, {"type": "subtitle", "time": 15118.75, "timestamp": "04:11:58", "text": "但"}]
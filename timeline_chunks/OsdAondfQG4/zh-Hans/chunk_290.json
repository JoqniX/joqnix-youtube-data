[{"type": "subtitle", "time": 17407.788, "timestamp": "04:50:07", "text": "还有鱼"}, {"type": "subtitle", "time": 17414.55, "timestamp": "04:50:14", "text": "烹饪。这里有个可爱的人"}, {"type": "subtitle", "time": 17417.868, "timestamp": "04:50:17", "text": "实际上，他们是在喂养流浪狗。"}, {"type": "subtitle", "time": 17422.23, "timestamp": "04:50:22", "text": "他们这样做真是太好了。"}, {"type": "subtitle", "time": 17424.23, "timestamp": "04:50:24", "text": "他们就像带来了你知道的东西"}, {"type": "subtitle", "time": 17428.55, "timestamp": "04:50:28", "text": "狗零食和一些食物要喂它"}, {"type": "subtitle", "time": 17431.51, "timestamp": "04:50:31", "text": "流浪狗。他们确实有"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "四只狗进入了他们的车内。"}, {"type": "subtitle", "time": 17437.75, "timestamp": "04:50:37", "text": "我的天哪，这也太可爱了吧。看看他们。"}, {"type": "subtitle", "time": 17446.948, "timestamp": "04:50:46", "text": "我敢打赌，狗果们会等着。"}, {"type": "subtitle", "time": 17449.75, "timestamp": "04:50:49", "text": "每天早上对他们来说就像这样"}, {"type": "subtitle", "time": 17451.868, "timestamp": "04:50:51", "text": "8点钟方向"}, {"type": "subtitle", "time": 17455.03, "timestamp": "04:50:55", "text": "早上，就像等着他们给他们一样。"}, {"type": "subtitle", "time": 17458.35, "timestamp": "04:50:58", "text": "再次款待，或者像他们的早晨一样"}]
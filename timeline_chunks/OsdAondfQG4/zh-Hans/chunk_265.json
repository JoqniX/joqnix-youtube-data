[{"type": "subtitle", "time": 15900.469, "timestamp": "04:25:00", "text": "阳台。虽然距离很近"}, {"type": "subtitle", "time": 15904.63, "timestamp": "04:25:04", "text": "但是，它达不到。我当时就想，为什么？和"}, {"type": "subtitle", "time": 15908.389, "timestamp": "04:25:08", "text": "我买那部2GB手机的那一刻"}, {"type": "subtitle", "time": 15910.67, "timestamp": "04:25:10", "text": "额外的东西"}, {"type": "subtitle", "time": 15913.67, "timestamp": "04:25:13", "text": "数据，我尝试从流式传输"}, {"type": "subtitle", "time": 15916.429, "timestamp": "04:25:16", "text": "阳台。好的。我们去了阳台。"}, {"type": "subtitle", "time": 15919.429, "timestamp": "04:25:19", "text": "昨天，你猜怎么着？无线网络是"}, {"type": "subtitle", "time": 15923.269, "timestamp": "04:25:23", "text": "使用两个信号装置。而我是"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "等等，什么？你当时没上班"}, {"type": "subtitle", "time": 15927.79, "timestamp": "04:25:27", "text": "开始直播"}, {"type": "subtitle", "time": 15931.11, "timestamp": "04:25:31", "text": "昨天。不。"}, {"type": "subtitle", "time": 15934.469, "timestamp": "04:25:34", "text": "我当时就想，但是，今天我又一次……"}, {"type": "subtitle", "time": 15937.429, "timestamp": "04:25:37", "text": "我也很高兴昨天买了它，但是"}, {"type": "subtitle", "time": 15940.07, "timestamp": "04:25:40", "text": "否则我就会变成这样"}, {"type": "subtitle", "time": 15944.59, "timestamp": "04:25:44", "text": "呃，就像处于一种糟糕的状态"}, {"type": "subtitle", "time": 15948.79, "timestamp": "04:25:48", "text": "不，Streamlabs 使用大量数据来"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "我无法将视频流传输到 YouTube。"}, {"type": "subtitle", "time": 15952.99, "timestamp": "04:25:52", "text": "适当地。"}, {"type": "subtitle", "time": 15957.59, "timestamp": "04:25:57", "text": "不，但我很高兴我能做到这一点。"}]
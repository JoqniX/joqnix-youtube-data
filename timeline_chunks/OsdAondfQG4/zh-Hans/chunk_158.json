[{"type": "subtitle", "time": 9490.07, "timestamp": "02:38:10", "text": "[音乐]"}, {"type": "subtitle", "time": 9491.469, "timestamp": "02:38:11", "text": "所以"}, {"type": "subtitle", "time": 9496.469, "timestamp": "02:38:16", "text": "很多很多事，很多人"}, {"type": "subtitle", "time": 9500.55, "timestamp": "02:38:20", "text": "是啊，我觉得自己快要崩溃了。"}, {"type": "subtitle", "time": 9502.429, "timestamp": "02:38:22", "text": "我自己，还有，就"}, {"type": "subtitle", "time": 9507.11, "timestamp": "02:38:27", "text": "我猜我在绘画方面大概有40年经验。"}, {"type": "subtitle", "time": 9508.79, "timestamp": "02:38:28", "text": "是啊，尽量别太费脑筋。"}, {"type": "subtitle", "time": 9512.23, "timestamp": "02:38:32", "text": "难的。是的，会开始疼的。库兹"}, {"type": "subtitle", "time": 9515.349, "timestamp": "02:38:35", "text": "比如有一天，我要带四个人"}, {"type": "subtitle", "time": 9519.11, "timestamp": "02:38:39", "text": "现在，四五个人，就像"}, {"type": "subtitle", "time": 9521.75, "timestamp": "02:38:41", "text": "一整天。这太过分了。我会"}, {"type": "subtitle", "time": 9524.309, "timestamp": "02:38:44", "text": "就像，“但是没关系，就像……”"}, {"type": "subtitle", "time": 9527.27, "timestamp": "02:38:47", "text": "反正。我现在要走了。” 所以，我是"}, {"type": "subtitle", "time": 9531.51, "timestamp": "02:38:51", "text": "比如，“没关系。”我猜"}, {"type": "subtitle", "time": 9533.67, "timestamp": "02:38:53", "text": "现在对我来说快4点了。所以，我"}, {"type": "subtitle", "time": 9536.79, "timestamp": "02:38:56", "text": "可能不得不离开。是的。"}, {"type": "subtitle", "time": 9539.83, "timestamp": "02:38:59", "text": "等等，我们什么时候又开始了？"}]
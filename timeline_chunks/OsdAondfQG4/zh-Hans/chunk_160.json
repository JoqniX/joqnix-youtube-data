[{"type": "subtitle", "time": 9600.389, "timestamp": "02:40:00", "text": "随意发挥也没关系。我们正在放松休息。"}, {"type": "subtitle", "time": 9603.03, "timestamp": "02:40:03", "text": "是的，我们在放松。我们总是可以"}, {"type": "subtitle", "time": 9605.11, "timestamp": "02:40:05", "text": "合作出去。我们没有合作。"}, {"type": "subtitle", "time": 9607.03, "timestamp": "02:40:07", "text": "我们只是闲逛而已。我们正在悬挂"}, {"type": "subtitle", "time": 9608.87, "timestamp": "02:40:08", "text": "出去。未来我们也可以悬挂"}, {"type": "subtitle", "time": 9611.51, "timestamp": "02:40:11", "text": "出去。只是个聚会场所。是的，这是一个"}, {"type": "subtitle", "time": 9613.91, "timestamp": "02:40:13", "text": "挂出。"}, {"type": "subtitle", "time": 9615.75, "timestamp": "02:40:15", "text": "是的。是的。总之，谢谢你的款待。"}, {"type": "subtitle", "time": 9619.03, "timestamp": "02:40:19", "text": "我。谢谢你今天抽出时间。祝你一切顺利"}, {"type": "subtitle", "time": 9621.99, "timestamp": "02:40:21", "text": "夜幕降临。好的。祝你好运！"}, {"type": "subtitle", "time": 9623.91, "timestamp": "02:40:23", "text": "电影《艾米》。"}, {"type": "subtitle", "time": 9626.55, "timestamp": "02:40:26", "text": "我希望一切顺利。"}, {"type": "subtitle", "time": 9628.87, "timestamp": "02:40:28", "text": "一切都已安排妥当。我们来玩《命运》吧"}, {"type": "subtitle", "time": 9632.389, "timestamp": "02:40:32", "text": "或者两者结合。"}, {"type": "subtitle", "time": 9634.71, "timestamp": "02:40:34", "text": "你好。"}, {"type": "subtitle", "time": 9642.75, "timestamp": "02:40:42", "text": "再见。所以各位，这就是《面具》"}, {"type": "subtitle", "time": 9647.309, "timestamp": "02:40:47", "text": "反对。希望你和马斯孔相处愉快"}, {"type": "subtitle", "time": 9650.95, "timestamp": "02:40:50", "text": "今天。我们当时玩得非常开心。不。而且"}, {"type": "subtitle", "time": 9653.429, "timestamp": "02:40:53", "text": "如果你有的话，如果你，如果你，如果你可以的话，"}, {"type": "subtitle", "time": 9657.23, "timestamp": "02:40:57", "text": "请在Twitch上关注Masone，"}]
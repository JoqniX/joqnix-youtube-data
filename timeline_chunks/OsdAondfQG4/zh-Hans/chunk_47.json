[{"type": "subtitle", "time": 2820.069, "timestamp": "00:47:00", "text": "哦，是的。是的。是的。她真可爱。"}, {"type": "subtitle", "time": 2823.43, "timestamp": "00:47:03", "text": "她人真好。是的。"}, {"type": "subtitle", "time": 2831.109, "timestamp": "00:47:11", "text": "[音乐]"}, {"type": "subtitle", "time": 2833.47, "timestamp": "00:47:13", "text": "是的。"}, {"type": "subtitle", "time": 2837.19, "timestamp": "00:47:17", "text": "现金。等待。我正在给他。等待。什么？"}, {"type": "subtitle", "time": 2839.67, "timestamp": "00:47:19", "text": "哦，不，别给我那个。哦，别这样做"}, {"type": "subtitle", "time": 2841.75, "timestamp": "00:47:21", "text": "那。我的意思是，我想交个朋友。"}, {"type": "subtitle", "time": 2843.67, "timestamp": "00:47:23", "text": "喂。"}, {"type": "subtitle", "time": 2848.589, "timestamp": "00:47:28", "text": "不，不，非常糟糕。我无法花费"}, {"type": "subtitle", "time": 2852.67, "timestamp": "00:47:32", "text": "我的我可以花很多钱"}, {"type": "subtitle", "time": 2857.91, "timestamp": "00:47:37", "text": "该轮到油管博主们了，你们懂的。是的。"}, {"type": "subtitle", "time": 2860.15, "timestamp": "00:47:40", "text": "所以，等等。"}, {"type": "subtitle", "time": 2863.87, "timestamp": "00:47:43", "text": "等等，你平时学习什么的吗？你是"}, {"type": "subtitle", "time": 2867.03, "timestamp": "00:47:47", "text": "对我来说，这算什么学生？"}, {"type": "subtitle", "time": 2869.51, "timestamp": "00:47:49", "text": "不，我在工作。"}, {"type": "subtitle", "time": 2872.87, "timestamp": "00:47:52", "text": "现在正在工作。好的。"}, {"type": "subtitle", "time": 2875.43, "timestamp": "00:47:55", "text": "就像你只能得到你得到的东西一样"}, {"type": "subtitle", "time": 2878.15, "timestamp": "00:47:58", "text": "晚上有空闲时间什么的，对吧？"}]
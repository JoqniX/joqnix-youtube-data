[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "别来管我们。"}, {"type": "subtitle", "time": 7504.31, "timestamp": "02:05:04", "text": "是的。是的。这就是我点的，对吧？"}, {"type": "subtitle", "time": 7506.91, "timestamp": "02:05:06", "text": "现在。那就是我"}, {"type": "subtitle", "time": 7515.43, "timestamp": "02:05:15", "text": "我现在不会记得这件事了。"}, {"type": "subtitle", "time": 7520.47, "timestamp": "02:05:20", "text": "我记得就像流水一样。"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "自来水。是的。自来水。喜欢"}, {"type": "subtitle", "time": 7525.43, "timestamp": "02:05:25", "text": "嗯，是的。"}, {"type": "subtitle", "time": 7529.51, "timestamp": "02:05:29", "text": "所以鼻子里进了水。"}, {"type": "subtitle", "time": 7530.95, "timestamp": "02:05:30", "text": "我不知道。这真的很难"}, {"type": "subtitle", "time": 7533.109, "timestamp": "02:05:33", "text": "还记得流水吗？是的，就是这样。"}, {"type": "subtitle", "time": 7536.31, "timestamp": "02:05:36", "text": "真的。这是真的。"}, {"type": "subtitle", "time": 7538.149, "timestamp": "02:05:38", "text": "我的水都到哪儿去了？为什么会这样？"}, {"type": "chat", "time": 7539.924, "timestamp": "02:05:39", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "Natural spring water yumyum"}, {"type": "subtitle", "time": 7541.229, "timestamp": "02:05:41", "text": "逃跑？它为什么要逃跑？"}, {"type": "subtitle", "time": 7549.91, "timestamp": "02:05:49", "text": "天然泉水"}, {"type": "subtitle", "time": 7551.51, "timestamp": "02:05:51", "text": "从鼻子里出来。天然泉水流出"}, {"type": "subtitle", "time": 7559.27, "timestamp": "02:05:59", "text": "等等，那是什么？我们刚才在说什么？"}]
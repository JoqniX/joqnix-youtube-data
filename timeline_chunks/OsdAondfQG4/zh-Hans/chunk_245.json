[{"type": "subtitle", "time": 14700.91, "timestamp": "04:05:00", "text": "东西。我的天哪，水……"}, {"type": "subtitle", "time": 14704.229, "timestamp": "04:05:04", "text": "水花四溅。他们应该来。别走。"}, {"type": "subtitle", "time": 14705.75, "timestamp": "04:05:05", "text": "顺便说一句，它是一只直立的狗狗。我"}, {"type": "subtitle", "time": 14708.71, "timestamp": "04:05:08", "text": "希望我不会被咬。好的，再见。"}, {"type": "subtitle", "time": 14711.51, "timestamp": "04:05:11", "text": "好吧，我走过那只狗狗身边。三只狗"}, {"type": "subtitle", "time": 14720.55, "timestamp": "04:05:20", "text": "是的。好的，我从他们身边经过了。我们走吧。"}, {"type": "subtitle", "time": 14724.229, "timestamp": "04:05:24", "text": "等等，那是个大浪。我的天哪，快看"}, {"type": "subtitle", "time": 14726.269, "timestamp": "04:05:26", "text": "在那座大城市"}, {"type": "subtitle", "time": 14728.95, "timestamp": "04:05:28", "text": "海浪。说实话，我没有"}, {"type": "subtitle", "time": 14732.349, "timestamp": "04:05:32", "text": "我知道我是怎么学会的。"}, {"type": "subtitle", "time": 14735.79, "timestamp": "04:05:35", "text": "回到我的地理课上"}, {"type": "subtitle", "time": 14738.11, "timestamp": "04:05:38", "text": "某物。那可真够长的。"}, {"type": "subtitle", "time": 14741.75, "timestamp": "04:05:41", "text": "后退。所以，呃，我不太清楚该怎么做。"}, {"type": "subtitle", "time": 14743.87, "timestamp": "04:05:43", "text": "海洋发挥作用。"}, {"type": "subtitle", "time": 14748.71, "timestamp": "04:05:48", "text": "为什么它在很远的地方也如此稳定？"}, {"type": "subtitle", "time": 14751.67, "timestamp": "04:05:51", "text": "就像是那种很不规律的拉扯。"}, {"type": "subtitle", "time": 14755.51, "timestamp": "04:05:55", "text": "发出类似波浪类型的波浪"}, {"type": "subtitle", "time": 14759.51, "timestamp": "04:05:59", "text": "是啊，波浪，波浪，呃，波浪是怎么形成的？"}]
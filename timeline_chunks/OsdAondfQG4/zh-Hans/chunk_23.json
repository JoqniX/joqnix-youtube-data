[{"type": "subtitle", "time": 1380.47, "timestamp": "00:23:00", "text": "你今年多大？哇。是的，她确实"}, {"type": "subtitle", "time": 1384.39, "timestamp": "00:23:04", "text": "问过这个问题。哇。我也很害怕"}, {"type": "subtitle", "time": 1387.35, "timestamp": "00:23:07", "text": "问别人多大年纪是因为……"}, {"type": "subtitle", "time": 1388.71, "timestamp": "00:23:08", "text": "是不是有点过头了？"}, {"type": "subtitle", "time": 1390.39, "timestamp": "00:23:10", "text": "尤其是对女孩或男孩来说"}, {"type": "subtitle", "time": 1393.11, "timestamp": "00:23:13", "text": "某物。我不知道。我很害怕。"}, {"type": "subtitle", "time": 1396.149, "timestamp": "00:23:16", "text": "现在几点了？"}, {"type": "subtitle", "time": 1400.39, "timestamp": "00:23:20", "text": "哦，对我来说是10。呃，10:11"}, {"type": "subtitle", "time": 1403.11, "timestamp": "00:23:23", "text": "晚上10点11分"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "我觉得这就像几乎要……"}, {"type": "subtitle", "time": 1415.549, "timestamp": "00:23:35", "text": "[音乐]"}, {"type": "subtitle", "time": 1419.51, "timestamp": "00:23:39", "text": "下午我该如何读你的名字？哦，"}, {"type": "subtitle", "time": 1427.83, "timestamp": "00:23:47", "text": "是的。"}, {"type": "subtitle", "time": 1431.51, "timestamp": "00:23:51", "text": "开玩笑。哦，那会更容易些。"}, {"type": "subtitle", "time": 1433.75, "timestamp": "00:23:53", "text": "嗯。"}, {"type": "subtitle", "time": 1435.83, "timestamp": "00:23:55", "text": "哦，你可以叫任何你想叫的名字。"}, {"type": "subtitle", "time": 1437.669, "timestamp": "00:23:57", "text": "美好的。无论哪种方式让你感到舒适"}]
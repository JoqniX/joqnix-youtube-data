[{"type": "subtitle", "time": 14040.51, "timestamp": "03:54:00", "text": "别介意我只是入侵一下"}, {"type": "subtitle", "time": 14049.03, "timestamp": "03:54:09", "text": "但我认为他们不会认识我。"}, {"type": "subtitle", "time": 14051.87, "timestamp": "03:54:11", "text": "让我系好鞋带吧"}, {"type": "subtitle", "time": 14054.91, "timestamp": "03:54:14", "text": "方式。我不认为有人活着"}, {"type": "subtitle", "time": 14057.55, "timestamp": "03:54:17", "text": "这里。让我把它系好"}, {"type": "subtitle", "time": 14065.95, "timestamp": "03:54:25", "text": "本身。我不想让它散开。"}, {"type": "subtitle", "time": 14068.59, "timestamp": "03:54:28", "text": "那。我甚至"}, {"type": "subtitle", "time": 14074.95, "timestamp": "03:54:34", "text": "为什么？你知道吗？我要把"}, {"type": "subtitle", "time": 14083.83, "timestamp": "03:54:43", "text": "你知道，每当我试图倾斜和放置的时候"}]
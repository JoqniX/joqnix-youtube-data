[{"type": "subtitle", "time": 6362.629, "timestamp": "01:46:02", "text": "我和老朋友们一起看的那些"}, {"type": "subtitle", "time": 6364.709, "timestamp": "01:46:04", "text": "就像我以前看的那种东西之类的"}, {"type": "subtitle", "time": 6367.99, "timestamp": "01:46:07", "text": "或者喜欢和……一起玩，当我……当我"}, {"type": "subtitle", "time": 6370.87, "timestamp": "01:46:10", "text": "看着他们成长为主播，"}, {"type": "subtitle", "time": 6373.31, "timestamp": "01:46:13", "text": "我不知道。看着我，我感到很自豪。"}, {"type": "subtitle", "time": 6376.39, "timestamp": "01:46:16", "text": "因为他们，因为我不像我，哦，我以前……"}, {"type": "subtitle", "time": 6378.55, "timestamp": "01:46:18", "text": "认识这个人。你知道，他们是"}, {"type": "subtitle", "time": 6383.189, "timestamp": "01:46:23", "text": "更确切地说，我为你感到骄傲。"}, {"type": "subtitle", "time": 6384.79, "timestamp": "01:46:24", "text": "你知道我的意思？看看你。"}, {"type": "subtitle", "time": 6387.669, "timestamp": "01:46:27", "text": "也看看你吧。你已经"}, {"type": "subtitle", "time": 6391.43, "timestamp": "01:46:31", "text": "长大了。嘿，我不知道。你已经成长了"}, {"type": "subtitle", "time": 6394.669, "timestamp": "01:46:34", "text": "收视率，或许还有点喜欢"}, {"type": "subtitle", "time": 6399.109, "timestamp": "01:46:39", "text": "就数量而言，呃，就角色而言或许如此。"}, {"type": "subtitle", "time": 6400.229, "timestamp": "01:46:40", "text": "我不知道。我不知道"}, {"type": "subtitle", "time": 6402.39, "timestamp": "01:46:42", "text": "性格，因为我们还没有真正"}, {"type": "subtitle", "time": 6406.51, "timestamp": "01:46:46", "text": "互动方式不仅仅是像《命运》那样。"}, {"type": "subtitle", "time": 6409.39, "timestamp": "01:46:49", "text": "是的。我们应该在以下方面进行更多互动："}, {"type": "subtitle", "time": 6413.03, "timestamp": "01:46:53", "text": "未来，一起出去玩什么的。"}]
[{"type": "subtitle", "time": 8581.67, "timestamp": "02:23:01", "text": "我为什么要这样做，以及撇开其他因素不谈"}, {"type": "subtitle", "time": 8585.63, "timestamp": "02:23:05", "text": "在印度，一个人的事儿，科菲没有"}, {"type": "subtitle", "time": 8589.11, "timestamp": "02:23:09", "text": "工作很悲哀，而且 Stripe 也不起作用。"}, {"type": "subtitle", "time": 8591.349, "timestamp": "02:23:11", "text": "所以，这样做会带来一些复杂情况。"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "Stripe 和 PayPal 无法正常工作"}, {"type": "subtitle", "time": 8596.79, "timestamp": "02:23:16", "text": "我不想泄露自己的个人信息。"}, {"type": "subtitle", "time": 8602.349, "timestamp": "02:23:22", "text": "UPI支付，是的，我有很多"}, {"type": "subtitle", "time": 8605.349, "timestamp": "02:23:25", "text": "我不得不依赖平台的事情"}, {"type": "subtitle", "time": 8608.15, "timestamp": "02:23:28", "text": "YouTube 和 Twitch 之类的东西，谢天谢地"}, {"type": "subtitle", "time": 8611.309, "timestamp": "02:23:31", "text": "我弄到了YouTube。"}, {"type": "subtitle", "time": 8615.95, "timestamp": "02:23:35", "text": "会员资格等等。所以当时就是这样。"}, {"type": "subtitle", "time": 8617.63, "timestamp": "02:23:37", "text": "那。"}, {"type": "subtitle", "time": 8621.19, "timestamp": "02:23:41", "text": "对，就是这样。所以当时我就想，我"}, {"type": "subtitle", "time": 8624.309, "timestamp": "02:23:44", "text": "感觉有点奇怪，就像在想“嗯，为什么？”"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "人们确实喜欢这样想。"}, {"type": "subtitle", "time": 8628.71, "timestamp": "02:23:48", "text": "过渡方式。我明白她"}, {"type": "subtitle", "time": 8633.429, "timestamp": "02:23:53", "text": "背后的过程很繁琐，但没错，他们确实如此。"}, {"type": "subtitle", "time": 8636.469, "timestamp": "02:23:56", "text": "就像好吧，和我一起玩。"}, {"type": "subtitle", "time": 8639.03, "timestamp": "02:23:59", "text": "一起玩些游戏之类的，因为我"}]
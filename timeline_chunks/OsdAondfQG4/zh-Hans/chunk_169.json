[{"type": "subtitle", "time": 10145.67, "timestamp": "02:49:05", "text": "分钟。我在看着你。我很好。我是"}, {"type": "subtitle", "time": 10147.429, "timestamp": "02:49:07", "text": "边走边看着你。啊，好"}, {"type": "subtitle", "time": 10168.269, "timestamp": "02:49:28", "text": "呃"}, {"type": "subtitle", "time": 10172.269, "timestamp": "02:49:32", "text": "是的，凯蒂"}, {"type": "subtitle", "time": 10181.59, "timestamp": "02:49:41", "text": "出色地。希望你一切都好。等待，"}, {"type": "subtitle", "time": 10183.269, "timestamp": "02:49:43", "text": "等等，等等，等等。我得从……那里得到它"}, {"type": "subtitle", "time": 10198.269, "timestamp": "02:49:58", "text": "它。呃，我可以发条消息吗？"}]
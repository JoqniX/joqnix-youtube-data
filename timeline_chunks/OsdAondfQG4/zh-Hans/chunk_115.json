[{"type": "subtitle", "time": 6906.87, "timestamp": "01:55:06", "text": "我比较喜欢柔软的那款。"}, {"type": "subtitle", "time": 6909.55, "timestamp": "01:55:09", "text": "我也是。我的意思是，这要看情况。我喜欢"}, {"type": "subtitle", "time": 6912.629, "timestamp": "01:55:12", "text": "柔软，但又有点像触觉。一个"}, {"type": "subtitle", "time": 6917.03, "timestamp": "01:55:17", "text": "触觉反馈较弱。是的，有点触觉。"}, {"type": "subtitle", "time": 6918.87, "timestamp": "01:55:18", "text": "我只是想知道它为什么推动了我"}, {"type": "subtitle", "time": 6920.87, "timestamp": "01:55:20", "text": "按钮。因为现在我的键盘是"}, {"type": "subtitle", "time": 6922.75, "timestamp": "01:55:22", "text": "只是一个"}, {"type": "subtitle", "time": 6925.91, "timestamp": "01:55:25", "text": "手感顺滑的樱桃轴。"}, {"type": "subtitle", "time": 6933.27, "timestamp": "01:55:33", "text": "是的。我不知道。我想，我想"}, {"type": "subtitle", "time": 6934.189, "timestamp": "01:55:34", "text": "得到"}, {"type": "subtitle", "time": 6936.03, "timestamp": "01:55:36", "text": "不同的"}, {"type": "subtitle", "time": 6943.99, "timestamp": "01:55:43", "text": "开关。是的。我考虑过要不要去"}, {"type": "subtitle", "time": 6946.229, "timestamp": "01:55:46", "text": "变成光荣开关之类的东西。我"}, {"type": "subtitle", "time": 6947.75, "timestamp": "01:55:47", "text": "键盘非常棒。我洒了。"}, {"type": "subtitle", "time": 6949.91, "timestamp": "01:55:49", "text": "上面全是咖啡渍。它非常简陋。"}, {"type": "subtitle", "time": 6957.189, "timestamp": "01:55:57", "text": "我喜欢它，因为它很简单。"}]
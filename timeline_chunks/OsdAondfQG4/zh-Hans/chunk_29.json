[{"type": "subtitle", "time": 1745.669, "timestamp": "00:29:05", "text": "当你按下“啊”键时，你就能看到你"}, {"type": "subtitle", "time": 1747.35, "timestamp": "00:29:07", "text": "看。"}, {"type": "subtitle", "time": 1756.63, "timestamp": "00:29:16", "text": "我打算拿点东西。没错"}, {"type": "subtitle", "time": 1762.149, "timestamp": "00:29:22", "text": "[音乐]"}, {"type": "subtitle", "time": 1765.63, "timestamp": "00:29:25", "text": "等等，它显示出来了？"}, {"type": "subtitle", "time": 1781.029, "timestamp": "00:29:41", "text": "她不会回来了。哦，"}, {"type": "subtitle", "time": 1783.11, "timestamp": "00:29:43", "text": "不过她在Steam上加我好友。我们"}, {"type": "subtitle", "time": 1785.669, "timestamp": "00:29:45", "text": "可以和她一起玩游戏。"}, {"type": "subtitle", "time": 1788.47, "timestamp": "00:29:48", "text": "不。那他呢？所以没关系。它是"}, {"type": "subtitle", "time": 1791.669, "timestamp": "00:29:51", "text": "好的。不用担心。我可以吗？"}, {"type": "subtitle", "time": 1793.31, "timestamp": "00:29:53", "text": "朋友"}, {"type": "subtitle", "time": 1796.389, "timestamp": "00:29:56", "text": "你？你介意加好友吗？我们"}]
[{"type": "subtitle", "time": 17701.15, "timestamp": "04:55:01", "text": "えっと、私は"}, {"type": "subtitle", "time": 17718.67, "timestamp": "04:55:18", "text": "写真。戻ってきました"}, {"type": "subtitle", "time": 17720.59, "timestamp": "04:55:20", "text": "家。ああ、"}, {"type": "subtitle", "time": 17732.51, "timestamp": "04:55:32", "text": "だから、今から私がすることは"}, {"type": "subtitle", "time": 17737.59, "timestamp": "04:55:37", "text": "急いで上がって、洗ったりして、それから"}, {"type": "subtitle", "time": 17740.23, "timestamp": "04:55:40", "text": "ちょっと泳ぎに行ってもいいか聞いてみます"}, {"type": "subtitle", "time": 17742.868, "timestamp": "04:55:42", "text": "また海へ。いいえ、いいえ、していません"}, {"type": "subtitle", "time": 17745.07, "timestamp": "04:55:45", "text": "去った。それで、"}, {"type": "subtitle", "time": 17749.75, "timestamp": "04:55:49", "text": "うん。では、それができるかどうか試してみます。"}, {"type": "subtitle", "time": 17753.788, "timestamp": "04:55:53", "text": "この1週間で満足"}, {"type": "subtitle", "time": 17756.39, "timestamp": "04:55:56", "text": "休暇。ええ、そうですね。"}, {"type": "subtitle", "time": 17758.948, "timestamp": "04:55:58", "text": "ああ、そうしたら後悔するだろうな。いいえ、私は"}]
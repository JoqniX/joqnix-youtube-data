[{"type": "subtitle", "time": 16380.07, "timestamp": "04:33:00", "text": "何て言うのか分からないと思う"}, {"type": "subtitle", "time": 16383.07, "timestamp": "04:33:03", "text": "これはもう一度私の"}, {"type": "subtitle", "time": 16386.91, "timestamp": "04:33:06", "text": "語彙が限られている"}, {"type": "subtitle", "time": 16391.029, "timestamp": "04:33:11", "text": "行くよ、でもそう、私たちは文字通りストリーミングしている"}, {"type": "subtitle", "time": 16393.23, "timestamp": "04:33:13", "text": "1時間もなんて"}, {"type": "subtitle", "time": 16396.47, "timestamp": "04:33:16", "text": "神様、昨日私たちは実際に"}, {"type": "subtitle", "time": 16400.39, "timestamp": "04:33:20", "text": "またもや1時間23分。えっと、私は"}, {"type": "subtitle", "time": 16408.789, "timestamp": "04:33:28", "text": "そこで私はより長い期間"}, {"type": "subtitle", "time": 16411.629, "timestamp": "04:33:31", "text": "座ってるからストリームするけど"}, {"type": "subtitle", "time": 16414.789, "timestamp": "04:33:34", "text": "モバイルデータが制限されているため、私は制限されています"}, {"type": "subtitle", "time": 16417.91, "timestamp": "04:33:37", "text": "電話のバッテリーは1つです"}, {"type": "subtitle", "time": 16419.91, "timestamp": "04:33:39", "text": "だからバッテリーが必要なのです"}, {"type": "subtitle", "time": 16422.551, "timestamp": "04:33:42", "text": "パック。そういえば、確認する必要がある"}, {"type": "subtitle", "time": 16431.31, "timestamp": "04:33:51", "text": "パック。ああ、疲れ果ててしまう"}, {"type": "subtitle", "time": 16433.99, "timestamp": "04:33:53", "text": "多くの。ああ、もう、まるで"}, {"type": "subtitle", "time": 16436.07, "timestamp": "04:33:56", "text": "クレイジー。あのね？削除します"}, {"type": "subtitle", "time": 16438.349, "timestamp": "04:33:58", "text": "チャール"}]
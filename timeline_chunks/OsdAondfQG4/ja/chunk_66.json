[{"type": "subtitle", "time": 3961.029, "timestamp": "01:06:01", "text": "ゲームの話をするだけ、または、ゲームをすることができます"}, {"type": "subtitle", "time": 3963.589, "timestamp": "01:06:03", "text": "話したいならどうぞ。ああ、ただ話せばいいんだよ"}, {"type": "subtitle", "time": 3971.19, "timestamp": "01:06:11", "text": "うん。"}, {"type": "subtitle", "time": 3974.47, "timestamp": "01:06:14", "text": "話し合ってみるのもいいでしょう。はい。はい。"}, {"type": "subtitle", "time": 3976.15, "timestamp": "01:06:16", "text": "試合の計画を立てて話し合わない限りは。私たちは"}, {"type": "subtitle", "time": 3978.309, "timestamp": "01:06:18", "text": "ゲームもできるし、会話もできる。ええ、できますよ。"}, {"type": "subtitle", "time": 3981.309, "timestamp": "01:06:21", "text": "うん。えっと、どんなゲームをお持ちですか？うん。"}, {"type": "subtitle", "time": 3984.51, "timestamp": "01:06:24", "text": "うん。えっと、どんなゲームですか"}, {"type": "subtitle", "time": 3987.67, "timestamp": "01:06:27", "text": "インストールしましたか？ゲームをいくつか持っています。"}, {"type": "subtitle", "time": 3994.71, "timestamp": "01:06:34", "text": "え、具合が悪いんですか？"}, {"type": "subtitle", "time": 3996.71, "timestamp": "01:06:36", "text": "いいえ、違います。私は違います。ただ咳をしているだけです。"}, {"type": "subtitle", "time": 3999.75, "timestamp": "01:06:39", "text": "咳をしている。はい、わかりました。もしあなたがそうだったら、私は"}, {"type": "subtitle", "time": 4002.23, "timestamp": "01:06:42", "text": "もし私がそうだったら、私はあなたがそうするだろう"}, {"type": "subtitle", "time": 4004.069, "timestamp": "01:06:44", "text": "もしあなたがそうだったら、私はあなたをやけどさせていただろう"}, {"type": "subtitle", "time": 4006.029, "timestamp": "01:06:46", "text": "私に教えてくれなかったことに対して。私はできた"}, {"type": "subtitle", "time": 4008.589, "timestamp": "01:06:48", "text": "別の日程に変更しました。ああ、私は違う"}, {"type": "subtitle", "time": 4010.87, "timestamp": "01:06:50", "text": "病気。咳はたくさん出るだろうけど"}, {"type": "subtitle", "time": 4013.91, "timestamp": "01:06:53", "text": "喉が渇いているからです。水を飲みましょう。私"}, {"type": "subtitle", "time": 4016.71, "timestamp": "01:06:56", "text": "意思。レポをプレイしよう。そうそう。リポジトリ"}]
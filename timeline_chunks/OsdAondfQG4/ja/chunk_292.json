[{"type": "subtitle", "time": 17520.83, "timestamp": "04:52:00", "text": "家に帰ってきました。"}, {"type": "subtitle", "time": 17523.27, "timestamp": "04:52:03", "text": "そうですね、今朝はこれをやりたいのですが"}, {"type": "subtitle", "time": 17525.43, "timestamp": "04:52:05", "text": "歩くもの。これは楽しそうですね？"}, {"type": "subtitle", "time": 17527.47, "timestamp": "04:52:07", "text": "ストリーミング配信するので、"}, {"type": "subtitle", "time": 17530.15, "timestamp": "04:52:10", "text": "味を覚えて以来、すべて"}, {"type": "subtitle", "time": 17531.15, "timestamp": "04:52:11", "text": "携帯"}, {"type": "subtitle", "time": 17535.35, "timestamp": "04:52:15", "text": "ストリーミング配信で、外出するのが楽しみです"}, {"type": "subtitle", "time": 17538.948, "timestamp": "04:52:18", "text": "散歩道と小川。何が"}, {"type": "subtitle", "time": 17541.55, "timestamp": "04:52:21", "text": "より良いタイミングは"}, {"type": "subtitle", "time": 17544.31, "timestamp": "04:52:24", "text": "ストリーム？え、どういう意味ですか？ 50％"}, {"type": "subtitle", "time": 17547.67, "timestamp": "04:52:27", "text": "毎日、木材を支払った。ああ、いや、私は思う"}, {"type": "subtitle", "time": 17549.15, "timestamp": "04:52:29", "text": "終わらせる必要がある"}, {"type": "subtitle", "time": 17553.31, "timestamp": "04:52:33", "text": "すぐに配信してください。あのね？"}, {"type": "subtitle", "time": 17556.47, "timestamp": "04:52:36", "text": "3,500ビットレート。モバイルデータ通信量を大量に消費します"}, {"type": "subtitle", "time": 17559.75, "timestamp": "04:52:39", "text": "データ。これはまずい。悪い。モバイルが必要です"}, {"type": "subtitle", "time": 17562.39, "timestamp": "04:52:42", "text": "家に帰ったらデータを確認します。いいえ。"}, {"type": "subtitle", "time": 17565.27, "timestamp": "04:52:45", "text": "電車。 4時間くらいかかる道のりです。私は"}, {"type": "subtitle", "time": 17567.15, "timestamp": "04:52:47", "text": "時計。私は"}, {"type": "subtitle", "time": 17570.15, "timestamp": "04:52:50", "text": "時計。曲をいくつか聴く必要がある。"}, {"type": "subtitle", "time": 17572.39, "timestamp": "04:52:52", "text": "いや、違う。私が何をしてきたか、あなたは知っているでしょう。"}, {"type": "subtitle", "time": 17575.59, "timestamp": "04:52:55", "text": "最近は毎日ですか？私はただ"}, {"type": "subtitle", "time": 17577.83, "timestamp": "04:52:57", "text": "音楽を聴くのが好きです。もしあなたが"}, {"type": "subtitle", "time": 17579.708, "timestamp": "04:52:59", "text": "私をストーキングしている"}]
[{"type": "subtitle", "time": 7980.39, "timestamp": "02:13:00", "text": "Twitchから移籍したのは、Kickの方が報酬が良いから。"}, {"type": "subtitle", "time": 7982.39, "timestamp": "02:13:02", "text": "おお"}, {"type": "subtitle", "time": 7985.589, "timestamp": "02:13:05", "text": "うん。アスミンがTTOに行くと、"}, {"type": "subtitle", "time": 7988.95, "timestamp": "02:13:08", "text": "大手ストリーマーがキックしに行ったところ、"}, {"type": "subtitle", "time": 7991.83, "timestamp": "02:13:11", "text": "銀行を今すぐにでもすぐに、すぐに"}, {"type": "subtitle", "time": 7994.629, "timestamp": "02:13:14", "text": "Twitchが1つか2つのストリームを配信している間"}, {"type": "chat", "time": 7997.768, "timestamp": "02:13:17", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "assmongol"}, {"type": "subtitle", "time": 7998.75, "timestamp": "02:13:18", "text": "彼らがそれだけの金額を手に入れるのに30日以上かかる"}, {"type": "subtitle", "time": 8011.03, "timestamp": "02:13:31", "text": "キックパートナーの件を確認します。彼らは"}, {"type": "subtitle", "time": 8012.51, "timestamp": "02:13:32", "text": "許可する"}, {"type": "subtitle", "time": 8014.95, "timestamp": "02:13:34", "text": "マルチリーミング。それはすばらしい。たとえ"}, {"type": "subtitle", "time": 8017.589, "timestamp": "02:13:37", "text": "あなたは独占パートナーです、彼らは許可します"}, {"type": "subtitle", "time": 8021.51, "timestamp": "02:13:41", "text": "マルチリーミング。それはなかなかクールだね。"}, {"type": "subtitle", "time": 8025.55, "timestamp": "02:13:45", "text": "ええ、私にはわかりません。ピクは本当に良い"}, {"type": "subtitle", "time": 8027.87, "timestamp": "02:13:47", "text": "どうすればいいですか"}, {"type": "subtitle", "time": 8031.75, "timestamp": "02:13:51", "text": "マーケティングとは言わないけど、"}, {"type": "subtitle", "time": 8034.47, "timestamp": "02:13:54", "text": "上層部を説得するのが本当に上手"}, {"type": "subtitle", "time": 8038.39, "timestamp": "02:13:58", "text": "より高い報酬を支払った視聴者ではなく、より高い報酬を支払った視聴者"}]
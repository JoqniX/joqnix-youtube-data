[{"type": "subtitle", "time": 9900.309, "timestamp": "02:45:00", "text": "昨晩。私は起きていました"}, {"type": "chat", "time": 9900.722, "timestamp": "02:45:00", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "🫂"}, {"type": "subtitle", "time": 9902.389, "timestamp": "02:45:02", "text": "8時。それから私は「ああ、私は"}, {"type": "subtitle", "time": 9904.309, "timestamp": "02:45:04", "text": "コラボレーション。 「じゃあ寝よう。」そして私は眠った。"}, {"type": "subtitle", "time": 9907.19, "timestamp": "02:45:07", "text": "そして11時30分に目が覚めた。それは嬉しいことです。私"}, {"type": "subtitle", "time": 9909.83, "timestamp": "02:45:09", "text": "目が覚めてよかった。 30分に目が覚めた"}, {"type": "subtitle", "time": 9911.99, "timestamp": "02:45:11", "text": "少なくとも数分前には到着する。そうでなければ私は"}, {"type": "chat", "time": 9916.494, "timestamp": "02:45:16", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "take care of yourself then sir ji"}, {"type": "subtitle", "time": 9923.87, "timestamp": "02:45:23", "text": "ええ、そうです"}, {"type": "subtitle", "time": 9925.87, "timestamp": "02:45:25", "text": "非常識な。"}, {"type": "subtitle", "time": 9929.11, "timestamp": "02:45:29", "text": "ソフィア、これが私が頼らなければならないものだ"}, {"type": "subtitle", "time": 9931.349, "timestamp": "02:45:31", "text": "3つは、私が行かなければならないような"}, {"type": "subtitle", "time": 9936.469, "timestamp": "02:45:36", "text": "スーツを仕立てる。測定する"}, {"type": "subtitle", "time": 9939.79, "timestamp": "02:45:39", "text": "スーツが"}, {"type": "subtitle", "time": 9942.389, "timestamp": "02:45:42", "text": "次は日本に行くので、それは良いことだ"}, {"type": "subtitle", "time": 9945.429, "timestamp": "02:45:45", "text": "月。そうそう。ああ、カイ"}, {"type": "subtitle", "time": 9948.71, "timestamp": "02:45:48", "text": "スーツのフォーマルな服装は？"}, {"type": "subtitle", "time": 9952.429, "timestamp": "02:45:52", "text": "もの？フォーマルな服装は、黒のスーツのようなものです。"}, {"type": "subtitle", "time": 9956.23, "timestamp": "02:45:56", "text": "右？今のところスーツは2着あります"}, {"type": "subtitle", "time": 9959.59, "timestamp": "02:45:59", "text": "いとこや叔父たちが教えてくれたことによると"}]
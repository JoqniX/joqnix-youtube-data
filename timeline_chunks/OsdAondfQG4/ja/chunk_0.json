[{"type": "subtitle", "time": 8.19, "timestamp": "00:00:08", "text": "中国。おお"}, {"type": "subtitle", "time": 30.79, "timestamp": "00:00:30", "text": "時間。大丈夫。"}, {"type": "subtitle", "time": 33.19, "timestamp": "00:00:33", "text": "ジョー先生、教えてください。何をすればいいですか"}, {"type": "subtitle", "time": 35.67, "timestamp": "00:00:35", "text": "あなたに教える？ストリームに入力できますか？"}, {"type": "subtitle", "time": 36.95, "timestamp": "00:00:36", "text": "なぜなら、正確に確認する必要があるからです"}, {"type": "subtitle", "time": 38.869, "timestamp": "00:00:38", "text": "スペルミスがあると動作しません。私にさせて"}, {"type": "subtitle", "time": 43.63, "timestamp": "00:00:43", "text": "待って。"}, {"type": "subtitle", "time": 46.43, "timestamp": "00:00:46", "text": "ブロックマンゴー"}, {"type": "subtitle", "time": 49.43, "timestamp": "00:00:49", "text": "まさに適任者だ。私は今、複数のことを同時にこなしています。私はしません"}, {"type": "subtitle", "time": 50.91, "timestamp": "00:00:50", "text": "ああ、"}, {"type": "subtitle", "time": 56.51, "timestamp": "00:00:56", "text": "神。えーと、大文字のJ、大文字のX"}]
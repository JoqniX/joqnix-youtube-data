[{"type": "subtitle", "time": 9361.15, "timestamp": "02:36:01", "text": "えっと、私が言ってたのは、"}, {"type": "subtitle", "time": 9362.87, "timestamp": "02:36:02", "text": "えーと"}, {"type": "subtitle", "time": 9365.75, "timestamp": "02:36:05", "text": "ああ、しまった、忘れてた。"}, {"type": "subtitle", "time": 9378.91, "timestamp": "02:36:18", "text": "心配事。おお"}, {"type": "subtitle", "time": 9382.71, "timestamp": "02:36:22", "text": "神。あなたが私を助けてくれたことだけを覚えている"}, {"type": "subtitle", "time": 9386.11, "timestamp": "02:36:26", "text": "覚えておいてください、私は連絡を取らなければなりませんでした"}, {"type": "subtitle", "time": 9387.63, "timestamp": "02:36:27", "text": "に"}, {"type": "subtitle", "time": 9392.309, "timestamp": "02:36:32", "text": "年配の人を好む人たち。知っている"}, {"type": "subtitle", "time": 9397.27, "timestamp": "02:36:37", "text": "昔からのみんな。"}, {"type": "subtitle", "time": 9399.59, "timestamp": "02:36:39", "text": "うん。"}, {"type": "subtitle", "time": 9405.83, "timestamp": "02:36:45", "text": "グループコラボのSubiのようなもの"}, {"type": "subtitle", "time": 9415.83, "timestamp": "02:36:55", "text": "まだ配信してるの？だから、あなたは知っている"}]
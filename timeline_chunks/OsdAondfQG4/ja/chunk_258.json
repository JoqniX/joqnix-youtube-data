[{"type": "subtitle", "time": 15492.67, "timestamp": "04:18:12", "text": "カートリッジのようなものは付いていません"}, {"type": "subtitle", "time": 15496.149, "timestamp": "04:18:16", "text": "弾薬みたいなやつ、右に挿入して"}, {"type": "subtitle", "time": 15499.03, "timestamp": "04:18:19", "text": "私が話していたピストルとその他諸々"}, {"type": "subtitle", "time": 15501.269, "timestamp": "04:18:21", "text": "誰かが文字通り誰かの"}, {"type": "subtitle", "time": 15505.11, "timestamp": "04:18:25", "text": "ビーチの海岸近くの財布"}, {"type": "subtitle", "time": 15507.83, "timestamp": "04:18:27", "text": "獣医を呼んでいるところです"}, {"type": "subtitle", "time": 15511.07, "timestamp": "04:18:31", "text": "でも私はただ通り過ぎただけ"}, {"type": "subtitle", "time": 15513.469, "timestamp": "04:18:33", "text": "そこには。しかし"}, {"type": "subtitle", "time": 15516.51, "timestamp": "04:18:36", "text": "うん。わかった。うん。道がわからない"}, {"type": "subtitle", "time": 15527.349, "timestamp": "04:18:47", "text": "でも、8か9になると"}, {"type": "subtitle", "time": 15531.349, "timestamp": "04:18:51", "text": "朝は、とても暑くなるでしょう"}, {"type": "subtitle", "time": 15533.87, "timestamp": "04:18:53", "text": "つまり、"}, {"type": "subtitle", "time": 15537.429, "timestamp": "04:18:57", "text": "サンシャイン。彼は太陽のために待った。うん、"}, {"type": "subtitle", "time": 15539.189, "timestamp": "04:18:59", "text": "太陽のせいで、それは一種の"}]
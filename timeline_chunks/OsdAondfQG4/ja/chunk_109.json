[{"type": "subtitle", "time": 6545.03, "timestamp": "01:49:05", "text": "自分？私のせいじゃない。とても美味しい"}, {"type": "subtitle", "time": 6548.55, "timestamp": "01:49:08", "text": "マーケティングと私を惹きつけることに長けている。"}, {"type": "subtitle", "time": 6556.07, "timestamp": "01:49:16", "text": "うん。なんてこった。彼らはただ彼らは"}, {"type": "subtitle", "time": 6565.27, "timestamp": "01:49:25", "text": "NvidiaってIntelの子会社じゃないの？"}, {"type": "subtitle", "time": 6568.83, "timestamp": "01:49:28", "text": "え、そうなの？待って。"}, {"type": "subtitle", "time": 6572.229, "timestamp": "01:49:32", "text": "はぁ？いいえ。もしNvidiaがIntelの傘下だったら、"}, {"type": "subtitle", "time": 6574.229, "timestamp": "01:49:34", "text": "それならなぜインテルグラフィックスを作るのか"}, {"type": "subtitle", "time": 6581.91, "timestamp": "01:49:41", "text": "何"}, {"type": "subtitle", "time": 6585.189, "timestamp": "01:49:45", "text": "ありますか？ Intel製グラフィックスは搭載されていますか？"}, {"type": "subtitle", "time": 6594.07, "timestamp": "01:49:54", "text": "がある。うん、"}]
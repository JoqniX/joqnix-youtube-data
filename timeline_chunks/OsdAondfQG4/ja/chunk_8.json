[{"type": "subtitle", "time": 489.11, "timestamp": "00:08:09", "text": "ええ、私も同じでした"}, {"type": "subtitle", "time": 492.23, "timestamp": "00:08:12", "text": "日本人もです。知ってるよ、話さないで"}, {"type": "subtitle", "time": 500.23, "timestamp": "00:08:20", "text": "でも、日本人と一緒にいるときはいつも"}, {"type": "subtitle", "time": 502.71, "timestamp": "00:08:22", "text": "日本語を知っている人、"}, {"type": "subtitle", "time": 506.23, "timestamp": "00:08:26", "text": "時々、私の口からこんな言葉が出てくる"}, {"type": "subtitle", "time": 507.83, "timestamp": "00:08:27", "text": "何を言えばいいのかわからないけれど、"}, {"type": "subtitle", "time": 511.11, "timestamp": "00:08:31", "text": "でもそれは偶然か、ごめんなさい"}, {"type": "subtitle", "time": 526.07, "timestamp": "00:08:46", "text": "日本語はどの程度話せますか？ああ、私の日本語が。"}, {"type": "subtitle", "time": 527.59, "timestamp": "00:08:47", "text": "いいえ、"}, {"type": "subtitle", "time": 530.07, "timestamp": "00:08:50", "text": "正直に言うと、分かりません。えっと、私は"}, {"type": "subtitle", "time": 532.31, "timestamp": "00:08:52", "text": "日本語の学習を始めたきっかけは"}, {"type": "subtitle", "time": 533.389, "timestamp": "00:08:53", "text": "アニメと"}, {"type": "subtitle", "time": 537.509, "timestamp": "00:08:57", "text": "日本のドラマとか、そういうの全部好き。私"}]
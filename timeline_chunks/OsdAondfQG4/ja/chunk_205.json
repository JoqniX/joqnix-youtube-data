[{"type": "subtitle", "time": 12300.03, "timestamp": "03:25:00", "text": "すべて。離れる、"}, {"type": "subtitle", "time": 12302.71, "timestamp": "03:25:02", "text": "右？私は考えなければならない"}, {"type": "subtitle", "time": 12307.03, "timestamp": "03:25:07", "text": "目玉のもの。ゴーゴーゴーゴーゴーその間"}, {"type": "subtitle", "time": 12311.11, "timestamp": "03:25:11", "text": "外で何かをして、その間に入って来る"}, {"type": "subtitle", "time": 12312.87, "timestamp": "03:25:12", "text": "戻って、崩壊させて、終わらせる"}, {"type": "subtitle", "time": 12315.469, "timestamp": "03:25:15", "text": "オフにして"}, {"type": "subtitle", "time": 12322.87, "timestamp": "03:25:22", "text": "もの。睡眠不足は異常だ。"}, {"type": "chat", "time": 12324.37, "timestamp": "03:25:24", "author": "@PanditJi.Y", "avatar": "https://yt4.ggpht.com/dbuBEqO3mJ9DX4Uu_LhA4jdzC_POgn5GfeMyztO06j5c73okFxwnXUaKWurMIj0mYXB_y53S_Q=s64-c-k-c0x00ffffff-no-rj", "message": "when are u leaving for japan?"}, {"type": "subtitle", "time": 12324.83, "timestamp": "03:25:24", "text": "ディオ、私の体は"}, {"type": "subtitle", "time": 12326.91, "timestamp": "03:25:26", "text": "腐敗、"}, {"type": "subtitle", "time": 12329.87, "timestamp": "03:25:29", "text": "正直に。でも、やらなきゃいけない"}, {"type": "subtitle", "time": 12333.03, "timestamp": "03:25:33", "text": "それ。それでも私を見てください。依然として魅力的"}, {"type": "subtitle", "time": 12334.91, "timestamp": "03:25:34", "text": "もっと"}, {"type": "subtitle", "time": 12338.79, "timestamp": "03:25:38", "text": "人々。 30日。私は最後に去​​ります"}, {"type": "subtitle", "time": 12343.19, "timestamp": "03:25:43", "text": "週。先週。うん。 29 30 31 だと思います。"}, {"type": "subtitle", "time": 12344.71, "timestamp": "03:25:44", "text": "フライトの時刻はわかりません。病気"}, {"type": "subtitle", "time": 12352.91, "timestamp": "03:25:52", "text": "それで"}, {"type": "subtitle", "time": 12355.91, "timestamp": "03:25:55", "text": "ええ、私がコラボレーションしたいのは"}, {"type": "subtitle", "time": 12357.91, "timestamp": "03:25:57", "text": "コラボレーション。私はみんなと話したい"}, {"type": "subtitle", "time": 12359.83, "timestamp": "03:25:59", "text": "本日会合を開きました。だから私も"}]
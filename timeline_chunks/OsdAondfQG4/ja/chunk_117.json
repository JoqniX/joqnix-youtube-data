[{"type": "subtitle", "time": 7020.07, "timestamp": "01:57:00", "text": "ニース。内部が白い白いPC"}, {"type": "subtitle", "time": 7023.99, "timestamp": "01:57:03", "text": "そして、白いキーボードとマウス。私"}, {"type": "subtitle", "time": 7025.79, "timestamp": "01:57:05", "text": "わからない、たぶん中立的なマウス、ただ"}, {"type": "subtitle", "time": 7040.149, "timestamp": "01:57:20", "text": "時間。レーザーを買ってみたらどうだろう。それほどではない"}, {"type": "subtitle", "time": 7043.109, "timestamp": "01:57:23", "text": "高価でしたが、良い価格でした"}, {"type": "subtitle", "time": 7046.55, "timestamp": "01:57:26", "text": "パフォーマンス比率。レギオン。あなたは"}, {"type": "subtitle", "time": 7058.55, "timestamp": "01:57:38", "text": "うん。確認しましたか？レギオン。はぁ？"}, {"type": "subtitle", "time": 7060.149, "timestamp": "01:57:40", "text": "彼らが誰なのか全く分かりません。それは何だ"}, {"type": "subtitle", "time": 7065.91, "timestamp": "01:57:45", "text": "は？医者のように。"}, {"type": "subtitle", "time": 7071.87, "timestamp": "01:57:51", "text": "うん。言い訳"}, {"type": "subtitle", "time": 7076.31, "timestamp": "01:57:56", "text": "自分。うーん、わからない。彼らは"}, {"type": "chat", "time": 7077.028, "timestamp": "01:57:57", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "I like Redragon for the cute waifu keuboards"}]
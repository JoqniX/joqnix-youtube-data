[{"type": "subtitle", "time": 17372.11, "timestamp": "04:49:32", "text": "ねえ、それで"}, {"type": "subtitle", "time": 17374.99, "timestamp": "04:49:34", "text": "ええ、彼らは歩いているようなものです。探しています"}, {"type": "subtitle", "time": 17386.15, "timestamp": "04:49:46", "text": "神。ええ、今回は知らなかったんです"}, {"type": "subtitle", "time": 17388.51, "timestamp": "04:49:48", "text": "道に迷うか、"}, {"type": "subtitle", "time": 17392.23, "timestamp": "04:49:52", "text": "失った。それで今回は、"}, {"type": "subtitle", "time": 17395.39, "timestamp": "04:49:55", "text": "正しい場所、それは"}, {"type": "subtitle", "time": 17397.47, "timestamp": "04:49:57", "text": "良い。それで"}]
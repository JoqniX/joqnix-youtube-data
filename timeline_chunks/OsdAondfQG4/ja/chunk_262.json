[{"type": "subtitle", "time": 15722.07, "timestamp": "04:22:02", "text": "家。家はちょっと遠い。私はしなければならない"}, {"type": "subtitle", "time": 15723.79, "timestamp": "04:22:03", "text": "ウォークスルー"}, {"type": "subtitle", "time": 15734.11, "timestamp": "04:22:14", "text": "待って、ココナッツが"}, {"type": "subtitle", "time": 15737.75, "timestamp": "04:22:17", "text": "溺死した。それは文字通り、私は"}, {"type": "subtitle", "time": 15742.59, "timestamp": "04:22:22", "text": "ココナッツは海から来たものだ。待って、"}, {"type": "subtitle", "time": 15745.269, "timestamp": "04:22:25", "text": "何？そのココナッツは海から来た。"}, {"type": "subtitle", "time": 15747.429, "timestamp": "04:22:27", "text": "ちなみに、これは乾燥させたココナッツです。その"}, {"type": "subtitle", "time": 15749.75, "timestamp": "04:22:29", "text": "ちょっと濡れている。"}, {"type": "subtitle", "time": 15753.03, "timestamp": "04:22:33", "text": "えっと、私は、"}, {"type": "subtitle", "time": 15754.51, "timestamp": "04:22:34", "text": "物語または"}, {"type": "subtitle", "time": 15758.309, "timestamp": "04:22:38", "text": "何か、もしくは何かについて"}, {"type": "subtitle", "time": 15761.59, "timestamp": "04:22:41", "text": "ココナッツがどうやって旅をするか"}, {"type": "subtitle", "time": 15763.55, "timestamp": "04:22:43", "text": "世界中で、または"}, {"type": "subtitle", "time": 15766.469, "timestamp": "04:22:46", "text": "海に流れ込む何かと"}, {"type": "subtitle", "time": 15767.79, "timestamp": "04:22:47", "text": "それらすべてと同じように"}, {"type": "subtitle", "time": 15771.03, "timestamp": "04:22:51", "text": "もの。それはすごくクールだと思う。それは"}, {"type": "subtitle", "time": 15778.389, "timestamp": "04:22:58", "text": "島を訪れるとかそういうのが好きだけど、"}]
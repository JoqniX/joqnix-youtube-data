[{"type": "subtitle", "time": 3301.75, "timestamp": "00:55:01", "text": "いくつか消してください。待って、ロー、これは何"}, {"type": "subtitle", "time": 3303.349, "timestamp": "00:55:03", "text": "平均？翻訳する。待って、私は"}, {"type": "subtitle", "time": 3305.75, "timestamp": "00:55:05", "text": "翻訳してください。"}, {"type": "subtitle", "time": 3307.75, "timestamp": "00:55:07", "text": "私は怖いです。"}, {"type": "subtitle", "time": 3311.63, "timestamp": "00:55:11", "text": "一時停止操作を許可する。試す"}, {"type": "subtitle", "time": 3313.75, "timestamp": "00:55:13", "text": "[音楽]"}, {"type": "subtitle", "time": 3316.309, "timestamp": "00:55:16", "text": "Escキーを押してください。私が注目しているのは"}, {"type": "subtitle", "time": 3319.349, "timestamp": "00:55:19", "text": "配信中。連合が"}, {"type": "subtitle", "time": 3327.51, "timestamp": "00:55:27", "text": "バンド、そして"}, {"type": "subtitle", "time": 3331.589, "timestamp": "00:55:31", "text": "ああ、彼は中国出身なんだよ、知ってる？"}, {"type": "subtitle", "time": 3343.829, "timestamp": "00:55:43", "text": "息子か何か、私はそうは思わない"}, {"type": "subtitle", "time": 3353.109, "timestamp": "00:55:53", "text": "[音楽]"}, {"type": "subtitle", "time": 3356.789, "timestamp": "00:55:56", "text": "こんにちは。気をつけて。わかった。わかった。"}, {"type": "subtitle", "time": 3359.589, "timestamp": "00:55:59", "text": "何てことだ。彼は中国出身です。何てことだ。"}]
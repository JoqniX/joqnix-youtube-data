[{"type": "subtitle", "time": 15967.469, "timestamp": "04:26:07", "text": "また、また、えっと、どうやって呼ぶの？"}, {"type": "subtitle", "time": 15970.75, "timestamp": "04:26:10", "text": "それ？えっと、これはどう言うんだっけ？"}, {"type": "subtitle", "time": 15979.51, "timestamp": "04:26:19", "text": "疲れた。間違った解釈をしないことを願います"}, {"type": "subtitle", "time": 15982.67, "timestamp": "04:26:22", "text": "ルート。うん。えっと、待って。私は何者だったのか"}, {"type": "subtitle", "time": 15985.389, "timestamp": "04:26:25", "text": "言っているの？待って、忘れてた。私は何者だったのか"}, {"type": "subtitle", "time": 15987.91, "timestamp": "04:26:27", "text": "言っているの？ああ、忘れてた。私は何者だったのか"}, {"type": "subtitle", "time": 15988.83, "timestamp": "04:26:28", "text": "言う"}, {"type": "subtitle", "time": 16004.349, "timestamp": "04:26:44", "text": "と言っている。まあ、そうですね。"}, {"type": "subtitle", "time": 16012.55, "timestamp": "04:26:52", "text": "ああ、本当に疲れた。私の体は実際には、"}, {"type": "subtitle", "time": 16015.99, "timestamp": "04:26:55", "text": "正直に言うと、私の体は"}, {"type": "subtitle", "time": 16019.429, "timestamp": "04:26:59", "text": "こんな風に歩くか、外に出るか、"}]
[{"type": "subtitle", "time": 3484.39, "timestamp": "00:58:04", "text": "そうそう。うん。友達を送りましたよ。"}, {"type": "subtitle", "time": 3488.109, "timestamp": "00:58:08", "text": "元気です。これはゲームボーイのジョッキーだ。"}, {"type": "subtitle", "time": 3489.63, "timestamp": "00:58:09", "text": "わかった。"}, {"type": "subtitle", "time": 3493.589, "timestamp": "00:58:13", "text": "こんにちは、ゲームボーイのダイアナ。 2秒かかった"}, {"type": "subtitle", "time": 3495.67, "timestamp": "00:58:15", "text": "同じ男だと気づいて"}, {"type": "subtitle", "time": 3497.23, "timestamp": "00:58:17", "text": "と話している"}, {"type": "subtitle", "time": 3515.109, "timestamp": "00:58:35", "text": "うん。いいえ、あなたのアバターは見えません。多分"}, {"type": "subtitle", "time": 3517.67, "timestamp": "00:58:37", "text": "あなたはまだ"}, {"type": "subtitle", "time": 3520.87, "timestamp": "00:58:40", "text": "あれ、動作が遅い？"}, {"type": "subtitle", "time": 3531.03, "timestamp": "00:58:51", "text": "[音楽]"}, {"type": "subtitle", "time": 3534.87, "timestamp": "00:58:54", "text": "はい、これであなたの姿が見えます。ああ、よかった。良い。"}, {"type": "subtitle", "time": 3537.43, "timestamp": "00:58:57", "text": "あれ、私のアバターは公開設定だと思ってたんだけど。"}]
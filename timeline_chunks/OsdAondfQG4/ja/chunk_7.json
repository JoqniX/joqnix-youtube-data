[{"type": "subtitle", "time": 421.11, "timestamp": "00:07:01", "text": "中国。ああ、中国でね。中国だけ。おお、"}, {"type": "subtitle", "time": 422.87, "timestamp": "00:07:02", "text": "だから待って。"}, {"type": "subtitle", "time": 424.95, "timestamp": "00:07:04", "text": "それで、主なことは、ああ、待って。彼らは"}, {"type": "subtitle", "time": 426.79, "timestamp": "00:07:06", "text": "Overwatchの異なるバージョン"}, {"type": "subtitle", "time": 430.629, "timestamp": "00:07:10", "text": "中国。それはルナ・チャイニーズと呼ばれています。ルナ"}, {"type": "subtitle", "time": 434.71, "timestamp": "00:07:14", "text": "中国語。それは私がこのゲームをプレイしているという意味です。私"}, {"type": "subtitle", "time": 438.51, "timestamp": "00:07:18", "text": "Overwatch 2をプレイします。"}, {"type": "subtitle", "time": 441.95, "timestamp": "00:07:21", "text": "2つを見ることができます"}, {"type": "subtitle", "time": 443.79, "timestamp": "00:07:23", "text": "で"}, {"type": "subtitle", "time": 446.67, "timestamp": "00:07:26", "text": "それが何であったか"}, {"type": "subtitle", "time": 451.67, "timestamp": "00:07:31", "text": "アメリカのサーバーやアジアのサーバーなど"}, {"type": "subtitle", "time": 454.79, "timestamp": "00:07:34", "text": "あるいは、そんな感じ。中国語ではプレイできません"}, {"type": "subtitle", "time": 457.43, "timestamp": "00:07:37", "text": "サーバ。"}, {"type": "subtitle", "time": 459.35, "timestamp": "00:07:39", "text": "わからない。"}, {"type": "subtitle", "time": 462.23, "timestamp": "00:07:42", "text": "そして、私の英語はとても下手です。こんにちは、あなたは"}, {"type": "subtitle", "time": 465.029, "timestamp": "00:07:45", "text": "最善を尽くしているんですよね？"}, {"type": "subtitle", "time": 472.87, "timestamp": "00:07:52", "text": "おお。何てことだ。"}, {"type": "subtitle", "time": 479.51, "timestamp": "00:07:59", "text": "ああ、私は決して私は決して決して私は決して"}]
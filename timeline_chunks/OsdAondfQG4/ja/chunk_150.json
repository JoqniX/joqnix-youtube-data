[{"type": "subtitle", "time": 9001.03, "timestamp": "02:30:01", "text": "そして、もしそれが"}, {"type": "subtitle", "time": 9003.19, "timestamp": "02:30:03", "text": "友達になってもいいし、DMしてもいいよ"}, {"type": "subtitle", "time": 9007.11, "timestamp": "02:30:07", "text": "そういうことですよね？あなたはそうしますか？"}, {"type": "subtitle", "time": 9009.87, "timestamp": "02:30:09", "text": "私は、私は実際には追加しません"}, {"type": "subtitle", "time": 9012.15, "timestamp": "02:30:12", "text": "人々。時々、時々私は"}, {"type": "subtitle", "time": 9015.11, "timestamp": "02:30:15", "text": "何年も誰かと話している"}, {"type": "subtitle", "time": 9018.67, "timestamp": "02:30:18", "text": "そして、私はそれらをずっと追加していません"}, {"type": "subtitle", "time": 9023.51, "timestamp": "02:30:23", "text": "時間。うん。それはおかしい、"}, {"type": "subtitle", "time": 9029.67, "timestamp": "02:30:29", "text": "信じられない。"}, {"type": "subtitle", "time": 9033.19, "timestamp": "02:30:33", "text": "うん、大好き"}, {"type": "subtitle", "time": 9034.95, "timestamp": "02:30:34", "text": "時々、私たちがそれに気付くとき"}, {"type": "subtitle", "time": 9036.71, "timestamp": "02:30:36", "text": "私たちはお互いを追加したわけではなく、ただ"}, {"type": "subtitle", "time": 9039.67, "timestamp": "02:30:39", "text": "「待って、なんてことだ、追加してないよ」"}, {"type": "subtitle", "time": 9041.51, "timestamp": "02:30:41", "text": "お互いに。そして私たちは二人とも"}, {"type": "subtitle", "time": 9043.83, "timestamp": "02:30:43", "text": "話し合っていたのに、呆然としてしまった"}, {"type": "subtitle", "time": 9049.27, "timestamp": "02:30:49", "text": "長さ。気づいていないだけ。面白いことに"}, {"type": "subtitle", "time": 9051.429, "timestamp": "02:30:51", "text": "について"}]
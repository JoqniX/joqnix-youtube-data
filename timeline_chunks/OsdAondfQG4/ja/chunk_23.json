[{"type": "subtitle", "time": 1380.47, "timestamp": "00:23:00", "text": "何歳ですか？おお。ええ、彼女は実際に"}, {"type": "subtitle", "time": 1384.39, "timestamp": "00:23:04", "text": "それを尋ねた。おお。私もすごく怖いです"}, {"type": "subtitle", "time": 1387.35, "timestamp": "00:23:07", "text": "人々に年齢を尋ねるのは、"}, {"type": "subtitle", "time": 1388.71, "timestamp": "00:23:08", "text": "ちょっとやりすぎかな？"}, {"type": "subtitle", "time": 1390.39, "timestamp": "00:23:10", "text": "特に女の子や男の子、"}, {"type": "subtitle", "time": 1393.11, "timestamp": "00:23:13", "text": "何か。わからない。私は怖いです。"}, {"type": "subtitle", "time": 1396.149, "timestamp": "00:23:16", "text": "さて、今何時ですか？"}, {"type": "subtitle", "time": 1400.39, "timestamp": "00:23:20", "text": "ああ、私にとっては10時です。ええと、10時11分です。"}, {"type": "subtitle", "time": 1403.11, "timestamp": "00:23:23", "text": "午後10時11分"}, {"type": "subtitle", "time": 1405.27, "timestamp": "00:23:25", "text": "まるで"}, {"type": "subtitle", "time": 1415.549, "timestamp": "00:23:35", "text": "[音楽]"}, {"type": "subtitle", "time": 1419.51, "timestamp": "00:23:39", "text": "午後あなたの名前はどのように読めばいいですか？おお、"}, {"type": "subtitle", "time": 1427.83, "timestamp": "00:23:47", "text": "うん。"}, {"type": "subtitle", "time": 1431.51, "timestamp": "00:23:51", "text": "ジョーク。ああ、その方が簡単だろう。"}, {"type": "subtitle", "time": 1433.75, "timestamp": "00:23:53", "text": "うん。"}, {"type": "subtitle", "time": 1435.83, "timestamp": "00:23:55", "text": "ああ、好きな名前で呼んでいいよ"}, {"type": "subtitle", "time": 1437.669, "timestamp": "00:23:57", "text": "大丈夫。どちらでも、あなたが心地よく感じる方"}]
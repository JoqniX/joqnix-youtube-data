[{"type": "subtitle", "time": 3242.23, "timestamp": "00:54:02", "text": "こんにちは、インド？ああ、ナマステと言うんですね。"}, {"type": "subtitle", "time": 3243.91, "timestamp": "00:54:03", "text": "ええ、たくさんの言語があります"}, {"type": "subtitle", "time": 3247.83, "timestamp": "00:54:07", "text": "インド。私はどれも苦手です。"}, {"type": "subtitle", "time": 3249.75, "timestamp": "00:54:09", "text": "[音楽]"}, {"type": "subtitle", "time": 3261.27, "timestamp": "00:54:21", "text": "とてもたくさんの言語"}, {"type": "subtitle", "time": 3263.309, "timestamp": "00:54:23", "text": "私は得意ではない"}, {"type": "subtitle", "time": 3266.79, "timestamp": "00:54:26", "text": "ああ、元気かどうかわからないので、あなたはこう言います"}, {"type": "subtitle", "time": 3277.15, "timestamp": "00:54:37", "text": "おお、"}, {"type": "subtitle", "time": 3290.51, "timestamp": "00:54:50", "text": "言語。それは何ですか？彼女は何者ですか？"}, {"type": "subtitle", "time": 3293.79, "timestamp": "00:54:53", "text": "言っているの？もしかしたらあなたは"}, {"type": "subtitle", "time": 3296.829, "timestamp": "00:54:56", "text": "無効にする。それは"}, {"type": "subtitle", "time": 3299.589, "timestamp": "00:54:59", "text": "彼らが話している理由。"}]
[{"type": "subtitle", "time": 4082.47, "timestamp": "01:08:02", "text": "襲撃。ええ、ダンジョンの襲撃ですね"}, {"type": "subtitle", "time": 4085.789, "timestamp": "01:08:05", "text": "あれ。ダンジョン。うん。うん。"}, {"type": "subtitle", "time": 4089.43, "timestamp": "01:08:09", "text": "うん。何てことだ。州当局はそこにいた。マンゴー"}, {"type": "subtitle", "time": 4091.109, "timestamp": "01:08:11", "text": "滞在した。"}, {"type": "subtitle", "time": 4095.829, "timestamp": "01:08:15", "text": "うん。うん。州立大学が恋しい。彼はまた"}, {"type": "subtitle", "time": 4099.669, "timestamp": "01:08:19", "text": "それ以来、活発に活動している。"}, {"type": "subtitle", "time": 4106.309, "timestamp": "01:08:26", "text": "うん。しばらく彼に会っていない。以上"}, {"type": "subtitle", "time": 4109.99, "timestamp": "01:08:29", "text": "2年だったと思う。うん。私も。"}, {"type": "subtitle", "time": 4112.149, "timestamp": "01:08:32", "text": "彼はほとんど銃撃から逃れられなかった。私は思う"}, {"type": "subtitle", "time": 4122.55, "timestamp": "01:08:42", "text": "でも、あなたが元気でいることを願っています。"}, {"type": "subtitle", "time": 4125.149, "timestamp": "01:08:45", "text": "彼が元気でいることを願っています。"}, {"type": "subtitle", "time": 4128.789, "timestamp": "01:08:48", "text": "うん。それから、すべてはどうやって"}, {"type": "subtitle", "time": 4131.969, "timestamp": "01:08:51", "text": "それ以来ずっと？私はちょっと見逃してしまった"}, {"type": "subtitle", "time": 4133.47, "timestamp": "01:08:53", "text": "[音楽]"}, {"type": "subtitle", "time": 4136.07, "timestamp": "01:08:56", "text": "すべて。そしてついに手に入れた"}, {"type": "subtitle", "time": 4139.11, "timestamp": "01:08:59", "text": "モデルとかそういうやつだよね？新型モデル。"}]
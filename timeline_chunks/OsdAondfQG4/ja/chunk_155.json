[{"type": "subtitle", "time": 9303.27, "timestamp": "02:35:03", "text": "良いアドバイスですね。素晴らしいアドバイスですね。"}, {"type": "subtitle", "time": 9305.19, "timestamp": "02:35:05", "text": "特に1位。ええ、"}, {"type": "subtitle", "time": 9312.87, "timestamp": "02:35:12", "text": "それを隠すのは難しい。いやいや、それは"}, {"type": "subtitle", "time": 9315.67, "timestamp": "02:35:15", "text": "大丈夫。大丈夫です。どうぞ。"}, {"type": "subtitle", "time": 9318.27, "timestamp": "02:35:18", "text": "私は人数を把握するように努めています"}, {"type": "subtitle", "time": 9320.51, "timestamp": "02:35:20", "text": "同じように"}, {"type": "subtitle", "time": 9327.59, "timestamp": "02:35:27", "text": "量を覚える代わりに"}, {"type": "subtitle", "time": 9328.95, "timestamp": "02:35:28", "text": "入ってきた人たち、私は覚えている"}, {"type": "subtitle", "time": 9336.95, "timestamp": "02:35:36", "text": "来て。だから、少なくとも1つ見かけたら"}, {"type": "subtitle", "time": 9338.55, "timestamp": "02:35:38", "text": "人物であり、それは同じ人物です"}, {"type": "subtitle", "time": 9351.03, "timestamp": "02:35:51", "text": "何て言ってたの？私はあなたを切るのが好きです"}, {"type": "subtitle", "time": 9355.15, "timestamp": "02:35:55", "text": "オフ。ああ、私はこう言っていた"}, {"type": "subtitle", "time": 9358.51, "timestamp": "02:35:58", "text": "えっと、何の話をしてたんだっけ？"}]
[{"type": "subtitle", "time": 3840.349, "timestamp": "01:04:00", "text": "うん。 H"}, {"type": "subtitle", "time": 3844.549, "timestamp": "01:04:04", "text": "みんな「すごい！」って感じ。皆さん、こんにちは。"}, {"type": "subtitle", "time": 3847.63, "timestamp": "01:04:07", "text": "そして87日目へようこそ"}, {"type": "subtitle", "time": 3850.39, "timestamp": "01:04:10", "text": "ジョアソン。皆さん、おはようございます。良い"}, {"type": "subtitle", "time": 3851.549, "timestamp": "01:04:11", "text": "朝。良い"}, {"type": "subtitle", "time": 3854.71, "timestamp": "01:04:14", "text": "午後。こんにちは。こんにちは。だから今日は"}, {"type": "subtitle", "time": 3857.99, "timestamp": "01:04:17", "text": "4つのコラボレーションを行う予定です"}, {"type": "subtitle", "time": 3860.47, "timestamp": "01:04:20", "text": "私の言う通りです。 4人います"}, {"type": "subtitle", "time": 3862.95, "timestamp": "01:04:22", "text": "コラボレーション。えーと、私たちは"}, {"type": "subtitle", "time": 3865.19, "timestamp": "01:04:25", "text": "今日の最初のコラボレーションは"}, {"type": "subtitle", "time": 3868.63, "timestamp": "01:04:28", "text": "男性的な太陽と共に。次にアティマスがあります。"}, {"type": "subtitle", "time": 3872.23, "timestamp": "01:04:32", "text": "午後6時より、SpurascapeのSoulが出演します。それから、えーと"}, {"type": "subtitle", "time": 3875.19, "timestamp": "01:04:35", "text": "ウォルターの息子は午後9時30分にそして最後に私たちは"}, {"type": "subtitle", "time": 3879.19, "timestamp": "01:04:39", "text": "午後11時にサバトンのライブがあります。こんにちは。つまり、それらは"}, {"type": "subtitle", "time": 3882.549, "timestamp": "01:04:42", "text": "本日の協力者の皆様、そして私たちは"}]
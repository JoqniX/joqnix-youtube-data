[{"type": "subtitle", "time": 14221.469, "timestamp": "03:57:01", "text": "写真。スイング開始から16分経過。"}, {"type": "subtitle", "time": 14224.429, "timestamp": "03:57:04", "text": "おい、待て。歩いて行くべきでしょうか"}, {"type": "subtitle", "time": 14227.51, "timestamp": "03:57:07", "text": "橋？探検に行きましょうか"}, {"type": "subtitle", "time": 14229.99, "timestamp": "03:57:09", "text": "ビーチサイド？あのね？私はレッツ"}, {"type": "subtitle", "time": 14232.71, "timestamp": "03:57:12", "text": "それからビーチの方へ歩いて行ってください。私は"}, {"type": "subtitle", "time": 14235.03, "timestamp": "03:57:15", "text": "あのカーブの端まで歩いていく"}, {"type": "subtitle", "time": 14237.309, "timestamp": "03:57:17", "text": "目の前に見える"}, {"type": "subtitle", "time": 14240.71, "timestamp": "03:57:20", "text": "自分。えっと、音声が聞き取りづらかったら申し訳ありません。"}, {"type": "subtitle", "time": 14243.03, "timestamp": "03:57:23", "text": "悪い。わかった、それは私が"}, {"type": "subtitle", "time": 14251.189, "timestamp": "03:57:31", "text": "ビーチ。知りたかったのですが"}]
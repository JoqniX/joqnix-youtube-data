[{"type": "subtitle", "time": 2466.63, "timestamp": "00:41:06", "text": "そうそう。"}, {"type": "subtitle", "time": 2475.349, "timestamp": "00:41:15", "text": "心配。そして彼女はトレーニングを始めた。"}, {"type": "subtitle", "time": 2477.43, "timestamp": "00:41:17", "text": "えっと、あっちに移動したいですか？"}, {"type": "subtitle", "time": 2479.41, "timestamp": "00:41:19", "text": "それとも何か別のこと？"}, {"type": "subtitle", "time": 2492.71, "timestamp": "00:41:32", "text": "えっと、聞いてます。うん。うん。うん。"}, {"type": "subtitle", "time": 2496.63, "timestamp": "00:41:36", "text": "私はこのゲームをプレイします。私はこのゲームをプレイしています"}, {"type": "subtitle", "time": 2500.15, "timestamp": "00:41:40", "text": "リスニング。罵り声。"}, {"type": "subtitle", "time": 2512.09, "timestamp": "00:41:52", "text": "気分が良くない。"}]
[{"type": "subtitle", "time": 7681.109, "timestamp": "02:08:01", "text": "ビームストリームのフォーマットにして、"}, {"type": "subtitle", "time": 7682.91, "timestamp": "02:08:02", "text": "垂直"}, {"type": "subtitle", "time": 7686.87, "timestamp": "02:08:06", "text": "ストリーム。それでおしまい。何てことだ。ええ、そうです"}, {"type": "subtitle", "time": 7688.75, "timestamp": "02:08:08", "text": "それはとても"}, {"type": "subtitle", "time": 7691.669, "timestamp": "02:08:11", "text": "いいね。送らせていただきます。あれはすごかった。"}, {"type": "subtitle", "time": 7694.069, "timestamp": "02:08:14", "text": "うん。うん。問題は、"}, {"type": "subtitle", "time": 7696.31, "timestamp": "02:08:16", "text": "スポンサーを選び、"}, {"type": "subtitle", "time": 7699.47, "timestamp": "02:08:19", "text": "マルチストリームをビームに送信すると"}, {"type": "subtitle", "time": 7703.83, "timestamp": "02:08:23", "text": "このプラットフォーム自体にも言えることだ。だからあなたは"}, {"type": "subtitle", "time": 7706.39, "timestamp": "02:08:26", "text": "無料のものを無料で利用できます"}, {"type": "subtitle", "time": 7708.629, "timestamp": "02:08:28", "text": "無料で物を手に入れる。"}, {"type": "subtitle", "time": 7710.95, "timestamp": "02:08:30", "text": "うん。そうでなければ、ストリーミングしていない場合は"}, {"type": "subtitle", "time": 7713.91, "timestamp": "02:08:33", "text": "スポンサーと共に少なくとも"}, {"type": "subtitle", "time": 7719.189, "timestamp": "02:08:39", "text": "えーと、1時間、えーと、1時間、えーと、4時間くらい"}, {"type": "subtitle", "time": 7721.03, "timestamp": "02:08:41", "text": "月に数回とか。私は忘れた"}, {"type": "subtitle", "time": 7723.91, "timestamp": "02:08:43", "text": "要件はありますが、そんな感じです。えっと"}, {"type": "subtitle", "time": 7725.99, "timestamp": "02:08:45", "text": "料金を支払わなければならないかもしれません。あなた"}, {"type": "subtitle", "time": 7729.75, "timestamp": "02:08:49", "text": "これを行うには、カードを追加するだけで済みます。"}, {"type": "subtitle", "time": 7733.83, "timestamp": "02:08:53", "text": "そう、もしあなたが望むなら、選択することはできません"}, {"type": "subtitle", "time": 7735.91, "timestamp": "02:08:55", "text": "スポンサーと一緒に行かず、"}]
[{"type": "subtitle", "time": 302.31, "timestamp": "00:05:02", "text": "学ぶ。私はその輪の中に入りたいし"}, {"type": "subtitle", "time": 303.79, "timestamp": "00:05:03", "text": "彼らが何を学ぶか"}, {"type": "subtitle", "time": 312.07, "timestamp": "00:05:12", "text": "男の子。ああ、彼らは"}, {"type": "subtitle", "time": 342.31, "timestamp": "00:05:42", "text": "あなたは故アブラ・アブラハムの息子さんですね。うん。"}, {"type": "subtitle", "time": 343.909, "timestamp": "00:05:43", "text": "こんにちは。いらっしゃいませ。いらっしゃいませ。元気ですか"}, {"type": "subtitle", "time": 345.59000000000003, "timestamp": "00:05:45", "text": "今日？"}, {"type": "subtitle", "time": 347.99, "timestamp": "00:05:47", "text": "お元気でお過ごしでしょうか。"}]
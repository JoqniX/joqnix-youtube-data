[{"type": "subtitle", "time": 7860.87, "timestamp": "02:11:00", "text": "バッジみたいなもの。二分割されたバッジのようなもの"}, {"type": "subtitle", "time": 7862.109, "timestamp": "02:11:02", "text": "そして"}, {"type": "subtitle", "time": 7867.51, "timestamp": "02:11:07", "text": "うみ出たバッジみたいなものと、えっと"}, {"type": "subtitle", "time": 7876.31, "timestamp": "02:11:16", "text": "Xベーシックとかいうやつ。"}, {"type": "subtitle", "time": 7879.109, "timestamp": "02:11:19", "text": "ああ、それはベーシックと呼ばれているんだ。"}, {"type": "subtitle", "time": 7882.95, "timestamp": "02:11:22", "text": "そうだったのか？私は確認しません。覚えていない。"}, {"type": "subtitle", "time": 7884.229, "timestamp": "02:11:24", "text": "覚えているのは、小切手を受け取ったということだけです"}, {"type": "subtitle", "time": 7886.629, "timestamp": "02:11:26", "text": "それを覚えておいてください。"}, {"type": "subtitle", "time": 7889.27, "timestamp": "02:11:29", "text": "うん。仕事。"}, {"type": "subtitle", "time": 7893.109, "timestamp": "02:11:33", "text": "そうそう。基本保険料。プレミアムプラス。"}, {"type": "subtitle", "time": 7895.109, "timestamp": "02:11:35", "text": "ああ、わかった。ああ、それならプレミアム版ってことね。"}, {"type": "subtitle", "time": 7898.709, "timestamp": "02:11:38", "text": "プレミアムとは、"}, {"type": "subtitle", "time": 7901.55, "timestamp": "02:11:41", "text": "あなたはそれを何と呼びますか？小切手"}, {"type": "subtitle", "time": 7908.94, "timestamp": "02:11:48", "text": "うん。"}, {"type": "subtitle", "time": 7910.79, "timestamp": "02:11:50", "text": "[音楽]"}, {"type": "subtitle", "time": 7912.47, "timestamp": "02:11:52", "text": "考えてみてください"}, {"type": "subtitle", "time": 7914.47, "timestamp": "02:11:54", "text": "時々そこに行って、"}, {"type": "subtitle", "time": 7916.79, "timestamp": "02:11:56", "text": "おそらくストリーミング配信だろう。"}, {"type": "subtitle", "time": 7918.95, "timestamp": "02:11:58", "text": "えーと"}]
[{"type": "subtitle", "time": 8762.389, "timestamp": "02:26:02", "text": "デイビス寿司"}, {"type": "subtitle", "time": 8765.08, "timestamp": "02:26:05", "text": "えーと寿司と"}, {"type": "subtitle", "time": 8767.55, "timestamp": "02:26:07", "text": "[音楽]"}, {"type": "subtitle", "time": 8770.389, "timestamp": "02:26:10", "text": "ソサンハンが帰ってきた。嘘はつきません。"}, {"type": "subtitle", "time": 8772.87, "timestamp": "02:26:12", "text": "どれ？誰が？"}, {"type": "subtitle", "time": 8776.99, "timestamp": "02:26:16", "text": "寿司。はぁ？寿司が復活した。うん。うん。"}, {"type": "subtitle", "time": 8779.99, "timestamp": "02:26:19", "text": "うん。彼が発表したとき"}, {"type": "subtitle", "time": 8780.87, "timestamp": "02:26:20", "text": "もう戻ってこないだろうと思った、"}, {"type": "subtitle", "time": 8782.469, "timestamp": "02:26:22", "text": "「ああ、なんてこった。」そして彼が戻ってきて私は"}, {"type": "subtitle", "time": 8785.27, "timestamp": "02:26:25", "text": "「ああ、わかった」という感じだった。"}, {"type": "subtitle", "time": 8791.91, "timestamp": "02:26:31", "text": "愛を手放すのは難しいから"}, {"type": "subtitle", "time": 8794.71, "timestamp": "02:26:34", "text": "ストリーミング配信など、すべて含めて。ここは楽しいよ。"}, {"type": "subtitle", "time": 8796.55, "timestamp": "02:26:36", "text": "うん。"}, {"type": "subtitle", "time": 8799.27, "timestamp": "02:26:39", "text": "趣味として続ける限り"}, {"type": "subtitle", "time": 8801.91, "timestamp": "02:26:41", "text": "そしてあなたが情熱を注いでいること"}, {"type": "subtitle", "time": 8803.349, "timestamp": "02:26:43", "text": "それでいいんだけど、それを摂取すると"}, {"type": "subtitle", "time": 8805.349, "timestamp": "02:26:45", "text": "真剣に、そして義務としてやってください"}, {"type": "subtitle", "time": 8810.63, "timestamp": "02:26:50", "text": "それだと、ちょっと痛いと思う。"}, {"type": "subtitle", "time": 8813.27, "timestamp": "02:26:53", "text": "うん。はい、そうです。私にとっては"}, {"type": "subtitle", "time": 8815.51, "timestamp": "02:26:55", "text": "それは他の物事が物事を完成させるようなものだった。"}, {"type": "subtitle", "time": 8817.99, "timestamp": "02:26:57", "text": "わからない。その時私は"}]
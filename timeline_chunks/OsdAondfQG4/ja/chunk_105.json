[{"type": "subtitle", "time": 6302.55, "timestamp": "01:45:02", "text": "私は話すことができなかった。でも、私はそれができて嬉しいです"}, {"type": "subtitle", "time": 6306.31, "timestamp": "01:45:06", "text": "少なくとも、こうして再び繋がりを取り戻すことはできる。"}, {"type": "subtitle", "time": 6308.31, "timestamp": "01:45:08", "text": "うん。"}, {"type": "subtitle", "time": 6310.229, "timestamp": "01:45:10", "text": "知っている。そうすれば、"}, {"type": "subtitle", "time": 6311.149, "timestamp": "01:45:11", "text": "好き"}, {"type": "subtitle", "time": 6320.709, "timestamp": "01:45:20", "text": "人々とコミュニケーションをとるための確かな場​​所。"}, {"type": "subtitle", "time": 6322.95, "timestamp": "01:45:22", "text": "私のDiscordサーバーのように、"}, {"type": "subtitle", "time": 6325.83, "timestamp": "01:45:25", "text": "視聴者はチャットで大騒ぎする"}, {"type": "subtitle", "time": 6328.709, "timestamp": "01:45:28", "text": "そこには。そして時には視聴者でさえ"}, {"type": "subtitle", "time": 6331.03, "timestamp": "01:45:31", "text": "まるでランダムな人々がやって来て"}, {"type": "subtitle", "time": 6333.189, "timestamp": "01:45:33", "text": "友達とかそういうのを使って、それから私の"}, {"type": "subtitle", "time": 6335.189, "timestamp": "01:45:35", "text": "Discordサーバーは、会話の拠点のような役割を果たします。"}, {"type": "subtitle", "time": 6337.75, "timestamp": "01:45:37", "text": "お互い。ああ、そうそうそう、私も"}, {"type": "subtitle", "time": 6339.87, "timestamp": "01:45:39", "text": "昔々"}, {"type": "subtitle", "time": 6343.109, "timestamp": "01:45:43", "text": "時間とともに人々は気づいたが、"}, {"type": "subtitle", "time": 6346.55, "timestamp": "01:45:46", "text": "新しいものを見つけた後、彼らが先に進む時が来た"}, {"type": "subtitle", "time": 6348.109, "timestamp": "01:45:48", "text": "スペースまたは"}, {"type": "subtitle", "time": 6351.109, "timestamp": "01:45:51", "text": "何か。それは本当に悲しいことだ。彼らはバスに乗る"}, {"type": "subtitle", "time": 6355.27, "timestamp": "01:45:55", "text": "人生。ああ、それもそうだね。"}, {"type": "subtitle", "time": 6358.07, "timestamp": "01:45:58", "text": "ええ、たくさん見てきました"}]
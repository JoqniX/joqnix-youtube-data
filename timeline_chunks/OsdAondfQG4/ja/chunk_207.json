[{"type": "subtitle", "time": 12437.91, "timestamp": "03:27:17", "text": "なぜなら、もし私がミッチと"}, {"type": "subtitle", "time": 12439.07, "timestamp": "03:27:19", "text": "あなた"}, {"type": "subtitle", "time": 12442.59, "timestamp": "03:27:22", "text": "パンデッド 私はそのグループコラボレーションだけを残しました"}, {"type": "subtitle", "time": 12445.75, "timestamp": "03:27:25", "text": "今はそうだけど、うん、パンディットと遊んだよ。"}, {"type": "subtitle", "time": 12448.11, "timestamp": "03:27:28", "text": "コラボレーション前"}, {"type": "subtitle", "time": 12452.07, "timestamp": "03:27:32", "text": "Valorを始めて、少しプレイしました。私はします"}, {"type": "subtitle", "time": 12455.03, "timestamp": "03:27:35", "text": "個人でやりたい。私はそうかもしれない"}, {"type": "subtitle", "time": 12457.67, "timestamp": "03:27:37", "text": "スペースがあるかどうか確認する必要があります"}, {"type": "subtitle", "time": 12459.95, "timestamp": "03:27:39", "text": "最後の方へ"}, {"type": "subtitle", "time": 12464.15, "timestamp": "03:27:44", "text": "先週のTW。先週は21日か"}, {"type": "subtitle", "time": 12467.389, "timestamp": "03:27:47", "text": "20日か19日に空きがあれば"}]
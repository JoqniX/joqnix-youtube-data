[{"type": "subtitle", "time": 14340.11, "timestamp": "03:59:00", "text": "カニのように白いのは"}, {"type": "subtitle", "time": 14343.83, "timestamp": "03:59:03", "text": "カニ料理を食べるような感じ"}, {"type": "subtitle", "time": 14347.51, "timestamp": "03:59:07", "text": "ビデオとか、あの、いくつか"}, {"type": "subtitle", "time": 14351.189, "timestamp": "03:59:11", "text": "YouTubeの番組とかそういう類の"}, {"type": "subtitle", "time": 14354.229, "timestamp": "03:59:14", "text": "本当に見栄えの良い赤い痙攣と"}, {"type": "subtitle", "time": 14357.83, "timestamp": "03:59:17", "text": "他の人たち、えっと、私の地元で見たもの"}, {"type": "subtitle", "time": 14360.229, "timestamp": "03:59:20", "text": "魚市場の店とかそういうもの。まるで"}, {"type": "subtitle", "time": 14370.189, "timestamp": "03:59:30", "text": "えっと、カニ。"}, {"type": "subtitle", "time": 14383.07, "timestamp": "03:59:43", "text": "亡くなった。安らかに眠れ、カニよ。"}, {"type": "subtitle", "time": 14386.87, "timestamp": "03:59:46", "text": "チャマの痛み。"}, {"type": "subtitle", "time": 14395.309, "timestamp": "03:59:55", "text": "今日は充電完了。"}]
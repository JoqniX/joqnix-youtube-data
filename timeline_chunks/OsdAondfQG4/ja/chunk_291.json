[{"type": "subtitle", "time": 17460.75, "timestamp": "04:51:00", "text": "朝食と"}, {"type": "subtitle", "time": 17463.15, "timestamp": "04:51:03", "text": "もの。それで"}, {"type": "subtitle", "time": 17467.07, "timestamp": "04:51:07", "text": "疲れた。でも、もうすぐ家に帰れる。"}, {"type": "subtitle", "time": 17470.03, "timestamp": "04:51:10", "text": "つまり、ある意味では"}, {"type": "subtitle", "time": 17473.788, "timestamp": "04:51:13", "text": "私は"}, {"type": "subtitle", "time": 17476.47, "timestamp": "04:51:16", "text": "スイング。ああ、車が来るぞ"}, {"type": "subtitle", "time": 17478.51, "timestamp": "04:51:18", "text": "私の後ろに。させて"}, {"type": "subtitle", "time": 17488.628, "timestamp": "04:51:28", "text": "側。これ、かっこいいというか、いい感じ。私"}, {"type": "subtitle", "time": 17492.43, "timestamp": "04:51:32", "text": "今日はウォーキングの日だったのを忘れてた。それはch"}, {"type": "subtitle", "time": 17496.39, "timestamp": "04:51:36", "text": "今日は何の日でしたっけ？日を選択してください。"}, {"type": "subtitle", "time": 17498.67, "timestamp": "04:51:38", "text": "だから、"}, {"type": "subtitle", "time": 17501.708, "timestamp": "04:51:41", "text": "火曜日。それで、"}, {"type": "subtitle", "time": 17504.75, "timestamp": "04:51:44", "text": "うん。おお、"}, {"type": "subtitle", "time": 17506.91, "timestamp": "04:51:46", "text": "男の子。これは"}, {"type": "subtitle", "time": 17510.03, "timestamp": "04:51:50", "text": "おはようございます"}, {"type": "subtitle", "time": 17512.19, "timestamp": "04:51:52", "text": "歩く。しないつもりだ"}, {"type": "subtitle", "time": 17514.868, "timestamp": "04:51:54", "text": "嘘、これは良い朝の散歩だった、"}, {"type": "subtitle", "time": 17518.55, "timestamp": "04:51:58", "text": "道。楽しかったです。そう、一度"}]
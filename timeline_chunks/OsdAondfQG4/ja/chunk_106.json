[{"type": "subtitle", "time": 6362.629, "timestamp": "01:46:02", "text": "僕たちが観ている昔の仲間たちや"}, {"type": "subtitle", "time": 6364.709, "timestamp": "01:46:04", "text": "昔よく見ていたような"}, {"type": "subtitle", "time": 6367.99, "timestamp": "01:46:07", "text": "または、遊ぶのが好きで、私が"}, {"type": "subtitle", "time": 6370.87, "timestamp": "01:46:10", "text": "彼らがストリーマーとして成長していくのを見守る、"}, {"type": "subtitle", "time": 6373.31, "timestamp": "01:46:13", "text": "分かりません。見ていると誇らしい気持ちになります"}, {"type": "subtitle", "time": 6376.39, "timestamp": "01:46:16", "text": "だって私は、昔は"}, {"type": "subtitle", "time": 6378.55, "timestamp": "01:46:18", "text": "この人を知っている。彼らは、ほら、"}, {"type": "subtitle", "time": 6383.189, "timestamp": "01:46:23", "text": "むしろ、あなたを誇りに思う、という感じですね。"}, {"type": "subtitle", "time": 6384.79, "timestamp": "01:46:24", "text": "私の言っていることが分かるよね？君を見てごらん。"}, {"type": "subtitle", "time": 6387.669, "timestamp": "01:46:27", "text": "あなた自身についても具体的に言っています。あなたは"}, {"type": "subtitle", "time": 6391.43, "timestamp": "01:46:31", "text": "成長した。うーん、わからないな。あなたは成長した"}, {"type": "subtitle", "time": 6394.669, "timestamp": "01:46:34", "text": "視聴者数で、もしかしたら"}, {"type": "subtitle", "time": 6399.109, "timestamp": "01:46:39", "text": "数で言えば、キャラクターで言えばそうかもしれない。"}, {"type": "subtitle", "time": 6400.229, "timestamp": "01:46:40", "text": "わからない。私は知らない"}, {"type": "subtitle", "time": 6402.39, "timestamp": "01:46:42", "text": "キャラクターは、実際には"}, {"type": "subtitle", "time": 6406.51, "timestamp": "01:46:46", "text": "Destiny以上のものだった。"}, {"type": "subtitle", "time": 6409.39, "timestamp": "01:46:49", "text": "うん。そして私たちはもっと交流すべきです"}, {"type": "subtitle", "time": 6413.03, "timestamp": "01:46:53", "text": "将来、一緒に遊んだりとか。"}]
[{"type": "subtitle", "time": 4688.55, "timestamp": "01:18:08", "text": "ええ、選手たちは本当に気に入っていましたよ。"}, {"type": "subtitle", "time": 4689.75, "timestamp": "01:18:09", "text": "中には、少し難しすぎると感じた人もいた。"}, {"type": "subtitle", "time": 4692.229, "timestamp": "01:18:12", "text": "プレイするために。"}, {"type": "subtitle", "time": 4694.07, "timestamp": "01:18:14", "text": "ええ、新しい人にとっては大変でしょうね"}, {"type": "subtitle", "time": 4696.229, "timestamp": "01:18:16", "text": "プレイヤー。"}, {"type": "subtitle", "time": 4698.63, "timestamp": "01:18:18", "text": "うん。"}, {"type": "subtitle", "time": 4703.75, "timestamp": "01:18:23", "text": "彼らにとっては、それは彼らのためのものではない。わからない。"}, {"type": "subtitle", "time": 4705.51, "timestamp": "01:18:25", "text": "しかし、現在のスーパーマリオブラザーズはゾンビだ。"}, {"type": "subtitle", "time": 4707.35, "timestamp": "01:18:27", "text": "Rustのような終末世界とか"}, {"type": "subtitle", "time": 4709.47, "timestamp": "01:18:29", "text": "それ。"}, {"type": "chat", "time": 4715.028, "timestamp": "01:18:35", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "namaste joqnix bhaiUCkszU2WH9gy1mb0dV-11UJg/hf90Xv-jHeOR8gSxxrToBA"}, {"type": "subtitle", "time": 4716.149, "timestamp": "01:18:36", "text": "それはいいですね。"}, {"type": "chat", "time": 4717.749, "timestamp": "01:18:37", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Rudra Tiwari~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 4718.149, "timestamp": "01:18:38", "text": "ええ、もしよろしければ、あなたも参加できますよ。"}, {"type": "subtitle", "time": 4719.75, "timestamp": "01:18:39", "text": "いつでも好きな時にストリーミング再生"}, {"type": "subtitle", "time": 4722.43, "timestamp": "01:18:42", "text": "配信中でもない。"}, {"type": "subtitle", "time": 4725.189, "timestamp": "01:18:45", "text": "ああ、参加したいのですが、また私は"}, {"type": "subtitle", "time": 4727.75, "timestamp": "01:18:47", "text": "来月は日本へ出発しない。いや、違う"}, {"type": "subtitle", "time": 4730.39, "timestamp": "01:18:50", "text": "問題。だから、私は、えっと、"}, {"type": "subtitle", "time": 4732.39, "timestamp": "01:18:52", "text": "そこから全て解決して、"}, {"type": "subtitle", "time": 4734.87, "timestamp": "01:18:54", "text": "ノートパソコンがついに"}, {"type": "subtitle", "time": 4736.95, "timestamp": "01:18:56", "text": "それからストリーミングとゲームに戻る"}]
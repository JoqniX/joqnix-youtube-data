[{"type": "subtitle", "time": 17407.788, "timestamp": "04:50:07", "text": "そして魚"}, {"type": "subtitle", "time": 17414.55, "timestamp": "04:50:14", "text": "料理。かわいい人がいる"}, {"type": "subtitle", "time": 17417.868, "timestamp": "04:50:17", "text": "実際に野良犬に餌を与えている。"}, {"type": "subtitle", "time": 17422.23, "timestamp": "04:50:22", "text": "ああ、それは本当に親切ですね。"}, {"type": "subtitle", "time": 17424.23, "timestamp": "04:50:24", "text": "彼らは、ほら、"}, {"type": "subtitle", "time": 17428.55, "timestamp": "04:50:28", "text": "犬のおやつと餌を"}, {"type": "subtitle", "time": 17431.51, "timestamp": "04:50:31", "text": "野良犬。そして彼らは文字通り"}, {"type": "subtitle", "time": 17434.628, "timestamp": "04:50:34", "text": "4匹の犬が車の中に入った。"}, {"type": "subtitle", "time": 17437.75, "timestamp": "04:50:37", "text": "ああ、なんて可愛いの。彼らを見てごらん。"}, {"type": "subtitle", "time": 17446.948, "timestamp": "04:50:46", "text": "きっとあの犬は待っているだろう"}, {"type": "subtitle", "time": 17449.75, "timestamp": "04:50:49", "text": "彼らのために毎朝"}, {"type": "subtitle", "time": 17451.868, "timestamp": "04:50:51", "text": "午前8時"}, {"type": "subtitle", "time": 17455.03, "timestamp": "04:50:55", "text": "午前中に、彼らがそれらをくれるのを待つ"}, {"type": "subtitle", "time": 17458.35, "timestamp": "04:50:58", "text": "再びおやつをあげたり、朝食のように"}]
[{"type": "subtitle", "time": 17640.628, "timestamp": "04:54:00", "text": "雪が降っていて、来てくれてありがとう。それでは感謝します"}, {"type": "subtitle", "time": 17641.788, "timestamp": "04:54:01", "text": "来てくれてありがとう"}, {"type": "subtitle", "time": 17645.23, "timestamp": "04:54:05", "text": "による。ありがとうございます、そして良い"}, {"type": "subtitle", "time": 17649.75, "timestamp": "04:54:09", "text": "それでは、おはようございます。えっと、あなたは"}, {"type": "subtitle", "time": 17655.11, "timestamp": "04:54:15", "text": "アカウントも同様です。こんにちは、来てくれてありがとう"}, {"type": "subtitle", "time": 17658.23, "timestamp": "04:54:18", "text": "そして、あなたにもおはようございます。"}, {"type": "subtitle", "time": 17659.67, "timestamp": "04:54:19", "text": "また雪が降った。良いと言うのを忘れていました"}, {"type": "subtitle", "time": 17660.91, "timestamp": "04:54:20", "text": "おはようございます"}, {"type": "subtitle", "time": 17663.47, "timestamp": "04:54:23", "text": "そうですね"}, {"type": "subtitle", "time": 17691.39, "timestamp": "04:54:51", "text": "少し。私は写真を撮るべきだ"}, {"type": "subtitle", "time": 17693.51, "timestamp": "04:54:53", "text": "ワンちゃん。うん。うん。うん。あのね？"}, {"type": "subtitle", "time": 17695.868, "timestamp": "04:54:55", "text": "待って、うんちとか色々あるよ。ああ、"}, {"type": "subtitle", "time": 17698.15, "timestamp": "04:54:58", "text": "神。待って、写真を撮って"}, {"type": "subtitle", "time": 17699.39, "timestamp": "04:54:59", "text": "ワンちゃん。"}]
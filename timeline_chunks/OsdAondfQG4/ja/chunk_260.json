[{"type": "subtitle", "time": 15601.149, "timestamp": "04:20:01", "text": "プレ"}, {"type": "subtitle", "time": 15604.55, "timestamp": "04:20:04", "text": "7時。私はそれを始めるはずだった"}, {"type": "subtitle", "time": 15608.99, "timestamp": "04:20:08", "text": "6、でも私は、私が"}, {"type": "subtitle", "time": 15613.269, "timestamp": "04:20:13", "text": "夜、午前1時頃、眉毛"}, {"type": "subtitle", "time": 15615.91, "timestamp": "04:20:15", "text": "その配信が終わってから12時かそこら"}, {"type": "subtitle", "time": 15618.71, "timestamp": "04:20:18", "text": "昨日の動画配信を終えた後。"}, {"type": "subtitle", "time": 15621.83, "timestamp": "04:20:21", "text": "あぁ、忘れてた。電源を入れたと思った。"}, {"type": "subtitle", "time": 15625.79, "timestamp": "04:20:25", "text": "しかし、どうやらそれは完全には"}, {"type": "subtitle", "time": 15628.389, "timestamp": "04:20:28", "text": "差し込みました。それは私の愚かな行動だった、なぜなら私は"}, {"type": "subtitle", "time": 15629.63, "timestamp": "04:20:29", "text": "とても"}, {"type": "subtitle", "time": 15633.349, "timestamp": "04:20:33", "text": "疲れた。私はとても疲れていて、それをしました"}, {"type": "subtitle", "time": 15635.269, "timestamp": "04:20:35", "text": "知らず知らずのうちに。もしできるなら、私は"}, {"type": "subtitle", "time": 15639.11, "timestamp": "04:20:39", "text": "午前6時頃にこの散歩を始めました。"}, {"type": "subtitle", "time": 15644.63, "timestamp": "04:20:44", "text": "早朝は朝のような感じになるでしょう"}, {"type": "subtitle", "time": 15646.87, "timestamp": "04:20:46", "text": "そよ風と涼しさが好き。あるだろう"}, {"type": "subtitle", "time": 15650.469, "timestamp": "04:20:50", "text": "それほど明るい日光ではない"}, {"type": "subtitle", "time": 15651.229, "timestamp": "04:20:51", "text": "右"}, {"type": "subtitle", "time": 15654.03, "timestamp": "04:20:54", "text": "たとえそれが"}]
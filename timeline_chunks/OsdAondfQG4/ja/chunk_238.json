[{"type": "subtitle", "time": 14284.07, "timestamp": "03:58:04", "text": "実際には、その2番目の部分について"}, {"type": "subtitle", "time": 14286.71, "timestamp": "03:58:06", "text": "2番目の部分ですが、私が"}, {"type": "subtitle", "time": 14290.63, "timestamp": "03:58:10", "text": "ストリームでやりたかったのはウォーキングでした"}, {"type": "subtitle", "time": 14293.99, "timestamp": "03:58:13", "text": "ビーチで最後にもう一度"}, {"type": "subtitle", "time": 14296.87, "timestamp": "03:58:16", "text": "私は明日出発するので、今日"}, {"type": "subtitle", "time": 14299.51, "timestamp": "03:58:19", "text": "あるいは明日。もし私が明日出発するなら、"}, {"type": "subtitle", "time": 14301.99, "timestamp": "03:58:21", "text": "私は実際に水に浸かり、"}, {"type": "subtitle", "time": 14304.59, "timestamp": "03:58:24", "text": "泳ぎ続けるように"}, {"type": "subtitle", "time": 14307.229, "timestamp": "03:58:27", "text": "もの。私の目"}, {"type": "subtitle", "time": 14310.87, "timestamp": "03:58:30", "text": "大丈夫。ショーン、もちろん。でも、そうだね、"}, {"type": "subtitle", "time": 14312.63, "timestamp": "03:58:32", "text": "音声は良好です。もし"}, {"type": "subtitle", "time": 14315.71, "timestamp": "03:58:35", "text": "音声に問題があるか、何か不具合があるようです。"}, {"type": "subtitle", "time": 14320.469, "timestamp": "03:58:40", "text": "やあ、君。すべて順調です。これを見て"}, {"type": "subtitle", "time": 14324.229, "timestamp": "03:58:44", "text": "カニとかそういうもの。わあ、カニと"}, {"type": "subtitle", "time": 14327.11, "timestamp": "03:58:47", "text": "もの。つまり、小さなカニみたいなものだ。のように"}]
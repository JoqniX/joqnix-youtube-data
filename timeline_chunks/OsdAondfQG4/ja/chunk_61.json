[{"type": "subtitle", "time": 3664.789, "timestamp": "01:01:04", "text": "あなたたちは脂ぎった人たちだ。実際とても難しい"}, {"type": "subtitle", "time": 3666.67, "timestamp": "01:01:06", "text": "以来"}, {"type": "subtitle", "time": 3670.71, "timestamp": "01:01:10", "text": "あなたの友人を受け入れます。"}, {"type": "subtitle", "time": 3672.549, "timestamp": "01:01:12", "text": "ギリシャ。"}, {"type": "subtitle", "time": 3676.309, "timestamp": "01:01:16", "text": "待って。ギリシャ。ギリシャ。え、マジで？"}, {"type": "subtitle", "time": 3680.03, "timestamp": "01:01:20", "text": "待って。いいえ、あなたはギリシャではありません。"}, {"type": "subtitle", "time": 3683.27, "timestamp": "01:01:23", "text": "グレース。えっと、待って。何だって？待って、"}, {"type": "subtitle", "time": 3686.069, "timestamp": "01:01:26", "text": "何？"}, {"type": "subtitle", "time": 3689.99, "timestamp": "01:01:29", "text": "それは、ああ、黄色のような色です。"}, {"type": "subtitle", "time": 3692.309, "timestamp": "01:01:32", "text": "右。そして"}, {"type": "subtitle", "time": 3695.829, "timestamp": "01:01:35", "text": "ああ、あれですね。何？私は"}, {"type": "subtitle", "time": 3698.549, "timestamp": "01:01:38", "text": "遅れている。"}, {"type": "subtitle", "time": 3699.95, "timestamp": "01:01:39", "text": "なるほど"}, {"type": "subtitle", "time": 3703.549, "timestamp": "01:01:43", "text": "だって私は今"}, {"type": "subtitle", "time": 3707.75, "timestamp": "01:01:47", "text": "毎回ラグが発生するので、さらに悪い。おお、"}, {"type": "subtitle", "time": 3710.91, "timestamp": "01:01:50", "text": "わかった。だから私は"}, {"type": "subtitle", "time": 3713.47, "timestamp": "01:01:53", "text": "なぜならそれは"}, {"type": "subtitle", "time": 3717.19, "timestamp": "01:01:57", "text": "特にこの点において、防御が重要となる。わかった。もしあなたが"}]
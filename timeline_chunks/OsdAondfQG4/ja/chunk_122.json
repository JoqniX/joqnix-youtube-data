[{"type": "subtitle", "time": 7325.31, "timestamp": "02:02:05", "text": "えっと、私の声をもっと明るくして"}, {"type": "subtitle", "time": 7328.47, "timestamp": "02:02:08", "text": "より多く、より少なく、より引き締まった。どうすればいいですか どうすればいいですか"}, {"type": "subtitle", "time": 7336.47, "timestamp": "02:02:16", "text": "こんにちは、みんな。まあ、そんな感じですね。あなたが知っている"}, {"type": "subtitle", "time": 7338.669, "timestamp": "02:02:18", "text": "私が"}, {"type": "subtitle", "time": 7340.709, "timestamp": "02:02:20", "text": "平均？わからない。その奇妙な私の"}, {"type": "chat", "time": 7353.035, "timestamp": "02:02:33", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "I know what you mean"}, {"type": "subtitle", "time": 7364.83, "timestamp": "02:02:44", "text": "あなたは"}, {"type": "chat", "time": 7367.192, "timestamp": "02:02:47", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "UCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ-r4KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 7373.27, "timestamp": "02:02:53", "text": "みんな、私、ちょっと喋りすぎたと思う。おお、"}, {"type": "subtitle", "time": 7377.149, "timestamp": "02:02:57", "text": "いいえ。いや、いや、いや、いや、いや。これですか"}]
[{"type": "subtitle", "time": 2774.95, "timestamp": "00:46:14", "text": "ありがとうございます。"}, {"type": "subtitle", "time": 2778.23, "timestamp": "00:46:18", "text": "うん。うん。こんにちは。元気かい？希望"}, {"type": "subtitle", "time": 2780.23, "timestamp": "00:46:20", "text": "あなたは元気ですね。"}, {"type": "subtitle", "time": 2785.63, "timestamp": "00:46:25", "text": "私は時々"}, {"type": "subtitle", "time": 2789.99, "timestamp": "00:46:29", "text": "見る、そして時々私は見る。"}, {"type": "subtitle", "time": 2792.55, "timestamp": "00:46:32", "text": "ああ、そうだね。はい。私もそうします。あなたは誰ですか"}, {"type": "subtitle", "time": 2797.99, "timestamp": "00:46:37", "text": "[音楽]"}, {"type": "subtitle", "time": 2800.47, "timestamp": "00:46:40", "text": "私"}, {"type": "subtitle", "time": 2809.27, "timestamp": "00:46:49", "text": "あ、待って。それを忘れていました。"}]
[{"type": "subtitle", "time": 7385.669, "timestamp": "02:03:05", "text": "ナプキンありますか？うん。うん。時々"}, {"type": "subtitle", "time": 7387.109, "timestamp": "02:03:07", "text": "ナプキンで鼻を覆うと、"}, {"type": "subtitle", "time": 7389.99, "timestamp": "02:03:09", "text": "くしゃみを止めるような"}, {"type": "subtitle", "time": 7393.03, "timestamp": "02:03:13", "text": "続く。うん。うん。それは続く"}, {"type": "subtitle", "time": 7397.109, "timestamp": "02:03:17", "text": "くしゃみ くしゃみが止まらない うーん"}, {"type": "subtitle", "time": 7401.27, "timestamp": "02:03:21", "text": "どう言うんですか？あれが鼻です。"}, {"type": "subtitle", "time": 7404.31, "timestamp": "02:03:24", "text": "あなたの鼻？うん。ナプキンと一緒に。のように"}, {"type": "chat", "time": 7405.914, "timestamp": "02:03:25", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "joqsneex"}, {"type": "subtitle", "time": 7408.31, "timestamp": "02:03:28", "text": "鼻をかむとき。いいえ。"}, {"type": "subtitle", "time": 7411.669, "timestamp": "02:03:31", "text": "鼻をくすぐられるような感じ。うん。えっと"}, {"type": "subtitle", "time": 7414.629, "timestamp": "02:03:34", "text": "鼻をきれいにしてください。"}, {"type": "subtitle", "time": 7418.629, "timestamp": "02:03:38", "text": "そうそう。そうですね。うん。そのため、"}, {"type": "subtitle", "time": 7423.189, "timestamp": "02:03:43", "text": "どうすればいいか"}, {"type": "subtitle", "time": 7425.99, "timestamp": "02:03:45", "text": "えっと、イライラしてるというか。鼻"}, {"type": "subtitle", "time": 7428.87, "timestamp": "02:03:48", "text": "中はこんな感じになるでしょう。あなたがしなければならない"}, {"type": "subtitle", "time": 7431.83, "timestamp": "02:03:51", "text": "私はあなたのくしゃみをもっと良くするつもりです"}, {"type": "subtitle", "time": 7435.27, "timestamp": "02:03:55", "text": "そうすると、漏れ始めたり、"}, {"type": "subtitle", "time": 7436.95, "timestamp": "02:03:56", "text": "何か。"}, {"type": "subtitle", "time": 7439.109, "timestamp": "02:03:59", "text": "そうそう。うん。うん。うん。わからない"}]
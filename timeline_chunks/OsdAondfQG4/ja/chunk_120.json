[{"type": "subtitle", "time": 7202.39, "timestamp": "02:00:02", "text": "物理学的な観点から言えば問題ありません。"}, {"type": "subtitle", "time": 7204.229, "timestamp": "02:00:04", "text": "わかった。ちょっと深入りしすぎたかな、ごめんなさい。"}, {"type": "subtitle", "time": 7207.109, "timestamp": "02:00:07", "text": "頭脳明晰な被験者のような存在。ごめんなさい。"}, {"type": "subtitle", "time": 7209.83, "timestamp": "02:00:09", "text": "しかし物理学的には、"}, {"type": "subtitle", "time": 7211.99, "timestamp": "02:00:11", "text": "収集するのが好きなスペースクリーナーのような"}, {"type": "subtitle", "time": 7213.709, "timestamp": "02:00:13", "text": "埃"}, {"type": "subtitle", "time": 7216.229, "timestamp": "02:00:16", "text": "彼ら。うまくいかない。あれ"}, {"type": "subtitle", "time": 7217.83, "timestamp": "02:00:17", "text": "機能しません。そんなことはしないでください。買わないでください"}, {"type": "subtitle", "time": 7219.669, "timestamp": "02:00:19", "text": "それ。えーと、あなたはただ"}, {"type": "subtitle", "time": 7221.87, "timestamp": "02:00:21", "text": "ダスターを使って、すべての埃を払いましょう"}, {"type": "subtitle", "time": 7224.669, "timestamp": "02:00:24", "text": "あなた自身"}, {"type": "subtitle", "time": 7229.39, "timestamp": "02:00:29", "text": "小さなファンをあなたのそばに置くと"}, {"type": "subtitle", "time": 7232.95, "timestamp": "02:00:32", "text": "ベッドに行って物を吸い込むのは"}, {"type": "subtitle", "time": 7236.35, "timestamp": "02:00:36", "text": "何かするつもり"}, {"type": "subtitle", "time": 7240.51, "timestamp": "02:00:40", "text": "きれいにしろ、きれいにしろ。"}, {"type": "subtitle", "time": 7244.189, "timestamp": "02:00:44", "text": "でも、ご存知のとおり"}, {"type": "subtitle", "time": 7246.51, "timestamp": "02:00:46", "text": "えっと、私は"}, {"type": "subtitle", "time": 7248.95, "timestamp": "02:00:48", "text": "どこにも行き場がないとしたら、"}, {"type": "subtitle", "time": 7250.47, "timestamp": "02:00:50", "text": "部屋には埃が溜まらないので"}, {"type": "subtitle", "time": 7251.31, "timestamp": "02:00:51", "text": "そこには"}, {"type": "subtitle", "time": 7255.51, "timestamp": "02:00:55", "text": "塵が漂う場所はない、浮力もない"}, {"type": "subtitle", "time": 7257.75, "timestamp": "02:00:57", "text": "部屋に空気がないから。だからもし"}]
[{"type": "subtitle", "time": 5340.47, "timestamp": "01:29:00", "text": "言った。"}, {"type": "subtitle", "time": 5342.39, "timestamp": "01:29:02", "text": "まるでクソ相手にプレイしたみたいだ、"}, {"type": "subtitle", "time": 5345.03, "timestamp": "01:29:05", "text": "すりつぶしたり色々、覚えてる？"}, {"type": "subtitle", "time": 5346.91, "timestamp": "01:29:06", "text": "元素反応、"}, {"type": "subtitle", "time": 5348.83, "timestamp": "01:29:08", "text": "あなたが"}, {"type": "subtitle", "time": 5352.11, "timestamp": "01:29:12", "text": "えーと、演奏をやめて"}, {"type": "subtitle", "time": 5354.629, "timestamp": "01:29:14", "text": "一方、ゲームに戻ることもできます。"}, {"type": "subtitle", "time": 5357.43, "timestamp": "01:29:17", "text": "そうすると、たくさんのコンテンツが見つかる"}, {"type": "subtitle", "time": 5360.55, "timestamp": "01:29:20", "text": "そして基本を忘れてしまう、"}, {"type": "subtitle", "time": 5364.709, "timestamp": "01:29:24", "text": "基本的なことだった。そんな感じ。"}, {"type": "subtitle", "time": 5368.39, "timestamp": "01:29:28", "text": "ああ、そうだ、そうだ、そうだ、そうだ。私も辞めた"}, {"type": "subtitle", "time": 5370.189, "timestamp": "01:29:30", "text": "なぜなら私は"}, {"type": "subtitle", "time": 5373.669, "timestamp": "01:29:33", "text": "ジーンジーンと私はどうしても彼女を説得できなかった"}, {"type": "subtitle", "time": 5375.75, "timestamp": "01:29:35", "text": "彼女にとって最初のロールか最初のロールでないか"}, {"type": "subtitle", "time": 5377.79, "timestamp": "01:29:37", "text": "バナー。手に入れることができなかった"}, {"type": "subtitle", "time": 5386.55, "timestamp": "01:29:46", "text": "今はキャラクターが本当にたくさんいますね。うん、"}, {"type": "subtitle", "time": 5388.99, "timestamp": "01:29:48", "text": "たくさんのキャラクターがいて、"}, {"type": "subtitle", "time": 5393.149, "timestamp": "01:29:53", "text": "やるべきことがたくさんある。それはあまりにも"}, {"type": "subtitle", "time": 5395.35, "timestamp": "01:29:55", "text": "面倒くさい。その量の物"}]
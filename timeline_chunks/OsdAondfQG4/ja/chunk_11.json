[{"type": "subtitle", "time": 666.51, "timestamp": "00:11:06", "text": "タイ。あなたはどうですか？"}, {"type": "subtitle", "time": 674.31, "timestamp": "00:11:14", "text": "中国語。"}, {"type": "subtitle", "time": 682.63, "timestamp": "00:11:22", "text": "わあ、すごい。あなたは私のことをあまりうまく話してくれなかった。"}, {"type": "subtitle", "time": 685.509, "timestamp": "00:11:25", "text": "いいえ。いいえ。ああ、そうですね。おお。ああ、私は"}, {"type": "subtitle", "time": 687.03, "timestamp": "00:11:27", "text": "私の一日。良い一日を。我が神よ。その"}, {"type": "subtitle", "time": 688.79, "timestamp": "00:11:28", "text": "わかった。私はそのことをあなたには言っていませんでした。私"}, {"type": "subtitle", "time": 690.11, "timestamp": "00:11:30", "text": "それは"}, {"type": "subtitle", "time": 694.069, "timestamp": "00:11:34", "text": "あなたへ。エンパン。うん。"}, {"type": "subtitle", "time": 697.75, "timestamp": "00:11:37", "text": "あなたは日本語を勉強しているんですよね？"}, {"type": "subtitle", "time": 706.23, "timestamp": "00:11:46", "text": "ああ、神様。はい。私は日本語を勉強しています。私は"}, {"type": "subtitle", "time": 708.949, "timestamp": "00:11:48", "text": "すごく遅い。何てことだ。"}, {"type": "subtitle", "time": 718.389, "timestamp": "00:11:58", "text": "とてもかわいい。はい。わかった。黒。"}]
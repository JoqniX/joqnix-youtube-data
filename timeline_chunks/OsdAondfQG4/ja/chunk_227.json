[{"type": "subtitle", "time": 13621.469, "timestamp": "03:47:01", "text": "麻薬中毒者。彼らはトップにいる"}, {"type": "subtitle", "time": 13625.229, "timestamp": "03:47:05", "text": "木のてっぺんに"}, {"type": "subtitle", "time": 13628.469, "timestamp": "03:47:08", "text": "以上。カラスとかがいるし"}, {"type": "subtitle", "time": 13630.55, "timestamp": "03:47:10", "text": "鳥とかを切り刻んでるから"}, {"type": "subtitle", "time": 13634.83, "timestamp": "03:47:14", "text": "朝。"}, {"type": "subtitle", "time": 13638.63, "timestamp": "03:47:18", "text": "うん。私は、"}, {"type": "subtitle", "time": 13641.71, "timestamp": "03:47:21", "text": "私は今、うーんを歩いています"}, {"type": "subtitle", "time": 13645.189, "timestamp": "03:47:25", "text": "ビーチ沿いの道路。うん、"}, {"type": "subtitle", "time": 13647.51, "timestamp": "03:47:27", "text": "文字通り、私たちが通ったのと同じルートです。"}, {"type": "subtitle", "time": 13651.349, "timestamp": "03:47:31", "text": "えっと、私がTwitterでスペースストリームをやったとき。"}, {"type": "subtitle", "time": 13652.91, "timestamp": "03:47:32", "text": "そう、同じだ"}, {"type": "subtitle", "time": 13656.469, "timestamp": "03:47:36", "text": "ルート。それで"}, {"type": "subtitle", "time": 13659.349, "timestamp": "03:47:39", "text": "えっと、今回はバッテリーパックを持ってきました。"}, {"type": "subtitle", "time": 13662.91, "timestamp": "03:47:42", "text": "つまり、私は文字通り"}, {"type": "subtitle", "time": 13664.99, "timestamp": "03:47:44", "text": "泳ぎ方"}, {"type": "subtitle", "time": 13668.07, "timestamp": "03:47:48", "text": "バッテリーパックが切れるまであとどれくらいかかるか"}, {"type": "subtitle", "time": 13669.95, "timestamp": "03:47:49", "text": "携帯電話のバッテリーが切れた"}, {"type": "subtitle", "time": 13675.269, "timestamp": "03:47:55", "text": "外。そう、でもそうだね。えっと"}, {"type": "subtitle", "time": 13678.67, "timestamp": "03:47:58", "text": "えっと、何て言うんだっけ"}]
[{"type": "subtitle", "time": 16441.029, "timestamp": "04:34:01", "text": "充電器。とりあえず、水を抜いておこう。その"}, {"type": "subtitle", "time": 16443.269, "timestamp": "04:34:03", "text": "大丈夫。大丈夫です。充電が必要になるかもしれません"}, {"type": "subtitle", "time": 16446.709, "timestamp": "04:34:06", "text": "家に帰ったらバッテリーパックを。または"}, {"type": "subtitle", "time": 16449.83, "timestamp": "04:34:09", "text": "水を抜いてそのままにしておけばいいでしょうか？"}, {"type": "subtitle", "time": 16452.949, "timestamp": "04:34:12", "text": "出発するので充電します"}, {"type": "subtitle", "time": 16456.869, "timestamp": "04:34:16", "text": "昼食後すぐの午後。病気"}, {"type": "subtitle", "time": 16459.629, "timestamp": "04:34:19", "text": "その頃には出発しているでしょう。"}, {"type": "subtitle", "time": 16462.029, "timestamp": "04:34:22", "text": "待って、私が"}, {"type": "subtitle", "time": 16466.349, "timestamp": "04:34:26", "text": "歩道上？いつ行けばいいですか？"}, {"type": "subtitle", "time": 16469.109, "timestamp": "04:34:29", "text": "待って、歩き過ぎたとは思わないんだけど、そうだよね？"}, {"type": "subtitle", "time": 16470.51, "timestamp": "04:34:30", "text": "私は"}, {"type": "subtitle", "time": 16472.869, "timestamp": "04:34:32", "text": "歩道上？わかりません。私はただ"}, {"type": "subtitle", "time": 16476.659, "timestamp": "04:34:36", "text": "真っ直ぐ進んで下さい。私は自分の"}, {"type": "subtitle", "time": 16478.029, "timestamp": "04:34:38", "text": "[音楽]"}, {"type": "subtitle", "time": 16481.39, "timestamp": "04:34:41", "text": "方向。でも大丈夫。行くよ"}, {"type": "subtitle", "time": 16484.07, "timestamp": "04:34:44", "text": "真っ直ぐ。大きな"}, {"type": "subtitle", "time": 16486.551, "timestamp": "04:34:46", "text": "北東の掲示板とか、そんな感じのやつ。それは"}, {"type": "subtitle", "time": 16488.869, "timestamp": "04:34:48", "text": "場所。前回私がここにいたとき"}, {"type": "subtitle", "time": 16492.869, "timestamp": "04:34:52", "text": "ビーチ、えっと、ちょっと間違った方向に行ってしまった"}, {"type": "subtitle", "time": 16496.869, "timestamp": "04:34:56", "text": "左折したので、かなり歩かなければならなかった。しかし"}, {"type": "subtitle", "time": 16499.67, "timestamp": "04:34:59", "text": "今度こそ、そんなことはさせない。いいえ"}]
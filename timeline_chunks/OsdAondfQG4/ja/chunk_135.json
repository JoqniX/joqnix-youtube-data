[{"type": "subtitle", "time": 8108.75, "timestamp": "02:15:08", "text": "それはちょっと意地悪に聞こえるね"}, {"type": "subtitle", "time": 8112.21, "timestamp": "02:15:12", "text": "一途な非常に"}, {"type": "subtitle", "time": 8115.27, "timestamp": "02:15:15", "text": "[音楽]"}, {"type": "subtitle", "time": 8118.47, "timestamp": "02:15:18", "text": "言葉遣いが難しい"}, {"type": "subtitle", "time": 8120.43, "timestamp": "02:15:20", "text": "ああ、気にしないで。忘れるつもりだ"}, {"type": "subtitle", "time": 8123.83, "timestamp": "02:15:23", "text": "だって、したくないし、したくないし、したくないから"}, {"type": "subtitle", "time": 8126.47, "timestamp": "02:15:26", "text": "私の脳を傷つける。"}, {"type": "subtitle", "time": 8132.149, "timestamp": "02:15:32", "text": "うん。"}, {"type": "subtitle", "time": 8134.79, "timestamp": "02:15:34", "text": "すごくかっこいい。"}, {"type": "subtitle", "time": 8138.47, "timestamp": "02:15:38", "text": "私たちはたった今、2時間も話していた。"}, {"type": "subtitle", "time": 8147.03, "timestamp": "02:15:47", "text": "ああ、まるで私が覚えていないかのように始まるんだ。だった"}, {"type": "subtitle", "time": 8149.51, "timestamp": "02:15:49", "text": "それは私の時間で12時30分くらいですか？つまり、1です"}, {"type": "subtitle", "time": 8153.589, "timestamp": "02:15:53", "text": "時間。たった1時間です。うん。くそ。"}, {"type": "subtitle", "time": 8155.83, "timestamp": "02:15:55", "text": "どうでも。私は気が狂いそうだった。私は"}]
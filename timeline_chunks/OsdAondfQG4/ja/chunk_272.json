[{"type": "subtitle", "time": 16323.11, "timestamp": "04:32:03", "text": "場所。だから、自分の進むべき道がわからないんです。"}, {"type": "subtitle", "time": 16325.469, "timestamp": "04:32:05", "text": "私は自分の道を見つけるだろう"}, {"type": "subtitle", "time": 16329.87, "timestamp": "04:32:09", "text": "走らなければならない。おお、"}, {"type": "subtitle", "time": 16334.349, "timestamp": "04:32:14", "text": "男の子。だから、私はフルを着ています"}, {"type": "subtitle", "time": 16336.83, "timestamp": "04:32:16", "text": "スリーブ。うん。 A"}, {"type": "subtitle", "time": 16342.149, "timestamp": "04:32:22", "text": "スウェットシャツだけど、長袖のドレス。"}, {"type": "subtitle", "time": 16345.349, "timestamp": "04:32:25", "text": "ああ、神様。ショートパンツではなく、"}, {"type": "subtitle", "time": 16346.269, "timestamp": "04:32:26", "text": "のように"}, {"type": "subtitle", "time": 16350.269, "timestamp": "04:32:30", "text": "これは何て言うんでしたっけ？パジャマ。"}, {"type": "subtitle", "time": 16353.83, "timestamp": "04:32:33", "text": "いや、もし私がここにいたらみんな笑うだろう"}, {"type": "subtitle", "time": 16356.51, "timestamp": "04:32:36", "text": "まるでプディングのように眠っている"}, {"type": "subtitle", "time": 16360.07, "timestamp": "04:32:40", "text": "パジャマ。でも、それはもっと、えっと、ほら"}, {"type": "subtitle", "time": 16362.71, "timestamp": "04:32:42", "text": "ショートパンツか何か、もしくはズボンみたいなもの"}, {"type": "subtitle", "time": 16364.95, "timestamp": "04:32:44", "text": "そういう類のもの。いいえ。えっと、こう考えてみてください。"}, {"type": "subtitle", "time": 16368.389, "timestamp": "04:32:48", "text": "これ。えーっと、もしあなたが"}, {"type": "subtitle", "time": 16370.79, "timestamp": "04:32:50", "text": "朝の散歩に出かけるか、"}, {"type": "subtitle", "time": 16374.229, "timestamp": "04:32:54", "text": "何か正しい、あの、フライパンの底"}, {"type": "subtitle", "time": 16377.87, "timestamp": "04:32:57", "text": "あれ、ああ、あれだよ"}]
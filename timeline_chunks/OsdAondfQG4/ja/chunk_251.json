[{"type": "subtitle", "time": 15061.429, "timestamp": "04:11:01", "text": "わからない。私の親戚のように"}, {"type": "subtitle", "time": 15062.67, "timestamp": "04:11:02", "text": "最近"}, {"type": "subtitle", "time": 15065.389, "timestamp": "04:11:05", "text": "まるで食べ物を注文するように。"}, {"type": "subtitle", "time": 15068.95, "timestamp": "04:11:08", "text": "わかった。ファストフードとか色々。"}, {"type": "subtitle", "time": 15073.189, "timestamp": "04:11:13", "text": "まるで、まるで"}, {"type": "subtitle", "time": 15075.91, "timestamp": "04:11:15", "text": "期間、右、同様の順序"}, {"type": "subtitle", "time": 15077.83, "timestamp": "04:11:17", "text": "モバイル注文や注文など"}, {"type": "subtitle", "time": 15080.229, "timestamp": "04:11:20", "text": "ネットで注文した商品とか、そういうもの。"}, {"type": "subtitle", "time": 15082.59, "timestamp": "04:11:22", "text": "最大でも30分くらいで終わるはず"}, {"type": "subtitle", "time": 15085.349, "timestamp": "04:11:25", "text": "何かか40か、それは"}, {"type": "subtitle", "time": 15087.15, "timestamp": "04:11:27", "text": "現在地。"}, {"type": "subtitle", "time": 15090.71, "timestamp": "04:11:30", "text": "しかし、これはアプリで表示されるように"}, {"type": "subtitle", "time": 15094.15, "timestamp": "04:11:34", "text": "15分くらいかな、でも"}, {"type": "subtitle", "time": 15096.95, "timestamp": "04:11:36", "text": "2時間くらいかかったよ。"}, {"type": "subtitle", "time": 15100.11, "timestamp": "04:11:40", "text": "ああ、なんてことだ、人々はとても"}, {"type": "subtitle", "time": 15102.79, "timestamp": "04:11:42", "text": "混乱した。ああ神様、犬のギャングは"}, {"type": "subtitle", "time": 15107.269, "timestamp": "04:11:47", "text": "私を攻撃している。それは本当に素晴らしいですね。こんにちは。"}, {"type": "subtitle", "time": 15108.91, "timestamp": "04:11:48", "text": "こんにちは。うん、"}, {"type": "subtitle", "time": 15113.11, "timestamp": "04:11:53", "text": "それで、ああ、人が歩いている"}, {"type": "subtitle", "time": 15114.429, "timestamp": "04:11:54", "text": "に沿って"}, {"type": "subtitle", "time": 15117.83, "timestamp": "04:11:57", "text": "海岸。彼らは私が話しているのを聞くかもしれない、"}, {"type": "subtitle", "time": 15118.75, "timestamp": "04:11:58", "text": "しかし"}]
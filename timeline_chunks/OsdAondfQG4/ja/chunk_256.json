[{"type": "subtitle", "time": 15360.95, "timestamp": "04:16:00", "text": "使い捨ての袋とかそういうのと"}, {"type": "subtitle", "time": 15363.11, "timestamp": "04:16:03", "text": "家に持ち帰ってください。"}, {"type": "subtitle", "time": 15366.71, "timestamp": "04:16:06", "text": "荷物の中に入れておいたよ。えっと"}, {"type": "subtitle", "time": 15367.55, "timestamp": "04:16:07", "text": "また、"}, {"type": "subtitle", "time": 15370.75, "timestamp": "04:16:10", "text": "洗濯物と家に帰るように、家に着く"}, {"type": "subtitle", "time": 15373.75, "timestamp": "04:16:13", "text": "夜にそれらをしばらく置いておくと"}, {"type": "subtitle", "time": 15376.07, "timestamp": "04:16:16", "text": "洗濯機とかそういうもの。私はただ"}, {"type": "subtitle", "time": 15390.55, "timestamp": "04:16:30", "text": "ねえ、それってすごく不公平だよね？私はします"}, {"type": "subtitle", "time": 15394.07, "timestamp": "04:16:34", "text": "ビーチに来た目的は何？歩いて"}, {"type": "subtitle", "time": 15396.309, "timestamp": "04:16:36", "text": "海を見て貝殻を見つけて"}, {"type": "subtitle", "time": 15410.309, "timestamp": "04:16:50", "text": "えっと、それは12歳くらいだったかな、文字通り"}, {"type": "subtitle", "time": 15411.87, "timestamp": "04:16:51", "text": "ミッドナイトカインド"}, {"type": "subtitle", "time": 15415.59, "timestamp": "04:16:55", "text": "の。真夜中頃だったかな。しかし"}, {"type": "subtitle", "time": 15416.59, "timestamp": "04:16:56", "text": "それは"}, {"type": "subtitle", "time": 15419.75, "timestamp": "04:16:59", "text": "いいね。でも、あれはちょっとかっこよかったよ。私"}]
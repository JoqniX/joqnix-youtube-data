[{"type": "subtitle", "time": 14161.11, "timestamp": "03:56:01", "text": "私は死ぬ、私は死ぬ、私は泣く。私は死ぬだろう。私"}, {"type": "subtitle", "time": 14162.429, "timestamp": "03:56:02", "text": "私はしません"}, {"type": "subtitle", "time": 14165.309, "timestamp": "03:56:05", "text": "知る。でも、えーと、"}, {"type": "subtitle", "time": 14167.67, "timestamp": "03:56:07", "text": "ブランコ。あれは何て呼ぶの？"}, {"type": "subtitle", "time": 14169.91, "timestamp": "03:56:09", "text": "左右にスイングできる場所で"}, {"type": "subtitle", "time": 14173.189, "timestamp": "03:56:13", "text": "上下？待って、上下に。待って、"}, {"type": "subtitle", "time": 14175.15, "timestamp": "03:56:15", "text": "これは何と呼ぶのですか？"}, {"type": "subtitle", "time": 14177.67, "timestamp": "03:56:17", "text": "また？あれは見えるけど、"}, {"type": "subtitle", "time": 14180.75, "timestamp": "03:56:20", "text": "木製の"}, {"type": "subtitle", "time": 14184.15, "timestamp": "03:56:24", "text": "もの。ええ、そうですね。現在、お店では"}, {"type": "subtitle", "time": 14187.75, "timestamp": "03:56:27", "text": "あまりにも。文字通り2つの犬の目標がある"}, {"type": "subtitle", "time": 14192.229, "timestamp": "03:56:32", "text": "私をじっと見つめている。この男は何をやっているんだ？"}, {"type": "subtitle", "time": 14194.55, "timestamp": "03:56:34", "text": "なぜ彼は携帯電話を口に当てているのか"}, {"type": "subtitle", "time": 14196.269, "timestamp": "03:56:36", "text": "そして話す"}, {"type": "subtitle", "time": 14204.229, "timestamp": "03:56:44", "text": "神。ああ、花とかもあるけど、"}, {"type": "subtitle", "time": 14213.11, "timestamp": "03:56:53", "text": "これは花とかが入っているものですね。"}]
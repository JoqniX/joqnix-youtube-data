[{"type": "subtitle", "time": 9063.67, "timestamp": "02:31:03", "text": "ああ、気にしないで。はい、確認していました"}, {"type": "subtitle", "time": 9066.95, "timestamp": "02:31:06", "text": "あなたの名前を確認していました。"}, {"type": "subtitle", "time": 9069.03, "timestamp": "02:31:09", "text": "あなたを追加したかどうか確信が持てませんでした"}, {"type": "subtitle", "time": 9071.19, "timestamp": "02:31:11", "text": "今。"}, {"type": "subtitle", "time": 9073.19, "timestamp": "02:31:13", "text": "どれ？"}, {"type": "subtitle", "time": 9075.27, "timestamp": "02:31:15", "text": "Discordでいいね。私は確信が持てなかった"}, {"type": "subtitle", "time": 9077.27, "timestamp": "02:31:17", "text": "Discordであなたを追加しました。そうそう。"}, {"type": "subtitle", "time": 9078.55, "timestamp": "02:31:18", "text": "ええ、私たちは友達です。私はすでに持っています"}, {"type": "subtitle", "time": 9081.63, "timestamp": "02:31:21", "text": "これについて友達がいます。ええ、だって私は"}, {"type": "subtitle", "time": 9083.59, "timestamp": "02:31:23", "text": "知る。私はちょうど考えていた"}, {"type": "subtitle", "time": 9086.55, "timestamp": "02:31:26", "text": "「ちょっと待って。私たちは？私はそうは思わない」"}, {"type": "subtitle", "time": 9101.429, "timestamp": "02:31:41", "text": "何を覚えていますか？わからない。あなた"}, {"type": "subtitle", "time": 9104.63, "timestamp": "02:31:44", "text": "私たちはSとのAmong Usコラボに参加していました"}, {"type": "subtitle", "time": 9110.15, "timestamp": "02:31:50", "text": "覚えてる？"}, {"type": "subtitle", "time": 9112.79, "timestamp": "02:31:52", "text": "私は長い間Among Usをプレイしていません"}, {"type": "subtitle", "time": 9119.59, "timestamp": "02:31:59", "text": "だから、よくわからないんです。私の最も"}]
[{"type": "subtitle", "time": 14411.229, "timestamp": "04:00:11", "text": "間。"}, {"type": "subtitle", "time": 14420.349, "timestamp": "04:00:20", "text": "何？自殺する。あなたの"}, {"type": "subtitle", "time": 14426.229, "timestamp": "04:00:26", "text": "耳は実際に私に"}, {"type": "subtitle", "time": 14430.07, "timestamp": "04:00:30", "text": "足が抜け落ちるか何かだ。私の私の足"}, {"type": "subtitle", "time": 14431.79, "timestamp": "04:00:31", "text": "すでに"}, {"type": "subtitle", "time": 14455.83, "timestamp": "04:00:55", "text": "ビーチ。それは靴用ですか？なるほど。"}, {"type": "subtitle", "time": 14458.79, "timestamp": "04:00:58", "text": "待って、あれってハンドバッグ？え、何？待って、"}]
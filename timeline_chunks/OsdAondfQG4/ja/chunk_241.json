[{"type": "subtitle", "time": 14460.51, "timestamp": "04:01:00", "text": "いいえ。それは、それは"}, {"type": "subtitle", "time": 14465.03, "timestamp": "04:01:05", "text": "あれは何ですか？待って、私はそうしないようにしている"}, {"type": "subtitle", "time": 14475.95, "timestamp": "04:01:15", "text": "何か。誰かが押したか、"}, {"type": "subtitle", "time": 14480.349, "timestamp": "04:01:20", "text": "何か。文字通りビーチのすぐそば。"}, {"type": "subtitle", "time": 14500.75, "timestamp": "04:01:40", "text": "ああ、大きいやつだよね"}, {"type": "subtitle", "time": 14503.67, "timestamp": "04:01:43", "text": "今。小さなカニのビーチもあります。"}, {"type": "subtitle", "time": 14506.229, "timestamp": "04:01:46", "text": "歩いて来るんだよ、ベイビー。そして私は歩いている。おお"}, {"type": "subtitle", "time": 14507.95, "timestamp": "04:01:47", "text": "ああ、それはとても"}, {"type": "subtitle", "time": 14511.15, "timestamp": "04:01:51", "text": "かわいい。少し気難しい"}, {"type": "subtitle", "time": 14514.95, "timestamp": "04:01:54", "text": "ビーチ。実は自分がどこにいるのか分からないんです。"}, {"type": "subtitle", "time": 14518.03, "timestamp": "04:01:58", "text": "私はただまっすぐ歩いています"}]
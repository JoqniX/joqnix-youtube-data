[{"type": "subtitle", "time": 6662.39, "timestamp": "01:51:02", "text": "うん、大変だね。のように、"}, {"type": "subtitle", "time": 6664.39, "timestamp": "01:51:04", "text": "つまり、最も"}, {"type": "subtitle", "time": 6667.03, "timestamp": "01:51:07", "text": "今プレミアムな人たち、誰が買ったか"}, {"type": "subtitle", "time": 6670.31, "timestamp": "01:51:10", "text": "4年前の高級品のように、"}, {"type": "subtitle", "time": 6677.59, "timestamp": "01:51:17", "text": "うん、それは、あるいは2080は、ああ、"}, {"type": "subtitle", "time": 6680.709, "timestamp": "01:51:20", "text": "2080年ですらない。2060年は、"}, {"type": "subtitle", "time": 6682.39, "timestamp": "01:51:22", "text": "1080の2倍の性能？それは"}, {"type": "subtitle", "time": 6683.35, "timestamp": "01:51:23", "text": "クレイジー。"}, {"type": "subtitle", "time": 6684.95, "timestamp": "01:51:24", "text": "うん。"}, {"type": "subtitle", "time": 6687.109, "timestamp": "01:51:27", "text": "そうなんですか？え、そうなの？それは"}, {"type": "subtitle", "time": 6688.75, "timestamp": "01:51:28", "text": "2倍ではない。"}, {"type": "subtitle", "time": 6698.95, "timestamp": "01:51:38", "text": "私はそれを失くしてしまった。紛失していないか、"}, {"type": "subtitle", "time": 6703.109, "timestamp": "01:51:43", "text": "まるで6年後に死んでしまったかのようだ。"}, {"type": "subtitle", "time": 6705.07, "timestamp": "01:51:45", "text": "わかった。"}, {"type": "subtitle", "time": 6708.87, "timestamp": "01:51:48", "text": "待って。いいえ。2080対1080ではありません。"}, {"type": "subtitle", "time": 6710.229, "timestamp": "01:51:50", "text": "ダブル。なんてこった？なぜ私は考えたのか"}, {"type": "subtitle", "time": 6712.39, "timestamp": "01:51:52", "text": "2倍だったの？"}, {"type": "subtitle", "time": 6714.27, "timestamp": "01:51:54", "text": "えっと、"}, {"type": "subtitle", "time": 6718.87, "timestamp": "01:51:58", "text": "2020年の市場について、私は嘘をつきません。"}]
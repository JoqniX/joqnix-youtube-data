[{"type": "subtitle", "time": 4860.39, "timestamp": "01:21:00", "text": "すぐ。すぐ。私はもっ​​とプレイしています"}, {"type": "subtitle", "time": 4863.669, "timestamp": "01:21:03", "text": "Warframeの話だけどね。うん。たくさんプレイしました"}, {"type": "subtitle", "time": 4865.669, "timestamp": "01:21:05", "text": "Warframeの。"}, {"type": "subtitle", "time": 4869.03, "timestamp": "01:21:09", "text": "ああ、Warframe。ああ、Warframeをプレイしているんですね？"}, {"type": "subtitle", "time": 4871.669, "timestamp": "01:21:11", "text": "うん。どうですか？それはより良いですか？"}, {"type": "subtitle", "time": 4874.79, "timestamp": "01:21:14", "text": "運命か、それとも運命と同じか？"}, {"type": "subtitle", "time": 4876.31, "timestamp": "01:21:16", "text": "それらを比較するのは公平ではないと思う"}, {"type": "subtitle", "time": 4878.75, "timestamp": "01:21:18", "text": "だって彼らは2人だから"}, {"type": "subtitle", "time": 4881.43, "timestamp": "01:21:21", "text": "違うんだよ、わかるだろ？ええ、おっしゃる通りです。"}, {"type": "subtitle", "time": 4883.189, "timestamp": "01:21:23", "text": "うん、"}, {"type": "subtitle", "time": 4884.55, "timestamp": "01:21:24", "text": "それはMinecraftを比較しようとするようなものだ"}, {"type": "subtitle", "time": 4894.39, "timestamp": "01:21:34", "text": "うん。ええと、でも私は戦争はかなり"}, {"type": "subtitle", "time": 4897.59, "timestamp": "01:21:37", "text": "私の意見では、あなたが望むなら楽しい"}, {"type": "subtitle", "time": 4902.39, "timestamp": "01:21:42", "text": "銃を作るのに3日くらい待つ。"}, {"type": "subtitle", "time": 4905.189, "timestamp": "01:21:45", "text": "銃をクラフトできます。"}, {"type": "subtitle", "time": 4906.87, "timestamp": "01:21:46", "text": "ええ、武器を作ることはできますよ。つまり、"}, {"type": "subtitle", "time": 4908.75, "timestamp": "01:21:48", "text": "入手できる武器のほとんどはクラフト品です"}, {"type": "subtitle", "time": 4911.43, "timestamp": "01:21:51", "text": "クラフトですが、クラフトするときは"}, {"type": "subtitle", "time": 4914.669, "timestamp": "01:21:54", "text": "武器、タイマーがあります"}, {"type": "subtitle", "time": 4918.149, "timestamp": "01:21:58", "text": "終了した。えーと、通常は12時間くらいです"}]
[{"type": "subtitle", "time": 9783.71, "timestamp": "02:43:03", "text": "ええ、火の近くで、花火ではありません。"}, {"type": "subtitle", "time": 9787.03, "timestamp": "02:43:07", "text": "暖炉を持っていた私は"}, {"type": "subtitle", "time": 9789.63, "timestamp": "02:43:09", "text": "オレンジジュース"}, {"type": "subtitle", "time": 9792.95, "timestamp": "02:43:12", "text": "何かあったので、私は「うん、話してる」と言いました"}, {"type": "subtitle", "time": 9795.469, "timestamp": "02:43:15", "text": "そして、グラス一杯の私の"}, {"type": "subtitle", "time": 9808.03, "timestamp": "02:43:28", "text": "右。うん、"}, {"type": "subtitle", "time": 9810.99, "timestamp": "02:43:30", "text": "えーと、次のコラボは"}, {"type": "subtitle", "time": 9815.389, "timestamp": "02:43:35", "text": "午後6時と"}, {"type": "subtitle", "time": 9817.95, "timestamp": "02:43:37", "text": "ポル出身のアタムス"}, {"type": "chat", "time": 9821.394, "timestamp": "02:43:41", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "Oh"}, {"type": "subtitle", "time": 9821.67, "timestamp": "02:43:41", "text": "星空。その前に、えーと"}, {"type": "subtitle", "time": 9824.95, "timestamp": "02:43:44", "text": "その前にいくつか確認する必要がある"}, {"type": "chat", "time": 9825.21, "timestamp": "02:43:45", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "Artemis ji"}, {"type": "subtitle", "time": 9830.07, "timestamp": "02:43:50", "text": "えっと、他の人といくつか確認する"}, {"type": "subtitle", "time": 9837.75, "timestamp": "02:43:57", "text": "そして他のものを使っていくつかのものを変える"}, {"type": "subtitle", "time": 9839.59, "timestamp": "02:43:59", "text": "協力者と連絡を取り、新しい人脈を築く"}]
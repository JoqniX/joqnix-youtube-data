[{"type": "subtitle", "time": 2111.589, "timestamp": "00:35:11", "text": "[音楽]"}, {"type": "subtitle", "time": 2115.109, "timestamp": "00:35:15", "text": "今のこの小さなグループが大好きだ。私は"}, {"type": "subtitle", "time": 2117.349, "timestamp": "00:35:17", "text": "今どきのイケてる子たちみたいに。何てことだ。"}, {"type": "subtitle", "time": 2123.91, "timestamp": "00:35:23", "text": "周りのみんなは小さな"}, {"type": "subtitle", "time": 2126.95, "timestamp": "00:35:26", "text": "サイクロプス群。そして私は自分の"}, {"type": "subtitle", "time": 2134.39, "timestamp": "00:35:34", "text": "暗いはずだ。何てことだ。私たちは"}, {"type": "subtitle", "time": 2143.51, "timestamp": "00:35:43", "text": "おお、"}, {"type": "subtitle", "time": 2145.75, "timestamp": "00:35:45", "text": "はい。"}, {"type": "subtitle", "time": 2147.829, "timestamp": "00:35:47", "text": "ジョーは今や人気者グループの一員だ。うん。"}, {"type": "subtitle", "time": 2150.55, "timestamp": "00:35:50", "text": "ゆっくり、ゆっくり。"}, {"type": "subtitle", "time": 2153.99, "timestamp": "00:35:53", "text": "うん。うん。うん。あなたはどうですか？"}, {"type": "subtitle", "time": 2156.47, "timestamp": "00:35:56", "text": "私は中国人です。"}, {"type": "subtitle", "time": 2159.829, "timestamp": "00:35:59", "text": "ああ、中国人め。わかった。見せてください"}]
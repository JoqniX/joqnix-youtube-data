[{"type": "subtitle", "time": 1621.789, "timestamp": "00:27:01", "text": "つまり、つまり、"}, {"type": "subtitle", "time": 1624.549, "timestamp": "00:27:04", "text": "時々私たちはただ信じる"}, {"type": "subtitle", "time": 1627.59, "timestamp": "00:27:07", "text": "中国製品。待って、あれはどこ？"}, {"type": "subtitle", "time": 1630.63, "timestamp": "00:27:10", "text": "州？そして、あなたの州も。ああ、そうだ。"}, {"type": "subtitle", "time": 1632.95, "timestamp": "00:27:12", "text": "元気かい？あなたがそうであることを願っています"}, {"type": "subtitle", "time": 1637.11, "timestamp": "00:27:17", "text": "順調です。聖人だと思う"}, {"type": "subtitle", "time": 1638.95, "timestamp": "00:27:18", "text": "それはどこに置いてありますか？さあ、見つけに来て"}, {"type": "subtitle", "time": 1645.11, "timestamp": "00:27:25", "text": "えっと"}, {"type": "subtitle", "time": 1647.909, "timestamp": "00:27:27", "text": "ボトルモードのインスタンス時間。ああ、個人的な"}, {"type": "subtitle", "time": 1651.83, "timestamp": "00:27:31", "text": "スピード。 11. 了解しました。わかった。わかった。感謝"}, {"type": "subtitle", "time": 1659.43, "timestamp": "00:27:39", "text": "うん。"}, {"type": "subtitle", "time": 1667.99, "timestamp": "00:27:47", "text": "今年一番の幸運な人であり続けよう。"}, {"type": "subtitle", "time": 1670.789, "timestamp": "00:27:50", "text": "はい、"}, {"type": "subtitle", "time": 1674.63, "timestamp": "00:27:54", "text": "設定が完了しました。設定の中にありました。"}, {"type": "subtitle", "time": 1677.269, "timestamp": "00:27:57", "text": "ええと、よりフルーラー、そして個人の顔"}]
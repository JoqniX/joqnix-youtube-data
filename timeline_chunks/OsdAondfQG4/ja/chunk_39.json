[{"type": "subtitle", "time": 2350.67, "timestamp": "00:39:10", "text": "その上"}, {"type": "subtitle", "time": 2356.95, "timestamp": "00:39:16", "text": "中国人は食べ物を食べます。"}, {"type": "subtitle", "time": 2359.99, "timestamp": "00:39:19", "text": "私は止まる必要はなかった。とてもかわいい。"}, {"type": "subtitle", "time": 2367.349, "timestamp": "00:39:27", "text": "待って、待って、待って、待って、待って。"}, {"type": "subtitle", "time": 2373.75, "timestamp": "00:39:33", "text": "あなたは、私はいつもそうではなかった"}, {"type": "subtitle", "time": 2376.109, "timestamp": "00:39:36", "text": "トレーニング。つまり、"}]
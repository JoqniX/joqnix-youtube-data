[{"type": "subtitle", "time": 5700.39, "timestamp": "01:35:00", "text": "激しい試合は"}, {"type": "subtitle", "time": 5701.39, "timestamp": "01:35:01", "text": "ストリーム"}, {"type": "subtitle", "time": 5706.31, "timestamp": "01:35:06", "text": "PS 私は1660を持っています"}, {"type": "subtitle", "time": 5711.189, "timestamp": "01:35:11", "text": "だから、もし"}, {"type": "subtitle", "time": 5712.95, "timestamp": "01:35:12", "text": "私もストリーミング配信をしています。"}, {"type": "subtitle", "time": 5720.629, "timestamp": "01:35:20", "text": "ああ、今かかりつけ医は誰ですか？"}, {"type": "subtitle", "time": 5725.189, "timestamp": "01:35:25", "text": "今は3060 Tiを持っています。うん。"}, {"type": "subtitle", "time": 5727.11, "timestamp": "01:35:27", "text": "だから、本当に言いたいのは"}, {"type": "subtitle", "time": 5728.87, "timestamp": "01:35:28", "text": "本当にラッキーです。"}, {"type": "subtitle", "time": 5730.95, "timestamp": "01:35:30", "text": "今は50シリーズですが、50が"}, {"type": "subtitle", "time": 5733.99, "timestamp": "01:35:33", "text": "シリーズは"}, {"type": "subtitle", "time": 5735.91, "timestamp": "01:35:35", "text": "そうは思えない。おそらく待つ"}, {"type": "subtitle", "time": 5738.229, "timestamp": "01:35:38", "text": "60シリーズがもし発売されるとしたら"}, {"type": "subtitle", "time": 5740.47, "timestamp": "01:35:40", "text": "そんな風に出て行ったんだ。"}, {"type": "subtitle", "time": 5741.75, "timestamp": "01:35:41", "text": "人数が足りなくなってきている。何が"}, {"type": "subtitle", "time": 5745.59, "timestamp": "01:35:45", "text": "彼らはどうするつもりなのか？ 10,000。"}, {"type": "subtitle", "time": 5748.47, "timestamp": "01:35:48", "text": "ええ、私もそう思っていました。"}, {"type": "subtitle", "time": 5759.95, "timestamp": "01:35:59", "text": "「うん」みたいな数字を見たよ。 1.25"}]
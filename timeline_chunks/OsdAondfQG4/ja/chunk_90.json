[{"type": "subtitle", "time": 5403.11, "timestamp": "01:30:03", "text": "うん。 Zenlessにハマれると思った"}, {"type": "subtitle", "time": 5404.629, "timestamp": "01:30:04", "text": "以前は他のモバイルゲームをプレイしていたから"}, {"type": "subtitle", "time": 5408.55, "timestamp": "01:30:08", "text": "Zenlessに似たゲーム。うん。えっと、でも私は"}, {"type": "subtitle", "time": 5410.87, "timestamp": "01:30:10", "text": "わからない。私はできませんでした。唯一の"}, {"type": "subtitle", "time": 5413.79, "timestamp": "01:30:13", "text": "モバイルゲームで本当にハマりそうです"}, {"type": "subtitle", "time": 5416.55, "timestamp": "01:30:16", "text": "確かブレイブフロンティアだったと思う。あなたは知っていますか"}, {"type": "subtitle", "time": 5419.51, "timestamp": "01:30:19", "text": "そのゲームは何ですか？ああ、聞いたことがあるよ。"}, {"type": "subtitle", "time": 5421.43, "timestamp": "01:30:21", "text": "うん。"}, {"type": "subtitle", "time": 5424.51, "timestamp": "01:30:24", "text": "それはまるでオリジナルキャラクターのようだった"}, {"type": "subtitle", "time": 5427.75, "timestamp": "01:30:27", "text": "ワイフガッチャゲーム。"}, {"type": "subtitle", "time": 5431.709, "timestamp": "01:30:31", "text": "現在は販売終了しています。私はそうは思わない"}, {"type": "subtitle", "time": 5434.47, "timestamp": "01:30:34", "text": "知る。私はそのゲームをよくプレイしていました"}, {"type": "subtitle", "time": 5441.03, "timestamp": "01:30:41", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 5445.189, "timestamp": "01:30:45", "text": "うん。たくさんのこと。"}, {"type": "subtitle", "time": 5447.59, "timestamp": "01:30:47", "text": "好きなゲームジャンルは何ですか？"}, {"type": "subtitle", "time": 5453.43, "timestamp": "01:30:53", "text": "完全なものを持っているかどうかわかりません"}, {"type": "subtitle", "time": 5455.43, "timestamp": "01:30:55", "text": "FPSゲームが好きなのでお気に入りですが、"}, {"type": "subtitle", "time": 5457.229, "timestamp": "01:30:57", "text": "また、愛も好き"}, {"type": "subtitle", "time": 5459.91, "timestamp": "01:30:59", "text": "定期的なサバイバルゲームと戦略"}]
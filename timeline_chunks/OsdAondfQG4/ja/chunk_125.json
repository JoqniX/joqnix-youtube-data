[{"type": "subtitle", "time": 7502.31, "timestamp": "02:05:02", "text": "我々を操ろうとしない。"}, {"type": "subtitle", "time": 7504.31, "timestamp": "02:05:04", "text": "うん。うん。今まさにそれを飲んでいるところです"}, {"type": "subtitle", "time": 7506.91, "timestamp": "02:05:06", "text": "今。私が"}, {"type": "subtitle", "time": 7515.43, "timestamp": "02:05:15", "text": "そして、今となってはもう思い出せないだろう。"}, {"type": "subtitle", "time": 7520.47, "timestamp": "02:05:20", "text": "まるで流れる水のような感覚だったと記憶しています。"}, {"type": "subtitle", "time": 7523.589, "timestamp": "02:05:23", "text": "流水。うん。流水。のように"}, {"type": "subtitle", "time": 7525.43, "timestamp": "02:05:25", "text": "ああ、そうだね。"}, {"type": "subtitle", "time": 7529.51, "timestamp": "02:05:29", "text": "つまり、鼻の中に水が入っているということだ。"}, {"type": "subtitle", "time": 7530.95, "timestamp": "02:05:30", "text": "わからない。本当に難しい"}, {"type": "subtitle", "time": 7533.109, "timestamp": "02:05:33", "text": "流れる水を思い出してください。ええ、それは"}, {"type": "subtitle", "time": 7536.31, "timestamp": "02:05:36", "text": "真実。それは本当だ。"}, {"type": "subtitle", "time": 7538.149, "timestamp": "02:05:38", "text": "私の水は一体どこへ行ってしまうの？なぜ"}, {"type": "chat", "time": 7539.924, "timestamp": "02:05:39", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "Natural spring water yumyum"}, {"type": "subtitle", "time": 7541.229, "timestamp": "02:05:41", "text": "逃げる？なぜ逃げているのか？"}, {"type": "subtitle", "time": 7549.91, "timestamp": "02:05:49", "text": "天然の湧き水"}, {"type": "subtitle", "time": 7551.51, "timestamp": "02:05:51", "text": "鼻から。天然の湧き水が湧き出る"}, {"type": "subtitle", "time": 7559.27, "timestamp": "02:05:59", "text": "待って、あれは何？私たちが話していたのは何でしたっけ？"}]
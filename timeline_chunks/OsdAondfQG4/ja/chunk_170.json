[{"type": "subtitle", "time": 10223.23, "timestamp": "02:50:23", "text": "ああ、わかった。私はDMを1つ送った"}, {"type": "subtitle", "time": 10224.59, "timestamp": "02:50:24", "text": "人。"}, {"type": "subtitle", "time": 10237.269, "timestamp": "02:50:37", "text": "えっと、私も既にそういう人間なんです。"}, {"type": "subtitle", "time": 10240.83, "timestamp": "02:50:40", "text": "兄弟、私はたくさんの人を"}, {"type": "subtitle", "time": 10244.55, "timestamp": "02:50:44", "text": "リスト。これはとんでもないことになるぞ。それで、それで"}, {"type": "subtitle", "time": 10247.03, "timestamp": "02:50:47", "text": "これまでのところ、何人いるか数えている人はいますか？"}, {"type": "subtitle", "time": 10249.75, "timestamp": "02:50:49", "text": "これまでコラボレーションした人たちは？させて"}, {"type": "subtitle", "time": 10255.389, "timestamp": "02:50:55", "text": "実は、自分で数えたんです。 1 2 3 4 5"}]
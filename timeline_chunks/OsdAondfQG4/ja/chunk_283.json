[{"type": "subtitle", "time": 16981.91, "timestamp": "04:43:01", "text": "知る。準備して行くよ。準備して"}, {"type": "subtitle", "time": 16984.35, "timestamp": "04:43:04", "text": "授業のために。散歩を楽しんでください。"}, {"type": "subtitle", "time": 16987.91, "timestamp": "04:43:07", "text": "やあ、相棒。気をつけて。"}, {"type": "subtitle", "time": 16991.27, "timestamp": "04:43:11", "text": "ここが私が必要としている場所だと思う"}, {"type": "subtitle", "time": 16994.39, "timestamp": "04:43:14", "text": "持ち帰り。本当にそうでしょうか？私はそうは思わない"}, {"type": "subtitle", "time": 16996.868, "timestamp": "04:43:16", "text": "知る。あのね？ちょっと歩いてみます"}, {"type": "subtitle", "time": 16998.99, "timestamp": "04:43:18", "text": "少し"}, {"type": "subtitle", "time": 17001.948, "timestamp": "04:43:21", "text": "さらに遠く。私の中にはこう思う"}, {"type": "subtitle", "time": 17004.788, "timestamp": "04:43:24", "text": "あの喜び。ここは同じ場所です。あなた"}, {"type": "subtitle", "time": 17006.59, "timestamp": "04:43:26", "text": "間違った"}, {"type": "subtitle", "time": 17008.11, "timestamp": "04:43:28", "text": "時間。"}, {"type": "subtitle", "time": 17011.708, "timestamp": "04:43:31", "text": "うん。じゃあ、ちょっと歩いてみます。"}, {"type": "subtitle", "time": 17014.788, "timestamp": "04:43:34", "text": "さらに遠く。よし。ああ、もう一人いる"}, {"type": "subtitle", "time": 17015.788, "timestamp": "04:43:35", "text": "ビーチ"}, {"type": "subtitle", "time": 17018.23, "timestamp": "04:43:38", "text": "リゾート。文字通り"}, {"type": "subtitle", "time": 17022.03, "timestamp": "04:43:42", "text": "海の上、砂浜で腕立て伏せ。"}, {"type": "subtitle", "time": 17025.628, "timestamp": "04:43:45", "text": "おお。ビーチの人たちはクールだね"}, {"type": "subtitle", "time": 17031.39, "timestamp": "04:43:51", "text": "行く。"}, {"type": "subtitle", "time": 17033.39, "timestamp": "04:43:53", "text": "おお。"}, {"type": "subtitle", "time": 17035.39, "timestamp": "04:43:55", "text": "バイバイ。私はとても"}, {"type": "subtitle", "time": 17037.55, "timestamp": "04:43:57", "text": "疲れた。私はとても"}]
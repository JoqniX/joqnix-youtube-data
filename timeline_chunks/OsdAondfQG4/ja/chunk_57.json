[{"type": "subtitle", "time": 3427.15, "timestamp": "00:57:07", "text": "お元気でお過ごしでしょうか。どうでしたか？"}, {"type": "subtitle", "time": 3429.39, "timestamp": "00:57:09", "text": "日？"}, {"type": "subtitle", "time": 3433.03, "timestamp": "00:57:13", "text": "待って、なぜ？待って、私のPCはこうなった"}, {"type": "subtitle", "time": 3438.309, "timestamp": "00:57:18", "text": "めちゃくちゃ軽い。ああ、それは車だ。"}, {"type": "subtitle", "time": 3441.349, "timestamp": "00:57:21", "text": "完全に承知しています。"}, {"type": "subtitle", "time": 3443.829, "timestamp": "00:57:23", "text": "あ、実はミュートを解除するのを忘れてた。あなた"}, {"type": "subtitle", "time": 3447.19, "timestamp": "00:57:27", "text": "何だと思う？心配しないで。来週から"}, {"type": "subtitle", "time": 3449.75, "timestamp": "00:57:29", "text": "これから先は、フットペダルを使います。私はただ"}, {"type": "subtitle", "time": 3452.789, "timestamp": "00:57:32", "text": "話すにはフットペダルを踏む必要があります"}, {"type": "subtitle", "time": 3455.99, "timestamp": "00:57:35", "text": "Discordやゲームなどについていいね！"}, {"type": "subtitle", "time": 3464.63, "timestamp": "00:57:44", "text": "アサはこれを可愛くするべきだ。"}, {"type": "subtitle", "time": 3469.27, "timestamp": "00:57:49", "text": "ああ、プレイボックス。とてもかわいい。アバター。"}, {"type": "subtitle", "time": 3472.309, "timestamp": "00:57:52", "text": "うん。こんにちは。"}, {"type": "subtitle", "time": 3477.19, "timestamp": "00:57:57", "text": "それは、建物を建てるには難しそうに思える。"}]
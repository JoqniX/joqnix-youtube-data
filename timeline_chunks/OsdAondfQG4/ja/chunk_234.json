[{"type": "subtitle", "time": 14040.51, "timestamp": "03:54:00", "text": "気にしないで、ちょっと邪魔しちゃって"}, {"type": "subtitle", "time": 14049.03, "timestamp": "03:54:09", "text": "でも、彼らは私のことを知らないと思う。"}, {"type": "subtitle", "time": 14051.87, "timestamp": "03:54:11", "text": "じゃあ靴紐を結ぼう"}, {"type": "subtitle", "time": 14054.91, "timestamp": "03:54:14", "text": "方法。誰かが生きているとは思わない"}, {"type": "subtitle", "time": 14057.55, "timestamp": "03:54:17", "text": "ここ。これを結んでください"}, {"type": "subtitle", "time": 14065.95, "timestamp": "03:54:25", "text": "自体。ほどけたくない"}, {"type": "subtitle", "time": 14068.59, "timestamp": "03:54:28", "text": "それ。私は"}, {"type": "subtitle", "time": 14074.95, "timestamp": "03:54:34", "text": "なぜ？あのね？私は結ぶ"}, {"type": "subtitle", "time": 14083.83, "timestamp": "03:54:43", "text": "私が寄りかかって置こうとするたびに"}]
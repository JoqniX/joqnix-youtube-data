[{"type": "subtitle", "time": 3361.67, "timestamp": "00:56:01", "text": "おお。"}, {"type": "subtitle", "time": 3365.07, "timestamp": "00:56:05", "text": "彼はロシア人だと思っていた。"}, {"type": "subtitle", "time": 3367.589, "timestamp": "00:56:07", "text": "[音楽]"}, {"type": "subtitle", "time": 3370.28, "timestamp": "00:56:10", "text": "彼はロシア人だ。"}, {"type": "subtitle", "time": 3383.03, "timestamp": "00:56:23", "text": "ミュートするのを忘れていました。ごめんなさい。ああ、くそ。おお"}, {"type": "subtitle", "time": 3386.19, "timestamp": "00:56:26", "text": "我が神よ。忘れてしまった"}, {"type": "subtitle", "time": 3387.95, "timestamp": "00:56:27", "text": "[音楽]"}, {"type": "subtitle", "time": 3391.19, "timestamp": "00:56:31", "text": "チャット。私はチャットで誰かを歓迎していました"}, {"type": "subtitle", "time": 3395.51, "timestamp": "00:56:35", "text": "挨拶に来たのは誰だったのか。"}, {"type": "subtitle", "time": 3399.349, "timestamp": "00:56:39", "text": "大丈夫。大丈夫だった。大丈夫。"}, {"type": "subtitle", "time": 3402.71, "timestamp": "00:56:42", "text": "ええ、そうですね。そうしたのですか？大丈夫。しないで"}, {"type": "subtitle", "time": 3406.789, "timestamp": "00:56:46", "text": "シャイ。恥ずかしがらないで。大丈夫。大丈夫。"}, {"type": "subtitle", "time": 3409.75, "timestamp": "00:56:49", "text": "こんにちは。はい。"}, {"type": "subtitle", "time": 3413.27, "timestamp": "00:56:53", "text": "こんにちは。うん。こんにちは。"}, {"type": "subtitle", "time": 3418.069, "timestamp": "00:56:58", "text": "元気ですか？こんにちは。元気です。"}]
[{"type": "subtitle", "time": 5041.11, "timestamp": "01:24:01", "text": "ソナも好きだけど、"}, {"type": "subtitle", "time": 5044.31, "timestamp": "01:24:04", "text": "「うん、チームとしてはね」と思った。サコナじゃなかったっけ？"}, {"type": "subtitle", "time": 5046.149, "timestamp": "01:24:06", "text": "別のサポートになるはずだった？うん、"}, {"type": "subtitle", "time": 5048.47, "timestamp": "01:24:08", "text": "サポート。うん。"}, {"type": "subtitle", "time": 5050.229, "timestamp": "01:24:10", "text": "おお、"}, {"type": "subtitle", "time": 5052.55, "timestamp": "01:24:12", "text": "彼女が音楽を担当しているのがいいですね"}, {"type": "subtitle", "time": 5059.83, "timestamp": "01:24:19", "text": "だから私は「わあ、これはすごくクールだ」と思ったんです。"}, {"type": "subtitle", "time": 5067.59, "timestamp": "01:24:27", "text": "あのドラゴンの少女はとても良い。どうやら、"}, {"type": "subtitle", "time": 5071.59, "timestamp": "01:24:31", "text": "アニメーション。ああ、彼女がすごく欲しい。"}, {"type": "subtitle", "time": 5074.149, "timestamp": "01:24:34", "text": "彼女は私の次の担当ユニットです。私の次のユニットは"}, {"type": "subtitle", "time": 5076.47, "timestamp": "01:24:36", "text": "彼女になるだろう。彼女がいつ"}, {"type": "subtitle", "time": 5078.79, "timestamp": "01:24:38", "text": "バナーは。もうそうなったのですか？私はそうしなかった"}, {"type": "subtitle", "time": 5081.83, "timestamp": "01:24:41", "text": "たぶん3週間くらいプレイしてないかな。"}, {"type": "subtitle", "time": 5085.51, "timestamp": "01:24:45", "text": "次のバナーだと思う。"}, {"type": "subtitle", "time": 5088.229, "timestamp": "01:24:48", "text": "次のバナー。何てことだ。ああ、私は"}, {"type": "subtitle", "time": 5092.629, "timestamp": "01:24:52", "text": "保存中。よくわからないけど。私はしていません"}, {"type": "subtitle", "time": 5095.51, "timestamp": "01:24:55", "text": "しばらくぶりにプレイしたよ。あ、待って。えっと、私は"}, {"type": "subtitle", "time": 5097.83, "timestamp": "01:24:57", "text": "イベントをまだ終えていません。サイコロ"}]
[{"type": "subtitle", "time": 1335.99, "timestamp": "00:22:15", "text": "ああ、ご存知の通り、私は普段は"}, {"type": "subtitle", "time": 1345.95, "timestamp": "00:22:25", "text": "トイレです。トイレ。はぁ？"}, {"type": "subtitle", "time": 1357.83, "timestamp": "00:22:37", "text": "おお。どういう意味ですか？ Rokuはそうあるべきだ。"}, {"type": "subtitle", "time": 1363.47, "timestamp": "00:22:43", "text": "漏洩したのか？ああ、"}, {"type": "subtitle", "time": 1367.029, "timestamp": "00:22:47", "text": "神。時間の流れについては、私にはわかりません。"}, {"type": "subtitle", "time": 1378.39, "timestamp": "00:22:58", "text": "場合によります。"}]
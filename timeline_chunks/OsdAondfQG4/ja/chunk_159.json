[{"type": "subtitle", "time": 9541.67, "timestamp": "02:39:01", "text": "1時間半前。 1時間と"}, {"type": "subtitle", "time": 9543.309, "timestamp": "02:39:03", "text": "半分。うん。うん。"}, {"type": "subtitle", "time": 9546.71, "timestamp": "02:39:06", "text": "うん。うん。午後2時か3時頃だった。あなたのために、"}, {"type": "subtitle", "time": 9548.309, "timestamp": "02:39:08", "text": "右？"}, {"type": "subtitle", "time": 9552.23, "timestamp": "02:39:12", "text": "うん。くそ。つまり、私は通常、"}, {"type": "subtitle", "time": 9554.309, "timestamp": "02:39:14", "text": "今回は時々。"}, {"type": "subtitle", "time": 9556.71, "timestamp": "02:39:16", "text": "たまたまそうなったんだけど、"}, {"type": "subtitle", "time": 9560.23, "timestamp": "02:39:20", "text": "今日は仕事がある。ええ、そうですね。ラッキー。"}, {"type": "subtitle", "time": 9563.11, "timestamp": "02:39:23", "text": "マスカールさん、今日はありがとうございました。そうだった"}, {"type": "subtitle", "time": 9565.03, "timestamp": "02:39:25", "text": "あなたと再会できて本当に楽しかったです。"}, {"type": "subtitle", "time": 9566.87, "timestamp": "02:39:26", "text": "話す。"}, {"type": "subtitle", "time": 9568.469, "timestamp": "02:39:28", "text": "そうだったのか？わからない。私はただ"}, {"type": "subtitle", "time": 9570.63, "timestamp": "02:39:30", "text": "私がとりとめもなく話したのを、あなたはただ聞いていた。いいえ、いいえ、"}, {"type": "subtitle", "time": 9573.19, "timestamp": "02:39:33", "text": "いや、いや、いや。大丈夫です。私は時々"}, {"type": "subtitle", "time": 9575.59, "timestamp": "02:39:35", "text": "アクティブリスニングモードを有効にする"}, {"type": "subtitle", "time": 9578.79, "timestamp": "02:39:38", "text": "何らかの理由で、もっとおしゃべりにならないようにする。"}, {"type": "subtitle", "time": 9581.11, "timestamp": "02:39:41", "text": "だから、私は"}, {"type": "subtitle", "time": 9583.67, "timestamp": "02:39:43", "text": "もう一方は、それを理解していると言っています"}, {"type": "subtitle", "time": 9586.71, "timestamp": "02:39:46", "text": "明らかにそういう瞬間だ。ええ、それは私です。"}, {"type": "subtitle", "time": 9588.389, "timestamp": "02:39:48", "text": "私も悪いところがあると思う"}, {"type": "subtitle", "time": 9591.03, "timestamp": "02:39:51", "text": "なぜなら私はとりとめのない話モードに入ってしまい、"}, {"type": "subtitle", "time": 9593.67, "timestamp": "02:39:53", "text": "反論の余地を与えなかった。なんてこった、"}, {"type": "subtitle", "time": 9597.19, "timestamp": "02:39:57", "text": "大丈夫です。大丈夫です。私はそれを楽しんでいます。"}]
[{"type": "subtitle", "time": 11823.63, "timestamp": "03:17:03", "text": "私は手に入れます"}, {"type": "subtitle", "time": 11826.71, "timestamp": "03:17:06", "text": "みんな、また連絡を取りたい"}, {"type": "subtitle", "time": 11828.19, "timestamp": "03:17:08", "text": "と"}, {"type": "subtitle", "time": 11830.63, "timestamp": "03:17:10", "text": "少なくとも交流した人々は"}, {"type": "subtitle", "time": 11833.99, "timestamp": "03:17:13", "text": "時間をかけて十分に絆を深める方法"}, {"type": "subtitle", "time": 11835.75, "timestamp": "03:17:15", "text": "彼らと過ごす時間が増え、"}, {"type": "subtitle", "time": 11839.229, "timestamp": "03:17:19", "text": "良い友達だったことを今でも覚えている"}, {"type": "subtitle", "time": 11841.83, "timestamp": "03:17:21", "text": "たとえ彼らと話さなくても"}, {"type": "subtitle", "time": 11849.95, "timestamp": "03:17:29", "text": "それは少なくとも私が"}, {"type": "subtitle", "time": 11852.87, "timestamp": "03:17:32", "text": "気にかけていた。今でも心の中で彼らを覚えています"}]
[{"type": "subtitle", "time": 4504.27, "timestamp": "01:15:04", "text": "Minecraftのサバイバルモジュール式サーバー。"}, {"type": "subtitle", "time": 4506.99, "timestamp": "01:15:06", "text": "ああ、調子はどうですか？"}, {"type": "subtitle", "time": 4510.95, "timestamp": "01:15:10", "text": "うん。ああ、それはうまくいっているね。これまでのところ"}, {"type": "subtitle", "time": 4514.31, "timestamp": "01:15:14", "text": "私は5個くらい作りました。えっと"}, {"type": "subtitle", "time": 4516.11, "timestamp": "01:15:16", "text": "それぞれ約"}, {"type": "subtitle", "time": 4519.27, "timestamp": "01:15:19", "text": "一年経ちましたが、私は多くのことを学びました。"}, {"type": "subtitle", "time": 4522.59, "timestamp": "01:15:22", "text": "それらを作ることによって"}, {"type": "subtitle", "time": 4525.75, "timestamp": "01:15:25", "text": "例えば、良いゲームを作る方法とか。方法"}, {"type": "subtitle", "time": 4527.59, "timestamp": "01:15:27", "text": "人々を楽しませるにはどうすればいいですか？作り方"}, {"type": "subtitle", "time": 4531.11, "timestamp": "01:15:31", "text": "人々にとって難しい？そんな感じのことです。"}, {"type": "subtitle", "time": 4532.709, "timestamp": "01:15:32", "text": "[音楽]"}, {"type": "subtitle", "time": 4535.75, "timestamp": "01:15:35", "text": "カスタムコードのようなものを追加しましたか？"}, {"type": "subtitle", "time": 4538.95, "timestamp": "01:15:38", "text": "エスケープキーを押すと、"}, {"type": "subtitle", "time": 4542.149, "timestamp": "01:15:42", "text": "Escキーを押すとSMPの名前が表示されます"}, {"type": "subtitle", "time": 4544.87, "timestamp": "01:15:44", "text": "そして、そういうカスタムカスタム"}, {"type": "subtitle", "time": 4546.63, "timestamp": "01:15:46", "text": "テーマ性のある？"}, {"type": "subtitle", "time": 4551.59, "timestamp": "01:15:51", "text": "ええと、前回のSMPに参加しました。ああ、"}, {"type": "subtitle", "time": 4555.189, "timestamp": "01:15:55", "text": "選手の中には素晴らしい選手もいた"}, {"type": "subtitle", "time": 4557.99, "timestamp": "01:15:57", "text": "SMPに興奮していたので、カスタムを作った"}]
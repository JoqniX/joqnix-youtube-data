[{"type": "subtitle", "time": 5944.709, "timestamp": "01:39:04", "text": "うん。わからない。調べてみます"}, {"type": "subtitle", "time": 5946.43, "timestamp": "01:39:06", "text": "自分自身"}, {"type": "subtitle", "time": 5949.59, "timestamp": "01:39:09", "text": "なぜならナイトレインは誰かが私に言ったから"}, {"type": "subtitle", "time": 5951.27, "timestamp": "01:39:11", "text": "それはバトルレールだった、俺はこう思った、俺は"}, {"type": "subtitle", "time": 5953.669, "timestamp": "01:39:13", "text": "それはやりたくない。もしそれが"}, {"type": "subtitle", "time": 5956.31, "timestamp": "01:39:16", "text": "戦闘シーンの映像なら、まあいいや。確認してみます"}, {"type": "subtitle", "time": 5958.55, "timestamp": "01:39:18", "text": "それ。"}, {"type": "subtitle", "time": 5960.87, "timestamp": "01:39:20", "text": "想像してみて、彼らは刷新するつもりだと思う"}, {"type": "subtitle", "time": 5965.43, "timestamp": "01:39:25", "text": "魂の魂、ええと、ジャンルのエルダーリング"}, {"type": "subtitle", "time": 5968.629, "timestamp": "01:39:28", "text": "これら全てを追加するということですよね？"}, {"type": "subtitle", "time": 5970.229, "timestamp": "01:39:30", "text": "うん、"}, {"type": "subtitle", "time": 5973.35, "timestamp": "01:39:33", "text": "それはいいですね。別のソウルゲームを作る"}, {"type": "subtitle", "time": 5975.35, "timestamp": "01:39:35", "text": "実際のもののようにではなく"}, {"type": "subtitle", "time": 5979.39, "timestamp": "01:39:39", "text": "ソウルゲームではなく、名前を変えた"}, {"type": "subtitle", "time": 5983.03, "timestamp": "01:39:43", "text": "毎回ボスがより強力になるように、見た目だけを変えて登場する。"}, {"type": "subtitle", "time": 5985.83, "timestamp": "01:39:45", "text": "うん。"}, {"type": "subtitle", "time": 5986.95, "timestamp": "01:39:46", "text": "正直に言うと、あのゲームは"}, {"type": "subtitle", "time": 5990.229, "timestamp": "01:39:50", "text": "楽しいです。しかし"}, {"type": "subtitle", "time": 5993.189, "timestamp": "01:39:53", "text": "うん、本当に楽しいよ。"}, {"type": "subtitle", "time": 5995.91, "timestamp": "01:39:55", "text": "伝承。伝承。私は"}, {"type": "subtitle", "time": 5999.189, "timestamp": "01:39:59", "text": "神々を殺せる普通の男。ああ、"}]
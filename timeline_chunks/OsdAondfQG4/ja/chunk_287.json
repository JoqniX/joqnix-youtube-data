[{"type": "subtitle", "time": 17220.43, "timestamp": "04:47:00", "text": "少しだけ"}, {"type": "subtitle", "time": 17223.868, "timestamp": "04:47:03", "text": "えっと、じゃあどんな感じ？"}, {"type": "subtitle", "time": 17226.43, "timestamp": "04:47:06", "text": "えっと、それから"}, {"type": "subtitle", "time": 17229.67, "timestamp": "04:47:09", "text": "自転車みたいなやつ、自転車じゃなくてスクーター"}, {"type": "subtitle", "time": 17232.23, "timestamp": "04:47:12", "text": "何かだけど、うん、そのうちの1つは"}, {"type": "subtitle", "time": 17235.788, "timestamp": "04:47:15", "text": "電動スクーターを見て、うわあ、これは"}, {"type": "subtitle", "time": 17239.27, "timestamp": "04:47:19", "text": "クールだと思う、これが私の"}, {"type": "subtitle", "time": 17242.19, "timestamp": "04:47:22", "text": "ラインウォークはビーチです"}, {"type": "subtitle", "time": 17245.788, "timestamp": "04:47:25", "text": "そこにリゾートを建設する。これがその道だ。"}, {"type": "subtitle", "time": 17249.31, "timestamp": "04:47:29", "text": "ガッチャ。待って、これは本当に"}, {"type": "subtitle", "time": 17251.91, "timestamp": "04:47:31", "text": "方法？わからない。そう思います。私はしません"}, {"type": "subtitle", "time": 17255.19, "timestamp": "04:47:35", "text": "知る。ええ、大きな「いいえ」があります。ええ、私は"}, {"type": "subtitle", "time": 17257.75, "timestamp": "04:47:37", "text": "これがそれだと思う。こんにちは。これは"}, {"type": "subtitle", "time": 17261.23, "timestamp": "04:47:41", "text": "1つかな。お願い、そうじゃないことを願います"}, {"type": "subtitle", "time": 17263.51, "timestamp": "04:47:43", "text": "間違っている。ええ、現在私たちは戻っています"}, {"type": "subtitle", "time": 17265.43, "timestamp": "04:47:45", "text": "家路を歩いている。"}, {"type": "subtitle", "time": 17267.27, "timestamp": "04:47:47", "text": "家に帰ったら配信を終了します"}, {"type": "subtitle", "time": 17270.23, "timestamp": "04:47:50", "text": "あるいは、そんな感じ。終わってほしくなかった"}, {"type": "subtitle", "time": 17272.91, "timestamp": "04:47:52", "text": "流れ続けるが、そのまま続ける。しかし"}, {"type": "subtitle", "time": 17277.11, "timestamp": "04:47:57", "text": "また、本当に疲れ果てています"}, {"type": "subtitle", "time": 17278.27, "timestamp": "04:47:58", "text": "朝"}]
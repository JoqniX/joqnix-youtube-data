[{"type": "subtitle", "time": 6002.07, "timestamp": "01:40:02", "text": "神。"}, {"type": "subtitle", "time": 6004.47, "timestamp": "01:40:04", "text": "私のSMPもそんな感じだった。ああ、"}, {"type": "subtitle", "time": 6008.31, "timestamp": "01:40:08", "text": "神。私たちは皆、死ぬほど"}, {"type": "subtitle", "time": 6010.47, "timestamp": "01:40:10", "text": "基本的なゾンビだけ、そして私たちが"}, {"type": "subtitle", "time": 6012.149, "timestamp": "01:40:12", "text": "私たちの最初の武器は、戦うことができる"}, {"type": "subtitle", "time": 6014.47, "timestamp": "01:40:14", "text": "彼らを戻して、レベル4のゾンビ"}, {"type": "subtitle", "time": 6015.99, "timestamp": "01:40:15", "text": "どこからともなく現れて、私たちを殺すだろう。"}, {"type": "subtitle", "time": 6018.87, "timestamp": "01:40:18", "text": "なんてこった、"}, {"type": "subtitle", "time": 6022.95, "timestamp": "01:40:22", "text": "楽しかった。嘘はつきません。しかし"}, {"type": "subtitle", "time": 6024.709, "timestamp": "01:40:24", "text": "自画自賛しているだけです。私がその人です"}, {"type": "subtitle", "time": 6026.87, "timestamp": "01:40:26", "text": "SMP を作った、その mod を作った"}, {"type": "subtitle", "time": 6029.27, "timestamp": "01:40:29", "text": "パック。"}, {"type": "subtitle", "time": 6032.07, "timestamp": "01:40:32", "text": "ああ、特注品のことですね。"}, {"type": "subtitle", "time": 6034.87, "timestamp": "01:40:34", "text": "うん。くそ。"}, {"type": "subtitle", "time": 6036.79, "timestamp": "01:40:36", "text": "つまり、あなたはコーディングが得意で、"}, {"type": "subtitle", "time": 6039.189, "timestamp": "01:40:39", "text": "もの。"}, {"type": "subtitle", "time": 6040.55, "timestamp": "01:40:40", "text": "うん。高校時代は、"}, {"type": "subtitle", "time": 6042.91, "timestamp": "01:40:42", "text": "それをよく勉強しなさい。"}, {"type": "subtitle", "time": 6046.27, "timestamp": "01:40:46", "text": "ああ、それはいいですね。本当に？"}, {"type": "subtitle", "time": 6051.51, "timestamp": "01:40:51", "text": "うん。それは、えっと、私がやった"}, {"type": "subtitle", "time": 6054.07, "timestamp": "01:40:54", "text": "そのための授業をいくつか受けてください。"}, {"type": "subtitle", "time": 6055.99, "timestamp": "01:40:55", "text": "でも、私にはわからない。見つけることができませんでした"}, {"type": "subtitle", "time": 6058.229, "timestamp": "01:40:58", "text": "続けるためのモチベーション。つまり、それは"}, {"type": "subtitle", "time": 6059.27, "timestamp": "01:40:59", "text": "やる気が出なかったわけじゃない"}]
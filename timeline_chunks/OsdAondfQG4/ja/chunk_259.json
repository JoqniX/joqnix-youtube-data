[{"type": "subtitle", "time": 15541.75, "timestamp": "04:19:01", "text": "熱い。私は自分の"}, {"type": "subtitle", "time": 15553.83, "timestamp": "04:19:13", "text": "では、今日の目標は何ですか？"}, {"type": "subtitle", "time": 15556.55, "timestamp": "04:19:16", "text": "ストリーム？えっと、これをお見せしましょう。の"}, {"type": "subtitle", "time": 15557.79, "timestamp": "04:19:17", "text": "もの"}, {"type": "subtitle", "time": 15561.309, "timestamp": "04:19:21", "text": "私たちは現在向かっている"}, {"type": "subtitle", "time": 15564.269, "timestamp": "04:19:24", "text": "戻る。私たちは現在戻っています"}, {"type": "subtitle", "time": 15566.469, "timestamp": "04:19:26", "text": "それを何と呼ぶのですか？あなたは何を"}, {"type": "subtitle", "time": 15569.63, "timestamp": "04:19:29", "text": "言う？ええ、私たちは現在向かっています"}, {"type": "subtitle", "time": 15572.389, "timestamp": "04:19:32", "text": "戻る。待って、私、財布持って行ってないわ。おお"}, {"type": "subtitle", "time": 15574.59, "timestamp": "04:19:34", "text": "我が神よ。本当に？"}, {"type": "subtitle", "time": 15577.55, "timestamp": "04:19:37", "text": "体育会系？ああ、大変だ、"}, {"type": "subtitle", "time": 15579.95, "timestamp": "04:19:39", "text": "財布。冗談ですか"}, {"type": "subtitle", "time": 15583.83, "timestamp": "04:19:43", "text": "自分？財布を持っていくべきだった。私はどうですか"}, {"type": "subtitle", "time": 15587.51, "timestamp": "04:19:47", "text": "水を買いに行くの？待って、あのね？"}, {"type": "subtitle", "time": 15588.99, "timestamp": "04:19:48", "text": "戻るだけ"}, {"type": "subtitle", "time": 15590.59, "timestamp": "04:19:50", "text": "家。"}, {"type": "subtitle", "time": 15593.67, "timestamp": "04:19:53", "text": "痛み。家に帰ります。それから私たちは"}]
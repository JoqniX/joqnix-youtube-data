[{"type": "subtitle", "time": 8521.51, "timestamp": "02:22:01", "text": "ストリームを見ると、彼らはこう言うだろう。"}, {"type": "subtitle", "time": 8523.51, "timestamp": "02:22:03", "text": "「ああ、この人は、"}, {"type": "subtitle", "time": 8526.389, "timestamp": "02:22:06", "text": "冗談でやっているんだ、だから"}, {"type": "subtitle", "time": 8529.91, "timestamp": "02:22:09", "text": "そして、50日、60日、70日といった具合に。」しかし"}, {"type": "subtitle", "time": 8531.99, "timestamp": "02:22:11", "text": "それに、彼らはオーバーレイも見ているんですよね？のように"}, {"type": "subtitle", "time": 8535.51, "timestamp": "02:22:15", "text": "51と呼ばれる1人用のやつ。うん。それで"}, {"type": "subtitle", "time": 8537.99, "timestamp": "02:22:17", "text": "彼らは「ああ、君もやってるのか」と言うだろう"}, {"type": "subtitle", "time": 8539.67, "timestamp": "02:22:19", "text": "これだけの日数で、あなたは"}, {"type": "subtitle", "time": 8542.55, "timestamp": "02:22:22", "text": "彼らが想定しているように何かを手に入れたら"}, {"type": "subtitle", "time": 8543.389, "timestamp": "02:22:23", "text": "のように"}, {"type": "subtitle", "time": 8546.309, "timestamp": "02:22:26", "text": "それと、そうじゃないと思う"}, {"type": "subtitle", "time": 8548.309, "timestamp": "02:22:28", "text": "運動とかして、それから彼らは"}, {"type": "subtitle", "time": 8550.23, "timestamp": "02:22:30", "text": "なぜ私があなたとコラボする必要があるの？"}, {"type": "subtitle", "time": 8554.11, "timestamp": "02:22:34", "text": "これのメリットは、"}, {"type": "subtitle", "time": 8558.23, "timestamp": "02:22:38", "text": "うわー、彼らは超批評をしたんだね、私は"}, {"type": "subtitle", "time": 8562.75, "timestamp": "02:22:42", "text": "私は完全に降りなければならなかった"}, {"type": "subtitle", "time": 8565.67, "timestamp": "02:22:45", "text": "彼らがこう言ったからそうしたんだと説明"}, {"type": "subtitle", "time": 8569.349, "timestamp": "02:22:49", "text": "ずっと昔に知り合った人"}, {"type": "subtitle", "time": 8572.23, "timestamp": "02:22:52", "text": "うまく接続できていないので"}, {"type": "subtitle", "time": 8575.309, "timestamp": "02:22:55", "text": "私は自分の"}, {"type": "subtitle", "time": 8578.63, "timestamp": "02:22:58", "text": "この状況とこれが起こった"}]
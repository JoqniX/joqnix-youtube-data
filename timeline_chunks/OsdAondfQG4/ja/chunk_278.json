[{"type": "subtitle", "time": 16680.39, "timestamp": "04:38:00", "text": "それ。あなたの声は本当にクリアで、"}, {"type": "subtitle", "time": 16682.109, "timestamp": "04:38:02", "text": "方法。"}, {"type": "subtitle", "time": 16686.07, "timestamp": "04:38:06", "text": "こんにちは、待ってください。では、それは、と比較して悪いのでしょうか？"}, {"type": "subtitle", "time": 16688.949, "timestamp": "04:38:08", "text": "Twitterと比較して良いか悪いか"}, {"type": "subtitle", "time": 16690.75, "timestamp": "04:38:10", "text": "スペース？"}, {"type": "subtitle", "time": 16693.59, "timestamp": "04:38:13", "text": "ナナ、Twitterの空間はどうだった？どのような感じでしたか？"}, {"type": "subtitle", "time": 16695.551, "timestamp": "04:38:15", "text": "これか、あるいは"}, {"type": "subtitle", "time": 16699.269, "timestamp": "04:38:19", "text": "悪い？それを聞きたかった"}, {"type": "subtitle", "time": 16700.949, "timestamp": "04:38:20", "text": "えーっと、配信の冒頭で"}, {"type": "subtitle", "time": 16703.75, "timestamp": "04:38:23", "text": "もっとハッシュやニンジャか"}, {"type": "subtitle", "time": 16706.629, "timestamp": "04:38:26", "text": "ブラッドはここにいた、そこにいた人、あるいは"}, {"type": "subtitle", "time": 16709.15, "timestamp": "04:38:29", "text": "ツイッターでその場にいたベーコン"}, {"type": "subtitle", "time": 16711.99, "timestamp": "04:38:31", "text": "比較して知ることができるスペース"}, {"type": "subtitle", "time": 16716.31, "timestamp": "04:38:36", "text": "Twitterスペースの音声はどれくらいひどかったか"}, {"type": "subtitle", "time": 16718.629, "timestamp": "04:38:38", "text": "YouTubeの配信と比較して。その"}, {"type": "subtitle", "time": 16721.429, "timestamp": "04:38:41", "text": "宇宙波よりも明瞭だ。何？それから私は"}, {"type": "subtitle", "time": 16724.51, "timestamp": "04:38:44", "text": "それなら、えっと、なんて言うんだっけ、"}, {"type": "subtitle", "time": 16727.029, "timestamp": "04:38:47", "text": "それ？それならYouTubeみたいなことをしようかな"}, {"type": "subtitle", "time": 16735.99, "timestamp": "04:38:55", "text": "だから、ある意味では、"}, {"type": "subtitle", "time": 16739.189, "timestamp": "04:38:59", "text": "自信がついた。私は自分の"}]
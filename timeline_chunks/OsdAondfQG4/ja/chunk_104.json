[{"type": "subtitle", "time": 6241.51, "timestamp": "01:44:01", "text": "「うん、友達に挨拶するのが好きだよ"}, {"type": "subtitle", "time": 6242.669, "timestamp": "01:44:02", "text": "毎"}, {"type": "subtitle", "time": 6244.87, "timestamp": "01:44:04", "text": "「年」そして数人が"}, {"type": "subtitle", "time": 6247.07, "timestamp": "01:44:07", "text": "投稿には「うん、その通り。100％」みたいな感じ"}, {"type": "subtitle", "time": 6249.03, "timestamp": "01:44:09", "text": "「本当だよ。」そして、私が知らない人もいる。"}, {"type": "subtitle", "time": 6252.03, "timestamp": "01:44:12", "text": "まだ今年に挨拶していない。その"}, {"type": "subtitle", "time": 6254.55, "timestamp": "01:44:14", "text": "クレイジー。 「おっと。ごめんね、みんな。」"}, {"type": "subtitle", "time": 6257.43, "timestamp": "01:44:17", "text": "後で挨拶するよ。"}, {"type": "subtitle", "time": 6259.75, "timestamp": "01:44:19", "text": "[音楽]"}, {"type": "subtitle", "time": 6261.43, "timestamp": "01:44:21", "text": "私ができた人はたった一人だけです"}, {"type": "subtitle", "time": 6264.95, "timestamp": "01:44:24", "text": "月に少なくとも一度は挨拶をし、"}, {"type": "subtitle", "time": 6269.189, "timestamp": "01:44:29", "text": "それは、ある日彼らが"}, {"type": "subtitle", "time": 6271.669, "timestamp": "01:44:31", "text": "えーと言われたんだけど、「挨拶すらしないのに"}, {"type": "subtitle", "time": 6274.79, "timestamp": "01:44:34", "text": "「私。」そして私はちょっと意地悪なので、今はこう言います"}, {"type": "subtitle", "time": 6283.43, "timestamp": "01:44:43", "text": "うん。わからない。それはただ"}, {"type": "subtitle", "time": 6287.27, "timestamp": "01:44:47", "text": "人との連絡を維持するのは難しい。"}, {"type": "subtitle", "time": 6292.629, "timestamp": "01:44:52", "text": "ええ、私の意見では。そうですね、私にとっては、"}, {"type": "subtitle", "time": 6295.83, "timestamp": "01:44:55", "text": "それは本当です。つまり、私も同じです。"}, {"type": "subtitle", "time": 6298.95, "timestamp": "01:44:58", "text": "そして、人々と再び繋がることができた私を見てください。"}]
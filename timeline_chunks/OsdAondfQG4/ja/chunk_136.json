[{"type": "subtitle", "time": 8161.99, "timestamp": "02:16:01", "text": "それに、あなたも咳をしている。だから、私は"}, {"type": "subtitle", "time": 8165.75, "timestamp": "02:16:05", "text": "君にたくさん話させるべきだと思う。"}, {"type": "subtitle", "time": 8167.43, "timestamp": "02:16:07", "text": "大丈夫です。私はよく話すことに慣れています。"}, {"type": "subtitle", "time": 8170.85, "timestamp": "02:16:10", "text": "それは私の仕事の一部です。"}, {"type": "subtitle", "time": 8186.47, "timestamp": "02:16:26", "text": "あなたはこのことについてどう思いますか？えっと、"}, {"type": "subtitle", "time": 8188.87, "timestamp": "02:16:28", "text": "あなたはこれまで人から批判されていると感じたことがありますか？"}, {"type": "subtitle", "time": 8190.35, "timestamp": "02:16:30", "text": "あなたの"}, {"type": "subtitle", "time": 8192.709, "timestamp": "02:16:32", "text": "数字？数が足りません、"}, {"type": "subtitle", "time": 8196.669, "timestamp": "02:16:36", "text": "人々はあなたと意見が合わないような感じ"}, {"type": "subtitle", "time": 8199.429, "timestamp": "02:16:39", "text": "もの。悪い経験はありますか？"}, {"type": "subtitle", "time": 8205.309, "timestamp": "02:16:45", "text": "[音楽]"}, {"type": "subtitle", "time": 8209.99, "timestamp": "02:16:49", "text": "だって私はTwitterで知り合いか、"}, {"type": "subtitle", "time": 8212.469, "timestamp": "02:16:52", "text": "X たぶん X の人たちは私の数字を見て、"}, {"type": "subtitle", "time": 8213.629, "timestamp": "02:16:53", "text": "彼らは"}, {"type": "subtitle", "time": 8216.389, "timestamp": "02:16:56", "text": "「ああ、あなたは少なくとも1000人です。あなたは"}, {"type": "subtitle", "time": 8219.03, "timestamp": "02:16:59", "text": "「わかった。」そして彼らは私の"}]
[{"type": "subtitle", "time": 3901.67, "timestamp": "01:05:01", "text": "電話してください。こんにちは。"}, {"type": "subtitle", "time": 3905.67, "timestamp": "01:05:05", "text": "こんにちは。こんにちは、マスカール。本当に久しぶりだ。"}, {"type": "subtitle", "time": 3907.99, "timestamp": "01:05:07", "text": "元気ですか？"}, {"type": "subtitle", "time": 3909.91, "timestamp": "01:05:09", "text": "私は大丈夫です。"}, {"type": "subtitle", "time": 3912.549, "timestamp": "01:05:12", "text": "元気かい？君がいなくて寂しかったよ"}, {"type": "subtitle", "time": 3917.109, "timestamp": "01:05:17", "text": "調子はどうですか？すべて順調ですか？"}, {"type": "subtitle", "time": 3919.589, "timestamp": "01:05:19", "text": "良かったよ。"}, {"type": "subtitle", "time": 3923.109, "timestamp": "01:05:23", "text": "同じ。私は、ええと、すごくストレスが溜まっているんだけど、"}, {"type": "subtitle", "time": 3933.829, "timestamp": "01:05:33", "text": "生存者。えっと、待って、私たちは、私たちは"}, {"type": "subtitle", "time": 3935.589, "timestamp": "01:05:35", "text": "ゲームか何かを選んでみて？私 私"}, {"type": "subtitle", "time": 3938.549, "timestamp": "01:05:38", "text": "すっかり忘れていた。"}, {"type": "subtitle", "time": 3942.47, "timestamp": "01:05:42", "text": "ああ、私たちは"}, {"type": "subtitle", "time": 3944.309, "timestamp": "01:05:44", "text": "話す、話す、それとも話したいですか？"}, {"type": "subtitle", "time": 3946.789, "timestamp": "01:05:46", "text": "追いつくか、ゲームをするか"}, {"type": "subtitle", "time": 3950.63, "timestamp": "01:05:50", "text": "話している最中とか？"}, {"type": "subtitle", "time": 3951.67, "timestamp": "01:05:51", "text": "わからない。私は本当に"}, {"type": "subtitle", "time": 3952.87, "timestamp": "01:05:52", "text": "ストリームなので、何をすればいいのかよくわかりません"}, {"type": "subtitle", "time": 3958.23, "timestamp": "01:05:58", "text": "あなたは何を計画していますか？"}]
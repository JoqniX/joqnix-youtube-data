[{"type": "subtitle", "time": 2880.55, "timestamp": "00:48:00", "text": "寒いか"}, {"type": "subtitle", "time": 2883.03, "timestamp": "00:48:03", "text": "ええ、そうです。"}, {"type": "subtitle", "time": 2884.03, "timestamp": "00:48:04", "text": "しかし"}, {"type": "subtitle", "time": 2886.63, "timestamp": "00:48:06", "text": "普段どのように過ごしていますか"}, {"type": "subtitle", "time": 2890.23, "timestamp": "00:48:10", "text": "週末？ゴム缶。つまりゴムとは"}, {"type": "subtitle", "time": 2891.79, "timestamp": "00:48:11", "text": "あなたが知っていることは、"}, {"type": "subtitle", "time": 2897.95, "timestamp": "00:48:17", "text": "[音楽]"}, {"type": "subtitle", "time": 2901.67, "timestamp": "00:48:21", "text": "私がうっかり彼女に心を奪われてしまう時代。おお"}, {"type": "subtitle", "time": 2908.23, "timestamp": "00:48:28", "text": "えっと、あなたは本を読んだり、マンガが好きだったりするんですか？"}, {"type": "subtitle", "time": 2910.87, "timestamp": "00:48:30", "text": "それともウェブ上の何か？"}, {"type": "subtitle", "time": 2913.75, "timestamp": "00:48:33", "text": "あなたはそういうのが好きなの？"}, {"type": "subtitle", "time": 2930.589, "timestamp": "00:48:50", "text": "新作チェーンソーマン トップ"}, {"type": "subtitle", "time": 2935.43, "timestamp": "00:48:55", "text": "山、えっと、英語でどう言うの？私"}, {"type": "subtitle", "time": 2938.549, "timestamp": "00:48:58", "text": "わからない。"}]
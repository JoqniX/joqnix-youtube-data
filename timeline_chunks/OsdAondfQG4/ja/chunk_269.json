[{"type": "subtitle", "time": 16140.389, "timestamp": "04:29:00", "text": "ココナッツ。それは、ほら、"}, {"type": "subtitle", "time": 16143.91, "timestamp": "04:29:03", "text": "待って、あれは人？え、何？待って、"}, {"type": "subtitle", "time": 16146.309, "timestamp": "04:29:06", "text": "いや、それは違う、いや、それは人間ではない。その"}, {"type": "subtitle", "time": 16149.99, "timestamp": "04:29:09", "text": "黒いボールや点が1つあるように"}, {"type": "subtitle", "time": 16152.95, "timestamp": "04:29:12", "text": "座席。まるで3つの点があるみたい"}, {"type": "subtitle", "time": 16156.55, "timestamp": "04:29:16", "text": "あるいは、そんな感じ。待って、あれは人？いいえ。"}, {"type": "subtitle", "time": 16158.149, "timestamp": "04:29:18", "text": "いや、それはありえない。それは、あ、待って。"}, {"type": "subtitle", "time": 16161.03, "timestamp": "04:29:21", "text": "それは何て言うんだっけ"}, {"type": "subtitle", "time": 16164.55, "timestamp": "04:29:24", "text": "それ？まるで"}, {"type": "subtitle", "time": 16168.07, "timestamp": "04:29:28", "text": "えっと、あれは漁網だと思います。ええ、私は"}, {"type": "subtitle", "time": 16170.469, "timestamp": "04:29:30", "text": "あれは漁網だと思う。私はしません"}, {"type": "subtitle", "time": 16172.55, "timestamp": "04:29:32", "text": "それは、えーと、あの、あの、あの物だと思う"}, {"type": "subtitle", "time": 16175.269, "timestamp": "04:29:35", "text": "海のどこに人々が"}, {"type": "subtitle", "time": 16179.229, "timestamp": "04:29:39", "text": "なんて言うんだっけ、ボ・ザ・ビーみたいな"}, {"type": "subtitle", "time": 16181.79, "timestamp": "04:29:41", "text": "何かのようなもの"}, {"type": "subtitle", "time": 16185.75, "timestamp": "04:29:45", "text": "えっと、何だったか忘れちゃったけど、"}, {"type": "subtitle", "time": 16186.67, "timestamp": "04:29:46", "text": "呼ばれる"}, {"type": "subtitle", "time": 16190.07, "timestamp": "04:29:50", "text": "これも船などのためです"}, {"type": "subtitle", "time": 16193.51, "timestamp": "04:29:53", "text": "道を知っていて、船を見るのが好きなもの"}, {"type": "subtitle", "time": 16196.269, "timestamp": "04:29:56", "text": "それは貨物ですか"}, {"type": "subtitle", "time": 16199.309, "timestamp": "04:29:59", "text": "本当に遠く離れた船"}]
[{"type": "subtitle", "time": 6062.629, "timestamp": "01:41:02", "text": "続けるために。私はすべてを学んだので"}, {"type": "subtitle", "time": 6064.629, "timestamp": "01:41:04", "text": "高校でこのことを学んだとき、"}, {"type": "subtitle", "time": 6067.709, "timestamp": "01:41:07", "text": "大学で学んだことは全て知っていた。それで、"}, {"type": "subtitle", "time": 6072.55, "timestamp": "01:41:12", "text": "興味を失ったとは言いませんが、"}, {"type": "subtitle", "time": 6074.669, "timestamp": "01:41:14", "text": "それはまるで教えるようなものだ"}, {"type": "subtitle", "time": 6077.35, "timestamp": "01:41:17", "text": "15歳の子が英語を話す方法"}, {"type": "subtitle", "time": 6085.43, "timestamp": "01:41:25", "text": "ああ、なんとなくそんな感じがする。うん。"}, {"type": "subtitle", "time": 6095.59, "timestamp": "01:41:35", "text": "いや、いや、いや。では、ストリーミングはどうだったのでしょうか？"}, {"type": "subtitle", "time": 6098.07, "timestamp": "01:41:38", "text": "最近？"}, {"type": "subtitle", "time": 6100.47, "timestamp": "01:41:40", "text": "私は視聴者の皆さんが大好きです。彼らはとても親切です"}, {"type": "subtitle", "time": 6102.43, "timestamp": "01:41:42", "text": "自分。"}, {"type": "subtitle", "time": 6106.229, "timestamp": "01:41:46", "text": "はい、私のコミュニティは"}, {"type": "subtitle", "time": 6109.35, "timestamp": "01:41:49", "text": "何年も前から、ただの人がふらっと立ち寄るだけ"}, {"type": "subtitle", "time": 6111.189, "timestamp": "01:41:51", "text": "そして時々ちょっと変わった感じになる"}, {"type": "subtitle", "time": 6117.03, "timestamp": "01:41:57", "text": "そして今私は"}]
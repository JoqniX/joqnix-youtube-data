[{"type": "subtitle", "time": 1445.029, "timestamp": "00:24:05", "text": "ああ、ジョーは大丈夫だと思うよ。"}, {"type": "subtitle", "time": 1448.31, "timestamp": "00:24:08", "text": "では、あなたのことを何と呼べばいいでしょうか？"}, {"type": "subtitle", "time": 1451.75, "timestamp": "00:24:11", "text": "タン。あなたのことをタンと呼んだ方がいいですか？タノ。わかった、"}, {"type": "subtitle", "time": 1454.59, "timestamp": "00:24:14", "text": "君のことはタノと呼ぶよ。その"}, {"type": "subtitle", "time": 1459.11, "timestamp": "00:24:19", "text": "わかった。うん。うん。つまり、えっと"}, {"type": "subtitle", "time": 1462.789, "timestamp": "00:24:22", "text": "私が必要とする人、あるいは彼が行かなければならない人"}, {"type": "subtitle", "time": 1473.51, "timestamp": "00:24:33", "text": "今、私は行動を起こしたのでしょうか？何てことだ。いいえ。"}, {"type": "subtitle", "time": 1476.149, "timestamp": "00:24:36", "text": "もっと話したいと言いたい。もし彼女が"}, {"type": "subtitle", "time": 1481.669, "timestamp": "00:24:41", "text": "一人で登る時は、ズボンを履いていくよ。"}, {"type": "chat", "time": 1484.407, "timestamp": "00:24:44", "author": "@N_I_R_NASHAK", "avatar": "https://yt4.ggpht.com/1tUEQ85FwbdYgcMSwBtAKUjwpzN8k-JYCUeDTQQXUvSFn0hVEvGSW0HPICJMtxNg5tVEcjZ-cOc=s64-c-k-c0x00ffffff-no-rj", "message": "hiii joqq"}, {"type": "subtitle", "time": 1484.87, "timestamp": "00:24:44", "text": "そう、ズボンを履いて。おお。えっと、それは何ですか"}, {"type": "subtitle", "time": 1492.39, "timestamp": "00:24:52", "text": "どう言えばいいのかわからないけど"}, {"type": "chat", "time": 1492.447, "timestamp": "00:24:52", "author": "@N_I_R_NASHAK", "avatar": "https://yt4.ggpht.com/1tUEQ85FwbdYgcMSwBtAKUjwpzN8k-JYCUeDTQQXUvSFn0hVEvGSW0HPICJMtxNg5tVEcjZ-cOc=s64-c-k-c0x00ffffff-no-rj", "message": "how ya doin mann"}, {"type": "subtitle", "time": 1495.11, "timestamp": "00:24:55", "text": "英語。"}, {"type": "subtitle", "time": 1497.95, "timestamp": "00:24:57", "text": "日本語で言ってもいいですよ。"}]
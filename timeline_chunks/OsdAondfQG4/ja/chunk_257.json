[{"type": "subtitle", "time": 15422.07, "timestamp": "04:17:02", "text": "写真を撮ってTwitterに投稿した"}, {"type": "subtitle", "time": 15432.07, "timestamp": "04:17:12", "text": "楽しい。ちょっと驚いたんだけど"}, {"type": "subtitle", "time": 15435.91, "timestamp": "04:17:15", "text": "モバイルデータ。いいえ、携帯電話のようなものです"}, {"type": "subtitle", "time": 15440.469, "timestamp": "04:17:20", "text": "携帯電話の信号に関するもの。えっと、それで私の"}, {"type": "subtitle", "time": 15443.59, "timestamp": "04:17:23", "text": "インターネットはダウンしないが、"}, {"type": "subtitle", "time": 15448.07, "timestamp": "04:17:28", "text": "安定した。ご存知だと思いますが、"}, {"type": "subtitle", "time": 15454.71, "timestamp": "04:17:34", "text": "わかった。私は投稿したと思いますが、"}, {"type": "subtitle", "time": 15458.55, "timestamp": "04:17:38", "text": "あらゆる場所でストリーミング配信中。そうだったと思います。"}, {"type": "subtitle", "time": 15460.75, "timestamp": "04:17:40", "text": "Twitter、Discord、えーと、"}, {"type": "subtitle", "time": 15463.349, "timestamp": "04:17:43", "text": "Facebookであって、Tumblrではない。 Twitter、Discord、"}, {"type": "subtitle", "time": 15466.67, "timestamp": "04:17:46", "text": "Facebook、それで何？って感じですよね？"}, {"type": "subtitle", "time": 15469.83, "timestamp": "04:17:49", "text": "うん。それはおもちゃの銃ですか？それは水です"}, {"type": "subtitle", "time": 15473.429, "timestamp": "04:17:53", "text": "銃。何だって？水鉄砲を見つけたが、"}, {"type": "subtitle", "time": 15478.79, "timestamp": "04:17:58", "text": "何か"}]
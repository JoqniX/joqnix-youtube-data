[{"type": "subtitle", "time": 6782.55, "timestamp": "01:53:02", "text": "5080は3倍の性能を持つ。"}, {"type": "subtitle", "time": 6786.629, "timestamp": "01:53:06", "text": "一体どういうことだ？何てことだ。"}, {"type": "subtitle", "time": 6794.709, "timestamp": "01:53:14", "text": "次に彼らがすべきことは"}, {"type": "subtitle", "time": 6797.83, "timestamp": "01:53:17", "text": "ノートパソコンをアップグレードしてください。熱が必要です"}, {"type": "subtitle", "time": 6799.79, "timestamp": "01:53:19", "text": "交換可能なノートパソコン"}, {"type": "subtitle", "time": 6802.87, "timestamp": "01:53:22", "text": "ただし、CPUやRAMなどといった類のことです。"}, {"type": "subtitle", "time": 6805.91, "timestamp": "01:53:25", "text": "うん、すでにカスタム品を手に入れたよ"}, {"type": "subtitle", "time": 6809.83, "timestamp": "01:53:29", "text": "キーボード。彼らはそれを「慣習」と呼ぶ。ただ"}, {"type": "subtitle", "time": 6812.55, "timestamp": "01:53:32", "text": "レゴみたいに。"}, {"type": "subtitle", "time": 6814.669, "timestamp": "01:53:34", "text": "ええ、彼らはレゴキットを作っています"}, {"type": "subtitle", "time": 6817.27, "timestamp": "01:53:37", "text": "キーボードと人々はそれを購入している"}, {"type": "subtitle", "time": 6820.79, "timestamp": "01:53:40", "text": "そして、私はそれが大好きです。私は彼らを非難しているのではなく、"}, {"type": "subtitle", "time": 6826.39, "timestamp": "01:53:46", "text": "自分だけのカスタムキーボードを作りたい。"}, {"type": "chat", "time": 6827.011, "timestamp": "01:53:47", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "Maybe get a legion, it's not as expensive as ROG but good price to performance ratio"}, {"type": "subtitle", "time": 6828.47, "timestamp": "01:53:48", "text": "「作る」と言っても、既に組み立て済みです。私"}, {"type": "subtitle", "time": 6837.589, "timestamp": "01:53:57", "text": "[音楽]"}]
[{"type": "subtitle", "time": 1082.23, "timestamp": "00:18:02", "text": "それは広東語ですか？そう思います。私はしません"}, {"type": "subtitle", "time": 1094.83, "timestamp": "00:18:14", "text": "誰でも飲める一般的な飲み物"}, {"type": "subtitle", "time": 1109.27, "timestamp": "00:18:29", "text": "何てことだ。彼の中国語は本当に上手だ。私"}, {"type": "subtitle", "time": 1111.19, "timestamp": "00:18:31", "text": "中国人が言いたい"}, {"type": "subtitle", "time": 1113.669, "timestamp": "00:18:33", "text": "彼にとっての日本語のバージョンですが、私は"}, {"type": "subtitle", "time": 1115.19, "timestamp": "00:18:35", "text": "知る。"}, {"type": "subtitle", "time": 1119.51, "timestamp": "00:18:39", "text": "でも面白いよね。面白い。"}, {"type": "subtitle", "time": 1121.83, "timestamp": "00:18:41", "text": "はい。"}, {"type": "subtitle", "time": 1125.35, "timestamp": "00:18:45", "text": "よくわからない。クレイジー。何てことだ。"}, {"type": "subtitle", "time": 1133.11, "timestamp": "00:18:53", "text": "君は学ぶことができる。学ぶことができます"}, {"type": "subtitle", "time": 1136.15, "timestamp": "00:18:56", "text": "学びたい。私は話すことができます"}]
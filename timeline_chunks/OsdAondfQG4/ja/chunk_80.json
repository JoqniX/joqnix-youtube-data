[{"type": "subtitle", "time": 4800.39, "timestamp": "01:20:00", "text": "けれど。新しい新しいシーズン。いや"}, {"type": "subtitle", "time": 4802.149, "timestamp": "01:20:02", "text": "向こう側の土地が戻ってきたようだ。"}, {"type": "subtitle", "time": 4812.229, "timestamp": "01:20:12", "text": "Destiny 1をプレイしましたか？運命の1？いいえ。"}, {"type": "subtitle", "time": 4814.07, "timestamp": "01:20:14", "text": "No Land Beyondは、"}, {"type": "subtitle", "time": 4815.91, "timestamp": "01:20:15", "text": "範囲。"}, {"type": "subtitle", "time": 4818.39, "timestamp": "01:20:18", "text": "向こうに陸地はない。"}, {"type": "subtitle", "time": 4820.07, "timestamp": "01:20:20", "text": "ええ、スコープのないスナイパーライフルですね。それで"}, {"type": "subtitle", "time": 4822.229, "timestamp": "01:20:22", "text": "それはまるで"}, {"type": "subtitle", "time": 4824.87, "timestamp": "01:20:24", "text": "えっと、OPですね。そういうことなんです。"}, {"type": "subtitle", "time": 4827.75, "timestamp": "01:20:27", "text": "ああ、Destiny 2か。なるほど。わかった。"}, {"type": "subtitle", "time": 4833.23, "timestamp": "01:20:33", "text": "おお。"}, {"type": "subtitle", "time": 4836.709, "timestamp": "01:20:36", "text": "[音楽]"}, {"type": "subtitle", "time": 4841.31, "timestamp": "01:20:41", "text": "ああ、同じ銃だったんだ。"}, {"type": "subtitle", "time": 4857.79, "timestamp": "01:20:57", "text": "うん、またDestiny 2をプレイするかもしれないね"}]
[{"type": "subtitle", "time": 15180.229, "timestamp": "04:13:00", "text": "文字通り"}, {"type": "subtitle", "time": 15183.11, "timestamp": "04:13:03", "text": "どこにでもお店があって、"}, {"type": "subtitle", "time": 15187.11, "timestamp": "04:13:07", "text": "お店の種類とか、場所とか"}, {"type": "subtitle", "time": 15189.75, "timestamp": "04:13:09", "text": "たくさんの物。しかし、あなたが都市部にいる場合"}, {"type": "subtitle", "time": 15192.95, "timestamp": "04:13:12", "text": "ええと、もしあなたが田舎にいるなら、"}, {"type": "subtitle", "time": 15196.03, "timestamp": "04:13:16", "text": "町のエリアに行ってこれらを見つける"}, {"type": "subtitle", "time": 15199.99, "timestamp": "04:13:19", "text": "店は、そうではないと言うだろう"}, {"type": "subtitle", "time": 15201.99, "timestamp": "04:13:21", "text": "簡単に見つけられる。でも、尋ねなければならない"}, {"type": "subtitle", "time": 15204.79, "timestamp": "04:13:24", "text": "その周り。大工さんや"}, {"type": "subtitle", "time": 15207.63, "timestamp": "04:13:27", "text": "誰か何か、あなたは探しに行かなければならない"}, {"type": "subtitle", "time": 15211.11, "timestamp": "04:13:31", "text": "多く。徹底的に調べて、たくさんの人に聞いてみよう"}, {"type": "subtitle", "time": 15214.229, "timestamp": "04:13:34", "text": "それから人を探す。たくさんのもの"}, {"type": "subtitle", "time": 15219.429, "timestamp": "04:13:39", "text": "そんな感じ。ええ、もちろんです。もちろん。あなた"}, {"type": "subtitle", "time": 15222.389, "timestamp": "04:13:42", "text": "もう一度聞きたいなら、聞いてみて。うん。"}, {"type": "subtitle", "time": 15224.79, "timestamp": "04:13:44", "text": "こんにちは、Dさん。お元気でお過ごしでしょうか。そして"}, {"type": "subtitle", "time": 15226.429, "timestamp": "04:13:46", "text": "また、彼らは"}, {"type": "subtitle", "time": 15229.03, "timestamp": "04:13:49", "text": "現在、ああ神様、それは大きな"}, {"type": "subtitle", "time": 15231.149, "timestamp": "04:13:51", "text": "波。ああ、なんてことだ"}, {"type": "subtitle", "time": 15233.51, "timestamp": "04:13:53", "text": "現在私はウォーキングをしているか、"}, {"type": "subtitle", "time": 15236.469, "timestamp": "04:13:56", "text": "朝の散歩は文字通り"}, {"type": "subtitle", "time": 15237.95, "timestamp": "04:13:57", "text": "の横に"}]
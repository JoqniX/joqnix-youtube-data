[{"type": "subtitle", "time": 2041.669, "timestamp": "00:34:01", "text": "怖がった。"}, {"type": "subtitle", "time": 2044.149, "timestamp": "00:34:04", "text": "人と戦うことはめったにない"}, {"type": "subtitle", "time": 2049.829, "timestamp": "00:34:09", "text": "インド。ええ、それは珍しいですね。このゲームをプレイしてください。"}, {"type": "subtitle", "time": 2063.19, "timestamp": "00:34:23", "text": "他の男たち。インド製かもしれない。おお、"}, {"type": "subtitle", "time": 2066.869, "timestamp": "00:34:26", "text": "ニース。ニース。うん。うん。"}, {"type": "subtitle", "time": 2069.03, "timestamp": "00:34:29", "text": "お見せする必要があります。"}, {"type": "subtitle", "time": 2072.95, "timestamp": "00:34:32", "text": "でも、そうですね、それから、視聴者の皆さんは"}, {"type": "subtitle", "time": 2074.95, "timestamp": "00:34:34", "text": "見ていると、彼らはあなたが持っていると言いました"}, {"type": "subtitle", "time": 2084.23, "timestamp": "00:34:44", "text": "うん、君は"}, {"type": "subtitle", "time": 2086.31, "timestamp": "00:34:46", "text": "ええ、彼らはあなたが良い"}, {"type": "subtitle", "time": 2095.589, "timestamp": "00:34:55", "text": "うん。原神のジョン・リーのように深い"}]
[{"type": "subtitle", "time": 6906.87, "timestamp": "01:55:06", "text": "私は柔らかい方が好きだと思う。"}, {"type": "subtitle", "time": 6909.55, "timestamp": "01:55:09", "text": "私も。つまり、場合によるということですね。私は"}, {"type": "subtitle", "time": 6912.629, "timestamp": "01:55:12", "text": "柔らかいけれど、少し触感がある。 A"}, {"type": "subtitle", "time": 6917.03, "timestamp": "01:55:17", "text": "触覚がほとんどない。ええ、ちょっと触覚的な感じですね。"}, {"type": "subtitle", "time": 6918.87, "timestamp": "01:55:18", "text": "なぜそれが私の"}, {"type": "subtitle", "time": 6920.87, "timestamp": "01:55:20", "text": "ボタン。なぜなら今私のキーボードは"}, {"type": "subtitle", "time": 6922.75, "timestamp": "01:55:22", "text": "ただ"}, {"type": "subtitle", "time": 6925.91, "timestamp": "01:55:25", "text": "滑らかなチェリースイッチ。"}, {"type": "subtitle", "time": 6933.27, "timestamp": "01:55:33", "text": "うん。わからない。私はしたい 私はしたい"}, {"type": "subtitle", "time": 6934.189, "timestamp": "01:55:34", "text": "得る"}, {"type": "subtitle", "time": 6936.03, "timestamp": "01:55:36", "text": "違う"}, {"type": "subtitle", "time": 6943.99, "timestamp": "01:55:43", "text": "スイッチ。うん。行こうと思った"}, {"type": "subtitle", "time": 6946.229, "timestamp": "01:55:46", "text": "素晴らしいスイッチか何かに。私"}, {"type": "subtitle", "time": 6947.75, "timestamp": "01:55:47", "text": "素晴らしいキーボードを持っていた。こぼしてしまった"}, {"type": "subtitle", "time": 6949.91, "timestamp": "01:55:49", "text": "コーヒーが全体にかかっている。それは最低限のもので、"}, {"type": "subtitle", "time": 6957.189, "timestamp": "01:55:57", "text": "シンプルだったから気に入った"}]
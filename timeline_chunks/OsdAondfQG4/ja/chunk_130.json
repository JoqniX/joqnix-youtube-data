[{"type": "subtitle", "time": 7801.03, "timestamp": "02:10:01", "text": "Xでストリーミングしたいのは、"}, {"type": "subtitle", "time": 7804.39, "timestamp": "02:10:04", "text": "プレミアムなものをDMで送るだけ。JP"}, {"type": "subtitle", "time": 7808.069, "timestamp": "02:10:08", "text": "塊茎。プレミアを取り戻さなければならなかった"}, {"type": "subtitle", "time": 7810.79, "timestamp": "02:10:10", "text": "それは悪い結果となった。そうではなかった"}, {"type": "subtitle", "time": 7814.069, "timestamp": "02:10:14", "text": "いい結果。彼らは今も返答していない"}, {"type": "subtitle", "time": 7817.109, "timestamp": "02:10:17", "text": "そして私は「うわあ、こんなにたくさん使ってるなんて」と思う"}, {"type": "subtitle", "time": 7824.31, "timestamp": "02:10:24", "text": "うん。ええ、そうです。でも少なくとも私は"}, {"type": "subtitle", "time": 7826.35, "timestamp": "02:10:26", "text": "たくさんのタイプのように"}, {"type": "subtitle", "time": 7830.03, "timestamp": "02:10:30", "text": "段落、ツイート段落。うん。"}, {"type": "subtitle", "time": 7833.99, "timestamp": "02:10:33", "text": "うん。制限はどのように増加するのか"}, {"type": "subtitle", "time": 7837.669, "timestamp": "02:10:37", "text": "投稿には何文字まで書けるの？ H"}, {"type": "subtitle", "time": 7839.229, "timestamp": "02:10:39", "text": "購入を検討しました"}, {"type": "subtitle", "time": 7844.83, "timestamp": "02:10:44", "text": "Xのようなプレミアムとはどういうものか。考えてみたんだけど、"}, {"type": "subtitle", "time": 7847.189, "timestamp": "02:10:47", "text": "でも、本当に"}, {"type": "subtitle", "time": 7849.99, "timestamp": "02:10:49", "text": "私がそうするべき理由。つまり、基本的な"}, {"type": "subtitle", "time": 7853.27, "timestamp": "02:10:53", "text": "どちらか一方の方が、例えばあなたがただ"}, {"type": "subtitle", "time": 7856.39, "timestamp": "02:10:56", "text": "もっと長いツイートとか書いてみようよ。ただ"}, {"type": "subtitle", "time": 7858.55, "timestamp": "02:10:58", "text": "彼らにはその選択肢があるということだ。いいえ、"}]
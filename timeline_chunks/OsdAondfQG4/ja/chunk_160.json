[{"type": "subtitle", "time": 9600.389, "timestamp": "02:40:00", "text": "とりとめのない話でも構いません。私たちはただのんびりしているだけです。"}, {"type": "subtitle", "time": 9603.03, "timestamp": "02:40:03", "text": "うん、のんびりしてるよ。私たちはいつでも"}, {"type": "subtitle", "time": 9605.11, "timestamp": "02:40:05", "text": "コラボレーション開始。私たちは協力関係にありません。"}, {"type": "subtitle", "time": 9607.03, "timestamp": "02:40:07", "text": "ただ一緒に時間を過ごしているだけです。私たちはぶら下がっています"}, {"type": "subtitle", "time": 9608.87, "timestamp": "02:40:08", "text": "外。将来は、"}, {"type": "subtitle", "time": 9611.51, "timestamp": "02:40:11", "text": "外。ただのたまり場だよ。ええ、それは"}, {"type": "subtitle", "time": 9613.91, "timestamp": "02:40:13", "text": "遊ぶ。"}, {"type": "subtitle", "time": 9615.75, "timestamp": "02:40:15", "text": "うん。うん。とにかく、ありがとうございました。"}, {"type": "subtitle", "time": 9619.03, "timestamp": "02:40:19", "text": "自分。本日はありがとうございました。素晴らしい一日を"}, {"type": "subtitle", "time": 9621.99, "timestamp": "02:40:21", "text": "これから夜になります。わかった。頑張ってください"}, {"type": "subtitle", "time": 9623.91, "timestamp": "02:40:23", "text": "映画『エイミー』。"}, {"type": "subtitle", "time": 9626.55, "timestamp": "02:40:26", "text": "うまくいけばいいな"}, {"type": "subtitle", "time": 9628.87, "timestamp": "02:40:28", "text": "すべて解決しました。 Destinyをプレイしよう"}, {"type": "subtitle", "time": 9632.389, "timestamp": "02:40:32", "text": "あるいは、それらを組み合わせたもの。"}, {"type": "subtitle", "time": 9634.71, "timestamp": "02:40:34", "text": "こんにちは。"}, {"type": "subtitle", "time": 9642.75, "timestamp": "02:40:42", "text": "バイバイ。皆さん、マスクでした。"}, {"type": "subtitle", "time": 9647.309, "timestamp": "02:40:47", "text": "継続マスコンとのひとときを楽しんでいただけたなら幸いです。"}, {"type": "subtitle", "time": 9650.95, "timestamp": "02:40:50", "text": "今日。私たちはとてもリラックスしていた。いいえ。そして"}, {"type": "subtitle", "time": 9653.429, "timestamp": "02:40:53", "text": "もしあなたが持っているなら、もしあなたが持っているなら、もしあなたが持っているなら、"}, {"type": "subtitle", "time": 9657.23, "timestamp": "02:40:57", "text": "TwitchでMasoneをフォローしてください。"}]
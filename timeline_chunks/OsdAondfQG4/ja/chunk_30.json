[{"type": "subtitle", "time": 1810.909, "timestamp": "00:30:10", "text": "あれは彼の友達か何か？おお"}, {"type": "subtitle", "time": 1831.95, "timestamp": "00:30:31", "text": "[音楽]"}, {"type": "subtitle", "time": 1835.029, "timestamp": "00:30:35", "text": "タイ。タイ。タイ。タイ。"}, {"type": "subtitle", "time": 1841.31, "timestamp": "00:30:41", "text": "ガッチャ。私は"}, {"type": "subtitle", "time": 1844.23, "timestamp": "00:30:44", "text": "私はここに長い間います。それで、"}, {"type": "subtitle", "time": 1847.11, "timestamp": "00:30:47", "text": "そうそう。ここはタイです。やり方を忘れて"}, {"type": "subtitle", "time": 1850.23, "timestamp": "00:30:50", "text": "友人に外国人と話すように勧めた。私の"}, {"type": "subtitle", "time": 1853.19, "timestamp": "00:30:53", "text": "友人。ああ、それはあなたの友達です。うん。"}, {"type": "subtitle", "time": 1856.95, "timestamp": "00:30:56", "text": "こんにちは。インドではない。私は間違いなく"}]
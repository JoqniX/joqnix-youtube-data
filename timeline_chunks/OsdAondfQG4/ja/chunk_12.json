[{"type": "subtitle", "time": 721.269, "timestamp": "00:12:01", "text": "私のアバター、すごく可愛いでしょ？はい。"}, {"type": "subtitle", "time": 723.99, "timestamp": "00:12:03", "text": "あなたのアクセント、すごく可愛いですね。あなたのアクセントは"}, {"type": "subtitle", "time": 742.23, "timestamp": "00:12:22", "text": "私は字が読めません。よし。残念ながら、私は"}, {"type": "subtitle", "time": 747.949, "timestamp": "00:12:27", "text": "[音楽]"}, {"type": "subtitle", "time": 752.15, "timestamp": "00:12:32", "text": "話す。しかし、まだ読み込み中です。"}, {"type": "subtitle", "time": 753.829, "timestamp": "00:12:33", "text": "えっと、"}, {"type": "subtitle", "time": 757.43, "timestamp": "00:12:37", "text": "よくわからない。よくわからないのですが"}, {"type": "subtitle", "time": 759.99, "timestamp": "00:12:39", "text": "さて、今日はどんな一日でしたか？おお。えっと、待って。どうやって"}, {"type": "subtitle", "time": 762.71, "timestamp": "00:12:42", "text": "それは日本語で言うのですか？忘れた。"}, {"type": "subtitle", "time": 768.31, "timestamp": "00:12:48", "text": "待って、今日はどんな一日だったかってどう言うの？"}, {"type": "subtitle", "time": 775.23, "timestamp": "00:12:55", "text": "私は思う"}, {"type": "subtitle", "time": 779.19, "timestamp": "00:12:59", "text": "それで。学びたいなら"}]
[{"type": "subtitle", "time": 3007.03, "timestamp": "00:50:07", "text": "なるほど！という反応。えっと、ジョークを言って、"}, {"type": "subtitle", "time": 3010.069, "timestamp": "00:50:10", "text": "突っつく状況、彼女は大丈夫そうだ、了解。"}, {"type": "subtitle", "time": 3013.19, "timestamp": "00:50:13", "text": "ありがとう、家族も知ってるよ"}, {"type": "subtitle", "time": 3021.67, "timestamp": "00:50:21", "text": "見ているよ"}, {"type": "subtitle", "time": 3034.71, "timestamp": "00:50:34", "text": "私はワイフが好きです"}, {"type": "subtitle", "time": 3037.54, "timestamp": "00:50:37", "text": "ああ、白。ええ、私は"}, {"type": "subtitle", "time": 3039.71, "timestamp": "00:50:39", "text": "[音楽]"}, {"type": "subtitle", "time": 3043.15, "timestamp": "00:50:43", "text": "ヨルのように。"}, {"type": "subtitle", "time": 3048.069, "timestamp": "00:50:48", "text": "うん。はい。うん。好きだよ、好きだから。ああ、"}, {"type": "subtitle", "time": 3049.589, "timestamp": "00:50:49", "text": "うん。うん。動画によるアップデートがありました。"}, {"type": "subtitle", "time": 3053.43, "timestamp": "00:50:53", "text": "はい。更新しました。うん。うん。"}, {"type": "subtitle", "time": 3055.67, "timestamp": "00:50:55", "text": "好きじゃない。楽しかったの？私"}]
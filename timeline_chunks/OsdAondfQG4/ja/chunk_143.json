[{"type": "subtitle", "time": 8581.67, "timestamp": "02:23:01", "text": "私がこれをしている理由と、"}, {"type": "subtitle", "time": 8585.63, "timestamp": "02:23:05", "text": "インドでコフィが一人でやっていること"}, {"type": "subtitle", "time": 8589.11, "timestamp": "02:23:09", "text": "悲しい仕事でストライプが機能しない"}, {"type": "subtitle", "time": 8591.349, "timestamp": "02:23:11", "text": "適切に、そのため複雑な問題があります"}, {"type": "subtitle", "time": 8594.63, "timestamp": "02:23:14", "text": "StripeとPayPalが正常に動作しない"}, {"type": "subtitle", "time": 8596.79, "timestamp": "02:23:16", "text": "そして私は自分の個人情報を晒したくない"}, {"type": "subtitle", "time": 8602.349, "timestamp": "02:23:22", "text": "UPI決済、そう、私はたくさん"}, {"type": "subtitle", "time": 8605.349, "timestamp": "02:23:25", "text": "私が頼らざるを得なかったプラットフォーム"}, {"type": "subtitle", "time": 8608.15, "timestamp": "02:23:28", "text": "YouTubeやTwitchなど、ありがたいことに"}, {"type": "subtitle", "time": 8611.309, "timestamp": "02:23:31", "text": "YouTube を手に入れました"}, {"type": "subtitle", "time": 8615.95, "timestamp": "02:23:35", "text": "会員資格とか、その他諸々。だから"}, {"type": "subtitle", "time": 8617.63, "timestamp": "02:23:37", "text": "それ。"}, {"type": "subtitle", "time": 8621.19, "timestamp": "02:23:41", "text": "そう、そんな感じ。だから私はこう思った"}, {"type": "subtitle", "time": 8624.309, "timestamp": "02:23:44", "text": "なんだか変な感じがした。え、なんで？"}, {"type": "subtitle", "time": 8626.87, "timestamp": "02:23:46", "text": "人々はそれを"}, {"type": "subtitle", "time": 8628.71, "timestamp": "02:23:48", "text": "超越的な方法。彼女が"}, {"type": "subtitle", "time": 8633.429, "timestamp": "02:23:53", "text": "その裏では退屈だったけど、そうだった"}, {"type": "subtitle", "time": 8636.469, "timestamp": "02:23:56", "text": "いいよ、私と一緒に遊んで"}, {"type": "subtitle", "time": 8639.03, "timestamp": "02:23:59", "text": "一緒にゲームとか色々やってるから"}]
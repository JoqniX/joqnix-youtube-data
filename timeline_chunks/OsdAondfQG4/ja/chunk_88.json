[{"type": "subtitle", "time": 5282.79, "timestamp": "01:28:02", "text": "ゲームは月間または週間で追加されます"}, {"type": "subtitle", "time": 5285.51, "timestamp": "01:28:05", "text": "コンテンツと、私は待つ気になれませんでした"}, {"type": "subtitle", "time": 5292.07, "timestamp": "01:28:12", "text": "ええ、でも『嵐が丘』のように、"}, {"type": "subtitle", "time": 5293.59, "timestamp": "01:28:13", "text": "私が始めた時点で既にそのコンテンツはありました"}, {"type": "subtitle", "time": 5295.43, "timestamp": "01:28:15", "text": "プレイしている。"}, {"type": "subtitle", "time": 5299.27, "timestamp": "01:28:19", "text": "わかった。わかった。まさにそんな感じ。うん。だから、もし"}, {"type": "subtitle", "time": 5300.709, "timestamp": "01:28:20", "text": "原人に戻るけど、"}, {"type": "subtitle", "time": 5301.83, "timestamp": "01:28:21", "text": "何が起こっているのか理解してください、なぜなら私の"}, {"type": "subtitle", "time": 5303.83, "timestamp": "01:28:23", "text": "アカウントはすでに進歩している"}, {"type": "subtitle", "time": 5308.35, "timestamp": "01:28:28", "text": "若干。私にとっても十分ではない"}, {"type": "subtitle", "time": 5312.31, "timestamp": "01:28:32", "text": "遊び続けたいと思わせる。わからない"}, {"type": "subtitle", "time": 5314.149, "timestamp": "01:28:34", "text": "それをどう説明すればいいのか。私は持っていません"}, {"type": "subtitle", "time": 5316.149, "timestamp": "01:28:36", "text": "知っている。私は進みすぎました"}, {"type": "subtitle", "time": 5317.75, "timestamp": "01:28:37", "text": "チュートリアルはもう私には役に立たないので、"}, {"type": "subtitle", "time": 5319.189, "timestamp": "01:28:39", "text": "別のアカウントを作成したくないのは、"}, {"type": "subtitle", "time": 5321.95, "timestamp": "01:28:41", "text": "私は十分に進歩したので"}, {"type": "subtitle", "time": 5324.31, "timestamp": "01:28:44", "text": "新しいアカウントは作成したくありません。"}, {"type": "subtitle", "time": 5327.83, "timestamp": "01:28:47", "text": "私の言っていることが分かるよね？ああ、そうだね。それは"}, {"type": "subtitle", "time": 5330.55, "timestamp": "01:28:50", "text": "カチカチという音がする？はい、カチッと音がしています。"}, {"type": "subtitle", "time": 5332.51, "timestamp": "01:28:52", "text": "うん。"}, {"type": "subtitle", "time": 5334.709, "timestamp": "01:28:54", "text": "わかった。なぜなら、カチッとハマらないから"}, {"type": "subtitle", "time": 5336.87, "timestamp": "01:28:56", "text": "私の頭。嘘はつきません。私はしません"}, {"type": "subtitle", "time": 5338.39, "timestamp": "01:28:58", "text": "私が今言ったことを一言も理解できない"}]
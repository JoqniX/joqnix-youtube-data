[{"type": "subtitle", "time": 2940.51, "timestamp": "00:49:00", "text": "ああ、私は私は"}, {"type": "subtitle", "time": 2950.47, "timestamp": "00:49:10", "text": "教えて。えーっと、私は"}, {"type": "subtitle", "time": 2952.27, "timestamp": "00:49:12", "text": "中国アニメ"}, {"type": "subtitle", "time": 2955.71, "timestamp": "00:49:15", "text": "えーっと、不滅の日常"}, {"type": "subtitle", "time": 2968.27, "timestamp": "00:49:28", "text": "[音楽]"}, {"type": "subtitle", "time": 2977.589, "timestamp": "00:49:37", "text": "これらの侵略者は去っていく。いいえ、私は"}, {"type": "subtitle", "time": 2981.589, "timestamp": "00:49:41", "text": "私は中国のアニメは見ません。"}, {"type": "subtitle", "time": 2993.549, "timestamp": "00:49:53", "text": "ああ、これはほとんど"}, {"type": "subtitle", "time": 2998.43, "timestamp": "00:49:58", "text": "3D。私は3Dアニメが好きではありません。"}]
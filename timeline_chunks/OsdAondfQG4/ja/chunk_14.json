[{"type": "subtitle", "time": 840.67, "timestamp": "00:14:00", "text": "日本語を勉強する世界"}, {"type": "subtitle", "time": 847.99, "timestamp": "00:14:07", "text": "待って、どうすればあの世界を救えるの？"}, {"type": "subtitle", "time": 850.949, "timestamp": "00:14:10", "text": "待って。"}, {"type": "subtitle", "time": 855.509, "timestamp": "00:14:15", "text": "みんな一緒に行きたいですか？おお、"}, {"type": "subtitle", "time": 857.829, "timestamp": "00:14:17", "text": "待って。それは去った。なんてこった。私はします"}, {"type": "subtitle", "time": 859.91, "timestamp": "00:14:19", "text": "推薦する"}, {"type": "subtitle", "time": 871.91, "timestamp": "00:14:31", "text": "これは日本との貿易戦争に関するものです。"}, {"type": "subtitle", "time": 876.31, "timestamp": "00:14:36", "text": "行きたいなら、"}, {"type": "subtitle", "time": 880.31, "timestamp": "00:14:40", "text": "うん。こんにちは。元気かい？参照。"}, {"type": "subtitle", "time": 888.509, "timestamp": "00:14:48", "text": "この"}, {"type": "subtitle", "time": 896.31, "timestamp": "00:14:56", "text": "ああ、これだ。これは見たことがあります。"}, {"type": "subtitle", "time": 899.15, "timestamp": "00:14:59", "text": "うん。うん。"}]
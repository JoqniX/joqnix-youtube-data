[{"type": "subtitle", "time": 1260.71, "timestamp": "00:21:00", "text": "普遍的に存在する。だから、オーディオは"}, {"type": "subtitle", "time": 1263.909, "timestamp": "00:21:03", "text": "ストリームで聞くと、同じになります"}, {"type": "subtitle", "time": 1266.149, "timestamp": "00:21:06", "text": "私のマイクから聞こえる音声は"}, {"type": "subtitle", "time": 1267.83, "timestamp": "00:21:07", "text": "これをストリーミングすれば、彼らにも同じことが起こります"}, {"type": "subtitle", "time": 1269.59, "timestamp": "00:21:09", "text": "同じように。"}, {"type": "subtitle", "time": 1275.029, "timestamp": "00:21:15", "text": "うん。マイクの照明が点灯しています。うん。うん。"}, {"type": "subtitle", "time": 1278.47, "timestamp": "00:21:18", "text": "うん。うん。それをミュートにしただけです。私"}, {"type": "subtitle", "time": 1280.149, "timestamp": "00:21:20", "text": "マイクをとても近くに持っていた"}, {"type": "subtitle", "time": 1282.87, "timestamp": "00:21:22", "text": "ヘッドホン。音声が漏れていた。"}, {"type": "subtitle", "time": 1287.75, "timestamp": "00:21:27", "text": "つまり、ヘッドホンをもう少し下げる必要があるということだ。"}, {"type": "subtitle", "time": 1290.549, "timestamp": "00:21:30", "text": "私は聞く必要があるとは決して思わない"}, {"type": "subtitle", "time": 1293.99, "timestamp": "00:21:33", "text": "あなたへ。何てことだ。そう、戻って"}, {"type": "subtitle", "time": 1303.35, "timestamp": "00:21:43", "text": "ああ、あなたは"}, {"type": "subtitle", "time": 1306.47, "timestamp": "00:21:46", "text": "とてもかわいい。ところで、あなたはいくつですか？"}, {"type": "subtitle", "time": 1310.23, "timestamp": "00:21:50", "text": "何か食べたいですか？血を飲みたいですか？"}, {"type": "subtitle", "time": 1312.07, "timestamp": "00:21:52", "text": "何てことだ。"}, {"type": "subtitle", "time": 1314.75, "timestamp": "00:21:54", "text": "とても若い"}, {"type": "subtitle", "time": 1316.51, "timestamp": "00:21:56", "text": "吸血鬼"}, {"type": "subtitle", "time": 1319.51, "timestamp": "00:21:59", "text": "その子は吸血鬼ではない。なぜ？なぜ子供なのか？"}]
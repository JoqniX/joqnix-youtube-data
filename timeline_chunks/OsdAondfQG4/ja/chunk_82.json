[{"type": "subtitle", "time": 4922.229, "timestamp": "01:22:02", "text": "最長で3日間です。"}, {"type": "subtitle", "time": 4926.39, "timestamp": "01:22:06", "text": "ああ、そうですね、キャラクターのように"}, {"type": "subtitle", "time": 4928.87, "timestamp": "01:22:08", "text": "ある意味、原神のようなもので、"}, {"type": "subtitle", "time": 4930.91, "timestamp": "01:22:10", "text": "他のキャラクターを入手してプレイできます"}, {"type": "subtitle", "time": 4934.47, "timestamp": "01:22:14", "text": "それらですが、Warframeでは構築する必要があります"}, {"type": "subtitle", "time": 4937.189, "timestamp": "01:22:17", "text": "キャラクターをレベルアップさせて使用する"}, {"type": "subtitle", "time": 4939.75, "timestamp": "01:22:19", "text": "能力とかそういうもの。"}, {"type": "subtitle", "time": 4942.189, "timestamp": "01:22:22", "text": "おお"}, {"type": "subtitle", "time": 4944.87, "timestamp": "01:22:24", "text": "うん。ああ、君が「嵐が丘」を演奏しているのを見たよ。"}, {"type": "subtitle", "time": 4947.91, "timestamp": "01:22:27", "text": "あまりにも。先月始めたばかりです。おお、"}, {"type": "subtitle", "time": 4950.39, "timestamp": "01:22:30", "text": "どうだった？旅はどうでしたか？私は好きです"}, {"type": "subtitle", "time": 4953.669, "timestamp": "01:22:33", "text": "それ。私はもう知らない。私は"}, {"type": "subtitle", "time": 4958.229, "timestamp": "01:22:38", "text": "レベル50に近い。うわあ。どうやって？ああ、"}, {"type": "subtitle", "time": 4961.75, "timestamp": "01:22:41", "text": "神。私はまだ苦戦しています。"}, {"type": "subtitle", "time": 4963.95, "timestamp": "01:22:43", "text": "私はたくさんの良いユニットを持っています。私は持っている"}, {"type": "subtitle", "time": 4969.669, "timestamp": "01:22:49", "text": "ザニ。私はカメリアを持っています。私は、えっと、誰ですか"}, {"type": "subtitle", "time": 4971.59, "timestamp": "01:22:51", "text": "ザニと一緒にいるのは誰？えーと、"}, {"type": "subtitle", "time": 4974.229, "timestamp": "01:22:54", "text": "少女。光のある方。えっと"}, {"type": "subtitle", "time": 4975.91, "timestamp": "01:22:55", "text": "素晴らしい。"}, {"type": "subtitle", "time": 4978.75, "timestamp": "01:22:58", "text": "うん、フィービー。フィービーもね。"}]
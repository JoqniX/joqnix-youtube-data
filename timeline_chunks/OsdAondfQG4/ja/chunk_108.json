[{"type": "subtitle", "time": 6480.55, "timestamp": "01:48:00", "text": "ああ、新しいイベントバナーみたいだね"}, {"type": "subtitle", "time": 6483.91, "timestamp": "01:48:03", "text": "何かが起こったような感じですよね？そうそう。"}, {"type": "subtitle", "time": 6488.229, "timestamp": "01:48:08", "text": "新しい武器のバナーのことですね。"}, {"type": "subtitle", "time": 6490.39, "timestamp": "01:48:10", "text": "えっと、あれは武器のバナーでしたっけ？えっと、"}, {"type": "subtitle", "time": 6492.669, "timestamp": "01:48:12", "text": "昨日ログインしたかどうか"}, {"type": "subtitle", "time": 6494.51, "timestamp": "01:48:14", "text": "昨日のように"}, {"type": "subtitle", "time": 6498.709, "timestamp": "01:48:18", "text": "ある日、私はこんなものを見たのですが、"}, {"type": "subtitle", "time": 6502.07, "timestamp": "01:48:22", "text": "イベントとか、そんな感じの呼び方をするんだ"}, {"type": "subtitle", "time": 6505.31, "timestamp": "01:48:25", "text": "バナーのようなものがあって"}, {"type": "subtitle", "time": 6509.31, "timestamp": "01:48:29", "text": "楽しかったことすべて。うん。その"}, {"type": "subtitle", "time": 6512.149, "timestamp": "01:48:32", "text": "うーん、その武器、すごくかっこいいですね。私は違います"}, {"type": "subtitle", "time": 6515.59, "timestamp": "01:48:35", "text": "嘘をつくつもりだ。もう少しで引っ張るところだった"}, {"type": "subtitle", "time": 6517.59, "timestamp": "01:48:37", "text": "財布から取り出す。嘘はつきません。おお"}, {"type": "subtitle", "time": 6520.47, "timestamp": "01:48:40", "text": "我が神よ。どれくらい使ったか"}, {"type": "subtitle", "time": 6530.39, "timestamp": "01:48:50", "text": "大まかな見積もりでは、"}, {"type": "subtitle", "time": 6537.51, "timestamp": "01:48:57", "text": "聖なる。まあ、そうですね。つまり、責めることができるだろうか"}]
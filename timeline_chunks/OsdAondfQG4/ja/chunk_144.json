[{"type": "subtitle", "time": 8641.07, "timestamp": "02:24:01", "text": "それはそれほど深刻なことではないと述べた"}, {"type": "subtitle", "time": 8643.67, "timestamp": "02:24:03", "text": "コラボは、"}, {"type": "subtitle", "time": 8647.51, "timestamp": "02:24:07", "text": "たまり場みたいな感じ。ああ、だって私は"}, {"type": "subtitle", "time": 8649.99, "timestamp": "02:24:09", "text": "もし私がそれを言わなければ、"}, {"type": "subtitle", "time": 8653.11, "timestamp": "02:24:13", "text": "人々はそれを真剣なコラボレーションと受け止めるだろう。"}, {"type": "subtitle", "time": 8655.11, "timestamp": "02:24:15", "text": "でも実際は、ただ好きになりたいだけ"}, {"type": "subtitle", "time": 8658.07, "timestamp": "02:24:18", "text": "人々とつながり、話をする"}, {"type": "chat", "time": 8659.301, "timestamp": "02:24:19", "author": "@rudratiwari8543", "avatar": "https://yt4.ggpht.com/ytc/AIdro_kTnTV5MpIhweGe_pzwsKp471uZ-E1ks3cSA76oHUxgBQ=s64-c-k-c0x00ffffff-no-rj", "message": "Mein bhi achha hu yash bhaiUCdZBnUb7m8Pd_wUTDNqUu3Q/f3TlZ5L1KpS3_9EP-duW6Qo"}, {"type": "subtitle", "time": 8660.309, "timestamp": "02:24:20", "text": "彼らを知り、彼らのことをもっとよく知る"}, {"type": "subtitle", "time": 8662.23, "timestamp": "02:24:22", "text": "もの。"}, {"type": "subtitle", "time": 8664.469, "timestamp": "02:24:24", "text": "うん。"}, {"type": "subtitle", "time": 8671.03, "timestamp": "02:24:31", "text": "そこは主要な要因の一つです。ある時"}, {"type": "subtitle", "time": 8673.27, "timestamp": "02:24:33", "text": "それはまるで私が、私は"}, {"type": "subtitle", "time": 8675.03, "timestamp": "02:24:35", "text": "プレイ中はコラボを頼まない"}, {"type": "subtitle", "time": 8676.71, "timestamp": "02:24:36", "text": "他の配信者と。私はただこう言うだけです。「"}, {"type": "subtitle", "time": 8679.67, "timestamp": "02:24:39", "text": "一緒に遊ばない？ 「遊びたい？」うん、"}, {"type": "subtitle", "time": 8683.59, "timestamp": "02:24:43", "text": "そうだね。うん。レン"}, {"type": "subtitle", "time": 8685.11, "timestamp": "02:24:45", "text": "彼女は時々こう言うでしょう、「あなたは"}, {"type": "subtitle", "time": 8686.389, "timestamp": "02:24:46", "text": "「コラボしませんか？」と聞くと、「うん、"}, {"type": "subtitle", "time": 8689.63, "timestamp": "02:24:49", "text": "プレイする気はあるよ。"}, {"type": "subtitle", "time": 8690.73, "timestamp": "02:24:50", "text": "獣医"}, {"type": "subtitle", "time": 8691.95, "timestamp": "02:24:51", "text": "[音楽]"}, {"type": "subtitle", "time": 8695.11, "timestamp": "02:24:55", "text": "えっと、あの小さなロリポップデーモンって何？ああ、"}, {"type": "subtitle", "time": 8696.87, "timestamp": "02:24:56", "text": "うん。ああ、レン。そうそう。うん。私は持っている"}, {"type": "subtitle", "time": 8698.79, "timestamp": "02:24:58", "text": "彼女に連絡を取る。私はよく忘れてしまう。"}]
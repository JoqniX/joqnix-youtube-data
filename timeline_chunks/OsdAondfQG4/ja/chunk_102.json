[{"type": "subtitle", "time": 6120.229, "timestamp": "01:42:00", "text": "えっと、私が始めた頃は"}, {"type": "subtitle", "time": 6123.189, "timestamp": "01:42:03", "text": "今よりはるかに多くの視聴者がいるだろう。いいね"}, {"type": "subtitle", "time": 6126.87, "timestamp": "01:42:06", "text": "YouTubeで20人の視聴者にいいね！をもらうには"}, {"type": "subtitle", "time": 6128.99, "timestamp": "01:42:08", "text": "おそらくそうでしょう。"}, {"type": "subtitle", "time": 6131.149, "timestamp": "01:42:11", "text": "えっと、"}, {"type": "subtitle", "time": 6134.55, "timestamp": "01:42:14", "text": "でも、私にはわからない。ただ、私はこう感じる"}, {"type": "subtitle", "time": 6136.79, "timestamp": "01:42:16", "text": "ストリーミングについてもっと良いストリーミングを今すぐ"}, {"type": "subtitle", "time": 6139.27, "timestamp": "01:42:19", "text": "なぜなら"}, {"type": "subtitle", "time": 6141.59, "timestamp": "01:42:21", "text": "ええと、今ここにいる人たちは"}, {"type": "subtitle", "time": 6143.43, "timestamp": "01:42:23", "text": "彼らはここにしばらくいなかった"}, {"type": "subtitle", "time": 6144.47, "timestamp": "01:42:24", "text": "彼らは最初からここにいる"}, {"type": "subtitle", "time": 6146.79, "timestamp": "01:42:26", "text": "YouTube時代から始まった"}, {"type": "subtitle", "time": 6148.79, "timestamp": "01:42:28", "text": "そんな感じ。私には「No」という名前の視聴者がいます"}, {"type": "subtitle", "time": 6151.109, "timestamp": "01:42:31", "text": "ハワイの神様。彼はここに4年くらいいる"}, {"type": "subtitle", "time": 6153.03, "timestamp": "01:42:33", "text": "または5年。"}, {"type": "subtitle", "time": 6154.99, "timestamp": "01:42:34", "text": "ええと、すべてを見ています"}, {"type": "subtitle", "time": 6158.07, "timestamp": "01:42:38", "text": "配信に来て、チャットする。"}, {"type": "subtitle", "time": 6159.99, "timestamp": "01:42:39", "text": "今、私には視聴者がいます"}, {"type": "subtitle", "time": 6163.43, "timestamp": "01:42:43", "text": "去年のようにそれを配ることで"}, {"type": "subtitle", "time": 6165.41, "timestamp": "01:42:45", "text": "おそらくもっと"}, {"type": "subtitle", "time": 6170.91, "timestamp": "01:42:50", "text": "[音楽]"}]
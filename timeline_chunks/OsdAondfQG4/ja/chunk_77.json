[{"type": "subtitle", "time": 4622.149, "timestamp": "01:17:02", "text": "あなた自身。それはまさにエレン・リングのようです"}, {"type": "subtitle", "time": 4624.07, "timestamp": "01:17:04", "text": "ファインティング。待って、そのMODの名前は何？"}, {"type": "subtitle", "time": 4625.91, "timestamp": "01:17:05", "text": "また？アニメーションとか、その他諸々。その"}, {"type": "subtitle", "time": 4629.229, "timestamp": "01:17:09", "text": "「壮大な戦い」と呼ばれています。すごい"}, {"type": "subtitle", "time": 4639.189, "timestamp": "01:17:19", "text": "適度。あなたはどちらを使っていますか？適度"}, {"type": "subtitle", "time": 4644.55, "timestamp": "01:17:24", "text": "あるいは、「ああ、私はCurse Forgeを使っています」といった感じ。ああ、"}, {"type": "subtitle", "time": 4647.03, "timestamp": "01:17:27", "text": "うん。わからない。私はただ使い続けました"}, {"type": "subtitle", "time": 4649.59, "timestamp": "01:17:29", "text": "Curse Forge は最も"}, {"type": "subtitle", "time": 4659.75, "timestamp": "01:17:39", "text": "とても寂しそうに見える。マインクラフトを変更する"}, {"type": "subtitle", "time": 4663.31, "timestamp": "01:17:43", "text": "戦闘。私は戦闘に負けました。"}, {"type": "subtitle", "time": 4667.709, "timestamp": "01:17:47", "text": "おお。ああ、なんて素晴らしいんだ。ダッシュ"}, {"type": "subtitle", "time": 4670.51, "timestamp": "01:17:50", "text": "攻撃、"}, {"type": "subtitle", "time": 4673.189, "timestamp": "01:17:53", "text": "回避、特殊攻撃。私はそれが大好きです"}, {"type": "subtitle", "time": 4678.32, "timestamp": "01:17:58", "text": "それは"}, {"type": "subtitle", "time": 4679.79, "timestamp": "01:17:59", "text": "[音楽]"}]
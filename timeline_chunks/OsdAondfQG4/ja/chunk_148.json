[{"type": "subtitle", "time": 8885.349, "timestamp": "02:28:05", "text": "そしてあなたが言ったように、コラボレーションという言葉は"}, {"type": "subtitle", "time": 8887.19, "timestamp": "02:28:07", "text": "ショップ。"}, {"type": "subtitle", "time": 8889.27, "timestamp": "02:28:09", "text": "ハングアウトと表現した方がいいと思う"}, {"type": "subtitle", "time": 8891.59, "timestamp": "02:28:11", "text": "その代わり。"}, {"type": "subtitle", "time": 8892.95, "timestamp": "02:28:12", "text": "うん。ゲームをしたいの？私は行きます"}, {"type": "subtitle", "time": 8894.71, "timestamp": "02:28:14", "text": "ストリーミング配信する。"}, {"type": "subtitle", "time": 8895.99, "timestamp": "02:28:15", "text": "今回は一緒に遊んでくれますか？私は"}, {"type": "subtitle", "time": 8902.23, "timestamp": "02:28:22", "text": "嘘はつきません。私は"}, {"type": "subtitle", "time": 8905.309, "timestamp": "02:28:25", "text": "ストリーミング配信。うん、やってみるよ"}, {"type": "subtitle", "time": 8907.59, "timestamp": "02:28:27", "text": "それ。待って、新しいものでも動作しますか"}, {"type": "subtitle", "time": 8909.67, "timestamp": "02:28:29", "text": "人々？"}, {"type": "subtitle", "time": 8911.51, "timestamp": "02:28:31", "text": "ええ、たくさんありますよ。 「ねえ、君は"}, {"type": "subtitle", "time": 8914.79, "timestamp": "02:28:34", "text": "遊ぶ？ストリーミング配信する予定です。"}, {"type": "subtitle", "time": 8916.71, "timestamp": "02:28:36", "text": "私はヴァレラントでたくさんのユーチューバーに会いました"}, {"type": "subtitle", "time": 8919.91, "timestamp": "02:28:39", "text": "そして、それはほんの始まりに過ぎない。"}, {"type": "subtitle", "time": 8921.75, "timestamp": "02:28:41", "text": "一緒に遊びませんか？私はなりたい"}, {"type": "subtitle", "time": 8923.27, "timestamp": "02:28:43", "text": "ストリーミング配信をしていると、「ああ、"}, {"type": "subtitle", "time": 8924.63, "timestamp": "02:28:44", "text": "あなたもYouTuberなの？一体どういうことだ？"}, {"type": "subtitle", "time": 8934.03, "timestamp": "02:28:54", "text": "わからない。私は何人かに会った"}, {"type": "subtitle", "time": 8939.11, "timestamp": "02:28:59", "text": "本当に、本当に良い人たちなんです。"}]
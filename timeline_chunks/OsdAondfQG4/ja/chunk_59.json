[{"type": "subtitle", "time": 3545.43, "timestamp": "00:59:05", "text": "うん。おお。おお。"}, {"type": "subtitle", "time": 3554.349, "timestamp": "00:59:14", "text": "おお。の"}, {"type": "subtitle", "time": 3559.91, "timestamp": "00:59:19", "text": "中国人は、えーと、どうやって"}, {"type": "subtitle", "time": 3563.39, "timestamp": "00:59:23", "text": "中国の僧侶が"}, {"type": "subtitle", "time": 3580.87, "timestamp": "00:59:40", "text": "よし、今ならできる。うん。うん。だから、それらは"}, {"type": "subtitle", "time": 3582.789, "timestamp": "00:59:42", "text": "本日追加した３名は以下の通りです。"}, {"type": "subtitle", "time": 3591.829, "timestamp": "00:59:51", "text": "わーい。ちゃんとしたアバターがないので、"}, {"type": "subtitle", "time": 3594.15, "timestamp": "00:59:54", "text": "私はこのアバターが好きなので、"}, {"type": "subtitle", "time": 3595.51, "timestamp": "00:59:55", "text": "それ。"}, {"type": "subtitle", "time": 3598.71, "timestamp": "00:59:58", "text": "ちょっと待って、あなたのアバターすごく可愛いですね"}]
[{"type": "subtitle", "time": 1210.549, "timestamp": "00:20:10", "text": "[音楽]"}, {"type": "subtitle", "time": 1216.07, "timestamp": "00:20:16", "text": "あれ、マイクから音声が漏れてた？"}, {"type": "subtitle", "time": 1225.669, "timestamp": "00:20:25", "text": "音が大きすぎましたか？音が大きすぎましたか？わかった。"}, {"type": "subtitle", "time": 1228.71, "timestamp": "00:20:28", "text": "わかった。いいえ、あなたは"}, {"type": "subtitle", "time": 1231.43, "timestamp": "00:20:31", "text": "チャットで好きなのは、2種類あるからです"}, {"type": "subtitle", "time": 1233.909, "timestamp": "00:20:33", "text": "人々の。逆さまの内向的なソーダ2本"}, {"type": "subtitle", "time": 1236.23, "timestamp": "00:20:36", "text": "あるいは、単に常軌を逸したおしゃべりな人たち。うん、"}, {"type": "subtitle", "time": 1238.95, "timestamp": "00:20:38", "text": "私たちはそういう光景をたくさん目にしました。私自身は"}, {"type": "subtitle", "time": 1241.51, "timestamp": "00:20:41", "text": "の中へ"}, {"type": "subtitle", "time": 1242.909, "timestamp": "00:20:42", "text": "やり方がわからない"}, {"type": "subtitle", "time": 1245.43, "timestamp": "00:20:45", "text": "翻訳するが"}, {"type": "subtitle", "time": 1247.909, "timestamp": "00:20:47", "text": "それは彼らに響き渡っている。そうそう、"}, {"type": "subtitle", "time": 1250.63, "timestamp": "00:20:50", "text": "ええ、ええ。わかってるよ。"}, {"type": "subtitle", "time": 1252.95, "timestamp": "00:20:52", "text": "いや、いや、いや、待って。音声は"}, {"type": "subtitle", "time": 1254.71, "timestamp": "00:20:54", "text": "ストリームですよね？"}, {"type": "subtitle", "time": 1257.19, "timestamp": "00:20:57", "text": "まったく同じノイズ抑制"}]
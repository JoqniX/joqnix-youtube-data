[{"type": "subtitle", "time": 2222.55, "timestamp": "00:37:02", "text": "はい。はい。"}, {"type": "subtitle", "time": 2225.43, "timestamp": "00:37:05", "text": "私も。私も。今でも懐かしい。私はできません"}, {"type": "subtitle", "time": 2229.51, "timestamp": "00:37:09", "text": "お母さんが髪をほどくことができないから、お母さん"}, {"type": "subtitle", "time": 2231.75, "timestamp": "00:37:11", "text": "行く"}, {"type": "subtitle", "time": 2233.67, "timestamp": "00:37:13", "text": "母は私のせいにするだろう。ほら、私は"}, {"type": "subtitle", "time": 2235.43, "timestamp": "00:37:15", "text": "モデルを少し動かすことができました"}, {"type": "subtitle", "time": 2237.67, "timestamp": "00:37:17", "text": "OSとビット。"}, {"type": "subtitle", "time": 2242.23, "timestamp": "00:37:22", "text": "いつかそれをやってみたいと思っていました。"}, {"type": "subtitle", "time": 2244.99, "timestamp": "00:37:24", "text": "うん。 1秒。電話がかかってくる"}, {"type": "subtitle", "time": 2248.65, "timestamp": "00:37:28", "text": "家族に"}, {"type": "subtitle", "time": 2258.109, "timestamp": "00:37:38", "text": "[音楽]"}, {"type": "subtitle", "time": 2262.95, "timestamp": "00:37:42", "text": "安全な。ああ、わかりました。"}, {"type": "subtitle", "time": 2264.829, "timestamp": "00:37:44", "text": "それは それは"}, {"type": "subtitle", "time": 2272.63, "timestamp": "00:37:52", "text": "人々は常に膨れ上がっている。"}, {"type": "subtitle", "time": 2274.63, "timestamp": "00:37:54", "text": "えっと、君たちも彼らの言うことを聞いてみて。わかった。病気"}, {"type": "subtitle", "time": 2277.349, "timestamp": "00:37:57", "text": "少ししたら戻ります。ドアを閉めます。"}]
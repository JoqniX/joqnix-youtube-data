[{"type": "subtitle", "time": 13681.51, "timestamp": "03:48:01", "text": "それ？ちなみに、私の声がちゃんと聞こえているといいのですが。する"}, {"type": "subtitle", "time": 13684.91, "timestamp": "03:48:04", "text": "聞こえない場合はお知らせください。"}, {"type": "subtitle", "time": 13687.91, "timestamp": "03:48:07", "text": "もの。よし。つまり、どういう意味で"}, {"type": "subtitle", "time": 13690.349, "timestamp": "03:48:10", "text": "それって何？"}, {"type": "subtitle", "time": 13694.79, "timestamp": "03:48:14", "text": "いや、違う。わかった。えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 13698.71, "timestamp": "03:48:18", "text": "それ？えっと、電車に乗る準備をしないといけないんです"}, {"type": "subtitle", "time": 13701.429, "timestamp": "03:48:21", "text": "上。だから、私は準備しなければならない"}, {"type": "subtitle", "time": 13702.95, "timestamp": "03:48:22", "text": "出発"}, {"type": "subtitle", "time": 13706.389, "timestamp": "03:48:26", "text": "えっと、3時頃だったと思います。 3時半か"}, {"type": "subtitle", "time": 13710.07, "timestamp": "03:48:30", "text": "何かが列車だ。こんにちは。えっと、必要"}, {"type": "subtitle", "time": 13713.11, "timestamp": "03:48:33", "text": "午後3時30分までに電車に乗るため。または3時"}, {"type": "subtitle", "time": 13715.83, "timestamp": "03:48:35", "text": "午後実は。こんにちは、"}, {"type": "subtitle", "time": 13720.229, "timestamp": "03:48:40", "text": "その時点では、相対的な評価だったと思う。おお、"}, {"type": "subtitle", "time": 13724.87, "timestamp": "03:48:44", "text": "いいえ。靴ひもがほどけてしまった。私"}, {"type": "subtitle", "time": 13727.59, "timestamp": "03:48:47", "text": "靴ひもを結ばなきゃ。はい。結ぶ必要がある"}, {"type": "subtitle", "time": 13730.15, "timestamp": "03:48:50", "text": "私の靴。場所を探さなきゃ。私は思う"}, {"type": "subtitle", "time": 13731.15, "timestamp": "03:48:51", "text": "これ"}, {"type": "subtitle", "time": 13738.229, "timestamp": "03:48:58", "text": "神。まあ、正直言ってこれでいいんだけどね。"}]
[{"type": "subtitle", "time": 15900.469, "timestamp": "04:25:00", "text": "バルコニー。非常に近いにもかかわらず"}, {"type": "subtitle", "time": 15904.63, "timestamp": "04:25:04", "text": "しかし、それは届かない。私は「なぜ？」と思った。そして"}, {"type": "subtitle", "time": 15908.389, "timestamp": "04:25:08", "text": "2GBの携帯電話を買った瞬間"}, {"type": "subtitle", "time": 15910.67, "timestamp": "04:25:10", "text": "おまけ"}, {"type": "subtitle", "time": 15913.67, "timestamp": "04:25:13", "text": "データからストリーミングしようとした"}, {"type": "subtitle", "time": 15916.429, "timestamp": "04:25:16", "text": "バルコニー。わかった。私たちはバルコニーへ行った"}, {"type": "subtitle", "time": 15919.429, "timestamp": "04:25:19", "text": "昨日、そして何とあったと思いますか？ Wi-Fiは"}, {"type": "subtitle", "time": 15923.269, "timestamp": "04:25:23", "text": "2つの信号を扱う作業。そして私は"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "えっと、何？私が働いていた時、あなたは働いていませんでした"}, {"type": "subtitle", "time": 15927.79, "timestamp": "04:25:27", "text": "配信を開始しました"}, {"type": "subtitle", "time": 15931.11, "timestamp": "04:25:31", "text": "昨日。いいえ。"}, {"type": "subtitle", "time": 15934.469, "timestamp": "04:25:34", "text": "そして私はこう思った、でもまた、今日私は"}, {"type": "subtitle", "time": 15937.429, "timestamp": "04:25:37", "text": "昨日買ってよかったけど、"}, {"type": "subtitle", "time": 15940.07, "timestamp": "04:25:40", "text": "さもないとこうなるだろう"}, {"type": "subtitle", "time": 15944.59, "timestamp": "04:25:44", "text": "えーと、ひどい状態だった"}, {"type": "subtitle", "time": 15948.79, "timestamp": "04:25:48", "text": "いいえ、Streamlabs は大量のデータを使用して"}, {"type": "subtitle", "time": 15951.189, "timestamp": "04:25:51", "text": "YouTubeにストリーミング配信しましたが、配信できませんでした"}, {"type": "subtitle", "time": 15952.99, "timestamp": "04:25:52", "text": "きちんと。"}, {"type": "subtitle", "time": 15957.59, "timestamp": "04:25:57", "text": "いいえ、でもこれなら私は嬉しいです"}]
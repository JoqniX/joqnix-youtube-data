[{"type": "subtitle", "time": 4260.87, "timestamp": "01:11:00", "text": "する。それはとても独創的だった。私は"}, {"type": "subtitle", "time": 4263.83, "timestamp": "01:11:03", "text": "「どうやってやるの？」って感じだった。それはまさに"}, {"type": "subtitle", "time": 4267.83, "timestamp": "01:11:07", "text": "いいね。どうしてそんな風に努力しないの？"}, {"type": "subtitle", "time": 4271.11, "timestamp": "01:11:11", "text": "カメラアングルによっても多くの情報が漏洩する可能性があります"}, {"type": "subtitle", "time": 4274.55, "timestamp": "01:11:14", "text": "もの？どうやってそれを実現させたのですか？"}, {"type": "subtitle", "time": 4277.03, "timestamp": "01:11:17", "text": "それは素晴らしいですね。"}, {"type": "subtitle", "time": 4278.47, "timestamp": "01:11:18", "text": "最初は、"}, {"type": "subtitle", "time": 4283.669, "timestamp": "01:11:23", "text": "3Dモデル。そうそう。うん。うん。"}, {"type": "subtitle", "time": 4292.73, "timestamp": "01:11:32", "text": "うん、3Dの世界は本当に素晴らしかったよ。"}, {"type": "subtitle", "time": 4294.31, "timestamp": "01:11:34", "text": "[音楽]"}, {"type": "subtitle", "time": 4298.63, "timestamp": "01:11:38", "text": "それで、えーと、3Dとライブ2Dですが"}, {"type": "subtitle", "time": 4301.75, "timestamp": "01:11:41", "text": "新作はライブ2Dですよね？"}, {"type": "subtitle", "time": 4304.55, "timestamp": "01:11:44", "text": "そうそう。"}, {"type": "subtitle", "time": 4308.75, "timestamp": "01:11:48", "text": "それで、同じものには行かなかったんですね"}, {"type": "subtitle", "time": 4312.63, "timestamp": "01:11:52", "text": "デザイン、マスクみたいなやつ。私は真剣です"}, {"type": "subtitle", "time": 4314.709, "timestamp": "01:11:54", "text": "まだマスクをしている。うん。ああ、それは"}, {"type": "subtitle", "time": 4316.35, "timestamp": "01:11:56", "text": "マスク。好きではないわけではない"}]
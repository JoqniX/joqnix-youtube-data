[{"type": "subtitle", "time": 8700.309, "timestamp": "02:25:00", "text": "何てことだ。"}, {"type": "subtitle", "time": 8709.03, "timestamp": "02:25:09", "text": "私がSMPを持っていた頃の話ですよね？"}, {"type": "subtitle", "time": 8711.63, "timestamp": "02:25:11", "text": "あなたはその頃、近くにいましたか？は"}, {"type": "subtitle", "time": 8715.19, "timestamp": "02:25:15", "text": "その"}, {"type": "subtitle", "time": 8718.71, "timestamp": "02:25:18", "text": "うん。うん。うん。あなたはそこにいましたか？私と"}, {"type": "subtitle", "time": 8722.71, "timestamp": "02:25:22", "text": "ピンク色のイルカ。ええ、私もそこにいました。おお、"}, {"type": "subtitle", "time": 8724.71, "timestamp": "02:25:24", "text": "そこであなたと出会ったような気がします。うん。"}, {"type": "subtitle", "time": 8727.27, "timestamp": "02:25:27", "text": "うん。うん。今思い出した。"}, {"type": "subtitle", "time": 8729.51, "timestamp": "02:25:29", "text": "ええ、そこでたくさんの人と知り合いました。"}, {"type": "subtitle", "time": 8733.19, "timestamp": "02:25:33", "text": "うん。そこで私たちはスミと出会った。"}, {"type": "subtitle", "time": 8745.349, "timestamp": "02:25:45", "text": "ご指摘ありがとうございます。私は"}, {"type": "subtitle", "time": 8747.83, "timestamp": "02:25:47", "text": "忘れること。私は自分の"}, {"type": "subtitle", "time": 8751.99, "timestamp": "02:25:51", "text": "サーバー上の古いMinecraftストリーム"}, {"type": "subtitle", "time": 8755.349, "timestamp": "02:25:55", "text": "私が誰と会ったのかを突き止める。"}, {"type": "subtitle", "time": 8757.91, "timestamp": "02:25:57", "text": "当時から知っている人全員に聞いたと思う"}, {"type": "subtitle", "time": 8759.71, "timestamp": "02:25:59", "text": "のように"}]
[{"type": "subtitle", "time": 7569.35, "timestamp": "02:06:09", "text": "こんにちは、チャットさん。私の名前はマスコンです。えっと、私は"}, {"type": "subtitle", "time": 7572.47, "timestamp": "02:06:12", "text": "主にTwitchで配信し、時々"}, {"type": "subtitle", "time": 7578.709, "timestamp": "02:06:18", "text": "YouTubeは年に一度くらい、つまり年に一度くらい更新される。"}, {"type": "subtitle", "time": 7582.83, "timestamp": "02:06:22", "text": "え、マルチストリーミングはしないの？"}, {"type": "subtitle", "time": 7586.91, "timestamp": "02:06:26", "text": "私はそうします、それが私が一種の"}, {"type": "subtitle", "time": 7589.35, "timestamp": "02:06:29", "text": "サムネイルとかを作るのが面倒くさい"}, {"type": "subtitle", "time": 7591.51, "timestamp": "02:06:31", "text": "それ。"}, {"type": "subtitle", "time": 7593.83, "timestamp": "02:06:33", "text": "待って。えっと、あなたはどちらですか？クラウドまたは"}, {"type": "subtitle", "time": 7597.589, "timestamp": "02:06:37", "text": "ローカルプラグイン版ですか？もう一度、えーと、私は"}, {"type": "subtitle", "time": 7601.109, "timestamp": "02:06:41", "text": "プラグイン版を使用してください。おお、"}, {"type": "subtitle", "time": 7603.35, "timestamp": "02:06:43", "text": "余剰帯域幅があり、私のPCは"}, {"type": "subtitle", "time": 7605.75, "timestamp": "02:06:45", "text": "対処できる。それで、"}, {"type": "chat", "time": 7606.762, "timestamp": "02:06:46", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "that's exactly what I meant, natural spring water from your nose"}, {"type": "subtitle", "time": 7608.79, "timestamp": "02:06:48", "text": "別々にやっていますか？ Twitchみたいに"}, {"type": "subtitle", "time": 7610.709, "timestamp": "02:06:50", "text": "Twitchチャット、YouTubeには"}, {"type": "subtitle", "time": 7613.189, "timestamp": "02:06:53", "text": "YouTubeのチャットってそんな感じだよね。"}, {"type": "subtitle", "time": 7616.229, "timestamp": "02:06:56", "text": "待って、分けてみます。私はトラブルに巻き込まれるだろう"}, {"type": "subtitle", "time": 7619.51, "timestamp": "02:06:59", "text": "Twitchと分けないと、そうなってしまう。"}]
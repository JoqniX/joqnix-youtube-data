[{"type": "subtitle", "time": 16628.59, "timestamp": "04:37:08", "text": "大丈夫。良いものを買ったら"}, {"type": "subtitle", "time": 16630.949, "timestamp": "04:37:10", "text": "マイクを使えば、"}, {"type": "subtitle", "time": 16633.51, "timestamp": "04:37:13", "text": "音質が良い。しかし今のところは"}, {"type": "subtitle", "time": 16636.39, "timestamp": "04:37:16", "text": "電話音声。私にとっては、また彫刻のためだ。"}, {"type": "subtitle", "time": 16638.59, "timestamp": "04:37:18", "text": "例えば、"}, {"type": "subtitle", "time": 16642.07, "timestamp": "04:37:22", "text": "これ。もし私が文字通り"}, {"type": "subtitle", "time": 16644.629, "timestamp": "04:37:24", "text": "ストリーミングを始めたので、もちろん"}, {"type": "subtitle", "time": 16646.629, "timestamp": "04:37:26", "text": "非常に劣悪な機器"}, {"type": "subtitle", "time": 16650.789, "timestamp": "04:37:30", "text": "機器のことですよね？それからゆっくりとゆっくりと"}, {"type": "subtitle", "time": 16653.869, "timestamp": "04:37:33", "text": "えっと、アップグレードします"}, {"type": "subtitle", "time": 16657.67, "timestamp": "04:37:37", "text": "それ。それは写真ですか？あれはボートですか？私"}, {"type": "subtitle", "time": 16658.75, "timestamp": "04:37:38", "text": "それは"}, {"type": "subtitle", "time": 16660.789, "timestamp": "04:37:40", "text": "漁師。 2人くらいしかいない"}, {"type": "subtitle", "time": 16662.551, "timestamp": "04:37:42", "text": "ボート。そして写真を撮らせてください"}, {"type": "subtitle", "time": 16665.429, "timestamp": "04:37:45", "text": "それもまた然りでしょう。わからない。私"}, {"type": "subtitle", "time": 16667.67, "timestamp": "04:37:47", "text": "これらをどこに投稿するかはまだ決めていません。"}, {"type": "subtitle", "time": 16669.869, "timestamp": "04:37:49", "text": "おそらく"}, {"type": "subtitle", "time": 16672.629, "timestamp": "04:37:52", "text": "不和。それから、えーと、投稿しないといけないんです"}, {"type": "subtitle", "time": 16674.551, "timestamp": "04:37:54", "text": "Facebookとかでこれをシェアする"}, {"type": "subtitle", "time": 16677.949, "timestamp": "04:37:57", "text": "そういうことですよね？だから、私は"}]
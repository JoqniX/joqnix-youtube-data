[{"type": "subtitle", "time": 16090.309, "timestamp": "04:28:10", "text": "死んだ。さよなら。氷で冷やす。このストリームは"}, {"type": "subtitle", "time": 16093.71, "timestamp": "04:28:13", "text": "文字通り私が話しながら死んでいく"}, {"type": "subtitle", "time": 16102.55, "timestamp": "04:28:22", "text": "神。でも、私は文字通り通り過ぎている"}, {"type": "subtitle", "time": 16105.83, "timestamp": "04:28:25", "text": "波が打ち寄せる海岸と"}, {"type": "subtitle", "time": 16106.91, "timestamp": "04:28:26", "text": "得られなかった"}, {"type": "subtitle", "time": 16109.67, "timestamp": "04:28:29", "text": "濡れた。ああ、縁起でもないことを言ってはいけないな。ああ、"}, {"type": "subtitle", "time": 16111.91, "timestamp": "04:28:31", "text": "うわ、すごい波が来るぞ。私"}, {"type": "subtitle", "time": 16114.149, "timestamp": "04:28:34", "text": "縁起でもないことを言ってしまった。でも、そうですね"}, {"type": "subtitle", "time": 16116.189, "timestamp": "04:28:36", "text": "ヒットしなかった"}, {"type": "subtitle", "time": 16120.07, "timestamp": "04:28:40", "text": "自分。良い。"}, {"type": "subtitle", "time": 16128.63, "timestamp": "04:28:48", "text": "えっと、また共有しちゃった、忘れてた。移動しましょう"}, {"type": "subtitle", "time": 16132.51, "timestamp": "04:28:52", "text": "その話題から外れます。忘れてしまったので。"}, {"type": "subtitle", "time": 16135.03, "timestamp": "04:28:55", "text": "うん。では、今後の計画は？待って、"}, {"type": "subtitle", "time": 16136.55, "timestamp": "04:28:56", "text": "あれはココナッツですか？待って、いや、それは違う"}]
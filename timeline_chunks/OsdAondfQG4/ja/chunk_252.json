[{"type": "subtitle", "time": 15121.189, "timestamp": "04:12:01", "text": "うん。うん。こんにちは、スノーウィー。いらっしゃいませ、"}, {"type": "subtitle", "time": 15123.469, "timestamp": "04:12:03", "text": "いらっしゃいませ。どうやって"}, {"type": "subtitle", "time": 15125.99, "timestamp": "04:12:05", "text": "何をしているの？ええ、そうですね。私が言っていたように、"}, {"type": "subtitle", "time": 15129.83, "timestamp": "04:12:09", "text": "文字通り、えっと、それらを取って"}, {"type": "subtitle", "time": 15132.95, "timestamp": "04:12:12", "text": "配達に文字通り2時間かかる"}, {"type": "subtitle", "time": 15135.75, "timestamp": "04:12:15", "text": "えっと、食べ物とかそういうの。そして何が"}, {"type": "subtitle", "time": 15137.67, "timestamp": "04:12:17", "text": "何が起こったかというと、配達員は"}, {"type": "subtitle", "time": 15141.67, "timestamp": "04:12:21", "text": "小さな子供のようなもの。彼らには"}, {"type": "subtitle", "time": 15143.349, "timestamp": "04:12:23", "text": "彼らは道を間違えたか何かしたのだろう。"}, {"type": "subtitle", "time": 15145.429, "timestamp": "04:12:25", "text": "彼らは方向を知らなかった。彼らは"}, {"type": "subtitle", "time": 15148.15, "timestamp": "04:12:28", "text": "道に迷ったり、いろいろあった。それで、えーと、私の親戚は"}, {"type": "subtitle", "time": 15149.87, "timestamp": "04:12:29", "text": "そしていとこたちは"}, {"type": "subtitle", "time": 15153.11, "timestamp": "04:12:33", "text": "配達物を受け取らなければならなかった"}, {"type": "subtitle", "time": 15156.07, "timestamp": "04:12:36", "text": "彼ら自身。"}, {"type": "subtitle", "time": 15158.389, "timestamp": "04:12:38", "text": "それは面白い。でも、それもかっこよかった"}, {"type": "subtitle", "time": 15160.87, "timestamp": "04:12:40", "text": "けれど。もし私が戻ってきたら"}, {"type": "subtitle", "time": 15162.11, "timestamp": "04:12:42", "text": "家、私の"}, {"type": "subtitle", "time": 15164.71, "timestamp": "04:12:44", "text": "家へ、まるで文字通り彼らを連れて行くかのように"}, {"type": "subtitle", "time": 15167.71, "timestamp": "04:12:47", "text": "7分か6分くらいで"}, {"type": "subtitle", "time": 15169.91, "timestamp": "04:12:49", "text": "どの店舗からでも配達できますが、"}, {"type": "subtitle", "time": 15171.59, "timestamp": "04:12:51", "text": "彼らはまるでスーパー"}, {"type": "subtitle", "time": 15174.63, "timestamp": "04:12:54", "text": "速くて、いろいろ。"}, {"type": "subtitle", "time": 15176.71, "timestamp": "04:12:56", "text": "でも、それが住むことのメリットなんだ"}]
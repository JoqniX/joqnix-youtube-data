[{"type": "subtitle", "time": 5160.95, "timestamp": "01:26:00", "text": "ああ、私が始めた唯一の理由は"}, {"type": "subtitle", "time": 5163.75, "timestamp": "01:26:03", "text": "嵐が来たのはなぜ？あなたはまだ"}, {"type": "subtitle", "time": 5165.669, "timestamp": "01:26:05", "text": "大丈夫。大丈夫。えっと、あなたは"}, {"type": "subtitle", "time": 5169.11, "timestamp": "01:26:09", "text": "原神に入信したのか、それとも入信を許可されたのか？"}, {"type": "subtitle", "time": 5173.35, "timestamp": "01:26:13", "text": "いいえ、数年前に試してみましたが、"}, {"type": "subtitle", "time": 5175.43, "timestamp": "01:26:15", "text": "どうしても無理だった。私はそれに夢中でした"}, {"type": "subtitle", "time": 5180.55, "timestamp": "01:26:20", "text": "発売当初から、"}, {"type": "subtitle", "time": 5186.87, "timestamp": "01:26:26", "text": "すみません。ごめん。大丈夫。"}, {"type": "subtitle", "time": 5188.75, "timestamp": "01:26:28", "text": "私も電話がかかってきた。私"}, {"type": "subtitle", "time": 5193.35, "timestamp": "01:26:33", "text": "ああ、そうだった。すぐにそうなるよ。"}, {"type": "subtitle", "time": 5200.95, "timestamp": "01:26:40", "text": "うん。うん。あなたは原神について話していましたね。"}, {"type": "subtitle", "time": 5204.95, "timestamp": "01:26:44", "text": "えっと、何を言ってたか忘れちゃった"}, {"type": "subtitle", "time": 5208.99, "timestamp": "01:26:48", "text": "君もそれにハマったけど"}, {"type": "subtitle", "time": 5212.47, "timestamp": "01:26:52", "text": "ああ、君も原神にハマったんだね"}, {"type": "subtitle", "time": 5214.31, "timestamp": "01:26:54", "text": "のように"}, {"type": "subtitle", "time": 5217.189, "timestamp": "01:26:57", "text": "ああ、それから、その後はどうなるの？"}]
[{"type": "subtitle", "time": 6429.03, "timestamp": "01:47:09", "text": "楽しい。楽しかったです。"}, {"type": "subtitle", "time": 6430.95, "timestamp": "01:47:10", "text": "うん。わからない。私はちょっと試している"}, {"type": "subtitle", "time": 6433.27, "timestamp": "01:47:13", "text": "でも、Destinyは頑張ってるよ。難しいかもしれない"}, {"type": "subtitle", "time": 6437.03, "timestamp": "01:47:17", "text": "暇つぶしにゲームを楽しむために"}, {"type": "subtitle", "time": 6439.75, "timestamp": "01:47:19", "text": "歯を良くする。"}, {"type": "subtitle", "time": 6443.91, "timestamp": "01:47:23", "text": "あなたはDestinyのPvPが得意ですね。それは"}, {"type": "subtitle", "time": 6449.149, "timestamp": "01:47:29", "text": "今の自分が以前ほど上手かどうかはわからないが、"}, {"type": "subtitle", "time": 6451.79, "timestamp": "01:47:31", "text": "でも私はちょっと"}, {"type": "subtitle", "time": 6455.109, "timestamp": "01:47:35", "text": "良い。少なくとも以前はそうだった。今は私は"}, {"type": "subtitle", "time": 6457.59, "timestamp": "01:47:37", "text": "Warframeでヴァレラントをプレイして"}, {"type": "subtitle", "time": 6460.31, "timestamp": "01:47:40", "text": "マインクラフト。バレンタインデーはどうでしたか？"}, {"type": "subtitle", "time": 6462.39, "timestamp": "01:47:42", "text": "あなた？"}, {"type": "subtitle", "time": 6465.95, "timestamp": "01:47:45", "text": "大丈夫。今はスウィフトのプレイしかプレイしない。"}, {"type": "subtitle", "time": 6476.669, "timestamp": "01:47:56", "text": "彼らは今そのイベントを開催している。"}]
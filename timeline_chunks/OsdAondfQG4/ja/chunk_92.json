[{"type": "subtitle", "time": 5522.149, "timestamp": "01:32:02", "text": "だから、私はいつも、ええ、私はいつも"}, {"type": "subtitle", "time": 5524.47, "timestamp": "01:32:04", "text": "そのゲームをすぐにプレイして、もしかしたら"}, {"type": "subtitle", "time": 5527.75, "timestamp": "01:32:07", "text": "時々ストリーミング配信するけど、"}, {"type": "subtitle", "time": 5530.79, "timestamp": "01:32:10", "text": "ええ、わかりません。理由は"}, {"type": "subtitle", "time": 5533.189, "timestamp": "01:32:13", "text": "私がたくさんのゲームをプレイする理由は"}, {"type": "subtitle", "time": 5534.59, "timestamp": "01:32:14", "text": "ストリーマー"}, {"type": "subtitle", "time": 5538.31, "timestamp": "01:32:18", "text": "友達。 M"}, {"type": "subtitle", "time": 5539.669, "timestamp": "01:32:19", "text": "嘘はつきません。私はあなたが"}, {"type": "subtitle", "time": 5542.149, "timestamp": "01:32:22", "text": "まるでランダムな思考のようにプレイした。うん、"}, {"type": "subtitle", "time": 5544.39, "timestamp": "01:32:24", "text": "ランダムに選ばれたもの。"}, {"type": "subtitle", "time": 5547.27, "timestamp": "01:32:27", "text": "うん、ランダムなゲームがたくさんあるね"}, {"type": "subtitle", "time": 5549.35, "timestamp": "01:32:29", "text": "そこには。"}, {"type": "subtitle", "time": 5551.99, "timestamp": "01:32:31", "text": "ただ見つける必要があるだけです。良いものを見つける"}, {"type": "subtitle", "time": 5555.11, "timestamp": "01:32:35", "text": "1つ、それから、ええ、本当に"}, {"type": "subtitle", "time": 5565.47, "timestamp": "01:32:45", "text": "うん。たくさんの物。"}, {"type": "subtitle", "time": 5569.91, "timestamp": "01:32:49", "text": "すみません。多分。"}, {"type": "subtitle", "time": 5572.95, "timestamp": "01:32:52", "text": "お酒を飲みましたか？水分補給はしましたか？"}, {"type": "subtitle", "time": 5574.229, "timestamp": "01:32:54", "text": "ああ、もうすぐ水がなくなっちゃう"}, {"type": "subtitle", "time": 5576.95, "timestamp": "01:32:56", "text": "ここです。知っている。ああ、あなたは"}, {"type": "subtitle", "time": 5579.59, "timestamp": "01:32:59", "text": "ちょっと休憩して、ボトルに水を補充するの。"}]
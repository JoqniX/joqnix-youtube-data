[{"type": "subtitle", "time": 7740.55, "timestamp": "02:09:00", "text": "オートビームのプレミアムバージョン"}, {"type": "subtitle", "time": 7742.629, "timestamp": "02:09:02", "text": "ストリーム。必ず削除してください。"}, {"type": "subtitle", "time": 7745.83, "timestamp": "02:09:05", "text": "あなたが今送ってくれた画像。"}, {"type": "subtitle", "time": 7747.27, "timestamp": "02:09:07", "text": "あなたの配信の一部が表示されます"}, {"type": "subtitle", "time": 7756.709, "timestamp": "02:09:16", "text": "どれもトラブルの原因になります。うん。うん。その"}, {"type": "subtitle", "time": 7760.149, "timestamp": "02:09:20", "text": "わかった。心配ない。"}, {"type": "subtitle", "time": 7763.03, "timestamp": "02:09:23", "text": "そして彼らは大学のチャットを持っていて、"}, {"type": "subtitle", "time": 7765.43, "timestamp": "02:09:25", "text": "本当にクール"}, {"type": "subtitle", "time": 7768.47, "timestamp": "02:09:28", "text": "えっと、YouTubeの教会の動画が見られます"}, {"type": "subtitle", "time": 7770.39, "timestamp": "02:09:30", "text": "すべてのプラットフォームが試験運用されました"}, {"type": "subtitle", "time": 7774.109, "timestamp": "02:09:34", "text": "さあ、私の配信を1つで読んでください"}, {"type": "subtitle", "time": 7776.39, "timestamp": "02:09:36", "text": "とても素敵な場所だ。私はそれが"}, {"type": "subtitle", "time": 7778.87, "timestamp": "02:09:38", "text": "2番目に助けが必要なので"}, {"type": "subtitle", "time": 7783.03, "timestamp": "02:09:43", "text": "それを監視すると、私は半分をカバーします"}, {"type": "subtitle", "time": 7788.19, "timestamp": "02:09:48", "text": "チャットのみのライブプレビューです。"}, {"type": "subtitle", "time": 7791.51, "timestamp": "02:09:51", "text": "[音楽]"}, {"type": "subtitle", "time": 7794.43, "timestamp": "02:09:54", "text": "うん、この方法はいいよ"}, {"type": "subtitle", "time": 7798.629, "timestamp": "02:09:58", "text": "実は。本当に素敵でかっこいい。"}]
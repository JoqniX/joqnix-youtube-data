[{"type": "subtitle", "time": 16744.029, "timestamp": "04:39:04", "text": "電話かミュートにしてから通り過ぎる"}, {"type": "subtitle", "time": 16746.269, "timestamp": "04:39:06", "text": "見知らぬ人や"}, {"type": "subtitle", "time": 16749.91, "timestamp": "04:39:09", "text": "えっと、待って、これは何？待って、これは何？"}, {"type": "subtitle", "time": 16752.949, "timestamp": "04:39:12", "text": "砂浜にある泡状のもの？これらは"}, {"type": "subtitle", "time": 16754.91, "timestamp": "04:39:14", "text": "小さなカニの家のように、"}, {"type": "subtitle", "time": 16759.189, "timestamp": "04:39:19", "text": "何か？え、何？波のように"}, {"type": "subtitle", "time": 16762.709, "timestamp": "04:39:22", "text": "入った。砂は濡れたが、それは"}, {"type": "subtitle", "time": 16765.83, "timestamp": "04:39:25", "text": "下の方で泡立ち始めた。待って、"}, {"type": "subtitle", "time": 16769.789, "timestamp": "04:39:29", "text": "新たな波が押し寄せていた。そうねぇ"}, {"type": "subtitle", "time": 16771.949, "timestamp": "04:39:31", "text": "これ"}, {"type": "subtitle", "time": 16776.23, "timestamp": "04:39:36", "text": "また。もう一度、どこに行けばいいのでしょうか？おお"}, {"type": "subtitle", "time": 16782.868, "timestamp": "04:39:42", "text": "神。間違った解釈はしたくない"}, {"type": "subtitle", "time": 16784.59, "timestamp": "04:39:44", "text": "最後と同じように曲がる"}, {"type": "subtitle", "time": 16787.43, "timestamp": "04:39:47", "text": "時間。いいえ、まっすぐ行きます。座りましょう"}, {"type": "subtitle", "time": 16790.99, "timestamp": "04:39:50", "text": "しばらくの間、ダウンします。わかった。シュ"}, {"type": "subtitle", "time": 16797.03, "timestamp": "04:39:57", "text": "どこかビーチリゾートのような場所。何？"}]
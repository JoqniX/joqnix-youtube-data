[{"type": "subtitle", "time": 13501.83, "timestamp": "03:45:01", "text": "えっと、ショーって何て言うんだっけ？"}, {"type": "subtitle", "time": 13503.91, "timestamp": "03:45:03", "text": "マイクの修理というよりは便利なもの"}, {"type": "subtitle", "time": 13505.63, "timestamp": "03:45:05", "text": "私がしなければならない場所"}, {"type": "subtitle", "time": 13509.429, "timestamp": "03:45:09", "text": "えっと、ケーブルとかそういうのが付いてるやつ。"}, {"type": "subtitle", "time": 13512.55, "timestamp": "03:45:12", "text": "それは痛みを伴うだろうが、私は感じる"}, {"type": "subtitle", "time": 13514.11, "timestamp": "03:45:14", "text": "これはもっと"}, {"type": "subtitle", "time": 13516.75, "timestamp": "03:45:16", "text": "より良い。では、"}, {"type": "subtitle", "time": 13520.03, "timestamp": "03:45:20", "text": "上？聞こえますように"}, {"type": "subtitle", "time": 13522.87, "timestamp": "03:45:22", "text": "方法。ええ、私の声がちゃんと聞こえるといいのですが。"}, {"type": "subtitle", "time": 13528.63, "timestamp": "03:45:28", "text": "何てことだ。私はパボラムを引き上げるかもしれない"}, {"type": "subtitle", "time": 13532.67, "timestamp": "03:45:32", "text": "通知システム。"}, {"type": "subtitle", "time": 13535.83, "timestamp": "03:45:35", "text": "ああ、でもそうだね。だから、たくさんあるような"}, {"type": "subtitle", "time": 13538.309, "timestamp": "03:45:38", "text": "朝なので、通り過ぎる人々"}, {"type": "subtitle", "time": 13540.95, "timestamp": "03:45:40", "text": "7ですよね？もちろん人々は"}, {"type": "subtitle", "time": 13544.389, "timestamp": "03:45:44", "text": "彼らも朝の散歩に出かけるだろう。"}, {"type": "subtitle", "time": 13546.309, "timestamp": "03:45:46", "text": "でも、ある意味、そんな感じだった"}, {"type": "subtitle", "time": 13549.349, "timestamp": "03:45:49", "text": "自分が話しているのは気まずくて変な感じ"}, {"type": "subtitle", "time": 13551.83, "timestamp": "03:45:51", "text": "英語で、まるで他人同士のよう"}, {"type": "subtitle", "time": 13556.189, "timestamp": "03:45:56", "text": "私をじっと見つめるこの少年は何者なのか"}, {"type": "subtitle", "time": 13558.79, "timestamp": "03:45:58", "text": "何をしているの？彼は携帯電話に向かって何を話しているの？"}]
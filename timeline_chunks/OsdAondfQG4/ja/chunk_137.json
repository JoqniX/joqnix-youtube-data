[{"type": "subtitle", "time": 8221.11, "timestamp": "02:17:01", "text": "私が配信している場所を見て、"}, {"type": "subtitle", "time": 8227.79, "timestamp": "02:17:07", "text": "本当に長いと言いたい"}, {"type": "subtitle", "time": 8233.15, "timestamp": "02:17:13", "text": "なぜなら私は"}, {"type": "subtitle", "time": 8234.91, "timestamp": "02:17:14", "text": "少しでも"}, {"type": "subtitle", "time": 8237.91, "timestamp": "02:17:17", "text": "十分に高い数で"}, {"type": "subtitle", "time": 8241.589, "timestamp": "02:17:21", "text": "ちっちゃくてちっちゃいって呼ばれてるけど、私はまだ"}, {"type": "subtitle", "time": 8244.19, "timestamp": "02:17:24", "text": "小さい、あなた"}, {"type": "subtitle", "time": 8248.07, "timestamp": "02:17:28", "text": "知る？でも、えっと、私はそうは思わない"}, {"type": "chat", "time": 8248.571, "timestamp": "02:17:28", "author": "@yashchourasia2215", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mbRu2gYmpEUO4nLl0jA2optOzbTHvVFqZhza3dfpPmwg=s64-c-k-c0x00ffffff-no-rj", "message": "Yahalloo"}, {"type": "subtitle", "time": 8249.19, "timestamp": "02:17:29", "text": "あまり気にしなくていいよ"}, {"type": "chat", "time": 8250.85, "timestamp": "02:17:30", "author": "@KonztellionHelper", "avatar": "https://yt4.ggpht.com/GocLQxiJeUhcpFBwOECdYbCqbqHlCvz1B8j2gnfHQ1Q3AM1kFQ-eKqoi6TpMpyuxId3-6U94bcI=s64-c-k-c0x00ffffff-no-rj", "message": "Greetings Konzteller! Yash Chourasia~🌟 Welcome to the Guild! Make sure to read the Guildmate Guidelines in the description below before chatting further. Enjoy your stay!"}, {"type": "subtitle", "time": 8257.91, "timestamp": "02:17:37", "text": "でも、人が来て"}, {"type": "subtitle", "time": 8260.23, "timestamp": "02:17:40", "text": "「誰も見ていないようなものだ」と言ってください。"}, {"type": "subtitle", "time": 8262.549, "timestamp": "02:17:42", "text": "「何をしているの？」自分のことに集中している"}, {"type": "subtitle", "time": 8263.75, "timestamp": "02:17:43", "text": "私がやっているのはビジネスです。なぜしないのか"}, {"type": "subtitle", "time": 8266.03, "timestamp": "02:17:46", "text": "あなたも自分のことに集中しているの？あなた"}, {"type": "subtitle", "time": 8268.629, "timestamp": "02:17:48", "text": "ごめんなさい、わかってるよ
[{"type": "subtitle", "time": 9184.95, "timestamp": "02:33:04", "text": "2018年と、ミーティングは確か2020年か2019年だったと思います。"}, {"type": "subtitle", "time": 9189.15, "timestamp": "02:33:09", "text": "なんてこった。ええと、2090年、2020年。そうですね。"}, {"type": "subtitle", "time": 9191.75, "timestamp": "02:33:11", "text": "[音楽]"}, {"type": "subtitle", "time": 9195.11, "timestamp": "02:33:15", "text": "あなたは本当に本当に"}, {"type": "subtitle", "time": 9196.71, "timestamp": "02:33:16", "text": "うん。"}, {"type": "subtitle", "time": 9197.99, "timestamp": "02:33:17", "text": "必要な知識はありますか？"}, {"type": "subtitle", "time": 9200.07, "timestamp": "02:33:20", "text": "チャットで伝える？"}, {"type": "subtitle", "time": 9203.55, "timestamp": "02:33:23", "text": "H 知識は"}, {"type": "subtitle", "time": 9206.23, "timestamp": "02:33:26", "text": "数字のことは気にしなくていいよ"}, {"type": "subtitle", "time": 9209.03, "timestamp": "02:33:29", "text": "特に始めたばかりの頃は。そのまま"}, {"type": "subtitle", "time": 9211.75, "timestamp": "02:33:31", "text": "5人か10人くらいの人数"}, {"type": "subtitle", "time": 9213.75, "timestamp": "02:33:33", "text": "起業当初は、人々が必要です。そしてもしあなたが"}, {"type": "subtitle", "time": 9216.11, "timestamp": "02:33:36", "text": "1人か2人しか見ていないか、誰も見ていない"}, {"type": "subtitle", "time": 9219.469, "timestamp": "02:33:39", "text": "見守るだけで話し続けることを忘れないで"}, {"type": "subtitle", "time": 9222.389, "timestamp": "02:33:42", "text": "常にラーがいるだろう"}, {"type": "subtitle", "time": 9223.99, "timestamp": "02:33:43", "text": "Twitchの文化から来たものだ。うん、"}, {"type": "subtitle", "time": 9226.51, "timestamp": "02:33:46", "text": "これから"}, {"type": "subtitle", "time": 9230.79, "timestamp": "02:33:50", "text": "ロッカー、そして、ええ、それはあなたの義務です"}, {"type": "subtitle", "time": 9237.11, "timestamp": "02:33:57", "text": "それらのlersを実際の"}]
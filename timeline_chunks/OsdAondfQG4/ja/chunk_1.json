[{"type": "subtitle", "time": 67.39, "timestamp": "00:01:07", "text": "あれ。来る"}, {"type": "subtitle", "time": 69.91, "timestamp": "00:01:09", "text": "ここ。あ、待って。私は"}, {"type": "subtitle", "time": 72.429, "timestamp": "00:01:12", "text": "ニックネーム、"}, {"type": "subtitle", "time": 75.429, "timestamp": "00:01:15", "text": "右？ログインセクションがタイムアウトしたと表示されます。"}, {"type": "subtitle", "time": 77.55, "timestamp": "00:01:17", "text": "もう一度ログインをお試しください。"}, {"type": "subtitle", "time": 81.39, "timestamp": "00:01:21", "text": "なぜそれがバグなのか、"}, {"type": "subtitle", "time": 84.51, "timestamp": "00:01:24", "text": "何か？何か知っていますか？"}, {"type": "subtitle", "time": 87.59, "timestamp": "00:01:27", "text": "それはあなたの息子からのものですか？"}, {"type": "subtitle", "time": 90.31, "timestamp": "00:01:30", "text": "私のユーザー名は、大文字のJになります。"}, {"type": "subtitle", "time": 98.10900000000001, "timestamp": "00:01:38", "text": "名前。"}, {"type": "subtitle", "time": 105.71000000000001, "timestamp": "00:01:45", "text": "わかった。ああ、私は実際に"}, {"type": "subtitle", "time": 109.03, "timestamp": "00:01:49", "text": "友人。信じられますか？ママは実際"}, {"type": "subtitle", "time": 112.55, "timestamp": "00:01:52", "text": "友達ができた。私たちは実際に"}, {"type": "subtitle", "time": 114.95, "timestamp": "00:01:54", "text": "実際に私たちの目標を達成しようと試みる"}, {"type": "subtitle", "time": 116.87, "timestamp": "00:01:56", "text": "ストリーム。"}, {"type": "subtitle", "time": 118.95, "timestamp": "00:01:58", "text": "ええと、私たちは実際に目標を達成しました"}]
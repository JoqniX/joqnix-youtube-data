[{"type": "subtitle", "time": 243.27, "timestamp": "00:04:03", "text": "[音楽]"}, {"type": "subtitle", "time": 246.63, "timestamp": "00:04:06", "text": "あなたを受け入れます。でも、あなたはオフラインですよね？"}, {"type": "subtitle", "time": 251.03, "timestamp": "00:04:11", "text": "今。そうそう。うん。はい。はい。それです。"}, {"type": "subtitle", "time": 255.55, "timestamp": "00:04:15", "text": "それです。はい。私はいつも"}, {"type": "subtitle", "time": 258.55, "timestamp": "00:04:18", "text": "隠れる。では、今すぐインターネットに接続します。"}, {"type": "subtitle", "time": 261.749, "timestamp": "00:04:21", "text": "ああ、わかりました。うん。うん。それで、私の姿が見えますか？"}, {"type": "subtitle", "time": 270.07, "timestamp": "00:04:30", "text": "クリスマス当日。ええ、そうですね。ありがとう"}, {"type": "subtitle", "time": 272.469, "timestamp": "00:04:32", "text": "Steamで私をフレンドに追加してくれてありがとう。それは本当に"}, {"type": "subtitle", "time": 275.189, "timestamp": "00:04:35", "text": "たくさん。"}, {"type": "subtitle", "time": 279.35, "timestamp": "00:04:39", "text": "国際デー。だから、"}, {"type": "subtitle", "time": 284.55, "timestamp": "00:04:44", "text": "おお。それでお祝いしよう。"}, {"type": "subtitle", "time": 287.469, "timestamp": "00:04:47", "text": "すごく遅れてる。一体どういうことだ？"}, {"type": "subtitle", "time": 295.629, "timestamp": "00:04:55", "text": "私はそこに行きたい"}]
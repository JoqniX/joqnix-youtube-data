[{"type": "subtitle", "time": 14700.91, "timestamp": "04:05:00", "text": "あれ。ああ、水が"}, {"type": "subtitle", "time": 14704.229, "timestamp": "04:05:04", "text": "水しぶき。彼らは来るべきだ。行かないで。"}, {"type": "subtitle", "time": 14705.75, "timestamp": "04:05:05", "text": "ちなみに、これは正真正銘の犬です。私"}, {"type": "subtitle", "time": 14708.71, "timestamp": "04:05:08", "text": "噛まれないといいな。うん、じゃあね。"}, {"type": "subtitle", "time": 14711.51, "timestamp": "04:05:11", "text": "よし、私はその犬の横を通り過ぎた。 3匹の犬"}, {"type": "subtitle", "time": 14720.55, "timestamp": "04:05:20", "text": "うん。はい、彼らを追い越しました。さあ行こう。"}, {"type": "subtitle", "time": 14724.229, "timestamp": "04:05:24", "text": "待って、あれは大きな波だ。ああ、見て"}, {"type": "subtitle", "time": 14726.269, "timestamp": "04:05:26", "text": "そんなに大きな"}, {"type": "subtitle", "time": 14728.95, "timestamp": "04:05:28", "text": "波。正直に言うと、私は"}, {"type": "subtitle", "time": 14732.349, "timestamp": "04:05:32", "text": "どうやってそれを学んだか、"}, {"type": "subtitle", "time": 14735.79, "timestamp": "04:05:35", "text": "地理の勉強に戻るか、"}, {"type": "subtitle", "time": 14738.11, "timestamp": "04:05:38", "text": "何か。それは長い"}, {"type": "subtitle", "time": 14741.75, "timestamp": "04:05:41", "text": "戻る。えっと、どうすればいいのかよくわからないんです"}, {"type": "subtitle", "time": 14743.87, "timestamp": "04:05:43", "text": "海は機能する。"}, {"type": "subtitle", "time": 14748.71, "timestamp": "04:05:48", "text": "どうして遠くまで安定していて"}, {"type": "subtitle", "time": 14751.67, "timestamp": "04:05:51", "text": "まるで不規則に引っ張っているみたい"}, {"type": "subtitle", "time": 14755.51, "timestamp": "04:05:55", "text": "波の種類が似ている波を出す"}, {"type": "subtitle", "time": 14759.51, "timestamp": "04:05:59", "text": "うん、波、波、えっと、波はどうやってできるの？"}]
[{"type": "subtitle", "time": 14585.95, "timestamp": "04:03:05", "text": "方法？\""}, {"type": "subtitle", "time": 14588.95, "timestamp": "04:03:08", "text": "だから、私は文字通り歩いている、"}, {"type": "subtitle", "time": 14591.75, "timestamp": "04:03:11", "text": "右？でも、私の目標は"}, {"type": "subtitle", "time": 14595.15, "timestamp": "04:03:15", "text": "青い色の"}, {"type": "subtitle", "time": 14597.389, "timestamp": "04:03:17", "text": "ビーチにあるボート"}, {"type": "subtitle", "time": 14600.309, "timestamp": "04:03:20", "text": "海岸。だから、私はそこへ行って"}, {"type": "subtitle", "time": 14603.229, "timestamp": "04:03:23", "text": "手早く"}, {"type": "subtitle", "time": 14607.349, "timestamp": "04:03:27", "text": "180度回転して家に帰る。待って、180じゃない。"}, {"type": "subtitle", "time": 14610.79, "timestamp": "04:03:30", "text": "素早く60°回転するか、戻って、そう、修正"}, {"type": "subtitle", "time": 14613.83, "timestamp": "04:03:33", "text": "あの時計。シェイクを加えます。"}, {"type": "subtitle", "time": 14617.189, "timestamp": "04:03:37", "text": "シェイクに戻って、先に進みます"}, {"type": "subtitle", "time": 14620.99, "timestamp": "04:03:40", "text": "まっすぐ家に帰る。"}, {"type": "subtitle", "time": 14624.67, "timestamp": "04:03:44", "text": "こんにちは。文字通り"}, {"type": "subtitle", "time": 14628.349, "timestamp": "04:03:48", "text": "これらのものを見せてください。それはいいですね。しかし"}, {"type": "subtitle", "time": 14632.469, "timestamp": "04:03:52", "text": "また、私は超えなければならない、私は"}]
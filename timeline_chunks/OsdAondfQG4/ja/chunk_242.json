[{"type": "subtitle", "time": 14520.63, "timestamp": "04:02:00", "text": "海岸。うん。でも私はこんなことは決してしない"}, {"type": "subtitle", "time": 14521.71, "timestamp": "04:02:01", "text": "遠い"}, {"type": "subtitle", "time": 14535.67, "timestamp": "04:02:15", "text": "待つ。電話がかかってくる。待って、"}, {"type": "subtitle", "time": 14538.99, "timestamp": "04:02:18", "text": "待って、待って。ミュートにした方がいいですよね？"}, {"type": "subtitle", "time": 14540.67, "timestamp": "04:02:20", "text": "待って。おお、"}, {"type": "subtitle", "time": 14544.67, "timestamp": "04:02:24", "text": "待って。おお。あ、待って。おお、"}, {"type": "subtitle", "time": 14547.07, "timestamp": "04:02:27", "text": "待って。待って、待って、"}, {"type": "subtitle", "time": 14562.429, "timestamp": "04:02:42", "text": "何？わかった。"}, {"type": "subtitle", "time": 14572.55, "timestamp": "04:02:52", "text": "こんにちは。つまり、散歩に出かけたとき、"}, {"type": "subtitle", "time": 14575.83, "timestamp": "04:02:55", "text": "私は自分のクソ野郎に言ったんだ、私は"}, {"type": "subtitle", "time": 14577.99, "timestamp": "04:02:57", "text": "散歩に出かける。彼は「どこで"}]
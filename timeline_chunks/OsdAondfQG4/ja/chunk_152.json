[{"type": "subtitle", "time": 9121.51, "timestamp": "02:32:01", "text": "最近のスムとのコラボレーションは、"}, {"type": "subtitle", "time": 9126.07, "timestamp": "02:32:06", "text": "アヒル、アヒル、ガチョウ。ああ、アヒル、ガチョウ。私は決して"}, {"type": "subtitle", "time": 9129.03, "timestamp": "02:32:09", "text": "それをプレイした。楽しいですか？"}, {"type": "subtitle", "time": 9131.349, "timestamp": "02:32:11", "text": "かなり楽しい。そう、Among Usみたいな感じ"}, {"type": "subtitle", "time": 9134.309, "timestamp": "02:32:14", "text": "お互いに話すことができます。"}, {"type": "subtitle", "time": 9137.27, "timestamp": "02:32:17", "text": "ああ、"}, {"type": "subtitle", "time": 9138.87, "timestamp": "02:32:18", "text": "アヒルがいるから本当に素敵です"}, {"type": "subtitle", "time": 9140.71, "timestamp": "02:32:20", "text": "人を食べることができるもの、そしてもしあなたがそれを食べたら"}, {"type": "subtitle", "time": 9143.429, "timestamp": "02:32:23", "text": "人々、えーと"}, {"type": "subtitle", "time": 9145.11, "timestamp": "02:32:25", "text": "まるで彼らがあなたに話しかけているのが聞こえるようだ"}, {"type": "subtitle", "time": 9147.91, "timestamp": "02:32:27", "text": "そして、他の誰にも彼らの声は聞こえない。"}, {"type": "subtitle", "time": 9149.27, "timestamp": "02:32:29", "text": "つまり、それらはあなたの胃の中にあり、あなたは"}, {"type": "subtitle", "time": 9150.79, "timestamp": "02:32:30", "text": "彼らが「なぜ聞くのか」と言っているのが聞こえる"}, {"type": "subtitle", "time": 9157.16, "timestamp": "02:32:37", "text": "私はあのカモが大好きです。"}, {"type": "subtitle", "time": 9159.67, "timestamp": "02:32:39", "text": "[音楽]"}, {"type": "subtitle", "time": 9161.46, "timestamp": "02:32:41", "text": "楽しいですよ。"}, {"type": "subtitle", "time": 9163.309, "timestamp": "02:32:43", "text": "[音楽]"}, {"type": "subtitle", "time": 9166.23, "timestamp": "02:32:46", "text": "でも、あなたはどれくらい前から配信しているんですか？"}, {"type": "subtitle", "time": 9169.91, "timestamp": "02:32:49", "text": "今のことではなく、一般的に言って。えっと"}, {"type": "subtitle", "time": 9173.27, "timestamp": "02:32:53", "text": "私が始めたときのように"}, {"type": "subtitle", "time": 9176.79, "timestamp": "02:32:56", "text": "チューニングとか色々やってるんだ。ああ、私は"}, {"type": "subtitle", "time": 9178.75, "timestamp": "02:32:58", "text": "ストリーミングを開始しました"}]
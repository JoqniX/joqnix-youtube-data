[{"type": "subtitle", "time": 13561.269, "timestamp": "03:46:01", "text": "なぜ彼は携帯電話で話したりしているのでしょうか"}, {"type": "subtitle", "time": 13563.95, "timestamp": "03:46:03", "text": "もの。しかし"}, {"type": "subtitle", "time": 13569.67, "timestamp": "03:46:09", "text": "うん、まあまあだけど、ある意味では思う"}, {"type": "subtitle", "time": 13573.469, "timestamp": "03:46:13", "text": "自信を持ち始めたのは"}, {"type": "subtitle", "time": 13576.07, "timestamp": "03:46:16", "text": "観光スペースを作っていたときのように"}, {"type": "subtitle", "time": 13578.87, "timestamp": "03:46:18", "text": "私は本当に怖かったので"}, {"type": "subtitle", "time": 13582.07, "timestamp": "03:46:22", "text": "恥ずかしいし、心配でもある"}, {"type": "subtitle", "time": 13585.71, "timestamp": "03:46:25", "text": "見知らぬ人とすれ違うたびに私は"}, {"type": "subtitle", "time": 13589.03, "timestamp": "03:46:29", "text": "ミュートして静かにしようとしたら、"}, {"type": "subtitle", "time": 13592.07, "timestamp": "03:46:32", "text": "それらを洗う 私は話そうとするが"}, {"type": "subtitle", "time": 13595.429, "timestamp": "03:46:35", "text": "まるでただひたすら突き進むように。だから私は思う"}, {"type": "subtitle", "time": 13596.91, "timestamp": "03:46:36", "text": "ああ、あなたが"}, {"type": "subtitle", "time": 13600.55, "timestamp": "03:46:40", "text": "自分が感じていることを何かする"}, {"type": "subtitle", "time": 13603.67, "timestamp": "03:46:43", "text": "不快な感じ、または何か"}, {"type": "subtitle", "time": 13607.429, "timestamp": "03:46:47", "text": "今までやったことないような、えっと、そういう感じ"}, {"type": "subtitle", "time": 13610.309, "timestamp": "03:46:50", "text": "しばらくするとそれに適応する"}, {"type": "subtitle", "time": 13613.11, "timestamp": "03:46:53", "text": "ちょっとかっこいい。待って、あれはコオロギ？"}, {"type": "subtitle", "time": 13614.87, "timestamp": "03:46:54", "text": "待て、あれはコオロギだ。待って、あなたは"}, {"type": "subtitle", "time": 13616.95, "timestamp": "03:46:56", "text": "これ、聞こえますか？"}, {"type": "subtitle", "time": 13619.07, "timestamp": "03:46:59", "text": "これは"}]
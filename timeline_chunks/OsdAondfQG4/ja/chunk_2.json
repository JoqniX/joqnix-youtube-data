[{"type": "subtitle", "time": 121.749, "timestamp": "00:02:01", "text": "ストリーム。私たちは友達を一人作り、"}, {"type": "subtitle", "time": 124.23, "timestamp": "00:02:04", "text": "chで話すことはできませんでした、chで話しました"}, {"type": "subtitle", "time": 126.99, "timestamp": "00:02:06", "text": "えっと、誰かと少し日本語を話します"}, {"type": "subtitle", "time": 129.389, "timestamp": "00:02:09", "text": "[音楽]"}, {"type": "subtitle", "time": 132.19, "timestamp": "00:02:12", "text": "それ以外。うん。そして"}, {"type": "subtitle", "time": 136.949, "timestamp": "00:02:16", "text": "うん。何てことだ。だから私はできると思う"}, {"type": "subtitle", "time": 150.39, "timestamp": "00:02:30", "text": "[音楽]"}, {"type": "subtitle", "time": 153.35, "timestamp": "00:02:33", "text": "待って、私にはよく理解できないと思う。"}, {"type": "subtitle", "time": 171.75, "timestamp": "00:02:51", "text": "画面を割らせてください。"}, {"type": "subtitle", "time": 174.309, "timestamp": "00:02:54", "text": "えっと、"}, {"type": "subtitle", "time": 177.15, "timestamp": "00:02:57", "text": "どういう意味ですか？"}, {"type": "subtitle", "time": 179.50900000000001, "timestamp": "00:02:59", "text": "社交的だよ。私は彼女を"}]
[{"type": "subtitle", "time": 3780.47, "timestamp": "01:03:00", "text": "あなたはそれを何と呼ぶのですか？"}, {"type": "subtitle", "time": 3783.67, "timestamp": "01:03:03", "text": "それは、えっと、英語です。ええ、そうです"}, {"type": "subtitle", "time": 3788.47, "timestamp": "01:03:08", "text": "えっと、大丈夫だと言うような感じですね。私"}, {"type": "subtitle", "time": 3790.109, "timestamp": "01:03:10", "text": "変更する"}, {"type": "subtitle", "time": 3795.829, "timestamp": "01:03:15", "text": "えっと、他のものを好きになってもいいってこと。"}, {"type": "subtitle", "time": 3799.589, "timestamp": "01:03:19", "text": "えっと、なんて言うんだっけ？"}, {"type": "subtitle", "time": 3803.67, "timestamp": "01:03:23", "text": "えーっと、例えばアニメって、"}, {"type": "subtitle", "time": 3806.549, "timestamp": "01:03:26", "text": "アニメに興味のある人は"}, {"type": "subtitle", "time": 3809.19, "timestamp": "01:03:29", "text": "変な話し方ではなく変な話し方"}, {"type": "subtitle", "time": 3812.15, "timestamp": "01:03:32", "text": "異なるタイプの英語ですよね"}, {"type": "subtitle", "time": 3815.19, "timestamp": "01:03:35", "text": "そんな感じ。わからない。"}, {"type": "subtitle", "time": 3817.309, "timestamp": "01:03:37", "text": "それは何て言うんだっけ"}, {"type": "subtitle", "time": 3821.029, "timestamp": "01:03:41", "text": "それ？私が最初にそれを聞いた。"}, {"type": "subtitle", "time": 3829.829, "timestamp": "01:03:49", "text": "私は現在働いており、英語を話します"}, {"type": "subtitle", "time": 3831.21, "timestamp": "01:03:51", "text": "長さ"}, {"type": "subtitle", "time": 3832.43, "timestamp": "01:03:52", "text": "[音楽]"}]
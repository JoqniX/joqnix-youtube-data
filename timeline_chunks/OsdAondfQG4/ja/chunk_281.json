[{"type": "subtitle", "time": 16860.31, "timestamp": "04:41:00", "text": "ええと、今日。 Pia 1時間前。いいえ、1ではありません"}, {"type": "subtitle", "time": 16863.27, "timestamp": "04:41:03", "text": "時間。 30分前か、20分前か。"}, {"type": "subtitle", "time": 16875.11, "timestamp": "04:41:15", "text": "熱い。おお。泳ごうとしている男がいる。"}, {"type": "subtitle", "time": 16877.07, "timestamp": "04:41:17", "text": "それとも彼は釣りをしようとしているのか"}, {"type": "subtitle", "time": 16880.628, "timestamp": "04:41:20", "text": "ネット？いいね。"}, {"type": "subtitle", "time": 16893.83, "timestamp": "04:41:33", "text": "波。私がどうするか、わかる？私が試してみます"}, {"type": "subtitle", "time": 16898.07, "timestamp": "04:41:38", "text": "父に聞いたり、このことを話したりするつもりです。行くよ"}, {"type": "subtitle", "time": 16899.55, "timestamp": "04:41:39", "text": "さあ、歩いて"}, {"type": "subtitle", "time": 16901.75, "timestamp": "04:41:41", "text": "また。配信はしません。私はそうは思わない"}, {"type": "subtitle", "time": 16904.43, "timestamp": "04:41:44", "text": "ストリーミング配信すべきだ。私はまたここを歩いて"}, {"type": "subtitle", "time": 16909.708, "timestamp": "04:41:49", "text": "ビーチでひと泳ぎして戻ってくる"}, {"type": "subtitle", "time": 16914.07, "timestamp": "04:41:54", "text": "家。いいえ、戻って、きちんと整理します"}, {"type": "subtitle", "time": 16918.788, "timestamp": "04:41:58", "text": "起きて、何に備えるの？ああ、そうだね。"}]
[{"type": "subtitle", "time": 2520.069, "timestamp": "00:42:00", "text": "あ、待って。誰か見つかりましたか？"}, {"type": "subtitle", "time": 2531.87, "timestamp": "00:42:11", "text": "私"}, {"type": "subtitle", "time": 2537.55, "timestamp": "00:42:17", "text": "今日は女の子と話してないよ。"}, {"type": "subtitle", "time": 2540.069, "timestamp": "00:42:20", "text": "待って。今日は女の子と話してないの？"}, {"type": "subtitle", "time": 2545.109, "timestamp": "00:42:25", "text": "そうそう。ええ、誰かに相談できますよ。"}, {"type": "subtitle", "time": 2550.67, "timestamp": "00:42:30", "text": "あなたは。大丈夫。私はそれが好きです。私は好きです"}, {"type": "subtitle", "time": 2554.87, "timestamp": "00:42:34", "text": "これ。彼らとは話したくない。"}, {"type": "subtitle", "time": 2557.75, "timestamp": "00:42:37", "text": "こんにちは。"}, {"type": "subtitle", "time": 2559.67, "timestamp": "00:42:39", "text": "私も人見知りなので、どうすればいいのかわかりません"}]
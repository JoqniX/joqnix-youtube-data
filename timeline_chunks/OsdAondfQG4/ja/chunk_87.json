[{"type": "subtitle", "time": 5226.55, "timestamp": "01:27:06", "text": "忘れた、ああ、そうそう、わかった、私は"}, {"type": "subtitle", "time": 5230.27, "timestamp": "01:27:10", "text": "決して悪いことは起こらないということを覚えておいてください。"}, {"type": "subtitle", "time": 5232.55, "timestamp": "01:27:12", "text": "あ、すみません。私の記憶は、"}, {"type": "subtitle", "time": 5236.189, "timestamp": "01:27:16", "text": "最近調子が悪い。いいえ、大丈夫です。すべて"}, {"type": "subtitle", "time": 5240.31, "timestamp": "01:27:20", "text": "良い。覚えておいて、これはただのADHDの症状だよ"}, {"type": "subtitle", "time": 5243.03, "timestamp": "01:27:23", "text": "時々私たちにこう言うんだ、「うん、君"}, {"type": "subtitle", "time": 5246.229, "timestamp": "01:27:26", "text": "リフレッシュが必要だ。"}, {"type": "subtitle", "time": 5251.669, "timestamp": "01:27:31", "text": "げんちん。げんちん。何か"}, {"type": "subtitle", "time": 5255.35, "timestamp": "01:27:35", "text": "源珍に興味を持ち始めたんだよね？"}, {"type": "subtitle", "time": 5257.629, "timestamp": "01:27:37", "text": "ああ、そうだね。いや、いや、いや。"}, {"type": "subtitle", "time": 5262.87, "timestamp": "01:27:42", "text": "危うく思い出すところだった。えっと"}, {"type": "subtitle", "time": 5265.189, "timestamp": "01:27:45", "text": "君もわかるように、私は待ちきれなかったんだと思う。"}, {"type": "subtitle", "time": 5270.149, "timestamp": "01:27:50", "text": "ゲームが毎週どのようにアップデートされるか。うん。"}, {"type": "subtitle", "time": 5273.91, "timestamp": "01:27:53", "text": "いや、毎週じゃないよ。えっと、私は"}, {"type": "subtitle", "time": 5276.709, "timestamp": "01:27:56", "text": "どう説明すればいいのかわからない。"}, {"type": "subtitle", "time": 5278.11, "timestamp": "01:27:58", "text": "のように"}]
[{"type": "subtitle", "time": 12061.269, "timestamp": "03:21:01", "text": "話題とか色々あるけど、ある意味それは"}, {"type": "subtitle", "time": 12065.07, "timestamp": "03:21:05", "text": "ぶら下がるように"}, {"type": "subtitle", "time": 12099.19, "timestamp": "03:21:39", "text": "わかった。私は全員に連絡を取ったと思う"}, {"type": "subtitle", "time": 12101.389, "timestamp": "03:21:41", "text": "シングル"}, {"type": "subtitle", "time": 12104.63, "timestamp": "03:21:44", "text": "人々。今、私は扉を開放します"}, {"type": "subtitle", "time": 12107.15, "timestamp": "03:21:47", "text": "新しい人向け"}]
[{"type": "subtitle", "time": 7625.83, "timestamp": "02:07:05", "text": "ああ、チャットみたいだね。うん、いろいろあるよ。"}, {"type": "subtitle", "time": 7628.55, "timestamp": "02:07:08", "text": "この大物ストリーマーたちがトラブルに巻き込まれた"}, {"type": "subtitle", "time": 7631.709, "timestamp": "02:07:11", "text": "それについては、そう思う。"}, {"type": "subtitle", "time": 7633.99, "timestamp": "02:07:13", "text": "うん、入るのちょっと怖いんだ"}, {"type": "subtitle", "time": 7636.069, "timestamp": "02:07:16", "text": "ストリーミングに問題が発生する。私も好きです"}, {"type": "subtitle", "time": 7643.75, "timestamp": "02:07:23", "text": "[音楽]"}, {"type": "subtitle", "time": 7646.31, "timestamp": "02:07:26", "text": "Beamというプラットフォームを使い始めました。"}, {"type": "subtitle", "time": 7649.27, "timestamp": "02:07:29", "text": "ストリーム。それは良かった"}, {"type": "subtitle", "time": 7651.91, "timestamp": "02:07:31", "text": "マルチリーミング。それは再夢のようなものだが、"}, {"type": "subtitle", "time": 7653.75, "timestamp": "02:07:33", "text": "無料。"}, {"type": "subtitle", "time": 7656.069, "timestamp": "02:07:36", "text": "ずっと良くなった。何かありますか？"}, {"type": "subtitle", "time": 7660.31, "timestamp": "02:07:40", "text": "限界？いいえ。 M22プラスにストリーミングできます"}, {"type": "subtitle", "time": 7663.109, "timestamp": "02:07:43", "text": "側面。待ってもいいですか？ストリーミングできますか？"}, {"type": "subtitle", "time": 7665.27, "timestamp": "02:07:45", "text": "垂直方向の流れも好きですか？うん、"}, {"type": "subtitle", "time": 7668.35, "timestamp": "02:07:48", "text": "垂直方向にも。それは良いことだ"}, {"type": "subtitle", "time": 7671.27, "timestamp": "02:07:51", "text": "一部。 YouTubeを2つ追加できます"}, {"type": "subtitle", "time": 7675.27, "timestamp": "02:07:55", "text": "アカウントと垂直プラグインを配置します"}, {"type": "subtitle", "time": 7677.229, "timestamp": "02:07:57", "text": "そして垂直方向を追加する"}]
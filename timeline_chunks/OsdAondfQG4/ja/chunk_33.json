[{"type": "subtitle", "time": 1988.789, "timestamp": "00:33:08", "text": "それから。なぜ彼は彼らにそんなに多くを要求するのか？それで"}, {"type": "subtitle", "time": 1991.23, "timestamp": "00:33:11", "text": "彼らにはずっと後で聞いてください。私はしません"}, {"type": "subtitle", "time": 1994.19, "timestamp": "00:33:14", "text": "知る。彼は激しい議論に巻き込まれた。"}, {"type": "subtitle", "time": 1996.389, "timestamp": "00:33:16", "text": "ええ、長持ちする方が良いですね"}, {"type": "subtitle", "time": 1998.789, "timestamp": "00:33:18", "text": "それよりも印象が良かった。ああ、電話できます"}, {"type": "subtitle", "time": 2007.509, "timestamp": "00:33:27", "text": "うん。えっと、ジョックン。そうやって"}, {"type": "subtitle", "time": 2010.389, "timestamp": "00:33:30", "text": "発音してください。でも、もしそれが難しいなら、"}, {"type": "subtitle", "time": 2013.35, "timestamp": "00:33:33", "text": "私をスポーツマンと呼んでください。"}, {"type": "subtitle", "time": 2016.07, "timestamp": "00:33:36", "text": "アスリートかアスリートか。ジョジョ。"}, {"type": "subtitle", "time": 2018.83, "timestamp": "00:33:38", "text": "ああ、俺のことをジョッキーと呼んでくれて構わないよ。はい。"}, {"type": "subtitle", "time": 2022.23, "timestamp": "00:33:42", "text": "はい。そしてほとんどの人が私を"}, {"type": "subtitle", "time": 2039.35, "timestamp": "00:33:59", "text": "私はこれを散らかしたくないんです。私は"}]
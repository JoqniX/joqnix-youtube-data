[{"type": "subtitle", "time": 13980.55, "timestamp": "03:53:00", "text": "ノートパソコンを持っていなかったら、"}, {"type": "subtitle", "time": 13982.67, "timestamp": "03:53:02", "text": "ノートパソコンで、文字通り"}, {"type": "subtitle", "time": 13985.67, "timestamp": "03:53:05", "text": "私がいる場所ならどこでもストリーミング配信"}, {"type": "subtitle", "time": 13988.83, "timestamp": "03:53:08", "text": "たとえ外にいるような気分でも、私は"}, {"type": "subtitle", "time": 14022.99, "timestamp": "03:53:42", "text": "でも、靴紐を結ばせてください"}, {"type": "subtitle", "time": 14026.11, "timestamp": "03:53:46", "text": "実は。そこには、"}, {"type": "subtitle", "time": 14028.229, "timestamp": "03:53:48", "text": "閉店しました。そしてこれらは、これらは"}, {"type": "subtitle", "time": 14031.91, "timestamp": "03:53:51", "text": "路上商店、路上商店。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 14033.389, "timestamp": "03:53:53", "text": "できない"}, {"type": "subtitle", "time": 14037.51, "timestamp": "03:53:57", "text": "発音する。そうですね、誰も"}]
[{"type": "subtitle", "time": 15300.429, "timestamp": "04:15:00", "text": "海、つまりビーチ"}, {"type": "subtitle", "time": 15304.469, "timestamp": "04:15:04", "text": "あれ。ええと、それは良いものになるでしょう"}, {"type": "subtitle", "time": 15308.07, "timestamp": "04:15:08", "text": "もっと楽しく。私はそうするでしょう、私はそうしないでしょう、私は"}, {"type": "subtitle", "time": 15311.429, "timestamp": "04:15:11", "text": "泳げなかったからといって、心が折れることはない"}, {"type": "subtitle", "time": 15313.389, "timestamp": "04:15:13", "text": "私は"}, {"type": "subtitle", "time": 15317.63, "timestamp": "04:15:17", "text": "ビーチだけど、文字通り人々は泳いで"}, {"type": "subtitle", "time": 15321.03, "timestamp": "04:15:21", "text": "いろいろあるけど、その間私はこれについてここにいる"}, {"type": "subtitle", "time": 15324.07, "timestamp": "04:15:24", "text": "人が私の方へ歩いてきていますが"}, {"type": "subtitle", "time": 15326.11, "timestamp": "04:15:26", "text": "文字通り私はここにいます"}, {"type": "subtitle", "time": 15331.07, "timestamp": "04:15:31", "text": "えっと、なんて言うんだっけ"}, {"type": "subtitle", "time": 15334.309, "timestamp": "04:15:34", "text": "文字通り私はここにいるのではなく、"}, {"type": "subtitle", "time": 15337.75, "timestamp": "04:15:37", "text": "水に浸かったりして、私は"}, {"type": "subtitle", "time": 15338.75, "timestamp": "04:15:38", "text": "1"}, {"type": "subtitle", "time": 15341.07, "timestamp": "04:15:41", "text": "モア"}, {"type": "subtitle", "time": 15343.59, "timestamp": "04:15:43", "text": "痛み。だから私は悲しい少年のようだろう"}, {"type": "subtitle", "time": 15346.389, "timestamp": "04:15:46", "text": "今日戻るとき。しかし、私はまた、"}, {"type": "subtitle", "time": 15348.99, "timestamp": "04:15:48", "text": "文字通りただ"}, {"type": "subtitle", "time": 15350.51, "timestamp": "04:15:50", "text": "浸漬"}, {"type": "subtitle", "time": 15353.349, "timestamp": "04:15:53", "text": "服を洗う必要がないようなものだ。私"}, {"type": "subtitle", "time": 15356.55, "timestamp": "04:15:56", "text": "カバーのように入れるだけでいいんです"}]
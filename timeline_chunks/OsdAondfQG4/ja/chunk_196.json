[{"type": "subtitle", "time": 11771.349, "timestamp": "03:16:11", "text": "感情を通して。私はもう少しで手に入れられそうだった"}, {"type": "subtitle", "time": 11774.15, "timestamp": "03:16:14", "text": "すべての人々。私はコラボレーションしました"}, {"type": "subtitle", "time": 11776.91, "timestamp": "03:16:16", "text": "長いグループコラボレーション"}, {"type": "subtitle", "time": 11780.67, "timestamp": "03:16:20", "text": "戻って、それ自体が"}, {"type": "subtitle", "time": 11790.99, "timestamp": "03:16:30", "text": "でも、ニタはデートの約束をした"}, {"type": "subtitle", "time": 11796.77, "timestamp": "03:16:36", "text": "モアザン。"}, {"type": "subtitle", "time": 11808.67, "timestamp": "03:16:48", "text": "ああ、私は必ず手に入れなければならない"}, {"type": "subtitle", "time": 11811.19, "timestamp": "03:16:51", "text": "全員を"}]
[{"type": "subtitle", "time": 4983.11, "timestamp": "01:23:03", "text": "ああ、両方とも持っていますよ。そして私は"}, {"type": "subtitle", "time": 4985.75, "timestamp": "01:23:05", "text": "わからない。彼女を手に入れたいんだけど、えっと、彼女は何？"}, {"type": "subtitle", "time": 4988.01, "timestamp": "01:23:08", "text": "名前？"}, {"type": "subtitle", "time": 4990.47, "timestamp": "01:23:10", "text": "[音楽]"}, {"type": "subtitle", "time": 4992.709, "timestamp": "01:23:12", "text": "電話がかかってくる？短期間のキープ。ああ、"}, {"type": "subtitle", "time": 4995.27, "timestamp": "01:23:15", "text": "羊飼い。うん。うん。入手する必要がある"}, {"type": "subtitle", "time": 4999.03, "timestamp": "01:23:19", "text": "メタビルドを構築する。"}, {"type": "subtitle", "time": 5001.75, "timestamp": "01:23:21", "text": "うん。ショートキーパーが欲しいので"}, {"type": "subtitle", "time": 5005.35, "timestamp": "01:23:25", "text": "ひどく悪いけど、私にはできない。わかった。彼女が恋しかった"}, {"type": "subtitle", "time": 5007.59, "timestamp": "01:23:27", "text": "先週のバナー。先月の最後の2件。私"}, {"type": "subtitle", "time": 5010.149, "timestamp": "01:23:30", "text": "ああ、先月彼女のバナーを見逃してしまった。うん。"}, {"type": "subtitle", "time": 5011.91, "timestamp": "01:23:31", "text": "2ヶ月前。覚えていない。最後"}, {"type": "subtitle", "time": 5015.11, "timestamp": "01:23:35", "text": "1ヶ月か2ヶ月前。うん。うん。その"}, {"type": "subtitle", "time": 5025.99, "timestamp": "01:23:45", "text": "私は何も覚えていない。うん。うん。私"}, {"type": "subtitle", "time": 5030.31, "timestamp": "01:23:50", "text": "私はそのビルド、Zani PBを手に入れました"}, {"type": "subtitle", "time": 5034.55, "timestamp": "01:23:54", "text": "出荷業者構築。私はしたかった 私はしたかった"}, {"type": "subtitle", "time": 5037.55, "timestamp": "01:23:57", "text": "ファザニを引っ張らずに、"}]
[{"type": "subtitle", "time": 1030.429, "timestamp": "00:17:10", "text": "[音楽]"}, {"type": "subtitle", "time": 1033.549, "timestamp": "00:17:13", "text": "はい、あなたはとても上手に話していますし"}, {"type": "subtitle", "time": 1047.23, "timestamp": "00:17:27", "text": "私は違います"}, {"type": "subtitle", "time": 1054.15, "timestamp": "00:17:34", "text": "何？何？あなたは同性愛者ですか？待って、私は"}, {"type": "subtitle", "time": 1058.789, "timestamp": "00:17:38", "text": "[音楽]"}, {"type": "subtitle", "time": 1061.99, "timestamp": "00:17:41", "text": "でもあなたの中国語は本当に、"}, {"type": "subtitle", "time": 1066.39, "timestamp": "00:17:46", "text": "完璧。あなたは持っていません"}, {"type": "subtitle", "time": 1068.549, "timestamp": "00:17:48", "text": "ありがとう。ありがとう。うん。うん。あなたの"}, {"type": "subtitle", "time": 1071.59, "timestamp": "00:17:51", "text": "日本語。それもすごく可愛いですね。私は持っています"}, {"type": "subtitle", "time": 1073.07, "timestamp": "00:17:53", "text": "中国語を話します"}]
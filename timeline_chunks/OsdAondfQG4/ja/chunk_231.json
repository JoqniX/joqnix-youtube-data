[{"type": "subtitle", "time": 13861.91, "timestamp": "03:51:01", "text": "マイク。私はまだお金がない。私は自分が"}, {"type": "subtitle", "time": 13864.55, "timestamp": "03:51:04", "text": "バトルとバトルプッシュを購入できます。私"}, {"type": "subtitle", "time": 13867.63, "timestamp": "03:51:07", "text": "実はスキップしようと思っていたんです"}, {"type": "subtitle", "time": 13870.71, "timestamp": "03:51:10", "text": "それ。私も給料をもらっていません。だから私は"}, {"type": "subtitle", "time": 13874.55, "timestamp": "03:51:14", "text": "それは知らなかった。でも、2つ持ってるよ"}, {"type": "subtitle", "time": 13877.99, "timestamp": "03:51:17", "text": "選択肢が今ここにあります。どちらか、えっと、何か、えっと、"}, {"type": "subtitle", "time": 13880.309, "timestamp": "03:51:20", "text": "待ってたよ、モバイルでやるよ"}, {"type": "subtitle", "time": 13882.15, "timestamp": "03:51:22", "text": "このオーディオでこのようにストリーミングします"}, {"type": "subtitle", "time": 13886.99, "timestamp": "03:51:26", "text": "電話のマイク、または"}, {"type": "subtitle", "time": 13890.95, "timestamp": "03:51:30", "text": "えーと、お金が貯まるまで待ってて、えーと"}, {"type": "subtitle", "time": 13894.55, "timestamp": "03:51:34", "text": "どうにかしてお金を稼いで、I を買う"}, {"type": "subtitle", "time": 13897.349, "timestamp": "03:51:37", "text": "2000か3000だったと思う"}, {"type": "subtitle", "time": 13901.429, "timestamp": "03:51:41", "text": "えーとルピー、えーとマイク。つまり、それはマイクで"}, {"type": "subtitle", "time": 13904.71, "timestamp": "03:51:44", "text": "カメラ用のワイヤレスマイクのような"}, {"type": "subtitle", "time": 13907.11, "timestamp": "03:51:47", "text": "AndroidやiPhoneなどと同じように。"}, {"type": "subtitle", "time": 13909.189, "timestamp": "03:51:49", "text": "iPhoneの場合、それは充電のようなものです"}, {"type": "subtitle", "time": 13911.99, "timestamp": "03:51:51", "text": "照明ポートアダプター。だから、"}, {"type": "subtitle", "time": 13915.03, "timestamp": "03:51:55", "text": "なぜ私はそれを選んでいるのだろうか？それは"}, {"type": "subtitle", "time": 13917.51, "timestamp": "03:51:57", "text": "あれには3つのノイズ抑制機能がある"}, {"type": "subtitle", "time": 13919.79, "timestamp": "03:51:59", "text": "レベル。それは"}]
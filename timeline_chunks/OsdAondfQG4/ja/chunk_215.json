[{"type": "subtitle", "time": 12906.91, "timestamp": "03:35:06", "text": "待って。そうでない場合は、"}, {"type": "subtitle", "time": 12916.11, "timestamp": "03:35:16", "text": "この３つ"}, {"type": "subtitle", "time": 12941.95, "timestamp": "03:35:41", "text": "内部。皆さん、一番良い方法は何ですか？私は行く"}, {"type": "subtitle", "time": 12946.99, "timestamp": "03:35:46", "text": "外に出て、そういうことをして、家に帰ってきて、"}, {"type": "subtitle", "time": 12948.83, "timestamp": "03:35:48", "text": "睡眠、覚醒"}, {"type": "subtitle", "time": 12951.469, "timestamp": "03:35:51", "text": "上へ、"}]
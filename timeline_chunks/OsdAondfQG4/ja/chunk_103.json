[{"type": "subtitle", "time": 6180.149, "timestamp": "01:43:00", "text": "それはいいですね。共有観客のようなものでしたか？"}, {"type": "subtitle", "time": 6182.47, "timestamp": "01:43:02", "text": "最初は、そしてあなたは自分の"}, {"type": "subtitle", "time": 6184.709, "timestamp": "01:43:04", "text": "観客"}, {"type": "subtitle", "time": 6191.83, "timestamp": "01:43:11", "text": "なぜなら、彼らは同じようなものをたくさん見せたから"}, {"type": "subtitle", "time": 6193.35, "timestamp": "01:43:13", "text": "YouTube の視聴者の皆さん、"}, {"type": "subtitle", "time": 6196.07, "timestamp": "01:43:16", "text": "知る。うん。"}, {"type": "subtitle", "time": 6199.91, "timestamp": "01:43:19", "text": "ロード・ヘッド・アスのような人たち。おお"}, {"type": "subtitle", "time": 6202.149, "timestamp": "01:43:22", "text": "うん。"}, {"type": "subtitle", "time": 6203.3, "timestamp": "01:43:23", "text": "ハダシュ。"}, {"type": "subtitle", "time": 6204.669, "timestamp": "01:43:24", "text": "[音楽]"}, {"type": "subtitle", "time": 6213.55, "timestamp": "01:43:33", "text": "ああ、確かハラスもここにいたはずだ"}, {"type": "subtitle", "time": 6224.79, "timestamp": "01:43:44", "text": "うん。スミさんと一緒に遊ぶんですか？"}, {"type": "subtitle", "time": 6227.43, "timestamp": "01:43:47", "text": "久しぶりですね。"}, {"type": "subtitle", "time": 6230.709, "timestamp": "01:43:50", "text": "最近はそうではない。私はちょっと下手です"}, {"type": "subtitle", "time": 6234.07, "timestamp": "01:43:54", "text": "例えば、友達と連絡を取り合うことなど。"}, {"type": "subtitle", "time": 6236.31, "timestamp": "01:43:56", "text": "Twitter をチェックしているか、"}, {"type": "subtitle", "time": 6238.95, "timestamp": "01:43:58", "text": "何でもいいけど、私が投稿したように、"}]
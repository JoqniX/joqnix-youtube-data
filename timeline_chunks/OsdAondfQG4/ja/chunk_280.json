[{"type": "subtitle", "time": 16800.788, "timestamp": "04:40:00", "text": "そうそう。うん。この場所の次は、"}, {"type": "subtitle", "time": 16807.788, "timestamp": "04:40:07", "text": "わかった。"}, {"type": "subtitle", "time": 16811.03, "timestamp": "04:40:11", "text": "バイバイ。そこはカニのホームスポットだ。"}, {"type": "subtitle", "time": 16814.99, "timestamp": "04:40:14", "text": "つまり、それは白い色のカニのようなものだ"}, {"type": "subtitle", "time": 16818.47, "timestamp": "04:40:18", "text": "ここ。うん。知らなかった、知らなかった"}, {"type": "subtitle", "time": 16821.19, "timestamp": "04:40:21", "text": "白いカニは存在した。私が知っているのは、"}, {"type": "subtitle", "time": 16823.59, "timestamp": "04:40:23", "text": "赤いカニか何か。それは"}, {"type": "subtitle", "time": 16826.47, "timestamp": "04:40:26", "text": "ロブスター？分かりません。待って、何色？"}, {"type": "subtitle", "time": 16828.11, "timestamp": "04:40:28", "text": "カニは"}, {"type": "subtitle", "time": 16831.91, "timestamp": "04:40:31", "text": "のように？はい、カニゲームはやったことがあります。"}, {"type": "subtitle", "time": 16835.51, "timestamp": "04:40:35", "text": "つまり、赤色ですよね？私は自分の"}, {"type": "subtitle", "time": 16838.708, "timestamp": "04:40:38", "text": "地元の魚市場で買った魚と家での買い物"}, {"type": "subtitle", "time": 16840.948, "timestamp": "04:40:40", "text": "私の家で。まるで彼らはこれを持っているかのようだ"}, {"type": "subtitle", "time": 16844.11, "timestamp": "04:40:44", "text": "茶色または濃い茶色"}, {"type": "subtitle", "time": 16845.788, "timestamp": "04:40:45", "text": "あれ"}, {"type": "subtitle", "time": 16849.03, "timestamp": "04:40:49", "text": "カニを見て、死んだカニを見たと思った"}, {"type": "subtitle", "time": 16853.55, "timestamp": "04:40:53", "text": "赤い成体のカニのように。白人成人死亡なし"}, {"type": "subtitle", "time": 16856.868, "timestamp": "04:40:56", "text": "カニを歩いているとき"}]
[{"type": "subtitle", "time": 13740.83, "timestamp": "03:49:00", "text": "聞こえるかどうかわかりませんが"}, {"type": "subtitle", "time": 13744.229, "timestamp": "03:49:04", "text": "海。海ではない。ああ、ビーチね。えっと、君"}, {"type": "subtitle", "time": 13745.95, "timestamp": "03:49:05", "text": "波を知って"}, {"type": "subtitle", "time": 13748.55, "timestamp": "03:49:08", "text": "もの。あなたは何と呼ぶと思いますか"}, {"type": "subtitle", "time": 13751.55, "timestamp": "03:49:11", "text": "これ？水域、海、"}, {"type": "subtitle", "time": 13754.229, "timestamp": "03:49:14", "text": "右？今日は火曜日ですよね？それは"}, {"type": "subtitle", "time": 13756.95, "timestamp": "03:49:16", "text": "火曜日。だ。こんにちは。"}, {"type": "subtitle", "time": 13760.63, "timestamp": "03:49:20", "text": "おはよう。お元気でお過ごしでしょうか。"}, {"type": "subtitle", "time": 13763.429, "timestamp": "03:49:23", "text": "うん。こんにちは。私の携帯電話はほとんど"}, {"type": "subtitle", "time": 13767.07, "timestamp": "03:49:27", "text": "落とすつもりだ。私は今、"}, {"type": "subtitle", "time": 13769.71, "timestamp": "03:49:29", "text": "靴ひもは右"}, {"type": "subtitle", "time": 13773.269, "timestamp": "03:49:33", "text": "靴のもつれが少しほどけた。いやいや、それは"}, {"type": "subtitle", "time": 13775.07, "timestamp": "03:49:35", "text": "それは何て言うんだっけ？"}, {"type": "subtitle", "time": 13779.429, "timestamp": "03:49:39", "text": "また？靴ひもは、結ぶときに"}, {"type": "subtitle", "time": 13783.469, "timestamp": "03:49:43", "text": "持ち上げると、まるで結び目がほどけるような感じ"}, {"type": "subtitle", "time": 13787.79, "timestamp": "03:49:47", "text": "自体。ベッド。何と呼ぶか"}, {"type": "subtitle", "time": 13789.55, "timestamp": "03:49:49", "text": "それ？良い"}, {"type": "subtitle", "time": 13791.95, "timestamp": "03:49:51", "text": "朝。良い一日をお過ごしください"}, {"type": "subtitle", "time": 13794.83, "timestamp": "03:49:54", "text": "今日。良い一日をお過ごしください。"}, {"type": "subtitle", "time": 13798.55, "timestamp": "03:49:58", "text": "そういう意味では愚かだ。ええ、明日までには"}]
[{"type": "subtitle", "time": 8403.91, "timestamp": "02:20:03", "text": "ええ、彼らはキャリアを築こうとしているんです"}, {"type": "subtitle", "time": 8410.63, "timestamp": "02:20:10", "text": "彼らはロックインしなければならないが、それは戻ってくるだろう"}, {"type": "subtitle", "time": 8413.349, "timestamp": "02:20:13", "text": "後で彼らに痛い目に遭わせる"}, {"type": "subtitle", "time": 8415.19, "timestamp": "02:20:15", "text": "キャリア。"}, {"type": "subtitle", "time": 8417.429, "timestamp": "02:20:17", "text": "えっと"}, {"type": "subtitle", "time": 8420.309, "timestamp": "02:20:20", "text": "だって、君は持っているから、君はそうしなければならないとは言わないよ"}, {"type": "subtitle", "time": 8422.389, "timestamp": "02:20:22", "text": "少し謙虚になるが、"}, {"type": "subtitle", "time": 8424.79, "timestamp": "02:20:24", "text": "頭をしっかり保ちたいなら"}, {"type": "subtitle", "time": 8427.07, "timestamp": "02:20:27", "text": "維持するために"}, {"type": "subtitle", "time": 8431.51, "timestamp": "02:20:31", "text": "良好な広報活動。公共"}, {"type": "subtitle", "time": 8432.95, "timestamp": "02:20:32", "text": "一般公開。良いパブリックを望むなら"}, {"type": "subtitle", "time": 8437.429, "timestamp": "02:20:37", "text": "見る側としては、自分の実力を示さなければならない。"}, {"type": "subtitle", "time": 8439.11, "timestamp": "02:20:39", "text": "あなたは見るに値するほど素晴らしい。あなた"}, {"type": "subtitle", "time": 8440.23, "timestamp": "02:20:40", "text": "私の言いたいこと、分かりますか？人々は望んでいない"}, {"type": "subtitle", "time": 8444.469, "timestamp": "02:20:44", "text": "まるで超狂った邪悪な人間のように見てください。"}, {"type": "subtitle", "time": 8445.51, "timestamp": "02:20:45", "text": "彼らは、"}, {"type": "subtitle", "time": 8446.87, "timestamp": "02:20:46", "text": "実際、共感できるとか、"}, {"type": "subtitle", "time": 8450.75, "timestamp": "02:20:50", "text": "知る？真実。"}, {"type": "subtitle", "time": 8452.79, "timestamp": "02:20:52", "text": "うん。それが私がやろうとしてきたことです"}, {"type": "subtitle", "time": 8453.95, "timestamp": "02:20:53", "text": "最近。"}, {"type": "subtitle", "time": 8456.19, "timestamp": "02:20:56", "text": "私は"}, {"type": "subtitle", "time": 8458.71, "timestamp": "02:20:58", "text": "つまり、ほら、"}]
[{"type": "subtitle", "time": 4382.95, "timestamp": "01:13:02", "text": "マスク。私は自分の"}, {"type": "subtitle", "time": 4387.59, "timestamp": "01:13:07", "text": "ストリートモデルとして活動していたので、私もそうしました。うん。"}, {"type": "subtitle", "time": 4389.99, "timestamp": "01:13:09", "text": "いとこは私と一緒にやってくれるだろうけど、"}, {"type": "subtitle", "time": 4397.83, "timestamp": "01:13:17", "text": "私は、あの、あの"}, {"type": "subtitle", "time": 4402.31, "timestamp": "01:13:22", "text": "日本語のパマセリテとかそんな感じ"}, {"type": "subtitle", "time": 4405.91, "timestamp": "01:13:25", "text": "Amazonから、そしてそれはまるで"}, {"type": "subtitle", "time": 4408.95, "timestamp": "01:13:28", "text": "少し高かったけど、私は"}, {"type": "subtitle", "time": 4413.03, "timestamp": "01:13:33", "text": "「そう、ファッションならやるしかない」って思った"}, {"type": "subtitle", "time": 4415.669, "timestamp": "01:13:35", "text": "そして次に気づいたら"}, {"type": "subtitle", "time": 4418.79, "timestamp": "01:13:38", "text": "起こることは起こるときに起こるし、それは"}, {"type": "subtitle", "time": 4421.189, "timestamp": "01:13:41", "text": "ずっと安いし、バカみたい"}, {"type": "subtitle", "time": 4424.31, "timestamp": "01:13:44", "text": "なぜ私はこんなにお金を使いすぎたのだろう"}, {"type": "subtitle", "time": 4427.03, "timestamp": "01:13:47", "text": "少し値段が高かった"}, {"type": "subtitle", "time": 4431.11, "timestamp": "01:13:51", "text": "シンプルなマスクの場合。ええ、そうでした"}]
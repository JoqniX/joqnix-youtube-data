[{"type": "subtitle", "time": 3721.349, "timestamp": "01:02:01", "text": "私の友達ではない、あなたのアバターは素晴らしい"}, {"type": "subtitle", "time": 3724.95, "timestamp": "01:02:04", "text": "人々に恵みを。あなたはそれを知っています。いいえ、私は"}, {"type": "subtitle", "time": 3728.23, "timestamp": "01:02:08", "text": "それは知らなかった。"}, {"type": "subtitle", "time": 3732.87, "timestamp": "01:02:12", "text": "誰もがアバターを見ることができると思っていた。"}, {"type": "subtitle", "time": 3737.91, "timestamp": "01:02:17", "text": "申し訳ありません、そうしませんでした。わかった。わかった。"}, {"type": "subtitle", "time": 3740.95, "timestamp": "01:02:20", "text": "わかった、気にしないで。あなたの"}, {"type": "subtitle", "time": 3756.63, "timestamp": "01:02:36", "text": "お金を振る。待って、"}, {"type": "subtitle", "time": 3759.91, "timestamp": "01:02:39", "text": "何て言えばいいんだろう？いつも"}, {"type": "subtitle", "time": 3762.63, "timestamp": "01:02:42", "text": "私の心はシャカだ。"}, {"type": "subtitle", "time": 3767.27, "timestamp": "01:02:47", "text": "ああ、そうだね。うん、そうだね"}, {"type": "subtitle", "time": 3772.789, "timestamp": "01:02:52", "text": "[音楽]"}, {"type": "subtitle", "time": 3774.789, "timestamp": "01:02:54", "text": "あなたの言語は？"}, {"type": "subtitle", "time": 3777.589, "timestamp": "01:02:57", "text": "いいえ。いいえ。これは英語です。しかし、"}]
[{"type": "subtitle", "time": 15664.349, "timestamp": "04:21:04", "text": "ええ、それで私は"}, {"type": "subtitle", "time": 15668.71, "timestamp": "04:21:08", "text": "えっと、なんて言うんでしょう？私"}, {"type": "subtitle", "time": 15672.149, "timestamp": "04:21:12", "text": "モヒートみたいな飲み物を買って"}, {"type": "subtitle", "time": 15674.469, "timestamp": "04:21:14", "text": "私が訪れた場所にて。だからお店は"}, {"type": "subtitle", "time": 15677.71, "timestamp": "04:21:17", "text": "閉店しました。彼らは夕方にしか開かない"}, {"type": "subtitle", "time": 15680.229, "timestamp": "04:21:20", "text": "時間。私は一体何時に"}, {"type": "subtitle", "time": 15683.99, "timestamp": "04:21:23", "text": "観光拠点？午後3時か4時頃ですよね？だった"}, {"type": "subtitle", "time": 15687.75, "timestamp": "04:21:27", "text": "5ですか？わからない。確か2時だったと思います。"}, {"type": "subtitle", "time": 15693.07, "timestamp": "04:21:33", "text": "午後3時4分もしくは300分くらい待つ"}, {"type": "subtitle", "time": 15700.429, "timestamp": "04:21:40", "text": "中に。しかし"}, {"type": "subtitle", "time": 15702.189, "timestamp": "04:21:42", "text": "うん、"}, {"type": "subtitle", "time": 15704.63, "timestamp": "04:21:44", "text": "また、あなたの息子はまだ"}, {"type": "subtitle", "time": 15707.51, "timestamp": "04:21:47", "text": "道路沿いではなくビーチサイドだから"}, {"type": "subtitle", "time": 15711.269, "timestamp": "04:21:51", "text": "私は道に迷いたかった。ああ、疲れた。"}, {"type": "subtitle", "time": 15714.389, "timestamp": "04:21:54", "text": "ああ、もう疲れた。私はしたくない"}, {"type": "subtitle", "time": 15717.95, "timestamp": "04:21:57", "text": "行く。掃き掃除ではないが、行きたい"}]
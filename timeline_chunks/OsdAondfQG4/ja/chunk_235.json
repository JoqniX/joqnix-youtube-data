[{"type": "subtitle", "time": 14108.229, "timestamp": "03:55:08", "text": "プレッシャー、えっと、私がやったことは、えっと、"}, {"type": "subtitle", "time": 14111.51, "timestamp": "03:55:11", "text": "ベンチ、座るベンチ。私は足を上げた"}, {"type": "subtitle", "time": 14114.189, "timestamp": "03:55:14", "text": "身を乗り出して、"}, {"type": "subtitle", "time": 14118.15, "timestamp": "03:55:18", "text": "えっと、身を乗り出して、えっと、どうすれば"}, {"type": "subtitle", "time": 14119.229, "timestamp": "03:55:19", "text": "あなたが電話する"}, {"type": "subtitle", "time": 14121.75, "timestamp": "03:55:21", "text": "それ？それは何と呼ばれますか？傾けようとする"}, {"type": "subtitle", "time": 14124.469, "timestamp": "03:55:24", "text": "そして私は靴ひもを試してみた、左側の"}, {"type": "subtitle", "time": 14126.87, "timestamp": "03:55:26", "text": "脚は省略しました。揺れ始めた。"}, {"type": "subtitle", "time": 14128.95, "timestamp": "03:55:28", "text": "「え、何が起きてるの？」って感じだった。何ですか"}, {"type": "subtitle", "time": 14131.95, "timestamp": "03:55:31", "text": "ハプニング？"}, {"type": "subtitle", "time": 14135.11, "timestamp": "03:55:35", "text": "ナンデ、朝は全然そうじゃないと思う"}, {"type": "subtitle", "time": 14138.469, "timestamp": "03:55:38", "text": "風が強い感じで、前回とは違って"}, {"type": "subtitle", "time": 14140.87, "timestamp": "03:55:40", "text": "私たちはツアーに参加し、スペースストリームを配信しました"}, {"type": "subtitle", "time": 14143.71, "timestamp": "03:55:43", "text": "音声ストリーム"}, {"type": "subtitle", "time": 14146.15, "timestamp": "03:55:46", "text": "夕方のツイッターは"}, {"type": "subtitle", "time": 14154.189, "timestamp": "03:55:54", "text": "ビーチで私はちょっと"}, {"type": "subtitle", "time": 14157.03, "timestamp": "03:55:57", "text": "痛みは私の友人のカメラが映すものすべて"}]
[{"type": "subtitle", "time": 12605.269, "timestamp": "03:30:05", "text": "夏。 3つになるよ。私は持っている"}, {"type": "subtitle", "time": 12609.429, "timestamp": "03:30:09", "text": "走る。私は行かなければならない"}, {"type": "subtitle", "time": 12613.11, "timestamp": "03:30:13", "text": "仕立て屋のやつ。ああ、もう死にそうだ"}, {"type": "subtitle", "time": 12616.71, "timestamp": "03:30:16", "text": "内部。寝たい。私は十分持っている"}, {"type": "subtitle", "time": 12618.95, "timestamp": "03:30:18", "text": "寝る。"}, {"type": "subtitle", "time": 12641.389, "timestamp": "03:30:41", "text": "わかった。はい、削除します"}, {"type": "subtitle", "time": 12644.59, "timestamp": "03:30:44", "text": "これ。ああ、それは民主的だ、"}]
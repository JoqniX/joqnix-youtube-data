[{"type": "subtitle", "time": 17040.83, "timestamp": "04:44:00", "text": "疲れた。あなたが知っている"}, {"type": "subtitle", "time": 17043.35, "timestamp": "04:44:03", "text": "何？えっと"}, {"type": "subtitle", "time": 17045.628, "timestamp": "04:44:05", "text": "いつ手に入れるかわかりません"}, {"type": "subtitle", "time": 17048.35, "timestamp": "04:44:08", "text": "朝食を摂ったら、"}, {"type": "subtitle", "time": 17052.23, "timestamp": "04:44:12", "text": "朝食なので、家に帰るとすぐに"}, {"type": "subtitle", "time": 17055.51, "timestamp": "04:44:15", "text": "さて、最新の家に戻って、私は"}, {"type": "subtitle", "time": 17058.83, "timestamp": "04:44:18", "text": "お風呂に入る。私はこうやって行く、食べる"}, {"type": "subtitle", "time": 17061.91, "timestamp": "04:44:21", "text": "朝食、またこんな風に出てくる、"}, {"type": "subtitle", "time": 17064.47, "timestamp": "04:44:24", "text": "シートに浸かるが、今回は"}, {"type": "subtitle", "time": 17067.19, "timestamp": "04:44:27", "text": "ちなみに、スリッパを履いています。水に浸かる"}, {"type": "subtitle", "time": 17070.948, "timestamp": "04:44:30", "text": "シーツを敷いて家まで歩いて帰る間"}, {"type": "subtitle", "time": 17089.43, "timestamp": "04:44:49", "text": "場所。ねえ、写真を撮ろうか"}, {"type": "subtitle", "time": 17092.948, "timestamp": "04:44:52", "text": "それって私のこと？でも君たちはできない"}, {"type": "subtitle", "time": 17099.35, "timestamp": "04:44:59", "text": "貨物船か何かに乗ろう。そして"}]
[{"type": "subtitle", "time": 3120.87, "timestamp": "00:52:00", "text": "人間みたいに。ああ、人が"}, {"type": "subtitle", "time": 3139.829, "timestamp": "00:52:19", "text": "ロシア。わからない。"}, {"type": "subtitle", "time": 3142.39, "timestamp": "00:52:22", "text": "ロシア語のように聞こえる。わからない。"}, {"type": "subtitle", "time": 3155.069, "timestamp": "00:52:35", "text": "したい"}, {"type": "subtitle", "time": 3157.23, "timestamp": "00:52:37", "text": "話題は"}, {"type": "subtitle", "time": 3160.39, "timestamp": "00:52:40", "text": "ロシア。 Hideがチャットにいたら"}, {"type": "subtitle", "time": 3162.23, "timestamp": "00:52:42", "text": "今、私は彼にいくつか頼むことができた"}, {"type": "subtitle", "time": 3165.109, "timestamp": "00:52:45", "text": "ロシア語で何か言うこと。"}, {"type": "subtitle", "time": 3166.109, "timestamp": "00:52:46", "text": "話す"}, {"type": "subtitle", "time": 3171.43, "timestamp": "00:52:51", "text": "話している。話し続けてください。わかった。"}, {"type": "subtitle", "time": 3178.549, "timestamp": "00:52:58", "text": "あなたたち二人は話し続けてください。"}]
[{"type": "subtitle", "time": 3181.99, "timestamp": "00:53:01", "text": "うん。そして私は知っている、私は知っている、私は知っている"}, {"type": "subtitle", "time": 3204.309, "timestamp": "00:53:24", "text": "おお、いいね。 IA。"}, {"type": "subtitle", "time": 3207.829, "timestamp": "00:53:27", "text": "ああ、あなたはどこから来たのですか？から"}, {"type": "subtitle", "time": 3217.349, "timestamp": "00:53:37", "text": "私はインド出身です。はい、私は中国出身です。"}, {"type": "subtitle", "time": 3234.79, "timestamp": "00:53:54", "text": "インド。私たちは何て言うのか分からない"}, {"type": "subtitle", "time": 3237.91, "timestamp": "00:53:57", "text": "インド。うん。うん。言い方 言い方"}]
[{"type": "subtitle", "time": 14880.71, "timestamp": "04:08:00", "text": "ああ、犬が私についてきている。私は"}, {"type": "subtitle", "time": 14882.79, "timestamp": "04:08:02", "text": "怖がった。それらは影響を与えている。ああ、"}, {"type": "subtitle", "time": 14885.75, "timestamp": "04:08:05", "text": "神。何てことだ。ああ、なんてことだ、私は"}, {"type": "subtitle", "time": 14887.55, "timestamp": "04:08:07", "text": "怖がった。私は怖いです。私は怖いです。"}, {"type": "subtitle", "time": 14890.16, "timestamp": "04:08:10", "text": "来る。彼らは見ている"}, {"type": "subtitle", "time": 14892.51, "timestamp": "04:08:12", "text": "[音楽]"}, {"type": "subtitle", "time": 14895.99, "timestamp": "04:08:15", "text": "自分。ああ、犬が5匹もいる。いいえ、6です。 1 2"}, {"type": "subtitle", "time": 14899.269, "timestamp": "04:08:19", "text": "3 4 5 6。 7人。犬はただ"}, {"type": "subtitle", "time": 14902.75, "timestamp": "04:08:22", "text": "私をじっと見つめている。うん。"}, {"type": "subtitle", "time": 14905.309, "timestamp": "04:08:25", "text": "さよなら。おお"}, {"type": "subtitle", "time": 14912.87, "timestamp": "04:08:32", "text": "ボート。これで終わりです。わかった。私は思う"}, {"type": "subtitle", "time": 14915.429, "timestamp": "04:08:35", "text": "ここは漁師たちが"}, {"type": "subtitle", "time": 14917.79, "timestamp": "04:08:37", "text": "ボートや物、網や"}, {"type": "subtitle", "time": 14920.469, "timestamp": "04:08:40", "text": "もの。待って、なぜあなたが持っていると書いてあるの？"}, {"type": "subtitle", "time": 14923.59, "timestamp": "04:08:43", "text": "携帯電話の50％を使用しましたか？え、何？"}, {"type": "subtitle", "time": 14925.72, "timestamp": "04:08:45", "text": "え、何？ 何？出かけるときにインターネットが必要です"}, {"type": "subtitle", "time": 14928.479, "timestamp": "04:08:48", "text": "何？出かけるときにインターネットが必要です 戻る。何てことだ。私をからかってるの"}, {"type": "subtitle", "time": 14931.439, "timestamp": "04:08:51", "text": "戻る。何てことだ。私をからかってるの 右"}, {"type": "subtitle", "time": 14933.0, "timestamp": "04:08:53", "text": "右 今？冗談でしょう？それで"}, {"type": "subtitle", "time": 14936.72, "timestamp": "04:08:56", "text": "今？冗談でしょう？それで つまり、私が電車に戻ると、"}, {"type": "subtitle", "time": 14939.84, "timestamp": "04:08:59", "text": "つまり、私が電車に戻ると、 電
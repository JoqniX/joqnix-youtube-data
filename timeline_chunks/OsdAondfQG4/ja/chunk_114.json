[{"type": "subtitle", "time": 6840.31, "timestamp": "01:54:00", "text": "私もカスタムが欲しい"}, {"type": "subtitle", "time": 6842.79, "timestamp": "01:54:02", "text": "私もカスタムキーボードが欲しいです。私は使用しています"}, {"type": "subtitle", "time": 6845.27, "timestamp": "01:54:05", "text": "カスタムビデオを視聴したことを覚えておくために、"}, {"type": "subtitle", "time": 6848.629, "timestamp": "01:54:08", "text": "カスタムキーボードのビデオ、構築、そして私は"}, {"type": "subtitle", "time": 6852.149, "timestamp": "01:54:12", "text": "それから、それを全部セットアップする"}, {"type": "subtitle", "time": 6853.669, "timestamp": "01:54:13", "text": "回路基板から"}, {"type": "subtitle", "time": 6855.669, "timestamp": "01:54:15", "text": "傷"}, {"type": "subtitle", "time": 6859.91, "timestamp": "01:54:19", "text": "そして、すべてのキーに潤滑油を塗布します。"}, {"type": "subtitle", "time": 6862.47, "timestamp": "01:54:22", "text": "必要なキーの種類を選択する"}, {"type": "subtitle", "time": 6871.31, "timestamp": "01:54:31", "text": "私はそれがあなたを満足させることを理解しています、"}, {"type": "subtitle", "time": 6874.669, "timestamp": "01:54:34", "text": "作って満足して、"}, {"type": "subtitle", "time": 6879.35, "timestamp": "01:54:39", "text": "それはあなたの創造物です。"}, {"type": "subtitle", "time": 6882.95, "timestamp": "01:54:42", "text": "うん、キーキャップを変えるのは"}, {"type": "subtitle", "time": 6885.35, "timestamp": "01:54:45", "text": "それだけで誇りに思うには十分だ"}, {"type": "subtitle", "time": 6893.99, "timestamp": "01:54:53", "text": "どんなキーボードがお好みですか？あなた"}, {"type": "subtitle", "time": 6896.86, "timestamp": "01:54:56", "text": "カチッと音がするものが好きですか？それとも柔らかいものですか？"}]
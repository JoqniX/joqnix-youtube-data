[{"type": "subtitle", "time": 16024.349, "timestamp": "04:27:04", "text": "何でも、私は本当にめったにしないから"}, {"type": "subtitle", "time": 16027.71, "timestamp": "04:27:07", "text": "それ。そう、ある意味それは超"}, {"type": "subtitle", "time": 16032.11, "timestamp": "04:27:12", "text": "私のような人間が実際に"}, {"type": "subtitle", "time": 16034.87, "timestamp": "04:27:14", "text": "うわあ、あなたは100％使いました"}, {"type": "subtitle", "time": 16042.309, "timestamp": "04:27:22", "text": "以上。そうですね、それはちょっと珍しいことです"}, {"type": "subtitle", "time": 16044.79, "timestamp": "04:27:24", "text": "実際に私に"}, {"type": "subtitle", "time": 16047.55, "timestamp": "04:27:27", "text": "えっと、歩く"}, {"type": "subtitle", "time": 16050.87, "timestamp": "04:27:30", "text": "えっと、なんて呼ぶんだっけ？私は行くのか"}, {"type": "subtitle", "time": 16052.99, "timestamp": "04:27:32", "text": "正しい方向ですか？私はとても"}, {"type": "subtitle", "time": 16054.91, "timestamp": "04:27:34", "text": "混乱した。全て"}, {"type": "subtitle", "time": 16057.229, "timestamp": "04:27:37", "text": "右。でも、私は一度も"}, {"type": "subtitle", "time": 16060.83, "timestamp": "04:27:40", "text": "ああ、なんてことだ、砂がすごく重い"}, {"type": "subtitle", "time": 16064.229, "timestamp": "04:27:44", "text": "歩く。私はとても疲れている。"}, {"type": "subtitle", "time": 16067.55, "timestamp": "04:27:47", "text": "ものすごく汗をかいている。私は必要としている"}, {"type": "subtitle", "time": 16071.349, "timestamp": "04:27:51", "text": "水が欲しいのですが、水を買うことができません。私は私です"}, {"type": "subtitle", "time": 16072.91, "timestamp": "04:27:52", "text": "私の壁は取らなかった"}, {"type": "subtitle", "time": 16079.95, "timestamp": "04:27:59", "text": "上。ああ、これはまずい。ああ神様、助けて"}]
[{"type": "subtitle", "time": 8821.309, "timestamp": "02:27:01", "text": "配信を続けるべきだった"}, {"type": "subtitle", "time": 8823.75, "timestamp": "02:27:03", "text": "私はたくさんのことを経験していたから"}, {"type": "subtitle", "time": 8825.95, "timestamp": "02:27:05", "text": "戻る"}, {"type": "subtitle", "time": 8829.07, "timestamp": "02:27:09", "text": "それから。しかし今は"}, {"type": "subtitle", "time": 8832.95, "timestamp": "02:27:12", "text": "今まさにやっているところです。"}, {"type": "subtitle", "time": 8835.99, "timestamp": "02:27:15", "text": "それはすばらしい。"}, {"type": "subtitle", "time": 8837.97, "timestamp": "02:27:17", "text": "確かに。"}, {"type": "subtitle", "time": 8843.59, "timestamp": "02:27:23", "text": "待って。えっと、ゲームはできましたか？"}, {"type": "subtitle", "time": 8846.95, "timestamp": "02:27:26", "text": "キキと一緒？キキアキラ？覚えていますか"}, {"type": "subtitle", "time": 8852.15, "timestamp": "02:27:32", "text": "彼女？知りませんでした。"}, {"type": "subtitle", "time": 8855.87, "timestamp": "02:27:35", "text": "私はキキに連絡を取りたかったのですが、"}, {"type": "subtitle", "time": 8858.55, "timestamp": "02:27:38", "text": "でも、彼女のプロフィールを見たんです。私は実際には"}, {"type": "subtitle", "time": 8861.75, "timestamp": "02:27:41", "text": "彼らとできるだけたくさん話してください。うん。"}, {"type": "subtitle", "time": 8863.83, "timestamp": "02:27:43", "text": "私は彼らを観察している。私は彼らとは話していません。"}, {"type": "subtitle", "time": 8866.83, "timestamp": "02:27:46", "text": "うん、私も。久しぶりですね"}, {"type": "subtitle", "time": 8870.15, "timestamp": "02:27:50", "text": "今。彼らのプロフィールにコラボ投稿があったのを見ました"}, {"type": "subtitle", "time": 8873.03, "timestamp": "02:27:53", "text": "閉まっていたので、「いや、"}]
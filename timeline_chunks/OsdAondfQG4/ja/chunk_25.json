[{"type": "subtitle", "time": 1500.47, "timestamp": "00:25:00", "text": "[音楽]"}, {"type": "subtitle", "time": 1511.909, "timestamp": "00:25:11", "text": "これ。大丈夫だと言えますか？うん、君"}, {"type": "subtitle", "time": 1515.59, "timestamp": "00:25:15", "text": "中国語で言うことができます。理解する？"}, {"type": "subtitle", "time": 1518.39, "timestamp": "00:25:18", "text": "理解しようと努めます。ああ、ポアンは"}, {"type": "subtitle", "time": 1521.83, "timestamp": "00:25:21", "text": "彼女が翻訳できるなら、お願いできますか？うん、そうなるよ"}, {"type": "subtitle", "time": 1524.39, "timestamp": "00:25:24", "text": "大丈夫だよ。"}, {"type": "subtitle", "time": 1528.029, "timestamp": "00:25:28", "text": "ああ、私は自分の"}, {"type": "subtitle", "time": 1533.43, "timestamp": "00:25:33", "text": "目標を信じるのが最善"}, {"type": "subtitle", "time": 1542.23, "timestamp": "00:25:42", "text": "コライダーをオフにするにはどうすればいいですか？"}, {"type": "subtitle", "time": 1550.43, "timestamp": "00:25:50", "text": "について"}]
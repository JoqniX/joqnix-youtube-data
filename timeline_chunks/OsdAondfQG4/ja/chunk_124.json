[{"type": "subtitle", "time": 7442.51, "timestamp": "02:04:02", "text": "ドルを知っていれば、"}, {"type": "subtitle", "time": 7445.27, "timestamp": "02:04:05", "text": "濡れているように"}, {"type": "subtitle", "time": 7449.27, "timestamp": "02:04:09", "text": "えっと、なんていう名前ですか？何、何を、何をする"}, {"type": "subtitle", "time": 7451.91, "timestamp": "02:04:11", "text": "英語では何て言うの？"}, {"type": "subtitle", "time": 7454.149, "timestamp": "02:04:14", "text": "レオン。"}, {"type": "subtitle", "time": 7457.43, "timestamp": "02:04:17", "text": "えっと、レクロンって言いましたよね。"}, {"type": "subtitle", "time": 7459.669, "timestamp": "02:04:19", "text": "レオン。"}, {"type": "subtitle", "time": 7462.95, "timestamp": "02:04:22", "text": "いや、いや、待って。えーっと、それは、"}, {"type": "subtitle", "time": 7465.03, "timestamp": "02:04:25", "text": "ガロではサボンと呼ばれている。わからない"}, {"type": "subtitle", "time": 7467.95, "timestamp": "02:04:27", "text": "英語では何と言うのか。まるで"}, {"type": "subtitle", "time": 7472.709, "timestamp": "02:04:32", "text": "濡れた鼻くそか何か。えっと"}, {"type": "subtitle", "time": 7476.39, "timestamp": "02:04:36", "text": "濡れた鼻くそではないが、えっと、濡れている"}, {"type": "chat", "time": 7481.906, "timestamp": "02:04:41", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "snot"}, {"type": "subtitle", "time": 7483.109, "timestamp": "02:04:43", "text": "鼻が濡れる。"}, {"type": "subtitle", "time": 7486.39, "timestamp": "02:04:46", "text": "そう、鼻水みたいな感じ。鼻水。"}, {"type": "chat", "time": 7487.865, "timestamp": "02:04:47", "author": "@kaiguyniki", "avatar": "https://yt4.ggpht.com/f9aZERpOc1bv1JDUl12ZTXeQ7j1KdXBflkbl-6qlBLzM-hbbEQKWUlPpcJJxTU-qSUwNxrez=s64-c-k-c0x00ffffff-no-rj", "message": "mucus?"}, {"type": "subtitle", "time": 7489.109, "timestamp": "02:04:49", "text": "ああ、鼻水。うん、赤い鼻だね。その"}, {"type": "subtitle", "time": 7492.31, "timestamp": "02:04:52", "text": "ない。はい、どうぞ。ええ、それは"}, {"type": "subtitle", "time": 7496.55, "timestamp": "02:04:56", "text": "鼻水。そうそう。鼻水。うん。"}, {"type": "subtitle", "time": 7498.91, "timestamp": "02:04:58", "text": "わかった。なぜなら"}]
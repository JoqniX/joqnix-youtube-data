[{"type": "subtitle", "time": 16921.03, "timestamp": "04:42:01", "text": "家に帰る準備をしてください。うん。えっと"}, {"type": "subtitle", "time": 16924.59, "timestamp": "04:42:04", "text": "午後3時までに電車に乗ってください。それら全て"}, {"type": "subtitle", "time": 16928.31, "timestamp": "04:42:08", "text": "悪ふざけ。泳いで楽しもうとしました"}, {"type": "subtitle", "time": 16931.35, "timestamp": "04:42:11", "text": "だって、私にはそれができなかったから。これこれ"}, {"type": "subtitle", "time": 16934.55, "timestamp": "04:42:14", "text": "ここに来て。私がしたことは、ただ、"}, {"type": "subtitle", "time": 16939.03, "timestamp": "04:42:19", "text": "家にいる。私はいつものようにするのが好きです"}, {"type": "subtitle", "time": 16942.31, "timestamp": "04:42:22", "text": "家でやっていること、遊んでいること"}, {"type": "subtitle", "time": 16946.47, "timestamp": "04:42:26", "text": "電話してアニメを見る"}, {"type": "subtitle", "time": 16948.27, "timestamp": "04:42:28", "text": "それ"}, {"type": "subtitle", "time": 16953.11, "timestamp": "04:42:33", "text": "ハンガリーのものをいじったり遊んだりする。何てことだ。"}, {"type": "subtitle", "time": 16954.948, "timestamp": "04:42:34", "text": "ああ、そういえば、私は"}, {"type": "subtitle", "time": 16957.39, "timestamp": "04:42:37", "text": "毎日のパロディ。そうします"}, {"type": "subtitle", "time": 16965.628, "timestamp": "04:42:45", "text": "待て、あの女が少し残したぞ。"}, {"type": "subtitle", "time": 16969.23, "timestamp": "04:42:49", "text": "待って、私は目的地に着いたと思う"}, {"type": "subtitle", "time": 16972.708, "timestamp": "04:42:52", "text": "また。今回は、あのねえ、"}, {"type": "subtitle", "time": 16975.39, "timestamp": "04:42:55", "text": "少し座った方がいいな。それから私は"}]
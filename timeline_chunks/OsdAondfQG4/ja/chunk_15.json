[{"type": "subtitle", "time": 902.47, "timestamp": "00:15:02", "text": "えっと、スクリーンショットを撮ってるだけなんです"}, {"type": "subtitle", "time": 905.67, "timestamp": "00:15:05", "text": "そうすれば、後から世の中に溶け込める。それ"}, {"type": "subtitle", "time": 909.189, "timestamp": "00:15:09", "text": "彼らはすぐに死ぬように死ぬだろう"}, {"type": "subtitle", "time": 911.67, "timestamp": "00:15:11", "text": "うん、実際に取ってみるべきだね"}, {"type": "subtitle", "time": 921.59, "timestamp": "00:15:21", "text": "なぜなら、私たちはそれが"}, {"type": "subtitle", "time": 923.829, "timestamp": "00:15:23", "text": "ラクナ、元気かい？"}, {"type": "subtitle", "time": 926.949, "timestamp": "00:15:26", "text": "お元気でお過ごしでしょうか。私は"}, {"type": "subtitle", "time": 929.59, "timestamp": "00:15:29", "text": "通信する。バカ、"}, {"type": "subtitle", "time": 933.11, "timestamp": "00:15:33", "text": "学びたいなら、行ってもいいですよ。"}, {"type": "subtitle", "time": 934.949, "timestamp": "00:15:34", "text": "うん、"}, {"type": "subtitle", "time": 941.35, "timestamp": "00:15:41", "text": "この壁をお勧めいただき、ありがとうございます。"}, {"type": "subtitle", "time": 945.509, "timestamp": "00:15:45", "text": "それは本当に大きな意味があります。手を挙げて。"}, {"type": "subtitle", "time": 950.31, "timestamp": "00:15:50", "text": "[音楽]"}, {"type": "subtitle", "time": 952.269, "timestamp": "00:15:52", "text": "私は学びたい"}, {"type": "subtitle", "time": 955.11, "timestamp": "00:15:55", "text": "日本語ですが、中国語もたくさんあります"}, {"type": "subtitle", "time": 959.23, "timestamp": "00:15:59", "text": "友達。ああ、いいね。今私は"}]
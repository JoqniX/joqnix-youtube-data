[{"type": "subtitle", "time": 14821.59, "timestamp": "04:07:01", "text": "長い道のり。私は"}, {"type": "subtitle", "time": 14824.03, "timestamp": "04:07:04", "text": "徒歩圏内"}, {"type": "subtitle", "time": 14827.99, "timestamp": "04:07:07", "text": "でも、私は長い散歩をした。何てことだ。"}, {"type": "subtitle", "time": 14830.469, "timestamp": "04:07:10", "text": "それはいいです。今日の私の目標は"}, {"type": "subtitle", "time": 14833.83, "timestamp": "04:07:13", "text": "ビーチショーの終わりに到達し、"}, {"type": "subtitle", "time": 14836.71, "timestamp": "04:07:16", "text": "触ってみて、でも青い本体だけを触ってみて"}, {"type": "subtitle", "time": 14839.59, "timestamp": "04:07:19", "text": "それは私の目の前にあります。でも私はただ"}, {"type": "subtitle", "time": 14841.59, "timestamp": "04:07:21", "text": "必要であれば少しだけ"}, {"type": "subtitle", "time": 14845.11, "timestamp": "04:07:25", "text": "この浜辺の端に触れてください。えっと、これ"}, {"type": "subtitle", "time": 14846.269, "timestamp": "04:07:26", "text": "曲線"}, {"type": "subtitle", "time": 14849.75, "timestamp": "04:07:29", "text": "島のような見た目"}, {"type": "subtitle", "time": 14851.91, "timestamp": "04:07:31", "text": "私の目の前に。でも写真を撮っておこう"}, {"type": "subtitle", "time": 14853.229, "timestamp": "04:07:33", "text": "の"}, {"type": "subtitle", "time": 14856.429, "timestamp": "04:07:36", "text": "それ。文字通り"}, {"type": "subtitle", "time": 14858.429, "timestamp": "04:07:38", "text": "島。"}, {"type": "subtitle", "time": 14860.429, "timestamp": "04:07:40", "text": "おお。"}, {"type": "subtitle", "time": 14863.349, "timestamp": "04:07:43", "text": "ショア。待って、2倍にするべき？"}, {"type": "subtitle", "time": 14864.67, "timestamp": "04:07:44", "text": "ズーム"}, {"type": "subtitle", "time": 14868.67, "timestamp": "04:07:48", "text": "あれ。ああ神様、犬が歩いている"}, {"type": "subtitle", "time": 14871.99, "timestamp": "04:07:51", "text": "自分。私は安全ですか？"}, {"type": "subtitle", "time": 14873.71, "timestamp": "04:07:53", "text": "おい"}, {"type": "subtitle", "time": 14878.15, "timestamp": "04:07:58", "text": "よお。ああ、犬が私についてきている。"}]
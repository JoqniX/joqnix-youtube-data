[{"type": "subtitle", "time": 7923.27, "timestamp": "02:12:03", "text": "たぶん、昔やっていたことをやっている"}, {"type": "subtitle", "time": 7925.189, "timestamp": "02:12:05", "text": "以前はTwitterスペースを作ろうとしていました。これ"}, {"type": "subtitle", "time": 7927.03, "timestamp": "02:12:07", "text": "私が本当に成長していた頃の話です"}, {"type": "subtitle", "time": 7931.43, "timestamp": "02:12:11", "text": "TikTokやTwitterでTについて速く話すか話さないか。おお、"}, {"type": "subtitle", "time": 7937.51, "timestamp": "02:12:17", "text": "異常に速い。やり方がわからない"}, {"type": "subtitle", "time": 7939.47, "timestamp": "02:12:19", "text": "説明する"}, {"type": "subtitle", "time": 7943.229, "timestamp": "02:12:23", "text": "それ。そして3日後には"}, {"type": "subtitle", "time": 7946.069, "timestamp": "02:12:26", "text": "フォロワー数1,500人。そして速度が落ちた"}, {"type": "subtitle", "time": 7954.629, "timestamp": "02:12:34", "text": "私にとっては速いです。わかった。私は知っています"}, {"type": "subtitle", "time": 7956.589, "timestamp": "02:12:36", "text": "人々が"}, {"type": "subtitle", "time": 7960.55, "timestamp": "02:12:40", "text": "1日にそれ以上かな。まあ、そうだね。"}, {"type": "subtitle", "time": 7967.35, "timestamp": "02:12:47", "text": "それはできません。それはやりすぎだ。"}, {"type": "subtitle", "time": 7975.91, "timestamp": "02:12:55", "text": "今度はみんなが人を蹴り飛ばすようになる"}]
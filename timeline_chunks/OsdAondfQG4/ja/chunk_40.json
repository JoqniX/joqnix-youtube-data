[{"type": "subtitle", "time": 2401.109, "timestamp": "00:40:01", "text": "待って、息子は出て行った。こんにちは。ああ、彼はあそこにいる。"}, {"type": "subtitle", "time": 2403.67, "timestamp": "00:40:03", "text": "わかった。ああ、彼はもうすぐ出発するよ。ああ、わかりました。"}, {"type": "subtitle", "time": 2405.829, "timestamp": "00:40:05", "text": "わかった。"}, {"type": "subtitle", "time": 2407.67, "timestamp": "00:40:07", "text": "右。"}, {"type": "subtitle", "time": 2409.109, "timestamp": "00:40:09", "text": "あなたのガールフレンドは別の男性と話しています"}, {"type": "subtitle", "time": 2412.23, "timestamp": "00:40:12", "text": "男。それはあなたの仕事であり、あなたの得意分野だからです。"}, {"type": "subtitle", "time": 2413.829, "timestamp": "00:40:13", "text": "君の彼女が何かをしている"}, {"type": "subtitle", "time": 2418.23, "timestamp": "00:40:18", "text": "それ以外。私は彼らに依頼を送ります。羨ましい。"}, {"type": "subtitle", "time": 2419.91, "timestamp": "00:40:19", "text": "つまり、あなたは何かを見逃しているということです。"}, {"type": "subtitle", "time": 2432.069, "timestamp": "00:40:32", "text": "わかった。うん。気をつけて。ありがとうございます"}, {"type": "subtitle", "time": 2434.71, "timestamp": "00:40:34", "text": "私たちと話す。本当に光栄でした。"}, {"type": "subtitle", "time": 2436.95, "timestamp": "00:40:36", "text": "ありがとう。"}, {"type": "subtitle", "time": 2439.75, "timestamp": "00:40:39", "text": "また近いうちに会いましょう。"}, {"type": "subtitle", "time": 2441.349, "timestamp": "00:40:41", "text": "バイバイ。"}, {"type": "subtitle", "time": 2458.23, "timestamp": "00:40:58", "text": "ええ、本当にたくさんの人がいますね。私は"}]
[{"type": "subtitle", "time": 12547.269, "timestamp": "03:29:07", "text": "もし私が壊れることができたら、私は心の中で死んでしまうだろう"}, {"type": "subtitle", "time": 12549.07, "timestamp": "03:29:09", "text": "私の記録"}, {"type": "subtitle", "time": 12554.83, "timestamp": "03:29:14", "text": "今日やるか、やらないか、どちらかを選べ。何をすべきか"}, {"type": "subtitle", "time": 12557.79, "timestamp": "03:29:17", "text": "する？できました"}, {"type": "subtitle", "time": 12559.95, "timestamp": "03:29:19", "text": "できる"}, {"type": "subtitle", "time": 12563.67, "timestamp": "03:29:23", "text": "2つ入れる、もう1つコラボを入れることもできる"}, {"type": "subtitle", "time": 12565.07, "timestamp": "03:29:25", "text": "パートナー"}, {"type": "subtitle", "time": 12568.87, "timestamp": "03:29:28", "text": "今夜は真夜中のように。"}, {"type": "subtitle", "time": 12577.349, "timestamp": "03:29:37", "text": "以上。完全に終わったわけではないし、あるいは私は"}, {"type": "subtitle", "time": 12581.55, "timestamp": "03:29:41", "text": "たぶんそれを着せる"}, {"type": "subtitle", "time": 12583.75, "timestamp": "03:29:43", "text": "日曜日。いや、いや、いや、いや、いや、いや、いや。"}, {"type": "subtitle", "time": 12586.309, "timestamp": "03:29:46", "text": "日曜日のコードはそこにあります。いや、いや、いや。うん、"}, {"type": "subtitle", "time": 12589.429, "timestamp": "03:29:49", "text": "日曜日。待って。ええ、日曜日も"}, {"type": "subtitle", "time": 12591.389, "timestamp": "03:29:51", "text": "金曜日。"}]
[{"type": "subtitle", "time": 17101.27, "timestamp": "04:45:01", "text": "右側には目に見える"}, {"type": "subtitle", "time": 17102.51, "timestamp": "04:45:02", "text": "漁師"}, {"type": "subtitle", "time": 17118.708, "timestamp": "04:45:18", "text": "神。データを完成させる前に、"}, {"type": "subtitle", "time": 17120.868, "timestamp": "04:45:20", "text": "家に帰る。使用中にデータが必要です"}, {"type": "subtitle", "time": 17125.67, "timestamp": "04:45:25", "text": "電車。 4時間くらいかかる道のりです。"}, {"type": "subtitle", "time": 17137.11, "timestamp": "04:45:37", "text": "ああ、神様、これは本当に大きな岩です。私"}, {"type": "subtitle", "time": 17139.75, "timestamp": "04:45:39", "text": "転落死するかもしれない。死ぬことを想像してみて"}, {"type": "subtitle", "time": 17141.788, "timestamp": "04:45:41", "text": "これらの岩を通り抜けて。おお、"}, {"type": "subtitle", "time": 17149.47, "timestamp": "04:45:49", "text": "悪い。おお"}, {"type": "subtitle", "time": 17152.708, "timestamp": "04:45:52", "text": "神。私はどちらの方向から来たのだろうか？私はそうは思わない"}, {"type": "subtitle", "time": 17154.708, "timestamp": "04:45:54", "text": "知る。"}, {"type": "subtitle", "time": 17156.59, "timestamp": "04:45:56", "text": "聖なる神よ、"}, {"type": "subtitle", "time": 17159.67, "timestamp": "04:45:59", "text": "自分。ああ、かっこいいですね、本当に"}]
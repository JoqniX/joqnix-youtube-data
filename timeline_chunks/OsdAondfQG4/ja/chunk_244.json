[{"type": "subtitle", "time": 14641.03, "timestamp": "04:04:01", "text": "また。でも、気をつけなければならない。"}, {"type": "subtitle", "time": 14644.309, "timestamp": "04:04:04", "text": "それは文字通り痛みだ。また、このUIは"}, {"type": "subtitle", "time": 14646.95, "timestamp": "04:04:06", "text": "このStreamlabsっていうのは、ちょっと"}, {"type": "subtitle", "time": 14649.99, "timestamp": "04:04:09", "text": "気難しい。私は３つに行かなければならない"}, {"type": "subtitle", "time": 14654.229, "timestamp": "04:04:14", "text": "えーと、ハンバーガーメニュー、クリックして"}, {"type": "subtitle", "time": 14657.67, "timestamp": "04:04:17", "text": "シーンと編集、シーンをクリック"}, {"type": "subtitle", "time": 14659.67, "timestamp": "04:04:19", "text": "編集する必要があるものです。次にクリックします"}, {"type": "subtitle", "time": 14661.91, "timestamp": "04:04:21", "text": "もの。ほら、私はスライドしないといけない"}, {"type": "subtitle", "time": 14665.189, "timestamp": "04:04:25", "text": "サーバーを右クリックして、"}, {"type": "subtitle", "time": 14668.389, "timestamp": "04:04:28", "text": "えっと、配信とかでは見せないでね。"}, {"type": "subtitle", "time": 14670.59, "timestamp": "04:04:30", "text": "聞いてみれば、それは一種の痛みだ"}, {"type": "subtitle", "time": 14675.51, "timestamp": "04:04:35", "text": "自分。でも、もし私がそうしたら、私の"}, {"type": "subtitle", "time": 14679.91, "timestamp": "04:04:39", "text": "稼働時間カウンターは、えっと、"}, {"type": "subtitle", "time": 14682.469, "timestamp": "04:04:42", "text": "ストリーミング配信を始めてどれくらい経ったか、"}, {"type": "subtitle", "time": 14684.55, "timestamp": "04:04:44", "text": "それはバグを起こすだろう。わからない"}, {"type": "subtitle", "time": 14686.95, "timestamp": "04:04:46", "text": "なぜ。バグか何かですね。"}, {"type": "subtitle", "time": 14687.87, "timestamp": "04:04:47", "text": "なぜできないのか"}, {"type": "subtitle", "time": 14691.75, "timestamp": "04:04:51", "text": "私？ええ、そうですね。"}, {"type": "subtitle", "time": 14693.51, "timestamp": "04:04:53", "text": "でも、まだできるかどうかはわかりません"}, {"type": "subtitle", "time": 14697.389, "timestamp": "04:04:57", "text": "海の音が聞こえる、ああ、ああ"}]
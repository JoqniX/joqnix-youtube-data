[{"type": "subtitle", "time": 16567.029, "timestamp": "04:36:07", "text": "何をしているの？朝の散歩はどうですか？私は"}, {"type": "subtitle", "time": 16569.269, "timestamp": "04:36:09", "text": "文字通り死にそう"}, {"type": "subtitle", "time": 16572.51, "timestamp": "04:36:12", "text": "海辺を散歩する。ビーチ"}, {"type": "subtitle", "time": 16576.47, "timestamp": "04:36:16", "text": "砂とか色々ある場所。"}, {"type": "subtitle", "time": 16580.59, "timestamp": "04:36:20", "text": "私たちは海の端まで行きました"}, {"type": "subtitle", "time": 16582.869, "timestamp": "04:36:22", "text": "ビーチのほぼ端にあるもの"}, {"type": "subtitle", "time": 16585.109, "timestamp": "04:36:25", "text": "あれ。大きな漁船があった"}, {"type": "subtitle", "time": 16586.869, "timestamp": "04:36:26", "text": "あるいは、そんな感じ。ああ、神様。水。待って待って"}, {"type": "subtitle", "time": 16589.189, "timestamp": "04:36:29", "text": "待って待って待って。上へ行かせてください。放してくれ"}, {"type": "subtitle", "time": 16593.47, "timestamp": "04:36:33", "text": "左の方です。ああ、神様。それは大変だ"}, {"type": "subtitle", "time": 16597.07, "timestamp": "04:36:37", "text": "神。つまり、私は青を殺しに行った"}, {"type": "subtitle", "time": 16599.91, "timestamp": "04:36:39", "text": "漁師のボードに乗る"}, {"type": "subtitle", "time": 16602.869, "timestamp": "04:36:42", "text": "ビーチの端の方。それから私は"}, {"type": "subtitle", "time": 16605.91, "timestamp": "04:36:45", "text": "歩く。ああ、それは大きな水だ。"}, {"type": "subtitle", "time": 16606.67, "timestamp": "04:36:46", "text": "おお"}, {"type": "subtitle", "time": 16609.07, "timestamp": "04:36:49", "text": "神。"}, {"type": "subtitle", "time": 16613.109, "timestamp": "04:36:53", "text": "ああ、家に帰る道がわからないのですが"}]
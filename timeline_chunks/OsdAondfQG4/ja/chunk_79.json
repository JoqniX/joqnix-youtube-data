[{"type": "subtitle", "time": 4740.55, "timestamp": "01:19:00", "text": "そして、みんなで集まって過ごす。そうすれば私は"}, {"type": "subtitle", "time": 4747.99, "timestamp": "01:19:07", "text": "しばらくは公開されますので、ご希望の場合は"}, {"type": "subtitle", "time": 4751.189, "timestamp": "01:19:11", "text": "遊ぶ。教えてください。"}, {"type": "subtitle", "time": 4754.63, "timestamp": "01:19:14", "text": "あなたが知っている。こんにちは。"}, {"type": "subtitle", "time": 4761.11, "timestamp": "01:19:21", "text": "それで、あなたはDestinyをやり込んでいますか？あなた"}, {"type": "subtitle", "time": 4764.709, "timestamp": "01:19:24", "text": "新しいのを買いましたか？"}, {"type": "subtitle", "time": 4767.83, "timestamp": "01:19:27", "text": "新しいものがありました。つまり、私はすべて持っています"}, {"type": "subtitle", "time": 4770.79, "timestamp": "01:19:30", "text": "今後のシーズン分は既に購入済みです。ああ、でも"}, {"type": "subtitle", "time": 4773.669, "timestamp": "01:19:33", "text": "努力して手に入れなきゃいけないんだよね？たとえあなたが"}, {"type": "subtitle", "time": 4777.189, "timestamp": "01:19:37", "text": "それを買って。本当にそうしたいのですが、"}, {"type": "subtitle", "time": 4779.149, "timestamp": "01:19:39", "text": "わからない。見つかりません"}, {"type": "subtitle", "time": 4782.189, "timestamp": "01:19:42", "text": "えっと、何ですか？"}, {"type": "subtitle", "time": 4786.229, "timestamp": "01:19:46", "text": "電話した？私は怠け者です。"}, {"type": "subtitle", "time": 4789.03, "timestamp": "01:19:49", "text": "うん、大丈夫だよ。わかった。モチベーション。私"}, {"type": "subtitle", "time": 4793.39, "timestamp": "01:19:53", "text": "やる気が出ない。うん。"}, {"type": "subtitle", "time": 4795.75, "timestamp": "01:19:55", "text": "うん、大変だね。楽しそうですね"}]
[{"type": "subtitle", "time": 15781.83, "timestamp": "04:23:01", "text": "10年以内には、おそらく"}, {"type": "subtitle", "time": 15785.07, "timestamp": "04:23:05", "text": "地球全体を旅した、あるいは"}, {"type": "subtitle", "time": 15786.95, "timestamp": "04:23:06", "text": "何か。そんな感じですね。そこには"}, {"type": "subtitle", "time": 15789.11, "timestamp": "04:23:09", "text": "砂浜で遊んでいる犬。おお、"}, {"type": "subtitle", "time": 15790.349, "timestamp": "04:23:10", "text": "それはとても"}, {"type": "subtitle", "time": 15793.75, "timestamp": "04:23:13", "text": "かわいい。そこには家族のような人たちがいる"}, {"type": "subtitle", "time": 15797.63, "timestamp": "04:23:17", "text": "あなたのような人は、モバイルの90%を使用しています"}, {"type": "subtitle", "time": 15800.71, "timestamp": "04:23:20", "text": "本日分のデータが追いつきました"}, {"type": "subtitle", "time": 15802.87, "timestamp": "04:23:22", "text": "日。何てことだ。冗談でしょ？"}, {"type": "subtitle", "time": 15806.309, "timestamp": "04:23:26", "text": "今？弦が切れてしまうでしょうか？いいえ、私は"}, {"type": "subtitle", "time": 15808.71, "timestamp": "04:23:28", "text": "2GB買ったんだよね？そこで、私は"}, {"type": "subtitle", "time": 15811.75, "timestamp": "04:23:31", "text": "2GBパックだと思います。待って、もう一人いる"}, {"type": "subtitle", "time": 15814.03, "timestamp": "04:23:34", "text": "周囲に転がるココナッツ"}, {"type": "subtitle", "time": 15828.91, "timestamp": "04:23:48", "text": "以上。私はまだ歩いています"}, {"type": "subtitle", "time": 15832.55, "timestamp": "04:23:52", "text": "方法。あ、待って。 D が終わりました。待ってください。"}, {"type": "subtitle", "time": 15835.63, "timestamp": "04:23:55", "text": "はい、1GBパックのデイリーパックは"}]
[{"type": "subtitle", "time": 5590.47, "timestamp": "01:33:10", "text": "ゲーム。えっと。あ、待って。えっと、あなたはアートをやっていますね。"}, {"type": "subtitle", "time": 5593.27, "timestamp": "01:33:13", "text": "右？えっと、あなたは絵を描くんですか？"}, {"type": "subtitle", "time": 5595.75, "timestamp": "01:33:15", "text": "私はしません。私が描くのは私の"}, {"type": "subtitle", "time": 5596.91, "timestamp": "01:33:16", "text": "棒人間。"}, {"type": "subtitle", "time": 5602.229, "timestamp": "01:33:22", "text": "しかも彼は棒人間だ。棒人間。"}, {"type": "subtitle", "time": 5603.99, "timestamp": "01:33:23", "text": "うん。わからない。私は誇りに思っています"}, {"type": "subtitle", "time": 5606.39, "timestamp": "01:33:26", "text": "私の棒人間は、遠近法的に見て。"}, {"type": "subtitle", "time": 5608.07, "timestamp": "01:33:28", "text": "のように"}, {"type": "subtitle", "time": 5610.07, "timestamp": "01:33:30", "text": "彼の頭が本当に大きいのは知ってるし、"}, {"type": "subtitle", "time": 5613.11, "timestamp": "01:33:33", "text": "体はとても小さいのに、目が大きい。"}, {"type": "subtitle", "time": 5617.51, "timestamp": "01:33:37", "text": "うん。でも、私はできると思うし、"}, {"type": "subtitle", "time": 5619.55, "timestamp": "01:33:39", "text": "上達する"}, {"type": "subtitle", "time": 5621.83, "timestamp": "01:33:41", "text": "形作られた視点。ねえ、私が"}, {"type": "subtitle", "time": 5624.79, "timestamp": "01:33:44", "text": "平均？円のように。光り輝く光り輝く"}, {"type": "subtitle", "time": 5626.31, "timestamp": "01:33:46", "text": "ボール。"}, {"type": "subtitle", "time": 5627.91, "timestamp": "01:33:47", "text": "光るボール。色違いを描けると思う"}, {"type": "subtitle", "time": 5629.75, "timestamp": "01:33:49", "text": "ボールを今すぐ。"}, {"type": "subtitle", "time": 5633.51, "timestamp": "01:33:53", "text": "うん。私はそれを少し誇りに思っています。それ"}, {"type": "subtitle", "time": 5635.11, "timestamp": "01:33:55", "text": "大きな成果ではないかもしれないし、"}, {"type": "subtitle", "time": 5637.83, "timestamp": "01:33:57", "text": "何でもいいんだけど、気分はいいよ。気分がいい"}]
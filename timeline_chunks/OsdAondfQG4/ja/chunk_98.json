[{"type": "subtitle", "time": 5889.11, "timestamp": "01:38:09", "text": "どこかで。"}, {"type": "subtitle", "time": 5891.07, "timestamp": "01:38:11", "text": "[音楽]"}, {"type": "subtitle", "time": 5894.709, "timestamp": "01:38:14", "text": "うーん、覚えてないけど、まあいいか。"}, {"type": "subtitle", "time": 5898.47, "timestamp": "01:38:18", "text": "それは何か素晴らしいものだったに違いない、"}, {"type": "subtitle", "time": 5901.03, "timestamp": "01:38:21", "text": "何か。わからない。あなたはどうですか？"}, {"type": "subtitle", "time": 5902.31, "timestamp": "01:38:22", "text": "何か期待していることはありますか？"}, {"type": "subtitle", "time": 5905.59, "timestamp": "01:38:25", "text": "遊ぶ？私も長老役を演じたい"}, {"type": "subtitle", "time": 5908.629, "timestamp": "01:38:28", "text": "指輪。夜の雨 その１。"}, {"type": "subtitle", "time": 5910.87, "timestamp": "01:38:30", "text": "ああ、夜の雨よ。ナイトレインは"}, {"type": "subtitle", "time": 5912.629, "timestamp": "01:38:32", "text": "バトルロイヤル。それは誰かが"}, {"type": "subtitle", "time": 5916.39, "timestamp": "01:38:36", "text": "私にそう言った。バトルロイヤル。ああ、それはまるで"}, {"type": "subtitle", "time": 5918.59, "timestamp": "01:38:38", "text": "いや、それは協同組合みたいなものだよ。"}, {"type": "subtitle", "time": 5923.75, "timestamp": "01:38:43", "text": "いや、協力バトルとかそういうやつだよ。"}, {"type": "subtitle", "time": 5926.55, "timestamp": "01:38:46", "text": "正しい。"}, {"type": "subtitle", "time": 5929.91, "timestamp": "01:38:49", "text": "つまり、MMO RPGに近いということですね。"}, {"type": "subtitle", "time": 5932.149, "timestamp": "01:38:52", "text": "ええ、まあ、そんな感じです。あるいはMMO要素は少なく、"}, {"type": "subtitle", "time": 5934.95, "timestamp": "01:38:54", "text": "友達とRPGをプレイする。うん。うん。 RPG"}, {"type": "subtitle", "time": 5937.79, "timestamp": "01:38:57", "text": "友達とボスと戦ってボスを倒す"}]
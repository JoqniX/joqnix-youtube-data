[{"type": "subtitle", "time": 1860.07, "timestamp": "00:31:00", "text": "インドはインド出身です。こんにちは。こんにちは。どうやって"}, {"type": "subtitle", "time": 1862.46, "timestamp": "00:31:02", "text": "あなたは？学校生活はどうですか？"}, {"type": "subtitle", "time": 1864.47, "timestamp": "00:31:04", "text": "[音楽]"}, {"type": "subtitle", "time": 1866.11, "timestamp": "00:31:06", "text": "こんにちは。私は"}, {"type": "subtitle", "time": 1882.789, "timestamp": "00:31:22", "text": "英語。もっと英語の単語を。それらの"}, {"type": "subtitle", "time": 1886.389, "timestamp": "00:31:26", "text": "あちらでは英語が話されています。"}, {"type": "subtitle", "time": 1909.99, "timestamp": "00:31:49", "text": "私はインド出身だとは言いませんよね？"}]
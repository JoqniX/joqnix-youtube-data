[{"type": "subtitle", "time": 17761.91, "timestamp": "04:56:01", "text": "できなかった。散歩とかしたけど、"}, {"type": "subtitle", "time": 17766.35, "timestamp": "04:56:06", "text": "えっと、なんて言うんでしたっけ？取ろう"}, {"type": "subtitle", "time": 17768.35, "timestamp": "04:56:08", "text": "昼寝。こんにちは。"}, {"type": "subtitle", "time": 17769.948, "timestamp": "04:56:09", "text": "ともかく、"}, {"type": "subtitle", "time": 17775.07, "timestamp": "04:56:15", "text": "良いか良い"}, {"type": "subtitle", "time": 17777.19, "timestamp": "04:56:17", "text": "夜？皆さんが良い一日を過ごせますように"}, {"type": "subtitle", "time": 17779.31, "timestamp": "04:56:19", "text": "生産的な一日で幸せ"}, {"type": "subtitle", "time": 17782.15, "timestamp": "04:56:22", "text": "火曜日。おやすみ、M。おやすみじゃないよ。"}, {"type": "subtitle", "time": 17790.31, "timestamp": "04:56:30", "text": "[音楽]"}, {"type": "subtitle", "time": 17792.708, "timestamp": "04:56:32", "text": "放送を終了するにはどうすればいいですか？ところで、"}, {"type": "subtitle", "time": 17794.39, "timestamp": "04:56:34", "text": "前回は放送を終了できませんでした。"}, {"type": "subtitle", "time": 17797.11, "timestamp": "04:56:37", "text": "しばらく待たなければなりませんでした"}, {"type": "subtitle", "time": 17799.23, "timestamp": "04:56:39", "text": "終わり。まあ、そうですね。こんにちは。さあ"}]
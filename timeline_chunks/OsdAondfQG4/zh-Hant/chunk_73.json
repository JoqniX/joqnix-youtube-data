[{"type": "subtitle", "time": 4382.95, "timestamp": "01:13:02", "text": "我過了兩秒鐘才意識到，跟我說話的都是同一個人"}, {"type": "subtitle", "time": 4387.59, "timestamp": "01:13:07", "text": "。"}, {"type": "subtitle", "time": 4389.99, "timestamp": "01:13:09", "text": "我"}, {"type": "subtitle", "time": 4415.669, "timestamp": "01:13:35", "text": "等等，我以為我的頭像已經是"}, {"type": "subtitle", "time": 4421.189, "timestamp": "01:13:41", "text": "公開的了。  民眾？嗯？  是的。哦。哦。  哦。  哦。中國人得像……呃……就像中國僧侶"}, {"type": "subtitle", "time": 4424.31, "timestamp": "01:13:44", "text": "休息吃飯那樣"}, {"type": "subtitle", "time": 4431.11, "timestamp": "01:13:51", "text": "。按"}]
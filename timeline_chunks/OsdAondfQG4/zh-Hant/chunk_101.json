[{"type": "subtitle", "time": 6067.709, "timestamp": "01:41:07", "text": "哦，是的，就像《原神》一樣，你可以獲得其他角色並扮演他們，"}, {"type": "subtitle", "time": 6072.55, "timestamp": "01:41:12", "text": "但在《星際戰甲》中，你必須"}, {"type": "subtitle", "time": 6074.669, "timestamp": "01:41:14", "text": "培養角色並提升等級才能使用技能等等。  哦，是的。哦，我也看過你玩《呼嘯海嘯》。我"}, {"type": "subtitle", "time": 6098.07, "timestamp": "01:41:38", "text": "上個月才開始做這件事。哦，感覺怎麼樣？旅途如何？"}, {"type": "subtitle", "time": 6100.47, "timestamp": "01:41:40", "text": "我喜歡"}, {"type": "subtitle", "time": 6102.43, "timestamp": "01:41:42", "text": "。我已經……我不知道。我快到"}]
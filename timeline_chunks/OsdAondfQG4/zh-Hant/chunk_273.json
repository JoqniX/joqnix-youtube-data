[{"type": "subtitle", "time": 16380.07, "timestamp": "04:33:00", "text": "覺得挺麻煩的。但如果我那樣做，"}, {"type": "subtitle", "time": 16383.07, "timestamp": "04:33:03", "text": "我的直播時長"}, {"type": "subtitle", "time": 16386.91, "timestamp": "04:33:06", "text": "計數器，就是那種顯示我"}, {"type": "subtitle", "time": 16391.029, "timestamp": "04:33:11", "text": "直播了"}, {"type": "subtitle", "time": 16408.789, "timestamp": "04:33:28", "text": "多久的東西，就會出問題。我不"}, {"type": "subtitle", "time": 16422.551, "timestamp": "04:33:42", "text": "知道為什麼。好像是個bug什麼的。為什麼我不能那樣做？所以，嗯。嗯，我不知道你們還能不能聽到海浪的聲音。哦，我的天，水花四濺。他們應該過來。別走。順便說一句，那是一隻直立的狗狗。我希望我不會被咬。"}, {"type": "subtitle", "time": 16433.99, "timestamp": "04:33:53", "text": "嗯，拜拜。好了，"}, {"type": "subtitle", "time": 16436.07, "timestamp": "04:33:56", "text": "我走過那隻狗。三隻狗正看著我。嗯。好了，我走過它們了"}]
[{"type": "subtitle", "time": 20956.43, "timestamp": "05:49:16", "text": "海裡"}, {"type": "subtitle", "time": 20961.67, "timestamp": "05:49:21", "text": "游泳。不，不，我沒去。是的"}, {"type": "subtitle", "time": 20966.868, "timestamp": "05:49:26", "text": "。所以，我會看看我能不能做到這一點，並對我這短短一周的假期感到滿意。"}, {"type": "subtitle", "time": 20968.99, "timestamp": "05:49:28", "text": "是的"}, {"type": "subtitle", "time": 20971.02, "timestamp": "05:49:31", "text": "。  到時候我一定會後悔的。不，"}, {"type": "subtitle", "time": 20998.27, "timestamp": "05:49:58", "text": "我做不到。我出去散步什麼的，但是我做不到……呃，該怎麼形容呢？睡個午覺。你好"}]
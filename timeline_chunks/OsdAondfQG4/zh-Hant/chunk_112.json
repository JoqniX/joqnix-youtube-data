[{"type": "subtitle", "time": 6737.43, "timestamp": "01:52:17", "text": "差不多就是這樣。  哦"}, {"type": "subtitle", "time": 6740.55, "timestamp": "01:52:20", "text": "耶，耶，耶，耶。"}, {"type": "subtitle", "time": 6752.47, "timestamp": "01:52:32", "text": "我退坑也是因為我想要"}, {"type": "subtitle", "time": 6754.55, "timestamp": "01:52:34", "text": "琴琴，但我在她的卡池裡第一次抽卡就沒抽到她，或者說，我在她的卡池裡第一次抽卡都沒"}, {"type": "subtitle", "time": 6757.35, "timestamp": "01:52:37", "text": "抽到她。我追不到她，就辭職了。  現在角色真多。是啊，角色太多，要做的事情也太多了。太枯燥了"}, {"type": "subtitle", "time": 6770.629, "timestamp": "01:52:50", "text": "。你要做的事情太多了，簡直難以置信。  是的。"}]
[{"type": "subtitle", "time": 2837.19, "timestamp": "00:47:17", "text": "是組長。耶。  天應該黑了。我的天啊。我們來自泰國。  哦是的"}, {"type": "subtitle", "time": 2841.75, "timestamp": "00:47:21", "text": "。  喬現在是學校裡很酷的孩子之一了。是的。  慢慢來"}, {"type": "subtitle", "time": 2863.87, "timestamp": "00:47:43", "text": "，慢慢來。  是的。是的。是的。你呢？  我是中國人。  哦，你們中國"}, {"type": "subtitle", "time": 2867.03, "timestamp": "00:47:47", "text": "人。"}, {"type": "subtitle", "time": 2872.87, "timestamp": "00:47:52", "text": "好的。給我看看顏色。不，不，不。"}, {"type": "subtitle", "time": 2875.43, "timestamp": "00:47:55", "text": "你的聲音。是的。是的。是的。  也非常"}]
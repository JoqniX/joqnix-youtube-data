[{"type": "subtitle", "time": 19750.59, "timestamp": "05:29:10", "text": "這麼做，而且我會很享受。"}, {"type": "subtitle", "time": 19769.15, "timestamp": "05:29:29", "text": "我想我曾經路過這個地方。嘿"}, {"type": "subtitle", "time": 19774.708, "timestamp": "05:29:34", "text": "，我該拍張照片嗎？但你們看不到貨船之類的東西。右邊可以看到一艘漁船。真是的，"}, {"type": "subtitle", "time": 19793.23, "timestamp": "05:29:53", "text": "我的天。在我完成資料處理之前，我應該回家了。我在火車上需要數據流量"}]
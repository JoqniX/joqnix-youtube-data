[{"type": "subtitle", "time": 14600.309, "timestamp": "04:03:20", "text": "我什麼時候可以提出這個問題？我能應付得了"}, {"type": "subtitle", "time": 14607.349, "timestamp": "04:03:27", "text": "嗎？粉筆。"}, {"type": "subtitle", "time": 14613.83, "timestamp": "04:03:33", "text": "我加的人越多，壓力就越大。如果今天我能打破紀錄或沒打破，我都會覺得內心一片死寂。我該怎麼辦？"}, {"type": "subtitle", "time": 14624.67, "timestamp": "04:03:44", "text": "我可以，今晚我可以再加一個合作者"}]
[{"type": "subtitle", "time": 18421.27, "timestamp": "05:07:01", "text": "哇。讓我拍張照片。我需要一個焦點，以便顯示電子煙的原因"}, {"type": "subtitle", "time": 18428.868, "timestamp": "05:07:08", "text": "。"}, {"type": "subtitle", "time": 18431.03, "timestamp": "05:07:11", "text": "我的天，那電子煙好"}, {"type": "subtitle", "time": 18434.55, "timestamp": "05:07:14", "text": "大。我的天啊。"}, {"type": "subtitle", "time": 18444.708, "timestamp": "05:07:24", "text": "我不知道你是否能看到，好吧，"}, {"type": "subtitle", "time": 18453.43, "timestamp": "05:07:33", "text": "我拍了一張照片。  等等，還有一個。好的。對了，我還會把這些內容發佈到推特和其他各種平台上。所以，別擔心。"}, {"type": "subtitle", "time": 18464.47, "timestamp": "05:07:44", "text": "你們將會能夠"}, {"type": "subtitle", "time": 18468.628, "timestamp": "05:07:48", "text": "看到這些。所以，別擔心。  哦，等等。就像有人在拉繩子一樣。"}]
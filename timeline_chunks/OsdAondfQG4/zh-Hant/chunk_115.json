[{"type": "subtitle", "time": 6906.87, "timestamp": "01:55:06", "text": "我基本上喜歡玩各種各樣的遊戲。種類。  是的。我"}, {"type": "subtitle", "time": 6909.55, "timestamp": "01:55:09", "text": "也是一樣。  種類。  一開始"}, {"type": "subtitle", "time": 6918.87, "timestamp": "01:55:18", "text": "我只會覺得，嗯，"}, {"type": "subtitle", "time": 6925.91, "timestamp": "01:55:25", "text": "FPS遊戲挺好玩的。快節奏的遊戲很有趣，等等。"}, {"type": "subtitle", "time": 6943.99, "timestamp": "01:55:43", "text": "我打算繼續玩這類遊戲。  後來我意識到，嘗試、拓展和嘗試不同的事物也是可以的。  是的。  是的。所以我照做了。你知道，就是那些做"}, {"type": "subtitle", "time": 6947.75, "timestamp": "01:55:47", "text": "主播的朋友，在 YouTube 上直播的那些人，對吧？"}, {"type": "subtitle", "time": 6957.189, "timestamp": "01:55:57", "text": "我總是看他們"}]
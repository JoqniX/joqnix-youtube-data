[{"type": "subtitle", "time": 16149.99, "timestamp": "04:29:09", "text": "在"}, {"type": "subtitle", "time": 16152.95, "timestamp": "04:29:12", "text": "海灘上。那是鞋子嗎？我明白了。"}, {"type": "subtitle", "time": 16156.55, "timestamp": "04:29:16", "text": "等等，那是錢包嗎？等等，什麼？等等，"}, {"type": "subtitle", "time": 16158.149, "timestamp": "04:29:18", "text": "不。那是……那看起來像……那是什麼？等等，我……盡量不弄濕。"}, {"type": "subtitle", "time": 16161.03, "timestamp": "04:29:21", "text": "看起來像是被人推了一下。"}, {"type": "subtitle", "time": 16168.07, "timestamp": "04:29:28", "text": "呃呃，現在浪很大。這裡還有個小"}, {"type": "subtitle", "time": 16170.469, "timestamp": "04:29:30", "text": "螃蟹海灘。寶貝，我在這裡走。我在走。我的天哪，太可愛了。小螃蟹海灘。我其實不知道自己在哪裡。"}, {"type": "subtitle", "time": 16193.51, "timestamp": "04:29:53", "text": "我只是沿著"}, {"type": "subtitle", "time": 16199.309, "timestamp": "04:29:59", "text": "海岸線一直走。是啊。但我從來沒走到這麼遠。我有點擔心。我的天哪。我是不是接到電話了？什麼？"}]
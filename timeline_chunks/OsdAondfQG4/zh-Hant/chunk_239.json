[{"type": "subtitle", "time": 14354.229, "timestamp": "03:59:14", "text": "強盜。你好嗎？你"}, {"type": "subtitle", "time": 14383.07, "timestamp": "03:59:43", "text": "於好的，我查一下。我很好。你呢？我內心已​​死。很高興見到你。我死了。內心已死。第呃，下午2點到5點。但"}, {"type": "subtitle", "time": 14395.309, "timestamp": "03:59:55", "text": "現在就得走了。 30日我會在最後一週離開。所以"}]
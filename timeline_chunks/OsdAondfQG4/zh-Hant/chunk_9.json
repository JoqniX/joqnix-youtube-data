[{"type": "subtitle", "time": 541.19, "timestamp": "00:09:01", "text": "僅在中國。哦，等等。"}, {"type": "subtitle", "time": 548.71, "timestamp": "00:09:08", "text": "所以主要的哦，等等。中國的《鬥陣特攻》版本與"}, {"type": "subtitle", "time": 551.19, "timestamp": "00:09:11", "text": "中國不同。它叫Luna Chinese。 Luna"}, {"type": "subtitle", "time": 554.55, "timestamp": "00:09:14", "text": "Chinese。這意味著我玩這個遊戲。我玩鬥陣特攻2。我只能在美服、亞服之類的伺服器上玩守望先鋒2。我無法在"}, {"type": "subtitle", "time": 559.59, "timestamp": "00:09:19", "text": "國服玩遊戲。"}]
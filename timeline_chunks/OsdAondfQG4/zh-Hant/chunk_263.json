[{"type": "subtitle", "time": 15789.11, "timestamp": "04:23:09", "text": "。我覺得這裡應該"}, {"type": "subtitle", "time": 15793.75, "timestamp": "04:23:13", "text": "沒人住。這次我係好，免得它自己散開了。我不想讓它"}, {"type": "subtitle", "time": 15806.309, "timestamp": "04:23:26", "text": "散開。我說話有人聽見嗎？怎麼了？你知道嗎？我"}, {"type": "subtitle", "time": 15808.71, "timestamp": "04:23:28", "text": "把其他的也係好。我也喜歡鞋子。你知道，每當我試圖靠著，施加壓力的時候，我就會……我當時是這樣的："}, {"type": "subtitle", "time": 15828.91, "timestamp": "04:23:48", "text": "我把腳抬起來，試圖靠過去，就像……該怎麼稱呼呢？怎麼稱呼呢？試著靠過去……我"}]
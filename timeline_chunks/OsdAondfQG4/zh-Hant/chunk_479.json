[{"type": "subtitle", "time": 28742.468, "timestamp": "07:59:02", "text": "高興了。  我很高興。我的天啊。這"}, {"type": "subtitle", "time": 28745.43, "timestamp": "07:59:05", "text": "是一種不同的“嗨”。"}, {"type": "subtitle", "time": 28754.948, "timestamp": "07:59:14", "text": "哦，我的天啊。  是的。是的。已經過了很久了吧"}, {"type": "subtitle", "time": 28760.23, "timestamp": "07:59:20", "text": "？我的天啊。"}, {"type": "subtitle", "time": 28763.59, "timestamp": "07:59:23", "text": "我很想念你。我也想你。  嗨，大家好。  你好。歡迎。歡迎。"}, {"type": "chat", "time": 28772.758, "timestamp": "07:59:32", "author": "@yashchourasia2215", "avatar": "https://yt4.ggpht.com/ytc/AIdro_mbRu2gYmpEUO4nLl0jA2optOzbTHvVFqZhza3dfpPmwg=s64-c-k-c0x00ffffff-no-rj", "message": "Grandma Joq (No offence, joke hai)"}, {"type": "subtitle", "time": 28784.468, "timestamp": "07:59:44", "text": "我會給你講講，對吧？"}, {"type": "subtitle", "time": 28788.868, "timestamp": "07:59:48", "text": "呃，不。我的印地語很差，我聽不懂。  好的。好的。玩。  是的。你說話。"}, {"type": "subtitle", "time": 28798.868, "timestamp": "07:59:58", "text": "哦，對，我忘了。是啊，你知道的。是的。  耶。"}]
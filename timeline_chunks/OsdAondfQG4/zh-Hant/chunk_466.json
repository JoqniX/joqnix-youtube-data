[{"type": "subtitle", "time": 27975.35, "timestamp": "07:46:15", "text": "但他們對這裡進行了翻新。是我錯覺嗎？感覺"}, {"type": "subtitle", "time": 27978.628, "timestamp": "07:46:18", "text": "這個世界上根本沒有人。  現在有五個人了。這五個人藏在哪裡？這是什麼？想起"}, {"type": "subtitle", "time": 27986.23, "timestamp": "07:46:26", "text": "岩石區，我心想：天哪，我至今還記得那天。  我的天啊。  關，我遇到了關。"}, {"type": "subtitle", "time": 28001.19, "timestamp": "07:46:41", "text": "我和舒安已經很久沒"}, {"type": "subtitle", "time": 28003.83, "timestamp": "07:46:43", "text": "聯絡了。我想知道發生了什麼事。我很少在"}, {"type": "subtitle", "time": 28007.35, "timestamp": "07:46:47", "text": "網路上看到她（音樂）。這裡有很多中國人。  我擔心你會擅自"}, {"type": "subtitle", "time": 28016.628, "timestamp": "07:46:56", "text": "探索這個地方。就是這樣。呃 [音樂] 也許她"}]
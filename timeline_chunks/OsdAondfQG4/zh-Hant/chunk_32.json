[{"type": "subtitle", "time": 1927.269, "timestamp": "00:32:07", "text": "我就叫你"}, {"type": "subtitle", "time": 1935.19, "timestamp": "00:32:15", "text": "塔諾吧。沒關係。是的。是的。你的意思是，就像……我需要的每個人，或是像他需要去的地方，像是晚點。"}, {"type": "subtitle", "time": 1950.549, "timestamp": "00:32:30", "text": "我剛剛是不是​​嘗試了一下"}, {"type": "subtitle", "time": 1963.11, "timestamp": "00:32:43", "text": "？我的天啊。不，我想說的是，我"}]
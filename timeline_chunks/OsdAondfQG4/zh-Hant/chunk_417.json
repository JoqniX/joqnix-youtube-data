[{"type": "subtitle", "time": 25044.31, "timestamp": "06:57:24", "text": "？我"}, {"type": "subtitle", "time": 25050.83, "timestamp": "06:57:30", "text": "不知道。是的。你好，艾莉莎。我的天啊，這是推。我得到了我的第一隻大猩猩。我們走吧。我很高興。開心開心。我的天啊。什麼？呃，你有"}, {"type": "subtitle", "time": 25058.23, "timestamp": "06:57:38", "text": "沒有WiFi？因為我"}, {"type": "subtitle", "time": 25061.11, "timestamp": "06:57:41", "text": "猜我跟你聯絡上了。  什麼？我的"}]
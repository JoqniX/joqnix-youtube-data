[{"type": "subtitle", "time": 15841.71, "timestamp": "04:24:01", "text": "試著繫一下我左腿上的"}, {"type": "subtitle", "time": 15850.269, "timestamp": "04:24:10", "text": "鞋帶，我把它露在外面了。它開始晃動"}, {"type": "subtitle", "time": 15854.07, "timestamp": "04:24:14", "text": "。我就想，等等，怎麼回事？"}, {"type": "subtitle", "time": 15861.389, "timestamp": "04:24:21", "text": "怎麼回事？南德，我覺得早上風沒那麼大，"}, {"type": "subtitle", "time": 15865.63, "timestamp": "04:24:25", "text": "不像上次"}, {"type": "subtitle", "time": 15868.11, "timestamp": "04:24:28", "text": "我們一起"}, {"type": "subtitle", "time": 15883.269, "timestamp": "04:24:43", "text": "巡演，在推特上直播音頻的時候，晚上風特別大。所以"}, {"type": "subtitle", "time": 15887.67, "timestamp": "04:24:47", "text": "我想我們可以去海灘。我有點害怕，不管我朋友的相機拍到什麼，我都要死了，我要死了，我要哭了，我要死了。我不知道。但是那裡有個……有鞦韆。你知道"}]
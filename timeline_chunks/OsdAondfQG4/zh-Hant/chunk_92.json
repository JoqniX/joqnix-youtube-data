[{"type": "subtitle", "time": 5522.149, "timestamp": "01:32:02", "text": "，每個"}, {"type": "subtitle", "time": 5524.47, "timestamp": "01:32:04", "text": "遊戲大概持續一年左右"}, {"type": "subtitle", "time": 5527.75, "timestamp": "01:32:07", "text": "，"}, {"type": "subtitle", "time": 5530.79, "timestamp": "01:32:10", "text": "我不知道，"}, {"type": "subtitle", "time": 5533.189, "timestamp": "01:32:13", "text": "我在製作"}, {"type": "subtitle", "time": 5534.59, "timestamp": "01:32:14", "text": "過程中學到了"}, {"type": "subtitle", "time": 5547.27, "timestamp": "01:32:27", "text": "很多東西，例如如何製作一款好遊戲"}, {"type": "subtitle", "time": 5549.35, "timestamp": "01:32:29", "text": "。如何讓人覺得有趣？如何讓人感到困難？諸如此類的事情。  [音樂] 你是否添加了那種自訂程式碼，例如按下 Esc 鍵"}, {"type": "subtitle", "time": 5555.11, "timestamp": "01:32:35", "text": "後可以看到 SMP 的名稱之類的自訂主題？  呃，我上個SMP做過"}, {"type": "subtitle", "time": 5565.47, "timestamp": "01:32:45", "text": "多人遊戲）非常興奮，所以他們為我製作了一些自訂內容，添加到菜單之類的東西中"}]
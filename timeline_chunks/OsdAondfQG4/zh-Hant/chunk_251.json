[{"type": "subtitle", "time": 15068.95, "timestamp": "04:11:08", "text": "歡迎。歡迎。希望你一切都好。 （音樂）早安。我的天哪。我希望音訊效果不錯。我不知道。我用的是"}, {"type": "subtitle", "time": 15077.83, "timestamp": "04:11:17", "text": "手機麥克風，而且……現在風不大。不像兩天前我們在推特"}, {"type": "subtitle", "time": 15080.229, "timestamp": "04:11:20", "text": "上直播時那麼大風。那次的音頻效果很差。所以，等我買了之後，我們會多做一些戶外直播。我"}, {"type": "subtitle", "time": 15090.71, "timestamp": "04:11:30", "text": "在亞馬遜上看了看。它也可以用來……呃……你的相機之類的。它主要是用來拍vlog之類的"}, {"type": "subtitle", "time": 15107.269, "timestamp": "04:11:47", "text": "。所以"}, {"type": "subtitle", "time": 15108.91, "timestamp": "04:11:48", "text": "，我會選擇無線麥克風，因為這樣我可以把"}]
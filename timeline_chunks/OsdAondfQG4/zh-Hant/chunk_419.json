[{"type": "subtitle", "time": 25153.548, "timestamp": "06:59:13", "text": "[音樂] 我的天哪。哦，它幾乎沒碰到[音樂]線，兄弟。嚯嚯嚯。"}, {"type": "subtitle", "time": 25177.39, "timestamp": "06:59:37", "text": "[音樂] 請。  [音樂] 哦，天哪。這就是"}, {"type": "subtitle", "time": 25180.39, "timestamp": "06:59:40", "text": "我（音樂）失敗的方式嗎？是的，我們其實離世界紀錄非常接近了。"}, {"type": "subtitle", "time": 25196.468, "timestamp": "06:59:56", "text": "等等，你敢相信嗎？我差點就打破世界紀錄了"}]
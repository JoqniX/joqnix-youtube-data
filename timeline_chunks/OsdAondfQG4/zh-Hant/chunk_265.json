[{"type": "subtitle", "time": 15900.469, "timestamp": "04:25:00", "text": "那個可以左右上下擺動的東西"}, {"type": "subtitle", "time": 15919.429, "timestamp": "04:25:19", "text": "叫什麼嗎？等等，上下擺動。等等，那個叫什麼來著？我看到那個東西了，但是它是木頭做的。所以，是的。現在也在店裡。真的有"}, {"type": "subtitle", "time": 15923.269, "timestamp": "04:25:23", "text": "兩隻狗盯著我看。這傢伙在幹嘛？"}, {"type": "subtitle", "time": 15925.99, "timestamp": "04:25:25", "text": "他為什麼"}, {"type": "subtitle", "time": 15937.429, "timestamp": "04:25:37", "text": "拿著手機對著嘴巴說話，好像在說「我的天哪」。哦，那裡有花什麼的，但是…看起來像森林。如果我拍這張照片，"}]
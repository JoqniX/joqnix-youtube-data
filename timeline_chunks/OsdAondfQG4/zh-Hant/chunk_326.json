[{"type": "subtitle", "time": 19591.27, "timestamp": "05:26:31", "text": "哦，說到這個，我今天沒做每日惡搞"}, {"type": "subtitle", "time": 19597.74, "timestamp": "05:26:37", "text": "。我稍後會做。嗨，等等，那[ __ ]還剩下了一些。"}, {"type": "subtitle", "time": 19607.39, "timestamp": "05:26:47", "text": "等等，我想我又到那裡了。這次"}, {"type": "subtitle", "time": 19610.628, "timestamp": "05:26:50", "text": "我需要"}, {"type": "subtitle", "time": 19613.67, "timestamp": "05:26:53", "text": "一個你知道嗎？  我應該坐下來休息一會兒。那我走著去"}, {"type": "subtitle", "time": 19615.708, "timestamp": "05:26:55", "text": "。我不知道。我已經做好準備了。準備上課。祝"}, {"type": "subtitle", "time": 19618.02, "timestamp": "05:26:58", "text": "您散步愉快。"}]
[{"type": "subtitle", "time": 6241.51, "timestamp": "01:44:01", "text": "\"Yeah, I like say hi to friends once"}, {"type": "subtitle", "time": 6242.669, "timestamp": "01:44:02", "text": "every"}, {"type": "subtitle", "time": 6244.87, "timestamp": "01:44:04", "text": "year.\" And then a few people under the"}, {"type": "subtitle", "time": 6247.07, "timestamp": "01:44:07", "text": "post are like, \"Yeah, that's true. 100%"}, {"type": "subtitle", "time": 6249.03, "timestamp": "01:44:09", "text": "true.\" And there are people I haven't"}, {"type": "subtitle", "time": 6252.03, "timestamp": "01:44:12", "text": "said hi to this year yet. It's"}, {"type": "subtitle", "time": 6254.55, "timestamp": "01:44:14", "text": "crazy. I'm like, \"Whoops. Sorry, guys."}, {"type": "subtitle", "time": 6257.43, "timestamp": "01:44:17", "text": "I'll say hi later.\""}, {"type": "subtitle", "time": 6259.75, "timestamp": "01:44:19", "text": "[Music]"}, {"type": "subtitle", "time": 6261.43, "timestamp": "01:44:21", "text": "There's only one person I've been able"}, {"type": "subtitle", "time": 6264.95, "timestamp": "01:44:24", "text": "to say hi to at least once a month, and"}, {"type": "subtitle", "time": 6269.189, "timestamp": "01:44:29", "text": "that's because they uh one day they they"}, {"type": "subtitle", "time": 6271.669, "timestamp": "01:44:31", "text": "uh told me, \"You don't even say hi to"}, {"type": "subtitle", "time": 6274.79, "timestamp": "01:44:34", "text": "me.\" And I'm kind of petty, so I now say"}, {"type": "subtitle", "time": 6283.43, "timestamp": "01:44:43", "text": "Yeah. I don't know. It's just kind of"}, {"type": "subtitle", "time": 6287.27, "timestamp": "01:44:47", "text": "hard kind of keep in touch with people."}, {"type": "subtitle", "time": 6292.629, "timestamp": "01:44:52", "text": "Yeah, in my opinion. Well, for me,"}, {"type": "subtitle", "time": 6295.83, "timestamp": "01:44:55", "text": "that is true. I mean, same with me too."}, {"type": "subtitle", "time": 6298.95, "timestamp": "01:44:58", "text": "And look at me reconnected with people."}]